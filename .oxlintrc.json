{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": "error",
    "prefer-const": "error",
    "prefer-template": "warn",
    "prefer-optional-chain": "warn",
    "unicorn/no-thenable": "off"
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    ".kspec/",
    ".agents/",
    ".claude/",
    ".factory/",
    "**/*.svelte",
    "packages/web-ui/build/"
  ],
  "overrides": [
    {
      "files": ["tests/**/*.ts", "packages/*/tests/**/*.ts"],
      "plugins": ["vitest"],
      "jsPlugins": [
        "./tools/eslint-rules/no-source-scanning.js",
        "./tools/eslint-rules/no-daemon-ts-imports.js",
        "./tools/eslint-rules/no-leaky-test-daemon.js",
        "./tools/eslint-rules/no-unguarded-npm-pack.js"
      ],
      "rules": {
        "vitest/no-focused-tests": "error",
        "vitest/no-disabled-tests": "warn",
        "vitest/no-conditional-tests": "warn",
        "vitest/expect-expect": "error",
        "vitest/valid-expect": ["error", { "maxArgs": 2 }],
        "vitest/no-identical-title": "error",
        "vitest/no-standalone-expect": "error",
        "no-source-scanning/no-source-file-reads": "error",
        "no-daemon-ts-imports/no-daemon-ts-imports": "error",
        "no-leaky-test-daemon/no-leaky-test-daemon": "error",
        "no-leaky-test-daemon/localized-disable": "error",
        "no-unguarded-npm-pack/no-unguarded-npm-pack": "error"
      }
    }
  ]
}
