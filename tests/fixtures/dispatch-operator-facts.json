  "workspace": {
    "config_keys": [
      "base_branch",
      "worktree_root",
      "publication_mode",
      "bootstrap",
      "sync_interval",
      "remote_sync"
    ],
    "defaults": {
      "base_branch": null,
      "worktree_root": ".kspec-worktrees",
      "publication_mode": "auto",
      "bootstrap_steps": [],
      "sync_interval": 60,
      "remote_sync": null
    },
    "publication_modes": ["pull_request", "manual_merge", "auto"],
    "remote_sync_default": "enabled exactly when a remote exists",
    "remote_sync": {
      "no_remote": "local-only with no degraded state or warnings",
      "target_update": "fast-forward only with no merge commits",
      "degraded_status_fields": ["branch", "reason", "enteredAt", "kind"],
      "reviewer_target_sync": "deferred while that target has an active reviewer"
    },
    "worktree_root_resolution": "relative paths resolve from the project root; absolute paths remain absolute",
    "base_target_precedence": {
      "plan_over_configured": true,
      "configured_over_fallback": true
    },
    "bootstrap": {
      "scope": "dispatch-managed workspaces only",
      "roles": ["worker", "reviewer"],
      "step_keys": [
        "run",
        "name",
        "roles",
        "idempotent",
        "allow_tracked_changes",
        "reviewer_rerun_allowed"
