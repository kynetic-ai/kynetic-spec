{
  "name": "@kynetic-ai/daemon",
  "version": "0.1.0",
  "private": true,
  "description": "Kspec daemon server with WebSocket support",
  "bin": {
    "kspec-daemon": "./dist/index.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:compile": "bun build --compile --minify ../../dist/daemon/index.js --outfile ../../dist/kspec-daemon",
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/static": "^1.4.7",
    "@kynetic-ai/shared": "*",
    "chokidar": "^4.0.3",
    "elysia": "^1.4.28",
    "ulidx": "^2.4.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.3"
  }
}
