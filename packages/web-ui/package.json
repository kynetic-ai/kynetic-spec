{
  "name": "@kynetic-ai/web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Kspec web dashboard built with SvelteKit",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "cd ../.. && npx vitest run tests/web-ui-design-system.test.ts tests/web-ui-app-shell.test.ts tests/web-ui-session-stream.test.ts"
  },
  "dependencies": {
    "@kynetic-ai/shared": "*",
    "@tanstack/svelte-query": "^6.1.0",
    "highlight.js": "^11.11.1",
    "isomorphic-dompurify": "^3.0.0",
    "lucide-svelte": "^0.563.0",
    "marked": "^17.0.4",
    "streaming-markdown": "^0.2.15"
  },
  "devDependencies": {
    "@internationalized/date": "^3.10.1",
    "@lucide/svelte": "^0.561.0",
    "@playwright/test": "^1.58.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/table-core": "^8.21.3",
    "autoprefixer": "^10.4.23",
    "bits-ui": "^2.15.4",
    "clsx": "^2.1.1",
    "postcss": "^8.5.6",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
