   630→  describe("parseEventsToBlocks — complex multi-event sequences", () => {
   631→    // AC: @ui-session-stream ac-1
   632→    it("produces correct block sequence for a realistic agent session", () => {
   633→      const events = [
   634→        { ts: 1000, seq: 0, type: "session.start", session_id: "s1", data: { agent_type: "worker" } },
   635→        { ts: 1100, seq: 1, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "thinking", text: "Planning..." } } },
   636→        { ts: 1200, seq: 2, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "assistant_text", text: "I'll read the file." } } },
   637→        { ts: 1300, seq: 3, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_call", toolCallId: "r1", tool: "Read", rawInput: { file_path: "/src/main.ts" } } } },
   638→        { ts: 1800, seq: 4, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_result", toolCallId: "r1", output: "export function main() {}" } } },
   639→        { ts: 1900, seq: 5, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "assistant_text", text: "Now editing." } } },
   640→        { ts: 2000, seq: 6, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_call", toolCallId: "e1", tool: "Edit", rawInput: { file_path: "/src/main.ts", old_string: "main", new_string: "start" } } } },
   641→        { ts: 2500, seq: 7, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_result", toolCallId: "e1", output: "OK" } } },
   642→        { ts: 3000, seq: 8, type: "session.end", session_id: "s1", data: { reason: "completed" } },
   643→      ];
   644→
   645→      const blocks = parseEventsToBlocks(events);
   646→
   647→      // Expected sequence: system, thinking, message, tool_call(Read), message, tool_call(Edit), system
   648→      expect(blocks.map((b) => b.type)).toEqual([
   649→        "system",
   650→        "thinking",
   651→        "message",
   652→        "tool_call",
   653→        "message",
   654→        "tool_call",
   655→        "system",
   656→      ]);
   657→
   658→      // Verify tool calls resolved correctly
   659→      const toolCalls = blocks.filter((b) => b.type === "tool_call");
   660→      expect(toolCalls[0]).toMatchObject({
   661→        type: "tool_call",
   662→        toolName: "Read",
   663→        status: "completed",
   664→        durationMs: 500,
   665→      });
   666→      expect(toolCalls[1]).toMatchObject({
   667→        type: "tool_call",
   668→        toolName: "Edit",
   669→        status: "completed",
   670→        durationMs: 500,
   671→      });
   672→    });
   673→  });
