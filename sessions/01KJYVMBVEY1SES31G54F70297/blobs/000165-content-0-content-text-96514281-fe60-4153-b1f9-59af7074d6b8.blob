  1349→      expect(session.budget).toBeUndefined();
  1350→    });
  1351→
  1352→    // AC: @ui-session-stream ac-4
  1353→    it("budget progress calculation is correct", () => {
  1354→      // The context panel displays a progress bar: (started / max) * 100
  1355→      const budget = { max_per_cycle: 10, started_this_cycle: 3 };
  1356→      const progress = Math.min(
  1357→        100,
  1358→        (budget.started_this_cycle / budget.max_per_cycle) * 100,
  1359→      );
  1360→      expect(progress).toBe(30);
  1361→
  1362→      // Capped at 100% even if over budget
  1363→      const overBudget = { max_per_cycle: 5, started_this_cycle: 8 };
  1364→      const cappedProgress = Math.min(
  1365→        100,
  1366→        (overBudget.started_this_cycle / overBudget.max_per_cycle) * 100,
  1367→      );
  1368→      expect(cappedProgress).toBe(100);
  1369→    });
  1370→  });
  1371→});
