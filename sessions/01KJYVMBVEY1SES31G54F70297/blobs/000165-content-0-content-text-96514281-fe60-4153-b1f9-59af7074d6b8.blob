```
     1→/**
     2→ * Session Stream View Tests
     3→ *
     4→ * Runtime behavior tests for the session stream view implementation.
     5→ * Tests exercise actual functions (parseEventsToBlocks, extractFilesChanged,
     6→ * renderMarkdown) rather than checking source strings.
     7→ *
     8→ * Structural tests are limited to file existence and key integration points.
     9→ *
    10→ * Spec: @ui-session-stream
    11→ */
    12→
    13→import { describe, it, expect, beforeAll } from "vitest";
    14→import { existsSync } from "node:fs";
    15→import { join } from "node:path";
    16→
    17→const WEB_UI_ROOT = join(process.cwd(), "packages", "web-ui");
    18→const WEB_UI_SRC = join(WEB_UI_ROOT, "src");
    19→const SESSION_COMPONENTS = join(WEB_UI_SRC, "lib", "components", "session");
    20→
    21→// ─── Runtime imports ─────────────────────────────────────────────────────────
    22→
    23→type SessionUtils = typeof import("../packages/web-ui/src/lib/components/session/session-utils");
    24→type MarkdownUtils = typeof import("../packages/web-ui/src/lib/utils/markdown");
    25→
    26→let parseEventsToBlocks: SessionUtils["parseEventsToBlocks"];
    27→let getToolIcon: SessionUtils["getToolIcon"];
    28→let getToolInputPreview: SessionUtils["getToolInputPreview"];
    29→let formatDuration: SessionUtils["formatDuration"];
    30→let formatTime: SessionUtils["formatTime"];
    31→let formatElapsed: SessionUtils["formatElapsed"];
    32→let formatAge: SessionUtils["formatAge"];
    33→let extractFilesChanged: SessionUtils["extractFilesChanged"];
    34→let renderMarkdown: MarkdownUtils["renderMarkdown"];
    35→
    36→beforeAll(async () => {
    37→  const sessionMod = await import(
    38→    "../packages/web-ui/src/lib/components/session/session-utils"
    39→  );
    40→  parseEventsToBlocks = sessionMod.parseEventsToBlocks;
    41→  getToolIcon = sessionMod.getToolIcon;
    42→  getToolInputPreview = sessionMod.getToolInputPreview;
    43→  formatDuration = sessionMod.formatDuration;
    44→  formatTime = sessionMod.formatTime;
    45→  formatElapsed = sessionMod.formatElapsed;
    46→  formatAge = sessionMod.formatAge;
    47→  extractFilesChanged = sessionMod.extractFilesChanged;
    48→
    49→  const markdownMod = await import(
    50→    "../packages/web-ui/src/lib/utils/markdown"
    51→  );
    52→  renderMarkdown = markdownMod.renderMarkdown;
    53→});
    54→
    55→// ─── AC-1: Structured event blocks ────────────────────────────────────────────
    56→
    57→// AC: @ui-session-stream ac-1
    58→describe("structured event blocks (@ui-session-stream ac-1)", () => {
    59→  describe("component files exist", () => {
    60→    it("session route exists at /sessions/[id]", () => {
    61→      expect(
    62→        existsSync(join(WEB_UI_SRC, "routes", "sessions", "[id]", "+page.svelte")),
    63→      ).toBe(true);
    64→    });
    65→
    66→    it("all block components exist", () => {
    67→      expect(existsSync(join(SESSION_COMPONENTS, "MessageBlock.svelte"))).toBe(true);
    68→      expect(existsSync(join(SESSION_COMPONENTS, "ToolCallView.svelte"))).toBe(true);
    69→      expect(existsSync(join(SESSION_COMPONENTS, "ThinkingBlock.svelte"))).toBe(true);
    70→      expect(existsSync(join(SESSION_COMPONENTS, "SystemBlock.svelte"))).toBe(true);
    71→      expect(existsSync(join(SESSION_COMPONENTS, "SessionStream.svelte"))).toBe(true);
    72→    });
    73→  });
    74→
    75→  describe("parseEventsToBlocks — session lifecycle events", () => {
    76→    // AC: @ui-session-stream ac-1
    77→    it("parses session.start as system block with agent type", () => {
    78→      const events = [
    79→        {
    80→          ts: 1000,
    81→          seq: 0,
    82→          type: "session.start",
    83→          session_id: "s1",
    84→          data: { agent_type: "worker" },
    85→        },
    86→      ];
    87→      const blocks = parseEventsToBlocks(events);
    88→      expect(blocks).toHaveLength(1);
    89→      expect(blocks[0]).toMatchObject({
    90→        type: "system",
    91→        label: "Session started",
    92→        detail: "Agent: worker",
    93→        timestamp: 1000,
    94→        seq: 0,
    95→      });
    96→    });
    97→
    98→    // AC: @ui-session-stream ac-1
    99→    it("parses session.end as system block", () => {
   100→      const events = [
   101→        {
   102→          ts: 5000,
   103→          seq: 10,
   104→          type: "session.end",
   105→          session_id: "s1",
   106→          data: { reason: "completed" },
   107→        },
   108→      ];
   109→      const blocks = parseEventsToBlocks(events);
   110→      expect(blocks).toHaveLength(1);
   111→      expect(blocks[0]).toMatchObject({
   112→        type: "system",
   113→        label: "Session ended",
   114→        detail: "completed",
   115→      });
   116→    });
   117→
   118→    // AC: @ui-session-stream ac-1
   119→    it("parses session.wrapup as system block", () => {
   120→      const events = [
   121→        {
   122→          ts: 4000,
   123→          seq: 8,
   124→          type: "session.wrapup",
   125→          session_id: "s1",
   126→          data: { reason: "budget exhausted" },
   127→        },
   128→      ];
   129→      const blocks = parseEventsToBlocks(events);
   130→      expect(blocks).toHaveLength(1);
   131→      expect(blocks[0]).toMatchObject({
   132→        type: "system",
   133→        label: "Session wrapping up",
   134→        detail: "budget exhausted",
   135→      });
   136→    });
   137→  });
   138→
   139→  describe("parseEventsToBlocks — message blocks", () => {
   140→    // AC: @ui-session-stream ac-1
   141→    it("parses assistant_text as message block", () => {
   142→      const events = [
   143→        {
   144→          ts: 1000,
   145→          seq: 0,
   146→          type: "session.update",
   147→          session_id: "s1",
   148→          data: {
   149→            update: { sessionUpdate: "assistant_text", text: "Hello world" },
   150→          },
   151→        },
   152→      ];
   153→      const blocks = parseEventsToBlocks(events);
   154→      expect(blocks).toHaveLength(1);
   155→      expect(blocks[0]).toMatchObject({
   156→        type: "message",
   157→        content: "Hello world",
   158→        timestamp: 1000,
   159→      });
   160→    });
   161→
   162→    // AC: @ui-session-stream ac-1
   163→    it("parses assistant variant as message block", () => {
   164→      const events = [
   165→        {
   166→          ts: 2000,
   167→          seq: 1,
   168→          type: "session.update",
   169→          session_id: "s1",
   170→          data: {
   171→            update: { sessionUpdate: "assistant", content: "Response text" },
   172→          },
   173→        },
   174→      ];
   175→      const blocks = parseEventsToBlocks(events);
   176→      expect(blocks).toHaveLength(1);
   177→      expect(blocks[0]).toMatchObject({
   178→        type: "message",
   179→        content: "Response text",
   180→      });
   181→    });
   182→
   183→    // AC: @ui-session-stream ac-1
   184→    it("merges consecutive message blocks into one", () => {
   185→      const events = [
   186→        {
   187→          ts: 1000,
   188→          seq: 0,
   189→          type: "session.update",
   190→          session_id: "s1",
   191→          data: {
   192→            update: { sessionUpdate: "assistant_text", text: "Hello " },
   193→          },
   194→        },
   195→        {
   196→          ts: 1001,
   197→          seq: 1,
   198→          type: "session.update",
   199→          session_id: "s1",
   200→          data: {
   201→            update: { sessionUpdate: "assistant_text", text: "world" },
   202→          },
   203→        },
   204→      ];
   205→      const blocks = parseEventsToBlocks(events);
   206→      expect(blocks).toHaveLength(1);
   207→      expect(blocks[0].type).toBe("message");
   208→      if (blocks[0].type === "message") {
   209→        expect(blocks[0].content).toBe("Hello world");
   210→      }
   211→    });
   212→
   213→    // AC: @ui-session-stream ac-1
   214→    it("does not merge messages separated by other block types", () => {
   215→      const events = [
   216→        {
   217→          ts: 1000,
   218→          seq: 0,
   219→          type: "session.update",
   220→          session_id: "s1",
   221→          data: {
   222→            update: { sessionUpdate: "assistant_text", text: "First" },
   223→          },
   224→        },
   225→        {
   226→          ts: 1500,
   227→          seq: 1,
   228→          type: "session.update",
   229→          session_id: "s1",
   230→          data: {
   231→            update: { sessionUpdate: "thinking", text: "hmm" },
   232→          },
   233→        },
   234→        {
   235→          ts: 2000,
   236→          seq: 2,
   237→          type: "session.update",
   238→          session_id: "s1",
   239→          data: {
   240→            update: { sessionUpdate: "assistant_text", text: "Second" },
   241→          },
   242→        },
   243→      ];
   244→      const blocks = parseEventsToBlocks(events);
   245→      expect(blocks).toHaveLength(3);
   246→      expect(blocks[0].type).toBe("message");
   247→      expect(blocks[1].type).toBe("thinking");
   248→      expect(blocks[2].type).toBe("message");
   249→      if (blocks[0].type === "message" && blocks[2].type === "message") {
   250→        expect(blocks[0].content).toBe("First");
   251→        expect(blocks[2].content).toBe("Second");
   252→      }
   253→    });
   254→
   255→    // AC: @ui-session-stream ac-1
   256→    it("ignores empty text content", () => {
   257→      const events = [
   258→        {
   259→          ts: 1000,
   260→          seq: 0,
   261→          type: "session.update",
   262→          session_id: "s1",
   263→          data: { update: { sessionUpdate: "assistant_text", text: "" } },
   264→        },
   265→      ];
   266→      const blocks = parseEventsToBlocks(events);
   267→      expect(blocks).toHaveLength(0);
   268→    });
   269→  });
