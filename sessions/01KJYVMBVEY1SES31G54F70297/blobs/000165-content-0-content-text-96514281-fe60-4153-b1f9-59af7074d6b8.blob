  1000→// ─── AC-3: Auto-scroll ──────────────────────────────────────────────────────
  1001→
  1002→// AC: @ui-session-stream ac-3
  1003→describe("auto-scroll behavior (@ui-session-stream ac-3)", () => {
  1004→  // AC: @ui-session-stream ac-3
  1005→  it("auto-scroll threshold is 100px from bottom", () => {
  1006→    // Test the scroll distance calculation used for auto-scroll detection
  1007→    const scrollHeight = 1000;
  1008→    const clientHeight = 400;
  1009→
  1010→    // The component uses: distanceFromBottom = scrollHeight - scrollTop - clientHeight
  1011→    // shouldAutoScroll = distanceFromBottom < 100
  1012→    function calcDistance(scrollTop: number): number {
  1013→      return scrollHeight - scrollTop - clientHeight;
  1014→    }
  1015→
  1016→    // At bottom (scrollTop = scrollHeight - clientHeight = 600)
  1017→    expect(calcDistance(600)).toBe(0);
  1018→    expect(calcDistance(600) < 100).toBe(true); // auto-scroll ON
  1019→
  1020→    // 50px from bottom
  1021→    expect(calcDistance(550)).toBe(50);
  1022→    expect(calcDistance(550) < 100).toBe(true); // auto-scroll ON
  1023→
  1024→    // 100px from bottom (exactly at threshold)
  1025→    expect(calcDistance(500)).toBe(100);
  1026→    expect(calcDistance(500) < 100).toBe(false); // auto-scroll OFF
  1027→
  1028→    // 200px from bottom
  1029→    expect(calcDistance(400)).toBe(200);
  1030→    expect(calcDistance(400) < 100).toBe(false); // auto-scroll OFF
  1031→  });
  1032→
  1033→  // AC: @ui-session-stream ac-3
  1034→  it("jump-to-bottom button visibility depends on auto-scroll state", () => {
  1035→    // The component uses: showJumpButton = !shouldAutoScroll && (isLive || blocks.length > 0)
  1036→    function showJumpButton(
  1037→      shouldAutoScroll: boolean,
  1038→      isLive: boolean,
  1039→      blockCount: number,
  1040→    ): boolean {
  1041→      return !shouldAutoScroll && (isLive || blockCount > 0);
  1042→    }
  1043→
  1044→    // Auto-scrolling: button hidden
  1045→    expect(showJumpButton(true, true, 10)).toBe(false);
  1046→    expect(showJumpButton(true, false, 10)).toBe(false);
  1047→
  1048→    // Not auto-scrolling + live: button shown
  1049→    expect(showJumpButton(false, true, 10)).toBe(true);
  1050→
  1051→    // Not auto-scrolling + has blocks: button shown
  1052→    expect(showJumpButton(false, false, 5)).toBe(true);
  1053→
  1054→    // Not auto-scrolling + no content: button hidden
  1055→    expect(showJumpButton(false, false, 0)).toBe(false);
  1056→  });
  1057→
  1058→  // AC: @ui-session-stream ac-3
  1059→  it("scroll debounce uses 150ms timer", () => {
  1060→    // Verify the debounce logic: rapid scroll events should be debounced
  1061→    let userScrolling = false;
  1062→    let timer: ReturnType<typeof setTimeout> | undefined;
  1063→
  1064→    function handleScroll() {
  1065→      if (timer) clearTimeout(timer);
  1066→      userScrolling = true;
  1067→      timer = setTimeout(() => {
  1068→        userScrolling = false;
  1069→      }, 150);
  1070→    }
  1071→
  1072→    // Simulate rapid scrolling
  1073→    handleScroll();
  1074→    expect(userScrolling).toBe(true);
  1075→
  1076→    // Before debounce resolves
  1077→    handleScroll();
  1078→    expect(userScrolling).toBe(true);
  1079→
  1080→    // Cleanup
  1081→    if (timer) clearTimeout(timer);
  1082→  });
  1083→});
  1084→
