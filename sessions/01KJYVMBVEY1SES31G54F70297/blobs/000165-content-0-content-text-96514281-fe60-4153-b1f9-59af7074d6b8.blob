   528→  describe("parseEventsToBlocks — agent lifecycle and other events", () => {
   529→    // AC: @ui-session-stream ac-1
   530→    it("handles all agent lifecycle event types", () => {
   531→      const agentEvents = [
   532→        "agent.dispatched",
   533→        "agent.started",
   534→        "agent.completed",
   535→        "agent.failed",
   536→        "agent.timeout",
   537→      ];
   538→      const events = agentEvents.map((type, i) => ({
   539→        ts: 1000 + i * 1000,
   540→        seq: i,
   541→        type,
   542→        session_id: "s1",
   543→        data: { task_ref: "@task-foo" },
   544→      }));
   545→      const blocks = parseEventsToBlocks(events);
   546→      expect(blocks).toHaveLength(5);
   547→
   548→      const labels = blocks.map((b) =>
   549→        b.type === "system" ? b.label : "",
   550→      );
   551→      expect(labels).toEqual([
   552→        "Agent dispatched",
   553→        "Agent started",
   554→        "Agent completed",
   555→        "Agent failed",
   556→        "Agent timed out",
   557→      ]);
   558→
   559→      // All should include task detail
   560→      for (const block of blocks) {
   561→        if (block.type === "system") {
   562→          expect(block.detail).toBe("Task: @task-foo");
   563→        }
   564→      }
   565→    });
   566→
