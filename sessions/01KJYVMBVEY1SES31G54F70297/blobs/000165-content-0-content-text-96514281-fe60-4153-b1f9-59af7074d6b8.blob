  1390→
  1391→describe("design tokens and accessibility", () => {
  1392→  it("no raw Tailwind color classes in session components", () => {
  1393→    // Read component sources and verify no raw emerald/red/blue/purple colors
  1394→    const { readFileSync } = require("node:fs");
  1395→    const componentFiles = [
  1396→      "SessionStream.svelte",
  1397→      "ToolCallView.svelte",
  1398→      "ThinkingBlock.svelte",
  1399→      "MessageBlock.svelte",
  1400→      "SystemBlock.svelte",
  1401→      "SessionContextPanel.svelte",
  1402→    ];
  1403→
  1404→    const rawColorPattern =
  1405→      /\b(?:text|bg|border(?:-[lrtb])?)-(?:emerald|red|blue|purple|green|amber|orange|yellow|pink|teal|cyan|indigo|violet|fuchsia|rose|lime|sky)-\d+\b/g;
  1406→
  1407→    for (const file of componentFiles) {
  1408→      const path = join(SESSION_COMPONENTS, file);
  1409→      if (existsSync(path)) {
  1410→        const src = readFileSync(path, "utf-8");
  1411→        const matches = src.match(rawColorPattern);
  1412→        expect(
  1413→          matches,
  1414→          `${file} contains raw Tailwind colors: ${matches?.join(", ")}`,
  1415→        ).toBeNull();
  1416→      }
  1417→    }
  1418→  });
  1419→
  1420→  it("no raw Tailwind color classes in session page", () => {
  1421→    const { readFileSync } = require("node:fs");
  1422→    const pagePath = join(WEB_UI_SRC, "routes", "sessions", "[id]", "+page.svelte");
  1423→    const src = readFileSync(pagePath, "utf-8");
  1424→    const rawColorPattern =
  1425→      /\b(?:text|bg|border(?:-[lrtb])?)-(?:emerald|red|blue|purple|green)-\d+\b/g;
  1426→    const matches = src.match(rawColorPattern);
  1427→    expect(
  1428→      matches,
  1429→      `Session page contains raw Tailwind colors: ${matches?.join(", ")}`,
  1430→    ).toBeNull();
  1431→  });
  1432→
  1433→  it("session stream has aria-live and role=log for screen readers", () => {
  1434→    const { readFileSync } = require("node:fs");
  1435→    const src = readFileSync(
  1436→      join(SESSION_COMPONENTS, "SessionStream.svelte"),
  1437→      "utf-8",
  1438→    );
  1439→    // Verify the stream container has accessibility attributes
  1440→    expect(src).toContain("aria-live");
  1441→    expect(src).toContain('role="log"');
  1442→  });
  1443→
  1444→  it("animations are gated behind prefers-reduced-motion", () => {
  1445→    const { readFileSync } = require("node:fs");
  1446→    const animatedFiles = [
  1447→      "SessionStream.svelte",
  1448→      "ToolCallView.svelte",
  1449→      "SessionContextPanel.svelte",
  1450→    ];
  1451→
  1452→    for (const file of animatedFiles) {
  1453→      const path = join(SESSION_COMPONENTS, file);
  1454→      if (existsSync(path)) {
  1455→        const src = readFileSync(path, "utf-8");
  1456→        // If file has @keyframes, it should also have prefers-reduced-motion
  1457→        if (src.includes("@keyframes")) {
  1458→          expect(
  1459→            src,
  1460→            `${file} has animations but missing prefers-reduced-motion media query`,
  1461→          ).toContain("prefers-reduced-motion");
  1462→        }
  1463→      }
  1464→    }
  1465→  });
  1466→});
