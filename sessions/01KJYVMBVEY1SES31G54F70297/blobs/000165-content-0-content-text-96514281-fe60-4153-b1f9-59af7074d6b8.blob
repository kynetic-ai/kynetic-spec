   892→// ─── AC-2: Live streaming ────────────────────────────────────────────────────
   893→
   894→// AC: @ui-session-stream ac-2
   895→describe("live streaming logic (@ui-session-stream ac-2)", () => {
   896→  describe("incremental event loading", () => {
   897→    // AC: @ui-session-stream ac-2
   898→    it("parseEventsToBlocks handles incremental event appending", () => {
   899→      // Simulate first load
   900→      const batch1 = [
   901→        { ts: 1000, seq: 0, type: "session.start", session_id: "s1", data: { agent_type: "worker" } },
   902→        { ts: 1100, seq: 1, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "assistant_text", text: "Hello" } } },
   903→      ];
   904→      let allEvents = [...batch1];
   905→      let blocks = parseEventsToBlocks(allEvents);
   906→      expect(blocks).toHaveLength(2);
   907→      expect(blocks[1]).toMatchObject({ type: "message", content: "Hello" });
   908→
   909→      // Simulate incremental refresh (new events appended)
   910→      const batch2 = [
   911→        { ts: 1200, seq: 2, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_call", toolCallId: "tc1", tool: "Bash", rawInput: { command: "echo test" } } } },
   912→        { ts: 1500, seq: 3, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_result", toolCallId: "tc1", output: "test" } } },
   913→      ];
   914→      allEvents = [...allEvents, ...batch2];
   915→      blocks = parseEventsToBlocks(allEvents);
   916→      expect(blocks).toHaveLength(3);
   917→      expect(blocks.map((b) => b.type)).toEqual(["system", "message", "tool_call"]);
   918→
   919→      // Verify the tool call resolved
   920→      if (blocks[2].type === "tool_call") {
   921→        expect(blocks[2].status).toBe("completed");
   922→        expect(blocks[2].durationMs).toBe(300);
   923→      }
   924→    });
   925→
   926→    // AC: @ui-session-stream ac-2
   927→    it("lastSeq tracking: new events have higher seq than previous batch", () => {
   928→      const events = [
   929→        { ts: 1000, seq: 0, type: "session.start", session_id: "s1", data: {} },
   930→        { ts: 2000, seq: 5, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "assistant_text", text: "msg" } } },
   931→        { ts: 3000, seq: 10, type: "session.end", session_id: "s1", data: {} },
   932→      ];
   933→      // Verify events are ordered by seq and we can track lastSeq
   934→      const lastSeq = events[events.length - 1].seq;
   935→      expect(lastSeq).toBe(10);
   936→
   937→      // Subsequent events should have seq > lastSeq
   938→      const newEvents = [
   939→        { ts: 3100, seq: 11, type: "note", session_id: "s1", data: { message: "late note" } },
   940→      ];
   941→      expect(newEvents.every((e) => e.seq > lastSeq)).toBe(true);
   942→    });
   943→  });
   944→
   945→  describe("streaming text accumulation", () => {
   946→    // AC: @ui-session-stream ac-2
   947→    it("agent_text_chunk events accumulate text for matching session_id", () => {
   948→      // Simulate the handleAgentEvent logic from the page component
   949→      let streamingText = "";
   950→      const sessionId = "s1";
   951→
   952→      const chunks = [
   953→        { event: "agent_text_chunk", data: { session_id: "s1", text: "Hello " } },
   954→        { event: "agent_text_chunk", data: { session_id: "s1", text: "world" } },
   955→        { event: "agent_text_chunk", data: { session_id: "s2", text: "other session" } },
   956→      ];
   957→
   958→      for (const chunk of chunks) {
   959→        if (chunk.event === "agent_text_chunk") {
   960→          const data = chunk.data as { session_id?: string; text?: string };
   961→          if (data.session_id === sessionId && data.text) {
   962→            streamingText += data.text;
   963→          }
   964→        }
   965→      }
   966→
   967→      expect(streamingText).toBe("Hello world");
   968→    });
   969→
   970→    // AC: @ui-session-stream ac-2
   971→    it("streaming text clears when structured refresh provides new blocks", () => {
   972→      // Simulate the refresh pattern: streaming text accumulates, then clears
   973→      let streamingText = "partial text from chunks";
   974→
   975→      // On refresh with new events, streaming text resets
   976→      const newEvents = [
   977→        { ts: 5000, seq: 50, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "assistant_text", text: "partial text from chunks" } } },
   978→      ];
   979→      const blocks = parseEventsToBlocks(newEvents);
   980→      if (blocks.length > 0) {
   981→        streamingText = "";
   982→      }
   983→
   984→      expect(streamingText).toBe("");
   985→      expect(blocks[0]).toMatchObject({ type: "message", content: "partial text from chunks" });
   986→    });
   987→  });
   988→
   989→  describe("session activity detection", () => {
   990→    // AC: @ui-session-stream ac-2
   991→    it("isLive is determined by session status being active", () => {
   992→      const activeSession = { status: "active" as const };
   993→      const completedSession = { status: "completed" as const };
   994→      expect(activeSession.status === "active").toBe(true);
   995→      expect(completedSession.status === "active").toBe(false);
   996→    });
   997→  });
   998→});
