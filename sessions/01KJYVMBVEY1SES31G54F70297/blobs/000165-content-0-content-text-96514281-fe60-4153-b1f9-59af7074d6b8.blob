   271→  describe("parseEventsToBlocks — tool call blocks", () => {
   272→    // AC: @ui-session-stream ac-1
   273→    it("creates tool call block with running status and resolves on result", () => {
   274→      const events = [
   275→        {
   276→          ts: 1000,
   277→          seq: 0,
   278→          type: "session.update",
   279→          session_id: "s1",
   280→          data: {
   281→            update: {
   282→              sessionUpdate: "tool_call",
   283→              toolCallId: "tc-1",
   284→              tool: "Bash",
   285→              rawInput: { command: "ls" },
   286→            },
   287→          },
   288→        },
   289→        {
   290→          ts: 2500,
   291→          seq: 1,
   292→          type: "session.update",
   293→          session_id: "s1",
   294→          data: {
   295→            update: {
   296→              sessionUpdate: "tool_result",
   297→              toolCallId: "tc-1",
   298→              output: "file.txt\ndir/",
   299→            },
   300→          },
   301→        },
   302→      ];
   303→      const blocks = parseEventsToBlocks(events);
   304→      expect(blocks).toHaveLength(1);
   305→      expect(blocks[0]).toMatchObject({
   306→        type: "tool_call",
   307→        toolName: "Bash",
   308→        toolCallId: "tc-1",
   309→        input: { command: "ls" },
   310→        output: "file.txt\ndir/",
   311→        status: "completed",
   312→        durationMs: 1500,
   313→        startedAt: 1000,
   314→        completedAt: 2500,
   315→      });
   316→    });
   317→
   318→    // AC: @ui-session-stream ac-1
   319→    it("marks tool call as failed when error flag is set", () => {
   320→      const events = [
   321→        {
   322→          ts: 1000,
   323→          seq: 0,
   324→          type: "session.update",
   325→          session_id: "s1",
   326→          data: {
   327→            update: {
   328→              sessionUpdate: "tool_call",
   329→              toolCallId: "tc-err",
   330→              tool: "Bash",
   331→              rawInput: { command: "false" },
   332→            },
   333→          },
   334→        },
   335→        {
   336→          ts: 2000,
   337→          seq: 1,
   338→          type: "session.update",
   339→          session_id: "s1",
   340→          data: {
   341→            update: {
   342→              sessionUpdate: "tool_result",
   343→              toolCallId: "tc-err",
   344→              output: "exit code 1",
   345→              error: true,
   346→            },
   347→          },
   348→        },
   349→      ];
   350→      const blocks = parseEventsToBlocks(events);
   351→      expect(blocks[0]).toMatchObject({
   352→        type: "tool_call",
   353→        status: "failed",
   354→        durationMs: 1000,
   355→      });
   356→    });
   357→
   358→    // AC: @ui-session-stream ac-1
   359→    it("marks tool call as failed when isError flag is set", () => {
   360→      const events = [
   361→        {
   362→          ts: 1000,
   363→          seq: 0,
   364→          type: "session.update",
   365→          session_id: "s1",
   366→          data: {
   367→            update: {
   368→              sessionUpdate: "tool_call",
   369→              toolCallId: "tc-err2",
   370→              tool: "Read",
   371→              rawInput: { file_path: "/missing" },
   372→            },
   373→          },
   374→        },
   375→        {
   376→          ts: 1200,
   377→          seq: 1,
   378→          type: "session.update",
   379→          session_id: "s1",
   380→          data: {
   381→            update: {
   382→              sessionUpdate: "tool_result",
   383→              toolCallId: "tc-err2",
   384→              output: "File not found",
   385→              isError: true,
   386→            },
   387→          },
   388→        },
   389→      ];
   390→      const blocks = parseEventsToBlocks(events);
   391→      expect(blocks[0]).toMatchObject({
   392→        type: "tool_call",
   393→        status: "failed",
   394→      });
   395→    });
   396→
   397→    // AC: @ui-session-stream ac-1
   398→    it("handles tool.call / tool.result event types (alternative format)", () => {
   399→      const events = [
   400→        {
   401→          ts: 1000,
   402→          seq: 0,
   403→          type: "tool.call",
   404→          session_id: "s1",
   405→          data: { tool: "Read", toolCallId: "tc-2", input: { file_path: "/a.ts" } },
   406→        },
   407→        {
   408→          ts: 1500,
   409→          seq: 1,
   410→          type: "tool.result",
   411→          session_id: "s1",
   412→          data: { toolCallId: "tc-2", output: "contents" },
   413→        },
   414→      ];
   415→      const blocks = parseEventsToBlocks(events);
   416→      expect(blocks).toHaveLength(1);
   417→      expect(blocks[0]).toMatchObject({
   418→        type: "tool_call",
   419→        toolName: "Read",
   420→        status: "completed",
   421→        durationMs: 500,
   422→      });
   423→    });
   424→
   425→    // AC: @ui-session-stream ac-1
   426→    it("leaves tool call as running if no result arrives", () => {
   427→      const events = [
   428→        {
   429→          ts: 1000,
   430→          seq: 0,
   431→          type: "session.update",
   432→          session_id: "s1",
   433→          data: {
   434→            update: {
   435→              sessionUpdate: "tool_call",
   436→              toolCallId: "tc-pending",
   437→              tool: "Bash",
   438→              rawInput: { command: "sleep 999" },
   439→            },
   440→          },
   441→        },
   442→      ];
   443→      const blocks = parseEventsToBlocks(events);
   444→      expect(blocks[0]).toMatchObject({
   445→        type: "tool_call",
   446→        status: "running",
   447→      });
   448→      if (blocks[0].type === "tool_call") {
   449→        expect(blocks[0].durationMs).toBeUndefined();
   450→        expect(blocks[0].output).toBeUndefined();
   451→      }
   452→    });
   453→  });
