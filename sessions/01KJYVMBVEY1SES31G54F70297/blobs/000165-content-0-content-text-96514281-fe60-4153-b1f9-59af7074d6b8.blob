  1298→  describe("session metadata types", () => {
  1299→    // AC: @ui-session-stream ac-4
  1300→    it("SessionDetail includes spec_context and budget fields", () => {
  1301→      // Test that the type contract is correct by constructing mock data
  1302→      const session = {
  1303→        id: "s1",
  1304→        status: "completed" as const,
  1305→        agent_type: "worker",
  1306→        session_type: "invocation" as const,
  1307→        started_at: "2026-01-01T00:00:00Z",
  1308→        ended_at: "2026-01-01T01:00:00Z",
  1309→        duration_ms: 3600000,
  1310→        event_count: 50,
  1311→        iteration_count: 3,
  1312→        tasks_completed: 1,
  1313→        spec_context: {
  1314→          spec_ref: "@ui-session-stream",
  1315→          title: "Session Stream View",
  1316→          acceptance_criteria: [
  1317→            { id: "ac-1", description: "Structured blocks" },
  1318→            { id: "ac-2", description: "Live streaming" },
  1319→          ],
  1320→        },
  1321→        budget: {
  1322→          max_per_cycle: 10,
  1323→          started_this_cycle: 3,
  1324→        },
  1325→      };
  1326→
  1327→      // Verify spec context
  1328→      expect(session.spec_context).toBeDefined();
  1329→      expect(session.spec_context!.spec_ref).toBe("@ui-session-stream");
  1330→      expect(session.spec_context!.title).toBe("Session Stream View");
  1331→      expect(session.spec_context!.acceptance_criteria).toHaveLength(2);
  1332→      expect(session.spec_context!.acceptance_criteria[0].id).toBe("ac-1");
  1333→
  1334→      // Verify budget
  1335→      expect(session.budget).toBeDefined();
  1336→      expect(session.budget!.max_per_cycle).toBe(10);
  1337→      expect(session.budget!.started_this_cycle).toBe(3);
  1338→    });
  1339→
  1340→    // AC: @ui-session-stream ac-4
  1341→    it("spec_context and budget can be null/undefined", () => {
  1342→      const session = {
  1343→        id: "s2",
  1344→        status: "active" as const,
  1345→        spec_context: null,
  1346→        budget: undefined,
  1347→      };
