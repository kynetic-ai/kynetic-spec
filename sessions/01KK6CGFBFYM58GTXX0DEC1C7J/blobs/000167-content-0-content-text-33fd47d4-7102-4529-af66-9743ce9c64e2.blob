```
     1→/**
     2→ * Tests for Path Validation Middleware
     3→ *
     4→ * Tests the HTTP middleware that validates X-Kspec-Dir header and attaches
     5→ * project context to requests for the multi-directory daemon architecture.
     6→ *
     7→ * AC: @multi-directory-daemon ac-1, ac-2, ac-3, ac-4, ac-5, ac-6, ac-7, ac-8, ac-8b, ac-8c, ac-20b
     8→ */
     9→
    10→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
    11→import { setupMultiDirFixtures, cleanupTempDir } from './helpers/cli';
    12→import { join } from 'path';
    13→import { chmodSync } from 'fs';
    14→import { symlink as symlinkAsync } from 'fs/promises';
    15→
    16→// Mock types for Hono-like middleware
    17→interface Context {
    18→  req: {
    19→    header(name: string): string | undefined;
    20→  };
    21→  set(key: string, value: unknown): void;
    22→  json(data: unknown, status: number): Response;
    23→}
    24→
    25→interface Next {
    26→  (): Promise<void>;
    27→}
    28→
    29→interface ProjectContext {
    30→  path: string;
    31→  registeredAt: Date;
    32→}
    33→
    34→// Mock ProjectContextManager (matching daemon-context-manager.test.ts)
    35→class ProjectContextManager {
    36→  private projects: Map<string, ProjectContext> = new Map();
    37→  private defaultProjectPath: string | null = null;
    38→
    39→  constructor(defaultProjectPath?: string) {
    40→    if (defaultProjectPath) {
    41→      this.defaultProjectPath = defaultProjectPath;
    42→    }
    43→  }
    44→
    45→  registerProject(projectPath: string, isDefault = false): ProjectContext {
    46→    if (!this.isAbsolutePath(projectPath)) {
    47→      throw new Error('Path must be absolute');
    48→    }
    49→
    50→    if (projectPath.includes('..')) {
    51→      throw new Error('Path must not contain parent traversal');
    52→    }
    53→
    54→    const normalizedPath = this.normalizePath(projectPath);
    55→
    56→    // Check .kspec/ exists and is readable
    57→    const { existsSync, readdirSync } = require('fs');
    58→    const kspecDir = join(normalizedPath, '.kspec');
    59→    if (!existsSync(kspecDir)) {
    60→      throw new Error(`Invalid kspec project - .kspec/ not found at ${normalizedPath}`);
    61→    }
    62→
    63→    // Try to read directory to check permissions
    64→    try {
    65→      readdirSync(kspecDir);
    66→    } catch (err: any) {
    67→      if (err.code === 'EACCES') {
    68→        throw new Error(`Permission denied - cannot read ${normalizedPath}`);
    69→      }
    70→      throw err;
    71→    }
    72→
    73→    // Check for already registered
    74→    if (this.projects.has(normalizedPath)) {
    75→      return this.projects.get(normalizedPath)!;
    76→    }
    77→
    78→    const context: ProjectContext = {
    79→      path: normalizedPath,
    80→      registeredAt: new Date(),
    81→    };
    82→
    83→    this.projects.set(normalizedPath, context);
    84→
    85→    if (isDefault) {
    86→      this.defaultProjectPath = normalizedPath;
    87→    }
    88→
    89→    return context;
    90→  }
    91→
    92→  getProject(projectPath?: string): ProjectContext {
    93→    if (projectPath) {
    94→      const normalizedPath = this.normalizePath(projectPath);
    95→      const context = this.projects.get(normalizedPath);
    96→      if (!context) {
    97→        throw new Error('Project not registered');
    98→      }
    99→      return context;
   100→    }
   101→
   102→    // No path provided - use default
   103→    if (!this.defaultProjectPath) {
   104→      throw new Error('No default project configured. Specify X-Kspec-Dir header.');
   105→    }
   106→
   107→    // Check if default project still valid
   108→    const { existsSync } = require('fs');
   109→    const kspecDir = join(this.defaultProjectPath, '.kspec');
   110→    if (!existsSync(kspecDir)) {
   111→      throw new Error('Default project no longer valid. Specify X-Kspec-Dir header.');
   112→    }
   113→
   114→    const context = this.projects.get(this.defaultProjectPath);
   115→    if (!context) {
   116→      throw new Error('Default project not registered');
   117→    }
   118→
   119→    return context;
   120→  }
   121→
   122→  private isAbsolutePath(path: string): boolean {
   123→    return path.startsWith('/') || /^[a-zA-Z]:[\\/]/.test(path);
   124→  }
   125→
   126→  private normalizePath(path: string): string {
   127→    // Remove trailing slashes
   128→    let normalized = path.replace(/\/+$/, '');
   129→
   130→    // Resolve "." and ".." segments BUT preserve symlinks
   131→    // Since we reject ".." earlier, we only handle "."
   132→    normalized = normalized.replace(/\/\.\//g, '/').replace(/\/\.$/, '');
   133→
   134→    // Collapse multiple slashes
   135→    normalized = normalized.replace(/\/+/g, '/');
   136→
   137→    return normalized;
   138→  }
   139→}
   140→
   141→// Mock path validation middleware
   142→function createPathValidationMiddleware(manager: ProjectContextManager) {
   143→  return async (ctx: Context, next: Next) => {
   144→    try {
   145→      const projectPath = ctx.req.header('X-Kspec-Dir');
   146→
   147→      if (projectPath) {
   148→        // AC: @multi-directory-daemon ac-1, ac-4, ac-5, ac-6, ac-7, ac-8, ac-8b, ac-8c
   149→        // Try to get existing or register new project
   150→        let projectContext: ProjectContext;
   151→        try {
   152→          projectContext = manager.getProject(projectPath);
   153→        } catch (err) {
   154→          // Not registered - try to register
   155→          projectContext = manager.registerProject(projectPath);
   156→        }
   157→
   158→        ctx.set('projectContext', projectContext);
   159→      } else {
   160→        // AC: @multi-directory-daemon ac-2, ac-3, ac-20b
   161→        // No header - use default project
   162→        const projectContext = manager.getProject();
   163→        ctx.set('projectContext', projectContext);
   164→      }
   165→
   166→      await next();
   167→    } catch (err: any) {
   168→      const message = err.message;
   169→
   170→      // AC: @multi-directory-daemon ac-3, ac-20b
   171→      if (message.includes('No default project configured') ||
   172→          message.includes('Default project no longer valid')) {
   173→        ctx.json({ error: message }, 400);
   174→        return; // Don't call next()
   175→      }
   176→
   177→      // AC: @multi-directory-daemon ac-5
   178→      if (message.includes('Invalid kspec project')) {
   179→        ctx.json({ error: message }, 400);
   180→        return;
   181→      }
   182→
   183→      // AC: @multi-directory-daemon ac-6
   184→      if (message.includes('Path must be absolute')) {
   185→        ctx.json({ error: 'Path must be absolute' }, 400);
   186→        return;
   187→      }
   188→
   189→      // AC: @multi-directory-daemon ac-7
   190→      if (message.includes('Path must not contain parent traversal')) {
   191→        ctx.json({ error: 'Path must not contain parent traversal' }, 400);
   192→        return;
   193→      }
   194→
   195→      // AC: @multi-directory-daemon ac-8b - permission denied
   196→      if (message.includes('Permission denied') || message.includes('EACCES')) {
   197→        ctx.json({ error: `Permission denied - cannot read ${ctx.req.header('X-Kspec-Dir')}` }, 403);
   198→        return;
   199→      }
   200→
   201→      // Other errors
   202→      ctx.json({ error: 'Internal server error' }, 500);
   203→    }
   204→  };
   205→}
   206→
   207→// Helper to create mock context
   208→function createMockContext(headers: Record<string, string> = {}): {
   209→  ctx: Context;
   210→  state: Record<string, unknown>;
   211→  responseRef: { current: { data: unknown; status: number } | null };
   212→} {
   213→  const state: Record<string, unknown> = {};
   214→  const responseRef: { current: { data: unknown; status: number } | null } = { current: null };
   215→
   216→  const ctx: Context = {
   217→    req: {
   218→      header(name: string) {
   219→        return headers[name];
   220→      },
   221→    },
   222→    set(key: string, value: unknown) {
   223→      state[key] = value;
   224→    },
   225→    json(data: unknown, status: number) {
   226→      responseRef.current = { data, status };
   227→      return new Response();
   228→    },
   229→  };
   230→
   231→  return { ctx, state, responseRef };
   232→}
   233→
   234→describe('Path Validation Middleware', () => {
   235→  let fixturesRoot: string;
   236→  let projectA: string;
   237→  let projectB: string;
   238→  let projectInvalid: string;
   239→
   240→  beforeEach(async () => {
   241→    fixturesRoot = await setupMultiDirFixtures();
   242→    projectA = join(fixturesRoot, 'project-a');
   243→    projectB = join(fixturesRoot, 'project-b');
   244→    projectInvalid = join(fixturesRoot, 'project-invalid');
   245→  });
   246→
   247→  afterEach(async () => {
   248→    await cleanupTempDir(fixturesRoot);
   249→  });
   250→
   251→  describe('X-Kspec-Dir header validation', () => {
   252→    // AC: @multi-directory-daemon ac-1
   253→    it('should use project from X-Kspec-Dir header when provided', async () => {
   254→      const manager = new ProjectContextManager();
   255→      const middleware = createPathValidationMiddleware(manager);
   256→      const { ctx, state } = createMockContext({ 'X-Kspec-Dir': projectA });
   257→
   258→      await middleware(ctx, async () => {});
   259→
   260→      expect(state.projectContext).toBeDefined();
   261→      expect((state.projectContext as ProjectContext).path).toBe(projectA);
   262→    });
   263→
   264→    // AC: @multi-directory-daemon ac-4
   265→    it('should auto-register unknown project when valid', async () => {
   266→      const manager = new ProjectContextManager();
   267→      const middleware = createPathValidationMiddleware(manager);
   268→      const { ctx, state } = createMockContext({ 'X-Kspec-Dir': projectB });
   269→
   270→      await middleware(ctx, async () => {});
   271→
   272→      expect(state.projectContext).toBeDefined();
   273→      expect((state.projectContext as ProjectContext).path).toBe(projectB);
   274→
   275→      // Verify cached by making second request
   276→      const { ctx: ctx2, state: state2 } = createMockContext({ 'X-Kspec-Dir': projectB });
   277→      await middleware(ctx2, async () => {});
   278→
   279→      expect(state2.projectContext).toBe(state.projectContext);
   280→    });
   281→
   282→    // AC: @multi-directory-daemon ac-5
   283→    it('should reject invalid project path (no .kspec/)', async () => {
   284→      const manager = new ProjectContextManager();
   285→      const middleware = createPathValidationMiddleware(manager);
   286→      const { ctx, responseRef } = createMockContext({ 'X-Kspec-Dir': projectInvalid });
   287→
   288→      await middleware(ctx, async () => {});
   289→
   290→      expect(responseRef.current).toBeTruthy();
   291→      expect(responseRef.current!.status).toBe(400);
   292→      expect((responseRef.current!.data as any).error).toContain('Invalid kspec project');
   293→      expect((responseRef.current!.data as any).error).toContain(projectInvalid);
   294→    });
   295→
   296→    // AC: @multi-directory-daemon ac-6
   297→    it('should reject relative paths', async () => {
   298→      const manager = new ProjectContextManager();
   299→      const middleware = createPathValidationMiddleware(manager);
   300→      const { ctx, responseRef } = createMockContext({ 'X-Kspec-Dir': './relative/path' });
   301→
   302→      await middleware(ctx, async () => {});
   303→
   304→      expect(responseRef.current).toBeTruthy();
   305→      expect(responseRef.current!.status).toBe(400);
   306→      expect((responseRef.current!.data as any).error).toBe('Path must be absolute');
   307→    });
   308→
   309→    // AC: @multi-directory-daemon ac-7
   310→    it('should reject paths with parent traversal', async () => {
   311→      const manager = new ProjectContextManager();
   312→      const middleware = createPathValidationMiddleware(manager);
   313→      const { ctx, responseRef } = createMockContext({ 'X-Kspec-Dir': projectA + '/../something' });
   314→
   315→      await middleware(ctx, async () => {});
   316→
   317→      expect(responseRef.current).toBeTruthy();
   318→      expect(responseRef.current!.status).toBe(400);
   319→      expect((responseRef.current!.data as any).error).toBe('Path must not contain parent traversal');
   320→    });
   321→
   322→    // AC: @multi-directory-daemon ac-8
   323→    it('should normalize paths (remove trailing slashes)', async () => {
   324→      const manager = new ProjectContextManager();
   325→      const middleware = createPathValidationMiddleware(manager);
   326→
   327→      // Register with trailing slash
   328→      const { ctx: ctx1, state: state1 } = createMockContext({ 'X-Kspec-Dir': projectA + '/' });
   329→      await middleware(ctx1, async () => {});
   330→
   331→      // Request without trailing slash - should get same context
   332→      const { ctx: ctx2, state: state2 } = createMockContext({ 'X-Kspec-Dir': projectA });
   333→      await middleware(ctx2, async () => {});
   334→
   335→      expect(state1.projectContext).toBe(state2.projectContext);
   336→      expect((state1.projectContext as ProjectContext).path).toBe(projectA);
   337→    });
   338→
   339→    // AC: @multi-directory-daemon ac-8 (multiple slashes)
   340→    it('should normalize paths (collapse multiple slashes)', async () => {
   341→      const manager = new ProjectContextManager();
   342→      const middleware = createPathValidationMiddleware(manager);
   343→
   344→      const pathWithMultipleSlashes = projectA.replace(/\//g, '//');
   345→      const { ctx, state } = createMockContext({ 'X-Kspec-Dir': pathWithMultipleSlashes });
   346→      await middleware(ctx, async () => {});
   347→
   348→      expect((state.projectContext as ProjectContext).path).toBe(projectA);
   349→    });
   350→
   351→    // AC: @multi-directory-daemon ac-8 (dot segments)
   352→    it('should normalize paths (resolve dot segments)', async () => {
   353→      const manager = new ProjectContextManager();
   354→      const middleware = createPathValidationMiddleware(manager);
   355→
   356→      const pathWithDots = projectA + '/.';
   357→      const { ctx, state } = createMockContext({ 'X-Kspec-Dir': pathWithDots });
   358→      await middleware(ctx, async () => {});
   359→
   360→      expect((state.projectContext as ProjectContext).path).toBe(projectA);
   361→    });
   362→
   363→    // AC: @multi-directory-daemon ac-8c
   364→    it('should NOT resolve symlinks during normalization', async () => {
   365→      const manager = new ProjectContextManager();
   366→      const middleware = createPathValidationMiddleware(manager);
   367→
   368→      // Create symlink to projectA
   369→      const symlinkPath = join(fixturesRoot, 'symlink-to-a');
   370→      await symlinkAsync(projectA, symlinkPath);
   371→
   372→      // Register via symlink
   373→      const { ctx: ctx1, state: state1 } = createMockContext({ 'X-Kspec-Dir': symlinkPath });
   374→      await middleware(ctx1, async () => {});
   375→
   376→      // Register via real path
   377→      const { ctx: ctx2, state: state2 } = createMockContext({ 'X-Kspec-Dir': projectA });
   378→      await middleware(ctx2, async () => {});
   379→
   380→      // Should be different contexts (symlinks NOT resolved)
   381→      expect(state1.projectContext).not.toBe(state2.projectContext);
   382→      expect((state1.projectContext as ProjectContext).path).toBe(symlinkPath);
   383→      expect((state2.projectContext as ProjectContext).path).toBe(projectA);
   384→    });
   385→  });
   386→
   387→  describe('Default project handling', () => {
   388→    // AC: @multi-directory-daemon ac-2
   389→    it('should use default project when no X-Kspec-Dir header', async () => {
   390→      const manager = new ProjectContextManager(projectA);
   391→      manager.registerProject(projectA, true);
   392→
   393→      const middleware = createPathValidationMiddleware(manager);
   394→      const { ctx, state } = createMockContext();
   395→
   396→      await middleware(ctx, async () => {});
   397→
   398→      expect(state.projectContext).toBeDefined();
   399→      expect((state.projectContext as ProjectContext).path).toBe(projectA);
   400→    });
   401→
   402→    // AC: @multi-directory-daemon ac-3
   403→    it('should return 400 when no default configured and no header', async () => {
   404→      const manager = new ProjectContextManager();
   405→      const middleware = createPathValidationMiddleware(manager);
   406→      const { ctx, responseRef } = createMockContext();
   407→
   408→      await middleware(ctx, async () => {});
   409→
   410→      expect(responseRef.current).toBeTruthy();
   411→      expect(responseRef.current!.status).toBe(400);
   412→      expect((responseRef.current!.data as any).error).toBe('No default project configured. Specify X-Kspec-Dir header.');
   413→    });
   414→
   415→    // AC: @multi-directory-daemon ac-20b
   416→    it('should return 400 when default project .kspec/ deleted', async () => {
   417→      const manager = new ProjectContextManager(projectA);
   418→      manager.registerProject(projectA, true);
   419→
   420→      const middleware = createPathValidationMiddleware(manager);
   421→
   422→      // Delete .kspec/ directory
   423→      const { rmSync } = require('fs');
   424→      const kspecDir = join(projectA, '.kspec');
   425→      rmSync(kspecDir, { recursive: true, force: true });
   426→
   427→      const { ctx, responseRef } = createMockContext();
   428→      await middleware(ctx, async () => {});
   429→
   430→      expect(responseRef.current).toBeTruthy();
   431→      expect(responseRef.current!.status).toBe(400);
   432→      expect((responseRef.current!.data as any).error).toBe('Default project no longer valid. Specify X-Kspec-Dir header.');
   433→    });
   434→  });
   435→
   436→  describe('Permission handling', () => {
   437→    // AC: @multi-directory-daemon ac-8b
   438→    it('should return 403 for permission denied errors', async () => {
   439→      // Skip on Windows (chmod behavior differs)
   440→      if (process.platform === 'win32') {
   441→        return;
   442→      }
   443→
   444→      const manager = new ProjectContextManager();
   445→      const middleware = createPathValidationMiddleware(manager);
   446→
   447→      // Make .kspec/ unreadable
   448→      const kspecDir = join(projectA, '.kspec');
   449→      chmodSync(kspecDir, 0o000);
   450→
   451→      try {
   452→        const { ctx, responseRef } = createMockContext({ 'X-Kspec-Dir': projectA });
   453→        await middleware(ctx, async () => {});
   454→
   455→        expect(responseRef.current).toBeTruthy();
   456→        expect(responseRef.current!.status).toBe(403);
   457→        expect((responseRef.current!.data as any).error).toContain('Permission denied');
   458→        expect((responseRef.current!.data as any).error).toContain(projectA);
   459→      } finally {
   460→        // Restore permissions for cleanup
   461→        chmodSync(kspecDir, 0o755);
   462→      }
   463→    });
   464→  });
   465→
   466→  describe('Middleware integration', () => {
   467→    it('should call next() when validation succeeds', async () => {
   468→      const manager = new ProjectContextManager();
   469→      const middleware = createPathValidationMiddleware(manager);
   470→      const { ctx } = createMockContext({ 'X-Kspec-Dir': projectA });
   471→
   472→      let nextCalled = false;
   473→      await middleware(ctx, async () => {
   474→        nextCalled = true;
   475→      });
   476→
   477→      expect(nextCalled).toBe(true);
   478→    });
   479→
   480→    it('should not call next() when validation fails', async () => {
   481→      const manager = new ProjectContextManager();
   482→      const middleware = createPathValidationMiddleware(manager);
   483→      const { ctx } = createMockContext({ 'X-Kspec-Dir': './relative' });
   484→
   485→      let nextCalled = false;
   486→      await middleware(ctx, async () => {
   487→        nextCalled = true;
   488→      });
   489→
   490→      expect(nextCalled).toBe(false);
   491→    });
   492→
   493→    it('should attach projectContext to context state', async () => {
   494→      const manager = new ProjectContextManager();
   495→      const middleware = createPathValidationMiddleware(manager);
   496→      const { ctx, state } = createMockContext({ 'X-Kspec-Dir': projectA });
   497→
   498→      await middleware(ctx, async () => {});
   499→
   500→      expect(state).toHaveProperty('projectContext');
   501→      expect((state.projectContext as ProjectContext).path).toBe(projectA);
   502→    });
   503→  });
   504→});
