### 8. DATA FETCHING PATTERNS

**Common Pattern Across All Pages:**

```typescript
// State
let items = $state<Type[]>([]);
let loading = $state(true);
let error = $state('');

// Lifecycle - Load on mount
onMount(async () => {
	await loadData();
	
	// Subscribe to WebSocket updates (not in static mode)
	if (!isStaticMode()) {
		subscribe(['event:type']);
		on('event:type', handleUpdate);
	}
});

// Cleanup - Unsubscribe on destroy
onDestroy(() => {
	if (!isStaticMode()) {
		off('event:type', handleUpdate);
		unsubscribe(['event:type']);
	}
});

// Reload on project change
$effect(() => {
	const version = getProjectVersion();
	if (version > 0) {
		loadData();
	}
});

// Load function
async function loadData() {
	try {
		loading = true;
		error = '';
		const response = await fetchItems();
		items = response.items;
	} catch (err) {
		error = err instanceof Error ? err.message : 'Failed to load items';
	} finally {
		loading = false;
	}
}

// WebSocket update handler
function handleUpdate() {
	loadData();
}
```

**Reactive States (Svelte 5 $derived):**
```typescript
let filteredItems = $derived.by(() => {
	return items.filter(item => item.status === filterStatus);
});

let statusCounts = $derived.by(() => {
	const counts: Record<string, number> = {};
	for (const item of items) {
		counts[item.status] = (counts[item.status] ?? 0) + 1;
	}
	return counts;
});
```

