	draft: 'bg-status-pending text-status-pending-fg',
	approved: 'bg-status-pending-review text-status-pending-review-fg',
	active: 'bg-status-in-progress text-status-in-progress-fg',
	completed: 'bg-status-completed text-status-completed-fg',
	rejected: 'bg-status-blocked text-status-blocked-fg'
};

// Task statuses (from dashboard)
const statusConfig = [
	{ key: 'ready', label: 'Ready', dotClass: 'bg-status-pending', filterStatus: 'pending' },
	{ key: 'in_progress', label: 'In Progress', dotClass: 'bg-status-in-progress', filterStatus: 'in_progress' },
	{ key: 'needs_work', label: 'Needs Work', dotClass: 'bg-status-needs-work', filterStatus: 'needs_work' },
	{ key: 'pending_review', label: 'Review', dotClass: 'bg-status-pending-review', filterStatus: 'pending_review' },
	{ key: 'blocked', label: 'Blocked', dotClass: 'bg-status-blocked', filterStatus: 'blocked' },
	{ key: 'completed', label: 'Completed', dotClass: 'bg-status-completed', filterStatus: 'completed' },
	{ key: 'cancelled', label: 'Cancelled', dotClass: 'bg-status-cancelled', filterStatus: 'cancelled' }
];
```

