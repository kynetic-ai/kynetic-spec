   803→// ============================================================
   804→// Session API Functions
   805→// AC: @ui-session-stream ac-1, ac-2, ac-4
   806→// ============================================================
   807→
   808→/**
   809→ * Session summary from the daemon API.
   810→ */
   811→export interface SessionSummary {
   812→	id: string;
   813→	status: 'active' | 'completed' | 'abandoned' | 'timed_out' | 'failed';
   814→	agent_type: string;
   815→	session_type: 'loop' | 'invocation';
   816→	/** Dispatch trigger for distinguishing dispatched agent vs manual CLI run. */
   817→	trigger?: string;
   818→	/** Task ID being worked on (if any). AC: @ui-session-history ac-1 */
   819→	task_id?: string;
   820→	started_at: string;
   821→	ended_at?: string;
   822→	duration_ms: number;
   823→	event_count: number;
   824→	iteration_count: number;
   825→	tasks_completed: number;
   826→}
   827→
   828→/**
   829→ * Spec context with acceptance criteria checklist.
   830→ * AC: @ui-session-stream ac-4
   831→ */
   832→export interface SessionSpecContext {
   833→	spec_ref: string;
   834→	title: string;
   835→	acceptance_criteria: Array<{ id: string; description: string }>;
   836→}
   837→
   838→/**
   839→ * Session budget info.
   840→ * AC: @ui-session-stream ac-4
   841→ */
   842→export interface SessionBudget {
   843→	max_per_cycle: number;
   844→	started_this_cycle: number;
   845→}
   846→
   847→/**
   848→ * Session detail with additional metadata.
   849→ * AC: @ui-session-stream ac-4
   850→ */
   851→export interface SessionDetail extends SessionSummary {
   852→	task_id?: string;
   853→	agent_id?: string;
   854→	trigger?: string;
   855→	spec_context?: SessionSpecContext | null;
   856→	budget?: SessionBudget | null;
   857→}
   858→
   859→/**
   860→ * A single event from events.jsonl.
   861→ */
   862→export interface SessionEvent {
   863→	ts: number;
   864→	seq: number;
   865→	type: string;
   866→	session_id: string;
   867→	trace_id?: string;
   868→	data: unknown;
   869→}
   870→
   871→/**
   872→ * Fetch all sessions with summaries.
   873→ * AC: @ui-session-stream ac-1
   874→ */
   875→export async function fetchSessions(): Promise<{ items: SessionSummary[]; total: number }> {
   876→	if (isStaticMode()) {
   877→		return { items: [], total: 0 };
   878→	}
   879→
   880→	const response = await fetch(`${API_BASE}/api/sessions`, {
   881→		headers: getProjectHeaders()
   882→	});
   883→	if (!response.ok) {
   884→		await handleResponseError(response);
   885→	}
   886→
   887→	return response.json();
   888→}
   889→
   890→/**
   891→ * Fetch a single session by ID.
   892→ * AC: @ui-session-stream ac-4
   893→ */
   894→export async function fetchSession(id: string): Promise<SessionDetail> {
   895→	if (isStaticMode()) {
   896→		throw new Error('Session data not available in static mode');
   897→	}
   898→
   899→	const response = await fetch(`${API_BASE}/api/sessions/${id}`, {
   900→		headers: getProjectHeaders()
   901→	});
   902→	if (!response.ok) {
   903→		await handleResponseError(response);
   904→	}
   905→
   906→	return response.json();
   907→}
   908→
   909→/**
   910→ * Fetch session events (optionally incremental via since_seq).
   911→ * AC: @ui-session-stream ac-1, ac-2
   912→ */
   913→export async function fetchSessionEvents(
   914→	id: string,
   915→	sinceSeq?: number
   916→): Promise<{ events: SessionEvent[]; total: number }> {
   917→	if (isStaticMode()) {
   918→		return { events: [], total: 0 };
   919→	}
   920→
   921→	const url = new URL(`${API_BASE}/api/sessions/${id}/events`);
   922→	if (sinceSeq !== undefined) {
   923→		url.searchParams.set('since_seq', String(sinceSeq));
   924→	}
   925→
   926→	const response = await fetch(url.toString(), {
   927→		headers: getProjectHeaders()
   928→	});
   929→	if (!response.ok) {
   930→		await handleResponseError(response);
   931→	}
   932→
   933→	return response.json();
   934→}
