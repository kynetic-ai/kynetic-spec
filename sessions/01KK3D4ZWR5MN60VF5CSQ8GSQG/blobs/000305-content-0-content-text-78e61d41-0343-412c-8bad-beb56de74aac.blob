   390→ * AC: @gh-pages-export ac-17, ac-18 - Disabled in static mode
   391→ */
   392→export async function addInboxItem(text: string, tags?: string[]): Promise<InboxItem> {
   393→	// AC: @gh-pages-export ac-17, ac-18 - Write operations throw in static mode
   394→	assertWritable('add inbox item');
