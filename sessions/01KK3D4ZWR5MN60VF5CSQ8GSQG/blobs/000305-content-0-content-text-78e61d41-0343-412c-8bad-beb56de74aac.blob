   614→// ============================================================
   615→// Agent & Dispatch API Functions
   616→// AC: @ui-agent-dispatch ac-1, ac-2, ac-3
   617→// ============================================================
   618→
   619→/**
   620→ * Agent definition from GET /api/meta/agents
   621→ */
   622→export interface AgentDefinition {
   623→	_ulid: string;
   624→	id: string;
   625→	name: string;
   626→	description?: string;
   627→	adapter?: string;
   628→	dispatch: Array<{
   629→		on: string;
   630→		filter?: {
   631→			automation?: string;
   632→			tags?: string[];
   633→			priority?: number;
   634→		};
   635→	}>;
   636→	capabilities: string[];
   637→	tools: string[];
   638→	skills: string[];
   639→	budget?: {
   640→		max_tasks?: number;
   641→		timeout_minutes?: number;
   642→	};
   643→	concurrency: {
   644→		max_concurrent: number;
   645→	};
   646→	auto_approve: boolean;
   647→}
   648→
   649→/**
   650→ * Active invocation from GET /api/agent/status
   651→ */
   652→export interface ActiveInvocation {
   653→	session_id: string;
   654→	agent_id: string;
   655→	task_ref: string | null;
   656→	elapsed_ms: number;
   657→}
   658→
   659→/**
   660→ * Agent dispatch status from GET /api/agent/status
   661→ */
   662→export interface AgentDispatchStatus {
   663→	dispatch_enabled: boolean;
