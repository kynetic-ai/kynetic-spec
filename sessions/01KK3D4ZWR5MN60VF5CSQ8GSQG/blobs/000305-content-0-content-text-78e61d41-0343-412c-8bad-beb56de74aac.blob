   443→		}
   444→		return session;
   445→	}
   446→
   447→	const response = await fetch(`${API_BASE}/api/meta/session`, {
   448→		headers: getProjectHeaders()
   449→	});
   450→	if (!response.ok) {
   451→		await handleResponseError(response);
