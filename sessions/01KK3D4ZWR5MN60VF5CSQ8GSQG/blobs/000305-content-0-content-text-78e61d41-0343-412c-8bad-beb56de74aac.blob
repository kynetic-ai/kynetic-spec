```
     1→/**
     2→ * API Client
     3→ *
     4→ * Helper functions for making requests to the kspec daemon API.
     5→ * Supports both daemon mode (live) and static mode (read-only JSON).
     6→ *
     7→ * AC Coverage:
     8→ * - ac-26 (@multi-directory-daemon): X-Kspec-Dir header injection
     9→ * - ac-36 (@multi-directory-daemon): Invalid project error detection
    10→ * - ac-11 (@gh-pages-export): Mode-aware API dispatch
    11→ * - ac-18 (@gh-pages-export): Graceful no-op for write operations
    12→ */
    13→
    14→import type {
    15→	TaskSummary,
    16→	TaskDetail,
    17→	ItemSummary,
    18→	ItemDetail,
    19→	InboxItem,
    20→	SessionContext,
    21→	Observation,
    22→	Workflow,
    23→	PaginatedResponse,
    24→	PlanSummary,
    25→	ErrorResponse,
    26→	SearchResponse
    27→} from '@kynetic-ai/shared';
    28→import type { TriageRecord } from './types/triage';
    29→import {
    30→	getSelectedProjectPath,
    31→	clearInvalidSelection,
    32→	isInvalidProjectError,
    33→	type Project
    34→} from './stores/project.svelte';
    35→import { isStaticMode, assertWritable } from './stores/mode.svelte';
    36→import {
    37→	fetchTasksStatic,
    38→	fetchTaskStatic,
    39→	fetchItemsStatic,
    40→	fetchItemStatic,
    41→	fetchItemTasksStatic,
    42→	fetchInboxStatic,
    43→	fetchSessionContextStatic,
    44→	fetchObservationsStatic,
    45→	searchStatic,
    46→	fetchTriageRecordsStatic,
    47→	fetchPlansStatic,
    48→	fetchWorkflowsStatic
    49→} from './api-static';
    50→import { DAEMON_API_BASE } from './constants';
    51→
    52→const API_BASE = DAEMON_API_BASE;
    53→
    54→/**
    55→ * Get headers for API requests, including X-Kspec-Dir if project is selected
    56→ * AC: @multi-directory-daemon ac-26
    57→ */
    58→function getProjectHeaders(): HeadersInit {
    59→	const path = getSelectedProjectPath();
    60→	return path ? { 'X-Kspec-Dir': path } : {};
    61→}
    62→
    63→/**
    64→ * Handle response errors, detecting invalid project errors
    65→ * AC: @multi-directory-daemon ac-36
    66→ */
    67→async function handleResponseError(response: Response): Promise<never> {
    68→	const error: ErrorResponse = await response.json();
    69→	const message = error.message || error.error;
    70→
    71→	// Check if this is an invalid project error
    72→	if (isInvalidProjectError(response, message)) {
    73→		clearInvalidSelection();
    74→	}
    75→
    76→	throw new Error(message);
    77→}
    78→
    79→/**
    80→ * Fetch registered projects
    81→ * AC: @multi-directory-daemon ac-25, ac-28
    82→ */
    83→export async function fetchProjects(): Promise<{ projects: Project[] }> {
    84→	const response = await fetch(`${API_BASE}/api/projects`);
    85→	if (!response.ok) {
    86→		await handleResponseError(response);
    87→	}
    88→	return response.json();
    89→}
    90→
    91→/**
    92→ * Fetch tasks with optional filters
    93→ * AC: @web-dashboard ac-9, ac-10
    94→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
    95→ * AC: @gh-pages-export ac-11 - Static mode support
    96→ */
    97→export async function fetchTasks(params?: {
    98→	status?: string;
    99→	type?: string;
   100→	tag?: string;
   101→	assignee?: string;
   102→	automation?: string;
   103→	plan?: string;
   104→	limit?: number;
   105→	offset?: number;
   106→}): Promise<PaginatedResponse<TaskSummary>> {
   107→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   108→	if (isStaticMode()) {
   109→		return fetchTasksStatic(params);
   110→	}
   111→
   112→	const url = new URL(`${API_BASE}/api/tasks`);
   113→
   114→	if (params) {
   115→		Object.entries(params).forEach(([key, value]) => {
   116→			if (value !== undefined && value !== '') {
   117→				url.searchParams.set(key, String(value));
   118→			}
   119→		});
   120→	}
   121→
   122→	const response = await fetch(url.toString(), {
   123→		headers: getProjectHeaders()
   124→	});
   125→	if (!response.ok) {
   126→		await handleResponseError(response);
   127→	}
   128→
   129→	return response.json();
   130→}
   131→
   132→/**
   133→ * Fetch single task by reference
   134→ * AC: @web-dashboard ac-5
   135→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   136→ * AC: @gh-pages-export ac-12 - Static mode deep linking
   137→ */
   138→export async function fetchTask(ref: string): Promise<TaskDetail> {
   139→	// AC: @gh-pages-export ac-12 - Use static data in static mode
   140→	if (isStaticMode()) {
   141→		const task = fetchTaskStatic(ref);
   142→		if (!task) {
   143→			throw new Error(`Task not found: ${ref}`);
   144→		}
   145→		return task;
   146→	}
   147→
   148→	const response = await fetch(`${API_BASE}/api/tasks/${ref}`, {
   149→		headers: getProjectHeaders()
   150→	});
   151→	if (!response.ok) {
   152→		await handleResponseError(response);
   153→	}
   154→
   155→	return response.json();
   156→}
   157→
   158→/**
   159→ * Start a task (change status to in_progress)
   160→ * AC: @web-dashboard ac-7
   161→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   162→ * AC: @gh-pages-export ac-16, ac-18 - Disabled in static mode
   163→ */
   164→export async function startTask(ref: string): Promise<void> {
   165→	// AC: @gh-pages-export ac-16, ac-18 - Write operations throw in static mode
   166→	assertWritable('start task');
   167→
   168→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/start`, {
   169→		method: 'POST',
   170→		headers: getProjectHeaders()
   171→	});
   172→	if (!response.ok) {
   173→		await handleResponseError(response);
   174→	}
   175→}
   176→
   177→/**
   178→ * Add a note to a task
   179→ * AC: @web-dashboard ac-8
   180→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   181→ * AC: @gh-pages-export ac-18 - Disabled in static mode
   182→ */
   183→export async function addTaskNote(ref: string, content: string): Promise<void> {
   184→	// AC: @gh-pages-export ac-18 - Write operations throw in static mode
   185→	assertWritable('add note');
   186→
   187→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/note`, {
   188→		method: 'POST',
   189→		headers: {
   190→			'Content-Type': 'application/json',
   191→			...getProjectHeaders()
   192→		},
   193→		body: JSON.stringify({ content })
   194→	});
   195→	if (!response.ok) {
   196→		await handleResponseError(response);
   197→	}
   198→}
