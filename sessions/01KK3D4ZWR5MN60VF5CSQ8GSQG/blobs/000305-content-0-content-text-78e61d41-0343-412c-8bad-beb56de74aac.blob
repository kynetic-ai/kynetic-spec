   261→/**
   262→ * Fetch spec items with optional filters
   263→ * AC: @web-dashboard ac-11
   264→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   265→ * AC: @gh-pages-export ac-11 - Static mode support
   266→ */
   267→export async function fetchItems(params?: {
   268→	type?: string | string[];
   269→	tag?: string;
   270→	plan?: string;
   271→	limit?: number;
   272→	offset?: number;
   273→}): Promise<PaginatedResponse<ItemSummary>> {
   274→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   275→	if (isStaticMode()) {
   276→		return fetchItemsStatic(params);
   277→	}
   278→
   279→	const url = new URL(`${API_BASE}/api/items`);
   280→
   281→	if (params) {
   282→		Object.entries(params).forEach(([key, value]) => {
   283→			if (value !== undefined && value !== '') {
   284→				if (Array.isArray(value)) {
   285→					value.forEach((v) => url.searchParams.append(key, String(v)));
   286→				} else {
   287→					url.searchParams.set(key, String(value));
   288→				}
   289→			}
   290→		});
   291→	}
   292→
   293→	const response = await fetch(url.toString(), {
   294→		headers: getProjectHeaders()
   295→	});
   296→	if (!response.ok) {
   297→		await handleResponseError(response);
   298→	}
   299→
   300→	return response.json();
   301→}
