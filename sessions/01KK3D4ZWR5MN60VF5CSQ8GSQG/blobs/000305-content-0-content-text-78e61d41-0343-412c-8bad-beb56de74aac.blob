   492→/**
   493→ * Search across all entities
   494→ * AC: @web-dashboard ac-24
   495→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   496→ * AC: @gh-pages-export ac-11 - Static mode support
   497→ */
   498→export async function search(query: string): Promise<SearchResponse> {
   499→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   500→	if (isStaticMode()) {
   501→		return searchStatic(query);
   502→	}
   503→
   504→	const url = new URL(`${API_BASE}/api/search`);
   505→	url.searchParams.set('q', query);
   506→
   507→	const response = await fetch(url.toString(), {
   508→		headers: getProjectHeaders()
   509→	});
   510→	if (!response.ok) {
   511→		await handleResponseError(response);
   512→	}
   513→
   514→	return response.json();
   515→}
