   702→/**
   703→ * Start or stop the dispatch engine
   704→ * AC: @ui-agent-dispatch ac-2
   705→ */
   706→export async function controlDispatch(action: 'start' | 'stop'): Promise<{ dispatch_enabled: boolean }> {
   707→	assertWritable('control dispatch');
   708→
   709→	const response = await fetch(`${API_BASE}/api/agent/dispatch`, {
   710→		method: 'POST',
   711→		headers: {
   712→			'Content-Type': 'application/json',
   713→			...getProjectHeaders()
   714→		},
   715→		body: JSON.stringify({ action })
   716→	});
   717→	if (!response.ok) {
   718→		await handleResponseError(response);
   719→	}
   720→	return response.json();
   721→}
