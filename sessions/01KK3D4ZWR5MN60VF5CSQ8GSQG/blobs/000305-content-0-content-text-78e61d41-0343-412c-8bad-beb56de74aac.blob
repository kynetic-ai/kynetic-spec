   437→export async function fetchSessionContext(): Promise<SessionContext> {
   438→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   439→	if (isStaticMode()) {
   440→		const session = fetchSessionContextStatic();
   441→		if (!session) {
