   747→
   748→/**
   749→ * Fetch plans with optional status filter
   750→ * AC: @ui-plans-view ac-1
   751→ */
   752→export async function fetchPlans(params?: {
   753→	status?: string;
   754→}): Promise<{ items: PlanSummary[]; total: number }> {
   755→	if (isStaticMode()) {
   756→		return fetchPlansStatic(params);
   757→	}
   758→
   759→	const url = new URL(`${API_BASE}/api/plans`);
   760→
   761→	if (params) {
   762→		Object.entries(params).forEach(([key, value]) => {
   763→			if (value !== undefined && value !== '') {
   764→				url.searchParams.set(key, String(value));
   765→			}
   766→		});
   767→	}
   768→
   769→	const response = await fetch(url.toString(), {
   770→		headers: getProjectHeaders()
   771→	});
   772→	if (!response.ok) {
   773→		await handleResponseError(response);
   774→	}
   775→
   776→	return response.json();
   777→}
