   936→// ============================================================
   937→// Validation & Alignment API Functions
   938→// AC: @ui-validation-view ac-1
   939→// ============================================================
   940→
   941→export interface SchemaValidationError {
   942→	file: string;
   943→	path?: string;
   944→	message: string;
   945→	details?: unknown;
   946→}
   947→
   948→export interface RefValidationError {
   949→	ref: string;
   950→	sourceFile?: string;
   951→	sourceUlid?: string;
   952→	field: string;
   953→	error: 'not_found' | 'ambiguous' | 'duplicate_slug';
   954→	message: string;
   955→}
   956→
   957→export interface RefValidationWarning {
   958→	ref: string;
   959→	sourceFile?: string;
   960→	sourceUlid?: string;
   961→	field: string;
   962→	warning: 'deprecated_target';
   963→	message: string;
   964→}
   965→
   966→export interface OrphanItem {
   967→	ulid: string;
   968→	title: string;
   969→	type: string;
   970→	file?: string;
   971→}
   972→
   973→export type CompletenessWarningType =
   974→	| 'missing_acceptance_criteria'
   975→	| 'missing_description'
   976→	| 'status_inconsistency'
   977→	| 'missing_test_coverage'
   978→	| 'automation_eligible_no_spec'
   979→	| 'ac_schema_field_mismatch';
   980→
   981→export interface CompletenessWarning {
   982→	type: CompletenessWarningType;
   983→	subtype?: 'own_ac' | 'trait_ac';
   984→	itemRef: string;
   985→	itemTitle: string;
   986→	message: string;
   987→	details?: string;
   988→}
   989→
   990→export interface TraitCycleError {
   991→	traitRef: string;
   992→	traitTitle: string;
   993→	cycle: string[];
   994→	message: string;
   995→}
   996→
   997→export interface ValidationResponse {
   998→	valid: boolean;
   999→	schemaErrors: SchemaValidationError[];
  1000→	refErrors: RefValidationError[];
  1001→	refWarnings: RefValidationWarning[];
  1002→	orphans: OrphanItem[];
  1003→	completenessWarnings: CompletenessWarning[];
  1004→	traitCycles: TraitCycleError[];
  1005→}
  1006→
  1007→/** Alias for backward compatibility with dashboard overview */
  1008→export type ValidationResult = ValidationResponse;
  1009→
  1010→export interface AlignmentWarning {
  1011→	type: 'orphaned_spec' | 'status_mismatch' | 'stale_implementation';
  1012→	specUlid?: string;
  1013→	specTitle?: string;
  1014→	taskUlid?: string;
  1015→	message: string;
  1016→}
  1017→
  1018→export interface AlignmentStats {
  1019→	totalSpecs: number;
  1020→	specsWithTasks: number;
  1021→	alignedSpecs: number;
  1022→	orphanedSpecs: number;
  1023→}
  1024→
  1025→export interface AlignmentResponse {
  1026→	stats: AlignmentStats;
  1027→	warnings: AlignmentWarning[];
  1028→}
  1029→
  1030→/**
  1031→ * Fetch validation results
  1032→ * AC: @ui-validation-view ac-1
  1033→ */
  1034→export async function fetchValidation(): Promise<ValidationResponse> {
  1035→	if (isStaticMode()) {
  1036→		return {
  1037→			valid: true,
  1038→			schemaErrors: [],
  1039→			refErrors: [],
  1040→			refWarnings: [],
  1041→			orphans: [],
  1042→			completenessWarnings: [],
  1043→			traitCycles: []
  1044→		};
  1045→	}
  1046→
  1047→	const response = await fetch(`${API_BASE}/api/validate`, {
  1048→		headers: getProjectHeaders()
  1049→	});
  1050→	if (!response.ok) {
  1051→		await handleResponseError(response);
  1052→	}
  1053→
  1054→	return response.json();
  1055→}
  1056→
  1057→/**
  1058→ * Fetch alignment stats and warnings
  1059→ * AC: @ui-validation-view ac-1
  1060→ */
  1061→export async function fetchAlignment(): Promise<AlignmentResponse> {
  1062→	if (isStaticMode()) {
  1063→		return {
  1064→			stats: { totalSpecs: 0, specsWithTasks: 0, alignedSpecs: 0, orphanedSpecs: 0 },
  1065→			warnings: []
  1066→		};
  1067→	}
  1068→
  1069→	const response = await fetch(`${API_BASE}/api/alignment`, {
  1070→		headers: getProjectHeaders()
  1071→	});
  1072→	if (!response.ok) {
  1073→		await handleResponseError(response);
  1074→	}
  1075→
  1076→	return response.json();
  1077→}
