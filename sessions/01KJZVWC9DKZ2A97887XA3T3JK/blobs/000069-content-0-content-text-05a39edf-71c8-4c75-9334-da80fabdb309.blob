```
     1→/**
     2→ * Kspec Daemon Server
     3→ *
     4→ * Elysia.js HTTP server with WebSocket support for real-time kspec state updates.
     5→ * Implements localhost-only security, file watching, and graceful shutdown.
     6→ */
     7→
     8→import { Elysia } from 'elysia';
     9→import { cors } from '@elysiajs/cors';
    10→import { staticPlugin } from '@elysiajs/static';
    11→import { ulid } from 'ulidx';
    12→import { existsSync } from 'fs';
    13→import { fileURLToPath } from 'url';
    14→import { dirname } from 'path';
    15→import { PubSubManager } from './websocket/pubsub';
    16→import { HeartbeatManager } from './websocket/heartbeat';
    17→import { WebSocketHandler } from './websocket/handler';
    18→import { handleWebSocketClose } from './websocket/lifecycle';
    19→import type { ConnectionData, ConnectedEvent } from './websocket/types';
    20→import { PidFileManager } from './pid';
    21→import { projectContextMiddleware } from './middleware/project-context';
    22→import { createTasksRoutes } from './routes/tasks';
    23→import { createItemsRoutes } from './routes/items';
    24→import { createInboxRoutes } from './routes/inbox';
    25→import { createMetaRoutes } from './routes/meta';
    26→import { createValidationRoutes } from './routes/validation';
    27→import { createProjectsRoutes } from './routes/projects';
    28→import { createTriageRoutes } from './routes/triage';
    29→import { createAgentDispatchRoutes, getDispatchEngine, stopAllEngines } from './routes/agent-dispatch';
    30→import { createSessionRoutes } from './routes/sessions';
    31→import { join } from 'path';
    32→
    33→export interface ServerOptions {
    34→  port: number;
    35→  isDaemon: boolean;
    36→  kspecDir?: string; // Path to .kspec directory (default: .kspec in cwd)
    37→  webUiDir?: string; // Path to web UI build directory (default: auto-detect)
    38→}
    39→
    40→/**
    41→ * Resolves the path to the web UI build directory.
    42→ * Tries multiple locations in order:
    43→ * 1. Explicit webUiDir option
    44→ * 2. WEB_UI_DIR environment variable
    45→ * 3. packages/web-ui/build in current working directory (monorepo dev)
    46→ * 4. web-ui/build in current working directory
    47→ * 5. Bundled dist/web-ui/ relative to this module (npm package installs)
    48→ *
    49→ * Exported for testing only.
    50→ */
    51→export function resolveWebUiPath(webUiDir?: string): string | null {
    52→  // 1. Explicit option
    53→  if (webUiDir && existsSync(webUiDir)) {
    54→    return webUiDir;
    55→  }
    56→
    57→  // 2. Environment variable
    58→  const envPath = process.env.WEB_UI_DIR;
    59→  if (envPath && existsSync(envPath)) {
    60→    return envPath;
    61→  }
    62→
    63→  // 3. Monorepo development: packages/web-ui/build from cwd
    64→  // The daemon is spawned with cwd set to project root
    65→  const monorepoPath = join(process.cwd(), 'packages', 'web-ui', 'build');
    66→  if (existsSync(monorepoPath)) {
    67→    return monorepoPath;
    68→  }
    69→
    70→  // 4. Alternate location: web-ui/build in cwd
    71→  const altPath = join(process.cwd(), 'web-ui', 'build');
    72→  if (existsSync(altPath)) {
    73→    return altPath;
    74→  }
    75→
    76→  // 5. Bundled assets: dist/web-ui/ relative to daemon module location
    77→  // Covers npm package installs where no local web UI build exists.
    78→  // import.meta.url resolves to dist/daemon/server.js → sibling is dist/web-ui/
    79→  const selfDir = dirname(fileURLToPath(import.meta.url));
    80→  const bundledPath = join(selfDir, '..', 'web-ui');
    81→  if (existsSync(bundledPath)) {
    82→    return bundledPath;
    83→  }
    84→
    85→  return null;
    86→}
    87→
    88→// WebSocket pub/sub and heartbeat managers
    89→let pubsubManager: PubSubManager;
    90→let heartbeatManager: HeartbeatManager;
    91→let wsHandler: WebSocketHandler;
    92→let projectManager: import('./project-context').ProjectContextManager | undefined;
    93→
    94→/**
    95→ * Middleware to enforce localhost-only connections.
    96→ * AC-3: Reject non-localhost connections with 403 Forbidden
    97→ */
    98→function localhostOnly() {
    99→  return (context: { request: Request }) => {
   100→    const host = context.request.headers.get('host');
   101→    if (!host) {
   102→      return new Response(JSON.stringify({
   103→        error: 'Forbidden',
   104→        message: 'This server only accepts connections from localhost'
   105→      }), {
   106→        status: 403,
   107→        headers: { 'Content-Type': 'application/json' }
   108→      });
   109→    }
   110→
   111→    // Extract hostname, handling IPv6 brackets
   112→    let hostname: string;
   113→    if (host.startsWith('[')) {
   114→      // IPv6 with brackets: [::1]:3456 -> ::1
   115→      const closeBracket = host.indexOf(']');
   116→      hostname = closeBracket > 0 ? host.substring(1, closeBracket) : host;
   117→    } else {
   118→      // IPv4 or hostname: localhost:3456 -> localhost
   119→      hostname = host.split(':')[0];
   120→    }
   121→
   122→    // Allow localhost, 127.0.0.1, and ::1
   123→    const isLocalhost =
   124→      hostname === 'localhost' ||
   125→      hostname === '127.0.0.1' ||
   126→      hostname === '::1';
   127→
   128→    if (!isLocalhost) {
   129→      return new Response(JSON.stringify({
   130→        error: 'Forbidden',
   131→        message: 'This server only accepts connections from localhost'
   132→      }), {
   133→        status: 403,
   134→        headers: { 'Content-Type': 'application/json' }
   135→      });
   136→    }
   137→  };
   138→}
   139→
   140→/**
   141→ * Creates and configures the Elysia server instance.
   142→ *
   143→ * AC Coverage:
   144→ * - ac-1: Server starts on configurable port (default 3456)
   145→ * - ac-2: Binds to localhost only (127.0.0.1 and ::1)
   146→ * - ac-3: Rejects non-localhost connections with 403
   147→ * - ac-15: Uses plugin pattern for middleware
   148→ */
   149→export async function createServer(options: ServerOptions) {
   150→  const { port, isDaemon, kspecDir = join(process.cwd(), '.kspec'), webUiDir } = options;
   151→
   152→  // Determine startup project path (project root, not .kspec/)
   153→  // AC: @multi-directory-daemon ac-2 - daemon uses startup directory as default project
   154→  const startupProjectPath = kspecDir.endsWith('.kspec')
   155→    ? kspecDir.slice(0, -('.kspec'.length + 1)) // Remove '/.kspec'
   156→    : kspecDir;
   157→
   158→  // Import ProjectContextManager (needed for WebSocket binding)
   159→  const { ProjectContextManager } = await import('./project-context');
   160→
   161→  // AC: @daemon-server ac-17 - Resolve web UI path for static file serving
   162→  const resolvedWebUiPath = resolveWebUiPath(webUiDir);
   163→  if (resolvedWebUiPath) {
   164→    console.log(`[daemon] Web UI assets found at: ${resolvedWebUiPath}`);
   165→  } else {
   166→    console.log('[daemon] Web UI assets not found - UI will not be served');
   167→    console.log('[daemon] Build the web UI with: cd packages/web-ui && npm run build');
   168→  }
   169→
   170→  // Initialize PID file manager (uses global ~/.config/kspec/)
   171→  const pidManager = new PidFileManager();
   172→
   173→  // AC: @multi-directory-daemon ac-9 - Write PID and port files in daemon mode
   174→  if (isDaemon) {
   175→    pidManager.writePid();
   176→    pidManager.writePort(port);
   177→    console.log(`[daemon] PID file written: ${process.pid}`);
   178→    console.log(`[daemon] Port file written: ${port}`);
   179→  }
   180→
   181→  // Initialize WebSocket managers
   182→  pubsubManager = new PubSubManager();
   183→  heartbeatManager = new HeartbeatManager();
   184→  wsHandler = new WebSocketHandler(pubsubManager);
   185→
   186→  // WeakMap to store project path during WebSocket upgrade (keyed by Request object)
   187→  // Using WeakMap avoids needing to pass a requestId through beforeHandle return value,
   188→  // which breaks WebSocket upgrade in Elysia 1.4 when derive middleware is present.
   189→  const wsProjectPaths = new WeakMap<Request, string>();
   190→
   191→  const app = new Elysia()
   192→    // AC-15: Plugin pattern for middleware
   193→    // AC: @api-contract ac-1 - Allow CORS from dev server on localhost:5173
   194→    .use(cors({
   195→      origin: ['http://localhost:5173', 'http://127.0.0.1:5173'], // Dev server origins
   196→      credentials: true,
   197→      methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS']
   198→    }))
   199→
   200→    // AC-3: Enforce localhost-only connections
   201→    .onRequest(localhostOnly());
   202→
   203→  // AC: @multi-directory-daemon ac-1, ac-2, ac-3 - Project context middleware
   204→  const { manager: projectContextManager, middleware: projectMiddleware } = projectContextMiddleware({
   205→    startupProject: startupProjectPath,
   206→    pubsub: pubsubManager
   207→  });
   208→
   209→  // Store manager globally for shutdown
   210→  projectManager = projectContextManager;
   211→
   212→  app.use(projectMiddleware)
   213→
   214→    // AC-11: Health check endpoint
   215→    .get('/api/health', () => ({
   216→      status: 'ok',
   217→      uptime: process.uptime(),
   218→      connections: pubsubManager.getConnectionCount(),
   219→      version: '0.1.0'
   220→    }))
   221→
   222→    // AC: @api-contract ac-2 through ac-7 - Task API endpoints
   223→    // AC: @multi-directory-daemon ac-24 - Routes use projectContext from middleware
   224→    .use(createTasksRoutes({ pubsub: pubsubManager }))
   225→
   226→    // AC: @api-contract ac-8 through ac-11 - Spec Item API endpoints
   227→    .use(createItemsRoutes())
   228→
   229→    // AC: @api-contract ac-12 through ac-14 - Inbox API endpoints
   230→    .use(createInboxRoutes({ pubsub: pubsubManager }))
   231→
   232→    // AC: @api-contract ac-15 through ac-18 - Meta API endpoints
   233→    .use(createMetaRoutes())
   234→
   235→    // AC: @triage-daemon-api ac-1 through ac-9 - Triage API endpoints
   236→    .use(createTriageRoutes({ pubsub: pubsubManager }))
   237→
   238→    // AC: @api-contract ac-19 through ac-21 - Validation and search endpoints
   239→    .use(createValidationRoutes())
   240→
   241→    // AC: @multi-directory-daemon ac-28, ac-29, ac-30 - Projects management endpoints
   242→    .use(createProjectsRoutes({ projectManager: projectContextManager }))
   243→
   244→    // AC: @ui-session-stream ac-1, ac-4 - Session data endpoints
   245→    .use(createSessionRoutes())
   246→
   247→    // AC: @agent-dispatch-engine ac-4 - Agent dispatch API endpoints
   248→    // AC: @daemon-agent-dispatch ac-3, ac-4 - Pass pubsub for WebSocket broadcast on invocation events
   249→    .use(createAgentDispatchRoutes({ pubsub: pubsubManager }))
   250→
   251→    // AC-4: WebSocket endpoint for real-time updates
   252→    .ws<ConnectionData>('/ws', {
   253→      beforeHandle({ request, store }) {
   254→        // AC: @multi-directory-daemon ac-21, ac-22, ac-23, ac-34 - Extract and validate project binding
   255→        // AC: @multi-directory-daemon ac-34 - Browser WebSocket API doesn't support custom headers,
   256→        // so we also accept project path as query parameter
   257→        const url = new URL(request.url, `http://${request.headers.get('host')}`);
   258→        const projectPath = request.headers.get('X-Kspec-Dir')
   259→                        || url.searchParams.get('project')
   260→                        || undefined;
   261→
   262→        // IMPORTANT: Do NOT return a value from ws beforeHandle.
   263→        // In Elysia 1.4 with derive middleware, returning a value short-circuits
   264→        // the WebSocket upgrade and sends the value as an HTTP 200 response.
   265→        // Use a WeakMap keyed by Request object to pass data to open().
   266→        try {
   267→          const manager = (store as Record<string, unknown>).projectManager as import('./project-context').ProjectContextManager | undefined;
   268→          if (!manager) {
   269→            // Fallback: project manager not initialized yet
   270→            wsProjectPaths.set(request, startupProjectPath);
   271→            return;
   272→          }
   273→
   274→          let projectContext;
   275→          if (projectPath) {
   276→            // Explicit project specified
   277→            try {
   278→              projectContext = manager.getProject(projectPath);
   279→            } catch {
   280→              // AC: @multi-directory-daemon ac-4 - auto-register
   281→              projectContext = manager.registerProject(projectPath);
   282→            }
   283→          } else {
   284→            // AC: @multi-directory-daemon ac-22, ac-23 - Use default or reject
   285→            try {
   286→              projectContext = manager.getProject();
   287→            } catch (err: unknown) {
   288→              // AC: @multi-directory-daemon ac-23 - Reject when no default
   289→              if (err instanceof Error && err.message.includes('No default project configured')) {
   290→                throw new Error('No project specified');
   291→              }
   292→              throw err;
   293→            }
   294→          }
   295→
   296→          // Store resolved path for open() handler via WeakMap
   297→          wsProjectPaths.set(request, projectContext.path);
   298→        } catch (err: unknown) {
   299→          console.error(`[daemon] WebSocket connection rejected: ${err instanceof Error ? err.message : String(err)}`);
   300→          throw err;
   301→        }
   302→      },
   303→      open(ws) {
   304→        // AC: @api-contract ac-25, @trait-websocket-protocol ac-1
   305→        const sessionId = ulid();
   306→        const openContext = ws.data as { id?: unknown; request?: unknown } | undefined;
   307→        const contextId = typeof openContext?.id === 'string' ? openContext.id : undefined;
   308→
   309→        // AC: @multi-directory-daemon ac-21 - Get bound project path
   310→        // Retrieve project path from WeakMap via the request object on ws.data
   311→        const request = openContext?.request as Request | undefined;
   312→        const projectPath = request ? wsProjectPaths.get(request) || startupProjectPath : startupProjectPath;
   313→
   314→        ws.data = {
   315→          sessionId,
   316→          topics: new Set<string>(),
   317→          seq: 0,
   318→          lastPing: undefined,
   319→          lastPong: Date.now(),
   320→          projectPath // AC: @multi-directory-daemon ac-21 - immutable binding
   321→        };
   322→
   323→        pubsubManager.addConnection(sessionId, ws, contextId);
   324→        console.log(`[daemon] WebSocket client connected: ${sessionId} bound to ${projectPath} (${pubsubManager.getConnectionCount()} total)`);
   325→
   326→        // Send connected event with session_id
   327→        const connectedEvent: ConnectedEvent = {
   328→          event: 'connected',
   329→          data: {
   330→            session_id: sessionId
   331→          }
   332→        };
   333→        ws.send(JSON.stringify(connectedEvent));
   334→      },
   335→      message(ws, message) {
   336→        // AC: @api-contract ac-26, ac-27
   337→        wsHandler.handleMessage(ws, message);
   338→      },
   339→      pong(ws) {
   340→        // AC: @trait-websocket-protocol ac-5
   341→        heartbeatManager.recordPong(ws);
   342→      },
   343→      close(ws, code, reason) {
   344→        handleWebSocketClose(pubsubManager, ws, code, reason);
   345→      }
   346→    });
   347→
   348→  // AC: @daemon-server ac-17 - Serve web UI static assets
   349→  // Added after API routes so API routes take precedence
   350→  if (resolvedWebUiPath) {
   351→    const indexHtmlPath = join(resolvedWebUiPath, 'index.html');
   352→
   353→    // Serve static files from web UI build directory
   354→    app.use(await staticPlugin({
   355→      assets: resolvedWebUiPath,
   356→      prefix: '/',
   357→      noCache: process.env.NODE_ENV === 'development', // Disable cache in dev
   358→    }));
   359→
   360→    // SPA fallback routes for client-side routing
   361→    // These catch paths like /tasks, /items, /inbox that don't have static files
   362→    const spaRoutes = ['/tasks', '/tasks/*', '/items', '/items/*', '/inbox', '/observations', '/triage'];
   363→    for (const route of spaRoutes) {
   364→      app.get(route, () => Bun.file(indexHtmlPath));
   365→    }
   366→
   367→    console.log('[daemon] Web UI static file serving enabled');
   368→  }
   369→
   370→  // AC-1, AC-2: Start server on localhost only
   371→  // Using 'localhost' hostname allows Bun/OS to bind to both 127.0.0.1 and ::1
   372→  app.listen({
   373→    port,
   374→    hostname: 'localhost', // Resolves to both IPv4 and IPv6 loopback
   375→  });
   376→
   377→  console.log(`[daemon] Server listening on http://localhost:${port} (IPv4: 127.0.0.1, IPv6: ::1)`);
   378→  console.log(`[daemon] WebSocket available at ws://localhost:${port}/ws`);
   379→
   380→  // AC: @agent-dispatch-engine ac-5 - Wire file change callback to dispatch engine
   381→  projectContextManager.setFileChangeCallback((projectPath, file) => {
   382→    // Only forward changes to project.tasks.yaml
   383→    if (!file.endsWith('project.tasks.yaml')) return;
   384→    const engine = getDispatchEngine(projectPath);
   385→    if (engine) {
   386→      engine.handleFileChange(projectPath).catch((err) => {
   387→        console.error('[dispatch] Error handling file change:', err);
   388→      });
   389→    }
   390→  });
   391→
   392→  // AC: @multi-directory-daemon ac-17 - Start file watcher for startup project
   393→  if (startupProjectPath) {
   394→    try {
   395→      await projectContextManager.startWatcher(startupProjectPath);
   396→      console.log(`[daemon] File watcher started for startup project: ${startupProjectPath}`);
   397→    } catch (error) {
   398→      console.error('[daemon] Failed to start file watcher for startup project:', error);
   399→    }
   400→  }
   401→
   402→  // AC: @daemon-server ac-13, ac-14 - Start heartbeat monitoring
   403→  heartbeatManager.start(pubsubManager.getAllConnections());
   404→
   405→  // AC-12: Graceful shutdown on SIGTERM/SIGINT
   406→  const shutdown = async (signal: string) => {
   407→    console.log(`[daemon] Received ${signal}, shutting down gracefully...`);
   408→
   409→    try {
   410→      // Stop heartbeat monitoring
   411→      heartbeatManager.stop();
   412→
   413→      // AC: @agent-dispatch-engine ac-11 - Stop all dispatch engines before shutting down
   414→      await stopAllEngines();
   415→
   416→      // AC: @multi-directory-daemon ac-11b - Stop all file watchers
   417→      await projectContextManager.stopAllWatchers();
   418→      console.log('[daemon] All file watchers stopped');
   419→
   420→      // Close all WebSocket connections with code 1000 (clean close)
   421→      // AC: @trait-websocket-protocol ac-7
   422→      for (const [sessionId, ws] of pubsubManager.getAllConnections()) {
   423→        ws.close(1000, 'Server shutting down');
   424→      }
   425→
   426→      // Stop the server
   427→      await app.server?.stop();
   428→
   429→      // AC: @daemon-server ac-10 - Remove PID file on shutdown
   430→      if (isDaemon) {
   431→        pidManager.remove();
   432→        console.log('[daemon] PID file removed');
   433→      }
   434→
   435→      console.log('[daemon] Server stopped successfully');
   436→      process.exit(0);
   437→    } catch (error) {
   438→      console.error('[daemon] Error during shutdown:', error);
   439→      process.exit(1);
   440→    }
   441→  };
   442→
   443→  process.on('SIGTERM', () => shutdown('SIGTERM'));
   444→  process.on('SIGINT', () => shutdown('SIGINT'));
   445→
   446→  return app;
   447→}
   448→
```