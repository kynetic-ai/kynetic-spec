```
     1→/**
     2→ * Session stream utility functions.
     3→ *
     4→ * Parses raw session events from events.jsonl into structured display blocks.
     5→ *
     6→ * AC: @ui-session-stream ac-1 — Structured event blocks
     7→ */
     8→
     9→import type { SessionEvent } from '$lib/api';
    10→
    11→export type BlockType = 'message' | 'tool_call' | 'tool_result' | 'thinking' | 'system';
    12→
    13→export interface MessageBlock {
    14→	type: 'message';
    15→	content: string;
    16→	timestamp: number;
    17→	seq: number;
    18→}
    19→
    20→export interface ToolCallBlock {
    21→	type: 'tool_call';
    22→	toolName: string;
    23→	toolCallId: string;
    24→	input: unknown;
    25→	output?: unknown;
    26→	status: 'pending' | 'running' | 'completed' | 'failed';
    27→	startedAt: number;
    28→	completedAt?: number;
    29→	durationMs?: number;
    30→	seq: number;
    31→}
    32→
    33→export interface ThinkingBlock {
    34→	type: 'thinking';
    35→	content: string;
    36→	timestamp: number;
    37→	seq: number;
    38→}
    39→
    40→export interface SystemBlock {
    41→	type: 'system';
    42→	label: string;
    43→	detail?: string;
    44→	timestamp: number;
    45→	seq: number;
    46→}
    47→
    48→export type DisplayBlock = MessageBlock | ToolCallBlock | ThinkingBlock | SystemBlock;
    49→
    50→/**
    51→ * Tool name to icon mapping.
    52→ */
    53→const TOOL_ICONS: Record<string, string> = {
    54→	Read: '\u{1F4C4}',
    55→	Write: '\u{270F}\u{FE0F}',
    56→	Edit: '\u{270F}\u{FE0F}',
    57→	Bash: '$',
    58→	Grep: '\u{1F50D}',
    59→	Glob: '\u{1F4C1}',
    60→	WebFetch: '\u{1F310}',
    61→	WebSearch: '\u{1F310}',
    62→	Task: '\u{1F916}',
    63→	TodoWrite: '\u{2705}',
    64→	NotebookEdit: '\u{1F4D3}',
    65→};
    66→
    67→export function getToolIcon(toolName: string): string {
    68→	return TOOL_ICONS[toolName] ?? '\u{1F527}';
    69→}
    70→
    71→/**
    72→ * Extract a short preview of tool input for collapsed display.
    73→ */
    74→export function getToolInputPreview(toolName: string, input: unknown): string {
    75→	if (!input || typeof input !== 'object') return '';
    76→	const obj = input as Record<string, unknown>;
    77→
    78→	if (obj.command && typeof obj.command === 'string') {
    79→		return truncate(obj.command, 80);
    80→	}
    81→	if (obj.file_path && typeof obj.file_path === 'string') {
    82→		return String(obj.file_path);
    83→	}
    84→	if (obj.pattern && typeof obj.pattern === 'string') {
    85→		return `pattern: ${truncate(String(obj.pattern), 60)}`;
    86→	}
    87→	if (obj.query && typeof obj.query === 'string') {
    88→		return truncate(String(obj.query), 80);
    89→	}
    90→	if (obj.content && typeof obj.content === 'string') {
    91→		return truncate(String(obj.content), 80);
    92→	}
    93→
    94→	const keys = Object.keys(obj);
    95→	if (keys.length <= 3) return keys.join(', ');
    96→	return `${keys.length} params`;
    97→}
    98→
    99→function truncate(str: string, max: number): string {
   100→	if (str.length <= max) return str;
   101→	return str.slice(0, max) + '\u2026';
   102→}
   103→
   104→/**
   105→ * Extract text content from an ACP SessionUpdate.
   106→ *
   107→ * ACP ContentChunk format: { content: { type: 'text', text: '...' } }
   108→ * Legacy format: { text: '...' } or { content: '...' }
   109→ */
   110→function extractTextContent(update: Record<string, unknown>): string {
   111→	// ACP ContentChunk: content is an object with type + text
   112→	const content = update.content;
   113→	if (content && typeof content === 'object') {
   114→		const block = content as Record<string, unknown>;
   115→		if (block.type === 'text' && typeof block.text === 'string') {
   116→			return block.text;
   117→		}
   118→	}
   119→	// Legacy: flat text or string content field
   120→	if (typeof update.text === 'string') return update.text;
   121→	if (typeof content === 'string') return content;
   122→	return '';
   123→}
   124→
   125→/**
   126→ * Parse raw session events into structured display blocks.
   127→ *
   128→ * Supports both ACP format (data IS the SessionUpdate directly) and
   129→ * legacy format (data wraps the update at data.update).
   130→ *
   131→ * AC: @ui-session-stream ac-1
   132→ */
   133→export function parseEventsToBlocks(events: SessionEvent[]): DisplayBlock[] {
   134→	const blocks: DisplayBlock[] = [];
   135→	const toolCalls = new Map<string, ToolCallBlock>();
   136→
   137→	for (const event of events) {
   138→		const data = event.data as Record<string, unknown> | null;
   139→		if (!data) continue;
   140→
   141→		switch (event.type) {
   142→			case 'session.start': {
   143→				blocks.push({
   144→					type: 'system',
   145→					label: 'Session started',
   146→					detail: data.agent_type ? `Agent: ${data.agent_type}` : undefined,
   147→					timestamp: event.ts,
   148→					seq: event.seq,
   149→				});
   150→				break;
   151→			}
   152→
   153→			case 'session.end':
   154→			case 'session.wrapup': {
   155→				blocks.push({
   156→					type: 'system',
   157→					label: event.type === 'session.end' ? 'Session ended' : 'Session wrapping up',
   158→					detail: data.reason ? String(data.reason) : undefined,
   159→					timestamp: event.ts,
   160→					seq: event.seq,
   161→				});
   162→				break;
   163→			}
   164→
   165→			case 'session.update': {
   166→				// ACP format: data IS the SessionUpdate (data.sessionUpdate exists)
   167→				// Legacy format: data wraps the update (data.update.sessionUpdate)
   168→				const update = (
   169→					data.sessionUpdate
   170→						? data
   171→						: (data.update as Record<string, unknown> | undefined)
   172→				) as Record<string, unknown> | undefined;
   173→				if (!update) break;
   174→
   175→				const sessionUpdate = update.sessionUpdate as string | undefined;
   176→
   177→				if (
   178→					sessionUpdate === 'agent_message_chunk' ||
   179→					sessionUpdate === 'assistant_text' ||
   180→					sessionUpdate === 'assistant'
   181→				) {
   182→					const content = extractTextContent(update);
   183→					if (content) {
   184→						// Merge consecutive message blocks
   185→						const lastBlock = blocks[blocks.length - 1];
   186→						if (lastBlock?.type === 'message') {
   187→							lastBlock.content += content;
   188→						} else {
   189→							blocks.push({
   190→								type: 'message',
   191→								content,
   192→								timestamp: event.ts,
   193→								seq: event.seq,
   194→							});
   195→						}
   196→					}
   197→				} else if (
   198→					sessionUpdate === 'agent_thought_chunk' ||
   199→					sessionUpdate === 'thinking' ||
   200→					sessionUpdate === 'assistant_thinking'
   201→				) {
   202→					const content = extractTextContent(update);
   203→					if (content) {
   204→						const lastBlock = blocks[blocks.length - 1];
   205→						if (lastBlock?.type === 'thinking') {
   206→							lastBlock.content += content;
   207→						} else {
   208→							blocks.push({
   209→								type: 'thinking',
   210→								content,
   211→								timestamp: event.ts,
   212→								seq: event.seq,
   213→							});
   214→						}
   215→					}
   216→				} else if (sessionUpdate === 'tool_call') {
   217→					const toolCallId = (update.toolCallId ?? update.tool_call_id ?? update.id ?? '') as string;
   218→					const toolName = (update.title ?? update.tool ?? update.toolName ?? update.name ?? 'unknown') as string;
   219→					const rawInput = update.rawInput ?? update.input;
   220→
   221→					const block: ToolCallBlock = {
   222→						type: 'tool_call',
   223→						toolName,
   224→						toolCallId,
   225→						input: rawInput,
   226→						status: 'running',
   227→						startedAt: event.ts,
   228→						seq: event.seq,
   229→					};
   230→
   231→					toolCalls.set(toolCallId, block);
   232→					blocks.push(block);
   233→				} else if (sessionUpdate === 'tool_call_update' || sessionUpdate === 'tool_result') {
   234→					const toolCallId = (update.toolCallId ?? update.tool_call_id ?? update.id ?? '') as string;
   235→					const existing = toolCalls.get(toolCallId);
   236→
   237→					if (existing) {
   238→						// ACP tool_call_update uses status + rawOutput; legacy uses output/error flags
   239→						const acpStatus = update.status as string | undefined;
   240→						const output = update.rawOutput ?? update.output ?? update.content;
   241→						if (output !== undefined) {
   242→							existing.output = output;
   243→						}
   244→						if (acpStatus === 'completed' || acpStatus === 'failed') {
   245→							existing.status = acpStatus;
   246→							existing.completedAt = event.ts;
   247→							existing.durationMs = event.ts - existing.startedAt;
   248→						} else if (update.error || update.isError) {
   249→							existing.status = 'failed';
   250→							existing.completedAt = event.ts;
   251→							existing.durationMs = event.ts - existing.startedAt;
   252→						} else if (sessionUpdate === 'tool_result') {
   253→							existing.status = 'completed';
   254→							existing.completedAt = event.ts;
   255→							existing.durationMs = event.ts - existing.startedAt;
   256→						}
   257→						// Update rawInput if provided (ACP phased tool calls)
   258→						if (update.rawInput !== undefined) {
   259→							existing.input = update.rawInput;
   260→						}
   261→					}
   262→				}
   263→				break;
   264→			}
   265→
   266→			case 'tool.call': {
   267→				const toolName = (data.tool ?? data.name ?? 'unknown') as string;
   268→				const toolCallId = (data.toolCallId ?? data.tool_call_id ?? data.id ?? `tool-${event.seq}`) as string;
   269→
   270→				const block: ToolCallBlock = {
   271→					type: 'tool_call',
   272→					toolName,
   273→					toolCallId,
   274→					input: data.input ?? data.rawInput ?? data.args,
   275→					status: 'running',
   276→					startedAt: event.ts,
   277→					seq: event.seq,
   278→				};
   279→
   280→				toolCalls.set(toolCallId, block);
   281→				blocks.push(block);
   282→				break;
   283→			}
   284→
   285→			case 'tool.result': {
   286→				const toolCallId = (data.toolCallId ?? data.tool_call_id ?? data.id ?? '') as string;
   287→				const existing = toolCalls.get(toolCallId);
   288→
   289→				if (existing) {
   290→					existing.output = data.output ?? data.rawOutput ?? data.content;
   291→					existing.status = (data.error || data.isError) ? 'failed' : 'completed';
   292→					existing.completedAt = event.ts;
   293→					existing.durationMs = event.ts - existing.startedAt;
   294→				}
   295→				break;
   296→			}
   297→
   298→			case 'note': {
   299→				blocks.push({
   300→					type: 'system',
   301→					label: 'Note',
   302→					detail: typeof data.message === 'string' ? data.message : JSON.stringify(data),
   303→					timestamp: event.ts,
   304→					seq: event.seq,
   305→				});
   306→				break;
   307→			}
   308→
   309→			case 'agent.dispatched':
   310→			case 'agent.started':
   311→			case 'agent.completed':
   312→			case 'agent.failed':
   313→			case 'agent.timeout': {
   314→				const labelMap: Record<string, string> = {
   315→					'agent.dispatched': 'Agent dispatched',
   316→					'agent.started': 'Agent started',
   317→					'agent.completed': 'Agent completed',
   318→					'agent.failed': 'Agent failed',
   319→					'agent.timeout': 'Agent timed out',
   320→				};
   321→				blocks.push({
   322→					type: 'system',
   323→					label: labelMap[event.type] ?? event.type,
   324→					detail: data.task_ref ? `Task: ${data.task_ref}` : undefined,
   325→					timestamp: event.ts,
   326→					seq: event.seq,
   327→				});
   328→				break;
   329→			}
   330→
   331→			case 'prompt.sent': {
   332→				const phase = data.phase as string | undefined;
   333→				const iteration = data.iteration as number | undefined;
   334→				if (phase) {
   335→					blocks.push({
   336→						type: 'system',
   337→						label: `Iteration ${iteration ?? '?'}`,
   338→						detail: `Phase: ${phase}`,
   339→						timestamp: event.ts,
   340→						seq: event.seq,
   341→					});
   342→				}
   343→				break;
   344→			}
   345→
   346→			case 'iteration.timeout': {
   347→				blocks.push({
   348→					type: 'system',
   349→					label: 'Iteration timeout',
   350→					timestamp: event.ts,
   351→					seq: event.seq,
   352→				});
   353→				break;
   354→			}
   355→		}
   356→	}
   357→
   358→	return blocks;
   359→}
   360→
   361→/**
   362→ * Format a duration in milliseconds to a human-readable string.
   363→ */
   364→export function formatDuration(ms: number): string {
   365→	if (ms < 1000) return `${ms}ms`;
   366→	const secs = Math.floor(ms / 1000);
   367→	const mins = Math.floor(secs / 60);
   368→	const hours = Math.floor(mins / 60);
   369→	if (hours > 0) return `${hours}h ${mins % 60}m`;
   370→	if (mins > 0) return `${mins}m ${secs % 60}s`;
   371→	return `${secs}s`;
   372→}
   373→
   374→/**
   375→ * Format a timestamp to a time string.
   376→ */
   377→export function formatTime(ts: number): string {
   378→	const d = new Date(ts);
   379→	return d.toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
   380→}
   381→
   382→/**
   383→ * Format elapsed milliseconds to human-readable string (e.g. "2h 5m", "30s").
   384→ */
   385→export function formatElapsed(ms: number): string {
   386→	const secs = Math.floor(ms / 1000);
   387→	const mins = Math.floor(secs / 60);
   388→	const hours = Math.floor(mins / 60);
   389→
   390→	if (hours > 0) return `${hours}h ${mins % 60}m`;
   391→	if (mins > 0) return `${mins}m ${secs % 60}s`;
   392→	return `${secs}s`;
   393→}
   394→
   395→/**
   396→ * Format a relative age string from a date (e.g. "5m", "2h", "3d").
   397→ */
   398→export function formatAge(dateStr: string): string {
   399→	const now = Date.now();
   400→	const then = new Date(dateStr).getTime();
   401→	const diffMs = now - then;
   402→	const diffMins = Math.floor(diffMs / 60000);
   403→	const diffHours = Math.floor(diffMins / 60);
   404→	const diffDays = Math.floor(diffHours / 24);
   405→
   406→	if (diffMins < 1) return 'just now';
   407→	if (diffMins < 60) return `${diffMins}m`;
   408→	if (diffHours < 24) return `${diffHours}h`;
   409→	if (diffDays < 30) return `${diffDays}d`;
   410→	return `${Math.floor(diffDays / 30)}mo`;
   411→}
   412→
   413→/**
   414→ * Format a timestamp for timeline display showing absolute time.
   415→ * Shows "HH:MM:SS" for today, "MMM D, HH:MM:SS" for other days.
   416→ */
   417→export function formatTimeline(dateStr: string): string {
   418→	const d = new Date(dateStr);
   419→	const now = new Date();
   420→	const time = d.toLocaleTimeString('en-US', { hour12: true, hour: 'numeric', minute: '2-digit', second: '2-digit' });
   421→
   422→	const isToday =
   423→		d.getFullYear() === now.getFullYear() &&
   424→		d.getMonth() === now.getMonth() &&
   425→		d.getDate() === now.getDate();
   426→
   427→	if (isToday) return time;
   428→
   429→	const month = d.toLocaleString('en-US', { month: 'short' });
   430→	const day = d.getDate();
   431→	return `${month} ${day}, ${time}`;
   432→}
   433→
   434→/**
   435→ * Extract unique file paths that were changed during a session.
   436→ * Looks at Write, Edit, and NotebookEdit tool calls.
   437→ *
   438→ * AC: @ui-session-stream ac-4 — Files changed during session.
   439→ */
   440→/**
   441→ * Compute the distance from the bottom of a scroll container.
   442→ * Used by SessionStream.svelte for auto-scroll detection.
   443→ *
   444→ * AC: @ui-session-stream ac-3
   445→ */
   446→export function computeScrollDistance(scrollHeight: number, scrollTop: number, clientHeight: number): number {
   447→	return scrollHeight - scrollTop - clientHeight;
   448→}
   449→
   450→/**
   451→ * Determine whether auto-scroll should be active based on scroll position.
   452→ * Returns true when the user is within the threshold of the bottom.
   453→ *
   454→ * AC: @ui-session-stream ac-3
   455→ */
   456→export const AUTO_SCROLL_THRESHOLD = 100;
   457→
   458→export function shouldAutoScroll(scrollHeight: number, scrollTop: number, clientHeight: number): boolean {
   459→	return computeScrollDistance(scrollHeight, scrollTop, clientHeight) <= AUTO_SCROLL_THRESHOLD;
   460→}
   461→
   462→/**
   463→ * Determine whether the "jump to bottom" button should be visible.
   464→ * Shown when not auto-scrolling AND there is content to jump to.
   465→ *
   466→ * AC: @ui-session-stream ac-3
   467→ */
   468→export function shouldShowJumpButton(autoScrolling: boolean, isLive: boolean, blockCount: number): boolean {
   469→	return !autoScrolling && (isLive || blockCount > 0);
   470→}
   471→
   472→/**
   473→ * Accumulate streaming text from agent_text_chunk WebSocket events.
   474→ * Only accumulates for the target session. Returns updated streaming text.
   475→ *
   476→ * AC: @ui-session-stream ac-2
   477→ */
   478→export function accumulateStreamingText(
   479→	currentText: string,
   480→	event: { event: string; data: unknown },
   481→	targetSessionId: string,
   482→): string {
   483→	if (event.event !== 'agent_text_chunk') return currentText;
   484→	const data = event.data as { session_id?: string; text?: string } | null;
   485→	if (!data || data.session_id !== targetSessionId || !data.text) return currentText;
   486→	return currentText + data.text;
   487→}
   488→
   489→/**
   490→ * Determine the last sequence number from an events array.
   491→ * Returns -1 if the array is empty.
   492→ *
   493→ * AC: @ui-session-stream ac-2
   494→ */
   495→export function getLastSeq(events: Array<{ seq: number }>): number {
   496→	if (events.length === 0) return -1;
   497→	return events[events.length - 1].seq;
   498→}
   499→
   500→const WRITE_TOOLS = new Set(['Write', 'Edit', 'NotebookEdit']);
   501→
   502→export function extractFilesChanged(blocks: DisplayBlock[]): string[] {
   503→	const files = new Set<string>();
   504→	for (const block of blocks) {
   505→		if (block.type !== 'tool_call') continue;
   506→		if (!WRITE_TOOLS.has(block.toolName)) continue;
   507→		const input = block.input as Record<string, unknown> | null;
   508→		if (!input) continue;
   509→		const filePath = (input.file_path ?? input.notebook_path) as string | undefined;
   510→		if (filePath) files.add(filePath);
   511→	}
   512→	return [...files].sort();
   513→}
   514→
```