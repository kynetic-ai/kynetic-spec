   279→			// Needs-attention blocked count only includes status=blocked tasks.
   280→			// Pending tasks with unmet deps are excluded — they resolve naturally
   281→			// when predecessor tasks complete, and don't require user intervention.
   282→			blockedTasks = newCounts.blocked;
   283→
   284→			// Inbox count
   285→			inboxUntriaged = inboxResponse.total;
   286→
   287→			// Observations: unresolved count
   288→			observationsUnresolved = obsResponse.total;
   289→
   290→			// Validation warnings
   291→			if (validationResult) {
   292→				validationWarnings =
   293→					validationResult.refWarnings.length +
   294→					validationResult.completenessWarnings.length +
   295→					validationResult.schemaErrors.length +
   296→					validationResult.refErrors.length;
   297→			}
   298→
   299→			// Agent status
   300→			if (agentStatusResult) {
   301→				agentStatus = agentStatusResult;
   302→			}
   303→		} catch (err) {
   304→			error = err instanceof Error ? err.message : 'Failed to load dashboard data';
   305→			console.error('Dashboard load error:', err);
   306→		} finally {
   307→			loading = false;
   308→		}
   309→	}
