    33→	// --- State ---
    34→	let loading = $state(true);
    35→	let error = $state<string | null>(null);
    36→
    37→	// Task counts
    38→	interface TaskCounts {
    39→		ready: number;
    40→		in_progress: number;
    41→		needs_work: number;
    42→		pending_review: number;
    43→		needs_work: number;
    44→		blocked: number;
    45→		completed: number;
    46→		cancelled: number;
    47→	}
    48→
    49→	let counts = $state<TaskCounts>({
    50→		ready: 0,
    51→		in_progress: 0,
    52→		needs_work: 0,
    53→		pending_review: 0,
    54→		needs_work: 0,
    55→		blocked: 0,
    56→		completed: 0,
    57→		cancelled: 0
    58→	});
    59→
    60→	// Active work
    61→	let agentStatus = $state<AgentDispatchStatus | null>(null);
    62→	let taskTitles = $state<Record<string, string>>({});
    63→
    64→	let hasActiveWork = $derived(
    65→		agentStatus?.dispatch_enabled && (agentStatus?.active_invocations?.length ?? 0) > 0
    66→	);
