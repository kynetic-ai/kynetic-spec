   161→	// --- Elapsed time formatting ---
   162→	function formatElapsed(ms: number): string {
   163→		const secs = Math.floor(ms / 1000);
   164→		const mins = Math.floor(secs / 60);
   165→		const hours = Math.floor(mins / 60);
   166→		if (hours > 0) return `${hours}h ${mins % 60}m`;
   167→		if (mins > 0) return `${mins}m ${secs % 60}s`;
   168→		return `${secs}s`;
   169→	}
   170→
   171→	// --- Data loading ---
   172→	async function loadDashboard() {
   173→		loading = true;
   174→		error = null;
   175→
   176→		try {
   177→			const [tasksResponse, inboxResponse, obsResponse, validationResult, agentStatusResult] =
   178→				await Promise.all([
   179→					fetchTasks({ limit: 1000 }),
   180→					fetchInbox({ limit: 0 }),
   181→					fetchObservations({ resolved: false }),
   182→					fetchValidation().catch(() => null),
   183→					isStaticMode()
   184→						? Promise.resolve(null)
   185→						: fetchAgentStatus().catch(() => null)
   186→				]);
   187→
   188→			// Compute task counts
   189→			const tasks = tasksResponse.items;
   190→			const newCounts: TaskCounts = {
   191→				ready: 0,
   192→				in_progress: 0,
   193→				needs_work: 0,
   194→				pending_review: 0,
   195→				needs_work: 0,
   196→				blocked: 0,
   197→				completed: 0,
   198→				cancelled: 0
   199→			};
   200→
   201→			const completedRefs = new Set(
   202→				tasks
   203→					.filter((t) => t.status === 'completed')
   204→					.flatMap((t) => [t._ulid, ...(t.slugs || [])])
   205→			);
   206→
   207→			const titles: Record<string, string> = {};
   208→
   209→			for (const task of tasks) {
