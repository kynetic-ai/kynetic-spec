   262→							const ref = dep.startsWith('@') ? dep.slice(1) : dep;
   263→							return !completedRefs.has(ref);
   264→						});
   265→						if (hasUnmetDeps) {
   266→							// Pending tasks with unmet deps are not ready, but don't
   267→							// count as "blocked" (which is status=blocked only). They
   268→							// resolve naturally when predecessor tasks complete.
   269→						} else {
