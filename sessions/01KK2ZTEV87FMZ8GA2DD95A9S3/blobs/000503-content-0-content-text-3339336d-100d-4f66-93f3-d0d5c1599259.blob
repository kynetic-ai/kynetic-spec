```
     1→<!--
     2→  AC: @ui-dashboard-overview ac-1 — Dashboard home view
     3→  Active work section, status summary, needs-attention aggregation.
     4→-->
     5→<script lang="ts">
     6→	import { onMount, onDestroy } from 'svelte';
     7→	import { goto } from '$app/navigation';
     8→	import { base } from '$app/paths';
     9→	import {
    10→		fetchTasks,
    11→		fetchInbox,
    12→		fetchObservations,
    13→		fetchValidation,
    14→		fetchAgentStatus,
    15→		type AgentDispatchStatus,
    16→		type ActiveInvocation
    17→	} from '$lib/api';
    18→	import { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';
    19→	import { Badge } from '$lib/components/ui/badge';
    20→	import { Skeleton } from '$lib/components/ui/skeleton';
    21→	import { getProjectVersion } from '$lib/stores/project.svelte';
    22→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    23→	import { isStaticMode } from '$lib/stores/mode.svelte';
    24→	import AlertTriangle from '@lucide/svelte/icons/triangle-alert';
    25→	import InboxIcon from '@lucide/svelte/icons/inbox';
    26→	import Eye from '@lucide/svelte/icons/eye';
    27→	import ShieldAlert from '@lucide/svelte/icons/shield-alert';
    28→	import Ban from '@lucide/svelte/icons/ban';
    29→	import Activity from '@lucide/svelte/icons/activity';
    30→	import Bot from '@lucide/svelte/icons/bot';
    31→	import ExternalLink from '@lucide/svelte/icons/external-link';
    32→
    33→	// --- State ---
    34→	let loading = $state(true);
    35→	let error = $state<string | null>(null);
    36→
    37→	// Task counts
    38→	interface TaskCounts {
    39→		ready: number;
    40→		in_progress: number;
    41→		needs_work: number;
    42→		pending_review: number;
    43→		blocked: number;
    44→		completed: number;
    45→		cancelled: number;
    46→	}
    47→
    48→	let counts = $state<TaskCounts>({
    49→		ready: 0,
    50→		in_progress: 0,
    51→		needs_work: 0,
    52→		pending_review: 0,
    53→		blocked: 0,
    54→		completed: 0,
    55→		cancelled: 0
    56→	});
    57→
    58→	// Active work
    59→	let agentStatus = $state<AgentDispatchStatus | null>(null);
    60→	let taskTitles = $state<Record<string, string>>({});
    61→
    62→	let hasActiveWork = $derived(
    63→		agentStatus?.dispatch_enabled && (agentStatus?.active_invocations?.length ?? 0) > 0
    64→	);
    65→
    66→	// Needs attention
    67→	let inboxUntriaged = $state(0);
    68→	let observationsUnresolved = $state(0);
    69→	let validationWarnings = $state(0);
    70→	let blockedTasks = $state(0);
    71→
    72→	let totalAttention = $derived(
    73→		inboxUntriaged + observationsUnresolved + validationWarnings + blockedTasks
    74→	);
    75→
    76→	// --- Status config with design system tokens ---
    77→	// AC: @ui-dashboard-overview ac-1 — clickable count cards per status
    78→	const statusConfig = [
    79→		{
    80→			key: 'ready' as const,
    81→			label: 'Ready',
    82→			dotClass: 'bg-status-pending',
    83→			filterStatus: 'pending'
    84→		},
    85→		{
    86→			key: 'in_progress' as const,
    87→			label: 'In Progress',
    88→			dotClass: 'bg-status-in-progress',
    89→			filterStatus: 'in_progress'
    90→		},
    91→		{
    92→			key: 'needs_work' as const,
    93→			label: 'Needs Work',
    94→			dotClass: 'bg-status-needs-work',
    95→			filterStatus: 'needs_work'
    96→		},
    97→		{
    98→			key: 'pending_review' as const,
    99→			label: 'Review',
   100→			dotClass: 'bg-status-pending-review',
   101→			filterStatus: 'pending_review'
   102→		},
   103→		{
   104→			key: 'blocked' as const,
   105→			label: 'Blocked',
   106→			dotClass: 'bg-status-blocked',
   107→			filterStatus: 'blocked'
   108→		},
   109→		{
   110→			key: 'completed' as const,
   111→			label: 'Completed',
   112→			dotClass: 'bg-status-completed',
   113→			filterStatus: 'completed'
   114→		},
   115→		{
   116→			key: 'cancelled' as const,
   117→			label: 'Cancelled',
   118→			dotClass: 'bg-status-cancelled',
   119→			filterStatus: 'cancelled'
   120→		}
   121→	];
   122→
   123→	// --- Needs attention items config ---
   124→	const attentionItems = $derived([
   125→		{
   126→			key: 'inbox',
   127→			label: 'Untriaged inbox',
   128→			count: inboxUntriaged,
   129→			icon: InboxIcon,
   130→			href: `${base}/inbox`,
   131→			colorClass: 'text-status-pending-review'
   132→		},
   133→		{
   134→			key: 'observations',
   135→			label: 'Unresolved observations',
   136→			count: observationsUnresolved,
   137→			icon: Eye,
   138→			href: `${base}/observations`,
   139→			colorClass: 'text-status-in-progress'
   140→		},
   141→		{
   142→			key: 'validation',
   143→			label: 'Validation warnings',
   144→			count: validationWarnings,
   145→			icon: ShieldAlert,
   146→			href: `${base}/validate`,
   147→			colorClass: 'text-status-needs-work'
   148→		},
   149→		{
   150→			key: 'blocked',
   151→			label: 'Blocked tasks',
   152→			count: blockedTasks,
   153→			icon: Ban,
   154→			href: `${base}/tasks?status=blocked`,
   155→			colorClass: 'text-status-blocked'
   156→		}
   157→	]);
   158→
   159→	// --- Elapsed time formatting ---
   160→	function formatElapsed(ms: number): string {
   161→		const secs = Math.floor(ms / 1000);
   162→		const mins = Math.floor(secs / 60);
   163→		const hours = Math.floor(mins / 60);
   164→		if (hours > 0) return `${hours}h ${mins % 60}m`;
   165→		if (mins > 0) return `${mins}m ${secs % 60}s`;
   166→		return `${secs}s`;
   167→	}
   168→
   169→	// --- Data loading ---
   170→	async function loadDashboard() {
   171→		loading = true;
   172→		error = null;
   173→
   174→		try {
   175→			const [tasksResponse, inboxResponse, obsResponse, validationResult, agentStatusResult] =
   176→				await Promise.all([
   177→					fetchTasks({ limit: 1000 }),
   178→					fetchInbox({ limit: 0 }),
   179→					fetchObservations({ resolved: false }),
   180→					fetchValidation().catch(() => null),
   181→					isStaticMode()
   182→						? Promise.resolve(null)
   183→						: fetchAgentStatus().catch(() => null)
   184→				]);
   185→
   186→			// Compute task counts
   187→			const tasks = tasksResponse.items;
   188→			const newCounts: TaskCounts = {
   189→				ready: 0,
   190→				in_progress: 0,
   191→				needs_work: 0,
   192→				pending_review: 0,
   193→				blocked: 0,
   194→				completed: 0,
   195→				cancelled: 0
   196→			};
   197→
   198→			const completedRefs = new Set(
   199→				tasks
   200→					.filter((t) => t.status === 'completed')
   201→					.flatMap((t) => [t._ulid, ...(t.slugs || [])])
   202→			);
   203→
   204→			const titles: Record<string, string> = {};
   205→
   206→			for (const task of tasks) {
   207→				// Build task titles for active fleet
   208→				if (task.slugs?.length) {
   209→					for (const slug of task.slugs) {
   210→						titles[`@${slug}`] = task.title;
   211→					}
   212→				}
   213→				titles[`@${task._ulid}`] = task.title;
   214→
   215→				switch (task.status) {
   216→					case 'completed':
   217→						newCounts.completed++;
   218→						break;
   219→					case 'in_progress':
   220→						newCounts.in_progress++;
   221→						break;
   222→					case 'pending_review':
   223→						newCounts.pending_review++;
   224→						break;
   225→					case 'blocked':
   226→						newCounts.blocked++;
   227→						break;
   228→					case 'needs_work':
   229→						newCounts.needs_work++;
   230→						break;
   231→					case 'cancelled':
   232→						newCounts.cancelled++;
   233→						break;
   234→					case 'pending': {
   235→						const deps = task.depends_on || [];
   236→						const hasUnmetDeps = deps.some((dep: string) => {
   237→							const ref = dep.startsWith('@') ? dep.slice(1) : dep;
   238→							return !completedRefs.has(ref);
   239→						});
   240→						if (hasUnmetDeps) {
   241→							// Pending tasks with unmet deps are not ready, but don't
   242→							// count as "blocked" (which is status=blocked only). They
   243→							// resolve naturally when predecessor tasks complete.
   244→						} else {
   245→							newCounts.ready++;
   246→						}
   247→						break;
   248→					}
   249→				}
   250→			}
   251→
   252→			counts = newCounts;
   253→			taskTitles = titles;
   254→			// Needs-attention blocked count only includes status=blocked tasks.
   255→			// Pending tasks with unmet deps are excluded — they resolve naturally
   256→			// when predecessor tasks complete, and don't require user intervention.
   257→			blockedTasks = newCounts.blocked;
   258→
   259→			// Inbox count
   260→			inboxUntriaged = inboxResponse.total;
   261→
   262→			// Observations: unresolved count
   263→			observationsUnresolved = obsResponse.total;
   264→
   265→			// Validation warnings
   266→			if (validationResult) {
   267→				validationWarnings =
   268→					validationResult.refWarnings.length +
   269→					validationResult.completenessWarnings.length +
   270→					validationResult.schemaErrors.length +
   271→					validationResult.refErrors.length;
   272→			}
   273→
   274→			// Agent status
   275→			if (agentStatusResult) {
   276→				agentStatus = agentStatusResult;
   277→			}
   278→		} catch (err) {
   279→			error = err instanceof Error ? err.message : 'Failed to load dashboard data';
   280→			console.error('Dashboard load error:', err);
   281→		} finally {
   282→			loading = false;
   283→		}
   284→	}
   285→
   286→	function navigateToTasks(status: string) {
   287→		goto(`${base}/tasks?status=${status}`);
   288→	}
   289→
   290→	// --- WebSocket real-time updates ---
   291→	function handleTaskUpdate() {
   292→		loadDashboard();
   293→	}
   294→
   295→	function handleAgentEvent() {
   296→		fetchAgentStatus()
   297→			.then((s) => {
   298→				agentStatus = s;
   299→			})
   300→			.catch(() => {});
   301→	}
   302→
   303→	// --- Lifecycle ---
   304→	onMount(() => {
   305→		loadDashboard();
   306→
   307→		if (!isStaticMode()) {
   308→			subscribe(['tasks', 'agents']);
   309→			on('tasks', handleTaskUpdate);
   310→			on('agents', handleAgentEvent);
   311→		}
   312→	});
   313→
   314→	onDestroy(() => {
   315→		if (!isStaticMode()) {
   316→			off('tasks', handleTaskUpdate);
   317→			off('agents', handleAgentEvent);
   318→			unsubscribe(['tasks', 'agents']);
   319→		}
   320→	});
   321→
   322→	// Reload on project change
   323→	$effect(() => {
   324→		const version = getProjectVersion();
   325→		if (version > 0) {
   326→			loadDashboard();
   327→		}
   328→	});
   329→</script>
   330→
   331→<div class="flex flex-col gap-6 p-6" data-testid="dashboard">
   332→	<h1 class="text-2xl font-bold">Dashboard</h1>
   333→
   334→	{#if error}
   335→		<!-- Error state -->
   336→		<div
   337→			class="flex items-center gap-3 rounded-lg border border-destructive/50 bg-destructive/10 p-4"
   338→			role="alert"
   339→			data-testid="dashboard-error"
   340→		>
   341→			<AlertTriangle class="size-5 text-destructive" />
   342→			<div>
   343→				<p class="text-sm font-medium text-destructive">Failed to load dashboard</p>
   344→				<p class="text-xs text-muted-foreground">{error}</p>
   345→			</div>
   346→			<button
   347→				class="ml-auto text-xs text-muted-foreground underline hover:text-foreground"
   348→				onclick={loadDashboard}
   349→			>
   350→				Retry
   351→			</button>
   352→		</div>
   353→	{/if}
   354→
   355→	{#if loading}
   356→		<!-- Loading skeleton -->
   357→		<div data-testid="dashboard-skeleton">
   358→			<!-- Active work skeleton -->
   359→			<div class="mb-6">
   360→				<Skeleton class="mb-2 h-5 w-32 ds-shimmer" />
   361→				<div class="flex gap-3">
   362→					<Skeleton class="h-20 w-72 ds-shimmer" />
   363→				</div>
   364→			</div>
   365→
   366→			<!-- Status summary skeleton -->
   367→			<div class="mb-6">
   368→				<Skeleton class="mb-3 h-5 w-40 ds-shimmer" />
   369→				<div class="grid gap-4 md:grid-cols-4 lg:grid-cols-7">
   370→					{#each Array(7) as _}
   371→						<Skeleton class="h-24 ds-shimmer" />
   372→					{/each}
   373→				</div>
   374→			</div>
   375→
   376→			<!-- Needs attention skeleton -->
   377→			<div>
   378→				<Skeleton class="mb-3 h-5 w-40 ds-shimmer" />
   379→				<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
   380→					{#each Array(4) as _}
   381→						<Skeleton class="h-20 ds-shimmer" />
   382→					{/each}
   383→				</div>
   384→			</div>
   385→		</div>
   386→	{:else}
   387→		<!-- AC: @ui-dashboard-overview ac-1 — Active work section -->
   388→		<section data-testid="active-work-section">
   389→			{#if hasActiveWork}
   390→				<div class="mb-4">
   391→					<div class="flex items-center gap-2 mb-2">
   392→						<Activity class="size-4 text-status-in-progress" />
   393→						<h2 class="text-sm font-medium">Active Fleet</h2>
   394→						<Badge variant="secondary" class="text-[10px]">
   395→							{agentStatus?.active_invocations.length} running
   396→						</Badge>
   397→					</div>
   398→					<div class="flex gap-3 overflow-x-auto pb-2" data-testid="active-fleet-row">
   399→						{#each agentStatus?.active_invocations ?? [] as invocation (invocation.session_id)}
   400→							{@const title = invocation.task_ref ? taskTitles[invocation.task_ref] : undefined}
   401→							<div
   402→								class="flex-shrink-0 w-72 rounded-lg border bg-card p-3 ds-breathe"
   403→								data-testid="fleet-card"
   404→							>
   405→								<div class="flex items-center gap-2 mb-1.5">
   406→									<Bot class="size-4 text-muted-foreground" />
   407→									<span class="text-xs font-medium truncate">{invocation.agent_id}</span>
   408→								</div>
   409→
   410→								{#if invocation.task_ref}
   411→									{#if title}
   412→										<p class="text-xs text-foreground truncate mb-0.5">{title}</p>
   413→									{/if}
   414→									<p class="text-[10px] text-muted-foreground font-mono truncate mb-1">
   415→										{invocation.task_ref}
   416→									</p>
   417→								{/if}
   418→
   419→								<div class="flex items-center justify-between text-[10px] text-muted-foreground">
   420→									<div class="flex items-center gap-1.5">
   421→										<!-- Pulse indicator -->
   422→										<span class="relative flex size-2">
   423→											<span
   424→												class="absolute inline-flex h-full w-full rounded-full bg-status-in-progress opacity-75 ds-breathe"
   425→											></span>
   426→											<span
   427→												class="relative inline-flex size-2 rounded-full bg-status-in-progress"
   428→											></span>
   429→										</span>
   430→										<span>{formatElapsed(invocation.elapsed_ms)}</span>
   431→									</div>
   432→
   433→									<a
   434→										href="{base}/sessions/{invocation.session_id}"
   435→										class="inline-flex items-center gap-1 text-primary hover:underline"
   436→									>
   437→										Stream
   438→										<ExternalLink class="size-3" />
   439→									</a>
   440→								</div>
   441→							</div>
   442→						{/each}
   443→					</div>
   444→				</div>
   445→			{:else}
   446→				<div
   447→					class="flex items-center gap-2 rounded-lg border border-dashed p-4 text-sm text-muted-foreground"
   448→					data-testid="no-active-work"
   449→				>
   450→					<Activity class="size-4" />
   451→					<span>No agents currently running</span>
   452→				</div>
   453→			{/if}
   454→		</section>
   455→
   456→		<!-- AC: @ui-dashboard-overview ac-1 — Status summary with clickable count cards -->
   457→		<section data-testid="status-summary-section">
   458→			<h2 class="mb-3 text-sm font-medium text-muted-foreground">Status Summary</h2>
   459→			<div class="grid gap-3 md:grid-cols-4 lg:grid-cols-7" data-testid="dashboard-counts">
   460→				{#each statusConfig as status}
   461→					<button
   462→						class="text-left"
   463→						onclick={() => navigateToTasks(status.filterStatus)}
   464→						data-testid="task-count-{status.key}"
   465→					>
   466→						<Card class="transition-colors hover:bg-muted/50 cursor-pointer h-full">
   467→							<CardHeader
   468→								class="flex flex-row items-center justify-between pb-1 pt-3 px-3 space-y-0"
   469→							>
   470→								<CardTitle class="text-xs font-medium text-muted-foreground">
   471→									{status.label}
   472→								</CardTitle>
   473→								<span class="inline-block size-2.5 rounded-full {status.dotClass}"></span>
   474→							</CardHeader>
   475→							<CardContent class="px-3 pb-3">
   476→								<div class="text-2xl font-bold tabular-nums">
   477→									{counts[status.key]}
   478→								</div>
   479→							</CardContent>
   480→						</Card>
   481→					</button>
   482→				{/each}
   483→			</div>
   484→		</section>
   485→
   486→		<!-- AC: @ui-dashboard-overview ac-1 — Needs attention aggregation -->
   487→		<section data-testid="needs-attention-section">
   488→			<div class="mb-3 flex items-center gap-2">
   489→				<h2 class="text-sm font-medium text-muted-foreground">Needs Attention</h2>
   490→				{#if totalAttention > 0}
   491→					<Badge variant="secondary" class="text-[10px]">{totalAttention}</Badge>
   492→				{/if}
   493→			</div>
   494→
   495→			{#if totalAttention === 0}
   496→				<div
   497→					class="flex items-center gap-2 rounded-lg border border-dashed p-4 text-sm text-muted-foreground"
   498→					data-testid="no-attention-needed"
   499→				>
   500→					<span>Nothing needs attention right now</span>
   501→				</div>
   502→			{:else}
   503→				<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4" data-testid="attention-cards">
   504→					{#each attentionItems as item}
   505→						{#if item.count > 0}
   506→							<a href={item.href} class="block" data-testid="attention-{item.key}">
   507→								<Card class="transition-colors hover:bg-muted/50 cursor-pointer h-full">
   508→									<CardContent class="flex items-center gap-3 p-4">
   509→										<div class="rounded-md bg-muted p-2">
   510→											<item.icon class="size-4 {item.colorClass}" />
   511→										</div>
   512→										<div>
   513→											<p class="text-2xl font-bold tabular-nums">{item.count}</p>
   514→											<p class="text-xs text-muted-foreground">{item.label}</p>
   515→										</div>
   516→									</CardContent>
   517→								</Card>
   518→							</a>
   519→						{/if}
   520→					{/each}
   521→				</div>
   522→			{/if}
   523→		</section>
   524→	{/if}
   525→</div>
   526→
```