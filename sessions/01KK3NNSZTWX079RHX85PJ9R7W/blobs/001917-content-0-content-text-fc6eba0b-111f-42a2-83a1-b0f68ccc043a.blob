```
     1→<!--
     2→  AC: @ui-dashboard-overview ac-1 — Dashboard home view
     3→  Active work section, status summary, needs-attention aggregation.
     4→-->
     5→<script lang="ts">
     6→	import { onMount, onDestroy } from 'svelte';
     7→	import { goto } from '$app/navigation';
     8→	import { base } from '$app/paths';
     9→	import {
    10→		fetchTasks,
    11→		fetchInbox,
    12→		fetchObservations,
    13→		fetchValidation,
    14→		fetchAgentStatus,
    15→		type AgentDispatchStatus,
    16→		type ActiveInvocation
    17→	} from '$lib/api';
    18→	import { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';
    19→	import { Badge } from '$lib/components/ui/badge';
    20→	import { Skeleton } from '$lib/components/ui/skeleton';
    21→	import ReferenceLink from '$lib/components/ReferenceLink.svelte';
    22→	import { getProjectVersion } from '$lib/stores/project.svelte';
    23→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    24→	import { isStaticMode } from '$lib/stores/mode.svelte';
    25→	import AlertTriangle from '@lucide/svelte/icons/triangle-alert';
    26→	import InboxIcon from '@lucide/svelte/icons/inbox';
    27→	import Eye from '@lucide/svelte/icons/eye';
    28→	import ShieldAlert from '@lucide/svelte/icons/shield-alert';
    29→	import Ban from '@lucide/svelte/icons/ban';
    30→	import Activity from '@lucide/svelte/icons/activity';
    31→	import Bot from '@lucide/svelte/icons/bot';
    32→	import ExternalLink from '@lucide/svelte/icons/external-link';
    33→
    34→	// --- State ---
    35→	let loading = $state(true);
    36→	let error = $state<string | null>(null);
    37→
    38→	// Task counts
    39→	interface TaskCounts {
    40→		ready: number;
    41→		in_progress: number;
    42→		needs_work: number;
    43→		pending_review: number;
    44→		blocked: number;
    45→		completed: number;
    46→		cancelled: number;
    47→	}
    48→
    49→	let counts = $state<TaskCounts>({
    50→		ready: 0,
    51→		in_progress: 0,
    52→		needs_work: 0,
    53→		pending_review: 0,
    54→		blocked: 0,
    55→		completed: 0,
    56→		cancelled: 0
    57→	});
    58→
    59→	// Active work
    60→	let agentStatus = $state<AgentDispatchStatus | null>(null);
    61→	let taskTitles = $state<Record<string, string>>({});
    62→
    63→	let hasActiveWork = $derived(
    64→		agentStatus?.dispatch_enabled && (agentStatus?.active_invocations?.length ?? 0) > 0
    65→	);
    66→
    67→	// Needs attention
    68→	let inboxUntriaged = $state(0);
    69→	let observationsUnresolved = $state(0);
    70→	let validationWarnings = $state(0);
    71→	let blockedTasks = $state(0);
    72→
    73→	let totalAttention = $derived(
    74→		inboxUntriaged + observationsUnresolved + validationWarnings + blockedTasks
    75→	);
    76→
    77→	// --- Status config with design system tokens ---
    78→	// AC: @ui-dashboard-overview ac-1 — clickable count cards per status
    79→	const statusConfig = [
    80→		{
    81→			key: 'ready' as const,
    82→			label: 'Ready',
    83→			dotClass: 'bg-status-pending',
    84→			filterStatus: 'pending'
    85→		},
    86→		{
    87→			key: 'in_progress' as const,
    88→			label: 'In Progress',
    89→			dotClass: 'bg-status-in-progress',
    90→			filterStatus: 'in_progress'
    91→		},
    92→		{
    93→			key: 'needs_work' as const,
    94→			label: 'Needs Work',
    95→			dotClass: 'bg-status-needs-work',
    96→			filterStatus: 'needs_work'
    97→		},
    98→		{
    99→			key: 'pending_review' as const,
   100→			label: 'Review',
   101→			dotClass: 'bg-status-pending-review',
   102→			filterStatus: 'pending_review'
   103→		},
   104→		{
   105→			key: 'blocked' as const,
   106→			label: 'Blocked',
   107→			dotClass: 'bg-status-blocked',
   108→			filterStatus: 'blocked'
   109→		},
   110→		{
   111→			key: 'completed' as const,
   112→			label: 'Completed',
   113→			dotClass: 'bg-status-completed',
   114→			filterStatus: 'completed'
   115→		},
   116→		{
   117→			key: 'cancelled' as const,
   118→			label: 'Cancelled',
   119→			dotClass: 'bg-status-cancelled',
   120→			filterStatus: 'cancelled'
   121→		}
   122→	];
   123→
   124→	// --- Needs attention items config ---
   125→	const attentionItems = $derived([
   126→		{
   127→			key: 'inbox',
   128→			label: 'Untriaged inbox',
   129→			count: inboxUntriaged,
   130→			icon: InboxIcon,
   131→			href: `${base}/inbox`,
   132→			colorClass: 'text-status-pending-review'
   133→		},
   134→		{
   135→			key: 'observations',
   136→			label: 'Unresolved observations',
   137→			count: observationsUnresolved,
   138→			icon: Eye,
   139→			href: `${base}/observations`,
   140→			colorClass: 'text-status-in-progress'
   141→		},
   142→		{
   143→			key: 'validation',
   144→			label: 'Validation warnings',
   145→			count: validationWarnings,
   146→			icon: ShieldAlert,
   147→			href: `${base}/validate`,
   148→			colorClass: 'text-status-needs-work'
   149→		},
   150→		{
   151→			key: 'blocked',
   152→			label: 'Blocked tasks',
   153→			count: blockedTasks,
   154→			icon: Ban,
   155→			href: `${base}/tasks?status=blocked`,
   156→			colorClass: 'text-status-blocked'
   157→		}
   158→	]);
   159→
   160→	// --- Elapsed time formatting ---
   161→	function formatElapsed(ms: number): string {
   162→		const secs = Math.floor(ms / 1000);
   163→		const mins = Math.floor(secs / 60);
   164→		const hours = Math.floor(mins / 60);
   165→		if (hours > 0) return `${hours}h ${mins % 60}m`;
   166→		if (mins > 0) return `${mins}m ${secs % 60}s`;
   167→		return `${secs}s`;
   168→	}
   169→
   170→	// --- Data loading ---
   171→	async function loadDashboard() {
   172→		loading = true;
   173→		error = null;
   174→
   175→		try {
   176→			const [tasksResponse, inboxResponse, obsResponse, validationResult, agentStatusResult] =
   177→				await Promise.all([
   178→					fetchTasks({ limit: 1000 }),
   179→					fetchInbox({ limit: 0 }),
   180→					fetchObservations({ resolved: false }),
   181→					fetchValidation().catch(() => null),
   182→					isStaticMode()
   183→						? Promise.resolve(null)
   184→						: fetchAgentStatus().catch(() => null)
   185→				]);
   186→
   187→			// Compute task counts
   188→			const tasks = tasksResponse.items;
   189→			const newCounts: TaskCounts = {
   190→				ready: 0,
   191→				in_progress: 0,
   192→				needs_work: 0,
   193→				pending_review: 0,
   194→				blocked: 0,
   195→				completed: 0,
   196→				cancelled: 0
   197→			};
   198→
   199→			const completedRefs = new Set(
   200→				tasks
   201→					.filter((t) => t.status === 'completed')
   202→					.flatMap((t) => [t._ulid, ...(t.slugs || [])])
   203→			);
   204→
   205→			const titles: Record<string, string> = {};
   206→
   207→			for (const task of tasks) {
   208→				// Build task titles for active fleet
   209→				if (task.slugs?.length) {
   210→					for (const slug of task.slugs) {
   211→						titles[`@${slug}`] = task.title;
   212→					}
   213→				}
   214→				titles[`@${task._ulid}`] = task.title;
   215→
   216→				switch (task.status) {
   217→					case 'completed':
   218→						newCounts.completed++;
   219→						break;
   220→					case 'in_progress':
   221→						newCounts.in_progress++;
   222→						break;
   223→					case 'pending_review':
   224→						newCounts.pending_review++;
   225→						break;
   226→					case 'blocked':
   227→						newCounts.blocked++;
   228→						break;
   229→					case 'needs_work':
   230→						newCounts.needs_work++;
   231→						break;
   232→					case 'cancelled':
   233→						newCounts.cancelled++;
   234→						break;
   235→					case 'pending': {
   236→						const deps = task.depends_on || [];
   237→						const hasUnmetDeps = deps.some((dep: string) => {
   238→							const ref = dep.startsWith('@') ? dep.slice(1) : dep;
   239→							return !completedRefs.has(ref);
   240→						});
   241→						if (hasUnmetDeps) {
   242→							// Pending tasks with unmet deps are not ready, but don't
   243→							// count as "blocked" (which is status=blocked only). They
   244→							// resolve naturally when predecessor tasks complete.
   245→						} else {
   246→							newCounts.ready++;
   247→						}
   248→						break;
   249→					}
   250→				}
   251→			}
   252→
   253→			counts = newCounts;
   254→			taskTitles = titles;
   255→			// Needs-attention blocked count only includes status=blocked tasks.
   256→			// Pending tasks with unmet deps are excluded — they resolve naturally
   257→			// when predecessor tasks complete, and don't require user intervention.
   258→			blockedTasks = newCounts.blocked;
   259→
   260→			// Inbox count
   261→			inboxUntriaged = inboxResponse.total;
   262→
   263→			// Observations: unresolved count
   264→			observationsUnresolved = obsResponse.total;
   265→
   266→			// Validation warnings
   267→			if (validationResult) {
   268→				validationWarnings =
   269→					validationResult.refWarnings.length +
   270→					validationResult.completenessWarnings.length +
   271→					validationResult.schemaErrors.length +
   272→					validationResult.refErrors.length;
   273→			}
   274→
   275→			// Agent status
   276→			if (agentStatusResult) {
   277→				agentStatus = agentStatusResult;
   278→			}
   279→		} catch (err) {
   280→			error = err instanceof Error ? err.message : 'Failed to load dashboard data';
   281→			console.error('Dashboard load error:', err);
   282→		} finally {
   283→			loading = false;
   284→		}
   285→	}
   286→
   287→	function navigateToTasks(status: string) {
   288→		goto(`${base}/tasks?status=${status}`);
   289→	}
   290→
   291→	// --- WebSocket real-time updates ---
   292→	function handleTaskUpdate() {
   293→		loadDashboard();
   294→	}
   295→
   296→	function handleAgentEvent() {
   297→		fetchAgentStatus()
   298→			.then((s) => {
   299→				agentStatus = s;
   300→			})
   301→			.catch(() => {});
   302→	}
   303→
   304→	// --- Lifecycle ---
   305→	onMount(() => {
   306→		loadDashboard();
   307→
   308→		if (!isStaticMode()) {
   309→			subscribe(['tasks', 'agents']);
   310→			on('tasks', handleTaskUpdate);
   311→			on('agents', handleAgentEvent);
   312→		}
   313→	});
   314→
   315→	onDestroy(() => {
   316→		if (!isStaticMode()) {
   317→			off('tasks', handleTaskUpdate);
   318→			off('agents', handleAgentEvent);
   319→			unsubscribe(['tasks', 'agents']);
   320→		}
   321→	});
   322→
   323→	// Reload on project change
   324→	$effect(() => {
   325→		const version = getProjectVersion();
   326→		if (version > 0) {
   327→			loadDashboard();
   328→		}
   329→	});
   330→</script>
   331→
   332→<div class="flex flex-col gap-6 p-6" data-testid="dashboard">
   333→	<h1 class="text-2xl font-bold">Dashboard</h1>
   334→
   335→	{#if error}
   336→		<!-- Error state -->
   337→		<div
   338→			class="flex items-center gap-3 rounded-lg border border-destructive/50 bg-destructive/10 p-4"
   339→			role="alert"
   340→			data-testid="dashboard-error"
   341→		>
   342→			<AlertTriangle class="size-5 text-destructive" />
   343→			<div>
   344→				<p class="text-sm font-medium text-destructive">Failed to load dashboard</p>
   345→				<p class="text-xs text-muted-foreground">{error}</p>
   346→			</div>
   347→			<button
   348→				class="ml-auto text-xs text-muted-foreground underline hover:text-foreground"
   349→				onclick={loadDashboard}
   350→			>
   351→				Retry
   352→			</button>
   353→		</div>
   354→	{/if}
   355→
   356→	{#if loading}
   357→		<!-- Loading skeleton -->
   358→		<div data-testid="dashboard-skeleton">
   359→			<!-- Active work skeleton -->
   360→			<div class="mb-6">
   361→				<Skeleton class="mb-2 h-5 w-32 ds-shimmer" />
   362→				<div class="flex gap-3">
   363→					<Skeleton class="h-20 w-72 ds-shimmer" />
   364→				</div>
   365→			</div>
   366→
   367→			<!-- Status summary skeleton -->
   368→			<div class="mb-6">
   369→				<Skeleton class="mb-3 h-5 w-40 ds-shimmer" />
   370→				<div class="grid gap-4 md:grid-cols-4 lg:grid-cols-7">
   371→					{#each Array(7) as _}
   372→						<Skeleton class="h-24 ds-shimmer" />
   373→					{/each}
   374→				</div>
   375→			</div>
   376→
   377→			<!-- Needs attention skeleton -->
   378→			<div>
   379→				<Skeleton class="mb-3 h-5 w-40 ds-shimmer" />
   380→				<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
   381→					{#each Array(4) as _}
   382→						<Skeleton class="h-20 ds-shimmer" />
   383→					{/each}
   384→				</div>
   385→			</div>
   386→		</div>
   387→	{:else}
   388→		<!-- AC: @ui-dashboard-overview ac-1 — Active work section -->
   389→		<section data-testid="active-work-section">
   390→			{#if hasActiveWork}
   391→				<div class="mb-4">
   392→					<div class="flex items-center gap-2 mb-2">
   393→						<Activity class="size-4 text-status-in-progress" />
   394→						<h2 class="text-sm font-medium">Active Fleet</h2>
   395→						<Badge variant="secondary" class="text-[10px]">
   396→							{agentStatus?.active_invocations.length} running
   397→						</Badge>
   398→					</div>
   399→					<div class="flex gap-3 overflow-x-auto pb-2" data-testid="active-fleet-row">
   400→						{#each agentStatus?.active_invocations ?? [] as invocation (invocation.session_id)}
   401→							{@const title = invocation.task_ref ? taskTitles[invocation.task_ref] : undefined}
   402→							<div
   403→								class="flex-shrink-0 w-72 rounded-lg border bg-card p-3 ds-breathe"
   404→								data-testid="fleet-card"
   405→							>
   406→								<div class="flex items-center gap-2 mb-1.5">
   407→									<Bot class="size-4 text-muted-foreground" />
   408→									<span class="text-xs font-medium truncate">{invocation.agent_id}</span>
   409→								</div>
   410→
   411→								{#if invocation.task_ref}
   412→									<div class="truncate mb-1">
   413→										<ReferenceLink ref={invocation.task_ref} type="task" title={title} class="text-xs" />
   414→									</div>
   415→								{/if}
   416→
   417→								<div class="flex items-center justify-between text-[10px] text-muted-foreground">
   418→									<div class="flex items-center gap-1.5">
   419→										<!-- Pulse indicator -->
   420→										<span class="relative flex size-2">
   421→											<span
   422→												class="absolute inline-flex h-full w-full rounded-full bg-status-in-progress opacity-75 ds-breathe"
   423→											></span>
   424→											<span
   425→												class="relative inline-flex size-2 rounded-full bg-status-in-progress"
   426→											></span>
   427→										</span>
   428→										<span>{formatElapsed(invocation.elapsed_ms)}</span>
   429→									</div>
   430→
   431→									<a
   432→										href="{base}/sessions/{invocation.session_id}"
   433→										class="inline-flex items-center gap-1 text-primary hover:underline"
   434→									>
   435→										Stream
   436→										<ExternalLink class="size-3" />
   437→									</a>
   438→								</div>
   439→							</div>
   440→						{/each}
   441→					</div>
   442→				</div>
   443→			{:else}
   444→				<div
   445→					class="flex items-center gap-2 rounded-lg border border-dashed p-4 text-sm text-muted-foreground"
   446→					data-testid="no-active-work"
   447→				>
   448→					<Activity class="size-4" />
   449→					<span>No agents currently running</span>
   450→				</div>
   451→			{/if}
   452→		</section>
   453→
   454→		<!-- AC: @ui-dashboard-overview ac-1 — Status summary with clickable count cards -->
   455→		<section data-testid="status-summary-section">
   456→			<h2 class="mb-3 text-sm font-medium text-muted-foreground">Status Summary</h2>
   457→			<div class="grid gap-3 md:grid-cols-4 lg:grid-cols-7" data-testid="dashboard-counts">
   458→				{#each statusConfig as status}
   459→					<button
   460→						class="text-left"
   461→						onclick={() => navigateToTasks(status.filterStatus)}
   462→						data-testid="task-count-{status.key}"
   463→					>
   464→						<Card class="transition-colors hover:bg-muted/50 cursor-pointer h-full">
   465→							<CardHeader
   466→								class="flex flex-row items-center justify-between pb-1 pt-3 px-3 space-y-0"
   467→							>
   468→								<CardTitle class="text-xs font-medium text-muted-foreground">
   469→									{status.label}
   470→								</CardTitle>
   471→								<span class="inline-block size-2.5 rounded-full {status.dotClass}"></span>
   472→							</CardHeader>
   473→							<CardContent class="px-3 pb-3">
   474→								<div class="text-2xl font-bold tabular-nums">
   475→									{counts[status.key]}
   476→								</div>
   477→							</CardContent>
   478→						</Card>
   479→					</button>
   480→				{/each}
   481→			</div>
   482→		</section>
   483→
   484→		<!-- AC: @ui-dashboard-overview ac-1 — Needs attention aggregation -->
   485→		<section data-testid="needs-attention-section">
   486→			<div class="mb-3 flex items-center gap-2">
   487→				<h2 class="text-sm font-medium text-muted-foreground">Needs Attention</h2>
   488→				{#if totalAttention > 0}
   489→					<Badge variant="secondary" class="text-[10px]">{totalAttention}</Badge>
   490→				{/if}
   491→			</div>
   492→
   493→			{#if totalAttention === 0}
   494→				<div
   495→					class="flex items-center gap-2 rounded-lg border border-dashed p-4 text-sm text-muted-foreground"
   496→					data-testid="no-attention-needed"
   497→				>
   498→					<span>Nothing needs attention right now</span>
   499→				</div>
   500→			{:else}
   501→				<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4" data-testid="attention-cards">
   502→					{#each attentionItems as item}
   503→						{#if item.count > 0}
   504→							<a href={item.href} class="block" data-testid="attention-{item.key}">
   505→								<Card class="transition-colors hover:bg-muted/50 cursor-pointer h-full">
   506→									<CardContent class="flex items-center gap-3 p-4">
   507→										<div class="rounded-md bg-muted p-2">
   508→											<item.icon class="size-4 {item.colorClass}" />
   509→										</div>
   510→										<div>
   511→											<p class="text-2xl font-bold tabular-nums">{item.count}</p>
   512→											<p class="text-xs text-muted-foreground">{item.label}</p>
   513→										</div>
   514→									</CardContent>
   515→								</Card>
   516→							</a>
   517→						{/if}
   518→					{/each}
   519→				</div>
   520→			{/if}
   521→		</section>
   522→	{/if}
   523→</div>
   524→
```