werStr.indexOf(lowerPattern);\n  1516\t  if (matchIndex === -1) {\n  1517\t    // Shouldn't happen since we pre-filtered, but return start of content\n  1518\t    return str.length > maxLength ? str.slice(0, maxLength - 3) + \"...\" : str;\n  1519\t  }\n  1520\t\n  1521\t  // Calculate excerpt window centered on match\n  1522\t  const matchLen = pattern.length;\n  1523\t  const contextBefore = Math.floor((maxLength - matchLen) / 2);\n  1524\t  const start = Math.max(0, matchIndex - contextBefore);\n  1525\t  const end = Math.min(str.length, start + maxLength);\n  1526\t\n  1527\t  let excerpt = str.slice(start, end);\n  1528\t\n  1529\t  // Add ellipsis indicators\n  1530\t  if (start > 0) {\n  1531\t    excerpt = \"...\" + excerpt.slice(3);\n  1532\t  }\n  1533\t  if (end < str.length) {\n  1534\t    excerpt = excerpt.slice(0, -3) + \"...\";\n  1535\t  }\n  1536\t\n  1537\t  return excerpt;\n  1538\t}\n  1539\t\n  1540\t/**\n  1541\t * Search across session events for a pattern.\n  1542\t *\n  1543\t * This streams through events.jsonl files, applying filters as early as possible\n  1544\t * for performance. Sessions are pre-filtered by metadata (--since, --agent) before\n  1545\t * scanning events to reduce I/O.\n  1546\t *\n  1547\t * AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7\n  1548\t *\n  1549\t * @param specDir - The .kspec directory path\n  1550\t * @param pattern - Case-insensitive substring to search for\n  1551\t * @param options - Search filtering options\n  1552\t * @returns Array of search results grouped by session\n  1553\t */\n  1554\texport async function searchSessionEvents(\n  1555\t  specDir: string,\n  1556\t  pattern: string,\n  1557\t  options: SearchOptions = {},\n  1558\t): Promise<SessionSearchResult[]> {\n  1559\t  // Defense-in-depth: normalize limit to a valid positive integer\n  1560\t  const rawLimit = options.limit ?? 50;\n  1561\t  const limit = Number.isNaN(rawLimit) || rawLimit <= 0 ? 50 : rawLimit;\n  1562\t  const lowerPattern = pattern.toLowerCase();\n  1563\t\n  1564\t  // Get all session summaries for metadata filtering\n  1565\t  const allSummaries = await getAllSessionLogSummaries(specDir);\n  1566\t\n  1567\t  // AC: @session-log-search ac-3 - Pre-filter by --since\n  1568\t  let filteredSummaries = allSummaries;\n  1569\t  if (options.sinceDate) {\n  1570\t    filteredSummaries = filteredSummaries.filter(\n  1571\t      (s) => new Date(s.started_at) >= options.sinceDate!,\n  1572\t    );\n  1573\t  }\n  1574\t\n  1575\t  // AC: @session-log-search ac-7 - Pre-filter by --agent\n  1576\t  if (options.agentType) {\n  1577\t    filteredSummaries = filteredSummaries.filter(\n  1578\t      (s) => s.agent_type === options.agentType,\n  1579\t    );\n  1580\t  }\n  1581\t\n  1582\t  const results: SessionSearchResult[] = [];\n  1583\t  let totalMatches = 0;\n  1584\t\n  1585\t  for (const summary of filteredSummaries) {\n  1586\t    if (totalMatches >= limit) break;\n  1587\t\n  1588\t    const eventsPath = getSessionEventsPath(specDir, summary.id);\n  1589\t    let content: string;\n  1590\t    try {\n  1591\t      content = await fsPromises.readFile(eventsPath, \"utf-8\");\n  1592\t    } catch {\n  1593\t      continue; // Skip sessions without events\n  1594\t    }\n  1595\t\n  1596\t    if (!content.trim()) continue;\n  1597\t\n  1598\t    const matches: SearchMatch[] = [];\n  1599\t    const lines = content.trim().split(\"\\n\");\n  1600\t    // Track seen tool_call IDs to skip phased duplicates\n  1601\t    const seenToolCallIds = new Set<string>();\n  1602\t\n  1603\t    for (const line of lines) {\n  1604\t      if (totalMatches >= limit) break;\n  1605\t\n  1606\t      // Quick substring pre-filter before parsing JSON\n  1607\t      if (!line.toLowerCase().includes(lowerPattern)) continue;\n  1608\t\n  1609\t      try {\n  1610\t        const event = JSON.parse(line);\n  1611\t\n  1612\t        // AC: @session-log-search ac-2 - Filter by event type\n  1613\t        if (options.eventType && event.type !== options.eventType) continue;\n  1614\t\n  1615\t        // Deduplicate phased tool_call events\n  1616\t        if (event?.type === \"session.update\") {\n  1617\t          const update = event?.data?.update;\n  1618\t          if (update?.sessionUpdate === \"tool_call\") {\n  1619\t            const toolCallId = update?.toolCallId || update?.tool_call_id || update?.id;\n  1620\t            if (toolCallId) {\n  1621\t              if (seenToolCallIds.has(toolCallId)) continue;\n  1622\t              seenToolCallIds.add(toolCallId);\n  1623\t            }\n  1624\t          }\n  1625\t        }\n  1626\t\n  1627\t        // Verify match in stringified data (not just line, in case pattern appears in metadata)\n  1628\t        const dataStr = JSON.stringify(event.data);\n  1629\t        if (!dataStr.toLowerCase().includes(lowerPattern)) continue;\n  1630\t\n  1631\t        // AC: @session-log-search ac-4 - Create match with excerpt\n  1632\t        matches.push({\n  1633\t          session_id: summary.id,\n  1634\t          timestamp: event.ts,\n  1635\t          event_type: event.type,\n  1636\t          content_excerpt: extractContentExcerpt(event.data, pattern, 200),\n  1637\t        });\n  1638\t        totalMatches++;\n  1639\t      } catch {\n  1640\t        // Skip unparseable lines\n  1641\t      }\n  1642\t    }\n  1643\t\n  1644\t    if (matches.length > 0) {\n  1645\t      results.push({\n  1646\t        session_id: summary.id,\n  1647\t        agent_type: summary.agent_type,\n  1648\t        started_at: summary.started_at,\n  1649\t        matches,\n  1650\t      });\n  1651\t    }\n  1652\t  }\n  1653\t\n  1654\t  return results;\n  1655\t}\n  1656\t\n  1657\t// ─── Session Creation with Budget ─────────────────────────────────────────────\n  1658\t\n  1659\t/**\n  1660\t * Create a session with an optional task budget in one call.\n  1661\t *\n  1662\t * This is the library-level entry point for session creation. It creates\n  1663\t * the session directory, writes session.yaml, and optionally writes budget.json.\n  1664\t * Returns metadata without any console output.\n  1665\t *\n  1666\t * AC: @session-creation-and-env-injection ac-create\n  1667\t * AC: @session-creation-and-env-injection ac-budget\n  1668\t * AC: @session-creation-and-env-injection ac-budget-local\n  1669\t * AC: @session-creation-and-env-injection ac-library\n  1670\t *\n  1671\t * @param specDir - The .kspec directory path\n  1672\t * @param input - Session creation parameters\n  1673\t * @returns Session metadata and optional budget (no console output)\n  1674\t */\n  1675\texport async function createSessionWithBudget(\n  1676\t  specDir: string,\n  1677\t  input: {\n  1678\t    id: string;\n  1679\t    agent_type: string;\n  1680\t    task_id?: string;\n","status":"completed"}