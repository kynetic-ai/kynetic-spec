 386\t *\n   387\t * Creates the session directory if it doesn't exist (lazy creation).\n   388\t *\n   389\t * Note: This function is not safe for concurrent access to the same session.\n   390\t * The sequence number assignment has a race condition between reading the\n   391\t * event count and appending the event. This is acceptable for CLI use\n   392\t * (single-process, sequential event logging). If concurrent access is needed\n   393\t * in the future, consider file locking or an in-memory counter per session.\n   394\t *\n   395\t * @param specDir - The .kspec directory path\n   396\t * @param input - Event input (ts and seq are auto-assigned if not provided)\n   397\t * @returns The appended event with auto-assigned fields\n   398\t */\n   399\texport async function appendEvent(\n   400\t  specDir: string,\n   401\t  input: SessionEventInput,\n   402\t): Promise<SessionEvent> {\n   403\t  const sessionDir = getSessionDir(specDir, input.session_id);\n   404\t  const eventsPath = getSessionEventsPath(specDir, input.session_id);\n   405\t\n   406\t  // Ensure session directory exists (lazy creation)\n   407\t  await fsPromises.mkdir(sessionDir, { recursive: true });\n   408\t\n   409\t  // Get current event count for seq assignment\n   410\t  const seq = input.seq ?? (await getEventCount(specDir, input.session_id));\n   411\t\n   412\t  // Build full event\n   413\t  const event: SessionEvent = {\n   414\t    ts: input.ts ?? Date.now(),\n   415\t    seq,\n   416\t    type: input.type,\n   417\t    session_id: input.session_id,\n   418\t    trace_id: input.trace_id,\n   419\t    data: input.data,\n   420\t  };\n   421\t\n   422\t  // Validate event\n   423\t  const validated = SessionEventSchema.parse(event);\n   424\t\n   425\t  // AC: @session-events ac-3 - Use synchronous append for crash safety\n   426\t  // This ensures the line is fully written before returning\n   427\t  const line = `${JSON.stringify(validated)}\\n`;\n   428\t  fs.appendFileSync(eventsPath, line, \"utf-8\");\n   429\t\n   430\t  return validated;\n   431\t}\n   432\t\n   433\t/**\n   434\t * Read all events from a session.\n   435\t *\n   436\t * AC-4: Returns all events in sequence order.\n   437\t *\n   438\t * @param specDir - The .kspec directory path\n   439\t * @param sessionId - Session ID\n   440\t * @returns Array of events sorted by sequence number\n   441\t */\n   442\texport async function readEvents(\n   443\t  specDir: string,\n   444\t  sessionId: string,\n   445\t): Promise<SessionEvent[]> {\n   446\t  const eventsPath = getSessionEventsPath(specDir, sessionId);\n   447\t\n   448\t  try {\n   449\t    const content = await fsPromises.readFile(eventsPath, \"utf-8\");\n   450\t    const lines = content\n   451\t      .trim()\n   452\t      .split(\"\\n\")\n   453\t      .filter((line) => line.length > 0);\n   454\t\n   455\t    const events: SessionEvent[] = [];\n   456\t    for (const line of lines) {\n   457\t      try {\n   458\t        const raw = JSON.parse(line);\n   459\t        const event = SessionEventSchema.parse(raw);\n   460\t        events.push(event);\n   461\t      } catch {\n   462\t        // Skip invalid lines\n   463\t      }\n   464\t    }\n   465\t\n   466\t    // AC: @session-events ac-4 - Sort by sequence number\n   467\t    return events.sort((a, b) => a.seq - b.seq);\n   468\t  } catch {\n   469\t    return [];\n   470\t  }\n   471\t}\n   472\t\n   473\t/**\n   474\t * Deduplicate phased tool_call events.\n   475\t *\n   476\t * ACP SDK 0.14+ sends tool calls in two phases: first with empty rawInput,\n   477\t * then with populated rawInput. This merges them by keeping only the version\n   478\t * with populated rawInput per toolCallId.\n   479\t */\n   480\texport function deduplicatePhasedToolCalls(\n   481\t  events: SessionEvent[],\n   482\t): SessionEvent[] {\n   483\t  // First pass: find toolCallIds that have a populated rawInput version\n   484\t  const populatedToolCalls = new Map<string, number>(); // toolCallId → index\n   485\t  for (let i = 0; i < events.length; i++) {\n   486\t    const event = events[i];\n   487\t    if (event.type !== \"session.update\") continue;\n   488\t    const data = event.data as { update?: { sessionUpdate?: string; toolCallId?: string; tool_call_id?: string; id?: string; rawInput?: Record<string, unknown> } } | null;\n   489\t    const update = data?.update;\n   490\t    if (update?.sessionUpdate !== \"tool_call\") continue;\n   491\t    const toolCallId = update.toolCallId || update.tool_call_id || update.id;\n   492\t    if (!toolCallId) continue;\n   493\t    const rawInput = update.rawInput;\n   494\t    const hasContent = rawInput && Object.keys(rawInput).length > 0;\n   495\t    if (hasContent) {\n   496\t      populatedToolCalls.set(toolCallId, i);\n   497\t    } else if (!populatedToolCalls.has(toolCallId)) {\n   498\t      // First (empty) version - track it in case no populated version exists\n   499\t      populatedToolCalls.set(toolCallId, i);\n   500\t    }\n","stderr":"","aggregated_output":"   340\t    close_reason: reason,\n   341\t  };\n   342\t\n   343\t  const metadataPath = getSessionMetadataPath(specDir, sessionId);\n   344\t  const content = YAML.stringify(updated, {\n   345\t    indent: 2,\n   346\t    lineWidth: 100,\n   347\t    sortMapEntries: false,\n   348\t  });\n   349\t  await fsPromises.writeFile(metadataPath, content, \"utf-8\");\n   350\t\n   351\t  return updated;\n   352\t}\n   353\t\n   354\t// ─── Event Storage ───────────────────────────────────────────────────────────\n   355\t\n   356\t/**\n   357\t * Get the current event count for a session (for seq assignment).\n   358\t *\n   359\t * @param specDir - The .kspec directory path\n   360\t * @param sessionId - Session ID\n   361\t * @returns Number of events in the session\n   362\t */\n   363\tasync function getEventCount(\n   364\t  specDir: string,\n   365\t  sessionId: string,\n   366\t): Promise<number> {\n   367\t  const eventsPath