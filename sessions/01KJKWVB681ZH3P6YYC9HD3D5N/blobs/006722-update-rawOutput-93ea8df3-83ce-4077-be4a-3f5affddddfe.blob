);\n   470\t        } else if (minutes > 0) {\n   471\t          output(`  Uptime: ${minutes}m ${seconds}s`);\n   472\t        } else {\n   473\t          output(`  Uptime: ${seconds}s`);\n   474\t        }\n   475\t      }\n   476\t      // AC: @multi-directory-daemon ac-12 - Show registered projects\n   477\t      if (projects.length > 0) {\n   478\t        output(`\\nRegistered projects (${projects.length}):`);\n   479\t        for (const project of projects) {\n   480\t          output(`  ${project.path} (watcher: ${project.watcherStatus})`);\n   481\t        }\n   482\t      } else {\n   483\t        output(`\\nNo projects registered`);\n   484\t      }\n   485\t    } else {\n   486\t      output('Daemon not running');\n   487\t    }\n   488\t  }\n   489\t}\n   490\t\n   491\t/**\n   492\t * Restart the daemon server\n   493\t * AC: @cli-serve-commands ac-7\n   494\t */\n   495\tasync function restartServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {\n   496\t  const pidManager = new PidFileManager();\n   497\t\n   498\t  // AC: @cli-serve-commands ac-7 - preserve port across restarts\n   499\t  // Try to read port from existing daemon, otherwise startServer will use config default\n   500\t  let port: string | undefined;\n   501\t  try {\n   502\t    port = pidManager.readPort().toString();\n   503\t  } catch {\n   504\t    // Port file doesn't exist or is invalid, let startServer use config\n   505\t  }\n   506\t\n   507\t  if (pidManager.isDaemonRunning()) {\n   508\t    if (!isJsonMode()) {\n   509\t      info('Stopping daemon...');\n   510\t    }\n   511\t    await stopServer(opts);\n   512\t  }\n   513\t\n   514\t  if (!isJsonMode()) {\n   515\t    info('Starting daemon...');\n   516\t  }\n   517\t  await startServer({ daemon: true, port, kspecDir: opts.kspecDir });\n   518\t}\n","exit_code":0,"duration":{"secs":0,"nanos":51338764},"formatted_output":"   260\t    while (Date.now() - startTime < maxWait) {\n   261\t      pid = pidManager.readPid();\n   262\t      if (pid && pidManager.isDaemonRunning()) {\n   263\t        break;\n   264\t      }\n   265\t      await new Promise(resolve => setTimeout(resolve, 100));\n   266\t    }\n   267\t\n   268\t    if (pid && pidManager.isDaemonRunning()) {\n   269\t      if (isJsonMode()) {\n   270\t        output({ running: true, pid, port });\n   271\t      } else {\n   272\t        success(`Daemon started with PID ${pid} on port ${port}`);\n   273\t        output({ running: true, pid, port });\n   274\t      }\n   275\t    } else {\n   276\t      if (isJsonMode()) {\n   277\t        output({ error: 'Daemon failed to start within 5 seconds' });\n   278\t      } else {\n   279\t        error('Daemon failed to start within 5 seconds');\n   280\t      }\n   281\t      process.exit(EXIT_CODES.ERROR);\n   282\t    }\n   283\t  } else {\n   284\t    // AC: @cli-serve-commands ac-1 - foreground mode\n   285\t    if (!isJsonMode()) {\n   286\t      info(`Starting server in foreground on port ${port}...`);\n   287\t      info('Press Ctrl+C to stop');\n   288\t    }\n   289\t\n   290\t    const runtime = 'bun';\n   291\t\n   292\t    // Set BUN_ENV=production to prevent Bun dev mode HTML transformation\n   293\t    const child = spawn(runtime, [daemonBinary, '--port', String(port), '--kspec-dir', opts.kspecDir], {\n   294\t      stdio: 'inherit',\n   295\t      cwd: process.cwd(),\n   296\t      env: { ...process.env, BUN_ENV: 'production' },\n   297\t    });\n   298\t\n   299\t    // Handle Ctrl+C - forward SIGTERM to child for graceful shutdown\n   300\t    process.on('SIGINT', () => {\n   301\t      if (!isJsonMode()) {\n   302\t        info('\\nStopping server...');\n   303\t      }\n   304\t      child.kill('SIGTERM');\n   305\t\n   306\t      // Wait for graceful shutdown (max 5 seconds)\n   307\t      const shutdownTimeout = setTimeout(() => {\n   308\t        child.kill('SIGKILL'); // Force kill if not stopped\n   309\t      }, 5000);\n   310\t\n   311\t      child.on('exit', () => {\n   312\t        clearTimeout(shutdownTimeout);\n   313\t      });\n   314\t    });\n   315\t\n   316\t    // Wait for process to exit\n   317\t    child.on('exit', (code) => {\n   318\t      process.exit(code ?? 0);\n   319\t    });\n   320\t  }\n   321\t}\n   322\t\n   323\t/**\n   324\t * Stop the daemon server\n   325\t * AC: @cli-serve-commands ac-4 (stop), ac-5 (idempotent)\n   326\t */\n   327\tasync function stopServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {\n   328\t  if (isJsonMode()) {\n   329\t  }\n   330\t\n   331\t  const pidManager = new PidFileManager();\n   332\t\n   333\t  if (!pidManager.isDaemonRunning()) {\n   334\t    // AC: @cli-serve-commands ac-5\n   335\t    if (isJsonMode()) {\n   336\t      output({ running: false });\n   337\t    } else {\n   338\t      info('Daemon not running');\n   339\t      output({ running: false });\n   340\t    }\n   341\t    process.exit(EXIT_CODES.SUCCESS);\n   342\t  }\n   343\t\n   344\t  const pid = pidManager.readPid();\n   345\t  if (!pid) {\n   346\t    if (isJsonMode()) {\n   347\t      output({ error: 'Failed to read PID file' });\n   348\t    } else {\n   349\t      error('Failed to read PID file');\n   350\t    }\n   351\t    process.exit(EXIT_CODES.ERROR);\n   352\t  }\n   353\t\n   354\t  // AC: @cli-serve-commands ac-4\n   355\t  if (!isJsonMode()) {\n   356\t    info(`Stopping daemon (PID ${pid})...`);\n   357\t  }\n   358\t\n   359\t  try {\n   360\t    // Send SIGTERM\n   361\t    process.kill(pid, 'SIGTERM');\n   362\t\n   363\t    // Wait for clean shutdown (max 5 seconds)\n   364\t    const maxWait = 5000;\n   365\t    const startTime = Date.now();\n   366\t    while (Date.now() - startTime < maxWait) {\n   367\t      if (!pidManager.isDaemonRunning()) {\n   368\t        break;\n   369\t      }\n   370\t      await new Promise(resolve => setTimeout(resolve, 100));\n   371\t    }\n   372\t\n   373\t    if (pidManager.isDaemonRunning()) {\n   374\t      if (!isJsonMode()) {\n   375\t        warn(`Daemon did not stop gracefully, forcing...`);\n   376\t      }\n   377\t      process.kill(pid, 'SIGKILL');\n   378\t      await new Promise(resolve => setTimeout(resolve, 500));\n   379\t    }\n   380\t\n   381\t    if (isJsonMode()) {\n   382\t      output({ stopped: true, pid });\n   383\t    } else {\n   384\t      success('Daemon stopped');\n   385\t      output({ stopped: true, pid });\n   386\t    }\n   387\t  } catch (err) {\n   388\t    if (isJsonMode()) {\n   389\t      output({ error: err instanceof Error ? err.message : String(err) });\n   390\t    } else {\n   391\t      error(`Failed to stop daemon: ${err instanceof Error ? err.message : String(err)}`);\n   392\t    }\n   393\t    process.exit(EXIT_CODES.ERROR);\n   394\t  }\n   395\t}\n   396\t\n   397\t/**\n   398\t * Check daemon server status\n   399\t * AC: @cli-serve-commands ac-6, @multi-directory-daemon ac-12\n   400\t */\n   401\tasync function statusServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {\n   402\t  if (isJsonMode()) {\n   403\t  }\n   404\t\n   405\t  const pidManager = new PidFileManager();\n   406\t  const running = pidManager.isDaemonRunning();\n   407\t  const pid = pidManager.readPid();\n   408\t\n   409\t  // Read port from global config (AC: @multi-directory-daemon ac-13)\n   410\t  let port: number | null = null;\n   411\t  if (running) {\n   412\t    try {\n   413\t      port = pidManager.readPort();\n   414\t    } catch {\n   415\t      // Port file might not exist or be invalid\n   416\t      port = null;\n   417\t    }\n   418\t  }\n   419\t\n   420\t  // AC: @multi-directory-daemon ac-12 - Fetch list of registered projects and uptime\n   421\t  let projects: Array<{ path: string; registeredAt: string; watcherStatus: string }> = [];\n   422\t  let uptime: number | null = null;\n   423\t  if (running && port) {\n   424\t    try {\n   425\t      const response = await fetch(`http://localhost:${port}/api/projects`);\n   426\t      if (response.ok) {\n   427\t        const data = await response.json() as { projects: Array<{ path: string; registeredAt: string; watcherStatus: string }> };\n   428\t        projects = data.projects || [];\n   429\t      }\n   430\t    } catch {\n   431\t      // If daemon is not responding, continue without projects list\n   432\t      // This can happen if daemon is still starting up or network issues\n   433\t    }\n   434\t\n   435\t    // Fetch uptime from health endpoint\n   436\t    try {\n   437\t      const healthResponse = await fetch(`http://localhost:${port}/api/health`);\n   438\t      if (healthResponse.ok) {\n   439\t        const healthData = await healthResponse.json() as { status: string; uptime: number };\n   440\t        uptime = healthData.uptime;\n   441\t      }\n   442\t    } catch {\n   443\t      // If health endpoint fails, continue without uptime\n   444\t    }\n   445\t  }\n   446\t\n   447\t  const status = {\n   448\t    running,\n   449\t    pid: pid ?? null,\n   450\t    port,\n   451\t    uptime,\n   452\t    projects,\n   453\t  };\n   454\t\n   455\t  if (isJsonMode()) {\n   456\t    output(status);\n   457\t  } else {\n   458\t    if (running) {\n   459\t      output(`Daemon running (PID: ${pid})`);\n   460\t      if (port) {\n   461\t        output(`  Port: ${port}`);\n   462\t      }\n   463\t      // AC: @multi-directory-daemon ac-12 - Show uptime\n   464\t      if (uptime !== null) {\n   465\t        const hours = Math.floor(uptime / 3600);\n   466\t        const minutes = Math.floor((uptime % 3600) / 60);\n   467\t        const seconds = Math.floor(uptime % 60);\n   468\t        if (hours > 0) {\n   469\t          output(`  Uptime: ${hours}h ${minutes}m ${seconds}s`);\n   470\t        } else if (minutes > 0) {\n   471\t          output(`  Uptime: ${minutes}m ${seconds}s`);\n   472\t        } else {\n   473\t          output(`  Uptime: ${seconds}s`);\n   474\t        }\n   475\t      }\n   476\t      // AC: @multi-directory-daemon ac-12 - Show registered projects\n   477\t      if (projects.length > 0) {\n   478\t        output(`\\nRegistered projects (${projects.length}):`);\n   479\t        for (const project of projects) {\n   480\t          output(`  ${project.path} (watcher: ${project.watcherStatus})`);\n   481\t        }\n   482\t      } else {\n   483\t        output(`\\nNo projects registered`);\n   484\t      }\n   485\t    } else {\n   486\t      output('Daemon not running');\n   487\t    }\n   488\t  }\n   489\t}\n   490\t\n   491\t/**\n   492\t * Restart the daemon server\n   493\t * AC: @cli-serve-commands ac-7\n   494\t */\n   495\tasync function restartServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {\n   496\t  const pidManager = new PidFileManager();\n   497\t\n   498\t  // AC: @cli-serve-commands ac-7 - preserve port across restarts\n   499\t  // Try to read port from existing daemon, otherwise startServer will use config default\n   500\t  let port: string | undefined;\n   501\t  try {\n   502\t    port = pidManager.readPort().toString();\n   503\t  } catch {\n   504\t    // Port file doesn't exist or is invalid, let startServer use config\n   505\t  }\n   506\t\n   507\t  if (pidManager.isDaemonRunning()) {\n   508\t    if (!isJsonMode()) {\n   509\t      info('Stopping daemon...');\n   510\t    }\n   511\t    await stopServer(opts);\n   512\t  }\n   513\t\n   514\t  if (!isJsonMode()) {\n   515\t    info('Starting daemon...');\n   516\t  }\n   517\t  await startServer({ daemon: true, port, kspecDir: opts.kspecDir });\n   518\t}\n","status":"completed"}