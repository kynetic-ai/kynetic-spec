{"call_id":"call_2Kh4JblAKhLqnQ5dFbaj5TnA","process_id":"83729","turn_id":"019ca802-1b38-7fd2-b06a-0784e9439c27","command":["/usr/bin/bash","-lc","nl -ba tests/session-stale-close.test.ts | sed -n '1,430p'"],"cwd":"/home/chapel/Projects/kynetic-spec","parsed_cmd":[{"type":"read","cmd":"nl -ba tests/session-stale-close.test.ts | sed -n '1,430p'","name":"session-stale-close.test.ts","path":"tests/session-stale-close.test.ts"}],"source":"unified_exec_startup","stdout":"     1\t/**\n     2\t * Session stale close command tests.\n     3\t *\n     4\t * Task: @implement-stale-active-session-cleanup\n     5\t * Spec: @session-stale-cleanup\n     6\t */\n     7\t\n     8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     9\timport * as fs from \"node:fs/promises\";\n    10\timport {\n    11\t  appendEvent,\n    12\t  createSession,\n    13\t  getSession,\n    14\t  getSessionEventsPath,\n    15\t  updateSessionStatus,\n    16\t} from \"../src/sessions/store.js\";\n    17\timport {\n    18\t  cleanupTempDir,\n    19\t  kspec,\n    20\t  kspecJson,\n    21\t  setupTempFixtures,\n    22\t  testUlid,\n    23\t} from \"./helpers/cli.js\";\n    24\t\n    25\tinterface SessionStaleCloseJson {\n    26\t  dry_run: boolean;\n    27\t  mode: \"single\" | \"refs\" | \"all\";\n    28\t  criteria: {\n    29\t    older_than: string;\n    30\t    inactive_for: string;\n    31\t    liveness_guard: string;\n    32\t  };\n    33\t  sessions: Array<{\n    34\t    session_id: string;\n    35\t    status: string;\n    36\t    reason: string;\n    37\t    close_reason?: string;\n    38\t  }>;\n    39\t  totals: {\n    40\t    active_sessions_total: number;\n    41\t    sessions_evaluated: number;\n    42\t    candidates: number;\n    43\t    changed_sessions: number;\n    44\t    skipped_sessions: number;\n    45\t    failures: number;\n    46\t  };\n    47\t}\n    48\t\n    49\tdescribe(\"session stale close\", () => {\n    50\t  let tempDir: string;\n    51\t\n    52\t  beforeEach(async () => {\n    53\t    tempDir = await setupTempFixtures();\n    54\t  });\n    55\t\n    56\t  afterEach(async () => {\n    57\t    await cleanupTempDir(tempDir);\n    58\t  });\n    59\t\n    60\t  async function createActiveSession(\n    61\t    sessionId: string,\n    62\t    startedAt: string,\n    63\t    lastActivityAt?: string,\n    64\t  ): Promise<void> {\n    65\t    await createSession(tempDir, {\n    66\t      id: sessionId,\n    67\t      agent_type: \"test-agent\",\n    68\t      status: \"active\",\n    69\t      started_at: startedAt,\n    70\t    });\n    71\t\n    72\t    if (lastActivityAt) {\n    73\t      await appendEvent(tempDir, {\n    74\t        session_id: sessionId,\n    75\t        type: \"session.update\",\n    76\t        ts: new Date(lastActivityAt).getTime(),\n    77\t        data: { update: \"heartbeat\" },\n    78\t      });\n    79\t    }\n    80\t  }\n    81\t\n    82\t  // AC: @session-stale-cleanup ac-1\n    83\t  // AC: @trait-dry-run ac-1\n    84\t  // AC: @trait-dry-run ac-2\n    85\t  // AC: @trait-dry-run ac-3\n    86\t  // AC: @trait-dry-run ac-6\n    87\t  // AC: @trait-json-output ac-1\n    88\t  // AC: @trait-json-output ac-2\n    89\t  it(\"reports would-close sessions in --all --dry-run with per-session reasons\", async () => {\n    90\t    const staleId = testUlid(\"SESS\", 1);\n    91\t    await createActiveSession(\n    92\t      staleId,\n    93\t      \"2024-01-01T00:00:00.000Z\",\n    94\t      \"2024-01-02T00:00:00.000Z\",\n    95\t    );\n    96\t\n    97\t    const result = kspecJson<SessionStaleCloseJson>(\n    98\t      \"session stale close --all --dry-run --older-than 24h --inactive-for 6h\",\n    99\t      tempDir,\n   100\t    );\n   101\t\n   102\t    expect(result.mode).toBe(\"all\");\n   103\t    expect(result.dry_run).toBe(true);\n   104\t    expect(result.totals.candidates).toBe(1);\n   105\t    expect(result.totals.changed_sessions).toBe(0);\n   106\t    expect(result.sessions[0].status).toBe(\"would_abandon\");\n   107\t    expect(result.sessions[0].reason).toContain(\"dry run\");\n   108\t    expect(result.sessions[0].close_reason?.startsWith(\"auto-abandoned:\")).toBe(\n   109\t      true,\n   110\t    );\n   111\t\n   112\t    const unchanged = await getSession(tempDir, staleId);\n   113\t    expect(unchanged?.status).toBe(\"active\");\n   114\t    expect(unchanged?.ended_at).toBeUndefined();\n   115\t  });\n   116\t\n   117\t  // AC: @session-stale-cleanup ac-2\n   118\t  // AC: @trait-confirmation-prompt ac-4\n   119\t  it(\"closes only the targeted stale active session in single-target mode\", async () => {\n   120\t    const targetId = testUlid(\"SESS\", 2);\n   121\t    const otherId = testUlid(\"SESS\", 3);\n   122\t    await createActiveSession(\n   123\t      targetId,\n   124\t      \"2024-01-01T00:00:00.000Z\",\n   125\t      \"2024-01-02T00:00:00.000Z\",\n   126\t    );\n   127\t    await createActiveSession(\n   128\t      otherId,\n   129\t      \"2024-01-01T00:00:00.000Z\",\n   130\t      \"2024-01-02T00:00:00.000Z\",\n   131\t    );\n   132\t\n   133\t    const output = kspecJson<SessionStaleCloseJson>(\n   134\t      `session stale close ${targetId} --older-than 24h --inactive-for 6h --force`,\n   135\t      tempDir,\n   136\t    );\n   137\t\n   138\t    expect(output.mode).toBe(\"single\");\n   139\t    expect(output.totals.changed_sessions).toBe(1);\n   140\t\n   141\t    const target = await getSession(tempDir, targetId);\n   142\t    const other = await getSession(tempDir, otherId);\n   143\t    expect(target?.status).toBe(\"abandoned\");\n   144\t    expect(target?.close_reason?.startsWith(\"auto-abandoned:\")).toBe(true);\n   145\t    expect(other?.status).toBe(\"active\");\n   146\t  });\n   147\t\n   148\t  // AC: @session-stale-cleanup ac-3\n   149\t  // AC: @trait-semantic-exit-codes ac-1\n   150\t  // AC: @trait-semantic-exit-codes ac-5\n   151\t  it(\"returns success with zero changes when no sessions match stale criteria\", async () => {\n   152\t    const recentId = testUlid(\"SESS\", 4);\n   153\t    await createActiveSession(recentId, new Date().toISOString());\n   154\t\n   155\t    const output = kspecJson<SessionStaleCloseJson>(\n   156\t      `session stale close ${recentId} --older-than 24h --inactive-for 6h --force`,\n   157\t      tempDir,\n   158\t    );\n   159\t\n   160\t    expect(output.totals.candidates).toBe(0);\n   161\t    expect(output.totals.changed_sessions).toBe(0);\n   162\t    expect(output.sessions[0].status).toBe(\"not_candidate\");\n   163\t\n   164\t    const session = await getSession(tempDir, recentId);\n   165\t    expect(session?.status).toBe(\"active\");\n   166\t  });\n   167\t\n   168\t  // AC: @session-stale-cleanup ac-4\n   169\t  // AC: @session-stale-cleanup ac-5\n   170\t  it(\"reports all-mode totals for candidates, changed, skipped, and failures\", async () => {\n   171\t    const staleId = testUlid(\"SESS\", 5);\n   172\t    const freshId = testUlid(\"SESS\", 6);\n   173\t    const brokenId = testUlid(\"SESS\", 7);\n   174\t\n   175\t    await createActiveSession(\n   176\t      staleId,\n   177\t      \"2024-01-01T00:00:00.000Z\",\n   178\t      \"2024-01-02T00:00:00.000Z\",\n   179\t    );\n   180\t    await createActiveSession(freshId, new Date().toISOString());\n   181\t    await createActiveSession(\n   182\t      brokenId,\n   183\t      \"2024-01-01T00:00:00.000Z\",\n   184\t      undefined,\n   185\t    );\n   186\t    await fs.mkdir(getSessionEventsPath(tempDir, brokenId), { recursive: true });\n   187\t\n   188\t    const dryRun = kspecJson<SessionStaleCloseJson>(\n   189\t      \"session stale close --all --dry-run --older-than 24h --inactive-for 6h\",\n   190\t      tempDir,\n   191\t    );\n   192\t    expect(dryRun.totals.candidates).toBe(1);\n   193\t    expect(dryRun.totals.skipped_sessions).toBe(2);\n   194\t    expect(dryRun.totals.failures).toBe(1);\n   195\t\n   196\t    const apply = kspecJson<SessionStaleCloseJson>(\n   197\t      \"session stale close --all --older-than 24h --inactive-for 6h --force\",\n   198\t      tempDir,\n   199\t    );\n   200\t    expect(apply.totals.changed_sessions).toBe(1);\n   201\t    expect(apply.totals.candidates).toBe(1);\n   202\t\n   203\t    const stale = await getSession(tempDir, staleId);\n   204\t    const fresh = await getSession(tempDir, freshId);\n   205\t    const broken = await getSession(tempDir, brokenId);\n   206\t    expect(stale?.status).toBe(\"abandoned\");\n   207\t    expect(fresh?.status).toBe(\"active\");\n   208\t    expect(broken?.status).toBe(\"active\");\n   209\t  });\n   210\t\n   211\t  // AC: @session-stale-cleanup ac-6\n   212\t  // AC: @trait-semantic-exit-codes ac-6\n   213\t  it(\"errors when no target mode is provided\", async () => {\n   214\t    const result = kspec(\"session stale close\", tempDir, { expectFail: true });\n   215\t    expect(result.exitCode).toBe(2);\n   216\t    expect(result.stderr).toContain(\"Missing target\");\n   217\t    expect(result.stderr).toContain(\"<session-id>, --refs, or --all\");\n   218\t  });\n   219\t\n   220\t  // AC: @session-stale-cleanup ac-7\n   221\t  it(\"errors when positional target and --all are combined\", async () => {\n   222\t    const sessionId = testUlid(\"SESS\", 8);\n   223\t    await createActiveSession(sessionId, \"2024-01-01T00:00:00.000Z\");\n   224\t\n   225\t    const result = kspec(\n   226\t      `session stale close ${sessionId} --all`,\n   227\t      tempDir,\n   228\t      { expectFail: true },\n   229\t    );\n   230\t    expect(result.exitCode).toBe(2);\n   231\t    expect(result.stderr).toContain(\"Cannot use <session-id> together with --all\");\n   232\t  });\n   233\t\n   234\t  // AC: @session-stale-cleanup ac-8\n   235\t  // AC: @trait-multi-ref-batch ac-8\n   236\t  it(\"evaluates unique sessions only once in --refs mode\", async () => {\n   237\t    const staleId = testUlid(\"SESS\", 9);\n   238\t    const freshId = testUlid(\"SESS\", 10);\n   239\t    await createActiveSession(\n   240\t      staleId,\n   241\t      \"2024-01-01T00:00:00.000Z\",\n   242\t      \"2024-01-02T00:00:00.000Z\",\n   243\t    );\n   244\t    await createActiveSession(freshId, new Date().toISOString());\n   245\t\n   246\t    const output = kspecJson<SessionStaleCloseJson>(\n   247\t      `session stale close --refs ${staleId} ${staleId} ${freshId} --dry-run --older-than 24h --inactive-for 6h`,\n   248\t      tempDir,\n   249\t    );\n   250\t\n   251\t    const staleRows = output.sessions.filter((row) => row.session_id === staleId);\n   252\t    expect(staleRows).toHaveLength(1);\n   253\t    expect(output.totals.sessions_evaluated).toBe(2);\n   254\t  });\n   255\t\n   256\t  // AC: @session-stale-cleanup ac-9\n   257\t  // AC: @trait-multi-ref-batch ac-6\n   258\t  it(\"errors when --refs is combined with --all or positional target\", async () => {\n   259\t    const sessionId = testUlid(\"SESS\", 11);\n   260\t    await createActiveSession(sessionId, \"2024-01-01T00:00:00.000Z\");\n   261\t\n   262\t    const withAll = kspec(\n   263\t      `session stale close --refs ${sessionId} --all`,\n   264\t      tempDir,\n   265\t      { expectFail: true },\n   266\t    );\n   267\t    expect(withAll.exitCode).toBe(2);\n   268\t    expect(withAll.stderr).toContain(\"Cannot use --refs together with --all\");\n   269\t\n   270\t    const withPositional = kspec(\n   271\t      `session stale close ${sessionId} --refs ${sessionId}`,\n   272\t      tempDir,\n   273\t      { expectFail: true },\n   274\t    );\n   275\t    expect(withPositional.exitCode).toBe(2);\n   276\t    expect(withPositional.stderr).toContain(\"Cannot use <session-id> together with --refs\");\n   277\t  });\n   278\t\n   279\t  // AC: @trait-multi-ref-batch ac-2\n   280\t  // AC: @trait-multi-ref-batch ac-4\n   281\t  // AC: @trait-multi-ref-batch ac-7\n   282\t  // AC: @trait-error-guidance ac-1\n   283\t  // AC: @trait-error-guidance ac-2\n   284\t  // AC: @trait-error-guidance ac-6\n   285\t  it(\"continues refs batch after resolution errors and returns partial-failure exit\", async () => {\n   286\t    const staleId = testUlid(\"SESS\", 12);\n   287\t    await createActiveSession(\n   288\t      staleId,\n   289\t      \"2024-01-01T00:00:00.000Z\",\n   290\t      \"2024-01-02T00:00:00.000Z\",\n   291\t    );\n   292\t\n   293\t    const result = kspec(\n   294\t      `session stale close --refs ${staleId} BADREF --dry-run --older-than 24h --inactive-for 6h --json`,\n   295\t      tempDir,\n   296\t      { expectFail: true },\n   297\t    );\n   298\t    expect(result.exitCode).toBe(1);\n   299\t\n   300\t    const payload = JSON.parse(result.stdout) as SessionStaleCloseJson;\n   301\t    expect(payload.totals.candidates).toBe(1);\n   302\t    expect(payload.totals.failures).toBe(1);\n   303\t    expect(payload.sessions.some((row) => row.status === \"resolution_error\")).toBe(\n   304\t      true,\n   305\t    );\n   306\t  });\n   307\t\n   308\t  // AC: @trait-confirmation-prompt ac-1\n   309\t  // AC: @trait-confirmation-prompt ac-6\n   310\t  it(\"requires --force in non-interactive destructive mode\", async () => {\n   311\t    const staleId = testUlid(\"SESS\", 13);\n   312\t    await createActiveSession(\n   313\t      staleId,\n   314\t      \"2024-01-01T00:00:00.000Z\",\n   315\t      \"2024-01-02T00:00:00.000Z\",\n   316\t    );\n   317\t\n   318\t    const result = kspec(\n   319\t      `session stale close ${staleId} --older-than 24h --inactive-for 6h`,\n   320\t      tempDir,\n   321\t      { expectFail: true },\n   322\t    );\n   323\t    expect(result.exitCode).toBe(2);\n   324\t    expect(result.stderr).toContain(\"Non-interactive environment. Use --force to proceed\");\n   325\t  });\n   326\t\n   327\t  // AC: @trait-confirmation-prompt ac-3\n   328\t  // AC: @trait-semantic-exit-codes ac-3\n   329\t  it(\"returns cancellation exit when user declines interactive confirmation\", async () => {\n   330\t    const staleId = testUlid(\"SESS\", 14);\n   331\t    await createActiveSession(\n   332\t      staleId,\n   333\t      \"2024-01-01T00:00:00.000Z\",\n   334\t      \"2024-01-02T00:00:00.000Z\",\n   335\t    );\n   336\t\n   337\t    const result = kspec(\n   338\t      `session stale close ${staleId} --older-than 24h --inactive-for 6h`,\n   339\t      tempDir,\n   340\t      {\n   341\t        expectFail: true,\n   342\t        stdin: \"n\",\n   343\t        env: {\n   344\t          KSPEC_TEST_TTY: \"1\",\n   345\t        },\n   346\t      },\n   347\t    );\n   348\t\n   349\t    expect(result.exitCode).toBe(2);\n   350\t    expect(result.stderr).toContain(\"Operation cancelled\");\n   351\t  });\n   352\t\n   353\t  // AC: @trait-dry-run ac-5\n   354\t  // AC: @trait-confirmation-prompt ac-2\n   355\t  // AC: @trait-confirmation-prompt ac-5\n   356\t  // AC: @trait-json-output ac-4 -- N/A: session IDs are identifiers, not @ref-index references.\n   357\t  // AC: @trait-json-output ac-5 -- N/A: this command does not emit timestamps in top-level totals.\n   358\t  // AC: @trait-json-output ac-6 -- N/A: no competing output-format flags beyond global --json.\n   359\t  // AC: @trait-semantic-exit-codes ac-2 -- covered by usage-error validation tests above.\n   360\t  // AC: @trait-semantic-exit-codes ac-4 -- covered by malformed criteria and runtime exception path.\n   361\t  // AC: @trait-semantic-exit-codes ac-7 -- covered by refs partial-failure test above.\n   362\t  // AC: @trait-semantic-exit-codes ac-8 -- N/A: exit code constants documented centrally.\n   363\t  // AC: @trait-shadow-commit ac-1 -- covered via non-dry-run stale close mutation path.\n   364\t  // AC: @trait-shadow-commit ac-2 -- covered by command-specific shadowCommitMessage.\n   365\t  // AC: @trait-shadow-commit ac-3 -- N/A: no task/spec ULID ref in commit message contract for session IDs.\n   366\t  // AC: @trait-shadow-commit ac-4 -- covered by fixture mode with no shadow worktree.\n   367\t  // AC: @trait-shadow-commit ac-5 -- covered by applyAutoAbandonMetadata test suite.\n   368\t  // AC: @trait-shadow-commit ac-6 -- N/A in fixture mode without shadow remote.\n   369\t  // AC: @trait-shadow-commit ac-7 -- N/A in fixture mode without shadow remote.\n   370\t  // AC: @trait-shadow-commit ac-8 -- covered via single apply call/commit path for multi-session close.\n   371\t});\n","stderr":"","aggregated_output":"     1\t/**\n     2\t * Session stale close command tests.\n     3\t *\n     4\t * Task: @implement-stale-active-session-cleanup\n     5\t * Spec: @session-stale-cleanup\n     6\t */\n     7\t\n     8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     9\timport * as fs from \"node:fs/promises\";\n    10\timport {\n    11\t  appendEvent,\n    12\t  createSession,\n    13\t  getSession,\n    14\t  getSessionEventsPath,\n    15\t  updateSessionStatus,\n    16\t} from \"../src/sessions/store.js\";\n    17\timport {\n    18\t  cleanupTempDir,\n    19\t  kspec,\n    20\t  kspecJson,\n    21\t  setupTempFixtures,\n    22\t  testUlid,\n    23\t} from \"./helpers/cli.js\";\n    24\t\n    25\tinterface SessionStaleCloseJson {\n    26\t  dry_run: boolean;\n    27\t  mode: \"single\" | \"refs\" | \"all\";\n    28\t  criteria: {\n    29\t    older_than: string;\n    30\t    inactive_for: string;\n    31\t    liveness_guard: string;\n    32\t  };\n    33\t  sessions: Array<{\n    34\t    session_id: string;\n    35\t    status: string;\n    36\t    reason: string;\n    37\t    close_reason?: string;\n    38\t  }>;\n    39\t  totals: {\n    40\t    active_sessions_total: number;\n    41\t    sessions_evaluated: number;\n    42\t    candidates: number;\n    43\t    changed_sessions: number;\n    44\t    skipped_sessions: number;\n    45\t    failures: number;\n    46\t  };\n    47\t}\n    48\t\n    49\tdescribe(\"session stale close\", () => {\n    50\t  let tempDir: string;\n    51\t\n    52\t  beforeEach(async () => {\n    53\t    tempDir = await setupTempFixtures();\n    54\t  });\n    55\t\n    56\t  afterEach(async () => {\n    57\t    await cleanupTempDir(tempDir);\n    58\t  });\n    59\t\n    60\t  async function createActiveSession(\n    61\t    sessionId: string,\n    62\t    startedAt: string,\n    63\t    lastActivityAt?: string,\n    64\t  ): Promise<void> {\n    65\t    await createSession(tempDir, {\n    66\t      id: sessionId,\n    67\t      agent_type: \"test-agent\",\n    68\t      status: \"active\",\n    69\t      started_at: startedAt,\n    70\t    });\n    71\t\n    72\t    if (lastActivityAt) {\n    73\t      await appendEvent(tempDir, {\n    74\t        session_id: sessionId,\n    75\t        type: \"session.update\",\n    76\t        ts: new Date(lastActivityAt).getTime(),\n    77\t        data: { update: \"heartbeat\" },\n    78\t      });\n    79\t    }\n    80\t  }\n    81\t\n    82\t  // AC: @session-stale-cleanup ac-1\n    83\t  // AC: @trait-dry-run ac-1\n    84\t  // AC: @trait-dry-run ac-2\n    85\t  // AC: @trait-dry-run ac-3\n    86\t  // AC: @trait-dry-run ac-6\n    87\t  // AC: @trait-json-output ac-1\n    88\t  // AC: @trait-json-output ac-2\n    89\t  it(\"reports would-close sessions in --all --dry-run with per-session reasons\", async () => {\n    90\t    const staleId = testUlid(\"SESS\", 1);\n    91\t    await createActiveSession(\n    92\t      staleId,\n    93\t      \"2024-01-01T00:00:00.000Z\",\n    94\t      \"2024-01-02T00:00:00.000Z\",\n    95\t    );\n    96\t\n    97\t    const result = kspecJson<SessionStaleCloseJson>(\n    98\t      \"session stale close --all --dry-run --older-than 24h --inactive-for 6h\",\n    99\t      tempDir,\n   100\t    );\n   101\t\n   102\t    expect(result.mode).toBe(\"all\");\n   103\t    expect(result.dry_run).toBe(true);\n   104\t    expect(result.totals.candidates).toBe(1);\n   105\t    expect(result.totals.changed_sessions).toBe(0);\n   106\t    expect(result.sessions[0].status).toBe(\"would_abandon\");\n   107\t    expect(result.sessions[0].reason).toContain(\"dry run\");\n   108\t    expect(result.sessions[0].close_reason?.startsWith(\"auto-abandoned:\")).toBe(\n   109\t      true,\n   110\t    );\n   111\t\n   112\t    const unchanged = await getSession(tempDir, staleId);\n   113\t    expect(unchanged?.status).toBe(\"active\");\n   114\t    expect(unchanged?.ended_at).toBeUndefined();\n   115\t  });\n   116\t\n   117\t  // AC: @session-stale-cleanup ac-2\n   118\t  // AC: @trait-confirmation-prompt ac-4\n   119\t  it(\"closes only the targeted stale active session in single-target mode\", async () => {\n   120\t    const targetId = testUlid(\"SESS\", 2);\n   121\t    const otherId = testUlid(\"SESS\", 3);\n   122\t    await createActiveSession(\n   123\t      targetId,\n   124\t      \"2024-01-01T00:00:00.000Z\",\n   125\t      \"2024-01-02T00:00:00.000Z\",\n   126\t    );\n   127\t    await createActiveSession(\n   128\t      otherId,\n   129\t      \"2024-01-01T00:00:00.000Z\",\n   130\t      \"2024-01-02T00:00:00.000Z\",\n   131\t    );\n   132\t\n   133\t    const output = kspecJson<SessionStaleCloseJson>(\n   134\t      `session stale close ${targetId} --older-than 24h --inactive-for 6h --force`,\n   135\t      tempDir,\n   136\t    );\n   137\t\n   138\t    expect(output.mode).toBe(\"single\");\n   139\t    expect(output.totals.changed_sessions).toBe(1);\n   140\t\n   141\t    const target = await getSession(tempDir, targetId);\n   142\t    const other = await getSession(tempDir, otherId);\n   143\t    expect(target?.status).toBe(\"abandoned\");\n   144\t    expect(target?.close_reason?.startsWith(\"auto-abandoned:\")).toBe(true);\n   145\t    expect(other?.status).toBe(\"active\");\n   146\t  });\n   147\t\n   148\t  // AC: @session-stale-cleanup ac-3\n   149\t  // AC: @trait-semantic-exit-codes ac-1\n   150\t  // AC: @trait-semantic-exit-codes ac-5\n   151\t  it(\"returns success with zero changes when no sessions match stale criteria\", async () => {\n   152\t    const recentId = testUlid(\"SESS\", 4);\n   153\t    await createActiveSession(recentId, new Date().toISOString());\n   154\t\n   155\t    const output = kspecJson<SessionStaleCloseJson>(\n   156\t      `session stale close ${recentId} --older-than 24h --inactive-for 6h --force`,\n   157\t      tempDir,\n   158\t    );\n   159\t\n   160\t    expect(output.totals.candidates).toBe(0);\n   161\t    expect(output.totals.changed_sessions).toBe(0);\n   162\t    expect(output.sessions[0].status).toBe(\"not_candidate\");\n   163\t\n   164\t    const session = await getSession(tempDir, recentId);\n   165\t    expect(session?.status).toBe(\"active\");\n   166\t  });\n   167\t\n   168\t  // AC: @session-stale-cleanup ac-4\n   169\t  // AC: @session-stale-cleanup ac-5\n   170\t  it(\"reports all-mode totals for candidates, changed, skipped, and failures\", async () => {\n   171\t    const staleId = testUlid(\"SESS\", 5);\n   172\t    const freshId = testUlid(\"SESS\", 6);\n   173\t    const brokenId = testUlid(\"SESS\", 7);\n   174\t\n   175\t    await createActiveSession(\n   176\t      staleId,\n   177\t      \"2024-01-01T00:00:00.000Z\",\n   178\t      \"2024-01-02T00:00:00.000Z\",\n   179\t    );\n   180\t    await createActiveSession(freshId, new Date().toISOString());\n   181\t    await createActiveSession(\n   182\t      brokenId,\n   183\t      \"2024-01-01T00:00:00.000Z\",\n   184\t      undefined,\n   185\t    );\n   186\t    await fs.mkdir(getSessionEventsPath(tempDir, brokenId), { recursive: true });\n   187\t\n   188\t    const dryRun = kspecJson<SessionStaleCloseJson>(\n   189\t      \"session stale close --all --dry-run --older-than 24h --inactive-for 6h\",\n   190\t      tempDir,\n   191\t    );\n   192\t    expect(dryRun.totals.candidates).toBe(1);\n   193\t    expect(dryRun.totals.skipped_sessions).toBe(2);\n   194\t    expect(dryRun.totals.failures).toBe(1);\n   195\t\n   196\t    const apply = kspecJson<SessionStaleCloseJson>(\n   197\t      \"session stale close --all --older-than 24h --inactive-for 6h --force\",\n   198\t      tempDir,\n   199\t    );\n   200\t    expect(apply.totals.changed_sessions).toBe(1);\n   201\t    expect(apply.totals.candidates).toBe(1);\n   202\t\n   203\t    const stale = await getSession(tempDir, staleId);\n   204\t    const fresh = await getSession(tempDir, freshId);\n   205\t    const broken = await getSession(tempDir, brokenId);\n   206\t    expect(stale?.status).toBe(\"abandoned\");\n   207\t    expect(fresh?.status).toBe(\"active\");\n   208\t    expect(broken?.status).toBe(\"active\");\n   209\t  });\n   210\t\n   211\t  // AC: @session-stale-cleanup ac-6\n   212\t  // AC: @trait-semantic-exit-codes ac-6\n   213\t  it(\"errors when no target mode is provided\", async () => {\n   214\t    const result = kspec(\"session stale close\", tempDir, { expectFail: true });\n   215\t    expect(result.exitCode).toBe(2);\n   216\t    expect(result.stderr).toContain(\"Missing target\");\n   217\t    expect(result.stderr).toContain(\"<session-id>, --refs, or --all\");\n   218\t  });\n   219\t\n   220\t  // AC: @session-stale-cleanup ac-7\n   221\t  it(\"errors when positional target and --all are combined\", async () => {\n   222\t    const sessionId = testUlid(\"SESS\", 8);\n   223\t    await createActiveSession(sessionId, \"2024-01-01T00:00:00.000Z\");\n   224\t\n   225\t    const result = kspec(\n   226\t      `session stale close ${sessionId} --all`,\n   227\t      tempDir,\n   228\t      { expectFail: true },\n   229\t    );\n   230\t    expect(result.exitCode).toBe(2);\n   231\t    expect(result.stderr).toContain(\"Cannot use <session-id> together with --all\");\n   232\t  });\n   233\t\n   234\t  // AC: @session-stale-cleanup ac-8\n   235\t  // AC: @trait-multi-ref-batch ac-8\n   236\t  it(\"evaluates unique sessions only once in --refs mode\", async () => {\n   237\t    const staleId = testUlid(\"SESS\", 9);\n   238\t    const freshId = testUlid(\"SESS\", 10);\n   239\t    await createActiveSession(\n   240\t      staleId,\n   241\t      \"2024-01-01T00:00:00.000Z\",\n   242\t      \"2024-01-02T00:00:00.000Z\",\n   243\t    );\n   244\t    await createActiveSession(freshId, new Date().toISOString());\n   245\t\n   246\t    const output = kspecJson<SessionStaleCloseJson>(\n   247\t      `session stale close --refs ${staleId} ${staleId} ${freshId} --dry-run --older-than 24h --inactive-for 6h`,\n   248\t      tempDir,\n   249\t    );\n   250\t\n   251\t    const staleRows = output.sessions.filter((row) => row.session_id === staleId);\n   252\t    expect(staleRows).toHaveLength(1);\n   253\t    expect(output.totals.sessions_evaluated).toBe(2);\n   254\t  });\n   255\t\n   256\t  // AC: @session-stale-cleanup ac-9\n   257\t  // AC: @trait-multi-ref-batch ac-6\n   258\t  it(\"errors when --refs is combined with --all or positional target\", async () => {\n   259\t    const sessionId = testUlid(\"SESS\", 11);\n   260\t    await createActiveSession(sessionId, \"2024-01-01T00:00:00.000Z\");\n   261\t\n   262\t    const withAll = kspec(\n   263\t      `session stale close --refs ${sessionId} --all`,\n   264\t      tempDir,\n   265\t      { expectFail: true },\n   266\t    );\n   267\t    expect(withAll.exitCode).toBe(2);\n   268\t    expect(withAll.stderr).toContain(\"Cannot use --refs together with --all\");\n   269\t\n   270\t    const withPositional = kspec(\n   271\t      `session stale close ${sessionId} --refs ${sessionId}`,\n   272\t      tempDir,\n   273\t      { expectFail: true },\n   274\t    );\n   275\t    expect(withPositional.exitCode).toBe(2);\n   276\t    expect(withPositional.stderr).toContain(\"Cannot use <session-id> together with --refs\");\n   277\t  });\n   278\t\n   279\t  // AC: @trait-multi-ref-batch ac-2\n   280\t  // AC: @trait-multi-ref-batch ac-4\n   281\t  // AC: @trait-multi-ref-batch ac-7\n   282\t  // AC: @trait-error-guidance ac-1\n   283\t  // AC: @trait-error-guidance ac-2\n   284\t  // AC: @trait-error-guidance ac-6\n   285\t  it(\"continues refs batch after resolution errors and returns partial-failure exit\", async () => {\n   286\t    const staleId = testUlid(\"SESS\", 12);\n   287\t    await createActiveSession(\n   288\t      staleId,\n   289\t      \"2024-01-01T00:00:00.000Z\",\n   290\t      \"2024-01-02T00:00:00.000Z\",\n   291\t    );\n   292\t\n   293\t    const result = kspec(\n   294\t      `session stale close --refs ${staleId} BADREF --dry-run --older-than 24h --inactive-for 6h --json`,\n   295\t      tempDir,\n   296\t      { expectFail: true },\n   297\t    );\n   298\t    expect(result.exitCode).toBe(1);\n   299\t\n   300\t    const payload = JSON.parse(result.stdout) as SessionStaleCloseJson;\n   301\t    expect(payload.totals.candidates).toBe(1);\n   302\t    expect(payload.totals.failures).toBe(1);\n   303\t    expect(payload.sessions.some((row) => row.status === \"resolution_error\")).toBe(\n   304\t      true,\n   305\t    );\n   306\t  });\n   307\t\n   308\t  // AC: @trait-confirmation-prompt ac-1\n   309\t  // AC: @trait-confirmation-prompt ac-6\n   310\t  it(\"requires --force in non-interactive destructive mode\", async () => {\n   311\t    const staleId = testUlid(\"SESS\", 13);\n   312\t    await createActiveSession(\n   313\t      staleId,\n   314\t      \"2024-01-01T00:00:00.000Z\",\n   315\t      \"2024-01-02T00:00:00.000Z\",\n   316\t    );\n   317\t\n   318\t    const result = kspec(\n   319\t      `session stale close ${staleId} --older-than 24h --inactive-for 6h`,\n   320\t      tempDir,\n   321\t      { expectFail: true },\n   322\t    );\n   323\t    expect(result.exitCode).toBe(2);\n   324\t    expect(result.stderr).toContain(\"Non-interactive environment. Use --force to proceed\");\n   325\t  });\n   326\t\n   327\t  // AC: @trait-confirmation-prompt ac-3\n   328\t  // AC: @trait-semantic-exit-codes ac-3\n   329\t  it(\"returns cancellation exit when user declines interactive confirmation\", async () => {\n   330\t    const staleId = testUlid(\"SESS\", 14);\n   331\t    await createActiveSession(\n   332\t      staleId,\n   333\t      \"2024-01-01T00:00:00.000Z\",\n   334\t      \"2024-01-02T00:00:00.000Z\",\n   335\t    );\n   336\t\n   337\t    const result = kspec(\n   338\t      `session stale close ${staleId} --older-than 24h --inactive-for 6h`,\n   339\t      tempDir,\n   340\t      {\n   341\t        expectFail: true,\n   342\t        stdin: \"n\",\n   343\t        env: {\n   344\t          KSPEC_TEST_TTY: \"1\",\n   345\t        },\n   346\t      },\n   347\t    );\n   348\t\n   349\t    expect(result.exitCode).toBe(2);\n   350\t    expect(result.stderr).toContain(\"Operation cancelled\");\n   351\t  });\n   352\t\n   353\t  // AC: @trait-dry-run ac-5\n   354\t  // AC: @trait-confirmation-prompt ac-2\n   355\t  // AC: @trait-confirmation-prompt ac-5\n   356\t  // AC: @trait-json-output ac-4 -- N/A: session IDs are identifiers, not @ref-index references.\n   357\t  // AC: @trait-json-output ac-5 -- N/A: this command does not emit timestamps in top-level totals.\n   358\t  // AC: @trait-json-output ac-6 -- N/A: no competing output-format flags beyond global --json.\n   359\t  // AC: @trait-semantic-exit-codes ac-2 -- covered by usage-error validation tests above.\n   360\t  // AC: @trait-semantic-exit-codes ac-4 -- covered by malformed criteria and runtime exception path.\n   361\t  // AC: @trait-semantic-exit-codes ac-7 -- covered by refs partial-failure test above.\n   362\t  // AC: @trait-semantic-exit-codes ac-8 -- N/A: exit code constants documented centrally.\n   363\t  // AC: @trait-shadow-commit ac-1 -- covered via non-dry-run stale close mutation path.\n   364\t  // AC: @trait-shadow-commit ac-2 -- covered by command-specific shadowCommitMessage.\n   365\t  // AC: @trait-shadow-commit ac-3 -- N/A: no task/spec ULID ref in commit message contract for session IDs.\n   366\t  // AC: @trait-shadow-commit ac-4 -- covered by fixture mode with no shadow worktree.\n   367\t  // AC: @trait-shadow-commit ac-5 -- covered by applyAutoAbandonMetadata test suite.\n   368\t  // AC: @trait-shadow-commit ac-6 -- N/A in fixture mode without shadow remote.\n   369\t  // AC: @trait-shadow-commit ac-7 -- N/A in fixture mode without shadow remote.\n   370\t  // AC: @trait-shadow-commit ac-8 -- covered via single apply call/commit path for multi-session close.\n   371\t});\n","exit_code":0,"duration":{"secs":0,"nanos":51167769},"formatted_output":"     1\t/**\n     2\t * Session stale close command tests.\n     3\t *\n     4\t * Task: @implement-stale-active-session-cleanup\n     5\t * Spec: @session-stale-cleanup\n     6\t */\n     7\t\n     8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     9\timport * as fs from \"node:fs/promises\";\n    10\timport {\n    11\t  appendEvent,\n    12\t  createSession,\n    13\t  getSession,\n    14\t  getSessionEventsPath,\n    15\t  updateSessionStatus,\n    16\t} from \"../src/sessions/store.js\";\n    17\timport {\n    18\t  cleanupTempDir,\n    19\t  kspec,\n    20\t  kspecJson,\n    21\t  setupTempFixtures,\n    22\t  testUlid,\n    23\t} from \"./helpers/cli.js\";\n    24\t\n    25\tinterface SessionStaleCloseJson {\n    26\t  dry_run: boolean;\n    27\t  mode: \"single\" | \"refs\" | \"all\";\n    28\t  criteria: {\n    29\t    older_than: string;\n    30\t    inactive_for: string;\n    31\t    liveness_guard: string;\n    32\t  };\n    33\t  sessions: Array<{\n    34\t    session_id: string;\n    35\t    status: string;\n    36\t    reason: string;\n    37\t    close_reason?: string;\n    38\t  }>;\n    39\t  totals: {\n    40\t    active_sessions_total: number;\n    41\t    sessions_evaluated: number;\n    42\t    candidates: number;\n    43\t    changed_sessions: number;\n    44\t    skipped_sessions: number;\n    45\t    failures: number;\n    46\t  };\n    47\t}\n    48\t\n    49\tdescribe(\"session stale close\", () => {\n    50\t  let tempDir: string;\n    51\t\n    52\t  beforeEach(async () => {\n    53\t    tempDir = await setupTempFixtures();\n    54\t  });\n    55\t\n    56\t  afterEach(async () => {\n    57\t    await cleanupTempDir(tempDir);\n    58\t  });\n    59\t\n    60\t  async function createActiveSession(\n    61\t    sessionId: string,\n    62\t    startedAt: string,\n    63\t    lastActivityAt?: string,\n    64\t  ): Promise<void> {\n    65\t    await createSession(tempDir, {\n    66\t      id: sessionId,\n    67\t      agent_type: \"test-agent\",\n    68\t      status: \"active\",\n    69\t      started_at: startedAt,\n    70\t    });\n    71\t\n    72\t    if (lastActivityAt) {\n    73\t      await appendEvent(tempDir, {\n    74\t        session_id: sessionId,\n    75\t        type: \"session.update\",\n    76\t        ts: new Date(lastActivityAt).getTime(),\n    77\t        data: { update: \"heartbeat\" },\n    78\t      });\n    79\t    }\n    80\t  }\n    81\t\n    82\t  // AC: @session-stale-cleanup ac-1\n    83\t  // AC: @trait-dry-run ac-1\n    84\t  // AC: @trait-dry-run ac-2\n    85\t  // AC: @trait-dry-run ac-3\n    86\t  // AC: @trait-dry-run ac-6\n    87\t  // AC: @trait-json-output ac-1\n    88\t  // AC: @trait-json-output ac-2\n    89\t  it(\"reports would-close sessions in --all --dry-run with per-session reasons\", async () => {\n    90\t    const staleId = testUlid(\"SESS\", 1);\n    91\t    await createActiveSession(\n    92\t      staleId,\n    93\t      \"2024-01-01T00:00:00.000Z\",\n    94\t      \"2024-01-02T00:00:00.000Z\",\n    95\t    );\n    96\t\n    97\t    const result = kspecJson<SessionStaleCloseJson>(\n    98\t      \"session stale close --all --dry-run --older-than 24h --inactive-for 6h\",\n    99\t      tempDir,\n   100\t    );\n   101\t\n   102\t    expect(result.mode).toBe(\"all\");\n   103\t    expect(result.dry_run).toBe(true);\n   104\t    expect(result.totals.candidates).toBe(1);\n   105\t    expect(result.totals.changed_sessions).toBe(0);\n   106\t    expect(result.sessions[0].status).toBe(\"would_abandon\");\n   107\t    expect(result.sessions[0].reason).toContain(\"dry run\");\n   108\t    expect(result.sessions[0].close_reason?.startsWith(\"auto-abandoned:\")).toBe(\n   109\t      true,\n   110\t    );\n   111\t\n   112\t    const unchanged = await getSession(tempDir, staleId);\n   113\t    expect(unchanged?.status).toBe(\"active\");\n   114\t    expect(unchanged?.ended_at).toBeUndefined();\n   115\t  });\n   116\t\n   117\t  // AC: @session-stale-cleanup ac-2\n   118\t  // AC: @trait-confirmation-prompt ac-4\n   119\t  it(\"closes only the targeted stale active session in single-target mode\", async () => {\n   120\t    const targetId = testUlid(\"SESS\", 2);\n   121\t    const otherId = testUlid(\"SESS\", 3);\n   122\t    await createActiveSession(\n   123\t      targetId,\n   124\t      \"2024-01-01T00:00:00.000Z\",\n   125\t      \"2024-01-02T00:00:00.000Z\",\n   126\t    );\n   127\t    await createActiveSession(\n   128\t      otherId,\n   129\t      \"2024-01-01T00:00:00.000Z\",\n   130\t      \"2024-01-02T00:00:00.000Z\",\n   131\t    );\n   132\t\n   133\t    const output = kspecJson<SessionStaleCloseJson>(\n   134\t      `session stale close ${targetId} --older-than 24h --inactive-for 6h --force`,\n   135\t      tempDir,\n   136\t    );\n   137\t\n   138\t    expect(output.mode).toBe(\"single\");\n   139\t    expect(output.totals.changed_sessions).toBe(1);\n   140\t\n   141\t    const target = await getSession(tempDir, targetId);\n   142\t    const other = await getSession(tempDir, otherId);\n   143\t    expect(target?.status).toBe(\"abandoned\");\n   144\t    expect(target?.close_reason?.startsWith(\"auto-abandoned:\")).toBe(true);\n   145\t    expect(other?.status).toBe(\"active\");\n   146\t  });\n   147\t\n   148\t  // AC: @session-stale-cleanup ac-3\n   149\t  // AC: @trait-semantic-exit-codes ac-1\n   150\t  // AC: @trait-semantic-exit-codes ac-5\n   151\t  it(\"returns success with zero changes when no sessions match stale criteria\", async () => {\n   152\t    const recentId = testUlid(\"SESS\", 4);\n   153\t    await createActiveSession(recentId, new Date().toISOString());\n   154\t\n   155\t    const output = kspecJson<SessionStaleCloseJson>(\n   156\t      `session stale close ${recentId} --older-than 24h --inactive-for 6h --force`,\n   157\t      tempDir,\n   158\t    );\n   159\t\n   160\t    expect(output.totals.candidates).toBe(0);\n   161\t    expect(output.totals.changed_sessions).toBe(0);\n   162\t    expect(output.sessions[0].status).toBe(\"not_candidate\");\n   163\t\n   164\t    const session = await getSession(tempDir, recentId);\n   165\t    expect(session?.status).toBe(\"active\");\n   166\t  });\n   167\t\n   168\t  // AC: @session-stale-cleanup ac-4\n   169\t  // AC: @session-stale-cleanup ac-5\n   170\t  it(\"reports all-mode totals for candidates, changed, skipped, and failures\", async () => {\n   171\t    const staleId = testUlid(\"SESS\", 5);\n   172\t    const freshId = testUlid(\"SESS\", 6);\n   173\t    const brokenId = testUlid(\"SESS\", 7);\n   174\t\n   175\t    await createActiveSession(\n   176\t      staleId,\n   177\t      \"2024-01-01T00:00:00.000Z\",\n   178\t      \"2024-01-02T00:00:00.000Z\",\n   179\t    );\n   180\t    await createActiveSession(freshId, new Date().toISOString());\n   181\t    await createActiveSession(\n   182\t      brokenId,\n   183\t      \"2024-01-01T00:00:00.000Z\",\n   184\t      undefined,\n   185\t    );\n   186\t    await fs.mkdir(getSessionEventsPath(tempDir, brokenId), { recursive: true });\n   187\t\n   188\t    const dryRun = kspecJson<SessionStaleCloseJson>(\n   189\t      \"session stale close --all --dry-run --older-than 24h --inactive-for 6h\",\n   190\t      tempDir,\n   191\t    );\n   192\t    expect(dryRun.totals.candidates).toBe(1);\n   193\t    expect(dryRun.totals.skipped_sessions).toBe(2);\n   194\t    expect(dryRun.totals.failures).toBe(1);\n   195\t\n   196\t    const apply = kspecJson<SessionStaleCloseJson>(\n   197\t      \"session stale close --all --older-than 24h --inactive-for 6h --force\",\n   198\t      tempDir,\n   199\t    );\n   200\t    expect(apply.totals.changed_sessions).toBe(1);\n   201\t    expect(apply.totals.candidates).toBe(1);\n   202\t\n   203\t    const stale = await getSession(tempDir, staleId);\n   204\t    const fresh = await getSession(tempDir, freshId);\n   205\t    const broken = await getSession(tempDir, brokenId);\n   206\t    expect(stale?.status).toBe(\"abandoned\");\n   207\t    expect(fresh?.status).toBe(\"active\");\n   208\t    expect(broken?.status).toBe(\"active\");\n   209\t  });\n   210\t\n   211\t  // AC: @session-stale-cleanup ac-6\n   212\t  // AC: @trait-semantic-exit-codes ac-6\n   213\t  it(\"errors when no target mode is provided\", async () => {\n   214\t    const result = kspec(\"session stale close\", tempDir, { expectFail: true });\n   215\t    expect(result.exitCode).toBe(2);\n   216\t    expect(result.stderr).toContain(\"Missing target\");\n   217\t    expect(result.stderr).toContain(\"<session-id>, --refs, or --all\");\n   218\t  });\n   219\t\n   220\t  // AC: @session-stale-cleanup ac-7\n   221\t  it(\"errors when positional target and --all are combined\", async () => {\n   222\t    const sessionId = testUlid(\"SESS\", 8);\n   223\t    await createActiveSession(sessionId, \"2024-01-01T00:00:00.000Z\");\n   224\t\n   225\t    const result = kspec(\n   226\t      `session stale close ${sessionId} --all`,\n   227\t      tempDir,\n   228\t      { expectFail: true },\n   229\t    );\n   230\t    expect(result.exitCode).toBe(2);\n   231\t    expect(result.stderr).toContain(\"Cannot use <session-id> together with --all\");\n   232\t  });\n   233\t\n   234\t  // AC: @session-stale-cleanup ac-8\n   235\t  // AC: @trait-multi-ref-batch ac-8\n   236\t  it(\"evaluates unique sessions only once in --refs mode\", async () => {\n   237\t    const staleId = testUlid(\"SESS\", 9);\n   238\t    const freshId = testUlid(\"SESS\", 10);\n   239\t    await createActiveSession(\n   240\t      staleId,\n   241\t      \"2024-01-01T00:00:00.000Z\",\n   242\t      \"2024-01-02T00:00:00.000Z\",\n   243\t    );\n   244\t    await createActiveSession(freshId, new Date().toISOString());\n   245\t\n   246\t    const output = kspecJson<SessionStaleCloseJson>(\n   247\t      `session stale close --refs ${staleId} ${staleId} ${freshId} --dry-run --older-than 24h --inactive-for 6h`,\n   248\t      tempDir,\n   249\t    );\n   250\t\n   251\t    const staleRows = output.sessions.filter((row) => row.session_id === staleId);\n   252\t    expect(staleRows).toHaveLength(1);\n   253\t    expect(output.totals.sessions_evaluated).toBe(2);\n   254\t  });\n   255\t\n   256\t  // AC: @session-stale-cleanup ac-9\n   257\t  // AC: @trait-multi-ref-batch ac-6\n   258\t  it(\"errors when --refs is combined with --all or positional target\", async () => {\n   259\t    const sessionId = testUlid(\"SESS\", 11);\n   260\t    await createActiveSession(sessionId, \"2024-01-01T00:00:00.000Z\");\n   261\t\n   262\t    const withAll = kspec(\n   263\t      `session stale close --refs ${sessionId} --all`,\n   264\t      tempDir,\n   265\t      { expectFail: true },\n   266\t    );\n   267\t    expect(withAll.exitCode).toBe(2);\n   268\t    expect(withAll.stderr).toContain(\"Cannot use --refs together with --all\");\n   269\t\n   270\t    const withPositional = kspec(\n   271\t      `session stale close ${sessionId} --refs ${sessionId}`,\n   272\t      tempDir,\n   273\t      { expectFail: true },\n   274\t    );\n   275\t    expect(withPositional.exitCode).toBe(2);\n   276\t    expect(withPositional.stderr).toContain(\"Cannot use <session-id> together with --refs\");\n   277\t  });\n   278\t\n   279\t  // AC: @trait-multi-ref-batch ac-2\n   280\t  // AC: @trait-multi-ref-batch ac-4\n   281\t  // AC: @trait-multi-ref-batch ac-7\n   282\t  // AC: @trait-error-guidance ac-1\n   283\t  // AC: @trait-error-guidance ac-2\n   284\t  // AC: @trait-error-guidance ac-6\n   285\t  it(\"continues refs batch after resolution errors and returns partial-failure exit\", async () => {\n   286\t    const staleId = testUlid(\"SESS\", 12);\n   287\t    await createActiveSession(\n   288\t      staleId,\n   289\t      \"2024-01-01T00:00:00.000Z\",\n   290\t      \"2024-01-02T00:00:00.000Z\",\n   291\t    );\n   292\t\n   293\t    const result = kspec(\n   294\t      `session stale close --refs ${staleId} BADREF --dry-run --older-than 24h --inactive-for 6h --json`,\n   295\t      tempDir,\n   296\t      { expectFail: true },\n   297\t    );\n   298\t    expect(result.exitCode).toBe(1);\n   299\t\n   300\t    const payload = JSON.parse(result.stdout) as SessionStaleCloseJson;\n   301\t    expect(payload.totals.candidates).toBe(1);\n   302\t    expect(payload.totals.failures).toBe(1);\n   303\t    expect(payload.sessions.some((row) => row.status === \"resolution_error\")).toBe(\n   304\t      true,\n   305\t    );\n   306\t  });\n   307\t\n   308\t  // AC: @trait-confirmation-prompt ac-1\n   309\t  // AC: @trait-confirmation-prompt ac-6\n   310\t  it(\"requires --force in non-interactive destructive mode\", async () => {\n   311\t    const staleId = testUlid(\"SESS\", 13);\n   312\t    await createActiveSession(\n   313\t      staleId,\n   314\t      \"2024-01-01T00:00:00.000Z\",\n   315\t      \"2024-01-02T00:00:00.000Z\",\n   316\t    );\n   317\t\n   318\t    const result = kspec(\n   319\t      `session stale close ${staleId} --older-than 24h --inactive-for 6h`,\n   320\t      tempDir,\n   321\t      { expectFail: true },\n   322\t    );\n   323\t    expect(result.exitCode).toBe(2);\n   324\t    expect(result.stderr).toContain(\"Non-interactive environment. Use --force to proceed\");\n   325\t  });\n   326\t\n   327\t  // AC: @trait-confirmation-prompt ac-3\n   328\t  // AC: @trait-semantic-exit-codes ac-3\n   329\t  it(\"returns cancellation exit when user declines interactive confirmation\", async () => {\n   330\t    const staleId = testUlid(\"SESS\", 14);\n   331\t    await createActiveSession(\n   332\t      staleId,\n   333\t      \"2024-01-01T00:00:00.000Z\",\n   334\t      \"2024-01-02T00:00:00.000Z\",\n   335\t    );\n   336\t\n   337\t    const result = kspec(\n   338\t      `session stale close ${staleId} --older-than 24h --inactive-for 6h`,\n   339\t      tempDir,\n   340\t      {\n   341\t        expectFail: true,\n   342\t        stdin: \"n\",\n   343\t        env: {\n   344\t          KSPEC_TEST_TTY: \"1\",\n   345\t        },\n   346\t      },\n   347\t    );\n   348\t\n   349\t    expect(result.exitCode).toBe(2);\n   350\t    expect(result.stderr).toContain(\"Operation cancelled\");\n   351\t  });\n   352\t\n   353\t  // AC: @trait-dry-run ac-5\n   354\t  // AC: @trait-confirmation-prompt ac-2\n   355\t  // AC: @trait-confirmation-prompt ac-5\n   356\t  // AC: @trait-json-output ac-4 -- N/A: session IDs are identifiers, not @ref-index references.\n   357\t  // AC: @trait-json-output ac-5 -- N/A: this command does not emit timestamps in top-level totals.\n   358\t  // AC: @trait-json-output ac-6 -- N/A: no competing output-format flags beyond global --json.\n   359\t  // AC: @trait-semantic-exit-codes ac-2 -- covered by usage-error validation tests above.\n   360\t  // AC: @trait-semantic-exit-codes ac-4 -- covered by malformed criteria and runtime exception path.\n   361\t  // AC: @trait-semantic-exit-codes ac-7 -- covered by refs partial-failure test above.\n   362\t  // AC: @trait-semantic-exit-codes ac-8 -- N/A: exit code constants documented centrally.\n   363\t  // AC: @trait-shadow-commit ac-1 -- covered via non-dry-run stale close mutation path.\n   364\t  // AC: @trait-shadow-commit ac-2 -- covered by command-specific shadowCommitMessage.\n   365\t  // AC: @trait-shadow-commit ac-3 -- N/A: no task/spec ULID ref in commit message contract for session IDs.\n   366\t  // AC: @trait-shadow-commit ac-4 -- covered by fixture mode with no shadow worktree.\n   367\t  // AC: @trait-shadow-commit ac-5 -- covered by applyAutoAbandonMetadata test suite.\n   368\t  // AC: @trait-shadow-commit ac-6 -- N/A in fixture mode without shadow remote.\n   369\t  // AC: @trait-shadow-commit ac-7 -- N/A in fixture mode without shadow remote.\n   370\t  // AC: @trait-shadow-commit ac-8 -- covered via single apply call/commit path for multi-session close.\n   371\t});\n","status":"completed"}