\n   135\t  describe('starvation prevention with cap', () => {\n   136\t    it('should still include notes from all status buckets when capped', { timeout: 30000 }, () => {\n   137\t      // With --limit 6 and notes in all 3 statuses, each status should be represented.\n   138\t      // ceil(6/3) = 2 per bucket, so each status gets up to 2 notes.\n   139\t\n   140\t      // Create 3 in_progress notes\n   141\t      for (let i = 1; i <= 3; i++) {\n   142\t        kspec(`task add --title \"Active ${i}\" --slug active-${i}`, tempDir);\n   143\t        kspec(`task start @active-${i}`, tempDir);\n   144\t        kspec(`task note @active-${i} \"Active note ${i}\"`, tempDir);\n   145\t      }\n   146\t\n   147\t      // Create 1 pending_review note\n   148\t      kspec('task add --title \"Review task\" --slug review-task', tempDir);\n   149\t      kspec('task start @review-task', tempDir);\n   150\t      kspec('task note @review-task \"Review note\"', tempDir);\n   151\t      kspec('task submit @review-task', tempDir);\n   152\t\n   153\t      // Create 1 completed note\n   154\t      kspec('task add --title \"Done task\" --slug done-task', tempDir);\n   155\t      kspec('task start @done-task', tempDir);\n   156\t      kspec('task note @done-task \"Done note\"', tempDir);\n   157\t      kspec('task submit @done-task', tempDir);\n   158\t      kspec('task complete @done-task --reason \"Finished\"', tempDir);\n   159\t\n   160\t      const session = kspecJson<SessionContext>('session start --json --limit 6', tempDir);\n   161\t\n   162\t      // Total capped at 6\n   163\t      expect(session.recent_notes!.length).toBeLessThanOrEqual(6);\n   164\t\n   165\t      // Each status should be represented (starvation prevention still works)\n   166\t      const statuses = new Set(session.recent_notes!.map((n) => n.task_status));\n   167\t      expect(statuses.has('in_progress')).toBe(true);\n   168\t      expect(statuses.has('pending_review')).toBe(true);\n   169\t      expect(statuses.has('completed')).toBe(true);\n   170\t    });\n   171\t  });\n   172\t});\n","exit_code":0,"duration":{"secs":0,"nanos":51300776},"formatted_output":"     1\t/**\n     2\t * Tests for note limit behavior in gatherSessionContext.\n     3\t *\n     4\t * Verifies that:\n     5\t * - Non-full mode caps total notes at --limit (not 3x limit)\n     6\t * - Full mode uncaps notes (consistent with other sections)\n     7\t * - Per-status starvation prevention still works with the cap\n     8\t */\n     9\timport { describe, it, expect, beforeEach, afterEach } from 'vitest';\n    10\timport {\n    11\t  kspec,\n    12\t  kspecJson,\n    13\t  createTempDir,\n    14\t  initGitRepo,\n    15\t  cleanupTempDir,\n    16\t} from '../helpers/cli';\n    17\timport type { SessionContext } from '../helpers/session-types';\n    18\t\n    19\tdescribe('session start note limit behavior', () => {\n    20\t  let tempDir: string;\n    21\t\n    22\t  beforeEach(async () => {\n    23\t    // Use clean environment to avoid fixture notes contaminating counts\n    24\t    tempDir = await createTempDir('kspec-note-limit-');\n    25\t    initGitRepo(tempDir);\n    26\t    kspec('init', tempDir);\n    27\t  });\n    28\t\n    29\t  afterEach(async () => {\n    30\t    await cleanupTempDir(tempDir);\n    31\t  });\n    32\t\n    33\t  describe('non-full mode total cap', () => {\n    34\t    it('should cap total notes at --limit value', { timeout: 30000 }, () => {\n    35\t      // Create tasks across all 3 status buckets with many notes each.\n    36\t      // With --limit 3, each bucket gets ceil(3/3) = 1 per-status,\n    37\t      // and total should be capped at 3 after concatenation.\n    38\t\n    39\t      // in_progress tasks with notes\n    40\t      for (let i = 1; i <= 3; i++) {\n    41\t        kspec(`task add --title \"Active ${i}\" --slug active-${i}`, tempDir);\n    42\t        kspec(`task start @active-${i}`, tempDir);\n    43\t        kspec(`task note @active-${i} \"Active note ${i}\"`, tempDir);\n    44\t      }\n    45\t\n    46\t      // pending_review tasks with notes\n    47\t      for (let i = 1; i <= 3; i++) {\n    48\t        kspec(`task add --title \"Review ${i}\" --slug review-${i}`, tempDir);\n    49\t        kspec(`task start @review-${i}`, tempDir);\n    50\t        kspec(`task note @review-${i} \"Review note ${i}\"`, tempDir);\n    51\t        kspec(`task submit @review-${i}`, tempDir);\n    52\t      }\n    53\t\n    54\t      // completed tasks with notes\n    55\t      for (let i = 1; i <= 3; i++) {\n    56\t        kspec(`task add --title \"Done ${i}\" --slug done-${i}`, tempDir);\n    57\t        kspec(`task start @done-${i}`, tempDir);\n    58\t        kspec(`task note @done-${i} \"Done note ${i}\"`, tempDir);\n    59\t        kspec(`task submit @done-${i}`, tempDir);\n    60\t        kspec(`task complete @done-${i} --reason \"Finished ${i}\"`, tempDir);\n    61\t      }\n    62\t\n    63\t      // With --limit 3, total notes should not exceed 3\n    64\t      const session = kspecJson<SessionContext>('session start --json --limit 3', tempDir);\n    65\t\n    66\t      expect(session.recent_notes!.length).toBeLessThanOrEqual(3);\n    67\t      expect(session.recent_notes!.length).toBeGreaterThan(0);\n    68\t    });\n    69\t\n    70\t    it('should not exceed limit even with ceil rounding across 3 buckets', { timeout: 30000 }, () => {\n    71\t      // --limit 4: ceil(4/3) = 2 per bucket = up to 6 without final cap.\n    72\t      // With fix, total should be capped at 4.\n    73\t\n    74\t      for (let i = 1; i <= 2; i++) {\n    75\t        kspec(`task add --title \"Active ${i}\" --slug act-${i}`, tempDir);\n    76\t        kspec(`task start @act-${i}`, tempDir);\n    77\t        kspec(`task note @act-${i} \"Active note ${i}\"`, tempDir);\n    78\t      }\n    79\t\n    80\t      for (let i = 1; i <= 2; i++) {\n    81\t        kspec(`task add --title \"Review ${i}\" --slug rev-${i}`, tempDir);\n    82\t        kspec(`task start @rev-${i}`, tempDir);\n    83\t        kspec(`task note @rev-${i} \"Review note ${i}\"`, tempDir);\n    84\t        kspec(`task submit @rev-${i}`, tempDir);\n    85\t      }\n    86\t\n    87\t      for (let i = 1; i <= 2; i++) {\n    88\t        kspec(`task add --title \"Done ${i}\" --slug dn-${i}`, tempDir);\n    89\t        kspec(`task start @dn-${i}`, tempDir);\n    90\t        kspec(`task note @dn-${i} \"Done note ${i}\"`, tempDir);\n    91\t        kspec(`task submit @dn-${i}`, tempDir);\n    92\t        kspec(`task complete @dn-${i} --reason \"Finished ${i}\"`, tempDir);\n    93\t      }\n    94\t\n    95\t      const session = kspecJson<SessionContext>('session start --json --limit 4', tempDir);\n    96\t\n    97\t      // Total notes should not exceed the limit (4), not 3*ceil(4/3) = 6\n    98\t      expect(session.recent_notes!.length).toBeLessThanOrEqual(4);\n    99\t      expect(session.recent_notes!.length).toBeGreaterThan(0);\n   100\t    });\n   101\t  });\n   102\t\n   103\t  describe('full mode uncap', () => {\n   104\t    it('should allow more notes than default limit in full mode', { timeout: 30000 }, () => {\n   105\t      // Create many notes across multiple statuses.\n   106\t      // Full mode should return all notes without artificial cap.\n   107\t\n   108\t      for (let i = 1; i <= 5; i++) {\n   109\t        kspec(`task add --title \"Active ${i}\" --slug active-${i}`, tempDir);\n   110\t        kspec(`task start @active-${i}`, tempDir);\n   111\t        kspec(`task note @active-${i} \"Active note A${i}\"`, tempDir);\n   112\t        kspec(`task note @active-${i} \"Active note B${i}\"`, tempDir);\n   113\t      }\n   114\t\n   115\t      for (let i = 1; i <= 5; i++) {\n   116\t        kspec(`task add --title \"Done ${i}\" --slug done-${i}`, tempDir);\n   117\t        kspec(`task start @done-${i}`, tempDir);\n   118\t        kspec(`task note @done-${i} \"Done note A${i}\"`, tempDir);\n   119\t        kspec(`task note @done-${i} \"Done note B${i}\"`, tempDir);\n   120\t        kspec(`task submit @done-${i}`, tempDir);\n   121\t        kspec(`task complete @done-${i} --reason \"Finished ${i}\"`, tempDir);\n   122\t      }\n   123\t\n   124\t      // Full mode: should not artificially cap notes\n   125\t      const fullSession = kspecJson<SessionContext>('session start --json --full', tempDir);\n   126\t      // Non-full with --limit 3: should cap at 3\n   127\t      const limitedSession = kspecJson<SessionContext>('session start --json --limit 3', tempDir);\n   128\t\n   129\t      // Full mode should have more notes than the limited mode\n   130\t      expect(fullSession.recent_notes!.length).toBeGreaterThan(limitedSession.recent_notes!.length);\n   131\t      expect(limitedSession.recent_notes!.length).toBeLessThanOrEqual(3);\n   132\t    });\n   133\t  });\n   134\t\n   135\t  describe('starvation prevention with cap', () => {\n   136\t    it('should still include notes from all status buckets when capped', { timeout: 30000 }, () => {\n   137\t      // With --limit 6 and notes in all 3 statuses, each status should be represented.\n   138\t      // ceil(6/3) = 2 per bucket, so each status gets up to 2 notes.\n   139\t\n   140\t      // Create 3 in_progress notes\n   141\t      for (let i = 1; i <= 3; i++) {\n   142\t        kspec(`task add --title \"Active ${i}\" --slug active-${i}`, tempDir);\n   143\t        kspec(`task start @active-${i}`, tempDir);\n   144\t        kspec(`task note @active-${i} \"Active note ${i}\"`, tempDir);\n   145\t      }\n   146\t\n   147\t      // Create 1 pending_review note\n   148\t      kspec('task add --title \"Review task\" --slug review-task', tempDir);\n   149\t      kspec('task start @review-task', tempDir);\n   150\t      kspec('task note @review-task \"Review note\"', tempDir);\n   151\t      kspec('task submit @review-task', tempDir);\n   152\t\n   153\t      // Create 1 completed note\n   154\t      kspec('task add --title \"Done task\" --slug done-task', tempDir);\n   155\t      kspec('task start @done-task', tempDir);\n   156\t      kspec('task note @done-task \"Done note\"', tempDir);\n   157\t      kspec('task submit @done-task', tempDir);\n   158\t      kspec('task complete @done-task --reason \"Finished\"', tempDir);\n   159\t\n   160\t      const session = kspecJson<SessionContext>('session start --json --limit 6', tempDir);\n   161\t\n   162\t      // Total capped at 6\n   163\t      expect(session.recent_notes!.length).toBeLessThanOrEqual(6);\n   164\t\n   165\t      // Each status should be represented (starvation prevention still works)\n   166\t      const statuses = new Set(session.recent_notes!.map((n) => n.task_status));\n   167\t      expect(statuses.has('in_progress')).toBe(true);\n   168\t      expect(statuses.has('pending_review')).toBe(true);\n   169\t      expect(statuses.has('completed')).toBe(true);\n   170\t    });\n   171\t  });\n   172\t});\n","status":"completed"}