{"call_id":"call_55TTd5eXTnd7YaQxLLruQFY2","process_id":"66684","turn_id":"019ca812-a323-7dc0-88ca-2ef40b06947a","command":["/usr/bin/bash","-lc","nl -ba tests/helpers/cli.ts | sed -n '1,280p'"],"cwd":"/home/chapel/Projects/kynetic-spec","parsed_cmd":[{"type":"read","cmd":"nl -ba tests/helpers/cli.ts | sed -n '1,280p'","name":"cli.ts","path":"tests/helpers/cli.ts"}],"source":"unified_exec_startup","stdout":"     1\t/**\n     2\t * Shared CLI test utilities\n     3\t *\n     4\t * Provides centralized helpers for running kspec CLI commands in tests.\n     5\t * Uses pre-built dist/cli/index.js for performance (eliminates tsx transpilation overhead).\n     6\t *\n     7\t * ## ULID Patterns for Test Fixtures\n     8\t *\n     9\t * ULIDs use Crockford base32 which EXCLUDES: I, L, O, U\n    10\t * Valid characters: 0-9, A-H, J-K, M-N, P-T, V-Z\n    11\t *\n    12\t * Common test ULID mistakes:\n    13\t * - ❌ 01TRAIT10... (contains I)\n    14\t * - ❌ 01TASK100... (contains I)\n    15\t * - ❌ 01MODULE0... (contains O and U)\n    16\t * - ✅ 01TRATT100... (valid - no I, L, O, U)\n    17\t * - ✅ 01TASK0000... (valid - T, A, S, K are allowed)\n    18\t *\n    19\t * Use testUlid() to generate valid test ULIDs with readable prefixes.\n    20\t *\n    21\t * ## YAML Fixture Creation\n    22\t *\n    23\t * Don't use JSON.stringify() for YAML - it produces invalid syntax.\n    24\t * Options:\n    25\t * 1. Use setupTempFixtures() with pre-built fixtures (preferred)\n    26\t * 2. Write YAML strings directly with template literals\n    27\t * 3. Use the yaml library: import { stringify } from 'yaml'\n    28\t */\n    29\timport { execSync, spawnSync } from 'node:child_process';\n    30\timport * as fs from 'node:fs/promises';\n    31\timport * as path from 'node:path';\n    32\timport * as os from 'node:os';\n    33\t\n    34\t// Use built CLI for performance - requires `npm run build` before tests\n    35\texport const CLI_PATH = path.join(__dirname, '..', '..', 'dist', 'cli', 'index.js');\n    36\t\n    37\t// Fixtures directory for test data\n    38\texport const FIXTURES_DIR = path.join(__dirname, '..', 'fixtures');\n    39\t\n    40\t/**\n    41\t * Options for running kspec CLI commands\n    42\t */\n    43\texport interface KspecOptions {\n    44\t  /** Input to pipe to stdin */\n    45\t  stdin?: string;\n    46\t  /** Don't throw on non-zero exit code */\n    47\t  expectFail?: boolean;\n    48\t  /** Additional environment variables */\n    49\t  env?: Record<string, string>;\n    50\t}\n    51\t\n    52\t/**\n    53\t * Result from running a kspec CLI command\n    54\t */\n    55\texport interface KspecResult {\n    56\t  /** Exit code (0 = success) */\n    57\t  exitCode: number;\n    58\t  /** Standard output (trimmed) */\n    59\t  stdout: string;\n    60\t  /** Standard error (trimmed) */\n    61\t  stderr: string;\n    62\t}\n    63\t\n    64\t/**\n    65\t * Run a kspec CLI command\n    66\t *\n    67\t * @param args - CLI arguments (e.g., \"task list --json\")\n    68\t * @param cwd - Working directory to run the command in\n    69\t * @param options - Optional settings for stdin, error handling, env vars\n    70\t * @returns KspecResult with exitCode, stdout, stderr\n    71\t * @throws Error if command fails and expectFail is not set\n    72\t *\n    73\t * @example\n    74\t * // Simple command\n    75\t * const result = kspec('task list', tempDir);\n    76\t *\n    77\t * @example\n    78\t * // With stdin\n    79\t * const result = kspec('item set @ref --status implemented', tempDir, { stdin: 'y' });\n    80\t *\n    81\t * @example\n    82\t * // Expecting failure\n    83\t * const result = kspec('task set @ref --priority 99', tempDir, { expectFail: true });\n    84\t * expect(result.exitCode).toBe(1);\n    85\t */\n    86\texport function kspec(args: string, cwd: string, options: KspecOptions = {}): KspecResult {\n    87\t  const { stdin, expectFail = false, env = {} } = options;\n    88\t\n    89\t  // Build clean env: strip ralph-specific vars that pollute tests when running\n    90\t  // inside a ralph loop. Tests that need these vars pass them explicitly via env.\n    91\t  const cleanEnv = { ...process.env };\n    92\t  const RALPH_ENV_VARS = ['KSPEC_RALPH_SESSION', 'KSPEC_SESSION_ID'];\n    93\t  for (const key of RALPH_ENV_VARS) {\n    94\t    if (!(key in env)) {\n    95\t      delete cleanEnv[key];\n    96\t    }\n    97\t  }\n    98\t\n    99\t  // Use spawnSync with shell to capture both stdout and stderr\n   100\t  // Always use shell mode to properly handle argument parsing and quoting\n   101\t  const result = spawnSync('/bin/sh', ['-c', `node ${CLI_PATH} ${args}`], {\n   102\t    cwd,\n   103\t    encoding: 'utf-8',\n   104\t    timeout: 30_000,\n   105\t    env: { ...cleanEnv, KSPEC_AUTHOR: '@test', ...env },\n   106\t    input: stdin !== undefined ? (stdin.endsWith('\\n') ? stdin : stdin + '\\n') : undefined,\n   107\t  });\n   108\t\n   109\t  // Detect timeout (spawnSync kills the process and sets signal)\n   110\t  if (result.signal === 'SIGTERM' && result.error?.message?.includes('ETIMEDOUT')) {\n   111\t    throw new Error(`Command timed out after 30s: node ${CLI_PATH} ${args}`);\n   112\t  }\n   113\t\n   114\t  const kspecResult: KspecResult = {\n   115\t    exitCode: result.status ?? 1,\n   116\t    stdout: (result.stdout || '').trim(),\n   117\t    stderr: (result.stderr || '').trim(),\n   118\t  };\n   119\t\n   120\t  // Handle errors\n   121\t  if (kspecResult.exitCode !== 0) {\n   122\t    if (expectFail) {\n   123\t      return kspecResult;\n   124\t    }\n   125\t\n   126\t    // For backwards compatibility: return stdout if present even on error\n   127\t    // (some commands exit non-zero with valid output)\n   128\t    if (kspecResult.stdout) {\n   129\t      return kspecResult;\n   130\t    }\n   131\t\n   132\t    throw new Error(`Command failed: node ${CLI_PATH} ${args}\\n${kspecResult.stderr || result.error?.message}`);\n   133\t  }\n   134\t\n   135\t  return kspecResult;\n   136\t}\n   137\t\n   138\t/**\n   139\t * Run kspec and return just stdout (convenience wrapper)\n   140\t *\n   141\t * @param args - CLI arguments\n   142\t * @param cwd - Working directory\n   143\t * @param options - Optional settings\n   144\t * @returns stdout trimmed\n   145\t */\n   146\texport function kspecOutput(args: string, cwd: string, options: KspecOptions = {}): string {\n   147\t  return kspec(args, cwd, options).stdout;\n   148\t}\n   149\t\n   150\t/**\n   151\t * Run kspec and return parsed JSON output\n   152\t *\n   153\t * @param args - CLI arguments (--json flag is added automatically)\n   154\t * @param cwd - Working directory\n   155\t * @param options - Optional settings\n   156\t * @returns Parsed JSON response\n   157\t */\n   158\texport function kspecJson<T>(args: string, cwd: string, options: KspecOptions = {}): T {\n   159\t  const result = kspec(`${args} --json`, cwd, options);\n   160\t  return JSON.parse(result.stdout);\n   161\t}\n   162\t\n   163\t// Legacy aliases for backwards compatibility\n   164\texport const kspecExpectFail = (args: string, cwd: string): string => {\n   165\t  const result = kspec(args, cwd, { expectFail: true });\n   166\t  return result.stderr || result.stdout;\n   167\t};\n   168\t\n   169\texport const kspecWithStatus = (args: string, cwd: string): KspecResult => {\n   170\t  return kspec(args, cwd, { expectFail: true });\n   171\t};\n   172\t\n   173\t/**\n   174\t * Copy fixtures to a temp directory for isolated testing\n   175\t *\n   176\t * Excludes the 'multi-dir' subdirectory (use setupMultiDirFixtures() for that).\n   177\t *\n   178\t * @returns Path to the temp directory\n   179\t */\n   180\texport async function setupTempFixtures(): Promise<string> {\n   181\t  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-test-'));\n   182\t\n   183\t  // Copy all fixtures except multi-dir\n   184\t  const entries = await fs.readdir(FIXTURES_DIR, { withFileTypes: true });\n   185\t  for (const entry of entries) {\n   186\t    if (entry.name === 'multi-dir') continue; // Skip multi-dir fixtures\n   187\t    const source = path.join(FIXTURES_DIR, entry.name);\n   188\t    const dest = path.join(tempDir, entry.name);\n   189\t    if (entry.isDirectory()) {\n   190\t      await fs.cp(source, dest, { recursive: true });\n   191\t    } else {\n   192\t      await fs.copyFile(source, dest);\n   193\t    }\n   194\t  }\n   195\t\n   196\t  return tempDir;\n   197\t}\n   198\t\n   199\t/**\n   200\t * Copy multi-directory daemon fixtures to a temp directory\n   201\t *\n   202\t * Creates isolated copies of multiple kspec projects for testing\n   203\t * multi-directory daemon functionality.\n   204\t *\n   205\t * @returns Path to the temp directory containing project subdirectories\n   206\t *\n   207\t * @example\n   208\t * const fixturesRoot = await setupMultiDirFixtures();\n   209\t * const projectA = path.join(fixturesRoot, 'project-a');\n   210\t * const projectB = path.join(fixturesRoot, 'project-b');\n   211\t * const projectInvalid = path.join(fixturesRoot, 'project-invalid');\n   212\t *\n   213\t * // Clean up when done\n   214\t * await cleanupTempDir(fixturesRoot);\n   215\t */\n   216\texport async function setupMultiDirFixtures(): Promise<string> {\n   217\t  const multiDirSource = path.join(FIXTURES_DIR, 'multi-dir');\n   218\t  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-multi-'));\n   219\t  await fs.cp(multiDirSource, tempDir, { recursive: true });\n   220\t  return tempDir;\n   221\t}\n   222\t\n   223\t/**\n   224\t * Clean up a temp directory\n   225\t *\n   226\t * @param dir - Directory to remove\n   227\t */\n   228\texport async function cleanupTempDir(dir: string): Promise<void> {\n   229\t  await fs.rm(dir, { recursive: true, force: true });\n   230\t}\n   231\t\n   232\t/**\n   233\t * Create an empty temp directory (no fixtures)\n   234\t *\n   235\t * @param prefix - Optional prefix for the temp directory name\n   236\t * @returns Path to the temp directory\n   237\t */\n   238\texport async function createTempDir(prefix = 'kspec-test-'): Promise<string> {\n   239\t  return fs.mkdtemp(path.join(os.tmpdir(), prefix));\n   240\t}\n   241\t\n   242\t/**\n   243\t * Initialize a git repo in a directory (useful for tests that need git)\n   244\t *\n   245\t * @param dir - Directory to initialize\n   246\t */\n   247\texport function initGitRepo(dir: string): void {\n   248\t  execSync('git init -b main', { cwd: dir, stdio: 'pipe' });\n   249\t  execSync('git config user.email \"test@example.com\"', { cwd: dir, stdio: 'pipe' });\n   250\t  execSync('git config user.name \"Test User\"', { cwd: dir, stdio: 'pipe' });\n   251\t}\n   252\t\n   253\t/**\n   254\t * Run a git command in a directory\n   255\t *\n   256\t * @param cmd - Git command (without 'git' prefix)\n   257\t * @param cwd - Working directory\n   258\t */\n   259\texport function git(cmd: string, cwd: string): void {\n   260\t  execSync(`git ${cmd}`, { cwd, stdio: 'pipe' });\n   261\t}\n   262\t\n   263\t/**\n   264\t * Crockford base32 alphabet (excludes I, L, O, U)\n   265\t * Used for ULID generation\n   266\t */\n   267\tconst CROCKFORD_BASE32 = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';\n   268\t\n   269\t/**\n   270\t * Generate a valid test ULID with an optional readable prefix\n   271\t *\n   272\t * ULIDs use Crockford base32 which excludes I, L, O, U.\n   273\t * This function replaces any invalid characters in the prefix\n   274\t * and pads to create a valid 26-character ULID.\n   275\t *\n   276\t * @param prefix - Optional prefix (invalid chars will be replaced)\n   277\t * @returns A valid 26-character ULID\n   278\t *\n   279\t * @example\n   280\t * // Generate deterministic ULID (use sequence for uniqueness)\n","stderr":"","aggregated_output":"     1\t/**\n     2\t * Shared CLI test utilities\n     3\t *\n     4\t * Provides centralized helpers for running kspec CLI commands in tests.\n     5\t * Uses pre-built dist/cli/index.js for performance (eliminates tsx transpilation overhead).\n     6\t *\n     7\t * ## ULID Patterns for Test Fixtures\n     8\t *\n     9\t * ULIDs use Crockford base32 which EXCLUDES: I, L, O, U\n    10\t * Valid characters: 0-9, A-H, J-K, M-N, P-T, V-Z\n    11\t *\n    12\t * Common test ULID mistakes:\n    13\t * - ❌ 01TRAIT10... (contains I)\n    14\t * - ❌ 01TASK100... (contains I)\n    15\t * - ❌ 01MODULE0... (contains O and U)\n    16\t * - ✅ 01TRATT100... (valid - no I, L, O, U)\n    17\t * - ✅ 01TASK0000... (valid - T, A, S, K are allowed)\n    18\t *\n    19\t * Use testUlid() to generate valid test ULIDs with readable prefixes.\n    20\t *\n    21\t * ## YAML Fixture Creation\n    22\t *\n    23\t * Don't use JSON.stringify() for YAML - it produces invalid syntax.\n    24\t * Options:\n    25\t * 1. Use setupTempFixtures() with pre-built fixtures (preferred)\n    26\t * 2. Write YAML strings directly with template literals\n    27\t * 3. Use the yaml library: import { stringify } from 'yaml'\n    28\t */\n    29\timport { execSync, spawnSync } from 'node:child_process';\n    30\timport * as fs from 'node:fs/promises';\n    31\timport * as path from 'node:path';\n    32\timport * as os from 'node:os';\n    33\t\n    34\t// Use built CLI for performance - requires `npm run build` before tests\n    35\texport const CLI_PATH = path.join(__dirname, '..', '..', 'dist', 'cli', 'index.js');\n    36\t\n    37\t// Fixtures directory for test data\n    38\texport const FIXTURES_DIR = path.join(__dirname, '..', 'fixtures');\n    39\t\n    40\t/**\n    41\t * Options for running kspec CLI commands\n    42\t */\n    43\texport interface KspecOptions {\n    44\t  /** Input to pipe to stdin */\n    45\t  stdin?: string;\n    46\t  /** Don't throw on non-zero exit code */\n    47\t  expectFail?: boolean;\n    48\t  /** Additional environment variables */\n    49\t  env?: Record<string, string>;\n    50\t}\n    51\t\n    52\t/**\n    53\t * Result from running a kspec CLI command\n    54\t */\n    55\texport interface KspecResult {\n    56\t  /** Exit code (0 = success) */\n    57\t  exitCode: number;\n    58\t  /** Standard output (trimmed) */\n    59\t  stdout: string;\n    60\t  /** Standard error (trimmed) */\n    61\t  stderr: string;\n    62\t}\n    63\t\n    64\t/**\n    65\t * Run a kspec CLI command\n    66\t *\n    67\t * @param args - CLI arguments (e.g., \"task list --json\")\n    68\t * @param cwd - Working directory to run the command in\n    69\t * @param options - Optional settings for stdin, error handling, env vars\n    70\t * @returns KspecResult with exitCode, stdout, stderr\n    71\t * @throws Error if command fails and expectFail is not set\n    72\t *\n    73\t * @example\n    74\t * // Simple command\n    75\t * const result = kspec('task list', tempDir);\n    76\t *\n    77\t * @example\n    78\t * // With stdin\n    79\t * const result = kspec('item set @ref --status implemented', tempDir, { stdin: 'y' });\n    80\t *\n    81\t * @example\n    82\t * // Expecting failure\n    83\t * const result = kspec('task set @ref --priority 99', tempDir, { expectFail: true });\n    84\t * expect(result.exitCode).toBe(1);\n    85\t */\n    86\texport function kspec(args: string, cwd: string, options: KspecOptions = {}): KspecResult {\n    87\t  const { stdin, expectFail = false, env = {} } = options;\n    88\t\n    89\t  // Build clean env: strip ralph-specific vars that pollute tests when running\n    90\t  // inside a ralph loop. Tests that need these vars pass them explicitly via env.\n    91\t  const cleanEnv = { ...process.env };\n    92\t  const RALPH_ENV_VARS = ['KSPEC_RALPH_SESSION', 'KSPEC_SESSION_ID'];\n    93\t  for (const key of RALPH_ENV_VARS) {\n    94\t    if (!(key in env)) {\n    95\t      delete cleanEnv[key];\n    96\t    }\n    97\t  }\n    98\t\n    99\t  // Use spawnSync with shell to capture both stdout and stderr\n   100\t  // Always use shell mode to properly handle argument parsing and quoting\n   101\t  const result = spawnSync('/bin/sh', ['-c', `node ${CLI_PATH} ${args}`], {\n   102\t    cwd,\n   103\t    encoding: 'utf-8',\n   104\t    timeout: 30_000,\n   105\t    env: { ...cleanEnv, KSPEC_AUTHOR: '@test', ...env },\n   106\t    input: stdin !== undefined ? (stdin.endsWith('\\n') ? stdin : stdin + '\\n') : undefined,\n   107\t  });\n   108\t\n   109\t  // Detect timeout (spawnSync kills the process and sets signal)\n   110\t  if (result.signal === 'SIGTERM' && result.error?.message?.includes('ETIMEDOUT')) {\n   111\t    throw new Error(`Command timed out after 30s: node ${CLI_PATH} ${args}`);\n   112\t  }\n   113\t\n   114\t  const kspecResult: KspecResult = {\n   115\t    exitCode: result.status ?? 1,\n   116\t    stdout: (result.stdout || '').trim(),\n   117\t    stderr: (result.stderr || '').trim(),\n   118\t  };\n   119\t\n   120\t  // Handle errors\n   121\t  if (kspecResult.exitCode !== 0) {\n   122\t    if (expectFail) {\n   123\t      return kspecResult;\n   124\t    }\n   125\t\n   126\t    // For backwards compatibility: return stdout if present even on error\n   127\t    // (some commands exit non-zero with valid output)\n   128\t    if (kspecResult.stdout) {\n   129\t      return kspecResult;\n   130\t    }\n   131\t\n   132\t    throw new Error(`Command failed: node ${CLI_PATH} ${args}\\n${kspecResult.stderr || result.error?.message}`);\n   133\t  }\n   134\t\n   135\t  return kspecResult;\n   136\t}\n   137\t\n   138\t/**\n   139\t * Run kspec and return just stdout (convenience wrapper)\n   140\t *\n   141\t * @param args - CLI arguments\n   142\t * @param cwd - Working directory\n   143\t * @param options - Optional settings\n   144\t * @returns stdout trimmed\n   145\t */\n   146\texport function kspecOutput(args: string, cwd: string, options: KspecOptions = {}): string {\n   147\t  return kspec(args, cwd, options).stdout;\n   148\t}\n   149\t\n   150\t/**\n   151\t * Run kspec and return parsed JSON output\n   152\t *\n   153\t * @param args - CLI arguments (--json flag is added automatically)\n   154\t * @param cwd - Working directory\n   155\t * @param options - Optional settings\n   156\t * @returns Parsed JSON response\n   157\t */\n   158\texport function kspecJson<T>(args: string, cwd: string, options: KspecOptions = {}): T {\n   159\t  const result = kspec(`${args} --json`, cwd, options);\n   160\t  return JSON.parse(result.stdout);\n   161\t}\n   162\t\n   163\t// Legacy aliases for backwards compatibility\n   164\texport const kspecExpectFail = (args: string, cwd: string): string => {\n   165\t  const result = kspec(args, cwd, { expectFail: true });\n   166\t  return result.stderr || result.stdout;\n   167\t};\n   168\t\n   169\texport const kspecWithStatus = (args: string, cwd: string): KspecResult => {\n   170\t  return kspec(args, cwd, { expectFail: true });\n   171\t};\n   172\t\n   173\t/**\n   174\t * Copy fixtures to a temp directory for isolated testing\n   175\t *\n   176\t * Excludes the 'multi-dir' subdirectory (use setupMultiDirFixtures() for that).\n   177\t *\n   178\t * @returns Path to the temp directory\n   179\t */\n   180\texport async function setupTempFixtures(): Promise<string> {\n   181\t  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-test-'));\n   182\t\n   183\t  // Copy all fixtures except multi-dir\n   184\t  const entries = await fs.readdir(FIXTURES_DIR, { withFileTypes: true });\n   185\t  for (const entry of entries) {\n   186\t    if (entry.name === 'multi-dir') continue; // Skip multi-dir fixtures\n   187\t    const source = path.join(FIXTURES_DIR, entry.name);\n   188\t    const dest = path.join(tempDir, entry.name);\n   189\t    if (entry.isDirectory()) {\n   190\t      await fs.cp(source, dest, { recursive: true });\n   191\t    } else {\n   192\t      await fs.copyFile(source, dest);\n   193\t    }\n   194\t  }\n   195\t\n   196\t  return tempDir;\n   197\t}\n   198\t\n   199\t/**\n   200\t * Copy multi-directory daemon fixtures to a temp directory\n   201\t *\n   202\t * Creates isolated copies of multiple kspec projects for testing\n   203\t * multi-directory daemon functionality.\n   204\t *\n   205\t * @returns Path to the temp directory containing project subdirectories\n   206\t *\n   207\t * @example\n   208\t * const fixturesRoot = await setupMultiDirFixtures();\n   209\t * const projectA = path.join(fixturesRoot, 'project-a');\n   210\t * const projectB = path.join(fixturesRoot, 'project-b');\n   211\t * const projectInvalid = path.join(fixturesRoot, 'project-invalid');\n   212\t *\n   213\t * // Clean up when done\n   214\t * await cleanupTempDir(fixturesRoot);\n   215\t */\n   216\texport async function setupMultiDirFixtures(): Promise<string> {\n   217\t  const multiDirSource = path.join(FIXTURES_DIR, 'multi-dir');\n   218\t  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-multi-'));\n   219\t  await fs.cp(multiDirSource, tempDir, { recursive: true });\n   220\t  return tempDir;\n   221\t}\n   222\t\n   223\t/**\n   224\t * Clean up a temp directory\n   225\t *\n   226\t * @param dir - Directory to remove\n   227\t */\n   228\texport async function cleanupTempDir(dir: string): Promise<void> {\n   229\t  await fs.rm(dir, { recursive: true, force: true });\n   230\t}\n   231\t\n   232\t/**\n   233\t * Create an empty temp directory (no fixtures)\n   234\t *\n   235\t * @param prefix - Optional prefix for the temp directory name\n   236\t * @returns Path to the temp directory\n   237\t */\n   238\texport async function createTempDir(prefix = 'kspec-test-'): Promise<string> {\n   239\t  return fs.mkdtemp(path.join(os.tmpdir(), prefix));\n   240\t}\n   241\t\n   242\t/**\n   243\t * Initialize a git repo in a directory (useful for tests that need git)\n   244\t *\n   245\t * @param dir - Directory to initialize\n   246\t */\n   247\texport function initGitRepo(dir: string): void {\n   248\t  execSync('git init -b main', { cwd: dir, stdio: 'pipe' });\n   249\t  execSync('git config user.email \"test@example.com\"', { cwd: dir, stdio: 'pipe' });\n   250\t  execSync('git config user.name \"Test User\"', { cwd: dir, stdio: 'pipe' });\n   251\t}\n   252\t\n   253\t/**\n   254\t * Run a git command in a directory\n   255\t *\n   256\t * @param cmd - Git command (without 'git' prefix)\n   257\t * @param cwd - Working directory\n   258\t */\n   259\texport function git(cmd: string, cwd: string): void {\n   260\t  execSync(`git ${cmd}`, { cwd, stdio: 'pipe' });\n   261\t}\n   262\t\n   263\t/**\n   264\t * Crockford base32 alphabet (excludes I, L, O, U)\n   265\t * Used for ULID generation\n   266\t */\n   267\tconst CROCKFORD_BASE32 = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';\n   268\t\n   269\t/**\n   270\t * Generate a valid test ULID with an optional readable prefix\n   271\t *\n   272\t * ULIDs use Crockford base32 which excludes I, L, O, U.\n   273\t * This function replaces any invalid characters in the prefix\n   274\t * and pads to create a valid 26-character ULID.\n   275\t *\n   276\t * @param prefix - Optional prefix (invalid chars will be replaced)\n   277\t * @returns A valid 26-character ULID\n   278\t *\n   279\t * @example\n   280\t * // Generate deterministic ULID (use sequence for uniqueness)\n","exit_code":0,"duration":{"secs":0,"nanos":51307891},"formatted_output":"     1\t/**\n     2\t * Shared CLI test utilities\n     3\t *\n     4\t * Provides centralized helpers for running kspec CLI commands in tests.\n     5\t * Uses pre-built dist/cli/index.js for performance (eliminates tsx transpilation overhead).\n     6\t *\n     7\t * ## ULID Patterns for Test Fixtures\n     8\t *\n     9\t * ULIDs use Crockford base32 which EXCLUDES: I, L, O, U\n    10\t * Valid characters: 0-9, A-H, J-K, M-N, P-T, V-Z\n    11\t *\n    12\t * Common test ULID mistakes:\n    13\t * - ❌ 01TRAIT10... (contains I)\n    14\t * - ❌ 01TASK100... (contains I)\n    15\t * - ❌ 01MODULE0... (contains O and U)\n    16\t * - ✅ 01TRATT100... (valid - no I, L, O, U)\n    17\t * - ✅ 01TASK0000... (valid - T, A, S, K are allowed)\n    18\t *\n    19\t * Use testUlid() to generate valid test ULIDs with readable prefixes.\n    20\t *\n    21\t * ## YAML Fixture Creation\n    22\t *\n    23\t * Don't use JSON.stringify() for YAML - it produces invalid syntax.\n    24\t * Options:\n    25\t * 1. Use setupTempFixtures() with pre-built fixtures (preferred)\n    26\t * 2. Write YAML strings directly with template literals\n    27\t * 3. Use the yaml library: import { stringify } from 'yaml'\n    28\t */\n    29\timport { execSync, spawnSync } from 'node:child_process';\n    30\timport * as fs from 'node:fs/promises';\n    31\timport * as path from 'node:path';\n    32\timport * as os from 'node:os';\n    33\t\n    34\t// Use built CLI for performance - requires `npm run build` before tests\n    35\texport const CLI_PATH = path.join(__dirname, '..', '..', 'dist', 'cli', 'index.js');\n    36\t\n    37\t// Fixtures directory for test data\n    38\texport const FIXTURES_DIR = path.join(__dirname, '..', 'fixtures');\n    39\t\n    40\t/**\n    41\t * Options for running kspec CLI commands\n    42\t */\n    43\texport interface KspecOptions {\n    44\t  /** Input to pipe to stdin */\n    45\t  stdin?: string;\n    46\t  /** Don't throw on non-zero exit code */\n    47\t  expectFail?: boolean;\n    48\t  /** Additional environment variables */\n    49\t  env?: Record<string, string>;\n    50\t}\n    51\t\n    52\t/**\n    53\t * Result from running a kspec CLI command\n    54\t */\n    55\texport interface KspecResult {\n    56\t  /** Exit code (0 = success) */\n    57\t  exitCode: number;\n    58\t  /** Standard output (trimmed) */\n    59\t  stdout: string;\n    60\t  /** Standard error (trimmed) */\n    61\t  stderr: string;\n    62\t}\n    63\t\n    64\t/**\n    65\t * Run a kspec CLI command\n    66\t *\n    67\t * @param args - CLI arguments (e.g., \"task list --json\")\n    68\t * @param cwd - Working directory to run the command in\n    69\t * @param options - Optional settings for stdin, error handling, env vars\n    70\t * @returns KspecResult with exitCode, stdout, stderr\n    71\t * @throws Error if command fails and expectFail is not set\n    72\t *\n    73\t * @example\n    74\t * // Simple command\n    75\t * const result = kspec('task list', tempDir);\n    76\t *\n    77\t * @example\n    78\t * // With stdin\n    79\t * const result = kspec('item set @ref --status implemented', tempDir, { stdin: 'y' });\n    80\t *\n    81\t * @example\n    82\t * // Expecting failure\n    83\t * const result = kspec('task set @ref --priority 99', tempDir, { expectFail: true });\n    84\t * expect(result.exitCode).toBe(1);\n    85\t */\n    86\texport function kspec(args: string, cwd: string, options: KspecOptions = {}): KspecResult {\n    87\t  const { stdin, expectFail = false, env = {} } = options;\n    88\t\n    89\t  // Build clean env: strip ralph-specific vars that pollute tests when running\n    90\t  // inside a ralph loop. Tests that need these vars pass them explicitly via env.\n    91\t  const cleanEnv = { ...process.env };\n    92\t  const RALPH_ENV_VARS = ['KSPEC_RALPH_SESSION', 'KSPEC_SESSION_ID'];\n    93\t  for (const key of RALPH_ENV_VARS) {\n    94\t    if (!(key in env)) {\n    95\t      delete cleanEnv[key];\n    96\t    }\n    97\t  }\n    98\t\n    99\t  // Use spawnSync with shell to capture both stdout and stderr\n   100\t  // Always use shell mode to properly handle argument parsing and quoting\n   101\t  const result = spawnSync('/bin/sh', ['-c', `node ${CLI_PATH} ${args}`], {\n   102\t    cwd,\n   103\t    encoding: 'utf-8',\n   104\t    timeout: 30_000,\n   105\t    env: { ...cleanEnv, KSPEC_AUTHOR: '@test', ...env },\n   106\t    input: stdin !== undefined ? (stdin.endsWith('\\n') ? stdin : stdin + '\\n') : undefined,\n   107\t  });\n   108\t\n   109\t  // Detect timeout (spawnSync kills the process and sets signal)\n   110\t  if (result.signal === 'SIGTERM' && result.error?.message?.includes('ETIMEDOUT')) {\n   111\t    throw new Error(`Command timed out after 30s: node ${CLI_PATH} ${args}`);\n   112\t  }\n   113\t\n   114\t  const kspecResult: KspecResult = {\n   115\t    exitCode: result.status ?? 1,\n   116\t    stdout: (result.stdout || '').trim(),\n   117\t    stderr: (result.stderr || '').trim(),\n   118\t  };\n   119\t\n   120\t  // Handle errors\n   121\t  if (kspecResult.exitCode !== 0) {\n   122\t    if (expectFail) {\n   123\t      return kspecResult;\n   124\t    }\n   125\t\n   126\t    // For backwards compatibility: return stdout if present even on error\n   127\t    // (some commands exit non-zero with valid output)\n   128\t    if (kspecResult.stdout) {\n   129\t      return kspecResult;\n   130\t    }\n   131\t\n   132\t    throw new Error(`Command failed: node ${CLI_PATH} ${args}\\n${kspecResult.stderr || result.error?.message}`);\n   133\t  }\n   134\t\n   135\t  return kspecResult;\n   136\t}\n   137\t\n   138\t/**\n   139\t * Run kspec and return just stdout (convenience wrapper)\n   140\t *\n   141\t * @param args - CLI arguments\n   142\t * @param cwd - Working directory\n   143\t * @param options - Optional settings\n   144\t * @returns stdout trimmed\n   145\t */\n   146\texport function kspecOutput(args: string, cwd: string, options: KspecOptions = {}): string {\n   147\t  return kspec(args, cwd, options).stdout;\n   148\t}\n   149\t\n   150\t/**\n   151\t * Run kspec and return parsed JSON output\n   152\t *\n   153\t * @param args - CLI arguments (--json flag is added automatically)\n   154\t * @param cwd - Working directory\n   155\t * @param options - Optional settings\n   156\t * @returns Parsed JSON response\n   157\t */\n   158\texport function kspecJson<T>(args: string, cwd: string, options: KspecOptions = {}): T {\n   159\t  const result = kspec(`${args} --json`, cwd, options);\n   160\t  return JSON.parse(result.stdout);\n   161\t}\n   162\t\n   163\t// Legacy aliases for backwards compatibility\n   164\texport const kspecExpectFail = (args: string, cwd: string): string => {\n   165\t  const result = kspec(args, cwd, { expectFail: true });\n   166\t  return result.stderr || result.stdout;\n   167\t};\n   168\t\n   169\texport const kspecWithStatus = (args: string, cwd: string): KspecResult => {\n   170\t  return kspec(args, cwd, { expectFail: true });\n   171\t};\n   172\t\n   173\t/**\n   174\t * Copy fixtures to a temp directory for isolated testing\n   175\t *\n   176\t * Excludes the 'multi-dir' subdirectory (use setupMultiDirFixtures() for that).\n   177\t *\n   178\t * @returns Path to the temp directory\n   179\t */\n   180\texport async function setupTempFixtures(): Promise<string> {\n   181\t  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-test-'));\n   182\t\n   183\t  // Copy all fixtures except multi-dir\n   184\t  const entries = await fs.readdir(FIXTURES_DIR, { withFileTypes: true });\n   185\t  for (const entry of entries) {\n   186\t    if (entry.name === 'multi-dir') continue; // Skip multi-dir fixtures\n   187\t    const source = path.join(FIXTURES_DIR, entry.name);\n   188\t    const dest = path.join(tempDir, entry.name);\n   189\t    if (entry.isDirectory()) {\n   190\t      await fs.cp(source, dest, { recursive: true });\n   191\t    } else {\n   192\t      await fs.copyFile(source, dest);\n   193\t    }\n   194\t  }\n   195\t\n   196\t  return tempDir;\n   197\t}\n   198\t\n   199\t/**\n   200\t * Copy multi-directory daemon fixtures to a temp directory\n   201\t *\n   202\t * Creates isolated copies of multiple kspec projects for testing\n   203\t * multi-directory daemon functionality.\n   204\t *\n   205\t * @returns Path to the temp directory containing project subdirectories\n   206\t *\n   207\t * @example\n   208\t * const fixturesRoot = await setupMultiDirFixtures();\n   209\t * const projectA = path.join(fixturesRoot, 'project-a');\n   210\t * const projectB = path.join(fixturesRoot, 'project-b');\n   211\t * const projectInvalid = path.join(fixturesRoot, 'project-invalid');\n   212\t *\n   213\t * // Clean up when done\n   214\t * await cleanupTempDir(fixturesRoot);\n   215\t */\n   216\texport async function setupMultiDirFixtures(): Promise<string> {\n   217\t  const multiDirSource = path.join(FIXTURES_DIR, 'multi-dir');\n   218\t  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-multi-'));\n   219\t  await fs.cp(multiDirSource, tempDir, { recursive: true });\n   220\t  return tempDir;\n   221\t}\n   222\t\n   223\t/**\n   224\t * Clean up a temp directory\n   225\t *\n   226\t * @param dir - Directory to remove\n   227\t */\n   228\texport async function cleanupTempDir(dir: string): Promise<void> {\n   229\t  await fs.rm(dir, { recursive: true, force: true });\n   230\t}\n   231\t\n   232\t/**\n   233\t * Create an empty temp directory (no fixtures)\n   234\t *\n   235\t * @param prefix - Optional prefix for the temp directory name\n   236\t * @returns Path to the temp directory\n   237\t */\n   238\texport async function createTempDir(prefix = 'kspec-test-'): Promise<string> {\n   239\t  return fs.mkdtemp(path.join(os.tmpdir(), prefix));\n   240\t}\n   241\t\n   242\t/**\n   243\t * Initialize a git repo in a directory (useful for tests that need git)\n   244\t *\n   245\t * @param dir - Directory to initialize\n   246\t */\n   247\texport function initGitRepo(dir: string): void {\n   248\t  execSync('git init -b main', { cwd: dir, stdio: 'pipe' });\n   249\t  execSync('git config user.email \"test@example.com\"', { cwd: dir, stdio: 'pipe' });\n   250\t  execSync('git config user.name \"Test User\"', { cwd: dir, stdio: 'pipe' });\n   251\t}\n   252\t\n   253\t/**\n   254\t * Run a git command in a directory\n   255\t *\n   256\t * @param cmd - Git command (without 'git' prefix)\n   257\t * @param cwd - Working directory\n   258\t */\n   259\texport function git(cmd: string, cwd: string): void {\n   260\t  execSync(`git ${cmd}`, { cwd, stdio: 'pipe' });\n   261\t}\n   262\t\n   263\t/**\n   264\t * Crockford base32 alphabet (excludes I, L, O, U)\n   265\t * Used for ULID generation\n   266\t */\n   267\tconst CROCKFORD_BASE32 = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';\n   268\t\n   269\t/**\n   270\t * Generate a valid test ULID with an optional readable prefix\n   271\t *\n   272\t * ULIDs use Crockford base32 which excludes I, L, O, U.\n   273\t * This function replaces any invalid characters in the prefix\n   274\t * and pads to create a valid 26-character ULID.\n   275\t *\n   276\t * @param prefix - Optional prefix (invalid chars will be replaced)\n   277\t * @returns A valid 26-character ULID\n   278\t *\n   279\t * @example\n   280\t * // Generate deterministic ULID (use sequence for uniqueness)\n","status":"completed"}