    // File already exists - check if daemon is actually running\n    61\t        if (this.isDaemonRunning()) {\n    62\t          throw new Error('Daemon already running');\n    63\t        }\n    64\t        // Stale PID file - remove it and retry inline (not recursive)\n    65\t        this.remove();\n    66\t        const fd = openSync(this.pidFilePath, constants.O_CREAT | constants.O_EXCL | constants.O_WRONLY, 0o644);\n    67\t        try {\n    68\t          writeFileSync(fd, process.pid.toString(), 'utf-8');\n    69\t        } finally {\n    70\t          closeSync(fd);\n    71\t        }\n    72\t      } else {\n    73\t        throw err;\n    74\t      }\n    75\t    }\n    76\t  }\n    77\t\n    78\t  /**\n    79\t   * AC: @multi-directory-daemon ac-9\n    80\t   * Writes daemon port to ~/.config/kspec/daemon.port\n    81\t   * Creates parent directory if it doesn't exist.\n    82\t   */\n    83\t  writePort(port: number): void {\n    84\t    this.ensureConfigDir();\n    85\t    writeFileSync(this.portFilePath, port.toString(), 'utf-8');\n    86\t  }\n    87\t\n    88\t  /**\n    89\t   * Reads PID from ~/.config/kspec/daemon.pid\n    90\t   * Returns null if file doesn't exist or is invalid\n    91\t   */\n    92\t  readPid(): number | null {\n    93\t    if (!existsSync(this.pidFilePath)) {\n    94\t      return null;\n    95\t    }\n    96\t\n    97\t    try {\n    98\t      const content = readFileSync(this.pidFilePath, 'utf-8').trim();\n    99\t      const pid = parseInt(content, 10);\n   100\t      return isNaN(pid) ? null : pid;\n   101\t    } catch {\n   102\t      return null;\n   103\t    }\n   104\t  }\n   105\t\n   106\t  /**\n   107\t   * AC: @multi-directory-daemon ac-9c, ac-13\n   108\t   * Reads port from ~/.config/kspec/daemon.port\n   109\t   * Throws error if file doesn't exist or contains invalid port\n   110\t   */\n   111\t  readPort(): number {\n   112\t    if (!existsSync(this.portFilePath)) {\n   113\t      throw new Error('Invalid daemon port file');\n   114\t    }\n   115\t\n   116\t    try {\n   117\t      const content = readFileSync(this.portFilePath, 'utf-8').trim();\n   118\t      const port = parseInt(content, 10);\n   119\t\n   120\t      // AC: @multi-directory-daemon ac-9c - validate port content\n   121\t      if (isNaN(port) || port < 1 || port > 65535) {\n   122\t        throw new Error('Invalid daemon port file');\n   123\t      }\n   124\t\n   125\t      return port;\n   126\t    } catch (err) {\n   127\t      throw new Error('Invalid daemon port file');\n   128\t    }\n   129\t  }\n   130\t\n   131\t  /**\n   132\t   * AC: @multi-directory-daemon ac-11\n   133\t   * Removes both PID and port files during graceful shutdown\n   134\t   */\n   135\t  remove(): void {\n   136\t    if (existsSync(this.pidFilePath)) {\n   137\t      unlinkSync(this.pidFilePath);\n   138\t    }\n   139\t    if (existsSync(this.portFilePath)) {\n   140\t      unlinkSync(this.portFilePath);\n   141\t    }\n   142\t  }\n   143\t\n   144\t  /**\n   145\t   * Checks if a process with given PID is running\n   146\t   */\n   147\t  isProcessRunning(pid: number): boolean {\n   148\t    try {\n   149\t      // Sending signal 0 checks if process exists without actually sending a signal\n   150\t      process.kill(pid, 0);\n   151\t      return true;\n   152\t    } catch {\n   153\t      return false;\n   154\t    }\n   155\t  }\n   156\t\n   157\t  /**\n   158\t   * AC: @multi-directory-daemon ac-10\n   159\t   * Checks if daemon is currently running based on PID file\n   160\t   */\n   161\t  isDaemonRunning(): boolean {\n   162\t    const pid = this.readPid();\n   163\t    if (pid === null) {\n   164\t      return false;\n   165\t    }\n   166\t    return this.isProcessRunning(pid);\n   167\t  }\n   168\t\n   169\t  /**\n   170\t   * Backwards compatibility: read() method maps to readPid()\n   171\t   * @deprecated Use readPid() instead\n   172\t   */\n   173\t  read(): number | null {\n   174\t    return this.readPid();\n   175\t  }\n   176\t\n   177\t  /**\n   178\t   * Backwards compatibility: write() method maps to writePid()\n   179\t   * @deprecated Use writePid() instead\n   180\t   */\n   181\t  write(): void {\n   182\t    this.writePid();\n   183\t  }\n   184\t}\n","exit_code":0,"duration":{"secs":0,"nanos":51349448},"formatted_output":"     1\t/**\n     2\t * PID File Management for CLI\n     3\t *\n     4\t * Manages daemon process PID and port files for lifecycle control from the CLI.\n     5\t * Uses global config directory (~/.config/kspec/) instead of per-project .kspec/\n     6\t *\n     7\t * NOTE: This is a duplicate of packages/daemon/src/pid.ts to avoid cross-package imports.\n     8\t * TODO: Consider extracting to a shared @kynetic-ai/shared package when monorepo structure is established.\n     9\t * For now, both files must be kept in sync manually.\n    10\t *\n    11\t * AC: @multi-directory-daemon ac-9, ac-9b, ac-9c, ac-10, ac-11, ac-13\n    12\t */\n    13\t\n    14\timport { readFileSync, writeFileSync, unlinkSync, existsSync, mkdirSync, openSync, closeSync, constants } from 'fs';\n    15\timport { join } from 'path';\n    16\timport { homedir } from 'os';\n    17\t\n    18\texport class PidFileManager {\n    19\t  private configDir: string;\n    20\t  private pidFilePath: string;\n    21\t  private portFilePath: string;\n    22\t\n    23\t  constructor(configDir: string = join(homedir(), '.config', 'kspec')) {\n    24\t    this.configDir = configDir;\n    25\t    this.pidFilePath = join(configDir, 'daemon.pid');\n    26\t    this.portFilePath = join(configDir, 'daemon.port');\n    27\t  }\n    28\t\n    29\t  /**\n    30\t   * AC: @multi-directory-daemon ac-9b\n    31\t   * Creates config directory with mode 0755 if it doesn't exist\n    32\t   */\n    33\t  private ensureConfigDir(): void {\n    34\t    if (!existsSync(this.configDir)) {\n    35\t      mkdirSync(this.configDir, { recursive: true, mode: 0o755 });\n    36\t    }\n    37\t  }\n    38\t\n    39\t  /**\n    40\t   * AC: @multi-directory-daemon ac-9, ac-10b\n    41\t   * Writes current process PID to ~/.config/kspec/daemon.pid\n    42\t   * Creates parent directory if it doesn't exist.\n    43\t   * Uses exclusive file creation flag to prevent concurrent daemon starts.\n    44\t   */\n    45\t  writePid(): void {\n    46\t    this.ensureConfigDir();\n    47\t\n    48\t    // AC: @multi-directory-daemon ac-10b\n    49\t    // Use O_CREAT | O_EXCL flags for atomic file creation\n    50\t    // This prevents race conditions between concurrent daemon starts\n    51\t    try {\n    52\t      const fd = openSync(this.pidFilePath, constants.O_CREAT | constants.O_EXCL | constants.O_WRONLY, 0o644);\n    53\t      try {\n    54\t        writeFileSync(fd, process.pid.toString(), 'utf-8');\n    55\t      } finally {\n    56\t        closeSync(fd);\n    57\t      }\n    58\t    } catch (err: any) {\n    59\t      if (err.code === 'EEXIST') {\n    60\t        // File already exists - check if daemon is actually running\n    61\t        if (this.isDaemonRunning()) {\n    62\t          throw new Error('Daemon already running');\n    63\t        }\n    64\t        // Stale PID file - remove it and retry inline (not recursive)\n    65\t        this.remove();\n    66\t        const fd = openSync(this.pidFilePath, constants.O_CREAT | constants.O_EXCL | constants.O_WRONLY, 0o644);\n    67\t        try {\n    68\t          writeFileSync(fd, process.pid.toString(), 'utf-8');\n    69\t        } finally {\n    70\t          closeSync(fd);\n    71\t        }\n    72\t      } else {\n    73\t        throw err;\n    74\t      }\n    75\t    }\n    76\t  }\n    77\t\n    78\t  /**\n    79\t   * AC: @multi-directory-daemon ac-9\n    80\t   * Writes daemon port to ~/.config/kspec/daemon.port\n    81\t   * Creates parent directory if it doesn't exist.\n    82\t   */\n    83\t  writePort(port: number): void {\n    84\t    this.ensureConfigDir();\n    85\t    writeFileSync(this.portFilePath, port.toString(), 'utf-8');\n    86\t  }\n    87\t\n    88\t  /**\n    89\t   * Reads PID from ~/.config/kspec/daemon.pid\n    90\t   * Returns null if file doesn't exist or is invalid\n    91\t   */\n    92\t  readPid(): number | null {\n    93\t    if (!existsSync(this.pidFilePath)) {\n    94\t      return null;\n    95\t    }\n    96\t\n    97\t    try {\n    98\t      const content = readFileSync(this.pidFilePath, 'utf-8').trim();\n    99\t      const pid = parseInt(content, 10);\n   100\t      return isNaN(pid) ? null : pid;\n   101\t    } catch {\n   102\t      return null;\n   103\t    }\n   104\t  }\n   105\t\n   106\t  /**\n   107\t   * AC: @multi-directory-daemon ac-9c, ac-13\n   108\t   * Reads port from ~/.config/kspec/daemon.port\n   109\t   * Throws error if file doesn't exist or contains invalid port\n   110\t   */\n   111\t  readPort(): number {\n   112\t    if (!existsSync(this.portFilePath)) {\n   113\t      throw new Error('Invalid daemon port file');\n   114\t    }\n   115\t\n   116\t    try {\n   117\t      const content = readFileSync(this.portFilePath, 'utf-8').trim();\n   118\t      const port = parseInt(content, 10);\n   119\t\n   120\t      // AC: @multi-directory-daemon ac-9c - validate port content\n   121\t      if (isNaN(port) || port < 1 || port > 65535) {\n   122\t        throw new Error('Invalid daemon port file');\n   123\t      }\n   124\t\n   125\t      return port;\n   126\t    } catch (err) {\n   127\t      throw new Error('Invalid daemon port file');\n   128\t    }\n   129\t  }\n   130\t\n   131\t  /**\n   132\t   * AC: @multi-directory-daemon ac-11\n   133\t   * Removes both PID and port files during graceful shutdown\n   134\t   */\n   135\t  remove(): void {\n   136\t    if (existsSync(this.pidFilePath)) {\n   137\t      unlinkSync(this.pidFilePath);\n   138\t    }\n   139\t    if (existsSync(this.portFilePath)) {\n   140\t      unlinkSync(this.portFilePath);\n   141\t    }\n   142\t  }\n   143\t\n   144\t  /**\n   145\t   * Checks if a process with given PID is running\n   146\t   */\n   147\t  isProcessRunning(pid: number): boolean {\n   148\t    try {\n   149\t      // Sending signal 0 checks if process exists without actually sending a signal\n   150\t      process.kill(pid, 0);\n   151\t      return true;\n   152\t    } catch {\n   153\t      return false;\n   154\t    }\n   155\t  }\n   156\t\n   157\t  /**\n   158\t   * AC: @multi-directory-daemon ac-10\n   159\t   * Checks if daemon is currently running based on PID file\n   160\t   */\n   161\t  isDaemonRunning(): boolean {\n   162\t    const pid = this.readPid();\n   163\t    if (pid === null) {\n   164\t      return false;\n   165\t    }\n   166\t    return this.isProcessRunning(pid);\n   167\t  }\n   168\t\n   169\t  /**\n   170\t   * Backwards compatibility: read() method maps to readPid()\n   171\t   * @deprecated Use readPid() instead\n   172\t   */\n   173\t  read(): number | null {\n   174\t    return this.readPid();\n   175\t  }\n   176\t\n   177\t  /**\n   178\t   * Backwards compatibility: write() method maps to writePid()\n   179\t   * @deprecated Use writePid() instead\n   180\t   */\n   181\t  write(): void {\n   182\t    this.writePid();\n   183\t  }\n   184\t}\n","status":"completed"}