{"call_id":"call_skVqZgpwd0tDbtBfx63wJoKm","process_id":"78662","turn_id":"019ca7d5-7f41-7352-89bf-011b662ed0f0","command":["/usr/bin/bash","-lc","nl -ba packages/web-ui/src/routes/triage/+page.svelte | sed -n '1,320p' && nl -ba packages/web-ui/src/routes/triage/+page.svelte | sed -n '321,640p'"],"cwd":"/home/chapel/Projects/kynetic-spec","parsed_cmd":[{"type":"read","cmd":"nl -ba packages/web-ui/src/routes/triage/+page.svelte","name":"+page.svelte","path":"packages/web-ui/src/routes/triage/+page.svelte"}],"source":"unified_exec_startup","stdout":"     1\t<script lang=\"ts\">\n     2\t\t// AC: @interactive-triage-ui ac-1, ac-2, ac-3, ac-4, ac-5, ac-6, ac-7, ac-8\n     3\t\t// AC: @trait-websocket-protocol ac-1, ac-2, ac-3\n     4\t\timport { onMount, onDestroy } from 'svelte';\n     5\t\timport type { InboxItem, BroadcastEvent } from '@kynetic-ai/shared';\n     6\t\timport type { TriageRecord, TriageAction } from '$lib/types/triage';\n     7\t\timport {\n     8\t\t\tfetchInbox,\n     9\t\t\tfetchTriageRecords,\n    10\t\t\tcreateTriageRecord,\n    11\t\t\toverrideTriageRecord,\n    12\t\t\tactOnTriageRecord\n    13\t\t} from '$lib/api';\n    14\t\timport { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';\n    15\t\timport { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';\n    16\t\timport { getProjectVersion } from '$lib/stores/project.svelte';\n    17\t\timport { Button } from '$lib/components/ui/button';\n    18\t\timport { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';\n    19\t\timport { Badge } from '$lib/components/ui/badge';\n    20\t\timport { Textarea } from '$lib/components/ui/textarea';\n    21\t\timport { Separator } from '$lib/components/ui/separator';\n    22\t\timport ChevronLeftIcon from '@lucide/svelte/icons/chevron-left';\n    23\t\timport ChevronRightIcon from '@lucide/svelte/icons/chevron-right';\n    24\t\n    25\t\t// Data state\n    26\t\tlet inboxItems = $state<InboxItem[]>([]);\n    27\t\tlet triageRecords = $state<TriageRecord[]>([]);\n    28\t\tlet loading = $state(true);\n    29\t\tlet error = $state('');\n    30\t\n    31\t\t// Card navigation state\n    32\t\t// AC: @interactive-triage-ui ac-5\n    33\t\tlet currentIndex = $state(0);\n    34\t\tlet submitting = $state(false);\n    35\t\n    36\t\t// Form state\n    37\t\t// AC: @interactive-triage-ui ac-3\n    38\t\tlet selectedAction = $state<TriageAction | ''>('');\n    39\t\tlet reasoning = $state('');\n    40\t\n    41\t\t// Filter state\n    42\t\t// AC: @interactive-triage-ui ac-7\n    43\t\tlet filterTag = $state<string | ''>('');\n    44\t\tlet filterStatus = $state<'all' | 'untriaged' | 'triaged' | 'acted_on'>('all');\n    45\t\tlet filterAction = $state<TriageAction | ''>('');\n    46\t\n    47\t\t// Action labels\n    48\t\tconst ACTION_LABELS: Record<TriageAction, string> = {\n    49\t\t\tpromote: 'Promote to Task',\n    50\t\t\tdelete: 'Delete',\n    51\t\t\tdefer: 'Defer',\n    52\t\t\t'spec-gap': 'Spec Gap',\n    53\t\t\tduplicate: 'Duplicate'\n    54\t\t};\n    55\t\n    56\t\tconst ACTION_COLORS: Record<TriageAction, string> = {\n    57\t\t\tpromote: 'bg-green-500',\n    58\t\t\tdelete: 'bg-red-500',\n    59\t\t\tdefer: 'bg-yellow-500',\n    60\t\t\t'spec-gap': 'bg-purple-500',\n    61\t\t\tduplicate: 'bg-gray-500'\n    62\t\t};\n    63\t\n    64\t\t// Merged view: inbox items with their triage records\n    65\t\tinterface TriageCardItem {\n    66\t\t\tinbox: InboxItem;\n    67\t\t\trecord: TriageRecord | null;\n    68\t\t}\n    69\t\n    70\t\t// AC: @interactive-triage-ui ac-7 - Filtered items\n    71\t\tlet allItems = $derived.by(() => {\n    72\t\t\tconst items: TriageCardItem[] = inboxItems.map((inbox) => {\n    73\t\t\t\tconst record = triageRecords.find((r) => r.inbox_ref === inbox._ulid) ?? null;\n    74\t\t\t\treturn { inbox, record };\n    75\t\t\t});\n    76\t\t\treturn items;\n    77\t\t});\n    78\t\n    79\t\tlet filteredItems = $derived.by(() => {\n    80\t\t\tlet items = allItems;\n    81\t\n    82\t\t\t// Tag filter\n    83\t\t\tif (filterTag) {\n    84\t\t\t\titems = items.filter((i) => i.inbox.tags.includes(filterTag));\n    85\t\t\t}\n    86\t\n    87\t\t\t// Status filter\n    88\t\t\tif (filterStatus === 'untriaged') {\n    89\t\t\t\titems = items.filter((i) => !i.record || i.record.status === 'pending');\n    90\t\t\t} else if (filterStatus === 'triaged') {\n    91\t\t\t\titems = items.filter((i) => i.record?.status === 'triaged');\n    92\t\t\t} else if (filterStatus === 'acted_on') {\n    93\t\t\t\titems = items.filter((i) => i.record?.status === 'acted_on');\n    94\t\t\t}\n    95\t\n    96\t\t\t// Action filter\n    97\t\t\tif (filterAction) {\n    98\t\t\t\titems = items.filter((i) => i.record?.action === filterAction);\n    99\t\t\t}\n   100\t\n   101\t\t\treturn items;\n   102\t\t});\n   103\t\n   104\t\tlet currentItem = $derived(filteredItems[currentIndex] ?? null);\n   105\t\n   106\t\t// AC: @interactive-triage-ui ac-7 - Progress count\n   107\t\tlet triagedCount = $derived(allItems.filter((i) => i.record && i.record.status !== 'pending').length);\n   108\t\tlet totalCount = $derived(allItems.length);\n   109\t\n   110\t\t// All unique tags for filter\n   111\t\tlet allTags = $derived.by(() => {\n   112\t\t\tconst tagSet = new Set<string>();\n   113\t\t\tinboxItems.forEach((item) => item.tags.forEach((t) => tagSet.add(t)));\n   114\t\t\treturn Array.from(tagSet).sort();\n   115\t\t});\n   116\t\n   117\t\tonMount(async () => {\n   118\t\t\tawait loadData();\n   119\t\n   120\t\t\t// AC: @interactive-triage-ui ac-6 - Subscribe to triage:updates\n   121\t\t\t// AC: @trait-websocket-protocol ac-2 - Subscribe to topic\n   122\t\t\tif (!isStaticMode()) {\n   123\t\t\t\tsubscribe(['triage:updates']);\n   124\t\t\t\ton('triage:updates', handleTriageUpdate);\n   125\t\t\t}\n   126\t\t});\n   127\t\n   128\t\tonDestroy(() => {\n   129\t\t\tif (!isStaticMode()) {\n   130\t\t\t\toff('triage:updates', handleTriageUpdate);\n   131\t\t\t\tunsubscribe(['triage:updates']);\n   132\t\t\t}\n   133\t\t});\n   134\t\n   135\t\t// AC: @multi-directory-daemon ac-27 - Reload on project change\n   136\t\t$effect(() => {\n   137\t\t\tconst version = getProjectVersion();\n   138\t\t\tif (version > 0) {\n   139\t\t\t\tloadData();\n   140\t\t\t}\n   141\t\t});\n   142\t\n   143\t\t// AC: @interactive-triage-ui ac-6 - Real-time update handler\n   144\t\t// AC: @trait-websocket-protocol ac-3 - Handle broadcast event\n   145\t\tfunction handleTriageUpdate(_event: BroadcastEvent) {\n   146\t\t\t// Reload triage records on any triage update\n   147\t\t\tloadTriageData();\n   148\t\t}\n   149\t\n   150\t\tasync function loadData() {\n   151\t\t\ttry {\n   152\t\t\t\tloading = true;\n   153\t\t\t\terror = '';\n   154\t\t\t\tconst [inboxResponse, triageResponse] = await Promise.all([\n   155\t\t\t\t\tfetchInbox({ limit: 1000 }),\n   156\t\t\t\t\tfetchTriageRecords({ limit: 1000 })\n   157\t\t\t\t]);\n   158\t\t\t\tinboxItems = inboxResponse.items;\n   159\t\t\t\ttriageRecords = triageResponse.items;\n   160\t\t\t} catch (err) {\n   161\t\t\t\terror = err instanceof Error ? err.message : 'Failed to load triage data';\n   162\t\t\t} finally {\n   163\t\t\t\tloading = false;\n   164\t\t\t}\n   165\t\t}\n   166\t\n   167\t\tasync function loadTriageData() {\n   168\t\t\ttry {\n   169\t\t\t\tconst triageResponse = await fetchTriageRecords({ limit: 1000 });\n   170\t\t\t\ttriageRecords = triageResponse.items;\n   171\t\t\t} catch (err) {\n   172\t\t\t\tconsole.error('Failed to reload triage records:', err);\n   173\t\t\t}\n   174\t\t}\n   175\t\n   176\t\t// AC: @interactive-triage-ui ac-5 - Navigation\n   177\t\tfunction goNext() {\n   178\t\t\tif (currentIndex < filteredItems.length - 1) {\n   179\t\t\t\tcurrentIndex++;\n   180\t\t\t\tresetForm();\n   181\t\t\t}\n   182\t\t}\n   183\t\n   184\t\tfunction goPrevious() {\n   185\t\t\tif (currentIndex > 0) {\n   186\t\t\t\tcurrentIndex--;\n   187\t\t\t\tresetForm();\n   188\t\t\t}\n   189\t\t}\n   190\t\n   191\t\tfunction resetForm() {\n   192\t\t\tselectedAction = '';\n   193\t\t\treasoning = '';\n   194\t\t\terror = '';\n   195\t\t}\n   196\t\n   197\t\t// Keyboard navigation - skip when focus is on input/textarea elements\n   198\t\tfunction handleKeydown(e: KeyboardEvent) {\n   199\t\t\tconst target = e.target as HTMLElement;\n   200\t\t\tif (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable) {\n   201\t\t\t\treturn;\n   202\t\t\t}\n   203\t\t\tif (e.key === 'ArrowLeft') {\n   204\t\t\t\tgoPrevious();\n   205\t\t\t} else if (e.key === 'ArrowRight') {\n   206\t\t\t\tgoNext();\n   207\t\t\t}\n   208\t\t}\n   209\t\n   210\t\t// AC: @interactive-triage-ui ac-3 - Submit triage decision\n   211\t\tasync function handleSubmit() {\n   212\t\t\tif (!currentItem || !selectedAction || !reasoning.trim()) return;\n   213\t\n   214\t\t\tif (isStaticMode()) {\n   215\t\t\t\terror = 'Cannot submit triage decisions in read-only mode.';\n   216\t\t\t\treturn;\n   217\t\t\t}\n   218\t\n   219\t\t\ttry {\n   220\t\t\t\tsubmitting = true;\n   221\t\t\t\terror = '';\n   222\t\n   223\t\t\t\tconst existing = currentItem.record;\n   224\t\n   225\t\t\t\tif (existing && existing.status !== 'pending') {\n   226\t\t\t\t\t// AC: @interactive-triage-ui ac-4 - Override existing decision\n   227\t\t\t\t\tawait overrideTriageRecord(existing._ulid, {\n   228\t\t\t\t\t\taction: selectedAction,\n   229\t\t\t\t\t\treasoning: reasoning.trim()\n   230\t\t\t\t\t});\n   231\t\t\t\t} else {\n   232\t\t\t\t\t// Create new triage record\n   233\t\t\t\t\tawait createTriageRecord({\n   234\t\t\t\t\t\tinbox_ref: currentItem.inbox._ulid,\n   235\t\t\t\t\t\taction: selectedAction,\n   236\t\t\t\t\t\treasoning: reasoning.trim()\n   237\t\t\t\t\t});\n   238\t\t\t\t}\n   239\t\n   240\t\t\t\t// Reload triage data\n   241\t\t\t\tawait loadTriageData();\n   242\t\n   243\t\t\t\t// Auto-advance to next item\n   244\t\t\t\t// AC: @interactive-triage-ui ac-3 - advances to next item\n   245\t\t\t\tif (currentIndex < filteredItems.length - 1) {\n   246\t\t\t\t\tcurrentIndex++;\n   247\t\t\t\t}\n   248\t\t\t\tresetForm();\n   249\t\t\t} catch (err) {\n   250\t\t\t\tif (err instanceof ReadOnlyModeError) {\n   251\t\t\t\t\terror = err.message;\n   252\t\t\t\t} else {\n   253\t\t\t\t\terror = err instanceof Error ? err.message : 'Failed to submit triage decision';\n   254\t\t\t\t}\n   255\t\t\t} finally {\n   256\t\t\t\tsubmitting = false;\n   257\t\t\t}\n   258\t\t}\n   259\t\n   260\t\t// Execute the triage action\n   261\t\tasync function handleAct() {\n   262\t\t\tif (!currentItem?.record) return;\n   263\t\n   264\t\t\tif (isStaticMode()) {\n   265\t\t\t\terror = 'Cannot execute triage actions in read-only mode.';\n   266\t\t\t\treturn;\n   267\t\t\t}\n   268\t\n   269\t\t\ttry {\n   270\t\t\t\tsubmitting = true;\n   271\t\t\t\terror = '';\n   272\t\t\t\tawait actOnTriageRecord(currentItem.record._ulid);\n   273\t\t\t\tawait loadTriageData();\n   274\t\t\t} catch (err) {\n   275\t\t\t\tif (err instanceof ReadOnlyModeError) {\n   276\t\t\t\t\terror = err.message;\n   277\t\t\t\t} else {\n   278\t\t\t\t\terror = err instanceof Error ? err.message : 'Failed to execute triage action';\n   279\t\t\t\t}\n   280\t\t\t} finally {\n   281\t\t\t\tsubmitting = false;\n   282\t\t\t}\n   283\t\t}\n   284\t\n   285\t\tfunction formatDate(dateString: string): string {\n   286\t\t\tconst date = new Date(dateString);\n   287\t\t\tconst now = new Date();\n   288\t\t\tconst diffMs = now.getTime() - date.getTime();\n   289\t\t\tconst diffMins = Math.floor(diffMs / 60000);\n   290\t\t\tconst diffHours = Math.floor(diffMs / 3600000);\n   291\t\t\tconst diffDays = Math.floor(diffMs / 86400000);\n   292\t\n   293\t\t\tif (diffMins < 1) return 'just now';\n   294\t\t\tif (diffMins < 60) return `${diffMins}m ago`;\n   295\t\t\tif (diffHours < 24) return `${diffHours}h ago`;\n   296\t\t\tif (diffDays < 7) return `${diffDays}d ago`;\n   297\t\n   298\t\t\treturn date.toLocaleDateString();\n   299\t\t}\n   300\t\n   301\t\t// AC: @interactive-triage-ui ac-7 - Reset index when filter changes\n   302\t\t$effect(() => {\n   303\t\t\t// Reading filter values creates reactive dependencies\n   304\t\t\tconst _tag = filterTag;\n   305\t\t\tconst _status = filterStatus;\n   306\t\t\tconst _action = filterAction;\n   307\t\t\tcurrentIndex = 0;\n   308\t\t\tresetForm();\n   309\t\t});\n   310\t</script>\n   311\t\n   312\t<svelte:window onkeydown={handleKeydown} />\n   313\t\n   314\t<!-- AC: @interactive-triage-ui ac-1, ac-5, ac-7 -->\n   315\t<div class=\"flex flex-col gap-4 p-6\">\n   316\t\t<div class=\"flex items-center justify-between\">\n   317\t\t\t<div>\n   318\t\t\t\t<h1 class=\"text-3xl font-bold\">Triage</h1>\n   319\t\t\t\t{#if !loading}\n   320\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-7 - Progress count -->\n   321\t\t\t\t\t<p class=\"text-muted-foreground\" data-testid=\"triage-progress\">\n   322\t\t\t\t\t\t{triagedCount} of {totalCount} triaged\n   323\t\t\t\t\t\t{#if filteredItems.length !== allItems.length}\n   324\t\t\t\t\t\t\t&middot; Showing {filteredItems.length} filtered\n   325\t\t\t\t\t\t{/if}\n   326\t\t\t\t\t</p>\n   327\t\t\t\t{/if}\n   328\t\t\t</div>\n   329\t\n   330\t\t\t<!-- AC: @interactive-triage-ui ac-7 - Filters -->\n   331\t\t\t<div class=\"flex gap-2 items-center\" data-testid=\"triage-filters\">\n   332\t\t\t\t<select\n   333\t\t\t\t\tbind:value={filterStatus}\n   334\t\t\t\t\tclass=\"rounded-md border bg-background px-3 py-1.5 text-sm\"\n   335\t\t\t\t\tdata-testid=\"triage-status-filter\"\n   336\t\t\t\t>\n   337\t\t\t\t\t<option value=\"all\">All</option>\n   338\t\t\t\t\t<option value=\"untriaged\">Untriaged</option>\n   339\t\t\t\t\t<option value=\"triaged\">Triaged</option>\n   340\t\t\t\t\t<option value=\"acted_on\">Acted On</option>\n   341\t\t\t\t</select>\n   342\t\t\t\t<select\n   343\t\t\t\t\tbind:value={filterAction}\n   344\t\t\t\t\tclass=\"rounded-md border bg-background px-3 py-1.5 text-sm\"\n   345\t\t\t\t\tdata-testid=\"triage-action-filter\"\n   346\t\t\t\t>\n   347\t\t\t\t\t<option value=\"\">All Actions</option>\n   348\t\t\t\t\t{#each Object.entries(ACTION_LABELS) as [action, label]}\n   349\t\t\t\t\t\t<option value={action}>{label}</option>\n   350\t\t\t\t\t{/each}\n   351\t\t\t\t</select>\n   352\t\t\t\t{#if allTags.length > 0}\n   353\t\t\t\t\t<select\n   354\t\t\t\t\t\tbind:value={filterTag}\n   355\t\t\t\t\t\tclass=\"rounded-md border bg-background px-3 py-1.5 text-sm\"\n   356\t\t\t\t\t\tdata-testid=\"triage-tag-filter\"\n   357\t\t\t\t\t>\n   358\t\t\t\t\t\t<option value=\"\">All Tags</option>\n   359\t\t\t\t\t\t{#each allTags as tag}\n   360\t\t\t\t\t\t\t<option value={tag}>{tag}</option>\n   361\t\t\t\t\t\t{/each}\n   362\t\t\t\t\t</select>\n   363\t\t\t\t{/if}\n   364\t\t\t</div>\n   365\t\t</div>\n   366\t\n   367\t\t<!-- Progress bar -->\n   368\t\t{#if totalCount > 0}\n   369\t\t\t<div class=\"w-full bg-muted rounded-full h-2\" data-testid=\"triage-progress-bar\">\n   370\t\t\t\t<div\n   371\t\t\t\t\tclass=\"bg-primary rounded-full h-2 transition-all duration-300\"\n   372\t\t\t\t\tstyle=\"width: {(triagedCount / totalCount) * 100}%\"\n   373\t\t\t\t></div>\n   374\t\t\t</div>\n   375\t\t{/if}\n   376\t\n   377\t\t{#if error}\n   378\t\t\t<div class=\"rounded-md bg-red-50 p-4 text-sm text-red-800 dark:bg-red-900/20 dark:text-red-200\" data-testid=\"triage-error\" role=\"alert\">\n   379\t\t\t\t{error}\n   380\t\t\t</div>\n   381\t\t{/if}\n   382\t\n   383\t\t<!-- AC: @interactive-triage-ui ac-8 - Static mode notice -->\n   384\t\t{#if isStaticMode() && !loading}\n   385\t\t\t<div class=\"rounded-md bg-amber-50 p-3 text-sm text-amber-800 dark:bg-amber-900/20 dark:text-amber-200\" data-testid=\"triage-static-notice\">\n   386\t\t\t\tTriage decisions are not included in static snapshots. Browse inbox items below; use the daemon for full triage functionality.\n   387\t\t\t</div>\n   388\t\t{/if}\n   389\t\n   390\t\t{#if loading}\n   391\t\t\t<div class=\"text-center text-muted-foreground py-12\">Loading triage data...</div>\n   392\t\t{:else if filteredItems.length === 0}\n   393\t\t\t<div class=\"text-center text-muted-foreground py-12\">\n   394\t\t\t\t{#if allItems.length === 0}\n   395\t\t\t\t\t<p>No inbox items to triage.</p>\n   396\t\t\t\t\t<p class=\"text-sm mt-1\">Add items to your inbox first.</p>\n   397\t\t\t\t{:else}\n   398\t\t\t\t\t<p>No items match the current filters.</p>\n   399\t\t\t\t{/if}\n   400\t\t\t</div>\n   401\t\t{:else if currentItem}\n   402\t\t\t<!-- Card navigation -->\n   403\t\t\t<div class=\"flex items-center justify-between mb-2\">\n   404\t\t\t\t<!-- AC: @interactive-triage-ui ac-5 - Navigation controls -->\n   405\t\t\t\t<Button\n   406\t\t\t\t\tvariant=\"outline\"\n   407\t\t\t\t\tsize=\"sm\"\n   408\t\t\t\t\tonclick={goPrevious}\n   409\t\t\t\t\tdisabled={currentIndex === 0}\n   410\t\t\t\t\tdata-testid=\"triage-prev\"\n   411\t\t\t\t>\n   412\t\t\t\t\t<ChevronLeftIcon class=\"size-4 mr-1\" />\n   413\t\t\t\t\tPrevious\n   414\t\t\t\t</Button>\n   415\t\t\t\t<span class=\"text-sm text-muted-foreground\" data-testid=\"triage-position\">\n   416\t\t\t\t\t{currentIndex + 1} / {filteredItems.length}\n   417\t\t\t\t</span>\n   418\t\t\t\t<Button\n   419\t\t\t\t\tvariant=\"outline\"\n   420\t\t\t\t\tsize=\"sm\"\n   421\t\t\t\t\tonclick={goNext}\n   422\t\t\t\t\tdisabled={currentIndex === filteredItems.length - 1}\n   423\t\t\t\t\tdata-testid=\"triage-next\"\n   424\t\t\t\t>\n   425\t\t\t\t\tNext\n   426\t\t\t\t\t<ChevronRightIcon class=\"size-4 ml-1\" />\n   427\t\t\t\t</Button>\n   428\t\t\t</div>\n   429\t\n   430\t\t\t<!-- AC: @interactive-triage-ui ac-1 - Card view showing item text, tags, age, added_by -->\n   431\t\t\t<Card class=\"transition-all duration-200\" data-testid=\"triage-card\">\n   432\t\t\t\t<CardHeader>\n   433\t\t\t\t\t<div class=\"flex items-start justify-between gap-4\">\n   434\t\t\t\t\t\t<CardTitle class=\"text-lg leading-relaxed\" data-testid=\"triage-card-text\">\n   435\t\t\t\t\t\t\t{currentItem.inbox.text}\n   436\t\t\t\t\t\t</CardTitle>\n   437\t\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-5 - Show decision state on already-triaged items -->\n   438\t\t\t\t\t\t{#if currentItem.record && currentItem.record.status !== 'pending'}\n   439\t\t\t\t\t\t\t<Badge\n   440\t\t\t\t\t\t\t\tclass={currentItem.record.action ? ACTION_COLORS[currentItem.record.action] : 'bg-gray-500'}\n   441\t\t\t\t\t\t\t\tdata-testid=\"triage-card-status\"\n   442\t\t\t\t\t\t\t>\n   443\t\t\t\t\t\t\t\t{currentItem.record.status === 'acted_on' ? 'Acted' : 'Triaged'}\n   444\t\t\t\t\t\t\t</Badge>\n   445\t\t\t\t\t\t{/if}\n   446\t\t\t\t\t</div>\n   447\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-1 - tags, age, added_by -->\n   448\t\t\t\t\t<div class=\"flex items-center gap-2 text-xs text-muted-foreground mt-2\" data-testid=\"triage-card-meta\">\n   449\t\t\t\t\t\t<span data-testid=\"triage-card-age\">{formatDate(currentItem.inbox.created_at)}</span>\n   450\t\t\t\t\t\t<span>&middot;</span>\n   451\t\t\t\t\t\t<span data-testid=\"triage-card-added-by\">{currentItem.inbox.added_by}</span>\n   452\t\t\t\t\t\t{#if currentItem.inbox.tags.length > 0}\n   453\t\t\t\t\t\t\t<span>&middot;</span>\n   454\t\t\t\t\t\t\t<div class=\"flex gap-1\" data-testid=\"triage-card-tags\">\n   455\t\t\t\t\t\t\t\t{#each currentItem.inbox.tags as tag}\n   456\t\t\t\t\t\t\t\t\t<Badge variant=\"secondary\" class=\"text-xs\">{tag}</Badge>\n   457\t\t\t\t\t\t\t\t{/each}\n   458\t\t\t\t\t\t\t</div>\n   459\t\t\t\t\t\t{/if}\n   460\t\t\t\t\t</div>\n   461\t\t\t\t</CardHeader>\n   462\t\t\t\t<CardContent>\n   463\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-2 - Show agent recommendation if exists -->\n   464\t\t\t\t\t{#if currentItem.record && currentItem.record.status !== 'pending'}\n   465\t\t\t\t\t\t<div class=\"rounded-md bg-muted p-4 mb-4\" data-testid=\"triage-agent-recommendation\">\n   466\t\t\t\t\t\t\t<p class=\"text-sm font-medium mb-2\">\n   467\t\t\t\t\t\t\t\t{#if currentItem.record.override_by}\n   468\t\t\t\t\t\t\t\t\tOverride Decision\n   469\t\t\t\t\t\t\t\t{:else}\n   470\t\t\t\t\t\t\t\t\tAgent Recommendation\n   471\t\t\t\t\t\t\t\t{/if}\n   472\t\t\t\t\t\t\t</p>\n   473\t\t\t\t\t\t\t<div class=\"space-y-1 text-sm\">\n   474\t\t\t\t\t\t\t\t<p data-testid=\"triage-rec-action\">\n   475\t\t\t\t\t\t\t\t\t<span class=\"font-medium\">Action:</span>\n   476\t\t\t\t\t\t\t\t\t{currentItem.record.action ? ACTION_LABELS[currentItem.record.action] : 'None'}\n   477\t\t\t\t\t\t\t\t</p>\n   478\t\t\t\t\t\t\t\t<p data-testid=\"triage-rec-reasoning\">\n   479\t\t\t\t\t\t\t\t\t<span class=\"font-medium\">Reasoning:</span>\n   480\t\t\t\t\t\t\t\t\t{currentItem.record.override_reasoning || currentItem.record.reasoning}\n   481\t\t\t\t\t\t\t\t</p>\n   482\t\t\t\t\t\t\t\t{#if currentItem.record.evidence_refs.length > 0}\n   483\t\t\t\t\t\t\t\t\t<p data-testid=\"triage-rec-evidence\">\n   484\t\t\t\t\t\t\t\t\t\t<span class=\"font-medium\">Evidence:</span>\n   485\t\t\t\t\t\t\t\t\t\t{currentItem.record.evidence_refs.join(', ')}\n   486\t\t\t\t\t\t\t\t\t</p>\n   487\t\t\t\t\t\t\t\t{/if}\n   488\t\t\t\t\t\t\t\t<p class=\"text-xs text-muted-foreground\">\n   489\t\t\t\t\t\t\t\t\tDecided by: {currentItem.record.override_by || currentItem.record.decided_by}\n   490\t\t\t\t\t\t\t\t</p>\n   491\t\t\t\t\t\t\t</div>\n   492\t\t\t\t\t\t</div>\n   493\t\t\t\t\t{/if}\n   494\t\n   495\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-8 - Hide action UI in static mode -->\n   496\t\t\t\t\t{#if !isStaticMode()}\n   497\t\t\t\t\t\t<Separator class=\"my-4\" />\n   498\t\n   499\t\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-3, ac-4 - Action selection and reasoning -->\n   500\t\t\t\t\t\t<div class=\"space-y-4\" data-testid=\"triage-action-form\">\n   501\t\t\t\t\t\t\t<div>\n   502\t\t\t\t\t\t\t\t<p class=\"text-sm font-medium mb-2\">\n   503\t\t\t\t\t\t\t\t\t{currentItem.record && currentItem.record.status !== 'pending' ? 'Override Action' : 'Select Action'}\n   504\t\t\t\t\t\t\t\t</p>\n   505\t\t\t\t\t\t\t\t<div class=\"flex flex-wrap gap-2\" data-testid=\"triage-action-buttons\">\n   506\t\t\t\t\t\t\t\t\t{#each Object.entries(ACTION_LABELS) as [action, label]}\n   507\t\t\t\t\t\t\t\t\t\t<Button\n   508\t\t\t\t\t\t\t\t\t\t\tvariant={selectedAction === action ? 'default' : 'outline'}\n   509\t\t\t\t\t\t\t\t\t\t\tsize=\"sm\"\n   510\t\t\t\t\t\t\t\t\t\t\tonclick={() => (selectedAction = action as TriageAction)}\n   511\t\t\t\t\t\t\t\t\t\t\tdata-testid=\"triage-action-{action}\"\n   512\t\t\t\t\t\t\t\t\t\t>\n   513\t\t\t\t\t\t\t\t\t\t\t{label}\n   514\t\t\t\t\t\t\t\t\t\t</Button>\n   515\t\t\t\t\t\t\t\t\t{/each}\n   516\t\t\t\t\t\t\t\t</div>\n   517\t\t\t\t\t\t\t</div>\n   518\t\n   519\t\t\t\t\t\t\t<div>\n   520\t\t\t\t\t\t\t\t<p class=\"text-sm font-medium mb-2\">Reasoning</p>\n   521\t\t\t\t\t\t\t\t<Textarea\n   522\t\t\t\t\t\t\t\t\tplaceholder=\"Why are you choosing this action?\"\n   523\t\t\t\t\t\t\t\t\tbind:value={reasoning}\n   524\t\t\t\t\t\t\t\t\trows={3}\n   525\t\t\t\t\t\t\t\t\tdisabled={submitting}\n   526\t\t\t\t\t\t\t\t\tdata-testid=\"triage-reasoning\"\n   527\t\t\t\t\t\t\t\t/>\n   528\t\t\t\t\t\t\t</div>\n   529\t\n   530\t\t\t\t\t\t\t<div class=\"flex gap-2\">\n   531\t\t\t\t\t\t\t\t<Button\n   532\t\t\t\t\t\t\t\t\tonclick={handleSubmit}\n   533\t\t\t\t\t\t\t\t\tdisabled={submitting || !selectedAction || !reasoning.trim()}\n   534\t\t\t\t\t\t\t\t\tdata-testid=\"triage-submit\"\n   535\t\t\t\t\t\t\t\t>\n   536\t\t\t\t\t\t\t\t\t{#if submitting}\n   537\t\t\t\t\t\t\t\t\t\tSubmitting...\n   538\t\t\t\t\t\t\t\t\t{:else if currentItem.record && currentItem.record.status !== 'pending'}\n   539\t\t\t\t\t\t\t\t\t\tOverride Decision\n   540\t\t\t\t\t\t\t\t\t{:else}\n   541\t\t\t\t\t\t\t\t\t\tSubmit Decision\n   542\t\t\t\t\t\t\t\t\t{/if}\n   543\t\t\t\t\t\t\t\t</Button>\n   544\t\n   545\t\t\t\t\t\t\t\t{#if currentItem.record?.status === 'triaged'}\n   546\t\t\t\t\t\t\t\t\t<Button\n   547\t\t\t\t\t\t\t\t\t\tvariant=\"secondary\"\n   548\t\t\t\t\t\t\t\t\t\tonclick={handleAct}\n   549\t\t\t\t\t\t\t\t\t\tdisabled={submitting}\n   550\t\t\t\t\t\t\t\t\t\tdata-testid=\"triage-act\"\n   551\t\t\t\t\t\t\t\t\t>\n   552\t\t\t\t\t\t\t\t\t\t{submitting ? 'Executing...' : `Execute: ${currentItem.record.action ? ACTION_LABELS[currentItem.record.action] : ''}`}\n   553\t\t\t\t\t\t\t\t\t</Button>\n   554\t\t\t\t\t\t\t\t{/if}\n   555\t\t\t\t\t\t\t</div>\n   556\t\t\t\t\t\t</div>\n   557\t\t\t\t\t{:else}\n   558\t\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-8 - Static mode: browsing only -->\n   559\t\t\t\t\t\t{#if !currentItem.record}\n   560\t\t\t\t\t\t\t<p class=\"text-sm text-muted-foreground mt-4\">\n   561\t\t\t\t\t\t\t\tNo triage decision recorded. Use the CLI or daemon to triage items.\n   562\t\t\t\t\t\t\t</p>\n   563\t\t\t\t\t\t{/if}\n   564\t\t\t\t\t{/if}\n   565\t\t\t\t</CardContent>\n   566\t\t\t</Card>\n   567\t\t{/if}\n   568\t</div>\n","stderr":"","aggregated_output":"     1\t<script lang=\"ts\">\n     2\t\t// AC: @interactive-triage-ui ac-1, ac-2, ac-3, ac-4, ac-5, ac-6, ac-7, ac-8\n     3\t\t// AC: @trait-websocket-protocol ac-1, ac-2, ac-3\n     4\t\timport { onMount, onDestroy } from 'svelte';\n     5\t\timport type { InboxItem, BroadcastEvent } from '@kynetic-ai/shared';\n     6\t\timport type { TriageRecord, TriageAction } from '$lib/types/triage';\n     7\t\timport {\n     8\t\t\tfetchInbox,\n     9\t\t\tfetchTriageRecords,\n    10\t\t\tcreateTriageRecord,\n    11\t\t\toverrideTriageRecord,\n    12\t\t\tactOnTriageRecord\n    13\t\t} from '$lib/api';\n    14\t\timport { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';\n    15\t\timport { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';\n    16\t\timport { getProjectVersion } from '$lib/stores/project.svelte';\n    17\t\timport { Button } from '$lib/components/ui/button';\n    18\t\timport { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';\n    19\t\timport { Badge } from '$lib/components/ui/badge';\n    20\t\timport { Textarea } from '$lib/components/ui/textarea';\n    21\t\timport { Separator } from '$lib/components/ui/separator';\n    22\t\timport ChevronLeftIcon from '@lucide/svelte/icons/chevron-left';\n    23\t\timport ChevronRightIcon from '@lucide/svelte/icons/chevron-right';\n    24\t\n    25\t\t// Data state\n    26\t\tlet inboxItems = $state<InboxItem[]>([]);\n    27\t\tlet triageRecords = $state<TriageRecord[]>([]);\n    28\t\tlet loading = $state(true);\n    29\t\tlet error = $state('');\n    30\t\n    31\t\t// Card navigation state\n    32\t\t// AC: @interactive-triage-ui ac-5\n    33\t\tlet currentIndex = $state(0);\n    34\t\tlet submitting = $state(false);\n    35\t\n    36\t\t// Form state\n    37\t\t// AC: @interactive-triage-ui ac-3\n    38\t\tlet selectedAction = $state<TriageAction | ''>('');\n    39\t\tlet reasoning = $state('');\n    40\t\n    41\t\t// Filter state\n    42\t\t// AC: @interactive-triage-ui ac-7\n    43\t\tlet filterTag = $state<string | ''>('');\n    44\t\tlet filterStatus = $state<'all' | 'untriaged' | 'triaged' | 'acted_on'>('all');\n    45\t\tlet filterAction = $state<TriageAction | ''>('');\n    46\t\n    47\t\t// Action labels\n    48\t\tconst ACTION_LABELS: Record<TriageAction, string> = {\n    49\t\t\tpromote: 'Promote to Task',\n    50\t\t\tdelete: 'Delete',\n    51\t\t\tdefer: 'Defer',\n    52\t\t\t'spec-gap': 'Spec Gap',\n    53\t\t\tduplicate: 'Duplicate'\n    54\t\t};\n    55\t\n    56\t\tconst ACTION_COLORS: Record<TriageAction, string> = {\n    57\t\t\tpromote: 'bg-green-500',\n    58\t\t\tdelete: 'bg-red-500',\n    59\t\t\tdefer: 'bg-yellow-500',\n    60\t\t\t'spec-gap': 'bg-purple-500',\n    61\t\t\tduplicate: 'bg-gray-500'\n    62\t\t};\n    63\t\n    64\t\t// Merged view: inbox items with their triage records\n    65\t\tinterface TriageCardItem {\n    66\t\t\tinbox: InboxItem;\n    67\t\t\trecord: TriageRecord | null;\n    68\t\t}\n    69\t\n    70\t\t// AC: @interactive-triage-ui ac-7 - Filtered items\n    71\t\tlet allItems = $derived.by(() => {\n    72\t\t\tconst items: TriageCardItem[] = inboxItems.map((inbox) => {\n    73\t\t\t\tconst record = triageRecords.find((r) => r.inbox_ref === inbox._ulid) ?? null;\n    74\t\t\t\treturn { inbox, record };\n    75\t\t\t});\n    76\t\t\treturn items;\n    77\t\t});\n    78\t\n    79\t\tlet filteredItems = $derived.by(() => {\n    80\t\t\tlet items = allItems;\n    81\t\n    82\t\t\t// Tag filter\n    83\t\t\tif (filterTag) {\n    84\t\t\t\titems = items.filter((i) => i.inbox.tags.includes(filterTag));\n    85\t\t\t}\n    86\t\n    87\t\t\t// Status filter\n    88\t\t\tif (filterStatus === 'untriaged') {\n    89\t\t\t\titems = items.filter((i) => !i.record || i.record.status === 'pending');\n    90\t\t\t} else if (filterStatus === 'triaged') {\n    91\t\t\t\titems = items.filter((i) => i.record?.status === 'triaged');\n    92\t\t\t} else if (filterStatus === 'acted_on') {\n    93\t\t\t\titems = items.filter((i) => i.record?.status === 'acted_on');\n    94\t\t\t}\n    95\t\n    96\t\t\t// Action filter\n    97\t\t\tif (filterAction) {\n    98\t\t\t\titems = items.filter((i) => i.record?.action === filterAction);\n    99\t\t\t}\n   100\t\n   101\t\t\treturn items;\n   102\t\t});\n   103\t\n   104\t\tlet currentItem = $derived(filteredItems[currentIndex] ?? null);\n   105\t\n   106\t\t// AC: @interactive-triage-ui ac-7 - Progress count\n   107\t\tlet triagedCount = $derived(allItems.filter((i) => i.record && i.record.status !== 'pending').length);\n   108\t\tlet totalCount = $derived(allItems.length);\n   109\t\n   110\t\t// All unique tags for filter\n   111\t\tlet allTags = $derived.by(() => {\n   112\t\t\tconst tagSet = new Set<string>();\n   113\t\t\tinboxItems.forEach((item) => item.tags.forEach((t) => tagSet.add(t)));\n   114\t\t\treturn Array.from(tagSet).sort();\n   115\t\t});\n   116\t\n   117\t\tonMount(async () => {\n   118\t\t\tawait loadData();\n   119\t\n   120\t\t\t// AC: @interactive-triage-ui ac-6 - Subscribe to triage:updates\n   121\t\t\t// AC: @trait-websocket-protocol ac-2 - Subscribe to topic\n   122\t\t\tif (!isStaticMode()) {\n   123\t\t\t\tsubscribe(['triage:updates']);\n   124\t\t\t\ton('triage:updates', handleTriageUpdate);\n   125\t\t\t}\n   126\t\t});\n   127\t\n   128\t\tonDestroy(() => {\n   129\t\t\tif (!isStaticMode()) {\n   130\t\t\t\toff('triage:updates', handleTriageUpdate);\n   131\t\t\t\tunsubscribe(['triage:updates']);\n   132\t\t\t}\n   133\t\t});\n   134\t\n   135\t\t// AC: @multi-directory-daemon ac-27 - Reload on project change\n   136\t\t$effect(() => {\n   137\t\t\tconst version = getProjectVersion();\n   138\t\t\tif (version > 0) {\n   139\t\t\t\tloadData();\n   140\t\t\t}\n   141\t\t});\n   142\t\n   143\t\t// AC: @interactive-triage-ui ac-6 - Real-time update handler\n   144\t\t// AC: @trait-websocket-protocol ac-3 - Handle broadcast event\n   145\t\tfunction handleTriageUpdate(_event: BroadcastEvent) {\n   146\t\t\t// Reload triage records on any triage update\n   147\t\t\tloadTriageData();\n   148\t\t}\n   149\t\n   150\t\tasync function loadData() {\n   151\t\t\ttry {\n   152\t\t\t\tloading = true;\n   153\t\t\t\terror = '';\n   154\t\t\t\tconst [inboxResponse, triageResponse] = await Promise.all([\n   155\t\t\t\t\tfetchInbox({ limit: 1000 }),\n   156\t\t\t\t\tfetchTriageRecords({ limit: 1000 })\n   157\t\t\t\t]);\n   158\t\t\t\tinboxItems = inboxResponse.items;\n   159\t\t\t\ttriageRecords = triageResponse.items;\n   160\t\t\t} catch (err) {\n   161\t\t\t\terror = err instanceof Error ? err.message : 'Failed to load triage data';\n   162\t\t\t} finally {\n   163\t\t\t\tloading = false;\n   164\t\t\t}\n   165\t\t}\n   166\t\n   167\t\tasync function loadTriageData() {\n   168\t\t\ttry {\n   169\t\t\t\tconst triageResponse = await fetchTriageRecords({ limit: 1000 });\n   170\t\t\t\ttriageRecords = triageResponse.items;\n   171\t\t\t} catch (err) {\n   172\t\t\t\tconsole.error('Failed to reload triage records:', err);\n   173\t\t\t}\n   174\t\t}\n   175\t\n   176\t\t// AC: @interactive-triage-ui ac-5 - Navigation\n   177\t\tfunction goNext() {\n   178\t\t\tif (currentIndex < filteredItems.length - 1) {\n   179\t\t\t\tcurrentIndex++;\n   180\t\t\t\tresetForm();\n   181\t\t\t}\n   182\t\t}\n   183\t\n   184\t\tfunction goPrevious() {\n   185\t\t\tif (currentIndex > 0) {\n   186\t\t\t\tcurrentIndex--;\n   187\t\t\t\tresetForm();\n   188\t\t\t}\n   189\t\t}\n   190\t\n   191\t\tfunction resetForm() {\n   192\t\t\tselectedAction = '';\n   193\t\t\treasoning = '';\n   194\t\t\terror = '';\n   195\t\t}\n   196\t\n   197\t\t// Keyboard navigation - skip when focus is on input/textarea elements\n   198\t\tfunction handleKeydown(e: KeyboardEvent) {\n   199\t\t\tconst target = e.target as HTMLElement;\n   200\t\t\tif (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable) {\n   201\t\t\t\treturn;\n   202\t\t\t}\n   203\t\t\tif (e.key === 'ArrowLeft') {\n   204\t\t\t\tgoPrevious();\n   205\t\t\t} else if (e.key === 'ArrowRight') {\n   206\t\t\t\tgoNext();\n   207\t\t\t}\n   208\t\t}\n   209\t\n   210\t\t// AC: @interactive-triage-ui ac-3 - Submit triage decision\n   211\t\tasync function handleSubmit() {\n   212\t\t\tif (!currentItem || !selectedAction || !reasoning.trim()) return;\n   213\t\n   214\t\t\tif (isStaticMode()) {\n   215\t\t\t\terror = 'Cannot submit triage decisions in read-only mode.';\n   216\t\t\t\treturn;\n   217\t\t\t}\n   218\t\n   219\t\t\ttry {\n   220\t\t\t\tsubmitting = true;\n   221\t\t\t\terror = '';\n   222\t\n   223\t\t\t\tconst existing = currentItem.record;\n   224\t\n   225\t\t\t\tif (existing && existing.status !== 'pending') {\n   226\t\t\t\t\t// AC: @interactive-triage-ui ac-4 - Override existing decision\n   227\t\t\t\t\tawait overrideTriageRecord(existing._ulid, {\n   228\t\t\t\t\t\taction: selectedAction,\n   229\t\t\t\t\t\treasoning: reasoning.trim()\n   230\t\t\t\t\t});\n   231\t\t\t\t} else {\n   232\t\t\t\t\t// Create new triage record\n   233\t\t\t\t\tawait createTriageRecord({\n   234\t\t\t\t\t\tinbox_ref: currentItem.inbox._ulid,\n   235\t\t\t\t\t\taction: selectedAction,\n   236\t\t\t\t\t\treasoning: reasoning.trim()\n   237\t\t\t\t\t});\n   238\t\t\t\t}\n   239\t\n   240\t\t\t\t// Reload triage data\n   241\t\t\t\tawait loadTriageData();\n   242\t\n   243\t\t\t\t// Auto-advance to next item\n   244\t\t\t\t// AC: @interactive-triage-ui ac-3 - advances to next item\n   245\t\t\t\tif (currentIndex < filteredItems.length - 1) {\n   246\t\t\t\t\tcurrentIndex++;\n   247\t\t\t\t}\n   248\t\t\t\tresetForm();\n   249\t\t\t} catch (err) {\n   250\t\t\t\tif (err instanceof ReadOnlyModeError) {\n   251\t\t\t\t\terror = err.message;\n   252\t\t\t\t} else {\n   253\t\t\t\t\terror = err instanceof Error ? err.message : 'Failed to submit triage decision';\n   254\t\t\t\t}\n   255\t\t\t} finally {\n   256\t\t\t\tsubmitting = false;\n   257\t\t\t}\n   258\t\t}\n   259\t\n   260\t\t// Execute the triage action\n   261\t\tasync function handleAct() {\n   262\t\t\tif (!currentItem?.record) return;\n   263\t\n   264\t\t\tif (isStaticMode()) {\n   265\t\t\t\terror = 'Cannot execute triage actions in read-only mode.';\n   266\t\t\t\treturn;\n   267\t\t\t}\n   268\t\n   269\t\t\ttry {\n   270\t\t\t\tsubmitting = true;\n   271\t\t\t\terror = '';\n   272\t\t\t\tawait actOnTriageRecord(currentItem.record._ulid);\n   273\t\t\t\tawait loadTriageData();\n   274\t\t\t} catch (err) {\n   275\t\t\t\tif (err instanceof ReadOnlyModeError) {\n   276\t\t\t\t\terror = err.message;\n   277\t\t\t\t} else {\n   278\t\t\t\t\terror = err instanceof Error ? err.message : 'Failed to execute triage action';\n   279\t\t\t\t}\n   280\t\t\t} finally {\n   281\t\t\t\tsubmitting = false;\n   282\t\t\t}\n   283\t\t}\n   284\t\n   285\t\tfunction formatDate(dateString: string): string {\n   286\t\t\tconst date = new Date(dateString);\n   287\t\t\tconst now = new Date();\n   288\t\t\tconst diffMs = now.getTime() - date.getTime();\n   289\t\t\tconst diffMins = Math.floor(diffMs / 60000);\n   290\t\t\tconst diffHours = Math.floor(diffMs / 3600000);\n   291\t\t\tconst diffDays = Math.floor(diffMs / 86400000);\n   292\t\n   293\t\t\tif (diffMins < 1) return 'just now';\n   294\t\t\tif (diffMins < 60) return `${diffMins}m ago`;\n   295\t\t\tif (diffHours < 24) return `${diffHours}h ago`;\n   296\t\t\tif (diffDays < 7) return `${diffDays}d ago`;\n   297\t\n   298\t\t\treturn date.toLocaleDateString();\n   299\t\t}\n   300\t\n   301\t\t// AC: @interactive-triage-ui ac-7 - Reset index when filter changes\n   302\t\t$effect(() => {\n   303\t\t\t// Reading filter values creates reactive dependencies\n   304\t\t\tconst _tag = filterTag;\n   305\t\t\tconst _status = filterStatus;\n   306\t\t\tconst _action = filterAction;\n   307\t\t\tcurrentIndex = 0;\n   308\t\t\tresetForm();\n   309\t\t});\n   310\t</script>\n   311\t\n   312\t<svelte:window onkeydown={handleKeydown} />\n   313\t\n   314\t<!-- AC: @interactive-triage-ui ac-1, ac-5, ac-7 -->\n   315\t<div class=\"flex flex-col gap-4 p-6\">\n   316\t\t<div class=\"flex items-center justify-between\">\n   317\t\t\t<div>\n   318\t\t\t\t<h1 class=\"text-3xl font-bold\">Triage</h1>\n   319\t\t\t\t{#if !loading}\n   320\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-7 - Progress count -->\n   321\t\t\t\t\t<p class=\"text-muted-foreground\" data-testid=\"triage-progress\">\n   322\t\t\t\t\t\t{triagedCount} of {totalCount} triaged\n   323\t\t\t\t\t\t{#if filteredItems.length !== allItems.length}\n   324\t\t\t\t\t\t\t&middot; Showing {filteredItems.length} filtered\n   325\t\t\t\t\t\t{/if}\n   326\t\t\t\t\t</p>\n   327\t\t\t\t{/if}\n   328\t\t\t</div>\n   329\t\n   330\t\t\t<!-- AC: @interactive-triage-ui ac-7 - Filters -->\n   331\t\t\t<div class=\"flex gap-2 items-center\" data-testid=\"triage-filters\">\n   332\t\t\t\t<select\n   333\t\t\t\t\tbind:value={filterStatus}\n   334\t\t\t\t\tclass=\"rounded-md border bg-background px-3 py-1.5 text-sm\"\n   335\t\t\t\t\tdata-testid=\"triage-status-filter\"\n   336\t\t\t\t>\n   337\t\t\t\t\t<option value=\"all\">All</option>\n   338\t\t\t\t\t<option value=\"untriaged\">Untriaged</option>\n   339\t\t\t\t\t<option value=\"triaged\">Triaged</option>\n   340\t\t\t\t\t<option value=\"acted_on\">Acted On</option>\n   341\t\t\t\t</select>\n   342\t\t\t\t<select\n   343\t\t\t\t\tbind:value={filterAction}\n   344\t\t\t\t\tclass=\"rounded-md border bg-background px-3 py-1.5 text-sm\"\n   345\t\t\t\t\tdata-testid=\"triage-action-filter\"\n   346\t\t\t\t>\n   347\t\t\t\t\t<option value=\"\">All Actions</option>\n   348\t\t\t\t\t{#each Object.entries(ACTION_LABELS) as [action, label]}\n   349\t\t\t\t\t\t<option value={action}>{label}</option>\n   350\t\t\t\t\t{/each}\n   351\t\t\t\t</select>\n   352\t\t\t\t{#if allTags.length > 0}\n   353\t\t\t\t\t<select\n   354\t\t\t\t\t\tbind:value={filterTag}\n   355\t\t\t\t\t\tclass=\"rounded-md border bg-background px-3 py-1.5 text-sm\"\n   356\t\t\t\t\t\tdata-testid=\"triage-tag-filter\"\n   357\t\t\t\t\t>\n   358\t\t\t\t\t\t<option value=\"\">All Tags</option>\n   359\t\t\t\t\t\t{#each allTags as tag}\n   360\t\t\t\t\t\t\t<option value={tag}>{tag}</option>\n   361\t\t\t\t\t\t{/each}\n   362\t\t\t\t\t</select>\n   363\t\t\t\t{/if}\n   364\t\t\t</div>\n   365\t\t</div>\n   366\t\n   367\t\t<!-- Progress bar -->\n   368\t\t{#if totalCount > 0}\n   369\t\t\t<div class=\"w-full bg-muted rounded-full h-2\" data-testid=\"triage-progress-bar\">\n   370\t\t\t\t<div\n   371\t\t\t\t\tclass=\"bg-primary rounded-full h-2 transition-all duration-300\"\n   372\t\t\t\t\tstyle=\"width: {(triagedCount / totalCount) * 100}%\"\n   373\t\t\t\t></div>\n   374\t\t\t</div>\n   375\t\t{/if}\n   376\t\n   377\t\t{#if error}\n   378\t\t\t<div class=\"rounded-md bg-red-50 p-4 text-sm text-red-800 dark:bg-red-900/20 dark:text-red-200\" data-testid=\"triage-error\" role=\"alert\">\n   379\t\t\t\t{error}\n   380\t\t\t</div>\n   381\t\t{/if}\n   382\t\n   383\t\t<!-- AC: @interactive-triage-ui ac-8 - Static mode notice -->\n   384\t\t{#if isStaticMode() && !loading}\n   385\t\t\t<div class=\"rounded-md bg-amber-50 p-3 text-sm text-amber-800 dark:bg-amber-900/20 dark:text-amber-200\" data-testid=\"triage-static-notice\">\n   386\t\t\t\tTriage decisions are not included in static snapshots. Browse inbox items below; use the daemon for full triage functionality.\n   387\t\t\t</div>\n   388\t\t{/if}\n   389\t\n   390\t\t{#if loading}\n   391\t\t\t<div class=\"text-center text-muted-foreground py-12\">Loading triage data...</div>\n   392\t\t{:else if filteredItems.length === 0}\n   393\t\t\t<div class=\"text-center text-muted-foreground py-12\">\n   394\t\t\t\t{#if allItems.length === 0}\n   395\t\t\t\t\t<p>No inbox items to triage.</p>\n   396\t\t\t\t\t<p class=\"text-sm mt-1\">Add items to your inbox first.</p>\n   397\t\t\t\t{:else}\n   398\t\t\t\t\t<p>No items match the current filters.</p>\n   399\t\t\t\t{/if}\n   400\t\t\t</div>\n   401\t\t{:else if currentItem}\n   402\t\t\t<!-- Card navigation -->\n   403\t\t\t<div class=\"flex items-center justify-between mb-2\">\n   404\t\t\t\t<!-- AC: @interactive-triage-ui ac-5 - Navigation controls -->\n   405\t\t\t\t<Button\n   406\t\t\t\t\tvariant=\"outline\"\n   407\t\t\t\t\tsize=\"sm\"\n   408\t\t\t\t\tonclick={goPrevious}\n   409\t\t\t\t\tdisabled={currentIndex === 0}\n   410\t\t\t\t\tdata-testid=\"triage-prev\"\n   411\t\t\t\t>\n   412\t\t\t\t\t<ChevronLeftIcon class=\"size-4 mr-1\" />\n   413\t\t\t\t\tPrevious\n   414\t\t\t\t</Button>\n   415\t\t\t\t<span class=\"text-sm text-muted-foreground\" data-testid=\"triage-position\">\n   416\t\t\t\t\t{currentIndex + 1} / {filteredItems.length}\n   417\t\t\t\t</span>\n   418\t\t\t\t<Button\n   419\t\t\t\t\tvariant=\"outline\"\n   420\t\t\t\t\tsize=\"sm\"\n   421\t\t\t\t\tonclick={goNext}\n   422\t\t\t\t\tdisabled={currentIndex === filteredItems.length - 1}\n   423\t\t\t\t\tdata-testid=\"triage-next\"\n   424\t\t\t\t>\n   425\t\t\t\t\tNext\n   426\t\t\t\t\t<ChevronRightIcon class=\"size-4 ml-1\" />\n   427\t\t\t\t</Button>\n   428\t\t\t</div>\n   429\t\n   430\t\t\t<!-- AC: @interactive-triage-ui ac-1 - Card view showing item text, tags, age, added_by -->\n   431\t\t\t<Card class=\"transition-all duration-200\" data-testid=\"triage-card\">\n   432\t\t\t\t<CardHeader>\n   433\t\t\t\t\t<div class=\"flex items-start justify-between gap-4\">\n   434\t\t\t\t\t\t<CardTitle class=\"text-lg leading-relaxed\" data-testid=\"triage-card-text\">\n   435\t\t\t\t\t\t\t{currentItem.inbox.text}\n   436\t\t\t\t\t\t</CardTitle>\n   437\t\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-5 - Show decision state on already-triaged items -->\n   438\t\t\t\t\t\t{#if currentItem.record && currentItem.record.status !== 'pending'}\n   439\t\t\t\t\t\t\t<Badge\n   440\t\t\t\t\t\t\t\tclass={currentItem.record.action ? ACTION_COLORS[currentItem.record.action] : 'bg-gray-500'}\n   441\t\t\t\t\t\t\t\tdata-testid=\"triage-card-status\"\n   442\t\t\t\t\t\t\t>\n   443\t\t\t\t\t\t\t\t{currentItem.record.status === 'acted_on' ? 'Acted' : 'Triaged'}\n   444\t\t\t\t\t\t\t</Badge>\n   445\t\t\t\t\t\t{/if}\n   446\t\t\t\t\t</div>\n   447\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-1 - tags, age, added_by -->\n   448\t\t\t\t\t<div class=\"flex items-center gap-2 text-xs text-muted-foreground mt-2\" data-testid=\"triage-card-meta\">\n   449\t\t\t\t\t\t<span data-testid=\"triage-card-age\">{formatDate(currentItem.inbox.created_at)}</span>\n   450\t\t\t\t\t\t<span>&middot;</span>\n   451\t\t\t\t\t\t<span data-testid=\"triage-card-added-by\">{currentItem.inbox.added_by}</span>\n   452\t\t\t\t\t\t{#if currentItem.inbox.tags.length > 0}\n   453\t\t\t\t\t\t\t<span>&middot;</span>\n   454\t\t\t\t\t\t\t<div class=\"flex gap-1\" data-testid=\"triage-card-tags\">\n   455\t\t\t\t\t\t\t\t{#each currentItem.inbox.tags as tag}\n   456\t\t\t\t\t\t\t\t\t<Badge variant=\"secondary\" class=\"text-xs\">{tag}</Badge>\n   457\t\t\t\t\t\t\t\t{/each}\n   458\t\t\t\t\t\t\t</div>\n   459\t\t\t\t\t\t{/if}\n   460\t\t\t\t\t</div>\n   461\t\t\t\t</CardHeader>\n   462\t\t\t\t<CardContent>\n   463\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-2 - Show agent recommendation if exists -->\n   464\t\t\t\t\t{#if currentItem.record && currentItem.record.status !== 'pending'}\n   465\t\t\t\t\t\t<div class=\"rounded-md bg-muted p-4 mb-4\" data-testid=\"triage-agent-recommendation\">\n   466\t\t\t\t\t\t\t<p class=\"text-sm font-medium mb-2\">\n   467\t\t\t\t\t\t\t\t{#if currentItem.record.override_by}\n   468\t\t\t\t\t\t\t\t\tOverride Decision\n   469\t\t\t\t\t\t\t\t{:else}\n   470\t\t\t\t\t\t\t\t\tAgent Recommendation\n   471\t\t\t\t\t\t\t\t{/if}\n   472\t\t\t\t\t\t\t</p>\n   473\t\t\t\t\t\t\t<div class=\"space-y-1 text-sm\">\n   474\t\t\t\t\t\t\t\t<p data-testid=\"triage-rec-action\">\n   475\t\t\t\t\t\t\t\t\t<span class=\"font-medium\">Action:</span>\n   476\t\t\t\t\t\t\t\t\t{currentItem.record.action ? ACTION_LABELS[currentItem.record.action] : 'None'}\n   477\t\t\t\t\t\t\t\t</p>\n   478\t\t\t\t\t\t\t\t<p data-testid=\"triage-rec-reasoning\">\n   479\t\t\t\t\t\t\t\t\t<span class=\"font-medium\">Reasoning:</span>\n   480\t\t\t\t\t\t\t\t\t{currentItem.record.override_reasoning || currentItem.record.reasoning}\n   481\t\t\t\t\t\t\t\t</p>\n   482\t\t\t\t\t\t\t\t{#if currentItem.record.evidence_refs.length > 0}\n   483\t\t\t\t\t\t\t\t\t<p data-testid=\"triage-rec-evidence\">\n   484\t\t\t\t\t\t\t\t\t\t<span class=\"font-medium\">Evidence:</span>\n   485\t\t\t\t\t\t\t\t\t\t{currentItem.record.evidence_refs.join(', ')}\n   486\t\t\t\t\t\t\t\t\t</p>\n   487\t\t\t\t\t\t\t\t{/if}\n   488\t\t\t\t\t\t\t\t<p class=\"text-xs text-muted-foreground\">\n   489\t\t\t\t\t\t\t\t\tDecided by: {currentItem.record.override_by || currentItem.record.decided_by}\n   490\t\t\t\t\t\t\t\t</p>\n   491\t\t\t\t\t\t\t</div>\n   492\t\t\t\t\t\t</div>\n   493\t\t\t\t\t{/if}\n   494\t\n   495\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-8 - Hide action UI in static mode -->\n   496\t\t\t\t\t{#if !isStaticMode()}\n   497\t\t\t\t\t\t<Separator class=\"my-4\" />\n   498\t\n   499\t\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-3, ac-4 - Action selection and reasoning -->\n   500\t\t\t\t\t\t<div class=\"space-y-4\" data-testid=\"triage-action-form\">\n   501\t\t\t\t\t\t\t<div>\n   502\t\t\t\t\t\t\t\t<p class=\"text-sm font-medium mb-2\">\n   503\t\t\t\t\t\t\t\t\t{currentItem.record && currentItem.record.status !== 'pending' ? 'Override Action' : 'Select Action'}\n   504\t\t\t\t\t\t\t\t</p>\n   505\t\t\t\t\t\t\t\t<div class=\"flex flex-wrap gap-2\" data-testid=\"triage-action-buttons\">\n   506\t\t\t\t\t\t\t\t\t{#each Object.entries(ACTION_LABELS) as [action, label]}\n   507\t\t\t\t\t\t\t\t\t\t<Button\n   508\t\t\t\t\t\t\t\t\t\t\tvariant={selectedAction === action ? 'default' : 'outline'}\n   509\t\t\t\t\t\t\t\t\t\t\tsize=\"sm\"\n   510\t\t\t\t\t\t\t\t\t\t\tonclick={() => (selectedAction = action as TriageAction)}\n   511\t\t\t\t\t\t\t\t\t\t\tdata-testid=\"triage-action-{action}\"\n   512\t\t\t\t\t\t\t\t\t\t>\n   513\t\t\t\t\t\t\t\t\t\t\t{label}\n   514\t\t\t\t\t\t\t\t\t\t</Button>\n   515\t\t\t\t\t\t\t\t\t{/each}\n   516\t\t\t\t\t\t\t\t</div>\n   517\t\t\t\t\t\t\t</div>\n   518\t\n   519\t\t\t\t\t\t\t<div>\n   520\t\t\t\t\t\t\t\t<p class=\"text-sm font-medium mb-2\">Reasoning</p>\n   521\t\t\t\t\t\t\t\t<Textarea\n   522\t\t\t\t\t\t\t\t\tplaceholder=\"Why are you choosing this action?\"\n   523\t\t\t\t\t\t\t\t\tbind:value={reasoning}\n   524\t\t\t\t\t\t\t\t\trows={3}\n   525\t\t\t\t\t\t\t\t\tdisabled={submitting}\n   526\t\t\t\t\t\t\t\t\tdata-testid=\"triage-reasoning\"\n   527\t\t\t\t\t\t\t\t/>\n   528\t\t\t\t\t\t\t</div>\n   529\t\n   530\t\t\t\t\t\t\t<div class=\"flex gap-2\">\n   531\t\t\t\t\t\t\t\t<Button\n   532\t\t\t\t\t\t\t\t\tonclick={handleSubmit}\n   533\t\t\t\t\t\t\t\t\tdisabled={submitting || !selectedAction || !reasoning.trim()}\n   534\t\t\t\t\t\t\t\t\tdata-testid=\"triage-submit\"\n   535\t\t\t\t\t\t\t\t>\n   536\t\t\t\t\t\t\t\t\t{#if submitting}\n   537\t\t\t\t\t\t\t\t\t\tSubmitting...\n   538\t\t\t\t\t\t\t\t\t{:else if currentItem.record && currentItem.record.status !== 'pending'}\n   539\t\t\t\t\t\t\t\t\t\tOverride Decision\n   540\t\t\t\t\t\t\t\t\t{:else}\n   541\t\t\t\t\t\t\t\t\t\tSubmit Decision\n   542\t\t\t\t\t\t\t\t\t{/if}\n   543\t\t\t\t\t\t\t\t</Button>\n   544\t\n   545\t\t\t\t\t\t\t\t{#if currentItem.record?.status === 'triaged'}\n   546\t\t\t\t\t\t\t\t\t<Button\n   547\t\t\t\t\t\t\t\t\t\tvariant=\"secondary\"\n   548\t\t\t\t\t\t\t\t\t\tonclick={handleAct}\n   549\t\t\t\t\t\t\t\t\t\tdisabled={submitting}\n   550\t\t\t\t\t\t\t\t\t\tdata-testid=\"triage-act\"\n   551\t\t\t\t\t\t\t\t\t>\n   552\t\t\t\t\t\t\t\t\t\t{submitting ? 'Executing...' : `Execute: ${currentItem.record.action ? ACTION_LABELS[currentItem.record.action] : ''}`}\n   553\t\t\t\t\t\t\t\t\t</Button>\n   554\t\t\t\t\t\t\t\t{/if}\n   555\t\t\t\t\t\t\t</div>\n   556\t\t\t\t\t\t</div>\n   557\t\t\t\t\t{:else}\n   558\t\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-8 - Static mode: browsing only -->\n   559\t\t\t\t\t\t{#if !currentItem.record}\n   560\t\t\t\t\t\t\t<p class=\"text-sm text-muted-foreground mt-4\">\n   561\t\t\t\t\t\t\t\tNo triage decision recorded. Use the CLI or daemon to triage items.\n   562\t\t\t\t\t\t\t</p>\n   563\t\t\t\t\t\t{/if}\n   564\t\t\t\t\t{/if}\n   565\t\t\t\t</CardContent>\n   566\t\t\t</Card>\n   567\t\t{/if}\n   568\t</div>\n","exit_code":0,"duration":{"secs":0,"nanos":50315255},"formatted_output":"     1\t<script lang=\"ts\">\n     2\t\t// AC: @interactive-triage-ui ac-1, ac-2, ac-3, ac-4, ac-5, ac-6, ac-7, ac-8\n     3\t\t// AC: @trait-websocket-protocol ac-1, ac-2, ac-3\n     4\t\timport { onMount, onDestroy } from 'svelte';\n     5\t\timport type { InboxItem, BroadcastEvent } from '@kynetic-ai/shared';\n     6\t\timport type { TriageRecord, TriageAction } from '$lib/types/triage';\n     7\t\timport {\n     8\t\t\tfetchInbox,\n     9\t\t\tfetchTriageRecords,\n    10\t\t\tcreateTriageRecord,\n    11\t\t\toverrideTriageRecord,\n    12\t\t\tactOnTriageRecord\n    13\t\t} from '$lib/api';\n    14\t\timport { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';\n    15\t\timport { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';\n    16\t\timport { getProjectVersion } from '$lib/stores/project.svelte';\n    17\t\timport { Button } from '$lib/components/ui/button';\n    18\t\timport { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';\n    19\t\timport { Badge } from '$lib/components/ui/badge';\n    20\t\timport { Textarea } from '$lib/components/ui/textarea';\n    21\t\timport { Separator } from '$lib/components/ui/separator';\n    22\t\timport ChevronLeftIcon from '@lucide/svelte/icons/chevron-left';\n    23\t\timport ChevronRightIcon from '@lucide/svelte/icons/chevron-right';\n    24\t\n    25\t\t// Data state\n    26\t\tlet inboxItems = $state<InboxItem[]>([]);\n    27\t\tlet triageRecords = $state<TriageRecord[]>([]);\n    28\t\tlet loading = $state(true);\n    29\t\tlet error = $state('');\n    30\t\n    31\t\t// Card navigation state\n    32\t\t// AC: @interactive-triage-ui ac-5\n    33\t\tlet currentIndex = $state(0);\n    34\t\tlet submitting = $state(false);\n    35\t\n    36\t\t// Form state\n    37\t\t// AC: @interactive-triage-ui ac-3\n    38\t\tlet selectedAction = $state<TriageAction | ''>('');\n    39\t\tlet reasoning = $state('');\n    40\t\n    41\t\t// Filter state\n    42\t\t// AC: @interactive-triage-ui ac-7\n    43\t\tlet filterTag = $state<string | ''>('');\n    44\t\tlet filterStatus = $state<'all' | 'untriaged' | 'triaged' | 'acted_on'>('all');\n    45\t\tlet filterAction = $state<TriageAction | ''>('');\n    46\t\n    47\t\t// Action labels\n    48\t\tconst ACTION_LABELS: Record<TriageAction, string> = {\n    49\t\t\tpromote: 'Promote to Task',\n    50\t\t\tdelete: 'Delete',\n    51\t\t\tdefer: 'Defer',\n    52\t\t\t'spec-gap': 'Spec Gap',\n    53\t\t\tduplicate: 'Duplicate'\n    54\t\t};\n    55\t\n    56\t\tconst ACTION_COLORS: Record<TriageAction, string> = {\n    57\t\t\tpromote: 'bg-green-500',\n    58\t\t\tdelete: 'bg-red-500',\n    59\t\t\tdefer: 'bg-yellow-500',\n    60\t\t\t'spec-gap': 'bg-purple-500',\n    61\t\t\tduplicate: 'bg-gray-500'\n    62\t\t};\n    63\t\n    64\t\t// Merged view: inbox items with their triage records\n    65\t\tinterface TriageCardItem {\n    66\t\t\tinbox: InboxItem;\n    67\t\t\trecord: TriageRecord | null;\n    68\t\t}\n    69\t\n    70\t\t// AC: @interactive-triage-ui ac-7 - Filtered items\n    71\t\tlet allItems = $derived.by(() => {\n    72\t\t\tconst items: TriageCardItem[] = inboxItems.map((inbox) => {\n    73\t\t\t\tconst record = triageRecords.find((r) => r.inbox_ref === inbox._ulid) ?? null;\n    74\t\t\t\treturn { inbox, record };\n    75\t\t\t});\n    76\t\t\treturn items;\n    77\t\t});\n    78\t\n    79\t\tlet filteredItems = $derived.by(() => {\n    80\t\t\tlet items = allItems;\n    81\t\n    82\t\t\t// Tag filter\n    83\t\t\tif (filterTag) {\n    84\t\t\t\titems = items.filter((i) => i.inbox.tags.includes(filterTag));\n    85\t\t\t}\n    86\t\n    87\t\t\t// Status filter\n    88\t\t\tif (filterStatus === 'untriaged') {\n    89\t\t\t\titems = items.filter((i) => !i.record || i.record.status === 'pending');\n    90\t\t\t} else if (filterStatus === 'triaged') {\n    91\t\t\t\titems = items.filter((i) => i.record?.status === 'triaged');\n    92\t\t\t} else if (filterStatus === 'acted_on') {\n    93\t\t\t\titems = items.filter((i) => i.record?.status === 'acted_on');\n    94\t\t\t}\n    95\t\n    96\t\t\t// Action filter\n    97\t\t\tif (filterAction) {\n    98\t\t\t\titems = items.filter((i) => i.record?.action === filterAction);\n    99\t\t\t}\n   100\t\n   101\t\t\treturn items;\n   102\t\t});\n   103\t\n   104\t\tlet currentItem = $derived(filteredItems[currentIndex] ?? null);\n   105\t\n   106\t\t// AC: @interactive-triage-ui ac-7 - Progress count\n   107\t\tlet triagedCount = $derived(allItems.filter((i) => i.record && i.record.status !== 'pending').length);\n   108\t\tlet totalCount = $derived(allItems.length);\n   109\t\n   110\t\t// All unique tags for filter\n   111\t\tlet allTags = $derived.by(() => {\n   112\t\t\tconst tagSet = new Set<string>();\n   113\t\t\tinboxItems.forEach((item) => item.tags.forEach((t) => tagSet.add(t)));\n   114\t\t\treturn Array.from(tagSet).sort();\n   115\t\t});\n   116\t\n   117\t\tonMount(async () => {\n   118\t\t\tawait loadData();\n   119\t\n   120\t\t\t// AC: @interactive-triage-ui ac-6 - Subscribe to triage:updates\n   121\t\t\t// AC: @trait-websocket-protocol ac-2 - Subscribe to topic\n   122\t\t\tif (!isStaticMode()) {\n   123\t\t\t\tsubscribe(['triage:updates']);\n   124\t\t\t\ton('triage:updates', handleTriageUpdate);\n   125\t\t\t}\n   126\t\t});\n   127\t\n   128\t\tonDestroy(() => {\n   129\t\t\tif (!isStaticMode()) {\n   130\t\t\t\toff('triage:updates', handleTriageUpdate);\n   131\t\t\t\tunsubscribe(['triage:updates']);\n   132\t\t\t}\n   133\t\t});\n   134\t\n   135\t\t// AC: @multi-directory-daemon ac-27 - Reload on project change\n   136\t\t$effect(() => {\n   137\t\t\tconst version = getProjectVersion();\n   138\t\t\tif (version > 0) {\n   139\t\t\t\tloadData();\n   140\t\t\t}\n   141\t\t});\n   142\t\n   143\t\t// AC: @interactive-triage-ui ac-6 - Real-time update handler\n   144\t\t// AC: @trait-websocket-protocol ac-3 - Handle broadcast event\n   145\t\tfunction handleTriageUpdate(_event: BroadcastEvent) {\n   146\t\t\t// Reload triage records on any triage update\n   147\t\t\tloadTriageData();\n   148\t\t}\n   149\t\n   150\t\tasync function loadData() {\n   151\t\t\ttry {\n   152\t\t\t\tloading = true;\n   153\t\t\t\terror = '';\n   154\t\t\t\tconst [inboxResponse, triageResponse] = await Promise.all([\n   155\t\t\t\t\tfetchInbox({ limit: 1000 }),\n   156\t\t\t\t\tfetchTriageRecords({ limit: 1000 })\n   157\t\t\t\t]);\n   158\t\t\t\tinboxItems = inboxResponse.items;\n   159\t\t\t\ttriageRecords = triageResponse.items;\n   160\t\t\t} catch (err) {\n   161\t\t\t\terror = err instanceof Error ? err.message : 'Failed to load triage data';\n   162\t\t\t} finally {\n   163\t\t\t\tloading = false;\n   164\t\t\t}\n   165\t\t}\n   166\t\n   167\t\tasync function loadTriageData() {\n   168\t\t\ttry {\n   169\t\t\t\tconst triageResponse = await fetchTriageRecords({ limit: 1000 });\n   170\t\t\t\ttriageRecords = triageResponse.items;\n   171\t\t\t} catch (err) {\n   172\t\t\t\tconsole.error('Failed to reload triage records:', err);\n   173\t\t\t}\n   174\t\t}\n   175\t\n   176\t\t// AC: @interactive-triage-ui ac-5 - Navigation\n   177\t\tfunction goNext() {\n   178\t\t\tif (currentIndex < filteredItems.length - 1) {\n   179\t\t\t\tcurrentIndex++;\n   180\t\t\t\tresetForm();\n   181\t\t\t}\n   182\t\t}\n   183\t\n   184\t\tfunction goPrevious() {\n   185\t\t\tif (currentIndex > 0) {\n   186\t\t\t\tcurrentIndex--;\n   187\t\t\t\tresetForm();\n   188\t\t\t}\n   189\t\t}\n   190\t\n   191\t\tfunction resetForm() {\n   192\t\t\tselectedAction = '';\n   193\t\t\treasoning = '';\n   194\t\t\terror = '';\n   195\t\t}\n   196\t\n   197\t\t// Keyboard navigation - skip when focus is on input/textarea elements\n   198\t\tfunction handleKeydown(e: KeyboardEvent) {\n   199\t\t\tconst target = e.target as HTMLElement;\n   200\t\t\tif (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable) {\n   201\t\t\t\treturn;\n   202\t\t\t}\n   203\t\t\tif (e.key === 'ArrowLeft') {\n   204\t\t\t\tgoPrevious();\n   205\t\t\t} else if (e.key === 'ArrowRight') {\n   206\t\t\t\tgoNext();\n   207\t\t\t}\n   208\t\t}\n   209\t\n   210\t\t// AC: @interactive-triage-ui ac-3 - Submit triage decision\n   211\t\tasync function handleSubmit() {\n   212\t\t\tif (!currentItem || !selectedAction || !reasoning.trim()) return;\n   213\t\n   214\t\t\tif (isStaticMode()) {\n   215\t\t\t\terror = 'Cannot submit triage decisions in read-only mode.';\n   216\t\t\t\treturn;\n   217\t\t\t}\n   218\t\n   219\t\t\ttry {\n   220\t\t\t\tsubmitting = true;\n   221\t\t\t\terror = '';\n   222\t\n   223\t\t\t\tconst existing = currentItem.record;\n   224\t\n   225\t\t\t\tif (existing && existing.status !== 'pending') {\n   226\t\t\t\t\t// AC: @interactive-triage-ui ac-4 - Override existing decision\n   227\t\t\t\t\tawait overrideTriageRecord(existing._ulid, {\n   228\t\t\t\t\t\taction: selectedAction,\n   229\t\t\t\t\t\treasoning: reasoning.trim()\n   230\t\t\t\t\t});\n   231\t\t\t\t} else {\n   232\t\t\t\t\t// Create new triage record\n   233\t\t\t\t\tawait createTriageRecord({\n   234\t\t\t\t\t\tinbox_ref: currentItem.inbox._ulid,\n   235\t\t\t\t\t\taction: selectedAction,\n   236\t\t\t\t\t\treasoning: reasoning.trim()\n   237\t\t\t\t\t});\n   238\t\t\t\t}\n   239\t\n   240\t\t\t\t// Reload triage data\n   241\t\t\t\tawait loadTriageData();\n   242\t\n   243\t\t\t\t// Auto-advance to next item\n   244\t\t\t\t// AC: @interactive-triage-ui ac-3 - advances to next item\n   245\t\t\t\tif (currentIndex < filteredItems.length - 1) {\n   246\t\t\t\t\tcurrentIndex++;\n   247\t\t\t\t}\n   248\t\t\t\tresetForm();\n   249\t\t\t} catch (err) {\n   250\t\t\t\tif (err instanceof ReadOnlyModeError) {\n   251\t\t\t\t\terror = err.message;\n   252\t\t\t\t} else {\n   253\t\t\t\t\terror = err instanceof Error ? err.message : 'Failed to submit triage decision';\n   254\t\t\t\t}\n   255\t\t\t} finally {\n   256\t\t\t\tsubmitting = false;\n   257\t\t\t}\n   258\t\t}\n   259\t\n   260\t\t// Execute the triage action\n   261\t\tasync function handleAct() {\n   262\t\t\tif (!currentItem?.record) return;\n   263\t\n   264\t\t\tif (isStaticMode()) {\n   265\t\t\t\terror = 'Cannot execute triage actions in read-only mode.';\n   266\t\t\t\treturn;\n   267\t\t\t}\n   268\t\n   269\t\t\ttry {\n   270\t\t\t\tsubmitting = true;\n   271\t\t\t\terror = '';\n   272\t\t\t\tawait actOnTriageRecord(currentItem.record._ulid);\n   273\t\t\t\tawait loadTriageData();\n   274\t\t\t} catch (err) {\n   275\t\t\t\tif (err instanceof ReadOnlyModeError) {\n   276\t\t\t\t\terror = err.message;\n   277\t\t\t\t} else {\n   278\t\t\t\t\terror = err instanceof Error ? err.message : 'Failed to execute triage action';\n   279\t\t\t\t}\n   280\t\t\t} finally {\n   281\t\t\t\tsubmitting = false;\n   282\t\t\t}\n   283\t\t}\n   284\t\n   285\t\tfunction formatDate(dateString: string): string {\n   286\t\t\tconst date = new Date(dateString);\n   287\t\t\tconst now = new Date();\n   288\t\t\tconst diffMs = now.getTime() - date.getTime();\n   289\t\t\tconst diffMins = Math.floor(diffMs / 60000);\n   290\t\t\tconst diffHours = Math.floor(diffMs / 3600000);\n   291\t\t\tconst diffDays = Math.floor(diffMs / 86400000);\n   292\t\n   293\t\t\tif (diffMins < 1) return 'just now';\n   294\t\t\tif (diffMins < 60) return `${diffMins}m ago`;\n   295\t\t\tif (diffHours < 24) return `${diffHours}h ago`;\n   296\t\t\tif (diffDays < 7) return `${diffDays}d ago`;\n   297\t\n   298\t\t\treturn date.toLocaleDateString();\n   299\t\t}\n   300\t\n   301\t\t// AC: @interactive-triage-ui ac-7 - Reset index when filter changes\n   302\t\t$effect(() => {\n   303\t\t\t// Reading filter values creates reactive dependencies\n   304\t\t\tconst _tag = filterTag;\n   305\t\t\tconst _status = filterStatus;\n   306\t\t\tconst _action = filterAction;\n   307\t\t\tcurrentIndex = 0;\n   308\t\t\tresetForm();\n   309\t\t});\n   310\t</script>\n   311\t\n   312\t<svelte:window onkeydown={handleKeydown} />\n   313\t\n   314\t<!-- AC: @interactive-triage-ui ac-1, ac-5, ac-7 -->\n   315\t<div class=\"flex flex-col gap-4 p-6\">\n   316\t\t<div class=\"flex items-center justify-between\">\n   317\t\t\t<div>\n   318\t\t\t\t<h1 class=\"text-3xl font-bold\">Triage</h1>\n   319\t\t\t\t{#if !loading}\n   320\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-7 - Progress count -->\n   321\t\t\t\t\t<p class=\"text-muted-foreground\" data-testid=\"triage-progress\">\n   322\t\t\t\t\t\t{triagedCount} of {totalCount} triaged\n   323\t\t\t\t\t\t{#if filteredItems.length !== allItems.length}\n   324\t\t\t\t\t\t\t&middot; Showing {filteredItems.length} filtered\n   325\t\t\t\t\t\t{/if}\n   326\t\t\t\t\t</p>\n   327\t\t\t\t{/if}\n   328\t\t\t</div>\n   329\t\n   330\t\t\t<!-- AC: @interactive-triage-ui ac-7 - Filters -->\n   331\t\t\t<div class=\"flex gap-2 items-center\" data-testid=\"triage-filters\">\n   332\t\t\t\t<select\n   333\t\t\t\t\tbind:value={filterStatus}\n   334\t\t\t\t\tclass=\"rounded-md border bg-background px-3 py-1.5 text-sm\"\n   335\t\t\t\t\tdata-testid=\"triage-status-filter\"\n   336\t\t\t\t>\n   337\t\t\t\t\t<option value=\"all\">All</option>\n   338\t\t\t\t\t<option value=\"untriaged\">Untriaged</option>\n   339\t\t\t\t\t<option value=\"triaged\">Triaged</option>\n   340\t\t\t\t\t<option value=\"acted_on\">Acted On</option>\n   341\t\t\t\t</select>\n   342\t\t\t\t<select\n   343\t\t\t\t\tbind:value={filterAction}\n   344\t\t\t\t\tclass=\"rounded-md border bg-background px-3 py-1.5 text-sm\"\n   345\t\t\t\t\tdata-testid=\"triage-action-filter\"\n   346\t\t\t\t>\n   347\t\t\t\t\t<option value=\"\">All Actions</option>\n   348\t\t\t\t\t{#each Object.entries(ACTION_LABELS) as [action, label]}\n   349\t\t\t\t\t\t<option value={action}>{label}</option>\n   350\t\t\t\t\t{/each}\n   351\t\t\t\t</select>\n   352\t\t\t\t{#if allTags.length > 0}\n   353\t\t\t\t\t<select\n   354\t\t\t\t\t\tbind:value={filterTag}\n   355\t\t\t\t\t\tclass=\"rounded-md border bg-background px-3 py-1.5 text-sm\"\n   356\t\t\t\t\t\tdata-testid=\"triage-tag-filter\"\n   357\t\t\t\t\t>\n   358\t\t\t\t\t\t<option value=\"\">All Tags</option>\n   359\t\t\t\t\t\t{#each allTags as tag}\n   360\t\t\t\t\t\t\t<option value={tag}>{tag}</option>\n   361\t\t\t\t\t\t{/each}\n   362\t\t\t\t\t</select>\n   363\t\t\t\t{/if}\n   364\t\t\t</div>\n   365\t\t</div>\n   366\t\n   367\t\t<!-- Progress bar -->\n   368\t\t{#if totalCount > 0}\n   369\t\t\t<div class=\"w-full bg-muted rounded-full h-2\" data-testid=\"triage-progress-bar\">\n   370\t\t\t\t<div\n   371\t\t\t\t\tclass=\"bg-primary rounded-full h-2 transition-all duration-300\"\n   372\t\t\t\t\tstyle=\"width: {(triagedCount / totalCount) * 100}%\"\n   373\t\t\t\t></div>\n   374\t\t\t</div>\n   375\t\t{/if}\n   376\t\n   377\t\t{#if error}\n   378\t\t\t<div class=\"rounded-md bg-red-50 p-4 text-sm text-red-800 dark:bg-red-900/20 dark:text-red-200\" data-testid=\"triage-error\" role=\"alert\">\n   379\t\t\t\t{error}\n   380\t\t\t</div>\n   381\t\t{/if}\n   382\t\n   383\t\t<!-- AC: @interactive-triage-ui ac-8 - Static mode notice -->\n   384\t\t{#if isStaticMode() && !loading}\n   385\t\t\t<div class=\"rounded-md bg-amber-50 p-3 text-sm text-amber-800 dark:bg-amber-900/20 dark:text-amber-200\" data-testid=\"triage-static-notice\">\n   386\t\t\t\tTriage decisions are not included in static snapshots. Browse inbox items below; use the daemon for full triage functionality.\n   387\t\t\t</div>\n   388\t\t{/if}\n   389\t\n   390\t\t{#if loading}\n   391\t\t\t<div class=\"text-center text-muted-foreground py-12\">Loading triage data...</div>\n   392\t\t{:else if filteredItems.length === 0}\n   393\t\t\t<div class=\"text-center text-muted-foreground py-12\">\n   394\t\t\t\t{#if allItems.length === 0}\n   395\t\t\t\t\t<p>No inbox items to triage.</p>\n   396\t\t\t\t\t<p class=\"text-sm mt-1\">Add items to your inbox first.</p>\n   397\t\t\t\t{:else}\n   398\t\t\t\t\t<p>No items match the current filters.</p>\n   399\t\t\t\t{/if}\n   400\t\t\t</div>\n   401\t\t{:else if currentItem}\n   402\t\t\t<!-- Card navigation -->\n   403\t\t\t<div class=\"flex items-center justify-between mb-2\">\n   404\t\t\t\t<!-- AC: @interactive-triage-ui ac-5 - Navigation controls -->\n   405\t\t\t\t<Button\n   406\t\t\t\t\tvariant=\"outline\"\n   407\t\t\t\t\tsize=\"sm\"\n   408\t\t\t\t\tonclick={goPrevious}\n   409\t\t\t\t\tdisabled={currentIndex === 0}\n   410\t\t\t\t\tdata-testid=\"triage-prev\"\n   411\t\t\t\t>\n   412\t\t\t\t\t<ChevronLeftIcon class=\"size-4 mr-1\" />\n   413\t\t\t\t\tPrevious\n   414\t\t\t\t</Button>\n   415\t\t\t\t<span class=\"text-sm text-muted-foreground\" data-testid=\"triage-position\">\n   416\t\t\t\t\t{currentIndex + 1} / {filteredItems.length}\n   417\t\t\t\t</span>\n   418\t\t\t\t<Button\n   419\t\t\t\t\tvariant=\"outline\"\n   420\t\t\t\t\tsize=\"sm\"\n   421\t\t\t\t\tonclick={goNext}\n   422\t\t\t\t\tdisabled={currentIndex === filteredItems.length - 1}\n   423\t\t\t\t\tdata-testid=\"triage-next\"\n   424\t\t\t\t>\n   425\t\t\t\t\tNext\n   426\t\t\t\t\t<ChevronRightIcon class=\"size-4 ml-1\" />\n   427\t\t\t\t</Button>\n   428\t\t\t</div>\n   429\t\n   430\t\t\t<!-- AC: @interactive-triage-ui ac-1 - Card view showing item text, tags, age, added_by -->\n   431\t\t\t<Card class=\"transition-all duration-200\" data-testid=\"triage-card\">\n   432\t\t\t\t<CardHeader>\n   433\t\t\t\t\t<div class=\"flex items-start justify-between gap-4\">\n   434\t\t\t\t\t\t<CardTitle class=\"text-lg leading-relaxed\" data-testid=\"triage-card-text\">\n   435\t\t\t\t\t\t\t{currentItem.inbox.text}\n   436\t\t\t\t\t\t</CardTitle>\n   437\t\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-5 - Show decision state on already-triaged items -->\n   438\t\t\t\t\t\t{#if currentItem.record && currentItem.record.status !== 'pending'}\n   439\t\t\t\t\t\t\t<Badge\n   440\t\t\t\t\t\t\t\tclass={currentItem.record.action ? ACTION_COLORS[currentItem.record.action] : 'bg-gray-500'}\n   441\t\t\t\t\t\t\t\tdata-testid=\"triage-card-status\"\n   442\t\t\t\t\t\t\t>\n   443\t\t\t\t\t\t\t\t{currentItem.record.status === 'acted_on' ? 'Acted' : 'Triaged'}\n   444\t\t\t\t\t\t\t</Badge>\n   445\t\t\t\t\t\t{/if}\n   446\t\t\t\t\t</div>\n   447\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-1 - tags, age, added_by -->\n   448\t\t\t\t\t<div class=\"flex items-center gap-2 text-xs text-muted-foreground mt-2\" data-testid=\"triage-card-meta\">\n   449\t\t\t\t\t\t<span data-testid=\"triage-card-age\">{formatDate(currentItem.inbox.created_at)}</span>\n   450\t\t\t\t\t\t<span>&middot;</span>\n   451\t\t\t\t\t\t<span data-testid=\"triage-card-added-by\">{currentItem.inbox.added_by}</span>\n   452\t\t\t\t\t\t{#if currentItem.inbox.tags.length > 0}\n   453\t\t\t\t\t\t\t<span>&middot;</span>\n   454\t\t\t\t\t\t\t<div class=\"flex gap-1\" data-testid=\"triage-card-tags\">\n   455\t\t\t\t\t\t\t\t{#each currentItem.inbox.tags as tag}\n   456\t\t\t\t\t\t\t\t\t<Badge variant=\"secondary\" class=\"text-xs\">{tag}</Badge>\n   457\t\t\t\t\t\t\t\t{/each}\n   458\t\t\t\t\t\t\t</div>\n   459\t\t\t\t\t\t{/if}\n   460\t\t\t\t\t</div>\n   461\t\t\t\t</CardHeader>\n   462\t\t\t\t<CardContent>\n   463\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-2 - Show agent recommendation if exists -->\n   464\t\t\t\t\t{#if currentItem.record && currentItem.record.status !== 'pending'}\n   465\t\t\t\t\t\t<div class=\"rounded-md bg-muted p-4 mb-4\" data-testid=\"triage-agent-recommendation\">\n   466\t\t\t\t\t\t\t<p class=\"text-sm font-medium mb-2\">\n   467\t\t\t\t\t\t\t\t{#if currentItem.record.override_by}\n   468\t\t\t\t\t\t\t\t\tOverride Decision\n   469\t\t\t\t\t\t\t\t{:else}\n   470\t\t\t\t\t\t\t\t\tAgent Recommendation\n   471\t\t\t\t\t\t\t\t{/if}\n   472\t\t\t\t\t\t\t</p>\n   473\t\t\t\t\t\t\t<div class=\"space-y-1 text-sm\">\n   474\t\t\t\t\t\t\t\t<p data-testid=\"triage-rec-action\">\n   475\t\t\t\t\t\t\t\t\t<span class=\"font-medium\">Action:</span>\n   476\t\t\t\t\t\t\t\t\t{currentItem.record.action ? ACTION_LABELS[currentItem.record.action] : 'None'}\n   477\t\t\t\t\t\t\t\t</p>\n   478\t\t\t\t\t\t\t\t<p data-testid=\"triage-rec-reasoning\">\n   479\t\t\t\t\t\t\t\t\t<span class=\"font-medium\">Reasoning:</span>\n   480\t\t\t\t\t\t\t\t\t{currentItem.record.override_reasoning || currentItem.record.reasoning}\n   481\t\t\t\t\t\t\t\t</p>\n   482\t\t\t\t\t\t\t\t{#if currentItem.record.evidence_refs.length > 0}\n   483\t\t\t\t\t\t\t\t\t<p data-testid=\"triage-rec-evidence\">\n   484\t\t\t\t\t\t\t\t\t\t<span class=\"font-medium\">Evidence:</span>\n   485\t\t\t\t\t\t\t\t\t\t{currentItem.record.evidence_refs.join(', ')}\n   486\t\t\t\t\t\t\t\t\t</p>\n   487\t\t\t\t\t\t\t\t{/if}\n   488\t\t\t\t\t\t\t\t<p class=\"text-xs text-muted-foreground\">\n   489\t\t\t\t\t\t\t\t\tDecided by: {currentItem.record.override_by || currentItem.record.decided_by}\n   490\t\t\t\t\t\t\t\t</p>\n   491\t\t\t\t\t\t\t</div>\n   492\t\t\t\t\t\t</div>\n   493\t\t\t\t\t{/if}\n   494\t\n   495\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-8 - Hide action UI in static mode -->\n   496\t\t\t\t\t{#if !isStaticMode()}\n   497\t\t\t\t\t\t<Separator class=\"my-4\" />\n   498\t\n   499\t\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-3, ac-4 - Action selection and reasoning -->\n   500\t\t\t\t\t\t<div class=\"space-y-4\" data-testid=\"triage-action-form\">\n   501\t\t\t\t\t\t\t<div>\n   502\t\t\t\t\t\t\t\t<p class=\"text-sm font-medium mb-2\">\n   503\t\t\t\t\t\t\t\t\t{currentItem.record && currentItem.record.status !== 'pending' ? 'Override Action' : 'Select Action'}\n   504\t\t\t\t\t\t\t\t</p>\n   505\t\t\t\t\t\t\t\t<div class=\"flex flex-wrap gap-2\" data-testid=\"triage-action-buttons\">\n   506\t\t\t\t\t\t\t\t\t{#each Object.entries(ACTION_LABELS) as [action, label]}\n   507\t\t\t\t\t\t\t\t\t\t<Button\n   508\t\t\t\t\t\t\t\t\t\t\tvariant={selectedAction === action ? 'default' : 'outline'}\n   509\t\t\t\t\t\t\t\t\t\t\tsize=\"sm\"\n   510\t\t\t\t\t\t\t\t\t\t\tonclick={() => (selectedAction = action as TriageAction)}\n   511\t\t\t\t\t\t\t\t\t\t\tdata-testid=\"triage-action-{action}\"\n   512\t\t\t\t\t\t\t\t\t\t>\n   513\t\t\t\t\t\t\t\t\t\t\t{label}\n   514\t\t\t\t\t\t\t\t\t\t</Button>\n   515\t\t\t\t\t\t\t\t\t{/each}\n   516\t\t\t\t\t\t\t\t</div>\n   517\t\t\t\t\t\t\t</div>\n   518\t\n   519\t\t\t\t\t\t\t<div>\n   520\t\t\t\t\t\t\t\t<p class=\"text-sm font-medium mb-2\">Reasoning</p>\n   521\t\t\t\t\t\t\t\t<Textarea\n   522\t\t\t\t\t\t\t\t\tplaceholder=\"Why are you choosing this action?\"\n   523\t\t\t\t\t\t\t\t\tbind:value={reasoning}\n   524\t\t\t\t\t\t\t\t\trows={3}\n   525\t\t\t\t\t\t\t\t\tdisabled={submitting}\n   526\t\t\t\t\t\t\t\t\tdata-testid=\"triage-reasoning\"\n   527\t\t\t\t\t\t\t\t/>\n   528\t\t\t\t\t\t\t</div>\n   529\t\n   530\t\t\t\t\t\t\t<div class=\"flex gap-2\">\n   531\t\t\t\t\t\t\t\t<Button\n   532\t\t\t\t\t\t\t\t\tonclick={handleSubmit}\n   533\t\t\t\t\t\t\t\t\tdisabled={submitting || !selectedAction || !reasoning.trim()}\n   534\t\t\t\t\t\t\t\t\tdata-testid=\"triage-submit\"\n   535\t\t\t\t\t\t\t\t>\n   536\t\t\t\t\t\t\t\t\t{#if submitting}\n   537\t\t\t\t\t\t\t\t\t\tSubmitting...\n   538\t\t\t\t\t\t\t\t\t{:else if currentItem.record && currentItem.record.status !== 'pending'}\n   539\t\t\t\t\t\t\t\t\t\tOverride Decision\n   540\t\t\t\t\t\t\t\t\t{:else}\n   541\t\t\t\t\t\t\t\t\t\tSubmit Decision\n   542\t\t\t\t\t\t\t\t\t{/if}\n   543\t\t\t\t\t\t\t\t</Button>\n   544\t\n   545\t\t\t\t\t\t\t\t{#if currentItem.record?.status === 'triaged'}\n   546\t\t\t\t\t\t\t\t\t<Button\n   547\t\t\t\t\t\t\t\t\t\tvariant=\"secondary\"\n   548\t\t\t\t\t\t\t\t\t\tonclick={handleAct}\n   549\t\t\t\t\t\t\t\t\t\tdisabled={submitting}\n   550\t\t\t\t\t\t\t\t\t\tdata-testid=\"triage-act\"\n   551\t\t\t\t\t\t\t\t\t>\n   552\t\t\t\t\t\t\t\t\t\t{submitting ? 'Executing...' : `Execute: ${currentItem.record.action ? ACTION_LABELS[currentItem.record.action] : ''}`}\n   553\t\t\t\t\t\t\t\t\t</Button>\n   554\t\t\t\t\t\t\t\t{/if}\n   555\t\t\t\t\t\t\t</div>\n   556\t\t\t\t\t\t</div>\n   557\t\t\t\t\t{:else}\n   558\t\t\t\t\t\t<!-- AC: @interactive-triage-ui ac-8 - Static mode: browsing only -->\n   559\t\t\t\t\t\t{#if !currentItem.record}\n   560\t\t\t\t\t\t\t<p class=\"text-sm text-muted-foreground mt-4\">\n   561\t\t\t\t\t\t\t\tNo triage decision recorded. Use the CLI or daemon to triage items.\n   562\t\t\t\t\t\t\t</p>\n   563\t\t\t\t\t\t{/if}\n   564\t\t\t\t\t{/if}\n   565\t\t\t\t</CardContent>\n   566\t\t\t</Card>\n   567\t\t{/if}\n   568\t</div>\n","status":"completed"}