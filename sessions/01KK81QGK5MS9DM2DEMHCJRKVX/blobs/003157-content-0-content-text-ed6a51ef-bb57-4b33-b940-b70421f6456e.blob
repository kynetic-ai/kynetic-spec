   539→
   540→  // AC: @session-log-search ac-4
   541→  it('should show session ID, timestamp, type, and excerpt in each match', () => {
   542→    const results = kspecJson<SessionSearchResult[]>('session log search build', tempDir);
   543→    expect(results.length).toBeGreaterThan(0);
   544→
   545→    const match = results[0].matches[0];
   546→    expect(match).toHaveProperty('session_id');
   547→    expect(match).toHaveProperty('timestamp');
   548→    expect(match).toHaveProperty('event_type');
   549→    expect(match).toHaveProperty('content_excerpt');
