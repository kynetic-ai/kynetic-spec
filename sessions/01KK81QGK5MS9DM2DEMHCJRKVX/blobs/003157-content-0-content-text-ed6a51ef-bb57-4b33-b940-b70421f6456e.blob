   426→    await fs.writeFile(path.join(s3Dir, 'events.jsonl'), [
   427→      JSON.stringify({
   428→        ts: 6000,
   429→        seq: 0,
   430→        type: 'session.start',
   431→        session_id: s3,
   432→        data: { message: 'Simple session' },
   433→      }),
   434→      JSON.stringify({
   435→        ts: 7000,
   436→        seq: 1,
   437→        type: 'session.end',
   438→        session_id: s3,
   439→        data: { reason: 'done' },
   440→      }),
   441→    ].join('\n') + '\n');
   442→
   443→    // Session 4: event containing externalized blob pointer
   444→    const s4 = testUlid('SESS', 4);
   445→    const s4Dir = path.join(sessionsDir, s4);
   446→    await fs.mkdir(s4Dir);
   447→    await fs.mkdir(path.join(s4Dir, 'blobs'));
   448→    await fs.writeFile(path.join(s4Dir, 'session.yaml'), YAML.stringify({
   449→      id: s4,
   450→      agent_type: 'claude-agent-acp',
   451→      status: 'completed',
   452→      started_at: '2026-02-06T10:00:00.000Z',
   453→      ended_at: '2026-02-06T10:15:00.000Z',
