   331→// ─── CLI Integration Tests ──────────────────────────────────────────────────
   332→
   333→describe('kspec session log search (CLI)', () => {
   334→  let tempDir: string;
   335→
   336→  beforeEach(async () => {
   337→    tempDir = await setupTempFixtures();
   338→
   339→    // Create sessions directory for test data
   340→    const sessionsDir = path.join(tempDir, 'sessions');
   341→    await fs.mkdir(sessionsDir, { recursive: true });
   342→
   343→    // Session 1: with tool calls containing searchable content
   344→    const s1 = testUlid('SESS', 1);
   345→    const s1Dir = path.join(sessionsDir, s1);
   346→    await fs.mkdir(s1Dir);
   347→    await fs.writeFile(path.join(s1Dir, 'session.yaml'), YAML.stringify({
   348→      id: s1,
   349→      agent_type: 'claude-agent-acp',
   350→      status: 'completed',
   351→      started_at: '2026-01-15T10:00:00.000Z',
   352→      ended_at: '2026-01-15T11:30:00.000Z',
   353→    }));
   354→    await fs.writeFile(path.join(s1Dir, 'events.jsonl'), [
   355→      JSON.stringify({
   356→        ts: 1000,
   357→        seq: 0,
   358→        type: 'session.start',
   359→        session_id: s1,
   360→        data: { message: 'Starting automated build process' },
   361→      }),
   362→      JSON.stringify({
   363→        ts: 2000,
   364→        seq: 1,
   365→        type: 'session.update',
   366→        session_id: s1,
   367→        data: {
   368→          update: {
   369→            sessionUpdate: 'tool_call',
   370→            rawInput: { command: 'npm run test' },
   371→          },
   372→        },
   373→      }),
   374→      JSON.stringify({
   375→        ts: 3000,
   376→        seq: 2,
   377→        type: 'prompt.sent',
   378→        session_id: s1,
   379→        data: { prompt: 'Please analyze the TypeScript compiler errors' },
   380→      }),
   381→    ].join('\n') + '\n');
   382→
   383→    // Session 2: different agent, recent
   384→    const s2 = testUlid('SESS', 2);
   385→    const s2Dir = path.join(sessionsDir, s2);
   386→    await fs.mkdir(s2Dir);
   387→    await fs.writeFile(path.join(s2Dir, 'session.yaml'), YAML.stringify({
   388→      id: s2,
   389→      agent_type: 'custom-agent',
   390→      status: 'active',
   391→      started_at: '2026-02-05T08:00:00.000Z',
   392→    }));
   393→    await fs.writeFile(path.join(s2Dir, 'events.jsonl'), [
   394→      JSON.stringify({
   395→        ts: 4000,
   396→        seq: 0,
   397→        type: 'session.start',
   398→        session_id: s2,
   399→        data: { message: 'Custom build agent session' },
   400→      }),
   401→      JSON.stringify({
   402→        ts: 5000,
   403→        seq: 1,
   404→        type: 'session.update',
   405→        session_id: s2,
   406→        data: {
   407→          update: {
   408→            sessionUpdate: 'tool_call',
   409→            rawInput: { command: 'kspec task complete @build-task --reason "Build successful"' },
   410→          },
   411→        },
   412→      }),
   413→    ].join('\n') + '\n');
   414→
   415→    // Session 3: no matches for common patterns
   416→    const s3 = testUlid('SESS', 3);
   417→    const s3Dir = path.join(sessionsDir, s3);
   418→    await fs.mkdir(s3Dir);
   419→    await fs.writeFile(path.join(s3Dir, 'session.yaml'), YAML.stringify({
   420→      id: s3,
   421→      agent_type: 'claude-agent-acp',
   422→      status: 'completed',
   423→      started_at: '2026-02-04T14:00:00.000Z',
   424→      ended_at: '2026-02-04T15:00:00.000Z',
