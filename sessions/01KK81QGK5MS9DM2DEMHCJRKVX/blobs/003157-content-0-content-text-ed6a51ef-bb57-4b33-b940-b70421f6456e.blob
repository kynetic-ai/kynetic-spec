     1→/**
     2→ * Session log search tests.
     3→ *
     4→ * Tests for the `kspec session log search` command and supporting store functions.
     5→ */
     6→
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import * as fs from 'node:fs/promises';
     9→import * as os from 'node:os';
    10→import * as path from 'node:path';
    11→import * as YAML from 'yaml';
    12→import {
    13→  searchSessionEvents,
    14→  type SessionSearchResult,
    15→} from '../src/sessions/store.js';
    16→import {
    17→  setupTempFixtures,
    18→  cleanupTempDir,
    19→  kspec,
    20→  kspecJson,
    21→  testUlid,
    22→} from './helpers/cli';
    23→
    24→// ─── Store Unit Tests ───────────────────────────────────────────────────────
    25→
    26→describe('searchSessionEvents', () => {
    27→  let testDir: string;
    28→
    29→  beforeEach(async () => {
    30→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-search-'));
    31→
    32→    // Create sessions directory
    33→    const sessionsDir = path.join(testDir, 'sessions');
    34→    await fs.mkdir(sessionsDir, { recursive: true });
    35→
    36→    // Session 1: with tool calls
    37→    const s1 = testUlid('SESS', 1);
    38→    const s1Dir = path.join(sessionsDir, s1);
    39→    await fs.mkdir(s1Dir);
    40→    await fs.writeFile(path.join(s1Dir, 'session.yaml'), YAML.stringify({
    41→      id: s1,
    42→      agent_type: 'claude-agent-acp',
    43→      status: 'completed',
    44→      started_at: '2026-01-20T10:00:00.000Z',
    45→      ended_at: '2026-01-20T11:00:00.000Z',
    46→    }));
    47→    await fs.writeFile(path.join(s1Dir, 'events.jsonl'), [
    48→      JSON.stringify({
    49→        ts: 1000,
    50→        seq: 0,
    51→        type: 'session.start',
    52→        session_id: s1,
    53→        data: { message: 'Starting session' },
    54→      }),
    55→      JSON.stringify({
    56→        ts: 2000,
    57→        seq: 1,
    58→        type: 'session.update',
    59→        session_id: s1,
    60→        data: {
    61→          update: {
    62→            sessionUpdate: 'tool_call',
    63→            rawInput: { command: 'npm run build' },
    64→          },
    65→        },
    66→      }),
    67→      JSON.stringify({
    68→        ts: 3000,
    69→        seq: 2,
    70→        type: 'prompt.sent',
    71→        session_id: s1,
    72→        data: { prompt: 'Tell me about ERROR handling' },
    73→      }),
    74→      JSON.stringify({
    75→        ts: 4000,
    76→        seq: 3,
    77→        type: 'session.end',
    78→        session_id: s1,
    79→        data: { reason: 'completed successfully' },
    80→      }),
    81→    ].join('\n') + '\n');
    82→
    83→    // Session 2: different agent, more recent
    84→    const s2 = testUlid('SESS', 2);
    85→    const s2Dir = path.join(sessionsDir, s2);
    86→    await fs.mkdir(s2Dir);
    87→    await fs.writeFile(path.join(s2Dir, 'session.yaml'), YAML.stringify({
    88→      id: s2,
    89→      agent_type: 'custom-agent',
    90→      status: 'active',
    91→      started_at: '2026-02-01T08:00:00.000Z',
    92→    }));
    93→    await fs.writeFile(path.join(s2Dir, 'events.jsonl'), [
    94→      JSON.stringify({
    95→        ts: 5000,
    96→        seq: 0,
    97→        type: 'session.start',
    98→        session_id: s2,
    99→        data: { message: 'Custom session start' },
   100→      }),
   101→      JSON.stringify({
   102→        ts: 6000,
   103→        seq: 1,
   104→        type: 'session.update',
   105→        session_id: s2,
   106→        data: {
   107→          update: {
   108→            sessionUpdate: 'tool_call',
   109→            rawInput: { command: 'kspec task complete @my-task --reason "Fixed ERROR in build"' },
   110→          },
   111→        },
   112→      }),
   113→    ].join('\n') + '\n');
   114→
   115→    // Session 3: no matches for common patterns
   116→    const s3 = testUlid('SESS', 3);
   117→    const s3Dir = path.join(sessionsDir, s3);
   118→    await fs.mkdir(s3Dir);
   119→    await fs.writeFile(path.join(s3Dir, 'session.yaml'), YAML.stringify({
   120→      id: s3,
   121→      agent_type: 'claude-agent-acp',
   122→      status: 'completed',
   123→      started_at: '2026-02-02T10:00:00.000Z',
   124→      ended_at: '2026-02-02T11:00:00.000Z',
   125→    }));
   126→    await fs.writeFile(path.join(s3Dir, 'events.jsonl'), [
   127→      JSON.stringify({
   128→        ts: 7000,
   129→        seq: 0,
   130→        type: 'session.start',
   131→        session_id: s3,
   132→        data: { message: 'Clean session' },
   133→      }),
   134→      JSON.stringify({
   135→        ts: 8000,
   136→        seq: 1,
   137→        type: 'session.end',
   138→        session_id: s3,
   139→        data: { reason: 'done' },
   140→      }),
   141→    ].join('\n') + '\n');
   142→
   143→    // Session 4: externalized blob pointer payload
   144→    const s4 = testUlid('SESS', 4);
   145→    const s4Dir = path.join(sessionsDir, s4);
   146→    await fs.mkdir(s4Dir);
   147→    await fs.mkdir(path.join(s4Dir, 'blobs'));
   148→    await fs.writeFile(path.join(s4Dir, 'session.yaml'), YAML.stringify({
   149→      id: s4,
   150→      agent_type: 'claude-agent-acp',
   151→      status: 'completed',
   152→      started_at: '2026-02-03T10:00:00.000Z',
   153→      ended_at: '2026-02-03T10:30:00.000Z',
   154→    }));
   155→    await fs.writeFile(
   156→      path.join(s4Dir, 'blobs', 'search-pointer.blob'),
   157→      'RESOLVED_ONLY_BLOB_TOKEN',
   158→    );
   159→    await fs.writeFile(path.join(s4Dir, 'events.jsonl'), [
   160→      JSON.stringify({
   161→        ts: 9000,
   162→        seq: 0,
   163→        type: 'tool.result',
   164→        session_id: s4,
   165→        data: {
   166→          output: {
   167→            path: 'blobs/search-pointer.blob',
   168→            bytes: 24,
   169→            sha256: 'test-hash',
   170→            truncated: true,
   171→            preview: 'PREVIEW_ONLY_BLOB_TOKEN',
   172→          },
   173→        },
   174→      }),
   175→    ].join('\n') + '\n');
   176→  });
   177→
   178→  afterEach(async () => {
   179→    await fs.rm(testDir, { recursive: true });
   180→  });
   181→
   182→  // AC: @session-log-search ac-1
   183→  it('should search event data for case-insensitive substring match', async () => {
   184→    const results = await searchSessionEvents(testDir, 'error');
   185→    expect(results.length).toBeGreaterThan(0);
   186→
   187→    // Should find matches in both sessions that have "error" (case-insensitive)
   188→    let totalMatches = 0;
   189→    for (const r of results) {
   190→      totalMatches += r.matches.length;
   191→    }
   192→    expect(totalMatches).toBe(2); // One in session 1, one in session 2
   193→  });
   194→
   195→  // AC: @session-log-search ac-1
   196→  it('should return results grouped by session', async () => {
   197→    const results = await searchSessionEvents(testDir, 'session');
   198→    expect(results.length).toBeGreaterThan(0);
   199→
   200→    for (const result of results) {
   201→      expect(result).toHaveProperty('session_id');
   202→      expect(result).toHaveProperty('agent_type');
   203→      expect(result).toHaveProperty('started_at');
   204→      expect(result).toHaveProperty('matches');
   205→      expect(Array.isArray(result.matches)).toBe(true);
   206→    }
   207→  });
   208→
   209→  // AC: @session-log-search ac-2
   210→  it('should filter by event type when --type is provided', async () => {
   211→    const results = await searchSessionEvents(testDir, 'session', {
   212→      eventType: 'session.start',
   213→    });
   214→
   215→    // All matches should be session.start events
   216→    for (const result of results) {
   217→      for (const match of result.matches) {
   218→        expect(match.event_type).toBe('session.start');
   219→      }
   220→    }
   221→  });
   222→
   223→  // AC: @session-log-search ac-3
   224→  it('should filter by since date', async () => {
   225→    const sinceDate = new Date('2026-02-01');
   226→    const results = await searchSessionEvents(testDir, 'session', {
   227→      sinceDate,
   228→    });
   229→
   230→    // Only sessions 2 and 3 are after Feb 1
   231→    for (const result of results) {
   232→      expect(new Date(result.started_at).getTime()).toBeGreaterThanOrEqual(sinceDate.getTime());
   233→    }
   234→  });
   235→
   236→  // AC: @session-log-search ac-4
   237→  it('should return matches with session ID, timestamp, type, and excerpt', async () => {
   238→    const results = await searchSessionEvents(testDir, 'build');
   239→    expect(results.length).toBeGreaterThan(0);
   240→
   241→    const match = results[0].matches[0];
   242→    expect(match).toHaveProperty('session_id');
   243→    expect(match).toHaveProperty('timestamp');
   244→    expect(typeof match.timestamp).toBe('number');
   245→    expect(match).toHaveProperty('event_type');
   246→    expect(match).toHaveProperty('content_excerpt');
   247→    expect(typeof match.content_excerpt).toBe('string');
   248→  });
   249→
   250→  // AC: @session-log-search ac-4
   251→  it('should limit content excerpt to 200 characters', async () => {
   252→    const results = await searchSessionEvents(testDir, 'build');
   253→    for (const result of results) {
   254→      for (const match of result.matches) {
   255→        expect(match.content_excerpt.length).toBeLessThanOrEqual(200);
   256→      }
   257→    }
   258→  });
   259→
   260→  // AC: @session-log-search ac-5
   261→  it('should respect limit option', async () => {
   262→    const results = await searchSessionEvents(testDir, 'session', { limit: 2 });
   263→
   264→    let totalMatches = 0;
   265→    for (const r of results) {
   266→      totalMatches += r.matches.length;
   267→    }
   268→    expect(totalMatches).toBeLessThanOrEqual(2);
   269→  });
   270→
   271→  // AC: @session-log-search ac-6
   272→  it('should return empty array when no matches found', async () => {
   273→    const results = await searchSessionEvents(testDir, 'xyznonexistent');
   274→    expect(results).toEqual([]);
   275→  });
   276→
   277→  // AC: @session-log-search ac-7
   278→  it('should filter by agent type', async () => {
   279→    const results = await searchSessionEvents(testDir, 'session', {
   280→      agentType: 'custom-agent',
   281→    });
   282→
   283→    for (const result of results) {
   284→      expect(result.agent_type).toBe('custom-agent');
   285→    }
   286→  });
   287→
   288→  // Defense-in-depth: store normalizes invalid limits
   289→  it('should fallback to default limit when given invalid limit', async () => {
   290→    // NaN should be normalized to 50
   291→    const results1 = await searchSessionEvents(testDir, 'session', { limit: NaN });
   292→    expect(results1.length).toBeGreaterThan(0);
   293→
   294→    // 0 should be normalized to 50
   295→    const results2 = await searchSessionEvents(testDir, 'session', { limit: 0 });
   296→    expect(results2.length).toBeGreaterThan(0);
   297→
   298→    // Negative should be normalized to 50
   299→    const results3 = await searchSessionEvents(testDir, 'session', { limit: -5 });
   300→    expect(results3.length).toBeGreaterThan(0);
   301→  });
   302→
   303→  it('should combine multiple filters', async () => {
   304→    const results = await searchSessionEvents(testDir, 'error', {
   305→      agentType: 'custom-agent',
   306→      sinceDate: new Date('2026-01-01'),
   307→    });
   308→
   309→    expect(results.length).toBe(1);
   310→    expect(results[0].agent_type).toBe('custom-agent');
   311→  });
   312→
   313→  it('should search pointer previews by default', async () => {
   314→    const results = await searchSessionEvents(testDir, 'preview_only_blob_token');
   315→    expect(results.length).toBe(1);
   316→    expect(results[0].matches[0].content_excerpt).toContain('PREVIEW_ONLY_BLOB_TOKEN');
   317→  });
   318→
   319→  it('should resolve blob content when resolveBlobs is enabled', async () => {
   320→    const noResolve = await searchSessionEvents(testDir, 'resolved_only_blob_token');
   321→    expect(noResolve).toEqual([]);
   322→
   323→    const resolved = await searchSessionEvents(testDir, 'resolved_only_blob_token', {
   324→      resolveBlobs: true,
   325→    });
   326→    expect(resolved.length).toBe(1);
   327→    expect(resolved[0].matches[0].content_excerpt).toContain('RESOLVED_ONLY_BLOB_TOKEN');
   328→  });
   329→});
