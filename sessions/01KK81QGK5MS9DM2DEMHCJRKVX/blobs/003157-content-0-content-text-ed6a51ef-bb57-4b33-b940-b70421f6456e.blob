   560→  });
   561→
   562→  // AC: @session-log-search ac-5
   563→  it('should respect --limit flag', () => {
   564→    const results = kspecJson<SessionSearchResult[]>(
   565→      'session log search session -n 1',
   566→      tempDir,
   567→    );
   568→
   569→    let totalMatches = 0;
   570→    for (const r of results) {
