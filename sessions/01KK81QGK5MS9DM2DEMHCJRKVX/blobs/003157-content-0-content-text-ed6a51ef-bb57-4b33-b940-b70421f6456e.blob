   504→  // AC: @session-log-search ac-1
   505→  it('should search case-insensitively', () => {
   506→    // Search for uppercase BUILD should find lowercase "build"
   507→    const results = kspecJson<SessionSearchResult[]>('session log search BUILD', tempDir);
   508→    expect(results.length).toBeGreaterThan(0);
   509→  });
   510→
   511→  // AC: @session-log-search ac-2
   512→  it('should filter by event type with --type flag', () => {
   513→    const results = kspecJson<SessionSearchResult[]>(
   514→      'session log search session --type session.start',
   515→      tempDir,
   516→    );
   517→
   518→    for (const result of results) {
