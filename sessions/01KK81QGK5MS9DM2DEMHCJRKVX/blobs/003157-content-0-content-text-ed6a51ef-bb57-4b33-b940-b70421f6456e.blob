   524→
   525→  // AC: @session-log-search ac-3
   526→  it('should filter by --since flag', () => {
   527→    const results = kspecJson<SessionSearchResult[]>(
   528→      'session log search session --since 2026-02-01',
   529→      tempDir,
   530→    );
   531→
   532→    // Only sessions 2 and 3 are after Feb 1
