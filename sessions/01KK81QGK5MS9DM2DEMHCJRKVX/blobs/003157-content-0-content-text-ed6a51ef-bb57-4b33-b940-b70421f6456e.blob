   477→
   478→  afterEach(async () => {
   479→    await cleanupTempDir(tempDir);
   480→  });
   481→
   482→  // AC: @session-log-search ac-1
   483→  it('should search for pattern and display matches grouped by session', () => {
   484→    const result = kspec('session log search build', tempDir);
   485→    expect(result.exitCode).toBe(0);
   486→    expect(result.stdout).toContain('match');
   487→    expect(result.stdout).toContain('session');
   488→  });
   489→
   490→  // AC: @session-log-search ac-1 (JSON variant)
   491→  it('should return valid JSON with matches grouped by session in --json mode', () => {
   492→    const results = kspecJson<SessionSearchResult[]>('session log search build', tempDir);
   493→    expect(results.length).toBeGreaterThan(0);
   494→
   495→    for (const result of results) {
   496→      expect(result).toHaveProperty('session_id');
   497→      expect(result).toHaveProperty('agent_type');
