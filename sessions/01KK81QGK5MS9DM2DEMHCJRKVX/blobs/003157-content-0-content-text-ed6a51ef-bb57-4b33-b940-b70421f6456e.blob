   552→  // AC: @session-log-search ac-4
   553→  it('should limit content excerpt to 200 characters', () => {
   554→    const results = kspecJson<SessionSearchResult[]>('session log search build', tempDir);
   555→    for (const result of results) {
   556→      for (const match of result.matches) {
