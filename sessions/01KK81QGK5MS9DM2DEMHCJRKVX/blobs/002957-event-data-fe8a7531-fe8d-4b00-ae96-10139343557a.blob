"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"type\":\"progress\",\"data\":{\"type\":\"hook_progress\",\"hookEvent\":\"PostToolUse\",\"hookName\":\"PostToolUse:Read\",\"command\":\"callback\"},\"parentToolUseID\":\"toolu_01E1nhthDDMy9fwyf4jVuLuq\",\"toolUseID\":\"toolu_01E1nhthDDMy9fwyf4jVuLuq\",\"timestamp\":\"2026-03-09T01:25:03.069Z\",\"uuid\":\"1eddf7f0-7f11-431e-b006-f66fafa2cf93\"}\n{\"parentUuid\":\"1eddf7f0-7f11-431e-b006-f66fafa2cf93\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"type\":\"progress\",\"data\":{\"type\":\"hook_progress\",\"hookEvent\":\"PostToolUse\",\"hookName\":\"PostToolUse:Read\",\"command\":\"callback\"},\"parentToolUseID\":\"toolu_01E1nhthDDMy9fwyf4jVuLuq\",\"toolUseID\":\"toolu_01E1nhthDDMy9fwyf4jVuLuq\",\"timestamp\":\"2026-03-09T01:25:03.069Z\",\"uuid\":\"7bcf30a9-9c3e-474f-8776-cfe2d02f48aa\"}\n{\"parentUuid\":\"c713a891-ba57-4ceb-bcfc-5498fc4d3221\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01E1nhthDDMy9fwyf4jVuLuq\",\"type\":\"tool_result\",\"content\":\"     1→import * as fs from \\\"node:fs/promises\\\";\\n     2→import * as os from \\\"node:os\\\";\\n     3→import * as path from \\\"node:path\\\";\\n     4→import { execSync } from \\\"node:child_process\\\";\\n     5→import { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     6→import {\\n     7→  applyAutoAbandonMetadata,\\n     8→  appendEvent,\\n     9→  createSession,\\n    10→  getSession,\\n    11→  getSessionEventsPath,\\n    12→  resolveStaleSessionCriteria,\\n    13→  selectStaleActiveSessions,\\n    14→} from \\\"../src/sessions/store.js\\\";\\n    15→\\n    16→describe(\\\"stale session criteria\\\", () => {\\n    17→  let specDir: string;\\n    18→  const nowIso = \\\"2026-02-28T00:00:00.000Z\\\";\\n    19→  const nowMs = new Date(nowIso).getTime();\\n    20→\\n    21→  beforeEach(async () => {\\n    22→    specDir = await fs.mkdtemp(path.join(os.tmpdir(), \\\"kspec-stale-session-\\\"));\\n    23→  });\\n    24→\\n    25→  afterEach(async () => {\\n    26→    await fs.rm(specDir, { recursive: true, force: true });\\n    27→  });\\n    28→\\n    29→  // AC: @session-stale-criteria ac-5\\n    30→  it(\\\"applies default thresholds when none are provided\\\", () => {\\n    31→    const resolved = resolveStaleSessionCriteria({});\\n    32→    expect(resolved.ok).toBe(true);\\n    33→    if (!resolved.ok) return;\\n    34→    expect(resolved.criteria.olderThan).toBe(\\\"24h\\\");\\n    35→    expect(resolved.criteria.inactiveFor).toBe(\\\"6h\\\");\\n    36→    expect(resolved.criteria.livenessGuard).toBe(\\\"5m\\\");\\n    37→  });\\n    38→\\n    39→  // AC: @session-stale-criteria ac-4\\n    40→  it(\\\"rejects invalid relative duration with usage guidance\\\", () => {\\n    41→    const resolved = resolveStaleSessionCriteria({ olderThan: \\\"abc\\\" });\\n    42→    expect(resolved.ok).toBe(false);\\n    43→    if (resolved.ok) return;\\n    44→    expect(resolved.field).toBe(\\\"older-than\\\");\\n    45→    expect(resolved.guidance).toContain(\\\"relative durations only\\\");\\n    46→    expect(resolved.guidance).toContain(\\\"6h, 7d, 2w, 1m\\\");\\n    47→  });\\n    48→\\n    49→  // AC: @session-stale-criteria ac-6\\n    50→  it(\\\"rejects absolute timestamps for criteria flags\\\", () => {\\n    51→    const resolved = resolveStaleSessionCriteria({\\n    52→      inactiveFor: \\\"2026-02-27T12:00:00Z\\\",\\n    53→    });\\n    54→    expect(resolved.ok).toBe(false);\\n    55→    if (resolved.ok) return;\\n    56→    expect(resolved.field).toBe(\\\"inactive-for\\\");\\n    57→    expect(resolved.message).toContain(\\\"absolute timestamps are not supported\\\");\\n    58→    expect(resolved.guidance).toContain(\\\"relative durations only\\\");\\n    59→  });\\n    60→\\n    61→  // AC: @session-stale-criteria ac-1\\n    62→  it(\\\"marks session eligible when age and inactivity thresholds both match\\\", async () => {\\n    63→    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000001\\\";\\n    64→    await createSession(specDir, {\\n    65→      id: sessionId,\\n    66→      agent_type: \\\"ralph\\\",\\n    67→      status: \\\"active\\\",\\n    68→      started_at: \\\"2026-02-26T00:00:00.000Z\\\",\\n    69→    });\\n    70→    await appendEvent(specDir, {\\n    71→      session_id: sessionId,\\n    72→      type: \\\"session.update\\\",\\n    73→      ts: new Date(\\\"2026-02-27T12:00:00.000Z\\\").getTime(),\\n    74→      data: { update: \\\"idle\\\" },\\n    75→    });\\n    76→\\n    77→    const result = await selectStaleActiveSessions(\\n    78→      specDir,\\n    79→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n    80→      nowMs,\\n    81→    );\\n    82→    expect(result.candidates).toHaveLength(1);\\n    83→    expect(result.candidates[0].sessionId).toBe(sessionId);\\n    84→  });\\n    85→\\n    86→  // AC: @session-stale-criteria ac-2\\n    87→  it(\\\"uses started_at as last-activity fallback when events are missing\\\", async () => {\\n    88→    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000002\\\";\\n    89→    await createSession(specDir, {\\n    90→      id: sessionId,\\n    91→      agent_type: \\\"ralph\\\",\\n    92→      status: \\\"active\\\",\\n    93→      started_at: \\\"2026-02-26T12:00:00.000Z\\\",\\n    94→    });\\n    95→\\n    96→    const result = await selectStaleActiveSessions(\\n    97→      specDir,\\n    98→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n    99→      nowMs,\\n   100→    );\\n   101→    expect(result.candidates).toHaveLength(1);\\n   102→    expect(result.candidates[0].lastActivitySource).toBe(\\\"started_at\\\");\\n   103→    expect(result.candidates[0].sessionId).toBe(sessionId);\\n   104→  });\\n   105→\\n   106→  // AC: @session-stale-criteria ac-3\\n   107→  it(\\\"applies older-than and inactive-for with AND logic\\\", async () => {\\n   108→    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000003\\\";\\n   109→    await createSession(specDir, {\\n   110→      id: sessionId,\\n   111→      agent_type: \\\"ralph\\\",\\n   112→      status: \\\"active\\\",\\n   113→      started_at: \\\"2026-02-24T00:00:00.000Z\\\",\\n   114→    });\\n   115→    await appendEvent(specDir, {\\n   116→      session_id: sessionId,\\n   117→      type: \\\"session.update\\\",\\n   118→      ts: new Date(\\\"2026-02-27T21:00:00.000Z\\\").getTime(),\\n   119→      data: { update: \\\"recent-ish\\\" },\\n   120→    });\\n   121→\\n   122→    const result = await selectStaleActiveSessions(\\n   123→      specDir,\\n   124→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n   125→      nowMs,\\n   126→    );\\n   127→    expect(result.evaluations).toHaveLength(1);\\n   128→    expect(result.evaluations[0].meetsAgeThreshold).toBe(true);\\n   129→    expect(result.evaluations[0].meetsInactivityThreshold).toBe(false);\\n   130→    expect(result.candidates).toHaveLength(0);\\n   131→  });\\n   132→\\n   133→  // AC: @session-stale-criteria ac-7\\n   134→  it(\\\"skips and reports sessions with corrupt events.jsonl\\\", async () => {\\n   135→    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000004\\\";\\n   136→    await createSession(specDir, {\\n   137→      id: sessionId,\\n   138→      agent_type: \\\"ralph\\\",\\n   139→      status: \\\"active\\\",\\n   140→      started_at: \\\"2026-02-24T00:00:00.000Z\\\",\\n   141→    });\\n   142→    await fs.writeFile(\\n   143→      getSessionEventsPath(specDir, sessionId),\\n   144→      '{\\\"ts\\\":1700000000000,\\\"seq\\\":0,\\\"type\\\":\\\"session.update\\\",\\\"session_id\\\":\\\"x\\\",\\\"data\\\":{}}\\\\n{not-json}\\\\n',\\n   145→      \\\"utf-8\\\",\\n   146→    );\\n   147→\\n   148→    const result = await selectStaleActiveSessions(\\n   149→      specDir,\\n   150→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n   151→      nowMs,\\n   152→    );\\n   153→    expect(result.candidates).toHaveLength(0);\\n   154→    expect(result.skippedCount).toBe(1);\\n   155→    expect(result.failureCount).toBe(1);\\n   156→    expect(result.skipped[0].sessionId).toBe(sessionId);\\n   157→    expect(result.skipped[0].reason).toBe(\\\"events_corrupt\\\");\\n   158→    expect(result.skipped[0].detail).toContain(\\\"invalid line 2\\\");\\n   159→  });\\n   160→\\n   161→  // AC: @session-stale-criteria ac-7\\n   162→  it(\\\"skips and reports sessions with unreadable events.jsonl\\\", async () => {\\n   163→    const sessionId = \\\"01KJHSTAL3CR1T3R1A000000A\\\";\\n   164→    await createSession(specDir, {\\n   165→      id: sessionId,\\n   166→      agent_type: \\\"ralph\\\",\\n   167→      status: \\\"active\\\",\\n   168→      started_at: \\\"2026-02-24T00:00:00.000Z\\\",\\n   169→    });\\n   170→    await fs.mkdir(getSessionEventsPath(specDir, sessionId), {\\n   171→      recursive: true,\\n   172→    });\\n   173→\\n   174→    const result = await selectStaleActiveSessions(\\n   175→      specDir,\\n   176→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n   177→      nowMs,\\n   178→    );\\n   179→    expect(result.candidates).toHaveLength(0);\\n   180→    expect(result.skippedCount).toBe(1);\\n   181→    expect(result.failureCount).toBe(1);\\n   182→    expect(result.skipped[0].sessionId).toBe(sessionId);\\n   183→    expect(result.skipped[0].reason).toBe(\\\"events_unreadable\\\");\\n   184→    expect(result.skipped[0].detail).toContain(\\\"Unable to read events.jsonl\\\");\\n   185→    expect(result.skipped[0].detail).toContain(sessionId);\\n   186→  });\\n   187→\\n   188→  // AC: @session-stale-criteria ac-8\\n   189→  it(\\\"blocks closure when session has recent activity inside liveness guard window\\\", async () => {\\n   190→    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000005\\\";\\n   191→    await createSession(specDir, {\\n   192→      id: sessionId,\\n   193→      agent_type: \\\"ralph\\\",\\n   194→      status: \\\"active\\\",\\n   195→      started_at: \\\"2026-02-20T00:00:00.000Z\\\",\\n   196→    });\\n   197→    await appendEvent(specDir, {\\n   198→      session_id: sessionId,\\n   199→      type: \\\"session.update\\\",\\n   200→      ts: new Date(\\\"2026-02-27T23:58:00.000Z\\\").getTime(),\\n   201→      data: { update: \\\"very recent\\\" },\\n   202→    });\\n   203→\\n   204→    const result = await selectStaleActiveSessions(\\n   205→      specDir,\\n   206→      { olderThan: \\\"24h\\\", inactiveFor: \\\"1m\\\" },\\n   207→      nowMs,\\n   208→    );\\n   209→    expect(result.evaluations).toHaveLength(1);\\n   210→    expect(result.evaluations[0].meetsAgeThreshold).toBe(true);\\n   211→    expect(result.evaluations[0].meetsInactivityThreshold).toBe(true);\\n   212→    expect(result.evaluations[0].blockedByLivenessGuard).toBe(true);\\n   213→    expect(result.candidates).toHaveLength(0);\\n   214→  });\\n   215→\\n   216→  // AC: @session-stale-close-metadata ac-1\\n   217→  // AC: @session-stale-close-metadata ac-2\\n   218→  it(\\\"writes abandoned status with canonical auto-abandoned close_reason\\\", async () => {\\n   219→    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000006\\\";\\n   220→    await createSession(specDir, {\\n   221→      id: sessionId,\\n   222→      agent_type: \\\"ralph\\\",\\n   223→      status: \\\"active\\\",\\n   224→      started_at: \\\"2026-02-20T00:00:00.000Z\\\",\\n   225→    });\\n   226→    await appendEvent(specDir, {\\n   227→      session_id: sessionId,\\n   228→      type: \\\"session.update\\\",\\n   229→      ts: new Date(\\\"2026-02-27T12:00:00.000Z\\\").getTime(),\\n   230→      data: { update: \\\"idle\\\" },\\n   231→    });\\n   232→\\n   233→    const selection = await selectStaleActiveSessions(\\n   234→      specDir,\\n   235→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n   236→      nowMs,\\n   237→    );\\n   238→    const applied = await applyAutoAbandonMetadata(specDir, selection, {\\n   239→      nowMs,\\n   240→    });\\n   241→\\n   242→    expect(applied.updatedCount).toBe(1);\\n   243→    const updated = await getSession(specDir, sessionId);\\n   244→    expect(updated?.status).toBe(\\\"abandoned\\\");\\n   245→    expect(updated?.ended_at).toBe(nowIso);\\n   246→    expect(updated?.close_reason?.startsWith(\\\"auto-abandoned:\\\")).toBe(true);\\n   247→    expect(updated?.close_reason).toContain(\\\"older-than=24h\\\");\\n   248→    expect(updated?.close_reason).toContain(\\\"inactive-for=6h\\\");\\n   249→    expect(updated?.close_reason).toContain(\\\"liveness-guard=5m\\\");\\n   250→    expect(updated?.close_reason).toContain(\\\"last-activity=2026-02-27T12:00:00.000Z\\\");\\n   251→  });\\n   252→\\n   253→  // AC: @session-stale-close-metadata ac-3\\n   254→  it(\\\"applies batch metadata updates for multiple sessions in one invocation\\\", async () => {\\n   255→    const sessionA = \\\"01KJHSTAL3CR1T3R1A0000007\\\";\\n   256→    const sessionB = \\\"01KJHSTAL3CR1T3R1A0000008\\\";\\n   257→    await createSession(specDir, {\\n   258→      id: sessionA,\\n   259→      agent_type: \\\"ralph\\\",\\n   260→      status: \\\"active\\\",\\n   261→      started_at: \\\"2026-02-20T00:00:00.000Z\\\",\\n   262→    });\\n   263→    await createSession(specDir, {\\n   264→      id: sessionB,\\n   265→      agent_type: \\\"ralph\\\",\\n   266→      status: \\\"active\\\",\\n   267→      started_at: \\\"2026-02-19T00:00:00.000Z\\\",\\n   268→    });\\n   269→\\n   270→    const selection = await selectStaleActiveSessions(\\n   271→      specDir,\\n   272→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n   273→      nowMs,\\n   274→    );\\n   275→    const applied = await applyAutoAbandonMetadata(specDir, selection, {\\n   276→      nowMs,\\n   277→    });\\n   278→\\n   279→    expect(applied.updatedCount).toBe(2);\\n   280→    expect(applied.updates).toHaveLength(2);\\n   281→    expect(applied.updates[0].endedAt).toBe(nowIso);\\n   282→    expect(applied.updates[1].endedAt).toBe(nowIso);\\n   283→    expect(applied.updates[0].closeReason.startsWith(\\\"auto-abandoned:\\\")).toBe(true);\\n   284→    expect(applied.updates[1].closeReason.startsWith(\\\"auto-abandoned:\\\")).toBe(true);\\n   285→\\n   286→    const updatedA = await getSession(specDir, sessionA);\\n   287→    const updatedB = await getSession(specDir, sessionB);\\n   288→    expect(updatedA?.status).toBe(\\\"abandoned\\\");\\n   289→    expect(updatedB?.status).toBe(\\\"abandoned\\\");\\n   290→    expect(updatedA?.ended_at).toBe(nowIso);\\n   291→    expect(updatedB?.ended_at).toBe(nowIso);\\n   292→  });\\n   293→\\n   294→  // AC: @session-stale-close-metadata ac-3\\n   295→  it(\\\"records one shadow commit with command-specific message for multi-session close\\\", async () => {\\n   296→    execSync(\\\"git init\\\", { cwd: specDir, stdio: \\\"pipe\\\" });\\n   297→    execSync('git config user.name \\\"Test User\\\"', { cwd: specDir, stdio: \\\"pipe\\\" });\\n   298→    execSync('git config user.email \\\"test@example.com\\\"', {\\n   299→      cwd: specDir,\\n   300→      stdio: \\\"pipe\\\",\\n   301→    });\\n   302→\\n   303→    const sessionA = \\\"01KJHSTAL3CR1T3R1A000000B\\\";\\n   304→    const sessionB = \\\"01KJHSTAL3CR1T3R1A000000C\\\";\\n   305→    await createSession(specDir, {\\n   306→      id: sessionA,\\n   307→      agent_type: \\\"ralph\\\",\\n   308→      status: \\\"active\\\",\\n   309→      started_at: \\\"2026-02-20T00:00:00.000Z\\\",\\n   310→    });\\n   311→    await createSession(specDir, {\\n   312→      id: sessionB,\\n   313→      agent_type: \\\"ralph\\\",\\n   314→      status: \\\"active\\\",\\n   315→      started_at: \\\"2026-02-19T00:00:00.000Z\\\",\\n   316→    });\\n   317→\\n   318→    execSync(\\\"git add -A\\\", { cwd: specDir, stdio: \\\"pipe\\\" });\\n   319→    execSync('git commit -m \\\"test: seed sessions\\\"', {\\n   320→      cwd: specDir,\\n   321→      stdio: \\\"pipe\\\",\\n   322→      env: { ...process.env, KSPEC_SHADOW_COMMIT: \\\"1\\\" },\\n   323→    });\\n   324→    const beforeCount = Number.parseInt(\\n   325→      execSync(\\\"git rev-list --count HEAD\\\", {\\n   326→        cwd: specDir,\\n   327→        encoding: \\\"utf-8\\\",\\n   328→      }).trim(),\\n   329→      10,\\n   330→    );\\n   331→\\n   332→    const selection = await selectStaleActiveSessions(\\n   333→      specDir,\\n   334→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n   335→      nowMs,\\n   336→    );\\n   337→    const commitMessage = \\\"session stale close auto-abandoned metadata\\\";\\n   338→    const applied = await applyAutoAbandonMetadata(specDir, selection, {\\n   339→      nowMs,\\n   340→      shadowCommitMessage: commitMessage,\\n   341→    });\\n   342→\\n   343→    const afterCount = Number.parseInt(\\n   344→      execSync(\\\"git rev-list --count HEAD\\\", {\\n   345→        cwd: specDir,\\n   346→        encoding: \\\"utf-8\\\",\\n   347→      }).trim(),\\n   348→      10,\\n   349→    );\\n   350→    const lastMessage = execSync(\\\"git log -1 --pretty=%s\\\", {\\n   351→      cwd: specDir,\\n   352→      encoding: \\\"utf-8\\\",\\n   353→    }).trim();\\n   354→\\n   355→    expect(applied.updatedCount).toBe(2);\\n   356→    expect(applied.shadowCommitted).toBe(true);\\n   357→    expect(afterCount - beforeCount).toBe(1);\\n   358→    expect(lastMessage).toBe(commitMessage);\\n   359→  });\\n   360→\\n   361→  // AC: @session-stale-close-metadata ac-4\\n   362→  it(\\\"returns preview close_reason in dry-run mode without changing files\\\", async () => {\\n   363→    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000009\\\";\\n   364→    await createSession(specDir, {\\n   365→      id: sessionId,\\n   366→      agent_type: \\\"ralph\\\",\\n   367→      status: \\\"active\\\",\\n   368→      started_at: \\\"2026-02-20T00:00:00.000Z\\\",\\n   369→    });\\n   370→    await appendEvent(specDir, {\\n   371→      session_id: sessionId,\\n   372→      type: \\\"session.update\\\",\\n   373→      ts: new Date(\\\"2026-02-27T12:00:00.000Z\\\").getTime(),\\n   374→      data: { update: \\\"idle\\\" },\\n   375→    });\\n   376→\\n   377→    const before = await getSession(specDir, sessionId);\\n   378→    const selection = await selectStaleActiveSessions(\\n   379→      specDir,\\n   380→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n   381→      nowMs,\\n   382→    );\\n   383→    const applied = await applyAutoAbandonMetadata(specDir, selection, {\\n   384→      dryRun: true,\\n   385→      nowMs,\\n   386→    });\\n   387→    const after = await getSession(specDir, sessionId);\\n   388→\\n   389→    expect(applied.dryRun).toBe(true);\\n   390→    expect(applied.updatedCount).toBe(1);\\n   391→    expect(applied.updates[0].closeReason.startsWith(\\\"auto-abandoned:\\\")).toBe(true);\\n   392→    expect(applied.updates[0].closeReason).toContain(\\\"older-than=24h\\\");\\n   393→\\n   394→    expect(after?.status).toBe(before?.status);\\n   395→    expect(after?.ended_at).toBe(before?.ended_at);\\n   396→    expect(after?.close_reason).toBe(before?.close_reason);\\n   397→  });\\n   398→});\\n   399→\"}]},\"uuid\":\"e3d2cc39-69eb-4f95-bb41-b75093ebff85\",\"timestamp\":\"2026-03-09T01:25:03.069Z\",\"sourceToolAssistantUUID\":\"c713a891-ba57-4ceb-bcfc-5498fc4d3221\"}\n{\"parentUuid\":\"e3d2cc39-69eb-4f95-bb41-b75093ebff85\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"message\":{\"model\":\"claude-opus-4-6\",\"id\":\"msg_019B7FV53EUZR4V5DSRzTPdv\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"I see the linter reverted all my changes. The file is back to its original state. Let me write the complete updated file instead.\"}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":1,\"cache_creation_input_tokens\":6111,\"cache_read_input_tokens\":74541,\"cache_creation\":{\"ephemeral_5m_input_tokens\":6111,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"}},\"requestId\":\"req_011CYrdjgHX43XxAy7pSiy7j\",\"type\":\"assistant\",\"uuid\":\"f71ac562-c30d-4558-9d32-a7092b2ead14\",\"timestamp\":\"2026-03-09T01:25:06.945Z\"}\n{\"parentUuid\":\"f71ac562-c30d-4558-9d32-a7092b2ead14\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"message\":{\"model\":\"claude-opus-4-6\",\"id\":\"msg_019B7FV53EUZR4V5DSRzTPdv\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01AP1ibpjAPJD6HRDCr62fRP\",\"name\":\"Write\",\"input\":{\"file_path\":\"/home/chapel/Projects/kynetic-spec/tests/session-stale-criteria.test.ts\",\"content\":\"import * as fs from \\\"node:fs/promises\\\";\\nimport * as os from \\\"node:os\\\";\\nimport * as path from \\\"node:path\\\";\\nimport { execSync } from \\\"node:child_process\\\";\\nimport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\nimport {\\n  applyAutoAbandonMetadata,\\n  appendEvent,\\n  createSession,\\n  getSession,\\n  getSessionEventsPath,\\n  resolveStaleSessionCriteria,\\n  selectStaleActiveSessions,\\n} from \\\"../src/sessions/store.js\\\";\\n\\ndescribe(\\\"stale session criteria\\\", () => {\\n  let specDir: string;\\n  let sessionsDir: string;\\n  const nowIso = \\\"2026-02-28T00:00:00.000Z\\\";\\n  const nowMs = new Date(nowIso).getTime();\\n\\n  beforeEach(async () => {\\n    specDir = await fs.mkdtemp(path.join(os.tmpdir(), \\\"kspec-stale-session-\\\"));\\n    sessionsDir = path.join(specDir, \\\"sessions\\\");\\n  });\\n\\n  afterEach(async () => {\\n    await fs.rm(specDir, { recursive: true, force: true });\\n  });\\n\\n  // AC: @session-stale-criteria ac-5\\n  it(\\\"applies default thresholds when none are provided\\\", () => {\\n    const resolved = resolveStaleSessionCriteria({});\\n    expect(resolved.ok).toBe(true);\\n    if (!resolved.ok) return;\\n    expect(resolved.criteria.olderThan).toBe(\\\"24h\\\");\\n    expect(resolved.criteria.inactiveFor).toBe(\\\"6h\\\");\\n    expect(resolved.criteria.livenessGuard).toBe(\\\"5m\\\");\\n  });\\n\\n  // AC: @session-stale-criteria ac-4\\n  it(\\\"rejects invalid relative duration with usage guidance\\\", () => {\\n    const resolved = resolveStaleSessionCriteria({ olderThan: \\\"abc\\\" });\\n    expect(resolved.ok).toBe(false);\\n    if (resolved.ok) return;\\n    expect(resolved.field).toBe(\\\"older-than\\\");\\n    expect(resolved.guidance).toContain(\\\"relative durations only\\\");\\n    expect(resolved.guidance).toContain(\\\"6h, 7d, 2w, 1m\\\");\\n  });\\n\\n  // AC: @session-stale-criteria ac-6\\n  it(\\\"rejects absolute timestamps for criteria flags\\\", () => {\\n    const resolved = resolveStaleSessionCriteria({\\n      inactiveFor: \\\"2026-02-27T12:00:00Z\\\",\\n    });\\n    expect(resolved.ok).toBe(false);\\n    if (resolved.ok) return;\\n    expect(resolved.field).toBe(\\\"inactive-for\\\");\\n    expect(resolved.message).toContain(\\\"absolute timestamps are not supported\\\");\\n    expect(resolved.guidance).toContain(\\\"relative durations only\\\");\\n  });\\n\\n  // AC: @session-stale-criteria ac-1\\n  it(\\\"marks session eligible when age and inactivity thresholds both match\\\", async () => {\\n    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000001\\\";\\n    await createSession(sessionsDir, {\\n      id: sessionId,\\n      agent_type: \\\"ralph\\\",\\n      status: \\\"active\\\",\\n      started_at: \\\"2026-02-26T00:00:00.000Z\\\",\\n    });\\n    await appendEvent(sessionsDir, {\\n      session_id: sessionId,\\n      type: \\\"session.update\\\",\\n      ts: new Date(\\\"2026-02-27T12:00:00.000Z\\\").getTime(),\\n      data: { update: \\\"idle\\\" },\\n    });\\n\\n    const result = await selectStaleActiveSessions(\\n      sessionsDir,\\n      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n      nowMs,\\n    );\\n    expect(result.candidates).toHaveLength(1);\\n    expect(result.candidates[0].sessionId).toBe(sessionId);\\n  });\\n\\n  // AC: @session-stale-criteria ac-2\\n  it(\\\"uses started_at as last-activity fallback when events are missing\\\", async () => {\\n    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000002\\\";\\n    await createSession(sessionsDir, {\\n      id: sessionId,\\n      agent_type: \\\"ralph\\\",\\n      status: \\\"active\\\",\\n      started_at: \\\"2026-02-26T12:00:00.000Z\\\",\\n    });\\n\\n    const result = await selectStaleActiveSessions(\\n      sessionsDir,\\n      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n      nowMs,\\n    );\\n    expect(result.candidates).toHaveLength(1);\\n    expect(result.candidates[0].lastActivitySource).toBe(\\\"started_at\\\");\\n    expect(result.candidates[0].sessionId).toBe(sessionId);\\n  });\\n\\n  // AC: @session-stale-criteria ac-3\\n  it(\\\"applies older-than and inactive-for with AND logic\\\", async () => {\\n    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000003\\\";\\n    await createSession(sessionsDir, {\\n      id: sessionId,\\n      agent_type: \\\"ralph\\\",\\n      status: \\\"active\\\",\\n      started_at: \\\"2026-02-24T00:00:00.000Z\\\",\\n    });\\n    await appendEvent(sessionsDir, {\\n      session_id: sessionId,\\n      type: \\\"session.update\\\",\\n      ts: new Date(\\\"2026-02-27T21:00:00.000Z\\\").getTime(),\\n      data: { update: \\\"recent-ish\\\" },\\n    });\\n\\n    const result = await selectStaleActiveSessions(\\n      sessionsDir,\\n      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n      nowMs,\\n    );\\n    expect(result.evaluations).toHaveLength(1);\\n    expect(result.evaluations[0].meetsAgeThreshold).toBe(true);\\n    expect(result.evaluations[0].meetsInactivityThreshold).toBe(false);\\n    expect(result.candidates).toHaveLength(0);\\n  });\\n\\n  // AC: @session-stale-criteria ac-7\\n  it(\\\"skips and reports sessions with corrupt events.jsonl\\\", async () => {\\n    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000004\\\";\\n    await createSession(sessionsDir, {\\n      id: sessionId,\\n      agent_type: \\\"ralph\\\",\\n      status: \\\"active\\\",\\n      started_at: \\\"2026-02-24T00:00:00.000Z\\\",\\n    });\\n    await fs.writeFile(\\n      getSessionEventsPath(sessionsDir, sessionId),\\n      '{\\\"ts\\\":1700000000000,\\\"seq\\\":0,\\\"type\\\":\\\"session.update\\\",\\\"session_id\\\":\\\"x\\\",\\\"data\\\":{}}\\\\n{not-json}\\\\n',\\n      \\\"utf-8\\\",\\n    );\\n\\n    const result = await selectStaleActiveSessions(\\n      sessionsDir,\\n      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n      nowMs,\\n    );\\n    expect(result.candidates).toHaveLength(0);\\n    expect(result.skippedCount).toBe(1);\\n    expect(result.failureCount).toBe(1);\\n    expect(result.skipped[0].sessionId).toBe(sessionId);\\n    expect(result.skipped[0].reason).toBe(\\\"events_corrupt\\\");\\n    expect(result.skipped[0].detail).toContain(\\\"invalid line 2\\\");\\n  });\\n\\n  // AC: @session-stale-criteria ac-7\\n  it(\\\"skips and reports sessions with unreadable events.jsonl\\\", async () => {\\n    const sessionId = \\\"01KJHSTAL3CR1T3R1A000000A\\\";\\n    await createSession(sessionsDir, {\\n      id: sessionId,\\n      agent_type: \\\"ralph\\\",\\n      status: \\\"active\\\",\\n      started_at: \\\"2026-02-24T00:00:00.000Z\\\",\\n    });\\n    await fs.mkdir(getSessionEventsPath(sessionsDir, sessionId), {\\n      recursive: true,\\n    });\\n\\n    const result = await selectStaleActiveSessions(\\n      sessionsDir,\\n      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n      nowMs,\\n    );\\n    expect(result.candidates).toHaveLength(0);\\n    expect(result.skippedCount).toBe(1);\\n    expect(result.failureCount).toBe(1);\\n    expect(result.skipped[0].sessionId).toBe(sessionId);\\n    expect(result.skipped[0].reason).toBe(\\\"events_unreadable\\\");\\n    expect(result.skipped[0].detail).toContain(\\\"Unable to read events.jsonl\\\");\\n    expect(result.skipped[0].detail).toContain(sessionId);\\n  });\\n\\n  // AC: @session-stale-criteria ac-8\\n  it(\\\"blocks closure when session has recent activity inside liveness guard window\\\", async () => {\\n    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000005\\\";\\n    await createSession(sessionsDir, {\\n      id: sessionId,\\n      agent_type: \\\"ralph\\\",\\n      status: \\\"active\\\",\\n      started_at: \\\"2026-02-20T00:00:00.000Z\\\",\\n    });\\n    await appendEvent(sessionsDir, {\\n      session_id: sessionId,\\n      type: \\\"session.update\\\",\\n      ts: new Date(\\\"2026-02-27T23:58:00.000Z\\\").getTime(),\\n      data: { update: \\\"very recent\\\" },\\n    });\\n\\n    const result = await selectStaleActiveSessions(\\n      sessionsDir,\\n      { olderThan: \\\"24h\\\", inactiveFor: \\\"1m\\\" },\\n      nowMs,\\n    );\\n    expect(re