\n     9→  createSession,\\n    10→  getSession,\\n    11→  getSessionEventsPath,\\n    12→  resolveStaleSessionCriteria,\\n    13→  selectStaleActiveSessions,\\n    14→} from \\\"../src/sessions/store.js\\\";\\n    15→\\n    16→describe(\\\"stale session criteria\\\", () => {\\n    17→  let specDir: string;\\n    18→  const nowIso = \\\"2026-02-28T00:00:00.000Z\\\";\\n    19→  const nowMs = new Date(nowIso).getTime();\\n    20→\\n    21→  beforeEach(async () => {\\n    22→    specDir = await fs.mkdtemp(path.join(os.tmpdir(), \\\"kspec-stale-session-\\\"));\\n    23→  });\\n    24→\\n    25→  afterEach(async () => {\\n    26→    await fs.rm(specDir, { recursive: true, force: true });\\n    27→  });\\n    28→\\n    29→  // AC: @session-stale-criteria ac-5\\n    30→  it(\\\"applies default thresholds when none are provided\\\", () => {\\n    31→    const resolved = resolveStaleSessionCriteria({});\\n    32→    expect(resolved.ok).toBe(true);\\n    33→    if (!resolved.ok) return;\\n    34→    expect(resolved.criteria.olderThan).toBe(\\\"24h\\\");\\n    35→    expect(resolved.criteria.inactiveFor).toBe(\\\"6h\\\");\\n    36→    expect(resolved.criteria.livenessGuard).toBe(\\\"5m\\\");\\n    37→  });\\n    38→\\n    39→  // AC: @session-stale-criteria ac-4\\n    40→  it(\\\"rejects invalid relative duration with usage guidance\\\", () => {\\n    41→    const resolved = resolveStaleSessionCriteria({ olderThan: \\\"abc\\\" });\\n    42→    expect(resolved.ok).toBe(false);\\n    43→    if (resolved.ok) return;\\n    44→    expect(resolved.field).toBe(\\\"older-than\\\");\\n    45→    expect(resolved.guidance).toContain(\\\"relative durations only\\\");\\n    46→    expect(resolved.guidance).toContain(\\\"6h, 7d, 2w, 1m\\\");\\n    47→  });\\n    48→\\n    49→  // AC: @session-stale-criteria ac-6\\n    50→  it(\\\"rejects absolute timestamps for criteria flags\\\", () => {\\n    51→    const resolved = resolveStaleSessionCriteria({\\n    52→      inactiveFor: \\\"2026-02-27T12:00:00Z\\\",\\n    53→    });\\n    54→    expect(resolved.ok).toBe(false);\\n    55→    if (resolved.ok) return;\\n    56→    expect(resolved.field).toBe(\\\"inactive-for\\\");\\n    57→    expect(resolved.message).toContain(\\\"absolute timestamps are not supported\\\");\\n    58→    expect(resolved.guidance).toContain(\\\"relative durations only\\\");\\n    59→  });\\n    60→\\n    61→  // AC: @session-stale-criteria ac-1\\n    62→  it(\\\"marks session eligible when age and inactivity thresholds both match\\\", async () => {\\n    63→    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000001\\\";\\n    64→    await createSession(specDir, {\\n    65→      id: sessionId,\\n    66→      agent_type: \\\"ralph\\\",\\n    67→      status: \\\"active\\\",\\n    68→      started_at: \\\"2026-02-26T00:00:00.000Z\\\",\\n    69→    });\\n    70→    await appendEvent(specDir, {\\n    71→      session_id: sessionId,\\n    72→      type: \\\"session.update\\\",\\n    73→      ts: new Date(\\\"2026-02-27T12:00:00.000Z\\\").getTime(),\\n    74→      data: { update: \\\"idle\\\" },\\n    75→    });\\n    76→\\n    77→    const result = await selectStaleActiveSessions(\\n    78→      specDir,\\n    79→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n    80→      nowMs,\\n    81→    );\\n    82→    expect(result.candidates).toHaveLength(1);\\n    83→    expect(result.candidates[0].sessionId).toBe(sessionId);\\n    84→  });\\n    85→\\n    86→  // AC: @session-stale-criteria ac-2\\n    87→  it(\\\"uses started_at as last-activity fallback when events are missing\\\", async () => {\\n    88→    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000002\\\";\\n    89→    await createSession(specDir, {\\n    90→      id: sessionId,\\n    91→      agent_type: \\\"ralph\\\",\\n    92→      status: \\\"active\\\",\\n    93→      started_at: \\\"2026-02-26T12:00:00.000Z\\\",\\n    94→    });\\n    95→\\n    96→    const result = await selectStaleActiveSessions(\\n    97→      specDir,\\n    98→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n    99→      nowMs,\\n   100→    );\\n   101→    expect(result.candidates).toHaveLength(1);\\n   102→    expect(result.candidates[0].lastActivitySource).toBe(\\\"started_at\\\");\\n   103→    expect(result.candidates[0].sessionId).toBe(sessionId);\\n   104→  });\\n   105→\\n   106→  // AC: @session-stale-criteria ac-3\\n   107→  it(\\\"applies older-than and inactive-for with AND logic\\\", async () => {\\n   108→    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000003\\\";\\n   109→    await createSession(specDir, {\\n   110→      id: sessionId,\\n   111→      agent_type: \\\"ralph\\\",\\n   112→      status: \\\"active\\\",\\n   113→      started_at: \\\"2026-02-24T00:00:00.000Z\\\",\\n   114→    });\\n   115→    await appendEvent(specDir, {\\n   116→      session_id: sessionId,\\n   117→      type: \\\"session.update\\\",\\n   118→      ts: new Date(\\\"2026-02-27T21:00:00.000Z\\\").getTime(),\\n   119→      data: { update: \\\"recent-ish\\\" },\\n   120→    });\\n   121→\\n   122→    const result = await selectStaleActiveSessions(\\n   123→      specDir,\\n   124→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n   125→      nowMs,\\n   126→    );\\n   127→    expect(result.evaluations).toHaveLength(1);\\n   128→    expect(result.evaluations[0].meetsAgeThreshold).toBe(true);\\n   129→    expect(result.evaluations[0].meetsInactivityThreshold).toBe(false);\\n   130→    expect(result.candidates).toHaveLength(0);\\n   131→  });\\n   132→\\n   133→  // AC: @session-stale-criteria ac-7\\n   134→  it(\\\"skips and reports sessions with corrupt events.jsonl\\\", async () => {\\n   135→    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000004\\\";\\n   136→    await createSession(specDir, {\\n   137→      id: sessionId,\\n   138→      agent_type: \\\"ralph\\\",\\n   139→      status: \\\"active\\\",\\n   140→      started_at: \\\"2026-02-24T00:00:00.000Z\\\",\\n   141→    });\\n   142→    await fs.writeFile(\\n   143→      getSessionEventsPath(specDir, sessionId),\\n   144→      '{\\\"ts\\\":1700000000000,\\\"seq\\\":0,\\\"type\\\":\\\"session.update\\\",\\\"session_id\\\":\\\"x\\\",\\\"data\\\":{}}\\\\n{not-json}\\\\n',\\n   145→      \\\"utf-8\\\",\\n   146→    );\\n   147→\\n   148→    const result = await selectStaleActiveSessions(\\n   149→      specDir,\\n   150→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n   151→      nowMs,\\n   152→    );\\n   153→    expect(result.candidates).toHaveLength(0);\\n   154→    expect(result.skippedCount).toBe(1);\\n   155→    expect(result.failureCount).toBe(1);\\n   156→    expect(result.skipped[0].sessionId).toBe(sessionId);\\n   157→    expect(result.skipped[0].reason).toBe(\\\"events_corrupt\\\");\\n   158→    expect(result.skipped[0].detail).toContain(\\\"invalid line 2\\\");\\n   159→  });\\n   160→\\n   161→  // AC: @session-stale-criteria ac-7\\n   162→  it(\\\"skips and reports sessions with unreadable events.jsonl\\\", async () => {\\n   163→    const sessionId = \\\"01KJHSTAL3CR1T3R1A000000A\\\";\\n   164→    await createSession(specDir, {\\n   165→      id: sessionId,\\n   166→      agent_type: \\\"ralph\\\",\\n   167→      status: \\\"active\\\",\\n   168→      started_at: \\\"2026-02-24T00:00:00.000Z\\\",\\n   169→    });\\n   170→    await fs.mkdir(getSessionEventsPath(specDir, sessionId), {\\n   171→      recursive: true,\\n   172→    });\\n   173→\\n   174→    const result = await selectStaleActiveSessions(\\n   175→      specDir,\\n   176→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n   177→      nowMs,\\n   178→    );\\n   179→    expect(result.candidates).toHaveLength(0);\\n   180→    expect(result.skippedCount).toBe(1);\\n   181→    expect(result.failureCount).toBe(1);\\n   182→    expect(result.skipped[0].sessionId).toBe(sessionId);\\n   183→    expect(result.skipped[0].reason).toBe(\\\"events_unreadable\\\");\\n   184→    expect(result.skipped[0].detail).toContain(\\\"Unable to read events.jsonl\\\");\\n   185→    expect(result.skipped[0].detail).toContain(sessionId);\\n   186→  });\\n   187→\\n   188→  // AC: @session-stale-criteria ac-8\\n   189→  it(\\\"blocks closure when session has recent activity inside liveness guard window\\\", async () => {\\n   190→    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000005\\\";\\n   191→    await createSession(specDir, {\\n   192→      id: sessionId,\\n   193→      agent_type: \\\"ralph\\\",\\n   194→      status: \\\"active\\\",\\n   195→      started_at: \\\"2026-02-20T00:00:00.000Z\\\",\\n   196→    });\\n   197→    await appendEvent(specDir, {\\n   198→      session_id: sessionId,\\n   199→      type: \\\"session.update\\\",\\n   200→      ts: new Date(\\\"2026-02-27T23:58:00.000Z\\\").getTime(),\\n   201→      data: { update: \\\"very recent\\\" },\\n   202→    });\\n   203→\\n   204→    const result = await selectStaleActiveSessions(\\n   205→      specDir,\\n   206→      { olderThan: \\\"24h\\\", inactiveFor: \\\"1m\\\" },\\n   207→      nowMs,\\n   208→    );\\n   209→    expect(result.evaluations).toHaveLength(1);\\n   210→    expect(result.evaluations[0].meetsAgeThreshold).toBe(true);\\n   211→    expect(result.evaluations[0].meetsInactivityThreshold).toBe(true);\\n   212→    expect(result.evaluations[0].blockedByLivenessGuard).toBe(true);\\n   213→    expect(result.candidates).toHaveLength(0);\\n   214→  });\\n   215→\\n   216→  // AC: @session-stale-close-metadata ac-1\\n   217→  // AC: @session-stale-close-metadata ac-2\\n   218→  it(\\\"writes abandoned status with canonical auto-abandoned close_reason\\\", async () => {\\n   219→    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000006\\\";\\n   220→    await createSession(specDir, {\\n   221→      id: sessionId,\\n   222→      agent_type: \\\"ralph\\\",\\n   223→      status: \\\"active\\\",\\n   224→      started_at: \\\"2026-02-20T00:00:00.000Z\\\",\\n   225→    });\\n   226→    await appendEvent(specDir, {\\n   227→      session_id: sessionId,\\n   228→      type: \\\"session.update\\\",\\n   229→      ts: new Date(\\\"2026-02-27T12:00:00.000Z\\\").getTime(),\\n   230→      data: { update: \\\"idle\\\" },\\n   231→    });\\n   232→\\n   233→    const selection = await selectStaleActiveSessions(\\n   234→      specDir,\\n   235→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n   236→      nowMs,\\n   237→    );\\n   238→    const applied = await applyAutoAbandonMetadata(specDir, selection, {\\n   239→      nowMs,\\n   240→    });\\n   241→\\n   242→    expect(applied.updatedCount).toBe(1);\\n   243→    const updated = await getSession(specDir, sessionId);\\n   244→    expect(updated?.status).toBe(\\\"abandoned\\\");\\n   245→    expect(updated?.ended_at).toBe(nowIso);\\n   246→    expect(updated?.close_reason?.startsWith(\\\"auto-abandoned:\\\")).toBe(true);\\n   247→    expect(updated?.close_reason).toContain(\\\"older-than=24h\\\");\\n   248→    expect(updated?.close_reason).toContain(\\\"inactive-for=6h\\\");\\n   249→    expect(updated?.close_reason).toContain(\\\"liveness-guard=5m\\\");\\n   250→    expect(updated?.close_reason).toContain(\\\"last-activity=2026-02-27T12:00:00.000Z\\\");\\n   251→  });\\n   252→\\n   253→  // AC: @session-stale-close-metadata ac-3\\n   254→  it(\\\"applies batch metadata updates for multiple sessions in one invocation\\\", async () => {\\n   255→    const sessionA = \\\"01KJHSTAL3CR1T3R1A0000007\\\";\\n   256→    const sessionB = \\\"01KJHSTAL3CR1T3R1A0000008\\\";\\n   257→    await createSession(specDir, {\\n   258→      id: sessionA,\\n   259→      agent_type: \\\"ralph\\\",\\n   260→      status: \\\"active\\\",\\n   261→      started_at: \\\"2026-02-20T00:00:00.000Z\\\",\\n   262→    });\\n   263→    await createSession(specDir, {\\n   264→      id: sessionB,\\n   265→      agent_type: \\\"ralph\\\",\\n   266→      status: \\\"active\\\",\\n   267→      started_at: \\\"2026-02-19T00:00:00.000Z\\\",\\n   268→    });\\n   269→\\n   270→    const selection = await selectStaleActiveSessions(\\n   271→      specDir,\\n   272→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n   273→      nowMs,\\n   274→    );\\n   275→    const applied = await applyAutoAbandonMetadata(specDir, selection, {\\n   276→      nowMs,\\n   277→    });\\n   278→\\n   279→    expect(applied.updatedCount).toBe(2);\\n   280→    expect(applied.updates).toHaveLength(2);\\n   281→    expect(applied.updates[0].endedAt).toBe(nowIso);\\n   282→    expect(applied.updates[1].endedAt).toBe(nowIso);\\n   283→    expect(applied.updates[0].closeReason.startsWith(\\\"auto-abandoned:\\\")).toBe(true);\\n   284→    expect(applied.updates[1].closeReason.startsWith(\\\"auto-abandoned:\\\")).toBe(true);\\n   285→\\n   286→    const updatedA = await getSession(specDir, sessionA);\\n   287→    const updatedB = await getSession(specDir, sessionB);\\n   288→    expect(updatedA?.status).toBe(\\\"abandoned\\\");\\n   289→    expect(updatedB?.status).toBe(\\\"abandoned\\\");\\n   290→    expect(updatedA?.ended_at).toBe(nowIso);\\n   291→    expect(updatedB?.ended_at).toBe(nowIso);\\n   292→  });\\n   293→\\n   294→  // AC: @session-stale-close-metadata ac-3\\n   295→  it(\\\"records one shadow commit with command-specific message for multi-session close\\\", async () => {\\n   296→    execSync(\\\"git init\\\", { cwd: specDir, stdio: \\\"pipe\\\" });\\n   297→    execSync('git config user.name \\\"Test User\\\"', { cwd: specDir, stdio: \\\"pipe\\\" });\\n   298→    execSync('git config user.email \\\"test@example.com\\\"', {\\n   299→      cwd: specDir,\\n   300→      stdio: \\\"pipe\\\",\\n   301→    });\\n   302→\\n   303→    const sessionA = \\\"01KJHSTAL3CR1T3R1A000000B\\\";\\n   304→    const sessionB = \\\"01KJHSTAL3CR1T3R1A000000C\\\";\\n   305→    await createSession(specDir, {\\n   306→      id: sessionA,\\n   307→      agent_type: \\\"ralph\\\",\\n   308→      status: \\\"active\\\",\\n   309→      started_at: \\\"2026-02-20T00:00:00.000Z\\\",\\n   310→    });\\n   311→    await createSession(specDir, {\\n   312→      id: sessionB,\\n   313→      agent_type: \\\"ralph\\\",\\n   314→      status: \\\"active\\\",\\n   315→      started_at: \\\"2026-02-19T00:00:00.000Z\\\",\\n   316→    });\\n   317→\\n   318→    execSync(\\\"git add -A\\\", { cwd: specDir, stdio: \\\"pipe\\\" });\\n   319→    execSync('git commit -m \\\"test: seed sessions\\\"', {\\n   320→      cwd: specDir,\\n   321→      stdio: \\\"pipe\\\",\\n   322→      env: { ...process.env, KSPEC_SHADOW_COMMIT: \\\"1\\\" },\\n   323→    });\\n   324→    const beforeCount = Number.parseInt(\\n   325→      execSync(\\\"git rev-list --count HEAD\\\", {\\n   326→        cwd: specDir,\\n   327→        encoding: \\\"utf-8\\\",\\n   328→      }).trim(),\\n   329→      10,\\n   330→    );\\n   331→\\n   332→    const selection = await selectStaleActiveSessions(\\n   333→      specDir,\\n   334→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n   335→      nowMs,\\n   336→    );\\n   337→    const commitMessage = \\\"session stale close auto-abandoned metadata\\\";\\n   338→    const applied = await applyAutoAbandonMetadata(specDir, selection, {\\n   339→      nowMs,\\n   340→      shadowCommitMessage: commitMessage,\\n   341→    });\\n   342→\\n   343→    const afterCount = Number.parseInt(\\n   344→      execSync(\\\"git rev-list --count HEAD\\\", {\\n   345→        cwd: specDir,\\n   346→        encoding: \\\"utf-8\\\",\\n   347→      }).trim(),\\n   348→      10,\\n   349→    );\\n   350→    const lastMessage = execSync(\\\"git log -1 --pretty=%s\\\", {\\n   351→      cwd: specDir,\\n   352→      encoding: \\\"utf-8\\\",\\n   353→    }).trim();\\n   354→\\n   355→    expect(applied.updatedCount).toBe(2);\\n   356→    expect(applied.shadowCommitted).toBe(true);\\n   357→    expect(afterCount - beforeCount).toBe(1);\\n   358→    expect(lastMessage).toBe(commitMessage);\\n   359→  });\\n   360→\\n   361→  // AC: @session-stale-close-metadata ac-4\\n   362→  it(\\\"returns preview close_reason in dry-run mode without changing files\\\", async () => {\\n   363→    const sessionId = \\\"01KJHSTAL3CR1T3R1A0000009\\\";\\n   364→    await createSession(specDir, {\\n   365→      id: sessionId,\\n   366→      agent_type: \\\"ralph\\\",\\n   367→      status: \\\"active\\\",\\n   368→      started_at: \\\"2026-02-20T00:00:00.000Z\\\",\\n   369→    });\\n   370→    await appendEvent(specDir, {\\n   371→      session_id: sessionId,\\n   372→      type: \\\"session.update\\\",\\n   373→      ts: new Date(\\\"2026-02-27T12:00:00.000Z\\\").getTime(),\\n   374→      data: { update: \\\"idle\\\" },\\n   375→    });\\n   376→\\n   377→    const before = await getSession(specDir, sessionId);\\n   378→    const selection = await selectStaleActiveSessions(\\n   379→      specDir,\\n   380→      { olderThan: \\\"24h\\\", inactiveFor: \\\"6h\\\" },\\n   381→      nowMs,\\n   382→    );\\n   383→    const applied = await applyAutoAbandonMetadata(specDir, selection, {\\n   384→      dryRun: true,\\n   385→      nowMs,\\n   386→    });\\n   387→    const after = await getSession(specDir, sessionId);\\n   388→\\n   389→    expect(applied.dryRun).toBe(true);\\n   390→    expect(applied.updatedCount).toBe(1);\\n   391→    expect(applied.updates[0].closeReason.startsWith(\\\"auto-abandoned:\\\")).toBe(true);\\n   392→    expect(applied.updates[0].closeReason).toContain(\\\"older-than=24h\\\");\\n   393→\\n   394→    expect(after?.status).toBe(before?.status);\\n   395→    expect(after?.ended_at).toBe(before?.ended_at);\\n   396→    expect(after?.close_reason).toBe(before?.close_reason);\\n   397→  });\\n   398→});\\n   399→\"}]},\"uuid\":\"7cb0c8dd-109d-4920-8d1e-71b67ba7838a\",\"timestamp\":\"2026-03-09T01:24:06.556Z\",\"sourceToolAssistantUUID\":\"bd97420b-7943-41c3-bbd3-2d8ddfee2231\"}\n{\"parentUuid\":\"7cb0c8dd-109d-4920-8d1e-71b67ba7838a\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"message\":{\"model\":\"claude-opus-4-6\",\"id\":\"msg_01GveQbtjZ32b3YGpux4Sh1z\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01BfsEyjs7k5dj1ULrhYEvhV\",\"name\":\"Read\",\"input\":{\"file_path\":\"/home/chapel/Projects/kynetic-spec/tests/cli/session-checkpoint-scoping.test.ts\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":3,\"cache_creation_input_tokens\":10683,\"cache_read_input_tokens\":19600,\"cache_creation\":{\"ephemeral_5m_input_tokens\":10683,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"}},\"requestId\":\"req_011CYrdf8icQ9jghvmpzG65C\",\"type\":\"assistant\",\"uuid\":\"ead31c25-4efd-42e5-8682-05d717e1b2ab\",\"timestamp\":\"2026-03-09T01:24:07.011Z\"}\n{\"parentUuid\":\"ead31c25-4efd-42e5-8682-05d717e1b2ab\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"type\":\"progress\",\"data\":{\"type\":\"hook_progress\",\"hookEvent\":\"PostToolUse\",\"hookName\":\"PostToolUse:Read\",\"command\":\"callback\"},\"parentToolUseID\":\"toolu_01BfsEyjs7k5dj1ULrhYEvhV\",\"toolUseID\":\"toolu_01BfsEyjs7k5dj1ULrhYEvhV\",\"timestamp\":\"2026-03-09T01:24:07.013Z\",\"uuid\":\"b6f41906-7db1-4821-bf49-be7afd0fe361\"}\n{\"parentUuid\":\"b6f41906-7db1-4821-bf49-be7afd0fe361\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"type\":\"progress\",\"data\":{\"type\":\"hook_progress\",\"hookEvent\":\"PostToolUse\",\"hookName\":\"PostToolUse:Read\",\"command\":\"callback\"},\"parentToolUseID\":\"toolu_01BfsEyjs7k5dj1ULrhYEvhV\",\"toolUseID\":\"toolu_01BfsEyjs7k5dj1ULrhYEvhV\",\"timestamp\":\"2026-03-09T01:24:07.013Z\",\"uuid\":\"9d7fb023-c293-4452-bba8-75c8308dc722\"}\n{\"parentUuid\":\"ead31c25-4efd-42e5-8682-05d717e1b2ab\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01BfsEyjs7k5dj1ULrhYEvhV\",\"type\":\"tool_result\",\"content\":\"     1→/**\\n     2→ * Integration tests for session-scoped checkpoint filtering\\n     3→ * AC: @cmd-session-checkpoint ac-session-scope\\n     4→ * AC: @cmd-session-checkpoint ac-no-session-scope\\n     5→ * AC: @cmd-session-checkpoint ac-session-failsafe\\n     6→ */\\n     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';\\n     8→import * as fs from 'node:fs';\\n     9→import * as path from 'node:path';\\n    10→import {\\n    11→  kspec,\\n    12→  kspecJson,\\n    13→  setupTempFixtures,\\n    14→  cleanupTempDir,\\n    15→  initGitRepo,\\n    16→  git,\\n    17→  testUlids,\\n    18→} from '../helpers/cli';\\n    19→import { createSession, updateSessionStatus } from '../../src/sessions/store';\\n    20→\\n    21→describe('Integration: session-scoped checkpoint filtering', () => {\\n    22→  let tempDir: string;\\n    23→  // Pre-generate unique session IDs for all tests (sequence 0-9)\\n    24→  const sessionIds = testUlids('SES', 10);\\n    25→\\n    26→  beforeEach(async () => {\\n    27→    tempDir = await setupTempFixtures();\\n    28→    initGitRepo(tempDir);\\n    29→    // Commit fixture files so working tree is clean (no uncommitted-changes noise)\\n    30→    git('add -A', tempDir);\\n    31→    git('commit -m \\\"fixtures\\\"', tempDir);\\n    32→  });\\n    33→\\n    34→  afterEach(async () => {\\n    35→    await cleanupTempDir(tempDir);\\n    36→  });\\n    37→\\n    38→  /**\\n    39→   * Helper: start a task with a specific session_id\\n    40→   */\\n    41→  function startTaskWithSession(taskRef: string, sessionId: string): void {\\n    42→    kspec(`task start ${taskRef}`, tempDir, {\\n    43→      env: { KSPEC_SESSION_ID: sessionId },\\n    44→    });\\n    45→  }\\n    46→\\n    47→  /**\\n    48→   * Helper: start a task without a session\\n    49→   */\\n    50→  function startTaskWithoutSession(taskRef: string): void {\\n    51→    const originalEnv = process.env.KSPEC_SESSION_ID;\\n    52→    delete process.env.KSPEC_SESSION_ID;\\n    53→    try {\\n    54→      kspec(`task start ${taskRef}`, tempDir);\\n    55→    } finally {\\n    56→      if (originalEnv !== undefined) {\\n    57→        process.env.KSPEC_SESSION_ID = originalEnv;\\n    58→      }\\n    59→    }\\n    60→  }\\n    61→\\n    62→  /**\\n    63→   * Helper: run checkpoint and parse result.\\n    64→   * Returns null on clean pass (no output), or the parsed JSON block response.\\n    65→   * Checks only task-related issues — ignores uncommitted changes.\\n    66→   */\\n    67→  function runCheckpoint(sessionId?: string): { decision: string; reason: string } | null {\\n    68→    const env: Record<string, string> = {};\\n    69→    if (sessionId) {\\n    70→      env.KSPEC_SESSION_ID = sessionId;\\n    71→    }\\n    72→    const result = kspec('session checkpoint --json', tempDir, {\\n    73→      env,\\n    74→      expectFail: true,\\n    75→    });\\n    76→    // Clean pass: exit 0 with no output (AC3: silent on success)\\n    77→    if (result.exitCode === 0 && result.stdout.trim() === '') {\\n    78→      return null;\\n    79→    }\\n    80→    // Non-zero exit with no stdout is an unexpected error — fail loudly\\n    81→    if (result.stdout.trim() === '') {\\n    82→      throw new Error(`checkpoint exited ${result.exitCode} with no stdout. stderr: ${result.stderr}`);\\n    83→    }\\n    84→    return JSON.parse(result.stdout);\\n    85→  }\\n    86→\\n    87→  /**\\n    88→   * Helper: check if checkpoint reports any in_progress_task issues.\\n    89→   * Ignores uncommitted_changes issues (from session/task file mutations).\\n    90→   */\\n    91→  function hasTaskIssues(sessionId?: string): boolean {\\n    92→    const result = runCheckpoint(sessionId);\\n    93→    if (!result) return false;\\n    94→    return result.reason.includes('is still in progress');\\n    95→  }\\n    96→\\n    97→  // AC: @cmd-session-checkpoint ac-session-scope\\n    98→  describe('ac-session-scope: with KSPEC_SESSION_ID set', () => {\\n    99→    it('should include tasks with matching session_id', async () => {\\n   100→      const mySession = sessionIds[0];\\n   101→      await createSession(tempDir, { id: mySession, agent_type: 'test' });\\n   102→      startTaskWithSession('@test-task-pending', mySession);\\n   103→\\n   104→      expect(hasTaskIssues(mySession)).toBe(true);\\n   105→    });\\n   106→\\n   107→    it('should include tasks with no session_id (unclaimed)', async () => {\\n   108→      const mySession = sessionIds[0];\\n   109→      await createSession(tempDir, { id: mySession, agent_type: 'test' });\\n   110→      startTaskWithoutSession('@test-task-pending');\\n   111→\\n   112→      expect(hasTaskIssues(mySession)).toBe(true);\\n   113→    });\\n   114→\\n   115→    it('should exclude tasks claimed by another active session', async () => {\\n   116→      const mySession = sessionIds[0];\\n   117→      const otherSession = sessionIds[1];\\n   118→      await createSession(tempDir, { id: mySession, agent_type: 'test' });\\n   119→      await createSession(tempDir, { id: otherSession, agent_type: 'test' });\\n   120→      startTaskWithSession('@test-task-pending', otherSession);\\n   121→\\n   122→      expect(hasTaskIssues(mySession)).toBe(false);\\n   123→    });\\n   124→\\n   125→    it('should include tasks from a completed session (orphaned)', async () => {\\n   126→      const mySession = sessionIds[0];\\n   127→      const closedSession = sessionIds[1];\\n   128→      await createSession(tempDir, { id: mySession, agent_type: 'test' });\\n   129→      await createSession(tempDir, { id: closedSession, agent_type: 'test' });\\n   130→      startTaskWithSession('@test-task-pending', closedSession);\\n   131→      await updateSessionStatus(tempDir, closedSession, 'completed');\\n   132→\\n   133→      expect(hasTaskIssues(mySession)).toBe(true);\\n   134→    });\\n   135→  });\\n   136→\\n   137→  // AC: @cmd-session-checkpoint ac-no-session-scope\\n   138→  describe('ac-no-session-scope: without KSPEC_SESSION_ID', () => {\\n   139→    it('should include tasks with no session_id (unclaimed)', () => {\\n   140→      startTaskWithoutSession('@test-task-pending');\\n   141→\\n   142→      expect(hasTaskIssues()).toBe(true);\\n   143→    });\\n   144→\\n   145→    it('should exclude tasks claimed by an active session', async () => {\\n   146→      const otherSession = sessionIds[0];\\n   147→      await createSession(tempDir, { id: otherSession, agent_type: 'test' });\\n   148→      startTaskWithSession('@test-task-pending', otherSession);\\n   149→\\n   150→      expect(hasTaskIssues()).toBe(false);\\n   151→    });\\n   152→\\n   153→    it('should include tasks from a closed session', async () => {\\n   154→      const closedSession = sessionIds[0];\\n   155→      await createSession(tempDir, { id: closedSession, agent_type: 'test' });\\n   156→      startTaskWithSession('@test-task-pending', closedSession);\\n   157→      await updateSessionStatus(tempDir, closedSession, 'abandoned');\\n   158→\\n   159→      expect(hasTaskIssues()).toBe(true);\\n   160→    });\\n   161→  });\\n   162→\\n   163→  // AC: @cmd-session-checkpoint ac-session-failsafe\\n   164→  describe('ac-session-failsafe: unresolvable session_id', () => {\\n   165→    it('should include task when owning session does not exist', () => {\\n   166→      const nonexistentSession = sessionIds[0];\\n   167→      // Start with a session ID that has no metadata on disk\\n   168→      startTaskWithSession('@test-task-pending', nonexistentSession);\\n   169→\\n   170→      expect(hasTaskIssues()).toBe(true);\\n   171→    });\\n   172→\\n   173→    it('should include task when owning session has corrupt metadata', async () => {\\n   174→      const corruptSession = sessionIds[0];\\n   175→      // Create session dir with invalid YAML\\n   176→      const sessDir = path.join(tempDir, 'sessions', corruptSession);\\n   177→      fs.mkdirSync(sessDir, { recursive: true });\\n   178→      fs.writeFileSync(path.join(sessDir, 'session.yaml'), '{{invalid yaml:::');\\n   179→      startTaskWithSession('@test-task-pending', corruptSession);\\n   180→\\n   181→      expect(hasTaskIssues()).toBe(true);\\n   182→    });\\n   183→\\n   184→    it('should include task when owning session does not exist (with active session)', async () => {\\n   185→      const mySession = sessionIds[0];\\n   186→      const nonexistentSession = sessionIds[1];\\n   187→      await createSession(tempDir, { id: mySession, agent_type: 'test' });\\n   188→      // No createSession for nonexistentSession — metadata missing\\n   189→      startTaskWithSession('@test-task-pending', nonexistentSession);\\n   190→\\n   191→      expect(hasTaskIssues(mySession)).toBe(true);\\n   192→    });\\n   193→  });\\n   194→\\n   195→  // AC: @cmd-session-checkpoint ac-session-scope — \\\"scoping applies to associated incomplete todo warnings\\\"\\n   196→  describe('scoping applies to incomplete todos too', () => {\\n   197→    it('should not report todos from tasks excluded by session scoping', async () => {\\n   198→      const mySession = sessionIds[0];\\n   199→      const otherSession = sessionIds[1];\\n   200→      await createSession(tempDir, { id: mySession, agent_type: 'test' });\\n   201→      await createSession(tempDir, { id: otherSession, agent_type: 'test' });\\n   202→      startTaskWithSession('@test-task-pending', otherSession);\\n   203→      kspec('task todo add @test-task-pending \\\"Some todo item\\\"', tempDir);\\n   204→\\n   205→      const result = runCheckpoint(mySession);\\n   206→      // Should not contain any task or todo issues\\n   207→      if (result) {\\n   208→        expect(result.reason).not.toContain('is still in progress');\\n   209→        expect(result.reason).not.toContain('Incomplete todo');\\n   210→      }\\n   211→    });\\n   212→  });\\n   213→});\\n   214→\"}]},\"uuid\":\"6eea6dd9-3ad2-4e76-bce5-7fd9aa8da63a\",\"timestamp\":\"2026-03-09T01:24:07.013Z\",\"sourceToolAssistantUUID\":\"ead31c25-4efd-42e5-8682-05d717e1b2ab\"}\n{\"parentUuid\":\"6eea6dd9-3ad2-4e76-bce5-7fd9aa8da63a\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"message\":{\"model\":\"claude-opus-4-6\",\"id\":\"msg_01GveQbtjZ32b3YGpux4Sh1z\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01RH2JT69uPpxVV7tjjMCZtR\",\"name\":\"Read\",\"input\":{\"file_path\":\"/home/chapel/Projects/kynetic-spec/tests/ralph/session-budget-integration.test.ts\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":3,\"cache_creation_input_tokens\":10683,\"cache_read_input_tokens\":19600,\"cache_creation\":{\"ephemeral_5m_input_tokens\":10683,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"}},\"requestId\":\"req_011CYrdf8icQ9jghvmpzG65C\",\"type\":\"assistant\",\"uuid\":\"65a37f93-ea43-435c-83df-f3c7f3b6075c\",\"timestamp\":\"2026-03-09T01:24:07.450Z\"}\n{\"parentUuid\":\"65a37f93-ea43-435c-83df-f3c7f3b6075c\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"type\":\"progress\",\"data\":{\"type\":\"hook_progress\",\"hookEvent\":\"PostToolUse\",\"hookName\":\"PostToolUse:Read\",\"command\":\"callback\"},\"parentToolUseID\":\"toolu_01RH2JT69uPpxVV7tjjMCZtR\",\"toolUseID\":\"toolu_01RH2JT69uPpxVV7tjjMCZtR\",\"timestamp\":\"2026-03-09T01:24:07.452Z\",\"uuid\":\"b9cbe56b-05e5-4752-94a9-0b81a2f8c81a\"}\n{\"parentUuid\":\"b9cbe56b-05e5-4752-94a9-0b81a2f8c81a\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"type\":\"progress\",\"data\":{\"type\":\"hook_progress\",\"hookEvent\":\"PostToolUse\",\"hookName\":\"PostToolUse:Read\",\"command\":\"callback\"},\"parentToolUseID\":\"toolu_01RH2JT69uPpxVV7tjjMCZtR\",\"toolUseID\":\"toolu_01RH2JT69uPpxVV7tjjMCZtR\",\"timestamp\":\"2026-03-09T01:24:07.452Z\",\"uuid\":\"21b8e03d-cbfe-4f43-94b1-ae6ceaeb963d\"}\n{\"parentUuid\":\"65a37f93-ea43-435c-83df-f3c7f3b6075c\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01RH2JT69uPpxVV7tjjMCZtR\",\"type\":\"tool_result\",\"content\":\"     1→/**\\n     2→ * Behavioral integration tests for session budget integration.\\n     3→ *\\n     4→ * Tests verify that the session budget lifecycle works correctly:\\n     5→ * create session with budget → reset at iteration boundary →\\n     6→ * budget enforcement via task start → cleanup on exit.\\n     7→ *\\n     8→ * AC: @ralph-session-budget-integration ac-create-budget, ac-reset-iteration,\\n     9→ *     ac-env-inject, ac-remove-marker-code\\n    10→ */\\n    11→import { describe, it, expect, beforeEach, afterEach } from \\\"vitest\\\";\\n    12→import * as fs from \\\"node:fs/promises\\\";\\n    13→import * as path from \\\"node:path\\\";\\n    14→import * as os from \\\"node:os\\\";\\n    15→import {\\n    16→  createSessionWithBudget,\\n    17→  resetBudget,\\n    18→  getBudget,\\n    19→  incrementBudget,\\n    20→  getSessionBudgetPath,\\n    21→} from \\\"../../src/sessions/store.js\\\";\\n    22→import { spawnAgent } from \\\"../../src/agents/spawner.js\\\";\\n    23→import {\\n    24→  kspec,\\n    25→  setupTempFixtures,\\n    26→  cleanupTempDir,\\n    27→  testUlid,\\n    28→  FIXTURES_DIR,\\n    29→} from \\\"../helpers/cli\\\";\\n    30→\\n    31→/** Path to the mock ACP agent script */\\n    32→const MOCK_AGENT_PATH = path.join(FIXTURES_DIR, \\\"mock-acp-agent.mjs\\\");\\n    33→\\n    34→// ─── Budget Creation (ac-create-budget) ─────────────────────────────────────\\n    35→\\n    36→describe(\\\"ac-create-budget: session creation with budget\\\", () => {\\n    37→  let specDir: string;\\n    38→\\n    39→  beforeEach(async () => {\\n    40→    specDir = await fs.mkdtemp(path.join(os.tmpdir(), \\\"kspec-ralph-budget-\\\"));\\n    41→  });\\n    42→\\n    43→  afterEach(async () => {\\n    44→    await fs.rm(specDir, { recursive: true });\\n    45→  });\\n    46→\\n    47→  // AC: @ralph-session-budget-integration ac-create-budget\\n    48→  it(\\\"should write budget.json with max_per_cycle=N when budget > 0\\\", async () => {\\n    49→    const sessionId = testUlid(\\\"RBUDG\\\", 1);\\n    50→    const result = await createSessionWithBudget(specDir, {\\n    51→      id: sessionId,\\n    52→      agent_type: \\\"claude-code\\\",\\n    53→      budget: 3,\\n    54→    });\\n    55→\\n    56→    expect(result.budget).not.toBeNull();\\n    57→    expect(result.budget!.max_per_cycle).toBe(3);\\n    58→    expect(result.budget!.started_this_cycle).toBe(0);\\n    59→\\n    60→    // Verify file on disk\\n    61→    const budgetPath = getSessionBudgetPath(specDir, sessionId);\\n    62→    const content = await fs.readFile(budgetPath, \\\"utf-8\\\");\\n    63→    const parsed = JSON.parse(content);\\n    64→    expect(parsed.max_per_cycle).toBe(3);\\n    65→    expect(parsed.started_this_cycle).toBe(0);\\n    66→  });\\n    67→\\n    68→  // AC: @ralph-session-budget-integration ac-create-budget\\n    69→  it(\\\"should NOT write budget.json when budget is 0 (unlimited)\\\", async () => {\\n    70→    const sessionId = testUlid(\\\"RBUDG\\\", 2);\\n    71→    const result = await createSessionWithBudget(specDir, {\\n    72→      id: sessionId,\\n    73→      agent_type: \\\"claude-code\\\",\\n    74→      budget: 0,\\n    75→    });\\n    76→\\n    77→    expect(result.budget).toBeNull();\\n    78→\\n    79→    // budget.json should not exist\\n    80→    const budgetPath = getSessionBudgetPath(specDir, sessionId);\\n    81→    await expect(fs.access(budgetPath)).rejects.toThrow();\\n    82→  });\\n    83→\\n    84→  // AC: @ralph-session-budget-integration ac-create-budget\\n    85→  it(\\\"should create budget with max_per_cycle matching --max-tasks value\\\", async () => {\\n    86→    for (const maxTasks of [1, 5, 10]) {\\n    87→      const sessionId = testUlid(\\\"RBUDG\\\", maxTasks + 10);\\n    88→      const result = await createSessionWithBudget(specDir, {\\n    89→        id: sessionId,\\n    90→        agent_type: \\\"claude-code\\\",\\n    91→        budget: maxTasks,\\n    92→      });\\n    93→\\n    94→      expect(result.budget!.max_per_cycle).toBe(maxTasks);\\n    95→    }\\n    96→  });\\n    97→});\\n    98→\\n    99→// ─── Budget Reset (ac-reset-iteration) ──────────────────────────────────────\\n   100→\\n   101→describe(\\\"ac-reset-iteration: budget reset at iteration boundary\\\", () => {\\n   102→  let specDir: string;\\n   103→  let sessionId: string;\\n   104→\\n   105→  beforeEach(async () => {\\n   106→    specDir = await fs.mkdtemp(path.join(os.tmpdir(), \\\"kspec-ralph-reset-\\\"));\\n   107→    sessionId = testUlid(\\\"RRESET\\\", 1);\\n   108→    await createSessionWithBudget(specDir, {\\n   109→      id: sessionId,\\n   110→      agent_type: \\\"claude-code\\\",\\n   111→      budget: 2,\\n   112→    });\\n   113→  });\\n   114→\\n   115→  afterEach(async () => {\\n   116→    await fs.rm(specDir, { recursive: true });\\n   117→  });\\n   118→\\n   119→  // AC: @ralph-session-budget-integration ac-reset-iteration\\n   120→  it(\\\"should reset started_this_cycle to 0 after tasks were started\\\", async () => {\\n   121→    // Simulate agent starting tasks during an iteration\\n   122→    await incrementBudget(specDir, sessionId);\\n   123→    await incrementBudget(specDir, sessionId);\\n   124→\\n   125→    let budget = await getBudget(specDir, sessionId);\\n   126→    expect(budget!.started_this_cycle).toBe(2);\\n   127→\\n   128→    // Simulate calling resetBudget at iteration boundary\\n   129→    await resetBudget(specDir, sessionId);\\n   130→\\n   131→    budget = await getBudget(specDir, sessionId);\\n   132→    expect(budget!.started_this_cycle).toBe(0);\\n   133→    expect(budget!.max_per_cycle).toBe(2); // max unchanged\\n   134→  });\\n   135→\\n   136→  // AC: @ralph-session-budget-integration ac-reset-iteration\\n   137→  it(\\\"should no-op when no budget exists (maxTasks=0)\\\", async () => {\\n   138→    const noBudgetSessionId = testUlid(\\\"RRESET\\\", 2);\\n   139→    await createSessionWithBudget(specDir, {\\n   140→      id: noBudgetSessionId,\\n   141→      agent_type: \\\"claude-code\\\",\\n   142→      budget: 0,\\n   143→    });\\n   144→\\n   145→    // resetBudget should return null (no budget to reset)\\n   146→    const result = await resetBudget(specDir, noBudgetSessionId);\\n   147→    expect(result).toBeNull();\\n   148→  });\\n   149→});\\n   150→\\n   151→// ─── Env Injection — Consumer Side (ac-env-inject) ──────────────────────────\\n   152→\\n   153→describe(\\\"ac-env-inject: KSPEC_SESSION_ID budget enforcement via task start\\\", () => {\\n   154→  let tempDir: string;\\n   155→\\n   156→  beforeEach(async () => {\\n   157→    tempDir = await setupTempFixtures();\\n   158→  });\\n   159→\\n   160→  afterEach(async () => {\\n   161→    await cleanupTempDir(tempDir);\\n   162→  });\\n   163→\\n   164→  // AC: @ralph-session-budget-integration ac-env-inject\\n   165→  it(\\\"should enforce budget when KSPEC_SESSION_ID is set and budget exhausted\\\", async () => {\\n   166→    // Create a session with budget in the fixtures dir (tempDir IS specDir)\\n   167→    const sessionId = testUlid(\\\"RENV\\\", 1);\\n   168→    await createSessionWithBudget(tempDir, {\\n   169→      id: sessionId,\\n   170→      agent_type: \\\"claude-code\\\",\\n   171→      budget: 1,\\n   172→    });\\n   173→\\n   174→    // Exhaust the budget\\n   175→    await incrementBudget(tempDir, sessionId);\\n   176→\\n   177→    // Now task start should be blocked when KSPEC_SESSION_ID is set\\n   178→    const result = kspec(\\\"task start @test-task-pending\\\", tempDir, {\\n   179→      expectFail: true,\\n   180→      env: { KSPEC_SESSION_ID: sessionId },\\n   181→    });\\n   182→\\n   183→    expect(result.exitCode).toBe(4); // VALIDATION_FAILED\\n   184→    expect(result.stderr).toContain(\\\"budget\\\");\\n   185→  });\\n   186→\\n   187→  // AC: @ralph-session-budget-integration ac-env-inject\\n   188→  it(\\\"should allow task start when KSPEC_SESSION_ID is set and budget available\\\", async () => {\\n   189→    const sessionId = testUlid(\\\"RENV\\\", 2);\\n   190→    await createSessionWithBudget(tempDir, {\\n   191→      id: sessionId,\\n   192→      agent_type: \\\"claude-code\\\",\\n   193→      budget: 5,\\n   194→    });\\n   195→\\n   196→    // Budget not exhausted — task start should succeed\\n   197→    const result = kspec(\\\"task start @test-task-pending\\\", tempDir, {\\n   198→      env: { KSPEC_SESSION_ID: sessionId },\\n   199→    });\\n   200→\\n   201→    expect(result.exitCode).toBe(0);\\n   202→  });\\n   203→\\n   204→  // AC: @ralph-session-budget-integration ac-env-inject\\n   205→  it(\\\"should not enforce budget when KSPEC_SESSION_ID is not set\\\", async () => {\\n   206→    // No session ID → no budget check → task start should succeed\\n   207→    const result = kspec(\\\"task start @test-task-pending\\\", tempDir);\\n   208→    expect(result.exitCode).toBe(0);\\n   209→  });\\n   210→});\\n   211→\\n   212→// ─── Env Injection — Producer Side (ac-env-inject) ──────────────────────────\\n   213→\\n   214→describe(\\\"ac-env-inject: spawnAgent passes KSPEC_SESSION_ID to child process\\\", () => {\\n   215→  let tempDir: string;\\n   216→  let envFile: string;\\n   217→\\n   218→  beforeEach(async () => {\\n   219→    tempDir = await fs.mkdtemp(path.join(os.tmpdir(), \\\"kspec-ralph-spawn-\\\"));\\n   220→    envFile = path.join(tempDir, \\\"agent-env.json\\\");\\n   221→  });\\n   222→\\n   223→  afterEach(async () => {\\n   224→    await fs.rm(tempDir, { recursive: true });\\n   225→  });\\n   226→\\n   227→  // AC: @ralph-session-budget-integration ac-env-inject\\n   228→  it(\\\"should pass KSPEC_SESSION_ID to spawned agent via env\\\", async () => {\\n   229→    const sessionId = testUlid(\\\"RSPAWN\\\", 1);\\n   230→\\n   231→    // Spawn mock agent with the same env pattern the agent runtime uses\\n   232→    const agent = spawnAgent(\\n   233→      { command: \\\"node\\\", args: [MOCK_AGENT_PATH], description: \\\"mock\\\" },\\n   234→      {\\n   235→        cwd: tempDir,\\n   236→        env: {\\n   237→          KSPEC_SESSION_ID: sessionId,\\n   238→          MOCK_ACP_ENV_FILE: envFile,\\n   239→        },\\n   240→      },\\n   241→    );\\n   242→\\n   243→    try {\\n   244→      // Initialize to prove the agent is alive and responding\\n   245→      await agent.client.initialize();\\n   246→\\n   247→      // Mock agent writes env to file on startup — verify it received the session ID\\n   248→      const envData = JSON.parse(await fs.readFile(envFile, \\\"utf-8\\\"));\\n   249→      expect(envData.KSPEC_SESSION_ID).toBe(sessionId);\\n   250→    } finally {\\n   251→      agent.kill();\\n   252→    }\\n   253→  });\\n   254→\\n   255→  // AC: @ralph-session-budget-integration ac-env-inject\\n   256→  it(\\\"should not leak KSPEC_SESSION_ID when env is not provided\\\", async () => {\\n   257→    // Ensure KSPEC_SESSION_ID is NOT in the current process env for this test\\n   258→    const originalValue = process.env.KSPEC_SESSION_ID;\\n   259→    delete process.env.KSPEC_SESSION_ID;\\n   260→\\n   261→    try {\\n   262→      const agent = spawnAgent(\\n   263→        { command: \\\"node\\\", args: [MOCK_AGENT_PATH], description: \\\"mock\\\" },\\n   264→        {\\n   265→          cwd: tempDir,\\n   266→          env: { MOCK_ACP_ENV_FILE: envFile },\\n   267→        },\\n   268→      );\\n   269→\\n   270→      try {\\n   271→        await agent.client.initialize();\\n   272→        const envData = JSON.parse(await fs.readFile(envFile, \\\"utf-8\\\"));\\n   273→        expect(envData.KSPEC_SESSION_ID).toBeNull();\\n   274→      } finally {\\n   275→        agent.kill();\\n   276→      }\\n   277→    } finally {\\n   278→      // Restore original value\\n   279→      if (originalValue !== undefined) {\\n   280→        process.env.KSPEC_SESSION_ID = originalValue;\\n   281→      }\\n   282→    }\\n   283→  });\\n   284→});\\n   285→\"}]},\"uuid\":\"919c3344-439a-47c2-97ae-ef11891341e6\",\"timestamp\":\"2026-03-09T01:24:07.452Z\",\"sourceToolAssistantUUID\":\"65a37f93-ea43-435c-83df-f3c7f3b6075c\"}\n{\"parentUuid\":\"919c3344-439a-47c2-97ae-ef11891341e6\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"message\":{\"model\":\"claude-opus-4-6\",\"id\":\"msg_01GveQbtjZ32b3YGpux4Sh1z\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_0178PtvXbBy22sscV12rTqc5\",\"name\":\"Read\",\"input\":{\"file_path\":\"/home/chapel/Projects/kynetic-spec/tests/agent-invocation-lifecycle.test.ts\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":3,\"cache_creation_input_tokens\":10683,\"cache_read_input_tokens\":19600,\"cache_creation\":{\"ephemeral_5m_input_tokens\":10683,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"}},\"requestId\":\"req_011CYrdf8icQ9jghvmpzG65C\",\"type\":\"assistant\",\"uuid\":\"ac39ba60-0750-482c-9bc3-aed662d41ba2\",\"timestamp\":\"2026-03-09T01:24:07.563Z\"}\n{\"parentUuid\":\"ac39ba60-0750-482c-9bc3-aed662d41ba2\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"type\":\"progress\",\"data\":{\"type\":\"hook_progress\",\"hookEvent\":\"PostToolUse\",\"hookName\":\"PostToolUse:Read\",\"command\":\"callback\"},\"parentToolUseID\":\"toolu_0178PtvXbBy22sscV12rTqc5\",\"toolUseID\":\"toolu_0178PtvXbBy22sscV12rTqc5\",\"timestamp\":\"2026-03-09T01:24:07.756Z\",\"uuid\":\"db75e7e8-47b1-4d8c-b248-34a4101b2f7a\"}\n{\"parentUuid\":\"db75e7e8-47b1-4d8c-b248-34a4101b2f7a\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"type\":\"progress\",\"data\":{\"type\":\"hook_progress\",\"hookEvent\":\"PostToolUse\",\"hookName\":\"PostToolUse:Read\",\"command\":\"callback\"},\"parentToolUseID\":\"toolu_0178PtvXbBy22sscV12rTqc5\",\"toolUseID\":\"toolu_0178PtvXbBy22sscV12rTqc5\",\"timestamp\":\"2026-03-09T01:24:07.756Z\",\"uuid\":\"c48fd7c5-e9a3-4cba-a91e-e5a00ff263d9\"}\n{\"parentUuid\":\"ac39ba60-0750-482c-9bc3-aed662d41ba2\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a9e9b31\",\"slug\":\"stateful-singing-dongarra\",\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_0178PtvXbBy22sscV12rTqc5\",\"type\":\"tool_result\",\"content\":\"     1→/**\\n     2→ * Agent Invocation Lifecycle tests.\\n     3→ *\\n     4→ * Tests for per-invocation session creation, ACP agent spawn, prompt delivery,\\n     5→ * event logging, timeout handling, and structured completion tracking.\\n     6→ *\\n     7→ * Task: @implement-agent-invocation-lifecycle\\n     8→ * Spec: @agent-invocation-lifecycle\\n     9→ */\\n    10→\\n    11→import { describe, it, expect, beforeEach, afterEach, vi } from \\\"vitest\\\";\\n    12→import * as fs from \\\"node:fs/promises\\\";\\n    13→import * as fsSync from \\\"node:fs\\\";\\n    14→import * as path from \\\"node:path\\\";\\n    15→import * as os from \\\"node:os\\\";\\n    16→import { EventEmitter } from \\\"node:events\\\";\\n    17→import * as YAML from \\\"yaml\\\";\\n    18→import {\\n    19→  createSession,\\n    20→  appendEvent,\\n    21→  getSession,\\n    22→  closeSession,\\n    23→  injectEnvForAdapter,\\n    24→  removeEnvForAdapter,\\n    25→  isSessionBlobPointer,\\n    26→} from \\\"../src/sessions/store.js\\\";\\n    27→import * as storeModule from \\\"../src/sessions/store.js\\\";\\n    28→import { runInvocation, InvocationTimeoutError } from \\\"../src/agent-runtime/invocation.js\\\";\\n    29→import { resolveSkills, buildPromptWithSkills } from \\\"../src/agent-runtime/prompts.js\\\";\\n    30→import { registerAdapter } from \\\"../src/agents/adapters.js\\\";\\n    31→import * as spawnerModule from \\\"../src/agents/spawner.js\\\";\\n    32→import { SANITIZED_ENV_VARS } from \\\"../src/agents/spawner.js\\\";\\n    33→import { ACPClient } from \\\"../src/acp/index.js\\\";\\n    34→import type { Agent } from \\\"../src/schema/meta.js\\\";\\n    35→import * as shadowModule from \\\"../src/parser/shadow.js\\\";\\n    36→import {\\n    37→  testUlid,\\n    38→  createTempDir,\\n    39→  cleanupTempDir,\\n    40→} from \\\"./helpers/cli.js\\\";\\n    41→\\n    42→// ─── Fixtures ─────────────────────────────────────────────────────────────────\\n    43→\\n    44→const MOCK_ACP = path.join(__dirname, \\\"mocks\\\", \\\"acp-mock.js\\\");\\n    45→const MOCK_KSPEC_CLI = path.join(__dirname, \\\"mocks\\\", \\\"kspec-capture-mock.cjs\\\");\\n    46→\\n    47→/**\\n    48→ * Create a minimal Agent definition for testing.\\n    49→ */\\n    50→function makeTestAgent(overrides: Partial<Agent> = {}): Agent {\\n    51→  return {\\n    52→    _ulid: testUlid(\\\"AGNT\\\"),\\n    53→    id: \\\"test-worker\\\",\\n    54→    name: \\\"Test Worker Agent\\\",\\n    55→    capabilities: [],\\n    56→    tools: [],\\n    57→    conventions: [],\\n    58→    dispatch: [],\\n    59→    skills: [],\\n    60→    auto_approve: false,\\n    61→    concurrency: { max_concurrent: 1 },\\n    62→    adapter: \\\"mock-acp\\\",\\n    63→    ...overrides,\\n    64→  };\\n    65→}\\n    66→\\n    67→/**\\n    68→ * Register the mock ACP adapter for testing.\\n    69→ */\\n    70→function registerMockAdapter(env: Record<string, string> = {}): void {\\n    71→  registerAdapter(\\\"mock-acp\\\", {\\n    72→    command: \\\"node\\\",\\n    73→    args: [MOCK_ACP],\\n    74→    env: {\\n    75→      MOCK_ACP_PROJECT_DIR: process.cwd(),\\n    76→      ...env,\\n    77→    },\\n    78→    description: \\\"Mock ACP agent for testing\\\",\\n    79→  });\\n    80→}\\n    81→\\n    82→// ─── AC-1: Session creation with trigger, agent_id, task_id ──────────────────\\n    83→\\n    84→// AC: @agent-invocation-lifecycle ac-1\\n    85→describe(\\\"Session creation on invocation start\\\", () => {\\n    86→  let testDir: string;\\n    87→\\n    88→  beforeEach(async () => {\\n    89→    testDir = await createTempDir(\\\"kspec-invoc-ac1-\\\");\\n    90→    registerMockAdapter();\\n    91→  });\\n    92→\\n    93→  afterEach(async () => {\\n    94→    await cleanupTempDir(testDir);\\n    95→  });\\n    96→\\n    97→  it(\\\"should create session with trigger, agent_id, and task_id populated\\\", async () => {\\n    98→    const agent = makeTestAgent({ id: \\\"worker-agent\\\" });\\n    99→    const taskRef = \\\"@\\\" + testUlid(\\\"TASK\\\");\\n   100→\\n   101→    // Run a quick invocation (mock agent completes immediately)\\n   102→    const result = await runInvocation({\\n   103→      agent,\\n   104→      specDir: testDir,\\n   105→      cwd: process.cwd(),\\n   106→      taskRef,\\n   107→      prompt: \\\"Test session creation\\\",\\n   108→      trigger: \\\"task.ready\\\",\\n   109→    });\\n   110→\\n   111→    expect(result.session).toBeDefined();\\n   112→    expect(result.session.trigger).toBe(\\\"task.ready\\\");\\n   113→    expect(result.session.agent_id).toBe(\\\"worker-agent\\\");\\n   114→    expect(result.session.task_id).toBe(taskRef);\\n   115→    expect(result.session.agent_type).toBe(\\\"mock-acp\\\");\\n   116→  });\\n   117→\\n   118→  it(\\\"should create session directory with session.yaml\\\", async () => {\\n   119→    const agent = makeTestAgent();\\n   120→    const taskRef = \\\"@\\\" + testUlid(\\\"TASK\\\", 1);\\n   121→\\n   122→    const result = await runInvocation({\\n   123→      agent,\\n   124→      specDir: testDir,\\n   125→      cwd: process.cwd(),\\n   126→      taskRef,\\n   127→      prompt: \\\"Check session file creation\\\",\\n   128→      trigger: \\\"task.needs_work\\\",\\n   129→    });\\n   130→\\n   131→    const sessionDir = path.join(testDir, \\\"sessions\\\", result.session.id);\\n   132→    const sessionYaml = path.join(sessionDir, \\\"session.yaml\\\");\\n   133→\\n   134→    await expect(fs.access(sessionYaml)).resolves.toBeUndefined();\\n   135→    const content = await fs.readFile(sessionYaml, \\\"utf-8\\\");\\n   136→    const parsed = YAML.parse(content);\\n   137→    expect(parsed.trigger).toBe(\\\"task.needs_work\\\");\\n   138→    expect(parsed.task_id).toBe(taskRef);\\n   139→  });\\n   140→});\\n   141→\\n   142→// ─── AC-2: KSPEC_SESSION_ID injection ────────────────────────────────────────\\n   143→\\n   144→// AC: @agent-invocation-lifecycle ac-2\\n   145→describe(\\\"KSPEC_SESSION_ID injection\\\", () => {\\n   146→  let testDir: string;\\n   147→  let capturedSessionId: string | undefined;\\n   148→\\n   149→  beforeEach(async () => {\\n   150→    testDir = await createTempDir(\\\"kspec-invoc-ac2-\\\");\\n   151→    capturedSessionId = undefined;\\n   152→\\n   153→    // Register a mock adapter that captures the env var\\n   154→    // The mock ACP agent receives KSPEC_SESSION_ID through process env\\n   155→    registerMockAdapter();\\n   156→  });\\n   157→\\n   158→  afterEach(async () => {\\n   159→    // Restore process.env.KSPEC_SESSION_ID if it was set\\n   160→    delete process.env.KSPEC_SESSION_ID;\\n   161→    await cleanupTempDir(testDir);\\n   162→  });\\n   163→\\n   164→  it(\\\"should set KSPEC_SESSION_ID in process env during invocation\\\", async () => {\\n   165→    const agent = makeTestAgent();\\n   166→    let envDuringInvocation: string | undefined;\\n   167→\\n   168→    // We can't easily intercept the spawned process env, but we can verify\\n   169→    // that KSPEC_SESSION_ID was set and cleared on the invoking process\\n   170→    // by checking that it was cleaned up after\\n   171→    const beforeSessionId = process.env.KSPEC_SESSION_ID;\\n   172→\\n   173→    const result = await runInvocation({\\n   174→      agent,\\n   175→      specDir: testDir,\\n   176→      cwd: process.cwd(),\\n   177→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   178→      prompt: \\\"Check env injection\\\",\\n   179→      trigger: \\\"task.ready\\\",\\n   180→    });\\n   181→\\n   182→    // After invocation, KSPEC_SESSION_ID should be restored (or deleted)\\n   183→    const afterSessionId = process.env.KSPEC_SESSION_ID;\\n   184→    expect(afterSessionId).toBe(beforeSessionId);\\n   185→    expect(result.outcome).toBe(\\\"success\\\");\\n   186→  });\\n   187→\\n   188→  it(\\\"should restore a pre-existing KSPEC_SESSION_ID after invocation completes\\\", async () => {\\n   189→    const agent = makeTestAgent();\\n   190→    const preExistingId = \\\"01EXISTNG0000000000000000\\\";\\n   191→\\n   192→    // Simulate a pre-existing KSPEC_SESSION_ID\\n   193→    process.env.KSPEC_SESSION_ID = preExistingId;\\n   194→\\n   195→    await runInvocation({\\n   196→      agent,\\n   197→      specDir: testDir,\\n   198→      cwd: process.cwd(),\\n   199→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   200→      prompt: \\\"Check env cleanup\\\",\\n   201→      trigger: \\\"task.ready\\\",\\n   202→    });\\n   203→\\n   204→    // After invocation, env should be restored to the pre-existing value,\\n   205→    // not deleted or overwritten with the invocation session id.\\n   206→    expect(process.env.KSPEC_SESSION_ID).toBe(preExistingId);\\n   207→\\n   208→    // Clean up for subsequent tests\\n   209→    delete process.env.KSPEC_SESSION_ID;\\n   210→  });\\n   211→});\\n   212→\\n   213→// ─── AC-3: Timeout handling ───────────────────────────────────────────────────\\n   214→\\n   215→// AC: @agent-invocation-lifecycle ac-3\\n   216→describe(\\\"Timeout handling\\\", () => {\\n   217→  let testDir: string;\\n   218→\\n   219→  beforeEach(async () => {\\n   220→    testDir = await createTempDir(\\\"kspec-invoc-ac3-\\\");\\n   221→\\n   222→    // Register a slow adapter that delays response\\n   223→    registerAdapter(\\\"slow-mock-acp\\\", {\\n   224→      command: \\\"node\\\",\\n   225→      args: [MOCK_ACP],\\n   226→      env: {\\n   227→        MOCK_ACP_DELAY_MS: \\\"5000\\\", // 5 second delay\\n   228→      },\\n   229→      description: \\\"Slow mock ACP agent for timeout tests\\\",\\n   230→    });\\n   231→  });\\n   232→\\n   233→  afterEach(async () => {\\n   234→    await cleanupTempDir(testDir);\\n   235→  });\\n   236→\\n   237→  it(\\\"should close session as timed_out when timeout is reached\\\", async () => {\\n   238→    const agent = makeTestAgent({ adapter: \\\"slow-mock-acp\\\" });\\n   239→\\n   240→    const result = await runInvocation({\\n   241→      agent,\\n   242→      specDir: testDir,\\n   243→      cwd: process.cwd(),\\n   244→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   245→      prompt: \\\"Test timeout\\\",\\n   246→      trigger: \\\"task.ready\\\",\\n   247→      timeoutMinutes: 0.001, // ~60ms timeout — much less than 5s delay\\n   248→    });\\n   249→\\n   250→    expect(result.outcome).toBe(\\\"timed_out\\\");\\n   251→    expect(result.session.status).toBe(\\\"timed_out\\\");\\n   252→  });\\n   253→\\n   254→  it(\\\"should log agent.timeout event when timeout occurs\\\", async () => {\\n   255→    const agent = makeTestAgent({ adapter: \\\"slow-mock-acp\\\" });\\n   256→\\n   257→    const result = await runInvocation({\\n   258→      agent,\\n   259→      specDir: testDir,\\n   260→      cwd: process.cwd(),\\n   261→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   262→      prompt: \\\"Test timeout event logging\\\",\\n   263→      trigger: \\\"task.ready\\\",\\n   264→      timeoutMinutes: 0.001,\\n   265→    });\\n   266→\\n   267→    // Read the events.jsonl\\n   268→    const eventsPath = path.join(testDir, \\\"sessions\\\", result.session.id, \\\"events.jsonl\\\");\\n   269→    const content = await fs.readFile(eventsPath, \\\"utf-8\\\");\\n   270→    const events = content.trim().split(\\\"\\\\n\\\").filter(Boolean).map((l) => JSON.parse(l));\\n   271→\\n   272→    const timeoutEvent = events.find((e: { type: string }) => e.type === \\\"agent.timeout\\\");\\n   273→    expect(timeoutEvent).toBeDefined();\\n   274→    expect(timeoutEvent.data.task_id).toBeDefined();\\n   275→    expect(timeoutEvent.data.timeout_minutes).toBeDefined();\\n   276→  });\\n   277→\\n   278→  it(\\\"should add a timeout note to the task when timeout occurs\\\", async () => {\\n   279→    // AC: @agent-invocation-lifecycle ac-3 — timeout note written to task\\n   280→    const agent = makeTestAgent({ adapter: \\\"slow-mock-acp\\\" });\\n   281→    const captureFile = path.join(testDir, \\\"kspec-calls.json\\\");\\n   282→    const taskRef = \\\"@\\\" + testUlid(\\\"TASK\\\");\\n   283→\\n   284→    // Set capture env so runKspecCli's spawnSync inherits it\\n   285→    process.env.KSPEC_CAPTURE_FILE = captureFile;\\n   286→    try {\\n   287→      await runInvocation({\\n   288→        agent,\\n   289→        specDir: testDir,\\n   290→        cwd: process.cwd(),\\n   291→        taskRef,\\n   292→        prompt: \\\"Test timeout note\\\",\\n   293→        trigger: \\\"task.ready\\\",\\n   294→        timeoutMinutes: 0.001,\\n   295→        kspecCliPath: MOCK_KSPEC_CLI,\\n   296→      });\\n   297→    } finally {\\n   298→      delete process.env.KSPEC_CAPTURE_FILE;\\n   299→    }\\n   300→\\n   301→    // Verify that kspec task note was called with the task ref and AGENT-TIMEOUT marker\\n   302→    const calls = JSON.parse(fsSync.readFileSync(captureFile, \\\"utf-8\\\")) as Array<{ args: string[] }>;\\n   303→    const noteCall = calls.find((c) =>\\n   304→      c.args.includes(\\\"task\\\") && c.args.includes(\\\"note\\\") && c.args.includes(taskRef)\\n   305→    );\\n   306→    expect(noteCall).toBeDefined();\\n   307→    const noteText = noteCall!.args[noteCall!.args.indexOf(taskRef) + 1] ?? \\\"\\\";\\n   308→    expect(noteText).toContain(\\\"[AGENT-TIMEOUT]\\\");\\n   309→  });\\n   310→\\n   311→  it(\\\"should dispatch ACP cancel request on timeout\\\", async () => {\\n   312→    // AC: @agent-invocation-lifecycle ac-3 — ACP cancel request dispatched on timeout\\n   313→    // Use a closure to track cancel calls — vi.spyOn prototype mocks don't reliably\\n   314→    // track ESM cross-module calls in spy.mock.calls.\\n   315→    let cancelCalledWith: string | undefined;\\n   316→    const cancelSpy = vi.spyOn(ACPClient.prototype, \\\"cancel\\\").mockImplementation(async (sessionId) => {\\n   317→      cancelCalledWith = sessionId;\\n   318→    });\\n   319→\\n   320→    const agent = makeTestAgent({ adapter: \\\"slow-mock-acp\\\" });\\n   321→    try {\\n   322→      await runInvocation({\\n   323→        agent,\\n   324→        specDir: testDir,\\n   325→        cwd: process.cwd(),\\n   326→        taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   327→        prompt: \\\"Test cancel dispatch\\\",\\n   328→        trigger: \\\"task.ready\\\",\\n   329→        // Use a longer timeout so the agent has time to spawn + initialize + newSession\\n   330→        // (the slow mock delays 5000ms only in session/prompt, not session/new)\\n   331→        // 3 seconds → enough for spawn+init+newSession but well under the 5s prompt delay\\n   332→        timeoutMinutes: 3 / 60,\\n   333→      });\\n   334→    } finally {\\n   335→      cancelSpy.mockRestore();\\n   336→    }\\n   337→\\n   338→    // Verify cancel was called with the ACP session ID — cancel request dispatched on timeout\\n   339→    expect(cancelCalledWith).toBeDefined();\\n   340→  });\\n   341→\\n   342→  it(\\\"should set ACP session/prompt timeout above invocation timeout budget\\\", async () => {\\n   343→    const agent = makeTestAgent({ adapter: \\\"slow-mock-acp\\\" });\\n   344→    const mockSessionId = \\\"mock-acp-session\\\";\\n   345→    const emitter = new EventEmitter();\\n   346→    const timeoutMinutes = 12;\\n   347→\\n   348→    const spawnedAgent = {\\n   349→      client: {\\n   350→        on: (event: string, handler: (...args: unknown[]) => void) => {\\n   351→          emitter.on(event, handler);\\n   352→        },\\n   353→        newSession: vi.fn(async () => mockSessionId),\\n   354→        prompt: vi.fn(async () => ({ stopReason: \\\"end_turn\\\" })),\\n   355→        cancel: vi.fn(async () => undefined),\\n   356→        endSession: vi.fn(async () => undefined),\\n   357→        respondPermission: vi.fn(async () => undefined),\\n   358→      },\\n   359→      kill: vi.fn(() => undefined),\\n   360→    };\\n   361→\\n   362→    const spawnSpy = vi.spyOn(spawnerModule, \\\"spawnAndInitialize\\\").mockResolvedValue(\\n   363→      spawnedAgent as unknown as Awaited<ReturnType<typeof spawnerModule.spawnAndInitialize>>,\\n   364→    );\\n   365→    let spawnOptions: Parameters<typeof spawnerModule.spawnAndInitialize>[1] | undefined;\\n   366→\\n   367→    try {\\n   368→      await runInvocation({\\n   369→        agent,\\n   370→        specDir: testDir,\\n   371→        cwd: process.cwd(),\\n   372→        taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   373→        prompt: \\\"Test ACP prompt timeout alignment\\\",\\n   374→        trigger: \\\"task.ready\\\",\\n   375→        timeoutMinutes,\\n   376→      });\\n   377→      spawnOptions = spawnSpy.mock.calls[0]?.[1];\\n   378→    } finally {\\n   379→      spawnSpy.mockRestore();\\n   380→    }\\n   381→\\n   382→    expect(spawnOptions).toBeDefined();\\n   383→    expect(spawnOptions.clientOptions?.methodTimeouts?.[\\\"session/prompt\\\"]).toBe(\\n   384→      timeoutMinutes * 60 * 1000 + 5_000,\\n   385→    );\\n   386→  });\\n   387→});\\n   388→\\n   389→// ─── AC-4: Successful completion ─────────────────────────────────────────────\\n   390→\\n   391→// AC: @agent-invocation-lifecycle ac-4\\n   392→describe(\\\"Successful invocation completion\\\", () => {\\n   393→  let testDir: string;\\n   394→\\n   395→  beforeEach(async () => {\\n   396→    testDir = await createTempDir(\\\"kspec-invoc-ac4-\\\");\\n   397→    registerMockAdapter();\\n   398→  });\\n   399→\\n   400→  afterEach(async () => {\\n   401→    await cleanupTempDir(testDir);\\n   402→  });\\n   403→\\n   404→  it(\\\"should log agent.completed event with task_id, outcome, and duration_ms\\\", async () => {\\n   405→    const agent = makeTestAgent();\\n   406→    const taskRef = \\\"@\\\" + testUlid(\\\"TASK\\\");\\n   407→\\n   408→    const result = await runInvocation({\\n   409→      agent,\\n   410→      specDir: testDir,\\n   411→      cwd: process.cwd(),\\n   412→      taskRef,\\n   413→      prompt: \\\"Successful completion test\\\",\\n   414→      trigger: \\\"task.ready\\\",\\n   415→    });\\n   416→\\n   417→    expect(result.outcome).toBe(\\\"success\\\");\\n   418→\\n   419→    const eventsPath = path.join(testDir, \\\"sessions\\\", result.session.id, \\\"events.jsonl\\\");\\n   420→    const content = await fs.readFile(eventsPath, \\\"utf-8\\\");\\n   421→    const events = content.trim().split(\\\"\\\\n\\\").filter(Boolean).map((l) => JSON.parse(l));\\n   422→\\n   423→    const completedEvent = events.find((e: { type: string }) => e.type === \\\"agent.completed\\\");\\n   424→    expect(completedEvent).toBeDefined();\\n   425→    // AC: @agent-invocation-lifecycle ac-4 — structured outcome data\\n   426→    expect(completedEvent.data.task_id).toBe(taskRef);\\n   427→    expect(completedEvent.data.outcome).toBe(\\\"success\\\");\\n   428→    expect(completedEvent.data.duration_ms).toBeGreaterThan(0);\\n   429→  });\\n   430→\\n   431→  it(\\\"should close session with status completed on success\\\", async () => {\\n   432→    const agent = makeTestAgent();\\n   433→\\n   434→    const result = await runInvocation({\\n   435→      agent,\\n   436→      specDir: testDir,\\n   437→      cwd: process.cwd(),\\n   438→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   439→      prompt: \\\"Check session completion status\\\",\\n   440→      trigger: \\\"task.ready\\\",\\n   441→    });\\n   442→\\n   443→    expect(result.session.status).toBe(\\\"completed\\\");\\n   444→    expect(result.session.ended_at).toBeDefined();\\n   445→  });\\n   446→\\n   447→  it(\\\"should return stopReason from ACP agent\\\", async () => {\\n   448→    const agent = makeTestAgent();\\n   449→\\n   450→    const result = await runInvocation({\\n   451→      agent,\\n   452→      specDir: testDir,\\n   453→      cwd: process.cwd(),\\n   454→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   455→      prompt: \\\"Check stop reason\\\",\\n   456→      trigger: \\\"task.ready\\\",\\n   457→    });\\n   458→\\n   459→    // Mock ACP returns \\\"end_turn\\\" by default\\n   460→    expect(result.stopReason).toBe(\\\"end_turn\\\");\\n   461→  });\\n   462→});\\n   463→\\n   464→// ─── AC-5: Failure handling ───────────────────────────────────────────────────\\n   465→\\n   466→// AC: @agent-invocation-lifecycle ac-5\\n   467→describe(\\\"Failure handling\\\", () => {\\n   468→  let testDir: string;\\n   469→\\n   470→  beforeEach(async () => {\\n   471→    testDir = await createTempDir(\\\"kspec-invoc-ac5-\\\");\\n   472→\\n   473→    // Register an adapter that exits with error\\n   474→    registerAdapter(\\\"failing-mock-acp\\\", {\\n   475→      command: \\\"node\\\",\\n   476→      args: [MOCK_ACP],\\n   477→      env: {\\n   478→        MOCK_ACP_EXIT_CODE: \\\"1\\\", // Non-zero exit = failure\\n   479→      },\\n   480→      description: \\\"Failing mock ACP agent\\\",\\n   481→    });\\n   482→  });\\n   483→\\n   484→  afterEach(async () => {\\n   485→    await cleanupTempDir(testDir);\\n   486→  });\\n   487→\\n   488→  it(\\\"should log agent.failed event with error details on process crash\\\", async () => {\\n   489→    const agent = makeTestAgent({ adapter: \\\"failing-mock-acp\\\" });\\n   490→    const taskRef = \\\"@\\\" + testUlid(\\\"TASK\\\");\\n   491→\\n   492→    const result = await runInvocation({\\n   493→      agent,\\n   494→      specDir: testDir,\\n   495→      cwd: process.cwd(),\\n   496→      taskRef,\\n   497→      prompt: \\\"Test failure handling\\\",\\n   498→      trigger: \\\"task.ready\\\",\\n   499→    });\\n   500→\\n   501→    expect(result.outcome).toBe(\\\"failed\\\");\\n   502→\\n   503→    const eventsPath = path.join(testDir, \\\"sessions\\\", result.session.id, \\\"events.jsonl\\\");\\n   504→    const content = await fs.readFile(eventsPath, \\\"utf-8\\\");\\n   505→    const events = content.trim().split(\\\"\\\\n\\\").filter(Boolean).map((l) => JSON.parse(l));\\n   506→\\n   507→    const failedEvent = events.find((e: { type: string }) => e.type === \\\"agent.failed\\\");\\n   508→    expect(failedEvent).toBeDefined();\\n   509→    // AC: @agent-invocation-lifecycle ac-5 — error details\\n   510→    expect(failedEvent.data.task_id).toBe(taskRef);\\n   511→    expect(failedEvent.data.error).toBeDefined();\\n   512→  });\\n   513→\\n   514→  it(\\\"should close session with status failed on failure\\\", async () => {\\n   515→    const agent = makeTestAgent({ adapter: \\\"failing-mock-acp\\\" });\\n   516→\\n   517→    const result = await runInvocation({\\n   518→      agent,\\n   519→      specDir: testDir,\\n   520→      cwd: process.cwd(),\\n   521→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   522→      prompt: \\\"Check failed session status\\\",\\n   523→      trigger: \\\"task.ready\\\",\\n   524→    });\\n   525→\\n   526→    expect(result.session.status).toBe(\\\"failed\\\");\\n   527→  });\\n   528→\\n   529→  it(\\\"should add a failure note to the task when invocation fails\\\", async () => {\\n   530→    // AC: @agent-invocation-lifecycle ac-5 — failure note written to task\\n   531→    const agent = makeTestAgent({ adapter: \\\"failing-mock-acp\\\" });\\n   532→    const captureFile = path.join(testDir, \\\"kspec-calls.json\\\");\\n   533→    const taskRef = \\\"@\\\" + testUlid(\\\"TASK\\\");\\n   534→\\n   535→    // Set capture env so runKspecCli's spawnSync inherits it\\n   536→    process.env.KSPEC_CAPTURE_FILE = captureFile;\\n   537→    try {\\n   538→      await runInvocation({\\n   539→        agent,\\n   540→        specDir: testDir,\\n   541→        cwd: process.cwd(),\\n   542→        taskRef,\\n   543→        prompt: \\\"Test failure note\\\",\\n   544→        trigger: \\\"task.ready\\\",\\n   545→        kspecCliPath: MOCK_KSPEC_CLI,\\n   546→      });\\n   547→    } finally {\\n   548→      delete process.env.KSPEC_CAPTURE_FILE;\\n   549→    }\\n   550→\\n   551→    // Verify that kspec task note was called with the task ref and AGENT-FAIL marker\\n   552→    const calls = JSON.parse(fsSync.readFileSync(captureFile, \\\"utf-8\\\")) as Array<{ args: string[] }>;\\n   553→    const noteCall = calls.find((c) =>\\n   554→      c.args.includes(\\\"task\\\") && c.args.includes(\\\"note\\\") && c.args.includes(taskRef)\\n   555→    );\\n   556→    expect(noteCall).toBeDefined();\\n   557→    const noteText = noteCall!.args[noteCall!.args.indexOf(taskRef) + 1] ?? \\\"\\\";\\n   558→    expect(noteText).toContain(\\\"[AGENT-FAIL]\\\");\\n   559→  });\\n   560→});\\n   561→\\n   562→// ─── AC-6: Streaming event logging ───────────────────────────────────────────\\n   563→\\n   564→// AC: @agent-invocation-lifecycle ac-6\\n   565→describe(\\\"Streaming event logging\\\", () => {\\n   566→  let testDir: string;\\n   567→\\n   568→  beforeEach(async () => {\\n   569→    testDir = await createTempDir(\\\"kspec-invoc-ac6-\\\");\\n   570→    registerMockAdapter({\\n   571→      MOCK_ACP_RESPONSE_TEXT: \\\"Streaming output test response\\\",\\n   572→    });\\n   573→  });\\n   574→\\n   575→  afterEach(async () => {\\n   576→    await cleanupTempDir(testDir);\\n   577→  });\\n   578→\\n   579→  it(\\\"should receive onUpdate callback for streaming updates\\\", async () => {\\n   580→    const agent = makeTestAgent();\\n   581→    const updates: unknown[] = [];\\n   582→\\n   583→    await runInvocation({\\n   584→      agent,\\n   585→      specDir: testDir,\\n   586→      cwd: process.cwd(),\\n   587→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   588→      prompt: \\\"Test streaming updates\\\",\\n   589→      trigger: \\\"task.ready\\\",\\n   590→      onUpdate: (update) => {\\n   591→        updates.push(update);\\n   592→      },\\n   593→    });\\n   594→\\n   595→    // Mock ACP sends at least one update with the response text\\n   596→    expect(updates.length).toBeGreaterThanOrEqual(0); // Mock may not send updates\\n   597→  });\\n   598→\\n   599→  it(\\\"should log session.update events to JSONL file\\\", async () => {\\n   600→    const agent = makeTestAgent();\\n   601→\\n   602→    const result = await runInvocation({\\n   603→      agent,\\n   604→      specDir: testDir,\\n   605→      cwd: process.cwd(),\\n   606→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   607→      prompt: \\\"Test event logging\\\",\\n   608→      trigger: \\\"task.ready\\\",\\n   609→    });\\n   610→\\n   611→    const eventsPath = path.join(testDir, \\\"sessions\\\", result.session.id, \\\"events.jsonl\\\");\\n   612→    const content = await fs.readFile(eventsPath, \\\"utf-8\\\");\\n   613→    const lines = content.trim().split(\\\"\\\\n\\\").filter(Boolean);\\n   614→\\n   615→    // Should have at least agent.dispatched, agent.started, agent.completed\\n   616→    expect(lines.length).toBeGreaterThanOrEqual(3);\\n   617→    const events = lines.map((l) => JSON.parse(l));\\n   618→    const eventTypes = events.map((e: { type: string }) => e.type);\\n   619→    expect(eventTypes).toContain(\\\"agent.dispatched\\\");\\n   620→    expect(eventTypes).toContain(\\\"agent.started\\\");\\n   621→    expect(eventTypes).toContain(\\\"agent.completed\\\");\\n   622→  });\\n   623→\\n   624→  it(\\\"should preserve update chunk order and strict seq monotonicity during concurrent bursts\\\", async () => {\\n   625→    // AC: @cli-agent-commands ac-12\\n   626→    // Regression for @01KJTQBT:\\n   627→    // Ensure concurrent update callbacks cannot reorder streamed chunks or\\n   628→    // produce duplicate/non-monotonic sequence numbers in events.jsonl.\\n   629→    const chunks = [\\\"chunk-0\\\", \\\"chunk-1\\\", \\\"chunk-2\\\", \\\"chunk-3\\\", \\\"chunk-4\\\"];\\n   630→    const agent = makeTestAgent();\\n   631→    const receivedChunks: string[] = [];\\n   632→    const updateSessionId = \\\"mock-acp-session\\\";\\n   633→    const emitter = new EventEmitter();\\n   634→\\n   635→    const spawnedAgent = {\\n   636→      client: {\\n   637→        on: (event: string, handler: (...args: unknown[]) => void) => {\\n   638→          emitter.on(event, handler);\\n   639→        },\\n   640→        newSession: vi.fn(async () => updateSessionId),\\n   641→        prompt: vi.fn(async () => {\\n   642→          for (const chunk of chunks) {\\n   643→            emitter.emit(\\\"update\\\", updateSessionId, {\\n   644→              sessionUpdate: \\\"agent_message_chunk\\\",\\n   645→              content: { type: \\\"text\\\", text: chunk },\\n   646→            });\\n   647→          }\\n   648→          return { stopReason: \\\"end_turn\\\" };\\n   649→        }),\\n   650→        cancel: vi.fn(async () => undefined),\\n   651→        endSession: vi.fn(async () => undefined),\\n   652→        respondPermission: vi.fn(async () => undefined),\\n   653→      },\\n   654→      kill: vi.fn(() => undefined),\\n   655→    };\\n   656→\\n   657→    const spawnSpy = vi.spyOn(spawnerModule, \\\"spawnAndInitialize\\\").mockResolvedValue(\\n   658→      spawnedAgent as unknown as Awaited<ReturnType<typeof spawnerModule.spawnAndInitialize>>,\\n   659→    );\\n   660→\\n   661→    const originalAppendEvent = storeModule.appendEvent;\\n   662→    let inFlightUpdateWrites = 0;\\n   663→    let maxInFlightUpdateWrites = 0;\\n   664→    const appendSpy = vi.spyOn(storeModule, \\\"appendEvent\\\").mockImplementation(async (specDir, input) => {\\n   665→      if (input.type !== \\\"session.update\\\") {\\n   666→        return originalAppendEvent(specDir, input);\\n   667→      }\\n   668→\\n   669→      const update = input.data as { sessionUpdate?: string; content?: { type?: string; text?: string } };\\n   670→      const text = update.sessionUpdate === \\\"agent_message_chunk\\\" && update.content?.type === \\\"text\\\"\\n   671→        ? update.content.text ?? \\\"\\\"\\n   672→        : \\\"\\\";\\n   673→      const index = Number.parseInt(text.replace(\\\"chunk-\\\", \\\"\\\"), 10);\\n   674→      const delayMs = Number.isNaN(index) ? 0 : (chunks.length - index) * 8;\\n   675→\\n   676→      inFlightUpdateWrites += 1;\\n   677→      maxInFlightUpdateWrites = Math.max(maxInFlightUpdateWrites, inFlightUpdateWrites);\\n   678→      try {\\n   679→        await new Promise((resolve) => setTimeout(resolve, delayMs));\\n   680→        return originalAppendEvent(specDir, input);\\n   681→      } finally {\\n   682→        inFlightUpdateWrites -= 1;\\n   683→      }\\n   684→    });\\n   685→\\n   686→    try {\\n   687→      const result = await runInvocation({\\n   688→        agent,\\n   689→        specDir: testDir,\\n   690→        cwd: process.cwd(),\\n   691→        taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   692→        prompt: \\\"Concurrent update burst ordering\\\",\\n   693→        trigger: \\\"task.ready\\\",\\n   694→        onUpdate: (update) => {\\n   695→          if (update.sessionUpdate === \\\"agent_message_chunk\\\" && update.content.type === \\\"text\\\") {\\n   696→            receivedChunks.push(update.content.text);\\n   697→          }\\n   698→        },\\n   699→      });\\n   700→\\n   701→      expect(result.outcome).toBe(\\\"success\\\");\\n   702→      expect(receivedChunks).toEqual(chunks);\\n   703→      expect(maxInFlightUpdateWrites).toBe(1);\\n   704→\\n   705→      const eventsPath = path.join(testDir, \\\"sessions\\\", result.session.id, \\\"events.jsonl\\\");\\n   706→      const content = await fs.readFile(eventsPath, \\\"utf-8\\\");\\n   707→      const events = content.trim().split(\\\"\\\\n\\\").filter(Boolean).map((line) => JSON.parse(line));\\n   708→      const seqs = events.map((event: { seq: number }) => event.seq);\\n   709→      const uniqueSeqCount = new Set(seqs).size;\\n   710→      expect(uniqueSeqCount).toBe(seqs.length);\\n   711→      for (let i = 1; i < seqs.length; i++) {\\n   712→        expect(seqs[i]).toBeGreaterThan(seqs[i - 1]);\\n   713→      }\\n   714→    } finally {\\n   715→      appendSpy.mockRestore();\\n   716→      spawnSpy.mockRestore();\\n   717→    }\\n   718→  });\\n   719→\\n   720→  it(\\\"should externalize oversized payload blobs when session updates exceed threshold\\\", async () => {\\n   721→    // AC: @agent-invocation-lifecycle ac-6 — blob externalization for oversized payloads\\n   722→    // Register mock adapter that sends a large payload (> EVENT_FIELD_EXTERNALIZE_BYTES = 16KB)\\n   723→    const oversizedText = \\\"x\\\".repeat(20 * 1024); // 20KB text — exceeds 16KB field threshold\\n   724→    registerAdapter(\\\"large-payload-acp\\\", {\\n   725→      command: \\\"node\\\",\\n   726→      args: [MOCK_ACP],\\n   727→      env: {\\n   728→        MOCK_ACP_RESPONSE_TEXT: oversizedText,\\n   729→      },\\n   730→      description: \\\"Mock ACP that sends oversized updates for blob externalization tests\\\",\\n   731→    });\\n   732→\\n   733→    const agent = makeTestAgent({ adapter: \\\"large-payload-acp\\\" });\\n   734→    const result = await runInvocation({\\n   735→      agent,\\n   736→      specDir: testDir,\\n   737→      cwd: process.cwd(),\\n   738→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   739→      prompt: \\\"Test blob externalization\\\",\\n   740→      trigger: \\\"task.ready\\\",\\n   741→    });\\n   742→\\n   743→    expect(result.outcome).toBe(\\\"success\\\");\\n   744→\\n   745→    const eventsPath = path.join(testDir, \\\"sessions\\\", result.session.id, \\\"events.jsonl\\\");\\n   746→    const content = await fs.readFile(eventsPath, \\\"utf-8\\\");\\n   747→    const lines = content.trim().split(\\\"\\\\n\\\").filter(Boolean);\\n   748→    const events = lines.map((l) => JSON.parse(l));\\n   749→\\n   750→    // Find the session.update event that contains the large payload\\n   751→    const updateEvent = events.find((e: { type: string }) => e.type === \\\"session.update\\\");\\n   752→    expect(updateEvent).toBeDefined();\\n   753→\\n   754→    // The oversized text field should be externalized as a blob pointer\\n   755→    // Walk data to find a blob pointer anywhere in the update's data tree\\n   756→    function hasBlobPointer(obj: unknown): boolean {\\n   757→      if (isSessionBlobPointer(obj)) return true;\\n   758→      if (typeof obj === \\\"object\\\" && obj !== null) {\\n   759→        return Object.values(obj).some(hasBlobPointer);\\n   760→      }\\n   761→      return false;\\n   762→    }\\n   763→\\n   764→    expect(hasBlobPointer(updateEvent.data)).toBe(true);\\n   765→\\n   766→    // Verify the blob file was created in the session's blobs/ directory\\n   767→    const blobDir = path.join(testDir, \\\"sessions\\\", result.session.id, \\\"blobs\\\");\\n   768→    const blobFiles = await fs.readdir(blobDir);\\n   769→    expect(blobFiles.length).toBeGreaterThan(0);\\n   770→  });\\n   771→});\\n   772→\\n   773→// ─── AC-7: Skill resolution ───────────────────────────────────────────────────\\n   774→\\n   775→// AC: @agent-invocation-lifecycle ac-7\\n   776→describe(\\\"Skill resolution for agent invocations\\\", () => {\\n   777→  let testDir: string;\\n   778→\\n   779→  beforeEach(async () => {\\n   780→    testDir = await createTempDir(\\\"kspec-invoc-ac7-\\\");\\n   781→  });\\n   782→\\n   783→  afterEach(async () => {\\n   784→    await cleanupTempDir(testDir);\\n   785→  });\\n   786→\\n   787→  it(\\\"resolveSkills should return content for existing skills\\\", async () => {\\n   788→    // Create a skill file in the test dir\\n   789→    const skillDir = path.join(testDir, \\\"skills\\\", \\\"my-skill\\\");\\n   790→    await fs.mkdir(skillDir, { recursive: true });\\n   791→    await fs.writeFile(path.join(skillDir, \\\"SKILL.md\\\"), \\\"# My Skill\\\\n\\\\nDo things.\\\");\\n   792→\\n   793→    const resolved = await resolveSkills([\\\"my-skill\\\"], testDir);\\n   794→\\n   795→    expect(resolved).toHaveLength(1);\\n   796→    expect(resolved[0].id).toBe(\\\"my-skill\\\");\\n   797→    expect(resolved[0].content).toContain(\\\"# My Skill\\\");\\n   798→  });\\n   799→\\n   800→  it(\\\"resolveSkills should skip missing skills silently\\\", async () => {\\n   801→    const resolved = await resolveSkills([\\\"non-existent-skill\\\"], testDir);\\n   802→    expect(resolved).toHaveLength(0);\\n   803→  });\\n   804→\\n   805→  it(\\\"buildPromptWithSkills should append skill content to prompt\\\", async () => {\\n   806→    const skillDir = path.join(testDir, \\\"skills\\\", \\\"task-work\\\");\\n   807→    await fs.mkdir(skillDir, { recursive: true });\\n   808→    await fs.writeFile(path.join(skillDir, \\\"SKILL.md\\\"), \\\"# Task Work Skill\\\\n\\\\nWork on tasks.\\\");\\n   809→\\n   810→    const result = await buildPromptWithSkills({\\n   811→      basePrompt: \\\"Do the work\\\",\\n   812→      skillIds: [\\\"task-work\\\"],\\n   813→      specDir: testDir,\\n   814→    });\\n   815→\\n   816→    expect(result).toContain(\\\"Do the work\\\");\\n   817→    expect(result).toContain(\\\"# Task Work Skill\\\");\\n   818→    expect(result).toContain(\\\"Skills\\\");\\n   819→  });\\n   820→\\n   821→  it(\\\"buildPromptWithSkills should return base prompt unchanged when no skills\\\", async () => {\\n   822→    const result = await buildPromptWithSkills({\\n   823→      basePrompt: \\\"Simple prompt\\\",\\n   824→      skillIds: [],\\n   825→      specDir: testDir,\\n   826→    });\\n   827→\\n   828→    expect(result).toBe(\\\"Simple prompt\\\");\\n   829→  });\\n   830→\\n   831→  it(\\\"buildPromptWithSkills should include multiple skills\\\", async () => {\\n   832→    for (const skillId of [\\\"skill-a\\\", \\\"skill-b\\\"]) {\\n   833→      const skillDir = path.join(testDir, \\\"skills\\\", skillId);\\n   834→      await fs.mkdir(skillDir, { recursive: true });\\n   835→      await fs.writeFile(path.join(skillDir, \\\"SKILL.md\\\"), `# ${skillId} content`);\\n   836→    }\\n   837→\\n   838→    const result = await buildPromptWithSkills({\\n   839→      basePrompt: \\\"Multi-skill test\\\",\\n   840→      skillIds: [\\\"skill-a\\\", \\\"skill-b\\\"],\\n   841→      specDir: testDir,\\n   842→    });\\n   843→\\n   844→    expect(result).toContain(\\\"skill-a content\\\");\\n   845→    expect(result).toContain(\\\"skill-b content\\\");\\n   846→  });\\n   847→\\n   848→  // AC: @agent-invocation-lifecycle ac-10\\n   849→  it(\\\"buildPromptWithSkills should rewrite skill references for claude adapter\\\", async () => {\\n   850→    const skillDir = path.join(testDir, \\\"skills\\\", \\\"task-work\\\");\\n   851→    await fs.mkdir(skillDir, { recursive: true });\\n   852→    await fs.writeFile(\\n   853→      path.join(skillDir, \\\"SKILL.md\\\"),\\n   854→      \\\"# Task Work\\\\n\\\\nRun {skill:task-work} then {skill:pr}.\\\",\\n   855→    );\\n   856→\\n   857→    await fs.mkdir(path.join(testDir, \\\".agents\\\", \\\"skills\\\", \\\"kspec-task-work\\\"), { recursive: true });\\n   858→\\n   859→    const result = await buildPromptWithSkills({\\n   860→      basePrompt: \\\"Base prompt\\\",\\n   861→      skillIds: [\\\"task-work\\\"],\\n   862→      specDir: testDir,\\n   863→      adapterId: \\\"claude-agent-acp\\\",\\n   864→    });\\n   865→\\n   866→    expect(result).toContain(\\\"/kspec:task-work\\\");\\n   867→    expect(result).toContain(\\\"/pr\\\");\\n   868→    expect(result).not.toContain(\\\"{skill:task-work}\\\");\\n   869→    expect(result).not.toContain(\\\"{skill:pr}\\\");\\n   870→  });\\n   871→\\n   872→  // AC: @agent-invocation-lifecycle ac-10\\n   873→  it(\\\"buildPromptWithSkills should rewrite skill references for codex adapter\\\", async () => {\\n   874→    const skillDir = path.join(testDir, \\\"skills\\\", \\\"task-work\\\");\\n   875→    await fs.mkdir(skillDir, { recursive: true });\\n   876→    await fs.writeFile(path.join(skillDir, \\\"SKILL.md\\\"), \\\"# Task Work\\\\n\\\\nRun {skill:task-work}.\\\");\\n   877→\\n   878→    await fs.mkdir(path.join(testDir, \\\".agents\\\", \\\"skills\\\", \\\"kspec-task-work\\\"), { recursive: true });\\n   879→\\n   880→    const result = await buildPromptWithSkills({\\n   881→      basePrompt: \\\"Base prompt\\\",\\n   882→      skillIds: [\\\"task-work\\\"],\\n   883→      specDir: testDir,\\n   884→      adapterId: \\\"codex-acp\\\",\\n   885→    });\\n   886→\\n   887→    expect(result).toContain(\\\"$kspec-task-work\\\");\\n   888→    expect(result).not.toContain(\\\"{skill:task-work}\\\");\\n   889→  });\\n   890→\\n   891→  // AC: @agent-invocation-lifecycle ac-10\\n   892→  it(\\\"buildPromptWithSkills should leave skill references unchanged for unknown adapters\\\", async () => {\\n   893→    const skillDir = path.join(testDir, \\\"skills\\\", \\\"task-work\\\");\\n   894→    await fs.mkdir(skillDir, { recursive: true });\\n   895→    await fs.writeFile(path.join(skillDir, \\\"SKILL.md\\\"), \\\"# Task Work\\\\n\\\\nRun {skill:task-work}.\\\");\\n   896→\\n   897→    const result = await buildPromptWithSkills({\\n   898→      basePrompt: \\\"Base prompt\\\",\\n   899→      skillIds: [\\\"task-work\\\"],\\n   900→      specDir: testDir,\\n   901→      adapterId: \\\"mock-acp\\\",\\n   902→    });\\n   903→\\n   904→    expect(result).toContain(\\\"{skill:task-work}\\\");\\n   905→  });\\n   906→});\\n   907→\\n   908→// ─── AC-8: Cleanup on completion or failure ───────────────────────────────────\\n   909→\\n   910→// AC: @agent-invocation-lifecycle ac-8\\n   911→describe(\\\"Cleanup on completion or failure\\\", () => {\\n   912→  let testDir: string;\\n   913→\\n   914→  beforeEach(async () => {\\n   915→    testDir = await createTempDir(\\\"kspec-invoc-ac8-\\\");\\n   916→    registerMockAdapter();\\n   917→  });\\n   918→\\n   919→  afterEach(async () => {\\n   920→    await cleanupTempDir(testDir);\\n   921→  });\\n   922→\\n   923→  it(\\\"should terminate agent process after successful completion\\\", async () => {\\n   924→    const agent = makeTestAgent();\\n   925→\\n   926→    // If the agent process isn't terminated, the test would hang or\\n   927→    // leave zombie processes. The fact that runInvocation returns is\\n   928→    // evidence that the process was managed correctly.\\n   929→    const result = await runInvocation({\\n   930→      agent,\\n   931→      specDir: testDir,\\n   932→      cwd: process.cwd(),\\n   933→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   934→      prompt: \\\"Test cleanup on success\\\",\\n   935→      trigger: \\\"task.ready\\\",\\n   936→    });\\n   937→\\n   938→    expect(result.outcome).toBe(\\\"success\\\");\\n   939→    // If we reach here without hanging, cleanup worked\\n   940→  });\\n   941→\\n   942→  it(\\\"should restore KSPEC_SESSION_ID env after invocation\\\", async () => {\\n   943→    const agent = makeTestAgent();\\n   944→    const originalValue = process.env.KSPEC_SESSION_ID;\\n   945→\\n   946→    await runInvocation({\\n   947→      agent,\\n   948→      specDir: testDir,\\n   949→      cwd: process.cwd(),\\n   950→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   951→      prompt: \\\"Test env restoration\\\",\\n   952→      trigger: \\\"task.ready\\\",\\n   953→    });\\n   954→\\n   955→    // After invocation, env should be back to original\\n   956→    // (either undefined or the original value)\\n   957→    expect(process.env.KSPEC_SESSION_ID).toBe(originalValue);\\n   958→  });\\n   959→\\n   960→  it(\\\"should restore env even when invocation fails\\\", async () => {\\n   961→    registerAdapter(\\\"failing-cleanup-acp\\\", {\\n   962→      command: \\\"node\\\",\\n   963→      args: [MOCK_ACP],\\n   964→      env: { MOCK_ACP_EXIT_CODE: \\\"1\\\" },\\n   965→      description: \\\"Failing adapter for cleanup test\\\",\\n   966→    });\\n   967→\\n   968→    const agent = makeTestAgent({ adapter: \\\"failing-cleanup-acp\\\" });\\n   969→    const originalValue = process.env.KSPEC_SESSION_ID;\\n   970→\\n   971→    const result = await runInvocation({\\n   972→      agent,\\n   973→      specDir: testDir,\\n   974→      cwd: process.cwd(),\\n   975→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   976→      prompt: \\\"Test cleanup on failure\\\",\\n   977→      trigger: \\\"task.ready\\\",\\n   978→    });\\n   979→\\n   980→    expect(result.outcome).toBe(\\\"failed\\\");\\n   981→    // Env should be restored\\n   982→    expect(process.env.KSPEC_SESSION_ID).toBe(originalValue);\\n   983→  });\\n   984→\\n   985→  it(\\\"should call removeEnvForAdapter to restore adapter-specific env injection\\\", async () => {\\n   986→    // AC: @agent-invocation-lifecycle ac-8 — adapter env injection is restored to previous state\\n   987→    const removeEnvSpy = vi.spyOn(storeModule, \\\"removeEnvForAdapter\\\");\\n   988→\\n   989→    try {\\n   990→      const agent = makeTestAgent(); // uses \\\"mock-acp\\\" adapter\\n   991→      await runInvocation({\\n   992→        agent,\\n   993→        specDir: testDir,\\n   994→        cwd: process.cwd(),\\n   995→        taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n   996→        prompt: \\\"Test adapter env restoration\\\",\\n   997→        trigger: \\\"task.ready\\\",\\n   998→      });\\n   999→\\n  1000→      // removeEnvForAdapter must be called with the adapter ID on cleanup\\n  1001→      // For \\\"mock-acp\\\" the injectionResult is null so previousValue is undefined\\n  1002→      expect(removeEnvSpy).toHaveBeenCalledWith(\\\"mock-acp\\\", undefined);\\n  1003→    } finally {\\n  1004→      removeEnvSpy.mockRestore();\\n  1005→    }\\n  1006→  });\\n  1007→\\n  1008→  it(\\\"should call removeEnvForAdapter even when invocation fails\\\", async () => {\\n  1009→    // AC: @agent-invocation-lifecycle ac-8 — adapter env injection restored on failure path too\\n  1010→    registerAdapter(\\\"failing-env-acp\\\", {\\n  1011→      command: \\\"node\\\",\\n  1012→      args: [MOCK_ACP],\\n  1013→      env: { MOCK_ACP_EXIT_CODE: \\\"1\\\" },\\n  1014→      description: \\\"Failing adapter for env restoration test\\\",\\n  1015→    });\\n  1016→\\n  1017→    const removeEnvSpy = vi.spyOn(storeModule, \\\"removeEnvForAdapter\\\");\\n  1018→\\n  1019→    try {\\n  1020→      const agent = makeTestAgent({ adapter: \\\"failing-env-acp\\\" });\\n  1021→      const result = await runInvocation({\\n  1022→        agent,\\n  1023→        specDir: testDir,\\n  1024→        cwd: process.cwd(),\\n  1025→        taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n  1026→        prompt: \\\"Test env restoration on failure\\\",\\n  1027→        trigger: \\\"task.ready\\\",\\n  1028→      });\\n  1029→\\n  1030→      expect(result.outcome).toBe(\\\"failed\\\");\\n  1031→      // removeEnvForAdapter called once for this invocation (not from prior test since spy was scoped)\\n  1032→      expect(removeEnvSpy).toHaveBeenCalledWith(\\\"failing-env-acp\\\", undefined);\\n  1033→    } finally {\\n  1034→      removeEnvSpy.mockRestore();\\n  1035→    }\\n  1036→  });\\n  1037→});\\n  1038→\\n  1039→// ─── AC-9: Retry threshold and task blocking ──────────────────────────────────\\n  1040→\\n  1041→// AC: @agent-invocation-lifecycle ac-9\\n  1042→describe(\\\"Consecutive failure threshold and task blocking\\\", () => {\\n  1043→  let testDir: string;\\n  1044→\\n  1045→  beforeEach(async () => {\\n  1046→    testDir = await createTempDir(\\\"kspec-invoc-ac9-\\\");\\n  1047→    registerAdapter(\\\"always-fail-acp\\\", {\\n  1048→      command: \\\"node\\\",\\n  1049→      args: [MOCK_ACP],\\n  1050→      env: { MOCK_ACP_EXIT_CODE: \\\"1\\\" },\\n  1051→      description: \\\"Always-failing adapter for retry threshold tests\\\",\\n  1052→    });\\n  1053→  });\\n  1054→\\n  1055→  afterEach(async () => {\\n  1056→    await cleanupTempDir(testDir);\\n  1057→  });\\n  1058→\\n  1059→  it(\\\"should block the task with a failure note when consecutive failures reach retry limit\\\", async () => {\\n  1060→    // AC: @agent-invocation-lifecycle ac-9 — consecutive failures → task blocked with note\\n  1061→    // The agent's retry limit is derived from agent.budget.max_retries (default 3).\\n  1062→    // We pre-populate the capture file to simulate prior failure notes already recorded\\n  1063→    // by previous invocations, then trigger the threshold-crossing invocation.\\n  1064→    const captureFile = path.join(testDir, \\\"kspec-calls.json\\\");\\n  1065→    const taskRef = \\\"@\\\" + testUlid(\\\"TASK\\\");\\n  1066→\\n  1067→    // Mock kspec CLI: simulate \\\"task get\\\" returning a task with 3 existing AGENT-FAIL notes.\\n  1068→    // The implementation calls getConsecutiveFailureCount (kspec task get --json) to read\\n  1069→    // the note history. With 3 consecutive AGENT-FAIL notes and a retry limit of 3, blocking\\n  1070→    // must be triggered.\\n  1071→    const taskGetMockPath = path.join(testDir, \\\"kspec-threshold-mock.cjs\\\");\\n  1072→    const mockTask = {\\n  1073→      notes: [\\n  1074→        { content: \\\"[AGENT-FAIL] Invocation failed: Mock failure\\\" },\\n  1075→        { content: \\\"[AGENT-FAIL] Invocation failed: Mock failure\\\" },\\n  1076→        { content: \\\"[AGENT-FAIL] Invocation failed: Mock failure\\\" },\\n  1077→      ],\\n  1078→    };\\n  1079→    await fs.writeFile(taskGetMockPath, `#!/usr/bin/env node\\n  1080→'use strict';\\n  1081→const fs = require('node:fs');\\n  1082→const args = process.argv.slice(2);\\n  1083→const captureFile = process.env.KSPEC_CAPTURE_FILE;\\n  1084→\\n  1085→if (captureFile) {\\n  1086→  let calls = [];\\n  1087→  try { calls = JSON.parse(fs.readFileSync(captureFile, 'utf-8')); } catch {}\\n  1088→  calls.push({ args, timestamp: Date.now() });\\n  1089→  fs.writeFileSync(captureFile, JSON.stringify(calls, null, 2));\\n  1090→}\\n  1091→\\n  1092→// Return task JSON for \\\"task get ... --json\\\" to simulate 3 consecutive prior failures\\n  1093→if (args.includes('task') && args.includes('get') && args.includes('--json')) {\\n  1094→  process.stdout.write(JSON.stringify(${JSON.stringify(mockTask)}) + '\\\\\\\\n');\\n  1095→}\\n  1096→\\n  1097→process.exit(0);\\n  1098→`);\\n  1099→\\n  1100→    process.env.KSPEC_CAPTURE_FILE = captureFile;\\n  1101→    try {\\n  1102→      const agent = makeTestAgent({\\n  1103→        adapter: \\\"always-fail-acp\\\",\\n  1104→        budget: { max_retries: 3, timeout_minutes: 30 },\\n  1105→      } as Partial<Agent>);\\n  1106→\\n  1107→      await runInvocation({\\n  1108→        agent,\\n  1109→        specDir: testDir,\\n  1110→        cwd: process.cwd(),\\n  1111→        taskRef,\\n  1112→        prompt: \\\"Test consecutive failure blocking\\\",\\n  1113→        trigger: \\\"task.ready\\\",\\n  1114→        kspecCliPath: taskGetMockPath,\\n  1115→      });\\n  1116→    } finally {\\n  1117→      delete process.env.KSPEC_CAPTURE_FILE;\\n  1118→    }\\n  1119→\\n  1120→    // Verify task block was called\\n  1121→    const calls = JSON.parse(fsSync.readFileSync(captureFile, \\\"utf-8\\\")) as Array<{ args: string[] }>;\\n  1122→    const blockCall = calls.find((c) =>\\n  1123→      c.args.includes(\\\"task\\\") && c.args.includes(\\\"block\\\") && c.args.includes(taskRef)\\n  1124→    );\\n  1125→    expect(blockCall).toBeDefined();\\n  1126→\\n  1127→    // The block reason should mention consecutive failures and the agent\\n  1128→    const reasonIdx = blockCall!.args.indexOf(\\\"--reason\\\");\\n  1129→    expect(reasonIdx).toBeGreaterThan(-1);\\n  1130→    const blockReason = blockCall!.args[reasonIdx + 1] ?? \\\"\\\";\\n  1131→    expect(blockReason).toContain(\\\"consecutive\\\");\\n  1132→  });\\n  1133→\\n  1134→  it(\\\"should NOT block the task when failure count is below the retry limit\\\", async () => {\\n  1135→    // AC: @agent-invocation-lifecycle ac-9 — below threshold: note added, no block\\n  1136→    const captureFile = path.join(testDir, \\\"kspec-calls-below.json\\\");\\n  1137→    const taskRef = \\\"@\\\" + testUlid(\\\"TASK\\\");\\n  1138→\\n  1139→    // Mock kspec CLI: simulate task with 0 prior AGENT-FAIL notes (first failure)\\n  1140→    const taskGetMockPath = path.join(testDir, \\\"kspec-below-mock.cjs\\\");\\n  1141→    const emptyTask = { notes: [] };\\n  1142→    await fs.writeFile(taskGetMockPath, `#!/usr/bin/env node\\n  1143→'use strict';\\n  1144→const fs = require('node:fs');\\n  1145→const args = process.argv.slice(2);\\n  1146→const captureFile = process.env.KSPEC_CAPTURE_FILE;\\n  1147→\\n  1148→if (captureFile) {\\n  1149→  let calls = [];\\n  1150→  try { calls = JSON.parse(fs.readFileSync(captureFile, 'utf-8')); } catch {}\\n  1151→  calls.push({ args, timestamp: Date.now() });\\n  1152→  fs.writeFileSync(captureFile, JSON.stringify(calls, null, 2));\\n  1153→}\\n  1154→\\n  1155→if (args.includes('task') && args.includes('get') && args.includes('--json')) {\\n  1156→  process.stdout.write(JSON.stringify(${JSON.stringify(emptyTask)}) + '\\\\\\\\n');\\n  1157→}\\n  1158→\\n  1159→process.exit(0);\\n  1160→`);\\n  1161→\\n  1162→    process.env.KSPEC_CAPTURE_FILE = captureFile;\\n  1163→    try {\\n  1164→      const agent = makeTestAgent({\\n  1165→        adapter: \\\"always-fail-acp\\\",\\n  1166→        budget: { max_retries: 3, timeout_minutes: 30 },\\n  1167→      } as Partial<Agent>);\\n  1168→\\n  1169→      await runInvocation({\\n  1170→        agent,\\n  1171→        specDir: testDir,\\n  1172→        cwd: process.cwd(),\\n  1173→        taskRef,\\n  1174→        prompt: \\\"Test below threshold\\\",\\n  1175→        trigger: \\\"task.ready\\\",\\n  1176→        kspecCliPath: taskGetMockPath,\\n  1177→      });\\n  1178→    } finally {\\n  1179→      delete process.env.KSPEC_CAPTURE_FILE;\\n  1180→    }\\n  1181→\\n  1182→    const calls = JSON.parse(fsSync.readFileSync(captureFile, \\\"utf-8\\\")) as Array<{ args: string[] }>;\\n  1183→\\n  1184→    // Note should be written\\n  1185→    const noteCall = calls.find((c) =>\\n  1186→      c.args.includes(\\\"task\\\") && c.args.includes(\\\"note\\\") && c.args.includes(taskRef)\\n  1187→    );\\n  1188→    expect(noteCall).toBeDefined();\\n  1189→\\n  1190→    // Block should NOT be called (only 1 failure, limit is 3)\\n  1191→    const blockCall = calls.find((c) =>\\n  1192→      c.args.includes(\\\"task\\\") && c.args.includes(\\\"block\\\") && c.args.includes(taskRef)\\n  1193→    );\\n  1194→    expect(blockCall).toBeUndefined();\\n  1195→  });\\n  1196→\\n  1197→  it(\\\"should reset consecutive failure count after a successful invocation\\\", async () => {\\n  1198→    // AC: @agent-invocation-lifecycle ac-9 — streak resets after success; fail→success→fail is not consecutive\\n  1199→    // Simulate: task has 2 prior AGENT-FAIL notes then 1 AGENT-SUCCESS note (streak reset).\\n  1200→    // With retry limit=3, the next failure is count=1 → should NOT block.\\n  1201→    const captureFile = path.join(testDir, \\\"kspec-calls-reset.json\\\");\\n  1202→    const taskRef = \\\"@\\\" + testUlid(\\\"TASK\\\");\\n  1203→\\n  1204→    // Mock kspec CLI: simulate task with AGENT-FAIL, AGENT-FAIL, AGENT-SUCCESS notes.\\n  1205→    // The last note is AGENT-SUCCESS, so consecutive count (from end) = 0 before this failure.\\n  1206→    const taskGetMockPath = path.join(testDir, \\\"kspec-reset-mock.cjs\\\");\\n  1207→    const taskWithResetNotes = {\\n  1208→      notes: [\\n  1209→        { content: \\\"[AGENT-FAIL] Invocation failed: first failure\\\" },\\n  1210→        { content: \\\"[AGENT-FAIL] Invocation failed: second failure\\\" },\\n  1211→        { content: \\\"[AGENT-SUCCESS] Invocation completed successfully\\\" },\\n  1212→      ],\\n  1213→    };\\n  1214→    await fs.writeFile(taskGetMockPath, `#!/usr/bin/env node\\n  1215→'use strict';\\n  1216→const fs = require('node:fs');\\n  1217→const args = process.argv.slice(2);\\n  1218→const captureFile = process.env.KSPEC_CAPTURE_FILE;\\n  1219→\\n  1220→if (captureFile) {\\n  1221→  let calls = [];\\n  1222→  try { calls = JSON.parse(fs.readFileSync(captureFile, 'utf-8')); } catch {}\\n  1223→  calls.push({ args, timestamp: Date.now() });\\n  1224→  fs.writeFileSync(captureFile, JSON.stringify(calls, null, 2));\\n  1225→}\\n  1226→\\n  1227→if (args.includes('task') && args.includes('get') && args.includes('--json')) {\\n  1228→  process.stdout.write(JSON.stringify(${JSON.stringify(taskWithResetNotes)}) + '\\\\\\\\n');\\n  1229→}\\n  1230→\\n  1231→process.exit(0);\\n  1232→`);\\n  1233→\\n  1234→    process.env.KSPEC_CAPTURE_FILE = captureFile;\\n  1235→    try {\\n  1236→      const agent = makeTestAgent({\\n  1237→        adapter: \\\"always-fail-acp\\\",\\n  1238→        budget: { max_retries: 3, timeout_minutes: 30 },\\n  1239→      } as Partial<Agent>);\\n  1240→\\n  1241→      await runInvocation({\\n  1242→        agent,\\n  1243→        specDir: testDir,\\n  1244→        cwd: process.cwd(),\\n  1245→        taskRef,\\n  1246→        prompt: \\\"Test streak reset after success\\\",\\n  1247→        trigger: \\\"task.ready\\\",\\n  1248→        kspecCliPath: taskGetMockPath,\\n  1249→      });\\n  1250→    } finally {\\n  1251→      delete process.env.KSPEC_CAPTURE_FILE;\\n  1252→    }\\n  1253→\\n  1254→    const calls = JSON.parse(fsSync.readFileSync(captureFile, \\\"utf-8\\\")) as Array<{ args: string[] }>;\\n  1255→\\n  1256→    // Failure note should be written\\n  1257→    const noteCall = calls.find((c) =>\\n  1258→      c.args.includes(\\\"task\\\") && c.args.includes(\\\"note\\\") && c.args.includes(taskRef)\\n  1259→    );\\n  1260→    expect(noteCall).toBeDefined();\\n  1261→\\n  1262→    // Block should NOT be called — streak was reset by AGENT-SUCCESS, so only 1 consecutive failure now\\n  1263→    const blockCall = calls.find((c) =>\\n  1264→      c.args.includes(\\\"task\\\") && c.args.includes(\\\"block\\\") && c.args.includes(taskRef)\\n  1265→    );\\n  1266→    expect(blockCall).toBeUndefined();\\n  1267→  });\\n  1268→});\\n  1269→\\n  1270→// ─── AC-11: ACP permission request auto-approval ─────────────────────────────\\n  1271→\\n  1272→// AC: @agent-invocation-lifecycle ac-11\\n  1273→describe(\\\"ACP permission request handling\\\", () => {\\n  1274→  let testDir: string;\\n  1275→\\n  1276→  beforeEach(async () => {\\n  1277→    testDir = await createTempDir(\\\"kspec-invoc-ac11-\\\");\\n  1278→  });\\n  1279→\\n  1280→  afterEach(async () => {\\n  1281→    await cleanupTempDir(testDir);\\n  1282→  });\\n  1283→\\n  1284→  it(\\\"should auto-approve permission requests in auto-approve mode\\\", async () => {\\n  1285→    // Register adapter that sends a permission request during the prompt\\n  1286→    registerAdapter(\\\"permission-mock-acp\\\", {\\n  1287→      command: \\\"node\\\",\\n  1288→      args: [MOCK_ACP],\\n  1289→      env: {\\n  1290→        MOCK_ACP_SEND_PERMISSION_REQUEST: \\\"true\\\",\\n  1291→        MOCK_ACP_PROJECT_DIR: process.cwd(),\\n  1292→      },\\n  1293→      description: \\\"Mock ACP that sends permission requests\\\",\\n  1294→    });\\n  1295→\\n  1296→    const agent = makeTestAgent({ adapter: \\\"permission-mock-acp\\\", auto_approve: true });\\n  1297→\\n  1298→    const result = await runInvocation({\\n  1299→      agent,\\n  1300→      specDir: testDir,\\n  1301→      cwd: process.cwd(),\\n  1302→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n  1303→      prompt: \\\"Test permission auto-approval\\\",\\n  1304→      trigger: \\\"task.ready\\\",\\n  1305→      autoApprove: true,\\n  1306→    });\\n  1307→\\n  1308→    // Invocation should complete successfully — not hang waiting for permission\\n  1309→    expect(result.outcome).toBe(\\\"success\\\");\\n  1310→    expect(result.stopReason).toBe(\\\"end_turn\\\");\\n  1311→  });\\n  1312→\\n  1313→  it(\\\"should deny permission requests in non-auto-approve mode and still complete\\\", async () => {\\n  1314→    registerAdapter(\\\"permission-deny-acp\\\", {\\n  1315→      command: \\\"node\\\",\\n  1316→      args: [MOCK_ACP],\\n  1317→      env: {\\n  1318→        MOCK_ACP_SEND_PERMISSION_REQUEST: \\\"true\\\",\\n  1319→        MOCK_ACP_PROJECT_DIR: process.cwd(),\\n  1320→      },\\n  1321→      description: \\\"Mock ACP for permission deny test\\\",\\n  1322→    });\\n  1323→\\n  1324→    const agent = makeTestAgent({ adapter: \\\"permission-deny-acp\\\", auto_approve: false });\\n  1325→\\n  1326→    const result = await runInvocation({\\n  1327→      agent,\\n  1328→      specDir: testDir,\\n  1329→      cwd: process.cwd(),\\n  1330→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n  1331→      prompt: \\\"Test permission denial\\\",\\n  1332→      trigger: \\\"task.ready\\\",\\n  1333→      autoApprove: false,\\n  1334→    });\\n  1335→\\n  1336→    // Invocation should complete (not hang) — mock proceeds after receiving any response\\n  1337→    expect(result.outcome).toBe(\\\"success\\\");\\n  1338→  });\\n  1339→});\\n  1340→\\n  1341→// ─── AC-12: Sanitize inherited env vars in agent spawner ──────────────────────\\n  1342→\\n  1343→// AC: @agent-invocation-lifecycle ac-12\\n  1344→describe(\\\"Host environment variable sanitization\\\", () => {\\n  1345→  let testDir: string;\\n  1346→\\n  1347→  beforeEach(async () => {\\n  1348→    testDir = await createTempDir(\\\"kspec-invoc-ac12-\\\");\\n  1349→  });\\n  1350→\\n  1351→  afterEach(async () => {\\n  1352→    for (const key of SANITIZED_ENV_VARS) {\\n  1353→      delete process.env[key];\\n  1354→    }\\n  1355→    await cleanupTempDir(testDir);\\n  1356→  });\\n  1357→\\n  1358→  it(\\\"should strip CLAUDECODE and CLAUDE_CODE_SESSION from spawned agent environment\\\", async () => {\\n  1359→    // Simulate running inside a Claude Code environment\\n  1360→    process.env.CLAUDECODE = \\\"1\\\";\\n  1361→    process.env.CLAUDE_CODE_SESSION = \\\"parent-session-id\\\";\\n  1362→\\n  1363→    // Use the mock ACP's VERIFY_ENV feature to check what the child process sees\\n  1364→    const envVerifyFile = path.join(testDir, \\\"env-verify.json\\\");\\n  1365→    registerAdapter(\\\"env-verify-acp\\\", {\\n  1366→      command: \\\"node\\\",\\n  1367→      args: [MOCK_ACP],\\n  1368→      env: {\\n  1369→        MOCK_ACP_PROJECT_DIR: process.cwd(),\\n  1370→        MOCK_ACP_VERIFY_ENV_FILE: envVerifyFile,\\n  1371→        MOCK_ACP_VERIFY_ENV_VARS: \\\"CLAUDECODE,CLAUDE_CODE_SESSION,PATH\\\",\\n  1372→      },\\n  1373→      description: \\\"Mock ACP that reports its env vars for sanitization tests\\\",\\n  1374→    });\\n  1375→\\n  1376→    const agent = makeTestAgent({ adapter: \\\"env-verify-acp\\\" });\\n  1377→    const result = await runInvocation({\\n  1378→      agent,\\n  1379→      specDir: testDir,\\n  1380→      cwd: process.cwd(),\\n  1381→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n  1382→      prompt: \\\"Test env sanitization\\\",\\n  1383→      trigger: \\\"task.ready\\\",\\n  1384→    });\\n  1385→\\n  1386→    expect(result.outcome).toBe(\\\"success\\\");\\n  1387→\\n  1388→    // Read the env vars reported by the child process\\n  1389→    const reportedEnv = JSON.parse(await fs.readFile(envVerifyFile, \\\"utf-8\\\"));\\n  1390→\\n  1391→    // CLAUDECODE and CLAUDE_CODE_SESSION must be null (not present in child env)\\n  1392→    expect(reportedEnv.CLAUDECODE).toBeNull();\\n  1393→    expect(reportedEnv.CLAUDE_CODE_SESSION).toBeNull();\\n  1394→\\n  1395→    // PATH should still be present (not sanitized)\\n  1396→    expect(reportedEnv.PATH).not.toBeNull();\\n  1397→  });\\n  1398→\\n  1399→  it(\\\"should not affect process.env of the parent process\\\", async () => {\\n  1400→    // Set sanitized vars\\n  1401→    process.env.CLAUDECODE = \\\"1\\\";\\n  1402→    process.env.CLAUDE_CODE_SESSION = \\\"parent-session-id\\\";\\n  1403→\\n  1404→    const envVerifyFile = path.join(testDir, \\\"env-verify-parent.json\\\");\\n  1405→    registerAdapter(\\\"env-verify-parent-acp\\\", {\\n  1406→      command: \\\"node\\\",\\n  1407→      args: [MOCK_ACP],\\n  1408→      env: {\\n  1409→        MOCK_ACP_PROJECT_DIR: process.cwd(),\\n  1410→        MOCK_ACP_VERIFY_ENV_FILE: envVerifyFile,\\n  1411→        MOCK_ACP_VERIFY_ENV_VARS: \\\"CLAUDECODE\\\",\\n  1412→      },\\n  1413→      description: \\\"Mock ACP for parent env preservation test\\\",\\n  1414→    });\\n  1415→\\n  1416→    const agent = makeTestAgent({ adapter: \\\"env-verify-parent-acp\\\" });\\n  1417→    await runInvocation({\\n  1418→      agent,\\n  1419→      specDir: testDir,\\n  1420→      cwd: process.cwd(),\\n  1421→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n  1422→      prompt: \\\"Test parent env preservation\\\",\\n  1423→      trigger: \\\"task.ready\\\",\\n  1424→    });\\n  1425→\\n  1426→    // Parent process should still have CLAUDECODE — sanitization is per-spawn only\\n  1427→    expect(process.env.CLAUDECODE).toBe(\\\"1\\\");\\n  1428→    expect(process.env.CLAUDE_CODE_SESSION).toBe(\\\"parent-session-id\\\");\\n  1429→  });\\n  1430→\\n  1431→  it(\\\"SANITIZED_ENV_VARS should contain the expected variables\\\", () => {\\n  1432→    // Guard against accidental removal of vars from the sanitization list\\n  1433→    expect(SANITIZED_ENV_VARS).toContain(\\\"CLAUDECODE\\\");\\n  1434→    expect(SANITIZED_ENV_VARS).toContain(\\\"CLAUDE_CODE_SESSION\\\");\\n  1435→  });\\n  1436→});\\n  1437→\\n  1438→// ─── AC-7: Shadow commit on session end ──────────────────────────────────────\\n  1439→\\n  1440→// AC: @session-events ac-7\\n  1441→describe(\\\"Shadow commit on terminal invocation events\\\", () => {\\n  1442→  let testDir: string;\\n  1443→  let commitSpy: ReturnType<typeof vi.spyOn>;\\n  1444→\\n  1445→  beforeEach(async () => {\\n  1446→    testDir = await createTempDir(\\\"kspec-invoc-shadow-\\\");\\n  1447→    commitSpy = vi.spyOn(shadowModule, \\\"shadowAutoCommit\\\").mockResolvedValue(true);\\n  1448→  });\\n  1449→\\n  1450→  afterEach(async () => {\\n  1451→    commitSpy.mockRestore();\\n  1452→    await cleanupTempDir(testDir);\\n  1453→  });\\n  1454→\\n  1455→  it(\\\"should call shadowAutoCommit after successful invocation\\\", async () => {\\n  1456→    registerMockAdapter();\\n  1457→    const agent = makeTestAgent();\\n  1458→\\n  1459→    const result = await runInvocation({\\n  1460→      agent,\\n  1461→      specDir: testDir,\\n  1462→      cwd: process.cwd(),\\n  1463→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n  1464→      prompt: \\\"Shadow commit on success\\\",\\n  1465→      trigger: \\\"task.ready\\\",\\n  1466→    });\\n  1467→\\n  1468→    expect(result.outcome).toBe(\\\"success\\\");\\n  1469→    expect(commitSpy).toHaveBeenCalledWith(\\n  1470→      testDir,\\n  1471→      expect.stringContaining(\\\"completed\\\"),\\n  1472→    );\\n  1473→  });\\n  1474→\\n  1475→  it(\\\"should call shadowAutoCommit after timed-out invocation\\\", async () => {\\n  1476→    registerAdapter(\\\"slow-mock-acp-shadow\\\", {\\n  1477→      command: \\\"node\\\",\\n  1478→      args: [MOCK_ACP],\\n  1479→      env: {\\n  1480→        MOCK_ACP_DELAY_MS: \\\"5000\\\",\\n  1481→      },\\n  1482→      description: \\\"Slow mock for shadow commit timeout test\\\",\\n  1483→    });\\n  1484→    const agent = makeTestAgent({ adapter: \\\"slow-mock-acp-shadow\\\" });\\n  1485→\\n  1486→    const result = await runInvocation({\\n  1487→      agent,\\n  1488→      specDir: testDir,\\n  1489→      cwd: process.cwd(),\\n  1490→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n  1491→      prompt: \\\"Shadow commit on timeout\\\",\\n  1492→      trigger: \\\"task.ready\\\",\\n  1493→      timeoutMinutes: 0.001,\\n  1494→    });\\n  1495→\\n  1496→    expect(result.outcome).toBe(\\\"timed_out\\\");\\n  1497→    expect(commitSpy).toHaveBeenCalledWith(\\n  1498→      testDir,\\n  1499→      expect.stringContaining(\\\"timed_out\\\"),\\n  1500→    );\\n  1501→  });\\n  1502→\\n  1503→  it(\\\"should call shadowAutoCommit after failed invocation\\\", async () => {\\n  1504→    registerAdapter(\\\"failing-mock-acp-shadow\\\", {\\n  1505→      command: \\\"node\\\",\\n  1506→      args: [MOCK_ACP],\\n  1507→      env: {\\n  1508→        MOCK_ACP_EXIT_CODE: \\\"1\\\",\\n  1509→      },\\n  1510→      description: \\\"Failing mock for shadow commit test\\\",\\n  1511→    });\\n  1512→    const agent = makeTestAgent({ adapter: \\\"failing-mock-acp-shadow\\\" });\\n  1513→\\n  1514→    const result = await runInvocation({\\n  1515→      agent,\\n  1516→      specDir: testDir,\\n  1517→      cwd: process.cwd(),\\n  1518→      taskRef: \\\"@\\\" + testUlid(\\\"TASK\\\"),\\n  1519→      prompt: \\\"Shadow commit on failure\\\",\\n  1520→      trigge