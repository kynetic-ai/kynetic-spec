   327→describe('Core Skills Manifest Loading', () => {
   328→  it('should load core skills from templates/skills/manifest.yaml', async () => {
   329→    // Import the function for direct testing
   330→    const { loadCoreSkillsManifest } = await import('../src/cli/commands/skill.js');
   331→
   332→    const skills = await loadCoreSkillsManifest();
   333→
   334→    expect(skills.length).toBeGreaterThan(0);
   335→
   336→    const kspecHelp = skills.find((s) => s.id === 'help');
   337→    expect(kspecHelp).toBeDefined();
   338→    expect(kspecHelp?.name).toBe('Kspec Help');
   339→    expect(kspecHelp?.description).toContain('help');
   340→    expect(kspecHelp?.platforms).toContain('claude-code');
   341→    expect(kspecHelp?.platforms).toContain('codex');
   342→  });
   343→
   344→  it('should load SKILL.md content for core skills', async () => {
   345→    const { loadCoreSkillContent } = await import('../src/cli/commands/skill.js');
   346→
   347→    const content = await loadCoreSkillContent('help');
   348→
   349→    expect(content).not.toBeNull();
   350→    expect(content).toContain('# kspec Help');
   351→  });
   352→
   353→  it('should return null for non-existent skill content', async () => {
   354→    const { loadCoreSkillContent } = await import('../src/cli/commands/skill.js');
   355→
   356→    const content = await loadCoreSkillContent('non-existent-skill');
   357→
   358→    expect(content).toBeNull();
   359→  });
   360→
   361→  it('should return kspec package version', async () => {
   362→    const { getKspecPackageVersion } = await import('../src/cli/commands/skill.js');
   363→
   364→    const version = await getKspecPackageVersion();
   365→
   366→    expect(version).toBeDefined();
   367→    expect(version).not.toBe('unknown');
   368→    expect(version).toMatch(/^\d+\.\d+\.\d+/);
   369→  });
   370→});
