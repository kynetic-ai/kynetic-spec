     1→/**
     2→ * Tests for Core Skill Installation
     3→ * AC: @core-skill-install ac-1 through ac-5
     4→ */
     5→
     6→import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
     7→import * as fs from 'node:fs/promises';
     8→import * as path from 'node:path';
     9→import {
    10→  kspec as kspecFull,
    11→  kspecJson,
    12→  setupTempFixtures,
    13→  cleanupTempDir,
    14→  createTempDir,
    15→  initGitRepo,
    16→} from './helpers/cli';
    17→
    18→describe('Core Skill Installation', () => {
    19→  let tempDir: string;
    20→
    21→  beforeEach(async () => {
    22→    tempDir = await setupTempFixtures();
    23→    await initGitRepo(tempDir);
    24→  });
    25→
    26→  afterEach(async () => {
    27→    await cleanupTempDir(tempDir);
    28→  });
    29→
    30→  // AC: @core-skill-install ac-1
    31→  describe('ac-1: Meta entries created with origin core', () => {
    32→    it('should create skill meta entries with origin "core"', async () => {
    33→      const result = kspecFull('skill install-core', tempDir);
    34→      expect(result.exitCode).toBe(0);
    35→
    36→      // Check skill was created
    37→      const skills = kspecJson<{ id: string; origin: string; platforms: string[] }[]>('skill list', tempDir);
    38→      const coreSkill = skills.find((s) => s.id === 'help');
    39→
    40→      expect(coreSkill).toBeDefined();
    41→      expect(coreSkill?.origin).toBe('core');
    42→      expect(coreSkill?.platforms).toContain('claude-code');
    43→      expect(coreSkill?.platforms).toContain('codex');
    44→    });
    45→
    46→    it('should include "core" tag on installed skills', async () => {
    47→      kspecFull('skill install-core', tempDir);
    48→
    49→      const skills = kspecJson<{ id: string; tags?: string[] }[]>('skill list', tempDir);
    50→      const coreSkill = skills.find((s) => s.id === 'help');
    51→
    52→      expect(coreSkill?.tags).toContain('core');
    53→    });
    54→  });
    55→
    56→  // AC: @core-skill-install ac-2
    57→  describe('ac-2: Content files copied to .kspec/skills/<id>/', () => {
    58→    it('should copy SKILL.md content from templates', async () => {
    59→      kspecFull('skill install-core', tempDir);
    60→
    61→      // Note: In test fixtures (non-shadow mode), skills are at tempDir/skills/ not tempDir/.kspec/skills/
    62→      const skillMdPath = path.join(tempDir, 'skills', 'help', 'SKILL.md');
    63→      const content = await fs.readFile(skillMdPath, 'utf-8');
    64→
    65→      // Check content was copied (matches the template content)
    66→      expect(content).toContain('# kspec Help');
    67→      expect(content).toContain('Get help with kspec commands');
    68→    });
    69→
    70→    it('should create skill directory if it does not exist', async () => {
    71→      kspecFull('skill install-core', tempDir);
    72→
    73→      const skillDir = path.join(tempDir, 'skills', 'help');
    74→      const stat = await fs.stat(skillDir);
    75→      expect(stat.isDirectory()).toBe(true);
    76→    });
    77→
    78→    // AC: @core-skill-install ac-2
    79→    it('should copy supporting directories from templates', async () => {
    80→      kspecFull('skill install-core', tempDir);
    81→
    82→      // Triage skill has docs/ with inbox.md, observations.md, automation.md
    83→      const triageDocsDir = path.join(tempDir, 'skills', 'triage', 'docs');
    84→      const stat = await fs.stat(triageDocsDir);
    85→      expect(stat.isDirectory()).toBe(true);
    86→
    87→      const inboxMd = await fs.readFile(path.join(triageDocsDir, 'inbox.md'), 'utf-8');
    88→      expect(inboxMd).toContain('Inbox Triage');
    89→
    90→      const observationsMd = await fs.readFile(path.join(triageDocsDir, 'observations.md'), 'utf-8');
    91→      expect(observationsMd).toContain('Observations Triage');
    92→
    93→      const automationMd = await fs.readFile(path.join(triageDocsDir, 'automation.md'), 'utf-8');
    94→      expect(automationMd).toContain('Automation Triage');
    95→    });
    96→  });
    97→
    98→  // AC: @core-skill-install ac-3
    99→  describe('ac-3: Custom skills skipped with message', () => {
   100→    it('should skip existing custom/project origin skills', async () => {
   101→      // First create a custom skill with the same ID
   102→      kspecFull(
   103→        'skill add --id help --name "My Custom Help" --description "Custom version" --origin project',
   104→        tempDir
   105→      );
   106→
   107→      // Try to install core skills
   108→      const result = kspecFull('skill install-core', tempDir);
   109→      expect(result.stdout).toContain('Skipped');
   110→      expect(result.stdout).toContain('help');
   111→      expect(result.stdout).toContain('use --force to overwrite');
   112→
   113→      // Verify the skill still has project origin
   114→      const skills = kspecJson<{ id: string; origin: string }[]>('skill list', tempDir);
   115→      const helpSkill = skills.find((s) => s.id === 'help');
   116→      expect(helpSkill?.origin).toBe('project');
   117→    });
   118→
   119→    it('should update existing core origin skills', async () => {
   120→      // First install core skills
   121→      kspecFull('skill install-core', tempDir);
   122→
   123→      // Install again - should update (not skip)
   124→      const result = kspecFull('skill install-core', tempDir);
   125→
   126→      // It should be "Updated" not "Skipped"
   127→      expect(result.stdout).toContain('Updated');
   128→      expect(result.stdout).toContain('help');
   129→    });
   130→  });
   131→
   132→  // AC: @core-skill-install ac-4
   133→  describe('ac-4: --force overwrites custom forks', () => {
   134→    it('should overwrite custom skills when --force is used', async () => {
   135→      // First create a custom skill
   136→      kspecFull(
   137→        'skill add --id help --name "My Custom Help" --description "Custom version" --origin project',
   138→        tempDir
   139→      );
   140→
   141→      // Verify it's project origin
   142→      let skills = kspecJson<{ id: string; origin: string }[]>('skill list', tempDir);
   143→      expect(skills.find((s) => s.id === 'help')?.origin).toBe('project');
   144→
   145→      // Install with --force
   146→      const result = kspecFull('skill install-core --force', tempDir);
   147→      expect(result.stdout).toContain('Updated');
   148→      expect(result.stdout).toContain('help');
   149→
   150→      // Verify it's now core origin
   151→      skills = kspecJson<{ id: string; origin: string }[]>('skill list', tempDir);
   152→      expect(skills.find((s) => s.id === 'help')?.origin).toBe('core');
   153→    });
   154→
   155→    it('should update SKILL.md content when --force is used', async () => {
   156→      // Create custom skill with custom content
   157→      kspecFull(
   158→        'skill add --id help --name "My Custom Help" --description "Custom version" --origin project',
   159→        tempDir
   160→      );
   161→
   162→      const skillMdPath = path.join(tempDir, 'skills', 'help', 'SKILL.md');
   163→      await fs.writeFile(skillMdPath, '# Custom Content\n\nThis is my custom content.\n', 'utf-8');
   164→
   165→      // Install with --force
   166→      kspecFull('skill install-core --force', tempDir);
   167→
   168→      // Verify content was overwritten with core content
   169→      const content = await fs.readFile(skillMdPath, 'utf-8');
   170→      expect(content).toContain('# kspec Help');
   171→      expect(content).not.toContain('Custom Content');
   172→    });
   173→  });
   174→
   175→  // AC: @core-skill-install ac-5
   176→  describe('ac-5: Version matches kspec package version', () => {
   177→    it('should set skill version to kspec package version', async () => {
   178→      kspecFull('skill install-core', tempDir);
   179→
   180→      const skills = kspecJson<{ id: string; version?: string }[]>('skill list', tempDir);
   181→      const coreSkill = skills.find((s) => s.id === 'help');
   182→
   183→      expect(coreSkill?.version).toBeDefined();
   184→      // Version should be a semver-like string (e.g., "0.1.2")
   185→      expect(coreSkill?.version).toMatch(/^\d+\.\d+\.\d+/);
   186→    });
   187→
   188→    it('should show version in install output', async () => {
   189→      const result = kspecFull('skill install-core', tempDir);
   190→
   191→      // Should show "(vX.Y.Z)" in output
   192→      expect(result.stdout).toMatch(/\(v\d+\.\d+\.\d+\)/);
   193→    });
   194→  });
   195→
   196→  // Dry run support
   197→  describe('dry-run support', () => {
   198→    it('should not make changes with --dry-run', async () => {
   199→      const result = kspecFull('skill install-core --dry-run', tempDir);
   200→
   201→      expect(result.stdout).toContain('DRY RUN');
   202→      expect(result.stdout).toContain('No changes were made');
   203→
   204→      // Verify skill was NOT created
   205→      const skills = kspecJson<{ id: string }[]>('skill list', tempDir);
   206→      const coreSkill = skills.find((s) => s.id === 'help');
   207→      expect(coreSkill).toBeUndefined();
   208→    });
   209→
   210→    it('should show what would be installed with --dry-run', async () => {
   211→      const result = kspecFull('skill install-core --dry-run', tempDir);
   212→
   213→      expect(result.stdout).toMatch(/Created: \d+ skill\(s\)/);
   214→      expect(result.stdout).toContain('help');
   215→      expect(result.stdout).toContain('triage');
   216→    });
   217→  });
   218→
   219→  // JSON output support
   220→  describe('JSON output', () => {
   221→    it('should return JSON with results array', async () => {
   222→      const result = kspecJson<{ results: { id: string; action: string }[] }>(
   223→        'skill install-core',
   224→        tempDir
   225→      );
   226→
   227→      expect(result.results).toBeDefined();
   228→      expect(Array.isArray(result.results)).toBe(true);
   229→      expect(result.results.length).toBeGreaterThan(0);
   230→
   231→      const kspecHelp = result.results.find((r) => r.id === 'help');
   232→      expect(kspecHelp).toBeDefined();
   233→      expect(kspecHelp?.action).toBe('created');
   234→    });
   235→
   236→    it('should include dry_run field in JSON output', async () => {
   237→      const result = kspecJson<{ dry_run: boolean; results: unknown[] }>(
   238→        'skill install-core --dry-run',
   239→        tempDir
   240→      );
   241→
   242→      expect(result.dry_run).toBe(true);
   243→    });
   244→  });
   245→
   246→  describe('codex render path', () => {
   247→    it('should render core skills to .agents/skills/kspec-*/ after install-core', async () => {
   248→      kspecFull('skill install-core', tempDir, {
   249→        env: { CLAUDECODE: '1', CODEX_THREAD_ID: '', HOME: tempDir },
   250→      });
   251→
   252→      const renderResult = kspecJson<{
   253→        rendered: Array<{
   254→          id: string;
   255→          platform: string;
   256→          action: string;
   257→          skipCode?: string;
   258→        }>;
   259→      }>('skill render', tempDir);
   260→
   261→      const codexHelp = renderResult.rendered.find(
   262→        (r) => r.id === 'help' && r.platform === 'codex'
   263→      );
   264→      expect(codexHelp).toBeDefined();
   265→      expect(codexHelp?.action).toBe('created');
   266→
   267→      const codexPath = path.join(tempDir, '.agents', 'skills', 'kspec-help', 'SKILL.md');
   268→      const codexContent = await fs.readFile(codexPath, 'utf-8');
   269→      expect(codexContent).toContain('<!-- kspec-managed -->');
   270→      expect(codexContent).toContain('name: kspec-help');
   271→
   272→      const claudeHelp = renderResult.rendered.find(
   273→        (r) => r.id === 'help' && r.platform === 'claude-code'
   274→      );
   275→      expect(claudeHelp?.action).toBe('skipped');
   276→      expect(claudeHelp?.skipCode).toBe('plugin-provided');
   277→    });
   278→
   279→    // AC: @new-project-bootstrapping ac-3
   280→    it('should auto-detect codex platform when CODEX_THREAD_ID is present', async () => {
   281→      const result = kspecJson<{
   282→        render: { platform: string; source: string };
   283→      }>('skill install-core', tempDir, {
   284→        env: { CODEX_THREAD_ID: 'test-thread-123', CLAUDECODE: '', HOME: tempDir },
   285→      });
   286→
   287→      expect(result.render.platform).toBe('codex');
   288→      expect(result.render.source).toBe('auto-detect');
   289→
   290→      const codexPath = path.join(tempDir, '.agents', 'skills', 'kspec-help', 'SKILL.md');
   291→      const codexContent = await fs.readFile(codexPath, 'utf-8');
   292→      expect(codexContent).toContain('<!-- kspec-managed -->');
   293→      expect(codexContent).toContain('name: kspec-help');
   294→
   295→      const codexConfigPath = path.join(tempDir, '.codex', 'config.toml');
   296→      const codexConfig = await fs.readFile(codexConfigPath, 'utf-8');
   297→      expect(codexConfig).toContain('project_doc_fallback_filenames');
   298→      expect(codexConfig).toContain('kspec-agents.md');
   299→    });
   300→
   301→    // AC: @new-project-bootstrapping ac-3
   302→    it('should force codex render path with --platform codex even in claude env', async () => {
   303→      const result = kspecJson<{
   304→        render: { platform: string; source: string };
   305→      }>('skill install-core --platform codex', tempDir, {
   306→        env: { CLAUDECODE: '1', CODEX_THREAD_ID: '', HOME: tempDir },
   307→      });
   308→
   309→      expect(result.render.platform).toBe('codex');
   310→      expect(result.render.source).toBe('override');
   311→
   312→      const codexPath = path.join(tempDir, '.agents', 'skills', 'kspec-help', 'SKILL.md');
   313→      await expect(fs.access(codexPath)).resolves.toBeUndefined();
   314→
   315→      const codexConfigPath = path.join(tempDir, '.codex', 'config.toml');
   316→      const codexConfig = await fs.readFile(codexConfigPath, 'utf-8');
   317→      expect(codexConfig).toContain('project_doc_fallback_filenames');
   318→      expect(codexConfig).toContain('kspec-agents.md');
   319→
   320→      // No local claude core render path (still plugin-provided)
   321→      const claudePath = path.join(tempDir, '.claude', 'skills', 'help', 'SKILL.md');
   322→      await expect(fs.access(claudePath)).rejects.toThrow();
   323→    });
   324→  });
   325→});
