   372→// AC: @core-skill-install ac-2
   373→describe('copyCoreSkillFiles error handling', () => {
   374→  let tempDir: string;
   375→
   376→  beforeEach(async () => {
   377→    tempDir = await createTempDir();
   378→  });
   379→
   380→  afterEach(async () => {
   381→    await cleanupTempDir(tempDir);
   382→  });
   383→
   384→  it('should silently skip when skill template does not exist (ENOENT)', async () => {
   385→    const { copyCoreSkillFiles } = await import('../src/cli/commands/skill.js');
   386→    const targetDir = path.join(tempDir, 'skills', 'nonexistent');
   387→
   388→    // Should not throw and report no changes
   389→    const result = await copyCoreSkillFiles('nonexistent-skill-id', targetDir);
   390→    expect(result.changed).toBe(false);
   391→
   392→    // Target dir should not have been created
   393→    await expect(fs.access(targetDir)).rejects.toThrow();
   394→  });
   395→
   396→  it('should copy known core skill with supporting dirs', async () => {
   397→    const { copyCoreSkillFiles } = await import('../src/cli/commands/skill.js');
   398→    const targetDir = path.join(tempDir, 'skills', 'triage');
   399→
   400→    const result = await copyCoreSkillFiles('triage', targetDir);
   401→    expect(result.changed).toBe(true);
   402→
   403→    // SKILL.md copied
   404→    const skillMd = await fs.readFile(path.join(targetDir, 'SKILL.md'), 'utf-8');
   405→    expect(skillMd).toContain('# Triage');
   406→
   407→    // docs/ copied
   408→    const inboxMd = await fs.readFile(path.join(targetDir, 'docs', 'inbox.md'), 'utf-8');
   409→    expect(inboxMd).toContain('Inbox Triage');
   410→  });
   411→
   412→  it('should skip writing when content is unchanged (idempotent)', async () => {
   413→    const { copyCoreSkillFiles } = await import('../src/cli/commands/skill.js');
   414→    const targetDir = path.join(tempDir, 'skills', 'triage');
   415→
   416→    // First copy — should report changed
   417→    const first = await copyCoreSkillFiles('triage', targetDir);
   418→    expect(first.changed).toBe(true);
   419→
   420→    // Second copy with same content — should report unchanged
   421→    const second = await copyCoreSkillFiles('triage', targetDir);
   422→    expect(second.changed).toBe(false);
   423→  });
   424→});
