     1→import * as fs from "node:fs/promises";
     2→import * as os from "node:os";
     3→import * as path from "node:path";
     4→import { execSync } from "node:child_process";
     5→import { afterEach, beforeEach, describe, expect, it } from "vitest";
     6→import {
     7→  applyAutoAbandonMetadata,
     8→  appendEvent,
     9→  createSession,
    10→  getSession,
    11→  getSessionEventsPath,
    12→  resolveStaleSessionCriteria,
    13→  selectStaleActiveSessions,
    14→} from "../src/sessions/store.js";
    15→
    16→describe("stale session criteria", () => {
    17→  let specDir: string;
    18→  const nowIso = "2026-02-28T00:00:00.000Z";
    19→  const nowMs = new Date(nowIso).getTime();
    20→
    21→  beforeEach(async () => {
    22→    specDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-stale-session-"));
    23→  });
    24→
    25→  afterEach(async () => {
    26→    await fs.rm(specDir, { recursive: true, force: true });
    27→  });
    28→
    29→  // AC: @session-stale-criteria ac-5
    30→  it("applies default thresholds when none are provided", () => {
    31→    const resolved = resolveStaleSessionCriteria({});
    32→    expect(resolved.ok).toBe(true);
    33→    if (!resolved.ok) return;
    34→    expect(resolved.criteria.olderThan).toBe("24h");
    35→    expect(resolved.criteria.inactiveFor).toBe("6h");
    36→    expect(resolved.criteria.livenessGuard).toBe("5m");
    37→  });
    38→
    39→  // AC: @session-stale-criteria ac-4
    40→  it("rejects invalid relative duration with usage guidance", () => {
    41→    const resolved = resolveStaleSessionCriteria({ olderThan: "abc" });
    42→    expect(resolved.ok).toBe(false);
    43→    if (resolved.ok) return;
    44→    expect(resolved.field).toBe("older-than");
    45→    expect(resolved.guidance).toContain("relative durations only");
    46→    expect(resolved.guidance).toContain("6h, 7d, 2w, 1m");
    47→  });
    48→
    49→  // AC: @session-stale-criteria ac-6
    50→  it("rejects absolute timestamps for criteria flags", () => {
    51→    const resolved = resolveStaleSessionCriteria({
    52→      inactiveFor: "2026-02-27T12:00:00Z",
    53→    });
    54→    expect(resolved.ok).toBe(false);
    55→    if (resolved.ok) return;
    56→    expect(resolved.field).toBe("inactive-for");
    57→    expect(resolved.message).toContain("absolute timestamps are not supported");
    58→    expect(resolved.guidance).toContain("relative durations only");
    59→  });
    60→
    61→  // AC: @session-stale-criteria ac-1
    62→  it("marks session eligible when age and inactivity thresholds both match", async () => {
    63→    const sessionId = "01KJHSTAL3CR1T3R1A0000001";
    64→    await createSession(specDir, {
    65→      id: sessionId,
    66→      agent_type: "ralph",
    67→      status: "active",
    68→      started_at: "2026-02-26T00:00:00.000Z",
    69→    });
    70→    await appendEvent(specDir, {
    71→      session_id: sessionId,
    72→      type: "session.update",
    73→      ts: new Date("2026-02-27T12:00:00.000Z").getTime(),
    74→      data: { update: "idle" },
    75→    });
    76→
    77→    const result = await selectStaleActiveSessions(
    78→      specDir,
    79→      { olderThan: "24h", inactiveFor: "6h" },
    80→      nowMs,
    81→    );
    82→    expect(result.candidates).toHaveLength(1);
    83→    expect(result.candidates[0].sessionId).toBe(sessionId);
    84→  });
    85→
    86→  // AC: @session-stale-criteria ac-2
    87→  it("uses started_at as last-activity fallback when events are missing", async () => {
    88→    const sessionId = "01KJHSTAL3CR1T3R1A0000002";
    89→    await createSession(specDir, {
    90→      id: sessionId,
    91→      agent_type: "ralph",
    92→      status: "active",
    93→      started_at: "2026-02-26T12:00:00.000Z",
    94→    });
    95→
    96→    const result = await selectStaleActiveSessions(
    97→      specDir,
    98→      { olderThan: "24h", inactiveFor: "6h" },
    99→      nowMs,
   100→    );
   101→    expect(result.candidates).toHaveLength(1);
   102→    expect(result.candidates[0].lastActivitySource).toBe("started_at");
   103→    expect(result.candidates[0].sessionId).toBe(sessionId);
   104→  });
   105→
   106→  // AC: @session-stale-criteria ac-3
   107→  it("applies older-than and inactive-for with AND logic", async () => {
   108→    const sessionId = "01KJHSTAL3CR1T3R1A0000003";
   109→    await createSession(specDir, {
   110→      id: sessionId,
   111→      agent_type: "ralph",
   112→      status: "active",
   113→      started_at: "2026-02-24T00:00:00.000Z",
   114→    });
   115→    await appendEvent(specDir, {
   116→      session_id: sessionId,
   117→      type: "session.update",
   118→      ts: new Date("2026-02-27T21:00:00.000Z").getTime(),
   119→      data: { update: "recent-ish" },
   120→    });
   121→
   122→    const result = await selectStaleActiveSessions(
   123→      specDir,
   124→      { olderThan: "24h", inactiveFor: "6h" },
   125→      nowMs,
   126→    );
   127→    expect(result.evaluations).toHaveLength(1);
   128→    expect(result.evaluations[0].meetsAgeThreshold).toBe(true);
   129→    expect(result.evaluations[0].meetsInactivityThreshold).toBe(false);
   130→    expect(result.candidates).toHaveLength(0);
   131→  });
   132→
   133→  // AC: @session-stale-criteria ac-7
   134→  it("skips and reports sessions with corrupt events.jsonl", async () => {
   135→    const sessionId = "01KJHSTAL3CR1T3R1A0000004";
   136→    await createSession(specDir, {
   137→      id: sessionId,
   138→      agent_type: "ralph",
   139→      status: "active",
   140→      started_at: "2026-02-24T00:00:00.000Z",
   141→    });
   142→    await fs.writeFile(
   143→      getSessionEventsPath(specDir, sessionId),
   144→      '{"ts":1700000000000,"seq":0,"type":"session.update","session_id":"x","data":{}}\n{not-json}\n',
   145→      "utf-8",
   146→    );
   147→
   148→    const result = await selectStaleActiveSessions(
   149→      specDir,
   150→      { olderThan: "24h", inactiveFor: "6h" },
   151→      nowMs,
   152→    );
   153→    expect(result.candidates).toHaveLength(0);
   154→    expect(result.skippedCount).toBe(1);
   155→    expect(result.failureCount).toBe(1);
   156→    expect(result.skipped[0].sessionId).toBe(sessionId);
   157→    expect(result.skipped[0].reason).toBe("events_corrupt");
   158→    expect(result.skipped[0].detail).toContain("invalid line 2");
   159→  });
   160→
   161→  // AC: @session-stale-criteria ac-7
   162→  it("skips and reports sessions with unreadable events.jsonl", async () => {
   163→    const sessionId = "01KJHSTAL3CR1T3R1A000000A";
   164→    await createSession(specDir, {
   165→      id: sessionId,
   166→      agent_type: "ralph",
   167→      status: "active",
   168→      started_at: "2026-02-24T00:00:00.000Z",
   169→    });
   170→    await fs.mkdir(getSessionEventsPath(specDir, sessionId), {
   171→      recursive: true,
   172→    });
   173→
   174→    const result = await selectStaleActiveSessions(
   175→      specDir,
   176→      { olderThan: "24h", inactiveFor: "6h" },
   177→      nowMs,
   178→    );
   179→    expect(result.candidates).toHaveLength(0);
   180→    expect(result.skippedCount).toBe(1);
   181→    expect(result.failureCount).toBe(1);
   182→    expect(result.skipped[0].sessionId).toBe(sessionId);
   183→    expect(result.skipped[0].reason).toBe("events_unreadable");
   184→    expect(result.skipped[0].detail).toContain("Unable to read events.jsonl");
   185→    expect(result.skipped[0].detail).toContain(sessionId);
   186→  });
   187→
   188→  // AC: @session-stale-criteria ac-8
   189→  it("blocks closure when session has recent activity inside liveness guard window", async () => {
   190→    const sessionId = "01KJHSTAL3CR1T3R1A0000005";
   191→    await createSession(specDir, {
   192→      id: sessionId,
   193→      agent_type: "ralph",
   194→      status: "active",
   195→      started_at: "2026-02-20T00:00:00.000Z",
   196→    });
   197→    await appendEvent(specDir, {
   198→      session_id: sessionId,
   199→      type: "session.update",
   200→      ts: new Date("2026-02-27T23:58:00.000Z").getTime(),
   201→      data: { update: "very recent" },
   202→    });
   203→
   204→    const result = await selectStaleActiveSessions(
   205→      specDir,
   206→      { olderThan: "24h", inactiveFor: "1m" },
   207→      nowMs,
   208→    );
   209→    expect(result.evaluations).toHaveLength(1);
   210→    expect(result.evaluations[0].meetsAgeThreshold).toBe(true);
   211→    expect(result.evaluations[0].meetsInactivityThreshold).toBe(true);
   212→    expect(result.evaluations[0].blockedByLivenessGuard).toBe(true);
   213→    expect(result.candidates).toHaveLength(0);
   214→  });
