   392→    expect(applied.updates[0].closeReason).toContain("older-than=24h");
   393→
   394→    expect(after?.status).toBe(before?.status);
   395→    expect(after?.ended_at).toBe(before?.ended_at);
   396→    expect(after?.close_reason).toBe(before?.close_reason);
   397→  });
   398→});
