   216→  // AC: @session-stale-close-metadata ac-1
   217→  // AC: @session-stale-close-metadata ac-2
   218→  it("writes abandoned status with canonical auto-abandoned close_reason", async () => {
   219→    const sessionId = "01KJHSTAL3CR1T3R1A0000006";
   220→    await createSession(specDir, {
   221→      id: sessionId,
   222→      agent_type: "ralph",
   223→      status: "active",
   224→      started_at: "2026-02-20T00:00:00.000Z",
   225→    });
   226→    await appendEvent(specDir, {
   227→      session_id: sessionId,
   228→      type: "session.update",
   229→      ts: new Date("2026-02-27T12:00:00.000Z").getTime(),
   230→      data: { update: "idle" },
   231→    });
   232→
   233→    const selection = await selectStaleActiveSessions(
   234→      specDir,
   235→      { olderThan: "24h", inactiveFor: "6h" },
   236→      nowMs,
   237→    );
   238→    const applied = await applyAutoAbandonMetadata(specDir, selection, {
   239→      nowMs,
   240→    });
   241→
   242→    expect(applied.updatedCount).toBe(1);
   243→    const updated = await getSession(specDir, sessionId);
   244→    expect(updated?.status).toBe("abandoned");
   245→    expect(updated?.ended_at).toBe(nowIso);
   246→    expect(updated?.close_reason?.startsWith("auto-abandoned:")).toBe(true);
   247→    expect(updated?.close_reason).toContain("older-than=24h");
   248→    expect(updated?.close_reason).toContain("inactive-for=6h");
   249→    expect(updated?.close_reason).toContain("liveness-guard=5m");
   250→    expect(updated?.close_reason).toContain("last-activity=2026-02-27T12:00:00.000Z");
   251→  });
   252→
   253→  // AC: @session-stale-close-metadata ac-3
   254→  it("applies batch metadata updates for multiple sessions in one invocation", async () => {
   255→    const sessionA = "01KJHSTAL3CR1T3R1A0000007";
   256→    const sessionB = "01KJHSTAL3CR1T3R1A0000008";
   257→    await createSession(specDir, {
   258→      id: sessionA,
   259→      agent_type: "ralph",
   260→      status: "active",
   261→      started_at: "2026-02-20T00:00:00.000Z",
   262→    });
   263→    await createSession(specDir, {
   264→      id: sessionB,
   265→      agent_type: "ralph",
   266→      status: "active",
   267→      started_at: "2026-02-19T00:00:00.000Z",
   268→    });
   269→
   270→    const selection = await selectStaleActiveSessions(
   271→      specDir,
   272→      { olderThan: "24h", inactiveFor: "6h" },
   273→      nowMs,
   274→    );
   275→    const applied = await applyAutoAbandonMetadata(specDir, selection, {
   276→      nowMs,
   277→    });
   278→
   279→    expect(applied.updatedCount).toBe(2);
   280→    expect(applied.updates).toHaveLength(2);
   281→    expect(applied.updates[0].endedAt).toBe(nowIso);
   282→    expect(applied.updates[1].endedAt).toBe(nowIso);
   283→    expect(applied.updates[0].closeReason.startsWith("auto-abandoned:")).toBe(true);
   284→    expect(applied.updates[1].closeReason.startsWith("auto-abandoned:")).toBe(true);
   285→
   286→    const updatedA = await getSession(specDir, sessionA);
   287→    const updatedB = await getSession(specDir, sessionB);
   288→    expect(updatedA?.status).toBe("abandoned");
   289→    expect(updatedB?.status).toBe("abandoned");
   290→    expect(updatedA?.ended_at).toBe(nowIso);
   291→    expect(updatedB?.ended_at).toBe(nowIso);
   292→  });
