   294→  // AC: @session-stale-close-metadata ac-3
   295→  it("records one shadow commit with command-specific message for multi-session close", async () => {
   296→    execSync("git init", { cwd: specDir, stdio: "pipe" });
   297→    execSync('git config user.name "Test User"', { cwd: specDir, stdio: "pipe" });
   298→    execSync('git config user.email "test@example.com"', {
   299→      cwd: specDir,
   300→      stdio: "pipe",
   301→    });
   302→
   303→    const sessionA = "01KJHSTAL3CR1T3R1A000000B";
   304→    const sessionB = "01KJHSTAL3CR1T3R1A000000C";
   305→    await createSession(specDir, {
   306→      id: sessionA,
   307→      agent_type: "ralph",
   308→      status: "active",
   309→      started_at: "2026-02-20T00:00:00.000Z",
   310→    });
   311→    await createSession(specDir, {
   312→      id: sessionB,
   313→      agent_type: "ralph",
   314→      status: "active",
   315→      started_at: "2026-02-19T00:00:00.000Z",
   316→    });
   317→
   318→    execSync("git add -A", { cwd: specDir, stdio: "pipe" });
   319→    execSync('git commit -m "test: seed sessions"', {
   320→      cwd: specDir,
   321→      stdio: "pipe",
   322→      env: { ...process.env, KSPEC_SHADOW_COMMIT: "1" },
   323→    });
   324→    const beforeCount = Number.parseInt(
   325→      execSync("git rev-list --count HEAD", {
   326→        cwd: specDir,
   327→        encoding: "utf-8",
   328→      }).trim(),
   329→      10,
   330→    );
   331→
   332→    const selection = await selectStaleActiveSessions(
   333→      specDir,
   334→      { olderThan: "24h", inactiveFor: "6h" },
   335→      nowMs,
   336→    );
   337→    const commitMessage = "session stale close auto-abandoned metadata";
   338→    const applied = await applyAutoAbandonMetadata(specDir, selection, {
   339→      nowMs,
   340→      shadowCommitMessage: commitMessage,
   341→    });
   342→
   343→    const afterCount = Number.parseInt(
   344→      execSync("git rev-list --count HEAD", {
   345→        cwd: specDir,
   346→        encoding: "utf-8",
   347→      }).trim(),
   348→      10,
   349→    );
   350→    const lastMessage = execSync("git log -1 --pretty=%s", {
   351→      cwd: specDir,
   352→      encoding: "utf-8",
   353→    }).trim();
   354→
   355→    expect(applied.updatedCount).toBe(2);
   356→    expect(applied.shadowCommitted).toBe(true);
   357→    expect(afterCount - beforeCount).toBe(1);
   358→    expect(lastMessage).toBe(commitMessage);
   359→  });
