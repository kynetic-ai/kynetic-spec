   402→// ─── CLI Integration Tests ──────────────────────────────────────────────────
   403→
   404→describe('kspec session log show (CLI)', () => {
   405→  let tempDir: string;
   406→  const sessionId1 = testUlid('SESS', 1);
   407→  const sessionId2 = testUlid('SESS', 2);
   408→
   409→  beforeEach(async () => {
   410→    tempDir = await setupTempFixtures();
   411→
   412→    // In traditional mode (no shadow branch), specDir = tempDir
   413→    const sessionsDir = path.join(tempDir, 'sessions');
   414→    await fs.mkdir(sessionsDir, { recursive: true });
   415→
   416→    // Session 1: completed with events and context
   417→    const s1Dir = path.join(sessionsDir, sessionId1);
   418→    await fs.mkdir(s1Dir);
   419→    await fs.writeFile(path.join(s1Dir, 'session.yaml'), YAML.stringify({
   420→      id: sessionId1,
   421→      agent_type: 'claude-agent-acp',
   422→      task_id: '@my-task',
   423→      status: 'completed',
   424→      started_at: '2026-01-15T10:00:00.000Z',
   425→      ended_at: '2026-01-15T11:30:00.000Z',
   426→    }));
   427→    const blobRelPath = 'blobs/session-show-output.blob';
   428→    const blobContent = 'FULL_BLOB_CONTENT_FOR_SHOW_RESOLUTION';
   429→    await fs.mkdir(path.join(s1Dir, 'blobs'), { recursive: true });
   430→    await fs.writeFile(path.join(s1Dir, blobRelPath), blobContent, 'utf-8');
   431→    await fs.writeFile(path.join(s1Dir, 'events.jsonl'), [
   432→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: sessionId1, data: { iteration: 1 } }),
   433→      JSON.stringify({
   434→        ts: 2000, seq: 1, type: 'session.update', session_id: sessionId1,
   435→        data: {
   436→          iteration: 1,
   437→          update: {
   438→            _meta: { claudeCode: { toolName: 'Bash' } },
   439→            sessionUpdate: 'tool_call',
   440→            rawInput: { command: 'kspec task start @my-task' },
   441→          },
   442→        },
   443→      }),
   444→      JSON.stringify({ ts: 3000, seq: 2, type: 'prompt.sent', session_id: sessionId1, data: { phase: 'task-work', iteration: 1, prompt: 'Continue the task' } }),
   445→      JSON.stringify({ ts: 4000, seq: 3, type: 'tool.call', session_id: sessionId1, data: { iteration: 1, tool: 'Read' } }),
   446→      JSON.stringify({
   447→        ts: 4500,
   448→        seq: 4,
   449→        type: 'tool.result',
   450→        session_id: sessionId1,
   451→        data: {
   452→          output: {
   453→            path: blobRelPath,
   454→            bytes: blobContent.length,
   455→            sha256: 'test-hash',
   456→            truncated: true,
   457→            preview: 'PREVIEW_ONLY_SHOW',
   458→          },
   459→        },
   460→      }),
   461→      JSON.stringify({ ts: 5000, seq: 5, type: 'session.end', session_id: sessionId1, data: { reason: 'completed' } }),
   462→    ].join('\n') + '\n');
