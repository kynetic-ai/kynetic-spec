   909→  // AC: @trait-semantic-exit-codes ac-2
   910→  // Note: Trait says "exit code 1" but kspec uses a richer exit code scheme
   911→  // (EXIT_CODES in src/cli/exit-codes.ts). Validation errors map to
   912→  // VALIDATION_FAILED (4). This is consistent with other commands (e.g. cli-serve.test.ts).
   913→  it('should exit with VALIDATION_FAILED (4) for ambiguous prefix', async () => {
   914→    const ambig1 = '01XTEST0000000000000000001';
   915→    const ambig2 = '01XTEST0000000000000000002';
   916→    const sessionsDir = path.join(tempDir, 'sessions');
   917→
   918→    const a1Dir = path.join(sessionsDir, ambig1);
   919→    await fs.mkdir(a1Dir);
   920→    await fs.writeFile(path.join(a1Dir, 'session.yaml'), YAML.stringify({
   921→      id: ambig1, agent_type: 'test', status: 'active', started_at: '2026-01-01T00:00:00.000Z',
   922→    }));
   923→    const a2Dir = path.join(sessionsDir, ambig2);
   924→    await fs.mkdir(a2Dir);
   925→    await fs.writeFile(path.join(a2Dir, 'session.yaml'), YAML.stringify({
   926→      id: ambig2, agent_type: 'test', status: 'active', started_at: '2026-01-01T00:00:00.000Z',
   927→    }));
   928→
   929→    const result = kspec('session log show 01XTEST', tempDir, { expectFail: true });
   930→    expect(result.exitCode).toBe(4); // VALIDATION_FAILED
   931→  });
