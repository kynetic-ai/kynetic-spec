  1038→
  1039→// ─── AC-9: Retry threshold and task blocking ──────────────────────────────────
  1040→
  1041→// AC: @agent-invocation-lifecycle ac-9
  1042→describe("Consecutive failure threshold and task blocking", () => {
  1043→  let testDir: string;
  1044→
  1045→  beforeEach(async () => {
  1046→    testDir = await createTempDir("kspec-invoc-ac9-");
  1047→    registerAdapter("always-fail-acp", {
  1048→      command: "node",
  1049→      args: [MOCK_ACP],
  1050→      env: { MOCK_ACP_EXIT_CODE: "1" },
  1051→      description: "Always-failing adapter for retry threshold tests",
  1052→    });
  1053→  });
  1054→
  1055→  afterEach(async () => {
  1056→    await cleanupTempDir(testDir);
  1057→  });
  1058→
  1059→  it("should block the task with a failure note when consecutive failures reach retry limit", async () => {
  1060→    // AC: @agent-invocation-lifecycle ac-9 — consecutive failures → task blocked with note
  1061→    // The agent's retry limit is derived from agent.budget.max_retries (default 3).
  1062→    // We pre-populate the capture file to simulate prior failure notes already recorded
  1063→    // by previous invocations, then trigger the threshold-crossing invocation.
  1064→    const captureFile = path.join(testDir, "kspec-calls.json");
  1065→    const taskRef = "@" + testUlid("TASK");
  1066→
  1067→    // Mock kspec CLI: simulate "task get" returning a task with 3 existing AGENT-FAIL notes.
  1068→    // The implementation calls getConsecutiveFailureCount (kspec task get --json) to read
  1069→    // the note history. With 3 consecutive AGENT-FAIL notes and a retry limit of 3, blocking
  1070→    // must be triggered.
  1071→    const taskGetMockPath = path.join(testDir, "kspec-threshold-mock.cjs");
  1072→    const mockTask = {
  1073→      notes: [
  1074→        { content: "[AGENT-FAIL] Invocation failed: Mock failure" },
  1075→        { content: "[AGENT-FAIL] Invocation failed: Mock failure" },
  1076→        { content: "[AGENT-FAIL] Invocation failed: Mock failure" },
  1077→      ],
  1078→    };
  1079→    await fs.writeFile(taskGetMockPath, `#!/usr/bin/env node
  1080→'use strict';
  1081→const fs = require('node:fs');
  1082→const args = process.argv.slice(2);
  1083→const captureFile = process.env.KSPEC_CAPTURE_FILE;
  1084→
  1085→if (captureFile) {
  1086→  let calls = [];
  1087→  try { calls = JSON.parse(fs.readFileSync(captureFile, 'utf-8')); } catch {}
  1088→  calls.push({ args, timestamp: Date.now() });
  1089→  fs.writeFileSync(captureFile, JSON.stringify(calls, null, 2));
  1090→}
  1091→
  1092→// Return task JSON for "task get ... --json" to simulate 3 consecutive prior failures
  1093→if (args.includes('task') && args.includes('get') && args.includes('--json')) {
  1094→  process.stdout.write(JSON.stringify(${JSON.stringify(mockTask)}) + '\\n');
  1095→}
  1096→
  1097→process.exit(0);
  1098→`);
  1099→
  1100→    process.env.KSPEC_CAPTURE_FILE = captureFile;
  1101→    try {
  1102→      const agent = makeTestAgent({
  1103→        adapter: "always-fail-acp",
  1104→        budget: { max_retries: 3, timeout_minutes: 30 },
  1105→      } as Partial<Agent>);
  1106→
  1107→      await runInvocation({
  1108→        agent,
  1109→        specDir: testDir,
  1110→        cwd: process.cwd(),
  1111→        taskRef,
