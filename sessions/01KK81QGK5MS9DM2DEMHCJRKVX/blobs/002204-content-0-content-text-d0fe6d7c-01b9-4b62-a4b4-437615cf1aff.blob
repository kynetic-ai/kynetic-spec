     1→/**
     2→ * Agent Invocation Lifecycle tests.
     3→ *
     4→ * Tests for per-invocation session creation, ACP agent spawn, prompt delivery,
     5→ * event logging, timeout handling, and structured completion tracking.
     6→ *
     7→ * Task: @implement-agent-invocation-lifecycle
     8→ * Spec: @agent-invocation-lifecycle
     9→ */
    10→
    11→import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
    12→import * as fs from "node:fs/promises";
    13→import * as fsSync from "node:fs";
    14→import * as path from "node:path";
    15→import * as os from "node:os";
    16→import { EventEmitter } from "node:events";
    17→import * as YAML from "yaml";
    18→import {
    19→  createSession,
    20→  appendEvent,
    21→  getSession,
    22→  closeSession,
    23→  injectEnvForAdapter,
    24→  removeEnvForAdapter,
    25→  isSessionBlobPointer,
    26→} from "../src/sessions/store.js";
    27→import * as storeModule from "../src/sessions/store.js";
    28→import { runInvocation, InvocationTimeoutError } from "../src/agent-runtime/invocation.js";
    29→import { resolveSkills, buildPromptWithSkills } from "../src/agent-runtime/prompts.js";
    30→import { registerAdapter } from "../src/agents/adapters.js";
    31→import * as spawnerModule from "../src/agents/spawner.js";
    32→import { SANITIZED_ENV_VARS } from "../src/agents/spawner.js";
    33→import { ACPClient } from "../src/acp/index.js";
    34→import type { Agent } from "../src/schema/meta.js";
    35→import * as shadowModule from "../src/parser/shadow.js";
    36→import {
    37→  testUlid,
    38→  createTempDir,
    39→  cleanupTempDir,
    40→} from "./helpers/cli.js";
    41→
    42→// ─── Fixtures ─────────────────────────────────────────────────────────────────
    43→
    44→const MOCK_ACP = path.join(__dirname, "mocks", "acp-mock.js");
    45→const MOCK_KSPEC_CLI = path.join(__dirname, "mocks", "kspec-capture-mock.cjs");
    46→
    47→/**
    48→ * Create a minimal Agent definition for testing.
    49→ */
    50→function makeTestAgent(overrides: Partial<Agent> = {}): Agent {
    51→  return {
    52→    _ulid: testUlid("AGNT"),
    53→    id: "test-worker",
    54→    name: "Test Worker Agent",
    55→    capabilities: [],
    56→    tools: [],
    57→    conventions: [],
    58→    dispatch: [],
    59→    skills: [],
    60→    auto_approve: false,
    61→    concurrency: { max_concurrent: 1 },
    62→    adapter: "mock-acp",
    63→    ...overrides,
    64→  };
    65→}
    66→
    67→/**
    68→ * Register the mock ACP adapter for testing.
    69→ */
    70→function registerMockAdapter(env: Record<string, string> = {}): void {
    71→  registerAdapter("mock-acp", {
    72→    command: "node",
    73→    args: [MOCK_ACP],
    74→    env: {
    75→      MOCK_ACP_PROJECT_DIR: process.cwd(),
    76→      ...env,
    77→    },
    78→    description: "Mock ACP agent for testing",
    79→  });
    80→}
    81→
    82→// ─── AC-1: Session creation with trigger, agent_id, task_id ──────────────────
    83→
    84→// AC: @agent-invocation-lifecycle ac-1
    85→describe("Session creation on invocation start", () => {
    86→  let testDir: string;
    87→
    88→  beforeEach(async () => {
    89→    testDir = await createTempDir("kspec-invoc-ac1-");
    90→    registerMockAdapter();
    91→  });
    92→
    93→  afterEach(async () => {
    94→    await cleanupTempDir(testDir);
    95→  });
    96→
    97→  it("should create session with trigger, agent_id, and task_id populated", async () => {
    98→    const agent = makeTestAgent({ id: "worker-agent" });
    99→    const taskRef = "@" + testUlid("TASK");
   100→
   101→    // Run a quick invocation (mock agent completes immediately)
   102→    const result = await runInvocation({
   103→      agent,
   104→      specDir: testDir,
   105→      cwd: process.cwd(),
   106→      taskRef,
   107→      prompt: "Test session creation",
   108→      trigger: "task.ready",
   109→    });
   110→
   111→    expect(result.session).toBeDefined();
   112→    expect(result.session.trigger).toBe("task.ready");
   113→    expect(result.session.agent_id).toBe("worker-agent");
   114→    expect(result.session.task_id).toBe(taskRef);
   115→    expect(result.session.agent_type).toBe("mock-acp");
   116→  });
   117→
   118→  it("should create session directory with session.yaml", async () => {
   119→    const agent = makeTestAgent();
   120→    const taskRef = "@" + testUlid("TASK", 1);
   121→
   122→    const result = await runInvocation({
   123→      agent,
   124→      specDir: testDir,
   125→      cwd: process.cwd(),
   126→      taskRef,
   127→      prompt: "Check session file creation",
   128→      trigger: "task.needs_work",
   129→    });
   130→
   131→    const sessionDir = path.join(testDir, "sessions", result.session.id);
   132→    const sessionYaml = path.join(sessionDir, "session.yaml");
   133→
   134→    await expect(fs.access(sessionYaml)).resolves.toBeUndefined();
   135→    const content = await fs.readFile(sessionYaml, "utf-8");
   136→    const parsed = YAML.parse(content);
   137→    expect(parsed.trigger).toBe("task.needs_work");
   138→    expect(parsed.task_id).toBe(taskRef);
   139→  });
   140→});
   141→
   142→// ─── AC-2: KSPEC_SESSION_ID injection ────────────────────────────────────────
   143→
   144→// AC: @agent-invocation-lifecycle ac-2
   145→describe("KSPEC_SESSION_ID injection", () => {
   146→  let testDir: string;
   147→  let capturedSessionId: string | undefined;
   148→
   149→  beforeEach(async () => {
   150→    testDir = await createTempDir("kspec-invoc-ac2-");
   151→    capturedSessionId = undefined;
   152→
   153→    // Register a mock adapter that captures the env var
   154→    // The mock ACP agent receives KSPEC_SESSION_ID through process env
   155→    registerMockAdapter();
   156→  });
   157→
   158→  afterEach(async () => {
   159→    // Restore process.env.KSPEC_SESSION_ID if it was set
   160→    delete process.env.KSPEC_SESSION_ID;
   161→    await cleanupTempDir(testDir);
   162→  });
   163→
   164→  it("should set KSPEC_SESSION_ID in process env during invocation", async () => {
   165→    const agent = makeTestAgent();
   166→    let envDuringInvocation: string | undefined;
   167→
   168→    // We can't easily intercept the spawned process env, but we can verify
   169→    // that KSPEC_SESSION_ID was set and cleared on the invoking process
   170→    // by checking that it was cleaned up after
   171→    const beforeSessionId = process.env.KSPEC_SESSION_ID;
   172→
   173→    const result = await runInvocation({
   174→      agent,
   175→      specDir: testDir,
   176→      cwd: process.cwd(),
   177→      taskRef: "@" + testUlid("TASK"),
   178→      prompt: "Check env injection",
   179→      trigger: "task.ready",
   180→    });
   181→
   182→    // After invocation, KSPEC_SESSION_ID should be restored (or deleted)
   183→    const afterSessionId = process.env.KSPEC_SESSION_ID;
   184→    expect(afterSessionId).toBe(beforeSessionId);
   185→    expect(result.outcome).toBe("success");
   186→  });
   187→
   188→  it("should restore a pre-existing KSPEC_SESSION_ID after invocation completes", async () => {
   189→    const agent = makeTestAgent();
   190→    const preExistingId = "01EXISTNG0000000000000000";
   191→
   192→    // Simulate a pre-existing KSPEC_SESSION_ID
   193→    process.env.KSPEC_SESSION_ID = preExistingId;
   194→
   195→    await runInvocation({
   196→      agent,
   197→      specDir: testDir,
   198→      cwd: process.cwd(),
   199→      taskRef: "@" + testUlid("TASK"),
   200→      prompt: "Check env cleanup",
   201→      trigger: "task.ready",
   202→    });
   203→
   204→    // After invocation, env should be restored to the pre-existing value,
   205→    // not deleted or overwritten with the invocation session id.
   206→    expect(process.env.KSPEC_SESSION_ID).toBe(preExistingId);
   207→
   208→    // Clean up for subsequent tests
   209→    delete process.env.KSPEC_SESSION_ID;
   210→  });
   211→});
