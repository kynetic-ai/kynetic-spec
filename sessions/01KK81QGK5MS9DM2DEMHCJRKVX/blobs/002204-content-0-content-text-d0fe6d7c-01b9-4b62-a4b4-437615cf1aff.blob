  1420→      cwd: process.cwd(),
  1421→      taskRef: "@" + testUlid("TASK"),
  1422→      prompt: "Test parent env preservation",
  1423→      trigger: "task.ready",
  1424→    });
  1425→
  1426→    // Parent process should still have CLAUDECODE — sanitization is per-spawn only
