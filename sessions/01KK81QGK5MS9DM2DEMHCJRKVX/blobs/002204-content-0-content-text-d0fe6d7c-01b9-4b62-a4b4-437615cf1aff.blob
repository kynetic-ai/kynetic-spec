  1371→        MOCK_ACP_VERIFY_ENV_VARS: "CLAUDECODE,CLAUDE_CODE_SESSION,PATH",
  1372→      },
  1373→      description: "Mock ACP that reports its env vars for sanitization tests",
  1374→    });
  1375→
  1376→    const agent = makeTestAgent({ adapter: "env-verify-acp" });
  1377→    const result = await runInvocation({
  1378→      agent,
