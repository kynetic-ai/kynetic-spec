  1197→  it("should reset consecutive failure count after a successful invocation", async () => {
  1198→    // AC: @agent-invocation-lifecycle ac-9 — streak resets after success; fail→success→fail is not consecutive
  1199→    // Simulate: task has 2 prior AGENT-FAIL notes then 1 AGENT-SUCCESS note (streak reset).
  1200→    // With retry limit=3, the next failure is count=1 → should NOT block.
