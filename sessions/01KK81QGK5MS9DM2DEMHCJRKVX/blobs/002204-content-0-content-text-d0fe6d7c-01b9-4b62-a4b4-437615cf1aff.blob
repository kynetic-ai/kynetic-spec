   562→// ─── AC-6: Streaming event logging ───────────────────────────────────────────
   563→
   564→// AC: @agent-invocation-lifecycle ac-6
   565→describe("Streaming event logging", () => {
   566→  let testDir: string;
   567→
   568→  beforeEach(async () => {
   569→    testDir = await createTempDir("kspec-invoc-ac6-");
   570→    registerMockAdapter({
   571→      MOCK_ACP_RESPONSE_TEXT: "Streaming output test response",
   572→    });
   573→  });
   574→
   575→  afterEach(async () => {
   576→    await cleanupTempDir(testDir);
   577→  });
   578→
   579→  it("should receive onUpdate callback for streaming updates", async () => {
   580→    const agent = makeTestAgent();
   581→    const updates: unknown[] = [];
   582→
   583→    await runInvocation({
