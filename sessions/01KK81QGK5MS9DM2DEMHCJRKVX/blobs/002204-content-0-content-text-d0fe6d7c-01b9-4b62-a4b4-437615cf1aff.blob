  1250→    } finally {
  1251→      delete process.env.KSPEC_CAPTURE_FILE;
  1252→    }
  1253→
  1254→    const calls = JSON.parse(fsSync.readFileSync(captureFile, "utf-8")) as Array<{ args: string[] }>;
  1255→
  1256→    // Failure note should be written
  1257→    const noteCall = calls.find((c) =>
  1258→      c.args.includes("task") && c.args.includes("note") && c.args.includes(taskRef)
  1259→    );
  1260→    expect(noteCall).toBeDefined();
  1261→
  1262→    // Block should NOT be called — streak was reset by AGENT-SUCCESS, so only 1 consecutive failure now
  1263→    const blockCall = calls.find((c) =>
