   623→
   624→  it("should preserve update chunk order and strict seq monotonicity during concurrent bursts", async () => {
   625→    // AC: @cli-agent-commands ac-12
   626→    // Regression for @01KJTQBT:
   627→    // Ensure concurrent update callbacks cannot reorder streamed chunks or
   628→    // produce duplicate/non-monotonic sequence numbers in events.jsonl.
   629→    const chunks = ["chunk-0", "chunk-1", "chunk-2", "chunk-3", "chunk-4"];
   630→    const agent = makeTestAgent();
   631→    const receivedChunks: string[] = [];
   632→    const updateSessionId = "mock-acp-session";
   633→    const emitter = new EventEmitter();
   634→
   635→    const spawnedAgent = {
   636→      client: {
   637→        on: (event: string, handler: (...args: unknown[]) => void) => {
   638→          emitter.on(event, handler);
   639→        },
   640→        newSession: vi.fn(async () => updateSessionId),
   641→        prompt: vi.fn(async () => {
   642→          for (const chunk of chunks) {
   643→            emitter.emit("update", updateSessionId, {
   644→              sessionUpdate: "agent_message_chunk",
   645→              content: { type: "text", text: chunk },
   646→            });
   647→          }
   648→          return { stopReason: "end_turn" };
   649→        }),
   650→        cancel: vi.fn(async () => undefined),
   651→        endSession: vi.fn(async () => undefined),
   652→        respondPermission: vi.fn(async () => undefined),
   653→      },
   654→      kill: vi.fn(() => undefined),
   655→    };
   656→
   657→    const spawnSpy = vi.spyOn(spawnerModule, "spawnAndInitialize").mockResolvedValue(
   658→      spawnedAgent as unknown as Awaited<ReturnType<typeof spawnerModule.spawnAndInitialize>>,
   659→    );
   660→
   661→    const originalAppendEvent = storeModule.appendEvent;
   662→    let inFlightUpdateWrites = 0;
   663→    let maxInFlightUpdateWrites = 0;
   664→    const appendSpy = vi.spyOn(storeModule, "appendEvent").mockImplementation(async (specDir, input) => {
   665→      if (input.type !== "session.update") {
   666→        return originalAppendEvent(specDir, input);
   667→      }
   668→
   669→      const update = input.data as { sessionUpdate?: string; content?: { type?: string; text?: string } };
   670→      const text = update.sessionUpdate === "agent_message_chunk" && update.content?.type === "text"
   671→        ? update.content.text ?? ""
   672→        : "";
   673→      const index = Number.parseInt(text.replace("chunk-", ""), 10);
   674→      const delayMs = Number.isNaN(index) ? 0 : (chunks.length - index) * 8;
   675→
   676→      inFlightUpdateWrites += 1;
   677→      maxInFlightUpdateWrites = Math.max(maxInFlightUpdateWrites, inFlightUpdateWrites);
   678→      try {
   679→        await new Promise((resolve) => setTimeout(resolve, delayMs));
   680→        return originalAppendEvent(specDir, input);
   681→      } finally {
   682→        inFlightUpdateWrites -= 1;
   683→      }
   684→    });
   685→
   686→    try {
   687→      const result = await runInvocation({
   688→        agent,
   689→        specDir: testDir,
   690→        cwd: process.cwd(),
   691→        taskRef: "@" + testUlid("TASK"),
   692→        prompt: "Concurrent update burst ordering",
   693→        trigger: "task.ready",
   694→        onUpdate: (update) => {
   695→          if (update.sessionUpdate === "agent_message_chunk" && update.content.type === "text") {
   696→            receivedChunks.push(update.content.text);
   697→          }
   698→        },
   699→      });
   700→
   701→      expect(result.outcome).toBe("success");
   702→      expect(receivedChunks).toEqual(chunks);
   703→      expect(maxInFlightUpdateWrites).toBe(1);
   704→
   705→      const eventsPath = path.join(testDir, "sessions", result.session.id, "events.jsonl");
   706→      const content = await fs.readFile(eventsPath, "utf-8");
   707→      const events = content.trim().split("\n").filter(Boolean).map((line) => JSON.parse(line));
   708→      const seqs = events.map((event: { seq: number }) => event.seq);
   709→      const uniqueSeqCount = new Set(seqs).size;
   710→      expect(uniqueSeqCount).toBe(seqs.length);
   711→      for (let i = 1; i < seqs.length; i++) {
   712→        expect(seqs[i]).toBeGreaterThan(seqs[i - 1]);
   713→      }
   714→    } finally {
   715→      appendSpy.mockRestore();
   716→      spawnSpy.mockRestore();
   717→    }
   718→  });
   719→
   720→  it("should externalize oversized payload blobs when session updates exceed threshold", async () => {
   721→    // AC: @agent-invocation-lifecycle ac-6 — blob externalization for oversized payloads
   722→    // Register mock adapter that sends a large payload (> EVENT_FIELD_EXTERNALIZE_BYTES = 16KB)
   723→    const oversizedText = "x".repeat(20 * 1024); // 20KB text — exceeds 16KB field threshold
   724→    registerAdapter("large-payload-acp", {
   725→      command: "node",
   726→      args: [MOCK_ACP],
   727→      env: {
   728→        MOCK_ACP_RESPONSE_TEXT: oversizedText,
   729→      },
   730→      description: "Mock ACP that sends oversized updates for blob externalization tests",
   731→    });
   732→
   733→    const agent = makeTestAgent({ adapter: "large-payload-acp" });
   734→    const result = await runInvocation({
   735→      agent,
   736→      specDir: testDir,
   737→      cwd: process.cwd(),
   738→      taskRef: "@" + testUlid("TASK"),
   739→      prompt: "Test blob externalization",
   740→      trigger: "task.ready",
   741→    });
   742→
   743→    expect(result.outcome).toBe("success");
   744→
   745→    const eventsPath = path.join(testDir, "sessions", result.session.id, "events.jsonl");
   746→    const content = await fs.readFile(eventsPath, "utf-8");
   747→    const lines = content.trim().split("\n").filter(Boolean);
   748→    const events = lines.map((l) => JSON.parse(l));
   749→
   750→    // Find the session.update event that contains the large payload
   751→    const updateEvent = events.find((e: { type: string }) => e.type === "session.update");
   752→    expect(updateEvent).toBeDefined();
   753→
   754→    // The oversized text field should be externalized as a blob pointer
   755→    // Walk data to find a blob pointer anywhere in the update's data tree
   756→    function hasBlobPointer(obj: unknown): boolean {
   757→      if (isSessionBlobPointer(obj)) return true;
   758→      if (typeof obj === "object" && obj !== null) {
   759→        return Object.values(obj).some(hasBlobPointer);
   760→      }
   761→      return false;
   762→    }
   763→
   764→    expect(hasBlobPointer(updateEvent.data)).toBe(true);
   765→
   766→    // Verify the blob file was created in the session's blobs/ directory
   767→    const blobDir = path.join(testDir, "sessions", result.session.id, "blobs");
   768→    const blobFiles = await fs.readdir(blobDir);
   769→    expect(blobFiles.length).toBeGreaterThan(0);
   770→  });
   771→});
