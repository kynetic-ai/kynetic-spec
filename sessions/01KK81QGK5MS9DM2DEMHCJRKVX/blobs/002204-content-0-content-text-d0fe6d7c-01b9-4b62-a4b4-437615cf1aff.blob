   213→// ─── AC-3: Timeout handling ───────────────────────────────────────────────────
   214→
   215→// AC: @agent-invocation-lifecycle ac-3
   216→describe("Timeout handling", () => {
   217→  let testDir: string;
   218→
   219→  beforeEach(async () => {
   220→    testDir = await createTempDir("kspec-invoc-ac3-");
   221→
   222→    // Register a slow adapter that delays response
   223→    registerAdapter("slow-mock-acp", {
   224→      command: "node",
   225→      args: [MOCK_ACP],
   226→      env: {
   227→        MOCK_ACP_DELAY_MS: "5000", // 5 second delay
   228→      },
   229→      description: "Slow mock ACP agent for timeout tests",
   230→    });
   231→  });
   232→
   233→  afterEach(async () => {
   234→    await cleanupTempDir(testDir);
   235→  });
   236→
   237→  it("should close session as timed_out when timeout is reached", async () => {
   238→    const agent = makeTestAgent({ adapter: "slow-mock-acp" });
   239→
   240→    const result = await runInvocation({
   241→      agent,
   242→      specDir: testDir,
   243→      cwd: process.cwd(),
   244→      taskRef: "@" + testUlid("TASK"),
   245→      prompt: "Test timeout",
   246→      trigger: "task.ready",
   247→      timeoutMinutes: 0.001, // ~60ms timeout — much less than 5s delay
   248→    });
   249→
   250→    expect(result.outcome).toBe("timed_out");
   251→    expect(result.session.status).toBe("timed_out");
   252→  });
   253→
   254→  it("should log agent.timeout event when timeout occurs", async () => {
   255→    const agent = makeTestAgent({ adapter: "slow-mock-acp" });
   256→
   257→    const result = await runInvocation({
   258→      agent,
   259→      specDir: testDir,
   260→      cwd: process.cwd(),
   261→      taskRef: "@" + testUlid("TASK"),
   262→      prompt: "Test timeout event logging",
   263→      trigger: "task.ready",
   264→      timeoutMinutes: 0.001,
   265→    });
   266→
   267→    // Read the events.jsonl
   268→    const eventsPath = path.join(testDir, "sessions", result.session.id, "events.jsonl");
   269→    const content = await fs.readFile(eventsPath, "utf-8");
   270→    const events = content.trim().split("\n").filter(Boolean).map((l) => JSON.parse(l));
   271→
   272→    const timeoutEvent = events.find((e: { type: string }) => e.type === "agent.timeout");
   273→    expect(timeoutEvent).toBeDefined();
   274→    expect(timeoutEvent.data.task_id).toBeDefined();
   275→    expect(timeoutEvent.data.timeout_minutes).toBeDefined();
   276→  });
   277→
   278→  it("should add a timeout note to the task when timeout occurs", async () => {
   279→    // AC: @agent-invocation-lifecycle ac-3 — timeout note written to task
   280→    const agent = makeTestAgent({ adapter: "slow-mock-acp" });
   281→    const captureFile = path.join(testDir, "kspec-calls.json");
   282→    const taskRef = "@" + testUlid("TASK");
   283→
   284→    // Set capture env so runKspecCli's spawnSync inherits it
   285→    process.env.KSPEC_CAPTURE_FILE = captureFile;
   286→    try {
   287→      await runInvocation({
   288→        agent,
   289→        specDir: testDir,
   290→        cwd: process.cwd(),
   291→        taskRef,
   292→        prompt: "Test timeout note",
   293→        trigger: "task.ready",
   294→        timeoutMinutes: 0.001,
   295→        kspecCliPath: MOCK_KSPEC_CLI,
   296→      });
   297→    } finally {
   298→      delete process.env.KSPEC_CAPTURE_FILE;
   299→    }
   300→
   301→    // Verify that kspec task note was called with the task ref and AGENT-TIMEOUT marker
   302→    const calls = JSON.parse(fsSync.readFileSync(captureFile, "utf-8")) as Array<{ args: string[] }>;
   303→    const noteCall = calls.find((c) =>
   304→      c.args.includes("task") && c.args.includes("note") && c.args.includes(taskRef)
   305→    );
   306→    expect(noteCall).toBeDefined();
   307→    const noteText = noteCall!.args[noteCall!.args.indexOf(taskRef) + 1] ?? "";
   308→    expect(noteText).toContain("[AGENT-TIMEOUT]");
   309→  });
   310→
   311→  it("should dispatch ACP cancel request on timeout", async () => {
   312→    // AC: @agent-invocation-lifecycle ac-3 — ACP cancel request dispatched on timeout
   313→    // Use a closure to track cancel calls — vi.spyOn prototype mocks don't reliably
   314→    // track ESM cross-module calls in spy.mock.calls.
   315→    let cancelCalledWith: string | undefined;
   316→    const cancelSpy = vi.spyOn(ACPClient.prototype, "cancel").mockImplementation(async (sessionId) => {
   317→      cancelCalledWith = sessionId;
   318→    });
   319→
   320→    const agent = makeTestAgent({ adapter: "slow-mock-acp" });
   321→    try {
   322→      await runInvocation({
   323→        agent,
   324→        specDir: testDir,
   325→        cwd: process.cwd(),
   326→        taskRef: "@" + testUlid("TASK"),
   327→        prompt: "Test cancel dispatch",
   328→        trigger: "task.ready",
   329→        // Use a longer timeout so the agent has time to spawn + initialize + newSession
   330→        // (the slow mock delays 5000ms only in session/prompt, not session/new)
   331→        // 3 seconds → enough for spawn+init+newSession but well under the 5s prompt delay
   332→        timeoutMinutes: 3 / 60,
   333→      });
   334→    } finally {
   335→      cancelSpy.mockRestore();
   336→    }
   337→
   338→    // Verify cancel was called with the ACP session ID — cancel request dispatched on timeout
   339→    expect(cancelCalledWith).toBeDefined();
   340→  });
   341→
   342→  it("should set ACP session/prompt timeout above invocation timeout budget", async () => {
   343→    const agent = makeTestAgent({ adapter: "slow-mock-acp" });
   344→    const mockSessionId = "mock-acp-session";
   345→    const emitter = new EventEmitter();
   346→    const timeoutMinutes = 12;
   347→
   348→    const spawnedAgent = {
   349→      client: {
   350→        on: (event: string, handler: (...args: unknown[]) => void) => {
   351→          emitter.on(event, handler);
   352→        },
   353→        newSession: vi.fn(async () => mockSessionId),
   354→        prompt: vi.fn(async () => ({ stopReason: "end_turn" })),
   355→        cancel: vi.fn(async () => undefined),
   356→        endSession: vi.fn(async () => undefined),
   357→        respondPermission: vi.fn(async () => undefined),
   358→      },
   359→      kill: vi.fn(() => undefined),
   360→    };
   361→
   362→    const spawnSpy = vi.spyOn(spawnerModule, "spawnAndInitialize").mockResolvedValue(
   363→      spawnedAgent as unknown as Awaited<ReturnType<typeof spawnerModule.spawnAndInitialize>>,
   364→    );
   365→    let spawnOptions: Parameters<typeof spawnerModule.spawnAndInitialize>[1] | undefined;
   366→
   367→    try {
   368→      await runInvocation({
   369→        agent,
   370→        specDir: testDir,
   371→        cwd: process.cwd(),
   372→        taskRef: "@" + testUlid("TASK"),
   373→        prompt: "Test ACP prompt timeout alignment",
   374→        trigger: "task.ready",
   375→        timeoutMinutes,
   376→      });
   377→      spawnOptions = spawnSpy.mock.calls[0]?.[1];
   378→    } finally {
   379→      spawnSpy.mockRestore();
   380→    }
   381→
   382→    expect(spawnOptions).toBeDefined();
   383→    expect(spawnOptions.clientOptions?.methodTimeouts?.["session/prompt"]).toBe(
   384→      timeoutMinutes * 60 * 1000 + 5_000,
   385→    );
   386→  });
   387→});
