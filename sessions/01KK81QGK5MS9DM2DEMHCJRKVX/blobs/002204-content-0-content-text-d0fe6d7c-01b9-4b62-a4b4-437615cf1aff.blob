  1384→    });
  1385→
  1386→    expect(result.outcome).toBe("success");
  1387→
  1388→    // Read the env vars reported by the child process
  1389→    const reportedEnv = JSON.parse(await fs.readFile(envVerifyFile, "utf-8"));
  1390→
  1391→    // CLAUDECODE and CLAUDE_CODE_SESSION must be null (not present in child env)
  1392→    expect(reportedEnv.CLAUDECODE).toBeNull();
  1393→    expect(reportedEnv.CLAUDE_CODE_SESSION).toBeNull();
  1394→
  1395→    // PATH should still be present (not sanitized)
  1396→    expect(reportedEnv.PATH).not.toBeNull();
  1397→  });
  1398→
  1399→  it("should not affect process.env of the parent process", async () => {
  1400→    // Set sanitized vars
