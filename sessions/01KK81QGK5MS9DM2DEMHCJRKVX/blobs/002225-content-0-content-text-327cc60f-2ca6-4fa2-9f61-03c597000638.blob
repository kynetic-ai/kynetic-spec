   185→  const sessionId = '01KF123456789ABCDEFGHJKMNP';
   186→
   187→  it('should construct sessions directory path', () => {
   188→    expect(getSessionsDir(specDir)).toBe('/test/.kspec/sessions');
   189→  });
   190→
   191→  it('should construct session directory path', () => {
   192→    expect(getSessionDir(specDir, sessionId)).toBe(`/test/.kspec/sessions/${sessionId}`);
   193→  });
   194→
   195→  it('should construct metadata file path', () => {
