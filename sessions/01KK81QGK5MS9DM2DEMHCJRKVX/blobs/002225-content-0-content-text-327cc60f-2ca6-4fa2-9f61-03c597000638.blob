   143→
   144→  it('should accept event without optional trace_id', () => {
   145→    const event = {
   146→      ts: Date.now(),
   147→      seq: 0,
   148→      type: 'session.start',
   149→      session_id: '01KF123456789ABCDEFGHJKMNP',
   150→      data: null,
   151→    };
   152→
   153→    const result = SessionEventSchema.safeParse(event);
   154→    expect(result.success).toBe(true);
   155→  });
   156→
   157→  it('should reject event without required fields', () => {
