     1→/**
     2→ * Session event storage tests.
     3→ *
     4→ * Tests for JSONL-based event storage for agent sessions.
     5→ */
     6→
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import { createHash } from 'node:crypto';
     9→import { spawnSync } from 'node:child_process';
    10→import * as fs from 'node:fs/promises';
    11→import * as path from 'node:path';
    12→import * as os from 'node:os';
    13→import {
    14→  SessionMetadataSchema,
    15→  SessionEventSchema,
    16→  SessionStatusSchema,
    17→  EventTypeSchema,
    18→  type SessionMetadataInput,
    19→  type SessionEventInput,
    20→} from '../src/sessions/types.js';
    21→import {
    22→  createSession,
    23→  getSession,
    24→  updateSessionStatus,
    25→  listSessions,
    26→  sessionExists,
    27→  appendEvent,
    28→  readEvents,
    29→  readEventsSince,
    30→  getLastEvent,
    31→  getSessionsDir,
    32→  getSessionDir,
    33→  getSessionMetadataPath,
    34→  getSessionEventsPath,
    35→  saveSessionContext,
    36→  readSessionContext,
    37→  getSessionContextPath,
    38→  getCompletedSessionCountsByAgent,
    39→} from '../src/sessions/store.js';
