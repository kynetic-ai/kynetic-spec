  1010→
  1011→    const counts = await getCompletedSessionCountsByAgent(testDir);
  1012→    // getSession() materializes agent_id from agent_type for legacy sessions
  1013→    expect(counts).toEqual({
  1014→      'claude-code': 1,
  1015→    });
  1016→  });
  1017→});
