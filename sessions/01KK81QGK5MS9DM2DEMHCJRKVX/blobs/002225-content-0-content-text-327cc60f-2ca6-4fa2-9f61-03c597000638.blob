    41→// ─── Schema Tests ────────────────────────────────────────────────────────────
    42→
    43→describe('SessionStatusSchema', () => {
    44→  it('should accept valid status values', () => {
    45→    expect(SessionStatusSchema.safeParse('active').success).toBe(true);
    46→    expect(SessionStatusSchema.safeParse('completed').success).toBe(true);
    47→    expect(SessionStatusSchema.safeParse('abandoned').success).toBe(true);
    48→  });
    49→
    50→  it('should reject invalid status values', () => {
    51→    expect(SessionStatusSchema.safeParse('invalid').success).toBe(false);
    52→    expect(SessionStatusSchema.safeParse('pending').success).toBe(false);
    53→    expect(SessionStatusSchema.safeParse('').success).toBe(false);
    54→  });
    55→});
    56→
    57→describe('EventTypeSchema', () => {
    58→  it('should accept valid event types', () => {
    59→    expect(EventTypeSchema.safeParse('session.start').success).toBe(true);
    60→    expect(EventTypeSchema.safeParse('session.update').success).toBe(true);
    61→    expect(EventTypeSchema.safeParse('iteration.timeout').success).toBe(true);
    62→    expect(EventTypeSchema.safeParse('session.end').success).toBe(true);
    63→    expect(EventTypeSchema.safeParse('prompt.sent').success).toBe(true);
    64→    expect(EventTypeSchema.safeParse('tool.call').success).toBe(true);
    65→    expect(EventTypeSchema.safeParse('tool.result').success).toBe(true);
    66→    expect(EventTypeSchema.safeParse('note').success).toBe(true);
    67→  });
    68→
    69→  it('should reject invalid event types', () => {
    70→    expect(EventTypeSchema.safeParse('invalid').success).toBe(false);
    71→    expect(EventTypeSchema.safeParse('session_start').success).toBe(false);
    72→    expect(EventTypeSchema.safeParse('').success).toBe(false);
    73→  });
    74→});
    75→
    76→describe('SessionMetadataSchema', () => {
    77→  // AC: @session-events ac-5
    78→  it('should accept valid session metadata with all fields', () => {
    79→    const metadata = {
    80→      id: '01KF123456789ABCDEFGHJKMNP',
    81→      task_id: '@my-task',
    82→      agent_type: 'claude-code',
    83→      status: 'active',
    84→      started_at: '2026-01-17T10:00:00.000Z',
    85→    };
    86→
    87→    const result = SessionMetadataSchema.safeParse(metadata);
    88→    expect(result.success).toBe(true);
    89→  });
    90→
    91→  // AC: @session-events ac-5
    92→  it('should accept metadata without optional task_id', () => {
    93→    const metadata = {
    94→      id: '01KF123456789ABCDEFGHJKMNP',
    95→      agent_type: 'claude-code',
    96→      status: 'active',
    97→      started_at: '2026-01-17T10:00:00.000Z',
    98→    };
    99→
   100→    const result = SessionMetadataSchema.safeParse(metadata);
   101→    expect(result.success).toBe(true);
   102→  });
   103→
   104→  it('should accept completed status with ended_at', () => {
   105→    const metadata = {
   106→      id: '01KF123456789ABCDEFGHJKMNP',
   107→      agent_type: 'claude-code',
   108→      status: 'completed',
   109→      started_at: '2026-01-17T10:00:00.000Z',
   110→      ended_at: '2026-01-17T11:00:00.000Z',
   111→    };
   112→
   113→    const result = SessionMetadataSchema.safeParse(metadata);
   114→    expect(result.success).toBe(true);
   115→  });
   116→
   117→  it('should reject metadata without required fields', () => {
   118→    const metadata = {
   119→      id: '01KF123456789ABCDEFGHJKMNP',
   120→      status: 'active',
   121→    };
   122→
   123→    const result = SessionMetadataSchema.safeParse(metadata);
   124→    expect(result.success).toBe(false);
   125→  });
   126→});
