   208→// ─── Storage Tests ───────────────────────────────────────────────────────────
   209→
   210→describe('Session storage', () => {
   211→  let testDir: string;
   212→
   213→  beforeEach(async () => {
   214→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-test-'));
   215→  });
   216→
   217→  afterEach(async () => {
   218→    await fs.rm(testDir, { recursive: true });
   219→  });
   220→
   221→  describe('createSession', () => {
   222→    // AC: @session-events ac-1
   223→    it('should create session directory and metadata file', async () => {
   224→      const input: SessionMetadataInput = {
   225→        id: '01KF123456789ABCDEFGHJKMNP',
   226→        agent_type: 'claude-code',
   227→      };
   228→
   229→      const metadata = await createSession(testDir, input);
   230→
   231→      // Check metadata returned
   232→      expect(metadata.id).toBe(input.id);
   233→      expect(metadata.agent_type).toBe(input.agent_type);
   234→      expect(metadata.status).toBe('active');
   235→      expect(metadata.started_at).toBeDefined();
   236→
   237→      // Check directory was created
   238→      const sessionDir = getSessionDir(testDir, input.id);
   239→      const stat = await fs.stat(sessionDir);
   240→      expect(stat.isDirectory()).toBe(true);
   241→
   242→      // Check metadata file was created
   243→      const metadataPath = getSessionMetadataPath(testDir, input.id);
   244→      const content = await fs.readFile(metadataPath, 'utf-8');
   245→      expect(content).toContain('id: ' + input.id);
   246→      expect(content).toContain('agent_type: claude-code');
   247→      expect(content).toContain('status: active');
   248→    });
   249→
   250→    // AC: @session-events ac-5
   251→    it('should include optional task_id in metadata', async () => {
   252→      const input: SessionMetadataInput = {
   253→        id: '01KF123456789ABCDEFGHJKMNP',
   254→        agent_type: 'claude-code',
   255→        task_id: '@my-task',
   256→      };
   257→
   258→      const metadata = await createSession(testDir, input);
   259→
   260→      expect(metadata.task_id).toBe('@my-task');
   261→
   262→      const metadataPath = getSessionMetadataPath(testDir, input.id);
   263→      const content = await fs.readFile(metadataPath, 'utf-8');
   264→      // Accept both single and double quotes (yaml library uses double quotes)
   265→      expect(content).toMatch(/task_id: ["']@my-task["']/);
   266→    });
   267→
   268→    it('should use provided started_at if given', async () => {
   269→      const startTime = '2026-01-17T10:00:00.000Z';
   270→      const input: SessionMetadataInput = {
   271→        id: '01KF123456789ABCDEFGHJKMNP',
   272→        agent_type: 'claude-code',
   273→        started_at: startTime,
   274→      };
   275→
   276→      const metadata = await createSession(testDir, input);
   277→
   278→      expect(metadata.started_at).toBe(startTime);
   279→    });
   280→  });
   281→
   282→  describe('getSession', () => {
   283→    it('should return session metadata if exists', async () => {
   284→      const input: SessionMetadataInput = {
   285→        id: '01KF123456789ABCDEFGHJKMNP',
   286→        agent_type: 'claude-code',
   287→      };
   288→
   289→      await createSession(testDir, input);
   290→      const metadata = await getSession(testDir, input.id);
   291→
   292→      expect(metadata).not.toBeNull();
   293→      expect(metadata?.id).toBe(input.id);
   294→      expect(metadata?.agent_type).toBe(input.agent_type);
   295→    });
   296→
   297→    it('should return null if session does not exist', async () => {
   298→      const metadata = await getSession(testDir, 'nonexistent');
   299→
   300→      expect(metadata).toBeNull();
   301→    });
   302→  });
   303→
   304→  describe('updateSessionStatus', () => {
   305→    // AC: @session-events ac-6
   306→    it('should update status and set ended_at when completing', async () => {
   307→      const input: SessionMetadataInput = {
   308→        id: '01KF123456789ABCDEFGHJKMNP',
   309→        agent_type: 'claude-code',
   310→      };
   311→
   312→      await createSession(testDir, input);
   313→      const updated = await updateSessionStatus(testDir, input.id, 'completed');
   314→
   315→      expect(updated).not.toBeNull();
   316→      expect(updated?.status).toBe('completed');
   317→      expect(updated?.ended_at).toBeDefined();
   318→
   319→      // Verify persisted
   320→      const reloaded = await getSession(testDir, input.id);
   321→      expect(reloaded?.status).toBe('completed');
   322→      expect(reloaded?.ended_at).toBeDefined();
   323→    });
   324→
   325→    // AC: @session-events ac-6
   326→    it('should set ended_at when abandoning', async () => {
   327→      const input: SessionMetadataInput = {
   328→        id: '01KF123456789ABCDEFGHJKMNP',
   329→        agent_type: 'claude-code',
   330→      };
   331→
   332→      await createSession(testDir, input);
   333→      const updated = await updateSessionStatus(testDir, input.id, 'abandoned');
   334→
   335→      expect(updated?.status).toBe('abandoned');
   336→      expect(updated?.ended_at).toBeDefined();
   337→    });
   338→
   339→    it('should return null if session does not exist', async () => {
   340→      const updated = await updateSessionStatus(testDir, 'nonexistent', 'completed');
   341→
   342→      expect(updated).toBeNull();
   343→    });
   344→  });
   345→
   346→  describe('listSessions', () => {
   347→    it('should list all session IDs', async () => {
   348→      await createSession(testDir, { id: 'session-a', agent_type: 'claude-code' });
   349→      await createSession(testDir, { id: 'session-b', agent_type: 'claude-code' });
   350→      await createSession(testDir, { id: 'session-c', agent_type: 'test-agent' });
   351→
   352→      const sessions = await listSessions(testDir);
   353→
   354→      expect(sessions).toHaveLength(3);
   355→      expect(sessions).toContain('session-a');
   356→      expect(sessions).toContain('session-b');
   357→      expect(sessions).toContain('session-c');
   358→    });
   359→
   360→    it('should return empty array if no sessions', async () => {
   361→      const sessions = await listSessions(testDir);
   362→
   363→      expect(sessions).toHaveLength(0);
   364→    });
   365→  });
   366→
   367→  describe('sessionExists', () => {
   368→    it('should return true if session exists', async () => {
   369→      await createSession(testDir, { id: 'my-session', agent_type: 'claude-code' });
   370→
   371→      const exists = await sessionExists(testDir, 'my-session');
   372→
   373→      expect(exists).toBe(true);
   374→    });
   375→
   376→    it('should return false if session does not exist', async () => {
   377→      const exists = await sessionExists(testDir, 'nonexistent');
   378→
   379→      expect(exists).toBe(false);
   380→    });
   381→  });
   382→});
   383→
   384→// ─── Event Storage Tests ─────────────────────────────────────────────────────
   385→
   386→describe('Event storage', () => {
   387→  let testDir: string;
   388→  const sessionId = '01KF123456789ABCDEFGHJKMNP';
   389→
   390→  beforeEach(async () => {
   391→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-event-test-'));
   392→  });
   393→
   394→  afterEach(async () => {
   395→    await fs.rm(testDir, { recursive: true });
   396→  });
   397→
   398→  describe('appendEvent', () => {
   399→    // AC: @session-events ac-2
   400→    it('should append event with auto-assigned ts and seq', async () => {
   401→      const input: SessionEventInput = {
   402→        type: 'session.start',
   403→        session_id: sessionId,
   404→        data: { message: 'Starting session' },
   405→      };
   406→
   407→      const event = await appendEvent(testDir, input);
   408→
   409→      expect(event.ts).toBeDefined();
   410→      expect(event.ts).toBeGreaterThan(0);
   411→      expect(event.seq).toBe(0);
   412→      expect(event.type).toBe('session.start');
   413→      expect(event.session_id).toBe(sessionId);
   414→      expect(event.data).toEqual({ message: 'Starting session' });
   415→    });
   416→
   417→    // AC: @session-events ac-2
   418→    it('should auto-increment seq for subsequent events', async () => {
   419→      const event1 = await appendEvent(testDir, {
   420→        type: 'session.start',
   421→        session_id: sessionId,
   422→        data: null,
   423→      });
   424→
   425→      const event2 = await appendEvent(testDir, {
   426→        type: 'prompt.sent',
   427→        session_id: sessionId,
   428→        data: { prompt: 'Hello' },
   429→      });
   430→
   431→      const event3 = await appendEvent(testDir, {
   432→        type: 'tool.call',
   433→        session_id: sessionId,
   434→        data: { tool: 'Read' },
   435→      });
   436→
   437→      expect(event1.seq).toBe(0);
   438→      expect(event2.seq).toBe(1);
   439→      expect(event3.seq).toBe(2);
   440→    });
   441→
   442→    // AC: @session-events ac-2
   443→    it('should derive next seq from the last stored event seq', async () => {
   444→      const sessionDir = getSessionDir(testDir, sessionId);
   445→      const eventsPath = getSessionEventsPath(testDir, sessionId);
   446→      await fs.mkdir(sessionDir, { recursive: true });
   447→
   448→      const existing = [
   449→        {
   450→          ts: 1000,
   451→          seq: 5,
   452→          type: 'session.start',
   453→          session_id: sessionId,
   454→          data: null,
   455→        },
   456→        {
   457→          ts: 2000,
   458→          seq: 9,
   459→          type: 'session.update',
   460→          session_id: sessionId,
   461→          data: { message: 'existing tail event' },
   462→        },
   463→      ];
   464→      await fs.writeFile(
   465→        eventsPath,
   466→        `${existing.map((event) => JSON.stringify(event)).join('\n')}\n`,
   467→        'utf-8',
   468→      );
   469→
   470→      const next = await appendEvent(testDir, {
   471→        type: 'prompt.sent',
   472→        session_id: sessionId,
   473→        data: { prompt: 'new event' },
   474→      });
   475→
   476→      expect(next.seq).toBe(10);
   477→    });
   478→
   479→    // AC: @session-events ac-3
   480→    it('should create session directory if it does not exist (lazy creation)', async () => {
   481→      const event = await appendEvent(testDir, {
   482→        type: 'session.start',
   483→        session_id: sessionId,
   484→        data: null,
   485→      });
   486→
   487→      expect(event.seq).toBe(0);
   488→
   489→      // Verify directory was created
   490→      const sessionDir = getSessionDir(testDir, sessionId);
   491→      const stat = await fs.stat(sessionDir);
   492→      expect(stat.isDirectory()).toBe(true);
   493→    });
   494→
   495→    it('should preserve optional trace_id', async () => {
   496→      const event = await appendEvent(testDir, {
   497→        type: 'session.start',
   498→        session_id: sessionId,
   499→        trace_id: 'trace-abc-123',
   500→        data: null,
   501→      });
   502→
   503→      expect(event.trace_id).toBe('trace-abc-123');
   504→    });
   505→
   506→    // AC: @session-events ac-3
   507→    it('should write event as JSON line to events.jsonl', async () => {
   508→      await appendEvent(testDir, {
   509→        type: 'session.start',
   510→        session_id: sessionId,
   511→        data: { key: 'value' },
   512→      });
   513→
   514→      await appendEvent(testDir, {
   515→        type: 'prompt.sent',
   516→        session_id: sessionId,
   517→        data: { prompt: 'test' },
   518→      });
   519→
   520→      const eventsPath = getSessionEventsPath(testDir, sessionId);
   521→      const content = await fs.readFile(eventsPath, 'utf-8');
   522→      const lines = content.trim().split('\n');
   523→
   524→      expect(lines).toHaveLength(2);
   525→
   526→      const event1 = JSON.parse(lines[0]);
   527→      expect(event1.type).toBe('session.start');
   528→      expect(event1.seq).toBe(0);
   529→
   530→      const event2 = JSON.parse(lines[1]);
   531→      expect(event2.type).toBe('prompt.sent');
   532→      expect(event2.seq).toBe(1);
   533→    });
   534→
   535→    // AC: @session-events ac-8
   536→    // AC: @session-events ac-9
   537→    it('should externalize oversized rawOutput and store pointer metadata', async () => {
   538→      const rawOutput = 'X'.repeat(20_000);
   539→
   540→      await appendEvent(testDir, {
   541→        type: 'session.update',
   542→        session_id: sessionId,
   543→        data: {
   544→          iteration: 1,
   545→          update: {
   546→            sessionUpdate: 'tool_call_update',
   547→            rawOutput,
   548→          },
   549→        },
   550→      });
   551→
   552→      const eventsPath = getSessionEventsPath(testDir, sessionId);
   553→      const lines = (await fs.readFile(eventsPath, 'utf-8')).trim().split('\n');
   554→      expect(lines).toHaveLength(1);
   555→
   556→      const stored = JSON.parse(lines[0]);
   557→      const pointer = stored.data.update.rawOutput as {
   558→        path: string;
   559→        bytes: number;
   560→        sha256: string;
   561→        truncated: boolean;
   562→        preview: string;
   563→      };
   564→      expect(pointer.path).toMatch(/^blobs\//);
   565→      expect(pointer.bytes).toBe(rawOutput.length);
   566→      expect(pointer.sha256).toBe(
   567→        createHash('sha256').update(rawOutput).digest('hex'),
   568→      );
   569→      expect(pointer.truncated).toBe(true);
   570→      expect(pointer.preview.length).toBeGreaterThan(0);
   571→      expect(pointer.preview.length).toBeLessThan(rawOutput.length);
   572→
   573→      const blobPath = path.join(getSessionDir(testDir, sessionId), pointer.path);
   574→      const blobContent = await fs.readFile(blobPath, 'utf-8');
   575→      expect(blobContent).toBe(rawOutput);
   576→    });
   577→
   578→    it('should generate UTF-8 safe previews for externalized payloads', async () => {
   579→      const rawOutput = '漢'.repeat(7_000);
   580→
   581→      await appendEvent(testDir, {
   582→        type: 'session.update',
   583→        session_id: sessionId,
   584→        data: {
   585→          iteration: 1,
   586→          update: {
   587→            sessionUpdate: 'tool_call_update',
   588→            rawOutput,
   589→          },
   590→        },
   591→      });
   592→
   593→      const eventsPath = getSessionEventsPath(testDir, sessionId);
   594→      const stored = JSON.parse((await fs.readFile(eventsPath, 'utf-8')).trim());
   595→      const pointer = stored.data.update.rawOutput as { preview: string };
   596→
   597→      expect(pointer.preview).toContain('...');
   598→      expect(pointer.preview).not.toContain('\uFFFD');
   599→    });
   600→
   601→    it('should cap oversized event lines by externalizing whole payload', async () => {
   602→      const giantPayload = 'Y'.repeat(320_000);
   603→
   604→      await appendEvent(testDir, {
   605→        type: 'prompt.sent',
   606→        session_id: sessionId,
   607→        data: {
   608→          prompt: giantPayload,
   609→        },
   610→      });
   611→
   612→      const eventsPath = getSessionEventsPath(testDir, sessionId);
   613→      const rawLine = (await fs.readFile(eventsPath, 'utf-8')).trim();
   614→      expect(Buffer.byteLength(rawLine, 'utf-8')).toBeLessThan(256 * 1024);
   615→
   616→      const parsed = JSON.parse(rawLine);
   617→      const pointer = parsed.data as {
   618→        path: string;
   619→        bytes: number;
   620→      };
   621→      expect(pointer.path).toMatch(/^blobs\//);
   622→
   623→      const blobPath = path.join(getSessionDir(testDir, sessionId), pointer.path);
   624→      const blobContent = await fs.readFile(blobPath, 'utf-8');
   625→      expect(Buffer.byteLength(blobContent, 'utf-8')).toBe(pointer.bytes);
   626→      expect(JSON.parse(blobContent)).toEqual({ prompt: giantPayload });
   627→    });
