   790→  describe('commit boundary inclusion', () => {
   791→    // AC: @session-events ac-7
   792→    it('should include accumulated events in the next git commit', async () => {
   793→      const repoDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-commit-test-'));
   794→      const boundarySessionId = '01KF123456789ABCDEFGHJKMNQ';
   795→
   796→      const runGit = (...args: string[]) => {
   797→        const result = spawnSync('git', args, {
   798→          cwd: repoDir,
   799→          encoding: 'utf-8',
   800→        });
   801→        if (result.status !== 0) {
   802→          throw new Error(result.stderr || `git ${args.join(' ')} failed`);
   803→        }
   804→        return result.stdout.trim();
   805→      };
   806→
   807→      try {
   808→        runGit('init', '-b', 'main');
   809→        runGit('config', 'user.email', 'test@example.com');
   810→        runGit('config', 'user.name', 'Test User');
   811→
   812→        await fs.writeFile(path.join(repoDir, 'README.md'), '# test\n', 'utf-8');
   813→        runGit('add', 'README.md');
   814→        runGit('commit', '-m', 'test: initial commit');
   815→
   816→        await appendEvent(repoDir, {
   817→          type: 'session.update',
   818→          session_id: boundarySessionId,
   819→          data: {
   820→            update: {
   821→              rawInput: {
   822→                command: 'kspec task complete @task-ref --reason "Done"',
   823→              },
   824→            },
   825→          },
   826→        });
   827→
   828→        runGit('add', '.');
   829→        runGit('commit', '-m', 'test: commit boundary includes session events');
   830→
   831→        const committedFiles = runGit('show', '--name-only', '--pretty=format:', 'HEAD');
   832→        expect(committedFiles).toContain(`sessions/${boundarySessionId}/events.jsonl`);
   833→      } finally {
   834→        await fs.rm(repoDir, { recursive: true, force: true });
   835→      }
   836→    });
   837→  });
