   166→
   167→  it('should reject negative sequence number', () => {
   168→    const event = {
   169→      ts: Date.now(),
   170→      seq: -1,
   171→      type: 'session.start',
   172→      session_id: '01KF123456789ABCDEFGHJKMNP',
   173→      data: null,
   174→    };
   175→
   176→    const result = SessionEventSchema.safeParse(event);
