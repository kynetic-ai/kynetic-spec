   938→
   939→  afterEach(async () => {
   940→    await fs.rm(testDir, { recursive: true });
   941→  });
   942→
   943→  it('should return empty object when no sessions exist', async () => {
   944→    const counts = await getCompletedSessionCountsByAgent(testDir);
   945→    expect(counts).toEqual({});
   946→  });
   947→
   948→  it('should count completed sessions per agent_id', async () => {
   949→    // Create sessions with different agents and statuses
   950→    await createSession(testDir, {
   951→      id: '01KF123456789ABCDEFGHJKM01',
   952→      agent_type: 'claude-code',
   953→      agent_id: 'task-worker',
   954→    });
   955→    await updateSessionStatus(testDir, '01KF123456789ABCDEFGHJKM01', 'completed');
   956→
   957→    await createSession(testDir, {
   958→      id: '01KF123456789ABCDEFGHJKM02',
   959→      agent_type: 'claude-code',
   960→      agent_id: 'task-worker',
   961→    });
   962→    await updateSessionStatus(testDir, '01KF123456789ABCDEFGHJKM02', 'completed');
   963→
   964→    await createSession(testDir, {
   965→      id: '01KF123456789ABCDEFGHJKM03',
   966→      agent_type: 'claude-code',
   967→      agent_id: 'pr-reviewer',
   968→    });
   969→    await updateSessionStatus(testDir, '01KF123456789ABCDEFGHJKM03', 'completed');
   970→
   971→    // Active session should not be counted
   972→    await createSession(testDir, {
   973→      id: '01KF123456789ABCDEFGHJKM04',
   974→      agent_type: 'claude-code',
   975→      agent_id: 'task-worker',
   976→    });
   977→
   978→    const counts = await getCompletedSessionCountsByAgent(testDir);
   979→    expect(counts).toEqual({
   980→      'task-worker': 2,
   981→      'pr-reviewer': 1,
   982→    });
   983→  });
   984→
   985→  it('should not count abandoned or failed sessions', async () => {
   986→    await createSession(testDir, {
   987→      id: '01KF123456789ABCDEFGHJKM05',
   988→      agent_type: 'claude-code',
   989→      agent_id: 'task-worker',
   990→    });
   991→    await updateSessionStatus(testDir, '01KF123456789ABCDEFGHJKM05', 'abandoned');
   992→
   993→    await createSession(testDir, {
   994→      id: '01KF123456789ABCDEFGHJKM06',
   995→      agent_type: 'claude-code',
   996→      agent_id: 'task-worker',
   997→    });
   998→    await updateSessionStatus(testDir, '01KF123456789ABCDEFGHJKM06', 'failed');
   999→
  1000→    const counts = await getCompletedSessionCountsByAgent(testDir);
  1001→    expect(counts).toEqual({});
  1002→  });
  1003→
  1004→  it('should fall back to agent_type when agent_id is not set', async () => {
  1005→    await createSession(testDir, {
  1006→      id: '01KF123456789ABCDEFGHJKM07',
  1007→      agent_type: 'claude-code',
