   198→    );
   199→  });
   200→
   201→  it('should construct events file path', () => {
   202→    expect(getSessionEventsPath(specDir, sessionId)).toBe(
   203→      `/test/.kspec/sessions/${sessionId}/events.jsonl`
   204→    );
   205→  });
   206→});
