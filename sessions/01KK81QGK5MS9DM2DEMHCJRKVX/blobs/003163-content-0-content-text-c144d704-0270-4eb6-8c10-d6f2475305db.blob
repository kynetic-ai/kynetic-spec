    34→// ─── Store Unit Tests ───────────────────────────────────────────────────────
    35→
    36→describe('computeSessionLogStats', () => {
    37→  // AC: @session-log-stats ac-1
    38→  it('should compute totals correctly', () => {
    39→    const summaries: SessionLogSummary[] = [
    40→      {
    41→        id: 'session-1',
    42→        status: 'completed',
    43→        agent_type: 'claude-agent-acp',
    44→        started_at: '2026-01-20T10:00:00.000Z',
    45→        ended_at: '2026-01-20T11:00:00.000Z',
    46→        duration_ms: 3600000,
    47→        event_count: 100,
    48→        iteration_count: 3,
    49→        tasks_completed: 2,
    50→      },
    51→      {
    52→        id: 'session-2',
    53→        status: 'completed',
    54→        agent_type: 'claude-agent-acp',
    55→        started_at: '2026-01-21T10:00:00.000Z',
    56→        ended_at: '2026-01-21T12:00:00.000Z',
    57→        duration_ms: 7200000,
    58→        event_count: 200,
    59→        iteration_count: 5,
    60→        tasks_completed: 3,
    61→      },
    62→    ];
    63→
    64→    const stats = computeSessionLogStats(summaries);
    65→
    66→    expect(stats.total_sessions).toBe(2);
    67→    expect(stats.total_events).toBe(300);
    68→    expect(stats.total_iterations).toBe(8);
    69→    expect(stats.total_tasks_completed).toBe(5);
    70→    expect(stats.total_duration_ms).toBe(10800000);
    71→  });
    72→
    73→  // AC: @session-log-stats ac-2
    74→  it('should compute averages correctly', () => {
    75→    const summaries: SessionLogSummary[] = [
    76→      {
    77→        id: 'session-1',
    78→        status: 'completed',
    79→        agent_type: 'claude-agent-acp',
    80→        started_at: '2026-01-20T10:00:00.000Z',
    81→        ended_at: '2026-01-20T11:00:00.000Z',
    82→        duration_ms: 3600000, // 1 hour
    83→        event_count: 100,
    84→        iteration_count: 2,
    85→        tasks_completed: 4,
    86→      },
    87→      {
    88→        id: 'session-2',
    89→        status: 'completed',
    90→        agent_type: 'claude-agent-acp',
    91→        started_at: '2026-01-21T10:00:00.000Z',
    92→        ended_at: '2026-01-21T12:00:00.000Z',
    93→        duration_ms: 7200000, // 2 hours
    94→        event_count: 200,
    95→        iteration_count: 4,
    96→        tasks_completed: 6,
    97→      },
    98→    ];
    99→
   100→    const stats = computeSessionLogStats(summaries);
   101→
   102→    expect(stats.avg_duration_ms).toBe(5400000); // 1.5 hours
   103→    expect(stats.avg_iterations_per_session).toBe(3); // (2+4)/2
   104→    expect(stats.avg_tasks_per_session).toBe(5); // (4+6)/2
   105→  });
   106→
   107→  // AC: @session-log-stats ac-3
   108→  it('should compute status breakdown correctly', () => {
   109→    const summaries: SessionLogSummary[] = [
   110→      {
   111→        id: 'session-1',
   112→        status: 'completed',
   113→        agent_type: 'claude-agent-acp',
   114→        started_at: '2026-01-20T10:00:00.000Z',
   115→        ended_at: '2026-01-20T11:00:00.000Z',
   116→        duration_ms: 3600000,
   117→        event_count: 100,
   118→        iteration_count: 3,
   119→        tasks_completed: 2,
   120→      },
   121→      {
   122→        id: 'session-2',
   123→        status: 'completed',
   124→        agent_type: 'claude-agent-acp',
   125→        started_at: '2026-01-21T10:00:00.000Z',
   126→        ended_at: '2026-01-21T12:00:00.000Z',
   127→        duration_ms: 7200000,
   128→        event_count: 200,
   129→        iteration_count: 5,
   130→        tasks_completed: 3,
   131→      },
   132→      {
   133→        id: 'session-3',
   134→        status: 'active',
   135→        agent_type: 'claude-agent-acp',
   136→        started_at: '2026-01-22T10:00:00.000Z',
   137→        duration_ms: 1800000,
   138→        event_count: 50,
   139→        iteration_count: 1,
   140→        tasks_completed: 0,
   141→      },
   142→      {
   143→        id: 'session-4',
   144→        status: 'abandoned',
   145→        agent_type: 'claude-agent-acp',
   146→        started_at: '2026-01-19T10:00:00.000Z',
   147→        duration_ms: 600000,
   148→        event_count: 10,
   149→        iteration_count: 1,
   150→        tasks_completed: 0,
   151→      },
   152→    ];
   153→
   154→    const stats = computeSessionLogStats(summaries);
   155→
   156→    expect(stats.status_breakdown).toHaveLength(3);
   157→    const completed = stats.status_breakdown.find((s) => s.status === 'completed');
   158→    const active = stats.status_breakdown.find((s) => s.status === 'active');
   159→    const abandoned = stats.status_breakdown.find((s) => s.status === 'abandoned');
   160→
   161→    expect(completed).toEqual({ status: 'completed', count: 2, percentage: 50 });
   162→    expect(active).toEqual({ status: 'active', count: 1, percentage: 25 });
   163→    expect(abandoned).toEqual({ status: 'abandoned', count: 1, percentage: 25 });
   164→  });
   165→
   166→  it('should return empty stats for empty input', () => {
   167→    const stats = computeSessionLogStats([]);
   168→
   169→    expect(stats.total_sessions).toBe(0);
   170→    expect(stats.total_events).toBe(0);
   171→    expect(stats.avg_duration_ms).toBe(0);
   172→    expect(stats.status_breakdown).toEqual([]);
   173→  });
   174→});
   175→
   176→describe('computeToolUsageStats', () => {
   177→  let testDir: string;
   178→
   179→  beforeEach(async () => {
   180→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-stats-'));
   181→  });
   182→
   183→  afterEach(async () => {
   184→    await fs.rm(testDir, { recursive: true });
   185→  });
   186→
   187→  // AC: @session-log-stats ac-6
   188→  it('should count tool calls and compute percentages', async () => {
   189→    const sessionId = testUlid('SESS');
   190→    await createSession(testDir, {
   191→      id: sessionId,
   192→      agent_type: 'claude-agent-acp',
   193→    });
   194→
   195→    // Add tool call events
   196→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   197→    const events = [
   198→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Bash' } } } } },
   199→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Bash' } } } } },
   200→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Read' } } } } },
   201→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Edit' } } } } },
   202→    ].map((e, i) => JSON.stringify({ ts: Date.now(), seq: i, session_id: sessionId, ...e }));
   203→    await fs.writeFile(eventsPath, events.join('\n') + '\n');
   204→
   205→    const toolUsage = await computeToolUsageStats(testDir, [sessionId]);
   206→
   207→    expect(toolUsage).toHaveLength(3);
   208→    expect(toolUsage[0]).toEqual({ tool_name: 'Bash', count: 2, percentage: 50 });
   209→    expect(toolUsage[1]).toEqual({ tool_name: 'Read', count: 1, percentage: 25 });
   210→    expect(toolUsage[2]).toEqual({ tool_name: 'Edit', count: 1, percentage: 25 });
   211→  });
   212→
   213→  it('should limit to top N tools', async () => {
   214→    const sessionId = testUlid('SESS', 1);
   215→    await createSession(testDir, {
   216→      id: sessionId,
   217→      agent_type: 'test-agent',
   218→    });
   219→
   220→    // Add many different tools
   221→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   222→    const toolNames = ['Tool1', 'Tool2', 'Tool3', 'Tool4', 'Tool5', 'Tool6', 'Tool7', 'Tool8', 'Tool9', 'Tool10', 'Tool11', 'Tool12'];
   223→    const events = toolNames.map((name, i) =>
   224→      JSON.stringify({
   225→        ts: Date.now(),
   226→        seq: i,
   227→        type: 'session.update',
   228→        session_id: sessionId,
   229→        data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: name } } } },
   230→      })
   231→    );
   232→    await fs.writeFile(eventsPath, events.join('\n') + '\n');
   233→
   234→    // Default limit is 10
   235→    const toolUsage = await computeToolUsageStats(testDir, [sessionId]);
   236→    expect(toolUsage).toHaveLength(10);
   237→
   238→    // Custom limit
   239→    const limited = await computeToolUsageStats(testDir, [sessionId], 5);
   240→    expect(limited).toHaveLength(5);
   241→  });
   242→
   243→  it('should deduplicate phased tool_call events by toolCallId', async () => {
   244→    const sessionId = testUlid('SESS', 2);
   245→    await createSession(testDir, {
   246→      id: sessionId,
   247→      agent_type: 'claude-agent-acp',
   248→    });
   249→
   250→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   251→    const events = [
   252→      // Phase 1: Bash tool_call with empty rawInput
   253→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_001', rawInput: {}, _meta: { claudeCode: { toolName: 'Bash' } } } } },
   254→      // Phase 2: Same Bash tool_call with populated rawInput (phased duplicate)
   255→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_001', rawInput: { command: 'npm test' }, _meta: { claudeCode: { toolName: 'Bash' } } } } },
   256→      // Different tool_call (not a duplicate)
   257→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_002', rawInput: { file_path: '/src/main.ts' }, _meta: { claudeCode: { toolName: 'Read' } } } } },
   258→      // Another Bash with no duplicate
   259→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_003', rawInput: { command: 'git status' }, _meta: { claudeCode: { toolName: 'Bash' } } } } },
   260→    ].map((e, i) => JSON.stringify({ ts: Date.now(), seq: i, session_id: sessionId, ...e }));
   261→    await fs.writeFile(eventsPath, events.join('\n') + '\n');
   262→
   263→    const toolUsage = await computeToolUsageStats(testDir, [sessionId]);
   264→
   265→    // Should count 3 unique tool calls (not 4 with the phased duplicate)
   266→    const totalCount = toolUsage.reduce((sum, t) => sum + t.count, 0);
   267→    expect(totalCount).toBe(3);
   268→    expect(toolUsage.find(t => t.tool_name === 'Bash')?.count).toBe(2);
   269→    expect(toolUsage.find(t => t.tool_name === 'Read')?.count).toBe(1);
   270→  });
   271→});
   272→
   273→describe('computeTimePeriodStats', () => {
   274→  // AC: @session-log-stats ac-7
   275→  it('should group by day correctly', () => {
   276→    const summaries: SessionLogSummary[] = [
   277→      {
   278→        id: 'session-1',
   279→        status: 'completed',
   280→        agent_type: 'claude-agent-acp',
   281→        started_at: '2026-01-20T10:00:00.000Z',
   282→        duration_ms: 3600000,
   283→        event_count: 100,
   284→        iteration_count: 3,
   285→        tasks_completed: 2,
   286→      },
   287→      {
   288→        id: 'session-2',
   289→        status: 'completed',
   290→        agent_type: 'claude-agent-acp',
   291→        started_at: '2026-01-20T14:00:00.000Z',
   292→        duration_ms: 7200000,
   293→        event_count: 200,
   294→        iteration_count: 5,
   295→        tasks_completed: 3,
   296→      },
   297→      {
   298→        id: 'session-3',
   299→        status: 'completed',
   300→        agent_type: 'claude-agent-acp',
   301→        started_at: '2026-01-21T10:00:00.000Z',
   302→        duration_ms: 1800000,
   303→        event_count: 50,
   304→        iteration_count: 1,
   305→        tasks_completed: 1,
   306→      },
   307→    ];
   308→
   309→    const periods = computeTimePeriodStats(summaries, 'day');
   310→
   311→    expect(periods).toHaveLength(2);
   312→    // Sorted newest first
   313→    expect(periods[0].period).toBe('2026-01-21');
   314→    expect(periods[0].sessions_count).toBe(1);
   315→    expect(periods[0].tasks_completed).toBe(1);
   316→    expect(periods[0].total_duration_ms).toBe(1800000);
   317→
   318→    expect(periods[1].period).toBe('2026-01-20');
   319→    expect(periods[1].sessions_count).toBe(2);
   320→    expect(periods[1].tasks_completed).toBe(5); // 2 + 3
   321→    expect(periods[1].total_duration_ms).toBe(10800000); // 3600000 + 7200000
   322→  });
   323→
   324→  it('should group by week correctly', () => {
   325→    const summaries: SessionLogSummary[] = [
   326→      {
   327→        id: 'session-1',
   328→        status: 'completed',
   329→        agent_type: 'claude-agent-acp',
   330→        started_at: '2026-01-20T10:00:00.000Z', // 2026-01-20 is a Tuesday in week 4
   331→        duration_ms: 3600000,
   332→        event_count: 100,
   333→        iteration_count: 3,
   334→        tasks_completed: 2,
   335→      },
   336→      {
   337→        id: 'session-2',
   338→        status: 'completed',
   339→        agent_type: 'claude-agent-acp',
   340→        started_at: '2026-01-27T10:00:00.000Z', // 2026-01-27 is a Tuesday in week 5
   341→        duration_ms: 7200000,
   342→        event_count: 200,
   343→        iteration_count: 5,
   344→        tasks_completed: 3,
   345→      },
   346→    ];
   347→
   348→    const periods = computeTimePeriodStats(summaries, 'week');
   349→
   350→    expect(periods).toHaveLength(2);
   351→    // Should have week numbers in format YYYY-Www
   352→    for (const p of periods) {
   353→      expect(p.period).toMatch(/^\d{4}-W\d{2}$/);
   354→    }
   355→    // Verify concrete week assignments
   356→    expect(periods[0].period).toBe('2026-W05');
   357→    expect(periods[1].period).toBe('2026-W04');
   358→  });
   359→
   360→  it('should handle year boundary week correctly (ISO-8601)', () => {
   361→    // Test ISO-8601 week rules at year boundaries:
   362→    // - 2025-12-29 (Monday) to 2026-01-04 (Sunday) is Week 1 of 2026
   363→    // - 2025-12-28 (Sunday) is Week 52 of 2025
   364→    const summaries: SessionLogSummary[] = [
   365→      {
   366→        id: 'session-1',
   367→        status: 'completed',
   368→        agent_type: 'claude-agent-acp',
   369→        started_at: '2025-12-28T10:00:00.000Z', // Sunday - still week 52 of 2025
   370→        duration_ms: 1000,
   371→        event_count: 1,
   372→        iteration_count: 1,
   373→        tasks_completed: 0,
   374→      },
   375→      {
   376→        id: 'session-2',
   377→        status: 'completed',
   378→        agent_type: 'claude-agent-acp',
   379→        started_at: '2025-12-29T00:00:00.000Z', // Monday - week 1 of 2026 per ISO-8601
   380→        duration_ms: 1000,
   381→        event_count: 1,
   382→        iteration_count: 1,
   383→        tasks_completed: 0,
   384→      },
   385→      {
   386→        id: 'session-3',
   387→        status: 'completed',
   388→        agent_type: 'claude-agent-acp',
   389→        started_at: '2026-01-01T00:00:00.000Z', // Thursday - still week 1 of 2026
   390→        duration_ms: 1000,
   391→        event_count: 1,
   392→        iteration_count: 1,
   393→        tasks_completed: 0,
   394→      },
   395→      {
   396→        id: 'session-4',
   397→        status: 'completed',
   398→        agent_type: 'claude-agent-acp',
   399→        started_at: '2026-01-05T00:00:00.000Z', // Monday - week 2 of 2026
   400→        duration_ms: 1000,
   401→        event_count: 1,
   402→        iteration_count: 1,
   403→        tasks_completed: 0,
   404→      },
   405→    ];
   406→
   407→    const periods = computeTimePeriodStats(summaries, 'week');
   408→
   409→    // Should have 3 distinct weeks: 2025-W52, 2026-W01, 2026-W02
   410→    expect(periods).toHaveLength(3);
   411→    const periodSet = new Set(periods.map((p) => p.period));
   412→    expect(periodSet.has('2025-W52')).toBe(true);
   413→    expect(periodSet.has('2026-W01')).toBe(true);
   414→    expect(periodSet.has('2026-W02')).toBe(true);
   415→
   416→    // Verify session counts per week
   417→    const week52 = periods.find((p) => p.period === '2025-W52');
   418→    const week01 = periods.find((p) => p.period === '2026-W01');
   419→    const week02 = periods.find((p) => p.period === '2026-W02');
   420→    expect(week52?.sessions_count).toBe(1);
   421→    expect(week01?.sessions_count).toBe(2); // Dec 29 and Jan 1
   422→    expect(week02?.sessions_count).toBe(1);
   423→  });
   424→});
