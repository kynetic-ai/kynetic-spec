   710→describe('deduplicatePhasedToolCalls', () => {
   711→  it('should remove empty-input duplicates when populated version exists', () => {
   712→    const events = [
   713→      // tool_call with empty rawInput
   714→      { ts: 1000, seq: 0, type: 'session.update' as const, session_id: 'sess1', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_001', rawInput: {}, _meta: { claudeCode: { toolName: 'Bash' } } } } },
   715→      // Same tool_call with populated rawInput
   716→      { ts: 1001, seq: 1, type: 'session.update' as const, session_id: 'sess1', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_001', rawInput: { command: 'npm test' }, _meta: { claudeCode: { toolName: 'Bash' } } } } },
   717→      // Different tool_call (should be kept)
   718→      { ts: 1002, seq: 2, type: 'session.update' as const, session_id: 'sess1', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_002', rawInput: { file_path: '/src/main.ts' }, _meta: { claudeCode: { toolName: 'Read' } } } } },
   719→      // Non tool_call event (should be kept)
   720→      { ts: 1003, seq: 3, type: 'session.update' as const, session_id: 'sess1', data: { update: { sessionUpdate: 'agent_thought' } } },
   721→    ];
   722→
   723→    const result = deduplicatePhasedToolCalls(events);
   724→    expect(result).toHaveLength(3);
   725→    // The populated version should be kept
   726→    expect((result[0].data as any).update.rawInput.command).toBe('npm test');
   727→    // Other events should be unchanged
   728→    expect((result[1].data as any).update.toolCallId).toBe('toolu_002');
   729→    expect((result[2].data as any).update.sessionUpdate).toBe('agent_thought');
   730→  });
   731→
   732→  it('should keep single tool_call events (no phased duplicate)', () => {
   733→    const events = [
   734→      { ts: 1000, seq: 0, type: 'session.update' as const, session_id: 'sess1', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_001', rawInput: { command: 'npm test' }, _meta: { claudeCode: { toolName: 'Bash' } } } } },
   735→    ];
   736→
   737→    const result = deduplicatePhasedToolCalls(events);
   738→    expect(result).toHaveLength(1);
   739→  });
   740→
   741→  it('should keep empty-input tool_call when no populated version exists', () => {
   742→    const events = [
   743→      { ts: 1000, seq: 0, type: 'session.update' as const, session_id: 'sess1', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_001', rawInput: {}, _meta: { claudeCode: { toolName: 'Bash' } } } } },
   744→    ];
   745→
   746→    const result = deduplicatePhasedToolCalls(events);
   747→    expect(result).toHaveLength(1);
   748→  });
   749→});
