   426→// ─── CLI Integration Tests ──────────────────────────────────────────────────
   427→
   428→describe('kspec session log stats (CLI)', () => {
   429→  let tempDir: string;
   430→
   431→  beforeEach(async () => {
   432→    tempDir = await setupTempFixtures();
   433→
   434→    // Create sessions directory
   435→    const sessionsDir = path.join(tempDir, 'sessions');
   436→    await fs.mkdir(sessionsDir, { recursive: true });
   437→
   438→    // Session 1: completed, 2026-01-15
   439→    const s1 = testUlid('SESS', 1);
   440→    const s1Dir = path.join(sessionsDir, s1);
   441→    await fs.mkdir(s1Dir);
   442→    await fs.writeFile(path.join(s1Dir, 'session.yaml'), YAML.stringify({
   443→      id: s1,
   444→      agent_type: 'claude-agent-acp',
   445→      status: 'completed',
   446→      started_at: '2026-01-15T10:00:00.000Z',
   447→      ended_at: '2026-01-15T11:30:00.000Z',
   448→    }));
   449→    await fs.writeFile(path.join(s1Dir, 'events.jsonl'), [
   450→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s1, data: null }),
   451→      JSON.stringify({ ts: 2000, seq: 1, type: 'session.update', session_id: s1, data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Bash' } } } } }),
   452→      JSON.stringify({ ts: 3000, seq: 2, type: 'session.end', session_id: s1, data: null }),
   453→    ].join('\n') + '\n');
   454→    await fs.writeFile(path.join(s1Dir, 'context-iter-1.json'), '{}');
   455→
   456→    // Session 2: active, 2026-02-05
   457→    const s2 = testUlid('SESS', 2);
   458→    const s2Dir = path.join(sessionsDir, s2);
   459→    await fs.mkdir(s2Dir);
   460→    await fs.writeFile(path.join(s2Dir, 'session.yaml'), YAML.stringify({
   461→      id: s2,
   462→      agent_type: 'custom-agent',
   463→      status: 'active',
   464→      started_at: '2026-02-05T08:00:00.000Z',
   465→    }));
   466→    await fs.writeFile(path.join(s2Dir, 'events.jsonl'), [
   467→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s2, data: null }),
   468→      JSON.stringify({ ts: 2000, seq: 1, type: 'session.update', session_id: s2, data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Read' } } } } }),
   469→      JSON.stringify({ ts: 3000, seq: 2, type: 'session.update', session_id: s2, data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Read' } } } } }),
   470→      JSON.stringify({ ts: 4000, seq: 3, type: 'session.update', session_id: s2, data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Edit' } } } } }),
   471→      JSON.stringify({ ts: 5000, seq: 4, type: 'prompt.sent', session_id: s2, data: null }),
   472→    ].join('\n') + '\n');
   473→    await fs.writeFile(path.join(s2Dir, 'context-iter-1.json'), '{}');
   474→    await fs.writeFile(path.join(s2Dir, 'context-iter-2.json'), '{}');
   475→    await fs.writeFile(path.join(s2Dir, 'context-iter-3.json'), '{}');
   476→
   477→    // Session 3: completed, 2026-02-04 with task completion
   478→    const s3 = testUlid('SESS', 3);
   479→    const s3Dir = path.join(sessionsDir, s3);
   480→    await fs.mkdir(s3Dir);
   481→    await fs.writeFile(path.join(s3Dir, 'session.yaml'), YAML.stringify({
   482→      id: s3,
   483→      agent_type: 'claude-agent-acp',
   484→      status: 'completed',
   485→      started_at: '2026-02-04T14:00:00.000Z',
   486→      ended_at: '2026-02-04T15:00:00.000Z',
   487→    }));
   488→    await fs.writeFile(path.join(s3Dir, 'events.jsonl'), [
   489→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s3, data: null }),
