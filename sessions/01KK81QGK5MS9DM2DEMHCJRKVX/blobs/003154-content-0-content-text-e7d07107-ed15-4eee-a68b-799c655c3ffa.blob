   389→      {
   390→        expectFail: true,
   391→        stdin: "n",
   392→        env: {
   393→          KSPEC_TEST_TTY: "1",
   394→        },
   395→      },
   396→    );
   397→
   398→    expect(result.exitCode).toBe(2);
   399→    expect(result.stderr).toContain("Operation cancelled");
   400→  });
   401→
   402→  // AC: @trait-confirmation-prompt ac-2
   403→  it("proceeds when user confirms interactive prompt in single-target mode", async () => {
   404→    const staleId = testUlid("SESS", 15);
   405→    await createActiveSession(
   406→      staleId,
   407→      "2024-01-01T00:00:00.000Z",
   408→      "2024-01-02T00:00:00.000Z",
   409→    );
   410→
   411→    const result = kspec(
   412→      `session stale close ${staleId} --older-than 24h --inactive-for 6h`,
   413→      tempDir,
   414→      {
   415→        stdin: "yes",
   416→        env: {
   417→          KSPEC_TEST_TTY: "1",
   418→        },
   419→      },
   420→    );
   421→
   422→    expect(result.exitCode).toBe(0);
   423→    expect(result.stdout).toContain("Auto-abandon this stale session? [y/N]");
   424→
   425→    const session = await getSession(tempDir, staleId);
