   428→  });
   429→
   430→  // AC: @trait-confirmation-prompt ac-5
   431→  it("uses a single confirmation prompt for destructive --refs batch mode", async () => {
   432→    const staleA = testUlid("SESS", 16);
   433→    const staleB = testUlid("SESS", 17);
   434→    await createActiveSession(
   435→      staleA,
   436→      "2024-01-01T00:00:00.000Z",
   437→      "2024-01-02T00:00:00.000Z",
   438→    );
   439→    await createActiveSession(
   440→      staleB,
   441→      "2024-01-01T00:00:00.000Z",
   442→      "2024-01-02T00:00:00.000Z",
   443→    );
   444→
   445→    const result = kspec(
   446→      `session stale close --refs ${staleA} ${staleB} --older-than 24h --inactive-for 6h`,
   447→      tempDir,
   448→      {
   449→        stdin: "y",
   450→        env: {
   451→          KSPEC_TEST_TTY: "1",
   452→        },
   453→      },
   454→    );
   455→
   456→    expect(result.exitCode).toBe(0);
   457→    const promptCount = result.stdout.match(/from --refs\? \[y\/N\]/g)?.length ?? 0;
   458→    expect(promptCount).toBe(1);
   459→
   460→    const first = await getSession(tempDir, staleA);
   461→    const second = await getSession(tempDir, staleB);
   462→    expect(first?.status).toBe("abandoned");
   463→    expect(second?.status).toBe("abandoned");
   464→  });
