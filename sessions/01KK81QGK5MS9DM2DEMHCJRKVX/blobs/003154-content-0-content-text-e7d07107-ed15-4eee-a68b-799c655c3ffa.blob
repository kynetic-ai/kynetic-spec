     1→/**
     2→ * Session stale close command tests.
     3→ *
     4→ * Task: @implement-stale-active-session-cleanup
     5→ * Spec: @session-stale-cleanup
     6→ */
     7→
     8→import { afterEach, beforeEach, describe, expect, it } from "vitest";
     9→import * as fs from "node:fs/promises";
    10→import {
    11→  appendEvent,
    12→  createSession,
    13→  getSession,
    14→  getSessionEventsPath,
    15→  updateSessionStatus,
    16→} from "../src/sessions/store.js";
    17→import {
    18→  cleanupTempDir,
    19→  kspec,
    20→  kspecJson,
    21→  setupTempFixtures,
    22→  testUlid,
    23→} from "./helpers/cli.js";
    24→
    25→interface SessionStaleCloseJson {
    26→  dry_run: boolean;
    27→  mode: "single" | "refs" | "all";
    28→  criteria: {
    29→    older_than: string;
    30→    inactive_for: string;
    31→    liveness_guard: string;
    32→  };
    33→  sessions: Array<{
    34→    session_id: string;
    35→    status: string;
    36→    reason: string;
    37→    close_reason?: string;
    38→  }>;
    39→  totals: {
    40→    active_sessions_total: number;
    41→    sessions_evaluated: number;
    42→    candidates: number;
    43→    changed_sessions: number;
    44→    skipped_sessions: number;
    45→    failures: number;
    46→  };
    47→}
    48→
    49→interface JsonErrorPayload {
    50→  success: false;
    51→  error: string;
    52→  details?: {
    53→    field?: string;
    54→    value?: string;
    55→    guidance?: string;
    56→  };
    57→}
    58→
    59→describe("session stale close", () => {
    60→  let tempDir: string;
    61→
    62→  beforeEach(async () => {
    63→    tempDir = await setupTempFixtures();
    64→  });
    65→
    66→  afterEach(async () => {
    67→    await cleanupTempDir(tempDir);
    68→  });
    69→
    70→  async function createActiveSession(
    71→    sessionId: string,
    72→    startedAt: string,
    73→    lastActivityAt?: string,
    74→  ): Promise<void> {
    75→    await createSession(tempDir, {
    76→      id: sessionId,
    77→      agent_type: "test-agent",
    78→      status: "active",
    79→      started_at: startedAt,
    80→    });
    81→
    82→    if (lastActivityAt) {
    83→      await appendEvent(tempDir, {
    84→        session_id: sessionId,
    85→        type: "session.update",
    86→        ts: new Date(lastActivityAt).getTime(),
    87→        data: { update: "heartbeat" },
    88→      });
    89→    }
    90→  }
    91→
    92→  // AC: @session-stale-cleanup ac-1
    93→  // AC: @trait-dry-run ac-1
    94→  // AC: @trait-dry-run ac-2
    95→  // AC: @trait-dry-run ac-3
    96→  // AC: @trait-dry-run ac-6
    97→  // AC: @trait-json-output ac-1
    98→  // AC: @trait-json-output ac-2
    99→  it("reports would-close sessions in --all --dry-run with per-session reasons", async () => {
   100→    const staleId = testUlid("SESS", 1);
   101→    await createActiveSession(
   102→      staleId,
   103→      "2024-01-01T00:00:00.000Z",
   104→      "2024-01-02T00:00:00.000Z",
   105→    );
   106→
   107→    const result = kspecJson<SessionStaleCloseJson>(
   108→      "session stale close --all --dry-run --older-than 24h --inactive-for 6h",
   109→      tempDir,
   110→    );
   111→
   112→    expect(result.mode).toBe("all");
   113→    expect(result.dry_run).toBe(true);
   114→    expect(result.totals.candidates).toBe(1);
   115→    expect(result.totals.changed_sessions).toBe(0);
   116→    expect(result.sessions[0].status).toBe("would_abandon");
   117→    expect(result.sessions[0].reason).toContain("dry run");
   118→    expect(result.sessions[0].close_reason?.startsWith("auto-abandoned:")).toBe(
   119→      true,
   120→    );
   121→
   122→    const unchanged = await getSession(tempDir, staleId);
   123→    expect(unchanged?.status).toBe("active");
   124→    expect(unchanged?.ended_at).toBeUndefined();
   125→  });
   126→
   127→  // AC: @session-stale-cleanup ac-2
   128→  // AC: @trait-confirmation-prompt ac-4
   129→  it("closes only the targeted stale active session in single-target mode", async () => {
   130→    const targetId = testUlid("SESS", 2);
   131→    const otherId = testUlid("SESS", 3);
   132→    await createActiveSession(
   133→      targetId,
   134→      "2024-01-01T00:00:00.000Z",
   135→      "2024-01-02T00:00:00.000Z",
   136→    );
   137→    await createActiveSession(
   138→      otherId,
   139→      "2024-01-01T00:00:00.000Z",
   140→      "2024-01-02T00:00:00.000Z",
   141→    );
   142→
   143→    const output = kspecJson<SessionStaleCloseJson>(
   144→      `session stale close ${targetId} --older-than 24h --inactive-for 6h --force`,
   145→      tempDir,
   146→    );
   147→
   148→    expect(output.mode).toBe("single");
   149→    expect(output.totals.changed_sessions).toBe(1);
   150→
   151→    const target = await getSession(tempDir, targetId);
   152→    const other = await getSession(tempDir, otherId);
   153→    expect(target?.status).toBe("abandoned");
   154→    expect(target?.close_reason?.startsWith("auto-abandoned:")).toBe(true);
   155→    expect(other?.status).toBe("active");
   156→  });
   157→
   158→  // AC: @session-stale-cleanup ac-3
   159→  // AC: @trait-semantic-exit-codes ac-1
   160→  // AC: @trait-semantic-exit-codes ac-5
   161→  it("returns success with zero changes when no sessions match stale criteria", async () => {
   162→    const recentId = testUlid("SESS", 4);
   163→    await createActiveSession(recentId, new Date().toISOString());
   164→
   165→    const output = kspecJson<SessionStaleCloseJson>(
   166→      `session stale close ${recentId} --older-than 24h --inactive-for 6h --force`,
   167→      tempDir,
   168→    );
   169→
   170→    expect(output.totals.candidates).toBe(0);
   171→    expect(output.totals.changed_sessions).toBe(0);
   172→    expect(output.sessions[0].status).toBe("not_candidate");
   173→
   174→    const session = await getSession(tempDir, recentId);
   175→    expect(session?.status).toBe("active");
   176→  });
   177→
   178→  // AC: @session-stale-cleanup ac-4
   179→  // AC: @session-stale-cleanup ac-5
   180→  it("reports all-mode totals for candidates, changed, skipped, and failures", async () => {
   181→    const staleId = testUlid("SESS", 5);
   182→    const freshId = testUlid("SESS", 6);
   183→    const brokenId = testUlid("SESS", 7);
   184→
   185→    await createActiveSession(
   186→      staleId,
   187→      "2024-01-01T00:00:00.000Z",
   188→      "2024-01-02T00:00:00.000Z",
   189→    );
   190→    await createActiveSession(freshId, new Date().toISOString());
   191→    await createActiveSession(
   192→      brokenId,
   193→      "2024-01-01T00:00:00.000Z",
   194→      undefined,
   195→    );
   196→    await fs.mkdir(getSessionEventsPath(tempDir, brokenId), { recursive: true });
   197→
   198→    const dryRun = kspecJson<SessionStaleCloseJson>(
   199→      "session stale close --all --dry-run --older-than 24h --inactive-for 6h",
   200→      tempDir,
   201→    );
   202→    expect(dryRun.totals.candidates).toBe(1);
   203→    expect(dryRun.totals.skipped_sessions).toBe(2);
   204→    expect(dryRun.totals.failures).toBe(1);
   205→
   206→    const apply = kspecJson<SessionStaleCloseJson>(
   207→      "session stale close --all --older-than 24h --inactive-for 6h --force",
   208→      tempDir,
   209→    );
   210→    expect(apply.totals.changed_sessions).toBe(1);
   211→    expect(apply.totals.candidates).toBe(1);
   212→
   213→    const stale = await getSession(tempDir, staleId);
   214→    const fresh = await getSession(tempDir, freshId);
   215→    const broken = await getSession(tempDir, brokenId);
   216→    expect(stale?.status).toBe("abandoned");
   217→    expect(fresh?.status).toBe("active");
   218→    expect(broken?.status).toBe("active");
   219→  });
   220→
   221→  // AC: @session-stale-cleanup ac-6
   222→  // AC: @trait-semantic-exit-codes ac-6
   223→  it("errors when no target mode is provided", async () => {
   224→    const result = kspec("session stale close", tempDir, { expectFail: true });
   225→    expect(result.exitCode).toBe(2);
   226→    expect(result.stderr).toContain("Missing target");
   227→    expect(result.stderr).toContain("<session-id>, --refs, or --all");
   228→  });
   229→
   230→  // AC: @session-stale-cleanup ac-7
   231→  it("errors when positional target and --all are combined", async () => {
   232→    const sessionId = testUlid("SESS", 8);
   233→    await createActiveSession(sessionId, "2024-01-01T00:00:00.000Z");
   234→
   235→    const result = kspec(
   236→      `session stale close ${sessionId} --all`,
   237→      tempDir,
   238→      { expectFail: true },
   239→    );
   240→    expect(result.exitCode).toBe(2);
   241→    expect(result.stderr).toContain("Cannot use <session-id> together with --all");
   242→  });
   243→
   244→  // AC: @session-stale-cleanup ac-8
   245→  // AC: @trait-multi-ref-batch ac-1
   246→  // AC: @trait-multi-ref-batch ac-3
   247→  // AC: @trait-multi-ref-batch ac-8
   248→  it("evaluates unique sessions only once in --refs mode", async () => {
   249→    const staleId = testUlid("SESS", 9);
   250→    const freshId = testUlid("SESS", 10);
   251→    await createActiveSession(
   252→      staleId,
   253→      "2024-01-01T00:00:00.000Z",
   254→      "2024-01-02T00:00:00.000Z",
   255→    );
   256→    await createActiveSession(freshId, new Date().toISOString());
   257→
   258→    const output = kspecJson<SessionStaleCloseJson>(
   259→      `session stale close --refs ${staleId} ${staleId} ${freshId} --dry-run --older-than 24h --inactive-for 6h`,
   260→      tempDir,
   261→    );
   262→
   263→    const staleRows = output.sessions.filter((row) => row.session_id === staleId);
   264→    expect(staleRows).toHaveLength(1);
   265→    expect(output.totals.sessions_evaluated).toBe(2);
   266→  });
   267→
   268→  // AC: @session-stale-cleanup ac-9
   269→  // AC: @trait-multi-ref-batch ac-6
   270→  it("errors when --refs is combined with --all or positional target", async () => {
   271→    const sessionId = testUlid("SESS", 11);
   272→    await createActiveSession(sessionId, "2024-01-01T00:00:00.000Z");
   273→
   274→    const withAll = kspec(
   275→      `session stale close --refs ${sessionId} --all`,
   276→      tempDir,
   277→      { expectFail: true },
   278→    );
   279→    expect(withAll.exitCode).toBe(2);
   280→    expect(withAll.stderr).toContain("Cannot use --refs together with --all");
   281→
   282→    const withPositional = kspec(
   283→      `session stale close ${sessionId} --refs ${sessionId}`,
   284→      tempDir,
   285→      { expectFail: true },
   286→    );
   287→    expect(withPositional.exitCode).toBe(2);
   288→    expect(withPositional.stderr).toContain("Cannot use <session-id> together with --refs");
   289→  });
   290→
   291→  // AC: @trait-multi-ref-batch ac-2
   292→  // AC: @trait-multi-ref-batch ac-4
   293→  // AC: @trait-multi-ref-batch ac-5
   294→  // AC: @trait-multi-ref-batch ac-7
   295→  // AC: @trait-dry-run ac-4
   296→  // AC: @trait-error-guidance ac-1
   297→  // AC: @trait-error-guidance ac-2
   298→  // AC: @trait-error-guidance ac-3
   299→  // AC: @trait-error-guidance ac-6
   300→  it("continues refs batch after resolution errors and returns partial-failure exit", async () => {
   301→    const staleId = testUlid("SESS", 12);
   302→    await createActiveSession(
   303→      staleId,
   304→      "2024-01-01T00:00:00.000Z",
   305→      "2024-01-02T00:00:00.000Z",
   306→    );
   307→
   308→    const result = kspec(
   309→      `session stale close --refs ${staleId} BADREF --dry-run --older-than 24h --inactive-for 6h --json`,
   310→      tempDir,
   311→      { expectFail: true },
   312→    );
   313→    expect(result.exitCode).toBe(1);
   314→
   315→    const payload = JSON.parse(result.stdout) as SessionStaleCloseJson;
   316→    expect(payload.totals.candidates).toBe(1);
   317→    expect(payload.totals.changed_sessions).toBe(0);
   318→    expect(payload.totals.failures).toBe(1);
   319→    expect(payload.sessions.some((row) => row.status === "resolution_error")).toBe(
   320→      true,
   321→    );
   322→    const resolutionError = payload.sessions.find(
   323→      (row) => row.status === "resolution_error",
   324→    );
   325→    expect(resolutionError?.reason).toContain("Session not found");
   326→    expect(resolutionError?.reason).toContain("kspec session list --status active");
   327→
   328→    const unchanged = await getSession(tempDir, staleId);
   329→    expect(unchanged?.status).toBe("active");
   330→  });
   331→
   332→  // AC: @trait-json-output ac-3
   333→  it("returns structured JSON errors in --json mode", async () => {
   334→    const result = kspec("session stale close --json", tempDir, { expectFail: true });
   335→    expect(result.exitCode).toBe(2);
   336→
   337→    const payload = JSON.parse(result.stderr) as JsonErrorPayload;
   338→    expect(payload.success).toBe(false);
   339→    expect(payload.error).toContain("Missing target");
   340→  });
   341→
   342→  // AC: @trait-error-guidance ac-5
   343→  it("includes validation field/value details for invalid criteria in JSON mode", async () => {
   344→    const result = kspec(
   345→      "session stale close --all --older-than nope --json",
   346→      tempDir,
   347→      { expectFail: true },
   348→    );
   349→    expect(result.exitCode).toBe(2);
   350→
   351→    const payload = JSON.parse(result.stderr) as JsonErrorPayload;
   352→    expect(payload.error).toContain("Invalid value for --older-than");
   353→    expect(payload.details?.field).toBe("older-than");
   354→    expect(payload.details?.value).toBe("nope");
   355→  });
   356→
   357→  // AC: @trait-confirmation-prompt ac-1
   358→  // AC: @trait-confirmation-prompt ac-6
   359→  it("requires --force in non-interactive destructive mode", async () => {
   360→    const staleId = testUlid("SESS", 13);
   361→    await createActiveSession(
   362→      staleId,
   363→      "2024-01-01T00:00:00.000Z",
   364→      "2024-01-02T00:00:00.000Z",
   365→    );
   366→
   367→    const result = kspec(
   368→      `session stale close ${staleId} --older-than 24h --inactive-for 6h`,
   369→      tempDir,
   370→      { expectFail: true },
   371→    );
   372→    expect(result.exitCode).toBe(2);
   373→    expect(result.stderr).toContain("Non-interactive environment. Use --force to proceed");
   374→  });
   375→
   376→  // AC: @trait-confirmation-prompt ac-3
   377→  // AC: @trait-semantic-exit-codes ac-3
   378→  it("returns cancellation exit when user declines interactive confirmation", async () => {
   379→    const staleId = testUlid("SESS", 14);
   380→    await createActiveSession(
   381→      staleId,
   382→      "2024-01-01T00:00:00.000Z",
   383→      "2024-01-02T00:00:00.000Z",
   384→    );
   385→
   386→    const result = kspec(
   387→      `session stale close ${staleId} --older-than 24h --inactive-for 6h`,
