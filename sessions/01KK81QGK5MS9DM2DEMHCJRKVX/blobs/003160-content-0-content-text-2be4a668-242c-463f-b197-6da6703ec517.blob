    45→// ─── Library Function: createSessionWithBudget ──────────────────────────────
    46→
    47→describe("createSessionWithBudget", () => {
    48→  let testDir: string;
    49→
    50→  beforeEach(async () => {
    51→    testDir = await createTempDir("kspec-session-create-");
    52→    // Create sessions directory
    53→    await fs.mkdir(path.join(testDir, "sessions"), { recursive: true });
    54→  });
    55→
    56→  afterEach(async () => {
    57→    await cleanupTempDir(testDir);
    58→  });
    59→
    60→  // AC: @session-creation-and-env-injection ac-create
    61→  it("should create a session with status active and return metadata", async () => {
    62→    const sessionId = testUlid("SESS", 1);
    63→    const result = await createSessionWithBudget(testDir, {
    64→      id: sessionId,
    65→      agent_type: "claude-code",
    66→    });
    67→
    68→    expect(result.session_id).toBe(sessionId);
    69→    expect(result.session.id).toBe(sessionId);
    70→    expect(result.session.status).toBe("active");
    71→    expect(result.session.agent_type).toBe("claude-code");
    72→    expect(result.session.started_at).toBeTruthy();
    73→    expect(result.budget).toBeNull();
    74→  });
    75→
    76→  // AC: @session-creation-and-env-injection ac-create
    77→  it("should create session directory with session.yaml", async () => {
    78→    const sessionId = testUlid("SESS", 2);
    79→    await createSessionWithBudget(testDir, {
    80→      id: sessionId,
    81→      agent_type: "codex-cli",
    82→    });
    83→
    84→    const sessionDir = path.join(testDir, "sessions", sessionId);
    85→    const stat = await fs.stat(sessionDir);
    86→    expect(stat.isDirectory()).toBe(true);
    87→
    88→    const metadataPath = path.join(sessionDir, "session.yaml");
    89→    const content = await fs.readFile(metadataPath, "utf-8");
    90→    expect(content).toContain("status: active");
    91→    expect(content).toContain("agent_type: codex-cli");
    92→  });
    93→
    94→  // AC: @session-creation-and-env-injection ac-budget
    95→  it("should create budget.json when budget option provided", async () => {
    96→    const sessionId = testUlid("SESS", 3);
    97→    const result = await createSessionWithBudget(testDir, {
    98→      id: sessionId,
    99→      agent_type: "claude-code",
   100→      budget: 5,
   101→    });
   102→
   103→    expect(result.budget).not.toBeNull();
   104→    expect(result.budget!.max_per_cycle).toBe(5);
   105→    expect(result.budget!.started_this_cycle).toBe(0);
   106→  });
   107→
   108→  // AC: @session-creation-and-env-injection ac-budget-local
   109→  it("should store budget.json on local filesystem in session directory", async () => {
   110→    const sessionId = testUlid("SESS", 4);
   111→    await createSessionWithBudget(testDir, {
   112→      id: sessionId,
   113→      agent_type: "claude-code",
   114→      budget: 3,
   115→    });
   116→
   117→    const budgetPath = getSessionBudgetPath(testDir, sessionId);
   118→    const content = await fs.readFile(budgetPath, "utf-8");
   119→    const budget = JSON.parse(content);
   120→    expect(budget.max_per_cycle).toBe(3);
   121→    expect(budget.started_this_cycle).toBe(0);
   122→    // Verify it's in the expected location
   123→    expect(budgetPath).toContain(path.join("sessions", sessionId, "budget.json"));
   124→  });
   125→
   126→  // AC: @session-creation-and-env-injection ac-library
   127→  it("should return metadata without console output", async () => {
   128→    const sessionId = testUlid("SESS", 5);
   129→    // Capture console output
   130→    const consoleLogs: string[] = [];
   131→    const originalLog = console.log;
   132→    console.log = (...args: unknown[]) => consoleLogs.push(args.join(" "));
   133→
   134→    try {
   135→      const result = await createSessionWithBudget(testDir, {
   136→        id: sessionId,
   137→        agent_type: "claude-code",
   138→        budget: 2,
   139→      });
   140→
   141→      // Library function should not produce console output
   142→      expect(consoleLogs).toHaveLength(0);
   143→
   144→      // Should return complete metadata
   145→      expect(result.session_id).toBe(sessionId);
   146→      expect(result.session.id).toBe(sessionId);
   147→      expect(result.session.status).toBe("active");
   148→      expect(result.budget).not.toBeNull();
   149→      expect(result.budget!.max_per_cycle).toBe(2);
   150→    } finally {
   151→      console.log = originalLog;
   152→    }
   153→  });
   154→
   155→  it("should include task_id when provided", async () => {
   156→    const sessionId = testUlid("SESS", 6);
   157→    const taskId = testUlid("TASK", 1);
   158→    const result = await createSessionWithBudget(testDir, {
   159→      id: sessionId,
   160→      agent_type: "claude-code",
   161→      task_id: taskId,
   162→    });
   163→
   164→    expect(result.session.task_id).toBe(taskId);
   165→  });
   166→
   167→  it("should not create budget when budget is undefined", async () => {
   168→    const sessionId = testUlid("SESS", 7);
   169→    const result = await createSessionWithBudget(testDir, {
   170→      id: sessionId,
   171→      agent_type: "claude-code",
   172→    });
   173→
   174→    expect(result.budget).toBeNull();
   175→
   176→    // Verify no budget file exists
   177→    const budgetPath = getSessionBudgetPath(testDir, sessionId);
   178→    await expect(fs.access(budgetPath)).rejects.toThrow();
   179→  });
   180→});
