   500→  describe("config file safety", () => {
   501→    it("should throw on corrupt .claude/settings.local.json instead of overwriting", async () => {
   502→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   503→      const originalCwd = process.cwd();
   504→      delete process.env.CLAUDE_ENV_FILE;
   505→
   506→      try {
   507→        process.chdir(testDir);
   508→        const settingsDir = path.join(testDir, ".claude");
   509→        await fs.mkdir(settingsDir, { recursive: true });
   510→        await fs.writeFile(
   511→          path.join(settingsDir, "settings.local.json"),
   512→          "this is not valid json {{{",
   513→          "utf-8",
   514→        );
   515→
   516→        const sessionId = testUlid("CRPT", 1);
   517→        await expect(injectClaudeCodeEnv(sessionId)).rejects.toThrow(
