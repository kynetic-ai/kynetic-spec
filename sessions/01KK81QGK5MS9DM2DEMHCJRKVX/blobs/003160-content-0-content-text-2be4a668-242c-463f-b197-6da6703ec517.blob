   182→// ─── Session Validation ──────────────────────────────────────────────────────
   183→
   184→describe("validateSessionId", () => {
   185→  let testDir: string;
   186→
   187→  beforeEach(async () => {
   188→    testDir = await createTempDir("kspec-session-validate-");
   189→    await fs.mkdir(path.join(testDir, "sessions"), { recursive: true });
   190→  });
   191→
   192→  afterEach(async () => {
   193→    await cleanupTempDir(testDir);
   194→  });
   195→
   196→  // AC: @session-creation-and-env-injection ac-invalid-session
   197→  it("should return valid for existing session with correct metadata", async () => {
   198→    const sessionId = testUlid("VALID", 1);
   199→    await createSession(testDir, {
   200→      id: sessionId,
   201→      agent_type: "claude-code",
   202→    });
   203→
   204→    const result = await validateSessionId(testDir, sessionId);
   205→    expect(result.valid).toBe(true);
   206→    expect(result.session).toBeDefined();
   207→    expect(result.session!.id).toBe(sessionId);
   208→  });
   209→
   210→  // AC: @session-creation-and-env-injection ac-invalid-session
   211→  it("should return error for nonexistent session with clear message", async () => {
   212→    const result = await validateSessionId(testDir, "NONEXISTENT_SESSION");
   213→    expect(result.valid).toBe(false);
   214→    expect(result.error).toContain("Session not found");
   215→    expect(result.error).toContain("NONEXISTENT_SESSION");
   216→    expect(result.suggestion).toContain("kspec session create");
   217→  });
   218→
   219→  // AC: @session-creation-and-env-injection ac-invalid-session
   220→  it("should return error for corrupt session metadata", async () => {
   221→    const sessionId = testUlid("CRPT", 1);
   222→    const sessionDir = path.join(testDir, "sessions", sessionId);
   223→    await fs.mkdir(sessionDir, { recursive: true });
   224→    // Write invalid YAML
   225→    await fs.writeFile(
   226→      path.join(sessionDir, "session.yaml"),
   227→      "this is not valid yaml: [[[",
   228→      "utf-8",
   229→    );
   230→
   231→    const result = await validateSessionId(testDir, sessionId);
   232→    expect(result.valid).toBe(false);
   233→    expect(result.error).toContain("corrupt");
   234→    expect(result.suggestion).toContain("kspec session create");
   235→  });
   236→});
