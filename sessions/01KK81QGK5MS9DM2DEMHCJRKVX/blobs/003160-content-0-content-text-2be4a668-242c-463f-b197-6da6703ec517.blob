   551→  describe("injectGeminiEnv", () => {
   552→    // Spec: @session-creation-and-env-injection (harness-specific injection for Gemini CLI)
   553→    it("should write KSPEC_SESSION_ID to .gemini/.env", async () => {
   554→      const originalCwd = process.cwd();
   555→
   556→      try {
   557→        process.chdir(testDir);
   558→        const sessionId = testUlid("GEMI", 1);
   559→        const result = await injectGeminiEnv(sessionId);
   560→
   561→        expect(result.injected).toBe(true);
   562→        expect(result.method).toBe("gemini_dotenv");
