  1066→// ─── CLI Command: session create ─────────────────────────────────────────────
  1067→
  1068→describe("session create CLI", () => {
  1069→  let testDir: string;
  1070→
  1071→  beforeEach(async () => {
  1072→    testDir = await setupTempFixtures();
  1073→  });
  1074→
  1075→  afterEach(async () => {
  1076→    await cleanupTempDir(testDir);
  1077→  });
  1078→
  1079→  // AC: @session-creation-and-env-injection ac-create
  1080→  // AC: @trait-semantic-exit-codes ac-1
  1081→  it("should create a session and print ID to stdout", () => {
  1082→    const result = kspec("session create --agent-type test-agent", testDir);
  1083→    expect(result.exitCode).toBe(0);
  1084→    expect(result.stdout).toContain("Created session:");
  1085→  });
  1086→
  1087→  // AC: @session-creation-and-env-injection ac-budget
  1088→  it("should create budget when --budget flag provided", () => {
  1089→    const result = kspec(
  1090→      "session create --agent-type test-agent --budget 5",
  1091→      testDir,
  1092→    );
  1093→    expect(result.exitCode).toBe(0);
  1094→    // info() routes to stdout in text mode
  1095→    const allOutput = result.stdout + "\n" + result.stderr;
  1096→    expect(allOutput).toContain("Budget: 5 tasks per cycle");
  1097→  });
  1098→
  1099→  // AC: @trait-json-output ac-1 - output is valid JSON with no ANSI
  1100→  it("should output valid JSON when --json flag provided", () => {
  1101→    const result = kspecJson<Record<string, unknown>>(
  1102→      "session create --agent-type test-agent --budget 3",
  1103→      testDir,
  1104→    );
  1105→    expect(result.session_id).toBeTruthy();
  1106→    expect(typeof result.session_id).toBe("string");
  1107→    expect(result.agent_type).toBe("test-agent");
  1108→    expect(result.status).toBe("active");
