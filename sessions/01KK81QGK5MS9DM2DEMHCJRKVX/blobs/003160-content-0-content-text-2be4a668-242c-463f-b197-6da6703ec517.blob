   238→// ─── Environment Injection ───────────────────────────────────────────────────
   239→
   240→describe("Environment Injection", () => {
   241→  let testDir: string;
   242→
   243→  beforeEach(async () => {
   244→    testDir = await createTempDir("kspec-env-inject-");
   245→  });
   246→
   247→  afterEach(async () => {
   248→    await cleanupTempDir(testDir);
   249→  });
   250→
   251→  describe("injectClaudeCodeEnv", () => {
   252→    // AC: @session-creation-and-env-injection ac-inject-claude
   253→    it("should write to CLAUDE_ENV_FILE when set", async () => {
   254→      const envFile = path.join(testDir, "claude-env");
   255→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   256→      process.env.CLAUDE_ENV_FILE = envFile;
   257→
   258→      try {
   259→        const sessionId = testUlid("CLDE", 1);
   260→        const result = await injectClaudeCodeEnv(sessionId);
   261→
   262→        expect(result.injected).toBe(true);
   263→        expect(result.method).toBe("claude_env_file");
   264→        expect(result.path).toBe(envFile);
   265→
   266→        const content = await fs.readFile(envFile, "utf-8");
   267→        expect(content).toContain(`KSPEC_SESSION_ID=${sessionId}`);
   268→      } finally {
   269→        if (originalEnv !== undefined) {
   270→          process.env.CLAUDE_ENV_FILE = originalEnv;
   271→        } else {
   272→          delete process.env.CLAUDE_ENV_FILE;
   273→        }
   274→      }
   275→    });
   276→
   277→    // AC: @session-creation-and-env-injection ac-inject-claude
   278→    it("should replace existing KSPEC_SESSION_ID in CLAUDE_ENV_FILE", async () => {
   279→      const envFile = path.join(testDir, "claude-env");
   280→      await fs.writeFile(
   281→        envFile,
   282→        "OTHER_VAR=foo\nKSPEC_SESSION_ID=old-session\nANOTHER=bar\n",
   283→        "utf-8",
   284→      );
   285→
   286→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   287→      process.env.CLAUDE_ENV_FILE = envFile;
   288→
   289→      try {
   290→        const sessionId = testUlid("CLDE", 2);
   291→        await injectClaudeCodeEnv(sessionId);
   292→
   293→        const content = await fs.readFile(envFile, "utf-8");
   294→        expect(content).toContain(`KSPEC_SESSION_ID=${sessionId}`);
   295→        expect(content).not.toContain("old-session");
   296→        expect(content).toContain("OTHER_VAR=foo");
   297→        expect(content).toContain("ANOTHER=bar");
   298→      } finally {
   299→        if (originalEnv !== undefined) {
   300→          process.env.CLAUDE_ENV_FILE = originalEnv;
   301→        } else {
   302→          delete process.env.CLAUDE_ENV_FILE;
   303→        }
   304→      }
   305→    });
   306→
   307→    it("should capture previous value from CLAUDE_ENV_FILE", async () => {
   308→      const envFile = path.join(testDir, "claude-env-prev");
   309→      await fs.writeFile(envFile, "KSPEC_SESSION_ID=old-value\n", "utf-8");
   310→
   311→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   312→      process.env.CLAUDE_ENV_FILE = envFile;
   313→
   314→      try {
   315→        const sessionId = testUlid("CLDE", 4);
   316→        const result = await injectClaudeCodeEnv(sessionId);
   317→
   318→        expect(result.previousValue).toBe("old-value");
   319→      } finally {
   320→        if (originalEnv !== undefined) {
   321→          process.env.CLAUDE_ENV_FILE = originalEnv;
   322→        } else {
   323→          delete process.env.CLAUDE_ENV_FILE;
   324→        }
   325→      }
   326→    });
   327→
   328→    it("should return null previousValue when no prior value exists", async () => {
   329→      const envFile = path.join(testDir, "claude-env-noprev");
   330→
   331→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   332→      process.env.CLAUDE_ENV_FILE = envFile;
   333→
   334→      try {
   335→        const sessionId = testUlid("CLDE", 5);
   336→        const result = await injectClaudeCodeEnv(sessionId);
   337→
   338→        expect(result.previousValue).toBeNull();
   339→      } finally {
   340→        if (originalEnv !== undefined) {
   341→          process.env.CLAUDE_ENV_FILE = originalEnv;
   342→        } else {
   343→          delete process.env.CLAUDE_ENV_FILE;
   344→        }
   345→      }
   346→    });
   347→
   348→    // AC: @session-creation-and-env-injection ac-inject-claude
   349→    it("should write to .claude/settings.local.json when CLAUDE_ENV_FILE not set", async () => {
   350→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   351→      const originalCwd = process.cwd();
   352→      delete process.env.CLAUDE_ENV_FILE;
   353→
   354→      try {
   355→        process.chdir(testDir);
   356→        const sessionId = testUlid("CLDE", 3);
   357→        const result = await injectClaudeCodeEnv(sessionId);
   358→
   359→        expect(result.injected).toBe(true);
   360→        expect(result.method).toBe("claude_settings");
   361→
   362→        const settingsPath = path.join(testDir, ".claude", "settings.local.json");
   363→        const content = await fs.readFile(settingsPath, "utf-8");
   364→        const settings = JSON.parse(content);
   365→        expect(settings.env.KSPEC_SESSION_ID).toBe(sessionId);
   366→      } finally {
   367→        process.chdir(originalCwd);
   368→        if (originalEnv !== undefined) {
   369→          process.env.CLAUDE_ENV_FILE = originalEnv;
   370→        }
   371→      }
   372→    });
   373→  });
   374→
   375→  describe("injectCodexEnv", () => {
   376→    // AC: @session-creation-and-env-injection ac-inject-codex
   377→    it("should add KSPEC_SESSION_ID to codex config", async () => {
   378→      const configDir = path.join(testDir, ".codex");
   379→      const originalHome = process.env.HOME;
   380→      process.env.HOME = testDir;
   381→
   382→      try {
   383→        const sessionId = testUlid("CDEX", 1);
   384→        const result = await injectCodexEnv(sessionId);
   385→
   386→        expect(result.injected).toBe(true);
   387→        expect(result.method).toBe("codex_config");
   388→
   389→        const configPath = path.join(configDir, "config.toml");
   390→        const content = await fs.readFile(configPath, "utf-8");
   391→        const config = parseTOML(content) as Record<string, unknown>;
   392→        const policy = config.shell_environment_policy as Record<string, Record<string, string>>;
   393→        expect(policy.set.KSPEC_SESSION_ID).toBe(sessionId);
   394→      } finally {
   395→        process.env.HOME = originalHome;
   396→      }
   397→    });
   398→
   399→    // AC: @session-creation-and-env-injection ac-inject-codex
   400→    it("should preserve existing codex config values", async () => {
   401→      const configDir = path.join(testDir, ".codex");
   402→      await fs.mkdir(configDir, { recursive: true });
   403→      await fs.writeFile(
   404→        path.join(configDir, "config.toml"),
   405→        stringifyTOML({
   406→          model: "gpt-5",
   407→          shell_environment_policy: {
   408→            set: { EXISTING_VAR: "keep" },
   409→            inherit: "all",
   410→          },
   411→        }),
   412→        "utf-8",
   413→      );
   414→
   415→      const originalHome = process.env.HOME;
   416→      process.env.HOME = testDir;
   417→
   418→      try {
   419→        const sessionId = testUlid("CDEX", 2);
   420→        await injectCodexEnv(sessionId);
   421→
   422→        const content = await fs.readFile(
   423→          path.join(configDir, "config.toml"),
   424→          "utf-8",
   425→        );
   426→        const config = parseTOML(content) as Record<string, unknown>;
   427→        expect(config.model).toBe("gpt-5");
   428→        const policy = config.shell_environment_policy as Record<string, unknown>;
   429→        expect((policy.set as Record<string, string>).EXISTING_VAR).toBe("keep");
   430→        expect((policy.set as Record<string, string>).KSPEC_SESSION_ID).toBe(
   431→          sessionId,
   432→        );
   433→        expect(policy.inherit).toBe("all");
   434→      } finally {
   435→        process.env.HOME = originalHome;
   436→      }
   437→    });
   438→
   439→    // AC: @session-creation-and-env-injection ac-inject-codex
   440→    it("should preserve complex TOML structures during inject/remove round-trip", async () => {
   441→      const configDir = path.join(testDir, ".codex");
   442→      await fs.mkdir(configDir, { recursive: true });
   443→
   444→      // Pre-seed with a realistic codex config.toml containing various TOML types
   445→      const originalConfig = {
   446→        model: "gpt-5.3-codex",
   447→        approval_policy: "never",
   448→        sandbox_mode: "danger-full-access",
   449→        shell_environment_policy: {
   450→          inherit: "all",
   451→          set: { MY_VAR: "keep-this", ANOTHER_VAR: "also-keep" },
   452→        },
   453→      };
   454→      await fs.writeFile(
   455→        path.join(configDir, "config.toml"),
   456→        stringifyTOML(originalConfig),
   457→        "utf-8",
   458→      );
   459→
   460→      const originalHome = process.env.HOME;
   461→      process.env.HOME = testDir;
   462→
   463→      try {
   464→        const sessionId = testUlid("CDEX", 3);
   465→
   466→        // Inject
   467→        const result = await injectCodexEnv(sessionId);
   468→        expect(result.previousValue).toBeNull();
   469→
   470→        // Verify injection didn't clobber other values
   471→        let content = parseTOML(
   472→          await fs.readFile(path.join(configDir, "config.toml"), "utf-8"),
   473→        ) as Record<string, unknown>;
   474→        expect(content.model).toBe("gpt-5.3-codex");
   475→        expect(content.approval_policy).toBe("never");
   476→        expect(content.sandbox_mode).toBe("danger-full-access");
   477→        const policy = content.shell_environment_policy as Record<string, unknown>;
   478→        expect(policy.inherit).toBe("all");
   479→        expect((policy.set as Record<string, string>).MY_VAR).toBe("keep-this");
   480→        expect((policy.set as Record<string, string>).ANOTHER_VAR).toBe("also-keep");
   481→        expect((policy.set as Record<string, string>).KSPEC_SESSION_ID).toBe(sessionId);
   482→
   483→        // Remove — should delete KSPEC_SESSION_ID but preserve everything else
   484→        await removeCodexEnv();
   485→        content = parseTOML(
   486→          await fs.readFile(path.join(configDir, "config.toml"), "utf-8"),
   487→        ) as Record<string, unknown>;
   488→        expect(content.model).toBe("gpt-5.3-codex");
   489→        expect(content.approval_policy).toBe("never");
   490→        const policyAfter = content.shell_environment_policy as Record<string, unknown>;
   491→        expect(policyAfter.inherit).toBe("all");
   492→        expect((policyAfter.set as Record<string, string>).MY_VAR).toBe("keep-this");
   493→        expect((policyAfter.set as Record<string, string>).KSPEC_SESSION_ID).toBeUndefined();
   494→      } finally {
   495→        process.env.HOME = originalHome;
   496→      }
   497→    });
   498→  });
