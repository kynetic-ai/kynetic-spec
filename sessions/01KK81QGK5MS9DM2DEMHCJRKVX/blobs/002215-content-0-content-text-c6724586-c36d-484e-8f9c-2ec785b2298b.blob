   212→
   213→    // AC: @enhanced-setup ac-2 - all hook entries present
   214→    // AC: @full-hook-install ac-1 - UserPromptSubmit hook entry is written
   215→    // AC: @full-hook-install ac-2 - Stop hook entry is present
   216→    // AC: @full-hook-install ac-3 - PreToolUse Bash hook entries are present
   217→    it('should install all required hooks', async () => {
   218→      kspec('setup', tempDir, {
   219→        env: { CLAUDECODE: '1' },
   220→      });
   221→
   222→      // Check settings.json
   223→      const settingsPath = path.join(tempDir, '.claude', 'settings.json');
   224→      const settingsContent = await fs.readFile(settingsPath, 'utf-8');
   225→      const settings = JSON.parse(settingsContent);
   226→
   227→      expect(settings.hooks).toBeDefined();
   228→      // AC: @full-hook-install ac-1
   229→      expect(settings.hooks.UserPromptSubmit).toBeDefined();
   230→      // AC: @full-hook-install ac-2
