    19→describe('kspec setup (enhanced)', () => {
    20→  let tempDir: string;
    21→
    22→  beforeEach(async () => {
    23→    tempDir = await createTempDir('kspec-enhanced-setup-');
    24→    initGitRepo(tempDir);
    25→
    26→    // Create initial commit
    27→    await fs.writeFile(path.join(tempDir, 'README.md'), '# Test', 'utf-8');
    28→    execSync('git add README.md && git commit -m "Initial"', {
    29→      cwd: tempDir,
    30→      stdio: 'pipe',
    31→    });
    32→  });
    33→
    34→  afterEach(async () => {
