    95→
    96→    // AC: @enhanced-setup ac-8 - JSON output includes all status info
    97→    it('should return structured status in JSON mode', async () => {
    98→      const result = kspecJson<{
    99→        agent: { detected: string; confidence: string };
   100→        hooks: { promptCheck: boolean; stop: boolean; preToolUse: boolean };
   101→        skills: { rendered: number };
