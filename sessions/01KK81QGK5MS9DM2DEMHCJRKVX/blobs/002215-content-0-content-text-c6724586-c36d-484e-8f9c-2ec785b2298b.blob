   428→  describe('idempotency', () => {
   429→    beforeEach(async () => {
   430→      kspec('init --name test-project --no-prompt', tempDir);
   431→    });
   432→
   433→    // Running setup multiple times should be safe
   434→    it('should be idempotent', async () => {
   435→      // First run
   436→      const result1 = kspec('setup', tempDir, {
   437→        env: { CLAUDECODE: '1' },
   438→      });
   439→      expect(result1.exitCode).toBe(0);
   440→
   441→      // Second run
   442→      const result2 = kspec('setup', tempDir, {
   443→        env: { CLAUDECODE: '1' },
   444→      });
   445→      expect(result2.exitCode).toBe(0);
   446→
   447→      // Check hooks are still correct (not duplicated)
   448→      const settingsPath = path.join(tempDir, '.claude', 'settings.json');
   449→      const settings = JSON.parse(await fs.readFile(settingsPath, 'utf-8'));
   450→
   451→      // Should only have one UserPromptSubmit entry
   452→      const promptHooks = settings.hooks.UserPromptSubmit as Array<unknown>;
   453→      expect(promptHooks.length).toBe(1);
   454→    });
   455→
   456→    // AC: @native-guard-commands ac-idempotent - no duplicates on repeated setup
   457→    it('should not create duplicate guard entries on repeated setup', async () => {
   458→      // First setup
   459→      kspec('setup', tempDir, {
   460→        env: { CLAUDECODE: '1' },
   461→      });
   462→
   463→      // Second setup
   464→      kspec('setup', tempDir, {
   465→        env: { CLAUDECODE: '1' },
   466→      });
   467→
   468→      const settingsPath = path.join(tempDir, '.claude', 'settings.json');
   469→      const settings = JSON.parse(await fs.readFile(settingsPath, 'utf-8'));
   470→      const preToolUse = settings.hooks?.PreToolUse || [];
   471→
   472→      // Count native guard entries
   473→      let guardCount = 0;
   474→      for (const entry of preToolUse) {
   475→        for (const hook of entry.hooks || []) {
   476→          if (hook.command === 'kspec guard worktree') {
   477→            guardCount++;
   478→          }
   479→        }
   480→      }
   481→      expect(guardCount).toBe(1);
   482→    });
   483→
   484→    it('should produce identical settings.json content on second run', async () => {
