   232→      // AC: @full-hook-install ac-3
   233→      expect(settings.hooks.PreToolUse).toBeDefined();
   234→
   235→      // Verify PreToolUse has Bash matcher for worktree guard
   236→      const preToolUse = settings.hooks.PreToolUse;
   237→      const bashEntry = preToolUse.find((entry: { matcher: string }) => entry.matcher === 'Bash');
   238→      expect(bashEntry).toBeDefined();
