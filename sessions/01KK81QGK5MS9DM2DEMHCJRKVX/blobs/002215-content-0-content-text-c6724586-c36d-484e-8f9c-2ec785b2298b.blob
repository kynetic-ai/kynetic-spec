    36→  });
    37→
    38→  describe('--status flag', () => {
    39→    // AC: @enhanced-setup ac-7 - --status reports current state including agent detected
    40→    it('should report agent detection', async () => {
    41→      // Run with CLAUDECODE env var to simulate Claude Code
    42→      const result = kspec('setup --status', tempDir, {
    43→        env: { CLAUDECODE: '1' },
    44→      });
    45→
    46→      expect(result.exitCode).toBe(0);
    47→      expect(result.stdout).toContain('Agent:');
    48→      expect(result.stdout).toContain('claude-code');
    49→    });
    50→
    51→    // AC: @enhanced-setup ac-7 - --status reports current state
    52→    it('should report unknown agent when no env vars set', async () => {
    53→      const result = kspec('setup --status', tempDir, {
    54→        env: { CLAUDECODE: '', CLINE_ACTIVE: '', AIDER_MODEL: '' },
    55→      });
    56→
    57→      expect(result.exitCode).toBe(0);
    58→      expect(result.stdout).toContain('Agent:');
    59→    });
    60→
