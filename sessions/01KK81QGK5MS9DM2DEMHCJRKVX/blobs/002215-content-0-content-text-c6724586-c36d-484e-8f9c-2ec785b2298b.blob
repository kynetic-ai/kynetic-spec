   240→
   241→    // AC: @enhanced-setup ac-2 - PreToolUse guards installed
   242→    // AC: @native-guard-commands ac-setup-native - native command in PreToolUse
   243→    it('should install native kspec guard worktree command in PreToolUse hooks', async () => {
   244→      kspec('setup', tempDir, {
   245→        env: { CLAUDECODE: '1' },
   246→      });
   247→
   248→      // Check settings.json for native guard command
   249→      const settingsPath = path.join(tempDir, '.claude', 'settings.json');
   250→      const settings = JSON.parse(await fs.readFile(settingsPath, 'utf-8'));
   251→      const preToolUse = settings.hooks?.PreToolUse || [];
   252→
   253→      const hasNativeGuard = preToolUse.some(
   254→        (entry: { hooks?: Array<{ command?: string }> }) =>
   255→          entry.hooks?.some((h: { command?: string }) => h.command === 'kspec guard worktree'),
   256→      );
   257→      expect(hasNativeGuard).toBe(true);
   258→    });
   259→
   260→    // AC: @native-guard-commands ac-setup-native - no bash scripts, native command
   261→    it('should not create bash guard scripts (uses native kspec guard command)', async () => {
   262→      kspec('setup', tempDir, {
   263→        env: { CLAUDECODE: '1' },
   264→      });
   265→
   266→      // No bash scripts should be created in .claude/hooks/
   267→      const hooksDir = path.join(tempDir, '.claude', 'hooks');
   268→      let files: string[] = [];
   269→      try {
   270→        files = await fs.readdir(hooksDir);
   271→      } catch {
   272→        // hooks dir might not exist — that's acceptable
   273→      }
   274→      expect(files).not.toContain('kspec-worktree-guard.sh');
   275→      expect(files).not.toContain('ralph-task-limit-guard.sh');
   276→    });
   277→
   278→    // AC: @native-guard-commands ac-worktree-guard, ac-worktree-allow
   279→    // Guard logic tested via kspec guard worktree CLI in guard-worktree.test.ts
   280→    it('should test guard logic via native kspec guard worktree command', () => {
   281→      // Run guard command with various inputs to test allow/block behavior
   282→      const runGuard = (command: string, cwd: string) => {
   283→        const input = JSON.stringify({ tool_input: { command }, cwd });
   284→        const result = kspec('guard worktree', tempDir, { stdin: input });
   285→        return JSON.parse(result.stdout.trim());
   286→      };
   287→
   288→      // These should be ALLOWED — dangerous patterns are inside quotes
   289→      expect(runGuard('echo "git reset"', path.join(tempDir, '.kspec'))).toEqual({ decision: 'allow' });
   290→      expect(runGuard("grep 'git stash' README.md", path.join(tempDir, '.kspec'))).toEqual({ decision: 'allow' });
   291→
   292→      // These should still be BLOCKED — actual dangerous commands
   293→      expect(runGuard('git reset --hard', path.join(tempDir, '.kspec'))).toHaveProperty('decision', 'block');
   294→      expect(runGuard('git stash', path.join(tempDir, '.kspec'))).toHaveProperty('decision', 'block');
   295→
   296→      // These should be BLOCKED — split-quote bypass attempts
   297→      expect(runGuard('git "reset" --hard', path.join(tempDir, '.kspec'))).toHaveProperty('decision', 'block');
   298→    });
