\"7afa4765-b17d-43af-a57a-0cb8040ccc6a\"}\n{\"parentUuid\":\"f9fd25f0-8bdc-4943-b228-1539f720d680\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a223826\",\"slug\":\"stateful-singing-dongarra\",\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Bt4jpQWPSvb9pU5se9Ejni\",\"type\":\"tool_result\",\"content\":\"     1→/**\\n     2→ * Session event storage tests.\\n     3→ *\\n     4→ * Tests for JSONL-based event storage for agent sessions.\\n     5→ */\\n     6→\\n     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';\\n     8→import { createHash } from 'node:crypto';\\n     9→import { spawnSync } from 'node:child_process';\\n    10→import * as fs from 'node:fs/promises';\\n    11→import * as path from 'node:path';\\n    12→import * as os from 'node:os';\\n    13→import {\\n    14→  SessionMetadataSchema,\\n    15→  SessionEventSchema,\\n    16→  SessionStatusSchema,\\n    17→  EventTypeSchema,\\n    18→  type SessionMetadataInput,\\n    19→  type SessionEventInput,\\n    20→} from '../src/sessions/types.js';\\n    21→import {\\n    22→  createSession,\\n    23→  getSession,\\n    24→  updateSessionStatus,\\n    25→  listSessions,\\n    26→  sessionExists,\\n    27→  appendEvent,\\n    28→  readEvents,\\n    29→  readEventsSince,\\n    30→  getLastEvent,\\n    31→  getSessionsDir,\\n    32→  getSessionDir,\\n    33→  getSessionMetadataPath,\\n    34→  getSessionEventsPath,\\n    35→  saveSessionContext,\\n    36→  readSessionContext,\\n    37→  getSessionContextPath,\\n    38→  getCompletedSessionCountsByAgent,\\n    39→} from '../src/sessions/store.js';\\n    40→\\n    41→// ─── Schema Tests ────────────────────────────────────────────────────────────\\n    42→\\n    43→describe('SessionStatusSchema', () => {\\n    44→  it('should accept valid status values', () => {\\n    45→    expect(SessionStatusSchema.safeParse('active').success).toBe(true);\\n    46→    expect(SessionStatusSchema.safeParse('completed').success).toBe(true);\\n    47→    expect(SessionStatusSchema.safeParse('abandoned').success).toBe(true);\\n    48→  });\\n    49→\\n    50→  it('should reject invalid status values', () => {\\n    51→    expect(SessionStatusSchema.safeParse('invalid').success).toBe(false);\\n    52→    expect(SessionStatusSchema.safeParse('pending').success).toBe(false);\\n    53→    expect(SessionStatusSchema.safeParse('').success).toBe(false);\\n    54→  });\\n    55→});\\n    56→\\n    57→describe('EventTypeSchema', () => {\\n    58→  it('should accept valid event types', () => {\\n    59→    expect(EventTypeSchema.safeParse('session.start').success).toBe(true);\\n    60→    expect(EventTypeSchema.safeParse('session.update').success).toBe(true);\\n    61→    expect(EventTypeSchema.safeParse('iteration.timeout').success).toBe(true);\\n    62→    expect(EventTypeSchema.safeParse('session.end').success).toBe(true);\\n    63→    expect(EventTypeSchema.safeParse('prompt.sent').success).toBe(true);\\n    64→    expect(EventTypeSchema.safeParse('tool.call').success).toBe(true);\\n    65→    expect(EventTypeSchema.safeParse('tool.result').success).toBe(true);\\n    66→    expect(EventTypeSchema.safeParse('note').success).toBe(true);\\n    67→  });\\n    68→\\n    69→  it('should reject invalid event types', () => {\\n    70→    expect(EventTypeSchema.safeParse('invalid').success).toBe(false);\\n    71→    expect(EventTypeSchema.safeParse('session_start').success).toBe(false);\\n    72→    expect(EventTypeSchema.safeParse('').success).toBe(false);\\n    73→  });\\n    74→});\\n    75→\\n    76→describe('SessionMetadataSchema', () => {\\n    77→  // AC: @session-events ac-5\\n    78→  it('should accept valid session metadata with all fields', () => {\\n    79→    const metadata = {\\n    80→      id: '01KF123456789ABCDEFGHJKMNP',\\n    81→      task_id: '@my-task',\\n    82→      agent_type: 'claude-code',\\n    83→      status: 'active',\\n    84→      started_at: '2026-01-17T10:00:00.000Z',\\n    85→    };\\n    86→\\n    87→    const result = SessionMetadataSchema.safeParse(metadata);\\n    88→    expect(result.success).toBe(true);\\n    89→  });\\n    90→\\n    91→  // AC: @session-events ac-5\\n    92→  it('should accept metadata without optional task_id', () => {\\n    93→    const metadata = {\\n    94→      id: '01KF123456789ABCDEFGHJKMNP',\\n    95→      agent_type: 'claude-code',\\n    96→      status: 'active',\\n    97→      started_at: '2026-01-17T10:00:00.000Z',\\n    98→    };\\n    99→\\n   100→    const result = SessionMetadataSchema.safeParse(metadata);\\n   101→    expect(result.success).toBe(true);\\n   102→  });\\n   103→\\n   104→  it('should accept completed status with ended_at', () => {\\n   105→    const metadata = {\\n   106→      id: '01KF123456789ABCDEFGHJKMNP',\\n   107→      agent_type: 'claude-code',\\n   108→      status: 'completed',\\n   109→      started_at: '2026-01-17T10:00:00.000Z',\\n   110→      ended_at: '2026-01-17T11:00:00.000Z',\\n   111→    };\\n   112→\\n   113→    const result = SessionMetadataSchema.safeParse(metadata);\\n   114→    expect(result.success).toBe(true);\\n   115→  });\\n   116→\\n   117→  it('should reject metadata without required fields', () => {\\n   118→    const metadata = {\\n   119→      id: '01KF123456789ABCDEFGHJKMNP',\\n   120→      status: 'active',\\n   121→    };\\n   122→\\n   123→    const result = SessionMetadataSchema.safeParse(metadata);\\n   124→    expect(result.success).toBe(false);\\n   125→  });\\n   126→});\\n   127→\\n   128→describe('SessionEventSchema', () => {\\n   129→  // AC: @session-events ac-2\\n   130→  it('should accept valid event with all fields', () => {\\n   131→    const event = {\\n   132→      ts: Date.now(),\\n   133→      seq: 0,\\n   134→      type: 'session.start',\\n   135→      session_id: '01KF123456789ABCDEFGHJKMNP',\\n   136→      trace_id: 'trace-123',\\n   137→      data: { message: 'Session started' },\\n   138→    };\\n   139→\\n   140→    const result = SessionEventSchema.safeParse(event);\\n   141→    expect(result.success).toBe(true);\\n   142→  });\\n   143→\\n   144→  it('should accept event without optional trace_id', () => {\\n   145→    const event = {\\n   146→      ts: Date.now(),\\n   147→      seq: 0,\\n   148→      type: 'session.start',\\n   149→      session_id: '01KF123456789ABCDEFGHJKMNP',\\n   150→      data: null,\\n   151→    };\\n   152→\\n   153→    const result = SessionEventSchema.safeParse(event);\\n   154→    expect(result.success).toBe(true);\\n   155→  });\\n   156→\\n   157→  it('should reject event without required fields', () => {\\n   158→    const event = {\\n   159→      ts: Date.now(),\\n   160→      type: 'session.start',\\n   161→    };\\n   162→\\n   163→    const result = SessionEventSchema.safeParse(event);\\n   164→    expect(result.success).toBe(false);\\n   165→  });\\n   166→\\n   167→  it('should reject negative sequence number', () => {\\n   168→    const event = {\\n   169→      ts: Date.now(),\\n   170→      seq: -1,\\n   171→      type: 'session.start',\\n   172→      session_id: '01KF123456789ABCDEFGHJKMNP',\\n   173→      data: null,\\n   174→    };\\n   175→\\n   176→    const result = SessionEventSchema.safeParse(event);\\n   177→    expect(result.success).toBe(false);\\n   178→  });\\n   179→});\\n   180→\\n   181→// ─── Path Helper Tests ───────────────────────────────────────────────────────\\n   182→\\n   183→describe('Path helpers', () => {\\n   184→  const specDir = '/test/.kspec';\\n   185→  const sessionId = '01KF123456789ABCDEFGHJKMNP';\\n   186→\\n   187→  it('should construct sessions directory path', () => {\\n   188→    expect(getSessionsDir(specDir)).toBe('/test/.kspec/sessions');\\n   189→  });\\n   190→\\n   191→  it('should construct session directory path', () => {\\n   192→    expect(getSessionDir(specDir, sessionId)).toBe(`/test/.kspec/sessions/${sessionId}`);\\n   193→  });\\n   194→\\n   195→  it('should construct metadata file path', () => {\\n   196→    expect(getSessionMetadataPath(specDir, sessionId)).toBe(\\n   197→      `/test/.kspec/sessions/${sessionId}/session.yaml`\\n   198→    );\\n   199→  });\\n   200→\\n   201→  it('should construct events file path', () => {\\n   202→    expect(getSessionEventsPath(specDir, sessionId)).toBe(\\n   203→      `/test/.kspec/sessions/${sessionId}/events.jsonl`\\n   204→    );\\n   205→  });\\n   206→});\\n   207→\\n   208→// ─── Storage Tests ───────────────────────────────────────────────────────────\\n   209→\\n   210→describe('Session storage', () => {\\n   211→  let testDir: string;\\n   212→\\n   213→  beforeEach(async () => {\\n   214→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-test-'));\\n   215→  });\\n   216→\\n   217→  afterEach(async () => {\\n   218→    await fs.rm(testDir, { recursive: true });\\n   219→  });\\n   220→\\n   221→  describe('createSession', () => {\\n   222→    // AC: @session-events ac-1\\n   223→    it('should create session directory and metadata file', async () => {\\n   224→      const input: SessionMetadataInput = {\\n   225→        id: '01KF123456789ABCDEFGHJKMNP',\\n   226→        agent_type: 'claude-code',\\n   227→      };\\n   228→\\n   229→      const metadata = await createSession(testDir, input);\\n   230→\\n   231→      // Check metadata returned\\n   232→      expect(metadata.id).toBe(input.id);\\n   233→      expect(metadata.agent_type).toBe(input.agent_type);\\n   234→      expect(metadata.status).toBe('active');\\n   235→      expect(metadata.started_at).toBeDefined();\\n   236→\\n   237→      // Check directory was created\\n   238→      const sessionDir = getSessionDir(testDir, input.id);\\n   239→      const stat = await fs.stat(sessionDir);\\n   240→      expect(stat.isDirectory()).toBe(true);\\n   241→\\n   242→      // Check metadata file was created\\n   243→      const metadataPath = getSessionMetadataPath(testDir, input.id);\\n   244→      const content = await fs.readFile(metadataPath, 'utf-8');\\n   245→      expect(content).toContain('id: ' + input.id);\\n   246→      expect(content).toContain('agent_type: claude-code');\\n   247→      expect(content).toContain('status: active');\\n   248→    });\\n   249→\\n   250→    // AC: @session-events ac-5\\n   251→    it('should include optional task_id in metadata', async () => {\\n   252→      const input: SessionMetadataInput = {\\n   253→        id: '01KF123456789ABCDEFGHJKMNP',\\n   254→        agent_type: 'claude-code',\\n   255→        task_id: '@my-task',\\n   256→      };\\n   257→\\n   258→      const metadata = await createSession(testDir, input);\\n   259→\\n   260→      expect(metadata.task_id).toBe('@my-task');\\n   261→\\n   262→      const metadataPath = getSessionMetadataPath(testDir, input.id);\\n   263→      const content = await fs.readFile(metadataPath, 'utf-8');\\n   264→      // Accept both single and double quotes (yaml library uses double quotes)\\n   265→      expect(content).toMatch(/task_id: [\\\"']@my-task[\\\"']/);\\n   266→    });\\n   267→\\n   268→    it('should use provided started_at if given', async () => {\\n   269→      const startTime = '2026-01-17T10:00:00.000Z';\\n   270→      const input: SessionMetadataInput = {\\n   271→        id: '01KF123456789ABCDEFGHJKMNP',\\n   272→        agent_type: 'claude-code',\\n   273→        started_at: startTime,\\n   274→      };\\n   275→\\n   276→      const metadata = await createSession(testDir, input);\\n   277→\\n   278→      expect(metadata.started_at).toBe(startTime);\\n   279→    });\\n   280→  });\\n   281→\\n   282→  describe('getSession', () => {\\n   283→    it('should return session metadata if exists', async () => {\\n   284→      const input: SessionMetadataInput = {\\n   285→        id: '01KF123456789ABCDEFGHJKMNP',\\n   286→        agent_type: 'claude-code',\\n   287→      };\\n   288→\\n   289→      await createSession(testDir, input);\\n   290→      const metadata = await getSession(testDir, input.id);\\n   291→\\n   292→      expect(metadata).not.toBeNull();\\n   293→      expect(metadata?.id).toBe(input.id);\\n   294→      expect(metadata?.agent_type).toBe(input.agent_type);\\n   295→    });\\n   296→\\n   297→    it('should return null if session does not exist', async () => {\\n   298→      const metadata = await getSession(testDir, 'nonexistent');\\n   299→\\n   300→      expect(metadata).toBeNull();\\n   301→    });\\n   302→  });\\n   303→\\n   304→  describe('updateSessionStatus', () => {\\n   305→    // AC: @session-events ac-6\\n   306→    it('should update status and set ended_at when completing', async () => {\\n   307→      const input: SessionMetadataInput = {\\n   308→        id: '01KF123456789ABCDEFGHJKMNP',\\n   309→        agent_type: 'claude-code',\\n   310→      };\\n   311→\\n   312→      await createSession(testDir, input);\\n   313→      const updated = await updateSessionStatus(testDir, input.id, 'completed');\\n   314→\\n   315→      expect(updated).not.toBeNull();\\n   316→      expect(updated?.status).toBe('completed');\\n   317→      expect(updated?.ended_at).toBeDefined();\\n   318→\\n   319→      // Verify persisted\\n   320→      const reloaded = await getSession(testDir, input.id);\\n   321→      expect(reloaded?.status).toBe('completed');\\n   322→      expect(reloaded?.ended_at).toBeDefined();\\n   323→    });\\n   324→\\n   325→    // AC: @session-events ac-6\\n   326→    it('should set ended_at when abandoning', async () => {\\n   327→      const input: SessionMetadataInput = {\\n   328→        id: '01KF123456789ABCDEFGHJKMNP',\\n   329→        agent_type: 'claude-code',\\n   330→      };\\n   331→\\n   332→      await createSession(testDir, input);\\n   333→      const updated = await updateSessionStatus(testDir, input.id, 'abandoned');\\n   334→\\n   335→      expect(updated?.status).toBe('abandoned');\\n   336→      expect(updated?.ended_at).toBeDefined();\\n   337→    });\\n   338→\\n   339→    it('should return null if session does not exist', async () => {\\n   340→      const updated = await updateSessionStatus(testDir, 'nonexistent', 'completed');\\n   341→\\n   342→      expect(updated).toBeNull();\\n   343→    });\\n   344→  });\\n   345→\\n   346→  describe('listSessions', () => {\\n   347→    it('should list all session IDs', async () => {\\n   348→      await createSession(testDir, { id: 'session-a', agent_type: 'claude-code' });\\n   349→      await createSession(testDir, { id: 'session-b', agent_type: 'claude-code' });\\n   350→      await createSession(testDir, { id: 'session-c', agent_type: 'test-agent' });\\n   351→\\n   352→      const sessions = await listSessions(testDir);\\n   353→\\n   354→      expect(sessions).toHaveLength(3);\\n   355→      expect(sessions).toContain('session-a');\\n   356→      expect(sessions).toContain('session-b');\\n   357→      expect(sessions).toContain('session-c');\\n   358→    });\\n   359→\\n   360→    it('should return empty array if no sessions', async () => {\\n   361→      const sessions = await listSessions(testDir);\\n   362→\\n   363→      expect(sessions).toHaveLength(0);\\n   364→    });\\n   365→  });\\n   366→\\n   367→  describe('sessionExists', () => {\\n   368→    it('should return true if session exists', async () => {\\n   369→      await createSession(testDir, { id: 'my-session', agent_type: 'claude-code' });\\n   370→\\n   371→      const exists = await sessionExists(testDir, 'my-session');\\n   372→\\n   373→      expect(exists).toBe(true);\\n   374→    });\\n   375→\\n   376→    it('should return false if session does not exist', async () => {\\n   377→      const exists = await sessionExists(testDir, 'nonexistent');\\n   378→\\n   379→      expect(exists).toBe(false);\\n   380→    });\\n   381→  });\\n   382→});\\n   383→\\n   384→// ─── Event Storage Tests ─────────────────────────────────────────────────────\\n   385→\\n   386→describe('Event storage', () => {\\n   387→  let testDir: string;\\n   388→  const sessionId = '01KF123456789ABCDEFGHJKMNP';\\n   389→\\n   390→  beforeEach(async () => {\\n   391→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-event-test-'));\\n   392→  });\\n   393→\\n   394→  afterEach(async () => {\\n   395→    await fs.rm(testDir, { recursive: true });\\n   396→  });\\n   397→\\n   398→  describe('appendEvent', () => {\\n   399→    // AC: @session-events ac-2\\n   400→    it('should append event with auto-assigned ts and seq', async () => {\\n   401→      const input: SessionEventInput = {\\n   402→        type: 'session.start',\\n   403→        session_id: sessionId,\\n   404→        data: { message: 'Starting session' },\\n   405→      };\\n   406→\\n   407→      const event = await appendEvent(testDir, input);\\n   408→\\n   409→      expect(event.ts).toBeDefined();\\n   410→      expect(event.ts).toBeGreaterThan(0);\\n   411→      expect(event.seq).toBe(0);\\n   412→      expect(event.type).toBe('session.start');\\n   413→      expect(event.session_id).toBe(sessionId);\\n   414→      expect(event.data).toEqual({ message: 'Starting session' });\\n   415→    });\\n   416→\\n   417→    // AC: @session-events ac-2\\n   418→    it('should auto-increment seq for subsequent events', async () => {\\n   419→      const event1 = await appendEvent(testDir, {\\n   420→        type: 'session.start',\\n   421→        session_id: sessionId,\\n   422→        data: null,\\n   423→      });\\n   424→\\n   425→      const event2 = await appendEvent(testDir, {\\n   426→        type: 'prompt.sent',\\n   427→        session_id: sessionId,\\n   428→        data: { prompt: 'Hello' },\\n   429→      });\\n   430→\\n   431→      const event3 = await appendEvent(testDir, {\\n   432→        type: 'tool.call',\\n   433→        session_id: sessionId,\\n   434→        data: { tool: 'Read' },\\n   435→      });\\n   436→\\n   437→      expect(event1.seq).toBe(0);\\n   438→      expect(event2.seq).toBe(1);\\n   439→      expect(event3.seq).toBe(2);\\n   440→    });\\n   441→\\n   442→    // AC: @session-events ac-2\\n   443→    it('should derive next seq from the last stored event seq', async () => {\\n   444→      const sessionDir = getSessionDir(testDir, sessionId);\\n   445→      const eventsPath = getSessionEventsPath(testDir, sessionId);\\n   446→      await fs.mkdir(sessionDir, { recursive: true });\\n   447→\\n   448→      const existing = [\\n   449→        {\\n   450→          ts: 1000,\\n   451→          seq: 5,\\n   452→          type: 'session.start',\\n   453→          session_id: sessionId,\\n   454→          data: null,\\n   455→        },\\n   456→        {\\n   457→          ts: 2000,\\n   458→          seq: 9,\\n   459→          type: 'session.update',\\n   460→          session_id: sessionId,\\n   461→          data: { message: 'existing tail event' },\\n   462→        },\\n   463→      ];\\n   464→      await fs.writeFile(\\n   465→        eventsPath,\\n   466→        `${existing.map((event) => JSON.stringify(event)).join('\\\\n')}\\\\n`,\\n   467→        'utf-8',\\n   468→      );\\n   469→\\n   470→      const next = await appendEvent(testDir, {\\n   471→        type: 'prompt.sent',\\n   472→        session_id: sessionId,\\n   473→        data: { prompt: 'new event' },\\n   474→      });\\n   475→\\n   476→      expect(next.seq).toBe(10);\\n   477→    });\\n   478→\\n   479→    // AC: @session-events ac-3\\n   480→    it('should create session directory if it does not exist (lazy creation)', async () => {\\n   481→      const event = await appendEvent(testDir, {\\n   482→        type: 'session.start',\\n   483→        session_id: sessionId,\\n   484→        data: null,\\n   485→      });\\n   486→\\n   487→      expect(event.seq).toBe(0);\\n   488→\\n   489→      // Verify directory was created\\n   490→      const sessionDir = getSessionDir(testDir, sessionId);\\n   491→      const stat = await fs.stat(sessionDir);\\n   492→      expect(stat.isDirectory()).toBe(true);\\n   493→    });\\n   494→\\n   495→    it('should preserve optional trace_id', async () => {\\n   496→      const event = await appendEvent(testDir, {\\n   497→        type: 'session.start',\\n   498→        session_id: sessionId,\\n   499→        trace_id: 'trace-abc-123',\\n   500→        data: null,\\n   501→      });\\n   502→\\n   503→      expect(event.trace_id).toBe('trace-abc-123');\\n   504→    });\\n   505→\\n   506→    // AC: @session-events ac-3\\n   507→    it('should write event as JSON line to events.jsonl', async () => {\\n   508→      await appendEvent(testDir, {\\n   509→        type: 'session.start',\\n   510→        session_id: sessionId,\\n   511→        data: { key: 'value' },\\n   512→      });\\n   513→\\n   514→      await appendEvent(testDir, {\\n   515→        type: 'prompt.sent',\\n   516→        session_id: sessionId,\\n   517→        data: { prompt: 'test' },\\n   518→      });\\n   519→\\n   520→      const eventsPath = getSessionEventsPath(testDir, sessionId);\\n   521→      const content = await fs.readFile(eventsPath, 'utf-8');\\n   522→      const lines = content.trim().split('\\\\n');\\n   523→\\n   524→      expect(lines).toHaveLength(2);\\n   525→\\n   526→      const event1 = JSON.parse(lines[0]);\\n   527→      expect(event1.type).toBe('session.start');\\n   528→      expect(event1.seq).toBe(0);\\n   529→\\n   530→      const event2 = JSON.parse(lines[1]);\\n   531→      expect(event2.type).toBe('prompt.sent');\\n   532→      expect(event2.seq).toBe(1);\\n   533→    });\\n   534→\\n   535→    // AC: @session-events ac-8\\n   536→    // AC: @session-events ac-9\\n   537→    it('should externalize oversized rawOutput and store pointer metadata', async () => {\\n   538→      const rawOutput = 'X'.repeat(20_000);\\n   539→\\n   540→      await appendEvent(testDir, {\\n   541→        type: 'session.update',\\n   542→        session_id: sessionId,\\n   543→        data: {\\n   544→          iteration: 1,\\n   545→          update: {\\n   546→            sessionUpdate: 'tool_call_update',\\n   547→            rawOutput,\\n   548→          },\\n   549→        },\\n   550→      });\\n   551→\\n   552→      const eventsPath = getSessionEventsPath(testDir, sessionId);\\n   553→      const lines = (await fs.readFile(eventsPath, 'utf-8')).trim().split('\\\\n');\\n   554→      expect(lines).toHaveLength(1);\\n   555→\\n   556→      const stored = JSON.parse(lines[0]);\\n   557→      const pointer = stored.data.update.rawOutput as {\\n   558→        path: string;\\n   559→        bytes: number;\\n   560→        sha256: string;\\n   561→        truncated: boolean;\\n   562→        preview: string;\\n   563→      };\\n   564→      expect(pointer.path).toMatch(/^blobs\\\\//);\\n   565→      expect(pointer.bytes).toBe(rawOutput.length);\\n   566→      expect(pointer.sha256).toBe(\\n   567→        createHash('sha256').update(rawOutput).digest('hex'),\\n   568→      );\\n   569→      expect(pointer.truncated).toBe(true);\\n   570→      expect(pointer.preview.length).toBeGreaterThan(0);\\n   571→      expect(pointer.preview.length).toBeLessThan(rawOutput.length);\\n   572→\\n   573→      const blobPath = path.join(getSessionDir(testDir, sessionId), pointer.path);\\n   574→      const blobContent = await fs.readFile(blobPath, 'utf-8');\\n   575→      expect(blobContent).toBe(rawOutput);\\n   576→    });\\n   577→\\n   578→    it('should generate UTF-8 safe previews for externalized payloads', async () => {\\n   579→      const rawOutput = '漢'.repeat(7_000);\\n   580→\\n   581→      await appendEvent(testDir, {\\n   582→        type: 'session.update',\\n   583→        session_id: sessionId,\\n   584→        data: {\\n   585→          iteration: 1,\\n   586→          update: {\\n   587→            sessionUpdate: 'tool_call_update',\\n   588→            rawOutput,\\n   589→          },\\n   590→        },\\n   591→      });\\n   592→\\n   593→      const eventsPath = getSessionEventsPath(testDir, sessionId);\\n   594→      const stored = JSON.parse((await fs.readFile(eventsPath, 'utf-8')).trim());\\n   595→      const pointer = stored.data.update.rawOutput as { preview: string };\\n   596→\\n   597→      expect(pointer.preview).toContain('...');\\n   598→      expect(pointer.preview).not.toContain('\\\\uFFFD');\\n   599→    });\\n   600→\\n   601→    it('should cap oversized event lines by externalizing whole payload', async () => {\\n   602→      const giantPayload = 'Y'.repeat(320_000);\\n   603→\\n   604→      await appendEvent(testDir, {\\n   605→        type: 'prompt.sent',\\n   606→        session_id: sessionId,\\n   607→        data: {\\n   608→          prompt: giantPayload,\\n   609→        },\\n   610→      });\\n   611→\\n   612→      const eventsPath = getSessionEventsPath(testDir, sessionId);\\n   613→      const rawLine = (await fs.readFile(eventsPath, 'utf-8')).trim();\\n   614→      expect(Buffer.byteLength(rawLine, 'utf-8')).toBeLessThan(256 * 1024);\\n   615→\\n   616→      const parsed = JSON.parse(rawLine);\\n   617→      const pointer = parsed.data as {\\n   618→        path: string;\\n   619→        bytes: number;\\n   620→      };\\n   621→      expect(pointer.path).toMatch(/^blobs\\\\//);\\n   622→\\n   623→      const blobPath = path.join(getSessionDir(testDir, sessionId), pointer.path);\\n   624→      const blobContent = await fs.readFile(blobPath, 'utf-8');\\n   625→      expect(Buffer.byteLength(blobContent, 'utf-8')).toBe(pointer.bytes);\\n   626→      expect(JSON.parse(blobContent)).toEqual({ prompt: giantPayload });\\n   627→    });\\n   628→  });\\n   629→\\n   630→  describe('readEvents', () => {\\n   631→    // AC: @session-events ac-4\\n   632→    it('should read all events in sequence order', async () => {\\n   633→      await appendEvent(testDir, {\\n   634→        type: 'session.start',\\n   635→        session_id: sessionId,\\n   636→        data: null,\\n   637→      });\\n   638→\\n   639→      await appendEvent(testDir, {\\n   640→        type: 'prompt.sent',\\n   641→        session_id: sessionId,\\n   642→        data: { prompt: 'Hello' },\\n   643→      });\\n   644→\\n   645→      await appendEvent(testDir, {\\n   646→        type: 'session.end',\\n   647→        session_id: sessionId,\\n   648→        data: null,\\n   649→      });\\n   650→\\n   651→      const events = await readEvents(testDir, sessionId);\\n   652→\\n   653→      expect(events).toHaveLength(3);\\n   654→      expect(events[0].type).toBe('session.start');\\n   655→      expect(events[0].seq).toBe(0);\\n   656→      expect(events[1].type).toBe('prompt.sent');\\n   657→      expect(events[1].seq).toBe(1);\\n   658→      expect(events[2].type).toBe('session.end');\\n   659→      expect(events[2].seq).toBe(2);\\n   660→    });\\n   661→\\n   662→    it('should return empty array if no events', async () => {\\n   663→      const events = await readEvents(testDir, sessionId);\\n   664→\\n   665→      expect(events).toHaveLength(0);\\n   666→    });\\n   667→\\n   668→    it('should return empty array for nonexistent session', async () => {\\n   669→      const events = await readEvents(testDir, 'nonexistent');\\n   670→\\n   671→      expect(events).toHaveLength(0);\\n   672→    });\\n   673→\\n   674→    it('should skip invalid JSON lines', async () => {\\n   675→      // Create session dir and write some invalid JSON\\n   676→      const sessionDir = getSessionDir(testDir, sessionId);\\n   677→      await fs.mkdir(sessionDir, { recursive: true });\\n   678→\\n   679→      const eventsPath = getSessionEventsPath(testDir, sessionId);\\n   680→      const content = [\\n   681→        JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: sessionId, data: null }),\\n   682→        'invalid json line',\\n   683→        JSON.stringify({ ts: 2000, seq: 1, type: 'session.end', session_id: sessionId, data: null }),\\n   684→      ].join('\\\\n');\\n   685→      await fs.writeFile(eventsPath, content + '\\\\n', 'utf-8');\\n   686→\\n   687→      const events = await readEvents(testDir, sessionId);\\n   688→\\n   689→      expect(events).toHaveLength(2);\\n   690→      expect(events[0].seq).toBe(0);\\n   691→      expect(events[1].seq).toBe(1);\\n   692→    });\\n   693→  });\\n   694→\\n   695→  describe('readEventsSince', () => {\\n   696→    it('should filter events by timestamp', async () => {\\n   697→      // Create events with specific timestamps\\n   698→      await appendEvent(testDir, {\\n   699→        type: 'session.start',\\n   700→        session_id: sessionId,\\n   701→        ts: 1000,\\n   702→        data: null,\\n   703→      });\\n   704→\\n   705→      await appendEvent(testDir, {\\n   706→        type: 'prompt.sent',\\n   707→        session_id: sessionId,\\n   708→        ts: 2000,\\n   709→        data: null,\\n   710→      });\\n   711→\\n   712→      await appendEvent(testDir, {\\n   713→        type: 'session.end',\\n   714→        session_id: sessionId,\\n   715→        ts: 3000,\\n   716→        data: null,\\n   717→      });\\n   718→\\n   719→      const events = await readEventsSince(testDir, sessionId, 1500);\\n   720→\\n   721→      expect(events).toHaveLength(2);\\n   722→      expect(events[0].ts).toBe(2000);\\n   723→      expect(events[1].ts).toBe(3000);\\n   724→    });\\n   725→\\n   726→    it('should filter events by time range', async () => {\\n   727→      await appendEvent(testDir, {\\n   728→        type: 'session.start',\\n   729→        session_id: sessionId,\\n   730→        ts: 1000,\\n   731→        data: null,\\n   732→      });\\n   733→\\n   734→      await appendEvent(testDir, {\\n   735→        type: 'prompt.sent',\\n   736→        session_id: sessionId,\\n   737→        ts: 2000,\\n   738→        data: null,\\n   739→      });\\n   740→\\n   741→      await appendEvent(testDir, {\\n   742→        type: 'session.end',\\n   743→        session_id: sessionId,\\n   744→        ts: 3000,\\n   745→        data: null,\\n   746→      });\\n   747→\\n   748→      const events = await readEventsSince(testDir, sessionId, 1500, 2500);\\n   749→\\n   750→      expect(events).toHaveLength(1);\\n   751→      expect(events[0].ts).toBe(2000);\\n   752→    });\\n   753→  });\\n   754→\\n   755→  describe('getLastEvent', () => {\\n   756→    it('should return the last event', async () => {\\n   757→      await appendEvent(testDir, {\\n   758→        type: 'session.start',\\n   759→        session_id: sessionId,\\n   760→        data: null,\\n   761→      });\\n   762→\\n   763→      await appendEvent(testDir, {\\n   764→        type: 'prompt.sent',\\n   765→        session_id: sessionId,\\n   766→        data: { prompt: 'Hello' },\\n   767→      });\\n   768→\\n   769→      await appendEvent(testDir, {\\n   770→        type: 'session.end',\\n   771→        session_id: sessionId,\\n   772→        data: { reason: 'completed' },\\n   773→      });\\n   774→\\n   775→      const lastEvent = await getLastEvent(testDir, sessionId);\\n   776→\\n   777→      expect(lastEvent).not.toBeNull();\\n   778→      expect(lastEvent?.type).toBe('session.end');\\n   779→      expect(lastEvent?.seq).toBe(2);\\n   780→      expect(lastEvent?.data).toEqual({ reason: 'completed' });\\n   781→    });\\n   782→\\n   783→    it('should return null if no events', async () => {\\n   784→      const lastEvent = await getLastEvent(testDir, sessionId);\\n   785→\\n   786→      expect(lastEvent).toBeNull();\\n   787→    });\\n   788→  });\\n   789→\\n   790→  describe('commit boundary inclusion', () => {\\n   791→    // AC: @session-events ac-7\\n   792→    it('should include accumulated events in the next git commit', async () => {\\n   793→      const repoDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-commit-test-'));\\n   794→      const boundarySessionId = '01KF123456789ABCDEFGHJKMNQ';\\n   795→\\n   796→      const runGit = (...args: string[]) => {\\n   797→        const result = spawnSync('git', args, {\\n   798→          cwd: repoDir,\\n   799→          encoding: 'utf-8',\\n   800→        });\\n   801→        if (result.status !== 0) {\\n   802→          throw new Error(result.stderr || `git ${args.join(' ')} failed`);\\n   803→        }\\n   804→        return result.stdout.trim();\\n   805→      };\\n   806→\\n   807→      try {\\n   808→        runGit('init', '-b', 'main');\\n   809→        runGit('config', 'user.email', 'test@example.com');\\n   810→        runGit('config', 'user.name', 'Test User');\\n   811→\\n   812→        await fs.writeFile(path.join(repoDir, 'README.md'), '# test\\\\n', 'utf-8');\\n   813→        runGit('add', 'README.md');\\n   814→        runGit('commit', '-m', 'test: initial commit');\\n   815→\\n   816→        await appendEvent(repoDir, {\\n   817→          type: 'session.update',\\n   818→          session_id: boundarySessionId,\\n   819→          data: {\\n   820→            update: {\\n   821→              rawInput: {\\n   822→                command: 'kspec task complete @task-ref --reason \\\"Done\\\"',\\n   823→              },\\n   824→            },\\n   825→          },\\n   826→        });\\n   827→\\n   828→        runGit('add', '.');\\n   829→        runGit('commit', '-m', 'test: commit boundary includes session events');\\n   830→\\n   831→        const committedFiles = runGit('show', '--name-only', '--pretty=format:', 'HEAD');\\n   832→        expect(committedFiles).toContain(`sessions/${boundarySessionId}/events.jsonl`);\\n   833→      } finally {\\n   834→        await fs.rm(repoDir, { recursive: true, force: true });\\n   835→      }\\n   836→    });\\n   837→  });\\n   838→\\n   839→  describe('saveSessionContext', () => {\\n   840→    it('should save context snapshot for a given iteration', async () => {\\n   841→      const context = {\\n   842→        generated_at: '2026-01-19T00:00:00.000Z',\\n   843→        branch: 'main',\\n   844→        active_tasks: [],\\n   845→        ready_tasks: [{ ref: '@task-1', title: 'Test task' }],\\n   846→        stats: { total_tasks: 1 },\\n   847→      };\\n   848→\\n   849→      await saveSessionContext(testDir, sessionId, 1, context);\\n   850→\\n   851→      const contextPath = getSessionContextPath(testDir, sessionId, 1);\\n   852→      const saved = await fs.readFile(contextPath, 'utf-8');\\n   853→      const parsed = JSON.parse(saved);\\n   854→\\n   855→      expect(parsed).toEqual(context);\\n   856→    });\\n   857→\\n   858→    it('should create session directory if it does not exist', async () => {\\n   859→      const newSessionId = '01KF999999999999999999999';\\n   860→      const context = { test: 'data' };\\n   861→\\n   862→      await saveSessionContext(testDir, newSessionId, 1, context);\\n   863→\\n   864→      const contextPath = getSessionContextPath(testDir, newSessionId, 1);\\n   865→      const exists = await fs.access(contextPath).then(() => true).catch(() => false);\\n   866→\\n   867→      expect(exists).toBe(true);\\n   868→    });\\n   869→\\n   870→    it('should save multiple iteration snapshots', async () => {\\n   871→      const context1 = { iteration: 1, data: 'first' };\\n   872→      const context2 = { iteration: 2, data: 'second' };\\n   873→\\n   874→      await saveSessionContext(testDir, sessionId, 1, context1);\\n   875→      await saveSessionContext(testDir, sessionId, 2, context2);\\n   876→\\n   877→      const saved1 = await readSessionContext(testDir, sessionId, 1);\\n   878→      const saved2 = await readSessionContext(testDir, sessionId, 2);\\n   879→\\n   880→      expect(saved1).toEqual(context1);\\n   881→      expect(saved2).toEqual(context2);\\n   882→    });\\n   883→  });\\n   884→\\n   885→  describe('readSessionContext', () => {\\n   886→    it('should read saved context snapshot', async () => {\\n   887→      const context = {\\n   888→        generated_at: '2026-01-19T00:00:00.000Z',\\n   889→        active_tasks: [],\\n   890→        ready_tasks: [],\\n   891→      };\\n   892→\\n   893→      await saveSessionContext(testDir, sessionId, 1, context);\\n   894→\\n   895→      const read = await readSessionContext(testDir, sessionId, 1);\\n   896→\\n   897→      expect(read).toEqual(context);\\n   898→    });\\n   899→\\n   900→    it('should return null if context does not exist', async () => {\\n   901→      const read = await readSessionContext(testDir, sessionId, 999);\\n   902→\\n   903→      expect(read).toBeNull();\\n   904→    });\\n   905→\\n   906→    it('should return null if context file is invalid JSON', async () => {\\n   907→      const contextPath = getSessionContextPath(testDir, sessionId, 1);\\n   908→      const sessionDir = getSessionDir(testDir, sessionId);\\n   909→\\n   910→      await fs.mkdir(sessionDir, { recursive: true });\\n   911→      await fs.writeFile(contextPath, 'invalid json', 'utf-8');\\n   912→\\n   913→      const read = await readSessionContext(testDir, sessionId, 1);\\n   914→\\n   915→      expect(read).toBeNull();\\n   916→    });\\n   917→  });\\n   918→\\n   919→  describe('getSessionContextPath', () => {\\n   920→    it('should return correct path for context snapshot', () => {\\n   921→      const contextPath = getSessionContextPath(testDir, sessionId, 3);\\n   922→\\n   923→      expect(contextPath).toContain(sessionId);\\n   924→      expect(contextPath).toContain('context-iter-3.json');\\n   925→    });\\n   926→  });\\n   927→});\\n   928→\\n   929→// ─── Completed Session Counts ─────────────────────────────────────────────────\\n   930→\\n   931→// AC: @ui-agent-dispatch ac-1\\n   932→describe('getCompletedSessionCountsByAgent', () => {\\n   933→  let testDir: string;\\n   934→\\n   935→  beforeEach(async () => {\\n   936→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-completed-count-'));\\n   937→  });\\n   938→\\n   939→  afterEach(async () => {\\n   940→    await fs.rm(testDir, { recursive: true });\\n   941→  });\\n   942→\\n   943→  it('should return empty object when no sessions exist', async () => {\\n   944→    const counts = await getCompletedSessionCountsByAgent(testDir);\\n   945→    expect(counts).toEqual({});\\n   946→  });\\n   947→\\n   948→  it('should count completed sessions per agent_id', async () => {\\n   949→    // Create sessions with different agents and statuses\\n   950→    await createSession(testDir, {\\n   951→      id: '01KF123456789ABCDEFGHJKM01',\\n   952→      agent_type: 'claude-code',\\n   953→      agent_id: 'task-worker',\\n   954→    });\\n   955→    await updateSessionStatus(testDir, '01KF123456789ABCDEFGHJKM01', 'completed');\\n   956→\\n   957→    await createSession(testDir, {\\n   958→      id: '01KF123456789ABCDEFGHJKM02',\\n   959→      agent_type: 'claude-code',\\n   960→      agent_id: 'task-worker',\\n   961→    });\\n   962→    await updateSessionStatus(testDir, '01KF123456789ABCDEFGHJKM02', 'completed');\\n   963→\\n   964→    await createSession(testDir, {\\n   965→      id: '01KF123456789ABCDEFGHJKM03',\\n   966→      agent_type: 'claude-code',\\n   967→      agent_id: 'pr-reviewer',\\n   968→    });\\n   969→    await updateSessionStatus(testDir, '01KF123456789ABCDEFGHJKM03', 'completed');\\n   970→\\n   971→    // Active session should not be counted\\n   972→    await createSession(testDir, {\\n   973→      id: '01KF123456789ABCDEFGHJKM04',\\n   974→      agent_type: 'claude-code',\\n   975→      agent_id: 'task-worker',\\n   976→    });\\n   977→\\n   978→    const counts = await getCompletedSessionCountsByAgent(testDir);\\n   979→    expect(counts).toEqual({\\n   980→      'task-worker': 2,\\n   981→      'pr-reviewer': 1,\\n   982→    });\\n   983→  });\\n   984→\\n   985→  it('should not count abandoned or failed sessions', async () => {\\n   986→    await createSession(testDir, {\\n   987→      id: '01KF123456789ABCDEFGHJKM05',\\n   988→      agent_type: 'claude-code',\\n   989→      agent_id: 'task-worker',\\n   990→    });\\n   991→    await updateSessionStatus(testDir, '01KF123456789ABCDEFGHJKM05', 'abandoned');\\n   992→\\n   993→    await createSession(testDir, {\\n   994→      id: '01KF123456789ABCDEFGHJKM06',\\n   995→      agent_type: 'claude-code',\\n   996→      agent_id: 'task-worker',\\n   997→    });\\n   998→    await updateSessionStatus(testDir, '01KF123456789ABCDEFGHJKM06', 'failed');\\n   999→\\n  1000→    const counts = await getCompletedSessionCountsByAgent(testDir);\\n  1001→    expect(counts).toEqual({});\\n  1002→  });\\n  1003→\\n  1004→  it('should fall back to agent_type when agent_id is not set', async () => {\\n  1005→    await createSession(testDir, {\\n  1006→      id: '01KF123456789ABCDEFGHJKM07',\\n  1007→      agent_type: 'claude-code',\\n  1008→    });\\n  1009→    await updateSessionStatus(testDir, '01KF123456789ABCDEFGHJKM07', 'completed');\\n  1010→\\n  1011→    const counts = await getCompletedSessionCountsByAgent(testDir);\\n  1012→    // getSession() materializes agent_id from agent_type for legacy sessions\\n  1013→    expect(counts).toEqual({\\n  1014→      'claude-code': 1,\\n  1015→    });\\n  1016→  });\\n  1017→});\\n  1018→\"}]},\"uuid\":\"1962ba57-9859-4f0f-bfa5-b1c633981cc0\",\"timestamp\":\"2026-03-09T01:25:45.522Z\",\"sourceToolAssistantUUID\":\"f9fd25f0-8bdc-4943-b228-1539f720d680\"}\n{\"parentUuid\":\"1962ba57-9859-4f0f-bfa5-b1c633981cc0\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a223826\",\"slug\":\"stateful-singing-dongarra\",\"message\":{\"model\":\"claude-opus-4-6\",\"id\":\"msg_01LjF61yL8bhhv7YzfqG7YSX\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"OK, the file is completely unmodified -- my earlier edits seem to have all been reverted by the linter. Let me try using Write to write the entire file at once, which should avoid the race condition with the linter.\"}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":1,\"cache_creation_input_tokens\":13333,\"cache_read_input_tokens\":103247,\"cache_creation\":{\"ephemeral_5m_input_tokens\":13333,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":1,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"}},\"requestId\":\"req_011CYrdnoPzGdQWGPh2GPTYB\",\"type\":\"assistant\",\"uuid\":\"c61ced52-a1a9-42cb-b791-b70dee248aa0\",\"timestamp\":\"2026-03-09T01:25:50.850Z\"}\n{\"parentUuid\":\"c61ced52-a1a9-42cb-b791-b70dee248aa0\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a223826\",\"slug\":\"stateful-singing-dongarra\",\"message\":{\"model\":\"claude-opus-4-6\",\"id\":\"msg_01LjF61yL8bhhv7YzfqG7YSX\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01ENvvM8cbdcCAEJZ8oMVKgq\",\"name\":\"Write\",\"input\":{\"file_path\":\"/home/chapel/Projects/kynetic-spec/tests/sessions.test.ts\",\"content\":\"/**\\n * Session event storage tests.\\n *\\n * Tests for JSONL-based event storage for agent sessions.\\n */\\n\\nimport { describe, it, expect, beforeEach, afterEach } from 'vitest';\\nimport { createHash } from 'node:crypto';\\nimport { spawnSync } from 'node:child_process';\\nimport * as fs from 'node:fs/promises';\\nimport * as path from 'node:path';\\nimport * as os from 'node:os';\\nimport {\\n  SessionMetadataSchema,\\n  SessionEventSchema,\\n  SessionStatusSchema,\\n  EventTypeSchema,\\n  type SessionMetadataInput,\\n  type SessionEventInput,\\n} from '../src/sessions/types.js';\\nimport {\\n  createSession,\\n  getSession,\\n  updateSessionStatus,\\n  listSessions,\\n  sessionExists,\\n  appendEvent,\\n  readEvents,\\n  readEventsSince,\\n  getLastEvent,\\n  getSessionsDir,\\n  getSessionDir,\\n  getSessionMetadataPath,\\n  getSessionEventsPath,\\n  saveSessionContext,\\n  readSessionContext,\\n  getSessionContextPath,\\n  getCompletedSessionCountsByAgent,\\n} from '../src/sessions/store.js';\\n\\n// ─── Schema Tests ────────────────────────────────────────────────────────────\\n\\ndescribe('SessionStatusSchema', () => {\\n  it('should accept valid status values', () => {\\n    expect(SessionStatusSchema.safeParse('active').success).toBe(true);\\n    expect(SessionStatusSchema.safeParse('completed').success).toBe(true);\\n    expect(SessionStatusSchema.safeParse('abandoned').success).toBe(true);\\n  });\\n\\n  it('should reject invalid status values', () => {\\n    expect(SessionStatusSchema.safeParse('invalid').success).toBe(false);\\n    expect(SessionStatusSchema.safeParse('pending').success).toBe(false);\\n    expect(SessionStatusSchema.safeParse('').success).toBe(false);\\n  });\\n});\\n\\ndescribe('EventTypeSchema', () => {\\n  it('should accept valid event types', () => {\\n    expect(EventTypeSchema.safeParse('session.start').success).toBe(true);\\n    expect(EventTypeSchema.safeParse('session.update').success).toBe(true);\\n    expect(EventTypeSchema.safeParse('iteration.timeout').success).toBe(true);\\n    expect(EventTypeSchema.safeParse('session.end').success).toBe(true);\\n    expect(EventTypeSchema.safeParse('prompt.sent').success).toBe(true);\\n    expect(EventTypeSchema.safeParse('tool.call').success).toBe(true);\\n    expect(EventTypeSchema.safeParse('tool.result').success).toBe(true);\\n    expect(EventTypeSchema.safeParse('note').success).toBe(true);\\n  });\\n\\n  it('should reject invalid event types', () => {\\n    expect(EventTypeSchema.safeParse('invalid').success).toBe(false);\\n    expect(EventTypeSchema.safeParse('session_start').success).toBe(false);\\n    expect(EventTypeSchema.safeParse('').success).toBe(false);\\n  });\\n});\\n\\ndescribe('SessionMetadataSchema', () => {\\n  // AC: @session-events ac-5\\n  it('should accept valid session metadata with all fields', () => {\\n    const metadata = {\\n      id: '01KF123456789ABCDEFGHJKMNP',\\n      task_id: '@my-task',\\n      agent_type: 'claude-code',\\n      status: 'active',\\n      started_at: '2026-01-17T10:00:00.000Z',\\n    };\\n\\n    const result = SessionMetadataSchema.safeParse(metadata);\\n    expect(result.success).toBe(true);\\n  });\\n\\n  // AC: @session-events ac-5\\n  it('should accept metadata without optional task_id', () => {\\n    const metadata = {\\n      id: '01KF123456789ABCDEFGHJKMNP',\\n      agent_type: 'claude-code',\\n      status: 'active',\\n      started_at: '2026-01-17T10:00:00.000Z',\\n    };\\n\\n    const result = SessionMetadataSchema.safeParse(metadata);\\n    expect(result.success).toBe(true);\\n  });\\n\\n  it('should accept completed status with ended_at', () => {\\n    const metadata = {\\n      id: '01KF123456789ABCDEFGHJKMNP',\\n      agent_type: 'claude-code',\\n      status: 'completed',\\n      started_at: '2026-01-17T10:00:00.000Z',\\n      ended_at: '2026-01-17T11:00:00.000Z',\\n    };\\n\\n    const result = SessionMetadataSchema.safeParse(metadata);\\n    expect(result.success).toBe(true);\\n  });\\n\\n  it('should reject metadata without required fields', () => {\\n    const metadata = {\\n      id: '01KF123456789ABCDEFGHJKMNP',\\n      status: 'active',\\n    };\\n\\n    const result = SessionMetadataSchema.safeParse(metadata);\\n    expect(result.success).toBe(false);\\n  });\\n});\\n\\ndescribe('SessionEventSchema', () => {\\n  // AC: @session-events ac-2\\n  it('should accept valid event with all fields', () => {\\n    const event = {\\n      ts: Date.now(),\\n      seq: 0,\\n      type: 'session.start',\\n      session_id: '01KF123456789ABCDEFGHJKMNP',\\n      trace_id: 'trace-123',\\n      data: { message: 'Session started' },\\n    };\\n\\n    const result = SessionEventSchema.safeParse(event);\\n    expect(result.success).toBe(true);\\n  });\\n\\n  it('should accept event without optional trace_id', () => {\\n    const event = {\\n      ts: Date.now(),\\n      seq: 0,\\n      type: 'session.start',\\n      session_id: '01KF123456789ABCDEFGHJKMNP',\\n      data: null,\\n    };\\n\\n    const result = SessionEventSchema.safeParse(event);\\n    expect(result.success).toBe(true);\\n  });\\n\\n  it('should reject event without required fields', () => {\\n    const event = {\\n      ts: Date.now(),\\n      type: 'session.start',\\n    };\\n\\n    const result = SessionEventSchema.safeParse(event);\\n    expect(result.success).toBe(false);\\n  });\\n\\n  it('should reject negative sequence number', () => {\\n    const event = {\\n      ts: Date.now(),\\n      seq: -1,\\n      type: 'session.start',\\n      session_id: '01KF123456789ABCDEFGHJKMNP',\\n      data: null,\\n    };\\n\\n    const result = SessionEventSchema.safeParse(event);\\n    expect(result.success).toBe(false);\\n  });\\n});\\n\\n// ─── Path Helper Tests ───────────────────────────────────────────────────────\\n\\ndescribe('Path helpers', () => {\\n  const sessionsDir = '/test/.kspec/sessions';\\n  const sessionId = '01KF123456789ABCDEFGHJKMNP';\\n\\n  it('should construct sessions directory path', () => {\\n    expect(getSessionsDir(sessionsDir)).toBe('/test/.kspec/sessions');\\n  });\\n\\n  it('should construct session directory path', () => {\\n    expect(getSessionDir(sessionsDir, sessionId)).toBe(`/test/.kspec/sessions/${sessionId}`);\\n  });\\n\\n  it('should construct metadata file path', () => {\\n    expect(getSessionMetadataPath(sessionsDir, sessionId)).toBe(\\n      `/test/.kspec/sessions/${sessionId}/session.yaml`\\n    );\\n  });\\n\\n  it('should construct events file path', () => {\\n    expect(getSessionEventsPath(sessionsDir, sessionId)).toBe(\\n      `/test/.kspec/sessions/${sessionId}/events.jsonl`\\n    );\\n  });\\n});\\n\\n// ─── Storage Tests ───────────────────────────────────────────────────────────\\n\\ndescribe('Session storage', () => {\\n  let testDir: string;\\n  let sessionsDir: string;\\n\\n  beforeEach(async () => {\\n    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-test-'));\\n    sessionsDir = path.join(testDir, 'sessions');\\n  });\\n\\n  afterEach(async () => {\\n    await fs.rm(testDir, { recursive: true });\\n  });\\n\\n  describe('createSession', () => {\\n    // AC: @session-events ac-1\\n    it('should create session directory and metadata file', async () => {\\n      const input: SessionMetadataInput = {\\n        id: '01KF123456789ABCDEFGHJKMNP',\\n        agent_type: 'claude-code',\\n      };\\n\\n      const metadata = await createSession(sessionsDir, input);\\n\\n      // Check metadata returned\\n      expect(metadata.id).toBe(input.id);\\n      expect(metadata.agent_type).toBe(input.agent_type);\\n      expect(metadata.status).toBe('active');\\n      expect(metadata.started_at).toBeDefined();\\n\\n      // Check directory was created\\n      const sessionDir = getSessionDir(sessionsDir, input.id);\\n      const stat = await fs.stat(sessionDir);\\n      expect(stat.isDirectory()).toBe(true);\\n\\n      // Check metadata file was created\\n      const metadataPath = getSessionMetadataPath(sessionsDir, input.id);\\n      const content = await fs.readFile(metadataPath, 'utf-8');\\n      expect(content).toContain('id: ' + input.id);\\n      expect(content).toContain('agent_type: claude-code');\\n      expect(content).toContain('status: active');\\n    });\\n\\n    // AC: @session-events ac-5\\n    it('should include optional task_id in metadata', async () => {\\n      const input: SessionMetadataInput = {\\n        id: '01KF123456789ABCDEFGHJKMNP',\\n        agent_type: 'claude-code',\\n        task_id: '@my-task',\\n      };\\n\\n      const metadata = await createSession(sessionsDir, input);\\n\\n      expect(metadata.task_id).toBe('@my-task');\\n\\n      const metadataPath = getSessionMetadataPath(sessionsDir, input.id);\\n      const content = await fs.readFile(metadataPath, 'utf-8');\\n      // Accept both single and double quotes (yaml library uses double quotes)\\n      expect(content).toMatch(/task_id: [\\\"']@my-task[\\\"']/);\\n    });\\n\\n    it('should use provided started_at if given', async () => {\\n      const startTime = '2026-01-17T10:00:00.000Z';\\n      const input: SessionMetadataInput = {\\n        id: '01KF123456789ABCDEFGHJKMNP',\\n        agent_type: 'claude-code',\\n        started_at: startTime,\\n      };\\n\\n      const metadata = await createSession(sessionsDir, input);\\n\\n      expect(metadata.started_at).toBe(startTime);\\n    });\\n  });\\n\\n  describe('getSession', () => {\\n    it('should return session metadata if exists', async () => {\\n      const input: SessionMetadataInput = {\\n        id: '01KF123456789ABCDEFGHJKMNP',\\n        agent_type: 'claude-code',\\n      };\\n\\n      await createSession(sessionsDir, input);\\n      const metadata = await getSession(sessionsDir, input.id);\\n\\n      expect(metadata).not.toBeNull();\\n      expect(metadata?.id).toBe(input.id);\\n      expect(metadata?.agent_type).toBe(input.agent_type);\\n    });\\n\\n    it('should return null if session does not exist', async () => {\\n      const metadata = await getSession(sessionsDir, 'nonexistent');\\n\\n      expect(metadata).toBeNull();\\n    });\\n  });\\n\\n  describe('updateSessionStatus', () => {\\n    // AC: @session-events ac-6\\n    it('should update status and set ended_at when completing', async () => {\\n      const input: SessionMetadataInput = {\\n        id: '01KF123456789ABCDEFGHJKMNP',\\n        agent_type: 'claude-code',\\n      };\\n\\n      await createSession(sessionsDir, input);\\n      const updated = await updateSessionStatus(sessionsDir, input.id, 'completed');\\n\\n      expect(updated).not.toBeNull();\\n      expect(updated?.status).toBe('completed');\\n      expect(updated?.ended_at).toBeDefined();\\n\\n      // Verify persisted\\n      const reloaded = await getSession(sessionsDir, input.id);\\n      expect(reloaded?.status).toBe('completed');\\n      expect(reloaded?.ended_at).toBeDefined();\\n    });\\n\\n    // AC: @session-events ac-6\\n    it('should set ended_at when abandoning', async () => {\\n      const input: SessionMetadataInput = {\\n        id: '01KF123456789ABCDEFGHJKMNP',\\n        agent_type: 'claude-code',\\n      };\\n\\n      await createSession(sessionsDir, input);\\n      const updated = await updateSessionStatus(sessionsDir, input.id, 'abandoned');\\n\\n      expect(updated?.status).toBe('abandoned');\\n      expect(updated?.ended_at).toBeDefined();\\n    });\\n\\n    it('should return null if session does not exist', async () => {\\n      const updated = await updateSessionStatus(sessionsDir, 'nonexistent', 'completed');\\n\\n      expect(updated).toBeNull();\\n    });\\n  });\\n\\n  describe('listSessions', () => {\\n    it('should list all session IDs', async () => {\\n      await createSession(sessionsDir, { id: 'session-a', agent_type: 'claude-code' });\\n      await createSession(sessionsDir, { id: 'session-b', agent_type: 'claude-code' });\\n      await createSession(sessionsDir, { id: 'session-c', agent_type: 'test-agent' });\\n\\n      const sessions = await listSessions(sessionsDir);\\n\\n      expect(sessions).toHaveLength(3);\\n      expect(sessions).toContain('session-a');\\n      expect(sessions).toContain('session-b');\\n      expect(sessions).toContain('session-c');\\n    });\\n\\n    it('should return empty array if no sessions', async () => {\\n      const sessions = await listSessions(sessionsDir);\\n\\n      expect(sessions).toHaveLength(0);\\n    });\\n  });\\n\\n  describe('sessionExists', () => {\\n    it('should return true if session exists', async () => {\\n      await createSession(sessionsDir, { id: 'my-session', agent_type: 'claude-code' });\\n\\n      const exists = await sessionExists(sessionsDir, 'my-session');\\n\\n      expect(exists).toBe(true);\\n    });\\n\\n    it('should return false if session does not exist', async () => {\\n      const exists = await sessionExists(sessionsDir, 'nonexistent');\\n\\n      expect(exists).toBe(false);\\n    });\\n  });\\n});\\n\\n// ─── Event Storage Tests ─────────────────────────────────────────────────────\\n\\ndescribe('Event storage', () => {\\n  let testDir: string;\\n  let sessionsDir: string;\\n  const sessionId = '01KF123456789ABCDEFGHJKMNP';\\n\\n  beforeEach(async () => {\\n    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-event-test-'));\\n    sessionsDir = path.join(testDir, 'sessions');\\n  });\\n\\n  afterEach(async () => {\\n    await fs.rm(testDir, { recursive: true });\\n  });\\n\\n  describe('appendEvent', () => {\\n    // AC: @session-events ac-2\\n    it('should append event with auto-assigned ts and seq', async () => {\\n      const input: SessionEventInput = {\\n        type: 'session.start',\\n        session_id: sessionId,\\n        data: { message: 'Starting session' },\\n      };\\n\\n      const event = await appendEvent(sessionsDir, input);\\n\\n      expect(event.ts).toBeDefined();\\n      expect(event.ts).toBeGreaterThan(0);\\n      expect(event.seq).toBe(0);\\n      expect(event.type).toBe('session.start');\\n      expect(event.session_id).toBe(sessionId);\\n      expect(event.data).toEqual({ message: 'Starting session' });\\n    });\\n\\n    // AC: @session-events ac-2\\n    it('should auto-increment seq for subsequent events', async () => {\\n      const event1 = await appendEvent(sessionsDir, {\\n        type: 'session.start',\\n        session_id: sessionId,\\n        data: null,\\n      });\\n\\n      const event2 = await appendEvent(sessionsDir, {\\n        type: 'prompt.sent',\\n        session_id: sessionId,\\n        data: { prompt: 'Hello' },\\n      });\\n\\n      const event3 = await appendEvent(sessionsDir, {\\n        type: 'tool.call',\\n        session_id: sessionId,\\n        data: { tool: 'Read' },\\n      });\\n\\n      expect(event1.seq).toBe(0);\\n      expect(event2.seq).toBe(1);\\n      expect(event3.seq).toBe(2);\\n    });\\n\\n    // AC: @session-events ac-2\\n    it('should derive next seq from the last stored event seq', async () => {\\n      const sessionDir = getSessionDir(sessionsDir, sessionId);\\n      const eventsPath = getSessionEventsPath(sessionsDir, sessionId);\\n      await fs.mkdir(sessionDir, { recursive: true });\\n\\n      const existing = [\\n        {\\n          ts: 1000,\\n          seq: 5,\\n          type: 'session.start',\\n          session_id: sessionId,\\n          data: null,\\n        },\\n        {\\n          ts: 2000,\\n          seq: 9,\\n          type: 'session.update',\\n          session_id: sessionId,\\n          data: { message: 'existing tail event' },\\n        },\\n      ];\\n      await fs.writeFile(\\n        eventsPath,\\n        `${existing.map((event) => JSON.stringify(event)).join('\\\\n')}\\\\n`,\\n        'utf-8',\\n      );\\n\\n      const next = await appendEvent(sessionsDir, {\\n        type: 'prompt.sent',\\n        session_id: sessionId,\\n        data: { prompt: 'new event' },\\n      });\\n\\n      expect(next.seq).toBe(10);\\n    });\\n\\n    // AC: @session-events ac-3\\n    it('should create session directory if it does not exist (lazy creation)', async () => {\\n      const event = await appendEvent(sessionsDir, {\\n        type: 'session.start',\\n        session_id: sessionId,\\n        data: null,\\n      });\\n\\n      expect(event.seq).toBe(0);\\n\\n      // Verify directory was created\\n      const sessionDir = getSessionDir(sessionsDir, sessionId);\\n      const stat = await fs.stat(sessionDir);\\n      expect(stat.isDirectory()).toBe(true);\\n    });\\n\\n    it('should preserve optional trace_id', async () => {\\n      const event = await appendEvent(sessionsDir, {\\n        type: 'session.start',\\n        session_id: sessionId,\\n        trace_id: 'trace-abc-123',\\n        data: null,\\n      });\\n\\n      expect(event.trace_id).toBe('trace-abc-123');\\n    });\\n\\n    // AC: @session-events ac-3\\n    it('should write event as JSON line to events.jsonl', async () => {\\n      await appendEvent(sessionsDir, {\\n        type: 'session.start',\\n        session_id: sessionId,\\n        data: { key: 'value' },\\n      });\\n\\n      await appendEvent(sessionsDir, {\\n        type: 'prompt.sent',\\n        session_id: sessionId,\\n        data: { prompt: 'test' },\\n      });\\n\\n      const eventsPath = getSessionEventsPath(sessionsDir, sessionId);\\n      const content = await fs.readFile(eventsPath, 'utf-8');\\n      const lines = content.trim().split('\\\\n');\\n\\n      expect(lines).toHaveLength(2);\\n\\n      const event1 = JSON.parse(lines[0]);\\n      expect(event1.type).toBe('session.start');\\n      expect(event1.seq).toBe(0);\\n\\n      const event2 = JSON.parse(lines[1]);\\n      expect(event2.type).toBe('prompt.sent');\\n      expect(event2.seq).toBe(1);\\n    });\\n\\n    // AC: @session-events ac-8\\n    // AC: @session-events ac-9\\n    it('should externalize oversized rawOutput and store pointer metadata', async () => {\\n      const rawOutput = 'X'.repeat(20_000);\\n\\n      await appendEvent(sessionsDir, {\\n        type: 'session.update',\\n        session_id: sessionId,\\n        data: {\\n          iteration: 1,\\n          update: {\\n            sessionUpdate: 'tool_call_update',\\n            rawOutput,\\n          },\\n        },\\n      });\\n\\n      const eventsPath = getSessionEventsPath(sessionsDir, sessionId);\\n      const lines = (await fs.readFile(eventsPath, 'utf-8')).trim().split('\\\\n');\\n      expect(lines).toHaveLength(1);\\n\\n      const stored = JSON.parse(lines[0]);\\n      const pointer = stored.data.update.rawOutput as {\\n        path: string;\\n        bytes: number;\\n        sha256: string;\\n        truncated: boolean;\\n        preview: string;\\n      };\\n      expect(pointer.path).toMatch(/^blobs\\\\//);\\n      expect(pointer.bytes).toBe(rawOutput.length);\\n      expect(pointer.sha256).toBe(\\n        createHash('sha256').update(rawOutput).digest('hex'),\\n      );\\n      expect(pointer.truncated).toBe(true);\\n      expect(pointer.preview.length).toBeGreaterThan(0);\\n      expect(pointer.preview.length).toBeLessThan(rawOutput.length);\\n\\n      const blobPath = path.join(getSessionDir(sessionsDir, sessionId), pointer.path);\\n      const blobContent = await fs.readFile(blobPath, 'utf-8');\\n      expect(blobContent).toBe(rawOutput);\\n    });\\n\\n    it('should generate UTF-8 safe previews for externalized payloads', async () => {\\n      const rawOutput = '\\\\u6F22'.repeat(7_000);\\n\\n      await appendEvent(sessionsDir, {\\n        type: 'session.update',\\n        session_id: sessionId,\\n        data: {\\n          iteration: 1,\\n          update: {\\n            sessionUpdate: 'tool_call_update',\\n            rawOutput,\\n          },\\n        },\\n      });\\n\\n      const eventsPath = getSessionEventsPath(sessionsDir, sessionId);\\n      const stored = JSON.parse((await fs.readFile(eventsPath, 'utf-8')).trim());\\n      const pointer = stored.data.update.rawOutput as { preview: string };\\n\\n      expect(pointer.preview).toContain('...');\\n      expect(pointer.preview).not.toContain('\\\\uFFFD');\\n    });\\n\\n    it('should cap oversized event lines by externalizing whole payload', async () => {\\n      const giantPayload = 'Y'.repeat(320_000);\\n\\n      await appendEvent(sessionsDir, {\\n        type: 'prompt.sent',\\n        session_id: sessionId,\\n        data: {\\n          prompt: giantPayload,\\n        },\\n      });\\n\\n      const eventsPath = getSessionEventsPath(sessionsDir, sessionId);\\n      const rawLine = (await fs.readFile(eventsPath, 'utf-8')).trim();\\n      expect(Buffer.byteLength(rawLine, 'utf-8')).toBeLessThan(256 * 1024);\\n\\n      const parsed = JSON.parse(rawLine);\\n      const pointer = parsed.data as {\\n        path: string;\\n        bytes: number;\\n      };\\n      expect(pointer.path).toMatch(/^blobs\\\\//);\\n\\n      const blobPath = path.join(getSessionDir(sessionsDir, sessionId), pointer.path);\\n      const blobContent = await fs.readFile(blobPath, 'utf-8');\\n      expect(Buffer.byteLength(blobContent, 'utf-8')).toBe(pointer.bytes);\\n      expect(JSON.parse(blobContent)).toEqual({ prompt: giantPayload });\\n    });\\n  });\\n\\n  describe('readEvents', () => {\\n    // AC: @session-events ac-4\\n    it('should read all events in sequence order', async () => {\\n      await appendEvent(sessionsDir, {\\n        type: 'session.start',\\n        session_id: sessionId,\\n        data: null,\\n      });\\n\\n      await appendEvent(sessionsDir, {\\n        type: 'prompt.sent',\\n        session_id: sessionId,\\n        data: { prompt: 'Hello' },\\n      });\\n\\n      await appendEvent(sessionsDir, {\\n        type: 'session.end',\\n        session_id: sessionId,\\n        data: null,\\n      });\\n\\n      const events = await readEvents(sessionsDir, sessionId);\\n\\n      expect(events).toHaveLength(3);\\n      expect(events[0].type).toBe('session.start');\\n      expect(events[0].seq).toBe(0);\\n      expect(events[1].type).toBe('prompt.sent');\\n      expect(events[1].seq).toBe(1);\\n      expect(events[2].type).toBe('session.end');\\n      expect(events[2].seq).toBe(2);\\n    });\\n\\n    it('should return empty array if no events', async () => {\\n      const events = await readEvents(sessionsDir, sessionId);\\n\\n      expect(events).toHaveLength(0);\\n    });\\n\\n    it('should return empty array for nonexistent session', async () => {\\n      const events = await readEvents(sessionsDir, 'nonexistent');\\n\\n      expect(events).toHaveLength(0);\\n    });\\n\\n    it('should skip invalid JSON lines', async () => {\\n      // Create session dir and write some invalid JSON\\n      const sessionDir = getSessionDir(sessionsDir, sessionId);\\n      await fs.mkdir(sessionDir, { recursive: true });\\n\\n      const eventsPath = getSessionEventsPath(sessionsDir, sessionId);\\n      const content = [\\n        JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: sessionId, data: null }),\\n        'invalid json line',\\n        JSON.stringify({ ts: 2000, seq: 1, type: 'session.end', session_id: sessionId, data: null }),\\n      ].join('\\\\n');\\n      await fs.writeFile(eventsPath, content + '\\\\n', 'utf-8');\\n\\n      const events = await readEvents(sessionsDir, sessionId);\\n\\n      expect(events).toHaveLength(2);\\n      expect(events[0].seq).toBe(0);\\n      expect(events[1].seq).toBe(1);\\n    });\\n  });\\n\\n  describe('readEventsSince', () => {\\n    it('should filter events by timestamp', async () => {\\n      // Create events with specific timestamps\\n      await appendEvent(sessionsDir, {\\n        type: 'session.start',\\n        session_id: sessionId,\\n        ts: 1000,\\n        data: null,\\n      });\\n\\n      await appendEvent(sessionsDir, {\\n        type: 'prompt.sent',\\n        session_id: sessionId,\\n        ts: 2000,\\n        data: null,\\n      });\\n\\n      await appendEvent(sessionsDir, {\\n        type: 'session.end',\\n        session_id: sessionId,\\n        ts: 3000,\\n        data: null,\\n      });\\n\\n      const events = await readEventsSince(sessionsDir, sessionId, 1500);\\n\\n      expect(events).toHaveLength(2);\\n      expect(events[0].ts).toBe(2000);\\n      expect(events[1].ts).toBe(3000);\\n    });\\n\\n    it('should filter events by time range', async () => {\\n      await appendEvent(sessionsDir, {\\n        type: 'session.start',\\n        session_id: sessionId,\\n        ts: 1000,\\n        data: null,\\n      });\\n\\n      await appendEvent(sessionsDir, {\\n        type: 'prompt.sent',\\n        session_id: sessionId,\\n        ts: 2000,\\n        data: null,\\n      });\\n\\n      await appendEvent(sessionsDir, {\\n        type: 'session.end',\\n        session_id: sessionId,\\n        ts: 3000,\\n        data: null,\\n      });\\n\\n      const events = await readEventsSince(sessionsDir, sessionId, 1500, 2500);\\n\\n      expect(events).toHaveLength(1);\\n      expect(events[0].ts).toBe(2000);\\n    });\\n  });\\n\\n  describe('getLastEvent', () => {\\n    it('should return the last event', async () => {\\n      await appendEvent(sessionsDir, {\\n        type: 'session.start',\\n        session_id: sessionId,\\n        data: null,\\n      });\\n\\n      await appendEvent(sessionsDir, {\\n        type: 'prompt.sent',\\n        session_id: sessionId,\\n        data: { prompt: 'Hello' },\\n      });\\n\\n      await appendEvent(sessionsDir, {\\n        type: 'session.end',\\n        session_id: sessionId,\\n        data: { reason: 'completed' },\\n      });\\n\\n      const lastEvent = await getLastEvent(sessionsDir, sessionId);\\n\\n      expect(lastEvent).not.toBeNull();\\n      expect(lastEvent?.type).toBe('session.end');\\n      expect(lastEvent?.seq).toBe(2);\\n      expect(lastEvent?.data).toEqual({ reason: 'completed' });\\n    });\\n\\n    it('should return null if no events', async () => {\\n      const lastEvent = await getLastEvent(sessionsDir, sessionId);\\n\\n      expect(lastEvent).toBeNull();\\n    });\\n  });\\n\\n  describe('commit boundary inclusion', () => {\\n    // AC: @session-events ac-7\\n    it('should include accumulated events in the next git commit', async () => {\\n      const repoDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-commit-test-'));\\n      const repoSessionsDir = path.join(repoDir, 'sessions');\\n      const boundarySessionId = '01KF123456789ABCDEFGHJKMNQ';\\n\\n      const runGit = (...args: string[]) => {\\n        const result = spawnSync('git', args, {\\n          cwd: repoDir,\\n          encoding: 'utf-8',\\n        });\\n        if (result.status !== 0) {\\n          throw new Error(result.stderr || `git ${args.join(' ')} failed`);\\n        }\\n        return result.stdout.trim();\\n      };\\n\\n      try {\\n        runGit('init', '-b', 'main');\\n        runGit('config', 'user.email', 'test@example.com');\\n        runGit('config', 'user.name', 'Test User');\\n\\n        await fs.writeFile(path.join(repoDir, 'README.md'), '# test\\\\n', 'utf-8');\\n        runGit('add', 'README.md');\\n        runGit('commit', '-m', 'test: initial commit');\\n\\n        await appendEvent(repoSessionsDir, {\\n          type: 'session.update',\\n          session_id: boundarySessionId,\\n          data: {\\n            update: {\\n              rawInput: {\\n                command: 'kspec task complete @task-ref --reason \\\"Done\\\"',\\n              },\\n            },\\n          },\\n        });\\n\\n        runGit('add', '.');\\n        runGit('commit', '-m', 'test: commit boundary includes session events');\\n\\n        const committedFiles = runGit('show', '--name-only', '--pretty=format:', 'HEAD');\\n        expect(committedFiles).toContain(`sessions/${boundarySessionId}/events.jsonl`);\\n      } finally {\\n        await fs.rm(repoDir, { recursive: true, force: true });\\n      }\\n    });\\n  });\\n\\n  describe('saveSessionContext', () => {\\n    it('should save context snapshot for a given iteration', async () => {\\n      const context = {\\n        generated_at: '2026-01-19T00:00:00.000Z',\\n        branch: 'main',\\n        active_tasks: [],\\n        ready_tasks: [{ ref: '@task-1', title: 'Test task' }],\\n        stats: { total_tasks: 1 },\\n      };\\n\\n      await saveSessionContext(sessionsDir, sessionId, 1, context);\\n\\n      const contextPath = getSessionContextPath(sessionsDir, sessionId, 1);\\n      const saved = await fs.readFile(contextPath, 'utf-8');\\n      const parsed = JSON.parse(saved);\\n\\n      expect(parsed).toEqual(context);\\n    });\\n\\n    it('should create session directory if it does not exist', async () => {\\n      const newSessionId = '01KF999999999999999999999';\\n      const context = { test: 'data' };\\n\\n      await saveSessionContext(sessionsDir, newSessionId, 1, context);\\n\\n      const contextPath = getSessionContextPath(sessionsDir, newSessionId, 1);\\n      const exists = await fs.access(contextPath).then(() => true).catch(() => false);\\n\\n      expect(exists).toBe(true);\\n    });\\n\\n    it('should save multiple iteration snapshots', async () => {\\n      const context1 = { iteration: 1, data: 'first' };\\n      const context2 = { iteration: 2, data: 'second' };\\n\\n      await saveSessionContext(sessionsDir, sessionId, 1, context1);\\n      await saveSessionContext(sessionsDir, sessionId, 2, context2);\\n\\n      const saved1 = await readSessionContext(sessionsDir, sessionId, 1);\\n      const saved2 = await readSessionContext(sessionsDir, sessionId, 2);\\n\\n      expect(saved1).toEqual(context1);\\n      expect(saved2).toEqual(context2);\\n    });\\n  });\\n\\n  describe('readSessionContext', () => {\\n    it('should read saved context snapshot', async () => {\\n      const context = {\\n        generated_at: '2026-01-19T00:00:00.000Z',\\n        active_tasks: [],\\n        ready_tasks: [],\\n      };\\n\\n      await saveSessionContext(sessionsDir, sessionId, 1, context);\\n\\n      const read = await readSessionContext(sessionsDir, sessionId, 1);\\n\\n      expect(read).toEqual(context);\\n    });\\n\\n    it('should return null if context does not exist', async () => {\\n      const read = await readSessionContext(sessionsDir, sessionId, 999);\\n\\n      expect(read).toBeNull();\\n    });\\n\\n    it('should return null if context file is invalid JSON', async () => {\\n      const contextPath = getSessionContextPath(sessionsDir, sessionId, 1);\\n      const sessionDir = getSessionDir(sessionsDir, sessionId);\\n\\n      await fs.mkdir(sessionDir, { recursive: true });\\n      await fs.writeFile(contextPath, 'invalid json', 'utf-8');\\n\\n      const read = await readSessionContext(sessionsDir, sessionId, 1);\\n\\n      expect(read).toBeNull();\\n    });\\n  });\\n\\n  describe('getSessionContextPath', () => {\\n    it('should return correct path for context snapshot', () => {\\n      const contextPath = getSessionContextPath(sessionsDir, sessionId, 3);\\n\\n      expect(contextPath).toContain(sessionId);\\n      expect(contextPath).toContain('context-iter-3.json');\\n    });\\n  });\\n});\\n\\n// ─── Completed Session Counts ─────────────────────────────────────────────────\\n\\n// AC: @ui-agent-dispatch ac-1\\ndescribe('getCompletedSessionCountsByAgent', () => {\\n  let testDir: string;\\n  let sessionsDir: string;\\n\\n  beforeEach(async () => {\\n    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-completed-count-'));\\n    sessionsDir = path.join(testDir, 'sessions');\\n  });\\n\\n  afterEach(async () => {\\n    await fs.rm(testDir, { recursive: true });\\n  });\\n\\n  it('should return empty object when no sessions exist', async () => {\\n    const counts = await getCompletedSessionCountsByAgent(sessionsDir);\\n    expect(counts).toEqual({});\\n  });\\n\\n  it('should count completed sessions per agent_id', async () => {\\n    // Create sessions with different agents and statuses\\n    await createSession(sessionsDir, {\\n      id: '01KF123456789ABCDEFGHJKM01',\\n      agent_type: 'claude-code',\\n      agent_id: 'task-worker',\\n    });\\n    await updateSessionStatus(sessionsDir, '01KF123456789ABCDEFGHJKM01', 'completed');\\n\\n    await createSession(sessionsDir, {\\n      id: '01KF123456789ABCDEFGHJKM02',\\n      agent_type: 'claude-code',\\n      agent_id: 'task-worker',\\n    });\\n    await updateSessionStatus(sessionsDir, '01KF123456789ABCDEFGHJKM02', 'completed');\\n\\n    await createSession(sessionsDir, {\\n      id: '01KF123456789ABCDEFGHJKM03',\\n      agent_type: 'claude-code',\\n      agent_id: 'pr-reviewer',\\n    });\\n    await updateSessionStatus(sessionsDir, '01KF123456789ABCDEFGHJKM03', 'completed');\\n\\n    // Active session should not be counted\\n    await createSession(sessionsDir, {\\n      id: '01KF123456789ABCDEFGHJKM04',\\n      agent_type: 'claude-code',\\n      agent_id: 'task-worker',\\n    });\\n\\n    const counts = await getCompletedSessionCountsByAgent(sessionsDir);\\n    expect(counts).toEqual({\\n      'task-worker': 2,\\n      'pr-reviewer': 1,\\n    });\\n  });\\n\\n  it('should not count abandoned or failed sessions', async () => {\\n    await createSession(sessionsDir, {\\n      id: '01KF123456789ABCDEFGHJKM05',\\n      agent_type: 'claude-code',\\n      agent_id: 'task-worker',\\n    });\\n    await updateSessionStatus(sessionsDir, '01KF123456789ABCDEFGHJKM05', 'abandoned');\\n\\n    await createSession(sessionsDir, {\\n      id: '01KF123456789ABCDEFGHJKM06',\\n      agent_type: 'claude-code',\\n      agent_id: 'task-worker',\\n    });\\n    await updateSessionStatus(sessionsDir, '01KF123456789ABCDEFGHJKM06', 'failed');\\n\\n    const counts = await getCompletedSessionCountsByAgent(sessionsDir);\\n    expect(counts).toEqual({});\\n  });\\n\\n  it('should fall back to agent_type when agent_id is not set', async () => {\\n    await createSession(sessionsDir, {\\n      id: '01KF123456789ABCDEFGHJKM07',\\n      agent_type: 'claude-code',\\n    });\\n    await updateSessionStatus(sessionsDir, '01KF123456789ABCDEFGHJKM07', 'completed');\\n\\n    const counts = await getCompletedSessionCountsByAgent(sessionsDir);\\n    // getSession() materializes agent_id from agent_type for legacy sessions\\n    expect(counts).toEqual({\\n      'claude-code': 1,\\n    });\\n  });\\n});\\n\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":1,\"cache_creation_input_tokens\":13333,\"cache_read_input_tokens\":103247,\"cache_creation\":{\"ephemeral_5m_input_tokens\":13333,\"ephemeral_1h_input_tokens\":0},\