dget schema validation and CRUD operations\\n     5→ * (create, read, check, increment, reset).\\n     6→ *\\n     7→ * Task: @extend-session-schema-with-task-budget\\n     8→ * Spec: @session-creation-and-env-injection\\n     9→ * Spec: @task-budget-enforcement\\n    10→ */\\n    11→\\n    12→import { describe, it, expect, beforeEach, afterEach } from \\\"vitest\\\";\\n    13→import * as fs from \\\"node:fs/promises\\\";\\n    14→import * as path from \\\"node:path\\\";\\n    15→import * as os from \\\"node:os\\\";\\n    16→import { TaskBudgetSchema } from \\\"../src/sessions/types.js\\\";\\n    17→import {\\n    18→  createBudget,\\n    19→  getBudget,\\n    20→  checkBudget,\\n    21→  incrementBudget,\\n    22→  resetBudget,\\n    23→  getSessionBudgetPath,\\n    24→  createSession,\\n    25→} from \\\"../src/sessions/store.js\\\";\\n    26→import type { SessionMetadataInput } from \\\"../src/sessions/types.js\\\";\\n    27→\\n    28→// ─── Schema Tests ────────────────────────────────────────────────────────────\\n    29→\\n    30→describe(\\\"TaskBudgetSchema\\\", () => {\\n    31→  // AC: @session-creation-and-env-injection ac-budget\\n    32→  it(\\\"should accept valid budget with positive max and zero started\\\", () => {\\n    33→    const result = TaskBudgetSchema.safeParse({\\n    34→      max_per_cycle: 3,\\n    35→      started_this_cycle: 0,\\n    36→    });\\n    37→    expect(result.success).toBe(true);\\n    38→    if (result.success) {\\n    39→      expect(result.data.max_per_cycle).toBe(3);\\n    40→      expect(result.data.started_this_cycle).toBe(0);\\n    41→    }\\n    42→  });\\n    43→\\n    44→  it(\\\"should accept budget with started equal to max\\\", () => {\\n    45→    const result = TaskBudgetSchema.safeParse({\\n    46→      max_per_cycle: 2,\\n    47→      started_this_cycle: 2,\\n    48→    });\\n    49→    expect(result.success).toBe(true);\\n    50→  });\\n    51→\\n    52→  it(\\\"should accept budget with started exceeding max (counter, not constraint)\\\", () => {\\n    53→    const result = TaskBudgetSchema.safeParse({\\n    54→      max_per_cycle: 1,\\n    55→      started_this_cycle: 5,\\n    56→    });\\n    57→    expect(result.success).toBe(true);\\n    58→  });\\n    59→\\n    60→  it(\\\"should reject zero max_per_cycle\\\", () => {\\n    61→    const result = TaskBudgetSchema.safeParse({\\n    62→      max_per_cycle: 0,\\n    63→      started_this_cycle: 0,\\n    64→    });\\n    65→    expect(result.success).toBe(false);\\n    66→  });\\n    67→\\n    68→  it(\\\"should reject negative max_per_cycle\\\", () => {\\n    69→    const result = TaskBudgetSchema.safeParse({\\n    70→      max_per_cycle: -1,\\n    71→      started_this_cycle: 0,\\n    72→    });\\n    73→    expect(result.success).toBe(false);\\n    74→  });\\n    75→\\n    76→  it(\\\"should reject negative started_this_cycle\\\", () => {\\n    77→    const result = TaskBudgetSchema.safeParse({\\n    78→      max_per_cycle: 3,\\n    79→      started_this_cycle: -1,\\n    80→    });\\n    81→    expect(result.success).toBe(false);\\n    82→  });\\n    83→\\n    84→  it(\\\"should reject non-integer max_per_cycle\\\", () => {\\n    85→    const result = TaskBudgetSchema.safeParse({\\n    86→      max_per_cycle: 1.5,\\n    87→      started_this_cycle: 0,\\n    88→    });\\n    89→    expect(result.success).toBe(false);\\n    90→  });\\n    91→\\n    92→  it(\\\"should reject non-integer started_this_cycle\\\", () => {\\n    93→    const result = TaskBudgetSchema.safeParse({\\n    94→      max_per_cycle: 1,\\n    95→      started_this_cycle: 0.5,\\n    96→    });\\n    97→    expect(result.success).toBe(false);\\n    98→  });\\n    99→\\n   100→  it(\\\"should reject missing fields\\\", () => {\\n   101→    expect(TaskBudgetSchema.safeParse({}).success).toBe(false);\\n   102→    expect(\\n   103→      TaskBudgetSchema.safeParse({ max_per_cycle: 1 }).success,\\n   104→    ).toBe(false);\\n   105→    expect(\\n   106→      TaskBudgetSchema.safeParse({ started_this_cycle: 0 }).success,\\n   107→    ).toBe(false);\\n   108→  });\\n   109→});\\n   110→\\n   111→// ─── Path Helper Tests ──────────────────────────────────────────────────────\\n   112→\\n   113→describe(\\\"getSessionBudgetPath\\\", () => {\\n   114→  // AC: @session-creation-and-env-injection ac-budget-local\\n   115→  it(\\\"should return path inside session directory\\\", () => {\\n   116→    const specDir = \\\"/test/.kspec\\\";\\n   117→    const sessionId = \\\"01KF123456789ABCDEFGHJKMNP\\\";\\n   118→    expect(getSessionBudgetPath(specDir, sessionId)).toBe(\\n   119→      `/test/.kspec/sessions/${sessionId}/budget.json`,\\n   120→    );\\n   121→  });\\n   122→});\\n   123→\\n   124→// ─── Budget CRUD Tests ──────────────────────────────────────────────────────\\n   125→\\n   126→describe(\\\"Budget CRUD\\\", () => {\\n   127→  let testDir: string;\\n   128→  const sessionId = \\\"01KF123456789ABCDEFGHJKMNP\\\";\\n   129→\\n   130→  beforeEach(async () => {\\n   131→    testDir = await fs.mkdtemp(\\n   132→      path.join(os.tmpdir(), \\\"kspec-budget-test-\\\"),\\n   133→    );\\n   134→    // Create a session directory so budget operations have a home\\n   135→    const input: SessionMetadataInput = {\\n   136→      id: sessionId,\\n   137→      agent_type: \\\"claude-code\\\",\\n   138→    };\\n   139→    await createSession(testDir, input);\\n   140→  });\\n   141→\\n   142→  afterEach(async () => {\\n   143→    await fs.rm(testDir, { recursive: true });\\n   144→  });\\n   145→\\n   146→  describe(\\\"createBudget\\\", () => {\\n   147→    // AC: @session-creation-and-env-injection ac-budget\\n   148→    it(\\\"should create budget.json with max_per_cycle and started_this_cycle=0\\\", async () => {\\n   149→      const budget = await createBudget(testDir, sessionId, 3);\\n   150→\\n   151→      expect(budget.max_per_cycle).toBe(3);\\n   152→      expect(budget.started_this_cycle).toBe(0);\\n   153→\\n   154→      // Verify file on disk\\n   155→      const budgetPath = getSessionBudgetPath(testDir, sessionId);\\n   156→      const content = await fs.readFile(budgetPath, \\\"utf-8\\\");\\n   157→      const parsed = JSON.parse(content);\\n   158→      expect(parsed.max_per_cycle).toBe(3);\\n   159→      expect(parsed.started_this_cycle).toBe(0);\\n   160→    });\\n   161→\\n   162→    // AC: @session-creation-and-env-injection ac-budget-local\\n   163→    it(\\\"should store budget in local filesystem under sessions dir\\\", async () => {\\n   164→      await createBudget(testDir, sessionId, 2);\\n   165→\\n   166→      const budgetPath = getSessionBudgetPath(testDir, sessionId);\\n   167→      expect(budgetPath).toContain(\\\"sessions\\\");\\n   168→      expect(budgetPath).toContain(sessionId);\\n   169→      expect(budgetPath).toContain(\\\"budget.json\\\");\\n   170→\\n   171→      // File should exist\\n   172→      const stat = await fs.stat(budgetPath);\\n   173→      expect(stat.isFile()).toBe(true);\\n   174→    });\\n   175→\\n   176→    it(\\\"should reject invalid max_per_cycle\\\", async () => {\\n   177→      await expect(createBudget(testDir, sessionId, 0)).rejects.toThrow();\\n   178→      await expect(createBudget(testDir, sessionId, -1)).rejects.toThrow();\\n   179→    });\\n   180→  });\\n   181→\\n   182→  describe(\\\"getBudget\\\", () => {\\n   183→    // AC: @task-budget-enforcement ac-no-budget\\n   184→    it(\\\"should return null when no budget configured\\\", async () => {\\n   185→      const budget = await getBudget(testDir, sessionId);\\n   186→      expect(budget).toBeNull();\\n   187→    });\\n   188→\\n   189→    it(\\\"should return budget after creation\\\", async () => {\\n   190→      await createBudget(testDir, sessionId, 5);\\n   191→      const budget = await getBudget(testDir, sessionId);\\n   192→\\n   193→      expect(budget).not.toBeNull();\\n   194→      expect(budget!.max_per_cycle).toBe(5);\\n   195→      expect(budget!.started_this_cycle).toBe(0);\\n   196→    });\\n   197→\\n   198→    it(\\\"should return null for nonexistent session\\\", async () => {\\n   199→      const budget = await getBudget(testDir, \\\"NONEXISTENT\\\");\\n   200→      expect(budget).toBeNull();\\n   201→    });\\n   202→\\n   203→    it(\\\"should throw on corrupt budget.json (fail closed, not open)\\\", async () => {\\n   204→      // Write invalid JSON to budget.json — should throw, not silently disable enforcement\\n   205→      const budgetPath = getSessionBudgetPath(testDir, sessionId);\\n   206→      await fs.writeFile(budgetPath, \\\"not valid json{{{\\\", \\\"utf-8\\\");\\n   207→\\n   208→      await expect(getBudget(testDir, sessionId)).rejects.toThrow();\\n   209→    });\\n   210→\\n   211→    it(\\\"should throw on budget.json with invalid schema\\\", async () => {\\n   212→      // Write valid JSON but wrong schema — should throw, not silently disable enforcement\\n   213→      const budgetPath = getSessionBudgetPath(testDir, sessionId);\\n   214→      await fs.writeFile(budgetPath, JSON.stringify({ wrong: \\\"shape\\\" }), \\\"utf-8\\\");\\n   215→\\n   216→      await expect(getBudget(testDir, sessionId)).rejects.toThrow();\\n   217→    });\\n   218→  });\\n   219→\\n   220→  describe(\\\"checkBudget\\\", () => {\\n   221→    // AC: @task-budget-enforcement ac-no-session\\n   222→    it(\\\"should allow when no session ID provided\\\", async () => {\\n   223→      const result = await checkBudget(testDir, undefined);\\n   224→      expect(result.allowed).toBe(true);\\n   225→      expect(result.budget).toBeUndefined();\\n   226→    });\\n   227→\\n   228→    // AC: @task-budget-enforcement ac-no-budget\\n   229→    it(\\\"should allow when session has no budget configured\\\", async () => {\\n   230→      const result = await checkBudget(testDir, sessionId);\\n   231→      expect(result.allowed).toBe(true);\\n   232→      expect(result.budget).toBeUndefined();\\n   233→    });\\n   234→\\n   235→    it(\\\"should allow when under budget\\\", async () => {\\n   236→      await createBudget(testDir, sessionId, 3);\\n   237→      const result = await checkBudget(testDir, sessionId);\\n   238→\\n   239→      expect(result.allowed).toBe(true);\\n   240→      expect(result.budget).toBeDefined();\\n   241→      expect(result.budget!.started_this_cycle).toBe(0);\\n   242→    });\\n   243→\\n   244→    // AC: @task-budget-enforcement ac-block-start\\n   245→    it(\\\"should block when budget exhausted\\\", async () => {\\n   246→      await createBudget(testDir, sessionId, 1);\\n   247→      await incrementBudget(testDir, sessionId);\\n   248→\\n   249→      const result = await checkBudget(testDir, sessionId);\\n   250→      expect(result.allowed).toBe(false);\\n   251→      expect(result.reason).toContain(\\\"1/1\\\");\\n   252→      expect(result.reason).toContain(\\\"budget exhausted\\\");\\n   253→      expect(result.budget).toBeDefined();\\n   254→      expect(result.budget!.started_this_cycle).toBe(1);\\n   255→    });\\n   256→\\n   257→    // AC: @task-budget-enforcement ac-block-start\\n   258→    it(\\\"should include budget counts in rejection message\\\", async () => {\\n   259→      await createBudget(testDir, sessionId, 2);\\n   260→      await incrementBudget(testDir, sessionId);\\n   261→      await incrementBudget(testDir, sessionId);\\n   262→\\n   263→      const result = await checkBudget(testDir, sessionId);\\n   264→      expect(result.allowed).toBe(false);\\n   265→      expect(result.reason).toContain(\\\"2/2\\\");\\n   266→      expect(result.reason).toContain(\\\"Wrap up\\\");\\n   267→    });\\n   268→  });\\n   269→\\n   270→  describe(\\\"incrementBudget\\\", () => {\\n   271→    // AC: @task-budget-enforcement ac-increment\\n   272→    it(\\\"should increment started_this_cycle by 1\\\", async () => {\\n   273→      await createBudget(testDir, sessionId, 5);\\n   274→\\n   275→      const updated = await incrementBudget(testDir, sessionId);\\n   276→      expect(updated).not.toBeNull();\\n   277→      expect(updated!.started_this_cycle).toBe(1);\\n   278→      expect(updated!.max_per_cycle).toBe(5);\\n   279→\\n   280→      // Verify persisted\\n   281→      const read = await getBudget(testDir, sessionId);\\n   282→      expect(read!.started_this_cycle).toBe(1);\\n   283→    });\\n   284→\\n   285→    it(\\\"should increment multiple times\\\", async () => {\\n   286→      await createBudget(testDir, sessionId, 5);\\n   287→\\n   288→      await incrementBudget(testDir, sessionId);\\n   289→      await incrementBudget(testDir, sessionId);\\n   290→      const updated = await incrementBudget(testDir, sessionId);\\n   291→\\n   292→      expect(updated!.started_this_cycle).toBe(3);\\n   293→    });\\n   294→\\n   295→    it(\\\"should return null when no budget configured\\\", async () => {\\n   296→      const result = await incrementBudget(testDir, sessionId);\\n   297→      expect(result).toBeNull();\\n   298→    });\\n   299→\\n   300→    // AC: @task-budget-enforcement ac-atomic-write\\n   301→    it(\\\"should write atomically (no temp files left behind)\\\", async () => {\\n   302→      await createBudget(testDir, sessionId, 3);\\n   303→      await incrementBudget(testDir, sessionId);\\n   304→\\n   305→      // Check that no .tmp files remain in session dir\\n   306→      const sessionDir = path.join(testDir, \\\"sessions\\\", sessionId);\\n   307→      const files = await fs.readdir(sessionDir);\\n   308→      const tmpFiles = files.filter((f) => f.endsWith(\\\".tmp\\\"));\\n   309→      expect(tmpFiles).toHaveLength(0);\\n   310→    });\\n   311→  });\\n   312→\\n   313→  describe(\\\"resetBudget\\\", () => {\\n   314→    // AC: @task-budget-enforcement ac-reset\\n   315→    it(\\\"should reset started_this_cycle to 0\\\", async () => {\\n   316→      await createBudget(testDir, sessionId, 3);\\n   317→      await incrementBudget(testDir, sessionId);\\n   318→      await incrementBudget(testDir, sessionId);\\n   319→\\n   320→      const reset = await resetBudget(testDir, sessionId);\\n   321→      expect(reset).not.toBeNull();\\n   322→      expect(reset!.started_this_cycle).toBe(0);\\n   323→      expect(reset!.max_per_cycle).toBe(3);\\n   324→\\n   325→      // Verify persisted\\n   326→      const read = await getBudget(testDir, sessionId);\\n   327→      expect(read!.started_this_cycle).toBe(0);\\n   328→    });\\n   329→\\n   330→    it(\\\"should return null when no budget configured\\\", async () => {\\n   331→      const result = await resetBudget(testDir, sessionId);\\n   332→      expect(result).toBeNull();\\n   333→    });\\n   334→\\n   335→    it(\\\"should preserve max_per_cycle after reset\\\", async () => {\\n   336→      await createBudget(testDir, sessionId, 7);\\n   337→      await incrementBudget(testDir, sessionId);\\n   338→      await resetBudget(testDir, sessionId);\\n   339→\\n   340→      const budget = await getBudget(testDir, sessionId);\\n   341→      expect(budget!.max_per_cycle).toBe(7);\\n   342→      expect(budget!.started_this_cycle).toBe(0);\\n   343→    });\\n   344→\\n   345→    // AC: @task-budget-enforcement ac-atomic-write\\n   346→    it(\\\"should write atomically (no temp files left behind)\\\", async () => {\\n   347→      await createBudget(testDir, sessionId, 3);\\n   348→      await incrementBudget(testDir, sessionId);\\n   349→      await resetBudget(testDir, sessionId);\\n   350→\\n   351→      const sessionDir = path.join(testDir, \\\"sessions\\\", sessionId);\\n   352→      const files = await fs.readdir(sessionDir);\\n   353→      const tmpFiles = files.filter((f) => f.endsWith(\\\".tmp\\\"));\\n   354→      expect(tmpFiles).toHaveLength(0);\\n   355→    });\\n   356→  });\\n   357→\\n   358→  describe(\\\"full lifecycle\\\", () => {\\n   359→    it(\\\"should support create → increment → check → reset → check cycle\\\", async () => {\\n   360→      // Create budget allowing 1 task per cycle\\n   361→      await createBudget(testDir, sessionId, 1);\\n   362→\\n   363→      // Check: should be allowed (0/1)\\n   364→      let check = await checkBudget(testDir, sessionId);\\n   365→      expect(check.allowed).toBe(true);\\n   366→\\n   367→      // Increment after starting a task\\n   368→      await incrementBudget(testDir, sessionId);\\n   369→\\n   370→      // Check: should be blocked (1/1)\\n   371→      check = await checkBudget(testDir, sessionId);\\n   372→      expect(check.allowed).toBe(false);\\n   373→\\n   374→      // Reset at iteration boundary\\n   375→      await resetBudget(testDir, sessionId);\\n   376→\\n   377→      // Check: should be allowed again (0/1)\\n   378→      check = await checkBudget(testDir, sessionId);\\n   379→      expect(check.allowed).toBe(true);\\n   380→    });\\n   381→  });\\n   382→});\\n   383→\"}]},\"uuid\":\"738726e9-f209-4da1-9beb-c7e3e4f9f5d1\",\"timestamp\":\"2026-03-09T01:27:45.253Z\",\"sourceToolAssistantUUID\":\"9c65676c-ffb2-4fca-aa2d-c1affbacae21\"}\n{\"parentUuid\":\"738726e9-f209-4da1-9beb-c7e3e4f9f5d1\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a223826\",\"slug\":\"stateful-singing-dongarra\",\"message\":{\"model\":\"claude-opus-4-6\",\"id\":\"msg_01L6rBVkJEyJbWRos7CBUFuw\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Now I need to update this file. Key changes:\\n1. Path helper test: change `specDir` to `sessionsDir`\\n2. Budget CRUD tests: add `sessionsDir`, replace all session store calls\\n3. The `path.join(testDir, \\\"sessions\\\", sessionId)` references for filesystem checks stay as-is since they're checking the actual filesystem path (which is `sessionsDir + \\\"/\\\" + sessionId`)\\n\\nWait, actually those `path.join(testDir, \\\"sessions\\\", sessionId)` references -- since `sessionsDir = path.join(testDir, \\\"sessions\\\")`, they should become `path.join(sessionsDir, sessionId)`. Let me update those too.\"}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":1,\"cache_creation_input_tokens\":5373,\"cache_read_input_tokens\":127155,\"cache_creation\":{\"ephemeral_5m_input_tokens\":5373,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"}},\"requestId\":\"req_011CYrdwdPjB8PgrtnQcWFuV\",\"type\":\"assistant\",\"uuid\":\"162076fe-6668-40f4-8a09-2263ab9165e3\",\"timestamp\":\"2026-03-09T01:27:52.178Z\"}\n{\"parentUuid\":\"162076fe-6668-40f4-8a09-2263ab9165e3\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a223826\",\"slug\":\"stateful-singing-dongarra\",\"message\":{\"model\":\"claude-opus-4-6\",\"id\":\"msg_01L6rBVkJEyJbWRos7CBUFuw\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01E3DD4C7WYsyJPtyKp5gE2B\",\"name\":\"Write\",\"input\":{\"file_path\":\"/home/chapel/Projects/kynetic-spec/tests/session-budget.test.ts\",\"content\":\"/**\\n * Session task budget tests.\\n *\\n * Tests for budget schema validation and CRUD operations\\n * (create, read, check, increment, reset).\\n *\\n * Task: @extend-session-schema-with-task-budget\\n * Spec: @session-creation-and-env-injection\\n * Spec: @task-budget-enforcement\\n */\\n\\nimport { describe, it, expect, beforeEach, afterEach } from \\\"vitest\\\";\\nimport * as fs from \\\"node:fs/promises\\\";\\nimport * as path from \\\"node:path\\\";\\nimport * as os from \\\"node:os\\\";\\nimport { TaskBudgetSchema } from \\\"../src/sessions/types.js\\\";\\nimport {\\n  createBudget,\\n  getBudget,\\n  checkBudget,\\n  incrementBudget,\\n  resetBudget,\\n  getSessionBudgetPath,\\n  createSession,\\n} from \\\"../src/sessions/store.js\\\";\\nimport type { SessionMetadataInput } from \\\"../src/sessions/types.js\\\";\\n\\n// ─── Schema Tests ────────────────────────────────────────────────────────────\\n\\ndescribe(\\\"TaskBudgetSchema\\\", () => {\\n  // AC: @session-creation-and-env-injection ac-budget\\n  it(\\\"should accept valid budget with positive max and zero started\\\", () => {\\n    const result = TaskBudgetSchema.safeParse({\\n      max_per_cycle: 3,\\n      started_this_cycle: 0,\\n    });\\n    expect(result.success).toBe(true);\\n    if (result.success) {\\n      expect(result.data.max_per_cycle).toBe(3);\\n      expect(result.data.started_this_cycle).toBe(0);\\n    }\\n  });\\n\\n  it(\\\"should accept budget with started equal to max\\\", () => {\\n    const result = TaskBudgetSchema.safeParse({\\n      max_per_cycle: 2,\\n      started_this_cycle: 2,\\n    });\\n    expect(result.success).toBe(true);\\n  });\\n\\n  it(\\\"should accept budget with started exceeding max (counter, not constraint)\\\", () => {\\n    const result = TaskBudgetSchema.safeParse({\\n      max_per_cycle: 1,\\n      started_this_cycle: 5,\\n    });\\n    expect(result.success).toBe(true);\\n  });\\n\\n  it(\\\"should reject zero max_per_cycle\\\", () => {\\n    const result = TaskBudgetSchema.safeParse({\\n      max_per_cycle: 0,\\n      started_this_cycle: 0,\\n    });\\n    expect(result.success).toBe(false);\\n  });\\n\\n  it(\\\"should reject negative max_per_cycle\\\", () => {\\n    const result = TaskBudgetSchema.safeParse({\\n      max_per_cycle: -1,\\n      started_this_cycle: 0,\\n    });\\n    expect(result.success).toBe(false);\\n  });\\n\\n  it(\\\"should reject negative started_this_cycle\\\", () => {\\n    const result = TaskBudgetSchema.safeParse({\\n      max_per_cycle: 3,\\n      started_this_cycle: -1,\\n    });\\n    expect(result.success).toBe(false);\\n  });\\n\\n  it(\\\"should reject non-integer max_per_cycle\\\", () => {\\n    const result = TaskBudgetSchema.safeParse({\\n      max_per_cycle: 1.5,\\n      started_this_cycle: 0,\\n    });\\n    expect(result.success).toBe(false);\\n  });\\n\\n  it(\\\"should reject non-integer started_this_cycle\\\", () => {\\n    const result = TaskBudgetSchema.safeParse({\\n      max_per_cycle: 1,\\n      started_this_cycle: 0.5,\\n    });\\n    expect(result.success).toBe(false);\\n  });\\n\\n  it(\\\"should reject missing fields\\\", () => {\\n    expect(TaskBudgetSchema.safeParse({}).success).toBe(false);\\n    expect(\\n      TaskBudgetSchema.safeParse({ max_per_cycle: 1 }).success,\\n    ).toBe(false);\\n    expect(\\n      TaskBudgetSchema.safeParse({ started_this_cycle: 0 }).success,\\n    ).toBe(false);\\n  });\\n});\\n\\n// ─── Path Helper Tests ──────────────────────────────────────────────────────\\n\\ndescribe(\\\"getSessionBudgetPath\\\", () => {\\n  // AC: @session-creation-and-env-injection ac-budget-local\\n  it(\\\"should return path inside session directory\\\", () => {\\n    const sessionsDir = \\\"/test/.kspec/sessions\\\";\\n    const sessionId = \\\"01KF123456789ABCDEFGHJKMNP\\\";\\n    expect(getSessionBudgetPath(sessionsDir, sessionId)).toBe(\\n      `/test/.kspec/sessions/${sessionId}/budget.json`,\\n    );\\n  });\\n});\\n\\n// ─── Budget CRUD Tests ──────────────────────────────────────────────────────\\n\\ndescribe(\\\"Budget CRUD\\\", () => {\\n  let testDir: string;\\n  let sessionsDir: string;\\n  const sessionId = \\\"01KF123456789ABCDEFGHJKMNP\\\";\\n\\n  beforeEach(async () => {\\n    testDir = await fs.mkdtemp(\\n      path.join(os.tmpdir(), \\\"kspec-budget-test-\\\"),\\n    );\\n    sessionsDir = path.join(testDir, \\\"sessions\\\");\\n    // Create a session directory so budget operations have a home\\n    const input: SessionMetadataInput = {\\n      id: sessionId,\\n      agent_type: \\\"claude-code\\\",\\n    };\\n    await createSession(sessionsDir, input);\\n  });\\n\\n  afterEach(async () => {\\n    await fs.rm(testDir, { recursive: true });\\n  });\\n\\n  describe(\\\"createBudget\\\", () => {\\n    // AC: @session-creation-and-env-injection ac-budget\\n    it(\\\"should create budget.json with max_per_cycle and started_this_cycle=0\\\", async () => {\\n      const budget = await createBudget(sessionsDir, sessionId, 3);\\n\\n      expect(budget.max_per_cycle).toBe(3);\\n      expect(budget.started_this_cycle).toBe(0);\\n\\n      // Verify file on disk\\n      const budgetPath = getSessionBudgetPath(sessionsDir, sessionId);\\n      const content = await fs.readFile(budgetPath, \\\"utf-8\\\");\\n      const parsed = JSON.parse(content);\\n      expect(parsed.max_per_cycle).toBe(3);\\n      expect(parsed.started_this_cycle).toBe(0);\\n    });\\n\\n    // AC: @session-creation-and-env-injection ac-budget-local\\n    it(\\\"should store budget in local filesystem under sessions dir\\\", async () => {\\n      await createBudget(sessionsDir, sessionId, 2);\\n\\n      const budgetPath = getSessionBudgetPath(sessionsDir, sessionId);\\n      expect(budgetPath).toContain(\\\"sessions\\\");\\n      expect(budgetPath).toContain(sessionId);\\n      expect(budgetPath).toContain(\\\"budget.json\\\");\\n\\n      // File should exist\\n      const stat = await fs.stat(budgetPath);\\n      expect(stat.isFile()).toBe(true);\\n    });\\n\\n    it(\\\"should reject invalid max_per_cycle\\\", async () => {\\n      await expect(createBudget(sessionsDir, sessionId, 0)).rejects.toThrow();\\n      await expect(createBudget(sessionsDir, sessionId, -1)).rejects.toThrow();\\n    });\\n  });\\n\\n  describe(\\\"getBudget\\\", () => {\\n    // AC: @task-budget-enforcement ac-no-budget\\n    it(\\\"should return null when no budget configured\\\", async () => {\\n      const budget = await getBudget(sessionsDir, sessionId);\\n      expect(budget).toBeNull();\\n    });\\n\\n    it(\\\"should return budget after creation\\\", async () => {\\n      await createBudget(sessionsDir, sessionId, 5);\\n      const budget = await getBudget(sessionsDir, sessionId);\\n\\n      expect(budget).not.toBeNull();\\n      expect(budget!.max_per_cycle).toBe(5);\\n      expect(budget!.started_this_cycle).toBe(0);\\n    });\\n\\n    it(\\\"should return null for nonexistent session\\\", async () => {\\n      const budget = await getBudget(sessionsDir, \\\"NONEXISTENT\\\");\\n      expect(budget).toBeNull();\\n    });\\n\\n    it(\\\"should throw on corrupt budget.json (fail closed, not open)\\\", async () => {\\n      // Write invalid JSON to budget.json — should throw, not silently disable enforcement\\n      const budgetPath = getSessionBudgetPath(sessionsDir, sessionId);\\n      await fs.writeFile(budgetPath, \\\"not valid json{{{\\\", \\\"utf-8\\\");\\n\\n      await expect(getBudget(sessionsDir, sessionId)).rejects.toThrow();\\n    });\\n\\n    it(\\\"should throw on budget.json with invalid schema\\\", async () => {\\n      // Write valid JSON but wrong schema — should throw, not silently disable enforcement\\n      const budgetPath = getSessionBudgetPath(sessionsDir, sessionId);\\n      await fs.writeFile(budgetPath, JSON.stringify({ wrong: \\\"shape\\\" }), \\\"utf-8\\\");\\n\\n      await expect(getBudget(sessionsDir, sessionId)).rejects.toThrow();\\n    });\\n  });\\n\\n  describe(\\\"checkBudget\\\", () => {\\n    // AC: @task-budget-enforcement ac-no-session\\n    it(\\\"should allow when no session ID provided\\\", async () => {\\n      const result = await checkBudget(sessionsDir, undefined);\\n      expect(result.allowed).toBe(true);\\n      expect(result.budget).toBeUndefined();\\n    });\\n\\n    // AC: @task-budget-enforcement ac-no-budget\\n    it(\\\"should allow when session has no budget configured\\\", async () => {\\n      const result = await checkBudget(sessionsDir, sessionId);\\n      expect(result.allowed).toBe(true);\\n      expect(result.budget).toBeUndefined();\\n    });\\n\\n    it(\\\"should allow when under budget\\\", async () => {\\n      await createBudget(sessionsDir, sessionId, 3);\\n      const result = await checkBudget(sessionsDir, sessionId);\\n\\n      expect(result.allowed).toBe(true);\\n      expect(result.budget).toBeDefined();\\n      expect(result.budget!.started_this_cycle).toBe(0);\\n    });\\n\\n    // AC: @task-budget-enforcement ac-block-start\\n    it(\\\"should block when budget exhausted\\\", async () => {\\n      await createBudget(sessionsDir, sessionId, 1);\\n      await incrementBudget(sessionsDir, sessionId);\\n\\n      const result = await checkBudget(sessionsDir, sessionId);\\n      expect(result.allowed).toBe(false);\\n      expect(result.reason).toContain(\\\"1/1\\\");\\n      expect(result.reason).toContain(\\\"budget exhausted\\\");\\n      expect(result.budget).toBeDefined();\\n      expect(result.budget!.started_this_cycle).toBe(1);\\n    });\\n\\n    // AC: @task-budget-enforcement ac-block-start\\n    it(\\\"should include budget counts in rejection message\\\", async () => {\\n      await createBudget(sessionsDir, sessionId, 2);\\n      await incrementBudget(sessionsDir, sessionId);\\n      await incrementBudget(sessionsDir, sessionId);\\n\\n      const result = await checkBudget(sessionsDir, sessionId);\\n      expect(result.allowed).toBe(false);\\n      expect(result.reason).toContain(\\\"2/2\\\");\\n      expect(result.reason).toContain(\\\"Wrap up\\\");\\n    });\\n  });\\n\\n  describe(\\\"incrementBudget\\\", () => {\\n    // AC: @task-budget-enforcement ac-increment\\n    it(\\\"should increment started_this_cycle by 1\\\", async () => {\\n      await createBudget(sessionsDir, sessionId, 5);\\n\\n      const updated = await incrementBudget(sessionsDir, sessionId);\\n      expect(updated).not.toBeNull();\\n      expect(updated!.started_this_cycle).toBe(1);\\n      expect(updated!.max_per_cycle).toBe(5);\\n\\n      // Verify persisted\\n      const read = await getBudget(sessionsDir, sessionId);\\n      expect(read!.started_this_cycle).toBe(1);\\n    });\\n\\n    it(\\\"should increment multiple times\\\", async () => {\\n      await createBudget(sessionsDir, sessionId, 5);\\n\\n      await incrementBudget(sessionsDir, sessionId);\\n      await incrementBudget(sessionsDir, sessionId);\\n      const updated = await incrementBudget(sessionsDir, sessionId);\\n\\n      expect(updated!.started_this_cycle).toBe(3);\\n    });\\n\\n    it(\\\"should return null when no budget configured\\\", async () => {\\n      const result = await incrementBudget(sessionsDir, sessionId);\\n      expect(result).toBeNull();\\n    });\\n\\n    // AC: @task-budget-enforcement ac-atomic-write\\n    it(\\\"should write atomically (no temp files left behind)\\\", async () => {\\n      await createBudget(sessionsDir, sessionId, 3);\\n      await incrementBudget(sessionsDir, sessionId);\\n\\n      // Check that no .tmp files remain in session dir\\n      const sessionDir = path.join(sessionsDir, sessionId);\\n      const files = await fs.readdir(sessionDir);\\n      const tmpFiles = files.filter((f) => f.endsWith(\\\".tmp\\\"));\\n      expect(tmpFiles).toHaveLength(0);\\n    });\\n  });\\n\\n  describe(\\\"resetBudget\\\", () => {\\n    // AC: @task-budget-enforcement ac-reset\\n    it(\\\"should reset started_this_cycle to 0\\\", async () => {\\n      await createBudget(sessionsDir, sessionId, 3);\\n      await incrementBudget(sessionsDir, sessionId);\\n      await incrementBudget(sessionsDir, sessionId);\\n\\n      const reset = await resetBudget(sessionsDir, sessionId);\\n      expect(reset).not.toBeNull();\\n      expect(reset!.started_this_cycle).toBe(0);\\n      expect(reset!.max_per_cycle).toBe(3);\\n\\n      // Verify persisted\\n      const read = await getBudget(sessionsDir, sessionId);\\n      expect(read!.started_this_cycle).toBe(0);\\n    });\\n\\n    it(\\\"should return null when no budget configured\\\", async () => {\\n      const result = await resetBudget(sessionsDir, sessionId);\\n      expect(result).toBeNull();\\n    });\\n\\n    it(\\\"should preserve max_per_cycle after reset\\\", async () => {\\n      await createBudget(sessionsDir, sessionId, 7);\\n      await incrementBudget(sessionsDir, sessionId);\\n      await resetBudget(sessionsDir, sessionId);\\n\\n      const budget = await getBudget(sessionsDir, sessionId);\\n      expect(budget!.max_per_cycle).toBe(7);\\n      expect(budget!.started_this_cycle).toBe(0);\\n    });\\n\\n    // AC: @task-budget-enforcement ac-atomic-write\\n    it(\\\"should write atomically (no temp files left behind)\\\", async () => {\\n      await createBudget(sessionsDir, sessionId, 3);\\n      await incrementBudget(sessionsDir, sessionId);\\n      await resetBudget(sessionsDir, sessionId);\\n\\n      const sessionDir = path.join(sessionsDir, sessionId);\\n      const files = await fs.readdir(sessionDir);\\n      const tmpFiles = files.filter((f) => f.endsWith(\\\".tmp\\\"));\\n      expect(tmpFiles).toHaveLength(0);\\n    });\\n  });\\n\\n  describe(\\\"full lifecycle\\\", () => {\\n    it(\\\"should support create \\\\u2192 increment \\\\u2192 check \\\\u2192 reset \\\\u2192 check cycle\\\", async () => {\\n      // Create budget allowing 1 task per cycle\\n      await createBudget(sessionsDir, sessionId, 1);\\n\\n      // Check: should be allowed (0/1)\\n      let check = await checkBudget(sessionsDir, sessionId);\\n      expect(check.allowed).toBe(true);\\n\\n      // Increment after starting a task\\n      await incrementBudget(sessionsDir, sessionId);\\n\\n      // Check: should be blocked (1/1)\\n      check = await checkBudget(sessionsDir, sessionId);\\n      expect(check.allowed).toBe(false);\\n\\n      // Reset at iteration boundary\\n      await resetBudget(sessionsDir, sessionId);\\n\\n      // Check: should be allowed again (0/1)\\n      check = await checkBudget(sessionsDir, sessionId);\\n      expect(check.allowed).toBe(true);\\n    });\\n  });\\n});\\n\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":1,\"cache_creation_input_tokens\":5373,\"cache_read_input_tokens\":127155,\"cache_creation\":{\"ephemeral_5m_input_tokens\":5373,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"}},\"requestId\":\"req_011CYrdwdPjB8PgrtnQcWFuV\",\"type\":\"assistant\",\"uuid\":\"2592f47e-79f9-458a-9c06-0f884103336b\",\"timestamp\":\"2026-03-09T01:28:35.281Z\"}\n{\"parentUuid\":\"2592f47e-79f9-458a-9c06-0f884103336b\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a223826\",\"slug\":\"stateful-singing-dongarra\",\"type\":\"progress\",\"data\":{\"type\":\"hook_progress\",\"hookEvent\":\"PostToolUse\",\"hookName\":\"PostToolUse:Write\",\"command\":\"callback\"},\"parentToolUseID\":\"toolu_01E3DD4C7WYsyJPtyKp5gE2B\",\"toolUseID\":\"toolu_01E3DD4C7WYsyJPtyKp5gE2B\",\"timestamp\":\"2026-03-09T01:28:35.285Z\",\"uuid\":\"a1056f71-62c0-4ece-b252-02c8bc1feada\"}\n{\"parentUuid\":\"a1056f71-62c0-4ece-b252-02c8bc1feada\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynetic-spec\",\"sessionId\":\"4324a32c-1cc9-44af-9744-9ff1eb5152cc\",\"version\":\"2.1.45\",\"gitBranch\":\"feat/extract-session-path-resolution-v2\",\"agentId\":\"a223826\",\"slug\":\"stateful-singing-dongarra\",\"type\":\"progress\",\"data\":{\"type\":\"hook_progress\",\"hookEvent\":\"PostToolUse\",\"hookName\":\"PostToolUse:Write\",\"command\":\"callback\"},\"parentToolUseID\":\"toolu_01E3DD4C7WYsyJPtyKp5gE2B\",\"toolUseID\":\"toolu_01E3DD4C7WYsyJPtyKp5gE2B\",\"timestamp\":\"2026-03-09T01:28:35.285Z\",\"uuid\":\"b8e1d105-6269-49b2-b523-b8db0c3ae407\"}\n{\"parentUuid\":\"2592f47e-79f9-458a-9c06-0f884103336b\",\"isSidechain\":true,\"userType\":\"external\",\"cwd\":\"/home/chapel/Projects/kynet