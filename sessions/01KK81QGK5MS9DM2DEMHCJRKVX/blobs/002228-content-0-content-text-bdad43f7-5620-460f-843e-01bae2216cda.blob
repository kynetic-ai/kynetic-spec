     1→/**
     2→ * Session log list tests.
     3→ *
     4→ * Tests for the `kspec session log list` command and supporting store functions.
     5→ */
     6→
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import * as fs from 'node:fs/promises';
     9→import * as os from 'node:os';
    10→import * as path from 'node:path';
    11→import * as YAML from 'yaml';
    12→import {
    13→  createSession,
    14→  appendEvent,
    15→  saveSessionContext,
    16→  getSessionLogSummary,
    17→  getAllSessionLogSummaries,
    18→  type SessionLogSummary,
    19→} from '../src/sessions/store.js';
    20→import type { SessionMetadataInput, SessionEventInput } from '../src/sessions/types.js';
    21→import {
    22→  setupTempFixtures,
    23→  cleanupTempDir,
    24→  kspec,
    25→  kspecJson,
    26→  testUlid,
    27→} from './helpers/cli';
    28→
    29→// ─── Store Unit Tests ───────────────────────────────────────────────────────
    30→
    31→describe('getSessionLogSummary', () => {
    32→  let testDir: string;
    33→
    34→  beforeEach(async () => {
    35→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-log-'));
    36→  });
    37→
    38→  afterEach(async () => {
    39→    await fs.rm(testDir, { recursive: true });
    40→  });
    41→
    42→  it('should return null for nonexistent session', async () => {
    43→    const summary = await getSessionLogSummary(testDir, 'nonexistent');
    44→    expect(summary).toBeNull();
    45→  });
    46→
    47→  // AC: @session-log-list ac-1
    48→  it('should return summary with all expected fields', async () => {
    49→    const sessionId = testUlid('SESS');
    50→    const startedAt = '2026-01-20T10:00:00.000Z';
    51→    const endedAt = '2026-01-20T11:30:00.000Z';
    52→
    53→    await createSession(testDir, {
    54→      id: sessionId,
    55→      agent_type: 'claude-agent-acp',
    56→      started_at: startedAt,
    57→    });
    58→
    59→    // Simulate completion by writing metadata directly
    60→    const metaPath = path.join(testDir, 'sessions', sessionId, 'session.yaml');
    61→    await fs.writeFile(metaPath, YAML.stringify({
    62→      id: sessionId,
    63→      agent_type: 'claude-agent-acp',
    64→      status: 'completed',
    65→      started_at: startedAt,
    66→      ended_at: endedAt,
    67→    }));
    68→
    69→    // Add some events
    70→    for (let i = 0; i < 5; i++) {
    71→      await appendEvent(testDir, {
    72→        type: i === 0 ? 'session.start' : 'prompt.sent',
    73→        session_id: sessionId,
    74→        data: null,
    75→      });
    76→    }
    77→
    78→    // Add context snapshots
    79→    await saveSessionContext(testDir, sessionId, 1, { iteration: 1 });
    80→    await saveSessionContext(testDir, sessionId, 2, { iteration: 2 });
    81→
    82→    const summary = await getSessionLogSummary(testDir, sessionId);
    83→    expect(summary).not.toBeNull();
    84→    expect(summary!.id).toBe(sessionId);
    85→    expect(summary!.status).toBe('completed');
    86→    expect(summary!.agent_type).toBe('claude-agent-acp');
    87→    expect(summary!.started_at).toBe(startedAt);
    88→    expect(summary!.ended_at).toBe(endedAt);
    89→    expect(summary!.duration_ms).toBe(5400000); // 1.5 hours
    90→    expect(summary!.event_count).toBe(5);
    91→    expect(summary!.iteration_count).toBe(2);
    92→    expect(summary!.tasks_completed).toBe(0);
    93→  });
    94→
    95→  // AC: @ui-session-history ac-1 — task_id included in summary
    96→  it('should include task_id in summary when session has a task', async () => {
    97→    const sessionId = testUlid('SESS', 5);
    98→    const taskId = testUlid('TASK');
    99→    await createSession(testDir, {
   100→      id: sessionId,
   101→      agent_type: 'claude-agent-acp',
   102→      task_id: taskId,
   103→    });
   104→
   105→    const summary = await getSessionLogSummary(testDir, sessionId);
   106→    expect(summary).not.toBeNull();
   107→    expect(summary!.task_id).toBe(taskId);
   108→  });
   109→
   110→  // AC: @ui-session-history ac-1 — task_id undefined when session has no task
   111→  it('should have undefined task_id when session has no task', async () => {
   112→    const sessionId = testUlid('SESS', 6);
   113→    await createSession(testDir, {
   114→      id: sessionId,
   115→      agent_type: 'test-agent',
   116→    });
   117→
   118→    const summary = await getSessionLogSummary(testDir, sessionId);
   119→    expect(summary).not.toBeNull();
   120→    expect(summary!.task_id).toBeUndefined();
   121→  });
   122→
   123→  it('should compute duration from now for active sessions', async () => {
   124→    const sessionId = testUlid('SESS', 1);
   125→    await createSession(testDir, {
   126→      id: sessionId,
   127→      agent_type: 'test-agent',
   128→    });
   129→
   130→    const summary = await getSessionLogSummary(testDir, sessionId);
   131→    expect(summary).not.toBeNull();
   132→    expect(summary!.status).toBe('active');
   133→    expect(summary!.duration_ms).toBeGreaterThan(0);
   134→    expect(summary!.ended_at).toBeUndefined();
   135→  });
   136→
   137→  it('should count task completions from realistic tool_call events', async () => {
   138→    const sessionId = testUlid('SESS', 2);
   139→    await createSession(testDir, {
   140→      id: sessionId,
   141→      agent_type: 'claude-agent-acp',
   142→    });
   143→
   144→    // Append events including realistic task complete tool calls
   145→    await appendEvent(testDir, {
   146→      type: 'session.start',
   147→      session_id: sessionId,
   148→      data: null,
   149→    });
   150→    // Write realistic session.update events with tool_call shape
   151→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   152→    const toolCallEvent1 = JSON.stringify({
   153→      ts: Date.now(),
   154→      seq: 1,
   155→      type: 'session.update',
   156→      session_id: sessionId,
   157→      data: {
   158→        iteration: 1,
   159→        update: {
   160→          _meta: { claudeCode: { toolName: 'Bash' } },
   161→          sessionUpdate: 'tool_call',
   162→          rawInput: { command: 'kspec task complete @my-task --reason "Done"' },
   163→        },
   164→      },
   165→    });
   166→    await fs.appendFile(eventsPath, toolCallEvent1 + '\n');
   167→    const toolCallEvent2 = JSON.stringify({
   168→      ts: Date.now(),
   169→      seq: 2,
   170→      type: 'session.update',
   171→      session_id: sessionId,
   172→      data: {
   173→        iteration: 1,
   174→        update: {
   175→          _meta: { claudeCode: { toolName: 'Bash' } },
   176→          sessionUpdate: 'tool_call',
   177→          rawInput: { command: 'npm run dev -- task complete @another-task --reason "All done"' },
   178→        },
   179→      },
   180→    });
   181→    await fs.appendFile(eventsPath, toolCallEvent2 + '\n');
   182→
   183→    const summary = await getSessionLogSummary(testDir, sessionId);
   184→    expect(summary!.tasks_completed).toBe(2);
   185→    expect(summary!.event_count).toBe(3); // session.start + 2 tool_call updates
   186→  });
   187→
   188→  // AC: @session-log-list ac-1 (claude-agent-acp: commands in tool_call_update events)
   189→  it('should count task completions from tool_call_update events (claude-agent-acp format)', async () => {
   190→    const sessionId = testUlid('SESS', 3);
   191→    await createSession(testDir, { id: sessionId, agent_type: 'claude-agent-acp' });
   192→
   193→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   194→    // claude-agent-acp: initial tool_call has empty rawInput, command arrives in tool_call_update
   195→    const emptyToolCall = JSON.stringify({
   196→      ts: Date.now(), seq: 1, type: 'session.update', session_id: sessionId,
   197→      data: { update: { sessionUpdate: 'tool_call', rawInput: {}, toolCallId: 'tc-1' } },
   198→    });
   199→    await fs.appendFile(eventsPath, emptyToolCall + '\n');
   200→    const populatedUpdate = JSON.stringify({
   201→      ts: Date.now(), seq: 2, type: 'session.update', session_id: sessionId,
   202→      data: { update: { sessionUpdate: 'tool_call_update', rawInput: { command: 'kspec task complete @my-task --reason "Done"', description: 'Complete task' }, toolCallId: 'tc-1' } },
   203→    });
   204→    await fs.appendFile(eventsPath, populatedUpdate + '\n');
   205→
   206→    const summary = await getSessionLogSummary(testDir, sessionId);
   207→    expect(summary!.tasks_completed).toBe(1);
   208→  });
   209→
   210→  // AC: @session-log-list ac-1 (codex-acp: command is array in tool_call events)
   211→  it('should count task completions from array commands (codex-acp format)', async () => {
   212→    const sessionId = testUlid('SESS', 4);
   213→    await createSession(testDir, { id: sessionId, agent_type: 'codex-acp' });
   214→
   215→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   216→    // codex-acp: command is ['/usr/bin/bash', '-lc', 'kspec task complete @ref']
   217→    const arrayCommandEvent = JSON.stringify({
   218→      ts: Date.now(), seq: 1, type: 'session.update', session_id: sessionId,
   219→      data: { update: { sessionUpdate: 'tool_call', rawInput: { command: ['/usr/bin/bash', '-lc', 'kspec task complete @my-task'] } } },
   220→    });
   221→    await fs.appendFile(eventsPath, arrayCommandEvent + '\n');
   222→
   223→    const summary = await getSessionLogSummary(testDir, sessionId);
   224→    expect(summary!.tasks_completed).toBe(1);
   225→  });
   226→});
   227→
   228→describe('getAllSessionLogSummaries', () => {
   229→  let testDir: string;
   230→
   231→  beforeEach(async () => {
   232→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-log-all-'));
   233→  });
   234→
   235→  afterEach(async () => {
   236→    await fs.rm(testDir, { recursive: true });
   237→  });
   238→
   239→  // AC: @session-log-list ac-6
   240→  it('should return empty array when no sessions exist', async () => {
   241→    const summaries = await getAllSessionLogSummaries(testDir);
   242→    expect(summaries).toEqual([]);
   243→  });
   244→
   245→  it('should return summaries for all sessions', async () => {
   246→    const id1 = testUlid('SESS', 1);
   247→    const id2 = testUlid('SESS', 2);
   248→
   249→    await createSession(testDir, { id: id1, agent_type: 'agent-a' });
   250→    await createSession(testDir, { id: id2, agent_type: 'agent-b' });
   251→
   252→    const summaries = await getAllSessionLogSummaries(testDir);
   253→    expect(summaries).toHaveLength(2);
   254→    expect(summaries.map(s => s.id).sort()).toEqual([id1, id2].sort());
   255→  });
   256→});
   257→
   258→// ─── CLI Integration Tests ──────────────────────────────────────────────────
   259→
   260→describe('kspec session log list (CLI)', () => {
   261→  let tempDir: string;
   262→
   263→  beforeEach(async () => {
   264→    tempDir = await setupTempFixtures();
   265→
   266→    // In traditional mode (no shadow branch), specDir = tempDir
   267→    // Sessions go in tempDir/sessions/
   268→    const sessionsDir = path.join(tempDir, 'sessions');
   269→    await fs.mkdir(sessionsDir, { recursive: true });
   270→
   271→    // Session 1: completed, old
   272→    const s1 = testUlid('SESS', 1);
   273→    const s1Dir = path.join(sessionsDir, s1);
   274→    await fs.mkdir(s1Dir);
   275→    await fs.writeFile(path.join(s1Dir, 'session.yaml'), YAML.stringify({
   276→      id: s1,
   277→      agent_type: 'claude-agent-acp',
   278→      status: 'completed',
   279→      started_at: '2026-01-15T10:00:00.000Z',
   280→      ended_at: '2026-01-15T11:30:00.000Z',
   281→    }));
   282→    await fs.writeFile(path.join(s1Dir, 'events.jsonl'), [
   283→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s1, data: null }),
   284→      JSON.stringify({ ts: 2000, seq: 1, type: 'prompt.sent', session_id: s1, data: null }),
   285→      JSON.stringify({ ts: 3000, seq: 2, type: 'session.end', session_id: s1, data: null }),
   286→    ].join('\n') + '\n');
   287→    await fs.writeFile(path.join(s1Dir, 'context-iter-1.json'), '{}');
   288→
   289→    // Session 2: active, recent
   290→    const s2 = testUlid('SESS', 2);
   291→    const s2Dir = path.join(sessionsDir, s2);
   292→    await fs.mkdir(s2Dir);
   293→    await fs.writeFile(path.join(s2Dir, 'session.yaml'), YAML.stringify({
   294→      id: s2,
   295→      agent_type: 'custom-agent',
   296→      status: 'active',
   297→      started_at: '2026-02-05T08:00:00.000Z',
   298→    }));
   299→    await fs.writeFile(path.join(s2Dir, 'events.jsonl'), [
   300→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s2, data: null }),
   301→      JSON.stringify({ ts: 2000, seq: 1, type: 'prompt.sent', session_id: s2, data: null }),
   302→      JSON.stringify({ ts: 3000, seq: 2, type: 'prompt.sent', session_id: s2, data: null }),
   303→      JSON.stringify({ ts: 4000, seq: 3, type: 'prompt.sent', session_id: s2, data: null }),
   304→      JSON.stringify({ ts: 5000, seq: 4, type: 'prompt.sent', session_id: s2, data: null }),
   305→    ].join('\n') + '\n');
   306→    await fs.writeFile(path.join(s2Dir, 'context-iter-1.json'), '{}');
   307→    await fs.writeFile(path.join(s2Dir, 'context-iter-2.json'), '{}');
   308→    await fs.writeFile(path.join(s2Dir, 'context-iter-3.json'), '{}');
   309→
   310→    // Session 3: completed, recent
   311→    const s3 = testUlid('SESS', 3);
   312→    const s3Dir = path.join(sessionsDir, s3);
   313→    await fs.mkdir(s3Dir);
   314→    await fs.writeFile(path.join(s3Dir, 'session.yaml'), YAML.stringify({
   315→      id: s3,
   316→      agent_type: 'claude-agent-acp',
   317→      status: 'completed',
   318→      started_at: '2026-02-04T14:00:00.000Z',
   319→      ended_at: '2026-02-04T15:00:00.000Z',
   320→    }));
   321→    await fs.writeFile(path.join(s3Dir, 'events.jsonl'), [
   322→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s3, data: null }),
   323→      JSON.stringify({
   324→        ts: 2000, seq: 1, type: 'session.update', session_id: s3,
   325→        data: {
   326→          iteration: 1,
   327→          update: {
   328→            _meta: { claudeCode: { toolName: 'Bash' } },
   329→            sessionUpdate: 'tool_call',
   330→            rawInput: { command: 'kspec task complete @task-1 --reason "Done"' },
   331→          },
   332→        },
   333→      }),
   334→    ].join('\n') + '\n');
   335→  });
   336→
   337→  afterEach(async () => {
   338→    await cleanupTempDir(tempDir);
   339→  });
   340→
   341→  // AC: @session-log-list ac-1
   342→  it('should display sessions in table format', () => {
   343→    const result = kspec('session log list', tempDir);
   344→    expect(result.exitCode).toBe(0);
   345→    expect(result.stdout).toContain('ID');
   346→    expect(result.stdout).toContain('Status');
   347→    expect(result.stdout).toContain('Agent');
   348→    expect(result.stdout).toContain('Started');
   349→    expect(result.stdout).toContain('Duration');
   350→    expect(result.stdout).toContain('Events');
   351→    expect(result.stdout).toContain('Iters');
   352→    expect(result.stdout).toContain('Tasks');
   353→    expect(result.stdout).toContain('3 session(s)');
   354→  });
   355→
   356→  // AC: @session-log-list ac-1 (JSON variant)
   357→  it('should output valid JSON with all fields in --json mode', () => {
   358→    const sessions = kspecJson<SessionLogSummary[]>('session log list', tempDir);
   359→    expect(sessions).toHaveLength(3);
   360→
   361→    for (const session of sessions) {
   362→      expect(session).toHaveProperty('id');
   363→      expect(session).toHaveProperty('status');
   364→      expect(session).toHaveProperty('agent_type');
   365→      expect(session).toHaveProperty('started_at');
   366→      expect(session).toHaveProperty('duration_ms');
   367→      expect(session).toHaveProperty('event_count');
   368→      expect(session).toHaveProperty('iteration_count');
   369→      expect(session).toHaveProperty('tasks_completed');
   370→    }
   371→  });
   372→
   373→  // AC: @session-log-list ac-2
   374→  it('should filter by --status', () => {
   375→    const sessions = kspecJson<SessionLogSummary[]>('session log list --status completed', tempDir);
   376→    expect(sessions).toHaveLength(2);
   377→    for (const s of sessions) {
   378→      expect(s.status).toBe('completed');
   379→    }
   380→  });
   381→
   382→  // AC: @session-log-list ac-2
   383→  it('should filter by --status active', () => {
   384→    const sessions = kspecJson<SessionLogSummary[]>('session log list --status active', tempDir);
   385→    expect(sessions).toHaveLength(1);
   386→    expect(sessions[0].status).toBe('active');
   387→    expect(sessions[0].agent_type).toBe('custom-agent');
   388→  });
   389→
   390→  // AC: @session-log-list ac-3
   391→  it('should filter by --since', () => {
   392→    const sessions = kspecJson<SessionLogSummary[]>('session log list --since 2026-02-01', tempDir);
   393→    // Only sessions 2 and 3 are after Feb 1
   394→    expect(sessions).toHaveLength(2);
   395→    for (const s of sessions) {
   396→      expect(new Date(s.started_at).getTime()).toBeGreaterThanOrEqual(new Date('2026-02-01').getTime());
   397→    }
   398→  });
   399→
   400→  // AC: @session-log-list ac-4
   401→  it('should filter by --agent', () => {
   402→    const sessions = kspecJson<SessionLogSummary[]>('session log list --agent custom-agent', tempDir);
   403→    expect(sessions).toHaveLength(1);
   404→    expect(sessions[0].agent_type).toBe('custom-agent');
   405→  });
   406→
   407→  // AC: @session-log-list ac-4
   408→  it('should filter by --agent for claude-agent-acp', () => {
   409→    const sessions = kspecJson<SessionLogSummary[]>('session log list --agent claude-agent-acp', tempDir);
   410→    expect(sessions).toHaveLength(2);
   411→    for (const s of sessions) {
   412→      expect(s.agent_type).toBe('claude-agent-acp');
   413→    }
   414→  });
   415→
   416→  // AC: @session-log-list ac-5
   417→  it('should sort by started_at descending by default', () => {
   418→    const sessions = kspecJson<SessionLogSummary[]>('session log list', tempDir);
   419→    expect(sessions).toHaveLength(3);
   420→    // Most recent first
   421→    for (let i = 1; i < sessions.length; i++) {
   422→      expect(new Date(sessions[i - 1].started_at).getTime())
   423→        .toBeGreaterThanOrEqual(new Date(sessions[i].started_at).getTime());
   424→    }
   425→  });
   426→
   427→  // AC: @session-log-list ac-5
   428→  it('should sort by events when --sort events is provided', () => {
   429→    const sessions = kspecJson<SessionLogSummary[]>('session log list --sort events', tempDir);
   430→    // Highest event count first
   431→    for (let i = 1; i < sessions.length; i++) {
   432→      expect(sessions[i - 1].event_count).toBeGreaterThanOrEqual(sessions[i].event_count);
   433→    }
   434→  });
   435→
   436→  // AC: @session-log-list ac-5
   437→  it('should sort by iterations when --sort iterations is provided', () => {
   438→    const sessions = kspecJson<SessionLogSummary[]>('session log list --sort iterations', tempDir);
   439→    for (let i = 1; i < sessions.length; i++) {
   440→      expect(sessions[i - 1].iteration_count).toBeGreaterThanOrEqual(sessions[i].iteration_count);
   441→    }
   442→  });
   443→
   444→  // AC: @session-log-list ac-6
   445→  it('should show "No sessions found" when no sessions exist', async () => {
   446→    // Remove all sessions
   447→    const sessionsDir = path.join(tempDir, 'sessions');
   448→    await fs.rm(sessionsDir, { recursive: true });
   449→    await fs.mkdir(sessionsDir);
   450→
   451→    const result = kspec('session log list', tempDir);
   452→    expect(result.exitCode).toBe(0);
   453→    expect(result.stdout).toContain('No sessions found');
   454→  });
   455→
   456→  // AC: @session-log-list ac-6 (JSON variant)
   457→  it('should return empty array in JSON mode when no sessions exist', async () => {
   458→    const sessionsDir = path.join(tempDir, 'sessions');
   459→    await fs.rm(sessionsDir, { recursive: true });
   460→    await fs.mkdir(sessionsDir);
   461→
   462→    const sessions = kspecJson<SessionLogSummary[]>('session log list', tempDir);
   463→    expect(sessions).toEqual([]);
   464→  });
   465→
   466→  // AC: @session-log-list ac-7
   467→  it('should limit output with --count flag (shows count only)', () => {
   468→    const result = kspec('session log list --count', tempDir);
   469→    expect(result.exitCode).toBe(0);
   470→    expect(result.stdout).toBe('3');
   471→  });
   472→
   473→  // AC: @session-log-list ac-7 (JSON --count)
   474→  it('should return count in JSON mode with --count', () => {
   475→    const data = kspecJson<{ count: number }>('session log list --count', tempDir);
   476→    expect(data.count).toBe(3);
   477→  });
   478→
   479→  // AC: @session-log-list ac-7 (--count with filters)
   480→  it('should respect filters with --count', () => {
   481→    const data = kspecJson<{ count: number }>('session log list --count --status completed', tempDir);
   482→    expect(data.count).toBe(2);
   483→  });
   484→
   485→  // --limit flag
   486→  it('should limit number of sessions with -n flag', () => {
   487→    const sessions = kspecJson<SessionLogSummary[]>('session log list -n 2', tempDir);
   488→    expect(sessions).toHaveLength(2);
   489→  });
   490→
   491→  // Combined filters
   492→  it('should combine --status and --agent filters', () => {
   493→    const sessions = kspecJson<SessionLogSummary[]>(
   494→      'session log list --status active --agent custom-agent',
   495→      tempDir,
   496→    );
   497→    expect(sessions).toHaveLength(1);
   498→    expect(sessions[0].status).toBe('active');
   499→    expect(sessions[0].agent_type).toBe('custom-agent');
   500→  });
   501→
   502→  // Task completion counting
   503→  it('should count task completions', () => {
   504→    const sessions = kspecJson<SessionLogSummary[]>('session log list --status completed', tempDir);
