   368→// ─── AC-7: Session log show renders agent.* events ───────────────────────────
   369→
   370→// AC: @session-model-evolution ac-7
   371→describe("kspec session log show agent.* event rendering (CLI)", () => {
   372→  let tempDir: string;
   373→  const sessionId = testUlid("SESS");
   374→
   375→  beforeEach(async () => {
   376→    tempDir = await setupTempFixtures();
   377→
   378→    const sessionsDir = path.join(tempDir, "sessions");
   379→    await fs.mkdir(sessionsDir, { recursive: true });
   380→
   381→    const sDir = path.join(sessionsDir, sessionId);
   382→    await fs.mkdir(sDir);
   383→    await fs.writeFile(path.join(sDir, "session.yaml"), YAML.stringify({
   384→      id: sessionId,
   385→      agent_type: "claude-agent-acp",
   386→      agent_id: "@agent-worker",
   387→      trigger: "task.ready",
   388→      task_id: "@my-task",
   389→      status: "completed",
   390→      started_at: "2026-02-10T10:00:00.000Z",
   391→      ended_at: "2026-02-10T11:00:00.000Z",
   392→    }));
   393→
   394→    // Write events including agent.* types
   395→    const events = [
   396→      JSON.stringify({ ts: 1000, seq: 0, type: "agent.dispatched", session_id: sessionId, data: { task_id: "@my-task" } }),
   397→      JSON.stringify({ ts: 2000, seq: 1, type: "agent.started", session_id: sessionId, data: { task_id: "@my-task" } }),
   398→      JSON.stringify({ ts: 5000, seq: 2, type: "agent.completed", session_id: sessionId, data: { task_id: "@my-task", outcome: "success", duration_ms: 3000 } }),
   399→    ];
   400→    await fs.writeFile(path.join(sDir, "events.jsonl"), events.join("\n") + "\n");
   401→  });
   402→
   403→  afterEach(async () => {
   404→    await cleanupTempDir(tempDir);
   405→  });
   406→
   407→  it("should display session type in show output", () => {
   408→    const result = kspec(`session log show ${sessionId}`, tempDir);
   409→    expect(result.exitCode).toBe(0);
   410→    expect(result.stdout).toContain("Type:");
   411→    expect(result.stdout).toContain("invocation");
   412→  });
   413→
   414→  it("should include session_type in JSON output", () => {
   415→    const detail = kspecJson<SessionLogDetail>(`session log show ${sessionId}`, tempDir);
   416→    expect(detail.session_type).toBe("invocation");
   417→  });
   418→
   419→  it("should render agent.* events in event timeline", () => {
   420→    const result = kspec(`session log show ${sessionId} --events`, tempDir);
   421→    expect(result.exitCode).toBe(0);
   422→    expect(result.stdout).toContain("agent.dispatched");
   423→    expect(result.stdout).toContain("agent.started");
   424→    expect(result.stdout).toContain("agent.completed");
   425→  });
   426→
   427→  it("should include agent.* events in JSON output with --events", () => {
   428→    const detail = kspecJson<SessionLogDetail & { events?: Array<{ type: string; data: Record<string, unknown> }> }>(
   429→      `session log show ${sessionId} --events`,
   430→      tempDir,
   431→    );
   432→    expect(detail.events).toBeDefined();
   433→    expect(detail.events!.length).toBe(3);
   434→
   435→    const dispatched = detail.events!.find((e) => e.type === "agent.dispatched");
   436→    const started = detail.events!.find((e) => e.type === "agent.started");
   437→    const completed = detail.events!.find((e) => e.type === "agent.completed");
   438→
   439→    expect(dispatched).toBeDefined();
   440→    expect(started).toBeDefined();
   441→    expect(completed).toBeDefined();
   442→
   443→    // AC: @session-model-evolution ac-5 — agent.completed has task_id, outcome, duration_ms
   444→    expect(completed!.data.task_id).toBe("@my-task");
   445→    expect(completed!.data.outcome).toBe("success");
   446→    expect(completed!.data.duration_ms).toBe(3000);
   447→  });
   448→
   449→  it("should show human-readable summary for agent.* events", () => {
   450→    const result = kspec(`session log show ${sessionId} --events`, tempDir);
   451→    expect(result.exitCode).toBe(0);
   452→    // agent.dispatched shows "Dispatched for @my-task"
   453→    expect(result.stdout).toContain("Dispatched for @my-task");
   454→    // agent.started shows "Started work on @my-task"
   455→    expect(result.stdout).toContain("Started work on @my-task");
   456→    // agent.completed shows task_id, outcome, duration
   457→    expect(result.stdout).toContain("@my-task");
   458→    expect(result.stdout).toContain("success");
   459→  });
   460→});
