   103→// ─── AC-1: SessionMetadata with trigger and agent_id ─────────────────────────
   104→
   105→// AC: @session-model-evolution ac-1
   106→describe("SessionMetadata trigger and agent_id fields", () => {
   107→  let testDir: string;
   108→
   109→  beforeEach(async () => {
   110→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-session-model-"));
   111→  });
   112→
   113→  afterEach(async () => {
   114→    await fs.rm(testDir, { recursive: true });
   115→  });
   116→
   117→  it("should accept trigger and agent_id in session metadata", async () => {
   118→    const sessionId = testUlid("SESS");
   119→    await createSession(testDir, {
   120→      id: sessionId,
   121→      agent_type: "claude-agent-acp",
   122→      agent_id: "@agent-worker",
   123→      trigger: "task.ready",
   124→      task_id: "@my-task",
   125→    });
   126→
   127→    // Read back to verify persistence
   128→    const loaded = await getSession(testDir, sessionId);
   129→    expect(loaded).not.toBeNull();
   130→    expect(loaded!.agent_id).toBe("@agent-worker");
   131→    expect(loaded!.trigger).toBe("task.ready");
   132→    expect(loaded!.task_id).toBe("@my-task");
   133→  });
   134→
   135→  it("should accept all trigger enum values", () => {
   136→    const triggers = [
   137→      "manual",
   138→      "task.in_progress",
   139→      "task.ready",
   140→      "task.needs_work",
   141→      "task.pending_review",
   142→      "legacy",
   143→    ];
   144→    for (const trigger of triggers) {
   145→      const result = SessionMetadataSchema.safeParse({
   146→        id: "01SESS00000000000000000001",
   147→        agent_type: "test-agent",
   148→        trigger,
   149→        status: "active",
   150→        started_at: "2026-01-01T00:00:00.000Z",
   151→      });
   152→      expect(result.success).toBe(true);
   153→    }
   154→  });
   155→});
   156→
   157→// ─── AC-2: Backward compatibility for legacy sessions ─────────────────────────
   158→
   159→// AC: @session-model-evolution ac-2
   160→describe("Legacy session backward compatibility", () => {
   161→  let testDir: string;
   162→
   163→  beforeEach(async () => {
   164→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-legacy-session-"));
   165→  });
   166→
   167→  afterEach(async () => {
   168→    await fs.rm(testDir, { recursive: true });
   169→  });
   170→
   171→  it("should parse legacy session without trigger or agent_id without error", async () => {
   172→    const sessionId = testUlid("SESS");
   173→    // Write a legacy session.yaml directly (old format, no trigger/agent_id)
   174→    const sessionDir = path.join(testDir, "sessions", sessionId);
   175→    await fs.mkdir(sessionDir, { recursive: true });
   176→    await fs.writeFile(path.join(sessionDir, "session.yaml"), YAML.stringify({
   177→      id: sessionId,
   178→      agent_type: "ralph",
   179→      status: "completed",
   180→      started_at: "2026-01-15T10:00:00.000Z",
   181→      ended_at: "2026-01-15T12:00:00.000Z",
   182→    }));
   183→
   184→    // Should parse without error
   185→    const loaded = await getSession(testDir, sessionId);
   186→    expect(loaded).not.toBeNull();
   187→    expect(loaded!.agent_type).toBe("ralph");
   188→    // AC: @session-model-evolution ac-2 — legacy defaults are materialized on read
   189→    expect(loaded!.trigger).toBe("legacy");
   190→    expect(loaded!.agent_id).toBe("ralph"); // defaults to agent_type value
   191→  });
   192→
   193→  it("should classify legacy session as loop type in summary", async () => {
   194→    const sessionId = testUlid("SESS");
   195→    const sessionDir = path.join(testDir, "sessions", sessionId);
   196→    await fs.mkdir(sessionDir, { recursive: true });
   197→    await fs.writeFile(path.join(sessionDir, "session.yaml"), YAML.stringify({
   198→      id: sessionId,
   199→      agent_type: "ralph",
   200→      status: "completed",
   201→      started_at: "2026-01-15T10:00:00.000Z",
   202→      ended_at: "2026-01-15T12:00:00.000Z",
   203→    }));
   204→    await fs.writeFile(path.join(sessionDir, "events.jsonl"), "");
   205→
   206→    const summary = await getSessionLogSummary(testDir, sessionId);
   207→    expect(summary).not.toBeNull();
   208→    // Legacy session (no trigger) should be classified as "loop"
   209→    expect(summary!.session_type).toBe("loop");
   210→  });
   211→
   212→  it("should classify session with trigger=legacy as loop type", async () => {
   213→    const sessionId = testUlid("SESS", 1);
   214→    const sessionDir = path.join(testDir, "sessions", sessionId);
   215→    await fs.mkdir(sessionDir, { recursive: true });
   216→    await fs.writeFile(path.join(sessionDir, "session.yaml"), YAML.stringify({
   217→      id: sessionId,
   218→      agent_type: "ralph",
   219→      trigger: "legacy",
   220→      status: "completed",
   221→      started_at: "2026-01-15T10:00:00.000Z",
   222→      ended_at: "2026-01-15T12:00:00.000Z",
   223→    }));
   224→    await fs.writeFile(path.join(sessionDir, "events.jsonl"), "");
   225→
   226→    const summary = await getSessionLogSummary(testDir, sessionId);
   227→    expect(summary).not.toBeNull();
   228→    expect(summary!.session_type).toBe("loop");
   229→  });
   230→});
