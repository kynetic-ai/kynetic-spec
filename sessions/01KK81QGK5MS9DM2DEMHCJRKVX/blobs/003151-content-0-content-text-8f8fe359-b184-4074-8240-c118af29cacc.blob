   232→// ─── AC-5: Structured agent.completed event ──────────────────────────────────
   233→
   234→// AC: @session-model-evolution ac-5
   235→describe("agent.completed event structure", () => {
   236→  let testDir: string;
   237→
   238→  beforeEach(async () => {
   239→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-agent-event-"));
   240→  });
   241→
   242→  afterEach(async () => {
   243→    await fs.rm(testDir, { recursive: true });
   244→  });
   245→
   246→  it("should append agent.completed event with task_id, outcome, and duration_ms", async () => {
   247→    const sessionId = testUlid("SESS");
   248→    await createSession(testDir, {
   249→      id: sessionId,
   250→      agent_type: "claude-agent-acp",
   251→    });
   252→
   253→    // Append structured agent.completed event
   254→    await appendEvent(testDir, {
   255→      type: "agent.completed",
   256→      session_id: sessionId,
   257→      data: {
   258→        task_id: "@my-task",
   259→        outcome: "success",
   260→        duration_ms: 45000,
   261→      },
   262→    });
   263→
   264→    // Read back events to verify
   265→    const eventsPath = path.join(testDir, "sessions", sessionId, "events.jsonl");
   266→    const content = await fs.readFile(eventsPath, "utf-8");
   267→    const lines = content.trim().split("\n").filter(Boolean);
   268→    expect(lines.length).toBe(1);
   269→
   270→    const event = JSON.parse(lines[0]);
   271→    expect(event.type).toBe("agent.completed");
   272→    expect(event.data.task_id).toBe("@my-task");
   273→    expect(event.data.outcome).toBe("success");
   274→    expect(event.data.duration_ms).toBe(45000);
   275→  });
   276→
   277→  it("should accept all outcome values for agent.completed", async () => {
   278→    const sessionId = testUlid("SESS", 1);
   279→    await createSession(testDir, {
   280→      id: sessionId,
   281→      agent_type: "claude-agent-acp",
   282→    });
   283→
   284→    for (const outcome of ["success", "blocked", "failed"]) {
   285→      await appendEvent(testDir, {
   286→        type: "agent.completed",
   287→        session_id: sessionId,
   288→        data: { task_id: "@task", outcome, duration_ms: 1000 },
   289→      });
   290→    }
   291→
   292→    const eventsPath = path.join(testDir, "sessions", sessionId, "events.jsonl");
   293→    const content = await fs.readFile(eventsPath, "utf-8");
   294→    const lines = content.trim().split("\n").filter(Boolean);
   295→    expect(lines.length).toBe(3);
   296→  });
   297→});
