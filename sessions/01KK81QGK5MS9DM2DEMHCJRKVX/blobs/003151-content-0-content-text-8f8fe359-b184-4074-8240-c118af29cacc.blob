   299→// ─── AC-6: Session log list shows session type ────────────────────────────────
   300→
   301→// AC: @session-model-evolution ac-6
   302→describe("kspec session log list session type display (CLI)", () => {
   303→  let tempDir: string;
   304→
   305→  beforeEach(async () => {
   306→    tempDir = await setupTempFixtures();
   307→
   308→    const sessionsDir = path.join(tempDir, "sessions");
   309→    await fs.mkdir(sessionsDir, { recursive: true });
   310→
   311→    // Legacy session (no trigger = loop type)
   312→    const s1 = testUlid("SESS", 1);
   313→    const s1Dir = path.join(sessionsDir, s1);
   314→    await fs.mkdir(s1Dir);
   315→    await fs.writeFile(path.join(s1Dir, "session.yaml"), YAML.stringify({
   316→      id: s1,
   317→      agent_type: "ralph",
   318→      status: "completed",
   319→      started_at: "2026-01-15T10:00:00.000Z",
   320→      ended_at: "2026-01-15T11:30:00.000Z",
   321→    }));
   322→    await fs.writeFile(path.join(s1Dir, "events.jsonl"), "");
   323→
   324→    // New invocation session (with trigger = task.ready)
   325→    const s2 = testUlid("SESS", 2);
   326→    const s2Dir = path.join(sessionsDir, s2);
   327→    await fs.mkdir(s2Dir);
   328→    await fs.writeFile(path.join(s2Dir, "session.yaml"), YAML.stringify({
   329→      id: s2,
   330→      agent_type: "claude-agent-acp",
   331→      agent_id: "@agent-worker",
   332→      trigger: "task.ready",
   333→      task_id: "@my-task",
   334→      status: "completed",
   335→      started_at: "2026-02-10T10:00:00.000Z",
   336→      ended_at: "2026-02-10T11:00:00.000Z",
   337→    }));
   338→    await fs.writeFile(path.join(s2Dir, "events.jsonl"), "");
   339→  });
   340→
   341→  afterEach(async () => {
   342→    await cleanupTempDir(tempDir);
   343→  });
   344→
   345→  it("should show session_type field in JSON output", () => {
   346→    const sessions = kspecJson<SessionLogSummary[]>("session log list", tempDir);
   347→    expect(sessions).toHaveLength(2);
   348→
   349→    const legacy = sessions.find((s) => s.agent_type === "ralph");
   350→    const invocation = sessions.find((s) => s.agent_type === "claude-agent-acp");
   351→
   352→    expect(legacy).toBeDefined();
   353→    expect(legacy!.session_type).toBe("loop");
   354→
   355→    expect(invocation).toBeDefined();
   356→    expect(invocation!.session_type).toBe("invocation");
   357→  });
   358→
   359→  it("should display Type column in text output", () => {
   360→    const result = kspec("session log list", tempDir);
   361→    expect(result.exitCode).toBe(0);
   362→    expect(result.stdout).toContain("Type");
   363→    expect(result.stdout).toContain("loop");
   364→    expect(result.stdout).toContain("invocation");
   365→  });
   366→});
