   549→/**
   550→ * Format alignment warnings for display
   551→ */
   552→function formatAlignmentWarnings(
   553→  warnings: AlignmentWarning[],
   554→  verbose: boolean,
   555→): void {
   556→  if (warnings.length === 0) {
   557→    console.log(chalk.green("Alignment: OK"));
   558→    return;
   559→  }
   560→
   561→  console.log(chalk.yellow(`\nAlignment warnings: ${warnings.length}`));
   562→
   563→  // Group by type
   564→  const orphaned = warnings.filter((w) => w.type === "orphaned_spec");
   565→  const mismatches = warnings.filter((w) => w.type === "status_mismatch");
   566→  const stale = warnings.filter((w) => w.type === "stale_implementation");
   567→
   568→  if (orphaned.length > 0) {
   569→    console.log(
   570→      chalk.yellow(`  Orphaned specs (no tasks): ${orphaned.length}`),
   571→    );
   572→    const shown = verbose ? orphaned : orphaned.slice(0, 3);
   573→    for (const w of shown) {
   574→      console.log(chalk.gray(`    ○ ${w.specTitle}`));
   575→    }
   576→    if (!verbose && orphaned.length > 3) {
   577→      console.log(chalk.gray(`    ... and ${orphaned.length - 3} more`));
   578→    }
   579→  }
   580→
   581→  if (mismatches.length > 0) {
   582→    console.log(chalk.yellow(`  Status mismatches: ${mismatches.length}`));
   583→    for (const w of mismatches) {
   584→      console.log(chalk.yellow(`    ! ${w.specTitle}`));
   585→      console.log(chalk.gray(`      ${w.message}`));
   586→    }
   587→  }
   588→
   589→  if (stale.length > 0) {
   590→    console.log(chalk.yellow(`  Stale implementation status: ${stale.length}`));
   591→    for (const w of stale) {
   592→      console.log(chalk.yellow(`    ! ${w.message}`));
   593→    }
   594→  }
   595→}
   596→
   597→/**
   598→ * Format fix results for display
   599→ */
   600→function formatFixResult(result: FixResult): void {
   601→  if (result.fixesApplied.length === 0) {
   602→    console.log(chalk.gray("\nNo auto-fixable issues found."));
   603→    return;
   604→  }
   605→
   606→  console.log(
   607→    chalk.cyan(
   608→      `\n✓ Applied ${result.fixesApplied.length} fix(es) to ${result.filesModified} file(s):`,
   609→    ),
   610→  );
   611→
   612→  for (const fix of result.fixesApplied) {
   613→    const typeLabel = {
   614→      ulid_regenerated: "ULID regenerated",
   615→      timestamp_added: "Timestamp added",
   616→      status_added: "Status added",
   617→    }[fix.type];
   618→
   619→    const shortFile = path.basename(fix.file);
   620→    console.log(chalk.cyan(`  ✓ ${shortFile}:${fix.path} - ${typeLabel}`));
   621→  }
   622→
   623→  if (result.errors.length > 0) {
   624→    console.log(chalk.yellow(`\nFix errors: ${result.errors.length}`));
   625→    for (const err of result.errors) {
   626→      console.log(chalk.yellow(`  ! ${err.file}: ${err.message}`));
   627→    }
   628→  }
   629→}
   630→
   631→/**
   632→ * Collect all files that can be fixed
   633→ */
   634→async function collectFixableFiles(ctx: {
   635→  rootDir: string;
   636→  specDir?: string;
   637→  manifest?: { includes?: string[] } | null;
   638→  manifestPath?: string | null;
   639→}): Promise<string[]> {
   640→  const files: string[] = [];
   641→
   642→  // Task files (exclude test fixtures)
   643→  const taskFiles = await findTaskFiles(ctx.rootDir);
   644→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, "spec"));
   645→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
   646→  files.push(
   647→    ...allTaskFiles.filter(
   648→      (f) => !f.includes("fixtures") && !f.includes("test"),
   649→    ),
   650→  );
   651→
   652→  // Spec files from includes
   653→  if (ctx.manifest && ctx.manifestPath) {
   654→    const manifestDir = path.dirname(ctx.manifestPath);
   655→    const includes = ctx.manifest.includes || [];
   656→
   657→    for (const include of includes) {
   658→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   659→      files.push(...expandedPaths);
   660→    }
   661→  }
   662→
   663→  // Inbox file
   664→  const inboxPath = path.join(ctx.rootDir, "spec", "kynetic.inbox.yaml");
   665→  try {
   666→    await import("node:fs/promises").then((fs) => fs.access(inboxPath));
   667→    files.push(inboxPath);
   668→  } catch {
   669→    // Inbox file doesn't exist, skip
   670→  }
   671→
   672→  return [...new Set(files)];
   673→}
   674→
   675→/**
   676→ * Format validation result for display
   677→ */
   678→function formatValidationResult(
   679→  result: ValidationResult,
   680→  verbose: boolean,
   681→): void {
   682→  // Header
   683→  if (result.valid) {
   684→    console.log(chalk.green.bold("✓ Validation passed"));
   685→  } else {
   686→    console.log(chalk.red.bold("✗ Validation failed"));
   687→  }
   688→
   689→  console.log(chalk.gray("─".repeat(40)));
   690→  console.log(`Files checked: ${result.stats.filesChecked}`);
   691→  console.log(`Items checked: ${result.stats.itemsChecked}`);
   692→  console.log(`Tasks checked: ${result.stats.tasksChecked}`);
   693→
   694→  // AC-meta-manifest-2: Display meta summary line
   695→  if (result.metaStats) {
   696→    console.log(
   697→      `Meta: ${result.metaStats.agents} agents, ${result.metaStats.workflows} workflows, ${result.metaStats.conventions} conventions`,
   698→    );
   699→  }
   700→
   701→  // Schema errors
   702→  if (result.schemaErrors.length > 0) {
   703→    console.log(chalk.red(`\nSchema errors: ${result.schemaErrors.length}`));
   704→    for (const err of result.schemaErrors) {
   705→      const location = err.path ? `${err.file}:${err.path}` : err.file;
   706→      console.log(chalk.red(`  ✗ ${location}`));
   707→      console.log(chalk.gray(`    ${err.message}`));
   708→      if (verbose && err.details) {
   709→        console.log(chalk.gray(`    ${JSON.stringify(err.details)}`));
   710→      }
   711→    }
   712→  } else {
   713→    console.log(chalk.green("\nSchema: OK"));
   714→  }
   715→
   716→  // Reference errors
   717→  if (result.refErrors.length > 0) {
   718→    console.log(chalk.red(`\nReference errors: ${result.refErrors.length}`));
   719→    for (const err of result.refErrors) {
   720→      const location = err.sourceFile
   721→        ? `${err.sourceFile} (${err.field})`
   722→        : `${err.sourceUlid?.slice(0, 8)} (${err.field})`;
   723→      console.log(chalk.red(`  ✗ ${err.ref}`));
   724→      console.log(chalk.gray(`    ${err.message}`));
   725→      console.log(chalk.gray(`    in: ${location}`));
   726→    }
   727→  } else {
   728→    console.log(chalk.green("References: OK"));
   729→  }
   730→
   731→  // Reference warnings (deprecated targets)
   732→  if (result.refWarnings.length > 0) {
   733→    console.log(
   734→      chalk.yellow(`\nReference warnings: ${result.refWarnings.length}`),
   735→    );
   736→    const shown = verbose ? result.refWarnings : result.refWarnings.slice(0, 5);
   737→    for (const warn of shown) {
   738→      const location = warn.sourceFile
   739→        ? `${warn.sourceFile} (${warn.field})`
   740→        : `${warn.sourceUlid?.slice(0, 8)} (${warn.field})`;
   741→      console.log(chalk.yellow(`  ⚠ ${warn.ref}`));
   742→      console.log(chalk.gray(`    ${warn.message}`));
   743→      console.log(chalk.gray(`    in: ${location}`));
   744→    }
   745→    if (!verbose && result.refWarnings.length > 5) {
   746→      console.log(
   747→        chalk.gray(
   748→          `  ... and ${result.refWarnings.length - 5} more (use -v to see all)`,
   749→        ),
   750→      );
   751→    }
   752→  }
   753→
   754→  // AC: @trait-edge-cases ac-2
   755→  // Trait cycle errors
   756→  if (result.traitCycleErrors.length > 0) {
   757→    console.log(
   758→      chalk.red(`\nTrait cycle errors: ${result.traitCycleErrors.length}`),
   759→    );
   760→    for (const err of result.traitCycleErrors) {
   761→      console.log(chalk.red(`  ✗ ${err.traitRef} - ${err.traitTitle}`));
   762→      console.log(chalk.gray(`    ${err.message}`));
   763→    }
   764→  }
   765→
   766→  // Orphans (warnings, not errors)
   767→  if (result.orphans.length > 0) {
   768→    console.log(
   769→      chalk.yellow(`\nOrphans (not referenced): ${result.orphans.length}`),
   770→    );
   771→    if (verbose) {
   772→      for (const orphan of result.orphans) {
   773→        console.log(
   774→          chalk.yellow(
   775→            `  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`,
   776→          ),
   777→        );
   778→      }
   779→    } else {
   780→      // Show first few
   781→      const shown = result.orphans.slice(0, 5);
   782→      for (const orphan of shown) {
   783→        console.log(
   784→          chalk.yellow(
   785→            `  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`,
   786→          ),
   787→        );
   788→      }
   789→      if (result.orphans.length > 5) {
   790→        console.log(
   791→          chalk.gray(
   792→            `  ... and ${result.orphans.length - 5} more (use -v to see all)`,
   793→          ),
   794→        );
   795→      }
   796→    }
   797→  }
   798→}
   799→
   800→/**
   801→ * Register validate command
   802→ */
   803→export function registerValidateCommand(program: Command): void {
   804→  program
   805→    .command("validate")
   806→    .description("Validate spec files")
   807→    .option("--schema", "Check schema conformance only")
   808→    .option("--refs", "Check reference resolution only")
   809→    .option("--orphans", "Find orphaned items only")
   810→    .option("--alignment", "Check spec-task alignment")
   811→    .option(
   812→      "--completeness",
   813→      "Check spec completeness (missing AC, descriptions, status inconsistencies)",
   814→    )
   815→    .option("--conventions", "Validate conventions")
   816→    .option(
   817→      "--staleness",
   818→      "Check for stale status mismatches between specs and tasks",
   819→    )
   820→    .option("--skills", "Validate skill files (.claude/skills/*/SKILL.md)")
   821→    .option(
   822→      "--drift",
   823→      "Check AC field references against actual schema (catches spec prose drift)",
   824→    )
   825→    .option(
   826→      "--fix",
   827→      "Auto-fix issues where possible (invalid ULIDs, missing timestamps)",
   828→    )
   829→    .option("-v, --verbose", "Show detailed output")
   830→    .option("--strict", "Treat orphans and staleness warnings as errors")
   831→    .option(
   832→      "--warnings-ok",
   833→      "Return success exit code (0) when warnings are present but no errors",
   834→    )
   835→    .action(async (options) => {
   836→      try {
   837→        const ctx = await initContext();
   838→        const structuredOutput = isStructuredMode();
   839→
   840→        if (!ctx.manifestPath) {
   841→          error(validationStrings.noManifest);
   842→          console.log(validationStrings.initHint);
   843→          process.exit(EXIT_CODES.ERROR);
   844→        }
   845→
   846→        // Track warnings from all sources for exit code determination
   847→        let additionalWarningCount = 0;
   848→
   849→        // Determine which checks to run. Coerce to booleans so we pass explicit
   850→        // false values to parser validation when a check is not selected.
   851→        const selectedChecks = {
   852→          schema: Boolean(options.schema),
   853→          refs: Boolean(options.refs),
   854→          orphans: Boolean(options.orphans),
   855→          alignment: Boolean(options.alignment),
   856→          completeness: Boolean(options.completeness),
   857→          conventions: Boolean(options.conventions),
   858→          staleness: Boolean(options.staleness),
   859→          skills: Boolean(options.skills),
   860→          drift: Boolean(options.drift),
   861→        };
   862→        const runAll = !Object.values(selectedChecks).some(Boolean);
   863→
   864→        // AC: @config-validation ac-4 — CLI --strict overrides config strict_refs
   865→        // If --strict is passed, use strict behavior regardless of config
   866→        // Otherwise, use config value (which defaults to false)
   867→        const strictRefs = options.strict ? true : ctx.config.validation.strict_refs;
   868→        const requireAcceptance = ctx.config.validation.require_acceptance;
   869→
   870→        const validateOptions = {
   871→          schema: runAll || selectedChecks.schema,
   872→          refs: runAll || selectedChecks.refs,
   873→          orphans: runAll || selectedChecks.orphans,
   874→          completeness: runAll || selectedChecks.completeness,
   875→          // AC: @config-validation ac-2 ac-3 ac-4 — wire config into validation
   876→          strictRefs,
   877→          requireAcceptance,
   878→        };
   879→
   880→        const result = await validate(ctx, validateOptions);
   881→
   882→        // In strict mode, orphans are errors
   883→        if (options.strict && result.orphans.length > 0) {
   884→          result.valid = false;
   885→        }
   886→
   887→        output(result, () => formatValidationResult(result, options.verbose));
   888→
   889→        // Run auto-fix if requested
   890→        if (options.fix) {
   891→          const filesToFix = await collectFixableFiles(ctx);
   892→          const fixResult = await fixFiles(filesToFix);
   893→          if (!structuredOutput) {
   894→            formatFixResult(fixResult);
   895→          }
   896→
   897→          // Re-run validation after fixes to show updated status
   898→          if (fixResult.fixesApplied.length > 0) {
   899→            if (!structuredOutput) {
   900→              console.log(validationStrings.revalidating);
   901→            }
   902→            const revalidateResult = await validate(ctx, validateOptions);
   903→            if (!structuredOutput) {
   904→              if (revalidateResult.valid) {
   905→                console.log(validationStrings.nowPasses);
   906→              } else {
   907→                console.log(validationStrings.issuesRemain);
   908→              }
   909→            }
   910→            // Update result for exit code
   911→            result.valid = revalidateResult.valid;
   912→            result.schemaErrors = revalidateResult.schemaErrors;
   913→            result.refErrors = revalidateResult.refErrors;
   914→          }
   915→        }
   916→
   917→        // Run alignment check if requested or running all checks
   918→        if (selectedChecks.alignment || runAll) {
   919→          const tasks = await loadAllTasks(ctx);
   920→          const items = await loadAllItems(ctx);
   921→          const refIndex = new ReferenceIndex(tasks, items);
   922→          const alignmentIndex = new AlignmentIndex(tasks, items);
   923→          alignmentIndex.buildLinks(refIndex);
   924→
   925→          const alignmentWarnings = alignmentIndex.findAlignmentWarnings();
   926→          if (!structuredOutput) {
   927→            formatAlignmentWarnings(alignmentWarnings, options.verbose);
   928→          }
   929→          additionalWarningCount += alignmentWarnings.length;
   930→
   931→          // Show alignment stats
   932→          if (!structuredOutput) {
   933→            const stats = alignmentIndex.getStats();
   934→            console.log(
   935→              validationStrings.alignmentStats(
   936→                stats.specsWithTasks,
   937→                stats.totalSpecs,
   938→                stats.alignedSpecs,
   939→              ),
   940→            );
   941→          }
   942→        }
   943→
   944→        // Show completeness warnings if any
   945→        // AC: @spec-completeness ac-4
   946→        if (!structuredOutput && result.completenessWarnings.length > 0) {
   947→          formatCompletenessWarnings(
   948→            result.completenessWarnings,
   949→            options.verbose,
   950→          );
   951→        }
   952→
   953→        // Run convention validation if requested
   954→        // AC: @convention-definitions ac-3, ac-4
   955→        if (selectedChecks.conventions) {
   956→          try {
   957→            const metaCtx = await loadMetaContext(ctx);
   958→            if (metaCtx && metaCtx.conventions.length > 0) {
   959→              // For now, we just validate that conventions are well-formed
   960→              // Full validation against actual content (commits, notes, etc.)
   961→              // would require additional content gathering logic
   962→              const conventionResult = validateConventions(
   963→                metaCtx.conventions,
   964→                {},
   965→              );
   966→              if (!structuredOutput) {
   967→                formatConventionValidationResult(conventionResult);
   968→              }
   969→
   970→              if (!conventionResult.valid) {
   971→                result.valid = false;
   972→              }
   973→            } else if (!structuredOutput) {
   974→              console.log(
   975→                chalk.gray("No conventions defined in meta manifest"),
   976→              );
   977→            }
   978→          } catch (_err) {
   979→            if (!structuredOutput) {
   980→              console.log(
   981→                chalk.yellow(
   982→                  "Warning: Could not load meta manifest for convention validation",
   983→                ),
   984→              );
   985→            }
   986→          }
   987→        }
   988→
   989→        // Run staleness checks if requested
   990→        // AC: @stale-status-detection ac-4, ac-5
   991→        let stalenessWarningCount = 0;
   992→        if (selectedChecks.staleness) {
   993→          const tasks = await loadAllTasks(ctx);
   994→          const items = await loadAllItems(ctx);
   995→          const refIndex = new ReferenceIndex(tasks, items);
   996→
   997→          const stalenessWarnings = checkStaleness(items, tasks, refIndex);
   998→          if (!structuredOutput) {
   999→            formatStalenessWarnings(stalenessWarnings, options.verbose);
  1000→          }
  1001→          stalenessWarningCount = stalenessWarnings.length;
  1002→
  1003→          // AC: @stale-status-detection ac-5 (staleness-exit-code)
  1004→          // With --strict, staleness warnings cause validation failure
  1005→          if (options.strict && stalenessWarnings.length > 0) {
  1006→            result.valid = false;
  1007→          }
  1008→        }
  1009→
  1010→        // Run skill file validation if requested or running all checks
  1011→        if (runAll || selectedChecks.skills) {
  1012→          const skillResult = await validateSkills(ctx.rootDir);
  1013→          if (!structuredOutput) {
  1014→            formatSkillValidationResult(skillResult, options.verbose);
  1015→          }
  1016→
  1017→          if (!skillResult.valid) {
  1018→            result.valid = false;
  1019→          }
  1020→        }
  1021→
  1022→        // Run AC schema drift checks if requested
  1023→        let driftWarningCount = 0;
  1024→        if (selectedChecks.drift) {
  1025→          const items = await loadAllItems(ctx);
  1026→          const driftWarnings = checkACSchemaReferences(items);
  1027→          if (!structuredOutput) {
  1028→            formatDriftWarnings(driftWarnings, options.verbose);
  1029→          }
  1030→          driftWarningCount = driftWarnings.length;
  1031→
  1032→          // With --strict, drift warnings cause validation failure
  1033→          if (options.strict && driftWarnings.length > 0) {
  1034→            result.valid = false;
  1035→          }
  1036→        }
  1037→
  1038→        // Determine exit code based on errors vs warnings
  1039→        // Errors: schema, refs, trait cycles, conventions, skills (result.valid = false)
  1040→        // Warnings: orphans, alignment, completeness, staleness, drift, ref warnings
  1041→        const hasErrors = !result.valid;
  1042→        const hasWarnings =
  1043→          result.orphans.length > 0 ||
  1044→          result.refWarnings.length > 0 ||
  1045→          result.completenessWarnings.length > 0 ||
  1046→          additionalWarningCount > 0 ||
  1047→          stalenessWarningCount > 0 ||
  1048→          driftWarningCount > 0;
  1049→
  1050→        if (hasErrors) {
  1051→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1052→        } else if (hasWarnings) {
  1053→          if (options.warningsOk) {
  1054→            warn(
  1055→              `Validation produced warnings; exiting 0 due to --warnings-ok (default is ${EXIT_CODES.VALIDATION_WARNINGS}).`,
  1056→            );
  1057→            process.exit(EXIT_CODES.SUCCESS);
  1058→          }
  1059→          warn(
  1060→            `Validation produced warnings; exiting ${EXIT_CODES.VALIDATION_WARNINGS}. Use --warnings-ok to treat warnings as success.`,
  1061→          );
  1062→          process.exit(EXIT_CODES.VALIDATION_WARNINGS);
  1063→        }
  1064→        // Otherwise exit 0 (success)
  1065→      } catch (err) {
  1066→        error(validationStrings.failed, err);
  1067→        process.exit(EXIT_CODES.ERROR);
  1068→      }
  1069→    });
  1070→
  1071→  // Alias: kspec lint
  1072→  program
  1073→    .command("lint")
  1074→    .description("Alias for validate with style checks")
  1075→    .option("--schema", "Check schema conformance only")
  1076→    .option("--refs", "Check reference resolution only")
  1077→    .option("--orphans", "Find orphaned items only")
  1078→    .option(
  1079→      "--completeness",
  1080→      "Check spec completeness (missing AC, descriptions, status inconsistencies)",
  1081→    )
  1082→    .option(
  1083→      "--fix",
  1084→      "Auto-fix issues where possible (invalid ULIDs, missing timestamps)",
  1085→    )
  1086→    .option("-v, --verbose", "Show detailed output")
  1087→    .option("--strict", "Treat orphans as errors")
  1088→    .option(
  1089→      "--warnings-ok",
  1090→      "Return success exit code (0) when warnings are present but no errors",
  1091→    )
  1092→    .action(async (options) => {
  1093→      try {
  1094→        const ctx = await initContext();
  1095→        const structuredOutput = isStructuredMode();
  1096→
  1097→        if (!ctx.manifestPath) {
  1098→          error(validationStrings.noManifest);
  1099→          process.exit(EXIT_CODES.ERROR);
  1100→        }
  1101→
  1102→        const selectedChecks = {
  1103→          schema: Boolean(options.schema),
  1104→          refs: Boolean(options.refs),
  1105→          orphans: Boolean(options.orphans),
  1106→          completeness: Boolean(options.completeness),
  1107→        };
  1108→        const runAll = !Object.values(selectedChecks).some(Boolean);
  1109→
  1110→        // AC: @config-validation ac-4 — CLI --strict overrides config strict_refs
  1111→        const strictRefs = options.strict ? true : ctx.config.validation.strict_refs;
  1112→        const requireAcceptance = ctx.config.validation.require_acceptance;
  1113→
  1114→        const validateOptions = {
  1115→          schema: runAll || selectedChecks.schema,
  1116→          refs: runAll || selectedChecks.refs,
  1117→          orphans: runAll || selectedChecks.orphans,
  1118→          completeness: runAll || selectedChecks.completeness,
  1119→          strictRefs,
  1120→          requireAcceptance,
  1121→        };
  1122→
  1123→        const result = await validate(ctx, validateOptions);
  1124→
  1125→        if (options.strict && result.orphans.length > 0) {
  1126→          result.valid = false;
  1127→        }
  1128→
  1129→        output(result, () => formatValidationResult(result, options.verbose));
  1130→
  1131→        // Run auto-fix if requested
  1132→        if (options.fix) {
  1133→          const filesToFix = await collectFixableFiles(ctx);
  1134→          const fixResult = await fixFiles(filesToFix);
  1135→          if (!structuredOutput) {
  1136→            formatFixResult(fixResult);
  1137→          }
  1138→
  1139→          // Re-run validation after fixes
  1140→          if (fixResult.fixesApplied.length > 0) {
  1141→            if (!structuredOutput) {
  1142→              console.log(validationStrings.revalidating);
  1143→            }
  1144→            const revalidateResult = await validate(ctx, validateOptions);
  1145→            if (!structuredOutput) {
  1146→              if (revalidateResult.valid) {
  1147→                console.log(validationStrings.nowPasses);
  1148→              } else {
  1149→                console.log(validationStrings.issuesRemain);
  1150→              }
  1151→            }
  1152→            result.valid = revalidateResult.valid;
  1153→          }
  1154→        }
  1155→
  1156→        // Determine exit code based on errors vs warnings
  1157→        const hasErrors = !result.valid;
  1158→        const hasWarnings =
  1159→          result.orphans.length > 0 ||
  1160→          result.refWarnings.length > 0 ||
  1161→          result.completenessWarnings.length > 0;
  1162→
  1163→        if (hasErrors) {
  1164→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1165→        } else if (hasWarnings) {
  1166→          if (options.warningsOk) {
  1167→            warn(
  1168→              `Validation produced warnings; exiting 0 due to --warnings-ok (default is ${EXIT_CODES.VALIDATION_WARNINGS}).`,
  1169→            );
  1170→            process.exit(EXIT_CODES.SUCCESS);
  1171→          }
  1172→          warn(
  1173→            `Validation produced warnings; exiting ${EXIT_CODES.VALIDATION_WARNINGS}. Use --warnings-ok to treat warnings as success.`,
  1174→          );
  1175→          process.exit(EXIT_CODES.VALIDATION_WARNINGS);
  1176→        }
  1177→        // Otherwise exit 0 (success)
  1178→      } catch (err) {
  1179→        error(validationStrings.lintFailed, err);
  1180→        process.exit(EXIT_CODES.ERROR);
  1181→      }
  1182→    });
  1183→}
  1184→
