    31→
    32→/**
    33→ * Staleness warning types
    34→ * AC: @stale-status-detection
    35→ */
    36→interface StalenessWarning {
    37→  type:
    38→    | "parent-pending-children-done"
    39→    | "spec-implemented-no-task"
    40→    | "task-done-spec-not-started"
    41→    | "automation-blocking";
    42→  message: string;
    43→  refs: string[];
    44→}
    45→
    46→/**
    47→ * Check for stale status mismatches between specs and tasks
    48→ * AC: @stale-status-detection ac-1, ac-2, ac-3
    49→ */
    50→function checkStaleness(
    51→  items: LoadedSpecItem[],
    52→  tasks: LoadedTask[],
    53→  refIndex: ReferenceIndex,
    54→): StalenessWarning[] {
    55→  const warnings: StalenessWarning[] = [];
    56→
    57→  // AC: @stale-status-detection ac-1 (parent-pending-children-done)
    58→  // Check if task with dependencies is pending but all dependencies are completed
    59→  for (const task of tasks) {
    60→    // Only check pending/in_progress tasks with dependencies
    61→    if (task.status !== "pending" && task.status !== "in_progress") continue;
    62→    if (!task.depends_on || task.depends_on.length === 0) continue;
    63→
    64→    // Resolve all dependency tasks
    65→    const depTasks = task.depends_on
    66→      .map((depRef) => {
    67→        const result = refIndex.resolve(depRef);
    68→        if (!result.ok) return null;
    69→        return tasks.find((t) => t._ulid === result.ulid);
    70→      })
    71→      .filter((t): t is LoadedTask => t !== null);
    72→
    73→    if (depTasks.length === 0) continue;
    74→
    75→    // Check if all dependencies are completed and their linked specs are implemented
    76→    const allDepsDone = depTasks.every((depTask) => {
    77→      if (depTask.status !== "completed") return false;
    78→
    79→      // If the dep task has a spec_ref, check if that spec is implemented
    80→      if (depTask.spec_ref) {
    81→        const result = refIndex.resolve(depTask.spec_ref);
    82→        if (!result.ok) return true; // Missing spec ref doesn't block
    83→        const spec = items.find((item) => item._ulid === result.ulid);
    84→        return spec?.status?.implementation === "implemented";
    85→      }
    86→      return true;
    87→    });
    88→
    89→    if (allDepsDone) {
    90→      const taskRef = task.slugs[0] || refIndex.shortUlid(task._ulid);
    91→      warnings.push({
    92→        type: "parent-pending-children-done",
    93→        message: `Task @${taskRef} is ${task.status} but all dependencies are completed. Consider completing or reviewing.`,
    94→        refs: [task._ulid],
    95→      });
    96→    }
    97→  }
    98→
    99→  // AC: @stale-status-detection ac-2 (spec-implemented-no-task)
   100→  // Check if spec is implemented but has no completed tasks
   101→  for (const item of items) {
   102→    if (item.status?.implementation !== "implemented") continue;
   103→
   104→    // AC: @trait-retrospective ac-1
   105→    // Skip retrospective specs from staleness warnings
   106→    const isRetrospective = item.traits?.includes("@trait-retrospective");
   107→    if (isRetrospective) continue;
   108→
   109→    // Find completed tasks that reference this spec
   110→    const completedTasks = tasks.filter((task) => {
   111→      if (task.status !== "completed" || !task.spec_ref) return false;
   112→      const result = refIndex.resolve(task.spec_ref);
   113→      return result.ok && result.ulid === item._ulid;
   114→    });
   115→
   116→    if (completedTasks.length === 0) {
   117→      const specRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
   118→      warnings.push({
   119→        type: "spec-implemented-no-task",
   120→        message: `Spec @${specRef} is implemented but has no completed tasks. Verify implementation or link existing task.`,
   121→        refs: [item._ulid],
   122→      });
   123→    }
   124→  }
   125→
   126→  // AC: @stale-status-detection ac-3 (task-done-spec-not-started)
   127→  // Check if task is completed but spec is still not_started
   128→  for (const task of tasks) {
   129→    if (task.status !== "completed") continue;
   130→    if (!task.spec_ref) continue;
   131→
   132→    // Resolve spec reference
   133→    const result = refIndex.resolve(task.spec_ref);
   134→    if (!result.ok) continue;
   135→
   136→    const spec = items.find((item) => item._ulid === result.ulid);
   137→    if (!spec) continue;
   138→
   139→    if (spec.status?.implementation === "not_started") {
   140→      const taskRef = task.slugs[0] || refIndex.shortUlid(task._ulid);
   141→      const specRef = spec.slugs[0] || refIndex.shortUlid(spec._ulid);
   142→      warnings.push({
   143→        type: "task-done-spec-not-started",
   144→        message: `Task @${taskRef} completed but spec @${specRef} is not_started. Update spec status.`,
   145→        refs: [task._ulid, spec._ulid],
   146→      });
   147→    }
   148→  }
   149→
   150→  // AC: @validation ac-1
   151→  // Check for manual_only parents blocking eligible children
   152→  for (const parentTask of tasks) {
   153→    if (parentTask.automation !== "manual_only") continue;
   154→
   155→    // Find tasks that depend on this parent
   156→    const dependentTasks = tasks.filter((t) =>
   157→      t.depends_on?.some((depRef) => {
   158→        const result = refIndex.resolve(depRef);
   159→        return result.ok && result.ulid === parentTask._ulid;
   160→      }),
   161→    );
   162→
   163→    // Filter for eligible children
   164→    const eligibleChildren = dependentTasks.filter(
   165→      (t) => t.automation === "eligible",
   166→    );
   167→
   168→    if (eligibleChildren.length > 0) {
   169→      const parentRef =
   170→        parentTask.slugs[0] || refIndex.shortUlid(parentTask._ulid);
   171→      const childRefs = eligibleChildren.map(
   172→        (c) => `@${c.slugs[0] || refIndex.shortUlid(c._ulid)}`,
   173→      );
   174→
   175→      warnings.push({
   176→        type: "automation-blocking",
   177→        message: `Task @${parentRef} is manual_only and blocks ${eligibleChildren.length} eligible child task(s): ${childRefs.join(", ")}`,
   178→        refs: [parentTask._ulid, ...eligibleChildren.map((c) => c._ulid)],
   179→      });
   180→    }
   181→  }
   182→
   183→  return warnings;
   184→}
   185→
   186→/**
   187→ * Format staleness warnings for display
   188→ * AC: @stale-status-detection ac-4
   189→ */
   190→function formatStalenessWarnings(
   191→  warnings: StalenessWarning[],
   192→  verbose: boolean,
   193→): void {
   194→  if (warnings.length === 0) {
   195→    console.log(chalk.green("Staleness: OK"));
   196→    return;
   197→  }
   198→
   199→  console.log(chalk.yellow(`\nStaleness warnings: ${warnings.length}`));
   200→
   201→  // Group by type
   202→  const parentPending = warnings.filter(
   203→    (w) => w.type === "parent-pending-children-done",
   204→  );
   205→  const specNoTask = warnings.filter(
   206→    (w) => w.type === "spec-implemented-no-task",
   207→  );
   208→  const taskDoneSpecNot = warnings.filter(
   209→    (w) => w.type === "task-done-spec-not-started",
   210→  );
   211→  const automationBlocking = warnings.filter(
   212→    (w) => w.type === "automation-blocking",
   213→  );
   214→
   215→  if (parentPending.length > 0) {
   216→    console.log(
   217→      chalk.yellow(`  Parent pending, children done: ${parentPending.length}`),
   218→    );
   219→    const shown = verbose ? parentPending : parentPending.slice(0, 3);
   220→    for (const w of shown) {
   221→      console.log(chalk.yellow(`    ! ${w.message}`));
   222→    }
   223→    if (!verbose && parentPending.length > 3) {
   224→      console.log(chalk.gray(`    ... and ${parentPending.length - 3} more`));
   225→    }
   226→  }
   227→
   228→  if (specNoTask.length > 0) {
   229→    console.log(
   230→      chalk.yellow(`  Spec implemented, no task: ${specNoTask.length}`),
   231→    );
   232→    const shown = verbose ? specNoTask : specNoTask.slice(0, 3);
   233→    for (const w of shown) {
   234→      console.log(chalk.yellow(`    ! ${w.message}`));
   235→    }
   236→    if (!verbose && specNoTask.length > 3) {
   237→      console.log(chalk.gray(`    ... and ${specNoTask.length - 3} more`));
   238→    }
   239→  }
   240→
   241→  if (taskDoneSpecNot.length > 0) {
   242→    console.log(
   243→      chalk.yellow(`  Task done, spec not started: ${taskDoneSpecNot.length}`),
   244→    );
   245→    const shown = verbose ? taskDoneSpecNot : taskDoneSpecNot.slice(0, 3);
   246→    for (const w of shown) {
   247→      console.log(chalk.yellow(`    ! ${w.message}`));
   248→    }
   249→    if (!verbose && taskDoneSpecNot.length > 3) {
   250→      console.log(chalk.gray(`    ... and ${taskDoneSpecNot.length - 3} more`));
   251→    }
   252→  }
   253→
   254→  if (automationBlocking.length > 0) {
   255→    console.log(
   256→      chalk.yellow(`  Automation blocking: ${automationBlocking.length}`),
   257→    );
   258→    const shown = verbose ? automationBlocking : automationBlocking.slice(0, 3);
   259→    for (const w of shown) {
   260→      console.log(chalk.yellow(`    ! ${w.message}`));
   261→    }
   262→    if (!verbose && automationBlocking.length > 3) {
   263→      console.log(
   264→        chalk.gray(`    ... and ${automationBlocking.length - 3} more`),
   265→      );
   266→    }
   267→  }
   268→}
