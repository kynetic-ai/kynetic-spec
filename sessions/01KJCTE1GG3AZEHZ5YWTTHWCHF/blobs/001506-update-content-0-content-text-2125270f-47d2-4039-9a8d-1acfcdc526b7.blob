     1→/**
     2→ * E2E API Tests for Daemon Projects Endpoints
     3→ *
     4→ * Tests verify actual HTTP behavior by calling the running daemon directly.
     5→ * These replace the static analysis tests in tests/daemon-api-projects.test.ts
     6→ * which used existsSync guards and skipped most assertions when implementation was pending.
     7→ *
     8→ * Covered ACs:
     9→ * - @multi-directory-daemon ac-28: GET /api/projects returns list with paths, registration time, watcher status
    10→ * - @multi-directory-daemon ac-29: POST /api/projects with {path} body for manual registration
    11→ * - @multi-directory-daemon ac-30: DELETE /api/projects/:encodedPath unregisters project and stops watcher
    12→ */
    13→
    14→// Trait N/A annotations — @multi-directory-daemon inherits from @trait-localhost-security and @trait-websocket-protocol:
    15→// AC: @trait-localhost-security ac-1 — N/A: localhost binding tested in api-server.spec.ts
    16→// AC: @trait-localhost-security ac-2 — N/A: non-localhost rejection tested in api-server.spec.ts
    17→// AC: @trait-localhost-security ac-3 — N/A: external binding warning not tested (never configured in tests)
    18→// AC: @trait-websocket-protocol ac-1 — N/A: WebSocket connection lifecycle tested in future api-websocket.spec.ts
    19→// AC: @trait-websocket-protocol ac-2 — N/A: WebSocket subscribe tested in future api-websocket.spec.ts
    20→// AC: @trait-websocket-protocol ac-3 — N/A: WebSocket broadcast format tested in future api-websocket.spec.ts
    21→// AC: @trait-websocket-protocol ac-4 — N/A: WebSocket heartbeat timing tested in future api-websocket.spec.ts
    22→// AC: @trait-websocket-protocol ac-5 — N/A: WebSocket ping/pong timeout tested in future api-websocket.spec.ts
    23→// AC: @trait-websocket-protocol ac-6 — N/A: WebSocket backpressure tested in future api-websocket.spec.ts
    24→// AC: @trait-websocket-protocol ac-7 — N/A: WebSocket close codes tested in future api-websocket.spec.ts
    25→// AC: @trait-websocket-protocol ac-8 — N/A: WebSocket reconnection tested in future api-websocket.spec.ts
    26→
    27→import { test, expect } from '../fixtures/test-base';
    28→
    29→const DAEMON_URL = 'http://localhost:3456';
    30→
    31→test.describe('Projects API', () => {
    32→  test.describe('GET /api/projects', () => {
    33→    // AC: @multi-directory-daemon ac-28
    34→    test('returns list of registered projects with paths, registeredAt, and watcherStatus', async ({
    35→      request,
    36→      daemon,
    37→    }) => {
    38→      const response = await request.get(`${DAEMON_URL}/api/projects`);
    39→
    40→      expect(response.status()).toBe(200);
    41→
    42→      const body = await response.json();
    43→      // Response shape: { projects: [...], total: N }
    44→      expect(body).toHaveProperty('projects');
    45→      expect(body).toHaveProperty('total');
    46→      expect(Array.isArray(body.projects)).toBe(true);
    47→
    48→      // Daemon always has at least the default project registered
    49→      expect(body.projects.length).toBeGreaterThan(0);
    50→      expect(body.total).toBe(body.projects.length);
    51→    });
    52→
    53→    // AC: @multi-directory-daemon ac-28
    54→    test('each project has required fields: path, registeredAt, watcherStatus', async ({
    55→      request,
    56→      daemon,
    57→    }) => {
    58→      const response = await request.get(`${DAEMON_URL}/api/projects`);
    59→      expect(response.status()).toBe(200);
    60→
    61→      const body = await response.json();
    62→      expect(body.projects.length).toBeGreaterThan(0);
    63→
    64→      const project = body.projects[0];
    65→      // AC: @multi-directory-daemon ac-28 — include paths, registration time, watcher status
    66→      expect(project).toHaveProperty('path');
    67→      expect(typeof project.path).toBe('string');
    68→      expect(project.path.length).toBeGreaterThan(0);
    69→
    70→      expect(project).toHaveProperty('registeredAt');
    71→      expect(typeof project.registeredAt).toBe('string');
    72→      // registeredAt should be a valid ISO 8601 date
    73→      expect(() => new Date(project.registeredAt)).not.toThrow();
    74→      expect(new Date(project.registeredAt).getTime()).not.toBeNaN();
    75→
    76→      expect(project).toHaveProperty('watcherStatus');
    77→      expect(['active', 'stopped']).toContain(project.watcherStatus);
    78→    });
    79→
    80→    // AC: @multi-directory-daemon ac-28
    81→    test('returns JSON content type', async ({ request, daemon }) => {
    82→      const response = await request.get(`${DAEMON_URL}/api/projects`);
    83→      expect(response.status()).toBe(200);
    84→
    85→      const contentType = response.headers()['content-type'] || '';
    86→      expect(contentType).toContain('application/json');
    87→    });
    88→
    89→    // AC: @multi-directory-daemon ac-28 — default project path is absolute
    90→    test('project paths are absolute filesystem paths', async ({ request, daemon }) => {
    91→      const response = await request.get(`${DAEMON_URL}/api/projects`);
    92→      expect(response.status()).toBe(200);
    93→
    94→      const body = await response.json();
    95→      for (const project of body.projects) {
    96→        // Absolute paths start with / on Unix or drive letter on Windows
    97→        expect(project.path).toMatch(/^(\/|[A-Z]:\\)/);
    98→      }
    99→    });
   100→
   101→    // AC: @multi-directory-daemon ac-28 — after registering a second project, list updates
   102→    test('registered second project appears in project list', async ({ request, daemon }) => {
   103→      // Register a second project
   104→      const secondPath = await daemon.createSecondProject();
   105→
   106→      const response = await request.get(`${DAEMON_URL}/api/projects`);
   107→      expect(response.status()).toBe(200);
   108→
   109→      const body = await response.json();
   110→      // Should now have at least 2 projects
   111→      expect(body.projects.length).toBeGreaterThanOrEqual(2);
   112→
   113→      // The second project should be in the list
   114→      const found = body.projects.find(
   115→        (p: { path: string }) => p.path === secondPath
   116→      );
   117→      expect(found).toBeDefined();
   118→      expect(found.path).toBe(secondPath);
   119→      expect(found.registeredAt).toBeTruthy();
   120→      expect(['active', 'stopped']).toContain(found.watcherStatus);
   121→    });
   122→  });
   123→
   124→  test.describe('POST /api/projects', () => {
   125→    // AC: @multi-directory-daemon ac-29 — POST /api/projects returns {success, project} shape
   126→    test('accepts {path} body and returns {success: true, project: {path, registeredAt, watcherStatus}}', async ({
   127→      request,
   128→      daemon,
   129→    }) => {
   130→      // Set up a valid second project directory structure
   131→      const secondPath = await daemon.createSecondProject();
   132→
   133→      // Unregister so we can re-register and capture the direct POST response
   134→      const encodedPath = encodeURIComponent(secondPath);
   135→      await request.delete(`${DAEMON_URL}/api/projects/${encodedPath}`);
   136→
   137→      // AC: @multi-directory-daemon ac-29 — POST with {path} body, verify response shape
   138→      const registerResponse = await request.post(`${DAEMON_URL}/api/projects`, {
   139→        data: { path: secondPath },
   140→      });
   141→
   142→      expect(registerResponse.status()).toBe(200);
   143→
   144→      const body = await registerResponse.json();
   145→      expect(body).toHaveProperty('success');
   146→      expect(body.success).toBe(true);
   147→      expect(body).toHaveProperty('project');
   148→
   149→      const project = body.project;
   150→      expect(project).toHaveProperty('path');
   151→      expect(project.path).toBe(secondPath);
   152→      expect(project).toHaveProperty('registeredAt');
   153→      expect(typeof project.registeredAt).toBe('string');
   154→      expect(project).toHaveProperty('watcherStatus');
   155→      expect(['active', 'stopped']).toContain(project.watcherStatus);
   156→    });
   157→
   158→    // AC: @multi-directory-daemon ac-29 — POST /api/projects validates path is absolute
   159→    // (Note: ac-6/ac-7/ac-5 are for X-Kspec-Dir header validation; POST /api/projects
   160→    // mirrors those rules for the request body {path} field as part of ac-29 path validation)
   161→    test('returns 400 when path is not absolute', async ({ request, daemon }) => {
   162→      const response = await request.post(`${DAEMON_URL}/api/projects`, {
   163→        data: { path: 'relative/path/without/slash' },
   164→      });
   165→
   166→      expect(response.status()).toBe(400);
   167→
   168→      const body = await response.json();
   169→      expect(body).toHaveProperty('error');
   170→      expect(body.error).toMatch(/absolute|Path must be/i);
   171→    });
   172→
   173→    // AC: @multi-directory-daemon ac-29 — POST /api/projects rejects parent traversal in path
   174→    test('returns 400 when path contains ".." segments', async ({ request, daemon }) => {
   175→      const response = await request.post(`${DAEMON_URL}/api/projects`, {
   176→        data: { path: '/tmp/../etc' },
   177→      });
   178→
   179→      expect(response.status()).toBe(400);
   180→
   181→      const body = await response.json();
   182→      expect(body).toHaveProperty('error');
   183→      expect(body.error).toMatch(/parent traversal/i);
   184→    });
   185→
   186→    // AC: @multi-directory-daemon ac-29 — POST /api/projects rejects paths without .kspec/
   187→    test('returns 400 for path without .kspec/ directory', async ({ request, daemon }) => {
   188→      const response = await request.post(`${DAEMON_URL}/api/projects`, {
   189→        data: { path: '/tmp' }, // /tmp exists but has no .kspec/
   190→      });
   191→
   192→      expect(response.status()).toBe(400);
   193→
   194→      const body = await response.json();
   195→      expect(body).toHaveProperty('error');
   196→      expect(body.error).toMatch(/\.kspec\//i);
   197→    });
   198→
   199→    // AC: @multi-directory-daemon ac-29 — registered project appears in list
   200→    test('newly registered project appears in GET /api/projects', async ({
   201→      request,
   202→      daemon,
   203→    }) => {
   204→      const secondPath = await daemon.createSecondProject();
   205→
   206→      const listResponse = await request.get(`${DAEMON_URL}/api/projects`);
   207→      expect(listResponse.status()).toBe(200);
   208→
   209→      const listBody = await listResponse.json();
   210→      const found = listBody.projects.find(
   211→        (p: { path: string }) => p.path === secondPath
   212→      );
   213→      expect(found).toBeDefined();
   214→      expect(found.watcherStatus).toMatch(/active|stopped/);
   215→    });
   216→  });
   217→
   218→  test.describe('DELETE /api/projects/:encodedPath', () => {
   219→    // AC: @multi-directory-daemon ac-30
   220→    test('unregisters project and returns success', async ({ request, daemon }) => {
   221→      // Register a second project first
   222→      const secondPath = await daemon.createSecondProject();
   223→
   224→      // Encode the path for URL
   225→      const encodedPath = encodeURIComponent(secondPath);
   226→
   227→      // AC: @multi-directory-daemon ac-30 — DELETE to unregister
   228→      const response = await request.delete(
   229→        `${DAEMON_URL}/api/projects/${encodedPath}`
   230→      );
   231→
   232→      expect(response.status()).toBe(200);
   233→
   234→      const body = await response.json();
   235→      expect(body).toHaveProperty('success');
   236→      expect(body.success).toBe(true);
   237→    });
   238→
   239→    // AC: @multi-directory-daemon ac-30 — project no longer appears in list after unregister
   240→    test('unregistered project no longer appears in GET /api/projects', async ({
   241→      request,
   242→      daemon,
   243→    }) => {
   244→      // Register a second project
   245→      const secondPath = await daemon.createSecondProject();
   246→
   247→      // Verify it's registered
   248→      const beforeResponse = await request.get(`${DAEMON_URL}/api/projects`);
   249→      const beforeBody = await beforeResponse.json();
   250→      const foundBefore = beforeBody.projects.find(
   251→        (p: { path: string }) => p.path === secondPath
   252→      );
   253→      expect(foundBefore).toBeDefined();
   254→
   255→      // Unregister it
   256→      const encodedPath = encodeURIComponent(secondPath);
   257→      const deleteResponse = await request.delete(
   258→        `${DAEMON_URL}/api/projects/${encodedPath}`
   259→      );
   260→      expect(deleteResponse.status()).toBe(200);
   261→
   262→      // Verify it's gone from the list
   263→      const afterResponse = await request.get(`${DAEMON_URL}/api/projects`);
   264→      const afterBody = await afterResponse.json();
   265→      const foundAfter = afterBody.projects.find(
   266→        (p: { path: string }) => p.path === secondPath
   267→      );
   268→      expect(foundAfter).toBeUndefined();
   269→    });
   270→
   271→    // AC: @multi-directory-daemon ac-30 — 404 for non-registered project
   272→    test('returns 404 when deleting a project that is not registered', async ({
   273→      request,
   274→      daemon,
   275→    }) => {
   276→      const fakePath = '/tmp/nonexistent-project-xyz-99999';
   277→      const encodedPath = encodeURIComponent(fakePath);
   278→
   279→      const response = await request.delete(
   280→        `${DAEMON_URL}/api/projects/${encodedPath}`
   281→      );
   282→
   283→      expect(response.status()).toBe(404);
   284→
   285→      const body = await response.json();
   286→      expect(body).toHaveProperty('error');
   287→      expect(body.error).toMatch(/not registered|not_found/i);
   288→    });
   289→
   290→    // AC: @multi-directory-daemon ac-30 — URL-encoded paths are decoded correctly
   291→    test('decodes URL-encoded path correctly', async ({ request, daemon }) => {
   292→      const secondPath = await daemon.createSecondProject();
   293→
   294→      // Encode the path (paths with special chars)
   295→      const encodedPath = encodeURIComponent(secondPath);
   296→
   297→      // Verify encoding is applied (path should have URL-encoded chars if it has /)
   298→      expect(encodedPath).not.toContain('/');
   299→
   300→      const response = await request.delete(
   301→        `${DAEMON_URL}/api/projects/${encodedPath}`
   302→      );
   303→
   304→      // Should successfully decode and delete
   305→      expect(response.status()).toBe(200);
   306→    });
   307→
   308→    // AC: @multi-directory-daemon ac-30 — watcher stops on unregister
   309→    test('project list shows removed project after unregister (watcher cleanup implicit)', async ({
   310→      request,
   311→      daemon,
   312→    }) => {
   313→      const secondPath = await daemon.createSecondProject();
   314→      const encodedPath = encodeURIComponent(secondPath);
   315→
   316→      // Unregister (stops watcher as part of unregister)
   317→      await request.delete(`${DAEMON_URL}/api/projects/${encodedPath}`);
   318→
   319→      // Project should not be in list (verifies cleanup happened)
   320→      const listResponse = await request.get(`${DAEMON_URL}/api/projects`);
   321→      const listBody = await listResponse.json();
   322→      const found = listBody.projects.find(
   323→        (p: { path: string }) => p.path === secondPath
   324→      );
   325→      expect(found).toBeUndefined();
   326→    });
   327→  });
   328→});
