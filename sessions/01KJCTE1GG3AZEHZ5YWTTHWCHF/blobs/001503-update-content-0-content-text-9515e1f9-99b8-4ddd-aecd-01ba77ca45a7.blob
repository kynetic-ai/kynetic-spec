     1→/**
     2→ * E2E API Tests for Daemon Error Handling
     3→ *
     4→ * Tests verify actual HTTP error behavior by calling the running daemon directly.
     5→ * These replace the static analysis tests in tests/daemon-api-error-handling.test.ts
     6→ * which only read source files and check string patterns.
     7→ *
     8→ * Covered ACs:
     9→ * - @api-contract ac-22: GET /api/tasks/nonexistent-ref → 404 with {error, message, suggestion}
    10→ * - @api-contract ac-23: POST /api/tasks/:ref/note with empty body → 400 with {error, details:[{field, message}]}
    11→ * - @api-contract ac-24: POST /api/tasks/:ref/start on already-started → 409 with {error, current, valid_transitions}
    12→ */
    13→
    14→// Trait N/A annotations — @api-contract inherits from @trait-api-endpoint and @trait-websocket-protocol.
    15→// Error-handling-specific trait AC coverage:
    16→// AC: @trait-api-endpoint ac-1 — covered: all valid requests return 2xx JSON (verified in api-tasks, api-items, api-inbox, api-meta, api-triage tests)
    17→// AC: @trait-api-endpoint ac-2 — covered: 404 with {error, message, suggestion} for invalid refs (this file)
    18→// AC: @trait-api-endpoint ac-3 — covered: 400 with {error, details:[{field,message}]} for validation failures (this file)
    19→// AC: @trait-api-endpoint ac-4 — N/A: pagination tested in api-tasks.spec.ts
    20→// AC: @trait-api-endpoint ac-5 — N/A: shadow commits verified implicitly in mutation tests (api-tasks, api-inbox, api-triage)
    21→// AC: @trait-api-endpoint ac-6 — N/A: X-Request-Id header is infrastructure concern; not tested in domain E2E tests
    22→// AC: @trait-websocket-protocol ac-1 — N/A: WebSocket lifecycle tested in future api-websocket.spec.ts
    23→// AC: @trait-websocket-protocol ac-2 — N/A: WebSocket subscribe tested in future api-websocket.spec.ts
    24→// AC: @trait-websocket-protocol ac-3 — N/A: WebSocket broadcasts tested in future api-websocket.spec.ts
    25→// AC: @trait-websocket-protocol ac-4 — N/A: WebSocket heartbeat timing tested in future api-websocket.spec.ts
    26→// AC: @trait-websocket-protocol ac-5 — N/A: WebSocket ping/pong timeout tested in future api-websocket.spec.ts
    27→// AC: @trait-websocket-protocol ac-6 — N/A: WebSocket backpressure tested in future api-websocket.spec.ts
    28→// AC: @trait-websocket-protocol ac-7 — N/A: WebSocket close codes tested in future api-websocket.spec.ts
    29→// AC: @trait-websocket-protocol ac-8 — N/A: WebSocket reconnection tested in future api-websocket.spec.ts
    30→
    31→import { test, expect } from '../fixtures/test-base';
    32→
    33→const DAEMON_URL = 'http://localhost:3456';
    34→
    35→test.describe('Error Handling API', () => {
    36→  test.describe('404 Not Found Errors', () => {
    37→    // AC: @api-contract ac-22
    38→    test('GET /api/tasks/:ref returns 404 with {error, message, suggestion} for invalid ref', async ({
    39→      request,
    40→      daemon,
    41→    }) => {
    42→      const response = await request.get(`${DAEMON_URL}/api/tasks/@nonexistent-ref-xyz`);
    43→
    44→      expect(response.status()).toBe(404);
    45→
    46→      const body = await response.json();
    47→      // AC: @api-contract ac-22 — must have error, message, suggestion
    48→      expect(body).toHaveProperty('error');
    49→      expect(body.error).toBe('not_found');
    50→      expect(body).toHaveProperty('message');
    51→      expect(typeof body.message).toBe('string');
    52→      expect(body.message.length).toBeGreaterThan(0);
    53→      expect(body).toHaveProperty('suggestion');
    54→      expect(typeof body.suggestion).toBe('string');
    55→      expect(body.suggestion.length).toBeGreaterThan(0);
    56→    });
    57→
    58→    // AC: @api-contract ac-22
    59→    test('GET /api/items/:ref returns 404 with {error, message, suggestion} for invalid ref', async ({
    60→      request,
    61→      daemon,
    62→    }) => {
    63→      const response = await request.get(`${DAEMON_URL}/api/items/@nonexistent-item-xyz`);
    64→
    65→      expect(response.status()).toBe(404);
    66→
    67→      const body = await response.json();
    68→      expect(body).toHaveProperty('error');
    69→      expect(body.error).toBe('not_found');
    70→      expect(body).toHaveProperty('message');
    71→      expect(typeof body.message).toBe('string');
    72→      expect(body).toHaveProperty('suggestion');
    73→      expect(typeof body.suggestion).toBe('string');
    74→    });
    75→
    76→    // AC: @api-contract ac-22
    77→    test('GET /api/inbox/:ref returns 404 with error structure for invalid ref', async ({
    78→      request,
    79→      daemon,
    80→    }) => {
    81→      const response = await request.get(`${DAEMON_URL}/api/inbox/@nonexistent-inbox-xyz`);
    82→
    83→      expect(response.status()).toBe(404);
    84→
    85→      const body = await response.json();
    86→      expect(body).toHaveProperty('error');
    87→      expect(body.error).toBe('not_found');
    88→      expect(body).toHaveProperty('message');
    89→    });
    90→
    91→    // AC: @api-contract ac-22
    92→    test('suggestion field includes helpful guidance for task ref', async ({
    93→      request,
    94→      daemon,
    95→    }) => {
    96→      const response = await request.get(`${DAEMON_URL}/api/tasks/@nonexistent-task-xyz`);
    97→
    98→      expect(response.status()).toBe(404);
    99→
   100→      const body = await response.json();
   101→      // Suggestion should mention how to find valid refs
   102→      expect(body.suggestion).toBeTruthy();
   103→      // The suggestion should reference the task list command
   104→      expect(body.suggestion.toLowerCase()).toMatch(/kspec|task|list/i);
   105→    });
   106→
   107→    // AC: @api-contract ac-22 — POST endpoints also return 404 for invalid refs
   108→    test('POST /api/tasks/:ref/start returns 404 for non-existent task', async ({
   109→      request,
   110→      daemon,
   111→    }) => {
   112→      const response = await request.post(
   113→        `${DAEMON_URL}/api/tasks/@nonexistent-task-xyz/start`,
   114→        { data: {} }
   115→      );
   116→
   117→      expect(response.status()).toBe(404);
   118→
   119→      const body = await response.json();
   120→      expect(body).toHaveProperty('error');
   121→      expect(body.error).toBe('not_found');
   122→      expect(body).toHaveProperty('message');
   123→      expect(body).toHaveProperty('suggestion');
   124→    });
   125→
   126→    // AC: @api-contract ac-22 — note endpoint also 404
   127→    test('POST /api/tasks/:ref/note returns 404 for non-existent task', async ({
   128→      request,
   129→      daemon,
   130→    }) => {
   131→      const response = await request.post(
   132→        `${DAEMON_URL}/api/tasks/@nonexistent-task-xyz/note`,
   133→        { data: { content: 'test note' } }
   134→      );
   135→
   136→      expect(response.status()).toBe(404);
   137→
   138→      const body = await response.json();
   139→      expect(body).toHaveProperty('error');
   140→      expect(body.error).toBe('not_found');
   141→      expect(body).toHaveProperty('message');
   142→      expect(body).toHaveProperty('suggestion');
   143→    });
   144→  });
   145→
   146→  test.describe('400 Validation Errors', () => {
   147→    // Note on ac-23: Elysia framework schema validation returns 422 (not 400) for missing
   148→    // required fields. The custom handler-level validation returns 400 with {error, details}.
   149→    // Both are tested below — Elysia 422 for structural body issues, 400 for semantic validation.
   150→
   151→    // AC: @api-contract ac-23 — framework schema validation returns 422 for missing fields
   152→    // (Note: Elysia validates body before handler — missing required field returns 422, not 400)
   153→    test('POST /api/tasks/:ref/note with empty body returns 422 (Elysia schema validation)', async ({
   154→      request,
   155→      daemon,
   156→    }) => {
   157→      // Elysia validates body schema before handler runs — returns 422 for schema violations
   158→      const response = await request.post(
   159→        `${DAEMON_URL}/api/tasks/@test-task-in-progress/note`,
   160→        { data: {} } // missing required 'content' field
   161→      );
   162→
   163→      // Elysia schema validation returns 422 (Unprocessable Entity), not 400
   164→      // This is the Elysia framework behavior for the specific note endpoint
   165→      expect(response.status()).toBe(422);
   166→    });
   167→
   168→    // AC: @api-contract ac-23 — framework schema validation (inbox missing required field)
   169→    test('POST /api/inbox with invalid body returns 422 (Elysia schema validation)', async ({
   170→      request,
   171→      daemon,
   172→    }) => {
   173→      // Send request without required 'text' field
   174→      const response = await request.post(`${DAEMON_URL}/api/inbox`, {
   175→        data: {}, // missing required 'text' field
   176→      });
   177→
   178→      // Elysia schema validation returns 422 for missing required fields
   179→      expect(response.status()).toBe(422);
   180→    });
   181→
   182→    // AC: @api-contract ac-23 — custom handler validation returns 400 with {error, details:[{field,message}]}
   183→    // Sending empty string for 'text' passes Elysia schema (type=string) but hits custom handler validation
   184→    test('POST /api/inbox with empty text returns 400 with {error, details:[{field, message}]}', async ({
   185→      request,
   186→      daemon,
   187→    }) => {
   188→      const response = await request.post(`${DAEMON_URL}/api/inbox`, {
   189→        data: { text: '   ' }, // whitespace-only text: passes Elysia schema but fails custom validation
   190→      });
   191→
   192→      expect(response.status()).toBe(400);
   193→
   194→      const body = await response.json();
   195→      // AC: @api-contract ac-23 — must be {error, details:[{field, message}]}
   196→      expect(body).toHaveProperty('error');
   197→      expect(body.error).toBe('validation_error');
   198→      expect(body).toHaveProperty('details');
   199→      expect(Array.isArray(body.details)).toBe(true);
   200→      expect(body.details.length).toBeGreaterThan(0);
   201→
   202→      const detail = body.details[0];
   203→      expect(detail).toHaveProperty('field');
   204→      expect(detail).toHaveProperty('message');
   205→      expect(detail.field).toBe('text');
   206→    });
   207→
   208→    // AC: @api-contract ac-23 — triage action returns 400 with details array
   209→    test('POST /api/triage with invalid action returns 400 with {error, details:[{field, message}]}', async ({
   210→      request,
   211→      daemon,
   212→    }) => {
   213→      // First create an inbox item to triage
   214→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   215→        data: { text: `Error handling test ${Date.now()}` },
   216→      });
   217→      expect(inboxResponse.status()).toBe(200);
   218→      const inbox = await inboxResponse.json();
   219→
   220→      const response = await request.post(`${DAEMON_URL}/api/triage`, {
   221→        data: {
   222→          inbox_ref: `@${inbox.item._ulid}`,
   223→          action: 'invalid-action-xyz',
   224→          reasoning: 'Test invalid action',
   225→        },
   226→      });
   227→
   228→      expect(response.status()).toBe(400);
   229→
   230→      const body = await response.json();
   231→      expect(body.error).toBe('validation_error');
   232→      expect(body).toHaveProperty('details');
   233→      expect(Array.isArray(body.details)).toBe(true);
   234→      expect(body.details.length).toBeGreaterThan(0);
   235→
   236→      // Each detail item should have field and message
   237→      const detail = body.details[0];
   238→      expect(detail).toHaveProperty('field');
   239→      expect(detail).toHaveProperty('message');
   240→      expect(detail.field).toBe('action');
   241→    });
   242→  });
   243→
   244→  test.describe('409 State Transition Errors', () => {
   245→    // AC: @api-contract ac-24
   246→    test('POST /api/tasks/:ref/start on already-started task returns 409 with transition info', async ({
   247→      request,
   248→      daemon,
   249→    }) => {
   250→      // test-task-in-progress is already in_progress in the fixture
   251→      const response = await request.post(
   252→        `${DAEMON_URL}/api/tasks/@test-task-in-progress/start`,
   253→        { data: {} }
   254→      );
   255→
   256→      expect(response.status()).toBe(409);
   257→
   258→      const body = await response.json();
   259→      // AC: @api-contract ac-24 — must have error, current, valid_transitions
   260→      expect(body).toHaveProperty('error');
   261→      expect(body.error).toBe('invalid_transition');
   262→      expect(body).toHaveProperty('current');
   263→      expect(typeof body.current).toBe('string');
   264→      expect(body).toHaveProperty('valid_transitions');
   265→      expect(Array.isArray(body.valid_transitions)).toBe(true);
   266→    });
   267→
   268→    // AC: @api-contract ac-24
   269→    test('POST /api/tasks/:ref/start on completed task returns 409 with valid_transitions array', async ({
   270→      request,
   271→      daemon,
   272→    }) => {
   273→      // test-task-completed is in completed state — cannot be started
   274→      const response = await request.post(
   275→        `${DAEMON_URL}/api/tasks/@test-task-completed/start`,
   276→        { data: {} }
   277→      );
   278→
   279→      expect(response.status()).toBe(409);
   280→
   281→      const body = await response.json();
   282→      expect(body).toHaveProperty('error');
   283→      expect(body.error).toBe('invalid_transition');
   284→      expect(body).toHaveProperty('current');
   285→      expect(body.current).toBe('completed');
   286→      expect(body).toHaveProperty('valid_transitions');
   287→      expect(Array.isArray(body.valid_transitions)).toBe(true);
   288→    });
   289→
   290→    // AC: @api-contract ac-24 — current field shows actual state
   291→    test('409 current field reflects the actual task state', async ({ request, daemon }) => {
   292→      // in_progress task — trying to start it again
   293→      const response = await request.post(
   294→        `${DAEMON_URL}/api/tasks/@test-task-in-progress/start`,
   295→        { data: {} }
   296→      );
   297→
   298→      expect(response.status()).toBe(409);
   299→
   300→      const body = await response.json();
   301→      // current should be in_progress (the actual state)
   302→      expect(body.current).toBe('in_progress');
   303→    });
   304→
   305→    // AC: @api-contract ac-24 — valid_transitions guides next steps
   306→    test('409 valid_transitions includes allowed state transitions', async ({
   307→      request,
   308→      daemon,
   309→    }) => {
   310→      // test-task-in-progress: already in_progress
   311→      const response = await request.post(
   312→        `${DAEMON_URL}/api/tasks/@test-task-in-progress/start`,
   313→        { data: {} }
   314→      );
   315→
   316→      expect(response.status()).toBe(409);
   317→
   318→      const body = await response.json();
   319→      expect(Array.isArray(body.valid_transitions)).toBe(true);
   320→      // from in_progress, valid transitions are pending_review, blocked, cancelled
   321→      expect(body.valid_transitions.length).toBeGreaterThan(0);
   322→      // Should not include 'in_progress' itself (can't transition to same state)
   323→      expect(body.valid_transitions).not.toContain('in_progress');
   324→    });
   325→  });
   326→
   327→  test.describe('Error response consistency across endpoints', () => {
   328→    // AC: @api-contract ac-22 — consistent 404 shape across all endpoints
   329→    test('all 404 responses have consistent error/message/suggestion shape', async ({
   330→      request,
   331→      daemon,
   332→    }) => {
   333→      const endpoints = [
   334→        { method: 'GET', url: `${DAEMON_URL}/api/tasks/@nonexistent-xyz` },
   335→        { method: 'GET', url: `${DAEMON_URL}/api/items/@nonexistent-xyz` },
   336→      ];
   337→
   338→      for (const endpoint of endpoints) {
   339→        const response =
   340→          endpoint.method === 'GET'
   341→            ? await request.get(endpoint.url)
   342→            : await request.post(endpoint.url, { data: {} });
   343→
   344→        expect(response.status(), `Expected 404 for ${endpoint.url}`).toBe(404);
   345→
   346→        const body = await response.json();
   347→        expect(body, `Missing 'error' field for ${endpoint.url}`).toHaveProperty('error');
   348→        expect(body, `Missing 'message' field for ${endpoint.url}`).toHaveProperty('message');
   349→        expect(body, `Missing 'suggestion' field for ${endpoint.url}`).toHaveProperty(
   350→          'suggestion'
   351→        );
   352→      }
   353→    });
   354→
   355→    // AC: @api-contract ac-22 — 404 content type is JSON
   356→    test('404 responses return JSON content type', async ({ request, daemon }) => {
   357→      const response = await request.get(`${DAEMON_URL}/api/tasks/@nonexistent-ref-xyz`);
   358→
   359→      expect(response.status()).toBe(404);
   360→
   361→      const contentType = response.headers()['content-type'] || '';
   362→      expect(contentType).toContain('application/json');
   363→    });
   364→  });
   365→});
