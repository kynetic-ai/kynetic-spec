   703→
   704→  test.describe('Upsert correctness', () => {
   705→    // AC: @triage-daemon-api ac-3 — upsert on inbox_ref (one record per inbox item)
   706→    test('second POST for same inbox item updates existing record (upsert)', async ({
   707→      request,
   708→      daemon,
   709→    }) => {
   710→      // Create fresh inbox item
   711→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   712→        data: { text: `Upsert test ${Date.now()}` },
   713→      });
   714→      expect(inboxResponse.status()).toBe(200);
   715→      const inbox = await inboxResponse.json();
   716→      const inboxUlid = inbox.item._ulid;
   717→
   718→      // First triage — defer
   719→      const firstResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   720→        data: {
   721→          inbox_ref: `@${inboxUlid}`,
   722→          action: 'defer',
   723→          reasoning: 'First decision',
   724→        },
   725→      });
   726→      expect(firstResponse.status()).toBe(200);
   727→      const firstBody = await firstResponse.json();
   728→      const firstUlid = firstBody.record._ulid;
   729→
   730→      // Second triage — spec-gap (should upsert, same ULID)
   731→      const secondResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   732→        data: {
   733→          inbox_ref: `@${inboxUlid}`,
   734→          action: 'spec-gap',
   735→          reasoning: 'Changed mind',
   736→        },
   737→      });
   738→      expect(secondResponse.status()).toBe(200);
   739→      const secondBody = await secondResponse.json();
   740→
   741→      // Same ULID (upsert, not duplicate)
   742→      expect(secondBody.record._ulid).toBe(firstUlid);
   743→      expect(secondBody.record.action).toBe('spec-gap');
   744→
   745→      // Only 1 record for this inbox item
   746→      const listResponse = await request.get(`${DAEMON_URL}/api/triage`);
   747→      const list = await listResponse.json();
   748→      const recordsForItem = list.items.filter(
   749→        (r: { inbox_ref: string }) => r.inbox_ref === inboxUlid
   750→      );
   751→      expect(recordsForItem.length).toBe(1);
   752→    });
   753→  });
   754→});
