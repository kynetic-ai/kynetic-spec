   559→  test.describe('POST /api/triage/:ref/act', () => {
   560→    // AC: @triage-daemon-api ac-5 — execute action on triaged record
   561→    test('executes action and transitions record to acted_on', async ({ request, daemon }) => {
   562→      // First create a fresh inbox item and triage record in 'triaged' status
   563→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   564→        data: { text: `Act test item ${Date.now()}` },
   565→      });
   566→      expect(inboxResponse.status()).toBe(200);
   567→      const inbox = await inboxResponse.json();
   568→
   569→      // Create triage record
   570→      const triageResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   571→        data: {
   572→          inbox_ref: `@${inbox.item._ulid}`,
   573→          action: 'delete',
   574→          reasoning: 'This item is stale and should be deleted',
   575→        },
   576→      });
   577→      expect(triageResponse.status()).toBe(200);
   578→      const triage = await triageResponse.json();
   579→      const triageRef = triage.record._ulid;
   580→
   581→      // Act on it (delete action — removes the inbox item)
   582→      const actResponse = await request.post(
   583→        `${DAEMON_URL}/api/triage/@${triageRef}/act`
   584→      );
   585→
   586→      expect(actResponse.status()).toBe(200);
   587→
   588→      const body = await actResponse.json();
   589→      expect(body.success).toBe(true);
   590→      expect(body.record.status).toBe('acted_on');
   591→      expect(body.record).toHaveProperty('acted_at');
   592→    });
   593→
   594→    // AC: @triage-daemon-api ac-5 — defer action
   595→    test('executes defer action successfully', async ({ request, daemon }) => {
   596→      // Create a fresh inbox item + triage record for defer action
   597→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   598→        data: { text: `Defer act test ${Date.now()}` },
   599→      });
   600→      expect(inboxResponse.status()).toBe(200);
   601→      const inbox = await inboxResponse.json();
   602→
   603→      const triageResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   604→        data: {
   605→          inbox_ref: `@${inbox.item._ulid}`,
   606→          action: 'defer',
   607→          reasoning: 'Not now',
   608→        },
   609→      });
   610→      expect(triageResponse.status()).toBe(200);
   611→      const triage = await triageResponse.json();
   612→
   613→      const actResponse = await request.post(
   614→        `${DAEMON_URL}/api/triage/@${triage.record._ulid}/act`
   615→      );
   616→
   617→      expect(actResponse.status()).toBe(200);
   618→      const body = await actResponse.json();
   619→      expect(body.record.status).toBe('acted_on');
   620→      expect(body.record.action).toBe('defer');
   621→    });
   622→
   623→    // AC: @triage-daemon-api ac-5 — acted record appears updated in list
   624→    test('acted record status appears as acted_on in GET /api/triage', async ({
   625→      request,
   626→      daemon,
   627→    }) => {
   628→      // Create fresh inbox item + triage + act
   629→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   630→        data: { text: `List verification act ${Date.now()}` },
   631→      });
   632→      const inbox = await inboxResponse.json();
   633→
   634→      const triageResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   635→        data: {
   636→          inbox_ref: `@${inbox.item._ulid}`,
   637→          action: 'defer',
   638→          reasoning: 'Defer',
   639→        },
   640→      });
   641→      const triage = await triageResponse.json();
   642→
   643→      await request.post(`${DAEMON_URL}/api/triage/@${triage.record._ulid}/act`);
   644→
   645→      // Verify the list reflects acted_on status
   646→      const listResponse = await request.get(
   647→        `${DAEMON_URL}/api/triage?status=acted_on`
   648→      );
   649→      const list = await listResponse.json();
   650→      const found = list.items.find((r: { _ulid: string }) => r._ulid === triage.record._ulid);
   651→      expect(found).toBeDefined();
   652→      expect(found.status).toBe('acted_on');
   653→    });
   654→
   655→    // AC: @triage-daemon-api ac-8 — 409 for already acted_on record
   656→    test('returns 409 when acting on already acted_on record', async ({ request, daemon }) => {
   657→      const response = await request.post(
   658→        `${DAEMON_URL}/api/triage/@${FIXTURE_TRIAGE_ACTED_ULID}/act`
   659→      );
