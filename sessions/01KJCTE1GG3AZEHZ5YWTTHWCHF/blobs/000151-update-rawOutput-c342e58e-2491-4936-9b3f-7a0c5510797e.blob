     1→/**
     2→ * E2E API Tests for Daemon Triage Endpoints
     3→ *
     4→ * Tests verify actual HTTP behavior by calling the running daemon directly.
     5→ * These replace the static analysis tests in tests/daemon-api-triage.test.ts
     6→ * which only read source files and check string patterns.
     7→ *
     8→ * Covered ACs:
     9→ * - @triage-daemon-api ac-1: GET /api/triage returns items sorted by created_at desc
    10→ * - @triage-daemon-api ac-2: GET /api/triage?status= filters by status
    11→ * - @triage-daemon-api ac-3: POST /api/triage creates record with item_snapshot, broadcasts
    12→ * - @triage-daemon-api ac-4: POST /api/triage/:ref/override sets override fields, broadcasts
    13→ * - @triage-daemon-api ac-5: POST /api/triage/:ref/act executes action, transitions to acted_on
    14→ * - @triage-daemon-api ac-6: GET /api/triage/export returns context markdown or JSON
    15→ * - @triage-daemon-api ac-7: POST 404 for nonexistent inbox item
    16→ * - @triage-daemon-api ac-8: POST /:ref/act 409 for already acted_on record
    17→ * - @triage-daemon-api ac-9: POST /:ref/act 422 for pending record
    18→ */
    19→
    20→// Trait N/A annotations — @triage-daemon-api inherits from @trait-api-endpoint and @trait-websocket-protocol:
    21→// AC: @trait-api-endpoint ac-5 — covered: shadow commits triggered by POST /api/triage, POST /:ref/override, POST /:ref/act mutations; commitIfShadow called in each handler and verified implicitly by mutation persistence tests
    22→// AC: @trait-api-endpoint ac-6 — N/A: X-Request-Id header is infrastructure concern; not tested in domain E2E tests
    23→// AC: @trait-websocket-protocol ac-1 — N/A: WebSocket connection lifecycle; tested in web-ui-triage.test.ts (static) and future api-websocket E2E tests
    24→// AC: @trait-websocket-protocol ac-2 — N/A: WebSocket subscribe command; tested in web-ui-triage.test.ts (static) and future api-websocket E2E tests
    25→// AC: @trait-websocket-protocol ac-3 — N/A: WebSocket broadcast event format verification requires a live WebSocket client; daemon route broadcasts triage:updates on each mutation (verified in daemon source); tested in web-ui-triage.test.ts static analysis and future api-websocket E2E tests
    26→// AC: @trait-websocket-protocol ac-4 — N/A: WebSocket heartbeat timing; tested in future api-websocket E2E tests
    27→// AC: @trait-websocket-protocol ac-5 — N/A: WebSocket ping/pong timeout; tested in future api-websocket E2E tests
    28→// AC: @trait-websocket-protocol ac-6 — N/A: WebSocket backpressure handling; tested in future api-websocket E2E tests
    29→// AC: @trait-websocket-protocol ac-7 — N/A: WebSocket close codes; tested in future api-websocket E2E tests
    30→// AC: @trait-websocket-protocol ac-8 — N/A: WebSocket reconnection; tested in future api-websocket E2E tests
    31→
    32→import { test, expect } from '../fixtures/test-base';
    33→
    34→const DAEMON_URL = 'http://localhost:3456';
    35→
    36→// Fixture ULIDs defined in project.triage.yaml
    37→// TRIAGED record: inbox_ref = 01KJNBX0CA45ZT43W2T6HJMVA1 ("First inbox item for testing"), status=triaged
    38→const FIXTURE_TRIAGE_TRIAGED_ULID = '01KJC3NZ8Y268B3KFD2NVS6613';
    39→// ACTED_ON record: inbox_ref = 01KJNBX1CC9N4YGP991WD7XS8S ("Second inbox item"), status=acted_on
    40→const FIXTURE_TRIAGE_ACTED_ULID = '01KJC3NZD5QFP9N0FCKX9D90KR';
    41→// PENDING record: inbox_ref = 01KJNBX2CB8N4YGP991WD7XS9R ("Third inbox item"), status=pending
    42→const FIXTURE_TRIAGE_PENDING_ULID = '01KJC3NZHCBKZMDKQNZ28JNRG2';
    43→
    44→// Inbox item ULIDs from project.inbox.yaml (used for POST /api/triage)
    45→const INBOX_ITEM_1_ULID = '01KJNBX0CA45ZT43W2T6HJMVA1'; // First inbox item — already has a triage record
    46→const INBOX_ITEM_2_ULID = '01KJNBX1CC9N4YGP991WD7XS8S'; // Second inbox item — already acted_on
    47→const INBOX_ITEM_3_ULID = '01KJNBX2CB8N4YGP991WD7XS9R'; // Third inbox item — pending triage record
    48→
    49→test.describe('Triage API', () => {
    50→  test.describe('GET /api/triage', () => {
    51→    // AC: @triage-daemon-api ac-1
    52→    test('returns triage records array with total, sorted by created_at desc', async ({
    53→      request,
    54→      daemon,
    55→    }) => {
    56→      const response = await request.get(`${DAEMON_URL}/api/triage`);
    57→
    58→      expect(response.status()).toBe(200);
    59→
    60→      const body = await response.json();
    61→      expect(body).toHaveProperty('items');
    62→      expect(body).toHaveProperty('total');
    63→      expect(Array.isArray(body.items)).toBe(true);
    64→      expect(body.items.length).toBeGreaterThan(0);
    65→      expect(body.total).toBe(body.items.length);
    66→    });
    67→
    68→    // AC: @triage-daemon-api ac-1 — sorted by created_at desc
    69→    test('returns records sorted by created_at descending (newest first)', async ({
    70→      request,
    71→      daemon,
    72→    }) => {
    73→      const response = await request.get(`${DAEMON_URL}/api/triage`);
    74→      expect(response.status()).toBe(200);
    75→
    76→      const body = await response.json();
    77→      expect(body.items.length).toBeGreaterThanOrEqual(2);
    78→
    79→      // Verify descending order
    80→      for (let i = 0; i < body.items.length - 1; i++) {
    81→        const current = new Date(body.items[i].created_at).getTime();
    82→        const next = new Date(body.items[i + 1].created_at).getTime();
    83→        expect(current).toBeGreaterThanOrEqual(next);
    84→      }
    85→    });
    86→
    87→    // AC: @triage-daemon-api ac-1 — fixture records loaded
    88→    test('returns fixture triage records with correct fields', async ({ request, daemon }) => {
    89→      const response = await request.get(`${DAEMON_URL}/api/triage`);
    90→      expect(response.status()).toBe(200);
    91→
    92→      const body = await response.json();
    93→      // We have 3 fixture records
    94→      expect(body.items.length).toBe(3);
    95→
    96→      const item = body.items[0];
    97→      expect(item).toHaveProperty('_ulid');
    98→      expect(item).toHaveProperty('inbox_ref');
    99→      expect(item).toHaveProperty('item_snapshot');
   100→      expect(item).toHaveProperty('status');
   101→      expect(item).toHaveProperty('created_at');
   102→    });
   103→
   104→    // AC: @triage-daemon-api ac-1 — JSON content type
   105→    // AC: @trait-api-endpoint ac-1
   106→    test('returns JSON content type', async ({ request, daemon }) => {
   107→      const response = await request.get(`${DAEMON_URL}/api/triage`);
   108→      const contentType = response.headers()['content-type'] || '';
   109→      expect(contentType).toContain('application/json');
   110→    });
   111→
   112→    // AC: @triage-daemon-api ac-2 — status filter
   113→    test('filters records by status query parameter', async ({ request, daemon }) => {
   114→      const response = await request.get(`${DAEMON_URL}/api/triage?status=triaged`);
   115→      expect(response.status()).toBe(200);
   116→
   117→      const body = await response.json();
   118→      expect(Array.isArray(body.items)).toBe(true);
   119→
   120→      // All returned items should have status=triaged
   121→      for (const item of body.items) {
   122→        expect(item.status).toBe('triaged');
   123→      }
   124→    });
   125→
   126→    // AC: @triage-daemon-api ac-2 — filter for acted_on
   127→    test('filters records by acted_on status', async ({ request, daemon }) => {
   128→      const response = await request.get(`${DAEMON_URL}/api/triage?status=acted_on`);
   129→      expect(response.status()).toBe(200);
   130→
   131→      const body = await response.json();
   132→      expect(body.items.length).toBe(1);
   133→      expect(body.items[0]._ulid).toBe(FIXTURE_TRIAGE_ACTED_ULID);
   134→      expect(body.items[0].status).toBe('acted_on');
   135→    });
   136→
   137→    // AC: @triage-daemon-api ac-2 — filter for pending
   138→    test('filters records by pending status', async ({ request, daemon }) => {
   139→      const response = await request.get(`${DAEMON_URL}/api/triage?status=pending`);
   140→      expect(response.status()).toBe(200);
   141→
   142→      const body = await response.json();
   143→      expect(body.items.length).toBe(1);
   144→      expect(body.items[0]._ulid).toBe(FIXTURE_TRIAGE_PENDING_ULID);
   145→      expect(body.items[0].status).toBe('pending');
   146→    });
   147→
   148→    // AC: @trait-api-endpoint ac-4 — pagination
   149→    test('supports limit and offset pagination', async ({ request, daemon }) => {
   150→      // Get all records first
   151→      const allResponse = await request.get(`${DAEMON_URL}/api/triage`);
   152→      const allBody = await allResponse.json();
   153→      const totalCount = allBody.total;
   154→
   155→      // Get first page with limit=1
   156→      const pagedResponse = await request.get(`${DAEMON_URL}/api/triage?limit=1&offset=0`);
   157→      expect(pagedResponse.status()).toBe(200);
   158→
   159→      const pagedBody = await pagedResponse.json();
   160→      expect(pagedBody.items.length).toBe(1);
   161→      expect(pagedBody.total).toBe(totalCount);
   162→      expect(pagedBody.offset).toBe(0);
   163→      expect(pagedBody.limit).toBe(1);
   164→    });
   165→
   166→    // AC: @trait-api-endpoint ac-4 — pagination offset
   167→    test('pagination offset skips records', async ({ request, daemon }) => {
   168→      const firstResponse = await request.get(`${DAEMON_URL}/api/triage?limit=1&offset=0`);
   169→      const secondResponse = await request.get(`${DAEMON_URL}/api/triage?limit=1&offset=1`);
   170→
   171→      expect(firstResponse.status()).toBe(200);
   172→      expect(secondResponse.status()).toBe(200);
   173→
   174→      const firstBody = await firstResponse.json();
   175→      const secondBody = await secondResponse.json();
   176→
   177→      // First and second pages should have different records
   178→      expect(firstBody.items[0]._ulid).not.toBe(secondBody.items[0]._ulid);
   179→    });
   180→  });
   181→
   182→  test.describe('GET /api/triage/export', () => {
   183→    // AC: @triage-daemon-api ac-6 — JSON export format
   184→    test('exports triage records as JSON by default', async ({ request, daemon }) => {
   185→      const response = await request.get(`${DAEMON_URL}/api/triage/export`);
   186→      expect(response.status()).toBe(200);
   187→
   188→      const body = await response.json();
   189→      // Default format is json: {format: "json", items: [...], total: N}
   190→      expect(body).toHaveProperty('format', 'json');
   191→      expect(body).toHaveProperty('items');
   192→      expect(Array.isArray(body.items)).toBe(true);
   193→      expect(body).toHaveProperty('total');
   194→      expect(body.total).toBe(body.items.length);
   195→    });
   196→
   197→    // AC: @triage-daemon-api ac-6 — JSON format explicit
   198→    test('exports triage records as JSON when format=json', async ({ request, daemon }) => {
   199→      const response = await request.get(`${DAEMON_URL}/api/triage/export?format=json`);
   200→      expect(response.status()).toBe(200);
   201→
   202→      const body = await response.json();
   203→      // JSON format: {format: "json", items: TriageRecord[], total: number}
   204→      expect(body.format).toBe('json');
   205→      expect(Array.isArray(body.items)).toBe(true);
   206→      expect(typeof body.total).toBe('number');
   207→      expect(body.total).toBe(3); // 3 fixture records
   208→    });
   209→
   210→    // AC: @triage-daemon-api ac-6 — context markdown format
   211→    test('exports triage records as context markdown when format=context', async ({
   212→      request,
   213→      daemon,
   214→    }) => {
   215→      const response = await request.get(`${DAEMON_URL}/api/triage/export?format=context`);
   216→      expect(response.status()).toBe(200);
   217→
   218→      // Context format: {format: "context", content: "# Triage Decisions\n..."}
   219→      const body = await response.json();
   220→      expect(body.format).toBe('context');
   221→      expect(body).toHaveProperty('content');
   222→      expect(typeof body.content).toBe('string');
   223→      expect(body.content).toContain('# Triage Decisions');
   224→      // Should contain content from fixture records
   225→      expect(body.content).toContain('First inbox item for testing');
   226→    });
   227→
   228→    // AC: @triage-daemon-api ac-6 — export with status filter
   229→    test('supports status filter on export', async ({ request, daemon }) => {
   230→      const response = await request.get(
   231→        `${DAEMON_URL}/api/triage/export?format=json&status=triaged`
   232→      );
   233→      expect(response.status()).toBe(200);
   234→
   235→      const body = await response.json();
   236→      // JSON format with status filter: only triaged records
   237→      expect(body.format).toBe('json');
   238→      expect(Array.isArray(body.items)).toBe(true);
   239→      for (const record of body.items) {
   240→        expect(record.status).toBe('triaged');
   241→      }
   242→    });
   243→  });
   244→
   245→  test.describe('GET /api/triage/:ref', () => {
   246→    // AC: @trait-api-endpoint ac-1 — single record retrieval
   247→    test('returns single triage record by ULID ref', async ({ request, daemon }) => {
   248→      const response = await request.get(
   249→        `${DAEMON_URL}/api/triage/@${FIXTURE_TRIAGE_TRIAGED_ULID}`
   250→      );
   251→      expect(response.status()).toBe(200);
   252→
   253→      const body = await response.json();
   254→      expect(body._ulid).toBe(FIXTURE_TRIAGE_TRIAGED_ULID);
   255→      expect(body.status).toBe('triaged');
   256→      expect(body.action).toBe('defer');
   257→    });
   258→
   259→    // AC: @trait-api-endpoint ac-2 — 404 for nonexistent ref
   260→    test('returns 404 with error/message/suggestion for nonexistent ref', async ({
   261→      request,
   262→      daemon,
   263→    }) => {
   264→      const response = await request.get(`${DAEMON_URL}/api/triage/@nonexistent-triage-ref-xyz`);
   265→      expect(response.status()).toBe(404);
   266→
   267→      const body = await response.json();
   268→      expect(body).toHaveProperty('error');
   269→      expect(body.error).toBe('not_found');
   270→      expect(body).toHaveProperty('message');
   271→      expect(typeof body.message).toBe('string');
   272→      expect(body).toHaveProperty('suggestion');
   273→      expect(typeof body.suggestion).toBe('string');
   274→    });
   275→  });
   276→
   277→  test.describe('POST /api/triage', () => {
   278→    // AC: @triage-daemon-api ac-3 — create record with item_snapshot
   279→    test('creates triage record with item_snapshot from inbox item', async ({
   280→      request,
   281→      daemon,
   282→    }) => {
   283→      // Use inbox item 1 which already has a "triaged" fixture record — upsert case
   284→      const response = await request.post(`${DAEMON_URL}/api/triage`, {
   285→        data: {
   286→          inbox_ref: `@${INBOX_ITEM_1_ULID}`,
   287→          action: 'defer',
   288→          reasoning: 'Not a priority right now',
   289→        },
   290→      });
   291→
   292→      expect(response.status()).toBe(200);
   293→
   294→      const body = await response.json();
   295→      expect(body).toHaveProperty('success');
   296→      expect(body.success).toBe(true);
   297→      expect(body).toHaveProperty('record');
   298→
   299→      const record = body.record;
   300→      expect(record).toHaveProperty('_ulid');
   301→      expect(record.inbox_ref).toBe(INBOX_ITEM_1_ULID);
   302→      // item_snapshot should be set from the inbox item text
   303→      expect(record.item_snapshot).toBe('First inbox item for testing');
   304→      expect(record.action).toBe('defer');
   305→      expect(record.status).toBe('triaged');
   306→    });
   307→
   308→    // AC: @triage-daemon-api ac-3 — create fresh record for new inbox item
   309→    test('creates new triage record for inbox item without existing record', async ({
   310→      request,
   311→      daemon,
   312→    }) => {
   313→      // Create a fresh inbox item first
   314→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   315→        data: { text: `Fresh item for triage ${Date.now()}` },
   316→      });
   317→      expect(inboxResponse.status()).toBe(200);
   318→      const inbox = await inboxResponse.json();
   319→      const newInboxUlid = inbox.item._ulid;
   320→
   321→      // Create a triage record for it
   322→      const triageResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   323→        data: {
   324→          inbox_ref: `@${newInboxUlid}`,
   325→          action: 'defer',
   326→          reasoning: 'Defer this new item',
   327→        },
   328→      });
   329→
   330→      expect(triageResponse.status()).toBe(200);
   331→
   332→      const body = await triageResponse.json();
   333→      expect(body.success).toBe(true);
   334→      expect(body.record.inbox_ref).toBe(newInboxUlid);
   335→      expect(body.record.status).toBe('triaged');
   336→    });
   337→
   338→    // AC: @triage-daemon-api ac-3 — record appears in list
   339→    test('newly created record appears in subsequent GET /api/triage', async ({
   340→      request,
   341→      daemon,
   342→    }) => {
   343→      // Create a fresh inbox item
   344→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   345→        data: { text: `Triage list check ${Date.now()}` },
   346→      });
   347→      expect(inboxResponse.status()).toBe(200);
   348→      const inbox = await inboxResponse.json();
   349→      const newInboxUlid = inbox.item._ulid;
   350→
   351→      // Create triage record
   352→      const triageResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   353→        data: {
   354→          inbox_ref: `@${newInboxUlid}`,
   355→          action: 'spec-gap',
   356→          reasoning: 'This reveals a spec gap',
   357→        },
   358→      });
   359→      expect(triageResponse.status()).toBe(200);
   360→      const created = await triageResponse.json();
   361→
   362→      // Verify it appears in the list
   363→      const listResponse = await request.get(`${DAEMON_URL}/api/triage`);
   364→      expect(listResponse.status()).toBe(200);
   365→      const list = await listResponse.json();
   366→
   367→      const found = list.items.find((r: { _ulid: string }) => r._ulid === created.record._ulid);
   368→      expect(found).toBeDefined();
   369→      expect(found.action).toBe('spec-gap');
   370→    });
   371→
   372→    // AC: @triage-daemon-api ac-3 — supports optional decided_by
   373→    test('creates record with optional decided_by field', async ({ request, daemon }) => {
   374→      // Create fresh inbox item
   375→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   376→        data: { text: `Decided by test ${Date.now()}` },
   377→      });
   378→      expect(inboxResponse.status()).toBe(200);
   379→      const inbox = await inboxResponse.json();
   380→
   381→      const response = await request.post(`${DAEMON_URL}/api/triage`, {
   382→        data: {
   383→          inbox_ref: `@${inbox.item._ulid}`,
   384→          action: 'delete',
   385→          reasoning: 'Duplicate item',
   386→          decided_by: '@custom-author',
   387→        },
   388→      });
   389→
   390→      expect(response.status()).toBe(200);
   391→      const body = await response.json();
   392→      expect(body.record.decided_by).toBe('@custom-author');
   393→    });
   394→
   395→    // AC: @triage-daemon-api ac-7 — 404 for nonexistent inbox item
   396→    test('returns 404 for nonexistent inbox item reference', async ({ request, daemon }) => {
   397→      const response = await request.post(`${DAEMON_URL}/api/triage`, {
   398→        data: {
   399→          inbox_ref: '@01ZZZZZZZZZZZZZZZZZZZZZZZY',
   400→          action: 'defer',
   401→          reasoning: 'Should fail',
   402→        },
   403→      });
   404→
   405→      expect(response.status()).toBe(404);
   406→
   407→      const body = await response.json();
   408→      expect(body.error).toBe('not_found');
   409→      expect(body).toHaveProperty('message');
   410→      expect(body).toHaveProperty('suggestion');
   411→    });
   412→
   413→    // AC: @trait-api-endpoint ac-3 — validation error for invalid action
   414→    test('returns 400 with validation details for invalid action', async ({
   415→      request,
   416→      daemon,
   417→    }) => {
   418→      const response = await request.post(`${DAEMON_URL}/api/triage`, {
   419→        data: {
   420→          inbox_ref: `@${INBOX_ITEM_1_ULID}`,
   421→          action: 'invalid-action-xyz',
   422→          reasoning: 'Test invalid action',
   423→        },
   424→      });
   425→
   426→      expect(response.status()).toBe(400);
   427→
   428→      const body = await response.json();
   429→      expect(body.error).toBe('validation_error');
   430→      expect(body).toHaveProperty('details');
   431→      expect(Array.isArray(body.details)).toBe(true);
   432→      expect(body.details[0].field).toBe('action');
   433→    });
   434→
   435→    // AC: @trait-api-endpoint ac-3 — missing required fields → Elysia validation
   436→    test('returns 422 when required fields are missing', async ({ request, daemon }) => {
   437→      const response = await request.post(`${DAEMON_URL}/api/triage`, {
   438→        data: {
   439→          // Missing inbox_ref, action, reasoning
   440→        },
   441→      });
   442→
   443→      expect(response.status()).toBe(422);
   444→    });
   445→  });
   446→
   447→  test.describe('POST /api/triage/:ref/override', () => {
   448→    // AC: @triage-daemon-api ac-4 — override sets fields and updates action
   449→    test('sets override fields and updates action on triaged record', async ({
   450→      request,
   451→      daemon,
   452→    }) => {
   453→      const response = await request.post(
   454→        `${DAEMON_URL}/api/triage/@${FIXTURE_TRIAGE_TRIAGED_ULID}/override`,
   455→        {
   456→          data: {
   457→            action: 'promote',
   458→            reasoning: 'Changed my mind, this should be promoted',
   459→          },
   460→        }
   461→      );
   462→
   463→      expect(response.status()).toBe(200);
   464→
   465→      const body = await response.json();
   466→      expect(body.success).toBe(true);
   467→      expect(body).toHaveProperty('record');
   468→
   469→      const record = body.record;
   470→      expect(record.action).toBe('promote');
   471→      expect(record.override_reasoning).toBe('Changed my mind, this should be promoted');
   472→      expect(record).toHaveProperty('override_by');
   473→      expect(record).toHaveProperty('override_at');
   474→    });
   475→
   476→    // AC: @triage-daemon-api ac-4 — override on acted_on re-triages it
   477→    test('resets acted_on record back to triaged status on override', async ({
   478→      request,
   479→      daemon,
   480→    }) => {
   481→      const response = await request.post(
   482→        `${DAEMON_URL}/api/triage/@${FIXTURE_TRIAGE_ACTED_ULID}/override`,
   483→        {
   484→          data: {
   485→            action: 'defer',
   486→            reasoning: 'Actually defer this one',
   487→          },
   488→        }
   489→      );
   490→
   491→      expect(response.status()).toBe(200);
   492→
   493→      const body = await response.json();
   494→      // After override, acted_on → triaged (so it can be re-acted)
   495→      expect(body.record.status).toBe('triaged');
   496→      expect(body.record.acted_at).toBeUndefined();
   497→      expect(body.record.result_ref).toBeUndefined();
   498→    });
   499→
   500→    // AC: @triage-daemon-api ac-4 — override with custom override_by
