```
     1→/**
     2→ * Enhanced setup command for kspec agent integration.
     3→ *
     4→ * Orchestrates the full onboarding pipeline:
     5→ * - Detect agent environment (Claude Code, Cline, etc.)
     6→ * - Install hooks (UserPromptSubmit, Stop, PreToolUse guards)
     7→ * - Render skills from .kspec/skills/ to .claude/skills/
     8→ * - Generate kspec-agents.md
     9→ *
    10→ * AC: @enhanced-setup ac-1 - summary displayed listing each step performed
    11→ * AC: @enhanced-setup ac-2 - all hook entries (UserPromptSubmit, Stop, PreToolUse) present
    12→ * AC: @enhanced-setup ac-3 - rendered skill files exist for each skill targeting claude-code
    13→ * AC: @enhanced-setup ac-4 - kspec-agents.md exists after setup
    14→ * AC: @enhanced-setup ac-5 - --skip-skills flag skips skill rendering
    15→ * AC: @enhanced-setup ac-6 - --dry-run displays planned actions without changes
    16→ * AC: @enhanced-setup ac-7 - --status reports current state including agent detected
    17→ * AC: @enhanced-setup ac-8 - --status shows hooks status, skills rendered count, agents.md freshness
    18→ * AC: @enhanced-setup ac-9 - skills referenced by ralph (task-work, reflect) are present
    19→ */
    20→
    21→import * as fs from "node:fs/promises";
    22→import { existsSync } from "node:fs";
    23→import * as os from "node:os";
    24→import * as path from "node:path";
    25→import * as readline from "node:readline/promises";
    26→import chalk from "chalk";
    27→import type { Command } from "commander";
    28→import {
    29→  getGitRoot,
    30→  getShadowStatus,
    31→  repairShadow,
    32→  SHADOW_BRANCH_NAME,
    33→} from "../../parser/shadow.js";
    34→import {
    35→  detectAgentFromEnv,
    36→  type AgentConfidence,
    37→} from "../../parser/agent-detection.js";
    38→import { errors } from "../../strings/index.js";
    39→import { EXIT_CODES } from "../exit-codes.js";
    40→import { error, output, success, warn } from "../output.js";
    41→
    42→/**
    43→ * Log a message at debug level (only when KSPEC_DEBUG=1)
    44→ * AC: @setup-pipeline-unification ac-4
    45→ */
    46→function debugLog(message: string, detail?: unknown): void {
    47→  if (process.env.KSPEC_DEBUG === "1") {
    48→    if (detail) {
    49→      console.error(`[DEBUG] setup: ${message}`, detail);
    50→    } else {
    51→      console.error(`[DEBUG] setup: ${message}`);
    52→    }
    53→  }
    54→}
    55→
    56→/**
    57→ * Supported agent types for auto-configuration
    58→ */
    59→export type AgentType =
    60→  | "claude-code"
    61→  | "cline"
    62→  | "roo-code"
    63→  | "copilot-cli"
    64→  | "gemini-cli"
    65→  | "codex-cli"
    66→  | "aider"
    67→  | "opencode"
    68→  | "amp"
    69→  | "cursor"
    70→  | "windsurf"
    71→  | "unknown";
    72→
    73→/**
    74→ * Result of agent detection
    75→ */
    76→export interface DetectedAgent {
    77→  type: AgentType;
    78→  confidence: AgentConfidence;
    79→  configPath?: string;
    80→  envVars?: Record<string, string>;
    81→}
    82→
    83→const SETUP_AGENT_OVERRIDES = [
    84→  "claude-code",
    85→  "cline",
    86→  "cursor",
    87→  "windsurf",
    88→  "unknown",
    89→] as const;
    90→
    91→type SetupAgentOverride = (typeof SETUP_AGENT_OVERRIDES)[number];
    92→
    93→function parseSetupAgentOverride(value: string): SetupAgentOverride {
    94→  const normalized = value.trim().toLowerCase();
    95→  if (
    96→    (SETUP_AGENT_OVERRIDES as readonly string[]).includes(normalized)
    97→  ) {
    98→    return normalized as SetupAgentOverride;
    99→  }
   100→
   101→  const allowed = SETUP_AGENT_OVERRIDES.join(", ");
   102→  throw new Error(
   103→    `Invalid --agent value "${value}". Supported values: ${allowed}`,
   104→  );
   105→}
   106→
   107→function buildDetectedAgent(type: AgentType): DetectedAgent {
   108→  if (type === "claude-code") {
   109→    return {
   110→      type,
   111→      confidence: "high",
   112→      configPath: path.join(os.homedir(), ".claude", "settings.json"),
   113→    };
   114→  }
   115→  return { type, confidence: "high" };
   116→}
   117→
   118→/**
   119→ * Detect which agent environment we're running in.
   120→ * Returns the detected agent type and confidence level.
   121→ *
   122→ * Detection priority matters - more specific markers checked first.
   123→ */
   124→export function detectAgent(): DetectedAgent {
   125→  const detected = detectAgentFromEnv();
   126→  if (detected.type !== "unknown") {
   127→    return detected;
   128→  }
   129→
   130→  // Fallback for non-interactive contexts where env markers may be absent.
   131→  if (existsSync(path.join(os.homedir(), ".claude"))) {
   132→    return {
   133→      type: "claude-code",
   134→      confidence: "low",
   135→      configPath: path.join(os.homedir(), ".claude", "settings.json"),
   136→    };
   137→  }
   138→
   139→  return detected;
   140→}
   141→
   142→/**
   143→ * Install KSPEC_AUTHOR config for Claude Code (global settings)
   144→ */
   145→async function installClaudeCodeConfig(author: string): Promise<boolean> {
   146→  const configPath = path.join(os.homedir(), ".claude", "settings.json");
   147→  const configDir = path.dirname(configPath);
   148→
   149→  try {
   150→    // Ensure directory exists
   151→    await fs.mkdir(configDir, { recursive: true });
   152→
   153→    // Read existing config or start fresh
   154→    let config: Record<string, unknown> = {};
   155→    try {
   156→      const existing = await fs.readFile(configPath, "utf-8");
   157→      config = JSON.parse(existing);
   158→    } catch (err) {
   159→      debugLog("No existing Claude Code config, starting fresh", err);
   160→    }
   161→
   162→    // Merge env settings
   163→    const env = (config.env as Record<string, string>) || {};
   164→    env.KSPEC_AUTHOR = author;
   165→    config.env = env;
   166→
   167→    // Write back
   168→    await fs.writeFile(
   169→      configPath,
   170→      `${JSON.stringify(config, null, 2)}\n`,
   171→      "utf-8",
   172→    );
   173→    return true;
   174→  } catch (err) {
   175→    debugLog("Failed to install Claude Code config", err);
   176→    return false;
   177→  }
   178→}
   179→
   180→/**
   181→ * Result of installing hooks
   182→ * AC: @enhanced-setup ac-2 - tracks all hook types
   183→ */
   184→export interface HooksInstallResult {
   185→  promptCheck: boolean;
   186→  stop: boolean;
   187→  preToolUse: boolean;
   188→  guardsCreated: string[];
   189→}
   190→
   191→/**
   192→ * Native guard command for PreToolUse hooks.
   193→ * Replaces bash shell scripts with `kspec guard worktree`.
   194→ *
   195→ * AC: @native-guard-commands ac-setup-native - references kspec guard worktree
   196→ */
   197→const NATIVE_GUARD_COMMAND = "kspec guard worktree";
   198→
   199→/**
   200→ * Old bash script filenames that should be migrated to native commands.
   201→ * AC: @native-guard-commands ac-migrate-hooks
   202→ */
   203→const OLD_GUARD_SCRIPTS = [
   204→  "kspec-worktree-guard.sh",
   205→  "ralph-task-limit-guard.sh",
   206→];
   207→
   208→/**
   209→ * Install hooks to project-level Claude Code settings (.claude/settings.json)
   210→ * AC: @enhanced-setup ac-2 - all hook entries present
   211→ */
   212→async function installClaudeCodeHooks(
   213→  projectDir: string,
   214→  dryRun = false,
   215→): Promise<HooksInstallResult> {
   216→  const configPath = path.join(projectDir, ".claude", "settings.json");
   217→  const configDir = path.dirname(configPath);
   218→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   219→
   220→  const result: HooksInstallResult = {
   221→    promptCheck: false,
   222→    stop: false,
   223→    preToolUse: false,
   224→    guardsCreated: [],
   225→  };
   226→
   227→  try {
   228→    // Ensure directories exist
   229→    if (!dryRun) {
   230→      await fs.mkdir(configDir, { recursive: true });
   231→      await fs.mkdir(hooksDir, { recursive: true });
   232→    }
   233→
   234→    // Read existing config or start fresh
   235→    let config: Record<string, unknown> = {};
   236→    try {
   237→      const existing = await fs.readFile(configPath, "utf-8");
   238→      config = JSON.parse(existing);
   239→    } catch (err) {
   240→      debugLog("No existing hooks config, starting fresh", err);
   241→    }
   242→
   243→    // Get or create hooks object
   244→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   245→
   246→    // Install UserPromptSubmit hook (spec-first reminder)
   247→    const promptCheckCommand = "kspec session prompt-check";
   248→    const existingPromptHooks = hooks.UserPromptSubmit as
   249→      | Array<{ hooks?: Array<{ command?: string }> }>
   250→      | undefined;
   251→    const promptAlreadyInstalled = existingPromptHooks?.some((entry) =>
   252→      entry.hooks?.some((hook) =>
   253→        hook.command?.includes("session prompt-check"),
   254→      ),
   255→    );
   256→
   257→    if (!promptAlreadyInstalled) {
   258→      hooks.UserPromptSubmit = [
   259→        ...(existingPromptHooks || []),
   260→        {
   261→          hooks: [
   262→            {
   263→              type: "command",
   264→              command: promptCheckCommand,
   265→            },
   266→          ],
   267→        },
   268→      ];
   269→      result.promptCheck = true;
   270→    } else {
   271→      result.promptCheck = true; // Already configured
   272→    }
   273→
   274→    // Install Stop hook (checkpoint)
   275→    const stopHookCommand = "kspec session checkpoint --json";
   276→    const existingStopHooks = hooks.Stop as
   277→      | Array<{ matcher?: string; hooks?: Array<{ command?: string }> }>
   278→      | undefined;
   279→    const stopAlreadyInstalled = existingStopHooks?.some((entry) =>
   280→      entry.hooks?.some((hook) => hook.command?.includes("session checkpoint")),
   281→    );
   282→
   283→    if (!stopAlreadyInstalled) {
   284→      hooks.Stop = [
   285→        ...(existingStopHooks || []),
   286→        {
   287→          matcher: "",
   288→          hooks: [
   289→            {
   290→              type: "command",
   291→              command: stopHookCommand,
   292→            },
   293→          ],
   294→        },
   295→      ];
   296→      result.stop = true;
   297→    } else {
   298→      result.stop = true; // Already configured
   299→    }
   300→
   301→    // AC: @enhanced-setup ac-2 - Install PreToolUse hooks with guards
   302→    // AC: @native-guard-commands ac-setup-native - use native kspec guard worktree
   303→    // AC: @native-guard-commands ac-no-task-limit-hook - no task-limit guard
   304→    // AC: @native-guard-commands ac-migrate-hooks - replace old bash script entries
   305→    // AC: @native-guard-commands ac-idempotent - no duplicate entries
   306→    const existingPreToolUseHooks = hooks.PreToolUse as
   307→      | Array<{ matcher?: string; hooks?: Array<{ type?: string; command?: string }> }>
   308→      | undefined;
   309→
   310→    // Check if native guard command is already installed
   311→    const nativeAlreadyInstalled = existingPreToolUseHooks?.some((entry) =>
   312→      entry.hooks?.some((hook) => hook.command === NATIVE_GUARD_COMMAND),
   313→    );
   314→
   315→    // Check for old bash script entries that need migration
   316→    const hasOldScripts = existingPreToolUseHooks?.some((entry) =>
   317→      entry.hooks?.some((hook) =>
   318→        OLD_GUARD_SCRIPTS.some(
   319→          (name) => hook.command?.includes(name),
   320→        ),
   321→      ),
   322→    );
   323→
   324→    if (hasOldScripts || !nativeAlreadyInstalled) {
   325→      // Remove any PreToolUse entries that reference old bash scripts
   326→      // AC: @native-guard-commands ac-migrate-hooks
   327→      let filteredPreToolUse = (existingPreToolUseHooks || []).map((entry) => ({
   328→        ...entry,
   329→        hooks: entry.hooks?.filter(
   330→          (hook) =>
   331→            !OLD_GUARD_SCRIPTS.some((name) => hook.command?.includes(name)),
   332→        ),
   333→      }));
   334→      // Remove entries with empty hooks arrays
   335→      filteredPreToolUse = filteredPreToolUse.filter(
   336→        (entry) => entry.hooks && entry.hooks.length > 0,
   337→      );
   338→
   339→      // Add native guard command if not already present
   340→      if (!nativeAlreadyInstalled) {
   341→        filteredPreToolUse.push({
   342→          matcher: "Bash",
   343→          hooks: [
   344→            {
   345→              type: "command",
   346→              command: NATIVE_GUARD_COMMAND,
   347→            },
   348→          ],
   349→        });
   350→      }
   351→
   352→      hooks.PreToolUse = filteredPreToolUse;
   353→      result.preToolUse = true;
   354→
   355→      // Delete old bash script files
   356→      // AC: @native-guard-commands ac-migrate-hooks - delete old files
   357→      if (!dryRun) {
   358→        for (const name of OLD_GUARD_SCRIPTS) {
   359→          const scriptPath = path.join(hooksDir, name);
   360→          try {
   361→            await fs.unlink(scriptPath);
   362→            result.guardsCreated.push(`deleted:${name}`);
   363→          } catch (err) {
   364→            debugLog(`Could not delete old guard script ${name}`, err);
   365→          }
   366→        }
   367→      }
   368→    } else {
   369→      result.preToolUse = true; // Already configured with native command
   370→    }
   371→
   372→    config.hooks = hooks;
   373→
   374→    // Write back
   375→    if (!dryRun) {
   376→      await fs.writeFile(
   377→        configPath,
   378→        `${JSON.stringify(config, null, 2)}\n`,
   379→        "utf-8",
   380→      );
   381→    }
   382→    return result;
   383→  } catch (err) {
   384→    debugLog("installClaudeCodeHooks failed", err);
   385→    return result;
   386→  }
   387→}
   388→
   389→/**
   390→ * Install KSPEC_AUTHOR config for Aider (.aider.conf.yml)
   391→ * Aider uses `set-env:` for environment variables in list format
   392→ */
   393→async function installAiderConfig(author: string): Promise<boolean> {
   394→  const configPath = path.join(os.homedir(), ".aider.conf.yml");
   395→
   396→  try {
   397→    let content = "";
   398→    try {
   399→      content = await fs.readFile(configPath, "utf-8");
   400→    } catch (err) {
   401→      debugLog("No existing Aider config, starting fresh", err);
   402→    }
   403→
   404→    // Check if KSPEC_AUTHOR is already set
   405→    if (content.includes("KSPEC_AUTHOR")) {
   406→      // Replace existing value (handles both old and new format)
   407→      content = content.replace(
   408→        /^(\s*-?\s*KSPEC_AUTHOR\s*[=:]\s*).*$/m,
   409→        `  - KSPEC_AUTHOR=${author}`,
   410→      );
   411→    } else {
   412→      // Add to set-env section or create it
   413→      if (content.includes("set-env:")) {
   414→        // Append to existing set-env section
   415→        content = content.replace(
   416→          /(set-env:\s*\n)/m,
   417→          `$1  - KSPEC_AUTHOR=${author}\n`,
   418→        );
   419→      } else {
   420→        // Add new set-env section
   421→        content += `\n# kspec author for note attribution\nset-env:\n  - KSPEC_AUTHOR=${author}\n`;
   422→      }
   423→    }
   424→
   425→    await fs.writeFile(configPath, content, "utf-8");
   426→    return true;
   427→  } catch (err) {
   428→    debugLog("installAiderConfig failed", err);
   429→    return false;
   430→  }
   431→}
   432→
   433→/**
   434→ * Install KSPEC_AUTHOR for generic JSON config files
   435→ */
   436→async function installGenericJsonConfig(
   437→  configPath: string,
   438→  author: string,
   439→): Promise<boolean> {
   440→  try {
   441→    const configDir = path.dirname(configPath);
   442→    await fs.mkdir(configDir, { recursive: true });
   443→
   444→    let config: Record<string, unknown> = {};
   445→    try {
   446→      const existing = await fs.readFile(configPath, "utf-8");
   447→      config = JSON.parse(existing);
   448→    } catch (err) {
   449→      debugLog(`No existing config at ${configPath}, starting fresh`, err);
   450→    }
   451→
   452→    const env = (config.env as Record<string, string>) || {};
   453→    env.KSPEC_AUTHOR = author;
   454→    config.env = env;
   455→
   456→    await fs.writeFile(
   457→      configPath,
   458→      `${JSON.stringify(config, null, 2)}\n`,
   459→      "utf-8",
   460→    );
   461→    return true;
   462→  } catch (err) {
   463→    debugLog(`installGenericJsonConfig failed for ${configPath}`, err);
   464→    return false;
   465→  }
   466→}
   467→
   468→/**
   469→ * Get default author value for an agent type
   470→ */
   471→function getDefaultAuthor(agentType: AgentType): string {
   472→  switch (agentType) {
   473→    case "claude-code":
   474→      return "@claude";
   475→    case "cline":
   476→      return "@cline";
   477→    case "roo-code":
   478→      return "@roo";
   479→    case "copilot-cli":
   480→      return "@copilot";
   481→    case "gemini-cli":
   482→      return "@gemini";
   483→    case "codex-cli":
   484→      return "@codex";
   485→    case "aider":
   486→      return "@aider";
   487→    case "opencode":
   488→      return "@opencode";
   489→    case "amp":
   490→      return "@amp";
   491→    default:
   492→      return "@agent";
   493→  }
   494→}
   495→
   496→/**
   497→ * Prompt user for input with Y/N answer
   498→ */
   499→async function promptYesNo(question: string): Promise<boolean> {
   500→  const rl = readline.createInterface({
   501→    input: process.stdin,
   502→    output: process.stdout,
   503→  });
   504→
   505→  try {
   506→    const answer = await rl.question(`${question} `);
   507→    return answer.toLowerCase() === "y";
   508→  } finally {
   509→    rl.close();
   510→  }
   511→}
   512→
   513→/**
   514→ * Ensure .kspec worktree exists if kspec-meta branch is present.
   515→ * AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
   516→ *
   517→ * @param autoWorktree If true, automatically create worktree without prompting
   518→ * @returns true if worktree is ready to use
   519→ */
   520→async function ensureWorktree(autoWorktree: boolean): Promise<boolean> {
   521→  const projectRoot = getGitRoot(process.cwd());
   522→  if (!projectRoot) {
   523→    // Not in a git repo, skip worktree check
   524→    return true;
   525→  }
   526→
   527→  const status = await getShadowStatus(projectRoot);
   528→
   529→  // AC: worktree-already-exists - if already valid, skip
   530→  if (status.healthy) {
   531→    return true;
   532→  }
   533→
   534→  // AC: detect-existing-repo - branch exists but worktree doesn't
   535→  if (status.branchExists && !status.worktreeExists) {
   536→    // AC: auto-worktree-flag - auto-create if flag set
   537→    if (autoWorktree) {
   538→      console.log(
   539→        `Detected ${SHADOW_BRANCH_NAME} branch without .kspec worktree. Creating...`,
   540→      );
   541→      const result = await repairShadow(projectRoot);
   542→      if (result.success) {
   543→        success("Created .kspec worktree");
   544→        return true;
   545→      } else {
   546→        error(`Failed to create worktree: ${result.error}`);
   547→        return false;
   548→      }
   549→    }
   550→
   551→    // AC: detect-existing-repo - prompt user
   552→    const shouldCreate = await promptYesNo(
   553→      `${SHADOW_BRANCH_NAME} branch exists but .kspec worktree is missing. Create it? (y/N)`,
   554→    );
   555→
   556→    if (shouldCreate) {
   557→      console.log("Creating .kspec worktree...");
   558→      const result = await repairShadow(projectRoot);
   559→      if (result.success) {
   560→        success("Created .kspec worktree");
   561→        return true;
   562→      } else {
   563→        error(`Failed to create worktree: ${result.error}`);
   564→        return false;
   565→      }
   566→    } else {
   567→      warn("Skipping worktree creation");
   568→      return false;
   569→    }
   570→  }
   571→
   572→  // No kspec-meta branch, or already healthy
   573→  return true;
   574→}
   575→
   576→/**
   577→ * Print manual setup instructions
   578→ */
   579→function printManualInstructions(agentType: AgentType): void {
   580→  const author = getDefaultAuthor(agentType);
   581→
   582→  console.log("\nManual setup instructions:\n");
   583→
   584→  switch (agentType) {
   585→    case "claude-code":
   586→      console.log("Add to ~/.claude/settings.json:");
   587→      console.log("```json");
   588→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   589→      console.log("```");
   590→      break;
   591→
   592→    case "cline":
   593→    case "roo-code":
   594→      console.log("Add to your shell profile (~/.bashrc, ~/.zshrc):");
   595→      console.log("```bash");
   596→      console.log(`export KSPEC_AUTHOR="${author}"`);
   597→      console.log("```");
   598→      console.log(
   599→        "\nThis will be inherited by terminals spawned by the VS Code extension.",
   600→      );
   601→      break;
   602→
   603→    case "copilot-cli":
   604→      console.log("Add to ~/.copilot/config.json:");
   605→      console.log("```json");
   606→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   607→      console.log("```");
   608→      break;
   609→
   610→    case "aider":
   611→      console.log("Add to ~/.aider.conf.yml:");
   612→      console.log("```yaml");
   613→      console.log("set-env:");
   614→      console.log(`  - KSPEC_AUTHOR=${author}`);
   615→      console.log("```");
   616→      break;
   617→
   618→    case "codex-cli":
   619→      console.log("Add to ~/.codex/config.toml:");
   620→      console.log("```toml");
   621→      console.log("[shell_environment_policy]");
   622→      console.log(`set = { KSPEC_AUTHOR = "${author}" }`);
   623→      console.log("```");
   624→      break;
   625→
   626→    case "opencode":
   627→      console.log("Add to ~/.config/opencode/opencode.json:");
   628→      console.log("```json");
   629→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   630→      console.log("```");
   631→      break;
   632→
   633→    case "amp":
   634→      console.log("Add to ~/.config/amp/settings.json:");
   635→      console.log("```json");
   636→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   637→      console.log("```");
   638→      break;
   639→
   640→    default:
   641→      console.log("Set the KSPEC_AUTHOR environment variable:");
   642→      console.log("```bash");
   643→      console.log(`export KSPEC_AUTHOR="${author}"`);
   644→      console.log("```");
   645→      console.log("\nOr add to your shell profile (~/.bashrc, ~/.zshrc, etc.)");
   646→  }
   647→}
   648→
   649→/**
   650→ * Result of a setup step
   651→ */
   652→interface SetupStepResult {
   653→  name: string;
   654→  status: "done" | "skipped" | "failed";
   655→  message?: string;
   656→  details?: Record<string, unknown>;
   657→}
   658→
   659→/**
   660→ * Result of running the setup pipeline
   661→ * Used by both the setup command and init --setup
   662→ * AC: @init-setup-integration ac-2, ac-3
   663→ */
   664→export interface SetupPipelineResult {
   665→  success: boolean;
   666→  steps: SetupStepResult[];
   667→  coreSkillsInstalled: number;
   668→  skillsRendered: number;
   669→  hooksInstalled: boolean;
   670→  agentsMdGenerated: boolean;
   671→  permissionsSeeded: boolean;
   672→  memorySeeded: boolean;
   673→}
   674→
   675→/**
   676→ * Options for running the setup pipeline
   677→ */
   678→export interface SetupPipelineOptions {
   679→  dryRun?: boolean;
   680→  skipSkills?: boolean;
   681→  installHooks?: boolean;
   682→  force?: boolean;
   683→  /** Explicit agent override (bypasses auto-detection) */
   684→  agent?: SetupAgentOverride;
   685→  /** Custom author string (overrides auto-detected default) */
   686→  author?: string;
   687→  /** Whether to configure author (only in command handler, not init) */
   688→  configureAuthor?: boolean;
   689→}
   690→
   691→/**
   692→ * Status of the setup state
   693→ * AC: @enhanced-setup ac-7, ac-8 - status reporting
   694→ */
   695→interface SetupStatus {
   696→  agent: {
   697→    detected: AgentType;
   698→    confidence: "high" | "medium" | "low";
   699→  };
   700→  hooks: {
   701→    promptCheck: boolean;
   702→    stop: boolean;
   703→    preToolUse: boolean;
   704→    guardsPresent: string[];
   705→  };
   706→  skills: {
   707→    total: number;
   708→    rendered: number;
   709→    drifted: number;
   710→  };
   711→  plugin: {
   712→    marketplaceRegistered: boolean;
   713→    marketplaceHealthy: boolean;
   714→    pluginEnabled: boolean;
   715→    registeredPath?: string;
   716→    healthMessage?: string;
   717→  };
   718→  agentsMd: {
   719→    exists: boolean;
   720→    // AC: @doctor-command ac-staleness-unknown — includes "unknown" for indeterminate cases
   721→    status: "current" | "stale" | "missing" | "unknown";
   722→    generatedAt?: string;
   723→  };
   724→  seeding: {
   725→    permissionsSeeded: boolean;
   726→    memorySeeded: boolean;
   727→    memoryPath?: string;
   728→  };
   729→}
   730→
   731→/**
   732→ * Check the current setup status
   733→ * AC: @enhanced-setup ac-7, ac-8
   734→ */
   735→async function getSetupStatus(
   736→  projectDir: string,
   737→  agentOverride?: SetupAgentOverride,
   738→): Promise<SetupStatus> {
   739→  const detected = agentOverride
   740→    ? buildDetectedAgent(agentOverride)
   741→    : detectAgent();
   742→  const configPath = path.join(projectDir, ".claude", "settings.json");
   743→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   744→  const agentsMdPath = path.join(projectDir, "kspec-agents.md");
   745→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
   746→  const skillsDir = path.join(projectDir, ".claude", "skills");
   747→
   748→  // Check hooks
   749→  const hooks = {
   750→    promptCheck: false,
   751→    stop: false,
   752→    preToolUse: false,
   753→    guardsPresent: [] as string[],
   754→  };
   755→
   756→  try {
   757→    const configContent = await fs.readFile(configPath, "utf-8");
   758→    const config = JSON.parse(configContent);
   759→    const hooksConfig = config.hooks || {};
   760→
   761→    // Check UserPromptSubmit
   762→    const promptHooks = hooksConfig.UserPromptSubmit as Array<{
   763→      hooks?: Array<{ command?: string }>;
   764→    }> | undefined;
   765→    hooks.promptCheck = promptHooks?.some((entry) =>
   766→      entry.hooks?.some((h) => h.command?.includes("prompt-check")),
   767→    ) ?? false;
   768→
   769→    // Check Stop
   770→    const stopHooks = hooksConfig.Stop as Array<{
   771→      hooks?: Array<{ command?: string }>;
   772→    }> | undefined;
   773→    hooks.stop = stopHooks?.some((entry) =>
   774→      entry.hooks?.some((h) => h.command?.includes("checkpoint")),
   775→    ) ?? false;
   776→
   777→    // Check PreToolUse — look for native kspec guard worktree command
   778→    const preToolUseHooks = hooksConfig.PreToolUse as Array<{
   779→      hooks?: Array<{ command?: string }>;
   780→    }> | undefined;
   781→    hooks.preToolUse = preToolUseHooks?.some((entry) =>
   782→      entry.hooks?.some((h) =>
   783→        h.command === NATIVE_GUARD_COMMAND || h.command?.includes(".claude/hooks/"),
   784→      ),
   785→    ) ?? false;
   786→
   787→    // Check for native guard command
   788→    if (preToolUseHooks?.some((entry) =>
   789→      entry.hooks?.some((h) => h.command === NATIVE_GUARD_COMMAND),
   790→    )) {
   791→      hooks.guardsPresent.push("kspec guard worktree");
   792→    }
   793→    // Check for legacy bash scripts still present
   794→    if (preToolUseHooks?.some((entry) =>
   795→      entry.hooks?.some((h) =>
   796→        OLD_GUARD_SCRIPTS.some((name) => h.command?.includes(name)),
   797→      ),
   798→    )) {
   799→      hooks.guardsPresent.push("legacy:bash-scripts");
   800→    }
   801→  } catch (err) {
   802→    debugLog("Failed to read hooks config for status", err);
   803→  }
   804→
   805→  // Check for legacy guard script files on disk
   806→  try {
   807→    const guardFiles = await fs.readdir(hooksDir);
   808→    for (const name of OLD_GUARD_SCRIPTS) {
   809→      if (guardFiles.includes(name)) {
   810→        hooks.guardsPresent.push(`legacy-file:${name}`);
   811→      }
   812→    }
   813→  } catch (err) {
   814→    debugLog("Hooks dir doesn't exist", err);
   815→  }
   816→
   817→  // Check skills
   818→  const skills = {
   819→    total: 0,
   820→    rendered: 0,
   821→    drifted: 0,
   822→  };
   823→
   824→  // Helper to scan a directory for skill subdirs with kspec-managed SKILL.md
   825→  async function scanForSkills(baseDir: string): Promise<void> {
   826→    try {
   827→      const dirs = await fs.readdir(baseDir, { withFileTypes: true });
   828→      for (const dir of dirs) {
   829→        if (dir.isDirectory()) {
   830→          const skillMdPath = path.join(baseDir, dir.name, "SKILL.md");
   831→          try {
   832→            const content = await fs.readFile(skillMdPath, "utf-8");
   833→            if (content.includes("<!-- kspec-managed -->")) {
   834→              skills.total++;
   835→              skills.rendered++;
   836→            }
   837→          } catch (_noSkillMd) {
   838→            // No SKILL.md
   839→          }
   840→        }
   841→      }
   842→    } catch (_notReadable) {
   843→      // Directory doesn't exist
   844→    }
   845→  }
   846→
   847→  // Scan .claude/skills/ (project/local skills)
   848→  await scanForSkills(skillsDir);
   849→
   850→  // Check plugin marketplace health
   851→  // AC: @enhanced-setup ac-7, ac-8
   852→  const plugin: SetupStatus["plugin"] = {
   853→    marketplaceRegistered: false,
   854→    marketplaceHealthy: false,
   855→    pluginEnabled: false,
   856→  };
   857→
   858→  try {
   859→    const { checkMarketplaceHealth } = await import(
   860→      "../../lib/claude-plugin-registry.js"
   861→    );
   862→    const health = await checkMarketplaceHealth();
   863→    plugin.marketplaceRegistered = health.status !== "missing";
   864→    plugin.marketplaceHealthy = health.status === "healthy";
   865→    plugin.registeredPath = health.registeredPath;
   866→    plugin.healthMessage = health.message;
   867→  } catch (err) {
   868→    debugLog("Could not check marketplace health", err);
   869→    plugin.healthMessage = "Health check unavailable";
   870→  }
   871→
   872→  // Check if plugin is enabled in project settings
   873→  try {
   874→    const configContent = await fs.readFile(configPath, "utf-8");
   875→    const config = JSON.parse(configContent);
   876→    plugin.pluginEnabled = config.enabledPlugins?.["kspec@kspec-plugins"] === true;
   877→  } catch (err) {
   878→    debugLog("Could not check plugin enablement", err);
   879→  }
   880→
   881→  // Check agents.md
   882→  const agentsMd: SetupStatus["agentsMd"] = {
   883→    exists: false,
   884→    status: "missing",
   885→  };
   886→
   887→  try {
   888→    await fs.access(agentsMdPath);
   889→    agentsMd.exists = true;
   890→
   891→    try {
   892→      const hashContent = await fs.readFile(hashPath, "utf-8");
   893→      const hashData = JSON.parse(hashContent);
   894→      agentsMd.generatedAt = hashData.generatedAt;
   895→
   896→      // AC: @cross-platform-and-version-robustness ac-4
   897→      // Compare stored hash against current meta to detect staleness
   898→      try {
   899→        const { initContext, loadMetaContext } = await import(
   900→          "../../parser/index.js"
   901→        );
   902→        const { computeMetaHash, loadTemplateSections, getPackageRoot } = await import("./agents.js");
   903→        const ctx = await initContext();
   904→        if (ctx.manifestPath) {
   905→          const metaCtx = await loadMetaContext(ctx);
   906→          let templateSections: string[] = [];
   907→          try {
   908→            templateSections = await loadTemplateSections(getPackageRoot());
   909→          } catch (err) {
   910→            debugLog("Templates not available for staleness check", err);
   911→          }
   912→          const currentHash = computeMetaHash(
   913→            metaCtx.skills,
   914→            metaCtx.conventions,
   915→            metaCtx.workflows,
   916→            templateSections,
   917→          );
   918→          agentsMd.status = hashData.metaHash === currentHash ? "current" : "stale";
   919→        } else {
   920→          // AC: @doctor-command ac-staleness-unknown — no manifest means we can't determine staleness
   921→          agentsMd.status = "unknown";
   922→        }
   923→      } catch (err) {
   924→        // AC: @doctor-command ac-staleness-unknown — hash computation failed
   925→        debugLog("Could not compute meta hash for staleness check", err);
   926→        agentsMd.status = "unknown";
   927→      }
   928→    } catch (err) {
   929→      debugLog("Hash file missing or invalid, marking stale", err);
   930→      agentsMd.status = "stale";
   931→    }
   932→  } catch (err) {
   933→    debugLog("kspec-agents.md doesn't exist", err);
   934→  }
   935→
   936→  // Check seeding state
   937→  const seeding: SetupStatus["seeding"] = {
   938→    permissionsSeeded: false,
   939→    memorySeeded: false,
   940→  };
   941→
   942→  try {
   943→    const configContent = await fs.readFile(
   944→      path.join(projectDir, ".claude", "settings.json"),
   945→      "utf-8",
   946→    );
   947→    const config = JSON.parse(configContent);
   948→    seeding.permissionsSeeded = !!config.permissions;
   949→  } catch (err) {
   950→    debugLog("Could not check permissions seeding state", err);
   951→  }
   952→
   953→  if (detected.type === "claude-code") {
   954→    try {
   955→      const { claudeCodeMemoryWriter } = await import("./setup-seeding.js");
   956→      const memoryExists = await claudeCodeMemoryWriter.exists(projectDir);
   957→      seeding.memorySeeded = memoryExists;
   958→      if (memoryExists) {
   959→        seeding.memoryPath = claudeCodeMemoryWriter.getMemoryPath(projectDir);
   960→      }
   961→    } catch (err) {
   962→      debugLog("Could not check memory seeding state", err);
   963→    }
   964→  }
   965→
   966→  return {
   967→    agent: {
   968→      detected: detected.type,
   969→      confidence: detected.confidence,
   970→    },
   971→    hooks,
   972→    skills,
   973→    plugin,
   974→    agentsMd,
   975→    seeding,
   976→  };
   977→}
   978→
   979→/**
   980→ * Render skills using the platform renderer registry
   981→ * AC: @setup-pipeline-unification ac-2 - uses getRenderer/getAllRenderers, not legacy renderClaudeCodeSkill
   982→ * AC: @setup-pipeline-unification ac-4 - errors logged at debug level
   983→ */
   984→async function renderSkillsForSetup(
   985→  projectDir: string,
   986→  dryRun: boolean,
   987→): Promise<{ rendered: number; skipped: number; pluginProvided: number; skillIds: string[] }> {
   988→  // Dynamically import to avoid circular dependencies
   989→  const { initContext, loadMetaContext } = await import(
   990→    "../../parser/index.js"
   991→  );
   992→  const { getRenderer } = await import("../../parser/skill-render.js");
   993→
   994→  try {
   995→    const ctx = await initContext();
   996→
   997→    if (!ctx.manifestPath) {
   998→      return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
   999→    }
  1000→
  1001→    const metaCtx = await loadMetaContext(ctx);
  1002→
  1003→    // Collect all skills that have a registered renderer for their platform
  1004→    const skillsToRender: Array<{ skill: typeof metaCtx.skills[0]; platform: string }> = [];
  1005→    for (const skill of metaCtx.skills) {
  1006→      for (const platform of skill.platforms) {
  1007→        const renderer = getRenderer(platform);
  1008→        if (renderer) {
  1009→          skillsToRender.push({ skill, platform });
  1010→        }
  1011→      }
  1012→    }
  1013→
  1014→    if (skillsToRender.length === 0) {
  1015→      return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1016→    }
  1017→
  1018→    let rendered = 0;
  1019→    let skipped = 0;
  1020→    let pluginProvided = 0;
  1021→    const skillIds: string[] = [];
  1022→
  1023→    for (const { skill, platform } of skillsToRender) {
  1024→      const renderer = getRenderer(platform)!;
  1025→      try {
  1026→        const result = await renderer.render(ctx, projectDir, skill, {
  1027→          dryRun,
  1028→        });
  1029→        if (result.action === "created" || result.action === "updated") {
  1030→          rendered++;
  1031→          if (!skillIds.includes(skill.id)) {
  1032→            skillIds.push(skill.id);
  1033→          }
  1034→        } else if (result.action === "skipped" && result.skipCode === "plugin-provided") {
  1035→          pluginProvided++;
  1036→        } else {
  1037→          skipped++;
  1038→        }
  1039→      } catch (err) {
  1040→        debugLog(`Failed to render skill ${skill.id} for ${platform}`, err);
  1041→        skipped++;
  1042→      }
  1043→    }
  1044→
  1045→    return { rendered, skipped, pluginProvided, skillIds };
  1046→  } catch (err) {
  1047→    debugLog("renderSkillsForSetup failed", err);
  1048→    return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1049→  }
  1050→}
  1051→
  1052→/**
  1053→ * Ensure built-in worker and reviewer agent definitions exist in the project meta.
  1054→ *
  1055→ * Creates task-worker and pr-reviewer agents with dispatch rules that match
  1056→ * ralph's behavior. Skips creation if agents already exist (idempotent).
  1057→ *
  1058→ * AC: @ralph-replacement ac-2 — built-in worker and reviewer agent definitions
  1059→ * created in kynetic.meta.yaml with default dispatch rules matching ralph's behavior
  1060→ */
  1061→async function ensureBuiltInAgents(
  1062→  projectDir: string,
  1063→  dryRun: boolean,
  1064→): Promise<{ created: string[]; skipped: string[] }> {
  1065→  const { initContext } = await import("../../parser/index.js");
  1066→  const { loadMetaContext, saveMetaItem } = await import(
  1067→    "../../parser/meta.js"
  1068→  );
  1069→  const { ulid } = await import("ulid");
  1070→
  1071→  const created: string[] = [];
  1072→  const skipped: string[] = [];
  1073→
  1074→  try {
  1075→    const ctx = await initContext();
  1076→    if (!ctx.manifestPath) {
  1077→      return { created, skipped };
  1078→    }
  1079→
  1080→    const meta = await loadMetaContext(ctx);
  1081→    const existingIds = new Set((meta.agents || []).map((a) => a.id));
  1082→
  1083→    // Built-in agent definitions — match ralph's dispatch behavior
  1084→    const builtInAgents = [
  1085→      {
  1086→        id: "task-worker",
  1087→        name: "Task Worker",
  1088→        description:
  1089→          "Autonomous task worker. Picks up automation-eligible ready and needs_work tasks.",
  1090→        capabilities: ["code", "test", "refactor"],
  1091→        tools: ["kspec", "git", "npm"],
  1092→        dispatch: [
  1093→          { on: "task.in_progress", filter: { automation: "eligible" } },
  1094→          { on: "task.ready", filter: { automation: "eligible" } },
  1095→          { on: "task.needs_work", filter: { automation: "eligible" } },
  1096→        ],
  1097→        skills: ["task-work"],
  1098→        concurrency: { max_concurrent: 1 },
  1099→        auto_approve: true,
  1100→      },
  1101→      {
  1102→        id: "pr-reviewer",
  1103→        name: "PR Reviewer",
  1104→        description:
  1105→          "Automated PR reviewer. Reviews pending_review tasks and merges when quality gates pass.",
  1106→        capabilities: ["review"],
  1107→        tools: ["kspec", "git", "gh"],
  1108→        dispatch: [{ on: "task.pending_review" }],
  1109→        skills: ["pr-review"],
  1110→        concurrency: { max_concurrent: 1 },
  1111→        auto_approve: false,
  1112→      },
  1113→    ] as const;
  1114→
  1115→    for (const def of builtInAgents) {
  1116→      if (existingIds.has(def.id)) {
  1117→        skipped.push(def.id);
  1118→        continue;
  1119→      }
  1120→
  1121→      if (!dryRun) {
  1122→        await saveMetaItem(
  1123→          ctx,
  1124→          {
  1125→            _ulid: ulid(),
  1126→            id: def.id,
  1127→            name: def.name,
  1128→            description: def.description,
  1129→            capabilities: [...def.capabilities],
  1130→            tools: [...def.tools],
  1131→            conventions: [],
  1132→            dispatch: def.dispatch.map((r) => ({ ...r })),
  1133→            skills: [...def.skills],
  1134→            concurrency: { ...def.concurrency },
  1135→            auto_approve: def.auto_approve,
  1136→          },
  1137→          "agent",
  1138→        );
  1139→      }
  1140→      created.push(def.id);
  1141→    }
  1142→  } catch (err) {
  1143→    debugLog("ensureBuiltInAgents failed", err);
  1144→  }
  1145→
  1146→  return { created, skipped };
  1147→}
  1148→
  1149→/**
  1150→ * Generate kspec-agents.md using the canonical implementation from agents.ts
  1151→ * AC: @setup-pipeline-unification ac-1 - calls generateAgentsContent() from agents.ts
  1152→ * AC: @setup-pipeline-unification ac-4 - errors logged at debug level
  1153→ */
  1154→async function generateAgentInstructions(
  1155→  projectDir: string,
  1156→  dryRun: boolean,
  1157→): Promise<{ success: boolean; path: string; skipped?: boolean }> {
  1158→  const outputPath = path.join(projectDir, "kspec-agents.md");
  1159→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
  1160→
  1161→  // Dynamically import to avoid circular dependencies
  1162→  const { initContext, loadMetaContext } = await import(
  1163→    "../../parser/index.js"
  1164→  );
  1165→  const {
  1166→    generateAgentsContent,
  1167→    loadTemplateSections,
  1168→    getPackageRoot,
  1169→    computeMetaHash,
  1170→  } = await import("./agents.js");
  1171→
  1172→  try {
  1173→    const ctx = await initContext();
  1174→
  1175→    if (!ctx.manifestPath) {
  1176→      return { success: false, path: outputPath };
  1177→    }
  1178→
  1179→    const metaCtx = await loadMetaContext(ctx);
  1180→    const timestamp = new Date().toISOString();
  1181→
  1182→    // Load templates using the canonical implementation
  1183→    let templateSections: string[] = [];
  1184→    try {
  1185→      templateSections = await loadTemplateSections(getPackageRoot());
  1186→    } catch (err) {
  1187→      debugLog("Failed to load template sections", err);
  1188→    }
  1189→
  1190→    // Generate content using the canonical implementation from agents.ts
  1191→    const content = await generateAgentsContent(
  1192→      metaCtx.skills,
  1193→      metaCtx.conventions,
  1194→      metaCtx.workflows,
  1195→      timestamp,
  1196→      templateSections,
  1197→    );
  1198→
  1199→    if (!dryRun) {
  1200→      // Compute meta hash for freshness tracking
  1201→      const metaHash = computeMetaHash(
  1202→        metaCtx.skills,
  1203→        metaCtx.conventions,
  1204→        metaCtx.workflows,
  1205→        templateSections,
  1206→      );
  1207→
  1208→      // Skip regeneration when content unchanged (same pattern as kspec agents generate)
  1209→      let storedHash: string | undefined;
  1210→      try {
  1211→        const hashContent = await fs.readFile(hashPath, "utf-8");
  1212→        const hashData = JSON.parse(hashContent);
  1213→        storedHash = hashData.metaHash;
  1214→      } catch (_err) {
  1215→        // No hash file or invalid — regenerate
  1216→      }
  1217→
  1218→      // Only skip if hash matches AND the output file actually exists
  1219→      let outputExists = false;
  1220→      try {
  1221→        await fs.access(outputPath);
  1222→        outputExists = true;
  1223→      } catch (_e) {
  1224→        // File missing — must regenerate even if hash matches
  1225→      }
  1226→
  1227→      if (storedHash === metaHash && outputExists) {
  1228→        return { success: true, path: outputPath, skipped: true };
  1229→      }
  1230→
  1231→      await fs.writeFile(outputPath, content, "utf-8");
  1232→
  1233→      await fs.mkdir(path.dirname(hashPath), { recursive: true });
  1234→      // Dynamically import version to avoid top-level require
  1235→      const { createRequire } = await import("node:module");
  1236→      const req = createRequire(import.meta.url);
  1237→      const { version } = req("../../../package.json");
  1238→
  1239→      await fs.writeFile(
  1240→        hashPath,
  1241→        JSON.stringify(
  1242→          {
  1243→            metaHash,
  1244→            generatedAt: timestamp,
  1245→            version,
  1246→          },
  1247→          null,
  1248→          2,
  1249→        ),
  1250→        "utf-8",
  1251→      );
  1252→    }
  1253→
  1254→    return { success: true, path: outputPath };
  1255→  } catch (err) {
  1256→    debugLog("generateAgentInstructions failed", err);
  1257→    return { success: false, path: outputPath };
  1258→  }
  1259→}
  1260→
  1261→/**
  1262→ * Install core skills for the setup pipeline
  1263→ * AC: @init-setup-integration ac-2 - core skills installed
  1264→ */
  1265→async function installCoreSkillsForSetup(
  1266→  projectDir: string,
  1267→  dryRun: boolean
  1268→): Promise<{
  1269→  installed: number;
  1270→  skipped: number;
  1271→  marketplaceRegistered?: boolean;
  1272→  pluginEnabled?: boolean;
  1273→  marketplaceMessage?: string;
  1274→  enableMessage?: string;
  1275→}> {
  1276→  // Dynamically import to avoid circular dependencies
  1277→  const {
  1278→    initContext,
  1279→    loadMetaContext,
  1280→    saveMetaItem,
  1281→    getSkillContentPath,
  1282→  } = await import("../../parser/index.js");
  1283→  const { commitIfShadow } = await import("../../parser/shadow.js");
  1284→  const { SkillSchema } = await import("../../schema/index.js");
  1285→  const {
  1286→    loadCoreSkillsManifest,
  1287→    copyCoreSkillFiles,
  1288→    getKspecPackageVersion,
  1289→  } = await import("./skill.js");
  1290→  const { ulid } = await import("ulid");
  1291→
  1292→  let installed = 0;
  1293→  let skipped = 0;
  1294→
  1295→  try {
  1296→    const ctx = await initContext();
  1297→
  1298→    if (!ctx.manifestPath) {
  1299→      return { installed: 0, skipped: 0 };
  1300→    }
  1301→
  1302→    const metaCtx = await loadMetaContext(ctx);
  1303→    const coreSkills = await loadCoreSkillsManifest();
  1304→    // AC: @cross-platform-and-version-robustness ac-3
  1305→    const kspecVersion = await getKspecPackageVersion();
  1306→    if (!kspecVersion) {
  1307→      debugLog("Could not determine kspec version — skills installed without version tracking");
  1308→    }
  1309→
  1310→    for (const coreSkill of coreSkills) {
  1311→      // Check if skill exists
  1312→      const existingSkill = metaCtx.skills.find((s) => s.id === coreSkill.id);
  1313→
  1314→      if (existingSkill && existingSkill.origin !== "core") {
  1315→        // Custom/project skill exists, skip
  1316→        skipped++;
  1317→        continue;
  1318→      }
  1319→
  1320→      // Build skill data
  1321→      const skillData = {
  1322→        _ulid: existingSkill?._ulid || ulid(),
  1323→        id: coreSkill.id,
  1324→        name: coreSkill.name,
  1325→        description: coreSkill.description,
  1326→        origin: "core" as const,
  1327→        ...(kspecVersion && { version: kspecVersion }),
  1328→        platforms: coreSkill.platforms || ["claude-code"],
  1329→        depends_on: [],
  1330→        tags: ["core"],
  1331→      };
  1332→
  1333→      const parsed = SkillSchema.safeParse(skillData);
  1334→      if (!parsed.success) {
  1335→        skipped++;
  1336→        continue;
  1337→      }
  1338→
  1339→      if (!dryRun) {
  1340→        await saveMetaItem(ctx, parsed.data, "skill");
  1341→
  1342→        // Copy skill files (SKILL.md + supporting dirs)
  1343→        const targetDir = path.dirname(getSkillContentPath(ctx, parsed.data.id));
  1344→        await copyCoreSkillFiles(coreSkill.id, targetDir);
  1345→      }
  1346→
  1347→      installed++;
  1348→    }
  1349→
  1350→    // Commit changes
  1351→    if (!dryRun && installed > 0) {
  1352→      const ctx2 = await initContext();
  1353→      await commitIfShadow(
  1354→        ctx2.shadow,
  1355→        "skill-install-core",
  1356→        `${installed} core skills`
  1357→      );
  1358→    }
  1359→
  1360→    // AC: @core-skill-install ac-6, ac-7 - Register marketplace and enable plugin
  1361→    let marketplaceResult;
  1362→    let enableResult;
  1363→    if (!dryRun) {
  1364→      const {
  1365→        registerCorePluginMarketplace,
  1366→        enablePluginInProject,
  1367→      } = await import("../../lib/claude-plugin-registry.js");
  1368→      marketplaceResult = await registerCorePluginMarketplace();
  1369→      enableResult = await enablePluginInProject(projectDir);
  1370→    }
  1371→
  1372→    return {
  1373→      installed,
  1374→      skipped,
  1375→      marketplaceRegistered: marketplaceResult?.success ?? false,
  1376→      pluginEnabled: enableResult?.success ?? false,
  1377→      marketplaceMessage: marketplaceResult?.message,
  1378→      enableMessage: enableResult?.message,
  1379→    };
  1380→  } catch (err) {
  1381→    debugLog("installCoreSkillsForSetup failed", err);
  1382→    return { installed: 0, skipped: 0 };
  1383→  }
  1384→}
  1385→
  1386→/**
  1387→ * Run the full setup pipeline programmatically.
  1388→ * Used by both 'kspec setup' command and 'kspec init --setup'.
  1389→ * AC: @init-setup-integration ac-2, ac-3
  1390→ */
  1391→export async function runSetupPipeline(
  1392→  projectDir: string,
  1393→  options: SetupPipelineOptions
  1394→): Promise<SetupPipelineResult> {
  1395→  const dryRun = options.dryRun ?? false;
  1396→  const skipSkills = options.skipSkills ?? false;
  1397→  const installHooksFlag = options.installHooks ?? true;
  1398→
  1399→  const steps: SetupStepResult[] = [];
  1400→  let coreSkillsInstalled = 0;
  1401→  let skillsRendered = 0;
  1402→  let hooksInstalled = false;
  1403→  let agentsMdGenerated = false;
  1404→  let permissionsSeeded = false;
  1405→  let memorySeeded = false;
  1406→
  1407→  try {
  1408→    const detected = options.agent
  1409→      ? buildDetectedAgent(options.agent)
  1410→      : detectAgent();
  1411→
  1412→    // Step 1: Agent detection
  1413→    steps.push({
  1414→      name: "Agent detection",
  1415→      status: "done",
  1416→      message: `${detected.type} (${detected.confidence} confidence)`,
  1417→    });
  1418→
  1419→    // Step 2: Install core skills
  1420→    // AC: @init-setup-integration ac-2 - core skills installed in .kspec/skills/
  1421→    const coreResult = await installCoreSkillsForSetup(projectDir, dryRun);
  1422→    coreSkillsInstalled = coreResult.installed;
  1423→
  1424→    if (coreResult.installed > 0 || coreResult.skipped > 0) {
  1425→      steps.push({
  1426→        name: "Install core skills",
  1427→        status: "done",
  1428→        message: `${coreResult.installed} installed, ${coreResult.skipped} skipped`,
  1429→      });
  1430→    } else {
  1431→      steps.push({
  1432→        name: "Install core skills",
  1433→        status: "skipped",
  1434→        message: "No core skills found in package",
  1435→      });
  1436→    }
  1437→
  1438→    // Step 2b: Register plugin marketplace (reports result from installCoreSkillsForSetup)
  1439→    // AC: @core-skill-install ac-6, ac-7
  1440→    if (!dryRun && (coreResult.installed > 0 || coreResult.skipped > 0)) {
  1441→      const bothOk = coreResult.marketplaceRegistered && coreResult.pluginEnabled;
  1442→      if (bothOk) {
  1443→        steps.push({
  1444→          name: "Register plugin marketplace",
  1445→          status: "done",
  1446→          message: "marketplace registered, plugin enabled",
  1447→        });
  1448→      } else {
  1449→        const failures: string[] = [];
  1450→        if (!coreResult.marketplaceRegistered) {
  1451→          failures.push(coreResult.marketplaceMessage || "marketplace registration failed");
  1452→        }
  1453→        if (!coreResult.pluginEnabled) {
  1454→          failures.push(coreResult.enableMessage || "plugin enablement failed");
  1455→        }
  1456→        steps.push({
  1457→          name: "Register plugin marketplace",
  1458→          status: "failed",
  1459→          message: failures.join("; "),
  1460→        });
  1461→      }
  1462→    }
  1463→
  1464→    // Step 3: Install hooks (Claude Code only)
  1465→    // AC: @init-setup-integration ac-3 - hooks present
  1466→    if (detected.type === "claude-code" && installHooksFlag) {
  1467→      const hooksResult = await installClaudeCodeHooks(projectDir, dryRun);
  1468→      const installedHooks: string[] = [];
  1469→      if (hooksResult.promptCheck) installedHooks.push("UserPromptSubmit");
  1470→      if (hooksResult.stop) installedHooks.push("Stop");
  1471→      if (hooksResult.preToolUse) installedHooks.push("PreToolUse");
  1472→
  1473→      hooksInstalled =
  1474→        hooksResult.promptCheck || hooksResult.stop || hooksResult.preToolUse;
  1475→
  1476→      steps.push({
  1477→        name: "Install hooks",
  1478→        status: "done",
  1479→        message: installedHooks.join(", "),
  1480→        details: {
  1481→          guards: hooksResult.guardsCreated,
  1482→        },
  1483→      });
  1484→    } else if (!installHooksFlag) {
  1485→      steps.push({
  1486→        name: "Install hooks",
  1487→        status: "skipped",
  1488→        message: "--no-hooks flag",
  1489→      });
  1490→    } else {
  1491→      steps.push({
  1492→        name: "Install hooks",
  1493→        status: "skipped",
  1494→        message: `not applicable for ${detected.type}`,
  1495→      });
  1496→    }
  1497→
  1498→    // Step 3a: Ensure artifacts directory exists
  1499→    // AC: @artifacts-directory ac-setup-ensures
  1500→    {
  1501→      const artifactsDir = path.join(projectDir, ".kspec", "artifacts");
  1502→      let artifactsCreated = false;
  1503→      try {
  1504→        await fs.access(artifactsDir);
  1505→      } catch (_e) {
  1506→        if (!dryRun) {
  1507→          await fs.mkdir(artifactsDir, { recursive: true });
  1508→        }
  1509→        artifactsCreated = true;
  1510→      }
  1511→      steps.push({
  1512→        name: "Ensure artifacts directory",
  1513→        status: artifactsCreated ? "done" : "skipped",
  1514→        message: artifactsCreated ? "created .kspec/artifacts/" : "already exists",
  1515→      });
  1516→    }
  1517→
  1518→    // Step 3b: Seed permissions (Claude Code only)
  1519→    // AC: @new-project-bootstrapping ac-1
  1520→    {
  1521→      const { seedPermissions } = await import("./setup-seeding.js");
  1522→      const permResult = await seedPermissions(projectDir, detected.type, {
  1523→        dryRun,
  1524→        force: options.force,
  1525→      });
  1526→      permissionsSeeded = permResult.seeded;
  1527→
  1528→      steps.push({
  1529→        name: "Seed permissions",
  1530→        status: permResult.seeded ? "done" : "skipped",
  1531→        message: permResult.message,
  1532→      });
  1533→    }
  1534→
  1535→    // Step 3c: Seed memory (platform-extensible)
  1536→    // AC: @new-project-bootstrapping ac-2, ac-3
  1537→    {
  1538→      const { seedMemory } = await import("./setup-seeding.js");
  1539→      const memResult = await seedMemory(projectDir, detected.type, {
  1540→        dryRun,
  1541→        force: options.force,
  1542→      });
  1543→      memorySeeded = memResult.seeded;
  1544→      const memoryStepStatus =
  1545→        memResult.message.startsWith("failed:")
  1546→          ? "failed"
  1547→          : memResult.seeded
  1548→            ? "done"
  1549→            : "skipped";
  1550→
  1551→      steps.push({
  1552→        name: "Seed memory",
  1553→        status: memoryStepStatus,
  1554→        message: memResult.seeded ? memResult.path : memResult.message,
  1555→      });
  1556→    }
  1557→
  1558→    // Step 4: Render skills
  1559→    // AC: @init-setup-integration ac-3 - rendered skill files present
  1560→    if (!skipSkills) {
  1561→      const skillsResult = await renderSkillsForSetup(projectDir, dryRun);
  1562→      skillsRendered = skillsResult.rendered;
  1563→
  1564→      if (skillsResult.rendered > 0 || skillsResult.skipped > 0 || skillsResult.pluginProvided > 0) {
  1565→        const parts = [];
  1566→        if (skillsResult.rendered > 0) parts.push(`${skillsResult.rendered} rendered`);
  1567→        if (skillsResult.pluginProvided > 0) parts.push(`${skillsResult.pluginProvided} plugin-provided`);
  1568→        if (skillsResult.skipped > 0) parts.push(`${skillsResult.skipped} unchanged`);
  1569→        steps.push({
  1570→          name: "Render skills",
  1571→          status: "done",
  1572→          message: parts.join(", "),
  1573→          details: {
  1574→            skillIds: skillsResult.skillIds,
  1575→          },
  1576→        });
  1577→      } else {
  1578→        steps.push({
  1579→          name: "Render skills",
  1580→          status: "skipped",
  1581→          message: "No skills with registered renderers in meta",
  1582→        });
  1583→      }
  1584→    } else {
  1585→      steps.push({
  1586→        name: "Render skills",
  1587→        status: "skipped",
  1588→        message: "--skip-skills flag",
  1589→      });
  1590→    }
  1591→
  1592→    // Step 4b: Ensure built-in worker and reviewer agent definitions exist
  1593→    // AC: @ralph-replacement ac-2 — built-in agents created in kynetic.meta.yaml
  1594→    {
  1595→      const agentsBuiltIn = await ensureBuiltInAgents(projectDir, dryRun);
  1596→      const totalNew = agentsBuiltIn.created.length;
  1597→      const totalSkipped = agentsBuiltIn.skipped.length;
  1598→      if (totalNew > 0 || totalSkipped > 0) {
  1599→        steps.push({
  1600→          name: "Ensure built-in agents",
  1601→          status: "done",
  1602→          message:
  1603→            totalNew > 0
  1604→              ? `created: ${agentsBuiltIn.created.join(", ")}`
  1605→              : `already exist: ${agentsBuiltIn.skipped.join(", ")}`,
  1606→        });
  1607→      }
  1608→    }
  1609→
  1610→    // Step 5: Generate kspec-agents.md
  1611→    // AC: @init-setup-integration ac-3 - kspec-agents.md present
  1612→    const agentsResult = await generateAgentInstructions(projectDir, dryRun);
  1613→    agentsMdGenerated = agentsResult.success;
  1614→
  1615→    if (agentsResult.success) {
  1616→      steps.push({
  1617→        name: "Generate kspec-agents.md",
  1618→        status: "done",
  1619→        message: agentsResult.skipped
  1620→          ? "already up to date"
  1621→          : agentsResult.path,
  1622→      });
  1623→    } else {
  1624→      steps.push({
  1625→        name: "Generate kspec-agents.md",
  1626→        status: "failed",
  1627→        message: "No kspec project found",
  1628→      });
  1629→    }
  1630→
  1631→    // Step 6: Configure author (optional, used by setup command)
  1632→    if (options.configureAuthor) {
  1633→      const author = options.author || getDefaultAuthor(detected.type);
  1634→      if (!options.force && process.env.KSPEC_AUTHOR) {
  1635→        steps.push({
  1636→          name: "Configure author",
  1637→          status: "skipped",
  1638→          message: `KSPEC_AUTHOR already set to "${process.env.KSPEC_AUTHOR}"`,
  1639→        });
  1640→      } else {
  1641→        let authorInstalled = false;
  1642→        switch (detected.type) {
  1643→          case "claude-code":
  1644→            if (!dryRun) {
  1645→              authorInstalled = await installClaudeCodeConfig(author);
  1646→            } else {
  1647→              authorInstalled = true;
  1648→            }
  1649→            break;
  1650→          case "aider":
  1651→            if (!dryRun) {
  1652→              authorInstalled = await installAiderConfig(author);
  1653→            } else {
  1654→              authorInstalled = true;
  1655→            }
  1656→            break;
  1657→          default:
  1658→            break;
  1659→        }
  1660→
  1661→        if (authorInstalled) {
  1662→          steps.push({
  1663→            name: "Configure author",
  1664→            status: "done",
  1665→            message: `KSPEC_AUTHOR="${author}"`,
  1666→          });
  1667→        } else if (detected.type === "unknown") {
  1668→          // AC: @cmd-setup ac-1 - show manual instructions for unknown agents
  1669→          steps.push({
  1670→            name: "Configure author",
  1671→            status: "skipped",
  1672→            message: `no auto-config for unknown agent — set KSPEC_AUTHOR manually`,
  1673→          });
  1674→        }
  1675→      }
  1676→    }
  1677→
  1678→    // Output summary
  1679→    if (!dryRun) {
  1680→      console.log(chalk.bold("kspec Setup Summary\n"));
  1681→
  1682→      for (const step of steps) {
  1683→        const icon =
  1684→          step.status === "done"
  1685→            ? chalk.green("✓")
  1686→            : step.status === "skipped"
  1687→              ? chalk.gray("○")
  1688→              : chalk.red("✗");
  1689→        const statusText =
  1690→          step.status === "done"
  1691→            ? ""
  1692→            : step.status === "skipped"
  1693→              ? chalk.gray(" (skipped)")
  1694→              : chalk.red(" (failed)");
  1695→
  1696→        console.log(`${icon} ${step.name}${statusText}`);
  1697→        if (step.message) {
  1698→          console.log(chalk.gray(`  ${step.message}`));
  1699→        }
  1700→      }
  1701→    }
  1702→
  1703→    const success = steps.every((s) => s.status !== "failed");
  1704→
  1705→    return {
  1706→      success,
  1707→      steps,
  1708→      coreSkillsInstalled,
  1709→      skillsRendered,
  1710→      hooksInstalled,
  1711→      agentsMdGenerated,
  1712→      permissionsSeeded,
  1713→      memorySeeded,
  1714→    };
  1715→  } catch (err) {
  1716→    debugLog("runSetupPipeline failed", err);
  1717→    return {
  1718→      success: false,
  1719→      steps,
  1720→      coreSkillsInstalled,
  1721→      skillsRendered,
  1722→      hooksInstalled,
  1723→      agentsMdGenerated,
  1724→      permissionsSeeded,
  1725→      memorySeeded,
  1726→    };
  1727→  }
  1728→}
  1729→
  1730→/**
  1731→ * Register the 'setup' command
  1732→ * AC: @enhanced-setup ac-1 through ac-9
  1733→ */
  1734→export function registerSetupCommand(program: Command): void {
  1735→  program
  1736→    .command("setup")
  1737→    .description("Configure agent environment for kspec (orchestrated pipeline)")
  1738→    .option(
  1739→      "--agent <type>",
  1740→      "Explicit agent type override (claude-code|cline|cursor|windsurf|unknown)",
  1741→    )
  1742→    .option("--dry-run", "Show what would be done without making changes")
  1743→    .option(
  1744→      "--author <author>",
  1745→      "Custom author string (default: auto-detected based on agent)",
  1746→    )
  1747→    .option("--no-hooks", "Skip installing hooks")
  1748→    .option("--skip-skills", "Skip rendering skills")
  1749→    .option("--status", "Report current setup state without making changes")
  1750→    .option("--force", "Overwrite existing configuration")
  1751→    .option(
  1752→      "--auto-worktree",
  1753→      "Automatically create .kspec worktree if kspec-meta branch exists",
  1754→    )
  1755→    .action(async (options) => {
  1756→      try {
  1757→        const projectDir = process.cwd();
  1758→        const agentOverride = options.agent
  1759→          ? parseSetupAgentOverride(options.agent)
  1760→          : undefined;
  1761→
  1762→        // AC: @enhanced-setup ac-7, ac-8 - --status mode
  1763→        if (options.status) {
  1764→          const status = await getSetupStatus(projectDir, agentOverride);
  1765→
  1766→          output(status, () => {
  1767→            console.log(chalk.bold("kspec Setup Status\n"));
  1768→
  1769→            // Agent detection
  1770→            console.log(chalk.gray("Agent:"));
  1771→            console.log(
  1772→              `  Detected: ${status.agent.detected} (${status.agent.confidence} confidence)`,
  1773→            );
  1774→            console.log();
  1775→
  1776→            // Hooks status
  1777→            console.log(chalk.gray("Hooks:"));
  1778→            console.log(
  1779→              `  UserPromptSubmit: ${status.hooks.promptCheck ? chalk.green("✓") : chalk.red("✗")}`,
  1780→            );
  1781→            console.log(
  1782→              `  Stop:             ${status.hooks.stop ? chalk.green("✓") : chalk.red("✗")}`,
  1783→            );
  1784→            console.log(
  1785→              `  PreToolUse:       ${status.hooks.preToolUse ? chalk.green("✓") : chalk.red("✗")}`,
  1786→            );
  1787→            if (status.hooks.guardsPresent.length > 0) {
  1788→              console.log(
  1789→                `  Guards:           ${status.hooks.guardsPresent.join(", ")}`,
  1790→              );
  1791→            }
  1792→            console.log();
  1793→
  1794→            // Skills status
  1795→            console.log(chalk.gray("Skills:"));
  1796→            console.log(`  Rendered: ${status.skills.rendered}`);
  1797→            if (status.skills.drifted > 0) {
  1798→              console.log(
  1799→                `  Drifted:  ${chalk.yellow(status.skills.drifted.toString())}`,
  1800→              );
  1801→            }
  1802→            console.log();
  1803→
  1804→            // Plugin marketplace status
  1805→            // AC: @enhanced-setup ac-7, ac-8
  1806→            console.log(chalk.gray("Plugin:"));
  1807→            console.log(
  1808→              `  Marketplace: ${status.plugin.marketplaceRegistered ? (status.plugin.marketplaceHealthy ? chalk.green("healthy") : chalk.yellow("registered")) : chalk.red("not registered")}`,
  1809→            );
  1810→            console.log(
  1811→              `  Enabled:     ${status.plugin.pluginEnabled ? chalk.green("✓") : chalk.red("✗")}`,
  1812→            );
  1813→            if (status.plugin.registeredPath) {
  1814→              console.log(chalk.gray(`  Path: ${status.plugin.registeredPath}`));
  1815→            }
  1816→            if (status.plugin.healthMessage && !status.plugin.marketplaceHealthy) {
  1817→              console.log(chalk.yellow(`  ${status.plugin.healthMessage}`));
  1818→            }
  1819→            console.log();
  1820→
  1821→            // Agents.md status
  1822→            console.log(chalk.gray("kspec-agents.md:"));
  1823→            if (status.agentsMd.exists) {
  1824→              // AC: @doctor-command ac-staleness-unknown — show appropriate color for unknown status
  1825→              const statusColor =
  1826→                status.agentsMd.status === "current"
  1827→                  ? chalk.green
  1828→                  : status.agentsMd.status === "unknown"
  1829→                    ? chalk.yellow
  1830→                    : chalk.yellow;
  1831→              console.log(`  Status: ${statusColor(status.agentsMd.status)}`);
  1832→              if (status.agentsMd.status === "unknown") {
  1833→                console.log(chalk.gray("  Could not determine staleness (no manifest or hash unavailable)"));
  1834→              }
  1835→              if (status.agentsMd.generatedAt) {
  1836→                console.log(`  Generated: ${status.agentsMd.generatedAt}`);
  1837→              }
  1838→            } else {
  1839→              console.log(`  Status: ${chalk.red("missing")}`);
  1840→              console.log(
  1841→                chalk.gray("  Run 'kspec setup' to generate"),
  1842→              );
  1843→            }
  1844→            console.log();
  1845→
  1846→            // Seeding status
  1847→            console.log(chalk.gray("Seeding:"));
  1848→            console.log(
  1849→              `  Permissions: ${status.seeding.permissionsSeeded ? chalk.green("✓") : chalk.gray("○")}`,
  1850→            );
  1851→            console.log(
  1852→              `  Memory:      ${status.seeding.memorySeeded ? chalk.green("✓") : chalk.gray("○")}`,
  1853→            );
  1854→            if (status.seeding.memoryPath) {
  1855→              console.log(
  1856→                chalk.gray(`  Path: ${status.seeding.memoryPath}`),
  1857→              );
  1858→            }
  1859→          });
  1860→          return;
  1861→        }
  1862→
  1863→        // AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
  1864→        const worktreeReady = await ensureWorktree(
  1865→          options.autoWorktree || false,
  1866→        );
  1867→        if (!worktreeReady) {
  1868→          // User declined worktree creation or it failed
  1869→          process.exit(EXIT_CODES.ERROR);
  1870→        }
  1871→
  1872→        const detected = agentOverride
  1873→          ? buildDetectedAgent(agentOverride)
  1874→          : detectAgent();
  1875→        const dryRun = options.dryRun || false;
  1876→
  1877→        // AC: @cmd-setup ac-1 - proceed with setup even when no agent is detected
  1878→        if (detected.type === "unknown") {
  1879→          warn("Could not auto-detect agent environment — proceeding with core setup steps");
  1880→        }
  1881→
  1882→        // AC: @setup-pipeline-unification ac-3 - delegate to runSetupPipeline()
  1883→        // One code path for both 'kspec setup' and 'kspec init --setup'
  1884→        const result = await runSetupPipeline(projectDir, {
  1885→          dryRun,
  1886→          skipSkills: options.skipSkills || false,
  1887→          installHooks: options.hooks !== false,
  1888→          force: options.force || false,
  1889→          agent: agentOverride,
  1890→          author: options.author,
  1891→          configureAuthor: true,
  1892→        });
  1893→
  1894→        // AC: @enhanced-setup ac-1 - Display summary
  1895→        // AC: @enhanced-setup ac-6 - dry-run displays planned actions
  1896→        output(
  1897→          {
  1898→            dry_run: dryRun,
  1899→            steps: result.steps.map((s) => ({
  1900→              name: s.name,
  1901→              status: s.status,
  1902→              message: s.message,
  1903→              details: s.details,
  1904→            })),
  1905→          },
  1906→          () => {
  1907→            if (dryRun) {
  1908→              console.log(chalk.yellow("DRY RUN - No changes made\n"));
  1909→            }
  1910→
  1911→            // Pipeline already prints the summary when not dry-run
  1912→            // For dry-run, print it here since the pipeline skips output
  1913→            if (dryRun) {
  1914→              console.log(chalk.bold("kspec Setup Summary\n"));
  1915→
  1916→              for (const step of result.steps) {
  1917→                const icon =
  1918→                  step.status === "done"
  1919→                    ? chalk.green("✓")
  1920→                    : step.status === "skipped"
  1921→                      ? chalk.gray("○")
  1922→                      : chalk.red("✗");
  1923→                const statusText =
  1924→                  step.status === "done"
  1925→                    ? ""
  1926→                    : step.status === "skipped"
  1927→                      ? chalk.gray(" (skipped)")
  1928→                      : chalk.red(" (failed)");
  1929→
  1930→                console.log(`${icon} ${step.name}${statusText}`);
  1931→                if (step.message) {
  1932→                  console.log(chalk.gray(`  ${step.message}`));
  1933→                }
  1934→              }
  1935→            }
  1936→
  1937→            console.log();
  1938→
  1939→            if (dryRun) {
  1940→              console.log(
  1941→                chalk.yellow("Run without --dry-run to apply changes."),
  1942→              );
  1943→            } else {
  1944→              console.log(
  1945→                chalk.green("Setup complete."),
  1946→              );
  1947→              console.log(
  1948→                chalk.gray("Restart your agent session for changes to take effect."),
  1949→              );
  1950→            }
  1951→
  1952→            // AC: @cmd-setup ac-1 - print manual KSPEC_AUTHOR instructions for unknown agents
  1953→            if (detected.type === "unknown") {
  1954→              printManualInstructions("unknown");
  1955→            }
  1956→          },
  1957→        );
  1958→      } catch (err) {
  1959→        error(errors.failures.setupFailed, err);
  1960→        process.exit(EXIT_CODES.ERROR);
  1961→      }
  1962→    });
  1963→}
  1964→
```