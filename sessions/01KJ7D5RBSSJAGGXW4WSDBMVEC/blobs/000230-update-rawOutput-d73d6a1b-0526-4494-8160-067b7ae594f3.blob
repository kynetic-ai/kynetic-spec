   392→describe("Session store: requestEndLoop and isEndLoopRequested", () => {
   393→  let tempDir: string;
   394→
   395→  beforeEach(async () => {
   396→    tempDir = await setupTempFixtures();
   397→    initGitRepo(tempDir);
   398→  });
   399→
   400→  afterEach(async () => {
   401→    await cleanupTempDir(tempDir);
   402→  });
   403→
   404→  it("should write end_requested and end_reason to session", async () => {
   405→    await createTestSession(tempDir, SESSION_ID);
   406→
   407→    // Use end-loop command with session
   408→    const result = kspec(
   409→      'ralph end-loop --reason "Testing"',
   410→      tempDir,
   411→      { env: { KSPEC_SESSION_ID: SESSION_ID } },
   412→    );
   413→    expect(result.exitCode).toBe(0);
   414→
   415→    // Verify the session YAML was updated
   416→    const session = await readTestSession(tempDir, SESSION_ID);
   417→    expect(session!.end_requested).toBe(true);
   418→    expect(session!.end_reason).toBe("Testing");
   419→    // Original fields should be preserved
   420→    expect(session!.status).toBe("active");
   421→    expect(session!.agent_type).toBe("ralph");
   422→  });
   423→
   424→  it("should report end-loop not requested for fresh session", async () => {
   425→    await createTestSession(tempDir, SESSION_ID);
   426→
   427→    // Task start should succeed (no end-loop requested)
   428→    const result = kspec("task start @test-task-pending", tempDir, {
   429→      env: { KSPEC_SESSION_ID: SESSION_ID },
   430→    });
   431→    expect(result.exitCode).toBe(0);
   432→  });
   433→});
   434→
   435→describe("Session close with closeSession", () => {
   436→  let tempDir: string;
   437→
   438→  beforeEach(async () => {
   439→    tempDir = await setupTempFixtures();
   440→    initGitRepo(tempDir);
   441→  });
   442→
   443→  afterEach(async () => {
   444→    await cleanupTempDir(tempDir);
   445→  });
   446→
   447→  it("should verify closeSession function is exported and usable", async () => {
   448→    // This tests that the closeSession function works by verifying
   449→    // the session store module structure
   450→    const storeContent = await fs.readFile(
