   221→  // AC: @session-end-loop-signal ac-detect
   222→  describe("ac-detect: ralph detects end-loop from session state", () => {
   223→    it("should still detect end-loop command pattern", () => {
   224→      // detectEndLoopCommand is internal; verify the pattern works
   225→      const pattern = /\bkspec\s+ralph\s+end-loop\b/;
   226→      expect(pattern.test("kspec ralph end-loop")).toBe(true);
   227→      expect(pattern.test('kspec ralph end-loop --reason "done"')).toBe(true);
   228→      expect(pattern.test("kspec ralph")).toBe(false);
   229→      expect(pattern.test("kspec ralph run")).toBe(false);
   230→      expect(pattern.test("ralph end-loop")).toBe(false);
   231→    });
   232→
   233→    it("should read session state instead of marker file between iterations", async () => {
   234→      // Static analysis: verify ralph reads session state for end-loop detection
   235→      const ralphContent = await fs.readFile(
   236→        path.join(process.cwd(), "src/cli/commands/ralph.ts"),
   237→        "utf-8",
   238→      );
   239→
   240→      // Verify isEndLoopRequested is used for between-iteration checks
   241→      expect(ralphContent).toContain("isEndLoopRequested");
   242→      // Verify it reads from session (specDir, sessionId)
   243→      expect(ralphContent).toContain("isEndLoopRequested(specDir, sessionId)");
   244→      // Verify the streaming handler reads session state for reason
   245→      expect(ralphContent).toContain("result?.reason");
   246→    });
   247→
   248→    it("should check session state at iteration start and break if requested", async () => {
   249→      // Static analysis: verify early exit at iteration boundary
   250→      const ralphContent = await fs.readFile(
   251→        path.join(process.cwd(), "src/cli/commands/ralph.ts"),
   252→        "utf-8",
   253→      );
   254→
   255→      // Verify session state is checked at iteration start
   256→      expect(ralphContent).toContain("endLoopState?.requested");
   257→      expect(ralphContent).toContain("End-loop already requested");
   258→      expect(ralphContent).toContain('exitReason = "end_loop_signal"');
   259→    });
   260→  });
