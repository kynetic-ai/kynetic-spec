   262→  // AC: @session-end-loop-signal ac-session-close-normal
   263→  // AC: @session-end-loop-signal ac-session-close-signal
   264→  // AC: @session-end-loop-signal ac-session-close-error
   265→  describe("session close handlers", () => {
   266→    it("should register SIGINT and SIGTERM handlers that close session", async () => {
   267→      // AC: @session-end-loop-signal ac-session-close-signal
   268→      // Static analysis to verify signal handlers close session
   269→      const ralphContent = await fs.readFile(
   270→        path.join(process.cwd(), "src/cli/commands/ralph.ts"),
   271→        "utf-8",
   272→      );
   273→
   274→      // Verify signal handlers are registered
   275→      expect(ralphContent).toContain('process.on("SIGINT"');
   276→      expect(ralphContent).toContain('process.on("SIGTERM"');
   277→
   278→      // Verify session is closed with abandoned status on signal
   279→      expect(ralphContent).toContain("closeSession");
   280→      expect(ralphContent).toContain('"abandoned"');
   281→      expect(ralphContent).toContain("Received ${signal}");
   282→
   283→      // Verify cleanup awaits before exit
   284→      expect(ralphContent).toContain("Promise.all");
   285→      expect(ralphContent).toContain(".finally(() =>");
   286→    });
   287→
   288→    it("should close session with completed status on normal exit", async () => {
   289→      // AC: @session-end-loop-signal ac-session-close-normal
   290→      const ralphContent = await fs.readFile(
   291→        path.join(process.cwd(), "src/cli/commands/ralph.ts"),
   292→        "utf-8",
   293→      );
   294→
   295→      // Verify closeSession is called at the end of the loop
   296→      expect(ralphContent).toContain("closeSession(specDir, sessionId, status, closeReason)");
   297→
   298→      // Verify close reasons are computed for various exit paths
   299→      expect(ralphContent).toContain("Completed all");
   300→      expect(ralphContent).toContain("No eligible tasks remaining");
   301→      expect(ralphContent).toContain("Agent requested end of loop");
   302→    });
   303→
   304→    it("should close session with abandoned status on max failures", async () => {
   305→      // AC: @session-end-loop-signal ac-session-close-error
   306→      const ralphContent = await fs.readFile(
   307→        path.join(process.cwd(), "src/cli/commands/ralph.ts"),
   308→        "utf-8",
   309→      );
   310→
   311→      // Verify max_failures exit sets abandoned status
   312→      expect(ralphContent).toContain("max_failures");
   313→      expect(ralphContent).toContain("Max failures reached");
   314→    });
   315→  });
   316→
