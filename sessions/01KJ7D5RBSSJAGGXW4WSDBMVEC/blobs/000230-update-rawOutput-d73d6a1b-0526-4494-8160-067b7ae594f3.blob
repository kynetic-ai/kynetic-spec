     1→/**
     2→ * Tests for session-scoped end-loop signal.
     3→ *
     4→ * Migrated from marker file approach to session state.
     5→ * AC: @session-end-loop-signal ac-signal, ac-block-task, ac-detect, ac-session-close-normal,
     6→ *     ac-session-close-signal, ac-session-close-error, ac-remove-markers
     7→ * AC: @trait-error-guidance ac-1, ac-2
     8→ *
     9→ * Trait ACs documented as N/A for this feature:
    10→ * - @trait-error-guidance ac-3: N/A — no ref resolution in end-loop command
    11→ * - @trait-error-guidance ac-4: N/A — no state transitions in end-loop command
    12→ * - @trait-error-guidance ac-5: N/A — no field-level validation in end-loop command
    13→ * - @trait-error-guidance ac-6: N/A — ralph end-loop does not support --json output mode
    14→ */
    15→import { describe, it, expect, beforeEach, afterEach } from "vitest";
    16→import * as fs from "node:fs/promises";
    17→import * as path from "node:path";
    18→import * as YAML from "yaml";
    19→import {
    20→  kspec,
    21→  kspecJson,
    22→  setupTempFixtures,
    23→  cleanupTempDir,
    24→  initGitRepo,
    25→} from "../helpers/cli";
    26→
    27→const SESSION_ID = "01KJ7CCCHNMBABEHHDVEYSPJFR";
    28→
    29→/**
    30→ * Helper to create a session.yaml file in the test fixture directory.
    31→ * Sessions live at {specDir}/sessions/{sessionId}/session.yaml
    32→ */
    33→async function createTestSession(
    34→  specDir: string,
    35→  sessionId: string,
    36→  overrides: Record<string, unknown> = {},
    37→): Promise<void> {
    38→  const sessionDir = path.join(specDir, "sessions", sessionId);
    39→  await fs.mkdir(sessionDir, { recursive: true });
    40→  const metadata = {
    41→    id: sessionId,
    42→    agent_type: "ralph",
    43→    status: "active",
    44→    started_at: new Date().toISOString(),
    45→    ...overrides,
    46→  };
    47→  await fs.writeFile(
    48→    path.join(sessionDir, "session.yaml"),
    49→    YAML.stringify(metadata, { indent: 2, lineWidth: 100, sortMapEntries: false }),
    50→  );
    51→}
    52→
    53→/**
    54→ * Helper to read session metadata.
    55→ */
    56→async function readTestSession(
    57→  specDir: string,
    58→  sessionId: string,
    59→): Promise<Record<string, unknown> | null> {
    60→  const sessionPath = path.join(
    61→    specDir,
    62→    "sessions",
    63→    sessionId,
    64→    "session.yaml",
    65→  );
    66→  try {
    67→    const content = await fs.readFile(sessionPath, "utf-8");
    68→    return YAML.parse(content);
    69→  } catch {
    70→    return null;
    71→  }
    72→}
    73→
    74→describe("Session-scoped end-loop signal", () => {
    75→  let tempDir: string;
    76→
    77→  beforeEach(async () => {
    78→    tempDir = await setupTempFixtures();
    79→    initGitRepo(tempDir);
    80→  });
    81→
    82→  afterEach(async () => {
    83→    await cleanupTempDir(tempDir);
    84→  });
    85→
    86→  // AC: @session-end-loop-signal ac-signal
    87→  describe("ac-signal: end-loop writes to session state", () => {
    88→    it("should write end_requested=true to session metadata", async () => {
    89→      await createTestSession(tempDir, SESSION_ID);
    90→
    91→      const result = kspec("ralph end-loop", tempDir, {
    92→        env: { KSPEC_SESSION_ID: SESSION_ID },
    93→      });
    94→
    95→      expect(result.exitCode).toBe(0);
    96→      expect(result.stdout).toContain("Loop end signal sent");
    97→
    98→      // Verify session state was updated
    99→      const session = await readTestSession(tempDir, SESSION_ID);
   100→      expect(session).not.toBeNull();
   101→      expect(session!.end_requested).toBe(true);
   102→    });
   103→
   104→    it("should include reason in session metadata when provided", async () => {
   105→      await createTestSession(tempDir, SESSION_ID);
   106→
   107→      // AC: @session-end-loop-signal ac-signal
   108→      const result = kspec(
   109→        'ralph end-loop --reason "No eligible tasks"',
   110→        tempDir,
   111→        { env: { KSPEC_SESSION_ID: SESSION_ID } },
   112→      );
   113→
   114→      expect(result.exitCode).toBe(0);
   115→      expect(result.stdout).toContain("Reason: No eligible tasks");
   116→
   117→      const session = await readTestSession(tempDir, SESSION_ID);
   118→      expect(session!.end_requested).toBe(true);
   119→      expect(session!.end_reason).toBe("No eligible tasks");
   120→    });
   121→
   122→    it("should fail with exit code 4 when KSPEC_SESSION_ID is not set", async () => {
   123→      // AC: @trait-error-guidance ac-1, ac-2
   124→      const result = kspec("ralph end-loop", tempDir, {
   125→        expectFail: true,
   126→        env: { KSPEC_SESSION_ID: "" },
   127→      });
   128→
   129→      expect(result.exitCode).toBe(4);
   130→      const output = result.stdout + result.stderr;
   131→      expect(output).toContain("KSPEC_SESSION_ID not set");
   132→      expect(output).toContain("kspec session create");
   133→    });
   134→
   135→    it("should fail with exit code 3 when session not found", async () => {
   136→      // AC: @trait-error-guidance ac-1, ac-2
   137→      const result = kspec("ralph end-loop", tempDir, {
   138→        expectFail: true,
   139→        env: { KSPEC_SESSION_ID: "NONEXISTENT_SESSION" },
   140→      });
   141→
   142→      expect(result.exitCode).toBe(3);
   143→      const output = result.stdout + result.stderr;
   144→      expect(output).toContain("Session not found");
   145→      expect(output).toContain("kspec session log list");
   146→    });
   147→  });
   148→
   149→  // AC: @session-end-loop-signal ac-block-task
   150→  describe("ac-block-task: task start blocked when end-loop requested", () => {
   151→    it("should block task start when end_requested is true", async () => {
   152→      await createTestSession(tempDir, SESSION_ID, {
   153→        end_requested: true,
   154→        end_reason: "Wrapping up",
   155→      });
   156→
   157→      const result = kspec("task start @test-task-pending", tempDir, {
   158→        expectFail: true,
   159→        env: { KSPEC_SESSION_ID: SESSION_ID },
   160→      });
   161→
   162→      expect(result.exitCode).toBe(4);
   163→      const output = result.stdout + result.stderr;
   164→      expect(output).toContain("loop is ending");
   165→    });
   166→
   167→    it("should include end-loop reason in error message", async () => {
   168→      await createTestSession(tempDir, SESSION_ID, {
   169→        end_requested: true,
   170→        end_reason: "No more eligible tasks",
   171→      });
   172→
   173→      const result = kspec("task start @test-task-pending", tempDir, {
   174→        expectFail: true,
   175→        env: { KSPEC_SESSION_ID: SESSION_ID },
   176→      });
   177→
   178→      const output = result.stdout + result.stderr;
   179→      expect(output).toContain("No more eligible tasks");
   180→    });
   181→
   182→    it("should include wrap-up guidance in error message", async () => {
   183→      // AC: @trait-error-guidance ac-2
   184→      await createTestSession(tempDir, SESSION_ID, {
   185→        end_requested: true,
   186→      });
   187→
   188→      const result = kspec("task start @test-task-pending", tempDir, {
   189→        expectFail: true,
   190→        env: { KSPEC_SESSION_ID: SESSION_ID },
   191→      });
   192→
   193→      const output = result.stdout + result.stderr;
   194→      expect(output).toMatch(/[Ww]rap up/);
   195→    });
   196→
   197→    it("should allow task start when no session ID is set", async () => {
   198→      // No KSPEC_SESSION_ID means no end-loop check
   199→      await createTestSession(tempDir, SESSION_ID, {
   200→        end_requested: true,
   201→      });
   202→
   203→      const result = kspec("task start @test-task-pending", tempDir, {
   204→        env: { KSPEC_SESSION_ID: "" },
   205→      });
   206→
   207→      expect(result.exitCode).toBe(0);
   208→    });
   209→
   210→    it("should allow task start when end_requested is not set", async () => {
   211→      await createTestSession(tempDir, SESSION_ID);
   212→
   213→      const result = kspec("task start @test-task-pending", tempDir, {
   214→        env: { KSPEC_SESSION_ID: SESSION_ID },
   215→      });
   216→
   217→      expect(result.exitCode).toBe(0);
   218→    });
   219→  });
