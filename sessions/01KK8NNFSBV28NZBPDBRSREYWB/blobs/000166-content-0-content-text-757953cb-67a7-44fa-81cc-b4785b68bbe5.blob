```
     1→/**
     2→ * Kspec Daemon Server
     3→ *
     4→ * Elysia.js HTTP server with WebSocket support for real-time kspec state updates.
     5→ * Implements localhost-only security, file watching, and graceful shutdown.
     6→ */
     7→
     8→import { Elysia } from 'elysia';
     9→import { cors } from '@elysiajs/cors';
    10→import { staticPlugin } from '@elysiajs/static';
    11→import { ulid } from 'ulidx';
    12→import { existsSync } from 'fs';
    13→import { fileURLToPath } from 'url';
    14→import { dirname } from 'path';
    15→import { PubSubManager } from './websocket/pubsub';
    16→import { HeartbeatManager } from './websocket/heartbeat';
    17→import { WebSocketHandler } from './websocket/handler';
    18→import { handleWebSocketClose } from './websocket/lifecycle';
    19→import type { ConnectionData, ConnectedEvent } from './websocket/types';
    20→import { PidFileManager } from './pid';
    21→import { projectContextMiddleware } from './middleware/project-context';
    22→import { createTasksRoutes } from './routes/tasks';
    23→import { createItemsRoutes } from './routes/items';
    24→import { createInboxRoutes } from './routes/inbox';
    25→import { createMetaRoutes } from './routes/meta';
    26→import { createValidationRoutes } from './routes/validation';
    27→import { createProjectsRoutes } from './routes/projects';
    28→import { createTriageRoutes } from './routes/triage';
    29→import { createAgentDispatchRoutes, getDispatchEngine, stopAllEngines } from './routes/agent-dispatch';
    30→import { createSessionRoutes } from './routes/sessions';
    31→import { createPlansRoutes } from './routes/plans';
    32→import { ShadowSyncScheduler } from './shadow-sync';
    33→import { SessionSyncScheduler } from './session-sync';
    34→import { join } from 'path';
    35→
    36→export interface ServerOptions {
    37→  port: number;
    38→  isDaemon: boolean;
    39→  kspecDir?: string; // Path to .kspec directory (default: .kspec in cwd)
    40→  webUiDir?: string; // Path to web UI build directory (default: auto-detect)
    41→}
    42→
    43→/**
    44→ * Resolves the path to the web UI build directory.
    45→ * Tries multiple locations in order:
    46→ * 1. Explicit webUiDir option
    47→ * 2. WEB_UI_DIR environment variable
    48→ * 3. packages/web-ui/build in current working directory (monorepo dev)
    49→ * 4. web-ui/build in current working directory
    50→ * 5. Bundled dist/web-ui/ relative to this module (npm package installs)
    51→ *
    52→ * Exported for testing only.
    53→ */
    54→export function resolveWebUiPath(webUiDir?: string): string | null {
    55→  // 1. Explicit option
    56→  if (webUiDir && existsSync(webUiDir)) {
    57→    return webUiDir;
    58→  }
    59→
    60→  // 2. Environment variable
    61→  const envPath = process.env.WEB_UI_DIR;
    62→  if (envPath && existsSync(envPath)) {
    63→    return envPath;
    64→  }
    65→
    66→  // 3. Monorepo development: packages/web-ui/build from cwd
    67→  // The daemon is spawned with cwd set to project root
    68→  const monorepoPath = join(process.cwd(), 'packages', 'web-ui', 'build');
    69→  if (existsSync(monorepoPath)) {
    70→    return monorepoPath;
    71→  }
    72→
    73→  // 4. Alternate location: web-ui/build in cwd
    74→  const altPath = join(process.cwd(), 'web-ui', 'build');
    75→  if (existsSync(altPath)) {
    76→    return altPath;
    77→  }
    78→
    79→  // 5. Bundled assets: dist/web-ui/ relative to daemon module location
    80→  // Covers npm package installs where no local web UI build exists.
    81→  // import.meta.url resolves to dist/daemon/server.js → sibling is dist/web-ui/
    82→  const selfDir = dirname(fileURLToPath(import.meta.url));
    83→  const bundledPath = join(selfDir, '..', 'web-ui');
    84→  if (existsSync(bundledPath)) {
    85→    return bundledPath;
    86→  }
    87→
    88→  return null;
    89→}
    90→
    91→// WebSocket pub/sub and heartbeat managers
    92→let pubsubManager: PubSubManager;
    93→let heartbeatManager: HeartbeatManager;
    94→let wsHandler: WebSocketHandler;
    95→let projectManager: import('./project-context').ProjectContextManager | undefined;
    96→let shadowSyncScheduler: ShadowSyncScheduler | undefined;
    97→let sessionSyncScheduler: SessionSyncScheduler | undefined;
    98→
    99→/**
   100→ * Middleware to enforce localhost-only connections.
   101→ * AC-3: Reject non-localhost connections with 403 Forbidden
   102→ */
   103→function localhostOnly() {
   104→  return (context: { request: Request }) => {
   105→    const host = context.request.headers.get('host');
   106→    if (!host) {
   107→      return new Response(JSON.stringify({
   108→        error: 'Forbidden',
   109→        message: 'This server only accepts connections from localhost'
   110→      }), {
   111→        status: 403,
   112→        headers: { 'Content-Type': 'application/json' }
   113→      });
   114→    }
   115→
   116→    // Extract hostname, handling IPv6 brackets
   117→    let hostname: string;
   118→    if (host.startsWith('[')) {
   119→      // IPv6 with brackets: [::1]:3456 -> ::1
   120→      const closeBracket = host.indexOf(']');
   121→      hostname = closeBracket > 0 ? host.substring(1, closeBracket) : host;
   122→    } else {
   123→      // IPv4 or hostname: localhost:3456 -> localhost
   124→      hostname = host.split(':')[0];
   125→    }
   126→
   127→    // Allow localhost, 127.0.0.1, and ::1
   128→    const isLocalhost =
   129→      hostname === 'localhost' ||
   130→      hostname === '127.0.0.1' ||
   131→      hostname === '::1';
   132→
   133→    if (!isLocalhost) {
   134→      return new Response(JSON.stringify({
   135→        error: 'Forbidden',
   136→        message: 'This server only accepts connections from localhost'
   137→      }), {
   138→        status: 403,
   139→        headers: { 'Content-Type': 'application/json' }
   140→      });
   141→    }
   142→  };
   143→}
   144→
   145→/**
   146→ * Creates and configures the Elysia server instance.
   147→ *
   148→ * AC Coverage:
   149→ * - ac-1: Server starts on configurable port (default 3456)
   150→ * - ac-2: Binds to localhost only (127.0.0.1 and ::1)
   151→ * - ac-3: Rejects non-localhost connections with 403
   152→ * - ac-15: Uses plugin pattern for middleware
   153→ */
   154→export async function createServer(options: ServerOptions) {
   155→  const { port, isDaemon, kspecDir = join(process.cwd(), '.kspec'), webUiDir } = options;
   156→
   157→  // Determine startup project path (project root, not .kspec/)
   158→  // AC: @multi-directory-daemon ac-2 - daemon uses startup directory as default project
   159→  const startupProjectPath = kspecDir.endsWith('.kspec')
   160→    ? kspecDir.slice(0, -('.kspec'.length + 1)) // Remove '/.kspec'
   161→    : kspecDir;
   162→
   163→  // Import ProjectContextManager (needed for WebSocket binding)
   164→  const { ProjectContextManager } = await import('./project-context');
   165→
   166→  // AC: @daemon-server ac-17 - Resolve web UI path for static file serving
   167→  const resolvedWebUiPath = resolveWebUiPath(webUiDir);
   168→  if (resolvedWebUiPath) {
   169→    console.log(`[daemon] Web UI assets found at: ${resolvedWebUiPath}`);
   170→  } else {
   171→    console.log('[daemon] Web UI assets not found - UI will not be served');
   172→    console.log('[daemon] Build the web UI with: cd packages/web-ui && npm run build');
   173→  }
   174→
   175→  // Initialize PID file manager (uses global ~/.config/kspec/)
   176→  const pidManager = new PidFileManager();
   177→
   178→  // AC: @multi-directory-daemon ac-9 - Write PID and port files in daemon mode
   179→  if (isDaemon) {
   180→    pidManager.writePid();
   181→    pidManager.writePort(port);
   182→    console.log(`[daemon] PID file written: ${process.pid}`);
   183→    console.log(`[daemon] Port file written: ${port}`);
   184→  }
   185→
   186→  // Initialize WebSocket managers
   187→  pubsubManager = new PubSubManager();
   188→  heartbeatManager = new HeartbeatManager();
   189→  wsHandler = new WebSocketHandler(pubsubManager);
   190→
   191→  // WeakMap to store project path during WebSocket upgrade (keyed by Request object)
   192→  // Using WeakMap avoids needing to pass a requestId through beforeHandle return value,
   193→  // which breaks WebSocket upgrade in Elysia 1.4 when derive middleware is present.
   194→  const wsProjectPaths = new WeakMap<Request, string>();
   195→
   196→  const app = new Elysia()
   197→    // AC-15: Plugin pattern for middleware
   198→    // AC: @api-contract ac-1 - Allow CORS from dev server on localhost:5173
   199→    .use(cors({
   200→      origin: ['http://localhost:5173', 'http://127.0.0.1:5173'], // Dev server origins
   201→      credentials: true,
   202→      methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS']
   203→    }))
   204→
   205→    // AC-3: Enforce localhost-only connections
   206→    .onRequest(localhostOnly());
   207→
   208→  // AC: @multi-directory-daemon ac-1, ac-2, ac-3 - Project context middleware
   209→  const { manager: projectContextManager, middleware: projectMiddleware } = projectContextMiddleware({
   210→    startupProject: startupProjectPath,
   211→    pubsub: pubsubManager
   212→  });
   213→
   214→  // Store manager globally for shutdown
   215→  projectManager = projectContextManager;
   216→
   217→  app.use(projectMiddleware)
   218→
   219→    // AC-11: Health check endpoint
   220→    .get('/api/health', () => ({
   221→      status: 'ok',
   222→      uptime: process.uptime(),
   223→      connections: pubsubManager.getConnectionCount(),
   224→      version: '0.1.0'
   225→    }))
   226→
   227→    // AC: @api-contract ac-2 through ac-7 - Task API endpoints
   228→    // AC: @multi-directory-daemon ac-24 - Routes use projectContext from middleware
   229→    .use(createTasksRoutes({ pubsub: pubsubManager }))
   230→
   231→    // AC: @api-contract ac-8 through ac-11 - Spec Item API endpoints
   232→    .use(createItemsRoutes())
   233→
   234→    // AC: @api-contract ac-12 through ac-14 - Inbox API endpoints
   235→    .use(createInboxRoutes({ pubsub: pubsubManager }))
   236→
   237→    // AC: @api-contract ac-15 through ac-18 - Meta API endpoints
   238→    .use(createMetaRoutes())
   239→
   240→    // AC: @triage-daemon-api ac-1 through ac-9 - Triage API endpoints
   241→    .use(createTriageRoutes({ pubsub: pubsubManager }))
   242→
   243→    // AC: @api-contract ac-19 through ac-21 - Validation and search endpoints
   244→    .use(createValidationRoutes())
   245→
   246→    // AC: @multi-directory-daemon ac-28, ac-29, ac-30 - Projects management endpoints
   247→    .use(createProjectsRoutes({ projectManager: projectContextManager }))
   248→
   249→    // AC: @ui-session-stream ac-1, ac-4 - Session data endpoints
   250→    .use(createSessionRoutes())
   251→
   252→    // AC: @ui-plans-view ac-1 - Plans data endpoints
   253→    .use(createPlansRoutes())
   254→
   255→    // AC: @agent-dispatch-engine ac-4 - Agent dispatch API endpoints
   256→    // AC: @daemon-agent-dispatch ac-3, ac-4 - Pass pubsub for WebSocket broadcast on invocation events
   257→    .use(createAgentDispatchRoutes({ pubsub: pubsubManager }))
   258→
   259→    // AC-4: WebSocket endpoint for real-time updates
   260→    .ws<ConnectionData>('/ws', {
   261→      beforeHandle({ request, store }) {
   262→        // AC: @multi-directory-daemon ac-21, ac-22, ac-23, ac-34 - Extract and validate project binding
   263→        // AC: @multi-directory-daemon ac-34 - Browser WebSocket API doesn't support custom headers,
   264→        // so we also accept project path as query parameter
   265→        const url = new URL(request.url, `http://${request.headers.get('host')}`);
   266→        const projectPath = request.headers.get('X-Kspec-Dir')
   267→                        || url.searchParams.get('project')
   268→                        || undefined;
   269→
   270→        // IMPORTANT: Do NOT return a value from ws beforeHandle.
   271→        // In Elysia 1.4 with derive middleware, returning a value short-circuits
   272→        // the WebSocket upgrade and sends the value as an HTTP 200 response.
   273→        // Use a WeakMap keyed by Request object to pass data to open().
   274→        try {
   275→          const manager = (store as Record<string, unknown>).projectManager as import('./project-context').ProjectContextManager | undefined;
   276→          if (!manager) {
   277→            // Fallback: project manager not initialized yet
   278→            wsProjectPaths.set(request, startupProjectPath);
   279→            return;
   280→          }
   281→
   282→          let projectContext;
   283→          if (projectPath) {
   284→            // Explicit project specified
   285→            try {
   286→              projectContext = manager.getProject(projectPath);
   287→            } catch {
   288→              // AC: @multi-directory-daemon ac-4 - auto-register
   289→              projectContext = manager.registerProject(projectPath);
   290→            }
   291→          } else {
   292→            // AC: @multi-directory-daemon ac-22, ac-23 - Use default or reject
   293→            try {
   294→              projectContext = manager.getProject();
   295→            } catch (err: unknown) {
   296→              // AC: @multi-directory-daemon ac-23 - Reject when no default
   297→              if (err instanceof Error && err.message.includes('No default project configured')) {
   298→                throw new Error('No project specified');
   299→              }
   300→              throw err;
   301→            }
   302→          }
   303→
   304→          // Store resolved path for open() handler via WeakMap
   305→          wsProjectPaths.set(request, projectContext.path);
   306→        } catch (err: unknown) {
   307→          console.error(`[daemon] WebSocket connection rejected: ${err instanceof Error ? err.message : String(err)}`);
   308→          throw err;
   309→        }
   310→      },
   311→      open(ws) {
   312→        // AC: @api-contract ac-25, @trait-websocket-protocol ac-1
   313→        const sessionId = ulid();
   314→        const openContext = ws.data as { id?: unknown; request?: unknown } | undefined;
   315→        const contextId = typeof openContext?.id === 'string' ? openContext.id : undefined;
   316→
   317→        // AC: @multi-directory-daemon ac-21 - Get bound project path
   318→        // Retrieve project path from WeakMap via the request object on ws.data
   319→        const request = openContext?.request as Request | undefined;
   320→        const projectPath = request ? wsProjectPaths.get(request) || startupProjectPath : startupProjectPath;
   321→
   322→        ws.data = {
   323→          sessionId,
   324→          topics: new Set<string>(),
   325→          seq: 0,
   326→          lastPing: undefined,
   327→          lastPong: Date.now(),
   328→          projectPath // AC: @multi-directory-daemon ac-21 - immutable binding
   329→        };
   330→
   331→        pubsubManager.addConnection(sessionId, ws, contextId);
   332→        console.log(`[daemon] WebSocket client connected: ${sessionId} bound to ${projectPath} (${pubsubManager.getConnectionCount()} total)`);
   333→
   334→        // Send connected event with session_id
   335→        const connectedEvent: ConnectedEvent = {
   336→          event: 'connected',
   337→          data: {
   338→            session_id: sessionId
   339→          }
   340→        };
   341→        ws.send(JSON.stringify(connectedEvent));
   342→      },
   343→      message(ws, message) {
   344→        // AC: @api-contract ac-26, ac-27
   345→        wsHandler.handleMessage(ws, message);
   346→      },
   347→      pong(ws) {
   348→        // AC: @trait-websocket-protocol ac-5
   349→        heartbeatManager.recordPong(ws);
   350→      },
   351→      close(ws, code, reason) {
   352→        handleWebSocketClose(pubsubManager, ws, code, reason);
   353→      }
   354→    });
   355→
   356→  // AC: @daemon-server ac-17 - Serve web UI static assets
   357→  // Added after API routes so API routes take precedence
   358→  if (resolvedWebUiPath) {
   359→    const indexHtmlPath = join(resolvedWebUiPath, 'index.html');
   360→
   361→    // Serve static files from web UI build directory
   362→    app.use(await staticPlugin({
   363→      assets: resolvedWebUiPath,
   364→      prefix: '/',
   365→      noCache: process.env.NODE_ENV === 'development', // Disable cache in dev
   366→    }));
   367→
   368→    // SPA fallback routes for client-side routing
   369→    // These catch paths like /tasks, /items, /inbox that don't have static files
   370→    const spaRoutes = [
   371→      '/',
   372→      '/tasks', '/tasks/*',
   373→      '/items', '/items/*',
   374→      '/inbox',
   375→      '/observations',
   376→      '/triage',
   377→      '/validate',
   378→      '/sessions', '/sessions/*',
   379→      '/agents',
   380→      '/specs',
   381→      '/workflows',
   382→      '/plans',
   383→      '/settings',
   384→    ];
   385→    for (const route of spaRoutes) {
   386→      app.get(route, () => Bun.file(indexHtmlPath));
   387→    }
   388→
   389→    console.log('[daemon] Web UI static file serving enabled');
   390→  }
   391→
   392→  // AC-1, AC-2: Start server on localhost only
   393→  // Using 'localhost' hostname allows Bun/OS to bind to both 127.0.0.1 and ::1
   394→  app.listen({
   395→    port,
   396→    hostname: 'localhost', // Resolves to both IPv4 and IPv6 loopback
   397→  });
   398→
   399→  console.log(`[daemon] Server listening on http://localhost:${port} (IPv4: 127.0.0.1, IPv6: ::1)`);
   400→  console.log(`[daemon] WebSocket available at ws://localhost:${port}/ws`);
   401→
   402→  // AC: @agent-dispatch-engine ac-5 - Wire file change callback to dispatch engine
   403→  projectContextManager.setFileChangeCallback((projectPath, file) => {
   404→    // Only forward changes to project.tasks.yaml
   405→    if (!file.endsWith('project.tasks.yaml')) return;
   406→    const engine = getDispatchEngine(projectPath);
   407→    if (engine) {
   408→      engine.handleFileChange(projectPath).catch((err) => {
   409→        console.error('[dispatch] Error handling file change:', err);
   410→      });
   411→    }
   412→  });
   413→
   414→  // AC: @multi-directory-daemon ac-17 - Start file watcher for startup project
   415→  if (startupProjectPath) {
   416→    try {
   417→      await projectContextManager.startWatcher(startupProjectPath);
   418→      console.log(`[daemon] File watcher started for startup project: ${startupProjectPath}`);
   419→    } catch (error) {
   420→      console.error('[daemon] Failed to start file watcher for startup project:', error);
   421→    }
   422→  }
   423→
   424→  // AC: @config-shadow ac-12 - Start periodic shadow sync if remote tracking configured
   425→  if (startupProjectPath) {
   426→    try {
   427→      const { loadProjectConfig } = await import('../parser/config.js');
   428→      const { config } = await loadProjectConfig(startupProjectPath);
   429→      const syncInterval = config.shadow.sync_interval;
   430→      const worktreeDir = join(startupProjectPath, config.shadow.directory);
   431→
   432→      if (syncInterval > 0) {
   433→        shadowSyncScheduler = new ShadowSyncScheduler({
   434→          worktreeDir,
   435→          intervalSeconds: syncInterval,
   436→          shadowOptions: {
   437→            branchName: config.shadow.branch,
   438→            directory: config.shadow.directory,
   439→            remote: config.shadow.remote?.value,
   440→            remoteType: config.shadow.remote?.type,
   441→          },
   442→          pubsub: pubsubManager,
   443→        });
   444→        shadowSyncScheduler.start();
   445→      }
   446→    } catch (error) {
   447→      console.error('[daemon] Failed to initialize shadow sync scheduler:', error);
   448→    }
   449→  }
   450→
   451→  // AC: @session-branch-worktree ac-sync - Start periodic session branch sync if configured
   452→  // Session sync runs independently from kspec-meta sync — failures in one do not affect the other
   453→  if (startupProjectPath) {
   454→    try {
   455→      const { readFileSync } = await import('fs');
   456→      const { parse: parseYaml } = await import('yaml');
   457→      const manifestPath = join(startupProjectPath, '.kspec', 'kynetic.yaml');
   458→      const manifestRaw = readFileSync(manifestPath, 'utf-8');
   459→      const manifest = parseYaml(manifestRaw) as { sessions?: { storage?: string; branch?: string } } | null;
   460→
   461→      if (manifest?.sessions?.storage === 'branch') {
   462→        const { loadProjectConfig } = await import('../parser/config.js');
   463→        const { config } = await loadProjectConfig(startupProjectPath);
   464→        const syncInterval = config.shadow.sync_interval;
   465→
   466→        if (syncInterval > 0) {
   467→          const sessionBranchName = manifest.sessions.branch || 'kspec-sessions';
   468→          const sessionWorktreeDir = join(startupProjectPath, '.kspec-sessions');
   469→
   470→          sessionSyncScheduler = new SessionSyncScheduler({
   471→            worktreeDir: sessionWorktreeDir,
   472→            intervalSeconds: syncInterval,
   473→            branchName: sessionBranchName,
   474→            pubsub: pubsubManager,
   475→          });
   476→          sessionSyncScheduler.start();
   477→        }
   478→      }
   479→    } catch (error) {
   480→      // Session sync init failure does not block daemon startup
   481→      console.error('[daemon] Failed to initialize session sync scheduler:', error);
   482→    }
   483→  }
   484→
   485→  // AC: @daemon-server ac-13, ac-14 - Start heartbeat monitoring
   486→  heartbeatManager.start(pubsubManager.getAllConnections());
   487→
   488→  // AC-12: Graceful shutdown on SIGTERM/SIGINT
   489→  const shutdown = async (signal: string) => {
   490→    console.log(`[daemon] Received ${signal}, shutting down gracefully...`);
   491→
   492→    try {
   493→      // Stop heartbeat monitoring
   494→      heartbeatManager.stop();
   495→
   496→      // AC: @config-shadow ac-12 - Stop shadow sync scheduler
   497→      shadowSyncScheduler?.stop();
   498→
   499→      // AC: @session-branch-worktree ac-sync - Stop session sync scheduler
   500→      sessionSyncScheduler?.stop();
   501→
   502→      // AC: @agent-dispatch-engine ac-11 - Stop all dispatch engines before shutting down
   503→      await stopAllEngines();
   504→
   505→      // AC: @multi-directory-daemon ac-11b - Stop all file watchers
   506→      await projectContextManager.stopAllWatchers();
   507→      console.log('[daemon] All file watchers stopped');
   508→
   509→      // Close all WebSocket connections with code 1000 (clean close)
   510→      // AC: @trait-websocket-protocol ac-7
   511→      for (const [sessionId, ws] of pubsubManager.getAllConnections()) {
   512→        ws.close(1000, 'Server shutting down');
   513→      }
   514→
   515→      // Stop the server
   516→      await app.server?.stop();
   517→
   518→      // AC: @daemon-server ac-10 - Remove PID file on shutdown
   519→      if (isDaemon) {
   520→        pidManager.remove();
   521→        console.log('[daemon] PID file removed');
   522→      }
   523→
   524→      console.log('[daemon] Server stopped successfully');
   525→      process.exit(0);
   526→    } catch (error) {
   527→      console.error('[daemon] Error during shutdown:', error);
   528→      process.exit(1);
   529→    }
   530→  };
   531→
   532→  process.on('SIGTERM', () => shutdown('SIGTERM'));
   533→  process.on('SIGINT', () => shutdown('SIGINT'));
   534→
   535→  return app;
   536→}
   537→
```