```
     1→/**
     2→ * Shadow branch utilities for transparent spec/task state tracking.
     3→ *
     4→ * Shadow branch concept:
     5→ * - Orphan branch (kspec-meta) stores kspec state
     6→ * - .kspec/ directory is a git worktree pointing to shadow branch
     7→ * - Main branch gitignores .kspec/
     8→ * - All kspec read/write operations target .kspec/
     9→ * - Changes auto-commit to shadow branch
    10→ */
    11→
    12→import { execFile, spawn, spawnSync } from "node:child_process";
    13→import * as fs from "node:fs/promises";
    14→import { tmpdir } from "node:os";
    15→import * as path from "node:path";
    16→import { promisify } from "node:util";
    17→import { fileURLToPath } from "node:url";
    18→import { isBatchMode } from "../cli/batch-context.js";
    19→
    20→const __filename = fileURLToPath(import.meta.url);
    21→const __dirname = path.dirname(__filename);
    22→
    23→const execFileAsync = promisify(execFile);
    24→
    25→interface RunCommandOptions {
    26→  cwd?: string;
    27→  env?: NodeJS.ProcessEnv;
    28→}
    29→
    30→function runCommandSync(
    31→  command: string,
    32→  args: string[],
    33→  options: RunCommandOptions = {},
    34→): { ok: boolean; stdout: string; stderr: string } {
    35→  const result = spawnSync(command, args, {
    36→    cwd: options.cwd,
    37→    env: options.env,
    38→    stdio: ["ignore", "pipe", "pipe"],
    39→    encoding: "utf-8",
    40→  });
    41→
    42→  return {
    43→    ok: !result.error && result.status === 0,
    44→    stdout: (result.stdout || "").toString(),
    45→    stderr: (result.stderr || "").toString(),
    46→  };
    47→}
    48→
    49→async function runGitAsync(
    50→  cwd: string,
    51→  args: string[],
    52→  env?: NodeJS.ProcessEnv,
    53→): Promise<{ stdout: string; stderr: string }> {
    54→  const { stdout = "", stderr = "" } = await execFileAsync("git", args, {
    55→    cwd,
    56→    env,
    57→    encoding: "utf-8",
    58→  });
    59→  return { stdout: stdout.toString(), stderr: stderr.toString() };
    60→}
    61→
    62→function runGitSync(
    63→  cwd: string,
    64→  args: string[],
    65→): { ok: boolean; stdout: string } {
    66→  const result = spawnSync("git", args, {
    67→    cwd,
    68→    stdio: ["ignore", "pipe", "pipe"],
    69→    encoding: "utf-8",
    70→  });
    71→
    72→  return {
    73→    ok: !result.error && result.status === 0,
    74→    stdout: (result.stdout || "").toString(),
    75→  };
    76→}
    77→
    78→/**
    79→ * Parse git version from `git --version` output.
    80→ * Returns [major, minor, patch] or null if unparseable.
    81→ */
    82→export function getGitVersion(
    83→  cwd?: string,
    84→): [number, number, number] | null {
    85→  const result = spawnSync("git", ["--version"], {
    86→    cwd,
    87→    stdio: ["ignore", "pipe", "pipe"],
    88→    encoding: "utf-8",
    89→  });
    90→  if (result.error || result.status !== 0) return null;
    91→  const match = (result.stdout || "").match(/(\d+)\.(\d+)\.(\d+)/);
    92→  if (!match) return null;
    93→  return [Number(match[1]), Number(match[2]), Number(match[3])];
    94→}
    95→
    96→/**
    97→ * Check if the installed git supports `git worktree add --orphan` (requires >= 2.42.0).
    98→ */
    99→export function gitSupportsOrphanWorktree(cwd?: string): boolean {
   100→  const version = getGitVersion(cwd);
   101→  if (!version) return false;
   102→  const [major, minor] = version;
   103→  return major > 2 || (major === 2 && minor >= 42);
   104→}
   105→
   106→/**
   107→ * Fallback for creating an orphan branch when git < 2.42.
   108→ *
   109→ * Strategy:
   110→ * 1. Create a temp bare repo in the OS temp directory
   111→ * 2. Create an orphan branch with an empty commit there
   112→ * 3. Push that branch to the project repo (via file:// protocol)
   113→ * 4. Clean up the temp repo
   114→ * 5. Attach using standard `git worktree add <dir> <branch>`
   115→ *
   116→ * This approach NEVER modifies the project's working tree.
   117→ *
   118→ * AC: @config-shadow ac-10
   119→ */
   120→export async function createOrphanBranchFallback(
   121→  projectRoot: string,
   122→  branchName: string,
   123→  directoryName: string,
   124→): Promise<void> {
   125→  const tmpDir = await fs.mkdtemp(path.join(tmpdir(), "kspec-orphan-"));
   126→
   127→  try {
   128→    // 1. Init a bare repo in the temp dir
   129→    await runGitAsync(tmpDir, ["init", "--bare"]);
   130→
   131→    // 2. Create the orphan branch using a temporary non-bare clone.
   132→    //    We need a working tree to make a commit, so clone the bare repo.
   133→    const workDir = await fs.mkdtemp(path.join(tmpdir(), "kspec-orphan-work-"));
   134→
   135→    try {
   136→      await runGitAsync(workDir, ["clone", tmpDir, "."]);
   137→      await runGitAsync(workDir, [
   138→        "config",
   139→        "user.email",
   140→        "kspec@localhost",
   141→      ]);
   142→      await runGitAsync(workDir, [
   143→        "config",
   144→        "user.name",
   145→        "kspec",
   146→      ]);
   147→
   148→      // Create an orphan branch (checkout --orphan works on all git versions)
   149→      await runGitAsync(workDir, [
   150→        "checkout",
   151→        "--orphan",
   152→        branchName,
   153→      ]);
   154→
   155→      // Remove any files that might have been staged
   156→      try {
   157→        await runGitAsync(workDir, ["rm", "-rf", "."]);
   158→      } catch {
   159→        // May fail if nothing to remove (empty repo) - that's fine
   160→      }
   161→
   162→      // Create an empty initial commit
   163→      await runGitAsync(workDir, [
   164→        "commit",
   165→        "--allow-empty",
   166→        "-m",
   167→        `Initialize ${branchName}`,
   168→      ]);
   169→
   170→      // Push the orphan branch back to the bare repo
   171→      await runGitAsync(workDir, [
   172→        "push",
   173→        "origin",
   174→        branchName,
   175→      ]);
   176→    } finally {
   177→      await fs.rm(workDir, { recursive: true, force: true });
   178→    }
   179→
   180→    // 3. Push from the temp bare repo to the project repo
   181→    //    Use file:// protocol to ensure git treats it as a proper remote
   182→    await runGitAsync(tmpDir, [
   183→      "push",
   184→      `file://${path.resolve(projectRoot)}`,
   185→      branchName,
   186→    ]);
   187→  } finally {
   188→    // 4. Clean up the temp bare repo
   189→    await fs.rm(tmpDir, { recursive: true, force: true });
   190→  }
   191→
   192→  // 5. Attach worktree using standard git worktree add (no --orphan flag)
   193→  await runGitAsync(projectRoot, [
   194→    "worktree",
   195→    "add",
   196→    directoryName,
   197→    branchName,
   198→  ]);
   199→
   200→  // 6. Remove all tracked files from the worktree since the fallback
   201→  //    created an empty commit but `git worktree add` may still populate
   202→  //    the index from the branch. Clear anything that appeared.
   203→  try {
   204→    const { stdout } = await runGitAsync(
   205→      path.join(projectRoot, directoryName),
   206→      ["ls-files"],
   207→    );
   208→    if (stdout.trim()) {
   209→      await runGitAsync(
   210→        path.join(projectRoot, directoryName),
   211→        ["rm", "-rf", "."],
   212→      );
   213→    }
   214→  } catch {
   215→    // Nothing to remove — expected for an empty commit
   216→  }
   217→}
   218→
   219→// Import getVerboseMode for checking CLI --debug-shadow flag
   220→// We use a getter function to avoid issues with circular dependencies
   221→let getVerboseModeFunc: (() => boolean) | null = null;
   222→
   223→export function setVerboseModeGetter(getter: () => boolean): void {
   224→  getVerboseModeFunc = getter;
   225→}
   226→
   227→/**
   228→ * Shadow branch configuration
   229→ */
   230→export interface ShadowConfig {
   231→  /** Whether shadow branch is enabled/detected */
   232→  enabled: boolean;
   233→  /** Path to .kspec/ worktree directory */
   234→  worktreeDir: string;
   235→  /** Shadow branch name (default: kspec-meta) */
   236→  branchName: string;
   237→  /** Project root (where .kspec/ lives) */
   238→  projectRoot: string;
   239→}
   240→
   241→/**
   242→ * Shadow branch status
   243→ */
   244→export interface ShadowStatus {
   245→  exists: boolean;
   246→  healthy: boolean;
   247→  branchExists: boolean;
   248→  worktreeExists: boolean;
   249→  worktreeLinked: boolean;
   250→  artifactsDirExists: boolean;
   251→  error?: string;
   252→}
   253→
   254→/**
   255→ * Error types for shadow branch issues
   256→ */
   257→export class ShadowError extends Error {
   258→  constructor(
   259→    message: string,
   260→    public code:
   261→      | "NOT_INITIALIZED"
   262→      | "WORKTREE_DISCONNECTED"
   263→      | "DIRECTORY_MISSING"
   264→      | "GIT_ERROR"
   265→      | "RUNNING_FROM_SHADOW",
   266→    public suggestion: string,
   267→  ) {
   268→    super(message);
   269→    this.name = "ShadowError";
   270→  }
   271→}
   272→
   273→/**
   274→ * Default shadow branch name
   275→ */
   276→export const SHADOW_BRANCH_NAME = "kspec-meta";
   277→
   278→/**
   279→ * Default shadow worktree directory
   280→ */
   281→export const SHADOW_WORKTREE_DIR = ".kspec";
   282→
   283→/**
   284→ * Sessions storage directory name (at project root, separate from shadow worktree).
   285→ * AC: @session-storage-modes ac-sessions-dir
   286→ */
   287→export const SESSIONS_WORKTREE_DIR = ".kspec-sessions";
   288→
   289→/**
   290→ * Options for shadow branch operations.
   291→ *
   292→ * AC: @config-shadow ac-7 — all fields optional for backward compatibility
   293→ *
   294→ * When not provided, functions use SHADOW_BRANCH_NAME and SHADOW_WORKTREE_DIR constants.
   295→ */
   296→export interface ShadowOptions {
   297→  /** Branch name (default: kspec-meta) */
   298→  branchName?: string;
   299→  /** Worktree directory name (default: .kspec) */
   300→  directory?: string;
   301→  /**
   302→   * Remote target for push/pull. Can be:
   303→   * - Named remote (e.g., "origin", "specs-origin")
   304→   * - Local filesystem path (starts with /, ./, or ~)
   305→   * - Git URL (contains :// or starts with git@)
   306→   */
   307→  remote?: string;
   308→  /** Type of remote (detected from remote string) */
   309→  remoteType?: "named" | "path" | "url";
   310→}
   311→
   312→/**
   313→ * Get effective branch name from options or default.
   314→ * AC: @config-shadow ac-7 — backward compat when called without config
   315→ */
   316→function getBranchName(options?: ShadowOptions): string {
   317→  return options?.branchName ?? SHADOW_BRANCH_NAME;
   318→}
   319→
   320→/**
   321→ * Get effective directory name from options or default.
   322→ * AC: @config-shadow ac-7 — backward compat when called without config
   323→ */
   324→function getDirectoryName(options?: ShadowOptions): string {
   325→  return options?.directory ?? SHADOW_WORKTREE_DIR;
   326→}
   327→
   328→/**
   329→ * Get effective remote name from options or default.
   330→ * AC: @config-shadow ac-3 ac-7 — resolves configured remote for fetch/push/pull.
   331→ * Named remotes use the name directly; path/URL remotes use the auto-created "kspec-specs".
   332→ */
   333→function getRemoteName(options?: ShadowOptions): string {
   334→  if (!options?.remote) return "origin";
   335→  const remoteType = options.remoteType ?? "named";
   336→  if (remoteType === "path" || remoteType === "url") return "kspec-specs";
   337→  return options.remote;
   338→}
   339→
   340→/**
   341→ * Check if debug mode is enabled.
   342→ * Debug mode can be enabled via:
   343→ * - KSPEC_DEBUG=1 environment variable
   344→ * - Verbose flag (passed from CLI --debug-shadow option)
   345→ *
   346→ * When enabled, shadow branch operations output detailed information.
   347→ */
   348→export function isDebugMode(verboseFlag?: boolean): boolean {
   349→  if (process.env.KSPEC_DEBUG === "1") {
   350→    return true;
   351→  }
   352→  if (verboseFlag === true) {
   353→    return true;
   354→  }
   355→  // Check CLI --debug-shadow flag via getter
   356→  if (getVerboseModeFunc?.()) {
   357→    return true;
   358→  }
   359→  return false;
   360→}
   361→
   362→/**
   363→ * Check if we're in a git repository
   364→ */
   365→export async function isGitRepo(dir: string): Promise<boolean> {
   366→  return runGitSync(dir, ["rev-parse", "--git-dir"]).ok;
   367→}
   368→
   369→/**
   370→ * Get the git root directory
   371→ */
   372→export function getGitRoot(dir: string): string | null {
   373→  const result = runGitSync(dir, ["rev-parse", "--show-toplevel"]);
   374→  if (!result.ok) {
   375→    return null;
   376→  }
   377→  return result.stdout.trim();
   378→}
   379→
   380→/**
   381→ * Check if a branch exists
   382→ */
   383→export async function branchExists(
   384→  dir: string,
   385→  branchName: string,
   386→): Promise<boolean> {
   387→  return runGitSync(dir, [
   388→    "show-ref",
   389→    "--verify",
   390→    "--quiet",
   391→    `refs/heads/${branchName}`,
   392→  ]).ok;
   393→}
   394→
   395→/**
   396→ * Check if a directory is a valid git worktree
   397→ */
   398→export async function isValidWorktree(worktreeDir: string): Promise<boolean> {
   399→  try {
   400→    // Check if .git file exists (worktrees have a .git file, not directory)
   401→    const gitPath = path.join(worktreeDir, ".git");
   402→    const stat = await fs.stat(gitPath);
   403→
   404→    if (stat.isFile()) {
   405→      // Read the .git file to verify it points to a worktree
   406→      const content = await fs.readFile(gitPath, "utf-8");
   407→      return content.trim().startsWith("gitdir:");
   408→    }
   409→
   410→    return false;
   411→  } catch {
   412→    return false;
   413→  }
   414→}
   415→
   416→/**
   417→ * Detect if running from inside the shadow worktree directory.
   418→ * Returns the main project root if detected, null otherwise.
   419→ *
   420→ * AC: @config-shadow ac-8 — detects custom worktree directories using git metadata
   421→ *
   422→ * Detection logic:
   423→ * 1. Check if .git is a file (worktrees have .git files, not directories)
   424→ * 2. Read the gitdir reference from the .git file
   425→ * 3. Check if it points to a worktree for kspec (pattern: <project>/.git/worktrees/...)
   426→ *
   427→ * For custom directories, we detect ANY worktree that:
   428→ * - Has a kspec manifest in it (indicating it's a kspec shadow worktree)
   429→ * - Or has a worktree name containing "kspec" or the configured directory name
   430→ *
   431→ * @param cwd Current working directory
   432→ * @param configuredDirectory Optional configured directory name for matching
   433→ */
   434→export async function detectRunningFromShadowWorktree(
   435→  cwd: string,
   436→  configuredDirectory?: string,
   437→): Promise<string | null> {
   438→  try {
   439→    const gitPath = path.join(cwd, ".git");
   440→    const stat = await fs.stat(gitPath);
   441→
   442→    // Worktrees have a .git file, not directory
   443→    if (!stat.isFile()) {
   444→      return null;
   445→    }
   446→
   447→    const content = await fs.readFile(gitPath, "utf-8");
   448→    const match = content.trim().match(/^gitdir:\s*(.+)$/);
   449→    if (!match) {
   450→      return null;
   451→    }
   452→
   453→    const gitdir = match[1];
   454→
   455→    // Check if this is a worktree (pattern: <project>/.git/worktrees/<name>)
   456→    if (gitdir.includes(".git/worktrees/")) {
   457→      const worktreesMatch = gitdir.match(/^(.+)\/\.git\/worktrees\//);
   458→      if (worktreesMatch) {
   459→        const mainProjectRoot = worktreesMatch[1];
   460→        const cwdBase = path.basename(cwd);
   461→        const worktreeName = path.basename(gitdir);
   462→
   463→        // AC: ac-8 — check multiple patterns for shadow worktree detection
   464→        const directoryToCheck = configuredDirectory || SHADOW_WORKTREE_DIR;
   465→
   466→        // Check if directory name matches default, configured, or worktree contains "kspec"
   467→        if (
   468→          cwdBase === SHADOW_WORKTREE_DIR ||
   469→          cwdBase === directoryToCheck ||
   470→          worktreeName.includes("kspec")
   471→        ) {
   472→          return mainProjectRoot;
   473→        }
   474→
   475→        // Additional check: see if this directory has a kspec manifest
   476→        // This catches custom directories that don't have "kspec" in the name
   477→        try {
   478→          const files = await fs.readdir(cwd);
   479→          const hasKspecManifest = files.some(
   480→            (f) =>
   481→              (f.endsWith(".yaml") || f.endsWith(".yml")) &&
   482→              !f.includes(".tasks.") &&
   483→              !f.includes(".inbox."),
   484→          );
   485→          // Check for modules directory or tasks file as additional signals
   486→          const hasModules = files.includes("modules");
   487→          const hasTasksFile = files.some((f) => f.includes(".tasks."));
   488→
   489→          if (hasKspecManifest && (hasModules || hasTasksFile)) {
   490→            return mainProjectRoot;
   491→          }
   492→        } catch {
   493→          // Ignore read errors
   494→        }
   495→      }
   496→    }
   497→
   498→    return null;
   499→  } catch {
   500→    return null;
   501→  }
   502→}
   503→
   504→/**
   505→ * Detect shadow branch configuration from a directory.
   506→ * Returns shadow config if worktree directory exists and is valid.
   507→ *
   508→ * AC: @config-shadow ac-1 ac-2 — uses configured branch/directory names
   509→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
   510→ *
   511→ * @param startDir Directory to start detection from
   512→ * @param options Optional shadow configuration (branch name, directory)
   513→ */
   514→export async function detectShadow(
   515→  startDir: string,
   516→  options?: ShadowOptions,
   517→): Promise<ShadowConfig | null> {
   518→  const gitRoot = getGitRoot(startDir);
   519→  if (!gitRoot) {
   520→    return null;
   521→  }
   522→
   523→  const directoryName = getDirectoryName(options);
   524→  const branchName = getBranchName(options);
   525→  const worktreeDir = path.join(gitRoot, directoryName);
   526→
   527→  try {
   528→    await fs.access(worktreeDir);
   529→
   530→    // Verify it's a valid worktree
   531→    if (await isValidWorktree(worktreeDir)) {
   532→      return {
   533→        enabled: true,
   534→        worktreeDir,
   535→        branchName,
   536→        projectRoot: gitRoot,
   537→      };
   538→    }
   539→
   540→    // Directory exists but not a valid worktree
   541→    return null;
   542→  } catch {
   543→    // Worktree directory doesn't exist
   544→    return null;
   545→  }
   546→}
   547→
   548→/**
   549→ * Get detailed shadow branch status.
   550→ *
   551→ * AC: @config-shadow ac-1 ac-2 — uses configured branch/directory names
   552→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
   553→ *
   554→ * @param projectRoot Git repository root
   555→ * @param options Optional shadow configuration
   556→ */
   557→export async function getShadowStatus(
   558→  projectRoot: string,
   559→  options?: ShadowOptions,
   560→): Promise<ShadowStatus> {
   561→  const directoryName = getDirectoryName(options);
   562→  const branchName = getBranchName(options);
   563→  const worktreeDir = path.join(projectRoot, directoryName);
   564→
   565→  const status: ShadowStatus = {
   566→    exists: false,
   567→    healthy: false,
   568→    branchExists: false,
   569→    worktreeExists: false,
   570→    worktreeLinked: false,
   571→    artifactsDirExists: false,
   572→  };
   573→
   574→  // Check if we're in a git repo
   575→  if (!(await isGitRepo(projectRoot))) {
   576→    status.error = "Not a git repository";
   577→    return status;
   578→  }
   579→
   580→  // Check if branch exists
   581→  status.branchExists = await branchExists(projectRoot, branchName);
   582→
   583→  // Check if worktree directory exists
   584→  try {
   585→    await fs.access(worktreeDir);
   586→    status.worktreeExists = true;
   587→  } catch {
   588→    status.worktreeExists = false;
   589→  }
   590→
   591→  // Check if worktree is properly linked
   592→  if (status.worktreeExists) {
   593→    status.worktreeLinked = await isValidWorktree(worktreeDir);
   594→
   595→    // AC: @artifacts-directory ac-doctor-checks
   596→    try {
   597→      await fs.access(path.join(worktreeDir, "artifacts"));
   598→      status.artifactsDirExists = true;
   599→    } catch {
   600→      status.artifactsDirExists = false;
   601→    }
   602→  }
   603→
   604→  // Determine overall status
   605→  status.exists = status.branchExists || status.worktreeExists;
   606→  status.healthy =
   607→    status.branchExists && status.worktreeExists && status.worktreeLinked;
   608→
   609→  if (!status.healthy && status.exists) {
   610→    if (!status.branchExists) {
   611→      status.error = "Shadow branch missing but worktree exists";
   612→    } else if (!status.worktreeExists) {
   613→      status.error = "Shadow branch exists but worktree missing";
   614→    } else if (!status.worktreeLinked) {
   615→      status.error = "Worktree exists but not properly linked";
   616→    }
   617→  }
   618→
   619→  return status;
   620→}
   621→
   622→/**
   623→ * Result from checking config mismatch.
   624→ */
   625→export interface ShadowConfigMismatch {
   626→  /** Whether there is a mismatch */
   627→  hasMismatch: boolean;
   628→  /** Mismatched branch name (detected vs configured) */
   629→  branchMismatch?: { detected: string; configured: string };
   630→  /** Mismatched directory (detected vs configured) */
   631→  directoryMismatch?: { detected: string; configured: string };
   632→  /** Guidance message for the user */
   633→  guidance?: string;
   634→}
   635→
   636→/**
   637→ * Check if detected shadow branch settings match the configuration.
   638→ *
   639→ * AC: @config-shadow ac-9 — detect mismatch and guide user to migrate
   640→ *
   641→ * This function detects when:
   642→ * - A shadow branch exists with default settings (kspec-meta, .kspec)
   643→ * - But config specifies different settings
   644→ *
   645→ * @param projectRoot Git repository root
   646→ * @param configuredBranch Configured branch name
   647→ * @param configuredDirectory Configured directory name
   648→ */
   649→export async function checkConfigMismatch(
   650→  projectRoot: string,
   651→  configuredBranch: string,
   652→  configuredDirectory: string,
   653→): Promise<ShadowConfigMismatch> {
   654→  const result: ShadowConfigMismatch = { hasMismatch: false };
   655→
   656→  // First check if default shadow exists
   657→  const defaultStatus = await getShadowStatus(projectRoot, {
   658→    branchName: SHADOW_BRANCH_NAME,
   659→    directory: SHADOW_WORKTREE_DIR,
   660→  });
   661→
   662→  if (!defaultStatus.healthy) {
   663→    // No existing shadow with defaults - no mismatch possible
   664→    return result;
   665→  }
   666→
   667→  // Check if configured settings differ from defaults
   668→  const branchDiffers = configuredBranch !== SHADOW_BRANCH_NAME;
   669→  const directoryDiffers = configuredDirectory !== SHADOW_WORKTREE_DIR;
   670→
   671→  if (!branchDiffers && !directoryDiffers) {
   672→    // Config matches defaults - no mismatch
   673→    return result;
   674→  }
   675→
   676→  // There's a mismatch - existing shadow uses defaults but config specifies different values
   677→  result.hasMismatch = true;
   678→
   679→  if (branchDiffers) {
   680→    result.branchMismatch = {
   681→      detected: SHADOW_BRANCH_NAME,
   682→      configured: configuredBranch,
   683→    };
   684→  }
   685→
   686→  if (directoryDiffers) {
   687→    result.directoryMismatch = {
   688→      detected: SHADOW_WORKTREE_DIR,
   689→      configured: configuredDirectory,
   690→    };
   691→  }
   692→
   693→  // Build guidance message
   694→  const parts: string[] = [];
   695→  if (result.branchMismatch) {
   696→    parts.push(
   697→      `branch "${SHADOW_BRANCH_NAME}" (config wants "${configuredBranch}")`,
   698→    );
   699→  }
   700→  if (result.directoryMismatch) {
   701→    parts.push(
   702→      `directory "${SHADOW_WORKTREE_DIR}" (config wants "${configuredDirectory}")`,
   703→    );
   704→  }
   705→
   706→  result.guidance = [
   707→    `Shadow branch exists with ${parts.join(" and ")}.`,
   708→    "",
   709→    "To migrate to configured settings:",
   710→    "  1. Export your specs: kspec export --all > backup.yaml",
   711→    "  2. Remove existing shadow: rm -rf .kspec && git branch -D kspec-meta",
   712→    "  3. Re-initialize: kspec init",
   713→    "  4. Import specs: kspec import backup.yaml",
   714→    "",
   715→    "Or update kspec.config.yaml to match existing settings.",
   716→  ].join("\n");
   717→
   718→  return result;
   719→}
   720→
   721→/**
   722→ * Create an appropriate ShadowError based on status
   723→ */
   724→export function createShadowError(status: ShadowStatus): ShadowError {
   725→  if (!status.branchExists && !status.worktreeExists) {
   726→    return new ShadowError(
   727→      "Shadow branch not initialized",
   728→      "NOT_INITIALIZED",
   729→      "Run `kspec init` to create shadow branch and worktree.",
   730→    );
   731→  }
   732→
   733→  if (status.branchExists && !status.worktreeExists) {
   734→    return new ShadowError(
   735→      ".kspec/ directory missing",
   736→      "DIRECTORY_MISSING",
   737→      "Run `kspec shadow repair` to recreate the worktree.",
   738→    );
   739→  }
   740→
   741→  if (status.worktreeExists && !status.worktreeLinked) {
   742→    return new ShadowError(
   743→      "Worktree disconnected from git",
   744→      "WORKTREE_DISCONNECTED",
   745→      "Run `kspec shadow repair` to fix the worktree link.",
   746→    );
   747→  }
   748→
   749→  return new ShadowError(
   750→    status.error || "Unknown shadow branch error",
   751→    "GIT_ERROR",
   752→    "Check git status and try `kspec shadow repair`.",
   753→  );
   754→}
   755→
   756→/**
   757→ * Auto-commit changes to shadow branch.
   758→ * Called after write operations when shadow is enabled.
   759→ *
   760→ * @param worktreeDir Path to .kspec/ directory
   761→ * @param message Commit message
   762→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   763→ * @returns true if commit succeeded, false if nothing to commit
   764→ */
   765→export async function shadowAutoCommit(
   766→  worktreeDir: string,
   767→  message: string,
   768→  verbose?: boolean,
   769→): Promise<boolean> {
   770→  const debug = isDebugMode(verbose);
   771→
   772→  try {
   773→    if (debug) {
   774→      console.error(
   775→        `[DEBUG] Shadow auto-commit: git add -A (cwd: ${worktreeDir})`,
   776→      );
   777→    }
   778→
   779→    // Stage all changes
   780→    const addResult = runCommandSync("git", ["add", "-A"], { cwd: worktreeDir });
   781→    if (!addResult.ok) {
   782→      throw new Error(addResult.stderr || "git add failed");
   783→    }
   784→
   785→    // Check if there are staged changes
   786→    try {
   787→      if (debug) {
   788→        console.error(`[DEBUG] Shadow auto-commit: git diff --cached --quiet`);
   789→      }
   790→
   791→      const diffResult = runCommandSync(
   792→        "git",
   793→        ["diff", "--cached", "--quiet"],
   794→        { cwd: worktreeDir },
   795→      );
   796→      if (!diffResult.ok) {
   797→        throw new Error("changes staged");
   798→      }
   799→      // No error = no changes
   800→      if (debug) {
   801→        console.error(`[DEBUG] Shadow auto-commit: No changes to commit`);
   802→      }
   803→      return false;
   804→    } catch {
   805→      // Error = there are changes, proceed with commit
   806→    }
   807→
   808→    if (debug) {
   809→      console.error(`[DEBUG] Shadow auto-commit: git commit -m "${message}"`);
   810→    }
   811→
   812→    // Commit with message
   813→    // Set KSPEC_SHADOW_COMMIT=1 to signal authorized commit to git hooks
   814→    const commitResult = runCommandSync("git", ["commit", "-m", message], {
   815→      cwd: worktreeDir,
   816→      env: { ...process.env, KSPEC_SHADOW_COMMIT: "1" },
   817→    });
   818→    if (!commitResult.ok) {
   819→      throw new Error(commitResult.stderr || "git commit failed");
   820→    }
   821→
   822→    if (debug) {
   823→      console.error(`[DEBUG] Shadow auto-commit: Success`);
   824→    }
   825→
   826→    return true;
   827→  } catch (error) {
   828→    // AC: Only log error if debug mode enabled
   829→    if (debug) {
   830→      console.error("Shadow auto-commit failed:", error);
   831→    }
   832→    return false;
   833→  }
   834→}
   835→
   836→/**
   837→ * Generate commit message for a kspec operation.
   838→ */
   839→export function generateCommitMessage(
   840→  operation: string,
   841→  ref?: string,
   842→  detail?: string,
   843→): string {
   844→  const parts: string[] = [];
   845→
   846→  switch (operation) {
   847→    case "task-start":
   848→      parts.push(`Start @${ref}`);
   849→      break;
   850→    case "task-complete":
   851→      parts.push(`Complete @${ref}`);
   852→      if (detail) parts.push(`: ${detail}`);
   853→      break;
   854→    case "task-note":
   855→      parts.push(`Note on @${ref}`);
   856→      break;
   857→    case "task-add":
   858→      parts.push(`Add task: ${detail || ref}`);
   859→      break;
   860→    case "inbox-add":
   861→      parts.push(
   862→        `Inbox: ${detail?.slice(0, 50)}${(detail?.length || 0) > 50 ? "..." : ""}`,
   863→      );
   864→      break;
   865→    case "inbox-promote":
   866→      parts.push(`Promote to @${ref}`);
   867→      break;
   868→    case "item-add":
   869→      parts.push(`Add @${ref}`);
   870→      break;
   871→    case "item-set":
   872→      parts.push(`Update @${ref}`);
   873→      break;
   874→    case "item-delete":
   875→      parts.push(`Delete @${ref}`);
   876→      break;
   877→    case "derive":
   878→      parts.push(`Derive from @${ref}`);
   879→      break;
   880→    default:
   881→      parts.push(operation);
   882→      if (ref) parts.push(` @${ref}`);
   883→  }
   884→
   885→  return parts.join("");
   886→}
   887→
   888→/**
   889→ * Resolve a path relative to shadow worktree if enabled.
   890→ * Falls back to original path if shadow is not enabled.
   891→ *
   892→ * Uses the worktreeDir from shadowConfig for custom directory support.
   893→ */
   894→export function resolveShadowPath(
   895→  originalPath: string,
   896→  shadowConfig: ShadowConfig | null,
   897→  projectRoot: string,
   898→): string {
   899→  if (!shadowConfig?.enabled) {
   900→    return originalPath;
   901→  }
   902→
   903→  // If the path is within the project root, rewrite to shadow worktree
   904→  const relativePath = path.relative(projectRoot, originalPath);
   905→
   906→  // Get the directory name from the worktree path (supports custom directories)
   907→  const worktreeDirName = path.basename(shadowConfig.worktreeDir);
   908→
   909→  // Skip if path is outside project or already in shadow worktree
   910→  if (
   911→    relativePath.startsWith("..") ||
   912→    relativePath.startsWith(worktreeDirName)
   913→  ) {
   914→    return originalPath;
   915→  }
   916→
   917→  // Handle spec/ -> shadow worktree mapping
   918→  if (relativePath.startsWith("spec/") || relativePath.startsWith("spec\\")) {
   919→    const specRelative = relativePath.slice(5); // Remove 'spec/'
   920→    return path.join(shadowConfig.worktreeDir, specRelative);
   921→  }
   922→
   923→  // For task/inbox files at root, move to shadow worktree
   924→  if (
   925→    relativePath.endsWith(".tasks.yaml") ||
   926→    relativePath.endsWith(".inbox.yaml")
   927→  ) {
   928→    return path.join(shadowConfig.worktreeDir, relativePath);
   929→  }
   930→
   931→  return originalPath;
   932→}
   933→
   934→/**
   935→ * Commit changes to shadow branch if enabled.
   936→ * This is the primary interface for CLI commands to trigger auto-commit.
   937→ *
   938→ * @param shadowConfig Shadow configuration (from KspecContext.shadow)
   939→ * @param operation Operation type (e.g., 'task-start', 'task-complete')
   940→ * @param ref Reference slug or ULID (optional)
   941→ * @param detail Additional detail for commit message (optional)
   942→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   943→ * @returns true if committed, false if shadow not enabled or nothing to commit
   944→ */
   945→export async function commitIfShadow(
   946→  shadowConfig: ShadowConfig | null,
   947→  operation: string,
   948→  ref?: string,
   949→  detail?: string,
   950→  verbose?: boolean,
   951→): Promise<boolean> {
   952→  // Suppress auto-commits during atomic batch execution
   953→  if (isBatchMode()) {
   954→    return false;
   955→  }
   956→
   957→  if (!shadowConfig?.enabled) {
   958→    return false;
   959→  }
   960→
   961→  const message = generateCommitMessage(operation, ref, detail);
   962→  const committed = await shadowAutoCommit(
   963→    shadowConfig.worktreeDir,
   964→    message,
   965→    verbose,
   966→  );
   967→
   968→  // AC: @shadow-sync ac-1 - Fire-and-forget push after each commit
   969→  if (committed) {
   970→    shadowPushAsync(shadowConfig.worktreeDir, verbose);
   971→  }
   972→
   973→  return committed;
   974→}
   975→
   976→/**
   977→ * Check if shadow is required but not available, and throw appropriate error.
   978→ * Use this at the start of commands that require shadow mode.
   979→ *
   980→ * @param shadowConfig Shadow configuration from context
   981→ * @param projectRoot Project root for status check
   982→ * @throws ShadowError if shadow is not properly configured
   983→ */
   984→export async function requireShadow(
   985→  shadowConfig: ShadowConfig | null,
   986→  projectRoot: string,
   987→): Promise<void> {
   988→  if (shadowConfig?.enabled) {
   989→    return; // Shadow is available
   990→  }
   991→
   992→  const status = await getShadowStatus(projectRoot);
   993→  throw createShadowError(status);
   994→}
   995→
   996→/**
   997→ * Format a ShadowError for display in CLI.
   998→ * Returns a user-friendly message with suggestion.
   999→ */
  1000→export function formatShadowError(error: ShadowError): string {
  1001→  return `${error.message}\n\nSuggestion: ${error.suggestion}`;
  1002→}
  1003→
  1004→/**
  1005→ * Result from shadow initialization
  1006→ */
  1007→export interface ShadowInitResult {
  1008→  success: boolean;
  1009→  branchCreated: boolean;
  1010→  worktreeCreated: boolean;
  1011→  gitignoreUpdated: boolean;
  1012→  initialCommit: boolean;
  1013→  alreadyExists: boolean;
  1014→  /** Whether shadow was created from existing remote branch */
  1015→  createdFromRemote: boolean;
  1016→  /** Whether new branch was pushed to remote to establish tracking */
  1017→  pushedToRemote: boolean;
  1018→  /** Whether .kspec-sessions/ directory was created */
  1019→  sessionsDirectoryCreated?: boolean;
  1020→  /** Whether session branch worktree was created (sessions.storage=branch) */
  1021→  sessionBranchCreated?: boolean;
  1022→  error?: string;
  1023→}
  1024→
  1025→/**
  1026→ * Options for shadow initialization.
  1027→ *
  1028→ * AC: @config-shadow ac-1 ac-2 — branch and directory configurable
  1029→ */
  1030→export interface ShadowInitOptions {
  1031→  /** Project name for manifest */
  1032→  projectName?: string;
  1033→  /** Force reinitialize even if exists */
  1034→  force?: boolean;
  1035→  /** Shadow branch/directory/remote configuration */
  1036→  shadow?: ShadowOptions;
  1037→  /** Session storage configuration from manifest */
  1038→  sessions?: { storage?: string; branch?: string };
  1039→}
  1040→
  1041→/**
  1042→ * Check if a remote exists (default: origin)
  1043→ */
  1044→export async function hasRemote(
  1045→  projectRoot: string,
  1046→  remoteName = "origin",
  1047→): Promise<boolean> {
  1048→  try {
  1049→    const { stdout } = await runGitAsync(projectRoot, [
  1050→      "remote",
  1051→      "get-url",
  1052→      remoteName,
  1053→    ]);
  1054→    return stdout.trim().length > 0;
  1055→  } catch {
  1056→    return false;
  1057→  }
  1058→}
  1059→
  1060→/**
  1061→ * Check if a branch exists on a remote.
  1062→ * Uses git ls-remote to query the remote directly, which works in both
  1063→ * full and shallow clones.
  1064→ *
  1065→ * AC: @shadow-init-remote ac-5 — works in shallow clones
  1066→ */
  1067→export async function remoteBranchExists(
  1068→  projectRoot: string,
  1069→  branchName: string,
  1070→  remoteName = "origin",
  1071→): Promise<boolean> {
  1072→  try {
  1073→    const { stdout } = await runGitAsync(projectRoot, [
  1074→      "ls-remote",
  1075→      "--heads",
  1076→      remoteName,
  1077→      branchName,
  1078→    ]);
  1079→    return stdout.trim().length > 0;
  1080→  } catch {
  1081→    return false;
  1082→  }
  1083→}
  1084→
  1085→/**
  1086→ * Fetch from remote to ensure refs are up to date.
  1087→ * Returns true if fetch succeeded, false otherwise.
  1088→ */
  1089→export async function fetchRemote(
  1090→  projectRoot: string,
  1091→  remoteName = "origin",
  1092→): Promise<boolean> {
  1093→  try {
  1094→    await runGitAsync(projectRoot, ["fetch", remoteName]);
  1095→    return true;
  1096→  } catch {
  1097→    return false;
  1098→  }
  1099→}
  1100→
  1101→/**
  1102→ * Push shadow branch to remote with tracking.
  1103→ * Returns true if push succeeded, false otherwise.
  1104→ *
  1105→ * AC: @config-shadow ac-3 — uses configured remote name
  1106→ * AC: @config-shadow ac-7 — defaults to origin when not provided
  1107→ *
  1108→ * @param worktreeDir Path to shadow worktree
  1109→ * @param remoteName Remote name (default: origin)
  1110→ * @param options Optional shadow configuration
  1111→ */
  1112→export async function pushShadowBranch(
  1113→  worktreeDir: string,
  1114→  remoteName = "origin",
  1115→  options?: ShadowOptions,
  1116→): Promise<boolean> {
  1117→  const branchName = getBranchName(options);
  1118→  try {
  1119→    await runGitAsync(worktreeDir, ["push", "-u", remoteName, branchName]);
  1120→    return true;
  1121→  } catch {
  1122→    return false;
  1123→  }
  1124→}
  1125→
  1126→/**
  1127→ * Check if shadow branch has remote tracking configured.
  1128→ * AC-4: Used to determine whether sync should be attempted.
  1129→ *
  1130→ * AC: @config-shadow ac-7 — backward compat when called without config
  1131→ *
  1132→ * @param worktreeDir Path to shadow worktree
  1133→ * @param options Optional shadow configuration
  1134→ */
  1135→export async function hasRemoteTracking(
  1136→  worktreeDir: string,
  1137→  options?: ShadowOptions,
  1138→): Promise<boolean> {
  1139→  const branchName = getBranchName(options);
  1140→  try {
  1141→    const { stdout } = await runGitAsync(worktreeDir, [
  1142→      "config",
  1143→      `branch.${branchName}.remote`,
  1144→    ]);
  1145→    return stdout.trim().length > 0;
  1146→  } catch {
  1147→    return false;
  1148→  }
  1149→}
  1150→
  1151→/**
  1152→ * Ensure shadow branch has remote tracking configured.
  1153→ * AC-8: If shadow has no tracking but main branch has origin remote,
  1154→ * automatically configure tracking to origin/kspec-meta.
  1155→ *
  1156→ * AC: @config-shadow ac-3 ac-4 ac-5 — handles different remote types
  1157→ * AC: @config-shadow ac-6 — error with guidance if named remote doesn't exist
  1158→ * AC: @config-shadow ac-7 — backward compat when called without config
  1159→ *
  1160→ * @param worktreeDir Path to shadow worktree
  1161→ * @param projectRoot Git repository root
  1162→ * @param options Optional shadow configuration
  1163→ * @returns Result with success status and error details if applicable
  1164→ */
  1165→export async function ensureRemoteTracking(
  1166→  worktreeDir: string,
  1167→  projectRoot: string,
  1168→  options?: ShadowOptions,
  1169→): Promise<EnsureRemoteTrackingResult> {
  1170→  const branchName = getBranchName(options);
  1171→
  1172→  // Check if already has tracking
  1173→  if (await hasRemoteTracking(worktreeDir, options)) {
  1174→    return { success: true };
  1175→  }
  1176→
  1177→  // Determine remote name to use
  1178→  let remoteName = "origin";
  1179→
  1180→  if (options?.remote) {
  1181→    const remoteType = options.remoteType ?? "named";
  1182→
  1183→    if (remoteType === "named") {
  1184→      // AC: ac-3 — use the named remote directly
  1185→      remoteName = options.remote;
  1186→
  1187→      // AC: ac-6 — verify the named remote exists with guidance
  1188→      if (!(await hasRemote(projectRoot, remoteName))) {
  1189→        // Named remote doesn't exist - provide helpful guidance
  1190→        return {
  1191→          success: false,
  1192→          missingRemote: remoteName,
  1193→          guidance: `Remote '${remoteName}' does not exist. To fix this:\n` +
  1194→            `  1. Add the remote: git remote add ${remoteName} <url>\n` +
  1195→            `  2. Or update kspec.config.yaml to use an existing remote\n` +
  1196→            `  3. Or remove shadow.remote to use the default 'origin' remote`,
  1197→        };
  1198→      }
  1199→    } else if (remoteType === "path" || remoteType === "url") {
  1200→      // AC: ac-4 ac-5 — add a git remote for path/URL if not already present
  1201→      const specRemoteName = "kspec-specs";
  1202→      const hasSpecsRemote = await hasRemote(projectRoot, specRemoteName);
  1203→
  1204→      if (!hasSpecsRemote) {
  1205→        try {
  1206→          // Expand tilde for paths if needed
  1207→          let remoteTarget = options.remote;
  1208→          if (remoteType === "path" && remoteTarget.startsWith("~")) {
  1209→            remoteTarget = remoteTarget.replace(
  1210→              /^~/,
  1211→              process.env.HOME || process.env.USERPROFILE || "~",
  1212→            );
  1213→          }
  1214→
  1215→          await runGitAsync(projectRoot, [
  1216→            "remote",
  1217→            "add",
  1218→            specRemoteName,
  1219→            remoteTarget,
  1220→          ]);
  1221→        } catch {
  1222→          // Remote add failed - may already exist with different URL
  1223→          return { success: false };
  1224→        }
  1225→      }
  1226→
  1227→      remoteName = specRemoteName;
  1228→    }
  1229→  } else {
  1230→    // No remote configured - check if main branch has origin
  1231→    if (!(await hasRemote(projectRoot))) {
  1232→      return { success: false };
  1233→    }
  1234→  }
  1235→
  1236→  // Set up tracking for shadow branch
  1237→  try {
  1238→    await runGitAsync(worktreeDir, [
  1239→      "config",
  1240→      `branch.${branchName}.remote`,
  1241→      remoteName,
  1242→    ]);
  1243→    await runGitAsync(worktreeDir, [
  1244→      "config",
  1245→      `branch.${branchName}.merge`,
  1246→      `refs/heads/${branchName}`,
  1247→    ]);
  1248→    return { success: true };
  1249→  } catch {
  1250→    return { success: false };
  1251→  }
  1252→}
  1253→
  1254→/**
  1255→ * Result from ensuring remote tracking
  1256→ * AC: @config-shadow ac-6 — includes error details when named remote doesn't exist
  1257→ */
  1258→export interface EnsureRemoteTrackingResult {
  1259→  success: boolean;
  1260→  /** Error when remote doesn't exist (AC-6) */
  1261→  missingRemote?: string;
  1262→  /** Guidance message for user */
  1263→  guidance?: string;
  1264→}
  1265→
  1266→/**
  1267→ * Result from a sync operation
  1268→ */
  1269→export interface ShadowSyncResult {
  1270→  success: boolean;
  1271→  pulled: boolean;
  1272→  pushed: boolean;
  1273→  hadConflict: boolean;
  1274→  error?: string;
  1275→}
  1276→
  1277→const SHADOW_PUSH_FAILURE_ESCALATION_THRESHOLD = 3;
  1278→const shadowPushFailureCounts = new Map<string, number>();
  1279→
  1280→function summarizeShadowPushError(
  1281→  stderr: string,
  1282→  code: number | null,
  1283→  signal: NodeJS.Signals | null,
  1284→): string {
  1285→  const lines = stderr
  1286→    .split(/\r?\n/)
  1287→    .map((line) => line.trim())
  1288→    .filter(Boolean);
  1289→
  1290→  if (lines.length > 0) {
  1291→    const lastLine = lines[lines.length - 1];
  1292→    if (lastLine.length <= 240) {
  1293→      return lastLine;
  1294→    }
  1295→    return `${lastLine.slice(0, 237)}...`;
  1296→  }
  1297→
  1298→  if (code !== null) {
  1299→    return `git push exited with code ${code}`;
  1300→  }
  1301→  if (signal) {
  1302→    return `git push terminated by signal ${signal}`;
  1303→  }
  1304→  return "git push failed";
  1305→}
  1306→
  1307→function noteShadowPushFailure(worktreeDir: string, reason: string): void {
  1308→  const nextCount = (shadowPushFailureCounts.get(worktreeDir) ?? 0) + 1;
  1309→  shadowPushFailureCounts.set(worktreeDir, nextCount);
  1310→
  1311→  console.error(
  1312→    `[WARN] Shadow auto-push failed (consecutive: ${nextCount}). Local shadow commits were kept. ${reason}`,
  1313→  );
  1314→
  1315→  if (nextCount >= SHADOW_PUSH_FAILURE_ESCALATION_THRESHOLD) {
  1316→    console.error(
  1317→      `[WARN] Shadow auto-push has failed ${nextCount} times in a row. Remote shadow state is stale. Run \`kspec shadow sync\` (or \`kspec shadow resolve\` if conflicts are reported).`,
  1318→    );
  1319→  }
  1320→}
  1321→
  1322→function noteShadowPushSuccess(worktreeDir: string): void {
  1323→  shadowPushFailureCounts.delete(worktreeDir);
  1324→}
  1325→
  1326→/**
  1327→ * Pull-rebase from remote before pushing, using the kspec merge driver for
  1328→ * YAML conflict resolution.
  1329→ *
  1330→ * AC: @config-shadow ac-11 — pull-rebase before push prevents divergence
  1331→ *
  1332→ * @returns true if pull succeeded (or was unnecessary), false on conflict
  1333→ */
  1334→async function pullRebaseBeforePush(
  1335→  worktreeDir: string,
  1336→  branchName: string,
  1337→  debug: boolean,
  1338→  options?: ShadowOptions,
  1339→): Promise<boolean> {
  1340→  try {
  1341→    // Fetch latest remote state for the shadow branch specifically.
  1342→    // Using the worktree dir for fetch ensures we use the branch's tracking config.
  1343→    try {
  1344→      await runGitAsync(worktreeDir, ["fetch"]);
  1345→    } catch {
  1346→      if (debug) {
  1347→        console.error("[DEBUG] Shadow pull-rebase: fetch failed, skipping pull");
  1348→      }
  1349→      // Fetch failure is non-fatal — push may still succeed if already up to date
  1350→      return true;
  1351→    }
  1352→
  1353→    // AC: @config-shadow ac-3 — resolve the configured remote name from git config
  1354→    // instead of hardcoding "origin", so custom shadow.remote setups work correctly
  1355→    const projectRoot = path.dirname(worktreeDir);
  1356→    let remoteName = "origin";
  1357→    try {
  1358→      const { stdout } = await runGitAsync(worktreeDir, [
  1359→        "config",
  1360→        `branch.${branchName}.remote`,
  1361→      ]);
  1362→      const configured = stdout.trim();
  1363→      if (configured) {
  1364→        remoteName = configured;
  1365→      }
  1366→    } catch {
  1367→      // Fall back to origin if config lookup fails
  1368→    }
  1369→
  1370→    const remoteHasBranch = await remoteBranchExists(projectRoot, branchName, remoteName);
  1371→    if (!remoteHasBranch) {
  1372→      if (debug) {
  1373→        console.error("[DEBUG] Shadow pull-rebase: no remote branch yet, skipping pull");
  1374→      }
  1375→      return true;
  1376→    }
  1377→
  1378→    // Check if there are any upstream changes to integrate.
  1379→    // If local is already at or ahead of remote, skip the pull.
  1380→    try {
  1381→      const { stdout } = await runGitAsync(worktreeDir, [
  1382→        "rev-list",
  1383→        "--count",
  1384→        `${branchName}..@{upstream}`,
  1385→      ]);
  1386→      const behindCount = parseInt(stdout.trim(), 10);
  1387→      if (behindCount === 0) {
  1388→        if (debug) {
  1389→          console.error("[DEBUG] Shadow pull-rebase: already up to date with remote");
  1390→        }
  1391→        return true;
  1392→      }
  1393→    } catch {
  1394→      // rev-list may fail if upstream isn't set — proceed with pull attempt
  1395→    }
  1396→
  1397→    // Try fast-forward first (cleanest, no rebase needed)
  1398→    try {
  1399→      await runGitAsync(worktreeDir, ["pull", "--ff-only"]);
  1400→      if (debug) {
  1401→        console.error("[DEBUG] Shadow pull-rebase: fast-forward succeeded");
  1402→      }
  1403→      return true;
  1404→    } catch {
  1405→      // FF failed, need rebase
  1406→    }
  1407→
  1408→    // Fall back to rebase — the kspec merge driver handles YAML conflicts
  1409→    try {
  1410→      await runGitAsync(worktreeDir, ["pull", "--rebase"]);
  1411→      if (debug) {
  1412→        console.error("[DEBUG] Shadow pull-rebase: rebase succeeded");
  1413→      }
  1414→      return true;
  1415→    } catch {
  1416→      // Rebase failed — abort and report
  1417→    }
  1418→
  1419→    // Abort the failed rebase so local state is clean
  1420→    try {
  1421→      await runGitAsync(worktreeDir, ["rebase", "--abort"]);
  1422→    } catch {
  1423→      // May not be in rebase state
  1424→    }
  1425→
  1426→    if (debug) {
  1427→      console.error("[DEBUG] Shadow pull-rebase: conflict detected, push skipped");
  1428→    }
  1429→    return false;
  1430→  } catch (err) {
  1431→    if (debug) {
  1432→      console.error("[DEBUG] Shadow pull-rebase error:", err);
  1433→    }
  1434→    // Pull failure is non-fatal — still attempt push
  1435→    return true;
  1436→  }
  1437→}
  1438→
  1439→/**
  1440→ * Fire-and-forget push to remote with pull-rebase-before-push.
  1441→ * AC-1: Called after each auto-commit when tracking is configured.
  1442→ * AC-8: Automatically sets up tracking if main branch has remote.
  1443→ * AC: @config-shadow ac-11 — pull-rebase before push for bidirectional sync.
  1444→ * Push failures are surfaced as warnings, but local commits still succeed.
  1445→ *
  1446→ * AC: @config-shadow ac-7 — backward compat when called without config
  1447→ *
  1448→ * @param worktreeDir Path to shadow worktree
  1449→ * @param verbose Enable debug output
  1450→ * @param options Optional shadow configuration
  1451→ */
  1452→export async function shadowPushAsync(
  1453→  worktreeDir: string,
  1454→  verbose?: boolean,
  1455→  options?: ShadowOptions,
  1456→): Promise<void> {
  1457→  const debug = isDebugMode(verbose);
  1458→
  1459→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
  1460→  const projectRoot = path.dirname(worktreeDir);
  1461→  const trackingResult = await ensureRemoteTracking(worktreeDir, projectRoot, options);
  1462→
  1463→  // AC: @config-shadow ac-6 — log guidance if named remote doesn't exist
  1464→  if (!trackingResult.success && trackingResult.missingRemote) {
  1465→    if (debug) {
  1466→      console.error(`[DEBUG] Shadow push: ${trackingResult.guidance}`);
  1467→    }
  1468→    return;
  1469→  }
  1470→
  1471→  // Check if tracking is configured before attempting push
  1472→  if (!(await hasRemoteTracking(worktreeDir, options))) {
  1473→    if (debug) {
  1474→      console.error(
  1475→        "[DEBUG] Shadow push: No remote tracking configured, skipping",
  1476→      );
  1477→    }
  1478→    return; // AC: @shadow-sync ac-4 - silently skip if no tracking
  1479→  }
  1480→
  1481→  // AC: @config-shadow ac-11 — pull-rebase before pushing to integrate remote changes
  1482→  const branchName = getBranchName(options);
  1483→  const pullOk = await pullRebaseBeforePush(worktreeDir, branchName, debug, options);
  1484→  if (!pullOk) {
  1485→    noteShadowPushFailure(
  1486→      worktreeDir,
  1487→      "Pull-rebase failed due to conflicts. Run `kspec shadow resolve` to fix.",
  1488→    );
  1489→    return;
  1490→  }
  1491→
  1492→  try {
  1493→    if (debug) {
  1494→      console.error(`[DEBUG] Shadow push: git push (cwd: ${worktreeDir})`);
  1495→    }
  1496→
  1497→    // Fire and forget: detached + unref allows CLI exit without waiting for push.
  1498→    // We still collect stderr and exit code while process is alive to surface failures.
  1499→    const child = spawn("git", ["push"], {
  1500→      cwd: worktreeDir,
  1501→      stdio: ["ignore", "ignore", "pipe"],
  1502→      detached: true,
  1503→    });
  1504→
  1505→    const stderrChunks: string[] = [];
  1506→    child.stderr?.setEncoding("utf-8");
  1507→    child.stderr?.on("data", (chunk) => {
  1508→      stderrChunks.push(chunk);
  1509→    });
  1510→    child.stderr?.resume();
  1511→
  1512→    (child.stderr as { unref?: () => void } | null)?.unref?.();
  1513→    child.unref();
  1514→    if (debug) {
  1515→      console.error("[DEBUG] Shadow push: spawned background git push");
  1516→    }
  1517→
  1518→    const exit = await new Promise<{
  1519→      code: number | null;
  1520→      signal: NodeJS.Signals | null;
  1521→      error?: Error;
  1522→    }>((resolve) => {
  1523→      let settled = false;
  1524→      const finish = (result: {
  1525→        code: number | null;
  1526→        signal: NodeJS.Signals | null;
  1527→        error?: Error;
  1528→      }) => {
  1529→        if (settled) {
  1530→          return;
  1531→        }
  1532→        settled = true;
  1533→        resolve(result);
  1534→      };
  1535→
  1536→      child.once("error", (error) => finish({ code: null, signal: null, error }));
  1537→      child.once("close", (code, signal) => finish({ code, signal }));
  1538→    });
  1539→
  1540→    if (exit.error) {
  1541→      noteShadowPushFailure(worktreeDir, exit.error.message);
  1542→      if (debug) {
  1543→        console.error("[DEBUG] Shadow push spawn error:", exit.error);
  1544→      }
  1545→      return;
  1546→    }
  1547→
  1548→    if (exit.code !== 0) {
  1549→      const reason = summarizeShadowPushError(
  1550→        stderrChunks.join(""),
  1551→        exit.code,
  1552→        exit.signal,
  1553→      );
  1554→      noteShadowPushFailure(worktreeDir, reason);
  1555→      return;
  1556→    }
  1557→
  1558→    noteShadowPushSuccess(worktreeDir);
  1559→  } catch (err) {
  1560→    const reason = err instanceof Error ? err.message : String(err);
  1561→    noteShadowPushFailure(worktreeDir, reason);
  1562→
  1563→    if (debug) {
  1564→      console.error("[DEBUG] Shadow push error:", err);
  1565→    }
  1566→  }
  1567→}
  1568→
  1569→/**
  1570→ * Pull remote changes to shadow branch.
  1571→ * AC-2: Called at session start to sync before operations.
  1572→ * AC-6: Uses --ff-only first, falls back to --rebase.
  1573→ * AC-3: On conflict, returns failure with suggestion.
  1574→ * AC-8: Automatically sets up tracking if main branch has remote.
  1575→ *
  1576→ * AC: @config-shadow ac-7 — backward compat when called without config
  1577→ *
  1578→ * @param worktreeDir Path to shadow worktree
  1579→ * @param options Optional shadow configuration
  1580→ */
  1581→// In-flight dedup: if a pull is already running for this worktree, piggyback
  1582→// on its result instead of starting a concurrent stash/pull/pop sequence.
  1583→const pullInflight = new Map<string, Promise<ShadowSyncResult>>();
  1584→
  1585→export function shadowPull(
  1586→  worktreeDir: string,
  1587→  options?: ShadowOptions,
  1588→): Promise<ShadowSyncResult> {
  1589→  const key = path.resolve(worktreeDir);
  1590→  const existing = pullInflight.get(key);
  1591→  if (existing) {
  1592→    return existing;
  1593→  }
  1594→  const promise = shadowPullImpl(worktreeDir, options).finally(() => {
  1595→    pullInflight.delete(key);
  1596→  });
  1597→  pullInflight.set(key, promise);
  1598→  return promise;
  1599→}
  1600→
  1601→async function shadowPullImpl(
  1602→  worktreeDir: string,
  1603→  options?: ShadowOptions,
  1604→): Promise<ShadowSyncResult> {
  1605→  const branchName = getBranchName(options);
  1606→  const result: ShadowSyncResult = {
  1607→    success: false,
  1608→    pulled: false,
  1609→    pushed: false,
  1610→    hadConflict: false,
  1611→  };
  1612→
  1613→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
  1614→  const projectRoot = path.dirname(worktreeDir);
  1615→  const trackingResult = await ensureRemoteTracking(worktreeDir, projectRoot, options);
  1616→
  1617→  // AC: @config-shadow ac-6 — error with guidance if named remote doesn't exist
  1618→  if (!trackingResult.success && trackingResult.missingRemote) {
  1619→    result.error = trackingResult.guidance;
  1620→    return result;
  1621→  }
  1622→
  1623→  // AC: @shadow-sync ac-4 - Skip if no remote tracking
  1624→  if (!(await hasRemoteTracking(worktreeDir, options))) {
  1625→    result.success = true;
  1626→    return result;
  1627→  }
  1628→
  1629→  // Check if remote branch exists before attempting pull
  1630→  // AC: @config-shadow ac-3 — use configured remote instead of hardcoded origin
  1631→  const remoteName = getRemoteName(options);
  1632→  // Fetch first to ensure refs are up to date
  1633→  await fetchRemote(projectRoot, remoteName);
  1634→  const remoteHasBranch = await remoteBranchExists(projectRoot, branchName, remoteName);
  1635→  if (!remoteHasBranch) {
  1636→    // Remote branch doesn't exist yet - nothing to pull, but success
  1637→    result.success = true;
  1638→    return result;
  1639→  }
  1640→
  1641→  // Stash uncommitted changes before pulling to avoid false conflict reports
  1642→  let stashed = false;
  1643→  try {
  1644→    const { stdout } = await runGitAsync(worktreeDir, ["stash", "push", "-m", "shadow-sync-auto"]);
  1645→    stashed = !stdout.includes("No local changes");
  1646→  } catch {
  1647→    // If stash fails, skip the pull entirely — don't risk reporting a false conflict
  1648→    result.success = true;
  1649→    return result;
  1650→  }
  1651→
  1652→  const unstash = async () => {
  1653→    if (stashed) {
  1654→      try {
  1655→        await runGitAsync(worktreeDir, ["stash", "pop"]);
  1656→      } catch {
  1657→        // Stash pop conflict is unlikely but leave stash intact if it happens
  1658→      }
  1659→    }
  1660→  };
  1661→
  1662→  try {
  1663→    // Try fast-forward only first (cleanest)
  1664→    await runGitAsync(worktreeDir, ["pull", "--ff-only"]);
  1665→    await unstash();
  1666→    result.success = true;
  1667→    result.pulled = true;
  1668→    return result;
  1669→  } catch {
  1670→    // Fast-forward failed, try rebase
  1671→  }
  1672→
  1673→  try {
  1674→    // AC: @shadow-sync ac-6 - Fall back to rebase
  1675→    await runGitAsync(worktreeDir, ["pull", "--rebase"]);
  1676→    await unstash();
  1677→    result.success = true;
  1678→    result.pulled = true;
  1679→    return result;
  1680→  } catch {
  1681→    // Rebase failed - likely conflict
  1682→  }
  1683→
  1684→  // AC: @shadow-sync ac-3 - Conflict detected - abort rebase and report
  1685→  try {
  1686→    await runGitAsync(worktreeDir, ["rebase", "--abort"]);
  1687→  } catch {
  1688→    // May not be in rebase state, ignore
  1689→  }
  1690→
  1691→  await unstash();
  1692→  result.hadConflict = true;
  1693→  result.error = "Sync conflict detected. Run `kspec shadow resolve` to fix.";
  1694→  return result;
  1695→}
  1696→
  1697→/**
  1698→ * Full sync operation: pull then push.
  1699→ * Used by session start and explicit sync commands.
  1700→ *
  1701→ * AC: @config-shadow ac-7 — backward compat when called without config
  1702→ *
  1703→ * @param worktreeDir Path to shadow worktree
  1704→ * @param options Optional shadow configuration
  1705→ */
  1706→export async function shadowSync(
  1707→  worktreeDir: string,
  1708→  options?: ShadowOptions,
  1709→): Promise<ShadowSyncResult> {
  1710→  // First pull
  1711→  const pullResult = await shadowPull(worktreeDir, options);
  1712→  if (!pullResult.success) {
  1713→    return pullResult;
  1714→  }
  1715→
  1716→  // Then push (only if tracking configured, checked inside)
  1717→  if (await hasRemoteTracking(worktreeDir, options)) {
  1718→    try {
  1719→      await runGitAsync(worktreeDir, ["push"]);
  1720→      pullResult.pushed = true;
  1721→    } catch {
  1722→      // Push failed - not a critical error, local state is correct
  1723→      // Could be permissions, network, etc.
  1724→    }
  1725→  }
  1726→
  1727→  return pullResult;
  1728→}
  1729→
  1730→/**
  1731→ * Check if .gitignore has uncommitted changes
  1732→ */
  1733→async function hasUncommittedGitignore(projectRoot: string): Promise<boolean> {
  1734→  try {
  1735→    // Check both staged and unstaged changes to .gitignore
  1736→    const { stdout } = await runGitAsync(projectRoot, [
  1737→      "status",
  1738→      "--porcelain",
  1739→      ".gitignore",
  1740→    ]);
  1741→    return stdout.trim().length > 0;
  1742→  } catch {
  1743→    return false;
  1744→  }
  1745→}
  1746→
  1747→/**
  1748→ * Commit only .gitignore with a message.
  1749→ *
  1750→ * @param projectRoot Git repository root
  1751→ * @param directoryName Shadow directory name (for commit message)
  1752→ */
  1753→async function commitGitignore(
  1754→  projectRoot: string,
  1755→  directoryName: string,
  1756→): Promise<void> {
  1757→  await runGitAsync(projectRoot, ["add", ".gitignore"]);
  1758→  await runGitAsync(projectRoot, [
  1759→    "commit",
  1760→    "-m",
  1761→    `chore: add ${directoryName}/ to .gitignore for shadow branch`,
  1762→  ]);
  1763→}
  1764→
  1765→/**
  1766→ * Add shadow directory to .gitignore if not already present.
  1767→ * Fails if .gitignore has uncommitted changes.
  1768→ * Commits the change after adding.
  1769→ *
  1770→ * AC: @config-shadow ac-2 — uses configured directory name
  1771→ * AC: @config-shadow ac-7 — defaults to .kspec when not provided
  1772→ *
  1773→ * @param projectRoot Git repository root
  1774→ * @param options Optional shadow configuration
  1775→ */
  1776→async function ensureGitignore(
  1777→  projectRoot: string,
  1778→  options?: ShadowOptions,
  1779→): Promise<boolean> {
  1780→  const directoryName = getDirectoryName(options);
  1781→  const gitignorePath = path.join(projectRoot, ".gitignore");
  1782→  const entry = `${directoryName}/`;
  1783→
  1784→  // Fail fast if .gitignore has uncommitted changes
  1785→  if (await hasUncommittedGitignore(projectRoot)) {
  1786→    throw new ShadowError(
  1787→      ".gitignore has uncommitted changes",
  1788→      "GIT_ERROR",
  1789→      "Commit or stash your .gitignore changes before running kspec init.",
  1790→    );
  1791→  }
  1792→
  1793→  try {
  1794→    let content = "";
  1795→    try {
  1796→      content = await fs.readFile(gitignorePath, "utf-8");
  1797→    } catch {
  1798→      // File doesn't exist, will create
  1799→    }
  1800→
  1801→    // Check if already present (handle various formats)
  1802→    const lines = content.split("\n");
  1803→    const patterns = [
  1804→      directoryName,
  1805→      `${directoryName}/`,
  1806→      `/${directoryName}`,
  1807→      `/${directoryName}/`,
  1808→    ];
  1809→
  1810→    for (const line of lines) {
  1811→      const trimmed = line.trim();
  1812→      if (patterns.includes(trimmed)) {
  1813→        return false; // Already present
  1814→      }
  1815→    }
  1816→
  1817→    // Add to gitignore
  1818→    const newContent =
  1819→      content.endsWith("\n") || content === ""
  1820→        ? `${content}${entry}\n`
  1821→        : `${content}\n${entry}\n`;
  1822→
  1823→    await fs.writeFile(gitignorePath, newContent, "utf-8");
  1824→
  1825→    // Commit the change
  1826→    await commitGitignore(projectRoot, directoryName);
  1827→
  1828→    return true;
  1829→  } catch (error) {
  1830→    if (error instanceof ShadowError) {
  1831→      throw error;
  1832→    }
  1833→    throw new ShadowError(
  1834→      `Failed to update .gitignore: ${error}`,
  1835→      "GIT_ERROR",
  1836→      "Check file permissions for .gitignore",
  1837→    );
  1838→  }
  1839→}
  1840→
  1841→/**
  1842→ * Add .kspec-sessions/ to root .gitignore if not already present.
  1843→ * Does NOT commit — caller is responsible for committing if needed.
  1844→ *
  1845→ * AC: @session-storage-modes ac-gitignore
  1846→ *
  1847→ * @param projectRoot Git repository root
  1848→ * @returns true if entry was added, false if already present
  1849→ */
  1850→export async function needsSessionsGitignore(
  1851→  projectRoot: string,
  1852→): Promise<boolean> {
  1853→  const gitignorePath = path.join(projectRoot, ".gitignore");
  1854→
  1855→  let content = "";
  1856→  try {
  1857→    content = await fs.readFile(gitignorePath, "utf-8");
  1858→  } catch {
  1859→    // File doesn't exist — entry is needed
  1860→    return true;
  1861→  }
  1862→
  1863→  const lines = content.split("\n");
  1864→  const patterns = [
  1865→    SESSIONS_WORKTREE_DIR,
  1866→    `${SESSIONS_WORKTREE_DIR}/`,
  1867→    `/${SESSIONS_WORKTREE_DIR}`,
  1868→    `/${SESSIONS_WORKTREE_DIR}/`,
  1869→  ];
  1870→
  1871→  for (const line of lines) {
  1872→    const trimmed = line.trim();
  1873→    if (patterns.includes(trimmed)) {
  1874→      return false; // Already present
  1875→    }
  1876→  }
  1877→
  1878→  return true;
  1879→}
  1880→
  1881→export async function ensureSessionsGitignore(
  1882→  projectRoot: string,
  1883→): Promise<boolean> {
  1884→  const gitignorePath = path.join(projectRoot, ".gitignore");
  1885→  const entry = `${SESSIONS_WORKTREE_DIR}/`;
  1886→
  1887→  try {
  1888→    const needed = await needsSessionsGitignore(projectRoot);
  1889→    if (!needed) {
  1890→      return false;
  1891→    }
  1892→
  1893→    let content = "";
  1894→    try {
  1895→      content = await fs.readFile(gitignorePath, "utf-8");
  1896→    } catch {
  1897→      // File doesn't exist, will create
  1898→    }
  1899→
  1900→    // Add to gitignore
  1901→    const newContent =
  1902→      content.endsWith("\n") || content === ""
  1903→        ? `${content}${entry}\n`
  1904→        : `${content}\n${entry}\n`;
  1905→
  1906→    await fs.writeFile(gitignorePath, newContent, "utf-8");
  1907→    return true;
  1908→  } catch (error) {
  1909→    throw new ShadowError(
  1910→      `Failed to update .gitignore with sessions directory: ${error}`,
  1911→      "GIT_ERROR",
  1912→      "Check file permissions for .gitignore",
  1913→    );
  1914→  }
  1915→}
  1916→
  1917→/**
  1918→ * Add sessions/ to .kspec/.gitignore to prevent legacy session data
  1919→ * from being tracked on kspec-meta shadow branch.
  1920→ *
  1921→ * AC: @session-legacy-migration ac-shadow-gitignore
  1922→ *
  1923→ * @param projectRoot Git repository root
  1924→ * @param options Optional shadow configuration for directory name
  1925→ * @returns true if entry was added, false if already present
  1926→ */
  1927→export async function needsShadowSessionsGitignore(
  1928→  projectRoot: string,
  1929→  options?: ShadowOptions,
  1930→): Promise<boolean> {
  1931→  const directoryName = getDirectoryName(options);
  1932→  const shadowGitignorePath = path.join(projectRoot, directoryName, ".gitignore");
  1933→  const entry = "sessions/";
  1934→
  1935→  try {
  1936→    const content = await fs.readFile(shadowGitignorePath, "utf-8");
  1937→    const lines = content.split("\n");
  1938→    if (lines.some((line) => line.trim() === entry || line.trim() === "sessions")) {
  1939→      return false; // Already present
  1940→    }
  1941→    return true;
  1942→  } catch {
  1943→    // File doesn't exist — can't add to non-existent file
  1944→    return false;
  1945→  }
  1946→}
  1947→
  1948→export async function ensureShadowSessionsGitignore(
  1949→  projectRoot: string,
  1950→  options?: ShadowOptions,
  1951→): Promise<boolean> {
  1952→  const directoryName = getDirectoryName(options);
  1953→  const shadowGitignorePath = path.join(projectRoot, directoryName, ".gitignore");
  1954→  const entry = "sessions/";
  1955→
  1956→  try {
  1957→    const needed = await needsShadowSessionsGitignore(projectRoot, options);
  1958→    if (!needed) {
  1959→      return false;
  1960→    }
  1961→
  1962→    let content = "";
  1963→    try {
  1964→      content = await fs.readFile(shadowGitignorePath, "utf-8");
  1965→    } catch {
  1966→      // File doesn't exist — this shouldn't happen since init creates it,
  1967→      // but handle gracefully
  1968→      return false;
  1969→    }
  1970→
  1971→    // Add to gitignore
  1972→    const newContent =
  1973→      content.endsWith("\n") || content === ""
  1974→        ? `${content}${entry}\n`
  1975→        : `${content}\n${entry}\n`;
  1976→
  1977→    await fs.writeFile(shadowGitignorePath, newContent, "utf-8");
  1978→    return true;
  1979→  } catch (error) {
  1980→    // Non-fatal — shadow gitignore update is best-effort
  1981→    return false;
  1982→  }
  1983→}
  1984→
  1985→/**
  1986→ * Generate initial manifest content for shadow branch
  1987→ */
  1988→function generateShadowManifest(projectName: string): string {
  1989→  return `# ${projectName} - Kynetic Spec
  1990→# Generated by kspec init
  1991→
  1992→kynetic: "1.0"
  1993→
  1994→project:
  1995→  name: "${projectName}"
  1996→  version: "0.1.0"
  1997→  status: draft
  1998→  description: |
  1999→    Add your project description here.
  2000→
  2001→# Module includes
  2002→includes:
  2003→  - modules/main.yaml
  2004→`;
  2005→}
  2006→
  2007→/**
  2008→ * Generate initial module content
  2009→ */
  2010→function generateShadowModule(projectName: string): string {
  2011→  return `# ${projectName} - Main Module
  2012→# Add your spec items here
  2013→
  2014→items: []
  2015→`;
  2016→}
  2017→
  2018→/**
  2019→ * Generate initial tasks file
  2020→ */
  2021→function generateShadowTasks(projectName: string): string {
  2022→  return `# ${projectName} - Tasks
  2023→# Track implementation work here
  2024→
  2025→tasks: []
  2026→`;
  2027→}
  2028→
  2029→/**
  2030→ * Generate initial inbox file
  2031→ */
  2032→function generateShadowInbox(): string {
  2033→  return `# Inbox - Quick Capture
  2034→# Ideas and notes that haven't been triaged yet
  2035→
  2036→items: []
  2037→`;
  2038→}
  2039→
  2040→/**
  2041→ * Get the kspec package root directory.
  2042→ * Navigates from dist/parser/ to package root.
  2043→ */
  2044→function getPackageRoot(): string {
  2045→  return path.resolve(__dirname, "..", "..");
  2046→}
  2047→
  2048→/**
  2049→ * Install pre-commit hook to protect kspec-meta branch.
  2050→ * Hook prevents direct commits to shadow branch unless KSPEC_SHADOW_COMMIT=1.
  2051→ *
  2052→ * Note: Git worktrees use hooks from the main .git/hooks directory (via commondir),
  2053→ * not from .git/worktrees/-kspec/hooks. So we install to main hooks directory.
  2054→ *
  2055→ * The hook source is located in the kspec package's templates/hooks/ directory.
  2056→ *
  2057→ * @param projectRoot Git repository root
  2058→ * @returns true if hook was installed, false if already exists
  2059→ */
  2060→async function installShadowHook(projectRoot: string): Promise<boolean> {
  2061→  const hooksDir = path.join(projectRoot, ".git", "hooks");
  2062→  const hookPath = path.join(hooksDir, "pre-commit");
  2063→
  2064→  // Look for hook in package templates directory
  2065→  const packageRoot = getPackageRoot();
  2066→  const sourceHookPath = path.join(packageRoot, "templates", "hooks", "pre-commit");
  2067→
  2068→  try {
  2069→    // Check if source hook exists in package templates
  2070→    try {
  2071→      await fs.access(sourceHookPath);
  2072→    } catch {
  2073→      // Source hook doesn't exist - skip installation
  2074→      return false;
  2075→    }
  2076→
  2077→    // Check if hook already exists
  2078→    try {
  2079→      await fs.access(hookPath);
  2080→      // Hook exists - don't overwrite (user may have custom hooks)
  2081→      return false;
  2082→    } catch {
  2083→      // Hook doesn't exist - install it
  2084→    }
  2085→
  2086→    // Copy hook from package templates
  2087→    const hookContent = await fs.readFile(sourceHookPath, "utf-8");
  2088→    await fs.writeFile(hookPath, hookContent, { mode: 0o755 });
  2089→    return true;
  2090→  } catch (_error) {
  2091→    // Silently fail - hook installation is optional
  2092→    return false;
  2093→  }
  2094→}
  2095→
  2096→/**
  2097→ * Convert project name to slug (kebab-case)
  2098→ */
  2099→function toSlug(projectName: string): string {
  2100→  return projectName
  2101→    .toLowerCase()
  2102→    .replace(/[^a-z0-9]+/g, "-")
  2103→    .replace(/^-|-$/g, "");
  2104→}
  2105→
  2106→/**
  2107→ * Configure git merge driver for kspec YAML files.
  2108→ * AC: @yaml-merge-driver ac-12
  2109→ *
  2110→ * Configures the merge driver in .git/config and adds .gitattributes in the shadow branch.
  2111→ *
  2112→ * @param projectRoot Git repository root
  2113→ * @param worktreeDir Path to shadow worktree directory
  2114→ * @returns true if configuration was successful
  2115→ */
  2116→async function configureMergeDriver(
  2117→  projectRoot: string,
  2118→  worktreeDir: string,
  2119→): Promise<boolean> {
  2120→  try {
  2121→    // Step 1: Configure merge driver in .git/config
  2122→    const kspecPathResult = runCommandSync("which", ["kspec"]);
  2123→    if (!kspecPathResult.ok) {
  2124→      throw new Error(kspecPathResult.stderr || "kspec executable not found");
  2125→    }
  2126→    const kspecPath = kspecPathResult.stdout.trim();
  2127→
  2128→    // Add merge driver configuration to git config
  2129→    try {
  2130→      const setNameResult = runCommandSync(
  2131→        "git",
  2132→        ["config", "merge.kspec.name", "Kspec YAML semantic merge driver"],
  2133→        { cwd: projectRoot },
  2134→      );
  2135→      if (!setNameResult.ok) {
  2136→        throw new Error(setNameResult.stderr || "failed to set merge.kspec.name");
  2137→      }
  2138→
  2139→      const setDriverResult = runCommandSync(
  2140→        "git",
  2141→        [
  2142→          "config",
  2143→          "merge.kspec.driver",
  2144→          `${kspecPath} merge-driver %O %A %B --non-interactive`,
  2145→        ],
  2146→        { cwd: projectRoot },
  2147→      );
  2148→      if (!setDriverResult.ok) {
  2149→        throw new Error(setDriverResult.stderr || "failed to set merge.kspec.driver");
  2150→      }
  2151→    } catch (error) {
  2152→      // Config may fail if already set - check if it's set correctly
  2153→      try {
  2154→        const existingDriverResult = runCommandSync(
  2155→          "git",
  2156→          ["config", "merge.kspec.driver"],
  2157→          { cwd: projectRoot },
  2158→        );
  2159→        if (!existingDriverResult.ok) {
  2160→          throw new Error(existingDriverResult.stderr || "failed to read merge.kspec.driver");
  2161→        }
  2162→        const existingDriver = existingDriverResult.stdout.trim();
  2163→
  2164→        if (!existingDriver.includes("kspec merge-driver")) {
  2165→          throw new Error("Merge driver config exists but is incorrect");
  2166→        }
  2167→
  2168→        // Ensure --non-interactive flag is present (older registrations may lack it)
  2169→        if (!existingDriver.includes("--non-interactive")) {
  2170→          const fixResult = runCommandSync(
  2171→            "git",
  2172→            [
  2173→              "config",
  2174→              "merge.kspec.driver",
  2175→              `${kspecPath} merge-driver %O %A %B --non-interactive`,
  2176→            ],
  2177→            { cwd: projectRoot },
  2178→          );
  2179→          if (!fixResult.ok) {
  2180→            throw new Error(
  2181→              fixResult.stderr || "failed to update merge.kspec.driver with --non-interactive",
  2182→            );
  2183→          }
  2184→        }
  2185→      } catch {
  2186→        throw error; // Re-throw original error
  2187→      }
  2188→    }
  2189→
  2190→    // Step 2: Create .gitattributes in shadow branch
  2191→    const gitattributesPath = path.join(worktreeDir, ".gitattributes");
  2192→
  2193→    // Check if .gitattributes exists
  2194→    let existingContent = "";
  2195→    try {
  2196→      existingContent = await fs.readFile(gitattributesPath, "utf-8");
  2197→    } catch {
  2198→      // File doesn't exist, that's fine
  2199→    }
  2200→
  2201→    // Check if merge driver is already configured
  2202→    if (!existingContent.includes("merge=kspec")) {
  2203→      const attributesContent = existingContent
  2204→        ? existingContent + "\n"
  2205→        : "# Git attributes for kspec\n\n";
  2206→
  2207→      await fs.writeFile(
  2208→        gitattributesPath,
  2209→        attributesContent + "*.yaml merge=kspec\n*.yml merge=kspec\n",
  2210→        "utf-8",
  2211→      );
  2212→
  2213→      // Commit .gitattributes to shadow branch
  2214→      await shadowAutoCommit(worktreeDir, "Configure kspec merge driver");
  2215→    }
  2216→
  2217→    return true;
  2218→  } catch (_error) {
  2219→    // Silently fail - merge driver configuration is optional
  2220→    return false;
  2221→  }
  2222→}
  2223→
  2224→/**
  2225→ * Initialize shadow branch and worktree.
  2226→ * Creates orphan branch, worktree, updates gitignore, and creates initial structure.
  2227→ *
  2228→ * AC: @config-shadow ac-1 — creates orphan branch with configured name
  2229→ * AC: @config-shadow ac-2 — creates worktree at configured directory
  2230→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
  2231→ *
  2232→ * @param projectRoot Git repository root
  2233→ * @param options Initialization options
  2234→ * @returns Result indicating what was created
  2235→ */
  2236→export async function initializeShadow(
  2237→  projectRoot: string,
  2238→  options: ShadowInitOptions = {},
  2239→): Promise<ShadowInitResult> {
  2240→  const result: ShadowInitResult = {
  2241→    success: false,
  2242→    branchCreated: false,
  2243→    worktreeCreated: false,
  2244→    gitignoreUpdated: false,
  2245→    initialCommit: false,
  2246→    alreadyExists: false,
  2247→    createdFromRemote: false,
  2248→    pushedToRemote: false,
  2249→  };
  2250→
  2251→  // Check if we're in a git repo
  2252→  if (!(await isGitRepo(projectRoot))) {
  2253→    result.error = "Not a git repository";
  2254→    return result;
  2255→  }
  2256→
  2257→  // AC: ac-1 ac-2 — use configured branch/directory or defaults
  2258→  const branchName = getBranchName(options.shadow);
  2259→  const directoryName = getDirectoryName(options.shadow);
  2260→  const worktreeDir = path.join(projectRoot, directoryName);
  2261→
  2262→  // Check current status with configured options
  2263→  const status = await getShadowStatus(projectRoot, options.shadow);
  2264→
  2265→  // Handle existing shadow branch
  2266→  if (status.healthy && !options.force) {
  2267→    result.alreadyExists = true;
  2268→    result.success = true;
  2269→    return result;
  2270→  }
  2271→
  2272→  // Derive project name if not provided
  2273→  const projectName =
  2274→    options.projectName ||
  2275→    path
  2276→      .basename(projectRoot)
  2277→      .replace(/[-_]/g, " ")
  2278→      .replace(/\b\w/g, (c) => c.toUpperCase());
  2279→
  2280→  const slug = toSlug(projectName);
  2281→
  2282→  // Determine remote name to use
  2283→  let remoteName = "origin";
  2284→  if (options.shadow?.remote && options.shadow.remoteType === "named") {
  2285→    remoteName = options.shadow.remote;
  2286→  }
  2287→
  2288→  // Check for remote shadow branch
  2289→  // AC: @shadow-init-remote ac-4 ac-5 — queries remote directly via ls-remote
  2290→  const remoteExists = await hasRemote(projectRoot, remoteName);
  2291→  let remoteHasShadow = false;
  2292→  if (remoteExists) {
  2293→    remoteHasShadow = await remoteBranchExists(projectRoot, branchName, remoteName);
  2294→  }
  2295→
  2296→  try {
  2297→    // Step 1: Update .gitignore first (before creating worktree)
  2298→    result.gitignoreUpdated = await ensureGitignore(projectRoot, options.shadow);
  2299→
  2300→    // Step 1b: Also add .kspec-sessions/ to .gitignore
  2301→    // AC: @session-storage-modes ac-gitignore
  2302→    const sessionsAdded = await ensureSessionsGitignore(projectRoot);
  2303→    if (sessionsAdded) {
  2304→      // Commit .kspec-sessions/ gitignore entry (may be separate commit if .kspec/ was already present)
  2305→      await runGitAsync(projectRoot, ["add", ".gitignore"]);
  2306→      await runGitAsync(projectRoot, [
  2307→        "commit",
  2308→        "-m",
  2309→        `chore: add ${SESSIONS_WORKTREE_DIR}/ to .gitignore for session storage`,
  2310→      ]);
  2311→    }
  2312→
  2313→    // Step 1c: Create .kspec-sessions/ directory
  2314→    // AC: @session-storage-modes ac-sessions-dir-autocreate
  2315→    const sessionsDir = path.join(projectRoot, SESSIONS_WORKTREE_DIR);
  2316→    await fs.mkdir(sessionsDir, { recursive: true });
  2317→    result.sessionsDirectoryCreated = true;
  2318→
  2319→    // Step 2: Create worktree with orphan branch (or attach to existing branch)
  2320→    if (!status.worktreeExists || !status.worktreeLinked) {
  2321→      // Remove existing directory if present but not linked
  2322→      if (status.worktreeExists && !status.worktreeLinked) {
  2323→        await fs.rm(worktreeDir, { recursive: true, force: true });
  2324→      }
  2325→
  2326→      // Remove stale worktree reference if any
  2327→      try {
  2328→        await runGitAsync(projectRoot, [
  2329→          "worktree",
  2330→          "remove",
  2331→          directoryName,
  2332→          "--force",
  2333→        ]);
  2334→      } catch {
  2335→        // Ignore - worktree may not exist in git's list
  2336→      }
  2337→
  2338→      if (remoteHasShadow) {
  2339→        // AC: @shadow-init-remote ac-1, ac-5 - Remote has shadow branch - fetch and create worktree
  2340→        // Fetch with refspec to create a local branch ref (required in shallow clones
  2341→        // where plain `git fetch origin kspec-meta` only populates FETCH_HEAD)
  2342→        await runGitAsync(projectRoot, [
  2343→          "fetch",
  2344→          remoteName,
  2345→          `${branchName}:${branchName}`,
  2346→        ]);
  2347→        await runGitAsync(projectRoot, [
  2348→          "worktree",
  2349→          "add",
  2350→          directoryName,
  2351→          branchName,
  2352→        ]);
  2353→        // Set up tracking for the branch
  2354→        // Use git config directly — `git branch --set-upstream-to` requires
  2355→        // the remote tracking ref to exist locally, which may not be the case
  2356→        // in shallow clones where we only fetched the branch itself
  2357→        await runGitAsync(projectRoot, [
  2358→          "config",
  2359→          `branch.${branchName}.remote`,
  2360→          remoteName,
  2361→        ]);
  2362→        await runGitAsync(projectRoot, [
  2363→          "config",
  2364→          `branch.${branchName}.merge`,
  2365→          `refs/heads/${branchName}`,
  2366→        ]);
  2367→        result.createdFromRemote = true;
  2368→      } else if (!status.branchExists) {
  2369→        // AC: @shadow-init-remote ac-2 ac-3 - No remote branch or no remote - create orphan branch
  2370→        // AC: @config-shadow ac-1 — use configured branch name
  2371→        // AC: @config-shadow ac-10 — fallback for git < 2.42
  2372→        if (gitSupportsOrphanWorktree(projectRoot)) {
  2373→          await runGitAsync(projectRoot, [
  2374→            "worktree",
  2375→            "add",
  2376→            "--orphan",
  2377→            "-b",
  2378→            branchName,
  2379→            directoryName,
  2380→          ]);
  2381→        } else {
  2382→          await createOrphanBranchFallback(
  2383→            projectRoot,
  2384→            branchName,
  2385→            directoryName,
  2386→          );
  2387→        }
  2388→        result.branchCreated = true;
  2389→      } else {
  2390→        // Attach to existing local branch
  2391→        await runGitAsync(projectRoot, [
  2392→          "worktree",
  2393→          "add",
  2394→          directoryName,
  2395→          branchName,
  2396→        ]);
  2397→      }
  2398→
  2399→      result.worktreeCreated = true;
  2400→    }
  2401→
  2402→    // Step 3: Create initial structure if empty (only for new branches, not remote)
  2403→    const manifestPath = path.join(worktreeDir, `${slug}.yaml`);
  2404→    const modulesDir = path.join(worktreeDir, "modules");
  2405→    const moduleFilePath = path.join(modulesDir, "main.yaml");
  2406→    const tasksPath = path.join(worktreeDir, `${slug}.tasks.yaml`);
  2407→    const inboxPath = path.join(worktreeDir, `${slug}.inbox.yaml`);
  2408→
  2409→    let filesCreated = false;
  2410→
  2411→    // Only create files if manifest doesn't exist (remote branches will have files)
  2412→    try {
  2413→      // Look for any .yaml manifest file (project name may differ)
  2414→      const files = await fs.readdir(worktreeDir);
  2415→      const hasManifest = files.some(
  2416→        (f) =>
  2417→          f.endsWith(".yaml") &&
  2418→          !f.includes(".tasks.") &&
  2419→          !f.includes(".inbox."),
  2420→      );
  2421→      if (!hasManifest) {
  2422→        throw new Error("No manifest found");
  2423→      }
  2424→    } catch {
  2425→      // Manifest doesn't exist, create initial structure
  2426→      await fs.mkdir(modulesDir, { recursive: true });
  2427→      await fs.writeFile(
  2428→        manifestPath,
  2429→        generateShadowManifest(projectName),
  2430→        "utf-8",
  2431→      );
  2432→      await fs.writeFile(
  2433→        moduleFilePath,
  2434→        generateShadowModule(projectName),
  2435→        "utf-8",
  2436→      );
  2437→      await fs.writeFile(tasksPath, generateShadowTasks(projectName), "utf-8");
  2438→      await fs.writeFile(inboxPath, generateShadowInbox(), "utf-8");
  2439→
  2440→      // AC: @artifacts-directory ac-init-creates, ac-gitignore-entry
  2441→      const artifactsDir = path.join(worktreeDir, "artifacts");
  2442→      await fs.mkdir(artifactsDir, { recursive: true });
  2443→      // AC: @session-legacy-migration ac-shadow-gitignore — sessions/ not tracked on kspec-meta
  2444→      await fs.writeFile(
  2445→        path.join(worktreeDir, ".gitignore"),
  2446→        "# Ephemeral artifacts - reports, exports, generated files\n# Not tracked in shadow branch\nartifacts/\n\n# Sessions stored in .kspec-sessions/ at project root, not on shadow branch\nsessions/\n",
  2447→        "utf-8",
  2448→      );
  2449→
  2450→      filesCreated = true;
  2451→    }
  2452→
  2453→    // Step 4: Initial commit if files were created
  2454→    if (filesCreated) {
  2455→      result.initialCommit = await shadowAutoCommit(
  2456→        worktreeDir,
  2457→        `Initialize ${projectName} spec`,
  2458→      );
  2459→    }
  2460→
  2461→    // Step 5: AC-2: Push new branch to remote to establish tracking
  2462→    if (result.branchCreated && remoteExists && !remoteHasShadow) {
  2463→      result.pushedToRemote = await pushShadowBranch(worktreeDir, remoteName, options.shadow);
  2464→    }
  2465→
  2466→    // Step 6: Install pre-commit hook to protect shadow branch
  2467→    await installShadowHook(projectRoot);
  2468→
  2469→    // Step 7: Configure merge driver for semantic YAML merging
  2470→    // AC: @yaml-merge-driver ac-12
  2471→    await configureMergeDriver(projectRoot, worktreeDir);
  2472→
  2473→    // Step 8: Initialize session branch worktree if sessions.storage is "branch"
  2474→    // AC: @session-branch-worktree ac-init
  2475→    if (options.sessions?.storage === "branch") {
  2476→      const { initializeSessionBranch } = await import("./session-branch.js");
  2477→      const sessionBranchName = options.sessions.branch || "kspec-sessions";
  2478→      const sessionResult = await initializeSessionBranch(
  2479→        projectRoot,
  2480→        sessionBranchName,
  2481→      );
  2482→      if (sessionResult.success) {
  2483→        result.sessionBranchCreated = true;
  2484→      }
  2485→      // Non-fatal: session branch failure doesn't block shadow init
  2486→    }
  2487→
  2488→    result.success = true;
  2489→    return result;
  2490→  } catch (error) {
  2491→    result.error = error instanceof Error ? error.message : String(error);
  2492→    return result;
  2493→  }
  2494→}
  2495→
  2496→/**
  2497→ * Repair a broken shadow branch setup.
  2498→ * Handles cases where worktree is disconnected or directory is missing.
  2499→ *
  2500→ * AC: @config-shadow ac-7 — backward compat when called without config
  2501→ *
  2502→ * @param projectRoot Git repository root
  2503→ * @param options Optional shadow configuration
  2504→ * @returns Result indicating what was repaired
  2505→ */
  2506→export async function repairShadow(
  2507→  projectRoot: string,
  2508→  options?: ShadowOptions,
  2509→): Promise<ShadowInitResult> {
  2510→  const branchName = getBranchName(options);
  2511→  const directoryName = getDirectoryName(options);
  2512→  const status = await getShadowStatus(projectRoot, options);
  2513→
  2514→  if (status.healthy) {
  2515→    return {
  2516→      success: true,
  2517→      branchCreated: false,
  2518→      worktreeCreated: false,
  2519→      gitignoreUpdated: false,
  2520→      initialCommit: false,
  2521→      alreadyExists: true,
  2522→      createdFromRemote: false,
  2523→      pushedToRemote: false,
  2524→    };
  2525→  }
  2526→
  2527→  if (!status.branchExists) {
  2528→    // Can't repair without a branch - need full init
  2529→    return {
  2530→      success: false,
  2531→      branchCreated: false,
  2532→      worktreeCreated: false,
  2533→      gitignoreUpdated: false,
  2534→      initialCommit: false,
  2535→      alreadyExists: false,
  2536→      createdFromRemote: false,
  2537→      pushedToRemote: false,
  2538→      error: "Shadow branch does not exist. Run `kspec init` instead.",
  2539→    };
  2540→  }
  2541→
  2542→  // Branch exists but worktree is broken - repair it
  2543→  const worktreeDir = path.join(projectRoot, directoryName);
  2544→
  2545→  try {
  2546→    // Remove stale worktree reference
  2547→    try {
  2548→      await runGitAsync(projectRoot, [
  2549→        "worktree",
  2550→        "remove",
  2551→        directoryName,
  2552→        "--force",
  2553→      ]);
  2554→    } catch {
  2555→      // Ignore - worktree may not be in git's list
  2556→    }
  2557→
  2558→    // Remove directory if exists (handles corrupted .git file case)
  2559→    await fs.rm(worktreeDir, { recursive: true, force: true });
  2560→
  2561→    // Prune stale worktree references (cleans up orphaned entries)
  2562→    try {
  2563→      await runGitAsync(projectRoot, ["worktree", "prune"]);
  2564→    } catch {
  2565→      // Ignore - prune is best-effort
  2566→    }
  2567→
  2568→    // Recreate worktree
  2569→    await runGitAsync(projectRoot, [
  2570→      "worktree",
  2571→      "add",
  2572→      directoryName,
  2573→      branchName,
  2574→    ]);
  2575→
  2576→    // Install pre-commit hook
  2577→    await installShadowHook(projectRoot);
  2578→
  2579→    // AC: @artifacts-directory ac-repair-recreates
  2580→    const artifactsDir = path.join(worktreeDir, "artifacts");
  2581→    await fs.mkdir(artifactsDir, { recursive: true });
  2582→
  2583→    return {
  2584→      success: true,
  2585→      branchCreated: false,
  2586→      worktreeCreated: true,
  2587→      gitignoreUpdated: false,
  2588→      initialCommit: false,
  2589→      alreadyExists: false,
  2590→      createdFromRemote: false,
  2591→      pushedToRemote: false,
  2592→    };
  2593→  } catch (error) {
  2594→    return {
  2595→      success: false,
  2596→      branchCreated: false,
  2597→      worktreeCreated: false,
  2598→      gitignoreUpdated: false,
  2599→      initialCommit: false,
  2600→      alreadyExists: false,
  2601→      createdFromRemote: false,
  2602→      pushedToRemote: false,
  2603→      error: error instanceof Error ? error.message : String(error),
  2604→    };
  2605→  }
  2606→}
  2607→
```