```
     1→/**
     2→ * Session branch worktree management.
     3→ *
     4→ * When sessions.storage is "branch", sessions are stored in a git worktree
     5→ * on a named orphan branch (default: "kspec-sessions") at .kspec-sessions/.
     6→ * This provides git-tracked session persistence independent of kspec-meta.
     7→ *
     8→ * AC: @session-branch-worktree — all ACs
     9→ */
    10→
    11→import { execFile, spawnSync } from "node:child_process";
    12→import * as fs from "node:fs/promises";
    13→import * as path from "node:path";
    14→import { promisify } from "node:util";
    15→import {
    16→  branchExists,
    17→  gitSupportsOrphanWorktree,
    18→  createOrphanBranchFallback,
    19→  isGitRepo,
    20→  isValidWorktree,
    21→  hasRemoteTracking,
    22→  SESSIONS_WORKTREE_DIR,
    23→  type ShadowSyncResult,
    24→  type ShadowOptions,
    25→} from "./shadow.js";
    26→import { isBatchMode } from "../cli/batch-context.js";
    27→
    28→const execFileAsync = promisify(execFile);
    29→
    30→// ─── Constants ──────────────────────────────────────────────────────────────
    31→
    32→/** Default session branch name */
    33→export const SESSION_BRANCH_NAME = "kspec-sessions";
    34→
    35→// ─── Types ──────────────────────────────────────────────────────────────────
    36→
    37→/** Configuration for session branch mode */
    38→export interface SessionBranchConfig {
    39→  /** Whether session branch mode is enabled */
    40→  enabled: boolean;
    41→  /** Path to .kspec-sessions/ worktree directory */
    42→  worktreeDir: string;
    43→  /** Session branch name (default: kspec-sessions) */
    44→  branchName: string;
    45→  /** Project root */
    46→  projectRoot: string;
    47→}
    48→
    49→/** Status of the session branch worktree */
    50→export interface SessionBranchStatus {
    51→  exists: boolean;
    52→  healthy: boolean;
    53→  branchExists: boolean;
    54→  worktreeExists: boolean;
    55→  worktreeLinked: boolean;
    56→  error?: string;
    57→}
    58→
    59→/** Result from session branch initialization */
    60→export interface SessionBranchInitResult {
    61→  success: boolean;
    62→  branchCreated: boolean;
    63→  worktreeCreated: boolean;
    64→  alreadyExists: boolean;
    65→  error?: string;
    66→}
    67→
    68→// ─── Git Helpers ────────────────────────────────────────────────────────────
    69→
    70→async function runGitAsync(
    71→  cwd: string,
    72→  args: string[],
    73→  env?: NodeJS.ProcessEnv,
    74→): Promise<{ stdout: string; stderr: string }> {
    75→  const { stdout = "", stderr = "" } = await execFileAsync("git", args, {
    76→    cwd,
    77→    env,
    78→    encoding: "utf-8",
    79→  });
    80→  return { stdout: stdout.toString(), stderr: stderr.toString() };
    81→}
    82→
    83→function isDebugMode(): boolean {
    84→  return process.env.KSPEC_DEBUG === "1" || process.env.KSPEC_DEBUG === "true";
    85→}
    86→
    87→// ─── Session Branch Status ──────────────────────────────────────────────────
    88→
    89→/**
    90→ * Get the status of the session branch worktree.
    91→ *
    92→ * AC: @session-branch-worktree ac-status
    93→ */
    94→export async function getSessionBranchStatus(
    95→  projectRoot: string,
    96→  branchName: string = SESSION_BRANCH_NAME,
    97→): Promise<SessionBranchStatus> {
    98→  const worktreeDir = path.join(projectRoot, SESSIONS_WORKTREE_DIR);
    99→
   100→  const status: SessionBranchStatus = {
   101→    exists: false,
   102→    healthy: false,
   103→    branchExists: false,
   104→    worktreeExists: false,
   105→    worktreeLinked: false,
   106→  };
   107→
   108→  if (!(await isGitRepo(projectRoot))) {
   109→    status.error = "Not a git repository";
   110→    return status;
   111→  }
   112→
   113→  // Check if branch exists
   114→  status.branchExists = await branchExists(projectRoot, branchName);
   115→
   116→  // Check if worktree directory exists
   117→  try {
   118→    await fs.access(worktreeDir);
   119→    status.worktreeExists = true;
   120→  } catch {
   121→    status.worktreeExists = false;
   122→  }
   123→
   124→  // Check if worktree is properly linked
   125→  if (status.worktreeExists) {
   126→    status.worktreeLinked = await isValidWorktree(worktreeDir);
   127→  }
   128→
   129→  // Determine overall status
   130→  status.exists = status.branchExists || status.worktreeExists;
   131→  status.healthy =
   132→    status.branchExists && status.worktreeExists && status.worktreeLinked;
   133→
   134→  if (!status.healthy && status.exists) {
   135→    if (!status.branchExists) {
   136→      status.error = "Session branch missing but worktree exists";
   137→    } else if (!status.worktreeExists) {
   138→      status.error = "Session branch exists but worktree missing";
   139→    } else if (!status.worktreeLinked) {
   140→      status.error = "Session worktree exists but not properly linked";
   141→    }
   142→  }
   143→
   144→  return status;
   145→}
   146→
   147→// ─── Session Branch Init ────────────────────────────────────────────────────
   148→
   149→/**
   150→ * Initialize session branch worktree.
   151→ * Creates an orphan branch and worktree at .kspec-sessions/.
   152→ *
   153→ * AC: @session-branch-worktree ac-init
   154→ */
   155→export async function initializeSessionBranch(
   156→  projectRoot: string,
   157→  branchName: string = SESSION_BRANCH_NAME,
   158→): Promise<SessionBranchInitResult> {
   159→  const result: SessionBranchInitResult = {
   160→    success: false,
   161→    branchCreated: false,
   162→    worktreeCreated: false,
   163→    alreadyExists: false,
   164→  };
   165→
   166→  if (!(await isGitRepo(projectRoot))) {
   167→    result.error = "Not a git repository";
   168→    return result;
   169→  }
   170→
   171→  const directoryName = SESSIONS_WORKTREE_DIR;
   172→  const worktreeDir = path.join(projectRoot, directoryName);
   173→
   174→  // Check current status
   175→  const status = await getSessionBranchStatus(projectRoot, branchName);
   176→
   177→  if (status.healthy) {
   178→    result.alreadyExists = true;
   179→    result.success = true;
   180→    return result;
   181→  }
   182→
   183→  try {
   184→    // Check for remote branch
   185→    let remoteName = "origin";
   186→    let remoteHasBranch = false;
   187→    try {
   188→      const { stdout } = await runGitAsync(projectRoot, [
   189→        "remote",
   190→        "get-url",
   191→        remoteName,
   192→      ]);
   193→      if (stdout.trim().length > 0) {
   194→        const { stdout: lsOut } = await runGitAsync(projectRoot, [
   195→          "ls-remote",
   196→          "--heads",
   197→          remoteName,
   198→          branchName,
   199→        ]);
   200→        remoteHasBranch = lsOut.trim().length > 0;
   201→      }
   202→    } catch {
   203→      // No remote configured
   204→    }
   205→
   206→    // Remove existing worktree/directory if broken
   207→    if (status.worktreeExists && !status.worktreeLinked) {
   208→      await fs.rm(worktreeDir, { recursive: true, force: true });
   209→    }
   210→
   211→    // Remove stale worktree reference
   212→    try {
   213→      await runGitAsync(projectRoot, [
   214→        "worktree",
   215→        "remove",
   216→        directoryName,
   217→        "--force",
   218→      ]);
   219→    } catch {
   220→      // Ignore
   221→    }
   222→
   223→    // Prune stale worktree references
   224→    try {
   225→      await runGitAsync(projectRoot, ["worktree", "prune"]);
   226→    } catch {
   227→      // Ignore
   228→    }
   229→
   230→    if (remoteHasBranch) {
   231→      // Fetch from remote and create worktree
   232→      await runGitAsync(projectRoot, [
   233→        "fetch",
   234→        remoteName,
   235→        `${branchName}:${branchName}`,
   236→      ]);
   237→      await runGitAsync(projectRoot, [
   238→        "worktree",
   239→        "add",
   240→        directoryName,
   241→        branchName,
   242→      ]);
   243→      // Set up tracking
   244→      await runGitAsync(projectRoot, [
   245→        "config",
   246→        `branch.${branchName}.remote`,
   247→        remoteName,
   248→      ]);
   249→      await runGitAsync(projectRoot, [
   250→        "config",
   251→        `branch.${branchName}.merge`,
   252→        `refs/heads/${branchName}`,
   253→      ]);
   254→    } else if (!status.branchExists) {
   255→      // Create orphan branch
   256→      if (gitSupportsOrphanWorktree(projectRoot)) {
   257→        await runGitAsync(projectRoot, [
   258→          "worktree",
   259→          "add",
   260→          "--orphan",
   261→          "-b",
   262→          branchName,
   263→          directoryName,
   264→        ]);
   265→      } else {
   266→        await createOrphanBranchFallback(
   267→          projectRoot,
   268→          branchName,
   269→          directoryName,
   270→        );
   271→      }
   272→      result.branchCreated = true;
   273→
   274→      // Create initial empty commit so the branch is valid
   275→      await runGitAsync(worktreeDir, ["add", "-A"], {
   276→        ...process.env,
   277→        KSPEC_SHADOW_COMMIT: "1",
   278→      });
   279→      // Create a .gitkeep so the first commit has content
   280→      await fs.writeFile(
   281→        path.join(worktreeDir, ".gitkeep"),
   282→        "# Session storage - managed by kspec\n",
   283→        "utf-8",
   284→      );
   285→      await runGitAsync(worktreeDir, ["add", "-A"], {
   286→        ...process.env,
   287→        KSPEC_SHADOW_COMMIT: "1",
   288→      });
   289→      await runGitAsync(
   290→        worktreeDir,
   291→        ["commit", "-m", "Initialize session storage"],
   292→        { ...process.env, KSPEC_SHADOW_COMMIT: "1" },
   293→      );
   294→
   295→      // Push to remote if available
   296→      try {
   297→        const { stdout } = await runGitAsync(projectRoot, [
   298→          "remote",
   299→          "get-url",
   300→          remoteName,
   301→        ]);
   302→        if (stdout.trim().length > 0) {
   303→          await runGitAsync(worktreeDir, [
   304→            "push",
   305→            "-u",
   306→            remoteName,
   307→            branchName,
   308→          ]);
   309→        }
   310→      } catch {
   311→        // No remote, fine
   312→      }
   313→    } else {
   314→      // Attach to existing local branch
   315→      await runGitAsync(projectRoot, [
   316→        "worktree",
   317→        "add",
   318→        directoryName,
   319→        branchName,
   320→      ]);
   321→    }
   322→
   323→    result.worktreeCreated = true;
   324→    result.success = true;
   325→    return result;
   326→  } catch (error) {
   327→    result.error = error instanceof Error ? error.message : String(error);
   328→    return result;
   329→  }
   330→}
   331→
   332→// ─── Session Branch Repair ──────────────────────────────────────────────────
   333→
   334→/**
   335→ * Repair a broken session branch worktree.
   336→ *
   337→ * AC: @session-branch-worktree ac-repair
   338→ */
   339→export async function repairSessionBranch(
   340→  projectRoot: string,
   341→  branchName: string = SESSION_BRANCH_NAME,
   342→): Promise<SessionBranchInitResult> {
   343→  const status = await getSessionBranchStatus(projectRoot, branchName);
   344→
   345→  if (status.healthy) {
   346→    return {
   347→      success: true,
   348→      branchCreated: false,
   349→      worktreeCreated: false,
   350→      alreadyExists: true,
   351→    };
   352→  }
   353→
   354→  if (!status.branchExists) {
   355→    return {
   356→      success: false,
   357→      branchCreated: false,
   358→      worktreeCreated: false,
   359→      alreadyExists: false,
   360→      error:
   361→        "Session branch does not exist. Run `kspec init` or `kspec setup` with sessions.storage=branch to initialize.",
   362→    };
   363→  }
   364→
   365→  const directoryName = SESSIONS_WORKTREE_DIR;
   366→  const worktreeDir = path.join(projectRoot, directoryName);
   367→
   368→  try {
   369→    // Remove stale worktree reference
   370→    try {
   371→      await runGitAsync(projectRoot, [
   372→        "worktree",
   373→        "remove",
   374→        directoryName,
   375→        "--force",
   376→      ]);
   377→    } catch {
   378→      // Ignore
   379→    }
   380→
   381→    // Remove directory if exists
   382→    await fs.rm(worktreeDir, { recursive: true, force: true });
   383→
   384→    // Prune stale worktree references
   385→    try {
   386→      await runGitAsync(projectRoot, ["worktree", "prune"]);
   387→    } catch {
   388→      // Ignore
   389→    }
   390→
   391→    // Recreate worktree
   392→    await runGitAsync(projectRoot, [
   393→      "worktree",
   394→      "add",
   395→      directoryName,
   396→      branchName,
   397→    ]);
   398→
   399→    return {
   400→      success: true,
   401→      branchCreated: false,
   402→      worktreeCreated: true,
   403→      alreadyExists: false,
   404→    };
   405→  } catch (error) {
   406→    return {
   407→      success: false,
   408→      branchCreated: false,
   409→      worktreeCreated: false,
   410→      alreadyExists: false,
   411→      error: error instanceof Error ? error.message : String(error),
   412→    };
   413→  }
   414→}
   415→
   416→// ─── Session Branch Auto-Commit ─────────────────────────────────────────────
   417→
   418→/**
   419→ * Auto-commit changes to the session branch.
   420→ * Called at session lifecycle boundaries (create, close, stale cleanup, compact).
   421→ *
   422→ * AC: @session-branch-worktree ac-commit-boundaries
   423→ */
   424→export async function sessionBranchAutoCommit(
   425→  worktreeDir: string,
   426→  message: string,
   427→): Promise<boolean> {
   428→  const debug = isDebugMode();
   429→
   430→  try {
   431→    if (debug) {
   432→      console.error(
   433→        `[DEBUG] Session branch auto-commit: git add -A (cwd: ${worktreeDir})`,
   434→      );
   435→    }
   436→
   437→    // Stage all changes
   438→    const addResult = spawnSync("git", ["add", "-A"], {
   439→      cwd: worktreeDir,
   440→      stdio: ["ignore", "pipe", "pipe"],
   441→      encoding: "utf-8",
   442→    });
   443→    if (addResult.error || addResult.status !== 0) {
   444→      throw new Error(addResult.stderr || "git add failed");
   445→    }
   446→
   447→    // Check if there are staged changes
   448→    const diffResult = spawnSync(
   449→      "git",
   450→      ["diff", "--cached", "--quiet"],
   451→      {
   452→        cwd: worktreeDir,
   453→        stdio: ["ignore", "pipe", "pipe"],
   454→        encoding: "utf-8",
   455→      },
   456→    );
   457→    if (!diffResult.error && diffResult.status === 0) {
   458→      // No changes
   459→      if (debug) {
   460→        console.error(
   461→          `[DEBUG] Session branch auto-commit: No changes to commit`,
   462→        );
   463→      }
   464→      return false;
   465→    }
   466→
   467→    if (debug) {
   468→      console.error(
   469→        `[DEBUG] Session branch auto-commit: git commit -m "${message}"`,
   470→      );
   471→    }
   472→
   473→    // Commit with KSPEC_SHADOW_COMMIT=1 to authorize past git hooks
   474→    const commitResult = spawnSync("git", ["commit", "-m", message], {
   475→      cwd: worktreeDir,
   476→      env: { ...process.env, KSPEC_SHADOW_COMMIT: "1" },
   477→      stdio: ["ignore", "pipe", "pipe"],
   478→      encoding: "utf-8",
   479→    });
   480→    if (commitResult.error || commitResult.status !== 0) {
   481→      throw new Error(commitResult.stderr || "git commit failed");
   482→    }
   483→
   484→    if (debug) {
   485→      console.error(`[DEBUG] Session branch auto-commit: Success`);
   486→    }
   487→
   488→    return true;
   489→  } catch (error) {
   490→    if (debug) {
   491→      console.error("Session branch auto-commit failed:", error);
   492→    }
   493→    return false;
   494→  }
   495→}
   496→
   497→/**
   498→ * Commit session changes if session branch mode is enabled.
   499→ * Respects batch mode (suppresses commits during atomic batch execution).
   500→ *
   501→ * AC: @session-branch-worktree ac-commit-boundaries
   502→ */
   503→export async function commitIfSessionBranch(
   504→  config: SessionBranchConfig | null,
   505→  operation: string,
   506→  sessionId?: string,
   507→): Promise<boolean> {
   508→  // Suppress auto-commits during atomic batch execution
   509→  if (isBatchMode()) {
   510→    return false;
   511→  }
   512→
   513→  if (!config?.enabled) {
   514→    return false;
   515→  }
   516→
   517→  const message = sessionId
   518→    ? `session: ${operation} (${sessionId})`
   519→    : `session: ${operation}`;
   520→
   521→  return sessionBranchAutoCommit(config.worktreeDir, message);
   522→}
   523→
   524→// ─── Session Branch Sync ────────────────────────────────────────────────────
   525→
   526→/**
   527→ * In-flight dedup for session branch pulls.
   528→ *
   529→ * AC: @session-branch-worktree ac-sync
   530→ */
   531→const sessionPullInflight = new Map<string, Promise<ShadowSyncResult>>();
   532→
   533→/**
   534→ * Pull remote changes for the session branch.
   535→ * Uses in-flight dedup to prevent concurrent pulls.
   536→ *
   537→ * AC: @session-branch-worktree ac-sync
   538→ */
   539→export function sessionBranchPull(
   540→  worktreeDir: string,
   541→  branchName: string = SESSION_BRANCH_NAME,
   542→): Promise<ShadowSyncResult> {
   543→  const key = path.resolve(worktreeDir);
   544→  const existing = sessionPullInflight.get(key);
   545→  if (existing) {
   546→    return existing;
   547→  }
   548→  const promise = sessionBranchPullImpl(worktreeDir, branchName).finally(() => {
   549→    sessionPullInflight.delete(key);
   550→  });
   551→  sessionPullInflight.set(key, promise);
   552→  return promise;
   553→}
   554→
   555→async function sessionBranchPullImpl(
   556→  worktreeDir: string,
   557→  branchName: string,
   558→): Promise<ShadowSyncResult> {
   559→  const result: ShadowSyncResult = {
   560→    success: false,
   561→    pulled: false,
   562→    pushed: false,
   563→    hadConflict: false,
   564→  };
   565→
   566→  // Check if remote tracking is configured
   567→  const options: ShadowOptions = { branchName };
   568→  if (!(await hasRemoteTracking(worktreeDir, options))) {
   569→    result.success = true;
   570→    return result;
   571→  }
   572→
   573→  // Fetch
   574→  const projectRoot = path.dirname(worktreeDir);
   575→  try {
   576→    await runGitAsync(projectRoot, ["fetch", "origin"]);
   577→  } catch {
   578→    result.success = true;
   579→    return result;
   580→  }
   581→
   582→  // Check if remote branch exists
   583→  try {
   584→    const { stdout } = await runGitAsync(projectRoot, [
   585→      "ls-remote",
   586→      "--heads",
   587→      "origin",
   588→      branchName,
   589→    ]);
   590→    if (stdout.trim().length === 0) {
   591→      result.success = true;
   592→      return result;
   593→    }
   594→  } catch {
   595→    result.success = true;
   596→    return result;
   597→  }
   598→
   599→  // Stash uncommitted changes
   600→  let stashed = false;
   601→  try {
   602→    const { stdout } = await runGitAsync(worktreeDir, [
   603→      "stash",
   604→      "push",
   605→      "-m",
   606→      "session-sync-auto",
   607→    ]);
   608→    stashed = !stdout.includes("No local changes");
   609→  } catch {
   610→    result.success = true;
   611→    return result;
   612→  }
   613→
   614→  const unstash = async () => {
   615→    if (stashed) {
   616→      try {
   617→        await runGitAsync(worktreeDir, ["stash", "pop"]);
   618→      } catch {
   619→        // Leave stash intact if pop fails
   620→      }
   621→    }
   622→  };
   623→
   624→  try {
   625→    // Try fast-forward
   626→    await runGitAsync(worktreeDir, ["pull", "--ff-only"]);
   627→    await unstash();
   628→    result.success = true;
   629→    result.pulled = true;
   630→    return result;
   631→  } catch {
   632→    // Fast-forward failed
   633→  }
   634→
   635→  try {
   636→    // Fall back to rebase
   637→    await runGitAsync(worktreeDir, ["pull", "--rebase"]);
   638→    await unstash();
   639→    result.success = true;
   640→    result.pulled = true;
   641→    return result;
   642→  } catch {
   643→    // Rebase failed
   644→  }
   645→
   646→  // Abort rebase if in progress
   647→  try {
   648→    await runGitAsync(worktreeDir, ["rebase", "--abort"]);
   649→  } catch {
   650→    // May not be in rebase state
   651→  }
   652→
   653→  await unstash();
   654→  result.hadConflict = true;
   655→  result.error =
   656→    "Session branch sync conflict detected. Run `kspec shadow resolve` to fix.";
   657→  return result;
   658→}
   659→
   660→/**
   661→ * Resolve session branch config from manifest.
   662→ * Returns null if sessions.storage is not "branch".
   663→ */
   664→export function resolveSessionBranchConfig(
   665→  projectRoot: string,
   666→  manifest: { sessions?: { storage?: string; branch?: string } } | null,
   667→): SessionBranchConfig | null {
   668→  const storage = manifest?.sessions?.storage ?? "local";
   669→  if (storage !== "branch") {
   670→    return null;
   671→  }
   672→
   673→  const branchName = manifest?.sessions?.branch ?? SESSION_BRANCH_NAME;
   674→  return {
   675→    enabled: true,
   676→    worktreeDir: path.join(projectRoot, SESSIONS_WORKTREE_DIR),
   677→    branchName,
   678→    projectRoot,
   679→  };
   680→}
   681→
```