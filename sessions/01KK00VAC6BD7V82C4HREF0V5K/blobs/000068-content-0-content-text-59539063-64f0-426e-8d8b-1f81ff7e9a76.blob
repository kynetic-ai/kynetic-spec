```
     1→/**
     2→ * Kspec Daemon Server
     3→ *
     4→ * Elysia.js HTTP server with WebSocket support for real-time kspec state updates.
     5→ * Implements localhost-only security, file watching, and graceful shutdown.
     6→ */
     7→
     8→import { Elysia } from 'elysia';
     9→import { cors } from '@elysiajs/cors';
    10→import { staticPlugin } from '@elysiajs/static';
    11→import { ulid } from 'ulidx';
    12→import { existsSync } from 'fs';
    13→import { fileURLToPath } from 'url';
    14→import { dirname } from 'path';
    15→import { PubSubManager } from './websocket/pubsub';
    16→import { HeartbeatManager } from './websocket/heartbeat';
    17→import { WebSocketHandler } from './websocket/handler';
    18→import { handleWebSocketClose } from './websocket/lifecycle';
    19→import type { ConnectionData, ConnectedEvent } from './websocket/types';
    20→import { PidFileManager } from './pid';
    21→import { projectContextMiddleware } from './middleware/project-context';
    22→import { createTasksRoutes } from './routes/tasks';
    23→import { createItemsRoutes } from './routes/items';
    24→import { createInboxRoutes } from './routes/inbox';
    25→import { createMetaRoutes } from './routes/meta';
    26→import { createValidationRoutes } from './routes/validation';
    27→import { createProjectsRoutes } from './routes/projects';
    28→import { createTriageRoutes } from './routes/triage';
    29→import { createAgentDispatchRoutes, getDispatchEngine, stopAllEngines } from './routes/agent-dispatch';
    30→import { createSessionRoutes } from './routes/sessions';
    31→import { createPlansRoutes } from './routes/plans';
    32→import { join } from 'path';
    33→
    34→export interface ServerOptions {
    35→  port: number;
    36→  isDaemon: boolean;
    37→  kspecDir?: string; // Path to .kspec directory (default: .kspec in cwd)
    38→  webUiDir?: string; // Path to web UI build directory (default: auto-detect)
    39→}
    40→
    41→/**
    42→ * Resolves the path to the web UI build directory.
    43→ * Tries multiple locations in order:
    44→ * 1. Explicit webUiDir option
    45→ * 2. WEB_UI_DIR environment variable
    46→ * 3. packages/web-ui/build in current working directory (monorepo dev)
    47→ * 4. web-ui/build in current working directory
    48→ * 5. Bundled dist/web-ui/ relative to this module (npm package installs)
    49→ *
    50→ * Exported for testing only.
    51→ */
    52→export function resolveWebUiPath(webUiDir?: string): string | null {
    53→  // 1. Explicit option
    54→  if (webUiDir && existsSync(webUiDir)) {
    55→    return webUiDir;
    56→  }
    57→
    58→  // 2. Environment variable
    59→  const envPath = process.env.WEB_UI_DIR;
    60→  if (envPath && existsSync(envPath)) {
    61→    return envPath;
    62→  }
    63→
    64→  // 3. Monorepo development: packages/web-ui/build from cwd
    65→  // The daemon is spawned with cwd set to project root
    66→  const monorepoPath = join(process.cwd(), 'packages', 'web-ui', 'build');
    67→  if (existsSync(monorepoPath)) {
    68→    return monorepoPath;
    69→  }
    70→
    71→  // 4. Alternate location: web-ui/build in cwd
    72→  const altPath = join(process.cwd(), 'web-ui', 'build');
    73→  if (existsSync(altPath)) {
    74→    return altPath;
    75→  }
    76→
    77→  // 5. Bundled assets: dist/web-ui/ relative to daemon module location
    78→  // Covers npm package installs where no local web UI build exists.
    79→  // import.meta.url resolves to dist/daemon/server.js → sibling is dist/web-ui/
    80→  const selfDir = dirname(fileURLToPath(import.meta.url));
    81→  const bundledPath = join(selfDir, '..', 'web-ui');
    82→  if (existsSync(bundledPath)) {
    83→    return bundledPath;
    84→  }
    85→
    86→  return null;
    87→}
    88→
    89→// WebSocket pub/sub and heartbeat managers
    90→let pubsubManager: PubSubManager;
    91→let heartbeatManager: HeartbeatManager;
    92→let wsHandler: WebSocketHandler;
    93→let projectManager: import('./project-context').ProjectContextManager | undefined;
    94→
    95→/**
    96→ * Middleware to enforce localhost-only connections.
    97→ * AC-3: Reject non-localhost connections with 403 Forbidden
    98→ */
    99→function localhostOnly() {
   100→  return (context: { request: Request }) => {
   101→    const host = context.request.headers.get('host');
   102→    if (!host) {
   103→      return new Response(JSON.stringify({
   104→        error: 'Forbidden',
   105→        message: 'This server only accepts connections from localhost'
   106→      }), {
   107→        status: 403,
   108→        headers: { 'Content-Type': 'application/json' }
   109→      });
   110→    }
   111→
   112→    // Extract hostname, handling IPv6 brackets
   113→    let hostname: string;
   114→    if (host.startsWith('[')) {
   115→      // IPv6 with brackets: [::1]:3456 -> ::1
   116→      const closeBracket = host.indexOf(']');
   117→      hostname = closeBracket > 0 ? host.substring(1, closeBracket) : host;
   118→    } else {
   119→      // IPv4 or hostname: localhost:3456 -> localhost
   120→      hostname = host.split(':')[0];
   121→    }
   122→
   123→    // Allow localhost, 127.0.0.1, and ::1
   124→    const isLocalhost =
   125→      hostname === 'localhost' ||
   126→      hostname === '127.0.0.1' ||
   127→      hostname === '::1';
   128→
   129→    if (!isLocalhost) {
   130→      return new Response(JSON.stringify({
   131→        error: 'Forbidden',
   132→        message: 'This server only accepts connections from localhost'
   133→      }), {
   134→        status: 403,
   135→        headers: { 'Content-Type': 'application/json' }
   136→      });
   137→    }
   138→  };
   139→}
   140→
   141→/**
   142→ * Creates and configures the Elysia server instance.
   143→ *
   144→ * AC Coverage:
   145→ * - ac-1: Server starts on configurable port (default 3456)
   146→ * - ac-2: Binds to localhost only (127.0.0.1 and ::1)
   147→ * - ac-3: Rejects non-localhost connections with 403
   148→ * - ac-15: Uses plugin pattern for middleware
   149→ */
   150→export async function createServer(options: ServerOptions) {
   151→  const { port, isDaemon, kspecDir = join(process.cwd(), '.kspec'), webUiDir } = options;
   152→
   153→  // Determine startup project path (project root, not .kspec/)
   154→  // AC: @multi-directory-daemon ac-2 - daemon uses startup directory as default project
   155→  const startupProjectPath = kspecDir.endsWith('.kspec')
   156→    ? kspecDir.slice(0, -('.kspec'.length + 1)) // Remove '/.kspec'
   157→    : kspecDir;
   158→
   159→  // Import ProjectContextManager (needed for WebSocket binding)
   160→  const { ProjectContextManager } = await import('./project-context');
   161→
   162→  // AC: @daemon-server ac-17 - Resolve web UI path for static file serving
   163→  const resolvedWebUiPath = resolveWebUiPath(webUiDir);
   164→  if (resolvedWebUiPath) {
   165→    console.log(`[daemon] Web UI assets found at: ${resolvedWebUiPath}`);
   166→  } else {
   167→    console.log('[daemon] Web UI assets not found - UI will not be served');
   168→    console.log('[daemon] Build the web UI with: cd packages/web-ui && npm run build');
   169→  }
   170→
   171→  // Initialize PID file manager (uses global ~/.config/kspec/)
   172→  const pidManager = new PidFileManager();
   173→
   174→  // AC: @multi-directory-daemon ac-9 - Write PID and port files in daemon mode
   175→  if (isDaemon) {
   176→    pidManager.writePid();
   177→    pidManager.writePort(port);
   178→    console.log(`[daemon] PID file written: ${process.pid}`);
   179→    console.log(`[daemon] Port file written: ${port}`);
   180→  }
   181→
   182→  // Initialize WebSocket managers
   183→  pubsubManager = new PubSubManager();
   184→  heartbeatManager = new HeartbeatManager();
   185→  wsHandler = new WebSocketHandler(pubsubManager);
   186→
   187→  // WeakMap to store project path during WebSocket upgrade (keyed by Request object)
   188→  // Using WeakMap avoids needing to pass a requestId through beforeHandle return value,
   189→  // which breaks WebSocket upgrade in Elysia 1.4 when derive middleware is present.
   190→  const wsProjectPaths = new WeakMap<Request, string>();
   191→
   192→  const app = new Elysia()
   193→    // AC-15: Plugin pattern for middleware
   194→    // AC: @api-contract ac-1 - Allow CORS from dev server on localhost:5173
   195→    .use(cors({
   196→      origin: ['http://localhost:5173', 'http://127.0.0.1:5173'], // Dev server origins
   197→      credentials: true,
   198→      methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS']
   199→    }))
   200→
   201→    // AC-3: Enforce localhost-only connections
   202→    .onRequest(localhostOnly());
   203→
   204→  // AC: @multi-directory-daemon ac-1, ac-2, ac-3 - Project context middleware
   205→  const { manager: projectContextManager, middleware: projectMiddleware } = projectContextMiddleware({
   206→    startupProject: startupProjectPath,
   207→    pubsub: pubsubManager
   208→  });
   209→
   210→  // Store manager globally for shutdown
   211→  projectManager = projectContextManager;
   212→
   213→  app.use(projectMiddleware)
   214→
   215→    // AC-11: Health check endpoint
   216→    .get('/api/health', () => ({
   217→      status: 'ok',
   218→      uptime: process.uptime(),
   219→      connections: pubsubManager.getConnectionCount(),
   220→      version: '0.1.0'
   221→    }))
   222→
   223→    // AC: @api-contract ac-2 through ac-7 - Task API endpoints
   224→    // AC: @multi-directory-daemon ac-24 - Routes use projectContext from middleware
   225→    .use(createTasksRoutes({ pubsub: pubsubManager }))
   226→
   227→    // AC: @api-contract ac-8 through ac-11 - Spec Item API endpoints
   228→    .use(createItemsRoutes())
   229→
   230→    // AC: @api-contract ac-12 through ac-14 - Inbox API endpoints
   231→    .use(createInboxRoutes({ pubsub: pubsubManager }))
   232→
   233→    // AC: @api-contract ac-15 through ac-18 - Meta API endpoints
   234→    .use(createMetaRoutes())
   235→
   236→    // AC: @triage-daemon-api ac-1 through ac-9 - Triage API endpoints
   237→    .use(createTriageRoutes({ pubsub: pubsubManager }))
   238→
   239→    // AC: @api-contract ac-19 through ac-21 - Validation and search endpoints
   240→    .use(createValidationRoutes())
   241→
   242→    // AC: @multi-directory-daemon ac-28, ac-29, ac-30 - Projects management endpoints
   243→    .use(createProjectsRoutes({ projectManager: projectContextManager }))
   244→
   245→    // AC: @ui-session-stream ac-1, ac-4 - Session data endpoints
   246→    .use(createSessionRoutes())
   247→
   248→    // AC: @ui-plans-view ac-1 - Plans data endpoints
   249→    .use(createPlansRoutes())
   250→
   251→    // AC: @agent-dispatch-engine ac-4 - Agent dispatch API endpoints
   252→    // AC: @daemon-agent-dispatch ac-3, ac-4 - Pass pubsub for WebSocket broadcast on invocation events
   253→    .use(createAgentDispatchRoutes({ pubsub: pubsubManager }))
   254→
   255→    // AC-4: WebSocket endpoint for real-time updates
   256→    .ws<ConnectionData>('/ws', {
   257→      beforeHandle({ request, store }) {
   258→        // AC: @multi-directory-daemon ac-21, ac-22, ac-23, ac-34 - Extract and validate project binding
   259→        // AC: @multi-directory-daemon ac-34 - Browser WebSocket API doesn't support custom headers,
   260→        // so we also accept project path as query parameter
   261→        const url = new URL(request.url, `http://${request.headers.get('host')}`);
   262→        const projectPath = request.headers.get('X-Kspec-Dir')
   263→                        || url.searchParams.get('project')
   264→                        || undefined;
   265→
   266→        // IMPORTANT: Do NOT return a value from ws beforeHandle.
   267→        // In Elysia 1.4 with derive middleware, returning a value short-circuits
   268→        // the WebSocket upgrade and sends the value as an HTTP 200 response.
   269→        // Use a WeakMap keyed by Request object to pass data to open().
   270→        try {
   271→          const manager = (store as Record<string, unknown>).projectManager as import('./project-context').ProjectContextManager | undefined;
   272→          if (!manager) {
   273→            // Fallback: project manager not initialized yet
   274→            wsProjectPaths.set(request, startupProjectPath);
   275→            return;
   276→          }
   277→
   278→          let projectContext;
   279→          if (projectPath) {
   280→            // Explicit project specified
   281→            try {
   282→              projectContext = manager.getProject(projectPath);
   283→            } catch {
   284→              // AC: @multi-directory-daemon ac-4 - auto-register
   285→              projectContext = manager.registerProject(projectPath);
   286→            }
   287→          } else {
   288→            // AC: @multi-directory-daemon ac-22, ac-23 - Use default or reject
   289→            try {
   290→              projectContext = manager.getProject();
   291→            } catch (err: unknown) {
   292→              // AC: @multi-directory-daemon ac-23 - Reject when no default
   293→              if (err instanceof Error && err.message.includes('No default project configured')) {
   294→                throw new Error('No project specified');
   295→              }
   296→              throw err;
   297→            }
   298→          }
   299→
   300→          // Store resolved path for open() handler via WeakMap
   301→          wsProjectPaths.set(request, projectContext.path);
   302→        } catch (err: unknown) {
   303→          console.error(`[daemon] WebSocket connection rejected: ${err instanceof Error ? err.message : String(err)}`);
   304→          throw err;
   305→        }
   306→      },
   307→      open(ws) {
   308→        // AC: @api-contract ac-25, @trait-websocket-protocol ac-1
   309→        const sessionId = ulid();
   310→        const openContext = ws.data as { id?: unknown; request?: unknown } | undefined;
   311→        const contextId = typeof openContext?.id === 'string' ? openContext.id : undefined;
   312→
   313→        // AC: @multi-directory-daemon ac-21 - Get bound project path
   314→        // Retrieve project path from WeakMap via the request object on ws.data
   315→        const request = openContext?.request as Request | undefined;
   316→        const projectPath = request ? wsProjectPaths.get(request) || startupProjectPath : startupProjectPath;
   317→
   318→        ws.data = {
   319→          sessionId,
   320→          topics: new Set<string>(),
   321→          seq: 0,
   322→          lastPing: undefined,
   323→          lastPong: Date.now(),
   324→          projectPath // AC: @multi-directory-daemon ac-21 - immutable binding
   325→        };
   326→
   327→        pubsubManager.addConnection(sessionId, ws, contextId);
   328→        console.log(`[daemon] WebSocket client connected: ${sessionId} bound to ${projectPath} (${pubsubManager.getConnectionCount()} total)`);
   329→
   330→        // Send connected event with session_id
   331→        const connectedEvent: ConnectedEvent = {
   332→          event: 'connected',
   333→          data: {
   334→            session_id: sessionId
   335→          }
   336→        };
   337→        ws.send(JSON.stringify(connectedEvent));
   338→      },
   339→      message(ws, message) {
   340→        // AC: @api-contract ac-26, ac-27
   341→        wsHandler.handleMessage(ws, message);
   342→      },
   343→      pong(ws) {
   344→        // AC: @trait-websocket-protocol ac-5
   345→        heartbeatManager.recordPong(ws);
   346→      },
   347→      close(ws, code, reason) {
   348→        handleWebSocketClose(pubsubManager, ws, code, reason);
   349→      }
   350→    });
   351→
   352→  // AC: @daemon-server ac-17 - Serve web UI static assets
   353→  // Added after API routes so API routes take precedence
   354→  if (resolvedWebUiPath) {
   355→    const indexHtmlPath = join(resolvedWebUiPath, 'index.html');
   356→
   357→    // Serve static files from web UI build directory
   358→    app.use(await staticPlugin({
   359→      assets: resolvedWebUiPath,
   360→      prefix: '/',
   361→      noCache: process.env.NODE_ENV === 'development', // Disable cache in dev
   362→    }));
   363→
   364→    // SPA fallback routes for client-side routing
   365→    // These catch paths like /tasks, /items, /inbox that don't have static files
   366→    const spaRoutes = ['/tasks', '/tasks/*', '/items', '/items/*', '/inbox', '/observations', '/triage', '/plans'];
   367→    for (const route of spaRoutes) {
   368→      app.get(route, () => Bun.file(indexHtmlPath));
   369→    }
   370→
   371→    console.log('[daemon] Web UI static file serving enabled');
   372→  }
   373→
   374→  // AC-1, AC-2: Start server on localhost only
   375→  // Using 'localhost' hostname allows Bun/OS to bind to both 127.0.0.1 and ::1
   376→  app.listen({
   377→    port,
   378→    hostname: 'localhost', // Resolves to both IPv4 and IPv6 loopback
   379→  });
   380→
   381→  console.log(`[daemon] Server listening on http://localhost:${port} (IPv4: 127.0.0.1, IPv6: ::1)`);
   382→  console.log(`[daemon] WebSocket available at ws://localhost:${port}/ws`);
   383→
   384→  // AC: @agent-dispatch-engine ac-5 - Wire file change callback to dispatch engine
   385→  projectContextManager.setFileChangeCallback((projectPath, file) => {
   386→    // Only forward changes to project.tasks.yaml
   387→    if (!file.endsWith('project.tasks.yaml')) return;
   388→    const engine = getDispatchEngine(projectPath);
   389→    if (engine) {
   390→      engine.handleFileChange(projectPath).catch((err) => {
   391→        console.error('[dispatch] Error handling file change:', err);
   392→      });
   393→    }
   394→  });
   395→
   396→  // AC: @multi-directory-daemon ac-17 - Start file watcher for startup project
   397→  if (startupProjectPath) {
   398→    try {
   399→      await projectContextManager.startWatcher(startupProjectPath);
   400→      console.log(`[daemon] File watcher started for startup project: ${startupProjectPath}`);
   401→    } catch (error) {
   402→      console.error('[daemon] Failed to start file watcher for startup project:', error);
   403→    }
   404→  }
   405→
   406→  // AC: @daemon-server ac-13, ac-14 - Start heartbeat monitoring
   407→  heartbeatManager.start(pubsubManager.getAllConnections());
   408→
   409→  // AC-12: Graceful shutdown on SIGTERM/SIGINT
   410→  const shutdown = async (signal: string) => {
   411→    console.log(`[daemon] Received ${signal}, shutting down gracefully...`);
   412→
   413→    try {
   414→      // Stop heartbeat monitoring
   415→      heartbeatManager.stop();
   416→
   417→      // AC: @agent-dispatch-engine ac-11 - Stop all dispatch engines before shutting down
   418→      await stopAllEngines();
   419→
   420→      // AC: @multi-directory-daemon ac-11b - Stop all file watchers
```