```
     1→/**
     2→ * Doctor command - unified health check for kspec
     3→ *
     4→ * Library layer that aggregates shadow branch, setup, and daemon status
     5→ * into a unified DoctorReport. CLI command is in src/cli/commands/doctor.ts.
     6→ *
     7→ * AC: @doctor-command
     8→ */
     9→
    10→import { getGitRoot, getShadowStatus, isGitRepo, type ShadowStatus } from "./shadow.js";
    11→import { getSetupStatus, type SetupStatus } from "./setup-status.js";
    12→import { getDaemonStatus, type DaemonStatus } from "./daemon-status.js";
    13→
    14→/**
    15→ * Severity levels for health checks
    16→ */
    17→export type Severity = "ok" | "warning" | "error";
    18→
    19→/**
    20→ * Individual check result with severity
    21→ */
    22→export interface CheckResult {
    23→  name: string;
    24→  severity: Severity;
    25→  message: string;
    26→  /** Optional guidance for fixing issues */
    27→  guidance?: string;
    28→}
    29→
    30→/**
    31→ * Shadow branch section of doctor report
    32→ * AC: @doctor-command ac-shadow-healthy
    33→ */
    34→export interface ShadowSection {
    35→  initialized: boolean;
    36→  checks: CheckResult[];
    37→}
    38→
    39→/**
    40→ * Setup section of doctor report
    41→ * AC: @doctor-command ac-setup-agent-hooks, ac-setup-skills-agents-md
    42→ */
    43→export interface SetupSection {
    44→  checks: CheckResult[];
    45→  agentType?: string;
    46→  hooksInstalled?: boolean;
    47→  skillsRendered?: number;
    48→  skillsDrifted?: number;
    49→  agentsMdStatus?: "current" | "stale" | "missing" | "unknown";
    50→  agentsMdGeneratedAt?: string;
    51→}
    52→
    53→/**
    54→ * Daemon section of doctor report
    55→ * AC: @doctor-command ac-daemon-running, ac-daemon-not-running, ac-daemon-unreachable
    56→ */
    57→export interface DaemonSection {
    58→  checks: CheckResult[];
    59→  running?: boolean;
    60→  pid?: number | null;
    61→  port?: number | null;
    62→  uptime?: number | null;
    63→  healthReachable?: boolean;
    64→}
    65→
    66→/**
    67→ * Overall verdict
    68→ * AC: @doctor-command ac-overall-verdict
    69→ */
    70→export interface OverallVerdict {
    71→  healthy: boolean;
    72→  errorCount: number;
    73→  warningCount: number;
    74→}
    75→
    76→/**
    77→ * Complete doctor report
    78→ * AC: @doctor-command ac-json-output
    79→ */
    80→export interface DoctorReport {
    81→  /** Timestamp of report generation (ISO 8601) */
    82→  generatedAt: string;
    83→  /** Shadow branch status */
    84→  shadow: ShadowSection;
    85→  /** Setup status (hooks, skills, agents.md) */
    86→  setup: SetupSection;
    87→  /** Daemon status */
    88→  daemon: DaemonSection;
    89→  /** Overall health verdict */
    90→  overall: OverallVerdict;
    91→}
    92→
    93→/**
    94→ * Options for doctor report
    95→ */
    96→export interface DoctorOptions {
    97→  /** Project root directory (defaults to detecting from cwd) */
    98→  projectRoot?: string;
    99→}
   100→
   101→/**
   102→ * Get a unified health check report for the kspec installation.
   103→ *
   104→ * AC: @doctor-command ac-no-git-repo — returns error if not in git repo
   105→ * AC: @doctor-command ac-not-initialized — returns error if kspec not initialized
   106→ * AC: @doctor-command ac-shadow-healthy — checks shadow branch health
   107→ * AC: @doctor-command ac-setup-agent-hooks — checks hooks status
   108→ * AC: @doctor-command ac-setup-skills-agents-md — checks skills and agents.md
   109→ * AC: @doctor-command ac-daemon-running — checks daemon status
   110→ * AC: @doctor-command ac-daemon-unreachable — detects unreachable health endpoint
   111→ * AC: @doctor-command ac-daemon-not-running — daemon not running is warning
   112→ * AC: @doctor-command ac-overall-verdict — computes healthy/issues verdict
   113→ * AC: @doctor-command ac-partial-init — handles shadow ok but setup missing
   114→ * AC: @doctor-command ac-staleness-unknown — handles unknown staleness
   115→ *
   116→ * @param cwd Current working directory
   117→ * @param options Optional configuration
   118→ */
   119→export async function getDoctorReport(
   120→  cwd: string,
   121→  options: DoctorOptions = {}
   122→): Promise<DoctorReport> {
   123→  const generatedAt = new Date().toISOString();
   124→
   125→  // Initialize empty report
   126→  const report: DoctorReport = {
   127→    generatedAt,
   128→    shadow: { initialized: false, checks: [] },
   129→    setup: { checks: [] },
   130→    daemon: { checks: [] },
   131→    overall: { healthy: false, errorCount: 0, warningCount: 0 },
   132→  };
   133→
   134→  // Step 1: Check for git repo
   135→  // AC: @doctor-command ac-no-git-repo
   136→  const projectRoot = options.projectRoot ?? getGitRoot(cwd);
   137→  if (!projectRoot) {
   138→    report.shadow.checks.push({
   139→      name: "git-repo",
   140→      severity: "error",
   141→      message: "No git repository found",
   142→      guidance: "Run `git init` to initialize a git repository",
   143→    });
   144→    report.overall.errorCount = 1;
   145→    return report;
   146→  }
   147→
   148→  // Verify it's actually a git repo
   149→  if (!(await isGitRepo(projectRoot))) {
   150→    report.shadow.checks.push({
   151→      name: "git-repo",
   152→      severity: "error",
   153→      message: "Not a git repository",
   154→      guidance: "Run `git init` to initialize a git repository",
   155→    });
   156→    report.overall.errorCount = 1;
   157→    return report;
   158→  }
   159→
   160→  // Step 2: Check shadow branch status
   161→  // AC: @doctor-command ac-not-initialized, ac-shadow-healthy
   162→  const shadowStatus = await getShadowStatus(projectRoot);
   163→  buildShadowSection(report.shadow, shadowStatus);
   164→
   165→  // If not initialized, return early with guidance
   166→  // AC: @doctor-command ac-not-initialized
   167→  if (!shadowStatus.exists) {
   168→    report.shadow.checks.push({
   169→      name: "initialized",
   170→      severity: "error",
   171→      message: "kspec is not initialized",
   172→      guidance: "Run `kspec init` to initialize kspec in this project",
   173→    });
   174→    report.overall.errorCount = countErrors(report);
   175→    report.overall.warningCount = countWarnings(report);
   176→    return report;
   177→  }
   178→
   179→  // Shadow exists, run remaining checks in parallel
   180→  // AC: @doctor-command ac-setup-agent-hooks, ac-setup-skills-agents-md, ac-daemon-running
   181→  const [setupStatus, daemonStatus] = await Promise.all([
   182→    getSetupStatus(projectRoot).catch((err): SetupStatus => ({
   183→      agent: { detected: "unknown", confidence: "low" },
   184→      hooks: { promptCheck: false, stop: false, preToolUse: false, guardsPresent: [] },
   185→      skills: { total: 0, rendered: 0, drifted: 0 },
   186→      agentsMd: { exists: false, status: "missing" },
   187→      seeding: { permissionsSeeded: false, memorySeeded: false },
   188→      error: err instanceof Error ? err.message : String(err),
   189→    })),
   190→    getDaemonStatus().catch((err): DaemonStatus => ({
   191→      running: false,
   192→      pid: null,
   193→      port: null,
   194→      uptime: null,
   195→      healthReachable: false,
   196→      error: err instanceof Error ? err.message : String(err),
   197→    })),
   198→  ]);
   199→
   200→  // Build setup section
   201→  // AC: @doctor-command ac-setup-agent-hooks, ac-setup-skills-agents-md, ac-partial-init, ac-staleness-unknown
   202→  buildSetupSection(report.setup, setupStatus);
   203→
   204→  // Build daemon section
   205→  // AC: @doctor-command ac-daemon-running, ac-daemon-not-running, ac-daemon-unreachable
   206→  buildDaemonSection(report.daemon, daemonStatus);
   207→
   208→  // Compute overall verdict
   209→  // AC: @doctor-command ac-overall-verdict
   210→  report.overall.errorCount = countErrors(report);
   211→  report.overall.warningCount = countWarnings(report);
   212→  report.overall.healthy = report.overall.errorCount === 0;
   213→
   214→  return report;
   215→}
   216→
   217→/**
   218→ * Build shadow section from ShadowStatus
   219→ * AC: @doctor-command ac-shadow-healthy
   220→ */
   221→function buildShadowSection(section: ShadowSection, status: ShadowStatus): void {
   222→  section.initialized = status.exists;
   223→
   224→  // Branch exists check
   225→  section.checks.push({
   226→    name: "branch-exists",
   227→    severity: status.branchExists ? "ok" : "error",
   228→    message: status.branchExists
   229→      ? "Shadow branch exists"
   230→      : "Shadow branch does not exist",
   231→    guidance: status.branchExists ? undefined : "Run `kspec init` to create shadow branch",
   232→  });
   233→
   234→  // Only check worktree if branch exists
   235→  if (status.branchExists) {
   236→    // Worktree exists check
   237→    section.checks.push({
   238→      name: "worktree-exists",
   239→      severity: status.worktreeExists ? "ok" : "error",
   240→      message: status.worktreeExists
   241→        ? "Worktree directory exists"
   242→        : "Worktree directory missing",
   243→      guidance: status.worktreeExists ? undefined : "Run `kspec shadow repair` to recreate worktree",
   244→    });
   245→
   246→    // Worktree linked check
   247→    if (status.worktreeExists) {
   248→      section.checks.push({
   249→        name: "worktree-linked",
   250→        severity: status.worktreeLinked ? "ok" : "error",
   251→        message: status.worktreeLinked
   252→          ? "Worktree properly linked"
   253→          : "Worktree not properly linked",
   254→        guidance: status.worktreeLinked ? undefined : "Run `kspec shadow repair` to fix worktree link",
   255→      });
   256→    }
   257→  }
   258→}
   259→
   260→/**
   261→ * Build setup section from SetupStatus
   262→ * AC: @doctor-command ac-setup-agent-hooks, ac-setup-skills-agents-md, ac-partial-init, ac-staleness-unknown
   263→ */
   264→function buildSetupSection(section: SetupSection, status: SetupStatus): void {
   265→  // Store metadata
   266→  section.agentType = status.agent.detected;
   267→  section.skillsRendered = status.skills.rendered;
   268→  section.skillsDrifted = status.skills.drifted;
   269→  section.agentsMdStatus = status.agentsMd.status;
   270→  section.agentsMdGeneratedAt = status.agentsMd.generatedAt;
   271→
   272→  // Agent type check
   273→  // AC: @doctor-command ac-setup-agent-hooks
   274→  section.checks.push({
   275→    name: "agent-type",
   276→    severity: status.agent.detected !== "unknown" ? "ok" : "warning",
   277→    message: status.agent.detected !== "unknown"
   278→      ? `Agent type: ${status.agent.detected} (${status.agent.confidence} confidence)`
   279→      : "Agent type: unknown",
   280→    guidance: status.agent.detected === "unknown"
   281→      ? "Run `kspec setup` to configure agent integration"
   282→      : undefined,
   283→  });
   284→
   285→  // Hooks check
   286→  // AC: @doctor-command ac-setup-agent-hooks, ac-partial-init
   287→  const hooksInstalled =
   288→    status.hooks.promptCheck ||
   289→    status.hooks.stop ||
   290→    status.hooks.preToolUse ||
   291→    status.hooks.guardsPresent.length > 0;
   292→  section.hooksInstalled = hooksInstalled;
   293→
   294→  section.checks.push({
   295→    name: "hooks",
   296→    severity: hooksInstalled ? "ok" : "error",
   297→    message: hooksInstalled
   298→      ? `Hooks installed (prompt-check: ${status.hooks.promptCheck}, stop: ${status.hooks.stop}, guards: ${status.hooks.guardsPresent.length})`
   299→      : "No hooks installed",
   300→    guidance: hooksInstalled
   301→      ? undefined
   302→      : "Run `kspec setup` to install hooks",
   303→  });
   304→
   305→  // Skills check
   306→  // AC: @doctor-command ac-setup-skills-agents-md
   307→  section.checks.push({
   308→    name: "skills",
   309→    severity: status.skills.rendered > 0
   310→      ? (status.skills.drifted > 0 ? "warning" : "ok")
   311→      : "warning",
   312→    message: status.skills.rendered > 0
   313→      ? `${status.skills.rendered} skills rendered${status.skills.drifted > 0 ? `, ${status.skills.drifted} drifted` : ""}`
   314→      : "No skills rendered",
   315→    guidance: status.skills.rendered === 0
   316→      ? "Run `kspec setup` to render skills"
   317→      : (status.skills.drifted > 0 ? "Run `kspec setup --force` to re-render drifted skills" : undefined),
   318→  });
   319→
   320→  // kspec-agents.md check
   321→  // AC: @doctor-command ac-setup-skills-agents-md, ac-staleness-unknown
   322→  let agentsMdSeverity: Severity;
   323→  let agentsMdMessage: string;
   324→  let agentsMdGuidance: string | undefined;
   325→
   326→  switch (status.agentsMd.status) {
   327→    case "current":
   328→      agentsMdSeverity = "ok";
   329→      agentsMdMessage = status.agentsMd.generatedAt
   330→        ? `kspec-agents.md is current (generated: ${status.agentsMd.generatedAt})`
   331→        : "kspec-agents.md is current";
   332→      break;
   333→    case "stale":
   334→      agentsMdSeverity = "warning";
   335→      agentsMdMessage = "kspec-agents.md is stale";
   336→      agentsMdGuidance = "Run `kspec agents generate` to regenerate";
   337→      break;
   338→    case "unknown":
   339→      // AC: @doctor-command ac-staleness-unknown
   340→      agentsMdSeverity = "warning";
   341→      agentsMdMessage = "kspec-agents.md staleness unknown";
   342→      agentsMdGuidance = "Could not determine staleness (manifest or hash computation unavailable)";
   343→      break;
   344→    case "missing":
   345→    default:
   346→      agentsMdSeverity = "error";
   347→      agentsMdMessage = "kspec-agents.md does not exist";
   348→      agentsMdGuidance = "Run `kspec setup` to generate kspec-agents.md";
   349→      break;
   350→  }
   351→
   352→  section.checks.push({
   353→    name: "agents-md",
   354→    severity: agentsMdSeverity,
   355→    message: agentsMdMessage,
   356→    guidance: agentsMdGuidance,
   357→  });
   358→}
   359→
   360→/**
   361→ * Build daemon section from DaemonStatus
   362→ * AC: @doctor-command ac-daemon-running, ac-daemon-not-running, ac-daemon-unreachable
   363→ */
   364→function buildDaemonSection(section: DaemonSection, status: DaemonStatus): void {
   365→  section.running = status.running;
   366→  section.pid = status.pid;
   367→  section.port = status.port;
   368→  section.uptime = status.uptime;
   369→  section.healthReachable = status.healthReachable;
   370→
   371→  if (!status.running) {
   372→    // AC: @doctor-command ac-daemon-not-running — warning, not error
   373→    section.checks.push({
   374→      name: "daemon-running",
   375→      severity: "warning",
   376→      message: "Daemon not running",
   377→      guidance: "Run `kspec serve start --daemon` to start the daemon (optional)",
   378→    });
   379→    return;
   380→  }
   381→
   382→  // Daemon is running
   383→  // AC: @doctor-command ac-daemon-running
   384→  section.checks.push({
   385→    name: "daemon-running",
   386→    severity: "ok",
   387→    message: `Daemon running (PID: ${status.pid})`,
   388→  });
   389→
   390→  // Port check
   391→  if (status.port) {
   392→    section.checks.push({
   393→      name: "daemon-port",
   394→      severity: "ok",
   395→      message: `Port: ${status.port}`,
   396→    });
   397→  }
   398→
   399→  // Uptime check
   400→  if (status.uptime !== null) {
   401→    const hours = Math.floor(status.uptime / 3600);
   402→    const minutes = Math.floor((status.uptime % 3600) / 60);
   403→    const seconds = Math.floor(status.uptime % 60);
   404→    let uptimeStr: string;
   405→    if (hours > 0) {
   406→      uptimeStr = `${hours}h ${minutes}m ${seconds}s`;
   407→    } else if (minutes > 0) {
   408→      uptimeStr = `${minutes}m ${seconds}s`;
   409→    } else {
   410→      uptimeStr = `${seconds}s`;
   411→    }
   412→    section.checks.push({
   413→      name: "daemon-uptime",
   414→      severity: "ok",
   415→      message: `Uptime: ${uptimeStr}`,
   416→    });
   417→  }
   418→
   419→  // Health endpoint check
   420→  // AC: @doctor-command ac-daemon-unreachable
   421→  if (!status.healthReachable) {
   422→    section.checks.push({
   423→      name: "daemon-health",
   424→      severity: "warning",
   425→      message: "Health endpoint unreachable",
   426→      guidance: "Daemon may be starting up or there may be a port conflict",
   427→    });
   428→  } else {
   429→    section.checks.push({
   430→      name: "daemon-health",
   431→      severity: "ok",
   432→      message: "Health endpoint reachable",
   433→    });
   434→  }
   435→}
   436→
   437→/**
   438→ * Count errors across all sections
   439→ */
   440→function countErrors(report: DoctorReport): number {
   441→  let count = 0;
   442→  for (const check of report.shadow.checks) {
   443→    if (check.severity === "error") count++;
   444→  }
   445→  for (const check of report.setup.checks) {
   446→    if (check.severity === "error") count++;
   447→  }
   448→  for (const check of report.daemon.checks) {
   449→    if (check.severity === "error") count++;
   450→  }
   451→  return count;
   452→}
   453→
   454→/**
   455→ * Count warnings across all sections
   456→ */
   457→function countWarnings(report: DoctorReport): number {
   458→  let count = 0;
   459→  for (const check of report.shadow.checks) {
   460→    if (check.severity === "warning") count++;
   461→  }
   462→  for (const check of report.setup.checks) {
   463→    if (check.severity === "warning") count++;
   464→  }
   465→  for (const check of report.daemon.checks) {
   466→    if (check.severity === "warning") count++;
   467→  }
   468→  return count;
   469→}
   470→

