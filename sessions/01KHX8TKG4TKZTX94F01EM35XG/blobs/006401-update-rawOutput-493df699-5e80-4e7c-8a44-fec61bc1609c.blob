    31→
    32→/**
    33→ * Staleness warning types
    34→ * AC: @stale-status-detection
    35→ */
    36→interface StalenessWarning {
    37→  type:
    38→    | "parent-pending-children-done"
    39→    | "spec-implemented-no-task"
    40→    | "task-done-spec-not-started"
    41→    | "automation-blocking";
    42→  message: string;
    43→  refs: string[];
    44→}
    45→
    46→/**
    47→ * Check for stale status mismatches between specs and tasks
    48→ * AC: @stale-status-detection ac-1, ac-2, ac-3
    49→ */
    50→function checkStaleness(
    51→  items: LoadedSpecItem[],
    52→  tasks: LoadedTask[],
    53→  refIndex: ReferenceIndex,
    54→): StalenessWarning[] {
    55→  const warnings: StalenessWarning[] = [];
    56→
    57→  // AC: @stale-status-detection ac-1 (parent-pending-children-done)
    58→  // Check if task with dependencies is pending but all dependencies are completed
    59→  for (const task of tasks) {
    60→    // Only check pending/in_progress tasks with dependencies
    61→    if (task.status !== "pending" && task.status !== "in_progress") continue;
    62→    if (!task.depends_on || task.depends_on.length === 0) continue;
    63→
    64→    // Resolve all dependency tasks
    65→    const depTasks = task.depends_on
    66→      .map((depRef) => {
    67→        const result = refIndex.resolve(depRef);
    68→        if (!result.ok) return null;
    69→        return tasks.find((t) => t._ulid === result.ulid);
    70→      })
    71→      .filter((t): t is LoadedTask => t !== null);
    72→
    73→    if (depTasks.length === 0) continue;
    74→
    75→    // Check if all dependencies are completed and their linked specs are implemented
    76→    const allDepsDone = depTasks.every((depTask) => {
    77→      if (depTask.status !== "completed") return false;
    78→
    79→      // If the dep task has a spec_ref, check if that spec is implemented
    80→      if (depTask.spec_ref) {
    81→        const result = refIndex.resolve(depTask.spec_ref);
    82→        if (!result.ok) return true; // Missing spec ref doesn't block
    83→        const spec = items.find((item) => item._ulid === result.ulid);
    84→        return spec?.status?.implementation === "implemented";
    85→      }
    86→      return true;
    87→    });
    88→
    89→    if (allDepsDone) {
    90→      const taskRef = task.slugs[0] || refIndex.shortUlid(task._ulid);
    91→      warnings.push({
    92→        type: "parent-pending-children-done",
    93→        message: `Task @${taskRef} is ${task.status} but all dependencies are completed. Consider completing or reviewing.`,
    94→        refs: [task._ulid],
    95→      });
    96→    }
    97→  }
    98→
    99→  // AC: @stale-status-detection ac-2 (spec-implemented-no-task)
   100→  // Check if spec is implemented but has no completed tasks
   101→  for (const item of items) {
   102→    if (item.status?.implementation !== "implemented") continue;
   103→
   104→    // AC: @trait-retrospective ac-1
   105→    // Skip retrospective specs from staleness warnings
   106→    const isRetrospective = item.traits?.includes("@trait-retrospective");
   107→    if (isRetrospective) continue;
   108→
   109→    // Find completed tasks that reference this spec
   110→    const completedTasks = tasks.filter((task) => {
   111→      if (task.status !== "completed" || !task.spec_ref) return false;
   112→      const result = refIndex.resolve(task.spec_ref);
   113→      return result.ok && result.ulid === item._ulid;
   114→    });
   115→
   116→    if (completedTasks.length === 0) {
   117→      const specRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
   118→      warnings.push({
   119→        type: "spec-implemented-no-task",
   120→        message: `Spec @${specRef} is implemented but has no completed tasks. Verify implementation or link existing task.`,
   121→        refs: [item._ulid],
   122→      });
   123→    }
   124→  }
   125→
   126→  // AC: @stale-status-detection ac-3 (task-done-spec-not-started)
   127→  // Check if task is completed but spec is still not_started
   128→  for (const task of tasks) {
   129→    if (task.status !== "completed") continue;
   130→    if (!task.spec_ref) continue;
   131→
   132→    // Resolve spec reference
   133→    const result = refIndex.resolve(task.spec_ref);
   134→    if (!result.ok) continue;
   135→
   136→    const spec = items.find((item) => item._ulid === result.ulid);
   137→    if (!spec) continue;
   138→
   139→    if (spec.status?.implementation === "not_started") {
   140→      const taskRef = task.slugs[0] || refIndex.shortUlid(task._ulid);
   141→      const specRef = spec.slugs[0] || refIndex.shortUlid(spec._ulid);
   142→      warnings.push({
   143→        type: "task-done-spec-not-started",
   144→        message: `Task @${taskRef} completed but spec @${specRef} is not_started. Update spec status.`,
   145→        refs: [task._ulid, spec._ulid],
   146→      });
   147→    }
   148→  }
   149→
   150→  // AC: @validation ac-1
   151→  // Check for manual_only parents blocking eligible children
   152→  for (const parentTask of tasks) {
   153→    if (parentTask.automation !== "manual_only") continue;
   154→
   155→    // Find tasks that depend on this parent
   156→    const dependentTasks = tasks.filter((t) =>
   157→      t.depends_on?.some((depRef) => {
   158→        const result = refIndex.resolve(depRef);
   159→        return result.ok && result.ulid === parentTask._ulid;
   160→      }),
   161→    );
   162→
   163→    // Filter for eligible children
   164→    const eligibleChildren = dependentTasks.filter(
   165→      (t) => t.automation === "eligible",
   166→    );
   167→
   168→    if (eligibleChildren.length > 0) {
   169→      const parentRef =
   170→        parentTask.slugs[0] || refIndex.shortUlid(parentTask._ulid);
   171→      const childRefs = eligibleChildren.map(
   172→        (c) => `@${c.slugs[0] || refIndex.shortUlid(c._ulid)}`,
   173→      );
   174→
   175→      warnings.push({
   176→        type: "automation-blocking",
   177→        message: `Task @${parentRef} is manual_only and blocks ${eligibleChildren.length} eligible child task(s): ${childRefs.join(", ")}`,
   178→        refs: [parentTask._ulid, ...eligibleChildren.map((c) => c._ulid)],
   179→      });
   180→    }
   181→  }
   182→
   183→  return warnings;
   184→}
   185→
   186→/**
   187→ * Format staleness warnings for display
   188→ * AC: @stale-status-detection ac-4
   189→ */
   190→function formatStalenessWarnings(
   191→  warnings: StalenessWarning[],
   192→  verbose: boolean,
   193→): void {
   194→  if (warnings.length === 0) {
   195→    console.log(chalk.green("Staleness: OK"));
   196→    return;
   197→  }
   198→
   199→  console.log(chalk.yellow(`\nStaleness warnings: ${warnings.length}`));
   200→
   201→  // Group by type
   202→  const parentPending = warnings.filter(
   203→    (w) => w.type === "parent-pending-children-done",
   204→  );
   205→  const specNoTask = warnings.filter(
   206→    (w) => w.type === "spec-implemented-no-task",
   207→  );
   208→  const taskDoneSpecNot = warnings.filter(
   209→    (w) => w.type === "task-done-spec-not-started",
   210→  );
   211→  const automationBlocking = warnings.filter(
   212→    (w) => w.type === "automation-blocking",
   213→  );
   214→
   215→  if (parentPending.length > 0) {
   216→    console.log(
   217→      chalk.yellow(`  Parent pending, children done: ${parentPending.length}`),
   218→    );
   219→    const shown = verbose ? parentPending : parentPending.slice(0, 3);
   220→    for (const w of shown) {
   221→      console.log(chalk.yellow(`    ! ${w.message}`));
   222→    }
   223→    if (!verbose && parentPending.length > 3) {
   224→      console.log(chalk.gray(`    ... and ${parentPending.length - 3} more`));
   225→    }
   226→  }
   227→
   228→  if (specNoTask.length > 0) {
   229→    console.log(
   230→      chalk.yellow(`  Spec implemented, no task: ${specNoTask.length}`),
   231→    );
   232→    const shown = verbose ? specNoTask : specNoTask.slice(0, 3);
   233→    for (const w of shown) {
   234→      console.log(chalk.yellow(`    ! ${w.message}`));
   235→    }
   236→    if (!verbose && specNoTask.length > 3) {
   237→      console.log(chalk.gray(`    ... and ${specNoTask.length - 3} more`));
   238→    }
   239→  }
   240→
   241→  if (taskDoneSpecNot.length > 0) {
   242→    console.log(
   243→      chalk.yellow(`  Task done, spec not started: ${taskDoneSpecNot.length}`),
   244→    );
   245→    const shown = verbose ? taskDoneSpecNot : taskDoneSpecNot.slice(0, 3);
   246→    for (const w of shown) {
   247→      console.log(chalk.yellow(`    ! ${w.message}`));
   248→    }
   249→    if (!verbose && taskDoneSpecNot.length > 3) {
   250→      console.log(chalk.gray(`    ... and ${taskDoneSpecNot.length - 3} more`));
   251→    }
   252→  }
   253→
   254→  if (automationBlocking.length > 0) {
   255→    console.log(
   256→      chalk.yellow(`  Automation blocking: ${automationBlocking.length}`),
   257→    );
   258→    const shown = verbose ? automationBlocking : automationBlocking.slice(0, 3);
   259→    for (const w of shown) {
   260→      console.log(chalk.yellow(`    ! ${w.message}`));
   261→    }
   262→    if (!verbose && automationBlocking.length > 3) {
   263→      console.log(
   264→        chalk.gray(`    ... and ${automationBlocking.length - 3} more`),
   265→      );
   266→    }
   267→  }
   268→}
   269→
   270→/**
   271→ * AC schema drift warning type
   272→ */
   273→interface ACDriftWarning {
   274→  type: "ac_schema_field_mismatch";
   275→  itemRef: string;
   276→  itemTitle: string;
   277→  message: string;
   278→  details?: string;
   279→}
   280→
   281→/**
   282→ * Format AC schema drift warnings for display
   283→ */
   284→function formatDriftWarnings(
   285→  warnings: CompletenessWarning[],
   286→  verbose: boolean,
   287→): void {
   288→  // Filter to only drift warnings
   289→  const driftWarnings = warnings.filter(
   290→    (w) => w.type === "ac_schema_field_mismatch",
   291→  ) as ACDriftWarning[];
   292→
   293→  if (driftWarnings.length === 0) {
   294→    console.log(chalk.green("AC Schema Drift: OK"));
   295→    return;
   296→  }
   297→
   298→  console.log(chalk.yellow(`\nAC Schema Drift warnings: ${driftWarnings.length}`));
   299→
   300→  // Group by item
   301→  const byItem = new Map<string, ACDriftWarning[]>();
   302→  for (const w of driftWarnings) {
   303→    const existing = byItem.get(w.itemRef) || [];
   304→    existing.push(w);
   305→    byItem.set(w.itemRef, existing);
   306→  }
   307→
   308→  const itemEntries = [...byItem.entries()];
   309→  const shown = verbose ? itemEntries : itemEntries.slice(0, 5);
   310→
   311→  for (const [itemRef, itemWarnings] of shown) {
   312→    const firstWarning = itemWarnings[0];
   313→    console.log(chalk.yellow(`  ${itemRef} - ${firstWarning.itemTitle}`));
   314→    for (const w of itemWarnings) {
   315→      console.log(chalk.yellow(`    ! ${w.message}`));
   316→      if (w.details) {
   317→        console.log(chalk.gray(`      ${w.details}`));
   318→      }
   319→    }
   320→  }
   321→
   322→  if (!verbose && itemEntries.length > 5) {
   323→    console.log(
   324→      chalk.gray(`  ... and ${itemEntries.length - 5} more items with drift`),
   325→    );
   326→  }
   327→}
   328→
   329→/**
   330→ * Format convention validation results for display
   331→ * AC: @convention-definitions ac-3, ac-4
   332→ */
   333→function formatConventionValidationResult(
   334→  result: ConventionValidationResult,
   335→): void {
   336→  if (result.valid && result.skipped.length === 0) {
   337→    console.log(chalk.green("Conventions: OK"));
   338→    return;
   339→  }
   340→
   341→  // AC: @convention-definitions ac-4
   342→  // Skipped prose conventions
   343→  if (result.skipped.length > 0) {
   344→    for (const domain of result.skipped) {
   345→      console.log(chalk.gray(`ℹ Skipping prose convention: ${domain}`));
   346→    }
   347→  }
   348→
   349→  // AC: @convention-definitions ac-3
   350→  // Validation errors
   351→  if (result.errors.length > 0) {
   352→    console.log(chalk.red(`\nConvention violations: ${result.errors.length}`));
   353→    for (const err of result.errors) {
   354→      console.log(chalk.red(`  ✗ ${err.domain}`));
   355→      console.log(chalk.gray(`    ${err.message}`));
   356→      if (err.expected) {
   357→        console.log(chalk.gray(`    Expected: ${err.expected}`));
   358→      }
   359→      if (err.location) {
   360→        console.log(chalk.gray(`    Location: ${err.location}`));
   361→      }
   362→    }
   363→  } else {
   364→    console.log(chalk.green("\nConventions: OK"));
   365→  }
   366→
   367→  // Stats
   368→  console.log(
   369→    chalk.gray(`\nConventions checked: ${result.stats.conventionsChecked}`),
   370→  );
   371→  console.log(
   372→    chalk.gray(`Conventions skipped: ${result.stats.conventionsSkipped}`),
   373→  );
   374→}
   375→
   376→/**
   377→ * Format skill validation results for display
   378→ */
   379→function formatSkillValidationResult(
   380→  result: SkillValidationResult,
   381→  verbose: boolean,
   382→): void {
   383→  if (result.filesChecked === 0) {
   384→    console.log(chalk.gray("Skills: No skill files found"));
   385→    return;
   386→  }
   387→
   388→  if (result.valid) {
   389→    console.log(
   390→      chalk.green(`Skills: OK (${result.filesChecked} files checked)`),
   391→    );
   392→    return;
   393→  }
   394→
   395→  console.log(chalk.red(`\nSkill validation errors: ${result.errors.length}`));
   396→  console.log(chalk.gray(`Files checked: ${result.filesChecked}`));
   397→
   398→  // Group errors by file
   399→  const errorsByFile = new Map<string, typeof result.errors>();
   400→  for (const err of result.errors) {
   401→    const existing = errorsByFile.get(err.file) || [];
   402→    existing.push(err);
   403→    errorsByFile.set(err.file, existing);
   404→  }
   405→
   406→  for (const [file, errors] of errorsByFile.entries()) {
   407→    console.log(chalk.yellow(`\n  ${file}:`));
   408→    const shown = verbose ? errors : errors.slice(0, 5);
   409→    for (const err of shown) {
   410→      const location = err.line ? `:${err.line}` : "";
   411→      console.log(chalk.red(`    ✗ ${err.type}${location}`));
   412→      console.log(chalk.gray(`      ${err.message}`));
   413→    }
   414→    if (!verbose && errors.length > 5) {
   415→      console.log(chalk.gray(`    ... and ${errors.length - 5} more`));
   416→    }
   417→  }
   418→}
   419→
   420→/**
   421→ * Format completeness warnings for display
   422→ * AC: @spec-completeness ac-4
   423→ */
   424→function formatCompletenessWarnings(
   425→  warnings: CompletenessWarning[],
   426→  verbose: boolean,
   427→): void {
   428→  if (warnings.length === 0) {
   429→    console.log(chalk.green("Completeness: OK"));
   430→    return;
   431→  }
   432→
   433→  console.log(chalk.yellow(`\nCompleteness warnings: ${warnings.length}`));
   434→
   435→  // Group by type
   436→  const missingAC = warnings.filter(
   437→    (w) => w.type === "missing_acceptance_criteria",
   438→  );
   439→  const missingDesc = warnings.filter((w) => w.type === "missing_description");
   440→  const statusMismatch = warnings.filter(
   441→    (w) => w.type === "status_inconsistency",
   442→  );
   443→  const missingTestCoverage = warnings.filter(
   444→    (w) => w.type === "missing_test_coverage",
   445→  );
   446→  const automationNoSpec = warnings.filter(
   447→    (w) => w.type === "automation_eligible_no_spec",
   448→  );
   449→
   450→  // AC: @spec-completeness ac-4
   451→  // Show summary with counts by issue type
   452→  if (missingAC.length > 0) {
   453→    console.log(
   454→      chalk.yellow(`  Missing acceptance criteria: ${missingAC.length}`),
   455→    );
   456→    const shown = verbose ? missingAC : missingAC.slice(0, 3);
   457→    for (const w of shown) {
   458→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
   459→    }
   460→    if (!verbose && missingAC.length > 3) {
   461→      console.log(chalk.gray(`    ... and ${missingAC.length - 3} more`));
   462→    }
   463→  }
   464→
   465→  if (missingDesc.length > 0) {
   466→    console.log(chalk.yellow(`  Missing descriptions: ${missingDesc.length}`));
   467→    const shown = verbose ? missingDesc : missingDesc.slice(0, 3);
   468→    for (const w of shown) {
   469→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
   470→    }
   471→    if (!verbose && missingDesc.length > 3) {
   472→      console.log(chalk.gray(`    ... and ${missingDesc.length - 3} more`));
   473→    }
   474→  }
   475→
   476→  if (statusMismatch.length > 0) {
   477→    console.log(
   478→      chalk.yellow(`  Status inconsistencies: ${statusMismatch.length}`),
   479→    );
   480→    for (const w of statusMismatch) {
   481→      console.log(chalk.yellow(`    ! ${w.message}`));
   482→      if (w.details) {
   483→        console.log(chalk.gray(`      ${w.details}`));
   484→      }
   485→    }
   486→  }
   487→
   488→  if (missingTestCoverage.length > 0) {
   489→    console.log(
   490→      chalk.yellow(`  Missing test coverage: ${missingTestCoverage.length}`),
   491→    );
   492→    const shown = verbose
   493→      ? missingTestCoverage
   494→      : missingTestCoverage.slice(0, 3);
   495→    for (const w of shown) {
   496→      console.log(chalk.yellow(`    ! ${w.itemRef} - ${w.itemTitle}`));
   497→      if (w.details) {
   498→        console.log(chalk.gray(`      ${w.details}`));
   499→      }
   500→    }
   501→    if (!verbose && missingTestCoverage.length > 3) {
   502→      console.log(
   503→        chalk.gray(`    ... and ${missingTestCoverage.length - 3} more`),
   504→      );
   505→    }
   506→  }
   507→
   508→  // AC: @task-automation-eligibility ac-21, ac-23
   509→  if (automationNoSpec.length > 0) {
   510→    console.log(
   511→      chalk.yellow(`  Automation without spec: ${automationNoSpec.length}`),
   512→    );
   513→    const shown = verbose ? automationNoSpec : automationNoSpec.slice(0, 3);
   514→    for (const w of shown) {
   515→      console.log(chalk.yellow(`    ! ${w.itemRef} - ${w.itemTitle}`));
   516→      console.log(chalk.gray(`      ${w.message}`));
   517→    }
   518→    if (!verbose && automationNoSpec.length > 3) {
   519→      console.log(
   520→        chalk.gray(`    ... and ${automationNoSpec.length - 3} more`),
   521→      );
   522→    }
   523→  }
   524→}
   525→
   526→/**
   527→ * Format alignment warnings for display
   528→ */
   529→function formatAlignmentWarnings(
   530→  warnings: AlignmentWarning[],
   531→  verbose: boolean,
   532→): void {
   533→  if (warnings.length === 0) {
   534→    console.log(chalk.green("Alignment: OK"));
   535→    return;
   536→  }
   537→
   538→  console.log(chalk.yellow(`\nAlignment warnings: ${warnings.length}`));
   539→
   540→  // Group by type
   541→  const orphaned = warnings.filter((w) => w.type === "orphaned_spec");
   542→  const mismatches = warnings.filter((w) => w.type === "status_mismatch");
   543→  const stale = warnings.filter((w) => w.type === "stale_implementation");
   544→
   545→  if (orphaned.length > 0) {
   546→    console.log(
   547→      chalk.yellow(`  Orphaned specs (no tasks): ${orphaned.length}`),
   548→    );
   549→    const shown = verbose ? orphaned : orphaned.slice(0, 3);
   550→    for (const w of shown) {
   551→      console.log(chalk.gray(`    ○ ${w.specTitle}`));
   552→    }
   553→    if (!verbose && orphaned.length > 3) {
   554→      console.log(chalk.gray(`    ... and ${orphaned.length - 3} more`));
   555→    }
   556→  }
   557→
   558→  if (mismatches.length > 0) {
   559→    console.log(chalk.yellow(`  Status mismatches: ${mismatches.length}`));
   560→    for (const w of mismatches) {
   561→      console.log(chalk.yellow(`    ! ${w.specTitle}`));
   562→      console.log(chalk.gray(`      ${w.message}`));
   563→    }
   564→  }
   565→
   566→  if (stale.length > 0) {
   567→    console.log(chalk.yellow(`  Stale implementation status: ${stale.length}`));
   568→    for (const w of stale) {
   569→      console.log(chalk.yellow(`    ! ${w.message}`));
   570→    }
   571→  }
   572→}
   573→
   574→/**
   575→ * Format fix results for display
   576→ */
   577→function formatFixResult(result: FixResult): void {
   578→  if (result.fixesApplied.length === 0) {
   579→    console.log(chalk.gray("\nNo auto-fixable issues found."));
   580→    return;
   581→  }
   582→
   583→  console.log(
   584→    chalk.cyan(
   585→      `\n✓ Applied ${result.fixesApplied.length} fix(es) to ${result.filesModified} file(s):`,
   586→    ),
   587→  );
   588→
   589→  for (const fix of result.fixesApplied) {
   590→    const typeLabel = {
   591→      ulid_regenerated: "ULID regenerated",
   592→      timestamp_added: "Timestamp added",
   593→      status_added: "Status added",
   594→    }[fix.type];
   595→
   596→    const shortFile = path.basename(fix.file);
   597→    console.log(chalk.cyan(`  ✓ ${shortFile}:${fix.path} - ${typeLabel}`));
   598→  }
   599→
   600→  if (result.errors.length > 0) {
   601→    console.log(chalk.yellow(`\nFix errors: ${result.errors.length}`));
   602→    for (const err of result.errors) {
   603→      console.log(chalk.yellow(`  ! ${err.file}: ${err.message}`));
   604→    }
   605→  }
   606→}
   607→
   608→/**
   609→ * Collect all files that can be fixed
   610→ */
   611→async function collectFixableFiles(ctx: {
   612→  rootDir: string;
   613→  specDir?: string;
   614→  manifest?: { includes?: string[] } | null;
   615→  manifestPath?: string | null;
   616→}): Promise<string[]> {
   617→  const files: string[] = [];
   618→
   619→  // Task files (exclude test fixtures)
   620→  const taskFiles = await findTaskFiles(ctx.rootDir);
   621→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, "spec"));
   622→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
   623→  files.push(
   624→    ...allTaskFiles.filter(
   625→      (f) => !f.includes("fixtures") && !f.includes("test"),
   626→    ),
   627→  );
   628→
   629→  // Spec files from includes
   630→  if (ctx.manifest && ctx.manifestPath) {
   631→    const manifestDir = path.dirname(ctx.manifestPath);
   632→    const includes = ctx.manifest.includes || [];
   633→
   634→    for (const include of includes) {
   635→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   636→      files.push(...expandedPaths);
   637→    }
   638→  }
   639→
   640→  // Inbox file
   641→  const inboxPath = path.join(ctx.rootDir, "spec", "kynetic.inbox.yaml");
   642→  try {
   643→    await import("node:fs/promises").then((fs) => fs.access(inboxPath));
   644→    files.push(inboxPath);
   645→  } catch {
   646→    // Inbox file doesn't exist, skip
   647→  }
   648→
   649→  return [...new Set(files)];
   650→}
   651→
   652→/**
   653→ * Format validation result for display
   654→ */
   655→function formatValidationResult(
   656→  result: ValidationResult,
   657→  verbose: boolean,
   658→): void {
   659→  // Header
   660→  if (result.valid) {
   661→    console.log(chalk.green.bold("✓ Validation passed"));
   662→  } else {
   663→    console.log(chalk.red.bold("✗ Validation failed"));
   664→  }
   665→
   666→  console.log(chalk.gray("─".repeat(40)));
   667→  console.log(`Files checked: ${result.stats.filesChecked}`);
   668→  console.log(`Items checked: ${result.stats.itemsChecked}`);
   669→  console.log(`Tasks checked: ${result.stats.tasksChecked}`);
   670→
   671→  // AC-meta-manifest-2: Display meta summary line
   672→  if (result.metaStats) {
   673→    console.log(
   674→      `Meta: ${result.metaStats.agents} agents, ${result.metaStats.workflows} workflows, ${result.metaStats.conventions} conventions`,
   675→    );
   676→  }
   677→
   678→  // Schema errors
   679→  if (result.schemaErrors.length > 0) {
   680→    console.log(chalk.red(`\nSchema errors: ${result.schemaErrors.length}`));
   681→    for (const err of result.schemaErrors) {
   682→      const location = err.path ? `${err.file}:${err.path}` : err.file;
   683→      console.log(chalk.red(`  ✗ ${location}`));
   684→      console.log(chalk.gray(`    ${err.message}`));
   685→      if (verbose && err.details) {
   686→        console.log(chalk.gray(`    ${JSON.stringify(err.details)}`));
   687→      }
   688→    }
   689→  } else {
   690→    console.log(chalk.green("\nSchema: OK"));
   691→  }
   692→
   693→  // Reference errors
   694→  if (result.refErrors.length > 0) {
   695→    console.log(chalk.red(`\nReference errors: ${result.refErrors.length}`));
   696→    for (const err of result.refErrors) {
   697→      const location = err.sourceFile
   698→        ? `${err.sourceFile} (${err.field})`
   699→        : `${err.sourceUlid?.slice(0, 8)} (${err.field})`;
   700→      console.log(chalk.red(`  ✗ ${err.ref}`));
   701→      console.log(chalk.gray(`    ${err.message}`));
   702→      console.log(chalk.gray(`    in: ${location}`));
   703→    }
   704→  } else {
   705→    console.log(chalk.green("References: OK"));
   706→  }
   707→
   708→  // Reference warnings (deprecated targets)
   709→  if (result.refWarnings.length > 0) {
   710→    console.log(
   711→      chalk.yellow(`\nReference warnings: ${result.refWarnings.length}`),
   712→    );
   713→    const shown = verbose ? result.refWarnings : result.refWarnings.slice(0, 5);
   714→    for (const warn of shown) {
   715→      const location = warn.sourceFile
   716→        ? `${warn.sourceFile} (${warn.field})`
   717→        : `${warn.sourceUlid?.slice(0, 8)} (${warn.field})`;
   718→      console.log(chalk.yellow(`  ⚠ ${warn.ref}`));
   719→      console.log(chalk.gray(`    ${warn.message}`));
   720→      console.log(chalk.gray(`    in: ${location}`));
   721→    }
   722→    if (!verbose && result.refWarnings.length > 5) {
   723→      console.log(
   724→        chalk.gray(
   725→          `  ... and ${result.refWarnings.length - 5} more (use -v to see all)`,
   726→        ),
   727→      );
   728→    }
   729→  }
   730→
   731→  // AC: @trait-edge-cases ac-2
   732→  // Trait cycle errors
   733→  if (result.traitCycleErrors.length > 0) {
   734→    console.log(
   735→      chalk.red(`\nTrait cycle errors: ${result.traitCycleErrors.length}`),
   736→    );
   737→    for (const err of result.traitCycleErrors) {
   738→      console.log(chalk.red(`  ✗ ${err.traitRef} - ${err.traitTitle}`));
   739→      console.log(chalk.gray(`    ${err.message}`));
   740→    }
   741→  }
   742→
   743→  // Orphans (warnings, not errors)
   744→  if (result.orphans.length > 0) {
   745→    console.log(
   746→      chalk.yellow(`\nOrphans (not referenced): ${result.orphans.length}`),
   747→    );
   748→    if (verbose) {
   749→      for (const orphan of result.orphans) {
   750→        console.log(
   751→          chalk.yellow(
   752→            `  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`,
   753→          ),
   754→        );
   755→      }
   756→    } else {
   757→      // Show first few
   758→      const shown = result.orphans.slice(0, 5);
   759→      for (const orphan of shown) {
   760→        console.log(
   761→          chalk.yellow(
   762→            `  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`,
   763→          ),
   764→        );
   765→      }
   766→      if (result.orphans.length > 5) {
   767→        console.log(
   768→          chalk.gray(
   769→            `  ... and ${result.orphans.length - 5} more (use -v to see all)`,
   770→          ),
   771→        );
   772→      }
   773→    }
   774→  }
   775→}
   776→
   777→/**
   778→ * Register validate command
   779→ */
   780→export function registerValidateCommand(program: Command): void {
   781→  program
   782→    .command("validate")
   783→    .description("Validate spec files")
   784→    .option("--schema", "Check schema conformance only")
   785→    .option("--refs", "Check reference resolution only")
   786→    .option("--orphans", "Find orphaned items only")
   787→    .option("--alignment", "Check spec-task alignment")
   788→    .option(
   789→      "--completeness",
   790→      "Check spec completeness (missing AC, descriptions, status inconsistencies)",
   791→    )
   792→    .option("--conventions", "Validate conventions")
   793→    .option(
   794→      "--staleness",
   795→      "Check for stale status mismatches between specs and tasks",
   796→    )
   797→    .option("--skills", "Validate skill files (.claude/skills/*/SKILL.md)")
   798→    .option(
   799→      "--drift",
   800→      "Check AC field references against actual schema (catches spec prose drift)",
   801→    )
   802→    .option(
   803→      "--fix",
   804→      "Auto-fix issues where possible (invalid ULIDs, missing timestamps)",
   805→    )
   806→    .option("-v, --verbose", "Show detailed output")
   807→    .option("--strict", "Treat orphans and staleness warnings as errors")
   808→    .action(async (options) => {
   809→      try {
   810→        const ctx = await initContext();
   811→
   812→        if (!ctx.manifestPath) {
   813→          error(validationStrings.noManifest);
   814→          console.log(validationStrings.initHint);
   815→          process.exit(EXIT_CODES.ERROR);
   816→        }
   817→
   818→        // Track warnings from all sources for exit code determination
   819→        let additionalWarningCount = 0;
   820→
   821→        // Determine which checks to run
   822→        const runAll =
   823→          !options.schema &&
   824→          !options.refs &&
   825→          !options.orphans &&
   826→          !options.alignment &&
   827→          !options.completeness &&
   828→          !options.conventions &&
   829→          !options.skills;
   830→
   831→        // AC: @config-validation ac-4 — CLI --strict overrides config strict_refs
   832→        // If --strict is passed, use strict behavior regardless of config
   833→        // Otherwise, use config value (which defaults to false)
   834→        const strictRefs = options.strict ? true : ctx.config.validation.strict_refs;
   835→        const requireAcceptance = ctx.config.validation.require_acceptance;
   836→
   837→        const validateOptions = {
   838→          schema: runAll || options.schema,
   839→          refs: runAll || options.refs,
   840→          orphans: runAll || options.orphans,
   841→          completeness: runAll || options.completeness,
   842→          // AC: @config-validation ac-2 ac-3 ac-4 — wire config into validation
   843→          strictRefs,
   844→          requireAcceptance,
   845→        };
   846→
   847→        const result = await validate(ctx, validateOptions);
   848→
   849→        // In strict mode, orphans are errors
   850→        if (options.strict && result.orphans.length > 0) {
   851→          result.valid = false;
   852→        }
   853→
   854→        output(result, () => formatValidationResult(result, options.verbose));
   855→
   856→        // Run auto-fix if requested
   857→        if (options.fix) {
   858→          const filesToFix = await collectFixableFiles(ctx);
   859→          const fixResult = await fixFiles(filesToFix);
   860→          formatFixResult(fixResult);
   861→
   862→          // Re-run validation after fixes to show updated status
   863→          if (fixResult.fixesApplied.length > 0) {
   864→            console.log(validationStrings.revalidating);
   865→            const revalidateResult = await validate(ctx, validateOptions);
   866→            if (revalidateResult.valid) {
   867→              console.log(validationStrings.nowPasses);
   868→            } else {
   869→              console.log(validationStrings.issuesRemain);
   870→            }
   871→            // Update result for exit code
   872→            result.valid = revalidateResult.valid;
   873→            result.schemaErrors = revalidateResult.schemaErrors;
   874→            result.refErrors = revalidateResult.refErrors;
   875→          }
   876→        }
   877→
   878→        // Run alignment check if requested or running all checks
   879→        if (options.alignment || runAll) {
   880→          const tasks = await loadAllTasks(ctx);
   881→          const items = await loadAllItems(ctx);
   882→          const refIndex = new ReferenceIndex(tasks, items);
   883→          const alignmentIndex = new AlignmentIndex(tasks, items);
   884→          alignmentIndex.buildLinks(refIndex);
   885→
   886→          const alignmentWarnings = alignmentIndex.findAlignmentWarnings();
   887→          formatAlignmentWarnings(alignmentWarnings, options.verbose);
   888→          additionalWarningCount += alignmentWarnings.length;
   889→
   890→          // Show alignment stats
   891→          const stats = alignmentIndex.getStats();
   892→          console.log(
   893→            validationStrings.alignmentStats(
   894→              stats.specsWithTasks,
   895→              stats.totalSpecs,
   896→              stats.alignedSpecs,
   897→            ),
   898→          );
   899→        }
   900→
   901→        // Show completeness warnings if any
   902→        // AC: @spec-completeness ac-4
   903→        if (result.completenessWarnings.length > 0) {
   904→          formatCompletenessWarnings(
   905→            result.completenessWarnings,
   906→            options.verbose,
   907→          );
   908→        }
   909→
   910→        // Run convention validation if requested
   911→        // AC: @convention-definitions ac-3, ac-4
   912→        if (options.conventions) {
   913→          try {
   914→            const metaCtx = await loadMetaContext(ctx);
   915→            if (metaCtx && metaCtx.conventions.length > 0) {
   916→              // For now, we just validate that conventions are well-formed
   917→              // Full validation against actual content (commits, notes, etc.)
   918→              // would require additional content gathering logic
   919→              const conventionResult = validateConventions(
   920→                metaCtx.conventions,
   921→                {},
   922→              );
   923→              formatConventionValidationResult(conventionResult);
   924→
   925→              if (!conventionResult.valid) {
   926→                result.valid = false;
   927→              }
   928→            } else {
   929→              console.log(
   930→                chalk.gray("No conventions defined in meta manifest"),
   931→              );
   932→            }
   933→          } catch (_err) {
   934→            console.log(
   935→              chalk.yellow(
   936→                "Warning: Could not load meta manifest for convention validation",
   937→              ),
   938→            );
   939→          }
   940→        }
   941→
   942→        // Run staleness checks if requested
   943→        // AC: @stale-status-detection ac-4, ac-5
   944→        let stalenessWarningCount = 0;
   945→        if (options.staleness) {
   946→          const tasks = await loadAllTasks(ctx);
   947→          const items = await loadAllItems(ctx);
   948→          const refIndex = new ReferenceIndex(tasks, items);
   949→
   950→          const stalenessWarnings = checkStaleness(items, tasks, refIndex);
   951→          formatStalenessWarnings(stalenessWarnings, options.verbose);
   952→          stalenessWarningCount = stalenessWarnings.length;
   953→
   954→          // AC: @stale-status-detection ac-5 (staleness-exit-code)
   955→          // With --strict, staleness warnings cause validation failure
   956→          if (options.strict && stalenessWarnings.length > 0) {
   957→            result.valid = false;
   958→          }
   959→        }
   960→
   961→        // Run skill file validation if requested or running all checks
   962→        if (runAll || options.skills) {
   963→          const skillResult = await validateSkills(ctx.rootDir);
   964→          formatSkillValidationResult(skillResult, options.verbose);
   965→
   966→          if (!skillResult.valid) {
   967→            result.valid = false;
   968→          }
   969→        }
   970→
   971→        // Run AC schema drift checks if requested
   972→        let driftWarningCount = 0;
   973→        if (options.drift) {
   974→          const items = await loadAllItems(ctx);
   975→          const driftWarnings = checkACSchemaReferences(items);
   976→          formatDriftWarnings(driftWarnings, options.verbose);
   977→          driftWarningCount = driftWarnings.length;
   978→
   979→          // With --strict, drift warnings cause validation failure
   980→          if (options.strict && driftWarnings.length > 0) {
   981→            result.valid = false;
   982→          }
   983→        }
   984→
   985→        // Determine exit code based on errors vs warnings
   986→        // Errors: schema, refs, trait cycles, conventions, skills (result.valid = false)
   987→        // Warnings: orphans, alignment, completeness, staleness, drift, ref warnings
   988→        const hasErrors = !result.valid;
   989→        const hasWarnings =
   990→          result.orphans.length > 0 ||
   991→          result.refWarnings.length > 0 ||
   992→          result.completenessWarnings.length > 0 ||
   993→          additionalWarningCount > 0 ||
   994→          stalenessWarningCount > 0 ||
   995→          driftWarningCount > 0;
   996→
   997→        if (hasErrors) {
   998→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   999→        } else if (hasWarnings) {
  1000→          process.exit(EXIT_CODES.VALIDATION_WARNINGS);
  1001→        }
  1002→        // Otherwise exit 0 (success)
  1003→      } catch (err) {
  1004→        error(validationStrings.failed, err);
  1005→        process.exit(EXIT_CODES.ERROR);
  1006→      }
  1007→    });
  1008→
  1009→  // Alias: kspec lint
  1010→  program
  1011→    .command("lint")
  1012→    .description("Alias for validate with style checks")
  1013→    .option("--schema", "Check schema conformance only")
  1014→    .option("--refs", "Check reference resolution only")
  1015→    .option("--orphans", "Find orphaned items only")
  1016→    .option(
  1017→      "--completeness",
  1018→      "Check spec completeness (missing AC, descriptions, status inconsistencies)",
  1019→    )
  1020→    .option(
  1021→      "--fix",
  1022→      "Auto-fix issues where possible (invalid ULIDs, missing timestamps)",
  1023→    )
  1024→    .option("-v, --verbose", "Show detailed output")
  1025→    .option("--strict", "Treat orphans as errors")
  1026→    .action(async (options) => {
  1027→      try {
  1028→        const ctx = await initContext();
  1029→
  1030→        if (!ctx.manifestPath) {
  1031→          error(validationStrings.noManifest);
  1032→          process.exit(EXIT_CODES.ERROR);
  1033→        }
  1034→
  1035→        const runAll =
  1036→          !options.schema &&
  1037→          !options.refs &&
  1038→          !options.orphans &&
  1039→          !options.completeness;
  1040→
  1041→        // AC: @config-validation ac-4 — CLI --strict overrides config strict_refs
  1042→        const strictRefs = options.strict ? true : ctx.config.validation.strict_refs;
  1043→        const requireAcceptance = ctx.config.validation.require_acceptance;
  1044→
  1045→        const validateOptions = {
  1046→          schema: runAll || options.schema,
  1047→          refs: runAll || options.refs,
  1048→          orphans: runAll || options.orphans,
  1049→          completeness: runAll || options.completeness,
  1050→          strictRefs,
  1051→          requireAcceptance,
  1052→        };
  1053→
  1054→        const result = await validate(ctx, validateOptions);
  1055→
  1056→        if (options.strict && result.orphans.length > 0) {
  1057→          result.valid = false;
  1058→        }
  1059→
  1060→        output(result, () => formatValidationResult(result, options.verbose));
  1061→
  1062→        // Run auto-fix if requested
  1063→        if (options.fix) {
  1064→          const filesToFix = await collectFixableFiles(ctx);
  1065→          const fixResult = await fixFiles(filesToFix);
  1066→          formatFixResult(fixResult);
  1067→
  1068→          // Re-run validation after fixes
  1069→          if (fixResult.fixesApplied.length > 0) {
  1070→            console.log(validationStrings.revalidating);
  1071→            const revalidateResult = await validate(ctx, validateOptions);
  1072→            if (revalidateResult.valid) {
  1073→              console.log(validationStrings.nowPasses);
  1074→            } else {
  1075→              console.log(validationStrings.issuesRemain);
  1076→            }
  1077→            result.valid = revalidateResult.valid;
  1078→          }
  1079→        }
  1080→
  1081→        // Determine exit code based on errors vs warnings
  1082→        const hasErrors = !result.valid;
  1083→        const hasWarnings =
  1084→          result.orphans.length > 0 ||
  1085→          result.refWarnings.length > 0 ||
  1086→          result.completenessWarnings.length > 0;
  1087→
  1088→        if (hasErrors) {
  1089→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1090→        } else if (hasWarnings) {
  1091→          process.exit(EXIT_CODES.VALIDATION_WARNINGS);
  1092→        }
  1093→        // Otherwise exit 0 (success)
  1094→      } catch (err) {
  1095→        error(validationStrings.lintFailed, err);
  1096→        process.exit(EXIT_CODES.ERROR);
  1097→      }
  1098→    });
  1099→}
  1100→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
