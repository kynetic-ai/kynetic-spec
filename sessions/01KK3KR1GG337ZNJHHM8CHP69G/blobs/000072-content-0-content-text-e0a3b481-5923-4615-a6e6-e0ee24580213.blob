```
     1→/**
     2→ * WebSocketManager
     3→ *
     4→ * Manages WebSocket connection lifecycle with exponential backoff reconnection,
     5→ * sequence deduplication, and automatic topic re-subscription.
     6→ *
     7→ * AC Coverage:
     8→ * - ac-28 (@web-dashboard): Exponential backoff reconnect (1s, 2s, 4s... max 30s)
     9→ * - ac-29 (@web-dashboard): Connection lost indicator after 10s
    10→ * - ac-30 (@web-dashboard): Sequence deduplication (skip seq <= lastSeqProcessed)
    11→ * - ac-31 (@web-dashboard): Reset lastSeqProcessed = -1 on reconnect
    12→ * - ac-32 (@web-dashboard): Re-subscribe to all topics on reconnect
    13→ * - ac-33 (@web-dashboard): Trigger update handlers on broadcast events
    14→ * - ac-34 (@multi-directory-daemon): Project path as query parameter for WebSocket
    15→ */
    16→
    17→import type {
    18→	WebSocketCommand,
    19→	WebSocketMessage,
    20→	BroadcastEvent,
    21→	ConnectedEvent,
    22→	CommandAck
    23→} from '@kynetic-ai/shared';
    24→import type {
    25→	ConnectionState,
    26→	Subscription,
    27→	ConnectionStats,
    28→	EventHandler,
    29→	StateChangeHandler
    30→} from './types.js';
    31→import { DAEMON_WS_BASE } from '../constants.js';
    32→
    33→const DEFAULT_URL = `${DAEMON_WS_BASE}/ws`;
    34→const MAX_BACKOFF_MS = 30000; // 30s
    35→const CONNECTION_LOST_THRESHOLD_MS = 10000; // 10s
    36→const MAX_RECONNECT_ATTEMPTS = 10;
    37→
    38→export interface WebSocketManagerOptions {
    39→	url?: string;
    40→	projectPath?: string;
    41→}
    42→
    43→export class WebSocketManager {
    44→	private ws: WebSocket | null = null;
    45→	private baseUrl: string;
    46→	private projectPath: string | null;
    47→	private state: ConnectionState = 'disconnected';
    48→	private intentionalDisconnect = false;
    49→	private subscriptions = new Map<string, Subscription>();
    50→	private eventHandlers = new Map<string, Set<EventHandler>>();
    51→	private stateChangeHandlers = new Set<StateChangeHandler>();
    52→
    53→	// AC: @web-dashboard ac-30, ac-31
    54→	private lastSeqProcessed = -1;
    55→
    56→	// AC: @web-dashboard ac-28
    57→	private reconnectAttempts = 0;
    58→	private reconnectTimer: ReturnType<typeof setTimeout> | null = null;
    59→
    60→	// AC: @web-dashboard ac-29
    61→	private connectionLostTimer: ReturnType<typeof setTimeout> | null = null;
    62→
    63→	private stats: ConnectionStats = {
    64→		connect_count: 0,
    65→		reconnect_count: 0,
    66→		last_connected_at: null,
    67→		last_disconnected_at: null
    68→	};
    69→
    70→	constructor(options: WebSocketManagerOptions | string = {}) {
    71→		// Support both old string signature and new options object
    72→		if (typeof options === 'string') {
    73→			this.baseUrl = options;
    74→			this.projectPath = null;
    75→		} else {
    76→			this.baseUrl = options.url || DEFAULT_URL;
    77→			this.projectPath = options.projectPath || null;
    78→		}
    79→	}
    80→
    81→	/**
    82→	 * Get the full WebSocket URL with project path as query param if set
    83→	 * AC: @multi-directory-daemon ac-34
    84→	 */
    85→	private getUrl(): string {
    86→		if (!this.projectPath) {
    87→			return this.baseUrl;
    88→		}
    89→		const url = new URL(this.baseUrl);
    90→		url.searchParams.set('project', this.projectPath);
    91→		return url.toString();
    92→	}
    93→
    94→	/**
    95→	 * Update the project path and trigger reconnection if connected
    96→	 * AC: @multi-directory-daemon ac-27
    97→	 */
    98→	setProjectPath(path: string | null): void {
    99→		if (this.projectPath === path) return;
   100→
   101→		this.projectPath = path;
   102→
   103→		// If connected, disconnect and reconnect with new project
   104→		if (this.isConnected()) {
   105→			this.reconnectAttempts = 0; // Reset so we try fresh
   106→			this.disconnect();
   107→			this.connect();
   108→		}
   109→	}
   110→
   111→	/**
   112→	 * Get current project path
   113→	 */
   114→	getProjectPath(): string | null {
   115→		return this.projectPath;
   116→	}
   117→
   118→	/**
   119→	 * Get current connection state
   120→	 * AC: @web-dashboard ac-29
   121→	 */
   122→	getState(): ConnectionState {
   123→		return this.state;
   124→	}
   125→
   126→	/**
   127→	 * Check if connection is established
   128→	 * AC: @web-dashboard ac-29
   129→	 */
   130→	isConnected(): boolean {
   131→		return this.state === 'connected';
   132→	}
   133→
   134→	/**
   135→	 * Check if connection has been lost for > threshold
   136→	 * AC: @web-dashboard ac-29
   137→	 */
   138→	isConnectionLost(): boolean {
   139→		if (this.state === 'connected') return false;
   140→		if (!this.stats.last_disconnected_at) return false;
   141→
   142→		const timeSinceDisconnect = Date.now() - this.stats.last_disconnected_at.getTime();
   143→		return timeSinceDisconnect > CONNECTION_LOST_THRESHOLD_MS;
   144→	}
   145→
   146→	/**
   147→	 * Connect to WebSocket server
   148→	 * AC: @web-dashboard ac-28
   149→	 * AC: @multi-directory-daemon ac-34 - Includes project as query param
   150→	 */
   151→	connect(): void {
   152→		if (this.ws && (this.state === 'connected' || this.state === 'connecting')) {
   153→			console.warn('[WebSocketManager] Already connected or connecting');
   154→			return;
   155→		}
   156→
   157→		this.intentionalDisconnect = false;
   158→		this.setState('connecting');
   159→		const url = this.getUrl();
   160→		console.log('[WebSocketManager] Connecting to:', url);
   161→		const socket = new WebSocket(url);
   162→		this.ws = socket;
   163→
   164→		socket.onopen = () => {
   165→			if (this.ws !== socket) {
   166→				return;
   167→			}
   168→			console.log('[WebSocketManager] Connected');
   169→			this.setState('connected');
   170→			this.reconnectAttempts = 0;
   171→			this.stats.connect_count++;
   172→			this.stats.last_connected_at = new Date();
   173→			this.clearConnectionLostTimer();
   174→		};
   175→
   176→		socket.onmessage = (event) => {
   177→			if (this.ws !== socket) {
   178→				return;
   179→			}
   180→			try {
   181→				const message: WebSocketMessage = JSON.parse(event.data);
   182→				this.handleMessage(message);
   183→			} catch (err) {
   184→				console.error('[WebSocketManager] Failed to parse message:', err);
   185→			}
   186→		};
   187→
   188→		socket.onerror = (error) => {
   189→			if (this.ws !== socket) {
   190→				return;
   191→			}
   192→			console.error('[WebSocketManager] WebSocket error:', error);
   193→		};
   194→
   195→		socket.onclose = (event) => {
   196→			if (this.ws !== socket) {
   197→				return;
   198→			}
   199→			console.log('[WebSocketManager] Disconnected:', event.code, event.reason);
   200→			this.setState('disconnected');
   201→			this.stats.last_disconnected_at = new Date();
   202→			this.ws = null;
   203→
   204→			if (this.intentionalDisconnect) {
   205→				this.intentionalDisconnect = false;
   206→				return;
   207→			}
   208→
   209→			// AC: @web-dashboard ac-28, ac-29
   210→			this.startConnectionLostTimer();
   211→			this.scheduleReconnect();
   212→		};
   213→	}
   214→
   215→	/**
   216→	 * Disconnect from WebSocket server
   217→	 */
   218→	disconnect(): void {
   219→		this.clearReconnectTimer();
   220→		this.clearConnectionLostTimer();
   221→		this.intentionalDisconnect = true;
   222→
   223→		if (this.ws) {
   224→			const socket = this.ws;
   225→			this.ws = null;
   226→			socket.close(1000, 'Client disconnect');
   227→		}
   228→
   229→		this.setState('disconnected');
   230→	}
   231→
   232→	/**
   233→	 * Subscribe to topics
   234→	 * AC: @web-dashboard ac-32
   235→	 */
   236→	subscribe(topics: string[]): void {
   237→		// Track subscriptions
   238→		for (const topic of topics) {
   239→			if (!this.subscriptions.has(topic)) {
   240→				this.subscriptions.set(topic, {
   241→					topic,
   242→					subscribed_at: new Date()
   243→				});
   244→			}
   245→		}
   246→
   247→		// Send subscribe command if connected
   248→		if (this.isConnected()) {
   249→			this.sendCommand({
   250→				action: 'subscribe',
   251→				request_id: crypto.randomUUID(),
   252→				payload: { topics }
   253→			});
   254→		}
   255→	}
   256→
   257→	/**
   258→	 * Unsubscribe from topics
   259→	 */
   260→	unsubscribe(topics: string[]): void {
   261→		for (const topic of topics) {
   262→			this.subscriptions.delete(topic);
   263→		}
   264→
   265→		if (this.isConnected()) {
   266→			this.sendCommand({
   267→				action: 'unsubscribe',
   268→				request_id: crypto.randomUUID(),
   269→				payload: { topics }
   270→			});
   271→		}
   272→	}
   273→
   274→	/**
   275→	 * Register event handler for topic
   276→	 * AC: @web-dashboard ac-33
   277→	 */
   278→	on(topic: string, handler: EventHandler): void {
   279→		if (!this.eventHandlers.has(topic)) {
   280→			this.eventHandlers.set(topic, new Set());
   281→		}
   282→		this.eventHandlers.get(topic)!.add(handler);
   283→	}
   284→
   285→	/**
   286→	 * Unregister event handler
   287→	 */
   288→	off(topic: string, handler: EventHandler): void {
   289→		const handlers = this.eventHandlers.get(topic);
   290→		if (handlers) {
   291→			handlers.delete(handler);
   292→			if (handlers.size === 0) {
   293→				this.eventHandlers.delete(topic);
   294→			}
   295→		}
   296→	}
   297→
   298→	/**
   299→	 * Register state change handler
   300→	 * AC: @web-dashboard ac-29
   301→	 */
   302→	onStateChange(handler: StateChangeHandler): void {
   303→		this.stateChangeHandlers.add(handler);
   304→	}
   305→
   306→	/**
   307→	 * Unregister state change handler
   308→	 */
   309→	offStateChange(handler: StateChangeHandler): void {
   310→		this.stateChangeHandlers.delete(handler);
   311→	}
   312→
   313→	/**
   314→	 * Handle incoming WebSocket message
   315→	 * AC: @web-dashboard ac-30, ac-31, ac-32, ac-33
   316→	 */
   317→	private handleMessage(message: WebSocketMessage): void {
   318→		// Handle ConnectedEvent
   319→		if ('event' in message && message.event === 'connected') {
   320→			const connectedEvent = message as ConnectedEvent;
   321→			console.log('[WebSocketManager] Session ID:', connectedEvent.data.session_id);
   322→
   323→			// AC: @web-dashboard ac-31 - Reset sequence on new connection
   324→			this.lastSeqProcessed = -1;
   325→
   326→			// AC: @web-dashboard ac-32 - Re-subscribe to all topics
   327→			if (this.subscriptions.size > 0) {
   328→				const topics = Array.from(this.subscriptions.keys());
   329→				this.sendCommand({
   330→					action: 'subscribe',
   331→					request_id: crypto.randomUUID(),
   332→					payload: { topics }
   333→				});
   334→			}
   335→			return;
   336→		}
   337→
   338→		// Handle CommandAck
   339→		if ('ack' in message) {
   340→			const ack = message as CommandAck;
   341→			if (!ack.success) {
   342→				console.error('[WebSocketManager] Command failed:', ack.error);
   343→			}
   344→			return;
   345→		}
   346→
   347→		// Handle BroadcastEvent
   348→		if ('msg_id' in message && 'seq' in message) {
   349→			const event = message as BroadcastEvent;
   350→
   351→			// AC: @web-dashboard ac-30 - Sequence deduplication
   352→			if (event.seq <= this.lastSeqProcessed) {
   353→				console.debug('[WebSocketManager] Skipping duplicate event:', event.seq);
   354→				return;
   355→			}
   356→
   357→			this.lastSeqProcessed = event.seq;
   358→
   359→			// AC: @web-dashboard ac-33 - Trigger event handlers
   360→			const handlers = this.eventHandlers.get(event.topic);
   361→			if (handlers) {
   362→				for (const handler of handlers) {
   363→					try {
   364→						handler(event);
   365→					} catch (err) {
   366→						console.error('[WebSocketManager] Event handler error:', err);
   367→					}
   368→				}
   369→			}
   370→		}
   371→	}
   372→
   373→	/**
   374→	 * Send command to server
   375→	 */
   376→	private sendCommand(command: WebSocketCommand): void {
   377→		if (!this.ws || this.ws.readyState !== WebSocket.OPEN) {
   378→			console.warn('[WebSocketManager] Cannot send command: not connected');
   379→			return;
   380→		}
   381→
   382→		try {
   383→			this.ws.send(JSON.stringify(command));
   384→		} catch (err) {
   385→			console.error('[WebSocketManager] Failed to send command:', err);
   386→		}
   387→	}
   388→
   389→	/**
   390→	 * Schedule reconnect with exponential backoff
   391→	 * AC: @web-dashboard ac-28
   392→	 */
   393→	private scheduleReconnect(): void {
   394→		if (this.reconnectAttempts >= MAX_RECONNECT_ATTEMPTS) {
   395→			console.error('[WebSocketManager] Max reconnect attempts reached');
   396→			return;
   397→		}
   398→
   399→		this.clearReconnectTimer();
   400→
   401→		// Increment attempt counter before calculating backoff
   402→		this.reconnectAttempts++;
   403→		this.stats.reconnect_count++;
   404→
   405→		// Exponential backoff: 1s, 2s, 4s, 8s, 16s, 30s (capped)
   406→		const backoffMs = Math.min(
   407→			Math.pow(2, this.reconnectAttempts - 1) * 1000,
   408→			MAX_BACKOFF_MS
   409→		);
   410→
   411→		console.log(
   412→			`[WebSocketManager] Reconnecting in ${backoffMs}ms (attempt ${this.reconnectAttempts}/${MAX_RECONNECT_ATTEMPTS})`
   413→		);
   414→
   415→		this.reconnectTimer = setTimeout(() => {
   416→			this.setState('reconnecting');
   417→			this.connect();
   418→		}, backoffMs);
   419→	}
   420→
   421→	/**
   422→	 * Clear reconnect timer
   423→	 */
   424→	private clearReconnectTimer(): void {
   425→		if (this.reconnectTimer) {
   426→			clearTimeout(this.reconnectTimer);
   427→			this.reconnectTimer = null;
   428→		}
   429→	}
   430→
   431→	/**
   432→	 * Start connection lost timer
   433→	 * AC: @web-dashboard ac-29
   434→	 */
   435→	private startConnectionLostTimer(): void {
   436→		this.clearConnectionLostTimer();
   437→
   438→		this.connectionLostTimer = setTimeout(() => {
   439→			// Notify UI that connection has been lost for >10s
   440→			// This triggers even if state hasn't changed (e.g., still 'disconnected')
   441→			this.notifyConnectionLostChange();
   442→		}, CONNECTION_LOST_THRESHOLD_MS);
   443→	}
   444→
   445→	/**
   446→	 * Clear connection lost timer
   447→	 */
   448→	private clearConnectionLostTimer(): void {
   449→		if (this.connectionLostTimer) {
   450→			clearTimeout(this.connectionLostTimer);
   451→			this.connectionLostTimer = null;
   452→		}
   453→	}
   454→
   455→	/**
   456→	 * Update state and notify listeners
   457→	 */
   458→	private setState(state: ConnectionState): void {
   459→		if (this.state === state) return;
   460→		this.state = state;
   461→		this.notifyStateChange();
   462→	}
   463→
   464→	/**
   465→	 * Notify state change handlers
   466→	 */
   467→	private notifyStateChange(): void {
   468→		for (const handler of this.stateChangeHandlers) {
   469→			try {
   470→				handler(this.state);
   471→			} catch (err) {
   472→				console.error('[WebSocketManager] State change handler error:', err);
   473→			}
   474→		}
   475→	}
   476→
   477→	/**
   478→	 * Notify state change handlers when connectionLost threshold is crossed
   479→	 * This ensures the UI updates even if the state hasn't changed
   480→	 */
   481→	private notifyConnectionLostChange(): void {
   482→		this.notifyStateChange();
   483→	}
   484→
   485→	/**
   486→	 * Get connection statistics
   487→	 */
   488→	getStats(): Readonly<ConnectionStats> {
   489→		return { ...this.stats };
   490→	}
   491→
   492→	/**
   493→	 * Get active subscriptions
   494→	 */
   495→	getSubscriptions(): string[] {
   496→		return Array.from(this.subscriptions.keys());
   497→	}
   498→}
   499→
```