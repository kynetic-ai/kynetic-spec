## 2. LAYOUT SYSTEM

### Root Layout (+layout.svelte)
**File:** `/home/chapel/Projects/kynetic-spec-ui/packages/web-ui/src/routes/+layout.svelte`

Uses **Svelte 5 runes** (`$state`, `$derived`, `$effect`) with the new snippet-based child pattern:

```svelte
<script lang="ts">
  import { onMount } from 'svelte';
  import { SidebarProvider, SidebarInset } from '$lib/components/ui/sidebar';
  import Sidebar from '$lib/components/Sidebar.svelte';
  import MobileNav from '$lib/components/MobileNav.svelte';
  import CommandPalette from '$lib/components/CommandPalette.svelte';
  import ReadOnlyBanner from '$lib/components/ReadOnlyBanner.svelte';
  import { initConnection } from '$lib/stores/connection.svelte';
  import { loadProjects, getSelectedProjectPath, isInitialized } from '$lib/stores/project.svelte';
  import { initMode, isStaticMode, isLoading as isModeLoading } from '$lib/stores/mode.svelte';

  let { children } = $props(); // Svelte 5 pattern
  let appReady = $state(false);

  onMount(async () => {
    await initMode(); // Daemon or static mode detection
    if (isStaticMode()) {
      appReady = true;
      return;
    }
    await loadProjects();
    appReady = true;
    const projectPath = getSelectedProjectPath();
    initConnection({ projectPath: projectPath ?? undefined });
  });

  let ready = $derived(browser ? appReady : true);
</script>

<CommandPalette />
<SidebarProvider>
  <div class="hidden md:block">
    <Sidebar />
  </div>
  <SidebarInset>
    <ReadOnlyBanner />
    <main class="flex-1 overflow-auto p-4 pb-20 md:pb-4">
      {#if ready}
        {@render children()}
      {:else}
        <div>Loading...</div>
      {/if}
    </main>
  </SidebarInset>
  <MobileNav />
</SidebarProvider>
```

**Key points:**
- Uses SidebarProvider + SidebarInset for responsive layout
- Desktop sidebar hidden on mobile (`hidden md:block`)
- Mobile nav fixed at bottom (`md:hidden`)
- 3-phase initialization: mode detection → project loading → WebSocket connection
- Supports SSR with `browser` guard

