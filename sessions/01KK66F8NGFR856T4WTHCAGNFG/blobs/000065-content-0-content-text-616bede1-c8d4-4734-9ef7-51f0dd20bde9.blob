   572→  // AC: @web-ui ac-1
   573→  it('should bundle daemon runtime dependencies in the npm package', async () => {
   574→    // Pack the project, install the tarball into an isolated directory,
   575→    // and verify that the daemon binary and its runtime imports resolve.
   576→    const projectRoot = join(__dirname, '..');
   577→    const installDir = await createTempDir();
   578→
   579→    try {
   580→      // Fresh pack so we test the current build output
   581→      const packOutput = execSync('npm pack --pack-destination ' + installDir, {
   582→        cwd: projectRoot,
   583→        encoding: 'utf-8',
   584→        stdio: ['pipe', 'pipe', 'pipe'],
   585→      }).trim();
   586→      const tarball = join(installDir, packOutput.split('\n').pop()!.trim());
   587→
   588→      // Install the tarball into the temp dir (brings transitive deps)
   589→      execSync(`npm init -y && npm install --no-save "${tarball}"`, {
   590→        cwd: installDir,
   591→        encoding: 'utf-8',
   592→        stdio: ['pipe', 'pipe', 'pipe'],
   593→        timeout: 60_000,
   594→      });
   595→
   596→      // Resolve the installed package's dist/daemon/index.ts
   597→      const installedPkgDir = join(installDir, 'node_modules', '@kynetic-ai', 'spec');
   598→      const daemonEntry = join(installedPkgDir, 'dist', 'daemon', 'index.ts');
   599→      expect(existsSync(daemonEntry), `daemon entry not found at ${daemonEntry}`).toBe(true);
   600→
   601→      // Verify runtime dependencies resolve from the installed location
   602→      const depsToCheck = ['elysia', '@elysiajs/cors', '@elysiajs/static'];
   603→      for (const dep of depsToCheck) {
   604→        const resolved = require.resolve(dep, { paths: [installedPkgDir] });
   605→        expect(resolved, `${dep} should resolve from installed package`).toBeTruthy();
   606→      }
   607→    } finally {
   608→      await cleanupTempDir(installDir);
   609→    }
   610→  }, 90_000);
