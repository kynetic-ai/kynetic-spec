   291→  // AC: @daemon-server ac-12
   292→  it('should send SIGTERM and wait for shutdown', async () => {
   293→    if (!bunAvailable) {
   294→      console.log('  ⊘ Skipping test - Bun runtime required');
   295→      return;
   296→    }
   297→
   298→    const port = await getAvailablePort();
