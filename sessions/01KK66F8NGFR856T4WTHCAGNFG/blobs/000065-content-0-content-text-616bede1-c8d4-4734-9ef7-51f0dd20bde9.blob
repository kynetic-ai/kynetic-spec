   616→    const noBunPath = (process.env.PATH || '')
   617→      .split(':')
   618→      .filter(p => {
   619→        try { return !existsSync(join(p, 'bun')); } catch { return true; }
   620→      })
   621→      .join(':');
   622→    // Ensure node's directory is always present
   623→    const pathWithNode = noBunPath.includes(nodeDir) ? noBunPath : `${nodeDir}:${noBunPath}`;
