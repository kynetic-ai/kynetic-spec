```
     1→<!--
     2→  AC: @ui-agent-dispatch ac-4 — Inline edit form for agent definitions.
     3→  Schema-driven: types (AgentDefinition, AgentUpdatePayload, AgentDispatchRule) and
     4→  dispatch event values (AGENT_DISPATCH_EVENTS) from @kynetic-ai/shared, which mirrors
     5→  AgentSchema / AgentDispatchEventSchema from src/schema/meta.ts.
     6→-->
     7→<script lang="ts">
     8→	import { updateAgentDefinition } from '$lib/api';
     9→	import {
    10→		AGENT_DISPATCH_EVENTS,
    11→		type AgentDefinition,
    12→		type AgentUpdatePayload,
    13→		type AgentDispatchEvent,
    14→		type AgentDispatchRule,
    15→		type AgentDispatchFilter
    16→	} from '@kynetic-ai/shared';
    17→	import { ReadOnlyModeError } from '$lib/stores/mode.svelte';
    18→	import * as Dialog from '$lib/components/ui/dialog';
    19→	import { Button } from '$lib/components/ui/button';
    20→	import { Input } from '$lib/components/ui/input';
    21→	import { Textarea } from '$lib/components/ui/textarea';
    22→	import { Badge } from '$lib/components/ui/badge';
    23→	import { Separator } from '$lib/components/ui/separator';
    24→	import {
    25→		Select,
    26→		SelectContent,
    27→		SelectItem,
    28→		SelectTrigger
    29→	} from '$lib/components/ui/select';
    30→	import X from '@lucide/svelte/icons/x';
    31→	import Plus from '@lucide/svelte/icons/plus';
    32→	import Filter from '@lucide/svelte/icons/filter';
    33→
    34→	let {
    35→		open = $bindable(false),
    36→		agent,
    37→		onSaved
    38→	}: {
    39→		open?: boolean;
    40→		agent: AgentDefinition;
    41→		onSaved?: (updated: AgentDefinition) => void;
    42→	} = $props();
    43→
    44→	// Form state derived from agent prop — reset when dialog opens
    45→	// Field structure mirrors AgentDefinition from @kynetic-ai/shared (schema-driven)
    46→	let name = $state('');
    47→	let description = $state('');
    48→	let adapter = $state('');
    49→	let dispatchTriggers = $state<AgentDispatchRule[]>([]);
    50→	let capabilities = $state<string[]>([]);
    51→	let tools = $state<string[]>([]);
    52→	let skills = $state<string[]>([]);
    53→	let maxTasks = $state<number | undefined>(undefined);
    54→	let maxRetries = $state<number | undefined>(undefined);
    55→	let timeoutMinutes = $state<number | undefined>(undefined);
    56→	let maxConcurrent = $state(1);
    57→	let autoApprove = $state(false);
    58→	let promptTemplate = $state('');
    59→
    60→	// UI state
    61→	let saving = $state(false);
    62→	let error = $state('');
    63→
    64→	// Chip input buffers
    65→	let newCapability = $state('');
    66→	let newTool = $state('');
    67→	let newSkill = $state('');
    68→
    69→	// Reset form state when dialog opens
    70→	$effect(() => {
    71→		if (open && agent) {
    72→			name = agent.name;
    73→			description = agent.description ?? '';
    74→			adapter = agent.adapter ?? '';
    75→			dispatchTriggers = agent.dispatch.map((d) => ({ ...d, filter: d.filter ? { ...d.filter } : undefined }));
    76→			capabilities = [...agent.capabilities];
    77→			tools = [...agent.tools];
    78→			skills = [...agent.skills];
    79→			maxTasks = agent.budget?.max_tasks;
    80→			maxRetries = agent.budget?.max_retries;
    81→			timeoutMinutes = agent.budget?.timeout_minutes;
    82→			maxConcurrent = agent.concurrency?.max_concurrent ?? 1;
    83→			autoApprove = agent.auto_approve;
    84→			promptTemplate = agent.prompt_template ?? '';
    85→			error = '';
    86→			newCapability = '';
    87→			newTool = '';
    88→			newSkill = '';
    89→		}
    90→	});
    91→
    92→	// Available dispatch events not yet selected
    93→	let availableEvents = $derived(
    94→		AGENT_DISPATCH_EVENTS.filter((e) => !dispatchTriggers.some((t) => t.on === e))
    95→	);
    96→
    97→	// AC: @ui-agent-dispatch ac-6 — default automation:eligible for task.ready/task.needs_work
    98→	function addTrigger(event: AgentDispatchEvent) {
    99→		const defaultsToEligible = event === 'task.ready' || event === 'task.needs_work';
   100→		const filter: AgentDispatchFilter | undefined = defaultsToEligible
   101→			? { automation: 'eligible' }
   102→			: undefined;
   103→		dispatchTriggers = [...dispatchTriggers, { on: event, filter }];
   104→	}
   105→
   106→	function removeTrigger(index: number) {
   107→		dispatchTriggers = dispatchTriggers.filter((_, i) => i !== index);
   108→	}
   109→
   110→	// AC: @ui-agent-dispatch ac-5 — update filter on a trigger
   111→	function updateTriggerFilter(index: number, updates: Partial<AgentDispatchFilter>) {
   112→		dispatchTriggers = dispatchTriggers.map((t, i) => {
   113→			if (i !== index) return t;
   114→			const currentFilter = t.filter ?? {};
   115→			const newFilter = { ...currentFilter, ...updates };
   116→			// Clean up undefined/empty values
   117→			if (newFilter.automation === undefined) delete newFilter.automation;
   118→			if (!newFilter.tags || newFilter.tags.length === 0) delete newFilter.tags;
   119→			if (newFilter.priority === undefined) delete newFilter.priority;
   120→			// If filter is empty, set to undefined
   121→			const hasFilter = Object.keys(newFilter).length > 0;
   122→			return { ...t, filter: hasFilter ? newFilter : undefined };
   123→		});
   124→	}
   125→
   126→	// AC: @ui-agent-dispatch ac-7 — add tag to a trigger's filter
   127→	function addFilterTag(index: number, tag: string) {
   128→		const trimmed = tag.trim();
   129→		if (!trimmed) return;
   130→		const currentTags = dispatchTriggers[index]?.filter?.tags ?? [];
   131→		if (currentTags.includes(trimmed)) return;
   132→		updateTriggerFilter(index, { tags: [...currentTags, trimmed] });
   133→	}
   134→
   135→	// AC: @ui-agent-dispatch ac-7 — remove tag from a trigger's filter
   136→	function removeFilterTag(index: number, tagIndex: number) {
   137→		const currentTags = dispatchTriggers[index]?.filter?.tags ?? [];
   138→		const newTags = currentTags.filter((_, i) => i !== tagIndex);
   139→		updateTriggerFilter(index, { tags: newTags.length > 0 ? newTags : undefined });
   140→	}
   141→
   142→	// Tag input buffers per trigger
   143→	let triggerTagInputs = $state<Record<number, string>>({});
   144→
   145→	function addChip(list: string[], value: string, setter: (v: string[]) => void, clearInput: () => void) {
   146→		const trimmed = value.trim();
   147→		if (trimmed && !list.includes(trimmed)) {
   148→			setter([...list, trimmed]);
   149→			clearInput();
   150→		}
   151→	}
   152→
   153→	function removeChip(list: string[], index: number, setter: (v: string[]) => void) {
   154→		setter(list.filter((_, i) => i !== index));
   155→	}
   156→
   157→	async function handleSave() {
   158→		saving = true;
   159→		error = '';
   160→
   161→		const payload: AgentUpdatePayload = {
   162→			name,
   163→			description: description || undefined,
   164→			adapter: adapter || undefined,
   165→			dispatch: dispatchTriggers,
   166→			capabilities,
   167→			tools,
   168→			skills,
   169→			budget: (maxTasks !== undefined || maxRetries !== undefined || timeoutMinutes !== undefined)
   170→				? { max_tasks: maxTasks, max_retries: maxRetries, timeout_minutes: timeoutMinutes }
   171→				: undefined,
   172→			concurrency: { max_concurrent: maxConcurrent },
   173→			auto_approve: autoApprove,
   174→			prompt_template: promptTemplate || undefined
   175→		};
   176→
   177→		try {
   178→			const updated = await updateAgentDefinition(agent.id, payload);
   179→			onSaved?.(updated);
   180→			open = false;
   181→		} catch (err) {
   182→			if (err instanceof ReadOnlyModeError) {
   183→				error = err.message;
   184→			} else {
   185→				error = err instanceof Error ? err.message : 'Failed to save agent';
   186→			}
   187→		} finally {
   188→			saving = false;
   189→		}
   190→	}
   191→
   192→	function handleCancel() {
   193→		open = false;
   194→	}
   195→</script>
   196→
   197→<Dialog.Root bind:open>
   198→	<Dialog.Content class="max-w-2xl max-h-[85vh] overflow-y-auto" data-testid="agent-edit-dialog">
   199→		<Dialog.Header>
   200→			<Dialog.Title data-testid="agent-edit-title">Edit Agent: {agent.id}</Dialog.Title>
   201→			<Dialog.Description>
   202→				Modify agent definition fields. Changes are persisted to kynetic.meta.yaml.
   203→			</Dialog.Description>
   204→		</Dialog.Header>
   205→
   206→		{#if error}
   207→			<div
   208→				class="bg-destructive/10 text-destructive p-3 rounded-lg text-sm"
   209→				data-testid="agent-edit-error"
   210→				role="alert"
   211→			>
   212→				{error}
   213→			</div>
   214→		{/if}
   215→
   216→		<div class="flex flex-col gap-4">
   217→			<!-- Name -->
   218→			<div>
   219→				<label for="agent-name" class="text-sm font-medium">Name</label>
   220→				<Input
   221→					id="agent-name"
   222→					bind:value={name}
   223→					placeholder="Agent name"
   224→					data-testid="agent-edit-name"
   225→				/>
   226→			</div>
   227→
   228→			<!-- Description -->
   229→			<div>
   230→				<label for="agent-description" class="text-sm font-medium">Description</label>
   231→				<Textarea
   232→					id="agent-description"
   233→					bind:value={description}
   234→					placeholder="Agent description"
   235→					rows={2}
   236→					data-testid="agent-edit-description"
   237→				/>
   238→			</div>
   239→
   240→			<!-- Adapter -->
   241→			<div>
   242→				<label for="agent-adapter" class="text-sm font-medium">Adapter</label>
   243→				<Input
   244→					id="agent-adapter"
   245→					bind:value={adapter}
   246→					placeholder="e.g. claude-code"
   247→					data-testid="agent-edit-adapter"
   248→				/>
   249→			</div>
   250→
   251→			<Separator />
   252→
   253→			<!-- Dispatch Triggers (schema-driven from AGENT_DISPATCH_EVENTS) -->
   254→			<div>
   255→				<p class="text-sm font-medium mb-2">Dispatch Triggers</p>
   256→				<div class="flex flex-wrap gap-1.5 mb-2" data-testid="agent-edit-triggers">
   257→					{#each dispatchTriggers as trigger, i}
   258→						<Badge variant="secondary" class="gap-1 pr-1">
   259→							{trigger.on}
   260→							<button
   261→								type="button"
   262→								class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   263→								onclick={() => removeTrigger(i)}
   264→								aria-label="Remove trigger {trigger.on}"
   265→								data-testid="remove-trigger-{trigger.on}"
   266→							>
   267→								<X class="h-3 w-3" />
   268→							</button>
   269→						</Badge>
   270→					{/each}
   271→				</div>
   272→				{#if availableEvents.length > 0}
   273→					<div class="flex flex-wrap gap-1.5" data-testid="agent-edit-available-triggers">
   274→						{#each availableEvents as event}
   275→							<Button
   276→								size="sm"
   277→								variant="outline"
   278→								class="text-xs gap-1"
   279→								onclick={() => addTrigger(event)}
   280→								data-testid="add-trigger-{event}"
   281→							>
   282→								<Plus class="h-3 w-3" />
   283→								{event}
   284→							</Button>
   285→						{/each}
   286→					</div>
   287→				{/if}
   288→			</div>
   289→
   290→			<Separator />
   291→
   292→			<!-- Capabilities (chip input) -->
   293→			<div>
   294→				<p class="text-sm font-medium mb-1">Capabilities</p>
   295→				<div class="flex flex-wrap gap-1 mb-2" data-testid="agent-edit-capabilities">
   296→					{#each capabilities as cap, i}
   297→						<Badge variant="outline" class="gap-1 pr-1">
   298→							{cap}
   299→							<button
   300→								type="button"
   301→								class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   302→								onclick={() => removeChip(capabilities, i, (v) => (capabilities = v))}
   303→								aria-label="Remove capability {cap}"
   304→							>
   305→								<X class="h-3 w-3" />
   306→							</button>
   307→						</Badge>
   308→					{/each}
   309→				</div>
   310→				<div class="flex gap-2">
   311→					<Input
   312→						bind:value={newCapability}
   313→						placeholder="Add capability..."
   314→						class="flex-1"
   315→						onkeydown={(e: KeyboardEvent) => {
   316→							if (e.key === 'Enter') {
   317→								e.preventDefault();
   318→								addChip(capabilities, newCapability, (v) => (capabilities = v), () => (newCapability = ''));
   319→							}
   320→						}}
   321→						data-testid="agent-edit-capability-input"
   322→					/>
   323→					<Button
   324→						size="sm"
   325→						variant="outline"
   326→						onclick={() => addChip(capabilities, newCapability, (v) => (capabilities = v), () => (newCapability = ''))}
   327→					>
   328→						Add
   329→					</Button>
   330→				</div>
   331→			</div>
   332→
   333→			<!-- Tools (chip input) -->
   334→			<div>
   335→				<p class="text-sm font-medium mb-1">Tools</p>
   336→				<div class="flex flex-wrap gap-1 mb-2" data-testid="agent-edit-tools">
   337→					{#each tools as tool, i}
   338→						<Badge variant="outline" class="gap-1 pr-1">
   339→							{tool}
   340→							<button
   341→								type="button"
   342→								class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   343→								onclick={() => removeChip(tools, i, (v) => (tools = v))}
   344→								aria-label="Remove tool {tool}"
   345→							>
   346→								<X class="h-3 w-3" />
   347→							</button>
   348→						</Badge>
   349→					{/each}
   350→				</div>
   351→				<div class="flex gap-2">
   352→					<Input
   353→						bind:value={newTool}
   354→						placeholder="Add tool..."
   355→						class="flex-1"
   356→						onkeydown={(e: KeyboardEvent) => {
   357→							if (e.key === 'Enter') {
   358→								e.preventDefault();
   359→								addChip(tools, newTool, (v) => (tools = v), () => (newTool = ''));
   360→							}
   361→						}}
   362→						data-testid="agent-edit-tool-input"
   363→					/>
   364→					<Button
   365→						size="sm"
   366→						variant="outline"
   367→						onclick={() => addChip(tools, newTool, (v) => (tools = v), () => (newTool = ''))}
   368→					>
   369→						Add
   370→					</Button>
   371→				</div>
   372→			</div>
   373→
   374→			<!-- Skills (chip input) -->
   375→			<div>
   376→				<p class="text-sm font-medium mb-1">Skills</p>
   377→				<div class="flex flex-wrap gap-1 mb-2" data-testid="agent-edit-skills">
   378→					{#each skills as skill, i}
   379→						<Badge variant="outline" class="gap-1 pr-1">
   380→							{skill}
   381→							<button
   382→								type="button"
   383→								class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   384→								onclick={() => removeChip(skills, i, (v) => (skills = v))}
   385→								aria-label="Remove skill {skill}"
   386→							>
   387→								<X class="h-3 w-3" />
   388→							</button>
   389→						</Badge>
   390→					{/each}
   391→				</div>
   392→				<div class="flex gap-2">
   393→					<Input
   394→						bind:value={newSkill}
   395→						placeholder="Add skill..."
   396→						class="flex-1"
   397→						onkeydown={(e: KeyboardEvent) => {
   398→							if (e.key === 'Enter') {
   399→								e.preventDefault();
   400→								addChip(skills, newSkill, (v) => (skills = v), () => (newSkill = ''));
   401→							}
   402→						}}
   403→						data-testid="agent-edit-skill-input"
   404→					/>
   405→					<Button
   406→						size="sm"
   407→						variant="outline"
   408→						onclick={() => addChip(skills, newSkill, (v) => (skills = v), () => (newSkill = ''))}
   409→					>
   410→						Add
   411→					</Button>
   412→				</div>
   413→			</div>
   414→
   415→			<Separator />
   416→
   417→			<!-- Budget -->
   418→			<div>
   419→				<p class="text-sm font-medium mb-2">Budget</p>
   420→				<div class="grid grid-cols-3 gap-3">
   421→					<div>
   422→						<label for="agent-max-tasks" class="text-xs text-muted-foreground">Max Tasks</label>
   423→						<Input
   424→							id="agent-max-tasks"
   425→							type="number"
   426→							min={1}
   427→							value={maxTasks ?? ''}
   428→							oninput={(e: Event) => {
   429→								const v = (e.target as HTMLInputElement).valueAsNumber;
   430→								maxTasks = Number.isNaN(v) ? undefined : v;
   431→							}}
   432→							placeholder="—"
   433→							data-testid="agent-edit-max-tasks"
   434→						/>
   435→					</div>
   436→					<div>
   437→						<label for="agent-max-retries" class="text-xs text-muted-foreground">Max Retries</label>
   438→						<Input
   439→							id="agent-max-retries"
   440→							type="number"
   441→							min={0}
   442→							value={maxRetries ?? ''}
   443→							oninput={(e: Event) => {
   444→								const v = (e.target as HTMLInputElement).valueAsNumber;
   445→								maxRetries = Number.isNaN(v) ? undefined : v;
   446→							}}
   447→							placeholder="—"
   448→							data-testid="agent-edit-max-retries"
   449→						/>
   450→					</div>
   451→					<div>
   452→						<label for="agent-timeout" class="text-xs text-muted-foreground">Timeout (min)</label>
   453→						<Input
   454→							id="agent-timeout"
   455→							type="number"
   456→							min={1}
   457→							value={timeoutMinutes ?? ''}
   458→							oninput={(e: Event) => {
   459→								const v = (e.target as HTMLInputElement).valueAsNumber;
   460→								timeoutMinutes = Number.isNaN(v) ? undefined : v;
   461→							}}
   462→							placeholder="—"
   463→							data-testid="agent-edit-timeout"
   464→						/>
   465→					</div>
   466→				</div>
   467→			</div>
   468→
   469→			<!-- Concurrency -->
   470→			<div>
   471→				<label for="agent-concurrency" class="text-sm font-medium">Max Concurrent</label>
   472→				<Input
   473→					id="agent-concurrency"
   474→					type="number"
   475→					min={1}
   476→					bind:value={maxConcurrent}
   477→					data-testid="agent-edit-concurrency"
   478→				/>
   479→			</div>
   480→
   481→			<!-- Auto Approve -->
   482→			<div class="flex items-center gap-3">
   483→				<input
   484→					id="agent-auto-approve"
   485→					type="checkbox"
   486→					bind:checked={autoApprove}
   487→					class="h-4 w-4 rounded border-input"
   488→					data-testid="agent-edit-auto-approve"
   489→				/>
   490→				<label for="agent-auto-approve" class="text-sm font-medium">Auto Approve</label>
   491→			</div>
   492→
   493→			<Separator />
   494→
   495→			<!-- Prompt Template -->
   496→			<div>
   497→				<label for="agent-prompt-template" class="text-sm font-medium">Prompt Template</label>
   498→				<Textarea
   499→					id="agent-prompt-template"
   500→					bind:value={promptTemplate}
   501→					placeholder="Agent prompt template..."
   502→					rows={4}
   503→					class="font-mono text-xs"
   504→					data-testid="agent-edit-prompt-template"
   505→				/>
   506→			</div>
   507→		</div>
   508→
   509→		<Dialog.Footer class="mt-4">
   510→			<Button
   511→				variant="ghost"
   512→				onclick={handleCancel}
   513→				disabled={saving}
   514→				data-testid="agent-edit-cancel"
   515→			>
   516→				Cancel
   517→			</Button>
   518→			<Button
   519→				onclick={handleSave}
   520→				disabled={saving || !name.trim()}
   521→				data-testid="agent-edit-save"
   522→			>
   523→				{saving ? 'Saving...' : 'Save'}
   524→			</Button>
   525→		</Dialog.Footer>
   526→	</Dialog.Content>
   527→</Dialog.Root>
   528→
```