```
     1→<!--
     2→  AC: @ui-agent-dispatch ac-4 — Inline edit form for agent definitions.
     3→  Schema-driven: types (AgentDefinition, AgentUpdatePayload, AgentDispatchRule) and
     4→  dispatch event values (AGENT_DISPATCH_EVENTS) from @kynetic-ai/shared, which mirrors
     5→  AgentSchema / AgentDispatchEventSchema from src/schema/meta.ts.
     6→-->
     7→<script lang="ts">
     8→	import { updateAgentDefinition } from '$lib/api';
     9→	import {
    10→		AGENT_DISPATCH_EVENTS,
    11→		type AgentDefinition,
    12→		type AgentUpdatePayload,
    13→		type AgentDispatchEvent,
    14→		type AgentDispatchRule
    15→	} from '@kynetic-ai/shared';
    16→	import { ReadOnlyModeError } from '$lib/stores/mode.svelte';
    17→	import * as Dialog from '$lib/components/ui/dialog';
    18→	import { Button } from '$lib/components/ui/button';
    19→	import { Input } from '$lib/components/ui/input';
    20→	import { Textarea } from '$lib/components/ui/textarea';
    21→	import { Badge } from '$lib/components/ui/badge';
    22→	import { Separator } from '$lib/components/ui/separator';
    23→	import X from '@lucide/svelte/icons/x';
    24→	import Plus from '@lucide/svelte/icons/plus';
    25→
    26→	let {
    27→		open = $bindable(false),
    28→		agent,
    29→		onSaved
    30→	}: {
    31→		open?: boolean;
    32→		agent: AgentDefinition;
    33→		onSaved?: (updated: AgentDefinition) => void;
    34→	} = $props();
    35→
    36→	// Form state derived from agent prop — reset when dialog opens
    37→	// Field structure mirrors AgentDefinition from @kynetic-ai/shared (schema-driven)
    38→	let name = $state('');
    39→	let description = $state('');
    40→	let adapter = $state('');
    41→	let dispatchTriggers = $state<AgentDispatchRule[]>([]);
    42→	let capabilities = $state<string[]>([]);
    43→	let tools = $state<string[]>([]);
    44→	let skills = $state<string[]>([]);
    45→	let maxTasks = $state<number | undefined>(undefined);
    46→	let maxRetries = $state<number | undefined>(undefined);
    47→	let timeoutMinutes = $state<number | undefined>(undefined);
    48→	let maxConcurrent = $state(1);
    49→	let autoApprove = $state(false);
    50→	let promptTemplate = $state('');
    51→
    52→	// UI state
    53→	let saving = $state(false);
    54→	let error = $state('');
    55→
    56→	// Chip input buffers
    57→	let newCapability = $state('');
    58→	let newTool = $state('');
    59→	let newSkill = $state('');
    60→
    61→	// Reset form state when dialog opens
    62→	$effect(() => {
    63→		if (open && agent) {
    64→			name = agent.name;
    65→			description = agent.description ?? '';
    66→			adapter = agent.adapter ?? '';
    67→			dispatchTriggers = agent.dispatch.map((d) => ({ ...d, filter: d.filter ? { ...d.filter } : undefined }));
    68→			capabilities = [...agent.capabilities];
    69→			tools = [...agent.tools];
    70→			skills = [...agent.skills];
    71→			maxTasks = agent.budget?.max_tasks;
    72→			maxRetries = agent.budget?.max_retries;
    73→			timeoutMinutes = agent.budget?.timeout_minutes;
    74→			maxConcurrent = agent.concurrency?.max_concurrent ?? 1;
    75→			autoApprove = agent.auto_approve;
    76→			promptTemplate = agent.prompt_template ?? '';
    77→			error = '';
    78→			newCapability = '';
    79→			newTool = '';
    80→			newSkill = '';
    81→		}
    82→	});
    83→
    84→	// Available dispatch events not yet selected
    85→	let availableEvents = $derived(
    86→		AGENT_DISPATCH_EVENTS.filter((e) => !dispatchTriggers.some((t) => t.on === e))
    87→	);
    88→
    89→	function addTrigger(event: AgentDispatchEvent) {
    90→		dispatchTriggers = [...dispatchTriggers, { on: event }];
    91→	}
    92→
    93→	function removeTrigger(index: number) {
    94→		dispatchTriggers = dispatchTriggers.filter((_, i) => i !== index);
    95→	}
    96→
    97→	function addChip(list: string[], value: string, setter: (v: string[]) => void, clearInput: () => void) {
    98→		const trimmed = value.trim();
    99→		if (trimmed && !list.includes(trimmed)) {
   100→			setter([...list, trimmed]);
   101→			clearInput();
   102→		}
   103→	}
   104→
   105→	function removeChip(list: string[], index: number, setter: (v: string[]) => void) {
   106→		setter(list.filter((_, i) => i !== index));
   107→	}
   108→
   109→	async function handleSave() {
   110→		saving = true;
   111→		error = '';
   112→
   113→		const payload: AgentUpdatePayload = {
   114→			name,
   115→			description: description || undefined,
   116→			adapter: adapter || undefined,
   117→			dispatch: dispatchTriggers,
   118→			capabilities,
   119→			tools,
   120→			skills,
   121→			budget: (maxTasks !== undefined || maxRetries !== undefined || timeoutMinutes !== undefined)
   122→				? { max_tasks: maxTasks, max_retries: maxRetries, timeout_minutes: timeoutMinutes }
   123→				: undefined,
   124→			concurrency: { max_concurrent: maxConcurrent },
   125→			auto_approve: autoApprove,
   126→			prompt_template: promptTemplate || undefined
   127→		};
   128→
   129→		try {
   130→			const updated = await updateAgentDefinition(agent.id, payload);
   131→			onSaved?.(updated);
   132→			open = false;
   133→		} catch (err) {
   134→			if (err instanceof ReadOnlyModeError) {
   135→				error = err.message;
   136→			} else {
   137→				error = err instanceof Error ? err.message : 'Failed to save agent';
   138→			}
   139→		} finally {
   140→			saving = false;
   141→		}
   142→	}
   143→
   144→	function handleCancel() {
   145→		open = false;
   146→	}
   147→</script>
   148→
   149→<Dialog.Root bind:open>
   150→	<Dialog.Content class="max-w-2xl max-h-[85vh] overflow-y-auto" data-testid="agent-edit-dialog">
   151→		<Dialog.Header>
   152→			<Dialog.Title data-testid="agent-edit-title">Edit Agent: {agent.id}</Dialog.Title>
   153→			<Dialog.Description>
   154→				Modify agent definition fields. Changes are persisted to kynetic.meta.yaml.
   155→			</Dialog.Description>
   156→		</Dialog.Header>
   157→
   158→		{#if error}
   159→			<div
   160→				class="bg-destructive/10 text-destructive p-3 rounded-lg text-sm"
   161→				data-testid="agent-edit-error"
   162→				role="alert"
   163→			>
   164→				{error}
   165→			</div>
   166→		{/if}
   167→
   168→		<div class="flex flex-col gap-4">
   169→			<!-- Name -->
   170→			<div>
   171→				<label for="agent-name" class="text-sm font-medium">Name</label>
   172→				<Input
   173→					id="agent-name"
   174→					bind:value={name}
   175→					placeholder="Agent name"
   176→					data-testid="agent-edit-name"
   177→				/>
   178→			</div>
   179→
   180→			<!-- Description -->
   181→			<div>
   182→				<label for="agent-description" class="text-sm font-medium">Description</label>
   183→				<Textarea
   184→					id="agent-description"
   185→					bind:value={description}
   186→					placeholder="Agent description"
   187→					rows={2}
   188→					data-testid="agent-edit-description"
   189→				/>
   190→			</div>
   191→
   192→			<!-- Adapter -->
   193→			<div>
   194→				<label for="agent-adapter" class="text-sm font-medium">Adapter</label>
   195→				<Input
   196→					id="agent-adapter"
   197→					bind:value={adapter}
   198→					placeholder="e.g. claude-code"
   199→					data-testid="agent-edit-adapter"
   200→				/>
   201→			</div>
   202→
   203→			<Separator />
   204→
   205→			<!-- Dispatch Triggers (schema-driven from AGENT_DISPATCH_EVENTS) -->
   206→			<div>
   207→				<p class="text-sm font-medium mb-2">Dispatch Triggers</p>
   208→				<div class="flex flex-wrap gap-1.5 mb-2" data-testid="agent-edit-triggers">
   209→					{#each dispatchTriggers as trigger, i}
   210→						<Badge variant="secondary" class="gap-1 pr-1">
   211→							{trigger.on}
   212→							<button
   213→								type="button"
   214→								class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   215→								onclick={() => removeTrigger(i)}
   216→								aria-label="Remove trigger {trigger.on}"
   217→								data-testid="remove-trigger-{trigger.on}"
   218→							>
   219→								<X class="h-3 w-3" />
   220→							</button>
   221→						</Badge>
   222→					{/each}
   223→				</div>
   224→				{#if availableEvents.length > 0}
   225→					<div class="flex flex-wrap gap-1.5" data-testid="agent-edit-available-triggers">
   226→						{#each availableEvents as event}
   227→							<Button
   228→								size="sm"
   229→								variant="outline"
   230→								class="text-xs gap-1"
   231→								onclick={() => addTrigger(event)}
   232→								data-testid="add-trigger-{event}"
   233→							>
   234→								<Plus class="h-3 w-3" />
   235→								{event}
   236→							</Button>
   237→						{/each}
   238→					</div>
   239→				{/if}
   240→			</div>
   241→
   242→			<Separator />
   243→
   244→			<!-- Capabilities (chip input) -->
   245→			<div>
   246→				<p class="text-sm font-medium mb-1">Capabilities</p>
   247→				<div class="flex flex-wrap gap-1 mb-2" data-testid="agent-edit-capabilities">
   248→					{#each capabilities as cap, i}
   249→						<Badge variant="outline" class="gap-1 pr-1">
   250→							{cap}
   251→							<button
   252→								type="button"
   253→								class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   254→								onclick={() => removeChip(capabilities, i, (v) => (capabilities = v))}
   255→								aria-label="Remove capability {cap}"
   256→							>
   257→								<X class="h-3 w-3" />
   258→							</button>
   259→						</Badge>
   260→					{/each}
   261→				</div>
   262→				<div class="flex gap-2">
   263→					<Input
   264→						bind:value={newCapability}
   265→						placeholder="Add capability..."
   266→						class="flex-1"
   267→						onkeydown={(e: KeyboardEvent) => {
   268→							if (e.key === 'Enter') {
   269→								e.preventDefault();
   270→								addChip(capabilities, newCapability, (v) => (capabilities = v), () => (newCapability = ''));
   271→							}
   272→						}}
   273→						data-testid="agent-edit-capability-input"
   274→					/>
   275→					<Button
   276→						size="sm"
   277→						variant="outline"
   278→						onclick={() => addChip(capabilities, newCapability, (v) => (capabilities = v), () => (newCapability = ''))}
   279→					>
   280→						Add
   281→					</Button>
   282→				</div>
   283→			</div>
   284→
   285→			<!-- Tools (chip input) -->
   286→			<div>
   287→				<p class="text-sm font-medium mb-1">Tools</p>
   288→				<div class="flex flex-wrap gap-1 mb-2" data-testid="agent-edit-tools">
   289→					{#each tools as tool, i}
   290→						<Badge variant="outline" class="gap-1 pr-1">
   291→							{tool}
   292→							<button
   293→								type="button"
   294→								class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   295→								onclick={() => removeChip(tools, i, (v) => (tools = v))}
   296→								aria-label="Remove tool {tool}"
   297→							>
   298→								<X class="h-3 w-3" />
   299→							</button>
   300→						</Badge>
   301→					{/each}
   302→				</div>
   303→				<div class="flex gap-2">
   304→					<Input
   305→						bind:value={newTool}
   306→						placeholder="Add tool..."
   307→						class="flex-1"
   308→						onkeydown={(e: KeyboardEvent) => {
   309→							if (e.key === 'Enter') {
   310→								e.preventDefault();
   311→								addChip(tools, newTool, (v) => (tools = v), () => (newTool = ''));
   312→							}
   313→						}}
   314→						data-testid="agent-edit-tool-input"
   315→					/>
   316→					<Button
   317→						size="sm"
   318→						variant="outline"
   319→						onclick={() => addChip(tools, newTool, (v) => (tools = v), () => (newTool = ''))}
   320→					>
   321→						Add
   322→					</Button>
   323→				</div>
   324→			</div>
   325→
   326→			<!-- Skills (chip input) -->
   327→			<div>
   328→				<p class="text-sm font-medium mb-1">Skills</p>
   329→				<div class="flex flex-wrap gap-1 mb-2" data-testid="agent-edit-skills">
   330→					{#each skills as skill, i}
   331→						<Badge variant="outline" class="gap-1 pr-1">
   332→							{skill}
   333→							<button
   334→								type="button"
   335→								class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   336→								onclick={() => removeChip(skills, i, (v) => (skills = v))}
   337→								aria-label="Remove skill {skill}"
   338→							>
   339→								<X class="h-3 w-3" />
   340→							</button>
   341→						</Badge>
   342→					{/each}
   343→				</div>
   344→				<div class="flex gap-2">
   345→					<Input
   346→						bind:value={newSkill}
   347→						placeholder="Add skill..."
   348→						class="flex-1"
   349→						onkeydown={(e: KeyboardEvent) => {
   350→							if (e.key === 'Enter') {
   351→								e.preventDefault();
   352→								addChip(skills, newSkill, (v) => (skills = v), () => (newSkill = ''));
   353→							}
   354→						}}
   355→						data-testid="agent-edit-skill-input"
   356→					/>
   357→					<Button
   358→						size="sm"
   359→						variant="outline"
   360→						onclick={() => addChip(skills, newSkill, (v) => (skills = v), () => (newSkill = ''))}
   361→					>
   362→						Add
   363→					</Button>
   364→				</div>
   365→			</div>
   366→
   367→			<Separator />
   368→
   369→			<!-- Budget -->
   370→			<div>
   371→				<p class="text-sm font-medium mb-2">Budget</p>
   372→				<div class="grid grid-cols-3 gap-3">
   373→					<div>
   374→						<label for="agent-max-tasks" class="text-xs text-muted-foreground">Max Tasks</label>
   375→						<Input
   376→							id="agent-max-tasks"
   377→							type="number"
   378→							min={1}
   379→							value={maxTasks ?? ''}
   380→							oninput={(e: Event) => {
   381→								const v = (e.target as HTMLInputElement).valueAsNumber;
   382→								maxTasks = Number.isNaN(v) ? undefined : v;
   383→							}}
   384→							placeholder="—"
   385→							data-testid="agent-edit-max-tasks"
   386→						/>
   387→					</div>
   388→					<div>
   389→						<label for="agent-max-retries" class="text-xs text-muted-foreground">Max Retries</label>
   390→						<Input
   391→							id="agent-max-retries"
   392→							type="number"
   393→							min={0}
   394→							value={maxRetries ?? ''}
   395→							oninput={(e: Event) => {
   396→								const v = (e.target as HTMLInputElement).valueAsNumber;
   397→								maxRetries = Number.isNaN(v) ? undefined : v;
   398→							}}
   399→							placeholder="—"
   400→							data-testid="agent-edit-max-retries"
   401→						/>
   402→					</div>
   403→					<div>
   404→						<label for="agent-timeout" class="text-xs text-muted-foreground">Timeout (min)</label>
   405→						<Input
   406→							id="agent-timeout"
   407→							type="number"
   408→							min={1}
   409→							value={timeoutMinutes ?? ''}
   410→							oninput={(e: Event) => {
   411→								const v = (e.target as HTMLInputElement).valueAsNumber;
   412→								timeoutMinutes = Number.isNaN(v) ? undefined : v;
   413→							}}
   414→							placeholder="—"
   415→							data-testid="agent-edit-timeout"
   416→						/>
   417→					</div>
   418→				</div>
   419→			</div>
   420→
   421→			<!-- Concurrency -->
   422→			<div>
   423→				<label for="agent-concurrency" class="text-sm font-medium">Max Concurrent</label>
   424→				<Input
   425→					id="agent-concurrency"
   426→					type="number"
   427→					min={1}
   428→					bind:value={maxConcurrent}
   429→					data-testid="agent-edit-concurrency"
   430→				/>
   431→			</div>
   432→
   433→			<!-- Auto Approve -->
   434→			<div class="flex items-center gap-3">
   435→				<input
   436→					id="agent-auto-approve"
   437→					type="checkbox"
   438→					bind:checked={autoApprove}
   439→					class="h-4 w-4 rounded border-input"
   440→					data-testid="agent-edit-auto-approve"
   441→				/>
   442→				<label for="agent-auto-approve" class="text-sm font-medium">Auto Approve</label>
   443→			</div>
   444→
   445→			<Separator />
   446→
   447→			<!-- Prompt Template -->
   448→			<div>
   449→				<label for="agent-prompt-template" class="text-sm font-medium">Prompt Template</label>
   450→				<Textarea
   451→					id="agent-prompt-template"
   452→					bind:value={promptTemplate}
   453→					placeholder="Agent prompt template..."
   454→					rows={4}
   455→					class="font-mono text-xs"
   456→					data-testid="agent-edit-prompt-template"
   457→				/>
   458→			</div>
   459→		</div>
   460→
   461→		<Dialog.Footer class="mt-4">
   462→			<Button
   463→				variant="ghost"
   464→				onclick={handleCancel}
   465→				disabled={saving}
   466→				data-testid="agent-edit-cancel"
   467→			>
   468→				Cancel
   469→			</Button>
   470→			<Button
   471→				onclick={handleSave}
   472→				disabled={saving || !name.trim()}
   473→				data-testid="agent-edit-save"
   474→			>
   475→				{saving ? 'Saving...' : 'Save'}
   476→			</Button>
   477→		</Dialog.Footer>
   478→	</Dialog.Content>
   479→</Dialog.Root>
   480→
```