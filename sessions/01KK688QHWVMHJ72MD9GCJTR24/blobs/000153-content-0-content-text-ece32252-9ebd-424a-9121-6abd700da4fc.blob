   757→	status?: string;
   758→}): Promise<{ items: PlanSummary[]; total: number }> {
   759→	if (isStaticMode()) {
   760→		return fetchPlansStatic(params);
   761→	}
   762→
   763→	const url = new URL(`${API_BASE}/api/plans`);
   764→
   765→	if (params) {
   766→		Object.entries(params).forEach(([key, value]) => {
   767→			if (value !== undefined && value !== '') {
   768→				url.searchParams.set(key, String(value));
   769→			}
   770→		});
   771→	}
   772→
   773→	const response = await fetch(url.toString(), {
   774→		headers: getProjectHeaders()
   775→	});
   776→	if (!response.ok) {
   777→		await handleResponseError(response);
   778→	}
   779→
   780→	return response.json();
   781→}
