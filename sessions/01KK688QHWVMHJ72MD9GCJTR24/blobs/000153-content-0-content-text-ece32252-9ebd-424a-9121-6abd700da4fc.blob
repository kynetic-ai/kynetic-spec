   961→// AC: @ui-validation-view ac-1
   962→// ============================================================
   963→
   964→export interface SchemaValidationError {
   965→	file: string;
   966→	path?: string;
   967→	message: string;
   968→	details?: unknown;
   969→}
   970→
   971→export interface RefValidationError {
   972→	ref: string;
   973→	sourceFile?: string;
   974→	sourceUlid?: string;
   975→	field: string;
   976→	error: 'not_found' | 'ambiguous' | 'duplicate_slug';
   977→	message: string;
   978→}
   979→
   980→export interface RefValidationWarning {
   981→	ref: string;
   982→	sourceFile?: string;
   983→	sourceUlid?: string;
   984→	field: string;
   985→	warning: 'deprecated_target';
   986→	message: string;
   987→}
   988→
   989→export interface OrphanItem {
   990→	ulid: string;
   991→	title: string;
   992→	type: string;
   993→	file?: string;
   994→}
   995→
   996→export type CompletenessWarningType =
   997→	| 'missing_acceptance_criteria'
   998→	| 'missing_description'
   999→	| 'status_inconsistency'
  1000→	| 'missing_test_coverage'
  1001→	| 'automation_eligible_no_spec'
  1002→	| 'ac_schema_field_mismatch';
  1003→
  1004→export interface CompletenessWarning {
  1005→	type: CompletenessWarningType;
  1006→	subtype?: 'own_ac' | 'trait_ac';
  1007→	itemRef: string;
  1008→	itemTitle: string;
  1009→	message: string;
  1010→	details?: string;
  1011→}
  1012→
  1013→export interface TraitCycleError {
  1014→	traitRef: string;
  1015→	traitTitle: string;
  1016→	cycle: string[];
  1017→	message: string;
  1018→}
  1019→
  1020→export interface ValidationResponse {
  1021→	valid: boolean;
  1022→	schemaErrors: SchemaValidationError[];
  1023→	refErrors: RefValidationError[];
  1024→	refWarnings: RefValidationWarning[];
  1025→	orphans: OrphanItem[];
  1026→	completenessWarnings: CompletenessWarning[];
  1027→	traitCycles: TraitCycleError[];
  1028→}
  1029→
  1030→/** Alias for backward compatibility with dashboard overview */
  1031→export type ValidationResult = ValidationResponse;
  1032→
  1033→export interface AlignmentWarning {
  1034→	type: 'orphaned_spec' | 'status_mismatch' | 'stale_implementation';
  1035→	specUlid?: string;
  1036→	specTitle?: string;
  1037→	taskUlid?: string;
  1038→	message: string;
  1039→}
  1040→
  1041→export interface AlignmentStats {
  1042→	totalSpecs: number;
  1043→	specsWithTasks: number;
  1044→	alignedSpecs: number;
  1045→	orphanedSpecs: number;
  1046→}
  1047→
  1048→export interface AlignmentResponse {
  1049→	stats: AlignmentStats;
  1050→	warnings: AlignmentWarning[];
  1051→}
  1052→
  1053→/**
  1054→ * Fetch validation results
  1055→ * AC: @ui-validation-view ac-1
  1056→ */
  1057→export async function fetchValidation(): Promise<ValidationResponse> {
  1058→	if (isStaticMode()) {
  1059→		return {
  1060→			valid: true,
  1061→			schemaErrors: [],
  1062→			refErrors: [],
  1063→			refWarnings: [],
  1064→			orphans: [],
  1065→			completenessWarnings: [],
  1066→			traitCycles: []
  1067→		};
  1068→	}
  1069→
  1070→	const response = await fetch(`${API_BASE}/api/validate`, {
  1071→		headers: getProjectHeaders()
  1072→	});
  1073→	if (!response.ok) {
  1074→		await handleResponseError(response);
  1075→	}
  1076→
  1077→	const data = await response.json();
  1078→	// Normalize: ensure all array fields exist even if the API omits them
  1079→	return {
  1080→		valid: data.valid ?? true,
  1081→		schemaErrors: data.schemaErrors ?? [],
  1082→		refErrors: data.refErrors ?? [],
  1083→		refWarnings: data.refWarnings ?? [],
  1084→		orphans: data.orphans ?? [],
  1085→		completenessWarnings: data.completenessWarnings ?? [],
  1086→		traitCycles: data.traitCycles ?? []
  1087→	};
  1088→}
  1089→
  1090→/**
  1091→ * Fetch alignment stats and warnings
  1092→ * AC: @ui-validation-view ac-1
  1093→ */
  1094→export async function fetchAlignment(): Promise<AlignmentResponse> {
  1095→	if (isStaticMode()) {
  1096→		return {
  1097→			stats: { totalSpecs: 0, specsWithTasks: 0, alignedSpecs: 0, orphanedSpecs: 0 },
  1098→			warnings: []
  1099→		};
  1100→	}
  1101→
  1102→	const response = await fetch(`${API_BASE}/api/alignment`, {
  1103→		headers: getProjectHeaders()
  1104→	});
  1105→	if (!response.ok) {
  1106→		await handleResponseError(response);
  1107→	}
  1108→
  1109→	return response.json();
  1110→}
