   264→/**
   265→ * Fetch spec items with optional filters
   266→ * AC: @web-dashboard ac-11
   267→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   268→ * AC: @gh-pages-export ac-11 - Static mode support
   269→ */
   270→export async function fetchItems(params?: {
   271→	type?: string | string[];
   272→	tag?: string;
   273→	plan?: string;
   274→	limit?: number;
   275→	offset?: number;
   276→}): Promise<PaginatedResponse<ItemSummary>> {
   277→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   278→	if (isStaticMode()) {
   279→		return fetchItemsStatic(params);
   280→	}
   281→
   282→	const url = new URL(`${API_BASE}/api/items`);
   283→
   284→	if (params) {
   285→		Object.entries(params).forEach(([key, value]) => {
   286→			if (value !== undefined && value !== '') {
   287→				if (Array.isArray(value)) {
   288→					value.forEach((v) => url.searchParams.append(key, String(v)));
   289→				} else {
   290→					url.searchParams.set(key, String(value));
   291→				}
   292→			}
   293→		});
   294→	}
   295→
   296→	const response = await fetch(url.toString(), {
   297→		headers: getProjectHeaders()
   298→	});
   299→	if (!response.ok) {
   300→		await handleResponseError(response);
   301→	}
   302→
   303→	return response.json();
   304→}
