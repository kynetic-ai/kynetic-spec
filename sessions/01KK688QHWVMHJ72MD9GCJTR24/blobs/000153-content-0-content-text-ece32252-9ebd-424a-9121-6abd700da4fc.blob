```
     1→/**
     2→ * API Client
     3→ *
     4→ * Helper functions for making requests to the kspec daemon API.
     5→ * Supports both daemon mode (live) and static mode (read-only JSON).
     6→ *
     7→ * AC Coverage:
     8→ * - ac-26 (@multi-directory-daemon): X-Kspec-Dir header injection
     9→ * - ac-36 (@multi-directory-daemon): Invalid project error detection
    10→ * - ac-11 (@gh-pages-export): Mode-aware API dispatch
    11→ * - ac-18 (@gh-pages-export): Graceful no-op for write operations
    12→ */
    13→
    14→import type {
    15→	TaskSummary,
    16→	TaskDetail,
    17→	ItemSummary,
    18→	ItemDetail,
    19→	InboxItem,
    20→	SessionContext,
    21→	Observation,
    22→	Workflow,
    23→	Convention,
    24→	PaginatedResponse,
    25→	PlanSummary,
    26→	PlanDetail,
    27→	ErrorResponse,
    28→	SearchResponse,
    29→	AgentDefinition,
    30→	AgentUpdatePayload
    31→} from '@kynetic-ai/shared';
    32→import type { TriageRecord } from './types/triage';
    33→import {
    34→	getSelectedProjectPath,
    35→	clearInvalidSelection,
    36→	isInvalidProjectError,
    37→	type Project
    38→} from './stores/project.svelte';
    39→import { isStaticMode, assertWritable } from './stores/mode.svelte';
    40→import {
    41→	fetchTasksStatic,
    42→	fetchTaskStatic,
    43→	fetchItemsStatic,
    44→	fetchItemStatic,
    45→	fetchItemTasksStatic,
    46→	fetchInboxStatic,
    47→	fetchSessionContextStatic,
    48→	fetchObservationsStatic,
    49→	searchStatic,
    50→	fetchTriageRecordsStatic,
    51→	fetchPlansStatic,
    52→	fetchWorkflowsStatic
    53→} from './api-static';
    54→import { DAEMON_API_BASE } from './constants';
    55→
    56→const API_BASE = DAEMON_API_BASE;
    57→
    58→/**
    59→ * Get headers for API requests, including X-Kspec-Dir if project is selected
    60→ * AC: @multi-directory-daemon ac-26
    61→ */
    62→function getProjectHeaders(): HeadersInit {
    63→	const path = getSelectedProjectPath();
    64→	return path ? { 'X-Kspec-Dir': path } : {};
    65→}
    66→
    67→/**
    68→ * Handle response errors, detecting invalid project errors
    69→ * AC: @multi-directory-daemon ac-36
    70→ */
    71→async function handleResponseError(response: Response): Promise<never> {
    72→	const error: ErrorResponse = await response.json();
    73→	const message = error.message || error.error;
    74→
    75→	// Check if this is an invalid project error
    76→	if (isInvalidProjectError(response, message)) {
    77→		clearInvalidSelection();
    78→	}
    79→
    80→	throw new Error(message);
    81→}
    82→
    83→/**
    84→ * Fetch registered projects
    85→ * AC: @multi-directory-daemon ac-25, ac-28
    86→ */
    87→export async function fetchProjects(): Promise<{ projects: Project[] }> {
    88→	const response = await fetch(`${API_BASE}/api/projects`);
    89→	if (!response.ok) {
    90→		await handleResponseError(response);
    91→	}
    92→	return response.json();
    93→}
    94→
    95→/**
    96→ * Fetch tasks with optional filters
    97→ * AC: @web-dashboard ac-9, ac-10
    98→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
    99→ * AC: @gh-pages-export ac-11 - Static mode support
   100→ */
   101→export async function fetchTasks(params?: {
   102→	status?: string;
   103→	tag?: string;
   104→	assignee?: string;
   105→	automation?: string;
   106→	plan?: string;
   107→	limit?: number;
   108→	offset?: number;
   109→}): Promise<PaginatedResponse<TaskSummary>> {
   110→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   111→	if (isStaticMode()) {
   112→		return fetchTasksStatic(params);
   113→	}
   114→
   115→	const url = new URL(`${API_BASE}/api/tasks`);
   116→
   117→	if (params) {
   118→		Object.entries(params).forEach(([key, value]) => {
   119→			if (value !== undefined && value !== '') {
   120→				url.searchParams.set(key, String(value));
   121→			}
   122→		});
   123→	}
   124→
   125→	const response = await fetch(url.toString(), {
   126→		headers: getProjectHeaders()
   127→	});
   128→	if (!response.ok) {
   129→		await handleResponseError(response);
   130→	}
   131→
   132→	return response.json();
   133→}
   134→
   135→/**
   136→ * Fetch single task by reference
   137→ * AC: @web-dashboard ac-5
   138→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   139→ * AC: @gh-pages-export ac-12 - Static mode deep linking
   140→ */
   141→export async function fetchTask(ref: string): Promise<TaskDetail> {
   142→	// AC: @gh-pages-export ac-12 - Use static data in static mode
   143→	if (isStaticMode()) {
   144→		const task = fetchTaskStatic(ref);
   145→		if (!task) {
   146→			throw new Error(`Task not found: ${ref}`);
   147→		}
   148→		return task;
   149→	}
   150→
   151→	const response = await fetch(`${API_BASE}/api/tasks/${ref}`, {
   152→		headers: getProjectHeaders()
   153→	});
   154→	if (!response.ok) {
   155→		await handleResponseError(response);
   156→	}
   157→
   158→	return response.json();
   159→}
   160→
   161→/**
   162→ * Start a task (change status to in_progress)
   163→ * AC: @web-dashboard ac-7
   164→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   165→ * AC: @gh-pages-export ac-16, ac-18 - Disabled in static mode
   166→ */
   167→export async function startTask(ref: string): Promise<void> {
   168→	// AC: @gh-pages-export ac-16, ac-18 - Write operations throw in static mode
   169→	assertWritable('start task');
   170→
   171→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/start`, {
   172→		method: 'POST',
   173→		headers: getProjectHeaders()
   174→	});
   175→	if (!response.ok) {
   176→		await handleResponseError(response);
   177→	}
   178→}
   179→
   180→/**
   181→ * Add a note to a task
   182→ * AC: @web-dashboard ac-8
   183→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   184→ * AC: @gh-pages-export ac-18 - Disabled in static mode
   185→ */
   186→export async function addTaskNote(ref: string, content: string): Promise<void> {
   187→	// AC: @gh-pages-export ac-18 - Write operations throw in static mode
   188→	assertWritable('add note');
   189→
   190→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/note`, {
   191→		method: 'POST',
   192→		headers: {
   193→			'Content-Type': 'application/json',
   194→			...getProjectHeaders()
   195→		},
   196→		body: JSON.stringify({ content })
   197→	});
   198→	if (!response.ok) {
   199→		await handleResponseError(response);
   200→	}
   201→}
