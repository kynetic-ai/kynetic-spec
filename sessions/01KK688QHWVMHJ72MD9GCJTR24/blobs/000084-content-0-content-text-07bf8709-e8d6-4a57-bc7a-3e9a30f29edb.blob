```
     1→/**
     2→ * Agent Dispatch Engine
     3→ *
     4→ * Core dispatch runtime for the daemon. Watches for task state changes via
     5→ * file watcher events and direct API event emission from CLI commands. Matches
     6→ * state changes against agent dispatch rules, queues invocations, manages
     7→ * concurrency, and handles deduplication of events from dual sources.
     8→ * Serializes shadow branch mutations when multiple agents run concurrently.
     9→ *
    10→ * AC: @agent-dispatch-engine ac-1 through ac-12
    11→ */
    12→
    13→import * as path from "node:path";
    14→import { spawnSync } from "node:child_process";
    15→import { ulid } from "ulid";
    16→import {
    17→  initContext,
    18→  loadAllTasks,
    19→  loadMetaContext,
    20→  type LoadedTask,
    21→  type LoadedAgent,
    22→} from "../parser/index.js";
    23→import { runInvocation } from "./invocation.js";
    24→import type { InvocationOptions } from "./invocation.js";
    25→import { getAdapter } from "../agents/adapters.js";
    26→import type { AgentDispatchRule } from "../schema/meta.js";
    27→import type { SessionTrigger } from "../sessions/types.js";
    28→
    29→// ─── Simple Mutex ─────────────────────────────────────────────────────────────
    30→
    31→/**
    32→ * A minimal promise-based mutex for serializing async operations.
    33→ * AC: @agent-dispatch-engine ac-12
    34→ */
    35→class Mutex {
    36→  private _queue: Array<() => void> = [];
    37→  private _locked = false;
    38→
    39→  async runExclusive<T>(fn: () => Promise<T>): Promise<T> {
    40→    await this._acquire();
    41→    try {
    42→      return await fn();
    43→    } finally {
    44→      this._release();
    45→    }
    46→  }
    47→
    48→  private _acquire(): Promise<void> {
    49→    if (!this._locked) {
    50→      this._locked = true;
    51→      return Promise.resolve();
    52→    }
    53→    return new Promise<void>((resolve) => {
    54→      this._queue.push(resolve);
    55→    });
    56→  }
    57→
    58→  private _release(): void {
    59→    const next = this._queue.shift();
    60→    if (next) {
    61→      next();
    62→    } else {
    63→      this._locked = false;
    64→    }
    65→  }
    66→}
    67→
    68→// ─── Types ────────────────────────────────────────────────────────────────────
    69→
    70→/**
    71→ * Task state as used for dispatch tracking.
    72→ */
    73→export type TaskStatus =
    74→  | "pending"
    75→  | "in_progress"
    76→  | "pending_review"
    77→  | "needs_work"
    78→  | "blocked"
    79→  | "completed"
    80→  | "cancelled";
    81→
    82→/**
    83→ * Mapping from dispatch event names to task statuses.
    84→ * AC: @agent-dispatch-engine ac-1
    85→ */
    86→const EVENT_TO_STATUS: Record<string, TaskStatus> = {
    87→  "task.in_progress": "in_progress",
    88→  "task.ready": "pending",
    89→  "task.needs_work": "needs_work",
    90→  "task.pending_review": "pending_review",
    91→};
    92→
    93→const STATUS_TO_EVENT: Record<TaskStatus, string | undefined> = {
    94→  in_progress: "task.in_progress",
    95→  pending: "task.ready",
    96→  needs_work: "task.needs_work",
    97→  pending_review: "task.pending_review",
    98→  blocked: undefined,
    99→  completed: undefined,
   100→  cancelled: undefined,
   101→};
   102→
   103→/**
   104→ * Dispatch precedence for runnable task statuses.
   105→ * Lower number = higher scheduling priority.
   106→ *
   107→ * AC: @dispatch-in-progress-priority ac-1
   108→ */
   109→const STATUS_PRECEDENCE: Record<TaskStatus, number> = {
   110→  in_progress: 0,
   111→  needs_work: 1,
   112→  pending: 2,
   113→  pending_review: 3,
   114→  blocked: 4,
   115→  completed: 5,
   116→  cancelled: 6,
   117→};
   118→
   119→// ─── Prompt Helpers (exported for testing) ───────────────────────────────────
   120→
   121→/**
   122→ * Interpolate {{variable}} placeholders in a prompt template.
   123→ * Unresolved variables pass through unchanged.
   124→ *
   125→ * AC: @agent-dispatch-engine ac-16
   126→ */
   127→export function interpolateTemplate(
   128→  template: string,
   129→  vars: Record<string, string>,
   130→): string {
   131→  return template.replace(
   132→    /\{\{(\w+)\}\}/g,
   133→    (match, key: string) => vars[key] ?? match,
   134→  );
   135→}
   136→
   137→/**
   138→ * Human-readable trigger description for orientation context.
   139→ */
   140→function triggerDescription(trigger: string): string {
   141→  switch (trigger) {
   142→    case "task.ready":
   143→      return "New task assignment.";
   144→    case "task.in_progress":
   145→      return "Continuing in-progress work.";
   146→    case "task.needs_work":
   147→      return "Fix cycle \u2014 this task was kicked back from review. Address the feedback below.";
   148→    case "task.pending_review":
   149→      return "Task submitted for review.";
   150→    default:
   151→      return `Trigger: ${trigger}`;
   152→  }
   153→}
   154→
   155→/**
   156→ * Format recent notes for inclusion in dispatch prompts.
   157→ * Takes last N notes, truncates each to maxLen characters, strips newlines.
   158→ */
   159→function formatRecentNotes(
   160→  notes: Array<{ created_at: string; author?: string; content: string }>,
   161→  count = 3,
   162→  maxLen = 200,
   163→): string {
   164→  if (!notes || notes.length === 0) return "";
   165→  const recent = notes.slice(-count);
   166→  const lines = recent.map((n) => {
   167→    const date = n.created_at.slice(0, 10);
   168→    const author = n.author ? `@${n.author}` : "unknown";
   169→    const content = n.content.replace(/\n/g, " ").slice(0, maxLen);
   170→    return `- [${date}] ${author}: ${content}`;
   171→  });
   172→  return lines.join("\n");
   173→}
   174→
   175→/**
   176→ * Build orientation context block for a dispatch prompt.
   177→ * Provides the agent with task title, trigger meaning, and relevant context.
   178→ *
   179→ * AC: @agent-dispatch-engine ac-13, ac-14, ac-15
   180→ */
   181→export function buildOrientationContext(
   182→  taskRef: string,
   183→  trigger: string,
   184→  task?: {
   185→    title: string;
   186→    notes?: Array<{ created_at: string; author?: string; content: string }>;
   187→    review_url?: string;
   188→  },
   189→): string {
   190→  const title = task?.title ?? "(unavailable)";
   191→  const lines = [
   192→    "## Task Context",
   193→    `Task: ${taskRef} \u2014 "${title}"`,
   194→    `Trigger: ${triggerDescription(trigger)}`,
   195→  ];
   196→
   197→  // AC: @agent-dispatch-engine ac-14 - Include recent notes for fix cycles
   198→  if (trigger === "task.needs_work" && task?.notes && task.notes.length > 0) {
   199→    const noteText = formatRecentNotes(task.notes);
   200→    if (noteText) {
   201→      lines.push("", "Recent notes:", noteText);
   202→    }
   203→  }
   204→
   205→  // AC: @agent-dispatch-engine ac-15 - Include review URL for reviewer
   206→  if (trigger === "task.pending_review") {
   207→    const url = task?.review_url ?? "Not provided \u2014 find PR via task notes or git log.";
   208→    lines.push(`Review URL: ${url}`);
   209→  }
   210→
   211→  return lines.join("\n");
   212→}
   213→
   214→// ─── Types ───────────────────────────────────────────────────────────────────
   215→
   216→/**
   217→ * A state change event for a single task.
   218→ */
   219→export interface TaskStateChange {
   220→  taskId: string;
   221→  taskRef: string;
   222→  fromStatus: TaskStatus;
   223→  toStatus: TaskStatus;
   224→  timestamp: number;
   225→  /** Optional task data used for filter evaluation (AC-6) */
   226→  task?: LoadedTask;
   227→}
   228→
   229→/**
   230→ * An entry in the dispatch queue.
   231→ */
   232→interface QueueEntry {
   233→  agent: LoadedAgent;
   234→  change: TaskStateChange;
   235→  retryCount: number;
   236→  nextRetryAt: number;
   237→  /** When this entry was first enqueued (for wait-time display) */
   238→  enqueuedAtMs: number;
   239→  /** Monotonic sequence for deterministic tie-breaking */
   240→  sequence: number;
   241→}
   242→
   243→/**
   244→ * Tracking record for an active invocation.
   245→ * AC: @cli-agent-commands ac-6
   246→ */
   247→interface ActiveInvocationRecord {
   248→  invocationId: string;
   249→  sessionId: string;
   250→  agentId: string;
   251→  agentName: string;
   252→  taskRef: string | undefined;
   253→  startedAtMs: number;
   254→}
   255→
   256→/**
   257→ * Deduplication key for recent state changes.
   258→ * AC: @agent-dispatch-engine ac-7
   259→ */
   260→type DedupKey = `${string}:${string}:${string}`;
   261→
   262→/**
   263→ * Invocation lifecycle event payload.
   264→ * AC: @daemon-agent-dispatch ac-3, ac-4
   265→ */
   266→export interface InvocationEvent {
   267→  type: "started" | "completed" | "failed";
   268→  session_id: string;
   269→  agent_id: string;
   270→  task_id: string | undefined;
   271→  status: "started" | "completed" | "failed";
   272→  timestamp: number;
   273→}
   274→
   275→/**
   276→ * Options for creating a DispatchEngine.
   277→ */
   278→export interface DispatchEngineOptions {
   279→  /** Project root directory */
   280→  projectDir: string;
   281→  /**
   282→   * Spec directory (.kspec/ for shadow mode, or same as projectDir for traditional mode).
   283→   * Defaults to projectDir/.kspec if not specified.
   284→   */
   285→  specDir?: string;
   286→  /** Working directory for spawned agents */
   287→  cwd?: string;
   288→  /** Deduplication window in milliseconds (default 2000) */
   289→  dedupWindowMs?: number;
   290→  /**
   291→   * Periodic reconciliation interval in milliseconds (default 60000).
   292→   * Re-evaluates all task states against dispatch rules, enqueuing any that
   293→   * match but have no active or queued invocation. Set to 0 or null to disable.
   294→   * AC: @agent-dispatch-engine ac-20
   295→   */
   296→  reconcileIntervalMs?: number | null;
   297→  /** Path to kspec CLI binary (for task notes) */
   298→  kspecCliPath?: string;
   299→  /**
   300→   * Optional callback invoked on invocation lifecycle events (start, complete, fail).
   301→   * AC: @daemon-agent-dispatch ac-3, ac-4
   302→   */
   303→  onInvocationEvent?: (event: InvocationEvent) => void;
   304→  /**
   305→   * Optional callback invoked for each text chunk produced by a running agent.
   306→   * AC: @cli-agent-commands ac-13 (broadcast to watch subscribers)
   307→   * AC: @daemon-agent-dispatch ac-8
   308→   */
   309→  onTextChunk?: (sessionId: string, agentId: string, taskId: string | null, text: string) => void;
   310→}
   311→
   312→// ─── DispatchEngine ───────────────────────────────────────────────────────────
   313→
   314→/**
   315→ * The core dispatch runtime.
   316→ *
   317→ * Lifecycle:
   318→ *   1. Create with new DispatchEngine(options)
   319→ *   2. Call start() to bootstrap and begin processing
   320→ *   3. Feed state changes via handleStateChange()
   321→ *   4. Call stop() for graceful shutdown
   322→ *
   323→ * AC: @agent-dispatch-engine ac-1 through ac-12
   324→ */
   325→export class DispatchEngine {
   326→  private projectDir: string;
   327→  private specDir: string;
   328→  private cwd: string;
   329→  private dedupWindowMs: number;
   330→  private reconcileIntervalMs: number;
   331→  private kspecCliPath?: string;
   332→  private onInvocationEvent?: (event: InvocationEvent) => void;
   333→  private onTextChunk?: (sessionId: string, agentId: string, taskId: string | null, text: string) => void;
   334→
   335→  /** Queue of pending dispatch entries, per agent id */
   336→  private queues: Map<string, QueueEntry[]> = new Map();
   337→  /** Count of active (running) invocations per agent id */
   338→  private activeCount: Map<string, number> = new Map();
   339→  /** Recent dedup keys with their expiry timestamps */
   340→  private recentEvents: Map<DedupKey, number> = new Map();
   341→  /** Previous task states (for file watcher diffing) */
   342→  private prevTaskStates: Map<string, TaskStatus> = new Map();
   343→  /** Mutex serializing shadow branch mutations */
   344→  private shadowMutex = new Mutex();
   345→  /** Whether the engine is currently running */
   346→  private running = false;
   347→  /** Set of running invocation promises (for graceful shutdown) */
   348→  private runningInvocations: Set<Promise<void>> = new Set();
   349→  /** AbortControllers for active invocations (for graceful cancel on stop) */
   350→  private invocationAbortControllers: Set<AbortController> = new Set();
   351→  /** Per-invocation tracking records for status display */
   352→  private activeInvocationDetails: Map<string, ActiveInvocationRecord> = new Map();
   353→  /** Monotonic enqueue sequence for deterministic queue ordering */
   354→  private nextQueueSequence = 0;
   355→  /** Timer handle for periodic reconciliation. AC: @agent-dispatch-engine ac-20 */
   356→  private reconcileTimer: ReturnType<typeof setInterval> | null = null;
   357→
   358→  constructor(options: DispatchEngineOptions) {
   359→    this.projectDir = options.projectDir;
   360→    this.specDir = options.specDir ?? path.join(options.projectDir, ".kspec");
   361→    this.cwd = options.cwd ?? options.projectDir;
   362→    this.dedupWindowMs = options.dedupWindowMs ?? 2000;
   363→    this.reconcileIntervalMs = (options.reconcileIntervalMs === null || options.reconcileIntervalMs === 0)
   364→      ? 0
   365→      : (options.reconcileIntervalMs ?? 60_000);
   366→    this.kspecCliPath = options.kspecCliPath;
   367→    this.onInvocationEvent = options.onInvocationEvent;
   368→    this.onTextChunk = options.onTextChunk;
   369→  }
   370→
   371→  // ─── Public API ─────────────────────────────────────────────────────────────
   372→
   373→  /**
   374→   * Start the dispatch engine.
   375→   *
   376→   * Loads current task states and evaluates dispatch rules for bootstrap.
   377→   * AC: @agent-dispatch-engine ac-8
   378→   */
   379→  async start(): Promise<void> {
   380→    this.running = true;
   381→
   382→    // AC: @agent-dispatch-engine ac-8 - Bootstrap: evaluate existing task states
   383→    await this._bootstrap();
   384→
   385→    // AC: @agent-dispatch-engine ac-19, ac-20 - Start periodic reconciliation
   386→    if (this.reconcileIntervalMs > 0) {
   387→      this.reconcileTimer = setInterval(() => {
   388→        if (this.running) {
   389→          this._reconcile().catch((err) => {
   390→            console.error("[dispatch] Reconciliation error:", err);
   391→          });
   392→        }
   393→      }, this.reconcileIntervalMs);
   394→      this.reconcileTimer.unref();
   395→    }
   396→  }
   397→
   398→  /**
   399→   * Handle a task state change event from any source (file watcher or API).
   400→   *
   401→   * AC: @agent-dispatch-engine ac-1, ac-2, ac-4, ac-5, ac-6, ac-7
   402→   */
   403→  async handleStateChange(change: TaskStateChange): Promise<void> {
   404→    if (!this.running) return;
   405→
   406→    // AC: @agent-dispatch-engine ac-7 - Deduplication
   407→    if (this._isDuplicate(change)) {
   408→      return;
   409→    }
   410→    this._recordEvent(change);
   411→
   412→    // AC: @agent-dispatch-engine ac-1 - Match against dispatch rules
   413→    const agents = await this._loadAgents();
   414→    const eventType = STATUS_TO_EVENT[change.toStatus];
   415→    if (!eventType) return;
   416→
   417→    // Load task data for filter evaluation if not provided
   418→    let taskData = change.task;
   419→    if (!taskData && change.taskId) {
   420→      try {
   421→        const ctx = await initContext(this.projectDir);
   422→        const tasks = await loadAllTasks(ctx);
   423→        taskData = tasks.find((t) => t._ulid === change.taskId);
   424→      } catch {
   425→        // Can't load task, filter evaluation will be lenient
   426→      }
   427→    }
   428→    // Make loaded task available for prompt building (AC: @agent-dispatch-engine ac-13)
   429→    if (taskData && !change.task) {
   430→      change.task = taskData;
   431→    }
   432→
   433→    for (const agent of agents) {
   434→      for (const rule of (agent.dispatch ?? [])) {
   435→        if (rule.on !== eventType) continue;
   436→
   437→        // AC: @agent-dispatch-engine ac-6 - Apply filters
   438→        if (!this._matchesFilter(change, rule, taskData)) continue;
   439→
   440→        // AC: @agent-dispatch-engine ac-2 - Each matching agent queued independently
   441→        this._enqueue(agent, change);
   442→      }
   443→    }
   444→
   445→    // Drain queues after enqueuing
   446→    await this._drainQueues(agents);
   447→  }
   448→
   449→  /**
   450→   * Handle file watcher notification: diff previous vs current task states.
   451→   *
   452→   * AC: @agent-dispatch-engine ac-5
   453→   */
   454→  async handleFileChange(specDir: string): Promise<void> {
   455→    if (!this.running) return;
   456→
   457→    try {
   458→      const ctx = await initContext(this.projectDir);
   459→      const tasks = await loadAllTasks(ctx);
   460→
   461→      const changes: TaskStateChange[] = [];
   462→      const now = Date.now();
   463→
   464→      for (const task of tasks) {
   465→        const taskId = task._ulid;
   466→        const currentStatus = task.status as TaskStatus;
   467→        const prevStatus = this.prevTaskStates.get(taskId);
   468→
   469→        if (prevStatus !== undefined && prevStatus !== currentStatus) {
   470→          changes.push({
   471→            taskId,
   472→            taskRef: `@${taskId}`,
   473→            fromStatus: prevStatus,
   474→            toStatus: currentStatus,
   475→            timestamp: now,
   476→            task,
   477→          });
   478→        }
   479→
   480→        this.prevTaskStates.set(taskId, currentStatus);
   481→      }
   482→
   483→      // Emit change events for detected transitions
   484→      for (const change of changes) {
   485→        await this.handleStateChange(change);
   486→      }
   487→    } catch (err) {
   488→      console.error("[dispatch] Error processing file change:", err);
   489→    }
   490→  }
   491→
   492→  /**
   493→   * Stop the dispatch engine gracefully.
   494→   *
   495→   * Sends cancel signals to all active invocations and waits for them to finish.
   496→   * AC: @agent-dispatch-engine ac-11
   497→   */
   498→  async stop(): Promise<void> {
   499→    this.running = false;
   500→
   501→    // AC: @agent-dispatch-engine ac-20 - Stop periodic reconciliation
   502→    if (this.reconcileTimer !== null) {
   503→      clearInterval(this.reconcileTimer);
   504→      this.reconcileTimer = null;
   505→    }
   506→
   507→    // AC: @agent-dispatch-engine ac-11 - Send graceful cancel to all active invocations
   508→    for (const controller of this.invocationAbortControllers) {
   509→      controller.abort();
   510→    }
   511→
   512→    // Wait for all running invocations to complete (or abort)
   513→    if (this.runningInvocations.size > 0) {
   514→      await Promise.allSettled(Array.from(this.runningInvocations));
   515→    }
   516→
   517→    this.queues.clear();
   518→    this.activeCount.clear();
   519→    this.recentEvents.clear();
   520→    this.invocationAbortControllers.clear();
   521→    this.activeInvocationDetails.clear();
   522→  }
   523→
   524→  /**
   525→   * Get the shadow mutex for external callers that need to serialize mutations.
   526→   * AC: @agent-dispatch-engine ac-12
   527→   */
   528→  getShadowMutex(): Mutex {
   529→    return this.shadowMutex;
   530→  }
   531→
   532→  /**
   533→   * Returns current engine status info including per-invocation details.
   534→   * AC: @cli-agent-commands ac-6
   535→   */
   536→  getStatus(): {
   537→    running: boolean;
   538→    activeInvocations: number;
   539→    queuedInvocations: number;
   540→    invocations: Array<{
   541→      invocationId: string;
   542→      sessionId: string;
   543→      agentId: string;
   544→      agentName: string;
   545→      taskRef: string | undefined;
   546→      elapsedMs: number;
   547→    }>;
   548→    queued: Array<{
   549→      agentId: string;
   550→      agentName: string;
   551→      taskRef: string | undefined;
   552→      waitMs: number;
   553→    }>;
   554→  } {
   555→    let active = 0;
   556→    let queued = 0;
   557→    for (const count of this.activeCount.values()) active += count;
   558→    for (const entries of this.queues.values()) queued += entries.length;
   559→    const now = Date.now();
   560→    const invocations = Array.from(this.activeInvocationDetails.values()).map((r) => ({
   561→      invocationId: r.invocationId,
   562→      sessionId: r.sessionId,
   563→      agentId: r.agentId,
   564→      agentName: r.agentName,
   565→      taskRef: r.taskRef,
   566→      elapsedMs: now - r.startedAtMs,
   567→    }));
   568→    const queuedItems = Array.from(this.queues.values()).flatMap((entries) =>
   569→      entries.map((e) => ({
   570→        agentId: e.agent.id,
   571→        agentName: e.agent.name,
   572→        taskRef: e.change.taskRef,
   573→        waitMs: now - e.enqueuedAtMs,
   574→      })),
   575→    );
   576→    return { running: this.running, activeInvocations: active, queuedInvocations: queued, invocations, queued: queuedItems };
   577→  }
   578→
   579→  // ─── Private helpers ─────────────────────────────────────────────────────────
   580→
   581→  /**
   582→   * Bootstrap: evaluate all current tasks against dispatch rules.
   583→   * AC: @agent-dispatch-engine ac-8
   584→   */
   585→  private async _bootstrap(): Promise<void> {
   586→    try {
   587→      const enqueued = await this._evaluateAllTasks({ skipIfActive: false });
   588→      if (enqueued > 0) {
   589→        const agents = await this._loadAgents();
   590→        await this._drainQueues(agents);
   591→      }
   592→    } catch (err) {
   593→      console.error("[dispatch] Bootstrap error:", err);
   594→    }
   595→  }
   596→
   597→  /**
   598→   * Periodic reconciliation: re-evaluate all task states against dispatch rules.
   599→   * Enqueues tasks that match but have no active or queued invocation.
   600→   * AC: @agent-dispatch-engine ac-19
   601→   */
   602→  private async _reconcile(): Promise<void> {
   603→    const enqueued = await this._evaluateAllTasks({ skipIfActive: true });
   604→    if (enqueued > 0) {
   605→      console.log(`[dispatch] Reconciliation enqueued ${enqueued} task(s)`);
   606→      const agents = await this._loadAgents();
   607→      await this._drainQueues(agents);
   608→    }
   609→  }
   610→
   611→  /**
   612→   * Shared logic for bootstrap and reconciliation: load all tasks, seed
   613→   * prevTaskStates, and enqueue tasks matching agent dispatch rules.
   614→   *
   615→   * When skipIfActive is true (reconciliation), tasks with an existing
   616→   * active or queued invocation are skipped.
   617→   *
   618→   * AC: @agent-dispatch-engine ac-8, ac-19
   619→   */
   620→  private async _evaluateAllTasks(opts: { skipIfActive: boolean }): Promise<number> {
   621→    const ctx = await initContext(this.projectDir);
   622→    const tasks = await loadAllTasks(ctx);
   623→    const agents = await this._loadAgents();
   624→    const now = Date.now();
   625→    let enqueued = 0;
   626→
   627→    // Seed/update prevTaskStates so file watcher diffs work correctly
   628→    for (const task of tasks) {
   629→      this.prevTaskStates.set(task._ulid, task.status as TaskStatus);
   630→    }
   631→
   632→    for (const task of tasks) {
   633→      const currentStatus = task.status as TaskStatus;
   634→      const eventType = STATUS_TO_EVENT[currentStatus];
   635→      if (!eventType) continue;
   636→
   637→      for (const agent of agents) {
   638→        for (const rule of (agent.dispatch ?? [])) {
   639→          if (rule.on !== eventType) continue;
   640→
   641→          const change: TaskStateChange = {
   642→            taskId: task._ulid,
   643→            taskRef: `@${task._ulid}`,
   644→            fromStatus: currentStatus,
   645→            toStatus: currentStatus,
   646→            timestamp: now,
   647→            task,
   648→          };
   649→
   650→          if (!this._matchesFilter(change, rule, task)) continue;
   651→          if (opts.skipIfActive && this._hasActiveOrQueuedInvocation(agent.id, task._ulid)) continue;
   652→
   653→          this._enqueue(agent, change);
   654→          enqueued++;
   655→        }
   656→      }
   657→    }
   658→
   659→    return enqueued;
   660→  }
   661→
   662→  /**
   663→   * Check if an agent already has an active or queued invocation for a task.
   664→   * AC: @agent-dispatch-engine ac-19
   665→   */
   666→  private _hasActiveOrQueuedInvocation(agentId: string, taskId: string): boolean {
   667→    // Check active invocations
   668→    for (const record of this.activeInvocationDetails.values()) {
   669→      if (record.agentId === agentId && record.taskRef === `@${taskId}`) {
   670→        return true;
   671→      }
   672→    }
   673→    // Check queued entries
   674→    const queue = this.queues.get(agentId) ?? [];
   675→    return queue.some((entry) => entry.change.taskId === taskId);
   676→  }
   677→
   678→  /**
   679→   * Load agent definitions from meta context.
   680→   */
   681→  private async _loadAgents(): Promise<LoadedAgent[]> {
   682→    try {
   683→      const ctx = await initContext(this.projectDir);
   684→      const meta = await loadMetaContext(ctx);
   685→      return meta.agents;
   686→    } catch {
   687→      return [];
   688→    }
   689→  }
   690→
   691→  /**
   692→   * Check if a state change matches a dispatch rule's filters.
   693→   * AC: @agent-dispatch-engine ac-6
   694→   */
   695→  private _matchesFilter(
   696→    change: TaskStateChange,
   697→    rule: AgentDispatchRule,
   698→    task?: LoadedTask,
   699→  ): boolean {
   700→    if (!rule.filter) return true;
   701→
   702→    // We need the task to evaluate filters — if not provided, reject to avoid
   703→    // enqueuing non-matching tasks (AC-6: all filters must match)
   704→    if (!task) return false;
   705→
   706→    const { filter } = rule;
   707→
   708→    // Automation filter
   709→    if (filter.automation !== undefined) {
   710→      if ((task as LoadedTask & { automation?: string }).automation !== filter.automation) {
   711→        return false;
   712→      }
   713→    }
   714→
   715→    // Tags filter
   716→    if (filter.tags && filter.tags.length > 0) {
   717→      const taskTags: string[] = (task as LoadedTask & { tags?: string[] }).tags ?? [];
   718→      if (!filter.tags.every((tag) => taskTags.includes(tag))) {
   719→        return false;
   720→      }
   721→    }
   722→
   723→    // Priority filter
   724→    if (filter.priority !== undefined) {
   725→      if ((task as LoadedTask & { priority?: number }).priority !== filter.priority) {
   726→        return false;
   727→      }
   728→    }
   729→
   730→    return true;
   731→  }
   732→
   733→  /**
   734→   * Build a deduplication key for a state change.
   735→   * AC: @agent-dispatch-engine ac-7
   736→   */
   737→  private _dedupKey(change: TaskStateChange): DedupKey {
   738→    return `${change.taskId}:${change.fromStatus}:${change.toStatus}`;
   739→  }
   740→
   741→  /**
   742→   * Check whether this event is a duplicate within the dedup window.
   743→   * AC: @agent-dispatch-engine ac-7
   744→   */
   745→  private _isDuplicate(change: TaskStateChange): boolean {
   746→    const key = this._dedupKey(change);
   747→    const expiry = this.recentEvents.get(key);
   748→    if (expiry === undefined) return false;
   749→    return change.timestamp < expiry;
   750→  }
   751→
   752→  /**
   753→   * Record a state change for deduplication.
   754→   * AC: @agent-dispatch-engine ac-7
   755→   */
   756→  private _recordEvent(change: TaskStateChange): void {
   757→    const key = this._dedupKey(change);
   758→    this.recentEvents.set(key, change.timestamp + this.dedupWindowMs);
   759→
   760→    // Prune expired entries periodically
   761→    if (this.recentEvents.size > 1000) {
   762→      const now = Date.now();
   763→      for (const [k, expiry] of this.recentEvents) {
   764→        if (expiry < now) this.recentEvents.delete(k);
   765→      }
   766→    }
   767→  }
   768→
   769→  /**
   770→   * Enqueue a dispatch entry for an agent.
   771→   * AC: @agent-dispatch-engine ac-3
   772→   */
   773→  private _enqueue(agent: LoadedAgent, change: TaskStateChange): void {
   774→    const queue = this.queues.get(agent.id) ?? [];
   775→    const entry: QueueEntry = {
   776→      agent,
   777→      change,
   778→      retryCount: 0,
   779→      nextRetryAt: 0,
   780→      enqueuedAtMs: Date.now(),
   781→      sequence: this.nextQueueSequence++,
   782→    };
   783→    this._insertQueueEntry(queue, entry);
   784→    this.queues.set(agent.id, queue);
   785→  }
   786→
   787→  /**
   788→   * Insert an entry into an agent queue using deterministic status precedence.
   789→   * AC: @dispatch-in-progress-priority ac-1
   790→   */
   791→  private _insertQueueEntry(queue: QueueEntry[], entry: QueueEntry): void {
   792→    const insertAt = queue.findIndex((queued) => this._compareQueueEntries(entry, queued) < 0);
   793→    if (insertAt === -1) {
   794→      queue.push(entry);
   795→      return;
   796→    }
   797→    queue.splice(insertAt, 0, entry);
   798→  }
   799→
   800→  /**
   801→   * Compare queue entries by dispatch precedence, then by enqueue sequence.
   802→   * AC: @dispatch-in-progress-priority ac-1
   803→   */
   804→  private _compareQueueEntries(a: QueueEntry, b: QueueEntry): number {
   805→    const statusDelta = STATUS_PRECEDENCE[a.change.toStatus] - STATUS_PRECEDENCE[b.change.toStatus];
   806→    if (statusDelta !== 0) return statusDelta;
   807→    return a.sequence - b.sequence;
   808→  }
   809→
   810→  /**
   811→   * Drain queues, spawning invocations up to each agent's max_concurrent limit.
   812→   * AC: @agent-dispatch-engine ac-3, ac-17
   813→   */
   814→  private async _drainQueues(agents: LoadedAgent[]): Promise<void> {
   815→    // Prevent new invocation starts during/after shutdown.
   816→    if (!this.running) return;
   817→
   818→    // AC: @agent-dispatch-engine ac-17 - Load current task states once for staleness checks
   819→    let currentTaskStates: Map<string, TaskStatus> | undefined;
   820→    try {
   821→      const ctx = await initContext(this.projectDir);
   822→      const tasks = await loadAllTasks(ctx);
   823→      currentTaskStates = new Map(
   824→        tasks.map((t) => [t._ulid, t.status as TaskStatus]),
   825→      );
   826→    } catch {
   827→      // If we can't load tasks, skip staleness checks (best effort)
   828→    }
   829→
   830→    for (const agent of agents) {
   831→      const maxConcurrent = agent.concurrency?.max_concurrent ?? 1;
   832→      const active = this.activeCount.get(agent.id) ?? 0;
   833→      const queue = this.queues.get(agent.id) ?? [];
   834→
   835→      // AC: @agent-dispatch-engine ac-17 - Discard stale entries before spawning.
   836→      // Only discard when we have positive evidence the task moved: either the task
   837→      // exists on disk with a different status, or the task was previously tracked
   838→      // (in prevTaskStates) but is no longer found (deleted).
   839→      if (currentTaskStates) {
   840→        const before = queue.length;
   841→        for (let i = queue.length - 1; i >= 0; i--) {
   842→          const entry = queue[i];
   843→          const currentStatus = currentTaskStates.get(entry.change.taskId);
   844→          const expectedEvent = STATUS_TO_EVENT[entry.change.toStatus];
   845→          if (!expectedEvent) continue; // No event mapping — skip check
   846→          if (currentStatus === undefined) {
   847→            // Task not on disk — only discard if we previously knew about it
   848→            // (it was deleted). Tasks from pure handleStateChange events without
   849→            // on-disk presence should still be processed.
   850→            if (this.prevTaskStates.has(entry.change.taskId)) {
   851→              queue.splice(i, 1);
   852→            }
   853→          } else {
   854→            const currentEvent = STATUS_TO_EVENT[currentStatus];
   855→            if (currentEvent !== expectedEvent) {
   856→              queue.splice(i, 1);
   857→            }
   858→          }
   859→        }
   860→        if (before > queue.length) {
   861→          console.log(
   862→            `[dispatch] Discarded ${before - queue.length} stale queue entries for agent "${agent.id}"`,
   863→          );
   864→        }
   865→      }
   866→
   867→      let slots = maxConcurrent - active;
   868→      while (slots > 0 && queue.length > 0) {
   869→        const now = Date.now();
   870→        const nextReadyIndex = queue.findIndex((entry) => entry.nextRetryAt <= now);
   871→        if (nextReadyIndex === -1) {
   872→          break;
   873→        }
   874→        const [entry] = queue.splice(nextReadyIndex, 1);
   875→        const spawned = this._spawnInvocation(agent, entry);
   876→        if (spawned) slots--;
   877→      }
   878→
   879→      this.queues.set(agent.id, queue);
   880→    }
   881→  }
   882→
   883→  /**
   884→   * Build dispatch-mode prompt guardrails to keep autonomous agents from
   885→   * stopping with handoff text instead of performing required actions.
   886→   *
   887→   * AC: @agent-dispatch-engine ac-13, ac-14, ac-15, ac-16
   888→   */
   889→  private _buildDispatchPrompt(agent: LoadedAgent, change: TaskStateChange): string {
   890→    const trigger = (STATUS_TO_EVENT[change.toStatus] ?? "task.ready") as SessionTrigger;
   891→    const taskRef = change.taskRef;
   892→
   893→    // AC: @agent-dispatch-engine ac-16 - Interpolate prompt_template variables
   894→    const templateVars: Record<string, string> = {
   895→      task_ref: taskRef,
   896→      task_title: change.task?.title ?? "(unavailable)",
   897→      trigger,
   898→      review_url: change.task?.review_url ?? "",
   899→    };
   900→    const rawTemplate = agent.prompt_template ?? `Work on task ${taskRef}`;
   901→    const basePrompt = interpolateTemplate(rawTemplate, templateVars);
   902→
   903→    // AC: @agent-dispatch-engine ac-13 - Orientation context
   904→    const orientation = buildOrientationContext(taskRef, trigger, change.task);
   905→
   906→    const autonomousPreamble = [
   907→      "AUTONOMOUS DISPATCH MODE (no interactive user is available).",
   908→      "- Do not ask for confirmation, approval, or next-step handoff.",
   909→      "- Execute required commands directly in this invocation.",
   910→      "- Do not end your turn with a recommendations-only summary. Perform the next required action yourself.",
   911→      "- Do not end your turn until the expected task transition is complete, or you have explicitly blocked the task with `kspec task block <task> --reason \"...\"`.",
   912→      "- If you find an open PR/branch from a different task, create or switch to a dedicated branch for this task before committing to avoid PR conflation.",
   913→    ];
   914→
   915→    const triggerSpecific =
   916→      trigger === "task.pending_review"
   917→        ? [
   918→            `Review flow completion criteria for ${taskRef}:`,
   919→            "- Execute your configured review workflow directly (no handoff).",
   920→            `- If blocking issues are found, transition ${taskRef} out of pending_review appropriately (for example needs_work).`,
   921→            `- If review gates are clean, perform your workflow's completion actions directly in this invocation.`,
   922→          ]
   923→        : [
   924→            `Work flow completion criteria for ${taskRef}:`,
   925→            "- Execute your configured work workflow directly (no handoff).",
   926→            `- Perform the required commands to move ${taskRef} to the next appropriate state in this same invocation.`,
   927→            "- If your workflow includes git or PR steps, execute them directly instead of deferring to a human.",
   928→          ];
   929→
   930→    return `${basePrompt}\n\n${orientation}\n\n${autonomousPreamble.join("\n")}\n\n${triggerSpecific.join("\n")}`;
   931→  }
   932→
   933→  /**
   934→   * Spawn a single invocation for a queue entry.
   935→   * Returns true if an invocation was actually started, false if skipped.
   936→   * AC: @agent-dispatch-engine ac-9, ac-10, ac-11, ac-12
   937→   */
   938→  private _spawnInvocation(agent: LoadedAgent, entry: QueueEntry): boolean {
   939→    const agentId = agent.id;
   940→
   941→    // Increment active count
   942→    this.activeCount.set(agentId, (this.activeCount.get(agentId) ?? 0) + 1);
   943→
   944→    // AC: @agent-dispatch-engine ac-10 - Check adapter resolvability before spawn
   945→    const adapterId = agent.adapter ?? "claude-agent-acp";
   946→    const adapter = getAdapter(adapterId);
   947→    if (!adapter) {
   948→      console.error(
   949→        `[dispatch] Cannot resolve adapter "${adapterId}" for agent "${agentId}". Skipping invocation.`,
   950→      );
   951→      // Decrement active count since we're not actually running
   952→      const currentActive = this.activeCount.get(agentId) ?? 1;
   953→      this.activeCount.set(agentId, Math.max(0, currentActive - 1));
   954→      // AC: @agent-dispatch-engine ac-10 - Add task note for unresolvable adapter
   955→      if (this.kspecCliPath) {
   956→        spawnSync(process.execPath, [
   957→          this.kspecCliPath,
   958→          "task", "note", entry.change.taskRef,
   959→          `[AGENT-SKIP] Cannot resolve adapter "${adapterId}" for agent "${agentId}". Invocation skipped.`,
   960→        ], { cwd: this.cwd });
   961→      }
   962→      return false;
   963→    }
   964→
   965→    // AC: @agent-dispatch-engine ac-11 - Create abort controller for graceful cancellation
   966→    const abortController = new AbortController();
   967→    this.invocationAbortControllers.add(abortController);
   968→
   969→    // AC: @cli-agent-commands ac-6 - Pre-assign session ID for status tracking
   970→    const preSessionId = ulid();
   971→    const invocationId = ulid();
   972→    const trackingRecord: ActiveInvocationRecord = {
   973→      invocationId,
   974→      sessionId: preSessionId,
   975→      agentId,
   976→      agentName: agent.name,
   977→      taskRef: entry.change.taskRef,
   978→      startedAtMs: Date.now(),
   979→    };
   980→    this.activeInvocationDetails.set(invocationId, trackingRecord);
   981→
   982→    // AC: @daemon-agent-dispatch ac-3, ac-4 - Emit started event
   983→    this.onInvocationEvent?.({
   984→      type: "started",
   985→      session_id: preSessionId,
   986→      agent_id: agentId,
   987→      task_id: entry.change.taskRef,
   988→      status: "started",
   989→      timestamp: Date.now(),
   990→    });
   991→
   992→    // AC: @cli-agent-commands ac-13, @daemon-agent-dispatch ac-8 - stream text chunks to watchers
   993→    const taskId = entry.change.taskRef ?? null;
   994→    const onUpdate = this.onTextChunk
   995→      ? (update: import("../acp/index.js").SessionUpdate) => {
   996→          if (
   997→            update.sessionUpdate === "agent_message_chunk" &&
   998→            update.content.type === "text"
   999→          ) {
  1000→            this.onTextChunk!(preSessionId, agentId, taskId, update.content.text);
  1001→            return;
  1002→          }
  1003→          // Non-text updates (especially tool events) delimit logical message runs.
  1004→          // Emit an empty sentinel so watch renderers can end the current line
  1005→          // without needing to infer boundaries from prose punctuation.
  1006→          this.onTextChunk!(preSessionId, agentId, taskId, "");
  1007→        }
  1008→      : undefined;
  1009→
  1010→    const options: InvocationOptions = {
  1011→      agent,
  1012→      specDir: this.specDir,
  1013→      cwd: this.cwd,
  1014→      taskRef: entry.change.taskRef,
  1015→      prompt: this._buildDispatchPrompt(agent, entry.change),
  1016→      trigger: (STATUS_TO_EVENT[entry.change.toStatus] ?? "task.ready") as SessionTrigger,
  1017→      kspecCliPath: this.kspecCliPath,
  1018→      abortSignal: abortController.signal,
  1019→      sessionId: preSessionId,
  1020→      onUpdate,
  1021→    };
  1022→
  1023→    // AC: @agent-dispatch-engine ac-12 - Wrap invocation in shadow mutex
  1024→    const invocationPromise = this.shadowMutex
  1025→      .runExclusive(async () => {
  1026→        // AC: @agent-dispatch-engine ac-9 - Retry on transient errors
  1027→        try {
  1028→          await runInvocation(options);
  1029→          // Reset retry count on success
  1030→          entry.retryCount = 0;
  1031→          // AC: @daemon-agent-dispatch ac-3, ac-4 - Emit completed event
  1032→          this.onInvocationEvent?.({
  1033→            type: "completed",
  1034→            session_id: preSessionId,
  1035→            agent_id: agentId,
  1036→            task_id: entry.change.taskRef,
  1037→            status: "completed",
  1038→            timestamp: Date.now(),
  1039→          });
  1040→        } catch (err) {
  1041→          const retryLimit = agent.budget?.max_retries ?? 3;
  1042→          if (entry.retryCount < retryLimit) {
  1043→            entry.retryCount++;
  1044→            const backoffMs = Math.min(
  1045→              1000 * Math.pow(2, entry.retryCount - 1),
  1046→              30_000,
  1047→            );
  1048→            entry.nextRetryAt = Date.now() + backoffMs;
  1049→            console.warn(
  1050→              `[dispatch] Invocation for agent "${agentId}" failed (attempt ${entry.retryCount}/${retryLimit}), retrying in ${backoffMs}ms`,
  1051→              err,
  1052→            );
  1053→            // Re-enqueue for retry while preserving status precedence ordering.
  1054→            const queue = this.queues.get(agentId) ?? [];
  1055→            this._insertQueueEntry(queue, entry);
  1056→            this.queues.set(agentId, queue);
  1057→            // AC: @agent-dispatch-engine ac-9 - Schedule wake-up to drain retry
  1058→            setTimeout(() => {
  1059→              if (this.running) {
  1060→                this._loadAgents()
  1061→                  .then((agents) => this._drainQueues(agents))
  1062→                  .catch(() => {/* best effort */});
  1063→              }
  1064→            }, backoffMs);
  1065→          } else {
  1066→            console.error(
  1067→              `[dispatch] Agent "${agentId}" exceeded retry limit. Dropping invocation.`,
  1068→              err,
  1069→            );
  1070→            // AC: @daemon-agent-dispatch ac-3, ac-4 - Emit failed event when retry limit exceeded
  1071→            this.onInvocationEvent?.({
  1072→              type: "failed",
  1073→              session_id: preSessionId,
  1074→              agent_id: agentId,
  1075→              task_id: entry.change.taskRef,
  1076→              status: "failed",
  1077→              timestamp: Date.now(),
  1078→            });
  1079→          }
  1080→        }
  1081→      })
  1082→      .then(async () => {
  1083→        // Decrement active count and drain again
  1084→        const currentActive = this.activeCount.get(agentId) ?? 1;
  1085→        this.activeCount.set(agentId, Math.max(0, currentActive - 1));
  1086→
  1087→        if (!this.running) return;
  1088→
  1089→        // Try to drain more items
  1090→        try {
  1091→          const agents = await this._loadAgents();
  1092→          await this._drainQueues(agents);
  1093→        } catch {
  1094→          // Best effort
  1095→        }
  1096→      })
  1097→      .finally(() => {
  1098→        this.runningInvocations.delete(invocationPromise);
  1099→        this.invocationAbortControllers.delete(abortController);
  1100→        this.activeInvocationDetails.delete(invocationId);
  1101→      });
  1102→
  1103→    this.runningInvocations.add(invocationPromise);
  1104→    return true;
  1105→  }
  1106→}
  1107→
```