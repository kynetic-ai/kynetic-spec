  1130→describe("Autonomous dispatch prompt guardrails", () => {
  1131→  let testDir: string;
  1132→
  1133→  beforeEach(async () => {
  1134→    testDir = await createTempDir("kspec-dispatch-prompt-");
  1135→  });
  1136→
  1137→  afterEach(async () => {
  1138→    vi.restoreAllMocks();
  1139→    await cleanupTempDir(testDir);
  1140→  });
  1141→
  1142→  it("should include worker completion guardrails for task.ready triggers", async () => {
  1143→    const agent = makeTestAgent({ id: "worker", dispatch: [{ on: "task.ready" }] });
  1144→    await setupProjectWithAgents(testDir, [agent]);
  1145→
  1146→    const runSpy = vi.spyOn(invocationModule, "runInvocation").mockResolvedValue({
  1147→      session: {} as any,
  1148→      outcome: "success",
  1149→      durationMs: 1,
  1150→    });
  1151→
  1152→    const engine = new DispatchEngine({
  1153→      projectDir: testDir,
  1154→      specDir: testDir,
  1155→      kspecCliPath: MOCK_KSPEC_CLI,
  1156→    });
  1157→
  1158→    await engine.start();
  1159→    const taskId = testUlid("TASK");
  1160→    await engine.handleStateChange({
  1161→      taskId,
  1162→      taskRef: `@${taskId}`,
  1163→      fromStatus: "in_progress",
  1164→      toStatus: "pending",
  1165→      timestamp: Date.now(),
  1166→    });
  1167→
  1168→    for (let i = 0; i < 20 && runSpy.mock.calls.length === 0; i++) {
  1169→      await new Promise((resolve) => setTimeout(resolve, 5));
  1170→    }
  1171→
