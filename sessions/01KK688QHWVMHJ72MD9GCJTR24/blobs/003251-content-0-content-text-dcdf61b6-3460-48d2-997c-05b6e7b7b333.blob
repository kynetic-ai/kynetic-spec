   446→// ─── AC-5: File watcher diffs task states ────────────────────────────────────
   447→
   448→// AC: @agent-dispatch-engine ac-5
   449→describe("AC-5: File watcher diffs task states", () => {
   450→  let testDir: string;
   451→
   452→  beforeEach(async () => {
   453→    testDir = await createTempDir("kspec-dispatch-ac5-");
   454→  });
   455→
   456→  afterEach(async () => {
   457→    await cleanupTempDir(testDir);
   458→  });
   459→
   460→  it("should detect task status transitions from file changes", async () => {
   461→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   462→    await setupProjectWithAgents(testDir, [agent]);
   463→
   464→    const taskId = testUlid("TASK");
   465→    // Start with in_progress
   466→    await writeTasks(testDir, [{ _ulid: taskId, status: "in_progress" }]);
   467→
   468→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   469→    await engine.start();
   470→
   471→    // Update task to pending (task.ready event)
   472→    await writeTasks(testDir, [{ _ulid: taskId, status: "pending" }]);
   473→
   474→    // Trigger file change notification
   475→    const detectedChanges: TaskStateChange[] = [];
   476→    const originalHandleStateChange = engine.handleStateChange.bind(engine);
   477→    // Spy on handleStateChange to track changes
   478→    const handleSpy = vi.spyOn(engine, "handleStateChange").mockImplementation(async (change) => {
   479→      detectedChanges.push(change);
   480→    });
   481→
   482→    await engine.handleFileChange(testDir);
   483→
   484→    expect(detectedChanges).toHaveLength(1);
   485→    expect(detectedChanges[0].taskId).toBe(taskId);
   486→    expect(detectedChanges[0].fromStatus).toBe("in_progress");
   487→    expect(detectedChanges[0].toStatus).toBe("pending");
   488→
   489→    handleSpy.mockRestore();
   490→    await engine.stop();
   491→  });
   492→
   493→  it("should not emit change events when task status is unchanged", async () => {
   494→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   495→    await setupProjectWithAgents(testDir, [agent]);
   496→
   497→    const taskId = testUlid("TASK");
   498→    await writeTasks(testDir, [{ _ulid: taskId, status: "in_progress" }]);
   499→
   500→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   501→    await engine.start();
   502→
   503→    // Same status again — no change
   504→    const detectedChanges: TaskStateChange[] = [];
   505→    vi.spyOn(engine, "handleStateChange").mockImplementation(async (change) => {
   506→      detectedChanges.push(change);
   507→    });
   508→
   509→    await engine.handleFileChange(testDir);
   510→
   511→    expect(detectedChanges).toHaveLength(0);
   512→
   513→    await engine.stop();
   514→  });
   515→});
