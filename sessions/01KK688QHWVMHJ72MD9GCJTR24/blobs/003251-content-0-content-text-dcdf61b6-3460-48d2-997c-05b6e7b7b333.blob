  2185→// ─── AC-21: Default automation filter for task.ready/task.needs_work ────────
  2186→
  2187→// AC: @agent-dispatch-engine ac-21
  2188→describe("AC-21: Default automation:eligible for task.ready/task.needs_work without filter", () => {
  2189→  let testDir: string;
  2190→
  2191→  beforeEach(async () => {
  2192→    testDir = await createTempDir("kspec-dispatch-ac21-");
  2193→  });
  2194→
  2195→  afterEach(async () => {
  2196→    await cleanupTempDir(testDir);
  2197→  });
  2198→
  2199→  it("should reject ineligible tasks on task.ready rules with no filter", async () => {
  2200→    // Agent with NO filter on task.ready — should still default to automation:eligible
  2201→    const agent = makeTestAgent({
  2202→      id: "no-filter-worker",
  2203→      dispatch: [{ on: "task.ready" }],
  2204→    });
  2205→    await setupProjectWithAgents(testDir, [agent]);
  2206→
  2207→    const taskId = testUlid("TASK");
  2208→    await writeTasks(testDir, [
  2209→      { _ulid: taskId, status: "in_progress", automation: "ineligible" },
  2210→    ]);
  2211→
  2212→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
  2213→
  2214→    let enqueueCount = 0;
  2215→    vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue").mockImplementation(() => {
  2216→      enqueueCount++;
  2217→    });
  2218→
  2219→    await engine.start();
  2220→    enqueueCount = 0; // reset after bootstrap
  2221→
  2222→    // Transition to pending (task.ready) — should NOT be queued because task is ineligible
  2223→    await writeTasks(testDir, [
  2224→      { _ulid: taskId, status: "pending", automation: "ineligible" },
  2225→    ]);
  2226→
  2227→    await engine.handleFileChange(testDir);
  2228→
  2229→    expect(enqueueCount).toBe(0);
  2230→
  2231→    await engine.stop();
