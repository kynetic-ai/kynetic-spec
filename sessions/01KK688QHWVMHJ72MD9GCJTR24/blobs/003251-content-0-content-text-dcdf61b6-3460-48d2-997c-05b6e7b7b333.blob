     1→/**
     2→ * Agent Dispatch Engine tests.
     3→ *
     4→ * Tests for core dispatch runtime: state change matching, queuing, deduplication,
     5→ * concurrency limits, filter evaluation, bootstrap, and graceful shutdown.
     6→ *
     7→ * Task: @implement-agent-dispatch-engine
     8→ * Spec: @agent-dispatch-engine
     9→ */
    10→
    11→import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
    12→import * as path from "node:path";
    13→import * as fs from "node:fs/promises";
    14→import * as fsSync from "node:fs";
    15→import * as YAML from "yaml";
    16→import {
    17→  DispatchEngine,
    18→  type TaskStateChange,
    19→  type DispatchEngineOptions,
    20→} from "../src/agent-runtime/dispatch.js";
    21→import * as invocationModule from "../src/agent-runtime/invocation.js";
    22→import {
    23→  createTempDir,
    24→  cleanupTempDir,
    25→  createIsolatedKspecHome,
    26→  testUlid,
    27→  testUlids,
    28→  kspec,
    29→  initGitRepo,
    30→} from "./helpers/cli.js";
    31→import * as http from "node:http";
    32→import type { Agent } from "../src/schema/meta.js";
    33→
    34→// ─── Fixtures ────────────────────────────────────────────────────────────────
    35→
    36→const MOCK_KSPEC_CLI = path.join(__dirname, "mocks", "kspec-capture-mock.cjs");
    37→
    38→/**
    39→ * Create a minimal Agent definition for testing.
    40→ */
    41→function makeTestAgent(overrides: Partial<Agent> = {}): Agent {
    42→  return {
    43→    _ulid: testUlid("AGNT"),
    44→    id: "test-worker",
    45→    name: "Test Worker Agent",
    46→    capabilities: [],
    47→    tools: [],
    48→    conventions: [],
    49→    dispatch: [{ on: "task.ready" }],
    50→    skills: [],
    51→    auto_approve: false,
    52→    concurrency: { max_concurrent: 1 },
    53→    adapter: "mock-acp",
    54→    ...overrides,
    55→  };
    56→}
    57→
    58→/**
    59→ * Set up a minimal kspec project directory with meta containing agents.
    60→ *
    61→ * Uses traditional (non-shadow) layout: manifest and meta in the specDir directly.
    62→ * Sets KSPEC_SPEC_DIR to point to the spec directory so initContext can find it.
    63→ */
    64→async function setupProjectWithAgents(
    65→  dir: string,
    66→  agents: Agent[],
    67→): Promise<void> {
    68→  initGitRepo(dir);
    69→
    70→  // Use traditional layout: manifest in the dir root itself
    71→  // Write manifest
    72→  await fs.writeFile(
    73→    path.join(dir, "kynetic.yaml"),
    74→    YAML.stringify({ kynetic: "1", title: "Test Project" }),
    75→    "utf-8",
    76→  );
    77→
    78→  // Write meta with agents
    79→  await fs.writeFile(
    80→    path.join(dir, "kynetic.meta.yaml"),
    81→    YAML.stringify({
    82→      kynetic_meta: "1.0",
    83→      agents: agents.map((a) => ({
    84→        _ulid: a._ulid,
    85→        id: a.id,
    86→        name: a.name,
    87→        dispatch: a.dispatch ?? [],
    88→        concurrency: a.concurrency,
    89→        adapter: a.adapter,
    90→        budget: a.budget,
    91→        auto_approve: a.auto_approve ?? false,
    92→        ...(a.prompt_template && { prompt_template: a.prompt_template }),
    93→      })),
    94→    }),
    95→    "utf-8",
    96→  );
    97→
    98→  // Write empty tasks file
    99→  await fs.writeFile(
   100→    path.join(dir, "project.tasks.yaml"),
   101→    YAML.stringify({ tasks: [] }),
   102→    "utf-8",
   103→  );
   104→}
   105→
   106→/**
   107→ * Write tasks to the project tasks file.
   108→ */
   109→async function writeTasks(dir: string, tasks: Array<{
   110→  _ulid: string;
   111→  status: string;
   112→  automation?: string;
   113→  tags?: string[];
   114→  priority?: number;
   115→}>): Promise<void> {
   116→  await fs.writeFile(
   117→    path.join(dir, "project.tasks.yaml"),
   118→    YAML.stringify({
   119→      tasks: tasks.map((t) => ({
   120→        _ulid: t._ulid,
   121→        type: "task",
   122→        title: `Task ${t._ulid}`,
   123→        status: t.status,
   124→        automation: t.automation,
   125→        tags: t.tags ?? [],
   126→        priority: t.priority,
   127→        created_at: new Date().toISOString(),
   128→        notes: [],
   129→        todos: [],
   130→      })),
   131→    }),
   132→    "utf-8",
   133→  );
   134→}
   135→
   136→/**
   137→ * Create a TaskStateChange for testing.
   138→ */
   139→function makeStateChange(overrides: Partial<TaskStateChange> = {}): TaskStateChange {
   140→  return {
   141→    taskId: testUlid("TASK"),
   142→    taskRef: `@${testUlid("TASK")}`,
   143→    fromStatus: "in_progress",
   144→    toStatus: "pending",
   145→    timestamp: Date.now(),
   146→    ...overrides,
   147→  };
   148→}
