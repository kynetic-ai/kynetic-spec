   576→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   577→    await engine.start();
   578→
   579→    await writeTasks(testDir, [
   580→      { _ulid: taskId, status: "pending", automation: "eligible", tags: ["mvp"] },
   581→    ]);
   582→
   583→    let dispatchedCount = 0;
   584→    vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue").mockImplementation(() => {
   585→      dispatchedCount++;
   586→    });
   587→
   588→    await engine.handleFileChange(testDir);
   589→
   590→    expect(dispatchedCount).toBe(1);
