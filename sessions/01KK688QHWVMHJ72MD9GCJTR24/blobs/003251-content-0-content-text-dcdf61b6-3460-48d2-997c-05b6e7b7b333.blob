   762→// ─── AC-10: Unresolvable adapter ─────────────────────────────────────────────
   763→
   764→// AC: @agent-dispatch-engine ac-10
   765→describe("AC-10: Unresolvable adapter skips invocation with error log", () => {
   766→  let testDir: string;
   767→
   768→  beforeEach(async () => {
   769→    testDir = await createTempDir("kspec-dispatch-ac10-");
   770→  });
   771→
   772→  afterEach(async () => {
   773→    await cleanupTempDir(testDir);
   774→  });
   775→
   776→  it("should log error and skip invocation when adapter cannot be resolved", async () => {
   777→    const agentBadAdapter = makeTestAgent({
   778→      id: "bad-adapter-agent",
   779→      adapter: "nonexistent-adapter-xyz",
   780→      dispatch: [{ on: "task.ready" }],
   781→    });
   782→    await setupProjectWithAgents(testDir, [agentBadAdapter]);
   783→
   784→    const errorSpy = vi.spyOn(console, "error").mockImplementation(() => {});
   785→
   786→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   787→
   788→    // Manually call _spawnInvocation with the bad agent via type assertion
   789→    type EngineInternal = { _spawnInvocation: (a: unknown, e: unknown) => void };
   790→    const change = makeStateChange({ toStatus: "pending", fromStatus: "in_progress" });
   791→    const entry = { agent: agentBadAdapter, change, retryCount: 0, nextRetryAt: 0 };
   792→
   793→    (engine as unknown as EngineInternal)._spawnInvocation(agentBadAdapter, entry);
   794→
   795→    expect(errorSpy).toHaveBeenCalledWith(
   796→      expect.stringContaining("nonexistent-adapter-xyz"),
   797→    );
   798→
   799→    errorSpy.mockRestore();
   800→  });
   801→
   802→  it("should add a task note when adapter cannot be resolved", async () => {
   803→    const agentBadAdapter = makeTestAgent({
   804→      id: "bad-adapter-agent",
   805→      adapter: "nonexistent-adapter-xyz",
   806→      dispatch: [{ on: "task.ready" }],
   807→    });
   808→    await setupProjectWithAgents(testDir, [agentBadAdapter]);
   809→
   810→    // Set up capture file to track kspec CLI calls
   811→    const captureFile = path.join(testDir, "kspec-capture.json");
   812→    process.env.KSPEC_CAPTURE_FILE = captureFile;
   813→
   814→    try {
   815→      const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   816→
   817→      type EngineInternal = { _spawnInvocation: (a: unknown, e: unknown) => void };
   818→      const taskRef = `@${testUlid("TASK")}`;
   819→      const change = makeStateChange({ toStatus: "pending", fromStatus: "in_progress", taskRef });
   820→      const entry = { agent: agentBadAdapter, change, retryCount: 0, nextRetryAt: 0 };
   821→
   822→      vi.spyOn(console, "error").mockImplementation(() => {});
   823→      (engine as unknown as EngineInternal)._spawnInvocation(agentBadAdapter, entry);
   824→      vi.restoreAllMocks();
   825→
   826→      // Verify task note was added
   827→      const calls = JSON.parse(fsSync.readFileSync(captureFile, "utf-8")) as Array<{ args: string[] }>;
   828→      const noteCall = calls.find((c) => c.args.includes("note") && c.args.includes(taskRef));
   829→      expect(noteCall).toBeTruthy();
   830→      expect(noteCall!.args.join(" ")).toContain("AGENT-SKIP");
   831→    } finally {
   832→      delete process.env.KSPEC_CAPTURE_FILE;
   833→    }
   834→  });
   835→});
