  1839→// ─── Self-trigger suppression ────────────────────────────────────────────────
  1840→
  1841→describe("Self-trigger suppression", () => {
  1842→  let testDir: string;
  1843→  let server: http.Server;
  1844→  let serverPort: number;
  1845→  let receivedEvents: unknown[];
  1846→
  1847→  beforeEach(async () => {
  1848→    testDir = await createTempDir("kspec-dispatch-selftrigger-");
  1849→    receivedEvents = [];
  1850→
  1851→    // Start a minimal HTTP server to capture dispatch events
  1852→    server = http.createServer((req, res) => {
  1853→      if (req.url === "/api/agent/events" && req.method === "POST") {
  1854→        let body = "";
  1855→        req.on("data", (chunk: Buffer) => { body += chunk.toString(); });
  1856→        req.on("end", () => {
  1857→          try { receivedEvents.push(JSON.parse(body)); } catch { /* ignore */ }
  1858→          res.writeHead(200, { "Content-Type": "application/json" });
  1859→          res.end(JSON.stringify({ accepted: true }));
  1860→        });
  1861→        return;
  1862→      }
  1863→      res.writeHead(404);
  1864→      res.end();
  1865→    });
  1866→
  1867→    await new Promise<void>((resolve) => {
  1868→      server.listen(0, "127.0.0.1", () => resolve());
  1869→    });
  1870→    serverPort = (server.address() as { port: number }).port;
  1871→  });
  1872→
  1873→  afterEach(async () => {
  1874→    await new Promise<void>((resolve) => server.close(() => resolve()));
  1875→    await cleanupTempDir(testDir);
  1876→  });
  1877→
  1878→  // AC: @agent-dispatch-engine ac-18
  1879→  it("should suppress dispatch events when KSPEC_SESSION_ID is set", async () => {
  1880→    // Set up a minimal kspec project with a task
  1881→    initGitRepo(testDir);
  1882→    const taskId = testUlid("TASK");
  1883→    await fs.writeFile(
  1884→      path.join(testDir, "kynetic.yaml"),
  1885→      YAML.stringify({ kynetic: "1", title: "Test" }),
  1886→    );
  1887→    await fs.writeFile(
  1888→      path.join(testDir, "project.tasks.yaml"),
  1889→      YAML.stringify({
  1890→        tasks: [{
  1891→          _ulid: taskId,
  1892→          type: "task",
  1893→          title: "Test task",
  1894→          status: "pending",
  1895→          tags: [],
  1896→          notes: [],
  1897→          todos: [],
  1898→          created_at: new Date().toISOString(),
  1899→        }],
  1900→      }),
  1901→    );
  1902→    // Initial git commit so kspec commands work
  1903→    await fs.writeFile(path.join(testDir, ".gitignore"), "");
  1904→    const { execSync } = await import("node:child_process");
  1905→    execSync("git add -A && git commit -m init", { cwd: testDir, stdio: "pipe" });
  1906→
  1907→    // Create isolated home with fake daemon PID/port pointing at our server
  1908→    const isolated = await createIsolatedKspecHome(testDir);
  1909→    await fs.writeFile(isolated.daemonPidFilePath, String(process.pid));
  1910→    await fs.writeFile(isolated.daemonPortFilePath, String(serverPort));
  1911→
  1912→    const specDirEnv = { KSPEC_SPEC_DIR: testDir };
  1913→
  1914→    // Run task start WITHOUT KSPEC_SESSION_ID — event should be posted
  1915→    kspec(`task start @${taskId}`, testDir, {
  1916→      env: { ...isolated.env, ...specDirEnv },
  1917→    });
  1918→    // Give async fire-and-forget fetch time to complete
  1919→    await new Promise((r) => setTimeout(r, 200));
  1920→    expect(receivedEvents.length).toBe(1);
  1921→
  1922→    // Reset task to pending for the next test
  1923→    receivedEvents = [];
  1924→    await fs.writeFile(
  1925→      path.join(testDir, "project.tasks.yaml"),
  1926→      YAML.stringify({
  1927→        tasks: [{
  1928→          _ulid: taskId,
  1929→          type: "task",
  1930→          title: "Test task",
  1931→          status: "pending",
  1932→          tags: [],
  1933→          notes: [],
  1934→          todos: [],
  1935→          created_at: new Date().toISOString(),
  1936→        }],
  1937→      }),
  1938→    );
  1939→    execSync("git add -A && git commit -m reset", { cwd: testDir, stdio: "pipe" });
  1940→
  1941→    // Run task start WITH KSPEC_SESSION_ID — event should be suppressed
  1942→    kspec(`task start @${taskId}`, testDir, {
  1943→      env: { ...isolated.env, ...specDirEnv, KSPEC_SESSION_ID: "test-session-id" },
  1944→    });
  1945→    await new Promise((r) => setTimeout(r, 200));
  1946→    expect(receivedEvents.length).toBe(0);
  1947→  });
  1948→});
  1949→
  1950→// ─── AC-19: Periodic reconciliation ───────────────────────────────────────────
  1951→
  1952→// AC: @agent-dispatch-engine ac-19
  1953→describe("AC-19: Periodic reconciliation re-enqueues missed tasks", () => {
  1954→  let testDir: string;
  1955→
  1956→  beforeEach(async () => {
  1957→    testDir = await createTempDir("kspec-dispatch-reconcile-");
  1958→  });
  1959→
  1960→  afterEach(async () => {
  1961→    await cleanupTempDir(testDir);
  1962→  });
  1963→
  1964→  // AC: @agent-dispatch-engine ac-19
  1965→  it("should enqueue matching tasks with no active or queued invocation", async () => {
  1966→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
  1967→    await setupProjectWithAgents(testDir, [agent]);
  1968→
  1969→    const taskId = testUlid("TASK");
  1970→    await writeTasks(testDir, [{ _ulid: taskId, status: "pending" }]);
  1971→
  1972→    const engine = new DispatchEngine({
  1973→      projectDir: testDir,
  1974→      specDir: testDir,
  1975→      kspecCliPath: MOCK_KSPEC_CLI,
  1976→      reconcileIntervalMs: 0,
  1977→    });
  1978→
  1979→    // Mock _drainQueues to prevent actual invocation spawning
  1980→    vi.spyOn(engine as unknown as { _drainQueues: (a: unknown) => Promise<void> }, "_drainQueues")
  1981→      .mockResolvedValue(undefined);
  1982→    const enqueueSpy = vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue");
  1983→
  1984→    await engine.start();
  1985→
  1986→    // Bootstrap enqueued it via _enqueue (drain is no-op so entries stay)
  1987→    expect(enqueueSpy.mock.calls.length).toBeGreaterThanOrEqual(1);
  1988→
  1989→    // Clear the queue to simulate a lost event scenario
  1990→    (engine as unknown as { queues: Map<string, unknown[]> }).queues.clear();
  1991→    enqueueSpy.mockClear();
  1992→
  1993→    // Now call _reconcile — it should re-discover the task
  1994→    await (engine as unknown as { _reconcile: () => Promise<void> })._reconcile();
  1995→
  1996→    expect(enqueueSpy.mock.calls.length).toBeGreaterThanOrEqual(1);
  1997→
  1998→    await engine.stop();
  1999→  });
  2000→
  2001→  // AC: @agent-dispatch-engine ac-19
  2002→  it("should NOT re-enqueue tasks that already have a queued invocation", async () => {
  2003→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
  2004→    await setupProjectWithAgents(testDir, [agent]);
  2005→
  2006→    const taskId = testUlid("TASK");
  2007→    await writeTasks(testDir, [{ _ulid: taskId, status: "pending" }]);
  2008→
  2009→    const engine = new DispatchEngine({
  2010→      projectDir: testDir,
  2011→      specDir: testDir,
  2012→      kspecCliPath: MOCK_KSPEC_CLI,
  2013→      reconcileIntervalMs: 0,
  2014→    });
  2015→
  2016→    // Mock _drainQueues to prevent actual invocation spawning
  2017→    vi.spyOn(engine as unknown as { _drainQueues: (a: unknown) => Promise<void> }, "_drainQueues")
  2018→      .mockResolvedValue(undefined);
  2019→    const enqueueSpy = vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue");
  2020→
  2021→    await engine.start();
  2022→
  2023→    // Bootstrap enqueued it — DON'T clear the queue this time
  2024→    enqueueSpy.mockClear();
  2025→
  2026→    // Reconcile should see the queued entry and skip
  2027→    await (engine as unknown as { _reconcile: () => Promise<void> })._reconcile();
  2028→
  2029→    expect(enqueueSpy.mock.calls.length).toBe(0);
  2030→
  2031→    await engine.stop();
  2032→  });
  2033→
  2034→  // AC: @agent-dispatch-engine ac-19
  2035→  it("should skip tasks in non-dispatchable states (completed, blocked)", async () => {
  2036→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
  2037→    await setupProjectWithAgents(testDir, [agent]);
  2038→
  2039→    const taskId = testUlid("TASK");
  2040→    await writeTasks(testDir, [{ _ulid: taskId, status: "completed" }]);
  2041→
  2042→    const engine = new DispatchEngine({
  2043→      projectDir: testDir,
  2044→      specDir: testDir,
  2045→      kspecCliPath: MOCK_KSPEC_CLI,
  2046→      reconcileIntervalMs: 0,
  2047→    });
  2048→
  2049→    const enqueueSpy = vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue");
  2050→    await engine.start();
  2051→
  2052→    // Neither bootstrap nor reconcile should enqueue completed tasks
  2053→    expect(enqueueSpy.mock.calls.length).toBe(0);
  2054→
  2055→    await (engine as unknown as { _reconcile: () => Promise<void> })._reconcile();
  2056→    expect(enqueueSpy.mock.calls.length).toBe(0);
  2057→
  2058→    await engine.stop();
  2059→  });
  2060→});
  2061→
