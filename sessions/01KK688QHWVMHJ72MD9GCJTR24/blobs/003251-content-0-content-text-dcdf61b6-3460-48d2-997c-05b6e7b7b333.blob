   318→// ─── AC-1: Matching agents queued for dispatch ────────────────────────────────
   319→
   320→// AC: @agent-dispatch-engine ac-1
   321→describe("AC-1: Task state change queues matching agents", () => {
   322→  let testDir: string;
   323→
   324→  beforeEach(async () => {
   325→    testDir = await createTempDir("kspec-dispatch-ac1-");
   326→  });
   327→
   328→  afterEach(async () => {
   329→    await cleanupTempDir(testDir);
   330→  });
   331→
   332→  it("should queue dispatch when state change matches agent dispatch rule", async () => {
   333→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   334→    await setupProjectWithAgents(testDir, [agent]);
   335→
   336→    const engine = new DispatchEngine({
   337→      projectDir: testDir,
   338→      specDir: testDir,
   339→      kspecCliPath: MOCK_KSPEC_CLI,
   340→    });
   341→
   342→    // Spy on _enqueue before start so all enqueue calls are captured
   343→    let enqueueCount = 0;
   344→    vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue").mockImplementation(() => {
   345→      enqueueCount++;
   346→    });
   347→
   348→    await engine.start();
   349→
   350→    // Trigger state change: task transitions to pending (task.ready)
   351→    const taskId = testUlid("TASK");
   352→    const change: TaskStateChange = {
   353→      taskId,
   354→      taskRef: `@${taskId}`,
   355→      fromStatus: "in_progress",
   356→      toStatus: "pending",
   357→      timestamp: Date.now(),
   358→    };
   359→    await engine.handleStateChange(change);
   360→
   361→    // Agent should have been enqueued
   362→    expect(enqueueCount).toBeGreaterThanOrEqual(1);
   363→
   364→    await engine.stop();
   365→  });
   366→});
   367→
   368→// ─── AC-2: Multiple matching agents queued independently ─────────────────────
   369→
   370→// AC: @agent-dispatch-engine ac-2
   371→describe("AC-2: Multiple matching agents queued independently", () => {
   372→  let testDir: string;
   373→
   374→  beforeEach(async () => {
   375→    testDir = await createTempDir("kspec-dispatch-ac2-");
   376→  });
   377→
   378→  afterEach(async () => {
   379→    await cleanupTempDir(testDir);
   380→  });
   381→
   382→  it("should queue each matching agent separately for the same state change", async () => {
   383→    const agent1 = makeTestAgent({ id: "worker-1", dispatch: [{ on: "task.ready" }] });
   384→    const agent2 = makeTestAgent({
   385→      _ulid: testUlid("AGNT", 2),
   386→      id: "worker-2",
   387→      dispatch: [{ on: "task.ready" }],
   388→    });
   389→    await setupProjectWithAgents(testDir, [agent1, agent2]);
   390→
   391→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   392→
   393→    // Track enqueue calls per agent
   394→    const enqueuedAgentIds: string[] = [];
   395→    vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue").mockImplementation((agent: unknown) => {
   396→      enqueuedAgentIds.push((agent as { id: string }).id);
   397→    });
   398→
   399→    await engine.start();
   400→    // Reset after bootstrap
   401→    enqueuedAgentIds.length = 0;
   402→
   403→    const change = makeStateChange({ toStatus: "pending", fromStatus: "in_progress" });
   404→    await engine.handleStateChange(change);
   405→
   406→    // Both agents should be enqueued independently
   407→    expect(enqueuedAgentIds).toContain("worker-1");
   408→    expect(enqueuedAgentIds).toContain("worker-2");
   409→    expect(enqueuedAgentIds).toHaveLength(2);
   410→
   411→    await engine.stop();
   412→  });
   413→});
