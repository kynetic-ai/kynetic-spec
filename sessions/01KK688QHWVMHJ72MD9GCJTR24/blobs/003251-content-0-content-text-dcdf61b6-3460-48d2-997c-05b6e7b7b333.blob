   837→// ─── AC-11: Graceful shutdown ─────────────────────────────────────────────────
   838→
   839→// AC: @agent-dispatch-engine ac-11
   840→describe("AC-11: Graceful shutdown waits for active invocations", () => {
   841→  let testDir: string;
   842→
   843→  beforeEach(async () => {
   844→    testDir = await createTempDir("kspec-dispatch-ac11-");
   845→  });
   846→
   847→  afterEach(async () => {
   848→    await cleanupTempDir(testDir);
   849→  });
   850→
   851→  it("should stop accepting new events after stop() is called", async () => {
   852→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   853→    await setupProjectWithAgents(testDir, [agent]);
   854→
   855→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   856→    await engine.start();
   857→
   858→    expect(engine.getStatus().running).toBe(true);
   859→
   860→    await engine.stop();
   861→
   862→    expect(engine.getStatus().running).toBe(false);
   863→
   864→    // Triggering changes after stop should be no-ops
   865→    let enqueueCount = 0;
   866→    vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue").mockImplementation(() => {
   867→      enqueueCount++;
   868→    });
   869→
   870→    const change = makeStateChange({ toStatus: "pending" });
   871→    await engine.handleStateChange(change);
   872→    expect(enqueueCount).toBe(0);
   873→  });
   874→
   875→  it("should resolve stop() only after running invocations complete", async () => {
   876→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   877→    await setupProjectWithAgents(testDir, [agent]);
   878→
   879→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   880→    await engine.start();
   881→
   882→    // Inject a fake long-running invocation
   883→    let invocationResolved = false;
   884→    const invocationPromise = new Promise<void>((resolve) => {
   885→      setTimeout(() => {
   886→        invocationResolved = true;
   887→        resolve();
   888→      }, 50);
   889→    });
   890→    (engine as unknown as { runningInvocations: Set<Promise<void>> }).runningInvocations.add(invocationPromise);
   891→
   892→    const stopStarted = Date.now();
   893→    await engine.stop();
   894→    const stopDuration = Date.now() - stopStarted;
   895→
   896→    // stop() should have waited for the invocation
   897→    expect(invocationResolved).toBe(true);
   898→    expect(stopDuration).toBeGreaterThanOrEqual(40);
   899→  });
   900→
   901→  it("should abort active invocations via abort controllers on stop()", async () => {
   902→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   903→    await setupProjectWithAgents(testDir, [agent]);
   904→
   905→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   906→    await engine.start();
   907→
   908→    // Inject a fake abort controller to verify it gets aborted
   909→    const fakeController = new AbortController();
   910→    let aborted = false;
   911→    fakeController.signal.addEventListener("abort", () => { aborted = true; });
   912→    (engine as unknown as { invocationAbortControllers: Set<AbortController> }).invocationAbortControllers.add(fakeController);
   913→
   914→    await engine.stop();
   915→
   916→    // Abort controller should have been signalled
   917→    expect(aborted).toBe(true);
   918→  });
   919→
   920→  it("should not start queued invocations if drain runs after stop()", async () => {
   921→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   922→    await setupProjectWithAgents(testDir, [agent]);
   923→
   924→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   925→    await engine.start();
   926→    await engine.stop();
   927→
   928→    const change = makeStateChange({ toStatus: "pending" });
   929→    const queueEntry = {
   930→      agent,
   931→      change,
   932→      retryCount: 0,
   933→      nextRetryAt: 0,
   934→      enqueuedAtMs: Date.now(),
   935→    };
   936→
   937→    const internal = engine as unknown as {
   938→      queues: Map<string, unknown[]>;
   939→      _drainQueues: (agents: unknown[]) => Promise<void>;
   940→    };
   941→    internal.queues.set(agent.id, [queueEntry]);
   942→
   943→    const spawnSpy = vi.spyOn(engine as unknown as { _spawnInvocation: (a: unknown, e: unknown) => boolean }, "_spawnInvocation");
   944→
   945→    await internal._drainQueues([agent]);
   946→
   947→    expect(spawnSpy).not.toHaveBeenCalled();
   948→    expect(internal.queues.get(agent.id)).toHaveLength(1);
   949→  });
   950→});
   951→
   952→// ─── AC-12: Shadow branch serialization ──────────────────────────────────────
   953→
   954→// AC: @agent-dispatch-engine ac-12
   955→describe("AC-12: Shadow branch mutations serialized via mutex", () => {
   956→  let testDir: string;
   957→
   958→  beforeEach(async () => {
   959→    testDir = await createTempDir("kspec-dispatch-ac12-");
   960→  });
   961→
   962→  afterEach(async () => {
   963→    await cleanupTempDir(testDir);
   964→  });
   965→
   966→  it("should provide a shadow mutex for exclusive access to shadow branch", async () => {
   967→    const agent = makeTestAgent();
   968→    await setupProjectWithAgents(testDir, [agent]);
   969→
   970→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   971→    await engine.start();
   972→
   973→    const mutex = engine.getShadowMutex();
   974→    expect(mutex).toBeDefined();
   975→    expect(typeof mutex.runExclusive).toBe("function");
   976→
   977→    await engine.stop();
   978→  });
   979→
   980→  it("should serialize concurrent operations through the mutex", async () => {
   981→    const agent = makeTestAgent();
   982→    await setupProjectWithAgents(testDir, [agent]);
   983→
   984→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   985→    await engine.start();
   986→
   987→    const mutex = engine.getShadowMutex();
   988→    const results: number[] = [];
   989→
   990→    // Run two concurrent operations through the mutex
   991→    await Promise.all([
   992→      mutex.runExclusive(async () => {
   993→        results.push(1);
   994→        await new Promise((r) => setTimeout(r, 10));
   995→        results.push(2);
   996→      }),
   997→      mutex.runExclusive(async () => {
   998→        results.push(3);
   999→        await new Promise((r) => setTimeout(r, 10));
  1000→        results.push(4);
  1001→      }),
  1002→    ]);
  1003→
  1004→    // Operations should be serialized: [1, 2, 3, 4] or [3, 4, 1, 2]
  1005→    expect(results).toHaveLength(4);
  1006→    // Verify the pairs are not interleaved
  1007→    const firstPair = results.slice(0, 2);
  1008→    const secondPair = results.slice(2, 4);
  1009→    const validOrdering =
  1010→      (firstPair[0] === 1 && firstPair[1] === 2 && secondPair[0] === 3 && secondPair[1] === 4) ||
  1011→      (firstPair[0] === 3 && firstPair[1] === 4 && secondPair[0] === 1 && secondPair[1] === 2);
  1012→    expect(validOrdering).toBe(true);
  1013→
  1014→    await engine.stop();
  1015→  });
  1016→});
  1017→
