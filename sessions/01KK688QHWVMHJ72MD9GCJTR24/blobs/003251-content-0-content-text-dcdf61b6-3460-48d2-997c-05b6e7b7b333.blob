   596→// ─── AC-7: Event deduplication ───────────────────────────────────────────────
   597→
   598→// AC: @agent-dispatch-engine ac-7
   599→describe("AC-7: Event deduplication within time window", () => {
   600→  let testDir: string;
   601→
   602→  beforeEach(async () => {
   603→    testDir = await createTempDir("kspec-dispatch-ac7-");
   604→  });
   605→
   606→  afterEach(async () => {
   607→    await cleanupTempDir(testDir);
   608→  });
   609→
   610→  it("should deduplicate identical state changes within dedup window", async () => {
   611→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   612→    await setupProjectWithAgents(testDir, [agent]);
   613→
   614→    const engine = new DispatchEngine({
   615→      projectDir: testDir,
   616→      specDir: testDir,
   617→      dedupWindowMs: 5000,
   618→      kspecCliPath: MOCK_KSPEC_CLI,
   619→    });
   620→
   621→    // Spy before start to capture all enqueue calls
   622→    let enqueueCount = 0;
   623→    vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue").mockImplementation(() => {
   624→      enqueueCount++;
   625→    });
   626→
   627→    await engine.start();
   628→    // Reset after bootstrap
   629→    enqueueCount = 0;
   630→
   631→    const now = Date.now();
   632→    const taskId = testUlid("TASK");
   633→    const change: TaskStateChange = {
   634→      taskId,
   635→      taskRef: `@${taskId}`,
   636→      fromStatus: "in_progress",
   637→      toStatus: "pending",
   638→      timestamp: now,
   639→    };
   640→
   641→    // First event — should be dispatched
   642→    await engine.handleStateChange(change);
   643→    expect(enqueueCount).toBe(1);
   644→
   645→    // Duplicate within window — should be suppressed
   646→    await engine.handleStateChange({ ...change, timestamp: now + 100 });
   647→    expect(enqueueCount).toBe(1);
   648→
   649→    await engine.stop();
   650→  });
   651→
   652→  it("should not deduplicate events outside the dedup window", async () => {
   653→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   654→    await setupProjectWithAgents(testDir, [agent]);
   655→
   656→    const engine = new DispatchEngine({
   657→      projectDir: testDir,
   658→      specDir: testDir,
   659→      dedupWindowMs: 100, // Very short window
   660→      kspecCliPath: MOCK_KSPEC_CLI,
   661→    });
   662→
   663→    // Spy before start
   664→    let enqueueCount = 0;
   665→    vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue").mockImplementation(() => {
   666→      enqueueCount++;
   667→    });
   668→
   669→    await engine.start();
   670→    // Reset after bootstrap
   671→    enqueueCount = 0;
   672→
   673→    const taskId = testUlid("TASK");
   674→    const now = Date.now();
   675→    const change: TaskStateChange = {
   676→      taskId,
   677→      taskRef: `@${taskId}`,
   678→      fromStatus: "in_progress",
   679→      toStatus: "pending",
   680→      timestamp: now,
   681→    };
   682→
   683→    await engine.handleStateChange(change);
   684→    expect(enqueueCount).toBe(1);
   685→
   686→    // After window expired — should be dispatched again
   687→    await engine.handleStateChange({ ...change, timestamp: now + 200 });
   688→    expect(enqueueCount).toBe(2);
   689→
   690→    await engine.stop();
   691→  });
   692→});
