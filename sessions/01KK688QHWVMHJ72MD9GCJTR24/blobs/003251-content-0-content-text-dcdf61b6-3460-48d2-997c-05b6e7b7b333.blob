   150→// ─── Dispatch In-Progress Priority ───────────────────────────────────────────
   151→
   152→describe("Dispatch in-progress priority", () => {
   153→  let testDir: string;
   154→
   155→  beforeEach(async () => {
   156→    testDir = await createTempDir("kspec-dispatch-in-progress-priority-");
   157→  });
   158→
   159→  afterEach(async () => {
   160→    await cleanupTempDir(testDir);
   161→  });
   162→
   163→  // AC: @dispatch-in-progress-priority ac-1
   164→  it("should prioritize in_progress entries ahead of pending/needs_work/pending_review", async () => {
   165→    const agent = makeTestAgent({
   166→      id: "priority-worker",
   167→      dispatch: [
   168→        { on: "task.in_progress" },
   169→        { on: "task.ready" },
   170→        { on: "task.needs_work" },
   171→        { on: "task.pending_review" },
   172→      ],
   173→      concurrency: { max_concurrent: 1 },
   174→    });
   175→    await setupProjectWithAgents(testDir, [agent]);
   176→
   177→    const engine = new DispatchEngine({
   178→      projectDir: testDir,
   179→      specDir: testDir,
   180→      kspecCliPath: MOCK_KSPEC_CLI,
   181→    });
   182→    await engine.start();
   183→
   184→    const internal = engine as unknown as {
   185→      activeCount: Map<string, number>;
   186→      queues: Map<string, Array<{ change: TaskStateChange }>>;
   187→    };
   188→
   189→    // Hold dispatching so we can inspect queue ordering.
   190→    internal.activeCount.set(agent.id, 1);
   191→
   192→    await engine.handleStateChange(
   193→      makeStateChange({
   194→        taskId: testUlid("TASK", 10),
   195→        taskRef: `@${testUlid("TASK", 10)}`,
   196→        fromStatus: "in_progress",
   197→        toStatus: "pending",
   198→      }),
   199→    );
   200→    await engine.handleStateChange(
   201→      makeStateChange({
   202→        taskId: testUlid("TASK", 11),
   203→        taskRef: `@${testUlid("TASK", 11)}`,
   204→        fromStatus: "pending_review",
   205→        toStatus: "needs_work",
   206→      }),
   207→    );
   208→    await engine.handleStateChange(
   209→      makeStateChange({
   210→        taskId: testUlid("TASK", 12),
   211→        taskRef: `@${testUlid("TASK", 12)}`,
   212→        fromStatus: "in_progress",
   213→        toStatus: "pending_review",
   214→      }),
   215→    );
   216→    await engine.handleStateChange(
   217→      makeStateChange({
   218→        taskId: testUlid("TASK", 13),
   219→        taskRef: `@${testUlid("TASK", 13)}`,
   220→        fromStatus: "pending",
   221→        toStatus: "in_progress",
   222→      }),
   223→    );
   224→
   225→    const queue = internal.queues.get(agent.id) ?? [];
   226→    expect(queue.map((entry) => entry.change.toStatus)).toEqual([
   227→      "in_progress",
   228→      "needs_work",
   229→      "pending",
   230→      "pending_review",
   231→    ]);
   232→
   233→    await engine.stop();
   234→  });
   235→
   236→  // AC: @dispatch-in-progress-priority ac-2
   237→  it("should enqueue existing in_progress tasks during bootstrap", async () => {
   238→    const agent = makeTestAgent({
   239→      id: "bootstrap-worker",
   240→      dispatch: [{ on: "task.in_progress" }],
   241→    });
   242→    await setupProjectWithAgents(testDir, [agent]);
   243→
   244→    const taskId = testUlid("TASK", 20);
   245→    await writeTasks(testDir, [{ _ulid: taskId, status: "in_progress" }]);
   246→
   247→    const engine = new DispatchEngine({
   248→      projectDir: testDir,
   249→      specDir: testDir,
   250→      kspecCliPath: MOCK_KSPEC_CLI,
   251→    });
   252→
   253→    let enqueueCount = 0;
   254→    vi.spyOn(
   255→      engine as unknown as { _enqueue: (a: unknown, c: unknown) => void },
   256→      "_enqueue",
   257→    ).mockImplementation(() => {
   258→      enqueueCount++;
   259→    });
   260→
   261→    await engine.start();
   262→    expect(enqueueCount).toBeGreaterThanOrEqual(1);
   263→
   264→    await engine.stop();
   265→  });
   266→
   267→  // AC: @dispatch-in-progress-priority ac-3
   268→  it("should match task.in_progress dispatch rules with automation filters", async () => {
   269→    const agent = makeTestAgent({
   270→      id: "filtered-worker",
   271→      dispatch: [{ on: "task.in_progress", filter: { automation: "eligible" } }],
   272→    });
   273→    await setupProjectWithAgents(testDir, [agent]);
   274→
   275→    const engine = new DispatchEngine({
   276→      projectDir: testDir,
   277→      specDir: testDir,
   278→      kspecCliPath: MOCK_KSPEC_CLI,
   279→    });
   280→
   281→    let enqueueCount = 0;
   282→    vi.spyOn(
   283→      engine as unknown as { _enqueue: (a: unknown, c: unknown) => void },
   284→      "_enqueue",
   285→    ).mockImplementation(() => {
   286→      enqueueCount++;
   287→    });
   288→
   289→    await engine.start();
   290→    enqueueCount = 0;
   291→
   292→    await engine.handleStateChange({
   293→      ...makeStateChange({
   294→        taskId: testUlid("TASK", 30),
   295→        taskRef: `@${testUlid("TASK", 30)}`,
   296→        fromStatus: "pending",
   297→        toStatus: "in_progress",
   298→      }),
   299→      task: { automation: "ineligible", tags: [] } as any,
   300→    });
   301→    expect(enqueueCount).toBe(0);
   302→
   303→    await engine.handleStateChange({
   304→      ...makeStateChange({
   305→        taskId: testUlid("TASK", 31),
   306→        taskRef: `@${testUlid("TASK", 31)}`,
   307→        fromStatus: "pending",
   308→        toStatus: "in_progress",
   309→      }),
   310→      task: { automation: "eligible", tags: [] } as any,
   311→    });
   312→    expect(enqueueCount).toBe(1);
   313→
   314→    await engine.stop();
   315→  });
   316→});
