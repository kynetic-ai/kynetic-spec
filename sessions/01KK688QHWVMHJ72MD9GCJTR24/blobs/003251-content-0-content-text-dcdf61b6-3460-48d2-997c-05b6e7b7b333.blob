  1631→// ─── Stale Queue Entry Discard ───────────────────────────────────────────────
  1632→
  1633→describe("Stale queue entry discard", () => {
  1634→  let testDir: string;
  1635→
  1636→  beforeEach(async () => {
  1637→    testDir = await createTempDir("kspec-dispatch-stale-");
  1638→  });
  1639→
  1640→  afterEach(async () => {
  1641→    vi.restoreAllMocks();
  1642→    await cleanupTempDir(testDir);
  1643→  });
  1644→
  1645→  // AC: @agent-dispatch-engine ac-17
  1646→  it("should discard queued entries when task has moved to a different state", async () => {
  1647→    const agent = makeTestAgent({
  1648→      id: "worker",
  1649→      dispatch: [{ on: "task.in_progress" }],
  1650→      concurrency: { max_concurrent: 1 },
  1651→    });
  1652→    await setupProjectWithAgents(testDir, [agent]);
  1653→
  1654→    const taskId = testUlid("TASK");
  1655→    // Task starts as in_progress
  1656→    await writeTasks(testDir, [{ _ulid: taskId, status: "in_progress" }]);
  1657→
  1658→    // Block runInvocation so the first invocation holds the slot
  1659→    let resolveFirst!: () => void;
  1660→    const firstBlock = new Promise<void>((r) => { resolveFirst = r; });
  1661→    const runSpy = vi.spyOn(invocationModule, "runInvocation")
  1662→      .mockImplementationOnce(async () => {
  1663→        await firstBlock;
  1664→        return { session: {} as any, outcome: "success" as const, durationMs: 1 };
  1665→      })
  1666→      .mockResolvedValue({
  1667→        session: {} as any,
  1668→        outcome: "success" as const,
  1669→        durationMs: 1,
  1670→      });
  1671→
  1672→    const engine = new DispatchEngine({
  1673→      projectDir: testDir,
  1674→      specDir: testDir,
  1675→      kspecCliPath: MOCK_KSPEC_CLI,
  1676→    });
  1677→
  1678→    await engine.start();
  1679→
  1680→    // First invocation is running (bootstrap picked up in_progress task)
  1681→    // Wait for first invocation to start
  1682→    for (let i = 0; i < 50 && runSpy.mock.calls.length === 0; i++) {
  1683→      await new Promise((r) => setTimeout(r, 5));
  1684→    }
  1685→    expect(runSpy).toHaveBeenCalledTimes(1);
  1686→
  1687→    // Enqueue another event for the same task while first is running
  1688→    await engine.handleStateChange({
  1689→      taskId,
  1690→      taskRef: `@${taskId}`,
  1691→      fromStatus: "pending",
  1692→      toStatus: "in_progress",
  1693→      timestamp: Date.now(),
  1694→    });
  1695→
  1696→    // Verify it was enqueued
  1697→    expect(engine.getStatus().queuedInvocations).toBe(1);
  1698→
  1699→    // Now update the task to completed (simulating the task finishing)
  1700→    await writeTasks(testDir, [{ _ulid: taskId, status: "completed" }]);
  1701→
  1702→    // Release the first invocation
  1703→    resolveFirst();
  1704→
  1705→    // Wait for drain to process
  1706→    await new Promise((r) => setTimeout(r, 200));
  1707→
  1708→    // The stale entry should have been discarded — only 1 invocation total
  1709→    expect(runSpy).toHaveBeenCalledTimes(1);
  1710→
  1711→    await engine.stop();
  1712→  });
  1713→
  1714→  // AC: @agent-dispatch-engine ac-17
  1715→  it("should keep queued entries when task state still matches", async () => {
  1716→    const agent = makeTestAgent({
  1717→      id: "worker",
  1718→      dispatch: [{ on: "task.in_progress" }],
  1719→      concurrency: { max_concurrent: 1 },
  1720→    });
  1721→    await setupProjectWithAgents(testDir, [agent]);
  1722→
  1723→    const [taskId1, taskId2] = testUlids("TASK", 2);
  1724→    // Both tasks in_progress
  1725→    await writeTasks(testDir, [
  1726→      { _ulid: taskId1, status: "in_progress" },
  1727→      { _ulid: taskId2, status: "in_progress" },
  1728→    ]);
  1729→
  1730→    // Block first invocation
  1731→    let resolveFirst!: () => void;
  1732→    const firstBlock = new Promise<void>((r) => { resolveFirst = r; });
  1733→    const runSpy = vi.spyOn(invocationModule, "runInvocation")
  1734→      .mockImplementationOnce(async () => {
  1735→        await firstBlock;
  1736→        return { session: {} as any, outcome: "success" as const, durationMs: 1 };
  1737→      })
  1738→      .mockResolvedValue({
  1739→        session: {} as any,
  1740→        outcome: "success" as const,
  1741→        durationMs: 1,
  1742→      });
  1743→
  1744→    const engine = new DispatchEngine({
  1745→      projectDir: testDir,
  1746→      specDir: testDir,
  1747→      kspecCliPath: MOCK_KSPEC_CLI,
  1748→    });
  1749→
  1750→    await engine.start();
  1751→
  1752→    // Wait for bootstrap to fire first invocation
  1753→    for (let i = 0; i < 50 && runSpy.mock.calls.length === 0; i++) {
  1754→      await new Promise((r) => setTimeout(r, 5));
  1755→    }
  1756→    expect(runSpy).toHaveBeenCalledTimes(1);
  1757→
  1758→    // task2 is still in_progress — its queue entry should survive
  1759→    expect(engine.getStatus().queuedInvocations).toBeGreaterThanOrEqual(1);
  1760→
  1761→    // Release first invocation
  1762→    resolveFirst();
  1763→
  1764→    // Wait for second invocation to start
  1765→    for (let i = 0; i < 50 && runSpy.mock.calls.length < 2; i++) {
  1766→      await new Promise((r) => setTimeout(r, 10));
  1767→    }
  1768→
  1769→    // Second invocation should have been spawned (task2 still in_progress)
  1770→    expect(runSpy).toHaveBeenCalledTimes(2);
  1771→
  1772→    await engine.stop();
  1773→  });
  1774→
  1775→  // AC: @agent-dispatch-engine ac-17
  1776→  it("should discard queued entries when task has been deleted", async () => {
  1777→    const agent = makeTestAgent({
  1778→      id: "worker",
  1779→      dispatch: [{ on: "task.in_progress" }],
  1780→      concurrency: { max_concurrent: 1 },
  1781→    });
  1782→    await setupProjectWithAgents(testDir, [agent]);
  1783→
  1784→    const taskId = testUlid("TASK");
  1785→    await writeTasks(testDir, [{ _ulid: taskId, status: "in_progress" }]);
  1786→
  1787→    // Block first invocation
  1788→    let resolveFirst!: () => void;
  1789→    const firstBlock = new Promise<void>((r) => { resolveFirst = r; });
  1790→    const runSpy = vi.spyOn(invocationModule, "runInvocation")
  1791→      .mockImplementationOnce(async () => {
  1792→        await firstBlock;
  1793→        return { session: {} as any, outcome: "success" as const, durationMs: 1 };
  1794→      })
  1795→      .mockResolvedValue({
  1796→        session: {} as any,
  1797→        outcome: "success" as const,
  1798→        durationMs: 1,
  1799→      });
  1800→
  1801→    const engine = new DispatchEngine({
  1802→      projectDir: testDir,
  1803→      specDir: testDir,
  1804→      kspecCliPath: MOCK_KSPEC_CLI,
  1805→    });
  1806→
  1807→    await engine.start();
  1808→
  1809→    for (let i = 0; i < 50 && runSpy.mock.calls.length === 0; i++) {
  1810→      await new Promise((r) => setTimeout(r, 5));
  1811→    }
  1812→    expect(runSpy).toHaveBeenCalledTimes(1);
  1813→
  1814→    // Enqueue another event while first is running
  1815→    await engine.handleStateChange({
  1816→      taskId,
  1817→      taskRef: `@${taskId}`,
  1818→      fromStatus: "pending",
  1819→      toStatus: "in_progress",
  1820→      timestamp: Date.now(),
  1821→    });
  1822→
  1823→    expect(engine.getStatus().queuedInvocations).toBe(1);
  1824→
  1825→    // Delete the task (write empty tasks list)
  1826→    await writeTasks(testDir, []);
  1827→
  1828→    // Release first invocation
  1829→    resolveFirst();
  1830→    await new Promise((r) => setTimeout(r, 200));
  1831→
  1832→    // Entry for deleted task should have been discarded
  1833→    expect(runSpy).toHaveBeenCalledTimes(1);
  1834→
  1835→    await engine.stop();
  1836→  });
  1837→});
