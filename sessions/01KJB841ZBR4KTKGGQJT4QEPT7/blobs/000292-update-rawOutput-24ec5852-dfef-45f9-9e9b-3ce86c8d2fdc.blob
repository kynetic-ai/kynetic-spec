   482→  // AC: @agent-templates ac-1 through ac-3
   483→  describe('Agent Template System', () => {
   484→    // AC: @agent-templates ac-1
   485→    describe('ac-1: template sections included in defined order', () => {
   486→      it('should include all template sections in the generated output', async () => {
   487→        const result = kspecFull('agents generate', tempDir);
   488→        expect(result.exitCode).toBe(0);
   489→
   490→        const filePath = path.join(tempDir, 'kspec-agents.md');
   491→        const content = await fs.readFile(filePath, 'utf-8');
   492→
   493→        // Verify template sections are present
   494→        expect(content).toContain('## Quick Start');
   495→        expect(content).toContain('## Shadow Branch Architecture');
   496→        expect(content).toContain('## Task Lifecycle');
   497→        expect(content).toContain('## PR Workflow');
   498→        expect(content).toContain('## Commit Convention');
   499→        expect(content).toContain('## Ralph Loop Mode');
   500→      });
   501→
   502→      it('should include templates in file order (sorted by prefix)', async () => {
   503→        kspecFull('agents generate', tempDir);
   504→
   505→        const filePath = path.join(tempDir, 'kspec-agents.md');
   506→        const content = await fs.readFile(filePath, 'utf-8');
   507→
   508→        // Verify order: Quick Start before Shadow Branch before Task Lifecycle
   509→        const quickStartPos = content.indexOf('## Quick Start');
   510→        const shadowBranchPos = content.indexOf('## Shadow Branch Architecture');
   511→        const taskLifecyclePos = content.indexOf('## Task Lifecycle');
   512→        const prWorkflowPos = content.indexOf('## PR Workflow');
   513→        const commitConventionPos = content.indexOf('## Commit Convention');
   514→        const ralphLoopPos = content.indexOf('## Ralph Loop Mode');
   515→
   516→        expect(quickStartPos).toBeLessThan(shadowBranchPos);
   517→        expect(shadowBranchPos).toBeLessThan(taskLifecyclePos);
   518→        expect(taskLifecyclePos).toBeLessThan(prWorkflowPos);
   519→        expect(prWorkflowPos).toBeLessThan(commitConventionPos);
   520→        expect(commitConventionPos).toBeLessThan(ralphLoopPos);
   521→      });
   522→    });
   523→
   524→    // AC: @agent-templates ac-2
   525→    describe('ac-2: each template section appears in generated output', () => {
   526→      it('should include quick-start template content', async () => {
   527→        kspecFull('agents generate', tempDir);
   528→
   529→        const filePath = path.join(tempDir, 'kspec-agents.md');
   530→        const content = await fs.readFile(filePath, 'utf-8');
   531→
   532→        // Verify quick-start specific content (generic, not kspec-repo-specific)
   533→        expect(content).toContain('kspec init');
   534→        expect(content).toContain('kspec setup');
   535→        expect(content).toContain('kspec session start');
   536→        expect(content).toContain('kspec shadow status');
   537→        expect(content).toContain('Essential Rules');
   538→        // Should NOT contain kspec-repo-specific commands
   539→        expect(content).not.toContain('bootstrap.cjs');
   540→        expect(content).not.toContain('npm run dev');
   541→      });
   542→
   543→      it('should include shadow-branch template content', async () => {
   544→        kspecFull('agents generate', tempDir);
   545→
   546→        const filePath = path.join(tempDir, 'kspec-agents.md');
   547→        const content = await fs.readFile(filePath, 'utf-8');
   548→
