     1→/**
     2→ * Agent instruction generation commands.
     3→ *
     4→ * AC: @agent-instruction-gen ac-1 - kspec agents generate creates kspec-agents.md in project root
     5→ * AC: @agent-instruction-gen ac-2 - output includes Finding Information table with row per skill
     6→ * AC: @agent-instruction-gen ac-3 - output includes conventions section listing rules by domain
     7→ * AC: @agent-instruction-gen ac-4 - output contains freshness comment with kspec version and timestamp
     8→ * AC: @agent-instruction-gen ac-5 - kspec agents status reports stale when not regenerated after meta changes
     9→ *
    10→ * AC: @agents-cli ac-1 - kspec agents generate writes kspec-agents.md to project root
    11→ * AC: @agents-cli ac-2 - kspec agents generate --dry-run prints content without writing
    12→ * AC: @agents-cli ac-3 - kspec agents status reports up to date when current
    13→ * AC: @agents-cli ac-4 - kspec agents status reports stale when meta changed
    14→ *
    15→ * AC: @agent-templates ac-1 - template sections included in output in defined order
    16→ * AC: @agent-templates ac-2 - each template section appears in generated output
    17→ * AC: @agent-templates ac-3 - error if template directory missing or empty
    18→ */
    19→
    20→import * as crypto from "node:crypto";
    21→import * as fs from "node:fs/promises";
    22→import { createRequire } from "node:module";
    23→import * as path from "node:path";
    24→import { fileURLToPath } from "node:url";
    25→import chalk from "chalk";
    26→import type { Command } from "commander";
    27→import {
    28→  generateConventionsSummary,
    29→  generateSkillsTable,
    30→  generateWorkflowsSummary,
    31→  initContext,
    32→  loadMetaContext,
    33→  type LoadedConvention,
    34→  type LoadedSkill,
    35→  type LoadedWorkflow,
    36→} from "../../parser/index.js";
    37→import { errors } from "../../strings/errors.js";
    38→import { EXIT_CODES } from "../exit-codes.js";
    39→import { error, output, success } from "../output.js";
    40→
    41→const __filename = fileURLToPath(import.meta.url);
    42→const __dirname = path.dirname(__filename);
    43→
    44→// Read version from package.json at runtime
    45→const require = createRequire(import.meta.url);
    46→const { version } = require("../../../package.json");
    47→
    48→/**
    49→ * File name for generated agent instructions
    50→ */
    51→const GENERATED_FILE_NAME = "kspec-agents.md";
    52→
    53→/**
    54→ * Hash file name for tracking freshness
    55→ */
    56→const HASH_FILE_NAME = ".kspec-agents-hash";
    57→
    58→/**
    59→ * Templates directory name relative to package root
    60→ */
    61→const TEMPLATES_DIR = "templates/agents-sections";
    62→
    63→/**
    64→ * Compute SHA256 hash of content
    65→ */
    66→function computeHash(content: string): string {
    67→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
    68→}
    69→
    70→/**
    71→ * Load template sections from the templates directory.
    72→ * AC: @agent-templates ac-1 - all template sections included in defined order
    73→ * AC: @agent-templates ac-3 - error if directory missing or empty
    74→ */
    75→export async function loadTemplateSections(packageRoot: string): Promise<string[]> {
    76→  const templatesPath = path.join(packageRoot, TEMPLATES_DIR);
    77→
    78→  // Check if templates directory exists
    79→  try {
    80→    await fs.access(templatesPath);
    81→  } catch {
    82→    throw new Error(
    83→      `Templates directory not found at: ${templatesPath}. ` +
    84→        `Expected templates/agents-sections/ directory with section markdown files.`,
    85→    );
    86→  }
    87→
    88→  // Read directory contents
    89→  const entries = await fs.readdir(templatesPath, { withFileTypes: true });
    90→  const mdFiles = entries
    91→    .filter((e) => e.isFile() && e.name.endsWith(".md"))
    92→    .map((e) => e.name)
    93→    .sort(); // Sort to ensure consistent ordering by filename prefix
    94→
    95→  if (mdFiles.length === 0) {
    96→    throw new Error(
    97→      `Templates directory is empty: ${templatesPath}. ` +
    98→        `Expected markdown files for agent instruction sections.`,
    99→    );
   100→  }
   101→
   102→  // Load each template in order
   103→  const sections: string[] = [];
   104→  for (const filename of mdFiles) {
   105→    const filePath = path.join(templatesPath, filename);
   106→    const content = await fs.readFile(filePath, "utf-8");
   107→    sections.push(content.trim());
   108→  }
   109→
   110→  return sections;
   111→}
   112→
   113→/**
   114→ * Get the package root directory (where templates/ is located)
   115→ */
   116→export function getPackageRoot(): string {
   117→  // Navigate from dist/cli/commands/ to package root
   118→  return path.resolve(__dirname, "..", "..", "..");
   119→}
   120→
   121→/**
   122→ * Generate a hash of the meta content that affects the generated file.
   123→ * This is used to detect if the generated file is stale.
   124→ */
   125→export function computeMetaHash(
   126→  skills: LoadedSkill[],
   127→  conventions: LoadedConvention[],
   128→  workflows: LoadedWorkflow[],
   129→  templateSections?: string[],
   130→): string {
   131→  // Create a stable representation of the meta content
   132→  // AC: @cross-platform-and-version-robustness ac-4 - includes templates for staleness detection
   133→  const data: Record<string, unknown> = {
   134→    skills: skills.map((s) => ({
   135→      id: s.id,
   136→      name: s.name,
   137→      description: s.description,
   138→    })),
   139→    conventions: conventions.map((c) => ({
   140→      domain: c.domain,
   141→      rules: c.rules,
   142→      examples: (c.examples ?? []).map((e) => ({ good: e.good, bad: e.bad })),
   143→    })),
   144→    workflows: workflows.map((w) => ({
   145→      id: w.id,
   146→      trigger: w.trigger,
   147→      description: w.description,
   148→    })),
   149→  };
   150→  if (templateSections && templateSections.length > 0) {
   151→    data.templates = templateSections;
   152→  }
   153→  return computeHash(JSON.stringify(data));
   154→}
   155→
   156→/**
   157→ * Generate the freshness comment.
   158→ * AC: @agent-instruction-gen ac-4 - freshness comment with kspec version and timestamp
   159→ */
   160→function generateFreshnessComment(timestamp: string): string {
   161→  return `<!-- Generated by kspec v${version} at ${timestamp} -->\n<!-- Do not edit manually - regenerate with: kspec agents generate -->\n\n`;
   162→}
   163→
   164→/**
   165→ * Generate the full kspec-agents.md content
   166→ * AC: @agent-templates ac-1 - template sections included in output in defined order
   167→ * AC: @agent-templates ac-2 - each template section appears in generated output
   168→ */
   169→export async function generateAgentsContent(
   170→  skills: LoadedSkill[],
   171→  conventions: LoadedConvention[],
   172→  workflows: LoadedWorkflow[],
   173→  timestamp: string,
   174→  templateSections: string[],
   175→): Promise<string> {
   176→  const sections: string[] = [];
   177→
   178→  // AC: @agent-instruction-gen ac-4 - freshness comment
   179→  sections.push(generateFreshnessComment(timestamp));
   180→
   181→  // Header
   182→  sections.push("# kspec Agent Instructions\n");
   183→  sections.push(
   184→    "This file is auto-generated from kspec meta. Include it in your AGENTS.md or similar agent instruction file.\n\n",
   185→  );
   186→
   187→  // AC: @agent-instruction-gen ac-2 - Skills table
   188→  // AC: @agent-instruction-gen ac-3 - Conventions section
   189→  // Ensure blank line between each data section for valid markdown
   190→  const dataSections = [
   191→    generateSkillsTable(skills),
   192→    generateConventionsSummary(conventions),
   193→    generateWorkflowsSummary(workflows),
   194→  ].filter(Boolean);
   195→
   196→  for (const section of dataSections) {
   197→    // Ensure each section is preceded by a blank line
   198→    if (!sections[sections.length - 1]?.endsWith("\n\n")) {
   199→      sections.push("\n");
   200→    }
   201→    sections.push(section);
   202→  }
   203→
   204→  // AC: @agent-templates ac-1, ac-2 - Include template sections in order
   205→  if (templateSections.length > 0) {
   206→    sections.push("\n");
   207→    for (const section of templateSections) {
   208→      sections.push(section);
   209→      sections.push("\n\n");
   210→    }
   211→  }
   212→
   213→  return sections.join("");
   214→}
   215→
   216→/**
   217→ * Result of checking agent file status
   218→ */
   219→interface AgentStatusResult {
   220→  exists: boolean;
   221→  path: string;
   222→  status: "current" | "stale" | "missing";
   223→  metaHash?: string;
   224→  storedHash?: string;
   225→  generatedAt?: string;
   226→}
   227→
   228→/**
   229→ * Check the status of the generated agent file.
   230→ * AC: @agent-instruction-gen ac-5 - reports stale when meta has changed
   231→ */
   232→async function checkAgentStatus(
   233→  projectRoot: string,
   234→  metaHash: string,
   235→): Promise<AgentStatusResult> {
   236→  const filePath = path.join(projectRoot, GENERATED_FILE_NAME);
   237→  const hashPath = path.join(projectRoot, ".kspec", HASH_FILE_NAME);
   238→
   239→  // Check if file exists
   240→  try {
   241→    await fs.access(filePath);
   242→  } catch {
   243→    return {
   244→      exists: false,
   245→      path: filePath,
   246→      status: "missing",
   247→      metaHash,
   248→    };
   249→  }
   250→
   251→  // Check stored hash
   252→  let storedHash: string | undefined;
   253→  let generatedAt: string | undefined;
   254→
   255→  try {
   256→    const hashContent = await fs.readFile(hashPath, "utf-8");
   257→    const hashData = JSON.parse(hashContent);
   258→    storedHash = hashData.metaHash;
   259→    generatedAt = hashData.generatedAt;
   260→  } catch {
   261→    // No hash file, treat as stale
   262→    return {
   263→      exists: true,
   264→      path: filePath,
   265→      status: "stale",
   266→      metaHash,
   267→    };
   268→  }
   269→
   270→  // Compare hashes
   271→  const isCurrent = storedHash === metaHash;
   272→
   273→  return {
   274→    exists: true,
   275→    path: filePath,
   276→    status: isCurrent ? "current" : "stale",
   277→    metaHash,
   278→    storedHash,
   279→    generatedAt,
   280→  };
   281→}
   282→
   283→/**
   284→ * Register agent instruction generation commands
   285→ */
   286→export function registerAgentsCommands(program: Command): void {
   287→  const agents = program
   288→    .command("agents")
   289→    .description("Agent instruction generation commands");
   290→
   291→  // AC: @agent-instruction-gen ac-1 - kspec agents generate
   292→  // AC: @agent-templates ac-3 - error if template directory missing
   293→  // AC: @trait-dry-run ac-1 through ac-6 - dry-run support
   294→  agents
   295→    .command("generate")
   296→    .description("Generate kspec-agents.md from meta (skills, conventions, workflows)")
   297→    .option("--dry-run", "Show what would be generated without writing files")
   298→    .action(async (options) => {
   299→      try {
   300→        const ctx = await initContext();
   301→
   302→        if (!ctx.manifestPath) {
   303→          error(errors.project.noKspecProject);
   304→          process.exit(EXIT_CODES.ERROR);
   305→        }
   306→
   307→        // AC: @agent-templates ac-3 - error if templates missing
   308→        const packageRoot = getPackageRoot();
   309→        let templateSections: string[];
   310→        try {
   311→          templateSections = await loadTemplateSections(packageRoot);
   312→        } catch (err) {
   313→          const message =
   314→            err instanceof Error ? err.message : "Unknown error loading templates";
   315→          error(message, {
   316→            suggestion: `Verify that ${TEMPLATES_DIR}/ exists with markdown files.`,
   317→          });
   318→          process.exit(EXIT_CODES.ERROR);
   319→        }
   320→
   321→        const metaCtx = await loadMetaContext(ctx);
   322→        const dryRun = options.dryRun || false;
   323→        const timestamp = new Date().toISOString();
   324→
   325→        // Generate content - now async due to template loading
   326→        const content = await generateAgentsContent(
   327→          metaCtx.skills,
   328→          metaCtx.conventions,
   329→          metaCtx.workflows,
   330→          timestamp,
   331→          templateSections,
   332→        );
   333→
   334→        // Compute meta hash for freshness tracking (includes templates)
   335→        const metaHash = computeMetaHash(
   336→          metaCtx.skills,
   337→          metaCtx.conventions,
   338→          metaCtx.workflows,
   339→          templateSections,
   340→        );
   341→
   342→        const outputPath = path.join(ctx.rootDir, GENERATED_FILE_NAME);
   343→        const hashPath = path.join(ctx.rootDir, ".kspec", HASH_FILE_NAME);
   344→
   345→        // AC: @agent-instruction-gen ac-6 - skip regeneration when content unchanged
   346→        if (!dryRun) {
   347→          const status = await checkAgentStatus(ctx.rootDir, metaHash);
   348→          if (status.status === "current") {
   349→            output(
   350→              {
   351→                path: outputPath,
   352→                status: "current",
   353→                skipped: true,
   354→              },
   355→              () => {
   356→                success(`${GENERATED_FILE_NAME} is already up to date`);
   357→              },
   358→            );
   359→            return;
   360→          }
   361→        }
   362→
   363→        // AC: @trait-dry-run ac-3 - clear indication this is a preview
   364→        if (dryRun) {
   365→          output(
   366→            {
   367→              dry_run: true,
   368→              path: outputPath,
   369→              skills: metaCtx.skills.length,
   370→              conventions: metaCtx.conventions.length,
   371→              workflows: metaCtx.workflows.length,
   372→              templates: templateSections.length,
   373→              content,
   374→            },
   375→            () => {
   376→              console.log(chalk.yellow("DRY RUN - No changes made"));
   377→              console.log();
   378→              console.log(chalk.gray(`Would write to: ${outputPath}`));
   379→              console.log();
   380→              console.log(chalk.gray("--- Generated content ---"));
   381→              console.log(content);
   382→              console.log(chalk.gray("--- End content ---"));
   383→              console.log();
   384→              console.log(
   385→                chalk.yellow("No changes were made. Run without --dry-run to apply."),
   386→              );
   387→            },
   388→          );
   389→          return;
   390→        }
   391→
   392→        // AC: @trait-dry-run ac-2 - no files modified in dry run mode
   393→        // Write the generated file
   394→        await fs.writeFile(outputPath, content, "utf-8");
   395→
   396→        // Write the hash file for freshness tracking
   397→        await fs.mkdir(path.dirname(hashPath), { recursive: true });
   398→        await fs.writeFile(
   399→          hashPath,
   400→          JSON.stringify(
   401→            {
   402→              metaHash,
   403→              generatedAt: timestamp,
   404→              version,
   405→            },
   406→            null,
   407→            2,
   408→          ),
   409→          "utf-8",
   410→        );
   411→
   412→        output(
   413→          {
   414→            path: outputPath,
   415→            skills: metaCtx.skills.length,
   416→            conventions: metaCtx.conventions.length,
   417→            workflows: metaCtx.workflows.length,
   418→            templates: templateSections.length,
   419→            generatedAt: timestamp,
   420→          },
   421→          () => {
   422→            success(`Generated ${GENERATED_FILE_NAME}`, {
   423→              skills: metaCtx.skills.length,
   424→              conventions: metaCtx.conventions.length,
   425→              workflows: metaCtx.workflows.length,
   426→              templates: templateSections.length,
   427→            });
   428→            console.log(chalk.gray(`  Path: ${outputPath}`));
   429→          },
   430→        );
   431→      } catch (err) {
   432→        error("Failed to generate agent instructions", err);
   433→        process.exit(EXIT_CODES.ERROR);
   434→      }
   435→    });
   436→
   437→  // AC: @agent-instruction-gen ac-5 - kspec agents status
   438→  agents
   439→    .command("status")
   440→    .description("Check if kspec-agents.md is up to date with meta")
   441→    .action(async () => {
   442→      try {
   443→        const ctx = await initContext();
   444→
   445→        if (!ctx.manifestPath) {
   446→          error(errors.project.noKspecProject);
   447→          process.exit(EXIT_CODES.ERROR);
   448→        }
   449→
   450→        const metaCtx = await loadMetaContext(ctx);
   451→
   452→        // Load templates for hash computation
   453→        let templateSections: string[] = [];
   454→        try {
   455→          templateSections = await loadTemplateSections(getPackageRoot());
   456→        } catch (_err) {
   457→          // Templates may not exist in all environments
   458→        }
   459→
   460→        // Compute current meta hash (includes templates)
   461→        const metaHash = computeMetaHash(
   462→          metaCtx.skills,
   463→          metaCtx.conventions,
   464→          metaCtx.workflows,
   465→          templateSections,
   466→        );
   467→
   468→        const status = await checkAgentStatus(ctx.rootDir, metaHash);
   469→
   470→        output(status, () => {
   471→          switch (status.status) {
   472→            case "missing":
   473→              console.log(chalk.yellow(`${GENERATED_FILE_NAME} does not exist`));
   474→              console.log();
   475→              console.log(
   476→                chalk.gray("Run 'kspec agents generate' to create it."),
   477→              );
   478→              break;
   479→
   480→            case "stale":
   481→              console.log(
   482→                chalk.yellow(`${GENERATED_FILE_NAME} is stale`),
   483→              );
   484→              console.log();
   485→              console.log(
   486→                chalk.gray(
   487→                  "Meta has changed since the file was generated.",
   488→                ),
   489→              );
   490→              console.log(
   491→                chalk.gray("Run 'kspec agents generate' to regenerate."),
   492→              );
   493→              break;
   494→
   495→            case "current":
   496→              console.log(chalk.green(`${GENERATED_FILE_NAME} is up to date`));
   497→              if (status.generatedAt) {
   498→                console.log(chalk.gray(`  Generated: ${status.generatedAt}`));
   499→              }
   500→              break;
   501→          }
   502→        });
   503→      } catch (err) {
   504→        error("Failed to check agent status", err);
   505→        process.exit(EXIT_CODES.ERROR);
   506→      }
   507→    });
   508→}
   509→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
