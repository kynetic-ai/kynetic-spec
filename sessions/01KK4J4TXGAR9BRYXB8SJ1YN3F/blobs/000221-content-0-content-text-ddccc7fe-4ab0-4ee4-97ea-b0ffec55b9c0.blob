```
     1→<script lang="ts">
     2→	// AC: @web-dashboard ac-4, ac-5, ac-9, ac-10, ac-33
     3→	// AC: @multi-directory-daemon ac-27 - Reload on project change
     4→	// AC: @gh-pages-export ac-16 - Disable Start Task in static mode
     5→	import { page } from '$app/stores';
     6→	import { base } from '$app/paths';
     7→	import { onMount, onDestroy, flushSync } from 'svelte';
     8→	import type { TaskSummary, TaskDetail, BroadcastEvent } from '@kynetic-ai/shared';
     9→	import TaskFilters from '$lib/components/TaskFilters.svelte';
    10→	import TaskList from '$lib/components/TaskList.svelte';
    11→	import { fetchTasks, fetchTask, startTask, addTaskNote } from '$lib/api';
    12→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    13→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    14→	import { Button } from '$lib/components/ui/button';
    15→	import { Badge } from '$lib/components/ui/badge';
    16→	import { Textarea } from '$lib/components/ui/textarea';
    17→	import { Separator } from '$lib/components/ui/separator';
    18→	import * as Tooltip from '$lib/components/ui/tooltip';
    19→	import XIcon from '@lucide/svelte/icons/x';
    20→	import LayoutGrid from '@lucide/svelte/icons/layout-grid';
    21→	import ListIcon from '@lucide/svelte/icons/list';
    22→	import { getProjectVersion, isInitialized as isProjectInitialized } from '$lib/stores/project.svelte';
    23→
    24→	let tasks = $state<TaskSummary[]>([]);
    25→	let total = $state(0);
    26→	let loading = $state(true);
    27→	let error = $state('');
    28→	let updatedTaskIds = $state<Set<string>>(new Set());
    29→
    30→	// Use $state with an object for panel state to ensure deep reactivity
    31→	let panel = $state<{ open: boolean; task: TaskDetail | null }>({
    32→		open: false,
    33→		task: null
    34→	});
    35→
    36→	let noteContent = $state('');
    37→	let isSubmitting = $state(false);
    38→	let panelError = $state('');
    39→
    40→	// Reactive: re-fetch when URL params change
    41→	let filterParams = $derived({
    42→		status: $page.url.searchParams.get('status') || undefined,
    43→		type: $page.url.searchParams.get('type') || undefined,
    44→		tag: $page.url.searchParams.get('tag') || undefined,
    45→		assignee: $page.url.searchParams.get('assignee') || undefined,
    46→		automation: $page.url.searchParams.get('automation') || undefined,
    47→		plan: $page.url.searchParams.get('plan') || undefined,
    48→		limit: 50,
    49→		offset: 0
    50→	});
    51→
    52→	// Track the last processed ref to avoid infinite loops
    53→	let lastProcessedRef = $state('');
    54→
    55→	// Re-fetch when filterParams change or project changes.
    56→	// Gates on isProjectInitialized() to prevent loading with wrong/missing project context.
    57→	// AC: @multi-directory-daemon ac-27 - Reload data when project changes
    58→	$effect(() => {
    59→		// Explicitly access all filter properties for dependency tracking
    60→		const { status, type, tag, assignee, automation, plan, limit, offset } = filterParams;
    61→		const version = getProjectVersion();
    62→		const ready = isProjectInitialized();
    63→		if (!ready) return;
    64→		loadTasks();
    65→	});
    66→
    67→	// AC: Open task detail when URL has ref param
    68→	$effect(() => {
    69→		const urlRef = $page.url.searchParams.get('ref');
    70→		if (urlRef && urlRef !== lastProcessedRef) {
    71→			lastProcessedRef = urlRef;
    72→			handleSelectTask(urlRef);
    73→		}
    74→	});
    75→
    76→	async function loadTasks() {
    77→		loading = true;
    78→		error = '';
    79→
    80→		try {
    81→			const response = await fetchTasks(filterParams);
    82→			tasks = response.items;
    83→			total = response.total;
    84→		} catch (err) {
    85→			error = err instanceof Error ? err.message : 'Failed to load tasks';
    86→			console.error('Error loading tasks:', err);
    87→		} finally {
    88→			loading = false;
    89→		}
    90→	}
    91→
    92→	async function handleSelectTask(taskId: string) {
    93→		console.log('[TasksPage] handleSelectTask called for:', taskId);
    94→		try {
    95→			console.log('[TasksPage] Fetching task details...');
    96→			const task = await fetchTask(taskId);
    97→			console.log('[TasksPage] Task fetched:', task?.title);
    98→			// Update panel state using flushSync to ensure synchronous DOM update
    99→			flushSync(() => {
   100→				panel.task = task;
   101→				panel.open = true;
   102→			});
   103→			console.log('[TasksPage] panel.open set to true, panel.task:', panel.task?.title);
   104→		} catch (err) {
   105→			error = err instanceof Error ? err.message : 'Failed to load task details';
   106→			console.error('[TasksPage] Error loading task:', err);
   107→		}
   108→	}
   109→
   110→	// Legacy event handler for backwards compatibility
   111→	function handleSelectTaskEvent(event: CustomEvent<string>) {
   112→		handleSelectTask(event.detail);
   113→	}
   114→
   115→	function handleCloseDetail() {
   116→		panel.open = false;
   117→		panel.task = null;
   118→		noteContent = '';
   119→		panelError = '';
   120→		lastProcessedRef = ''; // Reset so we can reopen same task if URL param set again
   121→	}
   122→
   123→	// Handle clicking outside the panel
   124→	function handleOverlayClick(e: MouseEvent) {
   125→		if (e.target === e.currentTarget) {
   126→			handleCloseDetail();
   127→		}
   128→	}
   129→
   130→	// Handle escape key
   131→	function handleKeydown(e: KeyboardEvent) {
   132→		if (e.key === 'Escape' && panel.open) {
   133→			handleCloseDetail();
   134→		}
   135→	}
   136→
   137→	async function handleStartTask() {
   138→		if (!panel.task) return;
   139→
   140→		// AC: @gh-pages-export ac-16, ac-18 - Check static mode
   141→		if (isStaticMode()) {
   142→			panelError = 'Cannot start task in read-only mode. Use the kspec CLI.';
   143→			return;
   144→		}
   145→
   146→		isSubmitting = true;
   147→		panelError = '';
   148→
   149→		try {
   150→			await startTask(panel.task._ulid);
   151→			// Reload task to get updated status
   152→			const updated = await fetchTask(panel.task._ulid);
   153→			panel.task = updated;
   154→			loadTasks();
   155→		} catch (err) {
   156→			// AC: @gh-pages-export ac-18 - Graceful error message
   157→			if (err instanceof ReadOnlyModeError) {
   158→				panelError = err.message;
   159→			} else {
   160→				panelError = err instanceof Error ? err.message : 'Failed to start task';
   161→			}
   162→		} finally {
   163→			isSubmitting = false;
   164→		}
   165→	}
   166→
   167→	async function handleAddNote() {
   168→		if (!panel.task || !noteContent.trim()) return;
   169→
   170→		// AC: @gh-pages-export ac-18 - Check static mode
   171→		if (isStaticMode()) {
   172→			panelError = 'Cannot add notes in read-only mode. Use the kspec CLI.';
   173→			return;
   174→		}
   175→
   176→		isSubmitting = true;
   177→		panelError = '';
   178→
   179→		try {
   180→			await addTaskNote(panel.task._ulid, noteContent);
   181→			noteContent = '';
   182→			// Reload task to get updated notes
   183→			const updated = await fetchTask(panel.task._ulid);
   184→			panel.task = updated;
   185→			loadTasks();
   186→		} catch (err) {
   187→			// AC: @gh-pages-export ac-18 - Graceful error message
   188→			if (err instanceof ReadOnlyModeError) {
   189→				panelError = err.message;
   190→			} else {
   191→				panelError = err instanceof Error ? err.message : 'Failed to add note';
   192→			}
   193→		} finally {
   194→			isSubmitting = false;
   195→		}
   196→	}
   197→
   198→	function formatDate(dateStr: string): string {
   199→		const date = new Date(dateStr);
   200→		return new Intl.DateTimeFormat('en-US', {
   201→			year: 'numeric',
   202→			month: 'short',
   203→			day: 'numeric',
   204→			hour: '2-digit',
   205→			minute: '2-digit'
   206→		}).format(date);
   207→	}
   208→
   209→	function getStatusColor(status: string): string {
   210→		const colors: Record<string, string> = {
   211→			pending: 'bg-status-pending text-status-pending-fg',
   212→			in_progress: 'bg-status-in-progress text-status-in-progress-fg',
   213→			pending_review: 'bg-status-pending-review text-status-pending-review-fg',
   214→			needs_work: 'bg-status-needs-work text-status-needs-work-fg',
   215→			blocked: 'bg-status-blocked text-status-blocked-fg',
   216→			completed: 'bg-status-completed text-status-completed-fg',
   217→			cancelled: 'bg-status-cancelled text-status-cancelled-fg'
   218→		};
   219→		return colors[status] || 'bg-status-cancelled text-status-cancelled-fg';
   220→	}
   221→
   222→	function formatStatus(status: string): string {
   223→		const labels: Record<string, string> = {
   224→			pending: 'Pending',
   225→			in_progress: 'In Progress',
   226→			pending_review: 'Pending Review',
   227→			needs_work: 'Needs Work',
   228→			blocked: 'Blocked',
   229→			completed: 'Completed',
   230→			cancelled: 'Cancelled'
   231→		};
   232→		return labels[status] || status;
   233→	}
   234→
   235→	// AC: @web-dashboard ac-33 - Handle WebSocket task updates
   236→	function handleTaskUpdate(event: BroadcastEvent) {
   237→		console.log('[TasksPage] Task update received:', event);
   238→
   239→		// Mark task as updated for highlight animation
   240→		if (event.data?.ulid) {
   241→			updatedTaskIds.add(event.data.ulid);
   242→			updatedTaskIds = new Set(updatedTaskIds);
   243→
   244→			// Remove highlight after 3s
   245→			setTimeout(() => {
   246→				updatedTaskIds.delete(event.data.ulid);
   247→				updatedTaskIds = new Set(updatedTaskIds);
   248→			}, 3000);
   249→		}
   250→
   251→		// Reload tasks list
   252→		loadTasks();
   253→
   254→		// Reload selected task if it's the one that updated
   255→		if (panel.task && event.data?.ulid === panel.task._ulid) {
   256→			fetchTask(panel.task._ulid)
   257→				.then((updated) => {
   258→					panel.task = updated;
   259→				})
   260→				.catch((err) => {
   261→					console.error('Error reloading task:', err);
   262→				});
   263→		}
   264→	}
   265→
   266→	onMount(() => {
   267→		// AC: @web-dashboard ac-32, ac-33 - Subscribe to task updates
   268→		subscribe(['tasks']);
   269→		on('tasks', handleTaskUpdate);
   270→	});
   271→
   272→	onDestroy(() => {
   273→		// Clean up subscription
   274→		off('tasks', handleTaskUpdate);
   275→		unsubscribe(['tasks']);
   276→	});
   277→</script>
   278→
   279→<svelte:window onkeydown={handleKeydown} />
   280→
   281→<div class="flex flex-col gap-6 p-6">
   282→	<div class="flex items-center justify-between">
   283→		<div>
   284→			<h1 class="text-3xl font-bold mb-2">Tasks</h1>
   285→			{#if !loading}
   286→				<p class="text-muted-foreground">
   287→					Showing {tasks.length} of {total} tasks
   288→				</p>
   289→			{/if}
   290→		</div>
