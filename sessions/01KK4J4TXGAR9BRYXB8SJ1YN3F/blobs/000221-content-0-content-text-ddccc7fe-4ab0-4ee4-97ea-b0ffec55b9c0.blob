   314→			Filtered by plan: <code class="bg-muted px-1 py-0.5 rounded text-xs">@{filterParams.plan}</code>
   315→			<a href="{base}/tasks" class="ml-auto text-primary hover:underline text-xs">Clear filter</a>
   316→		</div>
   317→	{/if}
   318→
   319→	{#if error}
   320→		<div class="bg-destructive/10 text-destructive p-4 rounded-lg" data-testid="error-message" role="alert">
