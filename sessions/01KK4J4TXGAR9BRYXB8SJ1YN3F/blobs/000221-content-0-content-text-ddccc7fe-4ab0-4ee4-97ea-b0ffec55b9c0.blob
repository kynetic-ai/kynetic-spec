   328→		</div>
   329→	{:else}
   330→		<!-- AC: @web-dashboard ac-33 -->
   331→		<TaskList {tasks} {updatedTaskIds} onSelectTask={handleSelectTask} on:select={handleSelectTaskEvent} />
   332→	{/if}
