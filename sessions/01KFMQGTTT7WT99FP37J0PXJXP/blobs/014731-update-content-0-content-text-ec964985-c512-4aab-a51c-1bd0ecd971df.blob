```
     1→/**
     2→ * Shadow branch utilities for transparent spec/task state tracking.
     3→ *
     4→ * Shadow branch concept:
     5→ * - Orphan branch (kspec-meta) stores kspec state
     6→ * - .kspec/ directory is a git worktree pointing to shadow branch
     7→ * - Main branch gitignores .kspec/
     8→ * - All kspec read/write operations target .kspec/
     9→ * - Changes auto-commit to shadow branch
    10→ */
    11→
    12→import { exec, execSync } from "node:child_process";
    13→import * as fs from "node:fs/promises";
    14→import * as path from "node:path";
    15→import { promisify } from "node:util";
    16→
    17→const execAsync = promisify(exec);
    18→
    19→// Import getVerboseMode for checking CLI --debug-shadow flag
    20→// We use a getter function to avoid issues with circular dependencies
    21→let getVerboseModeFunc: (() => boolean) | null = null;
    22→
    23→export function setVerboseModeGetter(getter: () => boolean): void {
    24→  getVerboseModeFunc = getter;
    25→}
    26→
    27→/**
    28→ * Shadow branch configuration
    29→ */
    30→export interface ShadowConfig {
    31→  /** Whether shadow branch is enabled/detected */
    32→  enabled: boolean;
    33→  /** Path to .kspec/ worktree directory */
    34→  worktreeDir: string;
    35→  /** Shadow branch name (default: kspec-meta) */
    36→  branchName: string;
    37→  /** Project root (where .kspec/ lives) */
    38→  projectRoot: string;
    39→}
    40→
    41→/**
    42→ * Shadow branch status
    43→ */
    44→export interface ShadowStatus {
    45→  exists: boolean;
    46→  healthy: boolean;
    47→  branchExists: boolean;
    48→  worktreeExists: boolean;
    49→  worktreeLinked: boolean;
    50→  error?: string;
    51→}
    52→
    53→/**
    54→ * Error types for shadow branch issues
    55→ */
    56→export class ShadowError extends Error {
    57→  constructor(
    58→    message: string,
    59→    public code:
    60→      | "NOT_INITIALIZED"
    61→      | "WORKTREE_DISCONNECTED"
    62→      | "DIRECTORY_MISSING"
    63→      | "GIT_ERROR"
    64→      | "RUNNING_FROM_SHADOW",
    65→    public suggestion: string,
    66→  ) {
    67→    super(message);
    68→    this.name = "ShadowError";
    69→  }
    70→}
    71→
    72→/**
    73→ * Default shadow branch name
    74→ */
    75→export const SHADOW_BRANCH_NAME = "kspec-meta";
    76→
    77→/**
    78→ * Default shadow worktree directory
    79→ */
    80→export const SHADOW_WORKTREE_DIR = ".kspec";
    81→
    82→/**
    83→ * Check if debug mode is enabled.
    84→ * Debug mode can be enabled via:
    85→ * - KSPEC_DEBUG=1 environment variable
    86→ * - Verbose flag (passed from CLI --debug-shadow option)
    87→ *
    88→ * When enabled, shadow branch operations output detailed information.
    89→ */
    90→export function isDebugMode(verboseFlag?: boolean): boolean {
    91→  if (process.env.KSPEC_DEBUG === "1") {
    92→    return true;
    93→  }
    94→  if (verboseFlag === true) {
    95→    return true;
    96→  }
    97→  // Check CLI --debug-shadow flag via getter
    98→  if (getVerboseModeFunc?.()) {
    99→    return true;
   100→  }
   101→  return false;
   102→}
   103→
   104→/**
   105→ * Check if we're in a git repository
   106→ */
   107→export async function isGitRepo(dir: string): Promise<boolean> {
   108→  try {
   109→    execSync("git rev-parse --git-dir", {
   110→      cwd: dir,
   111→      stdio: ["pipe", "pipe", "pipe"],
   112→      encoding: "utf-8",
   113→    });
   114→    return true;
   115→  } catch {
   116→    return false;
   117→  }
   118→}
   119→
   120→/**
   121→ * Get the git root directory
   122→ */
   123→export function getGitRoot(dir: string): string | null {
   124→  try {
   125→    const result = execSync("git rev-parse --show-toplevel", {
   126→      cwd: dir,
   127→      stdio: ["pipe", "pipe", "pipe"],
   128→      encoding: "utf-8",
   129→    }).trim();
   130→    return result;
   131→  } catch {
   132→    return null;
   133→  }
   134→}
   135→
   136→/**
   137→ * Check if a branch exists
   138→ */
   139→export async function branchExists(
   140→  dir: string,
   141→  branchName: string,
   142→): Promise<boolean> {
   143→  try {
   144→    execSync(`git show-ref --verify --quiet refs/heads/${branchName}`, {
   145→      cwd: dir,
   146→      stdio: ["pipe", "pipe", "pipe"],
   147→    });
   148→    return true;
   149→  } catch {
   150→    return false;
   151→  }
   152→}
   153→
   154→/**
   155→ * Check if a directory is a valid git worktree
   156→ */
   157→export async function isValidWorktree(worktreeDir: string): Promise<boolean> {
   158→  try {
   159→    // Check if .git file exists (worktrees have a .git file, not directory)
   160→    const gitPath = path.join(worktreeDir, ".git");
   161→    const stat = await fs.stat(gitPath);
   162→
   163→    if (stat.isFile()) {
   164→      // Read the .git file to verify it points to a worktree
   165→      const content = await fs.readFile(gitPath, "utf-8");
   166→      return content.trim().startsWith("gitdir:");
   167→    }
   168→
   169→    return false;
   170→  } catch {
   171→    return false;
   172→  }
   173→}
   174→
   175→/**
   176→ * Detect if running from inside the shadow worktree directory.
   177→ * Returns the main project root if detected, null otherwise.
   178→ *
   179→ * Detection logic:
   180→ * 1. Check if .git is a file (worktrees have .git files, not directories)
   181→ * 2. Read the gitdir reference from the .git file
   182→ * 3. Check if it points to a worktree for .kspec (pattern: <project>/.git/worktrees/-kspec)
   183→ */
   184→export async function detectRunningFromShadowWorktree(
   185→  cwd: string,
   186→): Promise<string | null> {
   187→  try {
   188→    const gitPath = path.join(cwd, ".git");
   189→    const stat = await fs.stat(gitPath);
   190→
   191→    // Worktrees have a .git file, not directory
   192→    if (!stat.isFile()) {
   193→      return null;
   194→    }
   195→
   196→    const content = await fs.readFile(gitPath, "utf-8");
   197→    const match = content.trim().match(/^gitdir:\s*(.+)$/);
   198→    if (!match) {
   199→      return null;
   200→    }
   201→
   202→    const gitdir = match[1];
   203→
   204→    // Check if this is a shadow worktree (pattern: <project>/.git/worktrees/-kspec)
   205→    if (gitdir.includes(".git/worktrees/")) {
   206→      const worktreesMatch = gitdir.match(/^(.+)\/\.git\/worktrees\//);
   207→      if (worktreesMatch) {
   208→        const mainProjectRoot = worktreesMatch[1];
   209→        const cwdBase = path.basename(cwd);
   210→        const worktreeName = path.basename(gitdir);
   211→
   212→        if (cwdBase === SHADOW_WORKTREE_DIR || worktreeName.includes("kspec")) {
   213→          return mainProjectRoot;
   214→        }
   215→      }
   216→    }
   217→
   218→    return null;
   219→  } catch {
   220→    return null;
   221→  }
   222→}
   223→
   224→/**
   225→ * Detect shadow branch configuration from a directory.
   226→ * Returns shadow config if .kspec/ exists and is valid.
   227→ */
   228→export async function detectShadow(
   229→  startDir: string,
   230→): Promise<ShadowConfig | null> {
   231→  const gitRoot = getGitRoot(startDir);
   232→  if (!gitRoot) {
   233→    return null;
   234→  }
   235→
   236→  const worktreeDir = path.join(gitRoot, SHADOW_WORKTREE_DIR);
   237→
   238→  try {
   239→    await fs.access(worktreeDir);
   240→
   241→    // Verify it's a valid worktree
   242→    if (await isValidWorktree(worktreeDir)) {
   243→      return {
   244→        enabled: true,
   245→        worktreeDir,
   246→        branchName: SHADOW_BRANCH_NAME,
   247→        projectRoot: gitRoot,
   248→      };
   249→    }
   250→
   251→    // Directory exists but not a valid worktree
   252→    return null;
   253→  } catch {
   254→    // .kspec/ doesn't exist
   255→    return null;
   256→  }
   257→}
   258→
   259→/**
   260→ * Get detailed shadow branch status
   261→ */
   262→export async function getShadowStatus(
   263→  projectRoot: string,
   264→): Promise<ShadowStatus> {
   265→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
   266→
   267→  const status: ShadowStatus = {
   268→    exists: false,
   269→    healthy: false,
   270→    branchExists: false,
   271→    worktreeExists: false,
   272→    worktreeLinked: false,
   273→  };
   274→
   275→  // Check if we're in a git repo
   276→  if (!(await isGitRepo(projectRoot))) {
   277→    status.error = "Not a git repository";
   278→    return status;
   279→  }
   280→
   281→  // Check if branch exists
   282→  status.branchExists = await branchExists(projectRoot, SHADOW_BRANCH_NAME);
   283→
   284→  // Check if worktree directory exists
   285→  try {
   286→    await fs.access(worktreeDir);
   287→    status.worktreeExists = true;
   288→  } catch {
   289→    status.worktreeExists = false;
   290→  }
   291→
   292→  // Check if worktree is properly linked
   293→  if (status.worktreeExists) {
   294→    status.worktreeLinked = await isValidWorktree(worktreeDir);
   295→  }
   296→
   297→  // Determine overall status
   298→  status.exists = status.branchExists || status.worktreeExists;
   299→  status.healthy =
   300→    status.branchExists && status.worktreeExists && status.worktreeLinked;
   301→
   302→  if (!status.healthy && status.exists) {
   303→    if (!status.branchExists) {
   304→      status.error = "Shadow branch missing but worktree exists";
   305→    } else if (!status.worktreeExists) {
   306→      status.error = "Shadow branch exists but worktree missing";
   307→    } else if (!status.worktreeLinked) {
   308→      status.error = "Worktree exists but not properly linked";
   309→    }
   310→  }
   311→
   312→  return status;
   313→}
   314→
   315→/**
   316→ * Create an appropriate ShadowError based on status
   317→ */
   318→export function createShadowError(status: ShadowStatus): ShadowError {
   319→  if (!status.branchExists && !status.worktreeExists) {
   320→    return new ShadowError(
   321→      "Shadow branch not initialized",
   322→      "NOT_INITIALIZED",
   323→      "Run `kspec init` to create shadow branch and worktree.",
   324→    );
   325→  }
   326→
   327→  if (status.branchExists && !status.worktreeExists) {
   328→    return new ShadowError(
   329→      ".kspec/ directory missing",
   330→      "DIRECTORY_MISSING",
   331→      "Run `kspec shadow repair` to recreate the worktree.",
   332→    );
   333→  }
   334→
   335→  if (status.worktreeExists && !status.worktreeLinked) {
   336→    return new ShadowError(
   337→      "Worktree disconnected from git",
   338→      "WORKTREE_DISCONNECTED",
   339→      "Run `kspec shadow repair` to fix the worktree link.",
   340→    );
   341→  }
   342→
   343→  return new ShadowError(
   344→    status.error || "Unknown shadow branch error",
   345→    "GIT_ERROR",
   346→    "Check git status and try `kspec shadow repair`.",
   347→  );
   348→}
   349→
   350→/**
   351→ * Auto-commit changes to shadow branch.
   352→ * Called after write operations when shadow is enabled.
   353→ *
   354→ * @param worktreeDir Path to .kspec/ directory
   355→ * @param message Commit message
   356→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   357→ * @returns true if commit succeeded, false if nothing to commit
   358→ */
   359→export async function shadowAutoCommit(
   360→  worktreeDir: string,
   361→  message: string,
   362→  verbose?: boolean,
   363→): Promise<boolean> {
   364→  const debug = isDebugMode(verbose);
   365→
   366→  try {
   367→    if (debug) {
   368→      console.error(
   369→        `[DEBUG] Shadow auto-commit: git add -A (cwd: ${worktreeDir})`,
   370→      );
   371→    }
   372→
   373→    // Stage all changes
   374→    execSync("git add -A", {
   375→      cwd: worktreeDir,
   376→      stdio: ["pipe", "pipe", "pipe"],
   377→    });
   378→
   379→    // Check if there are staged changes
   380→    try {
   381→      if (debug) {
   382→        console.error(`[DEBUG] Shadow auto-commit: git diff --cached --quiet`);
   383→      }
   384→
   385→      execSync("git diff --cached --quiet", {
   386→        cwd: worktreeDir,
   387→        stdio: ["pipe", "pipe", "pipe"],
   388→      });
   389→      // No error = no changes
   390→      if (debug) {
   391→        console.error(`[DEBUG] Shadow auto-commit: No changes to commit`);
   392→      }
   393→      return false;
   394→    } catch {
   395→      // Error = there are changes, proceed with commit
   396→    }
   397→
   398→    if (debug) {
   399→      console.error(`[DEBUG] Shadow auto-commit: git commit -m "${message}"`);
   400→    }
   401→
   402→    // Commit with message
   403→    // Set KSPEC_SHADOW_COMMIT=1 to signal authorized commit to git hooks
   404→    execSync(`git commit -m "${message.replace(/"/g, '\\"')}"`, {
   405→      cwd: worktreeDir,
   406→      stdio: ["pipe", "pipe", "pipe"],
   407→      env: { ...process.env, KSPEC_SHADOW_COMMIT: "1" },
   408→    });
   409→
   410→    if (debug) {
   411→      console.error(`[DEBUG] Shadow auto-commit: Success`);
   412→    }
   413→
   414→    return true;
   415→  } catch (error) {
   416→    // AC: Only log error if debug mode enabled
   417→    if (debug) {
   418→      console.error("Shadow auto-commit failed:", error);
   419→    }
   420→    return false;
   421→  }
   422→}
   423→
   424→/**
   425→ * Generate commit message for a kspec operation.
   426→ */
   427→export function generateCommitMessage(
   428→  operation: string,
   429→  ref?: string,
   430→  detail?: string,
   431→): string {
   432→  const parts: string[] = [];
   433→
   434→  switch (operation) {
   435→    case "task-start":
   436→      parts.push(`Start @${ref}`);
   437→      break;
   438→    case "task-complete":
   439→      parts.push(`Complete @${ref}`);
   440→      if (detail) parts.push(`: ${detail}`);
   441→      break;
   442→    case "task-note":
   443→      parts.push(`Note on @${ref}`);
   444→      break;
   445→    case "task-add":
   446→      parts.push(`Add task: ${detail || ref}`);
   447→      break;
   448→    case "inbox-add":
   449→      parts.push(
   450→        `Inbox: ${detail?.slice(0, 50)}${(detail?.length || 0) > 50 ? "..." : ""}`,
   451→      );
   452→      break;
   453→    case "inbox-promote":
   454→      parts.push(`Promote to @${ref}`);
   455→      break;
   456→    case "item-add":
   457→      parts.push(`Add @${ref}`);
   458→      break;
   459→    case "item-set":
   460→      parts.push(`Update @${ref}`);
   461→      break;
   462→    case "item-delete":
   463→      parts.push(`Delete @${ref}`);
   464→      break;
   465→    case "derive":
   466→      parts.push(`Derive from @${ref}`);
   467→      break;
   468→    default:
   469→      parts.push(operation);
   470→      if (ref) parts.push(` @${ref}`);
   471→  }
   472→
   473→  return parts.join("");
   474→}
   475→
   476→/**
   477→ * Resolve a path relative to shadow worktree if enabled.
   478→ * Falls back to original path if shadow is not enabled.
   479→ */
   480→export function resolveShadowPath(
   481→  originalPath: string,
   482→  shadowConfig: ShadowConfig | null,
   483→  projectRoot: string,
   484→): string {
   485→  if (!shadowConfig?.enabled) {
   486→    return originalPath;
   487→  }
   488→
   489→  // If the path is within the project root, rewrite to shadow worktree
   490→  const relativePath = path.relative(projectRoot, originalPath);
   491→
   492→  // Skip if path is outside project or already in .kspec
   493→  if (
   494→    relativePath.startsWith("..") ||
   495→    relativePath.startsWith(SHADOW_WORKTREE_DIR)
   496→  ) {
   497→    return originalPath;
   498→  }
   499→
   500→  // Handle spec/ -> .kspec/ mapping
   501→  if (relativePath.startsWith("spec/") || relativePath.startsWith("spec\\")) {
   502→    const specRelative = relativePath.slice(5); // Remove 'spec/'
   503→    return path.join(shadowConfig.worktreeDir, specRelative);
   504→  }
   505→
   506→  // For task/inbox files at root, move to .kspec
   507→  if (
   508→    relativePath.endsWith(".tasks.yaml") ||
   509→    relativePath.endsWith(".inbox.yaml")
   510→  ) {
   511→    return path.join(shadowConfig.worktreeDir, relativePath);
   512→  }
   513→
   514→  return originalPath;
   515→}
   516→
   517→/**
   518→ * Commit changes to shadow branch if enabled.
   519→ * This is the primary interface for CLI commands to trigger auto-commit.
   520→ *
   521→ * @param shadowConfig Shadow configuration (from KspecContext.shadow)
   522→ * @param operation Operation type (e.g., 'task-start', 'task-complete')
   523→ * @param ref Reference slug or ULID (optional)
   524→ * @param detail Additional detail for commit message (optional)
   525→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   526→ * @returns true if committed, false if shadow not enabled or nothing to commit
   527→ */
   528→export async function commitIfShadow(
   529→  shadowConfig: ShadowConfig | null,
   530→  operation: string,
   531→  ref?: string,
   532→  detail?: string,
   533→  verbose?: boolean,
   534→): Promise<boolean> {
   535→  if (!shadowConfig?.enabled) {
   536→    return false;
   537→  }
   538→
   539→  const message = generateCommitMessage(operation, ref, detail);
   540→  const committed = await shadowAutoCommit(
   541→    shadowConfig.worktreeDir,
   542→    message,
   543→    verbose,
   544→  );
   545→
   546→  // AC: @shadow-sync ac-1 - Fire-and-forget push after each commit
   547→  if (committed) {
   548→    shadowPushAsync(shadowConfig.worktreeDir, verbose);
   549→  }
   550→
   551→  return committed;
   552→}
   553→
   554→/**
   555→ * Check if shadow is required but not available, and throw appropriate error.
   556→ * Use this at the start of commands that require shadow mode.
   557→ *
   558→ * @param shadowConfig Shadow configuration from context
   559→ * @param projectRoot Project root for status check
   560→ * @throws ShadowError if shadow is not properly configured
   561→ */
   562→export async function requireShadow(
   563→  shadowConfig: ShadowConfig | null,
   564→  projectRoot: string,
   565→): Promise<void> {
   566→  if (shadowConfig?.enabled) {
   567→    return; // Shadow is available
   568→  }
   569→
   570→  const status = await getShadowStatus(projectRoot);
   571→  throw createShadowError(status);
   572→}
   573→
   574→/**
   575→ * Format a ShadowError for display in CLI.
   576→ * Returns a user-friendly message with suggestion.
   577→ */
   578→export function formatShadowError(error: ShadowError): string {
   579→  return `${error.message}\n\nSuggestion: ${error.suggestion}`;
   580→}
   581→
   582→/**
   583→ * Result from shadow initialization
   584→ */
   585→export interface ShadowInitResult {
   586→  success: boolean;
   587→  branchCreated: boolean;
   588→  worktreeCreated: boolean;
   589→  gitignoreUpdated: boolean;
   590→  initialCommit: boolean;
   591→  alreadyExists: boolean;
   592→  /** Whether shadow was created from existing remote branch */
   593→  createdFromRemote: boolean;
   594→  /** Whether new branch was pushed to remote to establish tracking */
   595→  pushedToRemote: boolean;
   596→  error?: string;
   597→}
   598→
   599→/**
   600→ * Options for shadow initialization
   601→ */
   602→export interface ShadowInitOptions {
   603→  /** Project name for manifest */
   604→  projectName?: string;
   605→  /** Force reinitialize even if exists */
   606→  force?: boolean;
   607→}
   608→
   609→/**
   610→ * Check if a remote exists (default: origin)
   611→ */
   612→export async function hasRemote(
   613→  projectRoot: string,
   614→  remoteName = "origin",
   615→): Promise<boolean> {
   616→  try {
   617→    const { stdout } = await execAsync(`git remote get-url ${remoteName}`, {
   618→      cwd: projectRoot,
   619→    });
   620→    return stdout.trim().length > 0;
   621→  } catch {
   622→    return false;
   623→  }
   624→}
   625→
   626→/**
   627→ * Check if a branch exists on a remote
   628→ */
   629→export async function remoteBranchExists(
   630→  projectRoot: string,
   631→  branchName: string,
   632→  remoteName = "origin",
   633→): Promise<boolean> {
   634→  try {
   635→    execSync(
   636→      `git show-ref --verify --quiet refs/remotes/${remoteName}/${branchName}`,
   637→      {
   638→        cwd: projectRoot,
   639→        stdio: ["pipe", "pipe", "pipe"],
   640→      },
   641→    );
   642→    return true;
   643→  } catch {
   644→    return false;
   645→  }
   646→}
   647→
   648→/**
   649→ * Fetch from remote to ensure refs are up to date.
   650→ * Returns true if fetch succeeded, false otherwise.
   651→ */
   652→export async function fetchRemote(
   653→  projectRoot: string,
   654→  remoteName = "origin",
   655→): Promise<boolean> {
   656→  try {
   657→    await execAsync(`git fetch ${remoteName}`, {
   658→      cwd: projectRoot,
   659→    });
   660→    return true;
   661→  } catch {
   662→    return false;
   663→  }
   664→}
   665→
   666→/**
   667→ * Push shadow branch to remote with tracking.
   668→ * Returns true if push succeeded, false otherwise.
   669→ */
   670→export async function pushShadowBranch(
   671→  worktreeDir: string,
   672→  remoteName = "origin",
   673→): Promise<boolean> {
   674→  try {
   675→    await execAsync(`git push -u ${remoteName} ${SHADOW_BRANCH_NAME}`, {
   676→      cwd: worktreeDir,
   677→    });
   678→    return true;
   679→  } catch {
   680→    return false;
   681→  }
   682→}
   683→
   684→/**
   685→ * Check if shadow branch has remote tracking configured.
   686→ * AC-4: Used to determine whether sync should be attempted.
   687→ */
   688→export async function hasRemoteTracking(worktreeDir: string): Promise<boolean> {
   689→  try {
   690→    const { stdout } = await execAsync(
   691→      `git config branch.${SHADOW_BRANCH_NAME}.remote`,
   692→      { cwd: worktreeDir },
   693→    );
   694→    return stdout.trim().length > 0;
   695→  } catch {
   696→    return false;
   697→  }
   698→}
   699→
   700→/**
   701→ * Ensure shadow branch has remote tracking configured.
   702→ * AC-8: If shadow has no tracking but main branch has origin remote,
   703→ * automatically configure tracking to origin/kspec-meta.
   704→ *
   705→ * @param worktreeDir Path to .kspec/ worktree
   706→ * @param projectRoot Git repository root
   707→ * @returns true if tracking is now configured (was already or just set up)
   708→ */
   709→export async function ensureRemoteTracking(
   710→  worktreeDir: string,
   711→  projectRoot: string,
   712→): Promise<boolean> {
   713→  // Check if already has tracking
   714→  if (await hasRemoteTracking(worktreeDir)) {
   715→    return true;
   716→  }
   717→
   718→  // Check if main branch has origin remote
   719→  if (!(await hasRemote(projectRoot))) {
   720→    return false;
   721→  }
   722→
   723→  // Set up tracking for shadow branch to origin/kspec-meta
   724→  try {
   725→    await execAsync(`git config branch.${SHADOW_BRANCH_NAME}.remote origin`, {
   726→      cwd: worktreeDir,
   727→    });
   728→    await execAsync(
   729→      `git config branch.${SHADOW_BRANCH_NAME}.merge refs/heads/${SHADOW_BRANCH_NAME}`,
   730→      { cwd: worktreeDir },
   731→    );
   732→    return true;
   733→  } catch {
   734→    return false;
   735→  }
   736→}
   737→
   738→/**
   739→ * Result from a sync operation
   740→ */
   741→export interface ShadowSyncResult {
   742→  success: boolean;
   743→  pulled: boolean;
   744→  pushed: boolean;
   745→  hadConflict: boolean;
   746→  error?: string;
   747→}
   748→
   749→/**
   750→ * Fire-and-forget push to remote.
   751→ * AC-1: Called after each auto-commit when tracking is configured.
   752→ * AC-8: Automatically sets up tracking if main branch has remote.
   753→ * Silently ignores errors - the local commit succeeded regardless.
   754→ *
   755→ * @param worktreeDir Path to .kspec/ worktree
   756→ * @param verbose Enable debug output
   757→ */
   758→export async function shadowPushAsync(
   759→  worktreeDir: string,
   760→  verbose?: boolean,
   761→): Promise<void> {
   762→  const debug = isDebugMode(verbose);
   763→
   764→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
   765→  const projectRoot = path.dirname(worktreeDir);
   766→  await ensureRemoteTracking(worktreeDir, projectRoot);
   767→
   768→  // Check if tracking is configured before attempting push
   769→  if (!(await hasRemoteTracking(worktreeDir))) {
   770→    if (debug) {
   771→      console.error(
   772→        "[DEBUG] Shadow push: No remote tracking configured, skipping",
   773→      );
   774→    }
   775→    return; // AC: @shadow-sync ac-4 - silently skip if no tracking
   776→  }
   777→
   778→  try {
   779→    if (debug) {
   780→      console.error(`[DEBUG] Shadow push: git push (cwd: ${worktreeDir})`);
   781→    }
   782→
   783→    // Don't await - fire and forget
   784→    execAsync("git push", { cwd: worktreeDir }).catch((err) => {
   785→      if (debug) {
   786→        console.error("[DEBUG] Shadow push failed:", err);
   787→      }
   788→      // Silently ignore push failures - local state is correct
   789→    });
   790→  } catch (err) {
   791→    if (debug) {
   792→      console.error("[DEBUG] Shadow push error:", err);
   793→    }
   794→  }
   795→}
   796→
   797→/**
   798→ * Pull remote changes to shadow branch.
   799→ * AC-2: Called at session start to sync before operations.
   800→ * AC-6: Uses --ff-only first, falls back to --rebase.
   801→ * AC-3: On conflict, returns failure with suggestion.
   802→ * AC-8: Automatically sets up tracking if main branch has remote.
   803→ */
   804→export async function shadowPull(
   805→  worktreeDir: string,
   806→): Promise<ShadowSyncResult> {
   807→  const result: ShadowSyncResult = {
   808→    success: false,
   809→    pulled: false,
   810→    pushed: false,
   811→    hadConflict: false,
   812→  };
   813→
   814→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
   815→  const projectRoot = path.dirname(worktreeDir);
   816→  await ensureRemoteTracking(worktreeDir, projectRoot);
   817→
   818→  // AC: @shadow-sync ac-4 - Skip if no remote tracking
   819→  if (!(await hasRemoteTracking(worktreeDir))) {
   820→    result.success = true;
   821→    return result;
   822→  }
   823→
   824→  // Check if remote branch exists before attempting pull
   825→  // Fetch first to ensure refs are up to date
   826→  await fetchRemote(projectRoot);
   827→  const remoteHasBranch = await remoteBranchExists(
   828→    projectRoot,
   829→    SHADOW_BRANCH_NAME,
   830→  );
   831→  if (!remoteHasBranch) {
   832→    // Remote branch doesn't exist yet - nothing to pull, but success
   833→    result.success = true;
   834→    return result;
   835→  }
   836→
   837→  try {
   838→    // Try fast-forward only first (cleanest)
   839→    await execAsync("git pull --ff-only", { cwd: worktreeDir });
   840→    result.success = true;
   841→    result.pulled = true;
   842→    return result;
   843→  } catch {
   844→    // Fast-forward failed, try rebase
   845→  }
   846→
   847→  try {
   848→    // AC: @shadow-sync ac-6 - Fall back to rebase
   849→    await execAsync("git pull --rebase", { cwd: worktreeDir });
   850→    result.success = true;
   851→    result.pulled = true;
   852→    return result;
   853→  } catch {
   854→    // Rebase failed - likely conflict
   855→  }
   856→
   857→  // AC: @shadow-sync ac-3 - Conflict detected - abort rebase and report
   858→  try {
   859→    await execAsync("git rebase --abort", { cwd: worktreeDir });
   860→  } catch {
   861→    // May not be in rebase state, ignore
   862→  }
   863→
   864→  result.hadConflict = true;
   865→  result.error = "Sync conflict detected. Run `kspec shadow resolve` to fix.";
   866→  return result;
   867→}
   868→
   869→/**
   870→ * Full sync operation: pull then push.
   871→ * Used by session start and explicit sync commands.
   872→ */
   873→export async function shadowSync(
   874→  worktreeDir: string,
   875→): Promise<ShadowSyncResult> {
   876→  // First pull
   877→  const pullResult = await shadowPull(worktreeDir);
   878→  if (!pullResult.success) {
   879→    return pullResult;
   880→  }
   881→
   882→  // Then push (only if tracking configured, checked inside)
   883→  if (await hasRemoteTracking(worktreeDir)) {
   884→    try {
   885→      await execAsync("git push", { cwd: worktreeDir });
   886→      pullResult.pushed = true;
   887→    } catch {
   888→      // Push failed - not a critical error, local state is correct
   889→      // Could be permissions, network, etc.
   890→    }
   891→  }
   892→
   893→  return pullResult;
   894→}
   895→
   896→/**
   897→ * Check if .gitignore has uncommitted changes
   898→ */
   899→async function hasUncommittedGitignore(projectRoot: string): Promise<boolean> {
   900→  try {
   901→    // Check both staged and unstaged changes to .gitignore
   902→    const { stdout } = await execAsync("git status --porcelain .gitignore", {
   903→      cwd: projectRoot,
   904→    });
   905→    return stdout.trim().length > 0;
   906→  } catch {
   907→    return false;
   908→  }
   909→}
   910→
   911→/**
   912→ * Commit only .gitignore with a message
   913→ */
   914→async function commitGitignore(projectRoot: string): Promise<void> {
   915→  await execAsync("git add .gitignore", { cwd: projectRoot });
   916→  await execAsync(
   917→    'git commit -m "chore: add .kspec/ to .gitignore for shadow branch"',
   918→    {
   919→      cwd: projectRoot,
   920→    },
   921→  );
   922→}
   923→
   924→/**
   925→ * Add .kspec/ to .gitignore if not already present.
   926→ * Fails if .gitignore has uncommitted changes.
   927→ * Commits the change after adding.
   928→ */
   929→async function ensureGitignore(projectRoot: string): Promise<boolean> {
   930→  const gitignorePath = path.join(projectRoot, ".gitignore");
   931→  const entry = `${SHADOW_WORKTREE_DIR}/`;
   932→
   933→  // Fail fast if .gitignore has uncommitted changes
   934→  if (await hasUncommittedGitignore(projectRoot)) {
   935→    throw new ShadowError(
   936→      ".gitignore has uncommitted changes",
   937→      "GIT_ERROR",
   938→      "Commit or stash your .gitignore changes before running kspec init.",
   939→    );
   940→  }
   941→
   942→  try {
   943→    let content = "";
   944→    try {
   945→      content = await fs.readFile(gitignorePath, "utf-8");
   946→    } catch {
   947→      // File doesn't exist, will create
   948→    }
   949→
   950→    // Check if already present (handle various formats)
   951→    const lines = content.split("\n");
   952→    const patterns = [
   953→      SHADOW_WORKTREE_DIR,
   954→      `${SHADOW_WORKTREE_DIR}/`,
   955→      `/${SHADOW_WORKTREE_DIR}`,
   956→      `/${SHADOW_WORKTREE_DIR}/`,
   957→    ];
   958→
   959→    for (const line of lines) {
   960→      const trimmed = line.trim();
   961→      if (patterns.includes(trimmed)) {
   962→        return false; // Already present
   963→      }
   964→    }
   965→
   966→    // Add to gitignore
   967→    const newContent =
   968→      content.endsWith("\n") || content === ""
   969→        ? `${content}${entry}\n`
   970→        : `${content}\n${entry}\n`;
   971→
   972→    await fs.writeFile(gitignorePath, newContent, "utf-8");
   973→
   974→    // Commit the change
   975→    await commitGitignore(projectRoot);
   976→
   977→    return true;
   978→  } catch (error) {
   979→    if (error instanceof ShadowError) {
   980→      throw error;
   981→    }
   982→    throw new ShadowError(
   983→      `Failed to update .gitignore: ${error}`,
   984→      "GIT_ERROR",
   985→      "Check file permissions for .gitignore",
   986→    );
   987→  }
   988→}
   989→
   990→/**
   991→ * Generate initial manifest content for shadow branch
   992→ */
   993→function generateShadowManifest(projectName: string): string {
   994→  return `# ${projectName} - Kynetic Spec
   995→# Generated by kspec init
   996→
   997→kynetic: "1.0"
   998→
   999→project:
  1000→  name: "${projectName}"
  1001→  version: "0.1.0"
  1002→  status: draft
  1003→  description: |
  1004→    Add your project description here.
  1005→
  1006→# Module includes
  1007→includes:
  1008→  - modules/main.yaml
  1009→
  1010→# Configuration
  1011→config:
  1012→  validation:
  1013→    strict_refs: true
  1014→    require_acceptance: false
  1015→`;
  1016→}
  1017→
  1018→/**
  1019→ * Generate initial module content
  1020→ */
  1021→function generateShadowModule(projectName: string): string {
  1022→  return `# ${projectName} - Main Module
  1023→# Add your spec items here
  1024→
  1025→items: []
  1026→`;
  1027→}
  1028→
  1029→/**
  1030→ * Generate initial tasks file
  1031→ */
  1032→function generateShadowTasks(projectName: string): string {
  1033→  return `# ${projectName} - Tasks
  1034→# Track implementation work here
  1035→
  1036→tasks: []
  1037→`;
  1038→}
  1039→
  1040→/**
  1041→ * Generate initial inbox file
  1042→ */
  1043→function generateShadowInbox(): string {
  1044→  return `# Inbox - Quick Capture
  1045→# Ideas and notes that haven't been triaged yet
  1046→
  1047→items: []
  1048→`;
  1049→}
  1050→
  1051→/**
  1052→ * Install pre-commit hook to protect kspec-meta branch.
  1053→ * Hook prevents direct commits to shadow branch unless KSPEC_SHADOW_COMMIT=1.
  1054→ *
  1055→ * Note: Git worktrees use hooks from the main .git/hooks directory (via commondir),
  1056→ * not from .git/worktrees/-kspec/hooks. So we install to main hooks directory.
  1057→ *
  1058→ * @param projectRoot Git repository root
  1059→ * @returns true if hook was installed, false if already exists
  1060→ */
  1061→async function installShadowHook(projectRoot: string): Promise<boolean> {
  1062→  const hooksDir = path.join(projectRoot, ".git", "hooks");
  1063→  const hookPath = path.join(hooksDir, "pre-commit");
  1064→  const sourceHookPath = path.join(projectRoot, "hooks", "pre-commit");
  1065→
  1066→  try {
  1067→    // Check if source hook exists
  1068→    try {
  1069→      await fs.access(sourceHookPath);
  1070→    } catch {
  1071→      // Source hook doesn't exist - skip installation
  1072→      return false;
  1073→    }
  1074→
  1075→    // Check if hook already exists
  1076→    try {
  1077→      await fs.access(hookPath);
  1078→      // Hook exists - don't overwrite (user may have custom hooks)
  1079→      return false;
  1080→    } catch {
  1081→      // Hook doesn't exist - install it
  1082→    }
  1083→
  1084→    // Copy hook from source
  1085→    const hookContent = await fs.readFile(sourceHookPath, "utf-8");
  1086→    await fs.writeFile(hookPath, hookContent, { mode: 0o755 });
  1087→    return true;
  1088→  } catch (_error) {
  1089→    // Silently fail - hook installation is optional
  1090→    return false;
  1091→  }
  1092→}
  1093→
  1094→/**
  1095→ * Convert project name to slug (kebab-case)
  1096→ */
  1097→function toSlug(projectName: string): string {
  1098→  return projectName
  1099→    .toLowerCase()
  1100→    .replace(/[^a-z0-9]+/g, "-")
  1101→    .replace(/^-|-$/g, "");
  1102→}
  1103→
  1104→/**
  1105→ * Configure git merge driver for kspec YAML files.
  1106→ * AC: @yaml-merge-driver ac-12
  1107→ *
  1108→ * Configures the merge driver in .git/config and adds .gitattributes in the shadow branch.
  1109→ *
  1110→ * @param projectRoot Git repository root
  1111→ * @param worktreeDir Path to shadow worktree directory
  1112→ * @returns true if configuration was successful
  1113→ */
  1114→async function configureMergeDriver(
  1115→  projectRoot: string,
  1116→  worktreeDir: string,
  1117→): Promise<boolean> {
  1118→  try {
  1119→    // Step 1: Configure merge driver in .git/config
  1120→    const kspecPath = execSync("which kspec", {
  1121→      encoding: "utf-8",
  1122→      stdio: ["pipe", "pipe", "pipe"],
  1123→    }).trim();
  1124→
  1125→    // Add merge driver configuration to git config
  1126→    try {
  1127→      execSync(
  1128→        `git config merge.kspec.name "Kspec YAML semantic merge driver"`,
  1129→        {
  1130→          cwd: projectRoot,
  1131→          stdio: ["pipe", "pipe", "pipe"],
  1132→        },
  1133→      );
  1134→      execSync(
  1135→        `git config merge.kspec.driver "${kspecPath} merge-driver %O %A %B --non-interactive"`,
  1136→        {
  1137→          cwd: projectRoot,
  1138→          stdio: ["pipe", "pipe", "pipe"],
  1139→        },
  1140→      );
  1141→    } catch (error) {
  1142→      // Config may fail if already set - check if it's set correctly
  1143→      try {
  1144→        const existingDriver = execSync("git config merge.kspec.driver", {
  1145→          cwd: projectRoot,
  1146→          encoding: "utf-8",
  1147→          stdio: ["pipe", "pipe", "pipe"],
  1148→        }).trim();
  1149→
  1150→        if (!existingDriver.includes("kspec merge-driver")) {
  1151→          throw new Error("Merge driver config exists but is incorrect");
  1152→        }
  1153→      } catch {
  1154→        throw error; // Re-throw original error
  1155→      }
  1156→    }
  1157→
  1158→    // Step 2: Create .gitattributes in shadow branch
  1159→    const gitattributesPath = path.join(worktreeDir, ".gitattributes");
  1160→
  1161→    // Check if .gitattributes exists
  1162→    let existingContent = "";
  1163→    try {
  1164→      existingContent = await fs.readFile(gitattributesPath, "utf-8");
  1165→    } catch {
  1166→      // File doesn't exist, that's fine
  1167→    }
  1168→
  1169→    // Check if merge driver is already configured
  1170→    if (!existingContent.includes("merge=kspec")) {
  1171→      const attributesContent = existingContent
  1172→        ? existingContent + "\n"
  1173→        : "# Git attributes for kspec\n\n";
  1174→
  1175→      await fs.writeFile(
  1176→        gitattributesPath,
  1177→        attributesContent + "*.yaml merge=kspec\n*.yml merge=kspec\n",
  1178→        "utf-8",
  1179→      );
  1180→
  1181→      // Commit .gitattributes to shadow branch
  1182→      await shadowAutoCommit(worktreeDir, "Configure kspec merge driver");
  1183→    }
  1184→
  1185→    return true;
  1186→  } catch (_error) {
  1187→    // Silently fail - merge driver configuration is optional
  1188→    return false;
  1189→  }
  1190→}
  1191→
  1192→/**
  1193→ * Initialize shadow branch and worktree.
  1194→ * Creates orphan branch, worktree, updates gitignore, and creates initial structure.
  1195→ *
  1196→ * @param projectRoot Git repository root
  1197→ * @param options Initialization options
  1198→ * @returns Result indicating what was created
  1199→ */
  1200→export async function initializeShadow(
  1201→  projectRoot: string,
  1202→  options: ShadowInitOptions = {},
  1203→): Promise<ShadowInitResult> {
  1204→  const result: ShadowInitResult = {
  1205→    success: false,
  1206→    branchCreated: false,
  1207→    worktreeCreated: false,
  1208→    gitignoreUpdated: false,
  1209→    initialCommit: false,
  1210→    alreadyExists: false,
  1211→    createdFromRemote: false,
  1212→    pushedToRemote: false,
  1213→  };
  1214→
  1215→  // Check if we're in a git repo
  1216→  if (!(await isGitRepo(projectRoot))) {
  1217→    result.error = "Not a git repository";
  1218→    return result;
  1219→  }
  1220→
  1221→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
  1222→
  1223→  // Check current status
  1224→  const status = await getShadowStatus(projectRoot);
  1225→
  1226→  // Handle existing shadow branch
  1227→  if (status.healthy && !options.force) {
  1228→    result.alreadyExists = true;
  1229→    result.success = true;
  1230→    return result;
  1231→  }
  1232→
  1233→  // Derive project name if not provided
  1234→  const projectName =
  1235→    options.projectName ||
  1236→    path
  1237→      .basename(projectRoot)
  1238→      .replace(/[-_]/g, " ")
  1239→      .replace(/\b\w/g, (c) => c.toUpperCase());
  1240→
  1241→  const slug = toSlug(projectName);
  1242→
  1243→  // Check for remote shadow branch (AC-4: fetch to ensure refs are up to date)
  1244→  const remoteExists = await hasRemote(projectRoot);
  1245→  let remoteHasShadow = false;
  1246→  if (remoteExists) {
  1247→    await fetchRemote(projectRoot); // Best effort, ignore failures
  1248→    remoteHasShadow = await remoteBranchExists(projectRoot, SHADOW_BRANCH_NAME);
  1249→  }
  1250→
  1251→  try {
  1252→    // Step 1: Update .gitignore first (before creating .kspec/)
  1253→    result.gitignoreUpdated = await ensureGitignore(projectRoot);
  1254→
  1255→    // Step 2: Create worktree with orphan branch (or attach to existing branch)
  1256→    if (!status.worktreeExists || !status.worktreeLinked) {
  1257→      // Remove existing directory if present but not linked
  1258→      if (status.worktreeExists && !status.worktreeLinked) {
  1259→        await fs.rm(worktreeDir, { recursive: true, force: true });
  1260→      }
  1261→
  1262→      // Remove stale worktree reference if any
  1263→      try {
  1264→        await execAsync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, {
  1265→          cwd: projectRoot,
  1266→        });
  1267→      } catch {
  1268→        // Ignore - worktree may not exist in git's list
  1269→      }
  1270→
  1271→      if (remoteHasShadow) {
  1272→        // AC: @shadow-init-remote ac-1 - Remote has shadow branch - create worktree from it with tracking
  1273→        await execAsync(
  1274→          `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1275→          { cwd: projectRoot },
  1276→        );
  1277→        // Set up tracking for the branch
  1278→        await execAsync(
  1279→          `git branch --set-upstream-to=origin/${SHADOW_BRANCH_NAME} ${SHADOW_BRANCH_NAME}`,
  1280→          { cwd: projectRoot },
  1281→        );
  1282→        result.createdFromRemote = true;
  1283→      } else if (!status.branchExists) {
  1284→        // AC: @shadow-init-remote ac-2 ac-3 - No remote branch or no remote - create orphan branch
  1285→        await execAsync(
  1286→          `git worktree add --orphan -b ${SHADOW_BRANCH_NAME} ${SHADOW_WORKTREE_DIR}`,
  1287→          { cwd: projectRoot },
  1288→        );
  1289→        result.branchCreated = true;
  1290→      } else {
  1291→        // Attach to existing local branch
  1292→        await execAsync(
  1293→          `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1294→          { cwd: projectRoot },
  1295→        );
  1296→      }
  1297→
  1298→      result.worktreeCreated = true;
  1299→    }
  1300→
  1301→    // Step 3: Create initial structure if empty (only for new branches, not remote)
  1302→    const manifestPath = path.join(worktreeDir, `${slug}.yaml`);
  1303→    const modulesDir = path.join(worktreeDir, "modules");
  1304→    const moduleFilePath = path.join(modulesDir, "main.yaml");
  1305→    const tasksPath = path.join(worktreeDir, `${slug}.tasks.yaml`);
  1306→    const inboxPath = path.join(worktreeDir, `${slug}.inbox.yaml`);
  1307→
  1308→    let filesCreated = false;
  1309→
  1310→    // Only create files if manifest doesn't exist (remote branches will have files)
  1311→    try {
  1312→      // Look for any .yaml manifest file (project name may differ)
  1313→      const files = await fs.readdir(worktreeDir);
  1314→      const hasManifest = files.some(
  1315→        (f) =>
  1316→          f.endsWith(".yaml") &&
  1317→          !f.includes(".tasks.") &&
  1318→          !f.includes(".inbox."),
  1319→      );
  1320→      if (!hasManifest) {
  1321→        throw new Error("No manifest found");
  1322→      }
  1323→    } catch {
  1324→      // Manifest doesn't exist, create initial structure
  1325→      await fs.mkdir(modulesDir, { recursive: true });
  1326→      await fs.writeFile(
  1327→        manifestPath,
  1328→        generateShadowManifest(projectName),
  1329→        "utf-8",
  1330→      );
  1331→      await fs.writeFile(
  1332→        moduleFilePath,
  1333→        generateShadowModule(projectName),
  1334→        "utf-8",
  1335→      );
  1336→      await fs.writeFile(tasksPath, generateShadowTasks(projectName), "utf-8");
  1337→      await fs.writeFile(inboxPath, generateShadowInbox(), "utf-8");
  1338→      filesCreated = true;
  1339→    }
  1340→
  1341→    // Step 4: Initial commit if files were created
  1342→    if (filesCreated) {
  1343→      result.initialCommit = await shadowAutoCommit(
  1344→        worktreeDir,
  1345→        `Initialize ${projectName} spec`,
  1346→      );
  1347→    }
  1348→
  1349→    // Step 5: AC-2: Push new branch to remote to establish tracking
  1350→    if (result.branchCreated && remoteExists && !remoteHasShadow) {
  1351→      result.pushedToRemote = await pushShadowBranch(worktreeDir);
  1352→    }
  1353→
  1354→    // Step 6: Install pre-commit hook to protect shadow branch
  1355→    await installShadowHook(projectRoot);
  1356→
  1357→    // Step 7: Configure merge driver for semantic YAML merging
  1358→    // AC: @yaml-merge-driver ac-12
  1359→    await configureMergeDriver(projectRoot, worktreeDir);
  1360→
  1361→    result.success = true;
  1362→    return result;
  1363→  } catch (error) {
  1364→    result.error = error instanceof Error ? error.message : String(error);
  1365→    return result;
  1366→  }
  1367→}
  1368→
  1369→/**
  1370→ * Repair a broken shadow branch setup.
  1371→ * Handles cases where worktree is disconnected or directory is missing.
  1372→ *
  1373→ * @param projectRoot Git repository root
  1374→ * @returns Result indicating what was repaired
  1375→ */
  1376→export async function repairShadow(
  1377→  projectRoot: string,
  1378→): Promise<ShadowInitResult> {
  1379→  const status = await getShadowStatus(projectRoot);
  1380→
  1381→  if (status.healthy) {
  1382→    return {
  1383→      success: true,
  1384→      branchCreated: false,
  1385→      worktreeCreated: false,
  1386→      gitignoreUpdated: false,
  1387→      initialCommit: false,
  1388→      alreadyExists: true,
  1389→      createdFromRemote: false,
  1390→      pushedToRemote: false,
  1391→    };
  1392→  }
  1393→
  1394→  if (!status.branchExists) {
  1395→    // Can't repair without a branch - need full init
  1396→    return {
  1397→      success: false,
  1398→      branchCreated: false,
  1399→      worktreeCreated: false,
  1400→      gitignoreUpdated: false,
  1401→      initialCommit: false,
  1402→      alreadyExists: false,
  1403→      createdFromRemote: false,
  1404→      pushedToRemote: false,
  1405→      error: "Shadow branch does not exist. Run `kspec init` instead.",
  1406→    };
  1407→  }
  1408→
  1409→  // Branch exists but worktree is broken - repair it
  1410→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
  1411→
  1412→  try {
  1413→    // Remove stale worktree reference
  1414→    try {
  1415→      await execAsync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, {
  1416→        cwd: projectRoot,
  1417→      });
  1418→    } catch {
  1419→      // Ignore - worktree may not be in git's list
  1420→    }
  1421→
  1422→    // Remove directory if exists (handles corrupted .git file case)
  1423→    await fs.rm(worktreeDir, { recursive: true, force: true });
  1424→
  1425→    // Prune stale worktree references (cleans up orphaned entries)
  1426→    try {
  1427→      await execAsync("git worktree prune", { cwd: projectRoot });
  1428→    } catch {
  1429→      // Ignore - prune is best-effort
  1430→    }
  1431→
  1432→    // Recreate worktree
  1433→    await execAsync(
  1434→      `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1435→      { cwd: projectRoot },
  1436→    );
  1437→
  1438→    // Install pre-commit hook
  1439→    await installShadowHook(projectRoot);
  1440→
  1441→    return {
  1442→      success: true,
  1443→      branchCreated: false,
  1444→      worktreeCreated: true,
  1445→      gitignoreUpdated: false,
  1446→      initialCommit: false,
  1447→      alreadyExists: false,
  1448→      createdFromRemote: false,
  1449→      pushedToRemote: false,
  1450→    };
  1451→  } catch (error) {
  1452→    return {
  1453→      success: false,
  1454→      branchCreated: false,
  1455→      worktreeCreated: false,
  1456→      gitignoreUpdated: false,
  1457→      initialCommit: false,
  1458→      alreadyExists: false,
  1459→      createdFromRemote: false,
  1460→      pushedToRemote: false,
  1461→      error: error instanceof Error ? error.message : String(error),
  1462→    };
  1463→  }
  1464→}
  1465→

