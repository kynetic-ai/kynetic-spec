     1→/**
     2→ * Tests for object merging algorithms
     3→ */
     4→
     5→import { describe, expect, it } from "vitest";
     6→import { mergeObjects } from "../src/merge/objects.js";
     7→
     8→describe("mergeObjects", () => {
     9→  describe("field additions", () => {
    10→    it("should include field added only in ours", () => {
    11→      // AC: @yaml-merge-driver ac-3
    12→      const base = { a: 1 };
    13→      const ours = { a: 1, b: 2 };
    14→      const theirs = { a: 1 };
    15→
    16→      const result = mergeObjects(base, ours, theirs);
    17→
    18→      expect(result.merged).toEqual({ a: 1, b: 2 });
    19→      expect(result.conflicts).toHaveLength(0);
    20→    });
    21→
    22→    it("should include field added only in theirs", () => {
    23→      // AC: @yaml-merge-driver ac-3
    24→      const base = { a: 1 };
    25→      const ours = { a: 1 };
    26→      const theirs = { a: 1, c: 3 };
    27→
    28→      const result = mergeObjects(base, ours, theirs);
    29→
    30→      expect(result.merged).toEqual({ a: 1, c: 3 });
    31→      expect(result.conflicts).toHaveLength(0);
    32→    });
    33→
    34→    it("should include fields added in both branches", () => {
    35→      // AC: @yaml-merge-driver ac-3
    36→      const base = { a: 1 };
    37→      const ours = { a: 1, b: 2 };
    38→      const theirs = { a: 1, c: 3 };
    39→
    40→      const result = mergeObjects(base, ours, theirs);
    41→
    42→      expect(result.merged).toEqual({ a: 1, b: 2, c: 3 });
    43→      expect(result.conflicts).toHaveLength(0);
    44→    });
    45→
    46→    it("should not conflict when same field added with same value in both", () => {
    47→      // AC: @yaml-merge-driver ac-3
    48→      const base = { a: 1 };
    49→      const ours = { a: 1, b: 2 };
    50→      const theirs = { a: 1, b: 2 };
    51→
    52→      const result = mergeObjects(base, ours, theirs);
    53→
    54→      expect(result.merged).toEqual({ a: 1, b: 2 });
    55→      expect(result.conflicts).toHaveLength(0);
    56→    });
    57→
    58→    it("should conflict when same field added with different values in both", () => {
    59→      // AC: @yaml-merge-driver ac-3
    60→      const base = { a: 1 };
    61→      const ours = { a: 1, b: 2 };
    62→      const theirs = { a: 1, b: 3 };
    63→
    64→      const result = mergeObjects(base, ours, theirs);
    65→
    66→      expect(result.merged).toEqual({ a: 1, b: 2 }); // Default to ours
    67→      expect(result.conflicts).toHaveLength(1);
    68→      expect(result.conflicts[0]).toMatchObject({
    69→        type: "scalar_field",
    70→        path: "b",
    71→        oursValue: 2,
    72→        theirsValue: 3,
    73→      });
    74→    });
    75→  });
    76→
    77→  describe("field modifications", () => {
