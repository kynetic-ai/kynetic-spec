    79→      // AC: @yaml-merge-driver ac-3
    80→      const base = { a: 1, b: 2 };
    81→      const ours = { a: 1, b: 3 };
    82→      const theirs = { a: 1, b: 2 };
    83→
    84→      const result = mergeObjects(base, ours, theirs);
