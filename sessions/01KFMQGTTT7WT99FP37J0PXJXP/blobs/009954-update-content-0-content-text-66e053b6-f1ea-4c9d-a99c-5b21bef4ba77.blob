   355→/**
   356→ * Format completeness warnings for display
   357→ * AC: @spec-completeness ac-4
   358→ */
   359→function formatCompletenessWarnings(
   360→  warnings: CompletenessWarning[],
   361→  verbose: boolean,
   362→): void {
   363→  if (warnings.length === 0) {
   364→    console.log(chalk.green("Completeness: OK"));
   365→    return;
   366→  }
   367→
   368→  console.log(chalk.yellow(`\nCompleteness warnings: ${warnings.length}`));
   369→
   370→  // Group by type
   371→  const missingAC = warnings.filter(
   372→    (w) => w.type === "missing_acceptance_criteria",
   373→  );
   374→  const missingDesc = warnings.filter((w) => w.type === "missing_description");
   375→  const statusMismatch = warnings.filter(
   376→    (w) => w.type === "status_inconsistency",
   377→  );
   378→  const missingTestCoverage = warnings.filter(
   379→    (w) => w.type === "missing_test_coverage",
   380→  );
   381→  const automationNoSpec = warnings.filter(
   382→    (w) => w.type === "automation_eligible_no_spec",
   383→  );
   384→
   385→  // AC: @spec-completeness ac-4
   386→  // Show summary with counts by issue type
   387→  if (missingAC.length > 0) {
   388→    console.log(
   389→      chalk.yellow(`  Missing acceptance criteria: ${missingAC.length}`),
   390→    );
   391→    const shown = verbose ? missingAC : missingAC.slice(0, 3);
   392→    for (const w of shown) {
   393→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
   394→    }
   395→    if (!verbose && missingAC.length > 3) {
   396→      console.log(chalk.gray(`    ... and ${missingAC.length - 3} more`));
   397→    }
   398→  }
   399→
   400→  if (missingDesc.length > 0) {
   401→    console.log(chalk.yellow(`  Missing descriptions: ${missingDesc.length}`));
   402→    const shown = verbose ? missingDesc : missingDesc.slice(0, 3);
   403→    for (const w of shown) {
   404→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
   405→    }
   406→    if (!verbose && missingDesc.length > 3) {
   407→      console.log(chalk.gray(`    ... and ${missingDesc.length - 3} more`));
   408→    }
   409→  }
   410→
   411→  if (statusMismatch.length > 0) {
   412→    console.log(
   413→      chalk.yellow(`  Status inconsistencies: ${statusMismatch.length}`),
   414→    );
   415→    for (const w of statusMismatch) {
   416→      console.log(chalk.yellow(`    ! ${w.message}`));
   417→      if (w.details) {
   418→        console.log(chalk.gray(`      ${w.details}`));
   419→      }
   420→    }
   421→  }
   422→
   423→  if (missingTestCoverage.length > 0) {
   424→    console.log(
   425→      chalk.yellow(`  Missing test coverage: ${missingTestCoverage.length}`),
   426→    );
   427→    const shown = verbose
   428→      ? missingTestCoverage
   429→      : missingTestCoverage.slice(0, 3);
   430→    for (const w of shown) {
   431→      console.log(chalk.yellow(`    ! ${w.itemRef} - ${w.itemTitle}`));
   432→      if (w.details) {
   433→        console.log(chalk.gray(`      ${w.details}`));
   434→      }
   435→    }
   436→    if (!verbose && missingTestCoverage.length > 3) {
   437→      console.log(
   438→        chalk.gray(`    ... and ${missingTestCoverage.length - 3} more`),
   439→      );
   440→    }
   441→  }
   442→
   443→  // AC: @task-automation-eligibility ac-21, ac-23
   444→  if (automationNoSpec.length > 0) {
   445→    console.log(
   446→      chalk.yellow(`  Automation without spec: ${automationNoSpec.length}`),
   447→    );
   448→    const shown = verbose ? automationNoSpec : automationNoSpec.slice(0, 3);
   449→    for (const w of shown) {
   450→      console.log(chalk.yellow(`    ! ${w.itemRef} - ${w.itemTitle}`));
   451→      console.log(chalk.gray(`      ${w.message}`));
   452→    }
   453→    if (!verbose && automationNoSpec.length > 3) {
   454→      console.log(
   455→        chalk.gray(`    ... and ${automationNoSpec.length - 3} more`),
   456→      );
   457→    }
   458→  }
   459→}
