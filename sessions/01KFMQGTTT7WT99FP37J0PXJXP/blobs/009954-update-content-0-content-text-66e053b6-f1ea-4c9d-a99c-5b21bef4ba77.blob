    31→/**
    32→ * Staleness warning types
    33→ * AC: @stale-status-detection
    34→ */
    35→interface StalenessWarning {
    36→  type:
    37→    | "parent-pending-children-done"
    38→    | "spec-implemented-no-task"
    39→    | "task-done-spec-not-started"
    40→    | "automation-blocking";
    41→  message: string;
    42→  refs: string[];
    43→}
    44→
    45→/**
    46→ * Check for stale status mismatches between specs and tasks
    47→ * AC: @stale-status-detection ac-1, ac-2, ac-3
    48→ */
    49→function checkStaleness(
    50→  items: LoadedSpecItem[],
    51→  tasks: LoadedTask[],
    52→  refIndex: ReferenceIndex,
    53→): StalenessWarning[] {
    54→  const warnings: StalenessWarning[] = [];
    55→
    56→  // AC: @stale-status-detection ac-1 (parent-pending-children-done)
    57→  // Check if task with dependencies is pending but all dependencies are completed
    58→  for (const task of tasks) {
    59→    // Only check pending/in_progress tasks with dependencies
    60→    if (task.status !== "pending" && task.status !== "in_progress") continue;
    61→    if (!task.depends_on || task.depends_on.length === 0) continue;
    62→
    63→    // Resolve all dependency tasks
    64→    const depTasks = task.depends_on
    65→      .map((depRef) => {
    66→        const result = refIndex.resolve(depRef);
    67→        if (!result.ok) return null;
    68→        return tasks.find((t) => t._ulid === result.ulid);
    69→      })
    70→      .filter((t): t is LoadedTask => t !== null);
    71→
    72→    if (depTasks.length === 0) continue;
    73→
    74→    // Check if all dependencies are completed and their linked specs are implemented
    75→    const allDepsDone = depTasks.every((depTask) => {
    76→      if (depTask.status !== "completed") return false;
    77→
    78→      // If the dep task has a spec_ref, check if that spec is implemented
    79→      if (depTask.spec_ref) {
    80→        const result = refIndex.resolve(depTask.spec_ref);
    81→        if (!result.ok) return true; // Missing spec ref doesn't block
    82→        const spec = items.find((item) => item._ulid === result.ulid);
    83→        return spec?.status?.implementation === "implemented";
    84→      }
    85→      return true;
    86→    });
    87→
    88→    if (allDepsDone) {
    89→      const taskRef = task.slugs[0] || refIndex.shortUlid(task._ulid);
    90→      warnings.push({
    91→        type: "parent-pending-children-done",
    92→        message: `Task @${taskRef} is ${task.status} but all dependencies are completed. Consider completing or reviewing.`,
    93→        refs: [task._ulid],
    94→      });
    95→    }
    96→  }
    97→
    98→  // AC: @stale-status-detection ac-2 (spec-implemented-no-task)
    99→  // Check if spec is implemented but has no completed tasks
   100→  for (const item of items) {
   101→    if (item.status?.implementation !== "implemented") continue;
   102→
   103→    // Find completed tasks that reference this spec
   104→    const completedTasks = tasks.filter((task) => {
   105→      if (task.status !== "completed" || !task.spec_ref) return false;
   106→      const result = refIndex.resolve(task.spec_ref);
   107→      return result.ok && result.ulid === item._ulid;
   108→    });
   109→
   110→    if (completedTasks.length === 0) {
   111→      const specRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
   112→      warnings.push({
   113→        type: "spec-implemented-no-task",
   114→        message: `Spec @${specRef} is implemented but has no completed tasks. Verify implementation or link existing task.`,
   115→        refs: [item._ulid],
   116→      });
   117→    }
   118→  }
   119→
   120→  // AC: @stale-status-detection ac-3 (task-done-spec-not-started)
   121→  // Check if task is completed but spec is still not_started
   122→  for (const task of tasks) {
   123→    if (task.status !== "completed") continue;
   124→    if (!task.spec_ref) continue;
   125→
   126→    // Resolve spec reference
   127→    const result = refIndex.resolve(task.spec_ref);
   128→    if (!result.ok) continue;
   129→
   130→    const spec = items.find((item) => item._ulid === result.ulid);
   131→    if (!spec) continue;
   132→
   133→    if (spec.status?.implementation === "not_started") {
   134→      const taskRef = task.slugs[0] || refIndex.shortUlid(task._ulid);
   135→      const specRef = spec.slugs[0] || refIndex.shortUlid(spec._ulid);
   136→      warnings.push({
   137→        type: "task-done-spec-not-started",
   138→        message: `Task @${taskRef} completed but spec @${specRef} is not_started. Update spec status.`,
   139→        refs: [task._ulid, spec._ulid],
   140→      });
   141→    }
   142→  }
   143→
   144→  // AC: @validation ac-1
   145→  // Check for manual_only parents blocking eligible children
   146→  for (const parentTask of tasks) {
   147→    if (parentTask.automation !== "manual_only") continue;
   148→
   149→    // Find tasks that depend on this parent
   150→    const dependentTasks = tasks.filter((t) =>
   151→      t.depends_on?.some((depRef) => {
   152→        const result = refIndex.resolve(depRef);
   153→        return result.ok && result.ulid === parentTask._ulid;
   154→      }),
   155→    );
   156→
   157→    // Filter for eligible children
   158→    const eligibleChildren = dependentTasks.filter(
   159→      (t) => t.automation === "eligible",
   160→    );
   161→
   162→    if (eligibleChildren.length > 0) {
   163→      const parentRef =
   164→        parentTask.slugs[0] || refIndex.shortUlid(parentTask._ulid);
   165→      const childRefs = eligibleChildren.map(
   166→        (c) => `@${c.slugs[0] || refIndex.shortUlid(c._ulid)}`,
   167→      );
   168→
   169→      warnings.push({
   170→        type: "automation-blocking",
   171→        message: `Task @${parentRef} is manual_only and blocks ${eligibleChildren.length} eligible child task(s): ${childRefs.join(", ")}`,
   172→        refs: [parentTask._ulid, ...eligibleChildren.map((c) => c._ulid)],
   173→      });
   174→    }
   175→  }
   176→
   177→  return warnings;
   178→}
