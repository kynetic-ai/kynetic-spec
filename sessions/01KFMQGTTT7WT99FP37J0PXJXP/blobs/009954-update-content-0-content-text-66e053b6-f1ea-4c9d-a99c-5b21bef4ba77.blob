   461→/**
   462→ * Format alignment warnings for display
   463→ */
   464→function formatAlignmentWarnings(
   465→  warnings: AlignmentWarning[],
   466→  verbose: boolean,
   467→): void {
   468→  if (warnings.length === 0) {
   469→    console.log(chalk.green("Alignment: OK"));
   470→    return;
   471→  }
   472→
   473→  console.log(chalk.yellow(`\nAlignment warnings: ${warnings.length}`));
   474→
   475→  // Group by type
   476→  const orphaned = warnings.filter((w) => w.type === "orphaned_spec");
   477→  const mismatches = warnings.filter((w) => w.type === "status_mismatch");
   478→  const stale = warnings.filter((w) => w.type === "stale_implementation");
   479→
   480→  if (orphaned.length > 0) {
   481→    console.log(
   482→      chalk.yellow(`  Orphaned specs (no tasks): ${orphaned.length}`),
   483→    );
   484→    const shown = verbose ? orphaned : orphaned.slice(0, 3);
   485→    for (const w of shown) {
   486→      console.log(chalk.gray(`    ○ ${w.specTitle}`));
   487→    }
   488→    if (!verbose && orphaned.length > 3) {
   489→      console.log(chalk.gray(`    ... and ${orphaned.length - 3} more`));
   490→    }
   491→  }
   492→
   493→  if (mismatches.length > 0) {
   494→    console.log(chalk.yellow(`  Status mismatches: ${mismatches.length}`));
   495→    for (const w of mismatches) {
   496→      console.log(chalk.yellow(`    ! ${w.specTitle}`));
   497→      console.log(chalk.gray(`      ${w.message}`));
   498→    }
   499→  }
   500→
   501→  if (stale.length > 0) {
   502→    console.log(chalk.yellow(`  Stale implementation status: ${stale.length}`));
   503→    for (const w of stale) {
   504→      console.log(chalk.yellow(`    ! ${w.message}`));
   505→    }
   506→  }
   507→}
