   264→/**
   265→ * Format convention validation results for display
   266→ * AC: @convention-definitions ac-3, ac-4
   267→ */
   268→function formatConventionValidationResult(
   269→  result: ConventionValidationResult,
   270→): void {
   271→  if (result.valid && result.skipped.length === 0) {
   272→    console.log(chalk.green("Conventions: OK"));
   273→    return;
   274→  }
   275→
   276→  // AC: @convention-definitions ac-4
   277→  // Skipped prose conventions
   278→  if (result.skipped.length > 0) {
   279→    for (const domain of result.skipped) {
   280→      console.log(chalk.gray(`ℹ Skipping prose convention: ${domain}`));
   281→    }
   282→  }
   283→
   284→  // AC: @convention-definitions ac-3
   285→  // Validation errors
   286→  if (result.errors.length > 0) {
   287→    console.log(chalk.red(`\nConvention violations: ${result.errors.length}`));
   288→    for (const err of result.errors) {
   289→      console.log(chalk.red(`  ✗ ${err.domain}`));
   290→      console.log(chalk.gray(`    ${err.message}`));
   291→      if (err.expected) {
   292→        console.log(chalk.gray(`    Expected: ${err.expected}`));
   293→      }
   294→      if (err.location) {
   295→        console.log(chalk.gray(`    Location: ${err.location}`));
   296→      }
   297→    }
   298→  } else {
   299→    console.log(chalk.green("\nConventions: OK"));
   300→  }
   301→
   302→  // Stats
   303→  console.log(
   304→    chalk.gray(`\nConventions checked: ${result.stats.conventionsChecked}`),
   305→  );
   306→  console.log(
   307→    chalk.gray(`Conventions skipped: ${result.stats.conventionsSkipped}`),
   308→  );
   309→}
