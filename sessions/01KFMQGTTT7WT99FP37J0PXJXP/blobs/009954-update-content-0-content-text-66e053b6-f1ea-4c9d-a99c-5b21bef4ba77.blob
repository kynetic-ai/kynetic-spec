   509→/**
   510→ * Format fix results for display
   511→ */
   512→function formatFixResult(result: FixResult): void {
   513→  if (result.fixesApplied.length === 0) {
   514→    console.log(chalk.gray("\nNo auto-fixable issues found."));
   515→    return;
   516→  }
   517→
   518→  console.log(
   519→    chalk.cyan(
   520→      `\n✓ Applied ${result.fixesApplied.length} fix(es) to ${result.filesModified} file(s):`,
   521→    ),
   522→  );
   523→
   524→  for (const fix of result.fixesApplied) {
   525→    const typeLabel = {
   526→      ulid_regenerated: "ULID regenerated",
   527→      timestamp_added: "Timestamp added",
   528→      status_added: "Status added",
   529→    }[fix.type];
   530→
   531→    const shortFile = path.basename(fix.file);
   532→    console.log(chalk.cyan(`  ✓ ${shortFile}:${fix.path} - ${typeLabel}`));
   533→  }
   534→
   535→  if (result.errors.length > 0) {
   536→    console.log(chalk.yellow(`\nFix errors: ${result.errors.length}`));
   537→    for (const err of result.errors) {
   538→      console.log(chalk.yellow(`  ! ${err.file}: ${err.message}`));
   539→    }
   540→  }
   541→}
   542→
   543→/**
   544→ * Collect all files that can be fixed
   545→ */
   546→async function collectFixableFiles(ctx: {
   547→  rootDir: string;
   548→  specDir?: string;
   549→  manifest?: { includes?: string[] } | null;
   550→  manifestPath?: string | null;
   551→}): Promise<string[]> {
   552→  const files: string[] = [];
   553→
   554→  // Task files (exclude test fixtures)
   555→  const taskFiles = await findTaskFiles(ctx.rootDir);
   556→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, "spec"));
   557→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
   558→  files.push(
   559→    ...allTaskFiles.filter(
   560→      (f) => !f.includes("fixtures") && !f.includes("test"),
   561→    ),
   562→  );
   563→
   564→  // Spec files from includes
   565→  if (ctx.manifest && ctx.manifestPath) {
   566→    const manifestDir = path.dirname(ctx.manifestPath);
   567→    const includes = ctx.manifest.includes || [];
   568→
   569→    for (const include of includes) {
   570→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   571→      files.push(...expandedPaths);
   572→    }
   573→  }
   574→
   575→  // Inbox file
   576→  const inboxPath = path.join(ctx.rootDir, "spec", "kynetic.inbox.yaml");
   577→  try {
   578→    await import("node:fs/promises").then((fs) => fs.access(inboxPath));
   579→    files.push(inboxPath);
   580→  } catch {
   581→    // Inbox file doesn't exist, skip
   582→  }
   583→
   584→  return [...new Set(files)];
   585→}
   586→
   587→/**
   588→ * Format validation result for display
   589→ */
   590→function formatValidationResult(
   591→  result: ValidationResult,
   592→  verbose: boolean,
   593→): void {
   594→  // Header
   595→  if (result.valid) {
   596→    console.log(chalk.green.bold("✓ Validation passed"));
   597→  } else {
   598→    console.log(chalk.red.bold("✗ Validation failed"));
   599→  }
   600→
   601→  console.log(chalk.gray("─".repeat(40)));
   602→  console.log(`Files checked: ${result.stats.filesChecked}`);
   603→  console.log(`Items checked: ${result.stats.itemsChecked}`);
   604→  console.log(`Tasks checked: ${result.stats.tasksChecked}`);
   605→
   606→  // AC-meta-manifest-2: Display meta summary line
   607→  if (result.metaStats) {
   608→    console.log(
   609→      `Meta: ${result.metaStats.agents} agents, ${result.metaStats.workflows} workflows, ${result.metaStats.conventions} conventions`,
   610→    );
   611→  }
   612→
   613→  // Schema errors
   614→  if (result.schemaErrors.length > 0) {
   615→    console.log(chalk.red(`\nSchema errors: ${result.schemaErrors.length}`));
   616→    for (const err of result.schemaErrors) {
   617→      const location = err.path ? `${err.file}:${err.path}` : err.file;
   618→      console.log(chalk.red(`  ✗ ${location}`));
   619→      console.log(chalk.gray(`    ${err.message}`));
   620→      if (verbose && err.details) {
   621→        console.log(chalk.gray(`    ${JSON.stringify(err.details)}`));
   622→      }
   623→    }
   624→  } else {
   625→    console.log(chalk.green("\nSchema: OK"));
   626→  }
   627→
   628→  // Reference errors
   629→  if (result.refErrors.length > 0) {
   630→    console.log(chalk.red(`\nReference errors: ${result.refErrors.length}`));
   631→    for (const err of result.refErrors) {
   632→      const location = err.sourceFile
   633→        ? `${err.sourceFile} (${err.field})`
   634→        : `${err.sourceUlid?.slice(0, 8)} (${err.field})`;
   635→      console.log(chalk.red(`  ✗ ${err.ref}`));
   636→      console.log(chalk.gray(`    ${err.message}`));
   637→      console.log(chalk.gray(`    in: ${location}`));
   638→    }
   639→  } else {
   640→    console.log(chalk.green("References: OK"));
   641→  }
   642→
   643→  // Reference warnings (deprecated targets)
   644→  if (result.refWarnings.length > 0) {
   645→    console.log(
   646→      chalk.yellow(`\nReference warnings: ${result.refWarnings.length}`),
   647→    );
   648→    const shown = verbose ? result.refWarnings : result.refWarnings.slice(0, 5);
   649→    for (const warn of shown) {
   650→      const location = warn.sourceFile
   651→        ? `${warn.sourceFile} (${warn.field})`
   652→        : `${warn.sourceUlid?.slice(0, 8)} (${warn.field})`;
   653→      console.log(chalk.yellow(`  ⚠ ${warn.ref}`));
   654→      console.log(chalk.gray(`    ${warn.message}`));
   655→      console.log(chalk.gray(`    in: ${location}`));
   656→    }
   657→    if (!verbose && result.refWarnings.length > 5) {
   658→      console.log(
   659→        chalk.gray(
   660→          `  ... and ${result.refWarnings.length - 5} more (use -v to see all)`,
   661→        ),
   662→      );
   663→    }
   664→  }
   665→
   666→  // AC: @trait-edge-cases ac-2
   667→  // Trait cycle errors
   668→  if (result.traitCycleErrors.length > 0) {
   669→    console.log(
   670→      chalk.red(`\nTrait cycle errors: ${result.traitCycleErrors.length}`),
   671→    );
   672→    for (const err of result.traitCycleErrors) {
   673→      console.log(chalk.red(`  ✗ ${err.traitRef} - ${err.traitTitle}`));
   674→      console.log(chalk.gray(`    ${err.message}`));
   675→    }
   676→  }
   677→
   678→  // Orphans (warnings, not errors)
   679→  if (result.orphans.length > 0) {
   680→    console.log(
   681→      chalk.yellow(`\nOrphans (not referenced): ${result.orphans.length}`),
   682→    );
   683→    if (verbose) {
   684→      for (const orphan of result.orphans) {
   685→        console.log(
   686→          chalk.yellow(
   687→            `  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`,
   688→          ),
   689→        );
   690→      }
   691→    } else {
   692→      // Show first few
   693→      const shown = result.orphans.slice(0, 5);
   694→      for (const orphan of shown) {
   695→        console.log(
   696→          chalk.yellow(
   697→            `  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`,
   698→          ),
   699→        );
   700→      }
   701→      if (result.orphans.length > 5) {
   702→        console.log(
   703→          chalk.gray(
   704→            `  ... and ${result.orphans.length - 5} more (use -v to see all)`,
   705→          ),
   706→        );
   707→      }
   708→    }
   709→  }
   710→}
   711→
   712→/**
   713→ * Register validate command
   714→ */
   715→export function registerValidateCommand(program: Command): void {
   716→  program
   717→    .command("validate")
   718→    .description("Validate spec files")
   719→    .option("--schema", "Check schema conformance only")
   720→    .option("--refs", "Check reference resolution only")
   721→    .option("--orphans", "Find orphaned items only")
   722→    .option("--alignment", "Check spec-task alignment")
   723→    .option(
   724→      "--completeness",
   725→      "Check spec completeness (missing AC, descriptions, status inconsistencies)",
   726→    )
   727→    .option("--conventions", "Validate conventions")
   728→    .option(
   729→      "--staleness",
   730→      "Check for stale status mismatches between specs and tasks",
   731→    )
   732→    .option("--skills", "Validate skill files (.claude/skills/*/SKILL.md)")
   733→    .option(
   734→      "--fix",
   735→      "Auto-fix issues where possible (invalid ULIDs, missing timestamps)",
   736→    )
   737→    .option("-v, --verbose", "Show detailed output")
   738→    .option("--strict", "Treat orphans and staleness warnings as errors")
   739→    .action(async (options) => {
   740→      try {
   741→        const ctx = await initContext();
   742→
   743→        if (!ctx.manifestPath) {
   744→          error(validationStrings.noManifest);
   745→          console.log(validationStrings.initHint);
   746→          process.exit(EXIT_CODES.ERROR);
   747→        }
   748→
   749→        // Determine which checks to run
   750→        const runAll =
   751→          !options.schema &&
   752→          !options.refs &&
   753→          !options.orphans &&
   754→          !options.alignment &&
   755→          !options.completeness &&
   756→          !options.conventions &&
   757→          !options.skills;
   758→        const validateOptions = {
   759→          schema: runAll || options.schema,
   760→          refs: runAll || options.refs,
   761→          orphans: runAll || options.orphans,
   762→          completeness: runAll || options.completeness,
   763→        };
   764→
   765→        const result = await validate(ctx, validateOptions);
   766→
   767→        // In strict mode, orphans are errors
   768→        if (options.strict && result.orphans.length > 0) {
   769→          result.valid = false;
   770→        }
   771→
   772→        output(result, () => formatValidationResult(result, options.verbose));
   773→
   774→        // Run auto-fix if requested
   775→        if (options.fix) {
   776→          const filesToFix = await collectFixableFiles(ctx);
   777→          const fixResult = await fixFiles(filesToFix);
   778→          formatFixResult(fixResult);
   779→
   780→          // Re-run validation after fixes to show updated status
   781→          if (fixResult.fixesApplied.length > 0) {
   782→            console.log(validationStrings.revalidating);
   783→            const revalidateResult = await validate(ctx, validateOptions);
   784→            if (revalidateResult.valid) {
   785→              console.log(validationStrings.nowPasses);
   786→            } else {
   787→              console.log(validationStrings.issuesRemain);
   788→            }
   789→            // Update result for exit code
   790→            result.valid = revalidateResult.valid;
   791→            result.schemaErrors = revalidateResult.schemaErrors;
   792→            result.refErrors = revalidateResult.refErrors;
   793→          }
   794→        }
   795→
   796→        // Run alignment check if requested or running all checks
   797→        if (options.alignment || runAll) {
   798→          const tasks = await loadAllTasks(ctx);
   799→          const items = await loadAllItems(ctx);
   800→          const refIndex = new ReferenceIndex(tasks, items);
   801→          const alignmentIndex = new AlignmentIndex(tasks, items);
   802→          alignmentIndex.buildLinks(refIndex);
   803→
   804→          const alignmentWarnings = alignmentIndex.findAlignmentWarnings();
   805→          formatAlignmentWarnings(alignmentWarnings, options.verbose);
   806→
   807→          // Show alignment stats
   808→          const stats = alignmentIndex.getStats();
   809→          console.log(
   810→            validationStrings.alignmentStats(
   811→              stats.specsWithTasks,
   812→              stats.totalSpecs,
   813→              stats.alignedSpecs,
   814→            ),
   815→          );
   816→        }
   817→
   818→        // Show completeness warnings if any
   819→        // AC: @spec-completeness ac-4
   820→        if (result.completenessWarnings.length > 0) {
   821→          formatCompletenessWarnings(
   822→            result.completenessWarnings,
   823→            options.verbose,
   824→          );
   825→        }
   826→
   827→        // Run convention validation if requested
   828→        // AC: @convention-definitions ac-3, ac-4
   829→        if (options.conventions) {
   830→          try {
   831→            const metaCtx = await loadMetaContext(ctx);
   832→            if (metaCtx && metaCtx.conventions.length > 0) {
   833→              // For now, we just validate that conventions are well-formed
   834→              // Full validation against actual content (commits, notes, etc.)
   835→              // would require additional content gathering logic
   836→              const conventionResult = validateConventions(
   837→                metaCtx.conventions,
   838→                {},
   839→              );
   840→              formatConventionValidationResult(conventionResult);
   841→
   842→              if (!conventionResult.valid) {
   843→                result.valid = false;
   844→              }
   845→            } else {
   846→              console.log(
   847→                chalk.gray("No conventions defined in meta manifest"),
   848→              );
   849→            }
   850→          } catch (_err) {
   851→            console.log(
   852→              chalk.yellow(
   853→                "Warning: Could not load meta manifest for convention validation",
   854→              ),
   855→            );
   856→          }
   857→        }
   858→
   859→        // Run staleness checks if requested
   860→        // AC: @stale-status-detection ac-4, ac-5
   861→        if (options.staleness) {
   862→          const tasks = await loadAllTasks(ctx);
   863→          const items = await loadAllItems(ctx);
   864→          const refIndex = new ReferenceIndex(tasks, items);
   865→
   866→          const stalenessWarnings = checkStaleness(items, tasks, refIndex);
   867→          formatStalenessWarnings(stalenessWarnings, options.verbose);
   868→
   869→          // AC: @stale-status-detection ac-5 (staleness-exit-code)
   870→          // With --strict, staleness warnings cause validation failure
   871→          if (options.strict && stalenessWarnings.length > 0) {
   872→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   873→          }
   874→        }
   875→
   876→        // Run skill file validation if requested or running all checks
   877→        if (runAll || options.skills) {
   878→          const skillResult = await validateSkills(ctx.rootDir);
   879→          formatSkillValidationResult(skillResult, options.verbose);
   880→
   881→          if (!skillResult.valid) {
   882→            result.valid = false;
   883→          }
   884→        }
   885→
   886→        if (!result.valid) {
   887→          process.exit(EXIT_CODES.ERROR);
   888→        }
   889→      } catch (err) {
   890→        error(validationStrings.failed, err);
   891→        process.exit(EXIT_CODES.ERROR);
   892→      }
   893→    });
   894→
   895→  // Alias: kspec lint
   896→  program
   897→    .command("lint")
   898→    .description("Alias for validate with style checks")
   899→    .option("--schema", "Check schema conformance only")
   900→    .option("--refs", "Check reference resolution only")
   901→    .option("--orphans", "Find orphaned items only")
   902→    .option(
   903→      "--completeness",
   904→      "Check spec completeness (missing AC, descriptions, status inconsistencies)",
   905→    )
   906→    .option(
   907→      "--fix",
   908→      "Auto-fix issues where possible (invalid ULIDs, missing timestamps)",
   909→    )
   910→    .option("-v, --verbose", "Show detailed output")
   911→    .option("--strict", "Treat orphans as errors")
   912→    .action(async (options) => {
   913→      try {
   914→        const ctx = await initContext();
   915→
   916→        if (!ctx.manifestPath) {
   917→          error(validationStrings.noManifest);
   918→          process.exit(EXIT_CODES.ERROR);
   919→        }
   920→
   921→        const runAll =
   922→          !options.schema &&
   923→          !options.refs &&
   924→          !options.orphans &&
   925→          !options.completeness;
   926→        const validateOptions = {
   927→          schema: runAll || options.schema,
   928→          refs: runAll || options.refs,
   929→          orphans: runAll || options.orphans,
   930→          completeness: runAll || options.completeness,
   931→        };
   932→
   933→        const result = await validate(ctx, validateOptions);
   934→
   935→        if (options.strict && result.orphans.length > 0) {
   936→          result.valid = false;
   937→        }
   938→
   939→        output(result, () => formatValidationResult(result, options.verbose));
   940→
   941→        // Run auto-fix if requested
   942→        if (options.fix) {
   943→          const filesToFix = await collectFixableFiles(ctx);
   944→          const fixResult = await fixFiles(filesToFix);
   945→          formatFixResult(fixResult);
   946→
   947→          // Re-run validation after fixes
   948→          if (fixResult.fixesApplied.length > 0) {
   949→            console.log(validationStrings.revalidating);
   950→            const revalidateResult = await validate(ctx, validateOptions);
   951→            if (revalidateResult.valid) {
   952→              console.log(validationStrings.nowPasses);
   953→            } else {
   954→              console.log(validationStrings.issuesRemain);
   955→            }
   956→            result.valid = revalidateResult.valid;
   957→          }
   958→        }
   959→
   960→        if (!result.valid) {
   961→          process.exit(EXIT_CODES.ERROR);
   962→        }
   963→      } catch (err) {
   964→        error(validationStrings.lintFailed, err);
   965→        process.exit(EXIT_CODES.ERROR);
   966→      }
   967→    });
   968→}
