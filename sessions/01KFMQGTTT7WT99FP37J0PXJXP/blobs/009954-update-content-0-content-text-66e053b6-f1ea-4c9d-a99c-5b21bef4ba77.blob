   311→/**
   312→ * Format skill validation results for display
   313→ */
   314→function formatSkillValidationResult(
   315→  result: SkillValidationResult,
   316→  verbose: boolean,
   317→): void {
   318→  if (result.filesChecked === 0) {
   319→    console.log(chalk.gray("Skills: No skill files found"));
   320→    return;
   321→  }
   322→
   323→  if (result.valid) {
   324→    console.log(
   325→      chalk.green(`Skills: OK (${result.filesChecked} files checked)`),
   326→    );
   327→    return;
   328→  }
   329→
   330→  console.log(chalk.red(`\nSkill validation errors: ${result.errors.length}`));
   331→  console.log(chalk.gray(`Files checked: ${result.filesChecked}`));
   332→
   333→  // Group errors by file
   334→  const errorsByFile = new Map<string, typeof result.errors>();
   335→  for (const err of result.errors) {
   336→    const existing = errorsByFile.get(err.file) || [];
   337→    existing.push(err);
   338→    errorsByFile.set(err.file, existing);
   339→  }
   340→
   341→  for (const [file, errors] of errorsByFile.entries()) {
   342→    console.log(chalk.yellow(`\n  ${file}:`));
   343→    const shown = verbose ? errors : errors.slice(0, 5);
   344→    for (const err of shown) {
   345→      const location = err.line ? `:${err.line}` : "";
   346→      console.log(chalk.red(`    ✗ ${err.type}${location}`));
   347→      console.log(chalk.gray(`      ${err.message}`));
   348→    }
   349→    if (!verbose && errors.length > 5) {
   350→      console.log(chalk.gray(`    ... and ${errors.length - 5} more`));
   351→    }
   352→  }
   353→}
