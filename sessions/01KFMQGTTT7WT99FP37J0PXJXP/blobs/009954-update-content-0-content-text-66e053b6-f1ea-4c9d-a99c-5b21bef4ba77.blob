   180→/**
   181→ * Format staleness warnings for display
   182→ * AC: @stale-status-detection ac-4
   183→ */
   184→function formatStalenessWarnings(
   185→  warnings: StalenessWarning[],
   186→  verbose: boolean,
   187→): void {
   188→  if (warnings.length === 0) {
   189→    console.log(chalk.green("Staleness: OK"));
   190→    return;
   191→  }
   192→
   193→  console.log(chalk.yellow(`\nStaleness warnings: ${warnings.length}`));
   194→
   195→  // Group by type
   196→  const parentPending = warnings.filter(
   197→    (w) => w.type === "parent-pending-children-done",
   198→  );
   199→  const specNoTask = warnings.filter(
   200→    (w) => w.type === "spec-implemented-no-task",
   201→  );
   202→  const taskDoneSpecNot = warnings.filter(
   203→    (w) => w.type === "task-done-spec-not-started",
   204→  );
   205→  const automationBlocking = warnings.filter(
   206→    (w) => w.type === "automation-blocking",
   207→  );
   208→
   209→  if (parentPending.length > 0) {
   210→    console.log(
   211→      chalk.yellow(`  Parent pending, children done: ${parentPending.length}`),
   212→    );
   213→    const shown = verbose ? parentPending : parentPending.slice(0, 3);
   214→    for (const w of shown) {
   215→      console.log(chalk.yellow(`    ! ${w.message}`));
   216→    }
   217→    if (!verbose && parentPending.length > 3) {
   218→      console.log(chalk.gray(`    ... and ${parentPending.length - 3} more`));
   219→    }
   220→  }
   221→
   222→  if (specNoTask.length > 0) {
   223→    console.log(
   224→      chalk.yellow(`  Spec implemented, no task: ${specNoTask.length}`),
   225→    );
   226→    const shown = verbose ? specNoTask : specNoTask.slice(0, 3);
   227→    for (const w of shown) {
   228→      console.log(chalk.yellow(`    ! ${w.message}`));
   229→    }
   230→    if (!verbose && specNoTask.length > 3) {
   231→      console.log(chalk.gray(`    ... and ${specNoTask.length - 3} more`));
   232→    }
   233→  }
   234→
   235→  if (taskDoneSpecNot.length > 0) {
   236→    console.log(
   237→      chalk.yellow(`  Task done, spec not started: ${taskDoneSpecNot.length}`),
   238→    );
   239→    const shown = verbose ? taskDoneSpecNot : taskDoneSpecNot.slice(0, 3);
   240→    for (const w of shown) {
   241→      console.log(chalk.yellow(`    ! ${w.message}`));
   242→    }
   243→    if (!verbose && taskDoneSpecNot.length > 3) {
   244→      console.log(chalk.gray(`    ... and ${taskDoneSpecNot.length - 3} more`));
   245→    }
   246→  }
   247→
   248→  if (automationBlocking.length > 0) {
   249→    console.log(
   250→      chalk.yellow(`  Automation blocking: ${automationBlocking.length}`),
   251→    );
   252→    const shown = verbose ? automationBlocking : automationBlocking.slice(0, 3);
   253→    for (const w of shown) {
   254→      console.log(chalk.yellow(`    ! ${w.message}`));
   255→    }
   256→    if (!verbose && automationBlocking.length > 3) {
   257→      console.log(
   258→        chalk.gray(`    ... and ${automationBlocking.length - 3} more`),
   259→      );
   260→    }
   261→  }
   262→}
