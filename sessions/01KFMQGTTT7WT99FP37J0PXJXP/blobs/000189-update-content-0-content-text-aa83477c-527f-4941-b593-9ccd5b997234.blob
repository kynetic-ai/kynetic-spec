    33→
    34→/**
    35→ * Spec item with runtime metadata for source tracking.
    36→ * _sourceFile is not serialized - it's used to know where to write updates.
    37→ * _path tracks location within the file for nested items (e.g., "features[0].requirements[2]")
    38→ */
    39→export interface LoadedSpecItem extends SpecItem {
    40→  _sourceFile?: string;
    41→  _path?: string;
    42→}
    43→
    44→/**
    45→ * Task with runtime metadata for source tracking.
    46→ * _sourceFile is not serialized - it's used to know where to write updates.
    47→ */
    48→export interface LoadedTask extends Task {
    49→  _sourceFile?: string;
    50→}
    51→
    52→/**
    53→ * Parse YAML content into an object
    54→ * Uses the modern yaml library which has consistent type handling
    55→ */
    56→export function parseYaml<T>(content: string): T {
    57→  return YAML.parse(content) as T;
    58→}
    59→
    60→/**
    61→ * Serialize object to YAML
    62→ * Uses the modern yaml library for consistent formatting.
    63→ *
    64→ * WORKAROUND: The 'yaml' library (v2.8.2+) has a known behavior where block scalars
    65→ * containing whitespace-only lines accumulate extra blank lines on each parse-stringify
    66→ * cycle. The library's blockString() function adds indentation after newlines, which
    67→ * causes lines containing only spaces to grow. We post-process the output to filter
    68→ * these whitespace-only lines. See: https://github.com/eemeli/yaml - stringifyString.ts
    69→ */
    70→export function toYaml(obj: unknown): string {
    71→  let yamlString = YAML.stringify(obj, {
    72→    indent: 2,
    73→    lineWidth: 100,
    74→    sortMapEntries: false,
    75→  });
    76→
    77→  // Post-process to fix yaml library blank line accumulation bug.
    78→  // Filter out lines that contain only spaces/tabs (not truly empty lines).
    79→  yamlString = yamlString
    80→    .split("\n")
    81→    .filter((line) => !/^[ \t]+$/.test(line))
    82→    .join("\n");
    83→
    84→  return yamlString;
    85→}
    86→
    87→/**
    88→ * Read and parse a YAML file
    89→ */
    90→export async function readYamlFile<T>(filePath: string): Promise<T> {
    91→  const content = await fs.readFile(filePath, "utf-8");
    92→  return parseYaml<T>(content);
    93→}
    94→
    95→/**
    96→ * Write object to YAML file
    97→ */
    98→export async function writeYamlFile(
    99→  filePath: string,
   100→  data: unknown,
   101→): Promise<void> {
   102→  const content = toYaml(data);
   103→  await fs.writeFile(filePath, content, "utf-8");
   104→}
   105→
   106→/**
   107→ * Write object to YAML file while preserving formatting and comments.
   108→ *
   109→ * Note: This function is now equivalent to writeYamlFile() - the "preserve format"
   110→ * naming is historical. Both use toYaml() which includes the whitespace-only line
   111→ * fix. Kept for backwards compatibility with existing callers.
   112→ */
   113→export async function writeYamlFilePreserveFormat(
   114→  filePath: string,
   115→  data: unknown,
   116→): Promise<void> {
   117→  const content = toYaml(data);
   118→  await fs.writeFile(filePath, content, "utf-8");
   119→}
   120→
   121→/**
   122→ * Find task files in a directory
   123→ */
   124→export async function findTaskFiles(dir: string): Promise<string[]> {
   125→  const files: string[] = [];
   126→
   127→  try {
   128→    const entries = await fs.readdir(dir, { withFileTypes: true });
   129→
   130→    for (const entry of entries) {
   131→      const fullPath = path.join(dir, entry.name);
   132→
   133→      if (entry.isDirectory()) {
   134→        // Recurse into subdirectories
   135→        const subFiles = await findTaskFiles(fullPath);
   136→        files.push(...subFiles);
   137→      } else if (entry.isFile() && entry.name.endsWith(".tasks.yaml")) {
   138→        files.push(fullPath);
   139→      }
   140→    }
   141→  } catch (_error) {
   142→    // Directory doesn't exist or not readable
   143→  }
   144→
   145→  return files;
   146→}
   147→
   148→/**
   149→ * Find the manifest file (kynetic.yaml or kynetic.spec.yaml)
   150→ */
   151→export async function findManifest(startDir: string): Promise<string | null> {
   152→  let dir = startDir;
   153→
   154→  while (true) {
   155→    const candidates = ["kynetic.yaml", "kynetic.spec.yaml"];
   156→
   157→    for (const candidate of candidates) {
   158→      const filePath = path.join(dir, candidate);
   159→      try {
   160→        await fs.access(filePath);
   161→        return filePath;
   162→      } catch {
   163→        // File doesn't exist, try next
   164→      }
   165→    }
   166→
   167→    // Also check in spec/ subdirectory
   168→    const specDir = path.join(dir, "spec");
   169→    for (const candidate of candidates) {
   170→      const filePath = path.join(specDir, candidate);
   171→      try {
   172→        await fs.access(filePath);
   173→        return filePath;
   174→      } catch {
   175→        // File doesn't exist, try next
   176→      }
   177→    }
   178→
   179→    const parentDir = path.dirname(dir);
   180→    if (parentDir === dir) {
   181→      // Reached root
   182→      return null;
   183→    }
   184→    dir = parentDir;
   185→  }
   186→}
   187→
   188→/**
   189→ * Context for working with spec/task files.
   190→ *
   191→ * When shadow branch is enabled:
   192→ * - rootDir points to the project root (where .kspec/ lives)
   193→ * - specDir points to .kspec/ (where spec files are read/written)
   194→ * - All file operations use specDir for resolution
   195→ *
   196→ * Without shadow branch:
   197→ * - rootDir is the project root
   198→ * - specDir is rootDir/spec/ (traditional layout)
   199→ */
   200→export interface KspecContext {
   201→  /** Project root directory */
   202→  rootDir: string;
   203→  /** Spec files directory (.kspec/ when shadow enabled, otherwise spec/) */
   204→  specDir: string;
   205→  /** Path to manifest file */
   206→  manifestPath: string | null;
   207→  /** Parsed manifest */
   208→  manifest: Manifest | null;
   209→  /** Shadow branch configuration (null if not using shadow) */
   210→  shadow: ShadowConfig | null;
   211→}
   212→
   213→/**
   214→ * Initialize context by finding manifest.
   215→ *
   216→ * Detection order:
   217→ * 1. Check for shadow branch (.kspec/ directory)
   218→ * 2. Fall back to traditional spec/ directory
   219→ *
   220→ * When shadow is detected, all operations use .kspec/ as specDir.
   221→ */
   222→export async function initContext(startDir?: string): Promise<KspecContext> {
   223→  const cwd = startDir || process.cwd();
   224→
   225→  // Check if running from inside the shadow worktree
   226→  const mainProjectRoot = await detectRunningFromShadowWorktree(cwd);
   227→  if (mainProjectRoot) {
   228→    throw new ShadowError(
   229→      errors.project.runningFromShadow,
   230→      "RUNNING_FROM_SHADOW",
   231→      `Run from project root: cd ${path.relative(cwd, mainProjectRoot) || mainProjectRoot}`,
   232→    );
   233→  }
   234→
   235→  // Try to detect shadow branch first
   236→  const shadow = await detectShadow(cwd);
   237→
   238→  if (shadow?.enabled) {
   239→    // Shadow mode: use .kspec/ for everything
   240→    const specDir = shadow.worktreeDir;
   241→    const manifestPath = await findManifestInDir(specDir);
   242→
   243→    let manifest: Manifest | null = null;
   244→    if (manifestPath) {
   245→      try {
   246→        const rawManifest = await readYamlFile<unknown>(manifestPath);
   247→        manifest = ManifestSchema.parse(rawManifest);
   248→      } catch {
   249→        // Manifest exists but may be invalid
   250→      }
   251→    }
   252→
   253→    return {
   254→      rootDir: shadow.projectRoot,
   255→      specDir,
   256→      manifestPath,
   257→      manifest,
   258→      shadow,
   259→    };
   260→  }
   261→
   262→  // Traditional mode: find manifest in spec/ or current directory
   263→  const manifestPath = await findManifest(cwd);
   264→
   265→  let manifest: Manifest | null = null;
   266→  let rootDir = cwd;
   267→  let specDir = cwd;
   268→
   269→  if (manifestPath) {
   270→    const manifestDir = path.dirname(manifestPath);
   271→    // Handle spec/ subdirectory
   272→    if (path.basename(manifestDir) === "spec") {
   273→      rootDir = path.dirname(manifestDir);
   274→      specDir = manifestDir;
   275→    } else {
   276→      rootDir = manifestDir;
   277→      specDir = manifestDir;
   278→    }
   279→
   280→    try {
   281→      const rawManifest = await readYamlFile<unknown>(manifestPath);
   282→      manifest = ManifestSchema.parse(rawManifest);
   283→    } catch {
   284→      // Manifest exists but may be invalid
   285→    }
   286→  }
   287→
   288→  return { rootDir, specDir, manifestPath, manifest, shadow: null };
   289→}
   290→
   291→/**
   292→ * Find manifest file within a specific directory (no parent traversal).
   293→ * Used for shadow mode where we know exactly where to look.
   294→ */
   295→async function findManifestInDir(dir: string): Promise<string | null> {
   296→  const candidates = ["kynetic.yaml", "kynetic.spec.yaml"];
   297→
   298→  for (const candidate of candidates) {
   299→    const filePath = path.join(dir, candidate);
   300→    try {
   301→      await fs.access(filePath);
   302→      return filePath;
   303→    } catch {
   304→      // File doesn't exist, try next
   305→    }
   306→  }
   307→
   308→  return null;
   309→}
   310→
   311→/**
   312→ * Load tasks from a single file.
   313→ * Helper function used by loadAllTasks.
   314→ */
   315→async function loadTasksFromFile(filePath: string): Promise<LoadedTask[]> {
   316→  const tasks: LoadedTask[] = [];
   317→
   318→  try {
   319→    const raw = await readYamlFile<unknown>(filePath);
   320→
   321→    // Handle both array format and object format
   322→    let taskList: unknown[];
   323→
   324→    if (Array.isArray(raw)) {
   325→      taskList = raw;
   326→    } else if (raw && typeof raw === "object" && "tasks" in raw) {
   327→      const parsed = TasksFileSchema.safeParse(raw);
   328→      if (parsed.success) {
   329→        // Add _sourceFile to each task from this file
   330→        for (const task of parsed.data.tasks) {
   331→          tasks.push({ ...task, _sourceFile: filePath });
   332→        }
   333→        return tasks;
   334→      }
   335→      taskList = (raw as { tasks: unknown[] }).tasks || [];
   336→    } else {
   337→      // Single task object
   338→      taskList = [raw];
   339→    }
   340→
   341→    for (const taskData of taskList) {
   342→      const result = TaskSchema.safeParse(taskData);
   343→      if (result.success) {
   344→        // Add _sourceFile metadata
   345→        tasks.push({ ...result.data, _sourceFile: filePath });
   346→      }
   347→    }
   348→  } catch {
   349→    // Skip invalid files
   350→  }
   351→
   352→  return tasks;
   353→}
   354→
   355→/**
   356→ * Load all tasks from the project.
   357→ * Each task includes _sourceFile metadata for write-back routing.
   358→ *
   359→ * When shadow is enabled, tasks are loaded from .kspec/ (ctx.specDir).
   360→ * Otherwise, searches in traditional locations (rootDir, spec/, tasks/).
   361→ */
   362→export async function loadAllTasks(ctx: KspecContext): Promise<LoadedTask[]> {
   363→  const tasks: LoadedTask[] = [];
   364→
   365→  // When shadow is enabled, look only in specDir
   366→  if (ctx.shadow?.enabled) {
   367→    const taskFiles = await findTaskFiles(ctx.specDir);
   368→
   369→    // Also check for standalone files in specDir
   370→    const standaloneLocations = [
   371→      path.join(ctx.specDir, "tasks.yaml"),
   372→      path.join(ctx.specDir, "project.tasks.yaml"),
   373→      path.join(ctx.specDir, "kynetic.tasks.yaml"),
   374→      path.join(ctx.specDir, "backlog.tasks.yaml"),
   375→      path.join(ctx.specDir, "active.tasks.yaml"),
   376→    ];
   377→
   378→    for (const loc of standaloneLocations) {
   379→      try {
   380→        await fs.access(loc);
   381→        if (!taskFiles.includes(loc)) {
   382→          taskFiles.push(loc);
   383→        }
   384→      } catch {
   385→        // File doesn't exist
   386→      }
   387→    }
   388→
   389→    // Deduplicate and load
   390→    const uniqueFiles = [...new Set(taskFiles)];
   391→    for (const filePath of uniqueFiles) {
   392→      const fileTasks = await loadTasksFromFile(filePath);
   393→      tasks.push(...fileTasks);
   394→    }
   395→
   396→    return tasks;
   397→  }
   398→
   399→  // Traditional mode: look in multiple locations
   400→  const taskFiles = await findTaskFiles(ctx.rootDir);
   401→
   402→  // Also check common locations
   403→  const additionalPaths = [
   404→    path.join(ctx.rootDir, "tasks"),
   405→    path.join(ctx.rootDir, "spec"),
   406→  ];
   407→
   408→  for (const additionalPath of additionalPaths) {
   409→    const files = await findTaskFiles(additionalPath);
   410→    taskFiles.push(...files);
   411→  }
   412→
   413→  // Also look for standalone tasks.yaml and project.tasks.yaml
   414→  const standaloneLocations = [
   415→    path.join(ctx.rootDir, "tasks.yaml"),
   416→    path.join(ctx.rootDir, "project.tasks.yaml"),
   417→    path.join(ctx.rootDir, "spec", "project.tasks.yaml"),
   418→    path.join(ctx.rootDir, "backlog.tasks.yaml"),
   419→    path.join(ctx.rootDir, "active.tasks.yaml"),
   420→  ];
   421→
   422→  for (const loc of standaloneLocations) {
   423→    try {
   424→      await fs.access(loc);
   425→      if (!taskFiles.includes(loc)) {
   426→        taskFiles.push(loc);
   427→      }
   428→    } catch {
   429→      // File doesn't exist
   430→    }
   431→  }
   432→
   433→  // Deduplicate and load
   434→  const uniqueFiles = [...new Set(taskFiles)];
   435→
   436→  for (const filePath of uniqueFiles) {
   437→    const fileTasks = await loadTasksFromFile(filePath);
   438→    tasks.push(...fileTasks);
   439→  }
   440→
   441→  return tasks;
   442→}
   443→
   444→/**
   445→ * Find a task by reference (ULID, slug, or short reference)
   446→ */
   447→export function findTaskByRef(
   448→  tasks: LoadedTask[],
   449→  ref: string,
   450→): LoadedTask | undefined {
   451→  // Remove @ prefix if present
   452→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   453→
   454→  return tasks.find((task) => {
   455→    // Match full ULID
   456→    if (task._ulid === cleanRef) return true;
   457→
   458→    // Match short ULID (prefix)
   459→    if (task._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
   460→      return true;
   461→
   462→    // Match slug
   463→    if (task.slugs.includes(cleanRef)) return true;
   464→
   465→    return false;
   466→  });
   467→}
   468→
   469→/**
   470→ * Get the default task file path for new tasks without a spec_ref.
   471→ *
   472→ * When shadow enabled: .kspec/project.tasks.yaml
   473→ * Otherwise: spec/project.tasks.yaml
   474→ */
   475→export function getDefaultTaskFilePath(ctx: KspecContext): string {
   476→  return path.join(ctx.specDir, "project.tasks.yaml");
   477→}
   478→
   479→/**
   480→ * Strip runtime metadata before serialization
   481→ */
   482→function stripRuntimeMetadata(task: LoadedTask): Task {
   483→  const { _sourceFile, ...cleanTask } = task;
   484→  return cleanTask as Task;
   485→}
   486→
   487→/**
   488→ * Save a task to its source file (or default location for new tasks).
   489→ * Preserves file format (tasks: [...] wrapper vs plain array).
   490→ */
   491→export async function saveTask(
   492→  ctx: KspecContext,
   493→  task: LoadedTask,
   494→): Promise<void> {
   495→  // Determine target file: use _sourceFile if present, otherwise default
   496→  const taskFilePath = task._sourceFile || getDefaultTaskFilePath(ctx);
   497→
   498→  // Ensure directory exists
   499→  const dir = path.dirname(taskFilePath);
   500→  await fs.mkdir(dir, { recursive: true });
   501→
   502→  // Load existing tasks from the target file
   503→  let existingRaw: unknown = null;
   504→  let useTasksWrapper = false;
   505→
   506→  try {
   507→    existingRaw = await readYamlFile<unknown>(taskFilePath);
   508→    // Detect if file uses { tasks: [...] } format
   509→    if (
   510→      existingRaw &&
   511→      typeof existingRaw === "object" &&
   512→      "tasks" in existingRaw
   513→    ) {
   514→      useTasksWrapper = true;
   515→    }
   516→  } catch {
   517→    // File doesn't exist, start fresh
   518→  }
   519→
   520→  // Parse existing tasks from file
   521→  let fileTasks: Task[] = [];
   522→
   523→  if (existingRaw) {
   524→    if (Array.isArray(existingRaw)) {
   525→      for (const t of existingRaw) {
   526→        const result = TaskSchema.safeParse(t);
   527→        if (result.success) {
   528→          fileTasks.push(result.data);
   529→        }
   530→      }
   531→    } else if (useTasksWrapper) {
   532→      // Try TasksFileSchema first (has kynetic_tasks version)
   533→      const parsed = TasksFileSchema.safeParse(existingRaw);
   534→      if (parsed.success) {
   535→        fileTasks = parsed.data.tasks;
   536→      } else {
   537→        // Fall back to raw tasks array (common format without version field)
   538→        const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   539→        if (Array.isArray(rawTasks)) {
   540→          for (const t of rawTasks) {
   541→            const result = TaskSchema.safeParse(t);
   542→            if (result.success) {
   543→              fileTasks.push(result.data);
   544→            }
   545→          }
   546→        }
   547→      }
   548→    }
   549→  }
   550→
   551→  // Strip runtime metadata before saving
   552→  const cleanTask = stripRuntimeMetadata(task);
   553→
   554→  // Update existing or add new
   555→  const existingIndex = fileTasks.findIndex((t) => t._ulid === task._ulid);
   556→  if (existingIndex >= 0) {
   557→    fileTasks[existingIndex] = cleanTask;
   558→  } else {
   559→    fileTasks.push(cleanTask);
   560→  }
   561→
   562→  // Save in the same format as original (or tasks: wrapper for new files)
   563→  // Use format-preserving write to maintain formatting and comments
   564→  if (useTasksWrapper) {
   565→    await writeYamlFilePreserveFormat(taskFilePath, { tasks: fileTasks });
   566→  } else {
   567→    await writeYamlFilePreserveFormat(taskFilePath, fileTasks);
   568→  }
   569→}
   570→
   571→/**
   572→ * Delete a task from its source file.
   573→ * Requires _sourceFile to know which file to modify.
   574→ */
   575→export async function deleteTask(
   576→  _ctx: KspecContext,
   577→  task: LoadedTask,
   578→): Promise<void> {
   579→  if (!task._sourceFile) {
   580→    throw new Error("Cannot delete task without _sourceFile metadata");
   581→  }
   582→
   583→  const taskFilePath = task._sourceFile;
   584→
   585→  // Load existing file
   586→  let existingRaw: unknown = null;
   587→  let useTasksWrapper = false;
   588→
   589→  try {
   590→    existingRaw = await readYamlFile<unknown>(taskFilePath);
   591→    if (
   592→      existingRaw &&
   593→      typeof existingRaw === "object" &&
   594→      "tasks" in existingRaw
   595→    ) {
   596→      useTasksWrapper = true;
   597→    }
   598→  } catch {
   599→    throw new Error(`Task file not found: ${taskFilePath}`);
   600→  }
   601→
   602→  // Parse existing tasks
   603→  let fileTasks: Task[] = [];
   604→
   605→  if (existingRaw) {
   606→    if (Array.isArray(existingRaw)) {
   607→      for (const t of existingRaw) {
   608→        const result = TaskSchema.safeParse(t);
   609→        if (result.success) {
   610→          fileTasks.push(result.data);
   611→        }
   612→      }
   613→    } else if (useTasksWrapper) {
   614→      const parsed = TasksFileSchema.safeParse(existingRaw);
   615→      if (parsed.success) {
   616→        fileTasks = parsed.data.tasks;
   617→      } else {
   618→        const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   619→        if (Array.isArray(rawTasks)) {
   620→          for (const t of rawTasks) {
   621→            const result = TaskSchema.safeParse(t);
   622→            if (result.success) {
   623→              fileTasks.push(result.data);
   624→            }
   625→          }
   626→        }
   627→      }
   628→    }
   629→  }
   630→
   631→  // Remove the task
   632→  const originalCount = fileTasks.length;
   633→  fileTasks = fileTasks.filter((t) => t._ulid !== task._ulid);
   634→
   635→  if (fileTasks.length === originalCount) {
   636→    throw new Error(`Task not found in file: ${task._ulid}`);
   637→  }
   638→
   639→  // Save the modified file with format preservation
   640→  if (useTasksWrapper) {
   641→    await writeYamlFilePreserveFormat(taskFilePath, { tasks: fileTasks });
   642→  } else {
   643→    await writeYamlFilePreserveFormat(taskFilePath, fileTasks);
   644→  }
   645→}
   646→
   647→/**
   648→ * Create a new task with auto-generated fields
   649→ */
   650→export function createTask(input: TaskInput): Task {
   651→  const now = new Date().toISOString();
   652→
   653→  return {
   654→    ...input,
   655→    _ulid: input._ulid || ulid(),
   656→    slugs: input.slugs || [],
   657→    type: input.type || "task",
   658→    status: input.status || "pending",
   659→    blocked_by: input.blocked_by || [],
   660→    depends_on: input.depends_on || [],
   661→    context: input.context || [],
   662→    priority: input.priority || 3,
   663→    tags: input.tags || [],
   664→    vcs_refs: input.vcs_refs || [],
   665→    created_at: input.created_at || now,
   666→    notes: input.notes || [],
   667→    todos: input.todos || [],
   668→  };
   669→}
   670→
   671→/**
   672→ * Get author from environment with fallback chain.
   673→ * Priority:
   674→ *   1. KSPEC_AUTHOR env var (explicit config, agent-agnostic)
   675→ *   2. git user.name (developer identity)
   676→ *   3. USER/USERNAME env var (system user)
   677→ *   4. undefined (will show as 'unknown' in output)
   678→ *
   679→ * For Claude Code integration, add to ~/.claude/settings.json:
   680→ *   { "env": { "KSPEC_AUTHOR": "@claude" } }
   681→ */
   682→export function getAuthor(): string | undefined {
   683→  // 1. Explicit config (works for any agent)
   684→  if (process.env.KSPEC_AUTHOR) {
   685→    return process.env.KSPEC_AUTHOR;
   686→  }
   687→
   688→  // 2. Git user.name
   689→  try {
   690→    const gitUser = execSync("git config user.name", {
   691→      encoding: "utf-8",
   692→      stdio: ["pipe", "pipe", "ignore"],
   693→    }).trim();
   694→    if (gitUser) {
   695→      return gitUser;
   696→    }
   697→  } catch {
   698→    // git not available or not in a repo
   699→  }
   700→
   701→  // 3. System user
   702→  const systemUser = process.env.USER || process.env.USERNAME;
   703→  if (systemUser) {
   704→    return systemUser;
   705→  }
   706→
   707→  // 4. No author available
   708→  return undefined;
   709→}
   710→
   711→/**
   712→ * Create a new note entry.
   713→ * If author is not provided, attempts to auto-detect from environment.
   714→ */
   715→export function createNote(
   716→  content: string,
   717→  author?: string,
   718→  supersedes?: string,
   719→): Note {
   720→  return {
   721→    _ulid: ulid(),
   722→    created_at: new Date().toISOString(),
   723→    author: author ?? getAuthor(),
   724→    // Trim content to prevent whitespace-only lines from accumulating
   725→    // in block scalars during YAML parse-stringify cycles
   726→    content: content.trim(),
   727→    supersedes: supersedes || null,
   728→  };
   729→}
   730→
   731→/**
   732→ * Create a new todo item.
   733→ * The id should be the next available id for the task's todos array.
   734→ */
   735→export function createTodo(id: number, text: string, addedBy?: string): Todo {
   736→  return {
   737→    id,
   738→    // Trim text to prevent whitespace-only lines from accumulating
   739→    // in block scalars during YAML parse-stringify cycles
   740→    text: text.trim(),
   741→    done: false,
   742→    added_at: new Date().toISOString(),
   743→    added_by: addedBy ?? getAuthor(),
   744→  };
   745→}
   746→
   747→/**
   748→ * Check if task dependencies are met
   749→ */
   750→export function areDependenciesMet(
   751→  task: LoadedTask,
   752→  allTasks: LoadedTask[],
   753→): boolean {
   754→  if (task.depends_on.length === 0) return true;
   755→
   756→  for (const depRef of task.depends_on) {
   757→    const depTask = findTaskByRef(allTasks, depRef);
   758→    if (!depTask || depTask.status !== "completed") {
   759→      return false;
   760→    }
   761→  }
   762→
   763→  return true;
   764→}
   765→
   766→/**
   767→ * Check if task is ready (pending + deps met + not blocked)
   768→ */
   769→export function isTaskReady(task: LoadedTask, allTasks: LoadedTask[]): boolean {
   770→  if (task.status !== "pending") return false;
   771→  if (task.blocked_by.length > 0) return false;
   772→  return areDependenciesMet(task, allTasks);
   773→}
   774→
   775→/**
   776→ * Get ready tasks (pending + deps met + not blocked), sorted by priority then creation time.
   777→ * Within the same priority tier, older tasks come first (FIFO).
   778→ */
   779→export function getReadyTasks(tasks: LoadedTask[]): LoadedTask[] {
   780→  return tasks
   781→    .filter((task) => isTaskReady(task, tasks))
   782→    .sort((a, b) => {
   783→      // Primary: priority (lower number = higher priority)
   784→      if (a.priority !== b.priority) {
   785→        return a.priority - b.priority;
   786→      }
   787→      // Secondary: creation time (older first - FIFO within priority)
   788→      return (
   789→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime()
   790→      );
   791→    });
   792→}
   793→
   794→// ============================================================
   795→// SPEC ITEM LOADING
   796→// ============================================================
   797→
   798→/**
   799→ * Expand a glob-like include pattern to file paths.
   800→ * Supports simple patterns like "modules/*.yaml" or "**\/*.yaml"
   801→ */
   802→export async function expandIncludePattern(
   803→  pattern: string,
   804→  baseDir: string,
   805→): Promise<string[]> {
   806→  const fullPattern = path.isAbsolute(pattern)
   807→    ? pattern
   808→    : path.join(baseDir, pattern);
   809→
   810→  // If no glob characters, just return the path if it exists
   811→  if (!pattern.includes("*")) {
   812→    try {
   813→      await fs.access(fullPattern);
   814→      return [fullPattern];
   815→    } catch {
   816→      return [];
   817→    }
   818→  }
   819→
   820→  // Split pattern into directory part and file pattern
   821→  const parts = pattern.split("/");
   822→  let currentDir = baseDir;
   823→  const result: string[] = [];
   824→
   825→  // Find the first part with a glob
   826→  const globIndex = parts.findIndex((p) => p.includes("*"));
   827→
   828→  // Navigate to the directory before the glob
   829→  if (globIndex > 0) {
   830→    currentDir = path.join(baseDir, ...parts.slice(0, globIndex));
   831→  }
   832→
   833→  // Get the remaining pattern
   834→  const remainingPattern = parts.slice(globIndex).join("/");
   835→
   836→  await expandGlobRecursive(currentDir, remainingPattern, result);
   837→  return result;
   838→}
   839→
   840→/**
   841→ * Recursively expand glob patterns
   842→ */
   843→async function expandGlobRecursive(
   844→  dir: string,
   845→  pattern: string,
   846→  result: string[],
   847→): Promise<void> {
   848→  const parts = pattern.split("/");
   849→  const currentPattern = parts[0];
   850→  const remainingPattern = parts.slice(1).join("/");
   851→
   852→  try {
   853→    const entries = await fs.readdir(dir, { withFileTypes: true });
   854→
   855→    for (const entry of entries) {
   856→      const matches = matchGlobPart(entry.name, currentPattern);
   857→
   858→      if (matches) {
   859→        const fullPath = path.join(dir, entry.name);
   860→
   861→        if (remainingPattern) {
   862→          // More pattern parts to process
   863→          if (entry.isDirectory()) {
   864→            await expandGlobRecursive(fullPath, remainingPattern, result);
   865→          }
   866→        } else {
   867→          // This is the final pattern part
   868→          if (currentPattern === "**") {
   869→            // ** matches any depth - need special handling
   870→            if (entry.isDirectory()) {
   871→              await expandGlobRecursive(fullPath, "**", result);
   872→            }
   873→            // Also match files at this level
   874→            result.push(fullPath);
   875→          } else if (entry.isFile()) {
   876→            result.push(fullPath);
   877→          }
   878→        }
   879→      }
   880→
   881→      // Handle ** - also recurse into directories without consuming the pattern
   882→      if (currentPattern === "**" && entry.isDirectory()) {
   883→        const fullPath = path.join(dir, entry.name);
   884→        await expandGlobRecursive(fullPath, pattern, result);
   885→      }
   886→    }
   887→  } catch {
   888→    // Directory doesn't exist or not readable
   889→  }
   890→}
   891→
   892→/**
   893→ * Match a single path component against a glob pattern part
   894→ */
   895→function matchGlobPart(name: string, pattern: string): boolean {
   896→  if (pattern === "*") return true;
   897→  if (pattern === "**") return true;
   898→
   899→  // Convert glob pattern to regex
   900→  const regexPattern = pattern
   901→    .replace(/[.+^${}()|[\]\\]/g, "\\$&") // Escape special regex chars
   902→    .replace(/\*/g, ".*") // * matches anything
   903→    .replace(/\?/g, "."); // ? matches single char
   904→
   905→  const regex = new RegExp(`^${regexPattern}$`);
   906→  return regex.test(name);
   907→}
   908→
   909→/**
   910→ * Fields that may contain nested spec items
   911→ */
   912→const NESTED_ITEM_FIELDS = [
   913→  "modules",
   914→  "features",
   915→  "requirements",
   916→  "constraints",
   917→  "decisions",
   918→  "traits",
   919→  "acceptance_criteria",
   920→];
   921→
   922→/**
   923→ * Recursively extract all spec items from a raw YAML structure.
   924→ * Items can be nested under modules/features/requirements/etc.
   925→ * Tracks the path within the file for each item.
   926→ */
   927→export function extractItemsFromRaw(
   928→  raw: unknown,
   929→  sourceFile: string,
   930→  items: LoadedSpecItem[] = [],
   931→  currentPath: string = "",
   932→): LoadedSpecItem[] {
   933→  if (!raw || typeof raw !== "object") {
   934→    return items;
   935→  }
   936→
   937→  // Check if this object is itself a spec item (has _ulid)
   938→  if (
   939→    "_ulid" in raw &&
   940→    typeof (raw as Record<string, unknown>)._ulid === "string"
   941→  ) {
   942→    const result = SpecItemSchema.safeParse(raw);
   943→    if (result.success) {
   944→      items.push({
   945→        ...result.data,
   946→        _sourceFile: sourceFile,
   947→        _path: currentPath || undefined,
   948→      });
   949→    }
   950→
   951→    // Even if the item itself was added, also extract nested items
   952→    const rawObj = raw as Record<string, unknown>;
   953→    for (const field of NESTED_ITEM_FIELDS) {
   954→      if (field in rawObj && Array.isArray(rawObj[field])) {
   955→        const arr = rawObj[field] as unknown[];
   956→        for (let i = 0; i < arr.length; i++) {
   957→          const nestedPath = currentPath
   958→            ? `${currentPath}.${field}[${i}]`
   959→            : `${field}[${i}]`;
   960→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
   961→        }
   962→      }
   963→    }
   964→  } else if (Array.isArray(raw)) {
   965→    // Array of items at root level
   966→    for (let i = 0; i < raw.length; i++) {
   967→      const itemPath = currentPath ? `${currentPath}[${i}]` : `[${i}]`;
   968→      extractItemsFromRaw(raw[i], sourceFile, items, itemPath);
   969→    }
   970→  } else {
   971→    // Object that might contain item arrays (like manifest with modules/features/etc)
   972→    const rawObj = raw as Record<string, unknown>;
   973→    for (const field of NESTED_ITEM_FIELDS) {
   974→      if (field in rawObj && Array.isArray(rawObj[field])) {
   975→        const arr = rawObj[field] as unknown[];
   976→        for (let i = 0; i < arr.length; i++) {
   977→          const nestedPath = currentPath
   978→            ? `${currentPath}.${field}[${i}]`
   979→            : `${field}[${i}]`;
   980→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
   981→        }
   982→      }
   983→    }
   984→  }
   985→
   986→  return items;
   987→}
   988→
   989→/**
   990→ * Load spec items from a single file.
   991→ * Handles module files (the file itself is an item with nested children).
   992→ */
   993→export async function loadSpecFile(
   994→  filePath: string,
   995→): Promise<LoadedSpecItem[]> {
   996→  try {
   997→    const content = await fs.readFile(filePath, "utf-8");
   998→    const items: LoadedSpecItem[] = [];
   999→
  1000→    // Parse all YAML documents in the file (handles files with ---)
  1001→    const documents = YAML.parseAllDocuments(content);
  1002→
  1003→    for (const doc of documents) {
  1004→      if (doc.errors.length > 0) {
  1005→        // Skip documents with parse errors
  1006→        continue;
  1007→      }
  1008→
  1009→      const raw = doc.toJS();
  1010→      if (raw) {
  1011→        const docItems = extractItemsFromRaw(raw, filePath);
  1012→        items.push(...docItems);
  1013→      }
  1014→    }
  1015→
  1016→    return items;
  1017→  } catch (_error) {
  1018→    // File doesn't exist or parse error
  1019→    return [];
  1020→  }
  1021→}
  1022→
  1023→/**
  1024→ * Load all spec items from the project.
  1025→ * Parses manifest, follows includes, and builds unified collection.
  1026→ */
  1027→export async function loadAllItems(
  1028→  ctx: KspecContext,
  1029→): Promise<LoadedSpecItem[]> {
  1030→  const items: LoadedSpecItem[] = [];
  1031→
  1032→  if (!ctx.manifest || !ctx.manifestPath) {
  1033→    return items;
  1034→  }
  1035→
  1036→  const manifestDir = path.dirname(ctx.manifestPath);
  1037→
  1038→  // Extract items from manifest itself (inline modules/features/etc)
  1039→  const manifestItems = extractItemsFromRaw(ctx.manifest, ctx.manifestPath);
  1040→  items.push(...manifestItems);
  1041→
  1042→  // Process includes
  1043→  const includes = ctx.manifest.includes || [];
  1044→
  1045→  for (const include of includes) {
  1046→    const expandedPaths = await expandIncludePattern(include, manifestDir);
  1047→
  1048→    for (const filePath of expandedPaths) {
  1049→      const fileItems = await loadSpecFile(filePath);
  1050→      items.push(...fileItems);
  1051→    }
  1052→  }
  1053→
  1054→  return items;
  1055→}
  1056→
  1057→/**
  1058→ * Find a spec item by reference (ULID, slug, or short reference)
  1059→ */
  1060→export function findItemByRef(
  1061→  items: LoadedSpecItem[],
  1062→  ref: string,
  1063→): LoadedSpecItem | undefined {
  1064→  // Remove @ prefix if present
  1065→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1066→
  1067→  return items.find((item) => {
  1068→    // Match full ULID
  1069→    if (item._ulid === cleanRef) return true;
  1070→
  1071→    // Match short ULID (prefix)
  1072→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  1073→      return true;
  1074→
  1075→    // Match slug
  1076→    if (item.slugs.includes(cleanRef)) return true;
  1077→
  1078→    return false;
  1079→  });
  1080→}
  1081→
  1082→/**
  1083→ * Combined item type for unified queries across tasks and spec items
  1084→ */
  1085→export type AnyLoadedItem = LoadedTask | LoadedSpecItem;
  1086→
  1087→/**
  1088→ * Find any item (task or spec item) by reference
  1089→ */
  1090→export function findAnyItemByRef(
  1091→  tasks: LoadedTask[],
  1092→  items: LoadedSpecItem[],
  1093→  ref: string,
  1094→): AnyLoadedItem | undefined {
  1095→  // Try tasks first (more commonly referenced)
  1096→  const task = findTaskByRef(tasks, ref);
  1097→  if (task) return task;
  1098→
  1099→  // Then try spec items
  1100→  return findItemByRef(items, ref);
  1101→}
  1102→
  1103→/**
  1104→ * Build a ReferenceIndex from context.
  1105→ * Loads all tasks and spec items, then builds the index.
  1106→ */
  1107→export async function buildReferenceIndex(ctx: KspecContext): Promise<{
  1108→  index: ReferenceIndex;
  1109→  tasks: LoadedTask[];
  1110→  items: LoadedSpecItem[];
  1111→}> {
  1112→  const tasks = await loadAllTasks(ctx);
  1113→  const items = await loadAllItems(ctx);
  1114→  const index = new ReferenceIndex(tasks, items);
  1115→  return { index, tasks, items };
  1116→}
  1117→
  1118→/**
  1119→ * Build both ReferenceIndex and ItemIndex from context.
  1120→ * Use this when you need query capabilities in addition to reference resolution.
  1121→ */
  1122→export async function buildIndexes(ctx: KspecContext): Promise<{
  1123→  refIndex: ReferenceIndex;
  1124→  itemIndex: ItemIndex;
  1125→  traitIndex: TraitIndex;
  1126→  tasks: LoadedTask[];
  1127→  items: LoadedSpecItem[];
  1128→}> {
  1129→  const tasks = await loadAllTasks(ctx);
  1130→  const items = await loadAllItems(ctx);
  1131→  const refIndex = new ReferenceIndex(tasks, items);
  1132→  const itemIndex = new ItemIndex(tasks, items);
  1133→  const traitIndex = new TraitIndex(items, refIndex);
  1134→  return { refIndex, itemIndex, traitIndex, tasks, items };
  1135→}
  1136→
  1137→// ============================================================
  1138→// SPEC ITEM CRUD (supports nested structures)
  1139→// ============================================================
  1140→
  1141→/**
  1142→ * Strip runtime metadata from spec item before serialization
  1143→ */
  1144→function stripSpecItemMetadata(item: LoadedSpecItem): SpecItem {
  1145→  const { _sourceFile, _path, ...cleanItem } = item;
  1146→  return cleanItem as SpecItem;
  1147→}
  1148→
  1149→/**
  1150→ * Parse a path string into segments.
  1151→ * e.g., "features[0].requirements[2]" -> [["features", 0], ["requirements", 2]]
  1152→ */
  1153→function parsePath(pathStr: string): Array<[string, number]> {
  1154→  const segments: Array<[string, number]> = [];
  1155→  const regex = /(\w+)\[(\d+)\]/g;
  1156→  let match;
  1157→  while ((match = regex.exec(pathStr)) !== null) {
  1158→    segments.push([match[1], parseInt(match[2], 10)]);
  1159→  }
  1160→  return segments;
  1161→}
  1162→
  1163→/**
  1164→ * Navigate to a location in a YAML structure using a path.
  1165→ * Returns the parent object and the array containing the target item.
  1166→ */
  1167→function navigateToPath(
  1168→  root: unknown,
  1169→  pathStr: string,
  1170→): { parent: Record<string, unknown>; array: unknown[]; index: number } | null {
  1171→  if (!pathStr) return null;
  1172→
  1173→  const segments = parsePath(pathStr);
  1174→  if (segments.length === 0) return null;
  1175→
  1176→  let current: unknown = root;
  1177→
  1178→  // Navigate to the parent of the last segment
  1179→  for (let i = 0; i < segments.length - 1; i++) {
  1180→    const [field, index] = segments[i];
  1181→    if (typeof current !== "object" || current === null) return null;
  1182→    const obj = current as Record<string, unknown>;
  1183→    if (!Array.isArray(obj[field])) return null;
  1184→    current = (obj[field] as unknown[])[index];
  1185→  }
  1186→
  1187→  // Get the final array and index
  1188→  const [finalField, finalIndex] = segments[segments.length - 1];
  1189→  if (typeof current !== "object" || current === null) return null;
  1190→  const parent = current as Record<string, unknown>;
  1191→  if (!Array.isArray(parent[finalField])) return null;
  1192→
  1193→  return {
  1194→    parent,
  1195→    array: parent[finalField] as unknown[],
  1196→    index: finalIndex,
  1197→  };
  1198→}
  1199→
  1200→/**
  1201→ * Find an item by ULID in a nested YAML structure.
  1202→ * Returns the path segments to reach it.
  1203→ */
  1204→function findItemInStructure(
  1205→  root: unknown,
  1206→  ulid: string,
  1207→  currentPath: string = "",
  1208→): { path: string; item: Record<string, unknown> } | null {
  1209→  if (!root || typeof root !== "object") return null;
  1210→
  1211→  const obj = root as Record<string, unknown>;
  1212→
  1213→  // Check if this is the item we're looking for
  1214→  if (obj._ulid === ulid) {
  1215→    return { path: currentPath, item: obj };
  1216→  }
  1217→
  1218→  // Search nested item fields
  1219→  for (const field of NESTED_ITEM_FIELDS) {
  1220→    if (Array.isArray(obj[field])) {
  1221→      const arr = obj[field] as unknown[];
  1222→      for (let i = 0; i < arr.length; i++) {
  1223→        const nestedPath = currentPath
  1224→          ? `${currentPath}.${field}[${i}]`
  1225→          : `${field}[${i}]`;
  1226→        const result = findItemInStructure(arr[i], ulid, nestedPath);
  1227→        if (result) return result;
  1228→      }
  1229→    }
  1230→  }
  1231→
  1232→  return null;
  1233→}
  1234→
  1235→/**
  1236→ * Create a new spec item with auto-generated fields
  1237→ */
  1238→export function createSpecItem(input: SpecItemInput): SpecItem {
  1239→  return {
  1240→    _ulid: input._ulid || ulid(),
  1241→    slugs: input.slugs || [],
  1242→    title: input.title,
  1243→    type: input.type,
  1244→    status: input.status,
  1245→    priority: input.priority,
  1246→    tags: input.tags || [],
  1247→    description: input.description,
  1248→    depends_on: input.depends_on || [],
  1249→    implements: input.implements || [],
  1250→    relates_to: input.relates_to || [],
  1251→    tests: input.tests || [],
  1252→    traits: input.traits || [],
  1253→    notes: input.notes || [],
  1254→    created: input.created || new Date().toISOString(),
  1255→    created_by: input.created_by,
  1256→  };
  1257→}
  1258→
  1259→/**
  1260→ * Map from item type to the field name used to store children of that type.
  1261→ */
  1262→const TYPE_TO_CHILD_FIELD: Record<string, string> = {
  1263→  feature: "features",
  1264→  requirement: "requirements",
  1265→  constraint: "constraints",
  1266→  decision: "decisions",
  1267→  module: "modules",
  1268→  trait: "traits",
  1269→};
  1270→
  1271→/**
  1272→ * Add a spec item as a child of a parent item.
  1273→ * @param parent The parent item to add under
  1274→ * @param child The new child item to add
  1275→ * @param childField Optional field name override (defaults based on child.type)
  1276→ */
  1277→export async function addChildItem(
  1278→  _ctx: KspecContext,
  1279→  parent: LoadedSpecItem,
  1280→  child: SpecItem,
  1281→  childField?: string,
  1282→): Promise<{ item: SpecItem; path: string }> {
  1283→  if (!parent._sourceFile) {
  1284→    throw new Error("Parent item has no source file");
  1285→  }
  1286→
  1287→  const field =
  1288→    childField || TYPE_TO_CHILD_FIELD[child.type || "feature"] || "features";
  1289→
  1290→  // Load the raw YAML
  1291→  const raw = await readYamlFile<unknown>(parent._sourceFile);
  1292→
  1293→  // Find the parent in the structure
  1294→  let parentObj: Record<string, unknown>;
  1295→  let parentPath: string;
  1296→
  1297→  if (parent._path) {
  1298→    const nav = navigateToPath(raw, parent._path);
  1299→    if (!nav) {
  1300→      throw new Error(`Could not navigate to parent path: ${parent._path}`);
  1301→    }
  1302→    parentObj = nav.array[nav.index] as Record<string, unknown>;
  1303→    parentPath = parent._path;
  1304→  } else {
  1305→    // Parent is the root item
  1306→    parentObj = raw as Record<string, unknown>;
  1307→    parentPath = "";
  1308→  }
  1309→
  1310→  // Ensure the child field array exists
  1311→  if (!Array.isArray(parentObj[field])) {
  1312→    parentObj[field] = [];
  1313→  }
  1314→
  1315→  // Add the child
  1316→  const childArray = parentObj[field] as unknown[];
  1317→  const cleanChild = stripSpecItemMetadata(child as LoadedSpecItem);
  1318→  childArray.push(cleanChild);
  1319→
  1320→  // Calculate the new child's path
  1321→  const childIndex = childArray.length - 1;
  1322→  const childPath = parentPath
  1323→    ? `${parentPath}.${field}[${childIndex}]`
  1324→    : `${field}[${childIndex}]`;
  1325→
  1326→  // Write back with format preservation
  1327→  await writeYamlFilePreserveFormat(parent._sourceFile, raw);
  1328→
  1329→  return { item: cleanChild, path: childPath };
  1330→}
  1331→
  1332→/**
  1333→ * Update a spec item in place within its source file.
  1334→ * Works with nested structures using the _path field.
  1335→ */
  1336→export async function updateSpecItem(
  1337→  _ctx: KspecContext,
  1338→  item: LoadedSpecItem,
  1339→  updates: Partial<SpecItemInput>,
  1340→): Promise<SpecItem> {
  1341→  if (!item._sourceFile) {
  1342→    throw new Error("Item has no source file");
  1343→  }
  1344→
  1345→  // Load the raw YAML
  1346→  const raw = await readYamlFile<unknown>(item._sourceFile);
  1347→
  1348→  // Find the item in the structure (use stored path or search by ULID)
  1349→  let targetObj: Record<string, unknown>;
  1350→
  1351→  if (item._path) {
  1352→    const nav = navigateToPath(raw, item._path);
  1353→    if (!nav) {
  1354→      throw new Error(`Could not navigate to path: ${item._path}`);
  1355→    }
  1356→    targetObj = nav.array[nav.index] as Record<string, unknown>;
  1357→  } else {
  1358→    // Item might be the root, or we need to find it
  1359→    const found = findItemInStructure(raw, item._ulid);
  1360→    if (found) {
  1361→      targetObj = found.item;
  1362→    } else if ((raw as Record<string, unknown>)._ulid === item._ulid) {
  1363→      targetObj = raw as Record<string, unknown>;
  1364→    } else {
  1365→      throw new Error(`Could not find item ${item._ulid} in structure`);
  1366→    }
  1367→  }
  1368→
  1369→  // Apply updates (but never change _ulid)
  1370→  for (const [key, value] of Object.entries(updates)) {
  1371→    if (key !== "_ulid" && key !== "_sourceFile" && key !== "_path") {
  1372→      targetObj[key] = value;
  1373→    }
  1374→  }
  1375→
  1376→  // Write back with format preservation
  1377→  await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1378→
  1379→  return { ...item, ...updates, _ulid: item._ulid } as SpecItem;
  1380→}
  1381→
  1382→/**
  1383→ * Check if an item is a trait with implementors.
  1384→ * Returns array of items that use this trait via the 'traits' field.
  1385→ */
  1386→export function findTraitImplementors(
  1387→  trait: LoadedSpecItem,
  1388→  allItems: LoadedSpecItem[],
  1389→): LoadedSpecItem[] {
  1390→  // Check if the item is actually a trait
  1391→  if (trait.type !== "trait") {
  1392→    return [];
  1393→  }
  1394→
  1395→  // Find all items that reference this trait in their 'traits' array
  1396→  const traitRefs = [`@${trait._ulid}`, ...trait.slugs.map((s) => `@${s}`)];
  1397→  return allItems.filter((item) => {
  1398→    if (!item.traits || item.traits.length === 0) return false;
  1399→    return item.traits.some((traitRef: string) => traitRefs.includes(traitRef));
  1400→  });
  1401→}
  1402→
  1403→/**
  1404→ * Delete a spec item from its source file.
  1405→ * Works with nested structures using the _path field.
  1406→ */
  1407→export async function deleteSpecItem(
  1408→  _ctx: KspecContext,
  1409→  item: LoadedSpecItem,
  1410→): Promise<boolean> {
  1411→  if (!item._sourceFile) {
  1412→    return false;
  1413→  }
  1414→
  1415→  try {
  1416→    const raw = await readYamlFile<unknown>(item._sourceFile);
  1417→
  1418→    // If item has a path, navigate to it and remove from parent array
  1419→    if (item._path) {
  1420→      const nav = navigateToPath(raw, item._path);
  1421→      if (!nav) {
  1422→        return false;
  1423→      }
  1424→      // Remove the item from the array
  1425→      nav.array.splice(nav.index, 1);
  1426→      await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1427→      return true;
  1428→    }
  1429→
  1430→    // No path - try to find it by ULID
  1431→    const found = findItemInStructure(raw, item._ulid);
  1432→    if (found?.path) {
  1433→      const nav = navigateToPath(raw, found.path);
  1434→      if (nav) {
  1435→        nav.array.splice(nav.index, 1);
  1436→        await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1437→        return true;
  1438→      }
  1439→    }
  1440→
  1441→    // Maybe it's a root-level array item
  1442→    if (Array.isArray(raw)) {
  1443→      const index = raw.findIndex(
  1444→        (i: unknown) =>
  1445→          typeof i === "object" &&
  1446→          i !== null &&
  1447→          (i as Record<string, unknown>)._ulid === item._ulid,
  1448→      );
  1449→      if (index >= 0) {
  1450→        raw.splice(index, 1);
  1451→        await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1452→        return true;
  1453→      }
  1454→    }
  1455→
  1456→    return false;
  1457→  } catch {
  1458→    return false;
  1459→  }
  1460→}
  1461→
  1462→/**
  1463→ * Save a spec item - either updates existing or adds to parent.
  1464→ * For new items, use addChildItem instead.
  1465→ */
  1466→export async function saveSpecItem(
  1467→  ctx: KspecContext,
  1468→  item: LoadedSpecItem,
  1469→): Promise<void> {
  1470→  // If item has a source file and path, it's an update
  1471→  if (item._sourceFile && item._path) {
  1472→    await updateSpecItem(ctx, item, item);
  1473→    return;
  1474→  }
  1475→
  1476→  // Otherwise, this is more complex - would need a parent
  1477→  throw new Error(
  1478→    "Cannot save new item without parent. Use addChildItem instead.",
  1479→  );
  1480→}
  1481→
  1482→// ============================================================
  1483→// INBOX SYSTEM
  1484→// ============================================================
  1485→
  1486→/**
  1487→ * Inbox item with runtime metadata for source tracking.
  1488→ */
  1489→export interface LoadedInboxItem extends InboxItem {
  1490→  _sourceFile?: string;
  1491→}
  1492→
  1493→/**
  1494→ * Get the inbox file path.
  1495→ *
  1496→ * When shadow enabled: .kspec/project.inbox.yaml
  1497→ * Otherwise: spec/project.inbox.yaml
  1498→ */
  1499→export function getInboxFilePath(ctx: KspecContext): string {
  1500→  return path.join(ctx.specDir, "project.inbox.yaml");
  1501→}
  1502→
  1503→/**
  1504→ * Load all inbox items from the project.
  1505→ */
  1506→export async function loadInboxItems(
  1507→  ctx: KspecContext,
  1508→): Promise<LoadedInboxItem[]> {
  1509→  const inboxPath = getInboxFilePath(ctx);
  1510→
  1511→  try {
  1512→    const raw = await readYamlFile<unknown>(inboxPath);
  1513→
  1514→    // Handle { inbox: [...] } format
  1515→    if (raw && typeof raw === "object" && "inbox" in raw) {
  1516→      const parsed = InboxFileSchema.safeParse(raw);
  1517→      if (parsed.success) {
  1518→        return parsed.data.inbox.map((item) => ({
  1519→          ...item,
  1520→          _sourceFile: inboxPath,
  1521→        }));
  1522→      }
  1523→    }
  1524→
  1525→    // Handle plain array format
  1526→    if (Array.isArray(raw)) {
  1527→      const items: LoadedInboxItem[] = [];
  1528→      for (const item of raw) {
  1529→        const result = InboxItemSchema.safeParse(item);
  1530→        if (result.success) {
  1531→          items.push({ ...result.data, _sourceFile: inboxPath });
  1532→        }
  1533→      }
  1534→      return items;
  1535→    }
  1536→
  1537→    return [];
  1538→  } catch {
  1539→    // File doesn't exist or parse error
  1540→    return [];
  1541→  }
  1542→}
  1543→
  1544→/**
  1545→ * Create a new inbox item with auto-generated fields.
  1546→ */
  1547→export function createInboxItem(input: InboxItemInput): InboxItem {
  1548→  return {
  1549→    _ulid: input._ulid || ulid(),
  1550→    text: input.text,
  1551→    created_at: input.created_at || new Date().toISOString(),
  1552→    tags: input.tags || [],
  1553→    added_by: input.added_by ?? getAuthor(),
  1554→  };
  1555→}
  1556→
  1557→/**
  1558→ * Strip runtime metadata before serialization.
  1559→ */
  1560→function stripInboxMetadata(item: LoadedInboxItem): InboxItem {
  1561→  const { _sourceFile, ...cleanItem } = item;
  1562→  return cleanItem as InboxItem;
  1563→}
  1564→
  1565→/**
  1566→ * Save an inbox item (add or update).
  1567→ */
  1568→export async function saveInboxItem(
  1569→  ctx: KspecContext,
  1570→  item: LoadedInboxItem,
  1571→): Promise<void> {
  1572→  const inboxPath = getInboxFilePath(ctx);
  1573→
  1574→  // Ensure directory exists
  1575→  const dir = path.dirname(inboxPath);
  1576→  await fs.mkdir(dir, { recursive: true });
  1577→
  1578→  // Load existing items
  1579→  let existingItems: InboxItem[] = [];
  1580→
  1581→  try {
  1582→    const raw = await readYamlFile<unknown>(inboxPath);
  1583→    if (raw && typeof raw === "object" && "inbox" in raw) {
  1584→      const parsed = InboxFileSchema.safeParse(raw);
  1585→      if (parsed.success) {
  1586→        existingItems = parsed.data.inbox;
  1587→      }
  1588→    } else if (Array.isArray(raw)) {
  1589→      for (const i of raw) {
  1590→        const result = InboxItemSchema.safeParse(i);
  1591→        if (result.success) {
  1592→          existingItems.push(result.data);
  1593→        }
  1594→      }
  1595→    }
  1596→  } catch {
  1597→    // File doesn't exist, start fresh
  1598→  }
  1599→
  1600→  const cleanItem = stripInboxMetadata(item);
  1601→
  1602→  // Update existing or add new
  1603→  const existingIndex = existingItems.findIndex((i) => i._ulid === item._ulid);
  1604→  if (existingIndex >= 0) {
  1605→    existingItems[existingIndex] = cleanItem;
  1606→  } else {
  1607→    existingItems.push(cleanItem);
  1608→  }
  1609→
  1610→  // Save with { inbox: [...] } format and format preservation
  1611→  await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  1612→}
  1613→
  1614→/**
  1615→ * Delete an inbox item by ULID.
  1616→ */
  1617→export async function deleteInboxItem(
  1618→  ctx: KspecContext,
  1619→  ulid: string,
  1620→): Promise<boolean> {
  1621→  const inboxPath = getInboxFilePath(ctx);
  1622→
  1623→  try {
  1624→    const raw = await readYamlFile<unknown>(inboxPath);
  1625→    let existingItems: InboxItem[] = [];
  1626→
  1627→    if (raw && typeof raw === "object" && "inbox" in raw) {
  1628→      const parsed = InboxFileSchema.safeParse(raw);
  1629→      if (parsed.success) {
  1630→        existingItems = parsed.data.inbox;
  1631→      }
  1632→    }
  1633→
  1634→    const index = existingItems.findIndex((i) => i._ulid === ulid);
  1635→    if (index < 0) {
  1636→      return false;
  1637→    }
  1638→
  1639→    existingItems.splice(index, 1);
  1640→    await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  1641→    return true;
  1642→  } catch {
  1643→    return false;
  1644→  }
  1645→}
  1646→
  1647→/**
  1648→ * Find an inbox item by reference (ULID or short ULID).
  1649→ */
  1650→export function findInboxItemByRef(
  1651→  items: LoadedInboxItem[],
  1652→  ref: string,
  1653→): LoadedInboxItem | undefined {
  1654→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1655→
  1656→  return items.find((item) => {
  1657→    // Match full ULID
  1658→    if (item._ulid === cleanRef) return true;
  1659→    // Match short ULID (prefix)
  1660→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  1661→      return true;
  1662→    return false;
  1663→  });
  1664→}
  1665→
  1666→// ─── Patch Operations ────────────────────────────────────────────────────────
  1667→
  1668→/**
  1669→ * A single patch operation for bulk patching
  1670→ */
  1671→export interface PatchOperation {
  1672→  ref: string;
  1673→  data: Record<string, unknown>;
  1674→}
  1675→
  1676→/**
  1677→ * Result of a single patch operation
  1678→ */
  1679→export interface PatchResult {
  1680→  ref: string;
  1681→  status: "updated" | "skipped" | "error";
  1682→  ulid?: string;
  1683→  error?: string;
  1684→}
  1685→
  1686→/**
  1687→ * Result of a bulk patch operation
  1688→ */
  1689→export interface BulkPatchResult {
  1690→  results: PatchResult[];
  1691→  summary: {
  1692→    total: number;
  1693→    updated: number;
  1694→    failed: number;
  1695→    skipped: number;
  1696→  };
  1697→}
  1698→
  1699→/**
  1700→ * Options for patch operations
  1701→ */
  1702→export interface PatchOptions {
  1703→  allowUnknown?: boolean;
  1704→  dryRun?: boolean;
  1705→  failFast?: boolean;
  1706→}
  1707→
  1708→/**
  1709→ * Bulk patch spec items.
  1710→ * Resolves refs, validates data, applies patches.
  1711→ * Continues on error by default (use failFast to stop on first error).
  1712→ */
  1713→export async function patchSpecItems(
  1714→  ctx: KspecContext,
  1715→  refIndex: ReferenceIndex,
  1716→  items: LoadedSpecItem[],
  1717→  patches: PatchOperation[],
  1718→  options: PatchOptions = {},
  1719→): Promise<BulkPatchResult> {
  1720→  const results: PatchResult[] = [];
  1721→  let stopProcessing = false;
  1722→
  1723→  for (const patch of patches) {
  1724→    if (stopProcessing) {
  1725→      results.push({ ref: patch.ref, status: "skipped" });
  1726→      continue;
  1727→    }
  1728→
  1729→    // Resolve ref
  1730→    const resolved = refIndex.resolve(patch.ref);
  1731→    if (!resolved.ok) {
  1732→      const errorMsg =
  1733→        resolved.error === "not_found"
  1734→          ? `Item not found: ${patch.ref}`
  1735→          : resolved.error === "ambiguous"
  1736→            ? `Ambiguous ref: ${patch.ref}`
  1737→            : `Duplicate slug: ${patch.ref}`;
  1738→      results.push({ ref: patch.ref, status: "error", error: errorMsg });
  1739→      if (options.failFast) {
  1740→        stopProcessing = true;
  1741→      }
  1742→      continue;
  1743→    }
  1744→
  1745→    // Find the item
  1746→    const item = items.find((i) => i._ulid === resolved.ulid);
  1747→    if (!item) {
  1748→      // Ref resolved but it's not a spec item (might be a task)
  1749→      results.push({
  1750→        ref: patch.ref,
  1751→        status: "error",
  1752→        error: "Not a spec item",
  1753→      });
  1754→      if (options.failFast) {
  1755→        stopProcessing = true;
  1756→      }
  1757→      continue;
  1758→    }
  1759→
  1760→    // Dry run - just record what would happen
  1761→    if (options.dryRun) {
  1762→      results.push({ ref: patch.ref, status: "updated", ulid: item._ulid });
  1763→      continue;
  1764→    }
  1765→
  1766→    // Apply the patch
  1767→    try {
  1768→      await updateSpecItem(ctx, item, patch.data);
  1769→      results.push({ ref: patch.ref, status: "updated", ulid: item._ulid });
  1770→    } catch (err) {
  1771→      const errorMsg = err instanceof Error ? err.message : String(err);
  1772→      results.push({ ref: patch.ref, status: "error", error: errorMsg });
  1773→      if (options.failFast) {
  1774→        stopProcessing = true;
  1775→      }
  1776→    }
  1777→  }
  1778→
  1779→  return {
  1780→    results,
  1781→    summary: {
  1782→      total: patches.length,
  1783→      updated: results.filter((r) => r.status === "updated").length,
  1784→      failed: results.filter((r) => r.status === "error").length,
  1785→      skipped: results.filter((r) => r.status === "skipped").length,
  1786→    },
  1787→  };
  1788→}
  1789→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
```