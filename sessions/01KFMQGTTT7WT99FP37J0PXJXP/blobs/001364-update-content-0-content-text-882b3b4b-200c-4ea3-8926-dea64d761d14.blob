    37→    slugs:
    38→      - daemon-server
    39→    title: Daemon Server Mode
    40→    type: feature
    41→    tags:
    42→      - server
    43→      - websocket
    44→      - elysia
    45→    description: >
    46→      Long-running Elysia.js server on Bun runtime that exposes kspec state via HTTP API and
    47→      WebSocket
    48→
    49→      for real-time updates. Binds to localhost only for security. Supports foreground and
    50→      background
    51→
    52→      modes with PID file management. Includes heartbeat ping/pong for connection health monitoring.
    53→    depends_on: []
    54→    implements: []
    55→    relates_to: []
    56→    tests: []
    57→    traits:
    58→      - "@trait-json-output"
    59→      - "@trait-error-guidance"
    60→      - "@trait-shadow-commit"
    61→      - "@trait-localhost-security"
    62→      - "@trait-websocket-protocol"
    63→    notes: []
    64→    created: 2026-01-22T01:18:09.314Z
    65→    acceptance_criteria:
    66→      - id: ac-1
    67→        given: kspec is installed
    68→        when: user runs 'kspec serve'
    69→        then: Elysia HTTP server starts on configurable port (default 3456) binding to localhost only
    70→      - id: ac-2
    71→        given: daemon is starting
    72→        when: server binds to network interface
    73→        then: only accepts connections from 127.0.0.1 and ::1 (IPv6 localhost)
    74→      - id: ac-3
    75→        given: connection attempt from non-localhost IP
    76→        when: request received
    77→        then: connection rejected with 403 Forbidden
    78→      - id: ac-4
    79→        given: daemon is running
    80→        when: any .kspec/*.yaml file changes
    81→        then: connected WebSocket clients receive update event via topic subscription
    82→      - id: ac-5
    83→        given: file watching is active
    84→        when: rapid changes occur (< 500ms apart)
    85→        then: events are debounced and aggregated into single notification
    86→      - id: ac-6
    87→        given: watched file has YAML parse error
    88→        when: change detected
    89→        then: error logged and WebSocket broadcasts error event (daemon does not crash)
    90→      - id: ac-7
    91→        given: .kspec directory becomes inaccessible
    92→        when: watcher encounters error
    93→        then: daemon logs error and attempts recovery with exponential backoff
    94→      - id: ac-8
    95→        given: Bun fs.watch fails or misses events
    96→        when: reliability issue detected
    97→        then: automatically fall back to Chokidar file watcher
    98→      - id: ac-9
    99→        given: daemon is running
   100→        when: user runs 'kspec serve --daemon'
   101→        then: process detaches to background, writes PID to .kspec/.daemon.pid, CLI returns immediately
   102→      - id: ac-10
   103→        given: daemon is running in background
   104→        when: user runs 'kspec serve stop'
   105→        then: daemon shuts down gracefully, removes PID file, closes all WebSocket connections
   106→      - id: ac-11
   107→        given: daemon is running
   108→        when: GET /api/health is called
   109→        then: returns {status, uptime, connections, version} JSON
   110→      - id: ac-12
   111→        given: daemon receives SIGTERM or SIGINT
   112→        when: shutdown signal received
   113→        then: graceful shutdown (flush pending messages, close connections, save state)
   114→      - id: ac-13
   115→        given: WebSocket connection established
   116→        when: 30 seconds pass without activity
   117→        then: server sends ping frame
   118→      - id: ac-14
   119→        given: ping was sent
   120→        when: no pong received within 90 seconds
   121→        then: connection closed with code 1001
   122→      - id: ac-15
   123→        given: Elysia server is configured
   124→        when: routes are registered
   125→        then: use plugin pattern for middleware (CORS, logging, validation)
   126→      - id: ac-16
   127→        given: daemon code is ready
   128→        when: bun build --compile runs
   129→        then: produces standalone executable without requiring Bun installation
