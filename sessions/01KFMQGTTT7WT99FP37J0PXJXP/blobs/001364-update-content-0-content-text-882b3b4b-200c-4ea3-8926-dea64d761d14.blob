   253→      - id: ac-25
   254→        given: client connects to /ws
   255→        when: WebSocket connection established
   256→        then: receives connected event with {session_id}
   257→      - id: ac-26
   258→        given: WebSocket connection active
   259→        when: client sends command
   260→        then: command format is {action, request_id?, payload}
   261→      - id: ac-27
   262→        given: command received
   263→        when: processed
   264→        then: "server sends {ack: true, request_id, success, error?}"
   265→      - id: ac-28
   266→        given: WebSocket connection
   267→        when: "client sends {action: 'subscribe', topics: ['files:updates']}"
   268→        then: server tracks subscription and sends events for that topic
   269→      - id: ac-29
   270→        given: file changes in .kspec/
   271→        when: WebSocket client subscribed to files:updates
   272→        then: "receives event with format {msg_id, seq, timestamp, topic, event, data: {ref, action}}"
   273→      - id: ac-30
   274→        given: malformed command received
   275→        when: parsed
   276→        then: "return {ack: false, error: 'validation_error', details: ...}"
   277→      - id: ac-31
   278→        given: connection closing
   279→        when: close initiated
   280→        then: use code 1000 for clean, 1001 for timeout, 1011 for error
   281→      - id: ac-32
   282→        given: server sends to slow client
   283→        when: backpressure limit reached
   284→        then: pause non-critical broadcasts until drain event
   285→      - id: ac-33
   286→        given: daemon is shutting down
   287→        when: WebSocket connection active
   288→        then: receives shutdown event with {reason}, connection closes gracefully
