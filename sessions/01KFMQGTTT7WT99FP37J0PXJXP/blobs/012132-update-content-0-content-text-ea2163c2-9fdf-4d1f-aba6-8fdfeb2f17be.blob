```
     1→/**
     2→ * Validation module for kspec files.
     3→ *
     4→ * Provides schema validation, reference validation, and orphan detection.
     5→ */
     6→
     7→import * as fs from "node:fs/promises";
     8→import * as path from "node:path";
     9→import {
    10→  AgentSchema,
    11→  ConventionSchema,
    12→  ManifestSchema,
    13→  MetaManifestSchema,
    14→  ObservationSchema,
    15→  SpecItemSchema,
    16→  TaskSchema,
    17→  TasksFileSchema,
    18→  UlidSchema,
    19→  WorkflowSchema,
    20→} from "../schema/index.js";
    21→import { findMetaManifest, loadMetaContext } from "./meta.js";
    22→import {
    23→  ReferenceIndex,
    24→  type RefValidationError,
    25→  type RefValidationWarning,
    26→  validateRefs,
    27→} from "./refs.js";
    28→import { TraitIndex } from "./traits.js";
    29→import type { KspecContext, LoadedSpecItem, LoadedTask } from "./yaml.js";
    30→import {
    31→  expandIncludePattern,
    32→  extractItemsFromRaw,
    33→  findTaskFiles,
    34→  loadSpecFile,
    35→  readYamlFile,
    36→} from "./yaml.js";
    37→
    38→// ============================================================
    39→// TYPES
    40→// ============================================================
    41→
    42→/**
    43→ * Schema validation error
    44→ */
    45→export interface SchemaValidationError {
    46→  file: string;
    47→  path?: string;
    48→  message: string;
    49→  details?: unknown;
    50→}
    51→
    52→/**
    53→ * Orphan item (not referenced by anything)
    54→ */
    55→export interface OrphanItem {
    56→  ulid: string;
    57→  title: string;
    58→  type: string;
    59→  file?: string;
    60→}
    61→
    62→/**
    63→ * Completeness warning types
    64→ */
    65→export type CompletenessWarningType =
    66→  | "missing_acceptance_criteria"
    67→  | "missing_description"
    68→  | "status_inconsistency"
    69→  | "missing_test_coverage"
    70→  | "automation_eligible_no_spec";
    71→
    72→/**
    73→ * Trait cycle error
    74→ */
    75→export interface TraitCycleError {
    76→  traitRef: string;
    77→  traitTitle: string;
    78→  cycle: string[];
    79→  message: string;
    80→}
    81→
    82→/**
    83→ * Completeness warning
    84→ */
    85→export interface CompletenessWarning {
    86→  type: CompletenessWarningType;
    87→  itemRef: string;
    88→  itemTitle: string;
    89→  message: string;
    90→  details?: string;
    91→}
    92→
    93→/**
    94→ * Complete validation result
    95→ */
    96→export interface ValidationResult {
    97→  valid: boolean;
    98→  schemaErrors: SchemaValidationError[];
    99→  refErrors: RefValidationError[];
   100→  refWarnings: RefValidationWarning[];
   101→  orphans: OrphanItem[];
   102→  completenessWarnings: CompletenessWarning[];
   103→  traitCycleErrors: TraitCycleError[];
   104→  stats: {
   105→    filesChecked: number;
   106→    itemsChecked: number;
   107→    tasksChecked: number;
   108→  };
   109→  metaStats?: {
   110→    agents: number;
   111→    workflows: number;
   112→    conventions: number;
   113→    observations: number;
   114→  };
   115→}
   116→
   117→/**
   118→ * Validation options
   119→ */
   120→export interface ValidateOptions {
   121→  /** Check schema conformance */
   122→  schema?: boolean;
   123→  /** Check reference resolution */
   124→  refs?: boolean;
   125→  /** Find orphaned items */
   126→  orphans?: boolean;
   127→  /** Check spec completeness (missing AC, descriptions, status inconsistencies) */
   128→  completeness?: boolean;
   129→}
   130→
   131→// ============================================================
   132→// SCHEMA VALIDATION
   133→// ============================================================
   134→
   135→/**
   136→ * Validate a manifest file against schema
   137→ */
   138→async function validateManifestFile(
   139→  filePath: string,
   140→): Promise<SchemaValidationError[]> {
   141→  const errors: SchemaValidationError[] = [];
   142→
   143→  try {
   144→    const raw = await readYamlFile<unknown>(filePath);
   145→    const result = ManifestSchema.safeParse(raw);
   146→
   147→    if (!result.success) {
   148→      for (const issue of result.error.issues) {
   149→        errors.push({
   150→          file: filePath,
   151→          path: issue.path.join("."),
   152→          message: issue.message,
   153→          details: issue,
   154→        });
   155→      }
   156→    }
   157→  } catch (err) {
   158→    errors.push({
   159→      file: filePath,
   160→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   161→    });
   162→  }
   163→
   164→  return errors;
   165→}
   166→
   167→/**
   168→ * Validate a tasks file against schema
   169→ */
   170→async function validateTasksFile(
   171→  filePath: string,
   172→): Promise<SchemaValidationError[]> {
   173→  const errors: SchemaValidationError[] = [];
   174→
   175→  try {
   176→    const raw = await readYamlFile<unknown>(filePath);
   177→
   178→    // Handle both formats: { tasks: [...] } and plain array
   179→    let taskList: unknown[];
   180→
   181→    if (Array.isArray(raw)) {
   182→      taskList = raw;
   183→    } else if (raw && typeof raw === "object" && "tasks" in raw) {
   184→      // Try full TasksFile schema first
   185→      const fileResult = TasksFileSchema.safeParse(raw);
   186→      if (!fileResult.success) {
   187→        // If TasksFile fails, just validate individual tasks
   188→        taskList = (raw as { tasks: unknown[] }).tasks || [];
   189→      } else {
   190→        // File schema passed, validate individual tasks for detailed errors
   191→        taskList = fileResult.data.tasks;
   192→      }
   193→    } else {
   194→      errors.push({
   195→        file: filePath,
   196→        message:
   197→          "Invalid tasks file format: expected array or { tasks: [...] }",
   198→      });
   199→      return errors;
   200→    }
   201→
   202→    // Validate each task
   203→    for (let i = 0; i < taskList.length; i++) {
   204→      const task = taskList[i];
   205→      const result = TaskSchema.safeParse(task);
   206→
   207→      if (!result.success) {
   208→        for (const issue of result.error.issues) {
   209→          errors.push({
   210→            file: filePath,
   211→            path: `tasks[${i}].${issue.path.join(".")}`,
   212→            message: issue.message,
   213→            details: issue,
   214→          });
   215→        }
   216→      }
   217→    }
   218→  } catch (err) {
   219→    errors.push({
   220→      file: filePath,
   221→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   222→    });
   223→  }
   224→
   225→  return errors;
   226→}
   227→
   228→/**
   229→ * Validate a spec module file against schema
   230→ */
   231→async function validateSpecFile(
   232→  filePath: string,
   233→): Promise<SchemaValidationError[]> {
   234→  const errors: SchemaValidationError[] = [];
   235→
   236→  try {
   237→    const raw = await readYamlFile<unknown>(filePath);
   238→
   239→    // Recursively validate spec items
   240→    validateSpecItemRecursive(raw, filePath, "", errors);
   241→  } catch (err) {
   242→    errors.push({
   243→      file: filePath,
   244→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   245→    });
   246→  }
   247→
   248→  return errors;
   249→}
   250→
   251→/**
   252→ * Validate meta manifest file with strict ULID validation
   253→ * AC-meta-manifest-3: Invalid schema exits with code 1 and shows field path + expected type
   254→ */
   255→async function validateMetaManifestFile(
   256→  filePath: string,
   257→): Promise<SchemaValidationError[]> {
   258→  const errors: SchemaValidationError[] = [];
   259→
   260→  try {
   261→    const raw = await readYamlFile<unknown>(filePath);
   262→
   263→    // Validate overall manifest structure
   264→    const manifestResult = MetaManifestSchema.safeParse(raw);
   265→    if (!manifestResult.success) {
   266→      for (const issue of manifestResult.error.issues) {
   267→        errors.push({
   268→          file: filePath,
   269→          path: issue.path.join("."),
   270→          message: issue.message,
   271→          details: issue,
   272→        });
   273→      }
   274→      return errors;
   275→    }
   276→
   277→    // Validate each agent with strict ULID validation
   278→    if (
   279→      raw &&
   280→      typeof raw === "object" &&
   281→      "agents" in raw &&
   282→      Array.isArray((raw as Record<string, unknown>).agents)
   283→    ) {
   284→      const agents = (raw as Record<string, unknown>).agents as unknown[];
   285→      for (let i = 0; i < agents.length; i++) {
   286→        const agent = agents[i];
   287→        const agentResult = AgentSchema.safeParse(agent);
   288→        if (!agentResult.success) {
   289→          for (const issue of agentResult.error.issues) {
   290→            errors.push({
   291→              file: filePath,
   292→              path: `agents[${i}].${issue.path.join(".")}`,
   293→              message: issue.message,
   294→              details: issue,
   295→            });
   296→          }
   297→        }
   298→
   299→        // Strict ULID validation
   300→        if (agent && typeof agent === "object" && "_ulid" in agent) {
   301→          const ulidResult = UlidSchema.safeParse(
   302→            (agent as Record<string, unknown>)._ulid,
   303→          );
   304→          if (!ulidResult.success) {
   305→            errors.push({
   306→              file: filePath,
   307→              path: `agents[${i}]._ulid`,
   308→              message: "Invalid ULID format (expected 26 characters)",
   309→            });
   310→          }
   311→        }
   312→      }
   313→    }
   314→
   315→    // Validate each workflow with strict ULID validation
   316→    if (
   317→      raw &&
   318→      typeof raw === "object" &&
   319→      "workflows" in raw &&
   320→      Array.isArray((raw as Record<string, unknown>).workflows)
   321→    ) {
   322→      const workflows = (raw as Record<string, unknown>).workflows as unknown[];
   323→      for (let i = 0; i < workflows.length; i++) {
   324→        const workflow = workflows[i];
   325→        const workflowResult = WorkflowSchema.safeParse(workflow);
   326→        if (!workflowResult.success) {
   327→          for (const issue of workflowResult.error.issues) {
   328→            errors.push({
   329→              file: filePath,
   330→              path: `workflows[${i}].${issue.path.join(".")}`,
   331→              message: issue.message,
   332→              details: issue,
   333→            });
   334→          }
   335→        }
   336→
   337→        // Strict ULID validation
   338→        if (workflow && typeof workflow === "object" && "_ulid" in workflow) {
   339→          const ulidResult = UlidSchema.safeParse(
   340→            (workflow as Record<string, unknown>)._ulid,
   341→          );
   342→          if (!ulidResult.success) {
   343→            errors.push({
   344→              file: filePath,
   345→              path: `workflows[${i}]._ulid`,
   346→              message: "Invalid ULID format (expected 26 characters)",
   347→            });
   348→          }
   349→        }
   350→      }
   351→    }
   352→
   353→    // Validate each convention with strict ULID validation
   354→    if (
   355→      raw &&
   356→      typeof raw === "object" &&
   357→      "conventions" in raw &&
   358→      Array.isArray((raw as Record<string, unknown>).conventions)
   359→    ) {
   360→      const conventions = (raw as Record<string, unknown>)
   361→        .conventions as unknown[];
   362→      for (let i = 0; i < conventions.length; i++) {
   363→        const convention = conventions[i];
   364→        const conventionResult = ConventionSchema.safeParse(convention);
   365→        if (!conventionResult.success) {
   366→          for (const issue of conventionResult.error.issues) {
   367→            errors.push({
   368→              file: filePath,
   369→              path: `conventions[${i}].${issue.path.join(".")}`,
   370→              message: issue.message,
   371→              details: issue,
   372→            });
   373→          }
   374→        }
   375→
   376→        // Strict ULID validation
   377→        if (
   378→          convention &&
   379→          typeof convention === "object" &&
   380→          "_ulid" in convention
   381→        ) {
   382→          const ulidResult = UlidSchema.safeParse(
   383→            (convention as Record<string, unknown>)._ulid,
   384→          );
   385→          if (!ulidResult.success) {
   386→            errors.push({
   387→              file: filePath,
   388→              path: `conventions[${i}]._ulid`,
   389→              message: "Invalid ULID format (expected 26 characters)",
   390→            });
   391→          }
   392→        }
   393→      }
   394→    }
   395→
   396→    // Validate each observation with strict ULID validation
   397→    if (
   398→      raw &&
   399→      typeof raw === "object" &&
   400→      "observations" in raw &&
   401→      Array.isArray((raw as Record<string, unknown>).observations)
   402→    ) {
   403→      const observations = (raw as Record<string, unknown>)
   404→        .observations as unknown[];
   405→      for (let i = 0; i < observations.length; i++) {
   406→        const observation = observations[i];
   407→        const observationResult = ObservationSchema.safeParse(observation);
   408→        if (!observationResult.success) {
   409→          for (const issue of observationResult.error.issues) {
   410→            errors.push({
   411→              file: filePath,
   412→              path: `observations[${i}].${issue.path.join(".")}`,
   413→              message: issue.message,
   414→              details: issue,
   415→            });
   416→          }
   417→        }
   418→
   419→        // Strict ULID validation
   420→        if (
   421→          observation &&
   422→          typeof observation === "object" &&
   423→          "_ulid" in observation
   424→        ) {
   425→          const ulidResult = UlidSchema.safeParse(
   426→            (observation as Record<string, unknown>)._ulid,
   427→          );
   428→          if (!ulidResult.success) {
   429→            errors.push({
   430→              file: filePath,
   431→              path: `observations[${i}]._ulid`,
   432→              message: "Invalid ULID format (expected 26 characters)",
   433→            });
   434→          }
   435→        }
   436→      }
   437→    }
   438→  } catch (err) {
   439→    errors.push({
   440→      file: filePath,
   441→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   442→    });
   443→  }
   444→
   445→  return errors;
   446→}
   447→
   448→/**
   449→ * Recursively validate spec items in a structure
   450→ */
   451→function validateSpecItemRecursive(
   452→  raw: unknown,
   453→  file: string,
   454→  pathPrefix: string,
   455→  errors: SchemaValidationError[],
   456→): void {
   457→  if (!raw || typeof raw !== "object") return;
   458→
   459→  // Check if this is a spec item (has _ulid)
   460→  if ("_ulid" in raw) {
   461→    const result = SpecItemSchema.safeParse(raw);
   462→    if (!result.success) {
   463→      for (const issue of result.error.issues) {
   464→        errors.push({
   465→          file,
   466→          path: pathPrefix
   467→            ? `${pathPrefix}.${issue.path.join(".")}`
   468→            : issue.path.join("."),
   469→          message: issue.message,
   470→          details: issue,
   471→        });
   472→      }
   473→    }
   474→  }
   475→
   476→  // Recurse into nested structures
   477→  const nestedFields = [
   478→    "modules",
   479→    "features",
   480→    "requirements",
   481→    "constraints",
   482→    "decisions",
   483→    "items",
   484→  ];
   485→  const obj = raw as Record<string, unknown>;
   486→
   487→  for (const field of nestedFields) {
   488→    if (field in obj && Array.isArray(obj[field])) {
   489→      const arr = obj[field] as unknown[];
   490→      for (let i = 0; i < arr.length; i++) {
   491→        const newPath = pathPrefix
   492→          ? `${pathPrefix}.${field}[${i}]`
   493→          : `${field}[${i}]`;
   494→        validateSpecItemRecursive(arr[i], file, newPath, errors);
   495→      }
   496→    }
   497→  }
   498→}
   499→
   500→// ============================================================
   501→// ORPHAN DETECTION
   502→// ============================================================
   503→
   504→/**
   505→ * Find items that are not referenced by any other item
   506→ */
   507→function findOrphans(
   508→  tasks: LoadedTask[],
   509→  items: LoadedSpecItem[],
   510→  index: ReferenceIndex,
   511→): OrphanItem[] {
   512→  const orphans: OrphanItem[] = [];
   513→
   514→  // Build set of all referenced ULIDs
   515→  const referenced = new Set<string>();
   516→
   517→  const allItems = [...tasks, ...items];
   518→
   519→  // Fields that contain references
   520→  const refFields = [
   521→    "depends_on",
   522→    "blocked_by",
   523→    "implements",
   524→    "relates_to",
   525→    "tests",
   526→    "supersedes",
   527→    "spec_ref",
   528→    "context",
   529→  ];
   530→
   531→  for (const item of allItems) {
   532→    const obj = item as unknown as Record<string, unknown>;
   533→
   534→    for (const field of refFields) {
   535→      const value = obj[field];
   536→
   537→      if (typeof value === "string" && value.startsWith("@")) {
   538→        const resolved = index.resolve(value);
   539→        if (resolved.ok) {
   540→          referenced.add(resolved.ulid);
   541→        }
   542→      } else if (Array.isArray(value)) {
   543→        for (const v of value) {
   544→          if (typeof v === "string" && v.startsWith("@")) {
   545→            const resolved = index.resolve(v);
   546→            if (resolved.ok) {
   547→              referenced.add(resolved.ulid);
   548→            }
   549→          }
   550→        }
   551→      }
   552→    }
   553→  }
   554→
   555→  // Find items not in the referenced set
   556→  // Skip entry point types: modules are spec entry points, tasks are work items
   557→  const entryPointTypes = ["module", "task", "epic", "bug", "spike", "infra"];
   558→
   559→  for (const item of items) {
   560→    // Only check spec items, not tasks
   561→    if (!referenced.has(item._ulid)) {
   562→      // Skip entry point types
   563→      if (entryPointTypes.includes(item.type || "")) continue;
   564→
   565→      // Skip nested items - they're implicitly referenced by their parent
   566→      // _path indicates nesting (e.g., "features[0].requirements[2]")
   567→      if (item._path) continue;
   568→
   569→      orphans.push({
   570→        ulid: item._ulid,
   571→        title: item.title,
   572→        type: item.type || "unknown",
   573→        file: item._sourceFile,
   574→      });
   575→    }
   576→  }
   577→
   578→  return orphans;
   579→}
   580→
   581→// ============================================================
   582→// TRAIT CYCLE DETECTION
   583→// ============================================================
   584→
   585→/**
   586→ * Detect circular trait references
   587→ * AC: @trait-edge-cases ac-2
   588→ */
   589→function detectTraitCycles(
   590→  items: LoadedSpecItem[],
   591→  index: ReferenceIndex,
   592→): TraitCycleError[] {
   593→  const errors: TraitCycleError[] = [];
   594→  const traits = items.filter((item) => item.type === "trait");
   595→
   596→  // Build adjacency list: trait ULID → trait ULIDs it references
   597→  const graph = new Map<string, string[]>();
   598→  const traitInfo = new Map<string, { ref: string; title: string }>();
   599→
   600→  for (const trait of traits) {
   601→    const ref = trait.slugs?.[0]
   602→      ? `@${trait.slugs[0]}`
   603→      : `@${trait._ulid.slice(0, 8)}`;
   604→    traitInfo.set(trait._ulid, { ref, title: trait.title });
   605→
   606→    const dependencies: string[] = [];
   607→    if (trait.traits && trait.traits.length > 0) {
   608→      for (const traitRef of trait.traits) {
   609→        const result = index.resolve(traitRef);
   610→        if (result.ok) {
   611→          dependencies.push(result.ulid);
   612→        }
   613→      }
   614→    }
   615→    graph.set(trait._ulid, dependencies);
   616→  }
   617→
   618→  // DFS-based cycle detection
   619→  const visiting = new Set<string>();
   620→  const visited = new Set<string>();
   621→
   622→  function dfs(ulid: string, path: string[]): string[] | null {
   623→    if (visiting.has(ulid)) {
   624→      // Found a cycle - return the cycle path
   625→      const cycleStart = path.indexOf(ulid);
   626→      return path.slice(cycleStart);
   627→    }
   628→
   629→    if (visited.has(ulid)) {
   630→      return null; // Already checked this path
   631→    }
   632→
   633→    visiting.add(ulid);
   634→    path.push(ulid);
   635→
   636→    const dependencies = graph.get(ulid) || [];
   637→    for (const depUlid of dependencies) {
   638→      const cycle = dfs(depUlid, path);
   639→      if (cycle) {
   640→        return cycle;
   641→      }
   642→    }
   643→
   644→    visiting.delete(ulid);
   645→    visited.add(ulid);
   646→    path.pop();
   647→
   648→    return null;
   649→  }
   650→
   651→  // Check each trait for cycles
   652→  for (const trait of traits) {
   653→    if (!visited.has(trait._ulid)) {
   654→      const cycle = dfs(trait._ulid, []);
   655→      if (cycle) {
   656→        const info = traitInfo.get(cycle[0]);
   657→        if (info) {
   658→          const cycleRefs = cycle.map((ulid) => {
   659→            const cycleInfo = traitInfo.get(ulid);
   660→            return cycleInfo ? cycleInfo.ref : `@${ulid.slice(0, 8)}`;
   661→          });
   662→
   663→          errors.push({
   664→            traitRef: info.ref,
   665→            traitTitle: info.title,
   666→            cycle: cycleRefs,
   667→            message: `Circular trait reference: ${cycleRefs.join(" → ")} → ${cycleRefs[0]}`,
   668→          });
   669→        }
   670→
   671→        // Mark all traits in cycle as visited to avoid duplicate errors
   672→        for (const ulid of cycle) {
   673→          visited.add(ulid);
   674→        }
   675→      }
   676→    }
   677→  }
   678→
   679→  return errors;
   680→}
   681→
   682→// ============================================================
   683→// COMPLETENESS VALIDATION
   684→// ============================================================
   685→
   686→/**
   687→ * Scan test files for AC annotations to build coverage index
   688→ * Returns a Set of covered ACs in format "@spec-ref ac-N"
   689→ */
   690→async function scanTestCoverage(rootDir: string): Promise<Set<string>> {
   691→  const coveredACs = new Set<string>();
   692→  const testsDir = path.join(rootDir, "tests");
   693→
   694→  try {
   695→    // Check if tests directory exists
   696→    await fs.access(testsDir);
   697→
   698→    // Read all test files
   699→    const files = await fs.readdir(testsDir);
   700→    const testFiles = files.filter(
   701→      (f) => f.endsWith(".test.ts") || f.endsWith(".test.js"),
   702→    );
   703→
   704→    for (const file of testFiles) {
   705→      const filePath = path.join(testsDir, file);
   706→      const content = await fs.readFile(filePath, "utf-8");
   707→
   708→      // Match AC annotations: // AC: @spec-ref ac-N
   709→      // Also handle multiple ACs on one line: // AC: @spec-ref ac-1, ac-2
   710→      const acPattern =
   711→        /\/\/\s*AC:\s*(@[\w-]+)(?:\s+(ac-\d+(?:\s*,\s*ac-\d+)*))?/g;
   712→      let match;
   713→
   714→      while ((match = acPattern.exec(content)) !== null) {
   715→        const specRef = match[1]; // @spec-ref
   716→        const acList = match[2]; // "ac-1, ac-2" or just "ac-1" or undefined
   717→
   718→        if (acList) {
   719→          // Split by comma and trim
   720→          const acs = acList.split(",").map((ac) => ac.trim());
   721→          for (const ac of acs) {
   722→            coveredACs.add(`${specRef} ${ac}`);
   723→          }
   724→        } else {
   725→          // No specific AC mentioned, just the spec ref
   726→          // We'll consider this as generic coverage
   727→          coveredACs.add(specRef);
   728→        }
   729→      }
   730→    }
   731→  } catch (_err) {
   732→    // Tests directory doesn't exist or can't be read - that's ok
   733→  }
   734→
   735→  return coveredACs;
   736→}
   737→
   738→/**
   739→ * Check spec items for completeness
   740→ * AC: @spec-completeness ac-1, ac-2, ac-3
   741→ * AC: @trait-validation ac-1, ac-2, ac-3
   742→ */
   743→async function checkCompleteness(
   744→  items: LoadedSpecItem[],
   745→  _index: ReferenceIndex,
   746→  rootDir: string,
   747→  traitIndex?: TraitIndex,
   748→): Promise<CompletenessWarning[]> {
   749→  const warnings: CompletenessWarning[] = [];
   750→
   751→  // Scan test files for AC coverage
   752→  const coveredACs = await scanTestCoverage(rootDir);
   753→
   754→  for (const item of items) {
   755→    const itemRef = item.slugs?.[0]
   756→      ? `@${item.slugs[0]}`
   757→      : `@${item._ulid.slice(0, 8)}`;
   758→    const isTrait = item.type === "trait";
   759→
   760→    // AC: @spec-completeness ac-1
   761→    // AC: @trait-type ac-2 - Traits should have acceptance criteria for completeness
   762→    // Check for missing acceptance criteria
   763→    if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
   764→      warnings.push({
   765→        type: "missing_acceptance_criteria",
   766→        itemRef,
   767→        itemTitle: item.title,
   768→        message: `${isTrait ? "Trait" : "Item"} ${itemRef} has no acceptance criteria`,
   769→      });
   770→    }
   771→
   772→    // AC: @spec-completeness ac-2
   773→    // AC: @trait-type ac-3 - Traits should have description for completeness
   774→    // Check for missing description
   775→    if (!item.description || item.description.trim() === "") {
   776→      warnings.push({
   777→        type: "missing_description",
   778→        itemRef,
   779→        itemTitle: item.title,
   780→        message: `${isTrait ? "Trait" : "Item"} ${itemRef} has no description`,
   781→      });
   782→    }
   783→
   784→    // AC: @spec-completeness ac-3
   785→    // Check for status inconsistency between parent and children
   786→    if (item.status?.implementation === "implemented") {
   787→      // Check if this item has children with not_started status
   788→      const childFields = [
   789→        "modules",
   790→        "features",
   791→        "requirements",
   792→        "constraints",
   793→        "epics",
   794→        "themes",
   795→        "capabilities",
   796→      ];
   797→
   798→      for (const field of childFields) {
   799→        const children = (item as any)[field];
   800→        if (Array.isArray(children)) {
   801→          for (const child of children) {
   802→            if (child.status?.implementation === "not_started") {
   803→              const childRef = child.slugs?.[0]
   804→                ? `@${child.slugs[0]}`
   805→                : `@${child._ulid?.slice(0, 8) || "unknown"}`;
   806→              warnings.push({
   807→                type: "status_inconsistency",
   808→                itemRef,
   809→                itemTitle: item.title,
   810→                message: `Parent ${itemRef} is implemented but child ${childRef} is not_started`,
   811→                details: `Child: ${child.title}`,
   812→              });
   813→            }
   814→          }
   815→        }
   816→      }
   817→    }
   818→
   819→    // Check for test coverage of acceptance criteria
   820→    if (item.acceptance_criteria && item.acceptance_criteria.length > 0) {
   821→      const uncoveredACs: string[] = [];
   822→
   823→      for (const ac of item.acceptance_criteria) {
   824→        // Build all possible references for this AC
   825→        const possibleRefs: string[] = [];
   826→
   827→        // Try with primary slug
   828→        if (item.slugs && item.slugs.length > 0) {
   829→          possibleRefs.push(`@${item.slugs[0]} ${ac.id}`);
   830→          // Also check for just the slug without specific AC
   831→          possibleRefs.push(`@${item.slugs[0]}`);
   832→        }
   833→
   834→        // Try with ULID (short form)
   835→        possibleRefs.push(`@${item._ulid.slice(0, 8)} ${ac.id}`);
   836→        possibleRefs.push(`@${item._ulid.slice(0, 8)}`);
   837→
   838→        // Check if any of these references are covered
   839→        const isCovered = possibleRefs.some((ref) => coveredACs.has(ref));
   840→
   841→        if (!isCovered) {
   842→          uncoveredACs.push(ac.id);
   843→        }
   844→      }
   845→
   846→      // Only warn if there are uncovered ACs
   847→      if (uncoveredACs.length > 0) {
   848→        warnings.push({
   849→          type: "missing_test_coverage",
   850→          itemRef,
   851→          itemTitle: item.title,
   852→          message: `Item ${itemRef} has ${uncoveredACs.length} AC(s) without test coverage`,
   853→          details: `Uncovered: ${uncoveredACs.join(", ")}`,
   854→        });
   855→      }
   856→    }
   857→
   858→    // AC: @trait-validation ac-1, ac-2
   859→    // Check for test coverage of trait acceptance criteria
   860→    if (traitIndex && item.traits && item.traits.length > 0) {
   861→      const inheritedACs = traitIndex.getInheritedAC(item._ulid);
   862→      const uncoveredTraitACs: Array<{ traitSlug: string; acId: string }> = [];
   863→
   864→      for (const { trait, ac } of inheritedACs) {
   865→        // Build all possible references for this trait AC
   866→        const possibleRefs: string[] = [];
   867→
   868→        // Try with trait slug
   869→        possibleRefs.push(`@${trait.slug} ${ac.id}`);
   870→        possibleRefs.push(`@${trait.slug}`);
   871→
   872→        // Try with trait ULID (short form)
   873→        possibleRefs.push(`@${trait.ulid.slice(0, 8)} ${ac.id}`);
   874→        possibleRefs.push(`@${trait.ulid.slice(0, 8)}`);
   875→
   876→        // Check if any of these references are covered
   877→        const isCovered = possibleRefs.some((ref) => coveredACs.has(ref));
   878→
   879→        if (!isCovered) {
   880→          uncoveredTraitACs.push({ traitSlug: trait.slug, acId: ac.id });
   881→        }
   882→      }
   883→
   884→      // Only warn if there are uncovered trait ACs
   885→      if (uncoveredTraitACs.length > 0) {
   886→        const details = uncoveredTraitACs
   887→          .map(({ traitSlug, acId }) => `@${traitSlug} ${acId}`)
   888→          .join(", ");
   889→        warnings.push({
   890→          type: "missing_test_coverage",
   891→          itemRef,
   892→          itemTitle: item.title,
   893→          message: `Item ${itemRef} has ${uncoveredTraitACs.length} inherited trait AC(s) without test coverage`,
   894→          details: `Uncovered trait ACs: ${details}`,
   895→        });
   896→      }
   897→    }
   898→
   899→    // AC: @trait-retrospective ac-2, ac-3
   900→    // Check retrospective specs have required verification metadata
   901→    const isRetrospective = item.traits?.includes("@trait-retrospective");
   902→    if (isRetrospective) {
   903→      const isImplementedOrVerified =
   904→        item.status?.implementation === "implemented" ||
   905→        item.status?.implementation === "verified";
   906→
   907→      // AC: @trait-retrospective ac-2
   908→      // Retrospective specs with implemented/verified status must have verification metadata
   909→      if (isImplementedOrVerified) {
   910→        if (!item.verified_at || !item.verified_by) {
   911→          warnings.push({
   912→            type: "status_inconsistency",
   913→            itemRef,
   914→            itemTitle: item.title,
   915→            message: `Retrospective spec ${itemRef} is ${item.status?.implementation} but missing verified_at/verified_by`,
   916→            details:
   917→              "Specs using @trait-retrospective must have verified_at and verified_by fields when marked as implemented or verified",
   918→          });
   919→        }
   920→      }
   921→    }
   922→  }
   923→
   924→  return warnings;
   925→}
   926→
   927→// ============================================================
   928→// AUTOMATION VALIDATION
   929→// ============================================================
   930→
   931→/**
   932→ * Check task automation status for warnings
   933→ * AC: @task-automation-eligibility ac-21, ac-23
   934→ */
   935→function checkAutomationEligibility(
   936→  tasks: LoadedTask[],
   937→  index: ReferenceIndex,
   938→): CompletenessWarning[] {
   939→  const warnings: CompletenessWarning[] = [];
   940→
   941→  for (const task of tasks) {
   942→    const taskRef = task.slugs?.[0]
   943→      ? `@${task.slugs[0]}`
   944→      : `@${task._ulid.slice(0, 8)}`;
   945→
   946→    // AC: @task-automation-eligibility ac-21
   947→    // Warn if eligible but no spec_ref
   948→    if (task.automation === "eligible" && !task.spec_ref) {
   949→      warnings.push({
   950→        type: "automation_eligible_no_spec",
   951→        itemRef: taskRef,
   952→        itemTitle: task.title,
   953→        message: `Task ${taskRef} is automation: eligible but has no spec_ref - eligible tasks should have linked specs`,
   954→      });
   955→    }
   956→
   957→    // AC: @task-automation-eligibility ac-23
   958→    // Warn if eligible but spec_ref doesn't resolve
   959→    if (task.automation === "eligible" && task.spec_ref) {
   960→      const specResult = index.resolve(task.spec_ref);
   961→      if (!specResult.ok) {
   962→        warnings.push({
   963→          type: "automation_eligible_no_spec",
   964→          itemRef: taskRef,
   965→          itemTitle: task.title,
   966→          message: `Task ${taskRef} is automation: eligible but spec_ref ${task.spec_ref} cannot be resolved`,
   967→        });
   968→      }
   969→    }
   970→  }
   971→
   972→  return warnings;
   973→}
   974→
   975→// ============================================================
   976→// MAIN VALIDATION
   977→// ============================================================
   978→
   979→/**
   980→ * Run full validation on a kspec project
   981→ */
   982→export async function validate(
   983→  ctx: KspecContext,
   984→  options: ValidateOptions = {},
   985→): Promise<ValidationResult> {
   986→  // Default: run all checks
   987→  const runSchema = options.schema !== false;
   988→  const runRefs = options.refs !== false;
   989→  const runOrphans = options.orphans !== false;
   990→  const runCompleteness = options.completeness !== false;
   991→
   992→  const result: ValidationResult = {
   993→    valid: true,
   994→    schemaErrors: [],
   995→    refErrors: [],
   996→    refWarnings: [],
   997→    orphans: [],
   998→    completenessWarnings: [],
   999→    traitCycleErrors: [],
  1000→    stats: {
  1001→      filesChecked: 0,
  1002→      itemsChecked: 0,
  1003→      tasksChecked: 0,
  1004→    },
  1005→  };
  1006→
  1007→  const allTasks: LoadedTask[] = [];
  1008→  const allItems: LoadedSpecItem[] = [];
  1009→
  1010→  // Validate manifest
  1011→  if (ctx.manifestPath && runSchema) {
  1012→    const manifestErrors = await validateManifestFile(ctx.manifestPath);
  1013→    result.schemaErrors.push(...manifestErrors);
  1014→    result.stats.filesChecked++;
  1015→  }
  1016→
  1017→  // Load items from manifest (traits, inline modules, etc.)
  1018→  if (ctx.manifest && ctx.manifestPath) {
  1019→    const manifestItems = extractItemsFromRaw(ctx.manifest, ctx.manifestPath);
  1020→    allItems.push(...manifestItems);
  1021→    result.stats.itemsChecked += manifestItems.length;
  1022→  }
  1023→
  1024→  // Find and validate task files
  1025→  const taskFiles = await findTaskFiles(ctx.rootDir);
  1026→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, "spec"));
  1027→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
  1028→
  1029→  for (const taskFile of allTaskFiles) {
  1030→    if (runSchema) {
  1031→      const taskErrors = await validateTasksFile(taskFile);
  1032→      result.schemaErrors.push(...taskErrors);
  1033→    }
  1034→    result.stats.filesChecked++;
  1035→
  1036→    // Load tasks for ref validation
  1037→    try {
  1038→      const raw = await readYamlFile<unknown>(taskFile);
  1039→      let taskList: unknown[] = [];
  1040→
  1041→      if (Array.isArray(raw)) {
  1042→        taskList = raw;
  1043→      } else if (raw && typeof raw === "object" && "tasks" in raw) {
  1044→        taskList = (raw as { tasks: unknown[] }).tasks || [];
  1045→      }
  1046→
  1047→      for (const t of taskList) {
  1048→        const parsed = TaskSchema.safeParse(t);
  1049→        if (parsed.success) {
  1050→          allTasks.push({ ...parsed.data, _sourceFile: taskFile });
  1051→          result.stats.tasksChecked++;
  1052→        }
  1053→      }
  1054→    } catch {
  1055→      // Already reported in schema validation
  1056→    }
  1057→  }
  1058→
  1059→  // Validate spec files (from includes)
  1060→  if (ctx.manifest && ctx.manifestPath) {
  1061→    const manifestDir = path.dirname(ctx.manifestPath);
  1062→    const includes = ctx.manifest.includes || [];
  1063→
  1064→    for (const include of includes) {
  1065→      const expandedPaths = await expandIncludePattern(include, manifestDir);
  1066→
  1067→      for (const filePath of expandedPaths) {
  1068→        if (runSchema) {
  1069→          const specErrors = await validateSpecFile(filePath);
  1070→          result.schemaErrors.push(...specErrors);
  1071→        }
  1072→        result.stats.filesChecked++;
  1073→
  1074→        // Load items for ref validation
  1075→        try {
  1076→          const items = await loadSpecFile(filePath);
  1077→          allItems.push(...items);
  1078→          result.stats.itemsChecked += items.length;
  1079→        } catch {
  1080→          // Already reported in schema validation
  1081→        }
  1082→      }
  1083→    }
  1084→  }
  1085→
  1086→  // Load meta items for reference validation
  1087→  // AC: @agent-definitions ac-agent-3
  1088→  const metaCtx = await loadMetaContext(ctx);
  1089→  const allMetaItems = [
  1090→    ...metaCtx.agents,
  1091→    ...metaCtx.workflows,
  1092→    ...metaCtx.conventions,
  1093→    ...metaCtx.observations,
  1094→  ];
  1095→
  1096→  // Reference validation
  1097→  if (
  1098→    runRefs &&
  1099→    (allTasks.length > 0 || allItems.length > 0 || allMetaItems.length > 0)
  1100→  ) {
  1101→    const index = new ReferenceIndex(allTasks, allItems, allMetaItems);
  1102→    const refResult = validateRefs(index, allTasks, allItems);
  1103→    result.refErrors = refResult.errors;
  1104→    result.refWarnings = refResult.warnings;
  1105→
  1106→    // AC: @trait-edge-cases ac-2
  1107→    // Detect circular trait references
  1108→    result.traitCycleErrors = detectTraitCycles(allItems, index);
  1109→
  1110→    // Orphan detection
  1111→    if (runOrphans) {
  1112→      result.orphans = findOrphans(allTasks, allItems, index);
  1113→    }
  1114→
  1115→    // Completeness validation
  1116→    // AC: @spec-completeness ac-1, ac-2, ac-3
  1117→    // AC: @trait-validation ac-3
  1118→    if (runCompleteness) {
  1119→      // Build trait index for trait AC coverage validation
  1120→      const traitIndex = new TraitIndex(allItems, index);
  1121→      result.completenessWarnings = await checkCompleteness(
  1122→        allItems,
  1123→        index,
  1124→        ctx.rootDir,
  1125→        traitIndex,
  1126→      );
  1127→
  1128→      // AC: @task-automation-eligibility ac-21, ac-23
  1129→      // Check automation eligibility warnings for tasks
  1130→      const automationWarnings = checkAutomationEligibility(allTasks, index);
  1131→      result.completenessWarnings.push(...automationWarnings);
  1132→    }
  1133→  }
  1134→
  1135→  // Meta manifest validation (AC-meta-manifest-2, AC-meta-manifest-3)
  1136→  const metaManifestPath = await findMetaManifest(ctx.specDir);
  1137→  if (metaManifestPath) {
  1138→    // Use metaCtx already loaded above
  1139→    result.metaStats = {
  1140→      agents: metaCtx.agents.length,
  1141→      workflows: metaCtx.workflows.length,
  1142→      conventions: metaCtx.conventions.length,
  1143→      observations: metaCtx.observations.length,
  1144→    };
  1145→
  1146→    // Validate meta manifest schema with strict ULID validation
  1147→    if (runSchema) {
  1148→      const metaErrors = await validateMetaManifestFile(metaManifestPath);
  1149→      // Prefix all meta errors with "meta:"
  1150→      for (const err of metaErrors) {
  1151→        err.path = err.path ? `meta:${err.path}` : "meta:";
  1152→      }
  1153→      result.schemaErrors.push(...metaErrors);
  1154→      result.stats.filesChecked++;
  1155→    }
  1156→  }
  1157→
  1158→  // Set valid flag
  1159→  result.valid =
  1160→    result.schemaErrors.length === 0 &&
  1161→    result.refErrors.length === 0 &&
  1162→    result.traitCycleErrors.length === 0;
  1163→
  1164→  return result;
  1165→}
  1166→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
```