   396→
   397→    // AC: @shadow-recovery ac-recovery-4 - Healthy → repair succeeds without changes (idempotent)
   398→    it('succeeds without changes when already healthy', async () => {
   399→      await setupHealthyShadow();
   400→
   401→      const result = await repairShadow(testDir);
   402→      expect(result.success).toBe(true);
   403→      expect(result.alreadyExists).toBe(true);
   404→      expect(result.worktreeCreated).toBe(false);
   405→    });
   406→
   407→    // AC: @shadow-recovery ac-recovery-5 - Healthy → status reports healthy
   408→    it('status reports healthy when shadow is working', async () => {
   409→      await setupHealthyShadow();
   410→
   411→      const status = await getShadowStatus(testDir);
   412→      expect(status.healthy).toBe(true);
   413→      expect(status.branchExists).toBe(true);
   414→      expect(status.worktreeExists).toBe(true);
   415→      expect(status.worktreeLinked).toBe(true);
   416→      expect(status.error).toBeUndefined();
   417→    });
   418→
   419→    // AC: @shadow-recovery ac-recovery-6 - Issues → status reports issue and suggests repair
   420→    it('status reports specific issue when worktree is broken', async () => {
   421→      await setupHealthyShadow();
   422→
   423→      // Break: remove worktree
   424→      execSync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, { cwd: testDir, stdio: 'pipe' });
   425→
   426→      const status = await getShadowStatus(testDir);
   427→      expect(status.healthy).toBe(false);
   428→      expect(status.branchExists).toBe(true);
   429→      expect(status.worktreeExists).toBe(false);
   430→      expect(status.error).toContain('worktree missing');
   431→    });
   432→  });
