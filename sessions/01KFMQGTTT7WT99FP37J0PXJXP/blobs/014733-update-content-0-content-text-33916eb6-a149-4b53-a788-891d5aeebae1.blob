    33→describe('Shadow Branch', () => {
    34→  // Use /tmp to ensure we're outside any git repo for proper isolation
    35→  const testDir = path.join('/tmp', `kspec-shadow-test-${Date.now()}`);
    36→
    37→  beforeEach(async () => {
    38→    // Clean up any previous test directory
    39→    try {
    40→      await fs.rm(testDir, { recursive: true });
    41→    } catch {
    42→      // Doesn't exist, that's fine
    43→    }
    44→    await fs.mkdir(testDir, { recursive: true });
    45→  });
    46→
    47→  afterEach(async () => {
    48→    try {
    49→      await fs.rm(testDir, { recursive: true });
    50→    } catch {
    51→      // Best effort cleanup
    52→    }
    53→  });
    54→
    55→  describe('detectShadow', () => {
    56→    it('returns null for non-git directory', async () => {
    57→      const result = await detectShadow(testDir);
    58→      expect(result).toBeNull();
    59→    });
    60→
    61→    it('returns null for git repo without .kspec', async () => {
    62→      // Initialize a git repo
    63→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
    64→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
    65→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
    66→
    67→      const result = await detectShadow(testDir);
    68→      expect(result).toBeNull();
    69→    });
    70→  });
    71→
    72→  describe('getShadowStatus', () => {
    73→    it('reports not a git repo', async () => {
    74→      const status = await getShadowStatus(testDir);
    75→      expect(status.exists).toBe(false);
    76→      expect(status.healthy).toBe(false);
    77→      expect(status.error).toBe('Not a git repository');
    78→    });
    79→
