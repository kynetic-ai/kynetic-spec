   315→  describe('repairShadow', () => {
   316→    // Helper to set up a healthy shadow branch
   317→    async function setupHealthyShadow(): Promise<void> {
   318→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   319→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   320→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   321→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   322→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   323→      await initializeShadow(testDir);
   324→    }
   325→
   326→    // AC: @shadow-recovery ac-recovery-1 - Branch exists but .kspec/ deleted → repair recreates
   327→    it('recreates worktree when .kspec/ directory is deleted', async () => {
   328→      await setupHealthyShadow();
   329→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   330→
   331→      // Verify healthy before breaking
   332→      let status = await getShadowStatus(testDir);
   333→      expect(status.healthy).toBe(true);
   334→
   335→      // Break: delete the worktree directory
   336→      // First remove from git worktree list to avoid stale reference
   337→      execSync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, { cwd: testDir, stdio: 'pipe' });
   338→
   339→      // Verify broken
   340→      status = await getShadowStatus(testDir);
   341→      expect(status.healthy).toBe(false);
   342→      expect(status.branchExists).toBe(true);
   343→      expect(status.worktreeExists).toBe(false);
   344→
   345→      // Repair
   346→      const result = await repairShadow(testDir);
   347→      expect(result.success).toBe(true);
   348→      expect(result.worktreeCreated).toBe(true);
   349→
   350→      // Verify healthy again
   351→      status = await getShadowStatus(testDir);
   352→      expect(status.healthy).toBe(true);
   353→      expect(await isValidWorktree(worktreeDir)).toBe(true);
   354→    });
   355→
   356→    // AC: @shadow-recovery ac-recovery-2 - .kspec/ exists but .git file corrupt → repair recreates
   357→    it('recreates worktree when .git file is corrupted', async () => {
   358→      await setupHealthyShadow();
   359→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   360→      const gitFile = path.join(worktreeDir, '.git');
   361→
   362→      // Verify healthy before breaking
   363→      let status = await getShadowStatus(testDir);
   364→      expect(status.healthy).toBe(true);
   365→
   366→      // Break: corrupt the .git file
   367→      await fs.writeFile(gitFile, 'corrupted content');
   368→
   369→      // Verify broken
   370→      status = await getShadowStatus(testDir);
   371→      expect(status.healthy).toBe(false);
   372→      expect(status.worktreeExists).toBe(true);
   373→      expect(status.worktreeLinked).toBe(false);
   374→
   375→      // Repair
   376→      const result = await repairShadow(testDir);
   377→      expect(result.success).toBe(true);
   378→      expect(result.worktreeCreated).toBe(true);
   379→
   380→      // Verify healthy again
   381→      status = await getShadowStatus(testDir);
   382→      expect(status.healthy).toBe(true);
   383→    });
   384→
   385→    // AC: @shadow-recovery ac-recovery-3 - No shadow branch → repair fails suggesting init
   386→    it('fails with helpful error when shadow branch does not exist', async () => {
   387→      // Just a git repo without shadow branch
   388→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   389→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   390→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   391→
   392→      const result = await repairShadow(testDir);
