  1159→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
  1160→
  1161→      // Initialize shadow - should install hook
  1162→      const result = await initializeShadow(testDir);
  1163→      expect(result.success).toBe(true);
  1164→
  1165→      // Verify hook was installed to .git/hooks/pre-commit
  1166→      const installedHookPath = path.join(testDir, '.git', 'hooks', 'pre-commit');
  1167→      try {
  1168→        const hookContent = await fs.readFile(installedHookPath, 'utf-8');
  1169→        expect(hookContent).toBe('#!/bin/sh\necho "test hook"\nexit 0\n');
  1170→
  1171→        // Verify hook is executable
