  1173→        expect(stats.mode & 0o111).toBeGreaterThan(0); // At least one execute bit set
  1174→      } catch (err) {
  1175→        expect.fail(`Hook should be installed at ${installedHookPath}: ${err}`);
  1176→      }
  1177→    });
