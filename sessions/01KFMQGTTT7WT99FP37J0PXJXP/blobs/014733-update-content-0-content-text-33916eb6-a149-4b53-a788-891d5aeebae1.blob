  1153→
  1154→      // Initialize git repo with initial commit
  1155→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
  1156→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
  1157→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
