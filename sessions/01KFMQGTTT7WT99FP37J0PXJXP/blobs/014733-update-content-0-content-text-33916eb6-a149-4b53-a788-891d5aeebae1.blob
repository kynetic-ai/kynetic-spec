   543→          encoding: 'utf-8',
   544→          stdio: ['pipe', 'pipe', 'pipe'],
   545→        }).trim();
   546→        expect(tracking).toBe('origin');
   547→      } finally {
   548→        await fs.rm(cloneDir, { recursive: true, force: true });
   549→      }
