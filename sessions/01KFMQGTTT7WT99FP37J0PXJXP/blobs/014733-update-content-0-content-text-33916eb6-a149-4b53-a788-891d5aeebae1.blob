   693→    // AC: @shadow-sync ac-6 - shadowPull uses --ff-only first, falls back to --rebase
   694→    it('shadowPull pulls changes from remote', async () => {
   695→      await setupSyncTest();
   696→
   697→      // Make a change on remote by cloning, modifying, and pushing
   698→      const cloneDir = path.join('/tmp', `kspec-sync-clone-${Date.now()}`);
   699→      try {
   700→        execSync(`git clone ${remoteDir} ${cloneDir}`, { stdio: 'pipe' });
   701→        execSync('git config user.email "test@test.com"', { cwd: cloneDir, stdio: 'pipe' });
   702→        execSync('git config user.name "Test"', { cwd: cloneDir, stdio: 'pipe' });
   703→        execSync(`git worktree add .kspec ${SHADOW_BRANCH_NAME}`, { cwd: cloneDir, stdio: 'pipe' });
   704→
   705→        // Modify a file in the clone's shadow
   706→        const tasksFile = (await fs.readdir(path.join(cloneDir, '.kspec')))
   707→          .find(f => f.endsWith('.tasks.yaml'));
   708→        if (tasksFile) {
   709→          await fs.appendFile(
   710→            path.join(cloneDir, '.kspec', tasksFile),
   711→            '\n# Remote change\n'
   712→          );
   713→          execSync('git add -A && git commit -m "Remote change"', {
   714→            cwd: path.join(cloneDir, '.kspec'),
   715→            stdio: 'pipe',
   716→          });
   717→          execSync(`git push origin ${SHADOW_BRANCH_NAME}`, {
   718→            cwd: path.join(cloneDir, '.kspec'),
   719→            stdio: 'pipe',
   720→          });
   721→        }
   722→
   723→        // Now pull in original repo
   724→        const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   725→        const result = await shadowPull(worktreeDir);
   726→
   727→        expect(result.success).toBe(true);
   728→        expect(result.pulled).toBe(true);
   729→        expect(result.hadConflict).toBe(false);
   730→
   731→        // Verify the change was pulled
   732→        const content = await fs.readFile(path.join(worktreeDir, tasksFile!), 'utf-8');
   733→        expect(content).toContain('# Remote change');
   734→      } finally {
   735→        await fs.rm(cloneDir, { recursive: true, force: true });
   736→      }
   737→    });
   738→
   739→    // shadowSync does pull then push
   740→    it('shadowSync pulls and pushes', async () => {
   741→      await setupSyncTest();
   742→
   743→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   744→
   745→      // Make a local change
   746→      const tasksFile = (await fs.readdir(worktreeDir))
   747→        .find(f => f.endsWith('.tasks.yaml'));
   748→      if (tasksFile) {
   749→        await fs.appendFile(
   750→          path.join(worktreeDir, tasksFile),
   751→          '\n# Local change\n'
   752→        );
   753→        execSync('git add -A && git commit -m "Local change"', {
   754→          cwd: worktreeDir,
   755→          stdio: 'pipe',
   756→        });
   757→      }
   758→
   759→      const result = await shadowSync(worktreeDir);
   760→
   761→      expect(result.success).toBe(true);
   762→      expect(result.pushed).toBe(true);
   763→
   764→      // Verify the change was pushed by checking remote
   765→      const cloneDir = path.join('/tmp', `kspec-verify-${Date.now()}`);
   766→      try {
   767→        execSync(`git clone ${remoteDir} ${cloneDir}`, { stdio: 'pipe' });
   768→        execSync(`git -C ${cloneDir} checkout ${SHADOW_BRANCH_NAME}`, { stdio: 'pipe' });
   769→        const content = await fs.readFile(path.join(cloneDir, tasksFile!), 'utf-8');
   770→        expect(content).toContain('# Local change');
   771→      } finally {
   772→        await fs.rm(cloneDir, { recursive: true, force: true });
   773→      }
   774→    });
