   434→  // AC: @shadow-init-remote - Remote detection tests
   435→  describe('initializeShadow with remote', () => {
   436→    // Create a bare repo to act as a "remote"
   437→    const remoteDir = path.join('/tmp', `kspec-remote-test-${Date.now()}`);
   438→
   439→    beforeEach(async () => {
   440→      // Clean up remote directory
   441→      try {
   442→        await fs.rm(remoteDir, { recursive: true });
   443→      } catch {
   444→        // Doesn't exist
   445→      }
   446→    });
   447→
   448→    afterEach(async () => {
   449→      try {
   450→        await fs.rm(remoteDir, { recursive: true });
   451→      } catch {
   452→        // Best effort cleanup
   453→      }
   454→    });
   455→
   456→    // Helper to set up a bare repo as remote
   457→    async function setupBareRemote(): Promise<void> {
   458→      await fs.mkdir(remoteDir, { recursive: true });
   459→      execSync('git init --bare', { cwd: remoteDir, stdio: 'pipe' });
   460→    }
   461→
   462→    // Helper to set up a local repo with remote
   463→    async function setupLocalWithRemote(): Promise<void> {
   464→      execSync('git init -b main', { cwd: testDir, stdio: 'pipe' });
   465→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   466→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   467→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   468→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   469→      execSync(`git remote add origin ${remoteDir}`, { cwd: testDir, stdio: 'pipe' });
   470→      execSync('git push -u origin main', { cwd: testDir, stdio: 'pipe' });
   471→    }
   472→
   473→    // Helper to push shadow branch to remote
   474→    async function pushShadowToRemote(): Promise<void> {
   475→      execSync(`git -C ${testDir}/.kspec push -u origin ${SHADOW_BRANCH_NAME}`, { stdio: 'pipe' });
   476→    }
   477→
   478→    it('hasRemote returns false when no remote configured', async () => {
   479→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   480→      expect(await hasRemote(testDir)).toBe(false);
   481→    });
   482→
   483→    it('hasRemote returns true when origin exists', async () => {
   484→      await setupBareRemote();
   485→      await setupLocalWithRemote();
   486→      expect(await hasRemote(testDir)).toBe(true);
   487→    });
   488→
   489→    it('remoteBranchExists returns false when branch not on remote', async () => {
   490→      await setupBareRemote();
   491→      await setupLocalWithRemote();
   492→      expect(await remoteBranchExists(testDir, SHADOW_BRANCH_NAME)).toBe(false);
   493→    });
   494→
   495→    it('remoteBranchExists returns true after pushing shadow branch', async () => {
   496→      await setupBareRemote();
   497→      await setupLocalWithRemote();
   498→
   499→      // Initialize shadow locally
   500→      await initializeShadow(testDir);
   501→
   502→      // Push to remote
   503→      await pushShadowToRemote();
   504→
   505→      // Now check - need to fetch first
   506→      await fetchRemote(testDir);
   507→      expect(await remoteBranchExists(testDir, SHADOW_BRANCH_NAME)).toBe(true);
   508→    });
   509→
   510→    // AC: @shadow-init-remote ac-1 - Remote has shadow branch → creates worktree from it with tracking
   511→    it('attaches to existing remote shadow branch', async () => {
   512→      await setupBareRemote();
   513→      await setupLocalWithRemote();
   514→
   515→      // Initialize shadow in first repo and push
   516→      const result1 = await initializeShadow(testDir);
   517→      expect(result1.success).toBe(true);
   518→      expect(result1.branchCreated).toBe(true);
   519→
   520→      // Push shadow to remote
   521→      await pushShadowToRemote();
   522→
   523→      // Create a "clone" (new repo pointing to same remote)
   524→      const cloneDir = path.join('/tmp', `kspec-clone-test-${Date.now()}`);
   525→      try {
   526→        execSync(`git clone ${remoteDir} ${cloneDir}`, { stdio: 'pipe' });
   527→        execSync('git config user.email "test@test.com"', { cwd: cloneDir, stdio: 'pipe' });
   528→        execSync('git config user.name "Test"', { cwd: cloneDir, stdio: 'pipe' });
   529→
   530→        // Initialize shadow in clone - should attach to remote branch
   531→        const result2 = await initializeShadow(cloneDir);
   532→        expect(result2.success).toBe(true);
   533→        expect(result2.createdFromRemote).toBe(true);
   534→        expect(result2.branchCreated).toBe(false);
