   230→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   231→
   232→      const result = await initializeShadow(testDir, { projectName: 'Test Project' });
   233→
   234→      expect(result.success).toBe(true);
   235→      expect(result.branchCreated).toBe(true);
   236→      expect(result.worktreeCreated).toBe(true);
   237→      expect(result.gitignoreUpdated).toBe(true);
   238→
   239→      // Verify branch exists
   240→      expect(await branchExists(testDir, SHADOW_BRANCH_NAME)).toBe(true);
