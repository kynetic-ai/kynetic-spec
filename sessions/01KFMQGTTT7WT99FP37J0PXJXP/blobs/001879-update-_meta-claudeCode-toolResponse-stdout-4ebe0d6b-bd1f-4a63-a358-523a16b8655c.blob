diff --git a/packages/daemon/package.json b/packages/daemon/package.json
new file mode 100644
index 00000000..a081a55e
--- /dev/null
+++ b/packages/daemon/package.json
@@ -0,0 +1,24 @@
+{
+  "name": "@kynetic-ai/daemon",
+  "version": "0.1.0",
+  "description": "Kspec daemon server with WebSocket support",
+  "type": "module",
+  "main": "dist/index.js",
+  "types": "dist/index.d.ts",
+  "bin": {
+    "kspec-daemon": "./dist/index.js"
+  },
+  "scripts": {
+    "build": "tsc",
+    "dev": "bun --watch src/index.ts",
+    "start": "bun dist/index.js"
+  },
+  "dependencies": {
+    "elysia": "^1.1.31",
+    "@kynetic-ai/shared": "*"
+  },
+  "devDependencies": {
+    "@types/bun": "latest",
+    "typescript": "^5.3.3"
+  }
+}
diff --git a/packages/daemon/tsconfig.json b/packages/daemon/tsconfig.json
new file mode 100644
index 00000000..83830a06
--- /dev/null
+++ b/packages/daemon/tsconfig.json
@@ -0,0 +1,21 @@
+{
+  "compilerOptions": {
+    "target": "ES2022",
+    "module": "ESNext",
+    "moduleResolution": "bundler",
+    "lib": ["ES2022"],
+    "outDir": "dist",
+    "rootDir": "src",
+    "strict": true,
+    "esModuleInterop": true,
+    "skipLibCheck": true,
+    "forceConsistentCasingInFileNames": true,
+    "declaration": true,
+    "declarationMap": true,
+    "sourceMap": true,
+    "resolveJsonModule": true,
+    "types": ["bun-types"]
+  },
+  "include": ["src/**/*"],
+  "exclude": ["node_modules", "dist"]
+}
diff --git a/packages/shared/package.json b/packages/shared/package.json
new file mode 100644
index 00000000..4fc8d471
--- /dev/null
+++ b/packages/shared/package.json
@@ -0,0 +1,21 @@
+{
+  "name": "@kynetic-ai/shared",
+  "version": "0.1.0",
+  "description": "Shared types and utilities for kspec packages",
+  "type": "module",
+  "main": "dist/index.js",
+  "types": "dist/index.d.ts",
+  "exports": {
+    ".": "./dist/index.js"
+  },
+  "scripts": {
+    "build": "tsc",
+    "typecheck": "tsc --noEmit"
+  },
+  "dependencies": {
+    "zod": "^3.23.8"
+  },
+  "devDependencies": {
+    "typescript": "^5.3.3"
+  }
+}
diff --git a/packages/shared/tsconfig.json b/packages/shared/tsconfig.json
new file mode 100644
index 00000000..fc0c8a2e
--- /dev/null
+++ b/packages/shared/tsconfig.json
@@ -0,0 +1,20 @@
+{
+  "compilerOptions": {
+    "target": "ES2022",
+    "module": "NodeNext",
+    "moduleResolution": "NodeNext",
+    "lib": ["ES2022"],
+    "outDir": "dist",
+    "rootDir": "src",
+    "strict": true,
+    "esModuleInterop": true,
+    "skipLibCheck": true,
+    "forceConsistentCasingInFileNames": true,
+    "declaration": true,
+    "declarationMap": true,
+    "sourceMap": true,
+    "resolveJsonModule": true
+  },
+  "include": ["src/**/*"],
+  "exclude": ["node_modules", "dist"]
+}
diff --git a/packages/web-ui/package.json b/packages/web-ui/package.json
new file mode 100644
index 00000000..909f1a3a
--- /dev/null
+++ b/packages/web-ui/package.json
@@ -0,0 +1,25 @@
+{
+  "name": "@kynetic-ai/web-ui",
+  "version": "0.1.0",
+  "description": "Kspec web dashboard built with SvelteKit",
+  "type": "module",
+  "scripts": {
+    "dev": "vite dev",
+    "build": "vite build",
+    "preview": "vite preview",
+    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
+    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
+  },
+  "dependencies": {
+    "@kynetic-ai/shared": "*"
+  },
+  "devDependencies": {
+    "@sveltejs/adapter-auto": "^3.0.0",
+    "@sveltejs/kit": "^2.0.0",
+    "@sveltejs/vite-plugin-svelte": "^4.0.0",
+    "svelte": "^5.0.0",
+    "svelte-check": "^4.0.0",
+    "typescript": "^5.3.3",
+    "vite": "^5.0.0"
+  }
+}
diff --git a/packages/web-ui/tsconfig.json b/packages/web-ui/tsconfig.json
new file mode 100644
index 00000000..a00c3288
--- /dev/null
+++ b/packages/web-ui/tsconfig.json
@@ -0,0 +1,18 @@
+{
+  "extends": "./.svelte-kit/tsconfig.json",
+  "compilerOptions": {
+    "target": "ES2022",
+    "module": "ESNext",
+    "moduleResolution": "bundler",
+    "lib": ["ES2022", "DOM"],
+    "strict": true,
+    "esModuleInterop": true,
+    "skipLibCheck": true,
+    "forceConsistentCasingInFileNames": true,
+    "resolveJsonModule": true,
+    "allowJs": true,
+    "checkJs": true
+  },
+  "include": ["src/**/*"],
+  "exclude": ["node_modules", ".svelte-kit", "build"]
+}
diff --git a/tsconfig.json b/tsconfig.json
index 7e203e77..db5ba714 100644
--- a/tsconfig.json
+++ b/tsconfig.json
@@ -13,8 +13,13 @@
     "declaration": true,
     "declarationMap": true,
     "sourceMap": true,
-    "resolveJsonModule": true
+    "resolveJsonModule": true,
+    "paths": {
+      "@kynetic-ai/shared": ["./packages/shared/src"],
+      "@kynetic-ai/daemon": ["./packages/daemon/src"],
+      "@kynetic-ai/web-ui": ["./packages/web-ui/src"]
+    }
   },
   "include": ["src/**/*"],
-  "exclude": ["node_modules", "dist", "**/*.test.ts"]
+  "exclude": ["node_modules", "dist", "**/*.test.ts", "packages"]
 }