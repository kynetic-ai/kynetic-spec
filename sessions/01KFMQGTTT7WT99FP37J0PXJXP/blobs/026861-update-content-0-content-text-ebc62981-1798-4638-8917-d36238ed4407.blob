   240→  // AC: @cli-serve-commands ac-7
   241→  it('should stop then start on restart', async () => {
   242→    if (!bunAvailable) {
   243→      console.log('  ⊘ Skipping test - Bun runtime required');
   244→      return;
   245→    }
   246→
   247→    const port = 3500 + Math.floor(Math.random() * 100);
   248→
   249→    // Start daemon
   250→    kspec(
   251→      `serve start --daemon --port ${port} --kspec-dir ${join(tempDir, '.kspec')}`,
   252→      tempDir
   253→    );
   254→
   255→    const originalPid = parseInt(readFileSync(pidFilePath, 'utf-8').trim(), 10);
   256→
   257→    // Restart
   258→    const result = kspec(`serve restart --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   259→
   260→    expect(result.stdout).toContain('Stopping daemon');
   261→    expect(result.stdout).toContain('Starting daemon');
   262→
   263→    // Should have new PID
   264→    const newPid = parseInt(readFileSync(pidFilePath, 'utf-8').trim(), 10);
   265→    expect(newPid).not.toBe(originalPid);
   266→
   267→    // New process should be running
   268→    let processRunning = false;
   269→    try {
   270→      process.kill(newPid, 0);
   271→      processRunning = true;
   272→    } catch {
   273→      processRunning = false;
   274→    }
   275→    expect(processRunning).toBe(true);
   276→
   277→    // Cleanup
   278→    kspec(`serve stop --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   279→  });
