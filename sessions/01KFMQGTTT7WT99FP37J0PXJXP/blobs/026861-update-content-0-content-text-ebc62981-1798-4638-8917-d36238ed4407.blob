     1→/**
     2→ * E2E tests for kspec serve CLI commands
     3→ * Spec: @cli-serve-commands
     4→ */
     5→
     6→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     7→import { createTempDir, cleanupTempDir, initGitRepo, setupTempFixtures, kspec, kspecJson } from './helpers/cli';
     8→import { spawn, execSync } from 'child_process';
     9→import { join } from 'path';
    10→import { readFileSync, existsSync } from 'fs';
    11→
    12→// Check if Bun runtime is available
    13→let bunAvailable = false;
    14→try {
    15→  execSync('which bun', { stdio: 'pipe' });
    16→  bunAvailable = true;
    17→} catch {
    18→  console.log('⊘ Bun runtime not available - skipping daemon tests requiring actual daemon process');
    19→}
    20→
    21→describe('kspec serve commands', () => {
    22→  let tempDir: string;
    23→  let pidFilePath: string;
    24→
    25→  beforeEach(async () => {
    26→    tempDir = await createTempDir();
    27→    await initGitRepo(tempDir);
    28→    await setupTempFixtures(tempDir);
    29→    pidFilePath = join(tempDir, '.kspec', '.daemon.pid');
    30→  });
    31→
    32→  afterEach(async () => {
    33→    // Kill any daemon that might still be running
    34→    try {
    35→      if (existsSync(pidFilePath)) {
    36→        const pid = parseInt(readFileSync(pidFilePath, 'utf-8').trim(), 10);
    37→        if (!isNaN(pid)) {
    38→          process.kill(pid, 'SIGTERM');
    39→          // Give it a moment to stop
    40→          await new Promise(resolve => setTimeout(resolve, 500));
    41→        }
    42→      }
    43→    } catch {
    44→      // Ignore if process doesn't exist
    45→    }
    46→
    47→    await cleanupTempDir(tempDir);
    48→  });
    49→
    50→  // AC: @cli-serve-commands ac-1
    51→  it('should start in foreground mode with Ctrl+C support', async () => {
    52→    if (!bunAvailable) {
    53→      console.log('  ⊘ Skipping test - Bun runtime required');
    54→      return;
    55→    }
    56→
    57→    // Use a unique port for this test
    58→    const port = 3500 + Math.floor(Math.random() * 100);
    59→
    60→    // Spawn kspec serve in foreground
    61→    const child = spawn('node', [
    62→      join(__dirname, '../dist/cli/index.js'),
    63→      'serve',
    64→      'start',
    65→      '--port',
    66→      String(port),
    67→      '--kspec-dir',
    68→      join(tempDir, '.kspec')
    69→    ], {
    70→      cwd: tempDir,
    71→      stdio: ['pipe', 'pipe', 'pipe'],
    72→    });
    73→
    74→    let output = '';
    75→    child.stdout?.on('data', (data) => {
    76→      output += data.toString();
    77→    });
    78→
    79→    child.stderr?.on('data', (data) => {
    80→      output += data.toString();
    81→    });
    82→
    83→    // Wait for server to start
    84→    await new Promise(resolve => setTimeout(resolve, 2000));
    85→
    86→    // Verify output mentions foreground and port
    87→    expect(output).toContain('Starting server in foreground');
    88→    expect(output).toContain(`port ${port}`);
    89→
    90→    // Send SIGINT (Ctrl+C)
    91→    child.kill('SIGINT');
    92→
    93→    // Wait for shutdown
    94→    await new Promise<void>((resolve) => {
    95→      child.on('exit', () => resolve());
    96→    });
    97→
    98→    expect(child.exitCode).toBe(0);
    99→  });
   100→
   101→  // AC: @cli-serve-commands ac-2
   102→  it('should start in daemon mode and detach', async () => {
   103→    if (!bunAvailable) {
   104→      console.log('  ⊘ Skipping test - Bun runtime required');
   105→      return;
   106→    }
   107→
   108→    const port = 3500 + Math.floor(Math.random() * 100);
   109→
   110→    const result = kspec(
   111→      `serve start --daemon --port ${port} --kspec-dir ${join(tempDir, '.kspec')}`,
   112→      tempDir
   113→    );
   114→
   115→    // Should report success
   116→    expect(result.stdout).toContain('Daemon started');
   117→    expect(result.stdout).toContain(`port ${port}`);
   118→
   119→    // PID file should exist
   120→    expect(existsSync(pidFilePath)).toBe(true);
   121→
   122→    const pid = parseInt(readFileSync(pidFilePath, 'utf-8').trim(), 10);
   123→    expect(pid).toBeGreaterThan(0);
   124→
   125→    // Process should be running
   126→    let processRunning = false;
   127→    try {
   128→      process.kill(pid, 0); // Signal 0 checks existence
   129→      processRunning = true;
   130→    } catch {
   131→      processRunning = false;
   132→    }
   133→    expect(processRunning).toBe(true);
   134→
   135→    // Cleanup
   136→    kspec(`serve stop --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   137→  });
   138→
