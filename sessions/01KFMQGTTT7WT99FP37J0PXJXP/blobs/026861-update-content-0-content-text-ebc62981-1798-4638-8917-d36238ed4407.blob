   158→
   159→  // AC: @cli-serve-commands ac-4
   160→  it('should send SIGTERM and wait for shutdown', async () => {
   161→    if (!bunAvailable) {
   162→      console.log('  ⊘ Skipping test - Bun runtime required');
   163→      return;
   164→    }
   165→
   166→    const port = 3500 + Math.floor(Math.random() * 100);
   167→
   168→    // Start daemon
   169→    kspec(
   170→      `serve start --daemon --port ${port} --kspec-dir ${join(tempDir, '.kspec')}`,
   171→      tempDir
   172→    );
   173→
   174→    const pid = parseInt(readFileSync(pidFilePath, 'utf-8').trim(), 10);
   175→
   176→    // Stop daemon
   177→    const result = kspec(`serve stop --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   178→
   179→    expect(result.stdout).toContain('Stopping daemon');
   180→    expect(result.stdout).toContain(`PID ${pid}`);
   181→    expect(result.stdout).toContain('Daemon stopped');
   182→
   183→    // PID file should be removed (eventually by daemon cleanup, but may still exist during test)
   184→    // Process should not be running
   185→    let processRunning = false;
   186→    try {
   187→      process.kill(pid, 0);
   188→      processRunning = true;
   189→    } catch {
   190→      processRunning = false;
   191→    }
   192→    expect(processRunning).toBe(false);
   193→  });
   194→
   195→  // AC: @cli-serve-commands ac-5
   196→  it('should return success when stopping non-running daemon (idempotent)', async () => {
   197→    const result = kspec(`serve stop --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   198→
