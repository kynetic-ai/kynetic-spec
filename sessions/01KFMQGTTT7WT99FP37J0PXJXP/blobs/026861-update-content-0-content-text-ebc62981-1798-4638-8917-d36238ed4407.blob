   203→  // AC: @cli-serve-commands ac-6
   204→  it('should return JSON status with process info', async () => {
   205→    if (!bunAvailable) {
   206→      console.log('  ⊘ Skipping test - Bun runtime required');
   207→      return;
   208→    }
   209→
   210→    // Start daemon
   211→    const port = 3500 + Math.floor(Math.random() * 100);
   212→    kspec(
   213→      `serve start --daemon --port ${port} --kspec-dir ${join(tempDir, '.kspec')}`,
   214→      tempDir
   215→    );
   216→
   217→    const pid = parseInt(readFileSync(pidFilePath, 'utf-8').trim(), 10);
   218→
   219→    // Check status
   220→    const result = kspec(`serve status --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   221→
   222→    expect(result.stdout).toContain('Daemon running');
   223→    expect(result.stdout).toContain(`PID: ${pid}`);
   224→
   225→    // Should output JSON
   226→    const lines = result.stdout.split('\n');
   227→    const jsonLine = lines.find(line => line.trim().startsWith('{'));
   228→    expect(jsonLine).toBeTruthy();
   229→
   230→    const status = JSON.parse(jsonLine!);
   231→    expect(status).toMatchObject({
   232→      running: true,
   233→      pid: pid,
   234→    });
   235→
   236→    // Cleanup
   237→    kspec(`serve stop --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   238→  });
