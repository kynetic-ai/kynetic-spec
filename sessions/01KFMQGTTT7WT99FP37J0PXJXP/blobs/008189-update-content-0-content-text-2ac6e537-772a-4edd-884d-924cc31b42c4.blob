```
     1→import type { Command } from "commander";
     2→import {
     3→  AlignmentIndex,
     4→  createNote,
     5→  createTask,
     6→  getAuthor,
     7→  initContext,
     8→  type KspecContext,
     9→  type LoadedSpecItem,
    10→  type LoadedTask,
    11→  loadAllItems,
    12→  loadAllTasks,
    13→  ReferenceIndex,
    14→  saveTask,
    15→} from "../../parser/index.js";
    16→import { commitIfShadow } from "../../parser/shadow.js";
    17→import type { TaskInput } from "../../schema/index.js";
    18→import { errors } from "../../strings/index.js";
    19→import { EXIT_CODES } from "../exit-codes.js";
    20→import { error, info, isJsonMode, output } from "../output.js";
    21→
    22→/**
    23→ * Fields that contain nested spec items (mirrors yaml.ts)
    24→ */
    25→const _NESTED_ITEM_FIELDS = [
    26→  "modules",
    27→  "features",
    28→  "requirements",
    29→  "constraints",
    30→  "decisions",
    31→];
    32→
    33→/**
    34→ * Get the parent path from a child's _path.
    35→ * e.g., "features[0].requirements[1]" -> "features[0]"
    36→ * Returns empty string for top-level items.
    37→ */
    38→function getParentPath(childPath: string | undefined): string {
    39→  if (!childPath) return "";
    40→  const lastDotIndex = childPath.lastIndexOf(".");
    41→  if (lastDotIndex === -1) return "";
    42→  return childPath.slice(0, lastDotIndex);
    43→}
    44→
    45→/**
    46→ * Check if an item is a direct child of another item based on _path.
    47→ * Direct children have a path that extends the parent's path by exactly one field[index].
    48→ */
    49→function isDirectChildOf(
    50→  child: LoadedSpecItem,
    51→  parent: LoadedSpecItem,
    52→): boolean {
    53→  const childPath = child._path || "";
    54→  const parentPath = parent._path || "";
    55→
    56→  // If paths are equal, not a child
    57→  if (childPath === parentPath) return false;
    58→
    59→  // Child path must start with parent path
    60→  if (parentPath && !childPath.startsWith(`${parentPath}.`)) return false;
    61→
    62→  // For root parent (empty path), child must be a top-level path like "features[0]"
    63→  if (!parentPath) {
    64→    // Direct child of root has no '.' in its path
    65→    return !childPath.includes(".");
    66→  }
    67→
    68→  // Get the remaining path after parent
    69→  const remaining = childPath.slice(parentPath.length + 1);
    70→
    71→  // Direct child has no additional '.' (e.g., "requirements[0]" not "requirements[0].something")
    72→  return !remaining.includes(".");
    73→}
    74→
    75→/**
    76→ * Find the parent spec item of a given item.
    77→ * Returns undefined for root-level items.
    78→ */
    79→function findParentItem(
    80→  item: LoadedSpecItem,
    81→  allItems: LoadedSpecItem[],
    82→): LoadedSpecItem | undefined {
    83→  const parentPath = getParentPath(item._path);
    84→
    85→  // Root-level item or no path
    86→  if (!parentPath && !item._path) return undefined;
    87→  if (!parentPath) return undefined;
    88→
    89→  // Find item with matching path in the same source file
    90→  return allItems.find(
    91→    (i) => i._path === parentPath && i._sourceFile === item._sourceFile,
    92→  );
    93→}
    94→
    95→/**
    96→ * Get direct children of a spec item.
    97→ * Only returns immediate children, not grandchildren.
    98→ */
    99→function getDirectChildren(
   100→  parent: LoadedSpecItem,
   101→  allItems: LoadedSpecItem[],
   102→): LoadedSpecItem[] {
   103→  return allItems.filter(
   104→    (item) =>
   105→      item._sourceFile === parent._sourceFile && isDirectChildOf(item, parent),
   106→  );
   107→}
   108→
   109→/**
   110→ * Collect an item and all its descendants in topological order (parent first).
   111→ * This ensures parent tasks are created before child tasks.
   112→ */
   113→function collectItemsRecursively(
   114→  root: LoadedSpecItem,
   115→  allItems: LoadedSpecItem[],
   116→): LoadedSpecItem[] {
   117→  const result: LoadedSpecItem[] = [root];
   118→  const children = getDirectChildren(root, allItems);
   119→
   120→  for (const child of children) {
   121→    const descendants = collectItemsRecursively(child, allItems);
   122→    result.push(...descendants);
   123→  }
   124→
   125→  return result;
   126→}
   127→
   128→/**
   129→ * Resolve a spec item reference.
   130→ * Returns the spec item or exits with error.
   131→ */
   132→function resolveSpecRef(
   133→  ref: string,
   134→  items: LoadedSpecItem[],
   135→  tasks: LoadedTask[],
   136→  index: ReferenceIndex,
   137→): LoadedSpecItem {
   138→  const result = index.resolve(ref);
   139→
   140→  if (!result.ok) {
   141→    switch (result.error) {
   142→      case "not_found":
   143→        error(errors.reference.specNotFound(ref));
   144→        break;
   145→      case "ambiguous":
   146→        error(errors.reference.ambiguous(ref));
   147→        for (const candidate of result.candidates) {
   148→          const item = items.find((i) => i._ulid === candidate);
   149→          const slug = item?.slugs[0] || "";
   150→          console.error(
   151→            `  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ""}`,
   152→          );
   153→        }
   154→        break;
   155→      case "duplicate_slug":
   156→        error(errors.reference.slugMapsToMultiple(ref));
   157→        for (const candidate of result.candidates) {
   158→          console.error(`  - ${index.shortUlid(candidate)}`);
   159→        }
   160→        break;
   161→    }
   162→    process.exit(EXIT_CODES.NOT_FOUND);
   163→  }
   164→
   165→  // Check if it's actually a spec item (not a task)
   166→  const item = items.find((i) => i._ulid === result.ulid);
   167→  if (!item) {
   168→    // Check if it's a task
   169→    const task = tasks.find((t) => t._ulid === result.ulid);
   170→    if (task) {
   171→      error(errors.reference.notSpecItem(ref));
   172→    } else {
   173→      error(errors.reference.specNotFound(ref));
   174→    }
   175→    process.exit(EXIT_CODES.NOT_FOUND);
   176→  }
   177→
   178→  return item;
   179→}
   180→
   181→/**
   182→ * Generate a slug from a spec item title.
   183→ * Converts "My Feature Title" -> "task-my-feature-title"
   184→ */
   185→function generateSlugFromTitle(title: string): string {
   186→  return (
   187→    "task-" +
   188→    title
   189→      .toLowerCase()
   190→      .replace(/[^a-z0-9]+/g, "-")
   191→      .replace(/^-|-$/g, "")
   192→      .slice(0, 50)
   193→  );
   194→}
   195→
   196→/**
   197→ * Convert spec priority to task priority (number).
   198→ * Spec can use 'high', 'medium', 'low' or numeric 1-5.
   199→ */
   200→function normalizePriority(priority: string | number | undefined): number {
   201→  if (priority === undefined) return 3;
   202→  if (typeof priority === "number") return priority;
   203→  switch (priority) {
   204→    case "high":
   205→      return 1;
   206→    case "medium":
   207→      return 3;
   208→    case "low":
   209→      return 5;
   210→    default:
   211→      return 3;
   212→  }
   213→}
   214→
   215→/**
   216→ * Result of deriving a task from a spec item
   217→ */
   218→interface DeriveResult {
   219→  specItem: LoadedSpecItem;
   220→  action: "created" | "skipped" | "would_create";
   221→  task?: LoadedTask;
   222→  reason?: string;
   223→  /** Task ref that was used for depends_on (if any) */
   224→  dependsOn?: string[];
   225→}
   226→
   227→/**
   228→ * Generate implementation notes from spec item for newly derived task.
   229→ * Includes description and acceptance criteria summary.
   230→ */
   231→function generateImplementationNotes(
   232→  specItem: LoadedSpecItem,
   233→): string | undefined {
   234→  const parts: string[] = [];
   235→
   236→  // Add description if present
   237→  if (specItem.description) {
   238→    parts.push(specItem.description.trim());
   239→  }
   240→
   241→  // Add acceptance criteria summary if present
   242→  if (specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
   243→    const acSection = ["", "Acceptance Criteria:"];
   244→    for (const ac of specItem.acceptance_criteria) {
   245→      const summary = `${ac.given ? `Given ${ac.given}, ` : ""}when ${ac.when}, then ${ac.then}`;
   246→      acSection.push(`- ${ac.id}: ${summary}`);
   247→    }
   248→    parts.push(acSection.join("\n"));
   249→  }
   250→
   251→  // Return combined content, or undefined if nothing to add
   252→  return parts.length > 0 ? parts.join("\n\n") : undefined;
   253→}
   254→
   255→/**
   256→ * Derive a task from a spec item.
   257→ * Returns result describing what happened.
   258→ *
   259→ * @param dependsOn - Task references to add as dependencies (for hierarchy-based deps)
   260→ * @param priority - Priority override (1-5), if not provided uses spec's priority
   261→ */
   262→async function deriveTaskFromSpec(
   263→  ctx: KspecContext,
   264→  specItem: LoadedSpecItem,
   265→  existingTasks: LoadedTask[],
   266→  _items: LoadedSpecItem[],
   267→  index: ReferenceIndex,
   268→  alignmentIndex: AlignmentIndex,
   269→  options: {
   270→    force: boolean;
   271→    dryRun: boolean;
   272→    dependsOn?: string[];
   273→    priority?: number;
   274→  },
   275→): Promise<DeriveResult> {
   276→  // Check if a task already exists for this spec
   277→  const linkedTasks = alignmentIndex.getTasksForSpec(specItem._ulid);
   278→
   279→  if (linkedTasks.length > 0 && !options.force) {
   280→    const taskRef = linkedTasks[0].slugs[0]
   281→      ? `@${linkedTasks[0].slugs[0]}`
   282→      : `@${index.shortUlid(linkedTasks[0]._ulid)}`;
   283→    return {
   284→      specItem,
   285→      action: "skipped",
   286→      task: linkedTasks[0],
   287→      reason: `task exists: ${taskRef}`,
   288→    };
   289→  }
   290→
   291→  // Check if slug would collide with existing task
   292→  const baseSlug = generateSlugFromTitle(specItem.title);
   293→  let slug = baseSlug;
   294→  let slugSuffix = 1;
   295→
   296→  // Find unique slug if needed
   297→  while (existingTasks.some((t) => t.slugs.includes(slug))) {
   298→    slug = `${baseSlug}-${slugSuffix}`;
   299→    slugSuffix++;
   300→  }
   301→
   302→  // Generate implementation notes from spec
   303→  // AC: @cmd-derive ac-author
   304→  const noteContent = generateImplementationNotes(specItem);
   305→  const initialNotes = noteContent
   306→    ? [
   307→        createNote(
   308→          `Implementation notes (auto-generated from spec):\n\n${noteContent}`,
   309→          getAuthor(),
   310→        ),
   311→      ]
   312→    : [];
   313→
   314→  // Build task input with depends_on and initial notes
   315→  const taskInput: TaskInput = {
   316→    title: `Implement: ${specItem.title}`,
   317→    type: "task",
   318→    spec_ref: `@${specItem.slugs[0] || specItem._ulid}`,
   319→    derivation: "auto",
   320→    priority: options.priority ?? normalizePriority(specItem.priority),
   321→    slugs: [slug],
   322→    tags: [...(specItem.tags || [])],
   323→    depends_on: options.dependsOn || [],
   324→    notes: initialNotes,
   325→  };
   326→
   327→  // Dry run - don't actually create
   328→  if (options.dryRun) {
   329→    const previewTask = createTask(taskInput) as LoadedTask;
   330→    return {
   331→      specItem,
   332→      action: "would_create",
   333→      task: previewTask,
   334→      dependsOn: options.dependsOn,
   335→    };
   336→  }
   337→
   338→  // Create and save the task
   339→  const newTask = createTask(taskInput);
   340→  await saveTask(ctx, newTask);
   341→  const specSlug = specItem.slugs[0] || specItem._ulid.slice(0, 8);
   342→  await commitIfShadow(ctx.shadow, "derive", specSlug);
   343→
   344→  // Add to existing tasks list for slug collision checks
   345→  existingTasks.push(newTask as LoadedTask);
   346→
   347→  return {
   348→    specItem,
   349→    action: "created",
   350→    task: newTask as LoadedTask,
   351→    dependsOn: options.dependsOn,
   352→  };
   353→}
   354→
   355→/**
   356→ * Get a task reference string for use in depends_on.
   357→ * Prefers slug over ULID for readability.
   358→ */
   359→function getTaskRef(task: LoadedTask, index: ReferenceIndex): string {
   360→  return task.slugs[0]
   361→    ? `@${task.slugs[0]}`
   362→    : `@${index.shortUlid(task._ulid)}`;
   363→}
   364→
   365→/**
   366→ * Find or get the task for a parent spec item.
   367→ * Looks in:
   368→ * 1. Tasks created in this derive session (specToTaskMap)
   369→ * 2. Existing tasks linked to the parent spec (alignmentIndex)
   370→ *
   371→ * Only returns tasks that are NOT in 'cancelled' state (AC-15).
   372→ */
   373→function getParentTaskRef(
   374→  parentSpec: LoadedSpecItem,
   375→  specToTaskMap: Map<string, LoadedTask>,
   376→  alignmentIndex: AlignmentIndex,
   377→  index: ReferenceIndex,
   378→): string | undefined {
   379→  // Check if we created a task for this parent in this session
   380→  const sessionTask = specToTaskMap.get(parentSpec._ulid);
   381→  if (sessionTask && sessionTask.status !== "cancelled") {
   382→    return getTaskRef(sessionTask, index);
   383→  }
   384→
   385→  // Check if an existing task is linked to this parent spec
   386→  // AC: @cmd-derive ac-15 - skip cancelled tasks
   387→  const linkedTasks = alignmentIndex.getTasksForSpec(parentSpec._ulid);
   388→  const activeTask = linkedTasks.find((task) => task.status !== "cancelled");
   389→  if (activeTask) {
   390→    return getTaskRef(activeTask, index);
   391→  }
   392→
   393→  return undefined;
   394→}
   395→
   396→/**
   397→ * Register the 'derive' command
   398→ */
   399→export function registerDeriveCommand(program: Command): void {
   400→  program
   401→    .command("derive [ref]")
   402→    .description("Create task(s) from spec item(s)")
   403→    .option("--all", "Derive tasks for all spec items without linked tasks")
   404→    .option(
   405→      "--flat",
   406→      "Only derive for the specified item, not children (default: recursive)",
   407→    )
   408→    .option("--force", "Create task even if one already exists for the spec")
   409→    .option("--dry-run", "Show what would be created without making changes")
   410→    .option(
   411→      "--priority <n>",
   412→      "Set priority for created task(s) (1-5)",
   413→      parseInt,
   414→    )
   415→    .action(async (ref: string | undefined, options) => {
   416→      try {
   417→        // Validate arguments
   418→        if (!ref && !options.all) {
   419→          error(errors.usage.deriveNoRef);
   420→          console.error("Usage:");
   421→          console.error("  kspec derive @spec-ref");
   422→          console.error("  kspec derive @spec-ref --flat");
   423→          console.error("  kspec derive --all");
   424→          process.exit(EXIT_CODES.USAGE_ERROR);
   425→        }
   426→
   427→        if (ref && options.all) {
   428→          error(errors.usage.deriveRefAndAll);
   429→          process.exit(EXIT_CODES.USAGE_ERROR);
   430→        }
   431→
   432→        // Validate priority if provided
   433→        if (options.priority !== undefined) {
   434→          if (
   435→            Number.isNaN(options.priority) ||
   436→            options.priority < 1 ||
   437→            options.priority > 5
   438→          ) {
   439→            error("Priority must be a number between 1 and 5");
   440→            process.exit(EXIT_CODES.USAGE_ERROR);
   441→          }
   442→        }
   443→
   444→        const ctx = await initContext();
   445→        const tasks = await loadAllTasks(ctx);
   446→        const items = await loadAllItems(ctx);
   447→        const index = new ReferenceIndex(tasks, items);
   448→
   449→        // Build alignment index
   450→        const alignmentIndex = new AlignmentIndex(tasks, items);
   451→        alignmentIndex.buildLinks(index);
   452→
   453→        // Collect spec items to process
   454→        let specsToDerive: LoadedSpecItem[];
   455→
   456→        if (options.all) {
   457→          // Get all spec items without linked tasks
   458→          specsToDerive = items.filter((item) => {
   459→            const linkedTasks = alignmentIndex.getTasksForSpec(item._ulid);
   460→            return linkedTasks.length === 0 || options.force;
   461→          });
   462→
   463→          if (specsToDerive.length === 0) {
   464→            if (isJsonMode()) {
   465→              console.log(JSON.stringify([]));
   466→            } else {
   467→              info("Nothing to derive (all items have tasks)");
   468→            }
   469→            return;
   470→          }
   471→        } else {
   472→          // Single spec item - recursive by default, flat if --flat
   473→          const specItem = resolveSpecRef(ref!, items, tasks, index);
   474→
   475→          if (options.flat) {
   476→            specsToDerive = [specItem];
   477→          } else {
   478→            // Recursive: collect item and all descendants
   479→            specsToDerive = collectItemsRecursively(specItem, items);
   480→          }
   481→        }
   482→
   483→        // Track spec ULID -> created task for dependency resolution
   484→        const specToTaskMap = new Map<string, LoadedTask>();
   485→
   486→        // Process each spec item in order (parents before children due to topological sort)
   487→        const results: DeriveResult[] = [];
   488→
   489→        for (const specItem of specsToDerive) {
   490→          // Determine depends_on based on parent spec's task
   491→          let dependsOn: string[] | undefined;
   492→
   493→          if (!options.flat && !options.all) {
   494→            // Find the parent spec item
   495→            const parentSpec = findParentItem(specItem, items);
   496→
   497→            if (parentSpec) {
   498→              const parentTaskRef = getParentTaskRef(
   499→                parentSpec,
   500→                specToTaskMap,
   501→                alignmentIndex,
   502→                index,
   503→              );
   504→              if (parentTaskRef) {
   505→                dependsOn = [parentTaskRef];
   506→              }
   507→            }
   508→          }
   509→
   510→          const result = await deriveTaskFromSpec(
   511→            ctx,
   512→            specItem,
   513→            tasks,
   514→            items,
   515→            index,
   516→            alignmentIndex,
   517→            {
   518→              force: options.force || false,
   519→              dryRun: options.dryRun || false,
   520→              dependsOn,
   521→              priority: options.priority,
   522→            },
   523→          );
   524→
   525→          // Track created/would_create tasks for dependency resolution
   526→          if (
   527→            result.task &&
   528→            (result.action === "created" || result.action === "would_create")
   529→          ) {
   530→            specToTaskMap.set(specItem._ulid, result.task);
   531→          }
   532→          // Also track skipped tasks (existing) for dependency resolution
   533→          if (result.action === "skipped" && result.task) {
   534→            specToTaskMap.set(specItem._ulid, result.task);
   535→          }
   536→
   537→          results.push(result);
   538→        }
   539→
   540→        // Output results
   541→        if (isJsonMode()) {
   542→          // JSON output format - simplified per AC
   543→          const jsonOutput = results.map((r) => ({
   544→            ulid: r.task?._ulid || null,
   545→            slug: r.task?.slugs[0] || null,
   546→            spec_ref: `@${r.specItem.slugs[0] || r.specItem._ulid}`,
   547→            depends_on: r.task?.depends_on || [],
   548→            action: r.action,
   549→          }));
   550→          console.log(JSON.stringify(jsonOutput, null, 2));
   551→          return; // Don't call output() which would output full results in global JSON mode
   552→        } else {
   553→          // Human-readable output
   554→          output(results, () => {
   555→            const created = results.filter((r) => r.action === "created");
   556→            const skipped = results.filter((r) => r.action === "skipped");
   557→            const wouldCreate = results.filter(
   558→              (r) => r.action === "would_create",
   559→            );
   560→
   561→            if (options.dryRun) {
   562→              console.log("Would create:");
   563→              for (const r of wouldCreate) {
   564→                const taskSlug = r.task?.slugs[0] || "";
   565→                const deps = r.dependsOn?.length
   566→                  ? ` (depends: ${r.dependsOn.join(", ")})`
   567→                  : "";
   568→                console.log(`  + ${r.specItem.title}`);
   569→                console.log(`    -> ${taskSlug}${deps}`);
   570→              }
   571→              if (skipped.length > 0) {
   572→                console.log("\nSkipped:");
   573→                for (const r of skipped) {
   574→                  const specRef = r.specItem.slugs[0]
   575→                    ? `@${r.specItem.slugs[0]}`
   576→                    : `@${index.shortUlid(r.specItem._ulid)}`;
   577→                  console.log(`  - ${specRef} (${r.reason})`);
   578→                }
   579→              }
   580→              console.log(`\nWould create ${wouldCreate.length} task(s)`);
   581→              if (skipped.length > 0) {
   582→                console.log(`Skipped ${skipped.length} (already have tasks)`);
   583→              }
   584→              return;
   585→            }
   586→
   587→            if (created.length > 0) {
   588→              for (const r of created) {
   589→                const taskSlug = r.task?.slugs[0] || "";
   590→                const deps = r.dependsOn?.length
   591→                  ? ` (depends: ${r.dependsOn.join(", ")})`
   592→                  : "";
   593→                console.log(`OK Created task: ${taskSlug}${deps}`);
   594→              }
   595→            }
   596→
   597→            if (skipped.length > 0 && !options.all) {
   598→              // Show skipped for explicit derive (not --all)
   599→              for (const r of skipped) {
   600→                const specRef = r.specItem.slugs[0]
   601→                  ? `@${r.specItem.slugs[0]}`
   602→                  : `@${index.shortUlid(r.specItem._ulid)}`;
   603→                console.log(`Skipped ${specRef} (${r.reason})`);
   604→              }
   605→            }
   606→
   607→            // Summary
   608→            if (created.length > 0 || skipped.length > 0) {
   609→              console.log("");
   610→              if (created.length > 0) {
   611→                console.log(`Created ${created.length} task(s)`);
   612→              }
   613→              if (skipped.length > 0) {
   614→                console.log(`Skipped ${skipped.length} (already have tasks)`);
   615→              }
   616→            }
   617→          });
   618→        }
   619→      } catch (err) {
   620→        error(errors.failures.deriveTasks, err);
   621→        process.exit(EXIT_CODES.ERROR);
   622→      }
   623→    });
   624→}
   625→

