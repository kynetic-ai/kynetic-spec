   156→      - "@trait-websocket-protocol"
   157→    notes: []
   158→    created: 2026-01-22T07:00:00.000Z
   159→    acceptance_criteria:
   160→      - id: ac-1
   161→        given: daemon running on localhost:3456
   162→        when: request from localhost:5173 (dev server) received
   163→        then: CORS headers allow the request
   164→      - id: ac-2
   165→        given: daemon is running
   166→        when: GET /api/tasks is called
   167→        then: returns JSON array of all tasks with status, priority, spec_ref, notes count
   168→      - id: ac-3
   169→        given: daemon is running
   170→        when: GET /api/tasks with status filter (e.g., ?status=pending&status=in_progress)
   171→        then: returns only tasks matching filter (supports multi-value)
   172→      - id: ac-4
   173→        given: daemon is running
   174→        when: GET /api/tasks with pagination (?limit=10&offset=20)
   175→        then: returns paginated results with {items, total, offset, limit} wrapper
   176→      - id: ac-5
   177→        given: daemon is running
   178→        when: GET /api/tasks/:ref is called
   179→        then: resolves ref via ReferenceIndex, returns full task with notes, todos, dependencies
   180→      - id: ac-6
   181→        given: daemon is running
   182→        when: POST /api/tasks/:ref/start is called
   183→        then: task transitions to in_progress, WebSocket broadcasts update, returns updated task
   184→      - id: ac-7
   185→        given: daemon is running
   186→        when: POST /api/tasks/:ref/note with {content} body
   187→        then: note appended to task, shadow commit occurs, WebSocket broadcasts update
   188→      - id: ac-8
   189→        given: daemon is running
   190→        when: GET /api/items is called
   191→        then: returns JSON array of all spec items (modules, features, requirements)
   192→      - id: ac-9
   193→        given: daemon is running
   194→        when: GET /api/items with type filter (?type=feature&type=requirement)
   195→        then: returns only items matching type filter
   196→      - id: ac-10
   197→        given: daemon is running
   198→        when: GET /api/items/:ref is called
   199→        then: resolves ref, returns full item with acceptance_criteria, traits, relationships
   200→      - id: ac-11
   201→        given: daemon is running
   202→        when: GET /api/items/:ref/tasks is called
   203→        then: returns tasks linked to this spec via AlignmentIndex
   204→      - id: ac-12
   205→        given: daemon is running
   206→        when: GET /api/inbox is called
   207→        then: returns all inbox items ordered by created_at desc
   208→      - id: ac-13
   209→        given: daemon is running
   210→        when: POST /api/inbox with {text} body
   211→        then: creates inbox item, returns with generated ULID
   212→      - id: ac-14
   213→        given: daemon is running
   214→        when: DELETE /api/inbox/:ref is called
   215→        then: removes inbox item, returns success confirmation
   216→      - id: ac-15
   217→        given: daemon is running
   218→        when: GET /api/meta/session is called
   219→        then: returns current session context (focus, threads, questions)
   220→      - id: ac-16
   221→        given: daemon is running
   222→        when: GET /api/meta/agents is called
   223→        then: returns all defined agents
   224→      - id: ac-17
   225→        given: daemon is running
   226→        when: GET /api/meta/workflows is called
   227→        then: returns all defined workflows
   228→      - id: ac-18
   229→        given: daemon is running
   230→        when: GET /api/meta/observations with filter (?resolved=false)
   231→        then: returns observations matching filter
   232→      - id: ac-19
   233→        given: daemon is running
   234→        when: GET /api/search?q=login is called
   235→        then: searches across all items using grep/title matching
   236→      - id: ac-20
   237→        given: daemon is running
   238→        when: GET /api/validate is called
   239→        then: runs full validation, returns ValidationResult
   240→      - id: ac-21
   241→        given: daemon is running
   242→        when: GET /api/alignment is called
   243→        then: returns AlignmentIndex stats and warnings
   244→      - id: ac-22
   245→        given: API request has invalid ref
   246→        when: any endpoint with :ref parameter
   247→        then: returns {error, message, suggestion} with 404 status, suggests similar refs if available
   248→      - id: ac-23
   249→        given: API request has validation error
   250→        when: POST/PUT with invalid body
   251→        then: returns {error, details:[{field, message}]} with 400 status
   252→      - id: ac-24
   253→        given: API request causes state transition error
   254→        when: POST action violates state machine
   255→        then: returns {error, current, valid_transitions} with 409 status
   256→      - id: ac-25
   257→        given: client connects to /ws
   258→        when: WebSocket connection established
   259→        then: receives connected event with {session_id}
   260→      - id: ac-26
   261→        given: WebSocket connection active
   262→        when: client sends command
   263→        then: command format is {action, request_id?, payload}
   264→      - id: ac-27
   265→        given: command received
   266→        when: processed
   267→        then: "server sends {ack: true, request_id, success, error?}"
   268→      - id: ac-28
   269→        given: WebSocket connection
   270→        when: "client sends {action: 'subscribe', topics: ['files:updates']}"
   271→        then: server tracks subscription and sends events for that topic
   272→      - id: ac-29
   273→        given: file changes in .kspec/
   274→        when: WebSocket client subscribed to files:updates
   275→        then: "receives event with format {msg_id, seq, timestamp, topic, event, data: {ref, action}}"
   276→      - id: ac-30
   277→        given: malformed command received
   278→        when: parsed
   279→        then: "return {ack: false, error: 'validation_error', details: ...}"
   280→      - id: ac-31
   281→        given: connection closing
   282→        when: close initiated
   283→        then: use code 1000 for clean, 1001 for timeout, 1011 for error
   284→      - id: ac-32
   285→        given: server sends to slow client
   286→        when: backpressure limit reached
   287→        then: pause non-critical broadcasts until drain event
   288→      - id: ac-33
   289→        given: daemon is shutting down
   290→        when: WebSocket connection active
   291→        then: receives shutdown event with {reason}, connection closes gracefully
