```
     1→<!--
     2→  AC: @ui-task-board ac-3 — Task detail modal with full task info.
     3→  AC: @ui-task-board ac-6 — Action buttons: Start, Submit, Complete, Block, Add Note.
     4→-->
     5→<script lang="ts">
     6→	import type { TaskDetail } from '@kynetic-ai/shared';
     7→	import { base } from '$app/paths';
     8→	import {
     9→		fetchTask,
    10→		startTask,
    11→		submitTask,
    12→		completeTask,
    13→		blockTask,
    14→		addTaskNote
    15→	} from '$lib/api';
    16→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    17→	import * as Dialog from '$lib/components/ui/dialog';
    18→	import { Badge } from '$lib/components/ui/badge';
    19→	import { Button } from '$lib/components/ui/button';
    20→	import { Textarea } from '$lib/components/ui/textarea';
    21→	import { Input } from '$lib/components/ui/input';
    22→	import { Separator } from '$lib/components/ui/separator';
    23→	import { getStatusClasses, formatAge, formatVcsRef } from './board-utils';
    24→	import GitBranch from '@lucide/svelte/icons/git-branch';
    25→	import ExternalLink from '@lucide/svelte/icons/external-link';
    26→
    27→	let {
    28→		open = $bindable(false),
    29→		taskRef = $bindable<string | null>(null),
    30→		onTaskUpdated
    31→	}: {
    32→		open?: boolean;
    33→		taskRef?: string | null;
    34→		onTaskUpdated?: () => void;
    35→	} = $props();
    36→
    37→	let task = $state<TaskDetail | null>(null);
    38→	let loading = $state(false);
    39→	let error = $state('');
    40→	let actionError = $state('');
    41→	let isSubmitting = $state(false);
    42→
    43→	// Note form
    44→	let noteContent = $state('');
    45→
    46→	// Block/Complete reason form
    47→	let reasonInput = $state('');
    48→	let showReasonFor = $state<'block' | 'complete' | null>(null);
    49→
    50→	$effect(() => {
    51→		if (open && taskRef) {
    52→			loadTask(taskRef);
    53→		} else if (!open) {
    54→			task = null;
    55→			error = '';
    56→			actionError = '';
    57→			noteContent = '';
    58→			reasonInput = '';
    59→			showReasonFor = null;
    60→		}
    61→	});
    62→
    63→	async function loadTask(ref: string) {
    64→		loading = true;
    65→		error = '';
    66→		try {
    67→			task = await fetchTask(ref);
    68→		} catch (err) {
    69→			error = err instanceof Error ? err.message : 'Failed to load task';
    70→		} finally {
    71→			loading = false;
    72→		}
    73→	}
    74→
    75→	async function reloadAndNotify() {
    76→		if (task) {
    77→			task = await fetchTask(task._ulid);
    78→		}
    79→		onTaskUpdated?.();
    80→	}
    81→
    82→	async function handleAction(action: () => Promise<void>) {
    83→		isSubmitting = true;
    84→		actionError = '';
    85→		try {
    86→			await action();
    87→			await reloadAndNotify();
    88→		} catch (err) {
    89→			if (err instanceof ReadOnlyModeError) {
    90→				actionError = err.message;
    91→			} else {
    92→				actionError = err instanceof Error ? err.message : 'Action failed';
    93→			}
    94→		} finally {
    95→			isSubmitting = false;
    96→		}
    97→	}
    98→
    99→	function handleStart() {
   100→		if (!task) return;
   101→		handleAction(() => startTask(task!._ulid));
   102→	}
   103→
   104→	function handleSubmit() {
   105→		if (!task) return;
   106→		handleAction(() => submitTask(task!._ulid));
   107→	}
   108→
   109→	function handleComplete() {
   110→		if (!task || !reasonInput.trim()) return;
   111→		const reason = reasonInput.trim();
   112→		handleAction(async () => {
   113→			await completeTask(task!._ulid, reason);
   114→			reasonInput = '';
   115→			showReasonFor = null;
   116→		});
   117→	}
   118→
   119→	function handleBlock() {
   120→		if (!task || !reasonInput.trim()) return;
   121→		const reason = reasonInput.trim();
   122→		handleAction(async () => {
   123→			await blockTask(task!._ulid, reason);
   124→			reasonInput = '';
   125→			showReasonFor = null;
   126→		});
   127→	}
   128→
   129→	function handleAddNote() {
   130→		if (!task || !noteContent.trim()) return;
   131→		const content = noteContent.trim();
   132→		handleAction(async () => {
   133→			await addTaskNote(task!._ulid, content);
   134→			noteContent = '';
   135→		});
   136→	}
   137→
   138→	function formatDate(dateStr: string): string {
   139→		return new Intl.DateTimeFormat('en-US', {
   140→			month: 'short',
   141→			day: 'numeric',
   142→			hour: '2-digit',
   143→			minute: '2-digit'
   144→		}).format(new Date(dateStr));
   145→	}
   146→
   147→	let statusInfo = $derived(task ? getStatusClasses(task.status) : null);
   148→	let slug = $derived(task?.slugs?.[0] ?? task?._ulid?.slice(0, 8) ?? '');
   149→</script>
   150→
   151→<Dialog.Root bind:open>
   152→	<Dialog.Content class="max-w-2xl max-h-[85vh] overflow-y-auto" data-testid="task-detail-modal">
   153→		{#if loading}
   154→			<div class="flex items-center justify-center py-12">
   155→				<p class="text-muted-foreground">Loading task...</p>
   156→			</div>
   157→		{:else if error}
   158→			<div class="bg-destructive/10 text-destructive p-4 rounded-lg" role="alert">
   159→				{error}
   160→			</div>
   161→		{:else if task && statusInfo}
   162→			<Dialog.Header>
   163→				<Dialog.Title data-testid="modal-task-title">{task.title}</Dialog.Title>
   164→				<Dialog.Description>
   165→					<span class="font-mono text-xs">@{slug}</span>
   166→				</Dialog.Description>
   167→			</Dialog.Header>
   168→
   169→			<div class="flex flex-col gap-4">
   170→				<!-- AC: @ui-task-board ac-3 — Description -->
   171→				{#if task.description}
   172→					<p class="text-sm text-muted-foreground" data-testid="modal-description">
   173→						{task.description}
   174→					</p>
   175→				{/if}
   176→
   177→				<!-- Status, priority, type -->
   178→				<div class="flex flex-wrap gap-2 items-center">
   179→					<Badge class="{statusInfo.bg} {statusInfo.fg}" data-testid="modal-status-badge">
   180→						{statusInfo.label}
   181→					</Badge>
   182→					<Badge variant="outline" data-testid="modal-priority">Priority {task.priority}</Badge>
   183→					{#if task.type !== 'task'}
   184→						<Badge variant="outline">{task.type}</Badge>
   185→					{/if}
   186→					{#if task.automation}
   187→						<Badge variant="secondary" data-testid="modal-automation">
   188→							{task.automation}
   189→						</Badge>
   190→					{/if}
   191→				</div>
   192→
   193→				<!-- Spec ref -->
   194→				{#if task.spec_ref}
   195→					<div data-testid="modal-spec-ref">
   196→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Spec</p>
   197→						<a
   198→							href="{base}/specs?ref={encodeURIComponent(task.spec_ref)}"
   199→							class="text-sm text-primary hover:underline font-mono"
   200→						>
   201→							{task.spec_ref}
   202→						</a>
   203→					</div>
   204→				{/if}
   205→
   206→				<!-- Tags -->
   207→				{#if task.tags?.length > 0}
   208→					<div>
   209→						<p class="text-xs font-medium text-muted-foreground mb-1">Tags</p>
   210→						<div class="flex flex-wrap gap-1">
   211→							{#each task.tags as tag}
   212→								<Badge variant="secondary">{tag}</Badge>
   213→							{/each}
   214→						</div>
   215→					</div>
   216→				{/if}
   217→
   218→				<!-- Dependencies -->
   219→				{#if task.depends_on?.length > 0}
   220→					<div data-testid="modal-dependencies">
   221→						<p class="text-xs font-medium text-muted-foreground mb-1">Dependencies</p>
   222→						<ul class="text-sm space-y-0.5">
   223→							{#each task.depends_on as dep}
   224→								<li>
   225→									<a
   226→										href="{base}/tasks/board?ref={encodeURIComponent(dep)}"
   227→										class="text-primary hover:underline font-mono text-xs"
   228→									>
   229→										{dep}
   230→									</a>
   231→								</li>
   232→							{/each}
   233→						</ul>
   234→					</div>
   235→				{/if}
   236→
   237→				<!-- Blocked by -->
   238→				{#if task.blocked_by?.length > 0}
   239→					<div data-testid="modal-blocked-by">
   240→						<p class="text-xs font-medium text-destructive mb-1">Blocked By</p>
   241→						<ul class="text-sm space-y-0.5">
   242→							{#each task.blocked_by as blocker}
   243→								<li class="text-muted-foreground font-mono text-xs">{blocker}</li>
   244→							{/each}
   245→						</ul>
   246→					</div>
   247→				{/if}
   248→
   249→				<!-- AC: @ui-task-board ac-3 — VCS info (branch, PR link) -->
   250→				{#if task.vcs_refs?.length > 0}
   251→					<div data-testid="modal-vcs">
   252→						<p class="text-xs font-medium text-muted-foreground mb-1">VCS</p>
   253→						<ul class="text-sm space-y-1">
   254→							{#each task.vcs_refs as ref}
   255→								{@const vcsInfo = formatVcsRef(ref)}
   256→								<li class="flex items-center gap-1.5">
   257→									<GitBranch class="size-3 text-muted-foreground flex-shrink-0" />
   258→									{#if vcsInfo.url}
   259→										<a
   260→											href={vcsInfo.url}
   261→											target="_blank"
   262→											rel="noopener noreferrer"
   263→											class="text-xs text-primary hover:underline font-mono inline-flex items-center gap-1"
   264→										>
   265→											{vcsInfo.label}
   266→											<ExternalLink class="size-3" />
   267→										</a>
   268→									{:else}
   269→										<span class="text-muted-foreground font-mono text-xs">{vcsInfo.label}</span>
   270→									{/if}
   271→								</li>
   272→							{/each}
   273→						</ul>
   274→					</div>
   275→				{/if}
   276→
   277→				<!-- AC: @ui-task-board ac-3 — Plan ref -->
   278→				{#if task.plan_ref}
   279→					<div data-testid="modal-plan-ref">
   280→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Plan</p>
   281→						<span class="text-sm text-primary font-mono">{task.plan_ref}</span>
   282→					</div>
   283→				{:else if task.derivation}
   284→					<div data-testid="modal-plan-ref">
   285→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Derivation</p>
   286→						<p class="text-sm text-muted-foreground">{task.derivation}</p>
   287→					</div>
   288→				{/if}
   289→
   290→				<!-- AC: @ui-task-board ac-3 — Session link -->
   291→				{#if task.session_ref}
   292→					<div data-testid="modal-session-link">
   293→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Session</p>
   294→						<a
   295→							href="{base}/session?ref={encodeURIComponent(task.session_ref)}"
   296→							class="text-sm text-primary hover:underline font-mono"
   297→						>
   298→							{task.session_ref}
   299→						</a>
   300→					</div>
   301→				{/if}
   302→
   303→				<Separator />
   304→
   305→				<!-- AC: @ui-task-board ac-6 — Actions -->
   306→				{#if !isStaticMode()}
   307→					<div class="flex flex-wrap gap-2" data-testid="modal-actions">
   308→						{#if task.status === 'pending'}
   309→							<Button
   310→								size="sm"
   311→								onclick={handleStart}
   312→								disabled={isSubmitting}
   313→								data-testid="action-start"
   314→							>
   315→								{isSubmitting ? 'Starting...' : 'Start'}
   316→							</Button>
   317→						{/if}
   318→
   319→						{#if task.status === 'in_progress' || task.status === 'needs_work'}
   320→							<Button
   321→								size="sm"
   322→								onclick={handleSubmit}
   323→								disabled={isSubmitting}
   324→								data-testid="action-submit"
   325→							>
   326→								{isSubmitting ? 'Submitting...' : 'Submit for Review'}
   327→							</Button>
   328→						{/if}
   329→
   330→						{#if task.status === 'in_progress' || task.status === 'pending_review'}
   331→							<Button
   332→								size="sm"
   333→								variant="outline"
   334→								onclick={() => {
   335→									showReasonFor = 'complete';
   336→									reasonInput = '';
   337→								}}
   338→								disabled={isSubmitting}
   339→								data-testid="action-complete-toggle"
   340→							>
   341→								Complete
   342→							</Button>
   343→						{/if}
   344→
   345→						{#if task.status !== 'blocked' && task.status !== 'completed' && task.status !== 'cancelled'}
   346→							<Button
   347→								size="sm"
   348→								variant="destructive"
   349→								onclick={() => {
   350→									showReasonFor = 'block';
   351→									reasonInput = '';
   352→								}}
   353→								disabled={isSubmitting}
   354→								data-testid="action-block-toggle"
   355→							>
   356→								Block
   357→							</Button>
   358→						{/if}
   359→					</div>
   360→
   361→					<!-- Reason input for block/complete -->
   362→					{#if showReasonFor}
   363→						<div class="flex gap-2" data-testid="reason-input">
   364→							<Input
   365→								bind:value={reasonInput}
   366→								placeholder="{showReasonFor === 'block' ? 'Block' : 'Completion'} reason..."
   367→								class="flex-1"
   368→							/>
   369→							<Button
   370→								size="sm"
   371→								onclick={showReasonFor === 'block' ? handleBlock : handleComplete}
   372→								disabled={isSubmitting || !reasonInput.trim()}
   373→							>
   374→								Confirm
   375→							</Button>
   376→							<Button
   377→								size="sm"
   378→								variant="ghost"
   379→								onclick={() => {
   380→									showReasonFor = null;
   381→									reasonInput = '';
   382→								}}
   383→							>
   384→								Cancel
   385→							</Button>
   386→						</div>
   387→					{/if}
   388→				{/if}
   389→
   390→				{#if actionError}
   391→					<p class="text-sm text-destructive" data-testid="action-error">{actionError}</p>
   392→				{/if}
   393→
   394→				<Separator />
   395→
   396→				<!-- Todos -->
   397→				{#if task.todos && task.todos.length > 0}
   398→					<div data-testid="modal-todos">
   399→						<p class="text-xs font-medium text-muted-foreground mb-1">
   400→							Todos ({task.todos.length})
   401→						</p>
   402→						<ul class="space-y-1">
   403→							{#each task.todos as todo}
   404→								<li class="flex items-start gap-2 text-sm">
   405→									<span class="mt-0.5 text-xs">
   406→										{#if todo.status === 'completed'}
   407→											&#x2705;
   408→										{:else if todo.status === 'in_progress'}
   409→											&#x23F3;
   410→										{:else}
   411→											&#x23F8;&#xFE0F;
   412→										{/if}
   413→									</span>
   414→									<span class:line-through={todo.status === 'completed'}>
   415→										{todo.content}
   416→									</span>
   417→								</li>
   418→							{/each}
   419→						</ul>
   420→					</div>
   421→					<Separator />
   422→				{/if}
   423→
   424→				<!-- Notes -->
   425→				<div data-testid="modal-notes">
   426→					<p class="text-xs font-medium text-muted-foreground mb-2">
   427→						Notes ({task.notes?.length ?? 0})
   428→					</p>
   429→
   430→					<!-- Add Note form -->
   431→					{#if !isStaticMode()}
   432→						<div class="mb-3 space-y-2" data-testid="modal-add-note">
   433→							<Textarea
   434→								placeholder="Add a note..."
   435→								bind:value={noteContent}
   436→								disabled={isSubmitting}
   437→								rows={2}
   438→							/>
   439→							<Button
   440→								size="sm"
   441→								onclick={handleAddNote}
   442→								disabled={isSubmitting || !noteContent.trim()}
   443→								data-testid="action-add-note"
   444→							>
   445→								{isSubmitting ? 'Adding...' : 'Add Note'}
   446→							</Button>
   447→						</div>
   448→					{/if}
   449→
   450→					<!-- Notes list -->
   451→					<div class="space-y-3">
   452→						{#each task.notes ?? [] as note}
   453→							<div class="border rounded-md p-2.5" data-testid="note-item">
   454→								<div class="flex justify-between items-start mb-1">
   455→									<span class="text-[10px] text-muted-foreground">{note.author}</span>
   456→									<span class="text-[10px] text-muted-foreground">{formatDate(note.created_at)}</span>
   457→								</div>
   458→								<p class="text-sm whitespace-pre-wrap">{note.content}</p>
   459→							</div>
   460→						{/each}
   461→					</div>
   462→				</div>
   463→			</div>
   464→		{/if}
   465→	</Dialog.Content>
   466→</Dialog.Root>
   467→
```