   251→/**
   252→ * Fetch agent/dispatch status
   253→ * AC: @ui-task-board ac-4
   254→ */
   255→export interface AgentStatus {
   256→	dispatch_enabled: boolean;
   257→	active_invocations: Array<{
   258→		session_id: string;
   259→		agent_id: string;
   260→		task_ref: string | null;
   261→		elapsed_ms: number;
   262→	}>;
   263→	queue_depth: number;
   264→	agent_definitions: Array<{ id: string; name: string; adapter: string }>;
   265→}
   266→
   267→export async function fetchAgentStatus(): Promise<AgentStatus> {
   268→	if (isStaticMode()) {
   269→		return { dispatch_enabled: false, active_invocations: [], queue_depth: 0, agent_definitions: [] };
   270→	}
   271→
   272→	const response = await fetch(`${API_BASE}/api/agent/status`, {
   273→		headers: getProjectHeaders()
   274→	});
   275→	if (!response.ok) {
   276→		await handleResponseError(response);
   277→	}
   278→
   279→	return response.json();
   280→}
