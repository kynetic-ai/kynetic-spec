   282→/**
   283→ * Fetch spec items with optional filters
   284→ * AC: @web-dashboard ac-11
   285→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   286→ * AC: @gh-pages-export ac-11 - Static mode support
   287→ */
   288→export async function fetchItems(params?: {
   289→	type?: string | string[];
   290→	tag?: string;
   291→	limit?: number;
   292→	offset?: number;
   293→}): Promise<PaginatedResponse<ItemSummary>> {
   294→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   295→	if (isStaticMode()) {
   296→		return fetchItemsStatic(params);
   297→	}
   298→
   299→	const url = new URL(`${API_BASE}/api/items`);
   300→
   301→	if (params) {
   302→		Object.entries(params).forEach(([key, value]) => {
   303→			if (value !== undefined && value !== '') {
   304→				if (Array.isArray(value)) {
   305→					value.forEach((v) => url.searchParams.append(key, String(v)));
   306→				} else {
   307→					url.searchParams.set(key, String(value));
   308→				}
   309→			}
   310→		});
   311→	}
   312→
   313→	const response = await fetch(url.toString(), {
   314→		headers: getProjectHeaders()
   315→	});
   316→	if (!response.ok) {
   317→		await handleResponseError(response);
   318→	}
   319→
   320→	return response.json();
   321→}
