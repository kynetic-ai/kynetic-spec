     1→/**
     2→ * kspec serve commands - daemon server lifecycle management
     3→ * AC: @cli-serve-commands
     4→ */
     5→
     6→import type { Command } from 'commander';
     7→import { spawn, execSync } from 'child_process';
     8→import { existsSync, readdirSync, statSync } from 'fs';
     9→import { join, dirname } from 'path';
    10→import { fileURLToPath } from 'url';
    11→import { error, info, output, success, warn, isJsonMode } from '../output.js';
    12→import { EXIT_CODES } from '../exit-codes.js';
    13→import { PidFileManager } from '../pid-utils.js';
    14→import { loadProjectConfig } from '../../parser/config.js';
    15→import { initContext } from '../../parser/yaml.js';
    16→
    17→/**
    18→ * Check if Bun runtime is available.
    19→ * Daemon requires Bun to run TypeScript directly.
    20→ */
    21→function isBunAvailable(): boolean {
    22→  try {
    23→    execSync('bun --version', { stdio: 'pipe' });
    24→    return true;
    25→  } catch {
    26→    return false;
    27→  }
    28→}
    29→
    30→const __filename = fileURLToPath(import.meta.url);
    31→const __dirname = dirname(__filename);
    32→
    33→/**
    34→ * Check if daemon dist files are stale (source newer than dist)
    35→ * Returns true if rebuild is recommended
    36→ */
    37→function checkDaemonStaleness(): boolean {
    38→  // __dirname is dist/cli/commands, go up 3 levels to package root, then into packages/daemon/src
    39→  const sourceDir = join(__dirname, '../../../packages/daemon/src');
    40→  // dist/daemon is 2 levels up from __dirname
    41→  const distDir = join(__dirname, '../../daemon');
    42→
    43→  if (!existsSync(sourceDir) || !existsSync(distDir)) return false;
    44→
    45→  try {
    46→    const getNewestMtime = (dir: string): number => {
    47→      const files = readdirSync(dir, { withFileTypes: true });
    48→      let newest = 0;
    49→      for (const f of files) {
    50→        const fullPath = join(dir, f.name);
    51→        if (f.isDirectory()) {
    52→          newest = Math.max(newest, getNewestMtime(fullPath));
    53→        } else if (f.name.endsWith('.ts')) {
    54→          newest = Math.max(newest, statSync(fullPath).mtimeMs);
    55→        }
    56→      }
    57→      return newest;
    58→    };
    59→
    60→    const newestSource = getNewestMtime(sourceDir);
    61→    const newestDist = getNewestMtime(distDir);
    62→
    63→    return newestSource > newestDist;
    64→  } catch {
    65→    return false; // Don't warn if check fails
    66→  }
    67→}
    68→
    69→/**
    70→ * Normalize daemon uptime payloads to seconds.
    71→ * Some runtimes may serialize uptime as structured objects instead of a number.
    72→ */
    73→function parseUptimeSeconds(raw: unknown): number | null {
    74→  if (typeof raw === 'number' && Number.isFinite(raw)) {
    75→    return raw;
    76→  }
    77→
    78→  if (!raw || typeof raw !== 'object') {
    79→    return null;
    80→  }
    81→
    82→  const candidate = raw as { seconds?: unknown; milliseconds?: unknown; ms?: unknown };
    83→  if (typeof candidate.seconds === 'number' && Number.isFinite(candidate.seconds)) {
    84→    return candidate.seconds;
    85→  }
    86→  if (typeof candidate.milliseconds === 'number' && Number.isFinite(candidate.milliseconds)) {
    87→    return candidate.milliseconds / 1000;
    88→  }
    89→  if (typeof candidate.ms === 'number' && Number.isFinite(candidate.ms)) {
    90→    return candidate.ms / 1000;
    91→  }
    92→
    93→  return null;
    94→}
    95→
    96→
    97→/**
    98→ * Register serve commands
    99→ */
   100→export function registerServeCommands(program: Command): void {
   101→  const serve = program
   102→    .command('serve')
   103→    .description('Manage the kspec daemon server');
   104→
   105→  // AC: @cli-serve-commands ac-1, ac-2, ac-3
   106→  // AC: @config-daemon ac-1, ac-2 — port from config, CLI flag overrides
   107→  serve
   108→    .command('start', { isDefault: true })
   109→    .description('Start the daemon server')
   110→    .option('-d, --daemon', 'Run in background (detached mode)')
   111→    .option('-p, --port <port>', 'Server port (uses config daemon.port if not specified)')
   112→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   113→    .option('--json', 'Output as JSON')
   114→    .action(async (opts) => {
   115→      try {
   116→        await startServer(opts);
   117→      } catch (err) {
   118→        if (isJsonMode()) {
   119→          output({ error: err instanceof Error ? err.message : String(err) });
   120→        } else {
   121→          error(`Failed to start server: ${err instanceof Error ? err.message : String(err)}`);
   122→        }
   123→        process.exit(EXIT_CODES.ERROR);
   124→      }
   125→    });
   126→
   127→  // AC: @cli-serve-commands ac-4, ac-5
   128→  serve
   129→    .command('stop')
   130→    .description('Stop the daemon server')
   131→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   132→    .option('--json', 'Output as JSON')
   133→    .action(async (opts) => {
   134→      try {
   135→        await stopServer(opts);
   136→      } catch (err) {
   137→        if (isJsonMode()) {
   138→          output({ error: err instanceof Error ? err.message : String(err) });
   139→        } else {
   140→          error(`Failed to stop server: ${err instanceof Error ? err.message : String(err)}`);
   141→        }
   142→        process.exit(EXIT_CODES.ERROR);
   143→      }
   144→    });
   145→
   146→  // AC: @cli-serve-commands ac-6
   147→  serve
   148→    .command('status')
   149→    .description('Check daemon server status')
   150→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   151→    .option('--json', 'Output as JSON')
   152→    .action(async (opts) => {
   153→      try {
   154→        await statusServer(opts);
   155→      } catch (err) {
   156→        if (isJsonMode()) {
   157→          output({ error: err instanceof Error ? err.message : String(err) });
   158→        } else {
   159→          error(`Failed to check status: ${err instanceof Error ? err.message : String(err)}`);
   160→        }
   161→        process.exit(EXIT_CODES.ERROR);
   162→      }
   163→    });
   164→
   165→  // AC: @cli-serve-commands ac-7
   166→  serve
   167→    .command('restart')
   168→    .description('Restart the daemon server')
   169→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   170→    .option('--json', 'Output as JSON')
   171→    .action(async (opts) => {
   172→      try {
   173→        await restartServer(opts);
   174→      } catch (err) {
   175→        if (isJsonMode()) {
   176→          output({ error: err instanceof Error ? err.message : String(err) });
   177→        } else {
   178→          error(`Failed to restart server: ${err instanceof Error ? err.message : String(err)}`);
   179→        }
   180→        process.exit(EXIT_CODES.ERROR);
   181→      }
   182→    });
   183→}
   184→
   185→/**
   186→ * Start the daemon server
   187→ * AC: @cli-serve-commands ac-1 (foreground), ac-2 (daemon), ac-3 (port), ac-10 (port error)
   188→ * AC: @config-daemon ac-1 — port from config, ac-2 — CLI flag overrides config
   189→ */
   190→async function startServer(opts: {
   191→  daemon?: boolean;
   192→  port?: string;
   193→  kspecDir: string;
   194→}): Promise<void> {
   195→  const jsonMode = isJsonMode();
   196→
   197→  // AC: @config-daemon ac-1, ac-2 — load config for default port, CLI flag overrides
   198→  const { config } = await loadProjectConfig();
   199→  const configPort = config.daemon.port;
   200→
   201→  // AC: @config-daemon ac-2 — CLI flag takes precedence over config
   202→  const port = opts.port ? parseInt(opts.port, 10) : configPort;
   203→
   204→  // AC: @cli-serve-commands ac-10
   205→  if (isNaN(port) || port < 1 || port > 65535) {
   206→    if (jsonMode) {
   207→      output({
   208→        error: 'Invalid port number. Must be between 1 and 65535.',
   209→        hint: 'Try: kspec serve --port <PORT>',
   210→      });
   211→    } else {
   212→      error('Invalid port number. Must be between 1 and 65535.');
   213→      error('Try: kspec serve --port <PORT>');
   214→    }
   215→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   216→  }
   217→
   218→  const pidManager = new PidFileManager();
   219→
   220→  // Check if already running
   221→  if (pidManager.isDaemonRunning()) {
   222→    const pid = pidManager.readPid();
   223→    const existingPort = pidManager.readPort();
   224→    if (isJsonMode()) {
   225→      output({ running: true, pid, port: existingPort, message: 'Daemon already running' });
   226→    } else {
   227→      warn(`Daemon already running on port ${existingPort}`);
   228→    }
   229→    process.exit(EXIT_CODES.SUCCESS);
   230→  }
   231→
   232→  // Get path to daemon entry point
   233→  // Daemon source is bundled at dist/daemon/index.ts (relative to package root)
   234→  // __dirname is dist/cli/commands, so go up 2 levels to dist/, then into daemon/
   235→  // Note: Daemon is TypeScript source - requires Bun runtime
   236→  const daemonBinary = join(__dirname, '../../daemon/index.ts');
   237→
   238→  if (!existsSync(daemonBinary)) {
   239→    if (isJsonMode()) {
   240→      output({ error: `Daemon binary not found at ${daemonBinary}`, hint: 'Ensure the kspec package is properly installed' });
   241→    } else {
   242→      error(`Daemon binary not found at: ${daemonBinary}`);
   243→      error('Ensure the kspec package is properly installed');
   244→    }
   245→    process.exit(EXIT_CODES.ERROR);
   246→  }
   247→
   248→  // Daemon requires Bun to run TypeScript directly
   249→  if (!isBunAvailable()) {
   250→    if (isJsonMode()) {
   251→      output({ error: 'Bun runtime not found', hint: 'Install Bun: https://bun.sh/docs/installation' });
   252→    } else {
   253→      error('Bun runtime is required for the daemon server');
   254→      error('Install Bun: https://bun.sh/docs/installation');
   255→    }
   256→    process.exit(EXIT_CODES.ERROR);
   257→  }
   258→
   259→  // Check for stale daemon build (dev experience improvement)
   260→  if (checkDaemonStaleness() && !jsonMode) {
   261→    warn('Warning: dist/daemon/ may be stale (source files are newer).');
   262→    warn('  Run "npm run build:daemon" to update.');
   263→  }
   264→
   265→  // AC: @cli-serve-commands ac-2 - background mode
   266→  if (opts.daemon) {
   267→    const runtime = 'bun';
   268→
   269→    // Spawn detached process
   270→    // Set BUN_ENV=production to prevent Bun dev mode HTML transformation
   271→    // which can cause asset hash mismatches in the web UI
   272→    const child = spawn(runtime, [daemonBinary, '--port', String(port), '--kspec-dir', opts.kspecDir], {
   273→      detached: true,
   274→      stdio: 'ignore', // TODO: redirect to log file when logging implemented
   275→      cwd: process.cwd(),
   276→      env: { ...process.env, BUN_ENV: 'production' },
   277→    });
   278→
   279→    // Detach from parent
   280→    child.unref();
   281→
   282→    // Poll for PID file with timeout (max 5 seconds)
   283→    const maxWait = 5000;
   284→    const startTime = Date.now();
   285→    let pid: number | null = null;
   286→
   287→    while (Date.now() - startTime < maxWait) {
   288→      pid = pidManager.readPid();
   289→      if (pid && pidManager.isDaemonRunning()) {
   290→        break;
   291→      }
   292→      await new Promise(resolve => setTimeout(resolve, 100));
   293→    }
   294→
   295→    if (pid && pidManager.isDaemonRunning()) {
   296→      if (isJsonMode()) {
   297→        output({ running: true, pid, port });
   298→      } else {
   299→        success(`Daemon started with PID ${pid} on port ${port}`);
   300→        output({ running: true, pid, port });
   301→      }
   302→    } else {
   303→      if (isJsonMode()) {
   304→        output({ error: 'Daemon failed to start within 5 seconds' });
   305→      } else {
   306→        error('Daemon failed to start within 5 seconds');
   307→      }
   308→      process.exit(EXIT_CODES.ERROR);
   309→    }
   310→  } else {
   311→    // AC: @cli-serve-commands ac-1 - foreground mode
   312→    if (!isJsonMode()) {
   313→      info(`Starting server in foreground on port ${port}...`);
   314→      info('Press Ctrl+C to stop');
   315→    }
   316→
   317→    const runtime = 'bun';
   318→
   319→    // Set BUN_ENV=production to prevent Bun dev mode HTML transformation
   320→    const child = spawn(runtime, [daemonBinary, '--port', String(port), '--kspec-dir', opts.kspecDir], {
   321→      stdio: 'inherit',
   322→      cwd: process.cwd(),
   323→      env: { ...process.env, BUN_ENV: 'production' },
   324→    });
   325→
   326→    // Handle Ctrl+C - forward SIGTERM to child for graceful shutdown
   327→    process.on('SIGINT', () => {
   328→      if (!isJsonMode()) {
   329→        info('\nStopping server...');
   330→      }
   331→      child.kill('SIGTERM');
   332→
   333→      // Wait for graceful shutdown (max 5 seconds)
   334→      const shutdownTimeout = setTimeout(() => {
   335→        child.kill('SIGKILL'); // Force kill if not stopped
   336→      }, 5000);
   337→
   338→      child.on('exit', () => {
   339→        clearTimeout(shutdownTimeout);
   340→      });
   341→    });
   342→
   343→    // Wait for process to exit
   344→    child.on('exit', (code) => {
   345→      process.exit(code ?? 0);
   346→    });
   347→  }
   348→}
   349→
   350→/**
   351→ * Stop the daemon server
   352→ * AC: @cli-serve-commands ac-4 (stop), ac-5 (idempotent)
   353→ */
   354→async function stopServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {
   355→  if (isJsonMode()) {
   356→  }
   357→
   358→  const pidManager = new PidFileManager();
   359→
   360→  if (!pidManager.isDaemonRunning()) {
   361→    // AC: @cli-serve-commands ac-5
   362→    if (isJsonMode()) {
   363→      output({ running: false });
   364→    } else {
   365→      info('Daemon not running');
   366→      output({ running: false });
   367→    }
   368→    process.exit(EXIT_CODES.SUCCESS);
   369→  }
   370→
   371→  const pid = pidManager.readPid();
   372→  if (!pid) {
   373→    if (isJsonMode()) {
   374→      output({ error: 'Failed to read PID file' });
   375→    } else {
   376→      error('Failed to read PID file');
   377→    }
   378→    process.exit(EXIT_CODES.ERROR);
   379→  }
   380→
   381→  // AC: @cli-serve-commands ac-4
   382→  if (!isJsonMode()) {
   383→    info(`Stopping daemon (PID ${pid})...`);
   384→  }
   385→
   386→  try {
   387→    // Send SIGTERM
   388→    process.kill(pid, 'SIGTERM');
   389→
   390→    // Wait for clean shutdown (max 5 seconds)
   391→    const maxWait = 5000;
   392→    const startTime = Date.now();
   393→    while (Date.now() - startTime < maxWait) {
   394→      if (!pidManager.isDaemonRunning()) {
   395→        break;
   396→      }
   397→      await new Promise(resolve => setTimeout(resolve, 100));
   398→    }
   399→
   400→    if (pidManager.isDaemonRunning()) {
   401→      if (!isJsonMode()) {
   402→        warn(`Daemon did not stop gracefully, forcing...`);
   403→      }
   404→      process.kill(pid, 'SIGKILL');
   405→      await new Promise(resolve => setTimeout(resolve, 500));
   406→    }
   407→
   408→    if (isJsonMode()) {
   409→      output({ stopped: true, pid });
   410→    } else {
   411→      success('Daemon stopped');
   412→      output({ stopped: true, pid });
   413→    }
   414→  } catch (err) {
   415→    if (isJsonMode()) {
   416→      output({ error: err instanceof Error ? err.message : String(err) });
   417→    } else {
   418→      error(`Failed to stop daemon: ${err instanceof Error ? err.message : String(err)}`);
   419→    }
   420→    process.exit(EXIT_CODES.ERROR);
   421→  }
   422→}
   423→
   424→/**
   425→ * Check daemon server status
   426→ * AC: @cli-serve-commands ac-6, @multi-directory-daemon ac-12
   427→ */
   428→async function statusServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {
   429→  if (isJsonMode()) {
   430→  }
   431→
   432→  const pidManager = new PidFileManager();
   433→  const running = pidManager.isDaemonRunning();
   434→  const pid = pidManager.readPid();
   435→
   436→  // Read port from global config (AC: @multi-directory-daemon ac-13)
   437→  let port: number | null = null;
   438→  if (running) {
   439→    try {
   440→      port = pidManager.readPort();
   441→    } catch {
   442→      // Port file might not exist or be invalid
   443→      port = null;
   444→    }
   445→  }
   446→
   447→  // AC: @multi-directory-daemon ac-12 - Fetch list of registered projects and uptime
   448→  let projects: Array<{ path: string; registeredAt: string; watcherStatus: string }> = [];
   449→  let uptime: number | null = null;
   450→  if (running && port) {
   451→    try {
   452→      const response = await fetch(`http://localhost:${port}/api/projects`);
   453→      if (response.ok) {
   454→        const data = await response.json() as { projects: Array<{ path: string; registeredAt: string; watcherStatus: string }> };
   455→        projects = data.projects || [];
   456→      }
   457→    } catch {
   458→      // If daemon is not responding, continue without projects list
   459→      // This can happen if daemon is still starting up or network issues
   460→    }
   461→
   462→    // Fetch uptime from health endpoint.
   463→    // Retry briefly to reduce startup races where status is checked immediately after daemon start.
   464→    for (let attempt = 1; attempt <= 5 && uptime === null; attempt++) {
   465→      try {
   466→        const healthResponse = await fetch(`http://localhost:${port}/api/health`);
   467→        if (healthResponse.ok) {
   468→          const healthData = await healthResponse.json() as { status: string; uptime?: unknown };
   469→          const parsed = parseUptimeSeconds(healthData.uptime);
   470→          if (parsed !== null) {
   471→            uptime = parsed;
   472→            break;
   473→          }
   474→        }
   475→      } catch {
   476→        // If health endpoint fails, continue retry loop.
   477→      }
   478→
   479→      if (attempt < 5) {
   480→        await new Promise(resolve => setTimeout(resolve, 200));
   481→      }
   482→    }
   483→  }
   484→
   485→  const status = {
   486→    running,
   487→    pid: pid ?? null,
   488→    port,
   489→    uptime,
   490→    projects,
   491→  };
   492→
   493→  if (isJsonMode()) {
   494→    output(status);
   495→  } else {
   496→    if (running) {
   497→      output(`Daemon running (PID: ${pid})`);
   498→      if (port) {
   499→        output(`  Port: ${port}`);
   500→      }
   501→      // AC: @multi-directory-daemon ac-12 - Show uptime
   502→      if (uptime !== null) {
   503→        const hours = Math.floor(uptime / 3600);
   504→        const minutes = Math.floor((uptime % 3600) / 60);
   505→        const seconds = Math.floor(uptime % 60);
   506→        if (hours > 0) {
   507→          output(`  Uptime: ${hours}h ${minutes}m ${seconds}s`);
   508→        } else if (minutes > 0) {
   509→          output(`  Uptime: ${minutes}m ${seconds}s`);
   510→        } else {
   511→          output(`  Uptime: ${seconds}s`);
   512→        }
   513→      }
   514→      // AC: @multi-directory-daemon ac-12 - Show registered projects
   515→      if (projects.length > 0) {
   516→        output(`\nRegistered projects (${projects.length}):`);
   517→        for (const project of projects) {
   518→          output(`  ${project.path} (watcher: ${project.watcherStatus})`);
   519→        }
   520→      } else {
   521→        output(`\nNo projects registered`);
   522→      }
   523→    } else {
   524→      output('Daemon not running');
   525→    }
   526→  }
   527→}
   528→
   529→/**
   530→ * Restart the daemon server
   531→ * AC: @cli-serve-commands ac-7
   532→ */
   533→async function restartServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {
   534→  const pidManager = new PidFileManager();
   535→
   536→  // AC: @cli-serve-commands ac-7 - preserve port across restarts
   537→  // Try to read port from existing daemon, otherwise startServer will use config default
   538→  let port: string | undefined;
   539→  try {
   540→    port = pidManager.readPort().toString();
   541→  } catch {
   542→    // Port file doesn't exist or is invalid, let startServer use config
   543→  }
   544→
   545→  if (pidManager.isDaemonRunning()) {
   546→    if (!isJsonMode()) {
   547→      info('Stopping daemon...');
   548→    }
   549→    await stopServer(opts);
   550→  }
   551→
   552→  if (!isJsonMode()) {
   553→    info('Starting daemon...');
   554→  }
   555→  await startServer({ daemon: true, port, kspecDir: opts.kspecDir });
   556→}
