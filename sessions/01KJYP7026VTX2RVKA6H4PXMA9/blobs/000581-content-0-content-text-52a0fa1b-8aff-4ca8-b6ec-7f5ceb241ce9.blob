```
     1→/**
     2→ * Task API Routes
     3→ *
     4→ * REST endpoints for task operations:
     5→ * - GET /api/tasks - list with filters and pagination
     6→ * - GET /api/tasks/:ref - get single task
     7→ * - POST /api/tasks/:ref/start - start task
     8→ * - POST /api/tasks/:ref/note - add note
     9→ *
    10→ * AC Coverage:
    11→ * - ac-2: GET /api/tasks returns array with status, priority, spec_ref, notes count
    12→ * - ac-3: Status filter with multi-value support
    13→ * - ac-4: Pagination with {items, total, offset, limit} wrapper
    14→ * - ac-5: GET /api/tasks/:ref resolves via ReferenceIndex
    15→ * - ac-6: POST /api/tasks/:ref/start transitions state
    16→ * - ac-7: POST /api/tasks/:ref/note appends note
    17→ * - @ui-task-board ac-6: POST /api/tasks/:ref/submit transitions to pending_review
    18→ * - @ui-task-board ac-6: POST /api/tasks/:ref/complete transitions to completed
    19→ * - @ui-task-board ac-6: POST /api/tasks/:ref/block transitions to blocked
    20→ */
    21→
    22→import { Elysia, t } from 'elysia';
    23→import {
    24→  initContext,
    25→  loadAllTasks,
    26→  loadAllItems,
    27→  ReferenceIndex,
    28→  createNote,
    29→  saveTask,
    30→  getAuthor,
    31→  syncSpecImplementationStatus,
    32→  type LoadedTask,
    33→} from '../../parser/index.js';
    34→import { commitIfShadow } from '../../parser/shadow.js';
    35→import type { PubSubManager } from '../websocket/pubsub';
    36→
    37→interface TasksRouteOptions {
    38→  pubsub: PubSubManager;
    39→}
    40→
    41→export function createTasksRoutes(options: TasksRouteOptions) {
    42→  const { pubsub } = options;
    43→
    44→  return new Elysia({ prefix: '/api/tasks' })
    45→    // AC: @api-contract ac-2, ac-3, ac-4 - List tasks with filters and pagination
    46→    .get(
    47→      '/',
    48→      async ({ query, projectContext }) => {
    49→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
    50→        const ctx = await initContext(projectContext.path);
    51→        const tasks = await loadAllTasks(ctx);
    52→        const specItems = await loadAllItems(ctx);
    53→        const index = new ReferenceIndex(tasks, specItems);
    54→
    55→        // Apply filters
    56→        let filtered = tasks;
    57→
    58→        // AC: @api-contract ac-3 - Multi-value status filter
    59→        if (query.status) {
    60→          const statusFilters = Array.isArray(query.status) ? query.status : [query.status];
    61→          filtered = filtered.filter((task) => statusFilters.includes(task.status));
    62→        }
    63→
    64→        // Type filter (optional, not in ACs but useful)
    65→        if (query.type) {
    66→          const typeFilters = Array.isArray(query.type) ? query.type : [query.type];
    67→          filtered = filtered.filter((task) => task.type && typeFilters.includes(task.type));
    68→        }
    69→
    70→        // Tag filter (optional, not in ACs but useful)
    71→        if (query.tag) {
    72→          const tagFilters = Array.isArray(query.tag) ? query.tag : [query.tag];
    73→          filtered = filtered.filter((task) =>
    74→            task.tags?.some((t) => tagFilters.includes(t))
    75→          );
    76→        }
    77→
    78→        // AC: @api-contract ac-4 - Pagination
    79→        const total = filtered.length;
    80→        const offset = Number(query.offset) || 0;
    81→        const limit = Number(query.limit) || total;
    82→
    83→        const paginated = filtered.slice(offset, offset + limit);
    84→
    85→        // AC: @api-contract ac-2 - Return with status, priority, spec_ref, notes count
    86→        // AC: @web-dashboard ac-1 - Include depends_on for blocked task computation
    87→        const items = paginated.map((task) => ({
    88→          _ulid: task._ulid,
    89→          slugs: task.slugs,
    90→          title: task.title,
    91→          status: task.status,
    92→          priority: task.priority,
    93→          spec_ref: task.spec_ref,
    94→          meta_ref: task.meta_ref,
    95→          tags: task.tags,
    96→          depends_on: task.depends_on || [],
    97→          notes_count: task.notes?.length || 0,
    98→          todos_count: task.todos?.length || 0,
    99→          automation: task.automation,
   100→          started_at: task.started_at,
   101→          completed_at: task.completed_at,
   102→          created_at: task.created_at,
   103→        }));
   104→
   105→        // AC: @api-contract ac-4, @trait-api-endpoint ac-4 - Return pagination wrapper
   106→        return {
   107→          items,
   108→          total,
   109→          offset,
   110→          limit,
   111→        };
   112→      },
   113→      {
   114→        query: t.Object({
   115→          status: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   116→          type: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   117→          tag: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   118→          limit: t.Optional(t.String()),
   119→          offset: t.Optional(t.String()),
   120→        }),
   121→      }
   122→    )
   123→
   124→    // AC: @api-contract ac-5 - Get single task by ref
   125→    .get(
   126→      '/:ref',
   127→      async ({ params, error: errorResponse, projectContext }) => {
   128→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   129→        const ctx = await initContext(projectContext.path);
   130→        const tasks = await loadAllTasks(ctx);
   131→        const items = await loadAllItems(ctx);
   132→        const index = new ReferenceIndex(tasks, items);
   133→
   134→        // AC: @api-contract ac-5, @trait-api-endpoint ac-2 - Resolve ref via ReferenceIndex
   135→        const result = index.resolve(params.ref);
   136→
   137→        if (!result.ok) {
   138→          // AC: @trait-api-endpoint ac-2 - Return 404 with error details
   139→          return errorResponse(404, {
   140→            error: 'not_found',
   141→            message: `Task reference "${params.ref}" not found`,
   142→            suggestion: 'Use kspec task list or kspec search to find valid task references',
   143→          });
   144→        }
   145→
   146→        // Find the task
   147→        const task = tasks.find((t) => t._ulid === result.ulid);
   148→        if (!task) {
   149→          return errorResponse(404, {
   150→            error: 'not_found',
   151→            message: `Reference "${params.ref}" is not a task`,
   152→            suggestion: 'This reference might point to a spec item instead',
   153→          });
   154→        }
   155→
   156→        // AC: @api-contract ac-5 - Return full task with notes, todos, dependencies
   157→        return {
   158→          _ulid: task._ulid,
   159→          slugs: task.slugs,
   160→          title: task.title,
   161→          status: task.status,
   162→          priority: task.priority,
   163→          spec_ref: task.spec_ref,
   164→          meta_ref: task.meta_ref,
   165→          tags: task.tags,
   166→          description: task.description,
   167→          depends_on: task.depends_on,
   168→          notes: task.notes,
   169→          todos: task.todos,
   170→          started_at: task.started_at,
   171→          completed_at: task.completed_at,
   172→          cancelled_at: task.cancelled_at,
   173→          closed_reason: task.closed_reason,
   174→          automation: task.automation,
   175→          created_at: task.created_at,
   176→        };
   177→      },
   178→      {
   179→        params: t.Object({
   180→          ref: t.String(),
   181→        }),
   182→      }
   183→    )
   184→
   185→    // AC: @api-contract ac-6 - Start task
   186→    .post(
   187→      '/:ref/start',
   188→      async ({ params, error: errorResponse, projectContext }) => {
   189→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   190→        const ctx = await initContext(projectContext.path);
   191→        const tasks = await loadAllTasks(ctx);
   192→        const items = await loadAllItems(ctx);
   193→        const index = new ReferenceIndex(tasks, items);
   194→
   195→        // Resolve ref
   196→        const result = index.resolve(params.ref);
   197→        if (!result.ok) {
   198→          return errorResponse(404, {
   199→            error: 'not_found',
   200→            message: `Task reference "${params.ref}" not found`,
   201→            suggestion: 'Use kspec task list to find valid task references',
   202→          });
   203→        }
   204→
   205→        const task = tasks.find((t) => t._ulid === result.ulid);
   206→        if (!task) {
   207→          return errorResponse(404, {
   208→            error: 'not_found',
   209→            message: `Reference "${params.ref}" is not a task`,
   210→          });
   211→        }
   212→
   213→        // AC: @api-contract ac-6 - Transition to in_progress
   214→        if (task.status === 'in_progress') {
   215→          return errorResponse(409, {
   216→            error: 'invalid_transition',
   217→            message: 'Task is already in_progress',
   218→            current: task.status,
   219→            valid_transitions: ['blocked', 'pending_review', 'completed', 'cancelled'],
   220→          });
   221→        }
   222→
   223→        // Update task status
   224→        const updatedTask: LoadedTask = {
   225→          ...task,
   226→          status: 'in_progress',
   227→          started_at: task.started_at || new Date().toISOString(),
   228→        };
   229→
   230→        // Save and commit
   231→        await saveTask(ctx, updatedTask);
   232→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   233→        await commitIfShadow(ctx.shadow, `task: start ${params.ref}`);
   234→
   235→        // AC: @api-contract ac-6, @trait-api-endpoint ac-5 - WebSocket broadcast
   236→        // AC: @multi-directory-daemon ac-18 - Broadcast scoped to request project
   237→        pubsub.broadcast('tasks:updates', 'task_updated', {
   238→          ref: params.ref,
   239→          ulid: task._ulid,
   240→          action: 'start',
   241→          status: 'in_progress',
   242→        }, projectContext.path);
   243→
   244→        // AC: @api-contract ac-6 - Return updated task
   245→        return updatedTask;
   246→      },
   247→      {
   248→        params: t.Object({
   249→          ref: t.String(),
   250→        }),
   251→      }
   252→    )
   253→
   254→    // AC: @api-contract ac-7 - Add note to task
   255→    .post(
   256→      '/:ref/note',
   257→      async ({ params, body, error: errorResponse, projectContext }) => {
   258→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   259→        const ctx = await initContext(projectContext.path);
   260→        const tasks = await loadAllTasks(ctx);
   261→        const items = await loadAllItems(ctx);
   262→        const index = new ReferenceIndex(tasks, items);
   263→
   264→        // Resolve ref
   265→        const result = index.resolve(params.ref);
   266→        if (!result.ok) {
   267→          return errorResponse(404, {
   268→            error: 'not_found',
   269→            message: `Task reference "${params.ref}" not found`,
   270→          });
   271→        }
   272→
   273→        const task = tasks.find((t) => t._ulid === result.ulid);
   274→        if (!task) {
   275→          return errorResponse(404, {
   276→            error: 'not_found',
   277→            message: `Reference "${params.ref}" is not a task`,
   278→          });
   279→        }
   280→
   281→        // AC: @trait-api-endpoint ac-3 - Validate body
   282→        if (!body.content || typeof body.content !== 'string') {
   283→          return errorResponse(400, {
   284→            error: 'validation_error',
   285→            details: [
   286→              {
   287→                field: 'content',
   288→                message: 'Content is required and must be a string',
   289→              },
   290→            ],
   291→          });
   292→        }
   293→
   294→        // AC: @api-contract ac-7 - Append note
   295→        const author = getAuthor(ctx.config?.identity?.author);
   296→        const note = createNote(body.content, author);
   297→
   298→        const updatedTask: LoadedTask = {
   299→          ...task,
   300→          notes: [...(task.notes || []), note],
   301→        };
   302→
   303→        // AC: @api-contract ac-7, @trait-api-endpoint ac-5 - Shadow commit
   304→        await saveTask(ctx, updatedTask);
   305→        await commitIfShadow(ctx.shadow, `task: add note to ${params.ref}`);
   306→
   307→        // AC: @api-contract ac-7 - WebSocket broadcast
   308→        // AC: @multi-directory-daemon ac-18 - Broadcast scoped to request project
   309→        pubsub.broadcast('tasks:updates', 'task_updated', {
   310→          ref: params.ref,
   311→          ulid: task._ulid,
   312→          action: 'note_added',
   313→          note_ulid: note._ulid,
   314→        }, projectContext.path);
   315→
   316→        return {
   317→          success: true,
   318→          note,
   319→          task: updatedTask,
   320→        };
   321→      },
   322→      {
   323→        params: t.Object({
   324→          ref: t.String(),
   325→        }),
   326→        body: t.Object({
   327→          content: t.String(),
   328→        }),
   329→      }
   330→    )
   331→
   332→    // AC: @ui-task-board ac-6 - Submit task for review
   333→    .post(
   334→      '/:ref/submit',
   335→      async ({ params, error: errorResponse, projectContext }) => {
   336→        const ctx = await initContext(projectContext.path);
   337→        const tasks = await loadAllTasks(ctx);
   338→        const items = await loadAllItems(ctx);
   339→        const index = new ReferenceIndex(tasks, items);
   340→
   341→        const result = index.resolve(params.ref);
   342→        if (!result.ok) {
   343→          return errorResponse(404, {
   344→            error: 'not_found',
   345→            message: `Task reference "${params.ref}" not found`,
   346→          });
   347→        }
   348→
   349→        const task = tasks.find((t) => t._ulid === result.ulid);
   350→        if (!task) {
   351→          return errorResponse(404, {
   352→            error: 'not_found',
   353→            message: `Reference "${params.ref}" is not a task`,
   354→          });
   355→        }
   356→
   357→        if (task.status !== 'in_progress' && task.status !== 'needs_work') {
   358→          return errorResponse(409, {
   359→            error: 'invalid_transition',
   360→            message: `Cannot submit task with status "${task.status}". Must be in_progress or needs_work.`,
   361→            current: task.status,
   362→            valid_transitions: ['pending_review'],
   363→          });
   364→        }
   365→
   366→        const updatedTask: LoadedTask = { ...task, status: 'pending_review' };
   367→        await saveTask(ctx, updatedTask);
   368→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   369→        await commitIfShadow(ctx.shadow, `task: submit ${params.ref}`);
   370→
   371→        pubsub.broadcast('tasks:updates', 'task_updated', {
   372→          ref: params.ref,
   373→          ulid: task._ulid,
   374→          action: 'submit',
   375→          status: 'pending_review',
   376→        }, projectContext.path);
   377→
   378→        return updatedTask;
   379→      },
   380→      { params: t.Object({ ref: t.String() }) }
   381→    )
   382→
   383→    // AC: @ui-task-board ac-6 - Complete task
   384→    .post(
   385→      '/:ref/complete',
   386→      async ({ params, body, error: errorResponse, projectContext }) => {
   387→        const ctx = await initContext(projectContext.path);
   388→        const tasks = await loadAllTasks(ctx);
   389→        const items = await loadAllItems(ctx);
   390→        const index = new ReferenceIndex(tasks, items);
   391→
   392→        const result = index.resolve(params.ref);
   393→        if (!result.ok) {
   394→          return errorResponse(404, {
   395→            error: 'not_found',
   396→            message: `Task reference "${params.ref}" not found`,
   397→          });
   398→        }
   399→
   400→        const task = tasks.find((t) => t._ulid === result.ulid);
   401→        if (!task) {
   402→          return errorResponse(404, {
   403→            error: 'not_found',
   404→            message: `Reference "${params.ref}" is not a task`,
   405→          });
   406→        }
   407→
   408→        const updatedTask: LoadedTask = {
   409→          ...task,
   410→          status: 'completed',
   411→          completed_at: new Date().toISOString(),
   412→          closed_reason: body.reason,
   413→        };
   414→        await saveTask(ctx, updatedTask);
   415→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   416→        await commitIfShadow(ctx.shadow, `task: complete ${params.ref}`);
   417→
   418→        pubsub.broadcast('tasks:updates', 'task_updated', {
   419→          ref: params.ref,
   420→          ulid: task._ulid,
   421→          action: 'complete',
   422→          status: 'completed',
   423→        }, projectContext.path);
   424→
   425→        return updatedTask;
   426→      },
   427→      {
   428→        params: t.Object({ ref: t.String() }),
   429→        body: t.Object({ reason: t.String() }),
   430→      }
   431→    )
   432→
   433→    // AC: @ui-task-board ac-6 - Block task
   434→    .post(
   435→      '/:ref/block',
   436→      async ({ params, body, error: errorResponse, projectContext }) => {
   437→        const ctx = await initContext(projectContext.path);
   438→        const tasks = await loadAllTasks(ctx);
   439→        const items = await loadAllItems(ctx);
   440→        const index = new ReferenceIndex(tasks, items);
   441→
   442→        const result = index.resolve(params.ref);
   443→        if (!result.ok) {
   444→          return errorResponse(404, {
   445→            error: 'not_found',
   446→            message: `Task reference "${params.ref}" not found`,
   447→          });
   448→        }
   449→
   450→        const task = tasks.find((t) => t._ulid === result.ulid);
   451→        if (!task) {
   452→          return errorResponse(404, {
   453→            error: 'not_found',
   454→            message: `Reference "${params.ref}" is not a task`,
   455→          });
   456→        }
   457→
   458→        const author = getAuthor(ctx.config?.identity?.author);
   459→        const note = createNote(`Blocked: ${body.reason}`, author);
   460→
   461→        const updatedTask: LoadedTask = {
   462→          ...task,
   463→          status: 'blocked',
   464→          notes: [...(task.notes || []), note],
   465→        };
   466→        await saveTask(ctx, updatedTask);
   467→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   468→        await commitIfShadow(ctx.shadow, `task: block ${params.ref}`);
   469→
   470→        pubsub.broadcast('tasks:updates', 'task_updated', {
   471→          ref: params.ref,
   472→          ulid: task._ulid,
   473→          action: 'block',
   474→          status: 'blocked',
   475→        }, projectContext.path);
   476→
   477→        return updatedTask;
   478→      },
   479→      {
   480→        params: t.Object({ ref: t.String() }),
   481→        body: t.Object({ reason: t.String() }),
   482→      }
   483→    );
   484→}
   485→
```