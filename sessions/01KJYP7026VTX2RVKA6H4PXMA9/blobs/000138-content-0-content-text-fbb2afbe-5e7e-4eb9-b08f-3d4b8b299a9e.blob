```
     1→<script lang="ts">
     2→	// AC: @web-dashboard ac-4, ac-5, ac-9, ac-10, ac-33
     3→	// AC: @multi-directory-daemon ac-27 - Reload on project change
     4→	// AC: @gh-pages-export ac-16 - Disable Start Task in static mode
     5→	import { page } from '$app/stores';
     6→	import { base } from '$app/paths';
     7→	import { onMount, onDestroy, flushSync } from 'svelte';
     8→	import type { TaskSummary, TaskDetail, BroadcastEvent } from '@kynetic-ai/shared';
     9→	import TaskFilters from '$lib/components/TaskFilters.svelte';
    10→	import TaskList from '$lib/components/TaskList.svelte';
    11→	import { fetchTasks, fetchTask, startTask, addTaskNote } from '$lib/api';
    12→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    13→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    14→	import { Button } from '$lib/components/ui/button';
    15→	import { Badge } from '$lib/components/ui/badge';
    16→	import { Textarea } from '$lib/components/ui/textarea';
    17→	import { Separator } from '$lib/components/ui/separator';
    18→	import * as Tooltip from '$lib/components/ui/tooltip';
    19→	import XIcon from '@lucide/svelte/icons/x';
    20→	import LayoutGrid from '@lucide/svelte/icons/layout-grid';
    21→	import ListIcon from '@lucide/svelte/icons/list';
    22→	import { getProjectVersion } from '$lib/stores/project.svelte';
    23→
    24→	let tasks = $state<TaskSummary[]>([]);
    25→	let total = $state(0);
    26→	let loading = $state(true);
    27→	let error = $state('');
    28→	let updatedTaskIds = $state<Set<string>>(new Set());
    29→
    30→	// Use $state with an object for panel state to ensure deep reactivity
    31→	let panel = $state<{ open: boolean; task: TaskDetail | null }>({
    32→		open: false,
    33→		task: null
    34→	});
    35→
    36→	let noteContent = $state('');
    37→	let isSubmitting = $state(false);
    38→	let panelError = $state('');
    39→
    40→	// Reactive: re-fetch when URL params change
    41→	let filterParams = $derived({
    42→		status: $page.url.searchParams.get('status') || undefined,
    43→		type: $page.url.searchParams.get('type') || undefined,
    44→		tag: $page.url.searchParams.get('tag') || undefined,
    45→		assignee: $page.url.searchParams.get('assignee') || undefined,
    46→		automation: $page.url.searchParams.get('automation') || undefined,
    47→		limit: 50,
    48→		offset: 0
    49→	});
    50→
    51→	// Track the last processed ref to avoid infinite loops
    52→	let lastProcessedRef = $state('');
    53→
    54→	$effect(() => {
    55→		// Re-fetch when filterParams changes - explicitly access all properties for dependency tracking
    56→		const { status, type, tag, assignee, automation, limit, offset } = filterParams;
    57→		loadTasks();
    58→	});
    59→
    60→	// AC: @multi-directory-daemon ac-27 - Reload data when project changes
    61→	$effect(() => {
    62→		const version = getProjectVersion();
    63→		if (version > 0) {
    64→			// Only reload if version has been incremented (not on initial load)
    65→			loadTasks();
    66→		}
    67→	});
    68→
    69→	// AC: Open task detail when URL has ref param
    70→	$effect(() => {
    71→		const urlRef = $page.url.searchParams.get('ref');
    72→		if (urlRef && urlRef !== lastProcessedRef) {
    73→			lastProcessedRef = urlRef;
    74→			handleSelectTask(urlRef);
    75→		}
    76→	});
    77→
    78→	async function loadTasks() {
    79→		loading = true;
    80→		error = '';
    81→
    82→		try {
    83→			const response = await fetchTasks(filterParams);
    84→			tasks = response.items;
    85→			total = response.total;
    86→		} catch (err) {
    87→			error = err instanceof Error ? err.message : 'Failed to load tasks';
    88→			console.error('Error loading tasks:', err);
    89→		} finally {
    90→			loading = false;
    91→		}
    92→	}
    93→
    94→	async function handleSelectTask(taskId: string) {
    95→		console.log('[TasksPage] handleSelectTask called for:', taskId);
    96→		try {
    97→			console.log('[TasksPage] Fetching task details...');
    98→			const task = await fetchTask(taskId);
    99→			console.log('[TasksPage] Task fetched:', task?.title);
   100→			// Update panel state using flushSync to ensure synchronous DOM update
   101→			flushSync(() => {
   102→				panel.task = task;
   103→				panel.open = true;
   104→			});
   105→			console.log('[TasksPage] panel.open set to true, panel.task:', panel.task?.title);
   106→		} catch (err) {
   107→			error = err instanceof Error ? err.message : 'Failed to load task details';
   108→			console.error('[TasksPage] Error loading task:', err);
   109→		}
   110→	}
   111→
   112→	// Legacy event handler for backwards compatibility
   113→	function handleSelectTaskEvent(event: CustomEvent<string>) {
   114→		handleSelectTask(event.detail);
   115→	}
   116→
   117→	function handleCloseDetail() {
   118→		panel.open = false;
   119→		panel.task = null;
   120→		noteContent = '';
   121→		panelError = '';
   122→		lastProcessedRef = ''; // Reset so we can reopen same task if URL param set again
   123→	}
   124→
   125→	// Handle clicking outside the panel
   126→	function handleOverlayClick(e: MouseEvent) {
   127→		if (e.target === e.currentTarget) {
   128→			handleCloseDetail();
   129→		}
   130→	}
   131→
   132→	// Handle escape key
   133→	function handleKeydown(e: KeyboardEvent) {
   134→		if (e.key === 'Escape' && panel.open) {
   135→			handleCloseDetail();
   136→		}
   137→	}
   138→
   139→	async function handleStartTask() {
   140→		if (!panel.task) return;
   141→
   142→		// AC: @gh-pages-export ac-16, ac-18 - Check static mode
   143→		if (isStaticMode()) {
   144→			panelError = 'Cannot start task in read-only mode. Use the kspec CLI.';
   145→			return;
   146→		}
   147→
   148→		isSubmitting = true;
   149→		panelError = '';
   150→
   151→		try {
   152→			await startTask(panel.task._ulid);
   153→			// Reload task to get updated status
   154→			const updated = await fetchTask(panel.task._ulid);
   155→			panel.task = updated;
   156→			loadTasks();
   157→		} catch (err) {
   158→			// AC: @gh-pages-export ac-18 - Graceful error message
   159→			if (err instanceof ReadOnlyModeError) {
   160→				panelError = err.message;
   161→			} else {
   162→				panelError = err instanceof Error ? err.message : 'Failed to start task';
   163→			}
   164→		} finally {
   165→			isSubmitting = false;
   166→		}
   167→	}
   168→
   169→	async function handleAddNote() {
   170→		if (!panel.task || !noteContent.trim()) return;
   171→
   172→		// AC: @gh-pages-export ac-18 - Check static mode
   173→		if (isStaticMode()) {
   174→			panelError = 'Cannot add notes in read-only mode. Use the kspec CLI.';
   175→			return;
   176→		}
   177→
   178→		isSubmitting = true;
   179→		panelError = '';
   180→
   181→		try {
   182→			await addTaskNote(panel.task._ulid, noteContent);
   183→			noteContent = '';
   184→			// Reload task to get updated notes
   185→			const updated = await fetchTask(panel.task._ulid);
   186→			panel.task = updated;
   187→			loadTasks();
   188→		} catch (err) {
   189→			// AC: @gh-pages-export ac-18 - Graceful error message
   190→			if (err instanceof ReadOnlyModeError) {
   191→				panelError = err.message;
   192→			} else {
   193→				panelError = err instanceof Error ? err.message : 'Failed to add note';
   194→			}
   195→		} finally {
   196→			isSubmitting = false;
   197→		}
   198→	}
   199→
   200→	function formatDate(dateStr: string): string {
   201→		const date = new Date(dateStr);
   202→		return new Intl.DateTimeFormat('en-US', {
   203→			year: 'numeric',
   204→			month: 'short',
   205→			day: 'numeric',
   206→			hour: '2-digit',
   207→			minute: '2-digit'
   208→		}).format(date);
   209→	}
   210→
   211→	function getStatusColor(status: string): string {
   212→		const colors: Record<string, string> = {
   213→			pending: 'bg-gray-500',
   214→			in_progress: 'bg-blue-500',
   215→			pending_review: 'bg-yellow-500',
   216→			blocked: 'bg-red-500',
   217→			completed: 'bg-green-500',
   218→			cancelled: 'bg-gray-400'
   219→		};
   220→		return colors[status] || 'bg-gray-500';
   221→	}
   222→
   223→	function formatStatus(status: string): string {
   224→		const labels: Record<string, string> = {
   225→			pending: 'Pending',
   226→			in_progress: 'In Progress',
   227→			pending_review: 'Pending Review',
   228→			blocked: 'Blocked',
   229→			completed: 'Completed',
   230→			cancelled: 'Cancelled'
   231→		};
   232→		return labels[status] || status;
   233→	}
   234→
   235→	// AC: @web-dashboard ac-33 - Handle WebSocket task updates
   236→	function handleTaskUpdate(event: BroadcastEvent) {
   237→		console.log('[TasksPage] Task update received:', event);
   238→
   239→		// Mark task as updated for highlight animation
   240→		if (event.data?.ulid) {
   241→			updatedTaskIds.add(event.data.ulid);
   242→			updatedTaskIds = new Set(updatedTaskIds);
   243→
   244→			// Remove highlight after 3s
   245→			setTimeout(() => {
   246→				updatedTaskIds.delete(event.data.ulid);
   247→				updatedTaskIds = new Set(updatedTaskIds);
   248→			}, 3000);
   249→		}
   250→
   251→		// Reload tasks list
   252→		loadTasks();
   253→
   254→		// Reload selected task if it's the one that updated
   255→		if (panel.task && event.data?.ulid === panel.task._ulid) {
   256→			fetchTask(panel.task._ulid)
   257→				.then((updated) => {
   258→					panel.task = updated;
   259→				})
   260→				.catch((err) => {
   261→					console.error('Error reloading task:', err);
   262→				});
   263→		}
   264→	}
   265→
   266→	onMount(() => {
   267→		loadTasks();
   268→
   269→		// AC: @web-dashboard ac-32, ac-33 - Subscribe to task updates
   270→		subscribe(['tasks']);
   271→		on('tasks', handleTaskUpdate);
   272→	});
   273→
   274→	onDestroy(() => {
   275→		// Clean up subscription
   276→		off('tasks', handleTaskUpdate);
   277→		unsubscribe(['tasks']);
   278→	});
   279→</script>
   280→
   281→<svelte:window onkeydown={handleKeydown} />
   282→
   283→<div class="flex flex-col gap-6 p-6">
   284→	<div class="flex items-center justify-between">
   285→		<div>
   286→			<h1 class="text-3xl font-bold mb-2">Tasks</h1>
   287→			{#if !loading}
   288→				<p class="text-muted-foreground">
   289→					Showing {tasks.length} of {total} tasks
   290→				</p>
   291→			{/if}
   292→		</div>
   293→		<!-- View toggle -->
   294→		<div class="flex items-center gap-1 border rounded-lg p-0.5">
   295→			<a href="{base}/tasks/board" title="Board view">
   296→				<Button variant="ghost" size="icon-sm" aria-pressed="false">
   297→					<LayoutGrid class="size-4" />
   298→				</Button>
   299→			</a>
   300→			<Button
   301→				variant="ghost"
   302→				size="icon-sm"
   303→				class="bg-accent"
   304→				title="List view"
   305→				aria-pressed="true"
   306→			>
   307→				<ListIcon class="size-4" />
   308→			</Button>
   309→		</div>
   310→	</div>
   311→
   312→	<TaskFilters />
   313→
   314→	{#if error}
   315→		<div class="bg-destructive/10 text-destructive p-4 rounded-lg" data-testid="error-message" role="alert">
   316→			{error}
   317→		</div>
   318→	{/if}
   319→
   320→	{#if loading}
   321→		<div class="flex justify-center items-center py-12">
   322→			<p class="text-muted-foreground">Loading tasks...</p>
   323→		</div>
   324→	{:else}
   325→		<!-- AC: @web-dashboard ac-33 -->
   326→		<TaskList {tasks} {updatedTaskIds} onSelectTask={handleSelectTask} on:select={handleSelectTaskEvent} />
   327→	{/if}
   328→</div>
   329→
   330→<!-- Inline Task Detail Panel - AC: @web-dashboard ac-5, ac-6, ac-7, ac-8 -->
   331→{#if panel.open && panel.task}
   332→	<div
   333→		class="fixed inset-0 z-50 bg-black/50"
   334→		onclick={handleOverlayClick}
   335→		onkeydown={(e) => e.key === 'Enter' && handleCloseDetail()}
   336→		role="button"
   337→		tabindex="-1"
   338→		aria-label="Close panel"
   339→	>
   340→		<!-- Panel -->
   341→		<div
   342→			class="fixed inset-y-0 right-0 z-50 w-3/4 max-w-lg bg-background shadow-lg border-l overflow-y-auto"
   343→			data-testid="task-detail-panel"
   344→			role="dialog"
   345→			aria-modal="true"
   346→			tabindex="0"
   347→			onclick={(e) => e.stopPropagation()}
   348→			onkeydown={(e) => e.stopPropagation()}
   349→		>
   350→			<!-- Header -->
   351→			<div class="flex items-center justify-between p-6 border-b">
   352→				<h2 class="text-lg font-semibold" data-testid="task-description">{panel.task.title}</h2>
   353→				<button
   354→					onclick={handleCloseDetail}
   355→					class="rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
   356→				>
   357→					<XIcon class="size-4" />
   358→					<span class="sr-only">Close</span>
   359→				</button>
   360→			</div>
   361→
   362→			<!-- Content -->
   363→			<div class="flex flex-col gap-4 p-6">
   364→				<!-- Status and Priority -->
   365→				<div class="flex gap-2 items-center">
   366→					<Badge data-testid="task-status-badge" class={getStatusColor(panel.task.status)}>{formatStatus(panel.task.status)}</Badge>
   367→					<Badge variant="outline">Priority: {panel.task.priority}</Badge>
   368→					{#if panel.task.type !== 'task'}
   369→						<Badge variant="outline">{panel.task.type}</Badge>
   370→					{/if}
   371→				</div>
   372→
   373→				<!-- Spec Reference -->
   374→				<!-- AC: @web-dashboard ac-6 -->
   375→				{#if panel.task.spec_ref}
   376→					<div data-testid="task-spec-ref-link">
   377→						<p class="text-sm font-medium mb-1">Spec Reference:</p>
   378→						<a
   379→							href="{base}/specs?ref={encodeURIComponent(panel.task.spec_ref)}"
   380→							class="text-sm text-primary hover:underline"
   381→						>
   382→							{panel.task.spec_ref}
   383→						</a>
   384→					</div>
   385→				{/if}
   386→
   387→				<!-- Tags -->
   388→				{#if panel.task.tags?.length > 0}
   389→					<div>
   390→						<p class="text-sm font-medium mb-1">Tags:</p>
   391→						<div class="flex flex-wrap gap-1">
   392→							{#each panel.task.tags as tag}
   393→								<Badge variant="secondary">{tag}</Badge>
   394→							{/each}
   395→						</div>
   396→					</div>
   397→				{/if}
   398→
   399→				<!-- Dependencies -->
   400→				<div data-testid="task-dependencies">
   401→					{#if panel.task.depends_on?.length > 0}
   402→						<p class="text-sm font-medium mb-1">Dependencies:</p>
   403→						<ul class="text-sm space-y-1">
   404→							{#each panel.task.depends_on as dep}
   405→								<li>
   406→									<a href="{base}/tasks?ref={encodeURIComponent(dep)}" class="text-primary hover:underline">
   407→										{dep}
   408→									</a>
   409→								</li>
   410→							{/each}
   411→						</ul>
   412→					{:else}
   413→						<p class="text-sm text-muted-foreground">No dependencies</p>
   414→					{/if}
   415→				</div>
   416→
   417→				<!-- Blocked By -->
   418→				{#if panel.task.blocked_by?.length > 0}
   419→					<div>
   420→						<p class="text-sm font-medium mb-1 text-destructive">Blocked By:</p>
   421→						<ul class="text-sm space-y-1">
   422→							{#each panel.task.blocked_by as blocker}
   423→								<li class="text-muted-foreground">{blocker}</li>
   424→							{/each}
   425→						</ul>
   426→					</div>
   427→				{/if}
   428→
   429→				<Separator />
   430→
   431→				<!-- Actions -->
   432→				<!-- AC: @web-dashboard ac-7 -->
   433→				<!-- AC: @gh-pages-export ac-16 - Disabled with tooltip in static mode -->
   434→				{#if panel.task.status === 'pending'}
   435→					<div>
   436→						{#if isStaticMode()}
   437→							<Tooltip.Root>
   438→								<Tooltip.Trigger>
   439→									{#snippet child({ props })}
   440→										<Button
   441→											{...props}
   442→											data-testid="start-task-button"
   443→											disabled={true}
   444→											class="w-full"
   445→										>
   446→											Start Task
   447→										</Button>
   448→									{/snippet}
   449→								</Tooltip.Trigger>
   450→								<Tooltip.Content>
   451→									<p>Read-only mode - use CLI to start task</p>
   452→								</Tooltip.Content>
   453→							</Tooltip.Root>
   454→						{:else}
   455→							<Button data-testid="start-task-button" onclick={handleStartTask} disabled={isSubmitting} class="w-full">
   456→								{isSubmitting ? 'Starting...' : 'Start Task'}
   457→							</Button>
   458→						{/if}
   459→					</div>
   460→				{/if}
   461→
   462→				{#if panelError}
   463→					<p class="text-sm text-destructive">{panelError}</p>
   464→				{/if}
   465→
   466→				<Separator />
   467→
   468→				<!-- Todos -->
   469→				<div data-testid="task-todos">
   470→					{#if panel.task.todos && panel.task.todos.length > 0}
   471→						<p class="text-sm font-medium mb-2">Todos:</p>
   472→						<ul class="space-y-2">
   473→							{#each panel.task.todos as todo}
   474→								<li class="flex items-start gap-2 text-sm">
   475→									<span class="mt-0.5">
   476→										{#if todo.status === 'completed'}
   477→											✅
   478→										{:else if todo.status === 'in_progress'}
   479→											⏳
   480→										{:else}
   481→											⏸️
   482→										{/if}
   483→									</span>
   484→									<span class:line-through={todo.status === 'completed'}>
   485→										{todo.content}
   486→									</span>
   487→								</li>
   488→							{/each}
   489→						</ul>
   490→					{:else}
   491→						<p class="text-sm text-muted-foreground">No todos</p>
   492→					{/if}
   493→				</div>
   494→
   495→				<Separator />
   496→
   497→				<!-- Notes -->
   498→				<!-- AC: @web-dashboard ac-5 -->
   499→				<div data-testid="task-notes">
   500→					<p class="text-sm font-medium mb-2">Notes ({panel.task.notes?.length ?? 0}):</p>
   501→
   502→					<!-- Add Note Form -->
   503→					<!-- AC: @web-dashboard ac-8 -->
   504→					<!-- AC: @gh-pages-export ac-18 - Disabled in static mode -->
   505→					{#if !isStaticMode()}
   506→						<div class="mb-4 space-y-2" data-testid="add-note-form">
   507→							<Textarea
   508→								placeholder="Add a note..."
   509→								bind:value={noteContent}
   510→								disabled={isSubmitting}
   511→								rows={3}
   512→								data-testid="note-textarea"
   513→							/>
   514→							<Button
   515→								onclick={handleAddNote}
   516→								disabled={isSubmitting || !noteContent.trim()}
   517→								size="sm"
   518→								data-testid="add-note-button"
   519→							>
   520→								{isSubmitting ? 'Adding...' : 'Add Note'}
   521→							</Button>
   522→						</div>
   523→					{/if}
   524→
   525→					<!-- Notes List -->
   526→					<div class="space-y-4" data-testid="task-notes-list">
   527→						{#each panel.task.notes ?? [] as note}
   528→							<div class="border rounded-lg p-3" data-testid="note-item">
   529→								<div class="flex justify-between items-start mb-2">
   530→									<span class="text-xs text-muted-foreground">{note.author}</span>
   531→									<span class="text-xs text-muted-foreground" data-testid="note-timestamp">{formatDate(note.created_at)}</span>
   532→								</div>
   533→								<p class="text-sm whitespace-pre-wrap">{note.content}</p>
   534→							</div>
   535→						{/each}
   536→					</div>
   537→				</div>
   538→			</div>
   539→		</div>
   540→	</div>
   541→{/if}
   542→
```