);\ntests/cli/session-start-activity-timeline.test.ts:165:      expect(commit!.task_refs).toContain('task-ref-check');\ntests/cli/session-start-activity-timeline.test.ts:172:      // Create a task completed \"earlier\"\ntests/cli/session-start-activity-timeline.test.ts:176:      kspec('task complete @task-earlier --reason \"Done first\"', tempDir);\ntests/cli/session-start-activity-timeline.test.ts:178:      // Create a commit with a future date to guarantee different timestamps\ntests/cli/session-start-activity-timeline.test.ts:182:      git('commit -m \"feat: later commit\" --date=\"2099-01-01T00:00:00Z\"', tempDir);\ntests/cli/session-start-activity-timeline.test.ts:186:      // Should have at least 2 items (task + commit)\ntests/cli/session-start-activity-timeline.test.ts:196:      // The commit with future date should be first\ntests/cli/session-start-activity-timeline.test.ts:197:      expect(session.activity_timeline[0].type).toBe('commit');\ntests/cli/session-start-activity-timeline.test.ts:198:      expect(session.activity_timeline[0].commit!.message).toBe('feat: later commit');\ntests/cli/session-start-activity-timeline.test.ts:204:    it('should show linked commit+task as single combined entry, not two separate entries', () => {\ntests/cli/session-start-activity-timeline.test.ts:208:      kspec('task complete @task-dedup --reason \"Dedup done\"', tempDir);\ntests/cli/session-start-activity-timeline.test.ts:212:      git('commit -m \"feat: dedup feature\" -m \"Task: @task-dedup\"', tempDir);\ntests/cli/session-start-activity-timeline.test.ts:216:      // Should have exactly one linked_commit entry for this task\ntests/cli/session-start-activity-timeline.test.ts:218:        (i) => i.type === 'linked_commit' && i.task?.title === 'Dedup task',\ntests/cli/session-start-activity-timeline.test.ts:228:      // The commit should NOT appear as a separate commit entry\ntests/cli/session-start-activity-timeline.test.ts:229:      const commitOnlyEntries = session.acti