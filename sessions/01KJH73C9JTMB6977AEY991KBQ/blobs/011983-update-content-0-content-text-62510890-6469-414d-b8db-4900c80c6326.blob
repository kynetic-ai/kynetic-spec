    "title": "Design spec-implementation alignment system",
    "type": "spike",
    "spec_ref": null,
    "status": "completed",
    "blocked_by": [],
    "closed_reason": "Implemented alignment system: AlignmentIndex, auto-sync, validation, item status command",
