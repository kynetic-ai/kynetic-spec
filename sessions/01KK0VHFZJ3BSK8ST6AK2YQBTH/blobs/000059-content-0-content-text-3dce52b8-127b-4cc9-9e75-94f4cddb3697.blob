     1→/**
     2→ * E2E Tests for Validation and Alignment View
     3→ *
     4→ * Tests verify the /validate page renders validation summary, alignment stats,
     5→ * and issues list grouped by severity.
     6→ *
     7→ * Covered ACs:
     8→ * - @ui-validation-view ac-1: Summary shows error count, warning count, valid item count.
     9→ *   Alignment section shows spec coverage %, AC coverage %, orphaned tasks/specs counts.
    10→ *   Issues list grouped by severity.
    11→ */
    12→
    13→import { test, expect } from '../fixtures/test-base';
    14→
    15→/** Mock validation response with issues. */
    16→function mockValidationWithIssues() {
    17→	return {
    18→		valid: false,
    19→		schemaErrors: [
    20→			{
    21→				file: 'modules/broken.yaml',
    22→				path: 'features[0]',
    23→				message: 'Invalid schema: missing required field "title"'
    24→			}
    25→		],
    26→		refErrors: [
    27→			{
    28→				ref: '@nonexistent',
    29→				sourceFile: 'modules/core.yaml',
    30→				field: 'spec_ref',
    31→				error: 'not_found',
    32→				message: 'Reference @nonexistent not found'
    33→			}
    34→		],
    35→		refWarnings: [
    36→			{
    37→				ref: '@deprecated-item',
    38→				sourceFile: 'modules/core.yaml',
    39→				field: 'implements',
    40→				warning: 'deprecated_target',
    41→				message: 'Reference @deprecated-item targets a deprecated item'
    42→			}
    43→		],
    44→		orphans: [
    45→			{
    46→				ulid: '01KTEST000000000ORPHAN0001',
    47→				title: 'Orphan requirement',
    48→				type: 'requirement',
    49→				file: 'modules/orphan.yaml'
    50→			}
    51→		],
    52→		completenessWarnings: [
    53→			{
    54→				type: 'missing_acceptance_criteria',
    55→				itemRef: '@some-feature',
    56→				itemTitle: 'Some Feature',
    57→				message: 'Item @some-feature has no acceptance criteria'
    58→			},
    59→			{
    60→				type: 'missing_test_coverage',
    61→				subtype: 'own_ac',
    62→				itemRef: '@test-feature',
    63→				itemTitle: 'Test Feature',
    64→				message: 'Item @test-feature has 1 AC(s) without test coverage',
    65→				details: 'Uncovered: ac-2'
    66→			}
    67→		],
    68→		traitCycles: []
    69→	};
    70→}
    71→
    72→/** Mock validation response with no issues. */
    73→function mockValidationClean() {
    74→	return {
    75→		valid: true,
    76→		schemaErrors: [],
    77→		refErrors: [],
    78→		refWarnings: [],
    79→		orphans: [],
    80→		completenessWarnings: [],
    81→		traitCycles: []
    82→	};
    83→}
    84→
    85→/** Mock alignment response. */
    86→function mockAlignment() {
    87→	return {
    88→		stats: {
    89→			totalSpecs: 10,
    90→			specsWithTasks: 7,
    91→			alignedSpecs: 5,
    92→			orphanedSpecs: 3
    93→		},
    94→		warnings: [
    95→			{
    96→				type: 'orphaned_spec',
    97→				specUlid: '01KTEST000000000ORPHSPEC01',
    98→				specTitle: 'Unimplemented Feature',
    99→				message: 'Spec item "Unimplemented Feature" has no implementing tasks'
   100→			},
   101→			{
   102→				type: 'status_mismatch',
   103→				specUlid: '01KTEST000000000MISMATCH1',
   104→				specTitle: 'Misaligned Feature',
   105→				message:
   106→					'Spec "Misaligned Feature" status is "not_started" but should be "in_progress"'
   107→			}
   108→		]
   109→	};
   110→}
   111→
   112→/** Mock items response (for total count). */
   113→function mockItems() {
   114→	return {
   115→		items: [{ _ulid: '01KTEST000000000000ITEM001', title: 'Item 1' }],
   116→		total: 10,
   117→		offset: 0,
   118→		limit: 1
   119→	};
   120→}
   121→
   122→/** Mock tasks response (for orphaned task count). */
   123→function mockTasks() {
   124→	return {
   125→		items: [
   126→			{
   127→				_ulid: '01KTEST000000000000TASK001',
   128→				title: 'Task with spec',
   129→				status: 'pending',
   130→				priority: 2,
   131→				spec_ref: '@test-feature',
   132→				tags: [],
   133→				depends_on: [],
   134→				created_at: '2026-01-01T00:00:00Z',
   135→				notes_count: 0
   136→			},
   137→			{
   138→				_ulid: '01KTEST000000000000TASK002',
   139→				title: 'Task without spec',
   140→				status: 'in_progress',
   141→				priority: 3,
   142→				tags: [],
   143→				depends_on: [],
   144→				created_at: '2026-01-01T00:00:00Z',
   145→				notes_count: 0
   146→			},
   147→			{
   148→				_ulid: '01KTEST000000000000TASK003',
   149→				title: 'Another orphan task',
   150→				status: 'pending',
   151→				priority: 1,
   152→				tags: [],
   153→				depends_on: [],
   154→				created_at: '2026-01-01T00:00:00Z',
   155→				notes_count: 0
   156→			}
   157→		],
   158→		total: 3,
   159→		offset: 0,
   160→		limit: 999
   161→	};
   162→}
   163→
   164→/** Register all route mocks for the validate page. */
   165→async function setupValidateRoutes(
   166→	page: import('@playwright/test').Page,
   167→	options?: {
   168→		validation?: ReturnType<typeof mockValidationWithIssues>;
   169→		alignment?: ReturnType<typeof mockAlignment>;
   170→		items?: ReturnType<typeof mockItems>;
   171→		tasks?: ReturnType<typeof mockTasks>;
   172→	}
   173→) {
   174→	const validationData = options?.validation ?? mockValidationWithIssues();
   175→	const alignmentData = options?.alignment ?? mockAlignment();
   176→	const itemsData = options?.items ?? mockItems();
   177→	const tasksData = options?.tasks ?? mockTasks();
   178→
   179→	await page.route('**/api/validate', (route) => {
   180→		route.fulfill({
   181→			status: 200,
   182→			contentType: 'application/json',
   183→			body: JSON.stringify(validationData)
   184→		});
   185→	});
   186→
   187→	await page.route('**/api/alignment', (route) => {
   188→		route.fulfill({
   189→			status: 200,
   190→			contentType: 'application/json',
   191→			body: JSON.stringify(alignmentData)
   192→		});
   193→	});
   194→
   195→	await page.route('**/api/items?*', (route) => {
   196→		route.fulfill({
   197→			status: 200,
   198→			contentType: 'application/json',
   199→			body: JSON.stringify(itemsData)
   200→		});
   201→	});
   202→
   203→	await page.route('**/api/tasks?*', (route) => {
   204→		route.fulfill({
   205→			status: 200,
   206→			contentType: 'application/json',
   207→			body: JSON.stringify(tasksData)
   208→		});
   209→	});
   210→}
   211→
   212→test.describe('Validation and Alignment View', () => {
   213→	test.describe('Summary Cards (AC-1)', () => {
   214→		// AC: @ui-validation-view ac-1
   215→		test('displays error count, warning count, and valid item count', async ({
   216→			page,
   217→			daemon
   218→		}) => {
   219→			await setupValidateRoutes(page);
   220→			await page.goto('/validate');
   221→
   222→			// Wait for data to load
   223→			await expect(page.getByTestId('summary-cards')).toBeVisible();
   224→
   225→			// Error count card
   226→			const errorCard = page.getByTestId('error-count-card');
   227→			await expect(errorCard).toBeVisible();
   228→			// 1 schemaError + 1 refError + 0 traitCycles = 2 errors
   229→			await expect(errorCard).toContainText('2');
   230→			await expect(errorCard).toContainText('Errors');
   231→
   232→			// Warning count card
   233→			const warningCard = page.getByTestId('warning-count-card');
   234→			await expect(warningCard).toBeVisible();
   235→			// 1 refWarning + 2 completenessWarnings + 1 orphan = 4 warnings
   236→			await expect(warningCard).toContainText('4');
   237→			await expect(warningCard).toContainText('Warnings');
   238→
   239→			// Valid items card
   240→			const validCard = page.getByTestId('valid-count-card');
   241→			await expect(validCard).toBeVisible();
   242→			await expect(validCard).toContainText('Valid Items');
   243→			// Valid items shown as count (total 10 items - 2 with errors = 8)
   244→			const validCount = page.getByTestId('valid-item-count');
   245→			await expect(validCount).toContainText('8');
   246→		});
   247→
   248→		// AC: @ui-validation-view ac-1
   249→		test('shows "Issues Found" badge when validation has errors', async ({
   250→			page,
   251→			daemon
   252→		}) => {
   253→			await setupValidateRoutes(page);
   254→			await page.goto('/validate');
   255→
   256→			await expect(page.getByTestId('status-invalid')).toBeVisible();
   257→			await expect(page.getByTestId('status-invalid')).toContainText('Issues Found');
   258→		});
   259→
   260→		// AC: @ui-validation-view ac-1
   261→		test('shows "Valid" badge when all checks pass', async ({ page, daemon }) => {
   262→			await setupValidateRoutes(page, { validation: mockValidationClean() });
   263→			await page.goto('/validate');
   264→
   265→			await expect(page.getByTestId('status-valid')).toBeVisible();
   266→			await expect(page.getByTestId('status-valid')).toContainText('Valid');
   267→		});
   268→	});
   269→
   270→	test.describe('Alignment Section (AC-1)', () => {
   271→		// AC: @ui-validation-view ac-1
   272→		test('shows spec coverage percentage', async ({ page, daemon }) => {
   273→			await setupValidateRoutes(page);
   274→			await page.goto('/validate');
   275→
   276→			const specCoverage = page.getByTestId('spec-coverage');
   277→			await expect(specCoverage).toBeVisible();
   278→			// 7/10 specs with tasks = 70%
   279→			await expect(specCoverage).toContainText('70%');
   280→			await expect(specCoverage).toContainText('Spec Coverage');
   281→		});
   282→
   283→		// AC: @ui-validation-view ac-1
   284→		test('shows AC coverage percentage', async ({ page, daemon }) => {
   285→			await setupValidateRoutes(page);
   286→			await page.goto('/validate');
   287→
   288→			const acCoverage = page.getByTestId('ac-coverage');
   289→			await expect(acCoverage).toBeVisible();
   290→			await expect(acCoverage).toContainText('AC Coverage');
   291→			// 10 total items, 1 with missing_test_coverage = 90%
   292→			await expect(acCoverage).toContainText('90%');
   293→		});
   294→
   295→		// AC: @ui-validation-view ac-1
   296→		test('shows orphaned tasks count', async ({ page, daemon }) => {
   297→			await setupValidateRoutes(page);
   298→			await page.goto('/validate');
   299→
   300→			const orphanedTasks = page.getByTestId('orphaned-tasks');
   301→			await expect(orphanedTasks).toBeVisible();
   302→			await expect(orphanedTasks).toContainText('Orphaned Tasks');
   303→			// 2 tasks without spec_ref
   304→			await expect(orphanedTasks).toContainText('2');
   305→		});
   306→
   307→		// AC: @ui-validation-view ac-1
   308→		test('shows orphaned specs count', async ({ page, daemon }) => {
   309→			await setupValidateRoutes(page);
   310→			await page.goto('/validate');
   311→
   312→			const orphanedSpecs = page.getByTestId('orphaned-specs');
   313→			await expect(orphanedSpecs).toBeVisible();
   314→			await expect(orphanedSpecs).toContainText('Orphaned Specs');
   315→			// 3 orphaned specs from alignment stats
   316→			await expect(orphanedSpecs).toContainText('3');
   317→		});
   318→	});
   319→
   320→	test.describe('Issues List (AC-1)', () => {
   321→		// AC: @ui-validation-view ac-1
   322→		test('shows issues grouped by severity', async ({ page, daemon }) => {
   323→			await setupValidateRoutes(page);
   324→			await page.goto('/validate');
   325→
   326→			const issuesList = page.getByTestId('issues-list');
   327→			await expect(issuesList).toBeVisible();
   328→
   329→			// Error issues group
   330→			const errorGroup = page.getByTestId('error-issues');
   331→			await expect(errorGroup).toBeVisible();
   332→			await expect(errorGroup).toContainText('Errors (2)');
   333→
   334→			// Warning issues group
   335→			const warningGroup = page.getByTestId('warning-issues');
   336→			await expect(warningGroup).toBeVisible();
   337→			// 1 refWarning + 2 completenessWarnings + 1 status_mismatch alignment = 4 warnings
   338→			await expect(warningGroup).toContainText('Warnings (4)');
   339→
   340→			// Info issues group
   341→			const infoGroup = page.getByTestId('info-issues');
   342→			await expect(infoGroup).toBeVisible();
   343→			// 1 orphan + 1 orphaned_spec alignment warning = 2 info
   344→			await expect(infoGroup).toContainText('Info (2)');
   345→		});
   346→
   347→		// AC: @ui-validation-view ac-1
   348→		test('error issues show category badge and message', async ({ page, daemon }) => {
   349→			await setupValidateRoutes(page);
   350→			await page.goto('/validate');
   351→
   352→			const errorIssues = page.getByTestId('issue-error');
   353→			await expect(errorIssues).toHaveCount(2);
   354→
   355→			// First error: schema error
   356→			const firstError = errorIssues.nth(0);
   357→			await expect(firstError).toContainText('Schema');
   358→			await expect(firstError).toContainText('Invalid schema');
   359→
   360→			// Second error: reference error
   361→			const secondError = errorIssues.nth(1);
   362→			await expect(secondError).toContainText('Reference');
   363→			await expect(secondError).toContainText('@nonexistent not found');
   364→		});
   365→
   366→		// AC: @ui-validation-view ac-1
   367→		test('shows no issues message when validation is clean', async ({ page, daemon }) => {
   368→			await setupValidateRoutes(page, {
   369→				validation: mockValidationClean(),
   370→				alignment: { stats: mockAlignment().stats, warnings: [] }
   371→			});
   372→			await page.goto('/validate');
   373→
   374→			const noIssues = page.getByTestId('no-issues');
   375→			await expect(noIssues).toBeVisible();
   376→			await expect(noIssues).toContainText('No issues found');
   377→		});
   378→	});
   379→
   380→	test.describe('Loading State', () => {
   381→		test('shows loading skeleton while fetching', async ({ page, daemon }) => {
   382→			// Delay the response to observe loading state
   383→			await page.route('**/api/validate', async (route) => {
   384→				await new Promise((r) => setTimeout(r, 500));
   385→				route.fulfill({
   386→					status: 200,
   387→					contentType: 'application/json',
   388→					body: JSON.stringify(mockValidationClean())
   389→				});
   390→			});
   391→			await page.route('**/api/alignment', (route) => {
   392→				route.fulfill({
   393→					status: 200,
   394→					contentType: 'application/json',
   395→					body: JSON.stringify(mockAlignment())
   396→				});
   397→			});
   398→			await page.route('**/api/items?*', (route) => {
   399→				route.fulfill({
   400→					status: 200,
   401→					contentType: 'application/json',
   402→					body: JSON.stringify(mockItems())
   403→				});
   404→			});
   405→			await page.route('**/api/tasks?*', (route) => {
   406→				route.fulfill({
   407→					status: 200,
   408→					contentType: 'application/json',
   409→					body: JSON.stringify(mockTasks())
   410→				});
   411→			});
   412→
   413→			await page.goto('/validate');
   414→
   415→			const skeleton = page.getByTestId('loading');
   416→			await expect(skeleton).toBeVisible();
   417→
   418→			// Eventually loads
   419→			await expect(page.getByTestId('summary-cards')).toBeVisible({ timeout: 5000 });
   420→		});
   421→	});
   422→
