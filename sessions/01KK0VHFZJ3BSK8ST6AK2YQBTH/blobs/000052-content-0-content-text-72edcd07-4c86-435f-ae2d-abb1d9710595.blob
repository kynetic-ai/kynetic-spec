```
     1→<script lang="ts">
     2→	// AC: @ui-validation-view ac-1
     3→	import { onMount } from 'svelte';
     4→	import {
     5→		fetchValidation,
     6→		fetchAlignment,
     7→		fetchItems,
     8→		fetchTasks,
     9→		type ValidationResponse,
    10→		type AlignmentResponse
    11→	} from '$lib/api';
    12→	import { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';
    13→	import { Badge } from '$lib/components/ui/badge';
    14→	import {
    15→		ShieldCheck,
    16→		ShieldAlert,
    17→		AlertTriangle,
    18→		AlertCircle,
    19→		CheckCircle2,
    20→		Info,
    21→		Link2Off,
    22→		FileWarning,
    23→		RefreshCw
    24→	} from 'lucide-svelte';
    25→	import { getProjectVersion } from '$lib/stores/project.svelte';
    26→
    27→	// --- State ---
    28→
    29→	let validation = $state<ValidationResponse | null>(null);
    30→	let alignment = $state<AlignmentResponse | null>(null);
    31→	let totalItemCount = $state(0);
    32→	let orphanedTaskCount = $state(0);
    33→	let loading = $state(true);
    34→	let error = $state('');
    35→
    36→	// --- Derived counts ---
    37→	// AC: @ui-validation-view ac-1 — error count, warning count, valid item count
    38→
    39→	let errorCount = $derived.by(() => {
    40→		if (!validation) return 0;
    41→		return (
    42→			validation.schemaErrors.length +
    43→			validation.refErrors.length +
    44→			validation.traitCycles.length
    45→		);
    46→	});
    47→
    48→	let warningCount = $derived.by(() => {
    49→		if (!validation) return 0;
    50→		return (
    51→			validation.refWarnings.length +
    52→			validation.completenessWarnings.length +
    53→			validation.orphans.length
    54→		);
    55→	});
    56→
    57→	// AC: @ui-validation-view ac-1 — valid item count
    58→	// Count unique items that have errors, subtract from total
    59→	let validItemCount = $derived.by(() => {
    60→		if (!validation) return 0;
    61→		const itemsWithErrors = new Set<string>();
    62→		for (const e of validation.schemaErrors) {
    63→			if (e.file) itemsWithErrors.add(e.file);
    64→		}
    65→		for (const e of validation.refErrors) {
    66→			if (e.ref) itemsWithErrors.add(e.ref);
    67→		}
    68→		for (const e of validation.traitCycles) {
    69→			if (e.traitRef) itemsWithErrors.add(e.traitRef);
    70→		}
    71→		return Math.max(0, totalItemCount - itemsWithErrors.size);
    72→	});
    73→
    74→	// AC: @ui-validation-view ac-1 — spec coverage %, AC coverage %
    75→	let specCoverage = $derived.by(() => {
    76→		if (!alignment || alignment.stats.totalSpecs === 0) return 0;
    77→		return Math.round(
    78→			(alignment.stats.specsWithTasks / alignment.stats.totalSpecs) * 100
    79→		);
    80→	});
    81→
    82→	// AC: @ui-validation-view ac-1 — AC coverage %
    83→	// Computed from completeness warnings: items with missing_test_coverage
    84→	let acCoverage = $derived.by(() => {
    85→		if (!validation || totalItemCount === 0) return 0;
    86→		const itemsWithMissingCoverage = new Set<string>();
    87→		for (const w of validation.completenessWarnings) {
    88→			if (w.type === 'missing_test_coverage') {
    89→				itemsWithMissingCoverage.add(w.itemRef);
    90→			}
    91→		}
    92→		// Items with ACs that are fully covered = total items - items with missing coverage
    93→		// AC coverage % = covered items / total items that have ACs
    94→		// Since not all items have ACs, use totalItems as denominator for simplicity
    95→		const coveredItems = totalItemCount - itemsWithMissingCoverage.size;
    96→		return Math.round((coveredItems / totalItemCount) * 100);
    97→	});
    98→
    99→	// --- Group issues by severity ---
   100→
   101→	type GroupedIssue = {
   102→		severity: 'error' | 'warning' | 'info';
   103→		category: string;
   104→		message: string;
   105→		detail?: string;
   106→	};
   107→
   108→	let groupedIssues = $derived.by((): GroupedIssue[] => {
   109→		if (!validation && !alignment) return [];
   110→		const issues: GroupedIssue[] = [];
   111→
   112→		if (validation) {
   113→			for (const e of validation.schemaErrors) {
   114→				issues.push({
   115→					severity: 'error',
   116→					category: 'Schema',
   117→					message: e.message,
   118→					detail: e.file + (e.path ? ` (${e.path})` : '')
   119→				});
   120→			}
   121→			for (const e of validation.refErrors) {
   122→				issues.push({
   123→					severity: 'error',
   124→					category: 'Reference',
   125→					message: e.message,
   126→					detail: `${e.ref} in ${e.field}`
   127→				});
   128→			}
   129→			for (const e of validation.traitCycles) {
   130→				issues.push({
   131→					severity: 'error',
   132→					category: 'Trait Cycle',
   133→					message: e.message,
   134→					detail: e.cycle.join(' → ')
   135→				});
   136→			}
   137→			for (const w of validation.refWarnings) {
   138→				issues.push({
   139→					severity: 'warning',
   140→					category: 'Reference',
   141→					message: w.message,
   142→					detail: `${w.ref} in ${w.field}`
   143→				});
   144→			}
   145→			for (const w of validation.completenessWarnings) {
   146→				issues.push({
   147→					severity: 'warning',
   148→					category: completenessLabel(w.type),
   149→					message: w.message,
   150→					detail: w.details ?? `${w.itemRef} — ${w.itemTitle}`
   151→				});
   152→			}
   153→			for (const o of validation.orphans) {
   154→				issues.push({
   155→					severity: 'info',
   156→					category: 'Orphan',
   157→					message: `${o.title} (${o.type})`,
   158→					detail: o.file ?? o.ulid
   159→				});
   160→			}
   161→		}
   162→
   163→		if (alignment) {
   164→			for (const w of alignment.warnings) {
   165→				issues.push({
   166→					severity: w.type === 'status_mismatch' ? 'warning' : 'info',
   167→					category: alignmentLabel(w.type),
   168→					message: w.message,
   169→					detail: w.specTitle ?? w.specUlid
   170→				});
   171→			}
   172→		}
   173→
   174→		return issues;
   175→	});
   176→
   177→	let errorIssues = $derived(groupedIssues.filter((i) => i.severity === 'error'));
   178→	let warningIssues = $derived(groupedIssues.filter((i) => i.severity === 'warning'));
   179→	let infoIssues = $derived(groupedIssues.filter((i) => i.severity === 'info'));
   180→
   181→	// --- Lifecycle ---
   182→
   183→	onMount(async () => {
   184→		await loadData();
   185→	});
   186→
   187→	$effect(() => {
   188→		const version = getProjectVersion();
   189→		if (version > 0) {
   190→			loadData();
   191→		}
   192→	});
   193→
   194→	async function loadData() {
   195→		try {
   196→			loading = true;
   197→			error = '';
   198→			const [v, a, itemsRes, tasksRes] = await Promise.all([
   199→				fetchValidation(),
   200→				fetchAlignment(),
   201→				fetchItems({ limit: 1 }),
   202→				fetchTasks({ limit: 999 })
   203→			]);
   204→			validation = v;
   205→			alignment = a;
   206→			totalItemCount = itemsRes.total;
   207→			// Orphaned tasks = tasks without a spec_ref
   208→			orphanedTaskCount = tasksRes.items.filter((t) => !t.spec_ref).length;
   209→		} catch (err) {
   210→			error = err instanceof Error ? err.message : 'Failed to load validation data';
   211→		} finally {
   212→			loading = false;
   213→		}
   214→	}
   215→
   216→	// --- Helpers ---
   217→
   218→	function completenessLabel(type: string): string {
   219→		const labels: Record<string, string> = {
   220→			missing_acceptance_criteria: 'Missing AC',
   221→			missing_description: 'Missing Description',
   222→			status_inconsistency: 'Status Inconsistency',
   223→			missing_test_coverage: 'Test Coverage',
   224→			automation_eligible_no_spec: 'No Spec',
   225→			ac_schema_field_mismatch: 'AC Schema Mismatch'
   226→		};
   227→		return labels[type] ?? type;
   228→	}
   229→
   230→	function alignmentLabel(type: string): string {
   231→		const labels: Record<string, string> = {
   232→			orphaned_spec: 'Orphaned Spec',
   233→			status_mismatch: 'Status Mismatch',
   234→			stale_implementation: 'Stale Implementation'
   235→		};
   236→		return labels[type] ?? type;
   237→	}
   238→</script>
   239→
   240→<!-- AC: @ui-validation-view ac-1 -->
   241→<div class="flex flex-col gap-6" data-testid="validate-page">
   242→	<div class="flex items-center justify-between">
   243→		<div class="flex items-center gap-3">
   244→			<h1 class="text-3xl font-bold">Validate</h1>
   245→			{#if !loading && validation}
   246→				{#if validation.valid && errorCount === 0}
   247→					<Badge class="bg-severity-success text-severity-success-fg" data-testid="status-valid">
   248→						<CheckCircle2 class="mr-1 h-3 w-3" />
   249→						Valid
   250→					</Badge>
   251→				{:else}
   252→					<Badge class="bg-severity-error text-severity-error-fg" data-testid="status-invalid">
   253→						<ShieldAlert class="mr-1 h-3 w-3" />
   254→						Issues Found
   255→					</Badge>
   256→				{/if}
   257→			{/if}
   258→		</div>
   259→		{#if !loading}
   260→			<button
   261→				class="inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm
   262→					text-muted-foreground transition-colors hover:bg-muted/50"
   263→				onclick={loadData}
   264→				data-testid="refresh-btn"
   265→			>
   266→				<RefreshCw class="h-3.5 w-3.5" />
   267→				Refresh
   268→			</button>
   269→		{/if}
   270→	</div>
   271→
   272→	<!-- Error banner -->
   273→	{#if error}
   274→		<div
   275→			class="rounded-md bg-severity-error-muted p-4 text-sm text-severity-error-muted-fg"
   276→			role="alert"
   277→			data-testid="error"
   278→		>
   279→			{error}
   280→		</div>
   281→	{/if}
   282→
   283→	<!-- Loading state -->
   284→	{#if loading}
   285→		<div class="space-y-4" data-testid="loading">
   286→			<div class="grid gap-4 md:grid-cols-3">
   287→				{#each Array(3) as _}
   288→					<Card>
   289→						<CardHeader class="pb-2">
   290→							<div class="h-4 w-24 animate-pulse rounded bg-muted"></div>
   291→						</CardHeader>
   292→						<CardContent>
   293→							<div class="h-8 w-16 animate-pulse rounded bg-muted"></div>
   294→						</CardContent>
   295→					</Card>
   296→				{/each}
   297→			</div>
   298→			<Card>
   299→				<CardHeader class="pb-2">
   300→					<div class="h-4 w-32 animate-pulse rounded bg-muted"></div>
   301→				</CardHeader>
   302→				<CardContent class="space-y-3">
   303→					{#each Array(3) as _}
   304→						<div class="h-4 w-full animate-pulse rounded bg-muted"></div>
   305→					{/each}
   306→				</CardContent>
   307→			</Card>
   308→		</div>
   309→
   310→	<!-- Empty state (no data returned) -->
   311→	{:else if !validation && !alignment && !error}
   312→		<div class="text-center text-muted-foreground py-12" data-testid="empty">
   313→			<ShieldCheck class="mx-auto h-12 w-12 mb-4 opacity-50" />
   314→			<p>No validation data available.</p>
   315→			<p class="text-sm">Connect to a running daemon to run validation.</p>
   316→		</div>
   317→
   318→	<!-- Data loaded -->
   319→	{:else}
   320→		<!-- Summary Cards -->
   321→		<!-- AC: @ui-validation-view ac-1 — error count, warning count, valid item count -->
   322→		<div class="grid gap-4 md:grid-cols-3" data-testid="summary-cards">
   323→			<Card data-testid="error-count-card">
   324→				<CardHeader class="flex flex-row items-center justify-between pb-2 space-y-0">
   325→					<CardTitle class="text-sm font-medium">Errors</CardTitle>
   326→					<AlertCircle class="h-4 w-4 text-severity-error" />
   327→				</CardHeader>
   328→				<CardContent>
   329→					<div class="text-2xl font-bold" class:text-severity-error={errorCount > 0}>
   330→						{errorCount}
   331→					</div>
   332→					<p class="text-xs text-muted-foreground">
   333→						Schema, reference, and trait cycle errors
   334→					</p>
   335→				</CardContent>
   336→			</Card>
   337→
   338→			<Card data-testid="warning-count-card">
   339→				<CardHeader class="flex flex-row items-center justify-between pb-2 space-y-0">
   340→					<CardTitle class="text-sm font-medium">Warnings</CardTitle>
   341→					<AlertTriangle class="h-4 w-4 text-severity-warning" />
   342→				</CardHeader>
   343→				<CardContent>
   344→					<div class="text-2xl font-bold" class:text-severity-warning={warningCount > 0}>
   345→						{warningCount}
   346→					</div>
   347→					<p class="text-xs text-muted-foreground">
   348→						Completeness, orphans, and reference warnings
   349→					</p>
   350→				</CardContent>
   351→			</Card>
   352→
   353→			<Card data-testid="valid-count-card">
   354→				<CardHeader class="flex flex-row items-center justify-between pb-2 space-y-0">
   355→					<CardTitle class="text-sm font-medium">Valid Items</CardTitle>
   356→					<CheckCircle2 class="h-4 w-4 text-severity-success" />
   357→				</CardHeader>
   358→				<CardContent>
   359→					<div class="text-2xl font-bold" data-testid="valid-item-count">
   360→						{validItemCount}
   361→					</div>
   362→					<p class="text-xs text-muted-foreground">
   363→						{validItemCount} of {totalItemCount} items passing validation
   364→					</p>
   365→				</CardContent>
   366→			</Card>
   367→		</div>
   368→
   369→		<!-- Alignment Section -->
   370→		<!-- AC: @ui-validation-view ac-1 — spec coverage %, AC coverage %, orphaned tasks/specs counts -->
   371→		{#if alignment}
   372→			<Card data-testid="alignment-section">
   373→				<CardHeader>
   374→					<CardTitle class="flex items-center gap-2">
   375→						<Link2Off class="h-5 w-5" />
   376→						Alignment
   377→					</CardTitle>
   378→				</CardHeader>
   379→				<CardContent>
   380→					<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
   381→						<div class="space-y-1" data-testid="spec-coverage">
   382→							<p class="text-sm text-muted-foreground">Spec Coverage</p>
   383→							<div class="flex items-baseline gap-2">
   384→								<span class="text-2xl font-bold">{specCoverage}%</span>
   385→								<span class="text-xs text-muted-foreground">
   386→									{alignment.stats.specsWithTasks}/{alignment.stats.totalSpecs} specs with tasks
   387→								</span>
   388→							</div>
   389→							<div class="h-2 w-full rounded-full bg-muted overflow-hidden">
   390→								<div
   391→									class="h-full rounded-full transition-all bg-severity-success"
   392→									style="width: {specCoverage}%"
   393→								></div>
   394→							</div>
   395→						</div>
   396→
   397→						<div class="space-y-1" data-testid="ac-coverage">
   398→							<p class="text-sm text-muted-foreground">AC Coverage</p>
   399→							<div class="flex items-baseline gap-2">
   400→								<span class="text-2xl font-bold">{acCoverage}%</span>
   401→								<span class="text-xs text-muted-foreground">
   402→									items with test coverage
   403→								</span>
   404→							</div>
   405→							<div class="h-2 w-full rounded-full bg-muted overflow-hidden">
   406→								<div
   407→									class="h-full rounded-full transition-all bg-severity-info"
   408→									style="width: {acCoverage}%"
   409→								></div>
   410→							</div>
   411→						</div>
   412→
   413→						<div class="space-y-1" data-testid="orphaned-tasks">
   414→							<p class="text-sm text-muted-foreground">Orphaned Tasks</p>
   415→							<div class="flex items-baseline gap-2">
   416→								<span class="text-2xl font-bold"
   417→									class:text-severity-warning={orphanedTaskCount > 0}
   418→								>
   419→									{orphanedTaskCount}
   420→								</span>
   421→								<span class="text-xs text-muted-foreground">
   422→									tasks without linked specs
   423→								</span>
   424→							</div>
   425→						</div>
   426→
   427→						<div class="space-y-1" data-testid="orphaned-specs">
   428→							<p class="text-sm text-muted-foreground">Orphaned Specs</p>
   429→							<div class="flex items-baseline gap-2">
   430→								<span class="text-2xl font-bold"
   431→									class:text-severity-warning={alignment.stats.orphanedSpecs > 0}
   432→								>
   433→									{alignment.stats.orphanedSpecs}
   434→								</span>
   435→								<span class="text-xs text-muted-foreground">
   436→									specs without linked tasks
   437→								</span>
   438→							</div>
   439→						</div>
   440→					</div>
   441→				</CardContent>
   442→			</Card>
   443→		{/if}
   444→
   445→		<!-- Issues List -->
   446→		<!-- AC: @ui-validation-view ac-1 — Issues list grouped by severity -->
   447→		{#if groupedIssues.length > 0}
   448→			<div class="space-y-4" data-testid="issues-list">
   449→				<h2 class="text-xl font-semibold flex items-center gap-2">
   450→					<FileWarning class="h-5 w-5" />
   451→					Issues ({groupedIssues.length})
   452→				</h2>
   453→
   454→				<!-- Errors group -->
   455→				{#if errorIssues.length > 0}
   456→					<div data-testid="error-issues">
   457→						<h3 class="text-sm font-medium text-severity-error mb-2 flex items-center gap-1.5">
   458→							<AlertCircle class="h-4 w-4" />
   459→							Errors ({errorIssues.length})
   460→						</h3>
   461→						<div class="space-y-2">
   462→							{#each errorIssues as issue}
   463→								<div class="rounded-md border p-3 bg-severity-error-muted border-severity-error-border" data-testid="issue-error">
   464→									<div class="flex items-start gap-2">
   465→										<AlertCircle class="h-4 w-4 mt-0.5 text-severity-error shrink-0" />
   466→										<div class="min-w-0">
   467→											<div class="flex items-center gap-2 flex-wrap">
   468→												<Badge variant="outline" class="text-xs">{issue.category}</Badge>
   469→												<span class="text-sm font-medium">{issue.message}</span>
   470→											</div>
   471→											{#if issue.detail}
   472→												<p class="text-xs text-muted-foreground mt-1 font-mono truncate">
   473→													{issue.detail}
   474→												</p>
   475→											{/if}
   476→										</div>
   477→									</div>
   478→								</div>
   479→							{/each}
   480→						</div>
   481→					</div>
   482→				{/if}
   483→
   484→				<!-- Warnings group -->
   485→				{#if warningIssues.length > 0}
   486→					<div data-testid="warning-issues">
   487→						<h3 class="text-sm font-medium text-severity-warning-muted-fg mb-2 flex items-center gap-1.5">
   488→							<AlertTriangle class="h-4 w-4" />
   489→							Warnings ({warningIssues.length})
   490→						</h3>
   491→						<div class="space-y-2">
   492→							{#each warningIssues as issue}
   493→								<div class="rounded-md border p-3 bg-severity-warning-muted border-severity-warning-border" data-testid="issue-warning">
   494→									<div class="flex items-start gap-2">
   495→										<AlertTriangle class="h-4 w-4 mt-0.5 text-severity-warning-muted-fg shrink-0" />
   496→										<div class="min-w-0">
   497→											<div class="flex items-center gap-2 flex-wrap">
   498→												<Badge variant="outline" class="text-xs">{issue.category}</Badge>
   499→												<span class="text-sm font-medium">{issue.message}</span>
   500→											</div>
   501→											{#if issue.detail}
   502→												<p class="text-xs text-muted-foreground mt-1 font-mono truncate">
   503→													{issue.detail}
   504→												</p>
   505→											{/if}
   506→										</div>
   507→									</div>
   508→								</div>
   509→							{/each}
   510→						</div>
   511→					</div>
   512→				{/if}
   513→
   514→				<!-- Info group -->
   515→				{#if infoIssues.length > 0}
   516→					<div data-testid="info-issues">
   517→						<h3 class="text-sm font-medium text-severity-info mb-2 flex items-center gap-1.5">
   518→							<Info class="h-4 w-4" />
   519→							Info ({infoIssues.length})
   520→						</h3>
   521→						<div class="space-y-2">
   522→							{#each infoIssues as issue}
   523→								<div class="rounded-md border p-3 bg-severity-info-muted border-severity-info-border" data-testid="issue-info">
   524→									<div class="flex items-start gap-2">
   525→										<Info class="h-4 w-4 mt-0.5 text-severity-info shrink-0" />
