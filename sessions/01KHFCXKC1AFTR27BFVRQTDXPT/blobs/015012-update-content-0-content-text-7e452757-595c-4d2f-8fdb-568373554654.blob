```
     1→/**
     2→ * Agent instruction generation commands.
     3→ *
     4→ * AC: @agent-instruction-gen ac-1 - kspec agents generate creates kspec-agents.md in project root
     5→ * AC: @agent-instruction-gen ac-2 - output includes Finding Information table with row per skill
     6→ * AC: @agent-instruction-gen ac-3 - output includes conventions section listing rules by domain
     7→ * AC: @agent-instruction-gen ac-4 - output contains freshness comment with kspec version and timestamp
     8→ * AC: @agent-instruction-gen ac-5 - kspec agents status reports stale when not regenerated after meta changes
     9→ */
    10→
    11→import * as crypto from "node:crypto";
    12→import * as fs from "node:fs/promises";
    13→import { createRequire } from "node:module";
    14→import * as path from "node:path";
    15→import chalk from "chalk";
    16→import type { Command } from "commander";
    17→import {
    18→  initContext,
    19→  loadMetaContext,
    20→  type LoadedConvention,
    21→  type LoadedSkill,
    22→  type LoadedWorkflow,
    23→} from "../../parser/index.js";
    24→import { errors } from "../../strings/errors.js";
    25→import { EXIT_CODES } from "../exit-codes.js";
    26→import { error, output, success } from "../output.js";
    27→
    28→// Read version from package.json at runtime
    29→const require = createRequire(import.meta.url);
    30→const { version } = require("../../../package.json");
    31→
    32→/**
    33→ * File name for generated agent instructions
    34→ */
    35→const GENERATED_FILE_NAME = "kspec-agents.md";
    36→
    37→/**
    38→ * Hash file name for tracking freshness
    39→ */
    40→const HASH_FILE_NAME = ".kspec-agents-hash";
    41→
    42→/**
    43→ * Compute SHA256 hash of content
    44→ */
    45→function computeHash(content: string): string {
    46→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
    47→}
    48→
    49→/**
    50→ * Generate a hash of the meta content that affects the generated file.
    51→ * This is used to detect if the generated file is stale.
    52→ */
    53→function computeMetaHash(
    54→  skills: LoadedSkill[],
    55→  conventions: LoadedConvention[],
    56→  workflows: LoadedWorkflow[],
    57→): string {
    58→  // Create a stable representation of the meta content
    59→  const data = {
    60→    skills: skills.map((s) => ({
    61→      id: s.id,
    62→      name: s.name,
    63→      description: s.description,
    64→    })),
    65→    conventions: conventions.map((c) => ({
    66→      domain: c.domain,
    67→      rules: c.rules,
    68→    })),
    69→    workflows: workflows.map((w) => ({
    70→      id: w.id,
    71→      trigger: w.trigger,
    72→      description: w.description,
    73→    })),
    74→  };
    75→  return computeHash(JSON.stringify(data));
    76→}
    77→
    78→/**
    79→ * Generate the Finding Information table for skills.
    80→ * AC: @agent-instruction-gen ac-2 - Finding Information table with row per skill
    81→ */
    82→function generateSkillsTable(skills: LoadedSkill[]): string {
    83→  if (skills.length === 0) {
    84→    return "";
    85→  }
    86→
    87→  const lines: string[] = [
    88→    "## Finding Information",
    89→    "",
    90→    "Use skills and CLI help for detailed documentation:",
    91→    "",
    92→    "| Need | Where to look |",
    93→    "|------|---------------|",
    94→  ];
    95→
    96→  for (const skill of skills) {
    97→    const description = skill.description || skill.name;
    98→    // Use the skill ID as the reference (prefixed with /)
    99→    lines.push(`| ${description} | \`/${skill.id}\` skill |`);
   100→  }
   101→
   102→  lines.push("");
   103→  lines.push(
   104→    "Skills inject their full documentation when invoked — you don't need to memorize their contents.",
   105→  );
   106→  lines.push("");
   107→
   108→  return lines.join("\n");
   109→}
   110→
   111→/**
   112→ * Generate the conventions section.
   113→ * AC: @agent-instruction-gen ac-3 - conventions section listing rules by domain
   114→ */
   115→function generateConventionsSection(conventions: LoadedConvention[]): string {
   116→  if (conventions.length === 0) {
   117→    return "";
   118→  }
   119→
   120→  const lines: string[] = ["## Conventions", ""];
   121→
   122→  for (const convention of conventions) {
   123→    lines.push(`### ${convention.domain}`);
   124→    lines.push("");
   125→
   126→    for (const rule of convention.rules) {
   127→      lines.push(`- ${rule}`);
   128→    }
   129→
   130→    lines.push("");
   131→  }
   132→
   133→  return lines.join("\n");
   134→}
   135→
   136→/**
   137→ * Generate the workflows summary section.
   138→ */
   139→function generateWorkflowsSection(workflows: LoadedWorkflow[]): string {
   140→  if (workflows.length === 0) {
   141→    return "";
   142→  }
   143→
   144→  const lines: string[] = [
   145→    "## Workflows",
   146→    "",
   147→    "Available workflows:",
   148→    "",
   149→  ];
   150→
   151→  for (const workflow of workflows) {
   152→    const description = workflow.description || workflow.trigger;
   153→    lines.push(`- **${workflow.id}**: ${description}`);
   154→  }
   155→
   156→  lines.push("");
   157→  lines.push("Use `kspec workflow start @workflow-id` to start a workflow.");
   158→  lines.push("");
   159→
   160→  return lines.join("\n");
   161→}
   162→
   163→/**
   164→ * Generate the freshness comment.
   165→ * AC: @agent-instruction-gen ac-4 - freshness comment with kspec version and timestamp
   166→ */
   167→function generateFreshnessComment(timestamp: string): string {
   168→  return `<!-- Generated by kspec v${version} at ${timestamp} -->\n<!-- Do not edit manually - regenerate with: kspec agents generate -->\n\n`;
   169→}
   170→
   171→/**
   172→ * Generate the full kspec-agents.md content
   173→ */
   174→function generateAgentsContent(
   175→  skills: LoadedSkill[],
   176→  conventions: LoadedConvention[],
   177→  workflows: LoadedWorkflow[],
   178→  timestamp: string,
   179→): string {
   180→  const sections: string[] = [];
   181→
   182→  // AC: @agent-instruction-gen ac-4 - freshness comment
   183→  sections.push(generateFreshnessComment(timestamp));
   184→
   185→  // Header
   186→  sections.push("# kspec Agent Instructions\n");
   187→  sections.push(
   188→    "This file is auto-generated from kspec meta. Include it in your AGENTS.md or similar agent instruction file.\n\n",
   189→  );
   190→
   191→  // AC: @agent-instruction-gen ac-2 - Skills table
   192→  const skillsTable = generateSkillsTable(skills);
   193→  if (skillsTable) {
   194→    sections.push(skillsTable);
   195→  }
   196→
   197→  // AC: @agent-instruction-gen ac-3 - Conventions section
   198→  const conventionsSection = generateConventionsSection(conventions);
   199→  if (conventionsSection) {
   200→    sections.push(conventionsSection);
   201→  }
   202→
   203→  // Workflows summary
   204→  const workflowsSection = generateWorkflowsSection(workflows);
   205→  if (workflowsSection) {
   206→    sections.push(workflowsSection);
   207→  }
   208→
   209→  return sections.join("");
   210→}
   211→
   212→/**
   213→ * Result of checking agent file status
   214→ */
   215→interface AgentStatusResult {
   216→  exists: boolean;
   217→  path: string;
   218→  status: "current" | "stale" | "missing";
   219→  metaHash?: string;
   220→  storedHash?: string;
   221→  generatedAt?: string;
   222→}
   223→
   224→/**
   225→ * Check the status of the generated agent file.
   226→ * AC: @agent-instruction-gen ac-5 - reports stale when meta has changed
   227→ */
   228→async function checkAgentStatus(
   229→  projectRoot: string,
   230→  metaHash: string,
   231→): Promise<AgentStatusResult> {
   232→  const filePath = path.join(projectRoot, GENERATED_FILE_NAME);
   233→  const hashPath = path.join(projectRoot, ".kspec", HASH_FILE_NAME);
   234→
   235→  // Check if file exists
   236→  try {
   237→    await fs.access(filePath);
   238→  } catch {
   239→    return {
   240→      exists: false,
   241→      path: filePath,
   242→      status: "missing",
   243→      metaHash,
   244→    };
   245→  }
   246→
   247→  // Check stored hash
   248→  let storedHash: string | undefined;
   249→  let generatedAt: string | undefined;
   250→
   251→  try {
   252→    const hashContent = await fs.readFile(hashPath, "utf-8");
   253→    const hashData = JSON.parse(hashContent);
   254→    storedHash = hashData.metaHash;
   255→    generatedAt = hashData.generatedAt;
   256→  } catch {
   257→    // No hash file, treat as stale
   258→    return {
   259→      exists: true,
   260→      path: filePath,
   261→      status: "stale",
   262→      metaHash,
   263→    };
   264→  }
   265→
   266→  // Compare hashes
   267→  const isCurrent = storedHash === metaHash;
   268→
   269→  return {
   270→    exists: true,
   271→    path: filePath,
   272→    status: isCurrent ? "current" : "stale",
   273→    metaHash,
   274→    storedHash,
   275→    generatedAt,
   276→  };
   277→}
   278→
   279→/**
   280→ * Register agent instruction generation commands
   281→ */
   282→export function registerAgentsCommands(program: Command): void {
   283→  const agents = program
   284→    .command("agents")
   285→    .description("Agent instruction generation commands");
   286→
   287→  // AC: @agent-instruction-gen ac-1 - kspec agents generate
   288→  // AC: @trait-dry-run ac-1 through ac-6 - dry-run support
   289→  agents
   290→    .command("generate")
   291→    .description("Generate kspec-agents.md from meta (skills, conventions, workflows)")
   292→    .option("--dry-run", "Show what would be generated without writing files")
   293→    .action(async (options) => {
   294→      try {
   295→        const ctx = await initContext();
   296→
   297→        if (!ctx.manifestPath) {
   298→          error(errors.project.noKspecProject);
   299→          process.exit(EXIT_CODES.ERROR);
   300→        }
   301→
   302→        const metaCtx = await loadMetaContext(ctx);
   303→        const dryRun = options.dryRun || false;
   304→        const timestamp = new Date().toISOString();
   305→
   306→        // Generate content
   307→        const content = generateAgentsContent(
   308→          metaCtx.skills,
   309→          metaCtx.conventions,
   310→          metaCtx.workflows,
   311→          timestamp,
   312→        );
   313→
   314→        // Compute meta hash for freshness tracking
   315→        const metaHash = computeMetaHash(
   316→          metaCtx.skills,
   317→          metaCtx.conventions,
   318→          metaCtx.workflows,
   319→        );
   320→
   321→        const outputPath = path.join(ctx.rootDir, GENERATED_FILE_NAME);
   322→        const hashPath = path.join(ctx.rootDir, ".kspec", HASH_FILE_NAME);
   323→
   324→        // AC: @trait-dry-run ac-3 - clear indication this is a preview
   325→        if (dryRun) {
   326→          output(
   327→            {
   328→              dry_run: true,
   329→              path: outputPath,
   330→              skills: metaCtx.skills.length,
   331→              conventions: metaCtx.conventions.length,
   332→              workflows: metaCtx.workflows.length,
   333→              content,
   334→            },
   335→            () => {
   336→              console.log(chalk.yellow("DRY RUN - No changes made"));
   337→              console.log();
   338→              console.log(chalk.gray(`Would write to: ${outputPath}`));
   339→              console.log();
   340→              console.log(chalk.gray("--- Generated content ---"));
   341→              console.log(content);
   342→              console.log(chalk.gray("--- End content ---"));
   343→              console.log();
   344→              console.log(
   345→                chalk.yellow("No changes were made. Run without --dry-run to apply."),
   346→              );
   347→            },
   348→          );
   349→          return;
   350→        }
   351→
   352→        // AC: @trait-dry-run ac-2 - no files modified in dry run mode
   353→        // Write the generated file
   354→        await fs.writeFile(outputPath, content, "utf-8");
   355→
   356→        // Write the hash file for freshness tracking
   357→        await fs.mkdir(path.dirname(hashPath), { recursive: true });
   358→        await fs.writeFile(
   359→          hashPath,
   360→          JSON.stringify(
   361→            {
   362→              metaHash,
   363→              generatedAt: timestamp,
   364→              version,
   365→            },
   366→            null,
   367→            2,
   368→          ),
   369→          "utf-8",
   370→        );
   371→
   372→        output(
   373→          {
   374→            path: outputPath,
   375→            skills: metaCtx.skills.length,
   376→            conventions: metaCtx.conventions.length,
   377→            workflows: metaCtx.workflows.length,
   378→            generatedAt: timestamp,
   379→          },
   380→          () => {
   381→            success(`Generated ${GENERATED_FILE_NAME}`, {
   382→              skills: metaCtx.skills.length,
   383→              conventions: metaCtx.conventions.length,
   384→              workflows: metaCtx.workflows.length,
   385→            });
   386→            console.log(chalk.gray(`  Path: ${outputPath}`));
   387→          },
   388→        );
   389→      } catch (err) {
   390→        error("Failed to generate agent instructions", err);
   391→        process.exit(EXIT_CODES.ERROR);
   392→      }
   393→    });
   394→
   395→  // AC: @agent-instruction-gen ac-5 - kspec agents status
   396→  agents
   397→    .command("status")
   398→    .description("Check if kspec-agents.md is up to date with meta")
   399→    .action(async () => {
   400→      try {
   401→        const ctx = await initContext();
   402→
   403→        if (!ctx.manifestPath) {
   404→          error(errors.project.noKspecProject);
   405→          process.exit(EXIT_CODES.ERROR);
   406→        }
   407→
   408→        const metaCtx = await loadMetaContext(ctx);
   409→
   410→        // Compute current meta hash
   411→        const metaHash = computeMetaHash(
   412→          metaCtx.skills,
   413→          metaCtx.conventions,
   414→          metaCtx.workflows,
   415→        );
   416→
   417→        const status = await checkAgentStatus(ctx.rootDir, metaHash);
   418→
   419→        output(status, () => {
   420→          switch (status.status) {
   421→            case "missing":
   422→              console.log(chalk.yellow(`${GENERATED_FILE_NAME} does not exist`));
   423→              console.log();
   424→              console.log(
   425→                chalk.gray("Run 'kspec agents generate' to create it."),
   426→              );
   427→              break;
   428→
   429→            case "stale":
   430→              console.log(
   431→                chalk.yellow(`${GENERATED_FILE_NAME} is stale`),
   432→              );
   433→              console.log();
   434→              console.log(
   435→                chalk.gray(
   436→                  "Meta has changed since the file was generated.",
   437→                ),
   438→              );
   439→              console.log(
   440→                chalk.gray("Run 'kspec agents generate' to regenerate."),
   441→              );
   442→              break;
   443→
   444→            case "current":
   445→              console.log(chalk.green(`${GENERATED_FILE_NAME} is up to date`));
   446→              if (status.generatedAt) {
   447→                console.log(chalk.gray(`  Generated: ${status.generatedAt}`));
   448→              }
   449→              break;
   450→          }
   451→        });
   452→      } catch (err) {
   453→        error("Failed to check agent status", err);
   454→        process.exit(EXIT_CODES.ERROR);
   455→      }
   456→    });
   457→}
