     1→/**
     2→ * Validation module for kspec files.
     3→ *
     4→ * Provides schema validation, reference validation, and orphan detection.
     5→ */
     6→
     7→import * as fs from "node:fs/promises";
     8→import * as path from "node:path";
     9→import {
    10→  AgentSchema,
    11→  ConventionSchema,
    12→  ManifestSchema,
    13→  MetaManifestSchema,
    14→  ObservationSchema,
    15→  SpecItemSchema,
    16→  TaskSchema,
    17→  TasksFileSchema,
    18→  UlidSchema,
    19→  WorkflowSchema,
    20→} from "../schema/index.js";
    21→import { findMetaManifest, loadMetaContext } from "./meta.js";
    22→import { loadPlans } from "./plans.js";
    23→import {
    24→  ReferenceIndex,
    25→  type RefValidationError,
    26→  type RefValidationWarning,
    27→  validateRefs,
    28→} from "./refs.js";
    29→import { TraitIndex } from "./traits.js";
    30→import type { KspecContext, LoadedSpecItem, LoadedTask } from "./yaml.js";
    31→import {
    32→  expandIncludePattern,
    33→  extractItemsFromRaw,
    34→  findTaskFiles,
    35→  loadSpecFile,
    36→  readYamlFile,
    37→} from "./yaml.js";
    38→
    39→// ============================================================
    40→// TYPES
    41→// ============================================================
    42→
    43→/**
    44→ * Schema validation error
    45→ */
    46→export interface SchemaValidationError {
    47→  file: string;
    48→  path?: string;
    49→  message: string;
    50→  details?: unknown;
    51→}
    52→
    53→/**
    54→ * Orphan item (not referenced by anything)
    55→ */
    56→export interface OrphanItem {
    57→  ulid: string;
    58→  title: string;
    59→  type: string;
    60→  file?: string;
    61→}
    62→
    63→/**
    64→ * Completeness warning types
    65→ */
    66→export type CompletenessWarningType =
    67→  | "missing_acceptance_criteria"
    68→  | "missing_description"
    69→  | "status_inconsistency"
    70→  | "missing_test_coverage"
    71→  | "automation_eligible_no_spec"
    72→  | "ac_schema_field_mismatch";
    73→
    74→/**
    75→ * Trait cycle error
    76→ */
    77→export interface TraitCycleError {
    78→  traitRef: string;
    79→  traitTitle: string;
    80→  cycle: string[];
    81→  message: string;
    82→}
    83→
    84→/**
    85→ * Completeness warning
    86→ */
    87→export interface CompletenessWarning {
    88→  type: CompletenessWarningType;
    89→  itemRef: string;
    90→  itemTitle: string;
    91→  message: string;
    92→  details?: string;
    93→}
    94→
    95→/**
    96→ * Complete validation result
    97→ */
    98→export interface ValidationResult {
    99→  valid: boolean;
   100→  schemaErrors: SchemaValidationError[];
   101→  refErrors: RefValidationError[];
   102→  refWarnings: RefValidationWarning[];
   103→  orphans: OrphanItem[];
   104→  completenessWarnings: CompletenessWarning[];
   105→  traitCycleErrors: TraitCycleError[];
   106→  stats: {
   107→    filesChecked: number;
   108→    itemsChecked: number;
   109→    tasksChecked: number;
   110→  };
   111→  metaStats?: {
   112→    agents: number;
   113→    workflows: number;
   114→    conventions: number;
   115→    observations: number;
   116→  };
   117→}
   118→
   119→/**
   120→ * Validation options
   121→ */
   122→export interface ValidateOptions {
   123→  /** Check schema conformance */
   124→  schema?: boolean;
   125→  /** Check reference resolution */
   126→  refs?: boolean;
   127→  /** Find orphaned items */
   128→  orphans?: boolean;
   129→  /** Check spec completeness (missing AC, descriptions, status inconsistencies) */
   130→  completeness?: boolean;
   131→}
   132→
   133→// ============================================================
   134→// SCHEMA VALIDATION
   135→// ============================================================
   136→
   137→/**
   138→ * Validate a manifest file against schema
   139→ */
   140→async function validateManifestFile(
   141→  filePath: string,
   142→): Promise<SchemaValidationError[]> {
   143→  const errors: SchemaValidationError[] = [];
   144→
   145→  try {
   146→    const raw = await readYamlFile<unknown>(filePath);
   147→    const result = ManifestSchema.safeParse(raw);
   148→
   149→    if (!result.success) {
   150→      for (const issue of result.error.issues) {
   151→        errors.push({
   152→          file: filePath,
   153→          path: issue.path.join("."),
   154→          message: issue.message,
   155→          details: issue,
   156→        });
   157→      }
   158→    }
   159→  } catch (err) {
   160→    errors.push({
   161→      file: filePath,
   162→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   163→    });
   164→  }
   165→
   166→  return errors;
   167→}
   168→
   169→/**
   170→ * Validate a tasks file against schema
   171→ */
   172→async function validateTasksFile(
   173→  filePath: string,
   174→): Promise<SchemaValidationError[]> {
   175→  const errors: SchemaValidationError[] = [];
   176→
   177→  try {
   178→    const raw = await readYamlFile<unknown>(filePath);
   179→
   180→    // Handle both formats: { tasks: [...] } and plain array
   181→    let taskList: unknown[];
   182→
   183→    if (Array.isArray(raw)) {
   184→      taskList = raw;
   185→    } else if (raw && typeof raw === "object" && "tasks" in raw) {
   186→      // Try full TasksFile schema first
   187→      const fileResult = TasksFileSchema.safeParse(raw);
   188→      if (!fileResult.success) {
   189→        // If TasksFile fails, just validate individual tasks
   190→        taskList = (raw as { tasks: unknown[] }).tasks || [];
   191→      } else {
   192→        // File schema passed, validate individual tasks for detailed errors
   193→        taskList = fileResult.data.tasks;
   194→      }
   195→    } else {
   196→      errors.push({
   197→        file: filePath,
   198→        message:
   199→          "Invalid tasks file format: expected array or { tasks: [...] }",
   200→      });
   201→      return errors;
   202→    }
   203→
   204→    // Validate each task
   205→    for (let i = 0; i < taskList.length; i++) {
   206→      const task = taskList[i];
   207→      const result = TaskSchema.safeParse(task);
   208→
   209→      if (!result.success) {
   210→        for (const issue of result.error.issues) {
   211→          errors.push({
   212→            file: filePath,
   213→            path: `tasks[${i}].${issue.path.join(".")}`,
   214→            message: issue.message,
   215→            details: issue,
   216→          });
   217→        }
   218→      }
   219→    }
   220→  } catch (err) {
   221→    errors.push({
   222→      file: filePath,
   223→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   224→    });
   225→  }
   226→
   227→  return errors;
   228→}
   229→
   230→/**
   231→ * Validate a spec module file against schema
   232→ */
   233→async function validateSpecFile(
   234→  filePath: string,
   235→): Promise<SchemaValidationError[]> {
   236→  const errors: SchemaValidationError[] = [];
   237→
   238→  try {
   239→    const raw = await readYamlFile<unknown>(filePath);
   240→
   241→    // Recursively validate spec items
   242→    validateSpecItemRecursive(raw, filePath, "", errors);
   243→  } catch (err) {
   244→    errors.push({
   245→      file: filePath,
   246→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   247→    });
   248→  }
   249→
   250→  return errors;
   251→}
   252→
   253→/**
   254→ * Validate meta manifest file with strict ULID validation
   255→ * AC-meta-manifest-3: Invalid schema exits with code 1 and shows field path + expected type
   256→ */
   257→async function validateMetaManifestFile(
   258→  filePath: string,
   259→): Promise<SchemaValidationError[]> {
   260→  const errors: SchemaValidationError[] = [];
   261→
   262→  try {
   263→    const raw = await readYamlFile<unknown>(filePath);
   264→
   265→    // Validate overall manifest structure
   266→    const manifestResult = MetaManifestSchema.safeParse(raw);
   267→    if (!manifestResult.success) {
   268→      for (const issue of manifestResult.error.issues) {
   269→        errors.push({
   270→          file: filePath,
   271→          path: issue.path.join("."),
   272→          message: issue.message,
   273→          details: issue,
   274→        });
   275→      }
   276→      return errors;
   277→    }
   278→
   279→    // Validate each agent with strict ULID validation
   280→    if (
   281→      raw &&
   282→      typeof raw === "object" &&
   283→      "agents" in raw &&
   284→      Array.isArray((raw as Record<string, unknown>).agents)
   285→    ) {
   286→      const agents = (raw as Record<string, unknown>).agents as unknown[];
   287→      for (let i = 0; i < agents.length; i++) {
   288→        const agent = agents[i];
   289→        const agentResult = AgentSchema.safeParse(agent);
   290→        if (!agentResult.success) {
   291→          for (const issue of agentResult.error.issues) {
   292→            errors.push({
   293→              file: filePath,
   294→              path: `agents[${i}].${issue.path.join(".")}`,
   295→              message: issue.message,
   296→              details: issue,
   297→            });
   298→          }
   299→        }
   300→
   301→        // Strict ULID validation
   302→        if (agent && typeof agent === "object" && "_ulid" in agent) {
   303→          const ulidResult = UlidSchema.safeParse(
   304→            (agent as Record<string, unknown>)._ulid,
   305→          );
   306→          if (!ulidResult.success) {
   307→            errors.push({
   308→              file: filePath,
   309→              path: `agents[${i}]._ulid`,
   310→              message: "Invalid ULID format (expected 26 characters)",
   311→            });
   312→          }
   313→        }
   314→      }
   315→    }
   316→
   317→    // Validate each workflow with strict ULID validation
   318→    if (
   319→      raw &&
   320→      typeof raw === "object" &&
   321→      "workflows" in raw &&
   322→      Array.isArray((raw as Record<string, unknown>).workflows)
   323→    ) {
   324→      const workflows = (raw as Record<string, unknown>).workflows as unknown[];
   325→      for (let i = 0; i < workflows.length; i++) {
   326→        const workflow = workflows[i];
   327→        const workflowResult = WorkflowSchema.safeParse(workflow);
   328→        if (!workflowResult.success) {
   329→          for (const issue of workflowResult.error.issues) {
   330→            errors.push({
   331→              file: filePath,
   332→              path: `workflows[${i}].${issue.path.join(".")}`,
   333→              message: issue.message,
   334→              details: issue,
   335→            });
   336→          }
   337→        }
   338→
   339→        // Strict ULID validation
   340→        if (workflow && typeof workflow === "object" && "_ulid" in workflow) {
   341→          const ulidResult = UlidSchema.safeParse(
   342→            (workflow as Record<string, unknown>)._ulid,
   343→          );
   344→          if (!ulidResult.success) {
   345→            errors.push({
   346→              file: filePath,
   347→              path: `workflows[${i}]._ulid`,
   348→              message: "Invalid ULID format (expected 26 characters)",
   349→            });
   350→          }
   351→        }
   352→      }
   353→    }
   354→
   355→    // Validate each convention with strict ULID validation
   356→    if (
   357→      raw &&
   358→      typeof raw === "object" &&
   359→      "conventions" in raw &&
   360→      Array.isArray((raw as Record<string, unknown>).conventions)
   361→    ) {
   362→      const conventions = (raw as Record<string, unknown>)
   363→        .conventions as unknown[];
   364→      for (let i = 0; i < conventions.length; i++) {
   365→        const convention = conventions[i];
   366→        const conventionResult = ConventionSchema.safeParse(convention);
   367→        if (!conventionResult.success) {
   368→          for (const issue of conventionResult.error.issues) {
   369→            errors.push({
   370→              file: filePath,
   371→              path: `conventions[${i}].${issue.path.join(".")}`,
   372→              message: issue.message,
   373→              details: issue,
   374→            });
   375→          }
   376→        }
   377→
   378→        // Strict ULID validation
   379→        if (
   380→          convention &&
   381→          typeof convention === "object" &&
   382→          "_ulid" in convention
   383→        ) {
   384→          const ulidResult = UlidSchema.safeParse(
   385→            (convention as Record<string, unknown>)._ulid,
   386→          );
   387→          if (!ulidResult.success) {
   388→            errors.push({
   389→              file: filePath,
   390→              path: `conventions[${i}]._ulid`,
   391→              message: "Invalid ULID format (expected 26 characters)",
   392→            });
   393→          }
   394→        }
   395→      }
   396→    }
   397→
   398→    // Validate each observation with strict ULID validation
   399→    if (
   400→      raw &&
   401→      typeof raw === "object" &&
   402→      "observations" in raw &&
   403→      Array.isArray((raw as Record<string, unknown>).observations)
   404→    ) {
   405→      const observations = (raw as Record<string, unknown>)
   406→        .observations as unknown[];
   407→      for (let i = 0; i < observations.length; i++) {
   408→        const observation = observations[i];
   409→        const observationResult = ObservationSchema.safeParse(observation);
   410→        if (!observationResult.success) {
   411→          for (const issue of observationResult.error.issues) {
   412→            errors.push({
   413→              file: filePath,
   414→              path: `observations[${i}].${issue.path.join(".")}`,
   415→              message: issue.message,
   416→              details: issue,
   417→            });
   418→          }
   419→        }
   420→
   421→        // Strict ULID validation
   422→        if (
   423→          observation &&
   424→          typeof observation === "object" &&
   425→          "_ulid" in observation
   426→        ) {
   427→          const ulidResult = UlidSchema.safeParse(
   428→            (observation as Record<string, unknown>)._ulid,
   429→          );
   430→          if (!ulidResult.success) {
   431→            errors.push({
   432→              file: filePath,
   433→              path: `observations[${i}]._ulid`,
   434→              message: "Invalid ULID format (expected 26 characters)",
   435→            });
   436→          }
   437→        }
   438→      }
   439→    }
   440→  } catch (err) {
   441→    errors.push({
   442→      file: filePath,
   443→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   444→    });
   445→  }
   446→
   447→  return errors;
   448→}
   449→
   450→/**
   451→ * Recursively validate spec items in a structure
   452→ */
   453→function validateSpecItemRecursive(
   454→  raw: unknown,
   455→  file: string,
   456→  pathPrefix: string,
   457→  errors: SchemaValidationError[],
   458→): void {
   459→  if (!raw || typeof raw !== "object") return;
   460→
   461→  // Check if this is a spec item (has _ulid)
   462→  if ("_ulid" in raw) {
   463→    const result = SpecItemSchema.safeParse(raw);
   464→    if (!result.success) {
   465→      for (const issue of result.error.issues) {
   466→        errors.push({
   467→          file,
   468→          path: pathPrefix
   469→            ? `${pathPrefix}.${issue.path.join(".")}`
   470→            : issue.path.join("."),
   471→          message: issue.message,
   472→          details: issue,
   473→        });
   474→      }
   475→    }
   476→  }
   477→
   478→  // Recurse into nested structures
   479→  const nestedFields = [
   480→    "modules",
   481→    "features",
   482→    "requirements",
   483→    "constraints",
   484→    "decisions",
   485→    "items",
   486→  ];
   487→  const obj = raw as Record<string, unknown>;
   488→
   489→  for (const field of nestedFields) {
   490→    if (field in obj && Array.isArray(obj[field])) {
   491→      const arr = obj[field] as unknown[];
   492→      for (let i = 0; i < arr.length; i++) {
   493→        const newPath = pathPrefix
   494→          ? `${pathPrefix}.${field}[${i}]`
   495→          : `${field}[${i}]`;
   496→        validateSpecItemRecursive(arr[i], file, newPath, errors);
   497→      }
   498→    }
   499→  }
   500→}
   501→
   502→// ============================================================
   503→// ORPHAN DETECTION
   504→// ============================================================
   505→
   506→/**
   507→ * Find items that are not referenced by any other item
   508→ */
   509→function findOrphans(
   510→  tasks: LoadedTask[],
   511→  items: LoadedSpecItem[],
   512→  index: ReferenceIndex,
   513→): OrphanItem[] {
   514→  const orphans: OrphanItem[] = [];
   515→
   516→  // Build set of all referenced ULIDs
   517→  const referenced = new Set<string>();
   518→
   519→  const allItems = [...tasks, ...items];
   520→
   521→  // Fields that contain references
   522→  const refFields = [
   523→    "depends_on",
   524→    "blocked_by",
   525→    "implements",
   526→    "relates_to",
   527→    "tests",
   528→    "supersedes",
   529→    "spec_ref",
   530→    "context",
   531→  ];
   532→
   533→  for (const item of allItems) {
   534→    const obj = item as unknown as Record<string, unknown>;
   535→
   536→    for (const field of refFields) {
   537→      const value = obj[field];
   538→
   539→      if (typeof value === "string" && value.startsWith("@")) {
   540→        const resolved = index.resolve(value);
   541→        if (resolved.ok) {
   542→          referenced.add(resolved.ulid);
   543→        }
   544→      } else if (Array.isArray(value)) {
   545→        for (const v of value) {
   546→          if (typeof v === "string" && v.startsWith("@")) {
   547→            const resolved = index.resolve(v);
   548→            if (resolved.ok) {
   549→              referenced.add(resolved.ulid);
   550→            }
   551→          }
   552→        }
   553→      }
   554→    }
   555→  }
   556→
   557→  // Find items not in the referenced set
   558→  // Skip entry point types: modules are spec entry points, tasks are work items
   559→  const entryPointTypes = ["module", "task", "epic", "bug", "spike", "infra"];
   560→
   561→  for (const item of items) {
   562→    // Only check spec items, not tasks
   563→    if (!referenced.has(item._ulid)) {
   564→      // Skip entry point types
   565→      if (entryPointTypes.includes(item.type || "")) continue;
   566→
   567→      // Skip nested items - they're implicitly referenced by their parent
   568→      // _path indicates nesting (e.g., "features[0].requirements[2]")
   569→      if (item._path) continue;
   570→
   571→      orphans.push({
   572→        ulid: item._ulid,
   573→        title: item.title,
   574→        type: item.type || "unknown",
   575→        file: item._sourceFile,
   576→      });
   577→    }
   578→  }
   579→
   580→  return orphans;
   581→}
   582→
   583→// ============================================================
   584→// TRAIT CYCLE DETECTION
   585→// ============================================================
   586→
   587→/**
   588→ * Detect circular trait references
   589→ * AC: @trait-edge-cases ac-2
   590→ */
   591→function detectTraitCycles(
   592→  items: LoadedSpecItem[],
   593→  index: ReferenceIndex,
   594→): TraitCycleError[] {
   595→  const errors: TraitCycleError[] = [];
   596→  const traits = items.filter((item) => item.type === "trait");
   597→
   598→  // Build adjacency list: trait ULID → trait ULIDs it references
   599→  const graph = new Map<string, string[]>();
   600→  const traitInfo = new Map<string, { ref: string; title: string }>();
   601→
   602→  for (const trait of traits) {
   603→    const ref = trait.slugs?.[0]
   604→      ? `@${trait.slugs[0]}`
   605→      : `@${trait._ulid.slice(0, 8)}`;
   606→    traitInfo.set(trait._ulid, { ref, title: trait.title });
   607→
   608→    const dependencies: string[] = [];
   609→    if (trait.traits && trait.traits.length > 0) {
   610→      for (const traitRef of trait.traits) {
   611→        const result = index.resolve(traitRef);
   612→        if (result.ok) {
   613→          dependencies.push(result.ulid);
   614→        }
   615→      }
   616→    }
   617→    graph.set(trait._ulid, dependencies);
   618→  }
   619→
   620→  // DFS-based cycle detection
   621→  const visiting = new Set<string>();
   622→  const visited = new Set<string>();
   623→
   624→  function dfs(ulid: string, path: string[]): string[] | null {
   625→    if (visiting.has(ulid)) {
   626→      // Found a cycle - return the cycle path
   627→      const cycleStart = path.indexOf(ulid);
   628→      return path.slice(cycleStart);
   629→    }
   630→
   631→    if (visited.has(ulid)) {
   632→      return null; // Already checked this path
   633→    }
   634→
   635→    visiting.add(ulid);
   636→    path.push(ulid);
   637→
   638→    const dependencies = graph.get(ulid) || [];
   639→    for (const depUlid of dependencies) {
   640→      const cycle = dfs(depUlid, path);
   641→      if (cycle) {
   642→        return cycle;
   643→      }
   644→    }
   645→
   646→    visiting.delete(ulid);
   647→    visited.add(ulid);
   648→    path.pop();
   649→
   650→    return null;
   651→  }
   652→
   653→  // Check each trait for cycles
   654→  for (const trait of traits) {
   655→    if (!visited.has(trait._ulid)) {
   656→      const cycle = dfs(trait._ulid, []);
   657→      if (cycle) {
   658→        const info = traitInfo.get(cycle[0]);
   659→        if (info) {
   660→          const cycleRefs = cycle.map((ulid) => {
   661→            const cycleInfo = traitInfo.get(ulid);
   662→            return cycleInfo ? cycleInfo.ref : `@${ulid.slice(0, 8)}`;
   663→          });
   664→
   665→          errors.push({
   666→            traitRef: info.ref,
   667→            traitTitle: info.title,
   668→            cycle: cycleRefs,
   669→            message: `Circular trait reference: ${cycleRefs.join(" → ")} → ${cycleRefs[0]}`,
   670→          });
   671→        }
   672→
   673→        // Mark all traits in cycle as visited to avoid duplicate errors
   674→        for (const ulid of cycle) {
   675→          visited.add(ulid);
   676→        }
   677→      }
   678→    }
   679→  }
   680→
   681→  return errors;
   682→}
   683→
   684→// ============================================================
   685→// COMPLETENESS VALIDATION
   686→// ============================================================
   687→
   688→/**
   689→ * Recursively find all test files in a directory
   690→ */
   691→async function findTestFilesRecursive(dir: string): Promise<string[]> {
   692→  const testFiles: string[] = [];
   693→
   694→  try {
   695→    const entries = await fs.readdir(dir, { withFileTypes: true });
   696→
   697→    for (const entry of entries) {
   698→      const fullPath = path.join(dir, entry.name);
   699→
   700→      if (entry.isDirectory()) {
   701→        // Recurse into subdirectories
   702→        const subFiles = await findTestFilesRecursive(fullPath);
   703→        testFiles.push(...subFiles);
   704→      } else if (
   705→        entry.isFile() &&
   706→        (entry.name.endsWith(".test.ts") || entry.name.endsWith(".test.js"))
   707→      ) {
   708→        testFiles.push(fullPath);
   709→      }
   710→    }
   711→  } catch {
   712→    // Directory doesn't exist or can't be read - return empty
   713→  }
   714→
   715→  return testFiles;
   716→}
   717→
   718→/**
   719→ * Scan test files for AC annotations to build coverage index.
   720→ * Recursively scans all subdirectories under tests/.
   721→ * Returns a Set of covered ACs in format "@spec-ref ac-N"
   722→ */
   723→export async function scanTestCoverage(rootDir: string): Promise<Set<string>> {
   724→  const coveredACs = new Set<string>();
   725→  const testsDir = path.join(rootDir, "tests");
   726→
   727→  try {
   728→    // Check if tests directory exists
   729→    await fs.access(testsDir);
   730→
   731→    // Recursively find all test files
   732→    const testFiles = await findTestFilesRecursive(testsDir);
   733→
   734→    for (const filePath of testFiles) {
   735→      const content = await fs.readFile(filePath, "utf-8");
   736→
   737→      // Match AC annotations: // AC: @spec-ref ac-N
   738→      // Also handle multiple ACs on one line: // AC: @spec-ref ac-1, ac-2
   739→      const acPattern =
   740→        /\/\/\s*AC:\s*(@[\w-]+)(?:\s+(ac-\d+(?:\s*,\s*ac-\d+)*))?/g;
   741→      let match;
   742→
   743→      while ((match = acPattern.exec(content)) !== null) {
   744→        const specRef = match[1]; // @spec-ref
   745→        const acList = match[2]; // "ac-1, ac-2" or just "ac-1" or undefined
   746→
   747→        if (acList) {
   748→          // Split by comma and trim
   749→          const acs = acList.split(",").map((ac) => ac.trim());
   750→          for (const ac of acs) {
   751→            coveredACs.add(`${specRef} ${ac}`);
   752→          }
   753→        } else {
   754→          // No specific AC mentioned, just the spec ref
   755→          // We'll consider this as generic coverage
   756→          coveredACs.add(specRef);
   757→        }
   758→      }
   759→    }
   760→  } catch (_err) {
   761→    // Tests directory doesn't exist or can't be read - that's ok
   762→  }
   763→
   764→  return coveredACs;
   765→}
   766→
   767→/**
   768→ * Compute coverage status for acceptance criteria of a spec item.
   769→ * Shared utility used by both daemon API and JSON export.
   770→ *
   771→ * @param item - The spec item containing acceptance_criteria
   772→ * @param coveredACs - Set of covered AC references from scanTestCoverage()
   773→ * @returns Array of ACs with covered field populated
   774→ */
   775→export function computeACCoverage<
   776→  T extends { id: string; given: string; when: string; then: string },
   777→>(
   778→  item: { _ulid: string; slugs?: string[]; acceptance_criteria?: T[] },
   779→  coveredACs: Set<string>,
   780→): Array<T & { covered: boolean }> {
   781→  if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
   782→    return [];
   783→  }
   784→
   785→  return item.acceptance_criteria.map((ac, index) => {
   786→    const acId = `ac-${index + 1}`;
   787→    const possibleRefs: string[] = [];
   788→
   789→    // Try with primary slug
   790→    if (item.slugs && item.slugs.length > 0) {
   791→      possibleRefs.push(`@${item.slugs[0]} ${acId}`);
   792→      possibleRefs.push(`@${item.slugs[0]}`);
   793→    }
   794→
   795→    // Try with ULID (short form)
   796→    possibleRefs.push(`@${item._ulid.slice(0, 8)} ${acId}`);
   797→    possibleRefs.push(`@${item._ulid.slice(0, 8)}`);
   798→
   799→    const covered = possibleRefs.some((ref) => coveredACs.has(ref));
   800→    return { ...ac, covered };
   801→  });
   802→}
   803→
   804→/**
   805→ * Check spec items for completeness
   806→ * AC: @spec-completeness ac-1, ac-2, ac-3
   807→ * AC: @trait-validation ac-1, ac-2, ac-3
   808→ */
   809→async function checkCompleteness(
   810→  items: LoadedSpecItem[],
   811→  _index: ReferenceIndex,
   812→  rootDir: string,
   813→  traitIndex?: TraitIndex,
   814→): Promise<CompletenessWarning[]> {
   815→  const warnings: CompletenessWarning[] = [];
   816→
   817→  // Scan test files for AC coverage
   818→  const coveredACs = await scanTestCoverage(rootDir);
   819→
   820→  for (const item of items) {
   821→    const itemRef = item.slugs?.[0]
   822→      ? `@${item.slugs[0]}`
   823→      : `@${item._ulid.slice(0, 8)}`;
   824→    const isTrait = item.type === "trait";
   825→
   826→    // AC: @spec-completeness ac-1
   827→    // AC: @trait-type ac-2 - Traits should have acceptance criteria for completeness
   828→    // Check for missing acceptance criteria
   829→    if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
   830→      warnings.push({
   831→        type: "missing_acceptance_criteria",
   832→        itemRef,
   833→        itemTitle: item.title,
   834→        message: `${isTrait ? "Trait" : "Item"} ${itemRef} has no acceptance criteria`,
   835→      });
   836→    }
   837→
   838→    // AC: @spec-completeness ac-2
   839→    // AC: @trait-type ac-3 - Traits should have description for completeness
   840→    // Check for missing description
   841→    if (!item.description || item.description.trim() === "") {
   842→      warnings.push({
   843→        type: "missing_description",
   844→        itemRef,
   845→        itemTitle: item.title,
   846→        message: `${isTrait ? "Trait" : "Item"} ${itemRef} has no description`,
   847→      });
   848→    }
   849→
   850→    // AC: @spec-completeness ac-3
   851→    // Check for status inconsistency between parent and children
   852→    if (item.status?.implementation === "implemented") {
   853→      // Check if this item has children with not_started status
   854→      const childFields = [
   855→        "modules",
   856→        "features",
   857→        "requirements",
   858→        "constraints",
   859→        "epics",
   860→        "themes",
   861→        "capabilities",
   862→      ];
   863→
   864→      for (const field of childFields) {
   865→        const children = (item as any)[field];
   866→        if (Array.isArray(children)) {
   867→          for (const child of children) {
   868→            if (child.status?.implementation === "not_started") {
   869→              const childRef = child.slugs?.[0]
   870→                ? `@${child.slugs[0]}`
   871→                : `@${child._ulid?.slice(0, 8) || "unknown"}`;
   872→              warnings.push({
   873→                type: "status_inconsistency",
   874→                itemRef,
   875→                itemTitle: item.title,
   876→                message: `Parent ${itemRef} is implemented but child ${childRef} is not_started`,
   877→                details: `Child: ${child.title}`,
   878→              });
   879→            }
   880→          }
   881→        }
   882→      }
   883→    }
   884→
   885→    // Check for test coverage of acceptance criteria
   886→    if (item.acceptance_criteria && item.acceptance_criteria.length > 0) {
   887→      const uncoveredACs: string[] = [];
   888→
   889→      for (const ac of item.acceptance_criteria) {
   890→        // Build all possible references for this AC
   891→        const possibleRefs: string[] = [];
   892→
   893→        // Try with primary slug
   894→        if (item.slugs && item.slugs.length > 0) {
   895→          possibleRefs.push(`@${item.slugs[0]} ${ac.id}`);
   896→          // Also check for just the slug without specific AC
   897→          possibleRefs.push(`@${item.slugs[0]}`);
   898→        }
   899→
   900→        // Try with ULID (short form)
   901→        possibleRefs.push(`@${item._ulid.slice(0, 8)} ${ac.id}`);
   902→        possibleRefs.push(`@${item._ulid.slice(0, 8)}`);
   903→
   904→        // Check if any of these references are covered
   905→        const isCovered = possibleRefs.some((ref) => coveredACs.has(ref));
   906→
   907→        if (!isCovered) {
   908→          uncoveredACs.push(ac.id);
   909→        }
   910→      }
   911→
   912→      // Only warn if there are uncovered ACs
   913→      if (uncoveredACs.length > 0) {
   914→        warnings.push({
   915→          type: "missing_test_coverage",
   916→          itemRef,
   917→          itemTitle: item.title,
   918→          message: `Item ${itemRef} has ${uncoveredACs.length} AC(s) without test coverage`,
   919→          details: `Uncovered: ${uncoveredACs.join(", ")}`,
   920→        });
   921→      }
   922→    }
   923→
   924→    // AC: @trait-validation ac-1, ac-2
   925→    // Check for test coverage of trait acceptance criteria
   926→    if (traitIndex && item.traits && item.traits.length > 0) {
   927→      const inheritedACs = traitIndex.getInheritedAC(item._ulid);
   928→      const uncoveredTraitACs: Array<{ traitSlug: string; acId: string }> = [];
   929→
   930→      for (const { trait, ac } of inheritedACs) {
   931→        // Build all possible references for this trait AC
   932→        const possibleRefs: string[] = [];
   933→
   934→        // Try with trait slug
   935→        possibleRefs.push(`@${trait.slug} ${ac.id}`);
   936→        possibleRefs.push(`@${trait.slug}`);
   937→
   938→        // Try with trait ULID (short form)
   939→        possibleRefs.push(`@${trait.ulid.slice(0, 8)} ${ac.id}`);
   940→        possibleRefs.push(`@${trait.ulid.slice(0, 8)}`);
   941→
   942→        // Check if any of these references are covered
   943→        const isCovered = possibleRefs.some((ref) => coveredACs.has(ref));
   944→
   945→        if (!isCovered) {
   946→          uncoveredTraitACs.push({ traitSlug: trait.slug, acId: ac.id });
   947→        }
   948→      }
   949→
   950→      // Only warn if there are uncovered trait ACs
   951→      if (uncoveredTraitACs.length > 0) {
   952→        const details = uncoveredTraitACs
   953→          .map(({ traitSlug, acId }) => `@${traitSlug} ${acId}`)
   954→          .join(", ");
   955→        warnings.push({
   956→          type: "missing_test_coverage",
   957→          itemRef,
   958→          itemTitle: item.title,
   959→          message: `Item ${itemRef} has ${uncoveredTraitACs.length} inherited trait AC(s) without test coverage`,
   960→          details: `Uncovered trait ACs: ${details}`,
   961→        });
   962→      }
   963→    }
   964→
   965→    // AC: @trait-retrospective ac-2, ac-3
   966→    // Check retrospective specs have required verification metadata
   967→    const isRetrospective = item.traits?.includes("@trait-retrospective");
   968→    if (isRetrospective) {
   969→      const isImplementedOrVerified =
   970→        item.status?.implementation === "implemented" ||
   971→        item.status?.implementation === "verified";
   972→
   973→      // AC: @trait-retrospective ac-2
   974→      // Retrospective specs with implemented/verified status must have verification metadata
   975→      if (isImplementedOrVerified) {
   976→        if (!item.verified_at || !item.verified_by) {
   977→          warnings.push({
   978→            type: "status_inconsistency",
   979→            itemRef,
   980→            itemTitle: item.title,
   981→            message: `Retrospective spec ${itemRef} is ${item.status?.implementation} but missing verified_at/verified_by`,
   982→            details:
   983→              "Specs using @trait-retrospective must have verified_at and verified_by fields when marked as implemented or verified",
   984→          });
   985→        }
   986→      }
   987→
   988→      // Inverse validation: If verification metadata exists, status should be implemented/verified
   989→      if ((item.verified_at || item.verified_by) && !isImplementedOrVerified) {
   990→        warnings.push({
   991→          type: "status_inconsistency",
   992→          itemRef,
   993→          itemTitle: item.title,
   994→          message: `Retrospective spec ${itemRef} has verification metadata but status is not implemented/verified`,
   995→          details:
   996→            "Retrospective specs with verified_at/verified_by should have implementation status set to 'implemented' or 'verified'",
   997→        });
   998→      }
   999→    }
  1000→  }
  1001→
  1002→  return warnings;
  1003→}
  1004→
  1005→// ============================================================
  1006→// AC SCHEMA DRIFT DETECTION
  1007→// ============================================================
  1008→
  1009→/**
  1010→ * Known schema fields for SpecItem
  1011→ * These are the actual fields defined in SpecItemSchema
  1012→ */
  1013→const SPEC_ITEM_FIELDS = new Set([
  1014→  "_ulid",
  1015→  "slugs",
  1016→  "title",
  1017→  "type",
  1018→  "status",
  1019→  "maturity",
  1020→  "implementation",
  1021→  "priority",
  1022→  "tags",
  1023→  "description",
  1024→  "acceptance_criteria",
  1025→  "depends_on",
  1026→  "implements",
  1027→  "relates_to",
  1028→  "tests",
  1029→  "traits",
  1030→  "supersedes",
  1031→  "traceability",
  1032→  "created",
  1033→  "created_by",
  1034→  "deprecated_in",
  1035→  "superseded_by",
  1036→  "verified_at",
  1037→  "verified_by",
  1038→  "notes",
  1039→]);
  1040→
  1041→/**
  1042→ * Known schema fields for Task
  1043→ * These are the actual fields defined in TaskSchema
  1044→ */
  1045→const TASK_FIELDS = new Set([
  1046→  "_ulid",
  1047→  "slugs",
  1048→  "title",
  1049→  "type",
  1050→  "description",
  1051→  "spec_ref",
  1052→  "derivation",
  1053→  "meta_ref",
  1054→  "plan_ref",
  1055→  "origin",
  1056→  "status",
  1057→  "blocked_by",
  1058→  "closed_reason",
  1059→  "depends_on",
  1060→  "context",
  1061→  "priority",
  1062→  "complexity",
  1063→  "tags",
  1064→  "assignee",
  1065→  "vcs_refs",
  1066→  "created_at",
  1067→  "started_at",
  1068→  "completed_at",
  1069→  "notes",
  1070→  "todos",
  1071→  "automation",
  1072→]);
  1073→
  1074→/**
  1075→ * Known fields that are referenced but are parse-time or conceptual only
  1076→ * These are common pseudo-fields that ACs reference but don't exist in schema
  1077→ */
  1078→const CONCEPTUAL_FIELDS = new Set([
  1079→  "children", // Hierarchy is parse-time only
  1080→  "parent", // Parent references are derived, not stored
  1081→  "modules", // These are container structures in YAML, not item fields
  1082→  "features",
  1083→  "requirements",
  1084→  "constraints",
  1085→  "decisions",
  1086→  "epics",
  1087→  "themes",
  1088→  "capabilities",
  1089→]);
  1090→
  1091→/**
  1092→ * Extract field reference patterns from AC text
  1093→ * Looks for patterns like:
  1094→ * - item.field
  1095→ * - spec.field
  1096→ * - task.field
  1097→ * - status.field
  1098→ * - spec_ref.field
  1099→ * - the field
  1100→ * - their field
  1101→ * - item's field
  1102→ */
  1103→/**
  1104→ * File extensions to exclude from field matching
  1105→ * These are common file extensions that would otherwise match our patterns
  1106→ */
  1107→const FILE_EXTENSIONS = new Set([
  1108→  "yaml",
  1109→  "yml",
  1110→  "json",
  1111→  "js",
  1112→  "ts",
  1113→  "md",
  1114→  "txt",
  1115→  "html",
  1116→  "css",
  1117→  "log",
  1118→]);
  1119→
  1120→function extractFieldReferences(text: string): Array<{ context: string; field: string }> {
  1121→  const references: Array<{ context: string; field: string }> = [];
  1122→
  1123→  // Pattern: context.field (e.g., item.status, spec_ref.children)
  1124→  // This matches entity.property patterns in prose
  1125→  const dotPattern = /\b(item|spec|task|status|spec_ref|task_ref|meta_ref|plan_ref)\.(\w+)/gi;
  1126→  let match: RegExpExecArray | null;
  1127→  while ((match = dotPattern.exec(text)) !== null) {
  1128→    const field = match[2].toLowerCase();
  1129→    // Skip file extensions (e.g., spec.yaml, task.json)
  1130→    if (FILE_EXTENSIONS.has(field)) {
  1131→      continue;
  1132→    }
  1133→    references.push({ context: match[1].toLowerCase(), field });
  1134→  }
  1135→
  1136→  // Pattern: "the <field>" when discussing items/tasks (common in ACs)
  1137→  // Only match known schema-like words to avoid false positives
  1138→  const thePattern = /\bthe\s+(status|children|parent|spec_ref|depends_on|traits|tags|notes|todos|acceptance_criteria)\b/gi;
  1139→  while ((match = thePattern.exec(text)) !== null) {
  1140→    references.push({ context: "item", field: match[1].toLowerCase() });
  1141→  }
  1142→
  1143→  return references;
  1144→}
  1145→
  1146→/**
  1147→ * Check if a field exists in the appropriate schema
  1148→ */
  1149→function isValidSchemaField(context: string, field: string): { valid: boolean; reason?: string } {
  1150→  // If it's a known conceptual field, it's technically invalid but we can give a specific message
  1151→  if (CONCEPTUAL_FIELDS.has(field)) {
  1152→    return { valid: false, reason: `'${field}' is a parse-time/conceptual field, not stored in schema` };
  1153→  }
  1154→
  1155→  // Check based on context
  1156→  switch (context) {
  1157→    case "spec":
  1158→    case "item":
  1159→      if (SPEC_ITEM_FIELDS.has(field)) {
  1160→        return { valid: true };
  1161→      }
  1162→      break;
  1163→
  1164→    case "task":
  1165→      if (TASK_FIELDS.has(field)) {
  1166→        return { valid: true };
  1167→      }
  1168→      break;
  1169→
  1170→    case "status":
  1171→      // status.maturity, status.implementation are valid for specs
  1172→      if (field === "maturity" || field === "implementation") {
  1173→        return { valid: true };
  1174→      }
  1175→      break;
  1176→
  1177→    case "spec_ref":
  1178→    case "task_ref":
  1179→    case "meta_ref":
  1180→    case "plan_ref":
  1181→      // These are string references, not objects with fields
  1182→      return { valid: false, reason: `'${context}' is a reference string, not an object with fields` };
  1183→  }
  1184→
  1185→  // Check if field exists in either schema (might be ambiguous context)
  1186→  if (SPEC_ITEM_FIELDS.has(field) || TASK_FIELDS.has(field)) {
  1187→    return { valid: true };
  1188→  }
  1189→
  1190→  return { valid: false, reason: `'${field}' is not a known schema field` };
  1191→}
  1192→
  1193→/**
  1194→ * Check acceptance criteria for field references that don't exist in schema
  1195→ * Catches drift between spec prose and implementation reality.
  1196→ */
  1197→export function checkACSchemaReferences(
  1198→  items: LoadedSpecItem[],
  1199→): CompletenessWarning[] {
  1200→  const warnings: CompletenessWarning[] = [];
  1201→
  1202→  for (const item of items) {
  1203→    if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
  1204→      continue;
  1205→    }
  1206→
  1207→    const itemRef = item.slugs?.[0]
  1208→      ? `@${item.slugs[0]}`
  1209→      : `@${item._ulid.slice(0, 8)}`;
  1210→
  1211→    for (const ac of item.acceptance_criteria) {
  1212→      // Check all three parts of the AC for field references
  1213→      const textToCheck = `${ac.given} ${ac.when} ${ac.then}`;
  1214→      const fieldRefs = extractFieldReferences(textToCheck);
  1215→
  1216→      for (const { context, field } of fieldRefs) {
  1217→        const result = isValidSchemaField(context, field);
  1218→        if (!result.valid) {
  1219→          warnings.push({
  1220→            type: "ac_schema_field_mismatch",
  1221→            itemRef,
  1222→            itemTitle: item.title,
  1223→            message: `AC ${ac.id} references '${context}.${field}' which doesn't exist in schema`,
  1224→            details: result.reason,
  1225→          });
  1226→        }
  1227→      }
  1228→    }
  1229→  }
  1230→
  1231→  return warnings;
  1232→}
  1233→
  1234→// ============================================================
  1235→// AUTOMATION VALIDATION
  1236→// ============================================================
  1237→
  1238→/**
  1239→ * Check task automation status for warnings
  1240→ * AC: @task-automation-eligibility ac-21, ac-23
  1241→ */
  1242→function checkAutomationEligibility(
  1243→  tasks: LoadedTask[],
  1244→  index: ReferenceIndex,
  1245→): CompletenessWarning[] {
  1246→  const warnings: CompletenessWarning[] = [];
  1247→
  1248→  for (const task of tasks) {
  1249→    const taskRef = task.slugs?.[0]
  1250→      ? `@${task.slugs[0]}`
  1251→      : `@${task._ulid.slice(0, 8)}`;
  1252→
  1253→    // AC: @task-automation-eligibility ac-21
  1254→    // Warn if eligible but no spec_ref
  1255→    if (task.automation === "eligible" && !task.spec_ref) {
  1256→      warnings.push({
  1257→        type: "automation_eligible_no_spec",
  1258→        itemRef: taskRef,
  1259→        itemTitle: task.title,
  1260→        message: `Task ${taskRef} is automation: eligible but has no spec_ref - eligible tasks should have linked specs`,
  1261→      });
  1262→    }
  1263→
  1264→    // AC: @task-automation-eligibility ac-23
  1265→    // Warn if eligible but spec_ref doesn't resolve
  1266→    if (task.automation === "eligible" && task.spec_ref) {
  1267→      const specResult = index.resolve(task.spec_ref);
  1268→      if (!specResult.ok) {
  1269→        warnings.push({
  1270→          type: "automation_eligible_no_spec",
  1271→          itemRef: taskRef,
  1272→          itemTitle: task.title,
  1273→          message: `Task ${taskRef} is automation: eligible but spec_ref ${task.spec_ref} cannot be resolved`,
  1274→        });
  1275→      }
  1276→    }
  1277→  }
  1278→
  1279→  return warnings;
  1280→}
  1281→
  1282→// ============================================================
  1283→// MAIN VALIDATION
  1284→// ============================================================
  1285→
  1286→/**
  1287→ * Run full validation on a kspec project
  1288→ */
  1289→export async function validate(
  1290→  ctx: KspecContext,
  1291→  options: ValidateOptions = {},
  1292→): Promise<ValidationResult> {
  1293→  // Default: run all checks
  1294→  const runSchema = options.schema !== false;
  1295→  const runRefs = options.refs !== false;
  1296→  const runOrphans = options.orphans !== false;
  1297→  const runCompleteness = options.completeness !== false;
  1298→
  1299→  const result: ValidationResult = {
  1300→    valid: true,
  1301→    schemaErrors: [],
  1302→    refErrors: [],
  1303→    refWarnings: [],
  1304→    orphans: [],
  1305→    completenessWarnings: [],
  1306→    traitCycleErrors: [],
  1307→    stats: {
  1308→      filesChecked: 0,
  1309→      itemsChecked: 0,
  1310→      tasksChecked: 0,
  1311→    },
  1312→  };
  1313→
  1314→  const allTasks: LoadedTask[] = [];
  1315→  const allItems: LoadedSpecItem[] = [];
  1316→
  1317→  // Validate manifest
  1318→  if (ctx.manifestPath && runSchema) {
  1319→    const manifestErrors = await validateManifestFile(ctx.manifestPath);
  1320→    result.schemaErrors.push(...manifestErrors);
  1321→    result.stats.filesChecked++;
  1322→  }
  1323→
  1324→  // Load items from manifest (traits, inline modules, etc.)
  1325→  if (ctx.manifest && ctx.manifestPath) {
  1326→    const manifestItems = extractItemsFromRaw(ctx.manifest, ctx.manifestPath);
  1327→    allItems.push(...manifestItems);
  1328→    result.stats.itemsChecked += manifestItems.length;
  1329→  }
  1330→
  1331→  // Find and validate task files
  1332→  const taskFiles = await findTaskFiles(ctx.rootDir);
  1333→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, "spec"));
  1334→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
  1335→
  1336→  for (const taskFile of allTaskFiles) {
  1337→    if (runSchema) {
  1338→      const taskErrors = await validateTasksFile(taskFile);
  1339→      result.schemaErrors.push(...taskErrors);
  1340→    }
  1341→    result.stats.filesChecked++;
  1342→
  1343→    // Load tasks for ref validation
  1344→    try {
  1345→      const raw = await readYamlFile<unknown>(taskFile);
  1346→      let taskList: unknown[] = [];
  1347→
  1348→      if (Array.isArray(raw)) {
  1349→        taskList = raw;
  1350→      } else if (raw && typeof raw === "object" && "tasks" in raw) {
  1351→        taskList = (raw as { tasks: unknown[] }).tasks || [];
  1352→      }
  1353→
  1354→      for (const t of taskList) {
  1355→        const parsed = TaskSchema.safeParse(t);
  1356→        if (parsed.success) {
  1357→          allTasks.push({ ...parsed.data, _sourceFile: taskFile });
  1358→          result.stats.tasksChecked++;
  1359→        }
  1360→      }
  1361→    } catch {
  1362→      // Already reported in schema validation
  1363→    }
  1364→  }
  1365→
  1366→  // Validate spec files (from includes)
  1367→  if (ctx.manifest && ctx.manifestPath) {
  1368→    const manifestDir = path.dirname(ctx.manifestPath);
  1369→    const includes = ctx.manifest.includes || [];
  1370→
  1371→    for (const include of includes) {
  1372→      const expandedPaths = await expandIncludePattern(include, manifestDir);
  1373→
  1374→      for (const filePath of expandedPaths) {
  1375→        if (runSchema) {
  1376→          const specErrors = await validateSpecFile(filePath);
  1377→          result.schemaErrors.push(...specErrors);
  1378→        }
  1379→        result.stats.filesChecked++;
  1380→
  1381→        // Load items for ref validation
  1382→        try {
  1383→          const items = await loadSpecFile(filePath);
  1384→          allItems.push(...items);
  1385→          result.stats.itemsChecked += items.length;
  1386→        } catch {
  1387→          // Already reported in schema validation
  1388→        }
  1389→      }
  1390→    }
  1391→  }
  1392→
  1393→  // Load meta items for reference validation
  1394→  // AC: @agent-definitions ac-agent-3
  1395→  const metaCtx = await loadMetaContext(ctx);
  1396→  const allMetaItems = [
  1397→    ...metaCtx.agents,
  1398→    ...metaCtx.workflows,
  1399→    ...metaCtx.conventions,
  1400→    ...metaCtx.observations,
  1401→  ];
  1402→
  1403→  // Load plans for reference validation
  1404→  // AC: @plan-validation ac-10
  1405→  const allPlans = await loadPlans(ctx);
  1406→
  1407→  // Reference validation
  1408→  if (
  1409→    runRefs &&
  1410→    (allTasks.length > 0 ||
  1411→      allItems.length > 0 ||
  1412→      allMetaItems.length > 0 ||
  1413→      allPlans.length > 0)
  1414→  ) {
  1415→    const index = new ReferenceIndex(
  1416→      allTasks,
  1417→      allItems,
  1418→      allMetaItems,
  1419→      allPlans,
  1420→    );
  1421→    const refResult = validateRefs(index, allTasks, allItems);
  1422→    result.refErrors = refResult.errors;
  1423→    result.refWarnings = refResult.warnings;
  1424→
  1425→    // AC: @trait-edge-cases ac-2
  1426→    // Detect circular trait references
  1427→    result.traitCycleErrors = detectTraitCycles(allItems, index);
  1428→
  1429→    // Orphan detection
  1430→    if (runOrphans) {
  1431→      result.orphans = findOrphans(allTasks, allItems, index);
  1432→    }
  1433→
  1434→    // Completeness validation
  1435→    // AC: @spec-completeness ac-1, ac-2, ac-3
  1436→    // AC: @trait-validation ac-3
  1437→    if (runCompleteness) {
  1438→      // Build trait index for trait AC coverage validation
  1439→      const traitIndex = new TraitIndex(allItems, index);
  1440→      result.completenessWarnings = await checkCompleteness(
  1441→        allItems,
  1442→        index,
  1443→        ctx.rootDir,
  1444→        traitIndex,
  1445→      );
  1446→
  1447→      // AC: @task-automation-eligibility ac-21, ac-23
  1448→      // Check automation eligibility warnings for tasks
  1449→      const automationWarnings = checkAutomationEligibility(allTasks, index);
  1450→      result.completenessWarnings.push(...automationWarnings);
  1451→    }
  1452→  }
  1453→
  1454→  // Meta manifest validation (AC-meta-manifest-2, AC-meta-manifest-3)
  1455→  const metaManifestPath = await findMetaManifest(ctx.specDir);
  1456→  if (metaManifestPath) {
  1457→    // Use metaCtx already loaded above
  1458→    result.metaStats = {
  1459→      agents: metaCtx.agents.length,
  1460→      workflows: metaCtx.workflows.length,
  1461→      conventions: metaCtx.conventions.length,
  1462→      observations: metaCtx.observations.length,
  1463→    };
  1464→
  1465→    // Validate meta manifest schema with strict ULID validation
  1466→    if (runSchema) {
  1467→      const metaErrors = await validateMetaManifestFile(metaManifestPath);
  1468→      // Prefix all meta errors with "meta:"
  1469→      for (const err of metaErrors) {
  1470→        err.path = err.path ? `meta:${err.path}` : "meta:";
  1471→      }
  1472→      result.schemaErrors.push(...metaErrors);
  1473→      result.stats.filesChecked++;
  1474→    }
  1475→  }
  1476→
  1477→  // Set valid flag
  1478→  result.valid =
  1479→    result.schemaErrors.length === 0 &&
  1480→    result.refErrors.length === 0 &&
  1481→    result.traitCycleErrors.length === 0;
  1482→
  1483→  return result;
  1484→}
  1485→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
