```
     1→/**
     2→ * Skill CLI commands for managing skills.
     3→ *
     4→ * AC: @skill-cli ac-1 - kspec skill list outputs table with ID, Name, Origin, Version, Platforms
     5→ * AC: @skill-cli ac-2 - kspec skill list --json outputs JSON array with full skill metadata
     6→ * AC: @skill-cli ac-3 - kspec skill add creates meta entry with origin custom
     7→ * AC: @skill-cli ac-4 - kspec skill add creates .kspec/skills/<id>/SKILL.md
     8→ * AC: @skill-cli ac-5 - kspec skill get outputs metadata including id, name, origin, platforms
     9→ * AC: @skill-cli ac-6 - kspec skill get outputs SKILL.md content
    10→ * AC: @skill-cli ac-7 - kspec skill delete --confirm removes meta entry
    11→ * AC: @skill-cli ac-8 - kspec skill delete removes .kspec/skills/<id>/ directory
    12→ */
    13→
    14→import * as crypto from "node:crypto";
    15→import * as fs from "node:fs/promises";
    16→import * as path from "node:path";
    17→import chalk from "chalk";
    18→import Table from "cli-table3";
    19→import type { Command } from "commander";
    20→import { ulid } from "ulid";
    21→import yaml from "yaml";
    22→import { markMutating } from "../command-annotations.js";
    23→import {
    24→  deleteMetaItem,
    25→  findMetaItemByRef,
    26→  getSkillContentPath,
    27→  initContext,
    28→  type KspecContext,
    29→  loadMetaContext,
    30→  loadSkillContent,
    31→  loadSkillDocs,
    32→  type LoadedSkill,
    33→  saveMetaItem,
    34→  type Skill,
    35→} from "../../parser/index.js";
    36→import { commitIfShadow } from "../../parser/shadow.js";
    37→import { SkillSchema, type SkillOrigin } from "../../schema/index.js";
    38→import { errors } from "../../strings/errors.js";
    39→import { EXIT_CODES } from "../exit-codes.js";
    40→import { error, output, success } from "../output.js";
    41→import { parseTagsArray } from "../parse-utils.js";
    42→
    43→/**
    44→ * Format skills as a table
    45→ * AC: @skill-cli ac-1 - table displays ID, Name, Origin, Version, Platforms
    46→ */
    47→function formatSkillsTable(skills: LoadedSkill[]): void {
    48→  if (skills.length === 0) {
    49→    console.log(chalk.yellow("No skills defined"));
    50→    return;
    51→  }
    52→
    53→  const table = new Table({
    54→    head: [
    55→      chalk.bold("ID"),
    56→      chalk.bold("Name"),
    57→      chalk.bold("Origin"),
    58→      chalk.bold("Version"),
    59→      chalk.bold("Platforms"),
    60→    ],
    61→    style: {
    62→      head: [],
    63→      border: [],
    64→    },
    65→  });
    66→
    67→  for (const skill of skills) {
    68→    table.push([
    69→      skill.id,
    70→      skill.name,
    71→      skill.origin,
    72→      skill.version || "-",
    73→      skill.platforms.join(", "),
    74→    ]);
    75→  }
    76→
    77→  console.log(table.toString());
    78→  console.log(chalk.gray(`\n${skills.length} skill(s)`));
    79→}
    80→
    81→/**
    82→ * Format skill details
    83→ * AC: @skill-cli ac-5 - outputs metadata including id, name, origin, platforms
    84→ */
    85→function formatSkillDetails(skill: LoadedSkill, content: string | null): void {
    86→  console.log(chalk.bold(skill.name));
    87→  console.log(chalk.gray("─".repeat(40)));
    88→  console.log(`ID:          ${skill.id}`);
    89→  console.log(`ULID:        ${skill._ulid}`);
    90→  console.log(`Origin:      ${skill.origin}`);
    91→  console.log(`Platforms:   ${skill.platforms.join(", ")}`);
    92→
    93→  if (skill.version) {
    94→    console.log(`Version:     ${skill.version}`);
    95→  }
    96→
    97→  if (skill.description) {
    98→    console.log(`\n─── Description ───`);
    99→    console.log(skill.description);
   100→  }
   101→
   102→  if (skill.depends_on && skill.depends_on.length > 0) {
   103→    console.log(`\n─── Dependencies ───`);
   104→    for (const dep of skill.depends_on) {
   105→      console.log(`  • ${dep}`);
   106→    }
   107→  }
   108→
   109→  if (skill.tags && skill.tags.length > 0) {
   110→    console.log(`\nTags:        ${skill.tags.join(", ")}`);
   111→  }
   112→
   113→  // AC: @skill-cli ac-6 - display SKILL.md content
   114→  if (content) {
   115→    console.log(`\n─── SKILL.md Content ───`);
   116→    console.log(content);
   117→  } else {
   118→    console.log(chalk.gray("\n(No SKILL.md content found)"));
   119→  }
   120→}
   121→
   122→/**
   123→ * Register skill commands
   124→ */
   125→export function registerSkillCommands(program: Command): void {
   126→  const skill = program
   127→    .command("skill")
   128→    .description("Skill management commands");
   129→
   130→  // AC: @skill-cli ac-1, ac-2 - kspec skill list
   131→  skill
   132→    .command("list")
   133→    .description("List all skills")
   134→    .option("--origin <origin>", "Filter by origin (core, project, local)")
   135→    .option("--tag <tag>", "Filter by tag")
   136→    .action(async (options) => {
   137→      try {
   138→        const ctx = await initContext();
   139→
   140→        if (!ctx.manifestPath) {
   141→          error(errors.project.noKspecProject);
   142→          process.exit(EXIT_CODES.ERROR);
   143→        }
   144→
   145→        const metaCtx = await loadMetaContext(ctx);
   146→        let skills = metaCtx.skills || [];
   147→
   148→        // Apply filters
   149→        if (options.origin) {
   150→          skills = skills.filter((s) => s.origin === options.origin);
   151→        }
   152→
   153→        if (options.tag) {
   154→          skills = skills.filter((s) => s.tags?.includes(options.tag));
   155→        }
   156→
   157→        // AC: @skill-cli ac-2 - JSON output includes full skill metadata
   158→        output(
   159→          skills.map((s) => ({
   160→            _ulid: s._ulid,
   161→            id: s.id,
   162→            name: s.name,
   163→            description: s.description,
   164→            origin: s.origin,
   165→            version: s.version,
   166→            platforms: s.platforms,
   167→            depends_on: s.depends_on,
   168→            tags: s.tags,
   169→          })),
   170→          // AC: @skill-cli ac-1 - Table output
   171→          () => formatSkillsTable(skills),
   172→        );
   173→      } catch (err) {
   174→        error("Failed to list skills", err);
   175→        process.exit(EXIT_CODES.ERROR);
   176→      }
   177→    });
   178→
   179→  // AC: @skill-cli ac-3, ac-4 - kspec skill add
   180→  // AC: @skill-add ac-3 - --content-file copies existing file to SKILL.md
   181→  markMutating(skill.command("add"))
   182→    .description("Create a new skill")
   183→    .requiredOption("--id <id>", "Skill ID (kebab-case)")
   184→    .requiredOption("--name <name>", "Skill name")
   185→    .option("--description <desc>", "Skill description")
   186→    .option(
   187→      "--origin <origin>",
   188→      "Skill origin (core, project, local)",
   189→      "project",
   190→    )
   191→    .option("--skill-version <version>", "Skill version")
   192→    .option("--platform <platform...>", "Target platforms")
   193→    .option("--tag <tag...>", "Tags for the skill")
   194→    .option("--depends-on <ref...>", "Skill dependencies")
   195→    .option("--content-file <path>", "Path to existing file to use as SKILL.md content")
   196→    .action(async (options) => {
   197→      try {
   198→        const ctx = await initContext();
   199→
   200→        if (!ctx.manifestPath) {
   201→          error(errors.project.noKspecProject);
   202→          process.exit(EXIT_CODES.ERROR);
   203→        }
   204→
   205→        // Validate origin
   206→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   207→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   208→          error(
   209→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   210→          );
   211→          process.exit(EXIT_CODES.ERROR);
   212→        }
   213→
   214→        // Check if skill with this ID already exists
   215→        const metaCtx = await loadMetaContext(ctx);
   216→        const existingSkill = metaCtx.skills.find((s) => s.id === options.id);
   217→        if (existingSkill) {
   218→          error(`Skill with ID '${options.id}' already exists`);
   219→          process.exit(EXIT_CODES.CONFLICT);
   220→        }
   221→
   222→        // Build skill object
   223→        const skillData: Skill = {
   224→          _ulid: ulid(),
   225→          id: options.id,
   226→          name: options.name,
   227→          description: options.description,
   228→          origin: options.origin as SkillOrigin,
   229→          version: options.skillVersion,
   230→          platforms:
   231→            options.platform && options.platform.length > 0
   232→              ? options.platform
   233→              : ["claude-code"],
   234→          depends_on:
   235→            options.dependsOn && options.dependsOn.length > 0
   236→              ? options.dependsOn
   237→              : [],
   238→          tags:
   239→            options.tag && options.tag.length > 0
   240→              ? parseTagsArray(options.tag)
   241→              : [],
   242→        };
   243→
   244→        // Validate with schema
   245→        const parsed = SkillSchema.safeParse(skillData);
   246→        if (!parsed.success) {
   247→          const issues = parsed.error.issues
   248→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   249→            .join("; ");
   250→          error(`Invalid skill data: ${issues}`);
   251→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   252→        }
   253→
   254→        const skill: LoadedSkill = { ...parsed.data };
   255→
   256→        // AC: @skill-cli ac-3 - save meta entry (also creates directory per ac-4)
   257→        await saveMetaItem(ctx, skill, "skill");
   258→
   259→        // AC: @skill-cli ac-4 - create SKILL.md with placeholder content
   260→        // AC: @skill-add ac-3 - if --content-file provided, copy its contents
   261→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   262→        let initialContent: string;
   263→
   264→        if (options.contentFile) {
   265→          // Read content from the specified file
   266→          const contentFilePath = path.isAbsolute(options.contentFile)
   267→            ? options.contentFile
   268→            : path.resolve(process.cwd(), options.contentFile);
   269→
   270→          try {
   271→            initialContent = await fs.readFile(contentFilePath, "utf-8");
   272→          } catch (err) {
   273→            // Clean up: remove the skill we just created
   274→            await deleteMetaItem(ctx, skill._ulid, "skill");
   275→            error(`Failed to read content file: ${contentFilePath}`);
   276→            process.exit(EXIT_CODES.ERROR);
   277→          }
   278→        } else {
   279→          initialContent = `# ${skill.name}\n\n${skill.description || "Add skill content here."}\n`;
   280→        }
   281→
   282→        await fs.writeFile(skillMdPath, initialContent, "utf-8");
   283→
   284→        // Commit changes
   285→        await commitIfShadow(ctx.shadow, "skill-add", skill.id, skill.name);
   286→
   287→        output(skill, () =>
   288→          success(`Created skill: ${skill.id}`, { skill }),
   289→        );
   290→      } catch (err) {
   291→        error("Failed to create skill", err);
   292→        process.exit(EXIT_CODES.ERROR);
   293→      }
   294→    });
   295→
   296→  // AC: @skill-cli ac-5, ac-6 - kspec skill get
   297→  skill
   298→    .command("get <ref>")
   299→    .description("Show skill details")
   300→    .action(async (ref: string) => {
   301→      try {
   302→        const ctx = await initContext();
   303→
   304→        if (!ctx.manifestPath) {
   305→          error(errors.project.noKspecProject);
   306→          process.exit(EXIT_CODES.ERROR);
   307→        }
   308→
   309→        const metaCtx = await loadMetaContext(ctx);
   310→        const item = findMetaItemByRef(metaCtx, ref);
   311→
   312→        if (!item) {
   313→          error(`Skill not found: ${ref}`);
   314→          console.log(chalk.gray("Try: kspec skill list"));
   315→          process.exit(EXIT_CODES.NOT_FOUND);
   316→        }
   317→
   318→        // Check it's a skill
   319→        if (!("origin" in item)) {
   320→          error(`Item ${ref} is not a skill`);
   321→          process.exit(EXIT_CODES.ERROR);
   322→        }
   323→
   324→        const skill = item as LoadedSkill;
   325→
   326→        // AC: @skill-cli ac-6 - load SKILL.md content
   327→        const content = await loadSkillContent(ctx, skill);
   328→        const docs = await loadSkillDocs(ctx, skill);
   329→
   330→        // AC: @skill-cli ac-5, ac-6 - output metadata and content
   331→        output(
   332→          {
   333→            _ulid: skill._ulid,
   334→            id: skill.id,
   335→            name: skill.name,
   336→            description: skill.description,
   337→            origin: skill.origin,
   338→            version: skill.version,
   339→            platforms: skill.platforms,
   340→            depends_on: skill.depends_on,
   341→            tags: skill.tags,
   342→            content,
   343→            docs: docs.map((d) => ({ name: d.name, path: d.path })),
   344→          },
   345→          () => formatSkillDetails(skill, content),
   346→        );
   347→      } catch (err) {
   348→        error("Failed to get skill", err);
   349→        process.exit(EXIT_CODES.ERROR);
   350→      }
   351→    });
   352→
   353→  // AC: @skill-set ac-1, ac-2, ac-3 - kspec skill set
   354→  markMutating(skill.command("set <ref>"))
   355→    .description("Update skill metadata fields")
   356→    .option("--name <name>", "Update skill name")
   357→    .option("--description <desc>", "Update skill description")
   358→    .option("--origin <origin>", "Update skill origin (core, project, local)")
   359→    .option("--skill-version <version>", "Update skill version")
   360→    .option("--add-platform <platform>", "Add a platform to the platforms array")
   361→    .option("--remove-platform <platform>", "Remove a platform from the platforms array")
   362→    .option("--add-tag <tag>", "Add a tag to the tags array")
   363→    .option("--remove-tag <tag>", "Remove a tag from the tags array")
   364→    .option("--add-depends-on <ref>", "Add a dependency reference")
   365→    .option("--remove-depends-on <ref>", "Remove a dependency reference")
   366→    .action(async (ref: string, options) => {
   367→      try {
   368→        const ctx = await initContext();
   369→
   370→        if (!ctx.manifestPath) {
   371→          error(errors.project.noKspecProject);
   372→          process.exit(EXIT_CODES.ERROR);
   373→        }
   374→
   375→        const metaCtx = await loadMetaContext(ctx);
   376→        const item = findMetaItemByRef(metaCtx, ref);
   377→
   378→        if (!item) {
   379→          error(`Skill not found: ${ref}`);
   380→          console.log(chalk.gray("Try: kspec skill list"));
   381→          process.exit(EXIT_CODES.NOT_FOUND);
   382→        }
   383→
   384→        // Check it's a skill
   385→        if (!("origin" in item)) {
   386→          error(`Item ${ref} is not a skill`);
   387→          process.exit(EXIT_CODES.ERROR);
   388→        }
   389→
   390→        const skill = item as LoadedSkill;
   391→
   392→        // AC: @skill-set ac-1 - update description field
   393→        if (options.name !== undefined) {
   394→          skill.name = options.name;
   395→        }
   396→
   397→        if (options.description !== undefined) {
   398→          skill.description = options.description;
   399→        }
   400→
   401→        // Update origin
   402→        if (options.origin !== undefined) {
   403→          const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   404→          if (!validOrigins.includes(options.origin as SkillOrigin)) {
   405→            error(
   406→              `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   407→            );
   408→            process.exit(EXIT_CODES.ERROR);
   409→          }
   410→          skill.origin = options.origin as SkillOrigin;
   411→        }
   412→
   413→        // Update version
   414→        if (options.skillVersion !== undefined) {
   415→          skill.version = options.skillVersion;
   416→        }
   417→
   418→        // AC: @skill-set ac-2 - add platform to array
   419→        if (options.addPlatform) {
   420→          if (!skill.platforms.includes(options.addPlatform)) {
   421→            skill.platforms.push(options.addPlatform);
   422→          }
   423→        }
   424→
   425→        // Remove platform
   426→        if (options.removePlatform) {
   427→          const idx = skill.platforms.indexOf(options.removePlatform);
   428→          if (idx >= 0) {
   429→            skill.platforms.splice(idx, 1);
   430→          }
   431→        }
   432→
   433→        // AC: @skill-set ac-3 - add tag to array
   434→        if (options.addTag) {
   435→          if (!skill.tags) {
   436→            skill.tags = [];
   437→          }
   438→          if (!skill.tags.includes(options.addTag)) {
   439→            skill.tags.push(options.addTag);
   440→          }
   441→        }
   442→
   443→        // Remove tag
   444→        if (options.removeTag && skill.tags) {
   445→          const idx = skill.tags.indexOf(options.removeTag);
   446→          if (idx >= 0) {
   447→            skill.tags.splice(idx, 1);
   448→          }
   449→        }
   450→
   451→        // Add dependency
   452→        if (options.addDependsOn) {
   453→          if (!skill.depends_on) {
   454→            skill.depends_on = [];
   455→          }
   456→          if (!skill.depends_on.includes(options.addDependsOn)) {
   457→            skill.depends_on.push(options.addDependsOn);
   458→          }
   459→        }
   460→
   461→        // Remove dependency
   462→        if (options.removeDependsOn && skill.depends_on) {
   463→          const idx = skill.depends_on.indexOf(options.removeDependsOn);
   464→          if (idx >= 0) {
   465→            skill.depends_on.splice(idx, 1);
   466→          }
   467→        }
   468→
   469→        // Validate updated skill
   470→        const parsed = SkillSchema.safeParse(skill);
   471→        if (!parsed.success) {
   472→          const issues = parsed.error.issues
   473→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   474→            .join("; ");
   475→          error(`Invalid skill data: ${issues}`);
   476→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   477→        }
   478→
   479→        // Save the updated skill
   480→        await saveMetaItem(ctx, skill, "skill");
   481→
   482→        // Commit changes
   483→        await commitIfShadow(ctx.shadow, "skill-set", skill.id, skill.name);
   484→
   485→        output(skill, () => success(`Updated skill: ${skill.id}`));
   486→      } catch (err) {
   487→        error("Failed to update skill", err);
   488→        process.exit(EXIT_CODES.ERROR);
   489→      }
   490→    });
   491→
   492→  // AC: @skill-cli ac-7, ac-8 - kspec skill delete
   493→  markMutating(skill.command("delete <ref>"))
   494→    .description("Delete a skill")
   495→    .option("--confirm", "Skip confirmation prompt")
   496→    .action(async (ref: string, options) => {
   497→      try {
   498→        const ctx = await initContext();
   499→
   500→        if (!ctx.manifestPath) {
   501→          error(errors.project.noKspecProject);
   502→          process.exit(EXIT_CODES.ERROR);
   503→        }
   504→
   505→        const metaCtx = await loadMetaContext(ctx);
   506→        const item = findMetaItemByRef(metaCtx, ref);
   507→
   508→        if (!item) {
   509→          error(`Skill not found: ${ref}`);
   510→          console.log(chalk.gray("Try: kspec skill list"));
   511→          process.exit(EXIT_CODES.NOT_FOUND);
   512→        }
   513→
   514→        // Check it's a skill
   515→        if (!("origin" in item)) {
   516→          error(`Item ${ref} is not a skill`);
   517→          process.exit(EXIT_CODES.ERROR);
   518→        }
   519→
   520→        const skill = item as LoadedSkill;
   521→
   522→        // Check for confirmation
   523→        if (!options.confirm) {
   524→          error(`Confirm deletion of skill '${skill.id}' with --confirm flag`);
   525→          process.exit(EXIT_CODES.ERROR);
   526→        }
   527→
   528→        // Check for dependencies from other skills
   529→        const dependentSkills = metaCtx.skills.filter(
   530→          (s) =>
   531→            s._ulid !== skill._ulid &&
   532→            s.depends_on?.some(
   533→              (dep) =>
   534→                dep === `@${skill.id}` ||
   535→                dep === skill.id ||
   536→                dep.startsWith(`@${skill._ulid.substring(0, 8)}`),
   537→            ),
   538→        );
   539→
   540→        if (dependentSkills.length > 0) {
   541→          const depRefs = dependentSkills.map((s) => `@${s.id}`).join(", ");
   542→          error(
   543→            `Cannot delete skill '${skill.id}': referenced by ${dependentSkills.length} skill(s): ${depRefs}`,
   544→          );
   545→          process.exit(EXIT_CODES.ERROR);
   546→        }
   547→
   548→        // AC: @skill-cli ac-7, ac-8 - delete meta entry and directory
   549→        const deleted = await deleteMetaItem(ctx, skill._ulid, "skill");
   550→
   551→        if (!deleted) {
   552→          error(`Failed to delete skill: ${skill.id}`);
   553→          process.exit(EXIT_CODES.ERROR);
   554→        }
   555→
   556→        // Commit changes
   557→        await commitIfShadow(ctx.shadow, "skill-delete", skill.id);
   558→
   559→        success(`Deleted skill: ${skill.id}`);
   560→      } catch (err) {
   561→        error("Failed to delete skill", err);
   562→        process.exit(EXIT_CODES.ERROR);
   563→      }
   564→    });
   565→
   566→  // AC: @skill-import ac-1 through ac-7 - kspec skill import
   567→  markMutating(skill.command("import <file>"))
   568→    .description("Import an existing SKILL.md file into kspec")
   569→    .option("--id <id>", "Custom skill ID (defaults to directory name)")
   570→    .option("--name <name>", "Skill name (required if no frontmatter)")
   571→    .option("--description <desc>", "Skill description (required if no frontmatter)")
   572→    .option(
   573→      "--origin <origin>",
   574→      "Skill origin (core, project, local)",
   575→      "project",
   576→    )
   577→    .option("--skill-version <version>", "Skill version")
   578→    .action(async (file: string, options) => {
   579→      try {
   580→        const ctx = await initContext();
   581→
   582→        if (!ctx.manifestPath) {
   583→          error(errors.project.noKspecProject);
   584→          process.exit(EXIT_CODES.ERROR);
   585→        }
   586→
   587→        // Resolve file path
   588→        const filePath = path.isAbsolute(file)
   589→          ? file
   590→          : path.resolve(process.cwd(), file);
   591→
   592→        // Check file exists
   593→        try {
   594→          await fs.access(filePath);
   595→        } catch {
   596→          error(`File not found: ${filePath}`);
   597→          process.exit(EXIT_CODES.NOT_FOUND);
   598→        }
   599→
   600→        // Read file content
   601→        const content = await fs.readFile(filePath, "utf-8");
   602→
   603→        // AC: @skill-import ac-1, ac-6 - Parse YAML frontmatter
   604→        const frontmatter = parseFrontmatter(content);
   605→
   606→        // Determine name and description from frontmatter or options
   607→        const skillName = options.name || frontmatter?.name;
   608→        const skillDescription = options.description || frontmatter?.description;
   609→
   610→        // AC: @skill-import ac-6 - Error if no name/description and no frontmatter
   611→        if (!skillName) {
   612→          error("Name is required. Either add YAML frontmatter with 'name' field or use --name option.");
   613→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   614→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   615→        }
   616→
   617→        if (!skillDescription) {
   618→          error("Description is required. Either add YAML frontmatter with 'description' field or use --description option.");
   619→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   620→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   621→        }
   622→
   623→        // AC: @skill-import ac-5 - Derive ID from directory name or use custom
   624→        const sourceDir = path.dirname(filePath);
   625→        const derivedId = path.basename(sourceDir);
   626→        const skillId = options.id || derivedId;
   627→
   628→        // Validate origin
   629→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   630→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   631→          error(
   632→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   633→          );
   634→          process.exit(EXIT_CODES.ERROR);
   635→        }
   636→
   637→        // Check if skill with this ID already exists
   638→        const metaCtx = await loadMetaContext(ctx);
   639→        const existingSkill = metaCtx.skills.find((s) => s.id === skillId);
   640→        if (existingSkill) {
   641→          error(`Skill with ID '${skillId}' already exists. Use --id to specify a different ID.`);
   642→          process.exit(EXIT_CODES.CONFLICT);
   643→        }
   644→
   645→        // Build skill object
   646→        const skillData: Skill = {
   647→          _ulid: ulid(),
   648→          id: skillId,
   649→          name: skillName,
   650→          description: skillDescription,
   651→          origin: options.origin as SkillOrigin,
   652→          version: options.skillVersion,
   653→          platforms: ["claude-code"],
   654→          depends_on: [],
   655→          tags: [],
   656→        };
   657→
   658→        // Validate with schema
   659→        const parsed = SkillSchema.safeParse(skillData);
   660→        if (!parsed.success) {
   661→          const issues = parsed.error.issues
   662→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   663→            .join("; ");
   664→          error(`Invalid skill data: ${issues}`);
   665→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   666→        }
   667→
   668→        const skill: LoadedSkill = { ...parsed.data };
   669→
   670→        // Save meta entry (also creates directory)
   671→        await saveMetaItem(ctx, skill, "skill");
   672→
   673→        // AC: @skill-import ac-7 - Strip/normalize base-directory paths
   674→        const normalizedContent = normalizeBaseDirectory(content);
   675→
   676→        // AC: @skill-import ac-2 - Copy content to .kspec/skills/<id>/SKILL.md
   677→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   678→        await fs.writeFile(skillMdPath, normalizedContent, "utf-8");
   679→
   680→        // AC: @skill-import ac-3 - Copy docs/ subdirectory if present
   681→        const sourceDocsDir = path.join(sourceDir, "docs");
   682→        try {
   683→          const docsStats = await fs.stat(sourceDocsDir);
   684→          if (docsStats.isDirectory()) {
   685→            const targetDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
   686→            await fs.mkdir(targetDocsDir, { recursive: true });
   687→            await copyDirectory(sourceDocsDir, targetDocsDir);
   688→          }
   689→        } catch {
   690→          // No docs directory, that's fine
   691→        }
   692→
   693→        // Commit changes
   694→        await commitIfShadow(ctx.shadow, "skill-import", skill.id, skill.name);
   695→
   696→        output(skill, () =>
   697→          success(`Imported skill: ${skill.id}`, { skill }),
   698→        );
   699→      } catch (err) {
   700→        error("Failed to import skill", err);
   701→        process.exit(EXIT_CODES.ERROR);
   702→      }
   703→    });
   704→
   705→  // AC: @skill-rendering ac-1 through ac-5 - kspec skill render
   706→  // AC: @skill-render-cli ac-1, ac-2 - kspec skill render / kspec skill render @skill-id
   707→  // AC: @skill-drift-detection ac-3, ac-4 - drift handling with --force
   708→  // AC: @trait-dry-run - supports --dry-run
   709→  // AC: @trait-error-guidance - provides error guidance
   710→  skill
   711→    .command("render [ref]")
   712→    .description(
   713→      "Render skills from shadow branch to platform-specific files on main branch"
   714→    )
   715→    .option("--clean", "Remove orphaned managed skill directories")
   716→    .option("--dry-run", "Show what would be changed without applying")
   717→    .option("--force", "Overwrite drifted skill files (manually edited)")
   718→    .option("--skill <id>", "Render only a specific skill (deprecated, use positional arg)")
   719→    .action(async (ref: string | undefined, options) => {
   720→      try {
   721→        const ctx = await initContext();
   722→
   723→        if (!ctx.manifestPath) {
   724→          error(errors.project.noKspecProject);
   725→          console.log(
   726→            chalk.gray("Try: kspec init to initialize a kspec project")
   727→          );
   728→          process.exit(EXIT_CODES.ERROR);
   729→        }
   730→
   731→        const metaCtx = await loadMetaContext(ctx);
   732→        // Use rootDir (project root), not specDir (which is .kspec/ in shadow mode)
   733→        const projectRoot = ctx.rootDir;
   734→        const dryRun = options.dryRun || false;
   735→        const force = options.force || false;
   736→        const results: SkillRenderResult[] = [];
   737→        const cleanResults: CleanResult[] = [];
   738→
   739→        // Filter skills by platform (only claude-code for now)
   740→        let skillsToRender = metaCtx.skills.filter((s) =>
   741→          s.platforms.includes("claude-code")
   742→        );
   743→
   744→        // AC: @skill-render-cli ac-2 - Filter to specific skill if requested
   745→        // Support both positional ref argument and --skill option
   746→        const skillRef = ref || options.skill;
   747→        if (skillRef) {
   748→          // Resolve the ref to a skill
   749→          const item = findMetaItemByRef(metaCtx, skillRef);
   750→          if (!item || !("origin" in item)) {
   751→            error(`Skill not found: ${skillRef}`);
   752→            console.log(chalk.gray("Try: kspec skill list"));
   753→            process.exit(EXIT_CODES.NOT_FOUND);
   754→          }
   755→          const skill = item as LoadedSkill;
   756→          skillsToRender = skillsToRender.filter((s) => s.id === skill.id);
   757→          if (skillsToRender.length === 0) {
   758→            error(`Skill '${skill.id}' does not have claude-code platform`);
   759→            process.exit(EXIT_CODES.ERROR);
   760→          }
   761→        }
   762→
   763→        // Ensure .claude/skills directory exists
   764→        const targetSkillsDir = path.join(projectRoot, ".claude", "skills");
   765→        if (!dryRun) {
   766→          await fs.mkdir(targetSkillsDir, { recursive: true });
   767→        }
   768→
   769→        // Render each skill
   770→        // AC: @skill-drift-detection ac-3, ac-4 - Check drift and skip without --force
   771→        for (const skill of skillsToRender) {
   772→          // Check for drift before rendering
   773→          const driftStatus = await checkSkillDrift(ctx.specDir, projectRoot, skill.id);
   774→
   775→          // AC: @skill-drift-detection ac-3 - Skip drifted skills without --force
   776→          if (driftStatus === "drifted" && !force) {
   777→            const renderedPath = path.join(
   778→              projectRoot,
   779→              ".claude",
   780→              "skills",
   781→              skill.id,
   782→              "SKILL.md"
   783→            );
   784→            results.push({
   785→              id: skill.id,
   786→              action: "skipped",
   787→              path: renderedPath,
   788→              skipReason: "drifted (use --force to overwrite)",
   789→            });
   790→            continue;
   791→          }
   792→
   793→          // AC: @skill-drift-detection ac-4 - Render (overwrite) when --force is used
   794→          const result = await renderSkill(ctx, projectRoot, skill, dryRun);
   795→          results.push(result);
   796→        }
   797→
   798→        // Handle --clean: remove orphaned managed skills
   799→        // AC: @skill-rendering ac-4, ac-5
   800→        if (options.clean) {
   801→          const activeSkillIds = new Set(metaCtx.skills.map((s) => s.id));
   802→
   803→          try {
   804→            const entries = await fs.readdir(targetSkillsDir, {
   805→              withFileTypes: true,
   806→            });
   807→
   808→            for (const entry of entries) {
   809→              if (!entry.isDirectory()) continue;
   810→
   811→              const skillId = entry.name;
   812→              const skillDir = path.join(targetSkillsDir, skillId);
   813→              const skillMdPath = path.join(skillDir, "SKILL.md");
   814→
   815→              // Skip if skill still exists in meta
   816→              if (activeSkillIds.has(skillId)) continue;
   817→
   818→              // AC: @skill-rendering ac-4 - Only consider kspec-managed skills
   819→              const isManaged = await isKspecManaged(skillMdPath);
   820→
   821→              if (isManaged) {
   822→                // AC: @skill-rendering ac-5 - Remove orphaned directory
   823→                if (!dryRun) {
   824→                  await fs.rm(skillDir, { recursive: true, force: true });
   825→                }
   826→                cleanResults.push({
   827→                  id: skillId,
   828→                  path: skillDir,
   829→                  action: "removed",
   830→                });
   831→              } else {
   832→                cleanResults.push({
   833→                  id: skillId,
   834→                  path: skillDir,
   835→                  action: "skipped",
   836→                  reason: "Not managed by kspec",
   837→                });
   838→              }
   839→            }
   840→          } catch {
   841→            // No .claude/skills directory, nothing to clean
   842→          }
   843→        }
   844→
   845→        // Output results
   846→        // AC: @trait-dry-run ac-6 - JSON output includes dry_run field
   847→        output(
   848→          {
   849→            dry_run: dryRun,
   850→            rendered: results,
   851→            cleaned: cleanResults,
   852→          },
   853→          () => {
   854→            // AC: @trait-dry-run ac-3 - Clear indication this is a preview
   855→            if (dryRun) {
   856→              console.log(chalk.yellow("DRY RUN - No changes made"));
   857→              console.log();
   858→            }
   859→
   860→            // Render results
   861→            const created = results.filter((r) => r.action === "created");
   862→            const updated = results.filter((r) => r.action === "updated");
   863→            const unchanged = results.filter((r) => r.action === "unchanged");
   864→            // AC: @skill-drift-detection ac-3 - Track skipped drifted skills
   865→            const skippedDrifted = results.filter((r) => r.action === "skipped");
   866→
   867→            if (created.length > 0) {
   868→              console.log(chalk.green(`Created: ${created.length} skill(s)`));
   869→              for (const r of created) {
   870→                console.log(`  ${chalk.green("+")} ${r.id}`);
   871→              }
   872→            }
   873→
   874→            if (updated.length > 0) {
   875→              console.log(chalk.blue(`Updated: ${updated.length} skill(s)`));
   876→              for (const r of updated) {
   877→                console.log(`  ${chalk.blue("~")} ${r.id}`);
   878→              }
   879→            }
   880→
   881→            if (unchanged.length > 0 && results.length <= 10) {
   882→              console.log(chalk.gray(`Unchanged: ${unchanged.length} skill(s)`));
   883→            }
   884→
   885→            // AC: @skill-drift-detection ac-3 - Show warning for skipped drifted skills
   886→            if (skippedDrifted.length > 0) {
   887→              console.log();
   888→              console.log(chalk.yellow(`Skipped: ${skippedDrifted.length} drifted skill(s)`));
   889→              for (const r of skippedDrifted) {
   890→                console.log(`  ${chalk.yellow("!")} ${r.id}: ${r.skipReason || "drifted"}`);
   891→              }
   892→              console.log();
   893→              console.log(chalk.yellow("Use --force to overwrite drifted skills"));
   894→            }
   895→
   896→            // Clean results
   897→            if (cleanResults.length > 0) {
   898→              const removed = cleanResults.filter((r) => r.action === "removed");
   899→              const skipped = cleanResults.filter((r) => r.action === "skipped");
   900→
   901→              if (removed.length > 0) {
   902→                console.log();
   903→                console.log(chalk.red(`Removed: ${removed.length} orphaned skill(s)`));
   904→                for (const r of removed) {
   905→                  console.log(`  ${chalk.red("-")} ${r.id}`);
   906→                }
   907→              }
   908→
   909→              if (skipped.length > 0) {
   910→                console.log(
   911→                  chalk.gray(`Skipped: ${skipped.length} unmanaged skill(s)`)
   912→                );
   913→              }
   914→            }
   915→
   916→            // Summary
   917→            console.log();
   918→            if (dryRun) {
   919→              console.log(
   920→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
   921→              );
   922→            } else {
   923→              const changedCount = created.length + updated.length;
   924→              const cleanedCount = cleanResults.filter(
   925→                (r) => r.action === "removed"
   926→              ).length;
   927→              if (changedCount > 0 || cleanedCount > 0) {
   928→                success(
   929→                  `Rendered ${changedCount} skill(s)${cleanedCount > 0 ? `, cleaned ${cleanedCount}` : ""}`
   930→                );
   931→              } else {
   932→                console.log(chalk.gray("No changes needed"));
   933→              }
   934→            }
   935→          }
   936→        );
   937→      } catch (err) {
   938→        error("Failed to render skills", err);
   939→        process.exit(EXIT_CODES.ERROR);
   940→      }
   941→    });
   942→
   943→  // AC: @skill-render-cli ac-3 - kspec skill status
   944→  skill
   945→    .command("status")
   946→    .description("Show sync status of rendered skills")
   947→    .action(async () => {
   948→      try {
   949→        const ctx = await initContext();
   950→
   951→        if (!ctx.manifestPath) {
   952→          error(errors.project.noKspecProject);
   953→          console.log(
   954→            chalk.gray("Try: kspec init to initialize a kspec project")
   955→          );
   956→          process.exit(EXIT_CODES.ERROR);
   957→        }
   958→
   959→        const metaCtx = await loadMetaContext(ctx);
   960→        const projectRoot = ctx.rootDir;
   961→
   962→        // Filter skills by platform (only claude-code for now)
   963→        const skillsToCheck = metaCtx.skills.filter((s) =>
   964→          s.platforms.includes("claude-code")
   965→        );
   966→
   967→        if (skillsToCheck.length === 0) {
   968→          console.log(chalk.yellow("No skills found"));
   969→          return;
   970→        }
   971→
   972→        const statusResults: SkillStatusResult[] = [];
   973→
   974→        for (const skill of skillsToCheck) {
   975→          const status = await getSkillSyncStatus(ctx, projectRoot, skill);
   976→          statusResults.push(status);
   977→        }
   978→
   979→        // Output results
   980→        output(
   981→          statusResults,
   982→          () => {
   983→            const table = new Table({
   984→              head: [
   985→                chalk.bold("ID"),
   986→                chalk.bold("Status"),
   987→                chalk.bold("Docs"),
   988→              ],
   989→              style: {
   990→                head: [],
   991→                border: [],
   992→              },
   993→            });
   994→
   995→            for (const result of statusResults) {
   996→              const statusColor =
   997→                result.status === "in-sync"
   998→                  ? chalk.green
   999→                  : result.status === "drifted"
  1000→                    ? chalk.yellow
  1001→                    : chalk.gray;
  1002→
  1003→              const docsStatusColor =
  1004→                result.docsStatus === "in-sync"
  1005→                  ? chalk.green
  1006→                  : result.docsStatus === "drifted"
  1007→                    ? chalk.yellow
  1008→                    : chalk.gray;
  1009→
  1010→              table.push([
  1011→                result.id,
  1012→                statusColor(result.status),
  1013→                docsStatusColor(result.docsStatus || "-"),
  1014→              ]);
  1015→            }
  1016→
  1017→            console.log(table.toString());
  1018→
  1019→            // Summary
  1020→            const inSync = statusResults.filter((r) => r.status === "in-sync").length;
  1021→            const drifted = statusResults.filter((r) => r.status === "drifted").length;
  1022→            const notRendered = statusResults.filter((r) => r.status === "not-rendered").length;
  1023→
  1024→            console.log();
  1025→            if (drifted > 0) {
  1026→              console.log(chalk.yellow(`${drifted} skill(s) drifted - run 'kspec skill render' to sync`));
  1027→            }
  1028→            if (notRendered > 0) {
  1029→              console.log(chalk.gray(`${notRendered} skill(s) not rendered`));
  1030→            }
  1031→            if (inSync === statusResults.length) {
  1032→              console.log(chalk.green("All skills in sync"));
  1033→            }
  1034→          }
  1035→        );
  1036→      } catch (err) {
  1037→        error("Failed to check skill status", err);
  1038→        process.exit(EXIT_CODES.ERROR);
  1039→      }
  1040→    });
  1041→
  1042→  // AC: @skill-render-cli ac-4 - kspec skill diff
  1043→  skill
  1044→    .command("diff <ref>")
  1045→    .description("Show diff between source and rendered skill")
  1046→    .action(async (ref: string) => {
  1047→      try {
  1048→        const ctx = await initContext();
  1049→
  1050→        if (!ctx.manifestPath) {
  1051→          error(errors.project.noKspecProject);
  1052→          console.log(
  1053→            chalk.gray("Try: kspec init to initialize a kspec project")
  1054→          );
  1055→          process.exit(EXIT_CODES.ERROR);
  1056→        }
  1057→
  1058→        const metaCtx = await loadMetaContext(ctx);
  1059→        const item = findMetaItemByRef(metaCtx, ref);
  1060→
  1061→        if (!item) {
  1062→          error(`Skill not found: ${ref}`);
  1063→          console.log(chalk.gray("Try: kspec skill list"));
  1064→          process.exit(EXIT_CODES.NOT_FOUND);
  1065→        }
  1066→
  1067→        // Check it's a skill
  1068→        if (!("origin" in item)) {
  1069→          error(`Item ${ref} is not a skill`);
  1070→          process.exit(EXIT_CODES.ERROR);
  1071→        }
  1072→
  1073→        const skill = item as LoadedSkill;
  1074→        const projectRoot = ctx.rootDir;
  1075→
  1076→        // Get expected rendered content
  1077→        const expectedContent = await getExpectedRenderedContent(ctx, skill);
  1078→
  1079→        // Get actual rendered content
  1080→        const renderedPath = path.join(
  1081→          projectRoot,
  1082→          ".claude",
  1083→          "skills",
  1084→          skill.id,
  1085→          "SKILL.md"
  1086→        );
  1087→
  1088→        let actualContent = "";
  1089→        try {
  1090→          actualContent = await fs.readFile(renderedPath, "utf-8");
  1091→        } catch {
  1092→          // File doesn't exist
  1093→        }
  1094→
  1095→        // Generate diff
  1096→        const diff = generateUnifiedDiff(
  1097→          actualContent,
  1098→          expectedContent,
  1099→          `a/${skill.id}/SKILL.md`,
  1100→          `b/${skill.id}/SKILL.md`
  1101→        );
  1102→
  1103→        // Output
  1104→        output(
  1105→          {
  1106→            id: skill.id,
  1107→            hasDiff: diff.length > 0,
  1108→            diff,
  1109→          },
  1110→          () => {
  1111→            if (diff.length === 0) {
  1112→              console.log(chalk.green(`${skill.id}: in sync`));
  1113→            } else {
  1114→              console.log(chalk.yellow(`${skill.id}: drifted`));
  1115→              console.log();
  1116→              // Print colored diff
  1117→              for (const line of diff) {
  1118→                if (line.startsWith("+") && !line.startsWith("+++")) {
  1119→                  console.log(chalk.green(line));
  1120→                } else if (line.startsWith("-") && !line.startsWith("---")) {
  1121→                  console.log(chalk.red(line));
  1122→                } else if (line.startsWith("@@")) {
  1123→                  console.log(chalk.cyan(line));
  1124→                } else {
  1125→                  console.log(line);
  1126→                }
  1127→              }
  1128→            }
  1129→          }
  1130→        );
  1131→      } catch (err) {
  1132→        error("Failed to generate diff", err);
  1133→        process.exit(EXIT_CODES.ERROR);
  1134→      }
  1135→    });
  1136→}
  1137→
  1138→/**
  1139→ * Parse YAML frontmatter from markdown content.
  1140→ * Returns null if no valid frontmatter found.
  1141→ */
  1142→function parseFrontmatter(content: string): { name?: string; description?: string } | null {
  1143→  const frontmatterRegex = /^---\n([\s\S]*?)\n---/;
  1144→  const match = content.match(frontmatterRegex);
  1145→
  1146→  if (!match) {
  1147→    return null;
  1148→  }
  1149→
  1150→  try {
  1151→    const parsed = yaml.parse(match[1]);
  1152→
  1153→    if (typeof parsed === "object" && parsed !== null) {
  1154→      return {
  1155→        name: typeof parsed.name === "string" ? parsed.name : undefined,
  1156→        description: typeof parsed.description === "string" ? parsed.description : undefined,
  1157→      };
  1158→    }
  1159→  } catch {
  1160→    // Invalid YAML in frontmatter
  1161→  }
  1162→
  1163→  return null;
  1164→}
  1165→
  1166→/**
  1167→ * Normalize base-directory paths in skill content.
  1168→ * AC: @skill-import ac-7 - Strip or convert absolute paths to relative.
  1169→ *
  1170→ * Matches patterns like:
  1171→ * - "Base directory for this skill: /absolute/path/to/skill"
  1172→ * - Lines starting with hardcoded paths
  1173→ */
  1174→function normalizeBaseDirectory(content: string): string {
  1175→  // Remove or normalize "Base directory for this skill:" lines with absolute paths
  1176→  // Common pattern in Claude-generated skill files
  1177→  const baseDirLineRegex = /^Base directory for this skill:.*$/gm;
  1178→
  1179→  return content.replace(baseDirLineRegex, "");
  1180→}
  1181→
  1182→/**
  1183→ * Recursively copy a directory
  1184→ */
  1185→async function copyDirectory(src: string, dest: string): Promise<void> {
  1186→  const entries = await fs.readdir(src, { withFileTypes: true });
  1187→
  1188→  for (const entry of entries) {
  1189→    const srcPath = path.join(src, entry.name);
  1190→    const destPath = path.join(dest, entry.name);
  1191→
  1192→    if (entry.isDirectory()) {
  1193→      await fs.mkdir(destPath, { recursive: true });
  1194→      await copyDirectory(srcPath, destPath);
  1195→    } else {
  1196→      await fs.copyFile(srcPath, destPath);
  1197→    }
  1198→  }
  1199→}
  1200→
  1201→/**
  1202→ * Marker comment that identifies skill directories managed by kspec
  1203→ * AC: @skill-rendering ac-4 - Only skill directories that were rendered by kspec are considered
  1204→ */
  1205→const KSPEC_MANAGED_MARKER = "<!-- kspec-managed -->";
  1206→
  1207→/**
  1208→ * Result of rendering a single skill
  1209→ * AC: @skill-drift-detection ac-3 - Includes "skipped" action for drifted skills
  1210→ */
  1211→interface SkillRenderResult {
  1212→  id: string;
  1213→  action: "created" | "updated" | "unchanged" | "skipped";
  1214→  path: string;
  1215→  docsAction?: "created" | "updated" | "unchanged" | "skipped";
  1216→  /** Reason why skill was skipped */
  1217→  skipReason?: string;
  1218→}
  1219→
  1220→/**
  1221→ * Result of a clean operation
  1222→ */
  1223→interface CleanResult {
  1224→  id: string;
  1225→  path: string;
  1226→  action: "removed" | "skipped";
  1227→  reason?: string;
  1228→}
  1229→
  1230→/**
  1231→ * Generate YAML frontmatter for a skill
  1232→ * AC: @skill-rendering ac-1 - .claude/skills/<id>/SKILL.md is created with YAML frontmatter
  1233→ */
  1234→function generateFrontmatter(skill: LoadedSkill): string {
  1235→  const frontmatter: Record<string, unknown> = {
  1236→    name: skill.id,
  1237→    description: skill.description || skill.name,
  1238→  };
  1239→  return `---\n${yaml.stringify(frontmatter).trim()}\n---`;
  1240→}
  1241→
  1242→/**
  1243→ * Check if two contents are equal (for idempotency check)
  1244→ */
  1245→function contentsEqual(a: string, b: string): boolean {
  1246→  return a.trim() === b.trim();
  1247→}
  1248→
  1249→/**
  1250→ * Check if a directory is managed by kspec
  1251→ * AC: @skill-rendering ac-4 - Only skill directories rendered by kspec are considered
  1252→ */
  1253→async function isKspecManaged(skillMdPath: string): Promise<boolean> {
  1254→  try {
  1255→    const content = await fs.readFile(skillMdPath, "utf-8");
  1256→    return content.includes(KSPEC_MANAGED_MARKER);
  1257→  } catch {
  1258→    return false;
  1259→  }
  1260→}
  1261→
  1262→/**
  1263→ * Compute SHA256 hash of content
  1264→ * AC: @skill-drift-detection ac-5 - Hash computation for render tracking
  1265→ */
  1266→function computeContentHash(content: string): string {
  1267→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
  1268→}
  1269→
  1270→/**
  1271→ * Get the path to the render hash file for a skill
  1272→ * AC: @skill-drift-detection ac-5 - Hash stored in .kspec/skills/<id>/.render-hash
  1273→ */
  1274→function getRenderHashPath(specDir: string, skillId: string): string {
  1275→  return path.join(specDir, "skills", skillId, ".render-hash");
  1276→}
  1277→
  1278→/**
  1279→ * Read the stored render hash for a skill
  1280→ * AC: @skill-drift-detection ac-5 - Read hash from .kspec/skills/<id>/.render-hash
  1281→ */
  1282→async function readRenderHash(specDir: string, skillId: string): Promise<string | null> {
  1283→  try {
  1284→    const hashPath = getRenderHashPath(specDir, skillId);
  1285→    const content = await fs.readFile(hashPath, "utf-8");
  1286→    return content.trim();
  1287→  } catch {
  1288→    return null;
  1289→  }
  1290→}
  1291→
  1292→/**
  1293→ * Write the render hash for a skill
  1294→ * AC: @skill-drift-detection ac-5 - Store hash in .kspec/skills/<id>/.render-hash
  1295→ */
  1296→async function writeRenderHash(specDir: string, skillId: string, hash: string): Promise<void> {
  1297→  const hashPath = getRenderHashPath(specDir, skillId);
  1298→  await fs.mkdir(path.dirname(hashPath), { recursive: true });
  1299→  await fs.writeFile(hashPath, hash + "\n", "utf-8");
  1300→}
  1301→
  1302→/**
  1303→ * Check if a rendered skill has drifted from its last render
  1304→ * AC: @skill-drift-detection ac-1, ac-2 - Drift detection via hash comparison
  1305→ *
  1306→ * Returns:
  1307→ * - "not-rendered": Rendered file doesn't exist
  1308→ * - "in-sync": Rendered file matches stored hash
  1309→ * - "drifted": Rendered file differs from stored hash (manually edited)
  1310→ * - "no-hash": Rendered file exists but no stored hash (first render or hash deleted)
  1311→ */
  1312→async function checkSkillDrift(
  1313→  specDir: string,
  1314→  projectRoot: string,
  1315→  skillId: string
  1316→): Promise<"not-rendered" | "in-sync" | "drifted" | "no-hash"> {
  1317→  const renderedPath = path.join(projectRoot, ".claude", "skills", skillId, "SKILL.md");
  1318→
  1319→  // Check if rendered file exists
  1320→  let renderedContent: string;
  1321→  try {
  1322→    renderedContent = await fs.readFile(renderedPath, "utf-8");
  1323→  } catch {
  1324→    return "not-rendered";
  1325→  }
  1326→
  1327→  // Get stored hash
  1328→  const storedHash = await readRenderHash(specDir, skillId);
  1329→  if (!storedHash) {
  1330→    return "no-hash";
  1331→  }
  1332→
  1333→  // Compare hashes
  1334→  const currentHash = computeContentHash(renderedContent);
  1335→  return currentHash === storedHash ? "in-sync" : "drifted";
  1336→}
  1337→
  1338→/**
  1339→ * Recursively check if two directories have the same contents
  1340→ */
  1341→async function directoriesEqual(src: string, dest: string): Promise<boolean> {
  1342→  try {
  1343→    const srcEntries = await fs.readdir(src, { withFileTypes: true });
  1344→    const destEntries = await fs.readdir(dest, { withFileTypes: true });
  1345→
  1346→    // Different number of entries = not equal
  1347→    if (srcEntries.length !== destEntries.length) {
  1348→      return false;
  1349→    }
  1350→
  1351→    // Create a map of dest entries for quick lookup
  1352→    const destMap = new Map(destEntries.map((e) => [e.name, e]));
  1353→
  1354→    for (const srcEntry of srcEntries) {
  1355→      const destEntry = destMap.get(srcEntry.name);
  1356→      if (!destEntry) {
  1357→        return false;
  1358→      }
  1359→
  1360→      const srcPath = path.join(src, srcEntry.name);
  1361→      const destPath = path.join(dest, srcEntry.name);
  1362→
  1363→      if (srcEntry.isDirectory() && destEntry.isDirectory()) {
  1364→        if (!(await directoriesEqual(srcPath, destPath))) {
  1365→          return false;
  1366→        }
  1367→      } else if (srcEntry.isFile() && destEntry.isFile()) {
  1368→        const srcContent = await fs.readFile(srcPath, "utf-8");
  1369→        const destContent = await fs.readFile(destPath, "utf-8");
  1370→        if (!contentsEqual(srcContent, destContent)) {
  1371→          return false;
  1372→        }
  1373→      } else {
  1374→        // Type mismatch
  1375→        return false;
  1376→      }
  1377→    }
  1378→
  1379→    return true;
  1380→  } catch {
  1381→    return false;
  1382→  }
  1383→}
  1384→
  1385→/**
  1386→ * Get the target path for rendered skills (main branch .claude/skills/)
  1387→ */
  1388→function getRenderedSkillPath(projectRoot: string, skillId: string): string {
  1389→  return path.join(projectRoot, ".claude", "skills", skillId);
  1390→}
  1391→
  1392→/**
  1393→ * Render a single skill from shadow branch to main branch.
  1394→ * AC: @skill-rendering ac-1 - Creates .claude/skills/<id>/SKILL.md with YAML frontmatter
  1395→ * AC: @skill-rendering ac-2 - Copies docs to .claude/skills/<id>/docs/
  1396→ * AC: @skill-rendering ac-3 - Idempotent (no changes if content unchanged)
  1397→ */
  1398→async function renderSkill(
  1399→  ctx: KspecContext,
  1400→  projectRoot: string,
  1401→  skill: LoadedSkill,
  1402→  dryRun: boolean
  1403→): Promise<SkillRenderResult> {
  1404→  const targetDir = getRenderedSkillPath(projectRoot, skill.id);
  1405→  const targetSkillMd = path.join(targetDir, "SKILL.md");
  1406→
  1407→  // Load source content
  1408→  const sourceContent = await loadSkillContent(ctx, skill);
  1409→  if (!sourceContent) {
  1410→    // No source content, but skill exists in meta - create placeholder
  1411→    const frontmatter = generateFrontmatter(skill);
  1412→    const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
  1413→
  1414→    if (!dryRun) {
  1415→      await fs.mkdir(targetDir, { recursive: true });
  1416→      await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
  1417→      // AC: @skill-drift-detection ac-5 - Store hash of rendered output
  1418→      const hash = computeContentHash(renderedContent);
  1419→      await writeRenderHash(ctx.specDir, skill.id, hash);
  1420→    }
  1421→
  1422→    return {
  1423→      id: skill.id,
  1424→      action: "created",
  1425→      path: targetSkillMd,
  1426→    };
  1427→  }
  1428→
  1429→  // Generate rendered content with frontmatter and marker
  1430→  const frontmatter = generateFrontmatter(skill);
  1431→
  1432→  // Check if source already has frontmatter - if so, strip it
  1433→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
  1434→  const contentWithoutFrontmatter = frontmatterMatch
  1435→    ? sourceContent.slice(frontmatterMatch[0].length)
  1436→    : sourceContent;
  1437→
  1438→  // Build the rendered content
  1439→  const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
  1440→
  1441→  // Check if target exists and compare for idempotency
  1442→  // AC: @skill-rendering ac-3 - No changes if content unchanged
  1443→  let targetExists = false;
  1444→  let targetContent = "";
  1445→  try {
  1446→    targetContent = await fs.readFile(targetSkillMd, "utf-8");
  1447→    targetExists = true;
  1448→  } catch {
  1449→    // Target doesn't exist
  1450→  }
  1451→
  1452→  // Determine action based on comparison
  1453→  let action: "created" | "updated" | "unchanged";
  1454→
  1455→  if (!targetExists) {
  1456→    action = "created";
  1457→  } else if (contentsEqual(renderedContent, targetContent)) {
  1458→    action = "unchanged";
  1459→  } else {
  1460→    action = "updated";
  1461→  }
  1462→
  1463→  // Apply changes if not dry run and there are changes
  1464→  if (!dryRun && action !== "unchanged") {
  1465→    await fs.mkdir(targetDir, { recursive: true });
  1466→    await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
  1467→    // AC: @skill-drift-detection ac-5 - Store hash of rendered output
  1468→    const hash = computeContentHash(renderedContent);
  1469→    await writeRenderHash(ctx.specDir, skill.id, hash);
  1470→  }
  1471→
  1472→  // Handle docs directory
  1473→  // AC: @skill-rendering ac-2 - Copy docs to target
  1474→  const sourceDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
  1475→  const targetDocsDir = path.join(targetDir, "docs");
  1476→  let docsAction: "created" | "updated" | "unchanged" | "skipped" = "skipped";
  1477→
  1478→  try {
  1479→    const stats = await fs.stat(sourceDocsDir);
  1480→    if (stats.isDirectory()) {
  1481→      // Check if target docs exist and compare
  1482→      let targetDocsExist = false;
  1483→      try {
  1484→        await fs.stat(targetDocsDir);
  1485→        targetDocsExist = true;
  1486→      } catch {
  1487→        // Target docs don't exist
  1488→      }
  1489→
  1490→      if (!targetDocsExist) {
  1491→        docsAction = "created";
  1492→      } else {
  1493→        // Compare directories
  1494→        const equal = await directoriesEqual(sourceDocsDir, targetDocsDir);
  1495→        docsAction = equal ? "unchanged" : "updated";
  1496→      }
  1497→
  1498→      // Apply changes
  1499→      if (!dryRun && docsAction !== "unchanged") {
  1500→        // Remove existing docs and copy fresh
  1501→        if (targetDocsExist) {
  1502→          await fs.rm(targetDocsDir, { recursive: true, force: true });
  1503→        }
  1504→        await fs.mkdir(targetDocsDir, { recursive: true });
  1505→        await copyDirectory(sourceDocsDir, targetDocsDir);
  1506→      }
  1507→    }
  1508→  } catch {
  1509→    // No source docs directory
  1510→  }
  1511→
  1512→  return {
  1513→    id: skill.id,
  1514→    action,
  1515→    path: targetSkillMd,
  1516→    docsAction,
  1517→  };
  1518→}
  1519→
  1520→/**
  1521→ * Result of checking a skill's sync status
  1522→ * AC: @skill-render-cli ac-3
  1523→ */
  1524→interface SkillStatusResult {
  1525→  id: string;
  1526→  status: "in-sync" | "drifted" | "not-rendered";
  1527→  docsStatus?: "in-sync" | "drifted" | "not-rendered" | "no-docs";
  1528→}
  1529→
  1530→/**
  1531→ * Get the sync status of a skill
  1532→ * AC: @skill-render-cli ac-3
  1533→ * AC: @skill-drift-detection ac-1, ac-2 - Uses hash-based drift detection
  1534→ */
  1535→async function getSkillSyncStatus(
  1536→  ctx: KspecContext,
  1537→  projectRoot: string,
  1538→  skill: LoadedSkill
  1539→): Promise<SkillStatusResult> {
  1540→  // AC: @skill-drift-detection ac-1, ac-2 - Use hash-based drift detection
  1541→  const driftStatus = await checkSkillDrift(ctx.specDir, projectRoot, skill.id);
  1542→
  1543→  // Map drift status to sync status
  1544→  let status: "in-sync" | "drifted" | "not-rendered";
  1545→  switch (driftStatus) {
  1546→    case "in-sync":
  1547→      status = "in-sync";
  1548→      break;
  1549→    case "drifted":
  1550→      status = "drifted";
  1551→      break;
  1552→    case "not-rendered":
  1553→      status = "not-rendered";
  1554→      break;
  1555→    case "no-hash":
  1556→      // No hash stored - need to check if content matches expected
  1557→      // (handles edge case where skill was rendered before hash tracking was added)
  1558→      const expectedContent = await getExpectedRenderedContent(ctx, skill);
  1559→      const renderedPath = path.join(
  1560→        projectRoot,
  1561→        ".claude",
  1562→        "skills",
  1563→        skill.id,
  1564→        "SKILL.md"
  1565→      );
  1566→      try {
  1567→        const actualContent = await fs.readFile(renderedPath, "utf-8");
  1568→        status = contentsEqual(expectedContent, actualContent) ? "in-sync" : "drifted";
  1569→      } catch {
  1570→        status = "not-rendered";
  1571→      }
  1572→      break;
  1573→  }
  1574→
  1575→  // Check docs status
  1576→  const sourceDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
  1577→  const targetDocsDir = path.join(projectRoot, ".claude", "skills", skill.id, "docs");
  1578→  let docsStatus: "in-sync" | "drifted" | "not-rendered" | "no-docs" = "no-docs";
  1579→
  1580→  try {
  1581→    await fs.stat(sourceDocsDir);
  1582→    // Source docs exist, check target
  1583→    try {
  1584→      await fs.stat(targetDocsDir);
  1585→      // Both exist, compare
  1586→      const equal = await directoriesEqual(sourceDocsDir, targetDocsDir);
  1587→      docsStatus = equal ? "in-sync" : "drifted";
  1588→    } catch {
  1589→      docsStatus = "not-rendered";
  1590→    }
  1591→  } catch {
  1592→    // No source docs
  1593→    docsStatus = "no-docs";
  1594→  }
  1595→
  1596→  return {
  1597→    id: skill.id,
  1598→    status,
  1599→    docsStatus,
  1600→  };
  1601→}
  1602→
  1603→/**
  1604→ * Get the expected rendered content for a skill
  1605→ */
  1606→async function getExpectedRenderedContent(
  1607→  ctx: KspecContext,
  1608→  skill: LoadedSkill
  1609→): Promise<string> {
  1610→  const sourceContent = await loadSkillContent(ctx, skill);
  1611→
  1612→  if (!sourceContent) {
  1613→    // No source content, generate placeholder
  1614→    const frontmatter = generateFrontmatter(skill);
  1615→    return `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
  1616→  }
  1617→
  1618→  // Generate rendered content with frontmatter and marker
  1619→  const frontmatter = generateFrontmatter(skill);
  1620→
  1621→  // Check if source already has frontmatter - if so, strip it
  1622→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
  1623→  const contentWithoutFrontmatter = frontmatterMatch
  1624→    ? sourceContent.slice(frontmatterMatch[0].length)
  1625→    : sourceContent;
  1626→
  1627→  return `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
  1628→}
  1629→
  1630→/**
  1631→ * Generate unified diff between two strings
  1632→ * AC: @skill-render-cli ac-4
  1633→ */
  1634→function generateUnifiedDiff(
  1635→  actual: string,
  1636→  expected: string,
  1637→  actualPath: string,
  1638→  expectedPath: string
  1639→): string[] {
  1640→  if (contentsEqual(actual, expected)) {
  1641→    return [];
  1642→  }
  1643→
  1644→  const actualLines = actual.split("\n");
  1645→  const expectedLines = expected.split("\n");
  1646→  const diffLines: string[] = [];
  1647→
  1648→  // Simple line-by-line diff (unified format)
  1649→  diffLines.push(`--- ${actualPath}`);
  1650→  diffLines.push(`+++ ${expectedPath}`);
  1651→
  1652→  // Find differing sections and create hunks
  1653→  let i = 0;
  1654→  let j = 0;
  1655→
  1656→  while (i < actualLines.length || j < expectedLines.length) {
  1657→    // Find start of difference
  1658→    const contextStart = i;
  1659→    const contextStartExpected = j;
  1660→
  1661→    // Skip matching lines
  1662→    while (
  1663→      i < actualLines.length &&
  1664→      j < expectedLines.length &&
  1665→      actualLines[i] === expectedLines[j]
  1666→    ) {
  1667→      i++;
  1668→      j++;
  1669→    }
  1670→
  1671→    // If we've reached the end, we're done
  1672→    if (i >= actualLines.length && j >= expectedLines.length) {
  1673→      break;
  1674→    }
  1675→
  1676→    // Find end of difference
  1677→    let diffEndActual = i;
  1678→    let diffEndExpected = j;
  1679→
  1680→    // Collect differing lines
  1681→    while (
  1682→      diffEndActual < actualLines.length &&
  1683→      diffEndExpected < expectedLines.length &&
  1684→      actualLines[diffEndActual] !== expectedLines[diffEndExpected]
  1685→    ) {
  1686→      diffEndActual++;
  1687→      diffEndExpected++;
  1688→    }
  1689→
  1690→    // Also handle case where one side has more lines
  1691→    while (diffEndActual < actualLines.length && diffEndExpected >= expectedLines.length) {
  1692→      diffEndActual++;
  1693→    }
  1694→    while (diffEndExpected < expectedLines.length && diffEndActual >= actualLines.length) {
  1695→      diffEndExpected++;
  1696→    }
  1697→
  1698→    // Create hunk header (show 3 lines of context)
  1699→    const hunkStartActual = Math.max(0, contextStart - 3);
  1700→    const hunkStartExpected = Math.max(0, contextStartExpected - 3);
  1701→
  1702→    // Include context after diff too
  1703→    const hunkEndActual = Math.min(actualLines.length, diffEndActual + 3);
  1704→    const hunkEndExpected = Math.min(expectedLines.length, diffEndExpected + 3);
  1705→
  1706→    const actualCount = hunkEndActual - hunkStartActual;
  1707→    const expectedCount = hunkEndExpected - hunkStartExpected;
  1708→
  1709→    diffLines.push(
  1710→      `@@ -${hunkStartActual + 1},${actualCount} +${hunkStartExpected + 1},${expectedCount} @@`
  1711→    );
  1712→
  1713→    // Leading context
  1714→    for (let k = hunkStartActual; k < contextStart; k++) {
  1715→      diffLines.push(` ${actualLines[k]}`);
  1716→    }
  1717→
  1718→    // Removed lines (from actual)
  1719→    for (let k = contextStart; k < diffEndActual; k++) {
  1720→      if (k < actualLines.length) {
  1721→        diffLines.push(`-${actualLines[k]}`);
  1722→      }
  1723→    }
  1724→
  1725→    // Added lines (from expected)
  1726→    for (let k = contextStartExpected; k < diffEndExpected; k++) {
  1727→      if (k < expectedLines.length) {
  1728→        diffLines.push(`+${expectedLines[k]}`);
  1729→      }
  1730→    }
  1731→
  1732→    // Trailing context
  1733→    for (let k = diffEndActual; k < hunkEndActual; k++) {
  1734→      if (k < actualLines.length) {
  1735→        diffLines.push(` ${actualLines[k]}`);
  1736→      }
  1737→    }
  1738→
  1739→    i = hunkEndActual;
  1740→    j = hunkEndExpected;
  1741→  }
  1742→
  1743→  return diffLines;
  1744→}
  1745→
