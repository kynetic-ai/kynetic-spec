```
     1→/**
     2→ * Skill CLI commands for managing skills.
     3→ *
     4→ * AC: @skill-cli ac-1 - kspec skill list outputs table with ID, Name, Origin, Version, Platforms
     5→ * AC: @skill-cli ac-2 - kspec skill list --json outputs JSON array with full skill metadata
     6→ * AC: @skill-cli ac-3 - kspec skill add creates meta entry with origin custom
     7→ * AC: @skill-cli ac-4 - kspec skill add creates .kspec/skills/<id>/SKILL.md
     8→ * AC: @skill-cli ac-5 - kspec skill get outputs metadata including id, name, origin, platforms
     9→ * AC: @skill-cli ac-6 - kspec skill get outputs SKILL.md content
    10→ * AC: @skill-cli ac-7 - kspec skill delete --confirm removes meta entry
    11→ * AC: @skill-cli ac-8 - kspec skill delete removes .kspec/skills/<id>/ directory
    12→ */
    13→
    14→import * as fs from "node:fs/promises";
    15→import * as path from "node:path";
    16→import chalk from "chalk";
    17→import Table from "cli-table3";
    18→import type { Command } from "commander";
    19→import { ulid } from "ulid";
    20→import { markMutating } from "../command-annotations.js";
    21→import {
    22→  deleteMetaItem,
    23→  findMetaItemByRef,
    24→  getSkillContentPath,
    25→  initContext,
    26→  loadMetaContext,
    27→  loadSkillContent,
    28→  loadSkillDocs,
    29→  type LoadedSkill,
    30→  saveMetaItem,
    31→  type Skill,
    32→} from "../../parser/index.js";
    33→import { commitIfShadow } from "../../parser/shadow.js";
    34→import { SkillSchema, type SkillOrigin } from "../../schema/index.js";
    35→import { errors } from "../../strings/errors.js";
    36→import { EXIT_CODES } from "../exit-codes.js";
    37→import { error, output, success } from "../output.js";
    38→import { parseTagsArray } from "../parse-utils.js";
    39→
    40→/**
    41→ * Format skills as a table
    42→ * AC: @skill-cli ac-1 - table displays ID, Name, Origin, Version, Platforms
    43→ */
    44→function formatSkillsTable(skills: LoadedSkill[]): void {
    45→  if (skills.length === 0) {
    46→    console.log(chalk.yellow("No skills defined"));
    47→    return;
    48→  }
    49→
    50→  const table = new Table({
    51→    head: [
    52→      chalk.bold("ID"),
    53→      chalk.bold("Name"),
    54→      chalk.bold("Origin"),
    55→      chalk.bold("Version"),
    56→      chalk.bold("Platforms"),
    57→    ],
    58→    style: {
    59→      head: [],
    60→      border: [],
    61→    },
    62→  });
    63→
    64→  for (const skill of skills) {
    65→    table.push([
    66→      skill.id,
    67→      skill.name,
    68→      skill.origin,
    69→      skill.version || "-",
    70→      skill.platforms.join(", "),
    71→    ]);
    72→  }
    73→
    74→  console.log(table.toString());
    75→  console.log(chalk.gray(`\n${skills.length} skill(s)`));
    76→}
    77→
    78→/**
    79→ * Format skill details
    80→ * AC: @skill-cli ac-5 - outputs metadata including id, name, origin, platforms
    81→ */
    82→function formatSkillDetails(skill: LoadedSkill, content: string | null): void {
    83→  console.log(chalk.bold(skill.name));
    84→  console.log(chalk.gray("─".repeat(40)));
    85→  console.log(`ID:          ${skill.id}`);
    86→  console.log(`ULID:        ${skill._ulid}`);
    87→  console.log(`Origin:      ${skill.origin}`);
    88→  console.log(`Platforms:   ${skill.platforms.join(", ")}`);
    89→
    90→  if (skill.version) {
    91→    console.log(`Version:     ${skill.version}`);
    92→  }
    93→
    94→  if (skill.description) {
    95→    console.log(`\n─── Description ───`);
    96→    console.log(skill.description);
    97→  }
    98→
    99→  if (skill.depends_on && skill.depends_on.length > 0) {
   100→    console.log(`\n─── Dependencies ───`);
   101→    for (const dep of skill.depends_on) {
   102→      console.log(`  • ${dep}`);
   103→    }
   104→  }
   105→
   106→  if (skill.tags && skill.tags.length > 0) {
   107→    console.log(`\nTags:        ${skill.tags.join(", ")}`);
   108→  }
   109→
   110→  // AC: @skill-cli ac-6 - display SKILL.md content
   111→  if (content) {
   112→    console.log(`\n─── SKILL.md Content ───`);
   113→    console.log(content);
   114→  } else {
   115→    console.log(chalk.gray("\n(No SKILL.md content found)"));
   116→  }
   117→}
   118→
   119→/**
   120→ * Register skill commands
   121→ */
   122→export function registerSkillCommands(program: Command): void {
   123→  const skill = program
   124→    .command("skill")
   125→    .description("Skill management commands");
   126→
   127→  // AC: @skill-cli ac-1, ac-2 - kspec skill list
   128→  skill
   129→    .command("list")
   130→    .description("List all skills")
   131→    .option("--origin <origin>", "Filter by origin (core, project, local)")
   132→    .option("--tag <tag>", "Filter by tag")
   133→    .action(async (options) => {
   134→      try {
   135→        const ctx = await initContext();
   136→
   137→        if (!ctx.manifestPath) {
   138→          error(errors.project.noKspecProject);
   139→          process.exit(EXIT_CODES.ERROR);
   140→        }
   141→
   142→        const metaCtx = await loadMetaContext(ctx);
   143→        let skills = metaCtx.skills || [];
   144→
   145→        // Apply filters
   146→        if (options.origin) {
   147→          skills = skills.filter((s) => s.origin === options.origin);
   148→        }
   149→
   150→        if (options.tag) {
   151→          skills = skills.filter((s) => s.tags?.includes(options.tag));
   152→        }
   153→
   154→        // AC: @skill-cli ac-2 - JSON output includes full skill metadata
   155→        output(
   156→          skills.map((s) => ({
   157→            _ulid: s._ulid,
   158→            id: s.id,
   159→            name: s.name,
   160→            description: s.description,
   161→            origin: s.origin,
   162→            version: s.version,
   163→            platforms: s.platforms,
   164→            depends_on: s.depends_on,
   165→            tags: s.tags,
   166→          })),
   167→          // AC: @skill-cli ac-1 - Table output
   168→          () => formatSkillsTable(skills),
   169→        );
   170→      } catch (err) {
   171→        error("Failed to list skills", err);
   172→        process.exit(EXIT_CODES.ERROR);
   173→      }
   174→    });
   175→
   176→  // AC: @skill-cli ac-3, ac-4 - kspec skill add
   177→  // AC: @skill-add ac-3 - --content-file copies existing file to SKILL.md
   178→  markMutating(skill.command("add"))
   179→    .description("Create a new skill")
   180→    .requiredOption("--id <id>", "Skill ID (kebab-case)")
   181→    .requiredOption("--name <name>", "Skill name")
   182→    .option("--description <desc>", "Skill description")
   183→    .option(
   184→      "--origin <origin>",
   185→      "Skill origin (core, project, local)",
   186→      "project",
   187→    )
   188→    .option("--skill-version <version>", "Skill version")
   189→    .option("--platform <platform...>", "Target platforms")
   190→    .option("--tag <tag...>", "Tags for the skill")
   191→    .option("--depends-on <ref...>", "Skill dependencies")
   192→    .option("--content-file <path>", "Path to existing file to use as SKILL.md content")
   193→    .action(async (options) => {
   194→      try {
   195→        const ctx = await initContext();
   196→
   197→        if (!ctx.manifestPath) {
   198→          error(errors.project.noKspecProject);
   199→          process.exit(EXIT_CODES.ERROR);
   200→        }
   201→
   202→        // Validate origin
   203→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   204→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   205→          error(
   206→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   207→          );
   208→          process.exit(EXIT_CODES.ERROR);
   209→        }
   210→
   211→        // Check if skill with this ID already exists
   212→        const metaCtx = await loadMetaContext(ctx);
   213→        const existingSkill = metaCtx.skills.find((s) => s.id === options.id);
   214→        if (existingSkill) {
   215→          error(`Skill with ID '${options.id}' already exists`);
   216→          process.exit(EXIT_CODES.CONFLICT);
   217→        }
   218→
   219→        // Build skill object
   220→        const skillData: Skill = {
   221→          _ulid: ulid(),
   222→          id: options.id,
   223→          name: options.name,
   224→          description: options.description,
   225→          origin: options.origin as SkillOrigin,
   226→          version: options.skillVersion,
   227→          platforms:
   228→            options.platform && options.platform.length > 0
   229→              ? options.platform
   230→              : ["claude-code"],
   231→          depends_on:
   232→            options.dependsOn && options.dependsOn.length > 0
   233→              ? options.dependsOn
   234→              : [],
   235→          tags:
   236→            options.tag && options.tag.length > 0
   237→              ? parseTagsArray(options.tag)
   238→              : [],
   239→        };
   240→
   241→        // Validate with schema
   242→        const parsed = SkillSchema.safeParse(skillData);
   243→        if (!parsed.success) {
   244→          const issues = parsed.error.issues
   245→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   246→            .join("; ");
   247→          error(`Invalid skill data: ${issues}`);
   248→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   249→        }
   250→
   251→        const skill: LoadedSkill = { ...parsed.data };
   252→
   253→        // AC: @skill-cli ac-3 - save meta entry (also creates directory per ac-4)
   254→        await saveMetaItem(ctx, skill, "skill");
   255→
   256→        // AC: @skill-cli ac-4 - create SKILL.md with placeholder content
   257→        // AC: @skill-add ac-3 - if --content-file provided, copy its contents
   258→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   259→        let initialContent: string;
   260→
   261→        if (options.contentFile) {
   262→          // Read content from the specified file
   263→          const contentFilePath = path.isAbsolute(options.contentFile)
   264→            ? options.contentFile
   265→            : path.resolve(process.cwd(), options.contentFile);
   266→
   267→          try {
   268→            initialContent = await fs.readFile(contentFilePath, "utf-8");
   269→          } catch (err) {
   270→            // Clean up: remove the skill we just created
   271→            await deleteMetaItem(ctx, skill._ulid, "skill");
   272→            error(`Failed to read content file: ${contentFilePath}`);
   273→            process.exit(EXIT_CODES.ERROR);
   274→          }
   275→        } else {
   276→          initialContent = `# ${skill.name}\n\n${skill.description || "Add skill content here."}\n`;
   277→        }
   278→
   279→        await fs.writeFile(skillMdPath, initialContent, "utf-8");
   280→
   281→        // Commit changes
   282→        await commitIfShadow(ctx.shadow, "skill-add", skill.id, skill.name);
   283→
   284→        output(skill, () =>
   285→          success(`Created skill: ${skill.id}`, { skill }),
   286→        );
   287→      } catch (err) {
   288→        error("Failed to create skill", err);
   289→        process.exit(EXIT_CODES.ERROR);
   290→      }
   291→    });
   292→
   293→  // AC: @skill-cli ac-5, ac-6 - kspec skill get
   294→  skill
   295→    .command("get <ref>")
   296→    .description("Show skill details")
   297→    .action(async (ref: string) => {
   298→      try {
   299→        const ctx = await initContext();
   300→
   301→        if (!ctx.manifestPath) {
   302→          error(errors.project.noKspecProject);
   303→          process.exit(EXIT_CODES.ERROR);
   304→        }
   305→
   306→        const metaCtx = await loadMetaContext(ctx);
   307→        const item = findMetaItemByRef(metaCtx, ref);
   308→
   309→        if (!item) {
   310→          error(`Skill not found: ${ref}`);
   311→          console.log(chalk.gray("Try: kspec skill list"));
   312→          process.exit(EXIT_CODES.NOT_FOUND);
   313→        }
   314→
   315→        // Check it's a skill
   316→        if (!("origin" in item)) {
   317→          error(`Item ${ref} is not a skill`);
   318→          process.exit(EXIT_CODES.ERROR);
   319→        }
   320→
   321→        const skill = item as LoadedSkill;
   322→
   323→        // AC: @skill-cli ac-6 - load SKILL.md content
   324→        const content = await loadSkillContent(ctx, skill);
   325→        const docs = await loadSkillDocs(ctx, skill);
   326→
   327→        // AC: @skill-cli ac-5, ac-6 - output metadata and content
   328→        output(
   329→          {
   330→            _ulid: skill._ulid,
   331→            id: skill.id,
   332→            name: skill.name,
   333→            description: skill.description,
   334→            origin: skill.origin,
   335→            version: skill.version,
   336→            platforms: skill.platforms,
   337→            depends_on: skill.depends_on,
   338→            tags: skill.tags,
   339→            content,
   340→            docs: docs.map((d) => ({ name: d.name, path: d.path })),
   341→          },
   342→          () => formatSkillDetails(skill, content),
   343→        );
   344→      } catch (err) {
   345→        error("Failed to get skill", err);
   346→        process.exit(EXIT_CODES.ERROR);
   347→      }
   348→    });
   349→
   350→  // AC: @skill-set ac-1, ac-2, ac-3 - kspec skill set
   351→  markMutating(skill.command("set <ref>"))
   352→    .description("Update skill metadata fields")
   353→    .option("--name <name>", "Update skill name")
   354→    .option("--description <desc>", "Update skill description")
   355→    .option("--origin <origin>", "Update skill origin (core, project, local)")
   356→    .option("--skill-version <version>", "Update skill version")
   357→    .option("--add-platform <platform>", "Add a platform to the platforms array")
   358→    .option("--remove-platform <platform>", "Remove a platform from the platforms array")
   359→    .option("--add-tag <tag>", "Add a tag to the tags array")
   360→    .option("--remove-tag <tag>", "Remove a tag from the tags array")
   361→    .option("--add-depends-on <ref>", "Add a dependency reference")
   362→    .option("--remove-depends-on <ref>", "Remove a dependency reference")
   363→    .action(async (ref: string, options) => {
   364→      try {
   365→        const ctx = await initContext();
   366→
   367→        if (!ctx.manifestPath) {
   368→          error(errors.project.noKspecProject);
   369→          process.exit(EXIT_CODES.ERROR);
   370→        }
   371→
   372→        const metaCtx = await loadMetaContext(ctx);
   373→        const item = findMetaItemByRef(metaCtx, ref);
   374→
   375→        if (!item) {
   376→          error(`Skill not found: ${ref}`);
   377→          console.log(chalk.gray("Try: kspec skill list"));
   378→          process.exit(EXIT_CODES.NOT_FOUND);
   379→        }
   380→
   381→        // Check it's a skill
   382→        if (!("origin" in item)) {
   383→          error(`Item ${ref} is not a skill`);
   384→          process.exit(EXIT_CODES.ERROR);
   385→        }
   386→
   387→        const skill = item as LoadedSkill;
   388→
   389→        // AC: @skill-set ac-1 - update description field
   390→        if (options.name !== undefined) {
   391→          skill.name = options.name;
   392→        }
   393→
   394→        if (options.description !== undefined) {
   395→          skill.description = options.description;
   396→        }
   397→
   398→        // Update origin
   399→        if (options.origin !== undefined) {
   400→          const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   401→          if (!validOrigins.includes(options.origin as SkillOrigin)) {
   402→            error(
   403→              `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   404→            );
   405→            process.exit(EXIT_CODES.ERROR);
   406→          }
   407→          skill.origin = options.origin as SkillOrigin;
   408→        }
   409→
   410→        // Update version
   411→        if (options.skillVersion !== undefined) {
   412→          skill.version = options.skillVersion;
   413→        }
   414→
   415→        // AC: @skill-set ac-2 - add platform to array
   416→        if (options.addPlatform) {
   417→          if (!skill.platforms.includes(options.addPlatform)) {
   418→            skill.platforms.push(options.addPlatform);
   419→          }
   420→        }
   421→
   422→        // Remove platform
   423→        if (options.removePlatform) {
   424→          const idx = skill.platforms.indexOf(options.removePlatform);
   425→          if (idx >= 0) {
   426→            skill.platforms.splice(idx, 1);
   427→          }
   428→        }
   429→
   430→        // AC: @skill-set ac-3 - add tag to array
   431→        if (options.addTag) {
   432→          if (!skill.tags) {
   433→            skill.tags = [];
   434→          }
   435→          if (!skill.tags.includes(options.addTag)) {
   436→            skill.tags.push(options.addTag);
   437→          }
   438→        }
   439→
   440→        // Remove tag
   441→        if (options.removeTag && skill.tags) {
   442→          const idx = skill.tags.indexOf(options.removeTag);
   443→          if (idx >= 0) {
   444→            skill.tags.splice(idx, 1);
   445→          }
   446→        }
   447→
   448→        // Add dependency
   449→        if (options.addDependsOn) {
   450→          if (!skill.depends_on) {
   451→            skill.depends_on = [];
   452→          }
   453→          if (!skill.depends_on.includes(options.addDependsOn)) {
   454→            skill.depends_on.push(options.addDependsOn);
   455→          }
   456→        }
   457→
   458→        // Remove dependency
   459→        if (options.removeDependsOn && skill.depends_on) {
   460→          const idx = skill.depends_on.indexOf(options.removeDependsOn);
   461→          if (idx >= 0) {
   462→            skill.depends_on.splice(idx, 1);
   463→          }
   464→        }
   465→
   466→        // Validate updated skill
   467→        const parsed = SkillSchema.safeParse(skill);
   468→        if (!parsed.success) {
   469→          const issues = parsed.error.issues
   470→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   471→            .join("; ");
   472→          error(`Invalid skill data: ${issues}`);
   473→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   474→        }
   475→
   476→        // Save the updated skill
   477→        await saveMetaItem(ctx, skill, "skill");
   478→
   479→        // Commit changes
   480→        await commitIfShadow(ctx.shadow, "skill-set", skill.id, skill.name);
   481→
   482→        output(skill, () => success(`Updated skill: ${skill.id}`));
   483→      } catch (err) {
   484→        error("Failed to update skill", err);
   485→        process.exit(EXIT_CODES.ERROR);
   486→      }
   487→    });
   488→
   489→  // AC: @skill-cli ac-7, ac-8 - kspec skill delete
   490→  markMutating(skill.command("delete <ref>"))
   491→    .description("Delete a skill")
   492→    .option("--confirm", "Skip confirmation prompt")
   493→    .action(async (ref: string, options) => {
   494→      try {
   495→        const ctx = await initContext();
   496→
   497→        if (!ctx.manifestPath) {
   498→          error(errors.project.noKspecProject);
   499→          process.exit(EXIT_CODES.ERROR);
   500→        }
   501→
   502→        const metaCtx = await loadMetaContext(ctx);
   503→        const item = findMetaItemByRef(metaCtx, ref);
   504→
   505→        if (!item) {
   506→          error(`Skill not found: ${ref}`);
   507→          console.log(chalk.gray("Try: kspec skill list"));
   508→          process.exit(EXIT_CODES.NOT_FOUND);
   509→        }
   510→
   511→        // Check it's a skill
   512→        if (!("origin" in item)) {
   513→          error(`Item ${ref} is not a skill`);
   514→          process.exit(EXIT_CODES.ERROR);
   515→        }
   516→
   517→        const skill = item as LoadedSkill;
   518→
   519→        // Check for confirmation
   520→        if (!options.confirm) {
   521→          error(`Confirm deletion of skill '${skill.id}' with --confirm flag`);
   522→          process.exit(EXIT_CODES.ERROR);
   523→        }
   524→
   525→        // Check for dependencies from other skills
   526→        const dependentSkills = metaCtx.skills.filter(
   527→          (s) =>
   528→            s._ulid !== skill._ulid &&
   529→            s.depends_on?.some(
   530→              (dep) =>
   531→                dep === `@${skill.id}` ||
   532→                dep === skill.id ||
   533→                dep.startsWith(`@${skill._ulid.substring(0, 8)}`),
   534→            ),
   535→        );
   536→
   537→        if (dependentSkills.length > 0) {
   538→          const depRefs = dependentSkills.map((s) => `@${s.id}`).join(", ");
   539→          error(
   540→            `Cannot delete skill '${skill.id}': referenced by ${dependentSkills.length} skill(s): ${depRefs}`,
   541→          );
   542→          process.exit(EXIT_CODES.ERROR);
   543→        }
   544→
   545→        // AC: @skill-cli ac-7, ac-8 - delete meta entry and directory
   546→        const deleted = await deleteMetaItem(ctx, skill._ulid, "skill");
   547→
   548→        if (!deleted) {
   549→          error(`Failed to delete skill: ${skill.id}`);
   550→          process.exit(EXIT_CODES.ERROR);
   551→        }
   552→
   553→        // Commit changes
   554→        await commitIfShadow(ctx.shadow, "skill-delete", skill.id);
   555→
   556→        success(`Deleted skill: ${skill.id}`);
   557→      } catch (err) {
   558→        error("Failed to delete skill", err);
   559→        process.exit(EXIT_CODES.ERROR);
   560→      }
   561→    });
   562→}
   563→

