   427→/**
   428→ * Get default author value for an agent type
   429→ */
   430→function getDefaultAuthor(agentType: AgentType): string {
   431→  switch (agentType) {
   432→    case "claude-code":
   433→      return "@claude";
   434→    case "cline":
   435→      return "@cline";
   436→    case "roo-code":
   437→      return "@roo";
   438→    case "copilot-cli":
   439→      return "@copilot";
   440→    case "gemini-cli":
   441→      return "@gemini";
   442→    case "codex-cli":
   443→      return "@codex";
   444→    case "aider":
   445→      return "@aider";
   446→    case "opencode":
   447→      return "@opencode";
   448→    case "amp":
   449→      return "@amp";
   450→    default:
   451→      return "@agent";
   452→  }
   453→}
   454→
   455→/**
   456→ * Prompt user for input with Y/N answer
   457→ */
   458→async function promptYesNo(question: string): Promise<boolean> {
   459→  const rl = readline.createInterface({
   460→    input: process.stdin,
   461→    output: process.stdout,
   462→  });
   463→
   464→  try {
   465→    const answer = await rl.question(`${question} `);
   466→    return answer.toLowerCase() === "y";
   467→  } finally {
   468→    rl.close();
   469→  }
   470→}
   471→
   472→/**
   473→ * Ensure .kspec worktree exists if kspec-meta branch is present.
   474→ * AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
   475→ *
   476→ * @param autoWorktree If true, automatically create worktree without prompting
   477→ * @returns true if worktree is ready to use
   478→ */
   479→async function ensureWorktree(autoWorktree: boolean): Promise<boolean> {
   480→  const projectRoot = getGitRoot(process.cwd());
   481→  if (!projectRoot) {
   482→    // Not in a git repo, skip worktree check
   483→    return true;
   484→  }
   485→
   486→  const status = await getShadowStatus(projectRoot);
   487→
   488→  // AC: worktree-already-exists - if already valid, skip
   489→  if (status.healthy) {
   490→    return true;
   491→  }
   492→
   493→  // AC: detect-existing-repo - branch exists but worktree doesn't
   494→  if (status.branchExists && !status.worktreeExists) {
   495→    // AC: auto-worktree-flag - auto-create if flag set
   496→    if (autoWorktree) {
   497→      console.log(
   498→        `Detected ${SHADOW_BRANCH_NAME} branch without .kspec worktree. Creating...`,
   499→      );
   500→      const result = await repairShadow(projectRoot);
   501→      if (result.success) {
   502→        success("Created .kspec worktree");
   503→        return true;
   504→      } else {
   505→        error(`Failed to create worktree: ${result.error}`);
   506→        return false;
   507→      }
   508→    }
   509→
   510→    // AC: detect-existing-repo - prompt user
   511→    const shouldCreate = await promptYesNo(
   512→      `${SHADOW_BRANCH_NAME} branch exists but .kspec worktree is missing. Create it? (y/N)`,
   513→    );
   514→
   515→    if (shouldCreate) {
   516→      console.log("Creating .kspec worktree...");
   517→      const result = await repairShadow(projectRoot);
   518→      if (result.success) {
   519→        success("Created .kspec worktree");
   520→        return true;
   521→      } else {
   522→        error(`Failed to create worktree: ${result.error}`);
   523→        return false;
   524→      }
   525→    } else {
   526→      warn("Skipping worktree creation");
   527→      return false;
   528→    }
   529→  }
   530→
   531→  // No kspec-meta branch, or already healthy
   532→  return true;
   533→}
