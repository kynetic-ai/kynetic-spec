   608→/**
   609→ * Register the 'setup' command
   610→ */
   611→export function registerSetupCommand(program: Command): void {
   612→  program
   613→    .command("setup")
   614→    .description("Configure agent environment for kspec")
   615→    .option("--dry-run", "Show what would be done without making changes")
   616→    .option(
   617→      "--author <author>",
   618→      "Custom author string (default: auto-detected based on agent)",
   619→    )
   620→    .option("--no-hooks", "Skip installing Claude Code stop hook")
   621→    .option("--force", "Overwrite existing configuration")
   622→    .option(
   623→      "--auto-worktree",
   624→      "Automatically create .kspec worktree if kspec-meta branch exists",
   625→    )
   626→    .action(async (options) => {
   627→      try {
   628→        // AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
   629→        const worktreeReady = await ensureWorktree(
   630→          options.autoWorktree || false,
   631→        );
   632→        if (!worktreeReady) {
   633→          // User declined worktree creation or it failed
   634→          process.exit(EXIT_CODES.ERROR);
   635→        }
   636→
   637→        const detected = detectAgent();
   638→        const projectDir = process.cwd();
   639→
   640→        console.log(
   641→          `Detected agent: ${detected.type} (confidence: ${detected.confidence})`,
   642→        );
   643→
   644→        if (detected.type === "unknown") {
   645→          warn("Could not auto-detect agent environment");
   646→          printManualInstructions("unknown");
   647→          return;
   648→        }
   649→
   650→        const author = options.author || getDefaultAuthor(detected.type);
   651→        const installHooks =
   652→          options.hooks !== false && detected.type === "claude-code";
   653→
   654→        if (options.dryRun) {
   655→          console.log(`\nWould configure:`);
   656→          console.log(`  Agent: ${detected.type}`);
   657→          console.log(`  Author: ${author}`);
   658→          if (detected.configPath) {
   659→            console.log(`  Global config: ${detected.configPath}`);
   660→          }
   661→          if (installHooks) {
   662→            console.log(
   663→              `  Project config: ${path.join(projectDir, ".claude", "settings.json")}`,
   664→            );
   665→            console.log(
   666→              `  Hooks: UserPromptSubmit (prompt-check), Stop (checkpoint)`,
   667→            );
   668→          }
   669→          return;
   670→        }
   671→
   672→        // Check if already configured
   673→        if (!options.force && process.env.KSPEC_AUTHOR) {
   674→          warn(`KSPEC_AUTHOR is already set to "${process.env.KSPEC_AUTHOR}"`);
   675→          console.log("Use --force to overwrite");
   676→          return;
   677→        }
   678→
   679→        // Install config based on agent type
   680→        let installed = false;
   681→        let hooksInstalled = false;
   682→
   683→        let hooksResult: { stop: boolean; promptCheck: boolean } | null = null;
   684→
   685→        switch (detected.type) {
   686→          case "claude-code":
   687→            installed = await installClaudeCodeConfig(author);
   688→            if (installHooks) {
   689→              hooksResult = await installClaudeCodeHooks(projectDir);
   690→              hooksInstalled = hooksResult.stop || hooksResult.promptCheck;
   691→            }
   692→            break;
   693→
   694→          case "aider":
   695→            installed = await installAiderConfig(author);
   696→            break;
   697→
   698→          case "cline":
   699→          case "roo-code":
   700→            // These VS Code extensions use shell env vars, not config files
   701→            // Can't auto-install, must print instructions
   702→            printManualInstructions(detected.type);
   703→            return;
   704→
   705→          case "copilot-cli":
   706→          case "gemini-cli":
   707→          case "opencode":
   708→          case "amp":
   709→            if (detected.configPath) {
   710→              installed = await installGenericJsonConfig(
   711→                detected.configPath,
   712→                author,
   713→              );
   714→            }
   715→            break;
   716→
   717→          case "codex-cli":
   718→            // Codex uses TOML config, would need special handling
   719→            // For now, print manual instructions
   720→            printManualInstructions(detected.type);
   721→            return;
   722→        }
   723→
   724→        if (installed) {
   725→          success(`Configured ${detected.type} with KSPEC_AUTHOR="${author}"`, {
   726→            agent: detected.type,
   727→            author,
   728→            configPath: detected.configPath,
   729→          });
   730→
   731→          if (hooksInstalled && hooksResult) {
   732→            const installedHooks: string[] = [];
   733→            if (hooksResult.promptCheck)
   734→              installedHooks.push("UserPromptSubmit (prompt-check)");
   735→            if (hooksResult.stop) installedHooks.push("Stop (checkpoint)");
   736→            success(`Installed hooks to .claude/settings.json`, {
   737→              hooks: installedHooks,
   738→            });
   739→          }
   740→
   741→          console.log(
   742→            "\nRestart your agent session for changes to take effect.",
   743→          );
   744→        } else {
   745→          error(errors.failures.installConfig(detected.type));
   746→          printManualInstructions(detected.type);
   747→        }
   748→      } catch (err) {
   749→        error(errors.failures.setupFailed, err);
   750→        process.exit(EXIT_CODES.ERROR);
   751→      }
   752→    });
   753→}
   754→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
```