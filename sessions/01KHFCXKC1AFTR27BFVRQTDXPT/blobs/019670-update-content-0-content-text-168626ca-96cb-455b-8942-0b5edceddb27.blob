     1→import * as fs from "node:fs/promises";
     2→import * as os from "node:os";
     3→import * as path from "node:path";
     4→import * as readline from "node:readline/promises";
     5→import type { Command } from "commander";
     6→import {
     7→  getGitRoot,
     8→  getShadowStatus,
     9→  repairShadow,
    10→  SHADOW_BRANCH_NAME,
    11→} from "../../parser/shadow.js";
    12→import { errors } from "../../strings/index.js";
    13→import { EXIT_CODES } from "../exit-codes.js";
    14→import { error, success, warn } from "../output.js";
    15→
    16→/**
    17→ * Supported agent types for auto-configuration
    18→ */
    19→export type AgentType =
    20→  | "claude-code"
    21→  | "cline"
    22→  | "roo-code"
    23→  | "copilot-cli"
    24→  | "gemini-cli"
    25→  | "codex-cli"
    26→  | "aider"
    27→  | "opencode"
    28→  | "amp"
    29→  | "unknown";
    30→
    31→/**
    32→ * Result of agent detection
    33→ */
    34→export interface DetectedAgent {
    35→  type: AgentType;
    36→  confidence: "high" | "medium" | "low";
    37→  configPath?: string;
    38→  envVars?: Record<string, string>;
    39→}
    40→
    41→/**
    42→ * Detect which agent environment we're running in.
    43→ * Returns the detected agent type and confidence level.
    44→ *
    45→ * Detection priority matters - more specific markers checked first.
    46→ */
    47→export function detectAgent(): DetectedAgent {
    48→  // Claude Code: Multiple possible markers
    49→  // CLAUDECODE=1 is set in CLI sessions
    50→  // CLAUDE_CODE_ENTRYPOINT indicates entry point (cli, etc.)
    51→  // CLAUDE_PROJECT_DIR is set in some contexts
    52→  if (
    53→    process.env.CLAUDECODE === "1" ||
    54→    process.env.CLAUDE_CODE_ENTRYPOINT ||
    55→    process.env.CLAUDE_PROJECT_DIR
    56→  ) {
    57→    return {
    58→      type: "claude-code",
    59→      confidence: "high",
    60→      configPath: path.join(os.homedir(), ".claude", "settings.json"),
    61→      envVars: {
    62→        ...(process.env.CLAUDECODE && { CLAUDECODE: process.env.CLAUDECODE }),
    63→        ...(process.env.CLAUDE_CODE_ENTRYPOINT && {
    64→          CLAUDE_CODE_ENTRYPOINT: process.env.CLAUDE_CODE_ENTRYPOINT,
    65→        }),
    66→        ...(process.env.CLAUDE_PROJECT_DIR && {
    67→          CLAUDE_PROJECT_DIR: process.env.CLAUDE_PROJECT_DIR,
    68→        }),
    69→      },
    70→    };
    71→  }
    72→
    73→  // Cline: CLINE_ACTIVE is set when running in Cline terminal
    74→  if (process.env.CLINE_ACTIVE) {
    75→    return {
    76→      type: "cline",
    77→      confidence: "high",
    78→      // Cline uses VS Code settings, but env vars should be in shell profile
    79→      configPath: undefined,
    80→      envVars: { CLINE_ACTIVE: process.env.CLINE_ACTIVE },
    81→    };
    82→  }
    83→
    84→  // GitHub Copilot CLI: Check for copilot-specific markers
    85→  if (process.env.COPILOT_MODEL || process.env.GH_TOKEN) {
    86→    return {
    87→      type: "copilot-cli",
    88→      confidence: "medium",
    89→      configPath: path.join(os.homedir(), ".copilot", "config.json"),
    90→    };
    91→  }
    92→
    93→  // Aider: Check for AIDER_* env vars
    94→  if (process.env.AIDER_MODEL || process.env.AIDER_DARK_MODE !== undefined) {
    95→    return {
    96→      type: "aider",
    97→      confidence: "high",
    98→      configPath: path.join(os.homedir(), ".aider.conf.yml"),
    99→    };
   100→  }
   101→
   102→  // OpenCode: Check for OPENCODE_* env vars
   103→  if (process.env.OPENCODE_CONFIG_DIR || process.env.OPENCODE_CONFIG) {
   104→    return {
   105→      type: "opencode",
   106→      confidence: "high",
   107→      configPath:
   108→        process.env.OPENCODE_CONFIG ||
   109→        path.join(os.homedir(), ".config", "opencode", "opencode.json"),
   110→    };
   111→  }
   112→
   113→  // Gemini CLI: GEMINI_CLI=1 is set when running in Gemini CLI
   114→  if (process.env.GEMINI_CLI === "1") {
   115→    return {
   116→      type: "gemini-cli",
   117→      confidence: "high",
   118→      configPath: path.join(os.homedir(), ".gemini", "settings.json"),
   119→      envVars: { GEMINI_CLI: "1" },
   120→    };
   121→  }
   122→
   123→  // Codex CLI: CODEX_SANDBOX is set when running in sandbox
   124→  if (process.env.CODEX_SANDBOX) {
   125→    return {
   126→      type: "codex-cli",
   127→      confidence: "high",
   128→      configPath: path.join(os.homedir(), ".codex", "config.toml"),
   129→      envVars: { CODEX_SANDBOX: process.env.CODEX_SANDBOX },
   130→    };
   131→  }
   132→
   133→  // Amp (Sourcegraph): Check for AMP_API_KEY or AMP_TOOLBOX
   134→  if (process.env.AMP_API_KEY || process.env.AMP_TOOLBOX) {
   135→    return {
   136→      type: "amp",
   137→      confidence: "medium",
   138→      configPath: path.join(os.homedir(), ".config", "amp", "settings.json"),
   139→    };
   140→  }
   141→
   142→  return {
   143→    type: "unknown",
   144→    confidence: "low",
   145→  };
   146→}
