   281→/**
   282→ * Install stop hook to project-level Claude Code settings (.claude/settings.json)
   283→ * @deprecated Use installClaudeCodeHooks instead
   284→ */
   285→async function _installClaudeCodeStopHook(
   286→  projectDir: string,
   287→): Promise<boolean> {
   288→  const configPath = path.join(projectDir, ".claude", "settings.json");
   289→  const configDir = path.dirname(configPath);
   290→
   291→  try {
   292→    // Ensure directory exists
   293→    await fs.mkdir(configDir, { recursive: true });
   294→
   295→    // Read existing config or start fresh
   296→    let config: Record<string, unknown> = {};
   297→    try {
   298→      const existing = await fs.readFile(configPath, "utf-8");
   299→      config = JSON.parse(existing);
   300→    } catch {
   301→      // File doesn't exist or invalid JSON, start fresh
   302→    }
   303→
   304→    // Build the stop hook command
   305→    const stopHookCommand = "npx kspec session checkpoint --json";
   306→
   307→    // Get or create hooks object
   308→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   309→
   310→    // Check if Stop hook already exists with our command
   311→    const existingStopHooks = hooks.Stop as
   312→      | Array<{ matcher?: object; hooks?: Array<{ command?: string }> }>
   313→      | undefined;
   314→    const alreadyInstalled = existingStopHooks?.some((entry) =>
   315→      entry.hooks?.some((hook) => hook.command?.includes("session checkpoint")),
   316→    );
   317→
   318→    if (alreadyInstalled) {
   319→      return true; // Already configured
   320→    }
   321→
   322→    // Add our stop hook using Claude Code hooks format
   323→    // Note: matcher field is required even if empty string
   324→    hooks.Stop = [
   325→      ...(existingStopHooks || []),
   326→      {
   327→        matcher: "",
   328→        hooks: [
   329→          {
   330→            type: "command",
   331→            command: stopHookCommand,
   332→          },
   333→        ],
   334→      },
   335→    ];
   336→    config.hooks = hooks;
   337→
   338→    // Write back
   339→    await fs.writeFile(
   340→      configPath,
   341→      `${JSON.stringify(config, null, 2)}\n`,
   342→      "utf-8",
   343→    );
   344→    return true;
   345→  } catch {
   346→    return false;
   347→  }
   348→}
