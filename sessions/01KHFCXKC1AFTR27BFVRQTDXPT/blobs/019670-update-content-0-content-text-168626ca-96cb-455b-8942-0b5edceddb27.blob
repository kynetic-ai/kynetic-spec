   535→/**
   536→ * Print manual setup instructions
   537→ */
   538→function printManualInstructions(agentType: AgentType): void {
   539→  const author = getDefaultAuthor(agentType);
   540→
   541→  console.log("\nManual setup instructions:\n");
   542→
   543→  switch (agentType) {
   544→    case "claude-code":
   545→      console.log("Add to ~/.claude/settings.json:");
   546→      console.log("```json");
   547→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   548→      console.log("```");
   549→      break;
   550→
   551→    case "cline":
   552→    case "roo-code":
   553→      console.log("Add to your shell profile (~/.bashrc, ~/.zshrc):");
   554→      console.log("```bash");
   555→      console.log(`export KSPEC_AUTHOR="${author}"`);
   556→      console.log("```");
   557→      console.log(
   558→        "\nThis will be inherited by terminals spawned by the VS Code extension.",
   559→      );
   560→      break;
   561→
   562→    case "copilot-cli":
   563→      console.log("Add to ~/.copilot/config.json:");
   564→      console.log("```json");
   565→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   566→      console.log("```");
   567→      break;
   568→
   569→    case "aider":
   570→      console.log("Add to ~/.aider.conf.yml:");
   571→      console.log("```yaml");
   572→      console.log("set-env:");
   573→      console.log(`  - KSPEC_AUTHOR=${author}`);
   574→      console.log("```");
   575→      break;
   576→
   577→    case "codex-cli":
   578→      console.log("Add to ~/.codex/config.toml:");
   579→      console.log("```toml");
   580→      console.log("[shell_environment_policy]");
   581→      console.log(`set = { KSPEC_AUTHOR = "${author}" }`);
   582→      console.log("```");
   583→      break;
   584→
   585→    case "opencode":
   586→      console.log("Add to ~/.config/opencode/opencode.json:");
   587→      console.log("```json");
   588→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   589→      console.log("```");
   590→      break;
   591→
   592→    case "amp":
   593→      console.log("Add to ~/.config/amp/settings.json:");
   594→      console.log("```json");
   595→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   596→      console.log("```");
   597→      break;
   598→
   599→    default:
   600→      console.log("Set the KSPEC_AUTHOR environment variable:");
   601→      console.log("```bash");
   602→      console.log(`export KSPEC_AUTHOR="${author}"`);
   603→      console.log("```");
   604→      console.log("\nOr add to your shell profile (~/.bashrc, ~/.zshrc, etc.)");
   605→  }
   606→}
