   350→/**
   351→ * Install KSPEC_AUTHOR config for Aider (.aider.conf.yml)
   352→ * Aider uses `set-env:` for environment variables in list format
   353→ */
   354→async function installAiderConfig(author: string): Promise<boolean> {
   355→  const configPath = path.join(os.homedir(), ".aider.conf.yml");
   356→
   357→  try {
   358→    let content = "";
   359→    try {
   360→      content = await fs.readFile(configPath, "utf-8");
   361→    } catch {
   362→      // File doesn't exist, start fresh
   363→    }
   364→
   365→    // Check if KSPEC_AUTHOR is already set
   366→    if (content.includes("KSPEC_AUTHOR")) {
   367→      // Replace existing value (handles both old and new format)
   368→      content = content.replace(
   369→        /^(\s*-?\s*KSPEC_AUTHOR\s*[=:]\s*).*$/m,
   370→        `  - KSPEC_AUTHOR=${author}`,
   371→      );
   372→    } else {
   373→      // Add to set-env section or create it
   374→      if (content.includes("set-env:")) {
   375→        // Append to existing set-env section
   376→        content = content.replace(
   377→          /(set-env:\s*\n)/m,
   378→          `$1  - KSPEC_AUTHOR=${author}\n`,
   379→        );
   380→      } else {
   381→        // Add new set-env section
   382→        content += `\n# kspec author for note attribution\nset-env:\n  - KSPEC_AUTHOR=${author}\n`;
   383→      }
   384→    }
   385→
   386→    await fs.writeFile(configPath, content, "utf-8");
   387→    return true;
   388→  } catch {
   389→    return false;
   390→  }
   391→}
