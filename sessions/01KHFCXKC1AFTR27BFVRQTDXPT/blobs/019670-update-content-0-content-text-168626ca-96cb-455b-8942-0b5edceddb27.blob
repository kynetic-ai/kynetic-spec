   148→/**
   149→ * Install KSPEC_AUTHOR config for Claude Code (global settings)
   150→ */
   151→async function installClaudeCodeConfig(author: string): Promise<boolean> {
   152→  const configPath = path.join(os.homedir(), ".claude", "settings.json");
   153→  const configDir = path.dirname(configPath);
   154→
   155→  try {
   156→    // Ensure directory exists
   157→    await fs.mkdir(configDir, { recursive: true });
   158→
   159→    // Read existing config or start fresh
   160→    let config: Record<string, unknown> = {};
   161→    try {
   162→      const existing = await fs.readFile(configPath, "utf-8");
   163→      config = JSON.parse(existing);
   164→    } catch {
   165→      // File doesn't exist or invalid JSON, start fresh
   166→    }
   167→
   168→    // Merge env settings
   169→    const env = (config.env as Record<string, string>) || {};
   170→    env.KSPEC_AUTHOR = author;
   171→    config.env = env;
   172→
   173→    // Write back
   174→    await fs.writeFile(
   175→      configPath,
   176→      `${JSON.stringify(config, null, 2)}\n`,
   177→      "utf-8",
   178→    );
   179→    return true;
   180→  } catch (_err) {
   181→    return false;
   182→  }
   183→}
   184→
   185→/**
   186→ * Install hooks to project-level Claude Code settings (.claude/settings.json)
   187→ */
   188→async function installClaudeCodeHooks(
   189→  projectDir: string,
   190→): Promise<{ stop: boolean; promptCheck: boolean }> {
   191→  const configPath = path.join(projectDir, ".claude", "settings.json");
   192→  const configDir = path.dirname(configPath);
   193→
   194→  const result = { stop: false, promptCheck: false };
   195→
   196→  try {
   197→    // Ensure directory exists
   198→    await fs.mkdir(configDir, { recursive: true });
   199→
   200→    // Read existing config or start fresh
   201→    let config: Record<string, unknown> = {};
   202→    try {
   203→      const existing = await fs.readFile(configPath, "utf-8");
   204→      config = JSON.parse(existing);
   205→    } catch {
   206→      // File doesn't exist or invalid JSON, start fresh
   207→    }
   208→
   209→    // Get or create hooks object
   210→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   211→
   212→    // Install UserPromptSubmit hook (spec-first reminder)
   213→    const promptCheckCommand = "npx kspec session prompt-check";
   214→    const existingPromptHooks = hooks.UserPromptSubmit as
   215→      | Array<{ hooks?: Array<{ command?: string }> }>
   216→      | undefined;
   217→    const promptAlreadyInstalled = existingPromptHooks?.some((entry) =>
   218→      entry.hooks?.some((hook) =>
   219→        hook.command?.includes("session prompt-check"),
   220→      ),
   221→    );
   222→
   223→    if (!promptAlreadyInstalled) {
   224→      hooks.UserPromptSubmit = [
   225→        ...(existingPromptHooks || []),
   226→        {
   227→          hooks: [
   228→            {
   229→              type: "command",
   230→              command: promptCheckCommand,
   231→            },
   232→          ],
   233→        },
   234→      ];
   235→      result.promptCheck = true;
   236→    } else {
   237→      result.promptCheck = true; // Already configured
   238→    }
   239→
   240→    // Install Stop hook (checkpoint)
   241→    const stopHookCommand = "npx kspec session checkpoint --json";
   242→    const existingStopHooks = hooks.Stop as
   243→      | Array<{ matcher?: string; hooks?: Array<{ command?: string }> }>
   244→      | undefined;
   245→    const stopAlreadyInstalled = existingStopHooks?.some((entry) =>
   246→      entry.hooks?.some((hook) => hook.command?.includes("session checkpoint")),
   247→    );
   248→
   249→    if (!stopAlreadyInstalled) {
   250→      hooks.Stop = [
   251→        ...(existingStopHooks || []),
   252→        {
   253→          matcher: "",
   254→          hooks: [
   255→            {
   256→              type: "command",
   257→              command: stopHookCommand,
   258→            },
   259→          ],
   260→        },
   261→      ];
   262→      result.stop = true;
   263→    } else {
   264→      result.stop = true; // Already configured
   265→    }
   266→
   267→    config.hooks = hooks;
   268→
   269→    // Write back
   270→    await fs.writeFile(
   271→      configPath,
   272→      `${JSON.stringify(config, null, 2)}\n`,
   273→      "utf-8",
   274→    );
   275→    return result;
   276→  } catch {
   277→    return result;
   278→  }
   279→}
