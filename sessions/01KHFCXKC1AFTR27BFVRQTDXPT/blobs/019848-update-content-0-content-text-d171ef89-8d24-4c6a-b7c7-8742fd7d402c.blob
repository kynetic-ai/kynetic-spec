```
   600→          {
   601→            type: "command",
   602→            command: stopHookCommand,
   603→          },
   604→        ],
   605→      },
   606→    ];
   607→    config.hooks = hooks;
   608→
   609→    // Write back
   610→    await fs.writeFile(
   611→      configPath,
   612→      `${JSON.stringify(config, null, 2)}\n`,
   613→      "utf-8",
   614→    );
   615→    return true;
   616→  } catch {
   617→    return false;
   618→  }
   619→}
   620→
   621→/**
   622→ * Install KSPEC_AUTHOR config for Aider (.aider.conf.yml)
   623→ * Aider uses `set-env:` for environment variables in list format
   624→ */
   625→async function installAiderConfig(author: string): Promise<boolean> {
   626→  const configPath = path.join(os.homedir(), ".aider.conf.yml");
   627→
   628→  try {
   629→    let content = "";
   630→    try {
   631→      content = await fs.readFile(configPath, "utf-8");
   632→    } catch {
   633→      // File doesn't exist, start fresh
   634→    }
   635→
   636→    // Check if KSPEC_AUTHOR is already set
   637→    if (content.includes("KSPEC_AUTHOR")) {
   638→      // Replace existing value (handles both old and new format)
   639→      content = content.replace(
   640→        /^(\s*-?\s*KSPEC_AUTHOR\s*[=:]\s*).*$/m,
   641→        `  - KSPEC_AUTHOR=${author}`,
   642→      );
   643→    } else {
   644→      // Add to set-env section or create it
   645→      if (content.includes("set-env:")) {
   646→        // Append to existing set-env section
   647→        content = content.replace(
   648→          /(set-env:\s*\n)/m,
   649→          `$1  - KSPEC_AUTHOR=${author}\n`,
   650→        );
   651→      } else {
   652→        // Add new set-env section
   653→        content += `\n# kspec author for note attribution\nset-env:\n  - KSPEC_AUTHOR=${author}\n`;
   654→      }
   655→    }
   656→
   657→    await fs.writeFile(configPath, content, "utf-8");
   658→    return true;
   659→  } catch {
   660→    return false;
   661→  }
   662→}
   663→
   664→/**
   665→ * Install KSPEC_AUTHOR for generic JSON config files
   666→ */
   667→async function installGenericJsonConfig(
   668→  configPath: string,
   669→  author: string,
   670→): Promise<boolean> {
   671→  try {
   672→    const configDir = path.dirname(configPath);
   673→    await fs.mkdir(configDir, { recursive: true });
   674→
   675→    let config: Record<string, unknown> = {};
   676→    try {
   677→      const existing = await fs.readFile(configPath, "utf-8");
   678→      config = JSON.parse(existing);
   679→    } catch {
   680→      // Start fresh
   681→    }
   682→
   683→    const env = (config.env as Record<string, string>) || {};
   684→    env.KSPEC_AUTHOR = author;
   685→    config.env = env;
   686→
   687→    await fs.writeFile(
   688→      configPath,
   689→      `${JSON.stringify(config, null, 2)}\n`,
   690→      "utf-8",
   691→    );
   692→    return true;
   693→  } catch {
   694→    return false;
   695→  }
   696→}
   697→
   698→/**
   699→ * Get default author value for an agent type
   700→ */
   701→function getDefaultAuthor(agentType: AgentType): string {
   702→  switch (agentType) {
   703→    case "claude-code":
   704→      return "@claude";
   705→    case "cline":
   706→      return "@cline";
   707→    case "roo-code":
   708→      return "@roo";
   709→    case "copilot-cli":
   710→      return "@copilot";
   711→    case "gemini-cli":
   712→      return "@gemini";
   713→    case "codex-cli":
   714→      return "@codex";
   715→    case "aider":
   716→      return "@aider";
   717→    case "opencode":
   718→      return "@opencode";
   719→    case "amp":
   720→      return "@amp";
   721→    default:
   722→      return "@agent";
   723→  }
   724→}
   725→
   726→/**
   727→ * Prompt user for input with Y/N answer
   728→ */
   729→async function promptYesNo(question: string): Promise<boolean> {
   730→  const rl = readline.createInterface({
   731→    input: process.stdin,
   732→    output: process.stdout,
   733→  });
   734→
   735→  try {
   736→    const answer = await rl.question(`${question} `);
   737→    return answer.toLowerCase() === "y";
   738→  } finally {
   739→    rl.close();
   740→  }
   741→}
   742→
   743→/**
   744→ * Ensure .kspec worktree exists if kspec-meta branch is present.
   745→ * AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
   746→ *
   747→ * @param autoWorktree If true, automatically create worktree without prompting
   748→ * @returns true if worktree is ready to use
   749→ */
   750→async function ensureWorktree(autoWorktree: boolean): Promise<boolean> {
   751→  const projectRoot = getGitRoot(process.cwd());
   752→  if (!projectRoot) {
   753→    // Not in a git repo, skip worktree check
   754→    return true;
   755→  }
   756→
   757→  const status = await getShadowStatus(projectRoot);
   758→
   759→  // AC: worktree-already-exists - if already valid, skip
   760→  if (status.healthy) {
   761→    return true;
   762→  }
   763→
   764→  // AC: detect-existing-repo - branch exists but worktree doesn't
   765→  if (status.branchExists && !status.worktreeExists) {
   766→    // AC: auto-worktree-flag - auto-create if flag set
   767→    if (autoWorktree) {
   768→      console.log(
   769→        `Detected ${SHADOW_BRANCH_NAME} branch without .kspec worktree. Creating...`,
   770→      );
   771→      const result = await repairShadow(projectRoot);
   772→      if (result.success) {
   773→        success("Created .kspec worktree");
   774→        return true;
   775→      } else {
   776→        error(`Failed to create worktree: ${result.error}`);
   777→        return false;
   778→      }
   779→    }
   780→
   781→    // AC: detect-existing-repo - prompt user
   782→    const shouldCreate = await promptYesNo(
   783→      `${SHADOW_BRANCH_NAME} branch exists but .kspec worktree is missing. Create it? (y/N)`,
   784→    );
   785→
   786→    if (shouldCreate) {
   787→      console.log("Creating .kspec worktree...");
   788→      const result = await repairShadow(projectRoot);
   789→      if (result.success) {
   790→        success("Created .kspec worktree");
   791→        return true;
   792→      } else {
   793→        error(`Failed to create worktree: ${result.error}`);
   794→        return false;
   795→      }
   796→    } else {
   797→      warn("Skipping worktree creation");
   798→      return false;
   799→    }
   800→  }
   801→
   802→  // No kspec-meta branch, or already healthy
   803→  return true;
   804→}
   805→
   806→/**
   807→ * Print manual setup instructions
   808→ */
   809→function printManualInstructions(agentType: AgentType): void {
   810→  const author = getDefaultAuthor(agentType);
   811→
   812→  console.log("\nManual setup instructions:\n");
   813→
   814→  switch (agentType) {
   815→    case "claude-code":
   816→      console.log("Add to ~/.claude/settings.json:");
   817→      console.log("```json");
   818→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   819→      console.log("```");
   820→      break;
   821→
   822→    case "cline":
   823→    case "roo-code":
   824→      console.log("Add to your shell profile (~/.bashrc, ~/.zshrc):");
   825→      console.log("```bash");
   826→      console.log(`export KSPEC_AUTHOR="${author}"`);
   827→      console.log("```");
   828→      console.log(
   829→        "\nThis will be inherited by terminals spawned by the VS Code extension.",
   830→      );
   831→      break;
   832→
   833→    case "copilot-cli":
   834→      console.log("Add to ~/.copilot/config.json:");
   835→      console.log("```json");
   836→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   837→      console.log("```");
   838→      break;
   839→
   840→    case "aider":
   841→      console.log("Add to ~/.aider.conf.yml:");
   842→      console.log("```yaml");
   843→      console.log("set-env:");
   844→      console.log(`  - KSPEC_AUTHOR=${author}`);
   845→      console.log("```");
   846→      break;
   847→
   848→    case "codex-cli":
   849→      console.log("Add to ~/.codex/config.toml:");
   850→      console.log("```toml");
   851→      console.log("[shell_environment_policy]");
   852→      console.log(`set = { KSPEC_AUTHOR = "${author}" }`);
   853→      console.log("```");
   854→      break;
   855→
   856→    case "opencode":
   857→      console.log("Add to ~/.config/opencode/opencode.json:");
   858→      console.log("```json");
   859→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   860→      console.log("```");
   861→      break;
   862→
   863→    case "amp":
   864→      console.log("Add to ~/.config/amp/settings.json:");
   865→      console.log("```json");
   866→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   867→      console.log("```");
   868→      break;
   869→
   870→    default:
   871→      console.log("Set the KSPEC_AUTHOR environment variable:");
   872→      console.log("```bash");
   873→      console.log(`export KSPEC_AUTHOR="${author}"`);
   874→      console.log("```");
   875→      console.log("\nOr add to your shell profile (~/.bashrc, ~/.zshrc, etc.)");
   876→  }
   877→}
   878→
   879→/**
   880→ * Register the 'setup' command
   881→ */
   882→export function registerSetupCommand(program: Command): void {
   883→  program
   884→    .command("setup")
   885→    .description("Configure agent environment for kspec")
   886→    .option("--dry-run", "Show what would be done without making changes")
   887→    .option(
   888→      "--author <author>",
   889→      "Custom author string (default: auto-detected based on agent)",
   890→    )
   891→    .option("--no-hooks", "Skip installing Claude Code stop hook")
   892→    .option("--force", "Overwrite existing configuration")
   893→    .option(
   894→      "--auto-worktree",
   895→      "Automatically create .kspec worktree if kspec-meta branch exists",
   896→    )
   897→    .action(async (options) => {
   898→      try {
   899→        // AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
   900→        const worktreeReady = await ensureWorktree(
   901→          options.autoWorktree || false,
   902→        );
   903→        if (!worktreeReady) {
   904→          // User declined worktree creation or it failed
   905→          process.exit(EXIT_CODES.ERROR);
   906→        }
   907→
   908→        const detected = detectAgent();
   909→        const projectDir = process.cwd();
   910→
   911→        console.log(
   912→          `Detected agent: ${detected.type} (confidence: ${detected.confidence})`,
   913→        );
   914→
   915→        if (detected.type === "unknown") {
   916→          warn("Could not auto-detect agent environment");
   917→          printManualInstructions("unknown");
   918→          return;
   919→        }
   920→
   921→        const author = options.author || getDefaultAuthor(detected.type);
   922→        const installHooks =
   923→          options.hooks !== false && detected.type === "claude-code";
   924→
   925→        if (options.dryRun) {
   926→          console.log(`\nWould configure:`);
   927→          console.log(`  Agent: ${detected.type}`);
   928→          console.log(`  Author: ${author}`);
   929→          if (detected.configPath) {
   930→            console.log(`  Global config: ${detected.configPath}`);
   931→          }
   932→          if (installHooks) {
   933→            console.log(
   934→              `  Project config: ${path.join(projectDir, ".claude", "settings.json")}`,
   935→            );
   936→            console.log(
   937→              `  Hooks: UserPromptSubmit (prompt-check), Stop (checkpoint)`,
   938→            );
   939→          }
   940→          return;
   941→        }
   942→
   943→        // Check if already configured
   944→        if (!options.force && process.env.KSPEC_AUTHOR) {
   945→          warn(`KSPEC_AUTHOR is already set to "${process.env.KSPEC_AUTHOR}"`);
   946→          console.log("Use --force to overwrite");
   947→          return;
   948→        }
   949→
   950→        // Install config based on agent type
   951→        let installed = false;
   952→        let hooksInstalled = false;
   953→
   954→        let hooksResult: { stop: boolean; promptCheck: boolean } | null = null;
   955→
   956→        switch (detected.type) {
   957→          case "claude-code":
   958→            installed = await installClaudeCodeConfig(author);
   959→            if (installHooks) {
   960→              hooksResult = await installClaudeCodeHooks(projectDir);
   961→              hooksInstalled = hooksResult.stop || hooksResult.promptCheck;
   962→            }
   963→            break;
   964→
   965→          case "aider":
   966→            installed = await installAiderConfig(author);
   967→            break;
   968→
   969→          case "cline":
   970→          case "roo-code":
   971→            // These VS Code extensions use shell env vars, not config files
   972→            // Can't auto-install, must print instructions
   973→            printManualInstructions(detected.type);
   974→            return;
   975→
   976→          case "copilot-cli":
   977→          case "gemini-cli":
   978→          case "opencode":
   979→          case "amp":
   980→            if (detected.configPath) {
   981→              installed = await installGenericJsonConfig(
   982→                detected.configPath,
   983→                author,
   984→              );
   985→            }
   986→            break;
   987→
   988→          case "codex-cli":
   989→            // Codex uses TOML config, would need special handling
   990→            // For now, print manual instructions
   991→            printManualInstructions(detected.type);
   992→            return;
   993→        }
   994→
   995→        if (installed) {
   996→          success(`Configured ${detected.type} with KSPEC_AUTHOR="${author}"`, {
   997→            agent: detected.type,
   998→            author,
   999→            configPath: detected.configPath,
  1000→          });
  1001→
  1002→          if (hooksInstalled && hooksResult) {
  1003→            const installedHooks: string[] = [];
  1004→            if (hooksResult.promptCheck)
  1005→              installedHooks.push("UserPromptSubmit (prompt-check)");
  1006→            if (hooksResult.stop) installedHooks.push("Stop (checkpoint)");
  1007→            success(`Installed hooks to .claude/settings.json`, {
  1008→              hooks: installedHooks,
  1009→            });
  1010→          }
  1011→
  1012→          console.log(
  1013→            "\nRestart your agent session for changes to take effect.",
  1014→          );
  1015→        } else {
  1016→          error(errors.failures.installConfig(detected.type));
  1017→          printManualInstructions(detected.type);
  1018→        }
  1019→      } catch (err) {
  1020→        error(errors.failures.setupFailed, err);
  1021→        process.exit(EXIT_CODES.ERROR);
  1022→      }
  1023→    });
  1024→}
