   565→    kspec('skill set @my-skill --description "Completely new"', tempDir);
   566→
   567→    // Also verify in manifest
   568→    const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
   569→    const metaContent = await fs.readFile(metaPath, 'utf-8');
   570→    const meta = yamlParse(metaContent);
   571→
   572→    const skill = meta.skills.find((s: { id: string }) => s.id === 'my-skill');
   573→    expect(skill.description).toBe('Completely new');
   574→    expect(skill.description).not.toContain('Original');
   575→  });
   576→
   577→  // AC: @skill-set ac-2
