   536→describe('Skill CLI - skill set', () => {
   537→  let tempDir: string;
   538→
   539→  beforeEach(async () => {
   540→    tempDir = await setupTempFixtures();
   541→    await initGitRepo(tempDir);
   542→
   543→    // Create a skill to update
   544→    const result = kspecFull(
   545→      'skill add --id my-skill --name "My Skill" --description "Original description" --origin project --skill-version 0.1.0',
   546→      tempDir
   547→    );
   548→    if (result.exitCode !== 0) throw new Error(`skill add failed: ${result.stderr}`);
   549→  });
   550→
   551→  afterEach(async () => {
   552→    await cleanupTempDir(tempDir);
   553→  });
   554→
   555→  // AC: @skill-set ac-1
   556→  it('should update description field in meta', () => {
   557→    kspec('skill set @my-skill --description "New description"', tempDir);
   558→
   559→    const result = kspecJson<{ id: string; description: string }>('skill get @my-skill', tempDir);
   560→    expect(result.description).toBe('New description');
   561→  });
   562→
   563→  // AC: @skill-set ac-1 - verify original description replaced
