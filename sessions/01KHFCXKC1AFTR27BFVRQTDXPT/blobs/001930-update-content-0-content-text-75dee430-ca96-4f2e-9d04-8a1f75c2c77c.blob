```
     1→/**
     2→ * Meta manifest loading and operations.
     3→ *
     4→ * The meta manifest (kynetic.meta.yaml) contains process definitions:
     5→ * - Agents: roles, capabilities, conventions
     6→ * - Workflows: structured processes with steps
     7→ * - Conventions: project rules and standards
     8→ * - Observations: feedback about processes
     9→ */
    10→
    11→import * as fs from "node:fs/promises";
    12→import * as path from "node:path";
    13→import { ulid } from "ulid";
    14→import {
    15→  type Agent,
    16→  AgentSchema,
    17→  type Convention,
    18→  ConventionSchema,
    19→  getMetaItemType,
    20→  type MetaItem,
    21→  type MetaManifest,
    22→  MetaManifestSchema,
    23→  type Observation,
    24→  ObservationSchema,
    25→  type ObservationType,
    26→  type SessionContext,
    27→  SessionContextSchema,
    28→  type Skill,
    29→  SkillSchema,
    30→  type Workflow,
    31→  type WorkflowRun,
    32→  type WorkflowRunsFile,
    33→  WorkflowRunsFileSchema,
    34→  WorkflowSchema,
    35→} from "../schema/index.js";
    36→import type { KspecContext } from "./yaml.js";
    37→import {
    38→  expandIncludePattern,
    39→  getAuthor,
    40→  readYamlFile,
    41→  writeYamlFilePreserveFormat,
    42→} from "./yaml.js";
    43→
    44→/**
    45→ * Loaded agent with runtime metadata
    46→ */
    47→export interface LoadedAgent extends Agent {
    48→  _sourceFile?: string;
    49→}
    50→
    51→/**
    52→ * Loaded workflow with runtime metadata
    53→ */
    54→export interface LoadedWorkflow extends Workflow {
    55→  _sourceFile?: string;
    56→}
    57→
    58→/**
    59→ * Loaded convention with runtime metadata
    60→ */
    61→export interface LoadedConvention extends Convention {
    62→  _sourceFile?: string;
    63→}
    64→
    65→/**
    66→ * Loaded observation with runtime metadata
    67→ */
    68→export interface LoadedObservation extends Observation {
    69→  _sourceFile?: string;
    70→}
    71→
    72→/**
    73→ * Loaded skill with runtime metadata
    74→ */
    75→export interface LoadedSkill extends Skill {
    76→  _sourceFile?: string;
    77→}
    78→
    79→/**
    80→ * Any loaded meta item
    81→ */
    82→export type LoadedMetaItem =
    83→  | LoadedAgent
    84→  | LoadedWorkflow
    85→  | LoadedConvention
    86→  | LoadedObservation
    87→  | LoadedSkill;
    88→
    89→/**
    90→ * Meta context containing all loaded meta items
    91→ */
    92→export interface MetaContext {
    93→  manifest: MetaManifest | null;
    94→  manifestPath: string | null;
    95→  agents: LoadedAgent[];
    96→  workflows: LoadedWorkflow[];
    97→  conventions: LoadedConvention[];
    98→  observations: LoadedObservation[];
    99→  skills: LoadedSkill[];
   100→}
   101→
   102→/**
   103→ * Find the meta manifest file.
   104→ *
   105→ * Discovery algorithm:
   106→ * 1. Check for explicit name: kynetic.meta.yaml (backward compat)
   107→ * 2. If not found, scan directory for *.meta.yaml files
   108→ * 3. For each candidate, validate it contains a 'kynetic_meta:' version field
   109→ * 4. Return first valid match (alphabetically after explicit name)
   110→ *
   111→ * AC: @meta-manifest-discovery ac-1, ac-2, ac-3
   112→ */
   113→export async function findMetaManifest(
   114→  specDir: string,
   115→): Promise<string | null> {
   116→  // AC: @meta-manifest-discovery ac-1, ac-3 - explicit name has priority
   117→  const priorityPath = path.join(specDir, "kynetic.meta.yaml");
   118→  try {
   119→    await fs.access(priorityPath);
   120→    return priorityPath;
   121→  } catch {
   122→    // Continue to glob fallback
   123→  }
   124→
   125→  // AC: @meta-manifest-discovery ac-2, ac-3 - glob fallback with validation
   126→  try {
   127→    const entries = await fs.readdir(specDir);
   128→    // AC: @meta-manifest-discovery ac-3 - alphabetical order
   129→    const candidates = entries
   130→      .filter((f) => f.endsWith(".meta.yaml"))
   131→      .sort();
   132→
   133→    for (const candidate of candidates) {
   134→      const filePath = path.join(specDir, candidate);
   135→      try {
   136→        const raw = await readYamlFile<unknown>(filePath);
   137→        // AC: @meta-manifest-discovery ac-2 - validate kynetic_meta version field
   138→        if (raw && typeof raw === "object" && "kynetic_meta" in raw) {
   139→          return filePath;
   140→        }
   141→      } catch {
   142→        // Skip invalid files
   143→      }
   144→    }
   145→  } catch {
   146→    // Directory read failed
   147→  }
   148→
   149→  return null;
   150→}
   151→
   152→/**
   153→ * Get the base name (slug) from a manifest path.
   154→ * E.g., "kynetic.yaml" -> "kynetic", "myproject.spec.yaml" -> "myproject"
   155→ */
   156→function getManifestBaseName(manifestPath: string | null): string {
   157→  if (!manifestPath) return "kynetic";
   158→  const fileName = path.basename(manifestPath);
   159→  // Remove .yaml extension
   160→  let baseName = fileName.replace(/\.yaml$/, "");
   161→  // Remove .spec suffix if present
   162→  baseName = baseName.replace(/\.spec$/, "");
   163→  return baseName || "kynetic";
   164→}
   165→
   166→/**
   167→ * Get the meta manifest file path.
   168→ * Derives from main manifest name (e.g., myproject.yaml -> myproject.meta.yaml)
   169→ * Returns path even if file doesn't exist yet.
   170→ */
   171→export function getMetaManifestPath(ctx: KspecContext): string {
   172→  const baseName = getManifestBaseName(ctx.manifestPath);
   173→  return path.join(ctx.specDir, `${baseName}.meta.yaml`);
   174→}
   175→
   176→/**
   177→ * Load meta items from a single file.
   178→ */
   179→async function loadMetaFile(filePath: string): Promise<{
   180→  agents: LoadedAgent[];
   181→  workflows: LoadedWorkflow[];
   182→  conventions: LoadedConvention[];
   183→  observations: LoadedObservation[];
   184→  skills: LoadedSkill[];
   185→}> {
   186→  const result: {
   187→    agents: LoadedAgent[];
   188→    workflows: LoadedWorkflow[];
   189→    conventions: LoadedConvention[];
   190→    observations: LoadedObservation[];
   191→    skills: LoadedSkill[];
   192→  } = {
   193→    agents: [],
   194→    workflows: [],
   195→    conventions: [],
   196→    observations: [],
   197→    skills: [],
   198→  };
   199→
   200→  try {
   201→    const raw = await readYamlFile<unknown>(filePath);
   202→    if (!raw || typeof raw !== "object") {
   203→      return result;
   204→    }
   205→
   206→    const obj = raw as Record<string, unknown>;
   207→
   208→    // Parse agents
   209→    if (Array.isArray(obj.agents)) {
   210→      for (const agent of obj.agents) {
   211→        const parsed = AgentSchema.safeParse(agent);
   212→        if (parsed.success) {
   213→          result.agents.push({ ...parsed.data, _sourceFile: filePath });
   214→        }
   215→      }
   216→    }
   217→
   218→    // Parse workflows
   219→    if (Array.isArray(obj.workflows)) {
   220→      for (const workflow of obj.workflows) {
   221→        const parsed = WorkflowSchema.safeParse(workflow);
   222→        if (parsed.success) {
   223→          result.workflows.push({ ...parsed.data, _sourceFile: filePath });
   224→        }
   225→      }
   226→    }
   227→
   228→    // Parse conventions
   229→    if (Array.isArray(obj.conventions)) {
   230→      for (const convention of obj.conventions) {
   231→        const parsed = ConventionSchema.safeParse(convention);
   232→        if (parsed.success) {
   233→          result.conventions.push({ ...parsed.data, _sourceFile: filePath });
   234→        }
   235→      }
   236→    }
   237→
   238→    // Parse observations
   239→    if (Array.isArray(obj.observations)) {
   240→      for (const observation of obj.observations) {
   241→        const parsed = ObservationSchema.safeParse(observation);
   242→        if (parsed.success) {
   243→          result.observations.push({ ...parsed.data, _sourceFile: filePath });
   244→        }
   245→      }
   246→    }
   247→
   248→    // Parse skills
   249→    // AC: @skill-meta-type ac-4 - skills loaded with _sourceFile set
   250→    if (Array.isArray(obj.skills)) {
   251→      for (const skill of obj.skills) {
   252→        const parsed = SkillSchema.safeParse(skill);
   253→        if (parsed.success) {
   254→          result.skills.push({ ...parsed.data, _sourceFile: filePath });
   255→        }
   256→      }
   257→    }
   258→  } catch {
   259→    // File doesn't exist or parse error
   260→  }
   261→
   262→  return result;
   263→}
   264→
   265→/**
   266→ * Load the meta context from a kspec context.
   267→ * Loads meta manifest and follows includes.
   268→ * AC: @skill-meta-type ac-4 - MetaContext.skills contains LoadedSkill objects with _sourceFile set
   269→ */
   270→export async function loadMetaContext(ctx: KspecContext): Promise<MetaContext> {
   271→  const result: MetaContext = {
   272→    manifest: null,
   273→    manifestPath: null,
   274→    agents: [],
   275→    workflows: [],
   276→    conventions: [],
   277→    observations: [],
   278→    skills: [],
   279→  };
   280→
   281→  const manifestPath = await findMetaManifest(ctx.specDir);
   282→  if (!manifestPath) {
   283→    return result;
   284→  }
   285→
   286→  result.manifestPath = manifestPath;
   287→
   288→  try {
   289→    const raw = await readYamlFile<unknown>(manifestPath);
   290→    const parsed = MetaManifestSchema.safeParse(raw);
   291→    if (!parsed.success) {
   292→      // Invalid manifest, but we can still try to extract items
   293→      const items = await loadMetaFile(manifestPath);
   294→      result.agents.push(...items.agents);
   295→      result.workflows.push(...items.workflows);
   296→      result.conventions.push(...items.conventions);
   297→      result.observations.push(...items.observations);
   298→      result.skills.push(...items.skills);
   299→      return result;
   300→    }
   301→
   302→    result.manifest = parsed.data;
   303→
   304→    // Load items from manifest
   305→    const manifestItems = await loadMetaFile(manifestPath);
   306→    result.agents.push(...manifestItems.agents);
   307→    result.workflows.push(...manifestItems.workflows);
   308→    result.conventions.push(...manifestItems.conventions);
   309→    result.observations.push(...manifestItems.observations);
   310→    result.skills.push(...manifestItems.skills);
   311→
   312→    // Process includes
   313→    const includes = parsed.data.includes || [];
   314→    const manifestDir = path.dirname(manifestPath);
   315→
   316→    for (const include of includes) {
   317→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   318→
   319→      for (const filePath of expandedPaths) {
   320→        const items = await loadMetaFile(filePath);
   321→        result.agents.push(...items.agents);
   322→        result.workflows.push(...items.workflows);
   323→        result.conventions.push(...items.conventions);
   324→        result.observations.push(...items.observations);
   325→        result.skills.push(...items.skills);
   326→      }
   327→    }
   328→  } catch {
   329→    // Manifest exists but may be invalid
   330→  }
   331→
   332→  return result;
   333→}
   334→
   335→/**
   336→ * Get meta stats summary
   337→ */
   338→export function getMetaStats(meta: MetaContext): {
   339→  agents: number;
   340→  workflows: number;
   341→  conventions: number;
   342→  observations: number;
   343→  unresolvedObservations: number;
   344→  skills: number;
   345→} {
   346→  return {
   347→    agents: meta.agents.length,
   348→    workflows: meta.workflows.length,
   349→    conventions: meta.conventions.length,
   350→    observations: meta.observations.length,
   351→    unresolvedObservations: meta.observations.filter((o) => !o.resolved).length,
   352→    skills: meta.skills.length,
   353→  };
   354→}
   355→
   356→/**
   357→ * Find a meta item by reference (ULID, short ULID, or id)
   358→ * AC: @skill-meta-type ac-5 - skills returned by semantic id lookup
   359→ * AC: @skill-meta-type ac-6 - skills returned by ULID prefix lookup
   360→ */
   361→export function findMetaItemByRef(
   362→  meta: MetaContext,
   363→  ref: string,
   364→): LoadedMetaItem | undefined {
   365→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   366→
   367→  // Search all item types
   368→  const allItems: LoadedMetaItem[] = [
   369→    ...meta.agents,
   370→    ...meta.workflows,
   371→    ...meta.conventions,
   372→    ...meta.observations,
   373→    ...meta.skills,
   374→  ];
   375→
   376→  for (const item of allItems) {
   377→    // Match full ULID
   378→    if (item._ulid === cleanRef) return item;
   379→
   380→    // Match short ULID (prefix)
   381→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
   382→      return item;
   383→
   384→    // Match by id (for agents, workflows, and skills)
   385→    if ("id" in item && item.id === cleanRef) return item;
   386→
   387→    // Match by domain (for conventions)
   388→    if ("domain" in item && item.domain === cleanRef) return item;
   389→  }
   390→
   391→  return undefined;
   392→}
   393→
   394→/**
   395→ * Determine if an item is a meta item type
   396→ */
   397→export function isMetaItemType(type: string): boolean {
   398→  return ["agent", "workflow", "convention", "observation", "skill"].includes(
   399→    type,
   400→  );
   401→}
   402→
   403→// ============================================================
   404→// META ITEM CRUD
   405→// ============================================================
   406→
   407→/**
   408→ * Save the entire meta manifest to file
   409→ */
   410→async function saveMetaManifest(
   411→  manifestPath: string,
   412→  manifest: MetaManifest,
   413→): Promise<void> {
   414→  await writeYamlFilePreserveFormat(manifestPath, manifest);
   415→}
   416→
   417→/**
   418→ * Strip runtime metadata before serialization
   419→ */
   420→function stripMetaMetadata<T extends LoadedMetaItem>(
   421→  item: T,
   422→): Omit<T, "_sourceFile"> {
   423→  const { _sourceFile, ...cleanItem } = item;
   424→  return cleanItem as Omit<T, "_sourceFile">;
   425→}
   426→
   427→/**
   428→ * Create a new observation
   429→ */
   430→export function createObservation(
   431→  type: ObservationType,
   432→  content: string,
   433→  options: {
   434→    workflow_ref?: string;
   435→    author?: string;
   436→  } = {},
   437→): Observation {
   438→  return {
   439→    _ulid: ulid(),
   440→    type,
   441→    content,
   442→    workflow_ref: options.workflow_ref,
   443→    created_at: new Date().toISOString(),
   444→    author: options.author ?? getAuthor(),
   445→    resolved: false,
   446→    resolution: null,
   447→  };
   448→}
   449→
   450→/**
   451→ * Save an observation to the meta manifest
   452→ */
   453→export async function saveObservation(
   454→  ctx: KspecContext,
   455→  observation: LoadedObservation,
   456→): Promise<void> {
   457→  const manifestPath = getMetaManifestPath(ctx);
   458→
   459→  // Ensure directory exists
   460→  const dir = path.dirname(manifestPath);
   461→  await fs.mkdir(dir, { recursive: true });
   462→
   463→  // Load existing manifest
   464→  let manifest: MetaManifest = {
   465→    kynetic_meta: "1.0",
   466→    agents: [],
   467→    workflows: [],
   468→    conventions: [],
   469→    observations: [],
   470→    skills: [],
   471→    includes: [],
   472→  };
   473→
   474→  try {
   475→    const raw = await readYamlFile<unknown>(manifestPath);
   476→    const parsed = MetaManifestSchema.safeParse(raw);
   477→    if (parsed.success) {
   478→      manifest = parsed.data;
   479→    }
   480→  } catch {
   481→    // File doesn't exist, use defaults
   482→  }
   483→
   484→  // Strip runtime metadata
   485→  const cleanObs = stripMetaMetadata(observation);
   486→
   487→  // Update or add
   488→  const existingIndex = manifest.observations.findIndex(
   489→    (o) => o._ulid === observation._ulid,
   490→  );
   491→  if (existingIndex >= 0) {
   492→    manifest.observations[existingIndex] = cleanObs as Observation;
   493→  } else {
   494→    manifest.observations.push(cleanObs as Observation);
   495→  }
   496→
   497→  await saveMetaManifest(manifestPath, manifest);
   498→}
   499→
   500→/**
   501→ * Delete an observation from the meta manifest
   502→ */
   503→export async function deleteObservation(
   504→  ctx: KspecContext,
   505→  ulid: string,
   506→): Promise<boolean> {
   507→  const manifestPath = getMetaManifestPath(ctx);
   508→
   509→  try {
   510→    const raw = await readYamlFile<unknown>(manifestPath);
   511→    const parsed = MetaManifestSchema.safeParse(raw);
   512→    if (!parsed.success) {
   513→      return false;
   514→    }
   515→
   516→    const manifest = parsed.data;
   517→    const index = manifest.observations.findIndex((o) => o._ulid === ulid);
   518→    if (index < 0) {
   519→      return false;
   520→    }
   521→
   522→    manifest.observations.splice(index, 1);
   523→    await saveMetaManifest(manifestPath, manifest);
   524→    return true;
   525→  } catch {
   526→    return false;
   527→  }
   528→}
   529→
   530→/**
   531→ * Get the path for skill content file.
   532→ * Skills are stored in .kspec/skills/<id>/SKILL.md
   533→ */
   534→export function getSkillContentPath(ctx: KspecContext, skillId: string): string {
   535→  return path.join(ctx.specDir, "skills", skillId, "SKILL.md");
   536→}
   537→
   538→/**
   539→ * Load skill content from the SKILL.md file.
   540→ * AC: @skill-meta-type ac-3 - loadSkillContent returns full markdown content
   541→ */
   542→export async function loadSkillContent(
   543→  ctx: KspecContext,
   544→  skill: LoadedSkill,
   545→): Promise<string | null> {
   546→  const contentPath = getSkillContentPath(ctx, skill.id);
   547→  try {
   548→    const content = await fs.readFile(contentPath, "utf-8");
   549→    return content;
   550→  } catch {
   551→    return null;
   552→  }
   553→}
   554→
   555→// Re-export the getMetaItemType function
   556→export { getMetaItemType };
   557→export type { Agent, Workflow, Convention, Observation, Skill, MetaItem };
   558→
   559→// ============================================================
   560→// GENERIC META ITEM CRUD
   561→// ============================================================
   562→
   563→/**
   564→ * Save any meta item (agent, workflow, convention) to the manifest
   565→ */
   566→export async function saveMetaItem(
   567→  ctx: KspecContext,
   568→  item: LoadedMetaItem,
   569→  itemType: "agent" | "workflow" | "convention",
   570→): Promise<void> {
   571→  const manifestPath = getMetaManifestPath(ctx);
   572→
   573→  // Ensure directory exists
   574→  const dir = path.dirname(manifestPath);
   575→  await fs.mkdir(dir, { recursive: true });
   576→
   577→  // Load existing manifest
   578→  let manifest: MetaManifest = {
   579→    kynetic_meta: "1.0",
   580→    agents: [],
   581→    workflows: [],
   582→    conventions: [],
   583→    observations: [],
   584→    skills: [],
   585→    includes: [],
   586→  };
   587→
   588→  try {
   589→    const raw = await readYamlFile<unknown>(manifestPath);
   590→    const parsed = MetaManifestSchema.safeParse(raw);
   591→    if (parsed.success) {
   592→      manifest = parsed.data;
   593→    }
   594→  } catch {
   595→    // File doesn't exist, use defaults
   596→  }
   597→
   598→  // Strip runtime metadata
   599→  const cleanItem = stripMetaMetadata(item);
   600→
   601→  // Get the appropriate array
   602→  const getArray = () => {
   603→    switch (itemType) {
   604→      case "agent":
   605→        return manifest.agents;
   606→      case "workflow":
   607→        return manifest.workflows;
   608→      case "convention":
   609→        return manifest.conventions;
   610→    }
   611→  };
   612→
   613→  const array = getArray();
   614→
   615→  // Update or add
   616→  const existingIndex = array.findIndex((i) => i._ulid === item._ulid);
   617→  if (existingIndex >= 0) {
   618→    (array as unknown[])[existingIndex] = cleanItem;
   619→  } else {
   620→    (array as unknown[]).push(cleanItem);
   621→  }
   622→
   623→  await saveMetaManifest(manifestPath, manifest);
   624→}
   625→
   626→/**
   627→ * Delete any meta item from the manifest
   628→ */
   629→export async function deleteMetaItem(
   630→  ctx: KspecContext,
   631→  itemUlid: string,
   632→  itemType: "agent" | "workflow" | "convention" | "observation",
   633→): Promise<boolean> {
   634→  const manifestPath = getMetaManifestPath(ctx);
   635→
   636→  try {
   637→    const raw = await readYamlFile<unknown>(manifestPath);
   638→    const parsed = MetaManifestSchema.safeParse(raw);
   639→    if (!parsed.success) {
   640→      return false;
   641→    }
   642→
   643→    const manifest = parsed.data;
   644→
   645→    const getArray = () => {
   646→      switch (itemType) {
   647→        case "agent":
   648→          return manifest.agents;
   649→        case "workflow":
   650→          return manifest.workflows;
   651→        case "convention":
   652→          return manifest.conventions;
   653→        case "observation":
   654→          return manifest.observations;
   655→      }
   656→    };
   657→
   658→    const array = getArray();
   659→    const index = array.findIndex((i) => i._ulid === itemUlid);
   660→    if (index < 0) {
   661→      return false;
   662→    }
   663→
   664→    array.splice(index, 1);
   665→    await saveMetaManifest(manifestPath, manifest);
   666→    return true;
   667→  } catch {
   668→    return false;
   669→  }
   670→}
   671→
   672→// ============================================================
   673→// SESSION CONTEXT
   674→// ============================================================
   675→
   676→/**
   677→ * Get the session context file path
   678→ */
   679→export function getSessionContextPath(ctx: KspecContext): string {
   680→  return path.join(ctx.specDir, ".kspec-session");
   681→}
   682→
   683→/**
   684→ * Load session context (or return empty context if not exists)
   685→ */
   686→export async function loadSessionContext(
   687→  ctx: KspecContext,
   688→): Promise<SessionContext> {
   689→  const contextPath = getSessionContextPath(ctx);
   690→
   691→  try {
   692→    const raw = await readYamlFile<unknown>(contextPath);
   693→    if (!raw || typeof raw !== "object") {
   694→      return {
   695→        focus: null,
   696→        threads: [],
   697→        open_questions: [],
   698→        updated_at: new Date().toISOString(),
   699→      };
   700→    }
   701→
   702→    // Validate and parse using schema
   703→    const result = SessionContextSchema.safeParse(raw);
   704→    if (result.success) {
   705→      return result.data;
   706→    }
   707→
   708→    // If validation fails, return empty context
   709→    return {
   710→      focus: null,
   711→      threads: [],
   712→      open_questions: [],
   713→      updated_at: new Date().toISOString(),
   714→    };
   715→  } catch {
   716→    return {
   717→      focus: null,
   718→      threads: [],
   719→      open_questions: [],
   720→      updated_at: new Date().toISOString(),
   721→    };
   722→  }
   723→}
   724→
   725→/**
   726→ * Save session context
   727→ */
   728→export async function saveSessionContext(
   729→  ctx: KspecContext,
   730→  context: SessionContext,
   731→): Promise<void> {
   732→  const contextPath = getSessionContextPath(ctx);
   733→
   734→  // Update timestamp
   735→  context.updated_at = new Date().toISOString();
   736→
   737→  await writeYamlFilePreserveFormat(contextPath, context);
   738→}
   739→
   740→// ============================================================
   741→// WORKFLOW RUNS
   742→// ============================================================
   743→
   744→/**
   745→ * Get the workflow runs file path.
   746→ * Derives from main manifest name (e.g., myproject.yaml -> myproject.runs.yaml)
   747→ */
   748→export function getWorkflowRunsPath(ctx: KspecContext): string {
   749→  const baseName = getManifestBaseName(ctx.manifestPath);
   750→  return path.join(ctx.specDir, `${baseName}.runs.yaml`);
   751→}
   752→
   753→/**
   754→ * Load workflow runs from file
   755→ */
   756→export async function loadWorkflowRuns(
   757→  ctx: KspecContext,
   758→): Promise<WorkflowRun[]> {
   759→  const runsPath = getWorkflowRunsPath(ctx);
   760→
   761→  try {
   762→    const raw = await readYamlFile<unknown>(runsPath);
   763→    const parsed = WorkflowRunsFileSchema.safeParse(raw);
   764→
   765→    if (!parsed.success) {
   766→      return [];
   767→    }
   768→
   769→    return parsed.data.runs;
   770→  } catch {
   771→    // File doesn't exist
   772→    return [];
   773→  }
   774→}
   775→
   776→/**
   777→ * Save a workflow run (create or update)
   778→ */
   779→export async function saveWorkflowRun(
   780→  ctx: KspecContext,
   781→  run: WorkflowRun,
   782→): Promise<void> {
   783→  const runsPath = getWorkflowRunsPath(ctx);
   784→
   785→  // Load existing runs
   786→  const runs = await loadWorkflowRuns(ctx);
   787→
   788→  // Update or add
   789→  const existingIndex = runs.findIndex((r) => r._ulid === run._ulid);
   790→  if (existingIndex >= 0) {
   791→    runs[existingIndex] = run;
   792→  } else {
   793→    runs.push(run);
   794→  }
   795→
   796→  // Save back
   797→  const runsFile: WorkflowRunsFile = {
   798→    kynetic_runs: "1.0",
   799→    runs,
   800→  };
   801→
   802→  await writeYamlFilePreserveFormat(runsPath, runsFile);
   803→}
   804→
   805→/**
   806→ * Update an existing workflow run
   807→ */
   808→export async function updateWorkflowRun(
   809→  ctx: KspecContext,
   810→  run: WorkflowRun,
   811→): Promise<void> {
   812→  await saveWorkflowRun(ctx, run);
   813→}
   814→
   815→/**
   816→ * Find a workflow run by reference (ULID or ULID prefix)
   817→ */
   818→export async function findWorkflowRunByRef(
   819→  ctx: KspecContext,
   820→  ref: string,
   821→): Promise<WorkflowRun | undefined> {
   822→  const runs = await loadWorkflowRuns(ctx);
   823→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   824→
   825→  return runs.find(
   826→    (r) =>
   827→      r._ulid === cleanRef ||
   828→      r._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   829→  );
   830→}
   831→
   832→/**
   833→ * Find active workflow runs
   834→ */
   835→export async function findActiveRuns(
   836→  ctx: KspecContext,
   837→): Promise<WorkflowRun[]> {
   838→  const runs = await loadWorkflowRuns(ctx);
   839→  return runs.filter((r) => r.status === "active");
   840→}
   841→
   842→/**
   843→ * Delete workflow runs by ULIDs
   844→ * AC: @workflow-prune ac-1, ac-2, ac-3, ac-4
   845→ */
   846→export async function deleteWorkflowRuns(
   847→  ctx: KspecContext,
   848→  ulidsToDelete: string[],
   849→): Promise<void> {
   850→  const runsPath = getWorkflowRunsPath(ctx);
   851→  const runs = await loadWorkflowRuns(ctx);
   852→
   853→  // Filter out runs to delete
   854→  const remainingRuns = runs.filter((r) => !ulidsToDelete.includes(r._ulid));
   855→
   856→  // Save back
   857→  const runsFile: WorkflowRunsFile = {
   858→    kynetic_runs: "1.0",
   859→    runs: remainingRuns,
   860→  };
   861→
   862→  await writeYamlFilePreserveFormat(runsPath, runsFile);
   863→}
   864→

