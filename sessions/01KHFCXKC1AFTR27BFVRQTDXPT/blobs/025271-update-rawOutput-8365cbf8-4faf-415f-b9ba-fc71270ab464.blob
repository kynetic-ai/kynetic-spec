     1→/**
     2→ * Skill CLI commands for managing skills.
     3→ *
     4→ * AC: @skill-cli ac-1 - kspec skill list outputs table with ID, Name, Origin, Version, Platforms
     5→ * AC: @skill-cli ac-2 - kspec skill list --json outputs JSON array with full skill metadata
     6→ * AC: @skill-cli ac-3 - kspec skill add creates meta entry with origin custom
     7→ * AC: @skill-cli ac-4 - kspec skill add creates .kspec/skills/<id>/SKILL.md
     8→ * AC: @skill-cli ac-5 - kspec skill get outputs metadata including id, name, origin, platforms
     9→ * AC: @skill-cli ac-6 - kspec skill get outputs SKILL.md content
    10→ * AC: @skill-cli ac-7 - kspec skill delete --confirm removes meta entry
    11→ * AC: @skill-cli ac-8 - kspec skill delete removes .kspec/skills/<id>/ directory
    12→ *
    13→ * AC: @core-skill-install ac-1 - meta entries created with origin core
    14→ * AC: @core-skill-install ac-2 - content files copied from templates to .kspec/skills/<id>/
    15→ * AC: @core-skill-install ac-3 - custom skills skipped with message
    16→ * AC: @core-skill-install ac-4 - --force overwrites custom forks
    17→ * AC: @core-skill-install ac-5 - version matches kspec package version
    18→ *
    19→ * AC: @core-skill-update ac-1 - skill content and version updated when version differs
    20→ * AC: @core-skill-update ac-2 - skill skipped when already at current version
    21→ * AC: @core-skill-update ac-3 - skills with origin custom/project not touched
    22→ */
    23→
    24→import * as crypto from "node:crypto";
    25→import * as fs from "node:fs/promises";
    26→import { readFileSync } from "node:fs";
    27→import * as path from "node:path";
    28→import chalk from "chalk";
    29→import Table from "cli-table3";
    30→import type { Command } from "commander";
    31→import { ulid } from "ulid";
    32→import yaml from "yaml";
    33→import { markMutating } from "../command-annotations.js";
    34→import {
    35→  deleteMetaItem,
    36→  findMetaItemByRef,
    37→  getSkillContentPath,
    38→  initContext,
    39→  type KspecContext,
    40→  loadMetaContext,
    41→  loadSkillContent,
    42→  loadSkillDocs,
    43→  type LoadedSkill,
    44→  saveMetaItem,
    45→  type Skill,
    46→} from "../../parser/index.js";
    47→import { commitIfShadow } from "../../parser/shadow.js";
    48→import { SkillSchema, type SkillOrigin } from "../../schema/index.js";
    49→import { errors } from "../../strings/errors.js";
    50→import { EXIT_CODES } from "../exit-codes.js";
    51→import { error, output, success } from "../output.js";
    52→import { parseTagsArray } from "../parse-utils.js";
    53→
    54→/**
    55→ * Format skills as a table
    56→ * AC: @skill-cli ac-1 - table displays ID, Name, Origin, Version, Platforms
    57→ */
    58→function formatSkillsTable(skills: LoadedSkill[]): void {
    59→  if (skills.length === 0) {
    60→    console.log(chalk.yellow("No skills defined"));
    61→    return;
    62→  }
    63→
    64→  const table = new Table({
    65→    head: [
    66→      chalk.bold("ID"),
    67→      chalk.bold("Name"),
    68→      chalk.bold("Origin"),
    69→      chalk.bold("Version"),
    70→      chalk.bold("Platforms"),
    71→    ],
    72→    style: {
    73→      head: [],
    74→      border: [],
    75→    },
    76→  });
    77→
    78→  for (const skill of skills) {
    79→    table.push([
    80→      skill.id,
    81→      skill.name,
    82→      skill.origin,
    83→      skill.version || "-",
    84→      skill.platforms.join(", "),
    85→    ]);
    86→  }
    87→
    88→  console.log(table.toString());
    89→  console.log(chalk.gray(`\n${skills.length} skill(s)`));
    90→}
    91→
    92→/**
    93→ * Format skill details
    94→ * AC: @skill-cli ac-5 - outputs metadata including id, name, origin, platforms
    95→ */
    96→function formatSkillDetails(skill: LoadedSkill, content: string | null): void {
    97→  console.log(chalk.bold(skill.name));
    98→  console.log(chalk.gray("─".repeat(40)));
    99→  console.log(`ID:          ${skill.id}`);
   100→  console.log(`ULID:        ${skill._ulid}`);
   101→  console.log(`Origin:      ${skill.origin}`);
   102→  console.log(`Platforms:   ${skill.platforms.join(", ")}`);
   103→
   104→  if (skill.version) {
   105→    console.log(`Version:     ${skill.version}`);
   106→  }
   107→
   108→  if (skill.description) {
   109→    console.log(`\n─── Description ───`);
   110→    console.log(skill.description);
   111→  }
   112→
   113→  if (skill.depends_on && skill.depends_on.length > 0) {
   114→    console.log(`\n─── Dependencies ───`);
   115→    for (const dep of skill.depends_on) {
   116→      console.log(`  • ${dep}`);
   117→    }
   118→  }
   119→
   120→  if (skill.tags && skill.tags.length > 0) {
   121→    console.log(`\nTags:        ${skill.tags.join(", ")}`);
   122→  }
   123→
   124→  // AC: @skill-cli ac-6 - display SKILL.md content
   125→  if (content) {
   126→    console.log(`\n─── SKILL.md Content ───`);
   127→    console.log(content);
   128→  } else {
   129→    console.log(chalk.gray("\n(No SKILL.md content found)"));
   130→  }
   131→}
   132→
   133→/**
   134→ * Register skill commands
   135→ */
   136→export function registerSkillCommands(program: Command): void {
   137→  const skill = program
   138→    .command("skill")
   139→    .description("Skill management commands");
   140→
   141→  // AC: @skill-cli ac-1, ac-2 - kspec skill list
   142→  skill
   143→    .command("list")
   144→    .description("List all skills")
   145→    .option("--origin <origin>", "Filter by origin (core, project, local)")
   146→    .option("--tag <tag>", "Filter by tag")
   147→    .action(async (options) => {
   148→      try {
   149→        const ctx = await initContext();
   150→
   151→        if (!ctx.manifestPath) {
   152→          error(errors.project.noKspecProject);
   153→          process.exit(EXIT_CODES.ERROR);
   154→        }
   155→
   156→        const metaCtx = await loadMetaContext(ctx);
   157→        let skills = metaCtx.skills || [];
   158→
   159→        // Apply filters
   160→        if (options.origin) {
   161→          skills = skills.filter((s) => s.origin === options.origin);
   162→        }
   163→
   164→        if (options.tag) {
   165→          skills = skills.filter((s) => s.tags?.includes(options.tag));
   166→        }
   167→
   168→        // AC: @skill-cli ac-2 - JSON output includes full skill metadata
   169→        output(
   170→          skills.map((s) => ({
   171→            _ulid: s._ulid,
   172→            id: s.id,
   173→            name: s.name,
   174→            description: s.description,
   175→            origin: s.origin,
   176→            version: s.version,
   177→            platforms: s.platforms,
   178→            depends_on: s.depends_on,
   179→            tags: s.tags,
   180→          })),
   181→          // AC: @skill-cli ac-1 - Table output
   182→          () => formatSkillsTable(skills),
   183→        );
   184→      } catch (err) {
   185→        error("Failed to list skills", err);
   186→        process.exit(EXIT_CODES.ERROR);
   187→      }
   188→    });
   189→
   190→  // AC: @skill-cli ac-3, ac-4 - kspec skill add
   191→  // AC: @skill-add ac-3 - --content-file copies existing file to SKILL.md
   192→  markMutating(skill.command("add"))
   193→    .description("Create a new skill")
   194→    .requiredOption("--id <id>", "Skill ID (kebab-case)")
   195→    .requiredOption("--name <name>", "Skill name")
   196→    .option("--description <desc>", "Skill description")
   197→    .option(
   198→      "--origin <origin>",
   199→      "Skill origin (core, project, local)",
   200→      "project",
   201→    )
   202→    .option("--skill-version <version>", "Skill version")
   203→    .option("--platform <platform...>", "Target platforms")
   204→    .option("--tag <tag...>", "Tags for the skill")
   205→    .option("--depends-on <ref...>", "Skill dependencies")
   206→    .option("--content-file <path>", "Path to existing file to use as SKILL.md content")
   207→    .action(async (options) => {
   208→      try {
   209→        const ctx = await initContext();
   210→
   211→        if (!ctx.manifestPath) {
   212→          error(errors.project.noKspecProject);
   213→          process.exit(EXIT_CODES.ERROR);
   214→        }
   215→
   216→        // Validate origin
   217→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   218→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   219→          error(
   220→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   221→          );
   222→          process.exit(EXIT_CODES.ERROR);
   223→        }
   224→
   225→        // Check if skill with this ID already exists
   226→        const metaCtx = await loadMetaContext(ctx);
   227→        const existingSkill = metaCtx.skills.find((s) => s.id === options.id);
   228→        if (existingSkill) {
   229→          error(`Skill with ID '${options.id}' already exists`);
   230→          process.exit(EXIT_CODES.CONFLICT);
   231→        }
   232→
   233→        // Build skill object
   234→        const skillData: Skill = {
   235→          _ulid: ulid(),
   236→          id: options.id,
   237→          name: options.name,
   238→          description: options.description,
   239→          origin: options.origin as SkillOrigin,
   240→          version: options.skillVersion,
   241→          platforms:
   242→            options.platform && options.platform.length > 0
   243→              ? options.platform
   244→              : ["claude-code"],
   245→          depends_on:
   246→            options.dependsOn && options.dependsOn.length > 0
   247→              ? options.dependsOn
   248→              : [],
   249→          tags:
   250→            options.tag && options.tag.length > 0
   251→              ? parseTagsArray(options.tag)
   252→              : [],
   253→        };
   254→
   255→        // Validate with schema
   256→        const parsed = SkillSchema.safeParse(skillData);
   257→        if (!parsed.success) {
   258→          const issues = parsed.error.issues
   259→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   260→            .join("; ");
   261→          error(`Invalid skill data: ${issues}`);
   262→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   263→        }
   264→
   265→        const skill: LoadedSkill = { ...parsed.data };
   266→
   267→        // AC: @skill-cli ac-3 - save meta entry (also creates directory per ac-4)
   268→        await saveMetaItem(ctx, skill, "skill");
   269→
   270→        // AC: @skill-cli ac-4 - create SKILL.md with placeholder content
   271→        // AC: @skill-add ac-3 - if --content-file provided, copy its contents
   272→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   273→        let initialContent: string;
   274→
   275→        if (options.contentFile) {
   276→          // Read content from the specified file
   277→          const contentFilePath = path.isAbsolute(options.contentFile)
   278→            ? options.contentFile
   279→            : path.resolve(process.cwd(), options.contentFile);
   280→
   281→          try {
   282→            initialContent = await fs.readFile(contentFilePath, "utf-8");
   283→          } catch (err) {
   284→            // Clean up: remove the skill we just created
   285→            await deleteMetaItem(ctx, skill._ulid, "skill");
   286→            error(`Failed to read content file: ${contentFilePath}`);
   287→            process.exit(EXIT_CODES.ERROR);
   288→          }
   289→        } else {
   290→          initialContent = `# ${skill.name}\n\n${skill.description || "Add skill content here."}\n`;
   291→        }
   292→
   293→        await fs.writeFile(skillMdPath, initialContent, "utf-8");
   294→
   295→        // Commit changes
   296→        await commitIfShadow(ctx.shadow, "skill-add", skill.id, skill.name);
   297→
   298→        output(skill, () =>
   299→          success(`Created skill: ${skill.id}`, { skill }),
   300→        );
   301→      } catch (err) {
   302→        error("Failed to create skill", err);
   303→        process.exit(EXIT_CODES.ERROR);
   304→      }
   305→    });
   306→
   307→  // AC: @skill-cli ac-5, ac-6 - kspec skill get
   308→  skill
   309→    .command("get <ref>")
   310→    .description("Show skill details")
   311→    .action(async (ref: string) => {
   312→      try {
   313→        const ctx = await initContext();
   314→
   315→        if (!ctx.manifestPath) {
   316→          error(errors.project.noKspecProject);
   317→          process.exit(EXIT_CODES.ERROR);
   318→        }
   319→
   320→        const metaCtx = await loadMetaContext(ctx);
   321→        const item = findMetaItemByRef(metaCtx, ref);
   322→
   323→        if (!item) {
   324→          error(`Skill not found: ${ref}`);
   325→          console.log(chalk.gray("Try: kspec skill list"));
   326→          process.exit(EXIT_CODES.NOT_FOUND);
   327→        }
   328→
   329→        // Check it's a skill
   330→        if (!("origin" in item)) {
   331→          error(`Item ${ref} is not a skill`);
   332→          process.exit(EXIT_CODES.ERROR);
   333→        }
   334→
   335→        const skill = item as LoadedSkill;
   336→
   337→        // AC: @skill-cli ac-6 - load SKILL.md content
   338→        const content = await loadSkillContent(ctx, skill);
   339→        const docs = await loadSkillDocs(ctx, skill);
   340→
   341→        // AC: @skill-cli ac-5, ac-6 - output metadata and content
   342→        output(
   343→          {
   344→            _ulid: skill._ulid,
   345→            id: skill.id,
   346→            name: skill.name,
   347→            description: skill.description,
   348→            origin: skill.origin,
   349→            version: skill.version,
   350→            platforms: skill.platforms,
   351→            depends_on: skill.depends_on,
   352→            tags: skill.tags,
   353→            content,
   354→            docs: docs.map((d) => ({ name: d.name, path: d.path })),
   355→          },
   356→          () => formatSkillDetails(skill, content),
   357→        );
   358→      } catch (err) {
   359→        error("Failed to get skill", err);
   360→        process.exit(EXIT_CODES.ERROR);
   361→      }
   362→    });
   363→
   364→  // AC: @skill-set ac-1, ac-2, ac-3 - kspec skill set
   365→  markMutating(skill.command("set <ref>"))
   366→    .description("Update skill metadata fields")
   367→    .option("--name <name>", "Update skill name")
   368→    .option("--description <desc>", "Update skill description")
   369→    .option("--origin <origin>", "Update skill origin (core, project, local)")
   370→    .option("--skill-version <version>", "Update skill version")
   371→    .option("--add-platform <platform>", "Add a platform to the platforms array")
   372→    .option("--remove-platform <platform>", "Remove a platform from the platforms array")
   373→    .option("--add-tag <tag>", "Add a tag to the tags array")
   374→    .option("--remove-tag <tag>", "Remove a tag from the tags array")
   375→    .option("--add-depends-on <ref>", "Add a dependency reference")
   376→    .option("--remove-depends-on <ref>", "Remove a dependency reference")
   377→    .action(async (ref: string, options) => {
   378→      try {
   379→        const ctx = await initContext();
   380→
   381→        if (!ctx.manifestPath) {
   382→          error(errors.project.noKspecProject);
   383→          process.exit(EXIT_CODES.ERROR);
   384→        }
   385→
   386→        const metaCtx = await loadMetaContext(ctx);
   387→        const item = findMetaItemByRef(metaCtx, ref);
   388→
   389→        if (!item) {
   390→          error(`Skill not found: ${ref}`);
   391→          console.log(chalk.gray("Try: kspec skill list"));
   392→          process.exit(EXIT_CODES.NOT_FOUND);
   393→        }
   394→
   395→        // Check it's a skill
   396→        if (!("origin" in item)) {
   397→          error(`Item ${ref} is not a skill`);
   398→          process.exit(EXIT_CODES.ERROR);
   399→        }
   400→
   401→        const skill = item as LoadedSkill;
   402→
   403→        // AC: @skill-set ac-1 - update description field
   404→        if (options.name !== undefined) {
   405→          skill.name = options.name;
   406→        }
   407→
   408→        if (options.description !== undefined) {
   409→          skill.description = options.description;
   410→        }
   411→
   412→        // Update origin
   413→        if (options.origin !== undefined) {
   414→          const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   415→          if (!validOrigins.includes(options.origin as SkillOrigin)) {
   416→            error(
   417→              `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   418→            );
   419→            process.exit(EXIT_CODES.ERROR);
   420→          }
   421→          skill.origin = options.origin as SkillOrigin;
   422→        }
   423→
   424→        // Update version
   425→        if (options.skillVersion !== undefined) {
   426→          skill.version = options.skillVersion;
   427→        }
   428→
   429→        // AC: @skill-set ac-2 - add platform to array
   430→        if (options.addPlatform) {
   431→          if (!skill.platforms.includes(options.addPlatform)) {
   432→            skill.platforms.push(options.addPlatform);
   433→          }
   434→        }
   435→
   436→        // Remove platform
   437→        if (options.removePlatform) {
   438→          const idx = skill.platforms.indexOf(options.removePlatform);
   439→          if (idx >= 0) {
   440→            skill.platforms.splice(idx, 1);
   441→          }
   442→        }
   443→
   444→        // AC: @skill-set ac-3 - add tag to array
   445→        if (options.addTag) {
   446→          if (!skill.tags) {
   447→            skill.tags = [];
   448→          }
   449→          if (!skill.tags.includes(options.addTag)) {
   450→            skill.tags.push(options.addTag);
   451→          }
   452→        }
   453→
   454→        // Remove tag
   455→        if (options.removeTag && skill.tags) {
   456→          const idx = skill.tags.indexOf(options.removeTag);
   457→          if (idx >= 0) {
   458→            skill.tags.splice(idx, 1);
   459→          }
   460→        }
   461→
   462→        // Add dependency
   463→        if (options.addDependsOn) {
   464→          if (!skill.depends_on) {
   465→            skill.depends_on = [];
   466→          }
   467→          if (!skill.depends_on.includes(options.addDependsOn)) {
   468→            skill.depends_on.push(options.addDependsOn);
   469→          }
   470→        }
   471→
   472→        // Remove dependency
   473→        if (options.removeDependsOn && skill.depends_on) {
   474→          const idx = skill.depends_on.indexOf(options.removeDependsOn);
   475→          if (idx >= 0) {
   476→            skill.depends_on.splice(idx, 1);
   477→          }
   478→        }
   479→
   480→        // Validate updated skill
   481→        const parsed = SkillSchema.safeParse(skill);
   482→        if (!parsed.success) {
   483→          const issues = parsed.error.issues
   484→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   485→            .join("; ");
   486→          error(`Invalid skill data: ${issues}`);
   487→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   488→        }
   489→
   490→        // Save the updated skill
   491→        await saveMetaItem(ctx, skill, "skill");
   492→
   493→        // Commit changes
   494→        await commitIfShadow(ctx.shadow, "skill-set", skill.id, skill.name);
   495→
   496→        output(skill, () => success(`Updated skill: ${skill.id}`));
   497→      } catch (err) {
   498→        error("Failed to update skill", err);
   499→        process.exit(EXIT_CODES.ERROR);
   500→      }
   501→    });
   502→
   503→  // AC: @skill-cli ac-7, ac-8 - kspec skill delete
   504→  markMutating(skill.command("delete <ref>"))
   505→    .description("Delete a skill")
   506→    .option("--confirm", "Skip confirmation prompt")
   507→    .action(async (ref: string, options) => {
   508→      try {
   509→        const ctx = await initContext();
   510→
   511→        if (!ctx.manifestPath) {
   512→          error(errors.project.noKspecProject);
   513→          process.exit(EXIT_CODES.ERROR);
   514→        }
   515→
   516→        const metaCtx = await loadMetaContext(ctx);
   517→        const item = findMetaItemByRef(metaCtx, ref);
   518→
   519→        if (!item) {
   520→          error(`Skill not found: ${ref}`);
   521→          console.log(chalk.gray("Try: kspec skill list"));
   522→          process.exit(EXIT_CODES.NOT_FOUND);
   523→        }
   524→
   525→        // Check it's a skill
   526→        if (!("origin" in item)) {
   527→          error(`Item ${ref} is not a skill`);
   528→          process.exit(EXIT_CODES.ERROR);
   529→        }
   530→
   531→        const skill = item as LoadedSkill;
   532→
   533→        // Check for confirmation
   534→        if (!options.confirm) {
   535→          error(`Confirm deletion of skill '${skill.id}' with --confirm flag`);
   536→          process.exit(EXIT_CODES.ERROR);
   537→        }
   538→
   539→        // Check for dependencies from other skills
   540→        const dependentSkills = metaCtx.skills.filter(
   541→          (s) =>
   542→            s._ulid !== skill._ulid &&
   543→            s.depends_on?.some(
   544→              (dep) =>
   545→                dep === `@${skill.id}` ||
   546→                dep === skill.id ||
   547→                dep.startsWith(`@${skill._ulid.substring(0, 8)}`),
   548→            ),
   549→        );
   550→
   551→        if (dependentSkills.length > 0) {
   552→          const depRefs = dependentSkills.map((s) => `@${s.id}`).join(", ");
   553→          error(
   554→            `Cannot delete skill '${skill.id}': referenced by ${dependentSkills.length} skill(s): ${depRefs}`,
   555→          );
   556→          process.exit(EXIT_CODES.ERROR);
   557→        }
   558→
   559→        // AC: @skill-cli ac-7, ac-8 - delete meta entry and directory
   560→        const deleted = await deleteMetaItem(ctx, skill._ulid, "skill");
   561→
   562→        if (!deleted) {
   563→          error(`Failed to delete skill: ${skill.id}`);
   564→          process.exit(EXIT_CODES.ERROR);
   565→        }
   566→
   567→        // Commit changes
   568→        await commitIfShadow(ctx.shadow, "skill-delete", skill.id);
   569→
   570→        success(`Deleted skill: ${skill.id}`);
   571→      } catch (err) {
   572→        error("Failed to delete skill", err);
   573→        process.exit(EXIT_CODES.ERROR);
   574→      }
   575→    });
   576→
   577→  // AC: @skill-import ac-1 through ac-7 - kspec skill import
   578→  markMutating(skill.command("import <file>"))
   579→    .description("Import an existing SKILL.md file into kspec")
   580→    .option("--id <id>", "Custom skill ID (defaults to directory name)")
   581→    .option("--name <name>", "Skill name (required if no frontmatter)")
   582→    .option("--description <desc>", "Skill description (required if no frontmatter)")
   583→    .option(
   584→      "--origin <origin>",
   585→      "Skill origin (core, project, local)",
   586→      "project",
   587→    )
   588→    .option("--skill-version <version>", "Skill version")
   589→    .action(async (file: string, options) => {
   590→      try {
   591→        const ctx = await initContext();
   592→
   593→        if (!ctx.manifestPath) {
   594→          error(errors.project.noKspecProject);
   595→          process.exit(EXIT_CODES.ERROR);
   596→        }
   597→
   598→        // Resolve file path
   599→        const filePath = path.isAbsolute(file)
   600→          ? file
   601→          : path.resolve(process.cwd(), file);
   602→
   603→        // Check file exists
   604→        try {
   605→          await fs.access(filePath);
   606→        } catch {
   607→          error(`File not found: ${filePath}`);
   608→          process.exit(EXIT_CODES.NOT_FOUND);
   609→        }
   610→
   611→        // Read file content
   612→        const content = await fs.readFile(filePath, "utf-8");
   613→
   614→        // AC: @skill-import ac-1, ac-6 - Parse YAML frontmatter
   615→        const frontmatter = parseFrontmatter(content);
   616→
   617→        // Determine name and description from frontmatter or options
   618→        const skillName = options.name || frontmatter?.name;
   619→        const skillDescription = options.description || frontmatter?.description;
   620→
   621→        // AC: @skill-import ac-6 - Error if no name/description and no frontmatter
   622→        if (!skillName) {
   623→          error("Name is required. Either add YAML frontmatter with 'name' field or use --name option.");
   624→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   625→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   626→        }
   627→
   628→        if (!skillDescription) {
   629→          error("Description is required. Either add YAML frontmatter with 'description' field or use --description option.");
   630→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   631→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   632→        }
   633→
   634→        // AC: @skill-import ac-5 - Derive ID from directory name or use custom
   635→        const sourceDir = path.dirname(filePath);
   636→        const derivedId = path.basename(sourceDir);
   637→        const skillId = options.id || derivedId;
   638→
   639→        // Validate origin
   640→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   641→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   642→          error(
   643→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   644→          );
   645→          process.exit(EXIT_CODES.ERROR);
   646→        }
   647→
   648→        // Check if skill with this ID already exists
   649→        const metaCtx = await loadMetaContext(ctx);
   650→        const existingSkill = metaCtx.skills.find((s) => s.id === skillId);
   651→        if (existingSkill) {
   652→          error(`Skill with ID '${skillId}' already exists. Use --id to specify a different ID.`);
   653→          process.exit(EXIT_CODES.CONFLICT);
   654→        }
   655→
   656→        // Build skill object
   657→        const skillData: Skill = {
   658→          _ulid: ulid(),
   659→          id: skillId,
   660→          name: skillName,
   661→          description: skillDescription,
   662→          origin: options.origin as SkillOrigin,
   663→          version: options.skillVersion,
   664→          platforms: ["claude-code"],
   665→          depends_on: [],
   666→          tags: [],
   667→        };
   668→
   669→        // Validate with schema
   670→        const parsed = SkillSchema.safeParse(skillData);
   671→        if (!parsed.success) {
   672→          const issues = parsed.error.issues
   673→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   674→            .join("; ");
   675→          error(`Invalid skill data: ${issues}`);
   676→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   677→        }
   678→
   679→        const skill: LoadedSkill = { ...parsed.data };
   680→
   681→        // Save meta entry (also creates directory)
   682→        await saveMetaItem(ctx, skill, "skill");
   683→
   684→        // AC: @skill-import ac-7 - Strip/normalize base-directory paths
   685→        const normalizedContent = normalizeBaseDirectory(content);
   686→
   687→        // AC: @skill-import ac-2 - Copy content to .kspec/skills/<id>/SKILL.md
   688→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   689→        await fs.writeFile(skillMdPath, normalizedContent, "utf-8");
   690→
   691→        // AC: @skill-import ac-3 - Copy docs/ subdirectory if present
   692→        const sourceDocsDir = path.join(sourceDir, "docs");
   693→        try {
   694→          const docsStats = await fs.stat(sourceDocsDir);
   695→          if (docsStats.isDirectory()) {
   696→            const targetDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
   697→            await fs.mkdir(targetDocsDir, { recursive: true });
   698→            await copyDirectory(sourceDocsDir, targetDocsDir);
   699→          }
   700→        } catch {
   701→          // No docs directory, that's fine
   702→        }
   703→
   704→        // Commit changes
   705→        await commitIfShadow(ctx.shadow, "skill-import", skill.id, skill.name);
   706→
   707→        output(skill, () =>
   708→          success(`Imported skill: ${skill.id}`, { skill }),
   709→        );
   710→      } catch (err) {
   711→        error("Failed to import skill", err);
   712→        process.exit(EXIT_CODES.ERROR);
   713→      }
   714→    });
   715→
   716→  // AC: @skill-rendering ac-1 through ac-5 - kspec skill render
   717→  // AC: @skill-render-cli ac-1, ac-2 - kspec skill render / kspec skill render @skill-id
   718→  // AC: @skill-drift-detection ac-3, ac-4 - drift handling with --force
   719→  // AC: @trait-dry-run - supports --dry-run
   720→  // AC: @trait-error-guidance - provides error guidance
   721→  skill
   722→    .command("render [ref]")
   723→    .description(
   724→      "Render skills from shadow branch to platform-specific files on main branch"
   725→    )
   726→    .option("--clean", "Remove orphaned managed skill directories")
   727→    .option("--dry-run", "Show what would be changed without applying")
   728→    .option("--force", "Overwrite drifted skill files (manually edited)")
   729→    .option("--skill <id>", "Render only a specific skill (deprecated, use positional arg)")
   730→    .action(async (ref: string | undefined, options) => {
   731→      try {
   732→        const ctx = await initContext();
   733→
   734→        if (!ctx.manifestPath) {
   735→          error(errors.project.noKspecProject);
   736→          console.log(
   737→            chalk.gray("Try: kspec init to initialize a kspec project")
   738→          );
   739→          process.exit(EXIT_CODES.ERROR);
   740→        }
   741→
   742→        const metaCtx = await loadMetaContext(ctx);
   743→        // Use rootDir (project root), not specDir (which is .kspec/ in shadow mode)
   744→        const projectRoot = ctx.rootDir;
   745→        const dryRun = options.dryRun || false;
   746→        const force = options.force || false;
   747→        const results: SkillRenderResult[] = [];
   748→        const cleanResults: CleanResult[] = [];
   749→
   750→        // Filter skills by platform (only claude-code for now)
   751→        let skillsToRender = metaCtx.skills.filter((s) =>
   752→          s.platforms.includes("claude-code")
   753→        );
   754→
   755→        // AC: @skill-render-cli ac-2 - Filter to specific skill if requested
   756→        // Support both positional ref argument and --skill option
   757→        const skillRef = ref || options.skill;
   758→        if (skillRef) {
   759→          // Resolve the ref to a skill
   760→          const item = findMetaItemByRef(metaCtx, skillRef);
   761→          if (!item || !("origin" in item)) {
   762→            error(`Skill not found: ${skillRef}`);
   763→            console.log(chalk.gray("Try: kspec skill list"));
   764→            process.exit(EXIT_CODES.NOT_FOUND);
   765→          }
   766→          const skill = item as LoadedSkill;
   767→          skillsToRender = skillsToRender.filter((s) => s.id === skill.id);
   768→          if (skillsToRender.length === 0) {
   769→            error(`Skill '${skill.id}' does not have claude-code platform`);
   770→            process.exit(EXIT_CODES.ERROR);
   771→          }
   772→        }
   773→
   774→        // Ensure .claude/skills directory exists
   775→        const targetSkillsDir = path.join(projectRoot, ".claude", "skills");
   776→        if (!dryRun) {
   777→          await fs.mkdir(targetSkillsDir, { recursive: true });
   778→        }
   779→
   780→        // Render each skill
   781→        // AC: @skill-drift-detection ac-3, ac-4 - Check drift and skip without --force
   782→        for (const skill of skillsToRender) {
   783→          // Check for drift before rendering
   784→          const driftStatus = await checkSkillDrift(ctx.specDir, projectRoot, skill.id);
   785→
   786→          // AC: @skill-drift-detection ac-3 - Skip drifted skills without --force
   787→          if (driftStatus === "drifted" && !force) {
   788→            const renderedPath = path.join(
   789→              projectRoot,
   790→              ".claude",
   791→              "skills",
   792→              skill.id,
   793→              "SKILL.md"
   794→            );
   795→            results.push({
   796→              id: skill.id,
   797→              action: "skipped",
   798→              path: renderedPath,
   799→              skipReason: "drifted (use --force to overwrite)",
   800→            });
   801→            continue;
   802→          }
   803→
   804→          // AC: @skill-drift-detection ac-4 - Render (overwrite) when --force is used
   805→          const result = await renderSkill(ctx, projectRoot, skill, dryRun);
   806→          results.push(result);
   807→        }
   808→
   809→        // Handle --clean: remove orphaned managed skills
   810→        // AC: @skill-rendering ac-4, ac-5
   811→        if (options.clean) {
   812→          const activeSkillIds = new Set(metaCtx.skills.map((s) => s.id));
   813→
   814→          try {
   815→            const entries = await fs.readdir(targetSkillsDir, {
   816→              withFileTypes: true,
   817→            });
   818→
   819→            for (const entry of entries) {
   820→              if (!entry.isDirectory()) continue;
   821→
   822→              const skillId = entry.name;
   823→              const skillDir = path.join(targetSkillsDir, skillId);
   824→              const skillMdPath = path.join(skillDir, "SKILL.md");
   825→
   826→              // Skip if skill still exists in meta
   827→              if (activeSkillIds.has(skillId)) continue;
   828→
   829→              // AC: @skill-rendering ac-4 - Only consider kspec-managed skills
   830→              const isManaged = await isKspecManaged(skillMdPath);
   831→
   832→              if (isManaged) {
   833→                // AC: @skill-rendering ac-5 - Remove orphaned directory
   834→                if (!dryRun) {
   835→                  await fs.rm(skillDir, { recursive: true, force: true });
   836→                }
   837→                cleanResults.push({
   838→                  id: skillId,
   839→                  path: skillDir,
   840→                  action: "removed",
   841→                });
   842→              } else {
   843→                cleanResults.push({
   844→                  id: skillId,
   845→                  path: skillDir,
   846→                  action: "skipped",
   847→                  reason: "Not managed by kspec",
   848→                });
   849→              }
   850→            }
   851→          } catch {
   852→            // No .claude/skills directory, nothing to clean
   853→          }
   854→        }
   855→
   856→        // Output results
   857→        // AC: @trait-dry-run ac-6 - JSON output includes dry_run field
   858→        output(
   859→          {
   860→            dry_run: dryRun,
   861→            rendered: results,
   862→            cleaned: cleanResults,
   863→          },
   864→          () => {
   865→            // AC: @trait-dry-run ac-3 - Clear indication this is a preview
   866→            if (dryRun) {
   867→              console.log(chalk.yellow("DRY RUN - No changes made"));
   868→              console.log();
   869→            }
   870→
   871→            // Render results
   872→            const created = results.filter((r) => r.action === "created");
   873→            const updated = results.filter((r) => r.action === "updated");
   874→            const unchanged = results.filter((r) => r.action === "unchanged");
   875→            // AC: @skill-drift-detection ac-3 - Track skipped drifted skills
   876→            const skippedDrifted = results.filter((r) => r.action === "skipped");
   877→
   878→            if (created.length > 0) {
   879→              console.log(chalk.green(`Created: ${created.length} skill(s)`));
   880→              for (const r of created) {
   881→                console.log(`  ${chalk.green("+")} ${r.id}`);
   882→              }
   883→            }
   884→
   885→            if (updated.length > 0) {
   886→              console.log(chalk.blue(`Updated: ${updated.length} skill(s)`));
   887→              for (const r of updated) {
   888→                console.log(`  ${chalk.blue("~")} ${r.id}`);
   889→              }
   890→            }
   891→
   892→            if (unchanged.length > 0 && results.length <= 10) {
   893→              console.log(chalk.gray(`Unchanged: ${unchanged.length} skill(s)`));
   894→            }
   895→
   896→            // AC: @skill-drift-detection ac-3 - Show warning for skipped drifted skills
   897→            if (skippedDrifted.length > 0) {
   898→              console.log();
   899→              console.log(chalk.yellow(`Skipped: ${skippedDrifted.length} drifted skill(s)`));
   900→              for (const r of skippedDrifted) {
   901→                console.log(`  ${chalk.yellow("!")} ${r.id}: ${r.skipReason || "drifted"}`);
   902→              }
   903→              console.log();
   904→              console.log(chalk.yellow("Use --force to overwrite drifted skills"));
   905→            }
   906→
   907→            // Clean results
   908→            if (cleanResults.length > 0) {
   909→              const removed = cleanResults.filter((r) => r.action === "removed");
   910→              const skipped = cleanResults.filter((r) => r.action === "skipped");
   911→
   912→              if (removed.length > 0) {
   913→                console.log();
   914→                console.log(chalk.red(`Removed: ${removed.length} orphaned skill(s)`));
   915→                for (const r of removed) {
   916→                  console.log(`  ${chalk.red("-")} ${r.id}`);
   917→                }
   918→              }
   919→
   920→              if (skipped.length > 0) {
   921→                console.log(
   922→                  chalk.gray(`Skipped: ${skipped.length} unmanaged skill(s)`)
   923→                );
   924→              }
   925→            }
   926→
   927→            // Summary
   928→            console.log();
   929→            if (dryRun) {
   930→              console.log(
   931→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
   932→              );
   933→            } else {
   934→              const changedCount = created.length + updated.length;
   935→              const cleanedCount = cleanResults.filter(
   936→                (r) => r.action === "removed"
   937→              ).length;
   938→              if (changedCount > 0 || cleanedCount > 0) {
   939→                success(
   940→                  `Rendered ${changedCount} skill(s)${cleanedCount > 0 ? `, cleaned ${cleanedCount}` : ""}`
   941→                );
   942→              } else {
   943→                console.log(chalk.gray("No changes needed"));
   944→              }
   945→            }
   946→          }
   947→        );
   948→      } catch (err) {
   949→        error("Failed to render skills", err);
   950→        process.exit(EXIT_CODES.ERROR);
   951→      }
   952→    });
   953→
   954→  // AC: @skill-render-cli ac-3 - kspec skill status
   955→  skill
   956→    .command("status")
   957→    .description("Show sync status of rendered skills")
   958→    .action(async () => {
   959→      try {
   960→        const ctx = await initContext();
   961→
   962→        if (!ctx.manifestPath) {
   963→          error(errors.project.noKspecProject);
   964→          console.log(
   965→            chalk.gray("Try: kspec init to initialize a kspec project")
   966→          );
   967→          process.exit(EXIT_CODES.ERROR);
   968→        }
   969→
   970→        const metaCtx = await loadMetaContext(ctx);
   971→        const projectRoot = ctx.rootDir;
   972→
   973→        // Filter skills by platform (only claude-code for now)
   974→        const skillsToCheck = metaCtx.skills.filter((s) =>
   975→          s.platforms.includes("claude-code")
   976→        );
   977→
   978→        if (skillsToCheck.length === 0) {
   979→          console.log(chalk.yellow("No skills found"));
   980→          return;
   981→        }
   982→
   983→        const statusResults: SkillStatusResult[] = [];
   984→
   985→        for (const skill of skillsToCheck) {
   986→          const status = await getSkillSyncStatus(ctx, projectRoot, skill);
   987→          statusResults.push(status);
   988→        }
   989→
   990→        // Output results
   991→        output(
   992→          statusResults,
   993→          () => {
   994→            const table = new Table({
   995→              head: [
   996→                chalk.bold("ID"),
   997→                chalk.bold("Status"),
   998→                chalk.bold("Docs"),
   999→              ],
  1000→              style: {
  1001→                head: [],
  1002→                border: [],
  1003→              },
  1004→            });
  1005→
  1006→            for (const result of statusResults) {
  1007→              const statusColor =
  1008→                result.status === "in-sync"
  1009→                  ? chalk.green
  1010→                  : result.status === "drifted"
  1011→                    ? chalk.yellow
  1012→                    : chalk.gray;
  1013→
  1014→              const docsStatusColor =
  1015→                result.docsStatus === "in-sync"
  1016→                  ? chalk.green
  1017→                  : result.docsStatus === "drifted"
  1018→                    ? chalk.yellow
  1019→                    : chalk.gray;
  1020→
  1021→              table.push([
  1022→                result.id,
  1023→                statusColor(result.status),
  1024→                docsStatusColor(result.docsStatus || "-"),
  1025→              ]);
  1026→            }
  1027→
  1028→            console.log(table.toString());
  1029→
  1030→            // Summary
  1031→            const inSync = statusResults.filter((r) => r.status === "in-sync").length;
  1032→            const drifted = statusResults.filter((r) => r.status === "drifted").length;
  1033→            const notRendered = statusResults.filter((r) => r.status === "not-rendered").length;
  1034→
  1035→            console.log();
  1036→            if (drifted > 0) {
  1037→              console.log(chalk.yellow(`${drifted} skill(s) drifted - run 'kspec skill render' to sync`));
  1038→            }
  1039→            if (notRendered > 0) {
  1040→              console.log(chalk.gray(`${notRendered} skill(s) not rendered`));
  1041→            }
  1042→            if (inSync === statusResults.length) {
  1043→              console.log(chalk.green("All skills in sync"));
  1044→            }
  1045→          }
  1046→        );
  1047→      } catch (err) {
  1048→        error("Failed to check skill status", err);
  1049→        process.exit(EXIT_CODES.ERROR);
  1050→      }
  1051→    });
  1052→
  1053→  // AC: @skill-render-cli ac-4 - kspec skill diff
  1054→  skill
  1055→    .command("diff <ref>")
  1056→    .description("Show diff between source and rendered skill")
  1057→    .action(async (ref: string) => {
  1058→      try {
  1059→        const ctx = await initContext();
  1060→
  1061→        if (!ctx.manifestPath) {
  1062→          error(errors.project.noKspecProject);
  1063→          console.log(
  1064→            chalk.gray("Try: kspec init to initialize a kspec project")
  1065→          );
  1066→          process.exit(EXIT_CODES.ERROR);
  1067→        }
  1068→
  1069→        const metaCtx = await loadMetaContext(ctx);
  1070→        const item = findMetaItemByRef(metaCtx, ref);
  1071→
  1072→        if (!item) {
  1073→          error(`Skill not found: ${ref}`);
  1074→          console.log(chalk.gray("Try: kspec skill list"));
  1075→          process.exit(EXIT_CODES.NOT_FOUND);
  1076→        }
  1077→
  1078→        // Check it's a skill
  1079→        if (!("origin" in item)) {
  1080→          error(`Item ${ref} is not a skill`);
  1081→          process.exit(EXIT_CODES.ERROR);
  1082→        }
  1083→
  1084→        const skill = item as LoadedSkill;
  1085→        const projectRoot = ctx.rootDir;
  1086→
  1087→        // Get expected rendered content
  1088→        const expectedContent = await getExpectedRenderedContent(ctx, skill);
  1089→
  1090→        // Get actual rendered content
  1091→        const renderedPath = path.join(
  1092→          projectRoot,
  1093→          ".claude",
  1094→          "skills",
  1095→          skill.id,
  1096→          "SKILL.md"
  1097→        );
  1098→
  1099→        let actualContent = "";
  1100→        try {
  1101→          actualContent = await fs.readFile(renderedPath, "utf-8");
  1102→        } catch {
  1103→          // File doesn't exist
  1104→        }
  1105→
  1106→        // Generate diff
  1107→        const diff = generateUnifiedDiff(
  1108→          actualContent,
  1109→          expectedContent,
  1110→          `a/${skill.id}/SKILL.md`,
  1111→          `b/${skill.id}/SKILL.md`
  1112→        );
  1113→
  1114→        // Output
  1115→        output(
  1116→          {
  1117→            id: skill.id,
  1118→            hasDiff: diff.length > 0,
  1119→            diff,
  1120→          },
  1121→          () => {
  1122→            if (diff.length === 0) {
  1123→              console.log(chalk.green(`${skill.id}: in sync`));
  1124→            } else {
  1125→              console.log(chalk.yellow(`${skill.id}: drifted`));
  1126→              console.log();
  1127→              // Print colored diff
  1128→              for (const line of diff) {
  1129→                if (line.startsWith("+") && !line.startsWith("+++")) {
  1130→                  console.log(chalk.green(line));
  1131→                } else if (line.startsWith("-") && !line.startsWith("---")) {
  1132→                  console.log(chalk.red(line));
  1133→                } else if (line.startsWith("@@")) {
  1134→                  console.log(chalk.cyan(line));
  1135→                } else {
  1136→                  console.log(line);
  1137→                }
  1138→              }
  1139→            }
  1140→          }
  1141→        );
  1142→      } catch (err) {
  1143→        error("Failed to generate diff", err);
  1144→        process.exit(EXIT_CODES.ERROR);
  1145→      }
  1146→    });
  1147→
  1148→  // AC: @core-skill-install - kspec skill install-core
  1149→  markMutating(skill.command("install-core"))
  1150→    .description(
  1151→      "Install core skills from kspec package templates"
  1152→    )
  1153→    .option("--force", "Overwrite custom forks with core versions")
  1154→    .option("--dry-run", "Show what would be installed without making changes")
  1155→    .action(async (options) => {
  1156→      try {
  1157→        const ctx = await initContext();
  1158→
  1159→        if (!ctx.manifestPath) {
  1160→          error(errors.project.noKspecProject);
  1161→          console.log(
  1162→            chalk.gray("Try: kspec init to initialize a kspec project")
  1163→          );
  1164→          process.exit(EXIT_CODES.ERROR);
  1165→        }
  1166→
  1167→        const metaCtx = await loadMetaContext(ctx);
  1168→        const dryRun = options.dryRun || false;
  1169→        const force = options.force || false;
  1170→        const results: CoreSkillInstallResult[] = [];
  1171→
  1172→        // Load core skills manifest
  1173→        const coreSkills = loadCoreSkillsManifest();
  1174→        if (coreSkills.length === 0) {
  1175→          console.log(chalk.yellow("No core skills found in kspec package templates"));
  1176→          return;
  1177→        }
  1178→
  1179→        // Get kspec package version
  1180→        const kspecVersion = getKspecPackageVersion();
  1181→
  1182→        // Process each core skill
  1183→        for (const coreSkill of coreSkills) {
  1184→          // AC: @core-skill-install ac-3 - Check if skill exists with custom origin
  1185→          const existingSkill = metaCtx.skills.find((s) => s.id === coreSkill.id);
  1186→
  1187→          if (existingSkill) {
  1188→            // Check origin - if "custom" or "project" and not forcing, skip
  1189→            if (existingSkill.origin !== "core" && !force) {
  1190→              results.push({
  1191→                id: coreSkill.id,
  1192→                action: "skipped",
  1193→                reason: `existing ${existingSkill.origin} skill (use --force to overwrite)`,
  1194→              });
  1195→              continue;
  1196→            }
  1197→          }
  1198→
  1199→          // AC: @core-skill-install ac-1 - Create/update meta entry with origin core
  1200→          // AC: @core-skill-install ac-5 - Version matches kspec package version
  1201→          const skillData: Skill = {
  1202→            _ulid: existingSkill?._ulid || ulid(),
  1203→            id: coreSkill.id,
  1204→            name: coreSkill.name,
  1205→            description: coreSkill.description,
  1206→            origin: "core",
  1207→            version: kspecVersion,
  1208→            platforms: coreSkill.platforms || ["claude-code"],
  1209→            depends_on: [],
  1210→            tags: ["core"],
  1211→          };
  1212→
  1213→          // Validate with schema
  1214→          const parsed = SkillSchema.safeParse(skillData);
  1215→          if (!parsed.success) {
  1216→            const issues = parsed.error.issues
  1217→              .map((i) => `${i.path.join(".")}: ${i.message}`)
  1218→              .join("; ");
  1219→            results.push({
  1220→              id: coreSkill.id,
  1221→              action: "failed",
  1222→              reason: `validation error: ${issues}`,
  1223→            });
  1224→            continue;
  1225→          }
  1226→
  1227→          const skill: LoadedSkill = { ...parsed.data };
  1228→
  1229→          // Save meta entry (if not dry run)
  1230→          if (!dryRun) {
  1231→            await saveMetaItem(ctx, skill, "skill");
  1232→
  1233→            // AC: @core-skill-install ac-2 - Copy SKILL.md content
  1234→            const sourceContent = loadCoreSkillContent(coreSkill.id);
  1235→            if (sourceContent) {
  1236→              const targetPath = getSkillContentPath(ctx, skill.id);
  1237→              await fs.writeFile(targetPath, sourceContent, "utf-8");
  1238→            }
  1239→          }
  1240→
  1241→          results.push({
  1242→            id: coreSkill.id,
  1243→            action: existingSkill ? "updated" : "created",
  1244→            version: kspecVersion,
  1245→          });
  1246→        }
  1247→
  1248→        // Commit changes if not dry run
  1249→        if (!dryRun && results.some((r) => r.action === "created" || r.action === "updated")) {
  1250→          await commitIfShadow(
  1251→            ctx.shadow,
  1252→            "skill-install-core",
  1253→            `${results.filter((r) => r.action !== "skipped" && r.action !== "failed").length} core skills`
  1254→          );
  1255→        }
  1256→
  1257→        // Output results
  1258→        output(
  1259→          {
  1260→            dry_run: dryRun,
  1261→            results,
  1262→          },
  1263→          () => {
  1264→            if (dryRun) {
  1265→              console.log(chalk.yellow("DRY RUN - No changes made"));
  1266→              console.log();
  1267→            }
  1268→
  1269→            const created = results.filter((r) => r.action === "created");
  1270→            const updated = results.filter((r) => r.action === "updated");
  1271→            const skipped = results.filter((r) => r.action === "skipped");
  1272→            const failed = results.filter((r) => r.action === "failed");
  1273→
  1274→            if (created.length > 0) {
  1275→              console.log(chalk.green(`Created: ${created.length} skill(s)`));
  1276→              for (const r of created) {
  1277→                console.log(`  ${chalk.green("+")} ${r.id} (v${r.version})`);
  1278→              }
  1279→            }
  1280→
  1281→            if (updated.length > 0) {
  1282→              console.log(chalk.blue(`Updated: ${updated.length} skill(s)`));
  1283→              for (const r of updated) {
  1284→                console.log(`  ${chalk.blue("~")} ${r.id} (v${r.version})`);
  1285→              }
  1286→            }
  1287→
  1288→            if (skipped.length > 0) {
  1289→              console.log(chalk.yellow(`Skipped: ${skipped.length} skill(s)`));
  1290→              for (const r of skipped) {
  1291→                console.log(`  ${chalk.yellow("!")} ${r.id}: ${r.reason}`);
  1292→              }
  1293→            }
  1294→
  1295→            if (failed.length > 0) {
  1296→              console.log(chalk.red(`Failed: ${failed.length} skill(s)`));
  1297→              for (const r of failed) {
  1298→                console.log(`  ${chalk.red("x")} ${r.id}: ${r.reason}`);
  1299→              }
  1300→            }
  1301→
  1302→            console.log();
  1303→            if (dryRun) {
  1304→              console.log(
  1305→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
  1306→              );
  1307→            } else {
  1308→              const changedCount = created.length + updated.length;
  1309→              if (changedCount > 0) {
  1310→                success(`Installed ${changedCount} core skill(s)`);
  1311→              } else if (skipped.length > 0) {
  1312→                console.log(chalk.gray("No skills installed (all skipped or failed)"));
  1313→              }
  1314→            }
  1315→          }
  1316→        );
  1317→      } catch (err) {
  1318→        error("Failed to install core skills", err);
  1319→        process.exit(EXIT_CODES.ERROR);
  1320→      }
  1321→    });
  1322→
  1323→  // AC: @core-skill-update - kspec skill update
  1324→  markMutating(skill.command("update"))
  1325→    .description(
  1326→      "Update core skills to match the installed kspec package version"
  1327→    )
  1328→    .option("--dry-run", "Show what would be updated without making changes")
  1329→    .action(async (options) => {
  1330→      try {
  1331→        const ctx = await initContext();
  1332→
  1333→        if (!ctx.manifestPath) {
  1334→          error(errors.project.noKspecProject);
  1335→          console.log(
  1336→            chalk.gray("Try: kspec init to initialize a kspec project")
  1337→          );
  1338→          process.exit(EXIT_CODES.ERROR);
  1339→        }
  1340→
  1341→        const metaCtx = await loadMetaContext(ctx);
  1342→        const dryRun = options.dryRun || false;
  1343→        const results: CoreSkillUpdateResult[] = [];
  1344→
  1345→        // Get kspec package version
  1346→        const kspecVersion = getKspecPackageVersion();
  1347→
  1348→        // Load core skills manifest to get current content
  1349→        const coreSkillsManifest = loadCoreSkillsManifest();
  1350→        const coreSkillsMap = new Map(
  1351→          coreSkillsManifest.map((s) => [s.id, s])
  1352→        );
  1353→
  1354→        // AC: @core-skill-update ac-3 - Only process skills with origin core
  1355→        const coreSkills = metaCtx.skills.filter((s) => s.origin === "core");
  1356→
  1357→        for (const skill of coreSkills) {
  1358→          // AC: @core-skill-update ac-2 - Skip if already at current version
  1359→          if (skill.version === kspecVersion) {
  1360→            results.push({
  1361→              id: skill.id,
  1362→              action: "skipped",
  1363→              reason: "already at current version",
  1364→              currentVersion: skill.version,
  1365→            });
  1366→            continue;
  1367→          }
  1368→
  1369→          // Check if skill exists in core manifest
  1370→          const coreSkill = coreSkillsMap.get(skill.id);
  1371→          if (!coreSkill) {
  1372→            results.push({
  1373→              id: skill.id,
  1374→              action: "skipped",
  1375→              reason: "not found in core skills manifest",
  1376→              currentVersion: skill.version,
  1377→            });
  1378→            continue;
  1379→          }
  1380→
  1381→          // AC: @core-skill-update ac-1 - Update content and version
  1382→          const oldVersion = skill.version;
  1383→
  1384→          if (!dryRun) {
  1385→            // Update skill metadata with new version
  1386→            skill.version = kspecVersion;
  1387→            skill.name = coreSkill.name;
  1388→            if (coreSkill.description) {
  1389→              skill.description = coreSkill.description;
  1390→            }
  1391→            if (coreSkill.platforms) {
  1392→              skill.platforms = coreSkill.platforms;
  1393→            }
  1394→
  1395→            // Save updated metadata
  1396→            await saveMetaItem(ctx, skill, "skill");
  1397→
  1398→            // Update SKILL.md content from templates
  1399→            const sourceContent = loadCoreSkillContent(skill.id);
  1400→            if (sourceContent) {
  1401→              const targetPath = getSkillContentPath(ctx, skill.id);
  1402→              await fs.writeFile(targetPath, sourceContent, "utf-8");
  1403→            }
  1404→          }
  1405→
  1406→          results.push({
  1407→            id: skill.id,
  1408→            action: "updated",
  1409→            previousVersion: oldVersion,
  1410→            newVersion: kspecVersion,
  1411→          });
  1412→        }
  1413→
  1414→        // Commit changes if not dry run and there are updates
  1415→        if (!dryRun && results.some((r) => r.action === "updated")) {
  1416→          await commitIfShadow(
  1417→            ctx.shadow,
  1418→            "skill-update",
  1419→            `${results.filter((r) => r.action === "updated").length} core skills`
  1420→          );
  1421→        }
  1422→
  1423→        // Output results
  1424→        output(
  1425→          {
  1426→            dry_run: dryRun,
  1427→            kspec_version: kspecVersion,
  1428→            results,
  1429→          },
  1430→          () => {
  1431→            if (dryRun) {
  1432→              console.log(chalk.yellow("DRY RUN - No changes made"));
  1433→              console.log();
  1434→            }
  1435→
  1436→            console.log(`kspec version: ${kspecVersion}`);
  1437→            console.log();
  1438→
  1439→            const updated = results.filter((r) => r.action === "updated");
  1440→            const skipped = results.filter((r) => r.action === "skipped");
  1441→
  1442→            if (updated.length > 0) {
  1443→              console.log(chalk.green(`Updated: ${updated.length} skill(s)`));
  1444→              for (const r of updated) {
  1445→                console.log(
  1446→                  `  ${chalk.green("~")} ${r.id}: ${r.previousVersion || "unknown"} → ${r.newVersion}`
  1447→                );
  1448→              }
  1449→            }
  1450→
  1451→            if (skipped.length > 0) {
  1452→              console.log(chalk.gray(`Skipped: ${skipped.length} skill(s)`));
  1453→              for (const r of skipped) {
  1454→                console.log(
  1455→                  `  ${chalk.gray("-")} ${r.id}: ${r.reason}${r.currentVersion ? ` (v${r.currentVersion})` : ""}`
  1456→                );
  1457→              }
  1458→            }
  1459→
  1460→            console.log();
  1461→            if (dryRun) {
  1462→              console.log(
  1463→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
  1464→              );
  1465→            } else if (updated.length > 0) {
  1466→              success(`Updated ${updated.length} core skill(s)`);
  1467→            } else {
  1468→              console.log(chalk.gray("No skills needed updating"));
  1469→            }
  1470→          }
  1471→        );
  1472→      } catch (err) {
  1473→        error("Failed to update core skills", err);
  1474→        process.exit(EXIT_CODES.ERROR);
  1475→      }
  1476→    });
  1477→}
  1478→
  1479→/**
  1480→ * Result of updating a single core skill
  1481→ * AC: @core-skill-update
  1482→ */
  1483→interface CoreSkillUpdateResult {
  1484→  id: string;
  1485→  action: "updated" | "skipped";
  1486→  previousVersion?: string;
  1487→  newVersion?: string;
  1488→  currentVersion?: string;
  1489→  reason?: string;
  1490→}
  1491→
  1492→/**
  1493→ * Result of installing a single core skill
  1494→ */
  1495→interface CoreSkillInstallResult {
  1496→  id: string;
  1497→  action: "created" | "updated" | "skipped" | "failed";
  1498→  version?: string;
  1499→  reason?: string;
  1500→}
  1501→
  1502→/**
  1503→ * Core skill definition from manifest
  1504→ */
  1505→interface CoreSkillDefinition {
  1506→  id: string;
  1507→  name: string;
  1508→  description?: string;
  1509→  platforms?: string[];
  1510→}
  1511→
  1512→/**
  1513→ * Get the kspec package version from package.json
  1514→ * AC: @core-skill-install ac-5
  1515→ */
  1516→function getKspecPackageVersion(): string {
  1517→  try {
  1518→    // Try to find package.json relative to this module
  1519→    const packagePath = path.resolve(
  1520→      import.meta.dirname || path.dirname(new URL(import.meta.url).pathname),
  1521→      "../../../package.json"
  1522→    );
  1523→    const packageJson = JSON.parse(readFileSync(packagePath, "utf-8"));
  1524→    return packageJson.version || "unknown";
  1525→  } catch {
  1526→    return "unknown";
  1527→  }
  1528→}
  1529→
  1530→/**
  1531→ * Get the templates directory path
  1532→ */
  1533→function getTemplatesDir(): string {
  1534→  // Templates are at <package-root>/templates/skills/
  1535→  return path.resolve(
  1536→    import.meta.dirname || path.dirname(new URL(import.meta.url).pathname),
  1537→    "../../../templates/skills"
  1538→  );
  1539→}
  1540→
  1541→/**
  1542→ * Load core skills manifest from templates/skills/manifest.yaml
  1543→ * AC: @core-skill-install ac-1, ac-2
  1544→ */
  1545→function loadCoreSkillsManifest(): CoreSkillDefinition[] {
  1546→  try {
  1547→    const templatesDir = getTemplatesDir();
  1548→    const manifestPath = path.join(templatesDir, "manifest.yaml");
  1549→    const content = readFileSync(manifestPath, "utf-8");
  1550→    const parsed = yaml.parse(content);
  1551→
  1552→    if (!parsed || !Array.isArray(parsed.skills)) {
  1553→      return [];
  1554→    }
  1555→
  1556→    return parsed.skills.map((s: Record<string, unknown>) => ({
  1557→      id: String(s.id || ""),
  1558→      name: String(s.name || s.id || ""),
  1559→      description: s.description ? String(s.description) : undefined,
  1560→      platforms: Array.isArray(s.platforms) ? s.platforms.map(String) : undefined,
  1561→    })).filter((s: CoreSkillDefinition) => s.id);
  1562→  } catch {
  1563→    return [];
  1564→  }
  1565→}
  1566→
  1567→/**
  1568→ * Load SKILL.md content for a core skill from templates
  1569→ * AC: @core-skill-install ac-2
  1570→ */
  1571→function loadCoreSkillContent(skillId: string): string | null {
  1572→  try {
  1573→    const templatesDir = getTemplatesDir();
  1574→    const skillMdPath = path.join(templatesDir, skillId, "SKILL.md");
  1575→    return readFileSync(skillMdPath, "utf-8");
  1576→  } catch {
  1577→    return null;
  1578→  }
  1579→}
  1580→
  1581→/**
  1582→ * Parse YAML frontmatter from markdown content.
  1583→ * Returns null if no valid frontmatter found.
  1584→ */
  1585→function parseFrontmatter(content: string): { name?: string; description?: string } | null {
  1586→  const frontmatterRegex = /^---\n([\s\S]*?)\n---/;
  1587→  const match = content.match(frontmatterRegex);
  1588→
  1589→  if (!match) {
  1590→    return null;
  1591→  }
  1592→
  1593→  try {
  1594→    const parsed = yaml.parse(match[1]);
  1595→
  1596→    if (typeof parsed === "object" && parsed !== null) {
  1597→      return {
  1598→        name: typeof parsed.name === "string" ? parsed.name : undefined,
  1599→        description: typeof parsed.description === "string" ? parsed.description : undefined,
  1600→      };
  1601→    }
  1602→  } catch {
  1603→    // Invalid YAML in frontmatter
  1604→  }
  1605→
  1606→  return null;
  1607→}
  1608→
  1609→/**
  1610→ * Normalize base-directory paths in skill content.
  1611→ * AC: @skill-import ac-7 - Strip or convert absolute paths to relative.
  1612→ *
  1613→ * Matches patterns like:
  1614→ * - "Base directory for this skill: /absolute/path/to/skill"
  1615→ * - Lines starting with hardcoded paths
  1616→ */
  1617→function normalizeBaseDirectory(content: string): string {
  1618→  // Remove or normalize "Base directory for this skill:" lines with absolute paths
  1619→  // Common pattern in Claude-generated skill files
  1620→  const baseDirLineRegex = /^Base directory for this skill:.*$/gm;
  1621→
  1622→  return content.replace(baseDirLineRegex, "");
  1623→}
  1624→
  1625→/**
  1626→ * Recursively copy a directory
  1627→ */
  1628→async function copyDirectory(src: string, dest: string): Promise<void> {
  1629→  const entries = await fs.readdir(src, { withFileTypes: true });
  1630→
  1631→  for (const entry of entries) {
  1632→    const srcPath = path.join(src, entry.name);
  1633→    const destPath = path.join(dest, entry.name);
  1634→
  1635→    if (entry.isDirectory()) {
  1636→      await fs.mkdir(destPath, { recursive: true });
  1637→      await copyDirectory(srcPath, destPath);
  1638→    } else {
  1639→      await fs.copyFile(srcPath, destPath);
  1640→    }
  1641→  }
  1642→}
  1643→
  1644→/**
  1645→ * Marker comment that identifies skill directories managed by kspec
  1646→ * AC: @skill-rendering ac-4 - Only skill directories that were rendered by kspec are considered
  1647→ */
  1648→const KSPEC_MANAGED_MARKER = "<!-- kspec-managed -->";
  1649→
  1650→/**
  1651→ * Result of rendering a single skill
  1652→ * AC: @skill-drift-detection ac-3 - Includes "skipped" action for drifted skills
  1653→ */
  1654→interface SkillRenderResult {
  1655→  id: string;
  1656→  action: "created" | "updated" | "unchanged" | "skipped";
  1657→  path: string;
  1658→  docsAction?: "created" | "updated" | "unchanged" | "skipped";
  1659→  /** Reason why skill was skipped */
  1660→  skipReason?: string;
  1661→}
  1662→
  1663→/**
  1664→ * Result of a clean operation
  1665→ */
  1666→interface CleanResult {
  1667→  id: string;
  1668→  path: string;
  1669→  action: "removed" | "skipped";
  1670→  reason?: string;
  1671→}
  1672→
  1673→/**
  1674→ * Generate YAML frontmatter for a skill
  1675→ * AC: @skill-rendering ac-1 - .claude/skills/<id>/SKILL.md is created with YAML frontmatter
  1676→ */
  1677→function generateFrontmatter(skill: LoadedSkill): string {
  1678→  const frontmatter: Record<string, unknown> = {
  1679→    name: skill.id,
  1680→    description: skill.description || skill.name,
  1681→  };
  1682→  return `---\n${yaml.stringify(frontmatter).trim()}\n---`;
  1683→}
  1684→
  1685→/**
  1686→ * Check if two contents are equal (for idempotency check)
  1687→ */
  1688→function contentsEqual(a: string, b: string): boolean {
  1689→  return a.trim() === b.trim();
  1690→}
  1691→
  1692→/**
  1693→ * Check if a directory is managed by kspec
  1694→ * AC: @skill-rendering ac-4 - Only skill directories rendered by kspec are considered
  1695→ */
  1696→async function isKspecManaged(skillMdPath: string): Promise<boolean> {
  1697→  try {
  1698→    const content = await fs.readFile(skillMdPath, "utf-8");
  1699→    return content.includes(KSPEC_MANAGED_MARKER);
  1700→  } catch {
  1701→    return false;
  1702→  }
  1703→}
  1704→
  1705→/**
  1706→ * Compute SHA256 hash of content
  1707→ * AC: @skill-drift-detection ac-5 - Hash computation for render tracking
  1708→ */
  1709→function computeContentHash(content: string): string {
  1710→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
  1711→}
  1712→
  1713→/**
  1714→ * Get the path to the render hash file for a skill
  1715→ * AC: @skill-drift-detection ac-5 - Hash stored in .kspec/skills/<id>/.render-hash
  1716→ */
  1717→function getRenderHashPath(specDir: string, skillId: string): string {
  1718→  return path.join(specDir, "skills", skillId, ".render-hash");
  1719→}
  1720→
  1721→/**
  1722→ * Read the stored render hash for a skill
  1723→ * AC: @skill-drift-detection ac-5 - Read hash from .kspec/skills/<id>/.render-hash
  1724→ */
  1725→async function readRenderHash(specDir: string, skillId: string): Promise<string | null> {
  1726→  try {
  1727→    const hashPath = getRenderHashPath(specDir, skillId);
  1728→    const content = await fs.readFile(hashPath, "utf-8");
  1729→    return content.trim();
  1730→  } catch {
  1731→    return null;
  1732→  }
  1733→}
  1734→
  1735→/**
  1736→ * Write the render hash for a skill
  1737→ * AC: @skill-drift-detection ac-5 - Store hash in .kspec/skills/<id>/.render-hash
  1738→ */
  1739→async function writeRenderHash(specDir: string, skillId: string, hash: string): Promise<void> {
  1740→  const hashPath = getRenderHashPath(specDir, skillId);
  1741→  await fs.mkdir(path.dirname(hashPath), { recursive: true });
  1742→  await fs.writeFile(hashPath, hash + "\n", "utf-8");
  1743→}
  1744→
  1745→/**
  1746→ * Check if a rendered skill has drifted from its last render
  1747→ * AC: @skill-drift-detection ac-1, ac-2 - Drift detection via hash comparison
  1748→ *
  1749→ * Returns:
  1750→ * - "not-rendered": Rendered file doesn't exist
  1751→ * - "in-sync": Rendered file matches stored hash
  1752→ * - "drifted": Rendered file differs from stored hash (manually edited)
  1753→ * - "no-hash": Rendered file exists but no stored hash (first render or hash deleted)
  1754→ */
  1755→async function checkSkillDrift(
  1756→  specDir: string,
  1757→  projectRoot: string,
  1758→  skillId: string
  1759→): Promise<"not-rendered" | "in-sync" | "drifted" | "no-hash"> {
  1760→  const renderedPath = path.join(projectRoot, ".claude", "skills", skillId, "SKILL.md");
  1761→
  1762→  // Check if rendered file exists
  1763→  let renderedContent: string;
  1764→  try {
  1765→    renderedContent = await fs.readFile(renderedPath, "utf-8");
  1766→  } catch {
  1767→    return "not-rendered";
  1768→  }
  1769→
  1770→  // Get stored hash
  1771→  const storedHash = await readRenderHash(specDir, skillId);
  1772→  if (!storedHash) {
  1773→    return "no-hash";
  1774→  }
  1775→
  1776→  // Compare hashes
  1777→  const currentHash = computeContentHash(renderedContent);
  1778→  return currentHash === storedHash ? "in-sync" : "drifted";
  1779→}
  1780→
  1781→/**
  1782→ * Recursively check if two directories have the same contents
  1783→ */
  1784→async function directoriesEqual(src: string, dest: string): Promise<boolean> {
  1785→  try {
  1786→    const srcEntries = await fs.readdir(src, { withFileTypes: true });
  1787→    const destEntries = await fs.readdir(dest, { withFileTypes: true });
  1788→
  1789→    // Different number of entries = not equal
  1790→    if (srcEntries.length !== destEntries.length) {
  1791→      return false;
  1792→    }
  1793→
  1794→    // Create a map of dest entries for quick lookup
  1795→    const destMap = new Map(destEntries.map((e) => [e.name, e]));
  1796→
  1797→    for (const srcEntry of srcEntries) {
  1798→      const destEntry = destMap.get(srcEntry.name);
  1799→      if (!destEntry) {
  1800→        return false;
  1801→      }
  1802→
  1803→      const srcPath = path.join(src, srcEntry.name);
  1804→      const destPath = path.join(dest, srcEntry.name);
  1805→
  1806→      if (srcEntry.isDirectory() && destEntry.isDirectory()) {
  1807→        if (!(await directoriesEqual(srcPath, destPath))) {
  1808→          return false;
  1809→        }
  1810→      } else if (srcEntry.isFile() && destEntry.isFile()) {
  1811→        const srcContent = await fs.readFile(srcPath, "utf-8");
  1812→        const destContent = await fs.readFile(destPath, "utf-8");
  1813→        if (!contentsEqual(srcContent, destContent)) {
  1814→          return false;
  1815→        }
  1816→      } else {
  1817→        // Type mismatch
  1818→        return false;
  1819→      }
  1820→    }
  1821→
  1822→    return true;
  1823→  } catch {
  1824→    return false;
  1825→  }
  1826→}
  1827→
  1828→/**
  1829→ * Get the target path for rendered skills (main branch .claude/skills/)
  1830→ */
  1831→function getRenderedSkillPath(projectRoot: string, skillId: string): string {
  1832→  return path.join(projectRoot, ".claude", "skills", skillId);
  1833→}
  1834→
  1835→/**
  1836→ * Render a single skill from shadow branch to main branch.
  1837→ * AC: @skill-rendering ac-1 - Creates .claude/skills/<id>/SKILL.md with YAML frontmatter
  1838→ * AC: @skill-rendering ac-2 - Copies docs to .claude/skills/<id>/docs/
  1839→ * AC: @skill-rendering ac-3 - Idempotent (no changes if content unchanged)
  1840→ */
  1841→async function renderSkill(
  1842→  ctx: KspecContext,
  1843→  projectRoot: string,
  1844→  skill: LoadedSkill,
  1845→  dryRun: boolean
  1846→): Promise<SkillRenderResult> {
  1847→  const targetDir = getRenderedSkillPath(projectRoot, skill.id);
  1848→  const targetSkillMd = path.join(targetDir, "SKILL.md");
  1849→
  1850→  // Load source content
  1851→  const sourceContent = await loadSkillContent(ctx, skill);
  1852→  if (!sourceContent) {
  1853→    // No source content, but skill exists in meta - create placeholder
  1854→    const frontmatter = generateFrontmatter(skill);
  1855→    const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
  1856→
  1857→    if (!dryRun) {
  1858→      await fs.mkdir(targetDir, { recursive: true });
  1859→      await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
  1860→      // AC: @skill-drift-detection ac-5 - Store hash of rendered output
  1861→      const hash = computeContentHash(renderedContent);
  1862→      await writeRenderHash(ctx.specDir, skill.id, hash);
  1863→    }
  1864→
  1865→    return {
  1866→      id: skill.id,
  1867→      action: "created",
  1868→      path: targetSkillMd,
  1869→    };
  1870→  }
  1871→
  1872→  // Generate rendered content with frontmatter and marker
  1873→  const frontmatter = generateFrontmatter(skill);
  1874→
  1875→  // Check if source already has frontmatter - if so, strip it
  1876→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
  1877→  const contentWithoutFrontmatter = frontmatterMatch
  1878→    ? sourceContent.slice(frontmatterMatch[0].length)
  1879→    : sourceContent;
  1880→
  1881→  // Build the rendered content
  1882→  const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
  1883→
  1884→  // Check if target exists and compare for idempotency
  1885→  // AC: @skill-rendering ac-3 - No changes if content unchanged
  1886→  let targetExists = false;
  1887→  let targetContent = "";
  1888→  try {
  1889→    targetContent = await fs.readFile(targetSkillMd, "utf-8");
  1890→    targetExists = true;
  1891→  } catch {
  1892→    // Target doesn't exist
  1893→  }
  1894→
  1895→  // Determine action based on comparison
  1896→  let action: "created" | "updated" | "unchanged";
  1897→
  1898→  if (!targetExists) {
  1899→    action = "created";
  1900→  } else if (contentsEqual(renderedContent, targetContent)) {
  1901→    action = "unchanged";
  1902→  } else {
  1903→    action = "updated";
  1904→  }
  1905→
  1906→  // Apply changes if not dry run and there are changes
  1907→  if (!dryRun && action !== "unchanged") {
  1908→    await fs.mkdir(targetDir, { recursive: true });
  1909→    await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
  1910→    // AC: @skill-drift-detection ac-5 - Store hash of rendered output
  1911→    const hash = computeContentHash(renderedContent);
  1912→    await writeRenderHash(ctx.specDir, skill.id, hash);
  1913→  }
  1914→
  1915→  // Handle docs directory
  1916→  // AC: @skill-rendering ac-2 - Copy docs to target
  1917→  const sourceDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
  1918→  const targetDocsDir = path.join(targetDir, "docs");
  1919→  let docsAction: "created" | "updated" | "unchanged" | "skipped" = "skipped";
  1920→
  1921→  try {
  1922→    const stats = await fs.stat(sourceDocsDir);
  1923→    if (stats.isDirectory()) {
  1924→      // Check if target docs exist and compare
  1925→      let targetDocsExist = false;
  1926→      try {
  1927→        await fs.stat(targetDocsDir);
  1928→        targetDocsExist = true;
  1929→      } catch {
  1930→        // Target docs don't exist
  1931→      }
  1932→
  1933→      if (!targetDocsExist) {
  1934→        docsAction = "created";
  1935→      } else {
  1936→        // Compare directories
  1937→        const equal = await directoriesEqual(sourceDocsDir, targetDocsDir);
  1938→        docsAction = equal ? "unchanged" : "updated";
  1939→      }
  1940→
  1941→      // Apply changes
  1942→      if (!dryRun && docsAction !== "unchanged") {
  1943→        // Remove existing docs and copy fresh
  1944→        if (targetDocsExist) {
  1945→          await fs.rm(targetDocsDir, { recursive: true, force: true });
  1946→        }
  1947→        await fs.mkdir(targetDocsDir, { recursive: true });
  1948→        await copyDirectory(sourceDocsDir, targetDocsDir);
  1949→      }
  1950→    }
  1951→  } catch {
  1952→    // No source docs directory
  1953→  }
  1954→
  1955→  return {
  1956→    id: skill.id,
  1957→    action,
  1958→    path: targetSkillMd,
  1959→    docsAction,
  1960→  };
  1961→}
  1962→
  1963→/**
  1964→ * Result of checking a skill's sync status
  1965→ * AC: @skill-render-cli ac-3
  1966→ */
  1967→interface SkillStatusResult {
  1968→  id: string;
  1969→  status: "in-sync" | "drifted" | "not-rendered";
  1970→  docsStatus?: "in-sync" | "drifted" | "not-rendered" | "no-docs";
  1971→}
  1972→
  1973→/**
  1974→ * Get the sync status of a skill
  1975→ * AC: @skill-render-cli ac-3
  1976→ * AC: @skill-drift-detection ac-1, ac-2 - Uses hash-based drift detection
  1977→ */
  1978→async function getSkillSyncStatus(
  1979→  ctx: KspecContext,
  1980→  projectRoot: string,
  1981→  skill: LoadedSkill
  1982→): Promise<SkillStatusResult> {
  1983→  // AC: @skill-drift-detection ac-1, ac-2 - Use hash-based drift detection
  1984→  const driftStatus = await checkSkillDrift(ctx.specDir, projectRoot, skill.id);
  1985→
  1986→  // Map drift status to sync status
  1987→  let status: "in-sync" | "drifted" | "not-rendered";
  1988→  switch (driftStatus) {
  1989→    case "in-sync":
  1990→      status = "in-sync";
  1991→      break;
  1992→    case "drifted":
  1993→      status = "drifted";
  1994→      break;
  1995→    case "not-rendered":
  1996→      status = "not-rendered";
  1997→      break;
  1998→    case "no-hash":
  1999→      // No hash stored - need to check if content matches expected
  2000→      // (handles edge case where skill was rendered before hash tracking was added)
  2001→      const expectedContent = await getExpectedRenderedContent(ctx, skill);
  2002→      const renderedPath = path.join(
  2003→        projectRoot,
  2004→        ".claude",
  2005→        "skills",
  2006→        skill.id,
  2007→        "SKILL.md"
  2008→      );
  2009→      try {
  2010→        const actualContent = await fs.readFile(renderedPath, "utf-8");
  2011→        status = contentsEqual(expectedContent, actualContent) ? "in-sync" : "drifted";
  2012→      } catch {
  2013→        status = "not-rendered";
  2014→      }
  2015→      break;
  2016→  }
  2017→
  2018→  // Check docs status
  2019→  const sourceDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
  2020→  const targetDocsDir = path.join(projectRoot, ".claude", "skills", skill.id, "docs");
  2021→  let docsStatus: "in-sync" | "drifted" | "not-rendered" | "no-docs" = "no-docs";
  2022→
  2023→  try {
  2024→    await fs.stat(sourceDocsDir);
  2025→    // Source docs exist, check target
  2026→    try {
  2027→      await fs.stat(targetDocsDir);
  2028→      // Both exist, compare
  2029→      const equal = await directoriesEqual(sourceDocsDir, targetDocsDir);
  2030→      docsStatus = equal ? "in-sync" : "drifted";
  2031→    } catch {
  2032→      docsStatus = "not-rendered";
  2033→    }
  2034→  } catch {
  2035→    // No source docs
  2036→    docsStatus = "no-docs";
  2037→  }
  2038→
  2039→  return {
  2040→    id: skill.id,
  2041→    status,
  2042→    docsStatus,
  2043→  };
  2044→}
  2045→
  2046→/**
  2047→ * Get the expected rendered content for a skill
  2048→ */
  2049→async function getExpectedRenderedContent(
  2050→  ctx: KspecContext,
  2051→  skill: LoadedSkill
  2052→): Promise<string> {
  2053→  const sourceContent = await loadSkillContent(ctx, skill);
  2054→
  2055→  if (!sourceContent) {
  2056→    // No source content, generate placeholder
  2057→    const frontmatter = generateFrontmatter(skill);
  2058→    return `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
  2059→  }
  2060→
  2061→  // Generate rendered content with frontmatter and marker
  2062→  const frontmatter = generateFrontmatter(skill);
  2063→
  2064→  // Check if source already has frontmatter - if so, strip it
  2065→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
  2066→  const contentWithoutFrontmatter = frontmatterMatch
  2067→    ? sourceContent.slice(frontmatterMatch[0].length)
  2068→    : sourceContent;
  2069→
  2070→  return `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
  2071→}
  2072→
  2073→/**
  2074→ * Generate unified diff between two strings
  2075→ * AC: @skill-render-cli ac-4
  2076→ */
  2077→function generateUnifiedDiff(
  2078→  actual: string,
  2079→  expected: string,
  2080→  actualPath: string,
  2081→  expectedPath: string
  2082→): string[] {
  2083→  if (contentsEqual(actual, expected)) {
  2084→    return [];
  2085→  }
  2086→
  2087→  const actualLines = actual.split("\n");
  2088→  const expectedLines = expected.split("\n");
  2089→  const diffLines: string[] = [];
  2090→
  2091→  // Simple line-by-line diff (unified format)
  2092→  diffLines.push(`--- ${actualPath}`);
  2093→  diffLines.push(`+++ ${expectedPath}`);
  2094→
  2095→  // Find differing sections and create hunks
  2096→  let i = 0;
  2097→  let j = 0;
  2098→
  2099→  while (i < actualLines.length || j < expectedLines.length) {
  2100→    // Find start of difference
  2101→    const contextStart = i;
  2102→    const contextStartExpected = j;
  2103→
  2104→    // Skip matching lines
  2105→    while (
  2106→      i < actualLines.length &&
  2107→      j < expectedLines.length &&
  2108→      actualLines[i] === expectedLines[j]
  2109→    ) {
  2110→      i++;
  2111→      j++;
  2112→    }
  2113→
  2114→    // If we've reached the end, we're done
  2115→    if (i >= actualLines.length && j >= expectedLines.length) {
  2116→      break;
  2117→    }
  2118→
  2119→    // Find end of difference
  2120→    let diffEndActual = i;
  2121→    let diffEndExpected = j;
  2122→
  2123→    // Collect differing lines
  2124→    while (
  2125→      diffEndActual < actualLines.length &&
  2126→      diffEndExpected < expectedLines.length &&
  2127→      actualLines[diffEndActual] !== expectedLines[diffEndExpected]
  2128→    ) {
  2129→      diffEndActual++;
  2130→      diffEndExpected++;
  2131→    }
  2132→
  2133→    // Also handle case where one side has more lines
  2134→    while (diffEndActual < actualLines.length && diffEndExpected >= expectedLines.length) {
  2135→      diffEndActual++;
  2136→    }
  2137→    while (diffEndExpected < expectedLines.length && diffEndActual >= actualLines.length) {
  2138→      diffEndExpected++;
  2139→    }
  2140→
  2141→    // Create hunk header (show 3 lines of context)
  2142→    const hunkStartActual = Math.max(0, contextStart - 3);
  2143→    const hunkStartExpected = Math.max(0, contextStartExpected - 3);
  2144→
  2145→    // Include context after diff too
  2146→    const hunkEndActual = Math.min(actualLines.length, diffEndActual + 3);
  2147→    const hunkEndExpected = Math.min(expectedLines.length, diffEndExpected + 3);
  2148→
  2149→    const actualCount = hunkEndActual - hunkStartActual;
  2150→    const expectedCount = hunkEndExpected - hunkStartExpected;
  2151→
  2152→    diffLines.push(
  2153→      `@@ -${hunkStartActual + 1},${actualCount} +${hunkStartExpected + 1},${expectedCount} @@`
  2154→    );
  2155→
  2156→    // Leading context
  2157→    for (let k = hunkStartActual; k < contextStart; k++) {
  2158→      diffLines.push(` ${actualLines[k]}`);
  2159→    }
  2160→
  2161→    // Removed lines (from actual)
  2162→    for (let k = contextStart; k < diffEndActual; k++) {
  2163→      if (k < actualLines.length) {
  2164→        diffLines.push(`-${actualLines[k]}`);
  2165→      }
  2166→    }
  2167→
  2168→    // Added lines (from expected)
  2169→    for (let k = contextStartExpected; k < diffEndExpected; k++) {
  2170→      if (k < expectedLines.length) {
  2171→        diffLines.push(`+${expectedLines[k]}`);
  2172→      }
  2173→    }
  2174→
  2175→    // Trailing context
  2176→    for (let k = diffEndActual; k < hunkEndActual; k++) {
  2177→      if (k < actualLines.length) {
  2178→        diffLines.push(` ${actualLines[k]}`);
  2179→      }
  2180→    }
  2181→
  2182→    i = hunkEndActual;
  2183→    j = hunkEndExpected;
  2184→  }
  2185→
  2186→  return diffLines;
  2187→}
  2188→
  2189→// Re-export for testing
  2190→export {
  2191→  renderSkill,
  2192→  isKspecManaged,
  2193→  KSPEC_MANAGED_MARKER,
  2194→  getSkillSyncStatus,
  2195→  getExpectedRenderedContent,
  2196→  generateUnifiedDiff,
  2197→  loadCoreSkillsManifest,
  2198→  loadCoreSkillContent,
  2199→  getKspecPackageVersion,
  2200→};
  2201→

