    90→
    91→    it('should have a row per skill', async () => {
    92→      kspecFull('agents generate', tempDir);
    93→
    94→      const filePath = path.join(tempDir, 'kspec-agents.md');
    95→      const content = await fs.readFile(filePath, 'utf-8');
    96→
    97→      // Each skill should be listed with its description and /id reference
    98→      expect(content).toContain('Work on tasks with proper lifecycle');
    99→      expect(content).toContain('`/task-work` skill');
   100→
   101→      expect(content).toContain('Review and merge pull requests');
   102→      expect(content).toContain('`/pr-review` skill');
   103→
   104→      expect(content).toContain('Plan to spec translation');
