    83→      const filePath = path.join(tempDir, 'kspec-agents.md');
    84→      const content = await fs.readFile(filePath, 'utf-8');
    85→
    86→      expect(content).toContain('## Finding Information');
    87→      expect(content).toContain('| Need | Where to look |');
