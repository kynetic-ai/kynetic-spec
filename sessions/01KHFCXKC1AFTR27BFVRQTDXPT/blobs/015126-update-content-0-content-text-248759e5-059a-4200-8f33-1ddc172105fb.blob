    69→      );
    70→      kspecFull(
    71→        'skill add --id pr-review --name "PR Review" --description "Review and merge pull requests"',
    72→        tempDir
    73→      );
    74→      kspecFull(
    75→        'skill add --id spec-plan --name "Spec Plan" --description "Plan to spec translation"',
    76→        tempDir
    77→      );
    78→    });
    79→
    80→    it('should include Finding Information table', async () => {
