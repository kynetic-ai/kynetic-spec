     1→/**
     2→ * Tests for Agent Instruction Generation
     3→ * AC: @agent-instruction-gen ac-1 through ac-5
     4→ * AC: @trait-dry-run (dry run support)
     5→ */
     6→
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import * as fs from 'node:fs/promises';
     9→import * as path from 'node:path';
    10→import {
    11→  kspec as kspecFull,
    12→  kspecJson,
    13→  setupTempFixtures,
    14→  cleanupTempDir,
    15→  initGitRepo,
    16→} from './helpers/cli';
    17→
    18→describe('Agent Instruction Generation', () => {
    19→  let tempDir: string;
    20→
    21→  beforeEach(async () => {
    22→    tempDir = await setupTempFixtures();
    23→    await initGitRepo(tempDir);
    24→  });
    25→
    26→  afterEach(async () => {
    27→    await cleanupTempDir(tempDir);
    28→  });
    29→
    30→  // AC: @agent-instruction-gen ac-1
    31→  describe('ac-1: kspec agents generate creates kspec-agents.md in project root', () => {
    32→    it('should create kspec-agents.md when generate is run', async () => {
    33→      const result = kspecFull('agents generate', tempDir);
    34→      expect(result.exitCode).toBe(0);
    35→
    36→      const filePath = path.join(tempDir, 'kspec-agents.md');
    37→      const content = await fs.readFile(filePath, 'utf-8');
    38→      expect(content).toBeTruthy();
    39→      expect(content).toContain('# kspec Agent Instructions');
    40→    });
    41→
    42→    it('should overwrite existing kspec-agents.md', async () => {
    43→      // Create initial file
    44→      kspecFull('agents generate', tempDir);
    45→
    46→      // Create a skill to add content
    47→      kspecFull(
    48→        'skill add --id my-skill --name "My Skill" --description "Test skill"',
    49→        tempDir
    50→      );
    51→
    52→      // Regenerate
    53→      const result = kspecFull('agents generate', tempDir);
    54→      expect(result.exitCode).toBe(0);
    55→
    56→      const filePath = path.join(tempDir, 'kspec-agents.md');
    57→      const content = await fs.readFile(filePath, 'utf-8');
    58→      expect(content).toContain('my-skill');
    59→    });
    60→  });
    61→
    62→  // AC: @agent-instruction-gen ac-2
    63→  describe('ac-2: output includes Finding Information table with row per skill', () => {
    64→    beforeEach(async () => {
