   200→  // AC: @agent-instruction-gen ac-5
   201→  describe('ac-5: kspec agents status reports stale when not regenerated after meta changes', () => {
   202→    it('should report missing when file does not exist', async () => {
   203→      const result = kspecFull('agents status', tempDir);
   204→      expect(result.exitCode).toBe(0);
   205→      expect(result.stdout).toContain('does not exist');
   206→      expect(result.stdout).toContain("'kspec agents generate'");
   207→    });
   208→
   209→    it('should report current when file is up to date', async () => {
   210→      kspecFull('agents generate', tempDir);
   211→
   212→      const result = kspecFull('agents status', tempDir);
   213→      expect(result.exitCode).toBe(0);
   214→      expect(result.stdout).toContain('up to date');
   215→    });
   216→
   217→    it('should report stale when meta has changed since generation', async () => {
   218→      kspecFull('agents generate', tempDir);
   219→
   220→      // Add a new skill (changes meta)
   221→      kspecFull(
   222→        'skill add --id new-skill --name "New Skill" --description "A new skill"',
   223→        tempDir
   224→      );
   225→
   226→      const result = kspecFull('agents status', tempDir);
   227→      expect(result.exitCode).toBe(0);
   228→      expect(result.stdout).toContain('stale');
   229→      expect(result.stdout).toContain("'kspec agents generate'");
   230→    });
   231→
   232→    it('should report stale when hash file is missing', async () => {
   233→      kspecFull('agents generate', tempDir);
   234→
   235→      // Delete the hash file
   236→      const hashPath = path.join(tempDir, '.kspec', '.kspec-agents-hash');
   237→      await fs.rm(hashPath);
   238→
   239→      const result = kspecFull('agents status', tempDir);
   240→      expect(result.exitCode).toBe(0);
   241→      expect(result.stdout).toContain('stale');
   242→    });
   243→
   244→    it('should return status in JSON output', async () => {
   245→      kspecFull('agents generate', tempDir);
   246→
   247→      const result = kspecJson<{
   248→        exists: boolean;
   249→        path: string;
   250→        status: string;
   251→        generatedAt?: string;
   252→      }>('agents status', tempDir);
   253→
   254→      expect(result.exists).toBe(true);
   255→      expect(result.status).toBe('current');
   256→      expect(result.path).toContain('kspec-agents.md');
   257→      expect(result.generatedAt).toBeTruthy();
   258→    });
   259→
   260→    it('should become current again after regenerating', async () => {
   261→      kspecFull('agents generate', tempDir);
   262→
   263→      // Add a skill to make it stale
   264→      kspecFull(
   265→        'skill add --id another-skill --name "Another" --description "Another skill"',
   266→        tempDir
   267→      );
   268→
   269→      // Verify stale
   270→      let status = kspecFull('agents status', tempDir);
   271→      expect(status.stdout).toContain('stale');
   272→
   273→      // Regenerate
   274→      kspecFull('agents generate', tempDir);
   275→
   276→      // Verify current
   277→      status = kspecFull('agents status', tempDir);
   278→      expect(status.stdout).toContain('up to date');
   279→    });
   280→  });
