   107→
   108→    it('should not include Finding Information table when no skills exist', async () => {
   109→      // No skills in this test case (fresh fixture)
   110→      // Use a new temp dir
   111→      const freshDir = await setupTempFixtures();
   112→      await initGitRepo(freshDir);
   113→
   114→      // Don't add any skills
   115→      kspecFull('agents generate', freshDir);
