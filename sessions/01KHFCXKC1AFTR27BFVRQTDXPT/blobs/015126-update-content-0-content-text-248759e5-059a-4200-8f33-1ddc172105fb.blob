   127→  // AC: @agent-instruction-gen ac-3
   128→  describe('ac-3: output includes conventions section listing rules by domain', () => {
   129→    it('should include conventions section with rules by domain', async () => {
   130→      // The test fixtures include conventions in the meta manifest
   131→      // We need to check if they appear in the generated file
   132→      kspecFull('agents generate', tempDir);
   133→
   134→      const filePath = path.join(tempDir, 'kspec-agents.md');
   135→      const content = await fs.readFile(filePath, 'utf-8');
   136→
   137→      // Check for conventions section
   138→      // Note: The fixtures may or may not have conventions
   139→      // We check the structure is correct when conventions exist
   140→      if (content.includes('## Conventions')) {
   141→        expect(content).toMatch(/### \w+/); // Domain headers
   142→        expect(content).toMatch(/^- /m); // Rules as list items
   143→      }
   144→    });
   145→
   146→    it('should not include conventions section when no conventions exist', async () => {
   147→      // Fresh dir without conventions
   148→      const freshDir = await setupTempFixtures();
   149→      await initGitRepo(freshDir);
   150→
   151→      // Remove any conventions from meta (write empty meta file)
   152→      const metaPath = path.join(freshDir, 'kynetic.meta.yaml');
   153→      await fs.writeFile(
   154→        metaPath,
   155→        'kynetic_meta: "1.0"\nagents: []\nworkflows: []\nconventions: []\nobservations: []\nskills: []\n',
   156→        'utf-8'
   157→      );
   158→
   159→      kspecFull('agents generate', freshDir);
   160→
   161→      const filePath = path.join(freshDir, 'kspec-agents.md');
   162→      const content = await fs.readFile(filePath, 'utf-8');
   163→
   164→      expect(content).not.toContain('## Conventions');
   165→
   166→      await cleanupTempDir(freshDir);
   167→    });
   168→  });
