```
     1→/**
     2→ * Agent instruction generation commands.
     3→ *
     4→ * AC: @agent-instruction-gen ac-1 - kspec agents generate creates kspec-agents.md in project root
     5→ * AC: @agent-instruction-gen ac-2 - output includes Finding Information table with row per skill
     6→ * AC: @agent-instruction-gen ac-3 - output includes conventions section listing rules by domain
     7→ * AC: @agent-instruction-gen ac-4 - output contains freshness comment with kspec version and timestamp
     8→ * AC: @agent-instruction-gen ac-5 - kspec agents status reports stale when not regenerated after meta changes
     9→ *
    10→ * AC: @agents-cli ac-1 - kspec agents generate writes kspec-agents.md to project root
    11→ * AC: @agents-cli ac-2 - kspec agents generate --dry-run prints content without writing
    12→ * AC: @agents-cli ac-3 - kspec agents status reports up to date when current
    13→ * AC: @agents-cli ac-4 - kspec agents status reports stale when meta changed
    14→ *
    15→ * AC: @agent-templates ac-1 - template sections included in output in defined order
    16→ * AC: @agent-templates ac-2 - each template section appears in generated output
    17→ * AC: @agent-templates ac-3 - error if template directory missing or empty
    18→ */
    19→
    20→import * as crypto from "node:crypto";
    21→import * as fs from "node:fs/promises";
    22→import { createRequire } from "node:module";
    23→import * as path from "node:path";
    24→import { fileURLToPath } from "node:url";
    25→import chalk from "chalk";
    26→import type { Command } from "commander";
    27→import {
    28→  initContext,
    29→  loadMetaContext,
    30→  type LoadedConvention,
    31→  type LoadedSkill,
    32→  type LoadedWorkflow,
    33→} from "../../parser/index.js";
    34→import { errors } from "../../strings/errors.js";
    35→import { EXIT_CODES } from "../exit-codes.js";
    36→import { error, output, success } from "../output.js";
    37→
    38→const __filename = fileURLToPath(import.meta.url);
    39→const __dirname = path.dirname(__filename);
    40→
    41→// Read version from package.json at runtime
    42→const require = createRequire(import.meta.url);
    43→const { version } = require("../../../package.json");
    44→
    45→/**
    46→ * File name for generated agent instructions
    47→ */
    48→const GENERATED_FILE_NAME = "kspec-agents.md";
    49→
    50→/**
    51→ * Hash file name for tracking freshness
    52→ */
    53→const HASH_FILE_NAME = ".kspec-agents-hash";
    54→
    55→/**
    56→ * Templates directory name relative to package root
    57→ */
    58→const TEMPLATES_DIR = "templates/agents-sections";
    59→
    60→/**
    61→ * Expected template files in order
    62→ * AC: @agent-templates ac-2 - template files for quick-start, shadow-branch, task-lifecycle, pr-workflow, commit-convention, ralph-loop
    63→ */
    64→const EXPECTED_TEMPLATES = [
    65→  "01-quick-start.md",
    66→  "02-shadow-branch.md",
    67→  "03-task-lifecycle.md",
    68→  "04-pr-workflow.md",
    69→  "05-commit-convention.md",
    70→  "06-ralph-loop.md",
    71→];
    72→
    73→/**
    74→ * Compute SHA256 hash of content
    75→ */
    76→function computeHash(content: string): string {
    77→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
    78→}
    79→
    80→/**
    81→ * Load template sections from the templates directory.
    82→ * AC: @agent-templates ac-1 - all template sections included in defined order
    83→ * AC: @agent-templates ac-3 - error if directory missing or empty
    84→ */
    85→async function loadTemplateSections(packageRoot: string): Promise<string[]> {
    86→  const templatesPath = path.join(packageRoot, TEMPLATES_DIR);
    87→
    88→  // Check if templates directory exists
    89→  try {
    90→    await fs.access(templatesPath);
    91→  } catch {
    92→    throw new Error(
    93→      `Templates directory not found at: ${templatesPath}. ` +
    94→        `Expected templates/agents-sections/ directory with section markdown files.`,
    95→    );
    96→  }
    97→
    98→  // Read directory contents
    99→  const entries = await fs.readdir(templatesPath, { withFileTypes: true });
   100→  const mdFiles = entries
   101→    .filter((e) => e.isFile() && e.name.endsWith(".md"))
   102→    .map((e) => e.name)
   103→    .sort(); // Sort to ensure consistent ordering by filename prefix
   104→
   105→  if (mdFiles.length === 0) {
   106→    throw new Error(
   107→      `Templates directory is empty: ${templatesPath}. ` +
   108→        `Expected markdown files for agent instruction sections.`,
   109→    );
   110→  }
   111→
   112→  // Load each template in order
   113→  const sections: string[] = [];
   114→  for (const filename of mdFiles) {
   115→    const filePath = path.join(templatesPath, filename);
   116→    const content = await fs.readFile(filePath, "utf-8");
   117→    sections.push(content.trim());
   118→  }
   119→
   120→  return sections;
   121→}
   122→
   123→/**
   124→ * Get the package root directory (where templates/ is located)
   125→ */
   126→function getPackageRoot(): string {
   127→  // Navigate from dist/cli/commands/ to package root
   128→  return path.resolve(__dirname, "..", "..", "..");
   129→}
   130→
   131→/**
   132→ * Generate a hash of the meta content that affects the generated file.
   133→ * This is used to detect if the generated file is stale.
   134→ */
   135→function computeMetaHash(
   136→  skills: LoadedSkill[],
   137→  conventions: LoadedConvention[],
   138→  workflows: LoadedWorkflow[],
   139→): string {
   140→  // Create a stable representation of the meta content
   141→  const data = {
   142→    skills: skills.map((s) => ({
   143→      id: s.id,
   144→      name: s.name,
   145→      description: s.description,
   146→    })),
   147→    conventions: conventions.map((c) => ({
   148→      domain: c.domain,
   149→      rules: c.rules,
   150→    })),
   151→    workflows: workflows.map((w) => ({
   152→      id: w.id,
   153→      trigger: w.trigger,
   154→      description: w.description,
   155→    })),
   156→  };
   157→  return computeHash(JSON.stringify(data));
   158→}
   159→
   160→/**
   161→ * Generate the Finding Information table for skills.
   162→ * AC: @agent-instruction-gen ac-2 - Finding Information table with row per skill
   163→ */
   164→function generateSkillsTable(skills: LoadedSkill[]): string {
   165→  if (skills.length === 0) {
   166→    return "";
   167→  }
   168→
   169→  const lines: string[] = [
   170→    "## Finding Information",
   171→    "",
   172→    "Use skills and CLI help for detailed documentation:",
   173→    "",
   174→    "| Need | Where to look |",
   175→    "|------|---------------|",
   176→  ];
   177→
   178→  for (const skill of skills) {
   179→    const description = skill.description || skill.name;
   180→    // Use the skill ID as the reference (prefixed with /)
   181→    lines.push(`| ${description} | \`/${skill.id}\` skill |`);
   182→  }
   183→
   184→  lines.push("");
   185→  lines.push(
   186→    "Skills inject their full documentation when invoked — you don't need to memorize their contents.",
   187→  );
   188→  lines.push("");
   189→
   190→  return lines.join("\n");
   191→}
   192→
   193→/**
   194→ * Generate the conventions section.
   195→ * AC: @agent-instruction-gen ac-3 - conventions section listing rules by domain
   196→ */
   197→function generateConventionsSection(conventions: LoadedConvention[]): string {
   198→  if (conventions.length === 0) {
   199→    return "";
   200→  }
   201→
   202→  const lines: string[] = ["## Conventions", ""];
   203→
   204→  for (const convention of conventions) {
   205→    lines.push(`### ${convention.domain}`);
   206→    lines.push("");
   207→
   208→    for (const rule of convention.rules) {
   209→      lines.push(`- ${rule}`);
   210→    }
   211→
   212→    lines.push("");
   213→  }
   214→
   215→  return lines.join("\n");
   216→}
   217→
   218→/**
   219→ * Generate the workflows summary section.
   220→ */
   221→function generateWorkflowsSection(workflows: LoadedWorkflow[]): string {
   222→  if (workflows.length === 0) {
   223→    return "";
   224→  }
   225→
   226→  const lines: string[] = [
   227→    "## Workflows",
   228→    "",
   229→    "Available workflows:",
   230→    "",
   231→  ];
   232→
   233→  for (const workflow of workflows) {
   234→    const description = workflow.description || workflow.trigger;
   235→    lines.push(`- **${workflow.id}**: ${description}`);
   236→  }
   237→
   238→  lines.push("");
   239→  lines.push("Use `kspec workflow start @workflow-id` to start a workflow.");
   240→  lines.push("");
   241→
   242→  return lines.join("\n");
   243→}
   244→
   245→/**
   246→ * Generate the freshness comment.
   247→ * AC: @agent-instruction-gen ac-4 - freshness comment with kspec version and timestamp
   248→ */
   249→function generateFreshnessComment(timestamp: string): string {
   250→  return `<!-- Generated by kspec v${version} at ${timestamp} -->\n<!-- Do not edit manually - regenerate with: kspec agents generate -->\n\n`;
   251→}
   252→
   253→/**
   254→ * Generate the full kspec-agents.md content
   255→ * AC: @agent-templates ac-1 - template sections included in output in defined order
   256→ * AC: @agent-templates ac-2 - each template section appears in generated output
   257→ */
   258→async function generateAgentsContent(
   259→  skills: LoadedSkill[],
   260→  conventions: LoadedConvention[],
   261→  workflows: LoadedWorkflow[],
   262→  timestamp: string,
   263→  templateSections: string[],
   264→): Promise<string> {
   265→  const sections: string[] = [];
   266→
   267→  // AC: @agent-instruction-gen ac-4 - freshness comment
   268→  sections.push(generateFreshnessComment(timestamp));
   269→
   270→  // Header
   271→  sections.push("# kspec Agent Instructions\n");
   272→  sections.push(
   273→    "This file is auto-generated from kspec meta. Include it in your AGENTS.md or similar agent instruction file.\n\n",
   274→  );
   275→
   276→  // AC: @agent-instruction-gen ac-2 - Skills table
   277→  const skillsTable = generateSkillsTable(skills);
   278→  if (skillsTable) {
   279→    sections.push(skillsTable);
   280→  }
   281→
   282→  // AC: @agent-instruction-gen ac-3 - Conventions section
   283→  const conventionsSection = generateConventionsSection(conventions);
   284→  if (conventionsSection) {
   285→    sections.push(conventionsSection);
   286→  }
   287→
   288→  // Workflows summary
   289→  const workflowsSection = generateWorkflowsSection(workflows);
   290→  if (workflowsSection) {
   291→    sections.push(workflowsSection);
   292→  }
   293→
   294→  // AC: @agent-templates ac-1, ac-2 - Include template sections in order
   295→  if (templateSections.length > 0) {
   296→    sections.push("\n");
   297→    for (const section of templateSections) {
   298→      sections.push(section);
   299→      sections.push("\n\n");
   300→    }
   301→  }
   302→
   303→  return sections.join("");
   304→}
   305→
   306→/**
   307→ * Result of checking agent file status
   308→ */
   309→interface AgentStatusResult {
   310→  exists: boolean;
   311→  path: string;
   312→  status: "current" | "stale" | "missing";
   313→  metaHash?: string;
   314→  storedHash?: string;
   315→  generatedAt?: string;
   316→}
   317→
   318→/**
   319→ * Check the status of the generated agent file.
   320→ * AC: @agent-instruction-gen ac-5 - reports stale when meta has changed
   321→ */
   322→async function checkAgentStatus(
   323→  projectRoot: string,
   324→  metaHash: string,
   325→): Promise<AgentStatusResult> {
   326→  const filePath = path.join(projectRoot, GENERATED_FILE_NAME);
   327→  const hashPath = path.join(projectRoot, ".kspec", HASH_FILE_NAME);
   328→
   329→  // Check if file exists
   330→  try {
   331→    await fs.access(filePath);
   332→  } catch {
   333→    return {
   334→      exists: false,
   335→      path: filePath,
   336→      status: "missing",
   337→      metaHash,
   338→    };
   339→  }
   340→
   341→  // Check stored hash
   342→  let storedHash: string | undefined;
   343→  let generatedAt: string | undefined;
   344→
   345→  try {
   346→    const hashContent = await fs.readFile(hashPath, "utf-8");
   347→    const hashData = JSON.parse(hashContent);
   348→    storedHash = hashData.metaHash;
   349→    generatedAt = hashData.generatedAt;
   350→  } catch {
   351→    // No hash file, treat as stale
   352→    return {
   353→      exists: true,
   354→      path: filePath,
   355→      status: "stale",
   356→      metaHash,
   357→    };
   358→  }
   359→
   360→  // Compare hashes
   361→  const isCurrent = storedHash === metaHash;
   362→
   363→  return {
   364→    exists: true,
   365→    path: filePath,
   366→    status: isCurrent ? "current" : "stale",
   367→    metaHash,
   368→    storedHash,
   369→    generatedAt,
   370→  };
   371→}
   372→
   373→/**
   374→ * Register agent instruction generation commands
   375→ */
   376→export function registerAgentsCommands(program: Command): void {
   377→  const agents = program
   378→    .command("agents")
   379→    .description("Agent instruction generation commands");
   380→
   381→  // AC: @agent-instruction-gen ac-1 - kspec agents generate
   382→  // AC: @agent-templates ac-3 - error if template directory missing
   383→  // AC: @trait-dry-run ac-1 through ac-6 - dry-run support
   384→  agents
   385→    .command("generate")
   386→    .description("Generate kspec-agents.md from meta (skills, conventions, workflows)")
   387→    .option("--dry-run", "Show what would be generated without writing files")
   388→    .action(async (options) => {
   389→      try {
   390→        const ctx = await initContext();
   391→
   392→        if (!ctx.manifestPath) {
   393→          error(errors.project.noKspecProject);
   394→          process.exit(EXIT_CODES.ERROR);
   395→        }
   396→
   397→        // AC: @agent-templates ac-3 - error if templates missing
   398→        const packageRoot = getPackageRoot();
   399→        let templateSections: string[];
   400→        try {
   401→          templateSections = await loadTemplateSections(packageRoot);
   402→        } catch (err) {
   403→          const message =
   404→            err instanceof Error ? err.message : "Unknown error loading templates";
   405→          error(message, {
   406→            suggestion: `Verify that ${TEMPLATES_DIR}/ exists with markdown files.`,
   407→          });
   408→          process.exit(EXIT_CODES.ERROR);
   409→        }
   410→
   411→        const metaCtx = await loadMetaContext(ctx);
   412→        const dryRun = options.dryRun || false;
   413→        const timestamp = new Date().toISOString();
   414→
   415→        // Generate content - now async due to template loading
   416→        const content = await generateAgentsContent(
   417→          metaCtx.skills,
   418→          metaCtx.conventions,
   419→          metaCtx.workflows,
   420→          timestamp,
   421→          templateSections,
   422→        );
   423→
   424→        // Compute meta hash for freshness tracking
   425→        // Include template count to detect template changes
   426→        const metaHash = computeMetaHash(
   427→          metaCtx.skills,
   428→          metaCtx.conventions,
   429→          metaCtx.workflows,
   430→        );
   431→
   432→        const outputPath = path.join(ctx.rootDir, GENERATED_FILE_NAME);
   433→        const hashPath = path.join(ctx.rootDir, ".kspec", HASH_FILE_NAME);
   434→
   435→        // AC: @trait-dry-run ac-3 - clear indication this is a preview
   436→        if (dryRun) {
   437→          output(
   438→            {
   439→              dry_run: true,
   440→              path: outputPath,
   441→              skills: metaCtx.skills.length,
   442→              conventions: metaCtx.conventions.length,
   443→              workflows: metaCtx.workflows.length,
   444→              templates: templateSections.length,
   445→              content,
   446→            },
   447→            () => {
   448→              console.log(chalk.yellow("DRY RUN - No changes made"));
   449→              console.log();
   450→              console.log(chalk.gray(`Would write to: ${outputPath}`));
   451→              console.log();
   452→              console.log(chalk.gray("--- Generated content ---"));
   453→              console.log(content);
   454→              console.log(chalk.gray("--- End content ---"));
   455→              console.log();
   456→              console.log(
   457→                chalk.yellow("No changes were made. Run without --dry-run to apply."),
   458→              );
   459→            },
   460→          );
   461→          return;
   462→        }
   463→
   464→        // AC: @trait-dry-run ac-2 - no files modified in dry run mode
   465→        // Write the generated file
   466→        await fs.writeFile(outputPath, content, "utf-8");
   467→
   468→        // Write the hash file for freshness tracking
   469→        await fs.mkdir(path.dirname(hashPath), { recursive: true });
   470→        await fs.writeFile(
   471→          hashPath,
   472→          JSON.stringify(
   473→            {
   474→              metaHash,
   475→              generatedAt: timestamp,
   476→              version,
   477→            },
   478→            null,
   479→            2,
   480→          ),
   481→          "utf-8",
   482→        );
   483→
   484→        output(
   485→          {
   486→            path: outputPath,
   487→            skills: metaCtx.skills.length,
   488→            conventions: metaCtx.conventions.length,
   489→            workflows: metaCtx.workflows.length,
   490→            templates: templateSections.length,
   491→            generatedAt: timestamp,
   492→          },
   493→          () => {
   494→            success(`Generated ${GENERATED_FILE_NAME}`, {
   495→              skills: metaCtx.skills.length,
   496→              conventions: metaCtx.conventions.length,
   497→              workflows: metaCtx.workflows.length,
   498→              templates: templateSections.length,
   499→            });
   500→            console.log(chalk.gray(`  Path: ${outputPath}`));
   501→          },
   502→        );
   503→      } catch (err) {
   504→        error("Failed to generate agent instructions", err);
   505→        process.exit(EXIT_CODES.ERROR);
   506→      }
   507→    });
   508→
   509→  // AC: @agent-instruction-gen ac-5 - kspec agents status
   510→  agents
   511→    .command("status")
   512→    .description("Check if kspec-agents.md is up to date with meta")
   513→    .action(async () => {
   514→      try {
   515→        const ctx = await initContext();
   516→
   517→        if (!ctx.manifestPath) {
   518→          error(errors.project.noKspecProject);
   519→          process.exit(EXIT_CODES.ERROR);
   520→        }
   521→
   522→        const metaCtx = await loadMetaContext(ctx);
   523→
   524→        // Compute current meta hash
   525→        const metaHash = computeMetaHash(
   526→          metaCtx.skills,
   527→          metaCtx.conventions,
   528→          metaCtx.workflows,
   529→        );
   530→
   531→        const status = await checkAgentStatus(ctx.rootDir, metaHash);
   532→
   533→        output(status, () => {
   534→          switch (status.status) {
   535→            case "missing":
   536→              console.log(chalk.yellow(`${GENERATED_FILE_NAME} does not exist`));
   537→              console.log();
   538→              console.log(
   539→                chalk.gray("Run 'kspec agents generate' to create it."),
   540→              );
   541→              break;
   542→
   543→            case "stale":
   544→              console.log(
   545→                chalk.yellow(`${GENERATED_FILE_NAME} is stale`),
   546→              );
   547→              console.log();
   548→              console.log(
   549→                chalk.gray(
   550→                  "Meta has changed since the file was generated.",
   551→                ),
   552→              );
   553→              console.log(
   554→                chalk.gray("Run 'kspec agents generate' to regenerate."),
   555→              );
   556→              break;
   557→
   558→            case "current":
   559→              console.log(chalk.green(`${GENERATED_FILE_NAME} is up to date`));
   560→              if (status.generatedAt) {
   561→                console.log(chalk.gray(`  Generated: ${status.generatedAt}`));
   562→              }
   563→              break;
   564→          }
   565→        });
   566→      } catch (err) {
   567→        error("Failed to check agent status", err);
   568→        process.exit(EXIT_CODES.ERROR);
   569→      }
   570→    });
   571→}
   572→

