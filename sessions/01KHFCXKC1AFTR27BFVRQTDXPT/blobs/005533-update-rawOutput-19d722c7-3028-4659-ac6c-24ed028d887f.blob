     1→/**
     2→ * Tests for Skill CLI Commands
     3→ * AC: @skill-cli ac-1 through ac-8
     4→ */
     5→
     6→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     7→import * as fs from 'node:fs/promises';
     8→import * as path from 'node:path';
     9→import { parse as yamlParse, stringify as yamlStringify } from 'yaml';
    10→import {
    11→  kspecOutput as kspec,
    12→  kspecJson,
    13→  kspec as kspecFull,
    14→  setupTempFixtures,
    15→  cleanupTempDir,
    16→  createTempDir,
    17→  initGitRepo,
    18→} from './helpers/cli';
    19→
    20→describe('Skill CLI - skill list', () => {
    21→  let tempDir: string;
    22→
    23→  beforeEach(async () => {
    24→    tempDir = await setupTempFixtures();
    25→    await initGitRepo(tempDir);
    26→
    27→    // Create some skills via kspec add
    28→    kspec(
    29→      'skill add --id task-work --name "Task Work" --description "Work on tasks" --origin core --version 0.1.0',
    30→      tempDir
    31→    );
    32→    kspec(
    33→      'skill add --id pr-review --name "PR Review" --origin project --tag workflow --tag review',
    34→      tempDir
    35→    );
    36→  });
    37→
    38→  afterEach(async () => {
    39→    await cleanupTempDir(tempDir);
    40→  });
    41→
    42→  // AC: @skill-cli ac-1
    43→  it('should display table with ID, Name, Origin, Version, and Platforms columns', () => {
    44→    const output = kspec('skill list', tempDir);
    45→
    46→    // Check headers are present
    47→    expect(output).toContain('ID');
    48→    expect(output).toContain('Name');
    49→    expect(output).toContain('Origin');
    50→    expect(output).toContain('Version');
    51→    expect(output).toContain('Platforms');
    52→
    53→    // Check data
    54→    expect(output).toContain('task-work');
    55→    expect(output).toContain('Task Work');
    56→    expect(output).toContain('core');
    57→    expect(output).toContain('pr-review');
    58→    expect(output).toContain('PR Review');
    59→    expect(output).toContain('project');
    60→
    61→    // Check skill count
    62→    expect(output).toContain('2 skill(s)');
    63→  });
    64→
    65→  // AC: @skill-cli ac-2
    66→  it('should return JSON array with full skill metadata when --json flag provided', () => {
    67→    const result = kspecJson<Array<{
    68→      _ulid: string;
    69→      id: string;
    70→      name: string;
    71→      description?: string;
    72→      origin: string;
    73→      version?: string;
    74→      platforms: string[];
    75→      depends_on: string[];
    76→      tags: string[];
    77→    }>>('skill list', tempDir);
    78→
    79→    expect(Array.isArray(result)).toBe(true);
    80→    expect(result.length).toBe(2);
    81→
    82→    const taskWork = result.find(s => s.id === 'task-work');
    83→    expect(taskWork).toBeDefined();
    84→    expect(taskWork?._ulid).toMatch(/^[0-9A-Z]{26}$/);
    85→    expect(taskWork?.name).toBe('Task Work');
    86→    expect(taskWork?.description).toBe('Work on tasks');
    87→    expect(taskWork?.origin).toBe('core');
    88→    expect(taskWork?.version).toBe('0.1.0');
    89→    expect(taskWork?.platforms).toContain('claude-code');
    90→    expect(taskWork?.depends_on).toEqual([]);
    91→
    92→    const prReview = result.find(s => s.id === 'pr-review');
    93→    expect(prReview).toBeDefined();
    94→    expect(prReview?.origin).toBe('project');
    95→    expect(prReview?.tags).toContain('workflow');
    96→    expect(prReview?.tags).toContain('review');
    97→  });
    98→
    99→  it('should filter by origin', () => {
   100→    const result = kspecJson<Array<{ id: string; origin: string }>>('skill list --origin core', tempDir);
   101→
   102→    expect(result.length).toBe(1);
   103→    expect(result[0].id).toBe('task-work');
   104→    expect(result[0].origin).toBe('core');
   105→  });
   106→
   107→  it('should filter by tag', () => {
   108→    const result = kspecJson<Array<{ id: string; tags: string[] }>>('skill list --tag workflow', tempDir);
   109→
   110→    expect(result.length).toBe(1);
   111→    expect(result[0].id).toBe('pr-review');
   112→    expect(result[0].tags).toContain('workflow');
   113→  });
   114→
   115→  it('should show message when no skills defined', async () => {
   116→    // Create fresh project with no skills
   117→    const emptyDir = await createTempDir();
   118→    await initGitRepo(emptyDir);
   119→    await fs.writeFile(path.join(emptyDir, 'kynetic.yaml'), yamlStringify({ kynetic: '1.0' }));
   120→    await fs.writeFile(
   121→      path.join(emptyDir, 'kynetic.meta.yaml'),
   122→      yamlStringify({ kynetic_meta: '1.0', skills: [] })
   123→    );
   124→
   125→    try {
   126→      const output = kspec('skill list', emptyDir);
   127→      expect(output).toContain('No skills defined');
   128→    } finally {
   129→      await cleanupTempDir(emptyDir);
   130→    }
   131→  });
   132→});
   133→
   134→describe('Skill CLI - skill add', () => {
   135→  let tempDir: string;
   136→
   137→  beforeEach(async () => {
   138→    tempDir = await setupTempFixtures();
   139→    await initGitRepo(tempDir);
   140→  });
   141→
   142→  afterEach(async () => {
   143→    await cleanupTempDir(tempDir);
   144→  });
   145→
   146→  // AC: @skill-cli ac-3
   147→  it('should create meta entry with correct origin', () => {
   148→    const result = kspecJson<{
   149→      skill: {
   150→        _ulid: string;
   151→        id: string;
   152→        name: string;
   153→        origin: string;
   154→      };
   155→    }>('skill add --id my-skill --name "My Skill" --description "A test skill"', tempDir);
   156→
   157→    expect(result.skill).toBeDefined();
   158→    expect(result.skill.id).toBe('my-skill');
   159→    expect(result.skill.name).toBe('My Skill');
   160→    expect(result.skill.origin).toBe('project'); // Default origin
   161→    expect(result.skill._ulid).toMatch(/^[0-9A-Z]{26}$/);
   162→  });
   163→
   164→  it('should create meta entry with custom origin', () => {
   165→    const result = kspecJson<{
   166→      skill: { id: string; origin: string };
   167→    }>('skill add --id local-skill --name "Local Skill" --origin local', tempDir);
   168→
   169→    expect(result.skill.origin).toBe('local');
   170→  });
   171→
   172→  // AC: @skill-cli ac-4
   173→  it('should create .kspec/skills/<id>/SKILL.md file', async () => {
   174→    kspec('skill add --id my-skill --name "My Skill" --description "Test skill"', tempDir);
   175→
   176→    const skillMdPath = path.join(tempDir, 'skills', 'my-skill', 'SKILL.md');
   177→    const exists = await fs.access(skillMdPath).then(() => true).catch(() => false);
   178→    expect(exists).toBe(true);
   179→
   180→    const content = await fs.readFile(skillMdPath, 'utf-8');
   181→    expect(content).toContain('# My Skill');
   182→    expect(content).toContain('Test skill');
   183→  });
   184→
   185→  it('should add skill to meta manifest', async () => {
   186→    kspec('skill add --id my-skill --name "My Skill"', tempDir);
   187→
   188→    const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
   189→    const metaContent = await fs.readFile(metaPath, 'utf-8');
   190→    const meta = yamlParse(metaContent);
   191→
   192→    expect(meta.skills).toBeDefined();
   193→    const skill = meta.skills.find((s: { id: string }) => s.id === 'my-skill');
   194→    expect(skill).toBeDefined();
   195→    expect(skill.name).toBe('My Skill');
   196→  });
   197→
   198→  it('should set platforms to default value when not specified', () => {
   199→    const result = kspecJson<{
   200→      skill: { platforms: string[] };
   201→    }>('skill add --id my-skill --name "My Skill"', tempDir);
   202→
   203→    expect(result.skill.platforms).toEqual(['claude-code']);
   204→  });
   205→
   206→  it('should accept custom platforms', () => {
   207→    const result = kspecJson<{
   208→      skill: { platforms: string[] };
   209→    }>('skill add --id my-skill --name "My Skill" --platform cursor --platform windsurf', tempDir);
   210→
   211→    expect(result.skill.platforms).toContain('cursor');
   212→    expect(result.skill.platforms).toContain('windsurf');
   213→  });
   214→
   215→  it('should accept version option', () => {
   216→    const result = kspecJson<{
   217→      skill: { version: string };
   218→    }>('skill add --id my-skill --name "My Skill" --version 1.2.3', tempDir);
   219→
   220→    expect(result.skill.version).toBe('1.2.3');
   221→  });
   222→
   223→  it('should accept tags option', () => {
   224→    const result = kspecJson<{
   225→      skill: { tags: string[] };
   226→    }>('skill add --id my-skill --name "My Skill" --tag workflow --tag automation', tempDir);
   227→
   228→    expect(result.skill.tags).toContain('workflow');
   229→    expect(result.skill.tags).toContain('automation');
   230→  });
   231→
   232→  it('should accept depends-on option', () => {
   233→    // First create a skill to depend on
   234→    kspec('skill add --id base-skill --name "Base Skill"', tempDir);
   235→
   236→    const result = kspecJson<{
   237→      skill: { depends_on: string[] };
   238→    }>('skill add --id my-skill --name "My Skill" --depends-on @base-skill', tempDir);
   239→
   240→    expect(result.skill.depends_on).toContain('@base-skill');
   241→  });
   242→
   243→  it('should reject duplicate skill ID', () => {
   244→    kspec('skill add --id my-skill --name "My Skill"', tempDir);
   245→
   246→    const result = kspecFull('skill add --id my-skill --name "Another Skill"', tempDir, { expectFail: true });
   247→    expect(result.exitCode).not.toBe(0);
   248→    expect(result.stderr).toContain("already exists");
   249→  });
   250→
   251→  it('should reject invalid origin', () => {
   252→    const result = kspecFull('skill add --id my-skill --name "My Skill" --origin invalid', tempDir, { expectFail: true });
   253→    expect(result.exitCode).not.toBe(0);
   254→    expect(result.stderr).toContain("Invalid origin");
   255→  });
   256→
   257→  it('should validate kebab-case ID', () => {
   258→    const result = kspecFull('skill add --id MySkill --name "My Skill"', tempDir, { expectFail: true });
   259→    expect(result.exitCode).not.toBe(0);
   260→    expect(result.stderr).toContain("kebab-case");
   261→  });
   262→});
   263→
   264→describe('Skill CLI - skill get', () => {
   265→  let tempDir: string;
   266→
   267→  beforeEach(async () => {
   268→    tempDir = await setupTempFixtures();
   269→    await initGitRepo(tempDir);
   270→
   271→    // Create a skill with custom content
   272→    kspec(
   273→      'skill add --id task-work --name "Task Work" --description "Work on tasks" --origin core --version 0.1.0 --tag workflow',
   274→      tempDir
   275→    );
   276→
   277→    // Update SKILL.md with custom content
   278→    const skillMdPath = path.join(tempDir, 'skills', 'task-work', 'SKILL.md');
   279→    await fs.writeFile(skillMdPath, `# Task Work
   280→
   281→Use this skill when working on kspec tasks.
   282→
   283→## Usage
   284→
   285→\`\`\`bash
   286→kspec task start @ref
   287→\`\`\`
   288→`);
   289→  });
   290→
   291→  afterEach(async () => {
   292→    await cleanupTempDir(tempDir);
   293→  });
   294→
   295→  // AC: @skill-cli ac-5
   296→  it('should display metadata including id, name, origin, and platforms', () => {
   297→    const output = kspec('skill get @task-work', tempDir);
   298→
   299→    expect(output).toContain('Task Work');
   300→    expect(output).toContain('ID:');
   301→    expect(output).toContain('task-work');
   302→    expect(output).toContain('Origin:');
   303→    expect(output).toContain('core');
   304→    expect(output).toContain('Platforms:');
   305→    expect(output).toContain('claude-code');
   306→    expect(output).toContain('Version:');
   307→    expect(output).toContain('0.1.0');
   308→  });
   309→
   310→  // AC: @skill-cli ac-6
   311→  it('should display SKILL.md content', () => {
   312→    const output = kspec('skill get @task-work', tempDir);
   313→
   314→    expect(output).toContain('SKILL.md Content');
   315→    expect(output).toContain('Use this skill when working on kspec tasks');
   316→    expect(output).toContain('kspec task start @ref');
   317→  });
   318→
   319→  it('should include all metadata in JSON output', () => {
   320→    const result = kspecJson<{
   321→      _ulid: string;
   322→      id: string;
   323→      name: string;
   324→      description: string;
   325→      origin: string;
   326→      version: string;
   327→      platforms: string[];
   328→      depends_on: string[];
   329→      tags: string[];
   330→      content: string;
   331→      docs: Array<{ name: string; path: string }>;
   332→    }>('skill get @task-work', tempDir);
   333→
   334→    expect(result.id).toBe('task-work');
   335→    expect(result.name).toBe('Task Work');
   336→    expect(result.description).toBe('Work on tasks');
   337→    expect(result.origin).toBe('core');
   338→    expect(result.version).toBe('0.1.0');
   339→    expect(result.platforms).toContain('claude-code');
   340→    expect(result.tags).toContain('workflow');
   341→    expect(result.content).toContain('Use this skill when working on kspec tasks');
   342→    expect(Array.isArray(result.docs)).toBe(true);
   343→  });
   344→
   345→  it('should find skill by ULID prefix', async () => {
   346→    // Get the skill's ULID first
   347→    const list = kspecJson<Array<{ _ulid: string; id: string }>>('skill list', tempDir);
   348→    const skill = list.find(s => s.id === 'task-work');
   349→    const ulidPrefix = skill?._ulid.slice(0, 8);
   350→
   351→    const output = kspec(`skill get @${ulidPrefix}`, tempDir);
   352→    expect(output).toContain('task-work');
   353→    expect(output).toContain('Task Work');
   354→  });
   355→
   356→  it('should return error when skill not found', () => {
   357→    const result = kspecFull('skill get @nonexistent', tempDir, { expectFail: true });
   358→    expect(result.exitCode).not.toBe(0);
   359→    expect(result.stderr).toContain('not found');
   360→  });
   361→
   362→  it('should show (No SKILL.md content found) when file missing', async () => {
   363→    // Delete the SKILL.md file
   364→    const skillMdPath = path.join(tempDir, 'skills', 'task-work', 'SKILL.md');
   365→    await fs.unlink(skillMdPath);
   366→
   367→    const output = kspec('skill get @task-work', tempDir);
   368→    expect(output).toContain('No SKILL.md content found');
   369→  });
   370→});
   371→
   372→describe('Skill CLI - skill delete', () => {
   373→  let tempDir: string;
   374→
   375→  beforeEach(async () => {
   376→    tempDir = await setupTempFixtures();
   377→    await initGitRepo(tempDir);
   378→
   379→    // Create skills
   380→    kspec('skill add --id my-skill --name "My Skill"', tempDir);
   381→    kspec('skill add --id dependent-skill --name "Dependent Skill" --depends-on @my-skill', tempDir);
   382→  });
   383→
   384→  afterEach(async () => {
   385→    await cleanupTempDir(tempDir);
   386→  });
   387→
   388→  // AC: @skill-cli ac-7
   389→  it('should remove meta entry from manifest when --confirm provided', async () => {
   390→    // First create a skill that has no dependencies
   391→    kspec('skill add --id standalone-skill --name "Standalone Skill"', tempDir);
   392→
   393→    // Verify it exists
   394→    let list = kspecJson<Array<{ id: string }>>('skill list', tempDir);
   395→    expect(list.some(s => s.id === 'standalone-skill')).toBe(true);
   396→
   397→    // Delete it
   398→    kspec('skill delete @standalone-skill --confirm', tempDir);
   399→
   400→    // Verify it's gone
   401→    list = kspecJson<Array<{ id: string }>>('skill list', tempDir);
   402→    expect(list.some(s => s.id === 'standalone-skill')).toBe(false);
   403→  });
   404→
   405→  // AC: @skill-cli ac-8
   406→  it('should delete .kspec/skills/<id>/ directory', async () => {
   407→    // Create a standalone skill
   408→    kspec('skill add --id standalone-skill --name "Standalone Skill"', tempDir);
   409→
   410→    // Verify directory exists
   411→    const skillDir = path.join(tempDir, 'skills', 'standalone-skill');
   412→    let exists = await fs.access(skillDir).then(() => true).catch(() => false);
   413→    expect(exists).toBe(true);
   414→
   415→    // Delete the skill
   416→    kspec('skill delete @standalone-skill --confirm', tempDir);
   417→
   418→    // Verify directory is gone
   419→    exists = await fs.access(skillDir).then(() => true).catch(() => false);
   420→    expect(exists).toBe(false);
   421→  });
   422→
   423→  it('should require --confirm flag', () => {
   424→    const result = kspecFull('skill delete @my-skill', tempDir, { expectFail: true });
   425→    expect(result.exitCode).not.toBe(0);
   426→    expect(result.stderr).toContain('--confirm');
   427→  });
   428→
   429→  it('should prevent deletion when other skills depend on it', () => {
   430→    const result = kspecFull('skill delete @my-skill --confirm', tempDir, { expectFail: true });
   431→    expect(result.exitCode).not.toBe(0);
   432→    expect(result.stderr).toContain('referenced by');
   433→    expect(result.stderr).toContain('@dependent-skill');
   434→  });
   435→
   436→  it('should return error when skill not found', () => {
   437→    const result = kspecFull('skill delete @nonexistent --confirm', tempDir, { expectFail: true });
   438→    expect(result.exitCode).not.toBe(0);
   439→    expect(result.stderr).toContain('not found');
   440→  });
   441→
   442→  it('should find skill by ULID prefix', async () => {
   443→    // Create a standalone skill
   444→    const createResult = kspecJson<{ skill: { _ulid: string; id: string } }>(
   445→      'skill add --id temp-skill --name "Temp Skill"',
   446→      tempDir
   447→    );
   448→    const ulidPrefix = createResult.skill._ulid.slice(0, 8);
   449→
   450→    // Delete by ULID prefix
   451→    const output = kspec(`skill delete @${ulidPrefix} --confirm`, tempDir);
   452→    expect(output).toContain('Deleted');
   453→
   454→    // Verify it's gone
   455→    const list = kspecJson<Array<{ id: string }>>('skill list', tempDir);
   456→    expect(list.some(s => s.id === 'temp-skill')).toBe(false);
   457→  });
   458→});
   459→

