```
     1→/**
     2→ * Skill CLI commands for managing skills.
     3→ *
     4→ * AC: @skill-cli ac-1 - kspec skill list outputs table with ID, Name, Origin, Version, Platforms
     5→ * AC: @skill-cli ac-2 - kspec skill list --json outputs JSON array with full skill metadata
     6→ * AC: @skill-cli ac-3 - kspec skill add creates meta entry with origin custom
     7→ * AC: @skill-cli ac-4 - kspec skill add creates .kspec/skills/<id>/SKILL.md
     8→ * AC: @skill-cli ac-5 - kspec skill get outputs metadata including id, name, origin, platforms
     9→ * AC: @skill-cli ac-6 - kspec skill get outputs SKILL.md content
    10→ * AC: @skill-cli ac-7 - kspec skill delete --confirm removes meta entry
    11→ * AC: @skill-cli ac-8 - kspec skill delete removes .kspec/skills/<id>/ directory
    12→ */
    13→
    14→import * as fs from "node:fs/promises";
    15→import * as path from "node:path";
    16→import chalk from "chalk";
    17→import Table from "cli-table3";
    18→import type { Command } from "commander";
    19→import { ulid } from "ulid";
    20→import { markMutating } from "../command-annotations.js";
    21→import {
    22→  deleteMetaItem,
    23→  findMetaItemByRef,
    24→  getSkillContentPath,
    25→  initContext,
    26→  loadMetaContext,
    27→  loadSkillContent,
    28→  loadSkillDocs,
    29→  type LoadedSkill,
    30→  saveMetaItem,
    31→  type Skill,
    32→} from "../../parser/index.js";
    33→import { commitIfShadow } from "../../parser/shadow.js";
    34→import { SkillSchema, type SkillOrigin } from "../../schema/index.js";
    35→import { errors } from "../../strings/errors.js";
    36→import { EXIT_CODES } from "../exit-codes.js";
    37→import { error, output, success } from "../output.js";
    38→import { parseTagsArray } from "../parse-utils.js";
    39→
    40→/**
    41→ * Format skills as a table
    42→ * AC: @skill-cli ac-1 - table displays ID, Name, Origin, Version, Platforms
    43→ */
    44→function formatSkillsTable(skills: LoadedSkill[]): void {
    45→  if (skills.length === 0) {
    46→    console.log(chalk.yellow("No skills defined"));
    47→    return;
    48→  }
    49→
    50→  const table = new Table({
    51→    head: [
    52→      chalk.bold("ID"),
    53→      chalk.bold("Name"),
    54→      chalk.bold("Origin"),
    55→      chalk.bold("Version"),
    56→      chalk.bold("Platforms"),
    57→    ],
    58→    style: {
    59→      head: [],
    60→      border: [],
    61→    },
    62→  });
    63→
    64→  for (const skill of skills) {
    65→    table.push([
    66→      skill.id,
    67→      skill.name,
    68→      skill.origin,
    69→      skill.version || "-",
    70→      skill.platforms.join(", "),
    71→    ]);
    72→  }
    73→
    74→  console.log(table.toString());
    75→  console.log(chalk.gray(`\n${skills.length} skill(s)`));
    76→}
    77→
    78→/**
    79→ * Format skill details
    80→ * AC: @skill-cli ac-5 - outputs metadata including id, name, origin, platforms
    81→ */
    82→function formatSkillDetails(skill: LoadedSkill, content: string | null): void {
    83→  console.log(chalk.bold(skill.name));
    84→  console.log(chalk.gray("─".repeat(40)));
    85→  console.log(`ID:          ${skill.id}`);
    86→  console.log(`ULID:        ${skill._ulid}`);
    87→  console.log(`Origin:      ${skill.origin}`);
    88→  console.log(`Platforms:   ${skill.platforms.join(", ")}`);
    89→
    90→  if (skill.version) {
    91→    console.log(`Version:     ${skill.version}`);
    92→  }
    93→
    94→  if (skill.description) {
    95→    console.log(`\n─── Description ───`);
    96→    console.log(skill.description);
    97→  }
    98→
    99→  if (skill.depends_on && skill.depends_on.length > 0) {
   100→    console.log(`\n─── Dependencies ───`);
   101→    for (const dep of skill.depends_on) {
   102→      console.log(`  • ${dep}`);
   103→    }
   104→  }
   105→
   106→  if (skill.tags && skill.tags.length > 0) {
   107→    console.log(`\nTags:        ${skill.tags.join(", ")}`);
   108→  }
   109→
   110→  // AC: @skill-cli ac-6 - display SKILL.md content
   111→  if (content) {
   112→    console.log(`\n─── SKILL.md Content ───`);
   113→    console.log(content);
   114→  } else {
   115→    console.log(chalk.gray("\n(No SKILL.md content found)"));
   116→  }
   117→}
   118→
   119→/**
   120→ * Register skill commands
   121→ */
   122→export function registerSkillCommands(program: Command): void {
   123→  const skill = program
   124→    .command("skill")
   125→    .description("Skill management commands");
   126→
   127→  // AC: @skill-cli ac-1, ac-2 - kspec skill list
   128→  skill
   129→    .command("list")
   130→    .description("List all skills")
   131→    .option("--origin <origin>", "Filter by origin (core, project, local)")
   132→    .option("--tag <tag>", "Filter by tag")
   133→    .action(async (options) => {
   134→      try {
   135→        const ctx = await initContext();
   136→
   137→        if (!ctx.manifestPath) {
   138→          error(errors.project.noKspecProject);
   139→          process.exit(EXIT_CODES.ERROR);
   140→        }
   141→
   142→        const metaCtx = await loadMetaContext(ctx);
   143→        let skills = metaCtx.skills || [];
   144→
   145→        // Apply filters
   146→        if (options.origin) {
   147→          skills = skills.filter((s) => s.origin === options.origin);
   148→        }
   149→
   150→        if (options.tag) {
   151→          skills = skills.filter((s) => s.tags?.includes(options.tag));
   152→        }
   153→
   154→        // AC: @skill-cli ac-2 - JSON output includes full skill metadata
   155→        output(
   156→          skills.map((s) => ({
   157→            _ulid: s._ulid,
   158→            id: s.id,
   159→            name: s.name,
   160→            description: s.description,
   161→            origin: s.origin,
   162→            version: s.version,
   163→            platforms: s.platforms,
   164→            depends_on: s.depends_on,
   165→            tags: s.tags,
   166→          })),
   167→          // AC: @skill-cli ac-1 - Table output
   168→          () => formatSkillsTable(skills),
   169→        );
   170→      } catch (err) {
   171→        error("Failed to list skills", err);
   172→        process.exit(EXIT_CODES.ERROR);
   173→      }
   174→    });
   175→
   176→  // AC: @skill-cli ac-3, ac-4 - kspec skill add
   177→  markMutating(skill.command("add"))
   178→    .description("Create a new skill")
   179→    .requiredOption("--id <id>", "Skill ID (kebab-case)")
   180→    .requiredOption("--name <name>", "Skill name")
   181→    .option("--description <desc>", "Skill description")
   182→    .option(
   183→      "--origin <origin>",
   184→      "Skill origin (core, project, local)",
   185→      "project",
   186→    )
   187→    .option("--skill-version <version>", "Skill version")
   188→    .option("--platform <platform...>", "Target platforms")
   189→    .option("--tag <tag...>", "Tags for the skill")
   190→    .option("--depends-on <ref...>", "Skill dependencies")
   191→    .action(async (options) => {
   192→      try {
   193→        const ctx = await initContext();
   194→
   195→        if (!ctx.manifestPath) {
   196→          error(errors.project.noKspecProject);
   197→          process.exit(EXIT_CODES.ERROR);
   198→        }
   199→
   200→        // Validate origin
   201→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   202→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   203→          error(
   204→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   205→          );
   206→          process.exit(EXIT_CODES.ERROR);
   207→        }
   208→
   209→        // Check if skill with this ID already exists
   210→        const metaCtx = await loadMetaContext(ctx);
   211→        const existingSkill = metaCtx.skills.find((s) => s.id === options.id);
   212→        if (existingSkill) {
   213→          error(`Skill with ID '${options.id}' already exists`);
   214→          process.exit(EXIT_CODES.CONFLICT);
   215→        }
   216→
   217→        // Build skill object
   218→        const skillData: Skill = {
   219→          _ulid: ulid(),
   220→          id: options.id,
   221→          name: options.name,
   222→          description: options.description,
   223→          origin: options.origin as SkillOrigin,
   224→          version: options.skillVersion,
   225→          platforms:
   226→            options.platform && options.platform.length > 0
   227→              ? options.platform
   228→              : ["claude-code"],
   229→          depends_on:
   230→            options.dependsOn && options.dependsOn.length > 0
   231→              ? options.dependsOn
   232→              : [],
   233→          tags:
   234→            options.tag && options.tag.length > 0
   235→              ? parseTagsArray(options.tag)
   236→              : [],
   237→        };
   238→
   239→        // Validate with schema
   240→        const parsed = SkillSchema.safeParse(skillData);
   241→        if (!parsed.success) {
   242→          const issues = parsed.error.issues
   243→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   244→            .join("; ");
   245→          error(`Invalid skill data: ${issues}`);
   246→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   247→        }
   248→
   249→        const skill: LoadedSkill = { ...parsed.data };
   250→
   251→        // AC: @skill-cli ac-3 - save meta entry (also creates directory per ac-4)
   252→        await saveMetaItem(ctx, skill, "skill");
   253→
   254→        // AC: @skill-cli ac-4 - create SKILL.md with placeholder content
   255→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   256→        const initialContent = `# ${skill.name}\n\n${skill.description || "Add skill content here."}\n`;
   257→        await fs.writeFile(skillMdPath, initialContent, "utf-8");
   258→
   259→        // Commit changes
   260→        await commitIfShadow(ctx.shadow, "skill-add", skill.id, skill.name);
   261→
   262→        output(skill, () =>
   263→          success(`Created skill: ${skill.id}`, { skill }),
   264→        );
   265→      } catch (err) {
   266→        error("Failed to create skill", err);
   267→        process.exit(EXIT_CODES.ERROR);
   268→      }
   269→    });
   270→
   271→  // AC: @skill-cli ac-5, ac-6 - kspec skill get
   272→  skill
   273→    .command("get <ref>")
   274→    .description("Show skill details")
   275→    .action(async (ref: string) => {
   276→      try {
   277→        const ctx = await initContext();
   278→
   279→        if (!ctx.manifestPath) {
   280→          error(errors.project.noKspecProject);
   281→          process.exit(EXIT_CODES.ERROR);
   282→        }
   283→
   284→        const metaCtx = await loadMetaContext(ctx);
   285→        const item = findMetaItemByRef(metaCtx, ref);
   286→
   287→        if (!item) {
   288→          error(`Skill not found: ${ref}`);
   289→          console.log(chalk.gray("Try: kspec skill list"));
   290→          process.exit(EXIT_CODES.NOT_FOUND);
   291→        }
   292→
   293→        // Check it's a skill
   294→        if (!("origin" in item)) {
   295→          error(`Item ${ref} is not a skill`);
   296→          process.exit(EXIT_CODES.ERROR);
   297→        }
   298→
   299→        const skill = item as LoadedSkill;
   300→
   301→        // AC: @skill-cli ac-6 - load SKILL.md content
   302→        const content = await loadSkillContent(ctx, skill);
   303→        const docs = await loadSkillDocs(ctx, skill);
   304→
   305→        // AC: @skill-cli ac-5, ac-6 - output metadata and content
   306→        output(
   307→          {
   308→            _ulid: skill._ulid,
   309→            id: skill.id,
   310→            name: skill.name,
   311→            description: skill.description,
   312→            origin: skill.origin,
   313→            version: skill.version,
   314→            platforms: skill.platforms,
   315→            depends_on: skill.depends_on,
   316→            tags: skill.tags,
   317→            content,
   318→            docs: docs.map((d) => ({ name: d.name, path: d.path })),
   319→          },
   320→          () => formatSkillDetails(skill, content),
   321→        );
   322→      } catch (err) {
   323→        error("Failed to get skill", err);
   324→        process.exit(EXIT_CODES.ERROR);
   325→      }
   326→    });
   327→
   328→  // AC: @skill-cli ac-7, ac-8 - kspec skill delete
   329→  markMutating(skill.command("delete <ref>"))
   330→    .description("Delete a skill")
   331→    .option("--confirm", "Skip confirmation prompt")
   332→    .action(async (ref: string, options) => {
   333→      try {
   334→        const ctx = await initContext();
   335→
   336→        if (!ctx.manifestPath) {
   337→          error(errors.project.noKspecProject);
   338→          process.exit(EXIT_CODES.ERROR);
   339→        }
   340→
   341→        const metaCtx = await loadMetaContext(ctx);
   342→        const item = findMetaItemByRef(metaCtx, ref);
   343→
   344→        if (!item) {
   345→          error(`Skill not found: ${ref}`);
   346→          console.log(chalk.gray("Try: kspec skill list"));
   347→          process.exit(EXIT_CODES.NOT_FOUND);
   348→        }
   349→
   350→        // Check it's a skill
   351→        if (!("origin" in item)) {
   352→          error(`Item ${ref} is not a skill`);
   353→          process.exit(EXIT_CODES.ERROR);
   354→        }
   355→
   356→        const skill = item as LoadedSkill;
   357→
   358→        // Check for confirmation
   359→        if (!options.confirm) {
   360→          error(`Confirm deletion of skill '${skill.id}' with --confirm flag`);
   361→          process.exit(EXIT_CODES.ERROR);
   362→        }
   363→
   364→        // Check for dependencies from other skills
   365→        const dependentSkills = metaCtx.skills.filter(
   366→          (s) =>
   367→            s._ulid !== skill._ulid &&
   368→            s.depends_on?.some(
   369→              (dep) =>
   370→                dep === `@${skill.id}` ||
   371→                dep === skill.id ||
   372→                dep.startsWith(`@${skill._ulid.substring(0, 8)}`),
   373→            ),
   374→        );
   375→
   376→        if (dependentSkills.length > 0) {
   377→          const depRefs = dependentSkills.map((s) => `@${s.id}`).join(", ");
   378→          error(
   379→            `Cannot delete skill '${skill.id}': referenced by ${dependentSkills.length} skill(s): ${depRefs}`,
   380→          );
   381→          process.exit(EXIT_CODES.ERROR);
   382→        }
   383→
   384→        // AC: @skill-cli ac-7, ac-8 - delete meta entry and directory
   385→        const deleted = await deleteMetaItem(ctx, skill._ulid, "skill");
   386→
   387→        if (!deleted) {
   388→          error(`Failed to delete skill: ${skill.id}`);
   389→          process.exit(EXIT_CODES.ERROR);
   390→        }
   391→
   392→        // Commit changes
   393→        await commitIfShadow(ctx.shadow, "skill-delete", skill.id);
   394→
   395→        success(`Deleted skill: ${skill.id}`);
   396→      } catch (err) {
   397→        error("Failed to delete skill", err);
   398→        process.exit(EXIT_CODES.ERROR);
   399→      }
   400→    });
   401→}
   402→

