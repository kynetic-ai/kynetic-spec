```
     1→import chalk from "chalk";
     2→import type { Command } from "commander";
     3→import { markMutating } from "../command-annotations.js";
     4→import {
     5→  buildIndexes,
     6→  checkSlugUniqueness,
     7→  createSpecItem,
     8→  initContext,
     9→  type LoadedSpecItem,
    10→  ReferenceIndex,
    11→  updateSpecItem,
    12→} from "../../parser/index.js";
    13→import { commitIfShadow } from "../../parser/shadow.js";
    14→import type { SpecItemInput } from "../../schema/index.js";
    15→import { errors } from "../../strings/errors.js";
    16→import { EXIT_CODES } from "../exit-codes.js";
    17→import { error, output, success, warn } from "../output.js";
    18→
    19→/**
    20→ * Register trait commands
    21→ */
    22→export function registerTraitCommands(program: Command): void {
    23→  const trait = program
    24→    .command("trait")
    25→    .description("Trait management commands");
    26→
    27→  // kspec trait add <title>
    28→  // AC: @trait-cli ac-1, ac-2
    29→  markMutating(trait.command("add <title>"))
    30→    .description("Create a new trait")
    31→    .option("--description <desc>", "Trait description")
    32→    .option("--slug <slug>", "Human-friendly slug")
    33→    .action(async (title: string, options) => {
    34→      try {
    35→        const ctx = await initContext();
    36→        const { refIndex, items } = await buildIndexes(ctx);
    37→
    38→        // Check slug uniqueness if provided
    39→        if (options.slug) {
    40→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
    41→          if (!slugCheck.ok) {
    42→            error(
    43→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
    44→            );
    45→            process.exit(EXIT_CODES.CONFLICT);
    46→          }
    47→        }
    48→
    49→        // AC: @trait-cli ac-1 - create trait-type item
    50→        const input: SpecItemInput = {
    51→          title,
    52→          type: "trait",
    53→          slugs: options.slug ? [options.slug] : [],
    54→          description: options.description, // AC: @trait-cli ac-2
    55→          priority: undefined,
    56→          tags: [],
    57→          depends_on: [],
    58→          implements: [],
    59→          relates_to: [],
    60→          tests: [],
    61→          traits: [],
    62→          notes: [],
    63→        };
    64→
    65→        const newItem = createSpecItem(input);
    66→
    67→        // Traits should be added to kynetic.yaml as root-level traits array
    68→        // This requires manually manipulating the manifest file since it's not loaded as an item
    69→
    70→        if (!ctx.manifestPath) {
    71→          error("Could not find kynetic.yaml");
    72→          process.exit(EXIT_CODES.ERROR);
    73→        }
    74→
    75→        const { readYamlFile, writeYamlFilePreserveFormat } = await import(
    76→          "../../parser/yaml.js"
    77→        );
    78→        const manifest = await readYamlFile<Record<string, unknown>>(
    79→          ctx.manifestPath,
    80→        );
    81→
    82→        if (!manifest) {
    83→          error("Could not load kynetic.yaml");
    84→          process.exit(EXIT_CODES.ERROR);
    85→        }
    86→
    87→        // Ensure traits array exists at root
    88→        if (!Array.isArray(manifest.traits)) {
    89→          manifest.traits = [];
    90→        }
    91→
    92→        // Strip metadata from newItem (_sourceFile, _path)
    93→        const { _sourceFile, _path, ...cleanItem } = newItem as LoadedSpecItem;
    94→
    95→        // Add trait to manifest
    96→        (manifest.traits as unknown[]).push(cleanItem);
    97→
    98→        await writeYamlFilePreserveFormat(ctx.manifestPath, manifest);
    99→
   100→        // For calculating path and ref
   101→        const traitIndex = (manifest.traits as unknown[]).length - 1;
   102→        const result = {
   103→          item: {
   104→            ...newItem,
   105→            _sourceFile: ctx.manifestPath,
   106→            _path: `traits[${traitIndex}]`,
   107→          } as LoadedSpecItem,
   108→          path: `traits[${traitIndex}]`,
   109→        };
   110→
   111→        // Build index with new item for short ULID
   112→        const index = new ReferenceIndex([], [...items, result.item]);
   113→        const itemSlug =
   114→          result.item.slugs?.[0] || index.shortUlid(result.item._ulid);
   115→
   116→        await commitIfShadow(ctx.shadow, "trait-add", itemSlug);
   117→        success(`Created trait: ${itemSlug}`, { trait: result.item });
   118→      } catch (err) {
   119→        error("Failed to create trait", err);
   120→        process.exit(EXIT_CODES.ERROR);
   121→      }
   122→    });
   123→
   124→  // kspec trait list
   125→  // AC: @trait-cli ac-3
   126→  trait
   127→    .command("list")
   128→    .description("List all traits")
   129→    .action(async () => {
   130→      try {
   131→        const ctx = await initContext();
   132→        const { traitIndex } = await buildIndexes(ctx);
   133→
   134→        const traits = traitIndex.getAllTraits();
   135→
   136→        // AC: @trait-edge-cases ac-4
   137→        output({ traits }, () => {
   138→          if (traits.length === 0) {
   139→            console.log(chalk.gray("No traits defined"));
   140→            return;
   141→          }
   142→
   143→          console.log(chalk.bold("Traits"));
   144→          console.log(chalk.gray("─".repeat(60)));
   145→
   146→          for (const trait of traits) {
   147→            const shortId = trait.ulid.slice(0, 8);
   148→            const acCount = trait.acceptanceCriteria.length;
   149→            const acInfo =
   150→              acCount > 0
   151→                ? chalk.gray(` (${acCount} AC)`)
   152→                : chalk.gray(" (no AC)");
   153→
   154→            console.log(
   155→              `${chalk.gray(shortId)} ${trait.title} ${chalk.cyan(`@${trait.slug}`)}${acInfo}`,
   156→            );
   157→          }
   158→
   159→          console.log(chalk.gray(`\n${traits.length} trait(s)`));
   160→        });
   161→      } catch (err) {
   162→        error("Failed to list traits", err);
   163→        process.exit(EXIT_CODES.ERROR);
   164→      }
   165→    });
   166→
   167→  // kspec trait get <ref>
   168→  // AC: @trait-cli ac-4
   169→  trait
   170→    .command("get <ref>")
   171→    .description("Show trait details")
   172→    .action(async (ref: string) => {
   173→      try {
   174→        const ctx = await initContext();
   175→        const { refIndex, traitIndex } = await buildIndexes(ctx);
   176→
   177→        const result = refIndex.resolve(ref);
   178→        if (!result.ok) {
   179→          error(errors.reference.itemNotFound(ref));
   180→          process.exit(EXIT_CODES.NOT_FOUND);
   181→        }
   182→
   183→        const item = result.item as LoadedSpecItem;
   184→
   185→        // Verify it's a trait
   186→        if (item.type !== "trait") {
   187→          error(`Item ${ref} is not a trait (type: ${item.type})`);
   188→          process.exit(EXIT_CODES.ERROR);
   189→        }
   190→
   191→        const trait = traitIndex.getTrait(item._ulid);
   192→        if (!trait) {
   193→          error(`Trait ${ref} not found in trait index`);
   194→          process.exit(EXIT_CODES.ERROR);
   195→        }
   196→
   197→        const specsUsingTrait = traitIndex.getSpecsForTrait(item._ulid);
   198→
   199→        output({ trait, specs_using_trait: specsUsingTrait }, () => {
   200→          console.log(chalk.bold(trait.title));
   201→          console.log(chalk.gray("─".repeat(40)));
   202→          console.log(`ULID:      ${trait.ulid}`);
   203→          console.log(`Slug:      @${trait.slug}`);
   204→          console.log(`Type:      trait`);
   205→
   206→          if (trait.description) {
   207→            console.log("\n─── Description ───");
   208→            console.log(trait.description);
   209→          }
   210→
   211→          // AC: @trait-cli ac-4 - show acceptance criteria
   212→          if (trait.acceptanceCriteria.length > 0) {
   213→            console.log("\n─── Acceptance Criteria ───");
   214→            for (const ac of trait.acceptanceCriteria) {
   215→              console.log(chalk.cyan(`  [${ac.id}]`));
   216→              if (ac.given) console.log(`    Given: ${ac.given}`);
   217→              if (ac.when) console.log(`    When: ${ac.when}`);
   218→              if (ac.then) console.log(`    Then: ${ac.then}`);
   219→            }
   220→          }
   221→
   222→          if (specsUsingTrait.length > 0) {
   223→            console.log(
   224→              chalk.gray(`\nUsed by ${specsUsingTrait.length} spec(s)`),
   225→            );
   226→          }
   227→        });
   228→      } catch (err) {
   229→        error("Failed to get trait", err);
   230→        process.exit(EXIT_CODES.ERROR);
   231→      }
   232→    });
   233→}
   234→
   235→/**
   236→ * Register item trait subcommands (for adding/removing traits from specs)
   237→ */
   238→export function registerItemTraitCommands(itemCommand: Command): void {
   239→  const traitCmd = itemCommand
   240→    .command("trait")
   241→    .description("Manage traits on spec items");
   242→
   243→  // kspec item trait add <spec-ref> <trait-refs...>
   244→  // AC: @trait-cli ac-5, ac-6, ac-7, ac-9, ac-10
   245→  markMutating(traitCmd.command("add <specRef> <traitRefs...>"))
   246→    .description("Add one or more traits to a spec item")
   247→    .action(async (specRef: string, traitRefs: string[]) => {
   248→      try {
   249→        const ctx = await initContext();
   250→        const { refIndex, items } = await buildIndexes(ctx);
   251→
   252→        // Resolve spec
   253→        const specResult = refIndex.resolve(specRef);
   254→        if (!specResult.ok) {
   255→          error(errors.reference.itemNotFound(specRef));
   256→          process.exit(EXIT_CODES.NOT_FOUND);
   257→        }
   258→
   259→        const spec = specResult.item as LoadedSpecItem;
   260→
   261→        // Check if it's a task
   262→        if ("status" in spec && typeof spec.status === "string") {
   263→          error(`Cannot add traits to tasks. ${specRef} is a task.`);
   264→          process.exit(EXIT_CODES.ERROR);
   265→        }
   266→
   267→        let currentTraits = spec.traits || [];
   268→        const results: Array<{
   269→          trait: string;
   270→          added: boolean;
   271→          error?: string;
   272→        }> = [];
   273→        let hasErrors = false;
   274→
   275→        for (const traitRef of traitRefs) {
   276→          // AC: @trait-cli ac-7, ac-12 - verify trait exists (continue on failure)
   277→          const traitResult = refIndex.resolve(traitRef);
   278→          if (!traitResult.ok) {
   279→            error(`Trait not found: ${traitRef}`);
   280→            results.push({ trait: traitRef, added: false, error: "not found" });
   281→            hasErrors = true;
   282→            continue;
   283→          }
   284→
   285→          const traitItem = traitResult.item as LoadedSpecItem;
   286→          if (traitItem.type !== "trait") {
   287→            error(`${traitRef} is not a trait (type: ${traitItem.type})`);
   288→            results.push({
   289→              trait: traitRef,
   290→              added: false,
   291→              error: `not a trait (type: ${traitItem.type})`,
   292→            });
   293→            hasErrors = true;
   294→            continue;
   295→          }
   296→
   297→          const traitRefString = `@${traitItem.slugs[0] || traitItem._ulid}`;
   298→
   299→          // AC: @trait-cli ac-6, ac-10 - idempotent (skip existing)
   300→          if (currentTraits.includes(traitRefString)) {
   301→            warn(`Spec already has trait ${traitRefString} (skipped)`);
   302→            results.push({ trait: traitRefString, added: false });
   303→            continue;
   304→          }
   305→
   306→          // AC: @trait-cli ac-5, ac-9 - add trait to traits array
   307→          currentTraits = [...currentTraits, traitRefString];
   308→          results.push({ trait: traitRefString, added: true });
   309→        }
   310→
   311→        const added = results.filter((r) => r.added);
   312→        const specSlug = spec.slugs[0] || refIndex.shortUlid(spec._ulid);
   313→        if (added.length > 0) {
   314→          await updateSpecItem(ctx, spec, { traits: currentTraits });
   315→          await commitIfShadow(ctx.shadow, "item-trait-add", specSlug);
   316→
   317→          const traitNames = added.map((r) => r.trait).join(", ");
   318→          success(`Added ${traitNames} to ${specSlug}`, {
   319→            spec: specSlug,
   320→            trait: results[0].trait,
   321→            added: results[0].added,
   322→            results,
   323→          });
   324→        } else {
   325→          output(
   326→            {
   327→              spec: specSlug,
   328→              trait: results[0].trait,
   329→              added: false,
   330→              results,
   331→            },
   332→            () => {
   333→              warn("No new traits added (all already present)");
   334→            },
   335→          );
   336→        }
   337→
   338→        // AC: @trait-cli ac-12 - exit code 1 when some refs failed
   339→        if (hasErrors) {
   340→          process.exit(EXIT_CODES.ERROR);
   341→        }
   342→      } catch (err) {
   343→        error("Failed to add trait to spec", err);
   344→        process.exit(EXIT_CODES.ERROR);
   345→      }
   346→    });
   347→
   348→  // kspec item trait remove <spec-ref> <trait-refs...>
   349→  // AC: @trait-cli ac-8, ac-11
   350→  markMutating(traitCmd.command("remove <specRef> <traitRefs...>"))
   351→    .description("Remove one or more traits from a spec item")
   352→    .action(async (specRef: string, traitRefs: string[]) => {
   353→      try {
   354→        const ctx = await initContext();
   355→        const { refIndex } = await buildIndexes(ctx);
   356→
   357→        // Resolve spec
   358→        const specResult = refIndex.resolve(specRef);
   359→        if (!specResult.ok) {
   360→          error(errors.reference.itemNotFound(specRef));
   361→          process.exit(EXIT_CODES.NOT_FOUND);
   362→        }
   363→
   364→        const spec = specResult.item as LoadedSpecItem;
   365→
   366→        // Check if it's a task
   367→        if ("status" in spec && typeof spec.status === "string") {
   368→          error(`Cannot remove traits from tasks. ${specRef} is a task.`);
   369→          process.exit(EXIT_CODES.ERROR);
   370→        }
   371→
   372→        let currentTraits = spec.traits || [];
   373→        const results: Array<{
   374→          trait: string;
   375→          removed: boolean;
   376→          error?: string;
   377→        }> = [];
   378→        let hasErrors = false;
   379→
   380→        for (const traitRef of traitRefs) {
   381→          // Resolve trait to get its ref format (continue on failure)
   382→          const traitResult = refIndex.resolve(traitRef);
   383→          if (!traitResult.ok) {
   384→            error(`Trait not found: ${traitRef}`);
   385→            results.push({
   386→              trait: traitRef,
   387→              removed: false,
   388→              error: "not found",
   389→            });
   390→            hasErrors = true;
   391→            continue;
   392→          }
   393→
   394→          const traitItem = traitResult.item as LoadedSpecItem;
   395→          const traitRefString = `@${traitItem.slugs[0] || traitItem._ulid}`;
   396→
   397→          // AC: @trait-cli ac-8, ac-11 - remove from traits array
   398→          if (!currentTraits.includes(traitRefString)) {
   399→            warn(`Spec does not have trait ${traitRefString} (skipped)`);
   400→            results.push({ trait: traitRefString, removed: false });
   401→            continue;
   402→          }
   403→
   404→          currentTraits = currentTraits.filter((t) => t !== traitRefString);
   405→          results.push({ trait: traitRefString, removed: true });
   406→        }
   407→
   408→        const removed = results.filter((r) => r.removed);
   409→        const specSlug = spec.slugs[0] || refIndex.shortUlid(spec._ulid);
   410→        if (removed.length > 0) {
   411→          await updateSpecItem(ctx, spec, { traits: currentTraits });
   412→          await commitIfShadow(ctx.shadow, "item-trait-remove", specSlug);
   413→
   414→          const traitNames = removed.map((r) => r.trait).join(", ");
   415→          success(`Removed ${traitNames} from ${specSlug}`, {
   416→            spec: specSlug,
   417→            trait: results[0].trait,
   418→            removed: results[0].removed,
   419→            results,
   420→          });
   421→        } else {
   422→          output(
   423→            {
   424→              spec: specSlug,
   425→              trait: results[0].trait,
   426→              removed: false,
   427→              results,
   428→            },
   429→            () => {
   430→              warn("No traits removed (none were present)");
   431→            },
   432→          );
   433→        }
   434→
   435→        // Exit code 1 when some refs failed
   436→        if (hasErrors) {
   437→          process.exit(EXIT_CODES.ERROR);
   438→        }
   439→      } catch (err) {
   440→        error("Failed to remove trait from spec", err);
   441→        process.exit(EXIT_CODES.ERROR);
   442→      }
   443→    });
   444→}
   445→

