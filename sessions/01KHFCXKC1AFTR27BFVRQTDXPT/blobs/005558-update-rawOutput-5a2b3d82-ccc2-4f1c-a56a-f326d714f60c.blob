    20→describe('Skill CLI - skill list', () => {
    21→  let tempDir: string;
    22→
    23→  beforeEach(async () => {
    24→    tempDir = await setupTempFixtures();
    25→    await initGitRepo(tempDir);
    26→
    27→    // Create some skills via kspec add - note: run sequentially
    28→    const result1 = kspecFull(
    29→      'skill add --id task-work --name "Task Work" --description "Work on tasks" --origin core --version 0.1.0',
    30→      tempDir
    31→    );
    32→    const result2 = kspecFull(
    33→      'skill add --id pr-review --name "PR Review" --origin project --tag workflow --tag review',
    34→      tempDir
    35→    );
    36→    // Fail fast if skill creation failed
    37→    if (result1.exitCode !== 0) throw new Error(`skill add failed: ${result1.stderr}`);
    38→    if (result2.exitCode !== 0) throw new Error(`skill add failed: ${result2.stderr}`);
    39→  });
    40→
    41→  afterEach(async () => {
    42→    await cleanupTempDir(tempDir);
    43→  });
    44→
    45→  // AC: @skill-cli ac-1
    46→  it('should display table with ID, Name, Origin, Version, and Platforms columns', () => {
    47→    const output = kspec('skill list', tempDir);
    48→
    49→    // Check headers are present
    50→    expect(output).toContain('ID');
    51→    expect(output).toContain('Name');
    52→    expect(output).toContain('Origin');
    53→    expect(output).toContain('Version');
    54→    expect(output).toContain('Platforms');
    55→
    56→    // Check data
    57→    expect(output).toContain('task-work');
    58→    expect(output).toContain('Task Work');
    59→    expect(output).toContain('core');
    60→    expect(output).toContain('pr-review');
    61→    expect(output).toContain('PR Review');
    62→    expect(output).toContain('project');
    63→
    64→    // Check skill count
    65→    expect(output).toContain('2 skill(s)');
    66→  });
    67→
    68→  // AC: @skill-cli ac-2
    69→  it('should return JSON array with full skill metadata when --json flag provided', () => {
    70→    const result = kspecJson<Array<{
    71→      _ulid: string;
    72→      id: string;
    73→      name: string;
    74→      description?: string;
    75→      origin: string;
    76→      version?: string;
    77→      platforms: string[];
    78→      depends_on: string[];
    79→      tags: string[];
    80→    }>>('skill list', tempDir);
    81→
    82→    expect(Array.isArray(result)).toBe(true);
    83→    expect(result.length).toBe(2);
    84→
    85→    const taskWork = result.find(s => s.id === 'task-work');
    86→    expect(taskWork).toBeDefined();
    87→    expect(taskWork?._ulid).toMatch(/^[0-9A-Z]{26}$/);
    88→    expect(taskWork?.name).toBe('Task Work');
    89→    expect(taskWork?.description).toBe('Work on tasks');
    90→    expect(taskWork?.origin).toBe('core');
    91→    expect(taskWork?.version).toBe('0.1.0');
    92→    expect(taskWork?.platforms).toContain('claude-code');
    93→    expect(taskWork?.depends_on).toEqual([]);
    94→
    95→    const prReview = result.find(s => s.id === 'pr-review');
    96→    expect(prReview).toBeDefined();
    97→    expect(prReview?.origin).toBe('project');
    98→    expect(prReview?.tags).toContain('workflow');
    99→    expect(prReview?.tags).toContain('review');
   100→  });
   101→
   102→  it('should filter by origin', () => {
   103→    const result = kspecJson<Array<{ id: string; origin: string }>>('skill list --origin core', tempDir);
   104→
