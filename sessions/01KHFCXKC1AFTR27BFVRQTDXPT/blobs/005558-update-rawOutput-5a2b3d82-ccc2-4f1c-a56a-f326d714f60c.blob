   191→    const meta = yamlParse(metaContent);
   192→
   193→    expect(meta.skills).toBeDefined();
   194→    const skill = meta.skills.find((s: { id: string }) => s.id === 'my-skill');
   195→    expect(skill).toBeDefined();
