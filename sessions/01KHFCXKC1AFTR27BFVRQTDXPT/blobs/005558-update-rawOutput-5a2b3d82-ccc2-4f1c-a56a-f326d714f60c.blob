   379→describe('Skill CLI - skill delete', () => {
   380→  let tempDir: string;
   381→
   382→  beforeEach(async () => {
   383→    tempDir = await setupTempFixtures();
   384→    await initGitRepo(tempDir);
   385→
   386→    // Create skills
   387→    kspec('skill add --id my-skill --name "My Skill"', tempDir);
   388→    kspec('skill add --id dependent-skill --name "Dependent Skill" --depends-on @my-skill', tempDir);
   389→  });
   390→
   391→  afterEach(async () => {
   392→    await cleanupTempDir(tempDir);
   393→  });
   394→
   395→  // AC: @skill-cli ac-7
   396→  it('should remove meta entry from manifest when --confirm provided', async () => {
   397→    // First create a skill that has no dependencies
   398→    kspec('skill add --id standalone-skill --name "Standalone Skill"', tempDir);
   399→
   400→    // Verify it exists
   401→    let list = kspecJson<Array<{ id: string }>>('skill list', tempDir);
   402→    expect(list.some(s => s.id === 'standalone-skill')).toBe(true);
   403→
   404→    // Delete it
   405→    kspec('skill delete @standalone-skill --confirm', tempDir);
   406→
   407→    // Verify it's gone
   408→    list = kspecJson<Array<{ id: string }>>('skill list', tempDir);
   409→    expect(list.some(s => s.id === 'standalone-skill')).toBe(false);
   410→  });
   411→
   412→  // AC: @skill-cli ac-8
   413→  it('should delete .kspec/skills/<id>/ directory', async () => {
   414→    // Create a standalone skill
   415→    kspec('skill add --id standalone-skill --name "Standalone Skill"', tempDir);
   416→
   417→    // Verify directory exists
   418→    const skillDir = path.join(tempDir, 'skills', 'standalone-skill');
   419→    let exists = await fs.access(skillDir).then(() => true).catch(() => false);
   420→    expect(exists).toBe(true);
   421→
   422→    // Delete the skill
   423→    kspec('skill delete @standalone-skill --confirm', tempDir);
   424→
   425→    // Verify directory is gone
   426→    exists = await fs.access(skillDir).then(() => true).catch(() => false);
   427→    expect(exists).toBe(false);
   428→  });
   429→
   430→  it('should require --confirm flag', () => {
   431→    const result = kspecFull('skill delete @my-skill', tempDir, { expectFail: true });
   432→    expect(result.exitCode).not.toBe(0);
   433→    expect(result.stderr).toContain('--confirm');
   434→  });
   435→
   436→  it('should prevent deletion when other skills depend on it', () => {
   437→    const result = kspecFull('skill delete @my-skill --confirm', tempDir, { expectFail: true });
   438→    expect(result.exitCode).not.toBe(0);
   439→    expect(result.stderr).toContain('referenced by');
   440→    expect(result.stderr).toContain('@dependent-skill');
   441→  });
   442→
   443→  it('should return error when skill not found', () => {
   444→    const result = kspecFull('skill delete @nonexistent --confirm', tempDir, { expectFail: true });
   445→    expect(result.exitCode).not.toBe(0);
   446→    expect(result.stderr).toContain('not found');
   447→  });
   448→
   449→  it('should find skill by ULID prefix', async () => {
   450→    // Create a standalone skill and get its ULID
   451→    const createResult = kspecJson<{ _ulid: string; id: string }>(
   452→      'skill add --id temp-skill --name "Temp Skill"',
   453→      tempDir
   454→    );
   455→    const ulidPrefix = createResult._ulid.slice(0, 8);
   456→
   457→    // Delete by ULID prefix
   458→    const output = kspec(`skill delete @${ulidPrefix} --confirm`, tempDir);
   459→    expect(output).toContain('Deleted');
   460→
   461→    // Verify it's gone
   462→    const list = kspecJson<Array<{ id: string }>>('skill list', tempDir);
   463→    expect(list.some(s => s.id === 'temp-skill')).toBe(false);
   464→  });
   465→});
   466→