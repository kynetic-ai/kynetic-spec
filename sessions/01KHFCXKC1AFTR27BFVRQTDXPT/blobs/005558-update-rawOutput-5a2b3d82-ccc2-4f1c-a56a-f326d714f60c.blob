   270→describe('Skill CLI - skill get', () => {
   271→  let tempDir: string;
   272→
   273→  beforeEach(async () => {
   274→    tempDir = await setupTempFixtures();
   275→    await initGitRepo(tempDir);
   276→
   277→    // Create a skill with custom content
   278→    const result = kspecFull(
   279→      'skill add --id task-work --name "Task Work" --description "Work on tasks" --origin core --version 0.1.0 --tag workflow',
   280→      tempDir
   281→    );
   282→    if (result.exitCode !== 0) throw new Error(`skill add failed: ${result.stderr}`);
   283→
   284→    // Update SKILL.md with custom content - the directory was created by skill add
   285→    const skillMdPath = path.join(tempDir, 'skills', 'task-work', 'SKILL.md');
   286→    await fs.writeFile(skillMdPath, `# Task Work
   287→
   288→Use this skill when working on kspec tasks.
   289→
   290→## Usage
   291→
   292→\`\`\`bash
   293→kspec task start @ref
   294→\`\`\`
   295→`);
   296→  });
   297→
   298→  afterEach(async () => {
   299→    await cleanupTempDir(tempDir);
   300→  });
   301→
   302→  // AC: @skill-cli ac-5
   303→  it('should display metadata including id, name, origin, and platforms', () => {
   304→    const output = kspec('skill get @task-work', tempDir);
   305→
   306→    expect(output).toContain('Task Work');
   307→    expect(output).toContain('ID:');
   308→    expect(output).toContain('task-work');
   309→    expect(output).toContain('Origin:');
   310→    expect(output).toContain('core');
   311→    expect(output).toContain('Platforms:');
   312→    expect(output).toContain('claude-code');
   313→    expect(output).toContain('Version:');
   314→    expect(output).toContain('0.1.0');
   315→  });
   316→
   317→  // AC: @skill-cli ac-6
   318→  it('should display SKILL.md content', () => {
   319→    const output = kspec('skill get @task-work', tempDir);
   320→
   321→    expect(output).toContain('SKILL.md Content');
   322→    expect(output).toContain('Use this skill when working on kspec tasks');
   323→    expect(output).toContain('kspec task start @ref');
   324→  });
   325→
   326→  it('should include all metadata in JSON output', () => {
   327→    const result = kspecJson<{
   328→      _ulid: string;
   329→      id: string;
   330→      name: string;
   331→      description: string;
   332→      origin: string;
   333→      version: string;
   334→      platforms: string[];
   335→      depends_on: string[];
   336→      tags: string[];
   337→      content: string;
   338→      docs: Array<{ name: string; path: string }>;
   339→    }>('skill get @task-work', tempDir);
   340→
   341→    expect(result.id).toBe('task-work');
   342→    expect(result.name).toBe('Task Work');
   343→    expect(result.description).toBe('Work on tasks');
   344→    expect(result.origin).toBe('core');
   345→    expect(result.version).toBe('0.1.0');
   346→    expect(result.platforms).toContain('claude-code');
   347→    expect(result.tags).toContain('workflow');
   348→    expect(result.content).toContain('Use this skill when working on kspec tasks');
   349→    expect(Array.isArray(result.docs)).toBe(true);
   350→  });
   351→
   352→  it('should find skill by ULID prefix', async () => {
   353→    // Get the skill's ULID first
   354→    const list = kspecJson<Array<{ _ulid: string; id: string }>>('skill list', tempDir);
   355→    const skill = list.find(s => s.id === 'task-work');
   356→    const ulidPrefix = skill?._ulid.slice(0, 8);
   357→
   358→    const output = kspec(`skill get @${ulidPrefix}`, tempDir);
   359→    expect(output).toContain('task-work');
   360→    expect(output).toContain('Task Work');
   361→  });
   362→
   363→  it('should return error when skill not found', () => {
   364→    const result = kspecFull('skill get @nonexistent', tempDir, { expectFail: true });
   365→    expect(result.exitCode).not.toBe(0);
   366→    expect(result.stderr).toContain('not found');
   367→  });
   368→
   369→  it('should show (No SKILL.md content found) when file missing', async () => {
   370→    // Delete the SKILL.md file
   371→    const skillMdPath = path.join(tempDir, 'skills', 'task-work', 'SKILL.md');
   372→    await fs.unlink(skillMdPath);
   373→
   374→    const output = kspec('skill get @task-work', tempDir);
   375→    expect(output).toContain('No SKILL.md content found');
   376→  });
   377→});
