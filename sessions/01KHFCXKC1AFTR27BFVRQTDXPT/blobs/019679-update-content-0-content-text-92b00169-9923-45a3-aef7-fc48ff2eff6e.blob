```
     1→/**
     2→ * Agent instruction generation commands.
     3→ *
     4→ * AC: @agent-instruction-gen ac-1 - kspec agents generate creates kspec-agents.md in project root
     5→ * AC: @agent-instruction-gen ac-2 - output includes Finding Information table with row per skill
     6→ * AC: @agent-instruction-gen ac-3 - output includes conventions section listing rules by domain
     7→ * AC: @agent-instruction-gen ac-4 - output contains freshness comment with kspec version and timestamp
     8→ * AC: @agent-instruction-gen ac-5 - kspec agents status reports stale when not regenerated after meta changes
     9→ *
    10→ * AC: @agents-cli ac-1 - kspec agents generate writes kspec-agents.md to project root
    11→ * AC: @agents-cli ac-2 - kspec agents generate --dry-run prints content without writing
    12→ * AC: @agents-cli ac-3 - kspec agents status reports up to date when current
    13→ * AC: @agents-cli ac-4 - kspec agents status reports stale when meta changed
    14→ *
    15→ * AC: @agent-templates ac-1 - template sections included in output in defined order
    16→ * AC: @agent-templates ac-2 - each template section appears in generated output
    17→ * AC: @agent-templates ac-3 - error if template directory missing or empty
    18→ */
    19→
    20→import * as crypto from "node:crypto";
    21→import * as fs from "node:fs/promises";
    22→import { createRequire } from "node:module";
    23→import * as path from "node:path";
    24→import { fileURLToPath } from "node:url";
    25→import chalk from "chalk";
    26→import type { Command } from "commander";
    27→import {
    28→  generateConventionsSummary,
    29→  generateSkillsTable,
    30→  generateWorkflowsSummary,
    31→  initContext,
    32→  loadMetaContext,
    33→  type LoadedConvention,
    34→  type LoadedSkill,
    35→  type LoadedWorkflow,
    36→} from "../../parser/index.js";
    37→import { errors } from "../../strings/errors.js";
    38→import { EXIT_CODES } from "../exit-codes.js";
    39→import { error, output, success } from "../output.js";
    40→
    41→const __filename = fileURLToPath(import.meta.url);
    42→const __dirname = path.dirname(__filename);
    43→
    44→// Read version from package.json at runtime
    45→const require = createRequire(import.meta.url);
    46→const { version } = require("../../../package.json");
    47→
    48→/**
    49→ * File name for generated agent instructions
    50→ */
    51→const GENERATED_FILE_NAME = "kspec-agents.md";
    52→
    53→/**
    54→ * Hash file name for tracking freshness
    55→ */
    56→const HASH_FILE_NAME = ".kspec-agents-hash";
    57→
    58→/**
    59→ * Templates directory name relative to package root
    60→ */
    61→const TEMPLATES_DIR = "templates/agents-sections";
    62→
    63→/**
    64→ * Expected template files in order
    65→ * AC: @agent-templates ac-2 - template files for quick-start, shadow-branch, task-lifecycle, pr-workflow, commit-convention, ralph-loop
    66→ */
    67→const EXPECTED_TEMPLATES = [
    68→  "01-quick-start.md",
    69→  "02-shadow-branch.md",
    70→  "03-task-lifecycle.md",
    71→  "04-pr-workflow.md",
    72→  "05-commit-convention.md",
    73→  "06-ralph-loop.md",
    74→];
    75→
    76→/**
    77→ * Compute SHA256 hash of content
    78→ */
    79→function computeHash(content: string): string {
    80→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
    81→}
    82→
    83→/**
    84→ * Load template sections from the templates directory.
    85→ * AC: @agent-templates ac-1 - all template sections included in defined order
    86→ * AC: @agent-templates ac-3 - error if directory missing or empty
    87→ */
    88→async function loadTemplateSections(packageRoot: string): Promise<string[]> {
    89→  const templatesPath = path.join(packageRoot, TEMPLATES_DIR);
    90→
    91→  // Check if templates directory exists
    92→  try {
    93→    await fs.access(templatesPath);
    94→  } catch {
    95→    throw new Error(
    96→      `Templates directory not found at: ${templatesPath}. ` +
    97→        `Expected templates/agents-sections/ directory with section markdown files.`,
    98→    );
    99→  }
   100→
   101→  // Read directory contents
   102→  const entries = await fs.readdir(templatesPath, { withFileTypes: true });
   103→  const mdFiles = entries
   104→    .filter((e) => e.isFile() && e.name.endsWith(".md"))
   105→    .map((e) => e.name)
   106→    .sort(); // Sort to ensure consistent ordering by filename prefix
   107→
   108→  if (mdFiles.length === 0) {
   109→    throw new Error(
   110→      `Templates directory is empty: ${templatesPath}. ` +
   111→        `Expected markdown files for agent instruction sections.`,
   112→    );
   113→  }
   114→
   115→  // Load each template in order
   116→  const sections: string[] = [];
   117→  for (const filename of mdFiles) {
   118→    const filePath = path.join(templatesPath, filename);
   119→    const content = await fs.readFile(filePath, "utf-8");
   120→    sections.push(content.trim());
   121→  }
   122→
   123→  return sections;
   124→}
   125→
   126→/**
   127→ * Get the package root directory (where templates/ is located)
   128→ */
   129→function getPackageRoot(): string {
   130→  // Navigate from dist/cli/commands/ to package root
   131→  return path.resolve(__dirname, "..", "..", "..");
   132→}
   133→
   134→/**
   135→ * Generate a hash of the meta content that affects the generated file.
   136→ * This is used to detect if the generated file is stale.
   137→ */
   138→function computeMetaHash(
   139→  skills: LoadedSkill[],
   140→  conventions: LoadedConvention[],
   141→  workflows: LoadedWorkflow[],
   142→): string {
   143→  // Create a stable representation of the meta content
   144→  const data = {
   145→    skills: skills.map((s) => ({
   146→      id: s.id,
   147→      name: s.name,
   148→      description: s.description,
   149→    })),
   150→    conventions: conventions.map((c) => ({
   151→      domain: c.domain,
   152→      rules: c.rules,
   153→    })),
   154→    workflows: workflows.map((w) => ({
   155→      id: w.id,
   156→      trigger: w.trigger,
   157→      description: w.description,
   158→    })),
   159→  };
   160→  return computeHash(JSON.stringify(data));
   161→}
   162→
   163→/**
   164→ * Generate the freshness comment.
   165→ * AC: @agent-instruction-gen ac-4 - freshness comment with kspec version and timestamp
   166→ */
   167→function generateFreshnessComment(timestamp: string): string {
   168→  return `<!-- Generated by kspec v${version} at ${timestamp} -->\n<!-- Do not edit manually - regenerate with: kspec agents generate -->\n\n`;
   169→}
   170→
   171→/**
   172→ * Generate the full kspec-agents.md content
   173→ * AC: @agent-templates ac-1 - template sections included in output in defined order
   174→ * AC: @agent-templates ac-2 - each template section appears in generated output
   175→ */
   176→async function generateAgentsContent(
   177→  skills: LoadedSkill[],
   178→  conventions: LoadedConvention[],
   179→  workflows: LoadedWorkflow[],
   180→  timestamp: string,
   181→  templateSections: string[],
   182→): Promise<string> {
   183→  const sections: string[] = [];
   184→
   185→  // AC: @agent-instruction-gen ac-4 - freshness comment
   186→  sections.push(generateFreshnessComment(timestamp));
   187→
   188→  // Header
   189→  sections.push("# kspec Agent Instructions\n");
   190→  sections.push(
   191→    "This file is auto-generated from kspec meta. Include it in your AGENTS.md or similar agent instruction file.\n\n",
   192→  );
   193→
   194→  // AC: @agent-instruction-gen ac-2 - Skills table
   195→  const skillsTable = generateSkillsTable(skills);
   196→  if (skillsTable) {
   197→    sections.push(skillsTable);
   198→  }
   199→
   200→  // AC: @agent-instruction-gen ac-3 - Conventions section
   201→  const conventionsSection = generateConventionsSummary(conventions);
   202→  if (conventionsSection) {
   203→    sections.push(conventionsSection);
   204→  }
   205→
   206→  // Workflows summary
   207→  const workflowsSection = generateWorkflowsSummary(workflows);
   208→  if (workflowsSection) {
   209→    sections.push(workflowsSection);
   210→  }
   211→
   212→  // AC: @agent-templates ac-1, ac-2 - Include template sections in order
   213→  if (templateSections.length > 0) {
   214→    sections.push("\n");
   215→    for (const section of templateSections) {
   216→      sections.push(section);
   217→      sections.push("\n\n");
   218→    }
   219→  }
   220→
   221→  return sections.join("");
   222→}
   223→
   224→/**
   225→ * Result of checking agent file status
   226→ */
   227→interface AgentStatusResult {
   228→  exists: boolean;
   229→  path: string;
   230→  status: "current" | "stale" | "missing";
   231→  metaHash?: string;
   232→  storedHash?: string;
   233→  generatedAt?: string;
   234→}
   235→
   236→/**
   237→ * Check the status of the generated agent file.
   238→ * AC: @agent-instruction-gen ac-5 - reports stale when meta has changed
   239→ */
   240→async function checkAgentStatus(
   241→  projectRoot: string,
   242→  metaHash: string,
   243→): Promise<AgentStatusResult> {
   244→  const filePath = path.join(projectRoot, GENERATED_FILE_NAME);
   245→  const hashPath = path.join(projectRoot, ".kspec", HASH_FILE_NAME);
   246→
   247→  // Check if file exists
   248→  try {
   249→    await fs.access(filePath);
   250→  } catch {
   251→    return {
   252→      exists: false,
   253→      path: filePath,
   254→      status: "missing",
   255→      metaHash,
   256→    };
   257→  }
   258→
   259→  // Check stored hash
   260→  let storedHash: string | undefined;
   261→  let generatedAt: string | undefined;
   262→
   263→  try {
   264→    const hashContent = await fs.readFile(hashPath, "utf-8");
   265→    const hashData = JSON.parse(hashContent);
   266→    storedHash = hashData.metaHash;
   267→    generatedAt = hashData.generatedAt;
   268→  } catch {
   269→    // No hash file, treat as stale
   270→    return {
   271→      exists: true,
   272→      path: filePath,
   273→      status: "stale",
   274→      metaHash,
   275→    };
   276→  }
   277→
   278→  // Compare hashes
   279→  const isCurrent = storedHash === metaHash;
   280→
   281→  return {
   282→    exists: true,
   283→    path: filePath,
   284→    status: isCurrent ? "current" : "stale",
   285→    metaHash,
   286→    storedHash,
   287→    generatedAt,
   288→  };
   289→}
   290→
   291→/**
   292→ * Register agent instruction generation commands
   293→ */
   294→export function registerAgentsCommands(program: Command): void {
   295→  const agents = program
   296→    .command("agents")
   297→    .description("Agent instruction generation commands");
   298→
   299→  // AC: @agent-instruction-gen ac-1 - kspec agents generate
   300→  // AC: @agent-templates ac-3 - error if template directory missing
   301→  // AC: @trait-dry-run ac-1 through ac-6 - dry-run support
   302→  agents
   303→    .command("generate")
   304→    .description("Generate kspec-agents.md from meta (skills, conventions, workflows)")
   305→    .option("--dry-run", "Show what would be generated without writing files")
   306→    .action(async (options) => {
   307→      try {
   308→        const ctx = await initContext();
   309→
   310→        if (!ctx.manifestPath) {
   311→          error(errors.project.noKspecProject);
   312→          process.exit(EXIT_CODES.ERROR);
   313→        }
   314→
   315→        // AC: @agent-templates ac-3 - error if templates missing
   316→        const packageRoot = getPackageRoot();
   317→        let templateSections: string[];
   318→        try {
   319→          templateSections = await loadTemplateSections(packageRoot);
   320→        } catch (err) {
   321→          const message =
   322→            err instanceof Error ? err.message : "Unknown error loading templates";
   323→          error(message, {
   324→            suggestion: `Verify that ${TEMPLATES_DIR}/ exists with markdown files.`,
   325→          });
   326→          process.exit(EXIT_CODES.ERROR);
   327→        }
   328→
   329→        const metaCtx = await loadMetaContext(ctx);
   330→        const dryRun = options.dryRun || false;
   331→        const timestamp = new Date().toISOString();
   332→
   333→        // Generate content - now async due to template loading
   334→        const content = await generateAgentsContent(
   335→          metaCtx.skills,
   336→          metaCtx.conventions,
   337→          metaCtx.workflows,
   338→          timestamp,
   339→          templateSections,
   340→        );
   341→
   342→        // Compute meta hash for freshness tracking
   343→        // Include template count to detect template changes
   344→        const metaHash = computeMetaHash(
   345→          metaCtx.skills,
   346→          metaCtx.conventions,
   347→          metaCtx.workflows,
   348→        );
   349→
   350→        const outputPath = path.join(ctx.rootDir, GENERATED_FILE_NAME);
   351→        const hashPath = path.join(ctx.rootDir, ".kspec", HASH_FILE_NAME);
   352→
   353→        // AC: @trait-dry-run ac-3 - clear indication this is a preview
   354→        if (dryRun) {
   355→          output(
   356→            {
   357→              dry_run: true,
   358→              path: outputPath,
   359→              skills: metaCtx.skills.length,
   360→              conventions: metaCtx.conventions.length,
   361→              workflows: metaCtx.workflows.length,
   362→              templates: templateSections.length,
   363→              content,
   364→            },
   365→            () => {
   366→              console.log(chalk.yellow("DRY RUN - No changes made"));
   367→              console.log();
   368→              console.log(chalk.gray(`Would write to: ${outputPath}`));
   369→              console.log();
   370→              console.log(chalk.gray("--- Generated content ---"));
   371→              console.log(content);
   372→              console.log(chalk.gray("--- End content ---"));
   373→              console.log();
   374→              console.log(
   375→                chalk.yellow("No changes were made. Run without --dry-run to apply."),
   376→              );
   377→            },
   378→          );
   379→          return;
   380→        }
   381→
   382→        // AC: @trait-dry-run ac-2 - no files modified in dry run mode
   383→        // Write the generated file
   384→        await fs.writeFile(outputPath, content, "utf-8");
   385→
   386→        // Write the hash file for freshness tracking
   387→        await fs.mkdir(path.dirname(hashPath), { recursive: true });
   388→        await fs.writeFile(
   389→          hashPath,
   390→          JSON.stringify(
   391→            {
   392→              metaHash,
   393→              generatedAt: timestamp,
   394→              version,
   395→            },
   396→            null,
   397→            2,
   398→          ),
   399→          "utf-8",
   400→        );
   401→
   402→        output(
   403→          {
   404→            path: outputPath,
   405→            skills: metaCtx.skills.length,
   406→            conventions: metaCtx.conventions.length,
   407→            workflows: metaCtx.workflows.length,
   408→            templates: templateSections.length,
   409→            generatedAt: timestamp,
   410→          },
   411→          () => {
   412→            success(`Generated ${GENERATED_FILE_NAME}`, {
   413→              skills: metaCtx.skills.length,
   414→              conventions: metaCtx.conventions.length,
   415→              workflows: metaCtx.workflows.length,
   416→              templates: templateSections.length,
   417→            });
   418→            console.log(chalk.gray(`  Path: ${outputPath}`));
   419→          },
   420→        );
   421→      } catch (err) {
   422→        error("Failed to generate agent instructions", err);
   423→        process.exit(EXIT_CODES.ERROR);
   424→      }
   425→    });
   426→
   427→  // AC: @agent-instruction-gen ac-5 - kspec agents status
   428→  agents
   429→    .command("status")
   430→    .description("Check if kspec-agents.md is up to date with meta")
   431→    .action(async () => {
   432→      try {
   433→        const ctx = await initContext();
   434→
   435→        if (!ctx.manifestPath) {
   436→          error(errors.project.noKspecProject);
   437→          process.exit(EXIT_CODES.ERROR);
   438→        }
   439→
   440→        const metaCtx = await loadMetaContext(ctx);
   441→
   442→        // Compute current meta hash
   443→        const metaHash = computeMetaHash(
   444→          metaCtx.skills,
   445→          metaCtx.conventions,
   446→          metaCtx.workflows,
   447→        );
   448→
   449→        const status = await checkAgentStatus(ctx.rootDir, metaHash);
   450→
   451→        output(status, () => {
   452→          switch (status.status) {
   453→            case "missing":
   454→              console.log(chalk.yellow(`${GENERATED_FILE_NAME} does not exist`));
   455→              console.log();
   456→              console.log(
   457→                chalk.gray("Run 'kspec agents generate' to create it."),
   458→              );
   459→              break;
   460→
   461→            case "stale":
   462→              console.log(
   463→                chalk.yellow(`${GENERATED_FILE_NAME} is stale`),
   464→              );
   465→              console.log();
   466→              console.log(
   467→                chalk.gray(
   468→                  "Meta has changed since the file was generated.",
   469→                ),
   470→              );
   471→              console.log(
   472→                chalk.gray("Run 'kspec agents generate' to regenerate."),
   473→              );
   474→              break;
   475→
   476→            case "current":
   477→              console.log(chalk.green(`${GENERATED_FILE_NAME} is up to date`));
   478→              if (status.generatedAt) {
   479→                console.log(chalk.gray(`  Generated: ${status.generatedAt}`));
   480→              }
   481→              break;
   482→          }
   483→        });
   484→      } catch (err) {
   485→        error("Failed to check agent status", err);
   486→        process.exit(EXIT_CODES.ERROR);
   487→      }
   488→    });
   489→}
