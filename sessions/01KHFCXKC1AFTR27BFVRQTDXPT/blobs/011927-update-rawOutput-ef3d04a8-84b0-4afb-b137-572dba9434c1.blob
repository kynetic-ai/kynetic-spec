     1→/**
     2→ * Skill CLI commands for managing skills.
     3→ *
     4→ * AC: @skill-cli ac-1 - kspec skill list outputs table with ID, Name, Origin, Version, Platforms
     5→ * AC: @skill-cli ac-2 - kspec skill list --json outputs JSON array with full skill metadata
     6→ * AC: @skill-cli ac-3 - kspec skill add creates meta entry with origin custom
     7→ * AC: @skill-cli ac-4 - kspec skill add creates .kspec/skills/<id>/SKILL.md
     8→ * AC: @skill-cli ac-5 - kspec skill get outputs metadata including id, name, origin, platforms
     9→ * AC: @skill-cli ac-6 - kspec skill get outputs SKILL.md content
    10→ * AC: @skill-cli ac-7 - kspec skill delete --confirm removes meta entry
    11→ * AC: @skill-cli ac-8 - kspec skill delete removes .kspec/skills/<id>/ directory
    12→ */
    13→
    14→import * as fs from "node:fs/promises";
    15→import * as path from "node:path";
    16→import chalk from "chalk";
    17→import Table from "cli-table3";
    18→import type { Command } from "commander";
    19→import { ulid } from "ulid";
    20→import yaml from "yaml";
    21→import { markMutating } from "../command-annotations.js";
    22→import {
    23→  deleteMetaItem,
    24→  findMetaItemByRef,
    25→  getSkillContentPath,
    26→  initContext,
    27→  type KspecContext,
    28→  loadMetaContext,
    29→  loadSkillContent,
    30→  loadSkillDocs,
    31→  type LoadedSkill,
    32→  saveMetaItem,
    33→  type Skill,
    34→} from "../../parser/index.js";
    35→import { commitIfShadow } from "../../parser/shadow.js";
    36→import { SkillSchema, type SkillOrigin } from "../../schema/index.js";
    37→import { errors } from "../../strings/errors.js";
    38→import { EXIT_CODES } from "../exit-codes.js";
    39→import { error, output, success } from "../output.js";
    40→import { parseTagsArray } from "../parse-utils.js";
    41→
    42→/**
    43→ * Format skills as a table
    44→ * AC: @skill-cli ac-1 - table displays ID, Name, Origin, Version, Platforms
    45→ */
    46→function formatSkillsTable(skills: LoadedSkill[]): void {
    47→  if (skills.length === 0) {
    48→    console.log(chalk.yellow("No skills defined"));
    49→    return;
    50→  }
    51→
    52→  const table = new Table({
    53→    head: [
    54→      chalk.bold("ID"),
    55→      chalk.bold("Name"),
    56→      chalk.bold("Origin"),
    57→      chalk.bold("Version"),
    58→      chalk.bold("Platforms"),
    59→    ],
    60→    style: {
    61→      head: [],
    62→      border: [],
    63→    },
    64→  });
    65→
    66→  for (const skill of skills) {
    67→    table.push([
    68→      skill.id,
    69→      skill.name,
    70→      skill.origin,
    71→      skill.version || "-",
    72→      skill.platforms.join(", "),
    73→    ]);
    74→  }
    75→
    76→  console.log(table.toString());
    77→  console.log(chalk.gray(`\n${skills.length} skill(s)`));
    78→}
    79→
    80→/**
    81→ * Format skill details
    82→ * AC: @skill-cli ac-5 - outputs metadata including id, name, origin, platforms
    83→ */
    84→function formatSkillDetails(skill: LoadedSkill, content: string | null): void {
    85→  console.log(chalk.bold(skill.name));
    86→  console.log(chalk.gray("─".repeat(40)));
    87→  console.log(`ID:          ${skill.id}`);
    88→  console.log(`ULID:        ${skill._ulid}`);
    89→  console.log(`Origin:      ${skill.origin}`);
    90→  console.log(`Platforms:   ${skill.platforms.join(", ")}`);
    91→
    92→  if (skill.version) {
    93→    console.log(`Version:     ${skill.version}`);
    94→  }
    95→
    96→  if (skill.description) {
    97→    console.log(`\n─── Description ───`);
    98→    console.log(skill.description);
    99→  }
   100→
   101→  if (skill.depends_on && skill.depends_on.length > 0) {
   102→    console.log(`\n─── Dependencies ───`);
   103→    for (const dep of skill.depends_on) {
   104→      console.log(`  • ${dep}`);
   105→    }
   106→  }
   107→
   108→  if (skill.tags && skill.tags.length > 0) {
   109→    console.log(`\nTags:        ${skill.tags.join(", ")}`);
   110→  }
   111→
   112→  // AC: @skill-cli ac-6 - display SKILL.md content
   113→  if (content) {
   114→    console.log(`\n─── SKILL.md Content ───`);
   115→    console.log(content);
   116→  } else {
   117→    console.log(chalk.gray("\n(No SKILL.md content found)"));
   118→  }
   119→}
   120→
   121→/**
   122→ * Register skill commands
   123→ */
   124→export function registerSkillCommands(program: Command): void {
   125→  const skill = program
   126→    .command("skill")
   127→    .description("Skill management commands");
   128→
   129→  // AC: @skill-cli ac-1, ac-2 - kspec skill list
   130→  skill
   131→    .command("list")
   132→    .description("List all skills")
   133→    .option("--origin <origin>", "Filter by origin (core, project, local)")
   134→    .option("--tag <tag>", "Filter by tag")
   135→    .action(async (options) => {
   136→      try {
   137→        const ctx = await initContext();
   138→
   139→        if (!ctx.manifestPath) {
   140→          error(errors.project.noKspecProject);
   141→          process.exit(EXIT_CODES.ERROR);
   142→        }
   143→
   144→        const metaCtx = await loadMetaContext(ctx);
   145→        let skills = metaCtx.skills || [];
   146→
   147→        // Apply filters
   148→        if (options.origin) {
   149→          skills = skills.filter((s) => s.origin === options.origin);
   150→        }
   151→
   152→        if (options.tag) {
   153→          skills = skills.filter((s) => s.tags?.includes(options.tag));
   154→        }
   155→
   156→        // AC: @skill-cli ac-2 - JSON output includes full skill metadata
   157→        output(
   158→          skills.map((s) => ({
   159→            _ulid: s._ulid,
   160→            id: s.id,
   161→            name: s.name,
   162→            description: s.description,
   163→            origin: s.origin,
   164→            version: s.version,
   165→            platforms: s.platforms,
   166→            depends_on: s.depends_on,
   167→            tags: s.tags,
   168→          })),
   169→          // AC: @skill-cli ac-1 - Table output
   170→          () => formatSkillsTable(skills),
   171→        );
   172→      } catch (err) {
   173→        error("Failed to list skills", err);
   174→        process.exit(EXIT_CODES.ERROR);
   175→      }
   176→    });
   177→
   178→  // AC: @skill-cli ac-3, ac-4 - kspec skill add
   179→  // AC: @skill-add ac-3 - --content-file copies existing file to SKILL.md
   180→  markMutating(skill.command("add"))
   181→    .description("Create a new skill")
   182→    .requiredOption("--id <id>", "Skill ID (kebab-case)")
   183→    .requiredOption("--name <name>", "Skill name")
   184→    .option("--description <desc>", "Skill description")
   185→    .option(
   186→      "--origin <origin>",
   187→      "Skill origin (core, project, local)",
   188→      "project",
   189→    )
   190→    .option("--skill-version <version>", "Skill version")
   191→    .option("--platform <platform...>", "Target platforms")
   192→    .option("--tag <tag...>", "Tags for the skill")
   193→    .option("--depends-on <ref...>", "Skill dependencies")
   194→    .option("--content-file <path>", "Path to existing file to use as SKILL.md content")
   195→    .action(async (options) => {
   196→      try {
   197→        const ctx = await initContext();
   198→
   199→        if (!ctx.manifestPath) {
   200→          error(errors.project.noKspecProject);
   201→          process.exit(EXIT_CODES.ERROR);
   202→        }
   203→
   204→        // Validate origin
   205→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   206→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   207→          error(
   208→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   209→          );
   210→          process.exit(EXIT_CODES.ERROR);
   211→        }
   212→
   213→        // Check if skill with this ID already exists
   214→        const metaCtx = await loadMetaContext(ctx);
   215→        const existingSkill = metaCtx.skills.find((s) => s.id === options.id);
   216→        if (existingSkill) {
   217→          error(`Skill with ID '${options.id}' already exists`);
   218→          process.exit(EXIT_CODES.CONFLICT);
   219→        }
   220→
   221→        // Build skill object
   222→        const skillData: Skill = {
   223→          _ulid: ulid(),
   224→          id: options.id,
   225→          name: options.name,
   226→          description: options.description,
   227→          origin: options.origin as SkillOrigin,
   228→          version: options.skillVersion,
   229→          platforms:
   230→            options.platform && options.platform.length > 0
   231→              ? options.platform
   232→              : ["claude-code"],
   233→          depends_on:
   234→            options.dependsOn && options.dependsOn.length > 0
   235→              ? options.dependsOn
   236→              : [],
   237→          tags:
   238→            options.tag && options.tag.length > 0
   239→              ? parseTagsArray(options.tag)
   240→              : [],
   241→        };
   242→
   243→        // Validate with schema
   244→        const parsed = SkillSchema.safeParse(skillData);
   245→        if (!parsed.success) {
   246→          const issues = parsed.error.issues
   247→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   248→            .join("; ");
   249→          error(`Invalid skill data: ${issues}`);
   250→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   251→        }
   252→
   253→        const skill: LoadedSkill = { ...parsed.data };
   254→
   255→        // AC: @skill-cli ac-3 - save meta entry (also creates directory per ac-4)
   256→        await saveMetaItem(ctx, skill, "skill");
   257→
   258→        // AC: @skill-cli ac-4 - create SKILL.md with placeholder content
   259→        // AC: @skill-add ac-3 - if --content-file provided, copy its contents
   260→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   261→        let initialContent: string;
   262→
   263→        if (options.contentFile) {
   264→          // Read content from the specified file
   265→          const contentFilePath = path.isAbsolute(options.contentFile)
   266→            ? options.contentFile
   267→            : path.resolve(process.cwd(), options.contentFile);
   268→
   269→          try {
   270→            initialContent = await fs.readFile(contentFilePath, "utf-8");
   271→          } catch (err) {
   272→            // Clean up: remove the skill we just created
   273→            await deleteMetaItem(ctx, skill._ulid, "skill");
   274→            error(`Failed to read content file: ${contentFilePath}`);
   275→            process.exit(EXIT_CODES.ERROR);
   276→          }
   277→        } else {
   278→          initialContent = `# ${skill.name}\n\n${skill.description || "Add skill content here."}\n`;
   279→        }
   280→
   281→        await fs.writeFile(skillMdPath, initialContent, "utf-8");
   282→
   283→        // Commit changes
   284→        await commitIfShadow(ctx.shadow, "skill-add", skill.id, skill.name);
   285→
   286→        output(skill, () =>
   287→          success(`Created skill: ${skill.id}`, { skill }),
   288→        );
   289→      } catch (err) {
   290→        error("Failed to create skill", err);
   291→        process.exit(EXIT_CODES.ERROR);
   292→      }
   293→    });
   294→
   295→  // AC: @skill-cli ac-5, ac-6 - kspec skill get
   296→  skill
   297→    .command("get <ref>")
   298→    .description("Show skill details")
   299→    .action(async (ref: string) => {
   300→      try {
   301→        const ctx = await initContext();
   302→
   303→        if (!ctx.manifestPath) {
   304→          error(errors.project.noKspecProject);
   305→          process.exit(EXIT_CODES.ERROR);
   306→        }
   307→
   308→        const metaCtx = await loadMetaContext(ctx);
   309→        const item = findMetaItemByRef(metaCtx, ref);
   310→
   311→        if (!item) {
   312→          error(`Skill not found: ${ref}`);
   313→          console.log(chalk.gray("Try: kspec skill list"));
   314→          process.exit(EXIT_CODES.NOT_FOUND);
   315→        }
   316→
   317→        // Check it's a skill
   318→        if (!("origin" in item)) {
   319→          error(`Item ${ref} is not a skill`);
   320→          process.exit(EXIT_CODES.ERROR);
   321→        }
   322→
   323→        const skill = item as LoadedSkill;
   324→
   325→        // AC: @skill-cli ac-6 - load SKILL.md content
   326→        const content = await loadSkillContent(ctx, skill);
   327→        const docs = await loadSkillDocs(ctx, skill);
   328→
   329→        // AC: @skill-cli ac-5, ac-6 - output metadata and content
   330→        output(
   331→          {
   332→            _ulid: skill._ulid,
   333→            id: skill.id,
   334→            name: skill.name,
   335→            description: skill.description,
   336→            origin: skill.origin,
   337→            version: skill.version,
   338→            platforms: skill.platforms,
   339→            depends_on: skill.depends_on,
   340→            tags: skill.tags,
   341→            content,
   342→            docs: docs.map((d) => ({ name: d.name, path: d.path })),
   343→          },
   344→          () => formatSkillDetails(skill, content),
   345→        );
   346→      } catch (err) {
   347→        error("Failed to get skill", err);
   348→        process.exit(EXIT_CODES.ERROR);
   349→      }
   350→    });
   351→
   352→  // AC: @skill-set ac-1, ac-2, ac-3 - kspec skill set
   353→  markMutating(skill.command("set <ref>"))
   354→    .description("Update skill metadata fields")
   355→    .option("--name <name>", "Update skill name")
   356→    .option("--description <desc>", "Update skill description")
   357→    .option("--origin <origin>", "Update skill origin (core, project, local)")
   358→    .option("--skill-version <version>", "Update skill version")
   359→    .option("--add-platform <platform>", "Add a platform to the platforms array")
   360→    .option("--remove-platform <platform>", "Remove a platform from the platforms array")
   361→    .option("--add-tag <tag>", "Add a tag to the tags array")
   362→    .option("--remove-tag <tag>", "Remove a tag from the tags array")
   363→    .option("--add-depends-on <ref>", "Add a dependency reference")
   364→    .option("--remove-depends-on <ref>", "Remove a dependency reference")
   365→    .action(async (ref: string, options) => {
   366→      try {
   367→        const ctx = await initContext();
   368→
   369→        if (!ctx.manifestPath) {
   370→          error(errors.project.noKspecProject);
   371→          process.exit(EXIT_CODES.ERROR);
   372→        }
   373→
   374→        const metaCtx = await loadMetaContext(ctx);
   375→        const item = findMetaItemByRef(metaCtx, ref);
   376→
   377→        if (!item) {
   378→          error(`Skill not found: ${ref}`);
   379→          console.log(chalk.gray("Try: kspec skill list"));
   380→          process.exit(EXIT_CODES.NOT_FOUND);
   381→        }
   382→
   383→        // Check it's a skill
   384→        if (!("origin" in item)) {
   385→          error(`Item ${ref} is not a skill`);
   386→          process.exit(EXIT_CODES.ERROR);
   387→        }
   388→
   389→        const skill = item as LoadedSkill;
   390→
   391→        // AC: @skill-set ac-1 - update description field
   392→        if (options.name !== undefined) {
   393→          skill.name = options.name;
   394→        }
   395→
   396→        if (options.description !== undefined) {
   397→          skill.description = options.description;
   398→        }
   399→
   400→        // Update origin
   401→        if (options.origin !== undefined) {
   402→          const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   403→          if (!validOrigins.includes(options.origin as SkillOrigin)) {
   404→            error(
   405→              `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   406→            );
   407→            process.exit(EXIT_CODES.ERROR);
   408→          }
   409→          skill.origin = options.origin as SkillOrigin;
   410→        }
   411→
   412→        // Update version
   413→        if (options.skillVersion !== undefined) {
   414→          skill.version = options.skillVersion;
   415→        }
   416→
   417→        // AC: @skill-set ac-2 - add platform to array
   418→        if (options.addPlatform) {
   419→          if (!skill.platforms.includes(options.addPlatform)) {
   420→            skill.platforms.push(options.addPlatform);
   421→          }
   422→        }
   423→
   424→        // Remove platform
   425→        if (options.removePlatform) {
   426→          const idx = skill.platforms.indexOf(options.removePlatform);
   427→          if (idx >= 0) {
   428→            skill.platforms.splice(idx, 1);
   429→          }
   430→        }
   431→
   432→        // AC: @skill-set ac-3 - add tag to array
   433→        if (options.addTag) {
   434→          if (!skill.tags) {
   435→            skill.tags = [];
   436→          }
   437→          if (!skill.tags.includes(options.addTag)) {
   438→            skill.tags.push(options.addTag);
   439→          }
   440→        }
   441→
   442→        // Remove tag
   443→        if (options.removeTag && skill.tags) {
   444→          const idx = skill.tags.indexOf(options.removeTag);
   445→          if (idx >= 0) {
   446→            skill.tags.splice(idx, 1);
   447→          }
   448→        }
   449→
   450→        // Add dependency
   451→        if (options.addDependsOn) {
   452→          if (!skill.depends_on) {
   453→            skill.depends_on = [];
   454→          }
   455→          if (!skill.depends_on.includes(options.addDependsOn)) {
   456→            skill.depends_on.push(options.addDependsOn);
   457→          }
   458→        }
   459→
   460→        // Remove dependency
   461→        if (options.removeDependsOn && skill.depends_on) {
   462→          const idx = skill.depends_on.indexOf(options.removeDependsOn);
   463→          if (idx >= 0) {
   464→            skill.depends_on.splice(idx, 1);
   465→          }
   466→        }
   467→
   468→        // Validate updated skill
   469→        const parsed = SkillSchema.safeParse(skill);
   470→        if (!parsed.success) {
   471→          const issues = parsed.error.issues
   472→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   473→            .join("; ");
   474→          error(`Invalid skill data: ${issues}`);
   475→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   476→        }
   477→
   478→        // Save the updated skill
   479→        await saveMetaItem(ctx, skill, "skill");
   480→
   481→        // Commit changes
   482→        await commitIfShadow(ctx.shadow, "skill-set", skill.id, skill.name);
   483→
   484→        output(skill, () => success(`Updated skill: ${skill.id}`));
   485→      } catch (err) {
   486→        error("Failed to update skill", err);
   487→        process.exit(EXIT_CODES.ERROR);
   488→      }
   489→    });
   490→
   491→  // AC: @skill-cli ac-7, ac-8 - kspec skill delete
   492→  markMutating(skill.command("delete <ref>"))
   493→    .description("Delete a skill")
   494→    .option("--confirm", "Skip confirmation prompt")
   495→    .action(async (ref: string, options) => {
   496→      try {
   497→        const ctx = await initContext();
   498→
   499→        if (!ctx.manifestPath) {
   500→          error(errors.project.noKspecProject);
   501→          process.exit(EXIT_CODES.ERROR);
   502→        }
   503→
   504→        const metaCtx = await loadMetaContext(ctx);
   505→        const item = findMetaItemByRef(metaCtx, ref);
   506→
   507→        if (!item) {
   508→          error(`Skill not found: ${ref}`);
   509→          console.log(chalk.gray("Try: kspec skill list"));
   510→          process.exit(EXIT_CODES.NOT_FOUND);
   511→        }
   512→
   513→        // Check it's a skill
   514→        if (!("origin" in item)) {
   515→          error(`Item ${ref} is not a skill`);
   516→          process.exit(EXIT_CODES.ERROR);
   517→        }
   518→
   519→        const skill = item as LoadedSkill;
   520→
   521→        // Check for confirmation
   522→        if (!options.confirm) {
   523→          error(`Confirm deletion of skill '${skill.id}' with --confirm flag`);
   524→          process.exit(EXIT_CODES.ERROR);
   525→        }
   526→
   527→        // Check for dependencies from other skills
   528→        const dependentSkills = metaCtx.skills.filter(
   529→          (s) =>
   530→            s._ulid !== skill._ulid &&
   531→            s.depends_on?.some(
   532→              (dep) =>
   533→                dep === `@${skill.id}` ||
   534→                dep === skill.id ||
   535→                dep.startsWith(`@${skill._ulid.substring(0, 8)}`),
   536→            ),
   537→        );
   538→
   539→        if (dependentSkills.length > 0) {
   540→          const depRefs = dependentSkills.map((s) => `@${s.id}`).join(", ");
   541→          error(
   542→            `Cannot delete skill '${skill.id}': referenced by ${dependentSkills.length} skill(s): ${depRefs}`,
   543→          );
   544→          process.exit(EXIT_CODES.ERROR);
   545→        }
   546→
   547→        // AC: @skill-cli ac-7, ac-8 - delete meta entry and directory
   548→        const deleted = await deleteMetaItem(ctx, skill._ulid, "skill");
   549→
   550→        if (!deleted) {
   551→          error(`Failed to delete skill: ${skill.id}`);
   552→          process.exit(EXIT_CODES.ERROR);
   553→        }
   554→
   555→        // Commit changes
   556→        await commitIfShadow(ctx.shadow, "skill-delete", skill.id);
   557→
   558→        success(`Deleted skill: ${skill.id}`);
   559→      } catch (err) {
   560→        error("Failed to delete skill", err);
   561→        process.exit(EXIT_CODES.ERROR);
   562→      }
   563→    });
   564→
   565→  // AC: @skill-import ac-1 through ac-7 - kspec skill import
   566→  markMutating(skill.command("import <file>"))
   567→    .description("Import an existing SKILL.md file into kspec")
   568→    .option("--id <id>", "Custom skill ID (defaults to directory name)")
   569→    .option("--name <name>", "Skill name (required if no frontmatter)")
   570→    .option("--description <desc>", "Skill description (required if no frontmatter)")
   571→    .option(
   572→      "--origin <origin>",
   573→      "Skill origin (core, project, local)",
   574→      "project",
   575→    )
   576→    .option("--skill-version <version>", "Skill version")
   577→    .action(async (file: string, options) => {
   578→      try {
   579→        const ctx = await initContext();
   580→
   581→        if (!ctx.manifestPath) {
   582→          error(errors.project.noKspecProject);
   583→          process.exit(EXIT_CODES.ERROR);
   584→        }
   585→
   586→        // Resolve file path
   587→        const filePath = path.isAbsolute(file)
   588→          ? file
   589→          : path.resolve(process.cwd(), file);
   590→
   591→        // Check file exists
   592→        try {
   593→          await fs.access(filePath);
   594→        } catch {
   595→          error(`File not found: ${filePath}`);
   596→          process.exit(EXIT_CODES.NOT_FOUND);
   597→        }
   598→
   599→        // Read file content
   600→        const content = await fs.readFile(filePath, "utf-8");
   601→
   602→        // AC: @skill-import ac-1, ac-6 - Parse YAML frontmatter
   603→        const frontmatter = parseFrontmatter(content);
   604→
   605→        // Determine name and description from frontmatter or options
   606→        const skillName = options.name || frontmatter?.name;
   607→        const skillDescription = options.description || frontmatter?.description;
   608→
   609→        // AC: @skill-import ac-6 - Error if no name/description and no frontmatter
   610→        if (!skillName) {
   611→          error("Name is required. Either add YAML frontmatter with 'name' field or use --name option.");
   612→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   613→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   614→        }
   615→
   616→        if (!skillDescription) {
   617→          error("Description is required. Either add YAML frontmatter with 'description' field or use --description option.");
   618→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   619→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   620→        }
   621→
   622→        // AC: @skill-import ac-5 - Derive ID from directory name or use custom
   623→        const sourceDir = path.dirname(filePath);
   624→        const derivedId = path.basename(sourceDir);
   625→        const skillId = options.id || derivedId;
   626→
   627→        // Validate origin
   628→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   629→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   630→          error(
   631→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   632→          );
   633→          process.exit(EXIT_CODES.ERROR);
   634→        }
   635→
   636→        // Check if skill with this ID already exists
   637→        const metaCtx = await loadMetaContext(ctx);
   638→        const existingSkill = metaCtx.skills.find((s) => s.id === skillId);
   639→        if (existingSkill) {
   640→          error(`Skill with ID '${skillId}' already exists. Use --id to specify a different ID.`);
   641→          process.exit(EXIT_CODES.CONFLICT);
   642→        }
   643→
   644→        // Build skill object
   645→        const skillData: Skill = {
   646→          _ulid: ulid(),
   647→          id: skillId,
   648→          name: skillName,
   649→          description: skillDescription,
   650→          origin: options.origin as SkillOrigin,
   651→          version: options.skillVersion,
   652→          platforms: ["claude-code"],
   653→          depends_on: [],
   654→          tags: [],
   655→        };
   656→
   657→        // Validate with schema
   658→        const parsed = SkillSchema.safeParse(skillData);
   659→        if (!parsed.success) {
   660→          const issues = parsed.error.issues
   661→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   662→            .join("; ");
   663→          error(`Invalid skill data: ${issues}`);
   664→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   665→        }
   666→
   667→        const skill: LoadedSkill = { ...parsed.data };
   668→
   669→        // Save meta entry (also creates directory)
   670→        await saveMetaItem(ctx, skill, "skill");
   671→
   672→        // AC: @skill-import ac-7 - Strip/normalize base-directory paths
   673→        const normalizedContent = normalizeBaseDirectory(content);
   674→
   675→        // AC: @skill-import ac-2 - Copy content to .kspec/skills/<id>/SKILL.md
   676→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   677→        await fs.writeFile(skillMdPath, normalizedContent, "utf-8");
   678→
   679→        // AC: @skill-import ac-3 - Copy docs/ subdirectory if present
   680→        const sourceDocsDir = path.join(sourceDir, "docs");
   681→        try {
   682→          const docsStats = await fs.stat(sourceDocsDir);
   683→          if (docsStats.isDirectory()) {
   684→            const targetDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
   685→            await fs.mkdir(targetDocsDir, { recursive: true });
   686→            await copyDirectory(sourceDocsDir, targetDocsDir);
   687→          }
   688→        } catch {
   689→          // No docs directory, that's fine
   690→        }
   691→
   692→        // Commit changes
   693→        await commitIfShadow(ctx.shadow, "skill-import", skill.id, skill.name);
   694→
   695→        output(skill, () =>
   696→          success(`Imported skill: ${skill.id}`, { skill }),
   697→        );
   698→      } catch (err) {
   699→        error("Failed to import skill", err);
   700→        process.exit(EXIT_CODES.ERROR);
   701→      }
   702→    });
   703→
   704→  // AC: @skill-rendering ac-1 through ac-5 - kspec skill render
   705→  // AC: @skill-render-cli ac-1, ac-2 - kspec skill render / kspec skill render @skill-id
   706→  // AC: @trait-dry-run - supports --dry-run
   707→  // AC: @trait-error-guidance - provides error guidance
   708→  skill
   709→    .command("render [ref]")
   710→    .description(
   711→      "Render skills from shadow branch to platform-specific files on main branch"
   712→    )
   713→    .option("--clean", "Remove orphaned managed skill directories")
   714→    .option("--dry-run", "Show what would be changed without applying")
   715→    .option("--skill <id>", "Render only a specific skill (deprecated, use positional arg)")
   716→    .action(async (ref: string | undefined, options) => {
   717→      try {
   718→        const ctx = await initContext();
   719→
   720→        if (!ctx.manifestPath) {
   721→          error(errors.project.noKspecProject);
   722→          console.log(
   723→            chalk.gray("Try: kspec init to initialize a kspec project")
   724→          );
   725→          process.exit(EXIT_CODES.ERROR);
   726→        }
   727→
   728→        const metaCtx = await loadMetaContext(ctx);
   729→        // Use rootDir (project root), not specDir (which is .kspec/ in shadow mode)
   730→        const projectRoot = ctx.rootDir;
   731→        const dryRun = options.dryRun || false;
   732→        const results: SkillRenderResult[] = [];
   733→        const cleanResults: CleanResult[] = [];
   734→
   735→        // Filter skills by platform (only claude-code for now)
   736→        let skillsToRender = metaCtx.skills.filter((s) =>
   737→          s.platforms.includes("claude-code")
   738→        );
   739→
   740→        // AC: @skill-render-cli ac-2 - Filter to specific skill if requested
   741→        // Support both positional ref argument and --skill option
   742→        const skillRef = ref || options.skill;
   743→        if (skillRef) {
   744→          // Resolve the ref to a skill
   745→          const item = findMetaItemByRef(metaCtx, skillRef);
   746→          if (!item || !("origin" in item)) {
   747→            error(`Skill not found: ${skillRef}`);
   748→            console.log(chalk.gray("Try: kspec skill list"));
   749→            process.exit(EXIT_CODES.NOT_FOUND);
   750→          }
   751→          const skill = item as LoadedSkill;
   752→          skillsToRender = skillsToRender.filter((s) => s.id === skill.id);
   753→          if (skillsToRender.length === 0) {
   754→            error(`Skill '${skill.id}' does not have claude-code platform`);
   755→            process.exit(EXIT_CODES.ERROR);
   756→          }
   757→        }
   758→
   759→        // Ensure .claude/skills directory exists
   760→        const targetSkillsDir = path.join(projectRoot, ".claude", "skills");
   761→        if (!dryRun) {
   762→          await fs.mkdir(targetSkillsDir, { recursive: true });
   763→        }
   764→
   765→        // Render each skill
   766→        for (const skill of skillsToRender) {
   767→          const result = await renderSkill(ctx, projectRoot, skill, dryRun);
   768→          results.push(result);
   769→        }
   770→
   771→        // Handle --clean: remove orphaned managed skills
   772→        // AC: @skill-rendering ac-4, ac-5
   773→        if (options.clean) {
   774→          const activeSkillIds = new Set(metaCtx.skills.map((s) => s.id));
   775→
   776→          try {
   777→            const entries = await fs.readdir(targetSkillsDir, {
   778→              withFileTypes: true,
   779→            });
   780→
   781→            for (const entry of entries) {
   782→              if (!entry.isDirectory()) continue;
   783→
   784→              const skillId = entry.name;
   785→              const skillDir = path.join(targetSkillsDir, skillId);
   786→              const skillMdPath = path.join(skillDir, "SKILL.md");
   787→
   788→              // Skip if skill still exists in meta
   789→              if (activeSkillIds.has(skillId)) continue;
   790→
   791→              // AC: @skill-rendering ac-4 - Only consider kspec-managed skills
   792→              const isManaged = await isKspecManaged(skillMdPath);
   793→
   794→              if (isManaged) {
   795→                // AC: @skill-rendering ac-5 - Remove orphaned directory
   796→                if (!dryRun) {
   797→                  await fs.rm(skillDir, { recursive: true, force: true });
   798→                }
   799→                cleanResults.push({
   800→                  id: skillId,
   801→                  path: skillDir,
   802→                  action: "removed",
   803→                });
   804→              } else {
   805→                cleanResults.push({
   806→                  id: skillId,
   807→                  path: skillDir,
   808→                  action: "skipped",
   809→                  reason: "Not managed by kspec",
   810→                });
   811→              }
   812→            }
   813→          } catch {
   814→            // No .claude/skills directory, nothing to clean
   815→          }
   816→        }
   817→
   818→        // Output results
   819→        // AC: @trait-dry-run ac-6 - JSON output includes dry_run field
   820→        output(
   821→          {
   822→            dry_run: dryRun,
   823→            rendered: results,
   824→            cleaned: cleanResults,
   825→          },
   826→          () => {
   827→            // AC: @trait-dry-run ac-3 - Clear indication this is a preview
   828→            if (dryRun) {
   829→              console.log(chalk.yellow("DRY RUN - No changes made"));
   830→              console.log();
   831→            }
   832→
   833→            // Render results
   834→            const created = results.filter((r) => r.action === "created");
   835→            const updated = results.filter((r) => r.action === "updated");
   836→            const unchanged = results.filter((r) => r.action === "unchanged");
   837→
   838→            if (created.length > 0) {
   839→              console.log(chalk.green(`Created: ${created.length} skill(s)`));
   840→              for (const r of created) {
   841→                console.log(`  ${chalk.green("+")} ${r.id}`);
   842→              }
   843→            }
   844→
   845→            if (updated.length > 0) {
   846→              console.log(chalk.blue(`Updated: ${updated.length} skill(s)`));
   847→              for (const r of updated) {
   848→                console.log(`  ${chalk.blue("~")} ${r.id}`);
   849→              }
   850→            }
   851→
   852→            if (unchanged.length > 0 && results.length <= 10) {
   853→              console.log(chalk.gray(`Unchanged: ${unchanged.length} skill(s)`));
   854→            }
   855→
   856→            // Clean results
   857→            if (cleanResults.length > 0) {
   858→              const removed = cleanResults.filter((r) => r.action === "removed");
   859→              const skipped = cleanResults.filter((r) => r.action === "skipped");
   860→
   861→              if (removed.length > 0) {
   862→                console.log();
   863→                console.log(chalk.red(`Removed: ${removed.length} orphaned skill(s)`));
   864→                for (const r of removed) {
   865→                  console.log(`  ${chalk.red("-")} ${r.id}`);
   866→                }
   867→              }
   868→
   869→              if (skipped.length > 0) {
   870→                console.log(
   871→                  chalk.gray(`Skipped: ${skipped.length} unmanaged skill(s)`)
   872→                );
   873→              }
   874→            }
   875→
   876→            // Summary
   877→            console.log();
   878→            if (dryRun) {
   879→              console.log(
   880→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
   881→              );
   882→            } else {
   883→              const changedCount = created.length + updated.length;
   884→              const cleanedCount = cleanResults.filter(
   885→                (r) => r.action === "removed"
   886→              ).length;
   887→              if (changedCount > 0 || cleanedCount > 0) {
   888→                success(
   889→                  `Rendered ${changedCount} skill(s)${cleanedCount > 0 ? `, cleaned ${cleanedCount}` : ""}`
   890→                );
   891→              } else {
   892→                console.log(chalk.gray("No changes needed"));
   893→              }
   894→            }
   895→          }
   896→        );
   897→      } catch (err) {
   898→        error("Failed to render skills", err);
   899→        process.exit(EXIT_CODES.ERROR);
   900→      }
   901→    });
   902→
   903→  // AC: @skill-render-cli ac-3 - kspec skill status
   904→  skill
   905→    .command("status")
   906→    .description("Show sync status of rendered skills")
   907→    .action(async () => {
   908→      try {
   909→        const ctx = await initContext();
   910→
   911→        if (!ctx.manifestPath) {
   912→          error(errors.project.noKspecProject);
   913→          console.log(
   914→            chalk.gray("Try: kspec init to initialize a kspec project")
   915→          );
   916→          process.exit(EXIT_CODES.ERROR);
   917→        }
   918→
   919→        const metaCtx = await loadMetaContext(ctx);
   920→        const projectRoot = ctx.rootDir;
   921→
   922→        // Filter skills by platform (only claude-code for now)
   923→        const skillsToCheck = metaCtx.skills.filter((s) =>
   924→          s.platforms.includes("claude-code")
   925→        );
   926→
   927→        if (skillsToCheck.length === 0) {
   928→          console.log(chalk.yellow("No skills found"));
   929→          return;
   930→        }
   931→
   932→        const statusResults: SkillStatusResult[] = [];
   933→
   934→        for (const skill of skillsToCheck) {
   935→          const status = await getSkillSyncStatus(ctx, projectRoot, skill);
   936→          statusResults.push(status);
   937→        }
   938→
   939→        // Output results
   940→        output(
   941→          statusResults,
   942→          () => {
   943→            const table = new Table({
   944→              head: [
   945→                chalk.bold("ID"),
   946→                chalk.bold("Status"),
   947→                chalk.bold("Docs"),
   948→              ],
   949→              style: {
   950→                head: [],
   951→                border: [],
   952→              },
   953→            });
   954→
   955→            for (const result of statusResults) {
   956→              const statusColor =
   957→                result.status === "in-sync"
   958→                  ? chalk.green
   959→                  : result.status === "drifted"
   960→                    ? chalk.yellow
   961→                    : chalk.gray;
   962→
   963→              const docsStatusColor =
   964→                result.docsStatus === "in-sync"
   965→                  ? chalk.green
   966→                  : result.docsStatus === "drifted"
   967→                    ? chalk.yellow
   968→                    : chalk.gray;
   969→
   970→              table.push([
   971→                result.id,
   972→                statusColor(result.status),
   973→                docsStatusColor(result.docsStatus || "-"),
   974→              ]);
   975→            }
   976→
   977→            console.log(table.toString());
   978→
   979→            // Summary
   980→            const inSync = statusResults.filter((r) => r.status === "in-sync").length;
   981→            const drifted = statusResults.filter((r) => r.status === "drifted").length;
   982→            const notRendered = statusResults.filter((r) => r.status === "not-rendered").length;
   983→
   984→            console.log();
   985→            if (drifted > 0) {
   986→              console.log(chalk.yellow(`${drifted} skill(s) drifted - run 'kspec skill render' to sync`));
   987→            }
   988→            if (notRendered > 0) {
   989→              console.log(chalk.gray(`${notRendered} skill(s) not rendered`));
   990→            }
   991→            if (inSync === statusResults.length) {
   992→              console.log(chalk.green("All skills in sync"));
   993→            }
   994→          }
   995→        );
   996→      } catch (err) {
   997→        error("Failed to check skill status", err);
   998→        process.exit(EXIT_CODES.ERROR);
   999→      }
  1000→    });
  1001→
  1002→  // AC: @skill-render-cli ac-4 - kspec skill diff
  1003→  skill
  1004→    .command("diff <ref>")
  1005→    .description("Show diff between source and rendered skill")
  1006→    .action(async (ref: string) => {
  1007→      try {
  1008→        const ctx = await initContext();
  1009→
  1010→        if (!ctx.manifestPath) {
  1011→          error(errors.project.noKspecProject);
  1012→          console.log(
  1013→            chalk.gray("Try: kspec init to initialize a kspec project")
  1014→          );
  1015→          process.exit(EXIT_CODES.ERROR);
  1016→        }
  1017→
  1018→        const metaCtx = await loadMetaContext(ctx);
  1019→        const item = findMetaItemByRef(metaCtx, ref);
  1020→
  1021→        if (!item) {
  1022→          error(`Skill not found: ${ref}`);
  1023→          console.log(chalk.gray("Try: kspec skill list"));
  1024→          process.exit(EXIT_CODES.NOT_FOUND);
  1025→        }
  1026→
  1027→        // Check it's a skill
  1028→        if (!("origin" in item)) {
  1029→          error(`Item ${ref} is not a skill`);
  1030→          process.exit(EXIT_CODES.ERROR);
  1031→        }
  1032→
  1033→        const skill = item as LoadedSkill;
  1034→        const projectRoot = ctx.rootDir;
  1035→
  1036→        // Get expected rendered content
  1037→        const expectedContent = await getExpectedRenderedContent(ctx, skill);
  1038→
  1039→        // Get actual rendered content
  1040→        const renderedPath = path.join(
  1041→          projectRoot,
  1042→          ".claude",
  1043→          "skills",
  1044→          skill.id,
  1045→          "SKILL.md"
  1046→        );
  1047→
  1048→        let actualContent = "";
  1049→        try {
  1050→          actualContent = await fs.readFile(renderedPath, "utf-8");
  1051→        } catch {
  1052→          // File doesn't exist
  1053→        }
  1054→
  1055→        // Generate diff
  1056→        const diff = generateUnifiedDiff(
  1057→          actualContent,
  1058→          expectedContent,
  1059→          `a/${skill.id}/SKILL.md`,
  1060→          `b/${skill.id}/SKILL.md`
  1061→        );
  1062→
  1063→        // Output
  1064→        output(
  1065→          {
  1066→            id: skill.id,
  1067→            hasDiff: diff.length > 0,
  1068→            diff,
  1069→          },
  1070→          () => {
  1071→            if (diff.length === 0) {
  1072→              console.log(chalk.green(`${skill.id}: in sync`));
  1073→            } else {
  1074→              console.log(chalk.yellow(`${skill.id}: drifted`));
  1075→              console.log();
  1076→              // Print colored diff
  1077→              for (const line of diff) {
  1078→                if (line.startsWith("+") && !line.startsWith("+++")) {
  1079→                  console.log(chalk.green(line));
  1080→                } else if (line.startsWith("-") && !line.startsWith("---")) {
  1081→                  console.log(chalk.red(line));
  1082→                } else if (line.startsWith("@@")) {
  1083→                  console.log(chalk.cyan(line));
  1084→                } else {
  1085→                  console.log(line);
  1086→                }
  1087→              }
  1088→            }
  1089→          }
  1090→        );
  1091→      } catch (err) {
  1092→        error("Failed to generate diff", err);
  1093→        process.exit(EXIT_CODES.ERROR);
  1094→      }
  1095→    });
  1096→}
  1097→
  1098→/**
  1099→ * Parse YAML frontmatter from markdown content.
  1100→ * Returns null if no valid frontmatter found.
  1101→ */
  1102→function parseFrontmatter(content: string): { name?: string; description?: string } | null {
  1103→  const frontmatterRegex = /^---\n([\s\S]*?)\n---/;
  1104→  const match = content.match(frontmatterRegex);
  1105→
  1106→  if (!match) {
  1107→    return null;
  1108→  }
  1109→
  1110→  try {
  1111→    const parsed = yaml.parse(match[1]);
  1112→
  1113→    if (typeof parsed === "object" && parsed !== null) {
  1114→      return {
  1115→        name: typeof parsed.name === "string" ? parsed.name : undefined,
  1116→        description: typeof parsed.description === "string" ? parsed.description : undefined,
  1117→      };
  1118→    }
  1119→  } catch {
  1120→    // Invalid YAML in frontmatter
  1121→  }
  1122→
  1123→  return null;
  1124→}
  1125→
  1126→/**
  1127→ * Normalize base-directory paths in skill content.
  1128→ * AC: @skill-import ac-7 - Strip or convert absolute paths to relative.
  1129→ *
  1130→ * Matches patterns like:
  1131→ * - "Base directory for this skill: /absolute/path/to/skill"
  1132→ * - Lines starting with hardcoded paths
  1133→ */
  1134→function normalizeBaseDirectory(content: string): string {
  1135→  // Remove or normalize "Base directory for this skill:" lines with absolute paths
  1136→  // Common pattern in Claude-generated skill files
  1137→  const baseDirLineRegex = /^Base directory for this skill:.*$/gm;
  1138→
  1139→  return content.replace(baseDirLineRegex, "");
  1140→}
  1141→
  1142→/**
  1143→ * Recursively copy a directory
  1144→ */
  1145→async function copyDirectory(src: string, dest: string): Promise<void> {
  1146→  const entries = await fs.readdir(src, { withFileTypes: true });
  1147→
  1148→  for (const entry of entries) {
  1149→    const srcPath = path.join(src, entry.name);
  1150→    const destPath = path.join(dest, entry.name);
  1151→
  1152→    if (entry.isDirectory()) {
  1153→      await fs.mkdir(destPath, { recursive: true });
  1154→      await copyDirectory(srcPath, destPath);
  1155→    } else {
  1156→      await fs.copyFile(srcPath, destPath);
  1157→    }
  1158→  }
  1159→}
  1160→
  1161→/**
  1162→ * Marker comment that identifies skill directories managed by kspec
  1163→ * AC: @skill-rendering ac-4 - Only skill directories that were rendered by kspec are considered
  1164→ */
  1165→const KSPEC_MANAGED_MARKER = "<!-- kspec-managed -->";
  1166→
  1167→/**
  1168→ * Result of rendering a single skill
  1169→ */
  1170→interface SkillRenderResult {
  1171→  id: string;
  1172→  action: "created" | "updated" | "unchanged";
  1173→  path: string;
  1174→  docsAction?: "created" | "updated" | "unchanged" | "skipped";
  1175→}
  1176→
  1177→/**
  1178→ * Result of a clean operation
  1179→ */
  1180→interface CleanResult {
  1181→  id: string;
  1182→  path: string;
  1183→  action: "removed" | "skipped";
  1184→  reason?: string;
  1185→}
  1186→
  1187→/**
  1188→ * Generate YAML frontmatter for a skill
  1189→ * AC: @skill-rendering ac-1 - .claude/skills/<id>/SKILL.md is created with YAML frontmatter
  1190→ */
  1191→function generateFrontmatter(skill: LoadedSkill): string {
  1192→  const frontmatter: Record<string, unknown> = {
  1193→    name: skill.id,
  1194→    description: skill.description || skill.name,
  1195→  };
  1196→  return `---\n${yaml.stringify(frontmatter).trim()}\n---`;
  1197→}
  1198→
  1199→/**
  1200→ * Check if two contents are equal (for idempotency check)
  1201→ */
  1202→function contentsEqual(a: string, b: string): boolean {
  1203→  return a.trim() === b.trim();
  1204→}
  1205→
  1206→/**
  1207→ * Check if a directory is managed by kspec
  1208→ * AC: @skill-rendering ac-4 - Only skill directories rendered by kspec are considered
  1209→ */
  1210→async function isKspecManaged(skillMdPath: string): Promise<boolean> {
  1211→  try {
  1212→    const content = await fs.readFile(skillMdPath, "utf-8");
  1213→    return content.includes(KSPEC_MANAGED_MARKER);
  1214→  } catch {
  1215→    return false;
  1216→  }
  1217→}
  1218→
  1219→/**
  1220→ * Recursively check if two directories have the same contents
  1221→ */
  1222→async function directoriesEqual(src: string, dest: string): Promise<boolean> {
  1223→  try {
  1224→    const srcEntries = await fs.readdir(src, { withFileTypes: true });
  1225→    const destEntries = await fs.readdir(dest, { withFileTypes: true });
  1226→
  1227→    // Different number of entries = not equal
  1228→    if (srcEntries.length !== destEntries.length) {
  1229→      return false;
  1230→    }
  1231→
  1232→    // Create a map of dest entries for quick lookup
  1233→    const destMap = new Map(destEntries.map((e) => [e.name, e]));
  1234→
  1235→    for (const srcEntry of srcEntries) {
  1236→      const destEntry = destMap.get(srcEntry.name);
  1237→      if (!destEntry) {
  1238→        return false;
  1239→      }
  1240→
  1241→      const srcPath = path.join(src, srcEntry.name);
  1242→      const destPath = path.join(dest, srcEntry.name);
  1243→
  1244→      if (srcEntry.isDirectory() && destEntry.isDirectory()) {
  1245→        if (!(await directoriesEqual(srcPath, destPath))) {
  1246→          return false;
  1247→        }
  1248→      } else if (srcEntry.isFile() && destEntry.isFile()) {
  1249→        const srcContent = await fs.readFile(srcPath, "utf-8");
  1250→        const destContent = await fs.readFile(destPath, "utf-8");
  1251→        if (!contentsEqual(srcContent, destContent)) {
  1252→          return false;
  1253→        }
  1254→      } else {
  1255→        // Type mismatch
  1256→        return false;
  1257→      }
  1258→    }
  1259→
  1260→    return true;
  1261→  } catch {
  1262→    return false;
  1263→  }
  1264→}
  1265→
  1266→/**
  1267→ * Get the target path for rendered skills (main branch .claude/skills/)
  1268→ */
  1269→function getRenderedSkillPath(projectRoot: string, skillId: string): string {
  1270→  return path.join(projectRoot, ".claude", "skills", skillId);
  1271→}
  1272→
  1273→/**
  1274→ * Render a single skill from shadow branch to main branch.
  1275→ * AC: @skill-rendering ac-1 - Creates .claude/skills/<id>/SKILL.md with YAML frontmatter
  1276→ * AC: @skill-rendering ac-2 - Copies docs to .claude/skills/<id>/docs/
  1277→ * AC: @skill-rendering ac-3 - Idempotent (no changes if content unchanged)
  1278→ */
  1279→async function renderSkill(
  1280→  ctx: KspecContext,
  1281→  projectRoot: string,
  1282→  skill: LoadedSkill,
  1283→  dryRun: boolean
  1284→): Promise<SkillRenderResult> {
  1285→  const targetDir = getRenderedSkillPath(projectRoot, skill.id);
  1286→  const targetSkillMd = path.join(targetDir, "SKILL.md");
  1287→
  1288→  // Load source content
  1289→  const sourceContent = await loadSkillContent(ctx, skill);
  1290→  if (!sourceContent) {
  1291→    // No source content, but skill exists in meta - create placeholder
  1292→    const frontmatter = generateFrontmatter(skill);
  1293→    const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
  1294→
  1295→    if (!dryRun) {
  1296→      await fs.mkdir(targetDir, { recursive: true });
  1297→      await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
  1298→    }
  1299→
  1300→    return {
  1301→      id: skill.id,
  1302→      action: "created",
  1303→      path: targetSkillMd,
  1304→    };
  1305→  }
  1306→
  1307→  // Generate rendered content with frontmatter and marker
  1308→  const frontmatter = generateFrontmatter(skill);
  1309→
  1310→  // Check if source already has frontmatter - if so, strip it
  1311→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
  1312→  const contentWithoutFrontmatter = frontmatterMatch
  1313→    ? sourceContent.slice(frontmatterMatch[0].length)
  1314→    : sourceContent;
  1315→
  1316→  // Build the rendered content
  1317→  const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
  1318→
  1319→  // Check if target exists and compare for idempotency
  1320→  // AC: @skill-rendering ac-3 - No changes if content unchanged
  1321→  let targetExists = false;
  1322→  let targetContent = "";
  1323→  try {
  1324→    targetContent = await fs.readFile(targetSkillMd, "utf-8");
  1325→    targetExists = true;
  1326→  } catch {
  1327→    // Target doesn't exist
  1328→  }
  1329→
  1330→  // Determine action based on comparison
  1331→  let action: "created" | "updated" | "unchanged";
  1332→
  1333→  if (!targetExists) {
  1334→    action = "created";
  1335→  } else if (contentsEqual(renderedContent, targetContent)) {
  1336→    action = "unchanged";
  1337→  } else {
  1338→    action = "updated";
  1339→  }
  1340→
  1341→  // Apply changes if not dry run and there are changes
  1342→  if (!dryRun && action !== "unchanged") {
  1343→    await fs.mkdir(targetDir, { recursive: true });
  1344→    await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
  1345→  }
  1346→
  1347→  // Handle docs directory
  1348→  // AC: @skill-rendering ac-2 - Copy docs to target
  1349→  const sourceDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
  1350→  const targetDocsDir = path.join(targetDir, "docs");
  1351→  let docsAction: "created" | "updated" | "unchanged" | "skipped" = "skipped";
  1352→
  1353→  try {
  1354→    const stats = await fs.stat(sourceDocsDir);
  1355→    if (stats.isDirectory()) {
  1356→      // Check if target docs exist and compare
  1357→      let targetDocsExist = false;
  1358→      try {
  1359→        await fs.stat(targetDocsDir);
  1360→        targetDocsExist = true;
  1361→      } catch {
  1362→        // Target docs don't exist
  1363→      }
  1364→
  1365→      if (!targetDocsExist) {
  1366→        docsAction = "created";
  1367→      } else {
  1368→        // Compare directories
  1369→        const equal = await directoriesEqual(sourceDocsDir, targetDocsDir);
  1370→        docsAction = equal ? "unchanged" : "updated";
  1371→      }
  1372→
  1373→      // Apply changes
  1374→      if (!dryRun && docsAction !== "unchanged") {
  1375→        // Remove existing docs and copy fresh
  1376→        if (targetDocsExist) {
  1377→          await fs.rm(targetDocsDir, { recursive: true, force: true });
  1378→        }
  1379→        await fs.mkdir(targetDocsDir, { recursive: true });
  1380→        await copyDirectory(sourceDocsDir, targetDocsDir);
  1381→      }
  1382→    }
  1383→  } catch {
  1384→    // No source docs directory
  1385→  }
  1386→
  1387→  return {
  1388→    id: skill.id,
  1389→    action,
  1390→    path: targetSkillMd,
  1391→    docsAction,
  1392→  };
  1393→}
  1394→
  1395→/**
  1396→ * Result of checking a skill's sync status
  1397→ * AC: @skill-render-cli ac-3
  1398→ */
  1399→interface SkillStatusResult {
  1400→  id: string;
  1401→  status: "in-sync" | "drifted" | "not-rendered";
  1402→  docsStatus?: "in-sync" | "drifted" | "not-rendered" | "no-docs";
  1403→}
  1404→
  1405→/**
  1406→ * Get the sync status of a skill
  1407→ * AC: @skill-render-cli ac-3
  1408→ */
  1409→async function getSkillSyncStatus(
  1410→  ctx: KspecContext,
  1411→  projectRoot: string,
  1412→  skill: LoadedSkill
  1413→): Promise<SkillStatusResult> {
  1414→  const expectedContent = await getExpectedRenderedContent(ctx, skill);
  1415→  const renderedPath = path.join(
  1416→    projectRoot,
  1417→    ".claude",
  1418→    "skills",
  1419→    skill.id,
  1420→    "SKILL.md"
  1421→  );
  1422→
  1423→  let actualContent = "";
  1424→  let status: "in-sync" | "drifted" | "not-rendered" = "not-rendered";
  1425→
  1426→  try {
  1427→    actualContent = await fs.readFile(renderedPath, "utf-8");
  1428→    status = contentsEqual(expectedContent, actualContent) ? "in-sync" : "drifted";
  1429→  } catch {
  1430→    // File doesn't exist
  1431→    status = "not-rendered";
  1432→  }
  1433→
  1434→  // Check docs status
  1435→  const sourceDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
  1436→  const targetDocsDir = path.join(projectRoot, ".claude", "skills", skill.id, "docs");
  1437→  let docsStatus: "in-sync" | "drifted" | "not-rendered" | "no-docs" = "no-docs";
  1438→
  1439→  try {
  1440→    await fs.stat(sourceDocsDir);
  1441→    // Source docs exist, check target
  1442→    try {
  1443→      await fs.stat(targetDocsDir);
  1444→      // Both exist, compare
  1445→      const equal = await directoriesEqual(sourceDocsDir, targetDocsDir);
  1446→      docsStatus = equal ? "in-sync" : "drifted";
  1447→    } catch {
  1448→      docsStatus = "not-rendered";
  1449→    }
  1450→  } catch {
  1451→    // No source docs
  1452→    docsStatus = "no-docs";
  1453→  }
  1454→
  1455→  return {
  1456→    id: skill.id,
  1457→    status,
  1458→    docsStatus,
  1459→  };
  1460→}
  1461→
  1462→/**
  1463→ * Get the expected rendered content for a skill
  1464→ */
  1465→async function getExpectedRenderedContent(
  1466→  ctx: KspecContext,
  1467→  skill: LoadedSkill
  1468→): Promise<string> {
  1469→  const sourceContent = await loadSkillContent(ctx, skill);
  1470→
  1471→  if (!sourceContent) {
  1472→    // No source content, generate placeholder
  1473→    const frontmatter = generateFrontmatter(skill);
  1474→    return `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
  1475→  }
  1476→
  1477→  // Generate rendered content with frontmatter and marker
  1478→  const frontmatter = generateFrontmatter(skill);
  1479→
  1480→  // Check if source already has frontmatter - if so, strip it
  1481→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
  1482→  const contentWithoutFrontmatter = frontmatterMatch
  1483→    ? sourceContent.slice(frontmatterMatch[0].length)
  1484→    : sourceContent;
  1485→
  1486→  return `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
  1487→}
  1488→
  1489→/**
  1490→ * Generate unified diff between two strings
  1491→ * AC: @skill-render-cli ac-4
  1492→ */
  1493→function generateUnifiedDiff(
  1494→  actual: string,
  1495→  expected: string,
  1496→  actualPath: string,
  1497→  expectedPath: string
  1498→): string[] {
  1499→  if (contentsEqual(actual, expected)) {
  1500→    return [];
  1501→  }
  1502→
  1503→  const actualLines = actual.split("\n");
  1504→  const expectedLines = expected.split("\n");
  1505→  const diffLines: string[] = [];
  1506→
  1507→  // Simple line-by-line diff (unified format)
  1508→  diffLines.push(`--- ${actualPath}`);
  1509→  diffLines.push(`+++ ${expectedPath}`);
  1510→
  1511→  // Find differing sections and create hunks
  1512→  let i = 0;
  1513→  let j = 0;
  1514→
  1515→  while (i < actualLines.length || j < expectedLines.length) {
  1516→    // Find start of difference
  1517→    const contextStart = i;
  1518→    const contextStartExpected = j;
  1519→
  1520→    // Skip matching lines
  1521→    while (
  1522→      i < actualLines.length &&
  1523→      j < expectedLines.length &&
  1524→      actualLines[i] === expectedLines[j]
  1525→    ) {
  1526→      i++;
  1527→      j++;
  1528→    }
  1529→
  1530→    // If we've reached the end, we're done
  1531→    if (i >= actualLines.length && j >= expectedLines.length) {
  1532→      break;
  1533→    }
  1534→
  1535→    // Find end of difference
  1536→    let diffEndActual = i;
  1537→    let diffEndExpected = j;
  1538→
  1539→    // Collect differing lines
  1540→    while (
  1541→      diffEndActual < actualLines.length &&
  1542→      diffEndExpected < expectedLines.length &&
  1543→      actualLines[diffEndActual] !== expectedLines[diffEndExpected]
  1544→    ) {
  1545→      diffEndActual++;
  1546→      diffEndExpected++;
  1547→    }
  1548→
  1549→    // Also handle case where one side has more lines
  1550→    while (diffEndActual < actualLines.length && diffEndExpected >= expectedLines.length) {
  1551→      diffEndActual++;
  1552→    }
  1553→    while (diffEndExpected < expectedLines.length && diffEndActual >= actualLines.length) {
  1554→      diffEndExpected++;
  1555→    }
  1556→
  1557→    // Create hunk header (show 3 lines of context)
  1558→    const hunkStartActual = Math.max(0, contextStart - 3);
  1559→    const hunkStartExpected = Math.max(0, contextStartExpected - 3);
  1560→
  1561→    // Include context after diff too
  1562→    const hunkEndActual = Math.min(actualLines.length, diffEndActual + 3);
  1563→    const hunkEndExpected = Math.min(expectedLines.length, diffEndExpected + 3);
  1564→
  1565→    const actualCount = hunkEndActual - hunkStartActual;
  1566→    const expectedCount = hunkEndExpected - hunkStartExpected;
  1567→
  1568→    diffLines.push(
  1569→      `@@ -${hunkStartActual + 1},${actualCount} +${hunkStartExpected + 1},${expectedCount} @@`
  1570→    );
  1571→
  1572→    // Leading context
  1573→    for (let k = hunkStartActual; k < contextStart; k++) {
  1574→      diffLines.push(` ${actualLines[k]}`);
  1575→    }
  1576→
  1577→    // Removed lines (from actual)
  1578→    for (let k = contextStart; k < diffEndActual; k++) {
  1579→      if (k < actualLines.length) {
  1580→        diffLines.push(`-${actualLines[k]}`);
  1581→      }
  1582→    }
  1583→
  1584→    // Added lines (from expected)
  1585→    for (let k = contextStartExpected; k < diffEndExpected; k++) {
  1586→      if (k < expectedLines.length) {
  1587→        diffLines.push(`+${expectedLines[k]}`);
  1588→      }
  1589→    }
  1590→
  1591→    // Trailing context
  1592→    for (let k = diffEndActual; k < hunkEndActual; k++) {
  1593→      if (k < actualLines.length) {
  1594→        diffLines.push(` ${actualLines[k]}`);
  1595→      }
  1596→    }
  1597→
  1598→    i = hunkEndActual;
  1599→    j = hunkEndExpected;
  1600→  }
  1601→
  1602→  return diffLines;
  1603→}
  1604→
  1605→// Re-export for testing
  1606→export {
  1607→  renderSkill,
  1608→  isKspecManaged,
  1609→  KSPEC_MANAGED_MARKER,
  1610→  getSkillSyncStatus,
  1611→  getExpectedRenderedContent,
  1612→  generateUnifiedDiff,
  1613→};
  1614→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
