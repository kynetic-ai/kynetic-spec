   338→describe('Skill CLI - skill get', () => {
   339→  let tempDir: string;
   340→
   341→  beforeEach(async () => {
   342→    tempDir = await setupTempFixtures();
   343→    await initGitRepo(tempDir);
   344→
   345→    // Create a skill with custom content
   346→    const result = kspecFull(
   347→      'skill add --id task-work --name "Task Work" --description "Work on tasks" --origin core --skill-version 0.1.0 --tag workflow',
   348→      tempDir
   349→    );
   350→    if (result.exitCode !== 0) throw new Error(`skill add failed: ${result.stderr}`);
   351→
   352→    // Update SKILL.md with custom content - the directory was created by skill add
   353→    const skillMdPath = path.join(tempDir, 'skills', 'task-work', 'SKILL.md');
   354→    await fs.writeFile(skillMdPath, `# Task Work
   355→
   356→Use this skill when working on kspec tasks.
   357→
   358→## Usage
   359→
   360→\`\`\`bash
   361→kspec task start @ref
   362→\`\`\`
   363→`);
   364→  });
   365→
   366→  afterEach(async () => {
   367→    await cleanupTempDir(tempDir);
   368→  });
   369→
   370→  // AC: @skill-cli ac-5
   371→  it('should display metadata including id, name, origin, and platforms', () => {
   372→    const output = kspec('skill get @task-work', tempDir);
   373→
   374→    expect(output).toContain('Task Work');
   375→    expect(output).toContain('ID:');
   376→    expect(output).toContain('task-work');
   377→    expect(output).toContain('Origin:');
   378→    expect(output).toContain('core');
   379→    expect(output).toContain('Platforms:');
   380→    expect(output).toContain('claude-code');
   381→    expect(output).toContain('Version:');
   382→    expect(output).toContain('0.1.0');
   383→  });
   384→
   385→  // AC: @skill-cli ac-6
   386→  it('should display SKILL.md content', () => {
   387→    const output = kspec('skill get @task-work', tempDir);
   388→
   389→    expect(output).toContain('SKILL.md Content');
   390→    expect(output).toContain('Use this skill when working on kspec tasks');
   391→    expect(output).toContain('kspec task start @ref');
   392→  });
   393→
   394→  it('should include all metadata in JSON output', () => {
   395→    const result = kspecJson<{
   396→      _ulid: string;
   397→      id: string;
   398→      name: string;
   399→      description: string;
   400→      origin: string;
   401→      version: string;
   402→      platforms: string[];
   403→      depends_on: string[];
   404→      tags: string[];
   405→      content: string;
   406→      docs: Array<{ name: string; path: string }>;
   407→    }>('skill get @task-work', tempDir);
   408→
   409→    expect(result.id).toBe('task-work');
   410→    expect(result.name).toBe('Task Work');
   411→    expect(result.description).toBe('Work on tasks');
   412→    expect(result.origin).toBe('core');
   413→    expect(result.version).toBe('0.1.0');
   414→    expect(result.platforms).toContain('claude-code');
   415→    expect(result.tags).toContain('workflow');
   416→    expect(result.content).toContain('Use this skill when working on kspec tasks');
   417→    expect(Array.isArray(result.docs)).toBe(true);
   418→  });
   419→
   420→  it('should find skill by ULID prefix', async () => {
   421→    // Get the skill's ULID first
   422→    const list = kspecJson<Array<{ _ulid: string; id: string }>>('skill list', tempDir);
   423→    const skill = list.find(s => s.id === 'task-work');
   424→    const ulidPrefix = skill?._ulid.slice(0, 8);
   425→
   426→    const output = kspec(`skill get @${ulidPrefix}`, tempDir);
   427→    expect(output).toContain('task-work');
   428→    expect(output).toContain('Task Work');
   429→  });
   430→
   431→  it('should return error when skill not found', () => {
   432→    const result = kspecFull('skill get @nonexistent', tempDir, { expectFail: true });
   433→    expect(result.exitCode).not.toBe(0);
   434→    expect(result.stderr).toContain('not found');
   435→  });
   436→
   437→  it('should show (No SKILL.md content found) when file missing', async () => {
   438→    // Delete the SKILL.md file
   439→    const skillMdPath = path.join(tempDir, 'skills', 'task-work', 'SKILL.md');
   440→    await fs.unlink(skillMdPath);
   441→
   442→    const output = kspec('skill get @task-work', tempDir);
   443→    expect(output).toContain('No SKILL.md content found');
   444→  });
   445→});
   446→
   447→describe('Skill CLI - skill delete', () => {
   448→  let tempDir: string;
   449→
   450→  beforeEach(async () => {
   451→    tempDir = await setupTempFixtures();
   452→    await initGitRepo(tempDir);
   453→
   454→    // Create skills
   455→    kspec('skill add --id my-skill --name "My Skill"', tempDir);
   456→    kspec('skill add --id dependent-skill --name "Dependent Skill" --depends-on @my-skill', tempDir);
   457→  });
   458→
   459→  afterEach(async () => {
   460→    await cleanupTempDir(tempDir);
   461→  });
   462→
   463→  // AC: @skill-cli ac-7
   464→  it('should remove meta entry from manifest when --confirm provided', async () => {
   465→    // First create a skill that has no dependencies
   466→    kspec('skill add --id standalone-skill --name "Standalone Skill"', tempDir);
   467→
   468→    // Verify it exists
   469→    let list = kspecJson<Array<{ id: string }>>('skill list', tempDir);
   470→    expect(list.some(s => s.id === 'standalone-skill')).toBe(true);
   471→
   472→    // Delete it
   473→    kspec('skill delete @standalone-skill --confirm', tempDir);
   474→
   475→    // Verify it's gone
   476→    list = kspecJson<Array<{ id: string }>>('skill list', tempDir);
   477→    expect(list.some(s => s.id === 'standalone-skill')).toBe(false);
   478→  });
   479→
   480→  // AC: @skill-cli ac-8
   481→  it('should delete .kspec/skills/<id>/ directory', async () => {
   482→    // Create a standalone skill
   483→    kspec('skill add --id standalone-skill --name "Standalone Skill"', tempDir);
   484→
   485→    // Verify directory exists
   486→    const skillDir = path.join(tempDir, 'skills', 'standalone-skill');
   487→    let exists = await fs.access(skillDir).then(() => true).catch(() => false);
   488→    expect(exists).toBe(true);
   489→
   490→    // Delete the skill
   491→    kspec('skill delete @standalone-skill --confirm', tempDir);
   492→
   493→    // Verify directory is gone
   494→    exists = await fs.access(skillDir).then(() => true).catch(() => false);
   495→    expect(exists).toBe(false);
   496→  });
   497→
   498→  it('should require --confirm flag', () => {
   499→    const result = kspecFull('skill delete @my-skill', tempDir, { expectFail: true });
   500→    expect(result.exitCode).not.toBe(0);
   501→    expect(result.stderr).toContain('--confirm');
   502→  });
   503→
   504→  it('should prevent deletion when other skills depend on it', () => {
   505→    const result = kspecFull('skill delete @my-skill --confirm', tempDir, { expectFail: true });
   506→    expect(result.exitCode).not.toBe(0);
   507→    expect(result.stderr).toContain('referenced by');
   508→    expect(result.stderr).toContain('@dependent-skill');
   509→  });
   510→
   511→  it('should return error when skill not found', () => {
   512→    const result = kspecFull('skill delete @nonexistent --confirm', tempDir, { expectFail: true });
   513→    expect(result.exitCode).not.toBe(0);
   514→    expect(result.stderr).toContain('not found');
   515→  });
   516→
   517→  it('should find skill by ULID prefix', async () => {
   518→    // Create a standalone skill and get its ULID
   519→    const createResult = kspecJson<{ _ulid: string; id: string }>(
   520→      'skill add --id temp-skill --name "Temp Skill"',
   521→      tempDir
   522→    );
   523→    // Use a longer prefix to ensure uniqueness (12 chars instead of 8)
   524→    const ulidPrefix = createResult._ulid.slice(0, 12);
   525→
   526→    // Delete by ULID prefix
   527→    const output = kspec(`skill delete @${ulidPrefix} --confirm`, tempDir);
   528→    expect(output).toContain('Deleted');
   529→
   530→    // Verify it's gone
   531→    const list = kspecJson<Array<{ id: string }>>('skill list', tempDir);
   532→    expect(list.some(s => s.id === 'temp-skill')).toBe(false);
   533→  });
   534→});
