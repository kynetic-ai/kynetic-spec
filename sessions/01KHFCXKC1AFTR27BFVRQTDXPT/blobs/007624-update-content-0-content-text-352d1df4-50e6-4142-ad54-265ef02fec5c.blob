```
     1→/**
     2→ * Tests for Skill CLI Commands
     3→ * AC: @skill-cli ac-1 through ac-8
     4→ */
     5→
     6→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     7→import * as fs from 'node:fs/promises';
     8→import * as path from 'node:path';
     9→import { parse as yamlParse, stringify as yamlStringify } from 'yaml';
    10→import {
    11→  kspecOutput as kspec,
    12→  kspecJson,
    13→  kspec as kspecFull,
    14→  setupTempFixtures,
    15→  cleanupTempDir,
    16→  createTempDir,
    17→  initGitRepo,
    18→} from './helpers/cli';
    19→
    20→describe('Skill CLI - skill list', () => {
    21→  let tempDir: string;
    22→
    23→  beforeEach(async () => {
    24→    tempDir = await setupTempFixtures();
    25→    await initGitRepo(tempDir);
    26→
    27→    // Create some skills via kspec add - note: run sequentially
    28→    const result1 = kspecFull(
    29→      'skill add --id task-work --name "Task Work" --description "Work on tasks" --origin core --skill-version 0.1.0',
    30→      tempDir
    31→    );
    32→    const result2 = kspecFull(
    33→      'skill add --id pr-review --name "PR Review" --origin project --tag workflow --tag review',
    34→      tempDir
    35→    );
    36→    // Fail fast if skill creation failed
    37→    if (result1.exitCode !== 0) throw new Error(`skill add failed: ${result1.stderr}`);
    38→    if (result2.exitCode !== 0) throw new Error(`skill add failed: ${result2.stderr}`);
    39→  });
    40→
    41→  afterEach(async () => {
    42→    await cleanupTempDir(tempDir);
    43→  });
    44→
    45→  // AC: @skill-cli ac-1
    46→  it('should display table with ID, Name, Origin, Version, and Platforms columns', () => {
    47→    const output = kspec('skill list', tempDir);
    48→
    49→    // Check headers are present
    50→    expect(output).toContain('ID');
    51→    expect(output).toContain('Name');
    52→    expect(output).toContain('Origin');
    53→    expect(output).toContain('Version');
    54→    expect(output).toContain('Platforms');
    55→
    56→    // Check data
    57→    expect(output).toContain('task-work');
    58→    expect(output).toContain('Task Work');
    59→    expect(output).toContain('core');
    60→    expect(output).toContain('pr-review');
    61→    expect(output).toContain('PR Review');
    62→    expect(output).toContain('project');
    63→
    64→    // Check skill count
    65→    expect(output).toContain('2 skill(s)');
    66→  });
    67→
    68→  // AC: @skill-cli ac-2
    69→  it('should return JSON array with full skill metadata when --json flag provided', () => {
    70→    const result = kspecJson<Array<{
    71→      _ulid: string;
    72→      id: string;
    73→      name: string;
    74→      description?: string;
    75→      origin: string;
    76→      version?: string;
    77→      platforms: string[];
    78→      depends_on: string[];
    79→      tags: string[];
    80→    }>>('skill list', tempDir);
    81→
    82→    expect(Array.isArray(result)).toBe(true);
    83→    expect(result.length).toBe(2);
    84→
    85→    const taskWork = result.find(s => s.id === 'task-work');
    86→    expect(taskWork).toBeDefined();
    87→    expect(taskWork?._ulid).toMatch(/^[0-9A-Z]{26}$/);
    88→    expect(taskWork?.name).toBe('Task Work');
    89→    expect(taskWork?.description).toBe('Work on tasks');
    90→    expect(taskWork?.origin).toBe('core');
    91→    expect(taskWork?.version).toBe('0.1.0');
    92→    expect(taskWork?.platforms).toContain('claude-code');
    93→    expect(taskWork?.depends_on).toEqual([]);
    94→
    95→    const prReview = result.find(s => s.id === 'pr-review');
    96→    expect(prReview).toBeDefined();
    97→    expect(prReview?.origin).toBe('project');
    98→    expect(prReview?.tags).toContain('workflow');
    99→    expect(prReview?.tags).toContain('review');
   100→  });
   101→
   102→  it('should filter by origin', () => {
   103→    const result = kspecJson<Array<{ id: string; origin: string }>>('skill list --origin core', tempDir);
   104→
   105→    expect(result.length).toBe(1);
   106→    expect(result[0].id).toBe('task-work');
   107→    expect(result[0].origin).toBe('core');
   108→  });
   109→
   110→  it('should filter by tag', () => {
   111→    const result = kspecJson<Array<{ id: string; tags: string[] }>>('skill list --tag workflow', tempDir);
   112→
   113→    expect(result.length).toBe(1);
   114→    expect(result[0].id).toBe('pr-review');
   115→    expect(result[0].tags).toContain('workflow');
   116→  });
   117→
   118→  it('should show message when no skills defined', async () => {
   119→    // Create fresh project with no skills
   120→    const emptyDir = await createTempDir();
   121→    await initGitRepo(emptyDir);
   122→    await fs.writeFile(path.join(emptyDir, 'kynetic.yaml'), yamlStringify({ kynetic: '1.0' }));
   123→    await fs.writeFile(
   124→      path.join(emptyDir, 'kynetic.meta.yaml'),
   125→      yamlStringify({ kynetic_meta: '1.0', skills: [] })
   126→    );
   127→
   128→    try {
   129→      const output = kspec('skill list', emptyDir);
   130→      expect(output).toContain('No skills defined');
   131→    } finally {
   132→      await cleanupTempDir(emptyDir);
   133→    }
   134→  });
   135→});
   136→
   137→describe('Skill CLI - skill add', () => {
   138→  let tempDir: string;
   139→
   140→  beforeEach(async () => {
   141→    tempDir = await setupTempFixtures();
   142→    await initGitRepo(tempDir);
   143→  });
   144→
   145→  afterEach(async () => {
   146→    await cleanupTempDir(tempDir);
   147→  });
   148→
   149→  // AC: @skill-cli ac-3
   150→  // AC: @skill-add ac-1 - meta entry created
   151→  it('should create meta entry with correct origin', () => {
   152→    const result = kspecJson<{
   153→      _ulid: string;
   154→      id: string;
   155→      name: string;
   156→      origin: string;
   157→    }>('skill add --id my-skill --name "My Skill" --description "A test skill"', tempDir);
   158→
   159→    expect(result.id).toBe('my-skill');
   160→    expect(result.name).toBe('My Skill');
   161→    expect(result.origin).toBe('project'); // Default origin
   162→    expect(result._ulid).toMatch(/^[0-9A-Z]{26}$/);
   163→  });
   164→
   165→  it('should create meta entry with custom origin', () => {
   166→    const result = kspecJson<{ id: string; origin: string }>(
   167→      'skill add --id local-skill --name "Local Skill" --origin local',
   168→      tempDir
   169→    );
   170→
   171→    expect(result.origin).toBe('local');
   172→  });
   173→
   174→  // AC: @skill-add ac-4, ac-5 - origin and version set correctly
   175→  it('should set origin and version when --origin core --skill-version provided', () => {
   176→    const result = kspecJson<{ id: string; origin: string; version: string }>(
   177→      'skill add --id core-skill --name "Core Skill" --origin core --skill-version 0.2.0',
   178→      tempDir
   179→    );
   180→
   181→    // AC: @skill-add ac-4 - origin is core
   182→    expect(result.origin).toBe('core');
   183→    // AC: @skill-add ac-5 - version is 0.2.0
   184→    expect(result.version).toBe('0.2.0');
   185→  });
   186→
   187→  // AC: @skill-cli ac-4
   188→  it('should create .kspec/skills/<id>/SKILL.md file', async () => {
   189→    kspec('skill add --id my-skill --name "My Skill" --description "Test skill"', tempDir);
   190→
   191→    const skillMdPath = path.join(tempDir, 'skills', 'my-skill', 'SKILL.md');
   192→    const exists = await fs.access(skillMdPath).then(() => true).catch(() => false);
   193→    expect(exists).toBe(true);
   194→
   195→    const content = await fs.readFile(skillMdPath, 'utf-8');
   196→    expect(content).toContain('# My Skill');
   197→    expect(content).toContain('Test skill');
   198→  });
   199→
   200→  it('should add skill to meta manifest', async () => {
   201→    kspec('skill add --id my-skill --name "My Skill"', tempDir);
   202→
   203→    const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
   204→    const metaContent = await fs.readFile(metaPath, 'utf-8');
   205→    const meta = yamlParse(metaContent);
   206→
   207→    expect(meta.skills).toBeDefined();
   208→    const skill = meta.skills.find((s: { id: string }) => s.id === 'my-skill');
   209→    expect(skill).toBeDefined();
   210→    expect(skill.name).toBe('My Skill');
   211→  });
   212→
   213→  it('should set platforms to default value when not specified', () => {
   214→    const result = kspecJson<{ platforms: string[] }>(
   215→      'skill add --id my-skill --name "My Skill"',
   216→      tempDir
   217→    );
   218→
   219→    expect(result.platforms).toEqual(['claude-code']);
   220→  });
   221→
   222→  it('should accept custom platforms', () => {
   223→    const result = kspecJson<{ platforms: string[] }>(
   224→      'skill add --id my-skill --name "My Skill" --platform cursor --platform windsurf',
   225→      tempDir
   226→    );
   227→
   228→    expect(result.platforms).toContain('cursor');
   229→    expect(result.platforms).toContain('windsurf');
   230→  });
   231→
   232→  it('should accept version option', () => {
   233→    const result = kspecJson<{ version: string }>(
   234→      'skill add --id my-skill --name "My Skill" --skill-version 1.2.3',
   235→      tempDir
   236→    );
   237→
   238→    expect(result.version).toBe('1.2.3');
   239→  });
   240→
   241→  it('should accept tags option', () => {
   242→    const result = kspecJson<{ tags: string[] }>(
   243→      'skill add --id my-skill --name "My Skill" --tag workflow --tag automation',
   244→      tempDir
   245→    );
   246→
   247→    expect(result.tags).toContain('workflow');
   248→    expect(result.tags).toContain('automation');
   249→  });
   250→
   251→  it('should accept depends-on option', () => {
   252→    // First create a skill to depend on
   253→    kspec('skill add --id base-skill --name "Base Skill"', tempDir);
   254→
   255→    const result = kspecJson<{ depends_on: string[] }>(
   256→      'skill add --id my-skill --name "My Skill" --depends-on @base-skill',
   257→      tempDir
   258→    );
   259→
   260→    expect(result.depends_on).toContain('@base-skill');
   261→  });
   262→
   263→  // AC: @skill-add ac-6 - duplicate ID error
   264→  it('should reject duplicate skill ID', () => {
   265→    kspec('skill add --id my-skill --name "My Skill"', tempDir);
   266→
   267→    const result = kspecFull('skill add --id my-skill --name "Another Skill"', tempDir, { expectFail: true });
   268→    expect(result.exitCode).not.toBe(0);
   269→    expect(result.stderr).toContain("already exists");
   270→  });
   271→
   272→  it('should reject invalid origin', () => {
   273→    const result = kspecFull('skill add --id my-skill --name "My Skill" --origin invalid', tempDir, { expectFail: true });
   274→    expect(result.exitCode).not.toBe(0);
   275→    expect(result.stderr).toContain("Invalid origin");
   276→  });
   277→
   278→  it('should validate kebab-case ID', () => {
   279→    const result = kspecFull('skill add --id MySkill --name "My Skill"', tempDir, { expectFail: true });
   280→    expect(result.exitCode).not.toBe(0);
   281→    expect(result.stderr).toContain("kebab-case");
   282→  });
   283→
   284→  // AC: @skill-add ac-3 - --content-file copies file to SKILL.md
   285→  it('should copy content from --content-file to SKILL.md', async () => {
   286→    // Create a source file with custom content
   287→    const sourceContent = `# Custom Skill Content
   288→
   289→This content comes from an existing file.
   290→
   291→## Usage
   292→
   293→Use this skill for custom tasks.
   294→`;
   295→    const sourceFile = path.join(tempDir, 'custom-skill.md');
   296→    await fs.writeFile(sourceFile, sourceContent);
   297→
   298→    // Create skill with --content-file
   299→    kspec(`skill add --id custom-skill --name "Custom Skill" --content-file ${sourceFile}`, tempDir);
   300→
   301→    // Verify SKILL.md has the content from the source file
   302→    const skillMdPath = path.join(tempDir, 'skills', 'custom-skill', 'SKILL.md');
   303→    const content = await fs.readFile(skillMdPath, 'utf-8');
   304→    expect(content).toBe(sourceContent);
   305→    expect(content).toContain('Custom Skill Content');
   306→    expect(content).toContain('This content comes from an existing file');
   307→  });
   308→
   309→  // AC: @skill-add ac-3 - --content-file with relative path
   310→  it('should handle relative path for --content-file', async () => {
   311→    // Create a source file with custom content
   312→    const sourceContent = '# Relative Path Skill\n\nContent from relative path.\n';
   313→    const sourceFile = path.join(tempDir, 'relative-source.md');
   314→    await fs.writeFile(sourceFile, sourceContent);
   315→
   316→    // Run kspec from tempDir so relative path works
   317→    // Note: kspec already runs from tempDir
   318→    kspec('skill add --id rel-skill --name "Relative Skill" --content-file relative-source.md', tempDir);
   319→
   320→    // Verify SKILL.md has the content
   321→    const skillMdPath = path.join(tempDir, 'skills', 'rel-skill', 'SKILL.md');
   322→    const content = await fs.readFile(skillMdPath, 'utf-8');
   323→    expect(content).toBe(sourceContent);
   324→  });
   325→
   326→  // AC: @skill-add ac-3 - error when content file doesn't exist
   327→  it('should error when --content-file does not exist', () => {
   328→    const result = kspecFull(
   329→      'skill add --id bad-skill --name "Bad Skill" --content-file /nonexistent/file.md',
   330→      tempDir,
   331→      { expectFail: true }
   332→    );
   333→    expect(result.exitCode).not.toBe(0);
   334→    expect(result.stderr).toContain('Failed to read content file');
   335→  });
   336→});
