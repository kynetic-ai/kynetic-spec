     1→/**
     2→ * Skill CLI commands for managing skills.
     3→ *
     4→ * AC: @skill-cli ac-1 - kspec skill list outputs table with ID, Name, Origin, Version, Platforms
     5→ * AC: @skill-cli ac-2 - kspec skill list --json outputs JSON array with full skill metadata
     6→ * AC: @skill-cli ac-3 - kspec skill add creates meta entry with origin custom
     7→ * AC: @skill-cli ac-4 - kspec skill add creates .kspec/skills/<id>/SKILL.md
     8→ * AC: @skill-cli ac-5 - kspec skill get outputs metadata including id, name, origin, platforms
     9→ * AC: @skill-cli ac-6 - kspec skill get outputs SKILL.md content
    10→ * AC: @skill-cli ac-7 - kspec skill delete --confirm removes meta entry
    11→ * AC: @skill-cli ac-8 - kspec skill delete removes .kspec/skills/<id>/ directory
    12→ */
    13→
    14→import * as fs from "node:fs/promises";
    15→import * as path from "node:path";
    16→import chalk from "chalk";
    17→import Table from "cli-table3";
    18→import type { Command } from "commander";
    19→import { ulid } from "ulid";
    20→import yaml from "yaml";
    21→import { markMutating } from "../command-annotations.js";
    22→import {
    23→  deleteMetaItem,
    24→  findMetaItemByRef,
    25→  getSkillContentPath,
    26→  initContext,
    27→  loadMetaContext,
    28→  loadSkillContent,
    29→  loadSkillDocs,
    30→  type LoadedSkill,
    31→  saveMetaItem,
    32→  type Skill,
    33→} from "../../parser/index.js";
    34→import { commitIfShadow } from "../../parser/shadow.js";
    35→import { SkillSchema, type SkillOrigin } from "../../schema/index.js";
    36→import { errors } from "../../strings/errors.js";
    37→import { EXIT_CODES } from "../exit-codes.js";
    38→import { error, output, success } from "../output.js";
    39→import { parseTagsArray } from "../parse-utils.js";
    40→
    41→/**
    42→ * Format skills as a table
    43→ * AC: @skill-cli ac-1 - table displays ID, Name, Origin, Version, Platforms
    44→ */
    45→function formatSkillsTable(skills: LoadedSkill[]): void {
    46→  if (skills.length === 0) {
    47→    console.log(chalk.yellow("No skills defined"));
    48→    return;
    49→  }
    50→
    51→  const table = new Table({
    52→    head: [
    53→      chalk.bold("ID"),
    54→      chalk.bold("Name"),
    55→      chalk.bold("Origin"),
    56→      chalk.bold("Version"),
    57→      chalk.bold("Platforms"),
    58→    ],
    59→    style: {
    60→      head: [],
    61→      border: [],
    62→    },
    63→  });
    64→
    65→  for (const skill of skills) {
    66→    table.push([
    67→      skill.id,
    68→      skill.name,
    69→      skill.origin,
    70→      skill.version || "-",
    71→      skill.platforms.join(", "),
    72→    ]);
    73→  }
    74→
    75→  console.log(table.toString());
    76→  console.log(chalk.gray(`\n${skills.length} skill(s)`));
    77→}
    78→
    79→/**
    80→ * Format skill details
    81→ * AC: @skill-cli ac-5 - outputs metadata including id, name, origin, platforms
    82→ */
    83→function formatSkillDetails(skill: LoadedSkill, content: string | null): void {
    84→  console.log(chalk.bold(skill.name));
    85→  console.log(chalk.gray("─".repeat(40)));
    86→  console.log(`ID:          ${skill.id}`);
    87→  console.log(`ULID:        ${skill._ulid}`);
    88→  console.log(`Origin:      ${skill.origin}`);
    89→  console.log(`Platforms:   ${skill.platforms.join(", ")}`);
    90→
    91→  if (skill.version) {
    92→    console.log(`Version:     ${skill.version}`);
    93→  }
    94→
    95→  if (skill.description) {
    96→    console.log(`\n─── Description ───`);
    97→    console.log(skill.description);
    98→  }
    99→
   100→  if (skill.depends_on && skill.depends_on.length > 0) {
   101→    console.log(`\n─── Dependencies ───`);
   102→    for (const dep of skill.depends_on) {
   103→      console.log(`  • ${dep}`);
   104→    }
   105→  }
   106→
   107→  if (skill.tags && skill.tags.length > 0) {
   108→    console.log(`\nTags:        ${skill.tags.join(", ")}`);
   109→  }
   110→
   111→  // AC: @skill-cli ac-6 - display SKILL.md content
   112→  if (content) {
   113→    console.log(`\n─── SKILL.md Content ───`);
   114→    console.log(content);
   115→  } else {
   116→    console.log(chalk.gray("\n(No SKILL.md content found)"));
   117→  }
   118→}
   119→
   120→/**
   121→ * Register skill commands
   122→ */
   123→export function registerSkillCommands(program: Command): void {
   124→  const skill = program
   125→    .command("skill")
   126→    .description("Skill management commands");
   127→
   128→  // AC: @skill-cli ac-1, ac-2 - kspec skill list
   129→  skill
   130→    .command("list")
   131→    .description("List all skills")
   132→    .option("--origin <origin>", "Filter by origin (core, project, local)")
   133→    .option("--tag <tag>", "Filter by tag")
   134→    .action(async (options) => {
   135→      try {
   136→        const ctx = await initContext();
   137→
   138→        if (!ctx.manifestPath) {
   139→          error(errors.project.noKspecProject);
   140→          process.exit(EXIT_CODES.ERROR);
   141→        }
   142→
   143→        const metaCtx = await loadMetaContext(ctx);
   144→        let skills = metaCtx.skills || [];
   145→
   146→        // Apply filters
   147→        if (options.origin) {
   148→          skills = skills.filter((s) => s.origin === options.origin);
   149→        }
   150→
   151→        if (options.tag) {
   152→          skills = skills.filter((s) => s.tags?.includes(options.tag));
   153→        }
   154→
   155→        // AC: @skill-cli ac-2 - JSON output includes full skill metadata
   156→        output(
   157→          skills.map((s) => ({
   158→            _ulid: s._ulid,
   159→            id: s.id,
   160→            name: s.name,
   161→            description: s.description,
   162→            origin: s.origin,
   163→            version: s.version,
   164→            platforms: s.platforms,
   165→            depends_on: s.depends_on,
   166→            tags: s.tags,
   167→          })),
   168→          // AC: @skill-cli ac-1 - Table output
   169→          () => formatSkillsTable(skills),
   170→        );
   171→      } catch (err) {
   172→        error("Failed to list skills", err);
   173→        process.exit(EXIT_CODES.ERROR);
   174→      }
   175→    });
   176→
   177→  // AC: @skill-cli ac-3, ac-4 - kspec skill add
   178→  // AC: @skill-add ac-3 - --content-file copies existing file to SKILL.md
   179→  markMutating(skill.command("add"))
   180→    .description("Create a new skill")
   181→    .requiredOption("--id <id>", "Skill ID (kebab-case)")
   182→    .requiredOption("--name <name>", "Skill name")
   183→    .option("--description <desc>", "Skill description")
   184→    .option(
   185→      "--origin <origin>",
   186→      "Skill origin (core, project, local)",
   187→      "project",
   188→    )
   189→    .option("--skill-version <version>", "Skill version")
   190→    .option("--platform <platform...>", "Target platforms")
   191→    .option("--tag <tag...>", "Tags for the skill")
   192→    .option("--depends-on <ref...>", "Skill dependencies")
   193→    .option("--content-file <path>", "Path to existing file to use as SKILL.md content")
   194→    .action(async (options) => {
   195→      try {
   196→        const ctx = await initContext();
   197→
   198→        if (!ctx.manifestPath) {
   199→          error(errors.project.noKspecProject);
   200→          process.exit(EXIT_CODES.ERROR);
   201→        }
   202→
   203→        // Validate origin
   204→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   205→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   206→          error(
   207→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   208→          );
   209→          process.exit(EXIT_CODES.ERROR);
   210→        }
   211→
   212→        // Check if skill with this ID already exists
   213→        const metaCtx = await loadMetaContext(ctx);
   214→        const existingSkill = metaCtx.skills.find((s) => s.id === options.id);
   215→        if (existingSkill) {
   216→          error(`Skill with ID '${options.id}' already exists`);
   217→          process.exit(EXIT_CODES.CONFLICT);
   218→        }
   219→
   220→        // Build skill object
   221→        const skillData: Skill = {
   222→          _ulid: ulid(),
   223→          id: options.id,
   224→          name: options.name,
   225→          description: options.description,
   226→          origin: options.origin as SkillOrigin,
   227→          version: options.skillVersion,
   228→          platforms:
   229→            options.platform && options.platform.length > 0
   230→              ? options.platform
   231→              : ["claude-code"],
   232→          depends_on:
   233→            options.dependsOn && options.dependsOn.length > 0
   234→              ? options.dependsOn
   235→              : [],
   236→          tags:
   237→            options.tag && options.tag.length > 0
   238→              ? parseTagsArray(options.tag)
   239→              : [],
   240→        };
   241→
   242→        // Validate with schema
   243→        const parsed = SkillSchema.safeParse(skillData);
   244→        if (!parsed.success) {
   245→          const issues = parsed.error.issues
   246→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   247→            .join("; ");
   248→          error(`Invalid skill data: ${issues}`);
   249→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   250→        }
   251→
   252→        const skill: LoadedSkill = { ...parsed.data };
   253→
   254→        // AC: @skill-cli ac-3 - save meta entry (also creates directory per ac-4)
   255→        await saveMetaItem(ctx, skill, "skill");
   256→
   257→        // AC: @skill-cli ac-4 - create SKILL.md with placeholder content
   258→        // AC: @skill-add ac-3 - if --content-file provided, copy its contents
   259→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   260→        let initialContent: string;
   261→
   262→        if (options.contentFile) {
   263→          // Read content from the specified file
   264→          const contentFilePath = path.isAbsolute(options.contentFile)
   265→            ? options.contentFile
   266→            : path.resolve(process.cwd(), options.contentFile);
   267→
   268→          try {
   269→            initialContent = await fs.readFile(contentFilePath, "utf-8");
   270→          } catch (err) {
   271→            // Clean up: remove the skill we just created
   272→            await deleteMetaItem(ctx, skill._ulid, "skill");
   273→            error(`Failed to read content file: ${contentFilePath}`);
   274→            process.exit(EXIT_CODES.ERROR);
   275→          }
   276→        } else {
   277→          initialContent = `# ${skill.name}\n\n${skill.description || "Add skill content here."}\n`;
   278→        }
   279→
   280→        await fs.writeFile(skillMdPath, initialContent, "utf-8");
   281→
   282→        // Commit changes
   283→        await commitIfShadow(ctx.shadow, "skill-add", skill.id, skill.name);
   284→
   285→        output(skill, () =>
   286→          success(`Created skill: ${skill.id}`, { skill }),
   287→        );
   288→      } catch (err) {
   289→        error("Failed to create skill", err);
   290→        process.exit(EXIT_CODES.ERROR);
   291→      }
   292→    });
   293→
   294→  // AC: @skill-cli ac-5, ac-6 - kspec skill get
   295→  skill
   296→    .command("get <ref>")
   297→    .description("Show skill details")
   298→    .action(async (ref: string) => {
   299→      try {
   300→        const ctx = await initContext();
   301→
   302→        if (!ctx.manifestPath) {
   303→          error(errors.project.noKspecProject);
   304→          process.exit(EXIT_CODES.ERROR);
   305→        }
   306→
   307→        const metaCtx = await loadMetaContext(ctx);
   308→        const item = findMetaItemByRef(metaCtx, ref);
   309→
   310→        if (!item) {
   311→          error(`Skill not found: ${ref}`);
   312→          console.log(chalk.gray("Try: kspec skill list"));
   313→          process.exit(EXIT_CODES.NOT_FOUND);
   314→        }
   315→
   316→        // Check it's a skill
   317→        if (!("origin" in item)) {
   318→          error(`Item ${ref} is not a skill`);
   319→          process.exit(EXIT_CODES.ERROR);
   320→        }
   321→
   322→        const skill = item as LoadedSkill;
   323→
   324→        // AC: @skill-cli ac-6 - load SKILL.md content
   325→        const content = await loadSkillContent(ctx, skill);
   326→        const docs = await loadSkillDocs(ctx, skill);
   327→
   328→        // AC: @skill-cli ac-5, ac-6 - output metadata and content
   329→        output(
   330→          {
   331→            _ulid: skill._ulid,
   332→            id: skill.id,
   333→            name: skill.name,
   334→            description: skill.description,
   335→            origin: skill.origin,
   336→            version: skill.version,
   337→            platforms: skill.platforms,
   338→            depends_on: skill.depends_on,
   339→            tags: skill.tags,
   340→            content,
   341→            docs: docs.map((d) => ({ name: d.name, path: d.path })),
   342→          },
   343→          () => formatSkillDetails(skill, content),
   344→        );
   345→      } catch (err) {
   346→        error("Failed to get skill", err);
   347→        process.exit(EXIT_CODES.ERROR);
   348→      }
   349→    });
   350→
   351→  // AC: @skill-set ac-1, ac-2, ac-3 - kspec skill set
   352→  markMutating(skill.command("set <ref>"))
   353→    .description("Update skill metadata fields")
   354→    .option("--name <name>", "Update skill name")
   355→    .option("--description <desc>", "Update skill description")
   356→    .option("--origin <origin>", "Update skill origin (core, project, local)")
   357→    .option("--skill-version <version>", "Update skill version")
   358→    .option("--add-platform <platform>", "Add a platform to the platforms array")
   359→    .option("--remove-platform <platform>", "Remove a platform from the platforms array")
   360→    .option("--add-tag <tag>", "Add a tag to the tags array")
   361→    .option("--remove-tag <tag>", "Remove a tag from the tags array")
   362→    .option("--add-depends-on <ref>", "Add a dependency reference")
   363→    .option("--remove-depends-on <ref>", "Remove a dependency reference")
   364→    .action(async (ref: string, options) => {
   365→      try {
   366→        const ctx = await initContext();
   367→
   368→        if (!ctx.manifestPath) {
   369→          error(errors.project.noKspecProject);
   370→          process.exit(EXIT_CODES.ERROR);
   371→        }
   372→
   373→        const metaCtx = await loadMetaContext(ctx);
   374→        const item = findMetaItemByRef(metaCtx, ref);
   375→
   376→        if (!item) {
   377→          error(`Skill not found: ${ref}`);
   378→          console.log(chalk.gray("Try: kspec skill list"));
   379→          process.exit(EXIT_CODES.NOT_FOUND);
   380→        }
   381→
   382→        // Check it's a skill
   383→        if (!("origin" in item)) {
   384→          error(`Item ${ref} is not a skill`);
   385→          process.exit(EXIT_CODES.ERROR);
   386→        }
   387→
   388→        const skill = item as LoadedSkill;
   389→
   390→        // AC: @skill-set ac-1 - update description field
   391→        if (options.name !== undefined) {
   392→          skill.name = options.name;
   393→        }
   394→
   395→        if (options.description !== undefined) {
   396→          skill.description = options.description;
   397→        }
   398→
   399→        // Update origin
   400→        if (options.origin !== undefined) {
   401→          const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   402→          if (!validOrigins.includes(options.origin as SkillOrigin)) {
   403→            error(
   404→              `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   405→            );
   406→            process.exit(EXIT_CODES.ERROR);
   407→          }
   408→          skill.origin = options.origin as SkillOrigin;
   409→        }
   410→
   411→        // Update version
   412→        if (options.skillVersion !== undefined) {
   413→          skill.version = options.skillVersion;
   414→        }
   415→
   416→        // AC: @skill-set ac-2 - add platform to array
   417→        if (options.addPlatform) {
   418→          if (!skill.platforms.includes(options.addPlatform)) {
   419→            skill.platforms.push(options.addPlatform);
   420→          }
   421→        }
   422→
   423→        // Remove platform
   424→        if (options.removePlatform) {
   425→          const idx = skill.platforms.indexOf(options.removePlatform);
   426→          if (idx >= 0) {
   427→            skill.platforms.splice(idx, 1);
   428→          }
   429→        }
   430→
   431→        // AC: @skill-set ac-3 - add tag to array
   432→        if (options.addTag) {
   433→          if (!skill.tags) {
   434→            skill.tags = [];
   435→          }
   436→          if (!skill.tags.includes(options.addTag)) {
   437→            skill.tags.push(options.addTag);
   438→          }
   439→        }
   440→
   441→        // Remove tag
   442→        if (options.removeTag && skill.tags) {
   443→          const idx = skill.tags.indexOf(options.removeTag);
   444→          if (idx >= 0) {
   445→            skill.tags.splice(idx, 1);
   446→          }
   447→        }
   448→
   449→        // Add dependency
   450→        if (options.addDependsOn) {
   451→          if (!skill.depends_on) {
   452→            skill.depends_on = [];
   453→          }
   454→          if (!skill.depends_on.includes(options.addDependsOn)) {
   455→            skill.depends_on.push(options.addDependsOn);
   456→          }
   457→        }
   458→
   459→        // Remove dependency
   460→        if (options.removeDependsOn && skill.depends_on) {
   461→          const idx = skill.depends_on.indexOf(options.removeDependsOn);
   462→          if (idx >= 0) {
   463→            skill.depends_on.splice(idx, 1);
   464→          }
   465→        }
   466→
   467→        // Validate updated skill
   468→        const parsed = SkillSchema.safeParse(skill);
   469→        if (!parsed.success) {
   470→          const issues = parsed.error.issues
   471→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   472→            .join("; ");
   473→          error(`Invalid skill data: ${issues}`);
   474→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   475→        }
   476→
   477→        // Save the updated skill
   478→        await saveMetaItem(ctx, skill, "skill");
   479→
   480→        // Commit changes
   481→        await commitIfShadow(ctx.shadow, "skill-set", skill.id, skill.name);
   482→
   483→        output(skill, () => success(`Updated skill: ${skill.id}`));
   484→      } catch (err) {
   485→        error("Failed to update skill", err);
   486→        process.exit(EXIT_CODES.ERROR);
   487→      }
   488→    });
   489→
   490→  // AC: @skill-cli ac-7, ac-8 - kspec skill delete
   491→  markMutating(skill.command("delete <ref>"))
   492→    .description("Delete a skill")
   493→    .option("--confirm", "Skip confirmation prompt")
   494→    .action(async (ref: string, options) => {
   495→      try {
   496→        const ctx = await initContext();
   497→
   498→        if (!ctx.manifestPath) {
   499→          error(errors.project.noKspecProject);
   500→          process.exit(EXIT_CODES.ERROR);
   501→        }
   502→
   503→        const metaCtx = await loadMetaContext(ctx);
   504→        const item = findMetaItemByRef(metaCtx, ref);
   505→
   506→        if (!item) {
   507→          error(`Skill not found: ${ref}`);
   508→          console.log(chalk.gray("Try: kspec skill list"));
   509→          process.exit(EXIT_CODES.NOT_FOUND);
   510→        }
   511→
   512→        // Check it's a skill
   513→        if (!("origin" in item)) {
   514→          error(`Item ${ref} is not a skill`);
   515→          process.exit(EXIT_CODES.ERROR);
   516→        }
   517→
   518→        const skill = item as LoadedSkill;
   519→
   520→        // Check for confirmation
   521→        if (!options.confirm) {
   522→          error(`Confirm deletion of skill '${skill.id}' with --confirm flag`);
   523→          process.exit(EXIT_CODES.ERROR);
   524→        }
   525→
   526→        // Check for dependencies from other skills
   527→        const dependentSkills = metaCtx.skills.filter(
   528→          (s) =>
   529→            s._ulid !== skill._ulid &&
   530→            s.depends_on?.some(
   531→              (dep) =>
   532→                dep === `@${skill.id}` ||
   533→                dep === skill.id ||
   534→                dep.startsWith(`@${skill._ulid.substring(0, 8)}`),
   535→            ),
   536→        );
   537→
   538→        if (dependentSkills.length > 0) {
   539→          const depRefs = dependentSkills.map((s) => `@${s.id}`).join(", ");
   540→          error(
   541→            `Cannot delete skill '${skill.id}': referenced by ${dependentSkills.length} skill(s): ${depRefs}`,
   542→          );
   543→          process.exit(EXIT_CODES.ERROR);
   544→        }
   545→
   546→        // AC: @skill-cli ac-7, ac-8 - delete meta entry and directory
   547→        const deleted = await deleteMetaItem(ctx, skill._ulid, "skill");
   548→
   549→        if (!deleted) {
   550→          error(`Failed to delete skill: ${skill.id}`);
   551→          process.exit(EXIT_CODES.ERROR);
   552→        }
   553→
   554→        // Commit changes
   555→        await commitIfShadow(ctx.shadow, "skill-delete", skill.id);
   556→
   557→        success(`Deleted skill: ${skill.id}`);
   558→      } catch (err) {
   559→        error("Failed to delete skill", err);
   560→        process.exit(EXIT_CODES.ERROR);
   561→      }
   562→    });
   563→
   564→  // AC: @skill-import ac-1 through ac-7 - kspec skill import
   565→  markMutating(skill.command("import <file>"))
   566→    .description("Import an existing SKILL.md file into kspec")
   567→    .option("--id <id>", "Custom skill ID (defaults to directory name)")
   568→    .option("--name <name>", "Skill name (required if no frontmatter)")
   569→    .option("--description <desc>", "Skill description (required if no frontmatter)")
   570→    .option(
   571→      "--origin <origin>",
   572→      "Skill origin (core, project, local)",
   573→      "project",
   574→    )
   575→    .option("--skill-version <version>", "Skill version")
   576→    .action(async (file: string, options) => {
   577→      try {
   578→        const ctx = await initContext();
   579→
   580→        if (!ctx.manifestPath) {
   581→          error(errors.project.noKspecProject);
   582→          process.exit(EXIT_CODES.ERROR);
   583→        }
   584→
   585→        // Resolve file path
   586→        const filePath = path.isAbsolute(file)
   587→          ? file
   588→          : path.resolve(process.cwd(), file);
   589→
   590→        // Check file exists
   591→        try {
   592→          await fs.access(filePath);
   593→        } catch {
   594→          error(`File not found: ${filePath}`);
   595→          process.exit(EXIT_CODES.NOT_FOUND);
   596→        }
   597→
   598→        // Read file content
   599→        const content = await fs.readFile(filePath, "utf-8");
   600→
   601→        // AC: @skill-import ac-1, ac-6 - Parse YAML frontmatter
   602→        const frontmatter = parseFrontmatter(content);
   603→
   604→        // Determine name and description from frontmatter or options
   605→        const skillName = options.name || frontmatter?.name;
   606→        const skillDescription = options.description || frontmatter?.description;
   607→
   608→        // AC: @skill-import ac-6 - Error if no name/description and no frontmatter
   609→        if (!skillName) {
   610→          error("Name is required. Either add YAML frontmatter with 'name' field or use --name option.");
   611→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   612→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   613→        }
   614→
   615→        if (!skillDescription) {
   616→          error("Description is required. Either add YAML frontmatter with 'description' field or use --description option.");
   617→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   618→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   619→        }
   620→
   621→        // AC: @skill-import ac-5 - Derive ID from directory name or use custom
   622→        const sourceDir = path.dirname(filePath);
   623→        const derivedId = path.basename(sourceDir);
   624→        const skillId = options.id || derivedId;
   625→
   626→        // Validate origin
   627→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   628→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   629→          error(
   630→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   631→          );
   632→          process.exit(EXIT_CODES.ERROR);
   633→        }
   634→
   635→        // Check if skill with this ID already exists
   636→        const metaCtx = await loadMetaContext(ctx);
   637→        const existingSkill = metaCtx.skills.find((s) => s.id === skillId);
   638→        if (existingSkill) {
   639→          error(`Skill with ID '${skillId}' already exists. Use --id to specify a different ID.`);
   640→          process.exit(EXIT_CODES.CONFLICT);
   641→        }
   642→
   643→        // Build skill object
   644→        const skillData: Skill = {
   645→          _ulid: ulid(),
   646→          id: skillId,
   647→          name: skillName,
   648→          description: skillDescription,
   649→          origin: options.origin as SkillOrigin,
   650→          version: options.skillVersion,
   651→          platforms: ["claude-code"],
   652→          depends_on: [],
   653→          tags: [],
   654→        };
   655→
   656→        // Validate with schema
   657→        const parsed = SkillSchema.safeParse(skillData);
   658→        if (!parsed.success) {
   659→          const issues = parsed.error.issues
   660→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   661→            .join("; ");
   662→          error(`Invalid skill data: ${issues}`);
   663→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   664→        }
   665→
   666→        const skill: LoadedSkill = { ...parsed.data };
   667→
   668→        // Save meta entry (also creates directory)
   669→        await saveMetaItem(ctx, skill, "skill");
   670→
   671→        // AC: @skill-import ac-7 - Strip/normalize base-directory paths
   672→        const normalizedContent = normalizeBaseDirectory(content);
   673→
   674→        // AC: @skill-import ac-2 - Copy content to .kspec/skills/<id>/SKILL.md
   675→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   676→        await fs.writeFile(skillMdPath, normalizedContent, "utf-8");
   677→
   678→        // AC: @skill-import ac-3 - Copy docs/ subdirectory if present
   679→        const sourceDocsDir = path.join(sourceDir, "docs");
   680→        try {
   681→          const docsStats = await fs.stat(sourceDocsDir);
   682→          if (docsStats.isDirectory()) {
   683→            const targetDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
   684→            await fs.mkdir(targetDocsDir, { recursive: true });
   685→            await copyDirectory(sourceDocsDir, targetDocsDir);
   686→          }
   687→        } catch {
   688→          // No docs directory, that's fine
   689→        }
   690→
   691→        // Commit changes
   692→        await commitIfShadow(ctx.shadow, "skill-import", skill.id, skill.name);
   693→
   694→        output(skill, () =>
   695→          success(`Imported skill: ${skill.id}`, { skill }),
   696→        );
   697→      } catch (err) {
   698→        error("Failed to import skill", err);
   699→        process.exit(EXIT_CODES.ERROR);
   700→      }
   701→    });
   702→}
   703→
   704→/**
   705→ * Parse YAML frontmatter from markdown content.
   706→ * Returns null if no valid frontmatter found.
   707→ */
   708→function parseFrontmatter(content: string): { name?: string; description?: string } | null {
   709→  const frontmatterRegex = /^---\n([\s\S]*?)\n---/;
   710→  const match = content.match(frontmatterRegex);
   711→
   712→  if (!match) {
   713→    return null;
   714→  }
   715→
   716→  try {
   717→    const parsed = yaml.parse(match[1]);
   718→
   719→    if (typeof parsed === "object" && parsed !== null) {
   720→      return {
   721→        name: typeof parsed.name === "string" ? parsed.name : undefined,
   722→        description: typeof parsed.description === "string" ? parsed.description : undefined,
   723→      };
   724→    }
   725→  } catch {
   726→    // Invalid YAML in frontmatter
   727→  }
   728→
   729→  return null;
   730→}
   731→
   732→/**
   733→ * Normalize base-directory paths in skill content.
   734→ * AC: @skill-import ac-7 - Strip or convert absolute paths to relative.
   735→ *
   736→ * Matches patterns like:
   737→ * - "Base directory for this skill: /absolute/path/to/skill"
   738→ * - Lines starting with hardcoded paths
   739→ */
   740→function normalizeBaseDirectory(content: string): string {
   741→  // Remove or normalize "Base directory for this skill:" lines with absolute paths
   742→  // Common pattern in Claude-generated skill files
   743→  const baseDirLineRegex = /^Base directory for this skill:.*$/gm;
   744→
   745→  return content.replace(baseDirLineRegex, "");
   746→}
   747→
   748→/**
   749→ * Recursively copy a directory
   750→ */
   751→async function copyDirectory(src: string, dest: string): Promise<void> {
   752→  const entries = await fs.readdir(src, { withFileTypes: true });
   753→
   754→  for (const entry of entries) {
   755→    const srcPath = path.join(src, entry.name);
   756→    const destPath = path.join(dest, entry.name);
   757→
   758→    if (entry.isDirectory()) {
   759→      await fs.mkdir(destPath, { recursive: true });
   760→      await copyDirectory(srcPath, destPath);
   761→    } else {
   762→      await fs.copyFile(srcPath, destPath);
   763→    }
   764→  }
   765→}
   766→

