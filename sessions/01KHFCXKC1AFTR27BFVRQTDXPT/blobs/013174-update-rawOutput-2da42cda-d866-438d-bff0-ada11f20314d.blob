     1→/**
     2→ * Tests for Skill Rendering Pipeline
     3→ * AC: @skill-rendering ac-1 through ac-5
     4→ * AC: @trait-dry-run (dry run support)
     5→ */
     6→
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import * as fs from 'node:fs/promises';
     9→import * as path from 'node:path';
    10→import {
    11→  kspec as kspecFull,
    12→  kspecOutput as kspec,
    13→  kspecJson,
    14→  setupTempFixtures,
    15→  cleanupTempDir,
    16→  initGitRepo,
    17→} from './helpers/cli';
    18→
    19→describe('Skill Rendering Pipeline', () => {
    20→  let tempDir: string;
    21→
    22→  beforeEach(async () => {
    23→    tempDir = await setupTempFixtures();
    24→    await initGitRepo(tempDir);
    25→
    26→    // Create a test skill
    27→    const result = kspecFull(
    28→      'skill add --id test-skill --name "Test Skill" --description "A test skill for rendering" --platform claude-code',
    29→      tempDir
    30→    );
    31→    if (result.exitCode !== 0) {
    32→      throw new Error(`skill add failed: ${result.stderr || result.stdout}`);
    33→    }
    34→
    35→    // Note: In test fixtures (non-shadow mode), skills are at tempDir/skills/ not tempDir/.kspec/skills/
    36→    const skillMdPath = path.join(tempDir, 'skills', 'test-skill', 'SKILL.md');
    37→
    38→    // Write custom content to the skill's SKILL.md
    39→    await fs.writeFile(skillMdPath, '# Test Skill\n\nThis is test content.\n', 'utf-8');
    40→  });
    41→
    42→  afterEach(async () => {
    43→    await cleanupTempDir(tempDir);
    44→  });
    45→
    46→  // AC: @skill-rendering ac-1
    47→  describe('ac-1: Creates .claude/skills/<id>/SKILL.md with YAML frontmatter', () => {
    48→    it('should create SKILL.md with YAML frontmatter when rendering', async () => {
    49→      kspecFull('skill render', tempDir);
    50→
    51→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
    52→      const content = await fs.readFile(renderedPath, 'utf-8');
    53→
    54→      // Check frontmatter exists
    55→      expect(content).toMatch(/^---\n/);
    56→      expect(content).toContain('name: test-skill');
    57→      expect(content).toContain('description: A test skill for rendering');
    58→      expect(content).toContain('---');
    59→
    60→      // Check marker is present
    61→      expect(content).toContain('<!-- kspec-managed -->');
    62→
    63→      // Check original content is preserved
    64→      expect(content).toContain('# Test Skill');
    65→      expect(content).toContain('This is test content.');
    66→    });
    67→
    68→    it('should use skill id as frontmatter name', async () => {
    69→      kspecFull('skill render', tempDir);
    70→
    71→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
    72→      const content = await fs.readFile(renderedPath, 'utf-8');
    73→
    74→      // name should be the skill id, not the skill name
    75→      expect(content).toContain('name: test-skill');
    76→    });
    77→  });
    78→
    79→  // AC: @skill-rendering ac-2
    80→  describe('ac-2: Copies docs to .claude/skills/<id>/docs/', () => {
    81→    beforeEach(async () => {
    82→      // Create docs directory in source
    83→      const docsDir = path.join(tempDir, 'skills', 'test-skill', 'docs');
    84→      await fs.mkdir(docsDir, { recursive: true });
    85→      await fs.writeFile(path.join(docsDir, 'quickref.md'), '# Quick Reference\n\nSome docs.\n', 'utf-8');
    86→      await fs.writeFile(path.join(docsDir, 'advanced.md'), '# Advanced Guide\n\nMore docs.\n', 'utf-8');
    87→    });
    88→
    89→    it('should copy docs directory to rendered location', async () => {
    90→      kspecFull('skill render', tempDir);
    91→
    92→      const renderedDocsDir = path.join(tempDir, '.claude', 'skills', 'test-skill', 'docs');
    93→      const quickref = await fs.readFile(path.join(renderedDocsDir, 'quickref.md'), 'utf-8');
    94→      const advanced = await fs.readFile(path.join(renderedDocsDir, 'advanced.md'), 'utf-8');
    95→
    96→      expect(quickref).toContain('# Quick Reference');
    97→      expect(advanced).toContain('# Advanced Guide');
    98→    });
    99→
   100→    it('should work when skill has no docs directory', async () => {
   101→      // Remove the docs we just created
   102→      await fs.rm(path.join(tempDir, 'skills', 'test-skill', 'docs'), { recursive: true });
   103→
   104→      const result = kspecFull('skill render', tempDir);
   105→      expect(result.exitCode).toBe(0);
   106→
   107→      // Should still render the skill successfully
   108→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   109→      const content = await fs.readFile(renderedPath, 'utf-8');
   110→      expect(content).toContain('# Test Skill');
   111→    });
   112→  });
   113→
   114→  // AC: @skill-rendering ac-3
   115→  describe('ac-3: Idempotent rendering', () => {
   116→    it('should not modify files when called twice with no content changes', async () => {
   117→      // First render
   118→      kspecFull('skill render', tempDir);
   119→
   120→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   121→      const firstRenderStats = await fs.stat(renderedPath);
   122→      const firstRenderMtime = firstRenderStats.mtimeMs;
   123→
   124→      // Wait a bit to ensure different mtime if file is modified
   125→      await new Promise((resolve) => setTimeout(resolve, 10));
   126→
   127→      // Second render - should report unchanged
   128→      const result = kspecFull('skill render', tempDir);
   129→      expect(result.stdout).toContain('Unchanged');
   130→
   131→      // Check file was not modified
   132→      const secondRenderStats = await fs.stat(renderedPath);
   133→      expect(secondRenderStats.mtimeMs).toBe(firstRenderMtime);
   134→    });
   135→
   136→    it('should update files when source content changes', async () => {
   137→      // First render
   138→      kspecFull('skill render', tempDir);
   139→
   140→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   141→      const firstContent = await fs.readFile(renderedPath, 'utf-8');
   142→
   143→      // Modify source
   144→      const skillMdPath = path.join(tempDir, 'skills', 'test-skill', 'SKILL.md');
   145→      await fs.writeFile(skillMdPath, '# Test Skill\n\nUpdated content!\n', 'utf-8');
   146→
   147→      // Second render
   148→      const result = kspecFull('skill render', tempDir);
   149→      expect(result.stdout).toContain('Updated');
   150→
   151→      // Check file was updated
   152→      const secondContent = await fs.readFile(renderedPath, 'utf-8');
   153→      expect(secondContent).toContain('Updated content!');
   154→      expect(secondContent).not.toBe(firstContent);
   155→    });
   156→
   157→    it('should report unchanged in JSON output when no changes', async () => {
   158→      kspecFull('skill render', tempDir);
   159→
   160→      const result = kspecJson<{
   161→        dry_run: boolean;
   162→        rendered: Array<{ id: string; action: string }>;
   163→      }>('skill render', tempDir);
   164→
   165→      expect(result.rendered[0].action).toBe('unchanged');
   166→    });
   167→  });
   168→
   169→  // AC: @skill-rendering ac-4, ac-5
   170→  describe('ac-4, ac-5: Clean removes orphaned managed skills', () => {
   171→    it('should remove managed skill directories that no longer exist in meta', async () => {
   172→      // Render the skill first
   173→      kspecFull('skill render', tempDir);
   174→
   175→      // Verify it was rendered
   176→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   177→      await fs.access(renderedPath);
   178→
   179→      // Delete the skill from meta
   180→      kspecFull('skill delete test-skill --confirm', tempDir);
   181→
   182→      // Run render --clean
   183→      const result = kspecFull('skill render --clean', tempDir);
   184→      expect(result.stdout).toContain('Removed');
   185→      expect(result.stdout).toContain('test-skill');
   186→
   187→      // Verify directory was removed
   188→      await expect(fs.access(path.join(tempDir, '.claude', 'skills', 'test-skill'))).rejects.toThrow();
   189→    });
   190→
   191→    it('should NOT remove unmanaged skill directories (ac-4)', async () => {
   192→      // Create an unmanaged skill directory (no kspec-managed marker)
   193→      const unmanagedDir = path.join(tempDir, '.claude', 'skills', 'unmanaged-skill');
   194→      await fs.mkdir(unmanagedDir, { recursive: true });
   195→      await fs.writeFile(
   196→        path.join(unmanagedDir, 'SKILL.md'),
   197→        '---\nname: unmanaged\n---\n\n# Unmanaged\n\nNo marker.\n',
   198→        'utf-8'
   199→      );
   200→
   201→      // Run render --clean
   202→      const result = kspecFull('skill render --clean', tempDir);
   203→      expect(result.stdout).toContain('Skipped');
   204→      expect(result.stdout).toContain('unmanaged');
   205→
   206→      // Verify directory was NOT removed
   207→      const content = await fs.readFile(path.join(unmanagedDir, 'SKILL.md'), 'utf-8');
   208→      expect(content).toContain('# Unmanaged');
   209→    });
   210→
   211→    it('should identify managed skills by kspec-managed marker', async () => {
   212→      // Render a skill (will have marker)
   213→      kspecFull('skill render', tempDir);
   214→
   215→      // Create another "orphan" with the marker manually
   216→      const orphanDir = path.join(tempDir, '.claude', 'skills', 'orphan-skill');
   217→      await fs.mkdir(orphanDir, { recursive: true });
   218→      await fs.writeFile(
   219→        path.join(orphanDir, 'SKILL.md'),
   220→        '---\nname: orphan\n---\n<!-- kspec-managed -->\n\n# Orphan\n',
   221→        'utf-8'
   222→      );
   223→
   224→      // Delete the original skill
   225→      kspecFull('skill delete test-skill --confirm', tempDir);
   226→
   227→      // Run render --clean - should remove both orphaned managed skills
   228→      const result = kspecFull('skill render --clean', tempDir);
   229→
   230→      // Both should be removed
   231→      await expect(fs.access(path.join(tempDir, '.claude', 'skills', 'test-skill'))).rejects.toThrow();
   232→      await expect(fs.access(path.join(tempDir, '.claude', 'skills', 'orphan-skill'))).rejects.toThrow();
   233→    });
   234→  });
   235→
   236→  // AC: @trait-dry-run
   237→  describe('Dry run mode (trait)', () => {
   238→    it('should not modify files when --dry-run is provided (ac-2)', async () => {
   239→      kspecFull('skill render --dry-run', tempDir);
   240→
   241→      // Rendered directory should NOT exist
   242→      await expect(
   243→        fs.access(path.join(tempDir, '.claude', 'skills', 'test-skill'))
   244→      ).rejects.toThrow();
   245→    });
   246→
   247→    it('should show what would be changed (ac-1)', async () => {
   248→      const result = kspecFull('skill render --dry-run', tempDir);
   249→
   250→      expect(result.stdout).toContain('DRY RUN');
   251→      expect(result.stdout).toContain('Created');
   252→      expect(result.stdout).toContain('test-skill');
   253→    });
   254→
   255→    it('should include dry_run boolean in JSON output (ac-6)', async () => {
   256→      const result = kspecJson<{ dry_run: boolean }>('skill render --dry-run', tempDir);
   257→      expect(result.dry_run).toBe(true);
   258→    });
   259→
   260→    it('should not remove orphaned skills in dry run mode with --clean', async () => {
   261→      // First render normally
   262→      kspecFull('skill render', tempDir);
   263→
   264→      // Delete skill from meta
   265→      kspecFull('skill delete test-skill --confirm', tempDir);
   266→
   267→      // Dry run clean
   268→      kspecFull('skill render --clean --dry-run', tempDir);
   269→
   270→      // Directory should still exist
   271→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   272→      await fs.access(renderedPath);
   273→    });
   274→  });
   275→
   276→  // AC: @skill-render-cli ac-2
   277→  describe('ac-2: Filtering by skill (positional ref)', () => {
   278→    beforeEach(async () => {
   279→      // Add another skill
   280→      kspecFull(
   281→        'skill add --id another-skill --name "Another Skill" --description "Another test skill"',
   282→        tempDir
   283→      );
   284→      const anotherSkillMd = path.join(tempDir, 'skills', 'another-skill', 'SKILL.md');
   285→      await fs.writeFile(anotherSkillMd, '# Another Skill\n\nAnother content.\n', 'utf-8');
   286→    });
   287→
   288→    it('should render only specified skill with positional ref', async () => {
   289→      // AC: @skill-render-cli ac-2 - kspec skill render @task-work renders only that skill
   290→      kspecFull('skill render @test-skill', tempDir);
   291→
   292→      // test-skill should be rendered
   293→      const testSkillPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   294→      await fs.access(testSkillPath);
   295→
   296→      // another-skill should NOT be rendered
   297→      await expect(
   298→        fs.access(path.join(tempDir, '.claude', 'skills', 'another-skill'))
   299→      ).rejects.toThrow();
   300→    });
   301→
   302→    it('should render only specified skill with --skill option (deprecated)', async () => {
   303→      kspecFull('skill render --skill test-skill', tempDir);
   304→
   305→      // test-skill should be rendered
   306→      const testSkillPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   307→      await fs.access(testSkillPath);
   308→
   309→      // another-skill should NOT be rendered
   310→      await expect(
   311→        fs.access(path.join(tempDir, '.claude', 'skills', 'another-skill'))
   312→      ).rejects.toThrow();
   313→    });
   314→
   315→    it('should error when specified skill ref not found', async () => {
   316→      const result = kspecFull('skill render @nonexistent', tempDir);
   317→      expect(result.exitCode).not.toBe(0);
   318→      expect(result.stderr).toContain('Skill not found');
   319→    });
   320→  });
   321→
   322→  describe('Platform filtering', () => {
   323→    beforeEach(async () => {
   324→      // Add a skill with different platform
   325→      kspecFull(
   326→        'skill add --id copilot-skill --name "Copilot Skill" --description "For Copilot" --platform copilot',
   327→        tempDir
   328→      );
   329→    });
   330→
   331→    it('should only render skills with claude-code platform', async () => {
   332→      kspecFull('skill render', tempDir);
   333→
   334→      // claude-code skill should be rendered
   335→      const testSkillPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   336→      await fs.access(testSkillPath);
   337→
   338→      // copilot skill should NOT be rendered
   339→      await expect(
   340→        fs.access(path.join(tempDir, '.claude', 'skills', 'copilot-skill'))
   341→      ).rejects.toThrow();
   342→    });
   343→  });
   344→
   345→  describe('Edge cases', () => {
   346→    it('should handle skills with no source SKILL.md', async () => {
   347→      // Delete the source SKILL.md
   348→      await fs.rm(path.join(tempDir, 'skills', 'test-skill', 'SKILL.md'));
   349→
   350→      const result = kspecFull('skill render', tempDir);
   351→      expect(result.exitCode).toBe(0);
   352→
   353→      // Should create a placeholder
   354→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   355→      const content = await fs.readFile(renderedPath, 'utf-8');
   356→      expect(content).toContain('name: test-skill');
   357→      expect(content).toContain('<!-- kspec-managed -->');
   358→    });
   359→
   360→    it('should strip existing frontmatter from source and replace with generated', async () => {
   361→      // Write source with frontmatter
   362→      const skillMdPath = path.join(tempDir, 'skills', 'test-skill', 'SKILL.md');
   363→      await fs.writeFile(
   364→        skillMdPath,
   365→        '---\nname: wrong-name\ndescription: wrong description\n---\n\n# Actual Content\n',
   366→        'utf-8'
   367→      );
   368→
   369→      kspecFull('skill render', tempDir);
   370→
   371→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   372→      const content = await fs.readFile(renderedPath, 'utf-8');
   373→
   374→      // Should have new frontmatter
   375→      expect(content).toContain('name: test-skill');
   376→      expect(content).toContain('description: A test skill for rendering');
   377→
   378→      // Should NOT have duplicate frontmatter
   379→      const frontmatterMatches = content.match(/^---/gm);
   380→      expect(frontmatterMatches?.length).toBe(2); // opening and closing
   381→
   382→      // Should have the content
   383→      expect(content).toContain('# Actual Content');
   384→    });
   385→
   386→    it('should work when .claude/skills directory does not exist', async () => {
   387→      // Remove .claude directory if it exists
   388→      try {
   389→        await fs.rm(path.join(tempDir, '.claude'), { recursive: true });
   390→      } catch {
   391→        // Already doesn't exist
   392→      }
   393→
   394→      const result = kspecFull('skill render', tempDir);
   395→      expect(result.exitCode).toBe(0);
   396→
   397→      // Directory should be created
   398→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   399→      await fs.access(renderedPath);
   400→    });
   401→
   402→    it('should work when no skills exist', async () => {
   403→      // Delete all skills
   404→      kspecFull('skill delete test-skill --confirm', tempDir);
   405→
   406→      const result = kspecFull('skill render', tempDir);
   407→      expect(result.exitCode).toBe(0);
   408→      expect(result.stdout).toContain('No changes needed');
   409→    });
   410→  });
   411→});
   412→
   413→/**
   414→ * Tests for Skill Render CLI commands
   415→ * AC: @skill-render-cli ac-3, ac-4
   416→ */
   417→describe('Skill Render CLI', () => {
   418→  let tempDir: string;
   419→
   420→  beforeEach(async () => {
   421→    tempDir = await setupTempFixtures();
   422→    await initGitRepo(tempDir);
   423→
   424→    // Create a test skill
   425→    const result = kspecFull(
   426→      'skill add --id test-skill --name "Test Skill" --description "A test skill" --platform claude-code',
   427→      tempDir
   428→    );
   429→    if (result.exitCode !== 0) {
   430→      throw new Error(`skill add failed: ${result.stderr || result.stdout}`);
   431→    }
   432→
   433→    // Write custom content to the skill's SKILL.md
   434→    const skillMdPath = path.join(tempDir, 'skills', 'test-skill', 'SKILL.md');
   435→    await fs.writeFile(skillMdPath, '# Test Skill\n\nThis is test content.\n', 'utf-8');
   436→  });
   437→
   438→  afterEach(async () => {
   439→    await cleanupTempDir(tempDir);
   440→  });
   441→
   442→  // AC: @skill-render-cli ac-3
   443→  describe('ac-3: kspec skill status shows sync status table', () => {
   444→    it('should show "not-rendered" for skills not yet rendered', async () => {
   445→      const result = kspecFull('skill status', tempDir);
   446→      expect(result.exitCode).toBe(0);
   447→      expect(result.stdout).toContain('test-skill');
   448→      expect(result.stdout).toContain('not-rendered');
   449→    });
   450→
   451→    it('should show "in-sync" for skills that are in sync', async () => {
   452→      // Render the skill first
   453→      kspecFull('skill render', tempDir);
   454→
   455→      const result = kspecFull('skill status', tempDir);
   456→      expect(result.exitCode).toBe(0);
   457→      expect(result.stdout).toContain('test-skill');
   458→      expect(result.stdout).toContain('in-sync');
   459→      expect(result.stdout).toContain('All skills in sync');
   460→    });
   461→
   462→    it('should show "drifted" when rendered file differs from source', async () => {
   463→      // Render the skill
   464→      kspecFull('skill render', tempDir);
   465→
   466→      // Modify the rendered file directly
   467→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   468→      const content = await fs.readFile(renderedPath, 'utf-8');
   469→      await fs.writeFile(renderedPath, content + '\n\n# Added Section\n', 'utf-8');
   470→
   471→      const result = kspecFull('skill status', tempDir);
   472→      expect(result.exitCode).toBe(0);
   473→      expect(result.stdout).toContain('test-skill');
   474→      expect(result.stdout).toContain('drifted');
   475→      expect(result.stdout).toContain("run 'kspec skill render' to sync");
   476→    });
   477→
   478→    it('should output JSON with status fields', async () => {
   479→      kspecFull('skill render', tempDir);
   480→
   481→      const result = kspecJson<Array<{ id: string; status: string; docsStatus: string }>>(
   482→        'skill status',
   483→        tempDir
   484→      );
   485→
   486→      expect(result).toHaveLength(1);
   487→      expect(result[0].id).toBe('test-skill');
   488→      expect(result[0].status).toBe('in-sync');
   489→      expect(result[0].docsStatus).toBe('no-docs');
   490→    });
   491→
   492→    it('should track docs status separately', async () => {
   493→      // Add docs directory
   494→      const docsDir = path.join(tempDir, 'skills', 'test-skill', 'docs');
   495→      await fs.mkdir(docsDir, { recursive: true });
   496→      await fs.writeFile(path.join(docsDir, 'guide.md'), '# Guide\n', 'utf-8');
   497→
   498→      // Render
   499→      kspecFull('skill render', tempDir);
   500→
   501→      // Check status (should be in-sync)
   502→      let result = kspecJson<Array<{ id: string; status: string; docsStatus: string }>>(
   503→        'skill status',
   504→        tempDir
   505→      );
   506→      expect(result[0].docsStatus).toBe('in-sync');
   507→
   508→      // Modify source docs
   509→      await fs.writeFile(path.join(docsDir, 'guide.md'), '# Guide\n\nUpdated content.\n', 'utf-8');
   510→
   511→      // Check status again (docs should be drifted)
   512→      result = kspecJson<Array<{ id: string; status: string; docsStatus: string }>>(
   513→        'skill status',
   514→        tempDir
   515→      );
   516→      expect(result[0].docsStatus).toBe('drifted');
   517→    });
   518→  });
   519→
   520→  // AC: @skill-render-cli ac-4
   521→  describe('ac-4: kspec skill diff shows unified diff', () => {
   522→    it('should show "in sync" message when no diff', async () => {
   523→      // Render the skill
   524→      kspecFull('skill render', tempDir);
   525→
   526→      const result = kspecFull('skill diff test-skill', tempDir);
   527→      expect(result.exitCode).toBe(0);
   528→      expect(result.stdout).toContain('in sync');
   529→    });
   530→
   531→    it('should show unified diff when rendered file differs', async () => {
   532→      // Render the skill
   533→      kspecFull('skill render', tempDir);
   534→
   535→      // Modify the rendered file
   536→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   537→      const content = await fs.readFile(renderedPath, 'utf-8');
   538→      await fs.writeFile(renderedPath, content.replace('test content', 'modified content'), 'utf-8');
   539→
   540→      const result = kspecFull('skill diff test-skill', tempDir);
   541→      expect(result.exitCode).toBe(0);
   542→      expect(result.stdout).toContain('drifted');
   543→      expect(result.stdout).toContain('---'); // Diff header
   544→      expect(result.stdout).toContain('+++'); // Diff header
   545→      expect(result.stdout).toContain('@@'); // Hunk header
   546→    });
   547→
   548→    it('should show full diff when rendered file does not exist', async () => {
   549→      // Don't render, so rendered file doesn't exist
   550→      const result = kspecFull('skill diff test-skill', tempDir);
   551→      expect(result.exitCode).toBe(0);
   552→      expect(result.stdout).toContain('drifted');
   553→      expect(result.stdout).toContain('+'); // All lines are additions
   554→    });
   555→
   556→    it('should error when skill not found', async () => {
   557→      const result = kspecFull('skill diff nonexistent', tempDir);
   558→      expect(result.exitCode).not.toBe(0);
   559→      expect(result.stderr).toContain('Skill not found');
   560→    });
   561→
   562→    it('should output JSON with diff lines', async () => {
   563→      kspecFull('skill render', tempDir);
   564→
   565→      // Modify rendered file
   566→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   567→      const content = await fs.readFile(renderedPath, 'utf-8');
   568→      await fs.writeFile(renderedPath, content.replace('test content', 'changed'), 'utf-8');
   569→
   570→      const result = kspecJson<{ id: string; hasDiff: boolean; diff: string[] }>(
   571→        'skill diff test-skill',
   572→        tempDir
   573→      );
   574→
   575→      expect(result.id).toBe('test-skill');
   576→      expect(result.hasDiff).toBe(true);
   577→      expect(result.diff).toBeInstanceOf(Array);
   578→      expect(result.diff.length).toBeGreaterThan(0);
   579→      expect(result.diff.some((line) => line.startsWith('---'))).toBe(true);
   580→      expect(result.diff.some((line) => line.startsWith('+++'))).toBe(true);
   581→    });
   582→
   583→    it('should return empty diff array when in sync', async () => {
   584→      kspecFull('skill render', tempDir);
   585→
   586→      const result = kspecJson<{ id: string; hasDiff: boolean; diff: string[] }>(
   587→        'skill diff test-skill',
   588→        tempDir
   589→      );
   590→
   591→      expect(result.hasDiff).toBe(false);
   592→      expect(result.diff).toEqual([]);
   593→    });
   594→  });
   595→});
