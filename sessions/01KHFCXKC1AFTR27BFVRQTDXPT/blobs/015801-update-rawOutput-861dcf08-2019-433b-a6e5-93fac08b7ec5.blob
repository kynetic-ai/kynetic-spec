     1→/**
     2→ * Agent instruction generation commands.
     3→ *
     4→ * AC: @agent-instruction-gen ac-1 - kspec agents generate creates kspec-agents.md in project root
     5→ * AC: @agent-instruction-gen ac-2 - output includes Finding Information table with row per skill
     6→ * AC: @agent-instruction-gen ac-3 - output includes conventions section listing rules by domain
     7→ * AC: @agent-instruction-gen ac-4 - output contains freshness comment with kspec version and timestamp
     8→ * AC: @agent-instruction-gen ac-5 - kspec agents status reports stale when not regenerated after meta changes
     9→ *
    10→ * AC: @agents-cli ac-1 - kspec agents generate writes kspec-agents.md to project root
    11→ * AC: @agents-cli ac-2 - kspec agents generate --dry-run prints content without writing
    12→ * AC: @agents-cli ac-3 - kspec agents status reports up to date when current
    13→ * AC: @agents-cli ac-4 - kspec agents status reports stale when meta changed
    14→ */
    15→
    16→import * as crypto from "node:crypto";
    17→import * as fs from "node:fs/promises";
    18→import { createRequire } from "node:module";
    19→import * as path from "node:path";
    20→import chalk from "chalk";
    21→import type { Command } from "commander";
    22→import {
    23→  initContext,
    24→  loadMetaContext,
    25→  type LoadedConvention,
    26→  type LoadedSkill,
    27→  type LoadedWorkflow,
    28→} from "../../parser/index.js";
    29→import { errors } from "../../strings/errors.js";
    30→import { EXIT_CODES } from "../exit-codes.js";
    31→import { error, output, success } from "../output.js";
    32→
    33→// Read version from package.json at runtime
    34→const require = createRequire(import.meta.url);
    35→const { version } = require("../../../package.json");
    36→
    37→/**
    38→ * File name for generated agent instructions
    39→ */
    40→const GENERATED_FILE_NAME = "kspec-agents.md";
    41→
    42→/**
    43→ * Hash file name for tracking freshness
    44→ */
    45→const HASH_FILE_NAME = ".kspec-agents-hash";
    46→
    47→/**
    48→ * Compute SHA256 hash of content
    49→ */
    50→function computeHash(content: string): string {
    51→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
    52→}
    53→
    54→/**
    55→ * Generate a hash of the meta content that affects the generated file.
    56→ * This is used to detect if the generated file is stale.
    57→ */
    58→function computeMetaHash(
    59→  skills: LoadedSkill[],
    60→  conventions: LoadedConvention[],
    61→  workflows: LoadedWorkflow[],
    62→): string {
    63→  // Create a stable representation of the meta content
    64→  const data = {
    65→    skills: skills.map((s) => ({
    66→      id: s.id,
    67→      name: s.name,
    68→      description: s.description,
    69→    })),
    70→    conventions: conventions.map((c) => ({
    71→      domain: c.domain,
    72→      rules: c.rules,
    73→    })),
    74→    workflows: workflows.map((w) => ({
    75→      id: w.id,
    76→      trigger: w.trigger,
    77→      description: w.description,
    78→    })),
    79→  };
    80→  return computeHash(JSON.stringify(data));
    81→}
    82→
    83→/**
    84→ * Generate the Finding Information table for skills.
    85→ * AC: @agent-instruction-gen ac-2 - Finding Information table with row per skill
    86→ */
    87→function generateSkillsTable(skills: LoadedSkill[]): string {
    88→  if (skills.length === 0) {
    89→    return "";
    90→  }
    91→
    92→  const lines: string[] = [
    93→    "## Finding Information",
    94→    "",
    95→    "Use skills and CLI help for detailed documentation:",
    96→    "",
    97→    "| Need | Where to look |",
    98→    "|------|---------------|",
    99→  ];
   100→
   101→  for (const skill of skills) {
   102→    const description = skill.description || skill.name;
   103→    // Use the skill ID as the reference (prefixed with /)
   104→    lines.push(`| ${description} | \`/${skill.id}\` skill |`);
   105→  }
   106→
   107→  lines.push("");
   108→  lines.push(
   109→    "Skills inject their full documentation when invoked — you don't need to memorize their contents.",
   110→  );
   111→  lines.push("");
   112→
   113→  return lines.join("\n");
   114→}
   115→
   116→/**
   117→ * Generate the conventions section.
   118→ * AC: @agent-instruction-gen ac-3 - conventions section listing rules by domain
   119→ */
   120→function generateConventionsSection(conventions: LoadedConvention[]): string {
   121→  if (conventions.length === 0) {
   122→    return "";
   123→  }
   124→
   125→  const lines: string[] = ["## Conventions", ""];
   126→
   127→  for (const convention of conventions) {
   128→    lines.push(`### ${convention.domain}`);
   129→    lines.push("");
   130→
   131→    for (const rule of convention.rules) {
   132→      lines.push(`- ${rule}`);
   133→    }
   134→
   135→    lines.push("");
   136→  }
   137→
   138→  return lines.join("\n");
   139→}
   140→
   141→/**
   142→ * Generate the workflows summary section.
   143→ */
   144→function generateWorkflowsSection(workflows: LoadedWorkflow[]): string {
   145→  if (workflows.length === 0) {
   146→    return "";
   147→  }
   148→
   149→  const lines: string[] = [
   150→    "## Workflows",
   151→    "",
   152→    "Available workflows:",
   153→    "",
   154→  ];
   155→
   156→  for (const workflow of workflows) {
   157→    const description = workflow.description || workflow.trigger;
   158→    lines.push(`- **${workflow.id}**: ${description}`);
   159→  }
   160→
   161→  lines.push("");
   162→  lines.push("Use `kspec workflow start @workflow-id` to start a workflow.");
   163→  lines.push("");
   164→
   165→  return lines.join("\n");
   166→}
   167→
   168→/**
   169→ * Generate the freshness comment.
   170→ * AC: @agent-instruction-gen ac-4 - freshness comment with kspec version and timestamp
   171→ */
   172→function generateFreshnessComment(timestamp: string): string {
   173→  return `<!-- Generated by kspec v${version} at ${timestamp} -->\n<!-- Do not edit manually - regenerate with: kspec agents generate -->\n\n`;
   174→}
   175→
   176→/**
   177→ * Generate the full kspec-agents.md content
   178→ */
   179→function generateAgentsContent(
   180→  skills: LoadedSkill[],
   181→  conventions: LoadedConvention[],
   182→  workflows: LoadedWorkflow[],
   183→  timestamp: string,
   184→): string {
   185→  const sections: string[] = [];
   186→
   187→  // AC: @agent-instruction-gen ac-4 - freshness comment
   188→  sections.push(generateFreshnessComment(timestamp));
   189→
   190→  // Header
   191→  sections.push("# kspec Agent Instructions\n");
   192→  sections.push(
   193→    "This file is auto-generated from kspec meta. Include it in your AGENTS.md or similar agent instruction file.\n\n",
   194→  );
   195→
   196→  // AC: @agent-instruction-gen ac-2 - Skills table
   197→  const skillsTable = generateSkillsTable(skills);
   198→  if (skillsTable) {
   199→    sections.push(skillsTable);
   200→  }
   201→
   202→  // AC: @agent-instruction-gen ac-3 - Conventions section
   203→  const conventionsSection = generateConventionsSection(conventions);
   204→  if (conventionsSection) {
   205→    sections.push(conventionsSection);
   206→  }
   207→
   208→  // Workflows summary
   209→  const workflowsSection = generateWorkflowsSection(workflows);
   210→  if (workflowsSection) {
   211→    sections.push(workflowsSection);
   212→  }
   213→
   214→  return sections.join("");
   215→}
   216→
   217→/**
   218→ * Result of checking agent file status
   219→ */
   220→interface AgentStatusResult {
   221→  exists: boolean;
   222→  path: string;
   223→  status: "current" | "stale" | "missing";
   224→  metaHash?: string;
   225→  storedHash?: string;
   226→  generatedAt?: string;
   227→}
   228→
   229→/**
   230→ * Check the status of the generated agent file.
   231→ * AC: @agent-instruction-gen ac-5 - reports stale when meta has changed
   232→ */
   233→async function checkAgentStatus(
   234→  projectRoot: string,
   235→  metaHash: string,
   236→): Promise<AgentStatusResult> {
   237→  const filePath = path.join(projectRoot, GENERATED_FILE_NAME);
   238→  const hashPath = path.join(projectRoot, ".kspec", HASH_FILE_NAME);
   239→
   240→  // Check if file exists
   241→  try {
   242→    await fs.access(filePath);
   243→  } catch {
   244→    return {
   245→      exists: false,
   246→      path: filePath,
   247→      status: "missing",
   248→      metaHash,
   249→    };
   250→  }
   251→
   252→  // Check stored hash
   253→  let storedHash: string | undefined;
   254→  let generatedAt: string | undefined;
   255→
   256→  try {
   257→    const hashContent = await fs.readFile(hashPath, "utf-8");
   258→    const hashData = JSON.parse(hashContent);
   259→    storedHash = hashData.metaHash;
   260→    generatedAt = hashData.generatedAt;
   261→  } catch {
   262→    // No hash file, treat as stale
   263→    return {
   264→      exists: true,
   265→      path: filePath,
   266→      status: "stale",
   267→      metaHash,
   268→    };
   269→  }
   270→
   271→  // Compare hashes
   272→  const isCurrent = storedHash === metaHash;
   273→
   274→  return {
   275→    exists: true,
   276→    path: filePath,
   277→    status: isCurrent ? "current" : "stale",
   278→    metaHash,
   279→    storedHash,
   280→    generatedAt,
   281→  };
   282→}
   283→
   284→/**
   285→ * Register agent instruction generation commands
   286→ */
   287→export function registerAgentsCommands(program: Command): void {
   288→  const agents = program
   289→    .command("agents")
   290→    .description("Agent instruction generation commands");
   291→
   292→  // AC: @agent-instruction-gen ac-1 - kspec agents generate
   293→  // AC: @trait-dry-run ac-1 through ac-6 - dry-run support
   294→  agents
   295→    .command("generate")
   296→    .description("Generate kspec-agents.md from meta (skills, conventions, workflows)")
   297→    .option("--dry-run", "Show what would be generated without writing files")
   298→    .action(async (options) => {
   299→      try {
   300→        const ctx = await initContext();
   301→
   302→        if (!ctx.manifestPath) {
   303→          error(errors.project.noKspecProject);
   304→          process.exit(EXIT_CODES.ERROR);
   305→        }
   306→
   307→        const metaCtx = await loadMetaContext(ctx);
   308→        const dryRun = options.dryRun || false;
   309→        const timestamp = new Date().toISOString();
   310→
   311→        // Generate content
   312→        const content = generateAgentsContent(
   313→          metaCtx.skills,
   314→          metaCtx.conventions,
   315→          metaCtx.workflows,
   316→          timestamp,
   317→        );
   318→
   319→        // Compute meta hash for freshness tracking
   320→        const metaHash = computeMetaHash(
   321→          metaCtx.skills,
   322→          metaCtx.conventions,
   323→          metaCtx.workflows,
   324→        );
   325→
   326→        const outputPath = path.join(ctx.rootDir, GENERATED_FILE_NAME);
   327→        const hashPath = path.join(ctx.rootDir, ".kspec", HASH_FILE_NAME);
   328→
   329→        // AC: @trait-dry-run ac-3 - clear indication this is a preview
   330→        if (dryRun) {
   331→          output(
   332→            {
   333→              dry_run: true,
   334→              path: outputPath,
   335→              skills: metaCtx.skills.length,
   336→              conventions: metaCtx.conventions.length,
   337→              workflows: metaCtx.workflows.length,
   338→              content,
   339→            },
   340→            () => {
   341→              console.log(chalk.yellow("DRY RUN - No changes made"));
   342→              console.log();
   343→              console.log(chalk.gray(`Would write to: ${outputPath}`));
   344→              console.log();
   345→              console.log(chalk.gray("--- Generated content ---"));
   346→              console.log(content);
   347→              console.log(chalk.gray("--- End content ---"));
   348→              console.log();
   349→              console.log(
   350→                chalk.yellow("No changes were made. Run without --dry-run to apply."),
   351→              );
   352→            },
   353→          );
   354→          return;
   355→        }
   356→
   357→        // AC: @trait-dry-run ac-2 - no files modified in dry run mode
   358→        // Write the generated file
   359→        await fs.writeFile(outputPath, content, "utf-8");
   360→
   361→        // Write the hash file for freshness tracking
   362→        await fs.mkdir(path.dirname(hashPath), { recursive: true });
   363→        await fs.writeFile(
   364→          hashPath,
   365→          JSON.stringify(
   366→            {
   367→              metaHash,
   368→              generatedAt: timestamp,
   369→              version,
   370→            },
   371→            null,
   372→            2,
   373→          ),
   374→          "utf-8",
   375→        );
   376→
   377→        output(
   378→          {
   379→            path: outputPath,
   380→            skills: metaCtx.skills.length,
   381→            conventions: metaCtx.conventions.length,
   382→            workflows: metaCtx.workflows.length,
   383→            generatedAt: timestamp,
   384→          },
   385→          () => {
   386→            success(`Generated ${GENERATED_FILE_NAME}`, {
   387→              skills: metaCtx.skills.length,
   388→              conventions: metaCtx.conventions.length,
   389→              workflows: metaCtx.workflows.length,
   390→            });
   391→            console.log(chalk.gray(`  Path: ${outputPath}`));
   392→          },
   393→        );
   394→      } catch (err) {
   395→        error("Failed to generate agent instructions", err);
   396→        process.exit(EXIT_CODES.ERROR);
   397→      }
   398→    });
   399→
   400→  // AC: @agent-instruction-gen ac-5 - kspec agents status
   401→  agents
   402→    .command("status")
   403→    .description("Check if kspec-agents.md is up to date with meta")
   404→    .action(async () => {
   405→      try {
   406→        const ctx = await initContext();
   407→
   408→        if (!ctx.manifestPath) {
   409→          error(errors.project.noKspecProject);
   410→          process.exit(EXIT_CODES.ERROR);
   411→        }
   412→
   413→        const metaCtx = await loadMetaContext(ctx);
   414→
   415→        // Compute current meta hash
   416→        const metaHash = computeMetaHash(
   417→          metaCtx.skills,
   418→          metaCtx.conventions,
   419→          metaCtx.workflows,
   420→        );
   421→
   422→        const status = await checkAgentStatus(ctx.rootDir, metaHash);
   423→
   424→        output(status, () => {
   425→          switch (status.status) {
   426→            case "missing":
   427→              console.log(chalk.yellow(`${GENERATED_FILE_NAME} does not exist`));
   428→              console.log();
   429→              console.log(
   430→                chalk.gray("Run 'kspec agents generate' to create it."),
   431→              );
   432→              break;
   433→
   434→            case "stale":
   435→              console.log(
   436→                chalk.yellow(`${GENERATED_FILE_NAME} is stale`),
   437→              );
   438→              console.log();
   439→              console.log(
   440→                chalk.gray(
   441→                  "Meta has changed since the file was generated.",
   442→                ),
   443→              );
   444→              console.log(
   445→                chalk.gray("Run 'kspec agents generate' to regenerate."),
   446→              );
   447→              break;
   448→
   449→            case "current":
   450→              console.log(chalk.green(`${GENERATED_FILE_NAME} is up to date`));
   451→              if (status.generatedAt) {
   452→                console.log(chalk.gray(`  Generated: ${status.generatedAt}`));
   453→              }
   454→              break;
   455→          }
   456→        });
   457→      } catch (err) {
   458→        error("Failed to check agent status", err);
   459→        process.exit(EXIT_CODES.ERROR);
   460→      }
   461→    });
   462→}
   463→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
