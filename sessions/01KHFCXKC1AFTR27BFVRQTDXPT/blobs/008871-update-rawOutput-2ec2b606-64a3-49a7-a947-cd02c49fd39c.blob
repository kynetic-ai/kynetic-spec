    44→  type ObservationType,
    45→  type WorkflowStep,
    46→  WorkflowStepSchema,
    47→} from "../../schema/index.js";
    48→import { errors } from "../../strings/errors.js";
    49→import { executeBatchOperation, formatBatchOutput } from "../batch.js";
    50→import { EXIT_CODES } from "../exit-codes.js";
    51→import { error, isJsonMode, output, success } from "../output.js";
    52→import { parseTagsArray } from "../parse-utils.js";
    53→import { parseIntOption } from "../validators.js";
    54→
    55→/**
    56→ * Resolve a meta reference to its ULID
    57→ * Handles semantic IDs (agent.id, workflow.id, convention.domain) and ULID prefixes
    58→ */
    59→function resolveMetaRefToUlid(
    60→  ref: string,
    61→  metaCtx: MetaContext,
    62→): {
    63→  ulid: string;
    64→  type: "agent" | "workflow" | "convention" | "observation";
    65→} | null {
    66→  const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
    67→
    68→  // Check agents
    69→  const agent = (metaCtx.agents || []).find(
    70→    (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
    71→  );
    72→  if (agent) return { ulid: agent._ulid, type: "agent" };
    73→
    74→  // Check workflows
    75→  const workflow = (metaCtx.workflows || []).find(
    76→    (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
    77→  );
    78→  if (workflow) return { ulid: workflow._ulid, type: "workflow" };
    79→
    80→  // Check conventions
    81→  const convention = (metaCtx.conventions || []).find(
    82→    (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
    83→  );
    84→  if (convention) return { ulid: convention._ulid, type: "convention" };
    85→
    86→  // Check observations
    87→  const observation = (metaCtx.observations || []).find((o) =>
    88→    o._ulid.startsWith(normalizedRef),
    89→  );
    90→  if (observation) return { ulid: observation._ulid, type: "observation" };
    91→
    92→  return null;
    93→}
    94→
    95→/**
    96→ * Batch-compatible resolver for observations.
    97→ * Returns null instead of calling process.exit() to allow partial failure handling.
    98→ * AC: @trait-multi-ref-batch ac-2, ac-8 - Partial failure handling and ref resolution
    99→ */
   100→function resolveObservationRefForBatch(
   101→  ref: string,
   102→  observations: Observation[],
   103→): { item: Observation | null; error?: string } {
   104→  const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
   105→  const observation = observations.find((o) =>
   106→    o._ulid.startsWith(normalizedRef),
   107→  );
   108→
   109→  if (!observation) {
   110→    return { item: null, error: `Observation not found: ${ref}` };
   111→  }
   112→
   113→  return { item: observation };
   114→}
   115→
   116→/**
   117→ * Format meta show output
   118→ */
   119→function formatMetaShow(meta: MetaContext): void {
   120→  const stats = getMetaStats(meta);
   121→
   122→  if (!meta.manifest) {
   123→    console.log(chalk.yellow("No meta manifest found (kynetic.meta.yaml)"));
   124→    console.log(
   125→      chalk.gray(
   126→        "Create one to define agents, workflows, conventions, and observations",
   127→      ),
   128→    );
   129→    return;
   130→  }
   131→
   132→  console.log(chalk.bold("Meta-Spec Summary"));
   133→  console.log(chalk.gray("─".repeat(40)));
   134→  console.log(`Agents:       ${stats.agents}`);
   135→  console.log(`Workflows:    ${stats.workflows}`);
   136→  console.log(`Conventions:  ${stats.conventions}`);
   137→  console.log(
   138→    `Observations: ${stats.observations} (${stats.unresolvedObservations} unresolved)`,
   139→  );
   140→}
   141→
   142→/**
   143→ * Format agents table output
   144→ * AC-agent-1: outputs table with columns: ID, Name, Capabilities
   145→ */
   146→function formatAgents(agents: Agent[]): void {
   147→  if (agents.length === 0) {
   148→    console.log(chalk.yellow("No agents defined"));
   149→    return;
   150→  }
   151→
   152→  const table = new Table({
   153→    head: [chalk.bold("ID"), chalk.bold("Name"), chalk.bold("Capabilities")],
   154→    style: {
   155→      head: [],
   156→      border: [],
   157→    },
   158→  });
   159→
   160→  for (const agent of agents) {
   161→    table.push([agent.id, agent.name, agent.capabilities.join(", ")]);
   162→  }
   163→
   164→  console.log(table.toString());
   165→}
   166→
   167→/**
   168→ * Format workflows table output
   169→ * AC-workflow-1: outputs table with columns: ID, Trigger, Steps (count), Mode
   170→ */
   171→function formatWorkflows(workflows: Workflow[]): void {
   172→  if (workflows.length === 0) {
   173→    console.log(chalk.yellow("No workflows defined"));
   174→    return;
   175→  }
   176→
   177→  const table = new Table({
   178→    head: [
   179→      chalk.bold("ID"),
   180→      chalk.bold("Trigger"),
   181→      chalk.bold("Steps"),
   182→      chalk.bold("Mode"),
   183→    ],
   184→    style: {
   185→      head: [],
   186→      border: [],
   187→    },
   188→  });
   189→
   190→  for (const workflow of workflows) {
   191→    table.push([
   192→      workflow.id,
   193→      workflow.trigger,
   194→      workflow.steps.length.toString(),
   195→      workflow.mode || "interactive",
   196→    ]);
   197→  }
   198→
   199→  console.log(table.toString());
   200→}
   201→
   202→/**
   203→ * Format workflows verbose output
   204→ * AC-workflow-2: outputs each workflow with full step list
   205→ * AC: @loop-mode-workflows ac-3 (shows based_on field)
   206→ */
   207→function formatWorkflowsVerbose(workflows: Workflow[]): void {
   208→  if (workflows.length === 0) {
   209→    console.log(chalk.yellow("No workflows defined"));
   210→    return;
   211→  }
   212→
   213→  for (const workflow of workflows) {
   214→    console.log(chalk.bold(`${workflow.id} - ${workflow.trigger}`));
   215→    // Show mode if it's loop (skip for interactive as it's default)
   216→    if (workflow.mode === "loop") {
   217→      console.log(chalk.cyan(`Mode: ${workflow.mode}`));
   218→    }
   219→    // AC: @loop-mode-workflows ac-3 - Show based_on reference
   220→    if (workflow.based_on) {
   221→      console.log(chalk.cyan(`Based on: ${workflow.based_on}`));
   222→    }
   223→    if (workflow.description) {
   224→      console.log(chalk.gray(workflow.description));
   225→    }
   226→    console.log(chalk.gray("─".repeat(60)));
   227→
   228→    for (const step of workflow.steps) {
   229→      const prefix = {
   230→        check: chalk.yellow("[check]"),
   231→        action: chalk.blue("[action]"),
   232→        decision: chalk.magenta("[decision]"),
   233→      }[step.type];
   234→
   235→      console.log(`${prefix} ${step.content}`);
   236→
   237→      if (step.on_fail) {
   238→        console.log(chalk.gray(`  → on fail: ${step.on_fail}`));
   239→      }
   240→
   241→      if (step.options && step.options.length > 0) {
   242→        for (const option of step.options) {
   243→          console.log(chalk.gray(`  • ${option}`));
   244→        }
   245→      }
   246→    }
   247→
   248→    console.log("");
   249→  }
   250→}
   251→
   252→/**
   253→ * Format conventions table output
   254→ * AC-conv-1: outputs table with columns: Domain, Rules (count), Validation (yes/no)
   255→ */
   256→function formatConventions(conventions: Convention[]): void {
   257→  if (conventions.length === 0) {
   258→    console.log(chalk.yellow("No conventions defined"));
   259→    return;
   260→  }
   261→
   262→  const table = new Table({
   263→    head: [chalk.bold("Domain"), chalk.bold("Rules"), chalk.bold("Validation")],
   264→    style: {
   265→      head: [],
   266→      border: [],
   267→    },
   268→  });
   269→
   270→  for (const convention of conventions) {
   271→    table.push([
   272→      convention.domain,
   273→      convention.rules.length.toString(),
   274→      convention.validation ? "yes" : "no",
   275→    ]);
   276→  }
   277→
   278→  console.log(table.toString());
   279→}
   280→
   281→/**
   282→ * Format convention detail output
   283→ * AC-conv-2: outputs full rules list and examples
   284→ */
   285→function formatConventionDetail(convention: Convention): void {
   286→  console.log(chalk.bold(`${convention.domain} Convention`));
   287→  console.log(chalk.gray("─".repeat(60)));
   288→
   289→  console.log(chalk.bold("\nRules:"));
   290→  for (const rule of convention.rules) {
   291→    console.log(`  • ${rule}`);
   292→  }
   293→
   294→  if (convention.examples && convention.examples.length > 0) {
   295→    console.log(chalk.bold("\nExamples:"));
   296→    for (const example of convention.examples) {
   297→      console.log(chalk.green(`  ✓ ${example.good}`));
   298→      console.log(chalk.red(`  ✗ ${example.bad}`));
   299→    }
   300→  }
   301→
   302→  if (convention.validation) {
   303→    console.log(chalk.bold("\nValidation:"));
   304→    console.log(`  Type: ${convention.validation.type}`);
   305→    if (convention.validation.pattern) {
   306→      console.log(`  Pattern: ${convention.validation.pattern}`);
   307→    }
   308→    if (convention.validation.message) {
   309→      console.log(`  Message: ${convention.validation.message}`);
   310→    }
   311→  }
   312→
   313→  console.log("");
   314→}
   315→
   316→/**
   317→ * Format observations table output
   318→ * AC-obs-2: outputs table with columns: ID, Type, Workflow, Created, Content (truncated)
   319→ * AC: @obs-list-display ac-1 - When --all flag used, show Resolved column with ✓/✗
   320→ */
   321→function formatObservations(
   322→  observations: Observation[],
   323→  showResolved: boolean,
   324→): void {
   325→  const filtered = showResolved
   326→    ? observations
   327→    : observations.filter((o) => !o.resolved);
   328→
   329→  if (filtered.length === 0) {
   330→    console.log(
   331→      chalk.yellow(
   332→        showResolved ? "No observations found" : "No unresolved observations",
   333→      ),
   334→    );
   335→    return;
   336→  }
   337→
   338→  // AC: @obs-list-display ac-1 - Include Resolved column when showing all observations
   339→  const headers = showResolved
   340→    ? [
   341→        chalk.bold("ID"),
   342→        chalk.bold("Type"),
   343→        chalk.bold("Resolved"),
   344→        chalk.bold("Workflow"),
   345→        chalk.bold("Created"),
   346→        chalk.bold("Content"),
   347→      ]
   348→    : [
   349→        chalk.bold("ID"),
   350→        chalk.bold("Type"),
   351→        chalk.bold("Workflow"),
   352→        chalk.bold("Created"),
   353→        chalk.bold("Content"),
   354→      ];
   355→
   356→  const colWidths = showResolved
   357→    ? [10, 10, 10, 20, 12, 40]
   358→    : [10, 10, 20, 12, 50];
   359→
   360→  const table = new Table({
   361→    head: headers,
   362→    style: {
   363→      head: [],
   364→      border: [],
   365→    },
   366→    colWidths,
   367→    wordWrap: true,
   368→  });
   369→
   370→  for (const obs of filtered) {
   371→    const id = obs._ulid.substring(0, 8);
   372→    const workflow = obs.workflow_ref || "-";
   373→    const created = new Date(obs.created_at).toISOString().split("T")[0];
   374→    // Adjust content truncation based on available column width
   375→    const maxContentLen = showResolved ? 37 : 47;
   376→    const content =
   377→      obs.content.length > maxContentLen
   378→        ? `${obs.content.substring(0, maxContentLen)}...`
   379→        : obs.content;
   380→
   381→    // AC: @obs-list-display ac-1 - Show ✓ for resolved, ✗ for unresolved
   382→    if (showResolved) {
   383→      const resolvedIndicator = obs.resolved
   384→        ? chalk.green("✓")
   385→        : chalk.red("✗");
   386→      table.push([id, obs.type, resolvedIndicator, workflow, created, content]);
   387→    } else {
   388→      table.push([id, obs.type, workflow, created, content]);
   389→    }
   390→  }
   391→
   392→  console.log(table.toString());
   393→}
   394→
   395→/**
   396→ * Register meta commands
   397→ */
   398→export function registerMetaCommands(program: Command): void {
   399→  const meta = program
   400→    .command("meta")
   401→    .description(
   402→      "Meta-spec commands (agents, workflows, conventions, observations)",
   403→    );
   404→
   405→  // AC-meta-manifest-1: kspec meta show outputs summary with counts
   406→  meta
   407→    .command("show")
   408→    .description("Display meta-spec summary")
   409→    .action(async () => {
   410→      try {
   411→        const ctx = await initContext();
   412→
   413→        if (!ctx.manifestPath) {
   414→          error(errors.project.noKspecProject);
   415→          process.exit(EXIT_CODES.ERROR);
   416→        }
   417→
   418→        const metaCtx = await loadMetaContext(ctx);
   419→        const stats = getMetaStats(metaCtx);
   420→
   421→        output(
   422→          {
   423→            manifest: metaCtx.manifestPath,
   424→            stats,
   425→          },
   426→          () => formatMetaShow(metaCtx),
   427→        );
   428→      } catch (err) {
   429→        error(errors.failures.showMeta, err);
   430→        process.exit(EXIT_CODES.ERROR);
   431→      }
   432→    });
   433→
   434→  // AC-agent-1, AC-agent-2: kspec meta agents
   435→  meta
   436→    .command("agents")
   437→    .description("List agents defined in meta-spec")
   438→    .action(async () => {
   439→      try {
   440→        const ctx = await initContext();
   441→
   442→        if (!ctx.manifestPath) {
   443→          error(errors.project.noKspecProject);
   444→          process.exit(EXIT_CODES.ERROR);
   445→        }
   446→
   447→        const metaCtx = await loadMetaContext(ctx);
   448→        const agents = metaCtx.agents || [];
   449→
   450→        // AC-agent-2: JSON output includes full agent details
   451→        output(
   452→          agents.map((agent) => ({
   453→            id: agent.id,
   454→            name: agent.name,
   455→            description: agent.description,
   456→            capabilities: agent.capabilities,
   457→            tools: agent.tools,
   458→            session_protocol: agent.session_protocol,
   459→            conventions: agent.conventions,
   460→          })),
   461→          // AC-agent-1: Table output with ID, Name, Capabilities
   462→          () => formatAgents(agents),
   463→        );
   464→      } catch (err) {
   465→        error(errors.failures.listAgents, err);
   466→        process.exit(EXIT_CODES.ERROR);
   467→      }
   468→    });
   469→
   470→  // AC-workflow-1, AC-workflow-2, AC-workflow-4: kspec meta workflows
   471→  // AC: @loop-mode-workflows ac-1 (--tag loop filtering)
   472→  meta
   473→    .command("workflows")
   474→    .description("List workflows defined in meta-spec")
   475→    .option("--verbose", "Show full workflow details with all steps")
   476→    .option("--tag <tag>", "Filter workflows by tag (e.g., --tag loop)")
   477→    .action(async (options) => {
   478→      try {
   479→        const ctx = await initContext();
   480→
   481→        if (!ctx.manifestPath) {
   482→          error(errors.project.noKspecProject);
   483→          process.exit(EXIT_CODES.ERROR);
   484→        }
   485→
   486→        const metaCtx = await loadMetaContext(ctx);
   487→        let workflows = metaCtx.workflows || [];
   488→
   489→        // AC: @loop-mode-workflows ac-1 - Filter by tag
   490→        if (options.tag) {
   491→          workflows = workflows.filter((w) => {
   492→            // Match by explicit tags array or by mode field (for "loop" tag)
   493→            const tags = w.tags || [];
   494→            if (tags.includes(options.tag)) return true;
   495→            // Special case: --tag loop also matches mode: loop
   496→            if (options.tag === "loop" && w.mode === "loop") return true;
   497→            return false;
   498→          });
   499→        }
   500→
   501→        // AC-workflow-4: JSON output includes full workflow details
   502→        output(
   503→          workflows.map((workflow) => ({
   504→            id: workflow.id,
   505→            trigger: workflow.trigger,
   506→            description: workflow.description,
   507→            steps: workflow.steps,
   508→            mode: workflow.mode || "interactive",
   509→            based_on: workflow.based_on,
   510→            tags: workflow.tags || [],
   511→          })),
   512→          // AC-workflow-1 (table) or AC-workflow-2 (verbose)
   513→          () => {
   514→            if (options.verbose) {
   515→              formatWorkflowsVerbose(workflows);
   516→            } else {
   517→              formatWorkflows(workflows);
   518→            }
   519→          },
   520→        );
   521→      } catch (err) {
   522→        error(errors.failures.listWorkflows, err);
   523→        process.exit(EXIT_CODES.ERROR);
   524→      }
   525→    });
   526→
   527→  // AC-conv-1, AC-conv-2, AC-conv-5: kspec meta conventions
   528→  meta
   529→    .command("conventions")
   530→    .description("List conventions defined in meta-spec")
   531→    .option("--domain <domain>", "Filter by specific domain")
   532→    .action(async (options) => {
   533→      try {
   534→        const ctx = await initContext();
   535→
   536→        if (!ctx.manifestPath) {
   537→          error(errors.project.noKspecProject);
   538→          process.exit(EXIT_CODES.ERROR);
   539→        }
   540→
   541→        const metaCtx = await loadMetaContext(ctx);
   542→        const conventions = metaCtx.conventions || [];
   543→
   544→        // AC-conv-2: Filter by domain if specified
   545→        const filtered = options.domain
   546→          ? conventions.filter((c) => c.domain === options.domain)
   547→          : conventions;
   548→
   549→        // AC-conv-5: JSON output includes full convention details
   550→        output(
   551→          filtered.map((convention) => ({
   552→            domain: convention.domain,
   553→            rules: convention.rules,
   554→            examples: convention.examples,
   555→            validation: convention.validation,
   556→          })),
   557→          // AC-conv-1 (table) or AC-conv-2 (detail for single domain)
   558→          () => {
   559→            if (options.domain && filtered.length === 1) {
   560→              formatConventionDetail(filtered[0]);
   561→            } else {
   562→              formatConventions(filtered);
   563→            }
   564→          },
   565→        );
   566→      } catch (err) {
   567→        error(errors.failures.listConventions, err);
   568→        process.exit(EXIT_CODES.ERROR);
   569→      }
   570→    });
   571→
   572→  // meta-get-cmd: kspec meta get <ref>
   573→  meta
   574→    .command("get <ref>")
   575→    .description(
   576→      "Get a meta item by reference (agent, workflow, convention, or observation)",
   577→    )
   578→    .action(async (ref: string) => {
   579→      try {
   580→        const ctx = await initContext();
   581→
   582→        if (!ctx.manifestPath) {
   583→          error(errors.project.noKspecProject);
   584→          process.exit(EXIT_CODES.ERROR);
   585→        }
   586→
   587→        const metaCtx = await loadMetaContext(ctx);
   588→
   589→        // Normalize reference
   590→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
   591→
   592→        // Search in all meta item types
   593→        const agents = metaCtx.agents || [];
   594→        const workflows = metaCtx.workflows || [];
   595→        const conventions = metaCtx.conventions || [];
   596→        const observations = metaCtx.observations || [];
   597→
   598→        // Try to find by ID or ULID prefix
   599→        let found: any = null;
   600→        let itemType: string = "";
   601→
   602→        // Check agents (by id or ULID)
   603→        const agent = agents.find(
   604→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
   605→        );
   606→        if (agent) {
   607→          found = agent;
   608→          itemType = "agent";
   609→        }
   610→
   611→        // Check workflows (by id or ULID)
   612→        if (!found) {
   613→          const workflow = workflows.find(
   614→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
   615→          );
   616→          if (workflow) {
   617→            found = workflow;
   618→            itemType = "workflow";
   619→          }
   620→        }
   621→
   622→        // Check conventions (by domain or ULID)
   623→        if (!found) {
   624→          const convention = conventions.find(
   625→            (c) =>
   626→              c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
   627→          );
   628→          if (convention) {
   629→            found = convention;
   630→            itemType = "convention";
   631→          }
   632→        }
   633→
   634→        // Check observations (by ULID)
   635→        if (!found) {
   636→          const observation = observations.find((o) =>
   637→            o._ulid.startsWith(normalizedRef),
   638→          );
   639→          if (observation) {
   640→            found = observation;
   641→            itemType = "observation";
   642→          }
   643→        }
   644→
   645→        if (!found) {
   646→          error(errors.reference.metaNotFound(ref));
   647→          process.exit(EXIT_CODES.ERROR);
   648→        }
   649→
   650→        // Output the item
   651→        output(found, () => {
   652→          console.log(
   653→            chalk.bold(
   654→              `${itemType.charAt(0).toUpperCase() + itemType.slice(1)}: ${ref}`,
   655→            ),
   656→          );
   657→          console.log(chalk.gray("─".repeat(60)));
   658→          console.log(JSON.stringify(found, null, 2));
   659→        });
   660→      } catch (err) {
   661→        error(errors.failures.getMetaItem, err);
   662→        process.exit(EXIT_CODES.ERROR);
   663→      }
   664→    });
   665→
   666→  // meta-list-cmd: kspec meta list
   667→  meta
   668→    .command("list")
   669→    .description("List all meta items")
   670→    .option(
   671→      "--type <type>",
   672→      "Filter by type (agent, workflow, convention, observation)",
   673→    )
   674→    .action(async (options) => {
   675→      try {
   676→        const ctx = await initContext();
   677→
   678→        if (!ctx.manifestPath) {
   679→          error(errors.project.noKspecProject);
   680→          process.exit(EXIT_CODES.ERROR);
   681→        }
   682→
   683→        const metaCtx = await loadMetaContext(ctx);
   684→
   685→        // Collect all meta items with type information
   686→        interface MetaListItem {
   687→          id: string;
   688→          type: string;
   689→          context: string;
   690→          ulid: string;
   691→        }
   692→
   693→        const items: MetaListItem[] = [];
   694→
   695→        // Add agents
   696→        if (!options.type || options.type === "agent") {
   697→          for (const agent of metaCtx.agents || []) {
   698→            items.push({
   699→              id: agent.id,
   700→              type: "agent",
   701→              context: agent.name,
   702→              ulid: agent._ulid,
   703→            });
   704→          }
   705→        }
   706→
   707→        // Add workflows
   708→        if (!options.type || options.type === "workflow") {
   709→          for (const workflow of metaCtx.workflows || []) {
   710→            items.push({
   711→              id: workflow.id,
   712→              type: "workflow",
   713→              context: workflow.trigger,
   714→              ulid: workflow._ulid,
   715→            });
   716→          }
   717→        }
   718→
   719→        // Add conventions
   720→        if (!options.type || options.type === "convention") {
   721→          for (const convention of metaCtx.conventions || []) {
   722→            items.push({
   723→              id: convention.domain,
   724→              type: "convention",
   725→              context: `${convention.rules.length} rules`,
   726→              ulid: convention._ulid,
   727→            });
   728→          }
   729→        }
   730→
   731→        // Add observations
   732→        if (!options.type || options.type === "observation") {
   733→          for (const observation of metaCtx.observations || []) {
   734→            const ulidPrefix = observation._ulid.substring(0, 8);
   735→            items.push({
   736→              id: ulidPrefix,
   737→              type: "observation",
   738→              context: `${observation.type} ${observation.resolved ? "(resolved)" : ""}`,
   739→              ulid: observation._ulid,
   740→            });
   741→          }
   742→        }
   743→
   744→        // Output
   745→        output(items, () => {
   746→          if (items.length === 0) {
   747→            console.log(chalk.yellow("No meta items found"));
   748→            return;
   749→          }
   750→
   751→          const table = new Table({
   752→            head: [chalk.bold("ID"), chalk.bold("Type"), chalk.bold("Context")],
   753→            style: {
   754→              head: [],
   755→              border: [],
   756→            },
   757→          });
   758→
   759→          for (const item of items) {
   760→            table.push([item.id, item.type, item.context]);
   761→          }
   762→
   763→          console.log(table.toString());
   764→        });
   765→      } catch (err) {
   766→        error(errors.failures.listMetaItems, err);
   767→        process.exit(EXIT_CODES.ERROR);
   768→      }
   769→    });
   770→
   771→  // AC-obs-1: kspec meta observe <type> <content>
   772→  // AC: @meta-observe-cmd from-inbox-conversion
   773→  markMutating(meta.command("observe [type] [content]"))
   774→    .description("Create an observation (friction, success, question, idea)")
   775→    .option(
   776→      "--workflow <ref>",
   777→      "Reference to workflow this observation relates to",
   778→    )
   779→    .option("--author <author>", "Author of the observation")
   780→    .option("--from-inbox <ref>", "Convert inbox item to observation")
   781→    .option(
   782→      "--type <type>",
   783→      "Override type when using --from-inbox (defaults to idea)",
   784→    )
   785→    .action(
   786→      async (
   787→        type: string | undefined,
   788→        content: string | undefined,
   789→        options,
   790→      ) => {
   791→        try {
   792→          const ctx = await initContext();
   793→
   794→          if (!ctx.manifestPath) {
   795→            error(errors.project.noKspecProject);
   796→            process.exit(EXIT_CODES.ERROR);
   797→          }
   798→
   799→          // AC: @meta-observe-cmd from-inbox-conversion
   800→          // Handle --from-inbox flag
   801→          if (options.fromInbox) {
   802→            // Load inbox items
   803→            const inboxItems = await loadInboxItems(ctx);
   804→            const item = findInboxItemByRef(inboxItems, options.fromInbox);
   805→
   806→            if (!item) {
   807→              error(errors.reference.inboxNotFound(options.fromInbox));
   808→              process.exit(EXIT_CODES.NOT_FOUND);
   809→            }
   810→
   811→            // Use inbox item content
   812→            const observationContent = item.text;
   813→
   814→            // Type defaults to 'idea' but can be overridden with --type flag
   815→            const observationType = (options.type || "idea") as ObservationType;
   816→
   817→            // Validate observation type
   818→            const validTypes: ObservationType[] = [
   819→              "friction",
   820→              "success",
   821→              "question",
   822→              "idea",
   823→            ];
   824→            if (!validTypes.includes(observationType)) {
   825→              error(errors.validation.invalidObservationType(observationType));
   826→              console.log(`Valid types: ${validTypes.join(", ")}`);
   827→              process.exit(EXIT_CODES.ERROR);
   828→            }
   829→
   830→            // Create observation
   831→            const observation = createObservation(
   832→              observationType,
   833→              observationContent,
   834→              {
   835→                workflow_ref: options.workflow,
   836→                author: options.author,
   837→              },
   838→            );
   839→
   840→            // Save observation
   841→            await saveObservation(ctx, observation);
   842→
   843→            // Delete inbox item
   844→            const deleted = await deleteInboxItem(ctx, item._ulid);
   845→            if (!deleted) {
   846→              error("Failed to delete inbox item after creating observation");
   847→              process.exit(EXIT_CODES.ERROR);
   848→            }
   849→
   850→            await commitIfShadow(
   851→              ctx.shadow,
   852→              "meta-observe-from-inbox",
   853→              observation._ulid.substring(0, 8),
   854→              `Convert inbox item to ${observationType} observation`,
   855→            );
   856→
   857→            // Return observation ref
   858→            output(observation, () =>
   859→              success(
   860→                `Created observation: ${observation._ulid.substring(0, 8)}`,
   861→              ),
   862→            );
   863→            return;
   864→          }
   865→
   866→          // Standard observe flow (without --from-inbox)
   867→          if (!type || !content) {
   868→            error("Type and content are required when not using --from-inbox");
   869→            process.exit(EXIT_CODES.ERROR);
   870→          }
   871→
   872→          // Validate observation type
   873→          const validTypes: ObservationType[] = [
   874→            "friction",
   875→            "success",
   876→            "question",
   877→            "idea",
   878→          ];
   879→          if (!validTypes.includes(type as ObservationType)) {
   880→            error(errors.validation.invalidObservationType(type));
   881→            console.log(`Valid types: ${validTypes.join(", ")}`);
   882→            process.exit(EXIT_CODES.ERROR);
   883→          }
   884→
   885→          // Create observation
   886→          const observation = createObservation(
   887→            type as ObservationType,
   888→            content,
   889→            {
   890→              workflow_ref: options.workflow,
   891→              author: options.author,
   892→            },
   893→          );
   894→
   895→          // Save to manifest
   896→          await saveObservation(ctx, observation);
   897→
   898→          // AC: @trait-shadow-commit ac-1
   899→          await commitIfShadow(
   900→            ctx.shadow,
   901→            "meta-observe",
   902→            observation._ulid.substring(0, 8),
   903→            type as string,
   904→          );
   905→
   906→          // AC-obs-1: outputs "OK Created observation: <ULID-prefix>"
   907→          // In JSON mode, return the created observation object
   908→          output(observation, () =>
   909→            success(
   910→              `Created observation: ${observation._ulid.substring(0, 8)}`,
   911→            ),
   912→          );
   913→        } catch (err) {
   914→          error(errors.failures.createObservation, err);
   915→          process.exit(EXIT_CODES.ERROR);
   916→        }
   917→      },
   918→    );
   919→
   920→  // AC-obs-2, AC-obs-5: kspec meta observations
   921→  // AC: @observation-content-search ac-search-flag, ac-regex-support, ac-combined-filters
   922→  meta
   923→    .command("observations")
   924→    .description("List observations (shows unresolved by default)")
   925→    .option(
   926→      "--type <type>",
   927→      "Filter by observation type (friction/success/question/idea)",
   928→    )
   929→    .option("--workflow <ref>", "Filter by workflow reference")
   930→    .option("--all", "Include resolved observations")
   931→    .option("--promoted", "Show only observations promoted to tasks")
   932→    .option(
   933→      "--pending-resolution",
   934→      "Show observations with completed tasks awaiting resolution",
   935→    )
   936→    .option(
   937→      "--search <pattern>",
   938→      "Search observations by regex pattern (matches content)",
   939→    )
   940→    .action(async (options) => {
   941→      try {
   942→        const ctx = await initContext();
   943→
   944→        if (!ctx.manifestPath) {
   945→          error(errors.project.noKspecProject);
   946→          process.exit(EXIT_CODES.ERROR);
   947→        }
   948→
   949→        const metaCtx = await loadMetaContext(ctx);
   950→        let observations = metaCtx.observations || [];
   951→
   952→        // Apply filters
   953→        if (options.type) {
   954→          observations = observations.filter(
   955→            (obs) => obs.type === options.type,
   956→          );
   957→        }
   958→
   959→        if (options.workflow) {
   960→          observations = observations.filter(
   961→            (obs) => obs.workflow_ref === options.workflow,
   962→          );
   963→        }
   964→
   965→        if (options.promoted) {
   966→          observations = observations.filter(
   967→            (obs) => obs.promoted_to !== undefined,
   968→          );
   969→        }
   970→
   971→        if (options.pendingResolution) {
   972→          // Load tasks to check if promoted tasks are completed
   973→          const tasks = await loadAllTasks(ctx);
   974→          const items = await loadAllItems(ctx);
   975→          const index = new ReferenceIndex(tasks, items);
   976→
   977→          observations = observations.filter((obs) => {
   978→            if (!obs.promoted_to || obs.resolved) return false;
   979→            const taskResult = index.resolve(obs.promoted_to);
   980→            if (!taskResult.ok) return false;
   981→            const item = taskResult.item;
   982→            // Type guard: check if item is a task (has status and depends_on properties)
   983→            return (
   984→              "status" in item &&
   985→              "depends_on" in item &&
   986→              item.status === "completed"
   987→            );
   988→          });
   989→        }
   990→
   991→        // AC: @observation-content-search ac-search-flag, ac-regex-support, ac-combined-filters, ac-search-all-fields
   992→        // Apply --search filter using regex pattern (consistent with kspec search behavior)
   993→        if (options.search) {
   994→          const { grepItem } = await import("../../utils/grep.js");
   995→          observations = observations.filter((obs) => {
   996→            const match = grepItem(
   997→              obs as unknown as Record<string, unknown>,
   998→              options.search,
   999→            );
  1000→            return match !== null;
  1001→          });
  1002→        }
  1003→
  1004→        // AC-obs-5: JSON output includes full observation objects
  1005→        output(
  1006→          observations.map((obs) => ({
  1007→            _ulid: obs._ulid,
  1008→            type: obs.type,
  1009→            content: obs.content,
  1010→            workflow_ref: obs.workflow_ref ?? null,
  1011→            created_at: obs.created_at,
  1012→            author: obs.author ?? null,
  1013→            resolved: obs.resolved,
  1014→            resolution: obs.resolution ?? null,
  1015→            resolved_at: obs.resolved_at ?? null,
  1016→            resolved_by: obs.resolved_by ?? null,
  1017→            promoted_to: obs.promoted_to ?? null,
  1018→          })),
  1019→          // AC-obs-2: Table output with ID, Type, Workflow, Created, Content
  1020→          () => formatObservations(observations, options.all),
  1021→        );
  1022→      } catch (err) {
  1023→        error(errors.failures.listObservations, err);
  1024→        process.exit(EXIT_CODES.ERROR);
  1025→      }
  1026→    });
  1027→
  1028→  // AC-obs-3, AC-obs-6, AC-obs-8: kspec meta promote
  1029→  markMutating(meta.command("promote <ref>"))
  1030→    .description("Promote observation to a task")
  1031→    .requiredOption("--title <title>", "Task title")
  1032→    .option("--priority <priority>", "Task priority (1-5)", "2")
  1033→    .option("--force", "Force promotion even if observation is resolved")
  1034→    .action(async (ref: string, options) => {
  1035→      try {
  1036→        const ctx = await initContext();
  1037→
  1038→        if (!ctx.manifestPath) {
  1039→          error(errors.project.noKspecProject);
  1040→          process.exit(EXIT_CODES.ERROR);
  1041→        }
  1042→
  1043→        const metaCtx = await loadMetaContext(ctx);
  1044→        const observations = metaCtx.observations || [];
  1045→
  1046→        // Find observation
  1047→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1048→        const observation = observations.find((o) =>
  1049→          o._ulid.startsWith(normalizedRef),
  1050→        );
  1051→
  1052→        if (!observation) {
  1053→          error(errors.reference.observationNotFound(ref));
  1054→          process.exit(EXIT_CODES.ERROR);
  1055→        }
  1056→
  1057→        // AC-obs-6: Check if already promoted
  1058→        if (observation.promoted_to) {
  1059→          error(
  1060→            errors.conflict.observationAlreadyPromoted(observation.promoted_to),
  1061→          );
  1062→          process.exit(EXIT_CODES.CONFLICT);
  1063→        }
  1064→
  1065→        // AC-obs-8: Check if resolved
  1066→        if (observation.resolved && !options.force) {
  1067→          error(errors.operation.cannotPromoteResolved);
  1068→          process.exit(EXIT_CODES.ERROR);
  1069→        }
  1070→
  1071→        // Validate priority
  1072→        const priorityResult = parseIntOption(options.priority, {
  1073→          min: 1,
  1074→          max: 5,
  1075→          name: "Priority",
  1076→        });
  1077→        if (!priorityResult.ok) {
  1078→          error(priorityResult.error);
  1079→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1080→        }
  1081→
  1082→        // AC-obs-3: Create task with title, description from observation, meta_ref, and origin
  1083→        const task = createTask({
  1084→          title: options.title,
  1085→          description: observation.content,
  1086→          priority: priorityResult.value,
  1087→          meta_ref: observation.workflow_ref,
  1088→          origin: "observation_promotion",
  1089→        });
  1090→
  1091→        // Save task
  1092→        await saveTask(ctx, task);
  1093→        await commitIfShadow(
  1094→          ctx.shadow,
  1095→          "task-add",
  1096→          task.slugs[0] || task._ulid.slice(0, 8),
  1097→          task.title,
  1098→        );
  1099→        const taskRef = `@${task._ulid.substring(0, 8)}`;
  1100→
  1101→        // Update observation with promoted_to field
  1102→        observation.promoted_to = taskRef;
  1103→        await saveObservation(ctx, observation);
  1104→
  1105→        // AC: @trait-shadow-commit ac-1
  1106→        await commitIfShadow(
  1107→          ctx.shadow,
  1108→          "observation-promote",
  1109→          observation._ulid.substring(0, 8),
  1110→        );
  1111→
  1112→        // AC-obs-3: outputs "OK Created task: <ULID-prefix>"
  1113→        // In JSON mode, return the created task object
  1114→        output(task, () => success(`Created task: ${taskRef.substring(0, 9)}`));
  1115→      } catch (err) {
  1116→        error(errors.failures.promoteObservation, err);
  1117→        process.exit(EXIT_CODES.ERROR);
  1118→      }
  1119→    });
  1120→
  1121→  // AC-obs-4, AC-obs-7, AC-obs-9: kspec meta resolve
  1122→  // AC: @trait-multi-ref-batch - Batch support with --refs flag
  1123→  markMutating(meta.command("resolve [ref] [resolution]"))
  1124→    .description("Resolve an observation (or multiple with --refs)")
  1125→    .option("--refs <refs...>", "Resolve multiple observations by ref")
  1126→    .option(
  1127→      "--resolution <text>",
  1128→      "Resolution text (required for batch mode unless observations have promoted tasks)",
  1129→    )
  1130→    .addHelpText(
  1131→      "after",
  1132→      `
  1133→Examples:
  1134→  $ kspec meta resolve @obs-ref "Fixed in PR #123"
  1135→  $ kspec meta resolve --refs @obs1 @obs2 --resolution "Resolved in batch"`,
  1136→    )
  1137→    .action(
  1138→      async (
  1139→        ref: string | undefined,
  1140→        resolutionArg: string | undefined,
  1141→        options,
  1142→      ) => {
  1143→        try {
  1144→          const ctx = await initContext();
  1145→
  1146→          if (!ctx.manifestPath) {
  1147→            error(errors.project.noKspecProject);
  1148→            process.exit(EXIT_CODES.ERROR);
  1149→          }
  1150→
  1151→          const metaCtx = await loadMetaContext(ctx);
  1152→          const observations = metaCtx.observations || [];
  1153→
  1154→          // Load tasks/items for auto-resolution from promoted tasks
  1155→          const tasks = await loadAllTasks(ctx);
  1156→          const items = await loadAllItems(ctx);
  1157→          const index = new ReferenceIndex(tasks, items);
  1158→
  1159→          // Resolution can come from positional arg or --resolution flag
  1160→          const resolution = resolutionArg || options.resolution;
  1161→
  1162→          // AC: @trait-multi-ref-batch ac-8 - Deduplicate refs
  1163→          const refsFlag = options.refs
  1164→            ? [...new Set(options.refs as string[])]
  1165→            : undefined;
  1166→
  1167→          // AC: @trait-multi-ref-batch ac-1, ac-2, ac-3, ac-4, ac-5
  1168→          const result = await executeBatchOperation({
  1169→            positionalRef: ref,
  1170→            refsFlag,
  1171→            context: { ctx, observations, tasks, items, index, resolution },
  1172→            items: observations,
  1173→            index: index,
  1174→            resolveRef: (refStr, obsList) => {
  1175→              return resolveObservationRefForBatch(
  1176→                refStr,
  1177→                obsList as Observation[],
  1178→              );
  1179→            },
  1180→            executeOperation: async (
  1181→              observation: Observation,
  1182→              { ctx, tasks, items, index, resolution },
  1183→            ) => {
  1184→              // AC-obs-7: Check if already resolved
  1185→              if (observation.resolved) {
  1186→                const resolvedDate = new Date(observation.resolved_at!)
  1187→                  .toISOString()
  1188→                  .split("T")[0];
  1189→                const resolutionText = observation.resolution || "";
  1190→                const truncated =
  1191→                  resolutionText.length > 50
  1192→                    ? `${resolutionText.substring(0, 50)}...`
  1193→                    : resolutionText;
  1194→                return {
  1195→                  success: false,
  1196→                  error: `Already resolved on ${resolvedDate}: ${truncated}`,
  1197→                };
  1198→              }
  1199→
  1200→              // AC-obs-9: Auto-populate resolution from task completion if promoted
  1201→              let finalResolution = resolution;
  1202→              if (!finalResolution && observation.promoted_to) {
  1203→                const taskResult = index.resolve(observation.promoted_to);
  1204→
  1205→                if (taskResult.ok) {
  1206→                  const item = taskResult.item;
  1207→                  // Type guard: ensure this is a task
  1208→                  if ("status" in item && "depends_on" in item) {
  1209→                    const task = item as LoadedTask;
  1210→                    if (task.status === "completed" && task.closed_reason) {
  1211→                      finalResolution = `Resolved via task ${observation.promoted_to}: ${task.closed_reason}`;
  1212→                    } else if (task.status === "completed") {
  1213→                      finalResolution = `Resolved via task ${observation.promoted_to}`;
  1214→                    } else {
  1215→                      return {
  1216→                        success: false,
  1217→                        error: `Task ${observation.promoted_to} is not completed yet`,
  1218→                      };
  1219→                    }
  1220→                  } else {
  1221→                    return {
  1222→                      success: false,
  1223→                      error: `Reference ${observation.promoted_to} is not a task`,
  1224→                    };
  1225→                  }
  1226→                } else {
  1227→                  return {
  1228→                    success: false,
  1229→                    error: `Task ${observation.promoted_to} not found`,
  1230→                  };
  1231→                }
  1232→              }
  1233→
  1234→              if (!finalResolution) {
  1235→                return {
  1236→                  success: false,
  1237→                  error: "Resolution text required",
  1238→                };
  1239→              }
  1240→
  1241→              // AC-obs-4: Update observation
  1242→              observation.resolved = true;
  1243→              observation.resolution = finalResolution;
  1244→              observation.resolved_at = new Date().toISOString();
  1245→              observation.resolved_by = observation.author;
  1246→
  1247→              await saveObservation(ctx, observation);
  1248→
  1249→              // AC: @trait-shadow-commit ac-1
  1250→              await commitIfShadow(
  1251→                ctx.shadow,
  1252→                "observation-resolve",
  1253→                observation._ulid.substring(0, 8),
  1254→              );
  1255→
  1256→              return {
  1257→                success: true,
  1258→                message: `Resolved: ${observation._ulid.substring(0, 8)}`,
  1259→              };
  1260→            },
  1261→            getUlid: (obs: Observation) => obs._ulid,
  1262→          });
  1263→
  1264→          // AC: @trait-multi-ref-batch ac-5, ac-7 - Output formatting
  1265→          formatBatchOutput(result, "Resolve");
  1266→        } catch (err) {
  1267→          error(errors.failures.resolveObservation, err);
  1268→          process.exit(EXIT_CODES.ERROR);
  1269→        }
  1270→      },
  1271→    );
  1272→
  1273→  // Meta add command - create new meta items
  1274→  markMutating(meta.command("add <type>"))
  1275→    .description("Create a new meta item (agent, workflow, or convention)")
  1276→    .option("--id <id>", "Semantic ID (required for agents and workflows)")
  1277→    .option("--domain <domain>", "Domain (required for conventions)")
  1278→    .option("--name <name>", "Name (for agents)")
  1279→    .option("--trigger <trigger>", "Trigger (for workflows)")
  1280→    .option("--description <desc>", "Description")
  1281→    .option("--capability <cap...>", "Capabilities (for agents)")
  1282→    .option("--tool <tool...>", "Tools (for agents)")
  1283→    .option("--convention <conv...>", "Convention references (for agents)")
  1284→    .option("--rule <rule...>", "Rules (for conventions)")
  1285→    .option("--steps <json>", "Workflow steps as JSON array (for workflows)")
  1286→    .option(
  1287→      "--mode <mode>",
  1288→      "Workflow mode: interactive (default) or loop (for workflows)",
  1289→    )
  1290→    .option("--based-on <ref>", "Base workflow reference (for loop workflows)")
  1291→    .option("--tag <tag...>", "Tags for the workflow (for workflows)")
  1292→    .addHelpText(
  1293→      "after",
  1294→      `
  1295→Examples:
  1296→  $ kspec meta add agent --id my-agent --name "My Agent" --capability search code
  1297→  $ kspec meta add convention --domain testing --rule "Always test" --rule "Use mocks"
  1298→  $ kspec meta add workflow --id my-flow --trigger manual --tag automation ci`,
  1299→    )
  1300→    .action(async (type: string, options) => {
  1301→      try {
  1302→        const ctx = await initContext();
  1303→
  1304→        // Validate type
  1305→        const validTypes = ["agent", "workflow", "convention"];
  1306→        if (!validTypes.includes(type)) {
  1307→          error(errors.validation.invalidType(type, validTypes));
  1308→          process.exit(EXIT_CODES.ERROR);
  1309→        }
  1310→
  1311→        // Generate ULID
  1312→        const itemUlid = ulid();
  1313→
  1314→        // Create the item based on type
  1315→        let item: Agent | Workflow | Convention;
  1316→
  1317→        if (type === "agent") {
  1318→          // Validate required fields
  1319→          if (!options.id) {
  1320→            error(errors.validation.agentRequiresId);
  1321→            process.exit(EXIT_CODES.ERROR);
  1322→          }
  1323→          if (!options.name) {
  1324→            error(errors.validation.agentRequiresName);
  1325→            process.exit(EXIT_CODES.ERROR);
  1326→          }
  1327→
  1328→          item = {
  1329→            _ulid: itemUlid,
  1330→            id: options.id,
  1331→            name: options.name,
  1332→            description: options.description || "",
  1333→            capabilities: options.capability || [],
  1334→            tools: options.tool || [],
  1335→            conventions: options.convention || [],
  1336→          };
  1337→        } else if (type === "workflow") {
  1338→          // Validate required fields
  1339→          if (!options.id) {
  1340→            error(errors.validation.workflowRequiresId);
  1341→            process.exit(EXIT_CODES.ERROR);
  1342→          }
  1343→          if (!options.trigger) {
  1344→            error(errors.validation.workflowRequiresTrigger);
  1345→            process.exit(EXIT_CODES.ERROR);
  1346→          }
  1347→
  1348→          // Parse and validate --steps if provided
  1349→          let steps: WorkflowStep[] = [];
  1350→          if (options.steps) {
  1351→            // AC: @meta-add-cmd ac-2 - Parse JSON
  1352→            let parsedSteps: unknown;
  1353→            try {
  1354→              parsedSteps = JSON.parse(options.steps);
  1355→            } catch (err) {
  1356→              const message = err instanceof Error ? err.message : String(err);
  1357→              error(errors.validation.invalidStepsJson(message));
  1358→              process.exit(EXIT_CODES.ERROR);
  1359→            }
  1360→
  1361→            // AC: @meta-add-cmd ac-3 - Verify it's an array
  1362→            if (!Array.isArray(parsedSteps)) {
  1363→              error(errors.validation.stepsNotArray);
  1364→              process.exit(EXIT_CODES.ERROR);
  1365→            }
  1366→
  1367→            // AC: @meta-add-cmd ac-4 - Validate with schema
  1368→            const result = z.array(WorkflowStepSchema).safeParse(parsedSteps);
  1369→            if (!result.success) {
  1370→              const issues = result.error.issues
  1371→                .map((i) => `${i.path.join(".")}: ${i.message}`)
  1372→                .join("; ");
  1373→              error(errors.validation.invalidStepsSchema(issues));
  1374→              process.exit(EXIT_CODES.ERROR);
  1375→            }
  1376→            steps = result.data;
  1377→          }
  1378→
  1379→          // Validate mode if provided
  1380→          const validModes = ["interactive", "loop"];
  1381→          if (options.mode && !validModes.includes(options.mode)) {
  1382→            error(
  1383→              `Invalid mode: ${options.mode}. Valid modes: ${validModes.join(", ")}`,
  1384→            );
  1385→            process.exit(EXIT_CODES.ERROR);
  1386→          }
  1387→
  1388→          item = {
  1389→            _ulid: itemUlid,
  1390→            id: options.id,
  1391→            trigger: options.trigger,
  1392→            description: options.description || "",
  1393→            steps,
  1394→            ...(options.mode && { mode: options.mode }),
  1395→            ...(options.basedOn && { based_on: options.basedOn }),
  1396→            ...(options.tag && options.tag.length > 0 && { tags: parseTagsArray(options.tag) }),
  1397→          };
  1398→        } else {
  1399→          // convention
  1400→          if (!options.domain) {
  1401→            error(errors.validation.conventionRequiresDomain);
  1402→            process.exit(EXIT_CODES.ERROR);
  1403→          }
  1404→
  1405→          item = {
  1406→            _ulid: itemUlid,
  1407→            domain: options.domain,
  1408→            rules: options.rule || [],
  1409→            examples: [],
  1410→          };
  1411→        }
  1412→
  1413→        // Save the item
  1414→        await saveMetaItem(
  1415→          ctx,
  1416→          item,
  1417→          type as "agent" | "workflow" | "convention",
  1418→        );
  1419→
  1420→        // AC: @trait-shadow-commit ac-1
  1421→        await commitIfShadow(
  1422→          ctx.shadow,
  1423→          `meta-add-${type}`,
  1424→          itemUlid.substring(0, 8),
  1425→          "id" in item ? item.id : "domain" in item ? item.domain : undefined,
  1426→        );
  1427→
  1428→        if (isJsonMode()) {
  1429→          // In JSON mode, output the item data directly
  1430→          console.log(JSON.stringify(item, null, 2));
  1431→        } else {
  1432→          const idOrDomain =
  1433→            "id" in item ? item.id : "domain" in item ? item.domain : itemUlid;
  1434→          success(
  1435→            `Created ${type}: ${idOrDomain} (@${itemUlid.substring(0, 8)})`,
  1436→          );
  1437→        }
  1438→      } catch (err) {
  1439→        error(errors.failures.createMeta(type), err);
  1440→        process.exit(EXIT_CODES.ERROR);
  1441→      }
  1442→    });
  1443→
  1444→  // Meta set command - update existing meta items
  1445→  markMutating(meta.command("set <ref>"))
  1446→    .description("Update an existing meta item")
  1447→    .option("--name <name>", "Update name (for agents)")
  1448→    .option("--description <desc>", "Update description")
  1449→    .option("--trigger <trigger>", "Update trigger (for workflows)")
  1450→    .option("--add-capability <cap>", "Add capability (for agents)")
  1451→    .option("--add-tool <tool>", "Add tool (for agents)")
  1452→    .option("--add-convention <conv>", "Add convention reference (for agents)")
  1453→    .option("--add-rule <rule>", "Add rule (for conventions)")
  1454→    .action(async (ref: string, options) => {
  1455→      try {
  1456→        const ctx = await initContext();
  1457→        const metaCtx = await loadMetaContext(ctx);
  1458→
  1459→        // Find the item using unified lookup
  1460→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1461→        let found: Agent | Workflow | Convention | null = null;
  1462→        let itemType: "agent" | "workflow" | "convention" | null = null;
  1463→
  1464→        // Search in agents
  1465→        const agents = metaCtx.manifest?.agents || [];
  1466→        const agent = agents.find(
  1467→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
  1468→        );
  1469→        if (agent) {
  1470→          found = agent;
  1471→          itemType = "agent";
  1472→        }
  1473→
  1474→        // Search in workflows
  1475→        if (!found) {
  1476→          const workflows = metaCtx.manifest?.workflows || [];
  1477→          const workflow = workflows.find(
  1478→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
  1479→          );
  1480→          if (workflow) {
  1481→            found = workflow;
  1482→            itemType = "workflow";
  1483→          }
  1484→        }
  1485→
  1486→        // Search in conventions
  1487→        if (!found) {
  1488→          const conventions = metaCtx.manifest?.conventions || [];
  1489→          const convention = conventions.find(
  1490→            (c) =>
  1491→              c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
  1492→          );
  1493→          if (convention) {
  1494→            found = convention;
  1495→            itemType = "convention";
  1496→          }
  1497→        }
  1498→
  1499→        if (!found || !itemType) {
  1500→          error(errors.reference.metaNotFound(ref));
  1501→          process.exit(EXIT_CODES.ERROR);
  1502→        }
  1503→
  1504→        // Update fields based on type
  1505→        if (itemType === "agent") {
  1506→          const item = found as Agent;
  1507→          if (options.name) item.name = options.name;
  1508→          if (options.description !== undefined)
  1509→            item.description = options.description;
  1510→          if (options.addCapability) {
  1511→            if (!item.capabilities.includes(options.addCapability)) {
  1512→              item.capabilities.push(options.addCapability);
  1513→            }
  1514→          }
  1515→          if (options.addTool) {
  1516→            if (!item.tools.includes(options.addTool)) {
  1517→              item.tools.push(options.addTool);
  1518→            }
  1519→          }
  1520→          if (options.addConvention) {
  1521→            if (!item.conventions.includes(options.addConvention)) {
  1522→              item.conventions.push(options.addConvention);
  1523→            }
  1524→          }
  1525→        } else if (itemType === "workflow") {
  1526→          const item = found as Workflow;
  1527→          if (options.trigger) item.trigger = options.trigger;
  1528→          if (options.description !== undefined)
  1529→            item.description = options.description;
  1530→        } else {
  1531→          const item = found as Convention;
  1532→          // Convention doesn't have a description field
  1533→          if (options.addRule) {
  1534→            if (!item.rules.includes(options.addRule)) {
  1535→              item.rules.push(options.addRule);
  1536→            }
  1537→          }
  1538→        }
  1539→
  1540→        // Save the updated item
  1541→        await saveMetaItem(ctx, found, itemType);
  1542→
  1543→        // AC: @trait-shadow-commit ac-1
  1544→        await commitIfShadow(
  1545→          ctx.shadow,
  1546→          `meta-set-${itemType}`,
  1547→          found._ulid.substring(0, 8),
  1548→        );
  1549→
  1550→        if (isJsonMode()) {
  1551→          // In JSON mode, output the item data directly
  1552→          console.log(JSON.stringify(found, null, 2));
  1553→        } else {
  1554→          const idOrDomain =
  1555→            itemType === "agent"
  1556→              ? (found as Agent).id
  1557→              : itemType === "workflow"
  1558→                ? (found as Workflow).id
  1559→                : (found as Convention).domain;
  1560→          success(`Updated ${itemType}: ${idOrDomain}`);
  1561→        }
  1562→      } catch (err) {
  1563→        error(errors.failures.updateMetaItem, err);
  1564→        process.exit(EXIT_CODES.ERROR);
  1565→      }
  1566→    });
  1567→
  1568→  // Meta delete command - delete meta items
  1569→  markMutating(meta.command("delete <ref>"))
  1570→    .description("Delete a meta item")
  1571→    .option("--confirm", "Skip confirmation prompt")
  1572→    .action(async (ref: string, options) => {
  1573→      try {
  1574→        const ctx = await initContext();
  1575→        const metaCtx = await loadMetaContext(ctx);
  1576→
  1577→        // Find the item to determine type
  1578→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1579→        let itemType:
  1580→          | "agent"
  1581→          | "workflow"
  1582→          | "convention"
  1583→          | "observation"
  1584→          | null = null;
  1585→        let itemUlid: string | null = null;
  1586→        let itemLabel: string | null = null;
  1587→
  1588→        // Search in agents
  1589→        const agents = metaCtx.manifest?.agents || [];
  1590→        const agent = agents.find(
  1591→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
  1592→        );
  1593→        if (agent) {
  1594→          itemType = "agent";
  1595→          itemUlid = agent._ulid;
  1596→          itemLabel = `agent ${agent.id}`;
  1597→        }
  1598→
  1599→        // Search in workflows
  1600→        if (!itemType) {
  1601→          const workflows = metaCtx.manifest?.workflows || [];
  1602→          const workflow = workflows.find(
  1603→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
  1604→          );
  1605→          if (workflow) {
  1606→            itemType = "workflow";
  1607→            itemUlid = workflow._ulid;
  1608→            itemLabel = `workflow ${workflow.id}`;
  1609→          }
  1610→        }
  1611→
  1612→        // Search in conventions
  1613→        if (!itemType) {
  1614→          const conventions = metaCtx.manifest?.conventions || [];
  1615→          const convention = conventions.find(
  1616→            (c) =>
  1617→              c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
  1618→          );
  1619→          if (convention) {
  1620→            itemType = "convention";
  1621→            itemUlid = convention._ulid;
  1622→            itemLabel = `convention ${convention.domain}`;
  1623→          }
  1624→        }
  1625→
  1626→        // Search in observations
  1627→        if (!itemType) {
  1628→          const observations = metaCtx.observations || [];
  1629→          const observation = observations.find((o) =>
  1630→            o._ulid.startsWith(normalizedRef),
  1631→          );
  1632→          if (observation) {
  1633→            itemType = "observation";
  1634→            itemUlid = observation._ulid;
  1635→            itemLabel = `observation ${observation._ulid.substring(0, 8)}`;
  1636→          }
  1637→        }
  1638→
  1639→        if (!itemType || !itemUlid || !itemLabel) {
  1640→          error(errors.reference.metaNotFound(ref));
  1641→          process.exit(EXIT_CODES.ERROR);
  1642→        }
  1643→
  1644→        // Check for dangling references (unless --confirm is used to override)
  1645→        if (!options.confirm) {
  1646→          // Check tasks with meta_ref
  1647→          const tasks = await loadAllTasks(ctx);
  1648→          const referencingTasks = tasks.filter((t) => {
  1649→            if (!t.meta_ref) return false;
  1650→            // Resolve the task's meta_ref to a ULID
  1651→            const taskMetaRef = resolveMetaRefToUlid(t.meta_ref, metaCtx);
  1652→            // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1653→            return taskMetaRef && taskMetaRef.ulid === itemUlid;
  1654→          });
  1655→
  1656→          if (referencingTasks.length > 0) {
  1657→            const taskRefs = referencingTasks
  1658→              .map((t) => `@${t.slugs?.[0] || t._ulid.substring(0, 8)}`)
  1659→              .join(", ");
  1660→            error(
  1661→              errors.operation.cannotDeleteReferencedByTasks(
  1662→                itemLabel,
  1663→                referencingTasks.length,
  1664→                taskRefs,
  1665→              ),
  1666→            );
  1667→            process.exit(EXIT_CODES.ERROR);
  1668→          }
  1669→
  1670→          // Check observations with workflow_ref (only for workflows)
  1671→          if (itemType === "workflow") {
  1672→            const observations = metaCtx.observations || [];
  1673→            const referencingObservations = observations.filter((o) => {
  1674→              if (!o.workflow_ref) return false;
  1675→              // Resolve the observation's workflow_ref to a ULID
  1676→              const obsWorkflowRef = resolveMetaRefToUlid(
  1677→                o.workflow_ref,
  1678→                metaCtx,
  1679→              );
  1680→              // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1681→              return obsWorkflowRef && obsWorkflowRef.ulid === itemUlid;
  1682→            });
  1683→
  1684→            if (referencingObservations.length > 0) {
  1685→              const obsRefs = referencingObservations
  1686→                .map((o) => `@${o._ulid.substring(0, 8)}`)
  1687→                .join(", ");
  1688→              error(
  1689→                errors.operation.cannotDeleteReferencedByObservations(
  1690→                  itemLabel,
  1691→                  referencingObservations.length,
  1692→                  obsRefs,
  1693→                ),
  1694→              );
  1695→              process.exit(EXIT_CODES.ERROR);
  1696→            }
  1697→          }
  1698→
  1699→          // Show confirmation prompt even if no references found
  1700→          error(errors.operation.confirmRequired(itemLabel));
  1701→          process.exit(EXIT_CODES.ERROR);
  1702→        }
  1703→
  1704→        // Delete the item
  1705→        const deleted = await deleteMetaItem(ctx, itemUlid, itemType);
  1706→
  1707→        if (!deleted) {
  1708→          error(errors.operation.deleteItemFailed(itemLabel));
  1709→          process.exit(EXIT_CODES.ERROR);
  1710→        }
  1711→
  1712→        // AC: @trait-shadow-commit ac-1
  1713→        await commitIfShadow(
  1714→          ctx.shadow,
  1715→          `meta-delete-${itemType}`,
  1716→          itemUlid.substring(0, 8),
  1717→        );
  1718→
  1719→        success(`Deleted ${itemLabel}`);
  1720→      } catch (err) {
  1721→        error(errors.failures.deleteMetaItem, err);
  1722→        process.exit(EXIT_CODES.ERROR);
  1723→      }
  1724→    });
  1725→
  1726→  // meta-focus-cmd: kspec meta focus [ref]
  1727→  markMutating(meta.command("focus [ref]"))
  1728→    .description("Get or set session focus")
  1729→    .option("--clear", "Clear current focus")
  1730→    .action(async (ref: string | undefined, options) => {
  1731→      try {
  1732→        const ctx = await initContext();
  1733→
  1734→        if (!ctx.manifestPath) {
  1735→          error(errors.project.noKspecProject);
  1736→          process.exit(EXIT_CODES.ERROR);
  1737→        }
  1738→
  1739→        const sessionCtx = await loadSessionContext(ctx);
  1740→
  1741→        // Clear focus
  1742→        if (options.clear) {
  1743→          sessionCtx.focus = null;
  1744→          await saveSessionContext(ctx, sessionCtx);
  1745→
  1746→          output({ focus: null }, () => success("Cleared session focus"));
  1747→          return;
  1748→        }
  1749→
  1750→        // Show current focus
  1751→        if (!ref) {
  1752→          output({ focus: sessionCtx.focus }, () => {
  1753→            if (sessionCtx.focus) {
  1754→              console.log(`Current focus: ${sessionCtx.focus}`);
  1755→            } else {
  1756→              console.log(chalk.yellow("No focus set"));
  1757→            }
  1758→          });
  1759→          return;
  1760→        }
  1761→
  1762→        // Set focus to ref
  1763→        sessionCtx.focus = ref.startsWith("@") ? ref : `@${ref}`;
  1764→        await saveSessionContext(ctx, sessionCtx);
  1765→
  1766→        output({ focus: sessionCtx.focus }, () =>
  1767→          success(`Set focus to: ${sessionCtx.focus}`),
  1768→        );
  1769→      } catch (err) {
  1770→        error(errors.failures.updateSessionContext, err);
  1771→        process.exit(EXIT_CODES.ERROR);
  1772→      }
  1773→    });
  1774→
  1775→  // meta-thread-cmd: kspec meta thread <action> [text]
  1776→  markMutating(meta.command("thread <action> [text]"))
  1777→    .description("Manage active threads")
  1778→    .action(async (action: string, text: string | undefined) => {
  1779→      try {
  1780→        const ctx = await initContext();
  1781→
  1782→        if (!ctx.manifestPath) {
  1783→          error(errors.project.noKspecProject);
  1784→          process.exit(EXIT_CODES.ERROR);
  1785→        }
  1786→
  1787→        const sessionCtx = await loadSessionContext(ctx);
  1788→
  1789→        // List threads
  1790→        if (action === "list") {
  1791→          output({ threads: sessionCtx.threads }, () => {
  1792→            if (sessionCtx.threads.length === 0) {
  1793→              console.log(chalk.yellow("No active threads"));
  1794→            } else {
  1795→              console.log("Active threads:");
  1796→              sessionCtx.threads.forEach((thread, idx) => {
  1797→                console.log(`  ${idx + 1}. ${thread}`);
  1798→              });
  1799→            }
  1800→          });
  1801→          return;
  1802→        }
  1803→
  1804→        // Clear all threads
  1805→        if (action === "clear") {
  1806→          sessionCtx.threads = [];
  1807→          await saveSessionContext(ctx, sessionCtx);
  1808→
  1809→          output({ threads: [] }, () => success("Cleared all threads"));
  1810→          return;
  1811→        }
  1812→
  1813→        // Add thread
  1814→        if (action === "add") {
  1815→          if (!text) {
  1816→            error("Thread text is required for add action");
  1817→            process.exit(EXIT_CODES.ERROR);
  1818→          }
  1819→
  1820→          sessionCtx.threads.push(text);
  1821→          await saveSessionContext(ctx, sessionCtx);
  1822→
  1823→          output({ threads: sessionCtx.threads, added: text }, () =>
  1824→            success(`Added thread: ${text}`),
  1825→          );
  1826→          return;
  1827→        }
  1828→
  1829→        // Remove thread by index (1-based)
  1830→        if (action === "remove") {
  1831→          if (!text) {
  1832→            error("Index is required for remove action");
  1833→            process.exit(EXIT_CODES.ERROR);
  1834→          }
  1835→
  1836→          const index = parseInt(text, 10);
  1837→          if (
  1838→            Number.isNaN(index) ||
  1839→            index < 1 ||
  1840→            index > sessionCtx.threads.length
  1841→          ) {
  1842→            error(
  1843→              `Invalid index: ${text}. Must be between 1 and ${sessionCtx.threads.length}`,
  1844→            );
  1845→            process.exit(EXIT_CODES.ERROR);
  1846→          }
  1847→
  1848→          const removed = sessionCtx.threads.splice(index - 1, 1)[0];
  1849→          await saveSessionContext(ctx, sessionCtx);
  1850→
  1851→          output({ threads: sessionCtx.threads, removed }, () =>
  1852→            success(`Removed thread: ${removed}`),
  1853→          );
  1854→          return;
  1855→        }
  1856→
  1857→        // Unknown action
  1858→        error(`Unknown action: ${action}. Use add, remove, list, or clear`);
  1859→        process.exit(EXIT_CODES.ERROR);
  1860→      } catch (err) {
  1861→        error(errors.failures.updateSessionContext, err);
  1862→        process.exit(EXIT_CODES.ERROR);
  1863→      }
  1864→    });
  1865→
  1866→  // meta-question-cmd: kspec meta question <action> [text]
  1867→  markMutating(meta.command("question <action> [text]"))
  1868→    .description("Manage open questions")
  1869→    .action(async (action: string, text: string | undefined) => {
  1870→      try {
  1871→        const ctx = await initContext();
  1872→
  1873→        if (!ctx.manifestPath) {
  1874→          error(errors.project.noKspecProject);
  1875→          process.exit(EXIT_CODES.ERROR);
  1876→        }
  1877→
  1878→        const sessionCtx = await loadSessionContext(ctx);
  1879→
  1880→        // List questions
  1881→        if (action === "list") {
  1882→          output({ questions: sessionCtx.open_questions }, () => {
  1883→            if (sessionCtx.open_questions.length === 0) {
  1884→              console.log(chalk.yellow("No open questions"));
  1885→            } else {
  1886→              console.log("Open questions:");
  1887→              sessionCtx.open_questions.forEach((question, idx) => {
  1888→                console.log(`  ${idx + 1}. ${question}`);
  1889→              });
  1890→            }
  1891→          });
  1892→          return;
  1893→        }
  1894→
  1895→        // Clear all questions
  1896→        if (action === "clear") {
  1897→          sessionCtx.open_questions = [];
  1898→          await saveSessionContext(ctx, sessionCtx);
  1899→
  1900→          output({ questions: [] }, () => success("Cleared all questions"));
  1901→          return;
  1902→        }
  1903→
  1904→        // Add question
  1905→        if (action === "add") {
  1906→          if (!text) {
  1907→            error("Question text is required for add action");
  1908→            process.exit(EXIT_CODES.ERROR);
  1909→          }
  1910→
  1911→          sessionCtx.open_questions.push(text);
  1912→          await saveSessionContext(ctx, sessionCtx);
  1913→
  1914→          output({ questions: sessionCtx.open_questions, added: text }, () =>
  1915→            success(`Added question: ${text}`),
  1916→          );
  1917→          return;
  1918→        }
  1919→
  1920→        // Remove question by index (1-based)
  1921→        if (action === "remove") {
  1922→          if (!text) {
  1923→            error("Index is required for remove action");
  1924→            process.exit(EXIT_CODES.ERROR);
  1925→          }
  1926→
  1927→          const index = parseInt(text, 10);
  1928→          if (
  1929→            Number.isNaN(index) ||
  1930→            index < 1 ||
  1931→            index > sessionCtx.open_questions.length
  1932→          ) {
  1933→            error(
  1934→              `Invalid index: ${text}. Must be between 1 and ${sessionCtx.open_questions.length}`,
  1935→            );
  1936→            process.exit(EXIT_CODES.ERROR);
  1937→          }
  1938→
  1939→          const removed = sessionCtx.open_questions.splice(index - 1, 1)[0];
  1940→          await saveSessionContext(ctx, sessionCtx);
  1941→
  1942→          output({ questions: sessionCtx.open_questions, removed }, () =>
  1943→            success(`Removed question: ${removed}`),
  1944→          );
  1945→          return;
  1946→        }
  1947→
  1948→        // Unknown action
  1949→        error(`Unknown action: ${action}. Use add, remove, list, or clear`);
  1950→        process.exit(EXIT_CODES.ERROR);
  1951→      } catch (err) {
  1952→        error(errors.failures.updateSessionContext, err);
  1953→        process.exit(EXIT_CODES.ERROR);
  1954→      }
  1955→    });
  1956→
  1957→  // meta-context-cmd: kspec meta context
  1958→  meta
  1959→    .command("context")
  1960→    .description("Show full session context")
  1961→    .option("--clear", "Clear all session context")
  1962→    .action(async (options) => {
  1963→      try {
  1964→        const ctx = await initContext();
  1965→
  1966→        if (!ctx.manifestPath) {
  1967→          error(errors.project.noKspecProject);
  1968→          process.exit(EXIT_CODES.ERROR);
  1969→        }
  1970→
  1971→        const sessionCtx = await loadSessionContext(ctx);
  1972→
  1973→        // Clear all context
  1974→        if (options.clear) {
  1975→          sessionCtx.focus = null;
  1976→          sessionCtx.threads = [];
  1977→          sessionCtx.open_questions = [];
  1978→          await saveSessionContext(ctx, sessionCtx);
  1979→
  1980→          output(
  1981→            {
  1982→              focus: null,
  1983→              threads: [],
  1984→              open_questions: [],
  1985→              updated_at: sessionCtx.updated_at,
  1986→            },
  1987→            () => success("Cleared all session context"),
  1988→          );
  1989→          return;
  1990→        }
  1991→
  1992→        // Show full session context
  1993→        output(
  1994→          {
  1995→            focus: sessionCtx.focus,
  1996→            threads: sessionCtx.threads,
  1997→            open_questions: sessionCtx.open_questions,
  1998→            updated_at: sessionCtx.updated_at,
  1999→          },
  2000→          () => {
  2001→            console.log(chalk.bold("Session Context"));
  2002→            console.log(chalk.gray("─".repeat(60)));
  2003→
  2004→            // Focus
  2005→            console.log(chalk.bold("\nFocus:"));
  2006→            if (sessionCtx.focus) {
  2007→              console.log(`  ${sessionCtx.focus}`);
  2008→            } else {
  2009→              console.log(chalk.gray("  (none)"));
  2010→            }
  2011→
  2012→            // Active threads
  2013→            console.log(chalk.bold("\nActive Threads:"));
  2014→            if (sessionCtx.threads.length > 0) {
  2015→              sessionCtx.threads.forEach((thread, idx) => {
  2016→                console.log(`  ${idx + 1}. ${thread}`);
  2017→              });
  2018→            } else {
  2019→              console.log(chalk.gray("  (none)"));
  2020→            }
  2021→
  2022→            // Open questions
  2023→            console.log(chalk.bold("\nOpen Questions:"));
  2024→            if (sessionCtx.open_questions.length > 0) {
  2025→              sessionCtx.open_questions.forEach((question, idx) => {
  2026→                console.log(`  ${idx + 1}. ${question}`);
  2027→              });
  2028→            } else {
  2029→              console.log(chalk.gray("  (none)"));
  2030→            }
  2031→
  2032→            // Last updated
  2033→            console.log(chalk.bold("\nLast Updated:"));
  2034→            const updatedDate = new Date(sessionCtx.updated_at);
  2035→            console.log(`  ${updatedDate.toISOString()}`);
  2036→            console.log(chalk.gray(`  (${updatedDate.toLocaleString()})`));
  2037→          },
  2038→        );
  2039→      } catch (err) {
  2040→        error(errors.failures.updateSessionContext, err);
  2041→        process.exit(EXIT_CODES.ERROR);
  2042→      }
  2043→    });
  2044→}
