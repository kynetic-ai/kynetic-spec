     1→/**
     2→ * Skill CLI commands for managing skills.
     3→ *
     4→ * AC: @skill-cli ac-1 - kspec skill list outputs table with ID, Name, Origin, Version, Platforms
     5→ * AC: @skill-cli ac-2 - kspec skill list --json outputs JSON array with full skill metadata
     6→ * AC: @skill-cli ac-3 - kspec skill add creates meta entry with origin custom
     7→ * AC: @skill-cli ac-4 - kspec skill add creates .kspec/skills/<id>/SKILL.md
     8→ * AC: @skill-cli ac-5 - kspec skill get outputs metadata including id, name, origin, platforms
     9→ * AC: @skill-cli ac-6 - kspec skill get outputs SKILL.md content
    10→ * AC: @skill-cli ac-7 - kspec skill delete --confirm removes meta entry
    11→ * AC: @skill-cli ac-8 - kspec skill delete removes .kspec/skills/<id>/ directory
    12→ *
    13→ * AC: @core-skill-install ac-1 - meta entries created with origin core
    14→ * AC: @core-skill-install ac-2 - content files copied from templates to .kspec/skills/<id>/
    15→ * AC: @core-skill-install ac-3 - custom skills skipped with message
    16→ * AC: @core-skill-install ac-4 - --force overwrites custom forks
    17→ * AC: @core-skill-install ac-5 - version matches kspec package version
    18→ */
    19→
    20→import * as crypto from "node:crypto";
    21→import * as fs from "node:fs/promises";
    22→import { readFileSync } from "node:fs";
    23→import * as path from "node:path";
    24→import chalk from "chalk";
    25→import Table from "cli-table3";
    26→import type { Command } from "commander";
    27→import { ulid } from "ulid";
    28→import yaml from "yaml";
    29→import { markMutating } from "../command-annotations.js";
    30→import {
    31→  deleteMetaItem,
    32→  findMetaItemByRef,
    33→  getSkillContentPath,
    34→  initContext,
    35→  type KspecContext,
    36→  loadMetaContext,
    37→  loadSkillContent,
    38→  loadSkillDocs,
    39→  type LoadedSkill,
    40→  saveMetaItem,
    41→  type Skill,
    42→} from "../../parser/index.js";
    43→import { commitIfShadow } from "../../parser/shadow.js";
    44→import { SkillSchema, type SkillOrigin } from "../../schema/index.js";
    45→import { errors } from "../../strings/errors.js";
    46→import { EXIT_CODES } from "../exit-codes.js";
    47→import { error, output, success } from "../output.js";
    48→import { parseTagsArray } from "../parse-utils.js";
    49→
    50→/**
    51→ * Format skills as a table
    52→ * AC: @skill-cli ac-1 - table displays ID, Name, Origin, Version, Platforms
    53→ */
    54→function formatSkillsTable(skills: LoadedSkill[]): void {
    55→  if (skills.length === 0) {
    56→    console.log(chalk.yellow("No skills defined"));
    57→    return;
    58→  }
    59→
    60→  const table = new Table({
    61→    head: [
    62→      chalk.bold("ID"),
    63→      chalk.bold("Name"),
    64→      chalk.bold("Origin"),
    65→      chalk.bold("Version"),
    66→      chalk.bold("Platforms"),
    67→    ],
    68→    style: {
    69→      head: [],
    70→      border: [],
    71→    },
    72→  });
    73→
    74→  for (const skill of skills) {
    75→    table.push([
    76→      skill.id,
    77→      skill.name,
    78→      skill.origin,
    79→      skill.version || "-",
    80→      skill.platforms.join(", "),
    81→    ]);
    82→  }
    83→
    84→  console.log(table.toString());
    85→  console.log(chalk.gray(`\n${skills.length} skill(s)`));
    86→}
    87→
    88→/**
    89→ * Format skill details
    90→ * AC: @skill-cli ac-5 - outputs metadata including id, name, origin, platforms
    91→ */
    92→function formatSkillDetails(skill: LoadedSkill, content: string | null): void {
    93→  console.log(chalk.bold(skill.name));
    94→  console.log(chalk.gray("─".repeat(40)));
    95→  console.log(`ID:          ${skill.id}`);
    96→  console.log(`ULID:        ${skill._ulid}`);
    97→  console.log(`Origin:      ${skill.origin}`);
    98→  console.log(`Platforms:   ${skill.platforms.join(", ")}`);
    99→
   100→  if (skill.version) {
   101→    console.log(`Version:     ${skill.version}`);
   102→  }
   103→
   104→  if (skill.description) {
   105→    console.log(`\n─── Description ───`);
   106→    console.log(skill.description);
   107→  }
   108→
   109→  if (skill.depends_on && skill.depends_on.length > 0) {
   110→    console.log(`\n─── Dependencies ───`);
   111→    for (const dep of skill.depends_on) {
   112→      console.log(`  • ${dep}`);
   113→    }
   114→  }
   115→
   116→  if (skill.tags && skill.tags.length > 0) {
   117→    console.log(`\nTags:        ${skill.tags.join(", ")}`);
   118→  }
   119→
   120→  // AC: @skill-cli ac-6 - display SKILL.md content
   121→  if (content) {
   122→    console.log(`\n─── SKILL.md Content ───`);
   123→    console.log(content);
   124→  } else {
   125→    console.log(chalk.gray("\n(No SKILL.md content found)"));
   126→  }
   127→}
   128→
   129→/**
   130→ * Register skill commands
   131→ */
   132→export function registerSkillCommands(program: Command): void {
   133→  const skill = program
   134→    .command("skill")
   135→    .description("Skill management commands");
   136→
   137→  // AC: @skill-cli ac-1, ac-2 - kspec skill list
   138→  skill
   139→    .command("list")
   140→    .description("List all skills")
   141→    .option("--origin <origin>", "Filter by origin (core, project, local)")
   142→    .option("--tag <tag>", "Filter by tag")
   143→    .action(async (options) => {
   144→      try {
   145→        const ctx = await initContext();
   146→
   147→        if (!ctx.manifestPath) {
   148→          error(errors.project.noKspecProject);
   149→          process.exit(EXIT_CODES.ERROR);
   150→        }
   151→
   152→        const metaCtx = await loadMetaContext(ctx);
   153→        let skills = metaCtx.skills || [];
   154→
   155→        // Apply filters
   156→        if (options.origin) {
   157→          skills = skills.filter((s) => s.origin === options.origin);
   158→        }
   159→
   160→        if (options.tag) {
   161→          skills = skills.filter((s) => s.tags?.includes(options.tag));
   162→        }
   163→
   164→        // AC: @skill-cli ac-2 - JSON output includes full skill metadata
   165→        output(
   166→          skills.map((s) => ({
   167→            _ulid: s._ulid,
   168→            id: s.id,
   169→            name: s.name,
   170→            description: s.description,
   171→            origin: s.origin,
   172→            version: s.version,
   173→            platforms: s.platforms,
   174→            depends_on: s.depends_on,
   175→            tags: s.tags,
   176→          })),
   177→          // AC: @skill-cli ac-1 - Table output
   178→          () => formatSkillsTable(skills),
   179→        );
   180→      } catch (err) {
   181→        error("Failed to list skills", err);
   182→        process.exit(EXIT_CODES.ERROR);
   183→      }
   184→    });
   185→
   186→  // AC: @skill-cli ac-3, ac-4 - kspec skill add
   187→  // AC: @skill-add ac-3 - --content-file copies existing file to SKILL.md
   188→  markMutating(skill.command("add"))
   189→    .description("Create a new skill")
   190→    .requiredOption("--id <id>", "Skill ID (kebab-case)")
   191→    .requiredOption("--name <name>", "Skill name")
   192→    .option("--description <desc>", "Skill description")
   193→    .option(
   194→      "--origin <origin>",
   195→      "Skill origin (core, project, local)",
   196→      "project",
   197→    )
   198→    .option("--skill-version <version>", "Skill version")
   199→    .option("--platform <platform...>", "Target platforms")
   200→    .option("--tag <tag...>", "Tags for the skill")
   201→    .option("--depends-on <ref...>", "Skill dependencies")
   202→    .option("--content-file <path>", "Path to existing file to use as SKILL.md content")
   203→    .action(async (options) => {
   204→      try {
   205→        const ctx = await initContext();
   206→
   207→        if (!ctx.manifestPath) {
   208→          error(errors.project.noKspecProject);
   209→          process.exit(EXIT_CODES.ERROR);
   210→        }
   211→
   212→        // Validate origin
   213→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   214→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   215→          error(
   216→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   217→          );
   218→          process.exit(EXIT_CODES.ERROR);
   219→        }
   220→
   221→        // Check if skill with this ID already exists
   222→        const metaCtx = await loadMetaContext(ctx);
   223→        const existingSkill = metaCtx.skills.find((s) => s.id === options.id);
   224→        if (existingSkill) {
   225→          error(`Skill with ID '${options.id}' already exists`);
   226→          process.exit(EXIT_CODES.CONFLICT);
   227→        }
   228→
   229→        // Build skill object
   230→        const skillData: Skill = {
   231→          _ulid: ulid(),
   232→          id: options.id,
   233→          name: options.name,
   234→          description: options.description,
   235→          origin: options.origin as SkillOrigin,
   236→          version: options.skillVersion,
   237→          platforms:
   238→            options.platform && options.platform.length > 0
   239→              ? options.platform
   240→              : ["claude-code"],
   241→          depends_on:
   242→            options.dependsOn && options.dependsOn.length > 0
   243→              ? options.dependsOn
   244→              : [],
   245→          tags:
   246→            options.tag && options.tag.length > 0
   247→              ? parseTagsArray(options.tag)
   248→              : [],
   249→        };
   250→
   251→        // Validate with schema
   252→        const parsed = SkillSchema.safeParse(skillData);
   253→        if (!parsed.success) {
   254→          const issues = parsed.error.issues
   255→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   256→            .join("; ");
   257→          error(`Invalid skill data: ${issues}`);
   258→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   259→        }
   260→
   261→        const skill: LoadedSkill = { ...parsed.data };
   262→
   263→        // AC: @skill-cli ac-3 - save meta entry (also creates directory per ac-4)
   264→        await saveMetaItem(ctx, skill, "skill");
   265→
   266→        // AC: @skill-cli ac-4 - create SKILL.md with placeholder content
   267→        // AC: @skill-add ac-3 - if --content-file provided, copy its contents
   268→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   269→        let initialContent: string;
   270→
   271→        if (options.contentFile) {
   272→          // Read content from the specified file
   273→          const contentFilePath = path.isAbsolute(options.contentFile)
   274→            ? options.contentFile
   275→            : path.resolve(process.cwd(), options.contentFile);
   276→
   277→          try {
   278→            initialContent = await fs.readFile(contentFilePath, "utf-8");
   279→          } catch (err) {
   280→            // Clean up: remove the skill we just created
   281→            await deleteMetaItem(ctx, skill._ulid, "skill");
   282→            error(`Failed to read content file: ${contentFilePath}`);
   283→            process.exit(EXIT_CODES.ERROR);
   284→          }
   285→        } else {
   286→          initialContent = `# ${skill.name}\n\n${skill.description || "Add skill content here."}\n`;
   287→        }
   288→
   289→        await fs.writeFile(skillMdPath, initialContent, "utf-8");
   290→
   291→        // Commit changes
   292→        await commitIfShadow(ctx.shadow, "skill-add", skill.id, skill.name);
   293→
   294→        output(skill, () =>
   295→          success(`Created skill: ${skill.id}`, { skill }),
   296→        );
   297→      } catch (err) {
   298→        error("Failed to create skill", err);
   299→        process.exit(EXIT_CODES.ERROR);
   300→      }
   301→    });
   302→
   303→  // AC: @skill-cli ac-5, ac-6 - kspec skill get
   304→  skill
   305→    .command("get <ref>")
   306→    .description("Show skill details")
   307→    .action(async (ref: string) => {
   308→      try {
   309→        const ctx = await initContext();
   310→
   311→        if (!ctx.manifestPath) {
   312→          error(errors.project.noKspecProject);
   313→          process.exit(EXIT_CODES.ERROR);
   314→        }
   315→
   316→        const metaCtx = await loadMetaContext(ctx);
   317→        const item = findMetaItemByRef(metaCtx, ref);
   318→
   319→        if (!item) {
   320→          error(`Skill not found: ${ref}`);
   321→          console.log(chalk.gray("Try: kspec skill list"));
   322→          process.exit(EXIT_CODES.NOT_FOUND);
   323→        }
   324→
   325→        // Check it's a skill
   326→        if (!("origin" in item)) {
   327→          error(`Item ${ref} is not a skill`);
   328→          process.exit(EXIT_CODES.ERROR);
   329→        }
   330→
   331→        const skill = item as LoadedSkill;
   332→
   333→        // AC: @skill-cli ac-6 - load SKILL.md content
   334→        const content = await loadSkillContent(ctx, skill);
   335→        const docs = await loadSkillDocs(ctx, skill);
   336→
   337→        // AC: @skill-cli ac-5, ac-6 - output metadata and content
   338→        output(
   339→          {
   340→            _ulid: skill._ulid,
   341→            id: skill.id,
   342→            name: skill.name,
   343→            description: skill.description,
   344→            origin: skill.origin,
   345→            version: skill.version,
   346→            platforms: skill.platforms,
   347→            depends_on: skill.depends_on,
   348→            tags: skill.tags,
   349→            content,
   350→            docs: docs.map((d) => ({ name: d.name, path: d.path })),
   351→          },
   352→          () => formatSkillDetails(skill, content),
   353→        );
   354→      } catch (err) {
   355→        error("Failed to get skill", err);
   356→        process.exit(EXIT_CODES.ERROR);
   357→      }
   358→    });
   359→
   360→  // AC: @skill-set ac-1, ac-2, ac-3 - kspec skill set
   361→  markMutating(skill.command("set <ref>"))
   362→    .description("Update skill metadata fields")
   363→    .option("--name <name>", "Update skill name")
   364→    .option("--description <desc>", "Update skill description")
   365→    .option("--origin <origin>", "Update skill origin (core, project, local)")
   366→    .option("--skill-version <version>", "Update skill version")
   367→    .option("--add-platform <platform>", "Add a platform to the platforms array")
   368→    .option("--remove-platform <platform>", "Remove a platform from the platforms array")
   369→    .option("--add-tag <tag>", "Add a tag to the tags array")
   370→    .option("--remove-tag <tag>", "Remove a tag from the tags array")
   371→    .option("--add-depends-on <ref>", "Add a dependency reference")
   372→    .option("--remove-depends-on <ref>", "Remove a dependency reference")
   373→    .action(async (ref: string, options) => {
   374→      try {
   375→        const ctx = await initContext();
   376→
   377→        if (!ctx.manifestPath) {
   378→          error(errors.project.noKspecProject);
   379→          process.exit(EXIT_CODES.ERROR);
   380→        }
   381→
   382→        const metaCtx = await loadMetaContext(ctx);
   383→        const item = findMetaItemByRef(metaCtx, ref);
   384→
   385→        if (!item) {
   386→          error(`Skill not found: ${ref}`);
   387→          console.log(chalk.gray("Try: kspec skill list"));
   388→          process.exit(EXIT_CODES.NOT_FOUND);
   389→        }
   390→
   391→        // Check it's a skill
   392→        if (!("origin" in item)) {
   393→          error(`Item ${ref} is not a skill`);
   394→          process.exit(EXIT_CODES.ERROR);
   395→        }
   396→
   397→        const skill = item as LoadedSkill;
   398→
   399→        // AC: @skill-set ac-1 - update description field
   400→        if (options.name !== undefined) {
   401→          skill.name = options.name;
   402→        }
   403→
   404→        if (options.description !== undefined) {
   405→          skill.description = options.description;
   406→        }
   407→
   408→        // Update origin
   409→        if (options.origin !== undefined) {
   410→          const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   411→          if (!validOrigins.includes(options.origin as SkillOrigin)) {
   412→            error(
   413→              `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   414→            );
   415→            process.exit(EXIT_CODES.ERROR);
   416→          }
   417→          skill.origin = options.origin as SkillOrigin;
   418→        }
   419→
   420→        // Update version
   421→        if (options.skillVersion !== undefined) {
   422→          skill.version = options.skillVersion;
   423→        }
   424→
   425→        // AC: @skill-set ac-2 - add platform to array
   426→        if (options.addPlatform) {
   427→          if (!skill.platforms.includes(options.addPlatform)) {
   428→            skill.platforms.push(options.addPlatform);
   429→          }
   430→        }
   431→
   432→        // Remove platform
   433→        if (options.removePlatform) {
   434→          const idx = skill.platforms.indexOf(options.removePlatform);
   435→          if (idx >= 0) {
   436→            skill.platforms.splice(idx, 1);
   437→          }
   438→        }
   439→
   440→        // AC: @skill-set ac-3 - add tag to array
   441→        if (options.addTag) {
   442→          if (!skill.tags) {
   443→            skill.tags = [];
   444→          }
   445→          if (!skill.tags.includes(options.addTag)) {
   446→            skill.tags.push(options.addTag);
   447→          }
   448→        }
   449→
   450→        // Remove tag
   451→        if (options.removeTag && skill.tags) {
   452→          const idx = skill.tags.indexOf(options.removeTag);
   453→          if (idx >= 0) {
   454→            skill.tags.splice(idx, 1);
   455→          }
   456→        }
   457→
   458→        // Add dependency
   459→        if (options.addDependsOn) {
   460→          if (!skill.depends_on) {
   461→            skill.depends_on = [];
   462→          }
   463→          if (!skill.depends_on.includes(options.addDependsOn)) {
   464→            skill.depends_on.push(options.addDependsOn);
   465→          }
   466→        }
   467→
   468→        // Remove dependency
   469→        if (options.removeDependsOn && skill.depends_on) {
   470→          const idx = skill.depends_on.indexOf(options.removeDependsOn);
   471→          if (idx >= 0) {
   472→            skill.depends_on.splice(idx, 1);
   473→          }
   474→        }
   475→
   476→        // Validate updated skill
   477→        const parsed = SkillSchema.safeParse(skill);
   478→        if (!parsed.success) {
   479→          const issues = parsed.error.issues
   480→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   481→            .join("; ");
   482→          error(`Invalid skill data: ${issues}`);
   483→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   484→        }
   485→
   486→        // Save the updated skill
   487→        await saveMetaItem(ctx, skill, "skill");
   488→
   489→        // Commit changes
   490→        await commitIfShadow(ctx.shadow, "skill-set", skill.id, skill.name);
   491→
   492→        output(skill, () => success(`Updated skill: ${skill.id}`));
   493→      } catch (err) {
   494→        error("Failed to update skill", err);
   495→        process.exit(EXIT_CODES.ERROR);
   496→      }
   497→    });
   498→
   499→  // AC: @skill-cli ac-7, ac-8 - kspec skill delete
   500→  markMutating(skill.command("delete <ref>"))
   501→    .description("Delete a skill")
   502→    .option("--confirm", "Skip confirmation prompt")
   503→    .action(async (ref: string, options) => {
   504→      try {
   505→        const ctx = await initContext();
   506→
   507→        if (!ctx.manifestPath) {
   508→          error(errors.project.noKspecProject);
   509→          process.exit(EXIT_CODES.ERROR);
   510→        }
   511→
   512→        const metaCtx = await loadMetaContext(ctx);
   513→        const item = findMetaItemByRef(metaCtx, ref);
   514→
   515→        if (!item) {
   516→          error(`Skill not found: ${ref}`);
   517→          console.log(chalk.gray("Try: kspec skill list"));
   518→          process.exit(EXIT_CODES.NOT_FOUND);
   519→        }
   520→
   521→        // Check it's a skill
   522→        if (!("origin" in item)) {
   523→          error(`Item ${ref} is not a skill`);
   524→          process.exit(EXIT_CODES.ERROR);
   525→        }
   526→
   527→        const skill = item as LoadedSkill;
   528→
   529→        // Check for confirmation
   530→        if (!options.confirm) {
   531→          error(`Confirm deletion of skill '${skill.id}' with --confirm flag`);
   532→          process.exit(EXIT_CODES.ERROR);
   533→        }
   534→
   535→        // Check for dependencies from other skills
   536→        const dependentSkills = metaCtx.skills.filter(
   537→          (s) =>
   538→            s._ulid !== skill._ulid &&
   539→            s.depends_on?.some(
   540→              (dep) =>
   541→                dep === `@${skill.id}` ||
   542→                dep === skill.id ||
   543→                dep.startsWith(`@${skill._ulid.substring(0, 8)}`),
   544→            ),
   545→        );
   546→
   547→        if (dependentSkills.length > 0) {
   548→          const depRefs = dependentSkills.map((s) => `@${s.id}`).join(", ");
   549→          error(
   550→            `Cannot delete skill '${skill.id}': referenced by ${dependentSkills.length} skill(s): ${depRefs}`,
   551→          );
   552→          process.exit(EXIT_CODES.ERROR);
   553→        }
   554→
   555→        // AC: @skill-cli ac-7, ac-8 - delete meta entry and directory
   556→        const deleted = await deleteMetaItem(ctx, skill._ulid, "skill");
   557→
   558→        if (!deleted) {
   559→          error(`Failed to delete skill: ${skill.id}`);
   560→          process.exit(EXIT_CODES.ERROR);
   561→        }
   562→
   563→        // Commit changes
   564→        await commitIfShadow(ctx.shadow, "skill-delete", skill.id);
   565→
   566→        success(`Deleted skill: ${skill.id}`);
   567→      } catch (err) {
   568→        error("Failed to delete skill", err);
   569→        process.exit(EXIT_CODES.ERROR);
   570→      }
   571→    });
   572→
   573→  // AC: @skill-import ac-1 through ac-7 - kspec skill import
   574→  markMutating(skill.command("import <file>"))
   575→    .description("Import an existing SKILL.md file into kspec")
   576→    .option("--id <id>", "Custom skill ID (defaults to directory name)")
   577→    .option("--name <name>", "Skill name (required if no frontmatter)")
   578→    .option("--description <desc>", "Skill description (required if no frontmatter)")
   579→    .option(
   580→      "--origin <origin>",
   581→      "Skill origin (core, project, local)",
   582→      "project",
   583→    )
   584→    .option("--skill-version <version>", "Skill version")
   585→    .action(async (file: string, options) => {
   586→      try {
   587→        const ctx = await initContext();
   588→
   589→        if (!ctx.manifestPath) {
   590→          error(errors.project.noKspecProject);
   591→          process.exit(EXIT_CODES.ERROR);
   592→        }
   593→
   594→        // Resolve file path
   595→        const filePath = path.isAbsolute(file)
   596→          ? file
   597→          : path.resolve(process.cwd(), file);
   598→
   599→        // Check file exists
   600→        try {
   601→          await fs.access(filePath);
   602→        } catch {
   603→          error(`File not found: ${filePath}`);
   604→          process.exit(EXIT_CODES.NOT_FOUND);
   605→        }
   606→
   607→        // Read file content
   608→        const content = await fs.readFile(filePath, "utf-8");
   609→
   610→        // AC: @skill-import ac-1, ac-6 - Parse YAML frontmatter
   611→        const frontmatter = parseFrontmatter(content);
   612→
   613→        // Determine name and description from frontmatter or options
   614→        const skillName = options.name || frontmatter?.name;
   615→        const skillDescription = options.description || frontmatter?.description;
   616→
   617→        // AC: @skill-import ac-6 - Error if no name/description and no frontmatter
   618→        if (!skillName) {
   619→          error("Name is required. Either add YAML frontmatter with 'name' field or use --name option.");
   620→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   621→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   622→        }
   623→
   624→        if (!skillDescription) {
   625→          error("Description is required. Either add YAML frontmatter with 'description' field or use --description option.");
   626→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   627→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   628→        }
   629→
   630→        // AC: @skill-import ac-5 - Derive ID from directory name or use custom
   631→        const sourceDir = path.dirname(filePath);
   632→        const derivedId = path.basename(sourceDir);
   633→        const skillId = options.id || derivedId;
   634→
   635→        // Validate origin
   636→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   637→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   638→          error(
   639→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   640→          );
   641→          process.exit(EXIT_CODES.ERROR);
   642→        }
   643→
   644→        // Check if skill with this ID already exists
   645→        const metaCtx = await loadMetaContext(ctx);
   646→        const existingSkill = metaCtx.skills.find((s) => s.id === skillId);
   647→        if (existingSkill) {
   648→          error(`Skill with ID '${skillId}' already exists. Use --id to specify a different ID.`);
   649→          process.exit(EXIT_CODES.CONFLICT);
   650→        }
   651→
   652→        // Build skill object
   653→        const skillData: Skill = {
   654→          _ulid: ulid(),
   655→          id: skillId,
   656→          name: skillName,
   657→          description: skillDescription,
   658→          origin: options.origin as SkillOrigin,
   659→          version: options.skillVersion,
   660→          platforms: ["claude-code"],
   661→          depends_on: [],
   662→          tags: [],
   663→        };
   664→
   665→        // Validate with schema
   666→        const parsed = SkillSchema.safeParse(skillData);
   667→        if (!parsed.success) {
   668→          const issues = parsed.error.issues
   669→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   670→            .join("; ");
   671→          error(`Invalid skill data: ${issues}`);
   672→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   673→        }
   674→
   675→        const skill: LoadedSkill = { ...parsed.data };
   676→
   677→        // Save meta entry (also creates directory)
   678→        await saveMetaItem(ctx, skill, "skill");
   679→
   680→        // AC: @skill-import ac-7 - Strip/normalize base-directory paths
   681→        const normalizedContent = normalizeBaseDirectory(content);
   682→
   683→        // AC: @skill-import ac-2 - Copy content to .kspec/skills/<id>/SKILL.md
   684→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   685→        await fs.writeFile(skillMdPath, normalizedContent, "utf-8");
   686→
   687→        // AC: @skill-import ac-3 - Copy docs/ subdirectory if present
   688→        const sourceDocsDir = path.join(sourceDir, "docs");
   689→        try {
   690→          const docsStats = await fs.stat(sourceDocsDir);
   691→          if (docsStats.isDirectory()) {
   692→            const targetDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
   693→            await fs.mkdir(targetDocsDir, { recursive: true });
   694→            await copyDirectory(sourceDocsDir, targetDocsDir);
   695→          }
   696→        } catch {
   697→          // No docs directory, that's fine
   698→        }
   699→
   700→        // Commit changes
   701→        await commitIfShadow(ctx.shadow, "skill-import", skill.id, skill.name);
   702→
   703→        output(skill, () =>
   704→          success(`Imported skill: ${skill.id}`, { skill }),
   705→        );
   706→      } catch (err) {
   707→        error("Failed to import skill", err);
   708→        process.exit(EXIT_CODES.ERROR);
   709→      }
   710→    });
   711→
   712→  // AC: @skill-rendering ac-1 through ac-5 - kspec skill render
   713→  // AC: @skill-render-cli ac-1, ac-2 - kspec skill render / kspec skill render @skill-id
   714→  // AC: @skill-drift-detection ac-3, ac-4 - drift handling with --force
   715→  // AC: @trait-dry-run - supports --dry-run
   716→  // AC: @trait-error-guidance - provides error guidance
   717→  skill
   718→    .command("render [ref]")
   719→    .description(
   720→      "Render skills from shadow branch to platform-specific files on main branch"
   721→    )
   722→    .option("--clean", "Remove orphaned managed skill directories")
   723→    .option("--dry-run", "Show what would be changed without applying")
   724→    .option("--force", "Overwrite drifted skill files (manually edited)")
   725→    .option("--skill <id>", "Render only a specific skill (deprecated, use positional arg)")
   726→    .action(async (ref: string | undefined, options) => {
   727→      try {
   728→        const ctx = await initContext();
   729→
   730→        if (!ctx.manifestPath) {
   731→          error(errors.project.noKspecProject);
   732→          console.log(
   733→            chalk.gray("Try: kspec init to initialize a kspec project")
   734→          );
   735→          process.exit(EXIT_CODES.ERROR);
   736→        }
   737→
   738→        const metaCtx = await loadMetaContext(ctx);
   739→        // Use rootDir (project root), not specDir (which is .kspec/ in shadow mode)
   740→        const projectRoot = ctx.rootDir;
   741→        const dryRun = options.dryRun || false;
   742→        const force = options.force || false;
   743→        const results: SkillRenderResult[] = [];
   744→        const cleanResults: CleanResult[] = [];
   745→
   746→        // Filter skills by platform (only claude-code for now)
   747→        let skillsToRender = metaCtx.skills.filter((s) =>
   748→          s.platforms.includes("claude-code")
   749→        );
   750→
   751→        // AC: @skill-render-cli ac-2 - Filter to specific skill if requested
   752→        // Support both positional ref argument and --skill option
   753→        const skillRef = ref || options.skill;
   754→        if (skillRef) {
   755→          // Resolve the ref to a skill
   756→          const item = findMetaItemByRef(metaCtx, skillRef);
   757→          if (!item || !("origin" in item)) {
   758→            error(`Skill not found: ${skillRef}`);
   759→            console.log(chalk.gray("Try: kspec skill list"));
   760→            process.exit(EXIT_CODES.NOT_FOUND);
   761→          }
   762→          const skill = item as LoadedSkill;
   763→          skillsToRender = skillsToRender.filter((s) => s.id === skill.id);
   764→          if (skillsToRender.length === 0) {
   765→            error(`Skill '${skill.id}' does not have claude-code platform`);
   766→            process.exit(EXIT_CODES.ERROR);
   767→          }
   768→        }
   769→
   770→        // Ensure .claude/skills directory exists
   771→        const targetSkillsDir = path.join(projectRoot, ".claude", "skills");
   772→        if (!dryRun) {
   773→          await fs.mkdir(targetSkillsDir, { recursive: true });
   774→        }
   775→
   776→        // Render each skill
   777→        // AC: @skill-drift-detection ac-3, ac-4 - Check drift and skip without --force
   778→        for (const skill of skillsToRender) {
   779→          // Check for drift before rendering
   780→          const driftStatus = await checkSkillDrift(ctx.specDir, projectRoot, skill.id);
   781→
   782→          // AC: @skill-drift-detection ac-3 - Skip drifted skills without --force
   783→          if (driftStatus === "drifted" && !force) {
   784→            const renderedPath = path.join(
   785→              projectRoot,
   786→              ".claude",
   787→              "skills",
   788→              skill.id,
   789→              "SKILL.md"
   790→            );
   791→            results.push({
   792→              id: skill.id,
   793→              action: "skipped",
   794→              path: renderedPath,
   795→              skipReason: "drifted (use --force to overwrite)",
   796→            });
   797→            continue;
   798→          }
   799→
   800→          // AC: @skill-drift-detection ac-4 - Render (overwrite) when --force is used
   801→          const result = await renderSkill(ctx, projectRoot, skill, dryRun);
   802→          results.push(result);
   803→        }
   804→
   805→        // Handle --clean: remove orphaned managed skills
   806→        // AC: @skill-rendering ac-4, ac-5
   807→        if (options.clean) {
   808→          const activeSkillIds = new Set(metaCtx.skills.map((s) => s.id));
   809→
   810→          try {
   811→            const entries = await fs.readdir(targetSkillsDir, {
   812→              withFileTypes: true,
   813→            });
   814→
   815→            for (const entry of entries) {
   816→              if (!entry.isDirectory()) continue;
   817→
   818→              const skillId = entry.name;
   819→              const skillDir = path.join(targetSkillsDir, skillId);
   820→              const skillMdPath = path.join(skillDir, "SKILL.md");
   821→
   822→              // Skip if skill still exists in meta
   823→              if (activeSkillIds.has(skillId)) continue;
   824→
   825→              // AC: @skill-rendering ac-4 - Only consider kspec-managed skills
   826→              const isManaged = await isKspecManaged(skillMdPath);
   827→
   828→              if (isManaged) {
   829→                // AC: @skill-rendering ac-5 - Remove orphaned directory
   830→                if (!dryRun) {
   831→                  await fs.rm(skillDir, { recursive: true, force: true });
   832→                }
   833→                cleanResults.push({
   834→                  id: skillId,
   835→                  path: skillDir,
   836→                  action: "removed",
   837→                });
   838→              } else {
   839→                cleanResults.push({
   840→                  id: skillId,
   841→                  path: skillDir,
   842→                  action: "skipped",
   843→                  reason: "Not managed by kspec",
   844→                });
   845→              }
   846→            }
   847→          } catch {
   848→            // No .claude/skills directory, nothing to clean
   849→          }
   850→        }
   851→
   852→        // Output results
   853→        // AC: @trait-dry-run ac-6 - JSON output includes dry_run field
   854→        output(
   855→          {
   856→            dry_run: dryRun,
   857→            rendered: results,
   858→            cleaned: cleanResults,
   859→          },
   860→          () => {
   861→            // AC: @trait-dry-run ac-3 - Clear indication this is a preview
   862→            if (dryRun) {
   863→              console.log(chalk.yellow("DRY RUN - No changes made"));
   864→              console.log();
   865→            }
   866→
   867→            // Render results
   868→            const created = results.filter((r) => r.action === "created");
   869→            const updated = results.filter((r) => r.action === "updated");
   870→            const unchanged = results.filter((r) => r.action === "unchanged");
   871→            // AC: @skill-drift-detection ac-3 - Track skipped drifted skills
   872→            const skippedDrifted = results.filter((r) => r.action === "skipped");
   873→
   874→            if (created.length > 0) {
   875→              console.log(chalk.green(`Created: ${created.length} skill(s)`));
   876→              for (const r of created) {
   877→                console.log(`  ${chalk.green("+")} ${r.id}`);
   878→              }
   879→            }
   880→
   881→            if (updated.length > 0) {
   882→              console.log(chalk.blue(`Updated: ${updated.length} skill(s)`));
   883→              for (const r of updated) {
   884→                console.log(`  ${chalk.blue("~")} ${r.id}`);
   885→              }
   886→            }
   887→
   888→            if (unchanged.length > 0 && results.length <= 10) {
   889→              console.log(chalk.gray(`Unchanged: ${unchanged.length} skill(s)`));
   890→            }
   891→
   892→            // AC: @skill-drift-detection ac-3 - Show warning for skipped drifted skills
   893→            if (skippedDrifted.length > 0) {
   894→              console.log();
   895→              console.log(chalk.yellow(`Skipped: ${skippedDrifted.length} drifted skill(s)`));
   896→              for (const r of skippedDrifted) {
   897→                console.log(`  ${chalk.yellow("!")} ${r.id}: ${r.skipReason || "drifted"}`);
   898→              }
   899→              console.log();
   900→              console.log(chalk.yellow("Use --force to overwrite drifted skills"));
   901→            }
   902→
   903→            // Clean results
   904→            if (cleanResults.length > 0) {
   905→              const removed = cleanResults.filter((r) => r.action === "removed");
   906→              const skipped = cleanResults.filter((r) => r.action === "skipped");
   907→
   908→              if (removed.length > 0) {
   909→                console.log();
   910→                console.log(chalk.red(`Removed: ${removed.length} orphaned skill(s)`));
   911→                for (const r of removed) {
   912→                  console.log(`  ${chalk.red("-")} ${r.id}`);
   913→                }
   914→              }
   915→
   916→              if (skipped.length > 0) {
   917→                console.log(
   918→                  chalk.gray(`Skipped: ${skipped.length} unmanaged skill(s)`)
   919→                );
   920→              }
   921→            }
   922→
   923→            // Summary
   924→            console.log();
   925→            if (dryRun) {
   926→              console.log(
   927→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
   928→              );
   929→            } else {
   930→              const changedCount = created.length + updated.length;
   931→              const cleanedCount = cleanResults.filter(
   932→                (r) => r.action === "removed"
   933→              ).length;
   934→              if (changedCount > 0 || cleanedCount > 0) {
   935→                success(
   936→                  `Rendered ${changedCount} skill(s)${cleanedCount > 0 ? `, cleaned ${cleanedCount}` : ""}`
   937→                );
   938→              } else {
   939→                console.log(chalk.gray("No changes needed"));
   940→              }
   941→            }
   942→          }
   943→        );
   944→      } catch (err) {
   945→        error("Failed to render skills", err);
   946→        process.exit(EXIT_CODES.ERROR);
   947→      }
   948→    });
   949→
   950→  // AC: @skill-render-cli ac-3 - kspec skill status
   951→  skill
   952→    .command("status")
   953→    .description("Show sync status of rendered skills")
   954→    .action(async () => {
   955→      try {
   956→        const ctx = await initContext();
   957→
   958→        if (!ctx.manifestPath) {
   959→          error(errors.project.noKspecProject);
   960→          console.log(
   961→            chalk.gray("Try: kspec init to initialize a kspec project")
   962→          );
   963→          process.exit(EXIT_CODES.ERROR);
   964→        }
   965→
   966→        const metaCtx = await loadMetaContext(ctx);
   967→        const projectRoot = ctx.rootDir;
   968→
   969→        // Filter skills by platform (only claude-code for now)
   970→        const skillsToCheck = metaCtx.skills.filter((s) =>
   971→          s.platforms.includes("claude-code")
   972→        );
   973→
   974→        if (skillsToCheck.length === 0) {
   975→          console.log(chalk.yellow("No skills found"));
   976→          return;
   977→        }
   978→
   979→        const statusResults: SkillStatusResult[] = [];
   980→
   981→        for (const skill of skillsToCheck) {
   982→          const status = await getSkillSyncStatus(ctx, projectRoot, skill);
   983→          statusResults.push(status);
   984→        }
   985→
   986→        // Output results
   987→        output(
   988→          statusResults,
   989→          () => {
   990→            const table = new Table({
   991→              head: [
   992→                chalk.bold("ID"),
   993→                chalk.bold("Status"),
   994→                chalk.bold("Docs"),
   995→              ],
   996→              style: {
   997→                head: [],
   998→                border: [],
   999→              },
  1000→            });
  1001→
  1002→            for (const result of statusResults) {
  1003→              const statusColor =
  1004→                result.status === "in-sync"
  1005→                  ? chalk.green
  1006→                  : result.status === "drifted"
  1007→                    ? chalk.yellow
  1008→                    : chalk.gray;
  1009→
  1010→              const docsStatusColor =
  1011→                result.docsStatus === "in-sync"
  1012→                  ? chalk.green
  1013→                  : result.docsStatus === "drifted"
  1014→                    ? chalk.yellow
  1015→                    : chalk.gray;
  1016→
  1017→              table.push([
  1018→                result.id,
  1019→                statusColor(result.status),
  1020→                docsStatusColor(result.docsStatus || "-"),
  1021→              ]);
  1022→            }
  1023→
  1024→            console.log(table.toString());
  1025→
  1026→            // Summary
  1027→            const inSync = statusResults.filter((r) => r.status === "in-sync").length;
  1028→            const drifted = statusResults.filter((r) => r.status === "drifted").length;
  1029→            const notRendered = statusResults.filter((r) => r.status === "not-rendered").length;
  1030→
  1031→            console.log();
  1032→            if (drifted > 0) {
  1033→              console.log(chalk.yellow(`${drifted} skill(s) drifted - run 'kspec skill render' to sync`));
  1034→            }
  1035→            if (notRendered > 0) {
  1036→              console.log(chalk.gray(`${notRendered} skill(s) not rendered`));
  1037→            }
  1038→            if (inSync === statusResults.length) {
  1039→              console.log(chalk.green("All skills in sync"));
  1040→            }
  1041→          }
  1042→        );
  1043→      } catch (err) {
  1044→        error("Failed to check skill status", err);
  1045→        process.exit(EXIT_CODES.ERROR);
  1046→      }
  1047→    });
  1048→
  1049→  // AC: @skill-render-cli ac-4 - kspec skill diff
  1050→  skill
  1051→    .command("diff <ref>")
  1052→    .description("Show diff between source and rendered skill")
  1053→    .action(async (ref: string) => {
  1054→      try {
  1055→        const ctx = await initContext();
  1056→
  1057→        if (!ctx.manifestPath) {
  1058→          error(errors.project.noKspecProject);
  1059→          console.log(
  1060→            chalk.gray("Try: kspec init to initialize a kspec project")
  1061→          );
  1062→          process.exit(EXIT_CODES.ERROR);
  1063→        }
  1064→
  1065→        const metaCtx = await loadMetaContext(ctx);
  1066→        const item = findMetaItemByRef(metaCtx, ref);
  1067→
  1068→        if (!item) {
  1069→          error(`Skill not found: ${ref}`);
  1070→          console.log(chalk.gray("Try: kspec skill list"));
  1071→          process.exit(EXIT_CODES.NOT_FOUND);
  1072→        }
  1073→
  1074→        // Check it's a skill
  1075→        if (!("origin" in item)) {
  1076→          error(`Item ${ref} is not a skill`);
  1077→          process.exit(EXIT_CODES.ERROR);
  1078→        }
  1079→
  1080→        const skill = item as LoadedSkill;
  1081→        const projectRoot = ctx.rootDir;
  1082→
  1083→        // Get expected rendered content
  1084→        const expectedContent = await getExpectedRenderedContent(ctx, skill);
  1085→
  1086→        // Get actual rendered content
  1087→        const renderedPath = path.join(
  1088→          projectRoot,
  1089→          ".claude",
  1090→          "skills",
  1091→          skill.id,
  1092→          "SKILL.md"
  1093→        );
  1094→
  1095→        let actualContent = "";
  1096→        try {
  1097→          actualContent = await fs.readFile(renderedPath, "utf-8");
  1098→        } catch {
  1099→          // File doesn't exist
  1100→        }
  1101→
  1102→        // Generate diff
  1103→        const diff = generateUnifiedDiff(
  1104→          actualContent,
  1105→          expectedContent,
  1106→          `a/${skill.id}/SKILL.md`,
  1107→          `b/${skill.id}/SKILL.md`
  1108→        );
  1109→
  1110→        // Output
  1111→        output(
  1112→          {
  1113→            id: skill.id,
  1114→            hasDiff: diff.length > 0,
  1115→            diff,
  1116→          },
  1117→          () => {
  1118→            if (diff.length === 0) {
  1119→              console.log(chalk.green(`${skill.id}: in sync`));
  1120→            } else {
  1121→              console.log(chalk.yellow(`${skill.id}: drifted`));
  1122→              console.log();
  1123→              // Print colored diff
  1124→              for (const line of diff) {
  1125→                if (line.startsWith("+") && !line.startsWith("+++")) {
  1126→                  console.log(chalk.green(line));
  1127→                } else if (line.startsWith("-") && !line.startsWith("---")) {
  1128→                  console.log(chalk.red(line));
  1129→                } else if (line.startsWith("@@")) {
  1130→                  console.log(chalk.cyan(line));
  1131→                } else {
  1132→                  console.log(line);
  1133→                }
  1134→              }
  1135→            }
  1136→          }
  1137→        );
  1138→      } catch (err) {
  1139→        error("Failed to generate diff", err);
  1140→        process.exit(EXIT_CODES.ERROR);
  1141→      }
  1142→    });
  1143→
  1144→  // AC: @core-skill-install - kspec skill install-core
  1145→  markMutating(skill.command("install-core"))
  1146→    .description(
  1147→      "Install core skills from kspec package templates"
  1148→    )
  1149→    .option("--force", "Overwrite custom forks with core versions")
  1150→    .option("--dry-run", "Show what would be installed without making changes")
  1151→    .action(async (options) => {
  1152→      try {
  1153→        const ctx = await initContext();
  1154→
  1155→        if (!ctx.manifestPath) {
  1156→          error(errors.project.noKspecProject);
  1157→          console.log(
  1158→            chalk.gray("Try: kspec init to initialize a kspec project")
  1159→          );
  1160→          process.exit(EXIT_CODES.ERROR);
  1161→        }
  1162→
  1163→        const metaCtx = await loadMetaContext(ctx);
  1164→        const dryRun = options.dryRun || false;
  1165→        const force = options.force || false;
  1166→        const results: CoreSkillInstallResult[] = [];
  1167→
  1168→        // Load core skills manifest
  1169→        const coreSkills = loadCoreSkillsManifest();
  1170→        if (coreSkills.length === 0) {
  1171→          console.log(chalk.yellow("No core skills found in kspec package templates"));
  1172→          return;
  1173→        }
  1174→
  1175→        // Get kspec package version
  1176→        const kspecVersion = getKspecPackageVersion();
  1177→
  1178→        // Process each core skill
  1179→        for (const coreSkill of coreSkills) {
  1180→          // AC: @core-skill-install ac-3 - Check if skill exists with custom origin
  1181→          const existingSkill = metaCtx.skills.find((s) => s.id === coreSkill.id);
  1182→
  1183→          if (existingSkill) {
  1184→            // Check origin - if "custom" or "project" and not forcing, skip
  1185→            if (existingSkill.origin !== "core" && !force) {
  1186→              results.push({
  1187→                id: coreSkill.id,
  1188→                action: "skipped",
  1189→                reason: `existing ${existingSkill.origin} skill (use --force to overwrite)`,
  1190→              });
  1191→              continue;
  1192→            }
  1193→          }
  1194→
  1195→          // AC: @core-skill-install ac-1 - Create/update meta entry with origin core
  1196→          // AC: @core-skill-install ac-5 - Version matches kspec package version
  1197→          const skillData: Skill = {
  1198→            _ulid: existingSkill?._ulid || ulid(),
  1199→            id: coreSkill.id,
  1200→            name: coreSkill.name,
  1201→            description: coreSkill.description,
  1202→            origin: "core",
  1203→            version: kspecVersion,
  1204→            platforms: coreSkill.platforms || ["claude-code"],
  1205→            depends_on: [],
  1206→            tags: ["core"],
  1207→          };
  1208→
  1209→          // Validate with schema
  1210→          const parsed = SkillSchema.safeParse(skillData);
  1211→          if (!parsed.success) {
  1212→            const issues = parsed.error.issues
  1213→              .map((i) => `${i.path.join(".")}: ${i.message}`)
  1214→              .join("; ");
  1215→            results.push({
  1216→              id: coreSkill.id,
  1217→              action: "failed",
  1218→              reason: `validation error: ${issues}`,
  1219→            });
  1220→            continue;
  1221→          }
  1222→
  1223→          const skill: LoadedSkill = { ...parsed.data };
  1224→
  1225→          // Save meta entry (if not dry run)
  1226→          if (!dryRun) {
  1227→            await saveMetaItem(ctx, skill, "skill");
  1228→
  1229→            // AC: @core-skill-install ac-2 - Copy SKILL.md content
  1230→            const sourceContent = loadCoreSkillContent(coreSkill.id);
  1231→            if (sourceContent) {
  1232→              const targetPath = getSkillContentPath(ctx, skill.id);
  1233→              await fs.writeFile(targetPath, sourceContent, "utf-8");
  1234→            }
  1235→          }
  1236→
  1237→          results.push({
  1238→            id: coreSkill.id,
  1239→            action: existingSkill ? "updated" : "created",
  1240→            version: kspecVersion,
  1241→          });
  1242→        }
  1243→
  1244→        // Commit changes if not dry run
  1245→        if (!dryRun && results.some((r) => r.action === "created" || r.action === "updated")) {
  1246→          await commitIfShadow(
  1247→            ctx.shadow,
  1248→            "skill-install-core",
  1249→            `${results.filter((r) => r.action !== "skipped" && r.action !== "failed").length} core skills`
  1250→          );
  1251→        }
  1252→
  1253→        // Output results
  1254→        output(
  1255→          {
  1256→            dry_run: dryRun,
  1257→            results,
  1258→          },
  1259→          () => {
  1260→            if (dryRun) {
  1261→              console.log(chalk.yellow("DRY RUN - No changes made"));
  1262→              console.log();
  1263→            }
  1264→
  1265→            const created = results.filter((r) => r.action === "created");
  1266→            const updated = results.filter((r) => r.action === "updated");
  1267→            const skipped = results.filter((r) => r.action === "skipped");
  1268→            const failed = results.filter((r) => r.action === "failed");
  1269→
  1270→            if (created.length > 0) {
  1271→              console.log(chalk.green(`Created: ${created.length} skill(s)`));
  1272→              for (const r of created) {
  1273→                console.log(`  ${chalk.green("+")} ${r.id} (v${r.version})`);
  1274→              }
  1275→            }
  1276→
  1277→            if (updated.length > 0) {
  1278→              console.log(chalk.blue(`Updated: ${updated.length} skill(s)`));
  1279→              for (const r of updated) {
  1280→                console.log(`  ${chalk.blue("~")} ${r.id} (v${r.version})`);
  1281→              }
  1282→            }
  1283→
  1284→            if (skipped.length > 0) {
  1285→              console.log(chalk.yellow(`Skipped: ${skipped.length} skill(s)`));
  1286→              for (const r of skipped) {
  1287→                console.log(`  ${chalk.yellow("!")} ${r.id}: ${r.reason}`);
  1288→              }
  1289→            }
  1290→
  1291→            if (failed.length > 0) {
  1292→              console.log(chalk.red(`Failed: ${failed.length} skill(s)`));
  1293→              for (const r of failed) {
  1294→                console.log(`  ${chalk.red("x")} ${r.id}: ${r.reason}`);
  1295→              }
  1296→            }
  1297→
  1298→            console.log();
  1299→            if (dryRun) {
  1300→              console.log(
  1301→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
  1302→              );
  1303→            } else {
  1304→              const changedCount = created.length + updated.length;
  1305→              if (changedCount > 0) {
  1306→                success(`Installed ${changedCount} core skill(s)`);
  1307→              } else if (skipped.length > 0) {
  1308→                console.log(chalk.gray("No skills installed (all skipped or failed)"));
  1309→              }
  1310→            }
  1311→          }
  1312→        );
  1313→      } catch (err) {
  1314→        error("Failed to install core skills", err);
  1315→        process.exit(EXIT_CODES.ERROR);
  1316→      }
  1317→    });
  1318→}
  1319→
  1320→/**
  1321→ * Result of installing a single core skill
  1322→ */
  1323→interface CoreSkillInstallResult {
  1324→  id: string;
  1325→  action: "created" | "updated" | "skipped" | "failed";
  1326→  version?: string;
  1327→  reason?: string;
  1328→}
  1329→
  1330→/**
  1331→ * Core skill definition from manifest
  1332→ */
  1333→interface CoreSkillDefinition {
  1334→  id: string;
  1335→  name: string;
  1336→  description?: string;
  1337→  platforms?: string[];
  1338→}
  1339→
  1340→/**
  1341→ * Get the kspec package version from package.json
  1342→ * AC: @core-skill-install ac-5
  1343→ */
  1344→function getKspecPackageVersion(): string {
  1345→  try {
  1346→    // Try to find package.json relative to this module
  1347→    const packagePath = path.resolve(
  1348→      import.meta.dirname || path.dirname(new URL(import.meta.url).pathname),
  1349→      "../../../package.json"
  1350→    );
  1351→    const packageJson = JSON.parse(readFileSync(packagePath, "utf-8"));
  1352→    return packageJson.version || "unknown";
  1353→  } catch {
  1354→    return "unknown";
  1355→  }
  1356→}
  1357→
  1358→/**
  1359→ * Get the templates directory path
  1360→ */
  1361→function getTemplatesDir(): string {
  1362→  // Templates are at <package-root>/templates/skills/
  1363→  return path.resolve(
  1364→    import.meta.dirname || path.dirname(new URL(import.meta.url).pathname),
  1365→    "../../../templates/skills"
  1366→  );
  1367→}
  1368→
  1369→/**
  1370→ * Load core skills manifest from templates/skills/manifest.yaml
  1371→ * AC: @core-skill-install ac-1, ac-2
  1372→ */
  1373→function loadCoreSkillsManifest(): CoreSkillDefinition[] {
  1374→  try {
  1375→    const templatesDir = getTemplatesDir();
  1376→    const manifestPath = path.join(templatesDir, "manifest.yaml");
  1377→    const content = readFileSync(manifestPath, "utf-8");
  1378→    const parsed = yaml.parse(content);
  1379→
  1380→    if (!parsed || !Array.isArray(parsed.skills)) {
  1381→      return [];
  1382→    }
  1383→
  1384→    return parsed.skills.map((s: Record<string, unknown>) => ({
  1385→      id: String(s.id || ""),
  1386→      name: String(s.name || s.id || ""),
  1387→      description: s.description ? String(s.description) : undefined,
  1388→      platforms: Array.isArray(s.platforms) ? s.platforms.map(String) : undefined,
  1389→    })).filter((s: CoreSkillDefinition) => s.id);
  1390→  } catch {
  1391→    return [];
  1392→  }
  1393→}
  1394→
  1395→/**
  1396→ * Load SKILL.md content for a core skill from templates
  1397→ * AC: @core-skill-install ac-2
  1398→ */
  1399→function loadCoreSkillContent(skillId: string): string | null {
  1400→  try {
  1401→    const templatesDir = getTemplatesDir();
  1402→    const skillMdPath = path.join(templatesDir, skillId, "SKILL.md");
  1403→    return readFileSync(skillMdPath, "utf-8");
  1404→  } catch {
  1405→    return null;
  1406→  }
  1407→}
  1408→
  1409→/**
  1410→ * Parse YAML frontmatter from markdown content.
  1411→ * Returns null if no valid frontmatter found.
  1412→ */
  1413→function parseFrontmatter(content: string): { name?: string; description?: string } | null {
  1414→  const frontmatterRegex = /^---\n([\s\S]*?)\n---/;
  1415→  const match = content.match(frontmatterRegex);
  1416→
  1417→  if (!match) {
  1418→    return null;
  1419→  }
  1420→
  1421→  try {
  1422→    const parsed = yaml.parse(match[1]);
  1423→
  1424→    if (typeof parsed === "object" && parsed !== null) {
  1425→      return {
  1426→        name: typeof parsed.name === "string" ? parsed.name : undefined,
  1427→        description: typeof parsed.description === "string" ? parsed.description : undefined,
  1428→      };
  1429→    }
  1430→  } catch {
  1431→    // Invalid YAML in frontmatter
  1432→  }
  1433→
  1434→  return null;
  1435→}
  1436→
  1437→/**
  1438→ * Normalize base-directory paths in skill content.
  1439→ * AC: @skill-import ac-7 - Strip or convert absolute paths to relative.
  1440→ *
  1441→ * Matches patterns like:
  1442→ * - "Base directory for this skill: /absolute/path/to/skill"
  1443→ * - Lines starting with hardcoded paths
  1444→ */
  1445→function normalizeBaseDirectory(content: string): string {
  1446→  // Remove or normalize "Base directory for this skill:" lines with absolute paths
  1447→  // Common pattern in Claude-generated skill files
  1448→  const baseDirLineRegex = /^Base directory for this skill:.*$/gm;
  1449→
  1450→  return content.replace(baseDirLineRegex, "");
  1451→}
  1452→
  1453→/**
  1454→ * Recursively copy a directory
  1455→ */
  1456→async function copyDirectory(src: string, dest: string): Promise<void> {
  1457→  const entries = await fs.readdir(src, { withFileTypes: true });
  1458→
  1459→  for (const entry of entries) {
  1460→    const srcPath = path.join(src, entry.name);
  1461→    const destPath = path.join(dest, entry.name);
  1462→
  1463→    if (entry.isDirectory()) {
  1464→      await fs.mkdir(destPath, { recursive: true });
  1465→      await copyDirectory(srcPath, destPath);
  1466→    } else {
  1467→      await fs.copyFile(srcPath, destPath);
  1468→    }
  1469→  }
  1470→}
  1471→
  1472→/**
  1473→ * Marker comment that identifies skill directories managed by kspec
  1474→ * AC: @skill-rendering ac-4 - Only skill directories that were rendered by kspec are considered
  1475→ */
  1476→const KSPEC_MANAGED_MARKER = "<!-- kspec-managed -->";
  1477→
  1478→/**
  1479→ * Result of rendering a single skill
  1480→ * AC: @skill-drift-detection ac-3 - Includes "skipped" action for drifted skills
  1481→ */
  1482→interface SkillRenderResult {
  1483→  id: string;
  1484→  action: "created" | "updated" | "unchanged" | "skipped";
  1485→  path: string;
  1486→  docsAction?: "created" | "updated" | "unchanged" | "skipped";
  1487→  /** Reason why skill was skipped */
  1488→  skipReason?: string;
  1489→}
  1490→
  1491→/**
  1492→ * Result of a clean operation
  1493→ */
  1494→interface CleanResult {
  1495→  id: string;
  1496→  path: string;
  1497→  action: "removed" | "skipped";
  1498→  reason?: string;
  1499→}
  1500→
  1501→/**
  1502→ * Generate YAML frontmatter for a skill
  1503→ * AC: @skill-rendering ac-1 - .claude/skills/<id>/SKILL.md is created with YAML frontmatter
  1504→ */
  1505→function generateFrontmatter(skill: LoadedSkill): string {
  1506→  const frontmatter: Record<string, unknown> = {
  1507→    name: skill.id,
  1508→    description: skill.description || skill.name,
  1509→  };
  1510→  return `---\n${yaml.stringify(frontmatter).trim()}\n---`;
  1511→}
  1512→
  1513→/**
  1514→ * Check if two contents are equal (for idempotency check)
  1515→ */
  1516→function contentsEqual(a: string, b: string): boolean {
  1517→  return a.trim() === b.trim();
  1518→}
  1519→
  1520→/**
  1521→ * Check if a directory is managed by kspec
  1522→ * AC: @skill-rendering ac-4 - Only skill directories rendered by kspec are considered
  1523→ */
  1524→async function isKspecManaged(skillMdPath: string): Promise<boolean> {
  1525→  try {
  1526→    const content = await fs.readFile(skillMdPath, "utf-8");
  1527→    return content.includes(KSPEC_MANAGED_MARKER);
  1528→  } catch {
  1529→    return false;
  1530→  }
  1531→}
  1532→
  1533→/**
  1534→ * Compute SHA256 hash of content
  1535→ * AC: @skill-drift-detection ac-5 - Hash computation for render tracking
  1536→ */
  1537→function computeContentHash(content: string): string {
  1538→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
  1539→}
  1540→
  1541→/**
  1542→ * Get the path to the render hash file for a skill
  1543→ * AC: @skill-drift-detection ac-5 - Hash stored in .kspec/skills/<id>/.render-hash
  1544→ */
  1545→function getRenderHashPath(specDir: string, skillId: string): string {
  1546→  return path.join(specDir, "skills", skillId, ".render-hash");
  1547→}
  1548→
  1549→/**
  1550→ * Read the stored render hash for a skill
  1551→ * AC: @skill-drift-detection ac-5 - Read hash from .kspec/skills/<id>/.render-hash
  1552→ */
  1553→async function readRenderHash(specDir: string, skillId: string): Promise<string | null> {
  1554→  try {
  1555→    const hashPath = getRenderHashPath(specDir, skillId);
  1556→    const content = await fs.readFile(hashPath, "utf-8");
  1557→    return content.trim();
  1558→  } catch {
  1559→    return null;
  1560→  }
  1561→}
  1562→
  1563→/**
  1564→ * Write the render hash for a skill
  1565→ * AC: @skill-drift-detection ac-5 - Store hash in .kspec/skills/<id>/.render-hash
  1566→ */
  1567→async function writeRenderHash(specDir: string, skillId: string, hash: string): Promise<void> {
  1568→  const hashPath = getRenderHashPath(specDir, skillId);
  1569→  await fs.mkdir(path.dirname(hashPath), { recursive: true });
  1570→  await fs.writeFile(hashPath, hash + "\n", "utf-8");
  1571→}
  1572→
  1573→/**
  1574→ * Check if a rendered skill has drifted from its last render
  1575→ * AC: @skill-drift-detection ac-1, ac-2 - Drift detection via hash comparison
  1576→ *
  1577→ * Returns:
  1578→ * - "not-rendered": Rendered file doesn't exist
  1579→ * - "in-sync": Rendered file matches stored hash
  1580→ * - "drifted": Rendered file differs from stored hash (manually edited)
  1581→ * - "no-hash": Rendered file exists but no stored hash (first render or hash deleted)
  1582→ */
  1583→async function checkSkillDrift(
  1584→  specDir: string,
  1585→  projectRoot: string,
  1586→  skillId: string
  1587→): Promise<"not-rendered" | "in-sync" | "drifted" | "no-hash"> {
  1588→  const renderedPath = path.join(projectRoot, ".claude", "skills", skillId, "SKILL.md");
  1589→
  1590→  // Check if rendered file exists
  1591→  let renderedContent: string;
  1592→  try {
  1593→    renderedContent = await fs.readFile(renderedPath, "utf-8");
  1594→  } catch {
  1595→    return "not-rendered";
  1596→  }
  1597→
  1598→  // Get stored hash
  1599→  const storedHash = await readRenderHash(specDir, skillId);
  1600→  if (!storedHash) {
  1601→    return "no-hash";
  1602→  }
  1603→
  1604→  // Compare hashes
  1605→  const currentHash = computeContentHash(renderedContent);
  1606→  return currentHash === storedHash ? "in-sync" : "drifted";
  1607→}
  1608→
  1609→/**
  1610→ * Recursively check if two directories have the same contents
  1611→ */
  1612→async function directoriesEqual(src: string, dest: string): Promise<boolean> {
  1613→  try {
  1614→    const srcEntries = await fs.readdir(src, { withFileTypes: true });
  1615→    const destEntries = await fs.readdir(dest, { withFileTypes: true });
  1616→
  1617→    // Different number of entries = not equal
  1618→    if (srcEntries.length !== destEntries.length) {
  1619→      return false;
  1620→    }
  1621→
  1622→    // Create a map of dest entries for quick lookup
  1623→    const destMap = new Map(destEntries.map((e) => [e.name, e]));
  1624→
  1625→    for (const srcEntry of srcEntries) {
  1626→      const destEntry = destMap.get(srcEntry.name);
  1627→      if (!destEntry) {
  1628→        return false;
  1629→      }
  1630→
  1631→      const srcPath = path.join(src, srcEntry.name);
  1632→      const destPath = path.join(dest, srcEntry.name);
  1633→
  1634→      if (srcEntry.isDirectory() && destEntry.isDirectory()) {
  1635→        if (!(await directoriesEqual(srcPath, destPath))) {
  1636→          return false;
  1637→        }
  1638→      } else if (srcEntry.isFile() && destEntry.isFile()) {
  1639→        const srcContent = await fs.readFile(srcPath, "utf-8");
  1640→        const destContent = await fs.readFile(destPath, "utf-8");
  1641→        if (!contentsEqual(srcContent, destContent)) {
  1642→          return false;
  1643→        }
  1644→      } else {
  1645→        // Type mismatch
  1646→        return false;
  1647→      }
  1648→    }
  1649→
  1650→    return true;
  1651→  } catch {
  1652→    return false;
  1653→  }
  1654→}
  1655→
  1656→/**
  1657→ * Get the target path for rendered skills (main branch .claude/skills/)
  1658→ */
  1659→function getRenderedSkillPath(projectRoot: string, skillId: string): string {
  1660→  return path.join(projectRoot, ".claude", "skills", skillId);
  1661→}
  1662→
  1663→/**
  1664→ * Render a single skill from shadow branch to main branch.
  1665→ * AC: @skill-rendering ac-1 - Creates .claude/skills/<id>/SKILL.md with YAML frontmatter
  1666→ * AC: @skill-rendering ac-2 - Copies docs to .claude/skills/<id>/docs/
  1667→ * AC: @skill-rendering ac-3 - Idempotent (no changes if content unchanged)
  1668→ */
  1669→async function renderSkill(
  1670→  ctx: KspecContext,
  1671→  projectRoot: string,
  1672→  skill: LoadedSkill,
  1673→  dryRun: boolean
  1674→): Promise<SkillRenderResult> {
  1675→  const targetDir = getRenderedSkillPath(projectRoot, skill.id);
  1676→  const targetSkillMd = path.join(targetDir, "SKILL.md");
  1677→
  1678→  // Load source content
  1679→  const sourceContent = await loadSkillContent(ctx, skill);
  1680→  if (!sourceContent) {
  1681→    // No source content, but skill exists in meta - create placeholder
  1682→    const frontmatter = generateFrontmatter(skill);
  1683→    const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
  1684→
  1685→    if (!dryRun) {
  1686→      await fs.mkdir(targetDir, { recursive: true });
  1687→      await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
  1688→      // AC: @skill-drift-detection ac-5 - Store hash of rendered output
  1689→      const hash = computeContentHash(renderedContent);
  1690→      await writeRenderHash(ctx.specDir, skill.id, hash);
  1691→    }
  1692→
  1693→    return {
  1694→      id: skill.id,
  1695→      action: "created",
  1696→      path: targetSkillMd,
  1697→    };
  1698→  }
  1699→
  1700→  // Generate rendered content with frontmatter and marker
  1701→  const frontmatter = generateFrontmatter(skill);
  1702→
  1703→  // Check if source already has frontmatter - if so, strip it
  1704→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
  1705→  const contentWithoutFrontmatter = frontmatterMatch
  1706→    ? sourceContent.slice(frontmatterMatch[0].length)
  1707→    : sourceContent;
  1708→
  1709→  // Build the rendered content
  1710→  const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
  1711→
  1712→  // Check if target exists and compare for idempotency
  1713→  // AC: @skill-rendering ac-3 - No changes if content unchanged
  1714→  let targetExists = false;
  1715→  let targetContent = "";
  1716→  try {
  1717→    targetContent = await fs.readFile(targetSkillMd, "utf-8");
  1718→    targetExists = true;
  1719→  } catch {
  1720→    // Target doesn't exist
  1721→  }
  1722→
  1723→  // Determine action based on comparison
  1724→  let action: "created" | "updated" | "unchanged";
  1725→
  1726→  if (!targetExists) {
  1727→    action = "created";
  1728→  } else if (contentsEqual(renderedContent, targetContent)) {
  1729→    action = "unchanged";
  1730→  } else {
  1731→    action = "updated";
  1732→  }
  1733→
  1734→  // Apply changes if not dry run and there are changes
  1735→  if (!dryRun && action !== "unchanged") {
  1736→    await fs.mkdir(targetDir, { recursive: true });
  1737→    await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
  1738→    // AC: @skill-drift-detection ac-5 - Store hash of rendered output
  1739→    const hash = computeContentHash(renderedContent);
  1740→    await writeRenderHash(ctx.specDir, skill.id, hash);
  1741→  }
  1742→
  1743→  // Handle docs directory
  1744→  // AC: @skill-rendering ac-2 - Copy docs to target
  1745→  const sourceDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
  1746→  const targetDocsDir = path.join(targetDir, "docs");
  1747→  let docsAction: "created" | "updated" | "unchanged" | "skipped" = "skipped";
  1748→
  1749→  try {
  1750→    const stats = await fs.stat(sourceDocsDir);
  1751→    if (stats.isDirectory()) {
  1752→      // Check if target docs exist and compare
  1753→      let targetDocsExist = false;
  1754→      try {
  1755→        await fs.stat(targetDocsDir);
  1756→        targetDocsExist = true;
  1757→      } catch {
  1758→        // Target docs don't exist
  1759→      }
  1760→
  1761→      if (!targetDocsExist) {
  1762→        docsAction = "created";
  1763→      } else {
  1764→        // Compare directories
  1765→        const equal = await directoriesEqual(sourceDocsDir, targetDocsDir);
  1766→        docsAction = equal ? "unchanged" : "updated";
  1767→      }
  1768→
  1769→      // Apply changes
  1770→      if (!dryRun && docsAction !== "unchanged") {
  1771→        // Remove existing docs and copy fresh
  1772→        if (targetDocsExist) {
  1773→          await fs.rm(targetDocsDir, { recursive: true, force: true });
  1774→        }
  1775→        await fs.mkdir(targetDocsDir, { recursive: true });
  1776→        await copyDirectory(sourceDocsDir, targetDocsDir);
  1777→      }
  1778→    }
  1779→  } catch {
  1780→    // No source docs directory
  1781→  }
  1782→
  1783→  return {
  1784→    id: skill.id,
  1785→    action,
  1786→    path: targetSkillMd,
  1787→    docsAction,
  1788→  };
  1789→}
  1790→
  1791→/**
  1792→ * Result of checking a skill's sync status
  1793→ * AC: @skill-render-cli ac-3
  1794→ */
  1795→interface SkillStatusResult {
  1796→  id: string;
  1797→  status: "in-sync" | "drifted" | "not-rendered";
  1798→  docsStatus?: "in-sync" | "drifted" | "not-rendered" | "no-docs";
  1799→}
  1800→
  1801→/**
  1802→ * Get the sync status of a skill
  1803→ * AC: @skill-render-cli ac-3
  1804→ * AC: @skill-drift-detection ac-1, ac-2 - Uses hash-based drift detection
  1805→ */
  1806→async function getSkillSyncStatus(
  1807→  ctx: KspecContext,
  1808→  projectRoot: string,
  1809→  skill: LoadedSkill
  1810→): Promise<SkillStatusResult> {
  1811→  // AC: @skill-drift-detection ac-1, ac-2 - Use hash-based drift detection
  1812→  const driftStatus = await checkSkillDrift(ctx.specDir, projectRoot, skill.id);
  1813→
  1814→  // Map drift status to sync status
  1815→  let status: "in-sync" | "drifted" | "not-rendered";
  1816→  switch (driftStatus) {
  1817→    case "in-sync":
  1818→      status = "in-sync";
  1819→      break;
  1820→    case "drifted":
  1821→      status = "drifted";
  1822→      break;
  1823→    case "not-rendered":
  1824→      status = "not-rendered";
  1825→      break;
  1826→    case "no-hash":
  1827→      // No hash stored - need to check if content matches expected
  1828→      // (handles edge case where skill was rendered before hash tracking was added)
  1829→      const expectedContent = await getExpectedRenderedContent(ctx, skill);
  1830→      const renderedPath = path.join(
  1831→        projectRoot,
  1832→        ".claude",
  1833→        "skills",
  1834→        skill.id,
  1835→        "SKILL.md"
  1836→      );
  1837→      try {
  1838→        const actualContent = await fs.readFile(renderedPath, "utf-8");
  1839→        status = contentsEqual(expectedContent, actualContent) ? "in-sync" : "drifted";
  1840→      } catch {
  1841→        status = "not-rendered";
  1842→      }
  1843→      break;
  1844→  }
  1845→
  1846→  // Check docs status
  1847→  const sourceDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
  1848→  const targetDocsDir = path.join(projectRoot, ".claude", "skills", skill.id, "docs");
  1849→  let docsStatus: "in-sync" | "drifted" | "not-rendered" | "no-docs" = "no-docs";
  1850→
  1851→  try {
  1852→    await fs.stat(sourceDocsDir);
  1853→    // Source docs exist, check target
  1854→    try {
  1855→      await fs.stat(targetDocsDir);
  1856→      // Both exist, compare
  1857→      const equal = await directoriesEqual(sourceDocsDir, targetDocsDir);
  1858→      docsStatus = equal ? "in-sync" : "drifted";
  1859→    } catch {
  1860→      docsStatus = "not-rendered";
  1861→    }
  1862→  } catch {
  1863→    // No source docs
  1864→    docsStatus = "no-docs";
  1865→  }
  1866→
  1867→  return {
  1868→    id: skill.id,
  1869→    status,
  1870→    docsStatus,
  1871→  };
  1872→}
  1873→
  1874→/**
  1875→ * Get the expected rendered content for a skill
  1876→ */
  1877→async function getExpectedRenderedContent(
  1878→  ctx: KspecContext,
  1879→  skill: LoadedSkill
  1880→): Promise<string> {
  1881→  const sourceContent = await loadSkillContent(ctx, skill);
  1882→
  1883→  if (!sourceContent) {
  1884→    // No source content, generate placeholder
  1885→    const frontmatter = generateFrontmatter(skill);
  1886→    return `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
  1887→  }
  1888→
  1889→  // Generate rendered content with frontmatter and marker
  1890→  const frontmatter = generateFrontmatter(skill);
  1891→
  1892→  // Check if source already has frontmatter - if so, strip it
  1893→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
  1894→  const contentWithoutFrontmatter = frontmatterMatch
  1895→    ? sourceContent.slice(frontmatterMatch[0].length)
  1896→    : sourceContent;
  1897→
  1898→  return `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
  1899→}
  1900→
  1901→/**
  1902→ * Generate unified diff between two strings
  1903→ * AC: @skill-render-cli ac-4
  1904→ */
  1905→function generateUnifiedDiff(
  1906→  actual: string,
  1907→  expected: string,
  1908→  actualPath: string,
  1909→  expectedPath: string
  1910→): string[] {
  1911→  if (contentsEqual(actual, expected)) {
  1912→    return [];
  1913→  }
  1914→
  1915→  const actualLines = actual.split("\n");
  1916→  const expectedLines = expected.split("\n");
  1917→  const diffLines: string[] = [];
  1918→
  1919→  // Simple line-by-line diff (unified format)
  1920→  diffLines.push(`--- ${actualPath}`);
  1921→  diffLines.push(`+++ ${expectedPath}`);
  1922→
  1923→  // Find differing sections and create hunks
  1924→  let i = 0;
  1925→  let j = 0;
  1926→
  1927→  while (i < actualLines.length || j < expectedLines.length) {
  1928→    // Find start of difference
  1929→    const contextStart = i;
  1930→    const contextStartExpected = j;
  1931→
  1932→    // Skip matching lines
  1933→    while (
  1934→      i < actualLines.length &&
  1935→      j < expectedLines.length &&
  1936→      actualLines[i] === expectedLines[j]
  1937→    ) {
  1938→      i++;
  1939→      j++;
  1940→    }
  1941→
  1942→    // If we've reached the end, we're done
  1943→    if (i >= actualLines.length && j >= expectedLines.length) {
  1944→      break;
  1945→    }
  1946→
  1947→    // Find end of difference
  1948→    let diffEndActual = i;
  1949→    let diffEndExpected = j;
  1950→
  1951→    // Collect differing lines
  1952→    while (
  1953→      diffEndActual < actualLines.length &&
  1954→      diffEndExpected < expectedLines.length &&
  1955→      actualLines[diffEndActual] !== expectedLines[diffEndExpected]
  1956→    ) {
  1957→      diffEndActual++;
  1958→      diffEndExpected++;
  1959→    }
  1960→
  1961→    // Also handle case where one side has more lines
  1962→    while (diffEndActual < actualLines.length && diffEndExpected >= expectedLines.length) {
  1963→      diffEndActual++;
  1964→    }
  1965→    while (diffEndExpected < expectedLines.length && diffEndActual >= actualLines.length) {
  1966→      diffEndExpected++;
  1967→    }
  1968→
  1969→    // Create hunk header (show 3 lines of context)
  1970→    const hunkStartActual = Math.max(0, contextStart - 3);
  1971→    const hunkStartExpected = Math.max(0, contextStartExpected - 3);
  1972→
  1973→    // Include context after diff too
  1974→    const hunkEndActual = Math.min(actualLines.length, diffEndActual + 3);
  1975→    const hunkEndExpected = Math.min(expectedLines.length, diffEndExpected + 3);
  1976→
  1977→    const actualCount = hunkEndActual - hunkStartActual;
  1978→    const expectedCount = hunkEndExpected - hunkStartExpected;
  1979→
  1980→    diffLines.push(
  1981→      `@@ -${hunkStartActual + 1},${actualCount} +${hunkStartExpected + 1},${expectedCount} @@`
  1982→    );
  1983→
  1984→    // Leading context
  1985→    for (let k = hunkStartActual; k < contextStart; k++) {
  1986→      diffLines.push(` ${actualLines[k]}`);
  1987→    }
  1988→
  1989→    // Removed lines (from actual)
  1990→    for (let k = contextStart; k < diffEndActual; k++) {
  1991→      if (k < actualLines.length) {
  1992→        diffLines.push(`-${actualLines[k]}`);
  1993→      }
  1994→    }
  1995→
  1996→    // Added lines (from expected)
  1997→    for (let k = contextStartExpected; k < diffEndExpected; k++) {
  1998→      if (k < expectedLines.length) {
  1999→        diffLines.push(`+${expectedLines[k]}`);
  2000→      }
  2001→    }
  2002→
  2003→    // Trailing context
  2004→    for (let k = diffEndActual; k < hunkEndActual; k++) {
  2005→      if (k < actualLines.length) {
  2006→        diffLines.push(` ${actualLines[k]}`);
  2007→      }
  2008→    }
  2009→
  2010→    i = hunkEndActual;
  2011→    j = hunkEndExpected;
  2012→  }
  2013→
  2014→  return diffLines;
  2015→}
  2016→
  2017→// Re-export for testing
  2018→export {
  2019→  renderSkill,
  2020→  isKspecManaged,
  2021→  KSPEC_MANAGED_MARKER,
  2022→  getSkillSyncStatus,
  2023→  getExpectedRenderedContent,
  2024→  generateUnifiedDiff,
  2025→  loadCoreSkillsManifest,
  2026→  loadCoreSkillContent,
  2027→  getKspecPackageVersion,
  2028→};
  2029→

