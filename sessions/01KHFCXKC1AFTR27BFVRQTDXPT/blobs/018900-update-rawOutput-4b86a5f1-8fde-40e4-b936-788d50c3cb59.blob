   437→
   438→      it('should include shadow-branch template content', async () => {
   439→        kspecFull('agents generate', tempDir);
   440→
   441→        const filePath = path.join(tempDir, 'kspec-agents.md');
   442→        const content = await fs.readFile(filePath, 'utf-8');
   443→
   444→        // Verify shadow-branch specific content
   445→        expect(content).toContain('git worktree');
   446→        expect(content).toContain('kspec-meta');
   447→        expect(content).toContain('kspec shadow status');
   448→      });
   449→
   450→      it('should include task-lifecycle template content', async () => {
   451→        kspecFull('agents generate', tempDir);
   452→
   453→        const filePath = path.join(tempDir, 'kspec-agents.md');
   454→        const content = await fs.readFile(filePath, 'utf-8');
   455→
   456→        // Verify task-lifecycle specific content
   457→        expect(content).toContain('pending → in_progress → pending_review → completed');
   458→        expect(content).toContain('spec_ref');
   459→      });
   460→
   461→      it('should include pr-workflow template content', async () => {
   462→        kspecFull('agents generate', tempDir);
   463→
   464→        const filePath = path.join(tempDir, 'kspec-agents.md');
   465→        const content = await fs.readFile(filePath, 'utf-8');
   466→
   467→        // Verify pr-workflow specific content
   468→        expect(content).toContain('kspec task submit');
   469→        expect(content).toContain('/local-review');
   470→        expect(content).toContain('/pr');
   471→      });
   472→
   473→      it('should include commit-convention template content', async () => {
   474→        kspecFull('agents generate', tempDir);
   475→
   476→        const filePath = path.join(tempDir, 'kspec-agents.md');
   477→        const content = await fs.readFile(filePath, 'utf-8');
   478→
   479→        // Verify commit-convention specific content
   480→        expect(content).toContain('Task: @task-slug');
   481→        expect(content).toContain('Spec: @spec-ref');
   482→        expect(content).toContain('// AC: @spec-item ac-N');
   483→      });
   484→
   485→      it('should include ralph-loop template content', async () => {
   486→        kspecFull('agents generate', tempDir);
   487→
   488→        const filePath = path.join(tempDir, 'kspec-agents.md');
   489→        const content = await fs.readFile(filePath, 'utf-8');
   490→
   491→        // Verify ralph-loop specific content
