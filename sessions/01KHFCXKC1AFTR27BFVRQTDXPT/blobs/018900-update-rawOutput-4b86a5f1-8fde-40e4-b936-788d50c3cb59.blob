   321→      const hashPath = path.join(tempDir, '.kspec', '.kspec-agents-hash');
   322→      await expect(fs.access(hashPath)).rejects.toThrow();
   323→    });
   324→
   325→    // AC: @trait-dry-run ac-5 is not applicable (no --force option for agents generate)
   326→
   327→    // AC: @trait-dry-run ac-6
   328→    it('should include dry_run boolean field in JSON output (ac-6)', async () => {
   329→      const result = kspecJson<{ dry_run: boolean; content: string }>(
   330→        'agents generate --dry-run',
   331→        tempDir
   332→      );
   333→
   334→      expect(result.dry_run).toBe(true);
   335→      expect(result.content).toBeTruthy();
   336→      expect(result.content).toContain('# kspec Agent Instructions');
   337→    });
   338→  });
   339→
   340→  describe('Workflows section', () => {
