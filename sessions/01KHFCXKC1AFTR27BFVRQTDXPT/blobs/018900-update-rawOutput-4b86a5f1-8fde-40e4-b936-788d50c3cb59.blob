   493→        expect(content).toContain('pending_review');
   494→        expect(content).toContain('kspec task block');
   495→      });
   496→    });
   497→
   498→    // AC: @agent-templates ac-2 (JSON output verification)
   499→    it('should include templates count in JSON output', async () => {
   500→      const result = kspecJson<{
   501→        templates: number;
   502→      }>('agents generate', tempDir);
