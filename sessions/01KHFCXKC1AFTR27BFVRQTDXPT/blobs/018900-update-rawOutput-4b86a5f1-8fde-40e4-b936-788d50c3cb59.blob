   382→  // AC: @agent-templates ac-1 through ac-3
   383→  describe('Agent Template System', () => {
   384→    // AC: @agent-templates ac-1
   385→    describe('ac-1: template sections included in defined order', () => {
   386→      it('should include all template sections in the generated output', async () => {
   387→        const result = kspecFull('agents generate', tempDir);
   388→        expect(result.exitCode).toBe(0);
   389→
   390→        const filePath = path.join(tempDir, 'kspec-agents.md');
   391→        const content = await fs.readFile(filePath, 'utf-8');
   392→
   393→        // Verify template sections are present
   394→        expect(content).toContain('## Quick Start');
   395→        expect(content).toContain('## Shadow Branch Architecture');
   396→        expect(content).toContain('## Task Lifecycle');
   397→        expect(content).toContain('## PR Workflow');
   398→        expect(content).toContain('## Commit Convention');
   399→        expect(content).toContain('## Ralph Loop Mode');
   400→      });
   401→
   402→      it('should include templates in file order (sorted by prefix)', async () => {
   403→        kspecFull('agents generate', tempDir);
   404→
   405→        const filePath = path.join(tempDir, 'kspec-agents.md');
   406→        const content = await fs.readFile(filePath, 'utf-8');
   407→
   408→        // Verify order: Quick Start before Shadow Branch before Task Lifecycle
   409→        const quickStartPos = content.indexOf('## Quick Start');
   410→        const shadowBranchPos = content.indexOf('## Shadow Branch Architecture');
   411→        const taskLifecyclePos = content.indexOf('## Task Lifecycle');
   412→        const prWorkflowPos = content.indexOf('## PR Workflow');
   413→        const commitConventionPos = content.indexOf('## Commit Convention');
   414→        const ralphLoopPos = content.indexOf('## Ralph Loop Mode');
   415→
   416→        expect(quickStartPos).toBeLessThan(shadowBranchPos);
   417→        expect(shadowBranchPos).toBeLessThan(taskLifecyclePos);
   418→        expect(taskLifecyclePos).toBeLessThan(prWorkflowPos);
   419→        expect(prWorkflowPos).toBeLessThan(commitConventionPos);
   420→        expect(commitConventionPos).toBeLessThan(ralphLoopPos);
   421→      });
   422→    });
   423→
   424→    // AC: @agent-templates ac-2
   425→    describe('ac-2: each template section appears in generated output', () => {
   426→      it('should include quick-start template content', async () => {
   427→        kspecFull('agents generate', tempDir);
   428→
   429→        const filePath = path.join(tempDir, 'kspec-agents.md');
   430→        const content = await fs.readFile(filePath, 'utf-8');
   431→
   432→        // Verify quick-start specific content
