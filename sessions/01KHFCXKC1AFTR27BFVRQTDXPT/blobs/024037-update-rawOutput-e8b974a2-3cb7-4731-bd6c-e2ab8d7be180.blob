     1→/**
     2→ * Enhanced setup command for kspec agent integration.
     3→ *
     4→ * Orchestrates the full onboarding pipeline:
     5→ * - Detect agent environment (Claude Code, Cline, etc.)
     6→ * - Install hooks (UserPromptSubmit, Stop, PreToolUse guards)
     7→ * - Render skills from .kspec/skills/ to .claude/skills/
     8→ * - Generate kspec-agents.md
     9→ *
    10→ * AC: @enhanced-setup ac-1 - summary displayed listing each step performed
    11→ * AC: @enhanced-setup ac-2 - all hook entries (UserPromptSubmit, Stop, PreToolUse) present
    12→ * AC: @enhanced-setup ac-3 - rendered skill files exist for each skill targeting claude-code
    13→ * AC: @enhanced-setup ac-4 - kspec-agents.md exists after setup
    14→ * AC: @enhanced-setup ac-5 - --skip-skills flag skips skill rendering
    15→ * AC: @enhanced-setup ac-6 - --dry-run displays planned actions without changes
    16→ * AC: @enhanced-setup ac-7 - --status reports current state including agent detected
    17→ * AC: @enhanced-setup ac-8 - --status shows hooks status, skills rendered count, agents.md freshness
    18→ * AC: @enhanced-setup ac-9 - skills referenced by ralph (task-work, reflect) are present
    19→ */
    20→
    21→import * as crypto from "node:crypto";
    22→import * as fs from "node:fs/promises";
    23→import * as os from "node:os";
    24→import * as path from "node:path";
    25→import * as readline from "node:readline/promises";
    26→import { createRequire } from "node:module";
    27→import { fileURLToPath } from "node:url";
    28→import chalk from "chalk";
    29→import type { Command } from "commander";
    30→import {
    31→  getGitRoot,
    32→  getShadowStatus,
    33→  repairShadow,
    34→  SHADOW_BRANCH_NAME,
    35→} from "../../parser/shadow.js";
    36→import { errors } from "../../strings/index.js";
    37→import { EXIT_CODES } from "../exit-codes.js";
    38→import { error, output, success, warn } from "../output.js";
    39→
    40→const __filename = fileURLToPath(import.meta.url);
    41→const __dirname = path.dirname(__filename);
    42→
    43→// Read version from package.json at runtime
    44→const require = createRequire(import.meta.url);
    45→const { version } = require("../../../package.json");
    46→
    47→/**
    48→ * Supported agent types for auto-configuration
    49→ */
    50→export type AgentType =
    51→  | "claude-code"
    52→  | "cline"
    53→  | "roo-code"
    54→  | "copilot-cli"
    55→  | "gemini-cli"
    56→  | "codex-cli"
    57→  | "aider"
    58→  | "opencode"
    59→  | "amp"
    60→  | "unknown";
    61→
    62→/**
    63→ * Result of agent detection
    64→ */
    65→export interface DetectedAgent {
    66→  type: AgentType;
    67→  confidence: "high" | "medium" | "low";
    68→  configPath?: string;
    69→  envVars?: Record<string, string>;
    70→}
    71→
    72→/**
    73→ * Detect which agent environment we're running in.
    74→ * Returns the detected agent type and confidence level.
    75→ *
    76→ * Detection priority matters - more specific markers checked first.
    77→ */
    78→export function detectAgent(): DetectedAgent {
    79→  // Claude Code: Multiple possible markers
    80→  // CLAUDECODE=1 is set in CLI sessions
    81→  // CLAUDE_CODE_ENTRYPOINT indicates entry point (cli, etc.)
    82→  // CLAUDE_PROJECT_DIR is set in some contexts
    83→  if (
    84→    process.env.CLAUDECODE === "1" ||
    85→    process.env.CLAUDE_CODE_ENTRYPOINT ||
    86→    process.env.CLAUDE_PROJECT_DIR
    87→  ) {
    88→    return {
    89→      type: "claude-code",
    90→      confidence: "high",
    91→      configPath: path.join(os.homedir(), ".claude", "settings.json"),
    92→      envVars: {
    93→        ...(process.env.CLAUDECODE && { CLAUDECODE: process.env.CLAUDECODE }),
    94→        ...(process.env.CLAUDE_CODE_ENTRYPOINT && {
    95→          CLAUDE_CODE_ENTRYPOINT: process.env.CLAUDE_CODE_ENTRYPOINT,
    96→        }),
    97→        ...(process.env.CLAUDE_PROJECT_DIR && {
    98→          CLAUDE_PROJECT_DIR: process.env.CLAUDE_PROJECT_DIR,
    99→        }),
   100→      },
   101→    };
   102→  }
   103→
   104→  // Cline: CLINE_ACTIVE is set when running in Cline terminal
   105→  if (process.env.CLINE_ACTIVE) {
   106→    return {
   107→      type: "cline",
   108→      confidence: "high",
   109→      // Cline uses VS Code settings, but env vars should be in shell profile
   110→      configPath: undefined,
   111→      envVars: { CLINE_ACTIVE: process.env.CLINE_ACTIVE },
   112→    };
   113→  }
   114→
   115→  // GitHub Copilot CLI: Check for copilot-specific markers
   116→  if (process.env.COPILOT_MODEL || process.env.GH_TOKEN) {
   117→    return {
   118→      type: "copilot-cli",
   119→      confidence: "medium",
   120→      configPath: path.join(os.homedir(), ".copilot", "config.json"),
   121→    };
   122→  }
   123→
   124→  // Aider: Check for AIDER_* env vars
   125→  if (process.env.AIDER_MODEL || process.env.AIDER_DARK_MODE !== undefined) {
   126→    return {
   127→      type: "aider",
   128→      confidence: "high",
   129→      configPath: path.join(os.homedir(), ".aider.conf.yml"),
   130→    };
   131→  }
   132→
   133→  // OpenCode: Check for OPENCODE_* env vars
   134→  if (process.env.OPENCODE_CONFIG_DIR || process.env.OPENCODE_CONFIG) {
   135→    return {
   136→      type: "opencode",
   137→      confidence: "high",
   138→      configPath:
   139→        process.env.OPENCODE_CONFIG ||
   140→        path.join(os.homedir(), ".config", "opencode", "opencode.json"),
   141→    };
   142→  }
   143→
   144→  // Gemini CLI: GEMINI_CLI=1 is set when running in Gemini CLI
   145→  if (process.env.GEMINI_CLI === "1") {
   146→    return {
   147→      type: "gemini-cli",
   148→      confidence: "high",
   149→      configPath: path.join(os.homedir(), ".gemini", "settings.json"),
   150→      envVars: { GEMINI_CLI: "1" },
   151→    };
   152→  }
   153→
   154→  // Codex CLI: CODEX_SANDBOX is set when running in sandbox
   155→  if (process.env.CODEX_SANDBOX) {
   156→    return {
   157→      type: "codex-cli",
   158→      confidence: "high",
   159→      configPath: path.join(os.homedir(), ".codex", "config.toml"),
   160→      envVars: { CODEX_SANDBOX: process.env.CODEX_SANDBOX },
   161→    };
   162→  }
   163→
   164→  // Amp (Sourcegraph): Check for AMP_API_KEY or AMP_TOOLBOX
   165→  if (process.env.AMP_API_KEY || process.env.AMP_TOOLBOX) {
   166→    return {
   167→      type: "amp",
   168→      confidence: "medium",
   169→      configPath: path.join(os.homedir(), ".config", "amp", "settings.json"),
   170→    };
   171→  }
   172→
   173→  return {
   174→    type: "unknown",
   175→    confidence: "low",
   176→  };
   177→}
   178→
   179→/**
   180→ * Install KSPEC_AUTHOR config for Claude Code (global settings)
   181→ */
   182→async function installClaudeCodeConfig(author: string): Promise<boolean> {
   183→  const configPath = path.join(os.homedir(), ".claude", "settings.json");
   184→  const configDir = path.dirname(configPath);
   185→
   186→  try {
   187→    // Ensure directory exists
   188→    await fs.mkdir(configDir, { recursive: true });
   189→
   190→    // Read existing config or start fresh
   191→    let config: Record<string, unknown> = {};
   192→    try {
   193→      const existing = await fs.readFile(configPath, "utf-8");
   194→      config = JSON.parse(existing);
   195→    } catch {
   196→      // File doesn't exist or invalid JSON, start fresh
   197→    }
   198→
   199→    // Merge env settings
   200→    const env = (config.env as Record<string, string>) || {};
   201→    env.KSPEC_AUTHOR = author;
   202→    config.env = env;
   203→
   204→    // Write back
   205→    await fs.writeFile(
   206→      configPath,
   207→      `${JSON.stringify(config, null, 2)}\n`,
   208→      "utf-8",
   209→    );
   210→    return true;
   211→  } catch (_err) {
   212→    return false;
   213→  }
   214→}
   215→
   216→/**
   217→ * Result of installing hooks
   218→ * AC: @enhanced-setup ac-2 - tracks all hook types
   219→ */
   220→export interface HooksInstallResult {
   221→  promptCheck: boolean;
   222→  stop: boolean;
   223→  preToolUse: boolean;
   224→  guardsCreated: string[];
   225→}
   226→
   227→/**
   228→ * PreToolUse guard hook scripts
   229→ * These are the shell scripts that will be installed to .claude/hooks/
   230→ */
   231→const GUARD_SCRIPTS: Record<string, string> = {
   232→  "kspec-worktree-guard.sh": `#!/bin/bash
   233→# Guard against dangerous git operations in .kspec worktree
   234→#
   235→# This hook prevents accidentally creating branches or switching
   236→# branches in the .kspec worktree, which should always stay on kspec-meta.
   237→
   238→# Read the tool input from stdin
   239→INPUT=$(cat)
   240→
   241→# Extract the command from the JSON input
   242→COMMAND=$(echo "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)
   243→
   244→# If no command, allow (not a Bash tool call)
   245→if [ -z "$COMMAND" ]; then
   246→  echo '{"decision": "allow"}'
   247→  exit 0
   248→fi
   249→
   250→# Block deleting kspec-meta from anywhere
   251→if [[ "$COMMAND" == *"git branch -d kspec-meta"* || "$COMMAND" == *"git branch -D kspec-meta"* ]]; then
   252→  cat <<EOF
   253→{
   254→  "decision": "block",
   255→  "reason": "[kspec-worktree-guard] BLOCKED: Cannot delete kspec-meta branch. This is the main branch for the .kspec worktree."
   256→}
   257→EOF
   258→  exit 0
   259→fi
   260→
   261→# Get cwd from hook input (not pwd - hook runs in different context)
   262→CWD=$(echo "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)
   263→IN_KSPEC=false
   264→
   265→if [[ "$CWD" == *"/.kspec"* || "$CWD" == *"/.kspec" ]]; then
   266→  IN_KSPEC=true
   267→fi
   268→
   269→# Also check if command contains cd to .kspec
   270→if [[ "$COMMAND" == *"cd "*".kspec"* || "$COMMAND" == *"cd .kspec"* ]]; then
   271→  IN_KSPEC=true
   272→fi
   273→
   274→if [ "$IN_KSPEC" = false ]; then
   275→  echo '{"decision": "allow"}'
   276→  exit 0
   277→fi
   278→
   279→# Dangerous patterns in .kspec (branch creation/modification/history rewriting)
   280→# Note: "git checkout kspec-meta" is safe and allowed
   281→DANGEROUS_PATTERNS=(
   282→  # Branch creation
   283→  "git checkout -b"
   284→  "git checkout -B"
   285→  "git branch -c"
   286→  "git branch -C"
   287→  "git branch -m"
   288→  "git branch -M"
   289→  "git switch -c"
   290→  "git switch -C"
   291→  "git switch --create"
   292→  # History rewriting - these can cause conflicts with active sessions
   293→  "git reset"
   294→  "git rebase"
   295→  "git cherry-pick"
   296→  "git commit --amend"
   297→  # Force push
   298→  "git push --force"
   299→  "git push -f"
   300→  # Discarding changes
   301→  "git stash"
   302→  "git clean"
   303→  "git checkout -- "
   304→  "git restore"
   305→)
   306→
   307→for pattern in "\${DANGEROUS_PATTERNS[@]}"; do
   308→  if [[ "$COMMAND" == *"$pattern"* ]]; then
   309→    cat <<EOF
   310→{
   311→  "decision": "block",
   312→  "reason": "[kspec-worktree-guard] BLOCKED: Dangerous git operation in .kspec worktree. This worktree contains active session data and must stay on kspec-meta. Operations like reset, rebase, stash, and clean can corrupt session files."
   313→}
   314→EOF
   315→    exit 0
   316→  fi
   317→done
   318→
   319→# Allow all other commands
   320→echo '{"decision": "allow"}'
   321→`,
   322→
   323→  "ralph-task-limit-guard.sh": `#!/bin/bash
   324→# Ralph task limit guard - blocks task start when limit reached
   325→#
   326→# This hook provides hard enforcement of the --max-tasks limit.
   327→# Ralph writes a marker file when the limit is reached; this hook
   328→# blocks 'kspec task start' commands when that marker exists.
   329→
   330→# Marker file location (relative to project root)
   331→MARKER_FILE=".claude/ralph-task-limit.json"
   332→
   333→# Read the tool input from stdin
   334→INPUT=$(cat)
   335→
   336→# Extract the command from the JSON input
   337→COMMAND=$(echo "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)
   338→
   339→# If no command, allow (not a Bash tool call)
   340→if [ -z "$COMMAND" ]; then
   341→  echo '{"decision": "allow"}'
   342→  exit 0
   343→fi
   344→
   345→# Only check commands that match "kspec task start"
   346→if [[ ! "$COMMAND" =~ kspec[[:space:]]+task[[:space:]]+start ]]; then
   347→  echo '{"decision": "allow"}'
   348→  exit 0
   349→fi
   350→
   351→# Get cwd from hook input to find marker file
   352→CWD=$(echo "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)
   353→if [ -z "$CWD" ]; then
   354→  CWD="$PWD"
   355→fi
   356→
   357→# Find project root by walking up looking for .claude directory
   358→PROJECT_ROOT="$CWD"
   359→while [ "$PROJECT_ROOT" != "/" ]; do
   360→  if [ -d "$PROJECT_ROOT/.claude" ]; then
   361→    break
   362→  fi
   363→  PROJECT_ROOT=$(dirname "$PROJECT_ROOT")
   364→done
   365→
   366→if [ "$PROJECT_ROOT" = "/" ]; then
   367→  # No .claude directory found, allow
   368→  echo '{"decision": "allow"}'
   369→  exit 0
   370→fi
   371→
   372→MARKER_PATH="$PROJECT_ROOT/$MARKER_FILE"
   373→
   374→# Check if marker file exists
   375→if [ ! -f "$MARKER_PATH" ]; then
   376→  echo '{"decision": "allow"}'
   377→  exit 0
   378→fi
   379→
   380→# Read marker file and check if active
   381→ACTIVE=$(jq -r '.active // false' "$MARKER_PATH" 2>/dev/null)
   382→if [ "$ACTIVE" != "true" ]; then
   383→  echo '{"decision": "allow"}'
   384→  exit 0
   385→fi
   386→
   387→# Extract limit info for error message
   388→MAX=$(jq -r '.max // "?"' "$MARKER_PATH" 2>/dev/null)
   389→COMPLETED=$(jq -r '.completed // "?"' "$MARKER_PATH" 2>/dev/null)
   390→
   391→# Block the command
   392→cat <<EOF
   393→{
   394→  "decision": "block",
   395→  "reason": "[ralph-task-limit-guard] BLOCKED: Task limit reached (\${COMPLETED}/\${MAX} tasks completed this iteration). This limit was set by --max-tasks. Please wrap up current work and let the iteration end naturally. Do not attempt to start new tasks."
   396→}
   397→EOF
   398→exit 0
   399→`,
   400→};
   401→
   402→/**
   403→ * Install hooks to project-level Claude Code settings (.claude/settings.json)
   404→ * AC: @enhanced-setup ac-2 - all hook entries present
   405→ */
   406→async function installClaudeCodeHooks(
   407→  projectDir: string,
   408→  dryRun = false,
   409→): Promise<HooksInstallResult> {
   410→  const configPath = path.join(projectDir, ".claude", "settings.json");
   411→  const configDir = path.dirname(configPath);
   412→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   413→
   414→  const result: HooksInstallResult = {
   415→    promptCheck: false,
   416→    stop: false,
   417→    preToolUse: false,
   418→    guardsCreated: [],
   419→  };
   420→
   421→  try {
   422→    // Ensure directories exist
   423→    if (!dryRun) {
   424→      await fs.mkdir(configDir, { recursive: true });
   425→      await fs.mkdir(hooksDir, { recursive: true });
   426→    }
   427→
   428→    // Read existing config or start fresh
   429→    let config: Record<string, unknown> = {};
   430→    try {
   431→      const existing = await fs.readFile(configPath, "utf-8");
   432→      config = JSON.parse(existing);
   433→    } catch {
   434→      // File doesn't exist or invalid JSON, start fresh
   435→    }
   436→
   437→    // Get or create hooks object
   438→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   439→
   440→    // Install UserPromptSubmit hook (spec-first reminder)
   441→    const promptCheckCommand = "kspec session prompt-check";
   442→    const existingPromptHooks = hooks.UserPromptSubmit as
   443→      | Array<{ hooks?: Array<{ command?: string }> }>
   444→      | undefined;
   445→    const promptAlreadyInstalled = existingPromptHooks?.some((entry) =>
   446→      entry.hooks?.some((hook) =>
   447→        hook.command?.includes("session prompt-check"),
   448→      ),
   449→    );
   450→
   451→    if (!promptAlreadyInstalled) {
   452→      hooks.UserPromptSubmit = [
   453→        ...(existingPromptHooks || []),
   454→        {
   455→          hooks: [
   456→            {
   457→              type: "command",
   458→              command: promptCheckCommand,
   459→            },
   460→          ],
   461→        },
   462→      ];
   463→      result.promptCheck = true;
   464→    } else {
   465→      result.promptCheck = true; // Already configured
   466→    }
   467→
   468→    // Install Stop hook (checkpoint)
   469→    const stopHookCommand = "kspec session checkpoint --json";
   470→    const existingStopHooks = hooks.Stop as
   471→      | Array<{ matcher?: string; hooks?: Array<{ command?: string }> }>
   472→      | undefined;
   473→    const stopAlreadyInstalled = existingStopHooks?.some((entry) =>
   474→      entry.hooks?.some((hook) => hook.command?.includes("session checkpoint")),
   475→    );
   476→
   477→    if (!stopAlreadyInstalled) {
   478→      hooks.Stop = [
   479→        ...(existingStopHooks || []),
   480→        {
   481→          matcher: "",
   482→          hooks: [
   483→            {
   484→              type: "command",
   485→              command: stopHookCommand,
   486→            },
   487→          ],
   488→        },
   489→      ];
   490→      result.stop = true;
   491→    } else {
   492→      result.stop = true; // Already configured
   493→    }
   494→
   495→    // AC: @enhanced-setup ac-2 - Install PreToolUse hooks with guards
   496→    const existingPreToolUseHooks = hooks.PreToolUse as
   497→      | Array<{ matcher?: string; hooks?: Array<{ command?: string }> }>
   498→      | undefined;
   499→
   500→    // Check if our guards are already installed
   501→    const guardHookCommands = Object.keys(GUARD_SCRIPTS).map(
   502→      (name) => `.claude/hooks/${name}`,
   503→    );
   504→    const guardsAlreadyInstalled = existingPreToolUseHooks?.some((entry) =>
   505→      entry.hooks?.some((hook) =>
   506→        guardHookCommands.some((cmd) => hook.command?.includes(cmd)),
   507→      ),
   508→    );
   509→
   510→    if (!guardsAlreadyInstalled) {
   511→      // Create guard script files
   512→      for (const [name, content] of Object.entries(GUARD_SCRIPTS)) {
   513→        const scriptPath = path.join(hooksDir, name);
   514→        if (!dryRun) {
   515→          await fs.writeFile(scriptPath, content, { mode: 0o755 });
   516→        }
   517→        result.guardsCreated.push(name);
   518→      }
   519→
   520→      // Add PreToolUse hook entry
   521→      hooks.PreToolUse = [
   522→        ...(existingPreToolUseHooks || []),
   523→        {
   524→          matcher: "Bash",
   525→          hooks: Object.keys(GUARD_SCRIPTS).map((name) => ({
   526→            type: "command",
   527→            command: `.claude/hooks/${name}`,
   528→          })),
   529→        },
   530→      ];
   531→      result.preToolUse = true;
   532→    } else {
   533→      result.preToolUse = true; // Already configured
   534→    }
   535→
   536→    config.hooks = hooks;
   537→
   538→    // Write back
   539→    if (!dryRun) {
   540→      await fs.writeFile(
   541→        configPath,
   542→        `${JSON.stringify(config, null, 2)}\n`,
   543→        "utf-8",
   544→      );
   545→    }
   546→    return result;
   547→  } catch {
   548→    return result;
   549→  }
   550→}
   551→
   552→/**
   553→ * Install stop hook to project-level Claude Code settings (.claude/settings.json)
   554→ * @deprecated Use installClaudeCodeHooks instead
   555→ */
   556→async function _installClaudeCodeStopHook(
   557→  projectDir: string,
   558→): Promise<boolean> {
   559→  const configPath = path.join(projectDir, ".claude", "settings.json");
   560→  const configDir = path.dirname(configPath);
   561→
   562→  try {
   563→    // Ensure directory exists
   564→    await fs.mkdir(configDir, { recursive: true });
   565→
   566→    // Read existing config or start fresh
   567→    let config: Record<string, unknown> = {};
   568→    try {
   569→      const existing = await fs.readFile(configPath, "utf-8");
   570→      config = JSON.parse(existing);
   571→    } catch {
   572→      // File doesn't exist or invalid JSON, start fresh
   573→    }
   574→
   575→    // Build the stop hook command
   576→    const stopHookCommand = "npx kspec session checkpoint --json";
   577→
   578→    // Get or create hooks object
   579→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   580→
   581→    // Check if Stop hook already exists with our command
   582→    const existingStopHooks = hooks.Stop as
   583→      | Array<{ matcher?: object; hooks?: Array<{ command?: string }> }>
   584→      | undefined;
   585→    const alreadyInstalled = existingStopHooks?.some((entry) =>
   586→      entry.hooks?.some((hook) => hook.command?.includes("session checkpoint")),
   587→    );
   588→
   589→    if (alreadyInstalled) {
   590→      return true; // Already configured
   591→    }
   592→
   593→    // Add our stop hook using Claude Code hooks format
   594→    // Note: matcher field is required even if empty string
   595→    hooks.Stop = [
   596→      ...(existingStopHooks || []),
   597→      {
   598→        matcher: "",
   599→        hooks: [
   600→          {
   601→            type: "command",
   602→            command: stopHookCommand,
   603→          },
   604→        ],
   605→      },
   606→    ];
   607→    config.hooks = hooks;
   608→
   609→    // Write back
   610→    await fs.writeFile(
   611→      configPath,
   612→      `${JSON.stringify(config, null, 2)}\n`,
   613→      "utf-8",
   614→    );
   615→    return true;
   616→  } catch {
   617→    return false;
   618→  }
   619→}
   620→
   621→/**
   622→ * Install KSPEC_AUTHOR config for Aider (.aider.conf.yml)
   623→ * Aider uses `set-env:` for environment variables in list format
   624→ */
   625→async function installAiderConfig(author: string): Promise<boolean> {
   626→  const configPath = path.join(os.homedir(), ".aider.conf.yml");
   627→
   628→  try {
   629→    let content = "";
   630→    try {
   631→      content = await fs.readFile(configPath, "utf-8");
   632→    } catch {
   633→      // File doesn't exist, start fresh
   634→    }
   635→
   636→    // Check if KSPEC_AUTHOR is already set
   637→    if (content.includes("KSPEC_AUTHOR")) {
   638→      // Replace existing value (handles both old and new format)
   639→      content = content.replace(
   640→        /^(\s*-?\s*KSPEC_AUTHOR\s*[=:]\s*).*$/m,
   641→        `  - KSPEC_AUTHOR=${author}`,
   642→      );
   643→    } else {
   644→      // Add to set-env section or create it
   645→      if (content.includes("set-env:")) {
   646→        // Append to existing set-env section
   647→        content = content.replace(
   648→          /(set-env:\s*\n)/m,
   649→          `$1  - KSPEC_AUTHOR=${author}\n`,
   650→        );
   651→      } else {
   652→        // Add new set-env section
   653→        content += `\n# kspec author for note attribution\nset-env:\n  - KSPEC_AUTHOR=${author}\n`;
   654→      }
   655→    }
   656→
   657→    await fs.writeFile(configPath, content, "utf-8");
   658→    return true;
   659→  } catch {
   660→    return false;
   661→  }
   662→}
   663→
   664→/**
   665→ * Install KSPEC_AUTHOR for generic JSON config files
   666→ */
   667→async function installGenericJsonConfig(
   668→  configPath: string,
   669→  author: string,
   670→): Promise<boolean> {
   671→  try {
   672→    const configDir = path.dirname(configPath);
   673→    await fs.mkdir(configDir, { recursive: true });
   674→
   675→    let config: Record<string, unknown> = {};
   676→    try {
   677→      const existing = await fs.readFile(configPath, "utf-8");
   678→      config = JSON.parse(existing);
   679→    } catch {
   680→      // Start fresh
   681→    }
   682→
   683→    const env = (config.env as Record<string, string>) || {};
   684→    env.KSPEC_AUTHOR = author;
   685→    config.env = env;
   686→
   687→    await fs.writeFile(
   688→      configPath,
   689→      `${JSON.stringify(config, null, 2)}\n`,
   690→      "utf-8",
   691→    );
   692→    return true;
   693→  } catch {
   694→    return false;
   695→  }
   696→}
   697→
   698→/**
   699→ * Get default author value for an agent type
   700→ */
   701→function getDefaultAuthor(agentType: AgentType): string {
   702→  switch (agentType) {
   703→    case "claude-code":
   704→      return "@claude";
   705→    case "cline":
   706→      return "@cline";
   707→    case "roo-code":
   708→      return "@roo";
   709→    case "copilot-cli":
   710→      return "@copilot";
   711→    case "gemini-cli":
   712→      return "@gemini";
   713→    case "codex-cli":
   714→      return "@codex";
   715→    case "aider":
   716→      return "@aider";
   717→    case "opencode":
   718→      return "@opencode";
   719→    case "amp":
   720→      return "@amp";
   721→    default:
   722→      return "@agent";
   723→  }
   724→}
   725→
   726→/**
   727→ * Prompt user for input with Y/N answer
   728→ */
   729→async function promptYesNo(question: string): Promise<boolean> {
   730→  const rl = readline.createInterface({
   731→    input: process.stdin,
   732→    output: process.stdout,
   733→  });
   734→
   735→  try {
   736→    const answer = await rl.question(`${question} `);
   737→    return answer.toLowerCase() === "y";
   738→  } finally {
   739→    rl.close();
   740→  }
   741→}
   742→
   743→/**
   744→ * Ensure .kspec worktree exists if kspec-meta branch is present.
   745→ * AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
   746→ *
   747→ * @param autoWorktree If true, automatically create worktree without prompting
   748→ * @returns true if worktree is ready to use
   749→ */
   750→async function ensureWorktree(autoWorktree: boolean): Promise<boolean> {
   751→  const projectRoot = getGitRoot(process.cwd());
   752→  if (!projectRoot) {
   753→    // Not in a git repo, skip worktree check
   754→    return true;
   755→  }
   756→
   757→  const status = await getShadowStatus(projectRoot);
   758→
   759→  // AC: worktree-already-exists - if already valid, skip
   760→  if (status.healthy) {
   761→    return true;
   762→  }
   763→
   764→  // AC: detect-existing-repo - branch exists but worktree doesn't
   765→  if (status.branchExists && !status.worktreeExists) {
   766→    // AC: auto-worktree-flag - auto-create if flag set
   767→    if (autoWorktree) {
   768→      console.log(
   769→        `Detected ${SHADOW_BRANCH_NAME} branch without .kspec worktree. Creating...`,
   770→      );
   771→      const result = await repairShadow(projectRoot);
   772→      if (result.success) {
   773→        success("Created .kspec worktree");
   774→        return true;
   775→      } else {
   776→        error(`Failed to create worktree: ${result.error}`);
   777→        return false;
   778→      }
   779→    }
   780→
   781→    // AC: detect-existing-repo - prompt user
   782→    const shouldCreate = await promptYesNo(
   783→      `${SHADOW_BRANCH_NAME} branch exists but .kspec worktree is missing. Create it? (y/N)`,
   784→    );
   785→
   786→    if (shouldCreate) {
   787→      console.log("Creating .kspec worktree...");
   788→      const result = await repairShadow(projectRoot);
   789→      if (result.success) {
   790→        success("Created .kspec worktree");
   791→        return true;
   792→      } else {
   793→        error(`Failed to create worktree: ${result.error}`);
   794→        return false;
   795→      }
   796→    } else {
   797→      warn("Skipping worktree creation");
   798→      return false;
   799→    }
   800→  }
   801→
   802→  // No kspec-meta branch, or already healthy
   803→  return true;
   804→}
   805→
