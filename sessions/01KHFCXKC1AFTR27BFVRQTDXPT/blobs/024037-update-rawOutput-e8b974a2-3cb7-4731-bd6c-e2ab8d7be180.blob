   809→function printManualInstructions(agentType: AgentType): void {
   810→  const author = getDefaultAuthor(agentType);
   811→
   812→  console.log("\nManual setup instructions:\n");
   813→
   814→  switch (agentType) {
   815→    case "claude-code":
   816→      console.log("Add to ~/.claude/settings.json:");
   817→      console.log("```json");
   818→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   819→      console.log("```");
   820→      break;
   821→
   822→    case "cline":
   823→    case "roo-code":
   824→      console.log("Add to your shell profile (~/.bashrc, ~/.zshrc):");
   825→      console.log("```bash");
   826→      console.log(`export KSPEC_AUTHOR="${author}"`);
   827→      console.log("```");
   828→      console.log(
   829→        "\nThis will be inherited by terminals spawned by the VS Code extension.",
   830→      );
   831→      break;
   832→
   833→    case "copilot-cli":
   834→      console.log("Add to ~/.copilot/config.json:");
   835→      console.log("```json");
   836→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   837→      console.log("```");
   838→      break;
   839→
   840→    case "aider":
   841→      console.log("Add to ~/.aider.conf.yml:");
   842→      console.log("```yaml");
   843→      console.log("set-env:");
   844→      console.log(`  - KSPEC_AUTHOR=${author}`);
   845→      console.log("```");
   846→      break;
   847→
   848→    case "codex-cli":
   849→      console.log("Add to ~/.codex/config.toml:");
   850→      console.log("```toml");
   851→      console.log("[shell_environment_policy]");
   852→      console.log(`set = { KSPEC_AUTHOR = "${author}" }`);
   853→      console.log("```");
   854→      break;
   855→
   856→    case "opencode":
   857→      console.log("Add to ~/.config/opencode/opencode.json:");
   858→      console.log("```json");
   859→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   860→      console.log("```");
   861→      break;
   862→
   863→    case "amp":
   864→      console.log("Add to ~/.config/amp/settings.json:");
   865→      console.log("```json");
   866→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   867→      console.log("```");
   868→      break;
   869→
   870→    default:
   871→      console.log("Set the KSPEC_AUTHOR environment variable:");
   872→      console.log("```bash");
   873→      console.log(`export KSPEC_AUTHOR="${author}"`);
   874→      console.log("```");
   875→      console.log("\nOr add to your shell profile (~/.bashrc, ~/.zshrc, etc.)");
   876→  }
   877→}
   878→
   879→/**
   880→ * Result of a setup step
   881→ */
   882→interface SetupStepResult {
   883→  name: string;
   884→  status: "done" | "skipped" | "failed";
   885→  message?: string;
   886→  details?: Record<string, unknown>;
   887→}
   888→
   889→/**
   890→ * Status of the setup state
   891→ * AC: @enhanced-setup ac-7, ac-8 - status reporting
   892→ */
   893→interface SetupStatus {
   894→  agent: {
   895→    detected: AgentType;
   896→    confidence: "high" | "medium" | "low";
   897→  };
   898→  hooks: {
   899→    promptCheck: boolean;
   900→    stop: boolean;
   901→    preToolUse: boolean;
   902→    guardsPresent: string[];
   903→  };
   904→  skills: {
   905→    total: number;
   906→    rendered: number;
   907→    drifted: number;
   908→  };
   909→  agentsMd: {
   910→    exists: boolean;
   911→    status: "current" | "stale" | "missing";
   912→    generatedAt?: string;
   913→  };
   914→}
   915→
   916→/**
   917→ * Check the current setup status
   918→ * AC: @enhanced-setup ac-7, ac-8
   919→ */
   920→async function getSetupStatus(projectDir: string): Promise<SetupStatus> {
   921→  const detected = detectAgent();
   922→  const configPath = path.join(projectDir, ".claude", "settings.json");
   923→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   924→  const agentsMdPath = path.join(projectDir, "kspec-agents.md");
   925→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
   926→  const skillsDir = path.join(projectDir, ".claude", "skills");
   927→
   928→  // Check hooks
   929→  const hooks = {
   930→    promptCheck: false,
   931→    stop: false,
   932→    preToolUse: false,
   933→    guardsPresent: [] as string[],
   934→  };
   935→
   936→  try {
   937→    const configContent = await fs.readFile(configPath, "utf-8");
   938→    const config = JSON.parse(configContent);
   939→    const hooksConfig = config.hooks || {};
   940→
   941→    // Check UserPromptSubmit
   942→    const promptHooks = hooksConfig.UserPromptSubmit as Array<{
   943→      hooks?: Array<{ command?: string }>;
   944→    }> | undefined;
   945→    hooks.promptCheck = promptHooks?.some((entry) =>
   946→      entry.hooks?.some((h) => h.command?.includes("prompt-check")),
   947→    ) ?? false;
   948→
   949→    // Check Stop
   950→    const stopHooks = hooksConfig.Stop as Array<{
   951→      hooks?: Array<{ command?: string }>;
   952→    }> | undefined;
   953→    hooks.stop = stopHooks?.some((entry) =>
   954→      entry.hooks?.some((h) => h.command?.includes("checkpoint")),
   955→    ) ?? false;
   956→
   957→    // Check PreToolUse
   958→    const preToolUseHooks = hooksConfig.PreToolUse as Array<{
   959→      hooks?: Array<{ command?: string }>;
   960→    }> | undefined;
   961→    hooks.preToolUse = preToolUseHooks?.some((entry) =>
   962→      entry.hooks?.some((h) => h.command?.includes(".claude/hooks/")),
   963→    ) ?? false;
   964→  } catch {
   965→    // Config doesn't exist or is invalid
   966→  }
   967→
   968→  // Check guard scripts
   969→  try {
   970→    const guardFiles = await fs.readdir(hooksDir);
   971→    for (const name of Object.keys(GUARD_SCRIPTS)) {
   972→      if (guardFiles.includes(name)) {
   973→        hooks.guardsPresent.push(name);
   974→      }
   975→    }
   976→  } catch {
   977→    // Hooks dir doesn't exist
   978→  }
   979→
   980→  // Check skills
   981→  const skills = {
   982→    total: 0,
   983→    rendered: 0,
   984→    drifted: 0,
   985→  };
   986→
   987→  try {
   988→    const skillDirs = await fs.readdir(skillsDir, { withFileTypes: true });
   989→    for (const dir of skillDirs) {
   990→      if (dir.isDirectory()) {
   991→        const skillMdPath = path.join(skillsDir, dir.name, "SKILL.md");
   992→        try {
   993→          const content = await fs.readFile(skillMdPath, "utf-8");
   994→          if (content.includes("<!-- kspec-managed -->")) {
   995→            skills.total++;
   996→            skills.rendered++;
   997→            // TODO: check drift status
   998→          }
   999→        } catch {
  1000→          // SKILL.md doesn't exist
  1001→        }
  1002→      }
  1003→    }
  1004→  } catch {
  1005→    // Skills dir doesn't exist
  1006→  }
  1007→
  1008→  // Check agents.md
  1009→  const agentsMd: SetupStatus["agentsMd"] = {
  1010→    exists: false,
  1011→    status: "missing",
  1012→  };
  1013→
  1014→  try {
  1015→    await fs.access(agentsMdPath);
  1016→    agentsMd.exists = true;
  1017→
  1018→    try {
  1019→      const hashContent = await fs.readFile(hashPath, "utf-8");
  1020→      const hashData = JSON.parse(hashContent);
  1021→      agentsMd.status = "current"; // We can't verify staleness without meta context
  1022→      agentsMd.generatedAt = hashData.generatedAt;
  1023→    } catch {
  1024→      agentsMd.status = "stale";
  1025→    }
  1026→  } catch {
  1027→    // File doesn't exist
  1028→  }
  1029→
  1030→  return {
  1031→    agent: {
  1032→      detected: detected.type,
  1033→      confidence: detected.confidence,
  1034→    },
  1035→    hooks,
  1036→    skills,
  1037→    agentsMd,
  1038→  };
  1039→}
  1040→
  1041→/**
  1042→ * Render skills using the skill rendering library
  1043→ * AC: @enhanced-setup ac-3
  1044→ */
  1045→async function renderSkillsForSetup(
  1046→  projectDir: string,
  1047→  dryRun: boolean,
  1048→): Promise<{ rendered: number; skipped: number; skillIds: string[] }> {
  1049→  // Dynamically import to avoid circular dependencies
  1050→  const { initContext, loadMetaContext, loadSkillContent } = await import(
  1051→    "../../parser/index.js"
  1052→  );
  1053→  const { renderClaudeCodeSkill } = await import("../../parser/skill-render.js");
  1054→
  1055→  try {
  1056→    const ctx = await initContext();
  1057→
  1058→    if (!ctx.manifestPath) {
  1059→      return { rendered: 0, skipped: 0, skillIds: [] };
  1060→    }
  1061→
  1062→    const metaCtx = await loadMetaContext(ctx);
  1063→    const skillsToRender = metaCtx.skills.filter((s) =>
  1064→      s.platforms.includes("claude-code"),
  1065→    );
  1066→
  1067→    if (skillsToRender.length === 0) {
  1068→      return { rendered: 0, skipped: 0, skillIds: [] };
  1069→    }
  1070→
  1071→    let rendered = 0;
  1072→    let skipped = 0;
  1073→    const skillIds: string[] = [];
  1074→
  1075→    for (const skill of skillsToRender) {
  1076→      const result = await renderClaudeCodeSkill(ctx, projectDir, skill, {
  1077→        dryRun,
  1078→      });
  1079→      if (result.action === "created" || result.action === "updated") {
  1080→        rendered++;
  1081→        skillIds.push(skill.id);
  1082→      } else {
  1083→        skipped++;
  1084→      }
  1085→    }
  1086→
  1087→    return { rendered, skipped, skillIds };
  1088→  } catch {
  1089→    return { rendered: 0, skipped: 0, skillIds: [] };
  1090→  }
  1091→}
  1092→
  1093→/**
  1094→ * Generate kspec-agents.md
  1095→ * AC: @enhanced-setup ac-4
  1096→ */
  1097→async function generateAgentInstructions(
  1098→  projectDir: string,
  1099→  dryRun: boolean,
  1100→): Promise<{ success: boolean; path: string }> {
  1101→  const outputPath = path.join(projectDir, "kspec-agents.md");
  1102→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
  1103→
  1104→  // Dynamically import to avoid circular dependencies
  1105→  const {
  1106→    initContext,
  1107→    loadMetaContext,
  1108→    generateSkillsTable,
  1109→    generateConventionsSummary,
  1110→    generateWorkflowsSummary,
  1111→  } = await import("../../parser/index.js");
  1112→
  1113→  try {
  1114→    const ctx = await initContext();
  1115→
  1116→    if (!ctx.manifestPath) {
  1117→      return { success: false, path: outputPath };
  1118→    }
  1119→
  1120→    const metaCtx = await loadMetaContext(ctx);
  1121→    const timestamp = new Date().toISOString();
  1122→
  1123→    // Load template sections
  1124→    const packageRoot = path.resolve(__dirname, "..", "..", "..");
  1125→    const templatesPath = path.join(packageRoot, "templates", "agents-sections");
  1126→    const templateSections: string[] = [];
  1127→
  1128→    try {
  1129→      const entries = await fs.readdir(templatesPath, { withFileTypes: true });
  1130→      const mdFiles = entries
  1131→        .filter((e) => e.isFile() && e.name.endsWith(".md"))
  1132→        .map((e) => e.name)
  1133→        .sort();
  1134→
  1135→      for (const filename of mdFiles) {
  1136→        const filePath = path.join(templatesPath, filename);
  1137→        const content = await fs.readFile(filePath, "utf-8");
  1138→        templateSections.push(content.trim());
  1139→      }
  1140→    } catch {
  1141→      // Templates not available
  1142→    }
  1143→
  1144→    // Generate content
  1145→    const sections: string[] = [];
  1146→    sections.push(
  1147→      `<!-- Generated by kspec v${version} at ${timestamp} -->\n`,
  1148→    );
  1149→    sections.push(
  1150→      "<!-- Do not edit manually - regenerate with: kspec agents generate -->\n\n",
  1151→    );
  1152→    sections.push("# kspec Agent Instructions\n\n");
  1153→    sections.push(
  1154→      "This file is auto-generated from kspec meta. Include it in your AGENTS.md or similar agent instruction file.\n\n",
  1155→    );
  1156→
  1157→    const skillsTable = generateSkillsTable(metaCtx.skills);
  1158→    if (skillsTable) sections.push(skillsTable);
  1159→
  1160→    const conventionsSection = generateConventionsSummary(metaCtx.conventions);
  1161→    if (conventionsSection) sections.push(conventionsSection);
  1162→
  1163→    const workflowsSection = generateWorkflowsSummary(metaCtx.workflows);
  1164→    if (workflowsSection) sections.push(workflowsSection);
  1165→
  1166→    if (templateSections.length > 0) {
  1167→      sections.push("\n");
  1168→      for (const section of templateSections) {
  1169→        sections.push(section);
  1170→        sections.push("\n\n");
  1171→      }
  1172→    }
  1173→
  1174→    const content = sections.join("");
  1175→
  1176→    if (!dryRun) {
  1177→      await fs.writeFile(outputPath, content, "utf-8");
  1178→
  1179→      // Write hash for freshness tracking
  1180→      const metaHash = crypto
  1181→        .createHash("sha256")
  1182→        .update(
  1183→          JSON.stringify({
  1184→            skills: metaCtx.skills.map((s) => ({
  1185→              id: s.id,
  1186→              name: s.name,
  1187→              description: s.description,
  1188→            })),
  1189→            conventions: metaCtx.conventions.map((c) => ({
  1190→              domain: c.domain,
  1191→              rules: c.rules,
  1192→            })),
  1193→            workflows: metaCtx.workflows.map((w) => ({
  1194→              id: w.id,
  1195→              trigger: w.trigger,
  1196→              description: w.description,
  1197→            })),
  1198→          }),
  1199→        )
  1200→        .digest("hex");
  1201→
  1202→      await fs.mkdir(path.dirname(hashPath), { recursive: true });
  1203→      await fs.writeFile(
  1204→        hashPath,
  1205→        JSON.stringify(
  1206→          {
  1207→            metaHash,
  1208→            generatedAt: timestamp,
  1209→            version,
  1210→          },
  1211→          null,
  1212→          2,
  1213→        ),
  1214→        "utf-8",
  1215→      );
  1216→    }
  1217→
  1218→    return { success: true, path: outputPath };
  1219→  } catch {
  1220→    return { success: false, path: outputPath };
  1221→  }
  1222→}
  1223→
  1224→/**
  1225→ * Register the 'setup' command
  1226→ * AC: @enhanced-setup ac-1 through ac-9
  1227→ */
  1228→export function registerSetupCommand(program: Command): void {
  1229→  program
  1230→    .command("setup")
  1231→    .description("Configure agent environment for kspec (orchestrated pipeline)")
  1232→    .option("--dry-run", "Show what would be done without making changes")
  1233→    .option(
  1234→      "--author <author>",
  1235→      "Custom author string (default: auto-detected based on agent)",
  1236→    )
  1237→    .option("--no-hooks", "Skip installing hooks")
  1238→    .option("--skip-skills", "Skip rendering skills")
  1239→    .option("--status", "Report current setup state without making changes")
  1240→    .option("--force", "Overwrite existing configuration")
  1241→    .option(
  1242→      "--auto-worktree",
  1243→      "Automatically create .kspec worktree if kspec-meta branch exists",
  1244→    )
  1245→    .action(async (options) => {
  1246→      try {
  1247→        const projectDir = process.cwd();
  1248→
  1249→        // AC: @enhanced-setup ac-7, ac-8 - --status mode
  1250→        if (options.status) {
  1251→          const status = await getSetupStatus(projectDir);
  1252→
  1253→          output(status, () => {
  1254→            console.log(chalk.bold("kspec Setup Status\n"));
  1255→
  1256→            // Agent detection
  1257→            console.log(chalk.gray("Agent:"));
  1258→            console.log(
  1259→              `  Detected: ${status.agent.detected} (${status.agent.confidence} confidence)`,
  1260→            );
  1261→            console.log();
  1262→
  1263→            // Hooks status
  1264→            console.log(chalk.gray("Hooks:"));
  1265→            console.log(
  1266→              `  UserPromptSubmit: ${status.hooks.promptCheck ? chalk.green("✓") : chalk.red("✗")}`,
  1267→            );
  1268→            console.log(
  1269→              `  Stop:             ${status.hooks.stop ? chalk.green("✓") : chalk.red("✗")}`,
  1270→            );
  1271→            console.log(
  1272→              `  PreToolUse:       ${status.hooks.preToolUse ? chalk.green("✓") : chalk.red("✗")}`,
  1273→            );
  1274→            if (status.hooks.guardsPresent.length > 0) {
  1275→              console.log(
  1276→                `  Guards:           ${status.hooks.guardsPresent.join(", ")}`,
  1277→              );
  1278→            }
  1279→            console.log();
  1280→
  1281→            // Skills status
  1282→            console.log(chalk.gray("Skills:"));
  1283→            console.log(`  Rendered: ${status.skills.rendered}`);
  1284→            if (status.skills.drifted > 0) {
  1285→              console.log(
  1286→                `  Drifted:  ${chalk.yellow(status.skills.drifted.toString())}`,
  1287→              );
  1288→            }
  1289→            console.log();
  1290→
  1291→            // Agents.md status
  1292→            console.log(chalk.gray("kspec-agents.md:"));
  1293→            if (status.agentsMd.exists) {
  1294→              const statusColor =
  1295→                status.agentsMd.status === "current"
  1296→                  ? chalk.green
  1297→                  : chalk.yellow;
  1298→              console.log(`  Status: ${statusColor(status.agentsMd.status)}`);
  1299→              if (status.agentsMd.generatedAt) {
  1300→                console.log(`  Generated: ${status.agentsMd.generatedAt}`);
  1301→              }
  1302→            } else {
  1303→              console.log(`  Status: ${chalk.red("missing")}`);
  1304→              console.log(
  1305→                chalk.gray("  Run 'kspec setup' to generate"),
  1306→              );
  1307→            }
  1308→          });
  1309→          return;
  1310→        }
  1311→
  1312→        // AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
  1313→        const worktreeReady = await ensureWorktree(
  1314→          options.autoWorktree || false,
  1315→        );
  1316→        if (!worktreeReady) {
  1317→          // User declined worktree creation or it failed
  1318→          process.exit(EXIT_CODES.ERROR);
  1319→        }
  1320→
  1321→        const detected = detectAgent();
  1322→        const dryRun = options.dryRun || false;
  1323→        const skipSkills = options.skipSkills || false;
  1324→        const installHooksFlag = options.hooks !== false;
  1325→
  1326→        // Track setup steps for summary
  1327→        // AC: @enhanced-setup ac-1 - summary listing each step
  1328→        const steps: SetupStepResult[] = [];
  1329→
  1330→        // Step 1: Agent detection
  1331→        steps.push({
  1332→          name: "Agent detection",
  1333→          status: "done",
  1334→          message: `${detected.type} (${detected.confidence} confidence)`,
  1335→        });
  1336→
  1337→        if (detected.type === "unknown") {
  1338→          warn("Could not auto-detect agent environment");
  1339→          printManualInstructions("unknown");
  1340→          return;
  1341→        }
  1342→
  1343→        // Step 2: Install hooks (Claude Code only)
  1344→        // AC: @enhanced-setup ac-2 - all hook entries present
  1345→        if (detected.type === "claude-code" && installHooksFlag) {
  1346→          const hooksResult = await installClaudeCodeHooks(projectDir, dryRun);
  1347→          const installedHooks: string[] = [];
  1348→          if (hooksResult.promptCheck) installedHooks.push("UserPromptSubmit");
  1349→          if (hooksResult.stop) installedHooks.push("Stop");
  1350→          if (hooksResult.preToolUse) installedHooks.push("PreToolUse");
  1351→
  1352→          steps.push({
  1353→            name: "Install hooks",
  1354→            status: "done",
  1355→            message: installedHooks.join(", "),
  1356→            details: {
  1357→              guards: hooksResult.guardsCreated,
  1358→            },
  1359→          });
  1360→        } else if (!installHooksFlag) {
  1361→          steps.push({
  1362→            name: "Install hooks",
  1363→            status: "skipped",
  1364→            message: "--no-hooks flag",
  1365→          });
  1366→        }
  1367→
  1368→        // Step 3: Render skills
  1369→        // AC: @enhanced-setup ac-3 - rendered skill files exist
  1370→        // AC: @enhanced-setup ac-5 - --skip-skills flag
  1371→        if (!skipSkills) {
  1372→          const skillsResult = await renderSkillsForSetup(projectDir, dryRun);
  1373→          if (skillsResult.rendered > 0 || skillsResult.skipped > 0) {
  1374→            steps.push({
  1375→              name: "Render skills",
  1376→              status: "done",
  1377→              message: `${skillsResult.rendered} rendered, ${skillsResult.skipped} unchanged`,
  1378→              details: {
  1379→                skillIds: skillsResult.skillIds,
  1380→              },
  1381→            });
  1382→          } else {
  1383→            steps.push({
  1384→              name: "Render skills",
  1385→              status: "skipped",
  1386→              message: "No claude-code skills in meta",
  1387→            });
  1388→          }
  1389→        } else {
  1390→          steps.push({
  1391→            name: "Render skills",
  1392→            status: "skipped",
  1393→            message: "--skip-skills flag",
  1394→          });
  1395→        }
  1396→
  1397→        // Step 4: Generate kspec-agents.md
  1398→        // AC: @enhanced-setup ac-4 - kspec-agents.md exists
  1399→        const agentsResult = await generateAgentInstructions(projectDir, dryRun);
  1400→        if (agentsResult.success) {
  1401→          steps.push({
  1402→            name: "Generate kspec-agents.md",
  1403→            status: "done",
  1404→            message: agentsResult.path,
  1405→          });
  1406→        } else {
  1407→          steps.push({
  1408→            name: "Generate kspec-agents.md",
  1409→            status: "failed",
  1410→            message: "No kspec project found",
  1411→          });
  1412→        }
  1413→
  1414→        // Step 5: Install author config
  1415→        const author = options.author || getDefaultAuthor(detected.type);
  1416→        if (!options.force && process.env.KSPEC_AUTHOR) {
  1417→          steps.push({
  1418→            name: "Configure author",
  1419→            status: "skipped",
  1420→            message: `KSPEC_AUTHOR already set to "${process.env.KSPEC_AUTHOR}"`,
  1421→          });
  1422→        } else {
  1423→          let authorInstalled = false;
  1424→          switch (detected.type) {
  1425→            case "claude-code":
  1426→              if (!dryRun) {
  1427→                authorInstalled = await installClaudeCodeConfig(author);
  1428→              } else {
  1429→                authorInstalled = true;
  1430→              }
  1431→              break;
  1432→            case "aider":
  1433→              if (!dryRun) {
  1434→                authorInstalled = await installAiderConfig(author);
  1435→              } else {
  1436→                authorInstalled = true;
  1437→              }
  1438→              break;
  1439→            default:
  1440→              break;
  1441→          }
  1442→
  1443→          if (authorInstalled) {
  1444→            steps.push({
  1445→              name: "Configure author",
  1446→              status: "done",
  1447→              message: `KSPEC_AUTHOR="${author}"`,
  1448→            });
  1449→          }
  1450→        }
  1451→
  1452→        // AC: @enhanced-setup ac-1 - Display summary
  1453→        // AC: @enhanced-setup ac-6 - dry-run displays planned actions
  1454→        output(
  1455→          {
  1456→            dry_run: dryRun,
  1457→            steps: steps.map((s) => ({
  1458→              name: s.name,
  1459→              status: s.status,
  1460→              message: s.message,
  1461→              details: s.details,
  1462→            })),
  1463→          },
  1464→          () => {
  1465→            if (dryRun) {
  1466→              console.log(chalk.yellow("DRY RUN - No changes made\n"));
  1467→            }
  1468→
  1469→            console.log(chalk.bold("kspec Setup Summary\n"));
  1470→
  1471→            for (const step of steps) {
  1472→              const icon =
  1473→                step.status === "done"
  1474→                  ? chalk.green("✓")
  1475→                  : step.status === "skipped"
  1476→                    ? chalk.gray("○")
  1477→                    : chalk.red("✗");
  1478→              const statusText =
  1479→                step.status === "done"
  1480→                  ? ""
  1481→                  : step.status === "skipped"
  1482→                    ? chalk.gray(" (skipped)")
  1483→                    : chalk.red(" (failed)");
  1484→
  1485→              console.log(`${icon} ${step.name}${statusText}`);
  1486→              if (step.message) {
  1487→                console.log(chalk.gray(`  ${step.message}`));
  1488→              }
  1489→            }
  1490→
  1491→            console.log();
  1492→
  1493→            if (dryRun) {
  1494→              console.log(
  1495→                chalk.yellow("Run without --dry-run to apply changes."),
  1496→              );
  1497→            } else {
  1498→              console.log(
  1499→                chalk.green("Setup complete."),
  1500→              );
  1501→              console.log(
  1502→                chalk.gray("Restart your agent session for changes to take effect."),
  1503→              );
  1504→            }
  1505→          },
  1506→        );
  1507→      } catch (err) {
  1508→        error(errors.failures.setupFailed, err);
  1509→        process.exit(EXIT_CODES.ERROR);
  1510→      }
  1511→    });
  1512→}
  1513→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
