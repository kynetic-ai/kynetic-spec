```
     1→/**
     2→ * Validation module for kspec files.
     3→ *
     4→ * Provides schema validation, reference validation, and orphan detection.
     5→ */
     6→
     7→import * as fs from 'node:fs/promises';
     8→import * as path from 'node:path';
     9→import {
    10→  TaskSchema,
    11→  TasksFileSchema,
    12→  ManifestSchema,
    13→  SpecItemSchema,
    14→  MetaManifestSchema,
    15→  AgentSchema,
    16→  WorkflowSchema,
    17→  ConventionSchema,
    18→  ObservationSchema,
    19→  UlidSchema,
    20→} from '../schema/index.js';
    21→import type { KspecContext, LoadedTask, LoadedSpecItem } from './yaml.js';
    22→import {
    23→  readYamlFile,
    24→  findTaskFiles,
    25→  loadSpecFile,
    26→  expandIncludePattern,
    27→} from './yaml.js';
    28→import { ReferenceIndex, validateRefs, type RefValidationError, type RefValidationWarning } from './refs.js';
    29→import { findMetaManifest, loadMetaContext, type MetaContext } from './meta.js';
    30→
    31→// ============================================================
    32→// TYPES
    33→// ============================================================
    34→
    35→/**
    36→ * Schema validation error
    37→ */
    38→export interface SchemaValidationError {
    39→  file: string;
    40→  path?: string;
    41→  message: string;
    42→  details?: unknown;
    43→}
    44→
    45→/**
    46→ * Orphan item (not referenced by anything)
    47→ */
    48→export interface OrphanItem {
    49→  ulid: string;
    50→  title: string;
    51→  type: string;
    52→  file?: string;
    53→}
    54→
    55→/**
    56→ * Completeness warning types
    57→ */
    58→export type CompletenessWarningType =
    59→  | 'missing_acceptance_criteria'
    60→  | 'missing_description'
    61→  | 'status_inconsistency'
    62→  | 'missing_test_coverage';
    63→
    64→/**
    65→ * Completeness warning
    66→ */
    67→export interface CompletenessWarning {
    68→  type: CompletenessWarningType;
    69→  itemRef: string;
    70→  itemTitle: string;
    71→  message: string;
    72→  details?: string;
    73→}
    74→
    75→/**
    76→ * Complete validation result
    77→ */
    78→export interface ValidationResult {
    79→  valid: boolean;
    80→  schemaErrors: SchemaValidationError[];
    81→  refErrors: RefValidationError[];
    82→  refWarnings: RefValidationWarning[];
    83→  orphans: OrphanItem[];
    84→  completenessWarnings: CompletenessWarning[];
    85→  stats: {
    86→    filesChecked: number;
    87→    itemsChecked: number;
    88→    tasksChecked: number;
    89→  };
    90→  metaStats?: {
    91→    agents: number;
    92→    workflows: number;
    93→    conventions: number;
    94→    observations: number;
    95→  };
    96→}
    97→
    98→/**
    99→ * Validation options
   100→ */
   101→export interface ValidateOptions {
   102→  /** Check schema conformance */
   103→  schema?: boolean;
   104→  /** Check reference resolution */
   105→  refs?: boolean;
   106→  /** Find orphaned items */
   107→  orphans?: boolean;
   108→  /** Check spec completeness (missing AC, descriptions, status inconsistencies) */
   109→  completeness?: boolean;
   110→}
   111→
   112→// ============================================================
   113→// SCHEMA VALIDATION
   114→// ============================================================
   115→
   116→/**
   117→ * Validate a manifest file against schema
   118→ */
   119→async function validateManifestFile(filePath: string): Promise<SchemaValidationError[]> {
   120→  const errors: SchemaValidationError[] = [];
   121→
   122→  try {
   123→    const raw = await readYamlFile<unknown>(filePath);
   124→    const result = ManifestSchema.safeParse(raw);
   125→
   126→    if (!result.success) {
   127→      for (const issue of result.error.issues) {
   128→        errors.push({
   129→          file: filePath,
   130→          path: issue.path.join('.'),
   131→          message: issue.message,
   132→          details: issue,
   133→        });
   134→      }
   135→    }
   136→  } catch (err) {
   137→    errors.push({
   138→      file: filePath,
   139→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   140→    });
   141→  }
   142→
   143→  return errors;
   144→}
   145→
   146→/**
   147→ * Validate a tasks file against schema
   148→ */
   149→async function validateTasksFile(filePath: string): Promise<SchemaValidationError[]> {
   150→  const errors: SchemaValidationError[] = [];
   151→
   152→  try {
   153→    const raw = await readYamlFile<unknown>(filePath);
   154→
   155→    // Handle both formats: { tasks: [...] } and plain array
   156→    let taskList: unknown[];
   157→
   158→    if (Array.isArray(raw)) {
   159→      taskList = raw;
   160→    } else if (raw && typeof raw === 'object' && 'tasks' in raw) {
   161→      // Try full TasksFile schema first
   162→      const fileResult = TasksFileSchema.safeParse(raw);
   163→      if (!fileResult.success) {
   164→        // If TasksFile fails, just validate individual tasks
   165→        taskList = (raw as { tasks: unknown[] }).tasks || [];
   166→      } else {
   167→        // File schema passed, validate individual tasks for detailed errors
   168→        taskList = fileResult.data.tasks;
   169→      }
   170→    } else {
   171→      errors.push({
   172→        file: filePath,
   173→        message: 'Invalid tasks file format: expected array or { tasks: [...] }',
   174→      });
   175→      return errors;
   176→    }
   177→
   178→    // Validate each task
   179→    for (let i = 0; i < taskList.length; i++) {
   180→      const task = taskList[i];
   181→      const result = TaskSchema.safeParse(task);
   182→
   183→      if (!result.success) {
   184→        for (const issue of result.error.issues) {
   185→          errors.push({
   186→            file: filePath,
   187→            path: `tasks[${i}].${issue.path.join('.')}`,
   188→            message: issue.message,
   189→            details: issue,
   190→          });
   191→        }
   192→      }
   193→    }
   194→  } catch (err) {
   195→    errors.push({
   196→      file: filePath,
   197→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   198→    });
   199→  }
   200→
   201→  return errors;
   202→}
   203→
   204→/**
   205→ * Validate a spec module file against schema
   206→ */
   207→async function validateSpecFile(filePath: string): Promise<SchemaValidationError[]> {
   208→  const errors: SchemaValidationError[] = [];
   209→
   210→  try {
   211→    const raw = await readYamlFile<unknown>(filePath);
   212→
   213→    // Recursively validate spec items
   214→    validateSpecItemRecursive(raw, filePath, '', errors);
   215→  } catch (err) {
   216→    errors.push({
   217→      file: filePath,
   218→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   219→    });
   220→  }
   221→
   222→  return errors;
   223→}
   224→
   225→/**
   226→ * Validate meta manifest file with strict ULID validation
   227→ * AC-meta-manifest-3: Invalid schema exits with code 1 and shows field path + expected type
   228→ */
   229→async function validateMetaManifestFile(filePath: string): Promise<SchemaValidationError[]> {
   230→  const errors: SchemaValidationError[] = [];
   231→
   232→  try {
   233→    const raw = await readYamlFile<unknown>(filePath);
   234→
   235→    // Validate overall manifest structure
   236→    const manifestResult = MetaManifestSchema.safeParse(raw);
   237→    if (!manifestResult.success) {
   238→      for (const issue of manifestResult.error.issues) {
   239→        errors.push({
   240→          file: filePath,
   241→          path: issue.path.join('.'),
   242→          message: issue.message,
   243→          details: issue,
   244→        });
   245→      }
   246→      return errors;
   247→    }
   248→
   249→    // Validate each agent with strict ULID validation
   250→    if (raw && typeof raw === 'object' && 'agents' in raw && Array.isArray((raw as Record<string, unknown>).agents)) {
   251→      const agents = (raw as Record<string, unknown>).agents as unknown[];
   252→      for (let i = 0; i < agents.length; i++) {
   253→        const agent = agents[i];
   254→        const agentResult = AgentSchema.safeParse(agent);
   255→        if (!agentResult.success) {
   256→          for (const issue of agentResult.error.issues) {
   257→            errors.push({
   258→              file: filePath,
   259→              path: `agents[${i}].${issue.path.join('.')}`,
   260→              message: issue.message,
   261→              details: issue,
   262→            });
   263→          }
   264→        }
   265→
   266→        // Strict ULID validation
   267→        if (agent && typeof agent === 'object' && '_ulid' in agent) {
   268→          const ulidResult = UlidSchema.safeParse((agent as Record<string, unknown>)._ulid);
   269→          if (!ulidResult.success) {
   270→            errors.push({
   271→              file: filePath,
   272→              path: `agents[${i}]._ulid`,
   273→              message: 'Invalid ULID format (expected 26 characters)',
   274→            });
   275→          }
   276→        }
   277→      }
   278→    }
   279→
   280→    // Validate each workflow with strict ULID validation
   281→    if (raw && typeof raw === 'object' && 'workflows' in raw && Array.isArray((raw as Record<string, unknown>).workflows)) {
   282→      const workflows = (raw as Record<string, unknown>).workflows as unknown[];
   283→      for (let i = 0; i < workflows.length; i++) {
   284→        const workflow = workflows[i];
   285→        const workflowResult = WorkflowSchema.safeParse(workflow);
   286→        if (!workflowResult.success) {
   287→          for (const issue of workflowResult.error.issues) {
   288→            errors.push({
   289→              file: filePath,
   290→              path: `workflows[${i}].${issue.path.join('.')}`,
   291→              message: issue.message,
   292→              details: issue,
   293→            });
   294→          }
   295→        }
   296→
   297→        // Strict ULID validation
   298→        if (workflow && typeof workflow === 'object' && '_ulid' in workflow) {
   299→          const ulidResult = UlidSchema.safeParse((workflow as Record<string, unknown>)._ulid);
   300→          if (!ulidResult.success) {
   301→            errors.push({
   302→              file: filePath,
   303→              path: `workflows[${i}]._ulid`,
   304→              message: 'Invalid ULID format (expected 26 characters)',
   305→            });
   306→          }
   307→        }
   308→      }
   309→    }
   310→
   311→    // Validate each convention with strict ULID validation
   312→    if (raw && typeof raw === 'object' && 'conventions' in raw && Array.isArray((raw as Record<string, unknown>).conventions)) {
   313→      const conventions = (raw as Record<string, unknown>).conventions as unknown[];
   314→      for (let i = 0; i < conventions.length; i++) {
   315→        const convention = conventions[i];
   316→        const conventionResult = ConventionSchema.safeParse(convention);
   317→        if (!conventionResult.success) {
   318→          for (const issue of conventionResult.error.issues) {
   319→            errors.push({
   320→              file: filePath,
   321→              path: `conventions[${i}].${issue.path.join('.')}`,
   322→              message: issue.message,
   323→              details: issue,
   324→            });
   325→          }
   326→        }
   327→
   328→        // Strict ULID validation
   329→        if (convention && typeof convention === 'object' && '_ulid' in convention) {
   330→          const ulidResult = UlidSchema.safeParse((convention as Record<string, unknown>)._ulid);
   331→          if (!ulidResult.success) {
   332→            errors.push({
   333→              file: filePath,
   334→              path: `conventions[${i}]._ulid`,
   335→              message: 'Invalid ULID format (expected 26 characters)',
   336→            });
   337→          }
   338→        }
   339→      }
   340→    }
   341→
   342→    // Validate each observation with strict ULID validation
   343→    if (raw && typeof raw === 'object' && 'observations' in raw && Array.isArray((raw as Record<string, unknown>).observations)) {
   344→      const observations = (raw as Record<string, unknown>).observations as unknown[];
   345→      for (let i = 0; i < observations.length; i++) {
   346→        const observation = observations[i];
   347→        const observationResult = ObservationSchema.safeParse(observation);
   348→        if (!observationResult.success) {
   349→          for (const issue of observationResult.error.issues) {
   350→            errors.push({
   351→              file: filePath,
   352→              path: `observations[${i}].${issue.path.join('.')}`,
   353→              message: issue.message,
   354→              details: issue,
   355→            });
   356→          }
   357→        }
   358→
   359→        // Strict ULID validation
   360→        if (observation && typeof observation === 'object' && '_ulid' in observation) {
   361→          const ulidResult = UlidSchema.safeParse((observation as Record<string, unknown>)._ulid);
   362→          if (!ulidResult.success) {
   363→            errors.push({
   364→              file: filePath,
   365→              path: `observations[${i}]._ulid`,
   366→              message: 'Invalid ULID format (expected 26 characters)',
   367→            });
   368→          }
   369→        }
   370→      }
   371→    }
   372→  } catch (err) {
   373→    errors.push({
   374→      file: filePath,
   375→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   376→    });
   377→  }
   378→
   379→  return errors;
   380→}
   381→
   382→/**
   383→ * Recursively validate spec items in a structure
   384→ */
   385→function validateSpecItemRecursive(
   386→  raw: unknown,
   387→  file: string,
   388→  pathPrefix: string,
   389→  errors: SchemaValidationError[]
   390→): void {
   391→  if (!raw || typeof raw !== 'object') return;
   392→
   393→  // Check if this is a spec item (has _ulid)
   394→  if ('_ulid' in raw) {
   395→    const result = SpecItemSchema.safeParse(raw);
   396→    if (!result.success) {
   397→      for (const issue of result.error.issues) {
   398→        errors.push({
   399→          file,
   400→          path: pathPrefix ? `${pathPrefix}.${issue.path.join('.')}` : issue.path.join('.'),
   401→          message: issue.message,
   402→          details: issue,
   403→        });
   404→      }
   405→    }
   406→  }
   407→
   408→  // Recurse into nested structures
   409→  const nestedFields = ['modules', 'features', 'requirements', 'constraints', 'decisions', 'items'];
   410→  const obj = raw as Record<string, unknown>;
   411→
   412→  for (const field of nestedFields) {
   413→    if (field in obj && Array.isArray(obj[field])) {
   414→      const arr = obj[field] as unknown[];
   415→      for (let i = 0; i < arr.length; i++) {
   416→        const newPath = pathPrefix ? `${pathPrefix}.${field}[${i}]` : `${field}[${i}]`;
   417→        validateSpecItemRecursive(arr[i], file, newPath, errors);
   418→      }
   419→    }
   420→  }
   421→}
   422→
   423→// ============================================================
   424→// ORPHAN DETECTION
   425→// ============================================================
   426→
   427→/**
   428→ * Find items that are not referenced by any other item
   429→ */
   430→function findOrphans(
   431→  tasks: LoadedTask[],
   432→  items: LoadedSpecItem[],
   433→  index: ReferenceIndex
   434→): OrphanItem[] {
   435→  const orphans: OrphanItem[] = [];
   436→
   437→  // Build set of all referenced ULIDs
   438→  const referenced = new Set<string>();
   439→
   440→  const allItems = [...tasks, ...items];
   441→
   442→  // Fields that contain references
   443→  const refFields = [
   444→    'depends_on',
   445→    'blocked_by',
   446→    'implements',
   447→    'relates_to',
   448→    'tests',
   449→    'supersedes',
   450→    'spec_ref',
   451→    'context',
   452→  ];
   453→
   454→  for (const item of allItems) {
   455→    const obj = item as unknown as Record<string, unknown>;
   456→
   457→    for (const field of refFields) {
   458→      const value = obj[field];
   459→
   460→      if (typeof value === 'string' && value.startsWith('@')) {
   461→        const resolved = index.resolve(value);
   462→        if (resolved.ok) {
   463→          referenced.add(resolved.ulid);
   464→        }
   465→      } else if (Array.isArray(value)) {
   466→        for (const v of value) {
   467→          if (typeof v === 'string' && v.startsWith('@')) {
   468→            const resolved = index.resolve(v);
   469→            if (resolved.ok) {
   470→              referenced.add(resolved.ulid);
   471→            }
   472→          }
   473→        }
   474→      }
   475→    }
   476→  }
   477→
   478→  // Find items not in the referenced set
   479→  // Skip entry point types: modules are spec entry points, tasks are work items
   480→  const entryPointTypes = ['module', 'task', 'epic', 'bug', 'spike', 'infra'];
   481→
   482→  for (const item of items) {
   483→    // Only check spec items, not tasks
   484→    if (!referenced.has(item._ulid)) {
   485→      // Skip entry point types
   486→      if (entryPointTypes.includes(item.type || '')) continue;
   487→
   488→      // Skip nested items - they're implicitly referenced by their parent
   489→      // _path indicates nesting (e.g., "features[0].requirements[2]")
   490→      if (item._path) continue;
   491→
   492→      orphans.push({
   493→        ulid: item._ulid,
   494→        title: item.title,
   495→        type: item.type || 'unknown',
   496→        file: item._sourceFile,
   497→      });
   498→    }
   499→  }
   500→
   501→  return orphans;
   502→}
   503→
   504→// ============================================================
   505→// COMPLETENESS VALIDATION
   506→// ============================================================
   507→
   508→/**
   509→ * Scan test files for AC annotations to build coverage index
   510→ * Returns a Set of covered ACs in format "@spec-ref ac-N"
   511→ */
   512→async function scanTestCoverage(rootDir: string): Promise<Set<string>> {
   513→  const coveredACs = new Set<string>();
   514→  const testsDir = path.join(rootDir, 'tests');
   515→
   516→  try {
   517→    // Check if tests directory exists
   518→    await fs.access(testsDir);
   519→
   520→    // Read all test files
   521→    const files = await fs.readdir(testsDir);
   522→    const testFiles = files.filter(f => f.endsWith('.test.ts') || f.endsWith('.test.js'));
   523→
   524→    for (const file of testFiles) {
   525→      const filePath = path.join(testsDir, file);
   526→      const content = await fs.readFile(filePath, 'utf-8');
   527→
   528→      // Match AC annotations: // AC: @spec-ref ac-N
   529→      // Also handle multiple ACs on one line: // AC: @spec-ref ac-1, ac-2
   530→      const acPattern = /\/\/\s*AC:\s*(@[\w-]+)(?:\s+(ac-\d+(?:\s*,\s*ac-\d+)*))?/g;
   531→      let match;
   532→
   533→      while ((match = acPattern.exec(content)) !== null) {
   534→        const specRef = match[1]; // @spec-ref
   535→        const acList = match[2]; // "ac-1, ac-2" or just "ac-1" or undefined
   536→
   537→        if (acList) {
   538→          // Split by comma and trim
   539→          const acs = acList.split(',').map(ac => ac.trim());
   540→          for (const ac of acs) {
   541→            coveredACs.add(`${specRef} ${ac}`);
   542→          }
   543→        } else {
   544→          // No specific AC mentioned, just the spec ref
   545→          // We'll consider this as generic coverage
   546→          coveredACs.add(specRef);
   547→        }
   548→      }
   549→    }
   550→  } catch (err) {
   551→    // Tests directory doesn't exist or can't be read - that's ok
   552→  }
   553→
   554→  return coveredACs;
   555→}
   556→
   557→/**
   558→ * Check spec items for completeness
   559→ * AC: @spec-completeness ac-1, ac-2, ac-3
   560→ */
   561→async function checkCompleteness(
   562→  items: LoadedSpecItem[],
   563→  index: ReferenceIndex,
   564→  rootDir: string
   565→): Promise<CompletenessWarning[]> {
   566→  const warnings: CompletenessWarning[] = [];
   567→
   568→  // Scan test files for AC coverage
   569→  const coveredACs = await scanTestCoverage(rootDir);
   570→
   571→  for (const item of items) {
   572→    const itemRef = item.slugs?.[0] ? `@${item.slugs[0]}` : `@${item._ulid.slice(0, 8)}`;
   573→
   574→    // AC: @spec-completeness ac-1
   575→    // Check for missing acceptance criteria
   576→    if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
   577→      warnings.push({
   578→        type: 'missing_acceptance_criteria',
   579→        itemRef,
   580→        itemTitle: item.title,
   581→        message: `Item ${itemRef} has no acceptance criteria`,
   582→      });
   583→    }
   584→
   585→    // AC: @spec-completeness ac-2
   586→    // Check for missing description
   587→    if (!item.description || item.description.trim() === '') {
   588→      warnings.push({
   589→        type: 'missing_description',
   590→        itemRef,
   591→        itemTitle: item.title,
   592→        message: `Item ${itemRef} has no description`,
   593→      });
   594→    }
   595→
   596→    // AC: @spec-completeness ac-3
   597→    // Check for status inconsistency between parent and children
   598→    if (item.status?.implementation === 'implemented') {
   599→      // Check if this item has children with not_started status
   600→      const childFields = [
   601→        'modules',
   602→        'features',
   603→        'requirements',
   604→        'constraints',
   605→        'epics',
   606→        'themes',
   607→        'capabilities',
   608→      ];
   609→
   610→      for (const field of childFields) {
   611→        const children = (item as any)[field];
   612→        if (Array.isArray(children)) {
   613→          for (const child of children) {
   614→            if (child.status?.implementation === 'not_started') {
   615→              const childRef = child.slugs?.[0]
   616→                ? `@${child.slugs[0]}`
   617→                : `@${child._ulid?.slice(0, 8) || 'unknown'}`;
   618→              warnings.push({
   619→                type: 'status_inconsistency',
   620→                itemRef,
   621→                itemTitle: item.title,
   622→                message: `Parent ${itemRef} is implemented but child ${childRef} is not_started`,
   623→                details: `Child: ${child.title}`,
   624→              });
   625→            }
   626→          }
   627→        }
   628→      }
   629→    }
   630→
   631→    // Check for test coverage of acceptance criteria
   632→    if (item.acceptance_criteria && item.acceptance_criteria.length > 0) {
   633→      const uncoveredACs: string[] = [];
   634→
   635→      for (const ac of item.acceptance_criteria) {
   636→        // Build all possible references for this AC
   637→        const possibleRefs: string[] = [];
   638→
   639→        // Try with primary slug
   640→        if (item.slugs && item.slugs.length > 0) {
   641→          possibleRefs.push(`@${item.slugs[0]} ${ac.id}`);
   642→          // Also check for just the slug without specific AC
   643→          possibleRefs.push(`@${item.slugs[0]}`);
   644→        }
   645→
   646→        // Try with ULID (short form)
   647→        possibleRefs.push(`@${item._ulid.slice(0, 8)} ${ac.id}`);
   648→        possibleRefs.push(`@${item._ulid.slice(0, 8)}`);
   649→
   650→        // Check if any of these references are covered
   651→        const isCovered = possibleRefs.some(ref => coveredACs.has(ref));
   652→
   653→        if (!isCovered) {
   654→          uncoveredACs.push(ac.id);
   655→        }
   656→      }
   657→
   658→      // Only warn if there are uncovered ACs
   659→      if (uncoveredACs.length > 0) {
   660→        warnings.push({
   661→          type: 'missing_test_coverage',
   662→          itemRef,
   663→          itemTitle: item.title,
   664→          message: `Item ${itemRef} has ${uncoveredACs.length} AC(s) without test coverage`,
   665→          details: `Uncovered: ${uncoveredACs.join(', ')}`,
   666→        });
   667→      }
   668→    }
   669→  }
   670→
   671→  return warnings;
   672→}
   673→
   674→// ============================================================
   675→// MAIN VALIDATION
   676→// ============================================================
   677→
   678→/**
   679→ * Run full validation on a kspec project
   680→ */
   681→export async function validate(
   682→  ctx: KspecContext,
   683→  options: ValidateOptions = {}
   684→): Promise<ValidationResult> {
   685→  // Default: run all checks
   686→  const runSchema = options.schema !== false;
   687→  const runRefs = options.refs !== false;
   688→  const runOrphans = options.orphans !== false;
   689→  const runCompleteness = options.completeness !== false;
   690→
   691→  const result: ValidationResult = {
   692→    valid: true,
   693→    schemaErrors: [],
   694→    refErrors: [],
   695→    refWarnings: [],
   696→    orphans: [],
   697→    completenessWarnings: [],
   698→    stats: {
   699→      filesChecked: 0,
   700→      itemsChecked: 0,
   701→      tasksChecked: 0,
   702→    },
   703→  };
   704→
   705→  const allTasks: LoadedTask[] = [];
   706→  const allItems: LoadedSpecItem[] = [];
   707→
   708→  // Validate manifest
   709→  if (ctx.manifestPath && runSchema) {
   710→    const manifestErrors = await validateManifestFile(ctx.manifestPath);
   711→    result.schemaErrors.push(...manifestErrors);
   712→    result.stats.filesChecked++;
   713→  }
   714→
   715→  // Find and validate task files
   716→  const taskFiles = await findTaskFiles(ctx.rootDir);
   717→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, 'spec'));
   718→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
   719→
   720→  for (const taskFile of allTaskFiles) {
   721→    if (runSchema) {
   722→      const taskErrors = await validateTasksFile(taskFile);
   723→      result.schemaErrors.push(...taskErrors);
   724→    }
   725→    result.stats.filesChecked++;
   726→
   727→    // Load tasks for ref validation
   728→    try {
   729→      const raw = await readYamlFile<unknown>(taskFile);
   730→      let taskList: unknown[] = [];
   731→
   732→      if (Array.isArray(raw)) {
   733→        taskList = raw;
   734→      } else if (raw && typeof raw === 'object' && 'tasks' in raw) {
   735→        taskList = (raw as { tasks: unknown[] }).tasks || [];
   736→      }
   737→
   738→      for (const t of taskList) {
   739→        const parsed = TaskSchema.safeParse(t);
   740→        if (parsed.success) {
   741→          allTasks.push({ ...parsed.data, _sourceFile: taskFile });
   742→          result.stats.tasksChecked++;
   743→        }
   744→      }
   745→    } catch {
   746→      // Already reported in schema validation
   747→    }
   748→  }
   749→
   750→  // Validate spec files (from includes)
   751→  if (ctx.manifest && ctx.manifestPath) {
   752→    const manifestDir = path.dirname(ctx.manifestPath);
   753→    const includes = ctx.manifest.includes || [];
   754→
   755→    for (const include of includes) {
   756→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   757→
   758→      for (const filePath of expandedPaths) {
   759→        if (runSchema) {
   760→          const specErrors = await validateSpecFile(filePath);
   761→          result.schemaErrors.push(...specErrors);
   762→        }
   763→        result.stats.filesChecked++;
   764→
   765→        // Load items for ref validation
   766→        try {
   767→          const items = await loadSpecFile(filePath);
   768→          allItems.push(...items);
   769→          result.stats.itemsChecked += items.length;
   770→        } catch {
   771→          // Already reported in schema validation
   772→        }
   773→      }
   774→    }
   775→  }
   776→
   777→  // Load meta items for reference validation
   778→  // AC: @agent-definitions ac-agent-3
   779→  const metaCtx = await loadMetaContext(ctx);
   780→  const allMetaItems = [
   781→    ...metaCtx.agents,
   782→    ...metaCtx.workflows,
   783→    ...metaCtx.conventions,
   784→    ...metaCtx.observations,
   785→  ];
   786→
   787→  // Reference validation
   788→  if (runRefs && (allTasks.length > 0 || allItems.length > 0 || allMetaItems.length > 0)) {
   789→    const index = new ReferenceIndex(allTasks, allItems, allMetaItems);
   790→    const refResult = validateRefs(index, allTasks, allItems);
   791→    result.refErrors = refResult.errors;
   792→    result.refWarnings = refResult.warnings;
   793→
   794→    // Orphan detection
   795→    if (runOrphans) {
   796→      result.orphans = findOrphans(allTasks, allItems, index);
   797→    }
   798→
   799→    // Completeness validation
   800→    // AC: @spec-completeness ac-1, ac-2, ac-3
   801→    if (runCompleteness) {
   802→      result.completenessWarnings = await checkCompleteness(allItems, index, ctx.rootDir);
   803→    }
   804→  }
   805→
   806→  // Meta manifest validation (AC-meta-manifest-2, AC-meta-manifest-3)
   807→  const metaManifestPath = await findMetaManifest(ctx.specDir);
   808→  if (metaManifestPath) {
   809→    // Use metaCtx already loaded above
   810→    result.metaStats = {
   811→      agents: metaCtx.agents.length,
   812→      workflows: metaCtx.workflows.length,
   813→      conventions: metaCtx.conventions.length,
   814→      observations: metaCtx.observations.length,
   815→    };
   816→
   817→    // Validate meta manifest schema with strict ULID validation
   818→    if (runSchema) {
   819→      const metaErrors = await validateMetaManifestFile(metaManifestPath);
   820→      // Prefix all meta errors with "meta:"
   821→      for (const err of metaErrors) {
   822→        err.path = err.path ? `meta:${err.path}` : 'meta:';
   823→      }
   824→      result.schemaErrors.push(...metaErrors);
   825→      result.stats.filesChecked++;
   826→    }
   827→  }
   828→
   829→  // Set valid flag
   830→  result.valid = result.schemaErrors.length === 0 && result.refErrors.length === 0;
   831→
   832→  return result;
   833→}
   834→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
```