```
     1→/**
     2→ * Validation module for kspec files.
     3→ *
     4→ * Provides schema validation, reference validation, and orphan detection.
     5→ */
     6→
     7→import * as fs from 'node:fs/promises';
     8→import * as path from 'node:path';
     9→import {
    10→  TaskSchema,
    11→  TasksFileSchema,
    12→  ManifestSchema,
    13→  SpecItemSchema,
    14→  MetaManifestSchema,
    15→  AgentSchema,
    16→  WorkflowSchema,
    17→  ConventionSchema,
    18→  ObservationSchema,
    19→  UlidSchema,
    20→} from '../schema/index.js';
    21→import type { KspecContext, LoadedTask, LoadedSpecItem } from './yaml.js';
    22→import {
    23→  readYamlFile,
    24→  findTaskFiles,
    25→  loadSpecFile,
    26→  expandIncludePattern,
    27→} from './yaml.js';
    28→import { ReferenceIndex, validateRefs, type RefValidationError, type RefValidationWarning } from './refs.js';
    29→import { findMetaManifest, loadMetaContext, type MetaContext } from './meta.js';
    30→import { TraitIndex } from './traits.js';
    31→
    32→// ============================================================
    33→// TYPES
    34→// ============================================================
    35→
    36→/**
    37→ * Schema validation error
    38→ */
    39→export interface SchemaValidationError {
    40→  file: string;
    41→  path?: string;
    42→  message: string;
    43→  details?: unknown;
    44→}
    45→
    46→/**
    47→ * Orphan item (not referenced by anything)
    48→ */
    49→export interface OrphanItem {
    50→  ulid: string;
    51→  title: string;
    52→  type: string;
    53→  file?: string;
    54→}
    55→
    56→/**
    57→ * Completeness warning types
    58→ */
    59→export type CompletenessWarningType =
    60→  | 'missing_acceptance_criteria'
    61→  | 'missing_description'
    62→  | 'status_inconsistency'
    63→  | 'missing_test_coverage';
    64→
    65→/**
    66→ * Completeness warning
    67→ */
    68→export interface CompletenessWarning {
    69→  type: CompletenessWarningType;
    70→  itemRef: string;
    71→  itemTitle: string;
    72→  message: string;
    73→  details?: string;
    74→}
    75→
    76→/**
    77→ * Complete validation result
    78→ */
    79→export interface ValidationResult {
    80→  valid: boolean;
    81→  schemaErrors: SchemaValidationError[];
    82→  refErrors: RefValidationError[];
    83→  refWarnings: RefValidationWarning[];
    84→  orphans: OrphanItem[];
    85→  completenessWarnings: CompletenessWarning[];
    86→  stats: {
    87→    filesChecked: number;
    88→    itemsChecked: number;
    89→    tasksChecked: number;
    90→  };
    91→  metaStats?: {
    92→    agents: number;
    93→    workflows: number;
    94→    conventions: number;
    95→    observations: number;
    96→  };
    97→}
    98→
    99→/**
   100→ * Validation options
   101→ */
   102→export interface ValidateOptions {
   103→  /** Check schema conformance */
   104→  schema?: boolean;
   105→  /** Check reference resolution */
   106→  refs?: boolean;
   107→  /** Find orphaned items */
   108→  orphans?: boolean;
   109→  /** Check spec completeness (missing AC, descriptions, status inconsistencies) */
   110→  completeness?: boolean;
   111→}
   112→
   113→// ============================================================
   114→// SCHEMA VALIDATION
   115→// ============================================================
   116→
   117→/**
   118→ * Validate a manifest file against schema
   119→ */
   120→async function validateManifestFile(filePath: string): Promise<SchemaValidationError[]> {
   121→  const errors: SchemaValidationError[] = [];
   122→
   123→  try {
   124→    const raw = await readYamlFile<unknown>(filePath);
   125→    const result = ManifestSchema.safeParse(raw);
   126→
   127→    if (!result.success) {
   128→      for (const issue of result.error.issues) {
   129→        errors.push({
   130→          file: filePath,
   131→          path: issue.path.join('.'),
   132→          message: issue.message,
   133→          details: issue,
   134→        });
   135→      }
   136→    }
   137→  } catch (err) {
   138→    errors.push({
   139→      file: filePath,
   140→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   141→    });
   142→  }
   143→
   144→  return errors;
   145→}
   146→
   147→/**
   148→ * Validate a tasks file against schema
   149→ */
   150→async function validateTasksFile(filePath: string): Promise<SchemaValidationError[]> {
   151→  const errors: SchemaValidationError[] = [];
   152→
   153→  try {
   154→    const raw = await readYamlFile<unknown>(filePath);
   155→
   156→    // Handle both formats: { tasks: [...] } and plain array
   157→    let taskList: unknown[];
   158→
   159→    if (Array.isArray(raw)) {
   160→      taskList = raw;
   161→    } else if (raw && typeof raw === 'object' && 'tasks' in raw) {
   162→      // Try full TasksFile schema first
   163→      const fileResult = TasksFileSchema.safeParse(raw);
   164→      if (!fileResult.success) {
   165→        // If TasksFile fails, just validate individual tasks
   166→        taskList = (raw as { tasks: unknown[] }).tasks || [];
   167→      } else {
   168→        // File schema passed, validate individual tasks for detailed errors
   169→        taskList = fileResult.data.tasks;
   170→      }
   171→    } else {
   172→      errors.push({
   173→        file: filePath,
   174→        message: 'Invalid tasks file format: expected array or { tasks: [...] }',
   175→      });
   176→      return errors;
   177→    }
   178→
   179→    // Validate each task
   180→    for (let i = 0; i < taskList.length; i++) {
   181→      const task = taskList[i];
   182→      const result = TaskSchema.safeParse(task);
   183→
   184→      if (!result.success) {
   185→        for (const issue of result.error.issues) {
   186→          errors.push({
   187→            file: filePath,
   188→            path: `tasks[${i}].${issue.path.join('.')}`,
   189→            message: issue.message,
   190→            details: issue,
   191→          });
   192→        }
   193→      }
   194→    }
   195→  } catch (err) {
   196→    errors.push({
   197→      file: filePath,
   198→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   199→    });
   200→  }
   201→
   202→  return errors;
   203→}
   204→
   205→/**
   206→ * Validate a spec module file against schema
   207→ */
   208→async function validateSpecFile(filePath: string): Promise<SchemaValidationError[]> {
   209→  const errors: SchemaValidationError[] = [];
   210→
   211→  try {
   212→    const raw = await readYamlFile<unknown>(filePath);
   213→
   214→    // Recursively validate spec items
   215→    validateSpecItemRecursive(raw, filePath, '', errors);
   216→  } catch (err) {
   217→    errors.push({
   218→      file: filePath,
   219→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   220→    });
   221→  }
   222→
   223→  return errors;
   224→}
   225→
   226→/**
   227→ * Validate meta manifest file with strict ULID validation
   228→ * AC-meta-manifest-3: Invalid schema exits with code 1 and shows field path + expected type
   229→ */
   230→async function validateMetaManifestFile(filePath: string): Promise<SchemaValidationError[]> {
   231→  const errors: SchemaValidationError[] = [];
   232→
   233→  try {
   234→    const raw = await readYamlFile<unknown>(filePath);
   235→
   236→    // Validate overall manifest structure
   237→    const manifestResult = MetaManifestSchema.safeParse(raw);
   238→    if (!manifestResult.success) {
   239→      for (const issue of manifestResult.error.issues) {
   240→        errors.push({
   241→          file: filePath,
   242→          path: issue.path.join('.'),
   243→          message: issue.message,
   244→          details: issue,
   245→        });
   246→      }
   247→      return errors;
   248→    }
   249→
   250→    // Validate each agent with strict ULID validation
   251→    if (raw && typeof raw === 'object' && 'agents' in raw && Array.isArray((raw as Record<string, unknown>).agents)) {
   252→      const agents = (raw as Record<string, unknown>).agents as unknown[];
   253→      for (let i = 0; i < agents.length; i++) {
   254→        const agent = agents[i];
   255→        const agentResult = AgentSchema.safeParse(agent);
   256→        if (!agentResult.success) {
   257→          for (const issue of agentResult.error.issues) {
   258→            errors.push({
   259→              file: filePath,
   260→              path: `agents[${i}].${issue.path.join('.')}`,
   261→              message: issue.message,
   262→              details: issue,
   263→            });
   264→          }
   265→        }
   266→
   267→        // Strict ULID validation
   268→        if (agent && typeof agent === 'object' && '_ulid' in agent) {
   269→          const ulidResult = UlidSchema.safeParse((agent as Record<string, unknown>)._ulid);
   270→          if (!ulidResult.success) {
   271→            errors.push({
   272→              file: filePath,
   273→              path: `agents[${i}]._ulid`,
   274→              message: 'Invalid ULID format (expected 26 characters)',
   275→            });
   276→          }
   277→        }
   278→      }
   279→    }
   280→
   281→    // Validate each workflow with strict ULID validation
   282→    if (raw && typeof raw === 'object' && 'workflows' in raw && Array.isArray((raw as Record<string, unknown>).workflows)) {
   283→      const workflows = (raw as Record<string, unknown>).workflows as unknown[];
   284→      for (let i = 0; i < workflows.length; i++) {
   285→        const workflow = workflows[i];
   286→        const workflowResult = WorkflowSchema.safeParse(workflow);
   287→        if (!workflowResult.success) {
   288→          for (const issue of workflowResult.error.issues) {
   289→            errors.push({
   290→              file: filePath,
   291→              path: `workflows[${i}].${issue.path.join('.')}`,
   292→              message: issue.message,
   293→              details: issue,
   294→            });
   295→          }
   296→        }
   297→
   298→        // Strict ULID validation
   299→        if (workflow && typeof workflow === 'object' && '_ulid' in workflow) {
   300→          const ulidResult = UlidSchema.safeParse((workflow as Record<string, unknown>)._ulid);
   301→          if (!ulidResult.success) {
   302→            errors.push({
   303→              file: filePath,
   304→              path: `workflows[${i}]._ulid`,
   305→              message: 'Invalid ULID format (expected 26 characters)',
   306→            });
   307→          }
   308→        }
   309→      }
   310→    }
   311→
   312→    // Validate each convention with strict ULID validation
   313→    if (raw && typeof raw === 'object' && 'conventions' in raw && Array.isArray((raw as Record<string, unknown>).conventions)) {
   314→      const conventions = (raw as Record<string, unknown>).conventions as unknown[];
   315→      for (let i = 0; i < conventions.length; i++) {
   316→        const convention = conventions[i];
   317→        const conventionResult = ConventionSchema.safeParse(convention);
   318→        if (!conventionResult.success) {
   319→          for (const issue of conventionResult.error.issues) {
   320→            errors.push({
   321→              file: filePath,
   322→              path: `conventions[${i}].${issue.path.join('.')}`,
   323→              message: issue.message,
   324→              details: issue,
   325→            });
   326→          }
   327→        }
   328→
   329→        // Strict ULID validation
   330→        if (convention && typeof convention === 'object' && '_ulid' in convention) {
   331→          const ulidResult = UlidSchema.safeParse((convention as Record<string, unknown>)._ulid);
   332→          if (!ulidResult.success) {
   333→            errors.push({
   334→              file: filePath,
   335→              path: `conventions[${i}]._ulid`,
   336→              message: 'Invalid ULID format (expected 26 characters)',
   337→            });
   338→          }
   339→        }
   340→      }
   341→    }
   342→
   343→    // Validate each observation with strict ULID validation
   344→    if (raw && typeof raw === 'object' && 'observations' in raw && Array.isArray((raw as Record<string, unknown>).observations)) {
   345→      const observations = (raw as Record<string, unknown>).observations as unknown[];
   346→      for (let i = 0; i < observations.length; i++) {
   347→        const observation = observations[i];
   348→        const observationResult = ObservationSchema.safeParse(observation);
   349→        if (!observationResult.success) {
   350→          for (const issue of observationResult.error.issues) {
   351→            errors.push({
   352→              file: filePath,
   353→              path: `observations[${i}].${issue.path.join('.')}`,
   354→              message: issue.message,
   355→              details: issue,
   356→            });
   357→          }
   358→        }
   359→
   360→        // Strict ULID validation
   361→        if (observation && typeof observation === 'object' && '_ulid' in observation) {
   362→          const ulidResult = UlidSchema.safeParse((observation as Record<string, unknown>)._ulid);
   363→          if (!ulidResult.success) {
   364→            errors.push({
   365→              file: filePath,
   366→              path: `observations[${i}]._ulid`,
   367→              message: 'Invalid ULID format (expected 26 characters)',
   368→            });
   369→          }
   370→        }
   371→      }
   372→    }
   373→  } catch (err) {
   374→    errors.push({
   375→      file: filePath,
   376→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   377→    });
   378→  }
   379→
   380→  return errors;
   381→}
   382→
   383→/**
   384→ * Recursively validate spec items in a structure
   385→ */
   386→function validateSpecItemRecursive(
   387→  raw: unknown,
   388→  file: string,
   389→  pathPrefix: string,
   390→  errors: SchemaValidationError[]
   391→): void {
   392→  if (!raw || typeof raw !== 'object') return;
   393→
   394→  // Check if this is a spec item (has _ulid)
   395→  if ('_ulid' in raw) {
   396→    const result = SpecItemSchema.safeParse(raw);
   397→    if (!result.success) {
   398→      for (const issue of result.error.issues) {
   399→        errors.push({
   400→          file,
   401→          path: pathPrefix ? `${pathPrefix}.${issue.path.join('.')}` : issue.path.join('.'),
   402→          message: issue.message,
   403→          details: issue,
   404→        });
   405→      }
   406→    }
   407→  }
   408→
   409→  // Recurse into nested structures
   410→  const nestedFields = ['modules', 'features', 'requirements', 'constraints', 'decisions', 'items'];
   411→  const obj = raw as Record<string, unknown>;
   412→
   413→  for (const field of nestedFields) {
   414→    if (field in obj && Array.isArray(obj[field])) {
   415→      const arr = obj[field] as unknown[];
   416→      for (let i = 0; i < arr.length; i++) {
   417→        const newPath = pathPrefix ? `${pathPrefix}.${field}[${i}]` : `${field}[${i}]`;
   418→        validateSpecItemRecursive(arr[i], file, newPath, errors);
   419→      }
   420→    }
   421→  }
   422→}
   423→
   424→// ============================================================
   425→// ORPHAN DETECTION
   426→// ============================================================
   427→
   428→/**
   429→ * Find items that are not referenced by any other item
   430→ */
   431→function findOrphans(
   432→  tasks: LoadedTask[],
   433→  items: LoadedSpecItem[],
   434→  index: ReferenceIndex
   435→): OrphanItem[] {
   436→  const orphans: OrphanItem[] = [];
   437→
   438→  // Build set of all referenced ULIDs
   439→  const referenced = new Set<string>();
   440→
   441→  const allItems = [...tasks, ...items];
   442→
   443→  // Fields that contain references
   444→  const refFields = [
   445→    'depends_on',
   446→    'blocked_by',
   447→    'implements',
   448→    'relates_to',
   449→    'tests',
   450→    'supersedes',
   451→    'spec_ref',
   452→    'context',
   453→  ];
   454→
   455→  for (const item of allItems) {
   456→    const obj = item as unknown as Record<string, unknown>;
   457→
   458→    for (const field of refFields) {
   459→      const value = obj[field];
   460→
   461→      if (typeof value === 'string' && value.startsWith('@')) {
   462→        const resolved = index.resolve(value);
   463→        if (resolved.ok) {
   464→          referenced.add(resolved.ulid);
   465→        }
   466→      } else if (Array.isArray(value)) {
   467→        for (const v of value) {
   468→          if (typeof v === 'string' && v.startsWith('@')) {
   469→            const resolved = index.resolve(v);
   470→            if (resolved.ok) {
   471→              referenced.add(resolved.ulid);
   472→            }
   473→          }
   474→        }
   475→      }
   476→    }
   477→  }
   478→
   479→  // Find items not in the referenced set
   480→  // Skip entry point types: modules are spec entry points, tasks are work items
   481→  const entryPointTypes = ['module', 'task', 'epic', 'bug', 'spike', 'infra'];
   482→
   483→  for (const item of items) {
   484→    // Only check spec items, not tasks
   485→    if (!referenced.has(item._ulid)) {
   486→      // Skip entry point types
   487→      if (entryPointTypes.includes(item.type || '')) continue;
   488→
   489→      // Skip nested items - they're implicitly referenced by their parent
   490→      // _path indicates nesting (e.g., "features[0].requirements[2]")
   491→      if (item._path) continue;
   492→
   493→      orphans.push({
   494→        ulid: item._ulid,
   495→        title: item.title,
   496→        type: item.type || 'unknown',
   497→        file: item._sourceFile,
   498→      });
   499→    }
   500→  }
   501→
   502→  return orphans;
   503→}
   504→
   505→// ============================================================
   506→// COMPLETENESS VALIDATION
   507→// ============================================================
   508→
   509→/**
   510→ * Scan test files for AC annotations to build coverage index
   511→ * Returns a Set of covered ACs in format "@spec-ref ac-N"
   512→ */
   513→async function scanTestCoverage(rootDir: string): Promise<Set<string>> {
   514→  const coveredACs = new Set<string>();
   515→  const testsDir = path.join(rootDir, 'tests');
   516→
   517→  try {
   518→    // Check if tests directory exists
   519→    await fs.access(testsDir);
   520→
   521→    // Read all test files
   522→    const files = await fs.readdir(testsDir);
   523→    const testFiles = files.filter(f => f.endsWith('.test.ts') || f.endsWith('.test.js'));
   524→
   525→    for (const file of testFiles) {
   526→      const filePath = path.join(testsDir, file);
   527→      const content = await fs.readFile(filePath, 'utf-8');
   528→
   529→      // Match AC annotations: // AC: @spec-ref ac-N
   530→      // Also handle multiple ACs on one line: // AC: @spec-ref ac-1, ac-2
   531→      const acPattern = /\/\/\s*AC:\s*(@[\w-]+)(?:\s+(ac-\d+(?:\s*,\s*ac-\d+)*))?/g;
   532→      let match;
   533→
   534→      while ((match = acPattern.exec(content)) !== null) {
   535→        const specRef = match[1]; // @spec-ref
   536→        const acList = match[2]; // "ac-1, ac-2" or just "ac-1" or undefined
   537→
   538→        if (acList) {
   539→          // Split by comma and trim
   540→          const acs = acList.split(',').map(ac => ac.trim());
   541→          for (const ac of acs) {
   542→            coveredACs.add(`${specRef} ${ac}`);
   543→          }
   544→        } else {
   545→          // No specific AC mentioned, just the spec ref
   546→          // We'll consider this as generic coverage
   547→          coveredACs.add(specRef);
   548→        }
   549→      }
   550→    }
   551→  } catch (err) {
   552→    // Tests directory doesn't exist or can't be read - that's ok
   553→  }
   554→
   555→  return coveredACs;
   556→}
   557→
   558→/**
   559→ * Check spec items for completeness
   560→ * AC: @spec-completeness ac-1, ac-2, ac-3
   561→ * AC: @trait-validation ac-1, ac-2, ac-3
   562→ */
   563→async function checkCompleteness(
   564→  items: LoadedSpecItem[],
   565→  index: ReferenceIndex,
   566→  rootDir: string,
   567→  traitIndex?: TraitIndex
   568→): Promise<CompletenessWarning[]> {
   569→  const warnings: CompletenessWarning[] = [];
   570→
   571→  // Scan test files for AC coverage
   572→  const coveredACs = await scanTestCoverage(rootDir);
   573→
   574→  for (const item of items) {
   575→    const itemRef = item.slugs?.[0] ? `@${item.slugs[0]}` : `@${item._ulid.slice(0, 8)}`;
   576→    const isTrait = item.type === 'trait';
   577→
   578→    // AC: @spec-completeness ac-1
   579→    // AC: @trait-type ac-2 - Traits should have acceptance criteria for completeness
   580→    // Check for missing acceptance criteria
   581→    if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
   582→      warnings.push({
   583→        type: 'missing_acceptance_criteria',
   584→        itemRef,
   585→        itemTitle: item.title,
   586→        message: `${isTrait ? 'Trait' : 'Item'} ${itemRef} has no acceptance criteria`,
   587→      });
   588→    }
   589→
   590→    // AC: @spec-completeness ac-2
   591→    // AC: @trait-type ac-3 - Traits should have description for completeness
   592→    // Check for missing description
   593→    if (!item.description || item.description.trim() === '') {
   594→      warnings.push({
   595→        type: 'missing_description',
   596→        itemRef,
   597→        itemTitle: item.title,
   598→        message: `${isTrait ? 'Trait' : 'Item'} ${itemRef} has no description`,
   599→      });
   600→    }
   601→
   602→    // AC: @spec-completeness ac-3
   603→    // Check for status inconsistency between parent and children
   604→    if (item.status?.implementation === 'implemented') {
   605→      // Check if this item has children with not_started status
   606→      const childFields = [
   607→        'modules',
   608→        'features',
   609→        'requirements',
   610→        'constraints',
   611→        'epics',
   612→        'themes',
   613→        'capabilities',
   614→      ];
   615→
   616→      for (const field of childFields) {
   617→        const children = (item as any)[field];
   618→        if (Array.isArray(children)) {
   619→          for (const child of children) {
   620→            if (child.status?.implementation === 'not_started') {
   621→              const childRef = child.slugs?.[0]
   622→                ? `@${child.slugs[0]}`
   623→                : `@${child._ulid?.slice(0, 8) || 'unknown'}`;
   624→              warnings.push({
   625→                type: 'status_inconsistency',
   626→                itemRef,
   627→                itemTitle: item.title,
   628→                message: `Parent ${itemRef} is implemented but child ${childRef} is not_started`,
   629→                details: `Child: ${child.title}`,
   630→              });
   631→            }
   632→          }
   633→        }
   634→      }
   635→    }
   636→
   637→    // Check for test coverage of acceptance criteria
   638→    if (item.acceptance_criteria && item.acceptance_criteria.length > 0) {
   639→      const uncoveredACs: string[] = [];
   640→
   641→      for (const ac of item.acceptance_criteria) {
   642→        // Build all possible references for this AC
   643→        const possibleRefs: string[] = [];
   644→
   645→        // Try with primary slug
   646→        if (item.slugs && item.slugs.length > 0) {
   647→          possibleRefs.push(`@${item.slugs[0]} ${ac.id}`);
   648→          // Also check for just the slug without specific AC
   649→          possibleRefs.push(`@${item.slugs[0]}`);
   650→        }
   651→
   652→        // Try with ULID (short form)
   653→        possibleRefs.push(`@${item._ulid.slice(0, 8)} ${ac.id}`);
   654→        possibleRefs.push(`@${item._ulid.slice(0, 8)}`);
   655→
   656→        // Check if any of these references are covered
   657→        const isCovered = possibleRefs.some(ref => coveredACs.has(ref));
   658→
   659→        if (!isCovered) {
   660→          uncoveredACs.push(ac.id);
   661→        }
   662→      }
   663→
   664→      // Only warn if there are uncovered ACs
   665→      if (uncoveredACs.length > 0) {
   666→        warnings.push({
   667→          type: 'missing_test_coverage',
   668→          itemRef,
   669→          itemTitle: item.title,
   670→          message: `Item ${itemRef} has ${uncoveredACs.length} AC(s) without test coverage`,
   671→          details: `Uncovered: ${uncoveredACs.join(', ')}`,
   672→        });
   673→      }
   674→    }
   675→
   676→    // AC: @trait-validation ac-1, ac-2
   677→    // Check for test coverage of trait acceptance criteria
   678→    if (traitIndex && item.traits && item.traits.length > 0) {
   679→      const inheritedACs = traitIndex.getInheritedAC(item._ulid);
   680→      const uncoveredTraitACs: Array<{ traitSlug: string; acId: string }> = [];
   681→
   682→      for (const { trait, ac } of inheritedACs) {
   683→        // Build all possible references for this trait AC
   684→        const possibleRefs: string[] = [];
   685→
   686→        // Try with trait slug
   687→        possibleRefs.push(`@${trait.slug} ${ac.id}`);
   688→        possibleRefs.push(`@${trait.slug}`);
   689→
   690→        // Try with trait ULID (short form)
   691→        possibleRefs.push(`@${trait.ulid.slice(0, 8)} ${ac.id}`);
   692→        possibleRefs.push(`@${trait.ulid.slice(0, 8)}`);
   693→
   694→        // Check if any of these references are covered
   695→        const isCovered = possibleRefs.some(ref => coveredACs.has(ref));
   696→
   697→        if (!isCovered) {
   698→          uncoveredTraitACs.push({ traitSlug: trait.slug, acId: ac.id });
   699→        }
   700→      }
   701→
   702→      // Only warn if there are uncovered trait ACs
   703→      if (uncoveredTraitACs.length > 0) {
   704→        const details = uncoveredTraitACs
   705→          .map(({ traitSlug, acId }) => `@${traitSlug} ${acId}`)
   706→          .join(', ');
   707→        warnings.push({
   708→          type: 'missing_test_coverage',
   709→          itemRef,
   710→          itemTitle: item.title,
   711→          message: `Item ${itemRef} has ${uncoveredTraitACs.length} inherited trait AC(s) without test coverage`,
   712→          details: `Uncovered trait ACs: ${details}`,
   713→        });
   714→      }
   715→    }
   716→  }
   717→
   718→  return warnings;
   719→}
   720→
   721→// ============================================================
   722→// MAIN VALIDATION
   723→// ============================================================
   724→
   725→/**
   726→ * Run full validation on a kspec project
   727→ */
   728→export async function validate(
   729→  ctx: KspecContext,
   730→  options: ValidateOptions = {}
   731→): Promise<ValidationResult> {
   732→  // Default: run all checks
   733→  const runSchema = options.schema !== false;
   734→  const runRefs = options.refs !== false;
   735→  const runOrphans = options.orphans !== false;
   736→  const runCompleteness = options.completeness !== false;
   737→
   738→  const result: ValidationResult = {
   739→    valid: true,
   740→    schemaErrors: [],
   741→    refErrors: [],
   742→    refWarnings: [],
   743→    orphans: [],
   744→    completenessWarnings: [],
   745→    stats: {
   746→      filesChecked: 0,
   747→      itemsChecked: 0,
   748→      tasksChecked: 0,
   749→    },
   750→  };
   751→
   752→  const allTasks: LoadedTask[] = [];
   753→  const allItems: LoadedSpecItem[] = [];
   754→
   755→  // Validate manifest
   756→  if (ctx.manifestPath && runSchema) {
   757→    const manifestErrors = await validateManifestFile(ctx.manifestPath);
   758→    result.schemaErrors.push(...manifestErrors);
   759→    result.stats.filesChecked++;
   760→  }
   761→
   762→  // Find and validate task files
   763→  const taskFiles = await findTaskFiles(ctx.rootDir);
   764→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, 'spec'));
   765→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
   766→
   767→  for (const taskFile of allTaskFiles) {
   768→    if (runSchema) {
   769→      const taskErrors = await validateTasksFile(taskFile);
   770→      result.schemaErrors.push(...taskErrors);
   771→    }
   772→    result.stats.filesChecked++;
   773→
   774→    // Load tasks for ref validation
   775→    try {
   776→      const raw = await readYamlFile<unknown>(taskFile);
   777→      let taskList: unknown[] = [];
   778→
   779→      if (Array.isArray(raw)) {
   780→        taskList = raw;
   781→      } else if (raw && typeof raw === 'object' && 'tasks' in raw) {
   782→        taskList = (raw as { tasks: unknown[] }).tasks || [];
   783→      }
   784→
   785→      for (const t of taskList) {
   786→        const parsed = TaskSchema.safeParse(t);
   787→        if (parsed.success) {
   788→          allTasks.push({ ...parsed.data, _sourceFile: taskFile });
   789→          result.stats.tasksChecked++;
   790→        }
   791→      }
   792→    } catch {
   793→      // Already reported in schema validation
   794→    }
   795→  }
   796→
   797→  // Validate spec files (from includes)
   798→  if (ctx.manifest && ctx.manifestPath) {
   799→    const manifestDir = path.dirname(ctx.manifestPath);
   800→    const includes = ctx.manifest.includes || [];
   801→
   802→    for (const include of includes) {
   803→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   804→
   805→      for (const filePath of expandedPaths) {
   806→        if (runSchema) {
   807→          const specErrors = await validateSpecFile(filePath);
   808→          result.schemaErrors.push(...specErrors);
   809→        }
   810→        result.stats.filesChecked++;
   811→
   812→        // Load items for ref validation
   813→        try {
   814→          const items = await loadSpecFile(filePath);
   815→          allItems.push(...items);
   816→          result.stats.itemsChecked += items.length;
   817→        } catch {
   818→          // Already reported in schema validation
   819→        }
   820→      }
   821→    }
   822→  }
   823→
   824→  // Load meta items for reference validation
   825→  // AC: @agent-definitions ac-agent-3
   826→  const metaCtx = await loadMetaContext(ctx);
   827→  const allMetaItems = [
   828→    ...metaCtx.agents,
   829→    ...metaCtx.workflows,
   830→    ...metaCtx.conventions,
   831→    ...metaCtx.observations,
   832→  ];
   833→
   834→  // Reference validation
   835→  if (runRefs && (allTasks.length > 0 || allItems.length > 0 || allMetaItems.length > 0)) {
   836→    const index = new ReferenceIndex(allTasks, allItems, allMetaItems);
   837→    const refResult = validateRefs(index, allTasks, allItems);
   838→    result.refErrors = refResult.errors;
   839→    result.refWarnings = refResult.warnings;
   840→
   841→    // Orphan detection
   842→    if (runOrphans) {
   843→      result.orphans = findOrphans(allTasks, allItems, index);
   844→    }
   845→
   846→    // Completeness validation
   847→    // AC: @spec-completeness ac-1, ac-2, ac-3
   848→    // AC: @trait-validation ac-3
   849→    if (runCompleteness) {
   850→      // Build trait index for trait AC coverage validation
   851→      const traitIndex = new TraitIndex(allItems, index);
   852→      result.completenessWarnings = await checkCompleteness(allItems, index, ctx.rootDir, traitIndex);
   853→    }
   854→  }
   855→
   856→  // Meta manifest validation (AC-meta-manifest-2, AC-meta-manifest-3)
   857→  const metaManifestPath = await findMetaManifest(ctx.specDir);
   858→  if (metaManifestPath) {
   859→    // Use metaCtx already loaded above
   860→    result.metaStats = {
   861→      agents: metaCtx.agents.length,
   862→      workflows: metaCtx.workflows.length,
   863→      conventions: metaCtx.conventions.length,
   864→      observations: metaCtx.observations.length,
   865→    };
   866→
   867→    // Validate meta manifest schema with strict ULID validation
   868→    if (runSchema) {
   869→      const metaErrors = await validateMetaManifestFile(metaManifestPath);
   870→      // Prefix all meta errors with "meta:"
   871→      for (const err of metaErrors) {
   872→        err.path = err.path ? `meta:${err.path}` : 'meta:';
   873→      }
   874→      result.schemaErrors.push(...metaErrors);
   875→      result.stats.filesChecked++;
   876→    }
   877→  }
   878→
   879→  // Set valid flag
   880→  result.valid = result.schemaErrors.length === 0 && result.refErrors.length === 0;
   881→
   882→  return result;
   883→}
   884→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
```