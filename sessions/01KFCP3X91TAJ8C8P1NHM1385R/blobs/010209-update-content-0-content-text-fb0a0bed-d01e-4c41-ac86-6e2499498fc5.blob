   232→      project: {
   233→        name: 'test-project',
   234→      },
   235→      includes: ['modules/traits.yaml'],
   236→    };
   237→    await writeYamlFilePreserveFormat(path.join(specDir, 'kynetic.yaml'), manifest);
   238→
   239→    // Create a spec that references a non-existent trait
   240→    const spec = {
   241→      _ulid: '01KFCRVY8MT49H8N6JW35NN2P3',
   242→      slugs: ['test-spec'],
   243→      title: 'Test Spec',
   244→      type: 'requirement',
   245→      description: 'A spec referencing deleted trait',
   246→      status: { maturity: 'draft', implementation: 'not_started' },
   247→      traits: ['@deleted-trait'],
   248→    };
   249→
   250→    await writeYamlFilePreserveFormat(path.join(modulesDir, 'traits.yaml'), spec);
   251→
   252→    // Run validation
   253→    const ctx = await initContext(tempDir);
   254→    const result = await validate(ctx, { refs: true });
   255→
   256→    // Verify broken reference error
   257→    const traitRefErrors = result.refErrors.filter(
   258→      e => e.field === 'traits' && e.ref === '@deleted-trait'
   259→    );
   260→    expect(traitRefErrors).toHaveLength(1);
   261→    expect(traitRefErrors[0].message).toContain('not found');
   262→  });
