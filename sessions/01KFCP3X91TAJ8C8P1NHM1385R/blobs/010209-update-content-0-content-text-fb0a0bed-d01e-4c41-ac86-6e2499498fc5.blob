   223→  // AC: @trait-validation ac-4
   224→  it('should report error when spec references deleted trait', async () => {
   225→    // Setup minimal kspec structure
   226→    const specDir = path.join(tempDir, 'spec');
   227→    const modulesDir = path.join(specDir, 'modules');
   228→    await fs.mkdir(modulesDir, { recursive: true });
   229→
   230→    // Create manifest
