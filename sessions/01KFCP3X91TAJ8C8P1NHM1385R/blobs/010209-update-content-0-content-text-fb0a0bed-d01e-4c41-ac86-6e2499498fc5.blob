     1→/**
     2→ * Tests for trait AC coverage validation
     3→ * AC: @trait-validation ac-1, ac-2, ac-3, ac-4
     4→ */
     5→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     6→import * as fs from 'node:fs/promises';
     7→import * as path from 'node:path';
     8→import * as os from 'node:os';
     9→import { validate } from '../src/parser/validate.js';
    10→import { initContext } from '../src/parser/yaml.js';
    11→import { writeYamlFilePreserveFormat } from '../src/parser/yaml.js';
    12→
    13→describe('Trait AC coverage validation', () => {
    14→  let tempDir: string;
    15→
    16→  beforeEach(async () => {
    17→    tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-test-'));
    18→  });
    19→
    20→  afterEach(async () => {
    21→    await fs.rm(tempDir, { recursive: true, force: true });
    22→  });
    23→
    24→  // AC: @trait-validation ac-1
    25→  it('should warn when spec implementing trait has no test coverage for trait AC', async () => {
    26→    // Setup minimal kspec structure
    27→    const specDir = path.join(tempDir, 'spec');
    28→    const modulesDir = path.join(specDir, 'modules');
    29→    await fs.mkdir(modulesDir, { recursive: true });
    30→
    31→    // Create manifest
    32→    const manifest = {
    33→      project: {
    34→        name: 'test-project',
    35→      },
    36→      includes: ['modules/traits.yaml'],
    37→    };
    38→    await writeYamlFilePreserveFormat(path.join(specDir, 'kynetic.yaml'), manifest);
    39→
    40→    // Create a trait with AC
    41→    const trait = {
    42→      _ulid: '01KFCRVY8ERZEE2MNHEQXSG90T',
    43→      slugs: ['test-trait'],
    44→      title: 'Test Trait',
    45→      type: 'trait',
    46→      description: 'A test trait with AC',
    47→      status: { maturity: 'draft', implementation: 'not_started' },
    48→      acceptance_criteria: [
    49→        {
    50→          id: 'ac-1',
    51→          given: 'test condition',
    52→          when: 'test action',
    53→          then: 'test result',
    54→        },
    55→      ],
    56→    };
    57→
    58→    // Create a spec implementing the trait
    59→    const spec = {
    60→      _ulid: '01KFCRVY8MT49H8N6JW35NN2P3',
    61→      slugs: ['test-spec'],
    62→      title: 'Test Spec',
    63→      type: 'requirement',
    64→      description: 'A spec implementing the trait',
    65→      status: { maturity: 'draft', implementation: 'not_started' },
    66→      traits: ['@test-trait'],
    67→    };
    68→
    69→    await writeYamlFilePreserveFormat(path.join(modulesDir, 'traits.yaml'), [trait, spec]);
    70→
    71→    // Run validation (no tests directory = no coverage)
    72→    const ctx = await initContext(tempDir);
    73→    const result = await validate(ctx, { completeness: true });
    74→
    75→    // Verify warning for missing trait AC coverage
    76→    const coverageWarnings = result.completenessWarnings.filter(
    77→      w =>
    78→        w.type === 'missing_test_coverage' &&
    79→        w.itemRef.includes('test-spec') &&
    80→        w.message.includes('inherited trait AC')
    81→    );
    82→    expect(coverageWarnings).toHaveLength(1);
    83→    expect(coverageWarnings[0].details).toContain('@test-trait ac-1');
    84→  });
    85→
    86→  // AC: @trait-validation ac-2
