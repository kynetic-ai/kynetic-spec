     1→/**
     2→ * Tests for TraitIndex
     3→ */
     4→
     5→import { describe, it, expect } from 'vitest';
     6→import { TraitIndex } from '../../src/parser/traits.js';
     7→import { ReferenceIndex } from '../../src/parser/refs.js';
     8→import type { LoadedSpecItem, LoadedTask } from '../../src/parser/yaml.js';
     9→
    10→describe('TraitIndex', () => {
    11→  // AC: @trait-index ac-1
    12→  describe('indexing trait-type items', () => {
    13→    it('should index all trait-type items by ULID and slug', () => {
    14→      const items: LoadedSpecItem[] = [
    15→        {
    16→          _ulid: '01TRAIT001',
    17→          slugs: ['trait-one'],
    18→          title: 'Trait One',
    19→          description: 'First trait',
    20→          type: 'trait',
    21→          acceptance_criteria: [
    22→            { id: 'ac-1', given: 'g1', when: 'w1', then: 't1' },
    23→          ],
    24→          depends_on: [],
    25→          implements: [],
    26→          relates_to: [],
    27→          tests: [],
    28→          traits: [],
    29→          status: { maturity: 'draft' },
    30→        },
    31→        {
    32→          _ulid: '01TRAIT002',
    33→          slugs: ['trait-two'],
    34→          title: 'Trait Two',
    35→          type: 'trait',
    36→          acceptance_criteria: [
    37→            { id: 'ac-1', given: 'g2', when: 'w2', then: 't2' },
    38→            { id: 'ac-2', given: 'g3', when: 'w3', then: 't3' },
    39→          ],
    40→          depends_on: [],
    41→          implements: [],
    42→          relates_to: [],
    43→          tests: [],
    44→          traits: [],
    45→          status: { maturity: 'draft' },
    46→        },
    47→        {
    48→          _ulid: '01SPEC001',
    49→          slugs: ['spec-one'],
    50→          title: 'Spec One',
    51→          type: 'feature',
    52→          depends_on: [],
    53→          implements: [],
    54→          relates_to: [],
    55→          tests: [],
    56→          traits: [],
    57→          status: { maturity: 'draft' },
    58→        },
    59→      ];
    60→
    61→      const tasks: LoadedTask[] = [];
    62→      const refIndex = new ReferenceIndex(tasks, items);
    63→      const traitIndex = new TraitIndex(items, refIndex);
    64→
    65→      // Should index both traits
    66→      const allTraits = traitIndex.getAllTraits();
    67→      expect(allTraits).toHaveLength(2);
    68→
    69→      // Should be accessible by ULID
    70→      const trait1 = traitIndex.getTrait('01TRAIT001');
    71→      expect(trait1).toBeDefined();
    72→      expect(trait1?.ulid).toBe('01TRAIT001');
    73→      expect(trait1?.slug).toBe('trait-one');
    74→      expect(trait1?.title).toBe('Trait One');
    75→      expect(trait1?.description).toBe('First trait');
    76→      expect(trait1?.acceptanceCriteria).toHaveLength(1);
    77→
    78→      const trait2 = traitIndex.getTrait('01TRAIT002');
    79→      expect(trait2).toBeDefined();
    80→      expect(trait2?.ulid).toBe('01TRAIT002');
    81→      expect(trait2?.acceptanceCriteria).toHaveLength(2);
    82→
    83→      // Non-trait items should not be indexed
    84→      expect(traitIndex.getTrait('01SPEC001')).toBeUndefined();
    85→    });
    86→
