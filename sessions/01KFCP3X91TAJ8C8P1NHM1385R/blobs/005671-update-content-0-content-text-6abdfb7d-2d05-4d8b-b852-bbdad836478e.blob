   164→      const inherited = traitIndex.getInheritedAC('01SPEC001');
   165→
   166→      // Should have 3 total ACs (2 from trait-one, 1 from trait-two)
   167→      expect(inherited).toHaveLength(3);
   168→
   169→      // Verify structure
   170→      expect(inherited[0]).toHaveProperty('trait');
   171→      expect(inherited[0]).toHaveProperty('ac');
   172→      expect(inherited[0].trait.ulid).toBe('01TRAIT001');
   173→      expect(inherited[0].ac.id).toBe('ac-1');
   174→
