```
     1→import { Command } from 'commander';
     2→import {
     3→  initContext,
     4→  loadAllTasks,
     5→  loadAllItems,
     6→  saveTask,
     7→  createTask,
     8→  createNote,
     9→  ReferenceIndex,
    10→  AlignmentIndex,
    11→  type LoadedTask,
    12→  type LoadedSpecItem,
    13→  type KspecContext,
    14→} from '../../parser/index.js';
    15→import { commitIfShadow } from '../../parser/shadow.js';
    16→import { output, success, error, warn, info, isJsonMode } from '../output.js';
    17→import type { TaskInput } from '../../schema/index.js';
    18→import { errors } from '../../strings/index.js';
    19→import { EXIT_CODES } from '../exit-codes.js';
    20→
    21→/**
    22→ * Fields that contain nested spec items (mirrors yaml.ts)
    23→ */
    24→const NESTED_ITEM_FIELDS = ['modules', 'features', 'requirements', 'constraints', 'decisions'];
    25→
    26→/**
    27→ * Get the parent path from a child's _path.
    28→ * e.g., "features[0].requirements[1]" -> "features[0]"
    29→ * Returns empty string for top-level items.
    30→ */
    31→function getParentPath(childPath: string | undefined): string {
    32→  if (!childPath) return '';
    33→  const lastDotIndex = childPath.lastIndexOf('.');
    34→  if (lastDotIndex === -1) return '';
    35→  return childPath.slice(0, lastDotIndex);
    36→}
    37→
    38→/**
    39→ * Check if an item is a direct child of another item based on _path.
    40→ * Direct children have a path that extends the parent's path by exactly one field[index].
    41→ */
    42→function isDirectChildOf(child: LoadedSpecItem, parent: LoadedSpecItem): boolean {
    43→  const childPath = child._path || '';
    44→  const parentPath = parent._path || '';
    45→
    46→  // If paths are equal, not a child
    47→  if (childPath === parentPath) return false;
    48→
    49→  // Child path must start with parent path
    50→  if (parentPath && !childPath.startsWith(parentPath + '.')) return false;
    51→
    52→  // For root parent (empty path), child must be a top-level path like "features[0]"
    53→  if (!parentPath) {
    54→    // Direct child of root has no '.' in its path
    55→    return !childPath.includes('.');
    56→  }
    57→
    58→  // Get the remaining path after parent
    59→  const remaining = childPath.slice(parentPath.length + 1);
    60→
    61→  // Direct child has no additional '.' (e.g., "requirements[0]" not "requirements[0].something")
    62→  return !remaining.includes('.');
    63→}
    64→
    65→/**
    66→ * Find the parent spec item of a given item.
    67→ * Returns undefined for root-level items.
    68→ */
    69→function findParentItem(
    70→  item: LoadedSpecItem,
    71→  allItems: LoadedSpecItem[]
    72→): LoadedSpecItem | undefined {
    73→  const parentPath = getParentPath(item._path);
    74→
    75→  // Root-level item or no path
    76→  if (!parentPath && !item._path) return undefined;
    77→  if (!parentPath) return undefined;
    78→
    79→  // Find item with matching path in the same source file
    80→  return allItems.find(
    81→    i => i._path === parentPath && i._sourceFile === item._sourceFile
    82→  );
    83→}
    84→
    85→/**
    86→ * Get direct children of a spec item.
    87→ * Only returns immediate children, not grandchildren.
    88→ */
    89→function getDirectChildren(
    90→  parent: LoadedSpecItem,
    91→  allItems: LoadedSpecItem[]
    92→): LoadedSpecItem[] {
    93→  return allItems.filter(
    94→    item => item._sourceFile === parent._sourceFile && isDirectChildOf(item, parent)
    95→  );
    96→}
    97→
    98→/**
    99→ * Collect an item and all its descendants in topological order (parent first).
   100→ * This ensures parent tasks are created before child tasks.
   101→ */
   102→function collectItemsRecursively(
   103→  root: LoadedSpecItem,
   104→  allItems: LoadedSpecItem[]
   105→): LoadedSpecItem[] {
   106→  const result: LoadedSpecItem[] = [root];
   107→  const children = getDirectChildren(root, allItems);
   108→
   109→  for (const child of children) {
   110→    const descendants = collectItemsRecursively(child, allItems);
   111→    result.push(...descendants);
   112→  }
   113→
   114→  return result;
   115→}
   116→
   117→/**
   118→ * Resolve a spec item reference.
   119→ * Returns the spec item or exits with error.
   120→ */
   121→function resolveSpecRef(
   122→  ref: string,
   123→  items: LoadedSpecItem[],
   124→  tasks: LoadedTask[],
   125→  index: ReferenceIndex
   126→): LoadedSpecItem {
   127→  const result = index.resolve(ref);
   128→
   129→  if (!result.ok) {
   130→    switch (result.error) {
   131→      case 'not_found':
   132→        error(errors.reference.specNotFound(ref));
   133→        break;
   134→      case 'ambiguous':
   135→        error(errors.reference.ambiguous(ref));
   136→        for (const candidate of result.candidates) {
   137→          const item = items.find(i => i._ulid === candidate);
   138→          const slug = item?.slugs[0] || '';
   139→          console.error(`  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ''}`);
   140→        }
   141→        break;
   142→      case 'duplicate_slug':
   143→        error(errors.reference.slugMapsToMultiple(ref));
   144→        for (const candidate of result.candidates) {
   145→          console.error(`  - ${index.shortUlid(candidate)}`);
   146→        }
   147→        break;
   148→    }
   149→    process.exit(EXIT_CODES.NOT_FOUND);
   150→  }
   151→
   152→  // Check if it's actually a spec item (not a task)
   153→  const item = items.find(i => i._ulid === result.ulid);
   154→  if (!item) {
   155→    // Check if it's a task
   156→    const task = tasks.find(t => t._ulid === result.ulid);
   157→    if (task) {
   158→      error(errors.reference.notSpecItem(ref));
   159→    } else {
   160→      error(errors.reference.specNotFound(ref));
   161→    }
   162→    process.exit(EXIT_CODES.NOT_FOUND);
   163→  }
   164→
   165→  return item;
   166→}
   167→
   168→/**
   169→ * Generate a slug from a spec item title.
   170→ * Converts "My Feature Title" -> "task-my-feature-title"
   171→ */
   172→function generateSlugFromTitle(title: string): string {
   173→  return (
   174→    'task-' +
   175→    title
   176→      .toLowerCase()
   177→      .replace(/[^a-z0-9]+/g, '-')
   178→      .replace(/^-|-$/g, '')
   179→      .slice(0, 50)
   180→  );
   181→}
   182→
   183→/**
   184→ * Convert spec priority to task priority (number).
   185→ * Spec can use 'high', 'medium', 'low' or numeric 1-5.
   186→ */
   187→function normalizePriority(priority: string | number | undefined): number {
   188→  if (priority === undefined) return 3;
   189→  if (typeof priority === 'number') return priority;
   190→  switch (priority) {
   191→    case 'high':
   192→      return 1;
   193→    case 'medium':
   194→      return 3;
   195→    case 'low':
   196→      return 5;
   197→    default:
   198→      return 3;
   199→  }
   200→}
   201→
   202→/**
   203→ * Result of deriving a task from a spec item
   204→ */
   205→interface DeriveResult {
   206→  specItem: LoadedSpecItem;
   207→  action: 'created' | 'skipped' | 'would_create';
   208→  task?: LoadedTask;
   209→  reason?: string;
   210→  /** Task ref that was used for depends_on (if any) */
   211→  dependsOn?: string[];
   212→}
   213→
   214→/**
   215→ * Generate implementation notes from spec item for newly derived task.
   216→ * Includes description and acceptance criteria summary.
   217→ */
   218→function generateImplementationNotes(specItem: LoadedSpecItem): string | undefined {
   219→  const parts: string[] = [];
   220→
   221→  // Add description if present
   222→  if (specItem.description) {
   223→    parts.push(specItem.description.trim());
   224→  }
   225→
   226→  // Add acceptance criteria summary if present
   227→  if (specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
   228→    const acSection = ['', 'Acceptance Criteria:'];
   229→    for (const ac of specItem.acceptance_criteria) {
   230→      const summary = `${ac.given ? 'Given ' + ac.given + ', ' : ''}when ${ac.when}, then ${ac.then}`;
   231→      acSection.push(`- ${ac.id}: ${summary}`);
   232→    }
   233→    parts.push(acSection.join('\n'));
   234→  }
   235→
   236→  // Return combined content, or undefined if nothing to add
   237→  return parts.length > 0 ? parts.join('\n\n') : undefined;
   238→}
   239→
   240→/**
   241→ * Derive a task from a spec item.
   242→ * Returns result describing what happened.
   243→ *
   244→ * @param dependsOn - Task references to add as dependencies (for hierarchy-based deps)
   245→ * @param priority - Priority override (1-5), if not provided uses spec's priority
   246→ */
   247→async function deriveTaskFromSpec(
   248→  ctx: KspecContext,
   249→  specItem: LoadedSpecItem,
   250→  existingTasks: LoadedTask[],
   251→  items: LoadedSpecItem[],
   252→  index: ReferenceIndex,
   253→  alignmentIndex: AlignmentIndex,
   254→  options: { force: boolean; dryRun: boolean; dependsOn?: string[]; priority?: number }
   255→): Promise<DeriveResult> {
   256→  // Check if a task already exists for this spec
   257→  const linkedTasks = alignmentIndex.getTasksForSpec(specItem._ulid);
   258→
   259→  if (linkedTasks.length > 0 && !options.force) {
   260→    const taskRef = linkedTasks[0].slugs[0]
   261→      ? `@${linkedTasks[0].slugs[0]}`
   262→      : `@${index.shortUlid(linkedTasks[0]._ulid)}`;
   263→    return {
   264→      specItem,
   265→      action: 'skipped',
   266→      task: linkedTasks[0],
   267→      reason: `task exists: ${taskRef}`,
   268→    };
   269→  }
   270→
   271→  // Check if slug would collide with existing task
   272→  const baseSlug = generateSlugFromTitle(specItem.title);
   273→  let slug = baseSlug;
   274→  let slugSuffix = 1;
   275→
   276→  // Find unique slug if needed
   277→  while (existingTasks.some(t => t.slugs.includes(slug))) {
   278→    slug = `${baseSlug}-${slugSuffix}`;
   279→    slugSuffix++;
   280→  }
   281→
   282→  // Generate implementation notes from spec
   283→  const noteContent = generateImplementationNotes(specItem);
   284→  const initialNotes = noteContent
   285→    ? [createNote(`Implementation notes (auto-generated from spec):\n\n${noteContent}`, '@kspec-derive')]
   286→    : [];
   287→
   288→  // Build task input with depends_on and initial notes
   289→  const taskInput: TaskInput = {
   290→    title: `Implement: ${specItem.title}`,
   291→    type: 'task',
   292→    spec_ref: `@${specItem.slugs[0] || specItem._ulid}`,
   293→    derivation: 'auto',
   294→    priority: options.priority ?? normalizePriority(specItem.priority),
   295→    slugs: [slug],
   296→    tags: [...(specItem.tags || [])],
   297→    depends_on: options.dependsOn || [],
   298→    notes: initialNotes,
   299→  };
   300→
   301→  // Dry run - don't actually create
   302→  if (options.dryRun) {
   303→    const previewTask = createTask(taskInput) as LoadedTask;
   304→    return {
   305→      specItem,
   306→      action: 'would_create',
   307→      task: previewTask,
   308→      dependsOn: options.dependsOn,
   309→    };
   310→  }
   311→
   312→  // Create and save the task
   313→  const newTask = createTask(taskInput);
   314→  await saveTask(ctx, newTask);
   315→  const specSlug = specItem.slugs[0] || specItem._ulid.slice(0, 8);
   316→  await commitIfShadow(ctx.shadow, 'derive', specSlug);
   317→
   318→  // Add to existing tasks list for slug collision checks
   319→  existingTasks.push(newTask as LoadedTask);
   320→
   321→  return {
   322→    specItem,
   323→    action: 'created',
   324→    task: newTask as LoadedTask,
   325→    dependsOn: options.dependsOn,
   326→  };
   327→}
   328→
   329→/**
   330→ * Get a task reference string for use in depends_on.
   331→ * Prefers slug over ULID for readability.
   332→ */
   333→function getTaskRef(task: LoadedTask, index: ReferenceIndex): string {
   334→  return task.slugs[0] ? `@${task.slugs[0]}` : `@${index.shortUlid(task._ulid)}`;
   335→}
   336→
   337→/**
   338→ * Find or get the task for a parent spec item.
   339→ * Looks in:
   340→ * 1. Tasks created in this derive session (specToTaskMap)
   341→ * 2. Existing tasks linked to the parent spec (alignmentIndex)
   342→ */
   343→function getParentTaskRef(
   344→  parentSpec: LoadedSpecItem,
   345→  specToTaskMap: Map<string, LoadedTask>,
   346→  alignmentIndex: AlignmentIndex,
   347→  index: ReferenceIndex
   348→): string | undefined {
   349→  // Check if we created a task for this parent in this session
   350→  const sessionTask = specToTaskMap.get(parentSpec._ulid);
   351→  if (sessionTask) {
   352→    return getTaskRef(sessionTask, index);
   353→  }
   354→
   355→  // Check if an existing task is linked to this parent spec
   356→  const linkedTasks = alignmentIndex.getTasksForSpec(parentSpec._ulid);
   357→  if (linkedTasks.length > 0) {
   358→    return getTaskRef(linkedTasks[0], index);
   359→  }
   360→
   361→  return undefined;
   362→}
   363→
   364→/**
   365→ * Register the 'derive' command
   366→ */
   367→export function registerDeriveCommand(program: Command): void {
   368→  program
   369→    .command('derive [ref]')
   370→    .description('Create task(s) from spec item(s)')
   371→    .option('--all', 'Derive tasks for all spec items without linked tasks')
   372→    .option('--flat', 'Only derive for the specified item, not children (default: recursive)')
   373→    .option('--force', 'Create task even if one already exists for the spec')
   374→    .option('--dry-run', 'Show what would be created without making changes')
   375→    .option('--priority <n>', 'Set priority for created task(s) (1-5)', parseInt)
   376→    .action(async (ref: string | undefined, options) => {
   377→      try {
   378→        // Validate arguments
   379→        if (!ref && !options.all) {
   380→          error(errors.usage.deriveNoRef);
   381→          console.error('Usage:');
   382→          console.error('  kspec derive @spec-ref');
   383→          console.error('  kspec derive @spec-ref --flat');
   384→          console.error('  kspec derive --all');
   385→          process.exit(EXIT_CODES.USAGE_ERROR);
   386→        }
   387→
   388→        if (ref && options.all) {
   389→          error(errors.usage.deriveRefAndAll);
   390→          process.exit(EXIT_CODES.USAGE_ERROR);
   391→        }
   392→
   393→        // Validate priority if provided
   394→        if (options.priority !== undefined) {
   395→          if (isNaN(options.priority) || options.priority < 1 || options.priority > 5) {
   396→            error('Priority must be a number between 1 and 5');
   397→            process.exit(EXIT_CODES.USAGE_ERROR);
   398→          }
   399→        }
   400→
   401→        const ctx = await initContext();
   402→        const tasks = await loadAllTasks(ctx);
   403→        const items = await loadAllItems(ctx);
   404→        const index = new ReferenceIndex(tasks, items);
   405→
   406→        // Build alignment index
   407→        const alignmentIndex = new AlignmentIndex(tasks, items);
   408→        alignmentIndex.buildLinks(index);
   409→
   410→        // Collect spec items to process
   411→        let specsToDerive: LoadedSpecItem[];
   412→
   413→        if (options.all) {
   414→          // Get all spec items without linked tasks
   415→          specsToDerive = items.filter(item => {
   416→            const linkedTasks = alignmentIndex.getTasksForSpec(item._ulid);
   417→            return linkedTasks.length === 0 || options.force;
   418→          });
   419→
   420→          if (specsToDerive.length === 0) {
   421→            if (isJsonMode()) {
   422→              console.log(JSON.stringify([]));
   423→            } else {
   424→              info('Nothing to derive (all items have tasks)');
   425→            }
   426→            return;
   427→          }
   428→        } else {
   429→          // Single spec item - recursive by default, flat if --flat
   430→          const specItem = resolveSpecRef(ref!, items, tasks, index);
   431→
   432→          if (options.flat) {
   433→            specsToDerive = [specItem];
   434→          } else {
   435→            // Recursive: collect item and all descendants
   436→            specsToDerive = collectItemsRecursively(specItem, items);
   437→          }
   438→        }
   439→
   440→        // Track spec ULID -> created task for dependency resolution
   441→        const specToTaskMap = new Map<string, LoadedTask>();
   442→
   443→        // Process each spec item in order (parents before children due to topological sort)
   444→        const results: DeriveResult[] = [];
   445→
   446→        for (const specItem of specsToDerive) {
   447→          // Determine depends_on based on parent spec's task
   448→          let dependsOn: string[] | undefined;
   449→
   450→          if (!options.flat && !options.all) {
   451→            // Find the parent spec item
   452→            const parentSpec = findParentItem(specItem, items);
   453→
   454→            if (parentSpec) {
   455→              const parentTaskRef = getParentTaskRef(
   456→                parentSpec,
   457→                specToTaskMap,
   458→                alignmentIndex,
   459→                index
   460→              );
   461→              if (parentTaskRef) {
   462→                dependsOn = [parentTaskRef];
   463→              }
   464→            }
   465→          }
   466→
   467→          const result = await deriveTaskFromSpec(
   468→            ctx,
   469→            specItem,
   470→            tasks,
   471→            items,
   472→            index,
   473→            alignmentIndex,
   474→            {
   475→              force: options.force || false,
   476→              dryRun: options.dryRun || false,
   477→              dependsOn,
   478→              priority: options.priority,
   479→            }
   480→          );
   481→
   482→          // Track created/would_create tasks for dependency resolution
   483→          if (result.task && (result.action === 'created' || result.action === 'would_create')) {
   484→            specToTaskMap.set(specItem._ulid, result.task);
   485→          }
   486→          // Also track skipped tasks (existing) for dependency resolution
   487→          if (result.action === 'skipped' && result.task) {
   488→            specToTaskMap.set(specItem._ulid, result.task);
   489→          }
   490→
   491→          results.push(result);
   492→        }
   493→
   494→        // Output results
   495→        if (isJsonMode()) {
   496→          // JSON output format - simplified per AC
   497→          const jsonOutput = results.map(r => ({
   498→            ulid: r.task?._ulid || null,
   499→            slug: r.task?.slugs[0] || null,
   500→            spec_ref: `@${r.specItem.slugs[0] || r.specItem._ulid}`,
   501→            depends_on: r.task?.depends_on || [],
   502→            action: r.action,
   503→          }));
   504→          console.log(JSON.stringify(jsonOutput, null, 2));
   505→          return; // Don't call output() which would output full results in global JSON mode
   506→        } else {
   507→          // Human-readable output
   508→          output(results, () => {
   509→            const created = results.filter(r => r.action === 'created');
   510→            const skipped = results.filter(r => r.action === 'skipped');
   511→            const wouldCreate = results.filter(r => r.action === 'would_create');
   512→
   513→            if (options.dryRun) {
   514→              console.log('Would create:');
   515→              for (const r of wouldCreate) {
   516→                const taskSlug = r.task?.slugs[0] || '';
   517→                const deps = r.dependsOn?.length ? ` (depends: ${r.dependsOn.join(', ')})` : '';
   518→                console.log(`  + ${r.specItem.title}`);
   519→                console.log(`    -> ${taskSlug}${deps}`);
   520→              }
   521→              if (skipped.length > 0) {
   522→                console.log('\nSkipped:');
   523→                for (const r of skipped) {
   524→                  const specRef = r.specItem.slugs[0] ? `@${r.specItem.slugs[0]}` : `@${index.shortUlid(r.specItem._ulid)}`;
   525→                  console.log(`  - ${specRef} (${r.reason})`);
   526→                }
   527→              }
   528→              console.log(`\nWould create ${wouldCreate.length} task(s)`);
   529→              if (skipped.length > 0) {
   530→                console.log(`Skipped ${skipped.length} (already have tasks)`);
   531→              }
   532→              return;
   533→            }
   534→
   535→            if (created.length > 0) {
   536→              for (const r of created) {
   537→                const taskSlug = r.task?.slugs[0] || '';
   538→                const deps = r.dependsOn?.length ? ` (depends: ${r.dependsOn.join(', ')})` : '';
   539→                console.log(`OK Created task: ${taskSlug}${deps}`);
   540→              }
   541→            }
   542→
   543→            if (skipped.length > 0 && !options.all) {
   544→              // Show skipped for explicit derive (not --all)
   545→              for (const r of skipped) {
   546→                const specRef = r.specItem.slugs[0] ? `@${r.specItem.slugs[0]}` : `@${index.shortUlid(r.specItem._ulid)}`;
   547→                console.log(`Skipped ${specRef} (${r.reason})`);
   548→              }
   549→            }
   550→
   551→            // Summary
   552→            if (created.length > 0 || skipped.length > 0) {
   553→              console.log('');
   554→              if (created.length > 0) {
   555→                console.log(`Created ${created.length} task(s)`);
   556→              }
   557→              if (skipped.length > 0) {
   558→                console.log(`Skipped ${skipped.length} (already have tasks)`);
   559→              }
   560→            }
   561→          });
   562→        }
   563→      } catch (err) {
   564→        error(errors.failures.deriveTasks, err);
   565→        process.exit(EXIT_CODES.ERROR);
   566→      }
   567→    });
   568→}
   569→

