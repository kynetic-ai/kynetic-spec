  1000→
  1001→  // Create subcommand group for acceptance criteria operations
  1002→  const acCmd = item
  1003→    .command('ac')
  1004→    .description('Manage acceptance criteria on spec items');
  1005→
  1006→  // Helper: Generate next AC ID based on existing AC
  1007→  function generateNextAcId(existingAc: AcceptanceCriterion[] | undefined): string {
  1008→    if (!existingAc || existingAc.length === 0) return 'ac-1';
  1009→
  1010→    const numericIds = existingAc
  1011→      .map(ac => ac.id.match(/^ac-(\d+)$/)?.[1])
  1012→      .filter((id): id is string => id !== null && id !== undefined)
  1013→      .map(Number);
  1014→
  1015→    const maxId = numericIds.length > 0 ? Math.max(...numericIds) : 0;
  1016→    return `ac-${maxId + 1}`;
  1017→  }
  1018→
  1019→  // Helper: Resolve ref to spec item (not task)
  1020→  async function resolveSpecItem(ref: string): Promise<{ ctx: Awaited<ReturnType<typeof initContext>>; item: LoadedSpecItem; refIndex: ReferenceIndex }> {
  1021→    const ctx = await initContext();
  1022→    const { refIndex, items } = await buildIndexes(ctx);
  1023→
  1024→    const result = refIndex.resolve(ref);
  1025→    if (!result.ok) {
  1026→      error(errors.reference.itemNotFound(ref));
  1027→      process.exit(EXIT_CODES.NOT_FOUND);
  1028→    }
  1029→
  1030→    const foundItem = result.item as LoadedSpecItem;
  1031→
  1032→    // Check if it's a task
  1033→    if ('status' in foundItem && typeof foundItem.status === 'string') {
  1034→      error(errors.operation.tasksNoAcceptanceCriteria(ref));
  1035→      process.exit(EXIT_CODES.NOT_FOUND);
  1036→    }
  1037→
  1038→    return { ctx, item: foundItem, refIndex };
  1039→  }
  1040→
  1041→  // kspec item ac list <ref>
  1042→  acCmd
  1043→    .command('list <ref>')
  1044→    .description('List acceptance criteria for a spec item')
  1045→    .action(async (ref: string) => {
  1046→      try {
  1047→        const { item, refIndex } = await resolveSpecItem(ref);
  1048→        const ac = item.acceptance_criteria || [];
  1049→
  1050→        output(ac, () => {
  1051→          console.log(chalk.bold(`Acceptance Criteria for: ${item.title} (@${item.slugs[0] || refIndex.shortUlid(item._ulid)})`));
  1052→          console.log();
  1053→
  1054→          if (ac.length === 0) {
  1055→            console.log(chalk.gray('No acceptance criteria'));
  1056→          } else {
  1057→            for (const criterion of ac) {
  1058→              console.log(chalk.cyan(`  [${criterion.id}]`));
  1059→              console.log(chalk.gray(`    Given: ${criterion.given}`));
  1060→              console.log(chalk.gray(`    When:  ${criterion.when}`));
  1061→              console.log(chalk.gray(`    Then:  ${criterion.then}`));
  1062→              console.log();
  1063→            }
  1064→          }
  1065→
  1066→          console.log(chalk.gray(`${ac.length} acceptance criteria`));
  1067→        });
  1068→      } catch (err) {
  1069→        error(errors.failures.listAc, err);
  1070→        process.exit(EXIT_CODES.ERROR);
  1071→      }
  1072→    });
  1073→
  1074→  // kspec item ac add <ref>
  1075→  acCmd
  1076→    .command('add <ref>')
  1077→    .description('Add an acceptance criterion to a spec item')
  1078→    .option('--id <id>', 'AC identifier (auto-generated if not provided)')
  1079→    .requiredOption('--given <text>', 'The precondition (Given...)')
  1080→    .requiredOption('--when <text>', 'The action/trigger (When...)')
  1081→    .requiredOption('--then <text>', 'The expected outcome (Then...)')
  1082→    .action(async (ref: string, options) => {
  1083→      try {
  1084→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1085→        const existingAc = item.acceptance_criteria || [];
  1086→
  1087→        // Determine ID
  1088→        const acId = options.id || generateNextAcId(existingAc);
  1089→
  1090→        // Check for duplicate ID
  1091→        if (existingAc.some(ac => ac.id === acId)) {
  1092→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1093→          error(errors.conflict.acAlreadyExists(acId, itemRef));
  1094→          process.exit(EXIT_CODES.CONFLICT);
  1095→        }
  1096→
  1097→        // Create new AC
  1098→        const newAc: AcceptanceCriterion = {
  1099→          id: acId,
  1100→          given: options.given,
  1101→          when: options.when,
  1102→          then: options.then,
  1103→        };
  1104→
  1105→        // Update item with new AC
  1106→        const updatedAc = [...existingAc, newAc];
  1107→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1108→
  1109→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1110→        await commitIfShadow(ctx.shadow, 'item-ac-add', itemSlug);
  1111→        success(`Added acceptance criterion: ${acId} to @${itemSlug}`, { ac: newAc });
  1112→      } catch (err) {
  1113→        error(errors.failures.addAc, err);
  1114→        process.exit(EXIT_CODES.ERROR);
  1115→      }
  1116→    });
  1117→
  1118→  // kspec item ac set <ref> <ac-id>
  1119→  acCmd
  1120→    .command('set <ref> <acId>')
  1121→    .description('Update an acceptance criterion')
  1122→    .option('--id <newId>', 'Rename the AC ID')
  1123→    .option('--given <text>', 'Update the precondition')
  1124→    .option('--when <text>', 'Update the action/trigger')
  1125→    .option('--then <text>', 'Update the expected outcome')
  1126→    .action(async (ref: string, acId: string, options) => {
  1127→      try {
  1128→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1129→        const existingAc = item.acceptance_criteria || [];
  1130→
  1131→        // Find the AC
  1132→        const acIndex = existingAc.findIndex(ac => ac.id === acId);
  1133→        if (acIndex === -1) {
  1134→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1135→          error(errors.reference.acNotFound(acId, itemRef));
  1136→          process.exit(EXIT_CODES.NOT_FOUND);
  1137→        }
  1138→
  1139→        // Check for no updates
  1140→        if (!options.id && !options.given && !options.when && !options.then) {
  1141→          warn('No updates specified');
  1142→          return;
  1143→        }
  1144→
  1145→        // Check for duplicate ID if renaming
  1146→        if (options.id && options.id !== acId && existingAc.some(ac => ac.id === options.id)) {
  1147→          error(errors.conflict.acIdAlreadyExists(options.id));
  1148→          process.exit(EXIT_CODES.CONFLICT);
  1149→        }
  1150→
  1151→        // Build updated AC
  1152→        const updatedAc = [...existingAc];
  1153→        const updatedFields: string[] = [];
  1154→
  1155→        updatedAc[acIndex] = {
  1156→          ...updatedAc[acIndex],
  1157→          ...(options.id && { id: options.id }),
  1158→          ...(options.given && { given: options.given }),
  1159→          ...(options.when && { when: options.when }),
  1160→          ...(options.then && { then: options.then }),
  1161→        };
  1162→
  1163→        if (options.id) updatedFields.push('id');
  1164→        if (options.given) updatedFields.push('given');
  1165→        if (options.when) updatedFields.push('when');
  1166→        if (options.then) updatedFields.push('then');
  1167→
  1168→        // Update item
  1169→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1170→
  1171→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1172→        await commitIfShadow(ctx.shadow, 'item-ac-set', itemSlug);
  1173→        success(`Updated acceptance criterion: ${acId} on @${itemSlug} (${updatedFields.join(', ')})`, { ac: updatedAc[acIndex] });
  1174→      } catch (err) {
  1175→        error(errors.failures.updateAc, err);
  1176→        process.exit(EXIT_CODES.ERROR);
  1177→      }
  1178→    });
  1179→
  1180→  // kspec item ac remove <ref> <ac-id>
  1181→  acCmd
  1182→    .command('remove <ref> <acId>')
  1183→    .description('Remove an acceptance criterion')
  1184→    .option('--force', 'Skip confirmation')
  1185→    .action(async (ref: string, acId: string, options) => {
  1186→      try {
  1187→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1188→        const existingAc = item.acceptance_criteria || [];
  1189→
  1190→        // Find the AC
  1191→        const acIndex = existingAc.findIndex(ac => ac.id === acId);
  1192→        if (acIndex === -1) {
  1193→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1194→          error(errors.reference.acNotFound(acId, itemRef));
  1195→          process.exit(EXIT_CODES.NOT_FOUND);
  1196→        }
  1197→
  1198→        // TODO: Add confirmation prompt when !options.force
  1199→        // For now, proceed with deletion
  1200→
  1201→        // Remove the AC
  1202→        const updatedAc = existingAc.filter(ac => ac.id !== acId);
  1203→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1204→
  1205→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1206→        await commitIfShadow(ctx.shadow, 'item-ac-remove', itemSlug);
  1207→        success(`Removed acceptance criterion: ${acId} from @${itemSlug}`, { removed: acId });
  1208→      } catch (err) {
  1209→        error(errors.failures.removeAc, err);
  1210→        process.exit(EXIT_CODES.ERROR);
  1211→      }
  1212→    });
  1213→}
  1214→
  1215→// ─── Patch Helpers ───────────────────────────────────────────────────────────
  1216→
  1217→/**
  1218→ * Read stdin fully with timeout (for bulk input).
  1219→ * Returns null if stdin is a TTY or empty.
  1220→ */
  1221→async function readStdinFully(): Promise<string | null> {
  1222→  if (process.stdin.isTTY) {
  1223→    return null;
  1224→  }
  1225→
  1226→  return new Promise((resolve) => {
  1227→    let data = '';
  1228→    const timeout = setTimeout(() => {
  1229→      process.stdin.removeAllListeners();
  1230→      resolve(data || null);
  1231→    }, 5000); // 5 second timeout for bulk input
  1232→
  1233→    process.stdin.setEncoding('utf8');
  1234→    process.stdin.on('data', (chunk) => {
  1235→      data += chunk;
  1236→    });
  1237→    process.stdin.on('end', () => {
  1238→      clearTimeout(timeout);
  1239→      resolve(data || null);
  1240→    });
  1241→    process.stdin.on('error', () => {
  1242→      clearTimeout(timeout);
  1243→      resolve(null);
  1244→    });
  1245→    process.stdin.resume();
  1246→  });
  1247→}
  1248→
  1249→/**
  1250→ * Read stdin if available (non-blocking for single item mode).
  1251→ * Returns null quickly if no data available.
  1252→ */
  1253→async function readStdinIfAvailable(): Promise<string | null> {
  1254→  if (process.stdin.isTTY) {
  1255→    return null;
  1256→  }
  1257→
  1258→  return new Promise((resolve) => {
  1259→    let data = '';
  1260→    const timeout = setTimeout(() => {
  1261→      process.stdin.removeAllListeners();
  1262→      resolve(data || null);
  1263→    }, 100); // 100ms timeout for quick check
  1264→
  1265→    process.stdin.setEncoding('utf8');
  1266→    process.stdin.on('data', (chunk) => {
  1267→      data += chunk;
  1268→    });
  1269→    process.stdin.on('end', () => {
  1270→      clearTimeout(timeout);
  1271→      resolve(data || null);
  1272→    });
  1273→    process.stdin.on('error', () => {
  1274→      clearTimeout(timeout);
  1275→      resolve(null);
  1276→    });
  1277→    process.stdin.resume();
  1278→  });
  1279→}
  1280→
  1281→/**
  1282→ * Parse bulk input (JSONL or JSON array)
  1283→ */
  1284→function parseBulkInput(input: string): PatchOperation[] {
  1285→  const trimmed = input.trim();
  1286→
  1287→  // Try JSON array first
  1288→  if (trimmed.startsWith('[')) {
  1289→    const parsed = JSON.parse(trimmed);
  1290→    if (!Array.isArray(parsed)) {
  1291→      throw new Error(errors.validation.expectedJsonArray);
  1292→    }
  1293→    return parsed.map((item, i) => validatePatchOperation(item, i));
  1294→  }
  1295→
  1296→  // Parse as JSONL (one JSON object per line)
  1297→  const lines = trimmed.split('\n').filter(line => line.trim());
  1298→  return lines.map((line, i) => {
  1299→    try {
  1300→      return validatePatchOperation(JSON.parse(line), i);
  1301→    } catch (err) {
  1302→      throw new Error(errors.validation.jsonLineError(i + 1, err instanceof Error ? err.message : 'Invalid JSON'));
  1303→    }
  1304→  });
  1305→}
  1306→
  1307→/**
  1308→ * Validate a patch operation object
  1309→ */
  1310→function validatePatchOperation(obj: unknown, index: number): PatchOperation {
  1311→  if (!obj || typeof obj !== 'object') {
  1312→    throw new Error(errors.validation.patchMustBeObject(index));
  1313→  }
  1314→  const op = obj as Record<string, unknown>;
  1315→  if (typeof op.ref !== 'string' || !op.ref) {
  1316→    throw new Error(errors.validation.patchMustHaveRef(index));
  1317→  }
  1318→  if (!op.data || typeof op.data !== 'object') {
  1319→    throw new Error(errors.validation.patchMustHaveData(index));
  1320→  }
  1321→  return { ref: op.ref, data: op.data as Record<string, unknown> };
  1322→}
  1323→
  1324→/**
  1325→ * Format bulk patch result for human output
  1326→ */
  1327→function formatBulkPatchResult(result: BulkPatchResult, isDryRun = false): void {
  1328→  const prefix = isDryRun ? 'Would patch' : 'Patched';
  1329→
  1330→  for (const r of result.results) {
  1331→    if (r.status === 'updated') {
  1332→      console.log(chalk.green('OK'), `${prefix}: ${r.ref} (${r.ulid?.slice(0, 8)})`);
  1333→    } else if (r.status === 'error') {
  1334→      console.log(chalk.red('ERR'), `${r.ref}: ${r.error}`);
  1335→    } else {
  1336→      console.log(chalk.gray('SKIP'), r.ref);
  1337→    }
  1338→  }
  1339→
  1340→  console.log('');
  1341→  console.log(chalk.bold('Summary:'));
  1342→  console.log(`  Total: ${result.summary.total}`);
  1343→  console.log(chalk.green(`  Updated: ${result.summary.updated}`));
  1344→  if (result.summary.failed > 0) {
  1345→    console.log(chalk.red(`  Failed: ${result.summary.failed}`));
  1346→  }
  1347→  if (result.summary.skipped > 0) {
  1348→    console.log(chalk.gray(`  Skipped: ${result.summary.skipped}`));
  1349→  }
  1350→}
  1351→

