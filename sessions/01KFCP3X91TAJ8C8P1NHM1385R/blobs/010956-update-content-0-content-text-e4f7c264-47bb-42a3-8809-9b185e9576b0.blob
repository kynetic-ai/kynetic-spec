   467→
   468→  // kspec item add - create a new spec item under a parent
   469→  item
   470→    .command('add')
   471→    .description('Create a new spec item under a parent')
   472→    .requiredOption('--under <ref>', 'Parent item reference (e.g., @core-primitives)')
   473→    .requiredOption('--title <title>', 'Item title')
   474→    .option('--type <type>', 'Item type (feature, requirement, constraint, decision)', 'feature')
   475→    .option('--slug <slug>', 'Human-friendly slug')
   476→    .option('--priority <priority>', 'Priority (high, medium, low)')
   477→    .option('--tag <tag...>', 'Tags')
   478→    .option('--description <desc>', 'Description')
   479→    .option('--as <field>', 'Child field override (e.g., requirements, constraints)')
   480→    .action(async (options) => {
   481→      try {
   482→        const ctx = await initContext();
   483→        const { refIndex, items } = await buildIndexes(ctx);
   484→
   485→        // Find the parent item
   486→        const parentResult = refIndex.resolve(options.under);
   487→        if (!parentResult.ok) {
   488→          error(errors.reference.itemNotFound(options.under));
   489→          process.exit(EXIT_CODES.ERROR);
   490→        }
   491→
   492→        const parent = parentResult.item as LoadedSpecItem;
   493→
   494→        // Check it's not a task
   495→        if ('status' in parent && typeof parent.status === 'string') {
   496→          error(errors.reference.parentIsTask(options.under));
   497→          process.exit(EXIT_CODES.ERROR);
   498→        }
   499→
   500→        // Check slug uniqueness if provided
   501→        if (options.slug) {
   502→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   503→          if (!slugCheck.ok) {
   504→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   505→            process.exit(EXIT_CODES.CONFLICT);
   506→          }
   507→        }
   508→
   509→        const input: SpecItemInput = {
   510→          title: options.title,
   511→          type: options.type as ItemType,
   512→          slugs: options.slug ? [options.slug] : [],
   513→          priority: options.priority,
   514→          tags: options.tag || [],
   515→          description: options.description,
   516→          depends_on: [],
   517→          implements: [],
   518→          relates_to: [],
   519→          tests: [],
   520→          traits: [],
   521→          notes: [],
   522→        };
   523→
   524→        const newItem = createSpecItem(input);
   525→        const result = await addChildItem(ctx, parent, newItem, options.as);
   526→
   527→        // Build index including the new item for accurate short ULID
   528→        const index = new ReferenceIndex([], [...items, result.item as LoadedSpecItem]);
   529→        const itemSlug = (result.item as LoadedSpecItem).slugs?.[0] || index.shortUlid(result.item._ulid);
   530→        await commitIfShadow(ctx.shadow, 'item-add', itemSlug);
   531→        success(`Created item: ${index.shortUlid(result.item._ulid)} under @${parent.slugs[0] || parent._ulid.slice(0, 8)}`, {
   532→          item: result.item,
   533→          path: result.path,
   534→        });
   535→
   536→        // Derive hint
   537→        if (!isJsonMode()) {
   538→          const refSlug = (result.item as LoadedSpecItem).slugs?.[0] || index.shortUlid(result.item._ulid);
   539→          console.log(chalk.gray(`\nDerive implementation task? kspec derive @${refSlug}`));
   540→        }
   541→      } catch (err) {
   542→        error(errors.failures.createItem, err);
   543→        process.exit(EXIT_CODES.ERROR);
   544→      }
   545→    });
   546→
   547→  // kspec item set - update a spec item field
   548→  item
   549→    .command('set <ref>')
   550→    .description('Update a spec item field')
   551→    .option('--title <title>', 'Set title')
   552→    .option('--type <type>', 'Set type')
   553→    .option('--slug <slug>', 'Add a slug')
   554→    .option('--remove-slug <slug>', 'Remove a slug')
   555→    .option('--priority <priority>', 'Set priority')
   556→    .option('--tag <tag...>', 'Set tags (replaces existing)')
   557→    .option('--description <desc>', 'Set description')
   558→    .option('--status <status>', 'Set implementation status (not_started, in_progress, implemented, verified)')
   559→    .option('--maturity <maturity>', 'Set maturity (draft, proposed, stable, deferred, deprecated)')
   560→    .action(async (ref, options) => {
   561→      try {
   562→        const ctx = await initContext();
   563→        const { refIndex, items } = await buildIndexes(ctx);
   564→
   565→        const result = refIndex.resolve(ref);
   566→        if (!result.ok) {
   567→          error(errors.reference.itemNotFound(ref));
   568→          process.exit(EXIT_CODES.ERROR);
   569→        }
   570→
   571→        const foundItem = result.item as LoadedSpecItem;
   572→
   573→        // Check if it's a task (tasks should use task commands)
   574→        if ('status' in foundItem && typeof foundItem.status === 'string') {
   575→          error(errors.reference.taskUseTaskCommands(ref));
   576→          process.exit(EXIT_CODES.ERROR);
   577→        }
   578→
   579→        // Check slug uniqueness if adding a new slug
   580→        if (options.slug) {
   581→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug], foundItem._ulid);
   582→          if (!slugCheck.ok) {
   583→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   584→            process.exit(EXIT_CODES.CONFLICT);
   585→          }
   586→        }
   587→
   588→        // Validate --remove-slug
   589→        if (options.removeSlug) {
   590→          const currentSlugs = foundItem.slugs || [];
   591→          if (!currentSlugs.includes(options.removeSlug)) {
   592→            error(errors.slug.notFound(options.removeSlug));
   593→            process.exit(EXIT_CODES.ERROR);
   594→          }
   595→          if (currentSlugs.length === 1) {
   596→            error(errors.slug.cannotRemoveLast(options.removeSlug));
   597→            process.exit(EXIT_CODES.ERROR);
   598→          }
   599→        }
   600→
   601→        // Build updates object
   602→        const updates: Partial<SpecItemInput> = {};
   603→
   604→        if (options.title) updates.title = options.title;
   605→        if (options.type) updates.type = options.type as ItemType;
   606→        if (options.slug || options.removeSlug) {
   607→          let slugs = [...(foundItem.slugs || [])];
   608→          if (options.removeSlug) {
   609→            slugs = slugs.filter(s => s !== options.removeSlug);
   610→          }
   611→          if (options.slug) {
   612→            slugs.push(options.slug);
   613→          }
   614→          updates.slugs = slugs;
   615→        }
   616→        if (options.priority) updates.priority = options.priority;
   617→        if (options.tag) updates.tags = options.tag;
   618→        if (options.description) updates.description = options.description;
   619→
   620→        // Handle status updates
   621→        if (options.status || options.maturity) {
   622→          const currentStatus = foundItem.status && typeof foundItem.status === 'object'
   623→            ? foundItem.status
   624→            : {};
   625→          updates.status = {
   626→            ...currentStatus,
   627→            ...(options.status && { implementation: options.status }),
   628→            ...(options.maturity && { maturity: options.maturity }),
   629→          };
   630→        }
   631→
   632→        if (Object.keys(updates).length === 0) {
   633→          warn('No updates specified');
   634→          return;
   635→        }
   636→
   637→        const updated = await updateSpecItem(ctx, foundItem, updates);
   638→        const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   639→
   640→        // Handle cascade for implementation status updates
   641→        const updatedItems: LoadedSpecItem[] = [updated];
   642→        if (options.status) {
   643→          const cascadeResult = await handleStatusCascade(ctx, updated, options.status, items, refIndex);
   644→          updatedItems.push(...cascadeResult);
   645→        }
   646→
   647→        await commitIfShadow(ctx.shadow, 'item-set', itemSlug);
   648→        success(`Updated item: ${refIndex.shortUlid(updated._ulid)}`, { item: updated });
   649→
   650→        // Derive hint
   651→        if (!isJsonMode()) {
   652→          const refSlug = updated.slugs?.[0] || refIndex.shortUlid(updated._ulid);
   653→          console.log(chalk.gray(`\nDerive implementation task? kspec derive @${refSlug}`));
   654→        }
   655→      } catch (err) {
   656→        error(errors.failures.updateItem, err);
   657→        process.exit(EXIT_CODES.ERROR);
   658→      }
   659→    });
   660→
   661→  // kspec item delete - delete a spec item
   662→  item
   663→    .command('delete <ref>')
   664→    .description('Delete a spec item (including nested items)')
   665→    .option('--force', 'Skip confirmation')
   666→    .action(async (ref, options) => {
   667→      try {
   668→        const ctx = await initContext();
   669→        const { refIndex, items } = await buildIndexes(ctx);
   670→
   671→        const result = refIndex.resolve(ref);
   672→        if (!result.ok) {
   673→          error(errors.reference.itemNotFound(ref));
   674→          process.exit(EXIT_CODES.ERROR);
   675→        }
   676→
   677→        const foundItem = result.item as LoadedSpecItem;
   678→
   679→        // Check if it's a task
   680→        if ('status' in foundItem && typeof foundItem.status === 'string') {
   681→          error(errors.reference.itemUseTaskCancel(ref));
   682→          process.exit(EXIT_CODES.ERROR);
   683→        }
   684→
   685→        if (!foundItem._sourceFile) {
   686→          error(errors.operation.cannotDeleteNoSource);
   687→          process.exit(EXIT_CODES.ERROR);
   688→        }
   689→
   690→        // Warn about nested children being deleted too
   691→        // TODO: could add a check here for child items
   692→
   693→        const deleted = await deleteSpecItem(ctx, foundItem);
   694→        if (deleted) {
   695→          const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   696→          await commitIfShadow(ctx.shadow, 'item-delete', itemSlug);
   697→          success(`Deleted item: ${foundItem.title}`, { deleted: true, ulid: foundItem._ulid });
   698→        } else {
   699→          error(errors.failures.deleteItem);
   700→          console.log(chalk.gray('Edit the source file directly: ' + foundItem._sourceFile));
   701→          process.exit(EXIT_CODES.ERROR);
   702→        }
   703→      } catch (err) {
   704→        error(errors.failures.deleteItem, err);
   705→        process.exit(EXIT_CODES.ERROR);
   706→      }
   707→    });
   708→
   709→  // kspec item patch - update item fields via JSON
   710→  item
   711→    .command('patch [ref]')
   712→    .description('Update spec item fields via JSON patch')
   713→    .option('--data <json>', 'JSON data to patch')
   714→    .option('--bulk', 'Read patches from stdin (JSONL or JSON array)')
   715→    .option('--allow-unknown', 'Allow fields not in schema')
   716→    .option('--dry-run', 'Preview changes without applying')
   717→    .option('--fail-fast', 'Stop on first error (bulk mode)')
   718→    .action(async (ref: string | undefined, options) => {
   719→      try {
   720→        const ctx = await initContext();
   721→
   722→        if (options.bulk) {
   723→          // Bulk mode: read from stdin
   724→          const stdin = await readStdinFully();
   725→          if (!stdin) {
   726→            error(errors.validation.noInputProvided);
   727→            process.exit(EXIT_CODES.ERROR);
   728→          }
   729→
   730→          let patches: PatchOperation[];
   731→          try {
   732→            patches = parseBulkInput(stdin);
   733→          } catch (err) {
   734→            error(errors.validation.failedToParseBulk(err instanceof Error ? err.message : String(err)));
   735→            process.exit(EXIT_CODES.ERROR);
   736→          }
   737→
   738→          if (patches.length === 0) {
   739→            error(errors.validation.noPatchesProvided);
   740→            process.exit(EXIT_CODES.ERROR);
   741→          }
   742→
   743→          const { refIndex, items } = await buildIndexes(ctx);
   744→          const result = await patchSpecItems(ctx, refIndex, items, patches, {
   745→            allowUnknown: options.allowUnknown,
   746→            failFast: options.failFast,
   747→            dryRun: options.dryRun,
   748→          });
   749→
   750→          // Shadow commit if any updates
   751→          if (!options.dryRun && result.summary.updated > 0) {
   752→            await commitIfShadow(ctx.shadow, 'item-patch', `${result.summary.updated} items`);
   753→          }
   754→
   755→          output(result, () => formatBulkPatchResult(result, options.dryRun));
   756→
   757→          if (result.summary.failed > 0) {
   758→            process.exit(EXIT_CODES.ERROR);
   759→          }
   760→        } else {
   761→          // Single item mode
   762→          if (!ref) {
   763→            error(errors.usage.patchNeedRef);
   764→            process.exit(EXIT_CODES.ERROR);
   765→          }
   766→
   767→          let data: Record<string, unknown>;
   768→
   769→          // Get data from --data option or stdin
   770→          if (options.data) {
   771→            try {
   772→              data = JSON.parse(options.data);
   773→            } catch (err) {
   774→              error(errors.validation.invalidJsonInData(err instanceof Error ? err.message : ''));
   775→              process.exit(EXIT_CODES.ERROR);
   776→            }
   777→          } else {
   778→            const stdin = await readStdinIfAvailable();
   779→            if (stdin) {
   780→              try {
   781→                data = JSON.parse(stdin.trim());
   782→              } catch (err) {
   783→                error(errors.validation.invalidJsonFromStdin(err instanceof Error ? err.message : ''));
   784→                process.exit(EXIT_CODES.ERROR);
   785→              }
   786→            } else {
   787→              error(errors.validation.noPatchData);
   788→              process.exit(EXIT_CODES.ERROR);
   789→            }
   790→          }
   791→
   792→          // Validate against schema (unless --allow-unknown)
   793→          if (!options.allowUnknown) {
   794→            // Use strict schema (no passthrough)
   795→            const strictSchema = SpecItemPatchSchema.strict();
   796→            const parseResult = strictSchema.safeParse(data);
   797→            if (!parseResult.success) {
   798→              const issues = parseResult.error.issues.map(i => `${i.path.join('.')}: ${i.message}`).join('; ');
   799→              error(errors.validation.invalidPatchDataWithIssues(issues));
   800→              process.exit(EXIT_CODES.ERROR);
   801→            }
   802→          }
   803→
   804→          const { refIndex, items } = await buildIndexes(ctx);
   805→
   806→          // Resolve ref
   807→          const resolved = refIndex.resolve(ref);
   808→          if (!resolved.ok) {
   809→            error(errors.reference.itemNotFound(ref));
   810→            process.exit(EXIT_CODES.ERROR);
   811→          }
   812→
   813→          // Find the item
   814→          const foundItem = items.find(i => i._ulid === resolved.ulid);
   815→          if (!foundItem) {
   816→            error(errors.reference.notItem(ref));
   817→            process.exit(EXIT_CODES.ERROR);
   818→          }
   819→
   820→          if (options.dryRun) {
   821→            output({ ref, data, wouldApplyTo: foundItem.title, ulid: foundItem._ulid }, () => {
   822→              console.log(chalk.yellow('Would patch:'), foundItem.title);
   823→              console.log(chalk.gray('ULID:'), foundItem._ulid.slice(0, 8));
   824→              console.log(chalk.gray('Changes:'));
   825→              console.log(JSON.stringify(data, null, 2));
   826→            });
   827→            return;
   828→          }
   829→
   830→          const updated = await updateSpecItem(ctx, foundItem, data);
   831→          const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   832→          await commitIfShadow(ctx.shadow, 'item-patch', itemSlug);
   833→
   834→          success(`Patched item: ${itemSlug}`, { item: updated });
   835→        }
   836→      } catch (err) {
   837→        error(errors.failures.patchItems, err);
   838→        process.exit(EXIT_CODES.ERROR);
   839→      }
   840→    });
   841→
   842→  // kspec item status - show implementation status with linked tasks
   843→  item
   844→    .command('status <ref>')
   845→    .description('Show implementation status and linked tasks for a spec item')
   846→    .action(async (ref) => {
   847→      try {
   848→        const ctx = await initContext();
   849→        const tasks = await loadAllTasks(ctx);
   850→        const items = await loadAllItems(ctx);
   851→        const refIndex = new ReferenceIndex(tasks, items);
   852→
   853→        const result = refIndex.resolve(ref);
   854→        if (!result.ok) {
   855→          error(errors.reference.itemNotFound(ref));
   856→          process.exit(EXIT_CODES.ERROR);
   857→        }
   858→
   859→        const foundItem = result.item as LoadedSpecItem;
   860→
   861→        // Check if it's a task
   862→        if ('status' in foundItem && typeof foundItem.status === 'string') {
   863→          error(errors.reference.notItem(ref));
   864→          process.exit(EXIT_CODES.ERROR);
   865→        }
   866→
   867→        // Build alignment index
   868→        const alignmentIndex = new AlignmentIndex(tasks, items);
   869→        alignmentIndex.buildLinks(refIndex);
   870→
   871→        const summary = alignmentIndex.getImplementationSummary(foundItem._ulid);
   872→
   873→        if (!summary) {
   874→          error(errors.project.couldNotGetImplSummary);
   875→          process.exit(EXIT_CODES.ERROR);
   876→        }
   877→
   878→        output(summary, () => {
   879→          console.log(chalk.bold(foundItem.title));
   880→          console.log(chalk.gray('─'.repeat(40)));
   881→
   882→          // Status
   883→          const currentColor = summary.currentStatus === 'implemented' ? chalk.green
   884→            : summary.currentStatus === 'in_progress' ? chalk.yellow
   885→              : chalk.gray;
   886→          const expectedColor = summary.expectedStatus === 'implemented' ? chalk.green
   887→            : summary.expectedStatus === 'in_progress' ? chalk.yellow
   888→              : chalk.gray;
   889→
   890→          console.log(`Current status:  ${currentColor(summary.currentStatus)}`);
   891→          console.log(`Expected status: ${expectedColor(summary.expectedStatus)}`);
   892→
   893→          if (!summary.isAligned) {
   894→            console.log(chalk.yellow('\n⚠ Status mismatch - run task complete to sync'));
   895→          } else {
   896→            console.log(chalk.green('\n✓ Aligned'));
   897→          }
   898→
   899→          // Linked tasks
   900→          console.log(chalk.bold('\nLinked Tasks:'));
   901→          if (summary.linkedTasks.length === 0) {
   902→            console.log(chalk.gray('  No tasks reference this spec item'));
   903→          } else {
   904→            for (const task of summary.linkedTasks) {
   905→              const statusColor = task.taskStatus === 'completed' ? chalk.green
   906→                : task.taskStatus === 'in_progress' ? chalk.blue
   907→                  : chalk.gray;
   908→              const shortId = task.taskUlid.slice(0, 8);
   909→              const notes = task.hasNotes ? chalk.gray(' (has notes)') : '';
   910→              console.log(`  ${statusColor(`[${task.taskStatus}]`)} ${shortId} ${task.taskTitle}${notes}`);
   911→            }
   912→          }
   913→        });
   914→      } catch (err) {
   915→        error(errors.failures.getItemStatus, err);
   916→        process.exit(EXIT_CODES.ERROR);
   917→      }
   918→    });
   919→
   920→  // kspec item note <ref> <message>
   921→  item
   922→    .command('note <ref> <message>')
   923→    .description('Add a note to a spec item')
   924→    .option('--author <author>', 'Note author')
   925→    .option('--supersedes <ulid>', 'ULID of note this supersedes')
   926→    .action(async (ref: string, message: string, options) => {
   927→      try {
   928→        const ctx = await initContext();
   929→        const items = await loadAllItems(ctx);
   930→        const tasks = await loadAllTasks(ctx);
   931→        const refIndex = new ReferenceIndex(tasks, items);
   932→
   933→        const result = refIndex.resolve(ref);
   934→        if (!result.ok) {
   935→          error(errors.reference.itemNotFound(ref));
   936→          process.exit(EXIT_CODES.ERROR);
   937→        }
   938→
   939→        const foundItem = items.find(i => i._ulid === result.ulid);
   940→        if (!foundItem) {
   941→          error(errors.reference.itemNotFound(ref));
   942→          process.exit(EXIT_CODES.ERROR);
   943→        }
   944→
   945→        const note = createNote(message, options.author, options.supersedes);
   946→
   947→        const updatedNotes = [...(foundItem.notes || []), note];
   948→        await updateSpecItem(ctx, foundItem, { notes: updatedNotes });
   949→
   950→        const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   951→        await commitIfShadow(ctx.shadow, 'item-note', itemSlug);
   952→        success(`Added note to spec item: ${refIndex.shortUlid(foundItem._ulid)}`, { note });
   953→      } catch (err) {
   954→        error(errors.failures.addNote, err);
   955→        process.exit(EXIT_CODES.ERROR);
   956→      }
   957→    });
   958→
   959→  // kspec item notes <ref>
   960→  item
   961→    .command('notes <ref>')
   962→    .description('Show notes for a spec item')
   963→    .action(async (ref: string) => {
   964→      try {
   965→        const ctx = await initContext();
   966→        const items = await loadAllItems(ctx);
   967→        const tasks = await loadAllTasks(ctx);
   968→        const refIndex = new ReferenceIndex(tasks, items);
   969→
   970→        const result = refIndex.resolve(ref);
   971→        if (!result.ok) {
