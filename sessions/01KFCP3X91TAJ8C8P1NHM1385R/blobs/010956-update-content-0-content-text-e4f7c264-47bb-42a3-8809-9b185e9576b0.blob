```
     1→import { Command } from 'commander';
     2→import chalk from 'chalk';
     3→import {
     4→  initContext,
     5→  buildIndexes,
     6→  createSpecItem,
     7→  deleteSpecItem,
     8→  updateSpecItem,
     9→  addChildItem,
    10→  loadAllItems,
