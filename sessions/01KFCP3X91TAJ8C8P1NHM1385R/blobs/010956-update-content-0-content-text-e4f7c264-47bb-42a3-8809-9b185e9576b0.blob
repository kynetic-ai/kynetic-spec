   228→/**
   229→ * Register item commands
   230→ */
   231→export function registerItemCommands(program: Command): void {
   232→  const item = program
   233→    .command('item')
   234→    .description('Spec item commands');
   235→
   236→  // kspec item list
   237→  item
   238→    .command('list')
   239→    .description('List spec items with optional filters')
   240→    .option('-t, --type <type>', 'Filter by item type (module, feature, requirement, constraint, decision)')
   241→    .option('-s, --status <status>', 'Filter by implementation status (not_started, in_progress, implemented, verified)')
   242→    .option('-m, --maturity <maturity>', 'Filter by maturity (draft, proposed, stable, deferred, deprecated)')
   243→    .option('--tag <tag>', 'Filter by tag (can specify multiple)', (val, prev: string[]) => [...prev, val], [])
   244→    .option('--has <field>', 'Filter items that have field present', (val, prev: string[]) => [...prev, val], [])
   245→    .option('-q, --search <text>', 'Search in title')
   246→    .option('-g, --grep <pattern>', 'Search content with regex pattern')
   247→    .option('-v, --verbose', 'Show more details')
   248→    .option('--tree', 'Show parent/child hierarchy')
   249→    .option('--limit <n>', 'Limit results', '50')
   250→    .action(async (options) => {
   251→      try {
   252→        const ctx = await initContext();
   253→        const { itemIndex, items } = await buildIndexes(ctx);
   254→
   255→        // Build filter from options
   256→        const filter: ItemFilter = {
   257→          specItemsOnly: true, // Only spec items, not tasks
   258→        };
   259→
   260→        if (options.type) {
   261→          filter.type = options.type as ItemType;
   262→        }
   263→
   264→        if (options.status) {
   265→          filter.implementation = options.status as ImplementationStatus;
   266→        }
   267→
   268→        if (options.maturity) {
   269→          filter.maturity = options.maturity as Maturity;
   270→        }
   271→
   272→        if (options.tag && options.tag.length > 0) {
   273→          filter.tags = options.tag;
   274→        }
   275→
   276→        if (options.has && options.has.length > 0) {
   277→          filter.hasFields = options.has;
   278→        }
   279→
   280→        if (options.search) {
   281→          filter.titleContains = options.search;
   282→        }
   283→
   284→        if (options.grep) {
   285→          filter.grepSearch = options.grep;
   286→        }
   287→
   288→        const limit = parseInt(options.limit, 10) || 50;
   289→        const result = itemIndex.queryPaginated(filter, 0, limit);
   290→
   291→        // Filter to only LoadedSpecItem (not tasks)
   292→        const specItems = result.items.filter((item): item is LoadedSpecItem =>
   293→          !('status' in item && typeof item.status === 'string')
   294→        );
   295→
   296→        output(
   297→          {
   298→            items: specItems,
   299→            total: result.total,
   300→            showing: specItems.length,
   301→            grepPattern: options.grep,
   302→            tree: options.tree,
   303→          },
   304→          () => {
   305→            if (options.tree) {
   306→              formatItemTree(specItems, options.verbose, options.grep);
   307→            } else {
   308→              formatItemList(specItems, options.verbose, options.grep);
   309→            }
   310→          }
   311→        );
   312→      } catch (err) {
   313→        error(errors.failures.listItems, err);
   314→        process.exit(EXIT_CODES.ERROR);
   315→      }
   316→    });
   317→
   318→  // kspec item get <ref>
   319→  item
   320→    .command('get <ref>')
   321→    .description('Get details for a specific item')
   322→    .action(async (ref) => {
   323→      try {
   324→        const ctx = await initContext();
   325→        const { refIndex, traitIndex, items } = await buildIndexes(ctx);
   326→
   327→        const result = refIndex.resolve(ref);
   328→
   329→        if (!result.ok) {
   330→          error(errors.reference.itemNotFound(ref));
   331→          process.exit(EXIT_CODES.ERROR);
   332→        }
   333→
   334→        const item = result.item as LoadedSpecItem;
   335→
   336→        // AC: @trait-display ac-2 - JSON mode includes inherited_traits array
   337→        const inheritedTraits = traitIndex.getInheritedAC(item._ulid);
   338→        const traitsByTrait = new Map<string, { trait: typeof inheritedTraits[0]['trait']; acs: AcceptanceCriterion[] }>();
   339→        for (const { trait, ac } of inheritedTraits) {
   340→          if (!traitsByTrait.has(trait.ulid)) {
   341→            traitsByTrait.set(trait.ulid, { trait, acs: [] });
   342→          }
   343→          traitsByTrait.get(trait.ulid)!.acs.push(ac);
   344→        }
   345→
   346→        // Build JSON output with inherited traits
   347→        const jsonOutput = {
   348→          ...item,
   349→          inherited_traits: Array.from(traitsByTrait.values()).map(({ trait, acs }) => ({
   350→            ref: `@${trait.slug}`,
   351→            title: trait.title,
   352→            acceptance_criteria: acs,
   353→          })),
   354→        };
   355→
   356→        output(jsonOutput, () => {
   357→          console.log(chalk.bold(item.title));
   358→          console.log(chalk.gray('─'.repeat(40)));
   359→          console.log(`${fieldLabels.ulid}      ${item._ulid}`);
   360→          if (item.slugs.length > 0) {
   361→            console.log(`${fieldLabels.slugs}     ${item.slugs.join(', ')}`);
   362→          }
   363→          console.log(`${fieldLabels.type}      ${item.type}`);
   364→
   365→          if (item.status && typeof item.status === 'object') {
   366→            const s = item.status as { maturity?: string; implementation?: string };
   367→            if (s.maturity) console.log(`${fieldLabels.maturity}  ${s.maturity}`);
   368→            if (s.implementation) console.log(`${fieldLabels.implementation}${s.implementation}`);
   369→          }
   370→
   371→          if ('tags' in item && Array.isArray(item.tags) && item.tags.length > 0) {
   372→            console.log(`${fieldLabels.tags}      ${item.tags.join(', ')}`);
   373→          }
   374→
   375→          if (item.description) {
   376→            console.log('\n' + sectionHeaders.description);
   377→            console.log(item.description);
   378→          }
   379→
   380→          // AC: @trait-display ac-1 - Show own AC first
   381→          if ('acceptance_criteria' in item && Array.isArray(item.acceptance_criteria) && item.acceptance_criteria.length > 0) {
   382→            console.log('\n' + sectionHeaders.acceptanceCriteria);
   383→            for (const ac of item.acceptance_criteria) {
   384→              if (ac && typeof ac === 'object' && 'id' in ac) {
   385→                const acObj = ac as AcceptanceCriterion;
   386→                console.log(chalk.cyan(`  [${acObj.id}]`));
   387→                if (acObj.given) console.log(`    Given: ${acObj.given}`);
   388→                if (acObj.when) console.log(`    When: ${acObj.when}`);
   389→                if (acObj.then) console.log(`    Then: ${acObj.then}`);
   390→              }
   391→            }
   392→          }
   393→
   394→          // AC: @trait-display ac-1, ac-4, ac-5 - Show inherited AC per trait in labeled sections
   395→          if (traitsByTrait.size > 0) {
   396→            for (const { trait, acs } of traitsByTrait.values()) {
   397→              console.log(chalk.gray(`\n─── Inherited from @${trait.slug} ───`));
   398→              for (const ac of acs) {
   399→                console.log(chalk.cyan(`  [${ac.id}]`) + chalk.gray(` (from @${trait.slug})`));
   400→                if (ac.given) console.log(`    Given: ${ac.given}`);
   401→                if (ac.when) console.log(`    When: ${ac.when}`);
   402→                if (ac.then) console.log(`    Then: ${ac.then}`);
   403→              }
   404→            }
   405→          }
   406→        });
   407→      } catch (err) {
   408→        error(errors.failures.getItem, err);
   409→        process.exit(EXIT_CODES.ERROR);
   410→      }
   411→    });
   412→
   413→  // kspec item types - show available types and counts
   414→  item
