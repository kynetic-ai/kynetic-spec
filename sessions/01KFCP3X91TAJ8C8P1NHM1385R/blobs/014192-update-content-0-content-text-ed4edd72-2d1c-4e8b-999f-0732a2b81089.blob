   263→describe('Trait CLI - item trait add', () => {
   264→  let tempDir: string;
   265→
   266→  beforeEach(async () => {
   267→    tempDir = await setupTempFixtures();
   268→    await initGitRepo(tempDir);
   269→
   270→    // Create a trait
   271→    kspec('trait add "JSON Output Support" --slug json-output', tempDir);
   272→
   273→    // Create a spec item
   274→    await fs.mkdir(path.join(tempDir, 'modules'), { recursive: true });
   275→    const specModule = `_ulid: 01KFCVXQAABBCCDDEEFFGGHHXX
   276→slugs:
   277→  - test-feature
   278→title: Test Feature
   279→type: feature
   280→status:
   281→  maturity: draft
   282→  implementation: not_started
   283→`;
   284→    await fs.writeFile(
   285→      path.join(tempDir, 'modules/test.yaml'),
   286→      specModule
   287→    );
   288→
   289→    const manifest = await fs.readFile(
   290→      path.join(tempDir, 'kynetic.yaml'),
   291→      'utf-8'
   292→    );
   293→    const updatedManifest = manifest.replace(
   294→      'includes:\n  - modules/core.yaml',
   295→      'includes:\n  - modules/core.yaml\n  - modules/test.yaml'
   296→    );
   297→    await fs.writeFile(
   298→      path.join(tempDir, 'kynetic.yaml'),
   299→      updatedManifest
   300→    );
   301→  });
   302→
   303→  afterEach(async () => {
   304→    await cleanupTempDir(tempDir);
   305→  });
   306→
   307→  // AC: @trait-cli ac-5
   308→  it('should add trait to spec traits array', () => {
   309→    const result = kspecJson<{ added: boolean; spec: string; trait: string }>(
   310→      'item trait add @test-feature @json-output',
   311→      tempDir
   312→    );
   313→
   314→    expect(result.added).toBe(true);
   315→    expect(result.spec).toContain('test-feature');
   316→    expect(result.trait).toBe('@json-output');
   317→  });
   318→
   319→  it('should persist trait in spec file', async () => {
   320→    kspec('item trait add @test-feature @json-output', tempDir);
   321→
   322→    const specFile = await fs.readFile(
   323→      path.join(tempDir, 'modules/test.yaml'),
   324→      'utf-8'
   325→    );
   326→
   327→    expect(specFile).toContain('traits:');
   328→    expect(specFile).toContain('- "@json-output"');
   329→  });
   330→
   331→  // AC: @trait-cli ac-6
   332→  it('should be idempotent - no duplicate when trait already added', async () => {
   333→    // Add trait once
   334→    kspec('item trait add @test-feature @json-output', tempDir);
   335→
   336→    // Add again - should be idempotent
   337→    const result = kspecJson<{ added: boolean }>(
   338→      'item trait add @test-feature @json-output',
   339→      tempDir
   340→    );
   341→
   342→    expect(result.added).toBe(false);
   343→
   344→    // Verify only one entry in file
   345→    const specFile = await fs.readFile(
   346→      path.join(tempDir, 'modules/test.yaml'),
   347→      'utf-8'
   348→    );
   349→
   350→    const traitMatches = specFile.match(/@json-output/g);
   351→    expect(traitMatches).toHaveLength(1);
   352→  });
   353→
   354→  // AC: @trait-cli ac-7
   355→  it('should error when trait does not exist', () => {
   356→    expect(() => {
   357→      kspec('item trait add @test-feature @nonexistent-trait', tempDir);
   358→    }).toThrow();
   359→  });
   360→
   361→  it('should error when spec ref is invalid', () => {
   362→    expect(() => {
   363→      kspec('item trait add @nonexistent-spec @json-output', tempDir);
   364→    }).toThrow();
   365→  });
   366→
   367→  it('should error when adding trait to task', async () => {
   368→    // Create a task
   369→    const tasksFile = `_version: "0.1"
   370→_updated_at: "2026-01-20T00:00:00Z"
   371→
   372→tasks:
   373→  - _ulid: 01KFCVXQDD1122334455667788
   374→    slugs:
   375→      - test-task
   376→    title: Test Task
   377→    type: task
   378→    status: pending
   379→    priority: 2
   380→    spec_ref: "@test-feature"
   381→    tags: []
   382→    depends_on: []
   383→    blocked_by: []
   384→    notes: []
   385→    todos: []
   386→    created_at: "2026-01-20T00:00:00Z"
   387→`;
   388→
   389→    await fs.writeFile(
   390→      path.join(tempDir, 'project.tasks.yaml'),
   391→      tasksFile
   392→    );
   393→
   394→    expect(() => {
   395→      kspec('item trait add @test-task @json-output', tempDir);
   396→    }).toThrow(/task/i);
   397→  });
   398→});
