   400→describe('Trait CLI - item trait remove', () => {
   401→  let tempDir: string;
   402→
   403→  beforeEach(async () => {
   404→    tempDir = await setupTempFixtures();
   405→    await initGitRepo(tempDir);
   406→
   407→    // Create traits
   408→    kspec('trait add "Trait One" --slug trait-one', tempDir);
   409→    kspec('trait add "Trait Two" --slug trait-two', tempDir);
   410→
   411→    // Create a spec with both traits
   412→    await fs.mkdir(path.join(tempDir, 'modules'), { recursive: true });
   413→    const specModule = `_ulid: 01KFCVXQAABBCCDDEEFFGGHHXX
   414→slugs:
   415→  - test-feature
   416→title: Test Feature
   417→type: feature
   418→status:
   419→  maturity: draft
   420→  implementation: not_started
   421→traits:
   422→  - "@trait-one"
   423→  - "@trait-two"
   424→`;
   425→    await fs.writeFile(
   426→      path.join(tempDir, 'modules/test.yaml'),
   427→      specModule
   428→    );
   429→
   430→    const manifest = await fs.readFile(
   431→      path.join(tempDir, 'kynetic.yaml'),
   432→      'utf-8'
   433→    );
   434→    const updatedManifest = manifest.replace(
   435→      'includes:\n  - modules/core.yaml',
   436→      'includes:\n  - modules/core.yaml\n  - modules/test.yaml'
   437→    );
   438→    await fs.writeFile(
   439→      path.join(tempDir, 'kynetic.yaml'),
   440→      updatedManifest
   441→    );
   442→  });
   443→
   444→  afterEach(async () => {
   445→    await cleanupTempDir(tempDir);
   446→  });
   447→
   448→  // AC: @trait-cli ac-8
   449→  it('should remove trait from traits array', () => {
   450→    const result = kspecJson<{ removed: boolean; spec: string; trait: string }>(
   451→      'item trait remove @test-feature @trait-one',
   452→      tempDir
   453→    );
   454→
   455→    expect(result.removed).toBe(true);
   456→    expect(result.spec).toContain('test-feature');
   457→    expect(result.trait).toBe('@trait-one');
   458→  });
   459→
   460→  it('should persist removal in spec file', async () => {
   461→    kspec('item trait remove @test-feature @trait-one', tempDir);
   462→
   463→    const specFile = await fs.readFile(
   464→      path.join(tempDir, 'modules/test.yaml'),
   465→      'utf-8'
   466→    );
   467→
   468→    expect(specFile).not.toContain('@trait-one');
   469→    expect(specFile).toContain('@trait-two'); // Should still have the other trait
   470→  });
   471→
   472→  it('should warn when trait not in spec traits array', () => {
   473→    const result = kspecJson<{ removed: boolean }>(
   474→      'item trait remove @test-feature @json-output',
   475→      tempDir
   476→    );
   477→
   478→    expect(result.removed).toBe(false);
   479→  });
   480→
   481→  it('should allow removing all traits', async () => {
   482→    kspec('item trait remove @test-feature @trait-one', tempDir);
   483→    kspec('item trait remove @test-feature @trait-two', tempDir);
   484→
   485→    const specFile = await fs.readFile(
   486→      path.join(tempDir, 'modules/test.yaml'),
   487→      'utf-8'
   488→    );
   489→
   490→    // Traits array should be empty
   491→    expect(specFile).toMatch(/traits:\s*\[\]/);
   492→  });
   493→
   494→  it('should error when trait ref is invalid', () => {
   495→    expect(() => {
   496→      kspec('item trait remove @test-feature @nonexistent', tempDir);
   497→    }).toThrow();
   498→  });
   499→});
