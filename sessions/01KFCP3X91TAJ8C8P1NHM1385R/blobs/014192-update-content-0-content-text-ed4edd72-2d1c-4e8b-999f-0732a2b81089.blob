     1→/**
     2→ * E2E tests for trait CLI commands
     3→ * AC: @trait-cli ac-1, ac-2, ac-3, ac-4, ac-5, ac-6, ac-7, ac-8
     4→ */
     5→
     6→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     7→import * as fs from 'node:fs/promises';
     8→import * as path from 'node:path';
     9→import {
    10→  kspecOutput as kspec,
    11→  kspecJson,
    12→  setupTempFixtures,
    13→  cleanupTempDir,
    14→  initGitRepo,
    15→} from './helpers/cli';
    16→
    17→describe('Trait CLI - trait add', () => {
    18→  let tempDir: string;
    19→
    20→  beforeEach(async () => {
    21→    tempDir = await setupTempFixtures();
    22→    await initGitRepo(tempDir);
    23→  });
    24→
    25→  afterEach(async () => {
    26→    await cleanupTempDir(tempDir);
    27→  });
    28→
    29→  // AC: @trait-cli ac-1
    30→  it('should create trait-type item with title', () => {
    31→    const result = kspecJson<{ trait: { _ulid: string; title: string; type: string } }>(
    32→      'trait add "Test Trait"',
    33→      tempDir
    34→    );
    35→
    36→    expect(result.trait).toBeDefined();
    37→    expect(result.trait.title).toBe('Test Trait');
    38→    expect(result.trait.type).toBe('trait');
    39→    expect(result.trait._ulid).toMatch(/^[0-9A-Z]{26}$/);
    40→  });
    41→
    42→  // AC: @trait-cli ac-2
    43→  it('should set description field when --description provided', () => {
    44→    const result = kspecJson<{ trait: { title: string; description: string } }>(
    45→      'trait add "Test Trait" --description "This is a test trait"',
    46→      tempDir
    47→    );
    48→
    49→    expect(result.trait.description).toBe('This is a test trait');
    50→    expect(result.trait.title).toBe('Test Trait');
    51→  });
    52→
    53→  it('should allow custom slug', () => {
    54→    const result = kspecJson<{ trait: { slugs: string[] } }>(
    55→      'trait add "Test Trait" --slug test-trait-custom',
    56→      tempDir
    57→    );
    58→
    59→    expect(result.trait.slugs).toContain('test-trait-custom');
    60→  });
    61→
    62→  it('should add trait to kynetic.yaml traits array', async () => {
    63→    kspec('trait add "Test Trait"', tempDir);
    64→
    65→    const manifest = await fs.readFile(
    66→      path.join(tempDir, 'kynetic.yaml'),
    67→      'utf-8'
    68→    );
    69→
    70→    expect(manifest).toContain('traits:');
    71→    expect(manifest).toContain('title: Test Trait');
    72→    expect(manifest).toContain('type: trait');
    73→  });
    74→});
    75→
    76→describe('Trait CLI - trait list', () => {
    77→  let tempDir: string;
    78→
    79→  beforeEach(async () => {
    80→    tempDir = await setupTempFixtures();
    81→    await initGitRepo(tempDir);
    82→
    83→    // Create some traits
    84→    kspec('trait add "Trait One"', tempDir);
    85→    kspec('trait add "Trait Two" --description "Second trait"', tempDir);
    86→    kspec('trait add "Trait Three" --slug trait-three', tempDir);
    87→
    88→    // Add AC to one of the traits
    89→    const manifest = await fs.readFile(
    90→      path.join(tempDir, 'kynetic.yaml'),
    91→      'utf-8'
    92→    );
    93→
    94→    const withAC = manifest.replace(
    95→      'title: Trait One',
    96→      `title: Trait One
    97→acceptance_criteria:
    98→  - id: ac-1
    99→    given: condition
   100→    when: action
   101→    then: result`
   102→    );
   103→
   104→    await fs.writeFile(
   105→      path.join(tempDir, 'kynetic.yaml'),
   106→      withAC
   107→    );
   108→  });
   109→
   110→  afterEach(async () => {
   111→    await cleanupTempDir(tempDir);
   112→  });
   113→
   114→  // AC: @trait-cli ac-3
   115→  it('should list all traits with AC counts', () => {
   116→    const output = kspec('trait list', tempDir);
   117→
   118→    expect(output).toContain('Trait One');
   119→    expect(output).toContain('Trait Two');
   120→    expect(output).toContain('Trait Three');
   121→
   122→    // Should show AC count
   123→    expect(output).toMatch(/Trait One.*\(1 AC\)/);
   124→    expect(output).toMatch(/Trait Two.*\(no AC\)/);
   125→    expect(output).toMatch(/Trait Three.*\(no AC\)/);
   126→
   127→    expect(output).toContain('3 trait(s)');
   128→  });
   129→
   130→  it('should include trait refs in list output', () => {
   131→    const output = kspec('trait list', tempDir);
   132→
   133→    // Should show slug for trait-three
   134→    expect(output).toContain('@trait-three');
   135→  });
   136→
   137→  it('should return traits array in JSON mode', () => {
   138→    const result = kspecJson<{ traits: Array<{ title: string; acceptanceCriteria: unknown[] }> }>(
   139→      'trait list',
   140→      tempDir
   141→    );
   142→
   143→    expect(result.traits).toHaveLength(3);
   144→    expect(result.traits[0].title).toBe('Trait One');
   145→    expect(result.traits[0].acceptanceCriteria).toHaveLength(1);
   146→    expect(result.traits[1].acceptanceCriteria).toHaveLength(0);
   147→  });
   148→});
   149→
   150→describe('Trait CLI - trait get', () => {
   151→  let tempDir: string;
   152→
   153→  beforeEach(async () => {
   154→    tempDir = await setupTempFixtures();
   155→    await initGitRepo(tempDir);
   156→
   157→    // Create a trait with AC
   158→    kspec('trait add "JSON Output Support" --slug json-output --description "Trait for JSON support"', tempDir);
   159→
   160→    // Add AC to the trait
   161→    const manifest = await fs.readFile(
   162→      path.join(tempDir, 'kynetic.yaml'),
   163→      'utf-8'
   164→    );
   165→
   166→    const withAC = manifest.replace(
   167→      'description: Trait for JSON support',
   168→      `description: Trait for JSON support
   169→acceptance_criteria:
   170→  - id: ac-1
   171→    given: command with --json flag
   172→    when: executed
   173→    then: outputs valid JSON
   174→  - id: ac-2
   175→    given: JSON output
   176→    when: parsed
   177→    then: contains required fields`
   178→    );
   179→
   180→    await fs.writeFile(
   181→      path.join(tempDir, 'kynetic.yaml'),
   182→      withAC
   183→    );
   184→  });
   185→
   186→  afterEach(async () => {
   187→    await cleanupTempDir(tempDir);
   188→  });
   189→
   190→  // AC: @trait-cli ac-4
   191→  it('should show trait details and acceptance criteria', () => {
   192→    const output = kspec('trait get @json-output', tempDir);
   193→
   194→    expect(output).toContain('JSON Output Support');
   195→    expect(output).toContain('Type:      trait');
   196→    expect(output).toContain('Slug:      @json-output');
   197→    expect(output).toContain('Trait for JSON support');
   198→
   199→    // AC: @trait-cli ac-4 - show acceptance criteria
   200→    expect(output).toContain('Acceptance Criteria');
   201→    expect(output).toContain('[ac-1]');
   202→    expect(output).toContain('Given: command with --json flag');
   203→    expect(output).toContain('When: executed');
   204→    expect(output).toContain('Then: outputs valid JSON');
   205→
   206→    expect(output).toContain('[ac-2]');
   207→    expect(output).toContain('Given: JSON output');
   208→  });
   209→
   210→  it('should show usage count when trait is used', async () => {
   211→    // Create a spec that uses the trait
   212→    await fs.mkdir(path.join(tempDir, 'modules'), { recursive: true });
   213→    const specModule = `_ulid: 01KFCVXQAABBCCDDEEFFGGHHXX
   214→slugs:
   215→  - test-spec
   216→title: Test Spec
   217→type: module
   218→traits:
   219→  - "@json-output"
   220→`;
   221→    await fs.writeFile(
   222→      path.join(tempDir, 'modules/test.yaml'),
   223→      specModule
   224→    );
   225→
   226→    const manifest = await fs.readFile(
   227→      path.join(tempDir, 'kynetic.yaml'),
   228→      'utf-8'
   229→    );
   230→    const updatedManifest = manifest.replace(
   231→      'includes:\n  - modules/core.yaml',
   232→      'includes:\n  - modules/core.yaml\n  - modules/test.yaml'
   233→    );
   234→    await fs.writeFile(
   235→      path.join(tempDir, 'kynetic.yaml'),
   236→      updatedManifest
   237→    );
   238→
   239→    const output = kspec('trait get @json-output', tempDir);
   240→
   241→    expect(output).toContain('Used by 1 spec(s)');
   242→  });
   243→
   244→  it('should return full trait data in JSON mode', () => {
   245→    const result = kspecJson<{
   246→      trait: {
   247→        ulid: string;
   248→        slug: string;
   249→        title: string;
   250→        description: string;
   251→        acceptanceCriteria: Array<{ id: string; given: string; when: string; then: string }>;
   252→      };
   253→    }>('trait get @json-output', tempDir);
   254→
   255→    expect(result.trait.title).toBe('JSON Output Support');
   256→    expect(result.trait.slug).toBe('json-output');
   257→    expect(result.trait.description).toBe('Trait for JSON support');
   258→    expect(result.trait.acceptanceCriteria).toHaveLength(2);
   259→    expect(result.trait.acceptanceCriteria[0].id).toBe('ac-1');
   260→  });
   261→});
