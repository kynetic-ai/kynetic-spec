   924→
   925→  // kspec item notes <ref>
   926→  item
   927→    .command('notes <ref>')
   928→    .description('Show notes for a spec item')
   929→    .action(async (ref: string) => {
   930→      try {
   931→        const ctx = await initContext();
   932→        const items = await loadAllItems(ctx);
   933→        const tasks = await loadAllTasks(ctx);
   934→        const refIndex = new ReferenceIndex(tasks, items);
   935→
   936→        const result = refIndex.resolve(ref);
   937→        if (!result.ok) {
   938→          error(errors.reference.itemNotFound(ref));
