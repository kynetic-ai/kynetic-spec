   966→
   967→  // Create subcommand group for acceptance criteria operations
   968→  const acCmd = item
   969→    .command('ac')
   970→    .description('Manage acceptance criteria on spec items');
   971→
   972→  // Helper: Generate next AC ID based on existing AC
   973→  function generateNextAcId(existingAc: AcceptanceCriterion[] | undefined): string {
   974→    if (!existingAc || existingAc.length === 0) return 'ac-1';
   975→
   976→    const numericIds = existingAc
   977→      .map(ac => ac.id.match(/^ac-(\d+)$/)?.[1])
   978→      .filter((id): id is string => id !== null && id !== undefined)
   979→      .map(Number);
   980→
   981→    const maxId = numericIds.length > 0 ? Math.max(...numericIds) : 0;
   982→    return `ac-${maxId + 1}`;
   983→  }
   984→
   985→  // Helper: Resolve ref to spec item (not task)
   986→  async function resolveSpecItem(ref: string): Promise<{ ctx: Awaited<ReturnType<typeof initContext>>; item: LoadedSpecItem; refIndex: ReferenceIndex }> {
   987→    const ctx = await initContext();
   988→    const { refIndex, items } = await buildIndexes(ctx);
   989→
   990→    const result = refIndex.resolve(ref);
   991→    if (!result.ok) {
   992→      error(errors.reference.itemNotFound(ref));
   993→      process.exit(EXIT_CODES.NOT_FOUND);
   994→    }
   995→
   996→    const foundItem = result.item as LoadedSpecItem;
   997→
   998→    // Check if it's a task
   999→    if ('status' in foundItem && typeof foundItem.status === 'string') {
  1000→      error(errors.operation.tasksNoAcceptanceCriteria(ref));
  1001→      process.exit(EXIT_CODES.NOT_FOUND);
  1002→    }
  1003→
  1004→    return { ctx, item: foundItem, refIndex };
  1005→  }
  1006→
  1007→  // kspec item ac list <ref>
  1008→  acCmd
  1009→    .command('list <ref>')
  1010→    .description('List acceptance criteria for a spec item')
  1011→    .action(async (ref: string) => {
  1012→      try {
  1013→        const { item, refIndex } = await resolveSpecItem(ref);
  1014→        const ac = item.acceptance_criteria || [];
  1015→
  1016→        output(ac, () => {
  1017→          console.log(chalk.bold(`Acceptance Criteria for: ${item.title} (@${item.slugs[0] || refIndex.shortUlid(item._ulid)})`));
  1018→          console.log();
  1019→
  1020→          if (ac.length === 0) {
  1021→            console.log(chalk.gray('No acceptance criteria'));
  1022→          } else {
  1023→            for (const criterion of ac) {
  1024→              console.log(chalk.cyan(`  [${criterion.id}]`));
  1025→              console.log(chalk.gray(`    Given: ${criterion.given}`));
  1026→              console.log(chalk.gray(`    When:  ${criterion.when}`));
  1027→              console.log(chalk.gray(`    Then:  ${criterion.then}`));
  1028→              console.log();
  1029→            }
  1030→          }
  1031→
  1032→          console.log(chalk.gray(`${ac.length} acceptance criteria`));
  1033→        });
  1034→      } catch (err) {
  1035→        error(errors.failures.listAc, err);
  1036→        process.exit(EXIT_CODES.ERROR);
  1037→      }
  1038→    });
  1039→
  1040→  // kspec item ac add <ref>
  1041→  acCmd
  1042→    .command('add <ref>')
  1043→    .description('Add an acceptance criterion to a spec item')
  1044→    .option('--id <id>', 'AC identifier (auto-generated if not provided)')
  1045→    .requiredOption('--given <text>', 'The precondition (Given...)')
  1046→    .requiredOption('--when <text>', 'The action/trigger (When...)')
  1047→    .requiredOption('--then <text>', 'The expected outcome (Then...)')
  1048→    .action(async (ref: string, options) => {
  1049→      try {
  1050→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1051→        const existingAc = item.acceptance_criteria || [];
  1052→
  1053→        // Determine ID
  1054→        const acId = options.id || generateNextAcId(existingAc);
  1055→
  1056→        // Check for duplicate ID
  1057→        if (existingAc.some(ac => ac.id === acId)) {
  1058→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1059→          error(errors.conflict.acAlreadyExists(acId, itemRef));
  1060→          process.exit(EXIT_CODES.CONFLICT);
  1061→        }
  1062→
  1063→        // Create new AC
  1064→        const newAc: AcceptanceCriterion = {
  1065→          id: acId,
  1066→          given: options.given,
  1067→          when: options.when,
  1068→          then: options.then,
  1069→        };
  1070→
  1071→        // Update item with new AC
  1072→        const updatedAc = [...existingAc, newAc];
  1073→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1074→
  1075→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1076→        await commitIfShadow(ctx.shadow, 'item-ac-add', itemSlug);
  1077→        success(`Added acceptance criterion: ${acId} to @${itemSlug}`, { ac: newAc });
  1078→      } catch (err) {
  1079→        error(errors.failures.addAc, err);
  1080→        process.exit(EXIT_CODES.ERROR);
  1081→      }
  1082→    });
  1083→
  1084→  // kspec item ac set <ref> <ac-id>
  1085→  acCmd
  1086→    .command('set <ref> <acId>')
  1087→    .description('Update an acceptance criterion')
  1088→    .option('--id <newId>', 'Rename the AC ID')
  1089→    .option('--given <text>', 'Update the precondition')
  1090→    .option('--when <text>', 'Update the action/trigger')
  1091→    .option('--then <text>', 'Update the expected outcome')
  1092→    .action(async (ref: string, acId: string, options) => {
  1093→      try {
  1094→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1095→        const existingAc = item.acceptance_criteria || [];
  1096→
  1097→        // Find the AC
  1098→        const acIndex = existingAc.findIndex(ac => ac.id === acId);
  1099→        if (acIndex === -1) {
  1100→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1101→          error(errors.reference.acNotFound(acId, itemRef));
  1102→          process.exit(EXIT_CODES.NOT_FOUND);
  1103→        }
  1104→
  1105→        // Check for no updates
  1106→        if (!options.id && !options.given && !options.when && !options.then) {
  1107→          warn('No updates specified');
  1108→          return;
  1109→        }
  1110→
  1111→        // Check for duplicate ID if renaming
  1112→        if (options.id && options.id !== acId && existingAc.some(ac => ac.id === options.id)) {
  1113→          error(errors.conflict.acIdAlreadyExists(options.id));
  1114→          process.exit(EXIT_CODES.CONFLICT);
  1115→        }
  1116→
  1117→        // Build updated AC
  1118→        const updatedAc = [...existingAc];
  1119→        const updatedFields: string[] = [];
  1120→
  1121→        updatedAc[acIndex] = {
  1122→          ...updatedAc[acIndex],
  1123→          ...(options.id && { id: options.id }),
  1124→          ...(options.given && { given: options.given }),
  1125→          ...(options.when && { when: options.when }),
  1126→          ...(options.then && { then: options.then }),
  1127→        };
  1128→
  1129→        if (options.id) updatedFields.push('id');
  1130→        if (options.given) updatedFields.push('given');
  1131→        if (options.when) updatedFields.push('when');
  1132→        if (options.then) updatedFields.push('then');
  1133→
  1134→        // Update item
  1135→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1136→
  1137→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1138→        await commitIfShadow(ctx.shadow, 'item-ac-set', itemSlug);
  1139→        success(`Updated acceptance criterion: ${acId} on @${itemSlug} (${updatedFields.join(', ')})`, { ac: updatedAc[acIndex] });
  1140→      } catch (err) {
  1141→        error(errors.failures.updateAc, err);
  1142→        process.exit(EXIT_CODES.ERROR);
  1143→      }
  1144→    });
  1145→
  1146→  // kspec item ac remove <ref> <ac-id>
  1147→  acCmd
  1148→    .command('remove <ref> <acId>')
  1149→    .description('Remove an acceptance criterion')
  1150→    .option('--force', 'Skip confirmation')
  1151→    .action(async (ref: string, acId: string, options) => {
  1152→      try {
  1153→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1154→        const existingAc = item.acceptance_criteria || [];
  1155→
  1156→        // Find the AC
  1157→        const acIndex = existingAc.findIndex(ac => ac.id === acId);
  1158→        if (acIndex === -1) {
  1159→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1160→          error(errors.reference.acNotFound(acId, itemRef));
  1161→          process.exit(EXIT_CODES.NOT_FOUND);
  1162→        }
  1163→
  1164→        // TODO: Add confirmation prompt when !options.force
  1165→        // For now, proceed with deletion
  1166→
  1167→        // Remove the AC
  1168→        const updatedAc = existingAc.filter(ac => ac.id !== acId);
  1169→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1170→
  1171→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1172→        await commitIfShadow(ctx.shadow, 'item-ac-remove', itemSlug);
  1173→        success(`Removed acceptance criterion: ${acId} from @${itemSlug}`, { removed: acId });
  1174→      } catch (err) {
  1175→        error(errors.failures.removeAc, err);
  1176→        process.exit(EXIT_CODES.ERROR);
  1177→      }
  1178→    });
  1179→}
  1180→
  1181→// ─── Patch Helpers ───────────────────────────────────────────────────────────
  1182→
  1183→/**
  1184→ * Read stdin fully with timeout (for bulk input).
  1185→ * Returns null if stdin is a TTY or empty.
  1186→ */
  1187→async function readStdinFully(): Promise<string | null> {
  1188→  if (process.stdin.isTTY) {
  1189→    return null;
  1190→  }
  1191→
  1192→  return new Promise((resolve) => {
  1193→    let data = '';
  1194→    const timeout = setTimeout(() => {
  1195→      process.stdin.removeAllListeners();
  1196→      resolve(data || null);
  1197→    }, 5000); // 5 second timeout for bulk input
  1198→
  1199→    process.stdin.setEncoding('utf8');
  1200→    process.stdin.on('data', (chunk) => {
  1201→      data += chunk;
  1202→    });
  1203→    process.stdin.on('end', () => {
  1204→      clearTimeout(timeout);
  1205→      resolve(data || null);
  1206→    });
  1207→    process.stdin.on('error', () => {
  1208→      clearTimeout(timeout);
  1209→      resolve(null);
  1210→    });
  1211→    process.stdin.resume();
  1212→  });
  1213→}
  1214→
  1215→/**
  1216→ * Read stdin if available (non-blocking for single item mode).
  1217→ * Returns null quickly if no data available.
  1218→ */
  1219→async function readStdinIfAvailable(): Promise<string | null> {
  1220→  if (process.stdin.isTTY) {
  1221→    return null;
  1222→  }
  1223→
  1224→  return new Promise((resolve) => {
  1225→    let data = '';
  1226→    const timeout = setTimeout(() => {
  1227→      process.stdin.removeAllListeners();
  1228→      resolve(data || null);
  1229→    }, 100); // 100ms timeout for quick check
  1230→
  1231→    process.stdin.setEncoding('utf8');
  1232→    process.stdin.on('data', (chunk) => {
  1233→      data += chunk;
  1234→    });
  1235→    process.stdin.on('end', () => {
  1236→      clearTimeout(timeout);
  1237→      resolve(data || null);
  1238→    });
  1239→    process.stdin.on('error', () => {
  1240→      clearTimeout(timeout);
  1241→      resolve(null);
  1242→    });
  1243→    process.stdin.resume();
  1244→  });
  1245→}
  1246→
  1247→/**
  1248→ * Parse bulk input (JSONL or JSON array)
  1249→ */
  1250→function parseBulkInput(input: string): PatchOperation[] {
  1251→  const trimmed = input.trim();
  1252→
  1253→  // Try JSON array first
  1254→  if (trimmed.startsWith('[')) {
  1255→    const parsed = JSON.parse(trimmed);
  1256→    if (!Array.isArray(parsed)) {
  1257→      throw new Error(errors.validation.expectedJsonArray);
  1258→    }
  1259→    return parsed.map((item, i) => validatePatchOperation(item, i));
  1260→  }
  1261→
  1262→  // Parse as JSONL (one JSON object per line)
  1263→  const lines = trimmed.split('\n').filter(line => line.trim());
  1264→  return lines.map((line, i) => {
  1265→    try {
  1266→      return validatePatchOperation(JSON.parse(line), i);
  1267→    } catch (err) {
  1268→      throw new Error(errors.validation.jsonLineError(i + 1, err instanceof Error ? err.message : 'Invalid JSON'));
  1269→    }
  1270→  });
  1271→}
  1272→
  1273→/**
  1274→ * Validate a patch operation object
  1275→ */
  1276→function validatePatchOperation(obj: unknown, index: number): PatchOperation {
  1277→  if (!obj || typeof obj !== 'object') {
  1278→    throw new Error(errors.validation.patchMustBeObject(index));
  1279→  }
  1280→  const op = obj as Record<string, unknown>;
  1281→  if (typeof op.ref !== 'string' || !op.ref) {
  1282→    throw new Error(errors.validation.patchMustHaveRef(index));
  1283→  }
  1284→  if (!op.data || typeof op.data !== 'object') {
  1285→    throw new Error(errors.validation.patchMustHaveData(index));
  1286→  }
  1287→  return { ref: op.ref, data: op.data as Record<string, unknown> };
  1288→}
  1289→
  1290→/**
  1291→ * Format bulk patch result for human output
  1292→ */
  1293→function formatBulkPatchResult(result: BulkPatchResult, isDryRun = false): void {
  1294→  const prefix = isDryRun ? 'Would patch' : 'Patched';
  1295→
  1296→  for (const r of result.results) {
  1297→    if (r.status === 'updated') {
  1298→      console.log(chalk.green('OK'), `${prefix}: ${r.ref} (${r.ulid?.slice(0, 8)})`);
  1299→    } else if (r.status === 'error') {
  1300→      console.log(chalk.red('ERR'), `${r.ref}: ${r.error}`);
  1301→    } else {
  1302→      console.log(chalk.gray('SKIP'), r.ref);
  1303→    }
  1304→  }
  1305→
  1306→  console.log('');
  1307→  console.log(chalk.bold('Summary:'));
  1308→  console.log(`  Total: ${result.summary.total}`);
  1309→  console.log(chalk.green(`  Updated: ${result.summary.updated}`));
  1310→  if (result.summary.failed > 0) {
  1311→    console.log(chalk.red(`  Failed: ${result.summary.failed}`));
  1312→  }
  1313→  if (result.summary.skipped > 0) {
  1314→    console.log(chalk.gray(`  Skipped: ${result.summary.skipped}`));
  1315→  }
  1316→}
  1317→

