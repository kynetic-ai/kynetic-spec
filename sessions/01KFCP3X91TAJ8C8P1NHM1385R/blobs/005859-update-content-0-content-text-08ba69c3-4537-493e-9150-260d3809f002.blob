```
     1→import { Command } from 'commander';
     2→import chalk from 'chalk';
     3→import {
     4→  initContext,
     5→  buildIndexes,
     6→  createSpecItem,
     7→  deleteSpecItem,
     8→  updateSpecItem,
     9→  addChildItem,
    10→  loadAllItems,
    11→  loadAllTasks,
    12→  ReferenceIndex,
    13→  AlignmentIndex,
    14→  checkSlugUniqueness,
    15→  patchSpecItems,
    16→  findChildItems,
    17→  createNote,
    18→  type LoadedSpecItem,
    19→  type PatchOperation,
    20→  type BulkPatchResult,
    21→} from '../../parser/index.js';
    22→import { commitIfShadow } from '../../parser/shadow.js';
    23→import type { ItemFilter } from '../../parser/items.js';
    24→import type { ItemType, Maturity, ImplementationStatus, SpecItemInput, AcceptanceCriterion } from '../../schema/index.js';
    25→import { SpecItemPatchSchema } from '../../schema/index.js';
    26→import { output, error, success, warn, isJsonMode } from '../output.js';
    27→import { grepItem, formatMatchedFields } from '../../utils/grep.js';
