    30→import { EXIT_CODES } from '../exit-codes.js';
    31→
    32→/**
    33→ * Format a spec item for display
    34→ */
    35→function formatItem(item: LoadedSpecItem, verbose = false, grepPattern?: string): string {
    36→  const shortId = item._ulid.slice(0, 8);
    37→  const slugStr = item.slugs.length > 0 ? chalk.cyan(`@${item.slugs[0]}`) : '';
    38→  const typeStr = chalk.gray(`[${item.type}]`);
    39→
    40→  let status = '';
    41→  if (item.status && typeof item.status === 'object') {
    42→    const s = item.status as { maturity?: string; implementation?: string };
    43→    if (s.implementation) {
    44→      const implColor = s.implementation === 'verified' ? chalk.green
    45→        : s.implementation === 'implemented' ? chalk.cyan
    46→          : s.implementation === 'in_progress' ? chalk.yellow
    47→            : chalk.gray;
    48→      status = implColor(s.implementation);
    49→    } else if (s.maturity) {
    50→      status = chalk.gray(s.maturity);
    51→    }
    52→  }
    53→
    54→  let line = `${chalk.gray(shortId)} ${typeStr} ${item.title}`;
    55→  if (slugStr) line += ` ${slugStr}`;
    56→  if (status) line += ` ${status}`;
    57→
    58→  if (verbose) {
    59→    const tags = 'tags' in item && Array.isArray(item.tags) ? item.tags : [];
    60→    if (tags.length > 0) {
    61→      line += chalk.blue(` #${tags.join(' #')}`);
    62→    }
    63→  }
    64→
    65→  // Show matched fields if grep pattern provided
    66→  if (grepPattern) {
    67→    const match = grepItem(item as unknown as Record<string, unknown>, grepPattern);
    68→    if (match && match.matchedFields.length > 0) {
    69→      line += '\n  ' + chalk.gray(`matched: ${formatMatchedFields(match.matchedFields)}`);
    70→    }
    71→  }
    72→
    73→  return line;
    74→}
    75→
    76→/**
    77→ * Format item list for display
    78→ */
    79→function formatItemList(items: LoadedSpecItem[], verbose = false, grepPattern?: string): void {
    80→  if (items.length === 0) {
    81→    console.log(chalk.gray('No items found'));
    82→    return;
    83→  }
    84→
    85→  for (const item of items) {
    86→    console.log(formatItem(item, verbose, grepPattern));
    87→  }
    88→
    89→  console.log(chalk.gray(`\n${items.length} item(s)`));
    90→}
    91→
    92→/**
    93→ * Format item list as a tree showing parent/child hierarchy
    94→ */
    95→function formatItemTree(items: LoadedSpecItem[], verbose = false, grepPattern?: string): void {
    96→  if (items.length === 0) {
    97→    console.log(chalk.gray('No items found'));
    98→    return;
    99→  }
   100→
   101→  // Build parent-child map
   102→  const childrenMap = new Map<string, LoadedSpecItem[]>();
   103→  const rootItems: LoadedSpecItem[] = [];
   104→
   105→  for (const item of items) {
   106→    const path = item._path || '';
   107→
   108→    // Determine parent path
   109→    let parentPath = '';
   110→    if (path) {
   111→      // Extract parent path from current path
   112→      // e.g., "features[0].requirements[1]" -> "features[0]"
   113→      const lastDotIndex = path.lastIndexOf('.');
   114→      if (lastDotIndex !== -1) {
   115→        parentPath = path.substring(0, lastDotIndex);
   116→      }
   117→    }
   118→
   119→    if (parentPath === '') {
   120→      // Root level item
   121→      rootItems.push(item);
   122→    } else {
   123→      // Find parent by path
   124→      const parent = items.find(i => i._path === parentPath);
   125→      if (parent) {
   126→        const parentUlid = parent._ulid;
   127→        if (!childrenMap.has(parentUlid)) {
   128→          childrenMap.set(parentUlid, []);
   129→        }
   130→        childrenMap.get(parentUlid)!.push(item);
   131→      } else {
   132→        // Parent not in filtered list, show at root
   133→        rootItems.push(item);
   134→      }
   135→    }
   136→  }
   137→
   138→  // Recursive function to print tree
   139→  function printTree(item: LoadedSpecItem, prefix = '', isLast = true): void {
   140→    // Print current item with tree prefix
   141→    const connector = isLast ? '└── ' : '├── ';
   142→    const itemLine = formatItem(item, verbose, grepPattern);
   143→    console.log(prefix + connector + itemLine);
   144→
   145→    // Print children
   146→    const children = childrenMap.get(item._ulid) || [];
   147→    const childPrefix = prefix + (isLast ? '    ' : '│   ');
   148→
   149→    children.forEach((child, index) => {
   150→      const isLastChild = index === children.length - 1;
   151→      printTree(child, childPrefix, isLastChild);
   152→    });
   153→  }
   154→
   155→  // Print all root items
   156→  rootItems.forEach((item, index) => {
   157→    const isLast = index === rootItems.length - 1;
   158→    printTree(item, '', isLast);
   159→  });
   160→
   161→  console.log(chalk.gray(`\n${items.length} item(s)`));
   162→}
   163→
   164→/**
   165→ * Handle cascading status updates to child items
   166→ * Returns array of updated child items
   167→ */
   168→async function handleStatusCascade(
   169→  ctx: Awaited<ReturnType<typeof initContext>>,
   170→  parent: LoadedSpecItem,
   171→  newStatus: string,
   172→  allItems: LoadedSpecItem[],
   173→  refIndex: ReferenceIndex
   174→): Promise<LoadedSpecItem[]> {
   175→  // Find direct children
   176→  const children = findChildItems(parent, allItems);
   177→
   178→  if (children.length === 0) {
   179→    return [];
   180→  }
   181→
   182→  // Skip prompt in JSON mode
   183→  if (isJsonMode()) {
   184→    return [];
   185→  }
   186→
   187→  // Prompt user for cascade
   188→  const readline = await import('readline');
   189→  const rl = readline.createInterface({
   190→    input: process.stdin,
   191→    output: process.stdout,
   192→  });
   193→
   194→  const answer = await new Promise<string>((resolve) => {
   195→    rl.question(`Update ${children.length} child item(s) to ${newStatus}? [y/n] `, resolve);
   196→  });
   197→  rl.close();
   198→
   199→  if (answer.toLowerCase() !== 'y') {
   200→    return [];
   201→  }
   202→
   203→  // Update children
   204→  const updatedChildren: LoadedSpecItem[] = [];
   205→  for (const child of children) {
   206→    const currentStatus = child.status && typeof child.status === 'object'
   207→      ? child.status
   208→      : { maturity: 'draft' as const, implementation: 'not_started' as const };
   209→
   210→    const updates = {
   211→      status: {
   212→        maturity: currentStatus.maturity || ('draft' as const),
   213→        implementation: newStatus as ImplementationStatus,
   214→      },
   215→    };
   216→
   217→    const updated = await updateSpecItem(ctx, child, updates);
   218→    updatedChildren.push(updated);
   219→
   220→    // Log each child update (non-JSON mode only)
   221→    const childRef = child.slugs[0] || refIndex.shortUlid(child._ulid);
   222→    console.log(chalk.gray(`  ✓ Updated @${childRef}`));
   223→  }
   224→
   225→  return updatedChildren;
   226→}
   227→
   228→/**
   229→ * Register item commands
   230→ */
   231→export function registerItemCommands(program: Command): void {
   232→  const item = program
   233→    .command('item')
   234→    .description('Spec item commands');
   235→
   236→  // kspec item list
   237→  item
   238→    .command('list')
   239→    .description('List spec items with optional filters')
   240→    .option('-t, --type <type>', 'Filter by item type (module, feature, requirement, constraint, decision)')
   241→    .option('-s, --status <status>', 'Filter by implementation status (not_started, in_progress, implemented, verified)')
   242→    .option('-m, --maturity <maturity>', 'Filter by maturity (draft, proposed, stable, deferred, deprecated)')
   243→    .option('--tag <tag>', 'Filter by tag (can specify multiple)', (val, prev: string[]) => [...prev, val], [])
   244→    .option('--has <field>', 'Filter items that have field present', (val, prev: string[]) => [...prev, val], [])
   245→    .option('-q, --search <text>', 'Search in title')
   246→    .option('-g, --grep <pattern>', 'Search content with regex pattern')
   247→    .option('-v, --verbose', 'Show more details')
   248→    .option('--tree', 'Show parent/child hierarchy')
   249→    .option('--limit <n>', 'Limit results', '50')
   250→    .action(async (options) => {
   251→      try {
   252→        const ctx = await initContext();
   253→        const { itemIndex, items } = await buildIndexes(ctx);
   254→
   255→        // Build filter from options
   256→        const filter: ItemFilter = {
   257→          specItemsOnly: true, // Only spec items, not tasks
   258→        };
   259→
   260→        if (options.type) {
   261→          filter.type = options.type as ItemType;
   262→        }
   263→
   264→        if (options.status) {
   265→          filter.implementation = options.status as ImplementationStatus;
   266→        }
   267→
   268→        if (options.maturity) {
   269→          filter.maturity = options.maturity as Maturity;
   270→        }
   271→
   272→        if (options.tag && options.tag.length > 0) {
   273→          filter.tags = options.tag;
   274→        }
   275→
   276→        if (options.has && options.has.length > 0) {
   277→          filter.hasFields = options.has;
   278→        }
   279→
   280→        if (options.search) {
   281→          filter.titleContains = options.search;
   282→        }
   283→
   284→        if (options.grep) {
   285→          filter.grepSearch = options.grep;
   286→        }
   287→
   288→        const limit = parseInt(options.limit, 10) || 50;
   289→        const result = itemIndex.queryPaginated(filter, 0, limit);
   290→
   291→        // Filter to only LoadedSpecItem (not tasks)
   292→        const specItems = result.items.filter((item): item is LoadedSpecItem =>
   293→          !('status' in item && typeof item.status === 'string')
   294→        );
   295→
   296→        output(
   297→          {
   298→            items: specItems,
   299→            total: result.total,
   300→            showing: specItems.length,
   301→            grepPattern: options.grep,
   302→            tree: options.tree,
   303→          },
   304→          () => {
   305→            if (options.tree) {
   306→              formatItemTree(specItems, options.verbose, options.grep);
   307→            } else {
   308→              formatItemList(specItems, options.verbose, options.grep);
   309→            }
   310→          }
   311→        );
   312→      } catch (err) {
   313→        error(errors.failures.listItems, err);
   314→        process.exit(EXIT_CODES.ERROR);
   315→      }
   316→    });
   317→
   318→  // kspec item get <ref>
   319→  item
   320→    .command('get <ref>')
   321→    .description('Get details for a specific item')
   322→    .action(async (ref) => {
   323→      try {
   324→        const ctx = await initContext();
   325→        const { refIndex, items } = await buildIndexes(ctx);
   326→
   327→        const result = refIndex.resolve(ref);
   328→
   329→        if (!result.ok) {
   330→          error(errors.reference.itemNotFound(ref));
   331→          process.exit(EXIT_CODES.ERROR);
   332→        }
   333→
   334→        const item = result.item as LoadedSpecItem;
   335→
   336→        output(item, () => {
   337→          console.log(chalk.bold(item.title));
   338→          console.log(chalk.gray('─'.repeat(40)));
   339→          console.log(`${fieldLabels.ulid}      ${item._ulid}`);
   340→          if (item.slugs.length > 0) {
   341→            console.log(`${fieldLabels.slugs}     ${item.slugs.join(', ')}`);
   342→          }
   343→          console.log(`${fieldLabels.type}      ${item.type}`);
   344→
   345→          if (item.status && typeof item.status === 'object') {
   346→            const s = item.status as { maturity?: string; implementation?: string };
   347→            if (s.maturity) console.log(`${fieldLabels.maturity}  ${s.maturity}`);
   348→            if (s.implementation) console.log(`${fieldLabels.implementation}${s.implementation}`);
   349→          }
   350→
   351→          if ('tags' in item && Array.isArray(item.tags) && item.tags.length > 0) {
   352→            console.log(`${fieldLabels.tags}      ${item.tags.join(', ')}`);
   353→          }
   354→
   355→          if (item.description) {
   356→            console.log('\n' + sectionHeaders.description);
   357→            console.log(item.description);
   358→          }
   359→
   360→          if ('acceptance_criteria' in item && Array.isArray(item.acceptance_criteria) && item.acceptance_criteria.length > 0) {
   361→            console.log('\n' + sectionHeaders.acceptanceCriteria);
   362→            for (const ac of item.acceptance_criteria) {
   363→              if (ac && typeof ac === 'object' && 'id' in ac) {
   364→                const acObj = ac as AcceptanceCriterion;
   365→                console.log(chalk.cyan(`  [${acObj.id}]`));
   366→                if (acObj.given) console.log(`    Given: ${acObj.given}`);
   367→                if (acObj.when) console.log(`    When: ${acObj.when}`);
   368→                if (acObj.then) console.log(`    Then: ${acObj.then}`);
   369→              }
   370→            }
   371→          }
   372→        });
   373→      } catch (err) {
   374→        error(errors.failures.getItem, err);
   375→        process.exit(EXIT_CODES.ERROR);
   376→      }
   377→    });
   378→
   379→  // kspec item types - show available types and counts
   380→  item
   381→    .command('types')
   382→    .description('Show item types and counts')
   383→    .action(async () => {
   384→      try {
   385→        const ctx = await initContext();
   386→        const { itemIndex } = await buildIndexes(ctx);
   387→
   388→        const typeCounts = itemIndex.getTypeCounts();
   389→
   390→        output(
   391→          Object.fromEntries(typeCounts),
   392→          () => {
   393→            console.log(chalk.bold('Item Types'));
   394→            console.log(chalk.gray('─'.repeat(30)));
   395→            for (const [type, count] of typeCounts) {
   396→              console.log(`  ${type}: ${count}`);
   397→            }
   398→            console.log(chalk.gray(`\nTotal: ${itemIndex.size} items`));
   399→          }
   400→        );
   401→      } catch (err) {
   402→        error(errors.failures.getTypes, err);
   403→        process.exit(EXIT_CODES.ERROR);
   404→      }
   405→    });
   406→
   407→  // kspec item tags - show available tags and counts
   408→  item
   409→    .command('tags')
   410→    .description('Show tags and counts')
   411→    .action(async () => {
   412→      try {
   413→        const ctx = await initContext();
   414→        const { itemIndex } = await buildIndexes(ctx);
   415→
   416→        const tagCounts = itemIndex.getTagCounts();
   417→
   418→        output(
   419→          Object.fromEntries(tagCounts),
   420→          () => {
   421→            console.log(chalk.bold('Tags'));
   422→            console.log(chalk.gray('─'.repeat(30)));
   423→            for (const [tag, count] of tagCounts) {
   424→              console.log(`  #${tag}: ${count}`);
   425→            }
   426→          }
   427→        );
   428→      } catch (err) {
   429→        error(errors.failures.getTags, err);
   430→        process.exit(EXIT_CODES.ERROR);
   431→      }
   432→    });
   433→
   434→  // kspec item add - create a new spec item under a parent
   435→  item
   436→    .command('add')
   437→    .description('Create a new spec item under a parent')
   438→    .requiredOption('--under <ref>', 'Parent item reference (e.g., @core-primitives)')
   439→    .requiredOption('--title <title>', 'Item title')
   440→    .option('--type <type>', 'Item type (feature, requirement, constraint, decision)', 'feature')
   441→    .option('--slug <slug>', 'Human-friendly slug')
   442→    .option('--priority <priority>', 'Priority (high, medium, low)')
   443→    .option('--tag <tag...>', 'Tags')
   444→    .option('--description <desc>', 'Description')
   445→    .option('--as <field>', 'Child field override (e.g., requirements, constraints)')
   446→    .action(async (options) => {
   447→      try {
   448→        const ctx = await initContext();
   449→        const { refIndex, items } = await buildIndexes(ctx);
   450→
   451→        // Find the parent item
   452→        const parentResult = refIndex.resolve(options.under);
   453→        if (!parentResult.ok) {
   454→          error(errors.reference.itemNotFound(options.under));
   455→          process.exit(EXIT_CODES.ERROR);
   456→        }
   457→
   458→        const parent = parentResult.item as LoadedSpecItem;
   459→
   460→        // Check it's not a task
   461→        if ('status' in parent && typeof parent.status === 'string') {
   462→          error(errors.reference.parentIsTask(options.under));
   463→          process.exit(EXIT_CODES.ERROR);
   464→        }
   465→
   466→        // Check slug uniqueness if provided
   467→        if (options.slug) {
   468→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   469→          if (!slugCheck.ok) {
   470→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   471→            process.exit(EXIT_CODES.CONFLICT);
   472→          }
   473→        }
   474→
   475→        const input: SpecItemInput = {
   476→          title: options.title,
   477→          type: options.type as ItemType,
   478→          slugs: options.slug ? [options.slug] : [],
   479→          priority: options.priority,
   480→          tags: options.tag || [],
   481→          description: options.description,
   482→          depends_on: [],
   483→          implements: [],
   484→          relates_to: [],
   485→          tests: [],
   486→          traits: [],
   487→          notes: [],
   488→        };
   489→
   490→        const newItem = createSpecItem(input);
   491→        const result = await addChildItem(ctx, parent, newItem, options.as);
   492→
   493→        // Build index including the new item for accurate short ULID
   494→        const index = new ReferenceIndex([], [...items, result.item as LoadedSpecItem]);
   495→        const itemSlug = (result.item as LoadedSpecItem).slugs?.[0] || index.shortUlid(result.item._ulid);
   496→        await commitIfShadow(ctx.shadow, 'item-add', itemSlug);
   497→        success(`Created item: ${index.shortUlid(result.item._ulid)} under @${parent.slugs[0] || parent._ulid.slice(0, 8)}`, {
   498→          item: result.item,
   499→          path: result.path,
   500→        });
   501→
   502→        // Derive hint
   503→        if (!isJsonMode()) {
   504→          const refSlug = (result.item as LoadedSpecItem).slugs?.[0] || index.shortUlid(result.item._ulid);
   505→          console.log(chalk.gray(`\nDerive implementation task? kspec derive @${refSlug}`));
   506→        }
   507→      } catch (err) {
   508→        error(errors.failures.createItem, err);
   509→        process.exit(EXIT_CODES.ERROR);
   510→      }
   511→    });
   512→
   513→  // kspec item set - update a spec item field
   514→  item
   515→    .command('set <ref>')
   516→    .description('Update a spec item field')
   517→    .option('--title <title>', 'Set title')
   518→    .option('--type <type>', 'Set type')
   519→    .option('--slug <slug>', 'Add a slug')
   520→    .option('--remove-slug <slug>', 'Remove a slug')
   521→    .option('--priority <priority>', 'Set priority')
   522→    .option('--tag <tag...>', 'Set tags (replaces existing)')
   523→    .option('--description <desc>', 'Set description')
   524→    .option('--status <status>', 'Set implementation status (not_started, in_progress, implemented, verified)')
   525→    .option('--maturity <maturity>', 'Set maturity (draft, proposed, stable, deferred, deprecated)')
   526→    .action(async (ref, options) => {
   527→      try {
   528→        const ctx = await initContext();
   529→        const { refIndex, items } = await buildIndexes(ctx);
   530→
   531→        const result = refIndex.resolve(ref);
   532→        if (!result.ok) {
   533→          error(errors.reference.itemNotFound(ref));
   534→          process.exit(EXIT_CODES.ERROR);
   535→        }
   536→
   537→        const foundItem = result.item as LoadedSpecItem;
   538→
   539→        // Check if it's a task (tasks should use task commands)
   540→        if ('status' in foundItem && typeof foundItem.status === 'string') {
   541→          error(errors.reference.taskUseTaskCommands(ref));
   542→          process.exit(EXIT_CODES.ERROR);
   543→        }
   544→
   545→        // Check slug uniqueness if adding a new slug
   546→        if (options.slug) {
   547→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug], foundItem._ulid);
   548→          if (!slugCheck.ok) {
   549→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   550→            process.exit(EXIT_CODES.CONFLICT);
   551→          }
   552→        }
   553→
   554→        // Validate --remove-slug
   555→        if (options.removeSlug) {
   556→          const currentSlugs = foundItem.slugs || [];
   557→          if (!currentSlugs.includes(options.removeSlug)) {
   558→            error(errors.slug.notFound(options.removeSlug));
   559→            process.exit(EXIT_CODES.ERROR);
   560→          }
   561→          if (currentSlugs.length === 1) {
   562→            error(errors.slug.cannotRemoveLast(options.removeSlug));
   563→            process.exit(EXIT_CODES.ERROR);
   564→          }
   565→        }
   566→
   567→        // Build updates object
   568→        const updates: Partial<SpecItemInput> = {};
   569→
   570→        if (options.title) updates.title = options.title;
   571→        if (options.type) updates.type = options.type as ItemType;
   572→        if (options.slug || options.removeSlug) {
   573→          let slugs = [...(foundItem.slugs || [])];
   574→          if (options.removeSlug) {
   575→            slugs = slugs.filter(s => s !== options.removeSlug);
   576→          }
   577→          if (options.slug) {
   578→            slugs.push(options.slug);
   579→          }
   580→          updates.slugs = slugs;
   581→        }
   582→        if (options.priority) updates.priority = options.priority;
   583→        if (options.tag) updates.tags = options.tag;
   584→        if (options.description) updates.description = options.description;
   585→
   586→        // Handle status updates
   587→        if (options.status || options.maturity) {
   588→          const currentStatus = foundItem.status && typeof foundItem.status === 'object'
   589→            ? foundItem.status
   590→            : {};
   591→          updates.status = {
   592→            ...currentStatus,
   593→            ...(options.status && { implementation: options.status }),
   594→            ...(options.maturity && { maturity: options.maturity }),
   595→          };
   596→        }
   597→
   598→        if (Object.keys(updates).length === 0) {
   599→          warn('No updates specified');
   600→          return;
   601→        }
   602→
   603→        const updated = await updateSpecItem(ctx, foundItem, updates);
   604→        const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   605→
   606→        // Handle cascade for implementation status updates
   607→        const updatedItems: LoadedSpecItem[] = [updated];
   608→        if (options.status) {
   609→          const cascadeResult = await handleStatusCascade(ctx, updated, options.status, items, refIndex);
   610→          updatedItems.push(...cascadeResult);
   611→        }
   612→
   613→        await commitIfShadow(ctx.shadow, 'item-set', itemSlug);
   614→        success(`Updated item: ${refIndex.shortUlid(updated._ulid)}`, { item: updated });
   615→
   616→        // Derive hint
   617→        if (!isJsonMode()) {
   618→          const refSlug = updated.slugs?.[0] || refIndex.shortUlid(updated._ulid);
   619→          console.log(chalk.gray(`\nDerive implementation task? kspec derive @${refSlug}`));
   620→        }
   621→      } catch (err) {
   622→        error(errors.failures.updateItem, err);
   623→        process.exit(EXIT_CODES.ERROR);
   624→      }
   625→    });
   626→
   627→  // kspec item delete - delete a spec item
   628→  item
   629→    .command('delete <ref>')
   630→    .description('Delete a spec item (including nested items)')
   631→    .option('--force', 'Skip confirmation')
   632→    .action(async (ref, options) => {
   633→      try {
   634→        const ctx = await initContext();
   635→        const { refIndex, items } = await buildIndexes(ctx);
   636→
   637→        const result = refIndex.resolve(ref);
   638→        if (!result.ok) {
   639→          error(errors.reference.itemNotFound(ref));
   640→          process.exit(EXIT_CODES.ERROR);
   641→        }
   642→
   643→        const foundItem = result.item as LoadedSpecItem;
   644→
   645→        // Check if it's a task
   646→        if ('status' in foundItem && typeof foundItem.status === 'string') {
   647→          error(errors.reference.itemUseTaskCancel(ref));
   648→          process.exit(EXIT_CODES.ERROR);
   649→        }
   650→
   651→        if (!foundItem._sourceFile) {
   652→          error(errors.operation.cannotDeleteNoSource);
   653→          process.exit(EXIT_CODES.ERROR);
   654→        }
   655→
   656→        // Warn about nested children being deleted too
   657→        // TODO: could add a check here for child items
   658→
   659→        const deleted = await deleteSpecItem(ctx, foundItem);
   660→        if (deleted) {
   661→          const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   662→          await commitIfShadow(ctx.shadow, 'item-delete', itemSlug);
   663→          success(`Deleted item: ${foundItem.title}`, { deleted: true, ulid: foundItem._ulid });
   664→        } else {
   665→          error(errors.failures.deleteItem);
   666→          console.log(chalk.gray('Edit the source file directly: ' + foundItem._sourceFile));
   667→          process.exit(EXIT_CODES.ERROR);
   668→        }
   669→      } catch (err) {
   670→        error(errors.failures.deleteItem, err);
   671→        process.exit(EXIT_CODES.ERROR);
   672→      }
   673→    });
   674→
   675→  // kspec item patch - update item fields via JSON
   676→  item
   677→    .command('patch [ref]')
   678→    .description('Update spec item fields via JSON patch')
   679→    .option('--data <json>', 'JSON data to patch')
   680→    .option('--bulk', 'Read patches from stdin (JSONL or JSON array)')
   681→    .option('--allow-unknown', 'Allow fields not in schema')
   682→    .option('--dry-run', 'Preview changes without applying')
   683→    .option('--fail-fast', 'Stop on first error (bulk mode)')
   684→    .action(async (ref: string | undefined, options) => {
   685→      try {
   686→        const ctx = await initContext();
   687→
   688→        if (options.bulk) {
   689→          // Bulk mode: read from stdin
   690→          const stdin = await readStdinFully();
   691→          if (!stdin) {
   692→            error(errors.validation.noInputProvided);
   693→            process.exit(EXIT_CODES.ERROR);
   694→          }
   695→
   696→          let patches: PatchOperation[];
   697→          try {
   698→            patches = parseBulkInput(stdin);
   699→          } catch (err) {
   700→            error(errors.validation.failedToParseBulk(err instanceof Error ? err.message : String(err)));
   701→            process.exit(EXIT_CODES.ERROR);
   702→          }
   703→
   704→          if (patches.length === 0) {
   705→            error(errors.validation.noPatchesProvided);
   706→            process.exit(EXIT_CODES.ERROR);
   707→          }
   708→
   709→          const { refIndex, items } = await buildIndexes(ctx);
   710→          const result = await patchSpecItems(ctx, refIndex, items, patches, {
   711→            allowUnknown: options.allowUnknown,
   712→            failFast: options.failFast,
   713→            dryRun: options.dryRun,
   714→          });
   715→
   716→          // Shadow commit if any updates
   717→          if (!options.dryRun && result.summary.updated > 0) {
   718→            await commitIfShadow(ctx.shadow, 'item-patch', `${result.summary.updated} items`);
   719→          }
   720→
   721→          output(result, () => formatBulkPatchResult(result, options.dryRun));
   722→
   723→          if (result.summary.failed > 0) {
   724→            process.exit(EXIT_CODES.ERROR);
   725→          }
   726→        } else {
   727→          // Single item mode
   728→          if (!ref) {
   729→            error(errors.usage.patchNeedRef);
   730→            process.exit(EXIT_CODES.ERROR);
   731→          }
   732→
   733→          let data: Record<string, unknown>;
   734→
   735→          // Get data from --data option or stdin
   736→          if (options.data) {
   737→            try {
   738→              data = JSON.parse(options.data);
   739→            } catch (err) {
   740→              error(errors.validation.invalidJsonInData(err instanceof Error ? err.message : ''));
   741→              process.exit(EXIT_CODES.ERROR);
   742→            }
   743→          } else {
   744→            const stdin = await readStdinIfAvailable();
   745→            if (stdin) {
   746→              try {
   747→                data = JSON.parse(stdin.trim());
   748→              } catch (err) {
   749→                error(errors.validation.invalidJsonFromStdin(err instanceof Error ? err.message : ''));
   750→                process.exit(EXIT_CODES.ERROR);
   751→              }
   752→            } else {
   753→              error(errors.validation.noPatchData);
   754→              process.exit(EXIT_CODES.ERROR);
   755→            }
   756→          }
   757→
   758→          // Validate against schema (unless --allow-unknown)
   759→          if (!options.allowUnknown) {
   760→            // Use strict schema (no passthrough)
   761→            const strictSchema = SpecItemPatchSchema.strict();
   762→            const parseResult = strictSchema.safeParse(data);
   763→            if (!parseResult.success) {
   764→              const issues = parseResult.error.issues.map(i => `${i.path.join('.')}: ${i.message}`).join('; ');
   765→              error(errors.validation.invalidPatchDataWithIssues(issues));
   766→              process.exit(EXIT_CODES.ERROR);
   767→            }
   768→          }
   769→
   770→          const { refIndex, items } = await buildIndexes(ctx);
   771→
   772→          // Resolve ref
   773→          const resolved = refIndex.resolve(ref);
   774→          if (!resolved.ok) {
   775→            error(errors.reference.itemNotFound(ref));
   776→            process.exit(EXIT_CODES.ERROR);
   777→          }
   778→
   779→          // Find the item
   780→          const foundItem = items.find(i => i._ulid === resolved.ulid);
   781→          if (!foundItem) {
   782→            error(errors.reference.notItem(ref));
   783→            process.exit(EXIT_CODES.ERROR);
   784→          }
   785→
   786→          if (options.dryRun) {
   787→            output({ ref, data, wouldApplyTo: foundItem.title, ulid: foundItem._ulid }, () => {
   788→              console.log(chalk.yellow('Would patch:'), foundItem.title);
   789→              console.log(chalk.gray('ULID:'), foundItem._ulid.slice(0, 8));
   790→              console.log(chalk.gray('Changes:'));
   791→              console.log(JSON.stringify(data, null, 2));
   792→            });
   793→            return;
   794→          }
   795→
   796→          const updated = await updateSpecItem(ctx, foundItem, data);
   797→          const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   798→          await commitIfShadow(ctx.shadow, 'item-patch', itemSlug);
   799→
   800→          success(`Patched item: ${itemSlug}`, { item: updated });
   801→        }
   802→      } catch (err) {
   803→        error(errors.failures.patchItems, err);
   804→        process.exit(EXIT_CODES.ERROR);
   805→      }
   806→    });
   807→
   808→  // kspec item status - show implementation status with linked tasks
   809→  item
   810→    .command('status <ref>')
   811→    .description('Show implementation status and linked tasks for a spec item')
   812→    .action(async (ref) => {
   813→      try {
   814→        const ctx = await initContext();
   815→        const tasks = await loadAllTasks(ctx);
   816→        const items = await loadAllItems(ctx);
   817→        const refIndex = new ReferenceIndex(tasks, items);
   818→
   819→        const result = refIndex.resolve(ref);
   820→        if (!result.ok) {
   821→          error(errors.reference.itemNotFound(ref));
   822→          process.exit(EXIT_CODES.ERROR);
   823→        }
   824→
   825→        const foundItem = result.item as LoadedSpecItem;
   826→
   827→        // Check if it's a task
   828→        if ('status' in foundItem && typeof foundItem.status === 'string') {
   829→          error(errors.reference.notItem(ref));
   830→          process.exit(EXIT_CODES.ERROR);
   831→        }
   832→
   833→        // Build alignment index
   834→        const alignmentIndex = new AlignmentIndex(tasks, items);
   835→        alignmentIndex.buildLinks(refIndex);
   836→
   837→        const summary = alignmentIndex.getImplementationSummary(foundItem._ulid);
   838→
   839→        if (!summary) {
   840→          error(errors.project.couldNotGetImplSummary);
   841→          process.exit(EXIT_CODES.ERROR);
   842→        }
   843→
   844→        output(summary, () => {
   845→          console.log(chalk.bold(foundItem.title));
   846→          console.log(chalk.gray('─'.repeat(40)));
   847→
   848→          // Status
   849→          const currentColor = summary.currentStatus === 'implemented' ? chalk.green
   850→            : summary.currentStatus === 'in_progress' ? chalk.yellow
   851→              : chalk.gray;
   852→          const expectedColor = summary.expectedStatus === 'implemented' ? chalk.green
   853→            : summary.expectedStatus === 'in_progress' ? chalk.yellow
   854→              : chalk.gray;
   855→
   856→          console.log(`Current status:  ${currentColor(summary.currentStatus)}`);
   857→          console.log(`Expected status: ${expectedColor(summary.expectedStatus)}`);
   858→
   859→          if (!summary.isAligned) {
   860→            console.log(chalk.yellow('\n⚠ Status mismatch - run task complete to sync'));
   861→          } else {
   862→            console.log(chalk.green('\n✓ Aligned'));
   863→          }
   864→
   865→          // Linked tasks
   866→          console.log(chalk.bold('\nLinked Tasks:'));
   867→          if (summary.linkedTasks.length === 0) {
   868→            console.log(chalk.gray('  No tasks reference this spec item'));
   869→          } else {
   870→            for (const task of summary.linkedTasks) {
   871→              const statusColor = task.taskStatus === 'completed' ? chalk.green
   872→                : task.taskStatus === 'in_progress' ? chalk.blue
   873→                  : chalk.gray;
   874→              const shortId = task.taskUlid.slice(0, 8);
   875→              const notes = task.hasNotes ? chalk.gray(' (has notes)') : '';
   876→              console.log(`  ${statusColor(`[${task.taskStatus}]`)} ${shortId} ${task.taskTitle}${notes}`);
   877→            }
   878→          }
   879→        });
   880→      } catch (err) {
   881→        error(errors.failures.getItemStatus, err);
   882→        process.exit(EXIT_CODES.ERROR);
   883→      }
   884→    });
   885→
   886→  // kspec item note <ref> <message>
   887→  item
   888→    .command('note <ref> <message>')
   889→    .description('Add a note to a spec item')
   890→    .option('--author <author>', 'Note author')
   891→    .option('--supersedes <ulid>', 'ULID of note this supersedes')
   892→    .action(async (ref: string, message: string, options) => {
