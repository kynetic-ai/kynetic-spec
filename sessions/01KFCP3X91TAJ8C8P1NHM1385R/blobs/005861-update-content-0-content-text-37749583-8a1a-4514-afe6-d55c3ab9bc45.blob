   949→          console.log('');
   950→          console.log(alignmentCheck.header);
   951→          console.log(alignmentCheck.beyondSpec);
   952→          console.log(alignmentCheck.updateSpec(foundTask.spec_ref));
   953→          console.log(alignmentCheck.addAC);
   954→
   955→          // Check if linked spec has acceptance criteria and remind about test coverage
   956→          const specResult = index.resolve(foundTask.spec_ref);
   957→          if (specResult.ok && specResult.item) {
   958→            const specItem = specResult.item as { acceptance_criteria?: unknown[] };
   959→            if (specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
   960→              console.log('');
   961→              console.log(alignmentCheck.testCoverage(specItem.acceptance_criteria.length));
   962→            }
   963→          }
   964→        }
   965→      } catch (err) {
   966→        error(errors.failures.addNote, err);
   967→        process.exit(EXIT_CODES.ERROR);
