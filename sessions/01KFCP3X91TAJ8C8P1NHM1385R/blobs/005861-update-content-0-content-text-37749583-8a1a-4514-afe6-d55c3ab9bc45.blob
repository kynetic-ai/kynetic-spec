  1000→
  1001→  // kspec task review <ref>
  1002→  task
  1003→    .command('review <ref>')
  1004→    .description('Get task context for review (task details, spec, ACs, git diff)')
  1005→    .action(async (ref: string) => {
  1006→      try {
  1007→        const ctx = await initContext();
  1008→        const tasks = await loadAllTasks(ctx);
  1009→        const items = await loadAllItems(ctx);
  1010→        const index = new ReferenceIndex(tasks, items);
  1011→        const foundTask = resolveTaskRef(ref, tasks, index);
  1012→
  1013→        // Import getDiffSince from utils
  1014→        const { getDiffSince } = await import('../../utils/index.js');
  1015→
  1016→        // Import scanTestCoverage (we'll need to export it from validate.ts)
  1017→        // For now, duplicate the logic here
  1018→        const scanTestCoverage = async (rootDir: string): Promise<Set<string>> => {
  1019→          const coveredACs = new Set<string>();
  1020→          const testsDir = path.join(rootDir, 'tests');
  1021→          const fs = await import('node:fs/promises');
  1022→
  1023→          try {
  1024→            await fs.access(testsDir);
  1025→            const files = await fs.readdir(testsDir);
  1026→            const testFiles = files.filter(f => f.endsWith('.test.ts') || f.endsWith('.test.js'));
  1027→
  1028→            for (const file of testFiles) {
  1029→              const filePath = path.join(testsDir, file);
  1030→              const content = await fs.readFile(filePath, 'utf-8');
  1031→              const acPattern = /\/\/\s*AC:\s*(@[\w-]+)(?:\s+(ac-\d+(?:\s*,\s*ac-\d+)*))?/g;
  1032→              let match;
  1033→
  1034→              while ((match = acPattern.exec(content)) !== null) {
  1035→                const specRef = match[1];
  1036→                const acList = match[2];
  1037→
  1038→                if (acList) {
  1039→                  const acs = acList.split(',').map(ac => ac.trim());
  1040→                  for (const ac of acs) {
  1041→                    coveredACs.add(`${specRef} ${ac}`);
  1042→                  }
  1043→                } else {
  1044→                  coveredACs.add(specRef);
  1045→                }
  1046→              }
  1047→            }
  1048→          } catch (err) {
  1049→            // Tests directory doesn't exist or can't be read
  1050→          }
  1051→
  1052→          return coveredACs;
  1053→        };
  1054→
  1055→        // Gather review context
  1056→        const reviewContext: {
  1057→          task: typeof foundTask;
  1058→          spec: LoadedSpecItem | null;
  1059→          diff: string | null;
  1060→          started_at: string | null;
  1061→          testCoverage?: { covered: string[]; uncovered: string[] };
  1062→        } = {
  1063→          task: foundTask,
  1064→          spec: null,
  1065→          diff: null,
  1066→          started_at: foundTask.started_at || null,
  1067→        };
  1068→
  1069→        // Get spec item if task has spec_ref
  1070→        if (foundTask.spec_ref) {
  1071→          const specResult = index.resolve(foundTask.spec_ref);
  1072→          if (specResult.ok) {
  1073→            const specItem = items.find(i => i._ulid === specResult.ulid);
  1074→            reviewContext.spec = specItem || null;
  1075→
  1076→            // Check test coverage for ACs if spec has them
  1077→            if (specItem && specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
  1078→              const coveredACs = await scanTestCoverage(ctx.rootDir);
  1079→              const covered: string[] = [];
  1080→              const uncovered: string[] = [];
  1081→
  1082→              for (const ac of specItem.acceptance_criteria) {
  1083→                // Build possible references
  1084→                const possibleRefs: string[] = [];
  1085→                if (specItem.slugs && specItem.slugs.length > 0) {
  1086→                  possibleRefs.push(`@${specItem.slugs[0]} ${ac.id}`);
  1087→                  possibleRefs.push(`@${specItem.slugs[0]}`);
  1088→                }
  1089→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)} ${ac.id}`);
  1090→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)}`);
  1091→
  1092→                const isCovered = possibleRefs.some(ref => coveredACs.has(ref));
  1093→                if (isCovered) {
  1094→                  covered.push(ac.id);
  1095→                } else {
  1096→                  uncovered.push(ac.id);
  1097→                }
  1098→              }
  1099→
  1100→              reviewContext.testCoverage = { covered, uncovered };
  1101→            }
  1102→          }
  1103→        }
  1104→
  1105→        // Get git diff since task started
  1106→        if (foundTask.started_at) {
  1107→          const startedDate = new Date(foundTask.started_at);
  1108→          reviewContext.diff = getDiffSince(startedDate, ctx.rootDir);
  1109→        }
  1110→
  1111→        output(reviewContext, () => {
  1112→          console.log('='.repeat(60));
  1113→          console.log('Task Review Context');
  1114→          console.log('='.repeat(60));
  1115→          console.log();
  1116→
  1117→          // Task details
  1118→          console.log('TASK DETAILS');
  1119→          console.log('-'.repeat(60));
  1120→          console.log(formatTaskDetails(foundTask, index));
  1121→          console.log();
  1122→
  1123→          // Spec details
  1124→          if (reviewContext.spec) {
  1125→            console.log('LINKED SPEC');
  1126→            console.log('-'.repeat(60));
  1127→            console.log(`Title: ${reviewContext.spec.title}`);
  1128→            console.log(`Type: ${reviewContext.spec.type}`);
  1129→            if (reviewContext.spec.description) {
  1130→              console.log(`\nDescription:\n${reviewContext.spec.description}`);
  1131→            }
  1132→            if (reviewContext.spec.acceptance_criteria && reviewContext.spec.acceptance_criteria.length > 0) {
  1133→              console.log(`\nAcceptance Criteria (${reviewContext.spec.acceptance_criteria.length}):`);
  1134→              for (const ac of reviewContext.spec.acceptance_criteria) {
  1135→                const isCovered = reviewContext.testCoverage?.covered.includes(ac.id);
  1136→                const coverageMarker = isCovered ? chalk.green('✓') : chalk.yellow('○');
  1137→                console.log(`  ${coverageMarker} [${ac.id}]`);
  1138→                console.log(`    Given: ${ac.given}`);
  1139→                console.log(`    When: ${ac.when}`);
  1140→                console.log(`    Then: ${ac.then}`);
  1141→              }
  1142→
  1143→              // Test coverage summary
  1144→              if (reviewContext.testCoverage) {
  1145→                const { covered, uncovered } = reviewContext.testCoverage;
  1146→                console.log();
  1147→                if (uncovered.length === 0) {
  1148→                  console.log(chalk.green(`  ✓ All ${covered.length} AC(s) have test coverage`));
  1149→                } else {
  1150→                  console.log(chalk.yellow(`  Test coverage: ${covered.length}/${covered.length + uncovered.length} ACs covered`));
  1151→                  console.log(chalk.yellow(`  Missing coverage for: ${uncovered.join(', ')}`));
  1152→                }
  1153→              }
  1154→            }
  1155→            console.log();
  1156→          }
  1157→
  1158→          // Git diff
  1159→          if (reviewContext.diff) {
  1160→            console.log('CHANGES SINCE TASK STARTED');
  1161→            console.log('-'.repeat(60));
  1162→            console.log(`Started at: ${foundTask.started_at}`);
  1163→            console.log();
  1164→            console.log(reviewContext.diff);
  1165→            console.log();
  1166→          } else if (foundTask.started_at) {
  1167→            console.log('CHANGES SINCE TASK STARTED');
  1168→            console.log('-'.repeat(60));
  1169→            console.log(`Started at: ${foundTask.started_at}`);
  1170→            console.log('No changes detected');
  1171→            console.log();
  1172→          }
  1173→
  1174→          console.log('='.repeat(60));
  1175→          console.log('Review Checklist:');
  1176→          console.log('- Does the implementation match the task description?');
  1177→          if (reviewContext.spec) {
  1178→            console.log('- Are all acceptance criteria covered?');
  1179→            console.log('- Is test coverage adequate?');
  1180→          }
  1181→          console.log('- Are there any gaps or issues?');
  1182→          console.log('='.repeat(60));
  1183→        });
  1184→      } catch (err) {
  1185→        error('Failed to generate review context', err);
  1186→        process.exit(EXIT_CODES.ERROR);
  1187→      }
  1188→    });
  1189→
  1190→  // kspec task todos <ref>
  1191→  task
  1192→    .command('todos <ref>')
  1193→    .description('Show todos for a task')
  1194→    .action(async (ref: string) => {
  1195→      try {
  1196→        const ctx = await initContext();
  1197→        const tasks = await loadAllTasks(ctx);
  1198→        const items = await loadAllItems(ctx);
  1199→        const index = new ReferenceIndex(tasks, items);
  1200→        const foundTask = resolveTaskRef(ref, tasks, index);
  1201→
  1202→        output(foundTask.todos, () => {
  1203→          if (foundTask.todos.length === 0) {
  1204→            console.log('No todos');
  1205→          } else {
  1206→            for (const todo of foundTask.todos) {
  1207→              const status = todo.done ? '[x]' : '[ ]';
  1208→              const doneInfo = todo.done && todo.done_at ? ` (done ${todo.done_at})` : '';
  1209→              console.log(`${status} ${todo.id}. ${todo.text}${doneInfo}`);
  1210→            }
  1211→          }
  1212→        });
  1213→      } catch (err) {
  1214→        error(errors.failures.getTodos, err);
  1215→        process.exit(EXIT_CODES.ERROR);
  1216→      }
  1217→    });
  1218→
  1219→  // Create subcommand group for todo operations
  1220→  const todoCmd = task
  1221→    .command('todo')
  1222→    .description('Manage task todos');
  1223→
  1224→  // kspec task todo add <ref> <text>
  1225→  todoCmd
  1226→    .command('add <ref> <text>')
  1227→    .description('Add a todo to a task')
  1228→    .option('--author <author>', 'Todo author')
  1229→    .action(async (ref: string, text: string, options) => {
  1230→      try {
  1231→        const ctx = await initContext();
  1232→        const tasks = await loadAllTasks(ctx);
  1233→        const items = await loadAllItems(ctx);
  1234→        const index = new ReferenceIndex(tasks, items);
  1235→        const foundTask = resolveTaskRef(ref, tasks, index);
  1236→
  1237→        // Calculate next ID (max existing + 1, or 1 if none)
  1238→        const nextId = foundTask.todos.length > 0
  1239→          ? Math.max(...foundTask.todos.map(t => t.id)) + 1
  1240→          : 1;
  1241→
  1242→        const todo = createTodo(nextId, text, options.author);
  1243→
  1244→        const updatedTask: Task = {
  1245→          ...foundTask,
  1246→          todos: [...foundTask.todos, todo],
  1247→        };
  1248→
  1249→        await saveTask(ctx, updatedTask);
  1250→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
  1251→        success(`Added todo #${todo.id} to task: ${index.shortUlid(updatedTask._ulid)}`, { todo });
  1252→      } catch (err) {
  1253→        error(errors.failures.addTodo, err);
  1254→        process.exit(EXIT_CODES.ERROR);
  1255→      }
  1256→    });
  1257→
  1258→  // kspec task todo done <ref> <id>
  1259→  todoCmd
  1260→    .command('done <ref> <id>')
  1261→    .description('Mark a todo as done')
  1262→    .action(async (ref: string, idStr: string) => {
  1263→      try {
  1264→        const ctx = await initContext();
  1265→        const tasks = await loadAllTasks(ctx);
  1266→        const items = await loadAllItems(ctx);
  1267→        const index = new ReferenceIndex(tasks, items);
  1268→        const foundTask = resolveTaskRef(ref, tasks, index);
  1269→
  1270→        const id = parseInt(idStr, 10);
  1271→        if (isNaN(id)) {
  1272→          error(errors.todo.invalidId(idStr));
  1273→          process.exit(EXIT_CODES.USAGE_ERROR);
  1274→        }
  1275→
  1276→        const todoIndex = foundTask.todos.findIndex(t => t.id === id);
  1277→        if (todoIndex === -1) {
  1278→          error(errors.todo.notFound(id));
  1279→          process.exit(EXIT_CODES.NOT_FOUND);
  1280→        }
  1281→
  1282→        if (foundTask.todos[todoIndex].done) {
  1283→          warn(`Todo #${id} is already done`);
  1284→          return;
  1285→        }
  1286→
  1287→        const updatedTodos = [...foundTask.todos];
  1288→        updatedTodos[todoIndex] = {
  1289→          ...updatedTodos[todoIndex],
  1290→          done: true,
  1291→          done_at: new Date().toISOString(),
  1292→        };
  1293→
  1294→        const updatedTask: Task = {
  1295→          ...foundTask,
  1296→          todos: updatedTodos,
  1297→        };
  1298→
  1299→        await saveTask(ctx, updatedTask);
  1300→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
  1301→        success(`Marked todo #${id} as done`, { todo: updatedTodos[todoIndex] });
  1302→      } catch (err) {
  1303→        error(errors.failures.markTodoDone, err);
  1304→        process.exit(EXIT_CODES.ERROR);
  1305→      }
  1306→    });
  1307→
  1308→  // kspec task todo undone <ref> <id>
  1309→  todoCmd
  1310→    .command('undone <ref> <id>')
  1311→    .description('Mark a todo as not done')
  1312→    .action(async (ref: string, idStr: string) => {
  1313→      try {
  1314→        const ctx = await initContext();
  1315→        const tasks = await loadAllTasks(ctx);
  1316→        const items = await loadAllItems(ctx);
  1317→        const index = new ReferenceIndex(tasks, items);
  1318→        const foundTask = resolveTaskRef(ref, tasks, index);
  1319→
  1320→        const id = parseInt(idStr, 10);
  1321→        if (isNaN(id)) {
  1322→          error(errors.todo.invalidId(idStr));
  1323→          process.exit(EXIT_CODES.USAGE_ERROR);
  1324→        }
  1325→
  1326→        const todoIndex = foundTask.todos.findIndex(t => t.id === id);
  1327→        if (todoIndex === -1) {
  1328→          error(errors.todo.notFound(id));
  1329→          process.exit(EXIT_CODES.NOT_FOUND);
  1330→        }
  1331→
  1332→        if (!foundTask.todos[todoIndex].done) {
  1333→          warn(`Todo #${id} is not done`);
  1334→          return;
  1335→        }
  1336→
  1337→        const updatedTodos = [...foundTask.todos];
  1338→        updatedTodos[todoIndex] = {
  1339→          ...updatedTodos[todoIndex],
  1340→          done: false,
  1341→          done_at: undefined,
  1342→        };
  1343→
  1344→        const updatedTask: Task = {
  1345→          ...foundTask,
  1346→          todos: updatedTodos,
  1347→        };
  1348→
  1349→        await saveTask(ctx, updatedTask);
  1350→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
  1351→        success(`Marked todo #${id} as not done`, { todo: updatedTodos[todoIndex] });
  1352→      } catch (err) {
  1353→        error(errors.failures.markTodoNotDone, err);
  1354→        process.exit(EXIT_CODES.ERROR);
  1355→      }
  1356→    });
  1357→}
