   835→  // kspec task delete <ref> | --refs <refs...>
   836→  // AC: @multi-ref-batch ac-1, ac-2
   837→  task
   838→    .command('delete [ref]')
   839→    .description('Delete a task permanently')
   840→    .option('--refs <refs...>', 'Delete multiple tasks by ref')
   841→    .option('--force', 'Skip confirmation (required for --refs)')
   842→    .option('--dry-run', 'Show what would be deleted without deleting')
   843→    .action(async (ref: string | undefined, options) => {
   844→      try {
   845→        const ctx = await initContext();
   846→        const tasks = await loadAllTasks(ctx);
   847→        const items = await loadAllItems(ctx);
   848→        const index = new ReferenceIndex(tasks, items);
   849→
   850→        // For batch mode (--refs), require --force
   851→        if (options.refs && options.refs.length > 0 && !options.force && !options.dryRun) {
   852→          error('Batch delete requires --force flag');
   853→          process.exit(EXIT_CODES.USAGE_ERROR);
   854→        }
   855→
   856→        const result = await executeBatchOperation({
   857→          positionalRef: ref,
   858→          refsFlag: options.refs,
   859→          context: { ctx, tasks, items, index, options },
   860→          items: tasks,
   861→          index,
   862→          resolveRef: (refStr, taskList, idx) => {
   863→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
   864→            return { item: resolved.task, error: resolved.error };
   865→          },
   866→          executeOperation: async (foundTask, { ctx, index, options }) => {
   867→            try {
   868→              const taskDisplay = `${foundTask.title} (${index.shortUlid(foundTask._ulid)})`;
   869→
   870→              if (options.dryRun) {
   871→                return {
   872→                  success: true,
   873→                  message: `Would delete: ${taskDisplay}`,
   874→                };
   875→              }
   876→
   877→              // For single-ref mode (not --refs), prompt for confirmation unless --force
   878→              if (!options.refs && !options.force) {
   879→                const readline = await import('readline');
   880→                const rl = readline.createInterface({
   881→                  input: process.stdin,
   882→                  output: process.stdout,
   883→                });
   884→
   885→                const answer = await new Promise<string>((resolve) => {
   886→                  rl.question(`Delete task "${taskDisplay}"? [y/N] `, resolve);
   887→                });
   888→                rl.close();
   889→
   890→                if (answer.toLowerCase() !== 'y') {
   891→                  return {
   892→                    success: false,
   893→                    error: 'Deletion cancelled by user',
   894→                  };
   895→                }
   896→              }
   897→
   898→              await deleteTask(ctx, foundTask);
   899→              await commitIfShadow(ctx.shadow, 'task-delete', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), foundTask.title);
   900→
   901→              return {
   902→                success: true,
   903→                message: `Deleted task: ${taskDisplay}`,
   904→              };
   905→            } catch (err) {
   906→              return {
   907→                success: false,
   908→                error: err instanceof Error ? err.message : String(err),
   909→              };
   910→            }
   911→          },
   912→          getUlid: (task) => task._ulid,
   913→        });
   914→
   915→        formatBatchOutput(result, 'Delete');
   916→      } catch (err) {
   917→        error(errors.failures.deleteTask, err);
   918→        process.exit(EXIT_CODES.ERROR);
   919→      }
   920→    });
