```
     1→import { Command } from 'commander';
     2→import { ulid } from 'ulid';
     3→import chalk from 'chalk';
     4→import * as path from 'node:path';
     5→import {
     6→  initContext,
     7→  loadAllTasks,
     8→  loadAllItems,
     9→  saveTask,
    10→  deleteTask,
    11→  createTask,
    12→  createNote,
    13→  createTodo,
    14→  syncSpecImplementationStatus,
    15→  ReferenceIndex,
    16→  checkSlugUniqueness,
    17→  type LoadedTask,
    18→  type LoadedSpecItem,
    19→} from '../../parser/index.js';
    20→import { commitIfShadow } from '../../parser/shadow.js';
    21→import {
    22→  output,
    23→  formatTaskDetails,
    24→  success,
    25→  error,
    26→  warn,
    27→  info,
    28→  isJsonMode,
    29→} from '../output.js';
    30→import { formatCommitGuidance, printCommitGuidance } from '../../utils/commit.js';
    31→import type { Task, TaskInput } from '../../schema/index.js';
    32→import { alignmentCheck, errors } from '../../strings/index.js';
    33→import { executeBatchOperation, formatBatchOutput } from '../batch.js';
    34→import { EXIT_CODES } from '../exit-codes.js';
    35→
    36→/**
    37→ * Find a task by reference with detailed error reporting.
    38→ * Returns the task or exits with appropriate error.
    39→ */
    40→function resolveTaskRef(
    41→  ref: string,
    42→  tasks: LoadedTask[],
    43→  index: ReferenceIndex
    44→): LoadedTask {
    45→  const result = index.resolve(ref);
    46→
    47→  if (!result.ok) {
    48→    switch (result.error) {
    49→      case 'not_found':
    50→        error(errors.reference.taskNotFound(ref));
    51→        break;
    52→      case 'ambiguous':
    53→        error(errors.reference.ambiguous(ref));
    54→        for (const candidate of result.candidates) {
    55→          const task = tasks.find(t => t._ulid === candidate);
    56→          const slug = task?.slugs[0] || '';
    57→          console.error(`  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ''}`);
    58→        }
    59→        break;
    60→      case 'duplicate_slug':
    61→        error(errors.reference.slugMapsToMultiple(ref));
    62→        for (const candidate of result.candidates) {
    63→          console.error(`  - ${index.shortUlid(candidate)}`);
    64→        }
    65→        break;
    66→    }
    67→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    68→    process.exit(EXIT_CODES.NOT_FOUND);
    69→  }
    70→
    71→  // Check if it's actually a task
    72→  const task = tasks.find(t => t._ulid === result.ulid);
    73→  if (!task) {
    74→    error(errors.reference.notTask(ref));
    75→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    76→    process.exit(EXIT_CODES.NOT_FOUND);
    77→  }
    78→
    79→  return task;
    80→}
    81→
    82→/**
    83→ * Batch-compatible resolver that returns null instead of calling process.exit().
    84→ * Used by executeBatchOperation to handle errors without terminating the process.
    85→ * AC: @multi-ref-batch ac-4, ac-8 - Partial failure handling and ref resolution
    86→ */
    87→function resolveTaskRefForBatch(
    88→  ref: string,
    89→  tasks: LoadedTask[],
    90→  index: ReferenceIndex
    91→): { task: LoadedTask | null; error?: string } {
    92→  const result = index.resolve(ref);
    93→
    94→  if (!result.ok) {
    95→    let errorMsg: string;
    96→    switch (result.error) {
    97→      case 'not_found':
    98→        errorMsg = `Reference "${ref}" not found`;
    99→        break;
   100→      case 'ambiguous':
   101→        errorMsg = `Reference "${ref}" is ambiguous (matches ${result.candidates.length} items)`;
   102→        break;
   103→      case 'duplicate_slug':
   104→        errorMsg = `Slug "${ref}" maps to multiple items`;
   105→        break;
   106→    }
   107→    return { task: null, error: errorMsg };
   108→  }
   109→
   110→  // Check if it's actually a task
   111→  const task = tasks.find(t => t._ulid === result.ulid);
   112→  if (!task) {
   113→    return { task: null, error: `Reference "${ref}" is not a task` };
   114→  }
   115→
   116→  return { task };
   117→}
   118→
   119→/**
   120→ * Register the 'task' command group (singular - operations on individual tasks)
   121→ */
   122→export function registerTaskCommands(program: Command): void {
   123→  const task = program
   124→    .command('task')
   125→    .description('Operations on individual tasks');
   126→
   127→  // kspec task get <ref>
   128→  task
   129→    .command('get <ref>')
   130→    .description('Get task details')
   131→    .action(async (ref: string) => {
   132→      try {
   133→        const ctx = await initContext();
   134→        const tasks = await loadAllTasks(ctx);
   135→        const items = await loadAllItems(ctx);
   136→        const index = new ReferenceIndex(tasks, items);
   137→        const foundTask = resolveTaskRef(ref, tasks, index);
   138→
   139→        output(foundTask, () => formatTaskDetails(foundTask, index));
   140→      } catch (err) {
   141→        error(errors.failures.getTask, err);
   142→        process.exit(EXIT_CODES.ERROR);
   143→      }
   144→    });
   145→
   146→  // kspec task add
   147→  task
   148→    .command('add')
   149→    .description('Create a new task')
   150→    .requiredOption('--title <title>', 'Task title')
   151→    .option('--type <type>', 'Task type (task, epic, bug, spike, infra)', 'task')
   152→    .option('--spec-ref <ref>', 'Reference to spec item')
   153→    .option('--meta-ref <ref>', 'Reference to meta item (workflow, agent, or convention)')
   154→    .option('--priority <n>', 'Priority (1-5)', '3')
   155→    .option('--slug <slug>', 'Human-friendly slug')
   156→    .option('--tag <tag...>', 'Tags')
   157→    .action(async (options) => {
   158→      try {
   159→        const ctx = await initContext();
   160→        const tasks = await loadAllTasks(ctx);
   161→        const items = await loadAllItems(ctx);
   162→
   163→        // Load meta items for validation
   164→        const { loadMetaContext } = await import('../../parser/meta.js');
   165→        const metaContext = await loadMetaContext(ctx);
   166→        const allMetaItems = [
   167→          ...metaContext.agents,
   168→          ...metaContext.workflows,
   169→          ...metaContext.conventions,
   170→          ...metaContext.observations,
   171→        ];
   172→
   173→        // Build index for reference validation
   174→        const refIndex = new ReferenceIndex(tasks, items, allMetaItems);
   175→
   176→        // Check slug uniqueness if provided
   177→        if (options.slug) {
   178→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   179→          if (!slugCheck.ok) {
   180→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   181→            process.exit(EXIT_CODES.CONFLICT);
   182→          }
   183→        }
   184→
   185→        // Validate meta_ref if provided (AC-meta-ref-3, AC-meta-ref-4)
   186→        if (options.metaRef) {
   187→          const metaRefResult = refIndex.resolve(options.metaRef);
   188→
   189→          if (!metaRefResult.ok) {
   190→            error(errors.reference.metaRefNotFound(options.metaRef));
   191→            process.exit(EXIT_CODES.NOT_FOUND);
   192→          }
   193→
   194→          // Check if the resolved item is a meta item (not a spec item or task)
   195→          const isTask = tasks.some(t => t._ulid === metaRefResult.ulid);
   196→          const isSpecItem = items.some(i => i._ulid === metaRefResult.ulid);
   197→
   198→          if (isTask || isSpecItem) {
   199→            error(errors.reference.metaRefPointsToSpec(options.metaRef));
   200→            process.exit(EXIT_CODES.NOT_FOUND);
   201→          }
   202→        }
   203→
   204→        const input: TaskInput = {
   205→          title: options.title,
   206→          type: options.type,
   207→          spec_ref: options.specRef || null,
   208→          meta_ref: options.metaRef || null,
   209→          priority: parseInt(options.priority, 10),
   210→          slugs: options.slug ? [options.slug] : [],
   211→          tags: options.tag || [],
   212→        };
   213→
   214→        const newTask = createTask(input);
   215→        await saveTask(ctx, newTask);
   216→        await commitIfShadow(ctx.shadow, 'task-add', newTask.slugs[0] || newTask._ulid.slice(0, 8), newTask.title);
   217→
   218→        // Build index including the new task for accurate short ULID
   219→        const index = new ReferenceIndex([...tasks, newTask], items, allMetaItems);
   220→        success(`Created task: ${index.shortUlid(newTask._ulid)}`, { task: newTask });
   221→      } catch (err) {
   222→        error(errors.failures.createTask, err);
   223→        process.exit(EXIT_CODES.ERROR);
   224→      }
   225→    });
   226→
   227→  // kspec task set <ref>
   228→  // TODO: Add batch support with --refs flag (see @multi-ref-batch)
   229→  task
   230→    .command('set <ref>')
   231→    .description('Update task fields')
   232→    .option('--title <title>', 'Update task title')
   233→    .option('--spec-ref <ref>', 'Link to spec item')
   234→    .option('--meta-ref <ref>', 'Link to meta item (workflow, agent, or convention)')
   235→    .option('--priority <n>', 'Set priority (1-5)')
   236→    .option('--slug <slug>', 'Add a slug alias')
   237→    .option('--tag <tag...>', 'Add tags')
   238→    .option('--depends-on <refs...>', 'Set dependencies (replaces existing)')
   239→    .action(async (ref: string, options) => {
   240→      try {
   241→        const ctx = await initContext();
   242→        const tasks = await loadAllTasks(ctx);
   243→        const items = await loadAllItems(ctx);
   244→
   245→        // Load meta items for validation
   246→        const { loadMetaContext } = await import('../../parser/meta.js');
   247→        const metaContext = await loadMetaContext(ctx);
   248→        const allMetaItems = [
   249→          ...metaContext.agents,
   250→          ...metaContext.workflows,
   251→          ...metaContext.conventions,
   252→          ...metaContext.observations,
   253→        ];
   254→
   255→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   256→        const foundTask = resolveTaskRef(ref, tasks, index);
   257→
   258→        // Check slug uniqueness if adding a new slug
   259→        if (options.slug) {
   260→          const slugCheck = checkSlugUniqueness(index, [options.slug], foundTask._ulid);
   261→          if (!slugCheck.ok) {
   262→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   263→            process.exit(EXIT_CODES.CONFLICT);
   264→          }
   265→        }
   266→
   267→        // Build updated task with only provided options
   268→        const updatedTask: Task = { ...foundTask };
   269→        const changes: string[] = [];
   270→
   271→        if (options.title) {
   272→          updatedTask.title = options.title;
   273→          changes.push('title');
   274→        }
   275→
   276→        if (options.specRef) {
   277→          // Validate the spec ref exists and is a spec item
   278→          const specResult = index.resolve(options.specRef);
   279→          if (!specResult.ok) {
   280→            error(errors.reference.specRefNotFound(options.specRef));
   281→            process.exit(EXIT_CODES.NOT_FOUND);
   282→          }
   283→          // Check it's not a task
   284→          const isTask = tasks.some(t => t._ulid === specResult.ulid);
   285→          if (isTask) {
   286→            error(errors.reference.specRefIsTask(options.specRef));
   287→            process.exit(EXIT_CODES.NOT_FOUND);
   288→          }
   289→          updatedTask.spec_ref = options.specRef;
   290→          changes.push('spec_ref');
   291→        }
   292→
   293→        if (options.metaRef) {
   294→          // Validate the meta ref exists and is a meta item
   295→          const metaRefResult = index.resolve(options.metaRef);
   296→          if (!metaRefResult.ok) {
   297→            error(errors.reference.metaRefNotFound(options.metaRef));
   298→            process.exit(EXIT_CODES.NOT_FOUND);
   299→          }
   300→
   301→          // Check if the resolved item is a meta item (not a spec item or task)
   302→          const isTask = tasks.some(t => t._ulid === metaRefResult.ulid);
   303→          const isSpecItem = items.some(i => i._ulid === metaRefResult.ulid);
   304→
   305→          if (isTask || isSpecItem) {
   306→            error(errors.reference.metaRefPointsToSpec(options.metaRef));
   307→            process.exit(EXIT_CODES.NOT_FOUND);
   308→          }
   309→
   310→          updatedTask.meta_ref = options.metaRef;
   311→          changes.push('meta_ref');
   312→        }
   313→
   314→        if (options.priority) {
   315→          const priority = parseInt(options.priority, 10);
   316→          if (isNaN(priority) || priority < 1 || priority > 5) {
   317→            error(errors.validation.priorityOutOfRange);
   318→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   319→          }
   320→          updatedTask.priority = priority;
   321→          changes.push('priority');
   322→        }
   323→
   324→        if (options.slug) {
   325→          if (!updatedTask.slugs.includes(options.slug)) {
   326→            updatedTask.slugs = [...updatedTask.slugs, options.slug];
   327→            changes.push('slug');
   328→          }
   329→        }
   330→
   331→        if (options.tag) {
   332→          const newTags = options.tag.filter((t: string) => !updatedTask.tags.includes(t));
   333→          if (newTags.length > 0) {
   334→            updatedTask.tags = [...updatedTask.tags, ...newTags];
   335→            changes.push('tags');
   336→          }
   337→        }
   338→
   339→        if (options.dependsOn) {
   340→          // Validate all dependency refs
   341→          for (const depRef of options.dependsOn) {
   342→            const depResult = index.resolve(depRef);
   343→            if (!depResult.ok) {
   344→              error(errors.reference.depNotFound(depRef));
   345→              process.exit(EXIT_CODES.NOT_FOUND);
   346→            }
   347→          }
   348→          updatedTask.depends_on = options.dependsOn;
   349→          changes.push('depends_on');
   350→        }
   351→
   352→        if (changes.length === 0) {
   353→          warn('No changes specified');
   354→          return;
   355→        }
   356→
   357→        await saveTask(ctx, updatedTask);
   358→        await commitIfShadow(ctx.shadow, 'task-set', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), changes.join(', '));
   359→        success(`Updated task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(', ')})`, { task: updatedTask });
   360→      } catch (err) {
   361→        error(errors.failures.updateTask, err);
   362→        process.exit(EXIT_CODES.ERROR);
   363→      }
   364→    });
   365→
   366→  // kspec task patch <ref>
   367→  task
   368→    .command('patch <ref>')
   369→    .description('Update task with JSON data')
   370→    .option('--data <json>', 'JSON object with fields to update')
   371→    .option('--dry-run', 'Show what would change without writing')
   372→    .option('--allow-unknown', 'Allow unknown fields (for extending format)')
   373→    .action(async (ref: string, options) => {
   374→      try {
   375→        const ctx = await initContext();
   376→        const tasks = await loadAllTasks(ctx);
   377→        const items = await loadAllItems(ctx);
   378→
   379→        // Load meta items for validation
   380→        const { loadMetaContext } = await import('../../parser/meta.js');
   381→        const metaContext = await loadMetaContext(ctx);
   382→        const allMetaItems = [
   383→          ...metaContext.agents,
   384→          ...metaContext.workflows,
   385→          ...metaContext.conventions,
   386→          ...metaContext.observations,
   387→        ];
   388→
   389→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   390→        const foundTask = resolveTaskRef(ref, tasks, index);
   391→
   392→        // Get JSON data from --data flag or stdin
   393→        let jsonData: string;
   394→        if (options.data) {
   395→          jsonData = options.data;
   396→        } else {
   397→          // Read from stdin
   398→          const chunks: Buffer[] = [];
   399→          for await (const chunk of process.stdin) {
   400→            chunks.push(chunk);
   401→          }
   402→          jsonData = Buffer.concat(chunks).toString('utf-8');
   403→        }
   404→
   405→        // Parse JSON
   406→        let patchData: Record<string, unknown>;
   407→        try {
   408→          patchData = JSON.parse(jsonData);
   409→        } catch (parseErr) {
   410→          error(errors.validation.invalidJson, parseErr);
   411→          process.exit(EXIT_CODES.ERROR);
   412→        }
   413→
   414→        // Validate against TaskInputSchema (partial)
   415→        const { TaskInputSchema } = await import('../../schema/index.js');
   416→
   417→        // Create a partial schema for validation
   418→        const partialSchema = options.allowUnknown
   419→          ? TaskInputSchema.partial().passthrough()
   420→          : TaskInputSchema.partial().strict();
   421→
   422→        let validatedPatch: Partial<TaskInput>;
   423→        try {
   424→          validatedPatch = partialSchema.parse(patchData);
   425→        } catch (validationErr) {
   426→          error(errors.validation.invalidPatchData(String(validationErr)), validationErr);
   427→          process.exit(EXIT_CODES.ERROR);
   428→        }
   429→
   430→        // Check for unknown fields if strict mode
   431→        if (!options.allowUnknown) {
   432→          const knownFields = Object.keys(TaskInputSchema.shape);
   433→          const providedFields = Object.keys(patchData);
   434→          const unknownFields = providedFields.filter(f => !knownFields.includes(f));
   435→
   436→          if (unknownFields.length > 0) {
   437→            error(errors.validation.unknownFields(unknownFields));
   438→            process.exit(EXIT_CODES.ERROR);
   439→          }
   440→        }
   441→
   442→        // Build updated task
   443→        const updatedTask: Task = { ...foundTask, ...validatedPatch };
   444→
   445→        // Track changes for output
   446→        const changes = Object.keys(validatedPatch);
   447→
   448→        if (options.dryRun) {
   449→          info('Dry run - no changes will be written');
   450→          info(`Would update: ${changes.join(', ')}`);
   451→          output({ changes, updated: updatedTask }, () => {
   452→            console.log(`\nChanges: ${changes.join(', ')}\n`);
   453→            return formatTaskDetails(updatedTask, index);
   454→          });
   455→          return;
   456→        }
   457→
   458→        await saveTask(ctx, updatedTask);
   459→        await commitIfShadow(ctx.shadow, 'task-patch', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), changes.join(', '));
   460→        success(`Patched task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(', ')})`, { task: updatedTask });
   461→      } catch (err) {
   462→        error(errors.failures.patchTask, err);
   463→        process.exit(EXIT_CODES.ERROR);
   464→      }
   465→    });
   466→
   467→  // kspec task start <ref>
   468→  task
   469→    .command('start <ref>')
   470→    .description('Start working on a task (pending -> in_progress)')
   471→    .option('--no-sync', 'Skip syncing spec implementation status')
   472→    .action(async (ref: string, options) => {
   473→      try {
   474→        const ctx = await initContext();
   475→        const tasks = await loadAllTasks(ctx);
   476→        const items = await loadAllItems(ctx);
   477→        const index = new ReferenceIndex(tasks, items);
   478→        const foundTask = resolveTaskRef(ref, tasks, index);
   479→
   480→        if (foundTask.status === 'in_progress') {
   481→          warn('Task is already in progress');
   482→          output(foundTask, () => formatTaskDetails(foundTask));
   483→          return;
   484→        }
   485→
   486→        if (foundTask.status !== 'pending') {
   487→          error(errors.status.cannotStart(foundTask.status));
   488→          process.exit(EXIT_CODES.VALIDATION_FAILED); // Exit code 4 = invalid state
   489→        }
   490→
   491→        // Update status
   492→        const updatedTask: Task = {
   493→          ...foundTask,
   494→          status: 'in_progress',
   495→          started_at: new Date().toISOString(),
   496→        };
   497→
   498→        await saveTask(ctx, updatedTask);
   499→        await commitIfShadow(ctx.shadow, 'task-start', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   500→        success(`Started task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   501→
   502→        // Show spec context and AC guidance (suppressed in JSON mode)
   503→        if (!isJsonMode() && foundTask.spec_ref) {
   504→          const specResult = index.resolve(foundTask.spec_ref);
   505→          if (specResult.ok) {
   506→            const specItem = items.find(i => i._ulid === specResult.ulid);
   507→            if (specItem) {
   508→              console.log('');
   509→              console.log('--- Spec Context ---');
   510→              console.log(`Implementing: ${specItem.title}`);
   511→              if (specItem.description) {
   512→                console.log(`\n${specItem.description}`);
   513→              }
   514→
   515→              if (specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
   516→                console.log(`\nAcceptance Criteria (${specItem.acceptance_criteria.length}):`);
   517→                for (const ac of specItem.acceptance_criteria) {
   518→                  console.log(`  [${ac.id}]`);
   519→                  console.log(`    Given: ${ac.given}`);
   520→                  console.log(`    When: ${ac.when}`);
   521→                  console.log(`    Then: ${ac.then}`);
   522→                }
   523→                console.log('');
   524→                console.log('Remember: Add test coverage for each AC and mark tests with // AC: @spec-ref ac-N');
   525→              }
   526→              console.log('');
   527→            }
   528→          }
   529→        }
   530→
   531→        // Sync spec implementation status (unless --no-sync)
   532→        if (options.sync !== false && foundTask.spec_ref) {
   533→          const updatedTasks = tasks.map(t =>
   534→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t
   535→          );
   536→          const syncResult = await syncSpecImplementationStatus(
   537→            ctx,
   538→            updatedTask as LoadedTask,
   539→            updatedTasks as LoadedTask[],
   540→            items,
   541→            index
   542→          );
   543→          if (syncResult) {
   544→            info(`Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   545→            // Commit the spec status change
   546→            await commitIfShadow(ctx.shadow, 'spec-sync', syncResult.specUlid.slice(0, 8), `${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   547→          }
   548→        }
   549→      } catch (err) {
   550→        error(errors.failures.startTask, err);
   551→        process.exit(EXIT_CODES.ERROR);
   552→      }
   553→    });
   554→
   555→  // kspec task complete <ref> | --refs <refs...>
   556→  // AC: @multi-ref-batch ac-1 - Basic multi-ref syntax
   557→  // AC: @multi-ref-batch ac-2 - Backward compatibility
   558→  task
   559→    .command('complete [ref]')
   560→    .description('Complete a task (in_progress -> completed)')
   561→    .option('--refs <refs...>', 'Complete multiple tasks by ref')
   562→    .option('--reason <reason>', 'Completion reason/notes')
   563→    .option('--no-sync', 'Skip syncing spec implementation status')
   564→    .action(async (ref: string | undefined, options) => {
   565→      try {
   566→        const ctx = await initContext();
   567→        const tasks = await loadAllTasks(ctx);
   568→        const items = await loadAllItems(ctx);
   569→        const index = new ReferenceIndex(tasks, items);
   570→
   571→        // AC: @multi-ref-batch ac-1, ac-2, ac-3, ac-4
   572→        const result = await executeBatchOperation({
   573→          positionalRef: ref,
   574→          refsFlag: options.refs,
   575→          context: { ctx, tasks, items, index, options },
   576→          items: tasks,
   577→          index,
   578→          resolveRef: (refStr, taskList, idx) => {
   579→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
   580→            return { item: resolved.task, error: resolved.error };
   581→          },
   582→          executeOperation: async (foundTask, { ctx, tasks, items, index, options }) => {
   583→            try {
   584→              if (foundTask.status === 'completed') {
   585→                return {
   586→                  success: false,
   587→                  error: 'Task is already completed',
   588→                };
   589→              }
   590→
   591→              if (foundTask.status !== 'in_progress' && foundTask.status !== 'pending' && foundTask.status !== 'pending_review') {
   592→                return {
   593→                  success: false,
   594→                  error: errors.status.cannotComplete(foundTask.status),
   595→                };
   596→              }
   597→
   598→              const now = new Date().toISOString();
   599→
   600→              // Update status
   601→              const updatedTask: Task = {
   602→                ...foundTask,
   603→                status: 'completed',
   604→                completed_at: now,
   605→                closed_reason: options.reason || null,
   606→                started_at: foundTask.started_at || now,
   607→              };
   608→
   609→              await saveTask(ctx, updatedTask);
   610→              await commitIfShadow(ctx.shadow, 'task-complete', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), options.reason);
   611→
   612→              // Sync spec implementation status (unless --no-sync)
   613→              if (options.sync !== false && foundTask.spec_ref) {
   614→                const updatedTasks = tasks.map(t =>
   615→                  t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t
   616→                );
   617→                const syncResult = await syncSpecImplementationStatus(
   618→                  ctx,
   619→                  updatedTask as LoadedTask,
   620→                  updatedTasks as LoadedTask[],
   621→                  items,
   622→                  index
   623→                );
   624→                if (syncResult && !isJsonMode()) {
   625→                  info(`Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   626→                  await commitIfShadow(ctx.shadow, 'spec-sync', syncResult.specUlid.slice(0, 8), `${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   627→                }
   628→              }
   629→
   630→              // Show AC reminder for single-ref mode only (not in batch)
   631→              if (!options.refs && foundTask.spec_ref && !isJsonMode()) {
   632→                const specResult = index.resolve(foundTask.spec_ref);
   633→                if (specResult.ok && specResult.item) {
   634→                  const specItem = items.find(i => i._ulid === specResult.ulid);
   635→                  if (specItem && specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
   636→                    const count = specItem.acceptance_criteria.length;
   637→                    console.log(`\n⚠ Linked spec ${foundTask.spec_ref} has ${count} acceptance criteri${count === 1 ? 'on' : 'a'} - verify they are covered\n`);
   638→                  }
   639→                }
   640→              }
   641→
   642→              return {
   643→                success: true,
   644→                message: `Completed task: ${index.shortUlid(updatedTask._ulid)}`,
   645→                data: updatedTask,
   646→              };
   647→            } catch (err) {
   648→              return {
   649→                success: false,
   650→                error: err instanceof Error ? err.message : String(err),
   651→              };
   652→            }
   653→          },
   654→          getUlid: (task) => task._ulid,
   655→        });
   656→
   657→        // AC: @multi-ref-batch ac-5, ac-6
   658→        formatBatchOutput(result, 'Complete');
   659→
   660→        // Show commit guidance for single-ref mode only
   661→        if (!options.refs && result.success && result.results.length === 1 && !isJsonMode()) {
   662→          const taskData = result.results[0].data as Task | undefined;
   663→          if (taskData) {
   664→            const guidance = formatCommitGuidance(taskData);
   665→            printCommitGuidance(guidance);
   666→          }
   667→        }
   668→      } catch (err) {
   669→        error(errors.failures.completeTask, err);
   670→        process.exit(EXIT_CODES.ERROR);
   671→      }
   672→    });
   673→
