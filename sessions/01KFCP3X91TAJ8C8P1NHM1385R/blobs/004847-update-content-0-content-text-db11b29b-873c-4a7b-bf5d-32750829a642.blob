    48→        traits: ['@my-trait'], // Valid trait reference
    49→        _sourceFile: 'spec/features.yaml',
    50→      },
    51→    ];
    52→
    53→    const index = new ReferenceIndex([], items);
    54→    const result = validateRefs(index, [], items);
