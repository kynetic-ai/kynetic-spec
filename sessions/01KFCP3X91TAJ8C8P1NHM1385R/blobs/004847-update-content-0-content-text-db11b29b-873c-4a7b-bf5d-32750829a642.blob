   269→describe('Traits field E2E validation (CLI)', () => {
   270→  let tempDir: string;
   271→
   272→  beforeEach(async () => {
   273→    tempDir = await createTempDir('kspec-traits-e2e-');
   274→    initGitRepo(tempDir);
   275→
   276→    // Create minimal kspec structure
   277→    const specDir = path.join(tempDir, 'spec');
   278→    const modulesDir = path.join(specDir, 'modules');
   279→    await fs.mkdir(modulesDir, { recursive: true });
   280→
   281→    // Create manifest
   282→    const manifest = {
   283→      project: { name: 'test-project' },
   284→      includes: ['modules/traits.yaml', 'modules/features.yaml'],
   285→    };
   286→    await writeYamlFilePreserveFormat(path.join(specDir, 'kynetic.yaml'), manifest);
   287→
   288→    // Create valid trait
   289→    const trait = {
   290→      _ulid: ulid(),
   291→      slugs: ['my-trait'],
   292→      title: 'My Trait',
   293→      type: 'trait',
   294→      description: 'A test trait',
   295→      status: { maturity: 'draft', implementation: 'not_started' },
   296→      acceptance_criteria: [
   297→        {
   298→          id: 'ac-1',
   299→          given: 'context',
   300→          when: 'action',
   301→          then: 'result',
   302→        },
   303→      ],
   304→    };
   305→    await writeYamlFilePreserveFormat(path.join(modulesDir, 'traits.yaml'), trait);
   306→  });
   307→
   308→  afterEach(async () => {
   309→    await fs.rm(tempDir, { recursive: true, force: true });
   310→  });
   311→
   312→  // AC: @traits-field ac-1 (E2E)
   313→  it('should pass validation when spec has valid trait reference', async () => {
   314→    // Create spec with valid trait ref
   315→    const spec = {
   316→      _ulid: ulid(),
   317→      slugs: ['my-spec'],
   318→      title: 'My Spec',
   319→      type: 'requirement',
   320→      traits: ['@my-trait'],
   321→      status: { maturity: 'draft', implementation: 'not_started' },
   322→    };
   323→    await writeYamlFilePreserveFormat(
   324→      path.join(tempDir, 'spec', 'modules', 'features.yaml'),
   325→      spec
   326→    );
   327→
   328→    const result = kspec('validate --refs', tempDir);
   329→    expect(result.stdout).toContain('References: OK');
   330→  });
   331→
   332→  // AC: @traits-field ac-2 (E2E)
   333→  it('should report error when trait reference does not exist', async () => {
   334→    // Create spec with invalid trait ref
   335→    const spec = {
   336→      _ulid: ulid(),
   337→      slugs: ['my-spec'],
   338→      title: 'My Spec',
   339→      type: 'requirement',
   340→      traits: ['@nonexistent-trait'],
   341→      status: { maturity: 'draft', implementation: 'not_started' },
   342→    };
   343→    await writeYamlFilePreserveFormat(
   344→      path.join(tempDir, 'spec', 'modules', 'features.yaml'),
   345→      spec
   346→    );
   347→
   348→    const result = kspec('validate --refs', tempDir, { expectFail: true });
   349→    const output = result.stderr || result.stdout;
   350→    expect(output).toContain('@nonexistent-trait');
   351→    expect(output).toContain('not found');
   352→    expect(result.exitCode).toBe(1);
   353→  });
   354→
   355→  // AC: @traits-field ac-3 (E2E)
   356→  it('should report error when trait reference points to non-trait item', async () => {
   357→    // Create a module with a feature and a spec
   358→    const module = {
   359→      _ulid: ulid(),
   360→      slugs: ['test-module'],
   361→      title: 'Test Module',
   362→      type: 'module',
   363→      status: { maturity: 'draft', implementation: 'not_started' },
   364→      features: [
   365→        {
   366→          _ulid: ulid(),
   367→          slugs: ['my-feature'],
   368→          title: 'My Feature',
   369→          type: 'feature',
   370→          status: { maturity: 'draft', implementation: 'not_started' },
   371→        },
   372→      ],
   373→      requirements: [
   374→        {
   375→          _ulid: ulid(),
   376→          slugs: ['my-spec'],
   377→          title: 'My Spec',
   378→          type: 'requirement',
   379→          traits: ['@my-feature'], // Points to feature, not trait
   380→          status: { maturity: 'draft', implementation: 'not_started' },
   381→        },
   382→      ],
   383→    };
   384→    await writeYamlFilePreserveFormat(
   385→      path.join(tempDir, 'spec', 'modules', 'features.yaml'),
   386→      module
   387→    );
   388→
   389→    const result = kspec('validate --refs', tempDir, { expectFail: true });
   390→    const output = result.stderr || result.stdout;
   391→    expect(output).toContain('@my-feature');
   392→    expect(output).toContain('non-trait');
   393→    expect(result.exitCode).toBe(1);
   394→  });
   395→
   396→  // AC: @traits-field ac-4 (E2E)
   397→  it('should pass validation when spec has no traits field', async () => {
   398→    // Create spec without traits field
   399→    const spec = {
   400→      _ulid: ulid(),
   401→      slugs: ['my-spec'],
   402→      title: 'My Spec',
   403→      type: 'requirement',
   404→      status: { maturity: 'draft', implementation: 'not_started' },
   405→    };
   406→    await writeYamlFilePreserveFormat(
   407→      path.join(tempDir, 'spec', 'modules', 'features.yaml'),
   408→      spec
   409→    );
   410→
   411→    const result = kspec('validate --refs', tempDir);
   412→    expect(result.stdout).toContain('References: OK');
   413→  });
   414→
   415→  // AC: @traits-field ac-5 (E2E)
   416→  it('should warn when spec has duplicate trait references', async () => {
   417→    // Create spec with duplicate trait refs
   418→    const spec = {
   419→      _ulid: ulid(),
   420→      slugs: ['my-spec'],
   421→      title: 'My Spec',
   422→      type: 'requirement',
   423→      traits: ['@my-trait', '@my-trait'], // Duplicate
   424→      status: { maturity: 'draft', implementation: 'not_started' },
   425→    };
   426→    await writeYamlFilePreserveFormat(
   427→      path.join(tempDir, 'spec', 'modules', 'features.yaml'),
   428→      spec
   429→    );
   430→
   431→    const result = kspec('validate --refs', tempDir);
   432→    expect(result.stdout).toContain('Duplicate');
   433→    expect(result.stdout).toContain('@my-trait');
   434→  });
   435→});
