   233→describe('Trait CLI - item trait add', () => {
   234→  let tempDir: string;
   235→
   236→  beforeEach(async () => {
   237→    tempDir = await setupTempFixtures();
   238→    await initGitRepo(tempDir);
   239→
   240→    // Create a trait
   241→    kspec('trait add "JSON Output Support" --slug json-output', tempDir);
   242→
   243→    // Create a spec item in a module file
   244→    await fs.mkdir(path.join(tempDir, 'modules'), { recursive: true });
   245→    const specModule = `_ulid: 01KFCVXQ00MODULE00000000000
   246→slugs:
   247→  - test-module
   248→title: Test Module
   249→type: module
   250→status:
   251→  maturity: draft
   252→  implementation: not_started
   253→
   254→features:
   255→  - _ulid: 01KFCVXQAABBCCDDEEFFGGHHXX
   256→    slugs:
   257→      - test-trait-feature
   258→    title: Test Trait Feature
   259→    type: feature
   260→    status:
   261→      maturity: draft
   262→      implementation: not_started
   263→`;
   264→    await fs.writeFile(
   265→      path.join(tempDir, 'modules/test.yaml'),
   266→      specModule
   267→    );
   268→
   269→    const manifest = await fs.readFile(
   270→      path.join(tempDir, 'kynetic.yaml'),
   271→      'utf-8'
   272→    );
   273→    const updatedManifest = manifest.replace(
   274→      'includes:\n  - modules/core.yaml',
   275→      'includes:\n  - modules/core.yaml\n  - modules/test.yaml'
   276→    );
   277→    await fs.writeFile(
   278→      path.join(tempDir, 'kynetic.yaml'),
   279→      updatedManifest
   280→    );
   281→  });
   282→
   283→  afterEach(async () => {
   284→    await cleanupTempDir(tempDir);
   285→  });
   286→
   287→  // AC: @trait-cli ac-5
   288→  it('should add trait to spec traits array', () => {
   289→    const result = kspecJson<{ added: boolean; spec: string; trait: string }>(
   290→      'item trait add @test-trait-feature @json-output',
   291→      tempDir
   292→    );
   293→
   294→    expect(result.added).toBe(true);
   295→    expect(result.spec).toContain('test-trait-feature');
   296→    expect(result.trait).toBe('@json-output');
   297→  });
   298→
   299→  it('should persist trait in spec file', async () => {
   300→    kspec('item trait add @test-trait-feature @json-output', tempDir);
   301→
   302→    const specFile = await fs.readFile(
   303→      path.join(tempDir, 'modules/test.yaml'),
   304→      'utf-8'
   305→    );
   306→
   307→    expect(specFile).toContain('traits:');
   308→    expect(specFile).toContain('- "@json-output"');
   309→  });
   310→
   311→  // AC: @trait-cli ac-6
   312→  it('should be idempotent - no duplicate when trait already added', async () => {
   313→    // Add trait once
   314→    kspec('item trait add @test-trait-feature @json-output', tempDir);
   315→
   316→    // Add again - should be idempotent
   317→    const result = kspecJson<{ added: boolean }>(
   318→      'item trait add @test-trait-feature @json-output',
   319→      tempDir
   320→    );
   321→
   322→    expect(result.added).toBe(false);
   323→
   324→    // Verify only one entry in file
   325→    const specFile = await fs.readFile(
   326→      path.join(tempDir, 'modules/test.yaml'),
   327→      'utf-8'
   328→    );
   329→
   330→    const traitMatches = specFile.match(/@json-output/g);
   331→    expect(traitMatches).toHaveLength(1);
   332→  });
   333→
   334→  // AC: @trait-cli ac-7
   335→  it('should error when trait does not exist', () => {
   336→    expect(() => {
   337→      kspec('item trait add @test-trait-feature @nonexistent-trait', tempDir);
   338→    }).toThrow();
   339→  });
   340→
   341→  it('should error when spec ref is invalid', () => {
   342→    expect(() => {
   343→      kspec('item trait add @nonexistent-spec @json-output', tempDir);
   344→    }).toThrow();
   345→  });
   346→
   347→  it('should error when adding trait to task', async () => {
   348→    // Create a task
   349→    const tasksFile = `_version: "0.1"
   350→_updated_at: "2026-01-20T00:00:00Z"
   351→
   352→tasks:
   353→  - _ulid: 01KFCVXQDD1122334455667788
   354→    slugs:
   355→      - test-task
   356→    title: Test Task
   357→    type: task
   358→    status: pending
   359→    priority: 2
   360→    spec_ref: "@test-trait-feature"
   361→    tags: []
   362→    depends_on: []
   363→    blocked_by: []
   364→    notes: []
   365→    todos: []
   366→    created_at: "2026-01-20T00:00:00Z"
   367→`;
   368→
   369→    await fs.writeFile(
   370→      path.join(tempDir, 'project.tasks.yaml'),
   371→      tasksFile
   372→    );
   373→
   374→    expect(() => {
   375→      kspec('item trait add @test-task @json-output', tempDir);
   376→    }).toThrow(/task/i);
   377→  });
   378→});
