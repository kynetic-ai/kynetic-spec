     1→/**
     2→ * E2E tests for trait CLI commands
     3→ * AC: @trait-cli ac-1, ac-2, ac-3, ac-4, ac-5, ac-6, ac-7, ac-8
     4→ */
     5→
     6→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     7→import * as fs from 'node:fs/promises';
     8→import * as path from 'node:path';
     9→import {
    10→  kspecOutput as kspec,
    11→  kspecJson,
    12→  setupTempFixtures,
    13→  cleanupTempDir,
    14→  initGitRepo,
    15→} from './helpers/cli';
    16→
    17→describe('Trait CLI - trait add', () => {
    18→  let tempDir: string;
    19→
    20→  beforeEach(async () => {
    21→    tempDir = await setupTempFixtures();
    22→    await initGitRepo(tempDir);
    23→  });
    24→
    25→  afterEach(async () => {
    26→    await cleanupTempDir(tempDir);
    27→  });
    28→
    29→  // AC: @trait-cli ac-1
    30→  it('should create trait-type item with title', () => {
    31→    const result = kspecJson<{ trait: { _ulid: string; title: string; type: string } }>(
    32→      'trait add "Test Trait"',
    33→      tempDir
    34→    );
    35→
    36→    expect(result.trait).toBeDefined();
    37→    expect(result.trait.title).toBe('Test Trait');
    38→    expect(result.trait.type).toBe('trait');
    39→    expect(result.trait._ulid).toMatch(/^[0-9A-Z]{26}$/);
    40→  });
    41→
    42→  // AC: @trait-cli ac-2
    43→  it('should set description field when --description provided', () => {
    44→    const result = kspecJson<{ trait: { title: string; description: string } }>(
    45→      'trait add "Test Trait" --description "This is a test trait"',
    46→      tempDir
    47→    );
    48→
    49→    expect(result.trait.description).toBe('This is a test trait');
    50→    expect(result.trait.title).toBe('Test Trait');
    51→  });
    52→
    53→  it('should allow custom slug', () => {
    54→    const result = kspecJson<{ trait: { slugs: string[] } }>(
    55→      'trait add "Test Trait" --slug test-trait-custom',
    56→      tempDir
    57→    );
    58→
    59→    expect(result.trait.slugs).toContain('test-trait-custom');
    60→  });
    61→
    62→  it('should add trait to kynetic.yaml traits array', async () => {
    63→    kspec('trait add "Test Trait"', tempDir);
    64→
    65→    const manifest = await fs.readFile(
    66→      path.join(tempDir, 'kynetic.yaml'),
    67→      'utf-8'
    68→    );
    69→
    70→    expect(manifest).toContain('traits:');
    71→    expect(manifest).toContain('title: Test Trait');
    72→    expect(manifest).toContain('type: trait');
    73→  });
    74→});
    75→
    76→describe('Trait CLI - trait list', () => {
    77→  let tempDir: string;
    78→
    79→  beforeEach(async () => {
    80→    tempDir = await setupTempFixtures();
    81→    await initGitRepo(tempDir);
    82→
    83→    // Create some traits
    84→    kspec('trait add "Trait One" --slug trait-one', tempDir);
    85→    kspec('trait add "Trait Two" --description "Second trait"', tempDir);
    86→    kspec('trait add "Trait Three" --slug trait-three', tempDir);
    87→
    88→    // Add AC to Trait One using CLI
    89→    kspec(
    90→      'item ac add @trait-one --given "condition" --when "action" --then "result"',
    91→      tempDir
    92→    );
    93→  });
    94→
    95→  afterEach(async () => {
    96→    await cleanupTempDir(tempDir);
    97→  });
    98→
    99→  // AC: @trait-cli ac-3
   100→  it('should list all traits with AC counts', () => {
   101→    const output = kspec('trait list', tempDir);
   102→
   103→    expect(output).toContain('Trait One');
   104→    expect(output).toContain('Trait Two');
   105→    expect(output).toContain('Trait Three');
   106→
   107→    // Should show AC count
   108→    expect(output).toMatch(/Trait One.*\(1 AC\)/);
   109→    expect(output).toMatch(/Trait Two.*\(no AC\)/);
   110→    expect(output).toMatch(/Trait Three.*\(no AC\)/);
   111→
   112→    expect(output).toContain('3 trait(s)');
   113→  });
   114→
   115→  it('should include trait refs in list output', () => {
   116→    const output = kspec('trait list', tempDir);
   117→
   118→    // Should show slug for trait-three
   119→    expect(output).toContain('@trait-three');
   120→  });
   121→
   122→  it('should return traits array in JSON mode', () => {
   123→    const result = kspecJson<{ traits: Array<{ title: string; acceptanceCriteria: unknown[] }> }>(
   124→      'trait list',
   125→      tempDir
   126→    );
   127→
   128→    expect(result.traits).toHaveLength(3);
   129→    expect(result.traits[0].title).toBe('Trait One');
   130→    expect(result.traits[0].acceptanceCriteria).toHaveLength(1);
   131→    expect(result.traits[1].acceptanceCriteria).toHaveLength(0);
   132→  });
   133→});
