   380→describe('Trait CLI - item trait remove', () => {
   381→  let tempDir: string;
   382→
   383→  beforeEach(async () => {
   384→    tempDir = await setupTempFixtures();
   385→    await initGitRepo(tempDir);
   386→
   387→    // Create traits
   388→    kspec('trait add "Trait One" --slug trait-one', tempDir);
   389→    kspec('trait add "Trait Two" --slug trait-two', tempDir);
   390→    kspec('trait add "JSON Output" --slug json-output', tempDir);
   391→
   392→    // Create a spec with both traits in a module file
   393→    await fs.mkdir(path.join(tempDir, 'modules'), { recursive: true });
   394→    const specModule = `_ulid: 01KFCVXQ00MODULE00000000000
   395→slugs:
   396→  - test-module
   397→title: Test Module
   398→type: module
   399→status:
   400→  maturity: draft
   401→  implementation: not_started
   402→
   403→features:
   404→  - _ulid: 01KFCVXQAABBCCDDEEFFGGHHXX
   405→    slugs:
   406→      - test-trait-feature
   407→    title: Test Trait Feature
   408→    type: feature
   409→    status:
   410→      maturity: draft
   411→      implementation: not_started
   412→    traits:
   413→      - "@trait-one"
   414→      - "@trait-two"
   415→`;
   416→    await fs.writeFile(
   417→      path.join(tempDir, 'modules/test.yaml'),
   418→      specModule
   419→    );
   420→
   421→    const manifest = await fs.readFile(
   422→      path.join(tempDir, 'kynetic.yaml'),
   423→      'utf-8'
   424→    );
   425→    const updatedManifest = manifest.replace(
   426→      'includes:\n  - modules/core.yaml',
   427→      'includes:\n  - modules/core.yaml\n  - modules/test.yaml'
   428→    );
   429→    await fs.writeFile(
   430→      path.join(tempDir, 'kynetic.yaml'),
   431→      updatedManifest
   432→    );
   433→  });
   434→
   435→  afterEach(async () => {
   436→    await cleanupTempDir(tempDir);
   437→  });
   438→
   439→  // AC: @trait-cli ac-8
   440→  it('should remove trait from traits array', () => {
   441→    const result = kspecJson<{ removed: boolean; spec: string; trait: string }>(
   442→      'item trait remove @test-trait-feature @trait-one',
   443→      tempDir
   444→    );
   445→
   446→    expect(result.removed).toBe(true);
   447→    expect(result.spec).toContain('test-trait-feature');
   448→    expect(result.trait).toBe('@trait-one');
   449→  });
   450→
   451→  it('should persist removal in spec file', async () => {
   452→    kspec('item trait remove @test-trait-feature @trait-one', tempDir);
   453→
   454→    const specFile = await fs.readFile(
   455→      path.join(tempDir, 'modules/test.yaml'),
   456→      'utf-8'
   457→    );
   458→
   459→    expect(specFile).not.toContain('@trait-one');
   460→    expect(specFile).toContain('@trait-two'); // Should still have the other trait
   461→  });
   462→
   463→  it('should warn when trait not in spec traits array', () => {
   464→    const result = kspecJson<{ removed: boolean }>(
   465→      'item trait remove @test-trait-feature @json-output',
   466→      tempDir
   467→    );
   468→
   469→    expect(result.removed).toBe(false);
   470→  });
   471→
   472→  it('should allow removing all traits', async () => {
   473→    kspec('item trait remove @test-trait-feature @trait-one', tempDir);
   474→    kspec('item trait remove @test-trait-feature @trait-two', tempDir);
   475→
   476→    const specFile = await fs.readFile(
   477→      path.join(tempDir, 'modules/test.yaml'),
   478→      'utf-8'
   479→    );
   480→
   481→    // Traits array should be empty
   482→    expect(specFile).toMatch(/traits:\s*\[\]/);
   483→  });
   484→
   485→  it('should error when trait ref is invalid', () => {
   486→    expect(() => {
   487→      kspec('item trait remove @test-trait-feature @nonexistent', tempDir);
   488→    }).toThrow();
   489→  });
   490→});
