   135→describe('Trait CLI - trait get', () => {
   136→  let tempDir: string;
   137→
   138→  beforeEach(async () => {
   139→    tempDir = await setupTempFixtures();
   140→    await initGitRepo(tempDir);
   141→
   142→    // Create a trait with AC
   143→    kspec('trait add "JSON Output Support" --slug json-output --description "Trait for JSON support"', tempDir);
   144→
   145→    // Add ACs using CLI
   146→    kspec(
   147→      'item ac add @json-output --given "command with --json flag" --when "executed" --then "outputs valid JSON"',
   148→      tempDir
   149→    );
   150→    kspec(
   151→      'item ac add @json-output --given "JSON output" --when "parsed" --then "contains required fields"',
   152→      tempDir
   153→    );
   154→  });
   155→
   156→  afterEach(async () => {
   157→    await cleanupTempDir(tempDir);
   158→  });
   159→
   160→  // AC: @trait-cli ac-4
   161→  it('should show trait details and acceptance criteria', () => {
   162→    const output = kspec('trait get @json-output', tempDir);
   163→
   164→    expect(output).toContain('JSON Output Support');
   165→    expect(output).toContain('Type:      trait');
   166→    expect(output).toContain('Slug:      @json-output');
   167→    expect(output).toContain('Trait for JSON support');
   168→
   169→    // AC: @trait-cli ac-4 - show acceptance criteria
   170→    expect(output).toContain('Acceptance Criteria');
   171→    expect(output).toContain('[ac-1]');
   172→    expect(output).toContain('Given: command with --json flag');
   173→    expect(output).toContain('When: executed');
   174→    expect(output).toContain('Then: outputs valid JSON');
   175→
   176→    expect(output).toContain('[ac-2]');
   177→    expect(output).toContain('Given: JSON output');
   178→  });
   179→
   180→  it('should show usage count when trait is used', async () => {
   181→    // Create a spec that uses the trait
   182→    await fs.mkdir(path.join(tempDir, 'modules'), { recursive: true });
   183→    const specModule = `_ulid: 01KFCVXQAABBCCDDEEFFGGHHXX
   184→slugs:
   185→  - test-spec
   186→title: Test Spec
   187→type: module
   188→traits:
   189→  - "@json-output"
   190→`;
   191→    await fs.writeFile(
   192→      path.join(tempDir, 'modules/test.yaml'),
   193→      specModule
   194→    );
   195→
   196→    const manifest = await fs.readFile(
   197→      path.join(tempDir, 'kynetic.yaml'),
   198→      'utf-8'
   199→    );
   200→    const updatedManifest = manifest.replace(
   201→      'includes:\n  - modules/core.yaml',
   202→      'includes:\n  - modules/core.yaml\n  - modules/test.yaml'
   203→    );
   204→    await fs.writeFile(
   205→      path.join(tempDir, 'kynetic.yaml'),
   206→      updatedManifest
   207→    );
   208→
   209→    const output = kspec('trait get @json-output', tempDir);
   210→
   211→    expect(output).toContain('Used by 1 spec(s)');
   212→  });
   213→
   214→  it('should return full trait data in JSON mode', () => {
   215→    const result = kspecJson<{
   216→      trait: {
   217→        ulid: string;
   218→        slug: string;
   219→        title: string;
   220→        description: string;
   221→        acceptanceCriteria: Array<{ id: string; given: string; when: string; then: string }>;
   222→      };
   223→    }>('trait get @json-output', tempDir);
   224→
   225→    expect(result.trait.title).toBe('JSON Output Support');
   226→    expect(result.trait.slug).toBe('json-output');
   227→    expect(result.trait.description).toBe('Trait for JSON support');
   228→    expect(result.trait.acceptanceCriteria).toHaveLength(2);
   229→    expect(result.trait.acceptanceCriteria[0].id).toBe('ac-1');
   230→  });
   231→});
