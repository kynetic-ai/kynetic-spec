```
     1→import { Command } from 'commander';
     2→import {
     3→  initContext,
     4→  loadAllTasks,
     5→  loadAllItems,
     6→  saveTask,
     7→  createTask,
     8→  createNote,
     9→  getAuthor,
    10→  ReferenceIndex,
    11→  AlignmentIndex,
    12→  type LoadedTask,
    13→  type LoadedSpecItem,
    14→  type KspecContext,
    15→} from '../../parser/index.js';
    16→import { commitIfShadow } from '../../parser/shadow.js';
    17→import { output, success, error, warn, info, isJsonMode } from '../output.js';
    18→import type { TaskInput } from '../../schema/index.js';
    19→import { errors } from '../../strings/index.js';
    20→import { EXIT_CODES } from '../exit-codes.js';
    21→
    22→/**
    23→ * Fields that contain nested spec items (mirrors yaml.ts)
    24→ */
    25→const NESTED_ITEM_FIELDS = ['modules', 'features', 'requirements', 'constraints', 'decisions'];
    26→
    27→/**
    28→ * Get the parent path from a child's _path.
    29→ * e.g., "features[0].requirements[1]" -> "features[0]"
    30→ * Returns empty string for top-level items.
    31→ */
    32→function getParentPath(childPath: string | undefined): string {
    33→  if (!childPath) return '';
    34→  const lastDotIndex = childPath.lastIndexOf('.');
    35→  if (lastDotIndex === -1) return '';
    36→  return childPath.slice(0, lastDotIndex);
    37→}
    38→
    39→/**
    40→ * Check if an item is a direct child of another item based on _path.
    41→ * Direct children have a path that extends the parent's path by exactly one field[index].
    42→ */
    43→function isDirectChildOf(child: LoadedSpecItem, parent: LoadedSpecItem): boolean {
    44→  const childPath = child._path || '';
    45→  const parentPath = parent._path || '';
    46→
    47→  // If paths are equal, not a child
    48→  if (childPath === parentPath) return false;
    49→
    50→  // Child path must start with parent path
    51→  if (parentPath && !childPath.startsWith(parentPath + '.')) return false;
    52→
    53→  // For root parent (empty path), child must be a top-level path like "features[0]"
    54→  if (!parentPath) {
    55→    // Direct child of root has no '.' in its path
    56→    return !childPath.includes('.');
    57→  }
    58→
    59→  // Get the remaining path after parent
    60→  const remaining = childPath.slice(parentPath.length + 1);
    61→
    62→  // Direct child has no additional '.' (e.g., "requirements[0]" not "requirements[0].something")
    63→  return !remaining.includes('.');
    64→}
    65→
    66→/**
    67→ * Find the parent spec item of a given item.
    68→ * Returns undefined for root-level items.
    69→ */
    70→function findParentItem(
    71→  item: LoadedSpecItem,
    72→  allItems: LoadedSpecItem[]
    73→): LoadedSpecItem | undefined {
    74→  const parentPath = getParentPath(item._path);
    75→
    76→  // Root-level item or no path
    77→  if (!parentPath && !item._path) return undefined;
    78→  if (!parentPath) return undefined;
    79→
    80→  // Find item with matching path in the same source file
    81→  return allItems.find(
    82→    i => i._path === parentPath && i._sourceFile === item._sourceFile
    83→  );
    84→}
    85→
    86→/**
    87→ * Get direct children of a spec item.
    88→ * Only returns immediate children, not grandchildren.
    89→ */
    90→function getDirectChildren(
    91→  parent: LoadedSpecItem,
    92→  allItems: LoadedSpecItem[]
    93→): LoadedSpecItem[] {
    94→  return allItems.filter(
    95→    item => item._sourceFile === parent._sourceFile && isDirectChildOf(item, parent)
    96→  );
    97→}
    98→
    99→/**
   100→ * Collect an item and all its descendants in topological order (parent first).
   101→ * This ensures parent tasks are created before child tasks.
   102→ */
   103→function collectItemsRecursively(
   104→  root: LoadedSpecItem,
   105→  allItems: LoadedSpecItem[]
   106→): LoadedSpecItem[] {
   107→  const result: LoadedSpecItem[] = [root];
   108→  const children = getDirectChildren(root, allItems);
   109→
   110→  for (const child of children) {
   111→    const descendants = collectItemsRecursively(child, allItems);
   112→    result.push(...descendants);
   113→  }
   114→
   115→  return result;
   116→}
   117→
   118→/**
   119→ * Resolve a spec item reference.
   120→ * Returns the spec item or exits with error.
   121→ */
   122→function resolveSpecRef(
   123→  ref: string,
   124→  items: LoadedSpecItem[],
   125→  tasks: LoadedTask[],
   126→  index: ReferenceIndex
   127→): LoadedSpecItem {
   128→  const result = index.resolve(ref);
   129→
   130→  if (!result.ok) {
   131→    switch (result.error) {
   132→      case 'not_found':
   133→        error(errors.reference.specNotFound(ref));
   134→        break;
   135→      case 'ambiguous':
   136→        error(errors.reference.ambiguous(ref));
   137→        for (const candidate of result.candidates) {
   138→          const item = items.find(i => i._ulid === candidate);
   139→          const slug = item?.slugs[0] || '';
   140→          console.error(`  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ''}`);
   141→        }
   142→        break;
   143→      case 'duplicate_slug':
   144→        error(errors.reference.slugMapsToMultiple(ref));
   145→        for (const candidate of result.candidates) {
   146→          console.error(`  - ${index.shortUlid(candidate)}`);
   147→        }
   148→        break;
   149→    }
   150→    process.exit(EXIT_CODES.NOT_FOUND);
   151→  }
   152→
   153→  // Check if it's actually a spec item (not a task)
   154→  const item = items.find(i => i._ulid === result.ulid);
   155→  if (!item) {
   156→    // Check if it's a task
   157→    const task = tasks.find(t => t._ulid === result.ulid);
   158→    if (task) {
   159→      error(errors.reference.notSpecItem(ref));
   160→    } else {
   161→      error(errors.reference.specNotFound(ref));
   162→    }
   163→    process.exit(EXIT_CODES.NOT_FOUND);
   164→  }
   165→
   166→  return item;
   167→}
   168→
   169→/**
   170→ * Generate a slug from a spec item title.
   171→ * Converts "My Feature Title" -> "task-my-feature-title"
   172→ */
   173→function generateSlugFromTitle(title: string): string {
   174→  return (
   175→    'task-' +
   176→    title
   177→      .toLowerCase()
   178→      .replace(/[^a-z0-9]+/g, '-')
   179→      .replace(/^-|-$/g, '')
   180→      .slice(0, 50)
   181→  );
   182→}
   183→
   184→/**
   185→ * Convert spec priority to task priority (number).
   186→ * Spec can use 'high', 'medium', 'low' or numeric 1-5.
   187→ */
   188→function normalizePriority(priority: string | number | undefined): number {
   189→  if (priority === undefined) return 3;
   190→  if (typeof priority === 'number') return priority;
   191→  switch (priority) {
   192→    case 'high':
   193→      return 1;
   194→    case 'medium':
   195→      return 3;
   196→    case 'low':
   197→      return 5;
   198→    default:
   199→      return 3;
   200→  }
   201→}
   202→
   203→/**
   204→ * Result of deriving a task from a spec item
   205→ */
   206→interface DeriveResult {
   207→  specItem: LoadedSpecItem;
   208→  action: 'created' | 'skipped' | 'would_create';
   209→  task?: LoadedTask;
   210→  reason?: string;
   211→  /** Task ref that was used for depends_on (if any) */
   212→  dependsOn?: string[];
   213→}
   214→
   215→/**
   216→ * Generate implementation notes from spec item for newly derived task.
   217→ * Includes description and acceptance criteria summary.
   218→ */
   219→function generateImplementationNotes(specItem: LoadedSpecItem): string | undefined {
   220→  const parts: string[] = [];
   221→
   222→  // Add description if present
   223→  if (specItem.description) {
   224→    parts.push(specItem.description.trim());
   225→  }
   226→
   227→  // Add acceptance criteria summary if present
   228→  if (specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
   229→    const acSection = ['', 'Acceptance Criteria:'];
   230→    for (const ac of specItem.acceptance_criteria) {
   231→      const summary = `${ac.given ? 'Given ' + ac.given + ', ' : ''}when ${ac.when}, then ${ac.then}`;
   232→      acSection.push(`- ${ac.id}: ${summary}`);
   233→    }
   234→    parts.push(acSection.join('\n'));
   235→  }
   236→
   237→  // Return combined content, or undefined if nothing to add
   238→  return parts.length > 0 ? parts.join('\n\n') : undefined;
   239→}
   240→
   241→/**
   242→ * Derive a task from a spec item.
   243→ * Returns result describing what happened.
   244→ *
   245→ * @param dependsOn - Task references to add as dependencies (for hierarchy-based deps)
   246→ * @param priority - Priority override (1-5), if not provided uses spec's priority
   247→ */
   248→async function deriveTaskFromSpec(
   249→  ctx: KspecContext,
   250→  specItem: LoadedSpecItem,
   251→  existingTasks: LoadedTask[],
   252→  items: LoadedSpecItem[],
   253→  index: ReferenceIndex,
   254→  alignmentIndex: AlignmentIndex,
   255→  options: { force: boolean; dryRun: boolean; dependsOn?: string[]; priority?: number }
   256→): Promise<DeriveResult> {
   257→  // Check if a task already exists for this spec
   258→  const linkedTasks = alignmentIndex.getTasksForSpec(specItem._ulid);
   259→
   260→  if (linkedTasks.length > 0 && !options.force) {
   261→    const taskRef = linkedTasks[0].slugs[0]
   262→      ? `@${linkedTasks[0].slugs[0]}`
   263→      : `@${index.shortUlid(linkedTasks[0]._ulid)}`;
   264→    return {
   265→      specItem,
   266→      action: 'skipped',
   267→      task: linkedTasks[0],
   268→      reason: `task exists: ${taskRef}`,
   269→    };
   270→  }
   271→
   272→  // Check if slug would collide with existing task
   273→  const baseSlug = generateSlugFromTitle(specItem.title);
   274→  let slug = baseSlug;
   275→  let slugSuffix = 1;
   276→
   277→  // Find unique slug if needed
   278→  while (existingTasks.some(t => t.slugs.includes(slug))) {
   279→    slug = `${baseSlug}-${slugSuffix}`;
   280→    slugSuffix++;
   281→  }
   282→
   283→  // Generate implementation notes from spec
   284→  // AC: @cmd-derive ac-author
   285→  const noteContent = generateImplementationNotes(specItem);
   286→  const initialNotes = noteContent
   287→    ? [createNote(`Implementation notes (auto-generated from spec):\n\n${noteContent}`, getAuthor())]
   288→    : [];
   289→
   290→  // Build task input with depends_on and initial notes
   291→  const taskInput: TaskInput = {
   292→    title: `Implement: ${specItem.title}`,
   293→    type: 'task',
   294→    spec_ref: `@${specItem.slugs[0] || specItem._ulid}`,
   295→    derivation: 'auto',
   296→    priority: options.priority ?? normalizePriority(specItem.priority),
   297→    slugs: [slug],
   298→    tags: [...(specItem.tags || [])],
   299→    depends_on: options.dependsOn || [],
   300→    notes: initialNotes,
   301→  };
   302→
   303→  // Dry run - don't actually create
   304→  if (options.dryRun) {
   305→    const previewTask = createTask(taskInput) as LoadedTask;
   306→    return {
   307→      specItem,
   308→      action: 'would_create',
   309→      task: previewTask,
   310→      dependsOn: options.dependsOn,
   311→    };
   312→  }
   313→
   314→  // Create and save the task
   315→  const newTask = createTask(taskInput);
   316→  await saveTask(ctx, newTask);
   317→  const specSlug = specItem.slugs[0] || specItem._ulid.slice(0, 8);
   318→  await commitIfShadow(ctx.shadow, 'derive', specSlug);
   319→
   320→  // Add to existing tasks list for slug collision checks
   321→  existingTasks.push(newTask as LoadedTask);
   322→
   323→  return {
   324→    specItem,
   325→    action: 'created',
   326→    task: newTask as LoadedTask,
   327→    dependsOn: options.dependsOn,
   328→  };
   329→}
   330→
   331→/**
   332→ * Get a task reference string for use in depends_on.
   333→ * Prefers slug over ULID for readability.
   334→ */
   335→function getTaskRef(task: LoadedTask, index: ReferenceIndex): string {
   336→  return task.slugs[0] ? `@${task.slugs[0]}` : `@${index.shortUlid(task._ulid)}`;
   337→}
   338→
   339→/**
   340→ * Find or get the task for a parent spec item.
   341→ * Looks in:
   342→ * 1. Tasks created in this derive session (specToTaskMap)
   343→ * 2. Existing tasks linked to the parent spec (alignmentIndex)
   344→ */
   345→function getParentTaskRef(
   346→  parentSpec: LoadedSpecItem,
   347→  specToTaskMap: Map<string, LoadedTask>,
   348→  alignmentIndex: AlignmentIndex,
   349→  index: ReferenceIndex
   350→): string | undefined {
   351→  // Check if we created a task for this parent in this session
   352→  const sessionTask = specToTaskMap.get(parentSpec._ulid);
   353→  if (sessionTask) {
   354→    return getTaskRef(sessionTask, index);
   355→  }
   356→
   357→  // Check if an existing task is linked to this parent spec
   358→  const linkedTasks = alignmentIndex.getTasksForSpec(parentSpec._ulid);
   359→  if (linkedTasks.length > 0) {
   360→    return getTaskRef(linkedTasks[0], index);
   361→  }
   362→
   363→  return undefined;
   364→}
   365→
   366→/**
   367→ * Register the 'derive' command
   368→ */
   369→export function registerDeriveCommand(program: Command): void {
   370→  program
   371→    .command('derive [ref]')
   372→    .description('Create task(s) from spec item(s)')
   373→    .option('--all', 'Derive tasks for all spec items without linked tasks')
   374→    .option('--flat', 'Only derive for the specified item, not children (default: recursive)')
   375→    .option('--force', 'Create task even if one already exists for the spec')
   376→    .option('--dry-run', 'Show what would be created without making changes')
   377→    .option('--priority <n>', 'Set priority for created task(s) (1-5)', parseInt)
   378→    .action(async (ref: string | undefined, options) => {
   379→      try {
   380→        // Validate arguments
   381→        if (!ref && !options.all) {
   382→          error(errors.usage.deriveNoRef);
   383→          console.error('Usage:');
   384→          console.error('  kspec derive @spec-ref');
   385→          console.error('  kspec derive @spec-ref --flat');
   386→          console.error('  kspec derive --all');
   387→          process.exit(EXIT_CODES.USAGE_ERROR);
   388→        }
   389→
   390→        if (ref && options.all) {
   391→          error(errors.usage.deriveRefAndAll);
   392→          process.exit(EXIT_CODES.USAGE_ERROR);
   393→        }
   394→
   395→        // Validate priority if provided
   396→        if (options.priority !== undefined) {
   397→          if (isNaN(options.priority) || options.priority < 1 || options.priority > 5) {
   398→            error('Priority must be a number between 1 and 5');
   399→            process.exit(EXIT_CODES.USAGE_ERROR);
   400→          }
   401→        }
   402→
   403→        const ctx = await initContext();
   404→        const tasks = await loadAllTasks(ctx);
   405→        const items = await loadAllItems(ctx);
   406→        const index = new ReferenceIndex(tasks, items);
   407→
   408→        // Build alignment index
   409→        const alignmentIndex = new AlignmentIndex(tasks, items);
   410→        alignmentIndex.buildLinks(index);
   411→
   412→        // Collect spec items to process
   413→        let specsToDerive: LoadedSpecItem[];
   414→
   415→        if (options.all) {
   416→          // Get all spec items without linked tasks
   417→          specsToDerive = items.filter(item => {
   418→            const linkedTasks = alignmentIndex.getTasksForSpec(item._ulid);
   419→            return linkedTasks.length === 0 || options.force;
   420→          });
   421→
   422→          if (specsToDerive.length === 0) {
   423→            if (isJsonMode()) {
   424→              console.log(JSON.stringify([]));
   425→            } else {
   426→              info('Nothing to derive (all items have tasks)');
   427→            }
   428→            return;
   429→          }
   430→        } else {
   431→          // Single spec item - recursive by default, flat if --flat
   432→          const specItem = resolveSpecRef(ref!, items, tasks, index);
   433→
   434→          if (options.flat) {
   435→            specsToDerive = [specItem];
   436→          } else {
   437→            // Recursive: collect item and all descendants
   438→            specsToDerive = collectItemsRecursively(specItem, items);
   439→          }
   440→        }
   441→
   442→        // Track spec ULID -> created task for dependency resolution
   443→        const specToTaskMap = new Map<string, LoadedTask>();
   444→
   445→        // Process each spec item in order (parents before children due to topological sort)
   446→        const results: DeriveResult[] = [];
   447→
   448→        for (const specItem of specsToDerive) {
   449→          // Determine depends_on based on parent spec's task
   450→          let dependsOn: string[] | undefined;
   451→
   452→          if (!options.flat && !options.all) {
   453→            // Find the parent spec item
   454→            const parentSpec = findParentItem(specItem, items);
   455→
   456→            if (parentSpec) {
   457→              const parentTaskRef = getParentTaskRef(
   458→                parentSpec,
   459→                specToTaskMap,
   460→                alignmentIndex,
   461→                index
   462→              );
   463→              if (parentTaskRef) {
   464→                dependsOn = [parentTaskRef];
   465→              }
   466→            }
   467→          }
   468→
   469→          const result = await deriveTaskFromSpec(
   470→            ctx,
   471→            specItem,
   472→            tasks,
   473→            items,
   474→            index,
   475→            alignmentIndex,
   476→            {
   477→              force: options.force || false,
   478→              dryRun: options.dryRun || false,
   479→              dependsOn,
   480→              priority: options.priority,
   481→            }
   482→          );
   483→
   484→          // Track created/would_create tasks for dependency resolution
   485→          if (result.task && (result.action === 'created' || result.action === 'would_create')) {
   486→            specToTaskMap.set(specItem._ulid, result.task);
   487→          }
   488→          // Also track skipped tasks (existing) for dependency resolution
   489→          if (result.action === 'skipped' && result.task) {
   490→            specToTaskMap.set(specItem._ulid, result.task);
   491→          }
   492→
   493→          results.push(result);
   494→        }
   495→
   496→        // Output results
   497→        if (isJsonMode()) {
   498→          // JSON output format - simplified per AC
   499→          const jsonOutput = results.map(r => ({
   500→            ulid: r.task?._ulid || null,
   501→            slug: r.task?.slugs[0] || null,
   502→            spec_ref: `@${r.specItem.slugs[0] || r.specItem._ulid}`,
   503→            depends_on: r.task?.depends_on || [],
   504→            action: r.action,
   505→          }));
   506→          console.log(JSON.stringify(jsonOutput, null, 2));
   507→          return; // Don't call output() which would output full results in global JSON mode
   508→        } else {
   509→          // Human-readable output
   510→          output(results, () => {
   511→            const created = results.filter(r => r.action === 'created');
   512→            const skipped = results.filter(r => r.action === 'skipped');
   513→            const wouldCreate = results.filter(r => r.action === 'would_create');
   514→
   515→            if (options.dryRun) {
   516→              console.log('Would create:');
   517→              for (const r of wouldCreate) {
   518→                const taskSlug = r.task?.slugs[0] || '';
   519→                const deps = r.dependsOn?.length ? ` (depends: ${r.dependsOn.join(', ')})` : '';
   520→                console.log(`  + ${r.specItem.title}`);
   521→                console.log(`    -> ${taskSlug}${deps}`);
   522→              }
   523→              if (skipped.length > 0) {
   524→                console.log('\nSkipped:');
   525→                for (const r of skipped) {
   526→                  const specRef = r.specItem.slugs[0] ? `@${r.specItem.slugs[0]}` : `@${index.shortUlid(r.specItem._ulid)}`;
   527→                  console.log(`  - ${specRef} (${r.reason})`);
   528→                }
   529→              }
   530→              console.log(`\nWould create ${wouldCreate.length} task(s)`);
   531→              if (skipped.length > 0) {
   532→                console.log(`Skipped ${skipped.length} (already have tasks)`);
   533→              }
   534→              return;
   535→            }
   536→
   537→            if (created.length > 0) {
   538→              for (const r of created) {
   539→                const taskSlug = r.task?.slugs[0] || '';
   540→                const deps = r.dependsOn?.length ? ` (depends: ${r.dependsOn.join(', ')})` : '';
   541→                console.log(`OK Created task: ${taskSlug}${deps}`);
   542→              }
   543→            }
   544→
   545→            if (skipped.length > 0 && !options.all) {
   546→              // Show skipped for explicit derive (not --all)
   547→              for (const r of skipped) {
   548→                const specRef = r.specItem.slugs[0] ? `@${r.specItem.slugs[0]}` : `@${index.shortUlid(r.specItem._ulid)}`;
   549→                console.log(`Skipped ${specRef} (${r.reason})`);
   550→              }
   551→            }
   552→
   553→            // Summary
   554→            if (created.length > 0 || skipped.length > 0) {
   555→              console.log('');
   556→              if (created.length > 0) {
   557→                console.log(`Created ${created.length} task(s)`);
   558→              }
   559→              if (skipped.length > 0) {
   560→                console.log(`Skipped ${skipped.length} (already have tasks)`);
   561→              }
   562→            }
   563→          });
   564→        }
   565→      } catch (err) {
   566→        error(errors.failures.deriveTasks, err);
   567→        process.exit(EXIT_CODES.ERROR);
   568→      }
   569→    });
   570→}
   571→

