```
     1→/**
     2→ * Workflow run CLI commands
     3→ *
     4→ * Implements workflow run lifecycle management:
     5→ * - kspec workflow start @ref [--task @ref] [--json]
     6→ * - kspec workflow runs [--active] [--completed] [--workflow @ref] [--json]
     7→ * - kspec workflow show @run [--json]
     8→ * - kspec workflow abort @run [--reason text] [--json]
     9→ */
    10→
    11→import { Command } from 'commander';
    12→import { ulid } from 'ulid';
    13→import chalk from 'chalk';
    14→import Table from 'cli-table3';
    15→import {
    16→  initContext,
    17→  loadMetaContext,
    18→  loadWorkflowRuns,
    19→  saveWorkflowRun,
    20→  updateWorkflowRun,
    21→  findWorkflowRunByRef,
    22→  findActiveRuns,
    23→  getAuthor,
    24→  ReferenceIndex,
    25→  loadAllTasks,
    26→  type Workflow,
    27→} from '../../parser/index.js';
    28→import type { WorkflowRun } from '../../schema/index.js';
    29→import { commitIfShadow } from '../../parser/shadow.js';
    30→import { output, success, error, isJsonMode } from '../output.js';
    31→import { errors } from '../../strings/errors.js';
    32→import { EXIT_CODES } from '../exit-codes.js';
    33→
    34→/**
    35→ * Find a workflow by reference
    36→ */
    37→function resolveWorkflowRef(ref: string, workflows: Workflow[]): Workflow | null {
    38→  const cleanRef = ref.startsWith('@') ? ref.slice(1) : ref;
    39→
    40→  // Try by ID first
    41→  let workflow = workflows.find((w) => w.id === cleanRef);
    42→  if (workflow) return workflow;
    43→
    44→  // Try by ULID or ULID prefix
    45→  workflow = workflows.find((w) => w._ulid === cleanRef || w._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()));
    46→  return workflow || null;
    47→}
    48→
    49→/**
    50→ * Format a short ULID (first 8 chars)
    51→ */
    52→function shortUlid(ulid: string): string {
    53→  return ulid.slice(0, 8).toUpperCase();
    54→}
    55→
    56→/**
    57→ * Format run status with color
    58→ */
    59→function formatStatus(status: string): string {
    60→  switch (status) {
    61→    case 'active':
    62→      return chalk.green(status);
    63→    case 'paused':
    64→      return chalk.yellow(status);
    65→    case 'completed':
    66→      return chalk.blue(status);
    67→    case 'aborted':
    68→      return chalk.red(status);
    69→    default:
    70→      return status;
    71→  }
    72→}
    73→
    74→/**
    75→ * Command: kspec workflow start @workflow-ref [--task @task-ref] [--json]
    76→ * AC: @workflow-run-foundation ac-1, ac-6
    77→ */
    78→async function workflowStart(workflowRef: string, options: { task?: string; json?: boolean }) {
    79→  const ctx = await initContext();
    80→  const metaCtx = await loadMetaContext(ctx);
    81→
    82→  // DEBUG: Log loaded workflows
    83→  // Resolve workflow reference
    84→  const workflow = resolveWorkflowRef(workflowRef, metaCtx.workflows);
    85→  if (!workflow) {
    86→    error(errors.workflowRun.workflowNotFound(workflowRef));
    87→    process.exit(EXIT_CODES.NOT_FOUND);
    88→  }
    89→
    90→  // Validate task reference if provided (AC: @workflow-run-foundation ac-6)
    91→  let taskRef: string | undefined;
    92→  if (options.task) {
    93→    const tasks = await loadAllTasks(ctx);
    94→    const index = new ReferenceIndex(tasks, []);
    95→    const result = index.resolve(options.task);
    96→    if (!result.ok) {
    97→      error(errors.reference.taskNotFound(options.task));
    98→      process.exit(EXIT_CODES.NOT_FOUND);
    99→    }
   100→    taskRef = `@${result.ulid}`;
   101→  }
   102→
   103→  // Create new workflow run
   104→  const run: WorkflowRun = {
   105→    _ulid: ulid(),
   106→    workflow_ref: `@${workflow._ulid}`,
   107→    status: 'active',
   108→    current_step: 0,
   109→    total_steps: workflow.steps.length,
   110→    started_at: new Date().toISOString(),
   111→    step_results: [],
   112→    initiated_by: getAuthor(),
   113→    task_ref: taskRef,
   114→  };
   115→
   116→  // Save the run
   117→  await saveWorkflowRun(ctx, run);
   118→
   119→  // Commit to shadow
   120→  await commitIfShadow(ctx.shadow, 'workflow-start');
   121→
   122→  // Output result
   123→  if (isJsonMode()) {
   124→    output({ run_id: run._ulid, workflow_ref: run.workflow_ref, status: run.status });
   125→  } else {
   126→    success(`Started workflow run: ${shortUlid(run._ulid)}`);
   127→    console.log(`  Workflow: ${workflow.id}`);
   128→    console.log(`  Steps: ${run.total_steps}`);
   129→    if (taskRef) {
   130→      console.log(`  Linked task: ${taskRef}`);
   131→    }
   132→  }
   133→}
   134→
   135→/**
   136→ * Command: kspec workflow runs [--active] [--completed] [--workflow @ref] [--json]
   137→ * AC: @workflow-run-foundation ac-2
   138→ */
   139→async function workflowRuns(options: {
   140→  active?: boolean;
   141→  completed?: boolean;
   142→  workflow?: string;
   143→  json?: boolean;
   144→}) {
   145→  const ctx = await initContext();
   146→  const metaCtx = await loadMetaContext(ctx);
   147→  let runs = await loadWorkflowRuns(ctx);
   148→
   149→  // Apply filters
   150→  if (options.active) {
   151→    runs = runs.filter((r) => r.status === 'active');
   152→  }
   153→  if (options.completed) {
   154→    runs = runs.filter((r) => r.status === 'completed');
   155→  }
   156→  if (options.workflow) {
   157→    const workflow = resolveWorkflowRef(options.workflow, metaCtx.workflows);
   158→    if (!workflow) {
   159→      error(errors.workflowRun.workflowNotFound(options.workflow));
   160→      process.exit(EXIT_CODES.NOT_FOUND);
   161→    }
   162→    runs = runs.filter((r) => r.workflow_ref === `@${workflow._ulid}`);
   163→  }
   164→
   165→  if (isJsonMode()) {
   166→    output({ runs });
   167→  } else {
   168→    if (runs.length === 0) {
   169→      console.log(chalk.gray('No workflow runs found'));
   170→      return;
   171→    }
   172→
   173→    const table = new Table({
   174→      head: ['ID', 'Workflow', 'Status', 'Step', 'Started'],
   175→      colWidths: [12, 25, 12, 10, 20],
   176→    });
   177→
   178→    for (const run of runs) {
   179→      const workflow = metaCtx.workflows.find((w) => `@${w._ulid}` === run.workflow_ref);
   180→      const workflowName = workflow?.id || run.workflow_ref;
   181→      const stepProgress = `${run.current_step}/${run.total_steps}`;
   182→      const started = new Date(run.started_at).toLocaleString();
   183→
   184→      table.push([
   185→        shortUlid(run._ulid),
   186→        workflowName,
   187→        formatStatus(run.status),
   188→        stepProgress,
   189→        started,
   190→      ]);
   191→    }
   192→
   193→    console.log(table.toString());
   194→  }
   195→}
   196→
   197→/**
   198→ * Command: kspec workflow show @run-id [--json]
   199→ * AC: @workflow-run-foundation ac-4
   200→ */
   201→async function workflowShow(runRef: string, options: { json?: boolean }) {
   202→  const ctx = await initContext();
   203→  const metaCtx = await loadMetaContext(ctx);
   204→
   205→  const run = await findWorkflowRunByRef(ctx, runRef);
   206→  if (!run) {
   207→    error(errors.workflowRun.runNotFound(runRef));
   208→    process.exit(EXIT_CODES.NOT_FOUND);
   209→  }
   210→
   211→  if (isJsonMode()) {
   212→    output({ run });
   213→  } else {
   214→    const workflow = metaCtx.workflows.find((w) => `@${w._ulid}` === run.workflow_ref);
   215→    const workflowName = workflow?.id || run.workflow_ref;
   216→
   217→    console.log(chalk.bold('Workflow Run Details'));
   218→    console.log(chalk.gray('─'.repeat(50)));
   219→    console.log(`ID:           ${shortUlid(run._ulid)}`);
   220→    console.log(`Workflow:     ${workflowName} (${run.workflow_ref})`);
   221→    console.log(`Status:       ${formatStatus(run.status)}`);
   222→    console.log(`Progress:     ${run.current_step}/${run.total_steps}`);
   223→    console.log(`Started:      ${new Date(run.started_at).toLocaleString()}`);
   224→
   225→    if (run.initiated_by) {
   226→      console.log(`Initiated by: ${run.initiated_by}`);
   227→    }
   228→    if (run.task_ref) {
   229→      console.log(`Task:         ${run.task_ref}`);
   230→    }
   231→    if (run.paused_at) {
   232→      console.log(`Paused:       ${new Date(run.paused_at).toLocaleString()}`);
   233→    }
   234→    if (run.completed_at) {
   235→      console.log(`Completed:    ${new Date(run.completed_at).toLocaleString()}`);
   236→    }
   237→    if (run.abort_reason) {
   238→      console.log(`Abort reason: ${run.abort_reason}`);
   239→    }
   240→
   241→    if (run.step_results.length > 0) {
   242→      console.log(chalk.gray('\nStep Results:'));
   243→      const table = new Table({
   244→        head: ['Step', 'Status', 'Started', 'Completed'],
   245→        colWidths: [8, 12, 20, 20],
   246→      });
   247→
   248→      for (const result of run.step_results) {
   249→        table.push([
   250→          result.step_index.toString(),
   251→          formatStatus(result.status),
   252→          new Date(result.started_at).toLocaleString(),
   253→          new Date(result.completed_at).toLocaleString(),
   254→        ]);
   255→      }
   256→
   257→      console.log(table.toString());
   258→    }
   259→  }
   260→}
   261→
   262→/**
   263→ * Command: kspec workflow abort @run-id [--reason text] [--json]
   264→ * AC: @workflow-run-foundation ac-3, ac-5
   265→ */
   266→async function workflowAbort(runRef: string, options: { reason?: string; json?: boolean }) {
   267→  const ctx = await initContext();
   268→
   269→  const run = await findWorkflowRunByRef(ctx, runRef);
   270→  if (!run) {
   271→    error(errors.workflowRun.runNotFound(runRef));
   272→    process.exit(EXIT_CODES.NOT_FOUND);
   273→  }
   274→
   275→  // AC: @workflow-run-foundation ac-5 - Cannot abort completed or aborted runs
   276→  if (run.status === 'completed') {
   277→    error(errors.workflowRun.cannotAbortCompleted);
   278→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   279→  }
   280→
   281→  if (run.status === 'aborted') {
   282→    error(errors.workflowRun.cannotAbortAborted);
   283→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   284→  }
   285→
   286→  // Update run status
   287→  run.status = 'aborted';
   288→  run.abort_reason = options.reason;
   289→  run.completed_at = new Date().toISOString();
   290→
   291→  await updateWorkflowRun(ctx, run);
   292→  await commitIfShadow(ctx.shadow, 'workflow-abort');
   293→
   294→  if (isJsonMode()) {
   295→    output({ run_id: run._ulid, status: run.status });
   296→  } else {
   297→    success(`Aborted workflow run: ${shortUlid(run._ulid)}`);
   298→    if (options.reason) {
   299→      console.log(`  Reason: ${options.reason}`);
   300→    }
   301→  }
   302→}
   303→
   304→/**
   305→ * Command: kspec workflow next [run-ref] [--skip] [--notes text] [--json]
   306→ * AC: @workflow-step-navigation ac-1 through ac-6
   307→ */
   308→async function workflowNext(
   309→  runRef: string | undefined,
   310→  options: { skip?: boolean; notes?: string; json?: boolean }
   311→) {
   312→  const ctx = await initContext();
   313→  const metaCtx = await loadMetaContext(ctx);
   314→
   315→  let run: WorkflowRun | undefined;
   316→
   317→  // AC: @workflow-step-navigation ac-3, ac-4, ac-5
   318→  if (!runRef) {
   319→    const activeRuns = await findActiveRuns(ctx);
   320→
   321→    if (activeRuns.length === 0) {
   322→      // AC: @workflow-step-navigation ac-5
   323→      error(errors.workflowRun.noActiveRuns);
   324→      process.exit(EXIT_CODES.NOT_FOUND);
   325→    }
   326→
   327→    if (activeRuns.length > 1) {
   328→      // AC: @workflow-step-navigation ac-4
   329→      const runIds = activeRuns.map((r) => shortUlid(r._ulid));
   330→      error(errors.workflowRun.multipleActiveRuns(runIds));
   331→      process.exit(EXIT_CODES.VALIDATION_FAILED);
   332→    }
   333→
   334→    // AC: @workflow-step-navigation ac-3 - exactly one active run
   335→    run = activeRuns[0];
   336→  } else {
   337→    run = await findWorkflowRunByRef(ctx, runRef);
   338→    if (!run) {
   339→      error(errors.workflowRun.runNotFound(runRef));
   340→      process.exit(EXIT_CODES.NOT_FOUND);
   341→    }
   342→
   343→    if (run.status !== 'active') {
   344→      error(errors.workflowRun.runNotActive(runRef, run.status));
   345→      process.exit(EXIT_CODES.VALIDATION_FAILED);
   346→    }
   347→  }
   348→
   349→  // Get workflow definition to access steps
   350→  const workflow = metaCtx.workflows.find((w) => `@${w._ulid}` === run.workflow_ref);
   351→  if (!workflow) {
   352→    error(errors.workflowRun.workflowNotFound(run.workflow_ref));
   353→    process.exit(EXIT_CODES.NOT_FOUND);
   354→  }
   355→
   356→  // AC: @workflow-step-navigation ac-1, ac-6 - Complete current step
   357→  const currentStepIndex = run.current_step;
   358→  const previousResult = run.step_results[run.step_results.length - 1];
   359→  const startedAt = previousResult ? previousResult.completed_at : run.started_at;
   360→
   361→  const stepResult = {
   362→    step_index: currentStepIndex,
   363→    status: options.skip ? ('skipped' as const) : ('completed' as const),
   364→    started_at: startedAt,
   365→    completed_at: new Date().toISOString(),
   366→    notes: options.notes,
   367→  };
   368→
   369→  run.step_results.push(stepResult);
   370→
   371→  // AC: @workflow-step-navigation ac-1 - Advance to next step or complete run
   372→  const isLastStep = currentStepIndex === run.total_steps - 1;
   373→
   374→  if (isLastStep) {
   375→    // AC: @workflow-step-navigation ac-2 - Complete the run
   376→    run.status = 'completed';
   377→    run.completed_at = new Date().toISOString();
   378→
   379→    await updateWorkflowRun(ctx, run);
   380→    await commitIfShadow(ctx.shadow, 'workflow-next');
   381→
   382→    // Calculate summary stats
   383→    const totalDuration = new Date(run.completed_at).getTime() - new Date(run.started_at).getTime();
   384→    const completedSteps = run.step_results.filter((r) => r.status === 'completed').length;
   385→    const skippedSteps = run.step_results.filter((r) => r.status === 'skipped').length;
   386→
   387→    if (isJsonMode()) {
   388→      output({
   389→        run_id: run._ulid,
   390→        status: run.status,
   391→        completed_at: run.completed_at,
   392→        total_duration_ms: totalDuration,
   393→        steps_completed: completedSteps,
   394→        steps_skipped: skippedSteps,
   395→      });
   396→    } else {
   397→      const currentStep = workflow.steps[currentStepIndex];
   398→      success(`Completed step ${currentStepIndex + 1}/${run.total_steps}: [${currentStep.type}] ${currentStep.content}`);
   399→      console.log();
   400→      console.log(chalk.bold('Workflow completed!'));
   401→      console.log(`  Duration: ${Math.round(totalDuration / 1000)}s`);
   402→      console.log(`  Steps completed: ${completedSteps}`);
   403→      console.log(`  Steps skipped: ${skippedSteps}`);
   404→    }
   405→  } else {
   406→    // Advance to next step
   407→    run.current_step += 1;
   408→
   409→    await updateWorkflowRun(ctx, run);
   410→    await commitIfShadow(ctx.shadow, 'workflow-next');
   411→
   412→    const nextStep = workflow.steps[run.current_step];
   413→
   414→    if (isJsonMode()) {
   415→      output({
   416→        run_id: run._ulid,
   417→        current_step: run.current_step,
   418→        total_steps: run.total_steps,
   419→        next_step: {
   420→          type: nextStep.type,
   421→          content: nextStep.content,
   422→        },
   423→      });
   424→    } else {
   425→      const previousStep = workflow.steps[currentStepIndex];
   426→      success(
   427→        `Completed step ${currentStepIndex + 1}/${run.total_steps}: [${previousStep.type}] ${previousStep.content}`
   428→      );
   429→      console.log();
   430→      console.log(`Step ${run.current_step + 1}/${run.total_steps}: [${nextStep.type}] ${nextStep.content}`);
   431→    }
   432→  }
   433→}
   434→
   435→/**
   436→ * Register workflow commands
   437→ */
   438→export function registerWorkflowCommand(program: Command): void {
   439→  const workflow = program
   440→    .command('workflow')
   441→    .description('Manage workflow runs');
   442→
   443→  workflow
   444→    .command('start')
   445→    .description('Start a new workflow run')
   446→    .argument('<workflow-ref>', 'Workflow reference (@id or @ulid)')
   447→    .option('--task <task-ref>', 'Link run to a task')
   448→    .option('--json', 'Output JSON')
   449→    .action(workflowStart);
   450→
   451→  workflow
   452→    .command('runs')
   453→    .description('List workflow runs')
   454→    .option('--active', 'Show only active runs')
   455→    .option('--completed', 'Show only completed runs')
   456→    .option('--workflow <ref>', 'Filter by workflow')
   457→    .option('--json', 'Output JSON')
   458→    .action(workflowRuns);
   459→
   460→  workflow
   461→    .command('show')
   462→    .description('Show workflow run details')
   463→    .argument('<run-ref>', 'Run reference (@ulid or ulid prefix)')
   464→    .option('--json', 'Output JSON')
   465→    .action(workflowShow);
   466→
   467→  workflow
   468→    .command('abort')
   469→    .description('Abort an active workflow run')
   470→    .argument('<run-ref>', 'Run reference (@ulid or ulid prefix)')
   471→    .option('--reason <text>', 'Reason for aborting')
   472→    .option('--json', 'Output JSON')
   473→    .action(workflowAbort);
   474→
   475→  workflow
   476→    .command('next')
   477→    .description('Advance workflow run to next step')
   478→    .argument('[run-ref]', 'Run reference (optional if only one active run)')
   479→    .option('--skip', 'Mark current step as skipped')
   480→    .option('--notes <text>', 'Notes for the completed step')
   481→    .option('--json', 'Output JSON')
   482→    .action(workflowNext);
   483→}
   484→

