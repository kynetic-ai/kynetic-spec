```
     1→/**
     2→ * Meta manifest loading and operations.
     3→ *
     4→ * The meta manifest (kynetic.meta.yaml) contains process definitions:
     5→ * - Agents: roles, capabilities, conventions
     6→ * - Workflows: structured processes with steps
     7→ * - Conventions: project rules and standards
     8→ * - Observations: feedback about processes
     9→ */
    10→
    11→import * as fs from 'node:fs/promises';
    12→import * as path from 'node:path';
    13→import { ulid } from 'ulid';
    14→import {
    15→  MetaManifestSchema,
    16→  AgentSchema,
    17→  WorkflowSchema,
    18→  ConventionSchema,
    19→  ObservationSchema,
    20→  SessionContextSchema,
    21→  type MetaManifest,
    22→  type Agent,
    23→  type Workflow,
    24→  type Convention,
    25→  type Observation,
    26→  type MetaItem,
    27→  type ObservationType,
    28→  type SessionContext,
    29→  getMetaItemType,
    30→} from '../schema/index.js';
    31→import { readYamlFile, writeYamlFilePreserveFormat, expandIncludePattern, getAuthor } from './yaml.js';
    32→import type { KspecContext } from './yaml.js';
    33→
    34→/**
    35→ * Loaded agent with runtime metadata
    36→ */
    37→export interface LoadedAgent extends Agent {
    38→  _sourceFile?: string;
    39→}
    40→
    41→/**
    42→ * Loaded workflow with runtime metadata
    43→ */
    44→export interface LoadedWorkflow extends Workflow {
    45→  _sourceFile?: string;
    46→}
    47→
    48→/**
    49→ * Loaded convention with runtime metadata
    50→ */
    51→export interface LoadedConvention extends Convention {
    52→  _sourceFile?: string;
    53→}
    54→
    55→/**
    56→ * Loaded observation with runtime metadata
    57→ */
    58→export interface LoadedObservation extends Observation {
    59→  _sourceFile?: string;
    60→}
    61→
    62→/**
    63→ * Any loaded meta item
    64→ */
    65→export type LoadedMetaItem = LoadedAgent | LoadedWorkflow | LoadedConvention | LoadedObservation;
    66→
    67→/**
    68→ * Meta context containing all loaded meta items
    69→ */
    70→export interface MetaContext {
    71→  manifest: MetaManifest | null;
    72→  manifestPath: string | null;
    73→  agents: LoadedAgent[];
    74→  workflows: LoadedWorkflow[];
    75→  conventions: LoadedConvention[];
    76→  observations: LoadedObservation[];
    77→}
    78→
    79→/**
    80→ * Find the meta manifest file (kynetic.meta.yaml)
    81→ */
    82→export async function findMetaManifest(specDir: string): Promise<string | null> {
    83→  const candidates = ['kynetic.meta.yaml'];
    84→
    85→  for (const candidate of candidates) {
    86→    const filePath = path.join(specDir, candidate);
    87→    try {
    88→      await fs.access(filePath);
    89→      return filePath;
    90→    } catch {
    91→      // File doesn't exist, try next
    92→    }
    93→  }
    94→
    95→  return null;
    96→}
    97→
    98→/**
    99→ * Get the meta manifest file path.
   100→ * Returns path even if file doesn't exist yet.
   101→ */
   102→export function getMetaManifestPath(ctx: KspecContext): string {
   103→  return path.join(ctx.specDir, 'kynetic.meta.yaml');
   104→}
   105→
   106→/**
   107→ * Load meta items from a single file.
   108→ */
   109→async function loadMetaFile(
   110→  filePath: string
   111→): Promise<{
   112→  agents: LoadedAgent[];
   113→  workflows: LoadedWorkflow[];
   114→  conventions: LoadedConvention[];
   115→  observations: LoadedObservation[];
   116→}> {
   117→  const result: {
   118→    agents: LoadedAgent[];
   119→    workflows: LoadedWorkflow[];
   120→    conventions: LoadedConvention[];
   121→    observations: LoadedObservation[];
   122→  } = {
   123→    agents: [],
   124→    workflows: [],
   125→    conventions: [],
   126→    observations: [],
   127→  };
   128→
   129→  try {
   130→    const raw = await readYamlFile<unknown>(filePath);
   131→    if (!raw || typeof raw !== 'object') {
   132→      return result;
   133→    }
   134→
   135→    const obj = raw as Record<string, unknown>;
   136→
   137→    // Parse agents
   138→    if (Array.isArray(obj.agents)) {
   139→      for (const agent of obj.agents) {
   140→        const parsed = AgentSchema.safeParse(agent);
   141→        if (parsed.success) {
   142→          result.agents.push({ ...parsed.data, _sourceFile: filePath });
   143→        }
   144→      }
   145→    }
   146→
   147→    // Parse workflows
   148→    if (Array.isArray(obj.workflows)) {
   149→      for (const workflow of obj.workflows) {
   150→        const parsed = WorkflowSchema.safeParse(workflow);
   151→        if (parsed.success) {
   152→          result.workflows.push({ ...parsed.data, _sourceFile: filePath });
   153→        }
   154→      }
   155→    }
   156→
   157→    // Parse conventions
   158→    if (Array.isArray(obj.conventions)) {
   159→      for (const convention of obj.conventions) {
   160→        const parsed = ConventionSchema.safeParse(convention);
   161→        if (parsed.success) {
   162→          result.conventions.push({ ...parsed.data, _sourceFile: filePath });
   163→        }
   164→      }
   165→    }
   166→
   167→    // Parse observations
   168→    if (Array.isArray(obj.observations)) {
   169→      for (const observation of obj.observations) {
   170→        const parsed = ObservationSchema.safeParse(observation);
   171→        if (parsed.success) {
   172→          result.observations.push({ ...parsed.data, _sourceFile: filePath });
   173→        }
   174→      }
   175→    }
   176→  } catch {
   177→    // File doesn't exist or parse error
   178→  }
   179→
   180→  return result;
   181→}
   182→
   183→/**
   184→ * Load the meta context from a kspec context.
   185→ * Loads meta manifest and follows includes.
   186→ */
   187→export async function loadMetaContext(ctx: KspecContext): Promise<MetaContext> {
   188→  const result: MetaContext = {
   189→    manifest: null,
   190→    manifestPath: null,
   191→    agents: [],
   192→    workflows: [],
   193→    conventions: [],
   194→    observations: [],
   195→  };
   196→
   197→  const manifestPath = await findMetaManifest(ctx.specDir);
   198→  if (!manifestPath) {
   199→    return result;
   200→  }
   201→
   202→  result.manifestPath = manifestPath;
   203→
   204→  try {
   205→    const raw = await readYamlFile<unknown>(manifestPath);
   206→    const parsed = MetaManifestSchema.safeParse(raw);
   207→
   208→    if (!parsed.success) {
   209→      // Invalid manifest, but we can still try to extract items
   210→      const items = await loadMetaFile(manifestPath);
   211→      result.agents.push(...items.agents);
   212→      result.workflows.push(...items.workflows);
   213→      result.conventions.push(...items.conventions);
   214→      result.observations.push(...items.observations);
   215→      return result;
   216→    }
   217→
   218→    result.manifest = parsed.data;
   219→
   220→    // Load items from manifest
   221→    const manifestItems = await loadMetaFile(manifestPath);
   222→    result.agents.push(...manifestItems.agents);
   223→    result.workflows.push(...manifestItems.workflows);
   224→    result.conventions.push(...manifestItems.conventions);
   225→    result.observations.push(...manifestItems.observations);
   226→
   227→    // Process includes
   228→    const includes = parsed.data.includes || [];
   229→    const manifestDir = path.dirname(manifestPath);
   230→
   231→    for (const include of includes) {
   232→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   233→
   234→      for (const filePath of expandedPaths) {
   235→        const items = await loadMetaFile(filePath);
   236→        result.agents.push(...items.agents);
   237→        result.workflows.push(...items.workflows);
   238→        result.conventions.push(...items.conventions);
   239→        result.observations.push(...items.observations);
   240→      }
   241→    }
   242→  } catch {
   243→    // Manifest exists but may be invalid
   244→  }
   245→
   246→  return result;
   247→}
   248→
   249→/**
   250→ * Get meta stats summary
   251→ */
   252→export function getMetaStats(meta: MetaContext): {
   253→  agents: number;
   254→  workflows: number;
   255→  conventions: number;
   256→  observations: number;
   257→  unresolvedObservations: number;
   258→} {
   259→  return {
   260→    agents: meta.agents.length,
   261→    workflows: meta.workflows.length,
   262→    conventions: meta.conventions.length,
   263→    observations: meta.observations.length,
   264→    unresolvedObservations: meta.observations.filter((o) => !o.resolved).length,
   265→  };
   266→}
   267→
   268→/**
   269→ * Find a meta item by reference (ULID, short ULID, or id)
   270→ */
   271→export function findMetaItemByRef(
   272→  meta: MetaContext,
   273→  ref: string
   274→): LoadedMetaItem | undefined {
   275→  const cleanRef = ref.startsWith('@') ? ref.slice(1) : ref;
   276→
   277→  // Search all item types
   278→  const allItems: LoadedMetaItem[] = [
   279→    ...meta.agents,
   280→    ...meta.workflows,
   281→    ...meta.conventions,
   282→    ...meta.observations,
   283→  ];
   284→
   285→  for (const item of allItems) {
   286→    // Match full ULID
   287→    if (item._ulid === cleanRef) return item;
   288→
   289→    // Match short ULID (prefix)
   290→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase())) return item;
   291→
   292→    // Match by id (for agents and workflows)
   293→    if ('id' in item && item.id === cleanRef) return item;
   294→
   295→    // Match by domain (for conventions)
   296→    if ('domain' in item && item.domain === cleanRef) return item;
   297→  }
   298→
   299→  return undefined;
   300→}
   301→
   302→/**
   303→ * Determine if an item is a meta item type
   304→ */
   305→export function isMetaItemType(type: string): boolean {
   306→  return ['agent', 'workflow', 'convention', 'observation'].includes(type);
   307→}
   308→
   309→// ============================================================
   310→// META ITEM CRUD
   311→// ============================================================
   312→
   313→/**
   314→ * Save the entire meta manifest to file
   315→ */
   316→async function saveMetaManifest(
   317→  manifestPath: string,
   318→  manifest: MetaManifest
   319→): Promise<void> {
   320→  await writeYamlFilePreserveFormat(manifestPath, manifest);
   321→}
   322→
   323→/**
   324→ * Strip runtime metadata before serialization
   325→ */
   326→function stripMetaMetadata<T extends LoadedMetaItem>(item: T): Omit<T, '_sourceFile'> {
   327→  const { _sourceFile, ...cleanItem } = item;
   328→  return cleanItem as Omit<T, '_sourceFile'>;
   329→}
   330→
   331→/**
   332→ * Create a new observation
   333→ */
   334→export function createObservation(
   335→  type: ObservationType,
   336→  content: string,
   337→  options: {
   338→    workflow_ref?: string;
   339→    author?: string;
   340→  } = {}
   341→): Observation {
   342→  return {
   343→    _ulid: ulid(),
   344→    type,
   345→    content,
   346→    workflow_ref: options.workflow_ref,
   347→    created_at: new Date().toISOString(),
   348→    author: options.author ?? getAuthor(),
   349→    resolved: false,
   350→    resolution: null,
   351→  };
   352→}
   353→
   354→/**
   355→ * Save an observation to the meta manifest
   356→ */
   357→export async function saveObservation(
   358→  ctx: KspecContext,
   359→  observation: LoadedObservation
   360→): Promise<void> {
   361→  const manifestPath = getMetaManifestPath(ctx);
   362→
   363→  // Ensure directory exists
   364→  const dir = path.dirname(manifestPath);
   365→  await fs.mkdir(dir, { recursive: true });
   366→
   367→  // Load existing manifest
   368→  let manifest: MetaManifest = {
   369→    kynetic_meta: '1.0',
   370→    agents: [],
   371→    workflows: [],
   372→    conventions: [],
   373→    observations: [],
   374→    includes: [],
   375→  };
   376→
   377→  try {
   378→    const raw = await readYamlFile<unknown>(manifestPath);
   379→    const parsed = MetaManifestSchema.safeParse(raw);
   380→    if (parsed.success) {
   381→      manifest = parsed.data;
   382→    }
   383→  } catch {
   384→    // File doesn't exist, use defaults
   385→  }
   386→
   387→  // Strip runtime metadata
   388→  const cleanObs = stripMetaMetadata(observation);
   389→
   390→  // Update or add
   391→  const existingIndex = manifest.observations.findIndex(
   392→    (o) => o._ulid === observation._ulid
   393→  );
   394→  if (existingIndex >= 0) {
   395→    manifest.observations[existingIndex] = cleanObs as Observation;
   396→  } else {
   397→    manifest.observations.push(cleanObs as Observation);
   398→  }
   399→
   400→  await saveMetaManifest(manifestPath, manifest);
   401→}
   402→
   403→/**
   404→ * Delete an observation from the meta manifest
   405→ */
   406→export async function deleteObservation(
   407→  ctx: KspecContext,
   408→  ulid: string
   409→): Promise<boolean> {
   410→  const manifestPath = getMetaManifestPath(ctx);
   411→
   412→  try {
   413→    const raw = await readYamlFile<unknown>(manifestPath);
   414→    const parsed = MetaManifestSchema.safeParse(raw);
   415→    if (!parsed.success) {
   416→      return false;
   417→    }
   418→
   419→    const manifest = parsed.data;
   420→    const index = manifest.observations.findIndex((o) => o._ulid === ulid);
   421→    if (index < 0) {
   422→      return false;
   423→    }
   424→
   425→    manifest.observations.splice(index, 1);
   426→    await saveMetaManifest(manifestPath, manifest);
   427→    return true;
   428→  } catch {
   429→    return false;
   430→  }
   431→}
   432→
   433→// Re-export the getMetaItemType function
   434→export { getMetaItemType };
   435→export type { Agent, Workflow, Convention, Observation, MetaItem };
   436→
   437→// ============================================================
   438→// GENERIC META ITEM CRUD
   439→// ============================================================
   440→
   441→/**
   442→ * Save any meta item (agent, workflow, convention) to the manifest
   443→ */
   444→export async function saveMetaItem(
   445→  ctx: KspecContext,
   446→  item: LoadedMetaItem,
   447→  itemType: 'agent' | 'workflow' | 'convention'
   448→): Promise<void> {
   449→  const manifestPath = getMetaManifestPath(ctx);
   450→
   451→  // Ensure directory exists
   452→  const dir = path.dirname(manifestPath);
   453→  await fs.mkdir(dir, { recursive: true });
   454→
   455→  // Load existing manifest
   456→  let manifest: MetaManifest = {
   457→    kynetic_meta: '1.0',
   458→    agents: [],
   459→    workflows: [],
   460→    conventions: [],
   461→    observations: [],
   462→    includes: [],
   463→  };
   464→
   465→  try {
   466→    const raw = await readYamlFile<unknown>(manifestPath);
   467→    const parsed = MetaManifestSchema.safeParse(raw);
   468→    if (parsed.success) {
   469→      manifest = parsed.data;
   470→    }
   471→  } catch {
   472→    // File doesn't exist, use defaults
   473→  }
   474→
   475→  // Strip runtime metadata
   476→  const cleanItem = stripMetaMetadata(item);
   477→
   478→  // Get the appropriate array
   479→  const getArray = () => {
   480→    switch (itemType) {
   481→      case 'agent':
   482→        return manifest.agents;
   483→      case 'workflow':
   484→        return manifest.workflows;
   485→      case 'convention':
   486→        return manifest.conventions;
   487→    }
   488→  };
   489→
   490→  const array = getArray();
   491→
   492→  // Update or add
   493→  const existingIndex = array.findIndex((i) => i._ulid === item._ulid);
   494→  if (existingIndex >= 0) {
   495→    (array as unknown[])[existingIndex] = cleanItem;
   496→  } else {
   497→    (array as unknown[]).push(cleanItem);
   498→  }
   499→
   500→  await saveMetaManifest(manifestPath, manifest);
   501→}
   502→
   503→/**
   504→ * Delete any meta item from the manifest
   505→ */
   506→export async function deleteMetaItem(
   507→  ctx: KspecContext,
   508→  itemUlid: string,
   509→  itemType: 'agent' | 'workflow' | 'convention' | 'observation'
   510→): Promise<boolean> {
   511→  const manifestPath = getMetaManifestPath(ctx);
   512→
   513→  try {
   514→    const raw = await readYamlFile<unknown>(manifestPath);
   515→    const parsed = MetaManifestSchema.safeParse(raw);
   516→    if (!parsed.success) {
   517→      return false;
   518→    }
   519→
   520→    const manifest = parsed.data;
   521→
   522→    const getArray = () => {
   523→      switch (itemType) {
   524→        case 'agent':
   525→          return manifest.agents;
   526→        case 'workflow':
   527→          return manifest.workflows;
   528→        case 'convention':
   529→          return manifest.conventions;
   530→        case 'observation':
   531→          return manifest.observations;
   532→      }
   533→    };
   534→
   535→    const array = getArray();
   536→    const index = array.findIndex((i) => i._ulid === itemUlid);
   537→    if (index < 0) {
   538→      return false;
   539→    }
   540→
   541→    array.splice(index, 1);
   542→    await saveMetaManifest(manifestPath, manifest);
   543→    return true;
   544→  } catch {
   545→    return false;
   546→  }
   547→}
   548→
   549→// ============================================================
   550→// SESSION CONTEXT
   551→// ============================================================
   552→
   553→/**
   554→ * Get the session context file path
   555→ */
   556→export function getSessionContextPath(ctx: KspecContext): string {
   557→  return path.join(ctx.specDir, '.kspec-session');
   558→}
   559→
   560→/**
   561→ * Load session context (or return empty context if not exists)
   562→ */
   563→export async function loadSessionContext(ctx: KspecContext): Promise<SessionContext> {
   564→  const contextPath = getSessionContextPath(ctx);
   565→
   566→  try {
   567→    const raw = await readYamlFile<unknown>(contextPath);
   568→    if (!raw || typeof raw !== 'object') {
   569→      return {
   570→        focus: null,
   571→        threads: [],
   572→        open_questions: [],
   573→        updated_at: new Date().toISOString(),
   574→      };
   575→    }
   576→
   577→    // Validate and parse using schema
   578→    const result = SessionContextSchema.safeParse(raw);
   579→    if (result.success) {
   580→      return result.data;
   581→    }
   582→
   583→    // If validation fails, return empty context
   584→    return {
   585→      focus: null,
   586→      threads: [],
   587→      open_questions: [],
   588→      updated_at: new Date().toISOString(),
   589→    };
   590→  } catch {
   591→    return {
   592→      focus: null,
   593→      threads: [],
   594→      open_questions: [],
   595→      updated_at: new Date().toISOString(),
   596→    };
   597→  }
   598→}
   599→
   600→/**
   601→ * Save session context
   602→ */
   603→export async function saveSessionContext(ctx: KspecContext, context: SessionContext): Promise<void> {
   604→  const contextPath = getSessionContextPath(ctx);
   605→
   606→  // Update timestamp
   607→  context.updated_at = new Date().toISOString();
   608→
   609→  await writeYamlFilePreserveFormat(contextPath, context);
   610→}
