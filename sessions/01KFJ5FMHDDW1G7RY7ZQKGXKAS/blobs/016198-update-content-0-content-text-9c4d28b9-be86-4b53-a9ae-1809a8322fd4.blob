   162→// ============================================================================
   163→// JsonRpcFraming Tests
   164→// ============================================================================
   165→
   166→describe('JsonRpcFraming', () => {
   167→  let stdin: PassThrough;
   168→  let stdout: PassThrough;
   169→  let framing: JsonRpcFraming;
   170→
   171→  beforeEach(() => {
   172→    stdin = new PassThrough();
   173→    stdout = new PassThrough();
   174→    framing = new JsonRpcFraming({
   175→      stdin,
   176→      stdout,
   177→      timeout: 1000, // Short timeout for tests
   178→    });
   179→  });
   180→
   181→  afterEach(() => {
   182→    framing.close();
   183→  });
   184→
   185→  it('should send requests and receive responses', async () => {
   186→    // Set up to capture outgoing message
   187→    const outgoingMessages: string[] = [];
   188→    stdout.on('data', (chunk: Buffer) => {
   189→      outgoingMessages.push(chunk.toString());
   190→    });
   191→
   192→    // Start the request
   193→    const resultPromise = framing.sendRequest('test/method', { foo: 'bar' });
   194→
   195→    // Wait for the request to be sent
   196→    await new Promise((resolve) => setTimeout(resolve, 10));
   197→
   198→    // Verify request was sent
   199→    expect(outgoingMessages.length).toBe(1);
   200→    const sentRequest = JSON.parse(outgoingMessages[0]);
   201→    expect(sentRequest.jsonrpc).toBe('2.0');
   202→    expect(sentRequest.method).toBe('test/method');
   203→    expect(sentRequest.params).toEqual({ foo: 'bar' });
   204→    expect(sentRequest.id).toBe(1);
   205→
   206→    // Send response
   207→    const response = JSON.stringify({
   208→      jsonrpc: '2.0',
   209→      id: 1,
   210→      result: { success: true },
   211→    });
   212→    stdin.write(response + '\n');
   213→
   214→    // Verify result
   215→    const result = await resultPromise;
   216→    expect(result).toEqual({ success: true });
   217→  });
   218→
   219→  it('should handle error responses', async () => {
   220→    // Suppress console.error for this test
   221→    const consoleSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
   222→
   223→    const resultPromise = framing.sendRequest('test/method');
   224→
   225→    await new Promise((resolve) => setTimeout(resolve, 10));
   226→
   227→    // Send error response
   228→    const errorResponse = JSON.stringify({
   229→      jsonrpc: '2.0',
   230→      id: 1,
   231→      error: { code: -32600, message: 'Invalid Request' },
   232→    });
   233→    stdin.write(errorResponse + '\n');
   234→
   235→    // Verify error is thrown
   236→    await expect(resultPromise).rejects.toThrow('Invalid Request');
   237→
   238→    consoleSpy.mockRestore();
   239→  });
   240→
   241→  it('should timeout pending requests', async () => {
   242→    const shortTimeoutFraming = new JsonRpcFraming({
   243→      stdin,
   244→      stdout,
   245→      timeout: 50, // Very short timeout
   246→    });
   247→
   248→    const resultPromise = shortTimeoutFraming.sendRequest('test/method');
   249→
   250→    await expect(resultPromise).rejects.toThrow(/timed out/);
   251→
   252→    shortTimeoutFraming.close();
   253→  });
   254→
   255→  it('should emit request events for incoming requests', async () => {
   256→    const requestPromise = new Promise<unknown>((resolve) => {
   257→      framing.on('request', resolve);
   258→    });
   259→
   260→    // Send incoming request
   261→    const request = JSON.stringify({
   262→      jsonrpc: '2.0',
   263→      id: 'agent-1',
   264→      method: 'fs/read_text_file',
   265→      params: { path: '/test.txt' },
   266→    });
   267→    stdin.write(request + '\n');
   268→
   269→    const receivedRequest = await requestPromise;
   270→    expect(receivedRequest).toEqual({
   271→      jsonrpc: '2.0',
   272→      id: 'agent-1',
   273→      method: 'fs/read_text_file',
   274→      params: { path: '/test.txt' },
   275→    });
   276→  });
   277→
   278→  it('should emit notification events', async () => {
   279→    const notificationPromise = new Promise<unknown>((resolve) => {
   280→      framing.on('notification', resolve);
   281→    });
   282→
   283→    // Send notification
   284→    const notification = JSON.stringify({
   285→      jsonrpc: '2.0',
   286→      method: 'session/update',
   287→      params: { sessionId: 'test-session', update: { type: 'progress' } },
   288→    });
   289→    stdin.write(notification + '\n');
   290→
   291→    const receivedNotification = await notificationPromise;
   292→    expect(receivedNotification).toEqual({
   293→      jsonrpc: '2.0',
   294→      method: 'session/update',
   295→      params: { sessionId: 'test-session', update: { type: 'progress' } },
   296→    });
   297→  });
   298→
   299→  // AC: @acp-client ac-9
   300→  it('should send parse error for malformed JSON', async () => {
   301→    const outgoingMessages: string[] = [];
   302→    stdout.on('data', (chunk: Buffer) => {
   303→      outgoingMessages.push(chunk.toString());
   304→    });
   305→
   306→    // Send malformed JSON
   307→    stdin.write('not valid json\n');
   308→
   309→    await new Promise((resolve) => setTimeout(resolve, 10));
   310→
   311→    // Verify parse error was sent
   312→    expect(outgoingMessages.length).toBe(1);
   313→    const errorResponse = JSON.parse(outgoingMessages[0]);
   314→    expect(errorResponse.jsonrpc).toBe('2.0');
   315→    expect(errorResponse.id).toBe(null);
   316→    expect(errorResponse.error.code).toBe(-32700);
   317→    expect(errorResponse.error.message).toBe('Parse error');
   318→  });
   319→
   320→  // AC: @acp-client ac-8
   321→  it('should throw when closed', async () => {
   322→    framing.close();
   323→
   324→    await expect(() => framing.sendRequest('test')).rejects.toThrow('closed');
   325→    expect(() => framing.sendNotification('test')).toThrow('closed');
   326→    expect(() => framing.sendResponse(1, {})).toThrow('closed');
   327→  });
   328→
   329→  // AC: @acp-client ac-6
   330→  it('should reset pending timers on incoming activity', async () => {
   331→    // Create framing with short timeout
   332→    const shortFraming = new JsonRpcFraming({
   333→      stdin,
   334→      stdout,
   335→      timeout: 100,
   336→    });
   337→
   338→    // Start a request
   339→    const resultPromise = shortFraming.sendRequest('test/method');
   340→
   341→    // Wait 60ms, then send a notification (activity)
   342→    await new Promise((resolve) => setTimeout(resolve, 60));
   343→    stdin.write(JSON.stringify({ jsonrpc: '2.0', method: 'ping' }) + '\n');
   344→
   345→    // Wait another 60ms (total 120ms, would have timed out without reset)
   346→    await new Promise((resolve) => setTimeout(resolve, 60));
   347→
   348→    // Send the actual response
   349→    stdin.write(JSON.stringify({ jsonrpc: '2.0', id: 1, result: 'ok' }) + '\n');
   350→
   351→    // Should succeed because timer was reset
   352→    const result = await resultPromise;
   353→    expect(result).toBe('ok');
   354→
   355→    shortFraming.close();
   356→  });
   357→});
