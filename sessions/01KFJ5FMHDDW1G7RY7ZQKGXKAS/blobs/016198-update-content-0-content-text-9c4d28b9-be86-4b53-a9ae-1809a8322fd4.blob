   359→// ============================================================================
   360→// ACPClient Tests
   361→// ============================================================================
   362→
   363→describe('ACPClient', () => {
   364→  let stdin: PassThrough;
   365→  let stdout: PassThrough;
   366→  let client: ACPClient;
   367→
   368→  beforeEach(() => {
   369→    stdin = new PassThrough();
   370→    stdout = new PassThrough();
   371→    client = new ACPClient({
   372→      stdin,
   373→      stdout,
   374→      timeout: 1000,
   375→      clientInfo: {
   376→        name: 'test-client',
   377→        version: '1.0.0',
   378→      },
   379→    });
   380→  });
   381→
   382→  afterEach(() => {
   383→    client.close();
   384→  });
   385→
   386→  /**
   387→   * Helper to respond to the next outgoing request
   388→   */
   389→  function respondToNext(result: unknown) {
   390→    return new Promise<void>((resolve) => {
   391→      stdout.once('data', (chunk: Buffer) => {
   392→        const request = JSON.parse(chunk.toString());
   393→        stdin.write(
   394→          JSON.stringify({
   395→            jsonrpc: '2.0',
   396→            id: request.id,
   397→            result,
   398→          }) + '\n',
   399→        );
   400→        resolve();
   401→      });
   402→    });
   403→  }
   404→
   405→  // AC: @acp-client ac-1
   406→  describe('initialize', () => {
   407→    it('should initialize and return agent capabilities', async () => {
   408→      const initPromise = client.initialize();
   409→
   410→      // Respond with capabilities
   411→      await respondToNext({
   412→        protocolVersion: 1,
   413→        agentCapabilities: {
   414→          streaming: true,
   415→        },
   416→      });
   417→
   418→      const capabilities = await initPromise;
   419→      expect(capabilities).toEqual({ streaming: true });
   420→      expect(client.isInitialized()).toBe(true);
   421→    });
   422→
   423→    it('should throw if already initialized', async () => {
   424→      const initPromise = client.initialize();
   425→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   426→      await initPromise;
   427→
   428→      await expect(client.initialize()).rejects.toThrow('already initialized');
   429→    });
   430→  });
   431→
   432→  // AC: @acp-client ac-2
   433→  describe('newSession', () => {
   434→    it('should create session and return sessionId', async () => {
   435→      // Initialize first
   436→      const initPromise = client.initialize();
   437→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   438→      await initPromise;
   439→
   440→      // Create session
   441→      const sessionPromise = client.newSession({
   442→        cwd: '/test',
   443→        _meta: { test: true },
   444→      });
   445→
   446→      await respondToNext({ sessionId: 'session-123' });
   447→
   448→      const sessionId = await sessionPromise;
   449→      expect(sessionId).toBe('session-123');
   450→
   451→      // Verify session is tracked
   452→      const session = client.getSession('session-123');
   453→      expect(session).toEqual({ id: 'session-123', status: 'idle' });
   454→    });
   455→
   456→    it('should throw if not initialized', async () => {
   457→      await expect(client.newSession({ cwd: '/' })).rejects.toThrow(
   458→        'not initialized',
   459→      );
   460→    });
   461→  });
   462→
   463→  // AC: @acp-client ac-3
   464→  describe('prompt', () => {
   465→    beforeEach(async () => {
   466→      // Initialize and create session for prompt tests
   467→      const initPromise = client.initialize();
   468→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   469→      await initPromise;
   470→
   471→      const sessionPromise = client.newSession({ cwd: '/' });
   472→      await respondToNext({ sessionId: 'session-123' });
   473→      await sessionPromise;
   474→    });
   475→
   476→    it('should send prompt and return response with stopReason', async () => {
   477→      const promptPromise = client.prompt({
   478→        sessionId: 'session-123',
   479→        prompt: [{ type: 'text', text: 'Hello' }],
   480→      });
   481→
   482→      await respondToNext({
   483→        stopReason: 'end_turn',
   484→      });
   485→
   486→      const response = await promptPromise;
   487→      expect(response.stopReason).toBe('end_turn');
   488→    });
   489→
   490→    it('should update session status during prompt', async () => {
   491→      // Capture the request without immediately responding
   492→      let requestId: number | string | undefined;
   493→      const requestReceived = new Promise<void>((resolve) => {
   494→        stdout.once('data', (chunk: Buffer) => {
   495→          const request = JSON.parse(chunk.toString());
   496→          requestId = request.id;
   497→          resolve();
   498→        });
   499→      });
   500→
   501→      const promptPromise = client.prompt({
   502→        sessionId: 'session-123',
   503→        prompt: [{ type: 'text', text: 'Hello' }],
   504→      });
   505→
   506→      // Wait for request to be sent
   507→      await requestReceived;
   508→
   509→      // NOW check status - should be prompting since we haven't responded yet
   510→      expect(client.getSession('session-123')?.status).toBe('prompting');
   511→
   512→      // Send response
   513→      stdin.write(
   514→        JSON.stringify({
   515→          jsonrpc: '2.0',
   516→          id: requestId,
   517→          result: { stopReason: 'end_turn' },
   518→        }) + '\n',
   519→      );
   520→
   521→      await promptPromise;
   522→
   523→      // Check status is idle after
   524→      expect(client.getSession('session-123')?.status).toBe('idle');
   525→    });
   526→
   527→    it('should throw if session not found', async () => {
   528→      await expect(
   529→        client.prompt({
   530→          sessionId: 'nonexistent',
   531→          prompt: [{ type: 'text', text: 'Hello' }],
   532→        }),
   533→      ).rejects.toThrow('Session not found');
   534→    });
   535→
   536→    it('should throw if already prompting', async () => {
   537→      // Capture the first request without immediately responding
   538→      let requestId: number | string | undefined;
   539→      const requestReceived = new Promise<void>((resolve) => {
   540→        stdout.once('data', (chunk: Buffer) => {
   541→          const request = JSON.parse(chunk.toString());
   542→          requestId = request.id;
   543→          resolve();
   544→        });
   545→      });
   546→
   547→      // Start first prompt (don't await)
   548→      const firstPrompt = client.prompt({
   549→        sessionId: 'session-123',
   550→        prompt: [{ type: 'text', text: 'Hello' }],
   551→      });
   552→
   553→      // Wait for first prompt request to be sent
   554→      await requestReceived;
   555→
   556→      // Try second prompt - should fail because first is still prompting
   557→      await expect(
   558→        client.prompt({
   559→          sessionId: 'session-123',
   560→          prompt: [{ type: 'text', text: 'Hello again' }],
   561→        }),
   562→      ).rejects.toThrow('already prompting');
   563→
   564→      // Clean up first prompt by sending response
   565→      stdin.write(
   566→        JSON.stringify({
   567→          jsonrpc: '2.0',
   568→          id: requestId,
   569→          result: { stopReason: 'end_turn' },
   570→        }) + '\n',
   571→      );
   572→      await firstPrompt;
   573→    });
   574→  });
   575→
   576→  // AC: @acp-client ac-4
   577→  describe('update events', () => {
   578→    beforeEach(async () => {
   579→      const initPromise = client.initialize();
   580→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   581→      await initPromise;
   582→
   583→      const sessionPromise = client.newSession({ cwd: '/' });
   584→      await respondToNext({ sessionId: 'session-123' });
   585→      await sessionPromise;
   586→    });
   587→
   588→    it('should emit update events for session updates', async () => {
   589→      const updatePromise = new Promise<{ sessionId: string; update: unknown }>(
   590→        (resolve) => {
   591→          client.on('update', (sessionId, update) => {
   592→            resolve({ sessionId, update });
   593→          });
   594→        },
   595→      );
   596→
   597→      // Send session update notification
   598→      stdin.write(
   599→        JSON.stringify({
   600→          jsonrpc: '2.0',
   601→          method: 'session/update',
   602→          params: {
   603→            sessionId: 'session-123',
   604→            update: {
   605→              sessionUpdate: 'assistant_message_chunk',
   606→              content: { type: 'text', text: 'Hello!' },
   607→            },
   608→          },
   609→        }) + '\n',
   610→      );
   611→
   612→      const { sessionId, update } = await updatePromise;
   613→      expect(sessionId).toBe('session-123');
   614→      expect(update).toEqual({
   615→        sessionUpdate: 'assistant_message_chunk',
   616→        content: { type: 'text', text: 'Hello!' },
   617→      });
   618→    });
   619→  });
   620→
   621→  // AC: @acp-client ac-7
   622→  describe('cancel', () => {
   623→    beforeEach(async () => {
   624→      const initPromise = client.initialize();
   625→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   626→      await initPromise;
   627→
   628→      const sessionPromise = client.newSession({ cwd: '/' });
   629→      await respondToNext({ sessionId: 'session-123' });
   630→      await sessionPromise;
   631→    });
   632→
   633→    it('should send cancel request', async () => {
   634→      const cancelPromise = client.cancel('session-123');
   635→      await respondToNext({});
   636→      await cancelPromise;
   637→
   638→      expect(client.getSession('session-123')?.status).toBe('cancelled');
   639→    });
   640→
   641→    it('should silently handle Method not found errors', async () => {
   642→      // Suppress console.error for this test
   643→      const consoleSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
   644→
   645→      const cancelPromise = client.cancel('session-123');
   646→
   647→      // Respond with Method not found
   648→      stdout.once('data', (chunk: Buffer) => {
   649→        const request = JSON.parse(chunk.toString());
   650→        stdin.write(
   651→          JSON.stringify({
   652→            jsonrpc: '2.0',
   653→            id: request.id,
   654→            error: { code: -32601, message: 'Method not found' },
   655→          }) + '\n',
   656→        );
   657→      });
   658→
   659→      // Should not throw
   660→      await cancelPromise;
   661→
   662→      consoleSpy.mockRestore();
   663→    });
   664→
   665→    it('should throw for other errors', async () => {
   666→      // Suppress console.error for this test
   667→      const consoleSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
   668→
   669→      const cancelPromise = client.cancel('session-123');
   670→
   671→      // Respond with different error
   672→      stdout.once('data', (chunk: Buffer) => {
   673→        const request = JSON.parse(chunk.toString());
   674→        stdin.write(
   675→          JSON.stringify({
   676→            jsonrpc: '2.0',
   677→            id: request.id,
   678→            error: { code: -32603, message: 'Internal error' },
   679→          }) + '\n',
   680→        );
   681→      });
   682→
   683→      await expect(cancelPromise).rejects.toThrow('Internal error');
   684→
   685→      consoleSpy.mockRestore();
   686→    });
   687→  });
   688→
   689→  // AC: @acp-client ac-8
   690→  describe('close', () => {
   691→    it('should close and emit close event', async () => {
   692→      const closePromise = new Promise<void>((resolve) => {
   693→        client.on('close', resolve);
   694→      });
   695→
   696→      client.close();
   697→
   698→      await closePromise;
   699→      expect(client.isClosed()).toBe(true);
   700→    });
   701→
   702→    it('should throw on operations after close', async () => {
   703→      const initPromise = client.initialize();
   704→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   705→      await initPromise;
   706→
   707→      client.close();
   708→
   709→      await expect(client.newSession({ cwd: '/' })).rejects.toThrow('closed');
   710→    });
   711→  });
   712→});
   713→
   714→// ============================================================================
   715→// ACP Mock Tests (for mock agent implementation)
   716→// ============================================================================
   717→
   718→describe('ACP Mock Agent', () => {
   719→  let mockProcess: ReturnType<typeof spawn>;
   720→  let client: ACPClient;
   721→
   722→  beforeEach(() => {
   723→    // Spawn the mock agent as a subprocess
   724→    const { spawn } = require('node:child_process');
   725→    const mockPath = path.join(__dirname, 'mocks', 'acp-mock.js');
   726→    mockProcess = spawn('node', [mockPath]);
   727→
   728→    // Create ACP client connected to the mock
   729→    client = new ACPClient({
   730→      stdin: mockProcess.stdout, // Our stdin reads from mock's stdout
   731→      stdout: mockProcess.stdin, // Our stdout writes to mock's stdin
   732→      timeout: 5000,
   733→      clientInfo: {
   734→        name: 'test-client',
   735→        version: '1.0.0',
   736→      },
   737→    });
   738→  });
   739→
   740→  afterEach(() => {
   741→    client.close();
   742→    mockProcess.kill();
   743→  });
   744→
   745→  describe('session/request_permission', () => {
   746→    beforeEach(async () => {
   747→      // Initialize the mock agent before each test
   748→      await client.initialize();
   749→    });
   750→
   751→    it('should auto-approve with allow_always option', async () => {
   752→      // Send permission request with allow_always option
   753→      // Note: We need to use the framing layer directly since ACPClient doesn't expose requestPermission
   754→      const result = await (client as any).framing.sendRequest('session/request_permission', {
   755→        options: [
   756→          { optionId: 'deny-1', kind: 'deny' },
   757→          { optionId: 'allow-always-1', kind: 'allow_always' },
   758→          { optionId: 'allow-once-1', kind: 'allow_once' },
   759→        ],
   760→      });
   761→
   762→      // Should select the allow_always option
   763→      expect(result).toEqual({
   764→        outcome: { outcome: 'selected', optionId: 'allow-always-1' },
   765→      });
   766→    });
   767→
   768→    it('should auto-approve with allow_once when allow_always not available', async () => {
   769→      const result = await (client as any).framing.sendRequest('session/request_permission', {
   770→        options: [
   771→          { optionId: 'deny-1', kind: 'deny' },
   772→          { optionId: 'allow-once-1', kind: 'allow_once' },
   773→        ],
   774→      });
   775→
   776→      // Should select the allow_once option
   777→      expect(result).toEqual({
   778→        outcome: { outcome: 'selected', optionId: 'allow-once-1' },
   779→      });
   780→    });
   781→
   782→    it('should cancel permission requests with no allow options', async () => {
   783→      const result = await (client as any).framing.sendRequest('session/request_permission', {
   784→        options: [
   785→          { optionId: 'deny-1', kind: 'deny' },
   786→          { optionId: 'deny-2', kind: 'deny' },
   787→        ],
   788→      });
   789→
   790→      // Should cancel since no allow option available
   791→      expect(result).toEqual({
   792→        outcome: { outcome: 'cancelled' },
   793→      });
   794→    });
   795→
   796→    it('should handle empty options array', async () => {
   797→      const result = await (client as any).framing.sendRequest('session/request_permission', {
   798→        options: [],
   799→      });
   800→
   801→      // Should cancel since no options available
   802→      expect(result).toEqual({
   803→        outcome: { outcome: 'cancelled' },
   804→      });
   805→    });
   806→
   807→    it('should prefer allow_always over allow_once', async () => {
   808→      const result = await (client as any).framing.sendRequest('session/request_permission', {
   809→        options: [
   810→          { optionId: 'allow-once-1', kind: 'allow_once' },
   811→          { optionId: 'allow-always-1', kind: 'allow_always' },
   812→        ],
   813→      });
   814→
   815→      // Should prefer allow_always
   816→      expect(result).toEqual({
   817→        outcome: { outcome: 'selected', optionId: 'allow-always-1' },
   818→      });
   819→    });
   820→  });
   821→
   822→  describe('session/request_permission - error handling', () => {
   823→    it('should error on permission requests before initialization', async () => {
   824→      // Don't initialize - create a fresh client and send request directly
   825→      const { spawn } = require('node:child_process');
   826→      const mockPath = path.join(__dirname, 'mocks', 'acp-mock.js');
   827→      const freshMock = spawn('node', [mockPath]);
   828→
   829→      const freshClient = new ACPClient({
   830→        stdin: freshMock.stdout,
   831→        stdout: freshMock.stdin,
   832→        timeout: 5000,
   833→        clientInfo: { name: 'test', version: '1.0.0' },
   834→      });
   835→
   836→      try {
   837→        // Suppress console.error for this test
   838→        const consoleSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
   839→
   840→        await expect(
   841→          (freshClient as any).framing.sendRequest('session/request_permission', {
   842→            options: [{ optionId: 'allow-1', kind: 'allow_once' }],
   843→          }),
   844→        ).rejects.toThrow('Not initialized');
   845→
   846→        consoleSpy.mockRestore();
   847→      } finally {
   848→        freshClient.close();
   849→        freshMock.kill();
   850→      }
   851→    });
   852→  });
   853→});
