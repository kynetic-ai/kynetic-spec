     1→/**
     2→ * Meta manifest loading and operations.
     3→ *
     4→ * The meta manifest (kynetic.meta.yaml) contains process definitions:
     5→ * - Agents: roles, capabilities, conventions
     6→ * - Workflows: structured processes with steps
     7→ * - Conventions: project rules and standards
     8→ * - Observations: feedback about processes
     9→ */
    10→
    11→import * as fs from 'node:fs/promises';
    12→import * as path from 'node:path';
    13→import { ulid } from 'ulid';
    14→import {
    15→  MetaManifestSchema,
    16→  AgentSchema,
    17→  WorkflowSchema,
    18→  ConventionSchema,
    19→  ObservationSchema,
    20→  SessionContextSchema,
    21→  WorkflowRunsFileSchema,
    22→  WorkflowRunSchema,
    23→  type MetaManifest,
    24→  type Agent,
    25→  type Workflow,
    26→  type Convention,
    27→  type Observation,
    28→  type MetaItem,
    29→  type ObservationType,
    30→  type SessionContext,
    31→  type WorkflowRun,
    32→  type WorkflowRunsFile,
    33→  getMetaItemType,
    34→} from '../schema/index.js';
    35→import { readYamlFile, writeYamlFilePreserveFormat, expandIncludePattern, getAuthor } from './yaml.js';
    36→import type { KspecContext } from './yaml.js';
    37→
    38→/**
    39→ * Loaded agent with runtime metadata
    40→ */
    41→export interface LoadedAgent extends Agent {
    42→  _sourceFile?: string;
    43→}
    44→
    45→/**
    46→ * Loaded workflow with runtime metadata
    47→ */
    48→export interface LoadedWorkflow extends Workflow {
    49→  _sourceFile?: string;
    50→}
    51→
    52→/**
    53→ * Loaded convention with runtime metadata
    54→ */
    55→export interface LoadedConvention extends Convention {
    56→  _sourceFile?: string;
    57→}
    58→
    59→/**
    60→ * Loaded observation with runtime metadata
    61→ */
    62→export interface LoadedObservation extends Observation {
    63→  _sourceFile?: string;
    64→}
    65→
    66→/**
    67→ * Any loaded meta item
    68→ */
    69→export type LoadedMetaItem = LoadedAgent | LoadedWorkflow | LoadedConvention | LoadedObservation;
    70→
    71→/**
    72→ * Meta context containing all loaded meta items
    73→ */
    74→export interface MetaContext {
    75→  manifest: MetaManifest | null;
    76→  manifestPath: string | null;
    77→  agents: LoadedAgent[];
    78→  workflows: LoadedWorkflow[];
    79→  conventions: LoadedConvention[];
    80→  observations: LoadedObservation[];
    81→}
    82→
    83→/**
    84→ * Find the meta manifest file (kynetic.meta.yaml)
    85→ */
    86→export async function findMetaManifest(specDir: string): Promise<string | null> {
    87→  const candidates = ['kynetic.meta.yaml'];
    88→
    89→  for (const candidate of candidates) {
    90→    const filePath = path.join(specDir, candidate);
    91→    try {
    92→      await fs.access(filePath);
    93→      return filePath;
    94→    } catch {
    95→      // File doesn't exist, try next
    96→    }
    97→  }
    98→
    99→  return null;
   100→}
   101→
   102→/**
   103→ * Get the meta manifest file path.
   104→ * Returns path even if file doesn't exist yet.
   105→ */
   106→export function getMetaManifestPath(ctx: KspecContext): string {
   107→  return path.join(ctx.specDir, 'kynetic.meta.yaml');
   108→}
   109→
   110→/**
   111→ * Load meta items from a single file.
   112→ */
   113→async function loadMetaFile(
   114→  filePath: string
   115→): Promise<{
   116→  agents: LoadedAgent[];
   117→  workflows: LoadedWorkflow[];
   118→  conventions: LoadedConvention[];
   119→  observations: LoadedObservation[];
   120→}> {
   121→  const result: {
   122→    agents: LoadedAgent[];
   123→    workflows: LoadedWorkflow[];
   124→    conventions: LoadedConvention[];
   125→    observations: LoadedObservation[];
   126→  } = {
   127→    agents: [],
   128→    workflows: [],
   129→    conventions: [],
   130→    observations: [],
   131→  };
   132→
   133→  try {
   134→    const raw = await readYamlFile<unknown>(filePath);
   135→    if (!raw || typeof raw !== 'object') {
   136→      return result;
   137→    }
   138→
   139→    const obj = raw as Record<string, unknown>;
   140→
   141→    // Parse agents
   142→    if (Array.isArray(obj.agents)) {
   143→      for (const agent of obj.agents) {
   144→        const parsed = AgentSchema.safeParse(agent);
   145→        if (parsed.success) {
   146→          result.agents.push({ ...parsed.data, _sourceFile: filePath });
   147→        }
   148→      }
   149→    }
   150→
   151→    // Parse workflows
   152→    if (Array.isArray(obj.workflows)) {
   153→      for (const workflow of obj.workflows) {
   154→        const parsed = WorkflowSchema.safeParse(workflow);
   155→        if (parsed.success) {
   156→          result.workflows.push({ ...parsed.data, _sourceFile: filePath });
   157→        }
   158→      }
   159→    }
   160→
   161→    // Parse conventions
   162→    if (Array.isArray(obj.conventions)) {
   163→      for (const convention of obj.conventions) {
   164→        const parsed = ConventionSchema.safeParse(convention);
   165→        if (parsed.success) {
   166→          result.conventions.push({ ...parsed.data, _sourceFile: filePath });
   167→        }
   168→      }
   169→    }
   170→
   171→    // Parse observations
   172→    if (Array.isArray(obj.observations)) {
   173→      for (const observation of obj.observations) {
   174→        const parsed = ObservationSchema.safeParse(observation);
   175→        if (parsed.success) {
   176→          result.observations.push({ ...parsed.data, _sourceFile: filePath });
   177→        }
   178→      }
   179→    }
   180→  } catch {
   181→    // File doesn't exist or parse error
   182→  }
   183→
   184→  return result;
   185→}
   186→
   187→/**
   188→ * Load the meta context from a kspec context.
   189→ * Loads meta manifest and follows includes.
   190→ */
   191→export async function loadMetaContext(ctx: KspecContext): Promise<MetaContext> {
   192→  const result: MetaContext = {
   193→    manifest: null,
   194→    manifestPath: null,
   195→    agents: [],
   196→    workflows: [],
   197→    conventions: [],
   198→    observations: [],
   199→  };
   200→
   201→  const manifestPath = await findMetaManifest(ctx.specDir);
   202→  if (!manifestPath) {
   203→    return result;
   204→  }
   205→
   206→  result.manifestPath = manifestPath;
   207→
   208→  try {
   209→    const raw = await readYamlFile<unknown>(manifestPath);
   210→    const parsed = MetaManifestSchema.safeParse(raw);
   211→    if (!parsed.success) {
   212→      // Invalid manifest, but we can still try to extract items
   213→      const items = await loadMetaFile(manifestPath);
   214→      result.agents.push(...items.agents);
   215→      result.workflows.push(...items.workflows);
   216→      result.conventions.push(...items.conventions);
   217→      result.observations.push(...items.observations);
   218→      return result;
   219→    }
   220→
   221→    result.manifest = parsed.data;
   222→
   223→    // Load items from manifest
   224→    const manifestItems = await loadMetaFile(manifestPath);
   225→    result.agents.push(...manifestItems.agents);
   226→    result.workflows.push(...manifestItems.workflows);
   227→    result.conventions.push(...manifestItems.conventions);
   228→    result.observations.push(...manifestItems.observations);
   229→
   230→    // Process includes
   231→    const includes = parsed.data.includes || [];
   232→    const manifestDir = path.dirname(manifestPath);
   233→
   234→    for (const include of includes) {
   235→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   236→
   237→      for (const filePath of expandedPaths) {
   238→        const items = await loadMetaFile(filePath);
   239→        result.agents.push(...items.agents);
   240→        result.workflows.push(...items.workflows);
   241→        result.conventions.push(...items.conventions);
   242→        result.observations.push(...items.observations);
   243→      }
   244→    }
   245→  } catch {
   246→    // Manifest exists but may be invalid
   247→  }
   248→
   249→  return result;
   250→}
   251→
   252→/**
   253→ * Get meta stats summary
   254→ */
   255→export function getMetaStats(meta: MetaContext): {
   256→  agents: number;
   257→  workflows: number;
   258→  conventions: number;
   259→  observations: number;
   260→  unresolvedObservations: number;
   261→} {
   262→  return {
   263→    agents: meta.agents.length,
   264→    workflows: meta.workflows.length,
   265→    conventions: meta.conventions.length,
   266→    observations: meta.observations.length,
   267→    unresolvedObservations: meta.observations.filter((o) => !o.resolved).length,
   268→  };
   269→}
   270→
   271→/**
   272→ * Find a meta item by reference (ULID, short ULID, or id)
   273→ */
   274→export function findMetaItemByRef(
   275→  meta: MetaContext,
   276→  ref: string
   277→): LoadedMetaItem | undefined {
   278→  const cleanRef = ref.startsWith('@') ? ref.slice(1) : ref;
   279→
   280→  // Search all item types
   281→  const allItems: LoadedMetaItem[] = [
   282→    ...meta.agents,
   283→    ...meta.workflows,
   284→    ...meta.conventions,
   285→    ...meta.observations,
   286→  ];
   287→
   288→  for (const item of allItems) {
   289→    // Match full ULID
   290→    if (item._ulid === cleanRef) return item;
   291→
   292→    // Match short ULID (prefix)
   293→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase())) return item;
   294→
   295→    // Match by id (for agents and workflows)
   296→    if ('id' in item && item.id === cleanRef) return item;
   297→
   298→    // Match by domain (for conventions)
   299→    if ('domain' in item && item.domain === cleanRef) return item;
   300→  }
   301→
   302→  return undefined;
   303→}
   304→
   305→/**
   306→ * Determine if an item is a meta item type
   307→ */
   308→export function isMetaItemType(type: string): boolean {
   309→  return ['agent', 'workflow', 'convention', 'observation'].includes(type);
   310→}
   311→
   312→// ============================================================
   313→// META ITEM CRUD
   314→// ============================================================
   315→
   316→/**
   317→ * Save the entire meta manifest to file
   318→ */
   319→async function saveMetaManifest(
   320→  manifestPath: string,
   321→  manifest: MetaManifest
   322→): Promise<void> {
   323→  await writeYamlFilePreserveFormat(manifestPath, manifest);
   324→}
   325→
   326→/**
   327→ * Strip runtime metadata before serialization
   328→ */
   329→function stripMetaMetadata<T extends LoadedMetaItem>(item: T): Omit<T, '_sourceFile'> {
   330→  const { _sourceFile, ...cleanItem } = item;
   331→  return cleanItem as Omit<T, '_sourceFile'>;
   332→}
   333→
   334→/**
   335→ * Create a new observation
   336→ */
   337→export function createObservation(
   338→  type: ObservationType,
   339→  content: string,
   340→  options: {
   341→    workflow_ref?: string;
   342→    author?: string;
   343→  } = {}
   344→): Observation {
   345→  return {
   346→    _ulid: ulid(),
   347→    type,
   348→    content,
   349→    workflow_ref: options.workflow_ref,
   350→    created_at: new Date().toISOString(),
   351→    author: options.author ?? getAuthor(),
   352→    resolved: false,
   353→    resolution: null,
   354→  };
   355→}
   356→
   357→/**
   358→ * Save an observation to the meta manifest
   359→ */
   360→export async function saveObservation(
   361→  ctx: KspecContext,
   362→  observation: LoadedObservation
   363→): Promise<void> {
   364→  const manifestPath = getMetaManifestPath(ctx);
   365→
   366→  // Ensure directory exists
   367→  const dir = path.dirname(manifestPath);
   368→  await fs.mkdir(dir, { recursive: true });
   369→
   370→  // Load existing manifest
   371→  let manifest: MetaManifest = {
   372→    kynetic_meta: '1.0',
   373→    agents: [],
   374→    workflows: [],
   375→    conventions: [],
   376→    observations: [],
   377→    includes: [],
   378→  };
   379→
   380→  try {
   381→    const raw = await readYamlFile<unknown>(manifestPath);
   382→    const parsed = MetaManifestSchema.safeParse(raw);
   383→    if (parsed.success) {
   384→      manifest = parsed.data;
   385→    }
   386→  } catch {
   387→    // File doesn't exist, use defaults
   388→  }
   389→
   390→  // Strip runtime metadata
   391→  const cleanObs = stripMetaMetadata(observation);
   392→
   393→  // Update or add
   394→  const existingIndex = manifest.observations.findIndex(
   395→    (o) => o._ulid === observation._ulid
   396→  );
   397→  if (existingIndex >= 0) {
   398→    manifest.observations[existingIndex] = cleanObs as Observation;
   399→  } else {
   400→    manifest.observations.push(cleanObs as Observation);
   401→  }
   402→
   403→  await saveMetaManifest(manifestPath, manifest);
   404→}
   405→
   406→/**
   407→ * Delete an observation from the meta manifest
   408→ */
   409→export async function deleteObservation(
   410→  ctx: KspecContext,
   411→  ulid: string
   412→): Promise<boolean> {
   413→  const manifestPath = getMetaManifestPath(ctx);
   414→
   415→  try {
   416→    const raw = await readYamlFile<unknown>(manifestPath);
   417→    const parsed = MetaManifestSchema.safeParse(raw);
   418→    if (!parsed.success) {
   419→      return false;
   420→    }
   421→
   422→    const manifest = parsed.data;
   423→    const index = manifest.observations.findIndex((o) => o._ulid === ulid);
   424→    if (index < 0) {
   425→      return false;
   426→    }
   427→
   428→    manifest.observations.splice(index, 1);
   429→    await saveMetaManifest(manifestPath, manifest);
   430→    return true;
   431→  } catch {
   432→    return false;
   433→  }
   434→}
   435→
   436→// Re-export the getMetaItemType function
   437→export { getMetaItemType };
   438→export type { Agent, Workflow, Convention, Observation, MetaItem };
   439→
   440→// ============================================================
   441→// GENERIC META ITEM CRUD
   442→// ============================================================
   443→
   444→/**
   445→ * Save any meta item (agent, workflow, convention) to the manifest
   446→ */
   447→export async function saveMetaItem(
   448→  ctx: KspecContext,
   449→  item: LoadedMetaItem,
   450→  itemType: 'agent' | 'workflow' | 'convention'
   451→): Promise<void> {
   452→  const manifestPath = getMetaManifestPath(ctx);
   453→
   454→  // Ensure directory exists
   455→  const dir = path.dirname(manifestPath);
   456→  await fs.mkdir(dir, { recursive: true });
   457→
   458→  // Load existing manifest
   459→  let manifest: MetaManifest = {
   460→    kynetic_meta: '1.0',
   461→    agents: [],
   462→    workflows: [],
   463→    conventions: [],
   464→    observations: [],
   465→    includes: [],
   466→  };
   467→
   468→  try {
   469→    const raw = await readYamlFile<unknown>(manifestPath);
   470→    const parsed = MetaManifestSchema.safeParse(raw);
   471→    if (parsed.success) {
   472→      manifest = parsed.data;
   473→    }
   474→  } catch {
   475→    // File doesn't exist, use defaults
   476→  }
   477→
   478→  // Strip runtime metadata
   479→  const cleanItem = stripMetaMetadata(item);
   480→
   481→  // Get the appropriate array
   482→  const getArray = () => {
   483→    switch (itemType) {
   484→      case 'agent':
   485→        return manifest.agents;
   486→      case 'workflow':
   487→        return manifest.workflows;
   488→      case 'convention':
   489→        return manifest.conventions;
   490→    }
   491→  };
   492→
   493→  const array = getArray();
   494→
   495→  // Update or add
   496→  const existingIndex = array.findIndex((i) => i._ulid === item._ulid);
   497→  if (existingIndex >= 0) {
   498→    (array as unknown[])[existingIndex] = cleanItem;
   499→  } else {
   500→    (array as unknown[]).push(cleanItem);
   501→  }
   502→
   503→  await saveMetaManifest(manifestPath, manifest);
   504→}
   505→
   506→/**
   507→ * Delete any meta item from the manifest
   508→ */
   509→export async function deleteMetaItem(
   510→  ctx: KspecContext,
   511→  itemUlid: string,
   512→  itemType: 'agent' | 'workflow' | 'convention' | 'observation'
   513→): Promise<boolean> {
   514→  const manifestPath = getMetaManifestPath(ctx);
   515→
   516→  try {
   517→    const raw = await readYamlFile<unknown>(manifestPath);
   518→    const parsed = MetaManifestSchema.safeParse(raw);
   519→    if (!parsed.success) {
   520→      return false;
   521→    }
   522→
   523→    const manifest = parsed.data;
   524→
   525→    const getArray = () => {
   526→      switch (itemType) {
   527→        case 'agent':
   528→          return manifest.agents;
   529→        case 'workflow':
   530→          return manifest.workflows;
   531→        case 'convention':
   532→          return manifest.conventions;
   533→        case 'observation':
   534→          return manifest.observations;
   535→      }
   536→    };
   537→
   538→    const array = getArray();
   539→    const index = array.findIndex((i) => i._ulid === itemUlid);
   540→    if (index < 0) {
   541→      return false;
   542→    }
   543→
   544→    array.splice(index, 1);
   545→    await saveMetaManifest(manifestPath, manifest);
   546→    return true;
   547→  } catch {
   548→    return false;
   549→  }
   550→}
   551→
   552→// ============================================================
   553→// SESSION CONTEXT
   554→// ============================================================
   555→
   556→/**
   557→ * Get the session context file path
   558→ */
   559→export function getSessionContextPath(ctx: KspecContext): string {
   560→  return path.join(ctx.specDir, '.kspec-session');
   561→}
   562→
   563→/**
   564→ * Load session context (or return empty context if not exists)
   565→ */
   566→export async function loadSessionContext(ctx: KspecContext): Promise<SessionContext> {
   567→  const contextPath = getSessionContextPath(ctx);
   568→
   569→  try {
   570→    const raw = await readYamlFile<unknown>(contextPath);
   571→    if (!raw || typeof raw !== 'object') {
   572→      return {
   573→        focus: null,
   574→        threads: [],
   575→        open_questions: [],
   576→        updated_at: new Date().toISOString(),
   577→      };
   578→    }
   579→
   580→    // Validate and parse using schema
   581→    const result = SessionContextSchema.safeParse(raw);
   582→    if (result.success) {
   583→      return result.data;
   584→    }
   585→
   586→    // If validation fails, return empty context
   587→    return {
   588→      focus: null,
   589→      threads: [],
   590→      open_questions: [],
   591→      updated_at: new Date().toISOString(),
   592→    };
   593→  } catch {
   594→    return {
   595→      focus: null,
   596→      threads: [],
   597→      open_questions: [],
   598→      updated_at: new Date().toISOString(),
   599→    };
   600→  }
   601→}
   602→
   603→/**
   604→ * Save session context
   605→ */
   606→export async function saveSessionContext(ctx: KspecContext, context: SessionContext): Promise<void> {
   607→  const contextPath = getSessionContextPath(ctx);
   608→
   609→  // Update timestamp
   610→  context.updated_at = new Date().toISOString();
   611→
   612→  await writeYamlFilePreserveFormat(contextPath, context);
   613→}
   614→
   615→// ============================================================
   616→// WORKFLOW RUNS
   617→// ============================================================
   618→
   619→/**
   620→ * Get the workflow runs file path
   621→ */
   622→export function getWorkflowRunsPath(ctx: KspecContext): string {
   623→  return path.join(ctx.specDir, 'kynetic.runs.yaml');
   624→}
   625→
   626→/**
   627→ * Load workflow runs from file
   628→ */
   629→export async function loadWorkflowRuns(ctx: KspecContext): Promise<WorkflowRun[]> {
   630→  const runsPath = getWorkflowRunsPath(ctx);
   631→
   632→  try {
   633→    const raw = await readYamlFile<unknown>(runsPath);
   634→    const parsed = WorkflowRunsFileSchema.safeParse(raw);
   635→
   636→    if (!parsed.success) {
   637→      return [];
   638→    }
   639→
   640→    return parsed.data.runs;
   641→  } catch {
   642→    // File doesn't exist
   643→    return [];
   644→  }
   645→}
   646→
   647→/**
   648→ * Save a workflow run (create or update)
   649→ */
   650→export async function saveWorkflowRun(ctx: KspecContext, run: WorkflowRun): Promise<void> {
   651→  const runsPath = getWorkflowRunsPath(ctx);
   652→
   653→  // Load existing runs
   654→  const runs = await loadWorkflowRuns(ctx);
   655→
   656→  // Update or add
   657→  const existingIndex = runs.findIndex((r) => r._ulid === run._ulid);
   658→  if (existingIndex >= 0) {
   659→    runs[existingIndex] = run;
   660→  } else {
   661→    runs.push(run);
   662→  }
   663→
   664→  // Save back
   665→  const runsFile: WorkflowRunsFile = {
   666→    kynetic_runs: '1.0',
   667→    runs,
   668→  };
   669→
   670→  await writeYamlFilePreserveFormat(runsPath, runsFile);
   671→}
   672→
   673→/**
   674→ * Update an existing workflow run
   675→ */
   676→export async function updateWorkflowRun(ctx: KspecContext, run: WorkflowRun): Promise<void> {
   677→  await saveWorkflowRun(ctx, run);
   678→}
   679→
   680→/**
   681→ * Find a workflow run by reference (ULID or ULID prefix)
   682→ */
   683→export async function findWorkflowRunByRef(
   684→  ctx: KspecContext,
   685→  ref: string
   686→): Promise<WorkflowRun | undefined> {
   687→  const runs = await loadWorkflowRuns(ctx);
   688→  const cleanRef = ref.startsWith('@') ? ref.slice(1) : ref;
   689→
   690→  return runs.find((r) => r._ulid === cleanRef || r._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()));
   691→}
