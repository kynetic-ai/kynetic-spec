   656→    // AC: @shadow-sync ac-6 - shadowPull uses --ff-only first, falls back to --rebase
   657→    it('shadowPull pulls changes from remote', async () => {
   658→      await setupSyncTest();
   659→
   660→      // Make a change on remote by cloning, modifying, and pushing
   661→      const cloneDir = path.join('/tmp', `kspec-sync-clone-${Date.now()}`);
   662→      try {
   663→        execSync(`git clone ${remoteDir} ${cloneDir}`, { stdio: 'pipe' });
   664→        execSync('git config user.email "test@test.com"', { cwd: cloneDir, stdio: 'pipe' });
   665→        execSync('git config user.name "Test"', { cwd: cloneDir, stdio: 'pipe' });
   666→        execSync(`git worktree add .kspec ${SHADOW_BRANCH_NAME}`, { cwd: cloneDir, stdio: 'pipe' });
   667→
   668→        // Modify a file in the clone's shadow
   669→        const tasksFile = (await fs.readdir(path.join(cloneDir, '.kspec')))
   670→          .find(f => f.endsWith('.tasks.yaml'));
   671→        if (tasksFile) {
   672→          await fs.appendFile(
   673→            path.join(cloneDir, '.kspec', tasksFile),
   674→            '\n# Remote change\n'
   675→          );
   676→          execSync('git add -A && git commit -m "Remote change"', {
   677→            cwd: path.join(cloneDir, '.kspec'),
   678→            stdio: 'pipe',
   679→          });
   680→          execSync(`git push origin ${SHADOW_BRANCH_NAME}`, {
   681→            cwd: path.join(cloneDir, '.kspec'),
   682→            stdio: 'pipe',
   683→          });
   684→        }
   685→
   686→        // Now pull in original repo
   687→        const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   688→        const result = await shadowPull(worktreeDir);
   689→
   690→        expect(result.success).toBe(true);
   691→        expect(result.pulled).toBe(true);
   692→        expect(result.hadConflict).toBe(false);
   693→
   694→        // Verify the change was pulled
   695→        const content = await fs.readFile(path.join(worktreeDir, tasksFile!), 'utf-8');
   696→        expect(content).toContain('# Remote change');
   697→      } finally {
   698→        await fs.rm(cloneDir, { recursive: true, force: true });
   699→      }
   700→    });
