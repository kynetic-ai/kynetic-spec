   397→  // AC: @shadow-init-remote - Remote detection tests
   398→  describe('initializeShadow with remote', () => {
   399→    // Create a bare repo to act as a "remote"
   400→    const remoteDir = path.join('/tmp', `kspec-remote-test-${Date.now()}`);
   401→
   402→    beforeEach(async () => {
   403→      // Clean up remote directory
   404→      try {
   405→        await fs.rm(remoteDir, { recursive: true });
   406→      } catch {
   407→        // Doesn't exist
   408→      }
   409→    });
   410→
   411→    afterEach(async () => {
   412→      try {
   413→        await fs.rm(remoteDir, { recursive: true });
   414→      } catch {
   415→        // Best effort cleanup
   416→      }
   417→    });
   418→
   419→    // Helper to set up a bare repo as remote
   420→    async function setupBareRemote(): Promise<void> {
   421→      await fs.mkdir(remoteDir, { recursive: true });
   422→      execSync('git init --bare', { cwd: remoteDir, stdio: 'pipe' });
   423→    }
   424→
   425→    // Helper to set up a local repo with remote
   426→    async function setupLocalWithRemote(): Promise<void> {
   427→      execSync('git init -b main', { cwd: testDir, stdio: 'pipe' });
   428→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   429→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   430→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   431→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   432→      execSync(`git remote add origin ${remoteDir}`, { cwd: testDir, stdio: 'pipe' });
   433→      execSync('git push -u origin main', { cwd: testDir, stdio: 'pipe' });
   434→    }
   435→
   436→    // Helper to push shadow branch to remote
   437→    async function pushShadowToRemote(): Promise<void> {
   438→      execSync(`git -C ${testDir}/.kspec push -u origin ${SHADOW_BRANCH_NAME}`, { stdio: 'pipe' });
   439→    }
   440→
   441→    it('hasRemote returns false when no remote configured', async () => {
   442→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   443→      expect(await hasRemote(testDir)).toBe(false);
   444→    });
   445→
   446→    it('hasRemote returns true when origin exists', async () => {
   447→      await setupBareRemote();
   448→      await setupLocalWithRemote();
   449→      expect(await hasRemote(testDir)).toBe(true);
   450→    });
   451→
   452→    it('remoteBranchExists returns false when branch not on remote', async () => {
   453→      await setupBareRemote();
   454→      await setupLocalWithRemote();
   455→      expect(await remoteBranchExists(testDir, SHADOW_BRANCH_NAME)).toBe(false);
   456→    });
   457→
   458→    it('remoteBranchExists returns true after pushing shadow branch', async () => {
   459→      await setupBareRemote();
   460→      await setupLocalWithRemote();
   461→
   462→      // Initialize shadow locally
   463→      await initializeShadow(testDir);
   464→
   465→      // Push to remote
   466→      await pushShadowToRemote();
   467→
   468→      // Now check - need to fetch first
   469→      await fetchRemote(testDir);
   470→      expect(await remoteBranchExists(testDir, SHADOW_BRANCH_NAME)).toBe(true);
   471→    });
   472→
   473→    // AC: @shadow-init-remote ac-1 - Remote has shadow branch → creates worktree from it with tracking
   474→    it('attaches to existing remote shadow branch', async () => {
   475→      await setupBareRemote();
   476→      await setupLocalWithRemote();
   477→
   478→      // Initialize shadow in first repo and push
   479→      const result1 = await initializeShadow(testDir);
   480→      expect(result1.success).toBe(true);
   481→      expect(result1.branchCreated).toBe(true);
   482→
   483→      // Push shadow to remote
   484→      await pushShadowToRemote();
   485→
   486→      // Create a "clone" (new repo pointing to same remote)
   487→      const cloneDir = path.join('/tmp', `kspec-clone-test-${Date.now()}`);
   488→      try {
   489→        execSync(`git clone ${remoteDir} ${cloneDir}`, { stdio: 'pipe' });
   490→        execSync('git config user.email "test@test.com"', { cwd: cloneDir, stdio: 'pipe' });
   491→        execSync('git config user.name "Test"', { cwd: cloneDir, stdio: 'pipe' });
   492→
   493→        // Initialize shadow in clone - should attach to remote branch
   494→        const result2 = await initializeShadow(cloneDir);
   495→        expect(result2.success).toBe(true);
   496→        expect(result2.createdFromRemote).toBe(true);
   497→        expect(result2.branchCreated).toBe(false);
   498→        expect(result2.worktreeCreated).toBe(true);
   499→
   500→        // Verify worktree is healthy
   501→        const status = await getShadowStatus(cloneDir);
   502→        expect(status.healthy).toBe(true);
   503→
   504→        // Verify tracking is set up
   505→        const tracking = execSync(`git -C ${cloneDir} config branch.${SHADOW_BRANCH_NAME}.remote`, {
   506→          encoding: 'utf-8',
   507→          stdio: ['pipe', 'pipe', 'pipe'],
   508→        }).trim();
   509→        expect(tracking).toBe('origin');
   510→      } finally {
   511→        await fs.rm(cloneDir, { recursive: true, force: true });
   512→      }
   513→    });
   514→
   515→    // AC: @shadow-init-remote ac-2 - Remote exists but no shadow branch → creates orphan and pushes
   516→    it('creates orphan branch and pushes to remote', async () => {
   517→      await setupBareRemote();
   518→      await setupLocalWithRemote();
   519→
   520→      // Verify no shadow branch on remote yet
   521→      expect(await remoteBranchExists(testDir, SHADOW_BRANCH_NAME)).toBe(false);
   522→
   523→      // Initialize shadow - should create and push
   524→      const result = await initializeShadow(testDir);
   525→      expect(result.success).toBe(true);
   526→      expect(result.branchCreated).toBe(true);
   527→      expect(result.pushedToRemote).toBe(true);
   528→
   529→      // Verify shadow branch now exists on remote
   530→      await fetchRemote(testDir);
   531→      expect(await remoteBranchExists(testDir, SHADOW_BRANCH_NAME)).toBe(true);
   532→    });
   533→
   534→    // AC: @shadow-init-remote ac-3 - No remote configured → creates orphan locally (no push attempt)
   535→    it('creates orphan locally when no remote configured', async () => {
   536→      // Just a local git repo, no remote
   537→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   538→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
