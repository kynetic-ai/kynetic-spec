   223→  describe('initializeShadow', () => {
   224→    it('creates shadow branch and worktree in git repo', async () => {
   225→      // Initialize git repo with an initial commit
   226→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   227→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   228→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   229→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   230→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   231→
   232→      const result = await initializeShadow(testDir, { projectName: 'Test Project' });
   233→
   234→      expect(result.success).toBe(true);
   235→      expect(result.branchCreated).toBe(true);
   236→      expect(result.worktreeCreated).toBe(true);
   237→      expect(result.gitignoreUpdated).toBe(true);
   238→
   239→      // Verify branch exists
   240→      expect(await branchExists(testDir, SHADOW_BRANCH_NAME)).toBe(true);
   241→
   242→      // Verify worktree exists and is valid
   243→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   244→      expect(await isValidWorktree(worktreeDir)).toBe(true);
   245→
   246→      // Verify status is healthy
   247→      const status = await getShadowStatus(testDir);
   248→      expect(status.healthy).toBe(true);
   249→    });
   250→
   251→    it('is idempotent - succeeds if already initialized', async () => {
   252→      // Initialize git repo
   253→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   254→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   255→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   256→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   257→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   258→
   259→      // First init
   260→      const result1 = await initializeShadow(testDir);
   261→      expect(result1.success).toBe(true);
   262→      expect(result1.branchCreated).toBe(true);
   263→
   264→      // Second init - should succeed without creating branch again
   265→      const result2 = await initializeShadow(testDir);
   266→      expect(result2.success).toBe(true);
   267→      expect(result2.alreadyExists).toBe(true);
   268→      expect(result2.branchCreated).toBe(false);
