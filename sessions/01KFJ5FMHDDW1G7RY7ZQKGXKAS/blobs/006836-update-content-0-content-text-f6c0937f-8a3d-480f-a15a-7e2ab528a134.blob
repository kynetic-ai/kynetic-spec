   278→  describe('repairShadow', () => {
   279→    // Helper to set up a healthy shadow branch
   280→    async function setupHealthyShadow(): Promise<void> {
   281→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   282→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   283→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   284→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   285→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   286→      await initializeShadow(testDir);
   287→    }
   288→
   289→    // AC: @shadow-recovery ac-recovery-1 - Branch exists but .kspec/ deleted → repair recreates
   290→    it('recreates worktree when .kspec/ directory is deleted', async () => {
   291→      await setupHealthyShadow();
   292→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   293→
   294→      // Verify healthy before breaking
   295→      let status = await getShadowStatus(testDir);
   296→      expect(status.healthy).toBe(true);
   297→
   298→      // Break: delete the worktree directory
   299→      // First remove from git worktree list to avoid stale reference
   300→      execSync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, { cwd: testDir, stdio: 'pipe' });
   301→
   302→      // Verify broken
   303→      status = await getShadowStatus(testDir);
   304→      expect(status.healthy).toBe(false);
   305→      expect(status.branchExists).toBe(true);
   306→      expect(status.worktreeExists).toBe(false);
   307→
   308→      // Repair
   309→      const result = await repairShadow(testDir);
   310→      expect(result.success).toBe(true);
   311→      expect(result.worktreeCreated).toBe(true);
   312→
   313→      // Verify healthy again
   314→      status = await getShadowStatus(testDir);
   315→      expect(status.healthy).toBe(true);
   316→      expect(await isValidWorktree(worktreeDir)).toBe(true);
   317→    });
   318→
   319→    // AC: @shadow-recovery ac-recovery-2 - .kspec/ exists but .git file corrupt → repair recreates
   320→    it('recreates worktree when .git file is corrupted', async () => {
   321→      await setupHealthyShadow();
   322→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   323→      const gitFile = path.join(worktreeDir, '.git');
   324→
   325→      // Verify healthy before breaking
   326→      let status = await getShadowStatus(testDir);
   327→      expect(status.healthy).toBe(true);
   328→
   329→      // Break: corrupt the .git file
   330→      await fs.writeFile(gitFile, 'corrupted content');
   331→
   332→      // Verify broken
   333→      status = await getShadowStatus(testDir);
   334→      expect(status.healthy).toBe(false);
   335→      expect(status.worktreeExists).toBe(true);
   336→      expect(status.worktreeLinked).toBe(false);
   337→
   338→      // Repair
   339→      const result = await repairShadow(testDir);
   340→      expect(result.success).toBe(true);
   341→      expect(result.worktreeCreated).toBe(true);
   342→
   343→      // Verify healthy again
   344→      status = await getShadowStatus(testDir);
   345→      expect(status.healthy).toBe(true);
   346→    });
   347→
   348→    // AC: @shadow-recovery ac-recovery-3 - No shadow branch → repair fails suggesting init
   349→    it('fails with helpful error when shadow branch does not exist', async () => {
   350→      // Just a git repo without shadow branch
   351→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   352→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   353→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   354→
   355→      const result = await repairShadow(testDir);
   356→      expect(result.success).toBe(false);
   357→      expect(result.error).toContain('kspec init');
   358→    });
   359→
   360→    // AC: @shadow-recovery ac-recovery-4 - Healthy → repair succeeds without changes (idempotent)
   361→    it('succeeds without changes when already healthy', async () => {
   362→      await setupHealthyShadow();
   363→
   364→      const result = await repairShadow(testDir);
   365→      expect(result.success).toBe(true);
   366→      expect(result.alreadyExists).toBe(true);
   367→      expect(result.worktreeCreated).toBe(false);
   368→    });
   369→
   370→    // AC: @shadow-recovery ac-recovery-5 - Healthy → status reports healthy
   371→    it('status reports healthy when shadow is working', async () => {
   372→      await setupHealthyShadow();
   373→
   374→      const status = await getShadowStatus(testDir);
   375→      expect(status.healthy).toBe(true);
   376→      expect(status.branchExists).toBe(true);
   377→      expect(status.worktreeExists).toBe(true);
   378→      expect(status.worktreeLinked).toBe(true);
   379→      expect(status.error).toBeUndefined();
   380→    });
   381→
   382→    // AC: @shadow-recovery ac-recovery-6 - Issues → status reports issue and suggests repair
   383→    it('status reports specific issue when worktree is broken', async () => {
   384→      await setupHealthyShadow();
   385→
   386→      // Break: remove worktree
   387→      execSync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, { cwd: testDir, stdio: 'pipe' });
   388→
   389→      const status = await getShadowStatus(testDir);
   390→      expect(status.healthy).toBe(false);
   391→      expect(status.branchExists).toBe(true);
   392→      expect(status.worktreeExists).toBe(false);
   393→      expect(status.error).toContain('worktree missing');
   394→    });
   395→  });
