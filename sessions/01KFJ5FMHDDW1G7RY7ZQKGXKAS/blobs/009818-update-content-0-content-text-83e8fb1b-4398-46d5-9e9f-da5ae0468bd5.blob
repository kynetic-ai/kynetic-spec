```
     1→/**
     2→ * Workflow run CLI commands
     3→ *
     4→ * Implements workflow run lifecycle management:
     5→ * - kspec workflow start @ref [--task @ref] [--json]
     6→ * - kspec workflow runs [--active] [--completed] [--workflow @ref] [--json]
     7→ * - kspec workflow show @run [--json]
     8→ * - kspec workflow abort @run [--reason text] [--json]
     9→ */
    10→
    11→import { Command } from 'commander';
    12→import { ulid } from 'ulid';
    13→import chalk from 'chalk';
    14→import Table from 'cli-table3';
    15→import {
    16→  initContext,
    17→  loadMetaContext,
    18→  loadWorkflowRuns,
    19→  saveWorkflowRun,
    20→  updateWorkflowRun,
    21→  findWorkflowRunByRef,
    22→  findActiveRuns,
    23→  getAuthor,
    24→  ReferenceIndex,
    25→  loadAllTasks,
    26→  type Workflow,
    27→} from '../../parser/index.js';
    28→import type { WorkflowRun } from '../../schema/index.js';
    29→import { commitIfShadow } from '../../parser/shadow.js';
    30→import { output, success, error, isJsonMode } from '../output.js';
    31→import { errors } from '../../strings/errors.js';
    32→import { EXIT_CODES } from '../exit-codes.js';
    33→
    34→/**
    35→ * Find a workflow by reference
    36→ */
    37→function resolveWorkflowRef(ref: string, workflows: Workflow[]): Workflow | null {
    38→  const cleanRef = ref.startsWith('@') ? ref.slice(1) : ref;
    39→
    40→  // Try by ID first
    41→  let workflow = workflows.find((w) => w.id === cleanRef);
    42→  if (workflow) return workflow;
    43→
    44→  // Try by ULID or ULID prefix
    45→  workflow = workflows.find((w) => w._ulid === cleanRef || w._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()));
    46→  return workflow || null;
    47→}
    48→
    49→/**
    50→ * Format a short ULID (first 8 chars)
    51→ */
    52→function shortUlid(ulid: string): string {
    53→  return ulid.slice(0, 8).toUpperCase();
    54→}
    55→
    56→/**
    57→ * Format run status with color
    58→ */
    59→function formatStatus(status: string): string {
    60→  switch (status) {
    61→    case 'active':
    62→      return chalk.green(status);
    63→    case 'paused':
    64→      return chalk.yellow(status);
    65→    case 'completed':
    66→      return chalk.blue(status);
    67→    case 'aborted':
    68→      return chalk.red(status);
    69→    default:
    70→      return status;
    71→  }
    72→}
    73→
    74→/**
    75→ * Command: kspec workflow start @workflow-ref [--task @task-ref] [--json]
    76→ * AC: @workflow-run-foundation ac-1, ac-6
    77→ */
    78→async function workflowStart(workflowRef: string, options: { task?: string; json?: boolean }) {
    79→  const ctx = await initContext();
    80→  const metaCtx = await loadMetaContext(ctx);
    81→
    82→  // DEBUG: Log loaded workflows
    83→  // Resolve workflow reference
    84→  const workflow = resolveWorkflowRef(workflowRef, metaCtx.workflows);
    85→  if (!workflow) {
    86→    error(errors.workflowRun.workflowNotFound(workflowRef));
    87→    process.exit(EXIT_CODES.NOT_FOUND);
    88→  }
    89→
    90→  // Validate task reference if provided (AC: @workflow-run-foundation ac-6)
    91→  let taskRef: string | undefined;
    92→  if (options.task) {
    93→    const tasks = await loadAllTasks(ctx);
    94→    const index = new ReferenceIndex(tasks, []);
    95→    const result = index.resolve(options.task);
    96→    if (!result.ok) {
    97→      error(errors.reference.taskNotFound(options.task));
    98→      process.exit(EXIT_CODES.NOT_FOUND);
    99→    }
   100→    taskRef = `@${result.ulid}`;
   101→  }
   102→
   103→  // Create new workflow run
   104→  const run: WorkflowRun = {
   105→    _ulid: ulid(),
   106→    workflow_ref: `@${workflow._ulid}`,
   107→    status: 'active',
   108→    current_step: 0,
   109→    total_steps: workflow.steps.length,
   110→    started_at: new Date().toISOString(),
   111→    step_results: [],
   112→    initiated_by: getAuthor(),
   113→    task_ref: taskRef,
   114→  };
   115→
   116→  // Save the run
   117→  await saveWorkflowRun(ctx, run);
   118→
   119→  // Commit to shadow
   120→  await commitIfShadow(ctx.shadow, 'workflow-start');
   121→
   122→  // Output result
   123→  if (isJsonMode()) {
   124→    output({ run_id: run._ulid, workflow_ref: run.workflow_ref, status: run.status });
   125→  } else {
   126→    success(`Started workflow run: ${shortUlid(run._ulid)}`);
   127→    console.log(`  Workflow: ${workflow.id}`);
   128→    console.log(`  Steps: ${run.total_steps}`);
   129→    if (taskRef) {
   130→      console.log(`  Linked task: ${taskRef}`);
   131→    }
   132→  }
   133→}
   134→
   135→/**
   136→ * Command: kspec workflow runs [--active] [--completed] [--workflow @ref] [--json]
   137→ * AC: @workflow-run-foundation ac-2
   138→ */
   139→async function workflowRuns(options: {
   140→  active?: boolean;
   141→  completed?: boolean;
   142→  workflow?: string;
   143→  json?: boolean;
   144→}) {
   145→  const ctx = await initContext();
   146→  const metaCtx = await loadMetaContext(ctx);
   147→  let runs = await loadWorkflowRuns(ctx);
   148→
   149→  // Apply filters
   150→  if (options.active) {
   151→    runs = runs.filter((r) => r.status === 'active');
   152→  }
   153→  if (options.completed) {
   154→    runs = runs.filter((r) => r.status === 'completed');
   155→  }
   156→  if (options.workflow) {
   157→    const workflow = resolveWorkflowRef(options.workflow, metaCtx.workflows);
   158→    if (!workflow) {
   159→      error(errors.workflowRun.workflowNotFound(options.workflow));
   160→      process.exit(EXIT_CODES.NOT_FOUND);
   161→    }
   162→    runs = runs.filter((r) => r.workflow_ref === `@${workflow._ulid}`);
   163→  }
   164→
   165→  if (isJsonMode()) {
   166→    output({ runs });
   167→  } else {
   168→    if (runs.length === 0) {
   169→      console.log(chalk.gray('No workflow runs found'));
   170→      return;
   171→    }
   172→
   173→    const table = new Table({
   174→      head: ['ID', 'Workflow', 'Status', 'Step', 'Started'],
   175→      colWidths: [12, 25, 12, 10, 20],
   176→    });
   177→
   178→    for (const run of runs) {
   179→      const workflow = metaCtx.workflows.find((w) => `@${w._ulid}` === run.workflow_ref);
   180→      const workflowName = workflow?.id || run.workflow_ref;
   181→      const stepProgress = `${run.current_step}/${run.total_steps}`;
   182→      const started = new Date(run.started_at).toLocaleString();
   183→
   184→      table.push([
   185→        shortUlid(run._ulid),
   186→        workflowName,
   187→        formatStatus(run.status),
   188→        stepProgress,
   189→        started,
   190→      ]);
   191→    }
   192→
   193→    console.log(table.toString());
   194→  }
   195→}
   196→
   197→/**
   198→ * Command: kspec workflow show @run-id [--json]
   199→ * AC: @workflow-run-foundation ac-4
   200→ */
   201→async function workflowShow(runRef: string, options: { json?: boolean }) {
   202→  const ctx = await initContext();
   203→  const metaCtx = await loadMetaContext(ctx);
   204→
   205→  const run = await findWorkflowRunByRef(ctx, runRef);
   206→  if (!run) {
   207→    error(errors.workflowRun.runNotFound(runRef));
   208→    process.exit(EXIT_CODES.NOT_FOUND);
   209→  }
   210→
   211→  if (isJsonMode()) {
   212→    output({ run });
   213→  } else {
   214→    const workflow = metaCtx.workflows.find((w) => `@${w._ulid}` === run.workflow_ref);
   215→    const workflowName = workflow?.id || run.workflow_ref;
   216→
   217→    console.log(chalk.bold('Workflow Run Details'));
   218→    console.log(chalk.gray('─'.repeat(50)));
   219→    console.log(`ID:           ${shortUlid(run._ulid)}`);
   220→    console.log(`Workflow:     ${workflowName} (${run.workflow_ref})`);
   221→    console.log(`Status:       ${formatStatus(run.status)}`);
   222→    console.log(`Progress:     ${run.current_step}/${run.total_steps}`);
   223→    console.log(`Started:      ${new Date(run.started_at).toLocaleString()}`);
   224→
   225→    if (run.initiated_by) {
   226→      console.log(`Initiated by: ${run.initiated_by}`);
   227→    }
   228→    if (run.task_ref) {
   229→      console.log(`Task:         ${run.task_ref}`);
   230→    }
   231→    if (run.paused_at) {
   232→      console.log(`Paused:       ${new Date(run.paused_at).toLocaleString()}`);
   233→    }
   234→    if (run.completed_at) {
   235→      console.log(`Completed:    ${new Date(run.completed_at).toLocaleString()}`);
   236→    }
   237→    if (run.abort_reason) {
   238→      console.log(`Abort reason: ${run.abort_reason}`);
   239→    }
   240→
   241→    if (run.step_results.length > 0) {
   242→      console.log(chalk.gray('\nStep Results:'));
   243→      const table = new Table({
   244→        head: ['Step', 'Status', 'Started', 'Completed'],
   245→        colWidths: [8, 12, 20, 20],
   246→      });
   247→
   248→      for (const result of run.step_results) {
   249→        table.push([
   250→          result.step_index.toString(),
   251→          formatStatus(result.status),
   252→          new Date(result.started_at).toLocaleString(),
   253→          new Date(result.completed_at).toLocaleString(),
   254→        ]);
   255→      }
   256→
   257→      console.log(table.toString());
   258→    }
   259→  }
   260→}
   261→
   262→/**
   263→ * Command: kspec workflow abort @run-id [--reason text] [--json]
   264→ * AC: @workflow-run-foundation ac-3, ac-5
   265→ */
   266→async function workflowAbort(runRef: string, options: { reason?: string; json?: boolean }) {
   267→  const ctx = await initContext();
   268→
   269→  const run = await findWorkflowRunByRef(ctx, runRef);
   270→  if (!run) {
   271→    error(errors.workflowRun.runNotFound(runRef));
   272→    process.exit(EXIT_CODES.NOT_FOUND);
   273→  }
   274→
   275→  // AC: @workflow-run-foundation ac-5 - Cannot abort completed or aborted runs
   276→  if (run.status === 'completed') {
   277→    error(errors.workflowRun.cannotAbortCompleted);
   278→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   279→  }
   280→
   281→  if (run.status === 'aborted') {
   282→    error(errors.workflowRun.cannotAbortAborted);
   283→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   284→  }
   285→
   286→  // Update run status
   287→  run.status = 'aborted';
   288→  run.abort_reason = options.reason;
   289→  run.completed_at = new Date().toISOString();
   290→
   291→  await updateWorkflowRun(ctx, run);
   292→  await commitIfShadow(ctx.shadow, 'workflow-abort');
   293→
   294→  if (isJsonMode()) {
   295→    output({ run_id: run._ulid, status: run.status });
   296→  } else {
   297→    success(`Aborted workflow run: ${shortUlid(run._ulid)}`);
   298→    if (options.reason) {
   299→      console.log(`  Reason: ${options.reason}`);
   300→    }
   301→  }
   302→}
   303→
   304→/**
   305→ * Command: kspec workflow next [run-ref] [--skip] [--notes text] [--confirm] [--force] [--json]
   306→ * AC: @workflow-step-navigation ac-1 through ac-6
   307→ * AC: @workflow-enforcement-modes ac-1 through ac-4
   308→ */
   309→async function workflowNext(
   310→  runRef: string | undefined,
   311→  options: { skip?: boolean; notes?: string; confirm?: boolean; force?: boolean; json?: boolean }
   312→) {
   313→  const ctx = await initContext();
   314→  const metaCtx = await loadMetaContext(ctx);
   315→
   316→  let run: WorkflowRun | undefined;
   317→
   318→  // AC: @workflow-step-navigation ac-3, ac-4, ac-5
   319→  if (!runRef) {
   320→    const activeRuns = await findActiveRuns(ctx);
   321→
   322→    if (activeRuns.length === 0) {
   323→      // AC: @workflow-step-navigation ac-5
   324→      error(errors.workflowRun.noActiveRuns);
   325→      process.exit(EXIT_CODES.NOT_FOUND);
   326→    }
   327→
   328→    if (activeRuns.length > 1) {
   329→      // AC: @workflow-step-navigation ac-4
   330→      const runIds = activeRuns.map((r) => shortUlid(r._ulid));
   331→      error(errors.workflowRun.multipleActiveRuns(runIds));
   332→      process.exit(EXIT_CODES.VALIDATION_FAILED);
   333→    }
   334→
   335→    // AC: @workflow-step-navigation ac-3 - exactly one active run
   336→    run = activeRuns[0];
   337→  } else {
   338→    run = await findWorkflowRunByRef(ctx, runRef);
   339→    if (!run) {
   340→      error(errors.workflowRun.runNotFound(runRef));
   341→      process.exit(EXIT_CODES.NOT_FOUND);
   342→    }
   343→
   344→    if (run.status !== 'active') {
   345→      error(errors.workflowRun.runNotActive(runRef, run.status));
   346→      process.exit(EXIT_CODES.VALIDATION_FAILED);
   347→    }
   348→  }
   349→
   350→  // Get workflow definition to access steps
   351→  const workflow = metaCtx.workflows.find((w) => `@${w._ulid}` === run.workflow_ref);
   352→  if (!workflow) {
   353→    error(errors.workflowRun.workflowNotFound(run.workflow_ref));
   354→    process.exit(EXIT_CODES.NOT_FOUND);
   355→  }
   356→
   357→  // Get current step and next step
   358→  const currentStepIndex = run.current_step;
   359→  const currentStep = workflow.steps[currentStepIndex];
   360→  const isStrictMode = workflow.enforcement === 'strict';
   361→  const isLastStep = currentStepIndex === run.total_steps - 1;
   362→
   363→  // AC: @workflow-enforcement-modes ac-3 - Strict mode: --skip requires --force
   364→  if (options.skip && isStrictMode && !options.force) {
   365→    error(errors.workflowRun.skipRequiresForce);
   366→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   367→  }
   368→
   369→  // AC: @workflow-enforcement-modes ac-2, ac-3 - Check exit criteria for CURRENT step
   370→  if (currentStep.exit_criteria && currentStep.exit_criteria.length > 0 && !options.skip) {
   371→    // AC: @workflow-enforcement-modes ac-3 - Strict mode requires --confirm
   372→    if (isStrictMode && !options.confirm) {
   373→      if (!isJsonMode()) {
   374→        console.log(`Completing step ${currentStepIndex + 1}/${run.total_steps}: [${currentStep.type}] ${currentStep.content}`);
   375→        console.log(chalk.yellow('  Exit criteria:'));
   376→        for (const criterion of currentStep.exit_criteria) {
   377→          console.log(chalk.yellow(`    - ${criterion}`));
   378→        }
   379→        console.log();
   380→      }
   381→      error(errors.workflowRun.exitCriteriaNotConfirmed);
   382→      process.exit(EXIT_CODES.VALIDATION_FAILED);
   383→    }
   384→
   385→    // AC: @workflow-enforcement-modes ac-4 - Advisory mode shows criteria as guidance
   386→    if (!isStrictMode && !isJsonMode()) {
   387→      console.log(chalk.gray('  Exit criteria:'));
   388→      for (const criterion of currentStep.exit_criteria) {
   389→        console.log(chalk.gray(`    - ${criterion}`));
   390→      }
   391→    }
   392→  }
   393→
   394→  // AC: @workflow-enforcement-modes ac-1, ac-3 - Check entry criteria for NEXT step
   395→  // (Only applies when advancing from current step normally, not when skipping or completing the workflow)
   396→  // When skipping, we don't check entry criteria because we're not actually starting the next step yet
   397→  if (!isLastStep && !options.skip) {
   398→    const nextStep = workflow.steps[currentStepIndex + 1];
   399→    if (nextStep.entry_criteria && nextStep.entry_criteria.length > 0) {
   400→      // AC: @workflow-enforcement-modes ac-3 - Strict mode requires --confirm
   401→      if (isStrictMode && !options.confirm) {
   402→        if (!isJsonMode()) {
   403→          console.log(`Step ${currentStepIndex + 2}/${run.total_steps}: [${nextStep.type}] ${nextStep.content}`);
   404→          console.log(chalk.yellow('  Entry criteria:'));
   405→          for (const criterion of nextStep.entry_criteria) {
   406→            console.log(chalk.yellow(`    - ${criterion}`));
   407→          }
   408→          console.log();
   409→        }
   410→        error(errors.workflowRun.entryCriteriaNotConfirmed);
   411→        process.exit(EXIT_CODES.VALIDATION_FAILED);
   412→      }
   413→
   414→      // AC: @workflow-enforcement-modes ac-4 - Advisory mode shows criteria as guidance
   415→      if (!isStrictMode && !isJsonMode()) {
   416→        console.log(`Step ${currentStepIndex + 2}/${run.total_steps}: [${nextStep.type}] ${nextStep.content}`);
   417→        console.log(chalk.gray('  Entry criteria:'));
   418→        for (const criterion of nextStep.entry_criteria) {
   419→          console.log(chalk.gray(`    - ${criterion}`));
   420→        }
   421→        console.log();
   422→      }
   423→    }
   424→  }
   425→
   426→  // AC: @workflow-step-navigation ac-1, ac-6 - Complete current step
   427→  const previousResult = run.step_results[run.step_results.length - 1];
   428→  const startedAt = previousResult ? previousResult.completed_at : run.started_at;
   429→
   430→  // AC: @workflow-enforcement-modes ac-3 - Record confirmations in StepResult
   431→  // Check if a stub result already exists for this step (created when we advanced to it)
   432→  const existingResultIndex = run.step_results.findIndex((r) => r.step_index === currentStepIndex);
   433→
   434→  if (existingResultIndex >= 0) {
   435→    // Update existing stub result with completion data
   436→    const existingResult = run.step_results[existingResultIndex];
   437→    run.step_results[existingResultIndex] = {
   438→      ...existingResult,
   439→      status: options.skip ? ('skipped' as const) : ('completed' as const),
   440→      completed_at: new Date().toISOString(),
   441→      notes: options.notes,
   442→      exit_confirmed: currentStep.exit_criteria && currentStep.exit_criteria.length > 0 && options.confirm ? true : undefined,
   443→    };
   444→  } else {
   445→    // No stub exists (first step or old data), create complete result
   446→    const stepResult = {
   447→      step_index: currentStepIndex,
   448→      status: options.skip ? ('skipped' as const) : ('completed' as const),
   449→      started_at: startedAt,
   450→      completed_at: new Date().toISOString(),
   451→      notes: options.notes,
   452→      exit_confirmed: currentStep.exit_criteria && currentStep.exit_criteria.length > 0 && options.confirm ? true : undefined,
   453→      entry_confirmed: undefined,
   454→    };
   455→    run.step_results.push(stepResult);
   456→  }
   457→
   458→  // AC: @workflow-step-navigation ac-1 - Advance to next step or complete run
   459→  if (isLastStep) {
   460→    // AC: @workflow-step-navigation ac-2 - Complete the run
   461→    run.status = 'completed';
   462→    run.completed_at = new Date().toISOString();
   463→
   464→    await updateWorkflowRun(ctx, run);
   465→    await commitIfShadow(ctx.shadow, 'workflow-next');
   466→
   467→    // Calculate summary stats
   468→    const totalDuration = new Date(run.completed_at).getTime() - new Date(run.started_at).getTime();
   469→    const completedSteps = run.step_results.filter((r) => r.status === 'completed').length;
   470→    const skippedSteps = run.step_results.filter((r) => r.status === 'skipped').length;
   471→
   472→    if (isJsonMode()) {
   473→      output({
   474→        run_id: run._ulid,
   475→        status: run.status,
   476→        completed_at: run.completed_at,
   477→        total_duration_ms: totalDuration,
   478→        steps_completed: completedSteps,
   479→        steps_skipped: skippedSteps,
   480→      });
   481→    } else {
   482→      const currentStep = workflow.steps[currentStepIndex];
   483→      success(`Completed step ${currentStepIndex + 1}/${run.total_steps}: [${currentStep.type}] ${currentStep.content}`);
   484→      console.log();
   485→      console.log(chalk.bold('Workflow completed!'));
   486→      console.log(`  Duration: ${Math.round(totalDuration / 1000)}s`);
   487→      console.log(`  Steps completed: ${completedSteps}`);
   488→      console.log(`  Steps skipped: ${skippedSteps}`);
   489→    }
   490→  } else {
   491→    // Advance to next step
   492→    run.current_step += 1;
   493→
   494→    // AC: @workflow-enforcement-modes ac-3 - Record entry confirmation for the next step
   495→    // Create a stub step result for the next step to capture entry_confirmed and started_at
   496→    // This will be updated with completion data when the step is completed
   497→    const nextStep = workflow.steps[run.current_step];
   498→    const nextStepStartedAt = run.step_results[run.step_results.length - 1]?.completed_at || new Date().toISOString();
   499→    const nextStepStub = {
   500→      step_index: run.current_step,
   501→      status: 'completed' as const, // Placeholder, will be updated
   502→      started_at: nextStepStartedAt,
   503→      completed_at: nextStepStartedAt, // Placeholder, will be updated
   504→      entry_confirmed: nextStep.entry_criteria && nextStep.entry_criteria.length > 0 && options.confirm ? true : undefined,
   505→    };
   506→    run.step_results.push(nextStepStub);
   507→
   508→    await updateWorkflowRun(ctx, run);
   509→    await commitIfShadow(ctx.shadow, 'workflow-next');
   510→
   511→    if (isJsonMode()) {
   512→      output({
   513→        run_id: run._ulid,
   514→        current_step: run.current_step,
   515→        total_steps: run.total_steps,
   516→        next_step: {
   517→          type: nextStep.type,
   518→          content: nextStep.content,
   519→        },
   520→      });
   521→    } else {
   522→      const previousStep = workflow.steps[currentStepIndex];
   523→      success(
   524→        `Completed step ${currentStepIndex + 1}/${run.total_steps}: [${previousStep.type}] ${previousStep.content}`
   525→      );
   526→      console.log();
   527→      console.log(`Step ${run.current_step + 1}/${run.total_steps}: [${nextStep.type}] ${nextStep.content}`);
   528→    }
   529→  }
   530→}
   531→
   532→/**
   533→ * Register workflow commands
   534→ */
   535→export function registerWorkflowCommand(program: Command): void {
   536→  const workflow = program
   537→    .command('workflow')
   538→    .description('Manage workflow runs');
   539→
   540→  workflow
   541→    .command('start')
   542→    .description('Start a new workflow run')
   543→    .argument('<workflow-ref>', 'Workflow reference (@id or @ulid)')
   544→    .option('--task <task-ref>', 'Link run to a task')
   545→    .option('--json', 'Output JSON')
   546→    .action(workflowStart);
   547→
   548→  workflow
   549→    .command('runs')
   550→    .description('List workflow runs')
   551→    .option('--active', 'Show only active runs')
   552→    .option('--completed', 'Show only completed runs')
   553→    .option('--workflow <ref>', 'Filter by workflow')
   554→    .option('--json', 'Output JSON')
   555→    .action(workflowRuns);
   556→
   557→  workflow
   558→    .command('show')
   559→    .description('Show workflow run details')
   560→    .argument('<run-ref>', 'Run reference (@ulid or ulid prefix)')
