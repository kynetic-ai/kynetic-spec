   492→    data?: unknown;
   493→    constructor(code: number, message: string, data?: unknown);
   494→    /**
   495→     * Invalid JSON was received by the server. An error occurred on the server while parsing the JSON text.
   496→     */
   497→    static parseError(data?: unknown, additionalMessage?: string): RequestError;
   498→    /**
   499→     * The JSON sent is not a valid Request object.
   500→     */
   501→    static invalidRequest(data?: unknown, additionalMessage?: string): RequestError;
   502→    /**
   503→     * The method does not exist / is not available.
   504→     */
