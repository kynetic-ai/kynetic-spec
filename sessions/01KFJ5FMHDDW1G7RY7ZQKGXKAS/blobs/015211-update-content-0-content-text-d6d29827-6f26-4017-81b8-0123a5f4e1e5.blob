   482→/**
   483→ * JSON-RPC error object.
   484→ *
   485→ * Represents an error that occurred during method execution, following the
   486→ * JSON-RPC 2.0 error object specification with optional additional data.
   487→ *
   488→ * See protocol docs: [JSON-RPC Error Object](https://www.jsonrpc.org/specification#error_object)
   489→ */
   490→export declare class RequestError extends Error {
