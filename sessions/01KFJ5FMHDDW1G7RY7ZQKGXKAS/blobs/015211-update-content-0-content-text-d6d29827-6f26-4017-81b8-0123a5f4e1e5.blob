   525→/**
   526→ * The Client interface defines the interface that ACP-compliant clients must implement.
   527→ *
   528→ * Clients are typically code editors (IDEs, text editors) that provide the interface
   529→ * between users and AI agents. They manage the environment, handle user interactions,
   530→ * and control access to resources.
   531→ */
   532→export interface Client {
   533→    /**
   534→     * Requests permission from the user for a tool call operation.
   535→     *
   536→     * Called by the agent when it needs user authorization before executing
   537→     * a potentially sensitive operation. The client should present the options
   538→     * to the user and return their decision.
   539→     *
   540→     * If the client cancels the prompt turn via `session/cancel`, it MUST
   541→     * respond to this request with `RequestPermissionOutcome::Cancelled`.
   542→     *
   543→     * See protocol docs: [Requesting Permission](https://agentclientprotocol.com/protocol/tool-calls#requesting-permission)
   544→     */
   545→    requestPermission(params: schema.RequestPermissionRequest): Promise<schema.RequestPermissionResponse>;
   546→    /**
   547→     * Handles session update notifications from the agent.
   548→     *
   549→     * This is a notification endpoint (no response expected) that receives
   550→     * real-time updates about session progress, including message chunks,
   551→     * tool calls, and execution plans.
   552→     *
   553→     * Note: Clients SHOULD continue accepting tool call updates even after
   554→     * sending a `session/cancel` notification, as the agent may send final
   555→     * updates before responding with the cancelled stop reason.
   556→     *
   557→     * See protocol docs: [Agent Reports Output](https://agentclientprotocol.com/protocol/prompt-turn#3-agent-reports-output)
   558→     */
   559→    sessionUpdate(params: schema.SessionNotification): Promise<void>;
   560→    /**
   561→     * Writes content to a text file in the client's file system.
   562→     *
   563→     * Only available if the client advertises the `fs.writeTextFile` capability.
   564→     * Allows the agent to create or modify files within the client's environment.
   565→     *
   566→     * See protocol docs: [Client](https://agentclientprotocol.com/protocol/overview#client)
   567→     */
   568→    writeTextFile?(params: schema.WriteTextFileRequest): Promise<schema.WriteTextFileResponse>;
   569→    /**
   570→     * Reads content from a text file in the client's file system.
   571→     *
   572→     * Only available if the client advertises the `fs.readTextFile` capability.
   573→     * Allows the agent to access file contents within the client's environment.
   574→     *
   575→     * See protocol docs: [Client](https://agentclientprotocol.com/protocol/overview#client)
   576→     */
   577→    readTextFile?(params: schema.ReadTextFileRequest): Promise<schema.ReadTextFileResponse>;
   578→    /**
   579→     * Creates a new terminal to execute a command.
   580→     *
   581→     * Only available if the `terminal` capability is set to `true`.
   582→     *
   583→     * The Agent must call `releaseTerminal` when done with the terminal
   584→     * to free resources.
   585→  
   586→     * @see {@link https://agentclientprotocol.com/protocol/terminals | Terminal Documentation}
   587→     */
   588→    createTerminal?(params: schema.CreateTerminalRequest): Promise<schema.CreateTerminalResponse>;
   589→    /**
   590→     * Gets the current output and exit status of a terminal.
   591→     *
   592→     * Returns immediately without waiting for the command to complete.
   593→     * If the command has already exited, the exit status is included.
   594→     *
   595→     * @see {@link https://agentclientprotocol.com/protocol/terminals#getting-output | Getting Terminal Output}
   596→     */
   597→    terminalOutput?(params: schema.TerminalOutputRequest): Promise<schema.TerminalOutputResponse>;
   598→    /**
   599→     * Releases a terminal and frees all associated resources.
   600→     *
   601→     * The command is killed if it hasn't exited yet. After release,
   602→     * the terminal ID becomes invalid for all other terminal methods.
   603→     *
   604→     * Tool calls that already contain the terminal ID continue to
   605→     * display its output.
   606→     *
   607→     * @see {@link https://agentclientprotocol.com/protocol/terminals#releasing-terminals | Releasing Terminals}
   608→     */
   609→    releaseTerminal?(params: schema.ReleaseTerminalRequest): Promise<schema.ReleaseTerminalResponse | void>;
   610→    /**
   611→     * Waits for a terminal command to exit and returns its exit status.
   612→     *
   613→     * This method returns once the command completes, providing the
   614→     * exit code and/or signal that terminated the process.
   615→     *
   616→     * @see {@link https://agentclientprotocol.com/protocol/terminals#waiting-for-exit | Waiting for Exit}
   617→     */
   618→    waitForTerminalExit?(params: schema.WaitForTerminalExitRequest): Promise<schema.WaitForTerminalExitResponse>;
   619→    /**
   620→     * Kills a terminal command without releasing the terminal.
   621→     *
   622→     * While `releaseTerminal` also kills the command, this method keeps
   623→     * the terminal ID valid so it can be used with other methods.
   624→     *
   625→     * Useful for implementing command timeouts that terminate the command
   626→     * and then retrieve the final output.
   627→     *
   628→     * Note: Call `releaseTerminal` when the terminal is no longer needed.
   629→     *
   630→     * @see {@link https://agentclientprotocol.com/protocol/terminals#killing-commands | Killing Commands}
   631→     */
   632→    killTerminal?(params: schema.KillTerminalCommandRequest): Promise<schema.KillTerminalCommandResponse | void>;
   633→    /**
   634→     * Extension method
   635→     *
   636→     * Allows the Agent to send an arbitrary request that is not part of the ACP spec.
   637→     *
   638→     * To help avoid conflicts, it's a good practice to prefix extension
   639→     * methods with a unique identifier such as domain name.
   640→     */
   641→    extMethod?(method: string, params: Record<string, unknown>): Promise<Record<string, unknown>>;
   642→    /**
   643→     * Extension notification
   644→     *
   645→     * Allows the Agent to send an arbitrary notification that is not part of the ACP spec.
   646→     */
   647→    extNotification?(method: string, params: Record<string, unknown>): Promise<void>;
   648→}
   649→/**
   650→ * The Agent interface defines the interface that all ACP-compliant agents must implement.
   651→ *
   652→ * Agents are programs that use generative AI to autonomously modify code. They handle
   653→ * requests from clients and execute tasks using language models and tools.
   654→ */
   655→export interface Agent {
   656→    /**
   657→     * Establishes the connection with a client and negotiates protocol capabilities.
   658→     *
   659→     * This method is called once at the beginning of the connection to:
   660→     * - Negotiate the protocol version to use
   661→     * - Exchange capability information between client and agent
   662→     * - Determine available authentication methods
   663→     *
   664→     * The agent should respond with its supported protocol version and capabilities.
   665→     *
   666→     * See protocol docs: [Initialization](https://agentclientprotocol.com/protocol/initialization)
   667→     */
   668→    initialize(params: schema.InitializeRequest): Promise<schema.InitializeResponse>;
   669→    /**
   670→     * Creates a new conversation session with the agent.
   671→     *
   672→     * Sessions represent independent conversation contexts with their own history and state.
   673→     *
   674→     * The agent should:
   675→     * - Create a new session context
   676→     * - Connect to any specified MCP servers
   677→     * - Return a unique session ID for future requests
   678→     *
   679→     * May return an `auth_required` error if the agent requires authentication.
   680→     *
   681→     * See protocol docs: [Session Setup](https://agentclientprotocol.com/protocol/session-setup)
   682→     */
   683→    newSession(params: schema.NewSessionRequest): Promise<schema.NewSessionResponse>;
   684→    /**
   685→     * Loads an existing session to resume a previous conversation.
   686→     *
   687→     * This method is only available if the agent advertises the `loadSession` capability.
   688→     *
   689→     * The agent should:
   690→     * - Restore the session context and conversation history
   691→     * - Connect to the specified MCP servers
   692→     * - Stream the entire conversation history back to the client via notifications
   693→     *
   694→     * See protocol docs: [Loading Sessions](https://agentclientprotocol.com/protocol/session-setup#loading-sessions)
   695→     */
   696→    loadSession?(params: schema.LoadSessionRequest): Promise<schema.LoadSessionResponse>;
   697→    /**
   698→     * **UNSTABLE**
   699→     *
   700→     * This capability is not part of the spec yet, and may be removed or changed at any point.
   701→     *
   702→     * Forks an existing session to create a new independent session.
   703→     *
   704→     * Creates a new session based on the context of an existing one, allowing
   705→     * operations like generating summaries without affecting the original session's history.
   706→     *
   707→     * This method is only available if the agent advertises the `session.fork` capability.
   708→     *
   709→     * @experimental
   710→     */
   711→    unstable_forkSession?(params: schema.ForkSessionRequest): Promise<schema.ForkSessionResponse>;
   712→    /**
   713→     * **UNSTABLE**
   714→     *
   715→     * This capability is not part of the spec yet, and may be removed or changed at any point.
   716→     *
   717→     * Lists existing sessions from the agent.
   718→     *
   719→     * This method is only available if the agent advertises the `listSessions` capability.
   720→     *
   721→     * Returns a list of sessions with metadata like session ID, working directory,
   722→     * title, and last update time. Supports filtering by working directory and
   723→     * cursor-based pagination.
   724→     */
   725→    unstable_listSessions?(params: schema.ListSessionsRequest): Promise<schema.ListSessionsResponse>;
   726→    /**
   727→     * **UNSTABLE**
   728→     *
   729→     * This capability is not part of the spec yet, and may be removed or changed at any point.
   730→     *
   731→     * Resumes an existing session without returning previous messages.
   732→     *
   733→     * This method is only available if the agent advertises the `session.resume` capability.
   734→     *
   735→     * The agent should resume the session context, allowing the conversation to continue
   736→     * without replaying the message history (unlike `session/load`).
   737→     *
   738→     * @experimental
   739→     */
   740→    unstable_resumeSession?(params: schema.ResumeSessionRequest): Promise<schema.ResumeSessionResponse>;
   741→    /**
   742→     * Sets the operational mode for a session.
   743→     *
   744→     * Allows switching between different agent modes (e.g., "ask", "architect", "code")
   745→     * that affect system prompts, tool availability, and permission behaviors.
   746→     *
   747→     * The mode must be one of the modes advertised in `availableModes` during session
   748→     * creation or loading. Agents may also change modes autonomously and notify the
   749→     * client via `current_mode_update` notifications.
   750→     *
   751→     * This method can be called at any time during a session, whether the Agent is
   752→     * idle or actively generating a turn.
   753→     *
   754→     * See protocol docs: [Session Modes](https://agentclientprotocol.com/protocol/session-modes)
   755→     */
   756→    setSessionMode?(params: schema.SetSessionModeRequest): Promise<schema.SetSessionModeResponse | void>;
   757→    /**
   758→     * **UNSTABLE**
   759→     *
   760→     * This capability is not part of the spec yet, and may be removed or changed at any point.
   761→     *
   762→     * Select a model for a given session.
   763→     *
   764→     * @experimental
   765→     */
   766→    unstable_setSessionModel?(params: schema.SetSessionModelRequest): Promise<schema.SetSessionModelResponse | void>;
   767→    /**
   768→     * **UNSTABLE**
   769→     *
   770→     * This capability is not part of the spec yet, and may be removed or changed at any point.
   771→     *
   772→     * Set a configuration option for a given session.
   773→     *
   774→     * The response contains the full set of configuration options and their current values,
   775→     * as changing one option may affect the available values or state of other options.
   776→     *
   777→     * @experimental
   778→     */
   779→    unstable_setSessionConfigOption?(params: schema.SetSessionConfigOptionRequest): Promise<schema.SetSessionConfigOptionResponse>;
   780→    /**
   781→     * Authenticates the client using the specified authentication method.
   782→     *
   783→     * Called when the agent requires authentication before allowing session creation.
   784→     * The client provides the authentication method ID that was advertised during initialization.
   785→     *
   786→     * After successful authentication, the client can proceed to create sessions with
   787→     * `newSession` without receiving an `auth_required` error.
   788→     *
   789→     * See protocol docs: [Initialization](https://agentclientprotocol.com/protocol/initialization)
   790→     */
   791→    authenticate(params: schema.AuthenticateRequest): Promise<schema.AuthenticateResponse | void>;
   792→    /**
   793→     * Processes a user prompt within a session.
   794→     *
   795→     * This method handles the whole lifecycle of a prompt:
   796→     * - Receives user messages with optional context (files, images, etc.)
   797→     * - Processes the prompt using language models
   798→     * - Reports language model content and tool calls to the Clients
   799→     * - Requests permission to run tools
   800→     * - Executes any requested tool calls
   801→     * - Returns when the turn is complete with a stop reason
   802→     *
   803→     * See protocol docs: [Prompt Turn](https://agentclientprotocol.com/protocol/prompt-turn)
   804→     */
   805→    prompt(params: schema.PromptRequest): Promise<schema.PromptResponse>;
   806→    /**
   807→     * Cancels ongoing operations for a session.
   808→     *
   809→     * This is a notification sent by the client to cancel an ongoing prompt turn.
   810→     *
   811→     * Upon receiving this notification, the Agent SHOULD:
   812→     * - Stop all language model requests as soon as possible
   813→     * - Abort all tool call invocations in progress
   814→     * - Send any pending `session/update` notifications
   815→     * - Respond to the original `session/prompt` request with `StopReason::Cancelled`
   816→     *
   817→     * See protocol docs: [Cancellation](https://agentclientprotocol.com/protocol/prompt-turn#cancellation)
   818→     */
   819→    cancel(params: schema.CancelNotification): Promise<void>;
   820→    /**
   821→     * Extension method
   822→     *
   823→     * Allows the Client to send an arbitrary request that is not part of the ACP spec.
   824→     *
   825→     * To help avoid conflicts, it's a good practice to prefix extension
   826→     * methods with a unique identifier such as domain name.
   827→     */
   828→    extMethod?(method: string, params: Record<string, unknown>): Promise<Record<string, unknown>>;
   829→    /**
   830→     * Extension notification
   831→     *
   832→     * Allows the Client to send an arbitrary notification that is not part of the ACP spec.
   833→     */
   834→    extNotification?(method: string, params: Record<string, unknown>): Promise<void>;
   835→}
   836→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
```