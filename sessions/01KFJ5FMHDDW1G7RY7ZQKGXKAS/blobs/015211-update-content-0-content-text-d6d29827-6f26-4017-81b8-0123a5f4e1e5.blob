   474→     * await connection.closed;
   475→     * console.log('Connection closed - performing cleanup');
   476→     * ```
   477→     */
   478→    get closed(): Promise<void>;
   479→    sendRequest<Req, Resp>(method: string, params?: Req): Promise<Resp>;
