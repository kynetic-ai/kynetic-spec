  1216→
  1217→    const nextResult = kspec(`workflow next @${run_id} --json`, tempDir);
  1218→    expect(nextResult.exitCode).toBe(0);
  1219→
  1220→    const output = JSON.parse(nextResult.stdout);
  1221→    expect(output).toHaveProperty('run_id');
  1222→    expect(output).toHaveProperty('current_step');
  1223→    expect(output).toHaveProperty('total_steps');
  1224→    expect(output).toHaveProperty('next_step');
  1225→  });
  1226→
  1227→  it('should return errors as JSON in JSON mode', async () => {
  1228→    const result = kspec(`workflow next @nonexistent --json`, tempDir, { expectFail: true });
  1229→
  1230→    expect(result.exitCode).toBe(3); // NOT_FOUND
  1231→    // Error output is on stderr, not stdout in JSON mode
  1232→    expect(result.stderr).toContain('Workflow run not found');
  1233→  });
  1234→});
