   789→    expect(result.exitCode).toBe(4);
   790→    expect(result.stderr).toContain('Cannot advance workflow run');
   791→    expect(result.stderr).toContain('completed'); // Current state
   792→    expect(result.stderr).toContain('active'); // Expected state
   793→  });
   794→});
