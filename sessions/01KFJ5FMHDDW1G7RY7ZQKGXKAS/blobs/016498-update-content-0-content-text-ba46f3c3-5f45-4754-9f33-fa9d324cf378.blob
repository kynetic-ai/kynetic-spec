     7→
     8→import { describe, it, expect } from 'vitest';
     9→import { grepItem, formatMatchedFields, type GrepMatch } from '../src/utils/grep.js';
    10→import { ItemIndex, type ItemFilter } from '../src/parser/items.js';
    11→import type { LoadedSpecItem, LoadedTask } from '../src/parser/yaml.js';
    12→
    13→// Test fixtures
    14→const createSpecItem = (overrides: Partial<LoadedSpecItem> = {}): LoadedSpecItem => ({
    15→  _ulid: '01TEST00000000000000000000',
    16→  _sourceFile: 'test.yaml',
    17→  _sourcePath: [],
    18→  title: 'Test Item',
    19→  type: 'feature',
    20→  slugs: ['test-item'],
    21→  description: '',
    22→  status: { maturity: 'draft', implementation: 'not_started' },
    23→  depends_on: [],
    24→  implements: [],
    25→  relates_to: [],
    26→  tests: [],
    27→  tags: [],
    28→  ...overrides,
    29→});
    30→
    31→const createTask = (overrides: Partial<LoadedTask> = {}): LoadedTask => ({
    32→  _ulid: '01TASK00000000000000000000',
    33→  _sourceFile: 'test.tasks.yaml',
    34→  _sourcePath: [],
    35→  title: 'Test Task',
    36→  type: 'task',
    37→  slugs: ['test-task'],
    38→  status: 'pending',
    39→  priority: 3,
    40→  tags: [],
    41→  depends_on: [],
    42→  blocked_by: [],
    43→  notes: [],
    44→  todos: [],
    45→  created_at: '2026-01-01T00:00:00Z',
    46→  ...overrides,
    47→});
    48→
    49→describe('grepItem', () => {
    50→  // AC: @fuzzy-item-search ac-1
    51→  // Given: A user runs kspec search "TODO"
    52→  // When: The search runs across all loaded items and tasks
    53→  // Then: Returns items/tasks where any text field matches
    54→  describe('AC-1: Basic text search', () => {
    55→    it('should find matches in title', () => {
    56→      const item = createSpecItem({ title: 'TODO: Implement feature' });
    57→      const match = grepItem(item as Record<string, unknown>, 'TODO');
    58→
    59→      expect(match).not.toBeNull();
    60→      expect(match!.matchedFields).toContain('title');
    61→    });
    62→
    63→    it('should find matches in description', () => {
    64→      const item = createSpecItem({ description: 'This needs a TODO fix' });
    65→      const match = grepItem(item as Record<string, unknown>, 'TODO');
    66→
    67→      expect(match).not.toBeNull();
    68→      expect(match!.matchedFields).toContain('description');
    69→    });
    70→
    71→    it('should return null when no match', () => {
    72→      const item = createSpecItem({ title: 'Regular item', description: 'No matches here' });
    73→      const match = grepItem(item as Record<string, unknown>, 'TODO');
    74→
    75→      expect(match).toBeNull();
    76→    });
    77→
    78→    it('should search task notes', () => {
    79→      const task = createTask({
    80→        notes: [
    81→          { _ulid: '01NOTE0000000000000000000', content: 'Found a TODO in the code', author: '@claude', created_at: '2026-01-01T00:00:00Z', supersedes: null },
    82→        ],
    83→      });
    84→      const match = grepItem(task as unknown as Record<string, unknown>, 'TODO');
    85→
    86→      expect(match).not.toBeNull();
    87→      expect(match!.matchedFields).toContain('notes[0].content');
    88→    });
    89→  });
    90→
    91→  // AC: @fuzzy-item-search ac-2
    92→  // Given: A user searches with a regex pattern like "shadow.*branch"
    93→  // When: The pattern is applied to content
    94→  // Then: Matches using JavaScript regex semantics, case-insensitive by default
    95→  describe('AC-2: Regex patterns and case sensitivity', () => {
    96→    it('should support regex patterns', () => {
    97→      const item = createSpecItem({ description: 'Works with shadow branch storage' });
    98→      const match = grepItem(item as Record<string, unknown>, 'shadow.*branch');
    99→
   100→      expect(match).not.toBeNull();
   101→      expect(match!.matchedFields).toContain('description');
   102→    });
   103→
   104→    it('should be case-insensitive by default', () => {
   105→      const item = createSpecItem({ title: 'SHADOW Branch Setup' });
   106→      const match = grepItem(item as Record<string, unknown>, 'shadow');
   107→
   108→      expect(match).not.toBeNull();
   109→      expect(match!.matchedFields).toContain('title');
   110→    });
   111→
   112→    it('should support case-sensitive search when specified', () => {
   113→      const item = createSpecItem({ title: 'shadow branch' });
   114→
   115→      // Case insensitive (default)
   116→      const matchInsensitive = grepItem(item as Record<string, unknown>, 'SHADOW', true);
   117→      expect(matchInsensitive).not.toBeNull();
   118→
   119→      // Case sensitive
   120→      const matchSensitive = grepItem(item as Record<string, unknown>, 'SHADOW', false);
   121→      expect(matchSensitive).toBeNull();
   122→    });
   123→
   124→    it('should handle invalid regex gracefully (treat as literal)', () => {
   125→      const item = createSpecItem({ description: 'Pattern with [invalid regex' });
   126→      const match = grepItem(item as Record<string, unknown>, '[invalid regex');
   127→
   128→      expect(match).not.toBeNull();
   129→      expect(match!.matchedFields).toContain('description');
   130→    });
   131→  });
   132→
   133→  // AC: @fuzzy-item-search ac-3
   134→  // Given: An item matches in multiple fields
   135→  // When: Results are displayed
   136→  // Then: Shows which field(s) matched
   137→  describe('AC-3: Multiple field matches', () => {
   138→    it('should report all matching fields', () => {
   139→      const item = createSpecItem({
   140→        title: 'Authentication Feature',
   141→        description: 'Handles authentication flow',
   142→        tags: ['authentication', 'security'],
   143→      });
   144→      const match = grepItem(item as Record<string, unknown>, 'authentication');
   145→
   146→      expect(match).not.toBeNull();
   147→      expect(match!.matchedFields).toContain('title');
   148→      expect(match!.matchedFields).toContain('description');
   149→      expect(match!.matchedFields).toContain('tags[0]');
   150→    });
   151→
   152→    it('should match multiple array items', () => {
   153→      const task = createTask({
   154→        notes: [
   155→          { _ulid: '01NOTE0000000000000000001', content: 'First TODO note', author: '@claude', created_at: '2026-01-01T00:00:00Z', supersedes: null },
   156→          { _ulid: '01NOTE0000000000000000002', content: 'Regular note', author: '@claude', created_at: '2026-01-01T00:00:00Z', supersedes: null },
   157→          { _ulid: '01NOTE0000000000000000003', content: 'Another TODO note', author: '@claude', created_at: '2026-01-01T00:00:00Z', supersedes: null },
   158→        ],
   159→      });
   160→      const match = grepItem(task as unknown as Record<string, unknown>, 'TODO');
   161→
   162→      expect(match).not.toBeNull();
   163→      expect(match!.matchedFields).toContain('notes[0].content');
   164→      expect(match!.matchedFields).not.toContain('notes[1].content');
   165→      expect(match!.matchedFields).toContain('notes[2].content');
   166→    });
   167→  });
   168→
   169→  // AC: @fuzzy-item-search ac-4
   170→  // Given: A match is found in nested content like notes or AC
   171→  // When: Results are displayed
   172→  // Then: The full item is returned with match location indicator
   173→  describe('AC-4: Nested content matching', () => {
   174→    it('should match in acceptance criteria', () => {
   175→      const item = createSpecItem({
   176→        acceptance_criteria: [
   177→          { id: 'ac-1', given: 'A user inputs data', when: 'Validation runs', then: 'Errors are shown' },
   178→          { id: 'ac-2', given: 'Authentication is required', when: 'User submits', then: 'Check credentials' },
   179→        ],
   180→      });
