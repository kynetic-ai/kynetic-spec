   182→
   183→      expect(match).not.toBeNull();
   184→      expect(match!.matchedFields).toContain('acceptance_criteria[1].given');
   185→    });
   186→
   187→    it('should match in deeply nested structures', () => {
   188→      const task = createTask({
   189→        notes: [
   190→          {
   191→            _ulid: '01NOTE0000000000000000001',
   192→            content: 'Check the shadow branch for details',
   193→            author: '@claude',
   194→            created_at: '2026-01-01T00:00:00Z',
   195→            supersedes: null,
   196→          },
   197→        ],
   198→      });
   199→      const match = grepItem(task as unknown as Record<string, unknown>, 'shadow.*branch');
