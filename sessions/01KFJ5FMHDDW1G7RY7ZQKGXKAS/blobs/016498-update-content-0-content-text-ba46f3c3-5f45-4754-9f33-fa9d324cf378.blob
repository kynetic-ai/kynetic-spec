   241→describe('ItemIndex grep integration', () => {
   242→  // AC: @fuzzy-item-search ac-5
   243→  // Given: User combines search with filters like --type task or --status pending
   244→  // When: Search runs
   245→  // Then: Filters are applied first, then content search within the filtered set
   246→  describe('AC-5: Filter combination', () => {
   247→    const items: LoadedSpecItem[] = [
   248→      createSpecItem({ _ulid: '01ITEM0000000000000000001', title: 'Auth Feature', type: 'feature', description: 'Authentication system' }),
   249→      createSpecItem({ _ulid: '01ITEM0000000000000000002', title: 'Auth Requirement', type: 'requirement', description: 'Authentication must be secure' }),
   250→      createSpecItem({ _ulid: '01ITEM0000000000000000003', title: 'Other Feature', type: 'feature', description: 'Different system' }),
   251→    ];
   252→
   253→    const tasks: LoadedTask[] = [
   254→      createTask({ _ulid: '01TASK0000000000000000001', title: 'Implement Auth', status: 'pending', description: 'Add authentication' }),
   255→      createTask({ _ulid: '01TASK0000000000000000002', title: 'Test Auth', status: 'completed', description: 'Test authentication flow' }),
   256→    ];
   257→
   258→    it('should apply type filter before grep', () => {
   259→      const index = new ItemIndex(tasks, items);
   260→      const filter: ItemFilter = {
   261→        type: 'feature',
   262→        grepSearch: 'auth',
   263→        specItemsOnly: true,
   264→      };
   265→
   266→      const results = index.query(filter);
   267→
   268→      expect(results.length).toBe(1);
   269→      expect(results[0].title).toBe('Auth Feature');
   270→    });
   271→
   272→    it('should apply status filter before grep for tasks', () => {
   273→      const index = new ItemIndex(tasks, items);
   274→      const filter: ItemFilter = {
   275→        status: 'pending',
   276→        grepSearch: 'auth',
   277→        tasksOnly: true,
   278→      };
   279→
   280→      const results = index.query(filter);
   281→
   282→      expect(results.length).toBe(1);
   283→      expect(results[0].title).toBe('Implement Auth');
   284→    });
   285→
   286→    it('should combine tag and grep filters', () => {
   287→      const taggedItems = [
   288→        createSpecItem({ _ulid: '01ITEM0000000000000000010', title: 'API Auth', tags: ['api', 'security'], description: 'API authentication' }),
   289→        createSpecItem({ _ulid: '01ITEM0000000000000000011', title: 'UI Component', tags: ['ui'], description: 'Authentication UI' }),
   290→        createSpecItem({ _ulid: '01ITEM0000000000000000012', title: 'API Logging', tags: ['api'], description: 'Log API calls' }),
   291→      ];
   292→
   293→      const index = new ItemIndex([], taggedItems);
   294→      const filter: ItemFilter = {
   295→        tags: ['api'],
   296→        grepSearch: 'auth',
   297→        specItemsOnly: true,
   298→      };
   299→
   300→      const results = index.query(filter);
   301→
   302→      expect(results.length).toBe(1);
   303→      expect(results[0].title).toBe('API Auth');
   304→    });
   305→  });
   306→
   307→  // AC: @fuzzy-item-search ac-6
   308→  // Given: Search finds no matches
   309→  // When: Results are displayed
   310→  // Then: Shows empty result with helpful message, not an error
   311→  describe('AC-6: Empty results handling', () => {
   312→    it('should return empty array when no matches', () => {
   313→      const items = [
   314→        createSpecItem({ title: 'Item One', description: 'First item' }),
   315→        createSpecItem({ title: 'Item Two', description: 'Second item' }),
   316→      ];
   317→
   318→      const index = new ItemIndex([], items);
   319→      const filter: ItemFilter = {
   320→        grepSearch: 'nonexistent',
   321→        specItemsOnly: true,
   322→      };
   323→
   324→      const results = index.query(filter);
   325→
   326→      expect(results).toEqual([]);
   327→      expect(Array.isArray(results)).toBe(true);
   328→    });
   329→
   330→    it('should return empty array when filters exclude all items', () => {
   331→      const items = [
   332→        createSpecItem({ title: 'Feature', type: 'feature', description: 'Has keyword' }),
   333→      ];
   334→
   335→      const index = new ItemIndex([], items);
   336→      const filter: ItemFilter = {
   337→        type: 'requirement', // No requirements exist
   338→        grepSearch: 'keyword',
   339→        specItemsOnly: true,
   340→      };
   341→
   342→      const results = index.query(filter);
   343→
   344→      expect(results).toEqual([]);
   345→    });
   346→  });
   347→});
   348→
   349→describe('grep edge cases', () => {
   350→  it('should handle empty strings', () => {
   351→    const item = createSpecItem({ title: 'Test', description: '' });
   352→    const match = grepItem(item as Record<string, unknown>, 'test');
   353→
   354→    expect(match).not.toBeNull();
   355→    expect(match!.matchedFields).toContain('title');
   356→    expect(match!.matchedFields).not.toContain('description');
   357→  });
   358→
   359→  it('should handle null and undefined fields', () => {
   360→    const item = createSpecItem({ title: 'Regular Item', description: undefined });
   361→    const match = grepItem(item as Record<string, unknown>, 'nonexistent');
   362→
   363→    // Should not throw
   364→    expect(match).toBeNull();
   365→  });
   366→
   367→  it('should handle special regex characters in search', () => {
   368→    const item = createSpecItem({ description: 'Use [brackets] and (parens)' });
   369→
   370→    // Literal brackets should be escaped automatically
   371→    const match = grepItem(item as Record<string, unknown>, '[brackets]');
   372→    expect(match).not.toBeNull();
   373→  });
   374→
   375→  it('should handle very long text content', () => {
   376→    const longText = 'word '.repeat(10000) + 'needle ' + 'word '.repeat(10000);
   377→    const item = createSpecItem({ description: longText });
   378→    const match = grepItem(item as Record<string, unknown>, 'needle');
   379→
   380→    expect(match).not.toBeNull();
   381→    expect(match!.matchedFields).toContain('description');
   382→  });
   383→});
