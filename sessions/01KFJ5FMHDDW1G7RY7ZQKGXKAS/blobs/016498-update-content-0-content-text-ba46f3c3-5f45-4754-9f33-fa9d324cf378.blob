   201→      expect(match).not.toBeNull();
   202→      expect(match!.matchedFields).toContain('notes[0].content');
   203→    });
   204→
   205→    it('should not include internal fields (starting with _)', () => {
   206→      const item = createSpecItem({
   207→        _sourceFile: 'path/with/shadow/in/it.yaml',
   208→        description: 'Regular description',
   209→      });
