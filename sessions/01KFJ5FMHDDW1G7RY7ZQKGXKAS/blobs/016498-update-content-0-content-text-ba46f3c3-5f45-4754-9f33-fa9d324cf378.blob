   215→  });
   216→});
   217→
   218→describe('formatMatchedFields', () => {
   219→  it('should format single field', () => {
   220→    expect(formatMatchedFields(['description'])).toBe('description');
   221→  });
   222→
   223→  it('should format multiple fields', () => {
   224→    const result = formatMatchedFields(['title', 'description', 'notes[0].content']);
   225→    expect(result).toContain('title');
   226→    expect(result).toContain('description');
   227→    expect(result).toContain('notes[0]');
   228→  });
   229→
   230→  it('should abbreviate acceptance_criteria to ac', () => {
   231→    const result = formatMatchedFields(['acceptance_criteria[0].given']);
   232→    expect(result).toBe('ac[0].given');
   233→  });
   234→
   235→  it('should remove .content suffix from notes', () => {
   236→    const result = formatMatchedFields(['notes[1].content']);
   237→    expect(result).toBe('notes[1]');
   238→  });
   239→});
