   260→// AC: @workflow-run-foundation ac-4
   261→describe('workflow show', () => {
   262→  let runId: string;
   263→
   264→  beforeEach(async () => {
   265→    // Create a run
   266→    const result = kspec('workflow start @test-workflow --task @test-task --json', tempDir);
   267→    const output = JSON.parse(result.stdout);
   268→    runId = output.run_id;
   269→  });
   270→
   271→  it('should display run details in human-readable format', async () => {
   272→    const result = kspec(`workflow show @${runId}`, tempDir);
   273→
   274→    expect(result.exitCode).toBe(0);
   275→    expect(result.stdout).toContain('Workflow Run Details');
   276→    expect(result.stdout).toContain('test-workflow');
   277→    expect(result.stdout).toContain('active');
   278→    expect(result.stdout).toContain('0/3');
   279→    expect(result.stdout).toContain('Initiated by: @test');
   280→    expect(result.stdout).toContain('Task: @01TESTTASK000000000000001');
   281→  });
   282→
   283→  it('should output run details in JSON format', async () => {
   284→    const result = kspec(`workflow show @${runId} --json`, tempDir);
   285→
   286→    expect(result.exitCode).toBe(0);
   287→    const output = JSON.parse(result.stdout);
   288→
   289→    expect(output.run._ulid).toBe(runId);
   290→    expect(output.run.workflow_ref).toBe('@01TEST0000000000000000001');
   291→    expect(output.run.status).toBe('active');
   292→    expect(output.run.current_step).toBe(0);
   293→    expect(output.run.total_steps).toBe(3);
   294→    expect(output.run.task_ref).toBe('@01TESTTASK000000000000001');
   295→  });
   296→
   297→  it('should work with ULID prefix', async () => {
