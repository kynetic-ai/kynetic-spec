   174→// AC: @workflow-run-foundation ac-2
   175→describe('workflow runs list', () => {
   176→  beforeEach(async () => {
   177→    // Create multiple runs in different states
   178→    kspec('workflow start @test-workflow --json', tempDir);
   179→    kspec('workflow start @another-workflow --json', tempDir);
   180→
   181→    // Abort one of them
   182→    const runsPath = path.join(tempDir, '.kspec', 'kynetic.runs.yaml');
   183→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   184→    const doc = parseDocument(runsContent);
   185→    const runsData = doc.toJS() as { runs: any[] };
   186→
   187→    // Manually complete one run for testing
   188→    runsData.runs[1].status = 'completed';
   189→    runsData.runs[1].completed_at = new Date().toISOString();
   190→
   191→    const doc2 = parseDocument(await fs.readFile(runsPath, 'utf-8'));
   192→    doc2.setIn(['runs', 1, 'status'], 'completed');
   193→    doc2.setIn(['runs', 1, 'completed_at'], runsData.runs[1].completed_at);
   194→    await fs.writeFile(runsPath, doc2.toString(), 'utf-8');
   195→  });
   196→
   197→  it('should list all runs with table output', async () => {
   198→    const result = kspec('workflow runs', tempDir);
   199→
   200→    expect(result.exitCode).toBe(0);
   201→    expect(result.stdout).toContain('test-workflow');
   202→    expect(result.stdout).toContain('another-workflow');
   203→    expect(result.stdout).toContain('active');
   204→    expect(result.stdout).toContain('completed');
   205→  });
   206→
   207→  it('should output JSON with --json flag', async () => {
   208→    const result = kspec('workflow runs --json', tempDir);
   209→
   210→    expect(result.exitCode).toBe(0);
   211→    const output = JSON.parse(result.stdout);
   212→
   213→    expect(output.runs).toHaveLength(2);
   214→    expect(output.runs[0].status).toBe('active');
   215→    expect(output.runs[1].status).toBe('completed');
   216→  });
   217→
   218→  it('should filter by --active flag', async () => {
   219→    const result = kspec('workflow runs --active --json', tempDir);
   220→
   221→    expect(result.exitCode).toBe(0);
   222→    const output = JSON.parse(result.stdout);
   223→
   224→    expect(output.runs).toHaveLength(1);
   225→    expect(output.runs[0].status).toBe('active');
   226→  });
   227→
   228→  it('should filter by --completed flag', async () => {
   229→    const result = kspec('workflow runs --completed --json', tempDir);
   230→
   231→    expect(result.exitCode).toBe(0);
   232→    const output = JSON.parse(result.stdout);
   233→
   234→    expect(output.runs).toHaveLength(1);
   235→    expect(output.runs[0].status).toBe('completed');
   236→  });
   237→
   238→  it('should filter by --workflow flag', async () => {
   239→    const result = kspec('workflow runs --workflow @test-workflow --json', tempDir);
   240→
   241→    expect(result.exitCode).toBe(0);
   242→    const output = JSON.parse(result.stdout);
   243→
   244→    expect(output.runs).toHaveLength(1);
   245→    expect(output.runs[0].workflow_ref).toBe('@01TEST0000000000000000001');
   246→  });
   247→
   248→  it('should show "No workflow runs found" when no runs exist', async () => {
   249→    // Delete runs file
   250→    const runsPath = path.join(tempDir, '.kspec', 'kynetic.runs.yaml');
   251→    await fs.unlink(runsPath);
   252→
   253→    const result = kspec('workflow runs', tempDir);
