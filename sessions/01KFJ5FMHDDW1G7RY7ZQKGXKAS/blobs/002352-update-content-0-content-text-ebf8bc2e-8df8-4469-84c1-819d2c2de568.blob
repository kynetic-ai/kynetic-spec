   141→// AC: @workflow-run-foundation ac-6
   142→describe('workflow start with task link', () => {
   143→  it('should link run to task when --task is provided', async () => {
   144→    const result = kspec('workflow start @test-workflow --task @test-task --json', tempDir);
   145→
   146→    expect(result.exitCode).toBe(0);
   147→    const output = JSON.parse(result.stdout);
   148→
   149→    // Verify output includes task reference
   150→    const runsPath = path.join(tempDir, '.kspec', 'kynetic.runs.yaml');
   151→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   152→    const doc = parseDocument(runsContent);
   153→    const runsData = doc.toJS() as { runs: any[] };
   154→
   155→    const run = runsData.runs[0];
   156→    expect(run.task_ref).toBe('@01TESTTASK000000000000001');
   157→  });
   158→
   159→  it('should display task link in human output', async () => {
