   369→// AC: @workflow-run-foundation ac-5
   370→describe('workflow abort validation', () => {
   371→  it('should error when aborting a completed run', async () => {
   372→    // Start and manually complete a run
   373→    const startResult = kspec('workflow start @test-workflow --json', tempDir);
   374→    const { run_id } = JSON.parse(startResult.stdout);
   375→
   376→    const runsPath = path.join(tempDir, '.kspec', 'kynetic.runs.yaml');
   377→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   378→    const doc = parseDocument(runsContent);
   379→    const runsData = doc.toJS() as { runs: any[] };
   380→
   381→    runsData.runs[0].status = 'completed';
   382→    runsData.runs[0].completed_at = new Date().toISOString();
   383→
   384→    const doc3 = parseDocument(await fs.readFile(runsPath, 'utf-8'));
   385→    doc3.setIn(['runs', 0, 'status'], 'completed');
   386→    doc3.setIn(['runs', 0, 'completed_at'], runsData.runs[0].completed_at);
   387→    await fs.writeFile(runsPath, doc3.toString(), 'utf-8');
   388→
   389→    // Try to abort
   390→    const result = kspec(`workflow abort @${run_id}`, tempDir, { expectFail: true });
   391→
   392→    expect(result.exitCode).toBe(4); // VALIDATION_FAILED
   393→    expect(result.stderr).toContain('Cannot abort workflow run: already completed');
   394→  });
   395→
   396→  it('should error when aborting an already aborted run', async () => {
   397→    // Start and abort a run
   398→    const startResult = kspec('workflow start @test-workflow --json', tempDir);
   399→    const { run_id } = JSON.parse(startResult.stdout);
   400→
   401→    kspec(`workflow abort @${run_id}`, tempDir);
   402→
   403→    // Try to abort again
   404→    const result = kspec(`workflow abort @${run_id}`, tempDir, { expectFail: true });
   405→
   406→    expect(result.exitCode).toBe(4); // VALIDATION_FAILED
   407→    expect(result.stderr).toContain('Cannot abort workflow run: already aborted');
   408→  });
   409→});
