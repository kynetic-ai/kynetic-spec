   313→// AC: @workflow-run-foundation ac-3
   314→describe('workflow abort', () => {
   315→  let runId: string;
   316→
   317→  beforeEach(async () => {
   318→    const result = kspec('workflow start @test-workflow --json', tempDir);
   319→    const output = JSON.parse(result.stdout);
   320→    runId = output.run_id;
   321→  });
   322→
   323→  it('should abort an active run', async () => {
   324→    const result = kspec(`workflow abort @${runId} --reason "Testing abort" --json`, tempDir);
   325→
   326→    expect(result.exitCode).toBe(0);
   327→    const output = JSON.parse(result.stdout);
   328→
   329→    expect(output.run_id).toBe(runId);
   330→    expect(output.status).toBe('aborted');
   331→
   332→    // Verify in file
   333→    const runsPath = path.join(tempDir, '.kspec', 'kynetic.runs.yaml');
   334→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   335→    const doc = parseDocument(runsContent);
   336→    const runsData = doc.toJS() as { runs: any[] };
   337→
   338→    const run = runsData.runs[0];
   339→    expect(run.status).toBe('aborted');
   340→    expect(run.abort_reason).toBe('Testing abort');
   341→    expect(run.completed_at).toBeDefined();
   342→  });
   343→
   344→  it('should display abort confirmation in human output', async () => {
   345→    const result = kspec(`workflow abort @${runId} --reason "Testing"`, tempDir);
   346→
   347→    expect(result.exitCode).toBe(0);
   348→    expect(result.stdout).toContain('Aborted workflow run:');
   349→    expect(result.stdout).toContain('Reason: Testing');
   350→  });
   351→
   352→  it('should allow aborting without a reason', async () => {
   353→    const result = kspec(`workflow abort @${runId} --json`, tempDir);
   354→
   355→    expect(result.exitCode).toBe(0);
   356→
   357→    // Verify in file
   358→    const runsPath = path.join(tempDir, '.kspec', 'kynetic.runs.yaml');
   359→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   360→    const doc = parseDocument(runsContent);
   361→    const runsData = doc.toJS() as { runs: any[] };
   362→
   363→    const run = runsData.runs[0];
   364→    expect(run.status).toBe('aborted');
   365→    expect(run.abort_reason).toBeUndefined();
   366→  });
   367→});
