     1→/**
     2→ * Tests for workflow run foundation
     3→ * Spec: @workflow-run-foundation
     4→ */
     5→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     6→import { kspec, createTempDir, cleanupTempDir, initGitRepo } from './helpers/cli.js';
     7→import * as fs from 'node:fs/promises';
     8→import * as path from 'node:path';
     9→import * as YAML from 'yaml';
    10→import { parseDocument } from 'yaml';
    11→
    12→let tempDir: string;
    13→
    14→beforeEach(async () => {
    15→  tempDir = await createTempDir();
    16→
    17→  // Initialize git repo (required for shadow operations)
    18→  initGitRepo(tempDir);
    19→
    20→  // Create .kspec directory structure
    21→  const kspecDir = path.join(tempDir, '.kspec');
    22→  await fs.mkdir(kspecDir, { recursive: true });
    23→
    24→  // Create minimal root manifest
    25→  await fs.writeFile(
    26→    path.join(kspecDir, 'kynetic.yaml'),
    27→    `kynetic: "1.0"
    28→project: Test Project
    29→`,
    30→    'utf-8',
    31→  );
    32→
    33→  // Create workflows in meta manifest
    34→  await fs.writeFile(
    35→    path.join(kspecDir, 'kynetic.meta.yaml'),
    36→    `kynetic_meta: "1.0"
    37→workflows:
    38→  - _ulid: 01TEST0000000000000000001
    39→    id: test-workflow
    40→    trigger: manual
    41→    description: Test workflow for run tests
    42→    steps:
    43→      - type: check
    44→        content: Verify prerequisites
    45→      - type: action
    46→        content: Execute main task
    47→      - type: check
    48→        content: Validate results
    49→
    50→  - _ulid: 01TEST0000000000000000002
    51→    id: another-workflow
    52→    trigger: manual
    53→    description: Another test workflow
    54→    steps:
    55→      - type: action
    56→        content: Do something
    57→
    58→agents:
    59→  - _ulid: 01KF79QXTTX8KBRYK14NWV1KYK
    60→    id: test
    61→    name: Test Author
    62→    description: Generic test author
    63→    capabilities: []
    64→    tools: []
    65→    conventions: []
    66→`,
    67→    'utf-8',
    68→  );
    69→
    70→  // Create a test task for task linking tests
    71→  await fs.writeFile(
    72→    path.join(kspecDir, 'project.tasks.yaml'),
    73→    `kynetic_tasks: "1.0"
    74→tasks:
    75→  - _ulid: 01TESTTASK000000000000001
    76→    slugs:
    77→      - test-task
    78→    title: Test Task
    79→    status: pending
    80→    priority: 3
    81→    created_at: "${new Date().toISOString()}"
    82→`,
    83→    'utf-8',
    84→  );
    85→});
    86→
    87→afterEach(async () => {
    88→  if (tempDir) {
    89→    await cleanupTempDir(tempDir);
    90→  }
    91→});
    92→
    93→// AC: @workflow-run-foundation ac-1
    94→describe('workflow start', () => {
    95→  it('should create a workflow run with correct initial state', async () => {
    96→    const result = kspec('workflow start @test-workflow --json', tempDir);
    97→
    98→    expect(result.exitCode).toBe(0);
    99→    const output = JSON.parse(result.stdout);
   100→
   101→    expect(output).toHaveProperty('run_id');
   102→    expect(output.workflow_ref).toBe('@01TEST0000000000000000001');
   103→    expect(output.status).toBe('active');
   104→
   105→    // Verify run was saved to file
   106→    const runsPath = path.join(tempDir, '.kspec', 'kynetic.runs.yaml');
   107→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   108→    const doc = parseDocument(runsContent);
   109→    const runsData = doc.toJS() as { runs: any[] };
   110→
   111→    expect(runsData.runs).toHaveLength(1);
   112→    const run = runsData.runs[0];
   113→
   114→    expect(run._ulid).toBe(output.run_id);
   115→    expect(run.workflow_ref).toBe('@01TEST0000000000000000001');
   116→    expect(run.status).toBe('active');
   117→    expect(run.current_step).toBe(0);
   118→    expect(run.total_steps).toBe(3);
   119→    expect(run.started_at).toBeDefined();
   120→    expect(run.step_results).toEqual([]);
   121→    expect(run.initiated_by).toBe('@test');
   122→  });
   123→
   124→  it('should display human-readable output without --json', async () => {
   125→    const result = kspec('workflow start @test-workflow', tempDir);
   126→
   127→    expect(result.exitCode).toBe(0);
   128→    expect(result.stdout).toContain('Started workflow run:');
   129→    expect(result.stdout).toContain('Workflow: test-workflow');
   130→    expect(result.stdout).toContain('Steps: 3');
   131→  });
   132→
   133→  it('should error if workflow does not exist', async () => {
   134→    const result = kspec('workflow start @nonexistent --json', tempDir, { expectFail: true });
   135→
   136→    expect(result.exitCode).toBe(3); // NOT_FOUND
   137→    expect(result.stderr).toContain('Workflow not found');
   138→  });
   139→});
