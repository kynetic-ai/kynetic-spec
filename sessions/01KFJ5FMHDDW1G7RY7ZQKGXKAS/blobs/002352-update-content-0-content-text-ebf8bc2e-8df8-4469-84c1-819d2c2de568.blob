   162→    expect(result.exitCode).toBe(0);
   163→    expect(result.stdout).toContain('Linked task: @01TESTTASK000000000000001');
   164→  });
   165→
   166→  it('should error if task does not exist', async () => {
   167→    const result = kspec('workflow start @test-workflow --task @nonexistent', tempDir, { expectFail: true });
