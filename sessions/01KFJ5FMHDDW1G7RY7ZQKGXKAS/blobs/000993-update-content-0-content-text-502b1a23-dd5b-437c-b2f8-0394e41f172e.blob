   362→// AC: @workflow-run-foundation ac-5
   363→describe('workflow abort validation', () => {
   364→  it('should error when aborting a completed run', async () => {
   365→    // Start and manually complete a run
   366→    const startResult = kspec('workflow start @test-workflow --json', tempDir);
   367→    const { run_id } = JSON.parse(startResult.stdout);
   368→
   369→    const runsPath = path.join(tempDir, '.kspec', 'kynetic.runs.yaml');
   370→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   371→    const doc = parseDocument(runsContent);
   372→    const runsData = doc.toJS() as { runs: any[] };
   373→
   374→    runsData.runs[0].status = 'completed';
   375→    runsData.runs[0].completed_at = new Date().toISOString();
   376→
   377→    await fs.writeFile(runsPath, JSON.stringify(runsData, null, 2), 'utf-8');
   378→
   379→    // Try to abort
   380→    const result = kspec(`workflow abort @${run_id}`, tempDir, { expectFail: true });
   381→
   382→    expect(result.exitCode).toBe(4); // VALIDATION_FAILED
   383→    expect(result.stderr).toContain('Cannot abort workflow run: already completed');
   384→  });
   385→
   386→  it('should error when aborting an already aborted run', async () => {
   387→    // Start and abort a run
   388→    const startResult = kspec('workflow start @test-workflow --json', tempDir);
   389→    const { run_id } = JSON.parse(startResult.stdout);
   390→
   391→    kspec(`workflow abort @${run_id}`, tempDir);
   392→
   393→    // Try to abort again
   394→    const result = kspec(`workflow abort @${run_id}`, tempDir, { expectFail: true });
   395→
   396→    expect(result.exitCode).toBe(4); // VALIDATION_FAILED
   397→    expect(result.stderr).toContain('Cannot abort workflow run: already aborted');
   398→  });
   399→});
