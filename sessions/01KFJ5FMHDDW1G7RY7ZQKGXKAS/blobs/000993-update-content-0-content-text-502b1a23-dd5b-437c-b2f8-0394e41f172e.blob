   170→// AC: @workflow-run-foundation ac-2
   171→describe('workflow runs list', () => {
   172→  beforeEach(async () => {
   173→    // Create multiple runs in different states
   174→    kspec('workflow start @test-workflow --json', tempDir);
   175→    kspec('workflow start @another-workflow --json', tempDir);
   176→
   177→    // Abort one of them
   178→    const runsPath = path.join(tempDir, '.kspec', 'kynetic.runs.yaml');
   179→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   180→    const doc = parseDocument(runsContent);
   181→    const runsData = doc.toJS() as { runs: any[] };
   182→
   183→    // Manually complete one run for testing
   184→    runsData.runs[1].status = 'completed';
   185→    runsData.runs[1].completed_at = new Date().toISOString();
   186→
   187→    await fs.writeFile(runsPath, JSON.stringify(runsData, null, 2), 'utf-8');
   188→  });
   189→
   190→  it('should list all runs with table output', async () => {
   191→    const result = kspec('workflow runs', tempDir);
   192→
   193→    expect(result.exitCode).toBe(0);
   194→    expect(result.stdout).toContain('test-workflow');
   195→    expect(result.stdout).toContain('another-workflow');
   196→    expect(result.stdout).toContain('active');
   197→    expect(result.stdout).toContain('completed');
   198→  });
   199→
   200→  it('should output JSON with --json flag', async () => {
   201→    const result = kspec('workflow runs --json', tempDir);
   202→
   203→    expect(result.exitCode).toBe(0);
   204→    const output = JSON.parse(result.stdout);
   205→
   206→    expect(output.runs).toHaveLength(2);
   207→    expect(output.runs[0].status).toBe('active');
   208→    expect(output.runs[1].status).toBe('completed');
   209→  });
   210→
   211→  it('should filter by --active flag', async () => {
   212→    const result = kspec('workflow runs --active --json', tempDir);
   213→
   214→    expect(result.exitCode).toBe(0);
   215→    const output = JSON.parse(result.stdout);
   216→
   217→    expect(output.runs).toHaveLength(1);
   218→    expect(output.runs[0].status).toBe('active');
   219→  });
   220→
   221→  it('should filter by --completed flag', async () => {
   222→    const result = kspec('workflow runs --completed --json', tempDir);
   223→
   224→    expect(result.exitCode).toBe(0);
   225→    const output = JSON.parse(result.stdout);
   226→
   227→    expect(output.runs).toHaveLength(1);
   228→    expect(output.runs[0].status).toBe('completed');
   229→  });
   230→
   231→  it('should filter by --workflow flag', async () => {
   232→    const result = kspec('workflow runs --workflow @test-workflow --json', tempDir);
   233→
   234→    expect(result.exitCode).toBe(0);
   235→    const output = JSON.parse(result.stdout);
   236→
   237→    expect(output.runs).toHaveLength(1);
   238→    expect(output.runs[0].workflow_ref).toBe('@01TEST0000000000000000001');
   239→  });
   240→
   241→  it('should show "No workflow runs found" when no runs exist', async () => {
   242→    // Delete runs file
   243→    const runsPath = path.join(tempDir, '.kspec', 'kynetic.runs.yaml');
   244→    await fs.unlink(runsPath);
   245→
   246→    const result = kspec('workflow runs', tempDir);
   247→
   248→    expect(result.exitCode).toBe(0);
   249→    expect(result.stdout).toContain('No workflow runs found');
   250→  });
   251→});
