   306→// AC: @workflow-run-foundation ac-3
   307→describe('workflow abort', () => {
   308→  let runId: string;
   309→
   310→  beforeEach(async () => {
   311→    const result = kspec('workflow start @test-workflow --json', tempDir);
   312→    const output = JSON.parse(result.stdout);
   313→    runId = output.run_id;
   314→  });
   315→
   316→  it('should abort an active run', async () => {
   317→    const result = kspec(`workflow abort @${runId} --reason "Testing abort" --json`, tempDir);
   318→
   319→    expect(result.exitCode).toBe(0);
   320→    const output = JSON.parse(result.stdout);
   321→
   322→    expect(output.run_id).toBe(runId);
   323→    expect(output.status).toBe('aborted');
   324→
   325→    // Verify in file
   326→    const runsPath = path.join(tempDir, '.kspec', 'kynetic.runs.yaml');
   327→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   328→    const doc = parseDocument(runsContent);
   329→    const runsData = doc.toJS() as { runs: any[] };
   330→
   331→    const run = runsData.runs[0];
   332→    expect(run.status).toBe('aborted');
   333→    expect(run.abort_reason).toBe('Testing abort');
   334→    expect(run.completed_at).toBeDefined();
   335→  });
   336→
   337→  it('should display abort confirmation in human output', async () => {
   338→    const result = kspec(`workflow abort @${runId} --reason "Testing"`, tempDir);
   339→
   340→    expect(result.exitCode).toBe(0);
   341→    expect(result.stdout).toContain('Aborted workflow run:');
   342→    expect(result.stdout).toContain('Reason: Testing');
   343→  });
   344→
   345→  it('should allow aborting without a reason', async () => {
   346→    const result = kspec(`workflow abort @${runId} --json`, tempDir);
   347→
   348→    expect(result.exitCode).toBe(0);
   349→
   350→    // Verify in file
   351→    const runsPath = path.join(tempDir, '.kspec', 'kynetic.runs.yaml');
   352→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   353→    const doc = parseDocument(runsContent);
   354→    const runsData = doc.toJS() as { runs: any[] };
   355→
   356→    const run = runsData.runs[0];
   357→    expect(run.status).toBe('aborted');
   358→    expect(run.abort_reason).toBeUndefined();
   359→  });
   360→});
