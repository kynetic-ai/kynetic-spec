   253→// AC: @workflow-run-foundation ac-4
   254→describe('workflow show', () => {
   255→  let runId: string;
   256→
   257→  beforeEach(async () => {
   258→    // Create a run
   259→    const result = kspec('workflow start @test-workflow --task @test-task --json', tempDir);
   260→    const output = JSON.parse(result.stdout);
   261→    runId = output.run_id;
   262→  });
   263→
   264→  it('should display run details in human-readable format', async () => {
   265→    const result = kspec(`workflow show @${runId}`, tempDir);
   266→
   267→    expect(result.exitCode).toBe(0);
   268→    expect(result.stdout).toContain('Workflow Run Details');
   269→    expect(result.stdout).toContain('test-workflow');
   270→    expect(result.stdout).toContain('active');
   271→    expect(result.stdout).toContain('0/3');
   272→    expect(result.stdout).toContain('Initiated by: @test');
   273→    expect(result.stdout).toContain('Task: @01TESTTASK000000000000001');
   274→  });
   275→
   276→  it('should output run details in JSON format', async () => {
   277→    const result = kspec(`workflow show @${runId} --json`, tempDir);
   278→
   279→    expect(result.exitCode).toBe(0);
   280→    const output = JSON.parse(result.stdout);
   281→
   282→    expect(output.run._ulid).toBe(runId);
   283→    expect(output.run.workflow_ref).toBe('@01TEST0000000000000000001');
   284→    expect(output.run.status).toBe('active');
   285→    expect(output.run.current_step).toBe(0);
   286→    expect(output.run.total_steps).toBe(3);
   287→    expect(output.run.task_ref).toBe('@01TESTTASK000000000000001');
   288→  });
   289→
   290→  it('should work with ULID prefix', async () => {
   291→    const shortRef = runId.slice(0, 8);
   292→    const result = kspec(`workflow show @${shortRef}`, tempDir);
   293→
   294→    expect(result.exitCode).toBe(0);
   295→    expect(result.stdout).toContain('Workflow Run Details');
   296→  });
   297→
   298→  it('should error if run does not exist', async () => {
   299→    const result = kspec('workflow show @01NONEXISTENT', tempDir, { expectFail: true });
   300→
   301→    expect(result.exitCode).toBe(3); // NOT_FOUND
   302→    expect(result.stderr).toContain('Workflow run not found');
   303→  });
   304→});
