     1→/**
     2→ * Tests for workflow run foundation
     3→ * Spec: @workflow-run-foundation
     4→ */
     5→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     6→import { kspec, createTempDir, deleteTempDir, initGitRepo } from './helpers/cli.js';
     7→import * as fs from 'node:fs/promises';
     8→import * as path from 'node:path';
     9→import { parseDocument } from 'yaml';
    10→
    11→let tempDir: string;
    12→
    13→beforeEach(async () => {
    14→  tempDir = await createTempDir();
    15→
    16→  // Initialize git repo (required for kspec init)
    17→  initGitRepo(tempDir);
    18→
    19→  // Initialize kspec project
    20→  kspec('init', tempDir);
    21→
    22→  // Create a simple workflow for testing
    23→  const metaManifest = {
    24→    kynetic_meta: '1.0',
    25→    workflows: [
    26→      {
    27→        _ulid: '01TEST0000000000000000001',
    28→        id: 'test-workflow',
    29→        trigger: 'manual',
    30→        description: 'Test workflow for run tests',
    31→        steps: [
    32→          {
    33→            type: 'check',
    34→            content: 'Verify prerequisites',
    35→          },
    36→          {
    37→            type: 'action',
    38→            content: 'Execute main task',
    39→          },
    40→          {
    41→            type: 'check',
    42→            content: 'Validate results',
    43→          },
    44→        ],
    45→      },
    46→      {
    47→        _ulid: '01TEST0000000000000000002',
    48→        id: 'another-workflow',
    49→        trigger: 'manual',
    50→        description: 'Another test workflow',
    51→        steps: [
    52→          {
    53→            type: 'action',
    54→            content: 'Do something',
    55→          },
    56→        ],
    57→      },
    58→    ],
    59→  };
    60→
    61→  const metaPath = path.join(tempDir, '.kspec', 'kynetic.meta.yaml');
    62→  await fs.writeFile(metaPath, JSON.stringify(metaManifest), 'utf-8');
    63→
    64→  // Create a test task for task linking tests
    65→  const tasksFile = {
    66→    kynetic_tasks: '1.0',
    67→    tasks: [
    68→      {
    69→        _ulid: '01TESTTASK000000000000001',
    70→        slugs: ['test-task'],
    71→        title: 'Test Task',
    72→        status: 'pending',
    73→        priority: 3,
    74→        created_at: new Date().toISOString(),
    75→      },
    76→    ],
    77→  };
    78→
    79→  const tasksPath = path.join(tempDir, '.kspec', 'project.tasks.yaml');
    80→  await fs.writeFile(tasksPath, JSON.stringify(tasksFile), 'utf-8');
    81→});
    82→
    83→afterEach(async () => {
    84→  if (tempDir) {
    85→    await deleteTempDir(tempDir);
    86→  }
    87→});
    88→
    89→// AC: @workflow-run-foundation ac-1
    90→describe('workflow start', () => {
    91→  it('should create a workflow run with correct initial state', async () => {
    92→    const result = kspec('workflow start @test-workflow --json', tempDir);
    93→
    94→    expect(result.exitCode).toBe(0);
    95→    const output = JSON.parse(result.stdout);
    96→
    97→    expect(output).toHaveProperty('run_id');
    98→    expect(output.workflow_ref).toBe('@01TEST0000000000000000001');
    99→    expect(output.status).toBe('active');
   100→
   101→    // Verify run was saved to file
   102→    const runsPath = path.join(tempDir, '.kspec', 'kynetic.runs.yaml');
   103→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   104→    const doc = parseDocument(runsContent);
   105→    const runsData = doc.toJS() as { runs: any[] };
   106→
   107→    expect(runsData.runs).toHaveLength(1);
   108→    const run = runsData.runs[0];
   109→
   110→    expect(run._ulid).toBe(output.run_id);
   111→    expect(run.workflow_ref).toBe('@01TEST0000000000000000001');
   112→    expect(run.status).toBe('active');
   113→    expect(run.current_step).toBe(0);
   114→    expect(run.total_steps).toBe(3);
   115→    expect(run.started_at).toBeDefined();
   116→    expect(run.step_results).toEqual([]);
   117→    expect(run.initiated_by).toBe('@test');
   118→  });
   119→
   120→  it('should display human-readable output without --json', async () => {
   121→    const result = kspec('workflow start @test-workflow', tempDir);
   122→
   123→    expect(result.exitCode).toBe(0);
   124→    expect(result.stdout).toContain('Started workflow run:');
   125→    expect(result.stdout).toContain('Workflow: test-workflow');
   126→    expect(result.stdout).toContain('Steps: 3');
   127→  });
   128→
   129→  it('should error if workflow does not exist', async () => {
   130→    const result = kspec('workflow start @nonexistent --json', tempDir, { expectFail: true });
   131→
   132→    expect(result.exitCode).toBe(3); // NOT_FOUND
   133→    expect(result.stderr).toContain('Workflow not found');
   134→  });
   135→});
