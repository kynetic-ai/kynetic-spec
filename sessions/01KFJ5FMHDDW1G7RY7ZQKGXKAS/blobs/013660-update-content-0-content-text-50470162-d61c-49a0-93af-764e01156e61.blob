```
     1→import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
     2→import { PassThrough } from 'node:stream';
     3→import {
     4→  isRequest,
     5→  isResponse,
     6→  isError,
     7→  isNotification,
     8→  JsonRpcFraming,
     9→  ACPClient,
    10→} from '../src/acp/index.js';
    11→
    12→// ============================================================================
    13→// Type Guards Tests
    14→// ============================================================================
    15→
    16→describe('JSON-RPC Type Guards', () => {
    17→  describe('isRequest', () => {
    18→    it('should identify valid requests', () => {
    19→      const request = {
    20→        jsonrpc: '2.0',
    21→        id: 1,
    22→        method: 'test',
    23→        params: { foo: 'bar' },
    24→      };
    25→      expect(isRequest(request)).toBe(true);
    26→    });
    27→
    28→    it('should identify requests with string id', () => {
    29→      const request = {
    30→        jsonrpc: '2.0',
    31→        id: 'abc-123',
    32→        method: 'test',
    33→      };
    34→      expect(isRequest(request)).toBe(true);
    35→    });
    36→
    37→    it('should reject requests without method', () => {
    38→      const request = {
    39→        jsonrpc: '2.0',
    40→        id: 1,
    41→      };
    42→      expect(isRequest(request)).toBe(false);
    43→    });
    44→
    45→    it('should reject requests without id', () => {
    46→      const notification = {
    47→        jsonrpc: '2.0',
    48→        method: 'test',
    49→      };
    50→      expect(isRequest(notification)).toBe(false);
    51→    });
    52→
    53→    it('should reject wrong jsonrpc version', () => {
    54→      const request = {
    55→        jsonrpc: '1.0',
    56→        id: 1,
    57→        method: 'test',
    58→      };
    59→      expect(isRequest(request)).toBe(false);
    60→    });
    61→  });
    62→
    63→  describe('isResponse', () => {
    64→    it('should identify valid responses', () => {
    65→      const response = {
    66→        jsonrpc: '2.0',
    67→        id: 1,
    68→        result: { data: 'test' },
    69→      };
    70→      expect(isResponse(response)).toBe(true);
    71→    });
    72→
    73→    it('should identify responses with null result', () => {
    74→      const response = {
    75→        jsonrpc: '2.0',
    76→        id: 1,
    77→        result: null,
    78→      };
    79→      expect(isResponse(response)).toBe(true);
    80→    });
    81→
    82→    it('should reject responses with error field', () => {
    83→      const error = {
    84→        jsonrpc: '2.0',
    85→        id: 1,
    86→        result: {},
    87→        error: { code: -1, message: 'fail' },
    88→      };
    89→      expect(isResponse(error)).toBe(false);
    90→    });
    91→  });
    92→
    93→  describe('isError', () => {
    94→    it('should identify valid errors', () => {
    95→      const error = {
    96→        jsonrpc: '2.0',
    97→        id: 1,
    98→        error: { code: -32600, message: 'Invalid Request' },
    99→      };
   100→      expect(isError(error)).toBe(true);
   101→    });
   102→
   103→    it('should identify errors with null id', () => {
   104→      const error = {
   105→        jsonrpc: '2.0',
   106→        id: null,
   107→        error: { code: -32700, message: 'Parse error' },
   108→      };
   109→      expect(isError(error)).toBe(true);
   110→    });
   111→
   112→    it('should identify errors with data', () => {
   113→      const error = {
   114→        jsonrpc: '2.0',
   115→        id: 1,
   116→        error: { code: -32600, message: 'Invalid Request', data: { details: 'missing field' } },
   117→      };
   118→      expect(isError(error)).toBe(true);
   119→    });
   120→
   121→    it('should reject errors without error object', () => {
   122→      const response = {
   123→        jsonrpc: '2.0',
   124→        id: 1,
   125→        result: null,
   126→      };
   127→      expect(isError(response)).toBe(false);
   128→    });
   129→  });
   130→
   131→  describe('isNotification', () => {
   132→    it('should identify valid notifications', () => {
   133→      const notification = {
   134→        jsonrpc: '2.0',
   135→        method: 'session/update',
   136→        params: { sessionId: 'abc' },
   137→      };
   138→      expect(isNotification(notification)).toBe(true);
   139→    });
   140→
   141→    it('should identify notifications without params', () => {
   142→      const notification = {
   143→        jsonrpc: '2.0',
   144→        method: 'ping',
   145→      };
   146→      expect(isNotification(notification)).toBe(true);
   147→    });
   148→
   149→    it('should reject notifications with id (those are requests)', () => {
   150→      const request = {
   151→        jsonrpc: '2.0',
   152→        id: 1,
   153→        method: 'test',
   154→      };
   155→      expect(isNotification(request)).toBe(false);
   156→    });
   157→  });
   158→});
