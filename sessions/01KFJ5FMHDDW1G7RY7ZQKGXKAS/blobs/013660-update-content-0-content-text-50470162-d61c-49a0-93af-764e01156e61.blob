   160→// ============================================================================
   161→// JsonRpcFraming Tests
   162→// ============================================================================
   163→
   164→describe('JsonRpcFraming', () => {
   165→  let stdin: PassThrough;
   166→  let stdout: PassThrough;
   167→  let framing: JsonRpcFraming;
   168→
   169→  beforeEach(() => {
   170→    stdin = new PassThrough();
   171→    stdout = new PassThrough();
   172→    framing = new JsonRpcFraming({
   173→      stdin,
   174→      stdout,
   175→      timeout: 1000, // Short timeout for tests
   176→    });
   177→  });
   178→
   179→  afterEach(() => {
   180→    framing.close();
   181→  });
   182→
   183→  it('should send requests and receive responses', async () => {
   184→    // Set up to capture outgoing message
   185→    const outgoingMessages: string[] = [];
   186→    stdout.on('data', (chunk: Buffer) => {
   187→      outgoingMessages.push(chunk.toString());
   188→    });
   189→
   190→    // Start the request
   191→    const resultPromise = framing.sendRequest('test/method', { foo: 'bar' });
   192→
   193→    // Wait for the request to be sent
   194→    await new Promise((resolve) => setTimeout(resolve, 10));
   195→
   196→    // Verify request was sent
   197→    expect(outgoingMessages.length).toBe(1);
   198→    const sentRequest = JSON.parse(outgoingMessages[0]);
   199→    expect(sentRequest.jsonrpc).toBe('2.0');
   200→    expect(sentRequest.method).toBe('test/method');
   201→    expect(sentRequest.params).toEqual({ foo: 'bar' });
   202→    expect(sentRequest.id).toBe(1);
   203→
   204→    // Send response
   205→    const response = JSON.stringify({
   206→      jsonrpc: '2.0',
   207→      id: 1,
   208→      result: { success: true },
   209→    });
   210→    stdin.write(response + '\n');
   211→
   212→    // Verify result
   213→    const result = await resultPromise;
   214→    expect(result).toEqual({ success: true });
   215→  });
   216→
   217→  it('should handle error responses', async () => {
   218→    // Suppress console.error for this test
   219→    const consoleSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
   220→
   221→    const resultPromise = framing.sendRequest('test/method');
   222→
   223→    await new Promise((resolve) => setTimeout(resolve, 10));
   224→
   225→    // Send error response
   226→    const errorResponse = JSON.stringify({
   227→      jsonrpc: '2.0',
   228→      id: 1,
   229→      error: { code: -32600, message: 'Invalid Request' },
   230→    });
   231→    stdin.write(errorResponse + '\n');
   232→
   233→    // Verify error is thrown
   234→    await expect(resultPromise).rejects.toThrow('Invalid Request');
   235→
   236→    consoleSpy.mockRestore();
   237→  });
   238→
   239→  it('should timeout pending requests', async () => {
   240→    const shortTimeoutFraming = new JsonRpcFraming({
   241→      stdin,
   242→      stdout,
   243→      timeout: 50, // Very short timeout
   244→    });
   245→
   246→    const resultPromise = shortTimeoutFraming.sendRequest('test/method');
   247→
   248→    await expect(resultPromise).rejects.toThrow(/timed out/);
   249→
   250→    shortTimeoutFraming.close();
   251→  });
   252→
   253→  it('should emit request events for incoming requests', async () => {
   254→    const requestPromise = new Promise<unknown>((resolve) => {
   255→      framing.on('request', resolve);
   256→    });
   257→
   258→    // Send incoming request
   259→    const request = JSON.stringify({
   260→      jsonrpc: '2.0',
   261→      id: 'agent-1',
   262→      method: 'fs/read_text_file',
   263→      params: { path: '/test.txt' },
   264→    });
   265→    stdin.write(request + '\n');
   266→
   267→    const receivedRequest = await requestPromise;
   268→    expect(receivedRequest).toEqual({
   269→      jsonrpc: '2.0',
   270→      id: 'agent-1',
   271→      method: 'fs/read_text_file',
   272→      params: { path: '/test.txt' },
   273→    });
   274→  });
   275→
   276→  it('should emit notification events', async () => {
   277→    const notificationPromise = new Promise<unknown>((resolve) => {
   278→      framing.on('notification', resolve);
   279→    });
   280→
   281→    // Send notification
   282→    const notification = JSON.stringify({
   283→      jsonrpc: '2.0',
   284→      method: 'session/update',
   285→      params: { sessionId: 'test-session', update: { type: 'progress' } },
   286→    });
   287→    stdin.write(notification + '\n');
   288→
   289→    const receivedNotification = await notificationPromise;
   290→    expect(receivedNotification).toEqual({
   291→      jsonrpc: '2.0',
   292→      method: 'session/update',
   293→      params: { sessionId: 'test-session', update: { type: 'progress' } },
   294→    });
   295→  });
   296→
   297→  // AC: @acp-client ac-9
   298→  it('should send parse error for malformed JSON', async () => {
   299→    const outgoingMessages: string[] = [];
   300→    stdout.on('data', (chunk: Buffer) => {
   301→      outgoingMessages.push(chunk.toString());
   302→    });
   303→
   304→    // Send malformed JSON
   305→    stdin.write('not valid json\n');
   306→
   307→    await new Promise((resolve) => setTimeout(resolve, 10));
   308→
   309→    // Verify parse error was sent
   310→    expect(outgoingMessages.length).toBe(1);
   311→    const errorResponse = JSON.parse(outgoingMessages[0]);
   312→    expect(errorResponse.jsonrpc).toBe('2.0');
   313→    expect(errorResponse.id).toBe(null);
   314→    expect(errorResponse.error.code).toBe(-32700);
   315→    expect(errorResponse.error.message).toBe('Parse error');
   316→  });
   317→
   318→  // AC: @acp-client ac-8
   319→  it('should throw when closed', async () => {
   320→    framing.close();
   321→
   322→    await expect(() => framing.sendRequest('test')).rejects.toThrow('closed');
   323→    expect(() => framing.sendNotification('test')).toThrow('closed');
   324→    expect(() => framing.sendResponse(1, {})).toThrow('closed');
   325→  });
   326→
   327→  // AC: @acp-client ac-6
   328→  it('should reset pending timers on incoming activity', async () => {
   329→    // Create framing with short timeout
   330→    const shortFraming = new JsonRpcFraming({
   331→      stdin,
   332→      stdout,
   333→      timeout: 100,
   334→    });
   335→
   336→    // Start a request
   337→    const resultPromise = shortFraming.sendRequest('test/method');
   338→
   339→    // Wait 60ms, then send a notification (activity)
   340→    await new Promise((resolve) => setTimeout(resolve, 60));
   341→    stdin.write(JSON.stringify({ jsonrpc: '2.0', method: 'ping' }) + '\n');
   342→
   343→    // Wait another 60ms (total 120ms, would have timed out without reset)
   344→    await new Promise((resolve) => setTimeout(resolve, 60));
   345→
   346→    // Send the actual response
   347→    stdin.write(JSON.stringify({ jsonrpc: '2.0', id: 1, result: 'ok' }) + '\n');
   348→
   349→    // Should succeed because timer was reset
   350→    const result = await resultPromise;
   351→    expect(result).toBe('ok');
   352→
   353→    shortFraming.close();
   354→  });
   355→});
