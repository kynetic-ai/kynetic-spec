   357→// ============================================================================
   358→// ACPClient Tests
   359→// ============================================================================
   360→
   361→describe('ACPClient', () => {
   362→  let stdin: PassThrough;
   363→  let stdout: PassThrough;
   364→  let client: ACPClient;
   365→
   366→  beforeEach(() => {
   367→    stdin = new PassThrough();
   368→    stdout = new PassThrough();
   369→    client = new ACPClient({
   370→      stdin,
   371→      stdout,
   372→      timeout: 1000,
   373→      clientInfo: {
   374→        name: 'test-client',
   375→        version: '1.0.0',
   376→      },
   377→    });
   378→  });
   379→
   380→  afterEach(() => {
   381→    client.close();
   382→  });
   383→
   384→  /**
   385→   * Helper to respond to the next outgoing request
   386→   */
   387→  function respondToNext(result: unknown) {
   388→    return new Promise<void>((resolve) => {
   389→      stdout.once('data', (chunk: Buffer) => {
   390→        const request = JSON.parse(chunk.toString());
   391→        stdin.write(
   392→          JSON.stringify({
   393→            jsonrpc: '2.0',
   394→            id: request.id,
   395→            result,
   396→          }) + '\n',
   397→        );
   398→        resolve();
   399→      });
   400→    });
   401→  }
   402→
   403→  // AC: @acp-client ac-1
   404→  describe('initialize', () => {
   405→    it('should initialize and return agent capabilities', async () => {
   406→      const initPromise = client.initialize();
   407→
   408→      // Respond with capabilities
   409→      await respondToNext({
   410→        protocolVersion: 1,
   411→        agentCapabilities: {
   412→          streaming: true,
   413→        },
   414→      });
   415→
   416→      const capabilities = await initPromise;
   417→      expect(capabilities).toEqual({ streaming: true });
   418→      expect(client.isInitialized()).toBe(true);
   419→    });
   420→
   421→    it('should throw if already initialized', async () => {
   422→      const initPromise = client.initialize();
   423→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   424→      await initPromise;
   425→
   426→      await expect(client.initialize()).rejects.toThrow('already initialized');
   427→    });
   428→  });
   429→
   430→  // AC: @acp-client ac-2
   431→  describe('newSession', () => {
   432→    it('should create session and return sessionId', async () => {
   433→      // Initialize first
   434→      const initPromise = client.initialize();
   435→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   436→      await initPromise;
   437→
   438→      // Create session
   439→      const sessionPromise = client.newSession({
   440→        cwd: '/test',
   441→        _meta: { test: true },
   442→      });
   443→
   444→      await respondToNext({ sessionId: 'session-123' });
   445→
   446→      const sessionId = await sessionPromise;
   447→      expect(sessionId).toBe('session-123');
   448→
   449→      // Verify session is tracked
   450→      const session = client.getSession('session-123');
   451→      expect(session).toEqual({ id: 'session-123', status: 'idle' });
   452→    });
   453→
   454→    it('should throw if not initialized', async () => {
   455→      await expect(client.newSession({ cwd: '/' })).rejects.toThrow(
   456→        'not initialized',
   457→      );
   458→    });
   459→  });
   460→
   461→  // AC: @acp-client ac-3
   462→  describe('prompt', () => {
   463→    beforeEach(async () => {
   464→      // Initialize and create session for prompt tests
   465→      const initPromise = client.initialize();
   466→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   467→      await initPromise;
   468→
   469→      const sessionPromise = client.newSession({ cwd: '/' });
   470→      await respondToNext({ sessionId: 'session-123' });
   471→      await sessionPromise;
   472→    });
   473→
   474→    it('should send prompt and return response with stopReason', async () => {
   475→      const promptPromise = client.prompt({
   476→        sessionId: 'session-123',
   477→        prompt: [{ type: 'text', text: 'Hello' }],
   478→      });
   479→
   480→      await respondToNext({
   481→        stopReason: 'end_turn',
   482→      });
   483→
   484→      const response = await promptPromise;
   485→      expect(response.stopReason).toBe('end_turn');
   486→    });
   487→
   488→    it('should update session status during prompt', async () => {
   489→      // Capture the request without immediately responding
   490→      let requestId: number | string | undefined;
   491→      const requestReceived = new Promise<void>((resolve) => {
   492→        stdout.once('data', (chunk: Buffer) => {
   493→          const request = JSON.parse(chunk.toString());
   494→          requestId = request.id;
   495→          resolve();
   496→        });
   497→      });
   498→
   499→      const promptPromise = client.prompt({
   500→        sessionId: 'session-123',
   501→        prompt: [{ type: 'text', text: 'Hello' }],
   502→      });
   503→
   504→      // Wait for request to be sent
   505→      await requestReceived;
   506→
   507→      // NOW check status - should be prompting since we haven't responded yet
   508→      expect(client.getSession('session-123')?.status).toBe('prompting');
   509→
   510→      // Send response
   511→      stdin.write(
   512→        JSON.stringify({
   513→          jsonrpc: '2.0',
   514→          id: requestId,
   515→          result: { stopReason: 'end_turn' },
   516→        }) + '\n',
   517→      );
   518→
   519→      await promptPromise;
   520→
   521→      // Check status is idle after
   522→      expect(client.getSession('session-123')?.status).toBe('idle');
   523→    });
   524→
   525→    it('should throw if session not found', async () => {
   526→      await expect(
   527→        client.prompt({
   528→          sessionId: 'nonexistent',
   529→          prompt: [{ type: 'text', text: 'Hello' }],
   530→        }),
   531→      ).rejects.toThrow('Session not found');
   532→    });
   533→
   534→    it('should throw if already prompting', async () => {
   535→      // Capture the first request without immediately responding
   536→      let requestId: number | string | undefined;
   537→      const requestReceived = new Promise<void>((resolve) => {
   538→        stdout.once('data', (chunk: Buffer) => {
   539→          const request = JSON.parse(chunk.toString());
   540→          requestId = request.id;
   541→          resolve();
   542→        });
   543→      });
   544→
   545→      // Start first prompt (don't await)
   546→      const firstPrompt = client.prompt({
   547→        sessionId: 'session-123',
   548→        prompt: [{ type: 'text', text: 'Hello' }],
   549→      });
   550→
   551→      // Wait for first prompt request to be sent
   552→      await requestReceived;
   553→
   554→      // Try second prompt - should fail because first is still prompting
   555→      await expect(
   556→        client.prompt({
   557→          sessionId: 'session-123',
   558→          prompt: [{ type: 'text', text: 'Hello again' }],
   559→        }),
   560→      ).rejects.toThrow('already prompting');
   561→
   562→      // Clean up first prompt by sending response
   563→      stdin.write(
   564→        JSON.stringify({
   565→          jsonrpc: '2.0',
   566→          id: requestId,
   567→          result: { stopReason: 'end_turn' },
   568→        }) + '\n',
   569→      );
   570→      await firstPrompt;
   571→    });
   572→  });
   573→
   574→  // AC: @acp-client ac-4
   575→  describe('update events', () => {
   576→    beforeEach(async () => {
   577→      const initPromise = client.initialize();
   578→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   579→      await initPromise;
   580→
   581→      const sessionPromise = client.newSession({ cwd: '/' });
   582→      await respondToNext({ sessionId: 'session-123' });
   583→      await sessionPromise;
   584→    });
   585→
   586→    it('should emit update events for session updates', async () => {
   587→      const updatePromise = new Promise<{ sessionId: string; update: unknown }>(
   588→        (resolve) => {
   589→          client.on('update', (sessionId, update) => {
   590→            resolve({ sessionId, update });
   591→          });
   592→        },
   593→      );
   594→
   595→      // Send session update notification
   596→      stdin.write(
   597→        JSON.stringify({
   598→          jsonrpc: '2.0',
   599→          method: 'session/update',
   600→          params: {
   601→            sessionId: 'session-123',
   602→            update: {
   603→              sessionUpdate: 'assistant_message_chunk',
   604→              content: { type: 'text', text: 'Hello!' },
   605→            },
   606→          },
   607→        }) + '\n',
   608→      );
   609→
   610→      const { sessionId, update } = await updatePromise;
   611→      expect(sessionId).toBe('session-123');
   612→      expect(update).toEqual({
   613→        sessionUpdate: 'assistant_message_chunk',
   614→        content: { type: 'text', text: 'Hello!' },
   615→      });
   616→    });
   617→  });
   618→
   619→  // AC: @acp-client ac-7
   620→  describe('cancel', () => {
   621→    beforeEach(async () => {
   622→      const initPromise = client.initialize();
   623→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   624→      await initPromise;
   625→
   626→      const sessionPromise = client.newSession({ cwd: '/' });
   627→      await respondToNext({ sessionId: 'session-123' });
   628→      await sessionPromise;
   629→    });
   630→
   631→    it('should send cancel request', async () => {
   632→      const cancelPromise = client.cancel('session-123');
   633→      await respondToNext({});
   634→      await cancelPromise;
   635→
   636→      expect(client.getSession('session-123')?.status).toBe('cancelled');
   637→    });
   638→
   639→    it('should silently handle Method not found errors', async () => {
   640→      // Suppress console.error for this test
   641→      const consoleSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
   642→
   643→      const cancelPromise = client.cancel('session-123');
   644→
   645→      // Respond with Method not found
   646→      stdout.once('data', (chunk: Buffer) => {
   647→        const request = JSON.parse(chunk.toString());
   648→        stdin.write(
   649→          JSON.stringify({
   650→            jsonrpc: '2.0',
   651→            id: request.id,
   652→            error: { code: -32601, message: 'Method not found' },
   653→          }) + '\n',
   654→        );
   655→      });
   656→
   657→      // Should not throw
   658→      await cancelPromise;
   659→
   660→      consoleSpy.mockRestore();
   661→    });
   662→
   663→    it('should throw for other errors', async () => {
   664→      // Suppress console.error for this test
   665→      const consoleSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
   666→
   667→      const cancelPromise = client.cancel('session-123');
   668→
   669→      // Respond with different error
   670→      stdout.once('data', (chunk: Buffer) => {
   671→        const request = JSON.parse(chunk.toString());
   672→        stdin.write(
   673→          JSON.stringify({
   674→            jsonrpc: '2.0',
   675→            id: request.id,
