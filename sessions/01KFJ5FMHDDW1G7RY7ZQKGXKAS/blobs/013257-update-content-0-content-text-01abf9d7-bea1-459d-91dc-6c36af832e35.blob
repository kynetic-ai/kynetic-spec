   311→
   312→  // AC: @ralph-adapter-validation invalid-adapter-error
   313→  it('exits with code 3 and clear error for invalid adapter', async () => {
   314→    // Run without --adapter-cmd to trigger validation
   315→    const result = spawnSync(
   316→      'node',
   317→      [CLI_PATH, 'ralph', '--adapter', '@nonexistent/adapter-package', '--dry-run'],
   318→      {
   319→        cwd: tempDir,
   320→        encoding: 'utf-8',
   321→        timeout: 10000,
   322→        env: {
   323→          ...process.env,
   324→          KSPEC_AUTHOR: '@test',
   325→        },
   326→      }
   327→    );
   328→
   329→    const output = (result.stdout || '') + (result.stderr || '');
   330→
   331→    expect(result.status).toBe(3);
   332→    expect(output).toContain('Adapter package not found: @nonexistent/adapter-package');
   333→    expect(output).toContain('npm install -g @nonexistent/adapter-package');
   334→  });
   335→
   336→  // AC: @ralph-adapter-validation validation-before-spawn
   337→  it('validates adapter before spawning agent or creating session', async () => {
   338→    // Run with invalid adapter
   339→    const result = spawnSync(
   340→      'node',
   341→      [CLI_PATH, 'ralph', '--adapter', '@invalid/package'],
   342→      {
   343→        cwd: tempDir,
   344→        encoding: 'utf-8',
   345→        timeout: 10000,
   346→        env: {
   347→          ...process.env,
   348→          KSPEC_AUTHOR: '@test',
   349→        },
   350→      }
   351→    );
   352→
   353→    const output = (result.stdout || '') + (result.stderr || '');
   354→
   355→    // Should fail validation immediately
   356→    expect(result.status).toBe(3);
   357→    expect(output).toContain('Adapter package not found');
   358→
   359→    // Should NOT show any signs of session creation or agent spawn
   360→    expect(output).not.toContain('Spawning ACP agent');
   361→    expect(output).not.toContain('Creating ACP session');
   362→    expect(output).not.toContain('Iteration');
   363→
   364→    // Should NOT create session directory
   365→    const sessionsDir = path.join(tempDir, 'sessions');
   366→    const sessions = await fs.readdir(sessionsDir).catch(() => []);
   367→    expect(sessions.length).toBe(0);
   368→  });
   369→});
   370→
   371→// ─── Event Translator Unit Tests ────────────────────────────────────────────
   372→
   373→describe('ralph event translator', () => {
   374→  // Helper to create SessionUpdate objects
   375→  function makeChunk(
   376→    type: 'agent_message_chunk' | 'agent_thought_chunk',
   377→    text: string
   378→  ): SessionUpdate {
   379→    return {
   380→      sessionUpdate: type,
   381→      content: { type: 'text', text },
   382→    } as SessionUpdate;
   383→  }
   384→
   385→  describe('agent_message_chunk', () => {
   386→    it('translates streaming content', () => {
   387→      const translator = createTranslator();
   388→      const event = translator.translate(makeChunk('agent_message_chunk', 'Hello'));
   389→
   390→      expect(event).not.toBeNull();
   391→      expect(event!.type).toBe('agent_message');
   392→      expect(event!.data).toMatchObject({
   393→        kind: 'agent_message',
   394→        content: 'Hello',
   395→        isStreaming: true,
   396→      });
   397→    });
   398→
   399→    it('finalizes on empty string signal', () => {
   400→      const translator = createTranslator();
   401→
   402→      // First, stream some content
   403→      translator.translate(makeChunk('agent_message_chunk', 'Hello'));
   404→      translator.translate(makeChunk('agent_message_chunk', ' world'));
   405→
   406→      // Then send empty string to finalize
   407→      const finalEvent = translator.translate(makeChunk('agent_message_chunk', ''));
   408→
   409→      expect(finalEvent).not.toBeNull();
   410→      expect(finalEvent!.type).toBe('agent_message');
   411→      expect(finalEvent!.data).toMatchObject({
   412→        kind: 'agent_message',
   413→        content: 'Hello world',
   414→        isStreaming: false,
   415→      });
   416→    });
   417→
   418→    it('returns null for empty string when no active message', () => {
   419→      const translator = createTranslator();
   420→
   421→      // Send empty string without prior content
   422→      const event = translator.translate(makeChunk('agent_message_chunk', ''));
   423→
   424→      expect(event).toBeNull();
   425→    });
   426→  });
   427→
   428→  describe('agent_thought_chunk', () => {
   429→    it('translates streaming thought content', () => {
   430→      const translator = createTranslator();
   431→      const event = translator.translate(makeChunk('agent_thought_chunk', 'Thinking...'));
   432→
   433→      expect(event).not.toBeNull();
   434→      expect(event!.type).toBe('agent_thought');
   435→      expect(event!.data).toMatchObject({
   436→        kind: 'agent_thought',
   437→        content: 'Thinking...',
   438→        isStreaming: true,
   439→      });
   440→    });
   441→
   442→    it('finalizes on empty string signal', () => {
   443→      const translator = createTranslator();
   444→
   445→      // Stream some thought content
   446→      translator.translate(makeChunk('agent_thought_chunk', 'Let me think'));
   447→      translator.translate(makeChunk('agent_thought_chunk', ' about this'));
   448→
   449→      // Finalize with empty string
   450→      const finalEvent = translator.translate(makeChunk('agent_thought_chunk', ''));
   451→
   452→      expect(finalEvent).not.toBeNull();
   453→      expect(finalEvent!.type).toBe('agent_thought');
   454→      expect(finalEvent!.data).toMatchObject({
   455→        kind: 'agent_thought',
   456→        content: 'Let me think about this',
   457→        isStreaming: false,
   458→      });
   459→    });
   460→  });
   461→
   462→  describe('finalize()', () => {
   463→    it('returns final event for pending message', () => {
   464→      const translator = createTranslator();
   465→
   466→      // Stream content without empty string finalization
   467→      translator.translate(makeChunk('agent_message_chunk', 'Incomplete'));
   468→
   469→      // Call finalize explicitly
   470→      const finalEvent = translator.finalize();
   471→
   472→      expect(finalEvent).not.toBeNull();
   473→      expect(finalEvent!.type).toBe('agent_message');
   474→      expect(finalEvent!.data).toMatchObject({
   475→        kind: 'agent_message',
   476→        content: 'Incomplete',
   477→        isStreaming: false,
   478→      });
   479→    });
   480→
   481→    it('returns null when no pending message', () => {
   482→      const translator = createTranslator();
   483→
   484→      const event = translator.finalize();
   485→
   486→      expect(event).toBeNull();
   487→    });
   488→
   489→    it('clears state after finalize', () => {
   490→      const translator = createTranslator();
   491→
   492→      translator.translate(makeChunk('agent_message_chunk', 'Test'));
   493→      translator.finalize();
   494→
   495→      // Second finalize should return null
   496→      const secondFinalize = translator.finalize();
   497→      expect(secondFinalize).toBeNull();
   498→    });
   499→  });
   500→
   501→  describe('noise suppression', () => {
   502→    it('suppresses onPostToolUseHook messages', () => {
   503→      const translator = createTranslator();
   504→      const event = translator.translate(
   505→        makeChunk('agent_message_chunk', 'No onPostToolUseHook found for tool use ID: toolu_123')
   506→      );
   507→
   508→      expect(event).toBeNull();
   509→    });
   510→
   511→    it('suppresses onPreToolUseHook messages', () => {
   512→      const translator = createTranslator();
   513→      const event = translator.translate(
   514→        makeChunk('agent_message_chunk', 'No onPreToolUseHook found for tool use')
   515→      );
   516→
   517→      expect(event).toBeNull();
   518→    });
   519→  });
   520→
   521→  describe('tool_call events', () => {
   522→    it('extracts tool name and summary from rawInput (ACP format)', () => {
   523→      const translator = createTranslator();
   524→      const event = translator.translate({
   525→        sessionUpdate: 'tool_call',
   526→        toolCallId: 'toolu_123',
   527→        rawInput: { command: 'npm run build' },
   528→        _meta: { claudeCode: { toolName: 'Bash' } },
   529→      } as SessionUpdate);
   530→
   531→      expect(event).not.toBeNull();
   532→      expect(event!.type).toBe('tool_start');
   533→      expect(event!.data).toMatchObject({
   534→        kind: 'tool_start',
   535→        toolCallId: 'toolu_123',
   536→        tool: 'Bash',
   537→        summary: 'npm run build',
   538→      });
   539→    });
   540→
   541→    it('extracts file path summary for Read tool', () => {
   542→      const translator = createTranslator();
   543→      const event = translator.translate({
   544→        sessionUpdate: 'tool_call',
   545→        toolCallId: 'toolu_456',
   546→        rawInput: { file_path: '/home/user/project/src/index.ts' },
   547→        _meta: { claudeCode: { toolName: 'Read' } },
   548→      } as SessionUpdate);
   549→
   550→      expect(event).not.toBeNull();
   551→      expect(event!.data).toMatchObject({
   552→        kind: 'tool_start',
   553→        tool: 'Read',
   554→        summary: 'index.ts',
   555→      });
   556→    });
   557→
   558→    it('extracts pattern summary for Grep tool', () => {
   559→      const translator = createTranslator();
   560→      const event = translator.translate({
   561→        sessionUpdate: 'tool_call',
   562→        toolCallId: 'toolu_789',
   563→        rawInput: { pattern: 'TODO|FIXME' },
   564→        _meta: { claudeCode: { toolName: 'Grep' } },
   565→      } as SessionUpdate);
   566→
   567→      expect(event).not.toBeNull();
   568→      expect(event!.data).toMatchObject({
   569→        kind: 'tool_start',
   570→        tool: 'Grep',
   571→        summary: '/TODO|FIXME/',
   572→      });
   573→    });
   574→
   575→    it('truncates long Bash commands', () => {
   576→      const translator = createTranslator();
   577→      const longCommand = 'npm run build -- --very-long-flag --another-flag --more-options';
   578→      const event = translator.translate({
   579→        sessionUpdate: 'tool_call',
   580→        toolCallId: 'toolu_abc',
   581→        rawInput: { command: longCommand },
   582→        _meta: { claudeCode: { toolName: 'Bash' } },
   583→      } as SessionUpdate);
   584→
   585→      expect(event).not.toBeNull();
   586→      const data = event!.data as { summary: string };
   587→      expect(data.summary.length).toBeLessThanOrEqual(50);
   588→      expect(data.summary).toContain('...');
   589→    });
   590→
   591→    it('deduplicates phased tool_call events (same tool_call_id)', () => {
   592→      const translator = createTranslator();
   593→
   594→      // Phase 1: Registration with no input
   595→      const event1 = translator.translate({
   596→        sessionUpdate: 'tool_call',
   597→        toolCallId: 'toolu_phased',
   598→        rawInput: {},
   599→        _meta: { claudeCode: { toolName: 'Bash' } },
   600→      } as SessionUpdate);
   601→
   602→      expect(event1).not.toBeNull();
   603→      expect(event1!.type).toBe('tool_start');
   604→      expect((event1!.data as { summary: string }).summary).toBe('');
   605→
   606→      // Phase 2: Same tool_call_id with input now available
   607→      const event2 = translator.translate({
   608→        sessionUpdate: 'tool_call',
   609→        toolCallId: 'toolu_phased',
   610→        rawInput: { command: 'npm run build' },
   611→        _meta: { claudeCode: { toolName: 'Bash' } },
   612→      } as SessionUpdate);
   613→
   614→      // Should emit tool_update with summary, not another tool_start
   615→      expect(event2).not.toBeNull();
   616→      expect(event2!.type).toBe('tool_update');
   617→      expect((event2!.data as { summary: string }).summary).toBe('npm run build');
   618→    });
   619→
   620→    it('suppresses duplicate tool_call events with no new summary', () => {
   621→      const translator = createTranslator();
   622→
   623→      // First event with input
   624→      translator.translate({
   625→        sessionUpdate: 'tool_call',
   626→        toolCallId: 'toolu_dup',
   627→        rawInput: { command: 'npm test' },
   628→        _meta: { claudeCode: { toolName: 'Bash' } },
   629→      } as SessionUpdate);
   630→
   631→      // Same event again (duplicate)
   632→      const event2 = translator.translate({
   633→        sessionUpdate: 'tool_call',
   634→        toolCallId: 'toolu_dup',
   635→        rawInput: { command: 'npm test' },
   636→        _meta: { claudeCode: { toolName: 'Bash' } },
   637→      } as SessionUpdate);
   638→
   639→      // Should suppress since summary didn't change
   640→      expect(event2).toBeNull();
   641→    });
   642→  });
   643→
   644→  describe('tool_call_update events', () => {
   645→    it('extracts output from Claude Code toolResponse format', () => {
   646→      const translator = createTranslator();
