     1→/**
     2→ * Tests for ralph command and event translator.
     3→ *
     4→ * Uses a mock ACP agent to test loop behavior, retry logic,
     5→ * and failure handling without invoking the real Claude Code.
     6→ */
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import * as fs from 'node:fs/promises';
     9→import * as path from 'node:path';
    10→import { spawnSync } from 'node:child_process';
    11→import { createTranslator } from '../src/ralph/events.js';
    12→import type { SessionUpdate } from '../src/acp/types.js';
    13→import { CLI_PATH, setupTempFixtures, cleanupTempDir } from './helpers/cli';
    14→
    15→const MOCK_ACP = path.join(__dirname, 'mocks', 'acp-mock.js');
    16→
    17→interface RalphResult {
    18→  output: string; // Combined stdout + stderr for easier assertion
    19→  stdout: string;
    20→  stderr: string;
    21→  exitCode: number;
    22→}
    23→
    24→/**
    25→ * Run ralph command with mock ACP agent
    26→ */
    27→function runRalph(
    28→  args: string,
    29→  cwd: string,
    30→  env: Record<string, string> = {}
    31→): RalphResult {
    32→  const result = spawnSync(
    33→    'node',
    34→    [CLI_PATH, 'ralph', ...args.split(/\s+/), '--adapter-cmd', `node ${MOCK_ACP}`],
    35→    {
    36→      cwd,
    37→      encoding: 'utf-8',
    38→      timeout: 30000,
    39→      env: {
    40→        ...process.env,
    41→        KSPEC_AUTHOR: '@test',
    42→        ...env,
    43→      },
    44→    }
    45→  );
    46→
    47→  const stdout = result.stdout || '';
    48→  const stderr = result.stderr || '';
    49→
    50→  return {
    51→    output: stdout + stderr,
    52→    stdout,
    53→    stderr,
    54→    exitCode: result.status || 0,
    55→  };
    56→}
    57→
    58→describe('ralph command', () => {
    59→  let tempDir: string;
    60→  let stateFile: string;
    61→
    62→  beforeEach(async () => {
    63→    tempDir = await setupTempFixtures();
    64→    stateFile = path.join(tempDir, 'mock-state');
    65→  });
    66→
    67→  afterEach(async () => {
    68→    await cleanupTempDir(tempDir);
    69→  });
    70→
    71→  // AC: @cli-ralph ac-1 - Basic loop execution
    72→  it('executes loop iterations when ready tasks exist', async () => {
    73→    const result = runRalph('--max-loops 2', tempDir, {
    74→      MOCK_ACP_EXIT_CODE: '0',
    75→    });
    76→
    77→    expect(result.stdout).toContain('Iteration 1/2');
    78→    expect(result.stdout).toContain('Iteration 2/2');
    79→    expect(result.stdout).toContain('Completed iteration 1');
    80→    expect(result.stdout).toContain('Completed iteration 2');
    81→    expect(result.stdout).toContain('Ralph loop completed');
    82→  });
    83→
    84→  // AC: @cli-ralph ac-2 - No ready tasks exit
    85→  it('exits when no ready tasks exist', async () => {
    86→    // Modify fixtures to have no ready tasks - mark all pending as completed
    87→    const tasksPath = path.join(tempDir, 'project.tasks.yaml');
    88→    const content = await fs.readFile(tasksPath, 'utf-8');
    89→    // Change all pending tasks to completed (use global replace)
    90→    const modified = content.replace(/status: pending/g, 'status: completed');
    91→    await fs.writeFile(tasksPath, modified);
    92→
    93→    const result = runRalph('--max-loops 5', tempDir, {
    94→      MOCK_ACP_EXIT_CODE: '0',
    95→    });
    96→
    97→    expect(result.output).toContain('No active or eligible ready tasks');
    98→    // Should not attempt multiple iterations
    99→    expect(result.output).not.toContain('Iteration 2/5');
   100→  });
   101→
   102→  // AC: @cli-ralph ac-16
   103→  it('only considers automation-eligible tasks, ignoring manual_only and unassessed', async () => {
   104→    // Modify fixtures: mark one task as manual_only (should be ignored)
   105→    // The pending task has no automation field (unassessed) - should also be ignored
   106→    const tasksPath = path.join(tempDir, 'project.tasks.yaml');
   107→    const content = await fs.readFile(tasksPath, 'utf-8');
   108→
   109→    // Add automation: manual_only to the pending task
   110→    const modified = content.replace(
   111→      /title: Test pending task\n    type: task\n    status: pending/,
   112→      'title: Test pending task\n    type: task\n    status: pending\n    automation: manual_only'
   113→    );
   114→    await fs.writeFile(tasksPath, modified);
   115→
   116→    const result = runRalph('--max-loops 5', tempDir, {
   117→      MOCK_ACP_EXIT_CODE: '0',
   118→    });
   119→
   120→    // Should exit with no eligible tasks message (after starting iteration 1)
   121→    expect(result.output).toContain('No active or eligible ready tasks');
   122→    // Should not continue to iteration 2 (exits early)
   123→    expect(result.output).not.toContain('Iteration 2/5');
   124→    // Should not show "Completed iteration" since no work was done
   125→    expect(result.output).not.toContain('Completed iteration');
   126→  });
   127→
   128→  it('processes automation-eligible tasks when available', async () => {
   129→    // Fixture already has automation: eligible on test-task-pending
   130→    const result = runRalph('--max-loops 1', tempDir, {
   131→      MOCK_ACP_EXIT_CODE: '0',
   132→    });
   133→
   134→    // Should process the eligible task
   135→    expect(result.output).toContain('Iteration 1/1');
   136→    expect(result.output).toContain('Completed iteration 1');
   137→  });
   138→
   139→  // AC: @cli-ralph ac-6 - Dry run mode
   140→  it('shows prompt without executing in dry-run mode', async () => {
   141→    const result = runRalph('--dry-run', tempDir);
   142→
   143→    expect(result.stdout).toContain('DRY RUN');
   144→    expect(result.stdout).toContain('Kspec Automation Session');
   145→    expect(result.stdout).toContain('Working Procedure');
   146→    // Should not show completion
   147→    expect(result.stdout).not.toContain('Completed iteration');
   148→  });
   149→
   150→  // AC: @cli-ralph ac-7 - Retry on error
   151→  it('retries iteration on failure', async () => {
   152→    // Fail twice then succeed
   153→    const result = runRalph('--max-loops 1 --max-retries 3', tempDir, {
   154→      MOCK_ACP_FAIL_COUNT: '2',
   155→      MOCK_ACP_STATE_FILE: stateFile,
   156→    });
   157→
   158→    expect(result.stdout).toContain('Retry attempt 1/3');
   159→    expect(result.stdout).toContain('Retry attempt 2/3');
   160→    expect(result.stdout).toContain('Completed iteration 1');
   161→  });
   162→
   163→  it('continues to next iteration after retries exhausted', async () => {
   164→    // Always fail
   165→    const result = runRalph('--max-loops 2 --max-retries 1 --max-failures 3', tempDir, {
   166→      MOCK_ACP_EXIT_CODE: '1',
   167→    });
   168→
   169→    expect(result.output).toContain('failed after 2 attempts');
   170→    expect(result.output).toContain('Continuing to next iteration');
   171→    expect(result.output).toContain('Iteration 2/2');
   172→  });
   173→
   174→  // AC: @cli-ralph ac-8 - Consecutive failure guard
   175→  it('exits after max consecutive failures', async () => {
   176→    // Always fail
   177→    const result = runRalph('--max-loops 10 --max-retries 0 --max-failures 2', tempDir, {
   178→      MOCK_ACP_EXIT_CODE: '1',
   179→    });
   180→
   181→    expect(result.output).toContain('1/2 consecutive failures');
   182→    expect(result.output).toContain('2/2 consecutive failures');
   183→    expect(result.output).toContain('Reached 2 consecutive failures');
   184→    // Should not continue to iteration 3
   185→    expect(result.output).not.toContain('Iteration 3/10');
   186→  });
   187→
   188→  it('resets failure count on success', async () => {
   189→    // For simplicity, just verify a success resets the pattern
   190→    const result = runRalph('--max-loops 2 --max-retries 0', tempDir, {
   191→      MOCK_ACP_EXIT_CODE: '0',
   192→    });
   193→
   194→    expect(result.output).toContain('Completed iteration 1');
   195→    expect(result.output).toContain('Completed iteration 2');
   196→    expect(result.output).not.toContain('consecutive failures');
   197→  });
   198→
   199→  // AC: @cli-ralph ac-9 - Adapter selection
   200→  it('uses specified adapter', async () => {
   201→    const result = runRalph('--dry-run --adapter custom --adapter-cmd "echo test"', tempDir);
   202→
   203→    // Dry run should show the adapter being used
   204→    expect(result.stdout).toContain('adapter=custom');
   205→  });
   206→
   207→  // AC: @cli-ralph ac-10 - Session creation
   208→  it('creates session and logs events', async () => {
   209→    const result = runRalph('--max-loops 1', tempDir, {
   210→      MOCK_ACP_EXIT_CODE: '0',
   211→    });
   212→
   213→    // Check that session directory was created
   214→    const sessionsDir = path.join(tempDir, 'sessions');
   215→    const sessions = await fs.readdir(sessionsDir).catch(() => []);
   216→    expect(sessions.length).toBeGreaterThan(0);
   217→
   218→    // Check session metadata
   219→    if (sessions.length > 0) {
   220→      const sessionDir = path.join(sessionsDir, sessions[0]);
   221→      const metadataPath = path.join(sessionDir, 'session.yaml');
   222→      const metadata = await fs.readFile(metadataPath, 'utf-8');
   223→      expect(metadata).toContain('agent_type:');
   224→      expect(metadata).toContain('status:');
   225→    }
   226→  });
   227→
   228→  // AC: @cli-ralph ac-11 - Streaming output
   229→  it('displays streaming output from agent', async () => {
   230→    const result = runRalph('--max-loops 1', tempDir, {
   231→      MOCK_ACP_EXIT_CODE: '0',
   232→      MOCK_ACP_RESPONSE_TEXT: 'Streaming test output',
   233→    });
   234→
   235→    // The streaming text should appear in output
   236→    expect(result.stdout).toContain('Streaming test output');
   237→  });
   238→
   239→  // AC: @cli-ralph ac-12 - Event logging
   240→  it('logs prompt.sent events', async () => {
   241→    const result = runRalph('--max-loops 1', tempDir, {
   242→      MOCK_ACP_EXIT_CODE: '0',
   243→    });
   244→
   245→    // Check events file
   246→    const sessionsDir = path.join(tempDir, 'sessions');
   247→    const sessions = await fs.readdir(sessionsDir).catch(() => []);
   248→
   249→    if (sessions.length > 0) {
   250→      const eventsPath = path.join(sessionsDir, sessions[0], 'events.jsonl');
   251→      const events = await fs.readFile(eventsPath, 'utf-8');
   252→
   253→      // Should have session.start, prompt.sent, and session.end at minimum
   254→      expect(events).toContain('"type":"session.start"');
   255→      expect(events).toContain('"type":"prompt.sent"');
   256→      expect(events).toContain('"type":"session.end"');
   257→    }
   258→  });
   259→
   260→  // AC: @cli-ralph ac-13 - Context snapshot saving
   261→  it('saves session context snapshot after each iteration', async () => {
   262→    const result = runRalph('--max-loops 2', tempDir, {
   263→      MOCK_ACP_EXIT_CODE: '0',
   264→    });
   265→
   266→    // Check that context snapshots were saved
   267→    const sessionsDir = path.join(tempDir, 'sessions');
   268→    const sessions = await fs.readdir(sessionsDir).catch(() => []);
   269→
   270→    expect(sessions.length).toBeGreaterThan(0);
   271→
   272→    if (sessions.length > 0) {
   273→      const sessionDir = path.join(sessionsDir, sessions[0]);
   274→
   275→      // Should have context snapshots for iteration 1 and 2
   276→      const context1Path = path.join(sessionDir, 'context-iter-1.json');
   277→      const context2Path = path.join(sessionDir, 'context-iter-2.json');
   278→
   279→      const context1Exists = await fs.access(context1Path).then(() => true).catch(() => false);
   280→      const context2Exists = await fs.access(context2Path).then(() => true).catch(() => false);
   281→
   282→      expect(context1Exists).toBe(true);
   283→      expect(context2Exists).toBe(true);
   284→
   285→      // Verify context structure
   286→      const context1Content = await fs.readFile(context1Path, 'utf-8');
   287→      const context1 = JSON.parse(context1Content);
   288→
   289→      expect(context1).toHaveProperty('generated_at');
   290→      expect(context1).toHaveProperty('branch');
   291→      expect(context1).toHaveProperty('active_tasks');
   292→      expect(context1).toHaveProperty('ready_tasks');
   293→      expect(context1).toHaveProperty('stats');
   294→    }
   295→  });
   296→
   297→  // ─── Adapter Validation Tests ──────────────────────────────────────────────
   298→
   299→  // AC: @ralph-adapter-validation valid-adapter-proceeds
   300→  it('proceeds with valid adapter (uses --adapter-cmd for testing)', async () => {
   301→    // When using --adapter-cmd, validation is skipped (custom command)
   302→    // This test verifies the mock adapter works (validation would pass for real adapters)
   303→    const result = runRalph('--max-loops 1', tempDir, {
   304→      MOCK_ACP_EXIT_CODE: '0',
   305→    });
   306→
