   653→        _meta: { claudeCode: { toolName: 'Bash' } },
   654→      } as SessionUpdate);
   655→
   656→      // Then send tool_call_update with result
   657→      const event = translator.translate({
   658→        sessionUpdate: 'tool_call_update',
   659→        toolCallId: 'toolu_123',
   660→        status: 'completed',
   661→        _meta: {
   662→          claudeCode: {
   663→            toolName: 'Bash',
   664→            toolResponse: {
   665→              stdout: 'hello\n',
   666→              stderr: '',
   667→              interrupted: false,
   668→              isImage: false,
   669→            },
   670→          },
   671→        },
   672→      } as SessionUpdate);
   673→
   674→      expect(event).not.toBeNull();
   675→      expect(event!.type).toBe('tool_result');
   676→      expect(event!.data).toMatchObject({
   677→        kind: 'tool_result',
   678→        toolCallId: 'toolu_123',
   679→        tool: 'Bash',
   680→        status: 'completed',
   681→        output: 'hello',
   682→      });
   683→    });
   684→
