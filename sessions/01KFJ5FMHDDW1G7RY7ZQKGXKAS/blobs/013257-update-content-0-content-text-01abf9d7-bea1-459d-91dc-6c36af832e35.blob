   707→            },
   708→          },
   709→        },
   710→      } as SessionUpdate);
   711→
   712→      expect(event).not.toBeNull();
   713→      const data = event!.data as { output: string };
   714→      expect(data.output).toContain('partial output');
   715→      expect(data.output).toContain('error: something went wrong');
   716→    });
   717→
