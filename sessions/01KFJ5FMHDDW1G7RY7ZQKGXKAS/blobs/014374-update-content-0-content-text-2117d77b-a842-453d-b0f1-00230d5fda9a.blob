   361→/**
   362→ * Format alignment warnings for display
   363→ */
   364→function formatAlignmentWarnings(
   365→  warnings: AlignmentWarning[],
   366→  verbose: boolean,
   367→): void {
   368→  if (warnings.length === 0) {
   369→    console.log(chalk.green("Alignment: OK"));
   370→    return;
   371→  }
   372→
   373→  console.log(chalk.yellow(`\nAlignment warnings: ${warnings.length}`));
   374→
   375→  // Group by type
   376→  const orphaned = warnings.filter((w) => w.type === "orphaned_spec");
   377→  const mismatches = warnings.filter((w) => w.type === "status_mismatch");
   378→  const stale = warnings.filter((w) => w.type === "stale_implementation");
   379→
   380→  if (orphaned.length > 0) {
   381→    console.log(
   382→      chalk.yellow(`  Orphaned specs (no tasks): ${orphaned.length}`),
   383→    );
   384→    const shown = verbose ? orphaned : orphaned.slice(0, 3);
   385→    for (const w of shown) {
   386→      console.log(chalk.gray(`    ○ ${w.specTitle}`));
   387→    }
   388→    if (!verbose && orphaned.length > 3) {
   389→      console.log(chalk.gray(`    ... and ${orphaned.length - 3} more`));
   390→    }
   391→  }
   392→
   393→  if (mismatches.length > 0) {
   394→    console.log(chalk.yellow(`  Status mismatches: ${mismatches.length}`));
   395→    for (const w of mismatches) {
   396→      console.log(chalk.yellow(`    ! ${w.specTitle}`));
   397→      console.log(chalk.gray(`      ${w.message}`));
   398→    }
   399→  }
   400→
   401→  if (stale.length > 0) {
   402→    console.log(chalk.yellow(`  Stale implementation status: ${stale.length}`));
   403→    for (const w of stale) {
   404→      console.log(chalk.yellow(`    ! ${w.message}`));
   405→    }
   406→  }
   407→}
