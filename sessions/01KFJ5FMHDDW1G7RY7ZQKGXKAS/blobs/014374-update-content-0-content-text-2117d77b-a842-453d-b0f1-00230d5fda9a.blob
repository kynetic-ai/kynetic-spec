   208→/**
   209→ * Format convention validation results for display
   210→ * AC: @convention-definitions ac-3, ac-4
   211→ */
   212→function formatConventionValidationResult(
   213→  result: ConventionValidationResult,
   214→): void {
   215→  if (result.valid && result.skipped.length === 0) {
   216→    console.log(chalk.green("Conventions: OK"));
   217→    return;
   218→  }
   219→
   220→  // AC: @convention-definitions ac-4
   221→  // Skipped prose conventions
   222→  if (result.skipped.length > 0) {
   223→    for (const domain of result.skipped) {
   224→      console.log(chalk.gray(`ℹ Skipping prose convention: ${domain}`));
   225→    }
   226→  }
   227→
   228→  // AC: @convention-definitions ac-3
   229→  // Validation errors
   230→  if (result.errors.length > 0) {
   231→    console.log(chalk.red(`\nConvention violations: ${result.errors.length}`));
   232→    for (const err of result.errors) {
   233→      console.log(chalk.red(`  ✗ ${err.domain}`));
   234→      console.log(chalk.gray(`    ${err.message}`));
   235→      if (err.expected) {
   236→        console.log(chalk.gray(`    Expected: ${err.expected}`));
   237→      }
   238→      if (err.location) {
   239→        console.log(chalk.gray(`    Location: ${err.location}`));
   240→      }
   241→    }
   242→  } else {
   243→    console.log(chalk.green("\nConventions: OK"));
   244→  }
   245→
   246→  // Stats
   247→  console.log(
   248→    chalk.gray(`\nConventions checked: ${result.stats.conventionsChecked}`),
   249→  );
   250→  console.log(
   251→    chalk.gray(`Conventions skipped: ${result.stats.conventionsSkipped}`),
   252→  );
   253→}
