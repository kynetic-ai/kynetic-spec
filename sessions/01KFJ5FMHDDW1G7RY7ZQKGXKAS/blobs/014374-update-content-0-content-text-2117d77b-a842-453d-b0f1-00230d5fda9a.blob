   409→/**
   410→ * Format fix results for display
   411→ */
   412→function formatFixResult(result: FixResult): void {
   413→  if (result.fixesApplied.length === 0) {
   414→    console.log(chalk.gray("\nNo auto-fixable issues found."));
   415→    return;
   416→  }
   417→
   418→  console.log(
   419→    chalk.cyan(
   420→      `\n✓ Applied ${result.fixesApplied.length} fix(es) to ${result.filesModified} file(s):`,
   421→    ),
   422→  );
   423→
   424→  for (const fix of result.fixesApplied) {
   425→    const typeLabel = {
   426→      ulid_regenerated: "ULID regenerated",
   427→      timestamp_added: "Timestamp added",
   428→      status_added: "Status added",
   429→    }[fix.type];
   430→
   431→    const shortFile = path.basename(fix.file);
   432→    console.log(chalk.cyan(`  ✓ ${shortFile}:${fix.path} - ${typeLabel}`));
   433→  }
   434→
   435→  if (result.errors.length > 0) {
   436→    console.log(chalk.yellow(`\nFix errors: ${result.errors.length}`));
   437→    for (const err of result.errors) {
   438→      console.log(chalk.yellow(`  ! ${err.file}: ${err.message}`));
   439→    }
   440→  }
   441→}
   442→
   443→/**
   444→ * Collect all files that can be fixed
   445→ */
   446→async function collectFixableFiles(ctx: {
   447→  rootDir: string;
   448→  specDir?: string;
   449→  manifest?: { includes?: string[] } | null;
   450→  manifestPath?: string | null;
   451→}): Promise<string[]> {
   452→  const files: string[] = [];
   453→
   454→  // Task files (exclude test fixtures)
   455→  const taskFiles = await findTaskFiles(ctx.rootDir);
   456→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, "spec"));
   457→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
   458→  files.push(
   459→    ...allTaskFiles.filter(
   460→      (f) => !f.includes("fixtures") && !f.includes("test"),
   461→    ),
   462→  );
   463→
   464→  // Spec files from includes
   465→  if (ctx.manifest && ctx.manifestPath) {
   466→    const manifestDir = path.dirname(ctx.manifestPath);
   467→    const includes = ctx.manifest.includes || [];
   468→
   469→    for (const include of includes) {
   470→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   471→      files.push(...expandedPaths);
   472→    }
   473→  }
   474→
   475→  // Inbox file
   476→  const inboxPath = path.join(ctx.rootDir, "spec", "kynetic.inbox.yaml");
   477→  try {
   478→    await import("node:fs/promises").then((fs) => fs.access(inboxPath));
   479→    files.push(inboxPath);
   480→  } catch {
   481→    // Inbox file doesn't exist, skip
   482→  }
   483→
   484→  return [...new Set(files)];
   485→}
   486→
   487→/**
   488→ * Format validation result for display
   489→ */
   490→function formatValidationResult(
   491→  result: ValidationResult,
   492→  verbose: boolean,
   493→): void {
   494→  // Header
   495→  if (result.valid) {
   496→    console.log(chalk.green.bold("✓ Validation passed"));
   497→  } else {
   498→    console.log(chalk.red.bold("✗ Validation failed"));
   499→  }
   500→
   501→  console.log(chalk.gray("─".repeat(40)));
   502→  console.log(`Files checked: ${result.stats.filesChecked}`);
   503→  console.log(`Items checked: ${result.stats.itemsChecked}`);
   504→  console.log(`Tasks checked: ${result.stats.tasksChecked}`);
   505→
   506→  // AC-meta-manifest-2: Display meta summary line
   507→  if (result.metaStats) {
   508→    console.log(
   509→      `Meta: ${result.metaStats.agents} agents, ${result.metaStats.workflows} workflows, ${result.metaStats.conventions} conventions`,
   510→    );
   511→  }
   512→
   513→  // Schema errors
   514→  if (result.schemaErrors.length > 0) {
   515→    console.log(chalk.red(`\nSchema errors: ${result.schemaErrors.length}`));
   516→    for (const err of result.schemaErrors) {
   517→      const location = err.path ? `${err.file}:${err.path}` : err.file;
   518→      console.log(chalk.red(`  ✗ ${location}`));
   519→      console.log(chalk.gray(`    ${err.message}`));
   520→      if (verbose && err.details) {
   521→        console.log(chalk.gray(`    ${JSON.stringify(err.details)}`));
   522→      }
   523→    }
   524→  } else {
   525→    console.log(chalk.green("\nSchema: OK"));
   526→  }
   527→
   528→  // Reference errors
   529→  if (result.refErrors.length > 0) {
   530→    console.log(chalk.red(`\nReference errors: ${result.refErrors.length}`));
   531→    for (const err of result.refErrors) {
   532→      const location = err.sourceFile
   533→        ? `${err.sourceFile} (${err.field})`
   534→        : `${err.sourceUlid?.slice(0, 8)} (${err.field})`;
   535→      console.log(chalk.red(`  ✗ ${err.ref}`));
   536→      console.log(chalk.gray(`    ${err.message}`));
   537→      console.log(chalk.gray(`    in: ${location}`));
   538→    }
   539→  } else {
   540→    console.log(chalk.green("References: OK"));
   541→  }
   542→
   543→  // Reference warnings (deprecated targets)
   544→  if (result.refWarnings.length > 0) {
   545→    console.log(
   546→      chalk.yellow(`\nReference warnings: ${result.refWarnings.length}`),
   547→    );
   548→    const shown = verbose ? result.refWarnings : result.refWarnings.slice(0, 5);
   549→    for (const warn of shown) {
   550→      const location = warn.sourceFile
   551→        ? `${warn.sourceFile} (${warn.field})`
   552→        : `${warn.sourceUlid?.slice(0, 8)} (${warn.field})`;
   553→      console.log(chalk.yellow(`  ⚠ ${warn.ref}`));
   554→      console.log(chalk.gray(`    ${warn.message}`));
   555→      console.log(chalk.gray(`    in: ${location}`));
   556→    }
   557→    if (!verbose && result.refWarnings.length > 5) {
   558→      console.log(
   559→        chalk.gray(
   560→          `  ... and ${result.refWarnings.length - 5} more (use -v to see all)`,
   561→        ),
   562→      );
   563→    }
   564→  }
   565→
   566→  // AC: @trait-edge-cases ac-2
   567→  // Trait cycle errors
   568→  if (result.traitCycleErrors.length > 0) {
   569→    console.log(
   570→      chalk.red(`\nTrait cycle errors: ${result.traitCycleErrors.length}`),
   571→    );
   572→    for (const err of result.traitCycleErrors) {
   573→      console.log(chalk.red(`  ✗ ${err.traitRef} - ${err.traitTitle}`));
   574→      console.log(chalk.gray(`    ${err.message}`));
   575→    }
   576→  }
   577→
   578→  // Orphans (warnings, not errors)
   579→  if (result.orphans.length > 0) {
   580→    console.log(
   581→      chalk.yellow(`\nOrphans (not referenced): ${result.orphans.length}`),
   582→    );
   583→    if (verbose) {
   584→      for (const orphan of result.orphans) {
   585→        console.log(
   586→          chalk.yellow(
   587→            `  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`,
   588→          ),
   589→        );
   590→      }
   591→    } else {
   592→      // Show first few
   593→      const shown = result.orphans.slice(0, 5);
   594→      for (const orphan of shown) {
   595→        console.log(
   596→          chalk.yellow(
   597→            `  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`,
   598→          ),
   599→        );
   600→      }
   601→      if (result.orphans.length > 5) {
   602→        console.log(
   603→          chalk.gray(
   604→            `  ... and ${result.orphans.length - 5} more (use -v to see all)`,
   605→          ),
   606→        );
   607→      }
   608→    }
   609→  }
   610→}
   611→
   612→/**
   613→ * Register validate command
   614→ */
   615→export function registerValidateCommand(program: Command): void {
   616→  program
   617→    .command("validate")
   618→    .description("Validate spec files")
   619→    .option("--schema", "Check schema conformance only")
   620→    .option("--refs", "Check reference resolution only")
   621→    .option("--orphans", "Find orphaned items only")
   622→    .option("--alignment", "Check spec-task alignment")
   623→    .option(
   624→      "--completeness",
   625→      "Check spec completeness (missing AC, descriptions, status inconsistencies)",
   626→    )
   627→    .option("--conventions", "Validate conventions")
   628→    .option(
   629→      "--staleness",
   630→      "Check for stale status mismatches between specs and tasks",
   631→    )
   632→    .option(
   633→      "--fix",
   634→      "Auto-fix issues where possible (invalid ULIDs, missing timestamps)",
   635→    )
   636→    .option("-v, --verbose", "Show detailed output")
   637→    .option("--strict", "Treat orphans and staleness warnings as errors")
   638→    .action(async (options) => {
   639→      try {
   640→        const ctx = await initContext();
   641→
   642→        if (!ctx.manifestPath) {
   643→          error(validationStrings.noManifest);
   644→          console.log(validationStrings.initHint);
   645→          process.exit(EXIT_CODES.ERROR);
   646→        }
   647→
   648→        // Determine which checks to run
   649→        const runAll =
   650→          !options.schema &&
   651→          !options.refs &&
   652→          !options.orphans &&
   653→          !options.alignment &&
   654→          !options.completeness &&
   655→          !options.conventions;
   656→        const validateOptions = {
   657→          schema: runAll || options.schema,
   658→          refs: runAll || options.refs,
   659→          orphans: runAll || options.orphans,
   660→          completeness: runAll || options.completeness,
   661→        };
   662→
   663→        const result = await validate(ctx, validateOptions);
   664→
   665→        // In strict mode, orphans are errors
   666→        if (options.strict && result.orphans.length > 0) {
   667→          result.valid = false;
   668→        }
   669→
   670→        output(result, () => formatValidationResult(result, options.verbose));
   671→
   672→        // Run auto-fix if requested
   673→        if (options.fix) {
   674→          const filesToFix = await collectFixableFiles(ctx);
   675→          const fixResult = await fixFiles(filesToFix);
   676→          formatFixResult(fixResult);
   677→
   678→          // Re-run validation after fixes to show updated status
   679→          if (fixResult.fixesApplied.length > 0) {
   680→            console.log(validationStrings.revalidating);
   681→            const revalidateResult = await validate(ctx, validateOptions);
   682→            if (revalidateResult.valid) {
   683→              console.log(validationStrings.nowPasses);
   684→            } else {
   685→              console.log(validationStrings.issuesRemain);
   686→            }
   687→            // Update result for exit code
   688→            result.valid = revalidateResult.valid;
   689→            result.schemaErrors = revalidateResult.schemaErrors;
   690→            result.refErrors = revalidateResult.refErrors;
   691→          }
   692→        }
   693→
   694→        // Run alignment check if requested or running all checks
   695→        if (options.alignment || runAll) {
   696→          const tasks = await loadAllTasks(ctx);
   697→          const items = await loadAllItems(ctx);
   698→          const refIndex = new ReferenceIndex(tasks, items);
   699→          const alignmentIndex = new AlignmentIndex(tasks, items);
   700→          alignmentIndex.buildLinks(refIndex);
   701→
   702→          const alignmentWarnings = alignmentIndex.findAlignmentWarnings();
   703→          formatAlignmentWarnings(alignmentWarnings, options.verbose);
   704→
   705→          // Show alignment stats
   706→          const stats = alignmentIndex.getStats();
   707→          console.log(
   708→            validationStrings.alignmentStats(
   709→              stats.specsWithTasks,
   710→              stats.totalSpecs,
   711→              stats.alignedSpecs,
   712→            ),
   713→          );
   714→        }
   715→
   716→        // Show completeness warnings if any
   717→        // AC: @spec-completeness ac-4
   718→        if (result.completenessWarnings.length > 0) {
   719→          formatCompletenessWarnings(
   720→            result.completenessWarnings,
   721→            options.verbose,
   722→          );
   723→        }
   724→
   725→        // Run convention validation if requested
   726→        // AC: @convention-definitions ac-3, ac-4
   727→        if (options.conventions) {
   728→          try {
   729→            const metaCtx = await loadMetaContext(ctx);
   730→            if (metaCtx && metaCtx.conventions.length > 0) {
   731→              // For now, we just validate that conventions are well-formed
   732→              // Full validation against actual content (commits, notes, etc.)
   733→              // would require additional content gathering logic
   734→              const conventionResult = validateConventions(
   735→                metaCtx.conventions,
   736→                {},
   737→              );
   738→              formatConventionValidationResult(conventionResult);
   739→
   740→              if (!conventionResult.valid) {
   741→                result.valid = false;
   742→              }
   743→            } else {
   744→              console.log(
   745→                chalk.gray("No conventions defined in meta manifest"),
   746→              );
   747→            }
   748→          } catch (_err) {
   749→            console.log(
   750→              chalk.yellow(
   751→                "Warning: Could not load meta manifest for convention validation",
   752→              ),
   753→            );
   754→          }
   755→        }
   756→
   757→        // Run staleness checks if requested
   758→        // AC: @stale-status-detection ac-4, ac-5
   759→        if (options.staleness) {
   760→          const tasks = await loadAllTasks(ctx);
   761→          const items = await loadAllItems(ctx);
   762→          const refIndex = new ReferenceIndex(tasks, items);
   763→
   764→          const stalenessWarnings = checkStaleness(items, tasks, refIndex);
   765→          formatStalenessWarnings(stalenessWarnings, options.verbose);
   766→
   767→          // AC: @stale-status-detection ac-5 (staleness-exit-code)
   768→          // With --strict, staleness warnings cause validation failure
   769→          if (options.strict && stalenessWarnings.length > 0) {
   770→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   771→          }
   772→        }
   773→
   774→        if (!result.valid) {
   775→          process.exit(EXIT_CODES.ERROR);
   776→        }
   777→      } catch (err) {
   778→        error(validationStrings.failed, err);
   779→        process.exit(EXIT_CODES.ERROR);
   780→      }
   781→    });
   782→
   783→  // Alias: kspec lint
   784→  program
   785→    .command("lint")
   786→    .description("Alias for validate with style checks")
   787→    .option("--schema", "Check schema conformance only")
   788→    .option("--refs", "Check reference resolution only")
   789→    .option("--orphans", "Find orphaned items only")
   790→    .option(
   791→      "--completeness",
   792→      "Check spec completeness (missing AC, descriptions, status inconsistencies)",
   793→    )
   794→    .option(
   795→      "--fix",
   796→      "Auto-fix issues where possible (invalid ULIDs, missing timestamps)",
   797→    )
   798→    .option("-v, --verbose", "Show detailed output")
   799→    .option("--strict", "Treat orphans as errors")
   800→    .action(async (options) => {
   801→      try {
   802→        const ctx = await initContext();
   803→
   804→        if (!ctx.manifestPath) {
   805→          error(validationStrings.noManifest);
   806→          process.exit(EXIT_CODES.ERROR);
   807→        }
   808→
   809→        const runAll =
   810→          !options.schema &&
   811→          !options.refs &&
   812→          !options.orphans &&
   813→          !options.completeness;
   814→        const validateOptions = {
   815→          schema: runAll || options.schema,
   816→          refs: runAll || options.refs,
   817→          orphans: runAll || options.orphans,
   818→          completeness: runAll || options.completeness,
   819→        };
   820→
   821→        const result = await validate(ctx, validateOptions);
   822→
   823→        if (options.strict && result.orphans.length > 0) {
   824→          result.valid = false;
   825→        }
   826→
   827→        output(result, () => formatValidationResult(result, options.verbose));
   828→
   829→        // Run auto-fix if requested
   830→        if (options.fix) {
   831→          const filesToFix = await collectFixableFiles(ctx);
   832→          const fixResult = await fixFiles(filesToFix);
   833→          formatFixResult(fixResult);
   834→
   835→          // Re-run validation after fixes
   836→          if (fixResult.fixesApplied.length > 0) {
   837→            console.log(validationStrings.revalidating);
   838→            const revalidateResult = await validate(ctx, validateOptions);
   839→            if (revalidateResult.valid) {
   840→              console.log(validationStrings.nowPasses);
   841→            } else {
   842→              console.log(validationStrings.issuesRemain);
   843→            }
   844→            result.valid = revalidateResult.valid;
   845→          }
   846→        }
   847→
   848→        if (!result.valid) {
   849→          process.exit(EXIT_CODES.ERROR);
   850→        }
   851→      } catch (err) {
   852→        error(validationStrings.lintFailed, err);
   853→        process.exit(EXIT_CODES.ERROR);
   854→      }
   855→    });
   856→}
   857→

