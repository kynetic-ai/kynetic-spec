```
     1→import * as path from "node:path";
     2→import chalk from "chalk";
     3→import type { Command } from "commander";
     4→import type { LoadedSpecItem, LoadedTask } from "../../parser/index.js";
     5→import {
     6→  AlignmentIndex,
     7→  type AlignmentWarning,
     8→  type CompletenessWarning,
     9→  type ConventionValidationResult,
    10→  expandIncludePattern,
    11→  type FixResult,
    12→  findTaskFiles,
    13→  fixFiles,
