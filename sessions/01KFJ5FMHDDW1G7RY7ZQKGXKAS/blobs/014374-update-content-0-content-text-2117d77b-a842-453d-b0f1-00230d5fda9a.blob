   255→/**
   256→ * Format completeness warnings for display
   257→ * AC: @spec-completeness ac-4
   258→ */
   259→function formatCompletenessWarnings(
   260→  warnings: CompletenessWarning[],
   261→  verbose: boolean,
   262→): void {
   263→  if (warnings.length === 0) {
   264→    console.log(chalk.green("Completeness: OK"));
   265→    return;
   266→  }
   267→
   268→  console.log(chalk.yellow(`\nCompleteness warnings: ${warnings.length}`));
   269→
   270→  // Group by type
   271→  const missingAC = warnings.filter(
   272→    (w) => w.type === "missing_acceptance_criteria",
   273→  );
   274→  const missingDesc = warnings.filter((w) => w.type === "missing_description");
   275→  const statusMismatch = warnings.filter(
   276→    (w) => w.type === "status_inconsistency",
   277→  );
   278→  const missingTestCoverage = warnings.filter(
   279→    (w) => w.type === "missing_test_coverage",
   280→  );
   281→  const automationNoSpec = warnings.filter(
   282→    (w) => w.type === "automation_eligible_no_spec",
   283→  );
   284→
   285→  // AC: @spec-completeness ac-4
   286→  // Show summary with counts by issue type
   287→  if (missingAC.length > 0) {
   288→    console.log(
   289→      chalk.yellow(`  Missing acceptance criteria: ${missingAC.length}`),
   290→    );
   291→    const shown = verbose ? missingAC : missingAC.slice(0, 3);
   292→    for (const w of shown) {
   293→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
   294→    }
   295→    if (!verbose && missingAC.length > 3) {
   296→      console.log(chalk.gray(`    ... and ${missingAC.length - 3} more`));
   297→    }
   298→  }
   299→
   300→  if (missingDesc.length > 0) {
   301→    console.log(chalk.yellow(`  Missing descriptions: ${missingDesc.length}`));
   302→    const shown = verbose ? missingDesc : missingDesc.slice(0, 3);
   303→    for (const w of shown) {
   304→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
   305→    }
   306→    if (!verbose && missingDesc.length > 3) {
   307→      console.log(chalk.gray(`    ... and ${missingDesc.length - 3} more`));
   308→    }
   309→  }
   310→
   311→  if (statusMismatch.length > 0) {
   312→    console.log(
   313→      chalk.yellow(`  Status inconsistencies: ${statusMismatch.length}`),
   314→    );
   315→    for (const w of statusMismatch) {
   316→      console.log(chalk.yellow(`    ! ${w.message}`));
   317→      if (w.details) {
   318→        console.log(chalk.gray(`      ${w.details}`));
   319→      }
   320→    }
   321→  }
   322→
   323→  if (missingTestCoverage.length > 0) {
   324→    console.log(
   325→      chalk.yellow(`  Missing test coverage: ${missingTestCoverage.length}`),
   326→    );
   327→    const shown = verbose
   328→      ? missingTestCoverage
   329→      : missingTestCoverage.slice(0, 3);
   330→    for (const w of shown) {
   331→      console.log(chalk.yellow(`    ! ${w.itemRef} - ${w.itemTitle}`));
   332→      if (w.details) {
   333→        console.log(chalk.gray(`      ${w.details}`));
   334→      }
   335→    }
   336→    if (!verbose && missingTestCoverage.length > 3) {
   337→      console.log(
   338→        chalk.gray(`    ... and ${missingTestCoverage.length - 3} more`),
   339→      );
   340→    }
   341→  }
   342→
   343→  // AC: @task-automation-eligibility ac-21, ac-23
   344→  if (automationNoSpec.length > 0) {
   345→    console.log(
   346→      chalk.yellow(`  Automation without spec: ${automationNoSpec.length}`),
   347→    );
   348→    const shown = verbose ? automationNoSpec : automationNoSpec.slice(0, 3);
   349→    for (const w of shown) {
   350→      console.log(chalk.yellow(`    ! ${w.itemRef} - ${w.itemTitle}`));
   351→      console.log(chalk.gray(`      ${w.message}`));
   352→    }
   353→    if (!verbose && automationNoSpec.length > 3) {
   354→      console.log(
   355→        chalk.gray(`    ... and ${automationNoSpec.length - 3} more`),
   356→      );
   357→    }
   358→  }
   359→}
