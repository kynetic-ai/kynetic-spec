    26→
    27→/**
    28→ * Staleness warning types
    29→ * AC: @stale-status-detection
    30→ */
    31→interface StalenessWarning {
    32→  type:
    33→    | "parent-pending-children-done"
    34→    | "spec-implemented-no-task"
    35→    | "task-done-spec-not-started";
    36→  message: string;
    37→  refs: string[];
    38→}
    39→
    40→/**
    41→ * Check for stale status mismatches between specs and tasks
    42→ * AC: @stale-status-detection ac-1, ac-2, ac-3
    43→ */
    44→function checkStaleness(
    45→  items: LoadedSpecItem[],
    46→  tasks: LoadedTask[],
    47→  refIndex: ReferenceIndex,
    48→): StalenessWarning[] {
    49→  const warnings: StalenessWarning[] = [];
    50→
    51→  // AC: @stale-status-detection ac-1 (parent-pending-children-done)
    52→  // Check if task with dependencies is pending but all dependencies are completed
    53→  for (const task of tasks) {
    54→    // Only check pending/in_progress tasks with dependencies
    55→    if (task.status !== "pending" && task.status !== "in_progress") continue;
    56→    if (!task.depends_on || task.depends_on.length === 0) continue;
    57→
    58→    // Resolve all dependency tasks
    59→    const depTasks = task.depends_on
    60→      .map((depRef) => {
    61→        const result = refIndex.resolve(depRef);
    62→        if (!result.ok) return null;
    63→        return tasks.find((t) => t._ulid === result.ulid);
    64→      })
    65→      .filter((t): t is LoadedTask => t !== null);
    66→
    67→    if (depTasks.length === 0) continue;
    68→
    69→    // Check if all dependencies are completed and their linked specs are implemented
    70→    const allDepsDone = depTasks.every((depTask) => {
    71→      if (depTask.status !== "completed") return false;
    72→
    73→      // If the dep task has a spec_ref, check if that spec is implemented
    74→      if (depTask.spec_ref) {
    75→        const result = refIndex.resolve(depTask.spec_ref);
    76→        if (!result.ok) return true; // Missing spec ref doesn't block
    77→        const spec = items.find((item) => item._ulid === result.ulid);
    78→        return spec?.status?.implementation === "implemented";
    79→      }
    80→      return true;
    81→    });
    82→
    83→    if (allDepsDone) {
    84→      const taskRef = task.slugs[0] || refIndex.shortUlid(task._ulid);
    85→      warnings.push({
    86→        type: "parent-pending-children-done",
    87→        message: `Task @${taskRef} is ${task.status} but all dependencies are completed. Consider completing or reviewing.`,
    88→        refs: [task._ulid],
    89→      });
    90→    }
    91→  }
    92→
    93→  // AC: @stale-status-detection ac-2 (spec-implemented-no-task)
    94→  // Check if spec is implemented but has no completed tasks
    95→  for (const item of items) {
    96→    if (item.status?.implementation !== "implemented") continue;
    97→
    98→    // Find completed tasks that reference this spec
    99→    const completedTasks = tasks.filter((task) => {
   100→      if (task.status !== "completed" || !task.spec_ref) return false;
   101→      const result = refIndex.resolve(task.spec_ref);
   102→      return result.ok && result.ulid === item._ulid;
   103→    });
   104→
   105→    if (completedTasks.length === 0) {
   106→      const specRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
   107→      warnings.push({
   108→        type: "spec-implemented-no-task",
   109→        message: `Spec @${specRef} is implemented but has no completed tasks. Verify implementation or link existing task.`,
   110→        refs: [item._ulid],
   111→      });
   112→    }
   113→  }
   114→
   115→  // AC: @stale-status-detection ac-3 (task-done-spec-not-started)
   116→  // Check if task is completed but spec is still not_started
   117→  for (const task of tasks) {
   118→    if (task.status !== "completed") continue;
   119→    if (!task.spec_ref) continue;
   120→
   121→    // Resolve spec reference
   122→    const result = refIndex.resolve(task.spec_ref);
   123→    if (!result.ok) continue;
   124→
   125→    const spec = items.find((item) => item._ulid === result.ulid);
   126→    if (!spec) continue;
   127→
   128→    if (spec.status?.implementation === "not_started") {
   129→      const taskRef = task.slugs[0] || refIndex.shortUlid(task._ulid);
   130→      const specRef = spec.slugs[0] || refIndex.shortUlid(spec._ulid);
   131→      warnings.push({
   132→        type: "task-done-spec-not-started",
   133→        message: `Task @${taskRef} completed but spec @${specRef} is not_started. Update spec status.`,
   134→        refs: [task._ulid, spec._ulid],
   135→      });
   136→    }
   137→  }
   138→
   139→  return warnings;
   140→}
   141→
   142→/**
   143→ * Format staleness warnings for display
   144→ * AC: @stale-status-detection ac-4
   145→ */
   146→function formatStalenessWarnings(
   147→  warnings: StalenessWarning[],
   148→  verbose: boolean,
   149→): void {
   150→  if (warnings.length === 0) {
   151→    console.log(chalk.green("Staleness: OK"));
   152→    return;
   153→  }
   154→
   155→  console.log(chalk.yellow(`\nStaleness warnings: ${warnings.length}`));
   156→
   157→  // Group by type
   158→  const parentPending = warnings.filter(
   159→    (w) => w.type === "parent-pending-children-done",
   160→  );
   161→  const specNoTask = warnings.filter(
   162→    (w) => w.type === "spec-implemented-no-task",
   163→  );
   164→  const taskDoneSpecNot = warnings.filter(
   165→    (w) => w.type === "task-done-spec-not-started",
   166→  );
   167→
   168→  if (parentPending.length > 0) {
   169→    console.log(
   170→      chalk.yellow(`  Parent pending, children done: ${parentPending.length}`),
   171→    );
   172→    const shown = verbose ? parentPending : parentPending.slice(0, 3);
   173→    for (const w of shown) {
   174→      console.log(chalk.yellow(`    ! ${w.message}`));
   175→    }
   176→    if (!verbose && parentPending.length > 3) {
   177→      console.log(chalk.gray(`    ... and ${parentPending.length - 3} more`));
   178→    }
   179→  }
   180→
   181→  if (specNoTask.length > 0) {
   182→    console.log(
   183→      chalk.yellow(`  Spec implemented, no task: ${specNoTask.length}`),
   184→    );
   185→    const shown = verbose ? specNoTask : specNoTask.slice(0, 3);
   186→    for (const w of shown) {
   187→      console.log(chalk.yellow(`    ! ${w.message}`));
   188→    }
   189→    if (!verbose && specNoTask.length > 3) {
   190→      console.log(chalk.gray(`    ... and ${specNoTask.length - 3} more`));
   191→    }
   192→  }
   193→
   194→  if (taskDoneSpecNot.length > 0) {
   195→    console.log(
   196→      chalk.yellow(`  Task done, spec not started: ${taskDoneSpecNot.length}`),
   197→    );
   198→    const shown = verbose ? taskDoneSpecNot : taskDoneSpecNot.slice(0, 3);
   199→    for (const w of shown) {
   200→      console.log(chalk.yellow(`    ! ${w.message}`));
   201→    }
   202→    if (!verbose && taskDoneSpecNot.length > 3) {
   203→      console.log(chalk.gray(`    ... and ${taskDoneSpecNot.length - 3} more`));
   204→    }
   205→  }
   206→}
