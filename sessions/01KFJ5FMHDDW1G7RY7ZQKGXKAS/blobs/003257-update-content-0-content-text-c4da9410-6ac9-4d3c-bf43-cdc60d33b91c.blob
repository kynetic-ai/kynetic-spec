   278→
   279→    expect(result.exitCode).toBe(0);
   280→    expect(result.stdout).toContain('Workflow Run Details');
   281→    expect(result.stdout).toContain('test-workflow');
   282→    expect(result.stdout).toContain('active');
   283→    expect(result.stdout).toContain('0/3');
