   179→// AC: @workflow-run-foundation ac-2
   180→describe('workflow runs list', () => {
   181→  beforeEach(async () => {
   182→    // Create multiple runs in different states
   183→    kspec('workflow start @test-workflow --json', tempDir);
   184→    kspec('workflow start @another-workflow --json', tempDir);
   185→
   186→    // Abort one of them
   187→    const runsPath = path.join(tempDir, 'kynetic.runs.yaml');
   188→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   189→    const doc = parseDocument(runsContent);
   190→    const runsData = doc.toJS() as { runs: any[] };
   191→
   192→    // Manually complete one run for testing
   193→    runsData.runs[1].status = 'completed';
   194→    runsData.runs[1].completed_at = new Date().toISOString();
   195→
   196→    const doc2 = parseDocument(await fs.readFile(runsPath, 'utf-8'));
   197→    doc2.setIn(['runs', 1, 'status'], 'completed');
   198→    doc2.setIn(['runs', 1, 'completed_at'], runsData.runs[1].completed_at);
   199→    await fs.writeFile(runsPath, doc2.toString(), 'utf-8');
   200→  });
   201→
   202→  it('should list all runs with table output', async () => {
   203→    const result = kspec('workflow runs', tempDir);
   204→
   205→    expect(result.exitCode).toBe(0);
   206→    expect(result.stdout).toContain('test-workflow');
   207→    expect(result.stdout).toContain('another-workflow');
   208→    expect(result.stdout).toContain('active');
   209→    expect(result.stdout).toContain('completed');
   210→  });
   211→
   212→  it('should output JSON with --json flag', async () => {
   213→    const result = kspec('workflow runs --json', tempDir);
   214→
   215→    expect(result.exitCode).toBe(0);
   216→    const output = JSON.parse(result.stdout);
   217→
   218→    expect(output.runs).toHaveLength(2);
   219→    expect(output.runs[0].status).toBe('active');
   220→    expect(output.runs[1].status).toBe('completed');
   221→  });
   222→
   223→  it('should filter by --active flag', async () => {
   224→    const result = kspec('workflow runs --active --json', tempDir);
   225→
   226→    expect(result.exitCode).toBe(0);
   227→    const output = JSON.parse(result.stdout);
   228→
   229→    expect(output.runs).toHaveLength(1);
   230→    expect(output.runs[0].status).toBe('active');
   231→  });
   232→
   233→  it('should filter by --completed flag', async () => {
   234→    const result = kspec('workflow runs --completed --json', tempDir);
   235→
   236→    expect(result.exitCode).toBe(0);
   237→    const output = JSON.parse(result.stdout);
   238→
   239→    expect(output.runs).toHaveLength(1);
   240→    expect(output.runs[0].status).toBe('completed');
   241→  });
   242→
   243→  it('should filter by --workflow flag', async () => {
   244→    const result = kspec('workflow runs --workflow @test-workflow --json', tempDir);
   245→
   246→    expect(result.exitCode).toBe(0);
   247→    const output = JSON.parse(result.stdout);
   248→
   249→    expect(output.runs).toHaveLength(1);
   250→    expect(output.runs[0].workflow_ref).toBe(`@${testWorkflowUlid}`);
   251→  });
   252→
   253→  it('should show "No workflow runs found" when no runs exist', async () => {
   254→    // Delete runs file
   255→    const runsPath = path.join(tempDir, 'kynetic.runs.yaml');
   256→    await fs.unlink(runsPath);
