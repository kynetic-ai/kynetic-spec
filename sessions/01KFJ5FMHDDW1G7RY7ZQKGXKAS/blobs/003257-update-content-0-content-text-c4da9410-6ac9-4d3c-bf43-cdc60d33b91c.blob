   318→// AC: @workflow-run-foundation ac-3
   319→describe('workflow abort', () => {
   320→  let runId: string;
   321→
   322→  beforeEach(async () => {
   323→    const result = kspec('workflow start @test-workflow --json', tempDir);
   324→    const output = JSON.parse(result.stdout);
   325→    runId = output.run_id;
   326→  });
   327→
   328→  it('should abort an active run', async () => {
   329→    const result = kspec(`workflow abort @${runId} --reason "Testing abort" --json`, tempDir);
   330→
   331→    expect(result.exitCode).toBe(0);
   332→    const output = JSON.parse(result.stdout);
   333→
   334→    expect(output.run_id).toBe(runId);
   335→    expect(output.status).toBe('aborted');
   336→
   337→    // Verify in file
   338→    const runsPath = path.join(tempDir, 'kynetic.runs.yaml');
   339→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   340→    const doc = parseDocument(runsContent);
   341→    const runsData = doc.toJS() as { runs: any[] };
   342→
   343→    const run = runsData.runs[0];
   344→    expect(run.status).toBe('aborted');
   345→    expect(run.abort_reason).toBe('Testing abort');
   346→    expect(run.completed_at).toBeDefined();
   347→  });
   348→
   349→  it('should display abort confirmation in human output', async () => {
   350→    const result = kspec(`workflow abort @${runId} --reason "Testing"`, tempDir);
   351→
   352→    expect(result.exitCode).toBe(0);
   353→    expect(result.stdout).toContain('Aborted workflow run:');
   354→    expect(result.stdout).toContain('Reason: Testing');
   355→  });
   356→
   357→  it('should allow aborting without a reason', async () => {
   358→    const result = kspec(`workflow abort @${runId} --json`, tempDir);
   359→
   360→    expect(result.exitCode).toBe(0);
   361→
   362→    // Verify in file
   363→    const runsPath = path.join(tempDir, 'kynetic.runs.yaml');
   364→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   365→    const doc = parseDocument(runsContent);
   366→    const runsData = doc.toJS() as { runs: any[] };
   367→
   368→    const run = runsData.runs[0];
   369→    expect(run.status).toBe('aborted');
   370→    expect(run.abort_reason).toBeUndefined();
   371→  });
   372→});
