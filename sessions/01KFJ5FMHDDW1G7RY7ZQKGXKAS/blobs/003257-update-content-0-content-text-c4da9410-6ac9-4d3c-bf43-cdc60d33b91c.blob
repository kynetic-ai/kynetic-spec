     1→/**
     2→ * Tests for workflow run foundation
     3→ * Spec: @workflow-run-foundation
     4→ */
     5→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     6→import { kspec, createTempDir, cleanupTempDir, initGitRepo } from './helpers/cli.js';
     7→import * as fs from 'node:fs/promises';
     8→import * as path from 'node:path';
     9→import * as YAML from 'yaml';
    10→import { parseDocument } from 'yaml';
    11→import { ulid } from 'ulid';
    12→
    13→let tempDir: string;
    14→let testWorkflowUlid: string;
    15→let anotherWorkflowUlid: string;
    16→let testTaskUlid: string;
    17→
    18→beforeEach(async () => {
    19→  tempDir = await createTempDir();
    20→
    21→  // Generate valid ULIDs for test fixtures
    22→  testWorkflowUlid = ulid();
    23→  anotherWorkflowUlid = ulid();
    24→  testTaskUlid = ulid();
    25→
    26→  // Initialize git repo (required for shadow operations)
    27→  initGitRepo(tempDir);
    28→
    29→  // Create minimal root manifest (non-shadow mode: files in project root)
    30→  await fs.writeFile(
    31→    path.join(tempDir, 'kynetic.yaml'),
    32→    `kynetic: "1.0"
    33→project: Test Project
    34→`,
    35→    'utf-8',
    36→  );
    37→
    38→  // Create workflows in meta manifest (non-shadow mode: files in project root)
    39→  await fs.writeFile(
    40→    path.join(tempDir, 'kynetic.meta.yaml'),
    41→    `kynetic_meta: "1.0"
    42→workflows:
    43→  - _ulid: ${testWorkflowUlid}
    44→    id: test-workflow
    45→    trigger: manual
    46→    description: Test workflow for run tests
    47→    steps:
    48→      - type: check
    49→        content: Verify prerequisites
    50→      - type: action
    51→        content: Execute main task
    52→      - type: check
    53→        content: Validate results
    54→
    55→  - _ulid: ${anotherWorkflowUlid}
    56→    id: another-workflow
    57→    trigger: manual
    58→    description: Another test workflow
    59→    steps:
    60→      - type: action
    61→        content: Do something
    62→
    63→agents:
    64→  - _ulid: 01KF79QXTTX8KBRYK14NWV1KYK
    65→    id: test
    66→    name: Test Author
    67→    description: Generic test author
    68→    capabilities: []
    69→    tools: []
    70→    conventions: []
    71→`,
    72→    'utf-8',
    73→  );
    74→
    75→  // Create a test task for task linking tests (non-shadow mode: files in project root)
    76→  await fs.writeFile(
    77→    path.join(tempDir, 'project.tasks.yaml'),
    78→    `kynetic_tasks: "1.0"
    79→tasks:
    80→  - _ulid: ${testTaskUlid}
    81→    slugs:
    82→      - test-task
    83→    title: Test Task
    84→    status: pending
    85→    priority: 3
    86→    created_at: "${new Date().toISOString()}"
    87→`,
    88→    'utf-8',
    89→  );
    90→});
    91→
    92→afterEach(async () => {
    93→  if (tempDir) {
    94→    await cleanupTempDir(tempDir);
    95→  }
    96→});
    97→
    98→// AC: @workflow-run-foundation ac-1
    99→describe('workflow start', () => {
   100→  it('should create a workflow run with correct initial state', async () => {
   101→    const result = kspec('workflow start @test-workflow --json', tempDir);
   102→
   103→    expect(result.exitCode).toBe(0);
   104→    const output = JSON.parse(result.stdout);
   105→
   106→    expect(output).toHaveProperty('run_id');
   107→    expect(output.workflow_ref).toBe(`@${testWorkflowUlid}`);
   108→    expect(output.status).toBe('active');
   109→
   110→    // Verify run was saved to file
   111→    const runsPath = path.join(tempDir, 'kynetic.runs.yaml');
   112→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   113→    const doc = parseDocument(runsContent);
   114→    const runsData = doc.toJS() as { runs: any[] };
   115→
   116→    expect(runsData.runs).toHaveLength(1);
   117→    const run = runsData.runs[0];
   118→
   119→    expect(run._ulid).toBe(output.run_id);
   120→    expect(run.workflow_ref).toBe(`@${testWorkflowUlid}`);
   121→    expect(run.status).toBe('active');
   122→    expect(run.current_step).toBe(0);
   123→    expect(run.total_steps).toBe(3);
   124→    expect(run.started_at).toBeDefined();
   125→    expect(run.step_results).toEqual([]);
   126→    expect(run.initiated_by).toBe('@test');
   127→  });
   128→
   129→  it('should display human-readable output without --json', async () => {
   130→    const result = kspec('workflow start @test-workflow', tempDir);
   131→
   132→    expect(result.exitCode).toBe(0);
   133→    expect(result.stdout).toContain('Started workflow run:');
   134→    expect(result.stdout).toContain('Workflow: test-workflow');
   135→    expect(result.stdout).toContain('Steps: 3');
   136→  });
   137→
   138→  it('should error if workflow does not exist', async () => {
   139→    const result = kspec('workflow start @nonexistent --json', tempDir, { expectFail: true });
   140→
   141→    expect(result.exitCode).toBe(3); // NOT_FOUND
   142→    expect(result.stderr).toContain('Workflow not found');
   143→  });
   144→});
   145→
   146→// AC: @workflow-run-foundation ac-6
   147→describe('workflow start with task link', () => {
   148→  it('should link run to task when --task is provided', async () => {
   149→    const result = kspec('workflow start @test-workflow --task @test-task --json', tempDir);
   150→
   151→    expect(result.exitCode).toBe(0);
   152→    const output = JSON.parse(result.stdout);
   153→
   154→    // Verify output includes task reference
   155→    const runsPath = path.join(tempDir, 'kynetic.runs.yaml');
   156→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   157→    const doc = parseDocument(runsContent);
   158→    const runsData = doc.toJS() as { runs: any[] };
   159→
   160→    const run = runsData.runs[0];
   161→    expect(run.task_ref).toBe(`@${testTaskUlid}`);
   162→  });
   163→
   164→  it('should display task link in human output', async () => {
   165→    const result = kspec('workflow start @test-workflow --task @test-task', tempDir);
   166→
   167→    expect(result.exitCode).toBe(0);
   168→    expect(result.stdout).toContain(`Linked task: @${testTaskUlid}`);
   169→  });
   170→
   171→  it('should error if task does not exist', async () => {
   172→    const result = kspec('workflow start @test-workflow --task @nonexistent', tempDir, { expectFail: true });
   173→
   174→    expect(result.exitCode).toBe(3); // NOT_FOUND
   175→    expect(result.stderr).toContain('Task not found');
