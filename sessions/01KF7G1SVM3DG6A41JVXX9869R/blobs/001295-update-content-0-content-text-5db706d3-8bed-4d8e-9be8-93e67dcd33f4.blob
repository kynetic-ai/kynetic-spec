   649→describe('Integration: meta_ref in tasks', () => {
   650→  let tempDir: string;
   651→
   652→  beforeEach(async () => {
   653→    tempDir = await setupTempFixtures();
   654→  });
   655→
   656→  afterEach(async () => {
   657→    await cleanupTempDir(tempDir);
   658→  });
   659→
   660→  // AC: @meta-ref ac-meta-ref-1
   661→  it('should create task with valid meta_ref to workflow', () => {
   662→    // AC-meta-ref-1: task add --meta-ref @workflow-id creates task with meta_ref field
   663→    const output = kspec('task add --title "Improve workflow" --meta-ref "@task-start"', tempDir);
   664→
   665→    // Should output "OK Created task: <ULID-prefix>"
   666→    expect(output).toMatch(/Created task: [A-Z0-9]{8}/);
   667→
   668→    // Verify task was created with meta_ref
   669→    const match = output.match(/Created task: ([A-Z0-9]{8})/);
   670→    const taskRef = match![1];
   671→
   672→    const task = kspecJson<any>(`task get @${taskRef}`, tempDir);
   673→    expect(task.meta_ref).toBe('@task-start');
   674→  });
   675→
   676→  // AC: @meta-ref ac-meta-ref-1
   677→  it('should create task with valid meta_ref to agent', () => {
   678→    const output = kspec('task add --title "Update agent capabilities" --meta-ref "@test-agent"', tempDir);
   679→    expect(output).toMatch(/Created task: [A-Z0-9]{8}/);
   680→
   681→    const match = output.match(/Created task: ([A-Z0-9]{8})/);
   682→    const taskRef = match![1];
   683→
   684→    const task = kspecJson<any>(`task get @${taskRef}`, tempDir);
   685→    expect(task.meta_ref).toBe('@test-agent');
   686→  });
   687→
   688→  // AC: @meta-ref ac-meta-ref-2
   689→  it('should filter tasks by meta_ref', () => {
   690→    // Create tasks with different meta_refs
   691→    kspec('task add --title "Task 1" --meta-ref "@task-start"', tempDir);
   692→    kspec('task add --title "Task 2" --meta-ref "@test-agent"', tempDir);
   693→    kspec('task add --title "Task 3" --meta-ref "@task-start"', tempDir);
   694→    kspec('task add --title "Task 4"', tempDir); // No meta_ref
   695→
   696→    // AC-meta-ref-2: tasks list --meta-ref @workflow filters by meta_ref
   697→    const tasks = kspecJson<any[]>('tasks list --meta-ref "@task-start"', tempDir);
   698→
   699→    // Should only include tasks with meta_ref = @task-start
   700→    const taskTitles = tasks.map(t => t.title);
   701→    expect(taskTitles).toContain('Task 1');
   702→    expect(taskTitles).toContain('Task 3');
   703→    expect(taskTitles).not.toContain('Task 2');
   704→    expect(taskTitles).not.toContain('Task 4');
   705→  });
   706→
   707→  // AC: @meta-ref ac-meta-ref-3
   708→  it('should error when meta_ref does not resolve', () => {
   709→    try {
   710→      const output = kspec('task add --title "Test task" --meta-ref "@invalid-ref-123456"', tempDir);
   711→      // AC-meta-ref-3: Should error with specific message
   712→      expect(output).toContain("meta_ref '@invalid-ref-123456' does not resolve to a valid meta item");
   713→    } catch (e: any) {
   714→      const stdout = e.message || '';
   715→      expect(stdout).toContain("meta_ref '@invalid-ref-123456' does not resolve to a valid meta item");
   716→    }
   717→  });
   718→
   719→  // AC: @meta-ref ac-meta-ref-4
   720→  it('should error when meta_ref points to spec item', () => {
   721→    try {
   722→      // test-feature is a spec item, not a meta item
   723→      const output = kspec('task add --title "Test task" --meta-ref "@test-feature"', tempDir);
   724→      // AC-meta-ref-4: Should error with specific message
   725→      expect(output).toContain("meta_ref '@test-feature' points to a spec item; use --spec-ref for product spec references");
   726→    } catch (e: any) {
   727→      const stdout = e.message || '';
   728→      expect(stdout).toContain("meta_ref '@test-feature' points to a spec item; use --spec-ref for product spec references");
   729→    }
   730→  });
   731→
   732→  it('should update task meta_ref with task set', () => {
   733→    // Create task without meta_ref
   734→    const createOutput = kspec('task add --title "Test task"', tempDir);
   735→    const match = createOutput.match(/Created task: ([A-Z0-9]{8})/);
   736→    const taskRef = match![1];
   737→
   738→    // Update with meta_ref
   739→    kspec(`task set @${taskRef} --meta-ref "@task-start"`, tempDir);
   740→
   741→    // Verify update
   742→    const task = kspecJson<any>(`task get @${taskRef}`, tempDir);
   743→    expect(task.meta_ref).toBe('@task-start');
   744→  });
   745→
   746→  it('should validate meta_ref in task set', () => {
   747→    // Create task
   748→    const createOutput = kspec('task add --title "Test task"', tempDir);
   749→    const match = createOutput.match(/Created task: ([A-Z0-9]{8})/);
   750→    const taskRef = match![1];
   751→
   752→    // Try to set invalid meta_ref
   753→    try {
   754→      const output = kspec(`task set @${taskRef} --meta-ref "@invalid-workflow"`, tempDir);
   755→      expect(output).toContain("meta_ref '@invalid-workflow' does not resolve to a valid meta item");
   756→    } catch (e: any) {
   757→      const stdout = e.message || '';
   758→      expect(stdout).toContain("meta_ref '@invalid-workflow' does not resolve to a valid meta item");
   759→    }
   760→  });
   761→});
