   418→describe('Integration: meta observations', () => {
   419→  let tempDir: string;
   420→
   421→  beforeEach(async () => {
   422→    tempDir = await setupTempFixtures();
   423→  });
   424→
   425→  afterEach(async () => {
   426→    await cleanupTempDir(tempDir);
   427→  });
   428→
   429→  // AC: @observations ac-obs-1
   430→  it('should create an observation with correct fields', () => {
   431→    const output = kspec('meta observe friction "CLI output is too verbose"', tempDir);
   432→
   433→    // AC-obs-1: Should output "OK Created observation: <ULID-prefix>"
   434→    expect(output).toMatch(/Created observation: [A-Z0-9]{8}/);
   435→
   436→    // Verify observation was saved
   437→    const observations = kspecJson<any[]>('meta observations', tempDir);
   438→    const newObs = observations.find(o => o.content === 'CLI output is too verbose');
   439→
   440→    expect(newObs).toBeDefined();
   441→    expect(newObs.type).toBe('friction');
   442→    expect(newObs.created_at).toBeDefined();
   443→    expect(newObs.author).toBeDefined();
   444→    expect(newObs.resolved).toBe(false);
   445→  });
   446→
   447→  // AC: @observations ac-obs-1
   448→  it('should create observation with workflow reference', () => {
   449→    const output = kspec('meta observe success "Tests caught a bug" --workflow "@task-start"', tempDir);
   450→    expect(output).toMatch(/Created observation: [A-Z0-9]{8}/);
   451→
   452→    const observations = kspecJson<any[]>('meta observations', tempDir);
   453→    const newObs = observations.find(o => o.content === 'Tests caught a bug');
   454→
   455→    expect(newObs).toBeDefined();
   456→    expect(newObs.workflow_ref).toBe('@task-start');
   457→  });
   458→
   459→  // AC: @observations ac-obs-2
   460→  it('should list unresolved observations by default', () => {
   461→    // Create some observations
   462→    kspec('meta observe friction "Problem 1"', tempDir);
   463→    kspec('meta observe success "Good thing"', tempDir);
   464→
   465→    const output = kspec('meta observations', tempDir);
   466→
   467→    // Should contain table headers
   468→    expect(output).toContain('ID');
   469→    expect(output).toContain('Type');
   470→    expect(output).toContain('Workflow');
   471→    expect(output).toContain('Created');
   472→    expect(output).toContain('Content');
   473→
   474→    // Should contain observation data
   475→    expect(output).toContain('friction');
   476→    expect(output).toContain('Problem 1');
   477→    expect(output).toContain('success');
   478→    expect(output).toContain('Good thing');
   479→  });
   480→
   481→  // AC: @observations ac-obs-2
   482→  it('should show only unresolved observations by default', async () => {
   483→    // Create and resolve an observation
   484→    const createOutput = kspec('meta observe friction "This will be resolved"', tempDir);
   485→    const match = createOutput.match(/Created observation: ([A-Z0-9]{8})/);
   486→    expect(match).not.toBeNull();
   487→    const obsRef = match![1];
   488→
   489→    kspec(`meta resolve @${obsRef} "Fixed it"`, tempDir);
   490→
   491→    // List without --all should not show resolved
   492→    const output = kspec('meta observations', tempDir);
   493→    expect(output).not.toContain('This will be resolved');
   494→
   495→    // List with --all should show resolved
   496→    const outputAll = kspec('meta observations --all', tempDir);
   497→    expect(outputAll).toContain('This will be resolved');
   498→  });
   499→
   500→  // AC: @observations ac-obs-5
   501→  it('should output JSON with full observation objects', () => {
   502→    kspec('meta observe friction "Test observation"', tempDir);
   503→
   504→    const observations = kspecJson<any[]>('meta observations', tempDir);
   505→
   506→    // Should be an array
   507→    expect(Array.isArray(observations)).toBe(true);
   508→
   509→    const testObs = observations.find(o => o.content === 'Test observation');
   510→    expect(testObs).toBeDefined();
   511→
   512→    // Should have all fields
   513→    expect(testObs._ulid).toBeDefined();
   514→    expect(testObs.type).toBe('friction');
   515→    expect(testObs.content).toBe('Test observation');
   516→    expect(testObs.created_at).toBeDefined();
   517→    expect(testObs.author).toBeDefined();
   518→    expect(testObs.resolved).toBe(false);
   519→    expect(testObs).toHaveProperty('resolution');
   520→    expect(testObs).toHaveProperty('resolved_at');
   521→    expect(testObs).toHaveProperty('resolved_by');
   522→    expect(testObs).toHaveProperty('promoted_to');
   523→  });
   524→
   525→  // AC: @observations ac-obs-3
   526→  it('should promote observation to task', () => {
   527→    // Create observation
   528→    const createOutput = kspec('meta observe friction "Need better error messages" --workflow "@task-start"', tempDir);
   529→    const match = createOutput.match(/Created observation: ([A-Z0-9]{8})/);
   530→    const obsRef = match![1];
   531→
   532→    // Promote to task
   533→    const promoteOutput = kspec(`meta promote @${obsRef} --title "Improve error messages"`, tempDir);
   534→
   535→    // AC-obs-3: Should output "OK Created task: <ULID-prefix>"
   536→    expect(promoteOutput).toMatch(/Created task: @[A-Z0-9]{8}/);
   537→
   538→    // Verify observation was updated with promoted_to
   539→    const observations = kspecJson<any[]>('meta observations', tempDir);
   540→    const obs = observations.find(o => o._ulid.startsWith(obsRef));
   541→    expect(obs.promoted_to).toBeDefined();
   542→    expect(obs.promoted_to).toMatch(/@[A-Z0-9]{8}/);
   543→  });
   544→
   545→  // AC: @observations ac-obs-6
   546→  it('should error when promoting already-promoted observation', () => {
   547→    // Create and promote observation
   548→    const createOutput = kspec('meta observe friction "Test promotion"', tempDir);
   549→    const match = createOutput.match(/Created observation: ([A-Z0-9]{8})/);
   550→    const obsRef = match![1];
   551→
   552→    kspec(`meta promote @${obsRef} --title "First promotion"`, tempDir);
   553→
   554→    // Try to promote again - should fail
