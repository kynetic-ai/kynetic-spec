   253→
   254→  // AC: @workflow-definitions ac-workflow-2
   255→  it('should output verbose format with full step details', () => {
   256→    const output = kspec('meta workflows --verbose', tempDir);
   257→
   258→    // Should contain workflow headers
   259→    expect(output).toContain('task-start - Before starting a task');
   260→    expect(output).toContain('Pre-task checklist workflow');
   261→
   262→    // Should contain step type prefixes
   263→    expect(output).toContain('[check]');
   264→    expect(output).toContain('[action]');
   265→    expect(output).toContain('[decision]');
   266→
   267→    // Should contain step content
   268→    expect(output).toContain('Read the spec item linked to the task');
   269→    expect(output).toContain('Verify all dependencies are completed');
   270→    expect(output).toContain('Add initial note documenting approach');
   271→
   272→    // Should contain on_fail for checks
   273→    expect(output).toContain('on fail: Cannot proceed without spec context');
   274→    expect(output).toContain('on fail: Block task and note missing dependencies');
   275→
   276→    // Should contain decision options
   277→    expect(output).toContain('Does this need plan mode?');
   278→    expect(output).toContain('Yes - enter plan mode');
   279→    expect(output).toContain('No - proceed with implementation');
   280→
   281→    // Should contain second workflow
   282→    expect(output).toContain('commit - After completing a task');
   283→    expect(output).toContain('All tests passing');
   284→    expect(output).toContain('on fail: Fix failing tests before committing');
   285→  });
   286→
   287→  // AC: @workflow-definitions ac-workflow-4
   288→  it('should output JSON array with full workflow details', () => {
   289→    interface WorkflowJson {
   290→      id: string;
   291→      trigger: string;
   292→      description: string;
   293→      steps: Array<{
   294→        type: string;
   295→        content: string;
   296→        on_fail?: string;
   297→        options?: string[];
   298→      }>;
   299→    }
   300→
   301→    const workflows = kspecJson<WorkflowJson[]>('meta workflows', tempDir);
   302→
   303→    // Should be an array with 2 workflows
   304→    expect(Array.isArray(workflows)).toBe(true);
   305→    expect(workflows).toHaveLength(2);
   306→
   307→    // First workflow
   308→    const taskStart = workflows.find(w => w.id === 'task-start');
   309→    expect(taskStart).toBeDefined();
   310→    expect(taskStart?.trigger).toBe('Before starting a task');
   311→    expect(taskStart?.description).toBe('Pre-task checklist workflow');
   312→    expect(taskStart?.steps).toHaveLength(4);
   313→
   314→    // Check step details
   315→    const firstStep = taskStart?.steps[0];
   316→    expect(firstStep?.type).toBe('check');
   317→    expect(firstStep?.content).toBe('Read the spec item linked to the task');
   318→    expect(firstStep?.on_fail).toBe('Cannot proceed without spec context');
   319→
   320→    const decisionStep = taskStart?.steps[3];
   321→    expect(decisionStep?.type).toBe('decision');
   322→    expect(decisionStep?.content).toBe('Does this need plan mode?');
   323→    expect(decisionStep?.options).toEqual([
   324→      'Yes - enter plan mode',
   325→      'No - proceed with implementation',
   326→    ]);
   327→
   328→    // Second workflow
   329→    const commit = workflows.find(w => w.id === 'commit');
   330→    expect(commit).toBeDefined();
   331→    expect(commit?.trigger).toBe('After completing a task');
   332→    expect(commit?.steps).toHaveLength(3);
   333→  });
   334→
   335→  it('should handle empty workflows list gracefully', async () => {
   336→    // Create a meta manifest with no workflows
   337→    const emptyMetaPath = path.join(tempDir, 'kynetic.meta.yaml');
   338→    await fs.writeFile(emptyMetaPath, 'kynetic_meta: "1.0"\nworkflows: []\n');
   339→
