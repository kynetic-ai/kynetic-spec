```
     1→/**
     2→ * Session management commands
     3→ *
     4→ * Provides context for starting/resuming work sessions.
     5→ */
     6→
     7→import { Command } from 'commander';
     8→import chalk from 'chalk';
     9→import {
    10→  initContext,
    11→  loadAllTasks,
    12→  loadAllItems,
    13→  loadInboxItems,
    14→  getReadyTasks,
    15→  ReferenceIndex,
    16→  type LoadedTask,
    17→  type LoadedInboxItem,
    18→  type KspecContext,
    19→} from '../../parser/index.js';
    20→import { output, error, info, isJsonMode } from '../output.js';
    21→import { sessionHeaders, hints, sessionPrompt } from '../../strings/index.js';
    22→import {
    23→  parseTimeSpec,
    24→  formatRelativeTime,
    25→  isGitRepo,
    26→  getRecentCommits,
    27→  getCurrentBranch,
    28→  getWorkingTreeStatus,
    29→  formatCommitGuidance,
    30→  type GitCommit,
    31→  type GitWorkingTree,
    32→} from '../../utils/index.js';
    33→import { shadowPull, type ShadowSyncResult } from '../../parser/shadow.js';
    34→import type { Note, Todo } from '../../schema/index.js';
    35→
    36→// ─── Types ───────────────────────────────────────────────────────────────────
    37→
    38→export interface CheckpointResult {
    39→  /** Whether session can end cleanly */
    40→  ok: boolean;
    41→
    42→  /** Human-readable message for Claude Code */
    43→  message: string;
    44→
    45→  /** Issues that need attention before stopping */
    46→  issues: CheckpointIssue[];
    47→
    48→  /** Instructions for the agent */
    49→  instructions: string[];
    50→}
    51→
    52→export interface CheckpointIssue {
    53→  type: 'uncommitted_changes' | 'in_progress_task' | 'incomplete_todo';
    54→  description: string;
    55→  details?: Record<string, unknown>;
    56→}
    57→
    58→export interface SessionContext {
    59→  /** When this context was generated */
    60→  generated_at: string;
    61→
    62→  /** Current git branch */
    63→  branch: string | null;
    64→
    65→  /** Tasks currently in progress */
    66→  active_tasks: ActiveTaskSummary[];
    67→
    68→  /** Recent notes from active tasks */
    69→  recent_notes: NoteSummary[];
    70→
    71→  /** Incomplete todos from active tasks */
    72→  active_todos: TodoSummary[];
    73→
    74→  /** Tasks ready to be picked up */
    75→  ready_tasks: ReadyTaskSummary[];
    76→
    77→  /** Blocked tasks with blockers */
    78→  blocked_tasks: BlockedTaskSummary[];
    79→
    80→  /** Recently completed tasks */
    81→  recently_completed: CompletedTaskSummary[];
    82→
    83→  /** Recent git commits */
    84→  recent_commits: CommitSummary[];
    85→
    86→  /** Working tree status */
    87→  working_tree: GitWorkingTree | null;
    88→
    89→  /** Inbox items awaiting triage (oldest first) */
    90→  inbox_items: InboxSummary[];
    91→
    92→  /** Summary statistics */
    93→  stats: SessionStats;
    94→}
    95→
    96→export interface ActiveTaskSummary {
    97→  ref: string;
    98→  title: string;
    99→  started_at: string | null;
   100→  priority: number;
   101→  spec_ref: string | null;
   102→  note_count: number;
   103→  last_note_at: string | null;
   104→  todo_count: number;
   105→  incomplete_todos: number;
   106→}
   107→
   108→export interface NoteSummary {
   109→  task_ref: string;
   110→  task_title: string;
   111→  note_ulid: string;
   112→  created_at: string;
   113→  author: string | null;
   114→  content: string;
   115→}
   116→
   117→export interface TodoSummary {
   118→  task_ref: string;
   119→  task_title: string;
   120→  id: number;
   121→  text: string;
   122→  added_at: string;
   123→  added_by: string | null;
   124→}
   125→
   126→export interface ReadyTaskSummary {
   127→  ref: string;
   128→  title: string;
   129→  priority: number;
   130→  spec_ref: string | null;
   131→  tags: string[];
   132→}
   133→
   134→export interface BlockedTaskSummary {
   135→  ref: string;
   136→  title: string;
   137→  blocked_by: string[];
   138→  unmet_deps: string[];
   139→}
   140→
   141→export interface CompletedTaskSummary {
   142→  ref: string;
   143→  title: string;
   144→  completed_at: string;
   145→  closed_reason: string | null;
   146→}
   147→
   148→export interface CommitSummary {
   149→  hash: string;
   150→  full_hash: string;
   151→  date: string;
   152→  message: string;
   153→  author: string;
   154→}
   155→
   156→export interface SessionStats {
   157→  total_tasks: number;
   158→  in_progress: number;
   159→  ready: number;
   160→  blocked: number;
   161→  completed: number;
   162→  inbox_items: number;
   163→}
   164→
   165→export interface InboxSummary {
   166→  ref: string;
   167→  text: string;
   168→  created_at: string;
   169→  tags: string[];
   170→  added_by: string | null;
   171→}
   172→
   173→export interface SessionOptions {
   174→  brief?: boolean;
   175→  full?: boolean;
   176→  since?: string;
   177→  git?: boolean;
   178→  limit?: string;
   179→}
   180→
   181→// ─── Data Gathering ──────────────────────────────────────────────────────────
   182→
   183→function toActiveTaskSummary(
   184→  task: LoadedTask,
   185→  index: ReferenceIndex
   186→): ActiveTaskSummary {
   187→  const lastNote =
   188→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   189→  const incompleteTodos = task.todos.filter(t => !t.done).length;
   190→  return {
   191→    ref: index.shortUlid(task._ulid),
   192→    title: task.title,
   193→    started_at: task.started_at || null,
   194→    priority: task.priority,
   195→    spec_ref: task.spec_ref || null,
   196→    note_count: task.notes.length,
   197→    last_note_at: lastNote ? lastNote.created_at : null,
   198→    todo_count: task.todos.length,
   199→    incomplete_todos: incompleteTodos,
   200→  };
   201→}
   202→
   203→function toReadyTaskSummary(
   204→  task: LoadedTask,
   205→  index: ReferenceIndex
   206→): ReadyTaskSummary {
   207→  return {
   208→    ref: index.shortUlid(task._ulid),
   209→    title: task.title,
   210→    priority: task.priority,
   211→    spec_ref: task.spec_ref || null,
   212→    tags: task.tags,
   213→  };
   214→}
   215→
   216→function toBlockedTaskSummary(
   217→  task: LoadedTask,
   218→  allTasks: LoadedTask[],
   219→  index: ReferenceIndex
   220→): BlockedTaskSummary {
   221→  // Find unmet dependencies
   222→  const unmetDeps: string[] = [];
   223→  for (const depRef of task.depends_on) {
   224→    const result = index.resolve(depRef);
   225→    if (result.ok) {
   226→      const depItem = result.item;
   227→      if ('status' in depItem && depItem.status !== 'completed') {
   228→        unmetDeps.push(depRef);
   229→      }
   230→    }
   231→  }
   232→
   233→  return {
   234→    ref: index.shortUlid(task._ulid),
   235→    title: task.title,
   236→    blocked_by: task.blocked_by,
   237→    unmet_deps: unmetDeps,
   238→  };
   239→}
   240→
   241→function toCompletedTaskSummary(
   242→  task: LoadedTask,
   243→  index: ReferenceIndex
   244→): CompletedTaskSummary {
   245→  return {
   246→    ref: index.shortUlid(task._ulid),
   247→    title: task.title,
   248→    completed_at: task.completed_at || '',
   249→    closed_reason: task.closed_reason || null,
   250→  };
   251→}
   252→
   253→function collectRecentNotes(
   254→  tasks: LoadedTask[],
   255→  index: ReferenceIndex,
   256→  options: { limit: number; since: Date | null }
   257→): NoteSummary[] {
   258→  const allNotes: NoteSummary[] = [];
   259→
   260→  for (const task of tasks) {
   261→    for (const note of task.notes) {
   262→      const noteDate = new Date(note.created_at);
   263→
   264→      // Filter by since date if provided
   265→      if (options.since && noteDate < options.since) {
   266→        continue;
   267→      }
   268→
   269→      allNotes.push({
   270→        task_ref: index.shortUlid(task._ulid),
   271→        task_title: task.title,
   272→        note_ulid: note._ulid.slice(0, 8),
   273→        created_at: note.created_at,
   274→        author: note.author || null,
   275→        content: note.content,
   276→      });
   277→    }
   278→  }
   279→
   280→  // Sort by date descending, take limit
   281→  return allNotes
   282→    .sort(
   283→      (a, b) =>
   284→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
   285→    )
   286→    .slice(0, options.limit);
   287→}
   288→
   289→function collectIncompleteTodos(
   290→  tasks: LoadedTask[],
   291→  index: ReferenceIndex,
   292→  options: { limit: number }
   293→): TodoSummary[] {
   294→  const allTodos: TodoSummary[] = [];
   295→
   296→  for (const task of tasks) {
   297→    for (const todo of task.todos) {
   298→      // Only include incomplete todos
   299→      if (todo.done) continue;
   300→
   301→      allTodos.push({
   302→        task_ref: index.shortUlid(task._ulid),
   303→        task_title: task.title,
   304→        id: todo.id,
   305→        text: todo.text,
   306→        added_at: todo.added_at,
   307→        added_by: todo.added_by || null,
   308→      });
   309→    }
   310→  }
   311→
   312→  // Sort by added_at descending (most recent first), take limit
   313→  return allTodos
   314→    .sort(
   315→      (a, b) =>
   316→        new Date(b.added_at).getTime() - new Date(a.added_at).getTime()
   317→    )
   318→    .slice(0, options.limit);
   319→}
   320→
   321→/**
   322→ * Gather session context data
   323→ */
   324→export async function gatherSessionContext(
   325→  ctx: KspecContext,
   326→  options: SessionOptions
   327→): Promise<SessionContext> {
   328→  const limit = parseInt(options.limit || '5', 10);
   329→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   330→  const showGit = options.git !== false; // default true
   331→
   332→  // Load all data
   333→  const allTasks = await loadAllTasks(ctx);
   334→  const items = await loadAllItems(ctx);
   335→  const inboxItems = await loadInboxItems(ctx);
   336→  const index = new ReferenceIndex(allTasks, items);
   337→
   338→  // Compute stats
   339→  const stats: SessionStats = {
   340→    total_tasks: allTasks.length,
   341→    in_progress: allTasks.filter((t) => t.status === 'in_progress').length,
   342→    ready: getReadyTasks(allTasks).length,
   343→    blocked: allTasks.filter((t) => t.status === 'blocked').length,
   344→    completed: allTasks.filter((t) => t.status === 'completed').length,
   345→    inbox_items: inboxItems.length,
   346→  };
   347→
   348→  // Get active tasks
   349→  const activeTasks = allTasks
   350→    .filter((t) => t.status === 'in_progress')
   351→    .sort((a, b) => a.priority - b.priority)
   352→    .slice(0, options.full ? undefined : limit)
   353→    .map((t) => toActiveTaskSummary(t, index));
   354→
   355→  // Get recent notes from active tasks
   356→  const recentNotes = collectRecentNotes(
   357→    allTasks.filter((t) => t.status === 'in_progress'),
   358→    index,
   359→    { limit: options.full ? limit * 2 : limit, since: sinceDate }
   360→  );
   361→
   362→  // Get incomplete todos from active tasks
   363→  const activeTodos = collectIncompleteTodos(
   364→    allTasks.filter((t) => t.status === 'in_progress'),
   365→    index,
   366→    { limit: options.full ? limit * 2 : limit }
   367→  );
   368→
   369→  // Get ready tasks
   370→  const readyTasks = getReadyTasks(allTasks)
   371→    .slice(0, options.full ? undefined : limit)
   372→    .map((t) => toReadyTaskSummary(t, index));
   373→
   374→  // Get blocked tasks
   375→  const blockedTasks = allTasks
   376→    .filter((t) => t.status === 'blocked')
   377→    .slice(0, options.full ? undefined : limit)
   378→    .map((t) => toBlockedTaskSummary(t, allTasks, index));
   379→
   380→  // Get recently completed tasks
   381→  const recentlyCompleted = allTasks
   382→    .filter((t) => {
   383→      if (t.status !== 'completed' || !t.completed_at) return false;
   384→      const completedDate = new Date(t.completed_at);
   385→      if (sinceDate && completedDate < sinceDate) return false;
   386→      return true;
   387→    })
   388→    .sort((a, b) => {
   389→      // Sort by completed_at descending (most recent first)
   390→      const aDate = new Date(a.completed_at || 0);
   391→      const bDate = new Date(b.completed_at || 0);
   392→      return bDate.getTime() - aDate.getTime();
   393→    })
   394→    .slice(0, options.full ? undefined : limit)
   395→    .map((t) => toCompletedTaskSummary(t, index));
   396→
   397→  // Get git info
   398→  let branch: string | null = null;
   399→  let recentCommits: CommitSummary[] = [];
   400→  let workingTree: GitWorkingTree | null = null;
   401→
   402→  if (showGit && isGitRepo(ctx.rootDir)) {
   403→    branch = getCurrentBranch(ctx.rootDir);
   404→
   405→    const commits = getRecentCommits({
   406→      limit: options.full ? limit * 2 : limit,
   407→      since: sinceDate || undefined,
   408→      cwd: ctx.rootDir,
   409→    });
   410→
   411→    recentCommits = commits.map((c) => ({
   412→      hash: c.hash,
   413→      full_hash: c.fullHash,
   414→      date: c.date.toISOString(),
   415→      message: c.message,
   416→      author: c.author,
   417→    }));
   418→
   419→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   420→  }
   421→
   422→  // Get inbox items (oldest first to encourage triage)
   423→  const inboxSummaries: InboxSummary[] = inboxItems
   424→    .sort((a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime())
   425→    .slice(0, options.full ? undefined : limit)
   426→    .map((item) => ({
   427→      ref: item._ulid.slice(0, 8),
   428→      text: item.text,
   429→      created_at: item.created_at,
   430→      tags: item.tags,
   431→      added_by: item.added_by || null,
   432→    }));
   433→
   434→  return {
   435→    generated_at: new Date().toISOString(),
   436→    branch,
   437→    active_tasks: activeTasks,
   438→    recent_notes: recentNotes,
   439→    active_todos: activeTodos,
   440→    ready_tasks: readyTasks,
   441→    blocked_tasks: blockedTasks,
   442→    recently_completed: recentlyCompleted,
   443→    recent_commits: recentCommits,
   444→    working_tree: workingTree,
   445→    inbox_items: inboxSummaries,
   446→    stats,
   447→  };
   448→}
   449→
   450→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   451→
   452→export interface CheckpointOptions {
   453→  force?: boolean;
   454→  /** Set when stop hook is already active (retry after previous block) */
   455→  stopHookActive?: boolean;
   456→}
   457→
   458→/** Claude Code hook input for Stop hooks */
   459→export interface StopHookInput {
   460→  session_id?: string;
   461→  transcript_path?: string;
   462→  hook_event_name?: string;
   463→  stop_hook_active?: boolean;
   464→}
   465→
   466→/**
   467→ * Perform session checkpoint - check for uncommitted work before ending session.
   468→ *
   469→ * This is designed for use as a Claude Code stop hook. It checks for:
   470→ * - Uncommitted git changes (staged, unstaged, untracked)
   471→ * - Tasks in in_progress status
   472→ * - Incomplete todos on active tasks
   473→ *
   474→ * Returns a structured result indicating whether the session can end cleanly.
   475→ */
   476→export async function performCheckpoint(
   477→  ctx: KspecContext,
   478→  options: CheckpointOptions
   479→): Promise<CheckpointResult> {
   480→  const issues: CheckpointIssue[] = [];
   481→  const instructions: string[] = [];
   482→
   483→  // Load tasks
   484→  const allTasks = await loadAllTasks(ctx);
   485→
   486→  // Check for in-progress tasks
   487→  const inProgressTasks = allTasks.filter((t) => t.status === 'in_progress');
   488→  for (const task of inProgressTasks) {
   489→    const ref = task.slugs[0] ? `@${task.slugs[0]}` : `@${task._ulid.slice(0, 8)}`;
   490→    issues.push({
   491→      type: 'in_progress_task',
   492→      description: `Task ${ref} is still in progress: ${task.title}`,
   493→      details: {
   494→        ref,
   495→        title: task.title,
   496→        started_at: task.started_at,
   497→      },
   498→    });
   499→
   500→    // Check for incomplete todos on this task
   501→    const incompleteTodos = task.todos.filter((t) => !t.done);
   502→    for (const todo of incompleteTodos) {
   503→      issues.push({
   504→        type: 'incomplete_todo',
   505→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   506→        details: {
   507→          task_ref: ref,
   508→          todo_id: todo.id,
   509→          text: todo.text,
   510→        },
   511→      });
   512→    }
   513→  }
   514→
   515→  // Check for uncommitted git changes
   516→  if (isGitRepo(ctx.rootDir)) {
   517→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   518→    if (!workingTree.clean) {
   519→      const changeCount =
   520→        workingTree.staged.length +
   521→        workingTree.unstaged.length +
   522→        workingTree.untracked.length;
   523→
   524→      issues.push({
   525→        type: 'uncommitted_changes',
   526→        description: `${changeCount} uncommitted changes in working tree`,
   527→        details: {
   528→          staged: workingTree.staged.length,
   529→          unstaged: workingTree.unstaged.length,
   530→          untracked: workingTree.untracked.length,
   531→        },
   532→      });
   533→    }
   534→  }
   535→
   536→  // Build instructions based on issues
   537→  if (issues.length > 0 && !options.force) {
   538→    instructions.push('Before ending this session, please:');
   539→
   540→    const hasInProgress = issues.some((i) => i.type === 'in_progress_task');
   541→    const hasUncommitted = issues.some((i) => i.type === 'uncommitted_changes');
   542→    const hasIncompleteTodos = issues.some((i) => i.type === 'incomplete_todo');
   543→
   544→    let step = 1;
   545→
   546→    if (hasInProgress) {
   547→      instructions.push(
   548→        `${step++}. Add notes to in-progress tasks documenting current state`
   549→      );
   550→      instructions.push(
   551→        `${step++}. Either complete the tasks or leave them in_progress with clear notes for next session`
   552→      );
   553→    }
   554→
   555→    if (hasIncompleteTodos) {
   556→      instructions.push(
   557→        `${step++}. Complete or acknowledge incomplete todos on active tasks`
   558→      );
   559→    }
   560→
   561→    if (hasUncommitted) {
   562→      instructions.push(`${step++}. Commit your changes with a descriptive message`);
   563→
   564→      // Add WIP commit guidance if there are in-progress tasks
   565→      if (inProgressTasks.length > 0) {
   566→        const task = inProgressTasks[0];
   567→        const guidance = formatCommitGuidance(task, { wip: true });
   568→        instructions.push('');
   569→        instructions.push('Suggested WIP commit:');
   570→        instructions.push(`  ${guidance.message}`);
   571→        instructions.push('');
   572→        for (const trailer of guidance.trailers) {
   573→          instructions.push(`  ${trailer}`);
   574→        }
   575→      }
   576→    }
   577→
   578→    instructions.push('');
   579→    instructions.push(
   580→      'Use: kspec task note @task "Progress notes..." to document state'
   581→    );
   582→    instructions.push(
   583→      'Use: kspec task complete @task --reason "Summary" if task is done'
   584→    );
   585→  }
   586→
   587→  // Allow stop if:
   588→  // - No issues found
   589→  // - --force flag passed
   590→  // - This is a retry (stop_hook_active = true from previous block)
   591→  const isRetry = options.stopHookActive === true;
   592→  const ok = issues.length === 0 || options.force === true || isRetry;
   593→
   594→  let message: string;
   595→  if (isRetry && issues.length > 0) {
   596→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   597→  } else if (ok) {
   598→    message = '[kspec] Session checkpoint passed - ready to end session';
   599→  } else {
   600→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   601→  }
   602→
   603→  return {
   604→    ok,
   605→    message,
   606→    issues,
   607→    instructions,
   608→  };
   609→}
   610→
   611→// ─── Output Formatting ───────────────────────────────────────────────────────
   612→
   613→function formatCheckpointResult(result: CheckpointResult): void {
   614→  if (result.ok) {
   615→    console.log(chalk.green(result.message));
   616→  } else {
   617→    console.log(chalk.yellow(result.message));
   618→    console.log('');
   619→
   620→    for (const issue of result.issues) {
   621→      const icon =
   622→        issue.type === 'uncommitted_changes'
   623→          ? chalk.yellow('⚠')
   624→          : issue.type === 'in_progress_task'
   625→            ? chalk.blue('●')
   626→            : chalk.gray('○');
   627→      console.log(`  ${icon} ${issue.description}`);
   628→    }
   629→
   630→    if (result.instructions.length > 0) {
   631→      console.log('');
   632→      for (const instruction of result.instructions) {
   633→        console.log(chalk.gray(instruction));
   634→      }
   635→    }
   636→  }
   637→}
   638→
   639→function formatSessionContext(ctx: SessionContext, options: SessionOptions): void {
   640→  const isBrief = !options.full;
   641→
   642→  // Header
   643→  console.log(`\n${sessionHeaders.title}`);
   644→  const age = formatRelativeTime(new Date(ctx.generated_at));
   645→  if (ctx.branch) {
   646→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   647→  } else {
   648→    console.log(chalk.gray(`Generated: ${age}`));
   649→  }
   650→
   651→  // Stats summary
   652→  const inboxNote = ctx.stats.inbox_items > 0
   653→    ? ` | Inbox: ${ctx.stats.inbox_items}`
   654→    : '';
   655→  console.log(
   656→    chalk.gray(
   657→      `Tasks: ${ctx.stats.in_progress} active, ${ctx.stats.ready} ready, ` +
   658→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`
   659→    )
   660→  );
   661→
   662→  // Active tasks section
   663→  if (ctx.active_tasks.length > 0) {
   664→    console.log(`\n${sessionHeaders.activeWork}`);
   665→    for (const task of ctx.active_tasks) {
   666→      const started = task.started_at
   667→        ? chalk.gray(` (started ${formatRelativeTime(new Date(task.started_at))})`)
   668→        : '';
   669→      const priority =
   670→        task.priority <= 2
   671→          ? chalk.red(`P${task.priority}`)
   672→          : chalk.gray(`P${task.priority}`);
   673→      console.log(
   674→        `  ${chalk.blue('[in_progress]')} ${priority} ${task.ref} ${task.title}${started}`
   675→      );
   676→    }
   677→  } else {
   678→    console.log(`\n${sessionHeaders.noActiveWork}`);
   679→  }
   680→
   681→  // Recently completed section
   682→  if (ctx.recently_completed.length > 0) {
   683→    console.log(`\n${sessionHeaders.recentlyCompleted}`);
   684→    for (const task of ctx.recently_completed) {
   685→      const completedAge = formatRelativeTime(new Date(task.completed_at));
   686→      let reason = '';
   687→      if (task.closed_reason) {
   688→        const maxLen = isBrief ? 60 : 120;
   689→        const truncated = task.closed_reason.length > maxLen
   690→          ? task.closed_reason.slice(0, maxLen).trim() + '...'
   691→          : task.closed_reason;
   692→        reason = chalk.gray(` - ${truncated}`);
   693→      }
   694→      console.log(
   695→        `  ${chalk.green('[completed]')} ${task.ref} ${task.title} ${chalk.gray(`(${completedAge})`)}${reason}`
   696→      );
   697→    }
   698→  }
   699→
   700→  // Recent notes section
   701→  if (ctx.recent_notes.length > 0) {
   702→    console.log(`\n${sessionHeaders.recentNotes}`);
   703→    for (const note of ctx.recent_notes) {
   704→      const age = formatRelativeTime(new Date(note.created_at));
   705→      const author = note.author ? chalk.gray(` by ${note.author}`) : '';
   706→      console.log(`  ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
   707→
   708→      // Truncate content in brief mode
   709→      let content = note.content.trim();
   710→      if (isBrief && content.length > 200) {
   711→        content = content.slice(0, 200).trim() + '...';
   712→      }
   713→
   714→      // Indent content, limit lines in brief mode
   715→      const lines = content.split('\n');
   716→      const maxLines = isBrief ? 3 : lines.length;
   717→      for (const line of lines.slice(0, maxLines)) {
   718→        console.log(`    ${chalk.white(line)}`);
   719→      }
   720→      if (isBrief && lines.length > maxLines) {
   721→        console.log(chalk.gray(`    ... (${lines.length - maxLines} more lines)`));
   722→      }
   723→    }
   724→  }
   725→
   726→  // Incomplete todos section
   727→  if (ctx.active_todos.length > 0) {
   728→    console.log(`\n${sessionHeaders.incompleteTodos}`);
   729→    for (const todo of ctx.active_todos) {
   730→      console.log(`  ${chalk.yellow('[ ]')} ${todo.task_ref}#${todo.id}: ${todo.text}`);
   731→    }
   732→  }
   733→
   734→  // Ready tasks section
   735→  if (ctx.ready_tasks.length > 0) {
   736→    console.log(`\n${sessionHeaders.readyTasks}`);
   737→    for (const task of ctx.ready_tasks) {
   738→      const priority =
   739→        task.priority <= 2
   740→          ? chalk.red(`P${task.priority}`)
   741→          : chalk.gray(`P${task.priority}`);
   742→      const tags =
   743→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(' #')}`) : '';
   744→      console.log(`  ${priority} ${task.ref} ${task.title}${tags}`);
   745→    }
   746→  }
   747→
   748→  // Blocked tasks section
   749→  if (ctx.blocked_tasks.length > 0) {
   750→    console.log(`\n${sessionHeaders.blocked}`);
   751→    for (const task of ctx.blocked_tasks) {
   752→      console.log(`  ${chalk.red('[blocked]')} ${task.ref} ${task.title}`);
   753→      if (task.blocked_by.length > 0) {
   754→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(', ')}`));
   755→      }
   756→      if (task.unmet_deps.length > 0) {
   757→        console.log(chalk.gray(`    Waiting on: ${task.unmet_deps.join(', ')}`));
   758→      }
   759→    }
   760→  }
   761→
   762→  // Git commits section
   763→  if (ctx.recent_commits.length > 0) {
   764→    console.log(`\n${sessionHeaders.recentCommits}`);
   765→    for (const commit of ctx.recent_commits) {
   766→      const age = formatRelativeTime(new Date(commit.date));
   767→      console.log(
   768→        `  ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${age}, ${commit.author})`)}`
   769→      );
   770→    }
   771→  }
   772→
   773→  // Inbox section (oldest first to encourage triage)
   774→  if (ctx.inbox_items.length > 0) {
   775→    console.log(`\n${sessionHeaders.inbox}`);
   776→    for (const item of ctx.inbox_items) {
   777→      const age = formatRelativeTime(new Date(item.created_at));
   778→      const author = item.added_by ? ` by ${item.added_by}` : '';
   779→      const tags = item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(', ')}]`) : '';
   780→      // Truncate text in brief mode
   781→      let text = item.text;
   782→      if (isBrief && text.length > 60) {
   783→        text = text.slice(0, 60).trim() + '...';
   784→      }
   785→      console.log(`  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`);
   786→      console.log(`    ${text}`);
   787→    }
   788→    console.log(`  ${hints.inboxPromote}`);
   789→  }
   790→
   791→  // Working tree section
   792→  if (ctx.working_tree && !ctx.working_tree.clean) {
   793→    console.log(`\n${sessionHeaders.workingTree}`);
   794→
   795→    if (ctx.working_tree.staged.length > 0) {
   796→      console.log(chalk.green('  Staged:'));
   797→      for (const file of ctx.working_tree.staged) {
   798→        console.log(`    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`);
   799→      }
   800→    }
   801→
   802→    if (ctx.working_tree.unstaged.length > 0) {
   803→      console.log(chalk.red('  Modified:'));
   804→      for (const file of ctx.working_tree.unstaged) {
   805→        console.log(`    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`);
   806→      }
   807→    }
   808→
   809→    if (ctx.working_tree.untracked.length > 0) {
   810→      console.log(chalk.gray('  Untracked:'));
   811→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
   812→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
   813→        console.log(`    ${chalk.gray('?')} ${path}`);
   814→      }
   815→      if (isBrief && ctx.working_tree.untracked.length > limit) {
   816→        console.log(chalk.gray(`    ... and ${ctx.working_tree.untracked.length - limit} more`));
   817→      }
   818→    }
   819→  } else if (ctx.working_tree?.clean) {
   820→    console.log(`\n${sessionHeaders.workingTreeClean}`);
   821→  }
   822→
   823→  // Quick Commands section - contextual hints based on state
   824→  const quickCommands: string[] = [];
   825→
   826→  if (ctx.active_tasks.length > 0) {
   827→    const ref = ctx.active_tasks[0].ref;
   828→    quickCommands.push(`kspec task note @${ref} "Progress..."  ${chalk.gray('# document work')}`);
   829→    quickCommands.push(`kspec task complete @${ref} --reason "..."  ${chalk.gray('# finish task')}`);
   830→  } else if (ctx.ready_tasks.length > 0) {
   831→    const ref = ctx.ready_tasks[0].ref;
   832→    quickCommands.push(`kspec task start @${ref}  ${chalk.gray('# begin work')}`);
   833→  }
   834→
   835→  if (ctx.inbox_items.length > 0) {
   836→    const ref = ctx.inbox_items[0].ref;
   837→    quickCommands.push(`kspec inbox promote @${ref} --title "..."  ${chalk.gray('# convert to task')}`);
   838→  }
   839→
   840→  if (ctx.working_tree && !ctx.working_tree.clean) {
   841→    quickCommands.push(`git add . && git commit -m "..."  ${chalk.gray('# commit changes')}`);
   842→  }
   843→
   844→  if (quickCommands.length > 0) {
   845→    console.log(`\n${sessionHeaders.quickCommands}`);
   846→    for (const hint of quickCommands) {
   847→      console.log(`  ${hint}`);
   848→    }
   849→  }
   850→
   851→  console.log(''); // Final newline
   852→}
   853→
   854→// ─── Command Registration ────────────────────────────────────────────────────
   855→
   856→async function sessionStartAction(options: SessionOptions): Promise<void> {
   857→  try {
   858→    const ctx = await initContext();
   859→
   860→    // AC-2: Pull remote changes before showing session context
   861→    let syncResult: ShadowSyncResult | null = null;
   862→    if (ctx.shadow?.enabled) {
   863→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
   864→      // AC-3: Warn about conflicts but continue with local state
   865→      if (syncResult.hadConflict) {
   866→        console.log(
   867→          chalk.yellow('⚠ Shadow sync conflict detected. Run `kspec shadow resolve` to fix.')
   868→        );
   869→        console.log(chalk.gray('  Continuing with local state...'));
   870→        console.log('');
   871→      } else if (syncResult.pulled) {
   872→        console.log(chalk.gray('ℹ Synced shadow branch from remote'));
   873→      }
   874→    }
   875→
   876→    const sessionCtx = await gatherSessionContext(ctx, options);
   877→
   878→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
   879→  } catch (err) {
   880→    error('Failed to gather session context', err);
   881→    process.exit(1);
   882→  }
   883→}
   884→
   885→/**
   886→ * Read stdin if available (non-blocking check for hook input)
   887→ */
   888→async function readStdinIfAvailable(): Promise<string | null> {
   889→  // Check if stdin is a TTY (interactive) - if so, don't try to read
   890→  if (process.stdin.isTTY) {
   891→    return null;
   892→  }
   893→
   894→  return new Promise((resolve) => {
   895→    let data = '';
   896→    const timeout = setTimeout(() => {
   897→      process.stdin.removeAllListeners();
   898→      resolve(data || null);
   899→    }, 100); // 100ms timeout for stdin
   900→
   901→    process.stdin.setEncoding('utf8');
   902→    process.stdin.on('data', (chunk) => {
   903→      data += chunk;
   904→    });
   905→    process.stdin.on('end', () => {
   906→      clearTimeout(timeout);
   907→      resolve(data || null);
   908→    });
   909→    process.stdin.on('error', () => {
   910→      clearTimeout(timeout);
   911→      resolve(null);
   912→    });
   913→    process.stdin.resume();
   914→  });
   915→}
   916→
   917→/**
   918→ * Parse Claude Code hook input from stdin
   919→ */
   920→function parseHookInput(stdin: string | null): StopHookInput | null {
   921→  if (!stdin) return null;
   922→  try {
   923→    return JSON.parse(stdin.trim()) as StopHookInput;
   924→  } catch {
   925→    return null;
   926→  }
   927→}
   928→
   929→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
   930→
   931→/**
   932→ * Output spec-first reminder for UserPromptSubmit hook.
   933→ *
   934→ * This is a simple context injection - always outputs the reminder,
   935→ * and Claude (Opus) is smart enough to apply it when relevant.
   936→ */
   937→async function sessionPromptCheckAction(): Promise<void> {
   938→  // Lean, instructive reminder with kspec prefix
   939→  console.log(sessionPrompt.specCheck);
   940→}
   941→
   942→async function sessionCheckpointAction(options: CheckpointOptions): Promise<void> {
   943→  try {
   944→    // Read stdin for Claude Code hook input
   945→    const stdin = await readStdinIfAvailable();
   946→    const hookInput = parseHookInput(stdin);
   947→
   948→    // Check if this is a retry (stop hook already active)
   949→    if (hookInput?.stop_hook_active) {
   950→      options.stopHookActive = true;
   951→    }
   952→
   953→    const ctx = await initContext();
   954→    const result = await performCheckpoint(ctx, options);
   955→
   956→    // Output format depends on mode:
   957→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
   958→    // - Human mode: Output formatted checkpoint result
   959→    if (isJsonMode()) {
   960→      if (!result.ok) {
   961→        // Build reason message with issues and instructions
   962→        const issueLines = result.issues.map(i => `- ${i.description}`).join('\n');
   963→        const instructionLines = result.instructions.filter(i => i.trim()).join('\n');
   964→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
   965→        console.log(JSON.stringify({ decision: 'block', reason }));
   966→      }
   967→      // If ok, exit silently (Claude Code expects no output when allowing stop)
   968→    } else {
   969→      formatCheckpointResult(result);
   970→      if (!result.ok) {
   971→        process.exit(1);
   972→      }
   973→    }
   974→  } catch (err) {
   975→    error('Failed to run checkpoint', err);
   976→    process.exit(1);
   977→  }
   978→}
   979→
   980→/**
   981→ * Register the 'session' command group and aliases
   982→ */
   983→export function registerSessionCommands(program: Command): void {
   984→  const session = program
   985→    .command('session')
   986→    .description('Session management and context');
   987→
   988→  session
   989→    .command('start')
   990→    .alias('resume')
   991→    .description('Surface relevant context for starting a new working session')
   992→    .option('--brief', 'Compact summary (default)')
   993→    .option('--full', 'Comprehensive context dump')
   994→    .option('--since <time>', 'Filter by recency (ISO8601 or relative: 1h, 2d, 1w)')
   995→    .option('--no-git', 'Skip git commit information')
   996→    .option('-n, --limit <n>', 'Limit items per section', '5')
   997→    .action(sessionStartAction);
   998→
   999→  session
  1000→    .command('checkpoint')
  1001→    .description('Pre-stop hook: check for uncommitted work before ending session')
  1002→    .option('--force', 'Allow session end regardless of issues')
  1003→    .action(sessionCheckpointAction);
  1004→
  1005→  session
  1006→    .command('prompt-check')
  1007→    .description('UserPromptSubmit hook: inject spec-first reminder')
  1008→    .action(sessionPromptCheckAction);
  1009→
  1010→  // Top-level alias: kspec context
  1011→  program
  1012→    .command('context')
  1013→    .description('Alias for session start - surface session context')
  1014→    .option('--brief', 'Compact summary (default)')
  1015→    .option('--full', 'Comprehensive context dump')
  1016→    .option('--since <time>', 'Filter by recency (ISO8601 or relative: 1h, 2d, 1w)')
  1017→    .option('--no-git', 'Skip git commit information')
  1018→    .option('-n, --limit <n>', 'Limit items per section', '5')
  1019→    .action(sessionStartAction);
  1020→}
