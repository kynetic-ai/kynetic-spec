   371→/**
   372→ * Get default author value for an agent type
   373→ */
   374→function getDefaultAuthor(agentType: AgentType): string {
   375→  switch (agentType) {
   376→    case 'claude-code':
   377→      return '@claude';
   378→    case 'cline':
   379→      return '@cline';
   380→    case 'roo-code':
   381→      return '@roo';
   382→    case 'copilot-cli':
   383→      return '@copilot';
   384→    case 'gemini-cli':
   385→      return '@gemini';
   386→    case 'codex-cli':
   387→      return '@codex';
   388→    case 'aider':
   389→      return '@aider';
   390→    case 'opencode':
   391→      return '@opencode';
   392→    case 'amp':
   393→      return '@amp';
   394→    default:
   395→      return '@agent';
   396→  }
   397→}
   398→
   399→/**
   400→ * Print manual setup instructions
   401→ */
   402→function printManualInstructions(agentType: AgentType): void {
   403→  const author = getDefaultAuthor(agentType);
   404→
   405→  console.log('\nManual setup instructions:\n');
   406→
   407→  switch (agentType) {
   408→    case 'claude-code':
   409→      console.log('Add to ~/.claude/settings.json:');
   410→      console.log('```json');
   411→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   412→      console.log('```');
   413→      break;
   414→
   415→    case 'cline':
   416→    case 'roo-code':
   417→      console.log('Add to your shell profile (~/.bashrc, ~/.zshrc):');
   418→      console.log('```bash');
   419→      console.log(`export KSPEC_AUTHOR="${author}"`);
   420→      console.log('```');
   421→      console.log('\nThis will be inherited by terminals spawned by the VS Code extension.');
   422→      break;
   423→
   424→    case 'copilot-cli':
   425→      console.log('Add to ~/.copilot/config.json:');
   426→      console.log('```json');
   427→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   428→      console.log('```');
   429→      break;
   430→
   431→    case 'aider':
   432→      console.log('Add to ~/.aider.conf.yml:');
   433→      console.log('```yaml');
   434→      console.log('set-env:');
   435→      console.log(`  - KSPEC_AUTHOR=${author}`);
   436→      console.log('```');
   437→      break;
   438→
   439→    case 'codex-cli':
   440→      console.log('Add to ~/.codex/config.toml:');
   441→      console.log('```toml');
   442→      console.log('[shell_environment_policy]');
   443→      console.log(`set = { KSPEC_AUTHOR = "${author}" }`);
   444→      console.log('```');
   445→      break;
   446→
   447→    case 'opencode':
   448→      console.log('Add to ~/.config/opencode/opencode.json:');
   449→      console.log('```json');
   450→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   451→      console.log('```');
   452→      break;
   453→
   454→    case 'amp':
   455→      console.log('Add to ~/.config/amp/settings.json:');
   456→      console.log('```json');
   457→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   458→      console.log('```');
   459→      break;
   460→
   461→    default:
   462→      console.log('Set the KSPEC_AUTHOR environment variable:');
   463→      console.log('```bash');
   464→      console.log(`export KSPEC_AUTHOR="${author}"`);
   465→      console.log('```');
   466→      console.log('\nOr add to your shell profile (~/.bashrc, ~/.zshrc, etc.)');
   467→  }
   468→}
