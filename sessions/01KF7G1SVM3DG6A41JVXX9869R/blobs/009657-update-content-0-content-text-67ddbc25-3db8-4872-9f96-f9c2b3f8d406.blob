   470→/**
   471→ * Register the 'setup' command
   472→ */
   473→export function registerSetupCommand(program: Command): void {
   474→  program
   475→    .command('setup')
   476→    .description('Configure agent environment for kspec')
   477→    .option('--dry-run', 'Show what would be done without making changes')
   478→    .option('--author <author>', 'Custom author string (default: auto-detected based on agent)')
   479→    .option('--no-hooks', 'Skip installing Claude Code stop hook')
   480→    .option('--force', 'Overwrite existing configuration')
   481→    .action(async (options) => {
   482→      try {
   483→        const detected = detectAgent();
   484→        const projectDir = process.cwd();
   485→
   486→        console.log(`Detected agent: ${detected.type} (confidence: ${detected.confidence})`);
   487→
   488→        if (detected.type === 'unknown') {
   489→          warn('Could not auto-detect agent environment');
   490→          printManualInstructions('unknown');
   491→          return;
   492→        }
   493→
   494→        const author = options.author || getDefaultAuthor(detected.type);
   495→        const installHooks = options.hooks !== false && detected.type === 'claude-code';
   496→
   497→        if (options.dryRun) {
   498→          console.log(`\nWould configure:`);
   499→          console.log(`  Agent: ${detected.type}`);
   500→          console.log(`  Author: ${author}`);
   501→          if (detected.configPath) {
   502→            console.log(`  Global config: ${detected.configPath}`);
   503→          }
   504→          if (installHooks) {
   505→            console.log(`  Project config: ${path.join(projectDir, '.claude', 'settings.json')}`);
   506→            console.log(`  Hooks: UserPromptSubmit (prompt-check), Stop (checkpoint)`);
   507→          }
   508→          return;
   509→        }
   510→
   511→        // Check if already configured
   512→        if (!options.force && process.env.KSPEC_AUTHOR) {
   513→          warn(`KSPEC_AUTHOR is already set to "${process.env.KSPEC_AUTHOR}"`);
   514→          console.log('Use --force to overwrite');
   515→          return;
   516→        }
   517→
   518→        // Install config based on agent type
   519→        let installed = false;
   520→        let hooksInstalled = false;
   521→
   522→        let hooksResult: { stop: boolean; promptCheck: boolean } | null = null;
   523→
   524→        switch (detected.type) {
   525→          case 'claude-code':
   526→            installed = await installClaudeCodeConfig(author);
   527→            if (installHooks) {
   528→              hooksResult = await installClaudeCodeHooks(projectDir);
   529→              hooksInstalled = hooksResult.stop || hooksResult.promptCheck;
   530→            }
   531→            break;
   532→
   533→          case 'aider':
   534→            installed = await installAiderConfig(author);
   535→            break;
   536→
   537→          case 'cline':
   538→          case 'roo-code':
   539→            // These VS Code extensions use shell env vars, not config files
   540→            // Can't auto-install, must print instructions
   541→            printManualInstructions(detected.type);
   542→            return;
   543→
   544→          case 'copilot-cli':
   545→          case 'gemini-cli':
   546→          case 'opencode':
   547→          case 'amp':
   548→            if (detected.configPath) {
   549→              installed = await installGenericJsonConfig(detected.configPath, author);
   550→            }
   551→            break;
   552→
   553→          case 'codex-cli':
   554→            // Codex uses TOML config, would need special handling
   555→            // For now, print manual instructions
   556→            printManualInstructions(detected.type);
   557→            return;
   558→        }
   559→
   560→        if (installed) {
   561→          success(`Configured ${detected.type} with KSPEC_AUTHOR="${author}"`, {
   562→            agent: detected.type,
   563→            author,
   564→            configPath: detected.configPath,
   565→          });
   566→
   567→          if (hooksInstalled && hooksResult) {
   568→            const installedHooks: string[] = [];
   569→            if (hooksResult.promptCheck) installedHooks.push('UserPromptSubmit (prompt-check)');
   570→            if (hooksResult.stop) installedHooks.push('Stop (checkpoint)');
   571→            success(`Installed hooks to .claude/settings.json`, {
   572→              hooks: installedHooks,
   573→            });
   574→          }
   575→
   576→          console.log('\nRestart your agent session for changes to take effect.');
   577→        } else {
   578→          error(`Failed to install config for ${detected.type}`);
   579→          printManualInstructions(detected.type);
   580→        }
   581→      } catch (err) {
   582→        error('Setup failed', err);
   583→        process.exit(1);
   584→      }
   585→    });
   586→}
