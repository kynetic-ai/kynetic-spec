     1→import { Command } from 'commander';
     2→import * as fs from 'node:fs/promises';
     3→import * as path from 'node:path';
     4→import * as os from 'node:os';
     5→import { success, error, warn } from '../output.js';
     6→
     7→/**
     8→ * Supported agent types for auto-configuration
     9→ */
    10→export type AgentType =
    11→  | 'claude-code'
    12→  | 'cline'
    13→  | 'roo-code'
    14→  | 'copilot-cli'
    15→  | 'gemini-cli'
    16→  | 'codex-cli'
    17→  | 'aider'
    18→  | 'opencode'
    19→  | 'amp'
    20→  | 'unknown';
    21→
    22→/**
    23→ * Result of agent detection
    24→ */
    25→export interface DetectedAgent {
    26→  type: AgentType;
    27→  confidence: 'high' | 'medium' | 'low';
    28→  configPath?: string;
    29→  envVars?: Record<string, string>;
    30→}
    31→
    32→/**
    33→ * Detect which agent environment we're running in.
    34→ * Returns the detected agent type and confidence level.
    35→ *
    36→ * Detection priority matters - more specific markers checked first.
    37→ */
    38→export function detectAgent(): DetectedAgent {
    39→  // Claude Code: Multiple possible markers
    40→  // CLAUDECODE=1 is set in CLI sessions
    41→  // CLAUDE_CODE_ENTRYPOINT indicates entry point (cli, etc.)
    42→  // CLAUDE_PROJECT_DIR is set in some contexts
    43→  if (process.env.CLAUDECODE === '1' || process.env.CLAUDE_CODE_ENTRYPOINT || process.env.CLAUDE_PROJECT_DIR) {
    44→    return {
    45→      type: 'claude-code',
    46→      confidence: 'high',
    47→      configPath: path.join(os.homedir(), '.claude', 'settings.json'),
    48→      envVars: {
    49→        ...(process.env.CLAUDECODE && { CLAUDECODE: process.env.CLAUDECODE }),
    50→        ...(process.env.CLAUDE_CODE_ENTRYPOINT && { CLAUDE_CODE_ENTRYPOINT: process.env.CLAUDE_CODE_ENTRYPOINT }),
    51→        ...(process.env.CLAUDE_PROJECT_DIR && { CLAUDE_PROJECT_DIR: process.env.CLAUDE_PROJECT_DIR }),
    52→      },
    53→    };
    54→  }
    55→
    56→  // Cline: CLINE_ACTIVE is set when running in Cline terminal
    57→  if (process.env.CLINE_ACTIVE) {
    58→    return {
    59→      type: 'cline',
    60→      confidence: 'high',
    61→      // Cline uses VS Code settings, but env vars should be in shell profile
    62→      configPath: undefined,
    63→      envVars: { CLINE_ACTIVE: process.env.CLINE_ACTIVE },
    64→    };
    65→  }
    66→
    67→  // GitHub Copilot CLI: Check for copilot-specific markers
    68→  if (process.env.COPILOT_MODEL || process.env.GH_TOKEN) {
    69→    return {
    70→      type: 'copilot-cli',
    71→      confidence: 'medium',
    72→      configPath: path.join(os.homedir(), '.copilot', 'config.json'),
    73→    };
    74→  }
    75→
    76→  // Aider: Check for AIDER_* env vars
    77→  if (process.env.AIDER_MODEL || process.env.AIDER_DARK_MODE !== undefined) {
    78→    return {
    79→      type: 'aider',
    80→      confidence: 'high',
    81→      configPath: path.join(os.homedir(), '.aider.conf.yml'),
    82→    };
    83→  }
    84→
    85→  // OpenCode: Check for OPENCODE_* env vars
    86→  if (process.env.OPENCODE_CONFIG_DIR || process.env.OPENCODE_CONFIG) {
    87→    return {
    88→      type: 'opencode',
    89→      confidence: 'high',
    90→      configPath: process.env.OPENCODE_CONFIG || path.join(os.homedir(), '.config', 'opencode', 'opencode.json'),
    91→    };
    92→  }
    93→
    94→  // Gemini CLI: GEMINI_CLI=1 is set when running in Gemini CLI
    95→  if (process.env.GEMINI_CLI === '1') {
    96→    return {
    97→      type: 'gemini-cli',
    98→      confidence: 'high',
    99→      configPath: path.join(os.homedir(), '.gemini', 'settings.json'),
   100→      envVars: { GEMINI_CLI: '1' },
   101→    };
   102→  }
   103→
   104→  // Codex CLI: CODEX_SANDBOX is set when running in sandbox
   105→  if (process.env.CODEX_SANDBOX) {
   106→    return {
   107→      type: 'codex-cli',
   108→      confidence: 'high',
   109→      configPath: path.join(os.homedir(), '.codex', 'config.toml'),
   110→      envVars: { CODEX_SANDBOX: process.env.CODEX_SANDBOX },
   111→    };
   112→  }
   113→
   114→  // Amp (Sourcegraph): Check for AMP_API_KEY or AMP_TOOLBOX
   115→  if (process.env.AMP_API_KEY || process.env.AMP_TOOLBOX) {
   116→    return {
   117→      type: 'amp',
   118→      confidence: 'medium',
   119→      configPath: path.join(os.homedir(), '.config', 'amp', 'settings.json'),
   120→    };
   121→  }
   122→
   123→  return {
   124→    type: 'unknown',
   125→    confidence: 'low',
   126→  };
   127→}
   128→
   129→/**
   130→ * Install KSPEC_AUTHOR config for Claude Code (global settings)
   131→ */
   132→async function installClaudeCodeConfig(author: string): Promise<boolean> {
   133→  const configPath = path.join(os.homedir(), '.claude', 'settings.json');
   134→  const configDir = path.dirname(configPath);
   135→
   136→  try {
   137→    // Ensure directory exists
   138→    await fs.mkdir(configDir, { recursive: true });
   139→
   140→    // Read existing config or start fresh
   141→    let config: Record<string, unknown> = {};
   142→    try {
   143→      const existing = await fs.readFile(configPath, 'utf-8');
   144→      config = JSON.parse(existing);
   145→    } catch {
   146→      // File doesn't exist or invalid JSON, start fresh
   147→    }
   148→
   149→    // Merge env settings
   150→    const env = (config.env as Record<string, string>) || {};
   151→    env.KSPEC_AUTHOR = author;
   152→    config.env = env;
   153→
   154→    // Write back
   155→    await fs.writeFile(configPath, JSON.stringify(config, null, 2) + '\n', 'utf-8');
   156→    return true;
   157→  } catch (err) {
   158→    return false;
   159→  }
   160→}
   161→
   162→/**
   163→ * Install hooks to project-level Claude Code settings (.claude/settings.json)
   164→ */
   165→async function installClaudeCodeHooks(projectDir: string): Promise<{ stop: boolean; promptCheck: boolean }> {
   166→  const configPath = path.join(projectDir, '.claude', 'settings.json');
   167→  const configDir = path.dirname(configPath);
   168→
   169→  const result = { stop: false, promptCheck: false };
   170→
   171→  try {
   172→    // Ensure directory exists
   173→    await fs.mkdir(configDir, { recursive: true });
   174→
   175→    // Read existing config or start fresh
   176→    let config: Record<string, unknown> = {};
   177→    try {
   178→      const existing = await fs.readFile(configPath, 'utf-8');
   179→      config = JSON.parse(existing);
   180→    } catch {
   181→      // File doesn't exist or invalid JSON, start fresh
   182→    }
   183→
   184→    // Get or create hooks object
   185→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   186→
   187→    // Install UserPromptSubmit hook (spec-first reminder)
   188→    const promptCheckCommand = 'npx kspec session prompt-check';
   189→    const existingPromptHooks = hooks.UserPromptSubmit as Array<{ hooks?: Array<{ command?: string }> }> | undefined;
   190→    const promptAlreadyInstalled = existingPromptHooks?.some(
   191→      (entry) => entry.hooks?.some((hook) => hook.command?.includes('session prompt-check'))
   192→    );
   193→
   194→    if (!promptAlreadyInstalled) {
   195→      hooks.UserPromptSubmit = [
   196→        ...(existingPromptHooks || []),
   197→        {
   198→          hooks: [
   199→            {
   200→              type: 'command',
   201→              command: promptCheckCommand,
   202→            },
   203→          ],
   204→        },
   205→      ];
   206→      result.promptCheck = true;
   207→    } else {
   208→      result.promptCheck = true; // Already configured
   209→    }
   210→
   211→    // Install Stop hook (checkpoint)
   212→    const stopHookCommand = 'npx kspec session checkpoint --json';
   213→    const existingStopHooks = hooks.Stop as Array<{ matcher?: string; hooks?: Array<{ command?: string }> }> | undefined;
   214→    const stopAlreadyInstalled = existingStopHooks?.some(
   215→      (entry) => entry.hooks?.some((hook) => hook.command?.includes('session checkpoint'))
   216→    );
   217→
   218→    if (!stopAlreadyInstalled) {
   219→      hooks.Stop = [
   220→        ...(existingStopHooks || []),
   221→        {
   222→          matcher: '',
   223→          hooks: [
   224→            {
   225→              type: 'command',
   226→              command: stopHookCommand,
   227→            },
   228→          ],
   229→        },
   230→      ];
   231→      result.stop = true;
   232→    } else {
   233→      result.stop = true; // Already configured
   234→    }
   235→
   236→    config.hooks = hooks;
   237→
   238→    // Write back
   239→    await fs.writeFile(configPath, JSON.stringify(config, null, 2) + '\n', 'utf-8');
   240→    return result;
   241→  } catch {
   242→    return result;
   243→  }
   244→}
   245→
   246→/**
   247→ * Install stop hook to project-level Claude Code settings (.claude/settings.json)
   248→ * @deprecated Use installClaudeCodeHooks instead
   249→ */
   250→async function installClaudeCodeStopHook(projectDir: string): Promise<boolean> {
   251→  const configPath = path.join(projectDir, '.claude', 'settings.json');
   252→  const configDir = path.dirname(configPath);
   253→
   254→  try {
   255→    // Ensure directory exists
   256→    await fs.mkdir(configDir, { recursive: true });
   257→
   258→    // Read existing config or start fresh
   259→    let config: Record<string, unknown> = {};
   260→    try {
   261→      const existing = await fs.readFile(configPath, 'utf-8');
   262→      config = JSON.parse(existing);
   263→    } catch {
   264→      // File doesn't exist or invalid JSON, start fresh
   265→    }
   266→
   267→    // Build the stop hook command
   268→    const stopHookCommand = 'npx kspec session checkpoint --json';
   269→
   270→    // Get or create hooks object
   271→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   272→
   273→    // Check if Stop hook already exists with our command
   274→    const existingStopHooks = hooks.Stop as Array<{ matcher?: object; hooks?: Array<{ command?: string }> }> | undefined;
   275→    const alreadyInstalled = existingStopHooks?.some(
   276→      (entry) => entry.hooks?.some((hook) => hook.command?.includes('session checkpoint'))
   277→    );
   278→
   279→    if (alreadyInstalled) {
   280→      return true; // Already configured
   281→    }
   282→
   283→    // Add our stop hook using Claude Code hooks format
   284→    // Note: matcher field is required even if empty string
   285→    hooks.Stop = [
   286→      ...(existingStopHooks || []),
   287→      {
   288→        matcher: '',
   289→        hooks: [
   290→          {
   291→            type: 'command',
   292→            command: stopHookCommand,
   293→          },
   294→        ],
   295→      },
   296→    ];
   297→    config.hooks = hooks;
   298→
   299→    // Write back
   300→    await fs.writeFile(configPath, JSON.stringify(config, null, 2) + '\n', 'utf-8');
   301→    return true;
   302→  } catch {
   303→    return false;
   304→  }
   305→}
   306→
   307→/**
   308→ * Install KSPEC_AUTHOR config for Aider (.aider.conf.yml)
   309→ * Aider uses `set-env:` for environment variables in list format
   310→ */
   311→async function installAiderConfig(author: string): Promise<boolean> {
   312→  const configPath = path.join(os.homedir(), '.aider.conf.yml');
   313→
   314→  try {
   315→    let content = '';
   316→    try {
   317→      content = await fs.readFile(configPath, 'utf-8');
   318→    } catch {
   319→      // File doesn't exist, start fresh
   320→    }
   321→
   322→    // Check if KSPEC_AUTHOR is already set
   323→    if (content.includes('KSPEC_AUTHOR')) {
   324→      // Replace existing value (handles both old and new format)
   325→      content = content.replace(/^(\s*-?\s*KSPEC_AUTHOR\s*[=:]\s*).*$/m, `  - KSPEC_AUTHOR=${author}`);
   326→    } else {
   327→      // Add to set-env section or create it
   328→      if (content.includes('set-env:')) {
   329→        // Append to existing set-env section
   330→        content = content.replace(/(set-env:\s*\n)/m, `$1  - KSPEC_AUTHOR=${author}\n`);
   331→      } else {
   332→        // Add new set-env section
   333→        content += `\n# kspec author for note attribution\nset-env:\n  - KSPEC_AUTHOR=${author}\n`;
   334→      }
   335→    }
   336→
   337→    await fs.writeFile(configPath, content, 'utf-8');
   338→    return true;
   339→  } catch {
   340→    return false;
   341→  }
   342→}
   343→
   344→/**
   345→ * Install KSPEC_AUTHOR for generic JSON config files
   346→ */
   347→async function installGenericJsonConfig(configPath: string, author: string): Promise<boolean> {
   348→  try {
   349→    const configDir = path.dirname(configPath);
   350→    await fs.mkdir(configDir, { recursive: true });
   351→
   352→    let config: Record<string, unknown> = {};
   353→    try {
   354→      const existing = await fs.readFile(configPath, 'utf-8');
   355→      config = JSON.parse(existing);
   356→    } catch {
   357→      // Start fresh
   358→    }
   359→
   360→    const env = (config.env as Record<string, string>) || {};
   361→    env.KSPEC_AUTHOR = author;
   362→    config.env = env;
   363→
   364→    await fs.writeFile(configPath, JSON.stringify(config, null, 2) + '\n', 'utf-8');
   365→    return true;
   366→  } catch {
   367→    return false;
   368→  }
   369→}
