```
     1→/**
     2→ * Session management commands
     3→ *
     4→ * Provides context for starting/resuming work sessions.
     5→ */
     6→
     7→import { Command } from 'commander';
     8→import chalk from 'chalk';
     9→import {
    10→  initContext,
    11→  loadAllTasks,
    12→  loadAllItems,
    13→  loadInboxItems,
    14→  getReadyTasks,
    15→  ReferenceIndex,
    16→  type LoadedTask,
    17→  type LoadedInboxItem,
    18→  type KspecContext,
    19→} from '../../parser/index.js';
    20→import { output, error, info, isJsonMode } from '../output.js';
    21→import {
    22→  parseTimeSpec,
    23→  formatRelativeTime,
    24→  isGitRepo,
    25→  getRecentCommits,
    26→  getCurrentBranch,
    27→  getWorkingTreeStatus,
    28→  formatCommitGuidance,
    29→  type GitCommit,
    30→  type GitWorkingTree,
    31→} from '../../utils/index.js';
    32→import { shadowPull, type ShadowSyncResult } from '../../parser/shadow.js';
    33→import type { Note, Todo } from '../../schema/index.js';
    34→
    35→// ─── Types ───────────────────────────────────────────────────────────────────
    36→
    37→export interface CheckpointResult {
    38→  /** Whether session can end cleanly */
    39→  ok: boolean;
    40→
    41→  /** Human-readable message for Claude Code */
    42→  message: string;
    43→
    44→  /** Issues that need attention before stopping */
    45→  issues: CheckpointIssue[];
    46→
    47→  /** Instructions for the agent */
    48→  instructions: string[];
    49→}
    50→
    51→export interface CheckpointIssue {
    52→  type: 'uncommitted_changes' | 'in_progress_task' | 'incomplete_todo';
    53→  description: string;
    54→  details?: Record<string, unknown>;
    55→}
    56→
    57→export interface SessionContext {
    58→  /** When this context was generated */
    59→  generated_at: string;
    60→
    61→  /** Current git branch */
    62→  branch: string | null;
    63→
    64→  /** Tasks currently in progress */
    65→  active_tasks: ActiveTaskSummary[];
    66→
    67→  /** Recent notes from active tasks */
    68→  recent_notes: NoteSummary[];
    69→
    70→  /** Incomplete todos from active tasks */
    71→  active_todos: TodoSummary[];
    72→
    73→  /** Tasks ready to be picked up */
    74→  ready_tasks: ReadyTaskSummary[];
    75→
    76→  /** Blocked tasks with blockers */
    77→  blocked_tasks: BlockedTaskSummary[];
    78→
    79→  /** Recently completed tasks */
    80→  recently_completed: CompletedTaskSummary[];
    81→
    82→  /** Recent git commits */
    83→  recent_commits: CommitSummary[];
    84→
    85→  /** Working tree status */
    86→  working_tree: GitWorkingTree | null;
    87→
    88→  /** Inbox items awaiting triage (oldest first) */
    89→  inbox_items: InboxSummary[];
    90→
    91→  /** Summary statistics */
    92→  stats: SessionStats;
    93→}
    94→
    95→export interface ActiveTaskSummary {
    96→  ref: string;
    97→  title: string;
    98→  started_at: string | null;
    99→  priority: number;
   100→  spec_ref: string | null;
   101→  note_count: number;
   102→  last_note_at: string | null;
   103→  todo_count: number;
   104→  incomplete_todos: number;
   105→}
   106→
   107→export interface NoteSummary {
   108→  task_ref: string;
   109→  task_title: string;
   110→  note_ulid: string;
   111→  created_at: string;
   112→  author: string | null;
   113→  content: string;
   114→}
   115→
   116→export interface TodoSummary {
   117→  task_ref: string;
   118→  task_title: string;
   119→  id: number;
   120→  text: string;
   121→  added_at: string;
   122→  added_by: string | null;
   123→}
   124→
   125→export interface ReadyTaskSummary {
   126→  ref: string;
   127→  title: string;
   128→  priority: number;
   129→  spec_ref: string | null;
   130→  tags: string[];
   131→}
   132→
   133→export interface BlockedTaskSummary {
   134→  ref: string;
   135→  title: string;
   136→  blocked_by: string[];
   137→  unmet_deps: string[];
   138→}
   139→
   140→export interface CompletedTaskSummary {
   141→  ref: string;
   142→  title: string;
   143→  completed_at: string;
   144→  closed_reason: string | null;
   145→}
   146→
   147→export interface CommitSummary {
   148→  hash: string;
   149→  full_hash: string;
   150→  date: string;
   151→  message: string;
   152→  author: string;
   153→}
   154→
   155→export interface SessionStats {
   156→  total_tasks: number;
   157→  in_progress: number;
   158→  ready: number;
   159→  blocked: number;
   160→  completed: number;
   161→  inbox_items: number;
   162→}
   163→
   164→export interface InboxSummary {
   165→  ref: string;
   166→  text: string;
   167→  created_at: string;
   168→  tags: string[];
   169→  added_by: string | null;
   170→}
   171→
   172→export interface SessionOptions {
   173→  brief?: boolean;
   174→  full?: boolean;
   175→  since?: string;
   176→  git?: boolean;
   177→  limit?: string;
   178→}
   179→
   180→// ─── Data Gathering ──────────────────────────────────────────────────────────
   181→
   182→function toActiveTaskSummary(
   183→  task: LoadedTask,
   184→  index: ReferenceIndex
   185→): ActiveTaskSummary {
   186→  const lastNote =
   187→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   188→  const incompleteTodos = task.todos.filter(t => !t.done).length;
   189→  return {
   190→    ref: index.shortUlid(task._ulid),
   191→    title: task.title,
   192→    started_at: task.started_at || null,
   193→    priority: task.priority,
   194→    spec_ref: task.spec_ref || null,
   195→    note_count: task.notes.length,
   196→    last_note_at: lastNote ? lastNote.created_at : null,
   197→    todo_count: task.todos.length,
   198→    incomplete_todos: incompleteTodos,
   199→  };
   200→}
   201→
   202→function toReadyTaskSummary(
   203→  task: LoadedTask,
   204→  index: ReferenceIndex
   205→): ReadyTaskSummary {
   206→  return {
   207→    ref: index.shortUlid(task._ulid),
   208→    title: task.title,
   209→    priority: task.priority,
   210→    spec_ref: task.spec_ref || null,
   211→    tags: task.tags,
   212→  };
   213→}
   214→
   215→function toBlockedTaskSummary(
   216→  task: LoadedTask,
   217→  allTasks: LoadedTask[],
   218→  index: ReferenceIndex
   219→): BlockedTaskSummary {
   220→  // Find unmet dependencies
   221→  const unmetDeps: string[] = [];
   222→  for (const depRef of task.depends_on) {
   223→    const result = index.resolve(depRef);
   224→    if (result.ok) {
   225→      const depItem = result.item;
   226→      if ('status' in depItem && depItem.status !== 'completed') {
   227→        unmetDeps.push(depRef);
   228→      }
   229→    }
   230→  }
   231→
   232→  return {
   233→    ref: index.shortUlid(task._ulid),
   234→    title: task.title,
   235→    blocked_by: task.blocked_by,
   236→    unmet_deps: unmetDeps,
   237→  };
   238→}
   239→
   240→function toCompletedTaskSummary(
   241→  task: LoadedTask,
   242→  index: ReferenceIndex
   243→): CompletedTaskSummary {
   244→  return {
   245→    ref: index.shortUlid(task._ulid),
   246→    title: task.title,
   247→    completed_at: task.completed_at || '',
   248→    closed_reason: task.closed_reason || null,
   249→  };
   250→}
   251→
   252→function collectRecentNotes(
   253→  tasks: LoadedTask[],
   254→  index: ReferenceIndex,
   255→  options: { limit: number; since: Date | null }
   256→): NoteSummary[] {
   257→  const allNotes: NoteSummary[] = [];
   258→
   259→  for (const task of tasks) {
   260→    for (const note of task.notes) {
   261→      const noteDate = new Date(note.created_at);
   262→
   263→      // Filter by since date if provided
   264→      if (options.since && noteDate < options.since) {
   265→        continue;
   266→      }
   267→
   268→      allNotes.push({
   269→        task_ref: index.shortUlid(task._ulid),
   270→        task_title: task.title,
   271→        note_ulid: note._ulid.slice(0, 8),
   272→        created_at: note.created_at,
   273→        author: note.author || null,
   274→        content: note.content,
   275→      });
   276→    }
   277→  }
   278→
   279→  // Sort by date descending, take limit
   280→  return allNotes
   281→    .sort(
   282→      (a, b) =>
   283→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
   284→    )
   285→    .slice(0, options.limit);
   286→}
   287→
   288→function collectIncompleteTodos(
   289→  tasks: LoadedTask[],
   290→  index: ReferenceIndex,
   291→  options: { limit: number }
   292→): TodoSummary[] {
   293→  const allTodos: TodoSummary[] = [];
   294→
   295→  for (const task of tasks) {
   296→    for (const todo of task.todos) {
   297→      // Only include incomplete todos
   298→      if (todo.done) continue;
   299→
   300→      allTodos.push({
   301→        task_ref: index.shortUlid(task._ulid),
   302→        task_title: task.title,
   303→        id: todo.id,
   304→        text: todo.text,
   305→        added_at: todo.added_at,
   306→        added_by: todo.added_by || null,
   307→      });
   308→    }
   309→  }
   310→
   311→  // Sort by added_at descending (most recent first), take limit
   312→  return allTodos
   313→    .sort(
   314→      (a, b) =>
   315→        new Date(b.added_at).getTime() - new Date(a.added_at).getTime()
   316→    )
   317→    .slice(0, options.limit);
   318→}
   319→
   320→/**
   321→ * Gather session context data
   322→ */
   323→export async function gatherSessionContext(
   324→  ctx: KspecContext,
   325→  options: SessionOptions
   326→): Promise<SessionContext> {
   327→  const limit = parseInt(options.limit || '5', 10);
   328→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   329→  const showGit = options.git !== false; // default true
   330→
   331→  // Load all data
   332→  const allTasks = await loadAllTasks(ctx);
   333→  const items = await loadAllItems(ctx);
   334→  const inboxItems = await loadInboxItems(ctx);
   335→  const index = new ReferenceIndex(allTasks, items);
   336→
   337→  // Compute stats
   338→  const stats: SessionStats = {
   339→    total_tasks: allTasks.length,
   340→    in_progress: allTasks.filter((t) => t.status === 'in_progress').length,
   341→    ready: getReadyTasks(allTasks).length,
   342→    blocked: allTasks.filter((t) => t.status === 'blocked').length,
   343→    completed: allTasks.filter((t) => t.status === 'completed').length,
   344→    inbox_items: inboxItems.length,
   345→  };
   346→
   347→  // Get active tasks
   348→  const activeTasks = allTasks
   349→    .filter((t) => t.status === 'in_progress')
   350→    .sort((a, b) => a.priority - b.priority)
   351→    .slice(0, options.full ? undefined : limit)
   352→    .map((t) => toActiveTaskSummary(t, index));
   353→
   354→  // Get recent notes from active tasks
   355→  const recentNotes = collectRecentNotes(
   356→    allTasks.filter((t) => t.status === 'in_progress'),
   357→    index,
   358→    { limit: options.full ? limit * 2 : limit, since: sinceDate }
   359→  );
   360→
   361→  // Get incomplete todos from active tasks
   362→  const activeTodos = collectIncompleteTodos(
   363→    allTasks.filter((t) => t.status === 'in_progress'),
   364→    index,
   365→    { limit: options.full ? limit * 2 : limit }
   366→  );
   367→
   368→  // Get ready tasks
   369→  const readyTasks = getReadyTasks(allTasks)
   370→    .slice(0, options.full ? undefined : limit)
   371→    .map((t) => toReadyTaskSummary(t, index));
   372→
   373→  // Get blocked tasks
   374→  const blockedTasks = allTasks
   375→    .filter((t) => t.status === 'blocked')
   376→    .slice(0, options.full ? undefined : limit)
   377→    .map((t) => toBlockedTaskSummary(t, allTasks, index));
   378→
   379→  // Get recently completed tasks
   380→  const recentlyCompleted = allTasks
   381→    .filter((t) => {
   382→      if (t.status !== 'completed' || !t.completed_at) return false;
   383→      const completedDate = new Date(t.completed_at);
   384→      if (sinceDate && completedDate < sinceDate) return false;
   385→      return true;
   386→    })
   387→    .sort((a, b) => {
   388→      // Sort by completed_at descending (most recent first)
   389→      const aDate = new Date(a.completed_at || 0);
   390→      const bDate = new Date(b.completed_at || 0);
   391→      return bDate.getTime() - aDate.getTime();
   392→    })
   393→    .slice(0, options.full ? undefined : limit)
   394→    .map((t) => toCompletedTaskSummary(t, index));
   395→
   396→  // Get git info
   397→  let branch: string | null = null;
   398→  let recentCommits: CommitSummary[] = [];
   399→  let workingTree: GitWorkingTree | null = null;
   400→
   401→  if (showGit && isGitRepo(ctx.rootDir)) {
   402→    branch = getCurrentBranch(ctx.rootDir);
   403→
   404→    const commits = getRecentCommits({
   405→      limit: options.full ? limit * 2 : limit,
   406→      since: sinceDate || undefined,
   407→      cwd: ctx.rootDir,
   408→    });
   409→
   410→    recentCommits = commits.map((c) => ({
   411→      hash: c.hash,
   412→      full_hash: c.fullHash,
   413→      date: c.date.toISOString(),
   414→      message: c.message,
   415→      author: c.author,
   416→    }));
   417→
   418→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   419→  }
   420→
   421→  // Get inbox items (oldest first to encourage triage)
   422→  const inboxSummaries: InboxSummary[] = inboxItems
   423→    .sort((a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime())
   424→    .slice(0, options.full ? undefined : limit)
   425→    .map((item) => ({
   426→      ref: item._ulid.slice(0, 8),
   427→      text: item.text,
   428→      created_at: item.created_at,
   429→      tags: item.tags,
   430→      added_by: item.added_by || null,
   431→    }));
   432→
   433→  return {
   434→    generated_at: new Date().toISOString(),
   435→    branch,
   436→    active_tasks: activeTasks,
   437→    recent_notes: recentNotes,
   438→    active_todos: activeTodos,
   439→    ready_tasks: readyTasks,
   440→    blocked_tasks: blockedTasks,
   441→    recently_completed: recentlyCompleted,
   442→    recent_commits: recentCommits,
   443→    working_tree: workingTree,
   444→    inbox_items: inboxSummaries,
   445→    stats,
   446→  };
   447→}
   448→
   449→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   450→
   451→export interface CheckpointOptions {
   452→  force?: boolean;
   453→  /** Set when stop hook is already active (retry after previous block) */
   454→  stopHookActive?: boolean;
   455→}
   456→
   457→/** Claude Code hook input for Stop hooks */
   458→export interface StopHookInput {
   459→  session_id?: string;
   460→  transcript_path?: string;
   461→  hook_event_name?: string;
   462→  stop_hook_active?: boolean;
   463→}
   464→
   465→/**
   466→ * Perform session checkpoint - check for uncommitted work before ending session.
   467→ *
   468→ * This is designed for use as a Claude Code stop hook. It checks for:
   469→ * - Uncommitted git changes (staged, unstaged, untracked)
   470→ * - Tasks in in_progress status
   471→ * - Incomplete todos on active tasks
   472→ *
   473→ * Returns a structured result indicating whether the session can end cleanly.
   474→ */
   475→export async function performCheckpoint(
   476→  ctx: KspecContext,
   477→  options: CheckpointOptions
   478→): Promise<CheckpointResult> {
   479→  const issues: CheckpointIssue[] = [];
   480→  const instructions: string[] = [];
   481→
   482→  // Load tasks
   483→  const allTasks = await loadAllTasks(ctx);
   484→
   485→  // Check for in-progress tasks
   486→  const inProgressTasks = allTasks.filter((t) => t.status === 'in_progress');
   487→  for (const task of inProgressTasks) {
   488→    const ref = task.slugs[0] ? `@${task.slugs[0]}` : `@${task._ulid.slice(0, 8)}`;
   489→    issues.push({
   490→      type: 'in_progress_task',
   491→      description: `Task ${ref} is still in progress: ${task.title}`,
   492→      details: {
   493→        ref,
   494→        title: task.title,
   495→        started_at: task.started_at,
   496→      },
   497→    });
   498→
   499→    // Check for incomplete todos on this task
   500→    const incompleteTodos = task.todos.filter((t) => !t.done);
   501→    for (const todo of incompleteTodos) {
   502→      issues.push({
   503→        type: 'incomplete_todo',
   504→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   505→        details: {
   506→          task_ref: ref,
   507→          todo_id: todo.id,
   508→          text: todo.text,
   509→        },
   510→      });
   511→    }
   512→  }
   513→
   514→  // Check for uncommitted git changes
   515→  if (isGitRepo(ctx.rootDir)) {
   516→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   517→    if (!workingTree.clean) {
   518→      const changeCount =
   519→        workingTree.staged.length +
   520→        workingTree.unstaged.length +
   521→        workingTree.untracked.length;
   522→
   523→      issues.push({
   524→        type: 'uncommitted_changes',
   525→        description: `${changeCount} uncommitted changes in working tree`,
   526→        details: {
   527→          staged: workingTree.staged.length,
   528→          unstaged: workingTree.unstaged.length,
   529→          untracked: workingTree.untracked.length,
   530→        },
   531→      });
   532→    }
   533→  }
   534→
   535→  // Build instructions based on issues
   536→  if (issues.length > 0 && !options.force) {
   537→    instructions.push('Before ending this session, please:');
   538→
   539→    const hasInProgress = issues.some((i) => i.type === 'in_progress_task');
   540→    const hasUncommitted = issues.some((i) => i.type === 'uncommitted_changes');
   541→    const hasIncompleteTodos = issues.some((i) => i.type === 'incomplete_todo');
   542→
   543→    let step = 1;
   544→
   545→    if (hasInProgress) {
   546→      instructions.push(
   547→        `${step++}. Add notes to in-progress tasks documenting current state`
   548→      );
   549→      instructions.push(
   550→        `${step++}. Either complete the tasks or leave them in_progress with clear notes for next session`
   551→      );
   552→    }
   553→
   554→    if (hasIncompleteTodos) {
   555→      instructions.push(
   556→        `${step++}. Complete or acknowledge incomplete todos on active tasks`
   557→      );
   558→    }
   559→
   560→    if (hasUncommitted) {
   561→      instructions.push(`${step++}. Commit your changes with a descriptive message`);
   562→
   563→      // Add WIP commit guidance if there are in-progress tasks
   564→      if (inProgressTasks.length > 0) {
   565→        const task = inProgressTasks[0];
   566→        const guidance = formatCommitGuidance(task, { wip: true });
   567→        instructions.push('');
   568→        instructions.push('Suggested WIP commit:');
   569→        instructions.push(`  ${guidance.message}`);
   570→        instructions.push('');
   571→        for (const trailer of guidance.trailers) {
   572→          instructions.push(`  ${trailer}`);
   573→        }
   574→      }
   575→    }
   576→
   577→    instructions.push('');
   578→    instructions.push(
   579→      'Use: kspec task note @task "Progress notes..." to document state'
   580→    );
   581→    instructions.push(
   582→      'Use: kspec task complete @task --reason "Summary" if task is done'
   583→    );
   584→  }
   585→
   586→  // Allow stop if:
   587→  // - No issues found
   588→  // - --force flag passed
   589→  // - This is a retry (stop_hook_active = true from previous block)
   590→  const isRetry = options.stopHookActive === true;
   591→  const ok = issues.length === 0 || options.force === true || isRetry;
   592→
   593→  let message: string;
   594→  if (isRetry && issues.length > 0) {
   595→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   596→  } else if (ok) {
   597→    message = '[kspec] Session checkpoint passed - ready to end session';
   598→  } else {
   599→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   600→  }
   601→
   602→  return {
   603→    ok,
   604→    message,
   605→    issues,
   606→    instructions,
   607→  };
   608→}
   609→
   610→// ─── Output Formatting ───────────────────────────────────────────────────────
   611→
   612→function formatCheckpointResult(result: CheckpointResult): void {
   613→  if (result.ok) {
   614→    console.log(chalk.green(result.message));
   615→  } else {
   616→    console.log(chalk.yellow(result.message));
   617→    console.log('');
   618→
   619→    for (const issue of result.issues) {
   620→      const icon =
   621→        issue.type === 'uncommitted_changes'
   622→          ? chalk.yellow('⚠')
   623→          : issue.type === 'in_progress_task'
   624→            ? chalk.blue('●')
   625→            : chalk.gray('○');
   626→      console.log(`  ${icon} ${issue.description}`);
   627→    }
   628→
   629→    if (result.instructions.length > 0) {
   630→      console.log('');
   631→      for (const instruction of result.instructions) {
   632→        console.log(chalk.gray(instruction));
   633→      }
   634→    }
   635→  }
   636→}
   637→
   638→function formatSessionContext(ctx: SessionContext, options: SessionOptions): void {
   639→  const isBrief = !options.full;
   640→
   641→  // Header
   642→  console.log(chalk.bold.blue('\n=== Session Context ==='));
   643→  const age = formatRelativeTime(new Date(ctx.generated_at));
   644→  if (ctx.branch) {
   645→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   646→  } else {
   647→    console.log(chalk.gray(`Generated: ${age}`));
   648→  }
   649→
   650→  // Stats summary
   651→  const inboxNote = ctx.stats.inbox_items > 0
   652→    ? ` | Inbox: ${ctx.stats.inbox_items}`
   653→    : '';
   654→  console.log(
   655→    chalk.gray(
   656→      `Tasks: ${ctx.stats.in_progress} active, ${ctx.stats.ready} ready, ` +
   657→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`
   658→    )
   659→  );
   660→
   661→  // Active tasks section
   662→  if (ctx.active_tasks.length > 0) {
   663→    console.log(chalk.bold.cyan('\n--- Active Work ---'));
   664→    for (const task of ctx.active_tasks) {
   665→      const started = task.started_at
   666→        ? chalk.gray(` (started ${formatRelativeTime(new Date(task.started_at))})`)
   667→        : '';
   668→      const priority =
   669→        task.priority <= 2
   670→          ? chalk.red(`P${task.priority}`)
   671→          : chalk.gray(`P${task.priority}`);
   672→      console.log(
   673→        `  ${chalk.blue('[in_progress]')} ${priority} ${task.ref} ${task.title}${started}`
   674→      );
   675→    }
   676→  } else {
   677→    console.log(chalk.gray('\n--- No Active Work ---'));
   678→  }
   679→
   680→  // Recently completed section
   681→  if (ctx.recently_completed.length > 0) {
   682→    console.log(chalk.bold.green('\n--- Recently Completed ---'));
   683→    for (const task of ctx.recently_completed) {
   684→      const completedAge = formatRelativeTime(new Date(task.completed_at));
   685→      let reason = '';
   686→      if (task.closed_reason) {
   687→        const maxLen = isBrief ? 60 : 120;
   688→        const truncated = task.closed_reason.length > maxLen
   689→          ? task.closed_reason.slice(0, maxLen).trim() + '...'
   690→          : task.closed_reason;
   691→        reason = chalk.gray(` - ${truncated}`);
   692→      }
   693→      console.log(
   694→        `  ${chalk.green('[completed]')} ${task.ref} ${task.title} ${chalk.gray(`(${completedAge})`)}${reason}`
   695→      );
   696→    }
   697→  }
   698→
   699→  // Recent notes section
   700→  if (ctx.recent_notes.length > 0) {
   701→    console.log(chalk.bold.cyan('\n--- Recent Notes ---'));
   702→    for (const note of ctx.recent_notes) {
   703→      const age = formatRelativeTime(new Date(note.created_at));
   704→      const author = note.author ? chalk.gray(` by ${note.author}`) : '';
   705→      console.log(`  ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
   706→
   707→      // Truncate content in brief mode
   708→      let content = note.content.trim();
   709→      if (isBrief && content.length > 200) {
   710→        content = content.slice(0, 200).trim() + '...';
   711→      }
   712→
   713→      // Indent content, limit lines in brief mode
   714→      const lines = content.split('\n');
   715→      const maxLines = isBrief ? 3 : lines.length;
   716→      for (const line of lines.slice(0, maxLines)) {
   717→        console.log(`    ${chalk.white(line)}`);
   718→      }
   719→      if (isBrief && lines.length > maxLines) {
   720→        console.log(chalk.gray(`    ... (${lines.length - maxLines} more lines)`));
   721→      }
   722→    }
   723→  }
   724→
   725→  // Incomplete todos section
   726→  if (ctx.active_todos.length > 0) {
   727→    console.log(chalk.bold.yellow('\n--- Incomplete Todos ---'));
   728→    for (const todo of ctx.active_todos) {
   729→      console.log(`  ${chalk.yellow('[ ]')} ${todo.task_ref}#${todo.id}: ${todo.text}`);
   730→    }
   731→  }
   732→
   733→  // Ready tasks section
   734→  if (ctx.ready_tasks.length > 0) {
   735→    console.log(chalk.bold.cyan('\n--- Ready to Pick Up ---'));
   736→    for (const task of ctx.ready_tasks) {
   737→      const priority =
   738→        task.priority <= 2
   739→          ? chalk.red(`P${task.priority}`)
   740→          : chalk.gray(`P${task.priority}`);
   741→      const tags =
   742→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(' #')}`) : '';
   743→      console.log(`  ${priority} ${task.ref} ${task.title}${tags}`);
   744→    }
   745→  }
   746→
   747→  // Blocked tasks section
   748→  if (ctx.blocked_tasks.length > 0) {
   749→    console.log(chalk.bold.red('\n--- Blocked ---'));
   750→    for (const task of ctx.blocked_tasks) {
   751→      console.log(`  ${chalk.red('[blocked]')} ${task.ref} ${task.title}`);
   752→      if (task.blocked_by.length > 0) {
   753→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(', ')}`));
   754→      }
   755→      if (task.unmet_deps.length > 0) {
   756→        console.log(chalk.gray(`    Waiting on: ${task.unmet_deps.join(', ')}`));
   757→      }
   758→    }
   759→  }
   760→
   761→  // Git commits section
   762→  if (ctx.recent_commits.length > 0) {
   763→    console.log(chalk.bold.cyan('\n--- Recent Commits ---'));
   764→    for (const commit of ctx.recent_commits) {
   765→      const age = formatRelativeTime(new Date(commit.date));
   766→      console.log(
   767→        `  ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${age}, ${commit.author})`)}`
   768→      );
   769→    }
   770→  }
   771→
   772→  // Inbox section (oldest first to encourage triage)
   773→  if (ctx.inbox_items.length > 0) {
   774→    console.log(chalk.bold.magenta('\n--- Inbox (oldest first) ---'));
   775→    for (const item of ctx.inbox_items) {
   776→      const age = formatRelativeTime(new Date(item.created_at));
   777→      const author = item.added_by ? ` by ${item.added_by}` : '';
   778→      const tags = item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(', ')}]`) : '';
   779→      // Truncate text in brief mode
   780→      let text = item.text;
   781→      if (isBrief && text.length > 60) {
   782→        text = text.slice(0, 60).trim() + '...';
   783→      }
   784→      console.log(`  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`);
   785→      console.log(`    ${text}`);
   786→    }
   787→    console.log(chalk.gray('  Use: kspec inbox promote <ref> to convert to task'));
   788→  }
   789→
   790→  // Working tree section
   791→  if (ctx.working_tree && !ctx.working_tree.clean) {
   792→    console.log(chalk.bold.yellow('\n--- Working Tree ---'));
   793→
   794→    if (ctx.working_tree.staged.length > 0) {
   795→      console.log(chalk.green('  Staged:'));
   796→      for (const file of ctx.working_tree.staged) {
   797→        console.log(`    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`);
   798→      }
   799→    }
   800→
   801→    if (ctx.working_tree.unstaged.length > 0) {
   802→      console.log(chalk.red('  Modified:'));
   803→      for (const file of ctx.working_tree.unstaged) {
   804→        console.log(`    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`);
   805→      }
   806→    }
   807→
   808→    if (ctx.working_tree.untracked.length > 0) {
   809→      console.log(chalk.gray('  Untracked:'));
   810→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
   811→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
   812→        console.log(`    ${chalk.gray('?')} ${path}`);
   813→      }
   814→      if (isBrief && ctx.working_tree.untracked.length > limit) {
   815→        console.log(chalk.gray(`    ... and ${ctx.working_tree.untracked.length - limit} more`));
   816→      }
   817→    }
   818→  } else if (ctx.working_tree?.clean) {
   819→    console.log(chalk.gray('\n--- Working Tree: Clean ---'));
   820→  }
   821→
   822→  // Quick Commands section - contextual hints based on state
   823→  const hints: string[] = [];
   824→
   825→  if (ctx.active_tasks.length > 0) {
   826→    const ref = ctx.active_tasks[0].ref;
   827→    hints.push(`kspec task note @${ref} "Progress..."  ${chalk.gray('# document work')}`);
   828→    hints.push(`kspec task complete @${ref} --reason "..."  ${chalk.gray('# finish task')}`);
   829→  } else if (ctx.ready_tasks.length > 0) {
   830→    const ref = ctx.ready_tasks[0].ref;
   831→    hints.push(`kspec task start @${ref}  ${chalk.gray('# begin work')}`);
   832→  }
   833→
   834→  if (ctx.inbox_items.length > 0) {
   835→    const ref = ctx.inbox_items[0].ref;
   836→    hints.push(`kspec inbox promote @${ref} --title "..."  ${chalk.gray('# convert to task')}`);
   837→  }
   838→
   839→  if (ctx.working_tree && !ctx.working_tree.clean) {
   840→    hints.push(`git add . && git commit -m "..."  ${chalk.gray('# commit changes')}`);
   841→  }
   842→
   843→  if (hints.length > 0) {
   844→    console.log(chalk.bold.gray('\n--- Quick Commands ---'));
   845→    for (const hint of hints) {
   846→      console.log(`  ${hint}`);
   847→    }
   848→  }
   849→
   850→  console.log(''); // Final newline
   851→}
   852→
   853→// ─── Command Registration ────────────────────────────────────────────────────
   854→
   855→async function sessionStartAction(options: SessionOptions): Promise<void> {
   856→  try {
   857→    const ctx = await initContext();
   858→
   859→    // AC-2: Pull remote changes before showing session context
   860→    let syncResult: ShadowSyncResult | null = null;
   861→    if (ctx.shadow?.enabled) {
   862→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
   863→      // AC-3: Warn about conflicts but continue with local state
   864→      if (syncResult.hadConflict) {
   865→        console.log(
   866→          chalk.yellow('⚠ Shadow sync conflict detected. Run `kspec shadow resolve` to fix.')
   867→        );
   868→        console.log(chalk.gray('  Continuing with local state...'));
   869→        console.log('');
   870→      } else if (syncResult.pulled) {
   871→        console.log(chalk.gray('ℹ Synced shadow branch from remote'));
   872→      }
   873→    }
   874→
   875→    const sessionCtx = await gatherSessionContext(ctx, options);
   876→
   877→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
   878→  } catch (err) {
   879→    error('Failed to gather session context', err);
   880→    process.exit(1);
   881→  }
   882→}
   883→
   884→/**
   885→ * Read stdin if available (non-blocking check for hook input)
   886→ */
   887→async function readStdinIfAvailable(): Promise<string | null> {
   888→  // Check if stdin is a TTY (interactive) - if so, don't try to read
   889→  if (process.stdin.isTTY) {
   890→    return null;
   891→  }
   892→
   893→  return new Promise((resolve) => {
   894→    let data = '';
   895→    const timeout = setTimeout(() => {
   896→      process.stdin.removeAllListeners();
   897→      resolve(data || null);
   898→    }, 100); // 100ms timeout for stdin
   899→
   900→    process.stdin.setEncoding('utf8');
   901→    process.stdin.on('data', (chunk) => {
   902→      data += chunk;
   903→    });
   904→    process.stdin.on('end', () => {
   905→      clearTimeout(timeout);
   906→      resolve(data || null);
   907→    });
   908→    process.stdin.on('error', () => {
   909→      clearTimeout(timeout);
   910→      resolve(null);
   911→    });
   912→    process.stdin.resume();
   913→  });
   914→}
   915→
   916→/**
   917→ * Parse Claude Code hook input from stdin
   918→ */
   919→function parseHookInput(stdin: string | null): StopHookInput | null {
   920→  if (!stdin) return null;
   921→  try {
   922→    return JSON.parse(stdin.trim()) as StopHookInput;
   923→  } catch {
   924→    return null;
   925→  }
   926→}
   927→
   928→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
   929→
   930→/**
   931→ * Output spec-first reminder for UserPromptSubmit hook.
   932→ *
   933→ * This is a simple context injection - always outputs the reminder,
   934→ * and Claude (Opus) is smart enough to apply it when relevant.
   935→ */
   936→async function sessionPromptCheckAction(): Promise<void> {
   937→  // Lean, instructive reminder with kspec prefix
   938→  console.log(
   939→    '[kspec] Before implementing behavior changes, check spec coverage. Update spec first if needed.'
   940→  );
   941→}
   942→
   943→async function sessionCheckpointAction(options: CheckpointOptions): Promise<void> {
   944→  try {
   945→    // Read stdin for Claude Code hook input
   946→    const stdin = await readStdinIfAvailable();
   947→    const hookInput = parseHookInput(stdin);
   948→
   949→    // Check if this is a retry (stop hook already active)
   950→    if (hookInput?.stop_hook_active) {
   951→      options.stopHookActive = true;
   952→    }
   953→
   954→    const ctx = await initContext();
   955→    const result = await performCheckpoint(ctx, options);
   956→
   957→    // Output format depends on mode:
   958→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
   959→    // - Human mode: Output formatted checkpoint result
   960→    if (isJsonMode()) {
   961→      if (!result.ok) {
   962→        // Build reason message with issues and instructions
   963→        const issueLines = result.issues.map(i => `- ${i.description}`).join('\n');
   964→        const instructionLines = result.instructions.filter(i => i.trim()).join('\n');
   965→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
   966→        console.log(JSON.stringify({ decision: 'block', reason }));
   967→      }
   968→      // If ok, exit silently (Claude Code expects no output when allowing stop)
   969→    } else {
   970→      formatCheckpointResult(result);
   971→      if (!result.ok) {
   972→        process.exit(1);
   973→      }
   974→    }
   975→  } catch (err) {
   976→    error('Failed to run checkpoint', err);
   977→    process.exit(1);
   978→  }
   979→}
   980→
   981→/**
   982→ * Register the 'session' command group and aliases
   983→ */
   984→export function registerSessionCommands(program: Command): void {
   985→  const session = program
   986→    .command('session')
   987→    .description('Session management and context');
   988→
   989→  session
   990→    .command('start')
   991→    .alias('resume')
   992→    .description('Surface relevant context for starting a new working session')
   993→    .option('--brief', 'Compact summary (default)')
   994→    .option('--full', 'Comprehensive context dump')
   995→    .option('--since <time>', 'Filter by recency (ISO8601 or relative: 1h, 2d, 1w)')
   996→    .option('--no-git', 'Skip git commit information')
   997→    .option('-n, --limit <n>', 'Limit items per section', '5')
   998→    .action(sessionStartAction);
   999→
  1000→  session
  1001→    .command('checkpoint')
  1002→    .description('Pre-stop hook: check for uncommitted work before ending session')
  1003→    .option('--force', 'Allow session end regardless of issues')
  1004→    .action(sessionCheckpointAction);
  1005→
  1006→  session
  1007→    .command('prompt-check')
  1008→    .description('UserPromptSubmit hook: inject spec-first reminder')
  1009→    .action(sessionPromptCheckAction);
  1010→
  1011→  // Top-level alias: kspec context
  1012→  program
  1013→    .command('context')
  1014→    .description('Alias for session start - surface session context')
  1015→    .option('--brief', 'Compact summary (default)')
  1016→    .option('--full', 'Comprehensive context dump')
  1017→    .option('--since <time>', 'Filter by recency (ISO8601 or relative: 1h, 2d, 1w)')
  1018→    .option('--no-git', 'Skip git commit information')
  1019→    .option('-n, --limit <n>', 'Limit items per section', '5')
  1020→    .action(sessionStartAction);
  1021→}
