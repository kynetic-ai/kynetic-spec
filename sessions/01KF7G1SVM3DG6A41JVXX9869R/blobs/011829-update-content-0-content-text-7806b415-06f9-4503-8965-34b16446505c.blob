```
     1→import { Command } from 'commander';
     2→import chalk from 'chalk';
     3→import {
     4→  initContext,
     5→  buildIndexes,
     6→  createSpecItem,
     7→  deleteSpecItem,
     8→  updateSpecItem,
     9→  addChildItem,
    10→  loadAllItems,
    11→  loadAllTasks,
    12→  ReferenceIndex,
    13→  AlignmentIndex,
    14→  checkSlugUniqueness,
    15→  patchSpecItems,
    16→  type LoadedSpecItem,
    17→  type PatchOperation,
    18→  type BulkPatchResult,
    19→} from '../../parser/index.js';
    20→import { commitIfShadow } from '../../parser/shadow.js';
    21→import type { ItemFilter } from '../../parser/items.js';
    22→import type { ItemType, Maturity, ImplementationStatus, SpecItemInput, AcceptanceCriterion } from '../../schema/index.js';
    23→import { SpecItemPatchSchema } from '../../schema/index.js';
    24→import { output, error, success, warn, isJsonMode } from '../output.js';
    25→import { grepItem, formatMatchedFields } from '../../utils/grep.js';
    26→
    27→/**
    28→ * Format a spec item for display
    29→ */
    30→function formatItem(item: LoadedSpecItem, verbose = false, grepPattern?: string): string {
    31→  const shortId = item._ulid.slice(0, 8);
    32→  const slugStr = item.slugs.length > 0 ? chalk.cyan(`@${item.slugs[0]}`) : '';
    33→  const typeStr = chalk.gray(`[${item.type}]`);
    34→
    35→  let status = '';
    36→  if (item.status && typeof item.status === 'object') {
    37→    const s = item.status as { maturity?: string; implementation?: string };
    38→    if (s.implementation) {
    39→      const implColor = s.implementation === 'verified' ? chalk.green
    40→        : s.implementation === 'implemented' ? chalk.cyan
    41→          : s.implementation === 'in_progress' ? chalk.yellow
    42→            : chalk.gray;
    43→      status = implColor(s.implementation);
    44→    } else if (s.maturity) {
    45→      status = chalk.gray(s.maturity);
    46→    }
    47→  }
    48→
    49→  let line = `${chalk.gray(shortId)} ${typeStr} ${item.title}`;
    50→  if (slugStr) line += ` ${slugStr}`;
    51→  if (status) line += ` ${status}`;
    52→
    53→  if (verbose) {
    54→    const tags = 'tags' in item && Array.isArray(item.tags) ? item.tags : [];
    55→    if (tags.length > 0) {
    56→      line += chalk.blue(` #${tags.join(' #')}`);
    57→    }
    58→  }
    59→
    60→  // Show matched fields if grep pattern provided
    61→  if (grepPattern) {
    62→    const match = grepItem(item as unknown as Record<string, unknown>, grepPattern);
    63→    if (match && match.matchedFields.length > 0) {
    64→      line += '\n  ' + chalk.gray(`matched: ${formatMatchedFields(match.matchedFields)}`);
    65→    }
    66→  }
    67→
    68→  return line;
    69→}
    70→
    71→/**
    72→ * Format item list for display
    73→ */
    74→function formatItemList(items: LoadedSpecItem[], verbose = false, grepPattern?: string): void {
    75→  if (items.length === 0) {
    76→    console.log(chalk.gray('No items found'));
    77→    return;
    78→  }
    79→
    80→  for (const item of items) {
    81→    console.log(formatItem(item, verbose, grepPattern));
    82→  }
    83→
    84→  console.log(chalk.gray(`\n${items.length} item(s)`));
    85→}
    86→
    87→/**
    88→ * Register item commands
    89→ */
    90→export function registerItemCommands(program: Command): void {
    91→  const item = program
    92→    .command('item')
    93→    .description('Spec item commands');
    94→
    95→  // kspec item list
    96→  item
    97→    .command('list')
    98→    .description('List spec items with optional filters')
    99→    .option('-t, --type <type>', 'Filter by item type (module, feature, requirement, constraint, decision)')
   100→    .option('-s, --status <status>', 'Filter by implementation status (not_started, in_progress, implemented, verified)')
   101→    .option('-m, --maturity <maturity>', 'Filter by maturity (draft, proposed, stable, deprecated)')
   102→    .option('--tag <tag>', 'Filter by tag (can specify multiple)', (val, prev: string[]) => [...prev, val], [])
   103→    .option('--has <field>', 'Filter items that have field present', (val, prev: string[]) => [...prev, val], [])
   104→    .option('-q, --search <text>', 'Search in title')
   105→    .option('-g, --grep <pattern>', 'Search content with regex pattern')
   106→    .option('-v, --verbose', 'Show more details')
   107→    .option('--limit <n>', 'Limit results', '50')
   108→    .action(async (options) => {
   109→      try {
   110→        const ctx = await initContext();
   111→        const { itemIndex, items } = await buildIndexes(ctx);
   112→
   113→        // Build filter from options
   114→        const filter: ItemFilter = {
   115→          specItemsOnly: true, // Only spec items, not tasks
   116→        };
   117→
   118→        if (options.type) {
   119→          filter.type = options.type as ItemType;
   120→        }
   121→
   122→        if (options.status) {
   123→          filter.implementation = options.status as ImplementationStatus;
   124→        }
   125→
   126→        if (options.maturity) {
   127→          filter.maturity = options.maturity as Maturity;
   128→        }
   129→
   130→        if (options.tag && options.tag.length > 0) {
   131→          filter.tags = options.tag;
   132→        }
   133→
   134→        if (options.has && options.has.length > 0) {
   135→          filter.hasFields = options.has;
   136→        }
   137→
   138→        if (options.search) {
   139→          filter.titleContains = options.search;
   140→        }
   141→
   142→        if (options.grep) {
   143→          filter.grepSearch = options.grep;
   144→        }
   145→
   146→        const limit = parseInt(options.limit, 10) || 50;
   147→        const result = itemIndex.queryPaginated(filter, 0, limit);
   148→
   149→        // Filter to only LoadedSpecItem (not tasks)
   150→        const specItems = result.items.filter((item): item is LoadedSpecItem =>
   151→          !('status' in item && typeof item.status === 'string')
   152→        );
   153→
   154→        output(
   155→          {
   156→            items: specItems,
   157→            total: result.total,
   158→            showing: specItems.length,
   159→            grepPattern: options.grep,
   160→          },
   161→          () => formatItemList(specItems, options.verbose, options.grep)
   162→        );
   163→      } catch (err) {
   164→        error('Failed to list items', err);
   165→        process.exit(1);
   166→      }
   167→    });
   168→
   169→  // kspec item get <ref>
   170→  item
   171→    .command('get <ref>')
   172→    .description('Get details for a specific item')
   173→    .action(async (ref) => {
   174→      try {
   175→        const ctx = await initContext();
   176→        const { refIndex, items } = await buildIndexes(ctx);
   177→
   178→        const result = refIndex.resolve(ref);
   179→
   180→        if (!result.ok) {
   181→          error(`Item not found: ${ref}`);
   182→          process.exit(1);
   183→        }
   184→
   185→        const item = result.item as LoadedSpecItem;
   186→
   187→        output(item, () => {
   188→          console.log(chalk.bold(item.title));
   189→          console.log(chalk.gray('─'.repeat(40)));
   190→          console.log(`ULID:      ${item._ulid}`);
   191→          if (item.slugs.length > 0) {
   192→            console.log(`Slugs:     ${item.slugs.join(', ')}`);
   193→          }
   194→          console.log(`Type:      ${item.type}`);
   195→
   196→          if (item.status && typeof item.status === 'object') {
   197→            const s = item.status as { maturity?: string; implementation?: string };
   198→            if (s.maturity) console.log(`Maturity:  ${s.maturity}`);
   199→            if (s.implementation) console.log(`Implementation: ${s.implementation}`);
   200→          }
   201→
   202→          if ('tags' in item && Array.isArray(item.tags) && item.tags.length > 0) {
   203→            console.log(`Tags:      ${item.tags.join(', ')}`);
   204→          }
   205→
   206→          if (item.description) {
   207→            console.log(chalk.gray('\n─── Description ───'));
   208→            console.log(item.description);
   209→          }
   210→
   211→          if ('acceptance_criteria' in item && Array.isArray(item.acceptance_criteria) && item.acceptance_criteria.length > 0) {
   212→            console.log(chalk.gray('\n─── Acceptance Criteria ───'));
   213→            for (const ac of item.acceptance_criteria) {
   214→              if (ac && typeof ac === 'object' && 'id' in ac) {
   215→                const acObj = ac as AcceptanceCriterion;
   216→                console.log(chalk.cyan(`  [${acObj.id}]`));
   217→                if (acObj.given) console.log(`    Given: ${acObj.given}`);
   218→                if (acObj.when) console.log(`    When: ${acObj.when}`);
   219→                if (acObj.then) console.log(`    Then: ${acObj.then}`);
   220→              }
   221→            }
   222→          }
   223→        });
   224→      } catch (err) {
   225→        error('Failed to get item', err);
   226→        process.exit(1);
   227→      }
   228→    });
   229→
   230→  // kspec item types - show available types and counts
   231→  item
   232→    .command('types')
   233→    .description('Show item types and counts')
   234→    .action(async () => {
   235→      try {
   236→        const ctx = await initContext();
   237→        const { itemIndex } = await buildIndexes(ctx);
   238→
   239→        const typeCounts = itemIndex.getTypeCounts();
   240→
   241→        output(
   242→          Object.fromEntries(typeCounts),
   243→          () => {
   244→            console.log(chalk.bold('Item Types'));
   245→            console.log(chalk.gray('─'.repeat(30)));
   246→            for (const [type, count] of typeCounts) {
   247→              console.log(`  ${type}: ${count}`);
   248→            }
   249→            console.log(chalk.gray(`\nTotal: ${itemIndex.size} items`));
   250→          }
   251→        );
   252→      } catch (err) {
   253→        error('Failed to get types', err);
   254→        process.exit(1);
   255→      }
   256→    });
   257→
   258→  // kspec item tags - show available tags and counts
   259→  item
   260→    .command('tags')
   261→    .description('Show tags and counts')
   262→    .action(async () => {
   263→      try {
   264→        const ctx = await initContext();
   265→        const { itemIndex } = await buildIndexes(ctx);
   266→
   267→        const tagCounts = itemIndex.getTagCounts();
   268→
   269→        output(
   270→          Object.fromEntries(tagCounts),
   271→          () => {
   272→            console.log(chalk.bold('Tags'));
   273→            console.log(chalk.gray('─'.repeat(30)));
   274→            for (const [tag, count] of tagCounts) {
   275→              console.log(`  #${tag}: ${count}`);
   276→            }
   277→          }
   278→        );
   279→      } catch (err) {
   280→        error('Failed to get tags', err);
