   284→
   285→  // kspec item add - create a new spec item under a parent
   286→  item
   287→    .command('add')
   288→    .description('Create a new spec item under a parent')
   289→    .requiredOption('--under <ref>', 'Parent item reference (e.g., @core-primitives)')
   290→    .requiredOption('--title <title>', 'Item title')
   291→    .option('--type <type>', 'Item type (feature, requirement, constraint, decision)', 'feature')
   292→    .option('--slug <slug>', 'Human-friendly slug')
   293→    .option('--priority <priority>', 'Priority (high, medium, low)')
   294→    .option('--tag <tag...>', 'Tags')
   295→    .option('--description <desc>', 'Description')
   296→    .option('--as <field>', 'Child field override (e.g., requirements, constraints)')
   297→    .action(async (options) => {
   298→      try {
   299→        const ctx = await initContext();
   300→        const { refIndex, items } = await buildIndexes(ctx);
   301→
   302→        // Find the parent item
   303→        const parentResult = refIndex.resolve(options.under);
   304→        if (!parentResult.ok) {
   305→          error(`Parent item not found: ${options.under}`);
   306→          process.exit(1);
   307→        }
   308→
   309→        const parent = parentResult.item as LoadedSpecItem;
   310→
   311→        // Check it's not a task
   312→        if ('status' in parent && typeof parent.status === 'string') {
   313→          error(`"${options.under}" is a task. Items can only be added under spec items.`);
   314→          process.exit(1);
   315→        }
   316→
   317→        // Check slug uniqueness if provided
   318→        if (options.slug) {
   319→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   320→          if (!slugCheck.ok) {
   321→            error(`Slug '${slugCheck.slug}' already exists (used by ${slugCheck.existingUlid})`);
   322→            process.exit(1);
   323→          }
   324→        }
   325→
   326→        const input: SpecItemInput = {
   327→          title: options.title,
   328→          type: options.type as ItemType,
   329→          slugs: options.slug ? [options.slug] : [],
   330→          priority: options.priority,
   331→          tags: options.tag || [],
   332→          description: options.description,
   333→          depends_on: [],
   334→          implements: [],
   335→          relates_to: [],
   336→          tests: [],
   337→        };
   338→
   339→        const newItem = createSpecItem(input);
   340→        const result = await addChildItem(ctx, parent, newItem, options.as);
   341→
   342→        // Build index including the new item for accurate short ULID
   343→        const index = new ReferenceIndex([], [...items, result.item as LoadedSpecItem]);
   344→        const itemSlug = (result.item as LoadedSpecItem).slugs?.[0] || index.shortUlid(result.item._ulid);
   345→        await commitIfShadow(ctx.shadow, 'item-add', itemSlug);
   346→        success(`Created item: ${index.shortUlid(result.item._ulid)} under @${parent.slugs[0] || parent._ulid.slice(0, 8)}`, {
   347→          item: result.item,
   348→          path: result.path,
   349→        });
   350→
   351→        // Derive hint
   352→        if (!isJsonMode()) {
   353→          const refSlug = (result.item as LoadedSpecItem).slugs?.[0] || index.shortUlid(result.item._ulid);
   354→          console.log(chalk.gray(`\nDerive implementation task? kspec derive @${refSlug}`));
   355→        }
   356→      } catch (err) {
   357→        error('Failed to create item', err);
   358→        process.exit(1);
   359→      }
   360→    });
   361→
   362→  // kspec item set - update a spec item field
   363→  item
   364→    .command('set <ref>')
   365→    .description('Update a spec item field')
   366→    .option('--title <title>', 'Set title')
   367→    .option('--type <type>', 'Set type')
   368→    .option('--slug <slug>', 'Add a slug')
   369→    .option('--remove-slug <slug>', 'Remove a slug')
   370→    .option('--priority <priority>', 'Set priority')
   371→    .option('--tag <tag...>', 'Set tags (replaces existing)')
   372→    .option('--description <desc>', 'Set description')
   373→    .option('--status <status>', 'Set implementation status (not_started, in_progress, implemented, verified)')
   374→    .option('--maturity <maturity>', 'Set maturity (draft, proposed, stable, deprecated)')
   375→    .action(async (ref, options) => {
   376→      try {
   377→        const ctx = await initContext();
   378→        const { refIndex, items } = await buildIndexes(ctx);
   379→
   380→        const result = refIndex.resolve(ref);
   381→        if (!result.ok) {
   382→          error(`Item not found: ${ref}`);
   383→          process.exit(1);
   384→        }
   385→
   386→        const foundItem = result.item as LoadedSpecItem;
   387→
   388→        // Check if it's a task (tasks should use task commands)
   389→        if ('status' in foundItem && typeof foundItem.status === 'string') {
   390→          error(`"${ref}" is a task. Use 'kspec task' commands instead.`);
   391→          process.exit(1);
   392→        }
   393→
   394→        // Check slug uniqueness if adding a new slug
   395→        if (options.slug) {
   396→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug], foundItem._ulid);
   397→          if (!slugCheck.ok) {
   398→            error(`Slug '${slugCheck.slug}' already exists (used by ${slugCheck.existingUlid})`);
   399→            process.exit(1);
   400→          }
   401→        }
   402→
   403→        // Validate --remove-slug
   404→        if (options.removeSlug) {
   405→          const currentSlugs = foundItem.slugs || [];
   406→          if (!currentSlugs.includes(options.removeSlug)) {
   407→            error(`Slug '${options.removeSlug}' not found on item`);
   408→            process.exit(1);
   409→          }
   410→          if (currentSlugs.length === 1) {
   411→            error(`Cannot remove last slug '${options.removeSlug}' - items must have at least one slug`);
   412→            process.exit(1);
   413→          }
   414→        }
   415→
   416→        // Build updates object
   417→        const updates: Partial<SpecItemInput> = {};
   418→
   419→        if (options.title) updates.title = options.title;
   420→        if (options.type) updates.type = options.type as ItemType;
   421→        if (options.slug || options.removeSlug) {
   422→          let slugs = [...(foundItem.slugs || [])];
   423→          if (options.removeSlug) {
   424→            slugs = slugs.filter(s => s !== options.removeSlug);
   425→          }
   426→          if (options.slug) {
   427→            slugs.push(options.slug);
   428→          }
   429→          updates.slugs = slugs;
   430→        }
   431→        if (options.priority) updates.priority = options.priority;
   432→        if (options.tag) updates.tags = options.tag;
   433→        if (options.description) updates.description = options.description;
   434→
   435→        // Handle status updates
   436→        if (options.status || options.maturity) {
   437→          const currentStatus = foundItem.status && typeof foundItem.status === 'object'
   438→            ? foundItem.status
   439→            : {};
   440→          updates.status = {
   441→            ...currentStatus,
   442→            ...(options.status && { implementation: options.status }),
   443→            ...(options.maturity && { maturity: options.maturity }),
   444→          };
   445→        }
   446→
   447→        if (Object.keys(updates).length === 0) {
   448→          warn('No updates specified');
   449→          return;
   450→        }
   451→
   452→        const updated = await updateSpecItem(ctx, foundItem, updates);
   453→        const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   454→        await commitIfShadow(ctx.shadow, 'item-set', itemSlug);
   455→        success(`Updated item: ${refIndex.shortUlid(updated._ulid)}`, { item: updated });
   456→
   457→        // Derive hint
   458→        if (!isJsonMode()) {
   459→          const refSlug = updated.slugs?.[0] || refIndex.shortUlid(updated._ulid);
   460→          console.log(chalk.gray(`\nDerive implementation task? kspec derive @${refSlug}`));
   461→        }
   462→      } catch (err) {
   463→        error('Failed to update item', err);
   464→        process.exit(1);
   465→      }
   466→    });
   467→
   468→  // kspec item delete - delete a spec item
   469→  item
   470→    .command('delete <ref>')
   471→    .description('Delete a spec item (including nested items)')
   472→    .option('--force', 'Skip confirmation')
   473→    .action(async (ref, options) => {
   474→      try {
   475→        const ctx = await initContext();
   476→        const { refIndex, items } = await buildIndexes(ctx);
   477→
   478→        const result = refIndex.resolve(ref);
   479→        if (!result.ok) {
   480→          error(`Item not found: ${ref}`);
   481→          process.exit(1);
   482→        }
   483→
   484→        const foundItem = result.item as LoadedSpecItem;
   485→
   486→        // Check if it's a task
   487→        if ('status' in foundItem && typeof foundItem.status === 'string') {
   488→          error(`"${ref}" is a task. Use 'kspec task cancel' instead.`);
   489→          process.exit(1);
   490→        }
   491→
   492→        if (!foundItem._sourceFile) {
   493→          error('Cannot delete item: no source file tracked');
   494→          process.exit(1);
   495→        }
   496→
   497→        // Warn about nested children being deleted too
   498→        // TODO: could add a check here for child items
   499→
   500→        const deleted = await deleteSpecItem(ctx, foundItem);
   501→        if (deleted) {
   502→          const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   503→          await commitIfShadow(ctx.shadow, 'item-delete', itemSlug);
   504→          success(`Deleted item: ${foundItem.title}`, { deleted: true, ulid: foundItem._ulid });
   505→        } else {
   506→          error('Failed to delete item');
   507→          console.log(chalk.gray('Edit the source file directly: ' + foundItem._sourceFile));
   508→          process.exit(1);
   509→        }
   510→      } catch (err) {
   511→        error('Failed to delete item', err);
   512→        process.exit(1);
   513→      }
   514→    });
   515→
   516→  // kspec item patch - update item fields via JSON
   517→  item
   518→    .command('patch [ref]')
   519→    .description('Update spec item fields via JSON patch')
   520→    .option('--data <json>', 'JSON data to patch')
   521→    .option('--bulk', 'Read patches from stdin (JSONL or JSON array)')
   522→    .option('--allow-unknown', 'Allow fields not in schema')
   523→    .option('--dry-run', 'Preview changes without applying')
   524→    .option('--fail-fast', 'Stop on first error (bulk mode)')
   525→    .action(async (ref: string | undefined, options) => {
   526→      try {
   527→        const ctx = await initContext();
   528→
   529→        if (options.bulk) {
   530→          // Bulk mode: read from stdin
   531→          const stdin = await readStdinFully();
   532→          if (!stdin) {
   533→            error('No input provided. Use --data for single item or pipe JSONL/JSON for bulk.');
   534→            process.exit(1);
   535→          }
   536→
   537→          let patches: PatchOperation[];
   538→          try {
   539→            patches = parseBulkInput(stdin);
   540→          } catch (err) {
   541→            error('Failed to parse bulk input', err instanceof Error ? err.message : err);
   542→            process.exit(1);
   543→          }
   544→
   545→          if (patches.length === 0) {
   546→            error('No patches provided');
   547→            process.exit(1);
   548→          }
   549→
   550→          const { refIndex, items } = await buildIndexes(ctx);
   551→          const result = await patchSpecItems(ctx, refIndex, items, patches, {
   552→            allowUnknown: options.allowUnknown,
   553→            failFast: options.failFast,
   554→            dryRun: options.dryRun,
   555→          });
   556→
   557→          // Shadow commit if any updates
   558→          if (!options.dryRun && result.summary.updated > 0) {
   559→            await commitIfShadow(ctx.shadow, 'item-patch', `${result.summary.updated} items`);
   560→          }
   561→
   562→          output(result, () => formatBulkPatchResult(result, options.dryRun));
   563→
   564→          if (result.summary.failed > 0) {
   565→            process.exit(1);
   566→          }
   567→        } else {
   568→          // Single item mode
   569→          if (!ref) {
   570→            error('Reference required for single item patch. Use: kspec item patch <ref> --data <json>');
   571→            process.exit(1);
   572→          }
   573→
   574→          let data: Record<string, unknown>;
   575→
   576→          // Get data from --data option or stdin
   577→          if (options.data) {
   578→            try {
   579→              data = JSON.parse(options.data);
   580→            } catch (err) {
   581→              error('Invalid JSON in --data', err instanceof Error ? err.message : 'Parse error');
   582→              process.exit(1);
   583→            }
   584→          } else {
   585→            const stdin = await readStdinIfAvailable();
   586→            if (stdin) {
   587→              try {
   588→                data = JSON.parse(stdin.trim());
   589→              } catch (err) {
   590→                error('Invalid JSON from stdin', err instanceof Error ? err.message : 'Parse error');
   591→                process.exit(1);
   592→              }
   593→            } else {
   594→              error('No patch data. Use --data or pipe JSON to stdin.');
   595→              process.exit(1);
   596→            }
   597→          }
   598→
   599→          // Validate against schema (unless --allow-unknown)
   600→          if (!options.allowUnknown) {
   601→            // Use strict schema (no passthrough)
   602→            const strictSchema = SpecItemPatchSchema.strict();
   603→            const parseResult = strictSchema.safeParse(data);
   604→            if (!parseResult.success) {
   605→              const issues = parseResult.error.issues.map(i => `${i.path.join('.')}: ${i.message}`).join('; ');
   606→              error(`Invalid patch data: ${issues}`);
   607→              process.exit(1);
   608→            }
   609→          }
   610→
   611→          const { refIndex, items } = await buildIndexes(ctx);
   612→
   613→          // Resolve ref
   614→          const resolved = refIndex.resolve(ref);
   615→          if (!resolved.ok) {
   616→            error(`Item not found: ${ref}`);
   617→            process.exit(1);
   618→          }
   619→
   620→          // Find the item
   621→          const foundItem = items.find(i => i._ulid === resolved.ulid);
   622→          if (!foundItem) {
   623→            error(`Not a spec item: ${ref}`);
   624→            process.exit(1);
   625→          }
   626→
   627→          if (options.dryRun) {
   628→            output({ ref, data, wouldApplyTo: foundItem.title, ulid: foundItem._ulid }, () => {
   629→              console.log(chalk.yellow('Would patch:'), foundItem.title);
   630→              console.log(chalk.gray('ULID:'), foundItem._ulid.slice(0, 8));
   631→              console.log(chalk.gray('Changes:'));
   632→              console.log(JSON.stringify(data, null, 2));
   633→            });
   634→            return;
   635→          }
   636→
   637→          const updated = await updateSpecItem(ctx, foundItem, data);
   638→          const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   639→          await commitIfShadow(ctx.shadow, 'item-patch', itemSlug);
   640→
   641→          success(`Patched item: ${itemSlug}`, { item: updated });
   642→        }
   643→      } catch (err) {
   644→        error('Failed to patch item(s)', err);
   645→        process.exit(1);
   646→      }
   647→    });
   648→
   649→  // kspec item status - show implementation status with linked tasks
   650→  item
   651→    .command('status <ref>')
   652→    .description('Show implementation status and linked tasks for a spec item')
   653→    .action(async (ref) => {
   654→      try {
   655→        const ctx = await initContext();
   656→        const tasks = await loadAllTasks(ctx);
   657→        const items = await loadAllItems(ctx);
   658→        const refIndex = new ReferenceIndex(tasks, items);
   659→
   660→        const result = refIndex.resolve(ref);
   661→        if (!result.ok) {
   662→          error(`Item not found: ${ref}`);
   663→          process.exit(1);
   664→        }
   665→
   666→        const foundItem = result.item as LoadedSpecItem;
   667→
   668→        // Check if it's a task
   669→        if ('status' in foundItem && typeof foundItem.status === 'string') {
   670→          error(`"${ref}" is a task, not a spec item. Use 'kspec task get' instead.`);
   671→          process.exit(1);
   672→        }
   673→
   674→        // Build alignment index
   675→        const alignmentIndex = new AlignmentIndex(tasks, items);
   676→        alignmentIndex.buildLinks(refIndex);
   677→
   678→        const summary = alignmentIndex.getImplementationSummary(foundItem._ulid);
   679→
   680→        if (!summary) {
   681→          error('Could not get implementation summary');
   682→          process.exit(1);
   683→        }
   684→
   685→        output(summary, () => {
   686→          console.log(chalk.bold(foundItem.title));
   687→          console.log(chalk.gray('─'.repeat(40)));
   688→
   689→          // Status
   690→          const currentColor = summary.currentStatus === 'implemented' ? chalk.green
   691→            : summary.currentStatus === 'in_progress' ? chalk.yellow
   692→              : chalk.gray;
   693→          const expectedColor = summary.expectedStatus === 'implemented' ? chalk.green
   694→            : summary.expectedStatus === 'in_progress' ? chalk.yellow
   695→              : chalk.gray;
   696→
   697→          console.log(`Current status:  ${currentColor(summary.currentStatus)}`);
   698→          console.log(`Expected status: ${expectedColor(summary.expectedStatus)}`);
   699→
   700→          if (!summary.isAligned) {
   701→            console.log(chalk.yellow('\n⚠ Status mismatch - run task complete to sync'));
   702→          } else {
   703→            console.log(chalk.green('\n✓ Aligned'));
   704→          }
   705→
   706→          // Linked tasks
   707→          console.log(chalk.bold('\nLinked Tasks:'));
   708→          if (summary.linkedTasks.length === 0) {
   709→            console.log(chalk.gray('  No tasks reference this spec item'));
   710→          } else {
   711→            for (const task of summary.linkedTasks) {
   712→              const statusColor = task.taskStatus === 'completed' ? chalk.green
   713→                : task.taskStatus === 'in_progress' ? chalk.blue
   714→                  : chalk.gray;
   715→              const shortId = task.taskUlid.slice(0, 8);
   716→              const notes = task.hasNotes ? chalk.gray(' (has notes)') : '';
   717→              console.log(`  ${statusColor(`[${task.taskStatus}]`)} ${shortId} ${task.taskTitle}${notes}`);
   718→            }
   719→          }
   720→        });
   721→      } catch (err) {
   722→        error('Failed to get item status', err);
   723→        process.exit(1);
   724→      }
   725→    });
   726→
   727→  // Create subcommand group for acceptance criteria operations
   728→  const acCmd = item
   729→    .command('ac')
   730→    .description('Manage acceptance criteria on spec items');
   731→
   732→  // Helper: Generate next AC ID based on existing AC
   733→  function generateNextAcId(existingAc: AcceptanceCriterion[] | undefined): string {
   734→    if (!existingAc || existingAc.length === 0) return 'ac-1';
   735→
   736→    const numericIds = existingAc
   737→      .map(ac => ac.id.match(/^ac-(\d+)$/)?.[1])
   738→      .filter((id): id is string => id !== null && id !== undefined)
   739→      .map(Number);
   740→
   741→    const maxId = numericIds.length > 0 ? Math.max(...numericIds) : 0;
   742→    return `ac-${maxId + 1}`;
   743→  }
   744→
   745→  // Helper: Resolve ref to spec item (not task)
   746→  async function resolveSpecItem(ref: string): Promise<{ ctx: Awaited<ReturnType<typeof initContext>>; item: LoadedSpecItem; refIndex: ReferenceIndex }> {
   747→    const ctx = await initContext();
   748→    const { refIndex, items } = await buildIndexes(ctx);
   749→
   750→    const result = refIndex.resolve(ref);
   751→    if (!result.ok) {
   752→      error(`Item not found: ${ref}`);
   753→      process.exit(3);
   754→    }
   755→
   756→    const foundItem = result.item as LoadedSpecItem;
   757→
   758→    // Check if it's a task
   759→    if ('status' in foundItem && typeof foundItem.status === 'string') {
   760→      error(`Tasks don't have acceptance criteria; "${ref}" is a task`);
   761→      process.exit(3);
   762→    }
   763→
   764→    return { ctx, item: foundItem, refIndex };
   765→  }
   766→
   767→  // kspec item ac list <ref>
   768→  acCmd
   769→    .command('list <ref>')
   770→    .description('List acceptance criteria for a spec item')
   771→    .action(async (ref: string) => {
   772→      try {
   773→        const { item, refIndex } = await resolveSpecItem(ref);
   774→        const ac = item.acceptance_criteria || [];
   775→
   776→        output(ac, () => {
   777→          console.log(chalk.bold(`Acceptance Criteria for: ${item.title} (@${item.slugs[0] || refIndex.shortUlid(item._ulid)})`));
   778→          console.log();
   779→
   780→          if (ac.length === 0) {
   781→            console.log(chalk.gray('No acceptance criteria'));
   782→          } else {
   783→            for (const criterion of ac) {
   784→              console.log(chalk.cyan(`  [${criterion.id}]`));
   785→              console.log(chalk.gray(`    Given: ${criterion.given}`));
   786→              console.log(chalk.gray(`    When:  ${criterion.when}`));
   787→              console.log(chalk.gray(`    Then:  ${criterion.then}`));
   788→              console.log();
   789→            }
   790→          }
   791→
   792→          console.log(chalk.gray(`${ac.length} acceptance criteria`));
   793→        });
   794→      } catch (err) {
   795→        error('Failed to list acceptance criteria', err);
   796→        process.exit(1);
   797→      }
   798→    });
   799→
   800→  // kspec item ac add <ref>
   801→  acCmd
   802→    .command('add <ref>')
   803→    .description('Add an acceptance criterion to a spec item')
   804→    .option('--id <id>', 'AC identifier (auto-generated if not provided)')
   805→    .requiredOption('--given <text>', 'The precondition (Given...)')
   806→    .requiredOption('--when <text>', 'The action/trigger (When...)')
   807→    .requiredOption('--then <text>', 'The expected outcome (Then...)')
   808→    .action(async (ref: string, options) => {
   809→      try {
   810→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
   811→        const existingAc = item.acceptance_criteria || [];
   812→
   813→        // Determine ID
   814→        const acId = options.id || generateNextAcId(existingAc);
   815→
   816→        // Check for duplicate ID
   817→        if (existingAc.some(ac => ac.id === acId)) {
   818→          error(`Acceptance criterion "${acId}" already exists on @${item.slugs[0] || refIndex.shortUlid(item._ulid)}`);
   819→          process.exit(3);
   820→        }
   821→
   822→        // Create new AC
   823→        const newAc: AcceptanceCriterion = {
   824→          id: acId,
   825→          given: options.given,
   826→          when: options.when,
   827→          then: options.then,
   828→        };
   829→
   830→        // Update item with new AC
   831→        const updatedAc = [...existingAc, newAc];
   832→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
   833→
   834→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
   835→        await commitIfShadow(ctx.shadow, 'item-ac-add', itemSlug);
   836→        success(`Added acceptance criterion: ${acId} to @${itemSlug}`, { ac: newAc });
   837→      } catch (err) {
   838→        error('Failed to add acceptance criterion', err);
   839→        process.exit(1);
   840→      }
   841→    });
   842→
   843→  // kspec item ac set <ref> <ac-id>
   844→  acCmd
   845→    .command('set <ref> <acId>')
   846→    .description('Update an acceptance criterion')
   847→    .option('--id <newId>', 'Rename the AC ID')
   848→    .option('--given <text>', 'Update the precondition')
   849→    .option('--when <text>', 'Update the action/trigger')
   850→    .option('--then <text>', 'Update the expected outcome')
   851→    .action(async (ref: string, acId: string, options) => {
   852→      try {
   853→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
   854→        const existingAc = item.acceptance_criteria || [];
   855→
   856→        // Find the AC
   857→        const acIndex = existingAc.findIndex(ac => ac.id === acId);
   858→        if (acIndex === -1) {
   859→          error(`Acceptance criterion "${acId}" not found on @${item.slugs[0] || refIndex.shortUlid(item._ulid)}`);
   860→          process.exit(3);
   861→        }
   862→
   863→        // Check for no updates
   864→        if (!options.id && !options.given && !options.when && !options.then) {
   865→          warn('No updates specified');
   866→          return;
   867→        }
   868→
   869→        // Check for duplicate ID if renaming
   870→        if (options.id && options.id !== acId && existingAc.some(ac => ac.id === options.id)) {
   871→          error(`Acceptance criterion "${options.id}" already exists`);
   872→          process.exit(3);
   873→        }
   874→
   875→        // Build updated AC
   876→        const updatedAc = [...existingAc];
   877→        const updatedFields: string[] = [];
   878→
   879→        updatedAc[acIndex] = {
   880→          ...updatedAc[acIndex],
   881→          ...(options.id && { id: options.id }),
   882→          ...(options.given && { given: options.given }),
   883→          ...(options.when && { when: options.when }),
   884→          ...(options.then && { then: options.then }),
   885→        };
   886→
   887→        if (options.id) updatedFields.push('id');
   888→        if (options.given) updatedFields.push('given');
   889→        if (options.when) updatedFields.push('when');
   890→        if (options.then) updatedFields.push('then');
   891→
   892→        // Update item
   893→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
   894→
   895→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
   896→        await commitIfShadow(ctx.shadow, 'item-ac-set', itemSlug);
   897→        success(`Updated acceptance criterion: ${acId} on @${itemSlug} (${updatedFields.join(', ')})`, { ac: updatedAc[acIndex] });
   898→      } catch (err) {
   899→        error('Failed to update acceptance criterion', err);
   900→        process.exit(1);
   901→      }
   902→    });
   903→
   904→  // kspec item ac remove <ref> <ac-id>
   905→  acCmd
   906→    .command('remove <ref> <acId>')
   907→    .description('Remove an acceptance criterion')
   908→    .option('--force', 'Skip confirmation')
   909→    .action(async (ref: string, acId: string, options) => {
   910→      try {
   911→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
   912→        const existingAc = item.acceptance_criteria || [];
   913→
   914→        // Find the AC
   915→        const acIndex = existingAc.findIndex(ac => ac.id === acId);
   916→        if (acIndex === -1) {
   917→          error(`Acceptance criterion "${acId}" not found on @${item.slugs[0] || refIndex.shortUlid(item._ulid)}`);
   918→          process.exit(3);
   919→        }
   920→
   921→        // TODO: Add confirmation prompt when !options.force
   922→        // For now, proceed with deletion
   923→
   924→        // Remove the AC
   925→        const updatedAc = existingAc.filter(ac => ac.id !== acId);
   926→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
   927→
   928→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
   929→        await commitIfShadow(ctx.shadow, 'item-ac-remove', itemSlug);
   930→        success(`Removed acceptance criterion: ${acId} from @${itemSlug}`, { removed: acId });
   931→      } catch (err) {
   932→        error('Failed to remove acceptance criterion', err);
   933→        process.exit(1);
   934→      }
   935→    });
   936→}
   937→
   938→// ─── Patch Helpers ───────────────────────────────────────────────────────────
   939→
   940→/**
   941→ * Read stdin fully with timeout (for bulk input).
   942→ * Returns null if stdin is a TTY or empty.
   943→ */
   944→async function readStdinFully(): Promise<string | null> {
   945→  if (process.stdin.isTTY) {
   946→    return null;
   947→  }
   948→
   949→  return new Promise((resolve) => {
   950→    let data = '';
   951→    const timeout = setTimeout(() => {
   952→      process.stdin.removeAllListeners();
   953→      resolve(data || null);
   954→    }, 5000); // 5 second timeout for bulk input
   955→
   956→    process.stdin.setEncoding('utf8');
   957→    process.stdin.on('data', (chunk) => {
   958→      data += chunk;
   959→    });
   960→    process.stdin.on('end', () => {
   961→      clearTimeout(timeout);
   962→      resolve(data || null);
   963→    });
   964→    process.stdin.on('error', () => {
   965→      clearTimeout(timeout);
   966→      resolve(null);
   967→    });
   968→    process.stdin.resume();
   969→  });
   970→}
   971→
   972→/**
   973→ * Read stdin if available (non-blocking for single item mode).
   974→ * Returns null quickly if no data available.
   975→ */
   976→async function readStdinIfAvailable(): Promise<string | null> {
   977→  if (process.stdin.isTTY) {
   978→    return null;
   979→  }
   980→
   981→  return new Promise((resolve) => {
   982→    let data = '';
   983→    const timeout = setTimeout(() => {
   984→      process.stdin.removeAllListeners();
   985→      resolve(data || null);
   986→    }, 100); // 100ms timeout for quick check
   987→
   988→    process.stdin.setEncoding('utf8');
   989→    process.stdin.on('data', (chunk) => {
   990→      data += chunk;
   991→    });
   992→    process.stdin.on('end', () => {
   993→      clearTimeout(timeout);
   994→      resolve(data || null);
   995→    });
   996→    process.stdin.on('error', () => {
   997→      clearTimeout(timeout);
   998→      resolve(null);
   999→    });
  1000→    process.stdin.resume();
  1001→  });
  1002→}
  1003→
  1004→/**
  1005→ * Parse bulk input (JSONL or JSON array)
  1006→ */
  1007→function parseBulkInput(input: string): PatchOperation[] {
  1008→  const trimmed = input.trim();
  1009→
  1010→  // Try JSON array first
  1011→  if (trimmed.startsWith('[')) {
  1012→    const parsed = JSON.parse(trimmed);
  1013→    if (!Array.isArray(parsed)) {
  1014→      throw new Error('Expected JSON array');
  1015→    }
  1016→    return parsed.map((item, i) => validatePatchOperation(item, i));
  1017→  }
  1018→
  1019→  // Parse as JSONL (one JSON object per line)
  1020→  const lines = trimmed.split('\n').filter(line => line.trim());
  1021→  return lines.map((line, i) => {
  1022→    try {
  1023→      return validatePatchOperation(JSON.parse(line), i);
  1024→    } catch (err) {
  1025→      throw new Error(`Line ${i + 1}: ${err instanceof Error ? err.message : 'Invalid JSON'}`);
  1026→    }
  1027→  });
  1028→}
  1029→
  1030→/**
  1031→ * Validate a patch operation object
  1032→ */
  1033→function validatePatchOperation(obj: unknown, index: number): PatchOperation {
  1034→  if (!obj || typeof obj !== 'object') {
  1035→    throw new Error(`Item ${index + 1}: Patch must be an object`);
  1036→  }
  1037→  const op = obj as Record<string, unknown>;
  1038→  if (typeof op.ref !== 'string' || !op.ref) {
  1039→    throw new Error(`Item ${index + 1}: Patch must have "ref" string`);
  1040→  }
  1041→  if (!op.data || typeof op.data !== 'object') {
  1042→    throw new Error(`Item ${index + 1}: Patch must have "data" object`);
  1043→  }
  1044→  return { ref: op.ref, data: op.data as Record<string, unknown> };
  1045→}
  1046→
  1047→/**
  1048→ * Format bulk patch result for human output
  1049→ */
  1050→function formatBulkPatchResult(result: BulkPatchResult, isDryRun = false): void {
  1051→  const prefix = isDryRun ? 'Would patch' : 'Patched';
  1052→
  1053→  for (const r of result.results) {
  1054→    if (r.status === 'updated') {
  1055→      console.log(chalk.green('OK'), `${prefix}: ${r.ref} (${r.ulid?.slice(0, 8)})`);
  1056→    } else if (r.status === 'error') {
  1057→      console.log(chalk.red('ERR'), `${r.ref}: ${r.error}`);
  1058→    } else {
  1059→      console.log(chalk.gray('SKIP'), r.ref);
  1060→    }
  1061→  }
  1062→
  1063→  console.log('');
  1064→  console.log(chalk.bold('Summary:'));
  1065→  console.log(`  Total: ${result.summary.total}`);
  1066→  console.log(chalk.green(`  Updated: ${result.summary.updated}`));
  1067→  if (result.summary.failed > 0) {
  1068→    console.log(chalk.red(`  Failed: ${result.summary.failed}`));
  1069→  }
  1070→  if (result.summary.skipped > 0) {
  1071→    console.log(chalk.gray(`  Skipped: ${result.summary.skipped}`));
  1072→  }
  1073→}
  1074→

