  1409→+  });
  1410→+
  1411→+  // AC: @workflow-definitions ac-workflow-1
  1412→+  it('should output table with ID, Trigger, Steps columns', () => {
  1413→+    const output = kspec('meta workflows', tempDir);
  1414→+
  1415→+    // Should contain table headers
  1416→+    expect(output).toContain('ID');
  1417→+    expect(output).toContain('Trigger');
  1418→+    expect(output).toContain('Steps');
  1419→+
  1420→+    // Should contain workflow data from fixtures
  1421→+    expect(output).toContain('task-start');
  1422→+    expect(output).toContain('Before starting a task');
  1423→+    expect(output).toContain('4'); // 4 steps
  1424→+
  1425→+    expect(output).toContain('commit');
  1426→+    expect(output).toContain('After completing a task');
  1427→+    expect(output).toContain('3'); // 3 steps
  1428→+  });
  1429→+
  1430→+  // AC: @workflow-definitions ac-workflow-2
  1431→+  it('should output verbose format with full step details', () => {
  1432→+    const output = kspec('meta workflows --verbose', tempDir);
  1433→+
  1434→+    // Should contain workflow headers
  1435→+    expect(output).toContain('task-start - Before starting a task');
  1436→+    expect(output).toContain('Pre-task checklist workflow');
  1437→+
  1438→+    // Should contain step type prefixes
  1439→+    expect(output).toContain('[check]');
  1440→+    expect(output).toContain('[action]');
  1441→+    expect(output).toContain('[decision]');
  1442→+
  1443→+    // Should contain step content
  1444→+    expect(output).toContain('Read the spec item linked to the task');
  1445→+    expect(output).toContain('Verify all dependencies are completed');
  1446→+    expect(output).toContain('Add initial note documenting approach');
  1447→+
  1448→+    // Should contain on_fail for checks
  1449→+    expect(output).toContain('on fail: Cannot proceed without spec context');
  1450→+    expect(output).toContain('on fail: Block task and note missing dependencies');
  1451→+
  1452→+    // Should contain decision options
  1453→+    expect(output).toContain('Does this need plan mode?');
  1454→+    expect(output).toContain('Yes - enter plan mode');
  1455→+    expect(output).toContain('No - proceed with implementation');
  1456→+
  1457→+    // Should contain second workflow
  1458→+    expect(output).toContain('commit - After completing a task');
  1459→+    expect(output).toContain('All tests passing');
  1460→+    expect(output).toContain('on fail: Fix failing tests before committing');
  1461→+  });
  1462→+
  1463→+  // AC: @workflow-definitions ac-workflow-4
  1464→+  it('should output JSON array with full workflow details', () => {
  1465→+    interface WorkflowJson {
  1466→+      id: string;
  1467→+      trigger: string;
  1468→+      description: string;
  1469→+      steps: Array<{
  1470→+        type: string;
  1471→+        content: string;
  1472→+        on_fail?: string;
  1473→+        options?: string[];
  1474→+      }>;
  1475→+    }
  1476→+
  1477→+    const workflows = kspecJson<WorkflowJson[]>('meta workflows', tempDir);
  1478→+
  1479→+    // Should be an array with 2 workflows
  1480→+    expect(Array.isArray(workflows)).toBe(true);
  1481→+    expect(workflows).toHaveLength(2);
  1482→+
  1483→+    // First workflow
  1484→+    const taskStart = workflows.find(w => w.id === 'task-start');
  1485→+    expect(taskStart).toBeDefined();
  1486→+    expect(taskStart?.trigger).toBe('Before starting a task');
  1487→+    expect(taskStart?.description).toBe('Pre-task checklist workflow');
  1488→+    expect(taskStart?.steps).toHaveLength(4);
  1489→+
  1490→+    // Check step details
  1491→+    const firstStep = taskStart?.steps[0];
  1492→+    expect(firstStep?.type).toBe('check');
  1493→+    expect(firstStep?.content).toBe('Read the spec item linked to the task');
  1494→+    expect(firstStep?.on_fail).toBe('Cannot proceed without spec context');
  1495→+
  1496→+    const decisionStep = taskStart?.steps[3];
  1497→+    expect(decisionStep?.type).toBe('decision');
  1498→+    expect(decisionStep?.content).toBe('Does this need plan mode?');
  1499→+    expect(decisionStep?.options).toEqual([
  1500→+      'Yes - enter plan mode',
  1501→+      'No - proceed with implementation',
  1502→+    ]);
  1503→+
  1504→+    // Second workflow
  1505→+    const commit = workflows.find(w => w.id === 'commit');
  1506→+    expect(commit).toBeDefined();
  1507→+    expect(commit?.trigger).toBe('After completing a task');
  1508→+    expect(commit?.steps).toHaveLength(3);
  1509→+  });
  1510→+
  1511→+  it('should handle empty workflows list gracefully', async () => {
  1512→+    // Create a meta manifest with no workflows
  1513→+    const emptyMetaPath = path.join(tempDir, 'kynetic.meta.yaml');
  1514→+    await fs.writeFile(emptyMetaPath, 'kynetic_meta: "1.0"\nworkflows: []\n');
  1515→+
  1516→+    const output = kspec('meta workflows', tempDir);
  1517→+    expect(output).toContain('No workflows defined');
  1518→+  });
  1519→+
  1520→+  it('should handle missing meta manifest gracefully', async () => {
  1521→+    // Remove meta manifest file entirely
  1522→+    const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
  1523→+    await fs.rm(metaPath, { force: true });
  1524→+
  1525→+    const output = kspec('meta workflows', tempDir);
  1526→+    expect(output).toContain('No workflows defined');
  1527→+  });
  1528→+
  1529→+  // AC: @workflow-definitions ac-workflow-3
  1530→+  it('should validate workflow references in meta_ref', async () => {
  1531→+    // Add a task with meta_ref pointing to a valid workflow
  1532→+    const tasksPath = path.join(tempDir, 'project.tasks.yaml');
  1533→+    let tasksContent = await fs.readFile(tasksPath, 'utf-8');
  1534→+
  1535→+    const newTask = `
