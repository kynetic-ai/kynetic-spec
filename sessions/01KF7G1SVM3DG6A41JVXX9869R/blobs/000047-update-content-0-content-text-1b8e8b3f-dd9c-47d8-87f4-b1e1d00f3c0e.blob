  1176→@@ -0,0 +1,761 @@
  1177→+/**
  1178→+ * Integration tests for kspec meta commands
  1179→+ * AC: @agent-definitions ac-agent-1, ac-agent-2, ac-agent-3
  1180→+ * AC: @workflow-definitions ac-workflow-1, ac-workflow-2, ac-workflow-3, ac-workflow-4
  1181→+ */
  1182→+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
  1183→+import * as fs from 'node:fs/promises';
  1184→+import * as path from 'node:path';
  1185→+import * as os from 'node:os';
  1186→+import { execSync } from 'node:child_process';
  1187→+
  1188→+const FIXTURES_DIR = path.join(__dirname, 'fixtures');
  1189→+const CLI_PATH = path.join(__dirname, '..', 'src', 'cli', 'index.ts');
  1190→+
  1191→+/**
  1192→+ * Run a kspec CLI command and return stdout
  1193→+ */
  1194→+function kspec(args: string, cwd: string): string {
  1195→+  const cmd = `npx tsx ${CLI_PATH} ${args}`;
  1196→+  try {
  1197→+    return execSync(cmd, {
  1198→+      cwd,
  1199→+      encoding: 'utf-8',
  1200→+      env: { ...process.env, KSPEC_AUTHOR: '@test' },
  1201→+    }).trim();
  1202→+  } catch (error: unknown) {
  1203→+    const execError = error as { stdout?: string; stderr?: string; message?: string };
  1204→+    // Return stdout even on error (some commands exit non-zero with valid output)
  1205→+    if (execError.stdout) return execError.stdout.trim();
  1206→+    throw new Error(`Command failed: ${cmd}\n${execError.stderr || execError.message}`);
  1207→+  }
  1208→+}
  1209→+
  1210→+/**
  1211→+ * Run kspec and return JSON output
  1212→+ */
  1213→+function kspecJson<T>(args: string, cwd: string): T {
  1214→+  const output = kspec(`${args} --json`, cwd);
  1215→+  return JSON.parse(output);
  1216→+}
  1217→+
  1218→+/**
  1219→+ * Copy fixtures to a temp directory for isolated testing
  1220→+ */
  1221→+async function setupTempFixtures(): Promise<string> {
  1222→+  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-test-'));
  1223→+  await fs.cp(FIXTURES_DIR, tempDir, { recursive: true });
  1224→+  return tempDir;
  1225→+}
  1226→+
  1227→+/**
  1228→+ * Clean up temp directory
  1229→+ */
  1230→+async function cleanupTempDir(dir: string): Promise<void> {
  1231→+  await fs.rm(dir, { recursive: true, force: true });
  1232→+}
  1233→+
  1234→+describe('Integration: meta agents', () => {
  1235→+  let tempDir: string;
  1236→+
  1237→+  beforeEach(async () => {
  1238→+    tempDir = await setupTempFixtures();
  1239→+  });
  1240→+
  1241→+  afterEach(async () => {
  1242→+    await cleanupTempDir(tempDir);
  1243→+  });
  1244→+
  1245→+  // AC: @agent-definitions ac-agent-1
  1246→+  it('should output table with ID, Name, Capabilities columns', () => {
  1247→+    const output = kspec('meta agents', tempDir);
  1248→+
  1249→+    // Should contain table headers
  1250→+    expect(output).toContain('ID');
  1251→+    expect(output).toContain('Name');
  1252→+    expect(output).toContain('Capabilities');
  1253→+
  1254→+    // Should contain agent data from fixtures
  1255→+    expect(output).toContain('test-agent');
  1256→+    expect(output).toContain('Test Agent');
  1257→+    expect(output).toContain('code, test');
  1258→+
  1259→+    expect(output).toContain('review-agent');
  1260→+    expect(output).toContain('Review Agent');
  1261→+    expect(output).toContain('review, analyze');
  1262→+  });
  1263→+
  1264→+  // AC: @agent-definitions ac-agent-2
  1265→+  it('should output JSON array with full agent details', () => {
  1266→+    interface AgentJson {
  1267→+      id: string;
  1268→+      name: string;
  1269→+      description: string;
  1270→+      capabilities: string[];
  1271→+      tools: string[];
  1272→+      session_protocol: Record<string, string>;
  1273→+      conventions: string[];
  1274→+    }
  1275→+
  1276→+    const agents = kspecJson<AgentJson[]>('meta agents', tempDir);
  1277→+
  1278→+    // Should be an array (3 agents: test, test-agent, review-agent)
  1279→+    expect(Array.isArray(agents)).toBe(true);
  1280→+    expect(agents).toHaveLength(3);
  1281→+
  1282→+    // First agent
  1283→+    const testAgent = agents.find(a => a.id === 'test-agent');
  1284→+    expect(testAgent).toBeDefined();
  1285→+    expect(testAgent?.name).toBe('Test Agent');
  1286→+    expect(testAgent?.description).toBe('A test agent for integration testing');
  1287→+    expect(testAgent?.capabilities).toEqual(['code', 'test']);
  1288→+    expect(testAgent?.tools).toEqual(['kspec', 'git']);
  1289→+    expect(testAgent?.session_protocol).toEqual({
  1290→+      start: 'kspec session start',
  1291→+      checkpoint: 'kspec session checkpoint',
  1292→+    });
  1293→+    expect(testAgent?.conventions).toEqual([
  1294→+      'Test convention 1',
  1295→+      'Test convention 2',
  1296→+    ]);
  1297→+
  1298→+    // Second agent
  1299→+    const reviewAgent = agents.find(a => a.id === 'review-agent');
  1300→+    expect(reviewAgent).toBeDefined();
  1301→+    expect(reviewAgent?.name).toBe('Review Agent');
  1302→+    expect(reviewAgent?.capabilities).toEqual(['review', 'analyze']);
  1303→+    expect(reviewAgent?.tools).toEqual(['kspec']);
  1304→+  });
  1305→+
  1306→+  it('should handle empty agents list gracefully', async () => {
  1307→+    // Create a meta manifest with no agents
  1308→+    const emptyMetaPath = path.join(tempDir, 'kynetic.meta.yaml');
  1309→+    await fs.writeFile(emptyMetaPath, 'kynetic_meta: "1.0"\nagents: []\n');
  1310→+
  1311→+    const output = kspec('meta agents', tempDir);
  1312→+    expect(output).toContain('No agents defined');
  1313→+  });
  1314→+
  1315→+  it('should handle missing meta manifest gracefully', async () => {
  1316→+    // Remove meta manifest file entirely
  1317→+    const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
  1318→+    await fs.rm(metaPath, { force: true });
  1319→+
  1320→+    // Also remove reference from kynetic.yaml
  1321→+    const manifestPath = path.join(tempDir, 'kynetic.yaml');
  1322→+    let content = await fs.readFile(manifestPath, 'utf-8');
  1323→+    content = content.replace('meta_file: kynetic.meta.yaml\n', '');
  1324→+    await fs.writeFile(manifestPath, content);
  1325→+
  1326→+    const output = kspec('meta agents', tempDir);
  1327→+    // Should show empty result, not crash
  1328→+    expect(output).toContain('No agents defined');
  1329→+  });
  1330→+
  1331→+  // AC: @agent-definitions ac-agent-3
  1332→+  it('should validate agent references in notes', async () => {
  1333→+    // Add a task with a note that references a valid agent
  1334→+    const tasksPath = path.join(tempDir, 'project.tasks.yaml');
  1335→+    let tasksContent = await fs.readFile(tasksPath, 'utf-8');
  1336→+
  1337→+    // Add a task with a note containing a valid agent reference
  1338→+    const newTask = `
  1339→+  - _ulid: 01KF79C0H1ZHT2T4JMECS89ARS
  1340→+    title: Test task with agent reference in note
  1341→+    status: pending
  1342→+    priority: 1
  1343→+    created_at: "2024-01-01T00:00:00Z"
  1344→+    slugs:
  1345→+      - test-task-with-agent
  1346→+    depends_on: []
  1347→+    notes:
  1348→+      - _ulid: 01KF79C0H1ZHT2T4JMECS89AR1
  1349→+        created_at: "2024-01-01T00:00:00Z"
  1350→+        author: "@test-agent"
  1351→+        content: A note from a valid agent
  1352→+    todos: []
  1353→+    blocked_by: []
  1354→+    tags: []
  1355→+`;
  1356→+    tasksContent = tasksContent.replace('tasks:', `tasks:${newTask}`);
  1357→+    await fs.writeFile(tasksPath, tasksContent);
  1358→+
  1359→+    // Validate should pass because test-agent exists
  1360→+    const output = kspec('validate --refs', tempDir);
  1361→+    expect(output).toContain('References: OK');
  1362→+  });
  1363→+
  1364→+  // AC: @agent-definitions ac-agent-3
  1365→+  it('should error on invalid agent reference in notes', async () => {
  1366→+    // Add a task with a note that references a non-existent agent
  1367→+    const tasksPath = path.join(tempDir, 'project.tasks.yaml');
  1368→+    let tasksContent = await fs.readFile(tasksPath, 'utf-8');
  1369→+
  1370→+    const newTask = `
  1371→+  - _ulid: 01KF79C0H1C6H77ZSGMMVJF994
  1372→+    title: Test task with invalid agent reference
  1373→+    status: pending
  1374→+    priority: 1
  1375→+    created_at: "2024-01-01T00:00:00Z"
  1376→+    slugs:
  1377→+      - test-task-invalid-agent
  1378→+    depends_on: []
  1379→+    notes:
  1380→+      - _ulid: 01KF79C0H1C6H77ZSGMMVJF991
  1381→+        created_at: "2024-01-01T00:00:00Z"
  1382→+        author: "@nonexistent-agent"
  1383→+        content: A note from an invalid agent
  1384→+    todos: []
  1385→+    blocked_by: []
  1386→+    tags: []
  1387→+`;
  1388→+    tasksContent = tasksContent.replace('tasks:', `tasks:${newTask}`);
  1389→+    await fs.writeFile(tasksPath, tasksContent);
  1390→+
  1391→+    // Validation should fail with reference error
  1392→+    // kspec() returns stdout even on failure, so we get the output
  1393→+    const output = kspec('validate --refs', tempDir);
  1394→+    expect(output).toContain('✗ Validation failed');
  1395→+    expect(output).toContain('Reference "@nonexistent-agent" not found');
  1396→+    expect(output).toContain('author');
  1397→+  });
  1398→+});
  1399→+
  1400→+describe('Integration: meta workflows', () => {
  1401→+  let tempDir: string;
  1402→+
  1403→+  beforeEach(async () => {
  1404→+    tempDir = await setupTempFixtures();
  1405→+  });
  1406→+
  1407→+  afterEach(async () => {
