   180→+/**
   181→+ * Format agents table output
   182→+ * AC-agent-1: outputs table with columns: ID, Name, Capabilities
   183→+ */
   184→+function formatAgents(agents: Agent[]): void {
   185→+  if (agents.length === 0) {
   186→+    console.log(chalk.yellow('No agents defined'));
   187→+    return;
   188→+  }
   189→+
   190→+  const table = new Table({
   191→+    head: [chalk.bold('ID'), chalk.bold('Name'), chalk.bold('Capabilities')],
   192→+    style: {
   193→+      head: [],
   194→+      border: [],
   195→+    },
   196→+  });
   197→+
   198→+  for (const agent of agents) {
   199→+    table.push([
   200→+      agent.id,
   201→+      agent.name,
   202→+      agent.capabilities.join(', '),
   203→+    ]);
   204→+  }
   205→+
   206→+  console.log(table.toString());
   207→+}
   208→+
   209→+/**
   210→+ * Format workflows table output
   211→+ * AC-workflow-1: outputs table with columns: ID, Trigger, Steps (count)
   212→+ */
   213→+function formatWorkflows(workflows: Workflow[]): void {
   214→+  if (workflows.length === 0) {
   215→+    console.log(chalk.yellow('No workflows defined'));
   216→+    return;
   217→+  }
   218→+
   219→+  const table = new Table({
   220→+    head: [chalk.bold('ID'), chalk.bold('Trigger'), chalk.bold('Steps')],
   221→+    style: {
   222→+      head: [],
   223→+      border: [],
   224→+    },
   225→+  });
   226→+
   227→+  for (const workflow of workflows) {
   228→+    table.push([
   229→+      workflow.id,
   230→+      workflow.trigger,
   231→+      workflow.steps.length.toString(),
   232→+    ]);
   233→+  }
   234→+
   235→+  console.log(table.toString());
   236→+}
   237→+
   238→+/**
   239→+ * Format workflows verbose output
   240→+ * AC-workflow-2: outputs each workflow with full step list
   241→+ */
   242→+function formatWorkflowsVerbose(workflows: Workflow[]): void {
   243→+  if (workflows.length === 0) {
   244→+    console.log(chalk.yellow('No workflows defined'));
   245→+    return;
   246→+  }
   247→+
   248→+  for (const workflow of workflows) {
   249→+    console.log(chalk.bold(`${workflow.id} - ${workflow.trigger}`));
   250→+    if (workflow.description) {
   251→+      console.log(chalk.gray(workflow.description));
   252→+    }
   253→+    console.log(chalk.gray('─'.repeat(60)));
   254→+
   255→+    for (const step of workflow.steps) {
   256→+      const prefix = {
   257→+        check: chalk.yellow('[check]'),
   258→+        action: chalk.blue('[action]'),
   259→+        decision: chalk.magenta('[decision]'),
   260→+      }[step.type];
   261→+
   262→+      console.log(`${prefix} ${step.content}`);
   263→+
   264→+      if (step.on_fail) {
   265→+        console.log(chalk.gray(`  → on fail: ${step.on_fail}`));
   266→+      }
   267→+
   268→+      if (step.options && step.options.length > 0) {
   269→+        for (const option of step.options) {
   270→+          console.log(chalk.gray(`  • ${option}`));
   271→+        }
   272→+      }
   273→+    }
   274→+
   275→+    console.log('');
   276→+  }
   277→+}
   278→+
   279→+/**
   280→+ * Format observations table output
   281→+ * AC-obs-2: outputs table with columns: ID, Type, Workflow, Created, Content (truncated)
   282→+ */
   283→+function formatObservations(observations: Observation[], showResolved: boolean): void {
   284→+  const filtered = showResolved ? observations : observations.filter(o => !o.resolved);
   285→+
   286→+  if (filtered.length === 0) {
   287→+    console.log(chalk.yellow(showResolved ? 'No observations found' : 'No unresolved observations'));
   288→+    return;
   289→+  }
   290→+
   291→+  const table = new Table({
   292→+    head: [
   293→+      chalk.bold('ID'),
   294→+      chalk.bold('Type'),
   295→+      chalk.bold('Workflow'),
   296→+      chalk.bold('Created'),
   297→+      chalk.bold('Content'),
   298→+    ],
   299→+    style: {
   300→+      head: [],
   301→+      border: [],
   302→+    },
   303→+    colWidths: [10, 10, 20, 12, 50],
   304→+    wordWrap: true,
   305→+  });
   306→+
   307→+  for (const obs of filtered) {
   308→+    const id = obs._ulid.substring(0, 8);
   309→+    const workflow = obs.workflow_ref || '-';
   310→+    const created = new Date(obs.created_at).toISOString().split('T')[0];
   311→+    const content = obs.content.length > 47 ? obs.content.substring(0, 47) + '...' : obs.content;
   312→+
   313→+    table.push([id, obs.type, workflow, created, content]);
   314→+  }
   315→+
   316→+  console.log(table.toString());
   317→+}
