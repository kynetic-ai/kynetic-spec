   327→+  // AC-agent-1, AC-agent-2: kspec meta agents
   328→+  meta
   329→+    .command('agents')
   330→+    .description('List agents defined in meta-spec')
   331→+    .action(async () => {
   332→+      try {
   333→+        const ctx = await initContext();
   334→+
   335→+        if (!ctx.manifestPath) {
   336→+          error('No kspec project found');
   337→+          process.exit(1);
   338→+        }
   339→+
   340→+        const metaCtx = await loadMetaContext(ctx);
   341→+        const agents = metaCtx.manifest?.agents || [];
   342→+
   343→+        // AC-agent-2: JSON output includes full agent details
   344→+        output(
   345→+          agents.map((agent) => ({
   346→+            id: agent.id,
   347→+            name: agent.name,
   348→+            description: agent.description,
   349→+            capabilities: agent.capabilities,
   350→+            tools: agent.tools,
   351→+            session_protocol: agent.session_protocol,
   352→+            conventions: agent.conventions,
   353→+          })),
   354→+          // AC-agent-1: Table output with ID, Name, Capabilities
   355→+          () => formatAgents(agents)
   356→+        );
   357→+      } catch (err) {
   358→+        error('Failed to list agents', err);
   359→+        process.exit(1);
   360→+      }
   361→+    });
   362→+
   363→+  // AC-workflow-1, AC-workflow-2, AC-workflow-4: kspec meta workflows
   364→+  meta
   365→+    .command('workflows')
   366→+    .description('List workflows defined in meta-spec')
   367→+    .option('--verbose', 'Show full workflow details with all steps')
   368→+    .action(async (options) => {
   369→+      try {
   370→+        const ctx = await initContext();
   371→+
   372→+        if (!ctx.manifestPath) {
   373→+          error('No kspec project found');
   374→+          process.exit(1);
   375→+        }
   376→+
   377→+        const metaCtx = await loadMetaContext(ctx);
   378→+        const workflows = metaCtx.manifest?.workflows || [];
   379→+
   380→+        // AC-workflow-4: JSON output includes full workflow details
   381→+        output(
   382→+          workflows.map((workflow) => ({
   383→+            id: workflow.id,
   384→+            trigger: workflow.trigger,
   385→+            description: workflow.description,
   386→+            steps: workflow.steps,
   387→+          })),
   388→+          // AC-workflow-1 (table) or AC-workflow-2 (verbose)
   389→+          () => {
   390→+            if (options.verbose) {
   391→+              formatWorkflowsVerbose(workflows);
   392→+            } else {
   393→+              formatWorkflows(workflows);
   394→+            }
   395→+          }
   396→+        );
   397→+      } catch (err) {
   398→+        error('Failed to list workflows', err);
   399→+        process.exit(1);
   400→+      }
   401→+    });
   402→+
   403→+  // AC-obs-1: kspec meta observe <type> <content>
   404→+  meta
   405→+    .command('observe <type> <content>')
   406→+    .description('Create an observation (friction, success, question, idea)')
   407→+    .option('--workflow <ref>', 'Reference to workflow this observation relates to')
   408→+    .option('--author <author>', 'Author of the observation')
   409→+    .action(async (type: string, content: string, options) => {
   410→+      try {
   411→+        const ctx = await initContext();
   412→+
   413→+        if (!ctx.manifestPath) {
   414→+          error('No kspec project found');
   415→+          process.exit(1);
   416→+        }
   417→+
   418→+        // Validate observation type
   419→+        const validTypes: ObservationType[] = ['friction', 'success', 'question', 'idea'];
   420→+        if (!validTypes.includes(type as ObservationType)) {
   421→+          error(`Invalid observation type: ${type}`);
   422→+          console.log(`Valid types: ${validTypes.join(', ')}`);
   423→+          process.exit(1);
   424→+        }
   425→+
   426→+        // Create observation
   427→+        const observation = createObservation(type as ObservationType, content, {
   428→+          workflow_ref: options.workflow,
   429→+          author: options.author,
   430→+        });
   431→+
   432→+        // Save to manifest
   433→+        await saveObservation(ctx, observation);
   434→+
   435→+        // AC-obs-1: outputs "OK Created observation: <ULID-prefix>"
   436→+        success(`Created observation: ${observation._ulid.substring(0, 8)}`);
   437→+      } catch (err) {
   438→+        error('Failed to create observation', err);
   439→+        process.exit(1);
   440→+      }
   441→+    });
   442→+
   443→+  // AC-obs-2, AC-obs-5: kspec meta observations
   444→+  meta
   445→+    .command('observations')
   446→+    .description('List observations (shows unresolved by default)')
   447→+    .option('--all', 'Include resolved observations')
   448→+    .action(async (options) => {
   449→+      try {
   450→+        const ctx = await initContext();
   451→+
   452→+        if (!ctx.manifestPath) {
   453→+          error('No kspec project found');
   454→+          process.exit(1);
   455→+        }
   456→+
   457→+        const metaCtx = await loadMetaContext(ctx);
   458→+        const observations = metaCtx.observations || [];
   459→+
   460→+        // AC-obs-5: JSON output includes full observation objects
   461→+        output(
   462→+          observations.map((obs) => ({
   463→+            _ulid: obs._ulid,
   464→+            type: obs.type,
   465→+            content: obs.content,
   466→+            workflow_ref: obs.workflow_ref ?? null,
   467→+            created_at: obs.created_at,
   468→+            author: obs.author ?? null,
   469→+            resolved: obs.resolved,
   470→+            resolution: obs.resolution ?? null,
   471→+            resolved_at: obs.resolved_at ?? null,
   472→+            resolved_by: obs.resolved_by ?? null,
   473→+            promoted_to: obs.promoted_to ?? null,
   474→+          })),
   475→+          // AC-obs-2: Table output with ID, Type, Workflow, Created, Content
   476→+          () => formatObservations(observations, options.all)
   477→+        );
   478→+      } catch (err) {
   479→+        error('Failed to list observations', err);
   480→+        process.exit(1);
   481→+      }
   482→+    });
   483→+
   484→+  // AC-obs-3, AC-obs-6, AC-obs-8: kspec meta promote
   485→+  meta
   486→+    .command('promote <ref>')
   487→+    .description('Promote observation to a task')
   488→+    .requiredOption('--title <title>', 'Task title')
   489→+    .option('--priority <priority>', 'Task priority (1-3)', '2')
   490→+    .option('--force', 'Force promotion even if observation is resolved')
   491→+    .action(async (ref: string, options) => {
   492→+      try {
   493→+        const ctx = await initContext();
   494→+
   495→+        if (!ctx.manifestPath) {
   496→+          error('No kspec project found');
   497→+          process.exit(1);
   498→+        }
   499→+
   500→+        const metaCtx = await loadMetaContext(ctx);
   501→+        const observations = metaCtx.manifest?.observations || [];
   502→+
   503→+        // Find observation
   504→+        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   505→+        const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   506→+
   507→+        if (!observation) {
   508→+          error(`Observation not found: ${ref}`);
   509→+          process.exit(1);
   510→+        }
   511→+
   512→+        // AC-obs-6: Check if already promoted
   513→+        if (observation.promoted_to) {
   514→+          error(`Observation already promoted to task ${observation.promoted_to}; resolve or delete the task first`);
   515→+          process.exit(1);
   516→+        }
   517→+
   518→+        // AC-obs-8: Check if resolved
   519→+        if (observation.resolved && !options.force) {
   520→+          error(`Cannot promote resolved observation; use --force to override`);
   521→+          process.exit(1);
   522→+        }
   523→+
   524→+        // Create task directly using the API
   525→+        const task = createTask({
   526→+          title: options.title,
   527→+          priority: Number.parseInt(options.priority, 10),
   528→+          meta_ref: observation.workflow_ref,
   529→+        });
   530→+
   531→+        // Save task
   532→+        await saveTask(ctx, task);
   533→+        const taskRef = `@${task._ulid.substring(0, 8)}`;
   534→+
   535→+        // Update observation with promoted_to field
   536→+        observation.promoted_to = taskRef;
   537→+        await saveObservation(ctx, observation);
   538→+
   539→+        // AC-obs-3: outputs "OK Created task: <ULID-prefix>"
   540→+        success(`Created task: ${taskRef.substring(0, 9)}`);
   541→+      } catch (err) {
   542→+        error('Failed to promote observation', err);
   543→+        process.exit(1);
   544→+      }
   545→+    });
   546→+
   547→+  // AC-obs-4, AC-obs-7, AC-obs-9: kspec meta resolve
   548→+  meta
   549→+    .command('resolve <ref> [resolution]')
   550→+    .description('Resolve an observation')
   551→+    .action(async (ref: string, resolution: string | undefined) => {
   552→+      try {
   553→+        const ctx = await initContext();
   554→+
   555→+        if (!ctx.manifestPath) {
   556→+          error('No kspec project found');
   557→+          process.exit(1);
   558→+        }
   559→+
   560→+        const metaCtx = await loadMetaContext(ctx);
   561→+        const observations = metaCtx.manifest?.observations || [];
   562→+
   563→+        // Find observation
   564→+        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   565→+        const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   566→+
   567→+        if (!observation) {
   568→+          error(`Observation not found: ${ref}`);
   569→+          process.exit(1);
   570→+        }
   571→+
   572→+        // AC-obs-7: Check if already resolved
   573→+        if (observation.resolved) {
   574→+          const resolvedDate = new Date(observation.resolved_at!).toISOString().split('T')[0];
   575→+          const resolutionText = observation.resolution || '';
   576→+          const truncated = resolutionText.length > 50
   577→+            ? resolutionText.substring(0, 50) + '...'
   578→+            : resolutionText;
   579→+          error(`Observation already resolved on ${resolvedDate}: '${truncated}'`);
   580→+          process.exit(1);
   581→+        }
   582→+
   583→+        // AC-obs-9: Auto-populate resolution from task completion if promoted
   584→+        let finalResolution = resolution;
   585→+        if (!finalResolution && observation.promoted_to) {
   586→+          // TODO: Fetch task completion reason from promoted task
   587→+          // For now, just use a placeholder
   588→+          finalResolution = `Promoted to task ${observation.promoted_to}`;
   589→+        }
   590→+
   591→+        if (!finalResolution) {
   592→+          error('Resolution text is required');
   593→+          process.exit(1);
   594→+        }
   595→+
   596→+        // AC-obs-4: Update observation
   597→+        observation.resolved = true;
   598→+        observation.resolution = finalResolution;
   599→+        observation.resolved_at = new Date().toISOString();
   600→+        observation.resolved_by = observation.author; // Use same author
   601→+
   602→+        await saveObservation(ctx, observation);
   603→+
   604→+        // AC-obs-4: outputs "OK Resolved: <ULID-prefix>"
   605→+        success(`Resolved: ${observation._ulid.substring(0, 8)}`);
   606→+      } catch (err) {
   607→+        error('Failed to resolve observation', err);
   608→+        process.exit(1);
   609→+      }
   610→+    });
   611→ }
