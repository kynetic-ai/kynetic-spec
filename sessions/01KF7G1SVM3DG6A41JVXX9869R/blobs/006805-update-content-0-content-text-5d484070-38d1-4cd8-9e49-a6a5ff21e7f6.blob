```
     1→import { Command } from 'commander';
     2→import { ulid } from 'ulid';
     3→import {
     4→  initContext,
     5→  loadAllTasks,
     6→  loadAllItems,
     7→  saveTask,
     8→  deleteTask,
     9→  createTask,
    10→  createNote,
    11→  createTodo,
    12→  syncSpecImplementationStatus,
    13→  ReferenceIndex,
    14→  checkSlugUniqueness,
    15→  type LoadedTask,
    16→} from '../../parser/index.js';
    17→import { commitIfShadow } from '../../parser/shadow.js';
    18→import {
    19→  output,
    20→  formatTaskDetails,
    21→  success,
    22→  error,
    23→  warn,
    24→  info,
    25→  isJsonMode,
    26→} from '../output.js';
    27→import { formatCommitGuidance, printCommitGuidance } from '../../utils/commit.js';
    28→import type { Task, TaskInput } from '../../schema/index.js';
    29→
    30→/**
    31→ * Find a task by reference with detailed error reporting.
    32→ * Returns the task or exits with appropriate error.
    33→ */
    34→function resolveTaskRef(
    35→  ref: string,
    36→  tasks: LoadedTask[],
    37→  index: ReferenceIndex
    38→): LoadedTask {
    39→  const result = index.resolve(ref);
    40→
    41→  if (!result.ok) {
    42→    switch (result.error) {
    43→      case 'not_found':
    44→        error(`Task not found: ${ref}`);
    45→        break;
    46→      case 'ambiguous':
    47→        error(`Reference "${ref}" is ambiguous. Matches:`);
    48→        for (const candidate of result.candidates) {
    49→          const task = tasks.find(t => t._ulid === candidate);
    50→          const slug = task?.slugs[0] || '';
    51→          console.error(`  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ''}`);
    52→        }
    53→        break;
    54→      case 'duplicate_slug':
    55→        error(`Slug "${ref}" maps to multiple items. Use ULID instead:`);
    56→        for (const candidate of result.candidates) {
    57→          console.error(`  - ${index.shortUlid(candidate)}`);
    58→        }
    59→        break;
    60→    }
    61→    process.exit(3);
    62→  }
    63→
    64→  // Check if it's actually a task
    65→  const task = tasks.find(t => t._ulid === result.ulid);
    66→  if (!task) {
    67→    error(`Reference "${ref}" is not a task (it's a spec item)`);
    68→    process.exit(3);
    69→  }
    70→
    71→  return task;
    72→}
    73→
    74→/**
    75→ * Register the 'task' command group (singular - operations on individual tasks)
    76→ */
    77→export function registerTaskCommands(program: Command): void {
    78→  const task = program
    79→    .command('task')
    80→    .description('Operations on individual tasks');
    81→
    82→  // kspec task get <ref>
    83→  task
    84→    .command('get <ref>')
    85→    .description('Get task details')
    86→    .action(async (ref: string) => {
    87→      try {
    88→        const ctx = await initContext();
    89→        const tasks = await loadAllTasks(ctx);
    90→        const items = await loadAllItems(ctx);
    91→        const index = new ReferenceIndex(tasks, items);
    92→        const foundTask = resolveTaskRef(ref, tasks, index);
    93→
    94→        output(foundTask, () => formatTaskDetails(foundTask, index));
    95→      } catch (err) {
    96→        error('Failed to get task', err);
    97→        process.exit(1);
    98→      }
    99→    });
   100→
   101→  // kspec task add
   102→  task
   103→    .command('add')
   104→    .description('Create a new task')
   105→    .requiredOption('--title <title>', 'Task title')
   106→    .option('--type <type>', 'Task type (task, epic, bug, spike, infra)', 'task')
   107→    .option('--spec-ref <ref>', 'Reference to spec item')
   108→    .option('--meta-ref <ref>', 'Reference to meta item (workflow, agent, or convention)')
   109→    .option('--priority <n>', 'Priority (1-5)', '3')
   110→    .option('--slug <slug>', 'Human-friendly slug')
   111→    .option('--tag <tag...>', 'Tags')
   112→    .action(async (options) => {
   113→      try {
   114→        const ctx = await initContext();
   115→        const tasks = await loadAllTasks(ctx);
   116→        const items = await loadAllItems(ctx);
   117→
   118→        // Load meta items for validation
   119→        const { loadMetaContext } = await import('../../parser/meta.js');
   120→        const metaContext = await loadMetaContext(ctx);
   121→        const allMetaItems = [
   122→          ...metaContext.agents,
   123→          ...metaContext.workflows,
   124→          ...metaContext.conventions,
   125→          ...metaContext.observations,
   126→        ];
   127→
   128→        // Build index for reference validation
   129→        const refIndex = new ReferenceIndex(tasks, items, allMetaItems);
   130→
   131→        // Check slug uniqueness if provided
   132→        if (options.slug) {
   133→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   134→          if (!slugCheck.ok) {
   135→            error(`Slug '${slugCheck.slug}' already exists (used by ${slugCheck.existingUlid})`);
   136→            process.exit(1);
   137→          }
   138→        }
   139→
   140→        // Validate meta_ref if provided (AC-meta-ref-3, AC-meta-ref-4)
   141→        if (options.metaRef) {
   142→          const metaRefResult = refIndex.resolve(options.metaRef);
   143→
   144→          if (!metaRefResult.ok) {
   145→            error(`meta_ref '${options.metaRef}' does not resolve to a valid meta item (agent, workflow, or convention)`);
   146→            process.exit(3);
   147→          }
   148→
   149→          // Check if the resolved item is a meta item (not a spec item or task)
   150→          const isTask = tasks.some(t => t._ulid === metaRefResult.ulid);
   151→          const isSpecItem = items.some(i => i._ulid === metaRefResult.ulid);
   152→
   153→          if (isTask || isSpecItem) {
   154→            error(`meta_ref '${options.metaRef}' points to a spec item; use --spec-ref for product spec references`);
   155→            process.exit(3);
   156→          }
   157→        }
   158→
   159→        const input: TaskInput = {
   160→          title: options.title,
   161→          type: options.type,
   162→          spec_ref: options.specRef || null,
   163→          meta_ref: options.metaRef || null,
   164→          priority: parseInt(options.priority, 10),
   165→          slugs: options.slug ? [options.slug] : [],
   166→          tags: options.tag || [],
   167→        };
   168→
   169→        const newTask = createTask(input);
   170→        await saveTask(ctx, newTask);
   171→        await commitIfShadow(ctx.shadow, 'task-add', newTask.slugs[0] || newTask._ulid.slice(0, 8), newTask.title);
   172→
   173→        // Build index including the new task for accurate short ULID
   174→        const index = new ReferenceIndex([...tasks, newTask], items, allMetaItems);
   175→        success(`Created task: ${index.shortUlid(newTask._ulid)}`, { task: newTask });
   176→      } catch (err) {
   177→        error('Failed to create task', err);
   178→        process.exit(1);
   179→      }
   180→    });
   181→
   182→  // kspec task set <ref>
   183→  task
   184→    .command('set <ref>')
   185→    .description('Update task fields')
   186→    .option('--title <title>', 'Update task title')
   187→    .option('--spec-ref <ref>', 'Link to spec item')
   188→    .option('--meta-ref <ref>', 'Link to meta item (workflow, agent, or convention)')
   189→    .option('--priority <n>', 'Set priority (1-5)')
   190→    .option('--slug <slug>', 'Add a slug alias')
   191→    .option('--tag <tag...>', 'Add tags')
   192→    .option('--depends-on <refs...>', 'Set dependencies (replaces existing)')
   193→    .action(async (ref: string, options) => {
   194→      try {
   195→        const ctx = await initContext();
   196→        const tasks = await loadAllTasks(ctx);
   197→        const items = await loadAllItems(ctx);
   198→
   199→        // Load meta items for validation
   200→        const { loadMetaContext } = await import('../../parser/meta.js');
   201→        const metaContext = await loadMetaContext(ctx);
   202→        const allMetaItems = [
   203→          ...metaContext.agents,
   204→          ...metaContext.workflows,
   205→          ...metaContext.conventions,
   206→          ...metaContext.observations,
   207→        ];
   208→
   209→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   210→        const foundTask = resolveTaskRef(ref, tasks, index);
   211→
   212→        // Check slug uniqueness if adding a new slug
   213→        if (options.slug) {
   214→          const slugCheck = checkSlugUniqueness(index, [options.slug], foundTask._ulid);
   215→          if (!slugCheck.ok) {
   216→            error(`Slug '${slugCheck.slug}' already exists (used by ${slugCheck.existingUlid})`);
   217→            process.exit(1);
   218→          }
   219→        }
   220→
   221→        // Build updated task with only provided options
   222→        const updatedTask: Task = { ...foundTask };
   223→        const changes: string[] = [];
   224→
   225→        if (options.title) {
   226→          updatedTask.title = options.title;
   227→          changes.push('title');
   228→        }
   229→
   230→        if (options.specRef) {
   231→          // Validate the spec ref exists and is a spec item
   232→          const specResult = index.resolve(options.specRef);
   233→          if (!specResult.ok) {
   234→            error(`Spec reference not found: ${options.specRef}`);
   235→            process.exit(3);
   236→          }
   237→          // Check it's not a task
   238→          const isTask = tasks.some(t => t._ulid === specResult.ulid);
   239→          if (isTask) {
   240→            error(`Reference "${options.specRef}" is a task, not a spec item`);
   241→            process.exit(3);
   242→          }
   243→          updatedTask.spec_ref = options.specRef;
   244→          changes.push('spec_ref');
   245→        }
   246→
   247→        if (options.metaRef) {
   248→          // Validate the meta ref exists and is a meta item
   249→          const metaRefResult = index.resolve(options.metaRef);
   250→          if (!metaRefResult.ok) {
   251→            error(`meta_ref '${options.metaRef}' does not resolve to a valid meta item (agent, workflow, or convention)`);
   252→            process.exit(3);
   253→          }
   254→
   255→          // Check if the resolved item is a meta item (not a spec item or task)
   256→          const isTask = tasks.some(t => t._ulid === metaRefResult.ulid);
   257→          const isSpecItem = items.some(i => i._ulid === metaRefResult.ulid);
   258→
   259→          if (isTask || isSpecItem) {
   260→            error(`meta_ref '${options.metaRef}' points to a spec item; use --spec-ref for product spec references`);
   261→            process.exit(3);
   262→          }
   263→
   264→          updatedTask.meta_ref = options.metaRef;
   265→          changes.push('meta_ref');
   266→        }
   267→
   268→        if (options.priority) {
   269→          const priority = parseInt(options.priority, 10);
   270→          if (isNaN(priority) || priority < 1 || priority > 5) {
   271→            error('Priority must be between 1 and 5');
   272→            process.exit(3);
   273→          }
   274→          updatedTask.priority = priority;
   275→          changes.push('priority');
   276→        }
   277→
   278→        if (options.slug) {
   279→          if (!updatedTask.slugs.includes(options.slug)) {
   280→            updatedTask.slugs = [...updatedTask.slugs, options.slug];
   281→            changes.push('slug');
   282→          }
   283→        }
   284→
   285→        if (options.tag) {
   286→          const newTags = options.tag.filter((t: string) => !updatedTask.tags.includes(t));
   287→          if (newTags.length > 0) {
   288→            updatedTask.tags = [...updatedTask.tags, ...newTags];
   289→            changes.push('tags');
   290→          }
   291→        }
   292→
   293→        if (options.dependsOn) {
   294→          // Validate all dependency refs
   295→          for (const depRef of options.dependsOn) {
   296→            const depResult = index.resolve(depRef);
   297→            if (!depResult.ok) {
   298→              error(`Dependency reference not found: ${depRef}`);
   299→              process.exit(3);
   300→            }
   301→          }
   302→          updatedTask.depends_on = options.dependsOn;
   303→          changes.push('depends_on');
   304→        }
   305→
   306→        if (changes.length === 0) {
   307→          warn('No changes specified');
   308→          return;
   309→        }
   310→
   311→        await saveTask(ctx, updatedTask);
   312→        await commitIfShadow(ctx.shadow, 'task-set', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), changes.join(', '));
   313→        success(`Updated task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(', ')})`, { task: updatedTask });
   314→      } catch (err) {
   315→        error('Failed to update task', err);
   316→        process.exit(1);
   317→      }
   318→    });
   319→
   320→  // kspec task patch <ref>
   321→  task
   322→    .command('patch <ref>')
   323→    .description('Update task with JSON data')
   324→    .option('--data <json>', 'JSON object with fields to update')
   325→    .option('--dry-run', 'Show what would change without writing')
   326→    .option('--allow-unknown', 'Allow unknown fields (for extending format)')
   327→    .action(async (ref: string, options) => {
   328→      try {
   329→        const ctx = await initContext();
   330→        const tasks = await loadAllTasks(ctx);
   331→        const items = await loadAllItems(ctx);
   332→
   333→        // Load meta items for validation
   334→        const { loadMetaContext } = await import('../../parser/meta.js');
   335→        const metaContext = await loadMetaContext(ctx);
   336→        const allMetaItems = [
   337→          ...metaContext.agents,
   338→          ...metaContext.workflows,
   339→          ...metaContext.conventions,
   340→          ...metaContext.observations,
   341→        ];
   342→
   343→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   344→        const foundTask = resolveTaskRef(ref, tasks, index);
   345→
   346→        // Get JSON data from --data flag or stdin
   347→        let jsonData: string;
   348→        if (options.data) {
   349→          jsonData = options.data;
   350→        } else {
   351→          // Read from stdin
   352→          const chunks: Buffer[] = [];
   353→          for await (const chunk of process.stdin) {
   354→            chunks.push(chunk);
   355→          }
   356→          jsonData = Buffer.concat(chunks).toString('utf-8');
   357→        }
   358→
   359→        // Parse JSON
   360→        let patchData: Record<string, unknown>;
   361→        try {
   362→          patchData = JSON.parse(jsonData);
   363→        } catch (parseErr) {
   364→          error('Invalid JSON syntax', parseErr);
   365→          process.exit(1);
   366→        }
   367→
   368→        // Validate against TaskInputSchema (partial)
   369→        const { TaskInputSchema } = await import('../../schema/index.js');
   370→
   371→        // Create a partial schema for validation
   372→        const partialSchema = options.allowUnknown
   373→          ? TaskInputSchema.partial().passthrough()
   374→          : TaskInputSchema.partial().strict();
   375→
   376→        let validatedPatch: Partial<TaskInput>;
   377→        try {
   378→          validatedPatch = partialSchema.parse(patchData);
   379→        } catch (validationErr) {
   380→          error('Invalid patch data', validationErr);
   381→          process.exit(1);
   382→        }
   383→
   384→        // Check for unknown fields if strict mode
   385→        if (!options.allowUnknown) {
   386→          const knownFields = Object.keys(TaskInputSchema.shape);
   387→          const providedFields = Object.keys(patchData);
   388→          const unknownFields = providedFields.filter(f => !knownFields.includes(f));
   389→
   390→          if (unknownFields.length > 0) {
   391→            error(`Unknown field(s): ${unknownFields.join(', ')}`);
   392→            process.exit(1);
   393→          }
   394→        }
   395→
   396→        // Build updated task
   397→        const updatedTask: Task = { ...foundTask, ...validatedPatch };
   398→
   399→        // Track changes for output
   400→        const changes = Object.keys(validatedPatch);
   401→
   402→        if (options.dryRun) {
   403→          info('Dry run - no changes will be written');
   404→          info(`Would update: ${changes.join(', ')}`);
   405→          output({ changes, updated: updatedTask }, () => {
   406→            console.log(`\nChanges: ${changes.join(', ')}\n`);
   407→            return formatTaskDetails(updatedTask, index);
   408→          });
   409→          return;
   410→        }
   411→
   412→        await saveTask(ctx, updatedTask);
   413→        await commitIfShadow(ctx.shadow, 'task-patch', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), changes.join(', '));
   414→        success(`Patched task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(', ')})`, { task: updatedTask });
   415→      } catch (err) {
   416→        error('Failed to patch task', err);
   417→        process.exit(1);
   418→      }
   419→    });
   420→
   421→  // kspec task start <ref>
   422→  task
   423→    .command('start <ref>')
   424→    .description('Start working on a task (pending -> in_progress)')
   425→    .option('--no-sync', 'Skip syncing spec implementation status')
   426→    .action(async (ref: string, options) => {
   427→      try {
   428→        const ctx = await initContext();
   429→        const tasks = await loadAllTasks(ctx);
   430→        const items = await loadAllItems(ctx);
   431→        const index = new ReferenceIndex(tasks, items);
   432→        const foundTask = resolveTaskRef(ref, tasks, index);
   433→
   434→        if (foundTask.status === 'in_progress') {
   435→          warn('Task is already in progress');
   436→          output(foundTask, () => formatTaskDetails(foundTask));
   437→          return;
   438→        }
   439→
   440→        if (foundTask.status !== 'pending') {
   441→          error(`Cannot start task with status: ${foundTask.status}`);
   442→          process.exit(4); // Exit code 4 = invalid state
   443→        }
   444→
   445→        // Update status
   446→        const updatedTask: Task = {
   447→          ...foundTask,
   448→          status: 'in_progress',
   449→          started_at: new Date().toISOString(),
   450→        };
   451→
   452→        await saveTask(ctx, updatedTask);
   453→        await commitIfShadow(ctx.shadow, 'task-start', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   454→        success(`Started task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   455→
   456→        // Sync spec implementation status (unless --no-sync)
   457→        if (options.sync !== false && foundTask.spec_ref) {
   458→          const updatedTasks = tasks.map(t =>
   459→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t
   460→          );
   461→          const syncResult = await syncSpecImplementationStatus(
   462→            ctx,
   463→            updatedTask as LoadedTask,
   464→            updatedTasks as LoadedTask[],
   465→            items,
   466→            index
   467→          );
   468→          if (syncResult) {
   469→            info(`Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   470→          }
   471→        }
   472→      } catch (err) {
   473→        error('Failed to start task', err);
   474→        process.exit(1);
   475→      }
   476→    });
   477→
   478→  // kspec task complete <ref>
   479→  task
   480→    .command('complete <ref>')
   481→    .description('Complete a task (in_progress -> completed)')
   482→    .option('--reason <reason>', 'Completion reason/notes')
   483→    .option('--no-sync', 'Skip syncing spec implementation status')
   484→    .action(async (ref: string, options) => {
   485→      try {
   486→        const ctx = await initContext();
   487→        const tasks = await loadAllTasks(ctx);
   488→        const items = await loadAllItems(ctx);
   489→        const index = new ReferenceIndex(tasks, items);
   490→        const foundTask = resolveTaskRef(ref, tasks, index);
   491→
   492→        if (foundTask.status === 'completed') {
   493→          warn('Task is already completed');
   494→          output(foundTask, () => formatTaskDetails(foundTask));
   495→          return;
   496→        }
   497→
   498→        if (foundTask.status !== 'in_progress' && foundTask.status !== 'pending') {
   499→          error(`Cannot complete task with status: ${foundTask.status}`);
   500→          process.exit(4);
   501→        }
   502→
   503→        const now = new Date().toISOString();
   504→
   505→        // Update status
   506→        const updatedTask: Task = {
   507→          ...foundTask,
   508→          status: 'completed',
   509→          completed_at: now,
   510→          closed_reason: options.reason || null,
   511→          started_at: foundTask.started_at || now, // Set started_at if not already
   512→        };
   513→
   514→        await saveTask(ctx, updatedTask);
   515→        await commitIfShadow(ctx.shadow, 'task-complete', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), options.reason);
   516→        success(`Completed task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   517→
   518→        // Output commit guidance (suppressed in JSON mode)
   519→        if (!isJsonMode()) {
   520→          const guidance = formatCommitGuidance(updatedTask);
   521→          printCommitGuidance(guidance);
   522→        }
   523→
   524→        // Sync spec implementation status (unless --no-sync)
   525→        if (options.sync !== false && foundTask.spec_ref) {
   526→          // Update task list to reflect the change we just made
   527→          const updatedTasks = tasks.map(t =>
   528→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t
   529→          );
   530→          const syncResult = await syncSpecImplementationStatus(
   531→            ctx,
   532→            updatedTask as LoadedTask,
   533→            updatedTasks as LoadedTask[],
   534→            items,
   535→            index
   536→          );
   537→          if (syncResult) {
   538→            info(`Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   539→          }
   540→        }
   541→      } catch (err) {
   542→        error('Failed to complete task', err);
   543→        process.exit(1);
   544→      }
   545→    });
   546→
   547→  // kspec task block <ref>
   548→  task
   549→    .command('block <ref>')
   550→    .description('Block a task')
   551→    .requiredOption('--reason <reason>', 'Reason for blocking')
   552→    .action(async (ref: string, options) => {
   553→      try {
   554→        const ctx = await initContext();
   555→        const tasks = await loadAllTasks(ctx);
   556→        const items = await loadAllItems(ctx);
   557→        const index = new ReferenceIndex(tasks, items);
   558→        const foundTask = resolveTaskRef(ref, tasks, index);
   559→
   560→        if (foundTask.status === 'completed' || foundTask.status === 'cancelled') {
   561→          error(`Cannot block task with status: ${foundTask.status}`);
   562→          process.exit(4);
   563→        }
   564→
   565→        const updatedTask: Task = {
   566→          ...foundTask,
   567→          status: 'blocked',
   568→          blocked_by: [...foundTask.blocked_by, options.reason],
   569→        };
   570→
   571→        await saveTask(ctx, updatedTask);
   572→        await commitIfShadow(ctx.shadow, 'task-block', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   573→        success(`Blocked task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   574→      } catch (err) {
   575→        error('Failed to block task', err);
   576→        process.exit(1);
   577→      }
   578→    });
   579→
   580→  // kspec task unblock <ref>
   581→  task
   582→    .command('unblock <ref>')
   583→    .description('Unblock a task')
   584→    .action(async (ref: string) => {
   585→      try {
   586→        const ctx = await initContext();
   587→        const tasks = await loadAllTasks(ctx);
   588→        const items = await loadAllItems(ctx);
   589→        const index = new ReferenceIndex(tasks, items);
   590→        const foundTask = resolveTaskRef(ref, tasks, index);
   591→
   592→        if (foundTask.status !== 'blocked') {
   593→          warn('Task is not blocked');
   594→          return;
   595→        }
   596→
   597→        const updatedTask: Task = {
   598→          ...foundTask,
   599→          status: 'pending',
   600→          blocked_by: [],
   601→        };
   602→
   603→        await saveTask(ctx, updatedTask);
   604→        await commitIfShadow(ctx.shadow, 'task-unblock', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   605→        success(`Unblocked task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   606→      } catch (err) {
   607→        error('Failed to unblock task', err);
   608→        process.exit(1);
   609→      }
   610→    });
   611→
   612→  // kspec task cancel <ref>
   613→  task
   614→    .command('cancel <ref>')
   615→    .description('Cancel a task')
   616→    .option('--reason <reason>', 'Cancellation reason')
   617→    .action(async (ref: string, options) => {
   618→      try {
   619→        const ctx = await initContext();
   620→        const tasks = await loadAllTasks(ctx);
   621→        const items = await loadAllItems(ctx);
   622→        const index = new ReferenceIndex(tasks, items);
   623→        const foundTask = resolveTaskRef(ref, tasks, index);
   624→
   625→        if (foundTask.status === 'completed' || foundTask.status === 'cancelled') {
   626→          warn(`Task is already ${foundTask.status}`);
   627→          return;
   628→        }
   629→
   630→        const updatedTask: Task = {
   631→          ...foundTask,
   632→          status: 'cancelled',
   633→          closed_reason: options.reason || null,
   634→        };
   635→
   636→        await saveTask(ctx, updatedTask);
   637→        await commitIfShadow(ctx.shadow, 'task-cancel', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   638→        success(`Cancelled task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   639→      } catch (err) {
   640→        error('Failed to cancel task', err);
   641→        process.exit(1);
   642→      }
   643→    });
   644→
   645→  // kspec task delete <ref>
   646→  task
   647→    .command('delete <ref>')
   648→    .description('Delete a task permanently')
   649→    .option('--force', 'Skip confirmation')
   650→    .option('--dry-run', 'Show what would be deleted without deleting')
   651→    .action(async (ref: string, options) => {
   652→      try {
   653→        const ctx = await initContext();
   654→        const tasks = await loadAllTasks(ctx);
   655→        const items = await loadAllItems(ctx);
   656→        const index = new ReferenceIndex(tasks, items);
   657→        const foundTask = resolveTaskRef(ref, tasks, index);
   658→
   659→        const taskDisplay = `${foundTask.title} (${index.shortUlid(foundTask._ulid)})`;
   660→
   661→        if (options.dryRun) {
   662→          info(`Would delete task: ${taskDisplay}`);
   663→          console.log(`  Source file: ${foundTask._sourceFile}`);
   664→          console.log(`  Status: ${foundTask.status}`);
   665→          if (foundTask.notes.length > 0) {
   666→            console.log(`  Notes: ${foundTask.notes.length}`);
   667→          }
   668→          return;
   669→        }
   670→
   671→        // Confirm unless --force
   672→        if (!options.force) {
   673→          const readline = await import('readline');
   674→          const rl = readline.createInterface({
   675→            input: process.stdin,
   676→            output: process.stdout,
   677→          });
   678→
   679→          const answer = await new Promise<string>((resolve) => {
   680→            rl.question(`Delete task "${taskDisplay}"? [y/N] `, resolve);
   681→          });
   682→          rl.close();
   683→
   684→          if (answer.toLowerCase() !== 'y') {
   685→            info('Deletion cancelled');
   686→            return;
   687→          }
   688→        }
   689→
   690→        await deleteTask(ctx, foundTask);
   691→        await commitIfShadow(ctx.shadow, 'task-delete', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), foundTask.title);
   692→        success(`Deleted task: ${taskDisplay}`);
   693→      } catch (err) {
   694→        error('Failed to delete task', err);
   695→        process.exit(1);
   696→      }
   697→    });
   698→
   699→  // kspec task note <ref> <message>
   700→  task
   701→    .command('note <ref> <message>')
   702→    .description('Add a note to a task')
   703→    .option('--author <author>', 'Note author')
   704→    .option('--supersedes <ulid>', 'ULID of note this supersedes')
   705→    .action(async (ref: string, message: string, options) => {
   706→      try {
   707→        const ctx = await initContext();
   708→        const tasks = await loadAllTasks(ctx);
   709→        const items = await loadAllItems(ctx);
   710→        const index = new ReferenceIndex(tasks, items);
   711→        const foundTask = resolveTaskRef(ref, tasks, index);
   712→
   713→        const note = createNote(message, options.author, options.supersedes);
   714→
   715→        const updatedTask: Task = {
   716→          ...foundTask,
   717→          notes: [...foundTask.notes, note],
   718→        };
   719→
   720→        await saveTask(ctx, updatedTask);
   721→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   722→        success(`Added note to task: ${index.shortUlid(updatedTask._ulid)}`, { note });
   723→
   724→        // Proactive alignment guidance for tasks with spec_ref
   725→        if (foundTask.spec_ref) {
   726→          console.log('');
   727→          console.log('\x1b[33m--- Alignment Check ---\x1b[0m');
   728→          console.log('Did your implementation add anything beyond the original spec?');
   729→          console.log('If so, consider updating the spec:');
   730→          console.log(`  kspec item set ${foundTask.spec_ref} --description "Updated description"`);
   731→          console.log('Or add acceptance criteria for new features.');
   732→
   733→          // Check if linked spec has acceptance criteria and remind about test coverage
   734→          const specResult = index.resolve(foundTask.spec_ref);
   735→          if (specResult.ok && specResult.item) {
   736→            const specItem = specResult.item as { acceptance_criteria?: unknown[] };
   737→            if (specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
   738→              console.log('');
   739→              console.log(`Linked spec has ${specItem.acceptance_criteria.length} acceptance criteria - consider test coverage.`);
   740→            }
   741→          }
   742→        }
   743→      } catch (err) {
   744→        error('Failed to add note', err);
   745→        process.exit(1);
   746→      }
   747→    });
   748→
   749→  // kspec task notes <ref>
   750→  task
   751→    .command('notes <ref>')
   752→    .description('Show notes for a task')
   753→    .action(async (ref: string) => {
   754→      try {
   755→        const ctx = await initContext();
   756→        const tasks = await loadAllTasks(ctx);
   757→        const items = await loadAllItems(ctx);
   758→        const index = new ReferenceIndex(tasks, items);
   759→        const foundTask = resolveTaskRef(ref, tasks, index);
   760→
   761→        output(foundTask.notes, () => {
   762→          if (foundTask.notes.length === 0) {
   763→            console.log('No notes');
   764→          } else {
   765→            for (const note of foundTask.notes) {
   766→              const author = note.author || 'unknown';
   767→              console.log(`[${note.created_at}] ${author}:`);
   768→              console.log(note.content);
   769→              console.log('');
   770→            }
   771→          }
   772→        });
   773→      } catch (err) {
   774→        error('Failed to get notes', err);
   775→        process.exit(1);
   776→      }
   777→    });
   778→
   779→  // kspec task todos <ref>
   780→  task
   781→    .command('todos <ref>')
   782→    .description('Show todos for a task')
   783→    .action(async (ref: string) => {
   784→      try {
   785→        const ctx = await initContext();
   786→        const tasks = await loadAllTasks(ctx);
   787→        const items = await loadAllItems(ctx);
   788→        const index = new ReferenceIndex(tasks, items);
   789→        const foundTask = resolveTaskRef(ref, tasks, index);
   790→
   791→        output(foundTask.todos, () => {
   792→          if (foundTask.todos.length === 0) {
   793→            console.log('No todos');
   794→          } else {
   795→            for (const todo of foundTask.todos) {
   796→              const status = todo.done ? '[x]' : '[ ]';
   797→              const doneInfo = todo.done && todo.done_at ? ` (done ${todo.done_at})` : '';
   798→              console.log(`${status} ${todo.id}. ${todo.text}${doneInfo}`);
   799→            }
   800→          }
   801→        });
   802→      } catch (err) {
   803→        error('Failed to get todos', err);
   804→        process.exit(1);
   805→      }
   806→    });
   807→
   808→  // Create subcommand group for todo operations
   809→  const todoCmd = task
   810→    .command('todo')
   811→    .description('Manage task todos');
   812→
   813→  // kspec task todo add <ref> <text>
   814→  todoCmd
   815→    .command('add <ref> <text>')
   816→    .description('Add a todo to a task')
   817→    .option('--author <author>', 'Todo author')
   818→    .action(async (ref: string, text: string, options) => {
   819→      try {
   820→        const ctx = await initContext();
   821→        const tasks = await loadAllTasks(ctx);
   822→        const items = await loadAllItems(ctx);
   823→        const index = new ReferenceIndex(tasks, items);
   824→        const foundTask = resolveTaskRef(ref, tasks, index);
   825→
   826→        // Calculate next ID (max existing + 1, or 1 if none)
   827→        const nextId = foundTask.todos.length > 0
   828→          ? Math.max(...foundTask.todos.map(t => t.id)) + 1
   829→          : 1;
   830→
   831→        const todo = createTodo(nextId, text, options.author);
   832→
   833→        const updatedTask: Task = {
   834→          ...foundTask,
   835→          todos: [...foundTask.todos, todo],
   836→        };
   837→
   838→        await saveTask(ctx, updatedTask);
   839→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   840→        success(`Added todo #${todo.id} to task: ${index.shortUlid(updatedTask._ulid)}`, { todo });
   841→      } catch (err) {
   842→        error('Failed to add todo', err);
   843→        process.exit(1);
   844→      }
   845→    });
   846→
   847→  // kspec task todo done <ref> <id>
   848→  todoCmd
   849→    .command('done <ref> <id>')
   850→    .description('Mark a todo as done')
   851→    .action(async (ref: string, idStr: string) => {
   852→      try {
   853→        const ctx = await initContext();
   854→        const tasks = await loadAllTasks(ctx);
   855→        const items = await loadAllItems(ctx);
   856→        const index = new ReferenceIndex(tasks, items);
   857→        const foundTask = resolveTaskRef(ref, tasks, index);
   858→
   859→        const id = parseInt(idStr, 10);
   860→        if (isNaN(id)) {
   861→          error(`Invalid todo ID: ${idStr}`);
   862→          process.exit(3);
   863→        }
   864→
   865→        const todoIndex = foundTask.todos.findIndex(t => t.id === id);
   866→        if (todoIndex === -1) {
   867→          error(`Todo #${id} not found`);
   868→          process.exit(3);
   869→        }
   870→
   871→        if (foundTask.todos[todoIndex].done) {
   872→          warn(`Todo #${id} is already done`);
   873→          return;
   874→        }
   875→
   876→        const updatedTodos = [...foundTask.todos];
   877→        updatedTodos[todoIndex] = {
   878→          ...updatedTodos[todoIndex],
   879→          done: true,
   880→          done_at: new Date().toISOString(),
   881→        };
   882→
   883→        const updatedTask: Task = {
   884→          ...foundTask,
   885→          todos: updatedTodos,
   886→        };
   887→
   888→        await saveTask(ctx, updatedTask);
   889→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   890→        success(`Marked todo #${id} as done`, { todo: updatedTodos[todoIndex] });
   891→      } catch (err) {
   892→        error('Failed to mark todo as done', err);
   893→        process.exit(1);
   894→      }
   895→    });
   896→
   897→  // kspec task todo undone <ref> <id>
   898→  todoCmd
   899→    .command('undone <ref> <id>')
   900→    .description('Mark a todo as not done')
   901→    .action(async (ref: string, idStr: string) => {
   902→      try {
   903→        const ctx = await initContext();
   904→        const tasks = await loadAllTasks(ctx);
   905→        const items = await loadAllItems(ctx);
   906→        const index = new ReferenceIndex(tasks, items);
   907→        const foundTask = resolveTaskRef(ref, tasks, index);
   908→
   909→        const id = parseInt(idStr, 10);
   910→        if (isNaN(id)) {
   911→          error(`Invalid todo ID: ${idStr}`);
   912→          process.exit(3);
   913→        }
   914→
   915→        const todoIndex = foundTask.todos.findIndex(t => t.id === id);
   916→        if (todoIndex === -1) {
   917→          error(`Todo #${id} not found`);
   918→          process.exit(3);
   919→        }
   920→
   921→        if (!foundTask.todos[todoIndex].done) {
   922→          warn(`Todo #${id} is not done`);
   923→          return;
   924→        }
   925→
   926→        const updatedTodos = [...foundTask.todos];
   927→        updatedTodos[todoIndex] = {
   928→          ...updatedTodos[todoIndex],
   929→          done: false,
   930→          done_at: undefined,
   931→        };
   932→
   933→        const updatedTask: Task = {
   934→          ...foundTask,
   935→          todos: updatedTodos,
   936→        };
   937→
   938→        await saveTask(ctx, updatedTask);
   939→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   940→        success(`Marked todo #${id} as not done`, { todo: updatedTodos[todoIndex] });
   941→      } catch (err) {
   942→        error('Failed to mark todo as not done', err);
   943→        process.exit(1);
   944→      }
   945→    });
   946→}
