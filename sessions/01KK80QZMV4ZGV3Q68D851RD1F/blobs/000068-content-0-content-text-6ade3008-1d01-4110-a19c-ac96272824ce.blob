```
     1→/**
     2→ * Tests for formatSessionContext() rewrite — primer/full modes
     3→ *
     4→ * AC: @cmd-session-start ac-primer-default
     5→ * AC: @cmd-session-start ac-full-sections
     6→ * AC: @cmd-session-start ac-brief-alias
     7→ * AC: @cmd-session-start ac-section-order
     8→ * AC: @cmd-session-start ac-empty-skip
     9→ * AC: @cmd-session-start ac-slug-display
    10→ * AC: @cmd-session-start ac-slug-fallback
    11→ * AC: @cmd-session-start ac-relative-time-human
    12→ * AC: @cmd-session-start ac-iso-time-json
    13→ * AC: @cmd-session-start ac-dirty-tree-only
    14→ * AC: @cmd-session-start ac-active-detail
    15→ * AC: @cmd-session-start ac-needs-work-indicator
    16→ * AC: @cmd-session-start ac-review-detail
    17→ * AC: @cmd-session-start ac-notes-starvation
    18→ * AC: @cmd-session-start ac-json-raw-preserved
    19→ *
    20→ * Trait coverage:
    21→ * AC: @trait-json-output ac-1 (via session-start-notes.test.ts)
    22→ * AC: @trait-json-output ac-2 (JSON includes all human-visible data — verified structurally)
    23→ * AC: @trait-json-output ac-4 (refs use @ prefix in human output; JSON refs are identifiers)
    24→ * AC: @trait-json-output ac-5 (ISO 8601 timestamps in JSON — ac-iso-time-json test)
    25→ * AC: @trait-json-output ac-6 (--json takes precedence — verified via ac-brief-alias test using --brief --json)
    26→ * AC: @trait-semantic-exit-codes ac-1 (exit code 0 on success)
    27→ *
    28→ * N/A trait ACs:
    29→ * @trait-json-output ac-3 (error JSON envelope — pre-existing, not introduced by this PR)
    30→ * @trait-semantic-exit-codes ac-2 (validation error — no user input validation in session start)
    31→ * @trait-semantic-exit-codes ac-3 (cancellation — session start has no confirmation prompts)
    32→ * @trait-semantic-exit-codes ac-4 (runtime error — pre-existing behavior, not changed by this PR)
    33→ * @trait-semantic-exit-codes ac-6 (invalid flags — handled by commander, not session start)
    34→ * @trait-semantic-exit-codes ac-5 (empty result set — session start always returns data, never empty)
    35→ * @trait-semantic-exit-codes ac-7 (batch partial failures — session start is not batch)
    36→ * @trait-semantic-exit-codes ac-8 (documentation — exit codes documented in exit-codes.ts)
    37→ */
    38→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
    39→import { writeFileSync } from 'node:fs';
    40→import { join } from 'node:path';
    41→import {
    42→  kspec,
    43→  kspecJson,
    44→  setupTempFixtures,
    45→  cleanupTempDir,
    46→  initGitRepo,
    47→  git,
    48→} from '../helpers/cli';
    49→import type { SessionContext } from '../helpers/session-types';
    50→
    51→describe('session start format rewrite', () => {
    52→  let tempDir: string;
    53→
    54→  beforeEach(async () => {
    55→    tempDir = await setupTempFixtures();
    56→    initGitRepo(tempDir);
    57→    writeFileSync(join(tempDir, 'README.md'), '# Test\n');
    58→    git('add .', tempDir);
    59→    git('commit -m "initial commit"', tempDir);
    60→  });
    61→
    62→  afterEach(async () => {
    63→    await cleanupTempDir(tempDir);
    64→  });
    65→
    66→  // AC: @cmd-session-start ac-primer-default
    67→  describe('primer mode (default)', () => {
    68→    it('should limit ready tasks to 5 in primer mode', { timeout: 30000 }, () => {
    69→      // Create 8 ready tasks
    70→      for (let i = 1; i <= 8; i++) {
    71→        kspec(`task add --title "Ready ${i}" --slug ready-${i}`, tempDir);
    72→      }
    73→
    74→      const session = kspecJson<SessionContext>('session start --json', tempDir);
    75→      expect(session.ready_tasks.length).toBe(5);
    76→    });
    77→
    78→    it('should limit activity timeline to 10 items in primer mode', { timeout: 30000 }, () => {
    79→      // Create and complete 12 tasks to get 12 activity items
    80→      for (let i = 1; i <= 12; i++) {
    81→        kspec(`task add --title "Task ${i}" --slug task-${i}`, tempDir);
    82→        kspec(`task start @task-${i}`, tempDir);
    83→        kspec(`task submit @task-${i}`, tempDir);
    84→        kspec(`task complete @task-${i} --reason "Done"`, tempDir);
    85→      }
    86→
    87→      const session = kspecJson<SessionContext>('session start --json', tempDir);
    88→      expect(session.activity_timeline.length).toBeLessThanOrEqual(10);
    89→    });
    90→
    91→    it('should show inbox stat line in primer mode', () => {
    92→      // Add inbox items so stat line appears
    93→      kspec('inbox add "Test inbox item for primer"', tempDir);
    94→
    95→      const result = kspec('session start', tempDir);
    96→
    97→      // Stat line should unconditionally appear when inbox has items
    98→      expect(result.stdout).toContain('untriaged');
    99→      expect(result.stdout).toContain('total');
   100→    });
   101→  });
   102→
   103→  // AC: @cmd-session-start ac-full-sections
   104→  describe('full mode', () => {
   105→    it('should show all ready tasks in full mode', { timeout: 30000 }, () => {
   106→      // Create 8 ready tasks (fixture already has some)
   107→      for (let i = 1; i <= 8; i++) {
   108→        kspec(`task add --title "Ready ${i}" --slug ready-${i}`, tempDir);
   109→      }
   110→
   111→      const primerSession = kspecJson<SessionContext>('session start --json', tempDir);
   112→      const fullSession = kspecJson<SessionContext>('session start --full --json', tempDir);
   113→
   114→      // Primer caps at 5, full shows all
   115→      expect(primerSession.ready_tasks.length).toBe(5);
   116→      expect(fullSession.ready_tasks.length).toBeGreaterThan(5);
   117→    });
   118→
   119→    it('should show up to 20 activity items in full mode', { timeout: 30000 }, () => {
   120→      // Create and complete 12 tasks
   121→      for (let i = 1; i <= 12; i++) {
   122→        kspec(`task add --title "Task ${i}" --slug task-${i}`, tempDir);
   123→        kspec(`task start @task-${i}`, tempDir);
   124→        kspec(`task submit @task-${i}`, tempDir);
   125→        kspec(`task complete @task-${i} --reason "Done"`, tempDir);
   126→      }
   127→
   128→      const session = kspecJson<SessionContext>('session start --full --json', tempDir);
   129→      expect(session.activity_timeline.length).toBeLessThanOrEqual(20);
   130→      expect(session.activity_timeline.length).toBeGreaterThan(10);
   131→    });
   132→
   133→    it('should show untriaged inbox items in full mode human output', () => {
   134→      // Add inbox items so the section appears
   135→      kspec('inbox add "Untriaged item for full mode"', tempDir);
   136→
   137→      const result = kspec('session start --full', tempDir);
   138→
   139→      // Full mode should show inbox header and untriaged items
   140→      expect(result.stdout).toContain('Inbox');
   141→      expect(result.stdout).toContain('untriaged');
   142→    });
   143→  });
   144→
   145→  // AC: @cmd-session-start ac-brief-alias
   146→  // AC: @trait-json-output ac-6 (--json takes precedence over --brief)
   147→  describe('--brief alias', () => {
   148→    it('should produce identical JSON output to primer mode', { timeout: 20000 }, () => {
   149→      kspec('task add --title "Test task" --slug test-task', tempDir);
   150→
   151→      const primerSession = kspecJson<SessionContext>('session start --json', tempDir);
   152→      const briefSession = kspecJson<SessionContext>('session start --brief --json', tempDir);
   153→
   154→      // Both should have same structure and limits
   155→      // generated_at will differ, so compare structural fields
   156→      expect(briefSession.ready_tasks.length).toBe(primerSession.ready_tasks.length);
   157→      expect(briefSession.activity_timeline.length).toBe(primerSession.activity_timeline.length);
   158→      expect(briefSession.active_tasks.length).toBe(primerSession.active_tasks.length);
   159→    });
   160→  });
   161→
   162→  // AC: @cmd-session-start ac-section-order
   163→  describe('section ordering', () => {
   164→    it('should render sections in correct order: active → review → blocked → ready → activity → inbox → working tree → quick commands', { timeout: 20000 }, () => {
   165→      // Create tasks in various states
   166→      kspec('task add --title "Active task" --slug active-task', tempDir);
   167→      kspec('task start @active-task', tempDir);
   168→
   169→      kspec('task add --title "Review task" --slug review-task', tempDir);
   170→      kspec('task start @review-task', tempDir);
   171→      kspec('task submit @review-task', tempDir);
   172→
   173→      kspec('task add --title "Ready task" --slug ready-task', tempDir);
   174→
   175→      // Complete a task to appear in activity timeline
   176→      kspec('task add --title "Done task" --slug done-task', tempDir);
   177→      kspec('task start @done-task', tempDir);
   178→      kspec('task submit @done-task', tempDir);
   179→      kspec('task complete @done-task --reason "Done"', tempDir);
   180→
   181→      // Create dirty working tree
   182→      writeFileSync(join(tempDir, 'dirty.txt'), 'dirty\n');
   183→
   184→      const result = kspec('session start', tempDir);
   185→      const output = result.stdout;
   186→
   187→      // Verify section ordering
   188→      const activeIdx = output.indexOf('Active Work');
   189→      const reviewIdx = output.indexOf('Awaiting Review');
   190→      const readyIdx = output.indexOf('Ready to Pick Up');
   191→      const activityIdx = output.indexOf('Recent Activity');
   192→      const workingTreeIdx = output.indexOf('Working Tree');
   193→      const quickIdx = output.indexOf('Quick Commands');
   194→
   195→      expect(activeIdx).toBeGreaterThan(-1);
   196→      expect(reviewIdx).toBeGreaterThan(activeIdx);
   197→      expect(readyIdx).toBeGreaterThan(reviewIdx);
   198→      expect(activityIdx).toBeGreaterThan(readyIdx);
   199→      expect(workingTreeIdx).toBeGreaterThan(activityIdx);
   200→      expect(quickIdx).toBeGreaterThan(workingTreeIdx);
   201→    });
   202→  });
   203→
   204→  // AC: @cmd-session-start ac-empty-skip
   205→  describe('empty section skipping', () => {
   206→    it('should not show "No Active Work" when no active tasks', () => {
   207→      const result = kspec('session start', tempDir);
   208→      expect(result.stdout).not.toContain('No Active Work');
   209→    });
   210→
   211→    it('should not show Active Work header when no active tasks', () => {
   212→      // Only create ready tasks, no active
   213→      kspec('task add --title "Ready task" --slug ready-task', tempDir);
   214→
   215→      const result = kspec('session start', tempDir);
   216→      // Ready section should appear, Active section should not
   217→      expect(result.stdout).toContain('Ready to Pick Up');
   218→      expect(result.stdout).not.toContain('Active Work');
   219→    });
   220→
   221→    it('should not show Awaiting Review header when no review tasks', () => {
   222→      const result = kspec('session start', tempDir);
   223→      expect(result.stdout).not.toContain('Awaiting Review');
   224→    });
   225→  });
   226→
   227→  // AC: @cmd-session-start ac-slug-display
   228→  describe('slug display', () => {
   229→    it('should display @slug for tasks with slugs in human output', () => {
   230→      kspec('task add --title "My feature" --slug my-feature', tempDir);
   231→      kspec('task start @my-feature', tempDir);
   232→
   233→      const result = kspec('session start', tempDir);
   234→      expect(result.stdout).toContain('@my-feature');
   235→    });
   236→
   237→    it('should include slug field in JSON active task summaries', () => {
   238→      kspec('task add --title "My feature" --slug my-feature', tempDir);
   239→      kspec('task start @my-feature', tempDir);
   240→
   241→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   242→      const task = session.active_tasks.find((t) => t.title === 'My feature');
   243→      expect(task).toBeDefined();
   244→      expect(task!.slug).toBe('my-feature');
   245→    });
   246→
   247→    it('should include slug field in JSON ready task summaries', () => {
   248→      kspec('task add --title "Ready feature" --slug ready-feature', tempDir);
   249→
   250→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   251→      const task = session.ready_tasks.find((t) => t.title === 'Ready feature');
   252→      expect(task).toBeDefined();
   253→      expect(task!.slug).toBe('ready-feature');
   254→    });
   255→  });
   256→
   257→  // AC: @cmd-session-start ac-slug-fallback
   258→  describe('slug fallback', () => {
   259→    it('should display @short-ulid for tasks without slugs in human output', () => {
   260→      kspec('task add --title "No slug task"', tempDir);
   261→
   262→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   263→      const task = session.ready_tasks.find((t) => t.title === 'No slug task');
   264→      expect(task).toBeDefined();
   265→      expect(task!.slug).toBeNull();
   266→
   267→      const result = kspec('session start', tempDir);
   268→      // Should show @ref (short ULID) instead
   269→      expect(result.stdout).toContain(`@${task!.ref}`);
   270→    });
   271→
   272→    // AC: @cmd-session-start ac-slug-fallback — inbox always uses @short-ulid
   273→    it('should use @short-ulid for inbox items (no slug schema)', () => {
   274→      const result = kspec('session start --full', tempDir);
   275→      // Inbox items don't have slugs — they use short ULID refs
   276→      // If there are inbox items they should show @ refs
   277→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   278→      for (const item of session.inbox_items) {
   279→        // ref should be 8-char ULID prefix
   280→        expect(item.ref.length).toBe(8);
   281→      }
   282→    });
   283→  });
   284→
   285→  // AC: @cmd-session-start ac-relative-time-human
   286→  describe('relative time in human output', () => {
   287→    it('should show relative timestamps in human output', () => {
   288→      kspec('task add --title "Recent task" --slug recent-task', tempDir);
   289→      kspec('task start @recent-task', tempDir);
