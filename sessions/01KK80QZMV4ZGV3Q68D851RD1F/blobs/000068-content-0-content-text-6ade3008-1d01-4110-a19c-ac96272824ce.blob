   423→  // AC: @cmd-session-start ac-notes-starvation
   424→  describe('notes starvation prevention', () => {
   425→    it('should include notes from all statuses in JSON', { timeout: 20000 }, () => {
   426→      // Create in_progress tasks with many notes
   427→      for (let i = 1; i <= 5; i++) {
   428→        kspec(`task add --title "Active ${i}" --slug active-${i}`, tempDir);
   429→        kspec(`task start @active-${i}`, tempDir);
   430→        kspec(`task note @active-${i} "Active note ${i}"`, tempDir);
   431→      }
   432→
   433→      // Create pending_review task
   434→      kspec('task add --title "Review" --slug review-task', tempDir);
   435→      kspec('task start @review-task', tempDir);
   436→      kspec('task note @review-task "Review note"', tempDir);
   437→      kspec('task submit @review-task', tempDir);
   438→
   439→      // Create completed task
   440→      kspec('task add --title "Done" --slug done-task', tempDir);
   441→      kspec('task start @done-task', tempDir);
   442→      kspec('task note @done-task "Done note"', tempDir);
   443→      kspec('task submit @done-task', tempDir);
   444→      kspec('task complete @done-task --reason "Finished"', tempDir);
   445→
   446→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   447→
   448→      const inProgressNotes = session.recent_notes.filter(
   449→        (n) => n.task_status === 'in_progress',
   450→      );
   451→      const reviewNotes = session.recent_notes.filter(
   452→        (n) => n.task_status === 'pending_review',
   453→      );
   454→      const completedNotes = session.recent_notes.filter(
   455→        (n) => n.task_status === 'completed',
   456→      );
   457→
   458→      // Each status should have at least one note (not starved)
   459→      expect(inProgressNotes.length).toBeGreaterThan(0);
   460→      expect(reviewNotes.length).toBeGreaterThan(0);
   461→      expect(completedNotes.length).toBeGreaterThan(0);
   462→    });
   463→  });
   464→
   465→  // AC: @cmd-session-start ac-json-raw-preserved
   466→  describe('JSON raw arrays preserved', () => {
   467→    it('should include recently_completed array in JSON', { timeout: 20000 }, () => {
   468→      kspec('task add --title "Task A" --slug task-a', tempDir);
   469→      kspec('task start @task-a', tempDir);
   470→      kspec('task submit @task-a', tempDir);
   471→      kspec('task complete @task-a --reason "Done A"', tempDir);
   472→
   473→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   474→      expect(session.recently_completed).toBeDefined();
   475→      expect(Array.isArray(session.recently_completed)).toBe(true);
   476→      expect(session.recently_completed.length).toBeGreaterThan(0);
   477→      expect(session.recently_completed[0].title).toBe('Task A');
   478→      expect(session.recently_completed[0].slug).toBe('task-a');
   479→    });
   480→
   481→    it('should include recent_commits array in JSON', () => {
   482→      writeFileSync(join(tempDir, 'new-file.ts'), 'export const x = 1;\n');
   483→      git('add new-file.ts', tempDir);
   484→      git('commit -m "feat: add new file"', tempDir);
