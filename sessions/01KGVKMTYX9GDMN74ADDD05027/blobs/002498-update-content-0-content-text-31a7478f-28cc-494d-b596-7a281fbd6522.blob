    63→// ─── Types ───────────────────────────────────────────────────────────────────
    64→
    65→export interface CheckpointResult {
    66→  /** Whether session can end cleanly */
    67→  ok: boolean;
    68→
    69→  /** Human-readable message for Claude Code */
    70→  message: string;
    71→
    72→  /** Issues that need attention before stopping */
    73→  issues: CheckpointIssue[];
    74→
    75→  /** Instructions for the agent */
    76→  instructions: string[];
    77→}
    78→
    79→export interface CheckpointIssue {
    80→  type: "uncommitted_changes" | "in_progress_task" | "incomplete_todo";
    81→  description: string;
    82→  details?: Record<string, unknown>;
    83→}
    84→
    85→export interface SessionContext {
    86→  /** When this context was generated */
    87→  generated_at: string;
    88→
    89→  /** Current git branch */
    90→  branch: string | null;
    91→
    92→  /** Session context (focus, threads, questions) */
    93→  context: StoredSessionContext | null;
    94→
    95→  /** Tasks currently in progress */
    96→  active_tasks: ActiveTaskSummary[];
    97→
    98→  /** Tasks awaiting review (code done, PR pending) */
    99→  pending_review_tasks: ActiveTaskSummary[];
   100→
   101→  /** Recent notes from active tasks */
   102→  recent_notes: NoteSummary[];
   103→
   104→  /** Incomplete todos from active tasks */
   105→  active_todos: TodoSummary[];
   106→
   107→  /** Tasks ready to be picked up */
   108→  ready_tasks: ReadyTaskSummary[];
   109→
   110→  /** Blocked tasks with blockers */
   111→  blocked_tasks: BlockedTaskSummary[];
   112→
   113→  /** Recently completed tasks */
   114→  recently_completed: CompletedTaskSummary[];
   115→
   116→  /** Recent git commits */
   117→  recent_commits: CommitSummary[];
   118→
   119→  /** Working tree status */
   120→  working_tree: GitWorkingTree | null;
   121→
   122→  /** Inbox items awaiting triage (oldest first) */
   123→  inbox_items: InboxSummary[];
   124→
   125→  /** Summary statistics */
   126→  stats: SessionStats;
   127→}
   128→
   129→export interface ActiveTaskSummary {
   130→  ref: string;
   131→  title: string;
   132→  started_at: string | null;
   133→  priority: number;
   134→  spec_ref: string | null;
   135→  note_count: number;
   136→  last_note_at: string | null;
   137→  todo_count: number;
   138→  incomplete_todos: number;
   139→}
   140→
   141→export interface NoteSummary {
   142→  task_ref: string;
   143→  task_title: string;
   144→  note_ulid: string;
