   146→  author: string | null;
   147→  content: string;
   148→}
   149→
   150→export interface TodoSummary {
   151→  task_ref: string;
   152→  task_title: string;
   153→  id: number;
   154→  text: string;
   155→  added_at: string;
   156→  added_by: string | null;
   157→}
   158→
   159→export interface ReadyTaskSummary {
   160→  ref: string;
   161→  title: string;
   162→  priority: number;
   163→  spec_ref: string | null;
   164→  tags: string[];
   165→}
   166→
   167→export interface BlockedTaskSummary {
   168→  ref: string;
   169→  title: string;
   170→  blocked_by: string[];
   171→  unmet_deps: string[];
   172→}
   173→
   174→export interface CompletedTaskSummary {
   175→  ref: string;
   176→  title: string;
   177→  completed_at: string;
   178→  closed_reason: string | null;
   179→  origin?: "manual" | "derived" | "observation_promotion";
   180→}
   181→
   182→export interface CommitSummary {
   183→  hash: string;
   184→  full_hash: string;
   185→  date: string;
   186→  message: string;
   187→  author: string;
   188→}
   189→
   190→export interface SessionStats {
   191→  total_tasks: number;
   192→  in_progress: number;
   193→  pending_review: number;
   194→  ready: number;
   195→  blocked: number;
   196→  completed: number;
   197→  inbox_items: number;
   198→}
   199→
   200→export interface InboxSummary {
   201→  ref: string;
   202→  text: string;
   203→  created_at: string;
   204→  tags: string[];
   205→  added_by: string | null;
   206→}
   207→
   208→export interface SessionOptions {
   209→  brief?: boolean;
   210→  full?: boolean;
   211→  since?: string;
   212→  git?: boolean;
   213→  limit?: string;
   214→  eligible?: boolean; // Only include automation-eligible tasks in ready_tasks
   215→}
   216→
   217→// ─── Data Gathering ──────────────────────────────────────────────────────────
   218→
   219→function toActiveTaskSummary(
   220→  task: LoadedTask,
   221→  index: ReferenceIndex,
   222→): ActiveTaskSummary {
   223→  const lastNote =
   224→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   225→  const incompleteTodos = task.todos.filter((t) => !t.done).length;
   226→  return {
   227→    ref: index.shortUlid(task._ulid),
   228→    title: task.title,
   229→    started_at: task.started_at || null,
   230→    priority: task.priority,
   231→    spec_ref: task.spec_ref || null,
   232→    note_count: task.notes.length,
   233→    last_note_at: lastNote ? lastNote.created_at : null,
   234→    todo_count: task.todos.length,
   235→    incomplete_todos: incompleteTodos,
   236→  };
   237→}
   238→
   239→function toReadyTaskSummary(
   240→  task: LoadedTask,
   241→  index: ReferenceIndex,
   242→): ReadyTaskSummary {
   243→  return {
   244→    ref: index.shortUlid(task._ulid),
   245→    title: task.title,
   246→    priority: task.priority,
   247→    spec_ref: task.spec_ref || null,
   248→    tags: task.tags,
   249→  };
   250→}
   251→
   252→function toBlockedTaskSummary(
   253→  task: LoadedTask,
   254→  _allTasks: LoadedTask[],
   255→  index: ReferenceIndex,
   256→): BlockedTaskSummary {
   257→  // Find unmet dependencies
   258→  const unmetDeps: string[] = [];
   259→  for (const depRef of task.depends_on) {
   260→    const result = index.resolve(depRef);
   261→    if (result.ok) {
   262→      const depItem = result.item;
   263→      if ("status" in depItem && depItem.status !== "completed") {
   264→        unmetDeps.push(depRef);
   265→      }
   266→    }
   267→  }
   268→
   269→  return {
   270→    ref: index.shortUlid(task._ulid),
   271→    title: task.title,
   272→    blocked_by: task.blocked_by,
   273→    unmet_deps: unmetDeps,
   274→  };
   275→}
   276→
   277→function toCompletedTaskSummary(
   278→  task: LoadedTask,
   279→  index: ReferenceIndex,
   280→): CompletedTaskSummary {
   281→  return {
   282→    ref: index.shortUlid(task._ulid),
   283→    title: task.title,
   284→    completed_at: task.completed_at || "",
   285→    closed_reason: task.closed_reason || null,
   286→    origin: task.origin,
   287→  };
   288→}
   289→
   290→function collectRecentNotes(
   291→  tasks: LoadedTask[],
   292→  index: ReferenceIndex,
   293→  options: { limit: number; since: Date | null },
   294→): NoteSummary[] {
   295→  const allNotes: NoteSummary[] = [];
   296→
   297→  for (const task of tasks) {
   298→    for (const note of task.notes) {
   299→      const noteDate = new Date(note.created_at);
   300→
   301→      // Filter by since date if provided
   302→      if (options.since && noteDate < options.since) {
   303→        continue;
   304→      }
   305→
   306→      allNotes.push({
   307→        task_ref: index.shortUlid(task._ulid),
   308→        task_title: task.title,
   309→        note_ulid: note._ulid.slice(0, 8),
   310→        created_at: note.created_at,
   311→        author: note.author || null,
   312→        content: note.content,
   313→      });
   314→    }
   315→  }
   316→
   317→  // Sort by date descending, take limit
   318→  return allNotes
   319→    .sort(
   320→      (a, b) =>
   321→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   322→    )
   323→    .slice(0, options.limit);
   324→}
   325→
   326→function collectIncompleteTodos(
   327→  tasks: LoadedTask[],
   328→  index: ReferenceIndex,
   329→  options: { limit: number },
   330→): TodoSummary[] {
   331→  const allTodos: TodoSummary[] = [];
   332→
   333→  for (const task of tasks) {
   334→    for (const todo of task.todos) {
   335→      // Only include incomplete todos
   336→      if (todo.done) continue;
   337→
   338→      allTodos.push({
   339→        task_ref: index.shortUlid(task._ulid),
   340→        task_title: task.title,
   341→        id: todo.id,
   342→        text: todo.text,
   343→        added_at: todo.added_at,
   344→        added_by: todo.added_by || null,
   345→      });
   346→    }
   347→  }
   348→
   349→  // Sort by added_at descending (most recent first), take limit
   350→  return allTodos
   351→    .sort(
   352→      (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime(),
   353→    )
   354→    .slice(0, options.limit);
   355→}
   356→
   357→/**
   358→ * Gather session context data
   359→ */
   360→export async function gatherSessionContext(
   361→  ctx: KspecContext,
   362→  options: SessionOptions,
   363→): Promise<SessionContext> {
   364→  const limit = parseInt(options.limit || "10", 10);
   365→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   366→  const showGit = options.git !== false; // default true
   367→
   368→  // Load all data
   369→  const allTasks = await loadAllTasks(ctx);
   370→  const items = await loadAllItems(ctx);
   371→  const inboxItems = await loadInboxItems(ctx);
   372→  const index = new ReferenceIndex(allTasks, items);
   373→
   374→  // Compute stats
   375→  const stats: SessionStats = {
   376→    total_tasks: allTasks.length,
   377→    in_progress: allTasks.filter((t) => t.status === "in_progress").length,
   378→    pending_review: allTasks.filter((t) => t.status === "pending_review")
   379→      .length,
   380→    ready: getReadyTasks(allTasks).length,
   381→    blocked: allTasks.filter((t) => t.status === "blocked").length,
   382→    completed: allTasks.filter((t) => t.status === "completed").length,
   383→    inbox_items: inboxItems.length,
   384→  };
   385→
   386→  // Get active tasks (optionally filtered to automation-eligible only)
   387→  // AC: @cli-ralph ac-16
   388→  const activeTasks = allTasks
   389→    .filter((t) => t.status === "in_progress")
   390→    .filter((t) => !options.eligible || t.automation === "eligible")
   391→    .sort((a, b) => a.priority - b.priority)
   392→    .slice(0, options.full ? undefined : limit)
   393→    .map((t) => toActiveTaskSummary(t, index));
   394→
   395→  // Get pending review tasks
   396→  const pendingReviewTasks = allTasks
   397→    .filter((t) => t.status === "pending_review")
   398→    .sort((a, b) => a.priority - b.priority)
   399→    .slice(0, options.full ? undefined : limit)
   400→    .map((t) => toActiveTaskSummary(t, index));
   401→
   402→  // Get recent notes from active tasks
   403→  const recentNotes = collectRecentNotes(
   404→    allTasks.filter((t) => t.status === "in_progress"),
   405→    index,
   406→    { limit: options.full ? limit * 2 : limit, since: sinceDate },
   407→  );
   408→
   409→  // Get incomplete todos from active tasks
   410→  const activeTodos = collectIncompleteTodos(
   411→    allTasks.filter((t) => t.status === "in_progress"),
   412→    index,
   413→    { limit: options.full ? limit * 2 : limit },
   414→  );
   415→
   416→  // Get ready tasks (optionally filtered to automation-eligible only)
   417→  const readyTasks = getReadyTasks(allTasks)
   418→    .filter((t) => !options.eligible || t.automation === "eligible")
   419→    .slice(0, options.full ? undefined : limit)
   420→    .map((t) => toReadyTaskSummary(t, index));
   421→
   422→  // Get blocked tasks
   423→  const blockedTasks = allTasks
   424→    .filter((t) => t.status === "blocked")
   425→    .slice(0, options.full ? undefined : limit)
   426→    .map((t) => toBlockedTaskSummary(t, allTasks, index));
   427→
   428→  // Get recently completed tasks
   429→  const recentlyCompleted = allTasks
   430→    .filter((t) => {
   431→      if (t.status !== "completed" || !t.completed_at) return false;
   432→      const completedDate = new Date(t.completed_at);
   433→      if (sinceDate && completedDate < sinceDate) return false;
   434→      return true;
   435→    })
   436→    .sort((a, b) => {
   437→      // Sort by completed_at descending (most recent first)
   438→      const aDate = new Date(a.completed_at || 0);
   439→      const bDate = new Date(b.completed_at || 0);
   440→      return bDate.getTime() - aDate.getTime();
   441→    })
   442→    .slice(0, options.full ? undefined : limit)
   443→    .map((t) => toCompletedTaskSummary(t, index));
   444→
   445→  // Get git info
   446→  let branch: string | null = null;
   447→  let recentCommits: CommitSummary[] = [];
   448→  let workingTree: GitWorkingTree | null = null;
   449→
   450→  if (showGit && isGitRepo(ctx.rootDir)) {
   451→    branch = getCurrentBranch(ctx.rootDir);
   452→
   453→    const commits = getRecentCommits({
   454→      limit: options.full ? limit * 2 : limit,
   455→      since: sinceDate || undefined,
   456→      cwd: ctx.rootDir,
   457→    });
   458→
   459→    recentCommits = commits.map((c) => ({
   460→      hash: c.hash,
   461→      full_hash: c.fullHash,
   462→      date: c.date.toISOString(),
   463→      message: c.message,
   464→      author: c.author,
   465→    }));
   466→
   467→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   468→  }
   469→
   470→  // Get inbox items (oldest first to encourage triage)
   471→  const inboxSummaries: InboxSummary[] = inboxItems
   472→    .sort(
   473→      (a, b) =>
   474→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   475→    )
   476→    .slice(0, options.full ? undefined : limit)
   477→    .map((item) => ({
   478→      ref: item._ulid.slice(0, 8),
   479→      text: item.text,
   480→      created_at: item.created_at,
   481→      tags: item.tags,
   482→      added_by: item.added_by || null,
   483→    }));
   484→
   485→  // Load session context (focus, threads, questions)
   486→  const sessionContext = await loadSessionContext(ctx);
   487→
   488→  return {
   489→    generated_at: new Date().toISOString(),
   490→    branch,
   491→    context: sessionContext,
   492→    active_tasks: activeTasks,
   493→    pending_review_tasks: pendingReviewTasks,
   494→    recent_notes: recentNotes,
   495→    active_todos: activeTodos,
   496→    ready_tasks: readyTasks,
   497→    blocked_tasks: blockedTasks,
   498→    recently_completed: recentlyCompleted,
   499→    recent_commits: recentCommits,
   500→    working_tree: workingTree,
   501→    inbox_items: inboxSummaries,
   502→    stats,
   503→  };
   504→}
   505→
   506→// ─── Iteration Stats ─────────────────────────────────────────────────────────
   507→
   508→/**
   509→ * Stats for tasks completed/started within a time window.
   510→ * Used by ralph to track task completions per iteration.
   511→ */
   512→export interface IterationStats {
   513→  /** Number of tasks completed since the given time */
   514→  tasks_completed: number;
   515→  /** Number of tasks started since the given time */
   516→  tasks_started: number;
   517→  /** References of completed tasks */
   518→  completed_refs: string[];
   519→}
   520→
   521→/**
   522→ * Get iteration stats - tasks completed/started since a given time.
   523→ * AC: @ralph-task-limit ac-detection
   524→ */
   525→export async function getIterationStats(
   526→  ctx: KspecContext,
   527→  since: Date,
   528→): Promise<IterationStats> {
   529→  const allTasks = await loadAllTasks(ctx);
   530→
   531→  const completedSince = allTasks.filter((t) => {
   532→    if (t.status !== "completed" || !t.completed_at) return false;
   533→    return new Date(t.completed_at) >= since;
   534→  });
   535→
   536→  const startedSince = allTasks.filter((t) => {
   537→    if (!t.started_at) return false;
   538→    return new Date(t.started_at) >= since;
   539→  });
   540→
   541→  // Use first slug or ULID prefix as ref
   542→  const getRef = (t: LoadedTask) =>
   543→    t.slugs.length > 0 ? `@${t.slugs[0]}` : `@${t._ulid.slice(0, 8)}`;
   544→
   545→  return {
   546→    tasks_completed: completedSince.length,
   547→    tasks_started: startedSince.length,
   548→    completed_refs: completedSince.map(getRef),
   549→  };
   550→}
   551→
   552→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   553→
   554→export interface CheckpointOptions {
   555→  force?: boolean;
   556→  /** Set when stop hook is already active (retry after previous block) */
   557→  stopHookActive?: boolean;
   558→}
   559→
   560→/** Claude Code hook input for Stop hooks */
   561→export interface StopHookInput {
   562→  session_id?: string;
   563→  transcript_path?: string;
   564→  hook_event_name?: string;
   565→  stop_hook_active?: boolean;
   566→}
   567→
   568→/**
   569→ * Perform session checkpoint - check for uncommitted work before ending session.
   570→ *
   571→ * This is designed for use as a Claude Code stop hook. It checks for:
   572→ * - Uncommitted git changes (staged, unstaged, untracked)
   573→ * - Tasks in in_progress status
   574→ * - Incomplete todos on active tasks
   575→ *
   576→ * Returns a structured result indicating whether the session can end cleanly.
   577→ */
   578→export async function performCheckpoint(
   579→  ctx: KspecContext,
   580→  options: CheckpointOptions,
   581→): Promise<CheckpointResult> {
   582→  const issues: CheckpointIssue[] = [];
   583→  const instructions: string[] = [];
   584→
   585→  // Load tasks
   586→  const allTasks = await loadAllTasks(ctx);
   587→
   588→  // Check for in-progress tasks
   589→  const inProgressTasks = allTasks.filter((t) => t.status === "in_progress");
   590→  for (const task of inProgressTasks) {
   591→    const ref = task.slugs[0]
   592→      ? `@${task.slugs[0]}`
   593→      : `@${task._ulid.slice(0, 8)}`;
   594→    issues.push({
   595→      type: "in_progress_task",
   596→      description: `Task ${ref} is still in progress: ${task.title}`,
   597→      details: {
   598→        ref,
   599→        title: task.title,
   600→        started_at: task.started_at,
   601→      },
   602→    });
   603→
   604→    // Check for incomplete todos on this task
   605→    const incompleteTodos = task.todos.filter((t) => !t.done);
   606→    for (const todo of incompleteTodos) {
   607→      issues.push({
   608→        type: "incomplete_todo",
   609→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   610→        details: {
   611→          task_ref: ref,
   612→          todo_id: todo.id,
   613→          text: todo.text,
   614→        },
   615→      });
   616→    }
   617→  }
   618→
   619→  // Check for uncommitted git changes
   620→  if (isGitRepo(ctx.rootDir)) {
   621→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   622→    if (!workingTree.clean) {
   623→      const changeCount =
   624→        workingTree.staged.length +
   625→        workingTree.unstaged.length +
   626→        workingTree.untracked.length;
   627→
   628→      issues.push({
   629→        type: "uncommitted_changes",
   630→        description: `${changeCount} uncommitted changes in working tree`,
   631→        details: {
   632→          staged: workingTree.staged.length,
   633→          unstaged: workingTree.unstaged.length,
   634→          untracked: workingTree.untracked.length,
   635→        },
   636→      });
   637→    }
   638→  }
   639→
   640→  // Build instructions based on issues
   641→  if (issues.length > 0 && !options.force) {
   642→    instructions.push(
   643→      "If you've been instructed to ignore this message or are working on",
   644→    );
   645→    instructions.push(
   646→      "unrelated things to any in progress tasks then disregard this message,",
   647→    );
   648→    instructions.push("otherwise before ending this session, please:");
   649→
   650→    const hasInProgress = issues.some((i) => i.type === "in_progress_task");
   651→    const hasUncommitted = issues.some((i) => i.type === "uncommitted_changes");
   652→    const hasIncompleteTodos = issues.some((i) => i.type === "incomplete_todo");
   653→
   654→    let step = 1;
   655→
   656→    if (hasInProgress) {
   657→      instructions.push(
   658→        `${step++}. Read in-progress task notes to get full context of the current task status`,
   659→      );
   660→      instructions.push(
   661→        `${step++}. Add notes documenting current state if any context is missing from this session`,
   662→      );
   663→      instructions.push(
   664→        `${step++}. Complete the task if you've completed the objectives and no AC are left uncovered\notherwise leave it in progress for a future session`,
   665→      );
   666→    }
   667→
   668→    if (hasIncompleteTodos) {
   669→      instructions.push(
   670→        `${step++}. Complete or acknowledge incomplete todos on active tasks`,
   671→      );
   672→    }
   673→
   674→    if (hasUncommitted) {
   675→      instructions.push(
   676→        `${step++}. Commit your changes with a descriptive message`,
   677→      );
   678→
   679→      // Add WIP commit guidance if there are in-progress tasks
   680→      if (inProgressTasks.length > 0) {
   681→        const task = inProgressTasks[0];
   682→        const guidance = formatCommitGuidance(task, { wip: true });
   683→        instructions.push("");
   684→        instructions.push("Suggested WIP commit:");
   685→        instructions.push(`  ${guidance.message}`);
   686→        instructions.push("");
   687→        for (const trailer of guidance.trailers) {
   688→          instructions.push(`  ${trailer}`);
   689→        }
   690→      }
   691→    }
   692→
   693→    instructions.push("");
   694→    instructions.push("Use: kspec task @task to get current task state");
   695→    instructions.push(
   696→      'Use: kspec task note @task "Progress notes..." to document state',
   697→    );
   698→    instructions.push(
   699→      'Use: kspec task complete @task --reason "Summary" if task is done',
   700→    );
   701→  }
   702→
   703→  // Allow stop if:
   704→  // - No issues found
   705→  // - --force flag passed
   706→  // - This is a retry (stop_hook_active = true from previous block)
   707→  const isRetry = options.stopHookActive === true;
   708→  const ok = issues.length === 0 || options.force === true || isRetry;
   709→
   710→  let message: string;
   711→  if (isRetry && issues.length > 0) {
   712→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   713→  } else if (ok) {
   714→    message = "[kspec] Session checkpoint passed - ready to end session";
   715→  } else {
   716→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   717→  }
   718→
   719→  return {
   720→    ok,
   721→    message,
   722→    issues,
   723→    instructions,
   724→  };
   725→}
   726→
   727→// ─── Output Formatting ───────────────────────────────────────────────────────
   728→
   729→function formatCheckpointResult(result: CheckpointResult): void {
   730→  if (result.ok) {
   731→    console.log(chalk.green(result.message));
   732→  } else {
   733→    console.log(chalk.yellow(result.message));
   734→    console.log("");
   735→
   736→    for (const issue of result.issues) {
   737→      const icon =
   738→        issue.type === "uncommitted_changes"
   739→          ? chalk.yellow("⚠")
   740→          : issue.type === "in_progress_task"
   741→            ? chalk.blue("●")
   742→            : chalk.gray("○");
   743→      console.log(`  ${icon} ${issue.description}`);
   744→    }
   745→
   746→    if (result.instructions.length > 0) {
   747→      console.log("");
   748→      for (const instruction of result.instructions) {
   749→        console.log(chalk.gray(instruction));
   750→      }
   751→    }
   752→  }
   753→}
   754→
   755→function formatSessionContext(
   756→  ctx: SessionContext,
   757→  options: SessionOptions,
   758→): void {
   759→  const isBrief = !options.full;
   760→
   761→  // Header
   762→  console.log(`\n${sessionHeaders.title}`);
   763→  const age = formatRelativeTime(new Date(ctx.generated_at));
   764→  if (ctx.branch) {
   765→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   766→  } else {
   767→    console.log(chalk.gray(`Generated: ${age}`));
   768→  }
   769→
   770→  // Stats summary
   771→  const pendingReviewNote =
   772→    ctx.stats.pending_review > 0
   773→      ? `${ctx.stats.pending_review} awaiting review, `
   774→      : "";
   775→  const inboxNote =
   776→    ctx.stats.inbox_items > 0 ? ` | Inbox: ${ctx.stats.inbox_items}` : "";
   777→  console.log(
   778→    chalk.gray(
   779→      `Tasks: ${ctx.stats.in_progress} active, ${pendingReviewNote}${ctx.stats.ready} ready, ` +
   780→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`,
   781→    ),
   782→  );
   783→
   784→  // Session context section (focus, threads, questions)
   785→  if (
   786→    ctx.context &&
   787→    (ctx.context.focus ||
   788→      ctx.context.threads.length > 0 ||
   789→      ctx.context.open_questions.length > 0)
   790→  ) {
   791→    console.log("\n--- Session Context ---");
   792→
   793→    if (ctx.context.focus) {
   794→      console.log(`  ${chalk.cyan("Focus:")} ${ctx.context.focus}`);
   795→    }
   796→
   797→    if (ctx.context.threads.length > 0) {
   798→      console.log(`  ${chalk.cyan("Active Threads:")}`);
   799→      for (const thread of ctx.context.threads) {
   800→        console.log(`    - ${thread}`);
   801→      }
   802→    }
   803→
   804→    if (ctx.context.open_questions.length > 0) {
   805→      console.log(`  ${chalk.cyan("Open Questions:")}`);
   806→      for (const question of ctx.context.open_questions) {
   807→        console.log(`    - ${question}`);
   808→      }
   809→    }
   810→  }
   811→
   812→  // Active tasks section
   813→  if (ctx.active_tasks.length > 0) {
   814→    console.log(`\n${sessionHeaders.activeWork}`);
   815→    for (const task of ctx.active_tasks) {
   816→      const started = task.started_at
   817→        ? chalk.gray(
   818→            ` (started ${formatRelativeTime(new Date(task.started_at))})`,
   819→          )
   820→        : "";
   821→      const priority =
   822→        task.priority <= 2
   823→          ? chalk.red(`P${task.priority}`)
   824→          : chalk.gray(`P${task.priority}`);
   825→      console.log(
   826→        `  ${chalk.blue("[in_progress]")} ${priority} ${task.ref} ${task.title}${started}`,
   827→      );
   828→    }
   829→  } else {
   830→    console.log(`\n${sessionHeaders.noActiveWork}`);
   831→  }
   832→
   833→  // Awaiting review section
   834→  if (ctx.pending_review_tasks.length > 0) {
   835→    console.log(`\n${sessionHeaders.awaitingReview}`);
   836→    for (const task of ctx.pending_review_tasks) {
   837→      const priority =
   838→        task.priority <= 2
   839→          ? chalk.red(`P${task.priority}`)
   840→          : chalk.gray(`P${task.priority}`);
   841→      console.log(
   842→        `  ${chalk.yellow("[pending_review]")} ${priority} ${task.ref} ${task.title}`,
   843→      );
   844→    }
   845→  }
   846→
   847→  // Recently completed section
   848→  if (ctx.recently_completed.length > 0) {
   849→    console.log(`\n${sessionHeaders.recentlyCompleted}`);
   850→    const observationPromotedTasks: string[] = [];
   851→    for (const task of ctx.recently_completed) {
   852→      const completedAge = formatRelativeTime(new Date(task.completed_at));
   853→      let reason = "";
   854→      if (task.closed_reason) {
   855→        const maxLen = isBrief ? 60 : 120;
   856→        const truncated =
   857→          task.closed_reason.length > maxLen
   858→            ? `${task.closed_reason.slice(0, maxLen).trim()}...`
   859→            : task.closed_reason;
   860→        reason = chalk.gray(` - ${truncated}`);
   861→      }
   862→      console.log(
   863→        `  ${chalk.green("[completed]")} ${task.ref} ${task.title} ${chalk.gray(`(${completedAge})`)}${reason}`,
   864→      );
   865→
   866→      // Track tasks that came from observations
   867→      if (task.origin === "observation_promotion") {
   868→        observationPromotedTasks.push(task.ref);
   869→      }
   870→    }
   871→
   872→    // Show reminder about resolving observations
   873→    if (observationPromotedTasks.length > 0) {
   874→      console.log(
   875→        chalk.yellow(
   876→          `\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(", ")}`,
   877→        ),
   878→      );
   879→      console.log(
   880→        chalk.gray(`    Run: kspec meta observations --pending-resolution`),
   881→      );
   882→    }
   883→  }
   884→
   885→  // Recent notes section
   886→  if (ctx.recent_notes.length > 0) {
   887→    console.log(`\n${sessionHeaders.recentNotes}`);
   888→    for (const note of ctx.recent_notes) {
   889→      const age = formatRelativeTime(new Date(note.created_at));
   890→      const author = note.author ? chalk.gray(` by ${note.author}`) : "";
   891→      console.log(`  ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
   892→
   893→      // Truncate content in brief mode
   894→      let content = note.content.trim();
   895→      if (isBrief && content.length > 200) {
   896→        content = `${content.slice(0, 200).trim()}...`;
   897→      }
   898→
   899→      // Indent content, limit lines in brief mode
   900→      const lines = content.split("\n");
   901→      const maxLines = isBrief ? 3 : lines.length;
   902→      for (const line of lines.slice(0, maxLines)) {
   903→        console.log(`    ${chalk.white(line)}`);
   904→      }
   905→      if (isBrief && lines.length > maxLines) {
   906→        console.log(
   907→          chalk.gray(`    ... (${lines.length - maxLines} more lines)`),
   908→        );
   909→      }
   910→    }
   911→  }
   912→
   913→  // Incomplete todos section
   914→  if (ctx.active_todos.length > 0) {
   915→    console.log(`\n${sessionHeaders.incompleteTodos}`);
   916→    for (const todo of ctx.active_todos) {
   917→      console.log(
   918→        `  ${chalk.yellow("[ ]")} ${todo.task_ref}#${todo.id}: ${todo.text}`,
   919→      );
   920→    }
   921→  }
   922→
   923→  // Ready tasks section
   924→  if (ctx.ready_tasks.length > 0) {
   925→    console.log(`\n${sessionHeaders.readyTasks}`);
   926→    for (const task of ctx.ready_tasks) {
   927→      const priority =
   928→        task.priority <= 2
   929→          ? chalk.red(`P${task.priority}`)
   930→          : chalk.gray(`P${task.priority}`);
   931→      const tags =
   932→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(" #")}`) : "";
   933→      console.log(`  ${priority} ${task.ref} ${task.title}${tags}`);
   934→    }
   935→  }
   936→
   937→  // Blocked tasks section
   938→  if (ctx.blocked_tasks.length > 0) {
   939→    console.log(`\n${sessionHeaders.blocked}`);
   940→    for (const task of ctx.blocked_tasks) {
   941→      console.log(`  ${chalk.red("[blocked]")} ${task.ref} ${task.title}`);
   942→      if (task.blocked_by.length > 0) {
   943→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(", ")}`));
   944→      }
   945→      if (task.unmet_deps.length > 0) {
   946→        console.log(
   947→          chalk.gray(`    Waiting on: ${task.unmet_deps.join(", ")}`),
   948→        );
   949→      }
   950→    }
   951→  }
   952→
   953→  // Git commits section
   954→  if (ctx.recent_commits.length > 0) {
   955→    console.log(`\n${sessionHeaders.recentCommits}`);
   956→    for (const commit of ctx.recent_commits) {
   957→      const age = formatRelativeTime(new Date(commit.date));
   958→      console.log(
   959→        `  ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${age}, ${commit.author})`)}`,
   960→      );
   961→    }
   962→  }
   963→
   964→  // Inbox section (oldest first to encourage triage)
   965→  if (ctx.inbox_items.length > 0) {
   966→    console.log(`\n${sessionHeaders.inbox}`);
   967→    for (const item of ctx.inbox_items) {
   968→      const age = formatRelativeTime(new Date(item.created_at));
   969→      const author = item.added_by ? ` by ${item.added_by}` : "";
   970→      const tags =
   971→        item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(", ")}]`) : "";
   972→      // Truncate text in brief mode
   973→      let text = item.text;
   974→      if (isBrief && text.length > 60) {
   975→        text = `${text.slice(0, 60).trim()}...`;
   976→      }
   977→      console.log(
   978→        `  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`,
   979→      );
   980→      console.log(`    ${text}`);
   981→    }
   982→    console.log(`  ${hints.inboxPromote}`);
   983→  }
   984→
   985→  // Working tree section
   986→  if (ctx.working_tree && !ctx.working_tree.clean) {
   987→    console.log(`\n${sessionHeaders.workingTree}`);
   988→
   989→    if (ctx.working_tree.staged.length > 0) {
   990→      console.log(chalk.green("  Staged:"));
   991→      for (const file of ctx.working_tree.staged) {
   992→        console.log(
   993→          `    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`,
   994→        );
   995→      }
   996→    }
   997→
   998→    if (ctx.working_tree.unstaged.length > 0) {
   999→      console.log(chalk.red("  Modified:"));
  1000→      for (const file of ctx.working_tree.unstaged) {
  1001→        console.log(
  1002→          `    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`,
  1003→        );
  1004→      }
  1005→    }
  1006→
  1007→    if (ctx.working_tree.untracked.length > 0) {
  1008→      console.log(chalk.gray("  Untracked:"));
  1009→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
  1010→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
  1011→        console.log(`    ${chalk.gray("?")} ${path}`);
  1012→      }
  1013→      if (isBrief && ctx.working_tree.untracked.length > limit) {
  1014→        console.log(
  1015→          chalk.gray(
  1016→            `    ... and ${ctx.working_tree.untracked.length - limit} more`,
  1017→          ),
  1018→        );
  1019→      }
  1020→    }
  1021→  } else if (ctx.working_tree?.clean) {
  1022→    console.log(`\n${sessionHeaders.workingTreeClean}`);
  1023→  }
  1024→
  1025→  // Quick Commands section - contextual hints based on state
  1026→  const quickCommands: string[] = [];
  1027→
  1028→  if (ctx.active_tasks.length > 0) {
  1029→    const ref = ctx.active_tasks[0].ref;
  1030→    quickCommands.push(
  1031→      `kspec task note @${ref} "Progress..."  ${chalk.gray("# document work")}`,
  1032→    );
  1033→    quickCommands.push(
  1034→      `kspec task complete @${ref} --reason "..."  ${chalk.gray("# finish task")}`,
  1035→    );
  1036→  } else if (ctx.ready_tasks.length > 0) {
  1037→    const ref = ctx.ready_tasks[0].ref;
  1038→    quickCommands.push(
  1039→      `kspec task start @${ref}  ${chalk.gray("# begin work")}`,
  1040→    );
  1041→  }
  1042→
  1043→  if (ctx.inbox_items.length > 0) {
  1044→    const ref = ctx.inbox_items[0].ref;
  1045→    quickCommands.push(
  1046→      `kspec inbox promote @${ref} --title "..."  ${chalk.gray("# convert to task")}`,
  1047→    );
  1048→  }
  1049→
  1050→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1051→    quickCommands.push(
  1052→      `git add . && git commit -m "..."  ${chalk.gray("# commit changes")}`,
  1053→    );
  1054→  }
  1055→
  1056→  if (quickCommands.length > 0) {
  1057→    console.log(`\n${sessionHeaders.quickCommands}`);
  1058→    for (const hint of quickCommands) {
  1059→      console.log(`  ${hint}`);
  1060→    }
  1061→  }
  1062→
  1063→  console.log(""); // Final newline
  1064→}
  1065→
  1066→// ─── Command Registration ────────────────────────────────────────────────────
  1067→
  1068→async function sessionStartAction(options: SessionOptions): Promise<void> {
  1069→  try {
  1070→    const ctx = await initContext();
  1071→
  1072→    // AC: @shadow-sync ac-2 - Pull remote changes before showing session context
  1073→    let syncResult: ShadowSyncResult | null = null;
  1074→    if (ctx.shadow?.enabled) {
  1075→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
  1076→      // AC: @shadow-sync ac-3 - Warn about conflicts but continue with local state
  1077→      if (syncResult.hadConflict) {
  1078→        console.log(
  1079→          chalk.yellow(
  1080→            "⚠ Shadow sync conflict detected. Run `kspec shadow resolve` to fix.",
  1081→          ),
  1082→        );
  1083→        console.log(chalk.gray("  Continuing with local state..."));
  1084→        console.log("");
  1085→      } else if (syncResult.pulled) {
  1086→        console.log(chalk.gray("ℹ Synced shadow branch from remote"));
  1087→      }
  1088→    }
  1089→
  1090→    const sessionCtx = await gatherSessionContext(ctx, options);
  1091→
  1092→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
  1093→  } catch (err) {
  1094→    error(errors.failures.gatherSessionContext, err);
  1095→    process.exit(EXIT_CODES.ERROR);
  1096→  }
  1097→}
  1098→
  1099→/**
  1100→ * Read stdin if available (non-blocking check for hook input)
  1101→ */
  1102→async function readStdinIfAvailable(): Promise<string | null> {
  1103→  // Check if stdin is a TTY (interactive) - if so, don't try to read
  1104→  if (process.stdin.isTTY) {
  1105→    return null;
  1106→  }
  1107→
  1108→  return new Promise((resolve) => {
  1109→    let data = "";
  1110→    const timeout = setTimeout(() => {
  1111→      process.stdin.removeAllListeners();
  1112→      resolve(data || null);
  1113→    }, 100); // 100ms timeout for stdin
  1114→
  1115→    process.stdin.setEncoding("utf8");
  1116→    process.stdin.on("data", (chunk) => {
  1117→      data += chunk;
  1118→    });
  1119→    process.stdin.on("end", () => {
  1120→      clearTimeout(timeout);
  1121→      resolve(data || null);
  1122→    });
  1123→    process.stdin.on("error", () => {
  1124→      clearTimeout(timeout);
  1125→      resolve(null);
  1126→    });
  1127→    process.stdin.resume();
  1128→  });
  1129→}
  1130→
  1131→/**
  1132→ * Parse Claude Code hook input from stdin
  1133→ */
  1134→function parseHookInput(stdin: string | null): StopHookInput | null {
  1135→  if (!stdin) return null;
  1136→  try {
  1137→    return JSON.parse(stdin.trim()) as StopHookInput;
  1138→  } catch {
  1139→    return null;
  1140→  }
  1141→}
  1142→
  1143→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
  1144→
  1145→/**
  1146→ * Output spec-first reminder for UserPromptSubmit hook.
  1147→ *
  1148→ * This is a simple context injection - always outputs the reminder,
  1149→ * and Claude (Opus) is smart enough to apply it when relevant.
  1150→ */
  1151→async function sessionPromptCheckAction(): Promise<void> {
  1152→  // Lean, instructive reminder with kspec prefix
  1153→  console.log(sessionPrompt.specCheck);
  1154→}
  1155→
  1156→async function sessionCheckpointAction(
  1157→  options: CheckpointOptions,
  1158→): Promise<void> {
  1159→  try {
  1160→    // Read stdin for Claude Code hook input
  1161→    const stdin = await readStdinIfAvailable();
  1162→    const hookInput = parseHookInput(stdin);
  1163→
  1164→    // Check if this is a retry (stop hook already active)
  1165→    if (hookInput?.stop_hook_active) {
  1166→      options.stopHookActive = true;
  1167→    }
  1168→
  1169→    const ctx = await initContext();
  1170→    const result = await performCheckpoint(ctx, options);
  1171→
  1172→    // Output format depends on mode:
  1173→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
  1174→    // - Human mode: Output formatted checkpoint result
  1175→    if (isJsonMode()) {
  1176→      if (!result.ok) {
  1177→        // Build reason message with issues and instructions
  1178→        const issueLines = result.issues
  1179→          .map((i) => `- ${i.description}`)
  1180→          .join("\n");
  1181→        const instructionLines = result.instructions
  1182→          .filter((i) => i.trim())
  1183→          .join("\n");
  1184→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
  1185→        console.log(JSON.stringify({ decision: "block", reason }));
  1186→      }
  1187→      // If ok, exit silently (Claude Code expects no output when allowing stop)
  1188→    } else {
  1189→      formatCheckpointResult(result);
  1190→      if (!result.ok) {
  1191→        process.exit(EXIT_CODES.ERROR);
  1192→      }
  1193→    }
  1194→  } catch (err) {
  1195→    // Handle RUNNING_FROM_SHADOW gracefully - skip with warning instead of erroring
  1196→    // This happens when the stop hook runs while cwd is inside .kspec/ directory
  1197→    if (err instanceof ShadowError && err.code === "RUNNING_FROM_SHADOW") {
  1198→      if (!isJsonMode()) {
  1199→        console.log(
  1200→          chalk.yellow(
  1201→            "[kspec] Session checkpoint skipped - running from inside .kspec/ directory",
  1202→          ),
  1203→        );
  1204→      }
  1205→      // Allow stop to proceed (exit successfully, no JSON output blocks the stop)
  1206→      return;
  1207→    }
  1208→    error(errors.failures.runCheckpoint, err);
  1209→    process.exit(EXIT_CODES.ERROR);
  1210→  }
  1211→}
  1212→
  1213→// ─── Session Log List ─────────────────────────────────────────────────────────
  1214→
  1215→interface SessionLogListOptions {
  1216→  status?: string;
  1217→  agent?: string;
  1218→  since?: string;
  1219→  sort?: string;
  1220→  count?: boolean;
  1221→  limit?: string;
  1222→}
  1223→
  1224→type SortField =
  1225→  | "started_at"
  1226→  | "duration"
  1227→  | "events"
  1228→  | "iterations"
  1229→  | "tasks_completed";
  1230→
  1231→const VALID_SORT_FIELDS: SortField[] = [
  1232→  "started_at",
  1233→  "duration",
  1234→  "events",
  1235→  "iterations",
  1236→  "tasks_completed",
  1237→];
  1238→
  1239→/**
  1240→ * Format a duration in milliseconds to a human-readable string.
  1241→ */
  1242→function formatDuration(ms: number): string {
  1243→  if (ms < 0) return "—";
  1244→  const totalSec = Math.floor(ms / 1000);
  1245→  const hours = Math.floor(totalSec / 3600);
  1246→  const minutes = Math.floor((totalSec % 3600) / 60);
  1247→  if (hours > 0) {
  1248→    return `${hours}h ${minutes}m`;
  1249→  }
  1250→  if (minutes > 0) {
  1251→    return `${minutes}m`;
  1252→  }
  1253→  return `${totalSec}s`;
  1254→}
  1255→
  1256→/**
  1257→ * Sort session summaries by the specified field.
  1258→ * Default: started_at descending.
  1259→ *
  1260→ * AC: @session-log-list ac-5
  1261→ */
  1262→function sortSessions(
  1263→  sessions: SessionLogSummary[],
  1264→  sortField: SortField,
  1265→): SessionLogSummary[] {
  1266→  return [...sessions].sort((a, b) => {
  1267→    switch (sortField) {
  1268→      case "started_at":
  1269→        return (
  1270→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1271→        );
  1272→      case "duration":
  1273→        return b.duration_ms - a.duration_ms;
  1274→      case "events":
  1275→        return b.event_count - a.event_count;
  1276→      case "iterations":
  1277→        return b.iteration_count - a.iteration_count;
  1278→      case "tasks_completed":
  1279→        return b.tasks_completed - a.tasks_completed;
  1280→      default:
  1281→        return (
  1282→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1283→        );
  1284→    }
  1285→  });
  1286→}
  1287→
  1288→/**
  1289→ * Format the session log list as a table.
  1290→ *
  1291→ * AC: @session-log-list ac-1
  1292→ */
  1293→function formatSessionLogList(sessions: SessionLogSummary[]): void {
  1294→  if (sessions.length === 0) {
  1295→    // AC: @session-log-list ac-6
  1296→    console.log("No sessions found.");
  1297→    return;
  1298→  }
  1299→
  1300→  // Table header
  1301→  console.log(
  1302→    chalk.gray(
  1303→      `${"ID".padEnd(10)} ${"Status".padEnd(11)} ${"Agent".padEnd(20)} ${"Started".padEnd(16)} ${"Duration".padEnd(10)} ${"Events".padEnd(8)} ${"Iters".padEnd(7)} Tasks`,
  1304→    ),
  1305→  );
  1306→  console.log(chalk.gray("─".repeat(95)));
  1307→
  1308→  for (const s of sessions) {
  1309→    const id = s.id.slice(0, 8);
  1310→    const statusColor =
  1311→      s.status === "completed"
  1312→        ? chalk.green
  1313→        : s.status === "active"
  1314→          ? chalk.blue
  1315→          : chalk.yellow;
  1316→    const status = statusColor(s.status.padEnd(11));
  1317→    const agent = s.agent_type.slice(0, 20).padEnd(20);
  1318→    const started = formatRelativeTime(new Date(s.started_at)).padEnd(16);
  1319→    const duration = formatDuration(s.duration_ms).padEnd(10);
  1320→    const events = String(s.event_count).padEnd(8);
  1321→    const iters = String(s.iteration_count).padEnd(7);
  1322→    const tasks = String(s.tasks_completed);
  1323→
  1324→    console.log(
  1325→      `${chalk.yellow(id)} ${status} ${chalk.gray(agent)} ${chalk.gray(started)} ${duration} ${events} ${iters} ${tasks}`,
  1326→    );
  1327→  }
  1328→
  1329→  console.log(chalk.gray(`\n${sessions.length} session(s)`));
  1330→}
  1331→
  1332→/**
  1333→ * Session log list action handler.
  1334→ */
  1335→async function sessionLogListAction(
  1336→  options: SessionLogListOptions,
  1337→): Promise<void> {
  1338→  try {
  1339→    const ctx = await initContext();
  1340→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1341→
  1342→    // AC: @session-log-list ac-2 - Filter by status
  1343→    if (options.status) {
  1344→      const statusFilter = options.status as SessionStatus;
  1345→      sessions = sessions.filter((s) => s.status === statusFilter);
  1346→    }
  1347→
  1348→    // AC: @session-log-list ac-4 - Filter by agent type
  1349→    if (options.agent) {
  1350→      const agentFilter = options.agent;
  1351→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1352→    }
  1353→
  1354→    // AC: @session-log-list ac-3 - Filter by since date
  1355→    if (options.since) {
  1356→      const sinceDate = parseTimeSpec(options.since);
  1357→      if (sinceDate) {
  1358→        sessions = sessions.filter(
  1359→          (s) => new Date(s.started_at) >= sinceDate,
  1360→        );
  1361→      }
  1362→    }
  1363→
  1364→    // AC: @session-log-list ac-5 - Sort
  1365→    const sortField: SortField =
  1366→      options.sort && VALID_SORT_FIELDS.includes(options.sort as SortField)
  1367→        ? (options.sort as SortField)
  1368→        : "started_at";
  1369→    sessions = sortSessions(sessions, sortField);
  1370→
  1371→    // AC: @session-log-list ac-7 - Limit output count
  1372→    if (options.count) {
  1373→      // AC: @trait-filterable-list ac-8
  1374→      output({ count: sessions.length }, () => {
  1375→        console.log(sessions.length);
  1376→      });
  1377→      return;
  1378→    }
  1379→
  1380→    // Apply --limit (after filtering/sorting, before display)
  1381→    if (options.limit) {
  1382→      const limit = parseInt(options.limit, 10);
  1383→      if (!Number.isNaN(limit) && limit > 0) {
  1384→        sessions = sessions.slice(0, limit);
  1385→      }
  1386→    }
  1387→
  1388→    output(sessions, () => formatSessionLogList(sessions));
  1389→  } catch (err) {
  1390→    error("Failed to list session logs", err);
  1391→    process.exit(EXIT_CODES.ERROR);
  1392→  }
  1393→}
  1394→
  1395→// ─── Session Log Show ─────────────────────────────────────────────────────────
  1396→
  1397→interface SessionLogShowOptions {
  1398→  events?: boolean;
  1399→  type?: string;
  1400→  limit?: string;
  1401→  context?: string;
  1402→}
  1403→
  1404→/**
  1405→ * Format an event timestamp as relative time from session start.
  1406→ */
  1407→function formatEventTimestamp(
  1408→  eventTs: number,
  1409→  sessionStartTs: number,
  1410→): string {
  1411→  const relativeMs = eventTs - sessionStartTs;
  1412→  const totalSec = Math.floor(relativeMs / 1000);
  1413→  const minutes = Math.floor(totalSec / 60);
  1414→  const seconds = totalSec % 60;
  1415→  if (minutes > 0) {
  1416→    return `+${minutes}m${seconds}s`;
  1417→  }
  1418→  return `+${seconds}s`;
  1419→}
  1420→
  1421→/**
  1422→ * Summarize event data for display.
  1423→ * Returns a short string describing the event payload.
  1424→ */
  1425→function summarizeEventData(event: SessionEvent): string {
  1426→  const data = event.data as Record<string, unknown> | null;
  1427→  if (!data) return "";
  1428→
  1429→  // Handle tool_call events
  1430→  if (event.type === "session.update") {
  1431→    const update = data.update as {
  1432→      sessionUpdate?: string;
  1433→      rawInput?: { command?: string };
  1434→      _meta?: { claudeCode?: { toolName?: string } };
  1435→    } | null;
  1436→    if (update?.sessionUpdate === "tool_call") {
  1437→      const toolName = update._meta?.claudeCode?.toolName || "unknown";
  1438→      const command = update.rawInput?.command;
  1439→      if (command) {
  1440→        const truncated =
  1441→          command.length > 60 ? command.slice(0, 57) + "..." : command;
  1442→        return `${toolName}: ${truncated}`;
  1443→      }
  1444→      return toolName;
  1445→    }
  1446→  }
  1447→
  1448→  // Handle prompt.sent events
  1449→  if (event.type === "prompt.sent") {
  1450→    const prompt = data.prompt as string | null;
  1451→    if (prompt) {
  1452→      const truncated =
  1453→        prompt.length > 60 ? prompt.slice(0, 57) + "..." : prompt;
  1454→      return truncated;
  1455→    }
  1456→  }
  1457→
  1458→  // Handle session.start/end
  1459→  if (event.type === "session.start") {
  1460→    return "Session started";
  1461→  }
  1462→  if (event.type === "session.end") {
  1463→    const reason = data.reason as string | null;
  1464→    return reason ? `Session ended: ${reason}` : "Session ended";
  1465→  }
  1466→
  1467→  // Default: show first key
  1468→  const keys = Object.keys(data);
  1469→  if (keys.length > 0) {
  1470→    return `{${keys.slice(0, 3).join(", ")}${keys.length > 3 ? ", ..." : ""}}`;
  1471→  }
  1472→  return "";
  1473→}
  1474→
  1475→/**
  1476→ * Format the session log show output.
  1477→ *
  1478→ * AC: @session-log-show ac-1
  1479→ */
  1480→function formatSessionLogShow(
  1481→  detail: SessionLogDetail,
  1482→  events: SessionEvent[] | null,
  1483→  contextSnapshot: unknown | null,
  1484→  sessionStartTs: number,
  1485→): void {
  1486→  // AC: @session-log-show ac-1 - Session metadata
  1487→  console.log(chalk.bold(`Session ${detail.id.slice(0, 8)}`));
  1488→  console.log(chalk.gray("─".repeat(60)));
  1489→  console.log(`  ID:        ${detail.id}`);
  1490→
  1491→  const statusColor =
  1492→    detail.status === "completed"
  1493→      ? chalk.green
  1494→      : detail.status === "active"
  1495→        ? chalk.blue
  1496→        : chalk.yellow;
  1497→  console.log(`  Status:    ${statusColor(detail.status)}`);
  1498→  console.log(`  Agent:     ${detail.agent_type}`);
  1499→  if (detail.task_id) {
  1500→    console.log(`  Task:      ${detail.task_id}`);
  1501→  }
  1502→  console.log(`  Started:   ${detail.started_at}`);
  1503→  if (detail.ended_at) {
  1504→    console.log(`  Ended:     ${detail.ended_at}`);
  1505→  }
  1506→  console.log(`  Duration:  ${formatDuration(detail.duration_ms)}`);
  1507→  console.log(`  Events:    ${detail.event_count}`);
  1508→  console.log(`  Iterations: ${detail.iteration_count}`);
  1509→
  1510→  // AC: @session-log-show ac-2 - Per-iteration summary
  1511→  if (detail.iterations.length > 0) {
  1512→    console.log("\n" + chalk.bold("Iterations"));
  1513→    console.log(chalk.gray("─".repeat(60)));
  1514→    for (const iter of detail.iterations) {
  1515→      const taskInfo: string[] = [];
  1516→      if (iter.tasks_started.length > 0) {
  1517→        taskInfo.push(`started: ${iter.tasks_started.join(", ")}`);
  1518→      }
  1519→      if (iter.tasks_completed.length > 0) {
  1520→        taskInfo.push(`completed: ${iter.tasks_completed.join(", ")}`);
  1521→      }
  1522→      const taskStr = taskInfo.length > 0 ? ` | ${taskInfo.join(" | ")}` : "";
  1523→      console.log(
  1524→        `  ${chalk.cyan(`[${iter.iteration}]`)} ${iter.event_count} events${taskStr}`,
  1525→      );
  1526→    }
  1527→  }
  1528→
  1529→  // AC: @session-log-show ac-3 - Event timeline
  1530→  if (events !== null) {
  1531→    console.log("\n" + chalk.bold("Events"));
  1532→    console.log(chalk.gray("─".repeat(60)));
  1533→    if (events.length === 0) {
  1534→      console.log(chalk.gray("  No events to display."));
  1535→    } else {
  1536→      for (const event of events) {
  1537→        const timestamp = formatEventTimestamp(event.ts, sessionStartTs);
  1538→        const summary = summarizeEventData(event);
  1539→        const typeColor =
  1540→          event.type === "session.start" || event.type === "session.end"
  1541→            ? chalk.green
  1542→            : event.type === "session.update"
  1543→              ? chalk.blue
  1544→              : chalk.gray;
  1545→        console.log(
  1546→          `  ${chalk.yellow(timestamp.padEnd(10))} ${typeColor(event.type.padEnd(16))} ${chalk.gray(summary)}`,
  1547→        );
  1548→      }
  1549→    }
  1550→  }
  1551→
  1552→  // AC: @session-log-show ac-6 - Context snapshot
  1553→  if (contextSnapshot !== null) {
  1554→    console.log("\n" + chalk.bold("Context Snapshot"));
  1555→    console.log(chalk.gray("─".repeat(60)));
  1556→    console.log(JSON.stringify(contextSnapshot, null, 2));
  1557→  }
  1558→}
  1559→
  1560→/**
  1561→ * Session log show action handler.
  1562→ */
  1563→async function sessionLogShowAction(
  1564→  sessionRef: string,
  1565→  options: SessionLogShowOptions,
  1566→): Promise<void> {
  1567→  try {
  1568→    const ctx = await initContext();
  1569→
  1570→    // AC: @session-log-show ac-7, ac-8, ac-9 - Resolve session ID
  1571→    const resolution = await resolveSessionId(ctx.specDir, sessionRef);
  1572→
  1573→    if (!resolution.ok) {
  1574→      if (resolution.error === "not_found") {
  1575→        // AC: @session-log-show ac-9
  1576→        error(`Session not found: ${sessionRef}`);
  1577→        process.exit(EXIT_CODES.NOT_FOUND);
  1578→      } else {
  1579→        // AC: @session-log-show ac-8
  1580→        error(
  1581→          `Ambiguous session ID prefix. Matches:\n  ${resolution.matches.join("\n  ")}\nPlease provide a more specific prefix.`,
  1582→        );
  1583→        process.exit(EXIT_CODES.VALIDATION_FAILED);
  1584→      }
  1585→    }
  1586→
  1587→    const sessionId = resolution.id;
  1588→
  1589→    // Get session detail
  1590→    const detail = await getSessionLogDetail(ctx.specDir, sessionId);
  1591→    if (!detail) {
  1592→      error(`Session not found: ${sessionId}`);
  1593→      process.exit(EXIT_CODES.NOT_FOUND);
  1594→    }
  1595→
  1596→    // AC: @session-log-show ac-3, ac-4, ac-5 - Event timeline
  1597→    let events: SessionEvent[] | null = null;
  1598→    if (options.events) {
  1599→      let allEvents = await readEvents(ctx.specDir, sessionId);
  1600→
  1601→      // AC: @session-log-show ac-4 - Filter by type
  1602→      if (options.type) {
  1603→        const typeFilter = options.type;
  1604→        allEvents = allEvents.filter((e) => e.type === typeFilter);
  1605→      }
  1606→
  1607→      // AC: @session-log-show ac-5 - Limit to last N events
  1608→      if (options.limit) {
  1609→        const limit = parseInt(options.limit, 10);
  1610→        if (!Number.isNaN(limit) && limit > 0) {
  1611→          allEvents = allEvents.slice(-limit);
  1612→        }
  1613→      }
  1614→
  1615→      events = allEvents;
  1616→    }
  1617→
  1618→    // AC: @session-log-show ac-6 - Context snapshot
  1619→    let contextSnapshot: unknown | null = null;
  1620→    if (options.context) {
  1621→      const iterNum = parseInt(options.context, 10);
  1622→      if (!Number.isNaN(iterNum) && iterNum > 0) {
  1623→        contextSnapshot = await readSessionContext(
  1624→          ctx.specDir,
  1625→          sessionId,
  1626→          iterNum,
  1627→        );
  1628→        if (contextSnapshot === null) {
  1629→          error(`No context snapshot found for iteration ${iterNum}`);
  1630→          process.exit(EXIT_CODES.NOT_FOUND);
  1631→        }
  1632→      } else {
  1633→        error(`Invalid iteration number: ${options.context}`);
  1634→        process.exit(EXIT_CODES.USAGE_ERROR);
  1635→      }
  1636→    }
  1637→
  1638→    const sessionStartTs = new Date(detail.started_at).getTime();
  1639→
  1640→    // Build JSON output structure
  1641→    const jsonOutput = {
  1642→      ...detail,
  1643→      ...(events !== null ? { events } : {}),
  1644→      ...(contextSnapshot !== null ? { context: contextSnapshot } : {}),
  1645→    };
  1646→
  1647→    output(jsonOutput, () =>
  1648→      formatSessionLogShow(detail, events, contextSnapshot, sessionStartTs),
  1649→    );
  1650→  } catch (err) {
  1651→    error("Failed to show session log", err);
  1652→    process.exit(EXIT_CODES.ERROR);
  1653→  }
  1654→}
  1655→
  1656→// ─── Session Log Stats ─────────────────────────────────────────────────────────
  1657→
  1658→interface SessionLogStatsOptions {
  1659→  since?: string;
  1660→  agent?: string;
  1661→  toolUsage?: boolean;
  1662→  byDay?: boolean;
  1663→  byWeek?: boolean;
  1664→}
  1665→
  1666→/**
  1667→ * Full stats output including optional tool usage and time period data.
  1668→ */
  1669→interface SessionLogStatsOutput {
  1670→  stats: SessionLogStats;
  1671→  tool_usage?: ToolUsageStats[];
  1672→  time_periods?: TimePeriodStats[];
  1673→}
  1674→
  1675→/**
  1676→ * Format a duration in milliseconds to human-readable format.
  1677→ * Reuses formatDuration from session log list but handles hours/minutes/seconds.
  1678→ */
  1679→function formatDurationLong(ms: number): string {
  1680→  if (ms < 0) return "—";
  1681→  const totalSec = Math.floor(ms / 1000);
  1682→  const hours = Math.floor(totalSec / 3600);
  1683→  const minutes = Math.floor((totalSec % 3600) / 60);
  1684→  const seconds = totalSec % 60;
  1685→  if (hours > 0 && minutes > 0) {
  1686→    return `${hours}h ${minutes}m`;
  1687→  }
  1688→  if (hours > 0) {
  1689→    return `${hours}h`;
  1690→  }
  1691→  if (minutes > 0) {
  1692→    return `${minutes}m ${seconds}s`;
  1693→  }
  1694→  return `${seconds}s`;
  1695→}
  1696→
  1697→/**
  1698→ * Format the session log stats output.
  1699→ *
  1700→ * AC: @session-log-stats ac-1, ac-2, ac-3
  1701→ */
  1702→function formatSessionLogStats(
  1703→  stats: SessionLogStats,
  1704→  toolUsage: ToolUsageStats[] | null,
  1705→  timePeriods: TimePeriodStats[] | null,
  1706→  groupBy: "day" | "week" | null,
  1707→): void {
  1708→  // AC: @session-log-stats ac-1 - Totals
  1709→  console.log(chalk.bold("Session Statistics"));
  1710→  console.log(chalk.gray("─".repeat(50)));
  1711→  console.log(`  Total Sessions:     ${stats.total_sessions}`);
  1712→  console.log(`  Total Events:       ${stats.total_events}`);
  1713→  console.log(`  Total Iterations:   ${stats.total_iterations}`);
  1714→  console.log(`  Tasks Completed:    ${stats.total_tasks_completed}`);
  1715→  console.log(`  Total Duration:     ${formatDurationLong(stats.total_duration_ms)}`);
  1716→
  1717→  // AC: @session-log-stats ac-2 - Averages
  1718→  console.log("\n" + chalk.bold("Averages"));
  1719→  console.log(chalk.gray("─".repeat(50)));
  1720→  console.log(`  Avg Duration/Session:     ${formatDurationLong(stats.avg_duration_ms)}`);
  1721→  console.log(`  Avg Iterations/Session:   ${stats.avg_iterations_per_session}`);
  1722→  console.log(`  Avg Tasks/Session:        ${stats.avg_tasks_per_session}`);
  1723→
  1724→  // AC: @session-log-stats ac-3 - Status breakdown
  1725→  if (stats.status_breakdown.length > 0) {
  1726→    console.log("\n" + chalk.bold("Status Breakdown"));
  1727→    console.log(chalk.gray("─".repeat(50)));
  1728→    for (const item of stats.status_breakdown) {
  1729→      const statusColor =
  1730→        item.status === "completed"
  1731→          ? chalk.green
  1732→          : item.status === "active"
  1733→            ? chalk.blue
  1734→            : chalk.yellow;
  1735→      console.log(
  1736→        `  ${statusColor(item.status.padEnd(12))} ${String(item.count).padEnd(6)} ${item.percentage}%`,
  1737→      );
  1738→    }
  1739→  }
  1740→
  1741→  // AC: @session-log-stats ac-6 - Tool usage
  1742→  if (toolUsage !== null && toolUsage.length > 0) {
  1743→    console.log("\n" + chalk.bold("Top Tool Usage"));
  1744→    console.log(chalk.gray("─".repeat(50)));
  1745→    for (const tool of toolUsage) {
  1746→      console.log(
  1747→        `  ${tool.tool_name.padEnd(20)} ${String(tool.count).padEnd(8)} ${tool.percentage}%`,
  1748→      );
  1749→    }
  1750→  }
  1751→
  1752→  // AC: @session-log-stats ac-7 - Time periods
  1753→  if (timePeriods !== null && timePeriods.length > 0) {
  1754→    const label = groupBy === "week" ? "By Week" : "By Day";
  1755→    console.log("\n" + chalk.bold(label));
  1756→    console.log(chalk.gray("─".repeat(50)));
  1757→    console.log(
  1758→      chalk.gray(
  1759→        `  ${"Period".padEnd(14)} ${"Sessions".padEnd(10)} ${"Tasks".padEnd(8)} Duration`,
  1760→      ),
  1761→    );
  1762→    for (const period of timePeriods) {
  1763→      console.log(
  1764→        `  ${period.period.padEnd(14)} ${String(period.sessions_count).padEnd(10)} ${String(period.tasks_completed).padEnd(8)} ${formatDurationLong(period.total_duration_ms)}`,
  1765→      );
  1766→    }
  1767→  }
  1768→}
  1769→
  1770→/**
  1771→ * Session log stats action handler.
  1772→ */
  1773→async function sessionLogStatsAction(
  1774→  options: SessionLogStatsOptions,
  1775→): Promise<void> {
  1776→  try {
  1777→    const ctx = await initContext();
  1778→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1779→
  1780→    // AC: @session-log-stats ac-4 - Filter by since
  1781→    if (options.since) {
  1782→      const sinceDate = parseTimeSpec(options.since);
  1783→      if (sinceDate) {
  1784→        sessions = sessions.filter(
  1785→          (s) => new Date(s.started_at) >= sinceDate,
  1786→        );
  1787→      }
  1788→    }
  1789→
  1790→    // AC: @session-log-stats ac-5 - Filter by agent type
  1791→    if (options.agent) {
  1792→      const agentFilter = options.agent;
  1793→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1794→    }
  1795→
  1796→    // AC: @session-log-stats ac-8 - No sessions match criteria
  1797→    if (sessions.length === 0) {
  1798→      output({ message: "No sessions match criteria" }, () => {
  1799→        console.log("No sessions match criteria.");
  1800→      });
  1801→      return;
  1802→    }
  1803→
  1804→    // Compute base stats
  1805→    const stats = computeSessionLogStats(sessions);
  1806→
  1807→    // AC: @session-log-stats ac-6 - Tool usage (optional)
  1808→    let toolUsage: ToolUsageStats[] | null = null;
  1809→    if (options.toolUsage) {
  1810→      const sessionIds = sessions.map((s) => s.id);
  1811→      toolUsage = await computeToolUsageStats(ctx.specDir, sessionIds);
  1812→    }
  1813→
  1814→    // AC: @session-log-stats ac-7 - Time periods (optional)
  1815→    let timePeriods: TimePeriodStats[] | null = null;
  1816→    let groupBy: "day" | "week" | null = null;
  1817→    if (options.byDay) {
  1818→      groupBy = "day";
  1819→      timePeriods = computeTimePeriodStats(sessions, "day");
  1820→    } else if (options.byWeek) {
  1821→      groupBy = "week";
  1822→      timePeriods = computeTimePeriodStats(sessions, "week");
  1823→    }
  1824→
  1825→    // Build output structure
  1826→    const jsonOutput: SessionLogStatsOutput = { stats };
  1827→    if (toolUsage !== null) {
  1828→      jsonOutput.tool_usage = toolUsage;
  1829→    }
  1830→    if (timePeriods !== null) {
  1831→      jsonOutput.time_periods = timePeriods;
  1832→    }
  1833→
  1834→    output(jsonOutput, () =>
  1835→      formatSessionLogStats(stats, toolUsage, timePeriods, groupBy),
  1836→    );
  1837→  } catch (err) {
  1838→    error("Failed to compute session log stats", err);
  1839→    process.exit(EXIT_CODES.ERROR);
  1840→  }
  1841→}
  1842→
  1843→/**
  1844→ * Register the 'session' command group and aliases
  1845→ */
  1846→export function registerSessionCommands(program: Command): void {
  1847→  const session = program
  1848→    .command("session")
  1849→    .description("Session management and context");
  1850→
  1851→  session
  1852→    .command("start")
  1853→    .alias("resume")
  1854→    .description("Surface relevant context for starting a new working session")
  1855→    .option("--brief", "Compact summary (default)")
  1856→    .option("--full", "Comprehensive context dump")
  1857→    .option(
  1858→      "--since <time>",
  1859→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  1860→    )
  1861→    .option("--no-git", "Skip git commit information")
  1862→    .option("-n, --limit <n>", "Limit items per section", "10")
  1863→    .action(sessionStartAction);
  1864→
  1865→  // Session log subcommand group
  1866→  const log = session
  1867→    .command("log")
  1868→    .description("Session log analysis commands");
  1869→
  1870→  log
  1871→    .command("list")
  1872→    .description("List session logs with summary statistics")
  1873→    .option(
  1874→      "-s, --status <status>",
  1875→      "Filter by status (active, completed, abandoned)",
  1876→    )
  1877→    .option("--agent <type>", "Filter by agent type")
  1878→    .option(
  1879→      "--since <time>",
  1880→      "Only show sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  1881→    )
  1882→    .option(
  1883→      "--sort <field>",
  1884→      "Sort by field (started_at, duration, events, iterations, tasks_completed)",
  1885→      "started_at",
  1886→    )
  1887→    .option("--count", "Show only the count of matching sessions")
  1888→    .option("-n, --limit <n>", "Limit number of sessions shown")
  1889→    .action(sessionLogListAction);
  1890→
  1891→  log
  1892→    .command("show <session-id>")
  1893→    .description("Show detailed view of a single session")
  1894→    .option("-e, --events", "Include chronological event timeline")
  1895→    .option("-t, --type <type>", "Filter events by type (e.g., tool.call)")
  1896→    .option("-n, --limit <n>", "Show only the last N events")
  1897→    .option("-c, --context <n>", "Show context snapshot for iteration N")
  1898→    .action(sessionLogShowAction);
  1899→
  1900→  log
  1901→    .command("stats")
  1902→    .description("Aggregate analytics across sessions")
  1903→    .option(
  1904→      "--since <time>",
  1905→      "Only include sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  1906→    )
  1907→    .option("--agent <type>", "Only include sessions with this agent type")
  1908→    .option("--tool-usage", "Display top 10 tool calls by frequency")
  1909→    .option("--by-day", "Group stats by day")
  1910→    .option("--by-week", "Group stats by week")
  1911→    .action(sessionLogStatsAction);
  1912→
  1913→  session
  1914→    .command("checkpoint")
  1915→    .description(
  1916→      "Pre-stop hook: check for uncommitted work before ending session",
  1917→    )
  1918→    .option("--force", "Allow session end regardless of issues")
  1919→    .action(sessionCheckpointAction);
  1920→
  1921→  session
  1922→    .command("prompt-check")
  1923→    .description("UserPromptSubmit hook: inject spec-first reminder")
  1924→    .action(sessionPromptCheckAction);
  1925→
  1926→  // Top-level alias: kspec context
  1927→  program
  1928→    .command("context")
  1929→    .description("Alias for session start - surface session context")
  1930→    .option("--brief", "Compact summary (default)")
  1931→    .option("--full", "Comprehensive context dump")
  1932→    .option(
  1933→      "--since <time>",
  1934→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  1935→    )
  1936→    .option("--no-git", "Skip git commit information")
  1937→    .option("-n, --limit <n>", "Limit items per section", "10")
  1938→    .action(sessionStartAction);
  1939→}
