```
     1→/**
     2→ * Ralph Event System
     3→ *
     4→ * Translates ACP SessionUpdate events into structured RalphEvents.
     5→ * This layer is pure data - no rendering concerns. Enables future
     6→ * TUI or other renderers to consume the same event stream.
     7→ */
     8→
     9→import type { SessionUpdate } from "../acp/types.js";
    10→
    11→// ============================================================================
    12→// Event Types
    13→// ============================================================================
    14→
    15→export type RalphEventType =
    16→  | "agent_message"
    17→  | "agent_thought"
    18→  | "tool_start"
    19→  | "tool_update"
    20→  | "tool_result"
    21→  | "status";
    22→
    23→export interface RalphEvent {
    24→  type: RalphEventType;
    25→  timestamp: number; // ms since session start
    26→  data: RalphEventData;
    27→}
    28→
    29→export type RalphEventData =
    30→  | AgentMessageData
    31→  | AgentThoughtData
    32→  | ToolStartData
    33→  | ToolUpdateData
    34→  | ToolResultData
    35→  | StatusData;
    36→
    37→export interface AgentMessageData {
    38→  kind: "agent_message";
    39→  content: string;
    40→  isStreaming: boolean;
    41→}
    42→
    43→export interface AgentThoughtData {
    44→  kind: "agent_thought";
    45→  content: string;
    46→  isStreaming: boolean;
    47→}
    48→
    49→export interface ToolStartData {
    50→  kind: "tool_start";
    51→  toolCallId: string;
    52→  tool: string;
    53→  summary: string;
    54→  input: unknown;
    55→}
    56→
    57→export interface ToolUpdateData {
    58→  kind: "tool_update";
    59→  toolCallId: string;
    60→  tool: string;
    61→  status: "pending" | "running";
    62→  summary?: string; // Present when input becomes available in phased events
    63→}
    64→
    65→export interface ToolResultData {
    66→  kind: "tool_result";
    67→  toolCallId: string;
    68→  tool: string;
    69→  status: "completed" | "failed" | "cancelled";
    70→  output?: string;
    71→  truncated: boolean;
    72→}
    73→
    74→export interface StatusData {
    75→  kind: "status";
    76→  status: string;
    77→  message?: string;
    78→}
    79→
    80→// ============================================================================
    81→// Translator Interface
    82→// ============================================================================
    83→
    84→export interface RalphTranslator {
    85→  /**
    86→   * Translate an ACP SessionUpdate to a RalphEvent.
    87→   * Returns null if the update should be suppressed.
    88→   */
    89→  translate(update: SessionUpdate): RalphEvent | null;
    90→
    91→  /**
    92→   * Signal end of stream. Returns final event if there's pending state.
    93→   */
    94→  finalize(): RalphEvent | null;
    95→}
    96→
    97→// ============================================================================
    98→// Tool Summary Extraction
    99→// ============================================================================
   100→
   101→/**
   102→ * Extract a human-readable summary for a tool call.
   103→ * Based on kynetic ui-event-translator.ts patterns.
   104→ */
   105→function getToolSummary(tool: string, input: unknown): string {
   106→  const inp = input as Record<string, unknown>;
   107→
   108→  switch (tool) {
   109→    case "Bash": {
   110→      const cmd = inp.command as string | undefined;
   111→      if (cmd) {
   112→        return cmd.length > 50 ? `${cmd.slice(0, 47)}...` : cmd;
   113→      }
   114→      return "";
   115→    }
   116→
   117→    case "Read":
   118→    case "Write":
   119→    case "Edit": {
   120→      const filePath = inp.file_path as string | undefined;
   121→      if (filePath) {
   122→        // Extract filename from path
   123→        const parts = filePath.split("/");
   124→        return parts[parts.length - 1] || filePath;
   125→      }
   126→      return "";
   127→    }
   128→
   129→    case "Grep": {
   130→      const pattern = inp.pattern as string | undefined;
   131→      return pattern ? `/${pattern}/` : "";
   132→    }
   133→
   134→    case "Glob": {
   135→      const pattern = inp.pattern as string | undefined;
   136→      return pattern || "";
   137→    }
   138→
   139→    case "WebSearch": {
   140→      const query = inp.query as string | undefined;
   141→      return query || "";
   142→    }
   143→
   144→    case "Task": {
   145→      const desc = inp.description as string | undefined;
   146→      return desc || "";
   147→    }
   148→
   149→    case "TodoWrite": {
   150→      const todos = inp.todos as Array<{ content: string }> | undefined;
   151→      if (todos && todos.length > 0) {
   152→        return `${todos.length} item(s)`;
   153→      }
   154→      return "";
   155→    }
   156→
   157→    default:
   158→      return "";
   159→  }
   160→}
   161→
   162→/**
   163→ * Extract tool name from SessionUpdate.
   164→ * Handles Claude Code's _meta.claudeCode.toolName pattern and MCP prefixes.
   165→ */
   166→function extractToolName(update: Record<string, unknown>): string {
   167→  // Try _meta.claudeCode.toolName first (Claude Code pattern)
   168→  const meta = update._meta as Record<string, unknown> | undefined;
   169→  if (meta) {
   170→    const claudeCode = meta.claudeCode as Record<string, unknown> | undefined;
   171→    if (claudeCode?.toolName) {
   172→      return normalizeTool(claudeCode.toolName as string);
   173→    }
   174→    if (meta.toolName) {
   175→      return normalizeTool(meta.toolName as string);
   176→    }
   177→  }
   178→
   179→  // Fall back to name field
   180→  if (update.name) {
   181→    return normalizeTool(update.name as string);
   182→  }
   183→
   184→  // Fall back to title
   185→  if (update.title) {
   186→    return normalizeTool(update.title as string);
   187→  }
   188→
   189→  return "unknown";
   190→}
   191→
   192→/**
   193→ * Normalize tool name by stripping MCP prefixes.
   194→ */
   195→function normalizeTool(name: string): string {
   196→  // Strip mcp__<namespace>__ prefix
   197→  const mcpMatch = name.match(/^mcp__[^_]+__(.+)$/);
   198→  if (mcpMatch) {
   199→    return mcpMatch[1];
   200→  }
   201→  return name;
   202→}
   203→
   204→/**
   205→ * Extract tool output, handling Claude Code's non-standard delivery.
   206→ */
   207→function extractToolOutput(
   208→  update: Record<string, unknown>,
   209→): string | undefined {
   210→  // Try rawOutput first
   211→  if (update.rawOutput !== undefined) {
   212→    return truncateOutput(stringify(update.rawOutput));
   213→  }
   214→
   215→  // Try _meta.claudeCode.toolResponse (Claude Code pattern)
   216→  // toolResponse is an object with stdout/stderr, not a string
   217→  const meta = update._meta as Record<string, unknown> | undefined;
   218→  if (meta) {
   219→    const claudeCode = meta.claudeCode as Record<string, unknown> | undefined;
   220→    if (claudeCode?.toolResponse !== undefined) {
   221→      const toolResponse = claudeCode.toolResponse as Record<string, unknown>;
   222→      // Extract stdout, falling back to stringifying the whole response
   223→      if (typeof toolResponse.stdout === "string") {
   224→        const combined =
   225→          toolResponse.stdout +
   226→          (toolResponse.stderr ? `\n${toolResponse.stderr}` : "");
   227→        return truncateOutput(combined.trim());
   228→      }
   229→      return truncateOutput(stringify(toolResponse));
   230→    }
   231→  }
   232→
   233→  // Try output field
   234→  if (update.output !== undefined) {
   235→    return truncateOutput(stringify(update.output));
   236→  }
   237→
   238→  return undefined;
   239→}
   240→
   241→/**
   242→ * Extract original (non-truncated) output for truncation detection.
   243→ */
   244→function extractOriginalOutput(
   245→  update: Record<string, unknown>,
   246→): string | undefined {
   247→  if (update.rawOutput !== undefined) {
   248→    return stringify(update.rawOutput);
   249→  }
   250→
   251→  const meta = update._meta as Record<string, unknown> | undefined;
   252→  if (meta) {
   253→    const claudeCode = meta.claudeCode as Record<string, unknown> | undefined;
   254→    if (claudeCode?.toolResponse !== undefined) {
   255→      const toolResponse = claudeCode.toolResponse as Record<string, unknown>;
   256→      if (typeof toolResponse.stdout === "string") {
   257→        return (
   258→          toolResponse.stdout +
   259→          (toolResponse.stderr ? `\n${toolResponse.stderr}` : "")
   260→        ).trim();
   261→      }
   262→    }
   263→  }
   264→
   265→  if (update.output !== undefined) {
   266→    return stringify(update.output);
   267→  }
   268→
   269→  return undefined;
   270→}
   271→
   272→/**
   273→ * Safely stringify a value that may be a string, array of content blocks, or object.
   274→ * Handles ACP tool results delivered as arrays like [{type:'text',text:'...'},...]
   275→ */
   276→function stringify(value: unknown): string {
   277→  if (typeof value === "string") return value;
   278→  if (Array.isArray(value)) {
   279→    // Array of content blocks: extract .text fields
   280→    const texts = value
   281→      .map((item) =>
   282→        typeof item === "string"
   283→          ? item
   284→          : typeof item === "object" && item !== null && "text" in item
   285→            ? String((item as { text: unknown }).text)
   286→            : JSON.stringify(item),
   287→      )
   288→      .filter(Boolean);
   289→    return texts.join("\n");
   290→  }
   291→  if (typeof value === "object" && value !== null) {
   292→    return JSON.stringify(value);
   293→  }
   294→  return String(value);
   295→}
   296→
   297→/**
   298→ * Truncate output to reasonable size.
   299→ */
   300→function truncateOutput(output: string): string {
   301→  const MAX_LINES = 20;
   302→  const MAX_CHARS = 1000;
   303→
   304→  const lines = output.split("\n");
   305→  if (lines.length > MAX_LINES) {
   306→    return lines.slice(0, MAX_LINES).join("\n");
   307→  }
   308→  if (output.length > MAX_CHARS) {
   309→    return output.slice(0, MAX_CHARS);
   310→  }
   311→  return output;
   312→}
   313→
   314→/**
   315→ * Check if output was truncated.
   316→ */
   317→function wasOutputTruncated(
   318→  original: string | undefined,
   319→  truncated: string | undefined,
   320→): boolean {
   321→  if (!original || !truncated) return false;
   322→  return original.length > truncated.length;
   323→}
   324→
   325→// ============================================================================
   326→// Noise Suppression
   327→// ============================================================================
   328→
   329→const SUPPRESSED_PATTERNS = [
   330→  /No onPostToolUseHook found/i,
   331→  /No onPreToolUseHook found/i,
   332→];
   333→
   334→/**
   335→ * Check if a message should be suppressed from display.
   336→ */
   337→function shouldSuppress(content: string): boolean {
   338→  return SUPPRESSED_PATTERNS.some((pattern) => pattern.test(content));
   339→}
   340→
   341→// ============================================================================
   342→// Translator Implementation
   343→// ============================================================================
   344→
   345→interface TranslatorState {
   346→  sessionStart: number;
   347→  activeMessage: {
   348→    type: "agent_message" | "agent_thought";
   349→    content: string;
   350→  } | null;
   351→  pendingTools: Map<
   352→    string,
   353→    { tool: string; input: unknown; startTime: number }
   354→  >;
   355→}
   356→
   357→export function createTranslator(): RalphTranslator {
   358→  const state: TranslatorState = {
   359→    sessionStart: Date.now(),
   360→    activeMessage: null,
   361→    pendingTools: new Map(),
   362→  };
   363→
   364→  function getTimestamp(): number {
   365→    return Date.now() - state.sessionStart;
   366→  }
   367→
   368→  function translate(update: SessionUpdate): RalphEvent | null {
   369→    const updateType = update.sessionUpdate;
   370→    const timestamp = getTimestamp();
   371→
   372→    switch (updateType) {
   373→      // ─── Content Chunks ─────────────────────────────────────────────────────
   374→      case "agent_message_chunk": {
   375→        const content = (
   376→          update as { content?: { type: string; text?: string } }
   377→        ).content;
   378→        if (content?.type === "text" && typeof content.text === "string") {
   379→          // Check for noise
   380→          if (shouldSuppress(content.text)) {
   381→            return null;
   382→          }
   383→
   384→          // Empty string signals finalization
   385→          if (content.text === "") {
   386→            if (state.activeMessage?.type === "agent_message") {
   387→              const final: RalphEvent = {
   388→                type: "agent_message",
   389→                timestamp,
   390→                data: {
   391→                  kind: "agent_message",
   392→                  content: state.activeMessage.content,
   393→                  isStreaming: false,
   394→                },
   395→              };
   396→              state.activeMessage = null;
   397→              return final;
   398→            }
   399→            return null;
   400→          }
   401→
   402→          // Accumulate content
   403→          if (state.activeMessage?.type === "agent_message") {
   404→            state.activeMessage.content += content.text;
   405→          } else {
   406→            state.activeMessage = {
   407→              type: "agent_message",
   408→              content: content.text,
   409→            };
   410→          }
   411→
   412→          return {
   413→            type: "agent_message",
   414→            timestamp,
   415→            data: {
   416→              kind: "agent_message",
   417→              content: content.text,
   418→              isStreaming: true,
   419→            },
   420→          };
   421→        }
   422→        return null;
   423→      }
   424→
   425→      case "agent_thought_chunk": {
   426→        const content = (
   427→          update as { content?: { type: string; text?: string } }
   428→        ).content;
   429→        if (content?.type === "text" && typeof content.text === "string") {
   430→          if (shouldSuppress(content.text)) {
   431→            return null;
   432→          }
   433→
   434→          if (content.text === "") {
   435→            if (state.activeMessage?.type === "agent_thought") {
   436→              const final: RalphEvent = {
   437→                type: "agent_thought",
   438→                timestamp,
   439→                data: {
   440→                  kind: "agent_thought",
   441→                  content: state.activeMessage.content,
   442→                  isStreaming: false,
   443→                },
   444→              };
   445→              state.activeMessage = null;
   446→              return final;
   447→            }
   448→            return null;
   449→          }
   450→
   451→          if (state.activeMessage?.type === "agent_thought") {
   452→            state.activeMessage.content += content.text;
   453→          } else {
   454→            state.activeMessage = {
   455→              type: "agent_thought",
   456→              content: content.text,
   457→            };
   458→          }
   459→
   460→          return {
   461→            type: "agent_thought",
   462→            timestamp,
   463→            data: {
   464→              kind: "agent_thought",
   465→              content: content.text,
   466→              isStreaming: true,
   467→            },
   468→          };
   469→        }
   470→        return null;
   471→      }
   472→
   473→      case "user_message_chunk": {
   474→        // User messages are typically the prompt we sent, skip display
   475→        return null;
   476→      }
   477→
   478→      // ─── Tool Events ────────────────────────────────────────────────────────
   479→      case "tool_call": {
   480→        const u = update as Record<string, unknown>;
   481→        const toolCallId = (u.tool_call_id || u.toolCallId || u.id) as string;
   482→        const tool = extractToolName(u);
   483→        const input = u.rawInput || u.input || u.params || {};
   484→        const summary = getToolSummary(tool, input);
   485→
   486→        // Check if this is an update to an existing tool call (phased events)
   487→        const existing = state.pendingTools.get(toolCallId);
   488→        if (existing) {
   489→          // Update existing entry with new input if present
   490→          const hadSummary = getToolSummary(existing.tool, existing.input);
   491→          existing.input = input;
   492→          existing.tool = tool;
   493→
   494→          // Only emit update if we now have a summary we didn't have before
   495→          if (summary && !hadSummary) {
   496→            return {
   497→              type: "tool_update",
   498→              timestamp,
   499→              data: {
   500→                kind: "tool_update",
   501→                toolCallId,
   502→                tool,
   503→                status: "pending" as const,
   504→                summary,
   505→              },
   506→            };
   507→          }
   508→          // No meaningful change, suppress event
   509→          return null;
   510→        }
   511→
   512→        // First time seeing this tool_call_id - create entry and emit tool_start
   513→        state.pendingTools.set(toolCallId, {
   514→          tool,
   515→          input,
   516→          startTime: timestamp,
   517→        });
   518→
   519→        return {
   520→          type: "tool_start",
   521→          timestamp,
   522→          data: {
   523→            kind: "tool_start",
   524→            toolCallId,
   525→            tool,
   526→            summary,
   527→            input,
   528→          },
   529→        };
   530→      }
   531→
   532→      case "tool_call_update": {
   533→        const u = update as Record<string, unknown>;
   534→        const toolCallId = (u.tool_call_id || u.toolCallId || u.id) as string;
   535→        const status = u.status as string | undefined;
   536→        const pending = state.pendingTools.get(toolCallId);
   537→        const tool = pending?.tool || extractToolName(u);
   538→
   539→        // Non-terminal status update
   540→        if (
   541→          status === "pending" ||
   542→          status === "in_progress" ||
   543→          status === "running"
   544→        ) {
   545→          return {
   546→            type: "tool_update",
   547→            timestamp,
   548→            data: {
   549→              kind: "tool_update",
   550→              toolCallId,
   551→              tool,
   552→              status:
   553→                status === "in_progress"
   554→                  ? "running"
   555→                  : (status as "pending" | "running"),
   556→            },
   557→          };
   558→        }
   559→
   560→        // Terminal status - treat as result
   561→        if (
   562→          status === "completed" ||
   563→          status === "failed" ||
   564→          status === "cancelled"
   565→        ) {
   566→          const rawOutput = extractToolOutput(u);
   567→          const originalOutput = extractOriginalOutput(u);
   568→          state.pendingTools.delete(toolCallId);
   569→
   570→          return {
   571→            type: "tool_result",
   572→            timestamp,
   573→            data: {
   574→              kind: "tool_result",
   575→              toolCallId,
   576→              tool,
   577→              status,
   578→              output: rawOutput,
   579→              truncated: wasOutputTruncated(originalOutput, rawOutput),
   580→            },
   581→          };
   582→        }
   583→
   584→        return null;
   585→      }
   586→
   587→      // Note: 'status' is not a SessionUpdate type in the ACP spec.
   588→      // Status changes come through other mechanisms (e.g., prompt completion).
   589→
   590→      default:
   591→        // Unknown update type - ignore
   592→        return null;
   593→    }
   594→  }
   595→
   596→  function finalize(): RalphEvent | null {
   597→    if (state.activeMessage) {
   598→      const final: RalphEvent = {
   599→        type: state.activeMessage.type,
   600→        timestamp: getTimestamp(),
   601→        data: {
   602→          kind: state.activeMessage.type,
   603→          content: state.activeMessage.content,
   604→          isStreaming: false,
   605→        } as AgentMessageData | AgentThoughtData,
   606→      };
   607→      state.activeMessage = null;
   608→      return final;
   609→    }
   610→    return null;
   611→  }
   612→
   613→  return { translate, finalize };
   614→}
   615→

