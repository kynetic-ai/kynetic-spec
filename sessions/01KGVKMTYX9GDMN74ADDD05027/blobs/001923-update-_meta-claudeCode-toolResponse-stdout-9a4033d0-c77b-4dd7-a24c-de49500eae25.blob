ew-3766756966"},"pull_request":{"href":"https://api.github.com/repos/kynetic-ai/kynetic-spec/pulls/331"}},"submitted_at":"2026-02-07T09:07:18Z","commit_id":"2a4db5c1c51fadbe706fe4d9eb5ae58273e88f5d"}
