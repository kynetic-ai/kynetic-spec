     1→/**
     2→ * CLI Plan Commands Tests
     3→ * AC: @plan-crud ac-1, ac-2, ac-3, ac-4, ac-7, ac-8, ac-9, ac-30, ac-31
     4→ */
     5→
     6→import { describe, it, expect, beforeEach, afterEach } from "vitest";
     7→import * as fs from "node:fs/promises";
     8→import * as path from "node:path";
     9→import {
    10→  setupTempFixtures,
    11→  cleanupTempDir,
    12→  kspec as kspecRun,
    13→  kspecOutput as kspec,
    14→  kspecJson,
    15→} from "./helpers/cli";
    16→
    17→describe("Integration: plan commands", () => {
    18→  let tempDir: string;
    19→
    20→  beforeEach(async () => {
    21→    tempDir = await setupTempFixtures();
    22→  });
    23→
    24→  afterEach(async () => {
    25→    await cleanupTempDir(tempDir);
    26→  });
    27→
    28→  describe("plan add", () => {
    29→    // AC: @plan-crud ac-1
    30→    it("should create a plan with content", () => {
    31→      const output = kspec(
    32→        'plan add --title "User Auth Plan" --content "Implement JWT authentication"',
    33→        tempDir,
    34→      );
    35→      expect(output).toContain("Created plan:");
    36→      expect(output).toContain("User Auth Plan");
    37→
    38→      // Verify plan was saved
    39→      const plans = kspecJson<Array<{ title: string }>>(
    40→        "plan list --json",
    41→        tempDir,
    42→      );
    43→      expect(plans).toHaveLength(1);
    44→      expect(plans[0].title).toBe("User Auth Plan");
    45→    });
    46→
    47→    // AC: @plan-crud ac-2
    48→    it("should read content from file with --content-file", async () => {
    49→      const contentPath = path.join(tempDir, "test-plan.md");
    50→      await fs.writeFile(contentPath, "# Plan Content\n\nDetailed steps...");
    51→
    52→      const output = kspec(
    53→        `plan add --title "File Plan" --content-file "${contentPath}"`,
    54→        tempDir,
    55→      );
    56→      expect(output).toContain("Created plan:");
    57→
    58→      const plan = kspecJson<{ content: string }>(
    59→        "plan get @01 --json",
    60→        tempDir,
    61→      );
    62→      expect(plan.content).toContain("# Plan Content");
    63→      expect(plan.content).toContain("Detailed steps...");
    64→    });
    65→
    66→    // AC: @plan-crud ac-1 - default status is draft
    67→    it("should create plan with default draft status", () => {
    68→      kspec('plan add --title "Draft Plan" --content "Draft content"', tempDir);
    69→
    70→      const plan = kspecJson<{ status: string }>(
    71→        "plan get @01 --json",
    72→        tempDir,
    73→      );
    74→      expect(plan.status).toBe("draft");
    75→    });
    76→
    77→    it("should support custom status", () => {
    78→      kspec(
    79→        'plan add --title "Approved Plan" --content "Content" --status approved',
    80→        tempDir,
    81→      );
    82→
    83→      const plan = kspecJson<{ status: string }>(
    84→        "plan get @01 --json",
    85→        tempDir,
    86→      );
    87→      expect(plan.status).toBe("approved");
    88→    });
    89→
    90→    it("should support custom slug", () => {
    91→      const output = kspec(
    92→        'plan add --title "Slugged Plan" --content "Content" --slug my-plan',
    93→        tempDir,
    94→      );
    95→      expect(output).toContain("Created plan:");
    96→
    97→      // Should be able to reference by slug
    98→      const plan = kspecJson<{ slugs: string[] }>(
    99→        "plan get @my-plan --json",
   100→        tempDir,
   101→      );
   102→      expect(plan.slugs).toContain("my-plan");
   103→    });
   104→
   105→    it("should error when both --content and --content-file are provided", () => {
   106→      const result = kspecRun(
   107→        'plan add --title "Bad" --content "text" --content-file ./file.md',
   108→        tempDir,
   109→        { expectFail: true },
   110→      );
   111→      expect(result.stderr).toContain(
   112→        "Cannot specify both --content and --content-file",
   113→      );
   114→      expect(result.exitCode).toBe(2); // EXIT_CODES.USAGE_ERROR
   115→    });
   116→  });
   117→
   118→  describe("plan get", () => {
   119→    beforeEach(() => {
   120→      // Create test plans
   121→      kspec(
   122→        'plan add --title "Test Plan" --content "# Implementation\n\nSteps..." --slug test-plan',
   123→        tempDir,
   124→      );
   125→    });
   126→
   127→    // AC: @plan-crud ac-8
   128→    it("should display full plan details", () => {
   129→      const output = kspec("plan get @test-plan", tempDir);
   130→
   131→      expect(output).toContain("ULID:");
   132→      expect(output).toContain("Title:    Test Plan");
   133→      expect(output).toContain("Status:   draft");
   134→      expect(output).toContain("Created:");
   135→      expect(output).toContain("─── Content ───");
   136→      expect(output).toContain("# Implementation");
   137→      expect(output).toContain("Steps...");
   138→    });
   139→
   140→    // AC: @plan-crud ac-30
   141→    it("should output valid JSON with --json", () => {
   142→      const plan = kspecJson<{
   143→        _ulid: string;
   144→        title: string;
   145→        content: string;
   146→        status: string;
   147→        derived_tasks: string[];
   148→        created_at: string;
   149→      }>("plan get @test-plan --json", tempDir);
   150→
   151→      expect(plan._ulid).toBeDefined();
   152→      expect(plan.title).toBe("Test Plan");
   153→      expect(plan.content).toContain("# Implementation");
   154→      expect(plan.status).toBe("draft");
   155→      expect(plan.derived_tasks).toEqual([]);
   156→      expect(plan.created_at).toBeDefined();
   157→    });
   158→
   159→    it("should resolve by ULID prefix", () => {
   160→      const list = kspecJson<Array<{ _ulid: string }>>(
   161→        "plan list --json",
   162→        tempDir,
   163→      );
   164→      const ulid = list[0]._ulid;
   165→      const prefix = ulid.slice(0, 6);
   166→
   167→      const output = kspec(`plan get @${prefix}`, tempDir);
   168→      expect(output).toContain("Test Plan");
   169→    });
   170→
   171→    it("should error when plan not found", () => {
   172→      const result = kspecRun("plan get @nonexistent", tempDir, {
   173→        expectFail: true,
   174→      });
   175→      expect(result.stderr).toContain("Plan not found");
   176→      expect(result.exitCode).toBe(3); // EXIT_CODES.NOT_FOUND
   177→    });
   178→  });
   179→
   180→  describe("plan set", () => {
   181→    beforeEach(() => {
   182→      kspec('plan add --title "Original Title" --content "Content"', tempDir);
   183→    });
   184→
   185→    it("should update title", () => {
   186→      const output = kspec('plan set @01 --title "New Title"', tempDir);
   187→      expect(output).toContain("Updated plan:");
   188→
   189→      const plan = kspecJson<{ title: string }>("plan get @01 --json", tempDir);
   190→      expect(plan.title).toBe("New Title");
   191→    });
   192→
   193→    // AC: @plan-crud ac-3
   194→    it("should update status and set approved_at when transitioning to approved", () => {
   195→      const beforePlan = kspecJson<{ approved_at: string | null }>(
   196→        "plan get @01 --json",
   197→        tempDir,
   198→      );
   199→      expect(beforePlan.approved_at).toBeNull();
   200→
   201→      kspec("plan set @01 --status approved", tempDir);
   202→
   203→      const afterPlan = kspecJson<{ status: string; approved_at: string | null }>(
   204→        "plan get @01 --json",
   205→        tempDir,
   206→      );
   207→      expect(afterPlan.status).toBe("approved");
   208→      expect(afterPlan.approved_at).toBeDefined();
   209→      expect(afterPlan.approved_at).not.toBeNull();
   210→    });
   211→
   212→    // AC: @plan-crud ac-4
   213→    it("should prevent transitions from completed status", () => {
   214→      // Move to completed
   215→      kspec("plan set @01 --status completed", tempDir);
   216→
   217→      // Try to change status
   218→      const result = kspecRun("plan set @01 --status draft", tempDir, {
   219→        expectFail: true,
   220→      });
   221→      expect(result.stderr).toContain("Cannot transition from terminal status");
   222→      expect(result.exitCode).toBe(5);
   223→    });
   224→
   225→    // AC: @plan-crud ac-4
   226→    it("should prevent transitions from rejected status", () => {
   227→      // Move to rejected
   228→      kspec("plan set @01 --status rejected", tempDir);
   229→
   230→      // Try to change status
   231→      const result = kspecRun("plan set @01 --status approved", tempDir, {
   232→        expectFail: true,
   233→      });
   234→      expect(result.stderr).toContain("Cannot transition from terminal status");
   235→      expect(result.exitCode).toBe(5);
   236→    });
   237→
   238→    it("should add slug", () => {
   239→      kspec("plan set @01 --slug new-slug", tempDir);
   240→
   241→      const plan = kspecJson<{ slugs: string[] }>("plan get @01 --json", tempDir);
   242→      expect(plan.slugs).toContain("new-slug");
   243→
   244→      // Should be reachable by new slug
   245→      const output = kspec("plan get @new-slug", tempDir);
   246→      expect(output).toContain("Original Title");
   247→    });
   248→
   249→    it("should not duplicate slug if already present", () => {
   250→      kspec("plan set @01 --slug existing-slug", tempDir);
   251→      kspec("plan set @01 --slug existing-slug", tempDir);
   252→
   253→      const plan = kspecJson<{ slugs: string[] }>("plan get @01 --json", tempDir);
   254→      expect(plan.slugs.filter((s) => s === "existing-slug")).toHaveLength(1);
   255→    });
   256→  });
   257→
   258→  describe("plan list", () => {
   259→    beforeEach(() => {
   260→      // Create multiple plans
   261→      kspec('plan add --title "Draft Plan" --content "Draft"', tempDir);
   262→      kspec(
   263→        'plan add --title "Approved Plan" --content "Approved" --status approved',
   264→        tempDir,
   265→      );
   266→      kspec(
   267→        'plan add --title "Completed Plan" --content "Done" --status completed',
   268→        tempDir,
   269→      );
   270→    });
   271→
   272→    // AC: @plan-crud ac-7
   273→    it("should list all plans", () => {
   274→      const output = kspec("plan list", tempDir);
   275→
   276→      expect(output).toContain("Plans (3)");
   277→      expect(output).toContain("Draft Plan");
   278→      expect(output).toContain("Approved Plan");
   279→      expect(output).toContain("Completed Plan");
   280→      expect(output).toContain("[draft]");
   281→      expect(output).toContain("[approved]");
   282→      expect(output).toContain("[completed]");
   283→    });
   284→
   285→    // AC: @plan-crud ac-7 - status filter
   286→    it("should filter by status", () => {
   287→      const output = kspec("plan list --status draft", tempDir);
   288→
   289→      expect(output).toContain("Plans (1)");
   290→      expect(output).toContain("Draft Plan");
   291→      expect(output).not.toContain("Approved Plan");
   292→      expect(output).not.toContain("Completed Plan");
   293→    });
   294→
   295→    // AC: @plan-crud ac-31
   296→    it("should output JSON array with --json", () => {
   297→      const plans = kspecJson<
   298→        Array<{
   299→          _ulid: string;
   300→          title: string;
   301→          status: string;
   302→          created_at: string;
   303→        }>
   304→      >("plan list --json", tempDir);
   305→
   306→      expect(Array.isArray(plans)).toBe(true);
   307→      expect(plans).toHaveLength(3);
   308→      expect(plans[0]._ulid).toBeDefined();
   309→      expect(plans[0].title).toBeDefined();
   310→      expect(plans[0].status).toBeDefined();
   311→      expect(plans[0].created_at).toBeDefined();
   312→    });
   313→
   314→    it("should show empty message when no plans", async () => {
   315→      // Start fresh with a new temp directory
   316→      const emptyTempDir = await setupTempFixtures();
   317→
   318→      // Delete the plans file if it exists
   319→      const plansPath = path.join(emptyTempDir, ".kspec", "project.plans.yaml");
   320→      try {
   321→        await fs.unlink(plansPath);
   322→      } catch {
   323→        // File might not exist, that's fine
   324→      }
   325→
   326→      const output = kspec("plan list", emptyTempDir);
   327→      expect(output).toContain("No plans found");
   328→
   329→      await cleanupTempDir(emptyTempDir);
   330→    });
   331→  });
   332→
   333→  describe("plan note", () => {
   334→    beforeEach(() => {
   335→      kspec('plan add --title "Plan with Notes" --content "Content"', tempDir);
   336→    });
   337→
   338→    // AC: @plan-crud ac-9
   339→    it("should add note with ULID, timestamp, and author", () => {
   340→      const output = kspec('plan note @01 "First progress note"', tempDir);
   341→      expect(output).toContain("Added note to plan:");
   342→
   343→      const plan = kspecJson<{
   344→        notes: Array<{
   345→          _ulid: string;
   346→          created_at: string;
   347→          author: string;
   348→          content: string;
   349→        }>;
   350→      }>("plan get @01 --json", tempDir);
   351→
   352→      expect(plan.notes).toHaveLength(1);
   353→      expect(plan.notes[0]._ulid).toBeDefined();
   354→      expect(plan.notes[0].created_at).toBeDefined();
   355→      expect(plan.notes[0].author).toBeDefined();
   356→      expect(plan.notes[0].content).toBe("First progress note");
   357→    });
   358→
   359→    it("should append multiple notes", () => {
   360→      kspec('plan note @01 "Note 1"', tempDir);
   361→      kspec('plan note @01 "Note 2"', tempDir);
   362→      kspec('plan note @01 "Note 3"', tempDir);
   363→
   364→      const plan = kspecJson<{ notes: Array<{ content: string }> }>(
   365→        "plan get @01 --json",
   366→        tempDir,
   367→      );
   368→
   369→      expect(plan.notes).toHaveLength(3);
   370→      expect(plan.notes[0].content).toBe("Note 1");
   371→      expect(plan.notes[1].content).toBe("Note 2");
   372→      expect(plan.notes[2].content).toBe("Note 3");
   373→    });
   374→
   375→    it("should display notes in plan get output", () => {
   376→      kspec('plan note @01 "Progress update"', tempDir);
   377→
   378→      const output = kspec("plan get @01", tempDir);
   379→      expect(output).toContain("─── Notes ───");
   380→      expect(output).toContain("Progress update");
   381→    });
   382→  });
   383→
   384→  describe("plan derive", () => {
   385→    // AC: @plan-derive ac-5
   386→    it("should create a task from an approved plan", () => {
   387→      kspec(
   388→        'plan add --title "Auth Feature" --content "Implementation plan" --status approved',
   389→        tempDir,
   390→      );
   391→
   392→      const output = kspec("plan derive @01", tempDir);
   393→      expect(output).toContain("Created task from plan:");
   394→      expect(output).toContain("@implement-auth-feature");
   395→
   396→      // Verify task was created with plan_ref (8-char ULID prefix)
   397→      const task = kspecJson<{ plan_ref: string; title: string }>(
   398→        "task get @implement-auth-feature --json",
   399→        tempDir,
   400→      );
   401→      expect(task.plan_ref).toMatch(/^@01[A-Z0-9]{6}$/);  // 8-char ULID format
   402→      expect(task.title).toBe("Implement: Auth Feature");
   403→    });
   404→
   405→    // AC: @plan-derive ac-5
   406→    it("should create a task from an active plan", () => {
   407→      kspec(
   408→        'plan add --title "Active Plan" --content "Plan" --status active',
   409→        tempDir,
   410→      );
   411→
   412→      const output = kspec("plan derive @01", tempDir);
   413→      expect(output).toContain("Created task from plan:");
   414→    });
   415→
   416→    // AC: @plan-derive ac-5
   417→    it("should update plan's derived_tasks array", () => {
   418→      kspec(
   419→        'plan add --title "Feature Plan" --content "Plan" --status approved',
   420→        tempDir,
   421→      );
   422→
   423→      kspec("plan derive @01", tempDir);
   424→
   425→      const plan = kspecJson<{ derived_tasks: string[] }>(
   426→        "plan get @01 --json",
   427→        tempDir,
   428→      );
   429→      expect(plan.derived_tasks).toHaveLength(1);
   430→      expect(plan.derived_tasks[0]).toMatch(/@implement-feature-plan/);
   431→    });
   432→
   433→    // AC: @plan-derive ac-5
   434→    it("should transition approved plan to active", () => {
   435→      kspec(
   436→        'plan add --title "Approval Test" --content "Plan" --status approved',
   437→        tempDir,
   438→      );
   439→
   440→      kspec("plan derive @01", tempDir);
   441→
   442→      const plan = kspecJson<{ status: string }>("plan get @01 --json", tempDir);
   443→      expect(plan.status).toBe("active");
   444→    });
   445→
   446→    // AC: @plan-derive ac-5
   447→    it("should not change status if plan is already active", () => {
   448→      kspec(
   449→        'plan add --title "Already Active" --content "Plan" --status active',
   450→        tempDir,
   451→      );
   452→
   453→      kspec("plan derive @01", tempDir);
   454→
   455→      const plan = kspecJson<{ status: string }>("plan get @01 --json", tempDir);
   456→      expect(plan.status).toBe("active");
   457→    });
   458→
   459→    // AC: @plan-derive ac-5
   460→    it("should fail for draft plan", () => {
   461→      kspec('plan add --title "Draft Plan" --content "Plan"', tempDir);
   462→
   463→      const result = kspecRun("plan derive @01", tempDir, { expectFail: true });
   464→      expect(result.exitCode).toBe(2);  // USAGE_ERROR
   465→      const output = result.stdout + result.stderr;
   466→      expect(output).toContain(
   467→        "Plan must be in 'approved' or 'active' status",
   468→      );
   469→    });
   470→
   471→    // AC: @plan-derive ac-5
   472→    it("should support custom title with --title flag", () => {
   473→      kspec(
   474→        'plan add --title "Custom Title Test" --content "Plan" --status approved',
   475→        tempDir,
   476→      );
   477→
   478→      const output = kspec("plan derive @01 --title 'My Custom Task'", tempDir);
   479→      expect(output).toContain("Created task from plan:");
   480→
   481→      const task = kspecJson<{ title: string }>(
   482→        "task get @my-custom-task --json",
   483→        tempDir,
   484→      );
   485→      expect(task.title).toBe("My Custom Task");
   486→    });
   487→
   488→    // AC: @plan-derive ac-5
   489→    it("should support custom priority with --priority flag", () => {
   490→      kspec(
   491→        'plan add --title "Priority Test" --content "Plan" --status approved',
   492→        tempDir,
   493→      );
   494→
   495→      kspec("plan derive @01 --priority 1", tempDir);
   496→
   497→      const task = kspecJson<{ priority: number }>(
   498→        "task get @implement-priority-test --json",
   499→        tempDir,
   500→      );
   501→      expect(task.priority).toBe(1);
   502→    });
   503→
   504→    // AC: @plan-derive ac-6
   505→    it("should display plan_ref in task get output", () => {
   506→      kspec(
   507→        'plan add --title "Display Test" --content "Plan" --status approved',
   508→        tempDir,
   509→      );
   510→      kspec("plan derive @01", tempDir);
   511→
   512→      const output = kspec("task get @implement-display-test", tempDir);
   513→      expect(output).toContain("Plan ref:");
   514→      expect(output).toContain("@01");
   515→    });
   516→
   517→    // AC: @plan-derive ac-6
   518→    it("should display derived_tasks in plan get output", () => {
   519→      kspec(
   520→        'plan add --title "Derived Test" --content "Plan" --status approved',
   521→        tempDir,
   522→      );
   523→      kspec("plan derive @01", tempDir);
   524→
   525→      const output = kspec("plan get @01", tempDir);
   526→      expect(output).toContain("Derived Work:");
   527→      expect(output).toContain("Tasks:");
   528→      expect(output).toContain("@implement-derived-test");
   529→    });
   530→
   531→    it("should generate unique slugs when derived multiple times", () => {
   532→      kspec('plan add --title "Same Title" --content "Plan" --status approved', tempDir);
   533→
   534→      // First derive
   535→      kspec("plan derive @01", tempDir);
   536→
   537→      // Manually create second task with same base slug
   538→      kspec('task add --title "Implement: Same Title" --slug implement-same-title-1', tempDir);
   539→
   540→      // Second derive should generate unique slug
   541→      kspec("plan derive @01", tempDir);
   542→
   543→      const plan = kspecJson<{ derived_tasks: string[] }>(
   544→        "plan get @01 --json",
   545→        tempDir,
   546→      );
   547→      expect(plan.derived_tasks).toHaveLength(2);
   548→
   549→      // Check all three tasks exist with unique slugs
   550→      const tasks = kspecJson<Array<{ slugs: string[] }>>(
   551→        "task list --json",
   552→        tempDir,
   553→      );
   554→      const slugs = tasks.flatMap((t) => t.slugs);
   555→      expect(slugs).toContain("implement-same-title");
   556→      expect(slugs).toContain("implement-same-title-1");
   557→      expect(slugs).toContain("implement-same-title-2");
   558→    });
   559→
   560→    it("should work with plan slug reference", () => {
   561→      kspec(
   562→        'plan add --title "Slug Test" --content "Plan" --status approved --slug my-feature',
   563→        tempDir,
   564→      );
   565→
   566→      const output = kspec("plan derive @my-feature", tempDir);
   567→      expect(output).toContain("Created task from plan:");
   568→
   569→      const task = kspecJson<{ plan_ref: string }>(
   570→        "task get @implement-slug-test --json",
   571→        tempDir,
   572→      );
   573→      expect(task.plan_ref).toBe("@my-feature");
   574→    });
   575→  });
   576→});
