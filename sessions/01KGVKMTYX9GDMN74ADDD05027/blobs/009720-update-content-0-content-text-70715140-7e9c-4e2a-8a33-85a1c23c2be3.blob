```
     1→import type { Command } from "commander";
     2→import { markMutating } from "../command-annotations.js";
     3→import {
     4→  AlignmentIndex,
     5→  createNote,
     6→  createTask,
     7→  getAuthor,
     8→  initContext,
     9→  type KspecContext,
    10→  type LoadedSpecItem,
    11→  type LoadedTask,
    12→  loadAllItems,
    13→  loadAllTasks,
    14→  ReferenceIndex,
    15→  saveTask,
    16→} from "../../parser/index.js";
    17→import { commitIfShadow } from "../../parser/shadow.js";
    18→import type { TaskInput } from "../../schema/index.js";
    19→import { errors } from "../../strings/index.js";
    20→import { EXIT_CODES } from "../exit-codes.js";
    21→import { error, info, isJsonMode, output } from "../output.js";
    22→
    23→/**
    24→ * Fields that contain nested spec items (mirrors yaml.ts)
    25→ */
    26→const _NESTED_ITEM_FIELDS = [
    27→  "modules",
    28→  "features",
    29→  "requirements",
    30→  "constraints",
    31→  "decisions",
    32→];
    33→
    34→/**
    35→ * Get the parent path from a child's _path.
    36→ * e.g., "features[0].requirements[1]" -> "features[0]"
    37→ * Returns empty string for top-level items.
    38→ */
    39→function getParentPath(childPath: string | undefined): string {
    40→  if (!childPath) return "";
    41→  const lastDotIndex = childPath.lastIndexOf(".");
    42→  if (lastDotIndex === -1) return "";
    43→  return childPath.slice(0, lastDotIndex);
    44→}
    45→
    46→/**
    47→ * Check if an item is a direct child of another item based on _path.
    48→ * Direct children have a path that extends the parent's path by exactly one field[index].
    49→ */
    50→function isDirectChildOf(
    51→  child: LoadedSpecItem,
    52→  parent: LoadedSpecItem,
    53→): boolean {
    54→  const childPath = child._path || "";
    55→  const parentPath = parent._path || "";
    56→
    57→  // If paths are equal, not a child
    58→  if (childPath === parentPath) return false;
    59→
    60→  // Child path must start with parent path
    61→  if (parentPath && !childPath.startsWith(`${parentPath}.`)) return false;
    62→
    63→  // For root parent (empty path), child must be a top-level path like "features[0]"
    64→  if (!parentPath) {
    65→    // Direct child of root has no '.' in its path
    66→    return !childPath.includes(".");
    67→  }
    68→
    69→  // Get the remaining path after parent
    70→  const remaining = childPath.slice(parentPath.length + 1);
    71→
    72→  // Direct child has no additional '.' (e.g., "requirements[0]" not "requirements[0].something")
    73→  return !remaining.includes(".");
    74→}
    75→
    76→/**
    77→ * Find the parent spec item of a given item.
    78→ * Returns undefined for root-level items.
    79→ */
    80→function findParentItem(
    81→  item: LoadedSpecItem,
    82→  allItems: LoadedSpecItem[],
    83→): LoadedSpecItem | undefined {
    84→  const parentPath = getParentPath(item._path);
    85→
    86→  // Root-level item or no path
    87→  if (!parentPath && !item._path) return undefined;
    88→  if (!parentPath) return undefined;
    89→
    90→  // Find item with matching path in the same source file
    91→  return allItems.find(
    92→    (i) => i._path === parentPath && i._sourceFile === item._sourceFile,
    93→  );
    94→}
    95→
    96→/**
    97→ * Get direct children of a spec item.
    98→ * Only returns immediate children, not grandchildren.
    99→ */
   100→function getDirectChildren(
   101→  parent: LoadedSpecItem,
   102→  allItems: LoadedSpecItem[],
   103→): LoadedSpecItem[] {
   104→  return allItems.filter(
   105→    (item) =>
   106→      item._sourceFile === parent._sourceFile && isDirectChildOf(item, parent),
   107→  );
   108→}
   109→
   110→/**
   111→ * Collect an item and all its descendants in topological order (parent first).
   112→ * This ensures parent tasks are created before child tasks.
   113→ */
   114→function collectItemsRecursively(
   115→  root: LoadedSpecItem,
   116→  allItems: LoadedSpecItem[],
   117→): LoadedSpecItem[] {
   118→  const result: LoadedSpecItem[] = [root];
   119→  const children = getDirectChildren(root, allItems);
   120→
   121→  for (const child of children) {
   122→    const descendants = collectItemsRecursively(child, allItems);
   123→    result.push(...descendants);
   124→  }
   125→
   126→  return result;
   127→}
   128→
   129→/**
   130→ * Resolve a spec item reference.
   131→ * Returns the spec item or exits with error.
   132→ */
   133→function resolveSpecRef(
   134→  ref: string,
   135→  items: LoadedSpecItem[],
   136→  tasks: LoadedTask[],
   137→  index: ReferenceIndex,
   138→): LoadedSpecItem {
   139→  const result = index.resolve(ref);
   140→
   141→  if (!result.ok) {
   142→    switch (result.error) {
   143→      case "not_found":
   144→        error(errors.reference.specNotFound(ref));
   145→        break;
   146→      case "ambiguous":
   147→        error(errors.reference.ambiguous(ref));
   148→        for (const candidate of result.candidates) {
   149→          const item = items.find((i) => i._ulid === candidate);
   150→          const slug = item?.slugs[0] || "";
   151→          console.error(
   152→            `  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ""}`,
   153→          );
   154→        }
   155→        break;
   156→      case "duplicate_slug":
   157→        error(errors.reference.slugMapsToMultiple(ref));
   158→        for (const candidate of result.candidates) {
   159→          console.error(`  - ${index.shortUlid(candidate)}`);
   160→        }
   161→        break;
   162→    }
   163→    process.exit(EXIT_CODES.NOT_FOUND);
   164→  }
   165→
   166→  // Check if it's actually a spec item (not a task)
   167→  const item = items.find((i) => i._ulid === result.ulid);
   168→  if (!item) {
   169→    // Check if it's a task
   170→    const task = tasks.find((t) => t._ulid === result.ulid);
   171→    if (task) {
   172→      error(errors.reference.notSpecItem(ref));
   173→    } else {
   174→      error(errors.reference.specNotFound(ref));
   175→    }
   176→    process.exit(EXIT_CODES.NOT_FOUND);
   177→  }
   178→
   179→  return item;
   180→}
   181→
   182→/**
   183→ * Generate a slug from a spec item title.
   184→ * Converts "My Feature Title" -> "task-my-feature-title"
   185→ */
   186→function generateSlugFromTitle(title: string): string {
   187→  return (
   188→    "task-" +
   189→    title
   190→      .toLowerCase()
   191→      .replace(/[^a-z0-9]+/g, "-")
   192→      .replace(/^-|-$/g, "")
   193→      .slice(0, 50)
   194→  );
   195→}
   196→
   197→/**
   198→ * Convert spec priority to task priority (number).
   199→ * Spec can use 'high', 'medium', 'low' or numeric 1-5.
   200→ */
   201→function normalizePriority(priority: string | number | undefined): number {
   202→  if (priority === undefined) return 3;
   203→  if (typeof priority === "number") return priority;
   204→  switch (priority) {
   205→    case "high":
   206→      return 1;
   207→    case "medium":
   208→      return 3;
   209→    case "low":
   210→      return 5;
   211→    default:
   212→      return 3;
   213→  }
   214→}
   215→
   216→/**
   217→ * Result of deriving a task from a spec item
   218→ */
   219→interface DeriveResult {
   220→  specItem: LoadedSpecItem;
   221→  action: "created" | "skipped" | "would_create";
   222→  task?: LoadedTask;
   223→  reason?: string;
   224→  /** Task ref that was used for depends_on (if any) */
   225→  dependsOn?: string[];
   226→}
   227→
   228→/**
   229→ * Generate implementation notes from spec item for newly derived task.
   230→ * Includes description and acceptance criteria summary.
   231→ */
   232→function generateImplementationNotes(
   233→  specItem: LoadedSpecItem,
   234→): string | undefined {
   235→  const parts: string[] = [];
   236→
   237→  // Add description if present
   238→  if (specItem.description) {
   239→    parts.push(specItem.description.trim());
   240→  }
   241→
   242→  // Add acceptance criteria summary if present
   243→  if (specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
   244→    const acSection = ["", "Acceptance Criteria:"];
   245→    for (const ac of specItem.acceptance_criteria) {
   246→      const summary = `${ac.given ? `Given ${ac.given}, ` : ""}when ${ac.when}, then ${ac.then}`;
   247→      acSection.push(`- ${ac.id}: ${summary}`);
   248→    }
   249→    parts.push(acSection.join("\n"));
   250→  }
   251→
   252→  // Return combined content, or undefined if nothing to add
   253→  return parts.length > 0 ? parts.join("\n\n") : undefined;
   254→}
   255→
   256→/**
   257→ * Derive a task from a spec item.
   258→ * Returns result describing what happened.
   259→ *
   260→ * @param dependsOn - Task references to add as dependencies (for hierarchy-based deps)
   261→ * @param priority - Priority override (1-5), if not provided uses spec's priority
   262→ */
   263→async function deriveTaskFromSpec(
   264→  ctx: KspecContext,
   265→  specItem: LoadedSpecItem,
   266→  existingTasks: LoadedTask[],
   267→  _items: LoadedSpecItem[],
   268→  index: ReferenceIndex,
   269→  alignmentIndex: AlignmentIndex,
   270→  options: {
   271→    force: boolean;
   272→    dryRun: boolean;
   273→    dependsOn?: string[];
   274→    priority?: number;
   275→    title?: string;
   276→  },
   277→): Promise<DeriveResult> {
   278→  // Check if a task already exists for this spec
   279→  // AC: @cmd-derive ac-15 - skip cancelled tasks
   280→  const linkedTasks = alignmentIndex.getTasksForSpec(specItem._ulid);
   281→  const activeTasks = linkedTasks.filter((task) => task.status !== "cancelled");
   282→
   283→  if (activeTasks.length > 0 && !options.force) {
   284→    const taskRef = activeTasks[0].slugs[0]
   285→      ? `@${activeTasks[0].slugs[0]}`
   286→      : `@${index.shortUlid(activeTasks[0]._ulid)}`;
   287→    return {
   288→      specItem,
   289→      action: "skipped",
   290→      task: activeTasks[0],
   291→      reason: `task exists: ${taskRef}`,
   292→    };
   293→  }
   294→
   295→  // Check if slug would collide with existing task
   296→  const baseSlug = generateSlugFromTitle(specItem.title);
   297→  let slug = baseSlug;
   298→  let slugSuffix = 1;
   299→
   300→  // Find unique slug if needed
   301→  while (existingTasks.some((t) => t.slugs.includes(slug))) {
   302→    slug = `${baseSlug}-${slugSuffix}`;
   303→    slugSuffix++;
   304→  }
   305→
   306→  // Generate implementation notes from spec
   307→  // AC: @cmd-derive ac-author
   308→  const noteContent = generateImplementationNotes(specItem);
   309→  const initialNotes = noteContent
   310→    ? [
   311→        createNote(
   312→          `Implementation notes (auto-generated from spec):\n\n${noteContent}`,
   313→          getAuthor(),
   314→        ),
   315→      ]
   316→    : [];
   317→
   318→  // Build task input with depends_on and initial notes
   319→  // AC: @derive-title-override ac-1 - use provided title if specified
   320→  const taskInput: TaskInput = {
   321→    title: options.title ?? `Implement: ${specItem.title}`,
   322→    type: "task",
   323→    spec_ref: `@${specItem.slugs[0] || specItem._ulid}`,
   324→    derivation: "auto",
   325→    priority: options.priority ?? normalizePriority(specItem.priority),
   326→    slugs: [slug],
   327→    tags: [...(specItem.tags || [])],
   328→    depends_on: options.dependsOn || [],
   329→    notes: initialNotes,
   330→  };
   331→
   332→  // Dry run - don't actually create
   333→  if (options.dryRun) {
   334→    const previewTask = createTask(taskInput) as LoadedTask;
   335→    return {
   336→      specItem,
   337→      action: "would_create",
   338→      task: previewTask,
   339→      dependsOn: options.dependsOn,
   340→    };
   341→  }
   342→
   343→  // Create and save the task
   344→  const newTask = createTask(taskInput);
   345→  await saveTask(ctx, newTask);
   346→  const specSlug = specItem.slugs[0] || specItem._ulid.slice(0, 8);
   347→  await commitIfShadow(ctx.shadow, "derive", specSlug);
   348→
   349→  // Add to existing tasks list for slug collision checks
   350→  existingTasks.push(newTask as LoadedTask);
   351→
   352→  return {
   353→    specItem,
   354→    action: "created",
   355→    task: newTask as LoadedTask,
   356→    dependsOn: options.dependsOn,
   357→  };
   358→}
   359→
   360→/**
   361→ * Get a task reference string for use in depends_on.
   362→ * Prefers slug over ULID for readability.
   363→ */
   364→function getTaskRef(task: LoadedTask, index: ReferenceIndex): string {
   365→  return task.slugs[0]
   366→    ? `@${task.slugs[0]}`
   367→    : `@${index.shortUlid(task._ulid)}`;
   368→}
   369→
   370→/**
   371→ * Find or get the task for a parent spec item.
   372→ * Looks in:
   373→ * 1. Tasks created in this derive session (specToTaskMap)
   374→ * 2. Existing tasks linked to the parent spec (alignmentIndex)
   375→ *
   376→ * Only returns tasks that are NOT in 'cancelled' state (AC-15).
   377→ */
   378→function getParentTaskRef(
   379→  parentSpec: LoadedSpecItem,
   380→  specToTaskMap: Map<string, LoadedTask>,
   381→  alignmentIndex: AlignmentIndex,
   382→  index: ReferenceIndex,
   383→): string | undefined {
   384→  // Check if we created a task for this parent in this session
   385→  const sessionTask = specToTaskMap.get(parentSpec._ulid);
   386→  if (sessionTask && sessionTask.status !== "cancelled") {
   387→    return getTaskRef(sessionTask, index);
   388→  }
   389→
   390→  // Check if an existing task is linked to this parent spec
   391→  // AC: @cmd-derive ac-15 - skip cancelled tasks
   392→  const linkedTasks = alignmentIndex.getTasksForSpec(parentSpec._ulid);
   393→  const activeTask = linkedTasks.find((task) => task.status !== "cancelled");
   394→  if (activeTask) {
   395→    return getTaskRef(activeTask, index);
   396→  }
   397→
   398→  return undefined;
   399→}
   400→
   401→/**
   402→ * Register the 'derive' command
   403→ */
   404→export function registerDeriveCommand(program: Command): void {
   405→  markMutating(program.command("derive [ref]"))
   406→    .description("Create task(s) from spec item(s)")
   407→    .option("--all", "Derive tasks for all spec items without linked tasks")
   408→    .option(
   409→      "--flat",
   410→      "Only derive for the specified item, not children (default: recursive)",
   411→    )
   412→    .option("--force", "Create task even if one already exists for the spec")
   413→    .option("--dry-run", "Show what would be created without making changes")
   414→    .option(
   415→      "--priority <n>",
   416→      "Set priority for created task(s) (1-5)",
   417→      parseInt,
   418→    )
   419→    .option("--title <title>", "Override task title (default: 'Implement: {spec title}')")
   420→    .action(async (ref: string | undefined, options) => {
   421→      try {
   422→        // Validate arguments
   423→        if (!ref && !options.all) {
   424→          error(errors.usage.deriveNoRef);
   425→          console.error("Usage:");
   426→          console.error("  kspec derive @spec-ref");
   427→          console.error("  kspec derive @spec-ref --flat");
   428→          console.error("  kspec derive --all");
   429→          process.exit(EXIT_CODES.USAGE_ERROR);
   430→        }
   431→
   432→        if (ref && options.all) {
   433→          error(errors.usage.deriveRefAndAll);
   434→          process.exit(EXIT_CODES.USAGE_ERROR);
   435→        }
   436→
   437→        // Validate priority if provided
   438→        if (options.priority !== undefined) {
   439→          if (
   440→            Number.isNaN(options.priority) ||
   441→            options.priority < 1 ||
   442→            options.priority > 5
   443→          ) {
   444→            error("Priority must be a number between 1 and 5");
   445→            process.exit(EXIT_CODES.USAGE_ERROR);
   446→          }
   447→        }
   448→
   449→        const ctx = await initContext();
   450→        const tasks = await loadAllTasks(ctx);
   451→        const items = await loadAllItems(ctx);
   452→        const index = new ReferenceIndex(tasks, items);
   453→
   454→        // Build alignment index
   455→        const alignmentIndex = new AlignmentIndex(tasks, items);
   456→        alignmentIndex.buildLinks(index);
   457→
   458→        // Collect spec items to process
   459→        let specsToDerive: LoadedSpecItem[];
   460→
   461→        if (options.all) {
   462→          // Get all spec items without linked tasks
   463→          specsToDerive = items.filter((item) => {
   464→            const linkedTasks = alignmentIndex.getTasksForSpec(item._ulid);
   465→            return linkedTasks.length === 0 || options.force;
   466→          });
   467→
   468→          if (specsToDerive.length === 0) {
   469→            if (isJsonMode()) {
   470→              console.log(JSON.stringify([]));
   471→            } else {
   472→              info("Nothing to derive (all items have tasks)");
   473→            }
   474→            return;
   475→          }
   476→        } else {
   477→          // Single spec item - recursive by default, flat if --flat
   478→          const specItem = resolveSpecRef(ref!, items, tasks, index);
   479→
   480→          if (options.flat) {
   481→            specsToDerive = [specItem];
   482→          } else {
   483→            // Recursive: collect item and all descendants
   484→            specsToDerive = collectItemsRecursively(specItem, items);
   485→          }
   486→        }
   487→
   488→        // Track spec ULID -> created task for dependency resolution
   489→        const specToTaskMap = new Map<string, LoadedTask>();
   490→
   491→        // Process each spec item in order (parents before children due to topological sort)
   492→        const results: DeriveResult[] = [];
   493→
   494→        for (const specItem of specsToDerive) {
   495→          // Determine depends_on based on parent spec's task
   496→          let dependsOn: string[] | undefined;
   497→
   498→          if (!options.flat && !options.all) {
   499→            // Find the parent spec item
   500→            const parentSpec = findParentItem(specItem, items);
   501→
   502→            if (parentSpec) {
   503→              const parentTaskRef = getParentTaskRef(
   504→                parentSpec,
   505→                specToTaskMap,
   506→                alignmentIndex,
   507→                index,
   508→              );
   509→              if (parentTaskRef) {
   510→                dependsOn = [parentTaskRef];
   511→              }
   512→            }
   513→          }
   514→
   515→          const result = await deriveTaskFromSpec(
   516→            ctx,
   517→            specItem,
   518→            tasks,
   519→            items,
   520→            index,
   521→            alignmentIndex,
   522→            {
   523→              force: options.force || false,
   524→              dryRun: options.dryRun || false,
   525→              dependsOn,
   526→              priority: options.priority,
   527→              title: options.title,
   528→            },
   529→          );
   530→
   531→          // Track created/would_create tasks for dependency resolution
   532→          if (
   533→            result.task &&
   534→            (result.action === "created" || result.action === "would_create")
   535→          ) {
   536→            specToTaskMap.set(specItem._ulid, result.task);
   537→          }
   538→          // Also track skipped tasks (existing) for dependency resolution
   539→          if (result.action === "skipped" && result.task) {
   540→            specToTaskMap.set(specItem._ulid, result.task);
   541→          }
   542→
   543→          results.push(result);
   544→        }
   545→
   546→        // Output results
   547→        if (isJsonMode()) {
   548→          // JSON output format - simplified per AC
   549→          const jsonOutput = results.map((r) => ({
   550→            ulid: r.task?._ulid || null,
   551→            slug: r.task?.slugs[0] || null,
   552→            spec_ref: `@${r.specItem.slugs[0] || r.specItem._ulid}`,
   553→            depends_on: r.task?.depends_on || [],
   554→            action: r.action,
   555→          }));
   556→          console.log(JSON.stringify(jsonOutput, null, 2));
   557→          return; // Don't call output() which would output full results in global JSON mode
   558→        } else {
   559→          // Human-readable output
   560→          output(results, () => {
   561→            const created = results.filter((r) => r.action === "created");
   562→            const skipped = results.filter((r) => r.action === "skipped");
   563→            const wouldCreate = results.filter(
   564→              (r) => r.action === "would_create",
   565→            );
   566→
   567→            if (options.dryRun) {
   568→              console.log("Would create:");
   569→              for (const r of wouldCreate) {
   570→                const taskSlug = r.task?.slugs[0] || "";
   571→                const deps = r.dependsOn?.length
   572→                  ? ` (depends: ${r.dependsOn.join(", ")})`
   573→                  : "";
   574→                console.log(`  + ${r.specItem.title}`);
   575→                console.log(`    -> ${taskSlug}${deps}`);
   576→              }
   577→              if (skipped.length > 0) {
   578→                console.log("\nSkipped:");
   579→                for (const r of skipped) {
   580→                  const specRef = r.specItem.slugs[0]
   581→                    ? `@${r.specItem.slugs[0]}`
   582→                    : `@${index.shortUlid(r.specItem._ulid)}`;
   583→                  console.log(`  - ${specRef} (${r.reason})`);
   584→                }
   585→              }
   586→              console.log(`\nWould create ${wouldCreate.length} task(s)`);
   587→              if (skipped.length > 0) {
   588→                console.log(`Skipped ${skipped.length} (already have tasks)`);
   589→              }
   590→              return;
   591→            }
   592→
   593→            if (created.length > 0) {
   594→              for (const r of created) {
   595→                const taskSlug = r.task?.slugs[0] || "";
   596→                const deps = r.dependsOn?.length
   597→                  ? ` (depends: ${r.dependsOn.join(", ")})`
   598→                  : "";
   599→                console.log(`OK Created task: ${taskSlug}${deps}`);
   600→              }
   601→            }
   602→
   603→            if (skipped.length > 0 && !options.all) {
   604→              // Show skipped for explicit derive (not --all)
   605→              for (const r of skipped) {
   606→                const specRef = r.specItem.slugs[0]
   607→                  ? `@${r.specItem.slugs[0]}`
   608→                  : `@${index.shortUlid(r.specItem._ulid)}`;
   609→                console.log(`Skipped ${specRef} (${r.reason})`);
   610→              }
   611→            }
   612→
   613→            // Summary
   614→            if (created.length > 0 || skipped.length > 0) {
   615→              console.log("");
   616→              if (created.length > 0) {
   617→                console.log(`Created ${created.length} task(s)`);
   618→              }
   619→              if (skipped.length > 0) {
   620→                console.log(`Skipped ${skipped.length} (already have tasks)`);
   621→              }
   622→            }
   623→          });
   624→        }
