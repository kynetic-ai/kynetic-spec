    50→// ─── Types ───────────────────────────────────────────────────────────────────
    51→
    52→export interface CheckpointResult {
    53→  /** Whether session can end cleanly */
    54→  ok: boolean;
    55→
    56→  /** Human-readable message for Claude Code */
    57→  message: string;
    58→
    59→  /** Issues that need attention before stopping */
    60→  issues: CheckpointIssue[];
    61→
    62→  /** Instructions for the agent */
    63→  instructions: string[];
    64→}
    65→
    66→export interface CheckpointIssue {
    67→  type: "uncommitted_changes" | "in_progress_task" | "incomplete_todo";
    68→  description: string;
    69→  details?: Record<string, unknown>;
    70→}
    71→
    72→export interface SessionContext {
    73→  /** When this context was generated */
    74→  generated_at: string;
    75→
    76→  /** Current git branch */
    77→  branch: string | null;
    78→
    79→  /** Session context (focus, threads, questions) */
    80→  context: StoredSessionContext | null;
    81→
    82→  /** Tasks currently in progress */
    83→  active_tasks: ActiveTaskSummary[];
    84→
    85→  /** Tasks awaiting review (code done, PR pending) */
    86→  pending_review_tasks: ActiveTaskSummary[];
    87→
    88→  /** Recent notes from active tasks */
    89→  recent_notes: NoteSummary[];
    90→
    91→  /** Incomplete todos from active tasks */
    92→  active_todos: TodoSummary[];
    93→
    94→  /** Tasks ready to be picked up */
    95→  ready_tasks: ReadyTaskSummary[];
    96→
    97→  /** Blocked tasks with blockers */
    98→  blocked_tasks: BlockedTaskSummary[];
    99→
   100→  /** Recently completed tasks */
   101→  recently_completed: CompletedTaskSummary[];
   102→
   103→  /** Recent git commits */
   104→  recent_commits: CommitSummary[];
   105→
   106→  /** Working tree status */
   107→  working_tree: GitWorkingTree | null;
   108→
   109→  /** Inbox items awaiting triage (oldest first) */
   110→  inbox_items: InboxSummary[];
   111→
   112→  /** Summary statistics */
   113→  stats: SessionStats;
   114→}
   115→
   116→export interface ActiveTaskSummary {
   117→  ref: string;
   118→  title: string;
   119→  started_at: string | null;
   120→  priority: number;
   121→  spec_ref: string | null;
   122→  note_count: number;
   123→  last_note_at: string | null;
   124→  todo_count: number;
   125→  incomplete_todos: number;
   126→}
   127→
   128→export interface NoteSummary {
   129→  task_ref: string;
   130→  task_title: string;
   131→  note_ulid: string;
   132→  created_at: string;
   133→  author: string | null;
   134→  content: string;
   135→}
   136→
   137→export interface TodoSummary {
   138→  task_ref: string;
   139→  task_title: string;
   140→  id: number;
   141→  text: string;
   142→  added_at: string;
   143→  added_by: string | null;
   144→}
   145→
   146→export interface ReadyTaskSummary {
   147→  ref: string;
   148→  title: string;
   149→  priority: number;
   150→  spec_ref: string | null;
   151→  tags: string[];
   152→}
   153→
   154→export interface BlockedTaskSummary {
   155→  ref: string;
   156→  title: string;
   157→  blocked_by: string[];
   158→  unmet_deps: string[];
   159→}
   160→
   161→export interface CompletedTaskSummary {
   162→  ref: string;
   163→  title: string;
   164→  completed_at: string;
   165→  closed_reason: string | null;
   166→  origin?: "manual" | "derived" | "observation_promotion";
   167→}
   168→
   169→export interface CommitSummary {
   170→  hash: string;
   171→  full_hash: string;
   172→  date: string;
   173→  message: string;
   174→  author: string;
   175→}
   176→
   177→export interface SessionStats {
   178→  total_tasks: number;
   179→  in_progress: number;
   180→  pending_review: number;
   181→  ready: number;
   182→  blocked: number;
   183→  completed: number;
   184→  inbox_items: number;
   185→}
   186→
   187→export interface InboxSummary {
   188→  ref: string;
   189→  text: string;
   190→  created_at: string;
   191→  tags: string[];
   192→  added_by: string | null;
   193→}
   194→
   195→export interface SessionOptions {
   196→  brief?: boolean;
   197→  full?: boolean;
   198→  since?: string;
   199→  git?: boolean;
   200→  limit?: string;
   201→  eligible?: boolean; // Only include automation-eligible tasks in ready_tasks
   202→}
   203→
   204→// ─── Data Gathering ──────────────────────────────────────────────────────────
   205→
   206→function toActiveTaskSummary(
   207→  task: LoadedTask,
   208→  index: ReferenceIndex,
   209→): ActiveTaskSummary {
   210→  const lastNote =
   211→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   212→  const incompleteTodos = task.todos.filter((t) => !t.done).length;
   213→  return {
   214→    ref: index.shortUlid(task._ulid),
   215→    title: task.title,
   216→    started_at: task.started_at || null,
   217→    priority: task.priority,
   218→    spec_ref: task.spec_ref || null,
   219→    note_count: task.notes.length,
   220→    last_note_at: lastNote ? lastNote.created_at : null,
   221→    todo_count: task.todos.length,
   222→    incomplete_todos: incompleteTodos,
   223→  };
   224→}
   225→
   226→function toReadyTaskSummary(
   227→  task: LoadedTask,
   228→  index: ReferenceIndex,
   229→): ReadyTaskSummary {
   230→  return {
   231→    ref: index.shortUlid(task._ulid),
   232→    title: task.title,
   233→    priority: task.priority,
   234→    spec_ref: task.spec_ref || null,
   235→    tags: task.tags,
   236→  };
   237→}
   238→
   239→function toBlockedTaskSummary(
   240→  task: LoadedTask,
   241→  _allTasks: LoadedTask[],
   242→  index: ReferenceIndex,
   243→): BlockedTaskSummary {
   244→  // Find unmet dependencies
   245→  const unmetDeps: string[] = [];
   246→  for (const depRef of task.depends_on) {
   247→    const result = index.resolve(depRef);
   248→    if (result.ok) {
   249→      const depItem = result.item;
   250→      if ("status" in depItem && depItem.status !== "completed") {
   251→        unmetDeps.push(depRef);
   252→      }
   253→    }
   254→  }
   255→
   256→  return {
   257→    ref: index.shortUlid(task._ulid),
   258→    title: task.title,
   259→    blocked_by: task.blocked_by,
   260→    unmet_deps: unmetDeps,
   261→  };
   262→}
   263→
   264→function toCompletedTaskSummary(
   265→  task: LoadedTask,
   266→  index: ReferenceIndex,
   267→): CompletedTaskSummary {
   268→  return {
   269→    ref: index.shortUlid(task._ulid),
   270→    title: task.title,
   271→    completed_at: task.completed_at || "",
   272→    closed_reason: task.closed_reason || null,
   273→    origin: task.origin,
   274→  };
   275→}
   276→
   277→function collectRecentNotes(
   278→  tasks: LoadedTask[],
   279→  index: ReferenceIndex,
   280→  options: { limit: number; since: Date | null },
   281→): NoteSummary[] {
   282→  const allNotes: NoteSummary[] = [];
   283→
   284→  for (const task of tasks) {
   285→    for (const note of task.notes) {
   286→      const noteDate = new Date(note.created_at);
   287→
   288→      // Filter by since date if provided
   289→      if (options.since && noteDate < options.since) {
   290→        continue;
   291→      }
   292→
   293→      allNotes.push({
   294→        task_ref: index.shortUlid(task._ulid),
   295→        task_title: task.title,
   296→        note_ulid: note._ulid.slice(0, 8),
   297→        created_at: note.created_at,
   298→        author: note.author || null,
   299→        content: note.content,
   300→      });
   301→    }
   302→  }
   303→
   304→  // Sort by date descending, take limit
   305→  return allNotes
   306→    .sort(
   307→      (a, b) =>
   308→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   309→    )
   310→    .slice(0, options.limit);
   311→}
   312→
   313→function collectIncompleteTodos(
   314→  tasks: LoadedTask[],
   315→  index: ReferenceIndex,
   316→  options: { limit: number },
   317→): TodoSummary[] {
   318→  const allTodos: TodoSummary[] = [];
   319→
   320→  for (const task of tasks) {
   321→    for (const todo of task.todos) {
   322→      // Only include incomplete todos
   323→      if (todo.done) continue;
   324→
   325→      allTodos.push({
   326→        task_ref: index.shortUlid(task._ulid),
   327→        task_title: task.title,
   328→        id: todo.id,
   329→        text: todo.text,
   330→        added_at: todo.added_at,
   331→        added_by: todo.added_by || null,
   332→      });
   333→    }
   334→  }
   335→
   336→  // Sort by added_at descending (most recent first), take limit
   337→  return allTodos
   338→    .sort(
   339→      (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime(),
   340→    )
   341→    .slice(0, options.limit);
   342→}
   343→
   344→/**
   345→ * Gather session context data
   346→ */
   347→export async function gatherSessionContext(
   348→  ctx: KspecContext,
   349→  options: SessionOptions,
   350→): Promise<SessionContext> {
   351→  const limit = parseInt(options.limit || "10", 10);
   352→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   353→  const showGit = options.git !== false; // default true
   354→
   355→  // Load all data
   356→  const allTasks = await loadAllTasks(ctx);
   357→  const items = await loadAllItems(ctx);
   358→  const inboxItems = await loadInboxItems(ctx);
   359→  const index = new ReferenceIndex(allTasks, items);
   360→
   361→  // Compute stats
   362→  const stats: SessionStats = {
   363→    total_tasks: allTasks.length,
   364→    in_progress: allTasks.filter((t) => t.status === "in_progress").length,
   365→    pending_review: allTasks.filter((t) => t.status === "pending_review")
   366→      .length,
   367→    ready: getReadyTasks(allTasks).length,
   368→    blocked: allTasks.filter((t) => t.status === "blocked").length,
   369→    completed: allTasks.filter((t) => t.status === "completed").length,
   370→    inbox_items: inboxItems.length,
   371→  };
   372→
   373→  // Get active tasks (optionally filtered to automation-eligible only)
   374→  // AC: @cli-ralph ac-16
   375→  const activeTasks = allTasks
   376→    .filter((t) => t.status === "in_progress")
   377→    .filter((t) => !options.eligible || t.automation === "eligible")
   378→    .sort((a, b) => a.priority - b.priority)
   379→    .slice(0, options.full ? undefined : limit)
   380→    .map((t) => toActiveTaskSummary(t, index));
   381→
   382→  // Get pending review tasks
   383→  const pendingReviewTasks = allTasks
   384→    .filter((t) => t.status === "pending_review")
   385→    .sort((a, b) => a.priority - b.priority)
   386→    .slice(0, options.full ? undefined : limit)
   387→    .map((t) => toActiveTaskSummary(t, index));
   388→
   389→  // Get recent notes from active tasks
   390→  const recentNotes = collectRecentNotes(
   391→    allTasks.filter((t) => t.status === "in_progress"),
   392→    index,
   393→    { limit: options.full ? limit * 2 : limit, since: sinceDate },
   394→  );
   395→
   396→  // Get incomplete todos from active tasks
   397→  const activeTodos = collectIncompleteTodos(
   398→    allTasks.filter((t) => t.status === "in_progress"),
   399→    index,
   400→    { limit: options.full ? limit * 2 : limit },
   401→  );
   402→
   403→  // Get ready tasks (optionally filtered to automation-eligible only)
   404→  const readyTasks = getReadyTasks(allTasks)
   405→    .filter((t) => !options.eligible || t.automation === "eligible")
   406→    .slice(0, options.full ? undefined : limit)
   407→    .map((t) => toReadyTaskSummary(t, index));
   408→
   409→  // Get blocked tasks
   410→  const blockedTasks = allTasks
   411→    .filter((t) => t.status === "blocked")
   412→    .slice(0, options.full ? undefined : limit)
   413→    .map((t) => toBlockedTaskSummary(t, allTasks, index));
   414→
   415→  // Get recently completed tasks
   416→  const recentlyCompleted = allTasks
   417→    .filter((t) => {
   418→      if (t.status !== "completed" || !t.completed_at) return false;
   419→      const completedDate = new Date(t.completed_at);
   420→      if (sinceDate && completedDate < sinceDate) return false;
   421→      return true;
   422→    })
   423→    .sort((a, b) => {
   424→      // Sort by completed_at descending (most recent first)
   425→      const aDate = new Date(a.completed_at || 0);
   426→      const bDate = new Date(b.completed_at || 0);
   427→      return bDate.getTime() - aDate.getTime();
   428→    })
   429→    .slice(0, options.full ? undefined : limit)
   430→    .map((t) => toCompletedTaskSummary(t, index));
   431→
   432→  // Get git info
   433→  let branch: string | null = null;
   434→  let recentCommits: CommitSummary[] = [];
   435→  let workingTree: GitWorkingTree | null = null;
   436→
   437→  if (showGit && isGitRepo(ctx.rootDir)) {
   438→    branch = getCurrentBranch(ctx.rootDir);
   439→
   440→    const commits = getRecentCommits({
   441→      limit: options.full ? limit * 2 : limit,
   442→      since: sinceDate || undefined,
   443→      cwd: ctx.rootDir,
   444→    });
   445→
   446→    recentCommits = commits.map((c) => ({
   447→      hash: c.hash,
   448→      full_hash: c.fullHash,
   449→      date: c.date.toISOString(),
   450→      message: c.message,
   451→      author: c.author,
   452→    }));
   453→
   454→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   455→  }
   456→
   457→  // Get inbox items (oldest first to encourage triage)
   458→  const inboxSummaries: InboxSummary[] = inboxItems
   459→    .sort(
   460→      (a, b) =>
   461→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   462→    )
   463→    .slice(0, options.full ? undefined : limit)
   464→    .map((item) => ({
   465→      ref: item._ulid.slice(0, 8),
   466→      text: item.text,
   467→      created_at: item.created_at,
   468→      tags: item.tags,
   469→      added_by: item.added_by || null,
   470→    }));
   471→
   472→  // Load session context (focus, threads, questions)
   473→  const sessionContext = await loadSessionContext(ctx);
   474→
   475→  return {
   476→    generated_at: new Date().toISOString(),
   477→    branch,
   478→    context: sessionContext,
   479→    active_tasks: activeTasks,
   480→    pending_review_tasks: pendingReviewTasks,
   481→    recent_notes: recentNotes,
   482→    active_todos: activeTodos,
   483→    ready_tasks: readyTasks,
   484→    blocked_tasks: blockedTasks,
   485→    recently_completed: recentlyCompleted,
   486→    recent_commits: recentCommits,
   487→    working_tree: workingTree,
   488→    inbox_items: inboxSummaries,
   489→    stats,
   490→  };
   491→}
   492→
   493→// ─── Iteration Stats ─────────────────────────────────────────────────────────
   494→
   495→/**
   496→ * Stats for tasks completed/started within a time window.
   497→ * Used by ralph to track task completions per iteration.
   498→ */
   499→export interface IterationStats {
   500→  /** Number of tasks completed since the given time */
   501→  tasks_completed: number;
   502→  /** Number of tasks started since the given time */
   503→  tasks_started: number;
   504→  /** References of completed tasks */
   505→  completed_refs: string[];
   506→}
   507→
   508→/**
   509→ * Get iteration stats - tasks completed/started since a given time.
   510→ * AC: @ralph-task-limit ac-detection
   511→ */
   512→export async function getIterationStats(
   513→  ctx: KspecContext,
   514→  since: Date,
   515→): Promise<IterationStats> {
   516→  const allTasks = await loadAllTasks(ctx);
   517→
   518→  const completedSince = allTasks.filter((t) => {
   519→    if (t.status !== "completed" || !t.completed_at) return false;
   520→    return new Date(t.completed_at) >= since;
   521→  });
   522→
   523→  const startedSince = allTasks.filter((t) => {
   524→    if (!t.started_at) return false;
   525→    return new Date(t.started_at) >= since;
   526→  });
   527→
   528→  // Use first slug or ULID prefix as ref
   529→  const getRef = (t: LoadedTask) =>
   530→    t.slugs.length > 0 ? `@${t.slugs[0]}` : `@${t._ulid.slice(0, 8)}`;
   531→
   532→  return {
   533→    tasks_completed: completedSince.length,
   534→    tasks_started: startedSince.length,
   535→    completed_refs: completedSince.map(getRef),
   536→  };
   537→}
   538→
   539→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   540→
   541→export interface CheckpointOptions {
   542→  force?: boolean;
   543→  /** Set when stop hook is already active (retry after previous block) */
   544→  stopHookActive?: boolean;
   545→}
   546→
   547→/** Claude Code hook input for Stop hooks */
   548→export interface StopHookInput {
   549→  session_id?: string;
   550→  transcript_path?: string;
   551→  hook_event_name?: string;
   552→  stop_hook_active?: boolean;
   553→}
   554→
   555→/**
   556→ * Perform session checkpoint - check for uncommitted work before ending session.
   557→ *
   558→ * This is designed for use as a Claude Code stop hook. It checks for:
   559→ * - Uncommitted git changes (staged, unstaged, untracked)
   560→ * - Tasks in in_progress status
   561→ * - Incomplete todos on active tasks
   562→ *
   563→ * Returns a structured result indicating whether the session can end cleanly.
   564→ */
   565→export async function performCheckpoint(
   566→  ctx: KspecContext,
   567→  options: CheckpointOptions,
   568→): Promise<CheckpointResult> {
   569→  const issues: CheckpointIssue[] = [];
   570→  const instructions: string[] = [];
   571→
   572→  // Load tasks
   573→  const allTasks = await loadAllTasks(ctx);
   574→
   575→  // Check for in-progress tasks
   576→  const inProgressTasks = allTasks.filter((t) => t.status === "in_progress");
   577→  for (const task of inProgressTasks) {
   578→    const ref = task.slugs[0]
   579→      ? `@${task.slugs[0]}`
   580→      : `@${task._ulid.slice(0, 8)}`;
   581→    issues.push({
   582→      type: "in_progress_task",
   583→      description: `Task ${ref} is still in progress: ${task.title}`,
   584→      details: {
   585→        ref,
   586→        title: task.title,
   587→        started_at: task.started_at,
   588→      },
   589→    });
   590→
   591→    // Check for incomplete todos on this task
   592→    const incompleteTodos = task.todos.filter((t) => !t.done);
   593→    for (const todo of incompleteTodos) {
   594→      issues.push({
   595→        type: "incomplete_todo",
   596→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   597→        details: {
   598→          task_ref: ref,
   599→          todo_id: todo.id,
   600→          text: todo.text,
   601→        },
   602→      });
   603→    }
   604→  }
   605→
   606→  // Check for uncommitted git changes
   607→  if (isGitRepo(ctx.rootDir)) {
   608→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   609→    if (!workingTree.clean) {
   610→      const changeCount =
   611→        workingTree.staged.length +
   612→        workingTree.unstaged.length +
   613→        workingTree.untracked.length;
   614→
   615→      issues.push({
   616→        type: "uncommitted_changes",
   617→        description: `${changeCount} uncommitted changes in working tree`,
   618→        details: {
   619→          staged: workingTree.staged.length,
   620→          unstaged: workingTree.unstaged.length,
   621→          untracked: workingTree.untracked.length,
   622→        },
   623→      });
   624→    }
   625→  }
   626→
   627→  // Build instructions based on issues
   628→  if (issues.length > 0 && !options.force) {
   629→    instructions.push(
   630→      "If you've been instructed to ignore this message or are working on",
   631→    );
   632→    instructions.push(
   633→      "unrelated things to any in progress tasks then disregard this message,",
   634→    );
   635→    instructions.push("otherwise before ending this session, please:");
   636→
   637→    const hasInProgress = issues.some((i) => i.type === "in_progress_task");
   638→    const hasUncommitted = issues.some((i) => i.type === "uncommitted_changes");
   639→    const hasIncompleteTodos = issues.some((i) => i.type === "incomplete_todo");
   640→
   641→    let step = 1;
   642→
   643→    if (hasInProgress) {
   644→      instructions.push(
   645→        `${step++}. Read in-progress task notes to get full context of the current task status`,
   646→      );
   647→      instructions.push(
   648→        `${step++}. Add notes documenting current state if any context is missing from this session`,
   649→      );
   650→      instructions.push(
   651→        `${step++}. Complete the task if you've completed the objectives and no AC are left uncovered\notherwise leave it in progress for a future session`,
   652→      );
   653→    }
   654→
   655→    if (hasIncompleteTodos) {
   656→      instructions.push(
   657→        `${step++}. Complete or acknowledge incomplete todos on active tasks`,
   658→      );
   659→    }
   660→
   661→    if (hasUncommitted) {
   662→      instructions.push(
   663→        `${step++}. Commit your changes with a descriptive message`,
   664→      );
   665→
   666→      // Add WIP commit guidance if there are in-progress tasks
   667→      if (inProgressTasks.length > 0) {
   668→        const task = inProgressTasks[0];
   669→        const guidance = formatCommitGuidance(task, { wip: true });
   670→        instructions.push("");
   671→        instructions.push("Suggested WIP commit:");
   672→        instructions.push(`  ${guidance.message}`);
   673→        instructions.push("");
   674→        for (const trailer of guidance.trailers) {
   675→          instructions.push(`  ${trailer}`);
   676→        }
   677→      }
   678→    }
   679→
   680→    instructions.push("");
   681→    instructions.push("Use: kspec task @task to get current task state");
   682→    instructions.push(
   683→      'Use: kspec task note @task "Progress notes..." to document state',
   684→    );
   685→    instructions.push(
   686→      'Use: kspec task complete @task --reason "Summary" if task is done',
   687→    );
   688→  }
   689→
   690→  // Allow stop if:
   691→  // - No issues found
   692→  // - --force flag passed
   693→  // - This is a retry (stop_hook_active = true from previous block)
   694→  const isRetry = options.stopHookActive === true;
   695→  const ok = issues.length === 0 || options.force === true || isRetry;
   696→
   697→  let message: string;
   698→  if (isRetry && issues.length > 0) {
   699→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   700→  } else if (ok) {
   701→    message = "[kspec] Session checkpoint passed - ready to end session";
   702→  } else {
   703→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   704→  }
   705→
   706→  return {
   707→    ok,
   708→    message,
   709→    issues,
   710→    instructions,
   711→  };
   712→}
   713→
   714→// ─── Output Formatting ───────────────────────────────────────────────────────
   715→
   716→function formatCheckpointResult(result: CheckpointResult): void {
   717→  if (result.ok) {
   718→    console.log(chalk.green(result.message));
   719→  } else {
   720→    console.log(chalk.yellow(result.message));
   721→    console.log("");
   722→
   723→    for (const issue of result.issues) {
   724→      const icon =
   725→        issue.type === "uncommitted_changes"
   726→          ? chalk.yellow("⚠")
   727→          : issue.type === "in_progress_task"
   728→            ? chalk.blue("●")
   729→            : chalk.gray("○");
   730→      console.log(`  ${icon} ${issue.description}`);
   731→    }
   732→
   733→    if (result.instructions.length > 0) {
   734→      console.log("");
   735→      for (const instruction of result.instructions) {
   736→        console.log(chalk.gray(instruction));
   737→      }
   738→    }
   739→  }
   740→}
   741→
   742→function formatSessionContext(
   743→  ctx: SessionContext,
   744→  options: SessionOptions,
   745→): void {
   746→  const isBrief = !options.full;
   747→
   748→  // Header
   749→  console.log(`\n${sessionHeaders.title}`);
   750→  const age = formatRelativeTime(new Date(ctx.generated_at));
   751→  if (ctx.branch) {
   752→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   753→  } else {
   754→    console.log(chalk.gray(`Generated: ${age}`));
   755→  }
   756→
   757→  // Stats summary
   758→  const pendingReviewNote =
   759→    ctx.stats.pending_review > 0
   760→      ? `${ctx.stats.pending_review} awaiting review, `
   761→      : "";
   762→  const inboxNote =
   763→    ctx.stats.inbox_items > 0 ? ` | Inbox: ${ctx.stats.inbox_items}` : "";
   764→  console.log(
   765→    chalk.gray(
   766→      `Tasks: ${ctx.stats.in_progress} active, ${pendingReviewNote}${ctx.stats.ready} ready, ` +
   767→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`,
   768→    ),
   769→  );
   770→
   771→  // Session context section (focus, threads, questions)
   772→  if (
   773→    ctx.context &&
   774→    (ctx.context.focus ||
   775→      ctx.context.threads.length > 0 ||
   776→      ctx.context.open_questions.length > 0)
   777→  ) {
   778→    console.log("\n--- Session Context ---");
   779→
   780→    if (ctx.context.focus) {
   781→      console.log(`  ${chalk.cyan("Focus:")} ${ctx.context.focus}`);
   782→    }
   783→
   784→    if (ctx.context.threads.length > 0) {
   785→      console.log(`  ${chalk.cyan("Active Threads:")}`);
   786→      for (const thread of ctx.context.threads) {
   787→        console.log(`    - ${thread}`);
   788→      }
   789→    }
   790→
   791→    if (ctx.context.open_questions.length > 0) {
   792→      console.log(`  ${chalk.cyan("Open Questions:")}`);
   793→      for (const question of ctx.context.open_questions) {
   794→        console.log(`    - ${question}`);
   795→      }
   796→    }
   797→  }
   798→
   799→  // Active tasks section
   800→  if (ctx.active_tasks.length > 0) {
   801→    console.log(`\n${sessionHeaders.activeWork}`);
   802→    for (const task of ctx.active_tasks) {
   803→      const started = task.started_at
   804→        ? chalk.gray(
   805→            ` (started ${formatRelativeTime(new Date(task.started_at))})`,
   806→          )
   807→        : "";
   808→      const priority =
   809→        task.priority <= 2
   810→          ? chalk.red(`P${task.priority}`)
   811→          : chalk.gray(`P${task.priority}`);
   812→      console.log(
   813→        `  ${chalk.blue("[in_progress]")} ${priority} ${task.ref} ${task.title}${started}`,
   814→      );
   815→    }
   816→  } else {
   817→    console.log(`\n${sessionHeaders.noActiveWork}`);
   818→  }
   819→
   820→  // Awaiting review section
   821→  if (ctx.pending_review_tasks.length > 0) {
   822→    console.log(`\n${sessionHeaders.awaitingReview}`);
   823→    for (const task of ctx.pending_review_tasks) {
   824→      const priority =
   825→        task.priority <= 2
   826→          ? chalk.red(`P${task.priority}`)
   827→          : chalk.gray(`P${task.priority}`);
   828→      console.log(
   829→        `  ${chalk.yellow("[pending_review]")} ${priority} ${task.ref} ${task.title}`,
   830→      );
   831→    }
   832→  }
   833→
   834→  // Recently completed section
   835→  if (ctx.recently_completed.length > 0) {
   836→    console.log(`\n${sessionHeaders.recentlyCompleted}`);
   837→    const observationPromotedTasks: string[] = [];
   838→    for (const task of ctx.recently_completed) {
   839→      const completedAge = formatRelativeTime(new Date(task.completed_at));
   840→      let reason = "";
   841→      if (task.closed_reason) {
   842→        const maxLen = isBrief ? 60 : 120;
   843→        const truncated =
   844→          task.closed_reason.length > maxLen
   845→            ? `${task.closed_reason.slice(0, maxLen).trim()}...`
   846→            : task.closed_reason;
   847→        reason = chalk.gray(` - ${truncated}`);
   848→      }
   849→      console.log(
   850→        `  ${chalk.green("[completed]")} ${task.ref} ${task.title} ${chalk.gray(`(${completedAge})`)}${reason}`,
   851→      );
   852→
   853→      // Track tasks that came from observations
   854→      if (task.origin === "observation_promotion") {
   855→        observationPromotedTasks.push(task.ref);
   856→      }
   857→    }
   858→
   859→    // Show reminder about resolving observations
   860→    if (observationPromotedTasks.length > 0) {
   861→      console.log(
   862→        chalk.yellow(
   863→          `\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(", ")}`,
   864→        ),
   865→      );
   866→      console.log(
   867→        chalk.gray(`    Run: kspec meta observations --pending-resolution`),
   868→      );
   869→    }
   870→  }
   871→
   872→  // Recent notes section
   873→  if (ctx.recent_notes.length > 0) {
   874→    console.log(`\n${sessionHeaders.recentNotes}`);
   875→    for (const note of ctx.recent_notes) {
   876→      const age = formatRelativeTime(new Date(note.created_at));
   877→      const author = note.author ? chalk.gray(` by ${note.author}`) : "";
   878→      console.log(`  ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
   879→
   880→      // Truncate content in brief mode
   881→      let content = note.content.trim();
   882→      if (isBrief && content.length > 200) {
   883→        content = `${content.slice(0, 200).trim()}...`;
   884→      }
   885→
   886→      // Indent content, limit lines in brief mode
   887→      const lines = content.split("\n");
   888→      const maxLines = isBrief ? 3 : lines.length;
   889→      for (const line of lines.slice(0, maxLines)) {
   890→        console.log(`    ${chalk.white(line)}`);
   891→      }
   892→      if (isBrief && lines.length > maxLines) {
   893→        console.log(
   894→          chalk.gray(`    ... (${lines.length - maxLines} more lines)`),
   895→        );
   896→      }
   897→    }
   898→  }
   899→
   900→  // Incomplete todos section
   901→  if (ctx.active_todos.length > 0) {
   902→    console.log(`\n${sessionHeaders.incompleteTodos}`);
   903→    for (const todo of ctx.active_todos) {
   904→      console.log(
   905→        `  ${chalk.yellow("[ ]")} ${todo.task_ref}#${todo.id}: ${todo.text}`,
   906→      );
   907→    }
   908→  }
   909→
   910→  // Ready tasks section
   911→  if (ctx.ready_tasks.length > 0) {
   912→    console.log(`\n${sessionHeaders.readyTasks}`);
   913→    for (const task of ctx.ready_tasks) {
   914→      const priority =
   915→        task.priority <= 2
   916→          ? chalk.red(`P${task.priority}`)
   917→          : chalk.gray(`P${task.priority}`);
   918→      const tags =
   919→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(" #")}`) : "";
   920→      console.log(`  ${priority} ${task.ref} ${task.title}${tags}`);
   921→    }
   922→  }
   923→
   924→  // Blocked tasks section
   925→  if (ctx.blocked_tasks.length > 0) {
   926→    console.log(`\n${sessionHeaders.blocked}`);
   927→    for (const task of ctx.blocked_tasks) {
   928→      console.log(`  ${chalk.red("[blocked]")} ${task.ref} ${task.title}`);
   929→      if (task.blocked_by.length > 0) {
   930→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(", ")}`));
   931→      }
   932→      if (task.unmet_deps.length > 0) {
   933→        console.log(
   934→          chalk.gray(`    Waiting on: ${task.unmet_deps.join(", ")}`),
   935→        );
   936→      }
   937→    }
   938→  }
   939→
   940→  // Git commits section
   941→  if (ctx.recent_commits.length > 0) {
   942→    console.log(`\n${sessionHeaders.recentCommits}`);
   943→    for (const commit of ctx.recent_commits) {
   944→      const age = formatRelativeTime(new Date(commit.date));
   945→      console.log(
   946→        `  ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${age}, ${commit.author})`)}`,
   947→      );
   948→    }
   949→  }
   950→
   951→  // Inbox section (oldest first to encourage triage)
   952→  if (ctx.inbox_items.length > 0) {
   953→    console.log(`\n${sessionHeaders.inbox}`);
   954→    for (const item of ctx.inbox_items) {
   955→      const age = formatRelativeTime(new Date(item.created_at));
   956→      const author = item.added_by ? ` by ${item.added_by}` : "";
   957→      const tags =
   958→        item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(", ")}]`) : "";
   959→      // Truncate text in brief mode
   960→      let text = item.text;
   961→      if (isBrief && text.length > 60) {
   962→        text = `${text.slice(0, 60).trim()}...`;
   963→      }
   964→      console.log(
   965→        `  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`,
   966→      );
   967→      console.log(`    ${text}`);
   968→    }
   969→    console.log(`  ${hints.inboxPromote}`);
   970→  }
   971→
   972→  // Working tree section
   973→  if (ctx.working_tree && !ctx.working_tree.clean) {
   974→    console.log(`\n${sessionHeaders.workingTree}`);
   975→
   976→    if (ctx.working_tree.staged.length > 0) {
   977→      console.log(chalk.green("  Staged:"));
   978→      for (const file of ctx.working_tree.staged) {
   979→        console.log(
   980→          `    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`,
   981→        );
   982→      }
   983→    }
   984→
   985→    if (ctx.working_tree.unstaged.length > 0) {
   986→      console.log(chalk.red("  Modified:"));
   987→      for (const file of ctx.working_tree.unstaged) {
   988→        console.log(
   989→          `    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`,
   990→        );
   991→      }
   992→    }
   993→
   994→    if (ctx.working_tree.untracked.length > 0) {
   995→      console.log(chalk.gray("  Untracked:"));
   996→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
   997→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
   998→        console.log(`    ${chalk.gray("?")} ${path}`);
   999→      }
  1000→      if (isBrief && ctx.working_tree.untracked.length > limit) {
  1001→        console.log(
  1002→          chalk.gray(
  1003→            `    ... and ${ctx.working_tree.untracked.length - limit} more`,
  1004→          ),
  1005→        );
  1006→      }
  1007→    }
  1008→  } else if (ctx.working_tree?.clean) {
  1009→    console.log(`\n${sessionHeaders.workingTreeClean}`);
  1010→  }
  1011→
  1012→  // Quick Commands section - contextual hints based on state
  1013→  const quickCommands: string[] = [];
  1014→
  1015→  if (ctx.active_tasks.length > 0) {
  1016→    const ref = ctx.active_tasks[0].ref;
  1017→    quickCommands.push(
  1018→      `kspec task note @${ref} "Progress..."  ${chalk.gray("# document work")}`,
  1019→    );
  1020→    quickCommands.push(
  1021→      `kspec task complete @${ref} --reason "..."  ${chalk.gray("# finish task")}`,
  1022→    );
  1023→  } else if (ctx.ready_tasks.length > 0) {
  1024→    const ref = ctx.ready_tasks[0].ref;
  1025→    quickCommands.push(
  1026→      `kspec task start @${ref}  ${chalk.gray("# begin work")}`,
  1027→    );
  1028→  }
  1029→
  1030→  if (ctx.inbox_items.length > 0) {
  1031→    const ref = ctx.inbox_items[0].ref;
  1032→    quickCommands.push(
  1033→      `kspec inbox promote @${ref} --title "..."  ${chalk.gray("# convert to task")}`,
  1034→    );
  1035→  }
  1036→
  1037→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1038→    quickCommands.push(
  1039→      `git add . && git commit -m "..."  ${chalk.gray("# commit changes")}`,
  1040→    );
  1041→  }
  1042→
  1043→  if (quickCommands.length > 0) {
  1044→    console.log(`\n${sessionHeaders.quickCommands}`);
  1045→    for (const hint of quickCommands) {
  1046→      console.log(`  ${hint}`);
  1047→    }
  1048→  }
  1049→
  1050→  console.log(""); // Final newline
  1051→}
  1052→
  1053→// ─── Command Registration ────────────────────────────────────────────────────
  1054→
  1055→async function sessionStartAction(options: SessionOptions): Promise<void> {
  1056→  try {
  1057→    const ctx = await initContext();
  1058→
  1059→    // AC: @shadow-sync ac-2 - Pull remote changes before showing session context
  1060→    let syncResult: ShadowSyncResult | null = null;
  1061→    if (ctx.shadow?.enabled) {
  1062→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
  1063→      // AC: @shadow-sync ac-3 - Warn about conflicts but continue with local state
  1064→      if (syncResult.hadConflict) {
  1065→        console.log(
  1066→          chalk.yellow(
  1067→            "⚠ Shadow sync conflict detected. Run `kspec shadow resolve` to fix.",
  1068→          ),
  1069→        );
  1070→        console.log(chalk.gray("  Continuing with local state..."));
  1071→        console.log("");
  1072→      } else if (syncResult.pulled) {
  1073→        console.log(chalk.gray("ℹ Synced shadow branch from remote"));
  1074→      }
  1075→    }
  1076→
  1077→    const sessionCtx = await gatherSessionContext(ctx, options);
  1078→
  1079→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
  1080→  } catch (err) {
  1081→    error(errors.failures.gatherSessionContext, err);
  1082→    process.exit(EXIT_CODES.ERROR);
  1083→  }
  1084→}
  1085→
  1086→/**
  1087→ * Read stdin if available (non-blocking check for hook input)
  1088→ */
  1089→async function readStdinIfAvailable(): Promise<string | null> {
  1090→  // Check if stdin is a TTY (interactive) - if so, don't try to read
  1091→  if (process.stdin.isTTY) {
  1092→    return null;
  1093→  }
  1094→
  1095→  return new Promise((resolve) => {
  1096→    let data = "";
  1097→    const timeout = setTimeout(() => {
  1098→      process.stdin.removeAllListeners();
  1099→      resolve(data || null);
  1100→    }, 100); // 100ms timeout for stdin
  1101→
  1102→    process.stdin.setEncoding("utf8");
  1103→    process.stdin.on("data", (chunk) => {
  1104→      data += chunk;
  1105→    });
  1106→    process.stdin.on("end", () => {
  1107→      clearTimeout(timeout);
  1108→      resolve(data || null);
  1109→    });
  1110→    process.stdin.on("error", () => {
  1111→      clearTimeout(timeout);
  1112→      resolve(null);
  1113→    });
  1114→    process.stdin.resume();
  1115→  });
  1116→}
  1117→
  1118→/**
  1119→ * Parse Claude Code hook input from stdin
  1120→ */
  1121→function parseHookInput(stdin: string | null): StopHookInput | null {
  1122→  if (!stdin) return null;
  1123→  try {
  1124→    return JSON.parse(stdin.trim()) as StopHookInput;
  1125→  } catch {
  1126→    return null;
  1127→  }
  1128→}
  1129→
  1130→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
  1131→
  1132→/**
  1133→ * Output spec-first reminder for UserPromptSubmit hook.
  1134→ *
  1135→ * This is a simple context injection - always outputs the reminder,
  1136→ * and Claude (Opus) is smart enough to apply it when relevant.
  1137→ */
  1138→async function sessionPromptCheckAction(): Promise<void> {
  1139→  // Lean, instructive reminder with kspec prefix
  1140→  console.log(sessionPrompt.specCheck);
  1141→}
  1142→
  1143→async function sessionCheckpointAction(
  1144→  options: CheckpointOptions,
  1145→): Promise<void> {
  1146→  try {
  1147→    // Read stdin for Claude Code hook input
  1148→    const stdin = await readStdinIfAvailable();
  1149→    const hookInput = parseHookInput(stdin);
  1150→
  1151→    // Check if this is a retry (stop hook already active)
  1152→    if (hookInput?.stop_hook_active) {
  1153→      options.stopHookActive = true;
  1154→    }
  1155→
  1156→    const ctx = await initContext();
  1157→    const result = await performCheckpoint(ctx, options);
  1158→
  1159→    // Output format depends on mode:
  1160→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
  1161→    // - Human mode: Output formatted checkpoint result
  1162→    if (isJsonMode()) {
  1163→      if (!result.ok) {
  1164→        // Build reason message with issues and instructions
  1165→        const issueLines = result.issues
  1166→          .map((i) => `- ${i.description}`)
  1167→          .join("\n");
  1168→        const instructionLines = result.instructions
  1169→          .filter((i) => i.trim())
  1170→          .join("\n");
  1171→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
  1172→        console.log(JSON.stringify({ decision: "block", reason }));
  1173→      }
  1174→      // If ok, exit silently (Claude Code expects no output when allowing stop)
  1175→    } else {
  1176→      formatCheckpointResult(result);
  1177→      if (!result.ok) {
  1178→        process.exit(EXIT_CODES.ERROR);
  1179→      }
  1180→    }
  1181→  } catch (err) {
  1182→    // Handle RUNNING_FROM_SHADOW gracefully - skip with warning instead of erroring
  1183→    // This happens when the stop hook runs while cwd is inside .kspec/ directory
  1184→    if (err instanceof ShadowError && err.code === "RUNNING_FROM_SHADOW") {
  1185→      if (!isJsonMode()) {
  1186→        console.log(
  1187→          chalk.yellow(
  1188→            "[kspec] Session checkpoint skipped - running from inside .kspec/ directory",
  1189→          ),
  1190→        );
  1191→      }
  1192→      // Allow stop to proceed (exit successfully, no JSON output blocks the stop)
  1193→      return;
  1194→    }
  1195→    error(errors.failures.runCheckpoint, err);
  1196→    process.exit(EXIT_CODES.ERROR);
  1197→  }
  1198→}
  1199→
  1200→// ─── Session Log List ─────────────────────────────────────────────────────────
  1201→
  1202→interface SessionLogListOptions {
  1203→  status?: string;
  1204→  agent?: string;
  1205→  since?: string;
  1206→  sort?: string;
  1207→  count?: boolean;
  1208→  limit?: string;
  1209→}
  1210→
  1211→type SortField =
  1212→  | "started_at"
  1213→  | "duration"
  1214→  | "events"
  1215→  | "iterations"
  1216→  | "tasks_completed";
  1217→
  1218→const VALID_SORT_FIELDS: SortField[] = [
  1219→  "started_at",
  1220→  "duration",
  1221→  "events",
  1222→  "iterations",
  1223→  "tasks_completed",
  1224→];
  1225→
  1226→/**
  1227→ * Format a duration in milliseconds to a human-readable string.
  1228→ */
  1229→function formatDuration(ms: number): string {
  1230→  if (ms < 0) return "—";
  1231→  const totalSec = Math.floor(ms / 1000);
  1232→  const hours = Math.floor(totalSec / 3600);
  1233→  const minutes = Math.floor((totalSec % 3600) / 60);
  1234→  if (hours > 0) {
  1235→    return `${hours}h ${minutes}m`;
  1236→  }
  1237→  if (minutes > 0) {
  1238→    return `${minutes}m`;
  1239→  }
  1240→  return `${totalSec}s`;
  1241→}
  1242→
  1243→/**
  1244→ * Sort session summaries by the specified field.
  1245→ * Default: started_at descending.
  1246→ *
  1247→ * AC: @session-log-list ac-5
  1248→ */
  1249→function sortSessions(
  1250→  sessions: SessionLogSummary[],
  1251→  sortField: SortField,
  1252→): SessionLogSummary[] {
  1253→  return [...sessions].sort((a, b) => {
  1254→    switch (sortField) {
  1255→      case "started_at":
  1256→        return (
  1257→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1258→        );
  1259→      case "duration":
  1260→        return b.duration_ms - a.duration_ms;
  1261→      case "events":
  1262→        return b.event_count - a.event_count;
  1263→      case "iterations":
  1264→        return b.iteration_count - a.iteration_count;
  1265→      case "tasks_completed":
  1266→        return b.tasks_completed - a.tasks_completed;
  1267→      default:
  1268→        return (
  1269→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1270→        );
  1271→    }
  1272→  });
  1273→}
  1274→
  1275→/**
  1276→ * Format the session log list as a table.
  1277→ *
  1278→ * AC: @session-log-list ac-1
  1279→ */
  1280→function formatSessionLogList(sessions: SessionLogSummary[]): void {
  1281→  if (sessions.length === 0) {
  1282→    // AC: @session-log-list ac-6
  1283→    console.log("No sessions found.");
  1284→    return;
  1285→  }
  1286→
  1287→  // Table header
  1288→  console.log(
  1289→    chalk.gray(
  1290→      `${"ID".padEnd(10)} ${"Status".padEnd(11)} ${"Agent".padEnd(20)} ${"Started".padEnd(16)} ${"Duration".padEnd(10)} ${"Events".padEnd(8)} ${"Iters".padEnd(7)} Tasks`,
  1291→    ),
  1292→  );
  1293→  console.log(chalk.gray("─".repeat(95)));
  1294→
  1295→  for (const s of sessions) {
  1296→    const id = s.id.slice(0, 8);
  1297→    const statusColor =
  1298→      s.status === "completed"
  1299→        ? chalk.green
  1300→        : s.status === "active"
  1301→          ? chalk.blue
  1302→          : chalk.yellow;
  1303→    const status = statusColor(s.status.padEnd(11));
  1304→    const agent = s.agent_type.slice(0, 20).padEnd(20);
  1305→    const started = formatRelativeTime(new Date(s.started_at)).padEnd(16);
  1306→    const duration = formatDuration(s.duration_ms).padEnd(10);
  1307→    const events = String(s.event_count).padEnd(8);
  1308→    const iters = String(s.iteration_count).padEnd(7);
  1309→    const tasks = String(s.tasks_completed);
  1310→
  1311→    console.log(
  1312→      `${chalk.yellow(id)} ${status} ${chalk.gray(agent)} ${chalk.gray(started)} ${duration} ${events} ${iters} ${tasks}`,
  1313→    );
  1314→  }
  1315→
  1316→  console.log(chalk.gray(`\n${sessions.length} session(s)`));
  1317→}
  1318→
  1319→/**
  1320→ * Session log list action handler.
  1321→ */
  1322→async function sessionLogListAction(
  1323→  options: SessionLogListOptions,
  1324→): Promise<void> {
  1325→  try {
  1326→    const ctx = await initContext();
  1327→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1328→
  1329→    // AC: @session-log-list ac-2 - Filter by status
  1330→    if (options.status) {
  1331→      const statusFilter = options.status as SessionStatus;
  1332→      sessions = sessions.filter((s) => s.status === statusFilter);
  1333→    }
  1334→
  1335→    // AC: @session-log-list ac-4 - Filter by agent type
  1336→    if (options.agent) {
  1337→      const agentFilter = options.agent;
  1338→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1339→    }
  1340→
  1341→    // AC: @session-log-list ac-3 - Filter by since date
  1342→    if (options.since) {
  1343→      const sinceDate = parseTimeSpec(options.since);
  1344→      if (sinceDate) {
  1345→        sessions = sessions.filter(
  1346→          (s) => new Date(s.started_at) >= sinceDate,
  1347→        );
  1348→      }
  1349→    }
  1350→
  1351→    // AC: @session-log-list ac-5 - Sort
  1352→    const sortField: SortField =
  1353→      options.sort && VALID_SORT_FIELDS.includes(options.sort as SortField)
  1354→        ? (options.sort as SortField)
  1355→        : "started_at";
  1356→    sessions = sortSessions(sessions, sortField);
  1357→
  1358→    // AC: @session-log-list ac-7 - Limit output count
  1359→    if (options.count) {
  1360→      // AC: @trait-filterable-list ac-8
  1361→      output({ count: sessions.length }, () => {
  1362→        console.log(sessions.length);
  1363→      });
  1364→      return;
  1365→    }
  1366→
  1367→    // Apply --limit (after filtering/sorting, before display)
  1368→    if (options.limit) {
  1369→      const limit = parseInt(options.limit, 10);
  1370→      if (!Number.isNaN(limit) && limit > 0) {
  1371→        sessions = sessions.slice(0, limit);
  1372→      }
  1373→    }
  1374→
  1375→    output(sessions, () => formatSessionLogList(sessions));
  1376→  } catch (err) {
  1377→    error("Failed to list session logs", err);
  1378→    process.exit(EXIT_CODES.ERROR);
  1379→  }
  1380→}
  1381→
  1382→/**
  1383→ * Register the 'session' command group and aliases
  1384→ */
  1385→export function registerSessionCommands(program: Command): void {
  1386→  const session = program
  1387→    .command("session")
  1388→    .description("Session management and context");
  1389→
  1390→  session
  1391→    .command("start")
  1392→    .alias("resume")
  1393→    .description("Surface relevant context for starting a new working session")
  1394→    .option("--brief", "Compact summary (default)")
  1395→    .option("--full", "Comprehensive context dump")
  1396→    .option(
  1397→      "--since <time>",
  1398→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  1399→    )
  1400→    .option("--no-git", "Skip git commit information")
  1401→    .option("-n, --limit <n>", "Limit items per section", "10")
  1402→    .action(sessionStartAction);
  1403→
  1404→  // Session log subcommand group
  1405→  const log = session
  1406→    .command("log")
  1407→    .description("Session log analysis commands");
  1408→
  1409→  log
  1410→    .command("list")
  1411→    .description("List session logs with summary statistics")
  1412→    .option(
  1413→      "-s, --status <status>",
  1414→      "Filter by status (active, completed, abandoned)",
  1415→    )
  1416→    .option("--agent <type>", "Filter by agent type")
  1417→    .option(
  1418→      "--since <time>",
  1419→      "Only show sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  1420→    )
  1421→    .option(
  1422→      "--sort <field>",
  1423→      "Sort by field (started_at, duration, events, iterations, tasks_completed)",
  1424→      "started_at",
  1425→    )
  1426→    .option("--count", "Show only the count of matching sessions")
  1427→    .option("-n, --limit <n>", "Limit number of sessions shown")
  1428→    .action(sessionLogListAction);
  1429→
  1430→  session
  1431→    .command("checkpoint")
  1432→    .description(
  1433→      "Pre-stop hook: check for uncommitted work before ending session",
  1434→    )
  1435→    .option("--force", "Allow session end regardless of issues")
  1436→    .action(sessionCheckpointAction);
  1437→
  1438→  session
  1439→    .command("prompt-check")
  1440→    .description("UserPromptSubmit hook: inject spec-first reminder")
  1441→    .action(sessionPromptCheckAction);
  1442→
  1443→  // Top-level alias: kspec context
  1444→  program
  1445→    .command("context")
  1446→    .description("Alias for session start - surface session context")
  1447→    .option("--brief", "Compact summary (default)")
  1448→    .option("--full", "Comprehensive context dump")
  1449→    .option(
  1450→      "--since <time>",
  1451→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  1452→    )
  1453→    .option("--no-git", "Skip git commit information")
  1454→    .option("-n, --limit <n>", "Limit items per section", "10")
  1455→    .action(sessionStartAction);
  1456→}
