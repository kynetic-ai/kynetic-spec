     1→import { execSync } from "node:child_process";
     2→import * as fs from "node:fs/promises";
     3→import * as path from "node:path";
     4→import { ulid } from "ulid";
     5→import * as YAML from "yaml";
     6→import {
     7→  InboxFileSchema,
     8→  type InboxItem,
     9→  type InboxItemInput,
    10→  InboxItemSchema,
    11→  type Manifest,
    12→  ManifestSchema,
    13→  type Note,
    14→  type SpecItem,
    15→  type SpecItemInput,
    16→  SpecItemSchema,
    17→  type Task,
    18→  type TaskInput,
    19→  TaskSchema,
    20→  TasksFileSchema,
    21→  type Todo,
    22→} from "../schema/index.js";
    23→import { errors } from "../strings/index.js";
    24→import { ItemIndex } from "./items.js";
    25→import { ReferenceIndex } from "./refs.js";
    26→import {
    27→  detectRunningFromShadowWorktree,
    28→  detectShadow,
    29→  type ShadowConfig,
    30→  ShadowError,
    31→} from "./shadow.js";
    32→import { TraitIndex } from "./traits.js";
    33→
    34→/**
    35→ * Spec item with runtime metadata for source tracking.
    36→ * _sourceFile is not serialized - it's used to know where to write updates.
    37→ * _path tracks location within the file for nested items (e.g., "features[0].requirements[2]")
    38→ */
    39→export interface LoadedSpecItem extends SpecItem {
    40→  _sourceFile?: string;
    41→  _path?: string;
    42→}
    43→
    44→/**
    45→ * Task with runtime metadata for source tracking.
    46→ * _sourceFile is not serialized - it's used to know where to write updates.
    47→ */
    48→export interface LoadedTask extends Task {
    49→  _sourceFile?: string;
    50→}
    51→
    52→/**
    53→ * Parse YAML content into an object
    54→ * Uses the modern yaml library which has consistent type handling
    55→ */
    56→export function parseYaml<T>(content: string): T {
    57→  return YAML.parse(content) as T;
    58→}
    59→
    60→/**
    61→ * Serialize object to YAML
    62→ * Uses the modern yaml library for consistent formatting.
    63→ *
    64→ * WORKAROUND: The 'yaml' library (v2.8.2+) has a known behavior where block scalars
    65→ * containing whitespace-only lines accumulate extra blank lines on each parse-stringify
    66→ * cycle. The library's blockString() function adds indentation after newlines, which
    67→ * causes lines containing only spaces to grow. We post-process the output to filter
    68→ * these whitespace-only lines. See: https://github.com/eemeli/yaml - stringifyString.ts
    69→ */
    70→export function toYaml(obj: unknown): string {
    71→  let yamlString = YAML.stringify(obj, {
    72→    indent: 2,
    73→    lineWidth: 100,
    74→    sortMapEntries: false,
    75→  });
    76→
    77→  // Post-process to fix yaml library blank line accumulation bug.
    78→  // Filter out lines that contain only spaces/tabs (not truly empty lines).
    79→  yamlString = yamlString
    80→    .split("\n")
    81→    .filter((line) => !/^[ \t]+$/.test(line))
    82→    .join("\n");
    83→
    84→  return yamlString;
    85→}
    86→
    87→/**
    88→ * Read and parse a YAML file
    89→ */
    90→export async function readYamlFile<T>(filePath: string): Promise<T> {
    91→  const content = await fs.readFile(filePath, "utf-8");
    92→  return parseYaml<T>(content);
    93→}
    94→
    95→/**
    96→ * Write object to YAML file
    97→ */
    98→export async function writeYamlFile(
    99→  filePath: string,
   100→  data: unknown,
   101→): Promise<void> {
   102→  const content = toYaml(data);
   103→  await fs.writeFile(filePath, content, "utf-8");
   104→}
   105→
   106→/**
   107→ * Write object to YAML file while preserving formatting and comments.
   108→ *
   109→ * Note: This function is now equivalent to writeYamlFile() - the "preserve format"
   110→ * naming is historical. Both use toYaml() which includes the whitespace-only line
   111→ * fix. Kept for backwards compatibility with existing callers.
   112→ */
   113→export async function writeYamlFilePreserveFormat(
   114→  filePath: string,
   115→  data: unknown,
   116→): Promise<void> {
   117→  const content = toYaml(data);
   118→  await fs.writeFile(filePath, content, "utf-8");
   119→}
   120→
   121→/**
   122→ * Find task files in a directory
   123→ */
   124→export async function findTaskFiles(dir: string): Promise<string[]> {
   125→  const files: string[] = [];
   126→
   127→  try {
   128→    const entries = await fs.readdir(dir, { withFileTypes: true });
   129→
   130→    for (const entry of entries) {
   131→      const fullPath = path.join(dir, entry.name);
   132→
   133→      if (entry.isDirectory()) {
   134→        // Recurse into subdirectories
   135→        const subFiles = await findTaskFiles(fullPath);
   136→        files.push(...subFiles);
   137→      } else if (entry.isFile() && entry.name.endsWith(".tasks.yaml")) {
   138→        files.push(fullPath);
   139→      }
   140→    }
   141→  } catch (_error) {
   142→    // Directory doesn't exist or not readable
   143→  }
   144→
   145→  return files;
   146→}
   147→
   148→/**
   149→ * Find the manifest file.
   150→ *
   151→ * Discovery algorithm per directory:
   152→ * 1. Check for explicit names: kynetic.yaml, kynetic.spec.yaml (backward compat)
   153→ * 2. If not found, scan for *.yaml files with 'kynetic:' version field
   154→ *
   155→ * Searches current dir, then spec/ subdir, then parent directories.
   156→ */
   157→export async function findManifest(startDir: string): Promise<string | null> {
   158→  let dir = startDir;
   159→
   160→  while (true) {
   161→    // Check current directory
   162→    const manifestInDir = await findManifestInDir(dir);
   163→    if (manifestInDir) {
   164→      return manifestInDir;
   165→    }
   166→
   167→    // Also check in spec/ subdirectory
   168→    const specDir = path.join(dir, "spec");
   169→    try {
   170→      const stat = await fs.stat(specDir);
   171→      if (stat.isDirectory()) {
   172→        const manifestInSpec = await findManifestInDir(specDir);
   173→        if (manifestInSpec) {
   174→          return manifestInSpec;
   175→        }
   176→      }
   177→    } catch {
   178→      // spec/ doesn't exist
   179→    }
   180→
   181→    const parentDir = path.dirname(dir);
   182→    if (parentDir === dir) {
   183→      // Reached root
   184→      return null;
   185→    }
   186→    dir = parentDir;
   187→  }
   188→}
   189→
   190→/**
   191→ * Context for working with spec/task files.
   192→ *
   193→ * When shadow branch is enabled:
   194→ * - rootDir points to the project root (where .kspec/ lives)
   195→ * - specDir points to .kspec/ (where spec files are read/written)
   196→ * - All file operations use specDir for resolution
   197→ *
   198→ * Without shadow branch:
   199→ * - rootDir is the project root
   200→ * - specDir is rootDir/spec/ (traditional layout)
   201→ */
   202→export interface KspecContext {
   203→  /** Project root directory */
   204→  rootDir: string;
   205→  /** Spec files directory (.kspec/ when shadow enabled, otherwise spec/) */
   206→  specDir: string;
   207→  /** Path to manifest file */
   208→  manifestPath: string | null;
   209→  /** Parsed manifest */
   210→  manifest: Manifest | null;
   211→  /** Shadow branch configuration (null if not using shadow) */
   212→  shadow: ShadowConfig | null;
   213→}
   214→
   215→/**
   216→ * Initialize context by finding manifest.
   217→ *
   218→ * Detection order:
   219→ * 1. Check for shadow branch (.kspec/ directory)
   220→ * 2. Fall back to traditional spec/ directory
   221→ *
   222→ * When shadow is detected, all operations use .kspec/ as specDir.
   223→ */
   224→export async function initContext(startDir?: string): Promise<KspecContext> {
   225→  // KSPEC_SPEC_DIR override: used by batch atomic mode to redirect to temp copy
   226→  const specDirOverride = process.env.KSPEC_SPEC_DIR;
   227→  if (specDirOverride) {
   228→    const specDir = path.resolve(specDirOverride);
   229→    const manifestPath = await findManifestInDir(specDir);
   230→
   231→    let manifest: Manifest | null = null;
   232→    if (manifestPath) {
   233→      try {
   234→        const rawManifest = await readYamlFile<unknown>(manifestPath);
   235→        manifest = ManifestSchema.parse(rawManifest);
   236→      } catch {
   237→        // Manifest exists but may be invalid
   238→      }
   239→    }
   240→
   241→    return {
   242→      rootDir: path.dirname(specDir),
   243→      specDir,
   244→      manifestPath,
   245→      manifest,
   246→      shadow: null, // No shadow in overridden context
   247→    };
   248→  }
   249→
   250→  const cwd = startDir || process.cwd();
   251→
   252→  // Check if running from inside the shadow worktree
   253→  const mainProjectRoot = await detectRunningFromShadowWorktree(cwd);
   254→  if (mainProjectRoot) {
   255→    throw new ShadowError(
   256→      errors.project.runningFromShadow,
   257→      "RUNNING_FROM_SHADOW",
   258→      `Run from project root: cd ${path.relative(cwd, mainProjectRoot) || mainProjectRoot}`,
   259→    );
   260→  }
   261→
   262→  // Try to detect shadow branch first
   263→  const shadow = await detectShadow(cwd);
   264→
   265→  if (shadow?.enabled) {
   266→    // Shadow mode: use .kspec/ for everything
   267→    const specDir = shadow.worktreeDir;
   268→    const manifestPath = await findManifestInDir(specDir);
   269→
   270→    let manifest: Manifest | null = null;
   271→    if (manifestPath) {
   272→      try {
   273→        const rawManifest = await readYamlFile<unknown>(manifestPath);
   274→        manifest = ManifestSchema.parse(rawManifest);
   275→      } catch {
   276→        // Manifest exists but may be invalid
   277→      }
   278→    }
   279→
   280→    return {
   281→      rootDir: shadow.projectRoot,
   282→      specDir,
   283→      manifestPath,
   284→      manifest,
   285→      shadow,
   286→    };
   287→  }
   288→
   289→  // Traditional mode: find manifest in spec/ or current directory
   290→  const manifestPath = await findManifest(cwd);
   291→
   292→  let manifest: Manifest | null = null;
   293→  let rootDir = cwd;
   294→  let specDir = cwd;
   295→
   296→  if (manifestPath) {
   297→    const manifestDir = path.dirname(manifestPath);
   298→    // Handle spec/ subdirectory
   299→    if (path.basename(manifestDir) === "spec") {
   300→      rootDir = path.dirname(manifestDir);
   301→      specDir = manifestDir;
   302→    } else {
   303→      rootDir = manifestDir;
   304→      specDir = manifestDir;
   305→    }
   306→
   307→    try {
   308→      const rawManifest = await readYamlFile<unknown>(manifestPath);
   309→      manifest = ManifestSchema.parse(rawManifest);
   310→    } catch {
   311→      // Manifest exists but may be invalid
   312→    }
   313→  }
   314→
   315→  return { rootDir, specDir, manifestPath, manifest, shadow: null };
   316→}
   317→
   318→/**
   319→ * Check if a filename is a potential manifest file.
   320→ * Excludes files with suffixes that indicate other kspec file types.
   321→ *
   322→ * AC: @manifest-discovery ac-5 (excludes task/inbox/meta/runs files)
   323→ */
   324→function isManifestCandidate(filename: string): boolean {
   325→  if (!filename.endsWith(".yaml")) return false;
   326→  const exclusions = [".tasks.yaml", ".inbox.yaml", ".meta.yaml", ".runs.yaml"];
   327→  return !exclusions.some((excl) => filename.endsWith(excl));
   328→}
   329→
   330→/**
   331→ * Find manifest file within a specific directory (no parent traversal).
   332→ * Used for shadow mode where we know exactly where to look.
   333→ *
   334→ * Discovery algorithm:
   335→ * 1. Check for explicit names: kynetic.yaml, kynetic.spec.yaml (backward compat)
   336→ * 2. If not found, scan directory for *.yaml files (excluding other kspec types)
   337→ * 3. For each candidate, validate it contains a 'kynetic:' version field
   338→ * 4. Return first valid match (alphabetically after explicit names)
   339→ *
   340→ * AC: @manifest-discovery ac-1, ac-2, ac-3, ac-4, ac-5
   341→ */
   342→async function findManifestInDir(dir: string): Promise<string | null> {
   343→  // AC: @manifest-discovery ac-1, ac-2 - explicit names have priority
   344→  const priorityCandidates = ["kynetic.yaml", "kynetic.spec.yaml"];
   345→
   346→  for (const candidate of priorityCandidates) {
   347→    const filePath = path.join(dir, candidate);
   348→    try {
   349→      await fs.access(filePath);
   350→      return filePath;
   351→    } catch {
   352→      // File doesn't exist, try next
   353→    }
   354→  }
   355→
   356→  // AC: @manifest-discovery ac-3, ac-4, ac-5 - glob fallback with validation
   357→  try {
   358→    const entries = await fs.readdir(dir);
   359→    // AC: @manifest-discovery ac-4 - alphabetical order
   360→    const candidates = entries.filter(isManifestCandidate).sort();
   361→
   362→    for (const candidate of candidates) {
   363→      const filePath = path.join(dir, candidate);
   364→      try {
   365→        const raw = await readYamlFile<unknown>(filePath);
   366→        // AC: @manifest-discovery ac-5 - validate kynetic version field
   367→        if (raw && typeof raw === "object" && "kynetic" in raw) {
   368→          return filePath;
   369→        }
   370→      } catch {
   371→        // Skip invalid files
   372→      }
   373→    }
   374→  } catch {
   375→    // Directory read failed
   376→  }
   377→
   378→  return null;
   379→}
   380→
   381→/**
   382→ * Load tasks from a single file.
   383→ * Helper function used by loadAllTasks.
   384→ */
   385→async function loadTasksFromFile(filePath: string): Promise<LoadedTask[]> {
   386→  const tasks: LoadedTask[] = [];
   387→
   388→  try {
   389→    const raw = await readYamlFile<unknown>(filePath);
   390→
   391→    // Handle both array format and object format
   392→    let taskList: unknown[];
   393→
   394→    if (Array.isArray(raw)) {
   395→      taskList = raw;
   396→    } else if (raw && typeof raw === "object" && "tasks" in raw) {
   397→      const parsed = TasksFileSchema.safeParse(raw);
   398→      if (parsed.success) {
   399→        // Add _sourceFile to each task from this file
   400→        for (const task of parsed.data.tasks) {
   401→          tasks.push({ ...task, _sourceFile: filePath });
   402→        }
   403→        return tasks;
   404→      }
   405→      taskList = (raw as { tasks: unknown[] }).tasks || [];
   406→    } else {
   407→      // Single task object
   408→      taskList = [raw];
   409→    }
   410→
   411→    for (const taskData of taskList) {
   412→      const result = TaskSchema.safeParse(taskData);
   413→      if (result.success) {
   414→        // Add _sourceFile metadata
   415→        tasks.push({ ...result.data, _sourceFile: filePath });
   416→      }
   417→    }
   418→  } catch {
   419→    // Skip invalid files
   420→  }
   421→
   422→  return tasks;
   423→}
   424→
   425→/**
   426→ * Load all tasks from the project.
   427→ * Each task includes _sourceFile metadata for write-back routing.
   428→ *
   429→ * When shadow is enabled, tasks are loaded from .kspec/ (ctx.specDir).
   430→ * Otherwise, searches in traditional locations (rootDir, spec/, tasks/).
   431→ */
   432→export async function loadAllTasks(ctx: KspecContext): Promise<LoadedTask[]> {
   433→  const tasks: LoadedTask[] = [];
   434→
   435→  // When shadow is enabled, look only in specDir
   436→  if (ctx.shadow?.enabled) {
   437→    const taskFiles = await findTaskFiles(ctx.specDir);
   438→
   439→    // Also check for standalone files in specDir
   440→    const standaloneLocations = [
   441→      path.join(ctx.specDir, "tasks.yaml"),
   442→      path.join(ctx.specDir, "project.tasks.yaml"),
   443→      path.join(ctx.specDir, "kynetic.tasks.yaml"),
   444→      path.join(ctx.specDir, "backlog.tasks.yaml"),
   445→      path.join(ctx.specDir, "active.tasks.yaml"),
   446→    ];
   447→
   448→    for (const loc of standaloneLocations) {
   449→      try {
   450→        await fs.access(loc);
   451→        if (!taskFiles.includes(loc)) {
   452→          taskFiles.push(loc);
   453→        }
   454→      } catch {
   455→        // File doesn't exist
   456→      }
   457→    }
   458→
   459→    // Deduplicate and load
   460→    const uniqueFiles = [...new Set(taskFiles)];
   461→    for (const filePath of uniqueFiles) {
   462→      const fileTasks = await loadTasksFromFile(filePath);
   463→      tasks.push(...fileTasks);
   464→    }
   465→
   466→    return tasks;
   467→  }
   468→
   469→  // Traditional mode: look in multiple locations
   470→  const taskFiles = await findTaskFiles(ctx.rootDir);
   471→
   472→  // Also check common locations
   473→  const additionalPaths = [
   474→    path.join(ctx.rootDir, "tasks"),
   475→    path.join(ctx.rootDir, "spec"),
   476→  ];
   477→
   478→  for (const additionalPath of additionalPaths) {
   479→    const files = await findTaskFiles(additionalPath);
   480→    taskFiles.push(...files);
   481→  }
   482→
   483→  // Also look for standalone tasks.yaml and project.tasks.yaml
   484→  const standaloneLocations = [
   485→    path.join(ctx.rootDir, "tasks.yaml"),
   486→    path.join(ctx.rootDir, "project.tasks.yaml"),
   487→    path.join(ctx.rootDir, "spec", "project.tasks.yaml"),
   488→    path.join(ctx.rootDir, "backlog.tasks.yaml"),
   489→    path.join(ctx.rootDir, "active.tasks.yaml"),
   490→  ];
   491→
   492→  for (const loc of standaloneLocations) {
   493→    try {
   494→      await fs.access(loc);
   495→      if (!taskFiles.includes(loc)) {
   496→        taskFiles.push(loc);
   497→      }
   498→    } catch {
   499→      // File doesn't exist
   500→    }
   501→  }
   502→
   503→  // Deduplicate and load
   504→  const uniqueFiles = [...new Set(taskFiles)];
   505→
   506→  for (const filePath of uniqueFiles) {
   507→    const fileTasks = await loadTasksFromFile(filePath);
   508→    tasks.push(...fileTasks);
   509→  }
   510→
   511→  return tasks;
   512→}
   513→
   514→/**
   515→ * Find a task by reference (ULID, slug, or short reference)
   516→ */
   517→export function findTaskByRef(
   518→  tasks: LoadedTask[],
   519→  ref: string,
   520→): LoadedTask | undefined {
   521→  // Remove @ prefix if present
   522→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   523→
   524→  return tasks.find((task) => {
   525→    // Match full ULID
   526→    if (task._ulid === cleanRef) return true;
   527→
   528→    // Match short ULID (prefix)
   529→    if (task._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
   530→      return true;
   531→
   532→    // Match slug
   533→    if (task.slugs.includes(cleanRef)) return true;
   534→
   535→    return false;
   536→  });
   537→}
   538→
   539→/**
   540→ * Get the default task file path for new tasks without a spec_ref.
   541→ *
   542→ * When shadow enabled: .kspec/project.tasks.yaml
   543→ * Otherwise: spec/project.tasks.yaml
   544→ */
   545→export function getDefaultTaskFilePath(ctx: KspecContext): string {
   546→  return path.join(ctx.specDir, "project.tasks.yaml");
   547→}
   548→
   549→/**
   550→ * Strip runtime metadata before serialization
   551→ */
   552→function stripRuntimeMetadata(task: LoadedTask): Task {
   553→  const { _sourceFile, ...cleanTask } = task;
   554→  return cleanTask as Task;
   555→}
   556→
   557→/**
   558→ * Save a task to its source file (or default location for new tasks).
   559→ * Preserves file format (tasks: [...] wrapper vs plain array).
   560→ */
   561→export async function saveTask(
   562→  ctx: KspecContext,
   563→  task: LoadedTask,
   564→): Promise<void> {
   565→  // Determine target file: use _sourceFile if present, otherwise default
   566→  const taskFilePath = task._sourceFile || getDefaultTaskFilePath(ctx);
   567→
   568→  // Ensure directory exists
   569→  const dir = path.dirname(taskFilePath);
   570→  await fs.mkdir(dir, { recursive: true });
   571→
   572→  // Load existing tasks from the target file
   573→  let existingRaw: unknown = null;
   574→  let useTasksWrapper = false;
   575→
   576→  try {
   577→    existingRaw = await readYamlFile<unknown>(taskFilePath);
   578→    // Detect if file uses { tasks: [...] } format
   579→    if (
   580→      existingRaw &&
   581→      typeof existingRaw === "object" &&
   582→      "tasks" in existingRaw
   583→    ) {
   584→      useTasksWrapper = true;
   585→    }
   586→  } catch {
   587→    // File doesn't exist, start fresh
   588→  }
   589→
   590→  // Parse existing tasks from file
   591→  let fileTasks: Task[] = [];
   592→
   593→  if (existingRaw) {
   594→    if (Array.isArray(existingRaw)) {
   595→      for (const t of existingRaw) {
   596→        const result = TaskSchema.safeParse(t);
   597→        if (result.success) {
   598→          fileTasks.push(result.data);
   599→        }
   600→      }
   601→    } else if (useTasksWrapper) {
   602→      // Try TasksFileSchema first (has kynetic_tasks version)
   603→      const parsed = TasksFileSchema.safeParse(existingRaw);
   604→      if (parsed.success) {
   605→        fileTasks = parsed.data.tasks;
   606→      } else {
   607→        // Fall back to raw tasks array (common format without version field)
   608→        const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   609→        if (Array.isArray(rawTasks)) {
   610→          for (const t of rawTasks) {
   611→            const result = TaskSchema.safeParse(t);
   612→            if (result.success) {
   613→              fileTasks.push(result.data);
   614→            }
   615→          }
   616→        }
   617→      }
   618→    }
   619→  }
   620→
   621→  // Strip runtime metadata before saving
   622→  const cleanTask = stripRuntimeMetadata(task);
   623→
   624→  // Update existing or add new
   625→  const existingIndex = fileTasks.findIndex((t) => t._ulid === task._ulid);
   626→  if (existingIndex >= 0) {
   627→    fileTasks[existingIndex] = cleanTask;
   628→  } else {
   629→    fileTasks.push(cleanTask);
   630→  }
   631→
   632→  // Save in the same format as original (or tasks: wrapper for new files)
   633→  // Use format-preserving write to maintain formatting and comments
   634→  if (useTasksWrapper) {
   635→    await writeYamlFilePreserveFormat(taskFilePath, { tasks: fileTasks });
   636→  } else {
   637→    await writeYamlFilePreserveFormat(taskFilePath, fileTasks);
   638→  }
   639→}
   640→
   641→/**
   642→ * Delete a task from its source file.
   643→ * Requires _sourceFile to know which file to modify.
   644→ */
   645→export async function deleteTask(
   646→  _ctx: KspecContext,
   647→  task: LoadedTask,
   648→): Promise<void> {
   649→  if (!task._sourceFile) {
   650→    throw new Error("Cannot delete task without _sourceFile metadata");
   651→  }
   652→
   653→  const taskFilePath = task._sourceFile;
   654→
   655→  // Load existing file
   656→  let existingRaw: unknown = null;
   657→  let useTasksWrapper = false;
   658→
   659→  try {
   660→    existingRaw = await readYamlFile<unknown>(taskFilePath);
   661→    if (
   662→      existingRaw &&
   663→      typeof existingRaw === "object" &&
   664→      "tasks" in existingRaw
   665→    ) {
   666→      useTasksWrapper = true;
   667→    }
   668→  } catch {
   669→    throw new Error(`Task file not found: ${taskFilePath}`);
   670→  }
   671→
   672→  // Parse existing tasks
   673→  let fileTasks: Task[] = [];
   674→
   675→  if (existingRaw) {
   676→    if (Array.isArray(existingRaw)) {
   677→      for (const t of existingRaw) {
   678→        const result = TaskSchema.safeParse(t);
   679→        if (result.success) {
   680→          fileTasks.push(result.data);
   681→        }
   682→      }
   683→    } else if (useTasksWrapper) {
   684→      const parsed = TasksFileSchema.safeParse(existingRaw);
   685→      if (parsed.success) {
   686→        fileTasks = parsed.data.tasks;
   687→      } else {
   688→        const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   689→        if (Array.isArray(rawTasks)) {
   690→          for (const t of rawTasks) {
   691→            const result = TaskSchema.safeParse(t);
   692→            if (result.success) {
   693→              fileTasks.push(result.data);
   694→            }
   695→          }
   696→        }
   697→      }
   698→    }
   699→  }
   700→
   701→  // Remove the task
   702→  const originalCount = fileTasks.length;
   703→  fileTasks = fileTasks.filter((t) => t._ulid !== task._ulid);
   704→
   705→  if (fileTasks.length === originalCount) {
   706→    throw new Error(`Task not found in file: ${task._ulid}`);
   707→  }
   708→
   709→  // Save the modified file with format preservation
   710→  if (useTasksWrapper) {
   711→    await writeYamlFilePreserveFormat(taskFilePath, { tasks: fileTasks });
   712→  } else {
   713→    await writeYamlFilePreserveFormat(taskFilePath, fileTasks);
   714→  }
   715→}
   716→
   717→/**
   718→ * Create a new task with auto-generated fields
   719→ */
   720→export function createTask(input: TaskInput): Task {
   721→  const now = new Date().toISOString();
   722→
   723→  return {
   724→    ...input,
   725→    _ulid: input._ulid || ulid(),
   726→    slugs: input.slugs || [],
   727→    type: input.type || "task",
   728→    status: input.status || "pending",
   729→    blocked_by: input.blocked_by || [],
   730→    depends_on: input.depends_on || [],
   731→    context: input.context || [],
   732→    priority: input.priority || 3,
   733→    tags: input.tags || [],
   734→    vcs_refs: input.vcs_refs || [],
   735→    created_at: input.created_at || now,
   736→    notes: input.notes || [],
   737→    todos: input.todos || [],
   738→  };
   739→}
   740→
   741→/**
   742→ * Get author from environment with fallback chain.
   743→ * Priority:
   744→ *   1. KSPEC_AUTHOR env var (explicit config, agent-agnostic)
   745→ *   2. git user.name (developer identity)
   746→ *   3. USER/USERNAME env var (system user)
   747→ *   4. undefined (will show as 'unknown' in output)
   748→ *
   749→ * For Claude Code integration, add to ~/.claude/settings.json:
   750→ *   { "env": { "KSPEC_AUTHOR": "@claude" } }
   751→ */
   752→export function getAuthor(): string | undefined {
   753→  // 1. Explicit config (works for any agent)
   754→  if (process.env.KSPEC_AUTHOR) {
   755→    return process.env.KSPEC_AUTHOR;
   756→  }
   757→
   758→  // 2. Git user.name
   759→  try {
   760→    const gitUser = execSync("git config user.name", {
   761→      encoding: "utf-8",
   762→      stdio: ["pipe", "pipe", "ignore"],
   763→    }).trim();
   764→    if (gitUser) {
   765→      return gitUser;
   766→    }
   767→  } catch {
   768→    // git not available or not in a repo
   769→  }
   770→
   771→  // 3. System user
   772→  const systemUser = process.env.USER || process.env.USERNAME;
   773→  if (systemUser) {
   774→    return systemUser;
   775→  }
   776→
   777→  // 4. No author available
   778→  return undefined;
   779→}
   780→
   781→/**
   782→ * Create a new note entry.
   783→ * If author is not provided, attempts to auto-detect from environment.
   784→ */
   785→export function createNote(
   786→  content: string,
   787→  author?: string,
   788→  supersedes?: string,
   789→): Note {
   790→  return {
   791→    _ulid: ulid(),
   792→    created_at: new Date().toISOString(),
   793→    author: author ?? getAuthor(),
   794→    // Trim content to prevent whitespace-only lines from accumulating
   795→    // in block scalars during YAML parse-stringify cycles
   796→    content: content.trim(),
   797→    supersedes: supersedes || null,
   798→  };
   799→}
   800→
   801→/**
   802→ * Create a new todo item.
   803→ * The id should be the next available id for the task's todos array.
   804→ */
   805→export function createTodo(id: number, text: string, addedBy?: string): Todo {
   806→  return {
   807→    id,
   808→    // Trim text to prevent whitespace-only lines from accumulating
   809→    // in block scalars during YAML parse-stringify cycles
   810→    text: text.trim(),
   811→    done: false,
   812→    added_at: new Date().toISOString(),
   813→    added_by: addedBy ?? getAuthor(),
   814→  };
   815→}
   816→
   817→/**
   818→ * Check if task dependencies are met
   819→ */
   820→export function areDependenciesMet(
   821→  task: LoadedTask,
   822→  allTasks: LoadedTask[],
   823→): boolean {
   824→  if (task.depends_on.length === 0) return true;
   825→
   826→  for (const depRef of task.depends_on) {
   827→    const depTask = findTaskByRef(allTasks, depRef);
   828→    if (!depTask || depTask.status !== "completed") {
   829→      return false;
   830→    }
   831→  }
   832→
   833→  return true;
   834→}
   835→
   836→/**
   837→ * Check if task is ready (pending + deps met + not blocked)
   838→ */
   839→export function isTaskReady(task: LoadedTask, allTasks: LoadedTask[]): boolean {
   840→  if (task.status !== "pending") return false;
   841→  if (task.blocked_by.length > 0) return false;
   842→  return areDependenciesMet(task, allTasks);
   843→}
   844→
   845→/**
   846→ * Get ready tasks (pending + deps met + not blocked), sorted by priority then creation time.
   847→ * Within the same priority tier, older tasks come first (FIFO).
   848→ */
   849→export function getReadyTasks(tasks: LoadedTask[]): LoadedTask[] {
   850→  return tasks
   851→    .filter((task) => isTaskReady(task, tasks))
   852→    .sort((a, b) => {
   853→      // Primary: priority (lower number = higher priority)
   854→      if (a.priority !== b.priority) {
   855→        return a.priority - b.priority;
   856→      }
   857→      // Secondary: creation time (older first - FIFO within priority)
   858→      return (
   859→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime()
   860→      );
   861→    });
   862→}
   863→
   864→// ============================================================
   865→// SPEC ITEM LOADING
   866→// ============================================================
   867→
   868→/**
   869→ * Expand a glob-like include pattern to file paths.
   870→ * Supports simple patterns like "modules/*.yaml" or "**\/*.yaml"
   871→ */
   872→export async function expandIncludePattern(
   873→  pattern: string,
   874→  baseDir: string,
   875→): Promise<string[]> {
   876→  const fullPattern = path.isAbsolute(pattern)
   877→    ? pattern
   878→    : path.join(baseDir, pattern);
   879→
   880→  // If no glob characters, just return the path if it exists
   881→  if (!pattern.includes("*")) {
   882→    try {
   883→      await fs.access(fullPattern);
   884→      return [fullPattern];
   885→    } catch {
   886→      return [];
   887→    }
   888→  }
   889→
   890→  // Split pattern into directory part and file pattern
   891→  const parts = pattern.split("/");
   892→  let currentDir = baseDir;
   893→  const result: string[] = [];
   894→
   895→  // Find the first part with a glob
   896→  const globIndex = parts.findIndex((p) => p.includes("*"));
   897→
   898→  // Navigate to the directory before the glob
   899→  if (globIndex > 0) {
   900→    currentDir = path.join(baseDir, ...parts.slice(0, globIndex));
   901→  }
   902→
   903→  // Get the remaining pattern
   904→  const remainingPattern = parts.slice(globIndex).join("/");
   905→
   906→  await expandGlobRecursive(currentDir, remainingPattern, result);
   907→  return result;
   908→}
   909→
   910→/**
   911→ * Recursively expand glob patterns
   912→ */
   913→async function expandGlobRecursive(
   914→  dir: string,
   915→  pattern: string,
   916→  result: string[],
   917→): Promise<void> {
   918→  const parts = pattern.split("/");
   919→  const currentPattern = parts[0];
   920→  const remainingPattern = parts.slice(1).join("/");
   921→
   922→  try {
   923→    const entries = await fs.readdir(dir, { withFileTypes: true });
   924→
   925→    for (const entry of entries) {
   926→      const matches = matchGlobPart(entry.name, currentPattern);
   927→
   928→      if (matches) {
   929→        const fullPath = path.join(dir, entry.name);
   930→
   931→        if (remainingPattern) {
   932→          // More pattern parts to process
   933→          if (entry.isDirectory()) {
   934→            await expandGlobRecursive(fullPath, remainingPattern, result);
   935→          }
   936→        } else {
   937→          // This is the final pattern part
   938→          if (currentPattern === "**") {
   939→            // ** matches any depth - need special handling
   940→            if (entry.isDirectory()) {
   941→              await expandGlobRecursive(fullPath, "**", result);
   942→            }
   943→            // Also match files at this level
   944→            result.push(fullPath);
   945→          } else if (entry.isFile()) {
   946→            result.push(fullPath);
   947→          }
   948→        }
   949→      }
   950→
   951→      // Handle ** - also recurse into directories without consuming the pattern
   952→      if (currentPattern === "**" && entry.isDirectory()) {
   953→        const fullPath = path.join(dir, entry.name);
   954→        await expandGlobRecursive(fullPath, pattern, result);
   955→      }
   956→    }
   957→  } catch {
   958→    // Directory doesn't exist or not readable
   959→  }
   960→}
   961→
   962→/**
   963→ * Match a single path component against a glob pattern part
   964→ */
   965→function matchGlobPart(name: string, pattern: string): boolean {
   966→  if (pattern === "*") return true;
   967→  if (pattern === "**") return true;
   968→
   969→  // Convert glob pattern to regex
   970→  const regexPattern = pattern
   971→    .replace(/[.+^${}()|[\]\\]/g, "\\$&") // Escape special regex chars
   972→    .replace(/\*/g, ".*") // * matches anything
   973→    .replace(/\?/g, "."); // ? matches single char
   974→
   975→  const regex = new RegExp(`^${regexPattern}$`);
   976→  return regex.test(name);
   977→}
   978→
   979→/**
   980→ * Fields that may contain nested spec items
   981→ */
   982→const NESTED_ITEM_FIELDS = [
   983→  "modules",
   984→  "features",
   985→  "requirements",
   986→  "constraints",
   987→  "decisions",
   988→  "traits",
   989→  "acceptance_criteria",
   990→];
   991→
   992→/**
   993→ * Recursively extract all spec items from a raw YAML structure.
   994→ * Items can be nested under modules/features/requirements/etc.
   995→ * Tracks the path within the file for each item.
   996→ */
   997→export function extractItemsFromRaw(
   998→  raw: unknown,
   999→  sourceFile: string,
  1000→  items: LoadedSpecItem[] = [],
  1001→  currentPath: string = "",
  1002→): LoadedSpecItem[] {
  1003→  if (!raw || typeof raw !== "object") {
  1004→    return items;
  1005→  }
  1006→
  1007→  // Check if this object is itself a spec item (has _ulid)
  1008→  if (
  1009→    "_ulid" in raw &&
  1010→    typeof (raw as Record<string, unknown>)._ulid === "string"
  1011→  ) {
  1012→    // Strip nested item arrays before validation since they're processed separately
  1013→    // and the SpecItemSchema expects refs (strings), not nested objects
  1014→    const rawObj = raw as Record<string, unknown>;
  1015→    const cleanedForValidation: Record<string, unknown> = { ...rawObj };
  1016→    for (const field of NESTED_ITEM_FIELDS) {
  1017→      if (field in cleanedForValidation && Array.isArray(cleanedForValidation[field])) {
  1018→        const arr = cleanedForValidation[field] as unknown[];
  1019→        // Check if array contains nested items (objects with _ulid) vs refs (strings)
  1020→        const hasNestedItems = arr.some(
  1021→          (item) =>
  1022→            item && typeof item === "object" && "_ulid" in (item as Record<string, unknown>)
  1023→        );
  1024→        if (hasNestedItems) {
  1025→          // Strip nested items - they'll be extracted recursively
  1026→          delete cleanedForValidation[field];
  1027→        }
  1028→      }
  1029→    }
  1030→
  1031→    const result = SpecItemSchema.safeParse(cleanedForValidation);
  1032→    if (result.success) {
  1033→      items.push({
  1034→        ...result.data,
  1035→        _sourceFile: sourceFile,
  1036→        _path: currentPath || undefined,
  1037→      });
  1038→    }
  1039→
  1040→    // Even if the item itself was added, also extract nested items
  1041→    for (const field of NESTED_ITEM_FIELDS) {
  1042→      if (field in rawObj && Array.isArray(rawObj[field])) {
  1043→        const arr = rawObj[field] as unknown[];
  1044→        for (let i = 0; i < arr.length; i++) {
  1045→          const nestedPath = currentPath
  1046→            ? `${currentPath}.${field}[${i}]`
  1047→            : `${field}[${i}]`;
  1048→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
  1049→        }
  1050→      }
  1051→    }
  1052→  } else if (Array.isArray(raw)) {
  1053→    // Array of items at root level
  1054→    for (let i = 0; i < raw.length; i++) {
  1055→      const itemPath = currentPath ? `${currentPath}[${i}]` : `[${i}]`;
  1056→      extractItemsFromRaw(raw[i], sourceFile, items, itemPath);
  1057→    }
  1058→  } else {
  1059→    // Object that might contain item arrays (like manifest with modules/features/etc)
  1060→    const rawObj = raw as Record<string, unknown>;
  1061→    for (const field of NESTED_ITEM_FIELDS) {
  1062→      if (field in rawObj && Array.isArray(rawObj[field])) {
  1063→        const arr = rawObj[field] as unknown[];
  1064→        for (let i = 0; i < arr.length; i++) {
  1065→          const nestedPath = currentPath
  1066→            ? `${currentPath}.${field}[${i}]`
  1067→            : `${field}[${i}]`;
  1068→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
  1069→        }
  1070→      }
  1071→    }
  1072→  }
  1073→
  1074→  return items;
  1075→}
  1076→
  1077→/**
  1078→ * Load spec items from a single file.
  1079→ * Handles module files (the file itself is an item with nested children).
  1080→ */
  1081→export async function loadSpecFile(
  1082→  filePath: string,
  1083→): Promise<LoadedSpecItem[]> {
  1084→  try {
  1085→    const content = await fs.readFile(filePath, "utf-8");
  1086→    const items: LoadedSpecItem[] = [];
  1087→
  1088→    // Parse all YAML documents in the file (handles files with ---)
  1089→    const documents = YAML.parseAllDocuments(content);
  1090→
  1091→    for (const doc of documents) {
  1092→      if (doc.errors.length > 0) {
  1093→        // Skip documents with parse errors
  1094→        continue;
  1095→      }
  1096→
  1097→      const raw = doc.toJS();
  1098→      if (raw) {
  1099→        const docItems = extractItemsFromRaw(raw, filePath);
  1100→        items.push(...docItems);
  1101→      }
  1102→    }
  1103→
  1104→    return items;
  1105→  } catch (_error) {
  1106→    // File doesn't exist or parse error
  1107→    return [];
  1108→  }
  1109→}
  1110→
  1111→/**
  1112→ * Load all spec items from the project.
  1113→ * Parses manifest, follows includes, and builds unified collection.
  1114→ */
  1115→export async function loadAllItems(
  1116→  ctx: KspecContext,
  1117→): Promise<LoadedSpecItem[]> {
  1118→  const items: LoadedSpecItem[] = [];
  1119→
  1120→  if (!ctx.manifest || !ctx.manifestPath) {
  1121→    return items;
  1122→  }
  1123→
  1124→  const manifestDir = path.dirname(ctx.manifestPath);
  1125→
  1126→  // Extract items from manifest itself (inline modules/features/etc)
  1127→  const manifestItems = extractItemsFromRaw(ctx.manifest, ctx.manifestPath);
  1128→  items.push(...manifestItems);
  1129→
  1130→  // Process includes
  1131→  const includes = ctx.manifest.includes || [];
  1132→
  1133→  for (const include of includes) {
  1134→    const expandedPaths = await expandIncludePattern(include, manifestDir);
  1135→
  1136→    for (const filePath of expandedPaths) {
  1137→      const fileItems = await loadSpecFile(filePath);
  1138→      items.push(...fileItems);
  1139→    }
  1140→  }
  1141→
  1142→  return items;
  1143→}
  1144→
  1145→/**
  1146→ * Find a spec item by reference (ULID, slug, or short reference)
  1147→ */
  1148→export function findItemByRef(
  1149→  items: LoadedSpecItem[],
  1150→  ref: string,
  1151→): LoadedSpecItem | undefined {
  1152→  // Remove @ prefix if present
  1153→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1154→
  1155→  return items.find((item) => {
  1156→    // Match full ULID
  1157→    if (item._ulid === cleanRef) return true;
  1158→
  1159→    // Match short ULID (prefix)
  1160→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  1161→      return true;
  1162→
  1163→    // Match slug
  1164→    if (item.slugs.includes(cleanRef)) return true;
  1165→
  1166→    return false;
  1167→  });
  1168→}
  1169→
  1170→/**
  1171→ * Combined item type for unified queries across tasks and spec items
  1172→ */
  1173→export type AnyLoadedItem = LoadedTask | LoadedSpecItem;
  1174→
  1175→/**
  1176→ * Find any item (task or spec item) by reference
  1177→ */
  1178→export function findAnyItemByRef(
  1179→  tasks: LoadedTask[],
  1180→  items: LoadedSpecItem[],
  1181→  ref: string,
  1182→): AnyLoadedItem | undefined {
  1183→  // Try tasks first (more commonly referenced)
  1184→  const task = findTaskByRef(tasks, ref);
  1185→  if (task) return task;
  1186→
  1187→  // Then try spec items
  1188→  return findItemByRef(items, ref);
  1189→}
  1190→
  1191→/**
  1192→ * Build a ReferenceIndex from context.
  1193→ * Loads all tasks and spec items, then builds the index.
  1194→ */
  1195→export async function buildReferenceIndex(ctx: KspecContext): Promise<{
  1196→  index: ReferenceIndex;
  1197→  tasks: LoadedTask[];
  1198→  items: LoadedSpecItem[];
  1199→}> {
  1200→  const tasks = await loadAllTasks(ctx);
  1201→  const items = await loadAllItems(ctx);
  1202→  const index = new ReferenceIndex(tasks, items);
  1203→  return { index, tasks, items };
  1204→}
  1205→
  1206→/**
  1207→ * Build both ReferenceIndex and ItemIndex from context.
  1208→ * Use this when you need query capabilities in addition to reference resolution.
  1209→ */
  1210→export async function buildIndexes(ctx: KspecContext): Promise<{
  1211→  refIndex: ReferenceIndex;
  1212→  itemIndex: ItemIndex;
  1213→  traitIndex: TraitIndex;
  1214→  tasks: LoadedTask[];
  1215→  items: LoadedSpecItem[];
  1216→}> {
  1217→  const tasks = await loadAllTasks(ctx);
  1218→  const items = await loadAllItems(ctx);
  1219→  const refIndex = new ReferenceIndex(tasks, items);
  1220→  const itemIndex = new ItemIndex(tasks, items);
  1221→  const traitIndex = new TraitIndex(items, refIndex);
  1222→  return { refIndex, itemIndex, traitIndex, tasks, items };
  1223→}
  1224→
  1225→// ============================================================
  1226→// SPEC ITEM CRUD (supports nested structures)
  1227→// ============================================================
  1228→
  1229→/**
  1230→ * Strip runtime metadata from spec item before serialization
  1231→ */
  1232→function stripSpecItemMetadata(item: LoadedSpecItem): SpecItem {
  1233→  const { _sourceFile, _path, ...cleanItem } = item;
  1234→  return cleanItem as SpecItem;
  1235→}
  1236→
  1237→/**
  1238→ * Parse a path string into segments.
  1239→ * e.g., "features[0].requirements[2]" -> [["features", 0], ["requirements", 2]]
  1240→ */
  1241→function parsePath(pathStr: string): Array<[string, number]> {
  1242→  const segments: Array<[string, number]> = [];
  1243→  const regex = /(\w+)\[(\d+)\]/g;
  1244→  let match;
  1245→  while ((match = regex.exec(pathStr)) !== null) {
  1246→    segments.push([match[1], parseInt(match[2], 10)]);
  1247→  }
  1248→  return segments;
  1249→}
  1250→
  1251→/**
  1252→ * Navigate to a location in a YAML structure using a path.
  1253→ * Returns the parent object and the array containing the target item.
  1254→ */
  1255→function navigateToPath(
  1256→  root: unknown,
  1257→  pathStr: string,
  1258→): { parent: Record<string, unknown>; array: unknown[]; index: number } | null {
  1259→  if (!pathStr) return null;
  1260→
  1261→  const segments = parsePath(pathStr);
  1262→  if (segments.length === 0) return null;
  1263→
  1264→  let current: unknown = root;
  1265→
  1266→  // Navigate to the parent of the last segment
  1267→  for (let i = 0; i < segments.length - 1; i++) {
  1268→    const [field, index] = segments[i];
  1269→    if (typeof current !== "object" || current === null) return null;
  1270→    const obj = current as Record<string, unknown>;
  1271→    if (!Array.isArray(obj[field])) return null;
  1272→    current = (obj[field] as unknown[])[index];
  1273→  }
  1274→
  1275→  // Get the final array and index
  1276→  const [finalField, finalIndex] = segments[segments.length - 1];
  1277→  if (typeof current !== "object" || current === null) return null;
  1278→  const parent = current as Record<string, unknown>;
  1279→  if (!Array.isArray(parent[finalField])) return null;
  1280→
  1281→  return {
  1282→    parent,
  1283→    array: parent[finalField] as unknown[],
  1284→    index: finalIndex,
  1285→  };
  1286→}
  1287→
  1288→/**
  1289→ * Find an item by ULID in a nested YAML structure.
  1290→ * Returns the path segments to reach it.
  1291→ */
  1292→function findItemInStructure(
  1293→  root: unknown,
  1294→  ulid: string,
  1295→  currentPath: string = "",
  1296→): { path: string; item: Record<string, unknown> } | null {
  1297→  if (!root || typeof root !== "object") return null;
  1298→
  1299→  const obj = root as Record<string, unknown>;
  1300→
  1301→  // Check if this is the item we're looking for
  1302→  if (obj._ulid === ulid) {
  1303→    return { path: currentPath, item: obj };
  1304→  }
  1305→
  1306→  // Search nested item fields
  1307→  for (const field of NESTED_ITEM_FIELDS) {
  1308→    if (Array.isArray(obj[field])) {
  1309→      const arr = obj[field] as unknown[];
  1310→      for (let i = 0; i < arr.length; i++) {
  1311→        const nestedPath = currentPath
  1312→          ? `${currentPath}.${field}[${i}]`
  1313→          : `${field}[${i}]`;
  1314→        const result = findItemInStructure(arr[i], ulid, nestedPath);
  1315→        if (result) return result;
  1316→      }
  1317→    }
  1318→  }
  1319→
  1320→  return null;
  1321→}
  1322→
  1323→/**
  1324→ * Create a new spec item with auto-generated fields
  1325→ */
  1326→export function createSpecItem(input: SpecItemInput): SpecItem {
  1327→  return {
  1328→    _ulid: input._ulid || ulid(),
  1329→    slugs: input.slugs || [],
  1330→    title: input.title,
  1331→    type: input.type,
  1332→    status: input.status,
  1333→    priority: input.priority,
  1334→    tags: input.tags || [],
  1335→    description: input.description,
  1336→    acceptance_criteria: input.acceptance_criteria,
  1337→    depends_on: input.depends_on || [],
  1338→    implements: input.implements || [],
  1339→    relates_to: input.relates_to || [],
  1340→    tests: input.tests || [],
  1341→    traits: input.traits || [],
  1342→    notes: input.notes || [],
  1343→    created: input.created || new Date().toISOString(),
  1344→    created_by: input.created_by,
  1345→  };
  1346→}
  1347→
  1348→/**
  1349→ * Map from item type to the field name used to store children of that type.
  1350→ */
  1351→const TYPE_TO_CHILD_FIELD: Record<string, string> = {
  1352→  feature: "features",
  1353→  requirement: "requirements",
  1354→  constraint: "constraints",
  1355→  decision: "decisions",
  1356→  module: "modules",
  1357→  trait: "traits",
  1358→};
  1359→
  1360→/**
  1361→ * Add a spec item as a child of a parent item.
  1362→ * @param parent The parent item to add under
  1363→ * @param child The new child item to add
  1364→ * @param childField Optional field name override (defaults based on child.type)
  1365→ */
  1366→export async function addChildItem(
  1367→  _ctx: KspecContext,
  1368→  parent: LoadedSpecItem,
  1369→  child: SpecItem,
  1370→  childField?: string,
  1371→): Promise<{ item: SpecItem; path: string }> {
  1372→  if (!parent._sourceFile) {
  1373→    throw new Error("Parent item has no source file");
  1374→  }
  1375→
  1376→  const field =
  1377→    childField || TYPE_TO_CHILD_FIELD[child.type || "feature"] || "features";
  1378→
  1379→  // Load the raw YAML
  1380→  const raw = await readYamlFile<unknown>(parent._sourceFile);
  1381→
  1382→  // Find the parent in the structure
  1383→  let parentObj: Record<string, unknown>;
  1384→  let parentPath: string;
  1385→
  1386→  if (parent._path) {
  1387→    const nav = navigateToPath(raw, parent._path);
  1388→    if (!nav) {
  1389→      throw new Error(`Could not navigate to parent path: ${parent._path}`);
  1390→    }
  1391→    parentObj = nav.array[nav.index] as Record<string, unknown>;
  1392→    parentPath = parent._path;
  1393→  } else {
  1394→    // Parent is the root item
  1395→    parentObj = raw as Record<string, unknown>;
  1396→    parentPath = "";
  1397→  }
  1398→
  1399→  // Ensure the child field array exists
  1400→  if (!Array.isArray(parentObj[field])) {
  1401→    parentObj[field] = [];
  1402→  }
  1403→
  1404→  // Add the child
  1405→  const childArray = parentObj[field] as unknown[];
  1406→  const cleanChild = stripSpecItemMetadata(child as LoadedSpecItem);
  1407→  childArray.push(cleanChild);
  1408→
  1409→  // Calculate the new child's path
  1410→  const childIndex = childArray.length - 1;
  1411→  const childPath = parentPath
  1412→    ? `${parentPath}.${field}[${childIndex}]`
  1413→    : `${field}[${childIndex}]`;
  1414→
  1415→  // Write back with format preservation
  1416→  await writeYamlFilePreserveFormat(parent._sourceFile, raw);
  1417→
  1418→  return { item: cleanChild, path: childPath };
  1419→}
  1420→
  1421→/**
  1422→ * Update a spec item in place within its source file.
  1423→ * Works with nested structures using the _path field.
  1424→ */
  1425→export async function updateSpecItem(
  1426→  _ctx: KspecContext,
  1427→  item: LoadedSpecItem,
  1428→  updates: Partial<SpecItemInput>,
  1429→): Promise<SpecItem> {
  1430→  if (!item._sourceFile) {
  1431→    throw new Error("Item has no source file");
  1432→  }
  1433→
  1434→  // Load the raw YAML
  1435→  const raw = await readYamlFile<unknown>(item._sourceFile);
  1436→
  1437→  // Find the item in the structure (use stored path or search by ULID)
  1438→  let targetObj: Record<string, unknown>;
  1439→
  1440→  if (item._path) {
  1441→    const nav = navigateToPath(raw, item._path);
  1442→    if (!nav) {
  1443→      throw new Error(`Could not navigate to path: ${item._path}`);
  1444→    }
  1445→    targetObj = nav.array[nav.index] as Record<string, unknown>;
  1446→  } else {
  1447→    // Item might be the root, or we need to find it
  1448→    const found = findItemInStructure(raw, item._ulid);
  1449→    if (found) {
  1450→      targetObj = found.item;
  1451→    } else if ((raw as Record<string, unknown>)._ulid === item._ulid) {
  1452→      targetObj = raw as Record<string, unknown>;
  1453→    } else {
  1454→      throw new Error(`Could not find item ${item._ulid} in structure`);
  1455→    }
  1456→  }
  1457→
  1458→  // Apply updates (but never change _ulid)
  1459→  for (const [key, value] of Object.entries(updates)) {
  1460→    if (key !== "_ulid" && key !== "_sourceFile" && key !== "_path") {
  1461→      targetObj[key] = value;
  1462→    }
  1463→  }
  1464→
  1465→  // Write back with format preservation
  1466→  await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1467→
  1468→  return { ...item, ...updates, _ulid: item._ulid } as SpecItem;
  1469→}
  1470→
  1471→/**
  1472→ * Check if an item is a trait with implementors.
  1473→ * Returns array of items that use this trait via the 'traits' field.
  1474→ */
  1475→export function findTraitImplementors(
  1476→  trait: LoadedSpecItem,
  1477→  allItems: LoadedSpecItem[],
  1478→): LoadedSpecItem[] {
  1479→  // Check if the item is actually a trait
  1480→  if (trait.type !== "trait") {
  1481→    return [];
  1482→  }
  1483→
  1484→  // Find all items that reference this trait in their 'traits' array
  1485→  const traitRefs = [`@${trait._ulid}`, ...trait.slugs.map((s) => `@${s}`)];
  1486→  return allItems.filter((item) => {
  1487→    if (!item.traits || item.traits.length === 0) return false;
  1488→    return item.traits.some((traitRef: string) => traitRefs.includes(traitRef));
  1489→  });
  1490→}
  1491→
  1492→/**
  1493→ * Delete a spec item from its source file.
  1494→ * Works with nested structures using the _path field.
  1495→ */
  1496→export async function deleteSpecItem(
  1497→  _ctx: KspecContext,
  1498→  item: LoadedSpecItem,
  1499→): Promise<boolean> {
  1500→  if (!item._sourceFile) {
  1501→    return false;
  1502→  }
  1503→
  1504→  try {
  1505→    const raw = await readYamlFile<unknown>(item._sourceFile);
  1506→
  1507→    // If item has a path, navigate to it and remove from parent array
  1508→    if (item._path) {
  1509→      const nav = navigateToPath(raw, item._path);
  1510→      if (!nav) {
  1511→        return false;
  1512→      }
  1513→      // Remove the item from the array
  1514→      nav.array.splice(nav.index, 1);
  1515→      await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1516→      return true;
  1517→    }
  1518→
  1519→    // No path - try to find it by ULID
  1520→    const found = findItemInStructure(raw, item._ulid);
  1521→    if (found?.path) {
  1522→      const nav = navigateToPath(raw, found.path);
  1523→      if (nav) {
  1524→        nav.array.splice(nav.index, 1);
  1525→        await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1526→        return true;
  1527→      }
  1528→    }
  1529→
  1530→    // Maybe it's a root-level array item
  1531→    if (Array.isArray(raw)) {
  1532→      const index = raw.findIndex(
  1533→        (i: unknown) =>
  1534→          typeof i === "object" &&
  1535→          i !== null &&
  1536→          (i as Record<string, unknown>)._ulid === item._ulid,
  1537→      );
  1538→      if (index >= 0) {
  1539→        raw.splice(index, 1);
  1540→        await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1541→        return true;
  1542→      }
  1543→    }
  1544→
  1545→    return false;
  1546→  } catch {
  1547→    return false;
  1548→  }
  1549→}
  1550→
  1551→/**
  1552→ * Save a spec item - either updates existing or adds to parent.
  1553→ * For new items, use addChildItem instead.
  1554→ */
  1555→export async function saveSpecItem(
  1556→  ctx: KspecContext,
  1557→  item: LoadedSpecItem,
  1558→): Promise<void> {
  1559→  // If item has a source file and path, it's an update
  1560→  if (item._sourceFile && item._path) {
  1561→    await updateSpecItem(ctx, item, item);
  1562→    return;
  1563→  }
  1564→
  1565→  // Otherwise, this is more complex - would need a parent
  1566→  throw new Error(
  1567→    "Cannot save new item without parent. Use addChildItem instead.",
  1568→  );
  1569→}
  1570→
  1571→// ============================================================
  1572→// INBOX SYSTEM
  1573→// ============================================================
  1574→
  1575→/**
  1576→ * Inbox item with runtime metadata for source tracking.
  1577→ */
  1578→export interface LoadedInboxItem extends InboxItem {
  1579→  _sourceFile?: string;
  1580→}
  1581→
  1582→/**
  1583→ * Get the inbox file path.
  1584→ *
  1585→ * When shadow enabled: .kspec/project.inbox.yaml
  1586→ * Otherwise: spec/project.inbox.yaml
  1587→ */
  1588→export function getInboxFilePath(ctx: KspecContext): string {
  1589→  return path.join(ctx.specDir, "project.inbox.yaml");
  1590→}
  1591→
  1592→/**
  1593→ * Load all inbox items from the project.
  1594→ */
  1595→export async function loadInboxItems(
  1596→  ctx: KspecContext,
  1597→): Promise<LoadedInboxItem[]> {
  1598→  const inboxPath = getInboxFilePath(ctx);
  1599→
  1600→  try {
  1601→    const raw = await readYamlFile<unknown>(inboxPath);
  1602→
  1603→    // Handle { inbox: [...] } format
  1604→    if (raw && typeof raw === "object" && "inbox" in raw) {
  1605→      const parsed = InboxFileSchema.safeParse(raw);
  1606→      if (parsed.success) {
  1607→        return parsed.data.inbox.map((item) => ({
  1608→          ...item,
  1609→          _sourceFile: inboxPath,
  1610→        }));
  1611→      }
  1612→    }
  1613→
  1614→    // Handle plain array format
  1615→    if (Array.isArray(raw)) {
  1616→      const items: LoadedInboxItem[] = [];
  1617→      for (const item of raw) {
  1618→        const result = InboxItemSchema.safeParse(item);
  1619→        if (result.success) {
  1620→          items.push({ ...result.data, _sourceFile: inboxPath });
  1621→        }
  1622→      }
  1623→      return items;
  1624→    }
  1625→
  1626→    return [];
  1627→  } catch {
  1628→    // File doesn't exist or parse error
  1629→    return [];
  1630→  }
  1631→}
  1632→
  1633→/**
  1634→ * Create a new inbox item with auto-generated fields.
  1635→ */
  1636→export function createInboxItem(input: InboxItemInput): InboxItem {
  1637→  return {
  1638→    _ulid: input._ulid || ulid(),
  1639→    text: input.text,
  1640→    created_at: input.created_at || new Date().toISOString(),
  1641→    tags: input.tags || [],
  1642→    added_by: input.added_by ?? getAuthor(),
  1643→  };
  1644→}
  1645→
  1646→/**
  1647→ * Strip runtime metadata before serialization.
  1648→ */
  1649→function stripInboxMetadata(item: LoadedInboxItem): InboxItem {
  1650→  const { _sourceFile, ...cleanItem } = item;
  1651→  return cleanItem as InboxItem;
  1652→}
  1653→
  1654→/**
  1655→ * Save an inbox item (add or update).
  1656→ */
  1657→export async function saveInboxItem(
  1658→  ctx: KspecContext,
  1659→  item: LoadedInboxItem,
  1660→): Promise<void> {
  1661→  const inboxPath = getInboxFilePath(ctx);
  1662→
  1663→  // Ensure directory exists
  1664→  const dir = path.dirname(inboxPath);
  1665→  await fs.mkdir(dir, { recursive: true });
  1666→
  1667→  // Load existing items
  1668→  let existingItems: InboxItem[] = [];
  1669→
  1670→  try {
  1671→    const raw = await readYamlFile<unknown>(inboxPath);
  1672→    if (raw && typeof raw === "object" && "inbox" in raw) {
  1673→      const parsed = InboxFileSchema.safeParse(raw);
  1674→      if (parsed.success) {
  1675→        existingItems = parsed.data.inbox;
  1676→      }
  1677→    } else if (Array.isArray(raw)) {
  1678→      for (const i of raw) {
  1679→        const result = InboxItemSchema.safeParse(i);
  1680→        if (result.success) {
  1681→          existingItems.push(result.data);
  1682→        }
  1683→      }
  1684→    }
  1685→  } catch {
  1686→    // File doesn't exist, start fresh
  1687→  }
  1688→
  1689→  const cleanItem = stripInboxMetadata(item);
  1690→
  1691→  // Update existing or add new
  1692→  const existingIndex = existingItems.findIndex((i) => i._ulid === item._ulid);
  1693→  if (existingIndex >= 0) {
  1694→    existingItems[existingIndex] = cleanItem;
  1695→  } else {
  1696→    existingItems.push(cleanItem);
  1697→  }
  1698→
  1699→  // Save with { inbox: [...] } format and format preservation
  1700→  await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  1701→}
  1702→
  1703→/**
  1704→ * Delete an inbox item by ULID.
  1705→ */
  1706→export async function deleteInboxItem(
  1707→  ctx: KspecContext,
  1708→  ulid: string,
  1709→): Promise<boolean> {
  1710→  const inboxPath = getInboxFilePath(ctx);
  1711→
  1712→  try {
  1713→    const raw = await readYamlFile<unknown>(inboxPath);
  1714→    let existingItems: InboxItem[] = [];
  1715→
  1716→    if (raw && typeof raw === "object" && "inbox" in raw) {
  1717→      const parsed = InboxFileSchema.safeParse(raw);
  1718→      if (parsed.success) {
  1719→        existingItems = parsed.data.inbox;
  1720→      }
  1721→    }
  1722→
  1723→    const index = existingItems.findIndex((i) => i._ulid === ulid);
  1724→    if (index < 0) {
  1725→      return false;
  1726→    }
  1727→
  1728→    existingItems.splice(index, 1);
  1729→    await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  1730→    return true;
  1731→  } catch {
  1732→    return false;
  1733→  }
  1734→}
  1735→
  1736→/**
  1737→ * Find an inbox item by reference (ULID or short ULID).
  1738→ */
  1739→export function findInboxItemByRef(
  1740→  items: LoadedInboxItem[],
  1741→  ref: string,
  1742→): LoadedInboxItem | undefined {
  1743→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1744→
  1745→  return items.find((item) => {
  1746→    // Match full ULID
  1747→    if (item._ulid === cleanRef) return true;
  1748→    // Match short ULID (prefix)
  1749→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  1750→      return true;
  1751→    return false;
  1752→  });
  1753→}
  1754→
  1755→// ─── Patch Operations ────────────────────────────────────────────────────────
  1756→
  1757→/**
  1758→ * A single patch operation for bulk patching
  1759→ */
  1760→export interface PatchOperation {
  1761→  ref: string;
  1762→  data: Record<string, unknown>;
  1763→}
  1764→
  1765→/**
  1766→ * Result of a single patch operation
  1767→ */
  1768→export interface PatchResult {
  1769→  ref: string;
  1770→  status: "updated" | "skipped" | "error";
  1771→  ulid?: string;
  1772→  error?: string;
  1773→}
  1774→
  1775→/**
  1776→ * Result of a bulk patch operation
  1777→ */
  1778→export interface BulkPatchResult {
  1779→  results: PatchResult[];
  1780→  summary: {
  1781→    total: number;
  1782→    updated: number;
  1783→    failed: number;
  1784→    skipped: number;
  1785→  };
  1786→}
  1787→
  1788→/**
  1789→ * Options for patch operations
  1790→ */
  1791→export interface PatchOptions {
  1792→  allowUnknown?: boolean;
  1793→  dryRun?: boolean;
  1794→  failFast?: boolean;
  1795→}
  1796→
  1797→/**
  1798→ * Bulk patch spec items.
  1799→ * Resolves refs, validates data, applies patches.
  1800→ * Continues on error by default (use failFast to stop on first error).
  1801→ */
  1802→export async function patchSpecItems(
  1803→  ctx: KspecContext,
  1804→  refIndex: ReferenceIndex,
  1805→  items: LoadedSpecItem[],
  1806→  patches: PatchOperation[],
  1807→  options: PatchOptions = {},
  1808→): Promise<BulkPatchResult> {
  1809→  const results: PatchResult[] = [];
  1810→  let stopProcessing = false;
  1811→
  1812→  for (const patch of patches) {
  1813→    if (stopProcessing) {
  1814→      results.push({ ref: patch.ref, status: "skipped" });
  1815→      continue;
  1816→    }
  1817→
  1818→    // Resolve ref
  1819→    const resolved = refIndex.resolve(patch.ref);
  1820→    if (!resolved.ok) {
  1821→      const errorMsg =
  1822→        resolved.error === "not_found"
  1823→          ? `Item not found: ${patch.ref}`
  1824→          : resolved.error === "ambiguous"
  1825→            ? `Ambiguous ref: ${patch.ref}`
  1826→            : `Duplicate slug: ${patch.ref}`;
  1827→      results.push({ ref: patch.ref, status: "error", error: errorMsg });
  1828→      if (options.failFast) {
  1829→        stopProcessing = true;
  1830→      }
  1831→      continue;
  1832→    }
  1833→
  1834→    // Find the item
  1835→    const item = items.find((i) => i._ulid === resolved.ulid);
  1836→    if (!item) {
  1837→      // Ref resolved but it's not a spec item (might be a task)
  1838→      results.push({
  1839→        ref: patch.ref,
  1840→        status: "error",
  1841→        error: "Not a spec item",
  1842→      });
  1843→      if (options.failFast) {
  1844→        stopProcessing = true;
  1845→      }
  1846→      continue;
  1847→    }
  1848→
  1849→    // Dry run - just record what would happen
  1850→    if (options.dryRun) {
  1851→      results.push({ ref: patch.ref, status: "updated", ulid: item._ulid });
  1852→      continue;
  1853→    }
  1854→
  1855→    // Apply the patch
  1856→    try {
  1857→      await updateSpecItem(ctx, item, patch.data);
  1858→      results.push({ ref: patch.ref, status: "updated", ulid: item._ulid });
  1859→    } catch (err) {
  1860→      const errorMsg = err instanceof Error ? err.message : String(err);
  1861→      results.push({ ref: patch.ref, status: "error", error: errorMsg });
  1862→      if (options.failFast) {
  1863→        stopProcessing = true;
  1864→      }
  1865→    }
  1866→  }
  1867→
  1868→  return {
  1869→    results,
  1870→    summary: {
  1871→      total: patches.length,
  1872→      updated: results.filter((r) => r.status === "updated").length,
  1873→      failed: results.filter((r) => r.status === "error").length,
  1874→      skipped: results.filter((r) => r.status === "skipped").length,
  1875→    },
  1876→  };
  1877→}
  1878→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
