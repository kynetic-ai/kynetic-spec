```
     1→/**
     2→ * CLI Plan Import Tests
     3→ * AC: @plan-import ac-11 through ac-33
     4→ */
     5→
     6→import { describe, it, expect, beforeEach, afterEach } from "vitest";
     7→import * as fs from "node:fs/promises";
     8→import * as path from "node:path";
     9→import {
    10→  setupTempFixtures,
    11→  cleanupTempDir,
    12→  kspec as kspecRun,
    13→  kspecOutput as kspec,
    14→  kspecJson,
    15→} from "./helpers/cli";
    16→
    17→describe("Integration: plan import", () => {
    18→  let tempDir: string;
    19→
    20→  beforeEach(async () => {
    21→    tempDir = await setupTempFixtures();
    22→  });
    23→
    24→  afterEach(async () => {
    25→    await cleanupTempDir(tempDir);
    26→  });
    27→
    28→  // AC: @plan-import ac-11
    29→  it("should parse specs from ## Specs YAML block", async () => {
    30→    const planPath = path.join(tempDir, "test-plan.md");
    31→    await fs.writeFile(
    32→      planPath,
    33→      `# Test Plan
    34→
    35→## Specs
    36→
    37→\`\`\`yaml
    38→- title: Feature One
    39→  slug: feature-one
    40→  type: feature
    41→  description: First feature
    42→\`\`\`
    43→`,
    44→    );
    45→
    46→    const output = kspec(
    47→      `plan import "${planPath}" --module @test-core --dry-run`,
    48→      tempDir,
    49→    );
    50→    expect(output).toContain("Would create spec: @feature-one");
    51→  });
    52→
    53→  // AC: @plan-import ac-12
    54→  it("should auto-derive tasks when derive_from_specs is true", async () => {
    55→    const planPath = path.join(tempDir, "test-plan.md");
    56→    await fs.writeFile(
    57→      planPath,
    58→      `# Test Plan
    59→
    60→## Specs
    61→
    62→\`\`\`yaml
    63→- title: Feature One
    64→  slug: feature-one
    65→  type: feature
    66→\`\`\`
    67→
    68→## Tasks
    69→
    70→derive_from_specs: true
    71→`,
    72→    );
    73→
    74→    const output = kspec(
    75→      `plan import "${planPath}" --module @test-core --dry-run`,
    76→      tempDir,
    77→    );
    78→    expect(output).toContain("Would create spec: @feature-one");
    79→    expect(output).toContain("Would derive task:");
    80→    expect(output).toContain("from @feature-one");
    81→  });
    82→
    83→  // AC: @plan-import ac-13
    84→  it("should add global implementation notes to plan record and reference to tasks", async () => {
    85→    const planPath = path.join(tempDir, "test-plan.md");
    86→    await fs.writeFile(
    87→      planPath,
    88→      `# Test Plan
    89→
    90→## Specs
    91→
    92→\`\`\`yaml
    93→- title: Feature One
    94→  slug: feature-one
    95→  type: feature
    96→\`\`\`
    97→
    98→## Tasks
    99→
   100→derive_from_specs: true
   101→
   102→## Implementation Notes
   103→
   104→Use pattern X for implementation.
   105→Follow coding standards Y.
   106→`,
   107→    );
   108→
   109→    kspec(`plan import "${planPath}" --module @test-core`, tempDir);
   110→
   111→    // Plan record should have the global implementation notes
   112→    const plan = kspecJson<{ notes: Array<{ content: string }> }>(
   113→      "plan get @test-plan --json",
   114→      tempDir,
   115→    );
   116→    expect(plan.notes).toHaveLength(1);
   117→    expect(plan.notes[0].content).toContain("Implementation notes:");
   118→    expect(plan.notes[0].content).toContain("Use pattern X");
   119→
   120→    // Task without per-spec notes should get a reference to the plan
   121→    const allTasks = kspecJson<Array<{ notes: Array<{ content: string }>; plan_ref: string }>>(
   122→      "task list --json",
   123→      tempDir,
   124→    );
   125→    const tasks = allTasks.filter(t => t.plan_ref === "@test-plan");
   126→    expect(tasks).toHaveLength(1);
   127→    expect(tasks[0].notes).toHaveLength(1);
   128→    expect(tasks[0].notes[0].content).toContain("See plan @test-plan for implementation notes");
   129→  });
   130→
   131→  // AC: @plan-import ac-13 - Per-spec implementation notes
   132→  it("should add per-spec implementation notes to the corresponding task only", async () => {
   133→    const planPath = path.join(tempDir, "per-spec-notes.md");
   134→    await fs.writeFile(
   135→      planPath,
   136→      `# Per Spec Notes Plan
   137→
   138→## Specs
   139→
   140→\`\`\`yaml
   141→- title: Feature Alpha
   142→  slug: feature-alpha
   143→  type: feature
   144→  implementation_notes: |
   145→    Use pattern A for alpha implementation.
   146→
   147→- title: Feature Beta
   148→  slug: feature-beta
   149→  type: feature
   150→  implementation_notes: |
   151→    Use pattern B for beta implementation.
   152→\`\`\`
   153→
   154→## Tasks
   155→
   156→derive_from_specs: true
   157→`,
   158→    );
   159→
   160→    kspec(`plan import "${planPath}" --module @test-core`, tempDir);
   161→
   162→    const allTasks = kspecJson<Array<{ title: string; notes: Array<{ content: string }>; plan_ref: string }>>(
   163→      "task list --json",
   164→      tempDir,
   165→    );
   166→    const tasks = allTasks.filter(t => t.plan_ref === "@per-spec-notes-plan");
   167→
   168→    expect(tasks).toHaveLength(2);
   169→
   170→    const alphaTask = tasks.find(t => t.title === "Implement Feature Alpha");
   171→    const betaTask = tasks.find(t => t.title === "Implement Feature Beta");
   172→
   173→    expect(alphaTask).toBeDefined();
   174→    expect(alphaTask!.notes).toHaveLength(1);
   175→    expect(alphaTask!.notes[0].content).toContain("Use pattern A");
   176→    expect(alphaTask!.notes[0].content).not.toContain("Use pattern B");
   177→
   178→    expect(betaTask).toBeDefined();
   179→    expect(betaTask!.notes).toHaveLength(1);
   180→    expect(betaTask!.notes[0].content).toContain("Use pattern B");
   181→    expect(betaTask!.notes[0].content).not.toContain("Use pattern A");
   182→  });
   183→
   184→  // AC: @plan-import ac-13 - Mixed: some specs with per-spec notes, some without
   185→  it("should scope per-spec notes and reference plan for specs without", async () => {
   186→    const planPath = path.join(tempDir, "mixed-notes.md");
   187→    await fs.writeFile(
   188→      planPath,
   189→      `# Mixed Notes Plan
   190→
   191→## Specs
   192→
   193→\`\`\`yaml
   194→- title: Feature With Notes
   195→  slug: feature-with-notes
   196→  type: feature
   197→  implementation_notes: |
   198→    Specific implementation details for this feature.
   199→
   200→- title: Feature Without Notes
   201→  slug: feature-without-notes
   202→  type: feature
   203→\`\`\`
   204→
   205→## Tasks
   206→
   207→derive_from_specs: true
   208→
   209→## Implementation Notes
   210→
   211→Global architecture notes for the plan.
   212→`,
   213→    );
   214→
   215→    kspec(`plan import "${planPath}" --module @test-core`, tempDir);
   216→
   217→    const allTasks = kspecJson<Array<{ title: string; notes: Array<{ content: string }>; plan_ref: string }>>(
   218→      "task list --json",
   219→      tempDir,
   220→    );
   221→    const tasks = allTasks.filter(t => t.plan_ref === "@mixed-notes-plan");
   222→
   223→    expect(tasks).toHaveLength(2);
   224→
   225→    const withNotes = tasks.find(t => t.title === "Implement Feature With Notes");
   226→    const withoutNotes = tasks.find(t => t.title === "Implement Feature Without Notes");
   227→
   228→    // Task with per-spec notes gets those notes
   229→    expect(withNotes).toBeDefined();
   230→    expect(withNotes!.notes).toHaveLength(1);
   231→    expect(withNotes!.notes[0].content).toContain("Specific implementation details");
   232→    expect(withNotes!.notes[0].content).not.toContain("See plan");
   233→
   234→    // Task without per-spec notes gets plan reference
   235→    expect(withoutNotes).toBeDefined();
   236→    expect(withoutNotes!.notes).toHaveLength(1);
   237→    expect(withoutNotes!.notes[0].content).toContain("See plan @mixed-notes-plan for implementation notes");
   238→
   239→    // Plan record should have global notes
   240→    const plan = kspecJson<{ notes: Array<{ content: string }> }>(
   241→      "plan get @mixed-notes-plan --json",
   242→      tempDir,
   243→    );
   244→    expect(plan.notes).toHaveLength(1);
   245→    expect(plan.notes[0].content).toContain("Global architecture notes");
   246→  });
   247→
   248→  // AC: @plan-import ac-13 - Backward compatibility: old format without per-spec notes
   249→  it("should handle old-format plan without per-spec notes", async () => {
   250→    const planPath = path.join(tempDir, "old-format.md");
   251→    await fs.writeFile(
   252→      planPath,
   253→      `# Old Format Plan
   254→
   255→## Specs
   256→
   257→\`\`\`yaml
   258→- title: Legacy Feature
   259→  slug: legacy-feature
   260→  type: feature
   261→\`\`\`
   262→
   263→## Tasks
   264→
   265→derive_from_specs: true
   266→
   267→## Implementation Notes
   268→
   269→These are the global notes only.
   270→`,
   271→    );
   272→
   273→    kspec(`plan import "${planPath}" --module @test-core`, tempDir);
   274→
   275→    // Plan record should have global notes
   276→    const plan = kspecJson<{ notes: Array<{ content: string }> }>(
   277→      "plan get @old-format-plan --json",
   278→      tempDir,
   279→    );
   280→    expect(plan.notes).toHaveLength(1);
   281→    expect(plan.notes[0].content).toContain("These are the global notes only");
   282→
   283→    // Task should get plan reference (not the full global notes)
   284→    const allTasks = kspecJson<Array<{ notes: Array<{ content: string }>; plan_ref: string }>>(
   285→      "task list --json",
   286→      tempDir,
   287→    );
   288→    const tasks = allTasks.filter(t => t.plan_ref === "@old-format-plan");
   289→    expect(tasks).toHaveLength(1);
   290→    expect(tasks[0].notes).toHaveLength(1);
   291→    expect(tasks[0].notes[0].content).toContain("See plan @old-format-plan for implementation notes");
   292→  });
   293→
   294→  // AC: @plan-import ac-14, ac-25
   295→  it("should skip existing specs with warning", async () => {
   296→    // Create a spec first
   297→    kspec(
   298→      'item add --under @test-core --title "Existing Feature" --slug existing-feature',
   299→      tempDir,
   300→    );
   301→
   302→    const planPath = path.join(tempDir, "test-plan.md");
   303→    await fs.writeFile(
   304→      planPath,
   305→      `# Test Plan
   306→
   307→## Specs
   308→
   309→\`\`\`yaml
   310→- title: Existing Feature
   311→  slug: existing-feature
   312→  type: feature
   313→\`\`\`
   314→`,
   315→    );
   316→
   317→    const output = kspec(`plan import "${planPath}" --module @test-core`, tempDir);
   318→    // Check summary output (stdout)
   319→    expect(output).toContain("Skipped (1)");
   320→    expect(output).toContain("@existing-feature");
   321→    expect(output).toContain("Already exists");
   322→  });
   323→
   324→  // AC: @plan-import ac-15
   325→  it("should show what would be created in dry-run mode without making changes", async () => {
   326→    const planPath = path.join(tempDir, "test-plan.md");
   327→    await fs.writeFile(
   328→      planPath,
   329→      `# Test Plan
   330→
   331→## Specs
   332→
   333→\`\`\`yaml
   334→- title: Feature One
   335→  slug: feature-one
   336→  type: feature
   337→\`\`\`
   338→`,
   339→    );
   340→
   341→    const output = kspec(
   342→      `plan import "${planPath}" --module @test-core --dry-run`,
