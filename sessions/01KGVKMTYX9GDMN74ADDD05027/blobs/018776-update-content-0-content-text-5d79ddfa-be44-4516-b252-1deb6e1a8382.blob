   182→  origin?: "manual" | "derived" | "observation_promotion";
   183→}
   184→
   185→export interface CommitSummary {
   186→  hash: string;
   187→  full_hash: string;
   188→  date: string;
   189→  message: string;
   190→  author: string;
   191→}
   192→
   193→export interface SessionStats {
   194→  total_tasks: number;
   195→  in_progress: number;
   196→  pending_review: number;
   197→  ready: number;
   198→  blocked: number;
   199→  completed: number;
   200→  inbox_items: number;
   201→}
   202→
   203→export interface InboxSummary {
   204→  ref: string;
   205→  text: string;
   206→  created_at: string;
   207→  tags: string[];
   208→  added_by: string | null;
   209→}
   210→
   211→export interface SessionOptions {
   212→  brief?: boolean;
   213→  full?: boolean;
   214→  since?: string;
   215→  git?: boolean;
   216→  limit?: string;
   217→  eligible?: boolean; // Only include automation-eligible tasks in ready_tasks
   218→}
   219→
   220→// ─── Data Gathering ──────────────────────────────────────────────────────────
   221→
   222→function toActiveTaskSummary(
   223→  task: LoadedTask,
   224→  index: ReferenceIndex,
   225→): ActiveTaskSummary {
   226→  const lastNote =
   227→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   228→  const incompleteTodos = task.todos.filter((t) => !t.done).length;
   229→  return {
   230→    ref: index.shortUlid(task._ulid),
   231→    title: task.title,
   232→    started_at: task.started_at || null,
   233→    priority: task.priority,
   234→    spec_ref: task.spec_ref || null,
   235→    note_count: task.notes.length,
   236→    last_note_at: lastNote ? lastNote.created_at : null,
   237→    todo_count: task.todos.length,
   238→    incomplete_todos: incompleteTodos,
   239→  };
   240→}
   241→
   242→function toReadyTaskSummary(
   243→  task: LoadedTask,
   244→  index: ReferenceIndex,
   245→): ReadyTaskSummary {
   246→  return {
   247→    ref: index.shortUlid(task._ulid),
   248→    title: task.title,
   249→    priority: task.priority,
   250→    spec_ref: task.spec_ref || null,
   251→    tags: task.tags,
   252→  };
   253→}
   254→
   255→function toBlockedTaskSummary(
   256→  task: LoadedTask,
   257→  _allTasks: LoadedTask[],
   258→  index: ReferenceIndex,
   259→): BlockedTaskSummary {
   260→  // Find unmet dependencies
   261→  const unmetDeps: string[] = [];
   262→  for (const depRef of task.depends_on) {
   263→    const result = index.resolve(depRef);
   264→    if (result.ok) {
   265→      const depItem = result.item;
   266→      if ("status" in depItem && depItem.status !== "completed") {
   267→        unmetDeps.push(depRef);
   268→      }
   269→    }
   270→  }
   271→
   272→  return {
   273→    ref: index.shortUlid(task._ulid),
   274→    title: task.title,
   275→    blocked_by: task.blocked_by,
   276→    unmet_deps: unmetDeps,
   277→  };
   278→}
   279→
   280→function toCompletedTaskSummary(
   281→  task: LoadedTask,
   282→  index: ReferenceIndex,
   283→): CompletedTaskSummary {
   284→  return {
   285→    ref: index.shortUlid(task._ulid),
   286→    title: task.title,
   287→    completed_at: task.completed_at || "",
   288→    closed_reason: task.closed_reason || null,
   289→    origin: task.origin,
   290→  };
   291→}
   292→
   293→function collectRecentNotes(
   294→  tasks: LoadedTask[],
   295→  index: ReferenceIndex,
   296→  options: { limit: number; since: Date | null },
   297→): NoteSummary[] {
   298→  const allNotes: NoteSummary[] = [];
   299→
   300→  for (const task of tasks) {
   301→    for (const note of task.notes) {
   302→      const noteDate = new Date(note.created_at);
   303→
   304→      // Filter by since date if provided
   305→      if (options.since && noteDate < options.since) {
   306→        continue;
   307→      }
   308→
   309→      allNotes.push({
   310→        task_ref: index.shortUlid(task._ulid),
   311→        task_title: task.title,
   312→        note_ulid: note._ulid.slice(0, 8),
   313→        created_at: note.created_at,
   314→        author: note.author || null,
   315→        content: note.content,
   316→      });
   317→    }
   318→  }
   319→
   320→  // Sort by date descending, take limit
   321→  return allNotes
   322→    .sort(
   323→      (a, b) =>
   324→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   325→    )
   326→    .slice(0, options.limit);
   327→}
   328→
   329→function collectIncompleteTodos(
   330→  tasks: LoadedTask[],
   331→  index: ReferenceIndex,
   332→  options: { limit: number },
   333→): TodoSummary[] {
   334→  const allTodos: TodoSummary[] = [];
   335→
   336→  for (const task of tasks) {
   337→    for (const todo of task.todos) {
   338→      // Only include incomplete todos
   339→      if (todo.done) continue;
   340→
   341→      allTodos.push({
   342→        task_ref: index.shortUlid(task._ulid),
   343→        task_title: task.title,
   344→        id: todo.id,
   345→        text: todo.text,
   346→        added_at: todo.added_at,
   347→        added_by: todo.added_by || null,
   348→      });
   349→    }
   350→  }
   351→
   352→  // Sort by added_at descending (most recent first), take limit
   353→  return allTodos
   354→    .sort(
   355→      (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime(),
   356→    )
   357→    .slice(0, options.limit);
   358→}
   359→
   360→/**
   361→ * Gather session context data
   362→ */
   363→export async function gatherSessionContext(
   364→  ctx: KspecContext,
   365→  options: SessionOptions,
   366→): Promise<SessionContext> {
   367→  const limit = parseInt(options.limit || "10", 10);
   368→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   369→  const showGit = options.git !== false; // default true
   370→
   371→  // Load all data
   372→  const allTasks = await loadAllTasks(ctx);
   373→  const items = await loadAllItems(ctx);
   374→  const inboxItems = await loadInboxItems(ctx);
   375→  const index = new ReferenceIndex(allTasks, items);
   376→
   377→  // Compute stats
   378→  const stats: SessionStats = {
   379→    total_tasks: allTasks.length,
   380→    in_progress: allTasks.filter((t) => t.status === "in_progress").length,
   381→    pending_review: allTasks.filter((t) => t.status === "pending_review")
   382→      .length,
   383→    ready: getReadyTasks(allTasks).length,
   384→    blocked: allTasks.filter((t) => t.status === "blocked").length,
   385→    completed: allTasks.filter((t) => t.status === "completed").length,
   386→    inbox_items: inboxItems.length,
   387→  };
   388→
   389→  // Get active tasks (optionally filtered to automation-eligible only)
   390→  // AC: @cli-ralph ac-16
   391→  const activeTasks = allTasks
   392→    .filter((t) => t.status === "in_progress")
   393→    .filter((t) => !options.eligible || t.automation === "eligible")
   394→    .sort((a, b) => a.priority - b.priority)
   395→    .slice(0, options.full ? undefined : limit)
   396→    .map((t) => toActiveTaskSummary(t, index));
   397→
   398→  // Get pending review tasks
   399→  const pendingReviewTasks = allTasks
   400→    .filter((t) => t.status === "pending_review")
   401→    .sort((a, b) => a.priority - b.priority)
   402→    .slice(0, options.full ? undefined : limit)
   403→    .map((t) => toActiveTaskSummary(t, index));
   404→
   405→  // Get recent notes from active tasks
   406→  const recentNotes = collectRecentNotes(
   407→    allTasks.filter((t) => t.status === "in_progress"),
   408→    index,
   409→    { limit: options.full ? limit * 2 : limit, since: sinceDate },
   410→  );
   411→
   412→  // Get incomplete todos from active tasks
   413→  const activeTodos = collectIncompleteTodos(
   414→    allTasks.filter((t) => t.status === "in_progress"),
   415→    index,
   416→    { limit: options.full ? limit * 2 : limit },
   417→  );
   418→
   419→  // Get ready tasks (optionally filtered to automation-eligible only)
   420→  const readyTasks = getReadyTasks(allTasks)
   421→    .filter((t) => !options.eligible || t.automation === "eligible")
   422→    .slice(0, options.full ? undefined : limit)
   423→    .map((t) => toReadyTaskSummary(t, index));
   424→
   425→  // Get blocked tasks
   426→  const blockedTasks = allTasks
   427→    .filter((t) => t.status === "blocked")
   428→    .slice(0, options.full ? undefined : limit)
   429→    .map((t) => toBlockedTaskSummary(t, allTasks, index));
   430→
   431→  // Get recently completed tasks
   432→  const recentlyCompleted = allTasks
   433→    .filter((t) => {
   434→      if (t.status !== "completed" || !t.completed_at) return false;
   435→      const completedDate = new Date(t.completed_at);
   436→      if (sinceDate && completedDate < sinceDate) return false;
   437→      return true;
   438→    })
   439→    .sort((a, b) => {
   440→      // Sort by completed_at descending (most recent first)
   441→      const aDate = new Date(a.completed_at || 0);
   442→      const bDate = new Date(b.completed_at || 0);
   443→      return bDate.getTime() - aDate.getTime();
   444→    })
   445→    .slice(0, options.full ? undefined : limit)
   446→    .map((t) => toCompletedTaskSummary(t, index));
   447→
   448→  // Get git info
   449→  let branch: string | null = null;
   450→  let recentCommits: CommitSummary[] = [];
   451→  let workingTree: GitWorkingTree | null = null;
   452→
   453→  if (showGit && isGitRepo(ctx.rootDir)) {
   454→    branch = getCurrentBranch(ctx.rootDir);
   455→
   456→    const commits = getRecentCommits({
   457→      limit: options.full ? limit * 2 : limit,
   458→      since: sinceDate || undefined,
   459→      cwd: ctx.rootDir,
   460→    });
   461→
   462→    recentCommits = commits.map((c) => ({
   463→      hash: c.hash,
   464→      full_hash: c.fullHash,
   465→      date: c.date.toISOString(),
   466→      message: c.message,
   467→      author: c.author,
   468→    }));
   469→
   470→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   471→  }
   472→
   473→  // Get inbox items (oldest first to encourage triage)
   474→  const inboxSummaries: InboxSummary[] = inboxItems
   475→    .sort(
   476→      (a, b) =>
   477→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   478→    )
   479→    .slice(0, options.full ? undefined : limit)
   480→    .map((item) => ({
   481→      ref: item._ulid.slice(0, 8),
   482→      text: item.text,
   483→      created_at: item.created_at,
   484→      tags: item.tags,
   485→      added_by: item.added_by || null,
   486→    }));
   487→
   488→  // Load session context (focus, threads, questions)
   489→  const sessionContext = await loadSessionContext(ctx);
   490→
   491→  return {
   492→    generated_at: new Date().toISOString(),
   493→    branch,
   494→    context: sessionContext,
   495→    active_tasks: activeTasks,
   496→    pending_review_tasks: pendingReviewTasks,
   497→    recent_notes: recentNotes,
   498→    active_todos: activeTodos,
   499→    ready_tasks: readyTasks,
   500→    blocked_tasks: blockedTasks,
   501→    recently_completed: recentlyCompleted,
   502→    recent_commits: recentCommits,
   503→    working_tree: workingTree,
   504→    inbox_items: inboxSummaries,
   505→    stats,
   506→  };
   507→}
   508→
   509→// ─── Iteration Stats ─────────────────────────────────────────────────────────
   510→
   511→/**
   512→ * Stats for tasks completed/started within a time window.
   513→ * Used by ralph to track task completions per iteration.
   514→ */
   515→export interface IterationStats {
   516→  /** Number of tasks completed since the given time */
   517→  tasks_completed: number;
   518→  /** Number of tasks started since the given time */
   519→  tasks_started: number;
   520→  /** References of completed tasks */
   521→  completed_refs: string[];
   522→}
   523→
   524→/**
   525→ * Get iteration stats - tasks completed/started since a given time.
   526→ * AC: @ralph-task-limit ac-detection
   527→ */
   528→export async function getIterationStats(
   529→  ctx: KspecContext,
   530→  since: Date,
   531→): Promise<IterationStats> {
   532→  const allTasks = await loadAllTasks(ctx);
   533→
   534→  const completedSince = allTasks.filter((t) => {
   535→    if (t.status !== "completed" || !t.completed_at) return false;
   536→    return new Date(t.completed_at) >= since;
   537→  });
   538→
   539→  const startedSince = allTasks.filter((t) => {
   540→    if (!t.started_at) return false;
   541→    return new Date(t.started_at) >= since;
   542→  });
   543→
   544→  // Use first slug or ULID prefix as ref
   545→  const getRef = (t: LoadedTask) =>
   546→    t.slugs.length > 0 ? `@${t.slugs[0]}` : `@${t._ulid.slice(0, 8)}`;
   547→
   548→  return {
   549→    tasks_completed: completedSince.length,
   550→    tasks_started: startedSince.length,
   551→    completed_refs: completedSince.map(getRef),
   552→  };
   553→}
   554→
   555→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   556→
   557→export interface CheckpointOptions {
   558→  force?: boolean;
   559→  /** Set when stop hook is already active (retry after previous block) */
   560→  stopHookActive?: boolean;
   561→}
   562→
   563→/** Claude Code hook input for Stop hooks */
   564→export interface StopHookInput {
   565→  session_id?: string;
   566→  transcript_path?: string;
   567→  hook_event_name?: string;
   568→  stop_hook_active?: boolean;
   569→}
   570→
   571→/**
   572→ * Perform session checkpoint - check for uncommitted work before ending session.
   573→ *
   574→ * This is designed for use as a Claude Code stop hook. It checks for:
   575→ * - Uncommitted git changes (staged, unstaged, untracked)
   576→ * - Tasks in in_progress status
   577→ * - Incomplete todos on active tasks
   578→ *
   579→ * Returns a structured result indicating whether the session can end cleanly.
   580→ */
   581→export async function performCheckpoint(
   582→  ctx: KspecContext,
   583→  options: CheckpointOptions,
   584→): Promise<CheckpointResult> {
   585→  const issues: CheckpointIssue[] = [];
   586→  const instructions: string[] = [];
   587→
   588→  // Load tasks
   589→  const allTasks = await loadAllTasks(ctx);
   590→
   591→  // Check for in-progress tasks
   592→  const inProgressTasks = allTasks.filter((t) => t.status === "in_progress");
   593→  for (const task of inProgressTasks) {
   594→    const ref = task.slugs[0]
   595→      ? `@${task.slugs[0]}`
   596→      : `@${task._ulid.slice(0, 8)}`;
   597→    issues.push({
   598→      type: "in_progress_task",
   599→      description: `Task ${ref} is still in progress: ${task.title}`,
   600→      details: {
   601→        ref,
   602→        title: task.title,
   603→        started_at: task.started_at,
   604→      },
   605→    });
   606→
   607→    // Check for incomplete todos on this task
   608→    const incompleteTodos = task.todos.filter((t) => !t.done);
   609→    for (const todo of incompleteTodos) {
   610→      issues.push({
   611→        type: "incomplete_todo",
   612→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   613→        details: {
   614→          task_ref: ref,
   615→          todo_id: todo.id,
   616→          text: todo.text,
   617→        },
   618→      });
   619→    }
   620→  }
   621→
   622→  // Check for uncommitted git changes
   623→  if (isGitRepo(ctx.rootDir)) {
   624→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   625→    if (!workingTree.clean) {
   626→      const changeCount =
   627→        workingTree.staged.length +
   628→        workingTree.unstaged.length +
   629→        workingTree.untracked.length;
   630→
   631→      issues.push({
   632→        type: "uncommitted_changes",
   633→        description: `${changeCount} uncommitted changes in working tree`,
   634→        details: {
   635→          staged: workingTree.staged.length,
   636→          unstaged: workingTree.unstaged.length,
   637→          untracked: workingTree.untracked.length,
   638→        },
   639→      });
   640→    }
   641→  }
   642→
   643→  // Build instructions based on issues
   644→  if (issues.length > 0 && !options.force) {
   645→    instructions.push(
   646→      "If you've been instructed to ignore this message or are working on",
   647→    );
   648→    instructions.push(
   649→      "unrelated things to any in progress tasks then disregard this message,",
   650→    );
   651→    instructions.push("otherwise before ending this session, please:");
   652→
   653→    const hasInProgress = issues.some((i) => i.type === "in_progress_task");
   654→    const hasUncommitted = issues.some((i) => i.type === "uncommitted_changes");
   655→    const hasIncompleteTodos = issues.some((i) => i.type === "incomplete_todo");
   656→
   657→    let step = 1;
   658→
   659→    if (hasInProgress) {
   660→      instructions.push(
   661→        `${step++}. Read in-progress task notes to get full context of the current task status`,
   662→      );
   663→      instructions.push(
   664→        `${step++}. Add notes documenting current state if any context is missing from this session`,
   665→      );
   666→      instructions.push(
   667→        `${step++}. Complete the task if you've completed the objectives and no AC are left uncovered\notherwise leave it in progress for a future session`,
   668→      );
   669→    }
   670→
   671→    if (hasIncompleteTodos) {
   672→      instructions.push(
   673→        `${step++}. Complete or acknowledge incomplete todos on active tasks`,
   674→      );
   675→    }
   676→
   677→    if (hasUncommitted) {
   678→      instructions.push(
   679→        `${step++}. Commit your changes with a descriptive message`,
   680→      );
   681→
   682→      // Add WIP commit guidance if there are in-progress tasks
   683→      if (inProgressTasks.length > 0) {
   684→        const task = inProgressTasks[0];
   685→        const guidance = formatCommitGuidance(task, { wip: true });
   686→        instructions.push("");
   687→        instructions.push("Suggested WIP commit:");
   688→        instructions.push(`  ${guidance.message}`);
   689→        instructions.push("");
   690→        for (const trailer of guidance.trailers) {
   691→          instructions.push(`  ${trailer}`);
   692→        }
   693→      }
   694→    }
   695→
   696→    instructions.push("");
   697→    instructions.push("Use: kspec task @task to get current task state");
   698→    instructions.push(
   699→      'Use: kspec task note @task "Progress notes..." to document state',
   700→    );
   701→    instructions.push(
   702→      'Use: kspec task complete @task --reason "Summary" if task is done',
   703→    );
   704→  }
   705→
   706→  // Allow stop if:
   707→  // - No issues found
   708→  // - --force flag passed
   709→  // - This is a retry (stop_hook_active = true from previous block)
   710→  const isRetry = options.stopHookActive === true;
   711→  const ok = issues.length === 0 || options.force === true || isRetry;
   712→
   713→  let message: string;
   714→  if (isRetry && issues.length > 0) {
   715→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   716→  } else if (ok) {
   717→    message = "[kspec] Session checkpoint passed - ready to end session";
   718→  } else {
   719→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   720→  }
   721→
   722→  return {
   723→    ok,
   724→    message,
   725→    issues,
   726→    instructions,
   727→  };
   728→}
   729→
   730→// ─── Output Formatting ───────────────────────────────────────────────────────
   731→
   732→function formatCheckpointResult(result: CheckpointResult): void {
   733→  if (result.ok) {
   734→    console.log(chalk.green(result.message));
   735→  } else {
   736→    console.log(chalk.yellow(result.message));
   737→    console.log("");
   738→
   739→    for (const issue of result.issues) {
   740→      const icon =
   741→        issue.type === "uncommitted_changes"
   742→          ? chalk.yellow("⚠")
   743→          : issue.type === "in_progress_task"
   744→            ? chalk.blue("●")
   745→            : chalk.gray("○");
   746→      console.log(`  ${icon} ${issue.description}`);
   747→    }
   748→
   749→    if (result.instructions.length > 0) {
   750→      console.log("");
   751→      for (const instruction of result.instructions) {
   752→        console.log(chalk.gray(instruction));
   753→      }
   754→    }
   755→  }
   756→}
   757→
   758→function formatSessionContext(
   759→  ctx: SessionContext,
   760→  options: SessionOptions,
   761→): void {
   762→  const isBrief = !options.full;
   763→
   764→  // Header
   765→  console.log(`\n${sessionHeaders.title}`);
   766→  const age = formatRelativeTime(new Date(ctx.generated_at));
   767→  if (ctx.branch) {
   768→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   769→  } else {
   770→    console.log(chalk.gray(`Generated: ${age}`));
   771→  }
   772→
   773→  // Stats summary
   774→  const pendingReviewNote =
   775→    ctx.stats.pending_review > 0
   776→      ? `${ctx.stats.pending_review} awaiting review, `
   777→      : "";
   778→  const inboxNote =
   779→    ctx.stats.inbox_items > 0 ? ` | Inbox: ${ctx.stats.inbox_items}` : "";
   780→  console.log(
   781→    chalk.gray(
   782→      `Tasks: ${ctx.stats.in_progress} active, ${pendingReviewNote}${ctx.stats.ready} ready, ` +
   783→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`,
   784→    ),
   785→  );
   786→
   787→  // Session context section (focus, threads, questions)
   788→  if (
   789→    ctx.context &&
   790→    (ctx.context.focus ||
   791→      ctx.context.threads.length > 0 ||
   792→      ctx.context.open_questions.length > 0)
   793→  ) {
   794→    console.log("\n--- Session Context ---");
   795→
   796→    if (ctx.context.focus) {
   797→      console.log(`  ${chalk.cyan("Focus:")} ${ctx.context.focus}`);
   798→    }
   799→
   800→    if (ctx.context.threads.length > 0) {
   801→      console.log(`  ${chalk.cyan("Active Threads:")}`);
   802→      for (const thread of ctx.context.threads) {
   803→        console.log(`    - ${thread}`);
   804→      }
   805→    }
   806→
   807→    if (ctx.context.open_questions.length > 0) {
   808→      console.log(`  ${chalk.cyan("Open Questions:")}`);
   809→      for (const question of ctx.context.open_questions) {
   810→        console.log(`    - ${question}`);
   811→      }
   812→    }
   813→  }
   814→
   815→  // Active tasks section
   816→  if (ctx.active_tasks.length > 0) {
   817→    console.log(`\n${sessionHeaders.activeWork}`);
   818→    for (const task of ctx.active_tasks) {
   819→      const started = task.started_at
   820→        ? chalk.gray(
   821→            ` (started ${formatRelativeTime(new Date(task.started_at))})`,
   822→          )
   823→        : "";
   824→      const priority =
   825→        task.priority <= 2
   826→          ? chalk.red(`P${task.priority}`)
   827→          : chalk.gray(`P${task.priority}`);
   828→      console.log(
   829→        `  ${chalk.blue("[in_progress]")} ${priority} ${task.ref} ${task.title}${started}`,
   830→      );
   831→    }
   832→  } else {
   833→    console.log(`\n${sessionHeaders.noActiveWork}`);
   834→  }
   835→
   836→  // Awaiting review section
   837→  if (ctx.pending_review_tasks.length > 0) {
   838→    console.log(`\n${sessionHeaders.awaitingReview}`);
   839→    for (const task of ctx.pending_review_tasks) {
   840→      const priority =
   841→        task.priority <= 2
   842→          ? chalk.red(`P${task.priority}`)
   843→          : chalk.gray(`P${task.priority}`);
   844→      console.log(
   845→        `  ${chalk.yellow("[pending_review]")} ${priority} ${task.ref} ${task.title}`,
   846→      );
   847→    }
   848→  }
   849→
   850→  // Recently completed section
   851→  if (ctx.recently_completed.length > 0) {
   852→    console.log(`\n${sessionHeaders.recentlyCompleted}`);
   853→    const observationPromotedTasks: string[] = [];
   854→    for (const task of ctx.recently_completed) {
   855→      const completedAge = formatRelativeTime(new Date(task.completed_at));
   856→      let reason = "";
   857→      if (task.closed_reason) {
   858→        const maxLen = isBrief ? 60 : 120;
   859→        const truncated =
   860→          task.closed_reason.length > maxLen
   861→            ? `${task.closed_reason.slice(0, maxLen).trim()}...`
   862→            : task.closed_reason;
   863→        reason = chalk.gray(` - ${truncated}`);
   864→      }
   865→      console.log(
   866→        `  ${chalk.green("[completed]")} ${task.ref} ${task.title} ${chalk.gray(`(${completedAge})`)}${reason}`,
   867→      );
   868→
   869→      // Track tasks that came from observations
   870→      if (task.origin === "observation_promotion") {
   871→        observationPromotedTasks.push(task.ref);
   872→      }
   873→    }
   874→
   875→    // Show reminder about resolving observations
   876→    if (observationPromotedTasks.length > 0) {
   877→      console.log(
   878→        chalk.yellow(
   879→          `\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(", ")}`,
   880→        ),
   881→      );
   882→      console.log(
   883→        chalk.gray(`    Run: kspec meta observations --pending-resolution`),
   884→      );
   885→    }
   886→  }
   887→
   888→  // Recent notes section
   889→  if (ctx.recent_notes.length > 0) {
   890→    console.log(`\n${sessionHeaders.recentNotes}`);
   891→    for (const note of ctx.recent_notes) {
   892→      const age = formatRelativeTime(new Date(note.created_at));
   893→      const author = note.author ? chalk.gray(` by ${note.author}`) : "";
   894→      console.log(`  ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
   895→
   896→      // Truncate content in brief mode
   897→      let content = note.content.trim();
   898→      if (isBrief && content.length > 200) {
   899→        content = `${content.slice(0, 200).trim()}...`;
   900→      }
   901→
   902→      // Indent content, limit lines in brief mode
   903→      const lines = content.split("\n");
   904→      const maxLines = isBrief ? 3 : lines.length;
   905→      for (const line of lines.slice(0, maxLines)) {
   906→        console.log(`    ${chalk.white(line)}`);
   907→      }
   908→      if (isBrief && lines.length > maxLines) {
   909→        console.log(
   910→          chalk.gray(`    ... (${lines.length - maxLines} more lines)`),
   911→        );
   912→      }
   913→    }
   914→  }
   915→
   916→  // Incomplete todos section
   917→  if (ctx.active_todos.length > 0) {
   918→    console.log(`\n${sessionHeaders.incompleteTodos}`);
   919→    for (const todo of ctx.active_todos) {
   920→      console.log(
   921→        `  ${chalk.yellow("[ ]")} ${todo.task_ref}#${todo.id}: ${todo.text}`,
   922→      );
   923→    }
   924→  }
   925→
   926→  // Ready tasks section
   927→  if (ctx.ready_tasks.length > 0) {
   928→    console.log(`\n${sessionHeaders.readyTasks}`);
   929→    for (const task of ctx.ready_tasks) {
   930→      const priority =
   931→        task.priority <= 2
   932→          ? chalk.red(`P${task.priority}`)
   933→          : chalk.gray(`P${task.priority}`);
   934→      const tags =
   935→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(" #")}`) : "";
   936→      console.log(`  ${priority} ${task.ref} ${task.title}${tags}`);
   937→    }
   938→  }
   939→
   940→  // Blocked tasks section
   941→  if (ctx.blocked_tasks.length > 0) {
   942→    console.log(`\n${sessionHeaders.blocked}`);
   943→    for (const task of ctx.blocked_tasks) {
   944→      console.log(`  ${chalk.red("[blocked]")} ${task.ref} ${task.title}`);
   945→      if (task.blocked_by.length > 0) {
   946→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(", ")}`));
   947→      }
   948→      if (task.unmet_deps.length > 0) {
   949→        console.log(
   950→          chalk.gray(`    Waiting on: ${task.unmet_deps.join(", ")}`),
   951→        );
   952→      }
   953→    }
   954→  }
   955→
   956→  // Git commits section
   957→  if (ctx.recent_commits.length > 0) {
   958→    console.log(`\n${sessionHeaders.recentCommits}`);
   959→    for (const commit of ctx.recent_commits) {
   960→      const age = formatRelativeTime(new Date(commit.date));
   961→      console.log(
   962→        `  ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${age}, ${commit.author})`)}`,
   963→      );
   964→    }
   965→  }
   966→
   967→  // Inbox section (oldest first to encourage triage)
   968→  if (ctx.inbox_items.length > 0) {
   969→    console.log(`\n${sessionHeaders.inbox}`);
   970→    for (const item of ctx.inbox_items) {
   971→      const age = formatRelativeTime(new Date(item.created_at));
   972→      const author = item.added_by ? ` by ${item.added_by}` : "";
   973→      const tags =
   974→        item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(", ")}]`) : "";
   975→      // Truncate text in brief mode
   976→      let text = item.text;
   977→      if (isBrief && text.length > 60) {
   978→        text = `${text.slice(0, 60).trim()}...`;
   979→      }
   980→      console.log(
   981→        `  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`,
   982→      );
   983→      console.log(`    ${text}`);
   984→    }
   985→    console.log(`  ${hints.inboxPromote}`);
   986→  }
   987→
   988→  // Working tree section
   989→  if (ctx.working_tree && !ctx.working_tree.clean) {
   990→    console.log(`\n${sessionHeaders.workingTree}`);
   991→
   992→    if (ctx.working_tree.staged.length > 0) {
   993→      console.log(chalk.green("  Staged:"));
   994→      for (const file of ctx.working_tree.staged) {
   995→        console.log(
   996→          `    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`,
   997→        );
   998→      }
   999→    }
  1000→
  1001→    if (ctx.working_tree.unstaged.length > 0) {
  1002→      console.log(chalk.red("  Modified:"));
  1003→      for (const file of ctx.working_tree.unstaged) {
  1004→        console.log(
  1005→          `    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`,
  1006→        );
  1007→      }
  1008→    }
  1009→
  1010→    if (ctx.working_tree.untracked.length > 0) {
  1011→      console.log(chalk.gray("  Untracked:"));
  1012→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
  1013→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
  1014→        console.log(`    ${chalk.gray("?")} ${path}`);
  1015→      }
  1016→      if (isBrief && ctx.working_tree.untracked.length > limit) {
  1017→        console.log(
  1018→          chalk.gray(
  1019→            `    ... and ${ctx.working_tree.untracked.length - limit} more`,
  1020→          ),
  1021→        );
  1022→      }
  1023→    }
  1024→  } else if (ctx.working_tree?.clean) {
  1025→    console.log(`\n${sessionHeaders.workingTreeClean}`);
  1026→  }
  1027→
  1028→  // Quick Commands section - contextual hints based on state
  1029→  const quickCommands: string[] = [];
  1030→
  1031→  if (ctx.active_tasks.length > 0) {
  1032→    const ref = ctx.active_tasks[0].ref;
  1033→    quickCommands.push(
  1034→      `kspec task note @${ref} "Progress..."  ${chalk.gray("# document work")}`,
  1035→    );
  1036→    quickCommands.push(
  1037→      `kspec task complete @${ref} --reason "..."  ${chalk.gray("# finish task")}`,
  1038→    );
  1039→  } else if (ctx.ready_tasks.length > 0) {
  1040→    const ref = ctx.ready_tasks[0].ref;
  1041→    quickCommands.push(
  1042→      `kspec task start @${ref}  ${chalk.gray("# begin work")}`,
  1043→    );
  1044→  }
  1045→
  1046→  if (ctx.inbox_items.length > 0) {
  1047→    const ref = ctx.inbox_items[0].ref;
  1048→    quickCommands.push(
  1049→      `kspec inbox promote @${ref} --title "..."  ${chalk.gray("# convert to task")}`,
  1050→    );
  1051→  }
  1052→
  1053→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1054→    quickCommands.push(
  1055→      `git add . && git commit -m "..."  ${chalk.gray("# commit changes")}`,
  1056→    );
  1057→  }
  1058→
  1059→  if (quickCommands.length > 0) {
  1060→    console.log(`\n${sessionHeaders.quickCommands}`);
  1061→    for (const hint of quickCommands) {
  1062→      console.log(`  ${hint}`);
  1063→    }
  1064→  }
  1065→
  1066→  console.log(""); // Final newline
  1067→}
  1068→
  1069→// ─── Command Registration ────────────────────────────────────────────────────
  1070→
  1071→async function sessionStartAction(options: SessionOptions): Promise<void> {
  1072→  try {
  1073→    const ctx = await initContext();
  1074→
  1075→    // AC: @shadow-sync ac-2 - Pull remote changes before showing session context
  1076→    let syncResult: ShadowSyncResult | null = null;
  1077→    if (ctx.shadow?.enabled) {
  1078→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
  1079→      // AC: @shadow-sync ac-3 - Warn about conflicts but continue with local state
  1080→      if (syncResult.hadConflict) {
  1081→        console.log(
  1082→          chalk.yellow(
  1083→            "⚠ Shadow sync conflict detected. Run `kspec shadow resolve` to fix.",
  1084→          ),
  1085→        );
  1086→        console.log(chalk.gray("  Continuing with local state..."));
  1087→        console.log("");
  1088→      } else if (syncResult.pulled) {
  1089→        console.log(chalk.gray("ℹ Synced shadow branch from remote"));
  1090→      }
  1091→    }
  1092→
  1093→    const sessionCtx = await gatherSessionContext(ctx, options);
  1094→
  1095→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
  1096→  } catch (err) {
  1097→    error(errors.failures.gatherSessionContext, err);
  1098→    process.exit(EXIT_CODES.ERROR);
  1099→  }
  1100→}
  1101→
  1102→/**
  1103→ * Read stdin if available (non-blocking check for hook input)
  1104→ */
  1105→async function readStdinIfAvailable(): Promise<string | null> {
  1106→  // Check if stdin is a TTY (interactive) - if so, don't try to read
  1107→  if (process.stdin.isTTY) {
  1108→    return null;
  1109→  }
  1110→
  1111→  return new Promise((resolve) => {
  1112→    let data = "";
  1113→    const timeout = setTimeout(() => {
  1114→      process.stdin.removeAllListeners();
  1115→      resolve(data || null);
  1116→    }, 100); // 100ms timeout for stdin
  1117→
  1118→    process.stdin.setEncoding("utf8");
  1119→    process.stdin.on("data", (chunk) => {
  1120→      data += chunk;
  1121→    });
  1122→    process.stdin.on("end", () => {
  1123→      clearTimeout(timeout);
  1124→      resolve(data || null);
  1125→    });
  1126→    process.stdin.on("error", () => {
  1127→      clearTimeout(timeout);
  1128→      resolve(null);
  1129→    });
  1130→    process.stdin.resume();
  1131→  });
  1132→}
  1133→
  1134→/**
  1135→ * Parse Claude Code hook input from stdin
  1136→ */
  1137→function parseHookInput(stdin: string | null): StopHookInput | null {
  1138→  if (!stdin) return null;
  1139→  try {
  1140→    return JSON.parse(stdin.trim()) as StopHookInput;
  1141→  } catch {
  1142→    return null;
  1143→  }
  1144→}
  1145→
  1146→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
  1147→
  1148→/**
  1149→ * Output spec-first reminder for UserPromptSubmit hook.
  1150→ *
  1151→ * This is a simple context injection - always outputs the reminder,
  1152→ * and Claude (Opus) is smart enough to apply it when relevant.
  1153→ */
  1154→async function sessionPromptCheckAction(): Promise<void> {
  1155→  // Lean, instructive reminder with kspec prefix
  1156→  console.log(sessionPrompt.specCheck);
  1157→}
  1158→
  1159→async function sessionCheckpointAction(
  1160→  options: CheckpointOptions,
  1161→): Promise<void> {
  1162→  try {
  1163→    // Read stdin for Claude Code hook input
  1164→    const stdin = await readStdinIfAvailable();
  1165→    const hookInput = parseHookInput(stdin);
  1166→
  1167→    // Check if this is a retry (stop hook already active)
  1168→    if (hookInput?.stop_hook_active) {
  1169→      options.stopHookActive = true;
  1170→    }
  1171→
  1172→    const ctx = await initContext();
  1173→    const result = await performCheckpoint(ctx, options);
  1174→
  1175→    // Output format depends on mode:
  1176→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
  1177→    // - Human mode: Output formatted checkpoint result
  1178→    if (isJsonMode()) {
  1179→      if (!result.ok) {
  1180→        // Build reason message with issues and instructions
  1181→        const issueLines = result.issues
  1182→          .map((i) => `- ${i.description}`)
  1183→          .join("\n");
  1184→        const instructionLines = result.instructions
  1185→          .filter((i) => i.trim())
  1186→          .join("\n");
  1187→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
  1188→        console.log(JSON.stringify({ decision: "block", reason }));
  1189→      }
  1190→      // If ok, exit silently (Claude Code expects no output when allowing stop)
  1191→    } else {
  1192→      formatCheckpointResult(result);
  1193→      if (!result.ok) {
  1194→        process.exit(EXIT_CODES.ERROR);
  1195→      }
  1196→    }
  1197→  } catch (err) {
  1198→    // Handle RUNNING_FROM_SHADOW gracefully - skip with warning instead of erroring
  1199→    // This happens when the stop hook runs while cwd is inside .kspec/ directory
  1200→    if (err instanceof ShadowError && err.code === "RUNNING_FROM_SHADOW") {
  1201→      if (!isJsonMode()) {
  1202→        console.log(
  1203→          chalk.yellow(
  1204→            "[kspec] Session checkpoint skipped - running from inside .kspec/ directory",
  1205→          ),
  1206→        );
  1207→      }
  1208→      // Allow stop to proceed (exit successfully, no JSON output blocks the stop)
  1209→      return;
  1210→    }
  1211→    error(errors.failures.runCheckpoint, err);
  1212→    process.exit(EXIT_CODES.ERROR);
  1213→  }
  1214→}
  1215→
  1216→// ─── Session Log List ─────────────────────────────────────────────────────────
  1217→
  1218→interface SessionLogListOptions {
  1219→  status?: string;
  1220→  agent?: string;
  1221→  since?: string;
  1222→  sort?: string;
  1223→  count?: boolean;
  1224→  limit?: string;
  1225→}
  1226→
  1227→type SortField =
  1228→  | "started_at"
  1229→  | "duration"
  1230→  | "events"
  1231→  | "iterations"
  1232→  | "tasks_completed";
  1233→
  1234→const VALID_SORT_FIELDS: SortField[] = [
  1235→  "started_at",
  1236→  "duration",
  1237→  "events",
  1238→  "iterations",
  1239→  "tasks_completed",
  1240→];
  1241→
  1242→/**
  1243→ * Format a duration in milliseconds to a human-readable string.
  1244→ */
  1245→function formatDuration(ms: number): string {
  1246→  if (ms < 0) return "—";
  1247→  const totalSec = Math.floor(ms / 1000);
  1248→  const hours = Math.floor(totalSec / 3600);
  1249→  const minutes = Math.floor((totalSec % 3600) / 60);
  1250→  if (hours > 0) {
  1251→    return `${hours}h ${minutes}m`;
  1252→  }
  1253→  if (minutes > 0) {
  1254→    return `${minutes}m`;
  1255→  }
  1256→  return `${totalSec}s`;
  1257→}
  1258→
  1259→/**
  1260→ * Sort session summaries by the specified field.
  1261→ * Default: started_at descending.
  1262→ *
  1263→ * AC: @session-log-list ac-5
  1264→ */
  1265→function sortSessions(
  1266→  sessions: SessionLogSummary[],
  1267→  sortField: SortField,
  1268→): SessionLogSummary[] {
  1269→  return [...sessions].sort((a, b) => {
  1270→    switch (sortField) {
  1271→      case "started_at":
  1272→        return (
  1273→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1274→        );
  1275→      case "duration":
  1276→        return b.duration_ms - a.duration_ms;
  1277→      case "events":
  1278→        return b.event_count - a.event_count;
  1279→      case "iterations":
  1280→        return b.iteration_count - a.iteration_count;
  1281→      case "tasks_completed":
  1282→        return b.tasks_completed - a.tasks_completed;
  1283→      default:
  1284→        return (
  1285→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1286→        );
  1287→    }
  1288→  });
  1289→}
  1290→
  1291→/**
  1292→ * Format the session log list as a table.
  1293→ *
  1294→ * AC: @session-log-list ac-1
  1295→ */
  1296→function formatSessionLogList(sessions: SessionLogSummary[]): void {
  1297→  if (sessions.length === 0) {
  1298→    // AC: @session-log-list ac-6
  1299→    console.log("No sessions found.");
  1300→    return;
  1301→  }
  1302→
  1303→  // Table header
  1304→  console.log(
  1305→    chalk.gray(
  1306→      `${"ID".padEnd(10)} ${"Status".padEnd(11)} ${"Agent".padEnd(20)} ${"Started".padEnd(16)} ${"Duration".padEnd(10)} ${"Events".padEnd(8)} ${"Iters".padEnd(7)} Tasks`,
  1307→    ),
  1308→  );
  1309→  console.log(chalk.gray("─".repeat(95)));
  1310→
  1311→  for (const s of sessions) {
  1312→    const id = s.id.slice(0, 8);
  1313→    const statusColor =
  1314→      s.status === "completed"
  1315→        ? chalk.green
  1316→        : s.status === "active"
  1317→          ? chalk.blue
  1318→          : chalk.yellow;
  1319→    const status = statusColor(s.status.padEnd(11));
  1320→    const agent = s.agent_type.slice(0, 20).padEnd(20);
  1321→    const started = formatRelativeTime(new Date(s.started_at)).padEnd(16);
  1322→    const duration = formatDuration(s.duration_ms).padEnd(10);
  1323→    const events = String(s.event_count).padEnd(8);
  1324→    const iters = String(s.iteration_count).padEnd(7);
  1325→    const tasks = String(s.tasks_completed);
  1326→
  1327→    console.log(
  1328→      `${chalk.yellow(id)} ${status} ${chalk.gray(agent)} ${chalk.gray(started)} ${duration} ${events} ${iters} ${tasks}`,
  1329→    );
  1330→  }
  1331→
  1332→  console.log(chalk.gray(`\n${sessions.length} session(s)`));
  1333→}
  1334→
  1335→/**
  1336→ * Session log list action handler.
  1337→ */
  1338→async function sessionLogListAction(
  1339→  options: SessionLogListOptions,
  1340→): Promise<void> {
  1341→  try {
  1342→    const ctx = await initContext();
  1343→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1344→
  1345→    // AC: @session-log-list ac-2 - Filter by status
  1346→    if (options.status) {
  1347→      const statusFilter = options.status as SessionStatus;
  1348→      sessions = sessions.filter((s) => s.status === statusFilter);
  1349→    }
  1350→
  1351→    // AC: @session-log-list ac-4 - Filter by agent type
  1352→    if (options.agent) {
  1353→      const agentFilter = options.agent;
  1354→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1355→    }
  1356→
  1357→    // AC: @session-log-list ac-3 - Filter by since date
  1358→    if (options.since) {
  1359→      const sinceDate = parseTimeSpec(options.since);
  1360→      if (sinceDate) {
  1361→        sessions = sessions.filter(
  1362→          (s) => new Date(s.started_at) >= sinceDate,
  1363→        );
  1364→      }
  1365→    }
  1366→
  1367→    // AC: @session-log-list ac-5 - Sort
  1368→    const sortField: SortField =
  1369→      options.sort && VALID_SORT_FIELDS.includes(options.sort as SortField)
  1370→        ? (options.sort as SortField)
  1371→        : "started_at";
  1372→    sessions = sortSessions(sessions, sortField);
  1373→
  1374→    // AC: @session-log-list ac-7 - Limit output count
  1375→    if (options.count) {
  1376→      // AC: @trait-filterable-list ac-8
  1377→      output({ count: sessions.length }, () => {
  1378→        console.log(sessions.length);
  1379→      });
  1380→      return;
  1381→    }
  1382→
  1383→    // Apply --limit (after filtering/sorting, before display)
  1384→    if (options.limit) {
  1385→      const limit = parseInt(options.limit, 10);
  1386→      if (!Number.isNaN(limit) && limit > 0) {
  1387→        sessions = sessions.slice(0, limit);
  1388→      }
  1389→    }
  1390→
  1391→    output(sessions, () => formatSessionLogList(sessions));
  1392→  } catch (err) {
  1393→    error("Failed to list session logs", err);
  1394→    process.exit(EXIT_CODES.ERROR);
  1395→  }
  1396→}
  1397→
  1398→// ─── Session Log Show ─────────────────────────────────────────────────────────
  1399→
  1400→interface SessionLogShowOptions {
  1401→  events?: boolean;
  1402→  type?: string;
  1403→  limit?: string;
  1404→  context?: string;
  1405→}
  1406→
  1407→/**
  1408→ * Format an event timestamp as relative time from session start.
  1409→ */
  1410→function formatEventTimestamp(
  1411→  eventTs: number,
  1412→  sessionStartTs: number,
  1413→): string {
  1414→  const relativeMs = eventTs - sessionStartTs;
  1415→  const totalSec = Math.floor(relativeMs / 1000);
  1416→  const minutes = Math.floor(totalSec / 60);
  1417→  const seconds = totalSec % 60;
  1418→  if (minutes > 0) {
  1419→    return `+${minutes}m${seconds}s`;
  1420→  }
  1421→  return `+${seconds}s`;
  1422→}
  1423→
  1424→/**
  1425→ * Summarize event data for display.
  1426→ * Returns a short string describing the event payload.
  1427→ */
  1428→function summarizeEventData(event: SessionEvent): string {
  1429→  const data = event.data as Record<string, unknown> | null;
  1430→  if (!data) return "";
  1431→
  1432→  // Handle tool_call events
  1433→  if (event.type === "session.update") {
  1434→    const update = data.update as {
  1435→      sessionUpdate?: string;
  1436→      rawInput?: { command?: string };
  1437→      _meta?: { claudeCode?: { toolName?: string } };
  1438→    } | null;
  1439→    if (update?.sessionUpdate === "tool_call") {
  1440→      const toolName = update._meta?.claudeCode?.toolName || "unknown";
  1441→      const command = update.rawInput?.command;
  1442→      if (command) {
  1443→        const truncated =
  1444→          command.length > 60 ? command.slice(0, 57) + "..." : command;
  1445→        return `${toolName}: ${truncated}`;
  1446→      }
  1447→      return toolName;
  1448→    }
  1449→  }
  1450→
  1451→  // Handle prompt.sent events
  1452→  if (event.type === "prompt.sent") {
  1453→    const prompt = data.prompt as string | null;
  1454→    if (prompt) {
  1455→      const truncated =
  1456→        prompt.length > 60 ? prompt.slice(0, 57) + "..." : prompt;
  1457→      return truncated;
  1458→    }
  1459→  }
  1460→
  1461→  // Handle session.start/end
  1462→  if (event.type === "session.start") {
  1463→    return "Session started";
  1464→  }
  1465→  if (event.type === "session.end") {
  1466→    const reason = data.reason as string | null;
  1467→    return reason ? `Session ended: ${reason}` : "Session ended";
  1468→  }
  1469→
  1470→  // Default: show first key
  1471→  const keys = Object.keys(data);
  1472→  if (keys.length > 0) {
  1473→    return `{${keys.slice(0, 3).join(", ")}${keys.length > 3 ? ", ..." : ""}}`;
  1474→  }
  1475→  return "";
  1476→}
  1477→
  1478→/**
  1479→ * Format the session log show output.
  1480→ *
  1481→ * AC: @session-log-show ac-1
  1482→ */
  1483→function formatSessionLogShow(
  1484→  detail: SessionLogDetail,
  1485→  events: SessionEvent[] | null,
  1486→  contextSnapshot: unknown | null,
  1487→  sessionStartTs: number,
  1488→): void {
  1489→  // AC: @session-log-show ac-1 - Session metadata
  1490→  console.log(chalk.bold(`Session ${detail.id.slice(0, 8)}`));
  1491→  console.log(chalk.gray("─".repeat(60)));
  1492→  console.log(`  ID:        ${detail.id}`);
  1493→
  1494→  const statusColor =
  1495→    detail.status === "completed"
  1496→      ? chalk.green
  1497→      : detail.status === "active"
  1498→        ? chalk.blue
  1499→        : chalk.yellow;
  1500→  console.log(`  Status:    ${statusColor(detail.status)}`);
  1501→  console.log(`  Agent:     ${detail.agent_type}`);
  1502→  if (detail.task_id) {
  1503→    console.log(`  Task:      ${detail.task_id}`);
  1504→  }
  1505→  console.log(`  Started:   ${detail.started_at}`);
  1506→  if (detail.ended_at) {
  1507→    console.log(`  Ended:     ${detail.ended_at}`);
  1508→  }
  1509→  console.log(`  Duration:  ${formatDuration(detail.duration_ms)}`);
  1510→  console.log(`  Events:    ${detail.event_count}`);
  1511→  console.log(`  Iterations: ${detail.iteration_count}`);
  1512→
  1513→  // AC: @session-log-show ac-2 - Per-iteration summary
  1514→  if (detail.iterations.length > 0) {
  1515→    console.log("\n" + chalk.bold("Iterations"));
  1516→    console.log(chalk.gray("─".repeat(60)));
  1517→    for (const iter of detail.iterations) {
  1518→      const taskInfo: string[] = [];
  1519→      if (iter.tasks_started.length > 0) {
  1520→        taskInfo.push(`started: ${iter.tasks_started.join(", ")}`);
  1521→      }
  1522→      if (iter.tasks_completed.length > 0) {
  1523→        taskInfo.push(`completed: ${iter.tasks_completed.join(", ")}`);
  1524→      }
  1525→      const taskStr = taskInfo.length > 0 ? ` | ${taskInfo.join(" | ")}` : "";
  1526→      console.log(
  1527→        `  ${chalk.cyan(`[${iter.iteration}]`)} ${iter.event_count} events${taskStr}`,
  1528→      );
  1529→    }
  1530→  }
  1531→
  1532→  // AC: @session-log-show ac-3 - Event timeline
  1533→  if (events !== null) {
  1534→    console.log("\n" + chalk.bold("Events"));
  1535→    console.log(chalk.gray("─".repeat(60)));
  1536→    if (events.length === 0) {
  1537→      console.log(chalk.gray("  No events to display."));
  1538→    } else {
  1539→      for (const event of events) {
  1540→        const timestamp = formatEventTimestamp(event.ts, sessionStartTs);
  1541→        const summary = summarizeEventData(event);
  1542→        const typeColor =
  1543→          event.type === "session.start" || event.type === "session.end"
  1544→            ? chalk.green
  1545→            : event.type === "session.update"
  1546→              ? chalk.blue
  1547→              : chalk.gray;
  1548→        console.log(
  1549→          `  ${chalk.yellow(timestamp.padEnd(10))} ${typeColor(event.type.padEnd(16))} ${chalk.gray(summary)}`,
  1550→        );
  1551→      }
  1552→    }
  1553→  }
  1554→
  1555→  // AC: @session-log-show ac-6 - Context snapshot
  1556→  if (contextSnapshot !== null) {
  1557→    console.log("\n" + chalk.bold("Context Snapshot"));
  1558→    console.log(chalk.gray("─".repeat(60)));
  1559→    console.log(JSON.stringify(contextSnapshot, null, 2));
  1560→  }
  1561→}
  1562→
  1563→/**
  1564→ * Session log show action handler.
  1565→ */
  1566→async function sessionLogShowAction(
  1567→  sessionRef: string,
  1568→  options: SessionLogShowOptions,
  1569→): Promise<void> {
  1570→  try {
  1571→    const ctx = await initContext();
  1572→
  1573→    // AC: @session-log-show ac-7, ac-8, ac-9 - Resolve session ID
  1574→    const resolution = await resolveSessionId(ctx.specDir, sessionRef);
  1575→
  1576→    if (!resolution.ok) {
  1577→      if (resolution.error === "not_found") {
  1578→        // AC: @session-log-show ac-9
  1579→        error(`Session not found: ${sessionRef}`);
  1580→        process.exit(EXIT_CODES.NOT_FOUND);
  1581→      } else {
  1582→        // AC: @session-log-show ac-8
  1583→        error(
  1584→          `Ambiguous session ID prefix. Matches:\n  ${resolution.matches.join("\n  ")}\nPlease provide a more specific prefix.`,
  1585→        );
  1586→        process.exit(EXIT_CODES.VALIDATION_FAILED);
  1587→      }
  1588→    }
  1589→
  1590→    const sessionId = resolution.id;
  1591→
  1592→    // Get session detail
  1593→    const detail = await getSessionLogDetail(ctx.specDir, sessionId);
  1594→    if (!detail) {
  1595→      error(`Session not found: ${sessionId}`);
  1596→      process.exit(EXIT_CODES.NOT_FOUND);
  1597→    }
  1598→
  1599→    // AC: @session-log-show ac-3, ac-4, ac-5 - Event timeline
  1600→    let events: SessionEvent[] | null = null;
  1601→    if (options.events) {
  1602→      let allEvents = await readEvents(ctx.specDir, sessionId);
  1603→
  1604→      // AC: @session-log-show ac-4 - Filter by type
  1605→      if (options.type) {
  1606→        const typeFilter = options.type;
  1607→        allEvents = allEvents.filter((e) => e.type === typeFilter);
  1608→      }
  1609→
  1610→      // AC: @session-log-show ac-5 - Limit to last N events
  1611→      if (options.limit) {
  1612→        const limit = parseInt(options.limit, 10);
  1613→        if (!Number.isNaN(limit) && limit > 0) {
  1614→          allEvents = allEvents.slice(-limit);
  1615→        }
  1616→      }
  1617→
  1618→      events = allEvents;
  1619→    }
  1620→
  1621→    // AC: @session-log-show ac-6 - Context snapshot
  1622→    let contextSnapshot: unknown | null = null;
  1623→    if (options.context) {
  1624→      const iterNum = parseInt(options.context, 10);
  1625→      if (!Number.isNaN(iterNum) && iterNum > 0) {
  1626→        contextSnapshot = await readSessionContext(
  1627→          ctx.specDir,
  1628→          sessionId,
  1629→          iterNum,
  1630→        );
  1631→        if (contextSnapshot === null) {
  1632→          error(`No context snapshot found for iteration ${iterNum}`);
  1633→          process.exit(EXIT_CODES.NOT_FOUND);
  1634→        }
  1635→      } else {
  1636→        error(`Invalid iteration number: ${options.context}`);
  1637→        process.exit(EXIT_CODES.USAGE_ERROR);
  1638→      }
  1639→    }
  1640→
  1641→    const sessionStartTs = new Date(detail.started_at).getTime();
  1642→
  1643→    // Build JSON output structure
  1644→    const jsonOutput = {
  1645→      ...detail,
  1646→      ...(events !== null ? { events } : {}),
  1647→      ...(contextSnapshot !== null ? { context: contextSnapshot } : {}),
  1648→    };
  1649→
  1650→    output(jsonOutput, () =>
  1651→      formatSessionLogShow(detail, events, contextSnapshot, sessionStartTs),
  1652→    );
  1653→  } catch (err) {
  1654→    error("Failed to show session log", err);
  1655→    process.exit(EXIT_CODES.ERROR);
  1656→  }
  1657→}
  1658→
  1659→// ─── Session Log Stats ─────────────────────────────────────────────────────────
  1660→
  1661→interface SessionLogStatsOptions {
  1662→  since?: string;
  1663→  agent?: string;
  1664→  toolUsage?: boolean;
  1665→  byDay?: boolean;
  1666→  byWeek?: boolean;
  1667→}
  1668→
  1669→/**
  1670→ * Full stats output including optional tool usage and time period data.
  1671→ */
  1672→interface SessionLogStatsOutput {
  1673→  stats: SessionLogStats;
  1674→  tool_usage?: ToolUsageStats[];
  1675→  time_periods?: TimePeriodStats[];
  1676→}
  1677→
  1678→/**
  1679→ * Format a duration in milliseconds to human-readable format.
  1680→ * Reuses formatDuration from session log list but handles hours/minutes/seconds.
  1681→ */
  1682→function formatDurationLong(ms: number): string {
  1683→  if (ms < 0) return "—";
  1684→  const totalSec = Math.floor(ms / 1000);
  1685→  const hours = Math.floor(totalSec / 3600);
  1686→  const minutes = Math.floor((totalSec % 3600) / 60);
  1687→  const seconds = totalSec % 60;
  1688→  if (hours > 0 && minutes > 0) {
  1689→    return `${hours}h ${minutes}m`;
  1690→  }
  1691→  if (hours > 0) {
  1692→    return `${hours}h`;
  1693→  }
  1694→  if (minutes > 0) {
  1695→    return `${minutes}m ${seconds}s`;
  1696→  }
  1697→  return `${seconds}s`;
  1698→}
  1699→
  1700→/**
  1701→ * Format the session log stats output.
  1702→ *
  1703→ * AC: @session-log-stats ac-1, ac-2, ac-3
  1704→ */
  1705→function formatSessionLogStats(
  1706→  stats: SessionLogStats,
  1707→  toolUsage: ToolUsageStats[] | null,
  1708→  timePeriods: TimePeriodStats[] | null,
  1709→  groupBy: "day" | "week" | null,
  1710→): void {
  1711→  // AC: @session-log-stats ac-1 - Totals
  1712→  console.log(chalk.bold("Session Statistics"));
  1713→  console.log(chalk.gray("─".repeat(50)));
  1714→  console.log(`  Total Sessions:     ${stats.total_sessions}`);
  1715→  console.log(`  Total Events:       ${stats.total_events}`);
  1716→  console.log(`  Total Iterations:   ${stats.total_iterations}`);
  1717→  console.log(`  Tasks Completed:    ${stats.total_tasks_completed}`);
  1718→  console.log(`  Total Duration:     ${formatDurationLong(stats.total_duration_ms)}`);
  1719→
  1720→  // AC: @session-log-stats ac-2 - Averages
  1721→  console.log("\n" + chalk.bold("Averages"));
  1722→  console.log(chalk.gray("─".repeat(50)));
  1723→  console.log(`  Avg Duration/Session:     ${formatDurationLong(stats.avg_duration_ms)}`);
  1724→  console.log(`  Avg Iterations/Session:   ${stats.avg_iterations_per_session}`);
  1725→  console.log(`  Avg Tasks/Session:        ${stats.avg_tasks_per_session}`);
  1726→
  1727→  // AC: @session-log-stats ac-3 - Status breakdown
  1728→  if (stats.status_breakdown.length > 0) {
  1729→    console.log("\n" + chalk.bold("Status Breakdown"));
  1730→    console.log(chalk.gray("─".repeat(50)));
  1731→    for (const item of stats.status_breakdown) {
  1732→      const statusColor =
  1733→        item.status === "completed"
  1734→          ? chalk.green
  1735→          : item.status === "active"
  1736→            ? chalk.blue
  1737→            : chalk.yellow;
  1738→      console.log(
  1739→        `  ${statusColor(item.status.padEnd(12))} ${String(item.count).padEnd(6)} ${item.percentage}%`,
  1740→      );
  1741→    }
  1742→  }
  1743→
  1744→  // AC: @session-log-stats ac-6 - Tool usage
  1745→  if (toolUsage !== null && toolUsage.length > 0) {
  1746→    console.log("\n" + chalk.bold("Top Tool Usage"));
  1747→    console.log(chalk.gray("─".repeat(50)));
  1748→    for (const tool of toolUsage) {
  1749→      console.log(
  1750→        `  ${tool.tool_name.padEnd(20)} ${String(tool.count).padEnd(8)} ${tool.percentage}%`,
  1751→      );
  1752→    }
  1753→  }
  1754→
  1755→  // AC: @session-log-stats ac-7 - Time periods
  1756→  if (timePeriods !== null && timePeriods.length > 0) {
  1757→    const label = groupBy === "week" ? "By Week" : "By Day";
  1758→    console.log("\n" + chalk.bold(label));
  1759→    console.log(chalk.gray("─".repeat(50)));
  1760→    console.log(
  1761→      chalk.gray(
  1762→        `  ${"Period".padEnd(14)} ${"Sessions".padEnd(10)} ${"Tasks".padEnd(8)} Duration`,
  1763→      ),
  1764→    );
  1765→    for (const period of timePeriods) {
  1766→      console.log(
  1767→        `  ${period.period.padEnd(14)} ${String(period.sessions_count).padEnd(10)} ${String(period.tasks_completed).padEnd(8)} ${formatDurationLong(period.total_duration_ms)}`,
  1768→      );
  1769→    }
  1770→  }
  1771→}
  1772→
  1773→/**
  1774→ * Session log stats action handler.
  1775→ */
  1776→async function sessionLogStatsAction(
  1777→  options: SessionLogStatsOptions,
  1778→): Promise<void> {
  1779→  try {
  1780→    const ctx = await initContext();
  1781→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1782→
  1783→    // AC: @session-log-stats ac-4 - Filter by since
  1784→    if (options.since) {
  1785→      const sinceDate = parseTimeSpec(options.since);
  1786→      if (sinceDate) {
  1787→        sessions = sessions.filter(
  1788→          (s) => new Date(s.started_at) >= sinceDate,
  1789→        );
  1790→      }
  1791→    }
  1792→
  1793→    // AC: @session-log-stats ac-5 - Filter by agent type
  1794→    if (options.agent) {
  1795→      const agentFilter = options.agent;
  1796→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1797→    }
  1798→
  1799→    // AC: @session-log-stats ac-8 - No sessions match criteria
  1800→    if (sessions.length === 0) {
  1801→      output({ message: "No sessions match criteria" }, () => {
  1802→        console.log("No sessions match criteria.");
  1803→      });
  1804→      return;
  1805→    }
  1806→
  1807→    // Compute base stats
  1808→    const stats = computeSessionLogStats(sessions);
  1809→
  1810→    // AC: @session-log-stats ac-6 - Tool usage (optional)
  1811→    let toolUsage: ToolUsageStats[] | null = null;
  1812→    if (options.toolUsage) {
  1813→      const sessionIds = sessions.map((s) => s.id);
  1814→      toolUsage = await computeToolUsageStats(ctx.specDir, sessionIds);
  1815→    }
  1816→
  1817→    // AC: @session-log-stats ac-7 - Time periods (optional)
  1818→    let timePeriods: TimePeriodStats[] | null = null;
  1819→    let groupBy: "day" | "week" | null = null;
  1820→    if (options.byDay) {
  1821→      groupBy = "day";
  1822→      timePeriods = computeTimePeriodStats(sessions, "day");
  1823→    } else if (options.byWeek) {
  1824→      groupBy = "week";
  1825→      timePeriods = computeTimePeriodStats(sessions, "week");
  1826→    }
  1827→
  1828→    // Build output structure
  1829→    const jsonOutput: SessionLogStatsOutput = { stats };
  1830→    if (toolUsage !== null) {
  1831→      jsonOutput.tool_usage = toolUsage;
  1832→    }
  1833→    if (timePeriods !== null) {
  1834→      jsonOutput.time_periods = timePeriods;
  1835→    }
  1836→
  1837→    output(jsonOutput, () =>
  1838→      formatSessionLogStats(stats, toolUsage, timePeriods, groupBy),
  1839→    );
  1840→  } catch (err) {
  1841→    error("Failed to compute session log stats", err);
  1842→    process.exit(EXIT_CODES.ERROR);
  1843→  }
  1844→}
  1845→
  1846→// ─── Session Log Search ─────────────────────────────────────────────────────────
  1847→
  1848→interface SessionLogSearchOptions {
  1849→  type?: string;
  1850→  since?: string;
  1851→  agent?: string;
  1852→  limit?: string;
  1853→}
  1854→
  1855→/**
  1856→ * Format relative timestamp from event timestamp (Unix ms) to session start.
  1857→ */
  1858→function formatSearchTimestamp(eventTs: number): string {
  1859→  return new Date(eventTs).toISOString();
  1860→}
  1861→
  1862→/**
  1863→ * Format the session log search output.
  1864→ *
  1865→ * AC: @session-log-search ac-1, ac-4
  1866→ */
  1867→function formatSessionLogSearch(results: SessionSearchResult[]): void {
  1868→  if (results.length === 0) {
  1869→    // AC: @session-log-search ac-6
  1870→    console.log("No matches found.");
  1871→    return;
  1872→  }
  1873→
  1874→  let totalMatches = 0;
  1875→  for (const session of results) {
  1876→    totalMatches += session.matches.length;
  1877→  }
  1878→
  1879→  console.log(chalk.bold(`Found ${totalMatches} match(es) in ${results.length} session(s)`));
  1880→  console.log(chalk.gray("─".repeat(60)));
  1881→
  1882→  for (const session of results) {
  1883→    // Session header
  1884→    console.log(
  1885→      `\n${chalk.cyan(`Session ${session.session_id.slice(0, 8)}`)} ` +
  1886→        `${chalk.gray(`(${session.agent_type}, started ${formatRelativeTime(new Date(session.started_at))})`)}`
  1887→    );
  1888→
  1889→    // AC: @session-log-search ac-4 - Show matches with session ID, timestamp, type, excerpt
  1890→    for (const match of session.matches) {
  1891→      const ts = formatSearchTimestamp(match.timestamp);
  1892→      const typeColor =
  1893→        match.event_type === "session.start" || match.event_type === "session.end"
  1894→          ? chalk.green
  1895→          : match.event_type === "session.update"
  1896→            ? chalk.blue
  1897→            : chalk.gray;
  1898→      console.log(
  1899→        `  ${chalk.yellow(ts)} ${typeColor(match.event_type.padEnd(16))}`,
  1900→      );
  1901→      // Content excerpt on next line, indented
  1902→      console.log(`    ${chalk.gray(match.content_excerpt)}`);
  1903→    }
  1904→  }
  1905→}
  1906→
  1907→/**
  1908→ * Session log search action handler.
  1909→ *
  1910→ * AC: @session-log-search ac-1 through ac-7
  1911→ */
  1912→async function sessionLogSearchAction(
  1913→  pattern: string,
  1914→  options: SessionLogSearchOptions,
  1915→): Promise<void> {
  1916→  try {
  1917→    const ctx = await initContext();
  1918→
  1919→    // Parse options - validate limit as positive integer
  1920→    let limit = 50;
  1921→    if (options.limit) {
  1922→      const parsed = parseInt(options.limit, 10);
  1923→      if (Number.isNaN(parsed) || parsed <= 0) {
  1924→        error(`Invalid limit: ${options.limit}. Must be a positive integer.`);
  1925→        process.exit(EXIT_CODES.USAGE_ERROR);
  1926→      }
  1927→      limit = parsed;
  1928→    }
  1929→    const sinceDate = options.since ? parseTimeSpec(options.since) : undefined;
  1930→
  1931→    // AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7
  1932→    const results = await searchSessionEvents(ctx.specDir, pattern, {
  1933→      eventType: options.type,
  1934→      sinceDate: sinceDate || undefined,
  1935→      agentType: options.agent,
  1936→      limit,
  1937→    });
  1938→
  1939→    // AC: @session-log-search ac-6 - No matches found message
  1940→    // exit code 0 regardless (per @trait-semantic-exit-codes ac-5)
  1941→
  1942→    output(results, () => formatSessionLogSearch(results));
  1943→  } catch (err) {
  1944→    error("Failed to search session logs", err);
  1945→    process.exit(EXIT_CODES.ERROR);
  1946→  }
  1947→}
  1948→
  1949→/**
  1950→ * Register the 'session' command group and aliases
  1951→ */
  1952→export function registerSessionCommands(program: Command): void {
  1953→  const session = program
  1954→    .command("session")
  1955→    .description("Session management and context");
  1956→
  1957→  session
  1958→    .command("start")
  1959→    .alias("resume")
  1960→    .description("Surface relevant context for starting a new working session")
  1961→    .option("--brief", "Compact summary (default)")
  1962→    .option("--full", "Comprehensive context dump")
  1963→    .option(
  1964→      "--since <time>",
  1965→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  1966→    )
  1967→    .option("--no-git", "Skip git commit information")
  1968→    .option("-n, --limit <n>", "Limit items per section", "10")
  1969→    .action(sessionStartAction);
  1970→
  1971→  // Session log subcommand group
  1972→  const log = session
  1973→    .command("log")
  1974→    .description("Session log analysis commands");
  1975→
  1976→  log
  1977→    .command("list")
  1978→    .description("List session logs with summary statistics")
  1979→    .option(
  1980→      "-s, --status <status>",
  1981→      "Filter by status (active, completed, abandoned)",
  1982→    )
  1983→    .option("--agent <type>", "Filter by agent type")
  1984→    .option(
  1985→      "--since <time>",
  1986→      "Only show sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  1987→    )
  1988→    .option(
  1989→      "--sort <field>",
  1990→      "Sort by field (started_at, duration, events, iterations, tasks_completed)",
  1991→      "started_at",
  1992→    )
  1993→    .option("--count", "Show only the count of matching sessions")
  1994→    .option("-n, --limit <n>", "Limit number of sessions shown")
  1995→    .action(sessionLogListAction);
  1996→
  1997→  log
  1998→    .command("show <session-id>")
  1999→    .description("Show detailed view of a single session")
  2000→    .option("-e, --events", "Include chronological event timeline")
  2001→    .option("-t, --type <type>", "Filter events by type (e.g., tool.call)")
  2002→    .option("-n, --limit <n>", "Show only the last N events")
  2003→    .option("-c, --context <n>", "Show context snapshot for iteration N")
  2004→    .action(sessionLogShowAction);
  2005→
  2006→  log
  2007→    .command("stats")
  2008→    .description("Aggregate analytics across sessions")
  2009→    .option(
  2010→      "--since <time>",
  2011→      "Only include sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2012→    )
  2013→    .option("--agent <type>", "Only include sessions with this agent type")
  2014→    .option("--tool-usage", "Display top 10 tool calls by frequency")
  2015→    .option("--by-day", "Group stats by day")
  2016→    .option("--by-week", "Group stats by week")
  2017→    .action(sessionLogStatsAction);
  2018→
  2019→  log
  2020→    .command("search <pattern>")
  2021→    .description("Search across session events by content")
  2022→    .option("-t, --type <type>", "Only search events of this type (e.g., session.update)")
  2023→    .option(
  2024→      "--since <time>",
  2025→      "Only search sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2026→    )
  2027→    .option("--agent <type>", "Only search sessions with this agent type")
  2028→    .option("-n, --limit <n>", "Maximum matches to return (default: 50)")
  2029→    .action(sessionLogSearchAction);
  2030→
  2031→  session
  2032→    .command("checkpoint")
  2033→    .description(
  2034→      "Pre-stop hook: check for uncommitted work before ending session",
  2035→    )
  2036→    .option("--force", "Allow session end regardless of issues")
  2037→    .action(sessionCheckpointAction);
  2038→
  2039→  session
  2040→    .command("prompt-check")
  2041→    .description("UserPromptSubmit hook: inject spec-first reminder")
  2042→    .action(sessionPromptCheckAction);
  2043→
  2044→  // Top-level alias: kspec context
  2045→  program
  2046→    .command("context")
  2047→    .description("Alias for session start - surface session context")
  2048→    .option("--brief", "Compact summary (default)")
  2049→    .option("--full", "Comprehensive context dump")
  2050→    .option(
  2051→      "--since <time>",
  2052→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  2053→    )
  2054→    .option("--no-git", "Skip git commit information")
  2055→    .option("-n, --limit <n>", "Limit items per section", "10")
  2056→    .action(sessionStartAction);
  2057→}
  2058→

