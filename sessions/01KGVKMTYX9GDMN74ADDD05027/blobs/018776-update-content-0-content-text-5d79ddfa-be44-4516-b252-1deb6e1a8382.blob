   155→  task_title: string;
   156→  id: number;
   157→  text: string;
   158→  added_at: string;
   159→  added_by: string | null;
   160→}
   161→
   162→export interface ReadyTaskSummary {
   163→  ref: string;
   164→  title: string;
   165→  priority: number;
   166→  spec_ref: string | null;
   167→  tags: string[];
   168→}
   169→
   170→export interface BlockedTaskSummary {
   171→  ref: string;
   172→  title: string;
   173→  blocked_by: string[];
   174→  unmet_deps: string[];
   175→}
   176→
   177→export interface CompletedTaskSummary {
