     1→/**
     2→ * Plan CLI commands
     3→ * AC: @plan-crud ac-1, ac-2, ac-3, ac-4, ac-7, ac-8, ac-9, ac-30, ac-31
     4→ */
     5→
     6→import * as fs from "node:fs/promises";
     7→import * as path from "node:path";
     8→import type { Command } from "commander";
     9→import { markMutating } from "../command-annotations.js";
    10→import {
    11→  createPlan,
    12→  createTask,
    13→  findPlanByRef,
    14→  filterPlansByStatus,
    15→  getAuthor,
    16→  initContext,
    17→  type LoadedPlan,
    18→  loadAllTasks,
    19→  loadPlans,
    20→  savePlan,
    21→  saveTask,
    22→} from "../../parser/index.js";
    23→import { commitIfShadow } from "../../parser/shadow.js";
    24→import type { PlanInput, TaskInput } from "../../schema/index.js";
    25→import { errors } from "../../strings/index.js";
    26→import { fieldLabels } from "../../strings/labels.js";
    27→import { formatRelativeTime as formatRelativeTimeUtil } from "../../utils/time.js";
    28→import { EXIT_CODES } from "../exit-codes.js";
    29→import { error, info, output, success } from "../output.js";
    30→import { ulid } from "ulid";
    31→import { registerPlanImportCommand } from "./plan-import.js";
    32→
    33→/**
    34→ * Format relative time for display
    35→ */
    36→function formatRelativeTime(dateStr: string): string {
    37→  return formatRelativeTimeUtil(new Date(dateStr));
    38→}
    39→
    40→/**
    41→ * Resolve plan ref with error handling
    42→ * AC: @plan-crud ac-8 - get plan by reference
    43→ */
    44→function resolvePlanRef(ref: string, plans: LoadedPlan[]): LoadedPlan {
    45→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
    46→  const plan = plans.find(
    47→    (p) =>
    48→      p._ulid === cleanRef ||
    49→      p._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()) ||
    50→      p.slugs.includes(cleanRef),
    51→  );
    52→
    53→  if (!plan) {
    54→    error(errors.reference.planNotFound(ref));
    55→    process.exit(EXIT_CODES.NOT_FOUND);
    56→  }
    57→
    58→  return plan;
    59→}
    60→
    61→/**
    62→ * Register the 'plan' command group
    63→ */
    64→export function registerPlanCommands(program: Command): void {
    65→  const plan = program
    66→    .command("plan")
    67→    .description("Manage implementation plans");
    68→
    69→  // Register plan import subcommand
    70→  registerPlanImportCommand(plan);
    71→
    72→  // kspec plan add
    73→  // AC: @plan-crud ac-1, ac-2
    74→  markMutating(plan.command("add"))
    75→    .description("Create a new plan")
    76→    .requiredOption("--title <title>", "Plan title")
    77→    .option("--content <text>", "Plan content (markdown)")
    78→    .option("--content-file <path>", "Read content from markdown file")
    79→    .option("--status <status>", "Initial status (default: draft)")
    80→    .option("--slug <slug>", "Optional slug for the plan")
    81→    .addHelpText(
    82→      "after",
    83→      `
    84→Examples:
    85→  $ kspec plan add --title "User Auth" --content "Implement JWT auth..."
    86→  $ kspec plan add --title "API Refactor" --content-file ./plan.md`,
    87→    )
    88→    .action(async (options) => {
    89→      try {
    90→        const ctx = await initContext();
    91→
    92→        // Validate content options
    93→        if (options.content && options.contentFile) {
    94→          error(
    95→            "Cannot specify both --content and --content-file. Choose one.",
    96→          );
    97→          process.exit(EXIT_CODES.USAGE_ERROR);
    98→        }
    99→
   100→        // Read content from file if specified
   101→        // AC: @plan-crud ac-2
   102→        let content = options.content || "";
   103→        if (options.contentFile) {
   104→          const contentPath = path.resolve(process.cwd(), options.contentFile);
   105→          try {
   106→            content = await fs.readFile(contentPath, "utf-8");
   107→          } catch (err) {
   108→            error(`Failed to read content file: ${options.contentFile}`, err);
   109→            process.exit(EXIT_CODES.ERROR);
   110→          }
   111→        }
   112→
   113→        const input: PlanInput = {
   114→          title: options.title,
   115→          content,
   116→          status: options.status || "draft",
   117→          slugs: options.slug ? [options.slug] : [],
   118→        };
   119→
   120→        const newPlan = createPlan(input);
   121→        await savePlan(ctx, newPlan);
   122→
   123→        // AC: @plan-crud ac-1 - auto-commit to shadow branch
   124→        await commitIfShadow(ctx.shadow, "plan-add", newPlan.slugs[0] || newPlan._ulid.slice(0, 8), options.title);
   125→
   126→        success(`Created plan: ${newPlan._ulid.slice(0, 8)} - ${newPlan.title}`, {
   127→          plan: newPlan,
   128→        });
   129→      } catch (err) {
   130→        error(errors.failures.createPlan, err);
   131→        process.exit(EXIT_CODES.ERROR);
   132→      }
   133→    });
   134→
   135→  // kspec plan get <ref>
   136→  // AC: @plan-crud ac-8, ac-30
   137→  plan
   138→    .command("get <ref>")
   139→    .description("Show plan details")
   140→    .option("--json", "Output as JSON")
   141→    .action(async (ref: string, options) => {
   142→      try {
   143→        const ctx = await initContext();
   144→        const plans = await loadPlans(ctx);
   145→        const foundPlan = resolvePlanRef(ref, plans);
   146→
   147→        // AC: @plan-crud ac-30 - JSON output
   148→        output(foundPlan, () => {
   149→          // AC: @plan-crud ac-8 - full plan display
   150→          console.log(`${fieldLabels.ulid}     ${foundPlan._ulid}`);
   151→          console.log(`${fieldLabels.title}    ${foundPlan.title}`);
   152→          console.log(`${fieldLabels.status}   ${foundPlan.status}`);
   153→
   154→          if (foundPlan.slugs.length > 0) {
   155→            console.log(`Slugs:    ${foundPlan.slugs.join(", ")}`);
   156→          }
   157→
   158→          console.log(
   159→            `${fieldLabels.created}  ${foundPlan.created_at} (${formatRelativeTime(foundPlan.created_at)})`,
   160→          );
   161→
   162→          if (foundPlan.approved_at) {
   163→            console.log(
   164→              `Approved: ${foundPlan.approved_at} (${formatRelativeTime(foundPlan.approved_at)})`,
   165→            );
   166→          }
   167→
   168→          if (foundPlan.completed_at) {
   169→            console.log(
   170→              `Completed: ${foundPlan.completed_at} (${formatRelativeTime(foundPlan.completed_at)})`,
   171→            );
   172→          }
   173→
   174→          // Show derived work
   175→          if (
   176→            foundPlan.derived_tasks.length > 0 ||
   177→            foundPlan.derived_specs.length > 0
   178→          ) {
   179→            console.log("\nDerived Work:");
   180→            if (foundPlan.derived_specs.length > 0) {
   181→              console.log(
   182→                `  Specs: ${foundPlan.derived_specs.join(", ")}`,
   183→              );
   184→            }
   185→            if (foundPlan.derived_tasks.length > 0) {
   186→              console.log(
   187→                `  Tasks: ${foundPlan.derived_tasks.join(", ")}`,
   188→              );
   189→            }
   190→          }
   191→
   192→          // Show content
   193→          if (foundPlan.content) {
   194→            console.log("\n─── Content ───");
   195→            console.log(foundPlan.content);
   196→          }
   197→
   198→          // Show notes
   199→          if (foundPlan.notes.length > 0) {
   200→            console.log("\n─── Notes ───");
   201→            for (const note of foundPlan.notes) {
   202→              const age = formatRelativeTime(note.created_at);
   203→              const author = note.author ? ` by ${note.author}` : "";
   204→              console.log(`\n[${age}${author}]`);
   205→              console.log(note.content);
   206→            }
   207→          }
   208→        });
   209→      } catch (err) {
   210→        error(errors.failures.getPlan, err);
   211→        process.exit(EXIT_CODES.ERROR);
   212→      }
   213→    });
   214→
   215→  // kspec plan set <ref>
   216→  // AC: @plan-crud ac-3, ac-4
   217→  markMutating(plan.command("set <ref>"))
   218→    .description("Update plan fields")
   219→    .option("--title <title>", "Update title")
   220→    .option("--status <status>", "Update status")
   221→    .option("--slug <slug>", "Add a slug")
   222→    .action(async (ref: string, options) => {
   223→      try {
   224→        const ctx = await initContext();
   225→        const plans = await loadPlans(ctx);
   226→        const foundPlan = resolvePlanRef(ref, plans);
   227→
   228→        // AC: @plan-crud ac-4 - prevent transitions from terminal states
   229→        if (
   230→          options.status &&
   231→          (foundPlan.status === "completed" || foundPlan.status === "rejected")
   232→        ) {
   233→          error("Cannot transition from terminal status");
   234→          process.exit(EXIT_CODES.CONFLICT);
   235→        }
   236→
   237→        const changes: string[] = [];
   238→
   239→        if (options.title) {
   240→          foundPlan.title = options.title;
   241→          changes.push("title");
   242→        }
   243→
   244→        if (options.status) {
   245→          const oldStatus = foundPlan.status;
   246→          foundPlan.status = options.status;
   247→          changes.push(`status: ${oldStatus} → ${options.status}`);
   248→
   249→          // AC: @plan-crud ac-3 - set approved_at timestamp when transitioning to approved
   250→          if (options.status === "approved" && !foundPlan.approved_at) {
   251→            foundPlan.approved_at = new Date().toISOString();
   252→          }
   253→        }
   254→
   255→        if (options.slug) {
   256→          if (!foundPlan.slugs.includes(options.slug)) {
   257→            foundPlan.slugs.push(options.slug);
   258→            changes.push(`slug: +${options.slug}`);
   259→          }
   260→        }
   261→
   262→        if (changes.length === 0) {
   263→          info("No changes specified");
   264→          return;
   265→        }
   266→
   267→        await savePlan(ctx, foundPlan);
   268→        await commitIfShadow(
   269→          ctx.shadow,
   270→          "plan-set",
   271→          foundPlan.slugs[0] || foundPlan._ulid.slice(0, 8),
   272→          changes.join(", "),
   273→        );
   274→
   275→        success(`Updated plan: ${foundPlan._ulid.slice(0, 8)}`, {
   276→          changes,
   277→          plan: foundPlan,
   278→        });
   279→      } catch (err) {
   280→        error(errors.failures.updatePlan, err);
   281→        process.exit(EXIT_CODES.ERROR);
   282→      }
   283→    });
   284→
   285→  // kspec plan list
   286→  // AC: @plan-crud ac-7, ac-31
   287→  plan
   288→    .command("list")
   289→    .description("List plans")
   290→    .option("--status <status>", "Filter by status")
   291→    .option("--json", "Output as JSON array")
   292→    .action(async (options) => {
   293→      try {
   294→        const ctx = await initContext();
   295→        let plans = await loadPlans(ctx);
   296→
   297→        // AC: @plan-crud ac-7 - status filter
   298→        if (options.status) {
   299→          plans = filterPlansByStatus(plans, options.status);
   300→        }
   301→
   302→        // Sort by created date (newest first)
   303→        plans.sort(
   304→          (a, b) =>
   305→            new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   306→        );
   307→
   308→        // AC: @plan-crud ac-31 - JSON output
   309→        output(plans, () => {
   310→          if (plans.length === 0) {
   311→            console.log("No plans found");
   312→            return;
   313→          }
   314→
   315→          console.log(`Plans (${plans.length}):\n`);
   316→
   317→          for (const p of plans) {
   318→            const ref = p._ulid.slice(0, 8);
   319→            const age = formatRelativeTime(p.created_at);
   320→            const taskCount = p.derived_tasks.length;
   321→            const tasks =
   322→              taskCount > 0 ? ` [${taskCount} task${taskCount > 1 ? "s" : ""}]` : "";
   323→
   324→            console.log(
   325→              `  ${ref} [${p.status}]${tasks} ${p.title}`,
   326→            );
   327→            console.log(`         Created ${age}`);
   328→
   329→            if (p.approved_at) {
   330→              console.log(
   331→                `         Approved ${formatRelativeTime(p.approved_at)}`,
   332→              );
   333→            }
   334→
   335→            console.log("");
   336→          }
   337→        });
   338→      } catch (err) {
   339→        error(errors.failures.listPlans, err);
   340→        process.exit(EXIT_CODES.ERROR);
   341→      }
   342→    });
   343→
   344→  // kspec plan note <ref> <text>
   345→  // AC: @plan-crud ac-9
   346→  markMutating(plan.command("note <ref> <text>"))
   347→    .description("Add a note to a plan")
   348→    .action(async (ref: string, text: string) => {
   349→      try {
   350→        const ctx = await initContext();
   351→        const author = getAuthor();
   352→        const plans = await loadPlans(ctx);
   353→        const foundPlan = resolvePlanRef(ref, plans);
   354→
   355→        // AC: @plan-crud ac-9 - append note with ULID, timestamp, author
   356→        const note = {
   357→          _ulid: ulid(),
   358→          created_at: new Date().toISOString(),
   359→          author,
   360→          content: text,
   361→        };
   362→
   363→        foundPlan.notes.push(note);
   364→        await savePlan(ctx, foundPlan);
   365→        await commitIfShadow(
   366→          ctx.shadow,
   367→          "plan-note",
   368→          foundPlan.slugs[0] || foundPlan._ulid.slice(0, 8),
   369→        );
   370→
   371→        success(`Added note to plan: ${foundPlan._ulid.slice(0, 8)}`, {
   372→          note,
   373→        });
   374→      } catch (err) {
   375→        error(errors.failures.addPlanNote, err);
   376→        process.exit(EXIT_CODES.ERROR);
   377→      }
   378→    });
   379→
   380→  // kspec plan derive <ref>
   381→  // AC: @plan-derive ac-5, ac-6
   382→  markMutating(plan.command("derive <ref>"))
   383→    .description("Create a task from a plan")
   384→    .option("--title <title>", "Override task title")
   385→    .option("--priority <n>", "Set task priority (1-5)", parseInt)
   386→    .addHelpText(
   387→      "after",
   388→      `
   389→Examples:
   390→  $ kspec plan derive @plan-ref
   391→  $ kspec plan derive @plan-ref --title "Custom title"
   392→  $ kspec plan derive @plan-ref --priority 1`,
   393→    )
   394→    .action(async (ref: string, options) => {
   395→      try {
   396→        const ctx = await initContext();
   397→        const plans = await loadPlans(ctx);
   398→        const tasks = await loadAllTasks(ctx);
   399→        const foundPlan = resolvePlanRef(ref, plans);
   400→
   401→        // AC: @plan-derive ac-5 - check plan status
   402→        if (foundPlan.status !== "approved" && foundPlan.status !== "active") {
   403→          error(
   404→            `Plan must be in 'approved' or 'active' status to derive tasks (current: ${foundPlan.status})`,
   405→          );
   406→          process.exit(EXIT_CODES.USAGE_ERROR);
   407→        }
   408→
   409→        // Generate task slug from plan title
   410→        const generateSlug = (title: string): string => {
   411→          return title
   412→            .toLowerCase()
   413→            .replace(/[^a-z0-9]+/g, "-")
   414→            .replace(/^-|-$/g, "")
   415→            .slice(0, 50);
   416→        };
   417→
   418→        // Generate task title and slug
   419→        const taskTitle = options.title || `Implement: ${foundPlan.title}`;
   420→        let taskSlug = generateSlug(taskTitle);
   421→
   422→        // Ensure slug uniqueness
   423→        let slugSuffix = 1;
   424→        const originalSlug = taskSlug;
   425→        while (tasks.some((t) => t.slugs.includes(taskSlug))) {
   426→          taskSlug = `${originalSlug}-${slugSuffix}`;
   427→          slugSuffix++;
   428→        }
   429→
   430→        // AC: @plan-derive ac-5 - create task with plan_ref
   431→        const planRef = foundPlan.slugs[0]
   432→          ? `@${foundPlan.slugs[0]}`
   433→          : `@${foundPlan._ulid.slice(0, 8)}`;
   434→
   435→        const taskInput: TaskInput = {
   436→          title: taskTitle,
   437→          type: "task",
   438→          plan_ref: planRef,
   439→          priority: options.priority ?? 3,
   440→          slugs: [taskSlug],
   441→          tags: [],
   442→          depends_on: [],
   443→          notes: [],
   444→        };
   445→
   446→        const newTask = createTask(taskInput);
   447→        await saveTask(ctx, newTask);
   448→
   449→        // AC: @plan-derive ac-5 - update plan's derived_tasks array
   450→        const taskRef = `@${taskSlug}`;
   451→        if (!foundPlan.derived_tasks.includes(taskRef)) {
   452→          foundPlan.derived_tasks.push(taskRef);
   453→        }
   454→
   455→        // AC: @plan-derive ac-5 - transition plan to active if not already
   456→        if (foundPlan.status === "approved") {
   457→          foundPlan.status = "active";
   458→        }
   459→
   460→        await savePlan(ctx, foundPlan);
   461→
   462→        await commitIfShadow(
   463→          ctx.shadow,
   464→          "plan-derive",
   465→          foundPlan.slugs[0] || foundPlan._ulid.slice(0, 8),
   466→          taskTitle,
   467→        );
   468→
   469→        success(`Created task from plan: ${taskRef}`, {
   470→          task: newTask,
   471→          plan: foundPlan,
   472→        });
   473→      } catch (err) {
   474→        error("Failed to derive task from plan", err);
   475→        process.exit(EXIT_CODES.ERROR);
   476→      }
   477→    });
   478→}
   479→

