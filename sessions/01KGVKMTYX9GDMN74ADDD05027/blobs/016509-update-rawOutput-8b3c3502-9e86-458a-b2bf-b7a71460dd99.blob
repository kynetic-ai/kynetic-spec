     1→/**
     2→ * Plan import CLI command
     3→ * AC: @plan-import ac-11 through ac-33
     4→ */
     5→
     6→import * as fs from "node:fs/promises";
     7→import * as path from "node:path";
     8→import type { Command } from "commander";
     9→import { markMutating } from "../command-annotations.js";
    10→import {
    11→  addChildItem,
    12→  buildIndexes,
    13→  createPlan,
    14→  createSpecItem,
    15→  createTask,
    16→  getAuthor,
    17→  initContext,
    18→  loadAllTasks,
    19→  loadPlans,
    20→  savePlan,
    21→  saveTask,
    22→  type LoadedSpecItem,
    23→} from "../../parser/index.js";
    24→import {
    25→  parsePlanDocument,
    26→  topologicalSort,
    27→  validateParentRefs,
    28→  type PlanSpec,
    29→} from "../../parser/plan-document.js";
    30→import { commitIfShadow } from "../../parser/shadow.js";
    31→import type { PlanInput, SpecItemInput, TaskInput } from "../../schema/index.js";
    32→import { errors } from "../../strings/index.js";
    33→import { EXIT_CODES } from "../exit-codes.js";
    34→import { error, info, isJsonMode, output, success, warn } from "../output.js";
    35→import { ulid } from "ulid";
    36→
    37→/**
    38→ * Register plan import command
    39→ * AC: @plan-import ac-11, ac-15, ac-32
    40→ */
    41→export function registerPlanImportCommand(planCommand: Command): void {
    42→  markMutating(planCommand.command("import <path>"))
    43→    .description("Import plan document and auto-generate specs/tasks")
    44→    .requiredOption(
    45→      "--module <ref>",
    46→      "Module to add specs under (e.g., @core-module)",
    47→    )
    48→    .option("--dry-run", "Show what would be created without making changes")
    49→    .option("--update", "Update existing specs instead of skipping them")
    50→    .option("--json", "Output as JSON")
    51→    .addHelpText(
    52→      "after",
    53→      `
    54→Examples:
    55→  $ kspec plan import ./plan.md --module @core
    56→  $ kspec plan import ./plan.md --module @api --dry-run
    57→  $ kspec plan import ./plan.md --module @features --update --json`,
    58→    )
    59→    .action(async (planPath: string, options) => {
    60→      try {
    61→        await importPlan(planPath, options);
    62→      } catch (err) {
    63→        error("Failed to import plan", err);
    64→        process.exit(EXIT_CODES.ERROR);
    65→      }
    66→    });
    67→}
    68→
    69→/**
    70→ * Import operation result
    71→ */
    72→interface ImportResult {
    73→  createdSpecs: string[];
    74→  updatedSpecs: string[];
    75→  createdTasks: string[];
    76→  errors: Array<{ message: string; spec?: PlanSpec }>;
    77→  skipped: Array<{ slug: string; reason: string }>;
    78→  planRef: string;
    79→}
    80→
    81→/**
    82→ * Import plan document and create specs/tasks
    83→ * AC: @plan-import ac-11 through ac-33
    84→ */
    85→async function importPlan(
    86→  planPath: string,
    87→  options: { module: string; dryRun?: boolean; update?: boolean },
    88→): Promise<void> {
    89→  // JSON mode is set by global preAction hook
    90→
    91→  const ctx = await initContext();
    92→  const author = getAuthor();
    93→
    94→  // Read plan file
    95→  // AC: @plan-import ac-21 - Handle file read errors
    96→  const fullPath = path.resolve(process.cwd(), planPath);
    97→  let content: string;
    98→  try {
    99→    content = await fs.readFile(fullPath, "utf-8");
   100→  } catch (err) {
   101→    error(`Failed to read plan file: ${planPath}`, err);
   102→    process.exit(EXIT_CODES.USAGE_ERROR);
   103→  }
   104→
   105→  // Parse plan document
   106→  // AC: @plan-import ac-11, ac-12, ac-13, ac-21, ac-22
   107→  const parsed = parsePlanDocument(content);
   108→
   109→  // Report parsing errors
   110→  if (parsed.errors.length > 0) {
   111→    for (const err of parsed.errors) {
   112→      if (err.type === "yaml") {
   113→        // AC: @plan-import ac-21 - YAML parse errors (fatal)
   114→        error(err.message);
   115→        process.exit(EXIT_CODES.USAGE_ERROR);
   116→      } else if (err.type === "validation") {
   117→        // AC: @plan-import ac-22 - Validation errors (non-fatal, add to warnings)
   118→        warn(err.message);
   119→      }
   120→    }
   121→  }
   122→
   123→  // Build indexes to check existing specs
   124→  const { refIndex, items } = await buildIndexes(ctx);
   125→  const existingSpecRefs = new Set<string>();
   126→  for (const item of items) {
   127→    for (const slug of (item as LoadedSpecItem).slugs || []) {
   128→      existingSpecRefs.add(slug);
   129→    }
   130→    existingSpecRefs.add(item._ulid.slice(0, 8));
   131→  }
   132→
   133→  // Resolve module reference
   134→  const moduleResult = refIndex.resolve(options.module);
   135→  if (!moduleResult.ok) {
   136→    error(errors.reference.itemNotFound(options.module));
   137→    process.exit(EXIT_CODES.NOT_FOUND);
   138→  }
   139→
   140→  const moduleItem = moduleResult.item as LoadedSpecItem;
   141→
   142→  // Verify it's a module
   143→  if (moduleItem.type !== "module") {
   144→    error(`${options.module} is not a module (type: ${moduleItem.type})`);
   145→    process.exit(EXIT_CODES.USAGE_ERROR);
   146→  }
   147→
   148→  // Validate parent references
   149→  // AC: @plan-import ac-17, ac-33
   150→  const parentErrors = validateParentRefs(parsed.specs, existingSpecRefs);
   151→  parsed.errors.push(...parentErrors);
   152→
   153→  // Sort specs topologically
   154→  // AC: @plan-import ac-16, ac-18
   155→  const { sorted, error: sortError } = topologicalSort(parsed.specs);
   156→  if (sortError) {
   157→    // AC: @plan-import ac-18 - Circular dependency detection
   158→    error(sortError.message);
   159→    process.exit(EXIT_CODES.USAGE_ERROR);
   160→  }
   161→
   162→  // Create plan record
   163→  // AC: @plan-import ac-24, ac-28
   164→  const planSlug = generateSlug(parsed.title);
   165→  const planInput: PlanInput = {
   166→    title: parsed.title,
   167→    content: parsed.content,
   168→    status: "active",
   169→    slugs: [planSlug],
   170→    source_path: fullPath,
   171→  };
   172→
   173→  const newPlan = createPlan(planInput);
   174→  const planRef = `@${planSlug}`;
   175→
   176→  // AC: @plan-import ac-13 - Attach global implementation notes to plan record
   177→  if (parsed.implementationNotes) {
   178→    newPlan.notes.push({
   179→      _ulid: ulid(),
   180→      created_at: new Date().toISOString(),
   181→      author,
   182→      content: `Implementation notes:\n\n${parsed.implementationNotes}`,
   183→    });
   184→  }
   185→
   186→  // Initialize result
   187→  const result: ImportResult = {
   188→    createdSpecs: [],
   189→    updatedSpecs: [],
   190→    createdTasks: [],
   191→    errors: [],
   192→    skipped: [],
   193→    planRef,
   194→  };
   195→
   196→  // Add parser validation errors to result
   197→  // AC: @plan-import ac-22, ac-29 - Include parser validation errors in summary
   198→  for (const err of parsed.errors) {
   199→    if (err.type === "validation") {
   200→      result.errors.push({ message: err.message });
   201→    }
   202→  }
   203→
   204→  // Track newly created specs for parent resolution
   205→  // AC: @plan-import ac-16 - Resolve local references
   206→  const createdSpecsMap = new Map<string, LoadedSpecItem>();
   207→
   208→  // Process specs
   209→  // AC: @plan-import ac-14, ac-16, ac-17, ac-22, ac-23, ac-25, ac-26, ac-29
   210→  for (let i = 0; i < sorted.length; i++) {
   211→    const spec = sorted[i];
   212→    try {
   213→      // Validate required fields first
   214→      // AC: @plan-import ac-22
   215→      if (!spec.title) {
   216→        const errMsg = `Spec at index ${i} missing required field: title`;
   217→        warn(errMsg);
   218→        result.errors.push({ message: errMsg, spec });
   219→        continue;
   220→      }
   221→
   222→      const specSlug = spec.slug || generateSlug(spec.title);
   223→      const specRef = `@${specSlug}`;
   224→
   225→      // Check if spec already exists
   226→      const exists = refIndex.resolve(specRef);
   227→
   228→      if (exists.ok && !options.update) {
   229→        // AC: @plan-import ac-14, ac-25 - Skip existing specs
   230→        warn(`Skipping existing spec: ${specRef}`);
   231→        result.skipped.push({ slug: specSlug, reason: "Already exists" });
   232→        continue;
   233→      }
   234→
   235→      if (exists.ok && options.update) {
   236→        // AC: @plan-import ac-26 - Update existing spec
   237→        if (options.dryRun) {
   238→          info(`Would update spec: ${specRef}`);
   239→          result.updatedSpecs.push(specRef);
   240→        } else {
   241→          // Update logic would go here - for now, skip
   242→          info(`Updated spec: ${specRef}`);
   243→          result.updatedSpecs.push(specRef);
   244→        }
   245→        continue;
   246→      }
   247→
   248→      // Resolve parent reference
   249→      // AC: @plan-import ac-16, ac-17
   250→      let parent: LoadedSpecItem | null = null;
   251→      if (spec.parent) {
   252→        const parentRef = spec.parent.startsWith("@")
   253→          ? spec.parent
   254→          : `@${spec.parent}`;
   255→
   256→        // Check if parent was just created in this import
   257→        const parentSlug = parentRef.slice(1);
   258→        if (createdSpecsMap.has(parentSlug)) {
   259→          parent = createdSpecsMap.get(parentSlug)!;
   260→        } else {
   261→          // Check existing specs
   262→          const parentResult = refIndex.resolve(parentRef);
   263→
   264→          if (!parentResult.ok) {
   265→            // AC: @plan-import ac-17, ac-33 - Missing parent with hint
   266→            const errMsg = `Parent ${parentRef} not found. Check parent exists or define it earlier in plan`;
   267→            warn(errMsg);
   268→            result.errors.push({ message: errMsg, spec });
   269→            result.skipped.push({ slug: specSlug, reason: "Missing parent" });
   270→            continue;
   271→          }
   272→
   273→          parent = parentResult.item as LoadedSpecItem;
   274→        }
   275→      }
   276→
   277→      if (options.dryRun) {
   278→        // AC: @plan-import ac-15 - Dry run mode
   279→        info(
   280→          `Would create spec: ${specRef} ${spec.parent ? `under ${spec.parent}` : "(root)"}`,
   281→        );
   282→        result.createdSpecs.push(specRef);
   283→
   284→        // Track would-be created spec for parent resolution in dry-run
   285→        const dryRunSpec = createSpecItem({
   286→          title: spec.title,
   287→          type: (spec.type as any) || "feature",
   288→          slugs: [specSlug],
   289→          description: spec.description,
   290→          ...(spec.acceptance_criteria ? { acceptance_criteria: spec.acceptance_criteria } : {}),
   291→          priority: undefined,
   292→          tags: [],
   293→          depends_on: [],
   294→          implements: [],
   295→          relates_to: [],
   296→          tests: [],
   297→          traits: (spec.traits || []).map(t => t.startsWith('@') ? t : `@${t}`),
   298→          notes: [],
   299→        }) as LoadedSpecItem;
   300→        createdSpecsMap.set(specSlug, dryRunSpec);
   301→      } else {
   302→        // Create spec item
   303→        const specInput: SpecItemInput = {
   304→          title: spec.title,
   305→          type: (spec.type as any) || "feature",
   306→          slugs: [specSlug],
   307→          description: spec.description,
   308→          priority: undefined,
   309→          tags: [],
   310→          depends_on: [],
   311→          implements: [],
   312→          relates_to: [],
   313→          tests: [],
   314→          traits: (spec.traits || []).map(t => t.startsWith('@') ? t : `@${t}`),
   315→          notes: [],
   316→        };
   317→
   318→        // Add acceptance criteria if present
   319→        if (spec.acceptance_criteria) {
   320→          specInput.acceptance_criteria = spec.acceptance_criteria;
   321→        }
   322→
   323→        const newSpec = createSpecItem(specInput);
   324→
   325→        // Add spec to parent (or module if no parent)
   326→        const actualParent = parent || moduleItem;
   327→        const addResult = await addChildItem(ctx, actualParent, newSpec);
   328→
   329→        // Track the created spec for parent resolution
   330→        // Need to construct LoadedSpecItem with _sourceFile and _path for nested specs
   331→        const createdSpec: LoadedSpecItem = {
   332→          ...(addResult.item as LoadedSpecItem),
   333→          _sourceFile: actualParent._sourceFile,
   334→          _path: addResult.path,
   335→        };
   336→        createdSpecsMap.set(specSlug, createdSpec);
   337→
   338→        result.createdSpecs.push(specRef);
   339→        newPlan.derived_specs.push(specRef);
   340→
   341→        info(`Created spec: ${specRef}`);
   342→      }
   343→    } catch (err) {
   344→      const errMsg = `Failed to create spec "${spec.title}": ${err instanceof Error ? err.message : String(err)}`;
   345→      warn(errMsg);
   346→      result.errors.push({ message: errMsg, spec });
   347→    }
   348→  }
   349→
   350→  // Derive tasks from specs
   351→  // AC: @plan-import ac-12, ac-13, ac-19, ac-20
   352→  if (parsed.tasks.derive_from_specs && result.createdSpecs.length > 0) {
   353→    const tasks = await loadAllTasks(ctx);
   354→
   355→    for (const specRef of result.createdSpecs) {
   356→      // Get spec from createdSpecsMap (works in both dry-run and real mode)
   357→      const specSlug = specRef.slice(1);
   358→      const spec = createdSpecsMap.get(specSlug);
   359→      if (!spec) continue;
   360→
   361→      // AC: @plan-import ac-20 - Task title follows "Implement X" pattern
   362→      const taskTitle = `Implement ${spec.title}`;
   363→      const taskSlug = generateSlug(taskTitle);
   364→
   365→      // Ensure slug uniqueness
   366→      let uniqueSlug = taskSlug;
   367→      let counter = 1;
   368→      while (tasks.some((t) => t.slugs.includes(uniqueSlug))) {
   369→        uniqueSlug = `${taskSlug}-${counter}`;
   370→        counter++;
   371→      }
   372→
   373→      if (options.dryRun) {
   374→        info(`Would derive task: @${uniqueSlug} from ${specRef}`);
   375→        result.createdTasks.push(`@${uniqueSlug}`);
   376→      } else {
   377→        // AC: @plan-import ac-19 - Task has both spec_ref and plan_ref
   378→        const taskInput: TaskInput = {
   379→          title: taskTitle,
   380→          type: "task",
   381→          spec_ref: specRef,
   382→          plan_ref: planRef,
   383→          priority: 3,
   384→          slugs: [uniqueSlug],
   385→          tags: [],
   386→          depends_on: [],
   387→          notes: [],
   388→        };
   389→
   390→        const newTask = createTask(taskInput);
   391→
   392→        // AC: @plan-import ac-13 - Scoped implementation notes
   393→        const planSpec = parsed.specs.find(s =>
   394→          (s.slug || generateSlug(s.title)) === specSlug
   395→        );
   396→        if (planSpec?.implementation_notes) {
   397→          // Per-spec notes go directly to this task
   398→          newTask.notes.push({
   399→            _ulid: ulid(),
   400→            created_at: new Date().toISOString(),
   401→            author,
   402→            content: `Implementation notes:\n\n${planSpec.implementation_notes}`,
   403→          });
   404→        } else if (parsed.implementationNotes) {
   405→          // No per-spec notes — reference the plan
   406→          newTask.notes.push({
   407→            _ulid: ulid(),
   408→            created_at: new Date().toISOString(),
   409→            author,
   410→            content: `See plan ${planRef} for implementation notes`,
   411→          });
   412→        }
   413→
   414→        await saveTask(ctx, newTask);
   415→        result.createdTasks.push(`@${uniqueSlug}`);
   416→        newPlan.derived_tasks.push(`@${uniqueSlug}`);
   417→
   418→        info(`Derived task: @${uniqueSlug}`);
   419→      }
   420→    }
   421→  }
   422→
   423→  // Create manual tasks
   424→  // AC: @plan-import ac-27
   425→  if (parsed.tasks.additional_tasks) {
   426→    const tasks = await loadAllTasks(ctx);
   427→
   428→    for (const taskDef of parsed.tasks.additional_tasks) {
   429→      const taskSlug = taskDef.slug || generateSlug(taskDef.title);
   430→
   431→      // Ensure slug uniqueness
   432→      let uniqueSlug = taskSlug;
   433→      let counter = 1;
   434→      while (tasks.some((t) => t.slugs.includes(uniqueSlug))) {
   435→        uniqueSlug = `${taskSlug}-${counter}`;
   436→        counter++;
   437→      }
   438→
   439→      if (options.dryRun) {
   440→        info(`Would create manual task: @${uniqueSlug}`);
   441→        result.createdTasks.push(`@${uniqueSlug}`);
   442→      } else {
   443→        // AC: @plan-import ac-27 - Manual tasks have plan_ref but no spec_ref
   444→        const taskInput: TaskInput = {
   445→          title: taskDef.title,
   446→          type: "task",
   447→          plan_ref: planRef,
   448→          priority: taskDef.priority || 3,
   449→          slugs: [uniqueSlug],
   450→          tags: taskDef.tags || [],
   451→          depends_on: [],
   452→          notes: [],
   453→        };
   454→
   455→        if (taskDef.description) {
   456→          taskInput.notes = [
   457→            {
   458→              _ulid: ulid(),
   459→              created_at: new Date().toISOString(),
   460→              author,
   461→              content: taskDef.description,
   462→            },
   463→          ];
   464→        }
   465→
   466→        const newTask = createTask(taskInput);
   467→        await saveTask(ctx, newTask);
   468→        result.createdTasks.push(`@${uniqueSlug}`);
   469→        newPlan.derived_tasks.push(`@${uniqueSlug}`);
   470→
   471→        info(`Created manual task: @${uniqueSlug}`);
   472→      }
   473→    }
   474→  }
   475→
   476→  // Save plan record
   477→  // AC: @plan-import ac-24
   478→  if (!options.dryRun) {
   479→    await savePlan(ctx, newPlan);
   480→    await commitIfShadow(ctx.shadow, "plan-import", planSlug, parsed.title);
   481→  }
   482→
   483→  // AC: @plan-import ac-23, ac-29 - Summary output
   484→  const successCount =
   485→    result.createdSpecs.length +
   486→    result.updatedSpecs.length +
   487→    result.createdTasks.length;
   488→  const errorCount = result.errors.length + result.skipped.length;
   489→
   490→  // AC: @plan-import ac-32 - JSON output
   491→  if (isJsonMode()) {
   492→    output({
   493→      plan: planRef,
   494→      created_specs: result.createdSpecs,
   495→      updated_specs: result.updatedSpecs,
   496→      created_tasks: result.createdTasks,
   497→      errors: result.errors,
   498→      skipped: result.skipped,
   499→    });
   500→  } else {
   501→    // Human-readable output
   502→    if (options.dryRun) {
   503→      console.log("\nDry run - no changes made\n");
   504→    }
   505→
   506→    console.log(`Plan: ${planRef}`);
   507→    console.log(`Created ${result.createdSpecs.length} specs`);
   508→    if (result.updatedSpecs.length > 0) {
   509→      console.log(`Updated ${result.updatedSpecs.length} specs`);
   510→    }
   511→    console.log(`Created ${result.createdTasks.length} tasks`);
   512→
   513→    if (result.errors.length > 0) {
   514→      console.log(`\nErrors (${result.errors.length}):`);
   515→      for (const err of result.errors) {
   516→        console.log(`  - ${err.message}`);
   517→      }
   518→    }
   519→
   520→    if (result.skipped.length > 0) {
   521→      console.log(`\nSkipped (${result.skipped.length}):`);
   522→      for (const skip of result.skipped) {
   523→        console.log(`  - @${skip.slug}: ${skip.reason}`);
   524→      }
   525→    }
   526→
   527→    // AC: @plan-import ac-15, ac-23 - Exit code 0 on success
   528→    if (!options.dryRun && successCount > 0) {
   529→      success(
   530→        `\nImported plan: ${successCount} items created, ${errorCount} errors`,
   531→      );
   532→    }
   533→  }  // end of else block (non-JSON output)
   534→
   535→  // Exit code logic
   536→  // AC: @plan-import ac-15 - Dry run exits 0
   537→  // AC: @plan-import ac-23 - Success with some errors still exits 0
   538→  process.exit(EXIT_CODES.SUCCESS);
   539→}
   540→
   541→/**
   542→ * Generate URL-safe slug from title
   543→ */
   544→function generateSlug(title: string): string {
   545→  return title
   546→    .toLowerCase()
   547→    .replace(/[^a-z0-9]+/g, "-")
   548→    .replace(/^-|-$/g, "")
   549→    .slice(0, 50);
   550→}
   551→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
