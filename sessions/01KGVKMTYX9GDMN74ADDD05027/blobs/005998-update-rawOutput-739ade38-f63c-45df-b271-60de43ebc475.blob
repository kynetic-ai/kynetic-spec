    40→
    41→/**
    42→ * Format a spec item for display
    43→ */
    44→function formatItem(
    45→  item: LoadedSpecItem,
    46→  verbose = false,
    47→  grepPattern?: string,
    48→): string {
    49→  const shortId = item._ulid.slice(0, 8);
    50→  const slugStr = item.slugs.length > 0 ? chalk.cyan(`@${item.slugs[0]}`) : "";
    51→  const typeStr = chalk.gray(`[${item.type}]`);
    52→
    53→  let status = "";
    54→  if (item.status && typeof item.status === "object") {
    55→    const s = item.status as { maturity?: string; implementation?: string };
    56→    if (s.implementation) {
    57→      const implColor =
    58→        s.implementation === "verified"
    59→          ? chalk.green
    60→          : s.implementation === "implemented"
    61→            ? chalk.cyan
    62→            : s.implementation === "in_progress"
    63→              ? chalk.yellow
    64→              : chalk.gray;
    65→      status = implColor(s.implementation);
    66→    } else if (s.maturity) {
    67→      status = chalk.gray(s.maturity);
    68→    }
    69→  }
    70→
    71→  let line = `${chalk.gray(shortId)} ${typeStr} ${item.title}`;
    72→  if (slugStr) line += ` ${slugStr}`;
    73→  if (status) line += ` ${status}`;
    74→
    75→  if (verbose) {
    76→    const tags = "tags" in item && Array.isArray(item.tags) ? item.tags : [];
    77→    if (tags.length > 0) {
    78→      line += chalk.blue(` #${tags.join(" #")}`);
    79→    }
    80→  }
    81→
    82→  // Show matched fields if grep pattern provided
    83→  if (grepPattern) {
    84→    const match = grepItem(
    85→      item as unknown as Record<string, unknown>,
    86→      grepPattern,
    87→    );
    88→    if (match && match.matchedFields.length > 0) {
    89→      line +=
    90→        "\n  " +
    91→        chalk.gray(`matched: ${formatMatchedFields(match.matchedFields)}`);
    92→    }
    93→  }
    94→
    95→  return line;
    96→}
    97→
    98→/**
    99→ * Format item list for display
   100→ */
   101→function formatItemList(
   102→  items: LoadedSpecItem[],
   103→  verbose = false,
   104→  grepPattern?: string,
   105→): void {
   106→  if (items.length === 0) {
   107→    console.log(chalk.gray("No items found"));
   108→    return;
   109→  }
   110→
   111→  for (const item of items) {
   112→    console.log(formatItem(item, verbose, grepPattern));
   113→  }
   114→
   115→  console.log(chalk.gray(`\n${items.length} item(s)`));
   116→}
   117→
   118→/**
   119→ * Format item list as a tree showing parent/child hierarchy
   120→ */
   121→function formatItemTree(
   122→  items: LoadedSpecItem[],
   123→  verbose = false,
   124→  grepPattern?: string,
   125→): void {
   126→  if (items.length === 0) {
   127→    console.log(chalk.gray("No items found"));
   128→    return;
   129→  }
   130→
   131→  // Build parent-child map
   132→  const childrenMap = new Map<string, LoadedSpecItem[]>();
   133→  const rootItems: LoadedSpecItem[] = [];
   134→
   135→  for (const item of items) {
   136→    const path = item._path || "";
   137→
   138→    // Determine parent path
   139→    let parentPath = "";
   140→    if (path) {
   141→      // Extract parent path from current path
   142→      // e.g., "features[0].requirements[1]" -> "features[0]"
   143→      const lastDotIndex = path.lastIndexOf(".");
   144→      if (lastDotIndex !== -1) {
   145→        parentPath = path.substring(0, lastDotIndex);
   146→      }
   147→    }
   148→
   149→    if (parentPath === "") {
   150→      // Root level item
   151→      rootItems.push(item);
   152→    } else {
   153→      // Find parent by path
   154→      const parent = items.find((i) => i._path === parentPath);
   155→      if (parent) {
   156→        const parentUlid = parent._ulid;
   157→        if (!childrenMap.has(parentUlid)) {
   158→          childrenMap.set(parentUlid, []);
   159→        }
   160→        childrenMap.get(parentUlid)?.push(item);
   161→      } else {
   162→        // Parent not in filtered list, show at root
   163→        rootItems.push(item);
   164→      }
   165→    }
   166→  }
   167→
   168→  // Recursive function to print tree
   169→  function printTree(item: LoadedSpecItem, prefix = "", isLast = true): void {
   170→    // Print current item with tree prefix
   171→    const connector = isLast ? "└── " : "├── ";
   172→    const itemLine = formatItem(item, verbose, grepPattern);
   173→    console.log(prefix + connector + itemLine);
   174→
   175→    // Print children
   176→    const children = childrenMap.get(item._ulid) || [];
   177→    const childPrefix = prefix + (isLast ? "    " : "│   ");
   178→
   179→    children.forEach((child, index) => {
   180→      const isLastChild = index === children.length - 1;
   181→      printTree(child, childPrefix, isLastChild);
   182→    });
   183→  }
   184→
   185→  // Print all root items
   186→  rootItems.forEach((item, index) => {
   187→    const isLast = index === rootItems.length - 1;
   188→    printTree(item, "", isLast);
   189→  });
   190→
   191→  console.log(chalk.gray(`\n${items.length} item(s)`));
   192→}
   193→
   194→/**
   195→ * Handle cascading status updates to child items
   196→ * Returns array of updated child items
   197→ */
   198→async function handleStatusCascade(
   199→  ctx: Awaited<ReturnType<typeof initContext>>,
   200→  parent: LoadedSpecItem,
   201→  newStatus: string,
   202→  allItems: LoadedSpecItem[],
   203→  refIndex: ReferenceIndex,
   204→): Promise<LoadedSpecItem[]> {
   205→  // Find direct children
   206→  const children = findChildItems(parent, allItems);
   207→
   208→  if (children.length === 0) {
   209→    return [];
   210→  }
   211→
   212→  // Skip prompt in JSON mode
   213→  if (isJsonMode()) {
   214→    return [];
   215→  }
   216→
   217→  // Prompt user for cascade
   218→  const readline = await import("node:readline");
   219→  const rl = readline.createInterface({
   220→    input: process.stdin,
   221→    output: process.stdout,
   222→  });
   223→
   224→  const answer = await new Promise<string>((resolve) => {
   225→    rl.question(
   226→      `Update ${children.length} child item(s) to ${newStatus}? [y/n] `,
   227→      resolve,
   228→    );
   229→  });
   230→  rl.close();
   231→
   232→  if (answer.toLowerCase() !== "y") {
   233→    return [];
   234→  }
   235→
   236→  // Update children
   237→  const updatedChildren: LoadedSpecItem[] = [];
   238→  for (const child of children) {
   239→    const currentStatus =
   240→      child.status && typeof child.status === "object"
   241→        ? child.status
   242→        : {
   243→            maturity: "draft" as const,
   244→            implementation: "not_started" as const,
   245→          };
   246→
   247→    const updates = {
   248→      status: {
   249→        maturity: currentStatus.maturity || ("draft" as const),
   250→        implementation: newStatus as ImplementationStatus,
   251→      },
   252→    };
   253→
   254→    const updated = await updateSpecItem(ctx, child, updates);
   255→    updatedChildren.push(updated);
   256→
   257→    // Log each child update (non-JSON mode only)
   258→    const childRef = child.slugs[0] || refIndex.shortUlid(child._ulid);
   259→    console.log(chalk.gray(`  ✓ Updated @${childRef}`));
   260→  }
   261→
   262→  return updatedChildren;
   263→}
   264→
   265→/**
   266→ * Register item commands
   267→ */
   268→export function registerItemCommands(program: Command): void {
   269→  const item = program.command("item").description("Spec item commands");
   270→
   271→  // kspec item list
   272→  item
   273→    .command("list")
   274→    .description("List spec items with optional filters")
   275→    .option(
   276→      "-t, --type <type>",
   277→      "Filter by item type (module, feature, requirement, constraint, decision)",
   278→    )
   279→    .option(
   280→      "-s, --status <status>",
   281→      "Filter by implementation status (not_started, in_progress, implemented, verified)",
   282→    )
   283→    .option(
   284→      "-m, --maturity <maturity>",
   285→      "Filter by maturity (draft, proposed, stable, deferred, deprecated)",
   286→    )
   287→    .option(
   288→      "--tag <tag>",
   289→      "Filter by tag (can specify multiple)",
   290→      (val, prev: string[]) => [...prev, val],
   291→      [],
   292→    )
   293→    .option(
   294→      "--has <field>",
   295→      "Filter items that have field present",
   296→      (val, prev: string[]) => [...prev, val],
   297→      [],
   298→    )
   299→    .option("-q, --search <text>", "Search in title")
   300→    .option("-g, --grep <pattern>", "Search content with regex pattern")
   301→    .option("-v, --verbose", "Show more details")
   302→    .option("--tree", "Show parent/child hierarchy")
   303→    .option("--limit <n>", "Limit results", "50")
   304→    .option("--count", "Show only the count of matching items")
   305→    .action(async (options) => {
   306→      try {
   307→        const ctx = await initContext();
   308→        const { itemIndex, items } = await buildIndexes(ctx);
   309→
   310→        // Build filter from options
   311→        const filter: ItemFilter = {
   312→          specItemsOnly: true, // Only spec items, not tasks
   313→        };
   314→
   315→        if (options.type) {
   316→          filter.type = options.type as ItemType;
   317→        }
   318→
   319→        if (options.status) {
   320→          filter.implementation = options.status as ImplementationStatus;
   321→        }
   322→
   323→        if (options.maturity) {
   324→          filter.maturity = options.maturity as Maturity;
   325→        }
   326→
   327→        if (options.tag && options.tag.length > 0) {
   328→          filter.tags = parseTagsArray(options.tag);
   329→        }
   330→
   331→        if (options.has && options.has.length > 0) {
   332→          filter.hasFields = options.has;
   333→        }
   334→
   335→        if (options.search) {
   336→          filter.titleContains = options.search;
   337→        }
   338→
   339→        if (options.grep) {
   340→          filter.grepSearch = options.grep;
   341→        }
   342→
   343→        const limit = parseInt(options.limit, 10) || 50;
   344→        const result = itemIndex.queryPaginated(filter, 0, limit);
   345→
   346→        // Filter to only LoadedSpecItem (not tasks)
   347→        const specItems = result.items.filter(
   348→          (item): item is LoadedSpecItem =>
   349→            !("status" in item && typeof item.status === "string"),
   350→        );
   351→
   352→        // AC: @trait-filterable-list ac-8
   353→        if (options.count) {
   354→          output({ count: result.total }, () => {
   355→            console.log(result.total);
   356→          });
   357→          return;
   358→        }
   359→
   360→        output(
   361→          {
   362→            items: specItems,
   363→            total: result.total,
   364→            showing: specItems.length,
   365→            grepPattern: options.grep,
   366→            tree: options.tree,
   367→          },
   368→          () => {
   369→            if (options.tree) {
   370→              formatItemTree(specItems, options.verbose, options.grep);
   371→            } else {
   372→              formatItemList(specItems, options.verbose, options.grep);
   373→            }
   374→          },
   375→        );
   376→      } catch (err) {
   377→        error(errors.failures.listItems, err);
   378→        process.exit(EXIT_CODES.ERROR);
   379→      }
   380→    });
   381→
   382→  // kspec item get <ref>
   383→  item
   384→    .command("get <ref>")
   385→    .description("Get details for a specific item")
   386→    .action(async (ref) => {
   387→      try {
   388→        const ctx = await initContext();
   389→        const { refIndex, traitIndex, items } = await buildIndexes(ctx);
   390→
   391→        const result = refIndex.resolve(ref);
   392→
   393→        if (!result.ok) {
   394→          error(errors.reference.itemNotFound(ref));
   395→          process.exit(EXIT_CODES.ERROR);
   396→        }
   397→
   398→        const item = result.item as LoadedSpecItem;
   399→
   400→        // AC: @trait-display ac-2 - JSON mode includes inherited_traits array
   401→        const inheritedTraits = traitIndex.getInheritedAC(item._ulid);
   402→        const traitsByTrait = new Map<
   403→          string,
   404→          {
   405→            trait: (typeof inheritedTraits)[0]["trait"];
   406→            acs: AcceptanceCriterion[];
   407→          }
   408→        >();
   409→        for (const { trait, ac } of inheritedTraits) {
   410→          if (!traitsByTrait.has(trait.ulid)) {
   411→            traitsByTrait.set(trait.ulid, { trait, acs: [] });
   412→          }
   413→          traitsByTrait.get(trait.ulid)?.acs.push(ac);
   414→        }
   415→
   416→        // Build JSON output with inherited traits
   417→        const jsonOutput = {
   418→          ...item,
   419→          inherited_traits: Array.from(traitsByTrait.values()).map(
   420→            ({ trait, acs }) => ({
   421→              ref: `@${trait.slug}`,
   422→              title: trait.title,
   423→              acceptance_criteria: acs,
   424→            }),
   425→          ),
   426→        };
   427→
   428→        output(jsonOutput, () => {
   429→          console.log(chalk.bold(item.title));
   430→          console.log(chalk.gray("─".repeat(40)));
   431→          console.log(`${fieldLabels.ulid}      ${item._ulid}`);
   432→          if (item.slugs.length > 0) {
   433→            console.log(`${fieldLabels.slugs}     ${item.slugs.join(", ")}`);
   434→          }
   435→          console.log(`${fieldLabels.type}      ${item.type}`);
   436→
   437→          if (item.status && typeof item.status === "object") {
   438→            const s = item.status as {
   439→              maturity?: string;
   440→              implementation?: string;
   441→            };
   442→            if (s.maturity)
   443→              console.log(`${fieldLabels.maturity}  ${s.maturity}`);
   444→            if (s.implementation) {
   445→              // AC: @trait-retrospective ac-4
   446→              // Show retrospective verification source
   447→              const isRetrospective = item.traits?.includes(
   448→                "@trait-retrospective",
   449→              );
   450→              const statusLabel = isRetrospective
   451→                ? `${s.implementation} (retrospective)`
   452→                : s.implementation;
   453→              console.log(`${fieldLabels.implementation}${statusLabel}`);
   454→            }
   455→          }
   456→
   457→          // AC: @trait-retrospective ac-4
   458→          // Show verification metadata for retrospective specs
   459→          const isRetrospective = item.traits?.includes("@trait-retrospective");
   460→          if (isRetrospective && (item.verified_at || item.verified_by)) {
   461→            const verifiedDate = item.verified_at
   462→              ? new Date(item.verified_at).toISOString().split("T")[0]
   463→              : "unknown";
   464→            const verifiedBy = item.verified_by || "unknown";
   465→            console.log(`Verified:   ${verifiedDate} by ${verifiedBy}`);
   466→          }
   467→
   468→          if (
   469→            "tags" in item &&
   470→            Array.isArray(item.tags) &&
   471→            item.tags.length > 0
   472→          ) {
   473→            console.log(`${fieldLabels.tags}      ${item.tags.join(", ")}`);
   474→          }
   475→
   476→          // AC: @item-get ac-4
   477→          if (Array.isArray(item.depends_on) && item.depends_on.length > 0) {
   478→            console.log(`${fieldLabels.dependsOn} ${item.depends_on.join(", ")}`);
   479→          }
   480→          if (Array.isArray(item.implements) && item.implements.length > 0) {
   481→            console.log(`${fieldLabels.implements} ${item.implements.join(", ")}`);
   482→          }
   483→          if (Array.isArray(item.relates_to) && item.relates_to.length > 0) {
   484→            console.log(`${fieldLabels.relatesTo} ${item.relates_to.join(", ")}`);
   485→          }
   486→
   487→          if (item.description) {
   488→            console.log(`\n${sectionHeaders.description}`);
   489→            console.log(item.description);
   490→          }
   491→
   492→          // AC: @trait-display ac-1 - Show own AC first
   493→          if (
   494→            "acceptance_criteria" in item &&
   495→            Array.isArray(item.acceptance_criteria) &&
   496→            item.acceptance_criteria.length > 0
   497→          ) {
   498→            console.log(`\n${sectionHeaders.acceptanceCriteria}`);
   499→            for (const ac of item.acceptance_criteria) {
   500→              if (ac && typeof ac === "object" && "id" in ac) {
   501→                const acObj = ac as AcceptanceCriterion;
   502→                console.log(chalk.cyan(`  [${acObj.id}]`));
   503→                if (acObj.given) console.log(`    Given: ${acObj.given}`);
   504→                if (acObj.when) console.log(`    When: ${acObj.when}`);
   505→                if (acObj.then) console.log(`    Then: ${acObj.then}`);
   506→              }
   507→            }
   508→          }
   509→
   510→          // AC: @trait-display ac-1, ac-4, ac-5 - Show inherited AC per trait in labeled sections
   511→          if (traitsByTrait.size > 0) {
   512→            for (const { trait, acs } of traitsByTrait.values()) {
   513→              console.log(
   514→                chalk.gray(`\n─── Inherited from @${trait.slug} ───`),
   515→              );
   516→              for (const ac of acs) {
   517→                console.log(
   518→                  chalk.cyan(`  [${ac.id}]`) +
   519→                    chalk.gray(` (from @${trait.slug})`),
   520→                );
   521→                if (ac.given) console.log(`    Given: ${ac.given}`);
   522→                if (ac.when) console.log(`    When: ${ac.when}`);
   523→                if (ac.then) console.log(`    Then: ${ac.then}`);
   524→              }
   525→            }
   526→          }
   527→        });
   528→      } catch (err) {
   529→        error(errors.failures.getItem, err);
   530→        process.exit(EXIT_CODES.ERROR);
   531→      }
   532→    });
   533→
   534→  // kspec item types - show available types and counts
   535→  item
   536→    .command("types")
   537→    .description("Show item types and counts")
   538→    .action(async () => {
   539→      try {
   540→        const ctx = await initContext();
   541→        const { itemIndex } = await buildIndexes(ctx);
   542→
   543→        const typeCounts = itemIndex.getTypeCounts();
   544→
   545→        output(Object.fromEntries(typeCounts), () => {
   546→          console.log(chalk.bold("Item Types"));
   547→          console.log(chalk.gray("─".repeat(30)));
   548→          for (const [type, count] of typeCounts) {
   549→            console.log(`  ${type}: ${count}`);
   550→          }
   551→          console.log(chalk.gray(`\nTotal: ${itemIndex.size} items`));
   552→        });
   553→      } catch (err) {
   554→        error(errors.failures.getTypes, err);
   555→        process.exit(EXIT_CODES.ERROR);
   556→      }
   557→    });
   558→
   559→  // kspec item tags - show available tags and counts
   560→  item
   561→    .command("tags")
   562→    .description("Show tags and counts")
   563→    .action(async () => {
   564→      try {
   565→        const ctx = await initContext();
   566→        const { itemIndex } = await buildIndexes(ctx);
   567→
   568→        const tagCounts = itemIndex.getTagCounts();
   569→
   570→        output(Object.fromEntries(tagCounts), () => {
   571→          console.log(chalk.bold("Tags"));
   572→          console.log(chalk.gray("─".repeat(30)));
   573→          for (const [tag, count] of tagCounts) {
   574→            console.log(`  #${tag}: ${count}`);
   575→          }
   576→        });
   577→      } catch (err) {
   578→        error(errors.failures.getTags, err);
   579→        process.exit(EXIT_CODES.ERROR);
   580→      }
   581→    });
   582→
   583→  // kspec item add - create a new spec item under a parent
   584→  markMutating(item.command("add"))
   585→    .description("Create a new spec item under a parent")
   586→    .requiredOption(
   587→      "--under <ref>",
   588→      "Parent item reference (e.g., @core-primitives)",
   589→    )
   590→    .requiredOption("--title <title>", "Item title")
   591→    .option(
   592→      "--type <type>",
   593→      "Item type (feature, requirement, constraint, decision)",
   594→      "feature",
   595→    )
   596→    .option("--slug <slug>", "Human-friendly slug")
   597→    .option("--priority <priority>", "Priority (high, medium, low)")
   598→    .option("--tag <tag...>", "Tags")
   599→    .option("--description <desc>", "Description")
   600→    .option(
   601→      "--as <field>",
   602→      "Child field override (e.g., requirements, constraints)",
   603→    )
   604→    .addHelpText(
   605→      "after",
   606→      `
   607→Examples:
   608→  $ kspec item add --under @parent --title "Feature name" --type feature
   609→  $ kspec item add --under @parent --title "Multi-tag" --tag api public`,
   610→    )
   611→    .action(async (options) => {
   612→      try {
   613→        const ctx = await initContext();
   614→        const { refIndex, items } = await buildIndexes(ctx);
   615→
   616→        // Find the parent item
   617→        const parentResult = refIndex.resolve(options.under);
   618→        if (!parentResult.ok) {
   619→          error(errors.reference.itemNotFound(options.under));
   620→          process.exit(EXIT_CODES.ERROR);
   621→        }
   622→
   623→        const parent = parentResult.item as LoadedSpecItem;
   624→
   625→        // Check it's not a task
   626→        if ("status" in parent && typeof parent.status === "string") {
   627→          error(errors.reference.parentIsTask(options.under));
   628→          process.exit(EXIT_CODES.ERROR);
   629→        }
   630→
   631→        // Check slug uniqueness if provided
   632→        if (options.slug) {
   633→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   634→          if (!slugCheck.ok) {
   635→            error(
   636→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
   637→            );
   638→            process.exit(EXIT_CODES.CONFLICT);
   639→          }
   640→        }
   641→
   642→        const input: SpecItemInput = {
   643→          title: options.title,
   644→          type: options.type as ItemType,
   645→          slugs: options.slug ? [options.slug] : [],
   646→          priority: options.priority,
   647→          tags: parseTagsArray(options.tag),
   648→          description: options.description,
   649→          depends_on: [],
   650→          implements: [],
   651→          relates_to: [],
   652→          tests: [],
   653→          traits: [],
   654→          notes: [],
   655→        };
   656→
   657→        const newItem = createSpecItem(input);
   658→        const result = await addChildItem(ctx, parent, newItem, options.as);
   659→
   660→        // Build index including the new item for accurate short ULID
   661→        const index = new ReferenceIndex(
   662→          [],
   663→          [...items, result.item as LoadedSpecItem],
   664→        );
   665→        const itemSlug =
   666→          (result.item as LoadedSpecItem).slugs?.[0] ||
   667→          index.shortUlid(result.item._ulid);
   668→        await commitIfShadow(ctx.shadow, "item-add", itemSlug);
   669→        success(
   670→          `Created item: ${index.shortUlid(result.item._ulid)} under @${parent.slugs[0] || parent._ulid.slice(0, 8)}`,
   671→          {
   672→            item: result.item,
   673→            path: result.path,
   674→          },
   675→        );
   676→
   677→        // Derive hint
   678→        if (!isJsonMode()) {
   679→          const refSlug =
   680→            (result.item as LoadedSpecItem).slugs?.[0] ||
   681→            index.shortUlid(result.item._ulid);
   682→          console.log(
   683→            chalk.gray(
   684→              `\nDerive implementation task? kspec derive @${refSlug}`,
   685→            ),
   686→          );
   687→        }
   688→      } catch (err) {
   689→        error(errors.failures.createItem, err);
   690→        process.exit(EXIT_CODES.ERROR);
   691→      }
   692→    });
   693→
   694→  // kspec item set - update a spec item field
   695→  markMutating(item.command("set <ref>"))
   696→    .description("Update a spec item field")
   697→    .option("--title <title>", "Set title")
   698→    .option("--type <type>", "Set type")
   699→    .option("--slug <slug>", "Add a slug")
   700→    .option("--remove-slug <slug>", "Remove a slug")
   701→    .option("--priority <priority>", "Set priority")
   702→    .option("--tag <tag...>", "Set tags (replaces existing)")
   703→    .option("--description <desc>", "Set description")
   704→    .option(
   705→      "--status <status>",
   706→      "Set implementation status (not_started, in_progress, implemented, verified)",
   707→    )
   708→    .option(
   709→      "--maturity <maturity>",
   710→      "Set maturity (draft, proposed, stable, deferred, deprecated)",
   711→    )
   712→    .option(
   713→      "--verified-by <agent-ref>",
   714→      "Set verified_by (for retrospective specs)",
   715→    )
   716→    .option(
   717→      "--verified-at <iso-timestamp>",
   718→      "Set verified_at (defaults to now if --verified-by provided)",
   719→    )
   720→    .option("--trait <trait...>", "Set traits (replaces existing)")
   721→    .addHelpText(
   722→      "after",
   723→      `
   724→Examples:
   725→  $ kspec item set @item-ref --title "New title"
   726→  $ kspec item set @item-ref --tag api internal security
   727→  $ kspec item set @item-ref --trait reusable testable`,
   728→    )
   729→    .action(async (ref, options) => {
   730→      try {
   731→        const ctx = await initContext();
   732→        const { refIndex, items } = await buildIndexes(ctx);
   733→
   734→        const result = refIndex.resolve(ref);
   735→        if (!result.ok) {
   736→          error(errors.reference.itemNotFound(ref));
   737→          process.exit(EXIT_CODES.ERROR);
   738→        }
   739→
   740→        const foundItem = result.item as LoadedSpecItem;
   741→
   742→        // Check if it's a task (tasks should use task commands)
   743→        if ("status" in foundItem && typeof foundItem.status === "string") {
   744→          error(errors.reference.taskUseTaskCommands(ref));
   745→          process.exit(EXIT_CODES.ERROR);
   746→        }
   747→
   748→        // Check slug uniqueness if adding a new slug
   749→        if (options.slug) {
   750→          const slugCheck = checkSlugUniqueness(
   751→            refIndex,
   752→            [options.slug],
   753→            foundItem._ulid,
   754→          );
   755→          if (!slugCheck.ok) {
   756→            error(
   757→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
   758→            );
   759→            process.exit(EXIT_CODES.CONFLICT);
   760→          }
   761→        }
   762→
   763→        // Validate --remove-slug
   764→        if (options.removeSlug) {
   765→          const currentSlugs = foundItem.slugs || [];
   766→          if (!currentSlugs.includes(options.removeSlug)) {
   767→            error(errors.slug.notFound(options.removeSlug));
   768→            process.exit(EXIT_CODES.ERROR);
   769→          }
   770→          if (currentSlugs.length === 1) {
   771→            error(errors.slug.cannotRemoveLast(options.removeSlug));
   772→            process.exit(EXIT_CODES.ERROR);
   773→          }
   774→        }
   775→
   776→        // Build updates object
   777→        const updates: Partial<SpecItemInput> = {};
   778→
   779→        if (options.title) updates.title = options.title;
   780→        if (options.type) updates.type = options.type as ItemType;
   781→        if (options.slug || options.removeSlug) {
   782→          let slugs = [...(foundItem.slugs || [])];
   783→          if (options.removeSlug) {
   784→            slugs = slugs.filter((s) => s !== options.removeSlug);
   785→          }
   786→          if (options.slug) {
   787→            slugs.push(options.slug);
   788→          }
   789→          updates.slugs = slugs;
   790→        }
   791→        if (options.priority) updates.priority = options.priority;
   792→        if (options.tag) updates.tags = parseTagsArray(options.tag);
   793→        if (options.trait) updates.traits = options.trait;
   794→        if (options.description) updates.description = options.description;
   795→
   796→        // Handle status updates
   797→        if (options.status || options.maturity) {
   798→          const currentStatus =
   799→            foundItem.status && typeof foundItem.status === "object"
   800→              ? foundItem.status
   801→              : {};
   802→          updates.status = {
   803→            ...currentStatus,
   804→            ...(options.status && { implementation: options.status }),
   805→            ...(options.maturity && { maturity: options.maturity }),
   806→          };
   807→        }
   808→
   809→        // Handle verification metadata (for retrospective specs)
   810→        if (options.verifiedBy) {
   811→          updates.verified_by = options.verifiedBy;
   812→          // Default verified_at to now if not specified
   813→          updates.verified_at = options.verifiedAt || new Date().toISOString();
   814→        } else if (options.verifiedAt) {
   815→          updates.verified_at = options.verifiedAt;
   816→        }
   817→
   818→        if (Object.keys(updates).length === 0) {
   819→          warn("No updates specified");
   820→          return;
   821→        }
   822→
   823→        const updated = await updateSpecItem(ctx, foundItem, updates);
   824→        const itemSlug =
   825→          foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   826→
   827→        // Handle cascade for implementation status updates
   828→        const updatedItems: LoadedSpecItem[] = [updated];
   829→        if (options.status) {
   830→          const cascadeResult = await handleStatusCascade(
   831→            ctx,
   832→            updated,
   833→            options.status,
   834→            items,
   835→            refIndex,
   836→          );
   837→          updatedItems.push(...cascadeResult);
   838→        }
   839→
   840→        await commitIfShadow(ctx.shadow, "item-set", itemSlug);
   841→        success(`Updated item: ${refIndex.shortUlid(updated._ulid)}`, {
   842→          item: updated,
   843→        });
   844→
   845→        // Derive hint
   846→        if (!isJsonMode()) {
   847→          const refSlug =
   848→            updated.slugs?.[0] || refIndex.shortUlid(updated._ulid);
   849→          console.log(
   850→            chalk.gray(
   851→              `\nDerive implementation task? kspec derive @${refSlug}`,
   852→            ),
   853→          );
   854→        }
   855→      } catch (err) {
   856→        error(errors.failures.updateItem, err);
   857→        process.exit(EXIT_CODES.ERROR);
   858→      }
   859→    });
   860→
   861→  // kspec item delete - delete a spec item
   862→  markMutating(item.command("delete <ref>"))
   863→    .description("Delete a spec item (including nested items)")
   864→    .option("--force", "Skip confirmation")
   865→    .option("--cascade", "Delete item and all descendants")
   866→    .action(async (ref, options) => {
   867→      try {
   868→        const ctx = await initContext();
   869→        const { refIndex, items } = await buildIndexes(ctx);
   870→
   871→        const result = refIndex.resolve(ref);
   872→        if (!result.ok) {
   873→          error(errors.reference.itemNotFound(ref));
   874→          process.exit(EXIT_CODES.ERROR);
   875→        }
   876→
   877→        const foundItem = result.item as LoadedSpecItem;
   878→
   879→        // Check if it's a task
   880→        if ("status" in foundItem && typeof foundItem.status === "string") {
   881→          error(errors.reference.itemUseTaskCancel(ref));
   882→          process.exit(EXIT_CODES.ERROR);
   883→        }
   884→
   885→        if (!foundItem._sourceFile) {
   886→          error(errors.operation.cannotDeleteNoSource);
   887→          process.exit(EXIT_CODES.ERROR);
   888→        }
   889→
   890→        // AC: @spec-item-delete-children ac-7 - Check if this is a trait with implementors
   891→        const implementors = findTraitImplementors(foundItem, items);
   892→        if (implementors.length > 0) {
   893→          const implementorRefs = implementors
   894→            .map((i) => `@${i.slugs[0] || i._ulid.slice(0, 8)}`)
   895→            .join(", ");
   896→          const errorMsg = `Cannot delete: trait is used by ${implementors.length} specs. Remove trait from specs first: ${implementorRefs}`;
   897→
   898→          if (isJsonMode()) {
   899→            error(errorMsg, {
   900→              error: "trait_in_use",
   901→              implementors: implementors.map((i) => ({
   902→                ulid: i._ulid,
   903→                slug: i.slugs[0],
   904→                title: i.title,
   905→              })),
   906→            });
   907→          } else {
   908→            error(errorMsg);
   909→          }
   910→          process.exit(EXIT_CODES.ERROR);
   911→        }
   912→
   913→        // AC: @spec-item-delete-children ac-1 ac-8 - Check for child items (nested YAML items, not relates_to refs)
   914→        const children = findChildItems(foundItem, items);
   915→
   916→        if (children.length > 0 && !options.cascade) {
   917→          // AC: @spec-item-delete-children ac-1 - Block deletion if children exist without --cascade
   918→          const errorMsg = `Cannot delete: item has ${children.length} children. Use --cascade to delete recursively`;
   919→
   920→          if (isJsonMode()) {
   921→            // AC: @spec-item-delete-children ac-10 - JSON error includes children array
   922→            error(errorMsg, {
   923→              error: "has_children",
   924→              children: children.map((c) => ({
   925→                ulid: c._ulid,
   926→                slug: c.slugs[0],
   927→                title: c.title,
   928→                ref: `@${c.slugs[0] || c._ulid.slice(0, 8)}`,
   929→              })),
   930→            });
   931→          } else {
   932→            error(errorMsg);
   933→          }
   934→          process.exit(EXIT_CODES.ERROR);
   935→        }
   936→
   937→        // AC: @spec-item-delete-children ac-9 - Custom confirmation prompt for cascade
   938→        if (children.length > 0 && options.cascade && !options.force) {
   939→          const itemRef = `@${foundItem.slugs[0] || foundItem._ulid.slice(0, 8)}`;
   940→
   941→          // Check for JSON mode - requires --force
   942→          if (isJsonMode()) {
   943→            error("Confirmation required. Use --force with --json");
   944→            process.exit(EXIT_CODES.ERROR);
   945→          }
   946→
   947→          // Check for non-interactive environment
   948→          const isTTY =
   949→            process.env.KSPEC_TEST_TTY === "true" || process.stdin.isTTY;
   950→          if (!isTTY) {
   951→            error("Non-interactive environment. Use --force to proceed");
   952→            process.exit(EXIT_CODES.ERROR);
   953→          }
   954→
   955→          // Show confirmation prompt
   956→          const readline = await import("node:readline");
   957→          const rl = readline.createInterface({
   958→            input: process.stdin,
   959→            output: process.stdout,
   960→          });
   961→
   962→          const response = await new Promise<string>((resolve) => {
   963→            rl.question(
   964→              chalk.yellow(
   965→                `Delete ${itemRef} and ${children.length} descendant items? [y/N] `,
   966→              ),
   967→              (answer) => {
   968→                rl.close();
   969→                resolve(answer);
   970→              },
   971→            );
   972→          });
   973→
   974→          if (response.toLowerCase() !== "y") {
   975→            console.log(chalk.gray("Operation cancelled"));
   976→            process.exit(EXIT_CODES.USAGE_ERROR);
   977→          }
   978→        }
   979→
   980→        // AC: @spec-item-delete-children ac-2 ac-3 - Delete item and all descendants with cascade
   981→        const itemsToDelete = options.cascade
   982→          ? [foundItem, ...children]
   983→          : [foundItem];
   984→        let deletedCount = 0;
   985→
   986→        // Delete in reverse order (deepest first) to avoid path issues
   987→        const sortedItems = [...itemsToDelete].sort((a, b) => {
   988→          const aDepth = a._path ? a._path.split(".").length : 0;
   989→          const bDepth = b._path ? b._path.split(".").length : 0;
   990→          return bDepth - aDepth;
   991→        });
   992→
   993→        for (const itemToDelete of sortedItems) {
   994→          const deleted = await deleteSpecItem(ctx, itemToDelete);
   995→          if (deleted) {
   996→            deletedCount++;
   997→          }
   998→        }
   999→
  1000→        if (deletedCount > 0) {
  1001→          // AC: @spec-item-delete-children ac-6 - Single shadow commit with all deletions
  1002→          const itemSlug =
  1003→            foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
  1004→          const commitMsg =
  1005→            deletedCount > 1 ? `${deletedCount} items` : itemSlug;
  1006→          await commitIfShadow(ctx.shadow, "item-delete", commitMsg);
  1007→
  1008→          if (deletedCount > 1) {
  1009→            success(`Deleted ${deletedCount} items`, {
  1010→              deleted: deletedCount,
  1011→              root_ulid: foundItem._ulid,
  1012→            });
  1013→          } else {
  1014→            success(`Deleted item: ${foundItem.title}`, {
  1015→              deleted: true,
  1016→              ulid: foundItem._ulid,
  1017→            });
  1018→          }
  1019→        } else {
  1020→          error(errors.failures.deleteItem);
  1021→          console.log(
  1022→            chalk.gray(
  1023→              `Edit the source file directly: ${foundItem._sourceFile}`,
  1024→            ),
  1025→          );
  1026→          process.exit(EXIT_CODES.ERROR);
  1027→        }
  1028→      } catch (err) {
  1029→        error(errors.failures.deleteItem, err);
  1030→        process.exit(EXIT_CODES.ERROR);
  1031→      }
  1032→    });
  1033→
  1034→  // kspec item patch - update item fields via JSON
  1035→  markMutating(item.command("patch [ref]"))
  1036→    .description("Update spec item fields via JSON patch")
  1037→    .option("--data <json>", "JSON data to patch")
  1038→    .option("--bulk", "Read patches from stdin (JSONL or JSON array)")
  1039→    .option("--allow-unknown", "Allow fields not in schema")
  1040→    .option("--dry-run", "Preview changes without applying")
  1041→    .option("--fail-fast", "Stop on first error (bulk mode)")
  1042→    .action(async (ref: string | undefined, options) => {
  1043→      try {
  1044→        const ctx = await initContext();
  1045→
  1046→        if (options.bulk) {
  1047→          // Bulk mode: read from stdin
  1048→          const stdin = await readStdinFully();
  1049→          if (!stdin) {
  1050→            error(errors.validation.noInputProvided);
  1051→            process.exit(EXIT_CODES.ERROR);
  1052→          }
  1053→
  1054→          let patches: PatchOperation[];
  1055→          try {
  1056→            patches = parseBulkInput(stdin);
  1057→          } catch (err) {
  1058→            error(
  1059→              errors.validation.failedToParseBulk(
  1060→                err instanceof Error ? err.message : String(err),
  1061→              ),
  1062→            );
  1063→            process.exit(EXIT_CODES.ERROR);
  1064→          }
  1065→
  1066→          if (patches.length === 0) {
  1067→            error(errors.validation.noPatchesProvided);
  1068→            process.exit(EXIT_CODES.ERROR);
  1069→          }
  1070→
  1071→          const { refIndex, items } = await buildIndexes(ctx);
  1072→          const result = await patchSpecItems(ctx, refIndex, items, patches, {
  1073→            allowUnknown: options.allowUnknown,
  1074→            failFast: options.failFast,
  1075→            dryRun: options.dryRun,
  1076→          });
  1077→
  1078→          // Shadow commit if any updates
  1079→          if (!options.dryRun && result.summary.updated > 0) {
  1080→            await commitIfShadow(
  1081→              ctx.shadow,
  1082→              "item-patch",
  1083→              `${result.summary.updated} items`,
  1084→            );
  1085→          }
  1086→
  1087→          output(result, () => formatBulkPatchResult(result, options.dryRun));
  1088→
  1089→          if (result.summary.failed > 0) {
  1090→            process.exit(EXIT_CODES.ERROR);
  1091→          }
  1092→        } else {
  1093→          // Single item mode
  1094→          if (!ref) {
  1095→            error(errors.usage.patchNeedRef);
  1096→            process.exit(EXIT_CODES.ERROR);
  1097→          }
  1098→
  1099→          let data: Record<string, unknown>;
  1100→
  1101→          // Get data from --data option or stdin
  1102→          if (options.data) {
  1103→            try {
  1104→              data = JSON.parse(options.data);
  1105→            } catch (err) {
  1106→              error(
  1107→                errors.validation.invalidJsonInData(
  1108→                  err instanceof Error ? err.message : "",
  1109→                ),
  1110→              );
  1111→              process.exit(EXIT_CODES.ERROR);
  1112→            }
  1113→          } else {
  1114→            const stdin = await readStdinIfAvailable();
  1115→            if (stdin) {
  1116→              try {
  1117→                data = JSON.parse(stdin.trim());
  1118→              } catch (err) {
  1119→                error(
  1120→                  errors.validation.invalidJsonFromStdin(
  1121→                    err instanceof Error ? err.message : "",
  1122→                  ),
  1123→                );
  1124→                process.exit(EXIT_CODES.ERROR);
  1125→              }
  1126→            } else {
  1127→              error(errors.validation.noPatchData);
  1128→              process.exit(EXIT_CODES.ERROR);
  1129→            }
  1130→          }
  1131→
  1132→          // Validate against schema (unless --allow-unknown)
  1133→          if (!options.allowUnknown) {
  1134→            // Use strict schema (no passthrough)
  1135→            const strictSchema = SpecItemPatchSchema.strict();
  1136→            const parseResult = strictSchema.safeParse(data);
  1137→            if (!parseResult.success) {
  1138→              const issues = parseResult.error.issues
  1139→                .map((i) => `${i.path.join(".")}: ${i.message}`)
  1140→                .join("; ");
  1141→              error(errors.validation.invalidPatchDataWithIssues(issues));
  1142→              process.exit(EXIT_CODES.ERROR);
  1143→            }
  1144→          }
  1145→
  1146→          const { refIndex, items } = await buildIndexes(ctx);
  1147→
  1148→          // Resolve ref
  1149→          const resolved = refIndex.resolve(ref);
  1150→          if (!resolved.ok) {
  1151→            error(errors.reference.itemNotFound(ref));
  1152→            process.exit(EXIT_CODES.ERROR);
  1153→          }
  1154→
  1155→          // Find the item
  1156→          const foundItem = items.find((i) => i._ulid === resolved.ulid);
  1157→          if (!foundItem) {
  1158→            error(errors.reference.notItem(ref));
  1159→            process.exit(EXIT_CODES.ERROR);
  1160→          }
  1161→
  1162→          if (options.dryRun) {
  1163→            output(
  1164→              {
  1165→                ref,
  1166→                data,
  1167→                wouldApplyTo: foundItem.title,
  1168→                ulid: foundItem._ulid,
  1169→              },
  1170→              () => {
  1171→                console.log(chalk.yellow("Would patch:"), foundItem.title);
  1172→                console.log(chalk.gray("ULID:"), foundItem._ulid.slice(0, 8));
  1173→                console.log(chalk.gray("Changes:"));
  1174→                console.log(JSON.stringify(data, null, 2));
  1175→              },
  1176→            );
  1177→            return;
  1178→          }
  1179→
  1180→          const updated = await updateSpecItem(ctx, foundItem, data);
  1181→          const itemSlug =
  1182→            foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
  1183→          await commitIfShadow(ctx.shadow, "item-patch", itemSlug);
  1184→
  1185→          success(`Patched item: ${itemSlug}`, { item: updated });
  1186→        }
  1187→      } catch (err) {
  1188→        error(errors.failures.patchItems, err);
  1189→        process.exit(EXIT_CODES.ERROR);
  1190→      }
  1191→    });
  1192→
  1193→  // kspec item status - show implementation status with linked tasks
  1194→  item
  1195→    .command("status <ref>")
  1196→    .description("Show implementation status and linked tasks for a spec item")
  1197→    .action(async (ref) => {
  1198→      try {
  1199→        const ctx = await initContext();
  1200→        const tasks = await loadAllTasks(ctx);
  1201→        const items = await loadAllItems(ctx);
  1202→        const refIndex = new ReferenceIndex(tasks, items);
  1203→
  1204→        const result = refIndex.resolve(ref);
  1205→        if (!result.ok) {
  1206→          error(errors.reference.itemNotFound(ref));
  1207→          process.exit(EXIT_CODES.ERROR);
  1208→        }
  1209→
  1210→        const foundItem = result.item as LoadedSpecItem;
  1211→
  1212→        // Check if it's a task
  1213→        if ("status" in foundItem && typeof foundItem.status === "string") {
  1214→          error(errors.reference.notItem(ref));
  1215→          process.exit(EXIT_CODES.ERROR);
  1216→        }
  1217→
  1218→        // Build alignment index
  1219→        const alignmentIndex = new AlignmentIndex(tasks, items);
  1220→        alignmentIndex.buildLinks(refIndex);
  1221→
  1222→        const summary = alignmentIndex.getImplementationSummary(
  1223→          foundItem._ulid,
  1224→        );
  1225→
  1226→        if (!summary) {
  1227→          error(errors.project.couldNotGetImplSummary);
  1228→          process.exit(EXIT_CODES.ERROR);
  1229→        }
  1230→
  1231→        output(summary, () => {
  1232→          console.log(chalk.bold(foundItem.title));
  1233→          console.log(chalk.gray("─".repeat(40)));
  1234→
  1235→          // Status
  1236→          const currentColor =
  1237→            summary.currentStatus === "implemented"
  1238→              ? chalk.green
  1239→              : summary.currentStatus === "in_progress"
  1240→                ? chalk.yellow
  1241→                : chalk.gray;
  1242→          const expectedColor =
  1243→            summary.expectedStatus === "implemented"
  1244→              ? chalk.green
  1245→              : summary.expectedStatus === "in_progress"
  1246→                ? chalk.yellow
  1247→                : chalk.gray;
  1248→
  1249→          console.log(
  1250→            `Current status:  ${currentColor(summary.currentStatus)}`,
  1251→          );
  1252→          console.log(
  1253→            `Expected status: ${expectedColor(summary.expectedStatus)}`,
  1254→          );
  1255→
  1256→          if (!summary.isAligned) {
  1257→            console.log(
  1258→              chalk.yellow("\n⚠ Status mismatch - run task complete to sync"),
  1259→            );
  1260→          } else {
  1261→            console.log(chalk.green("\n✓ Aligned"));
  1262→          }
  1263→
  1264→          // Linked tasks
  1265→          console.log(chalk.bold("\nLinked Tasks:"));
  1266→          if (summary.linkedTasks.length === 0) {
  1267→            console.log(chalk.gray("  No tasks reference this spec item"));
  1268→          } else {
  1269→            for (const task of summary.linkedTasks) {
  1270→              const statusColor =
  1271→                task.taskStatus === "completed"
  1272→                  ? chalk.green
  1273→                  : task.taskStatus === "in_progress"
  1274→                    ? chalk.blue
  1275→                    : chalk.gray;
  1276→              const shortId = task.taskUlid.slice(0, 8);
  1277→              const notes = task.hasNotes ? chalk.gray(" (has notes)") : "";
  1278→              console.log(
  1279→                `  ${statusColor(`[${task.taskStatus}]`)} ${shortId} ${task.taskTitle}${notes}`,
  1280→              );
  1281→            }
  1282→          }
  1283→        });
  1284→      } catch (err) {
  1285→        error(errors.failures.getItemStatus, err);
  1286→        process.exit(EXIT_CODES.ERROR);
  1287→      }
  1288→    });
  1289→
  1290→  // kspec item note <ref> <message>
  1291→  markMutating(item.command("note <ref> <message>"))
  1292→    .description("Add a note to a spec item")
  1293→    .option("--author <author>", "Note author")
  1294→    .option("--supersedes <ulid>", "ULID of note this supersedes")
  1295→    .action(async (ref: string, message: string, options) => {
  1296→      try {
  1297→        const ctx = await initContext();
  1298→        const items = await loadAllItems(ctx);
  1299→        const tasks = await loadAllTasks(ctx);
  1300→        const refIndex = new ReferenceIndex(tasks, items);
  1301→
  1302→        const result = refIndex.resolve(ref);
  1303→        if (!result.ok) {
  1304→          error(errors.reference.itemNotFound(ref));
  1305→          process.exit(EXIT_CODES.ERROR);
  1306→        }
  1307→
  1308→        const foundItem = items.find((i) => i._ulid === result.ulid);
  1309→        if (!foundItem) {
  1310→          error(errors.reference.itemNotFound(ref));
  1311→          process.exit(EXIT_CODES.ERROR);
  1312→        }
  1313→
  1314→        const note = createNote(message, options.author, options.supersedes);
  1315→
  1316→        const updatedNotes = [...(foundItem.notes || []), note];
  1317→        await updateSpecItem(ctx, foundItem, { notes: updatedNotes });
  1318→
  1319→        const itemSlug =
  1320→          foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
  1321→        await commitIfShadow(ctx.shadow, "item-note", itemSlug);
  1322→        success(
  1323→          `Added note to spec item: ${refIndex.shortUlid(foundItem._ulid)}`,
  1324→          { note },
  1325→        );
  1326→      } catch (err) {
  1327→        error(errors.failures.addNote, err);
  1328→        process.exit(EXIT_CODES.ERROR);
  1329→      }
  1330→    });
  1331→
  1332→  // kspec item notes <ref>
  1333→  item
  1334→    .command("notes <ref>")
  1335→    .description("Show notes for a spec item")
  1336→    .action(async (ref: string) => {
  1337→      try {
  1338→        const ctx = await initContext();
  1339→        const items = await loadAllItems(ctx);
  1340→        const tasks = await loadAllTasks(ctx);
  1341→        const refIndex = new ReferenceIndex(tasks, items);
  1342→
  1343→        const result = refIndex.resolve(ref);
  1344→        if (!result.ok) {
  1345→          error(errors.reference.itemNotFound(ref));
  1346→          process.exit(EXIT_CODES.ERROR);
  1347→        }
  1348→
  1349→        const foundItem = items.find((i) => i._ulid === result.ulid);
  1350→        if (!foundItem) {
  1351→          error(errors.reference.itemNotFound(ref));
  1352→          process.exit(EXIT_CODES.ERROR);
  1353→        }
  1354→
  1355→        const notes = foundItem.notes || [];
  1356→        output(notes, () => {
  1357→          if (notes.length === 0) {
  1358→            console.log("No notes");
  1359→          } else {
  1360→            for (const note of notes) {
  1361→              const author = note.author || "unknown";
  1362→              console.log(`[${note.created_at}] ${author}:`);
  1363→              console.log(note.content);
  1364→              console.log("");
  1365→            }
  1366→          }
  1367→        });
  1368→      } catch (err) {
  1369→        error(errors.failures.getNotes, err);
  1370→        process.exit(EXIT_CODES.ERROR);
  1371→      }
  1372→    });
  1373→
  1374→  // Create subcommand group for acceptance criteria operations
  1375→  const acCmd = item
  1376→    .command("ac")
  1377→    .description("Manage acceptance criteria on spec items");
  1378→
  1379→  // Helper: Generate next AC ID based on existing AC
  1380→  function generateNextAcId(
  1381→    existingAc: AcceptanceCriterion[] | undefined,
  1382→  ): string {
  1383→    if (!existingAc || existingAc.length === 0) return "ac-1";
  1384→
  1385→    const numericIds = existingAc
  1386→      .map((ac) => ac.id.match(/^ac-(\d+)$/)?.[1])
  1387→      .filter((id): id is string => id !== null && id !== undefined)
  1388→      .map(Number);
  1389→
  1390→    const maxId = numericIds.length > 0 ? Math.max(...numericIds) : 0;
  1391→    return `ac-${maxId + 1}`;
  1392→  }
  1393→
  1394→  // Helper: Resolve ref to spec item (not task)
  1395→  async function resolveSpecItem(ref: string): Promise<{
  1396→    ctx: Awaited<ReturnType<typeof initContext>>;
  1397→    item: LoadedSpecItem;
  1398→    refIndex: ReferenceIndex;
  1399→  }> {
  1400→    const ctx = await initContext();
  1401→    const { refIndex, items } = await buildIndexes(ctx);
  1402→
  1403→    const result = refIndex.resolve(ref);
  1404→    if (!result.ok) {
  1405→      error(errors.reference.itemNotFound(ref));
  1406→      process.exit(EXIT_CODES.NOT_FOUND);
  1407→    }
  1408→
  1409→    const foundItem = result.item as LoadedSpecItem;
  1410→
  1411→    // Check if it's a task
  1412→    if ("status" in foundItem && typeof foundItem.status === "string") {
  1413→      error(errors.operation.tasksNoAcceptanceCriteria(ref));
  1414→      process.exit(EXIT_CODES.NOT_FOUND);
  1415→    }
  1416→
  1417→    return { ctx, item: foundItem, refIndex };
  1418→  }
  1419→
  1420→  // kspec item ac list <ref>
  1421→  acCmd
  1422→    .command("list <ref>")
  1423→    .description("List acceptance criteria for a spec item")
  1424→    .action(async (ref: string) => {
  1425→      try {
  1426→        const { item, refIndex } = await resolveSpecItem(ref);
  1427→        const ac = item.acceptance_criteria || [];
  1428→
  1429→        output(ac, () => {
  1430→          console.log(
  1431→            chalk.bold(
  1432→              `Acceptance Criteria for: ${item.title} (@${item.slugs[0] || refIndex.shortUlid(item._ulid)})`,
  1433→            ),
  1434→          );
  1435→          console.log();
  1436→
  1437→          if (ac.length === 0) {
  1438→            console.log(chalk.gray("No acceptance criteria"));
  1439→          } else {
  1440→            for (const criterion of ac) {
  1441→              console.log(chalk.cyan(`  [${criterion.id}]`));
  1442→              console.log(chalk.gray(`    Given: ${criterion.given}`));
  1443→              console.log(chalk.gray(`    When:  ${criterion.when}`));
  1444→              console.log(chalk.gray(`    Then:  ${criterion.then}`));
  1445→              console.log();
  1446→            }
  1447→          }
  1448→
  1449→          console.log(chalk.gray(`${ac.length} acceptance criteria`));
  1450→        });
  1451→      } catch (err) {
  1452→        error(errors.failures.listAc, err);
  1453→        process.exit(EXIT_CODES.ERROR);
  1454→      }
  1455→    });
  1456→
  1457→  // kspec item ac add <ref>
  1458→  markMutating(acCmd.command("add <ref>"))
  1459→    .description("Add an acceptance criterion to a spec item")
  1460→    .option("--id <id>", "AC identifier (auto-generated if not provided)")
  1461→    .requiredOption("--given <text>", "The precondition (Given...)")
  1462→    .requiredOption("--when <text>", "The action/trigger (When...)")
  1463→    .requiredOption("--then <text>", "The expected outcome (Then...)")
  1464→    .action(async (ref: string, options) => {
  1465→      try {
  1466→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1467→        const existingAc = item.acceptance_criteria || [];
  1468→
  1469→        // Determine ID
  1470→        const acId = options.id || generateNextAcId(existingAc);
  1471→
  1472→        // Check for duplicate ID
  1473→        if (existingAc.some((ac) => ac.id === acId)) {
  1474→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1475→          error(errors.conflict.acAlreadyExists(acId, itemRef));
  1476→          process.exit(EXIT_CODES.CONFLICT);
  1477→        }
  1478→
  1479→        // Create new AC
  1480→        const newAc: AcceptanceCriterion = {
  1481→          id: acId,
  1482→          given: options.given,
  1483→          when: options.when,
  1484→          then: options.then,
  1485→        };
  1486→
  1487→        // Update item with new AC
  1488→        const updatedAc = [...existingAc, newAc];
  1489→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1490→
  1491→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1492→        await commitIfShadow(ctx.shadow, "item-ac-add", itemSlug);
  1493→        success(`Added acceptance criterion: ${acId} to @${itemSlug}`, {
  1494→          ac: newAc,
  1495→        });
  1496→      } catch (err) {
  1497→        error(errors.failures.addAc, err);
  1498→        process.exit(EXIT_CODES.ERROR);
  1499→      }
  1500→    });
  1501→
  1502→  // kspec item ac set <ref> <ac-id>
  1503→  markMutating(acCmd.command("set <ref> <acId>"))
  1504→    .description("Update an acceptance criterion")
  1505→    .option("--id <newId>", "Rename the AC ID")
  1506→    .option("--given <text>", "Update the precondition")
  1507→    .option("--when <text>", "Update the action/trigger")
  1508→    .option("--then <text>", "Update the expected outcome")
  1509→    .action(async (ref: string, acId: string, options) => {
  1510→      try {
  1511→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1512→        const existingAc = item.acceptance_criteria || [];
  1513→
  1514→        // Find the AC
  1515→        const acIndex = existingAc.findIndex((ac) => ac.id === acId);
  1516→        if (acIndex === -1) {
  1517→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1518→          error(errors.reference.acNotFound(acId, itemRef));
  1519→          process.exit(EXIT_CODES.NOT_FOUND);
  1520→        }
  1521→
  1522→        // Check for no updates
  1523→        if (!options.id && !options.given && !options.when && !options.then) {
  1524→          warn("No updates specified");
  1525→          return;
  1526→        }
  1527→
  1528→        // Check for duplicate ID if renaming
  1529→        if (
  1530→          options.id &&
  1531→          options.id !== acId &&
  1532→          existingAc.some((ac) => ac.id === options.id)
  1533→        ) {
  1534→          error(errors.conflict.acIdAlreadyExists(options.id));
  1535→          process.exit(EXIT_CODES.CONFLICT);
  1536→        }
  1537→
  1538→        // Build updated AC
  1539→        const updatedAc = [...existingAc];
  1540→        const updatedFields: string[] = [];
  1541→
  1542→        updatedAc[acIndex] = {
  1543→          ...updatedAc[acIndex],
  1544→          ...(options.id && { id: options.id }),
  1545→          ...(options.given && { given: options.given }),
  1546→          ...(options.when && { when: options.when }),
  1547→          ...(options.then && { then: options.then }),
  1548→        };
  1549→
  1550→        if (options.id) updatedFields.push("id");
  1551→        if (options.given) updatedFields.push("given");
  1552→        if (options.when) updatedFields.push("when");
  1553→        if (options.then) updatedFields.push("then");
  1554→
  1555→        // Update item
  1556→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1557→
  1558→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1559→        await commitIfShadow(ctx.shadow, "item-ac-set", itemSlug);
  1560→        success(
  1561→          `Updated acceptance criterion: ${acId} on @${itemSlug} (${updatedFields.join(", ")})`,
  1562→          { ac: updatedAc[acIndex] },
  1563→        );
  1564→      } catch (err) {
  1565→        error(errors.failures.updateAc, err);
  1566→        process.exit(EXIT_CODES.ERROR);
  1567→      }
  1568→    });
  1569→
  1570→  // kspec item ac remove <ref> <ac-id>
  1571→  markMutating(acCmd.command("remove <ref> <acId>"))
  1572→    .description("Remove an acceptance criterion")
  1573→    .option("--force", "Skip confirmation")
  1574→    .action(async (ref: string, acId: string, options) => {
  1575→      try {
  1576→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1577→        const existingAc = item.acceptance_criteria || [];
  1578→
  1579→        // Find the AC
  1580→        const acIndex = existingAc.findIndex((ac) => ac.id === acId);
  1581→        if (acIndex === -1) {
  1582→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1583→          error(errors.reference.acNotFound(acId, itemRef));
  1584→          process.exit(EXIT_CODES.NOT_FOUND);
  1585→        }
  1586→
  1587→        // Confirmation required unless --force
  1588→        if (!options.force) {
  1589→          // AC: @spec-item-delete-children ac-5 - JSON mode requires --force
  1590→          if (isJsonMode()) {
  1591→            error("Confirmation required. Use --force with --json");
  1592→            process.exit(EXIT_CODES.ERROR);
  1593→          }
  1594→
  1595→          // AC: @spec-item-delete-children ac-6 - Non-interactive environment requires --force
  1596→          // Allow KSPEC_TEST_TTY for testing interactive prompts
  1597→          const isTTY =
  1598→            process.env.KSPEC_TEST_TTY === "1" || process.stdin.isTTY;
  1599→          if (!isTTY) {
  1600→            error("Non-interactive environment. Use --force to proceed");
  1601→            process.exit(EXIT_CODES.ERROR);
  1602→          }
  1603→
  1604→          // AC: @spec-item-delete-children ac-1 - Prompt for confirmation
  1605→          const readline = await import("node:readline");
  1606→          const rl = readline.createInterface({
  1607→            input: process.stdin,
  1608→            output: process.stdout,
  1609→          });
  1610→
  1611→          const answer = await new Promise<string>((resolve) => {
  1612→            rl.question(`Remove acceptance criterion ${acId}? [y/N] `, resolve);
  1613→          });
  1614→          rl.close();
  1615→
  1616→          // AC: @spec-item-delete-children ac-3 - User declines (n, N, or empty)
  1617→          if (answer.toLowerCase() !== "y") {
  1618→            error("Operation cancelled");
  1619→            process.exit(EXIT_CODES.USAGE_ERROR);
  1620→          }
  1621→        }
  1622→
  1623→        // AC: @spec-item-delete-children ac-4 - With --force, proceed immediately without prompt
  1624→        // AC: @spec-item-delete-children ac-2 - User confirmed, proceed with removal
  1625→        const updatedAc = existingAc.filter((ac) => ac.id !== acId);
  1626→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1627→
  1628→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1629→        await commitIfShadow(ctx.shadow, "item-ac-remove", itemSlug);
  1630→        success(`Removed acceptance criterion: ${acId} from @${itemSlug}`, {
  1631→          removed: acId,
  1632→        });
  1633→      } catch (err) {
  1634→        error(errors.failures.removeAc, err);
  1635→        process.exit(EXIT_CODES.ERROR);
  1636→      }
  1637→    });
  1638→}
  1639→
  1640→// ─── Patch Helpers ───────────────────────────────────────────────────────────
  1641→
  1642→/**
  1643→ * Read stdin fully with timeout (for bulk input).
  1644→ * Returns null if stdin is a TTY or empty.
  1645→ */
  1646→async function readStdinFully(): Promise<string | null> {
  1647→  if (process.stdin.isTTY) {
  1648→    return null;
  1649→  }
  1650→
  1651→  return new Promise((resolve) => {
  1652→    let data = "";
  1653→    const timeout = setTimeout(() => {
  1654→      process.stdin.removeAllListeners();
  1655→      resolve(data || null);
  1656→    }, 5000); // 5 second timeout for bulk input
  1657→
  1658→    process.stdin.setEncoding("utf8");
  1659→    process.stdin.on("data", (chunk) => {
  1660→      data += chunk;
  1661→    });
  1662→    process.stdin.on("end", () => {
  1663→      clearTimeout(timeout);
  1664→      resolve(data || null);
  1665→    });
  1666→    process.stdin.on("error", () => {
  1667→      clearTimeout(timeout);
  1668→      resolve(null);
  1669→    });
  1670→    process.stdin.resume();
  1671→  });
  1672→}
  1673→
  1674→/**
  1675→ * Read stdin if available (non-blocking for single item mode).
  1676→ * Returns null quickly if no data available.
  1677→ */
  1678→async function readStdinIfAvailable(): Promise<string | null> {
  1679→  if (process.stdin.isTTY) {
  1680→    return null;
  1681→  }
  1682→
  1683→  return new Promise((resolve) => {
  1684→    let data = "";
  1685→    const timeout = setTimeout(() => {
  1686→      process.stdin.removeAllListeners();
  1687→      resolve(data || null);
  1688→    }, 100); // 100ms timeout for quick check
  1689→
  1690→    process.stdin.setEncoding("utf8");
  1691→    process.stdin.on("data", (chunk) => {
  1692→      data += chunk;
  1693→    });
  1694→    process.stdin.on("end", () => {
  1695→      clearTimeout(timeout);
  1696→      resolve(data || null);
  1697→    });
  1698→    process.stdin.on("error", () => {
  1699→      clearTimeout(timeout);
  1700→      resolve(null);
  1701→    });
  1702→    process.stdin.resume();
  1703→  });
  1704→}
  1705→
  1706→/**
  1707→ * Parse bulk input (JSONL or JSON array)
  1708→ */
  1709→function parseBulkInput(input: string): PatchOperation[] {
  1710→  const trimmed = input.trim();
  1711→
  1712→  // Try JSON array first
  1713→  if (trimmed.startsWith("[")) {
  1714→    const parsed = JSON.parse(trimmed);
  1715→    if (!Array.isArray(parsed)) {
  1716→      throw new Error(errors.validation.expectedJsonArray);
  1717→    }
  1718→    return parsed.map((item, i) => validatePatchOperation(item, i));
  1719→  }
  1720→
  1721→  // Parse as JSONL (one JSON object per line)
  1722→  const lines = trimmed.split("\n").filter((line) => line.trim());
  1723→  return lines.map((line, i) => {
  1724→    try {
  1725→      return validatePatchOperation(JSON.parse(line), i);
  1726→    } catch (err) {
  1727→      throw new Error(
  1728→        errors.validation.jsonLineError(
  1729→          i + 1,
  1730→          err instanceof Error ? err.message : "Invalid JSON",
  1731→        ),
  1732→      );
  1733→    }
  1734→  });
  1735→}
  1736→
  1737→/**
  1738→ * Validate a patch operation object
  1739→ */
  1740→function validatePatchOperation(obj: unknown, index: number): PatchOperation {
  1741→  if (!obj || typeof obj !== "object") {
  1742→    throw new Error(errors.validation.patchMustBeObject(index));
  1743→  }
  1744→  const op = obj as Record<string, unknown>;
  1745→  if (typeof op.ref !== "string" || !op.ref) {
  1746→    throw new Error(errors.validation.patchMustHaveRef(index));
  1747→  }
  1748→  if (!op.data || typeof op.data !== "object") {
  1749→    throw new Error(errors.validation.patchMustHaveData(index));
  1750→  }
  1751→  return { ref: op.ref, data: op.data as Record<string, unknown> };
  1752→}
  1753→
  1754→/**
  1755→ * Format bulk patch result for human output
  1756→ */
  1757→function formatBulkPatchResult(
  1758→  result: BulkPatchResult,
  1759→  isDryRun = false,
  1760→): void {
  1761→  const prefix = isDryRun ? "Would patch" : "Patched";
  1762→
  1763→  for (const r of result.results) {
  1764→    if (r.status === "updated") {
  1765→      console.log(
  1766→        chalk.green("OK"),
  1767→        `${prefix}: ${r.ref} (${r.ulid?.slice(0, 8)})`,
  1768→      );
  1769→    } else if (r.status === "error") {
  1770→      console.log(chalk.red("ERR"), `${r.ref}: ${r.error}`);
  1771→    } else {
  1772→      console.log(chalk.gray("SKIP"), r.ref);
  1773→    }
  1774→  }
  1775→
  1776→  console.log("");
  1777→  console.log(chalk.bold("Summary:"));
  1778→  console.log(`  Total: ${result.summary.total}`);
  1779→  console.log(chalk.green(`  Updated: ${result.summary.updated}`));
  1780→  if (result.summary.failed > 0) {
  1781→    console.log(chalk.red(`  Failed: ${result.summary.failed}`));
  1782→  }
  1783→  if (result.summary.skipped > 0) {
  1784→    console.log(chalk.gray(`  Skipped: ${result.summary.skipped}`));
  1785→  }
  1786→}
  1787→

