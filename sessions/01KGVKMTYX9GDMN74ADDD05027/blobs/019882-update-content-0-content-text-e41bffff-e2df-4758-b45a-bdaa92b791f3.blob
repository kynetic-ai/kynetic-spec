   322→  // AC: @cli-ralph ac-12 - Event logging
   323→  it('logs prompt.sent events', async () => {
   324→    const result = runRalph('--max-loops 1', tempDir, {
   325→      MOCK_ACP_EXIT_CODE: '0',
   326→    });
