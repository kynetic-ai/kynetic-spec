   453→
   454→// ─── Event Translator Unit Tests ────────────────────────────────────────────
   455→
   456→describe('ralph event translator', () => {
   457→  // Helper to create SessionUpdate objects
   458→  function makeChunk(
   459→    type: 'agent_message_chunk' | 'agent_thought_chunk',
   460→    text: string
   461→  ): SessionUpdate {
   462→    return {
   463→      sessionUpdate: type,
   464→      content: { type: 'text', text },
   465→    } as SessionUpdate;
   466→  }
   467→
   468→  describe('agent_message_chunk', () => {
   469→    it('translates streaming content', () => {
   470→      const translator = createTranslator();
   471→      const event = translator.translate(makeChunk('agent_message_chunk', 'Hello'));
   472→
   473→      expect(event).not.toBeNull();
   474→      expect(event!.type).toBe('agent_message');
   475→      expect(event!.data).toMatchObject({
   476→        kind: 'agent_message',
   477→        content: 'Hello',
   478→        isStreaming: true,
   479→      });
   480→    });
   481→
   482→    it('finalizes on empty string signal', () => {
   483→      const translator = createTranslator();
   484→
   485→      // First, stream some content
   486→      translator.translate(makeChunk('agent_message_chunk', 'Hello'));
   487→      translator.translate(makeChunk('agent_message_chunk', ' world'));
   488→
   489→      // Then send empty string to finalize
   490→      const finalEvent = translator.translate(makeChunk('agent_message_chunk', ''));
   491→
   492→      expect(finalEvent).not.toBeNull();
   493→      expect(finalEvent!.type).toBe('agent_message');
   494→      expect(finalEvent!.data).toMatchObject({
   495→        kind: 'agent_message',
   496→        content: 'Hello world',
   497→        isStreaming: false,
   498→      });
   499→    });
   500→
   501→    it('returns null for empty string when no active message', () => {
   502→      const translator = createTranslator();
   503→
   504→      // Send empty string without prior content
   505→      const event = translator.translate(makeChunk('agent_message_chunk', ''));
   506→
   507→      expect(event).toBeNull();
   508→    });
   509→  });
   510→
   511→  describe('agent_thought_chunk', () => {
   512→    it('translates streaming thought content', () => {
   513→      const translator = createTranslator();
   514→      const event = translator.translate(makeChunk('agent_thought_chunk', 'Thinking...'));
   515→
   516→      expect(event).not.toBeNull();
   517→      expect(event!.type).toBe('agent_thought');
   518→      expect(event!.data).toMatchObject({
   519→        kind: 'agent_thought',
   520→        content: 'Thinking...',
   521→        isStreaming: true,
   522→      });
   523→    });
   524→
   525→    it('finalizes on empty string signal', () => {
   526→      const translator = createTranslator();
   527→
   528→      // Stream some thought content
   529→      translator.translate(makeChunk('agent_thought_chunk', 'Let me think'));
   530→      translator.translate(makeChunk('agent_thought_chunk', ' about this'));
   531→
   532→      // Finalize with empty string
   533→      const finalEvent = translator.translate(makeChunk('agent_thought_chunk', ''));
   534→
   535→      expect(finalEvent).not.toBeNull();
   536→      expect(finalEvent!.type).toBe('agent_thought');
   537→      expect(finalEvent!.data).toMatchObject({
   538→        kind: 'agent_thought',
   539→        content: 'Let me think about this',
   540→        isStreaming: false,
   541→      });
   542→    });
   543→  });
   544→
   545→  describe('finalize()', () => {
   546→    it('returns final event for pending message', () => {
   547→      const translator = createTranslator();
   548→
   549→      // Stream content without empty string finalization
   550→      translator.translate(makeChunk('agent_message_chunk', 'Incomplete'));
   551→
   552→      // Call finalize explicitly
   553→      const finalEvent = translator.finalize();
   554→
   555→      expect(finalEvent).not.toBeNull();
   556→      expect(finalEvent!.type).toBe('agent_message');
   557→      expect(finalEvent!.data).toMatchObject({
   558→        kind: 'agent_message',
   559→        content: 'Incomplete',
   560→        isStreaming: false,
   561→      });
   562→    });
   563→
   564→    it('returns null when no pending message', () => {
   565→      const translator = createTranslator();
   566→
   567→      const event = translator.finalize();
   568→
   569→      expect(event).toBeNull();
   570→    });
