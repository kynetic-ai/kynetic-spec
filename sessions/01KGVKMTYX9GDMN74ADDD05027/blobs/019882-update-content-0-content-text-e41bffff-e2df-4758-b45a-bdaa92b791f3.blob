   342→
   343→  // AC: @cli-ralph ac-13 - Context snapshot saving
   344→  it('saves session context snapshot after each iteration', async () => {
   345→    const result = runRalph('--max-loops 2', tempDir, {
   346→      MOCK_ACP_EXIT_CODE: '0',
   347→    });
   348→
   349→    // Check that context snapshots were saved
   350→    const sessionsDir = path.join(tempDir, 'sessions');
   351→    const sessions = await fs.readdir(sessionsDir).catch(() => []);
   352→
   353→    expect(sessions.length).toBeGreaterThan(0);
   354→
   355→    if (sessions.length > 0) {
   356→      const sessionDir = path.join(sessionsDir, sessions[0]);
   357→
   358→      // Should have context snapshots for iteration 1 and 2
   359→      const context1Path = path.join(sessionDir, 'context-iter-1.json');
   360→      const context2Path = path.join(sessionDir, 'context-iter-2.json');
   361→
   362→      const context1Exists = await fs.access(context1Path).then(() => true).catch(() => false);
   363→      const context2Exists = await fs.access(context2Path).then(() => true).catch(() => false);
   364→
   365→      expect(context1Exists).toBe(true);
   366→      expect(context2Exists).toBe(true);
   367→
   368→      // Verify context structure
   369→      const context1Content = await fs.readFile(context1Path, 'utf-8');
   370→      const context1 = JSON.parse(context1Content);
   371→
   372→      expect(context1).toHaveProperty('generated_at');
   373→      expect(context1).toHaveProperty('branch');
   374→      expect(context1).toHaveProperty('active_tasks');
   375→      expect(context1).toHaveProperty('ready_tasks');
   376→      expect(context1).toHaveProperty('stats');
   377→    }
   378→  });
