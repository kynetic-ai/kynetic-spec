   199→    expect(result.stdout).not.toContain('### 3. Pick or Continue a Task');
   200→    expect(result.stdout).not.toContain('### 4. Do the Work');
   201→    expect(result.stdout).not.toContain('kspec task start @task-ref');
   202→    expect(result.stdout).not.toContain('kspec task note @task-ref');
