   231→  });
   232→
   233→  // AC: @cli-ralph ac-7 - Retry on error
   234→  it('retries iteration on failure', async () => {
   235→    // Fail twice then succeed
   236→    const result = runRalph('--max-loops 1 --max-retries 3', tempDir, {
   237→      MOCK_ACP_FAIL_COUNT: '2',
   238→      MOCK_ACP_STATE_FILE: stateFile,
   239→    });
   240→
   241→    expect(result.stdout).toContain('Retry attempt 1/3');
   242→    expect(result.stdout).toContain('Retry attempt 2/3');
   243→    expect(result.stdout).toContain('Completed iteration 1');
   244→  });
   245→
   246→  it('continues to next iteration after retries exhausted', async () => {
   247→    // Always fail
   248→    const result = runRalph('--max-loops 2 --max-retries 1 --max-failures 3', tempDir, {
   249→      MOCK_ACP_EXIT_CODE: '1',
   250→    });
   251→
   252→    expect(result.output).toContain('failed after 2 attempts');
   253→    expect(result.output).toContain('Continuing to next iteration');
   254→    expect(result.output).toContain('Iteration 2/2');
   255→  });
   256→
   257→  // AC: @cli-ralph ac-8 - Consecutive failure guard
   258→  it('exits after max consecutive failures', async () => {
   259→    // Always fail
   260→    const result = runRalph('--max-loops 10 --max-retries 0 --max-failures 2', tempDir, {
   261→      MOCK_ACP_EXIT_CODE: '1',
   262→    });
   263→
   264→    expect(result.output).toContain('1/2 consecutive failures');
   265→    expect(result.output).toContain('2/2 consecutive failures');
   266→    expect(result.output).toContain('Reached 2 consecutive failures');
   267→    // Should not continue to iteration 3
   268→    expect(result.output).not.toContain('Iteration 3/10');
   269→  });
   270→
   271→  it('resets failure count on success', async () => {
   272→    // For simplicity, just verify a success resets the pattern
   273→    const result = runRalph('--max-loops 2 --max-retries 0', tempDir, {
   274→      MOCK_ACP_EXIT_CODE: '0',
   275→    });
   276→
   277→    expect(result.output).toContain('Completed iteration 1');
   278→    expect(result.output).toContain('Completed iteration 2');
   279→    expect(result.output).not.toContain('consecutive failures');
   280→  });
   281→
   282→  // AC: @cli-ralph ac-9 - Adapter selection
   283→  it('uses specified adapter', async () => {
   284→    const result = runRalph('--dry-run --adapter custom --adapter-cmd "echo test"', tempDir);
