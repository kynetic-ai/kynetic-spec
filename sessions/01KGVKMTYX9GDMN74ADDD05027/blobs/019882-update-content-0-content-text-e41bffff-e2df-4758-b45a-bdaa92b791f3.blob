  1005→  describe('constants', () => {
  1006→    // AC: @ralph-subagent-spawning ac-9
  1007→    it('DEFAULT_SUBAGENT_TIMEOUT is 10 minutes', () => {
  1008→      expect(DEFAULT_SUBAGENT_TIMEOUT).toBe(10 * 60 * 1000);
  1009→    });
  1010→
  1011→    // AC: @ralph-subagent-spawning ac-11
  1012→    it('DEFAULT_SUBAGENT_PREFIX is [REVIEW SUBAGENT]', () => {
  1013→      expect(DEFAULT_SUBAGENT_PREFIX).toBe('[REVIEW SUBAGENT]');
  1014→    });
  1015→  });
  1016→
  1017→  // AC: @ralph-subagent-spawning ac-11
  1018→  describe('createPrefixedRenderer', () => {
  1019→    it('does not double prefix for console.log output', () => {
  1020→      const renderer = createPrefixedRenderer('[TEST]');
  1021→
  1022→      // Spy on console.log to capture what the wrapper passes to the original
  1023→      const logCalls: unknown[][] = [];
  1024→      const spy = vi.spyOn(console, 'log').mockImplementation((...args: unknown[]) => {
  1025→        logCalls.push(args);
  1026→      });
  1027→
  1028→      try {
  1029→        renderer.newSection?.('My Section');
  1030→      } finally {
  1031→        spy.mockRestore();
  1032→      }
  1033→
  1034→      // The wrapper should NOT pass the prefix as an extra argument to console.log.
  1035→      // The stdout.write wrapper handles prefixing, so console.log should receive
  1036→      // only the original arguments (no doubled prefix).
  1037→      const allArgs = logCalls.map(args => args.map(String).join(' ')).join('\n');
  1038→      expect(allArgs).toContain('My Section');
  1039→
  1040→      // Count prefix occurrences per line - should never appear doubled
  1041→      for (const call of logCalls) {
  1042→        const line = call.map(String).join(' ');
  1043→        const prefixCount = (line.match(/\[TEST\]/g) || []).length;
  1044→        expect(prefixCount, `Line has doubled prefix: ${line}`).toBeLessThanOrEqual(1);
  1045→      }
  1046→    });
  1047→
  1048→    it('does not double prefix for streaming content via stdout.write', () => {
  1049→      const renderer = createPrefixedRenderer('[TEST]');
  1050→
  1051→      // Capture process.stdout.write output - this IS used by streaming render events
  1052→      const chunks: string[] = [];
  1053→      const originalWrite = process.stdout.write;
  1054→      process.stdout.write = ((chunk: unknown) => {
  1055→        if (typeof chunk === 'string') chunks.push(chunk);
  1056→        return true;
  1057→      }) as typeof process.stdout.write;
  1058→
  1059→      // Also suppress console.log (vitest intercepts it differently)
  1060→      const logSpy = vi.spyOn(console, 'log').mockImplementation(() => {});
  1061→
  1062→      try {
  1063→        // Render a streaming agent_message event which goes through stdout.write
  1064→        renderer.render({
  1065→          timestamp: 0,
  1066→          data: {
  1067→            kind: 'agent_message',
  1068→            content: 'Hello World\n',
  1069→            isStreaming: true,
  1070→          },
  1071→        });
  1072→      } finally {
  1073→        process.stdout.write = originalWrite;
  1074→        logSpy.mockRestore();
  1075→      }
  1076→
  1077→      const output = chunks.join('');
  1078→      expect(output).toContain('Hello World');
  1079→      // Prefix should appear at most once per line
  1080→      for (const line of output.split('\n')) {
  1081→        const prefixCount = (line.match(/\[TEST\]/g) || []).length;
  1082→        expect(prefixCount, `Line has doubled prefix: ${line}`).toBeLessThanOrEqual(1);
  1083→      }
  1084→    });
  1085→
  1086→    it('creates renderer with render function', () => {
  1087→      const renderer = createPrefixedRenderer('[TEST]');
  1088→
  1089→      expect(renderer.render).toBeDefined();
  1090→      expect(typeof renderer.render).toBe('function');
  1091→    });
  1092→  });
  1093→});
