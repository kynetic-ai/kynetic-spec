   212→
   213→  // AC: @ralph-skill-delegation ac-4
   214→  it('does NOT parse or detect skill invocations from agent output', async () => {
   215→    const result = runRalph('--max-loops 1', tempDir, {
   216→      MOCK_ACP_EXIT_CODE: '0',
   217→      MOCK_ACP_RESPONSE_TEXT: 'I will now run /task-work to complete the task, then use /reflect to document learnings.',
   218→    });
   219→
   220→    // Should complete normally without attempting to parse/invoke skills
   221→    expect(result.stdout).toContain('Completed iteration 1');
   222→
   223→    // Should NOT show any skill invocation behavior
   224→    expect(result.output).not.toContain('Invoking skill');
   225→    expect(result.output).not.toContain('Detected skill command');
   226→    expect(result.output).not.toContain('Running /task-work');
   227→    expect(result.output).not.toContain('Running /reflect');
   228→
   229→    // The text should appear in the output (proving Ralph doesn't filter it)
