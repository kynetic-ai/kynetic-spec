```
     1→/**
     2→ * Task API Routes
     3→ *
     4→ * REST endpoints for task operations:
     5→ * - GET /api/tasks - list with filters and pagination
     6→ * - GET /api/tasks/:ref - get single task
     7→ * - POST /api/tasks/:ref/start - start task
     8→ * - POST /api/tasks/:ref/note - add note
     9→ *
    10→ * AC Coverage:
    11→ * - ac-2: GET /api/tasks returns array with status, priority, spec_ref, notes count
    12→ * - ac-3: Status filter with multi-value support
    13→ * - ac-4: Pagination with {items, total, offset, limit} wrapper
    14→ * - ac-5: GET /api/tasks/:ref resolves via ReferenceIndex
    15→ * - ac-6: POST /api/tasks/:ref/start transitions state
    16→ * - ac-7: POST /api/tasks/:ref/note appends note
    17→ * - @ui-task-board ac-6: POST /api/tasks/:ref/submit transitions to pending_review
    18→ * - @ui-task-board ac-6: POST /api/tasks/:ref/complete transitions to completed
    19→ * - @ui-task-board ac-6: POST /api/tasks/:ref/block transitions to blocked
    20→ */
    21→
    22→import { Elysia, t } from 'elysia';
    23→import {
    24→  initContext,
    25→  loadAllTasks,
    26→  loadAllItems,
    27→  loadPlans,
    28→  ReferenceIndex,
    29→  createNote,
    30→  saveTask,
    31→  getAuthor,
    32→  syncSpecImplementationStatus,
    33→  type LoadedTask,
    34→} from '../../parser/index.js';
    35→import { commitIfShadow } from '../../parser/shadow.js';
    36→import type { PubSubManager } from '../websocket/pubsub';
    37→
    38→interface TasksRouteOptions {
    39→  pubsub: PubSubManager;
    40→}
    41→
    42→export function createTasksRoutes(options: TasksRouteOptions) {
    43→  const { pubsub } = options;
    44→
    45→  return new Elysia({ prefix: '/api/tasks' })
    46→    // AC: @api-contract ac-2, ac-3, ac-4 - List tasks with filters and pagination
    47→    .get(
    48→      '/',
    49→      async ({ query, projectContext }) => {
    50→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
    51→        const ctx = await initContext(projectContext.path);
    52→        const tasks = await loadAllTasks(ctx);
    53→        const specItems = await loadAllItems(ctx);
    54→        const index = new ReferenceIndex(tasks, specItems);
    55→
    56→        // Apply filters
    57→        let filtered = tasks;
    58→
    59→        // AC: @api-contract ac-3 - Multi-value status filter
    60→        if (query.status) {
    61→          const statusFilters = Array.isArray(query.status) ? query.status : [query.status];
    62→          filtered = filtered.filter((task) => statusFilters.includes(task.status));
    63→        }
    64→
    65→        // Type filter (optional, not in ACs but useful)
    66→        if (query.type) {
    67→          const typeFilters = Array.isArray(query.type) ? query.type : [query.type];
    68→          filtered = filtered.filter((task) => task.type && typeFilters.includes(task.type));
    69→        }
    70→
    71→        // Tag filter (optional, not in ACs but useful)
    72→        if (query.tag) {
    73→          const tagFilters = Array.isArray(query.tag) ? query.tag : [query.tag];
    74→          filtered = filtered.filter((task) =>
    75→            task.tags?.some((t) => tagFilters.includes(t))
    76→          );
    77→        }
    78→
    79→        // Plan filter — show only tasks derived from a given plan
    80→        if (query.plan) {
    81→          const plans = await loadPlans(ctx);
    82→          const plan = plans.find(
    83→            (p) => p._ulid === query.plan || p.slugs.includes(query.plan!)
    84→          );
    85→          if (plan) {
    86→            const derivedRefs = new Set(
    87→              plan.derived_tasks.map((r) => (r.startsWith('@') ? r.slice(1) : r))
    88→            );
    89→            filtered = filtered.filter(
    90→              (task) =>
    91→                derivedRefs.has(task._ulid) ||
    92→                task.slugs.some((s) => derivedRefs.has(s))
    93→            );
    94→          } else {
    95→            filtered = [];
    96→          }
    97→        }
    98→
    99→        // AC: @api-contract ac-4 - Pagination
   100→        const total = filtered.length;
   101→        const offset = Number(query.offset) || 0;
   102→        const limit = Number(query.limit) || total;
   103→
   104→        const paginated = filtered.slice(offset, offset + limit);
   105→
   106→        // AC: @api-contract ac-2 - Return with status, priority, spec_ref, notes count
   107→        // AC: @web-dashboard ac-1 - Include depends_on for blocked task computation
   108→        const items = paginated.map((task) => ({
   109→          _ulid: task._ulid,
   110→          slugs: task.slugs,
   111→          title: task.title,
   112→          type: task.type || 'task',
   113→          status: task.status,
   114→          priority: task.priority,
   115→          spec_ref: task.spec_ref,
   116→          meta_ref: task.meta_ref,
   117→          tags: task.tags,
   118→          depends_on: task.depends_on || [],
   119→          automation: task.automation,
   120→          notes_count: task.notes?.length || 0,
   121→          todos_count: task.todos?.length || 0,
   122→          automation: task.automation,
   123→          started_at: task.started_at,
   124→          completed_at: task.completed_at,
   125→          created_at: task.created_at,
   126→        }));
   127→
   128→        // AC: @api-contract ac-4, @trait-api-endpoint ac-4 - Return pagination wrapper
   129→        return {
   130→          items,
   131→          total,
   132→          offset,
   133→          limit,
   134→        };
   135→      },
   136→      {
   137→        query: t.Object({
   138→          status: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   139→          type: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   140→          tag: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   141→          plan: t.Optional(t.String()),
   142→          limit: t.Optional(t.String()),
   143→          offset: t.Optional(t.String()),
   144→        }),
   145→      }
   146→    )
   147→
   148→    // AC: @api-contract ac-5 - Get single task by ref
   149→    .get(
   150→      '/:ref',
   151→      async ({ params, error: errorResponse, projectContext }) => {
   152→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   153→        const ctx = await initContext(projectContext.path);
   154→        const tasks = await loadAllTasks(ctx);
   155→        const items = await loadAllItems(ctx);
   156→        const index = new ReferenceIndex(tasks, items);
   157→
   158→        // AC: @api-contract ac-5, @trait-api-endpoint ac-2 - Resolve ref via ReferenceIndex
   159→        const result = index.resolve(params.ref);
   160→
   161→        if (!result.ok) {
   162→          // AC: @trait-api-endpoint ac-2 - Return 404 with error details
   163→          return errorResponse(404, {
   164→            error: 'not_found',
   165→            message: `Task reference "${params.ref}" not found`,
   166→            suggestion: 'Use kspec task list or kspec search to find valid task references',
   167→          });
   168→        }
   169→
   170→        // Find the task
   171→        const task = tasks.find((t) => t._ulid === result.ulid);
   172→        if (!task) {
   173→          return errorResponse(404, {
   174→            error: 'not_found',
   175→            message: `Reference "${params.ref}" is not a task`,
   176→            suggestion: 'This reference might point to a spec item instead',
   177→          });
   178→        }
   179→
   180→        // AC: @api-contract ac-5 - Return full task with notes, todos, dependencies
   181→        // AC: @ui-task-board ac-3 - Include type, description, blocked_by, vcs_refs, plan_ref, session_ref
   182→        return {
   183→          _ulid: task._ulid,
   184→          slugs: task.slugs,
   185→          title: task.title,
   186→          type: task.type || 'task',
   187→          status: task.status,
   188→          priority: task.priority,
   189→          spec_ref: task.spec_ref,
   190→          meta_ref: task.meta_ref,
   191→          tags: task.tags,
   192→          description: task.description,
   193→          derivation: task.derivation,
   194→          depends_on: task.depends_on,
   195→          blocked_by: task.blocked_by || [],
   196→          context: task.context || [],
   197→          vcs_refs: (task.vcs_refs || []).map((v) =>
   198→            typeof v === 'string' ? v : v.type ? `${v.type}:${v.ref}` : v.ref
   199→          ),
   200→          plan_ref: task.plan_ref,
   201→          session_ref: task.session_id,
   202→          notes: task.notes,
   203→          notes_count: task.notes?.length || 0,
   204→          todos: task.todos,
   205→          todos_count: task.todos?.length || 0,
   206→          started_at: task.started_at,
   207→          completed_at: task.completed_at,
   208→          cancelled_at: task.cancelled_at,
   209→          closed_reason: task.closed_reason,
   210→          automation: task.automation,
   211→          created_at: task.created_at,
   212→        };
   213→      },
   214→      {
   215→        params: t.Object({
   216→          ref: t.String(),
   217→        }),
   218→      }
   219→    )
   220→
   221→    // AC: @api-contract ac-6 - Start task
   222→    .post(
   223→      '/:ref/start',
   224→      async ({ params, error: errorResponse, projectContext }) => {
   225→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   226→        const ctx = await initContext(projectContext.path);
   227→        const tasks = await loadAllTasks(ctx);
   228→        const items = await loadAllItems(ctx);
   229→        const index = new ReferenceIndex(tasks, items);
   230→
   231→        // Resolve ref
   232→        const result = index.resolve(params.ref);
   233→        if (!result.ok) {
   234→          return errorResponse(404, {
   235→            error: 'not_found',
   236→            message: `Task reference "${params.ref}" not found`,
   237→            suggestion: 'Use kspec task list to find valid task references',
   238→          });
   239→        }
   240→
   241→        const task = tasks.find((t) => t._ulid === result.ulid);
   242→        if (!task) {
   243→          return errorResponse(404, {
   244→            error: 'not_found',
   245→            message: `Reference "${params.ref}" is not a task`,
   246→          });
   247→        }
   248→
   249→        // AC: @api-contract ac-6 - Transition to in_progress
   250→        if (task.status === 'in_progress') {
   251→          return errorResponse(409, {
   252→            error: 'invalid_transition',
   253→            message: 'Task is already in_progress',
   254→            current: task.status,
   255→            valid_transitions: ['blocked', 'pending_review', 'completed', 'cancelled'],
   256→          });
   257→        }
   258→
   259→        // Update task status
   260→        const updatedTask: LoadedTask = {
   261→          ...task,
   262→          status: 'in_progress',
   263→          started_at: task.started_at || new Date().toISOString(),
   264→        };
   265→
   266→        // Save and commit
   267→        await saveTask(ctx, updatedTask);
   268→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   269→        await commitIfShadow(ctx.shadow, `task: start ${params.ref}`);
   270→
   271→        // AC: @api-contract ac-6, @trait-api-endpoint ac-5 - WebSocket broadcast
   272→        // AC: @multi-directory-daemon ac-18 - Broadcast scoped to request project
   273→        pubsub.broadcast('tasks:updates', 'task_updated', {
   274→          ref: params.ref,
   275→          ulid: task._ulid,
   276→          action: 'start',
   277→          status: 'in_progress',
   278→        }, projectContext.path);
   279→
   280→        // AC: @api-contract ac-6 - Return updated task
   281→        return updatedTask;
   282→      },
   283→      {
   284→        params: t.Object({
   285→          ref: t.String(),
   286→        }),
   287→      }
   288→    )
   289→
   290→    // AC: @api-contract ac-7 - Add note to task
   291→    .post(
   292→      '/:ref/note',
   293→      async ({ params, body, error: errorResponse, projectContext }) => {
   294→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   295→        const ctx = await initContext(projectContext.path);
   296→        const tasks = await loadAllTasks(ctx);
   297→        const items = await loadAllItems(ctx);
   298→        const index = new ReferenceIndex(tasks, items);
   299→
   300→        // Resolve ref
   301→        const result = index.resolve(params.ref);
   302→        if (!result.ok) {
   303→          return errorResponse(404, {
   304→            error: 'not_found',
   305→            message: `Task reference "${params.ref}" not found`,
   306→          });
   307→        }
   308→
   309→        const task = tasks.find((t) => t._ulid === result.ulid);
   310→        if (!task) {
   311→          return errorResponse(404, {
   312→            error: 'not_found',
   313→            message: `Reference "${params.ref}" is not a task`,
   314→          });
   315→        }
   316→
   317→        // AC: @trait-api-endpoint ac-3 - Validate body
   318→        if (!body.content || typeof body.content !== 'string') {
   319→          return errorResponse(400, {
   320→            error: 'validation_error',
   321→            details: [
   322→              {
   323→                field: 'content',
   324→                message: 'Content is required and must be a string',
   325→              },
   326→            ],
   327→          });
   328→        }
   329→
   330→        // AC: @api-contract ac-7 - Append note
   331→        const author = getAuthor(ctx.config?.identity?.author);
   332→        const note = createNote(body.content, author);
   333→
   334→        const updatedTask: LoadedTask = {
   335→          ...task,
   336→          notes: [...(task.notes || []), note],
   337→        };
   338→
   339→        // AC: @api-contract ac-7, @trait-api-endpoint ac-5 - Shadow commit
   340→        await saveTask(ctx, updatedTask);
   341→        await commitIfShadow(ctx.shadow, `task: add note to ${params.ref}`);
   342→
   343→        // AC: @api-contract ac-7 - WebSocket broadcast
   344→        // AC: @multi-directory-daemon ac-18 - Broadcast scoped to request project
   345→        pubsub.broadcast('tasks:updates', 'task_updated', {
   346→          ref: params.ref,
   347→          ulid: task._ulid,
   348→          action: 'note_added',
   349→          note_ulid: note._ulid,
   350→        }, projectContext.path);
   351→
   352→        return {
   353→          success: true,
   354→          note,
   355→          task: updatedTask,
   356→        };
   357→      },
   358→      {
   359→        params: t.Object({
   360→          ref: t.String(),
   361→        }),
   362→        body: t.Object({
   363→          content: t.String(),
   364→        }),
   365→      }
   366→    )
   367→
   368→    // AC: @ui-task-board ac-6 - Submit task for review
   369→    .post(
   370→      '/:ref/submit',
   371→      async ({ params, error: errorResponse, projectContext }) => {
   372→        const ctx = await initContext(projectContext.path);
   373→        const tasks = await loadAllTasks(ctx);
   374→        const items = await loadAllItems(ctx);
   375→        const index = new ReferenceIndex(tasks, items);
   376→
   377→        const result = index.resolve(params.ref);
   378→        if (!result.ok) {
   379→          return errorResponse(404, {
   380→            error: 'not_found',
   381→            message: `Task reference "${params.ref}" not found`,
   382→          });
   383→        }
   384→
   385→        const task = tasks.find((t) => t._ulid === result.ulid);
   386→        if (!task) {
   387→          return errorResponse(404, {
   388→            error: 'not_found',
   389→            message: `Reference "${params.ref}" is not a task`,
   390→          });
   391→        }
   392→
   393→        if (task.status !== 'in_progress' && task.status !== 'needs_work') {
   394→          return errorResponse(409, {
   395→            error: 'invalid_transition',
   396→            message: `Cannot submit task with status "${task.status}". Must be in_progress or needs_work.`,
   397→            current: task.status,
   398→            valid_transitions: ['pending_review'],
   399→          });
   400→        }
   401→
   402→        const updatedTask: LoadedTask = { ...task, status: 'pending_review' };
   403→        await saveTask(ctx, updatedTask);
   404→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   405→        await commitIfShadow(ctx.shadow, `task: submit ${params.ref}`);
   406→
   407→        pubsub.broadcast('tasks:updates', 'task_updated', {
   408→          ref: params.ref,
   409→          ulid: task._ulid,
   410→          action: 'submit',
   411→          status: 'pending_review',
   412→        }, projectContext.path);
   413→
   414→        return updatedTask;
   415→      },
   416→      { params: t.Object({ ref: t.String() }) }
   417→    )
   418→
   419→    // AC: @ui-task-board ac-6 - Complete task
   420→    .post(
   421→      '/:ref/complete',
   422→      async ({ params, body, error: errorResponse, projectContext }) => {
   423→        const ctx = await initContext(projectContext.path);
   424→        const tasks = await loadAllTasks(ctx);
   425→        const items = await loadAllItems(ctx);
   426→        const index = new ReferenceIndex(tasks, items);
   427→
   428→        const result = index.resolve(params.ref);
   429→        if (!result.ok) {
   430→          return errorResponse(404, {
   431→            error: 'not_found',
   432→            message: `Task reference "${params.ref}" not found`,
   433→          });
   434→        }
   435→
   436→        const task = tasks.find((t) => t._ulid === result.ulid);
   437→        if (!task) {
   438→          return errorResponse(404, {
   439→            error: 'not_found',
   440→            message: `Reference "${params.ref}" is not a task`,
   441→          });
   442→        }
   443→
   444→        const updatedTask: LoadedTask = {
   445→          ...task,
   446→          status: 'completed',
   447→          completed_at: new Date().toISOString(),
   448→          closed_reason: body.reason,
   449→        };
   450→        await saveTask(ctx, updatedTask);
   451→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   452→        await commitIfShadow(ctx.shadow, `task: complete ${params.ref}`);
   453→
   454→        pubsub.broadcast('tasks:updates', 'task_updated', {
   455→          ref: params.ref,
   456→          ulid: task._ulid,
   457→          action: 'complete',
   458→          status: 'completed',
   459→        }, projectContext.path);
   460→
   461→        return updatedTask;
   462→      },
   463→      {
   464→        params: t.Object({ ref: t.String() }),
   465→        body: t.Object({ reason: t.String() }),
   466→      }
   467→    )
   468→
   469→    // AC: @ui-task-board ac-6 - Block task
   470→    .post(
   471→      '/:ref/block',
   472→      async ({ params, body, error: errorResponse, projectContext }) => {
   473→        const ctx = await initContext(projectContext.path);
   474→        const tasks = await loadAllTasks(ctx);
   475→        const items = await loadAllItems(ctx);
   476→        const index = new ReferenceIndex(tasks, items);
   477→
   478→        const result = index.resolve(params.ref);
   479→        if (!result.ok) {
   480→          return errorResponse(404, {
   481→            error: 'not_found',
   482→            message: `Task reference "${params.ref}" not found`,
   483→          });
   484→        }
   485→
   486→        const task = tasks.find((t) => t._ulid === result.ulid);
   487→        if (!task) {
   488→          return errorResponse(404, {
   489→            error: 'not_found',
   490→            message: `Reference "${params.ref}" is not a task`,
   491→          });
   492→        }
   493→
   494→        const author = getAuthor(ctx.config?.identity?.author);
   495→        const note = createNote(`Blocked: ${body.reason}`, author);
   496→
   497→        const updatedTask: LoadedTask = {
   498→          ...task,
   499→          status: 'blocked',
   500→          notes: [...(task.notes || []), note],
   501→        };
   502→        await saveTask(ctx, updatedTask);
   503→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   504→        await commitIfShadow(ctx.shadow, `task: block ${params.ref}`);
   505→
   506→        pubsub.broadcast('tasks:updates', 'task_updated', {
   507→          ref: params.ref,
   508→          ulid: task._ulid,
   509→          action: 'block',
   510→          status: 'blocked',
   511→        }, projectContext.path);
   512→
   513→        return updatedTask;
   514→      },
   515→      {
   516→        params: t.Object({ ref: t.String() }),
   517→        body: t.Object({ reason: t.String() }),
   518→      }
   519→    );
   520→}
   521→
```