   910→// ============================================================
   911→// Validation & Alignment API Functions
   912→// AC: @ui-validation-view ac-1
   913→// ============================================================
   914→
   915→export interface SchemaValidationError {
   916→	file: string;
   917→	path?: string;
   918→	message: string;
   919→	details?: unknown;
   920→}
   921→
   922→export interface RefValidationError {
   923→	ref: string;
   924→	sourceFile?: string;
   925→	sourceUlid?: string;
   926→	field: string;
   927→	error: 'not_found' | 'ambiguous' | 'duplicate_slug';
   928→	message: string;
   929→}
   930→
   931→export interface RefValidationWarning {
   932→	ref: string;
   933→	sourceFile?: string;
   934→	sourceUlid?: string;
   935→	field: string;
   936→	warning: 'deprecated_target';
   937→	message: string;
   938→}
   939→
   940→export interface OrphanItem {
   941→	ulid: string;
   942→	title: string;
   943→	type: string;
   944→	file?: string;
   945→}
   946→
   947→export type CompletenessWarningType =
   948→	| 'missing_acceptance_criteria'
   949→	| 'missing_description'
   950→	| 'status_inconsistency'
   951→	| 'missing_test_coverage'
   952→	| 'automation_eligible_no_spec'
   953→	| 'ac_schema_field_mismatch';
   954→
   955→export interface CompletenessWarning {
   956→	type: CompletenessWarningType;
   957→	subtype?: 'own_ac' | 'trait_ac';
   958→	itemRef: string;
   959→	itemTitle: string;
   960→	message: string;
   961→	details?: string;
   962→}
   963→
   964→export interface TraitCycleError {
   965→	traitRef: string;
   966→	traitTitle: string;
   967→	cycle: string[];
   968→	message: string;
   969→}
   970→
   971→export interface ValidationResponse {
   972→	valid: boolean;
   973→	schemaErrors: SchemaValidationError[];
   974→	refErrors: RefValidationError[];
   975→	refWarnings: RefValidationWarning[];
   976→	orphans: OrphanItem[];
   977→	completenessWarnings: CompletenessWarning[];
   978→	traitCycles: TraitCycleError[];
   979→}
   980→
   981→/** Alias for backward compatibility with dashboard overview */
   982→export type ValidationResult = ValidationResponse;
   983→
   984→export interface AlignmentWarning {
   985→	type: 'orphaned_spec' | 'status_mismatch' | 'stale_implementation';
   986→	specUlid?: string;
   987→	specTitle?: string;
   988→	taskUlid?: string;
   989→	message: string;
   990→}
   991→
   992→export interface AlignmentStats {
   993→	totalSpecs: number;
   994→	specsWithTasks: number;
   995→	alignedSpecs: number;
   996→	orphanedSpecs: number;
   997→}
   998→
   999→export interface AlignmentResponse {
  1000→	stats: AlignmentStats;
  1001→	warnings: AlignmentWarning[];
  1002→}
  1003→
  1004→/**
  1005→ * Fetch validation results
  1006→ * AC: @ui-validation-view ac-1
  1007→ */
  1008→export async function fetchValidation(): Promise<ValidationResponse> {
  1009→	if (isStaticMode()) {
  1010→		return {
  1011→			valid: true,
  1012→			schemaErrors: [],
  1013→			refErrors: [],
  1014→			refWarnings: [],
  1015→			orphans: [],
  1016→			completenessWarnings: [],
  1017→			traitCycles: []
  1018→		};
  1019→	}
  1020→
  1021→	const response = await fetch(`${API_BASE}/api/validate`, {
  1022→		headers: getProjectHeaders()
  1023→	});
  1024→	if (!response.ok) {
  1025→		await handleResponseError(response);
  1026→	}
  1027→
  1028→	return response.json();
  1029→}
  1030→
  1031→/**
  1032→ * Fetch alignment stats and warnings
  1033→ * AC: @ui-validation-view ac-1
  1034→ */
  1035→export async function fetchAlignment(): Promise<AlignmentResponse> {
  1036→	if (isStaticMode()) {
  1037→		return {
  1038→			stats: { totalSpecs: 0, specsWithTasks: 0, alignedSpecs: 0, orphanedSpecs: 0 },
  1039→			warnings: []
  1040→		};
  1041→	}
  1042→
  1043→	const response = await fetch(`${API_BASE}/api/alignment`, {
  1044→		headers: getProjectHeaders()
  1045→	});
  1046→	if (!response.ok) {
  1047→		await handleResponseError(response);
  1048→	}
  1049→
  1050→	return response.json();
  1051→}
