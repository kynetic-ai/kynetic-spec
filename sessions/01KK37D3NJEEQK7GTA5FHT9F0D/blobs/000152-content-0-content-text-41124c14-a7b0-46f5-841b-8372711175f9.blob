   777→// ============================================================
   778→// Session API Functions
   779→// AC: @ui-session-stream ac-1, ac-2, ac-4
   780→// ============================================================
   781→
   782→/**
   783→ * Session summary from the daemon API.
   784→ */
   785→export interface SessionSummary {
   786→	id: string;
   787→	status: 'active' | 'completed' | 'abandoned' | 'timed_out' | 'failed';
   788→	agent_type: string;
   789→	session_type: 'loop' | 'invocation';
   790→	/** Dispatch trigger for distinguishing dispatched agent vs manual CLI run. */
   791→	trigger?: string;
   792→	/** Task ID being worked on (if any). AC: @ui-session-history ac-1 */
   793→	task_id?: string;
   794→	started_at: string;
   795→	ended_at?: string;
   796→	duration_ms: number;
   797→	event_count: number;
   798→	iteration_count: number;
   799→	tasks_completed: number;
   800→}
   801→
   802→/**
   803→ * Spec context with acceptance criteria checklist.
   804→ * AC: @ui-session-stream ac-4
   805→ */
   806→export interface SessionSpecContext {
   807→	spec_ref: string;
   808→	title: string;
   809→	acceptance_criteria: Array<{ id: string; description: string }>;
   810→}
   811→
   812→/**
   813→ * Session budget info.
   814→ * AC: @ui-session-stream ac-4
   815→ */
   816→export interface SessionBudget {
   817→	max_per_cycle: number;
   818→	started_this_cycle: number;
   819→}
   820→
   821→/**
   822→ * Session detail with additional metadata.
   823→ * AC: @ui-session-stream ac-4
   824→ */
   825→export interface SessionDetail extends SessionSummary {
   826→	task_id?: string;
   827→	agent_id?: string;
   828→	trigger?: string;
   829→	spec_context?: SessionSpecContext | null;
   830→	budget?: SessionBudget | null;
   831→}
   832→
   833→/**
   834→ * A single event from events.jsonl.
   835→ */
   836→export interface SessionEvent {
   837→	ts: number;
   838→	seq: number;
   839→	type: string;
   840→	session_id: string;
   841→	trace_id?: string;
   842→	data: unknown;
   843→}
   844→
   845→/**
   846→ * Fetch all sessions with summaries.
   847→ * AC: @ui-session-stream ac-1
   848→ */
   849→export async function fetchSessions(): Promise<{ items: SessionSummary[]; total: number }> {
   850→	if (isStaticMode()) {
   851→		return { items: [], total: 0 };
   852→	}
   853→
   854→	const response = await fetch(`${API_BASE}/api/sessions`, {
   855→		headers: getProjectHeaders()
   856→	});
   857→	if (!response.ok) {
   858→		await handleResponseError(response);
   859→	}
   860→
   861→	return response.json();
   862→}
   863→
   864→/**
   865→ * Fetch a single session by ID.
   866→ * AC: @ui-session-stream ac-4
   867→ */
   868→export async function fetchSession(id: string): Promise<SessionDetail> {
   869→	if (isStaticMode()) {
   870→		throw new Error('Session data not available in static mode');
   871→	}
   872→
   873→	const response = await fetch(`${API_BASE}/api/sessions/${id}`, {
   874→		headers: getProjectHeaders()
   875→	});
   876→	if (!response.ok) {
   877→		await handleResponseError(response);
   878→	}
   879→
   880→	return response.json();
   881→}
   882→
   883→/**
   884→ * Fetch session events (optionally incremental via since_seq).
   885→ * AC: @ui-session-stream ac-1, ac-2
   886→ */
   887→export async function fetchSessionEvents(
   888→	id: string,
   889→	sinceSeq?: number
   890→): Promise<{ events: SessionEvent[]; total: number }> {
   891→	if (isStaticMode()) {
   892→		return { events: [], total: 0 };
   893→	}
   894→
   895→	const url = new URL(`${API_BASE}/api/sessions/${id}/events`);
   896→	if (sinceSeq !== undefined) {
   897→		url.searchParams.set('since_seq', String(sinceSeq));
   898→	}
   899→
   900→	const response = await fetch(url.toString(), {
   901→		headers: getProjectHeaders()
   902→	});
   903→	if (!response.ok) {
   904→		await handleResponseError(response);
   905→	}
   906→
   907→	return response.json();
   908→}
