   745→
   746→/**
   747→ * Fetch plans with optional status filter
   748→ * AC: @ui-plans-view ac-1
   749→ */
   750→export async function fetchPlans(params?: {
   751→	status?: string;
   752→}): Promise<{ items: PlanSummary[]; total: number }> {
   753→	if (isStaticMode()) {
   754→		return fetchPlansStatic(params);
   755→	}
   756→
   757→	const url = new URL(`${API_BASE}/api/plans`);
   758→
   759→	if (params) {
   760→		Object.entries(params).forEach(([key, value]) => {
   761→			if (value !== undefined && value !== '') {
   762→				url.searchParams.set(key, String(value));
   763→			}
   764→		});
   765→	}
   766→
   767→	const response = await fetch(url.toString(), {
   768→		headers: getProjectHeaders()
   769→	});
   770→	if (!response.ok) {
   771→		await handleResponseError(response);
   772→	}
   773→
   774→	return response.json();
   775→}
