```
     1→/**
     2→ * API Client
     3→ *
     4→ * Helper functions for making requests to the kspec daemon API.
     5→ * Supports both daemon mode (live) and static mode (read-only JSON).
     6→ *
     7→ * AC Coverage:
     8→ * - ac-26 (@multi-directory-daemon): X-Kspec-Dir header injection
     9→ * - ac-36 (@multi-directory-daemon): Invalid project error detection
    10→ * - ac-11 (@gh-pages-export): Mode-aware API dispatch
    11→ * - ac-18 (@gh-pages-export): Graceful no-op for write operations
    12→ */
    13→
    14→import type {
    15→	TaskSummary,
    16→	TaskDetail,
    17→	ItemSummary,
    18→	ItemDetail,
    19→	InboxItem,
    20→	SessionContext,
    21→	Observation,
    22→	PaginatedResponse,
    23→	PlanSummary,
    24→	ErrorResponse,
    25→	SearchResponse
    26→} from '@kynetic-ai/shared';
    27→import type { TriageRecord } from './types/triage';
    28→import {
    29→	getSelectedProjectPath,
    30→	clearInvalidSelection,
    31→	isInvalidProjectError,
    32→	type Project
    33→} from './stores/project.svelte';
    34→import { isStaticMode, assertWritable } from './stores/mode.svelte';
    35→import {
    36→	fetchTasksStatic,
    37→	fetchTaskStatic,
    38→	fetchItemsStatic,
    39→	fetchItemStatic,
    40→	fetchItemTasksStatic,
    41→	fetchInboxStatic,
    42→	fetchSessionContextStatic,
    43→	fetchObservationsStatic,
    44→	searchStatic,
    45→	fetchTriageRecordsStatic,
    46→	fetchPlansStatic
    47→} from './api-static';
    48→import { DAEMON_API_BASE } from './constants';
    49→
    50→const API_BASE = DAEMON_API_BASE;
    51→
    52→/**
    53→ * Get headers for API requests, including X-Kspec-Dir if project is selected
    54→ * AC: @multi-directory-daemon ac-26
    55→ */
    56→function getProjectHeaders(): HeadersInit {
    57→	const path = getSelectedProjectPath();
    58→	return path ? { 'X-Kspec-Dir': path } : {};
    59→}
    60→
    61→/**
    62→ * Handle response errors, detecting invalid project errors
    63→ * AC: @multi-directory-daemon ac-36
    64→ */
    65→async function handleResponseError(response: Response): Promise<never> {
    66→	const error: ErrorResponse = await response.json();
    67→	const message = error.message || error.error;
    68→
    69→	// Check if this is an invalid project error
    70→	if (isInvalidProjectError(response, message)) {
    71→		clearInvalidSelection();
    72→	}
    73→
    74→	throw new Error(message);
    75→}
    76→
    77→/**
    78→ * Fetch registered projects
    79→ * AC: @multi-directory-daemon ac-25, ac-28
    80→ */
    81→export async function fetchProjects(): Promise<{ projects: Project[] }> {
    82→	const response = await fetch(`${API_BASE}/api/projects`);
    83→	if (!response.ok) {
    84→		await handleResponseError(response);
    85→	}
    86→	return response.json();
    87→}
    88→
    89→/**
    90→ * Fetch tasks with optional filters
    91→ * AC: @web-dashboard ac-9, ac-10
    92→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
    93→ * AC: @gh-pages-export ac-11 - Static mode support
    94→ */
    95→export async function fetchTasks(params?: {
    96→	status?: string;
    97→	type?: string;
    98→	tag?: string;
    99→	assignee?: string;
   100→	automation?: string;
   101→	plan?: string;
   102→	limit?: number;
   103→	offset?: number;
   104→}): Promise<PaginatedResponse<TaskSummary>> {
   105→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   106→	if (isStaticMode()) {
   107→		return fetchTasksStatic(params);
   108→	}
   109→
   110→	const url = new URL(`${API_BASE}/api/tasks`);
   111→
   112→	if (params) {
   113→		Object.entries(params).forEach(([key, value]) => {
   114→			if (value !== undefined && value !== '') {
   115→				url.searchParams.set(key, String(value));
   116→			}
   117→		});
   118→	}
   119→
   120→	const response = await fetch(url.toString(), {
   121→		headers: getProjectHeaders()
   122→	});
   123→	if (!response.ok) {
   124→		await handleResponseError(response);
   125→	}
   126→
   127→	return response.json();
   128→}
   129→
   130→/**
   131→ * Fetch single task by reference
   132→ * AC: @web-dashboard ac-5
   133→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   134→ * AC: @gh-pages-export ac-12 - Static mode deep linking
   135→ */
   136→export async function fetchTask(ref: string): Promise<TaskDetail> {
   137→	// AC: @gh-pages-export ac-12 - Use static data in static mode
   138→	if (isStaticMode()) {
   139→		const task = fetchTaskStatic(ref);
   140→		if (!task) {
   141→			throw new Error(`Task not found: ${ref}`);
   142→		}
   143→		return task;
   144→	}
   145→
   146→	const response = await fetch(`${API_BASE}/api/tasks/${ref}`, {
   147→		headers: getProjectHeaders()
   148→	});
   149→	if (!response.ok) {
   150→		await handleResponseError(response);
   151→	}
   152→
   153→	return response.json();
   154→}
   155→
   156→/**
   157→ * Start a task (change status to in_progress)
   158→ * AC: @web-dashboard ac-7
   159→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   160→ * AC: @gh-pages-export ac-16, ac-18 - Disabled in static mode
   161→ */
   162→export async function startTask(ref: string): Promise<void> {
   163→	// AC: @gh-pages-export ac-16, ac-18 - Write operations throw in static mode
   164→	assertWritable('start task');
   165→
   166→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/start`, {
   167→		method: 'POST',
   168→		headers: getProjectHeaders()
   169→	});
   170→	if (!response.ok) {
   171→		await handleResponseError(response);
   172→	}
   173→}
   174→
   175→/**
   176→ * Add a note to a task
   177→ * AC: @web-dashboard ac-8
   178→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   179→ * AC: @gh-pages-export ac-18 - Disabled in static mode
   180→ */
   181→export async function addTaskNote(ref: string, content: string): Promise<void> {
   182→	// AC: @gh-pages-export ac-18 - Write operations throw in static mode
   183→	assertWritable('add note');
   184→
   185→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/note`, {
   186→		method: 'POST',
   187→		headers: {
   188→			'Content-Type': 'application/json',
   189→			...getProjectHeaders()
   190→		},
   191→		body: JSON.stringify({ content })
   192→	});
   193→	if (!response.ok) {
   194→		await handleResponseError(response);
   195→	}
   196→}
