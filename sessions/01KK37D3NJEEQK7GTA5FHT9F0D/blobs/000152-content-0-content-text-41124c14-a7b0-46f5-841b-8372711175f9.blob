   612→// ============================================================
   613→// Agent & Dispatch API Functions
   614→// AC: @ui-agent-dispatch ac-1, ac-2, ac-3
   615→// ============================================================
   616→
   617→/**
   618→ * Agent definition from GET /api/meta/agents
   619→ */
   620→export interface AgentDefinition {
   621→	_ulid: string;
   622→	id: string;
   623→	name: string;
   624→	description?: string;
   625→	adapter?: string;
   626→	dispatch: Array<{
   627→		on: string;
   628→		filter?: {
   629→			automation?: string;
   630→			tags?: string[];
   631→			priority?: number;
   632→		};
   633→	}>;
   634→	capabilities: string[];
   635→	tools: string[];
   636→	skills: string[];
   637→	budget?: {
   638→		max_tasks?: number;
   639→		timeout_minutes?: number;
   640→	};
   641→	concurrency: {
   642→		max_concurrent: number;
   643→	};
   644→	auto_approve: boolean;
   645→}
   646→
   647→/**
   648→ * Active invocation from GET /api/agent/status
   649→ */
   650→export interface ActiveInvocation {
   651→	session_id: string;
   652→	agent_id: string;
   653→	task_ref: string | null;
   654→	elapsed_ms: number;
   655→}
   656→
   657→/**
   658→ * Agent dispatch status from GET /api/agent/status
   659→ */
   660→export interface AgentDispatchStatus {
   661→	dispatch_enabled: boolean;
   662→	active_invocations: ActiveInvocation[];
   663→	queue_depth: number;
