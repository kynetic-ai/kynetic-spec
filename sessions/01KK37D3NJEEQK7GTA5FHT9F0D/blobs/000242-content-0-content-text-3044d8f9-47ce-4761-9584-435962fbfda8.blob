```
     1→/**
     2→ * Agent instruction generation commands.
     3→ *
     4→ * AC: @agent-instruction-gen ac-1 - kspec agents generate creates kspec-agents.md in project root
     5→ * AC: @agent-instruction-gen ac-2 - output includes Finding Information table with row per skill
     6→ * AC: @agent-instruction-gen ac-3 - output includes conventions section listing rules by domain
     7→ * AC: @agent-instruction-gen ac-4 - output contains freshness comment with kspec version and timestamp
     8→ * AC: @agent-instruction-gen ac-5 - kspec agents status reports stale when not regenerated after meta changes
     9→ *
    10→ * AC: @agents-cli ac-1 - kspec agents generate writes kspec-agents.md to project root
    11→ * AC: @agents-cli ac-2 - kspec agents generate --dry-run prints content without writing
    12→ * AC: @agents-cli ac-3 - kspec agents status reports up to date when current
    13→ * AC: @agents-cli ac-4 - kspec agents status reports stale when meta changed
    14→ *
    15→ * AC: @agent-templates ac-1 - template sections included in output in defined order
    16→ * AC: @agent-templates ac-2 - each template section appears in generated output
    17→ * AC: @agent-templates ac-3 - error if template directory missing or empty
    18→ */
    19→
    20→import * as crypto from "node:crypto";
    21→import * as fs from "node:fs/promises";
    22→import { createRequire } from "node:module";
    23→import * as path from "node:path";
    24→import { fileURLToPath } from "node:url";
    25→import chalk from "chalk";
    26→import type { Command } from "commander";
    27→import {
    28→  generateConventionsSummary,
    29→  generateSkillsTable,
    30→  generateWorkflowsSummary,
    31→  initContext,
    32→  loadMetaContext,
    33→  type LoadedConvention,
    34→  type LoadedSkill,
    35→  type LoadedWorkflow,
    36→} from "../../parser/index.js";
    37→import { errors } from "../../strings/errors.js";
    38→import { EXIT_CODES } from "../exit-codes.js";
    39→import { error, output, success } from "../output.js";
    40→
    41→const __filename = fileURLToPath(import.meta.url);
    42→const __dirname = path.dirname(__filename);
    43→
    44→// Read version from package.json at runtime
    45→const require = createRequire(import.meta.url);
    46→const { version } = require("../../../package.json");
    47→
    48→/**
    49→ * File name for generated agent instructions
    50→ */
    51→const GENERATED_FILE_NAME = "kspec-agents.md";
    52→
    53→/**
    54→ * Hash file name for tracking freshness
    55→ */
    56→const HASH_FILE_NAME = ".kspec-agents-hash";
    57→
    58→/**
    59→ * Templates directory name relative to package root
    60→ */
    61→const TEMPLATES_DIR = "templates/agents-sections";
    62→
    63→/**
    64→ * Compute SHA256 hash of content
    65→ */
    66→function computeHash(content: string): string {
    67→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
    68→}
    69→
    70→/**
    71→ * Load template sections from the templates directory.
    72→ * AC: @agent-templates ac-1 - all template sections included in defined order
    73→ * AC: @agent-templates ac-3 - error if directory missing or empty
    74→ */
    75→export async function loadTemplateSections(packageRoot: string): Promise<string[]> {
    76→  const templatesPath = path.join(packageRoot, TEMPLATES_DIR);
    77→
    78→  // Check if templates directory exists
    79→  try {
    80→    await fs.access(templatesPath);
    81→  } catch {
    82→    throw new Error(
    83→      `Templates directory not found at: ${templatesPath}. ` +
    84→        `Expected templates/agents-sections/ directory with section markdown files.`,
    85→    );
    86→  }
    87→
    88→  // Read directory contents
    89→  const entries = await fs.readdir(templatesPath, { withFileTypes: true });
    90→  const mdFiles = entries
    91→    .filter((e) => e.isFile() && e.name.endsWith(".md"))
    92→    .map((e) => e.name)
    93→    .sort(); // Sort to ensure consistent ordering by filename prefix
    94→
    95→  if (mdFiles.length === 0) {
    96→    throw new Error(
    97→      `Templates directory is empty: ${templatesPath}. ` +
    98→        `Expected markdown files for agent instruction sections.`,
    99→    );
   100→  }
   101→
   102→  // Load each template in order
   103→  const sections: string[] = [];
   104→  for (const filename of mdFiles) {
   105→    const filePath = path.join(templatesPath, filename);
   106→    const content = await fs.readFile(filePath, "utf-8");
   107→    sections.push(content.trim());
   108→  }
   109→
   110→  return sections;
   111→}
   112→
   113→/**
   114→ * Get the package root directory (where templates/ is located)
   115→ */
   116→export function getPackageRoot(): string {
   117→  // Navigate from dist/cli/commands/ to package root
   118→  return path.resolve(__dirname, "..", "..", "..");
   119→}
   120→
   121→/**
   122→ * Generate a hash of the meta content that affects the generated file.
   123→ * This is used to detect if the generated file is stale.
   124→ */
   125→export function computeMetaHash(
   126→  skills: LoadedSkill[],
   127→  conventions: LoadedConvention[],
   128→  workflows: LoadedWorkflow[],
   129→  templateSections?: string[],
   130→  metaVersion: string = version,
   131→): string {
   132→  // Create a stable representation of the meta content
   133→  // AC: @cross-platform-and-version-robustness ac-4 - includes templates for staleness detection
   134→  const data: Record<string, unknown> = {
   135→    version: metaVersion,
   136→    skills: skills.map((s) => ({
   137→      id: s.id,
   138→      name: s.name,
   139→      description: s.description,
   140→    })),
   141→    conventions: conventions.map((c) => ({
   142→      domain: c.domain,
   143→      rules: c.rules,
   144→      examples: (c.examples ?? []).map((e) => ({ good: e.good, bad: e.bad })),
   145→    })),
   146→    workflows: workflows.map((w) => ({
   147→      id: w.id,
   148→      trigger: w.trigger,
   149→      description: w.description,
   150→    })),
   151→  };
   152→  if (templateSections && templateSections.length > 0) {
   153→    data.templates = templateSections;
   154→  }
   155→  return computeHash(JSON.stringify(data));
   156→}
   157→
   158→/**
   159→ * Generate the freshness comment.
   160→ * AC: @agent-instruction-gen ac-4 - freshness comment with kspec version and timestamp
   161→ */
   162→function generateFreshnessComment(timestamp: string): string {
   163→  return `<!-- Generated by kspec v${version} at ${timestamp} -->\n<!-- Do not edit manually - regenerate with: kspec agents generate -->\n\n`;
   164→}
   165→
   166→/**
   167→ * Generate the full kspec-agents.md content
   168→ * AC: @agent-templates ac-1 - template sections included in output in defined order
   169→ * AC: @agent-templates ac-2 - each template section appears in generated output
   170→ */
   171→export async function generateAgentsContent(
   172→  skills: LoadedSkill[],
   173→  conventions: LoadedConvention[],
   174→  workflows: LoadedWorkflow[],
   175→  timestamp: string,
   176→  templateSections: string[],
   177→): Promise<string> {
   178→  const sections: string[] = [];
   179→
   180→  // AC: @agent-instruction-gen ac-4 - freshness comment
   181→  sections.push(generateFreshnessComment(timestamp));
   182→
   183→  // Header
   184→  sections.push("# kspec Agent Instructions\n");
   185→  sections.push(
   186→    "This file is auto-generated from kspec meta. Include it in your AGENTS.md or similar agent instruction file.\n\n",
   187→  );
   188→
   189→  // AC: @agent-instruction-gen ac-2 - Skills table
   190→  // AC: @agent-instruction-gen ac-3 - Conventions section
   191→  // Ensure blank line between each data section for valid markdown
   192→  const dataSections = [
   193→    generateSkillsTable(skills),
   194→    generateConventionsSummary(conventions),
   195→    generateWorkflowsSummary(workflows),
   196→  ].filter(Boolean);
   197→
   198→  for (const section of dataSections) {
   199→    // Ensure each section is preceded by a blank line
   200→    if (!sections[sections.length - 1]?.endsWith("\n\n")) {
   201→      sections.push("\n");
   202→    }
   203→    sections.push(section);
   204→  }
   205→
   206→  // AC: @agent-templates ac-1, ac-2 - Include template sections in order
   207→  if (templateSections.length > 0) {
   208→    sections.push("\n");
   209→    for (const section of templateSections) {
   210→      sections.push(section);
   211→      sections.push("\n\n");
   212→    }
   213→  }
   214→
   215→  return sections.join("");
   216→}
   217→
   218→/**
   219→ * Result of checking agent file status
   220→ */
   221→interface AgentStatusResult {
   222→  exists: boolean;
   223→  path: string;
   224→  status: "current" | "stale" | "missing";
   225→  metaHash?: string;
   226→  storedHash?: string;
   227→  generatedAt?: string;
   228→}
   229→
   230→/**
   231→ * Check the status of the generated agent file.
   232→ * AC: @agent-instruction-gen ac-5 - reports stale when meta has changed
   233→ */
   234→async function checkAgentStatus(
   235→  projectRoot: string,
   236→  metaHash: string,
   237→): Promise<AgentStatusResult> {
   238→  const filePath = path.join(projectRoot, GENERATED_FILE_NAME);
   239→  const hashPath = path.join(projectRoot, ".kspec", HASH_FILE_NAME);
   240→
   241→  // Check if file exists
   242→  try {
   243→    await fs.access(filePath);
   244→  } catch {
   245→    return {
   246→      exists: false,
   247→      path: filePath,
   248→      status: "missing",
   249→      metaHash,
   250→    };
   251→  }
   252→
   253→  // Check stored hash
   254→  let storedHash: string | undefined;
   255→  let generatedAt: string | undefined;
   256→
   257→  try {
   258→    const hashContent = await fs.readFile(hashPath, "utf-8");
   259→    const hashData = JSON.parse(hashContent);
   260→    storedHash = hashData.metaHash;
   261→    generatedAt = hashData.generatedAt;
   262→  } catch {
   263→    // No hash file, treat as stale
   264→    return {
   265→      exists: true,
   266→      path: filePath,
   267→      status: "stale",
   268→      metaHash,
   269→    };
   270→  }
   271→
   272→  // Compare hashes
   273→  const isCurrent = storedHash === metaHash;
   274→
   275→  return {
   276→    exists: true,
   277→    path: filePath,
   278→    status: isCurrent ? "current" : "stale",
   279→    metaHash,
   280→    storedHash,
   281→    generatedAt,
   282→  };
   283→}
   284→
   285→/**
   286→ * Register agent instruction generation commands
   287→ */
   288→export function registerAgentsCommands(program: Command): void {
   289→  const agents = program
   290→    .command("agents")
   291→    .description("Agent instruction generation commands");
   292→
   293→  // AC: @agent-instruction-gen ac-1 - kspec agents generate
   294→  // AC: @agent-templates ac-3 - error if template directory missing
   295→  // AC: @trait-dry-run ac-1 through ac-6 - dry-run support
   296→  agents
   297→    .command("generate")
   298→    .description("Generate kspec-agents.md from meta (skills, conventions, workflows)")
   299→    .option("--dry-run", "Show what would be generated without writing files")
   300→    .action(async (options) => {
   301→      try {
   302→        const ctx = await initContext();
   303→
   304→        if (!ctx.manifestPath) {
   305→          error(errors.project.noKspecProject);
   306→          process.exit(EXIT_CODES.ERROR);
   307→        }
   308→
   309→        // AC: @agent-templates ac-3 - error if templates missing
   310→        const packageRoot = getPackageRoot();
   311→        let templateSections: string[];
   312→        try {
   313→          templateSections = await loadTemplateSections(packageRoot);
   314→        } catch (err) {
   315→          const message =
   316→            err instanceof Error ? err.message : "Unknown error loading templates";
   317→          error(message, {
   318→            suggestion: `Verify that ${TEMPLATES_DIR}/ exists with markdown files.`,
   319→          });
   320→          process.exit(EXIT_CODES.ERROR);
   321→        }
   322→
   323→        const metaCtx = await loadMetaContext(ctx);
   324→        const dryRun = options.dryRun || false;
   325→        const timestamp = new Date().toISOString();
   326→
   327→        // Generate content - now async due to template loading
   328→        const content = await generateAgentsContent(
   329→          metaCtx.skills,
   330→          metaCtx.conventions,
   331→          metaCtx.workflows,
   332→          timestamp,
   333→          templateSections,
   334→        );
   335→
   336→        // Compute meta hash for freshness tracking (includes templates)
   337→        const metaHash = computeMetaHash(
   338→          metaCtx.skills,
   339→          metaCtx.conventions,
   340→          metaCtx.workflows,
   341→          templateSections,
   342→        );
   343→
   344→        const outputPath = path.join(ctx.rootDir, GENERATED_FILE_NAME);
   345→        const hashPath = path.join(ctx.rootDir, ".kspec", HASH_FILE_NAME);
   346→
   347→        // AC: @agent-instruction-gen ac-6 - skip regeneration when content unchanged
   348→        if (!dryRun) {
   349→          const status = await checkAgentStatus(ctx.rootDir, metaHash);
   350→          if (status.status === "current") {
   351→            output(
   352→              {
   353→                path: outputPath,
   354→                status: "current",
   355→                skipped: true,
   356→              },
   357→              () => {
   358→                success(`${GENERATED_FILE_NAME} is already up to date`);
   359→              },
   360→            );
   361→            return;
   362→          }
   363→        }
   364→
   365→        // AC: @trait-dry-run ac-3 - clear indication this is a preview
   366→        if (dryRun) {
   367→          output(
   368→            {
   369→              dry_run: true,
   370→              path: outputPath,
   371→              skills: metaCtx.skills.length,
   372→              conventions: metaCtx.conventions.length,
   373→              workflows: metaCtx.workflows.length,
   374→              templates: templateSections.length,
   375→              content,
   376→            },
   377→            () => {
   378→              console.log(chalk.yellow("DRY RUN - No changes made"));
   379→              console.log();
   380→              console.log(chalk.gray(`Would write to: ${outputPath}`));
   381→              console.log();
   382→              console.log(chalk.gray("--- Generated content ---"));
   383→              console.log(content);
   384→              console.log(chalk.gray("--- End content ---"));
   385→              console.log();
   386→              console.log(
   387→                chalk.yellow("No changes were made. Run without --dry-run to apply."),
   388→              );
   389→            },
   390→          );
   391→          return;
   392→        }
   393→
   394→        // AC: @trait-dry-run ac-2 - no files modified in dry run mode
   395→        // Write the generated file
   396→        await fs.writeFile(outputPath, content, "utf-8");
   397→
   398→        // Write the hash file for freshness tracking
   399→        await fs.mkdir(path.dirname(hashPath), { recursive: true });
   400→        await fs.writeFile(
   401→          hashPath,
   402→          JSON.stringify(
   403→            {
   404→              metaHash,
   405→              generatedAt: timestamp,
   406→              version,
   407→            },
   408→            null,
   409→            2,
   410→          ),
   411→          "utf-8",
   412→        );
   413→
   414→        output(
   415→          {
   416→            path: outputPath,
   417→            skills: metaCtx.skills.length,
   418→            conventions: metaCtx.conventions.length,
   419→            workflows: metaCtx.workflows.length,
   420→            templates: templateSections.length,
   421→            generatedAt: timestamp,
   422→          },
   423→          () => {
   424→            success(`Generated ${GENERATED_FILE_NAME}`, {
   425→              skills: metaCtx.skills.length,
   426→              conventions: metaCtx.conventions.length,
   427→              workflows: metaCtx.workflows.length,
   428→              templates: templateSections.length,
   429→            });
   430→            console.log(chalk.gray(`  Path: ${outputPath}`));
   431→          },
   432→        );
   433→      } catch (err) {
   434→        error("Failed to generate agent instructions", err);
   435→        process.exit(EXIT_CODES.ERROR);
   436→      }
   437→    });
   438→
   439→  // AC: @agent-instruction-gen ac-5 - kspec agents status
   440→  agents
   441→    .command("status")
   442→    .description("Check if kspec-agents.md is up to date with meta")
   443→    .action(async () => {
   444→      try {
   445→        const ctx = await initContext();
   446→
   447→        if (!ctx.manifestPath) {
   448→          error(errors.project.noKspecProject);
   449→          process.exit(EXIT_CODES.ERROR);
   450→        }
   451→
   452→        const metaCtx = await loadMetaContext(ctx);
   453→
   454→        // Load templates for hash computation
   455→        let templateSections: string[] = [];
   456→        try {
   457→          templateSections = await loadTemplateSections(getPackageRoot());
   458→        } catch (_err) {
   459→          // Templates may not exist in all environments
   460→        }
   461→
   462→        // Compute current meta hash (includes templates)
   463→        const metaHash = computeMetaHash(
   464→          metaCtx.skills,
   465→          metaCtx.conventions,
   466→          metaCtx.workflows,
   467→          templateSections,
   468→        );
   469→
   470→        const status = await checkAgentStatus(ctx.rootDir, metaHash);
   471→
   472→        output(status, () => {
   473→          switch (status.status) {
   474→            case "missing":
   475→              console.log(chalk.yellow(`${GENERATED_FILE_NAME} does not exist`));
   476→              console.log();
   477→              console.log(
   478→                chalk.gray("Run 'kspec agents generate' to create it."),
   479→              );
   480→              break;
   481→
   482→            case "stale":
   483→              console.log(
   484→                chalk.yellow(`${GENERATED_FILE_NAME} is stale`),
   485→              );
   486→              console.log();
   487→              console.log(
   488→                chalk.gray(
   489→                  "Meta has changed since the file was generated.",
   490→                ),
   491→              );
   492→              console.log(
   493→                chalk.gray("Run 'kspec agents generate' to regenerate."),
   494→              );
   495→              break;
   496→
   497→            case "current":
   498→              console.log(chalk.green(`${GENERATED_FILE_NAME} is up to date`));
   499→              if (status.generatedAt) {
   500→                console.log(chalk.gray(`  Generated: ${status.generatedAt}`));
   501→              }
   502→              break;
   503→          }
   504→        });
   505→      } catch (err) {
   506→        error("Failed to check agent status", err);
   507→        process.exit(EXIT_CODES.ERROR);
   508→      }
   509→    });
   510→}
   511→
```