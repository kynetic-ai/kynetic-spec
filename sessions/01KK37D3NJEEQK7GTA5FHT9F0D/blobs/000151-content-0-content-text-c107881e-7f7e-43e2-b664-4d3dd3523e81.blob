```
     1→<script lang="ts">
     2→/**
     3→ * SpokeApprovalModal
     4→ *
     5→ * Modal dialog for reviewing and acting on pending spoke enrollments.
     6→ * Shows spoke info, expiry countdown, project selector, and provides approve/reject actions.
     7→ * Closes automatically when the last enrollment is approved or rejected.
     8→ *
     9→ * Per specs/MULTI_PROJECT_ARCHITECTURE.md Section 6.2, 6.3:
    10→ * - Shows modal regardless of which project user is currently viewing (cross-project event)
    11→ * - Includes project selector dropdown
    12→ * - Pre-selects project based on suggestedProjectId (from repo) or currently viewed project
    13→ * - Allows user to change selection before approving
    14→ * - Includes 'Create new project...' option
    15→ * - Sends projectId in approval request
    16→ */
    17→import { Check, Clock, FolderGit2, Laptop2, Pencil, Plus } from 'lucide-svelte';
    18→import {
    19→  approveEnrollment as apiApproveEnrollment,
    20→  rejectEnrollment as apiRejectEnrollment,
    21→  type PendingSpokeEnrollment,
    22→  type Project,
    23→} from '$lib/api/index.js';
    24→import ProjectIcon from '$lib/components/layout/ProjectIcon.svelte';
    25→import { Button } from '$lib/components/ui/button/index.js';
    26→import * as Dialog from '$lib/components/ui/dialog/index.js';
    27→import InlineConfirmButton from './InlineConfirmButton.svelte';
    28→
    29→const {
    30→  Root: Dialog_,
    31→  Content: DialogContent,
    32→  Header: DialogHeader,
    33→  Title: DialogTitle,
    34→  Description: DialogDescription,
    35→} = Dialog;
    36→
    37→interface Props {
    38→  /** List of pending enrollments to display */
    39→  enrollments: PendingSpokeEnrollment[];
    40→  /** Whether the modal is open */
    41→  open: boolean;
    42→  /** Callback when the modal is closed */
    43→  onClose: () => void;
    44→  /** Callback after a successful action (approve/reject) */
    45→  onAction?: () => void;
    46→  /** Optional custom approve handler (defaults to API call) */
    47→  onApprove?: (requestId: string, projectId: string, friendlyName?: string) => Promise<void>;
    48→  /** Optional custom reject handler (defaults to API call) */
    49→  onReject?: (requestId: string) => Promise<void>;
    50→  /** Available projects for selection */
    51→  projects?: Project[];
    52→  /** Currently selected project ID in the UI (fallback for pre-selection) */
    53→  selectedProjectId?: string | null;
    54→  /** Callback to open project creation modal */
    55→  onCreateProject?: () => void;
    56→}
    57→
    58→const {
    59→  enrollments,
    60→  open = $bindable(false),
    61→  onClose,
    62→  onAction,
    63→  onApprove,
    64→  onReject,
    65→  projects = [],
    66→  selectedProjectId = null,
    67→  onCreateProject,
    68→}: Props = $props();
    69→
    70→// Track loading state per enrollment
    71→let loadingStates = $state<Record<string, 'approving' | 'rejecting' | null>>({});
    72→let error = $state<string | null>(null);
    73→
    74→// Track selected project per enrollment (key: requestId, value: projectId)
    75→let selectedProjects = $state<Record<string, string>>({});
    76→
    77→// Track friendly name per enrollment (key: requestId, value: friendlyName)
    78→let friendlyNames = $state<Record<string, string>>({});
    79→
    80→/**
    81→ * Get active (non-deleted) projects.
    82→ */
    83→const activeProjects = $derived(projects.filter((p) => !p.deleted_at));
    84→
    85→/**
    86→ * Get or compute the selected project for an enrollment.
    87→ * Pre-selection priority:
    88→ * 1. User's explicit selection (if already made)
    89→ * 2. suggested_project_id from the enrollment (from repo's .kynetic/project.json)
    90→ * 3. Currently viewed project in the UI (selectedProjectId prop)
    91→ * 4. First available project (fallback)
    92→ */
    93→function getSelectedProjectId(enrollment: PendingSpokeEnrollment): string | null {
    94→  // If user has already selected a project for this enrollment, use that
    95→  if (selectedProjects[enrollment.request_id]) {
    96→    return selectedProjects[enrollment.request_id];
    97→  }
    98→
    99→  // Pre-selection logic
   100→  // 1. suggestedProjectId from enrollment (repo has .kynetic/project.json)
   101→  if (
   102→    enrollment.suggested_project_id &&
   103→    activeProjects.some((p) => p.id === enrollment.suggested_project_id)
   104→  ) {
   105→    return enrollment.suggested_project_id;
   106→  }
   107→
   108→  // 2. Currently viewed project
   109→  if (selectedProjectId && activeProjects.some((p) => p.id === selectedProjectId)) {
   110→    return selectedProjectId;
   111→  }
   112→
   113→  // 3. First available project
   114→  if (activeProjects.length > 0) {
   115→    return activeProjects[0].id;
   116→  }
   117→
   118→  return null;
   119→}
   120→
   121→/**
   122→ * Handle project selection for an enrollment.
   123→ */
   124→function handleSelectProject(requestId: string, projectId: string) {
   125→  selectedProjects = { ...selectedProjects, [requestId]: projectId };
   126→}
   127→
   128→/**
   129→ * Get the friendly name for an enrollment.
   130→ * Returns the user-entered name, or defaults to machine_name.
   131→ */
   132→function getFriendlyName(enrollment: PendingSpokeEnrollment): string {
   133→  if (friendlyNames[enrollment.request_id] !== undefined) {
   134→    return friendlyNames[enrollment.request_id];
   135→  }
   136→  return enrollment.machine_name;
   137→}
   138→
   139→/**
   140→ * Handle friendly name change for an enrollment.
   141→ */
   142→function handleFriendlyNameChange(requestId: string, value: string) {
   143→  friendlyNames = { ...friendlyNames, [requestId]: value };
   144→}
   145→
   146→/**
   147→ * Format time remaining until expiry.
   148→ * Returns a human-readable string like "18h 42m" or "Expired".
   149→ */
   150→function formatTimeRemaining(expiresAt: string): string {
   151→  const now = new Date();
   152→  const expiry = new Date(expiresAt);
   153→  const diffMs = expiry.getTime() - now.getTime();
   154→
   155→  if (diffMs <= 0) {
   156→    return 'Expired';
   157→  }
   158→
   159→  const hours = Math.floor(diffMs / (1000 * 60 * 60));
   160→  const minutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
   161→
   162→  if (hours > 24) {
   163→    const days = Math.floor(hours / 24);
   164→    const remainingHours = hours % 24;
   165→    return `${days}d ${remainingHours}h`;
   166→  }
   167→
   168→  if (hours > 0) {
   169→    return `${hours}h ${minutes}m`;
   170→  }
   171→
   172→  return `${minutes}m`;
   173→}
   174→
   175→/**
   176→ * Handle dialog close
   177→ */
   178→function handleOpenChange(isOpen: boolean) {
   179→  if (!isOpen) {
   180→    error = null;
   181→    // Clear selections when modal closes
   182→    selectedProjects = {};
   183→    friendlyNames = {};
   184→    onClose();
   185→  }
   186→}
   187→
   188→/**
   189→ * Approve an enrollment
   190→ */
   191→async function handleApprove(requestId: string) {
   192→  const enrollment = enrollments.find((e) => e.request_id === requestId);
   193→  if (!enrollment) {
   194→    error = 'Enrollment not found';
   195→    return;
   196→  }
   197→
   198→  const projectId = getSelectedProjectId(enrollment);
   199→  if (!projectId) {
   200→    error = 'Please select a project for this spoke';
   201→    return;
   202→  }
   203→
   204→  // Get friendly name (use user input or default to machine_name)
   205→  const friendlyName = getFriendlyName(enrollment);
   206→
   207→  loadingStates[requestId] = 'approving';
   208→  error = null;
   209→
   210→  try {
   211→    if (onApprove) {
   212→      await onApprove(requestId, projectId, friendlyName);
   213→    } else {
   214→      await apiApproveEnrollment(requestId, projectId, undefined, friendlyName);
   215→    }
   216→    // Clear selection for this enrollment
   217→    const { [requestId]: _, ...rest } = selectedProjects;
   218→    selectedProjects = rest;
   219→    const { [requestId]: __, ...restNames } = friendlyNames;
   220→    friendlyNames = restNames;
   221→    onAction?.();
   222→    // Close modal if no more enrollments after this one
   223→    if (enrollments.length <= 1) {
   224→      onClose();
   225→    }
   226→  } catch (err) {
   227→    error = err instanceof Error ? err.message : 'Failed to approve spoke';
   228→  } finally {
   229→    loadingStates[requestId] = null;
   230→  }
   231→}
   232→
   233→/**
   234→ * Reject an enrollment
   235→ */
   236→async function handleReject(requestId: string) {
   237→  loadingStates[requestId] = 'rejecting';
   238→  error = null;
   239→
   240→  try {
   241→    if (onReject) {
   242→      await onReject(requestId);
   243→    } else {
   244→      await apiRejectEnrollment(requestId);
   245→    }
   246→    // Clear selection for this enrollment
   247→    const { [requestId]: _, ...rest } = selectedProjects;
   248→    selectedProjects = rest;
   249→    const { [requestId]: __, ...restNames } = friendlyNames;
   250→    friendlyNames = restNames;
   251→    onAction?.();
   252→    // Close modal if no more enrollments after this one
   253→    if (enrollments.length <= 1) {
   254→      onClose();
   255→    }
   256→  } catch (err) {
   257→    error = err instanceof Error ? err.message : 'Failed to reject spoke';
   258→  } finally {
   259→    loadingStates[requestId] = null;
   260→  }
   261→}
   262→
   263→/**
   264→ * Check if an enrollment is expired
   265→ */
   266→function isExpired(expiresAt: string): boolean {
   267→  return new Date(expiresAt).getTime() <= Date.now();
   268→}
   269→
   270→/**
   271→ * Handle create project click
   272→ */
   273→function handleCreateProject() {
   274→  onCreateProject?.();
   275→}
   276→</script>
   277→
   278→<Dialog_ {open} onOpenChange={handleOpenChange}>
   279→  <DialogContent class="max-w-lg">
   280→    <DialogHeader>
   281→      <div class="flex flex-col gap-1">
   282→        <DialogTitle>Spoke Approval</DialogTitle>
   283→        <DialogDescription>
   284→          Review and approve or reject pending spoke enrollments. Select a project to bind
   285→          each spoke to.
   286→        </DialogDescription>
   287→      </div>
   288→    </DialogHeader>
   289→
   290→    <!-- Content area (p-6 matches TaskDetailModal pattern) -->
   291→    <div class="p-6">
   292→      <!-- Error message -->
   293→      {#if error}
   294→        <div
   295→          class="rounded-lg border border-red-800 bg-red-950/50 p-3 text-sm text-red-200 mb-4"
   296→        >
   297→          {error}
   298→        </div>
   299→      {/if}
   300→
   301→      <!-- Enrollments list -->
   302→      <div class="space-y-4 max-h-[60vh] overflow-y-auto">
   303→        {#if enrollments.length === 0}
   304→          <div class="py-8 text-center text-muted-foreground">
   305→            No spokes waiting for approval
   306→          </div>
   307→        {:else}
   308→          {#each enrollments as enrollment (enrollment.request_id)}
   309→            {@const loading = loadingStates[enrollment.request_id]}
   310→            {@const expired = isExpired(enrollment.expires_at)}
   311→            {@const currentProjectId = getSelectedProjectId(enrollment)}
   312→            <div
   313→              class="rounded-lg border border-zinc-800 bg-zinc-900/50 p-4 space-y-4"
   314→              class:opacity-60={expired}
   315→              data-testid="enrollment-card-{enrollment.request_id}"
   316→            >
   317→              <!-- Spoke info -->
   318→              <div class="space-y-2">
   319→                <div class="flex items-center gap-2 text-sm">
   320→                  <Laptop2 class="h-4 w-4 text-zinc-400" />
   321→                  <span class="font-medium text-foreground">{enrollment.machine_name}</span>
   322→                </div>
   323→                <div class="flex items-center gap-2 text-sm">
   324→                  <FolderGit2 class="h-4 w-4 text-zinc-400" />
   325→                  <span class="text-muted-foreground truncate" title={enrollment.repo_path}>
   326→                    {enrollment.repo_path}
   327→                  </span>
   328→                </div>
   329→                <div class="flex items-center gap-2 text-sm">
   330→                  <Clock class="h-4 w-4 text-zinc-400" />
   331→                  <span class={expired ? 'text-red-400' : 'text-amber-400'}>
   332→                    {expired ? 'Expired' : `Expires in ${formatTimeRemaining(enrollment.expires_at)}`}
   333→                  </span>
   334→                </div>
   335→              </div>
   336→
   337→              <!-- Friendly name input -->
   338→              <div class="space-y-2">
   339→                <label
   340→                  for="friendly-name-{enrollment.request_id}"
   341→                  class="text-sm font-medium text-foreground flex items-center gap-2"
   342→                >
   343→                  <Pencil class="h-4 w-4 text-zinc-400" />
   344→                  Friendly Name:
   345→                </label>
   346→                <input
   347→                  id="friendly-name-{enrollment.request_id}"
   348→                  type="text"
   349→                  value={getFriendlyName(enrollment)}
   350→                  oninput={(e) => handleFriendlyNameChange(enrollment.request_id, e.currentTarget.value)}
   351→                  placeholder={enrollment.machine_name}
   352→                  maxlength={64}
   353→                  disabled={loading != null || expired}
   354→                  class="w-full rounded-lg border border-zinc-700 bg-zinc-800/50 px-3 py-2 text-sm text-foreground placeholder:text-zinc-500 focus:outline-none focus:ring-1 focus:ring-sidebar-primary disabled:opacity-50"
   355→                  data-testid="friendly-name-input-{enrollment.request_id}"
   356→                />
   357→              </div>
   358→
   359→              <!-- Project selector -->
   360→              <fieldset class="space-y-2">
   361→                <legend class="text-sm font-medium text-foreground">Assign to Project:</legend>
   362→                <div
   363→                  class="space-y-1 max-h-32 overflow-y-auto rounded-lg border border-zinc-700 bg-zinc-800/50 p-2"
   364→                  role="radiogroup"
   365→                  aria-label="Project selection for {enrollment.machine_name}"
   366→                  data-testid="project-selector-{enrollment.request_id}"
   367→                >
   368→                  {#if activeProjects.length === 0}
   369→                    <div class="py-2 text-center text-sm text-muted-foreground">
   370→                      No projects available
   371→                    </div>
   372→                  {:else}
   373→                    {#each activeProjects as project (project.id)}
   374→                      {@const isSelected = currentProjectId === project.id}
   375→                      <button
   376→                        type="button"
   377→                        class="w-full flex items-center gap-3 p-2 rounded-md transition-colors
   378→                          {isSelected
   379→                          ? 'bg-sidebar-primary/20 ring-1 ring-sidebar-primary'
   380→                          : 'hover:bg-zinc-700/50'}"
   381→                        onclick={() => handleSelectProject(enrollment.request_id, project.id)}
   382→                        disabled={loading != null || expired}
   383→                        role="radio"
   384→                        aria-checked={isSelected}
   385→                        data-testid="project-option-{project.id}"
   386→                      >
   387→                        <div
   388→                          class="flex h-4 w-4 items-center justify-center rounded-full border-2 shrink-0
   389→                          {isSelected ? 'border-sidebar-primary bg-sidebar-primary' : 'border-zinc-500'}"
   390→                        >
   391→                          {#if isSelected}
   392→                            <div class="h-1.5 w-1.5 rounded-full bg-white"></div>
   393→                          {/if}
   394→                        </div>
   395→                        <ProjectIcon icon={project.icon} size="sm" selected={isSelected} />
   396→                        <span class="text-sm truncate {isSelected ? 'text-foreground' : 'text-muted-foreground'}">
   397→                          {project.name}
   398→                        </span>
   399→                      </button>
   400→                    {/each}
   401→                  {/if}
   402→
   403→                  <!-- Divider before create option -->
   404→                  {#if activeProjects.length > 0 && onCreateProject}
   405→                    <div class="border-t border-zinc-700 my-1"></div>
   406→                  {/if}
   407→
   408→                  <!-- Create new project option -->
   409→                  {#if onCreateProject}
   410→                    <button
   411→                      type="button"
   412→                      class="w-full flex items-center gap-3 p-2 rounded-md transition-colors hover:bg-zinc-700/50"
   413→                      onclick={handleCreateProject}
   414→                      disabled={loading != null || expired}
   415→                      data-testid="create-project-option"
   416→                    >
   417→                      <div
   418→                        class="flex h-4 w-4 items-center justify-center rounded-full border-2 border-dashed border-zinc-500 shrink-0"
   419→                      >
   420→                        <Plus class="h-2.5 w-2.5 text-zinc-500" />
   421→                      </div>
   422→                      <span class="text-sm text-muted-foreground">Create new project...</span>
   423→                    </button>
   424→                  {/if}
   425→                </div>
   426→              </fieldset>
   427→
   428→              <!-- Actions -->
   429→              <div class="flex items-center gap-2 justify-end pt-2">
   430→                <InlineConfirmButton
   431→                  label="Reject"
   432→                  confirmLabel="Confirm reject?"
   433→                  variant="destructive"
   434→                  disabled={loading != null || expired}
   435→                  onConfirm={() => handleReject(enrollment.request_id)}
   436→                  testId="reject-button-{enrollment.request_id}"
   437→                />
   438→                <Button
   439→                  variant="default"
   440→                  size="sm"
   441→                  disabled={loading != null || expired || !currentProjectId}
   442→                  onclick={() => handleApprove(enrollment.request_id)}
   443→                  data-testid="approve-button-{enrollment.request_id}"
   444→                >
   445→                  {#if loading === 'approving'}
   446→                    <span class="animate-pulse">Approving...</span>
   447→                  {:else}
   448→                    <Check class="h-4 w-4 mr-1" />
   449→                    Approve
   450→                  {/if}
   451→                </Button>
   452→              </div>
   453→            </div>
   454→          {/each}
   455→        {/if}
   456→      </div>
   457→    </div>
   458→  </DialogContent>
   459→</Dialog_>
   460→
