   351→
   352→    // AC: @api-contract ac-19 - returns empty results for empty query
   353→    test('returns empty results when no query provided', async ({ request, daemon }) => {
   354→      const response = await request.get(`${daemon.baseUrl}/api/search`);
   355→      expect(response.status()).toBe(200);
   356→
   357→      const body = await response.json();
   358→      expect(body.results).toEqual([]);
   359→      expect(body.total).toBe(0);
