   399→test.describe('Validation API', () => {
   400→  test.describe('GET /api/validate', () => {
   401→    // AC: @api-contract ac-20
   402→    test('returns ValidationResult with required fields', async ({ request, daemon }) => {
   403→      const response = await request.get(`${daemon.baseUrl}/api/validate`);
   404→
   405→      expect(response.status()).toBe(200);
   406→
   407→      const body = await response.json();
   408→
   409→      // Required ValidationResult fields per ac-20
   410→      expect(body).toHaveProperty('valid');
   411→      expect(body).toHaveProperty('schemaErrors');
   412→      expect(body).toHaveProperty('refErrors');
   413→      expect(body).toHaveProperty('orphans');
   414→
   415→      expect(typeof body.valid).toBe('boolean');
   416→      expect(Array.isArray(body.schemaErrors)).toBe(true);
   417→      expect(Array.isArray(body.refErrors)).toBe(true);
   418→      expect(Array.isArray(body.orphans)).toBe(true);
