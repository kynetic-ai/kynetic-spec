   157→  test.describe('GET /api/meta/observations', () => {
   158→    // AC: @api-contract ac-18
   159→    test('returns all observations without filter', async ({ request, daemon }) => {
   160→      const response = await request.get(`${daemon.baseUrl}/api/meta/observations`);
   161→
   162→      expect(response.status()).toBe(200);
   163→
   164→      const body = await response.json();
   165→
   166→      expect(body).toHaveProperty('items');
   167→      expect(body).toHaveProperty('total');
   168→      expect(Array.isArray(body.items)).toBe(true);
   169→      // Fixture has 2 observations
   170→      expect(body.items.length).toBe(2);
   171→      expect(body.total).toBe(2);
   172→    });
   173→
   174→    // AC: @api-contract ac-18 - each observation has required fields
   175→    test('observations have required fields', async ({ request, daemon }) => {
   176→      const response = await request.get(`${daemon.baseUrl}/api/meta/observations`);
   177→      expect(response.status()).toBe(200);
   178→
   179→      const body = await response.json();
   180→      expect(body.items.length).toBeGreaterThan(0);
   181→
   182→      const obs = body.items[0];
   183→      expect(obs).toHaveProperty('_ulid');
   184→      expect(obs).toHaveProperty('created_at');
   185→      expect(obs).toHaveProperty('type');
   186→      expect(obs).toHaveProperty('content');
   187→    });
   188→
   189→    // AC: @api-contract ac-18 - observations ordered by created_at descending
   190→    test('returns observations ordered by created_at descending (newest first)', async ({
   191→      request,
   192→      daemon,
   193→    }) => {
   194→      const response = await request.get(`${daemon.baseUrl}/api/meta/observations`);
   195→      expect(response.status()).toBe(200);
   196→
   197→      const body = await response.json();
   198→      const items = body.items;
   199→      expect(items.length).toBeGreaterThanOrEqual(2);
   200→
   201→      // Verify descending order
   202→      for (let i = 0; i < items.length - 1; i++) {
   203→        const current = new Date(items[i].created_at).getTime();
   204→        const next = new Date(items[i + 1].created_at).getTime();
   205→        expect(current).toBeGreaterThanOrEqual(next);
   206→      }
   207→    });
   208→
   209→    // AC: @api-contract ac-18 - filter by resolved=false returns unresolved
   210→    test('filters unresolved observations with ?resolved=false', async ({ request, daemon }) => {
   211→      const response = await request.get(`${daemon.baseUrl}/api/meta/observations?resolved=false`);
   212→
   213→      expect(response.status()).toBe(200);
   214→
   215→      const body = await response.json();
   216→      expect(Array.isArray(body.items)).toBe(true);
   217→      // Fixture has 2 unresolved observations
   218→      expect(body.items.length).toBe(2);
   219→
   220→      // None should have resolved_at set
   221→      for (const obs of body.items) {
   222→        expect(obs.resolved_at).toBeFalsy();
   223→      }
   224→    });
   225→
   226→    // AC: @api-contract ac-18 - filter by resolved=true returns no results (fixture has none)
   227→    test('filters resolved observations with ?resolved=true', async ({ request, daemon }) => {
   228→      const response = await request.get(`${daemon.baseUrl}/api/meta/observations?resolved=true`);
