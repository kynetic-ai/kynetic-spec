   260→test.describe('Search API', () => {
   261→  test.describe('GET /api/search', () => {
   262→    // AC: @api-contract ac-19
   263→    test('returns search results with results array and total', async ({ request, daemon }) => {
   264→      const response = await request.get(`${daemon.baseUrl}/api/search?q=test`);
   265→
   266→      expect(response.status()).toBe(200);
   267→
   268→      const body = await response.json();
   269→
   270→      expect(body).toHaveProperty('results');
   271→      expect(body).toHaveProperty('total');
   272→      expect(Array.isArray(body.results)).toBe(true);
   273→    });
   274→
   275→    // AC: @api-contract ac-19 - each result has type, ulid, title, matchedFields
   276→    test('each search result has required fields', async ({ request, daemon }) => {
   277→      const response = await request.get(`${daemon.baseUrl}/api/search?q=test`);
   278→      expect(response.status()).toBe(200);
   279→
   280→      const body = await response.json();
   281→      expect(body.results.length).toBeGreaterThan(0);
   282→
   283→      const result = body.results[0];
   284→      expect(result).toHaveProperty('type');
   285→      expect(result).toHaveProperty('ulid');
   286→      expect(result).toHaveProperty('title');
   287→      expect(result).toHaveProperty('matchedFields');
   288→      expect(Array.isArray(result.matchedFields)).toBe(true);
   289→    });
   290→
   291→    // AC: @api-contract ac-19 - searches across spec items
   292→    test('finds spec items matching query', async ({ request, daemon }) => {
   293→      // Fixture has "Test Feature", "Test Requirement", etc. matching "Core"
   294→      const response = await request.get(`${daemon.baseUrl}/api/search?q=Core+Module`);
   295→      expect(response.status()).toBe(200);
   296→
   297→      const body = await response.json();
   298→      const itemResults = body.results.filter(
   299→        (r: { type: string }) => r.type === 'item'
   300→      );
   301→      expect(itemResults.length).toBeGreaterThan(0);
   302→    });
   303→
   304→    // AC: @api-contract ac-19 - searches across tasks
   305→    test('finds tasks matching query', async ({ request, daemon }) => {
   306→      // Fixture has "Ready task", "In progress task", etc.
   307→      const response = await request.get(`${daemon.baseUrl}/api/search?q=Ready+task`);
   308→      expect(response.status()).toBe(200);
   309→
   310→      const body = await response.json();
   311→      const taskResults = body.results.filter((r: { type: string }) => r.type === 'task');
   312→      expect(taskResults.length).toBeGreaterThan(0);
   313→      expect(taskResults[0].type).toBe('task');
   314→    });
   315→
   316→    // AC: @api-contract ac-19 - searches inbox items
   317→    test('finds inbox items matching query', async ({ request, daemon }) => {
   318→      // Fixture inbox has "First inbox item for testing"
   319→      const response = await request.get(`${daemon.baseUrl}/api/search?q=First+inbox+item`);
   320→      expect(response.status()).toBe(200);
   321→
   322→      const body = await response.json();
   323→      const inboxResults = body.results.filter((r: { type: string }) => r.type === 'inbox');
   324→      expect(inboxResults.length).toBeGreaterThan(0);
   325→    });
   326→
   327→    // AC: @api-contract ac-19 - searches meta entities (observations)
   328→    test('finds observations matching query', async ({ request, daemon }) => {
   329→      // Fixture has "Test friction observation"
   330→      const response = await request.get(`${daemon.baseUrl}/api/search?q=friction+observation`);
   331→      expect(response.status()).toBe(200);
   332→
   333→      const body = await response.json();
   334→      const obsResults = body.results.filter(
   335→        (r: { type: string }) => r.type === 'observation'
   336→      );
   337→      expect(obsResults.length).toBeGreaterThan(0);
   338→    });
   339→
   340→    // AC: @api-contract ac-19 - returns empty results for no match
   341→    test('returns empty results for non-matching query', async ({ request, daemon }) => {
   342→      const response = await request.get(
   343→        `${daemon.baseUrl}/api/search?q=zzznomatch_unique_xyz_99999`
