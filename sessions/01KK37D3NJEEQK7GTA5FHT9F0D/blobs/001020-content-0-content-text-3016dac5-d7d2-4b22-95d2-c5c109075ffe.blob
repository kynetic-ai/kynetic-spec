```
     1→/**
     2→ * E2E API Tests for Daemon Meta, Validation, and Search Endpoints
     3→ *
     4→ * Tests verify actual HTTP behavior by calling the running daemon directly.
     5→ * These replace the static analysis tests in:
     6→ *   - tests/daemon-api-meta.test.ts (224 lines)
     7→ *   - tests/daemon-api-validation.test.ts (166 lines)
     8→ *
     9→ * Covered ACs:
    10→ * - @api-contract ac-15: GET /api/meta/session returns session context (focus, threads, questions)
    11→ * - @api-contract ac-16: GET /api/meta/agents returns all defined agents
    12→ * - @api-contract ac-17: GET /api/meta/workflows returns all defined workflows
    13→ * - @api-contract ac-18: GET /api/meta/observations with resolved filter
    14→ * - @api-contract ac-19: GET /api/search?q=keyword searches across all entities
    15→ * - @api-contract ac-20: GET /api/validate returns ValidationResult
    16→ * - @api-contract ac-21: GET /api/alignment returns AlignmentIndex stats and warnings
    17→ */
    18→
    19→// Trait N/A annotations — @api-contract inherits from 5 traits, all CLI-oriented, not applicable to HTTP REST API:
    20→// AC: @trait-json-output ac-1 — N/A: HTTP REST API always returns JSON; no --json flag concept for HTTP endpoints
    21→// AC: @trait-json-output ac-2 — N/A: HTTP REST API always returns full data; no human-readable vs JSON mode
    22→// AC: @trait-json-output ac-3 — N/A: HTTP REST API errors use HTTP status codes + JSON bodies, not --json flag
    23→// AC: @trait-json-output ac-4 — N/A: HTTP REST API references in JSON responses; @ prefix convention is CLI-specific
    24→// AC: @trait-json-output ac-5 — N/A: HTTP REST API timestamps are ISO 8601 by convention; not enforced via --json flag
    25→// AC: @trait-json-output ac-6 — N/A: HTTP REST API has no formatting flags; not applicable
    26→// AC: @trait-filterable-list ac-1 — N/A: HTTP REST API uses query params, not CLI --status flag; covered by search tests
    27→// AC: @trait-filterable-list ac-2 — N/A: HTTP REST API uses query params, not CLI --tag flag; not applicable here
    28→// AC: @trait-filterable-list ac-3 — N/A: HTTP REST API uses ?limit param; covered by search limit test below
    29→// AC: @trait-filterable-list ac-4 — N/A: HTTP REST API uses ?offset param; these endpoints don't support pagination
    30→// AC: @trait-filterable-list ac-5 — N/A: HTTP REST API AND-filter logic via multiple query params; not this spec's concern
    31→// AC: @trait-filterable-list ac-6 — N/A: HTTP REST API returns empty array on no match, not CLI empty message
    32→// AC: @trait-filterable-list ac-7 — N/A: HTTP REST API returns total field in JSON response; not CLI summary line
    33→// AC: @trait-filterable-list ac-8 — N/A: HTTP REST API has no --count mode; not applicable
    34→// AC: @trait-error-guidance ac-1 — N/A: CLI error message guidance; REST API uses JSON error bodies (tested in ac-22..24 E2E tests)
    35→// AC: @trait-error-guidance ac-2 — N/A: CLI error message guidance; REST API uses suggestion field (tested in error handling E2E tests)
    36→// AC: @trait-error-guidance ac-3 — N/A: CLI ref-not-found guidance; REST API uses 404 with suggestion (covered in errors E2E tests)
    37→// AC: @trait-error-guidance ac-4 — N/A: CLI state-transition error guidance; REST API 409 format tested in tasks E2E tests
    38→// AC: @trait-error-guidance ac-5 — N/A: CLI validation error guidance; REST API 422 format tested in tasks/inbox E2E tests
    39→// AC: @trait-error-guidance ac-6 — N/A: CLI error guidance; this is a CLI pattern not applicable to REST API endpoints
    40→// AC: @trait-api-endpoint ac-1 — covered: all endpoints return 200 + JSON body when request is valid (tested below)
    41→// AC: @trait-api-endpoint ac-2 — N/A: meta/validation endpoints don't take :ref params; 404 for invalid refs tested in errors E2E tests
    42→// AC: @trait-api-endpoint ac-3 — N/A: these endpoints are GET-only; 400 validation tested in tasks/inbox mutation E2E tests
    43→// AC: @trait-api-endpoint ac-4 — N/A: meta/observations doesn't use {items,total,offset,limit} wrapper; search uses {results,total,showing}
    44→// AC: @trait-api-endpoint ac-5 — N/A: these are read-only GET endpoints; no shadow commit occurs
    45→// AC: @trait-api-endpoint ac-6 — N/A: X-Request-Id header is infrastructure concern; not tested in domain E2E tests
    46→// AC: @trait-websocket-protocol ac-1 — N/A: WebSocket protocol; tested separately in api-websocket E2E tests
    47→// AC: @trait-websocket-protocol ac-2 — N/A: WebSocket subscribe command; tested separately in api-websocket E2E tests
    48→// AC: @trait-websocket-protocol ac-3 — N/A: WebSocket broadcast events; tested separately in api-websocket E2E tests
    49→// AC: @trait-websocket-protocol ac-4 — N/A: WebSocket heartbeat ping; tested separately in api-websocket E2E tests
    50→// AC: @trait-websocket-protocol ac-5 — N/A: WebSocket ping/pong timeout; tested separately in api-websocket E2E tests
    51→// AC: @trait-websocket-protocol ac-6 — N/A: WebSocket backpressure; tested separately in api-websocket E2E tests
    52→// AC: @trait-websocket-protocol ac-7 — N/A: WebSocket close codes; tested separately in api-websocket E2E tests
    53→// AC: @trait-websocket-protocol ac-8 — N/A: WebSocket reconnection; tested separately in api-websocket E2E tests
    54→// AC: @multi-directory-daemon ac-24 — covered: meta/validation routes use projectContext from middleware (daemon fixture provides this)
    55→
    56→import { test, expect } from '../fixtures/test-base';
    57→
    58→test.describe('Meta API', () => {
    59→  test.describe('GET /api/meta/session', () => {
    60→    // AC: @api-contract ac-15
    61→    test('returns session context with focus, threads, and questions', async ({
    62→      request,
    63→      daemon,
    64→    }) => {
    65→      const response = await request.get(`${daemon.baseUrl}/api/meta/session`);
    66→
    67→      expect(response.status()).toBe(200);
    68→
    69→      const body = await response.json();
    70→
    71→      // Required fields per ac-15
    72→      expect(body).toHaveProperty('focus');
    73→      expect(body).toHaveProperty('threads');
    74→      expect(body).toHaveProperty('questions');
    75→
    76→      // threads and questions are arrays
    77→      expect(Array.isArray(body.threads)).toBe(true);
    78→      expect(Array.isArray(body.questions)).toBe(true);
    79→    });
    80→
    81→    // AC: @api-contract ac-15 - fixture data integrity
    82→    test('returns fixture session context values', async ({ request, daemon }) => {
    83→      const response = await request.get(`${daemon.baseUrl}/api/meta/session`);
    84→      expect(response.status()).toBe(200);
    85→
    86→      const body = await response.json();
    87→      // Fixture has focus: "E2E testing", threads: [], questions: []
    88→      expect(body.focus).toBe('E2E testing');
    89→      expect(body.threads).toEqual([]);
    90→      expect(body.questions).toEqual([]);
    91→    });
    92→
    93→    // AC: @api-contract ac-15 - JSON content type
    94→    test('returns JSON content type', async ({ request, daemon }) => {
    95→      const response = await request.get(`${daemon.baseUrl}/api/meta/session`);
    96→      const contentType = response.headers()['content-type'] || '';
    97→      expect(contentType).toContain('application/json');
    98→    });
    99→  });
