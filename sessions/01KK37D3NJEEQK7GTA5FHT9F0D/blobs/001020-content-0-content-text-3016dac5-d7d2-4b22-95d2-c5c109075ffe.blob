   237→    });
   238→
   239→    // AC: @api-contract ac-18 - fixture content check
   240→    test('returns fixture observations with correct content', async ({ request, daemon }) => {
   241→      const response = await request.get(`${daemon.baseUrl}/api/meta/observations`);
   242→      expect(response.status()).toBe(200);
   243→
   244→      const body = await response.json();
   245→      const types = body.items.map((obs: { type: string }) => obs.type);
   246→
   247→      // Fixture has friction and success observations
   248→      expect(types).toContain('friction');
   249→      expect(types).toContain('success');
   250→
   251→      const frictionObs = body.items.find((obs: { type: string }) => obs.type === 'friction');
   252→      expect(frictionObs.content).toBe('Test friction observation');
   253→
   254→      const successObs = body.items.find((obs: { type: string }) => obs.type === 'success');
   255→      expect(successObs.content).toBe('Test success observation');
   256→    });
   257→  });
   258→});
