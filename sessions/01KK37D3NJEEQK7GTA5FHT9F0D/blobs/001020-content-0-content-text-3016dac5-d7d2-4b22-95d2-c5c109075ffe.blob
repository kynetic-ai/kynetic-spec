   361→
   362→    // AC: @api-contract ac-19 - result types are from known set
   363→    test('result types are from known entity types', async ({ request, daemon }) => {
   364→      const response = await request.get(`${daemon.baseUrl}/api/search?q=test`);
   365→      expect(response.status()).toBe(200);
   366→
   367→      const body = await response.json();
   368→      const knownTypes = ['item', 'task', 'inbox', 'observation', 'agent', 'workflow', 'convention'];
   369→
   370→      for (const result of body.results) {
   371→        expect(knownTypes).toContain(result.type);
   372→      }
   373→    });
   374→
   375→    // AC: @api-contract ac-19 - limit parameter restricts results
   376→    test('limits results with ?limit parameter', async ({ request, daemon }) => {
   377→      const response = await request.get(`${daemon.baseUrl}/api/search?q=test&limit=2`);
   378→      expect(response.status()).toBe(200);
   379→
   380→      const body = await response.json();
   381→      // Should have at most 2 results
   382→      expect(body.results.length).toBeLessThanOrEqual(2);
   383→      // Total may be higher than shown
   384→      expect(body).toHaveProperty('showing');
   385→    });
   386→
   387→    // AC: @api-contract ac-19 - showing field
   388→    test('includes showing field in response', async ({ request, daemon }) => {
   389→      const response = await request.get(`${daemon.baseUrl}/api/search?q=test`);
   390→      expect(response.status()).toBe(200);
   391→
   392→      const body = await response.json();
   393→      expect(body).toHaveProperty('showing');
   394→      expect(body.showing).toBe(body.results.length);
   395→    });
   396→  });
   397→});
