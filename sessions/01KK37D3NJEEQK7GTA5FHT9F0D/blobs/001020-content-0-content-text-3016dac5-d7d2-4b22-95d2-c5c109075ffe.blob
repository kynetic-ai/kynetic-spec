   463→  test.describe('GET /api/alignment', () => {
   464→    // AC: @api-contract ac-21
   465→    test('returns alignment stats and warnings', async ({ request, daemon }) => {
   466→      const response = await request.get(`${daemon.baseUrl}/api/alignment`);
   467→
   468→      expect(response.status()).toBe(200);
   469→
   470→      const body = await response.json();
   471→
