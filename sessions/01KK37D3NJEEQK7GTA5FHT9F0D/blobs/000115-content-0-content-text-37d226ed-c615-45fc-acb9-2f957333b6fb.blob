```
     1→<script lang="ts">
     2→import { AlertTriangle, ExternalLink, GitBranch } from 'lucide-svelte';
     3→import {
     4→  acceptTask,
     5→  archiveTask,
     6→  rejectTask,
     7→  startTask,
     8→  stopSession,
     9→  unassignTask,
    10→} from '$lib/api/client.js';
    11→import type { Task } from '$lib/api/types.js';
    12→import StatusBadge from '$lib/components/common/StatusBadge.svelte';
    13→import { Button } from '$lib/components/ui/button/index.js';
    14→import * as Dialog from '$lib/components/ui/dialog/index.js';
    15→import { sessionState, spokeState, taskState } from '$lib/state/index.js';
    16→import {
    17→  getBlockerMessage,
    18→  getTaskActions,
    19→  isTaskInReview,
    20→  isTaskRunning,
    21→} from '$lib/utils/task-actions.js';
    22→import MiniTerminal from './MiniTerminal.svelte';
    23→
    24→const { Root: Dialog_, Content: DialogContent, Header: DialogHeader, Title: DialogTitle } = Dialog;
    25→
    26→interface Props {
    27→  task: Task | null;
    28→  open: boolean;
    29→  onClose: () => void;
    30→}
    31→
    32→const { task, open = $bindable(false), onClose }: Props = $props();
    33→
    34→// Local state
    35→let isLoading = $state(false);
    36→let error = $state<string | null>(null);
    37→let rejectReason = $state('');
    38→let showRejectInput = $state(false);
    39→let showSpokeSelect = $state(false);
    40→let commentText = $state('');
    41→
    42→// Derived values
    43→const actions = $derived(task ? getTaskActions(task) : []);
    44→const isReview = $derived(task ? isTaskInReview(task) : false);
    45→const isRunning = $derived(task ? isTaskRunning(task) : false);
    46→const blockerMessage = $derived(task ? getBlockerMessage(task) : null);
    47→
    48→// Get session if task is running
    49→const session = $derived.by(() => {
    50→  if (!task?.current_session_id) return null;
    51→  return sessionState.getSession(task.current_session_id) ?? null;
    52→});
    53→
    54→// Available spokes for assignment (connected and ready to take work)
    55→const availableSpokes = $derived(spokeState.availableSpokes);
    56→
    57→// Short ID for display
    58→const shortId = $derived(task?.id.slice(0, 8) ?? '');
    59→
    60→// Has work actually been done on this task?
    61→// Show branch info only for tasks that have been started
    62→const hasBeenWorkedOn = $derived(
    63→  task ? task.session_history.length > 0 || !!task.current_session_id : false,
    64→);
    65→
    66→/**
    67→ * Handle action button click
    68→ */
    69→async function handleAction(actionId: string) {
    70→  if (!task) return;
    71→
    72→  error = null;
    73→  isLoading = true;
    74→
    75→  try {
    76→    switch (actionId) {
    77→      case 'start': {
    78→        const result = await startTask(task.id);
    79→        taskState.updateTask(result.task);
    80→        break;
    81→      }
    82→
    83→      case 'assign': {
    84→        showSpokeSelect = true;
    85→        isLoading = false;
    86→        return;
    87→      }
    88→
    89→      case 'unassign': {
    90→        const updated = await unassignTask(task.id);
    91→        taskState.updateTask(updated);
    92→        break;
    93→      }
    94→
    95→      case 'stop': {
    96→        if (task.current_session_id) {
    97→          await stopSession(task.current_session_id);
    98→        }
    99→        break;
   100→      }
   101→
   102→      case 'view_live': {
   103→        // Navigate to session chat view
   104→        if (task.current_session_id) {
   105→          window.location.href = `/sessions/${task.current_session_id}`;
   106→        }
   107→        break;
   108→      }
   109→
   110→      case 'accept': {
   111→        const updated = await acceptTask(task.id);
   112→        taskState.updateTask(updated);
   113→        onClose();
   114→        break;
   115→      }
   116→
   117→      case 'reject': {
   118→        if (!showRejectInput) {
   119→          showRejectInput = true;
   120→          isLoading = false;
   121→          return;
   122→        }
   123→        if (!rejectReason.trim()) {
   124→          error = 'Please provide a reason for rejection';
   125→          isLoading = false;
   126→          return;
   127→        }
   128→        const updated = await rejectTask(task.id, rejectReason);
   129→        taskState.updateTask(updated);
   130→        showRejectInput = false;
   131→        rejectReason = '';
   132→        onClose();
   133→        break;
   134→      }
   135→
   136→      case 'retry': {
   137→        const result = await startTask(task.id);
   138→        taskState.updateTask(result.task);
   139→        break;
   140→      }
   141→
   142→      case 'archive': {
   143→        const archived = await archiveTask(task.id);
   144→        taskState.updateTask(archived);
   145→        onClose();
   146→        break;
   147→      }
   148→    }
   149→  } catch (err) {
   150→    error = err instanceof Error ? err.message : String(err);
   151→  } finally {
   152→    isLoading = false;
   153→  }
   154→}
   155→
   156→/**
   157→ * Handle spoke selection for assignment
   158→ */
   159→async function handleSpokeSelect(spokeId: string) {
   160→  if (!task) return;
   161→
   162→  error = null;
   163→  isLoading = true;
   164→  showSpokeSelect = false;
   165→
   166→  try {
   167→    const result = await startTask(task.id, { spoke_id: spokeId });
   168→    taskState.updateTask(result.task);
   169→  } catch (err) {
   170→    error = err instanceof Error ? err.message : String(err);
   171→  } finally {
   172→    isLoading = false;
   173→  }
   174→}
   175→
   176→/**
   177→ * Reset state when modal closes
   178→ */
   179→function handleOpenChange(isOpen: boolean) {
   180→  if (!isOpen) {
   181→    showRejectInput = false;
   182→    showSpokeSelect = false;
   183→    rejectReason = '';
   184→    error = null;
   185→    onClose();
   186→  }
   187→}
   188→
   189→/**
   190→ * Get button variant based on action variant
   191→ */
   192→function getButtonVariant(
   193→  variant: string,
   194→): 'default' | 'destructive' | 'outline' | 'secondary' | 'ghost' {
   195→  switch (variant) {
   196→    case 'primary':
   197→      return 'default';
   198→    case 'destructive':
   199→      return 'destructive';
   200→    case 'secondary':
   201→      return 'secondary';
   202→    case 'outline':
   203→      return 'outline';
   204→    default:
   205→      return 'default';
   206→  }
   207→}
   208→</script>
   209→
   210→<Dialog_ {open} onOpenChange={handleOpenChange}>
   211→	<DialogContent class="max-w-4xl">
   212→		{#if task}
   213→			<!-- Header -->
   214→			<DialogHeader>
   215→				<div>
   216→					<p class="mb-1 text-xs text-zinc-500">
   217→						{isReview ? `Result Review: ${shortId}` : 'Task Details:'}
   218→					</p>
   219→					<DialogTitle>
   220→						<span class="text-zinc-500">{shortId}:</span> {task.title}
   221→					</DialogTitle>
   222→				</div>
   223→			</DialogHeader>
   224→
   225→			<!-- Status bar -->
   226→			<div class="flex items-center gap-3 border-b border-zinc-800 px-6 py-3">
   227→				<span class="text-zinc-500">Status:</span>
   228→				<StatusBadge status={task.status} />
   229→				{#if blockerMessage}
   230→					<div class="flex items-center gap-1.5 text-sm text-amber-500">
   231→						<AlertTriangle class="h-4 w-4" />
   232→						<span>{blockerMessage}</span>
   233→					</div>
   234→				{/if}
   235→			</div>
   236→
   237→			<!-- Error message -->
   238→			{#if error}
   239→				<div class="mx-6 mt-4 rounded-lg border border-red-800/50 bg-red-900/30 px-4 py-2 text-sm text-red-400">
   240→					{error}
   241→				</div>
   242→			{/if}
   243→
   244→			<!-- Main content grid -->
   245→			<div class="grid gap-6 p-6 md:grid-cols-2">
   246→				<!-- Left column: Description and activity -->
   247→				<div class="space-y-4">
   248→					<!-- Description -->
   249→					<div>
   250→						<h4 class="mb-2 text-sm text-zinc-500">Description:</h4>
   251→						{#if task.description}
   252→							<p class="text-zinc-300">{task.description}</p>
   253→						{:else}
   254→							<p class="italic text-zinc-600">No description provided</p>
   255→						{/if}
   256→					</div>
   257→
   258→					<!-- Rejection feedback (shown when task was rejected) -->
   259→					{#if task.reject_feedback}
   260→						<div class="rounded-lg border border-red-800/50 bg-red-900/20 p-4">
   261→							<h4 class="mb-2 text-sm font-medium text-red-400">Rejection Feedback:</h4>
   262→							<p class="text-sm text-red-300">{task.reject_feedback}</p>
   263→						</div>
   264→					{/if}
   265→
   266→					<!-- MiniTerminal for running tasks -->
   267→					{#if isRunning && session}
   268→						<MiniTerminal
   269→							sessionId={session.id}
   270→							status={session.status}
   271→							taskTitle={task.title}
   272→						/>
   273→					{/if}
   274→
   275→					<!-- Comments section (placeholder) -->
   276→					<div class="rounded-lg border border-zinc-800 bg-zinc-900/50 p-4">
   277→						<h4 class="mb-3 text-sm text-zinc-400">Comments</h4>
   278→						<textarea
   279→							bind:value={commentText}
   280→							placeholder="Add a comment..."
   281→							rows="3"
   282→							class="w-full resize-none rounded-lg border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-300 placeholder-zinc-600 focus:border-orange-700/50 focus:outline-none"
   283→						></textarea>
   284→					</div>
   285→				</div>
   286→
   287→				<!-- Right column: Metadata and actions -->
   288→				<div class="space-y-4">
   289→					<!-- Shadow Branch Metadata -->
   290→					<div class="space-y-4 rounded-lg border border-zinc-800 bg-zinc-900/50 p-4">
   291→						<h4 class="font-medium text-zinc-300">Shadow Branch Metadata</h4>
   292→
   293→						{#if task.vcs}
   294→							<!-- VCS metadata available -->
   295→							<div class="space-y-3">
   296→								<!-- Workspace state indicator -->
   297→								<div class="flex items-center gap-2">
   298→									<span class="text-sm text-zinc-500">State:</span>
   299→									{#if task.vcs.state === 'active'}
   300→										<span class="rounded-full bg-green-900/50 px-2 py-0.5 text-xs text-green-400">Active</span>
   301→									{:else if task.vcs.state === 'merging'}
   302→										<span class="rounded-full bg-yellow-900/50 px-2 py-0.5 text-xs text-yellow-400">Merging</span>
   303→									{:else if task.vcs.state === 'merged'}
   304→										<span class="rounded-full bg-blue-900/50 px-2 py-0.5 text-xs text-blue-400">Merged</span>
   305→									{:else if task.vcs.state === 'conflict'}
   306→										<span class="rounded-full bg-red-900/50 px-2 py-0.5 text-xs text-red-400">Conflict</span>
   307→									{:else if task.vcs.state === 'abandoned'}
   308→										<span class="rounded-full bg-zinc-700/50 px-2 py-0.5 text-xs text-zinc-400">Abandoned</span>
   309→									{/if}
   310→								</div>
   311→
   312→								<!-- Target branch -->
   313→								<div>
   314→									<span class="text-sm text-zinc-500">Target:</span>
   315→									<p class="mt-0.5 flex items-center gap-1.5 font-mono text-sm text-orange-400">
   316→										<GitBranch class="h-3.5 w-3.5" />
   317→										{task.vcs.target_branch}
   318→									</p>
   319→								</div>
   320→
   321→								<!-- Change ID -->
   322→								{#if task.vcs.change_id}
   323→									<div>
   324→										<span class="text-sm text-zinc-500">Change ID:</span>
   325→										<p class="mt-0.5 font-mono text-sm text-zinc-400">
   326→											{task.vcs.change_id.slice(0, 12)}
   327→										</p>
   328→									</div>
   329→								{/if}
   330→
   331→								<!-- Commit hash (for colocated repos) -->
   332→								{#if task.vcs.commit_hash}
   333→									<div>
   334→										<span class="text-sm text-zinc-500">Git Commit:</span>
   335→										<p class="mt-0.5 font-mono text-sm text-zinc-400">
   336→											{task.vcs.commit_hash.slice(0, 8)}
   337→										</p>
   338→									</div>
   339→								{/if}
   340→
   341→								<!-- Conflicted files (when in conflict state) -->
   342→								{#if task.vcs.state === 'conflict' && task.vcs.conflicted_files && task.vcs.conflicted_files.length > 0}
   343→									<div class="rounded-lg border border-red-800/50 bg-red-900/20 p-3">
   344→										<p class="mb-2 text-sm font-medium text-red-400">Conflicted Files:</p>
   345→										<ul class="space-y-1 font-mono text-xs text-red-300">
   346→											{#each task.vcs.conflicted_files as file}
   347→												<li>{file}</li>
   348→											{/each}
   349→										</ul>
   350→									</div>
   351→								{/if}
   352→							</div>
   353→						{:else if hasBeenWorkedOn}
   354→							<!-- Task has been worked on but no VCS data yet - show session history -->
   355→							{#if task.session_history.length > 0}
   356→								<div>
   357→									<span class="text-sm text-zinc-500">History:</span>
   358→									<p class="mt-1 text-sm text-orange-400">
   359→										{task.session_history.length} session(s) completed
   360→									</p>
   361→								</div>
   362→							{/if}
   363→
   364→							{#if task.current_session_id}
   365→								<div>
   366→									<span class="text-sm text-zinc-500">Active session:</span>
   367→									<p class="mt-1 font-mono text-sm text-orange-400">
   368→										{task.current_session_id.slice(0, 12)}
   369→									</p>
   370→								</div>
   371→							{/if}
   372→
   373→							<button
   374→								type="button"
   375→								class="flex items-center gap-1.5 text-sm text-zinc-400 hover:text-zinc-300"
   376→							>
   377→								<GitBranch class="h-3.5 w-3.5" />
   378→								View branch history
   379→								<ExternalLink class="h-3 w-3" />
   380→							</button>
   381→						{:else}
   382→							<!-- Task hasn't been started yet -->
   383→							<p class="text-sm italic text-zinc-600">No branch yet - task hasn't been started</p>
   384→						{/if}
   385→					</div>
   386→
   387→					<!-- Spoke selection (when assigning) -->
   388→					{#if showSpokeSelect}
   389→						<div class="space-y-2 rounded-lg border border-zinc-800 bg-zinc-900/50 p-4">
   390→							<h4 class="text-sm text-zinc-400">Select Spoke:</h4>
   391→							{#if availableSpokes.length === 0}
   392→								<p class="text-sm text-zinc-600">No available spokes</p>
   393→							{:else}
   394→								<div class="space-y-2">
   395→									{#each availableSpokes as spoke}
   396→										<button
   397→											type="button"
   398→											onclick={() => handleSpokeSelect(spoke.spokeId)}
   399→											disabled={isLoading}
   400→											class="w-full rounded-lg border border-zinc-800 bg-zinc-900 p-3 text-left transition-colors hover:border-orange-700/50 hover:bg-zinc-800 disabled:opacity-50"
   401→										>
   402→											<p class="font-medium text-zinc-300">{spoke.friendlyName ?? spoke.machineName}</p>
   403→											<p class="text-xs text-zinc-500">{spoke.spokeId.slice(0, 12)}</p>
   404→										</button>
   405→									{/each}
   406→								</div>
   407→							{/if}
   408→							<Button
   409→								variant="outline"
   410→								size="sm"
   411→								onclick={() => (showSpokeSelect = false)}
   412→								class="mt-2 w-full"
   413→							>
   414→								Cancel
   415→							</Button>
   416→						</div>
   417→					{/if}
   418→
   419→					<!-- Reject reason input -->
   420→					{#if showRejectInput}
   421→						<div class="space-y-2 rounded-lg border border-zinc-800 bg-zinc-900/50 p-4">
   422→							<h4 class="text-sm text-zinc-400">Rejection Reason:</h4>
   423→							<textarea
   424→								bind:value={rejectReason}
   425→								placeholder="Describe what changes are needed..."
   426→								rows="3"
   427→								class="w-full resize-none rounded-lg border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-zinc-300 placeholder-zinc-600 focus:border-orange-700/50 focus:outline-none"
   428→							></textarea>
   429→							<div class="flex gap-2">
   430→								<Button
   431→									variant="destructive"
   432→									size="sm"
   433→									onclick={() => handleAction('reject')}
   434→									disabled={isLoading}
   435→									class="flex-1"
   436→								>
   437→									{isLoading ? 'Submitting...' : 'Submit Rejection'}
   438→								</Button>
   439→								<Button
   440→									variant="outline"
   441→									size="sm"
   442→									onclick={() => {
   443→										showRejectInput = false;
   444→										rejectReason = '';
   445→									}}
   446→									class="flex-1"
   447→								>
   448→									Cancel
   449→								</Button>
   450→							</div>
   451→						</div>
   452→					{/if}
   453→
   454→					<!-- Action buttons -->
   455→					{#if !showSpokeSelect && !showRejectInput}
   456→						<div class="space-y-2">
   457→							{#each actions as action}
   458→								<Button
   459→									variant={getButtonVariant(action.variant)}
   460→									onclick={() => handleAction(action.id)}
   461→									disabled={isLoading}
   462→									class="w-full justify-center gap-2"
   463→								>
   464→									{#if action.icon}
   465→										<span>{action.icon}</span>
   466→									{/if}
   467→									{action.label}
   468→								</Button>
   469→							{/each}
   470→						</div>
   471→					{/if}
   472→
   473→					<!-- Task metadata -->
   474→					<div class="space-y-2 text-xs text-zinc-500">
   475→						<div>Priority: <span class="text-zinc-400">P{task.priority}</span></div>
   476→						{#if task.assigned_to}
   477→							<div>Assigned to: <span class="text-zinc-400">{task.assigned_to.slice(0, 12)}</span></div>
   478→						{/if}
   479→						<div>Created: <span class="text-zinc-400">{new Date(task.created_at).toLocaleString()}</span></div>
   480→						<div>Updated: <span class="text-zinc-400">{new Date(task.updated_at).toLocaleString()}</span></div>
   481→					</div>
   482→				</div>
   483→			</div>
   484→		{/if}
   485→	</DialogContent>
   486→</Dialog_>
   487→
```