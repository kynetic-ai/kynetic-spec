   229→// ─── Environment Injection ───────────────────────────────────────────────────
   230→
   231→describe("Environment Injection", () => {
   232→  let testDir: string;
   233→
   234→  beforeEach(async () => {
   235→    testDir = await createTempDir("kspec-env-inject-");
   236→  });
   237→
   238→  afterEach(async () => {
   239→    await cleanupTempDir(testDir);
   240→  });
   241→
   242→  describe("injectClaudeCodeEnv", () => {
   243→    // AC: @session-creation-and-env-injection ac-inject-claude
   244→    it("should write to CLAUDE_ENV_FILE when set", async () => {
   245→      const envFile = path.join(testDir, "claude-env");
   246→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   247→      process.env.CLAUDE_ENV_FILE = envFile;
   248→
   249→      try {
   250→        const sessionId = testUlid("CLDE", 1);
   251→        const result = await injectClaudeCodeEnv(sessionId);
   252→
   253→        expect(result.injected).toBe(true);
   254→        expect(result.method).toBe("claude_env_file");
   255→        expect(result.path).toBe(envFile);
   256→
   257→        const content = await fs.readFile(envFile, "utf-8");
   258→        expect(content).toContain(`KSPEC_SESSION_ID=${sessionId}`);
   259→      } finally {
   260→        if (originalEnv !== undefined) {
   261→          process.env.CLAUDE_ENV_FILE = originalEnv;
   262→        } else {
   263→          delete process.env.CLAUDE_ENV_FILE;
   264→        }
   265→      }
   266→    });
   267→
   268→    // AC: @session-creation-and-env-injection ac-inject-claude
   269→    it("should replace existing KSPEC_SESSION_ID in CLAUDE_ENV_FILE", async () => {
   270→      const envFile = path.join(testDir, "claude-env");
   271→      await fs.writeFile(
   272→        envFile,
   273→        "OTHER_VAR=foo\nKSPEC_SESSION_ID=old-session\nANOTHER=bar\n",
   274→        "utf-8",
   275→      );
   276→
   277→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   278→      process.env.CLAUDE_ENV_FILE = envFile;
   279→
   280→      try {
   281→        const sessionId = testUlid("CLDE", 2);
   282→        await injectClaudeCodeEnv(sessionId);
   283→
   284→        const content = await fs.readFile(envFile, "utf-8");
   285→        expect(content).toContain(`KSPEC_SESSION_ID=${sessionId}`);
   286→        expect(content).not.toContain("old-session");
   287→        expect(content).toContain("OTHER_VAR=foo");
   288→        expect(content).toContain("ANOTHER=bar");
   289→      } finally {
   290→        if (originalEnv !== undefined) {
   291→          process.env.CLAUDE_ENV_FILE = originalEnv;
   292→        } else {
   293→          delete process.env.CLAUDE_ENV_FILE;
   294→        }
   295→      }
   296→    });
   297→
   298→    // AC: @session-creation-and-env-injection ac-inject-claude
   299→    it("should write to .claude/settings.json when CLAUDE_ENV_FILE not set", async () => {
   300→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   301→      const originalCwd = process.cwd();
   302→      delete process.env.CLAUDE_ENV_FILE;
   303→
   304→      try {
   305→        process.chdir(testDir);
   306→        const sessionId = testUlid("CLDE", 3);
   307→        const result = await injectClaudeCodeEnv(sessionId);
   308→
   309→        expect(result.injected).toBe(true);
   310→        expect(result.method).toBe("claude_settings");
   311→
   312→        const settingsPath = path.join(testDir, ".claude", "settings.json");
   313→        const content = await fs.readFile(settingsPath, "utf-8");
   314→        const settings = JSON.parse(content);
   315→        expect(settings.env.KSPEC_SESSION_ID).toBe(sessionId);
   316→      } finally {
   317→        process.chdir(originalCwd);
   318→        if (originalEnv !== undefined) {
   319→          process.env.CLAUDE_ENV_FILE = originalEnv;
   320→        }
   321→      }
   322→    });
   323→  });
   324→
   325→  describe("injectCodexEnv", () => {
   326→    // AC: @session-creation-and-env-injection ac-inject-codex
   327→    it("should add KSPEC_SESSION_ID to codex config", async () => {
   328→      const configDir = path.join(testDir, ".codex");
   329→      const originalHome = process.env.HOME;
   330→      process.env.HOME = testDir;
   331→
   332→      try {
   333→        const sessionId = testUlid("CDEX", 1);
   334→        const result = await injectCodexEnv(sessionId);
   335→
   336→        expect(result.injected).toBe(true);
   337→        expect(result.method).toBe("codex_config");
   338→
   339→        const configPath = path.join(configDir, "config.json");
   340→        const content = await fs.readFile(configPath, "utf-8");
   341→        const config = JSON.parse(content);
   342→        expect(config.shell_environment_policy.set.KSPEC_SESSION_ID).toBe(
   343→          sessionId,
   344→        );
   345→      } finally {
   346→        process.env.HOME = originalHome;
   347→      }
   348→    });
   349→
   350→    // AC: @session-creation-and-env-injection ac-inject-codex
   351→    it("should preserve existing codex config values", async () => {
   352→      const configDir = path.join(testDir, ".codex");
   353→      await fs.mkdir(configDir, { recursive: true });
   354→      await fs.writeFile(
   355→        path.join(configDir, "config.json"),
   356→        JSON.stringify({
   357→          model: "gpt-5",
   358→          shell_environment_policy: {
   359→            set: { EXISTING_VAR: "keep" },
   360→            inherit: ["PATH"],
   361→          },
   362→        }),
   363→        "utf-8",
   364→      );
   365→
   366→      const originalHome = process.env.HOME;
   367→      process.env.HOME = testDir;
   368→
   369→      try {
   370→        const sessionId = testUlid("CDEX", 2);
   371→        await injectCodexEnv(sessionId);
   372→
   373→        const content = await fs.readFile(
   374→          path.join(configDir, "config.json"),
   375→          "utf-8",
   376→        );
   377→        const config = JSON.parse(content);
   378→        expect(config.model).toBe("gpt-5");
   379→        expect(config.shell_environment_policy.set.EXISTING_VAR).toBe("keep");
   380→        expect(config.shell_environment_policy.set.KSPEC_SESSION_ID).toBe(
   381→          sessionId,
   382→        );
   383→        expect(config.shell_environment_policy.inherit).toEqual(["PATH"]);
   384→      } finally {
   385→        process.env.HOME = originalHome;
   386→      }
   387→    });
   388→  });
   389→
   390→  describe("config file safety", () => {
   391→    it("should throw on corrupt .claude/settings.json instead of overwriting", async () => {
   392→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   393→      const originalCwd = process.cwd();
   394→      delete process.env.CLAUDE_ENV_FILE;
   395→
   396→      try {
   397→        process.chdir(testDir);
   398→        const settingsDir = path.join(testDir, ".claude");
   399→        await fs.mkdir(settingsDir, { recursive: true });
   400→        await fs.writeFile(
   401→          path.join(settingsDir, "settings.json"),
   402→          "this is not valid json {{{",
   403→          "utf-8",
   404→        );
   405→
   406→        const sessionId = testUlid("CRPT", 1);
   407→        await expect(injectClaudeCodeEnv(sessionId)).rejects.toThrow(
   408→          "not valid JSON",
   409→        );
   410→      } finally {
   411→        process.chdir(originalCwd);
   412→        if (originalEnv !== undefined) {
   413→          process.env.CLAUDE_ENV_FILE = originalEnv;
   414→        }
   415→      }
   416→    });
   417→
   418→    it("should throw on corrupt codex config.json instead of overwriting", async () => {
   419→      const configDir = path.join(testDir, ".codex");
   420→      await fs.mkdir(configDir, { recursive: true });
   421→      await fs.writeFile(
   422→        path.join(configDir, "config.json"),
   423→        "not json at all!",
   424→        "utf-8",
   425→      );
   426→
   427→      const originalHome = process.env.HOME;
   428→      process.env.HOME = testDir;
   429→
   430→      try {
   431→        const sessionId = testUlid("CRPT", 2);
   432→        await expect(injectCodexEnv(sessionId)).rejects.toThrow(
   433→          "not valid JSON",
   434→        );
   435→      } finally {
   436→        process.env.HOME = originalHome;
   437→      }
   438→    });
   439→  });
