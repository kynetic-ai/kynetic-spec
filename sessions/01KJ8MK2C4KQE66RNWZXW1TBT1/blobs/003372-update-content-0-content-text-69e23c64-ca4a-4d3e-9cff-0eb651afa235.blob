```
     1→/**
     2→ * Session create command and library function tests.
     3→ *
     4→ * Tests for session creation, budget setup, environment injection,
     5→ * and invalid session validation.
     6→ *
     7→ * Task: @implement-session-create-command
     8→ * Spec: @session-creation-and-env-injection
     9→ */
    10→
    11→import { describe, it, expect, beforeEach, afterEach } from "vitest";
    12→import * as fs from "node:fs/promises";
    13→import * as path from "node:path";
    14→import * as os from "node:os";
    15→import {
    16→  createSessionWithBudget,
    17→  validateSessionId,
    18→  injectClaudeCodeEnv,
    19→  injectCodexEnv,
    20→  getFallbackInjectionInstructions,
    21→  getSession,
    22→  getBudget,
    23→  getSessionBudgetPath,
    24→  createSession,
    25→} from "../src/sessions/store.js";
    26→import type { SessionMetadataInput } from "../src/sessions/types.js";
    27→import {
    28→  kspec,
    29→  kspecJson,
    30→  setupTempFixtures,
    31→  cleanupTempDir,
    32→  createTempDir,
    33→  testUlid,
    34→} from "./helpers/cli.js";
    35→
    36→// ─── Library Function: createSessionWithBudget ──────────────────────────────
    37→
    38→describe("createSessionWithBudget", () => {
    39→  let testDir: string;
    40→
    41→  beforeEach(async () => {
    42→    testDir = await createTempDir("kspec-session-create-");
    43→    // Create sessions directory
    44→    await fs.mkdir(path.join(testDir, "sessions"), { recursive: true });
    45→  });
    46→
    47→  afterEach(async () => {
    48→    await cleanupTempDir(testDir);
    49→  });
    50→
    51→  // AC: @session-creation-and-env-injection ac-create
    52→  it("should create a session with status active and return metadata", async () => {
    53→    const sessionId = testUlid("SESS", 1);
    54→    const result = await createSessionWithBudget(testDir, {
    55→      id: sessionId,
    56→      agent_type: "claude-code",
    57→    });
    58→
    59→    expect(result.session_id).toBe(sessionId);
    60→    expect(result.session.id).toBe(sessionId);
    61→    expect(result.session.status).toBe("active");
    62→    expect(result.session.agent_type).toBe("claude-code");
    63→    expect(result.session.started_at).toBeTruthy();
    64→    expect(result.budget).toBeNull();
    65→  });
    66→
    67→  // AC: @session-creation-and-env-injection ac-create
    68→  it("should create session directory with session.yaml", async () => {
    69→    const sessionId = testUlid("SESS", 2);
    70→    await createSessionWithBudget(testDir, {
    71→      id: sessionId,
    72→      agent_type: "codex-cli",
    73→    });
    74→
    75→    const sessionDir = path.join(testDir, "sessions", sessionId);
    76→    const stat = await fs.stat(sessionDir);
    77→    expect(stat.isDirectory()).toBe(true);
    78→
    79→    const metadataPath = path.join(sessionDir, "session.yaml");
    80→    const content = await fs.readFile(metadataPath, "utf-8");
    81→    expect(content).toContain("status: active");
    82→    expect(content).toContain("agent_type: codex-cli");
    83→  });
    84→
    85→  // AC: @session-creation-and-env-injection ac-budget
    86→  it("should create budget.json when budget option provided", async () => {
    87→    const sessionId = testUlid("SESS", 3);
    88→    const result = await createSessionWithBudget(testDir, {
    89→      id: sessionId,
    90→      agent_type: "claude-code",
    91→      budget: 5,
    92→    });
    93→
    94→    expect(result.budget).not.toBeNull();
    95→    expect(result.budget!.max_per_cycle).toBe(5);
    96→    expect(result.budget!.started_this_cycle).toBe(0);
    97→  });
    98→
    99→  // AC: @session-creation-and-env-injection ac-budget-local
   100→  it("should store budget.json on local filesystem in session directory", async () => {
   101→    const sessionId = testUlid("SESS", 4);
   102→    await createSessionWithBudget(testDir, {
   103→      id: sessionId,
   104→      agent_type: "claude-code",
   105→      budget: 3,
   106→    });
   107→
   108→    const budgetPath = getSessionBudgetPath(testDir, sessionId);
   109→    const content = await fs.readFile(budgetPath, "utf-8");
   110→    const budget = JSON.parse(content);
   111→    expect(budget.max_per_cycle).toBe(3);
   112→    expect(budget.started_this_cycle).toBe(0);
   113→    // Verify it's in the expected location
   114→    expect(budgetPath).toContain(path.join("sessions", sessionId, "budget.json"));
   115→  });
   116→
   117→  // AC: @session-creation-and-env-injection ac-library
   118→  it("should return metadata without console output", async () => {
   119→    const sessionId = testUlid("SESS", 5);
   120→    // Capture console output
   121→    const consoleLogs: string[] = [];
   122→    const originalLog = console.log;
   123→    console.log = (...args: unknown[]) => consoleLogs.push(args.join(" "));
   124→
   125→    try {
   126→      const result = await createSessionWithBudget(testDir, {
   127→        id: sessionId,
   128→        agent_type: "claude-code",
   129→        budget: 2,
   130→      });
   131→
   132→      // Library function should not produce console output
   133→      expect(consoleLogs).toHaveLength(0);
   134→
   135→      // Should return complete metadata
   136→      expect(result.session_id).toBe(sessionId);
   137→      expect(result.session.id).toBe(sessionId);
   138→      expect(result.session.status).toBe("active");
   139→      expect(result.budget).not.toBeNull();
   140→      expect(result.budget!.max_per_cycle).toBe(2);
   141→    } finally {
   142→      console.log = originalLog;
   143→    }
   144→  });
   145→
   146→  it("should include task_id when provided", async () => {
   147→    const sessionId = testUlid("SESS", 6);
   148→    const taskId = testUlid("TASK", 1);
   149→    const result = await createSessionWithBudget(testDir, {
   150→      id: sessionId,
   151→      agent_type: "claude-code",
   152→      task_id: taskId,
   153→    });
   154→
   155→    expect(result.session.task_id).toBe(taskId);
   156→  });
   157→
   158→  it("should not create budget when budget is undefined", async () => {
   159→    const sessionId = testUlid("SESS", 7);
   160→    const result = await createSessionWithBudget(testDir, {
   161→      id: sessionId,
   162→      agent_type: "claude-code",
   163→    });
   164→
   165→    expect(result.budget).toBeNull();
   166→
   167→    // Verify no budget file exists
   168→    const budgetPath = getSessionBudgetPath(testDir, sessionId);
   169→    await expect(fs.access(budgetPath)).rejects.toThrow();
   170→  });
   171→});
