   173→// ─── Session Validation ──────────────────────────────────────────────────────
   174→
   175→describe("validateSessionId", () => {
   176→  let testDir: string;
   177→
   178→  beforeEach(async () => {
   179→    testDir = await createTempDir("kspec-session-validate-");
   180→    await fs.mkdir(path.join(testDir, "sessions"), { recursive: true });
   181→  });
   182→
   183→  afterEach(async () => {
   184→    await cleanupTempDir(testDir);
   185→  });
   186→
   187→  // AC: @session-creation-and-env-injection ac-invalid-session
   188→  it("should return valid for existing session with correct metadata", async () => {
   189→    const sessionId = testUlid("VALID", 1);
   190→    await createSession(testDir, {
   191→      id: sessionId,
   192→      agent_type: "claude-code",
   193→    });
   194→
   195→    const result = await validateSessionId(testDir, sessionId);
   196→    expect(result.valid).toBe(true);
   197→    expect(result.session).toBeDefined();
   198→    expect(result.session!.id).toBe(sessionId);
   199→  });
   200→
   201→  // AC: @session-creation-and-env-injection ac-invalid-session
   202→  it("should return error for nonexistent session with clear message", async () => {
   203→    const result = await validateSessionId(testDir, "NONEXISTENT_SESSION");
   204→    expect(result.valid).toBe(false);
   205→    expect(result.error).toContain("Session not found");
   206→    expect(result.error).toContain("NONEXISTENT_SESSION");
   207→    expect(result.suggestion).toContain("kspec session create");
   208→  });
   209→
   210→  // AC: @session-creation-and-env-injection ac-invalid-session
   211→  it("should return error for corrupt session metadata", async () => {
   212→    const sessionId = testUlid("CRPT", 1);
   213→    const sessionDir = path.join(testDir, "sessions", sessionId);
   214→    await fs.mkdir(sessionDir, { recursive: true });
   215→    // Write invalid YAML
   216→    await fs.writeFile(
   217→      path.join(sessionDir, "session.yaml"),
   218→      "this is not valid yaml: [[[",
   219→      "utf-8",
   220→    );
   221→
   222→    const result = await validateSessionId(testDir, sessionId);
   223→    expect(result.valid).toBe(false);
   224→    expect(result.error).toContain("corrupt");
   225→    expect(result.suggestion).toContain("kspec session create");
   226→  });
   227→});
