   441→  describe("getFallbackInjectionInstructions", () => {
   442→    // AC: @session-creation-and-env-injection ac-inject-fallback
   443→    it("should return export command for manual sourcing", () => {
   444→      const sessionId = testUlid("FLLB", 1);
