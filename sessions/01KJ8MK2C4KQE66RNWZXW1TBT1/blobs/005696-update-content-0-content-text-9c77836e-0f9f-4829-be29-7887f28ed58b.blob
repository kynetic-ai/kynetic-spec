    77→// ─── Types ───────────────────────────────────────────────────────────────────
    78→
    79→export interface CheckpointResult {
    80→  /** Whether session can end cleanly */
    81→  ok: boolean;
    82→
    83→  /** Human-readable message for Claude Code */
    84→  message: string;
    85→
    86→  /** Issues that need attention before stopping */
    87→  issues: CheckpointIssue[];
    88→
    89→  /** Instructions for the agent */
    90→  instructions: string[];
    91→}
    92→
    93→export interface CheckpointIssue {
    94→  type: "uncommitted_changes" | "in_progress_task" | "incomplete_todo";
    95→  description: string;
    96→  details?: Record<string, unknown>;
    97→}
    98→
    99→export interface SessionContext {
   100→  /** When this context was generated */
   101→  generated_at: string;
   102→
   103→  /** Current git branch */
   104→  branch: string | null;
   105→
   106→  /** Session context (focus, threads, questions) */
   107→  context: StoredSessionContext | null;
   108→
   109→  /** Tasks currently in progress */
   110→  active_tasks: ActiveTaskSummary[];
   111→
   112→  /** Tasks awaiting review (code done, PR pending) */
   113→  pending_review_tasks: ActiveTaskSummary[];
   114→
   115→  /** Recent notes from active tasks */
   116→  recent_notes: NoteSummary[];
   117→
   118→  /** Incomplete todos from active tasks */
   119→  active_todos: TodoSummary[];
   120→
   121→  /** Tasks ready to be picked up */
   122→  ready_tasks: ReadyTaskSummary[];
   123→
   124→  /** Blocked tasks with blockers */
   125→  blocked_tasks: BlockedTaskSummary[];
   126→
   127→  /** Recently completed tasks */
   128→  recently_completed: CompletedTaskSummary[];
   129→
   130→  /** Recent git commits */
   131→  recent_commits: CommitSummary[];
   132→
   133→  /** Working tree status */
   134→  working_tree: GitWorkingTree | null;
   135→
   136→  /** Inbox items awaiting triage (oldest first) */
   137→  inbox_items: InboxSummary[];
   138→
   139→  /** Summary statistics */
   140→  stats: SessionStats;
   141→}
   142→
   143→export interface ActiveTaskSummary {
   144→  ref: string;
   145→  title: string;
   146→  started_at: string | null;
   147→  priority: number;
   148→  spec_ref: string | null;
   149→  note_count: number;
   150→  last_note_at: string | null;
   151→  todo_count: number;
   152→  incomplete_todos: number;
   153→}
   154→
   155→export interface NoteSummary {
   156→  task_ref: string;
   157→  task_title: string;
   158→  task_status: "in_progress" | "pending_review" | "needs_work" | "completed";
   159→  note_ulid: string;
   160→  created_at: string;
   161→  author: string | null;
   162→  content: string;
   163→}
   164→
   165→export interface TodoSummary {
   166→  task_ref: string;
   167→  task_title: string;
   168→  id: number;
   169→  text: string;
   170→  added_at: string;
   171→  added_by: string | null;
   172→}
   173→
   174→export interface ReadyTaskSummary {
   175→  ref: string;
   176→  title: string;
   177→  priority: number;
   178→  spec_ref: string | null;
   179→  tags: string[];
   180→}
   181→
   182→export interface BlockedTaskSummary {
   183→  ref: string;
   184→  title: string;
   185→  blocked_by: string[];
   186→  unmet_deps: string[];
   187→}
   188→
   189→export interface CompletedTaskSummary {
   190→  ref: string;
   191→  title: string;
   192→  completed_at: string;
   193→  closed_reason: string | null;
   194→  origin?: "manual" | "derived" | "observation_promotion";
   195→}
   196→
   197→export interface CommitSummary {
   198→  hash: string;
   199→  full_hash: string;
   200→  date: string;
   201→  message: string;
   202→  author: string;
   203→}
   204→
   205→export interface SessionStats {
   206→  total_tasks: number;
   207→  in_progress: number;
   208→  needs_work: number;
   209→  pending_review: number;
   210→  ready: number;
   211→  blocked: number;
   212→  completed: number;
   213→  inbox_items: number;
   214→}
   215→
   216→export interface InboxSummary {
   217→  ref: string;
   218→  text: string;
   219→  created_at: string;
   220→  tags: string[];
   221→  added_by: string | null;
   222→}
   223→
   224→export interface SessionOptions {
   225→  brief?: boolean;
   226→  full?: boolean;
   227→  since?: string;
   228→  git?: boolean;
   229→  limit?: string;
   230→  eligible?: boolean; // Only include automation-eligible tasks in ready_tasks
   231→}
   232→
   233→// ─── Data Gathering ──────────────────────────────────────────────────────────
   234→
   235→function toActiveTaskSummary(
   236→  task: LoadedTask,
   237→  index: ReferenceIndex,
   238→): ActiveTaskSummary {
   239→  const lastNote =
   240→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   241→  const incompleteTodos = task.todos.filter((t) => !t.done).length;
   242→  return {
   243→    ref: index.shortUlid(task._ulid),
   244→    title: task.title,
   245→    started_at: task.started_at || null,
   246→    priority: task.priority,
   247→    spec_ref: task.spec_ref || null,
   248→    note_count: task.notes.length,
   249→    last_note_at: lastNote ? lastNote.created_at : null,
   250→    todo_count: task.todos.length,
   251→    incomplete_todos: incompleteTodos,
   252→  };
   253→}
   254→
   255→function toReadyTaskSummary(
   256→  task: LoadedTask,
   257→  index: ReferenceIndex,
   258→): ReadyTaskSummary {
   259→  return {
   260→    ref: index.shortUlid(task._ulid),
   261→    title: task.title,
   262→    priority: task.priority,
   263→    spec_ref: task.spec_ref || null,
   264→    tags: task.tags,
   265→  };
   266→}
   267→
   268→function toBlockedTaskSummary(
   269→  task: LoadedTask,
   270→  _allTasks: LoadedTask[],
   271→  index: ReferenceIndex,
   272→): BlockedTaskSummary {
   273→  // Find unmet dependencies
   274→  const unmetDeps: string[] = [];
   275→  for (const depRef of task.depends_on) {
   276→    const result = index.resolve(depRef);
   277→    if (result.ok) {
   278→      const depItem = result.item;
   279→      if ("status" in depItem && depItem.status !== "completed") {
   280→        unmetDeps.push(depRef);
   281→      }
   282→    }
   283→  }
   284→
   285→  return {
   286→    ref: index.shortUlid(task._ulid),
   287→    title: task.title,
   288→    blocked_by: task.blocked_by,
   289→    unmet_deps: unmetDeps,
   290→  };
   291→}
   292→
   293→function toCompletedTaskSummary(
   294→  task: LoadedTask,
   295→  index: ReferenceIndex,
   296→): CompletedTaskSummary {
   297→  return {
   298→    ref: index.shortUlid(task._ulid),
   299→    title: task.title,
   300→    completed_at: task.completed_at || "",
   301→    closed_reason: task.closed_reason || null,
   302→    origin: task.origin,
   303→  };
   304→}
   305→
   306→function collectRecentNotes(
   307→  tasks: LoadedTask[],
   308→  index: ReferenceIndex,
   309→  options: { limit: number; since: Date | null },
   310→): NoteSummary[] {
   311→  const allNotes: NoteSummary[] = [];
   312→
   313→  for (const task of tasks) {
   314→    // Only include notes from in_progress, pending_review, or completed tasks
   315→    const taskStatus = task.status as "in_progress" | "pending_review" | "needs_work" | "completed";
   316→    if (!["in_progress", "pending_review", "needs_work", "completed"].includes(taskStatus)) {
   317→      continue;
   318→    }
   319→
   320→    for (const note of task.notes) {
   321→      const noteDate = new Date(note.created_at);
   322→
   323→      // Filter by since date if provided
   324→      if (options.since && noteDate < options.since) {
   325→        continue;
   326→      }
   327→
   328→      // Filter out superseded notes
   329→      if (isNoteSuperseded(note, task.notes)) {
   330→        continue;
   331→      }
   332→
   333→      allNotes.push({
   334→        task_ref: index.shortUlid(task._ulid),
   335→        task_title: task.title,
   336→        task_status: taskStatus,
   337→        note_ulid: note._ulid.slice(0, 8),
   338→        created_at: note.created_at,
   339→        author: note.author || null,
   340→        content: note.content,
   341→      });
   342→    }
   343→  }
   344→
   345→  // Sort by date descending, take limit
   346→  return allNotes
   347→    .sort(
   348→      (a, b) =>
   349→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   350→    )
   351→    .slice(0, options.limit);
   352→}
   353→
   354→function collectIncompleteTodos(
   355→  tasks: LoadedTask[],
   356→  index: ReferenceIndex,
   357→  options: { limit: number },
   358→): TodoSummary[] {
   359→  const allTodos: TodoSummary[] = [];
   360→
   361→  for (const task of tasks) {
   362→    for (const todo of task.todos) {
   363→      // Only include incomplete todos
   364→      if (todo.done) continue;
   365→
   366→      allTodos.push({
   367→        task_ref: index.shortUlid(task._ulid),
   368→        task_title: task.title,
   369→        id: todo.id,
   370→        text: todo.text,
   371→        added_at: todo.added_at,
   372→        added_by: todo.added_by || null,
   373→      });
   374→    }
   375→  }
   376→
   377→  // Sort by added_at descending (most recent first), take limit
   378→  return allTodos
   379→    .sort(
   380→      (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime(),
   381→    )
   382→    .slice(0, options.limit);
   383→}
   384→
   385→/**
   386→ * Gather session context data
   387→ */
   388→export async function gatherSessionContext(
   389→  ctx: KspecContext,
   390→  options: SessionOptions,
   391→): Promise<SessionContext> {
   392→  const limit = parseInt(options.limit || "10", 10);
   393→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   394→  const showGit = options.git !== false; // default true
   395→
   396→  // Load all data
   397→  const allTasks = await loadAllTasks(ctx);
   398→  const items = await loadAllItems(ctx);
   399→  const inboxItems = await loadInboxItems(ctx);
   400→  const index = new ReferenceIndex(allTasks, items);
   401→
   402→  // Compute stats
   403→  const stats: SessionStats = {
   404→    total_tasks: allTasks.length,
   405→    in_progress: allTasks.filter((t) => t.status === "in_progress").length,
   406→    needs_work: allTasks.filter((t) => t.status === "needs_work").length,
   407→    pending_review: allTasks.filter((t) => t.status === "pending_review")
   408→      .length,
   409→    ready: getReadyTasks(allTasks).length,
   410→    blocked: allTasks.filter((t) => t.status === "blocked").length,
   411→    completed: allTasks.filter((t) => t.status === "completed").length,
   412→    inbox_items: inboxItems.length,
   413→  };
   414→
   415→  // Get active tasks (in_progress + needs_work, optionally filtered to automation-eligible only)
   416→  // AC: @cli-ralph ac-16
   417→  const activeTasks = allTasks
   418→    .filter((t) => t.status === "in_progress" || t.status === "needs_work")
   419→    .filter((t) => !options.eligible || t.automation === "eligible")
   420→    .sort((a, b) => a.priority - b.priority)
   421→    .slice(0, options.full ? undefined : limit)
   422→    .map((t) => toActiveTaskSummary(t, index));
   423→
   424→  // Get pending review tasks
   425→  const pendingReviewTasks = allTasks
   426→    .filter((t) => t.status === "pending_review")
   427→    .sort((a, b) => a.priority - b.priority)
   428→    .slice(0, options.full ? undefined : limit)
   429→    .map((t) => toActiveTaskSummary(t, index));
   430→
   431→  // Get recent notes from active, pending_review, and recently completed tasks
   432→  // AC: @cmd-session-start ac-1, ac-2
   433→  // Collect notes per-status first to prevent one status from starving others
   434→  const noteLimitPerStatus = options.full ? limit : Math.ceil(limit / 3);
   435→
   436→  const inProgressNotes = collectRecentNotes(
   437→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   438→    index,
   439→    { limit: noteLimitPerStatus, since: sinceDate },
   440→  );
   441→
   442→  const pendingReviewNotes = collectRecentNotes(
   443→    allTasks.filter((t) => t.status === "pending_review"),
   444→    index,
   445→    { limit: noteLimitPerStatus, since: sinceDate },
   446→  );
   447→
   448→  const recentlyCompletedForNotes = allTasks
   449→    .filter((t) => t.status === "completed" && t.completed_at)
   450→    .sort((a, b) => {
   451→      const aDate = new Date(a.completed_at || 0);
   452→      const bDate = new Date(b.completed_at || 0);
   453→      return bDate.getTime() - aDate.getTime();
   454→    })
   455→    .slice(0, 5); // Last 3-5 completed tasks per AC-2
   456→
   457→  const completedNotes = collectRecentNotes(
   458→    recentlyCompletedForNotes,
   459→    index,
   460→    { limit: noteLimitPerStatus, since: sinceDate },
   461→  );
   462→
   463→  // Combine notes from all statuses, preserving representation from each
   464→  const recentNotes = [...inProgressNotes, ...pendingReviewNotes, ...completedNotes]
   465→    .sort(
   466→      (a, b) =>
   467→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   468→    );
   469→
   470→  // Get incomplete todos from active tasks
   471→  const activeTodos = collectIncompleteTodos(
   472→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   473→    index,
   474→    { limit: options.full ? limit * 2 : limit },
   475→  );
   476→
   477→  // Get ready tasks (optionally filtered to automation-eligible only)
   478→  const readyTasks = getReadyTasks(allTasks)
   479→    .filter((t) => !options.eligible || t.automation === "eligible")
   480→    .slice(0, options.full ? undefined : limit)
   481→    .map((t) => toReadyTaskSummary(t, index));
   482→
   483→  // Get blocked tasks
   484→  const blockedTasks = allTasks
   485→    .filter((t) => t.status === "blocked")
   486→    .slice(0, options.full ? undefined : limit)
   487→    .map((t) => toBlockedTaskSummary(t, allTasks, index));
   488→
   489→  // Get recently completed tasks
   490→  const recentlyCompleted = allTasks
   491→    .filter((t) => {
   492→      if (t.status !== "completed" || !t.completed_at) return false;
   493→      const completedDate = new Date(t.completed_at);
   494→      if (sinceDate && completedDate < sinceDate) return false;
   495→      return true;
   496→    })
   497→    .sort((a, b) => {
   498→      // Sort by completed_at descending (most recent first)
   499→      const aDate = new Date(a.completed_at || 0);
   500→      const bDate = new Date(b.completed_at || 0);
   501→      return bDate.getTime() - aDate.getTime();
   502→    })
   503→    .slice(0, options.full ? undefined : limit)
   504→    .map((t) => toCompletedTaskSummary(t, index));
   505→
   506→  // Get git info
   507→  let branch: string | null = null;
   508→  let recentCommits: CommitSummary[] = [];
   509→  let workingTree: GitWorkingTree | null = null;
   510→
   511→  if (showGit && isGitRepo(ctx.rootDir)) {
   512→    branch = getCurrentBranch(ctx.rootDir);
   513→
   514→    const commits = getRecentCommits({
   515→      limit: options.full ? limit * 2 : limit,
   516→      since: sinceDate || undefined,
   517→      cwd: ctx.rootDir,
   518→    });
   519→
   520→    recentCommits = commits.map((c) => ({
   521→      hash: c.hash,
   522→      full_hash: c.fullHash,
   523→      date: c.date.toISOString(),
   524→      message: c.message,
   525→      author: c.author,
   526→    }));
   527→
   528→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   529→  }
   530→
   531→  // Get inbox items (oldest first to encourage triage)
   532→  const inboxSummaries: InboxSummary[] = inboxItems
   533→    .sort(
   534→      (a, b) =>
   535→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   536→    )
   537→    .slice(0, options.full ? undefined : limit)
   538→    .map((item) => ({
   539→      ref: item._ulid.slice(0, 8),
   540→      text: item.text,
   541→      created_at: item.created_at,
   542→      tags: item.tags,
   543→      added_by: item.added_by || null,
   544→    }));
   545→
   546→  // Load session context (focus, threads, questions)
   547→  const sessionContext = await loadSessionContext(ctx);
   548→
   549→  return {
   550→    generated_at: new Date().toISOString(),
   551→    branch,
   552→    context: sessionContext,
   553→    active_tasks: activeTasks,
   554→    pending_review_tasks: pendingReviewTasks,
   555→    recent_notes: recentNotes,
   556→    active_todos: activeTodos,
   557→    ready_tasks: readyTasks,
   558→    blocked_tasks: blockedTasks,
   559→    recently_completed: recentlyCompleted,
   560→    recent_commits: recentCommits,
   561→    working_tree: workingTree,
   562→    inbox_items: inboxSummaries,
   563→    stats,
   564→  };
   565→}
   566→
   567→// ─── Iteration Stats ─────────────────────────────────────────────────────────
   568→
   569→/**
   570→ * Stats for tasks completed/started within a time window.
   571→ * Used by ralph to track task completions per iteration.
   572→ */
   573→export interface IterationStats {
   574→  /** Number of tasks completed since the given time */
   575→  tasks_completed: number;
   576→  /** Number of tasks started since the given time */
   577→  tasks_started: number;
   578→  /** References of completed tasks */
   579→  completed_refs: string[];
   580→}
   581→
   582→/**
   583→ * Get iteration stats - tasks completed/started since a given time.
   584→ * AC: @ralph-task-limit ac-detection
   585→ */
   586→export async function getIterationStats(
   587→  ctx: KspecContext,
   588→  since: Date,
   589→): Promise<IterationStats> {
   590→  const allTasks = await loadAllTasks(ctx);
   591→
   592→  // Count both completed and pending_review (submitted) tasks toward the limit.
   593→  // Submit means the agent's work is done — it should count the same as complete.
   594→  // AC: @ralph-task-limit ac-detection
   595→  const completedSince = allTasks.filter((t) => {
   596→    if (t.status === "completed" && t.completed_at) {
   597→      return new Date(t.completed_at) >= since;
   598→    }
   599→    if (t.status === "pending_review" && t.submitted_at) {
   600→      return new Date(t.submitted_at) >= since;
   601→    }
   602→    return false;
   603→  });
   604→
   605→  const startedSince = allTasks.filter((t) => {
   606→    if (!t.started_at) return false;
   607→    return new Date(t.started_at) >= since;
   608→  });
   609→
   610→  // Use first slug or ULID prefix as ref
   611→  const getRef = (t: LoadedTask) =>
   612→    t.slugs.length > 0 ? `@${t.slugs[0]}` : `@${t._ulid.slice(0, 8)}`;
   613→
   614→  return {
   615→    tasks_completed: completedSince.length,
   616→    tasks_started: startedSince.length,
   617→    completed_refs: completedSince.map(getRef),
   618→  };
   619→}
   620→
   621→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   622→
   623→export interface CheckpointOptions {
   624→  force?: boolean;
   625→  /** Set when stop hook is already active (retry after previous block) */
   626→  stopHookActive?: boolean;
   627→}
   628→
   629→/** Claude Code hook input for Stop hooks */
   630→export interface StopHookInput {
   631→  session_id?: string;
   632→  transcript_path?: string;
   633→  hook_event_name?: string;
   634→  stop_hook_active?: boolean;
   635→}
   636→
   637→/**
   638→ * Perform session checkpoint - check for uncommitted work before ending session.
   639→ *
   640→ * This is designed for use as a Claude Code stop hook. It checks for:
   641→ * - Uncommitted git changes (staged, unstaged, untracked)
   642→ * - Tasks in in_progress status
   643→ * - Incomplete todos on active tasks
   644→ *
   645→ * Returns a structured result indicating whether the session can end cleanly.
   646→ */
   647→export async function performCheckpoint(
   648→  ctx: KspecContext,
   649→  options: CheckpointOptions,
   650→): Promise<CheckpointResult> {
   651→  const issues: CheckpointIssue[] = [];
   652→  const instructions: string[] = [];
   653→
   654→  // Load tasks
   655→  const allTasks = await loadAllTasks(ctx);
   656→
   657→  // Check for in-progress tasks
   658→  const inProgressTasks = allTasks.filter((t) => t.status === "in_progress");
   659→  for (const task of inProgressTasks) {
   660→    const ref = task.slugs[0]
   661→      ? `@${task.slugs[0]}`
   662→      : `@${task._ulid.slice(0, 8)}`;
   663→    issues.push({
   664→      type: "in_progress_task",
   665→      description: `Task ${ref} is still in progress: ${task.title}`,
   666→      details: {
   667→        ref,
   668→        title: task.title,
   669→        started_at: task.started_at,
   670→      },
   671→    });
   672→
   673→    // Check for incomplete todos on this task
   674→    const incompleteTodos = task.todos.filter((t) => !t.done);
   675→    for (const todo of incompleteTodos) {
   676→      issues.push({
   677→        type: "incomplete_todo",
   678→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   679→        details: {
   680→          task_ref: ref,
   681→          todo_id: todo.id,
   682→          text: todo.text,
   683→        },
   684→      });
   685→    }
   686→  }
   687→
   688→  // Check for uncommitted git changes
   689→  if (isGitRepo(ctx.rootDir)) {
   690→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   691→    if (!workingTree.clean) {
   692→      const changeCount =
   693→        workingTree.staged.length +
   694→        workingTree.unstaged.length +
   695→        workingTree.untracked.length;
   696→
   697→      issues.push({
   698→        type: "uncommitted_changes",
   699→        description: `${changeCount} uncommitted changes in working tree`,
   700→        details: {
   701→          staged: workingTree.staged.length,
   702→          unstaged: workingTree.unstaged.length,
   703→          untracked: workingTree.untracked.length,
   704→        },
   705→      });
   706→    }
   707→  }
   708→
   709→  // Build instructions based on issues
   710→  if (issues.length > 0 && !options.force) {
   711→    instructions.push(
   712→      "If you've been instructed to ignore this message or are working on",
   713→    );
   714→    instructions.push(
   715→      "unrelated things to any in progress tasks then disregard this message,",
   716→    );
   717→    instructions.push("otherwise before ending this session, please:");
   718→
   719→    const hasInProgress = issues.some((i) => i.type === "in_progress_task");
   720→    const hasUncommitted = issues.some((i) => i.type === "uncommitted_changes");
   721→    const hasIncompleteTodos = issues.some((i) => i.type === "incomplete_todo");
   722→
   723→    let step = 1;
   724→
   725→    if (hasInProgress) {
   726→      instructions.push(
   727→        `${step++}. Read in-progress task notes to get full context of the current task status`,
   728→      );
   729→      instructions.push(
   730→        `${step++}. Add notes documenting current state if any context is missing from this session`,
   731→      );
   732→      instructions.push(
   733→        `${step++}. Complete the task if you've completed the objectives and no AC are left uncovered\notherwise leave it in progress for a future session`,
   734→      );
   735→    }
   736→
   737→    if (hasIncompleteTodos) {
   738→      instructions.push(
   739→        `${step++}. Complete or acknowledge incomplete todos on active tasks`,
   740→      );
   741→    }
   742→
   743→    if (hasUncommitted) {
   744→      instructions.push(
   745→        `${step++}. Commit your changes with a descriptive message`,
   746→      );
   747→
   748→      // Add WIP commit guidance if there are in-progress tasks
   749→      if (inProgressTasks.length > 0) {
   750→        const task = inProgressTasks[0];
   751→        const guidance = formatCommitGuidance(task, { wip: true });
   752→        instructions.push("");
   753→        instructions.push("Suggested WIP commit:");
   754→        instructions.push(`  ${guidance.message}`);
   755→        instructions.push("");
   756→        for (const trailer of guidance.trailers) {
   757→          instructions.push(`  ${trailer}`);
   758→        }
   759→      }
   760→    }
   761→
   762→    instructions.push("");
   763→    instructions.push("Use: kspec task @task to get current task state");
   764→    instructions.push(
   765→      'Use: kspec task note @task "Progress notes..." to document state',
   766→    );
   767→    instructions.push(
   768→      'Use: kspec task complete @task --reason "Summary" if task is done',
   769→    );
   770→  }
   771→
   772→  // Allow stop if:
   773→  // - No issues found
   774→  // - --force flag passed
   775→  // - This is a retry (stop_hook_active = true from previous block)
   776→  const isRetry = options.stopHookActive === true;
   777→  const ok = issues.length === 0 || options.force === true || isRetry;
   778→
   779→  let message: string;
   780→  if (isRetry && issues.length > 0) {
   781→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   782→  } else if (ok) {
   783→    message = "[kspec] Session checkpoint passed - ready to end session";
   784→  } else {
   785→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   786→  }
   787→
   788→  return {
   789→    ok,
   790→    message,
   791→    issues,
   792→    instructions,
   793→  };
   794→}
   795→
   796→// ─── Output Formatting ───────────────────────────────────────────────────────
   797→
   798→function formatCheckpointResult(result: CheckpointResult): void {
   799→  if (result.ok) {
   800→    console.log(chalk.green(result.message));
   801→  } else {
   802→    console.log(chalk.yellow(result.message));
   803→    console.log("");
   804→
   805→    for (const issue of result.issues) {
   806→      const icon =
   807→        issue.type === "uncommitted_changes"
   808→          ? chalk.yellow("⚠")
   809→          : issue.type === "in_progress_task"
   810→            ? chalk.blue("●")
   811→            : chalk.gray("○");
   812→      console.log(`  ${icon} ${issue.description}`);
   813→    }
   814→
   815→    if (result.instructions.length > 0) {
   816→      console.log("");
   817→      for (const instruction of result.instructions) {
   818→        console.log(chalk.gray(instruction));
   819→      }
   820→    }
   821→  }
   822→}
   823→
   824→function formatSessionContext(
   825→  ctx: SessionContext,
   826→  options: SessionOptions,
   827→): void {
   828→  const isBrief = !options.full;
   829→
   830→  // Header
   831→  console.log(`\n${sessionHeaders.title}`);
   832→  const age = formatRelativeTime(new Date(ctx.generated_at));
   833→  if (ctx.branch) {
   834→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   835→  } else {
   836→    console.log(chalk.gray(`Generated: ${age}`));
   837→  }
   838→
   839→  // Stats summary
   840→  const pendingReviewNote =
   841→    ctx.stats.pending_review > 0
   842→      ? `${ctx.stats.pending_review} awaiting review, `
   843→      : "";
   844→  const inboxNote =
   845→    ctx.stats.inbox_items > 0 ? ` | Inbox: ${ctx.stats.inbox_items}` : "";
   846→  console.log(
   847→    chalk.gray(
   848→      `Tasks: ${ctx.stats.in_progress} active, ${pendingReviewNote}${ctx.stats.ready} ready, ` +
   849→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`,
   850→    ),
   851→  );
   852→
   853→  // Session context section (focus, threads, questions)
   854→  if (
   855→    ctx.context &&
   856→    (ctx.context.focus ||
   857→      ctx.context.threads.length > 0 ||
   858→      ctx.context.open_questions.length > 0)
   859→  ) {
   860→    console.log("\n--- Session Context ---");
   861→
   862→    if (ctx.context.focus) {
   863→      console.log(`  ${chalk.cyan("Focus:")} ${ctx.context.focus}`);
   864→    }
   865→
   866→    if (ctx.context.threads.length > 0) {
   867→      console.log(`  ${chalk.cyan("Active Threads:")}`);
   868→      for (const thread of ctx.context.threads) {
   869→        console.log(`    - ${thread}`);
   870→      }
   871→    }
   872→
   873→    if (ctx.context.open_questions.length > 0) {
   874→      console.log(`  ${chalk.cyan("Open Questions:")}`);
   875→      for (const question of ctx.context.open_questions) {
   876→        console.log(`    - ${question}`);
   877→      }
   878→    }
   879→  }
   880→
   881→  // Active tasks section
   882→  if (ctx.active_tasks.length > 0) {
   883→    console.log(`\n${sessionHeaders.activeWork}`);
   884→    for (const task of ctx.active_tasks) {
   885→      const started = task.started_at
   886→        ? chalk.gray(
   887→            ` (started ${formatRelativeTime(new Date(task.started_at))})`,
   888→          )
   889→        : "";
   890→      const priority =
   891→        task.priority <= 2
   892→          ? chalk.red(`P${task.priority}`)
   893→          : chalk.gray(`P${task.priority}`);
   894→      console.log(
   895→        `  ${chalk.blue("[in_progress]")} ${priority} ${task.ref} ${task.title}${started}`,
   896→      );
   897→    }
   898→  } else {
   899→    console.log(`\n${sessionHeaders.noActiveWork}`);
   900→  }
   901→
   902→  // Awaiting review section
   903→  if (ctx.pending_review_tasks.length > 0) {
   904→    console.log(`\n${sessionHeaders.awaitingReview}`);
   905→    for (const task of ctx.pending_review_tasks) {
   906→      const priority =
   907→        task.priority <= 2
   908→          ? chalk.red(`P${task.priority}`)
   909→          : chalk.gray(`P${task.priority}`);
   910→      console.log(
   911→        `  ${chalk.yellow("[pending_review]")} ${priority} ${task.ref} ${task.title}`,
   912→      );
   913→    }
   914→  }
   915→
   916→  // Recently completed section
   917→  if (ctx.recently_completed.length > 0) {
   918→    console.log(`\n${sessionHeaders.recentlyCompleted}`);
   919→    const observationPromotedTasks: string[] = [];
   920→    for (const task of ctx.recently_completed) {
   921→      const completedAge = formatRelativeTime(new Date(task.completed_at));
   922→      let reason = "";
   923→      if (task.closed_reason) {
   924→        const maxLen = isBrief ? 60 : 120;
   925→        const truncated =
   926→          task.closed_reason.length > maxLen
   927→            ? `${task.closed_reason.slice(0, maxLen).trim()}...`
   928→            : task.closed_reason;
   929→        reason = chalk.gray(` - ${truncated}`);
   930→      }
   931→      console.log(
   932→        `  ${chalk.green("[completed]")} ${task.ref} ${task.title} ${chalk.gray(`(${completedAge})`)}${reason}`,
   933→      );
   934→
   935→      // Track tasks that came from observations
   936→      if (task.origin === "observation_promotion") {
   937→        observationPromotedTasks.push(task.ref);
   938→      }
   939→    }
   940→
   941→    // Show reminder about resolving observations
   942→    if (observationPromotedTasks.length > 0) {
   943→      console.log(
   944→        chalk.yellow(
   945→          `\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(", ")}`,
   946→        ),
   947→      );
   948→      console.log(
   949→        chalk.gray(`    Run: kspec meta observations --pending-resolution`),
   950→      );
   951→    }
   952→  }
   953→
   954→  // Recent notes section - grouped by task status
   955→  // AC: @cmd-session-start ac-1, ac-2
   956→  if (ctx.recent_notes.length > 0) {
   957→    console.log(`\n${sessionHeaders.recentNotes}`);
   958→
   959→    // Group notes by task status
   960→    const inProgressNotes = ctx.recent_notes.filter(
   961→      (n) => n.task_status === "in_progress",
   962→    );
   963→    const pendingReviewNotes = ctx.recent_notes.filter(
   964→      (n) => n.task_status === "pending_review",
   965→    );
   966→    const completedNotes = ctx.recent_notes.filter(
   967→      (n) => n.task_status === "completed",
   968→    );
   969→
   970→    // Helper to format a single note
   971→    const formatNote = (note: NoteSummary) => {
   972→      const age = formatRelativeTime(new Date(note.created_at));
   973→      const author = note.author ? chalk.gray(` by ${note.author}`) : "";
   974→      console.log(`    ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
   975→
   976→      // Truncate content in brief mode
   977→      let content = note.content.trim();
   978→      if (isBrief && content.length > 200) {
   979→        content = `${content.slice(0, 200).trim()}...`;
   980→      }
   981→
   982→      // Indent content, limit lines in brief mode
   983→      const lines = content.split("\n");
   984→      const maxLines = isBrief ? 3 : lines.length;
   985→      for (const line of lines.slice(0, maxLines)) {
   986→        console.log(`      ${chalk.white(line)}`);
   987→      }
   988→      if (isBrief && lines.length > maxLines) {
   989→        console.log(
   990→          chalk.gray(`      ... (${lines.length - maxLines} more lines)`),
   991→        );
   992→      }
   993→    };
   994→
   995→    // AC: @cmd-session-start ac-1 - In Progress notes
   996→    if (inProgressNotes.length > 0) {
   997→      console.log(`  ${chalk.blue("In Progress:")}`);
   998→      for (const note of inProgressNotes) {
   999→        formatNote(note);
  1000→      }
  1001→    }
  1002→
  1003→    // AC: @cmd-session-start ac-1 - Pending Review notes (grouped separately)
  1004→    if (pendingReviewNotes.length > 0) {
  1005→      console.log(`  ${chalk.yellow("Pending Review:")}`);
  1006→      for (const note of pendingReviewNotes) {
  1007→        formatNote(note);
  1008→      }
  1009→    }
  1010→
  1011→    // AC: @cmd-session-start ac-2 - Recently Completed notes
  1012→    if (completedNotes.length > 0) {
  1013→      console.log(`  ${chalk.green("Recently Completed:")}`);
  1014→      for (const note of completedNotes) {
  1015→        formatNote(note);
  1016→      }
  1017→    }
  1018→  }
  1019→
  1020→  // Incomplete todos section
  1021→  if (ctx.active_todos.length > 0) {
  1022→    console.log(`\n${sessionHeaders.incompleteTodos}`);
  1023→    for (const todo of ctx.active_todos) {
  1024→      console.log(
  1025→        `  ${chalk.yellow("[ ]")} ${todo.task_ref}#${todo.id}: ${todo.text}`,
  1026→      );
  1027→    }
  1028→  }
  1029→
  1030→  // Ready tasks section
  1031→  if (ctx.ready_tasks.length > 0) {
  1032→    console.log(`\n${sessionHeaders.readyTasks}`);
  1033→    for (const task of ctx.ready_tasks) {
  1034→      const priority =
  1035→        task.priority <= 2
  1036→          ? chalk.red(`P${task.priority}`)
  1037→          : chalk.gray(`P${task.priority}`);
  1038→      const tags =
  1039→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(" #")}`) : "";
  1040→      console.log(`  ${priority} ${task.ref} ${task.title}${tags}`);
  1041→    }
  1042→  }
  1043→
  1044→  // Blocked tasks section
  1045→  if (ctx.blocked_tasks.length > 0) {
  1046→    console.log(`\n${sessionHeaders.blocked}`);
  1047→    for (const task of ctx.blocked_tasks) {
  1048→      console.log(`  ${chalk.red("[blocked]")} ${task.ref} ${task.title}`);
  1049→      if (task.blocked_by.length > 0) {
  1050→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(", ")}`));
  1051→      }
  1052→      if (task.unmet_deps.length > 0) {
  1053→        console.log(
  1054→          chalk.gray(`    Waiting on: ${task.unmet_deps.join(", ")}`),
  1055→        );
  1056→      }
  1057→    }
  1058→  }
  1059→
  1060→  // Git commits section
  1061→  if (ctx.recent_commits.length > 0) {
  1062→    console.log(`\n${sessionHeaders.recentCommits}`);
  1063→    for (const commit of ctx.recent_commits) {
  1064→      const age = formatRelativeTime(new Date(commit.date));
  1065→      console.log(
  1066→        `  ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${age}, ${commit.author})`)}`,
  1067→      );
  1068→    }
  1069→  }
  1070→
  1071→  // Inbox section (oldest first to encourage triage)
  1072→  if (ctx.inbox_items.length > 0) {
  1073→    console.log(`\n${sessionHeaders.inbox}`);
  1074→    for (const item of ctx.inbox_items) {
  1075→      const age = formatRelativeTime(new Date(item.created_at));
  1076→      const author = item.added_by ? ` by ${item.added_by}` : "";
  1077→      const tags =
  1078→        item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(", ")}]`) : "";
  1079→      // Truncate text in brief mode
  1080→      let text = item.text;
  1081→      if (isBrief && text.length > 60) {
  1082→        text = `${text.slice(0, 60).trim()}...`;
  1083→      }
  1084→      console.log(
  1085→        `  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`,
  1086→      );
  1087→      console.log(`    ${text}`);
  1088→    }
  1089→    console.log(`  ${hints.inboxPromote}`);
  1090→  }
  1091→
  1092→  // Working tree section
  1093→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1094→    console.log(`\n${sessionHeaders.workingTree}`);
  1095→
  1096→    if (ctx.working_tree.staged.length > 0) {
  1097→      console.log(chalk.green("  Staged:"));
  1098→      for (const file of ctx.working_tree.staged) {
  1099→        console.log(
  1100→          `    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`,
  1101→        );
  1102→      }
  1103→    }
  1104→
  1105→    if (ctx.working_tree.unstaged.length > 0) {
  1106→      console.log(chalk.red("  Modified:"));
  1107→      for (const file of ctx.working_tree.unstaged) {
  1108→        console.log(
  1109→          `    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`,
  1110→        );
  1111→      }
  1112→    }
  1113→
  1114→    if (ctx.working_tree.untracked.length > 0) {
  1115→      console.log(chalk.gray("  Untracked:"));
  1116→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
  1117→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
  1118→        console.log(`    ${chalk.gray("?")} ${path}`);
  1119→      }
  1120→      if (isBrief && ctx.working_tree.untracked.length > limit) {
  1121→        console.log(
  1122→          chalk.gray(
  1123→            `    ... and ${ctx.working_tree.untracked.length - limit} more`,
  1124→          ),
  1125→        );
  1126→      }
  1127→    }
  1128→  } else if (ctx.working_tree?.clean) {
  1129→    console.log(`\n${sessionHeaders.workingTreeClean}`);
  1130→  }
  1131→
  1132→  // Quick Commands section - contextual hints based on state
  1133→  const quickCommands: string[] = [];
  1134→
  1135→  if (ctx.active_tasks.length > 0) {
  1136→    const ref = ctx.active_tasks[0].ref;
  1137→    quickCommands.push(
  1138→      `kspec task note @${ref} "Progress..."  ${chalk.gray("# document work")}`,
  1139→    );
  1140→    quickCommands.push(
  1141→      `kspec task complete @${ref} --reason "..."  ${chalk.gray("# finish task")}`,
  1142→    );
  1143→  } else if (ctx.ready_tasks.length > 0) {
  1144→    const ref = ctx.ready_tasks[0].ref;
  1145→    quickCommands.push(
  1146→      `kspec task start @${ref}  ${chalk.gray("# begin work")}`,
  1147→    );
  1148→  }
  1149→
  1150→  if (ctx.inbox_items.length > 0) {
  1151→    const ref = ctx.inbox_items[0].ref;
  1152→    quickCommands.push(
  1153→      `kspec inbox promote @${ref} --title "..."  ${chalk.gray("# convert to task")}`,
  1154→    );
  1155→  }
  1156→
  1157→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1158→    quickCommands.push(
  1159→      `git add . && git commit -m "..."  ${chalk.gray("# commit changes")}`,
  1160→    );
  1161→  }
  1162→
  1163→  if (quickCommands.length > 0) {
  1164→    console.log(`\n${sessionHeaders.quickCommands}`);
  1165→    for (const hint of quickCommands) {
  1166→      console.log(`  ${hint}`);
  1167→    }
  1168→  }
  1169→
  1170→  console.log(""); // Final newline
  1171→}
  1172→
  1173→// ─── Command Registration ────────────────────────────────────────────────────
  1174→
  1175→async function sessionStartAction(options: SessionOptions): Promise<void> {
  1176→  try {
  1177→    const ctx = await initContext();
  1178→
  1179→    // AC: @shadow-sync ac-2 - Pull remote changes before showing session context
  1180→    let syncResult: ShadowSyncResult | null = null;
  1181→    if (ctx.shadow?.enabled) {
  1182→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
  1183→      // AC: @shadow-sync ac-3 - Warn about conflicts but continue with local state
  1184→      if (syncResult.hadConflict) {
  1185→        warn("Shadow sync conflict detected. Run `kspec shadow resolve` to fix.");
  1186→        info("Continuing with local state...");
  1187→      } else if (syncResult.pulled) {
  1188→        info("Synced shadow branch from remote");
  1189→      }
  1190→    }
  1191→
  1192→    const sessionCtx = await gatherSessionContext(ctx, options);
  1193→
  1194→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
  1195→  } catch (err) {
  1196→    error(errors.failures.gatherSessionContext, err);
  1197→    process.exit(EXIT_CODES.ERROR);
  1198→  }
  1199→}
  1200→
  1201→/**
  1202→ * Read stdin if available (non-blocking check for hook input)
  1203→ */
  1204→async function readStdinIfAvailable(): Promise<string | null> {
  1205→  // Check if stdin is a TTY (interactive) - if so, don't try to read
  1206→  if (process.stdin.isTTY) {
  1207→    return null;
  1208→  }
  1209→
  1210→  return new Promise((resolve) => {
  1211→    let data = "";
  1212→    const timeout = setTimeout(() => {
  1213→      process.stdin.removeAllListeners();
  1214→      resolve(data || null);
  1215→    }, 100); // 100ms timeout for stdin
  1216→
  1217→    process.stdin.setEncoding("utf8");
  1218→    process.stdin.on("data", (chunk) => {
  1219→      data += chunk;
  1220→    });
  1221→    process.stdin.on("end", () => {
  1222→      clearTimeout(timeout);
  1223→      resolve(data || null);
  1224→    });
  1225→    process.stdin.on("error", () => {
  1226→      clearTimeout(timeout);
  1227→      resolve(null);
  1228→    });
  1229→    process.stdin.resume();
  1230→  });
  1231→}
  1232→
  1233→/**
  1234→ * Parse Claude Code hook input from stdin
  1235→ */
  1236→function parseHookInput(stdin: string | null): StopHookInput | null {
  1237→  if (!stdin) return null;
  1238→  try {
  1239→    return JSON.parse(stdin.trim()) as StopHookInput;
  1240→  } catch {
  1241→    return null;
  1242→  }
  1243→}
  1244→
  1245→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
  1246→
  1247→/**
  1248→ * Output spec-first reminder for UserPromptSubmit hook.
  1249→ *
  1250→ * This is a simple context injection - always outputs the reminder,
  1251→ * and Claude (Opus) is smart enough to apply it when relevant.
  1252→ */
  1253→async function sessionPromptCheckAction(): Promise<void> {
  1254→  // Lean, instructive reminder with kspec prefix
  1255→  console.log(sessionPrompt.specCheck);
  1256→}
  1257→
  1258→async function sessionCheckpointAction(
  1259→  options: CheckpointOptions,
  1260→): Promise<void> {
  1261→  try {
  1262→    // Read stdin for Claude Code hook input
  1263→    const stdin = await readStdinIfAvailable();
  1264→    const hookInput = parseHookInput(stdin);
  1265→
  1266→    // Check if this is a retry (stop hook already active)
  1267→    if (hookInput?.stop_hook_active) {
  1268→      options.stopHookActive = true;
  1269→    }
  1270→
  1271→    const ctx = await initContext();
  1272→    const result = await performCheckpoint(ctx, options);
  1273→
  1274→    // Output format depends on mode:
  1275→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
  1276→    // - Human mode: Output formatted checkpoint result
  1277→    if (isJsonMode()) {
  1278→      if (!result.ok) {
  1279→        // Build reason message with issues and instructions
  1280→        const issueLines = result.issues
  1281→          .map((i) => `- ${i.description}`)
  1282→          .join("\n");
  1283→        const instructionLines = result.instructions
  1284→          .filter((i) => i.trim())
  1285→          .join("\n");
  1286→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
  1287→        console.log(JSON.stringify({ decision: "block", reason }));
  1288→      }
  1289→      // If ok, exit silently (Claude Code expects no output when allowing stop)
  1290→    } else {
  1291→      formatCheckpointResult(result);
  1292→      if (!result.ok) {
  1293→        process.exit(EXIT_CODES.ERROR);
  1294→      }
  1295→    }
  1296→  } catch (err) {
  1297→    // Handle RUNNING_FROM_SHADOW gracefully - skip with warning instead of erroring
  1298→    // This happens when the stop hook runs while cwd is inside .kspec/ directory
  1299→    if (err instanceof ShadowError && err.code === "RUNNING_FROM_SHADOW") {
  1300→      if (!isJsonMode()) {
  1301→        console.log(
  1302→          chalk.yellow(
  1303→            "[kspec] Session checkpoint skipped - running from inside .kspec/ directory",
  1304→          ),
  1305→        );
  1306→      }
  1307→      // Allow stop to proceed (exit successfully, no JSON output blocks the stop)
  1308→      return;
  1309→    }
  1310→    error(errors.failures.runCheckpoint, err);
  1311→    process.exit(EXIT_CODES.ERROR);
  1312→  }
  1313→}
  1314→
  1315→// ─── Session Log List ─────────────────────────────────────────────────────────
  1316→
  1317→interface SessionLogListOptions {
  1318→  status?: string;
  1319→  agent?: string;
  1320→  since?: string;
  1321→  sort?: string;
  1322→  count?: boolean;
  1323→  limit?: string;
  1324→}
  1325→
  1326→type SortField =
  1327→  | "started_at"
  1328→  | "duration"
  1329→  | "events"
  1330→  | "iterations"
  1331→  | "tasks_completed";
  1332→
  1333→const VALID_SORT_FIELDS: SortField[] = [
  1334→  "started_at",
  1335→  "duration",
  1336→  "events",
  1337→  "iterations",
  1338→  "tasks_completed",
  1339→];
  1340→
  1341→/**
  1342→ * Format a duration in milliseconds to a human-readable string.
  1343→ */
  1344→function formatDuration(ms: number): string {
  1345→  if (ms < 0) return "—";
  1346→  const totalSec = Math.floor(ms / 1000);
  1347→  const hours = Math.floor(totalSec / 3600);
  1348→  const minutes = Math.floor((totalSec % 3600) / 60);
  1349→  if (hours > 0) {
  1350→    return `${hours}h ${minutes}m`;
  1351→  }
  1352→  if (minutes > 0) {
  1353→    return `${minutes}m`;
  1354→  }
  1355→  return `${totalSec}s`;
  1356→}
  1357→
  1358→/**
  1359→ * Sort session summaries by the specified field.
  1360→ * Default: started_at descending.
  1361→ *
  1362→ * AC: @session-log-list ac-5
  1363→ */
  1364→function sortSessions(
  1365→  sessions: SessionLogSummary[],
  1366→  sortField: SortField,
  1367→): SessionLogSummary[] {
  1368→  return [...sessions].sort((a, b) => {
  1369→    switch (sortField) {
  1370→      case "started_at":
  1371→        return (
  1372→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1373→        );
  1374→      case "duration":
  1375→        return b.duration_ms - a.duration_ms;
  1376→      case "events":
  1377→        return b.event_count - a.event_count;
  1378→      case "iterations":
  1379→        return b.iteration_count - a.iteration_count;
  1380→      case "tasks_completed":
  1381→        return b.tasks_completed - a.tasks_completed;
  1382→      default:
  1383→        return (
  1384→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1385→        );
  1386→    }
  1387→  });
  1388→}
  1389→
  1390→/**
  1391→ * Format the session log list as a table.
  1392→ *
  1393→ * AC: @session-log-list ac-1
  1394→ */
  1395→function formatSessionLogList(sessions: SessionLogSummary[]): void {
  1396→  if (sessions.length === 0) {
  1397→    // AC: @session-log-list ac-6
  1398→    console.log("No sessions found.");
  1399→    return;
  1400→  }
  1401→
  1402→  // Table header
  1403→  console.log(
  1404→    chalk.gray(
  1405→      `${"ID".padEnd(10)} ${"Status".padEnd(11)} ${"Agent".padEnd(20)} ${"Started".padEnd(16)} ${"Duration".padEnd(10)} ${"Events".padEnd(8)} ${"Iters".padEnd(7)} Tasks`,
  1406→    ),
  1407→  );
  1408→  console.log(chalk.gray("─".repeat(95)));
  1409→
  1410→  for (const s of sessions) {
  1411→    const id = s.id.slice(0, 8);
  1412→    const statusColor =
  1413→      s.status === "completed"
  1414→        ? chalk.green
  1415→        : s.status === "active"
  1416→          ? chalk.blue
  1417→          : chalk.yellow;
  1418→    const status = statusColor(s.status.padEnd(11));
  1419→    const agent = s.agent_type.slice(0, 20).padEnd(20);
  1420→    const started = formatRelativeTime(new Date(s.started_at)).padEnd(16);
  1421→    const duration = formatDuration(s.duration_ms).padEnd(10);
  1422→    const events = String(s.event_count).padEnd(8);
  1423→    const iters = String(s.iteration_count).padEnd(7);
  1424→    const tasks = String(s.tasks_completed);
  1425→
  1426→    console.log(
  1427→      `${chalk.yellow(id)} ${status} ${chalk.gray(agent)} ${chalk.gray(started)} ${duration} ${events} ${iters} ${tasks}`,
  1428→    );
  1429→  }
  1430→
  1431→  console.log(chalk.gray(`\n${sessions.length} session(s)`));
  1432→}
  1433→
  1434→/**
  1435→ * Session log list action handler.
  1436→ */
  1437→async function sessionLogListAction(
  1438→  options: SessionLogListOptions,
  1439→): Promise<void> {
  1440→  try {
  1441→    const ctx = await initContext();
  1442→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1443→
  1444→    // AC: @session-log-list ac-2 - Filter by status
  1445→    if (options.status) {
  1446→      const statusFilter = options.status as SessionStatus;
  1447→      sessions = sessions.filter((s) => s.status === statusFilter);
  1448→    }
  1449→
  1450→    // AC: @session-log-list ac-4 - Filter by agent type
  1451→    if (options.agent) {
  1452→      const agentFilter = options.agent;
  1453→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1454→    }
  1455→
  1456→    // AC: @session-log-list ac-3 - Filter by since date
  1457→    if (options.since) {
  1458→      const sinceDate = parseTimeSpec(options.since);
  1459→      if (sinceDate) {
  1460→        sessions = sessions.filter(
  1461→          (s) => new Date(s.started_at) >= sinceDate,
  1462→        );
  1463→      }
  1464→    }
  1465→
  1466→    // AC: @session-log-list ac-5 - Sort
  1467→    const sortField: SortField =
  1468→      options.sort && VALID_SORT_FIELDS.includes(options.sort as SortField)
  1469→        ? (options.sort as SortField)
  1470→        : "started_at";
  1471→    sessions = sortSessions(sessions, sortField);
  1472→
  1473→    // AC: @session-log-list ac-7 - Limit output count
  1474→    if (options.count) {
  1475→      // AC: @trait-filterable-list ac-8
  1476→      output({ count: sessions.length }, () => {
  1477→        console.log(sessions.length);
  1478→      });
  1479→      return;
  1480→    }
  1481→
  1482→    // Apply --limit (after filtering/sorting, before display)
  1483→    if (options.limit) {
  1484→      const limit = parseInt(options.limit, 10);
  1485→      if (!Number.isNaN(limit) && limit > 0) {
  1486→        sessions = sessions.slice(0, limit);
  1487→      }
  1488→    }
  1489→
  1490→    output(sessions, () => formatSessionLogList(sessions));
  1491→  } catch (err) {
  1492→    error("Failed to list session logs", err);
  1493→    process.exit(EXIT_CODES.ERROR);
  1494→  }
  1495→}
  1496→
  1497→// ─── Session Log Show ─────────────────────────────────────────────────────────
  1498→
  1499→interface SessionLogShowOptions {
  1500→  events?: boolean;
  1501→  type?: string;
  1502→  limit?: string;
  1503→  context?: string;
  1504→}
  1505→
  1506→/**
  1507→ * Format an event timestamp as relative time from session start.
  1508→ */
  1509→function formatEventTimestamp(
  1510→  eventTs: number,
  1511→  sessionStartTs: number,
  1512→): string {
  1513→  const relativeMs = eventTs - sessionStartTs;
  1514→  const totalSec = Math.floor(relativeMs / 1000);
  1515→  const minutes = Math.floor(totalSec / 60);
  1516→  const seconds = totalSec % 60;
  1517→  if (minutes > 0) {
  1518→    return `+${minutes}m${seconds}s`;
  1519→  }
  1520→  return `+${seconds}s`;
  1521→}
  1522→
  1523→/**
  1524→ * Summarize event data for display.
  1525→ * Returns a short string describing the event payload.
  1526→ */
  1527→function summarizeEventData(event: SessionEvent): string {
  1528→  const data = event.data as Record<string, unknown> | null;
  1529→  if (!data) return "";
  1530→
  1531→  // Handle tool_call events
  1532→  if (event.type === "session.update") {
  1533→    const update = data.update as {
  1534→      sessionUpdate?: string;
  1535→      rawInput?: { command?: string };
  1536→      _meta?: { claudeCode?: { toolName?: string } };
  1537→    } | null;
  1538→    if (update?.sessionUpdate === "tool_call") {
  1539→      const toolName = update._meta?.claudeCode?.toolName || "unknown";
  1540→      const command = update.rawInput?.command;
  1541→      if (command) {
  1542→        const truncated =
  1543→          command.length > 60 ? command.slice(0, 57) + "..." : command;
  1544→        return `${toolName}: ${truncated}`;
  1545→      }
  1546→      return toolName;
  1547→    }
  1548→  }
  1549→
  1550→  // Handle prompt.sent events
  1551→  if (event.type === "prompt.sent") {
  1552→    const prompt = data.prompt as string | null;
  1553→    if (prompt) {
  1554→      const truncated =
  1555→        prompt.length > 60 ? prompt.slice(0, 57) + "..." : prompt;
  1556→      return truncated;
  1557→    }
  1558→  }
  1559→
  1560→  // Handle session.start/end
  1561→  if (event.type === "session.start") {
  1562→    return "Session started";
  1563→  }
  1564→  if (event.type === "session.end") {
  1565→    const reason = data.reason as string | null;
  1566→    return reason ? `Session ended: ${reason}` : "Session ended";
  1567→  }
  1568→
  1569→  // Default: show first key
  1570→  const keys = Object.keys(data);
  1571→  if (keys.length > 0) {
  1572→    return `{${keys.slice(0, 3).join(", ")}${keys.length > 3 ? ", ..." : ""}}`;
  1573→  }
  1574→  return "";
  1575→}
  1576→
  1577→/**
  1578→ * Format the session log show output.
  1579→ *
  1580→ * AC: @session-log-show ac-1
  1581→ */
  1582→function formatSessionLogShow(
  1583→  detail: SessionLogDetail,
  1584→  events: SessionEvent[] | null,
  1585→  contextSnapshot: unknown | null,
  1586→  sessionStartTs: number,
  1587→): void {
  1588→  // AC: @session-log-show ac-1 - Session metadata
  1589→  console.log(chalk.bold(`Session ${detail.id.slice(0, 8)}`));
  1590→  console.log(chalk.gray("─".repeat(60)));
  1591→  console.log(`  ID:        ${detail.id}`);
  1592→
  1593→  const statusColor =
  1594→    detail.status === "completed"
  1595→      ? chalk.green
  1596→      : detail.status === "active"
  1597→        ? chalk.blue
  1598→        : chalk.yellow;
  1599→  console.log(`  Status:    ${statusColor(detail.status)}`);
  1600→  console.log(`  Agent:     ${detail.agent_type}`);
  1601→  if (detail.task_id) {
  1602→    console.log(`  Task:      ${detail.task_id}`);
  1603→  }
  1604→  console.log(`  Started:   ${detail.started_at}`);
  1605→  if (detail.ended_at) {
  1606→    console.log(`  Ended:     ${detail.ended_at}`);
  1607→  }
  1608→  console.log(`  Duration:  ${formatDuration(detail.duration_ms)}`);
  1609→  console.log(`  Events:    ${detail.event_count}`);
  1610→  console.log(`  Iterations: ${detail.iteration_count}`);
  1611→
  1612→  // AC: @session-log-show ac-2 - Per-iteration summary
  1613→  if (detail.iterations.length > 0) {
  1614→    console.log("\n" + chalk.bold("Iterations"));
  1615→    console.log(chalk.gray("─".repeat(60)));
  1616→    for (const iter of detail.iterations) {
  1617→      const taskInfo: string[] = [];
  1618→      if (iter.tasks_started.length > 0) {
  1619→        taskInfo.push(`started: ${iter.tasks_started.join(", ")}`);
  1620→      }
  1621→      if (iter.tasks_completed.length > 0) {
  1622→        taskInfo.push(`completed: ${iter.tasks_completed.join(", ")}`);
  1623→      }
  1624→      const taskStr = taskInfo.length > 0 ? ` | ${taskInfo.join(" | ")}` : "";
  1625→      console.log(
  1626→        `  ${chalk.cyan(`[${iter.iteration}]`)} ${iter.event_count} events${taskStr}`,
  1627→      );
  1628→    }
  1629→  }
  1630→
  1631→  // AC: @session-log-show ac-3 - Event timeline
  1632→  if (events !== null) {
  1633→    console.log("\n" + chalk.bold("Events"));
  1634→    console.log(chalk.gray("─".repeat(60)));
  1635→    if (events.length === 0) {
  1636→      console.log(chalk.gray("  No events to display."));
  1637→    } else {
  1638→      for (const event of events) {
  1639→        const timestamp = formatEventTimestamp(event.ts, sessionStartTs);
  1640→        const summary = summarizeEventData(event);
  1641→        const typeColor =
  1642→          event.type === "session.start" || event.type === "session.end"
  1643→            ? chalk.green
  1644→            : event.type === "session.update"
  1645→              ? chalk.blue
  1646→              : chalk.gray;
  1647→        console.log(
  1648→          `  ${chalk.yellow(timestamp.padEnd(10))} ${typeColor(event.type.padEnd(16))} ${chalk.gray(summary)}`,
  1649→        );
  1650→      }
  1651→    }
  1652→  }
  1653→
  1654→  // AC: @session-log-show ac-6 - Context snapshot
  1655→  if (contextSnapshot !== null) {
  1656→    console.log("\n" + chalk.bold("Context Snapshot"));
  1657→    console.log(chalk.gray("─".repeat(60)));
  1658→    console.log(JSON.stringify(contextSnapshot, null, 2));
  1659→  }
  1660→}
  1661→
  1662→/**
  1663→ * Session log show action handler.
  1664→ */
  1665→async function sessionLogShowAction(
  1666→  sessionRef: string,
  1667→  options: SessionLogShowOptions,
  1668→): Promise<void> {
  1669→  try {
  1670→    const ctx = await initContext();
  1671→
  1672→    // AC: @session-log-show ac-7, ac-8, ac-9 - Resolve session ID
  1673→    const resolution = await resolveSessionId(ctx.specDir, sessionRef);
  1674→
  1675→    if (!resolution.ok) {
  1676→      if (resolution.error === "not_found") {
  1677→        // AC: @session-log-show ac-9
  1678→        error(`Session not found: ${sessionRef}`);
  1679→        process.exit(EXIT_CODES.NOT_FOUND);
  1680→      } else {
  1681→        // AC: @session-log-show ac-8
  1682→        error(
  1683→          `Ambiguous session ID prefix. Matches:\n  ${resolution.matches.join("\n  ")}\nPlease provide a more specific prefix.`,
  1684→        );
  1685→        process.exit(EXIT_CODES.VALIDATION_FAILED);
  1686→      }
  1687→    }
  1688→
  1689→    const sessionId = resolution.id;
  1690→
  1691→    // Get session detail
  1692→    const detail = await getSessionLogDetail(ctx.specDir, sessionId);
  1693→    if (!detail) {
  1694→      error(`Session not found: ${sessionId}`);
  1695→      process.exit(EXIT_CODES.NOT_FOUND);
  1696→    }
  1697→
  1698→    // AC: @session-log-show ac-3, ac-4, ac-5 - Event timeline
  1699→    let events: SessionEvent[] | null = null;
  1700→    if (options.events) {
  1701→      let allEvents = deduplicatePhasedToolCalls(
  1702→        await readEvents(ctx.specDir, sessionId),
  1703→      );
  1704→
  1705→      // AC: @session-log-show ac-4 - Filter by type
  1706→      if (options.type) {
  1707→        const typeFilter = options.type;
  1708→        allEvents = allEvents.filter((e) => e.type === typeFilter);
  1709→      }
  1710→
  1711→      // AC: @session-log-show ac-5 - Limit to last N events
  1712→      if (options.limit) {
  1713→        const limit = parseInt(options.limit, 10);
  1714→        if (!Number.isNaN(limit) && limit > 0) {
  1715→          allEvents = allEvents.slice(-limit);
  1716→        }
  1717→      }
  1718→
  1719→      events = allEvents;
  1720→    }
  1721→
  1722→    // AC: @session-log-show ac-6 - Context snapshot
  1723→    let contextSnapshot: unknown | null = null;
  1724→    if (options.context) {
  1725→      const iterNum = parseInt(options.context, 10);
  1726→      if (!Number.isNaN(iterNum) && iterNum > 0) {
  1727→        contextSnapshot = await readSessionContext(
  1728→          ctx.specDir,
  1729→          sessionId,
  1730→          iterNum,
  1731→        );
  1732→        if (contextSnapshot === null) {
  1733→          error(`No context snapshot found for iteration ${iterNum}`);
  1734→          process.exit(EXIT_CODES.NOT_FOUND);
  1735→        }
  1736→      } else {
  1737→        error(`Invalid iteration number: ${options.context}`);
  1738→        process.exit(EXIT_CODES.USAGE_ERROR);
  1739→      }
  1740→    }
  1741→
  1742→    const sessionStartTs = new Date(detail.started_at).getTime();
  1743→
  1744→    // Build JSON output structure
  1745→    const jsonOutput = {
  1746→      ...detail,
  1747→      ...(events !== null ? { events } : {}),
  1748→      ...(contextSnapshot !== null ? { context: contextSnapshot } : {}),
  1749→    };
  1750→
  1751→    output(jsonOutput, () =>
  1752→      formatSessionLogShow(detail, events, contextSnapshot, sessionStartTs),
  1753→    );
  1754→  } catch (err) {
  1755→    error("Failed to show session log", err);
  1756→    process.exit(EXIT_CODES.ERROR);
  1757→  }
  1758→}
  1759→
  1760→// ─── Session Log Stats ─────────────────────────────────────────────────────────
  1761→
  1762→interface SessionLogStatsOptions {
  1763→  since?: string;
  1764→  agent?: string;
  1765→  toolUsage?: boolean;
  1766→  byDay?: boolean;
  1767→  byWeek?: boolean;
  1768→}
  1769→
  1770→/**
  1771→ * Full stats output including optional tool usage and time period data.
  1772→ */
  1773→interface SessionLogStatsOutput {
  1774→  stats: SessionLogStats;
  1775→  tool_usage?: ToolUsageStats[];
  1776→  time_periods?: TimePeriodStats[];
  1777→}
  1778→
  1779→/**
  1780→ * Format a duration in milliseconds to human-readable format.
  1781→ * Reuses formatDuration from session log list but handles hours/minutes/seconds.
  1782→ */
  1783→function formatDurationLong(ms: number): string {
  1784→  if (ms < 0) return "—";
  1785→  const totalSec = Math.floor(ms / 1000);
  1786→  const hours = Math.floor(totalSec / 3600);
  1787→  const minutes = Math.floor((totalSec % 3600) / 60);
  1788→  const seconds = totalSec % 60;
  1789→  if (hours > 0 && minutes > 0) {
  1790→    return `${hours}h ${minutes}m`;
  1791→  }
  1792→  if (hours > 0) {
  1793→    return `${hours}h`;
  1794→  }
  1795→  if (minutes > 0) {
  1796→    return `${minutes}m ${seconds}s`;
  1797→  }
  1798→  return `${seconds}s`;
  1799→}
  1800→
  1801→/**
  1802→ * Format the session log stats output.
  1803→ *
  1804→ * AC: @session-log-stats ac-1, ac-2, ac-3
  1805→ */
  1806→function formatSessionLogStats(
  1807→  stats: SessionLogStats,
  1808→  toolUsage: ToolUsageStats[] | null,
  1809→  timePeriods: TimePeriodStats[] | null,
  1810→  groupBy: "day" | "week" | null,
  1811→): void {
  1812→  // AC: @session-log-stats ac-1 - Totals
  1813→  console.log(chalk.bold("Session Statistics"));
  1814→  console.log(chalk.gray("─".repeat(50)));
  1815→  console.log(`  Total Sessions:     ${stats.total_sessions}`);
  1816→  console.log(`  Total Events:       ${stats.total_events}`);
  1817→  console.log(`  Total Iterations:   ${stats.total_iterations}`);
  1818→  console.log(`  Tasks Completed:    ${stats.total_tasks_completed}`);
  1819→  console.log(`  Total Duration:     ${formatDurationLong(stats.total_duration_ms)}`);
  1820→
  1821→  // AC: @session-log-stats ac-2 - Averages
  1822→  console.log("\n" + chalk.bold("Averages"));
  1823→  console.log(chalk.gray("─".repeat(50)));
  1824→  console.log(`  Avg Duration/Session:     ${formatDurationLong(stats.avg_duration_ms)}`);
  1825→  console.log(`  Avg Iterations/Session:   ${stats.avg_iterations_per_session}`);
  1826→  console.log(`  Avg Tasks/Session:        ${stats.avg_tasks_per_session}`);
  1827→
  1828→  // AC: @session-log-stats ac-3 - Status breakdown
  1829→  if (stats.status_breakdown.length > 0) {
  1830→    console.log("\n" + chalk.bold("Status Breakdown"));
  1831→    console.log(chalk.gray("─".repeat(50)));
  1832→    for (const item of stats.status_breakdown) {
  1833→      const statusColor =
  1834→        item.status === "completed"
  1835→          ? chalk.green
  1836→          : item.status === "active"
  1837→            ? chalk.blue
  1838→            : chalk.yellow;
  1839→      console.log(
  1840→        `  ${statusColor(item.status.padEnd(12))} ${String(item.count).padEnd(6)} ${item.percentage}%`,
  1841→      );
  1842→    }
  1843→  }
  1844→
  1845→  // AC: @session-log-stats ac-6 - Tool usage
  1846→  if (toolUsage !== null && toolUsage.length > 0) {
  1847→    console.log("\n" + chalk.bold("Top Tool Usage"));
  1848→    console.log(chalk.gray("─".repeat(50)));
  1849→    for (const tool of toolUsage) {
  1850→      console.log(
  1851→        `  ${tool.tool_name.padEnd(20)} ${String(tool.count).padEnd(8)} ${tool.percentage}%`,
  1852→      );
  1853→    }
  1854→  }
  1855→
  1856→  // AC: @session-log-stats ac-7 - Time periods
  1857→  if (timePeriods !== null && timePeriods.length > 0) {
  1858→    const label = groupBy === "week" ? "By Week" : "By Day";
  1859→    console.log("\n" + chalk.bold(label));
  1860→    console.log(chalk.gray("─".repeat(50)));
  1861→    console.log(
  1862→      chalk.gray(
  1863→        `  ${"Period".padEnd(14)} ${"Sessions".padEnd(10)} ${"Tasks".padEnd(8)} Duration`,
  1864→      ),
  1865→    );
  1866→    for (const period of timePeriods) {
  1867→      console.log(
  1868→        `  ${period.period.padEnd(14)} ${String(period.sessions_count).padEnd(10)} ${String(period.tasks_completed).padEnd(8)} ${formatDurationLong(period.total_duration_ms)}`,
  1869→      );
  1870→    }
  1871→  }
  1872→}
  1873→
  1874→/**
  1875→ * Session log stats action handler.
  1876→ */
  1877→async function sessionLogStatsAction(
  1878→  options: SessionLogStatsOptions,
  1879→): Promise<void> {
  1880→  try {
  1881→    const ctx = await initContext();
  1882→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1883→
  1884→    // AC: @session-log-stats ac-4 - Filter by since
  1885→    if (options.since) {
  1886→      const sinceDate = parseTimeSpec(options.since);
  1887→      if (sinceDate) {
  1888→        sessions = sessions.filter(
  1889→          (s) => new Date(s.started_at) >= sinceDate,
  1890→        );
  1891→      }
  1892→    }
  1893→
  1894→    // AC: @session-log-stats ac-5 - Filter by agent type
  1895→    if (options.agent) {
  1896→      const agentFilter = options.agent;
  1897→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1898→    }
  1899→
  1900→    // AC: @session-log-stats ac-8 - No sessions match criteria
  1901→    if (sessions.length === 0) {
  1902→      output({ message: "No sessions match criteria" }, () => {
  1903→        console.log("No sessions match criteria.");
  1904→      });
  1905→      return;
  1906→    }
  1907→
  1908→    // Compute base stats
  1909→    const stats = computeSessionLogStats(sessions);
  1910→
  1911→    // AC: @session-log-stats ac-6 - Tool usage (optional)
  1912→    let toolUsage: ToolUsageStats[] | null = null;
  1913→    if (options.toolUsage) {
  1914→      const sessionIds = sessions.map((s) => s.id);
  1915→      toolUsage = await computeToolUsageStats(ctx.specDir, sessionIds);
  1916→    }
  1917→
  1918→    // AC: @session-log-stats ac-7 - Time periods (optional)
  1919→    let timePeriods: TimePeriodStats[] | null = null;
  1920→    let groupBy: "day" | "week" | null = null;
  1921→    if (options.byDay) {
  1922→      groupBy = "day";
  1923→      timePeriods = computeTimePeriodStats(sessions, "day");
  1924→    } else if (options.byWeek) {
  1925→      groupBy = "week";
  1926→      timePeriods = computeTimePeriodStats(sessions, "week");
  1927→    }
  1928→
  1929→    // Build output structure
  1930→    const jsonOutput: SessionLogStatsOutput = { stats };
  1931→    if (toolUsage !== null) {
  1932→      jsonOutput.tool_usage = toolUsage;
  1933→    }
  1934→    if (timePeriods !== null) {
  1935→      jsonOutput.time_periods = timePeriods;
  1936→    }
  1937→
  1938→    output(jsonOutput, () =>
  1939→      formatSessionLogStats(stats, toolUsage, timePeriods, groupBy),
  1940→    );
  1941→  } catch (err) {
  1942→    error("Failed to compute session log stats", err);
  1943→    process.exit(EXIT_CODES.ERROR);
  1944→  }
  1945→}
  1946→
  1947→// ─── Session Log Search ─────────────────────────────────────────────────────────
  1948→
  1949→interface SessionLogSearchOptions {
  1950→  type?: string;
  1951→  since?: string;
  1952→  agent?: string;
  1953→  limit?: string;
  1954→}
  1955→
  1956→/**
  1957→ * Format relative timestamp from event timestamp (Unix ms) to session start.
  1958→ */
  1959→function formatSearchTimestamp(eventTs: number): string {
  1960→  return new Date(eventTs).toISOString();
  1961→}
  1962→
  1963→/**
  1964→ * Format the session log search output.
  1965→ *
  1966→ * AC: @session-log-search ac-1, ac-4
  1967→ */
  1968→function formatSessionLogSearch(results: SessionSearchResult[]): void {
  1969→  if (results.length === 0) {
  1970→    // AC: @session-log-search ac-6
  1971→    console.log("No matches found.");
  1972→    return;
  1973→  }
  1974→
  1975→  let totalMatches = 0;
  1976→  for (const session of results) {
  1977→    totalMatches += session.matches.length;
  1978→  }
  1979→
  1980→  console.log(chalk.bold(`Found ${totalMatches} match(es) in ${results.length} session(s)`));
  1981→  console.log(chalk.gray("─".repeat(60)));
  1982→
  1983→  for (const session of results) {
  1984→    // Session header
  1985→    console.log(
  1986→      `\n${chalk.cyan(`Session ${session.session_id.slice(0, 8)}`)} ` +
  1987→        `${chalk.gray(`(${session.agent_type}, started ${formatRelativeTime(new Date(session.started_at))})`)}`
  1988→    );
  1989→
  1990→    // AC: @session-log-search ac-4 - Show matches with session ID, timestamp, type, excerpt
  1991→    for (const match of session.matches) {
  1992→      const ts = formatSearchTimestamp(match.timestamp);
  1993→      const typeColor =
  1994→        match.event_type === "session.start" || match.event_type === "session.end"
  1995→          ? chalk.green
  1996→          : match.event_type === "session.update"
  1997→            ? chalk.blue
  1998→            : chalk.gray;
  1999→      console.log(
  2000→        `  ${chalk.yellow(ts)} ${typeColor(match.event_type.padEnd(16))}`,
  2001→      );
  2002→      // Content excerpt on next line, indented
  2003→      console.log(`    ${chalk.gray(match.content_excerpt)}`);
  2004→    }
  2005→  }
  2006→}
  2007→
  2008→/**
  2009→ * Session log search action handler.
  2010→ *
  2011→ * AC: @session-log-search ac-1 through ac-7
  2012→ */
  2013→async function sessionLogSearchAction(
  2014→  pattern: string,
  2015→  options: SessionLogSearchOptions,
  2016→): Promise<void> {
  2017→  try {
  2018→    const ctx = await initContext();
  2019→
  2020→    // Parse options - validate limit as positive integer
  2021→    let limit = 50;
  2022→    if (options.limit) {
  2023→      const parsed = parseInt(options.limit, 10);
  2024→      if (Number.isNaN(parsed) || parsed <= 0) {
  2025→        error(`Invalid limit: ${options.limit}. Must be a positive integer.`);
  2026→        process.exit(EXIT_CODES.USAGE_ERROR);
  2027→      }
  2028→      limit = parsed;
  2029→    }
  2030→    const sinceDate = options.since ? parseTimeSpec(options.since) : undefined;
  2031→
  2032→    // AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7
  2033→    const results = await searchSessionEvents(ctx.specDir, pattern, {
  2034→      eventType: options.type,
  2035→      sinceDate: sinceDate || undefined,
  2036→      agentType: options.agent,
  2037→      limit,
  2038→    });
  2039→
  2040→    // AC: @session-log-search ac-6 - No matches found message
  2041→    // exit code 0 regardless (per @trait-semantic-exit-codes ac-5)
  2042→
  2043→    output(results, () => formatSessionLogSearch(results));
  2044→  } catch (err) {
  2045→    error("Failed to search session logs", err);
  2046→    process.exit(EXIT_CODES.ERROR);
  2047→  }
  2048→}
  2049→
  2050→// ─── Session Create Action ─────────────────────────────────────────────────
  2051→
  2052→/**
  2053→ * Action handler for `kspec session create`.
  2054→ *
  2055→ * Creates a new session with optional budget and environment injection.
  2056→ *
  2057→ * AC: @session-creation-and-env-injection ac-create
  2058→ * AC: @session-creation-and-env-injection ac-budget
  2059→ * AC: @session-creation-and-env-injection ac-budget-local
  2060→ * AC: @session-creation-and-env-injection ac-inject-claude
  2061→ * AC: @session-creation-and-env-injection ac-inject-codex
  2062→ * AC: @session-creation-and-env-injection ac-inject-fallback
  2063→ *
  2064→ * Exit codes documented per @trait-semantic-exit-codes ac-8:
  2065→ * - 0: Session created successfully
  2066→ * - 1: Validation error (invalid budget value)
  2067→ * - 3: Runtime error (filesystem failure)
  2068→ */
  2069→async function sessionCreateAction(options: {
  2070→  agentType: string;
  2071→  budget?: string;
  2072→  inject?: boolean;
  2073→  taskId?: string;
  2074→}): Promise<void> {
  2075→  try {
  2076→    const ctx = await initContext();
  2077→
  2078→    // AC: @session-creation-and-env-injection ac-invalid-session
  2079→    // Validate existing KSPEC_SESSION_ID if set — warn user if it's stale/corrupt
  2080→    const existingSessionId = process.env.KSPEC_SESSION_ID;
  2081→    if (existingSessionId) {
  2082→      const validation = await validateSessionId(ctx.specDir, existingSessionId);
  2083→      if (!validation.valid) {
  2084→        warn(
  2085→          `Current KSPEC_SESSION_ID (${existingSessionId}) is invalid: ${validation.error}`,
  2086→        );
  2087→        info(validation.suggestion || "Creating a new session will generate a fresh ID.");
  2088→      }
  2089→    }
  2090→
  2091→    // Validate budget if provided
  2092→    // AC: @trait-error-guidance ac-5 - indicate which field/value failed
  2093→    let budgetNum: number | undefined;
  2094→    if (options.budget !== undefined) {
  2095→      // Use Number() instead of parseInt to reject "3.5", "3abc", "1e2" etc.
  2096→      budgetNum = Number(options.budget);
  2097→      if (isNaN(budgetNum) || budgetNum <= 0 || !Number.isInteger(budgetNum) || !/^\d+$/.test(options.budget)) {
  2098→        // AC: @trait-error-guidance ac-2, ac-5 - include suggested action and field info
  2099→        // AC: @trait-error-guidance ac-6 - guidance included in structured error
  2100→        error(
  2101→          `Invalid budget value: "${options.budget}". Must be a positive integer.`,
  2102→          { suggestion: "Usage: kspec session create --budget <positive-integer>" },
  2103→        );
  2104→        process.exit(EXIT_CODES.USAGE_ERROR);
  2105→      }
  2106→    }
  2107→
  2108→    // Generate session ID
  2109→    const sessionId = ulid();
  2110→
  2111→    // AC: @session-creation-and-env-injection ac-create, ac-budget, ac-budget-local
  2112→    const result = await createSessionWithBudget(ctx.specDir, {
  2113→      id: sessionId,
  2114→      agent_type: options.agentType,
  2115→      task_id: options.taskId,
  2116→      budget: budgetNum,
  2117→    });
  2118→
  2119→    // Handle environment injection if requested
  2120→    let injection: EnvInjectionResult | null = null;
  2121→    if (options.inject) {
  2122→      injection = await performEnvInjection(sessionId);
  2123→    }
  2124→
  2125→    // Build output data
  2126→    const outputData: Record<string, unknown> = {
  2127→      session_id: result.session_id,
  2128→      agent_type: result.session.agent_type,
  2129→      status: result.session.status,
  2130→      started_at: result.session.started_at,
  2131→    };
  2132→
  2133→    if (result.session.task_id) {
  2134→      outputData.task_id = result.session.task_id;
  2135→    }
  2136→
  2137→    if (result.budget) {
  2138→      outputData.budget = {
  2139→        max_per_cycle: result.budget.max_per_cycle,
  2140→        started_this_cycle: result.budget.started_this_cycle,
  2141→      };
  2142→    }
  2143→
  2144→    if (injection) {
  2145→      outputData.env_injection = {
  2146→        method: injection.method,
  2147→        injected: injection.injected,
  2148→        description: injection.description,
  2149→        ...(injection.path ? { path: injection.path } : {}),
  2150→      };
  2151→    }
  2152→
  2153→    // AC: @trait-json-output ac-1, ac-2, ac-5 - JSON with all data, ISO timestamps
  2154→    output(outputData, () => {
  2155→      // AC: @session-creation-and-env-injection ac-create - print session ID to stdout
  2156→      success(`Created session: ${sessionId}`, { session_id: sessionId });
  2157→      info(`Agent type: ${options.agentType}`);
  2158→
  2159→      if (result.budget) {
  2160→        info(
  2161→          `Budget: ${result.budget.max_per_cycle} tasks per cycle`,
  2162→        );
  2163→      }
  2164→
  2165→      if (injection) {
  2166→        if (injection.injected) {
  2167→          info(injection.description);
  2168→        } else {
  2169→          // AC: @session-creation-and-env-injection ac-inject-fallback
  2170→          console.log(injection.description);
  2171→        }
  2172→      }
  2173→    });
  2174→  } catch (err) {
  2175→    // AC: @trait-error-guidance ac-1 - describe what went wrong
  2176→    // AC: @trait-json-output ac-3 - error as JSON object
  2177→    error("Failed to create session", err);
  2178→    process.exit(EXIT_CODES.ERROR);
  2179→  }
  2180→}
  2181→
  2182→/**
  2183→ * Detect agent harness and perform environment injection.
  2184→ *
  2185→ * AC: @session-creation-and-env-injection ac-inject-claude
  2186→ * AC: @session-creation-and-env-injection ac-inject-codex
  2187→ * AC: @session-creation-and-env-injection ac-inject-fallback
  2188→ */
  2189→async function performEnvInjection(
  2190→  sessionId: string,
  2191→): Promise<EnvInjectionResult> {
  2192→  // Detect Claude Code
  2193→  if (
  2194→    process.env.CLAUDECODE === "1" ||
  2195→    process.env.CLAUDE_CODE_ENTRYPOINT ||
  2196→    process.env.CLAUDE_PROJECT_DIR
  2197→  ) {
  2198→    return injectClaudeCodeEnv(sessionId);
  2199→  }
  2200→
  2201→  // Detect Codex CLI
  2202→  if (process.env.CODEX_SANDBOX) {
  2203→    return injectCodexEnv(sessionId);
  2204→  }
  2205→
  2206→  // Detect Gemini CLI
  2207→  if (process.env.GEMINI_CLI === "1") {
  2208→    return injectGeminiEnv(sessionId);
  2209→  }
  2210→
  2211→  // Detect OpenCode
  2212→  if (process.env.OPENCODE_CONFIG_DIR || process.env.OPENCODE_CONFIG) {
  2213→    return injectOpenCodeEnv(sessionId);
  2214→  }
  2215→
  2216→  // Fallback for unknown harnesses
  2217→  return getFallbackInjectionInstructions(sessionId);
  2218→}
  2219→
  2220→/**
  2221→ * Register the 'session' command group and aliases
  2222→ */
  2223→export function registerSessionCommands(program: Command): void {
  2224→  const session = program
  2225→    .command("session")
  2226→    .description("Session management and context");
  2227→
  2228→  // Session create subcommand
  2229→  markMutating(session.command("create"))
  2230→    .description("Create a new kspec session with optional budget")
  2231→    .option(
  2232→      "--agent-type <type>",
  2233→      "Agent type (e.g., claude-code, codex-cli)",
  2234→      "claude-code",
  2235→    )
  2236→    .option("--budget <n>", "Maximum tasks per cycle (positive integer)")
  2237→    .option("--inject", "Inject KSPEC_SESSION_ID into agent environment")
  2238→    .option("--task-id <id>", "Optional task ID being worked on")
  2239→    .action(sessionCreateAction);
  2240→
  2241→  session
  2242→    .command("start")
  2243→    .alias("resume")
  2244→    .description("Surface relevant context for starting a new working session")
  2245→    .option("--brief", "Compact summary (default)")
  2246→    .option("--full", "Comprehensive context dump")
  2247→    .option(
  2248→      "--since <time>",
  2249→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  2250→    )
  2251→    .option("--no-git", "Skip git commit information")
  2252→    .option("-n, --limit <n>", "Limit items per section", "10")
  2253→    .action(sessionStartAction);
  2254→
  2255→  // Session log subcommand group
  2256→  const log = session
  2257→    .command("log")
  2258→    .description("Session log analysis commands");
  2259→
  2260→  log
  2261→    .command("list")
  2262→    .description("List session logs with summary statistics")
  2263→    .option(
  2264→      "-s, --status <status>",
  2265→      "Filter by status (active, completed, abandoned)",
  2266→    )
  2267→    .option("--agent <type>", "Filter by agent type")
  2268→    .option(
  2269→      "--since <time>",
  2270→      "Only show sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2271→    )
  2272→    .option(
  2273→      "--sort <field>",
  2274→      "Sort by field (started_at, duration, events, iterations, tasks_completed)",
  2275→      "started_at",
  2276→    )
  2277→    .option("--count", "Show only the count of matching sessions")
  2278→    .option("-n, --limit <n>", "Limit number of sessions shown")
  2279→    .action(sessionLogListAction);
  2280→
  2281→  log
  2282→    .command("show <session-id>")
  2283→    .description("Show detailed view of a single session")
  2284→    .option("-e, --events", "Include chronological event timeline")
  2285→    .option("-t, --type <type>", "Filter events by type (e.g., tool.call)")
  2286→    .option("-n, --limit <n>", "Show only the last N events")
  2287→    .option("-c, --context <n>", "Show context snapshot for iteration N")
  2288→    .action(sessionLogShowAction);
  2289→
  2290→  log
  2291→    .command("stats")
  2292→    .description("Aggregate analytics across sessions")
  2293→    .option(
  2294→      "--since <time>",
  2295→      "Only include sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2296→    )
  2297→    .option("--agent <type>", "Only include sessions with this agent type")
  2298→    .option("--tool-usage", "Display top 10 tool calls by frequency")
  2299→    .option("--by-day", "Group stats by day")
  2300→    .option("--by-week", "Group stats by week")
  2301→    .action(sessionLogStatsAction);
  2302→
  2303→  log
  2304→    .command("search <pattern>")
  2305→    .description("Search across session events by content")
  2306→    .option("-t, --type <type>", "Only search events of this type (e.g., session.update)")
  2307→    .option(
  2308→      "--since <time>",
  2309→      "Only search sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2310→    )
  2311→    .option("--agent <type>", "Only search sessions with this agent type")
  2312→    .option("-n, --limit <n>", "Maximum matches to return (default: 50)")
  2313→    .action(sessionLogSearchAction);
  2314→
  2315→  session
  2316→    .command("checkpoint")
  2317→    .description(
