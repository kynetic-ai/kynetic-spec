     1→/**
     2→ * Session event storage.
     3→ *
     4→ * JSONL-based event storage for agent sessions with:
     5→ * - Atomic appends for crash safety (AC-3)
     6→ * - Auto-assigned timestamps and sequence numbers (AC-2)
     7→ * - Session metadata management
     8→ *
     9→ * Storage structure:
    10→ *   .kspec/sessions/{session-id}/
    11→ *     session.yaml      # Metadata
    12→ *     events.jsonl      # Append-only event log
    13→ */
    14→
    15→import * as fs from "node:fs";
    16→import * as fsPromises from "node:fs/promises";
    17→import * as path from "node:path";
    18→import * as YAML from "yaml";
    19→import {
    20→  type SessionEvent,
    21→  type SessionEventInput,
    22→  SessionEventSchema,
    23→  type SessionMetadata,
    24→  type SessionMetadataInput,
    25→  SessionMetadataSchema,
    26→  type SessionStatus,
    27→  type TaskBudget,
    28→  TaskBudgetSchema,
    29→} from "./types.js";
    30→
    31→// ─── Constants ───────────────────────────────────────────────────────────────
    32→
    33→const SESSIONS_DIR = "sessions";
    34→const METADATA_FILE = "session.yaml";
    35→const EVENTS_FILE = "events.jsonl";
    36→const BUDGET_FILE = "budget.json";
    37→
    38→// ─── Path Helpers ────────────────────────────────────────────────────────────
    39→
    40→/**
    41→ * Get the sessions directory path within a spec directory.
    42→ */
    43→export function getSessionsDir(specDir: string): string {
    44→  return path.join(specDir, SESSIONS_DIR);
    45→}
    46→
    47→/**
    48→ * Get the path to a specific session's directory.
    49→ */
    50→export function getSessionDir(specDir: string, sessionId: string): string {
    51→  return path.join(getSessionsDir(specDir), sessionId);
    52→}
    53→
    54→/**
    55→ * Get the path to a session's metadata file.
    56→ */
    57→export function getSessionMetadataPath(
    58→  specDir: string,
    59→  sessionId: string,
    60→): string {
    61→  return path.join(getSessionDir(specDir, sessionId), METADATA_FILE);
    62→}
    63→
    64→/**
    65→ * Get the path to a session's events file.
    66→ */
    67→export function getSessionEventsPath(
    68→  specDir: string,
    69→  sessionId: string,
    70→): string {
    71→  return path.join(getSessionDir(specDir, sessionId), EVENTS_FILE);
    72→}
    73→
    74→/**
    75→ * Get the path to a session's context snapshot file for a given iteration.
    76→ */
    77→export function getSessionContextPath(
    78→  specDir: string,
    79→  sessionId: string,
    80→  iteration: number,
    81→): string {
    82→  return path.join(
    83→    getSessionDir(specDir, sessionId),
    84→    `context-iter-${iteration}.json`,
    85→  );
    86→}
    87→
    88→/**
    89→ * Get the path to a session's budget file.
    90→ * AC: @session-creation-and-env-injection ac-budget-local
    91→ */
    92→export function getSessionBudgetPath(
    93→  specDir: string,
    94→  sessionId: string,
    95→): string {
    96→  return path.join(getSessionDir(specDir, sessionId), BUDGET_FILE);
    97→}
    98→
    99→// ─── Session CRUD ────────────────────────────────────────────────────────────
   100→
   101→/**
   102→ * Create a new session with metadata.
   103→ *
   104→ * AC-1: Creates .kspec/sessions/{id}/ directory with session.yaml metadata file.
   105→ * AC-5: Metadata includes task_id (optional), agent_type, status, started_at, ended_at.
   106→ *
   107→ * @param specDir - The .kspec directory path
   108→ * @param input - Session metadata input
   109→ * @returns The created session metadata
   110→ */
   111→export async function createSession(
   112→  specDir: string,
   113→  input: SessionMetadataInput,
   114→): Promise<SessionMetadata> {
   115→  const sessionDir = getSessionDir(specDir, input.id);
   116→  const metadataPath = getSessionMetadataPath(specDir, input.id);
   117→
   118→  // Create session directory
   119→  await fsPromises.mkdir(sessionDir, { recursive: true });
   120→
   121→  // Build full metadata
   122→  const metadata: SessionMetadata = {
   123→    id: input.id,
   124→    task_id: input.task_id,
   125→    agent_type: input.agent_type,
   126→    status: input.status ?? "active",
   127→    started_at: input.started_at ?? new Date().toISOString(),
   128→    ended_at: undefined,
   129→  };
   130→
   131→  // Validate and write metadata
   132→  const validated = SessionMetadataSchema.parse(metadata);
   133→  const content = YAML.stringify(validated, {
   134→    indent: 2,
   135→    lineWidth: 100,
   136→    sortMapEntries: false,
   137→  });
   138→  await fsPromises.writeFile(metadataPath, content, "utf-8");
   139→
   140→  return validated;
   141→}
   142→
   143→/**
   144→ * Read session metadata.
   145→ *
   146→ * @param specDir - The .kspec directory path
   147→ * @param sessionId - Session ID
   148→ * @returns Session metadata or null if not found
   149→ */
   150→export async function getSession(
   151→  specDir: string,
   152→  sessionId: string,
   153→): Promise<SessionMetadata | null> {
   154→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   155→
   156→  try {
   157→    const content = await fsPromises.readFile(metadataPath, "utf-8");
   158→    const raw = YAML.parse(content);
   159→    return SessionMetadataSchema.parse(raw);
   160→  } catch {
   161→    return null;
   162→  }
   163→}
   164→
   165→/**
   166→ * Update session status.
   167→ *
   168→ * AC-6: Updates metadata with status and ended_at timestamp when session ends.
   169→ *
   170→ * @param specDir - The .kspec directory path
   171→ * @param sessionId - Session ID
   172→ * @param status - New status
   173→ * @returns Updated metadata or null if session not found
   174→ */
   175→export async function updateSessionStatus(
   176→  specDir: string,
   177→  sessionId: string,
   178→  status: SessionStatus,
   179→): Promise<SessionMetadata | null> {
   180→  const metadata = await getSession(specDir, sessionId);
   181→  if (!metadata) {
   182→    return null;
   183→  }
   184→
   185→  // Update status and ended_at if transitioning away from active
   186→  const updated: SessionMetadata = {
   187→    ...metadata,
   188→    status,
   189→    ended_at:
   190→      status !== "active" ? new Date().toISOString() : metadata.ended_at,
   191→  };
   192→
   193→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   194→  const content = YAML.stringify(updated, {
   195→    indent: 2,
   196→    lineWidth: 100,
   197→    sortMapEntries: false,
   198→  });
   199→  await fsPromises.writeFile(metadataPath, content, "utf-8");
   200→
   201→  return updated;
   202→}
   203→
   204→/**
   205→ * List all sessions.
   206→ *
   207→ * @param specDir - The .kspec directory path
   208→ * @returns Array of session IDs
   209→ */
   210→export async function listSessions(specDir: string): Promise<string[]> {
   211→  const sessionsDir = getSessionsDir(specDir);
   212→
   213→  try {
   214→    const entries = await fsPromises.readdir(sessionsDir, {
   215→      withFileTypes: true,
   216→    });
   217→    return entries.filter((e) => e.isDirectory()).map((e) => e.name);
   218→  } catch {
   219→    return [];
   220→  }
   221→}
   222→
   223→/**
   224→ * Check if a session exists.
   225→ */
   226→export async function sessionExists(
   227→  specDir: string,
   228→  sessionId: string,
   229→): Promise<boolean> {
   230→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   231→  try {
   232→    await fsPromises.access(metadataPath);
   233→    return true;
   234→  } catch {
   235→    return false;
   236→  }
   237→}
   238→
   239→// ─── End-Loop Signal ────────────────────────────────────────────────────────
   240→
   241→/**
   242→ * Request end-loop for a session.
   243→ *
   244→ * Writes end_requested=true and optional end_reason to the session metadata.
   245→ * This is the session-scoped replacement for the marker file approach.
   246→ *
   247→ * AC: @session-end-loop-signal ac-signal
   248→ *
   249→ * @param specDir - The .kspec directory path
   250→ * @param sessionId - Session ID
   251→ * @param reason - Optional reason for ending the loop
   252→ * @returns Updated metadata or null if session not found
   253→ */
   254→export async function requestEndLoop(
   255→  specDir: string,
   256→  sessionId: string,
   257→  reason?: string,
   258→): Promise<SessionMetadata | null> {
   259→  const metadata = await getSession(specDir, sessionId);
   260→  if (!metadata) {
   261→    return null;
   262→  }
   263→
   264→  const updated: SessionMetadata = {
   265→    ...metadata,
   266→    end_requested: true,
   267→    end_reason: reason,
   268→  };
   269→
   270→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   271→  const content = YAML.stringify(updated, {
   272→    indent: 2,
   273→    lineWidth: 100,
   274→    sortMapEntries: false,
   275→  });
   276→  await fsPromises.writeFile(metadataPath, content, "utf-8");
   277→
   278→  return updated;
   279→}
   280→
   281→/**
   282→ * Check if end-loop has been requested for a session.
   283→ *
   284→ * Only returns requested=true for active sessions. If the session is
   285→ * completed or abandoned, the end-loop signal is no longer relevant
   286→ * (prevents stale KSPEC_SESSION_ID from blocking task starts).
   287→ *
   288→ * AC: @session-end-loop-signal ac-detect
   289→ *
   290→ * @param specDir - The .kspec directory path
   291→ * @param sessionId - Session ID
   292→ * @returns Object with requested flag and optional reason, or null if session not found
   293→ */
   294→export async function isEndLoopRequested(
   295→  specDir: string,
   296→  sessionId: string,
   297→): Promise<{ requested: boolean; reason?: string } | null> {
   298→  const metadata = await getSession(specDir, sessionId);
   299→  if (!metadata) {
   300→    return null;
   301→  }
   302→
   303→  return {
   304→    requested: metadata.end_requested === true && metadata.status === "active",
   305→    reason: metadata.end_reason,
   306→  };
   307→}
   308→
   309→/**
   310→ * Close a session with a specific status and reason.
   311→ *
   312→ * Used for all session close paths: normal exit, signal, error.
   313→ *
   314→ * AC: @session-end-loop-signal ac-session-close-normal
   315→ * AC: @session-end-loop-signal ac-session-close-signal
   316→ * AC: @session-end-loop-signal ac-session-close-error
   317→ *
   318→ * @param specDir - The .kspec directory path
   319→ * @param sessionId - Session ID
   320→ * @param status - New status (completed or abandoned)
   321→ * @param reason - Reason for closing
   322→ * @returns Updated metadata or null if session not found
   323→ */
   324→export async function closeSession(
   325→  specDir: string,
   326→  sessionId: string,
   327→  status: SessionStatus,
   328→  reason: string,
   329→): Promise<SessionMetadata | null> {
   330→  const metadata = await getSession(specDir, sessionId);
   331→  if (!metadata) {
   332→    return null;
   333→  }
   334→
   335→  const updated: SessionMetadata = {
   336→    ...metadata,
   337→    status,
   338→    ended_at: new Date().toISOString(),
   339→    close_reason: reason,
   340→  };
   341→
   342→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   343→  const content = YAML.stringify(updated, {
   344→    indent: 2,
   345→    lineWidth: 100,
   346→    sortMapEntries: false,
   347→  });
   348→  await fsPromises.writeFile(metadataPath, content, "utf-8");
   349→
   350→  return updated;
   351→}
   352→
   353→// ─── Event Storage ───────────────────────────────────────────────────────────
   354→
   355→/**
   356→ * Get the current event count for a session (for seq assignment).
   357→ *
   358→ * @param specDir - The .kspec directory path
   359→ * @param sessionId - Session ID
   360→ * @returns Number of events in the session
   361→ */
   362→async function getEventCount(
   363→  specDir: string,
   364→  sessionId: string,
   365→): Promise<number> {
   366→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   367→
   368→  try {
   369→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   370→    const lines = content
   371→      .trim()
   372→      .split("\n")
   373→      .filter((line) => line.length > 0);
   374→    return lines.length;
   375→  } catch {
   376→    return 0;
   377→  }
   378→}
   379→
   380→/**
   381→ * Append an event to a session's event log.
   382→ *
   383→ * AC-2: Appends JSON line to events.jsonl with auto-assigned ts and seq.
   384→ * AC-3: Uses atomic append (appendFileSync) for crash safety.
   385→ *
   386→ * Creates the session directory if it doesn't exist (lazy creation).
   387→ *
   388→ * Note: This function is not safe for concurrent access to the same session.
   389→ * The sequence number assignment has a race condition between reading the
   390→ * event count and appending the event. This is acceptable for CLI use
   391→ * (single-process, sequential event logging). If concurrent access is needed
   392→ * in the future, consider file locking or an in-memory counter per session.
   393→ *
   394→ * @param specDir - The .kspec directory path
   395→ * @param input - Event input (ts and seq are auto-assigned if not provided)
   396→ * @returns The appended event with auto-assigned fields
   397→ */
   398→export async function appendEvent(
   399→  specDir: string,
   400→  input: SessionEventInput,
   401→): Promise<SessionEvent> {
   402→  const sessionDir = getSessionDir(specDir, input.session_id);
   403→  const eventsPath = getSessionEventsPath(specDir, input.session_id);
   404→
   405→  // Ensure session directory exists (lazy creation)
   406→  await fsPromises.mkdir(sessionDir, { recursive: true });
   407→
   408→  // Get current event count for seq assignment
   409→  const seq = input.seq ?? (await getEventCount(specDir, input.session_id));
   410→
   411→  // Build full event
   412→  const event: SessionEvent = {
   413→    ts: input.ts ?? Date.now(),
   414→    seq,
   415→    type: input.type,
   416→    session_id: input.session_id,
   417→    trace_id: input.trace_id,
   418→    data: input.data,
   419→  };
   420→
   421→  // Validate event
   422→  const validated = SessionEventSchema.parse(event);
   423→
   424→  // AC: @session-events ac-3 - Use synchronous append for crash safety
   425→  // This ensures the line is fully written before returning
   426→  const line = `${JSON.stringify(validated)}\n`;
   427→  fs.appendFileSync(eventsPath, line, "utf-8");
   428→
   429→  return validated;
   430→}
   431→
   432→/**
   433→ * Read all events from a session.
   434→ *
   435→ * AC-4: Returns all events in sequence order.
   436→ *
   437→ * @param specDir - The .kspec directory path
   438→ * @param sessionId - Session ID
   439→ * @returns Array of events sorted by sequence number
   440→ */
   441→export async function readEvents(
   442→  specDir: string,
   443→  sessionId: string,
   444→): Promise<SessionEvent[]> {
   445→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   446→
   447→  try {
   448→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   449→    const lines = content
   450→      .trim()
   451→      .split("\n")
   452→      .filter((line) => line.length > 0);
   453→
   454→    const events: SessionEvent[] = [];
   455→    for (const line of lines) {
   456→      try {
   457→        const raw = JSON.parse(line);
   458→        const event = SessionEventSchema.parse(raw);
   459→        events.push(event);
   460→      } catch {
   461→        // Skip invalid lines
   462→      }
   463→    }
   464→
   465→    // AC: @session-events ac-4 - Sort by sequence number
   466→    return events.sort((a, b) => a.seq - b.seq);
   467→  } catch {
   468→    return [];
   469→  }
   470→}
   471→
   472→/**
   473→ * Deduplicate phased tool_call events.
   474→ *
   475→ * ACP SDK 0.14+ sends tool calls in two phases: first with empty rawInput,
   476→ * then with populated rawInput. This merges them by keeping only the version
   477→ * with populated rawInput per toolCallId.
   478→ */
   479→export function deduplicatePhasedToolCalls(
   480→  events: SessionEvent[],
   481→): SessionEvent[] {
   482→  // First pass: find toolCallIds that have a populated rawInput version
   483→  const populatedToolCalls = new Map<string, number>(); // toolCallId → index
   484→  for (let i = 0; i < events.length; i++) {
   485→    const event = events[i];
   486→    if (event.type !== "session.update") continue;
   487→    const data = event.data as { update?: { sessionUpdate?: string; toolCallId?: string; tool_call_id?: string; id?: string; rawInput?: Record<string, unknown> } } | null;
   488→    const update = data?.update;
   489→    if (update?.sessionUpdate !== "tool_call") continue;
   490→    const toolCallId = update.toolCallId || update.tool_call_id || update.id;
   491→    if (!toolCallId) continue;
   492→    const rawInput = update.rawInput;
   493→    const hasContent = rawInput && Object.keys(rawInput).length > 0;
   494→    if (hasContent) {
   495→      populatedToolCalls.set(toolCallId, i);
   496→    } else if (!populatedToolCalls.has(toolCallId)) {
   497→      // First (empty) version - track it in case no populated version exists
   498→      populatedToolCalls.set(toolCallId, i);
   499→    }
   500→  }
   501→
   502→  // Second pass: keep only the best version per toolCallId
   503→  return events.filter((event, i) => {
   504→    if (event.type !== "session.update") return true;
   505→    const data = event.data as { update?: { sessionUpdate?: string; toolCallId?: string; tool_call_id?: string; id?: string; rawInput?: Record<string, unknown> } } | null;
   506→    const update = data?.update;
   507→    if (update?.sessionUpdate !== "tool_call") return true;
   508→    const toolCallId = update.toolCallId || update.tool_call_id || update.id;
   509→    if (!toolCallId) return true;
   510→    // Keep this event only if it's the best version (populated or only version)
   511→    return populatedToolCalls.get(toolCallId) === i;
   512→  });
   513→}
   514→
   515→/**
   516→ * Read events within a time range.
   517→ *
   518→ * @param specDir - The .kspec directory path
   519→ * @param sessionId - Session ID
   520→ * @param since - Start timestamp (inclusive)
   521→ * @param until - End timestamp (inclusive)
   522→ * @returns Array of events within the time range
   523→ */
   524→export async function readEventsSince(
   525→  specDir: string,
   526→  sessionId: string,
   527→  since: number,
   528→  until?: number,
   529→): Promise<SessionEvent[]> {
   530→  const events = await readEvents(specDir, sessionId);
   531→  return events.filter((e) => {
   532→    if (e.ts < since) return false;
   533→    if (until !== undefined && e.ts > until) return false;
   534→    return true;
   535→  });
   536→}
   537→
   538→/**
   539→ * Get the last event in a session.
   540→ *
   541→ * @param specDir - The .kspec directory path
   542→ * @param sessionId - Session ID
   543→ * @returns The last event or null if no events
   544→ */
   545→export async function getLastEvent(
   546→  specDir: string,
   547→  sessionId: string,
   548→): Promise<SessionEvent | null> {
   549→  const events = await readEvents(specDir, sessionId);
   550→  if (events.length === 0) {
   551→    return null;
   552→  }
   553→  return events[events.length - 1];
   554→}
   555→
   556→// ─── Session Log Summaries ───────────────────────────────────────────────────
   557→
   558→/**
   559→ * Summary data for a session, used by `session log list`.
   560→ */
   561→export interface SessionLogSummary {
   562→  /** Session ID */
   563→  id: string;
   564→  /** Session status */
   565→  status: SessionStatus;
   566→  /** Agent type */
   567→  agent_type: string;
   568→  /** When session started (ISO 8601) */
   569→  started_at: string;
   570→  /** When session ended (ISO 8601), if completed */
   571→  ended_at?: string;
   572→  /** Duration in milliseconds (computed from started_at/ended_at or now) */
   573→  duration_ms: number;
   574→  /** Number of events in events.jsonl */
   575→  event_count: number;
   576→  /** Number of context-iter-*.json files (iteration count) */
   577→  iteration_count: number;
   578→  /** Number of tasks completed during the session */
   579→  tasks_completed: number;
   580→}
   581→
   582→/**
   583→ * Count lines in events.jsonl without parsing JSON.
   584→ * Much faster than readEvents() for large files.
   585→ */
   586→async function countEventLines(
   587→  specDir: string,
   588→  sessionId: string,
   589→): Promise<number> {
   590→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   591→  try {
   592→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   593→    if (!content.trim()) return 0;
   594→    return content.trim().split("\n").length;
   595→  } catch {
   596→    return 0;
   597→  }
   598→}
   599→
   600→/**
   601→ * Count context-iter-*.json files for a session (iteration count).
   602→ */
   603→async function countIterations(
   604→  specDir: string,
   605→  sessionId: string,
   606→): Promise<number> {
   607→  const sessionDir = getSessionDir(specDir, sessionId);
   608→  try {
   609→    const entries = await fsPromises.readdir(sessionDir);
   610→    return entries.filter(
   611→      (e) => e.startsWith("context-iter-") && e.endsWith(".json"),
   612→    ).length;
   613→  } catch {
   614→    return 0;
   615→  }
   616→}
   617→
   618→/**
   619→ * Count task completions by scanning events for tool calls that invoke
   620→ * `kspec task complete` or `npm run dev -- task complete`.
   621→ *
   622→ * Real sessions record task completions as session.update events with
   623→ * sessionUpdate: "tool_call" and rawInput.command containing the complete command.
   624→ * We use a fast substring check before JSON parsing for performance.
   625→ */
   626→async function countTaskCompletions(
   627→  specDir: string,
   628→  sessionId: string,
   629→): Promise<number> {
   630→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   631→  try {
   632→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   633→    if (!content.trim()) return 0;
   634→    const lines = content.trim().split("\n");
   635→    let count = 0;
   636→    for (const line of lines) {
   637→      // Quick substring pre-filter: only parse lines that might contain task complete commands
   638→      if (!line.includes("task complete")) continue;
   639→      // Must be a tool_call event (session.update with sessionUpdate: "tool_call")
   640→      if (!line.includes('"tool_call"')) continue;
   641→      try {
   642→        const event = JSON.parse(line);
   643→        const command = event?.data?.update?.rawInput?.command;
   644→        if (typeof command === "string" && /\btask complete\b/.test(command)) {
   645→          count++;
   646→        }
   647→      } catch {
   648→        // Skip unparseable lines
   649→      }
   650→    }
   651→    return count;
   652→  } catch {
   653→    return 0;
   654→  }
   655→}
   656→
   657→/**
   658→ * Get a summary of a single session for list display.
   659→ *
   660→ * Gathers metadata and computes metrics lazily (only parses what's needed).
   661→ *
   662→ * @param specDir - The .kspec directory path
   663→ * @param sessionId - Session ID
   664→ * @returns Session summary or null if session doesn't exist
   665→ */
   666→export async function getSessionLogSummary(
   667→  specDir: string,
   668→  sessionId: string,
   669→): Promise<SessionLogSummary | null> {
   670→  const metadata = await getSession(specDir, sessionId);
   671→  if (!metadata) return null;
   672→
   673→  const [eventCount, iterationCount, tasksCompleted] = await Promise.all([
   674→    countEventLines(specDir, sessionId),
   675→    countIterationsBoundaryAware(specDir, sessionId),
   676→    countTaskCompletions(specDir, sessionId),
   677→  ]);
   678→
   679→  const startMs = new Date(metadata.started_at).getTime();
   680→  const endMs = metadata.ended_at
   681→    ? new Date(metadata.ended_at).getTime()
   682→    : Date.now();
   683→  const durationMs = endMs - startMs;
   684→
   685→  return {
   686→    id: metadata.id,
   687→    status: metadata.status,
   688→    agent_type: metadata.agent_type,
   689→    started_at: metadata.started_at,
   690→    ended_at: metadata.ended_at,
   691→    duration_ms: durationMs,
   692→    event_count: eventCount,
   693→    iteration_count: iterationCount,
   694→    tasks_completed: tasksCompleted,
   695→  };
   696→}
   697→
   698→/**
   699→ * Get summaries for all sessions.
   700→ *
   701→ * @param specDir - The .kspec directory path
   702→ * @returns Array of session summaries
   703→ */
   704→export async function getAllSessionLogSummaries(
   705→  specDir: string,
   706→): Promise<SessionLogSummary[]> {
   707→  const sessionIds = await listSessions(specDir);
   708→  const summaries = await Promise.all(
   709→    sessionIds.map((id) => getSessionLogSummary(specDir, id)),
   710→  );
   711→  return summaries.filter((s): s is SessionLogSummary => s !== null);
   712→}
   713→
   714→// ─── Context Snapshots ───────────────────────────────────────────────────────
   715→
   716→/**
   717→ * Save session context snapshot for a given iteration.
   718→ *
   719→ * This creates an audit trail of what context the agent saw at each iteration,
   720→ * useful for debugging and reviewing agent behavior.
   721→ *
   722→ * @param specDir - The .kspec directory path
   723→ * @param sessionId - Session ID
   724→ * @param iteration - Iteration number
   725→ * @param context - The session context data
   726→ */
   727→export async function saveSessionContext(
   728→  specDir: string,
   729→  sessionId: string,
   730→  iteration: number,
   731→  context: unknown,
   732→): Promise<void> {
   733→  const sessionDir = getSessionDir(specDir, sessionId);
   734→  const contextPath = getSessionContextPath(specDir, sessionId, iteration);
   735→
   736→  // Ensure session directory exists
   737→  await fsPromises.mkdir(sessionDir, { recursive: true });
   738→
   739→  // Write context snapshot as pretty JSON
   740→  const content = JSON.stringify(context, null, 2);
   741→  await fsPromises.writeFile(contextPath, content, "utf-8");
   742→}
   743→
   744→/**
   745→ * Read session context snapshot for a given iteration.
   746→ *
   747→ * @param specDir - The .kspec directory path
   748→ * @param sessionId - Session ID
   749→ * @param iteration - Iteration number
   750→ * @returns The context snapshot or null if not found
   751→ */
   752→export async function readSessionContext(
   753→  specDir: string,
   754→  sessionId: string,
   755→  iteration: number,
   756→): Promise<unknown | null> {
   757→  const contextPath = getSessionContextPath(specDir, sessionId, iteration);
   758→
   759→  try {
   760→    const content = await fsPromises.readFile(contextPath, "utf-8");
   761→    return JSON.parse(content);
   762→  } catch {
   763→    return null;
   764→  }
   765→}
   766→
   767→// ─── Session ID Resolution ───────────────────────────────────────────────────
   768→
   769→/**
   770→ * Result of resolving a session ID prefix.
   771→ */
   772→export type SessionIdResolution =
   773→  | { ok: true; id: string }
   774→  | { ok: false; error: "not_found" }
   775→  | { ok: false; error: "ambiguous"; matches: string[] };
   776→
   777→/**
   778→ * Resolve a session ID or prefix to a full session ID.
   779→ *
   780→ * AC: @session-log-show ac-7, ac-8, ac-9
   781→ *
   782→ * @param specDir - The .kspec directory path
   783→ * @param idOrPrefix - Full session ID or prefix (e.g., first 8 chars)
   784→ * @returns Resolution result
   785→ */
   786→export async function resolveSessionId(
   787→  specDir: string,
   788→  idOrPrefix: string,
   789→): Promise<SessionIdResolution> {
   790→  const sessionIds = await listSessions(specDir);
   791→
   792→  // First, try exact match
   793→  if (sessionIds.includes(idOrPrefix)) {
   794→    return { ok: true, id: idOrPrefix };
   795→  }
   796→
   797→  // Try prefix match
   798→  const matches = sessionIds.filter((id) => id.startsWith(idOrPrefix));
   799→
   800→  if (matches.length === 0) {
   801→    return { ok: false, error: "not_found" };
   802→  }
   803→
   804→  if (matches.length === 1) {
   805→    return { ok: true, id: matches[0] };
   806→  }
   807→
   808→  // Ambiguous - multiple matches
   809→  return { ok: false, error: "ambiguous", matches };
   810→}
   811→
   812→// ─── Session Detail Data ─────────────────────────────────────────────────────
   813→
   814→/**
   815→ * Per-iteration summary for session log show.
   816→ */
   817→export interface IterationSummary {
   818→  /** Iteration number (1-indexed) */
   819→  iteration: number;
   820→  /** Number of events in this iteration */
   821→  event_count: number;
   822→  /** Tasks started in this iteration */
   823→  tasks_started: string[];
   824→  /** Tasks completed in this iteration */
   825→  tasks_completed: string[];
   826→}
   827→
   828→/**
   829→ * Full session detail data for session log show.
   830→ */
   831→export interface SessionLogDetail {
   832→  /** Session metadata */
   833→  id: string;
   834→  status: SessionStatus;
   835→  agent_type: string;
   836→  task_id?: string;
   837→  started_at: string;
   838→  ended_at?: string;
   839→  duration_ms: number;
   840→  /** Total event count */
   841→  event_count: number;
   842→  /** Total iteration count */
   843→  iteration_count: number;
   844→  /** Per-iteration summaries */
   845→  iterations: IterationSummary[];
   846→}
   847→
   848→/**
   849→ * Get iteration number from a context snapshot file.
   850→ */
   851→async function getIterationNumbers(
   852→  specDir: string,
   853→  sessionId: string,
   854→): Promise<number[]> {
   855→  const sessionDir = getSessionDir(specDir, sessionId);
   856→  try {
   857→    const entries = await fsPromises.readdir(sessionDir);
   858→    const iterations: number[] = [];
   859→    for (const entry of entries) {
   860→      const match = entry.match(/^context-iter-(\d+)\.json$/);
   861→      if (match) {
   862→        iterations.push(parseInt(match[1], 10));
   863→      }
   864→    }
   865→    return iterations.sort((a, b) => a - b);
   866→  } catch {
   867→    return [];
   868→  }
   869→}
   870→
   871→/**
   872→ * Extract task refs from task commands in event data.
   873→ */
   874→function extractTaskRef(command: string): string | null {
   875→  // Match patterns like: kspec task start @ref, kspec task complete @ref
   876→  const match = command.match(/@[\w-]+/);
   877→  return match ? match[0] : null;
   878→}
   879→
   880→/**
   881→ * Iteration boundary: a prompt.sent event with phase "task-work" that marks
   882→ * the start of a new iteration in a ralph session.
   883→ */
   884→interface IterationBoundary {
   885→  /** Array index in the events list */
   886→  index: number;
   887→  /** Iteration number from the event data */
   888→  iteration: number;
   889→}
   890→
   891→/**
   892→ * Find iteration boundaries from prompt.sent events with phase "task-work".
   893→ *
   894→ * Ralph emits these synchronously at the start of each iteration, so their
   895→ * array positions are reliable even when concurrent fire-and-forget events
   896→ * produce duplicate seq numbers.
   897→ *
   898→ * Returns validated, monotonically increasing boundaries.
   899→ */
   900→function findIterationBoundaries(events: SessionEvent[]): IterationBoundary[] {
   901→  const raw: IterationBoundary[] = [];
   902→
   903→  for (let i = 0; i < events.length; i++) {
   904→    const event = events[i];
   905→    if (event.type !== "prompt.sent") continue;
   906→
   907→    const data = event.data as {
   908→      phase?: string;
   909→      iteration?: number;
   910→    } | null;
   911→
   912→    if (
   913→      data?.phase !== "task-work" ||
   914→      typeof data?.iteration !== "number"
   915→    ) {
   916→      continue;
   917→    }
   918→
   919→    raw.push({ index: i, iteration: data.iteration });
   920→  }
   921→
   922→  // Validate: filter to monotonically increasing iteration numbers, deduplicate
   923→  const validated: IterationBoundary[] = [];
   924→  let lastIter = -Infinity;
   925→
   926→  for (const b of raw) {
   927→    if (b.iteration > lastIter) {
   928→      validated.push(b);
   929→      lastIter = b.iteration;
   930→    }
   931→  }
   932→
   933→  return validated;
   934→}
   935→
   936→/**
   937→ * Extract task start/complete refs from a slice of events.
   938→ */
   939→function extractTaskTransitions(events: SessionEvent[]): {
   940→  tasksStarted: string[];
   941→  tasksCompleted: string[];
   942→} {
   943→  const tasksStarted: string[] = [];
   944→  const tasksCompleted: string[] = [];
   945→
   946→  for (const event of events) {
   947→    if (event.type === "session.update") {
   948→      const data = event.data as {
   949→        update?: {
   950→          sessionUpdate?: string;
   951→          rawInput?: { command?: string };
   952→        };
   953→      } | null;
   954→      const command = data?.update?.rawInput?.command;
   955→      if (typeof command === "string") {
   956→        if (/\btask start\b/.test(command)) {
   957→          const ref = extractTaskRef(command);
   958→          if (ref) tasksStarted.push(ref);
   959→        } else if (/\btask complete\b/.test(command)) {
   960→          const ref = extractTaskRef(command);
   961→          if (ref) tasksCompleted.push(ref);
   962→        }
   963→      }
   964→    }
   965→  }
   966→
   967→  return { tasksStarted, tasksCompleted };
   968→}
   969→
   970→/**
   971→ * Legacy iteration grouping: groups events by their data.iteration field.
   972→ *
   973→ * Used as fallback for sessions that don't have prompt.sent boundary events
   974→ * with phase "task-work" (pre-boundary sessions or non-ralph sessions).
   975→ *
   976→ * AC: @session-log-show ac-2
   977→ */
   978→function legacyIterationGrouping(
   979→  events: SessionEvent[],
   980→  snapshotIterations: number[],
   981→): IterationSummary[] {
   982→  // Collect all iteration numbers from both snapshots and events
   983→  const allIterations = new Set<number>(snapshotIterations);
   984→  for (const event of events) {
   985→    const data = event.data as { iteration?: number } | null;
   986→    if (typeof data?.iteration === "number") {
   987→      allIterations.add(data.iteration);
   988→    }
   989→  }
   990→
   991→  // If no iterations found anywhere, synthesize iteration-0 only if events exist
   992→  if (allIterations.size === 0) {
   993→    if (events.length === 0) {
   994→      return [];
   995→    }
   996→    const { tasksStarted, tasksCompleted } = extractTaskTransitions(events);
   997→    return [
   998→      {
   999→        iteration: 0,
  1000→        event_count: events.length,
  1001→        tasks_started: tasksStarted,
  1002→        tasks_completed: tasksCompleted,
  1003→      },
  1004→    ];
  1005→  }
  1006→
  1007→  // Create buckets for all known iterations
  1008→  const iterations = Array.from(allIterations).sort((a, b) => a - b);
  1009→  const iterationMap = new Map<number, SessionEvent[]>();
  1010→  for (const n of iterations) {
  1011→    iterationMap.set(n, []);
  1012→  }
  1013→
  1014→  for (const event of events) {
  1015→    const data = event.data as { iteration?: number } | null;
  1016→    const iter = data?.iteration;
  1017→    if (typeof iter === "number" && iterationMap.has(iter)) {
  1018→      iterationMap.get(iter)!.push(event);
  1019→    } else {
  1020→      const fallbackIter = iterationMap.has(0) ? 0 : iterations[0];
  1021→      iterationMap.get(fallbackIter)!.push(event);
  1022→    }
  1023→  }
  1024→
  1025→  const summaries: IterationSummary[] = [];
  1026→  for (const [iterNum, iterEvents] of iterationMap) {
  1027→    const { tasksStarted, tasksCompleted } = extractTaskTransitions(iterEvents);
  1028→    summaries.push({
  1029→      iteration: iterNum,
  1030→      event_count: iterEvents.length,
  1031→      tasks_started: tasksStarted,
  1032→      tasks_completed: tasksCompleted,
  1033→    });
  1034→  }
  1035→
  1036→  return summaries.sort((a, b) => a.iteration - b.iteration);
  1037→}
  1038→
  1039→/**
  1040→ * Boundary-based iteration grouping: splits events by prompt.sent boundary
  1041→ * positions (array indices) instead of trusting data.iteration fields.
  1042→ *
  1043→ * This is resilient to producer-side bugs where concurrent fire-and-forget
  1044→ * event logging captures the wrong iteration number.
  1045→ *
  1046→ * AC: @session-log-show ac-10
  1047→ */
  1048→function boundaryIterationGrouping(
  1049→  events: SessionEvent[],
  1050→  boundaries: IterationBoundary[],
  1051→): IterationSummary[] {
  1052→  const summaries: IterationSummary[] = [];
  1053→
  1054→  for (let b = 0; b < boundaries.length; b++) {
  1055→    const startIdx = boundaries[b].index;
  1056→    const endIdx = b + 1 < boundaries.length ? boundaries[b + 1].index : events.length;
  1057→    const iterEvents = events.slice(startIdx, endIdx);
  1058→    const { tasksStarted, tasksCompleted } = extractTaskTransitions(iterEvents);
  1059→
  1060→    summaries.push({
  1061→      iteration: boundaries[b].iteration,
  1062→      event_count: iterEvents.length,
  1063→      tasks_started: tasksStarted,
  1064→      tasks_completed: tasksCompleted,
  1065→    });
  1066→  }
  1067→
  1068→  // Pre-boundary events (before the first prompt.sent) merge into first iteration
  1069→  if (boundaries.length > 0 && boundaries[0].index > 0) {
  1070→    const preBoundaryEvents = events.slice(0, boundaries[0].index);
  1071→    const { tasksStarted, tasksCompleted } = extractTaskTransitions(preBoundaryEvents);
  1072→    summaries[0].event_count += preBoundaryEvents.length;
  1073→    summaries[0].tasks_started = [...tasksStarted, ...summaries[0].tasks_started];
  1074→    summaries[0].tasks_completed = [...tasksCompleted, ...summaries[0].tasks_completed];
  1075→  }
  1076→
  1077→  return summaries;
  1078→}
  1079→
  1080→/**
  1081→ * Compute per-iteration summaries from events.
  1082→ *
  1083→ * Uses prompt.sent boundary events (phase: "task-work") when available for
  1084→ * accurate index-based grouping. Falls back to legacy data.iteration grouping
  1085→ * for sessions without boundaries.
  1086→ *
  1087→ * AC: @session-log-show ac-2, ac-10
  1088→ */
  1089→async function computeIterationSummaries(
  1090→  specDir: string,
  1091→  sessionId: string,
  1092→): Promise<IterationSummary[]> {
  1093→  const events = await readEvents(specDir, sessionId);
  1094→  const boundaries = findIterationBoundaries(events);
  1095→
  1096→  if (boundaries.length > 0) {
  1097→    return boundaryIterationGrouping(events, boundaries);
  1098→  }
  1099→
  1100→  // Legacy fallback: no prompt.sent boundaries with phase "task-work"
  1101→  const snapshotIterations = await getIterationNumbers(specDir, sessionId);
  1102→  return legacyIterationGrouping(events, snapshotIterations);
  1103→}
  1104→
  1105→/**
  1106→ * Count iterations using boundary-aware logic, without computing full summaries.
  1107→ *
  1108→ * For use in getSessionLogSummary() (session log list, session log stats) to
  1109→ * ensure iteration_count agrees with session log show.
  1110→ *
  1111→ * Falls back to counting context-iter-*.json files when no boundaries exist.
  1112→ */
  1113→async function countIterationsBoundaryAware(
  1114→  specDir: string,
  1115→  sessionId: string,
  1116→): Promise<number> {
  1117→  const events = await readEvents(specDir, sessionId);
  1118→  const boundaries = findIterationBoundaries(events);
  1119→
  1120→  if (boundaries.length > 0) {
  1121→    return boundaries.length;
  1122→  }
  1123→
  1124→  // Legacy fallback: count from context snapshots and event data
  1125→  const snapshotIterations = await getIterationNumbers(specDir, sessionId);
  1126→  const allIterations = new Set<number>(snapshotIterations);
  1127→  for (const event of events) {
  1128→    const data = event.data as { iteration?: number } | null;
  1129→    if (typeof data?.iteration === "number") {
  1130→      allIterations.add(data.iteration);
  1131→    }
  1132→  }
  1133→
  1134→  return allIterations.size || (events.length > 0 ? 1 : 0);
  1135→}
  1136→
  1137→/**
  1138→ * Get full session detail for session log show.
  1139→ *
  1140→ * @param specDir - The .kspec directory path
  1141→ * @param sessionId - Session ID (must be resolved first)
  1142→ * @returns Session detail or null if not found
  1143→ */
  1144→export async function getSessionLogDetail(
  1145→  specDir: string,
  1146→  sessionId: string,
  1147→): Promise<SessionLogDetail | null> {
  1148→  const metadata = await getSession(specDir, sessionId);
  1149→  if (!metadata) return null;
  1150→
  1151→  const [eventCount, iterations] = await Promise.all([
  1152→    countEventLines(specDir, sessionId),
  1153→    computeIterationSummaries(specDir, sessionId),
  1154→  ]);
  1155→
  1156→  const startMs = new Date(metadata.started_at).getTime();
  1157→  const endMs = metadata.ended_at
  1158→    ? new Date(metadata.ended_at).getTime()
  1159→    : Date.now();
  1160→  const durationMs = endMs - startMs;
  1161→
  1162→  return {
  1163→    id: metadata.id,
  1164→    status: metadata.status,
  1165→    agent_type: metadata.agent_type,
  1166→    task_id: metadata.task_id,
  1167→    started_at: metadata.started_at,
  1168→    ended_at: metadata.ended_at,
  1169→    duration_ms: durationMs,
  1170→    event_count: eventCount,
  1171→    iteration_count: iterations.length,
  1172→    iterations,
  1173→  };
  1174→}
  1175→
  1176→// ─── Session Log Stats ───────────────────────────────────────────────────────
  1177→
  1178→/**
  1179→ * Aggregate session statistics.
  1180→ *
  1181→ * AC: @session-log-stats ac-1, ac-2, ac-3
  1182→ */
  1183→export interface SessionLogStats {
  1184→  /** Total number of sessions */
  1185→  total_sessions: number;
  1186→  /** Total events across all sessions */
  1187→  total_events: number;
  1188→  /** Total iterations across all sessions */
  1189→  total_iterations: number;
  1190→  /** Total tasks completed across all sessions */
  1191→  total_tasks_completed: number;
  1192→  /** Total duration in milliseconds */
  1193→  total_duration_ms: number;
  1194→
  1195→  /** Average duration per session in milliseconds */
  1196→  avg_duration_ms: number;
  1197→  /** Average iterations per session */
  1198→  avg_iterations_per_session: number;
  1199→  /** Average tasks completed per session */
  1200→  avg_tasks_per_session: number;
  1201→
  1202→  /** Status breakdown with counts and percentages */
  1203→  status_breakdown: {
  1204→    status: SessionStatus;
  1205→    count: number;
  1206→    percentage: number;
  1207→  }[];
  1208→}
  1209→
  1210→/**
  1211→ * Tool usage statistics.
  1212→ *
  1213→ * AC: @session-log-stats ac-6
  1214→ */
  1215→export interface ToolUsageStats {
  1216→  tool_name: string;
  1217→  count: number;
  1218→  percentage: number;
  1219→}
  1220→
  1221→/**
  1222→ * Time period stats for --by-day or --by-week.
  1223→ *
  1224→ * AC: @session-log-stats ac-7
  1225→ */
  1226→export interface TimePeriodStats {
  1227→  period: string;
  1228→  sessions_count: number;
  1229→  tasks_completed: number;
  1230→  total_duration_ms: number;
  1231→}
  1232→
  1233→/**
  1234→ * Compute aggregate statistics from session summaries.
  1235→ *
  1236→ * @param summaries - Array of session log summaries
  1237→ * @returns Aggregate statistics
  1238→ */
  1239→export function computeSessionLogStats(
  1240→  summaries: SessionLogSummary[],
  1241→): SessionLogStats {
  1242→  if (summaries.length === 0) {
  1243→    return {
  1244→      total_sessions: 0,
  1245→      total_events: 0,
  1246→      total_iterations: 0,
  1247→      total_tasks_completed: 0,
  1248→      total_duration_ms: 0,
  1249→      avg_duration_ms: 0,
  1250→      avg_iterations_per_session: 0,
  1251→      avg_tasks_per_session: 0,
  1252→      status_breakdown: [],
  1253→    };
  1254→  }
  1255→
  1256→  // Compute totals
  1257→  let totalEvents = 0;
  1258→  let totalIterations = 0;
  1259→  let totalTasksCompleted = 0;
  1260→  let totalDuration = 0;
  1261→  const statusCounts: Record<SessionStatus, number> = {
  1262→    active: 0,
  1263→    completed: 0,
  1264→    abandoned: 0,
  1265→  };
  1266→
  1267→  for (const s of summaries) {
  1268→    totalEvents += s.event_count;
  1269→    totalIterations += s.iteration_count;
  1270→    totalTasksCompleted += s.tasks_completed;
  1271→    totalDuration += s.duration_ms;
  1272→    statusCounts[s.status] = (statusCounts[s.status] || 0) + 1;
  1273→  }
  1274→
  1275→  const n = summaries.length;
  1276→
  1277→  // Build status breakdown
  1278→  const statusBreakdown: { status: SessionStatus; count: number; percentage: number }[] = [];
  1279→  for (const status of ["completed", "active", "abandoned"] as SessionStatus[]) {
  1280→    const count = statusCounts[status] || 0;
  1281→    if (count > 0) {
  1282→      statusBreakdown.push({
  1283→        status,
  1284→        count,
  1285→        percentage: Math.round((count / n) * 100 * 10) / 10, // 1 decimal place
  1286→      });
  1287→    }
  1288→  }
  1289→
  1290→  return {
  1291→    total_sessions: n,
  1292→    total_events: totalEvents,
  1293→    total_iterations: totalIterations,
  1294→    total_tasks_completed: totalTasksCompleted,
  1295→    total_duration_ms: totalDuration,
  1296→    avg_duration_ms: Math.round(totalDuration / n),
  1297→    avg_iterations_per_session: Math.round((totalIterations / n) * 10) / 10,
  1298→    avg_tasks_per_session: Math.round((totalTasksCompleted / n) * 10) / 10,
  1299→    status_breakdown: statusBreakdown,
  1300→  };
  1301→}
  1302→
  1303→/**
  1304→ * Count tool calls by scanning events.jsonl for tool_call events.
  1305→ *
  1306→ * This is relatively expensive as it parses all events, so only call
  1307→ * when --tool-usage is requested.
  1308→ *
  1309→ * AC: @session-log-stats ac-6
  1310→ */
  1311→export async function computeToolUsageStats(
  1312→  specDir: string,
  1313→  sessionIds: string[],
  1314→  limit: number = 10,
  1315→): Promise<ToolUsageStats[]> {
  1316→  const toolCounts: Record<string, number> = {};
  1317→  let totalToolCalls = 0;
  1318→
  1319→  for (const sessionId of sessionIds) {
  1320→    const eventsPath = getSessionEventsPath(specDir, sessionId);
  1321→    try {
  1322→      const content = await fsPromises.readFile(eventsPath, "utf-8");
  1323→      if (!content.trim()) continue;
  1324→      const lines = content.trim().split("\n");
  1325→      // Track seen toolCallIds to deduplicate phased events
  1326→      const seenToolCallIds = new Set<string>();
  1327→      for (const line of lines) {
  1328→        // Quick pre-filter: only parse lines that might be tool_call events
  1329→        if (!line.includes('"tool_call"')) continue;
  1330→        try {
  1331→          const event = JSON.parse(line);
  1332→          if (event?.type === "session.update") {
  1333→            const update = event?.data?.update;
  1334→            if (update?.sessionUpdate === "tool_call") {
  1335→              // Deduplicate phased tool_call events by toolCallId
  1336→              const toolCallId = update?.toolCallId || update?.tool_call_id || update?.id;
  1337→              if (toolCallId && seenToolCallIds.has(toolCallId)) continue;
  1338→              if (toolCallId) seenToolCallIds.add(toolCallId);
  1339→              const toolName = update?._meta?.claudeCode?.toolName || "unknown";
  1340→              toolCounts[toolName] = (toolCounts[toolName] || 0) + 1;
  1341→              totalToolCalls++;
  1342→            }
  1343→          }
  1344→        } catch {
  1345→          // Skip unparseable lines
  1346→        }
  1347→      }
  1348→    } catch {
  1349→      // Skip sessions without events
  1350→    }
  1351→  }
  1352→
  1353→  // Sort by count descending, take top N
  1354→  const sorted = Object.entries(toolCounts)
  1355→    .map(([tool_name, count]) => ({
  1356→      tool_name,
  1357→      count,
  1358→      percentage: totalToolCalls > 0
  1359→        ? Math.round((count / totalToolCalls) * 100 * 10) / 10
  1360→        : 0,
  1361→    }))
  1362→    .sort((a, b) => b.count - a.count)
  1363→    .slice(0, limit);
  1364→
  1365→  return sorted;
  1366→}
  1367→
  1368→/**
  1369→ * Compute ISO-8601 week number and week-year in UTC.
  1370→ *
  1371→ * ISO-8601 rules:
  1372→ * - Week 1 contains the first Thursday of the year
  1373→ * - Week starts on Monday
  1374→ * - Week-year may differ from calendar year at year boundaries
  1375→ *
  1376→ * Returns [weekYear, weekNumber] tuple.
  1377→ */
  1378→function getISOWeekUTC(date: Date): [number, number] {
  1379→  // Clone and normalize to UTC midnight
  1380→  const d = new Date(Date.UTC(
  1381→    date.getUTCFullYear(),
  1382→    date.getUTCMonth(),
  1383→    date.getUTCDate()
  1384→  ));
  1385→
  1386→  // Get day of week (ISO: Monday=1, Sunday=7)
  1387→  const dayOfWeek = d.getUTCDay() || 7;
  1388→
  1389→  // Set to nearest Thursday (determines week-year)
  1390→  d.setUTCDate(d.getUTCDate() + 4 - dayOfWeek);
  1391→
  1392→  // Week-year is the year of this Thursday
  1393→  const weekYear = d.getUTCFullYear();
  1394→
  1395→  // January 4 is always in week 1 (as it's in the first week with a Thursday)
  1396→  const jan4 = new Date(Date.UTC(weekYear, 0, 4));
  1397→  const jan4DayOfWeek = jan4.getUTCDay() || 7;
  1398→
  1399→  // Start of week 1 (Monday before or on Jan 4)
  1400→  const week1Start = new Date(jan4);
  1401→  week1Start.setUTCDate(jan4.getUTCDate() - (jan4DayOfWeek - 1));
  1402→
  1403→  // Week number = weeks between week 1 start and the Thursday we found
  1404→  const weekNum = Math.floor((d.getTime() - week1Start.getTime()) / (7 * 24 * 60 * 60 * 1000)) + 1;
  1405→
  1406→  return [weekYear, weekNum];
  1407→}
  1408→
  1409→/**
  1410→ * Group sessions by time period (day or week).
  1411→ *
  1412→ * AC: @session-log-stats ac-7
  1413→ */
  1414→export function computeTimePeriodStats(
  1415→  summaries: SessionLogSummary[],
  1416→  groupBy: "day" | "week",
  1417→): TimePeriodStats[] {
  1418→  const buckets: Record<string, { sessions: number; tasks: number; duration: number }> = {};
  1419→
  1420→  for (const s of summaries) {
  1421→    const date = new Date(s.started_at);
  1422→    let period: string;
  1423→
  1424→    if (groupBy === "day") {
  1425→      period = date.toISOString().split("T")[0]; // YYYY-MM-DD in UTC
  1426→    } else {
  1427→      // Week: use ISO-8601 week format (YYYY-Www) in UTC
  1428→      const [weekYear, weekNum] = getISOWeekUTC(date);
  1429→      period = `${weekYear}-W${weekNum.toString().padStart(2, "0")}`;
  1430→    }
  1431→
  1432→    if (!buckets[period]) {
  1433→      buckets[period] = { sessions: 0, tasks: 0, duration: 0 };
  1434→    }
  1435→    buckets[period].sessions += 1;
  1436→    buckets[period].tasks += s.tasks_completed;
  1437→    buckets[period].duration += s.duration_ms;
  1438→  }
  1439→
  1440→  // Convert to array and sort by period (newest first for display)
  1441→  const result: TimePeriodStats[] = Object.entries(buckets)
  1442→    .map(([period, data]) => ({
  1443→      period,
  1444→      sessions_count: data.sessions,
  1445→      tasks_completed: data.tasks,
  1446→      total_duration_ms: data.duration,
  1447→    }))
  1448→    .sort((a, b) => b.period.localeCompare(a.period));
  1449→
  1450→  return result;
  1451→}
  1452→
  1453→// ─── Session Log Search ───────────────────────────────────────────────────────
  1454→
  1455→/**
  1456→ * A single search match result.
  1457→ *
  1458→ * AC: @session-log-search ac-4
  1459→ */
  1460→export interface SearchMatch {
  1461→  /** Session ID */
  1462→  session_id: string;
  1463→  /** Event timestamp (Unix ms) */
  1464→  timestamp: number;
  1465→  /** Event type */
  1466→  event_type: string;
  1467→  /** Matching content excerpt (limited to 200 chars) */
  1468→  content_excerpt: string;
  1469→}
  1470→
  1471→/**
  1472→ * Search results grouped by session.
  1473→ */
  1474→export interface SessionSearchResult {
  1475→  /** Session ID */
  1476→  session_id: string;
  1477→  /** Agent type for this session */
  1478→  agent_type: string;
  1479→  /** When the session started */
  1480→  started_at: string;
  1481→  /** Matches found in this session */
  1482→  matches: SearchMatch[];
  1483→}
  1484→
  1485→/**
  1486→ * Search options for filtering sessions and events.
  1487→ */
  1488→export interface SearchOptions {
  1489→  /** Only search events of this type (e.g., 'session.update', 'prompt.sent') */
  1490→  eventType?: string;
  1491→  /** Only search sessions started after this date */
  1492→  sinceDate?: Date;
  1493→  /** Only search sessions with this agent type */
  1494→  agentType?: string;
  1495→  /** Maximum total matches to return (default: 50) */
  1496→  limit?: number;
  1497→}
  1498→
  1499→/**
  1500→ * Extract a content excerpt around a match, limited to maxLength chars.
  1501→ *
  1502→ * AC: @session-log-search ac-4
  1503→ */
  1504→function extractContentExcerpt(
  1505→  data: unknown,
  1506→  pattern: string,
  1507→  maxLength: number = 200,
  1508→): string {
  1509→  // Stringify the data for searching
  1510→  const str = JSON.stringify(data);
  1511→  const lowerStr = str.toLowerCase();
  1512→  const lowerPattern = pattern.toLowerCase();
  1513→
  1514→  const matchIndex = lowerStr.indexOf(lowerPattern);
  1515→  if (matchIndex === -1) {
  1516→    // Shouldn't happen since we pre-filtered, but return start of content
  1517→    return str.length > maxLength ? str.slice(0, maxLength - 3) + "..." : str;
  1518→  }
  1519→
  1520→  // Calculate excerpt window centered on match
  1521→  const matchLen = pattern.length;
  1522→  const contextBefore = Math.floor((maxLength - matchLen) / 2);
  1523→  const start = Math.max(0, matchIndex - contextBefore);
  1524→  const end = Math.min(str.length, start + maxLength);
  1525→
  1526→  let excerpt = str.slice(start, end);
  1527→
  1528→  // Add ellipsis indicators
  1529→  if (start > 0) {
  1530→    excerpt = "..." + excerpt.slice(3);
  1531→  }
  1532→  if (end < str.length) {
  1533→    excerpt = excerpt.slice(0, -3) + "...";
  1534→  }
  1535→
  1536→  return excerpt;
  1537→}
  1538→
  1539→/**
  1540→ * Search across session events for a pattern.
  1541→ *
  1542→ * This streams through events.jsonl files, applying filters as early as possible
  1543→ * for performance. Sessions are pre-filtered by metadata (--since, --agent) before
  1544→ * scanning events to reduce I/O.
  1545→ *
  1546→ * AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7
  1547→ *
  1548→ * @param specDir - The .kspec directory path
  1549→ * @param pattern - Case-insensitive substring to search for
  1550→ * @param options - Search filtering options
  1551→ * @returns Array of search results grouped by session
  1552→ */
  1553→export async function searchSessionEvents(
  1554→  specDir: string,
  1555→  pattern: string,
  1556→  options: SearchOptions = {},
  1557→): Promise<SessionSearchResult[]> {
  1558→  // Defense-in-depth: normalize limit to a valid positive integer
  1559→  const rawLimit = options.limit ?? 50;
  1560→  const limit = Number.isNaN(rawLimit) || rawLimit <= 0 ? 50 : rawLimit;
  1561→  const lowerPattern = pattern.toLowerCase();
  1562→
  1563→  // Get all session summaries for metadata filtering
  1564→  const allSummaries = await getAllSessionLogSummaries(specDir);
  1565→
  1566→  // AC: @session-log-search ac-3 - Pre-filter by --since
  1567→  let filteredSummaries = allSummaries;
  1568→  if (options.sinceDate) {
  1569→    filteredSummaries = filteredSummaries.filter(
  1570→      (s) => new Date(s.started_at) >= options.sinceDate!,
  1571→    );
  1572→  }
  1573→
  1574→  // AC: @session-log-search ac-7 - Pre-filter by --agent
  1575→  if (options.agentType) {
  1576→    filteredSummaries = filteredSummaries.filter(
  1577→      (s) => s.agent_type === options.agentType,
  1578→    );
  1579→  }
  1580→
  1581→  const results: SessionSearchResult[] = [];
  1582→  let totalMatches = 0;
  1583→
  1584→  for (const summary of filteredSummaries) {
  1585→    if (totalMatches >= limit) break;
  1586→
  1587→    const eventsPath = getSessionEventsPath(specDir, summary.id);
  1588→    let content: string;
  1589→    try {
  1590→      content = await fsPromises.readFile(eventsPath, "utf-8");
  1591→    } catch {
  1592→      continue; // Skip sessions without events
  1593→    }
  1594→
  1595→    if (!content.trim()) continue;
  1596→
  1597→    const matches: SearchMatch[] = [];
  1598→    const lines = content.trim().split("\n");
  1599→    // Track seen tool_call IDs to skip phased duplicates
  1600→    const seenToolCallIds = new Set<string>();
  1601→
  1602→    for (const line of lines) {
  1603→      if (totalMatches >= limit) break;
  1604→
  1605→      // Quick substring pre-filter before parsing JSON
  1606→      if (!line.toLowerCase().includes(lowerPattern)) continue;
  1607→
  1608→      try {
  1609→        const event = JSON.parse(line);
  1610→
  1611→        // AC: @session-log-search ac-2 - Filter by event type
  1612→        if (options.eventType && event.type !== options.eventType) continue;
  1613→
  1614→        // Deduplicate phased tool_call events
  1615→        if (event?.type === "session.update") {
  1616→          const update = event?.data?.update;
  1617→          if (update?.sessionUpdate === "tool_call") {
  1618→            const toolCallId = update?.toolCallId || update?.tool_call_id || update?.id;
  1619→            if (toolCallId) {
  1620→              if (seenToolCallIds.has(toolCallId)) continue;
  1621→              seenToolCallIds.add(toolCallId);
  1622→            }
  1623→          }
  1624→        }
  1625→
  1626→        // Verify match in stringified data (not just line, in case pattern appears in metadata)
  1627→        const dataStr = JSON.stringify(event.data);
  1628→        if (!dataStr.toLowerCase().includes(lowerPattern)) continue;
  1629→
  1630→        // AC: @session-log-search ac-4 - Create match with excerpt
  1631→        matches.push({
  1632→          session_id: summary.id,
  1633→          timestamp: event.ts,
  1634→          event_type: event.type,
  1635→          content_excerpt: extractContentExcerpt(event.data, pattern, 200),
  1636→        });
  1637→        totalMatches++;
  1638→      } catch {
  1639→        // Skip unparseable lines
  1640→      }
  1641→    }
  1642→
  1643→    if (matches.length > 0) {
  1644→      results.push({
  1645→        session_id: summary.id,
  1646→        agent_type: summary.agent_type,
  1647→        started_at: summary.started_at,
  1648→        matches,
  1649→      });
  1650→    }
  1651→  }
  1652→
  1653→  return results;
  1654→}
  1655→
  1656→// ─── Session Creation with Budget ─────────────────────────────────────────────
  1657→
  1658→/**
  1659→ * Create a session with an optional task budget in one call.
  1660→ *
  1661→ * This is the library-level entry point for session creation. It creates
  1662→ * the session directory, writes session.yaml, and optionally writes budget.json.
  1663→ * Returns metadata without any console output.
  1664→ *
  1665→ * AC: @session-creation-and-env-injection ac-create
  1666→ * AC: @session-creation-and-env-injection ac-budget
  1667→ * AC: @session-creation-and-env-injection ac-budget-local
  1668→ * AC: @session-creation-and-env-injection ac-library
  1669→ *
  1670→ * @param specDir - The .kspec directory path
  1671→ * @param input - Session creation parameters
  1672→ * @returns Session metadata and optional budget (no console output)
  1673→ */
  1674→export async function createSessionWithBudget(
  1675→  specDir: string,
  1676→  input: {
  1677→    id: string;
  1678→    agent_type: string;
  1679→    task_id?: string;
  1680→    budget?: number;
  1681→  },
  1682→): Promise<{
  1683→  session_id: string;
  1684→  session: SessionMetadata;
  1685→  budget: TaskBudget | null;
  1686→}> {
  1687→  // Create session
  1688→  const session = await createSession(specDir, {
  1689→    id: input.id,
  1690→    agent_type: input.agent_type,
  1691→    task_id: input.task_id,
  1692→  });
  1693→
  1694→  // Optionally create budget
  1695→  let budget: TaskBudget | null = null;
  1696→  if (input.budget !== undefined && input.budget > 0) {
  1697→    budget = await createBudget(specDir, input.id, input.budget);
  1698→  }
  1699→
  1700→  return {
  1701→    session_id: input.id,
  1702→    session,
  1703→    budget,
  1704→  };
  1705→}
  1706→
  1707→// ─── Environment Injection ────────────────────────────────────────────────────
  1708→
  1709→/**
  1710→ * Result of environment injection attempt.
  1711→ */
  1712→export interface EnvInjectionResult {
  1713→  /** Whether injection was performed */
  1714→  injected: boolean;
  1715→  /** Method used for injection */
  1716→  method: "claude_env_file" | "claude_settings" | "codex_config" | "fallback";
  1717→  /** Human-readable description of what was done */
  1718→  description: string;
  1719→  /** Path to file modified (if applicable) */
  1720→  path?: string;
  1721→}
  1722→
  1723→/**
  1724→ * Inject KSPEC_SESSION_ID into Claude Code environment.
  1725→ *
  1726→ * Strategy:
  1727→ * 1. If CLAUDE_ENV_FILE is set, write to that file
  1728→ * 2. Otherwise, append to project .claude/settings.json env section
  1729→ *
  1730→ * AC: @session-creation-and-env-injection ac-inject-claude
  1731→ */
  1732→export async function injectClaudeCodeEnv(
  1733→  sessionId: string,
  1734→): Promise<EnvInjectionResult> {
  1735→  const envFile = process.env.CLAUDE_ENV_FILE;
  1736→
  1737→  if (envFile) {
  1738→    // Write to CLAUDE_ENV_FILE
  1739→    const line = `KSPEC_SESSION_ID=${sessionId}\n`;
  1740→    // Read existing content and append/replace
  1741→    let content = "";
  1742→    try {
  1743→      content = await fsPromises.readFile(envFile, "utf-8");
  1744→    } catch {
  1745→      // File doesn't exist yet, that's fine
  1746→    }
  1747→
  1748→    // Replace existing KSPEC_SESSION_ID line or append
  1749→    const lines = content.split("\n");
  1750→    const existingIdx = lines.findIndex((l) =>
  1751→      l.startsWith("KSPEC_SESSION_ID="),
  1752→    );
  1753→    if (existingIdx >= 0) {
  1754→      lines[existingIdx] = `KSPEC_SESSION_ID=${sessionId}`;
  1755→    } else {
  1756→      // Append before final empty line if present
  1757→      if (lines.length > 0 && lines[lines.length - 1] === "") {
  1758→        lines.splice(lines.length - 1, 0, `KSPEC_SESSION_ID=${sessionId}`);
  1759→      } else {
  1760→        lines.push(`KSPEC_SESSION_ID=${sessionId}`);
  1761→      }
  1762→    }
  1763→
  1764→    await fsPromises.writeFile(envFile, lines.join("\n"), "utf-8");
  1765→    return {
  1766→      injected: true,
  1767→      method: "claude_env_file",
  1768→      description: `Wrote KSPEC_SESSION_ID=${sessionId} to CLAUDE_ENV_FILE`,
  1769→      path: envFile,
  1770→    };
  1771→  }
  1772→
  1773→  // Fallback: write to project .claude/settings.json
  1774→  const settingsDir = path.join(process.cwd(), ".claude");
  1775→  const settingsPath = path.join(settingsDir, "settings.json");
  1776→
  1777→  await fsPromises.mkdir(settingsDir, { recursive: true });
  1778→
  1779→  let settings: Record<string, unknown> = {};
  1780→  try {
  1781→    const content = await fsPromises.readFile(settingsPath, "utf-8");
  1782→    settings = JSON.parse(content);
  1783→  } catch (err: unknown) {
  1784→    // Only start fresh for ENOENT; throw on parse errors to avoid overwriting
  1785→    if (err instanceof Error && "code" in err && err.code === "ENOENT") {
  1786→      // File doesn't exist, start fresh
  1787→    } else {
  1788→      throw new Error(
  1789→        `Cannot inject env: .claude/settings.json exists but is not valid JSON. ` +
  1790→        `Fix the file manually or remove it, then retry.`,
  1791→      );
  1792→    }
  1793→  }
  1794→
  1795→  // Ensure env section exists
  1796→  if (!settings.env || typeof settings.env !== "object") {
  1797→    settings.env = {};
  1798→  }
  1799→  (settings.env as Record<string, string>).KSPEC_SESSION_ID = sessionId;
  1800→
  1801→  await fsPromises.writeFile(
  1802→    settingsPath,
  1803→    JSON.stringify(settings, null, 2) + "\n",
  1804→    "utf-8",
  1805→  );
  1806→
  1807→  return {
  1808→    injected: true,
  1809→    method: "claude_settings",
  1810→    description: `Added KSPEC_SESSION_ID to .claude/settings.json env section`,
  1811→    path: settingsPath,
  1812→  };
  1813→}
  1814→
  1815→/**
  1816→ * Inject KSPEC_SESSION_ID into Codex CLI environment.
  1817→ *
  1818→ * Adds to shell_environment_policy.set in codex config.
  1819→ *
  1820→ * AC: @session-creation-and-env-injection ac-inject-codex
  1821→ */
  1822→export async function injectCodexEnv(
  1823→  sessionId: string,
  1824→): Promise<EnvInjectionResult> {
  1825→  const configDir = path.join(
  1826→    process.env.HOME || process.env.USERPROFILE || "",
  1827→    ".codex",
  1828→  );
  1829→  const configPath = path.join(configDir, "config.json");
  1830→
  1831→  await fsPromises.mkdir(configDir, { recursive: true });
  1832→
  1833→  let config: Record<string, unknown> = {};
  1834→  try {
  1835→    const content = await fsPromises.readFile(configPath, "utf-8");
  1836→    config = JSON.parse(content);
  1837→  } catch (err: unknown) {
  1838→    // Only start fresh for ENOENT; throw on parse errors to avoid overwriting
  1839→    if (err instanceof Error && "code" in err && err.code === "ENOENT") {
  1840→      // File doesn't exist, start fresh
  1841→    } else {
  1842→      throw new Error(
  1843→        `Cannot inject env: ~/.codex/config.json exists but is not valid JSON. ` +
  1844→        `Fix the file manually or remove it, then retry.`,
  1845→      );
  1846→    }
  1847→  }
  1848→
  1849→  // Ensure shell_environment_policy.set exists
  1850→  if (
  1851→    !config.shell_environment_policy ||
  1852→    typeof config.shell_environment_policy !== "object"
  1853→  ) {
  1854→    config.shell_environment_policy = {};
  1855→  }
  1856→  const policy = config.shell_environment_policy as Record<string, unknown>;
  1857→  if (!policy.set || typeof policy.set !== "object") {
  1858→    policy.set = {};
  1859→  }
  1860→  (policy.set as Record<string, string>).KSPEC_SESSION_ID = sessionId;
  1861→
  1862→  await fsPromises.writeFile(
  1863→    configPath,
  1864→    JSON.stringify(config, null, 2) + "\n",
  1865→    "utf-8",
  1866→  );
  1867→
  1868→  return {
  1869→    injected: true,
  1870→    method: "codex_config",
  1871→    description: `Added KSPEC_SESSION_ID to Codex config shell_environment_policy.set`,
  1872→    path: configPath,
  1873→  };
  1874→}
  1875→
  1876→/**
  1877→ * Get fallback injection instructions for unknown agent harnesses.
  1878→ *
  1879→ * AC: @session-creation-and-env-injection ac-inject-fallback
  1880→ */
  1881→export function getFallbackInjectionInstructions(
  1882→  sessionId: string,
  1883→): EnvInjectionResult {
  1884→  return {
  1885→    injected: false,
  1886→    method: "fallback",
  1887→    description: `export KSPEC_SESSION_ID=${sessionId}`,
  1888→  };
  1889→}
  1890→
  1891→// ─── Session Validation ───────────────────────────────────────────────────────
  1892→
  1893→/**
  1894→ * Validate that the current KSPEC_SESSION_ID points to a valid session.
  1895→ *
  1896→ * AC: @session-creation-and-env-injection ac-invalid-session
  1897→ *
  1898→ * @param specDir - The .kspec directory path
  1899→ * @param sessionId - The session ID to validate
  1900→ * @returns Validation result with error details if invalid
  1901→ */
  1902→export async function validateSessionId(
  1903→  specDir: string,
  1904→  sessionId: string,
  1905→): Promise<{
  1906→  valid: boolean;
  1907→  session?: SessionMetadata;
  1908→  error?: string;
  1909→  suggestion?: string;
  1910→}> {
  1911→  // Check if session directory exists
  1912→  const exists = await sessionExists(specDir, sessionId);
  1913→  if (!exists) {
  1914→    return {
  1915→      valid: false,
  1916→      error: `Session not found: ${sessionId}`,
  1917→      suggestion: `Unset KSPEC_SESSION_ID or create a new session with: kspec session create --agent-type <type>`,
  1918→    };
  1919→  }
  1920→
  1921→  // Try to read and validate session metadata
  1922→  const session = await getSession(specDir, sessionId);
  1923→  if (!session) {
  1924→    return {
  1925→      valid: false,
  1926→      error: `Session metadata is corrupt or unreadable: ${sessionId}`,
  1927→      suggestion: `Unset KSPEC_SESSION_ID or create a new session with: kspec session create --agent-type <type>`,
  1928→    };
  1929→  }
  1930→
  1931→  return { valid: true, session };
  1932→}
  1933→
  1934→// ─── Task Budget ──────────────────────────────────────────────────────────────
  1935→
  1936→/**
  1937→ * Atomic JSON write — write to temp file then rename in same directory.
  1938→ * Prevents corruption on crash.
  1939→ * AC: @task-budget-enforcement ac-atomic-write
  1940→ */
  1941→async function writeBudgetAtomic(
  1942→  filePath: string,
  1943→  budget: TaskBudget,
  1944→): Promise<void> {
  1945→  const dir = path.dirname(filePath);
  1946→  await fsPromises.mkdir(dir, { recursive: true });
  1947→  const tmpPath = `${filePath}.${process.pid}.tmp`;
  1948→  const content = JSON.stringify(budget, null, 2) + "\n";
  1949→  await fsPromises.writeFile(tmpPath, content, "utf-8");
  1950→  await fsPromises.rename(tmpPath, filePath);
  1951→}
  1952→
  1953→/**
  1954→ * Create a budget for a session.
  1955→ *
  1956→ * Writes budget.json to .kspec/sessions/{id}/ on the local filesystem
  1957→ * (NOT committed to shadow branch).
  1958→ *
  1959→ * AC: @session-creation-and-env-injection ac-budget
  1960→ * AC: @session-creation-and-env-injection ac-budget-local
  1961→ *
  1962→ * @param specDir - The .kspec directory path
  1963→ * @param sessionId - Session ID
  1964→ * @param maxPerCycle - Maximum tasks allowed per cycle
  1965→ * @returns The created budget
  1966→ */
  1967→export async function createBudget(
  1968→  specDir: string,
  1969→  sessionId: string,
  1970→  maxPerCycle: number,
  1971→): Promise<TaskBudget> {
  1972→  const budget: TaskBudget = {
  1973→    max_per_cycle: maxPerCycle,
  1974→    started_this_cycle: 0,
  1975→  };
  1976→  const validated = TaskBudgetSchema.parse(budget);
  1977→  const budgetPath = getSessionBudgetPath(specDir, sessionId);
  1978→  await writeBudgetAtomic(budgetPath, validated);
  1979→  return validated;
  1980→}
  1981→
  1982→/**
  1983→ * Read budget for a session.
  1984→ *
  1985→ * AC: @task-budget-enforcement ac-no-budget
  1986→ *
  1987→ * @param specDir - The .kspec directory path
  1988→ * @param sessionId - Session ID
  1989→ * @returns Budget or null if no budget configured (opt-in)
  1990→ */
  1991→export async function getBudget(
  1992→  specDir: string,
  1993→  sessionId: string,
  1994→): Promise<TaskBudget | null> {
  1995→  const budgetPath = getSessionBudgetPath(specDir, sessionId);
  1996→  let content: string;
  1997→  try {
  1998→    content = await fsPromises.readFile(budgetPath, "utf-8");
  1999→  } catch (err: unknown) {
  2000→    // File doesn't exist = no budget configured (opt-in)
  2001→    if (err instanceof Error && "code" in err && err.code === "ENOENT") {
  2002→      return null;
  2003→    }
  2004→    throw err;
  2005→  }
  2006→  // File exists — parse errors are real failures, not "no budget"
  2007→  const raw = JSON.parse(content);
  2008→  return TaskBudgetSchema.parse(raw);
  2009→}
  2010→
  2011→/**
  2012→ * Check whether the budget allows starting a new task.
  2013→ *
  2014→ * Returns an object with `allowed` boolean and context about the budget.
  2015→ * When no budget is configured, always allows (opt-in behavior).
  2016→ *
  2017→ * AC: @task-budget-enforcement ac-block-start
  2018→ * AC: @task-budget-enforcement ac-no-budget
  2019→ * AC: @task-budget-enforcement ac-no-session
  2020→ *
  2021→ * @param specDir - The .kspec directory path
  2022→ * @param sessionId - Session ID, or undefined if KSPEC_SESSION_ID not set
  2023→ * @returns Budget check result
  2024→ */
  2025→export async function checkBudget(
  2026→  specDir: string,
  2027→  sessionId: string | undefined,
  2028→): Promise<{
  2029→  allowed: boolean;
  2030→  reason?: string;
  2031→  budget?: TaskBudget;
  2032→}> {
  2033→  // AC: @task-budget-enforcement ac-no-session — no session means no check
  2034→  if (!sessionId) {
  2035→    return { allowed: true };
  2036→  }
  2037→
  2038→  const budget = await getBudget(specDir, sessionId);
  2039→
  2040→  // AC: @task-budget-enforcement ac-no-budget — no budget means no check
  2041→  if (!budget) {
  2042→    return { allowed: true };
  2043→  }
  2044→
  2045→  if (budget.started_this_cycle >= budget.max_per_cycle) {
  2046→    return {
  2047→      allowed: false,
  2048→      reason: `Task budget exhausted: ${budget.started_this_cycle}/${budget.max_per_cycle} tasks started this cycle. Wrap up current work and let the iteration end naturally without starting new tasks.`,
  2049→      budget,
  2050→    };
  2051→  }
  2052→
  2053→  return { allowed: true, budget };
  2054→}
  2055→
  2056→/**
  2057→ * Increment the budget counter after a task is successfully started.
  2058→ *
  2059→ * IMPORTANT: Callers must NOT call this for resume cases (task already
  2060→ * in_progress). The budget should only be incremented when a new task
  2061→ * transitions to in_progress, not when resuming an existing one.
  2062→ * See AC: @task-budget-enforcement ac-resume-no-increment
  2063→ *
  2064→ * AC: @task-budget-enforcement ac-increment
  2065→ * AC: @task-budget-enforcement ac-atomic-write
  2066→ *
  2067→ * @param specDir - The .kspec directory path
  2068→ * @param sessionId - Session ID
  2069→ * @returns Updated budget, or null if no budget configured
  2070→ */
  2071→export async function incrementBudget(
  2072→  specDir: string,
  2073→  sessionId: string,
  2074→): Promise<TaskBudget | null> {
  2075→  const budget = await getBudget(specDir, sessionId);
  2076→  if (!budget) {
  2077→    return null;
  2078→  }
  2079→
  2080→  const updated: TaskBudget = {
  2081→    ...budget,
  2082→    started_this_cycle: budget.started_this_cycle + 1,
  2083→  };
  2084→  const validated = TaskBudgetSchema.parse(updated);
  2085→  const budgetPath = getSessionBudgetPath(specDir, sessionId);
  2086→  await writeBudgetAtomic(budgetPath, validated);
  2087→  return validated;
  2088→}
  2089→
  2090→/**
  2091→ * Reset the budget counter to 0 for a new cycle/iteration.
  2092→ *
  2093→ * Called by ralph at iteration boundaries. Single-writer guarantee:
  2094→ * ralph only resets between iterations when the agent is not running.
  2095→ *
  2096→ * AC: @task-budget-enforcement ac-reset
  2097→ * AC: @task-budget-enforcement ac-atomic-write
  2098→ *
  2099→ * @param specDir - The .kspec directory path
  2100→ * @param sessionId - Session ID
  2101→ * @returns Updated budget, or null if no budget configured
  2102→ */
  2103→export async function resetBudget(
  2104→  specDir: string,
  2105→  sessionId: string,
  2106→): Promise<TaskBudget | null> {
  2107→  const budget = await getBudget(specDir, sessionId);
  2108→  if (!budget) {
  2109→    return null;
  2110→  }
  2111→
  2112→  const updated: TaskBudget = {
  2113→    ...budget,
  2114→    started_this_cycle: 0,
  2115→  };
  2116→  const validated = TaskBudgetSchema.parse(updated);
  2117→  const budgetPath = getSessionBudgetPath(specDir, sessionId);
  2118→  await writeBudgetAtomic(budgetPath, validated);
  2119→  return validated;
  2120→}
  2121→