    75→// ─── Types ───────────────────────────────────────────────────────────────────
    76→
    77→export interface CheckpointResult {
    78→  /** Whether session can end cleanly */
    79→  ok: boolean;
    80→
    81→  /** Human-readable message for Claude Code */
    82→  message: string;
    83→
    84→  /** Issues that need attention before stopping */
    85→  issues: CheckpointIssue[];
    86→
    87→  /** Instructions for the agent */
    88→  instructions: string[];
    89→}
    90→
    91→export interface CheckpointIssue {
    92→  type: "uncommitted_changes" | "in_progress_task" | "incomplete_todo";
    93→  description: string;
    94→  details?: Record<string, unknown>;
    95→}
    96→
    97→export interface SessionContext {
    98→  /** When this context was generated */
    99→  generated_at: string;
   100→
   101→  /** Current git branch */
   102→  branch: string | null;
   103→
   104→  /** Session context (focus, threads, questions) */
   105→  context: StoredSessionContext | null;
   106→
   107→  /** Tasks currently in progress */
   108→  active_tasks: ActiveTaskSummary[];
   109→
   110→  /** Tasks awaiting review (code done, PR pending) */
   111→  pending_review_tasks: ActiveTaskSummary[];
   112→
   113→  /** Recent notes from active tasks */
   114→  recent_notes: NoteSummary[];
   115→
   116→  /** Incomplete todos from active tasks */
   117→  active_todos: TodoSummary[];
   118→
   119→  /** Tasks ready to be picked up */
   120→  ready_tasks: ReadyTaskSummary[];
   121→
   122→  /** Blocked tasks with blockers */
   123→  blocked_tasks: BlockedTaskSummary[];
   124→
   125→  /** Recently completed tasks */
   126→  recently_completed: CompletedTaskSummary[];
   127→
   128→  /** Recent git commits */
   129→  recent_commits: CommitSummary[];
   130→
   131→  /** Working tree status */
   132→  working_tree: GitWorkingTree | null;
   133→
   134→  /** Inbox items awaiting triage (oldest first) */
   135→  inbox_items: InboxSummary[];
   136→
   137→  /** Summary statistics */
   138→  stats: SessionStats;
   139→}
   140→
   141→export interface ActiveTaskSummary {
   142→  ref: string;
   143→  title: string;
   144→  started_at: string | null;
   145→  priority: number;
   146→  spec_ref: string | null;
   147→  note_count: number;
   148→  last_note_at: string | null;
   149→  todo_count: number;
   150→  incomplete_todos: number;
   151→}
   152→
   153→export interface NoteSummary {
   154→  task_ref: string;
   155→  task_title: string;
   156→  task_status: "in_progress" | "pending_review" | "needs_work" | "completed";
   157→  note_ulid: string;
   158→  created_at: string;
   159→  author: string | null;
   160→  content: string;
   161→}
   162→
   163→export interface TodoSummary {
   164→  task_ref: string;
   165→  task_title: string;
   166→  id: number;
   167→  text: string;
   168→  added_at: string;
   169→  added_by: string | null;
   170→}
   171→
   172→export interface ReadyTaskSummary {
   173→  ref: string;
   174→  title: string;
   175→  priority: number;
   176→  spec_ref: string | null;
   177→  tags: string[];
   178→}
   179→
   180→export interface BlockedTaskSummary {
   181→  ref: string;
   182→  title: string;
   183→  blocked_by: string[];
   184→  unmet_deps: string[];
   185→}
   186→
   187→export interface CompletedTaskSummary {
   188→  ref: string;
   189→  title: string;
   190→  completed_at: string;
   191→  closed_reason: string | null;
   192→  origin?: "manual" | "derived" | "observation_promotion";
   193→}
   194→
   195→export interface CommitSummary {
   196→  hash: string;
   197→  full_hash: string;
   198→  date: string;
   199→  message: string;
   200→  author: string;
   201→}
   202→
   203→export interface SessionStats {
   204→  total_tasks: number;
   205→  in_progress: number;
   206→  needs_work: number;
   207→  pending_review: number;
   208→  ready: number;
   209→  blocked: number;
   210→  completed: number;
   211→  inbox_items: number;
   212→}
   213→
   214→export interface InboxSummary {
   215→  ref: string;
   216→  text: string;
   217→  created_at: string;
   218→  tags: string[];
   219→  added_by: string | null;
   220→}
   221→
   222→export interface SessionOptions {
   223→  brief?: boolean;
   224→  full?: boolean;
   225→  since?: string;
   226→  git?: boolean;
   227→  limit?: string;
   228→  eligible?: boolean; // Only include automation-eligible tasks in ready_tasks
   229→}
   230→
   231→// ─── Data Gathering ──────────────────────────────────────────────────────────
   232→
   233→function toActiveTaskSummary(
   234→  task: LoadedTask,
   235→  index: ReferenceIndex,
   236→): ActiveTaskSummary {
   237→  const lastNote =
   238→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   239→  const incompleteTodos = task.todos.filter((t) => !t.done).length;
   240→  return {
   241→    ref: index.shortUlid(task._ulid),
   242→    title: task.title,
   243→    started_at: task.started_at || null,
   244→    priority: task.priority,
   245→    spec_ref: task.spec_ref || null,
   246→    note_count: task.notes.length,
   247→    last_note_at: lastNote ? lastNote.created_at : null,
   248→    todo_count: task.todos.length,
   249→    incomplete_todos: incompleteTodos,
   250→  };
   251→}
   252→
   253→function toReadyTaskSummary(
   254→  task: LoadedTask,
   255→  index: ReferenceIndex,
   256→): ReadyTaskSummary {
   257→  return {
   258→    ref: index.shortUlid(task._ulid),
   259→    title: task.title,
   260→    priority: task.priority,
   261→    spec_ref: task.spec_ref || null,
   262→    tags: task.tags,
   263→  };
   264→}
   265→
   266→function toBlockedTaskSummary(
   267→  task: LoadedTask,
   268→  _allTasks: LoadedTask[],
   269→  index: ReferenceIndex,
   270→): BlockedTaskSummary {
   271→  // Find unmet dependencies
   272→  const unmetDeps: string[] = [];
   273→  for (const depRef of task.depends_on) {
   274→    const result = index.resolve(depRef);
   275→    if (result.ok) {
   276→      const depItem = result.item;
   277→      if ("status" in depItem && depItem.status !== "completed") {
   278→        unmetDeps.push(depRef);
   279→      }
   280→    }
   281→  }
   282→
   283→  return {
   284→    ref: index.shortUlid(task._ulid),
   285→    title: task.title,
   286→    blocked_by: task.blocked_by,
   287→    unmet_deps: unmetDeps,
   288→  };
   289→}
   290→
   291→function toCompletedTaskSummary(
   292→  task: LoadedTask,
   293→  index: ReferenceIndex,
   294→): CompletedTaskSummary {
   295→  return {
   296→    ref: index.shortUlid(task._ulid),
   297→    title: task.title,
   298→    completed_at: task.completed_at || "",
   299→    closed_reason: task.closed_reason || null,
   300→    origin: task.origin,
   301→  };
   302→}
   303→
   304→function collectRecentNotes(
   305→  tasks: LoadedTask[],
   306→  index: ReferenceIndex,
   307→  options: { limit: number; since: Date | null },
   308→): NoteSummary[] {
   309→  const allNotes: NoteSummary[] = [];
   310→
   311→  for (const task of tasks) {
   312→    // Only include notes from in_progress, pending_review, or completed tasks
   313→    const taskStatus = task.status as "in_progress" | "pending_review" | "needs_work" | "completed";
   314→    if (!["in_progress", "pending_review", "needs_work", "completed"].includes(taskStatus)) {
   315→      continue;
   316→    }
   317→
   318→    for (const note of task.notes) {
   319→      const noteDate = new Date(note.created_at);
   320→
   321→      // Filter by since date if provided
   322→      if (options.since && noteDate < options.since) {
   323→        continue;
   324→      }
   325→
   326→      // Filter out superseded notes
   327→      if (isNoteSuperseded(note, task.notes)) {
   328→        continue;
   329→      }
   330→
   331→      allNotes.push({
   332→        task_ref: index.shortUlid(task._ulid),
   333→        task_title: task.title,
   334→        task_status: taskStatus,
   335→        note_ulid: note._ulid.slice(0, 8),
   336→        created_at: note.created_at,
   337→        author: note.author || null,
   338→        content: note.content,
   339→      });
   340→    }
   341→  }
   342→
   343→  // Sort by date descending, take limit
   344→  return allNotes
   345→    .sort(
   346→      (a, b) =>
   347→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   348→    )
   349→    .slice(0, options.limit);
   350→}
   351→
   352→function collectIncompleteTodos(
   353→  tasks: LoadedTask[],
   354→  index: ReferenceIndex,
   355→  options: { limit: number },
   356→): TodoSummary[] {
   357→  const allTodos: TodoSummary[] = [];
   358→
   359→  for (const task of tasks) {
   360→    for (const todo of task.todos) {
   361→      // Only include incomplete todos
   362→      if (todo.done) continue;
   363→
   364→      allTodos.push({
   365→        task_ref: index.shortUlid(task._ulid),
   366→        task_title: task.title,
   367→        id: todo.id,
   368→        text: todo.text,
   369→        added_at: todo.added_at,
   370→        added_by: todo.added_by || null,
   371→      });
   372→    }
   373→  }
   374→
   375→  // Sort by added_at descending (most recent first), take limit
   376→  return allTodos
   377→    .sort(
   378→      (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime(),
   379→    )
   380→    .slice(0, options.limit);
   381→}
   382→
   383→/**
   384→ * Gather session context data
   385→ */
   386→export async function gatherSessionContext(
   387→  ctx: KspecContext,
   388→  options: SessionOptions,
   389→): Promise<SessionContext> {
   390→  const limit = parseInt(options.limit || "10", 10);
   391→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   392→  const showGit = options.git !== false; // default true
   393→
   394→  // Load all data
   395→  const allTasks = await loadAllTasks(ctx);
   396→  const items = await loadAllItems(ctx);
   397→  const inboxItems = await loadInboxItems(ctx);
   398→  const index = new ReferenceIndex(allTasks, items);
   399→
   400→  // Compute stats
   401→  const stats: SessionStats = {
   402→    total_tasks: allTasks.length,
   403→    in_progress: allTasks.filter((t) => t.status === "in_progress").length,
   404→    needs_work: allTasks.filter((t) => t.status === "needs_work").length,
   405→    pending_review: allTasks.filter((t) => t.status === "pending_review")
   406→      .length,
   407→    ready: getReadyTasks(allTasks).length,
   408→    blocked: allTasks.filter((t) => t.status === "blocked").length,
   409→    completed: allTasks.filter((t) => t.status === "completed").length,
   410→    inbox_items: inboxItems.length,
   411→  };
   412→
   413→  // Get active tasks (in_progress + needs_work, optionally filtered to automation-eligible only)
   414→  // AC: @cli-ralph ac-16
   415→  const activeTasks = allTasks
   416→    .filter((t) => t.status === "in_progress" || t.status === "needs_work")
   417→    .filter((t) => !options.eligible || t.automation === "eligible")
   418→    .sort((a, b) => a.priority - b.priority)
   419→    .slice(0, options.full ? undefined : limit)
   420→    .map((t) => toActiveTaskSummary(t, index));
   421→
   422→  // Get pending review tasks
   423→  const pendingReviewTasks = allTasks
   424→    .filter((t) => t.status === "pending_review")
   425→    .sort((a, b) => a.priority - b.priority)
   426→    .slice(0, options.full ? undefined : limit)
   427→    .map((t) => toActiveTaskSummary(t, index));
   428→
   429→  // Get recent notes from active, pending_review, and recently completed tasks
   430→  // AC: @cmd-session-start ac-1, ac-2
   431→  // Collect notes per-status first to prevent one status from starving others
   432→  const noteLimitPerStatus = options.full ? limit : Math.ceil(limit / 3);
   433→
   434→  const inProgressNotes = collectRecentNotes(
   435→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   436→    index,
   437→    { limit: noteLimitPerStatus, since: sinceDate },
   438→  );
   439→
   440→  const pendingReviewNotes = collectRecentNotes(
   441→    allTasks.filter((t) => t.status === "pending_review"),
   442→    index,
   443→    { limit: noteLimitPerStatus, since: sinceDate },
   444→  );
   445→
   446→  const recentlyCompletedForNotes = allTasks
   447→    .filter((t) => t.status === "completed" && t.completed_at)
   448→    .sort((a, b) => {
   449→      const aDate = new Date(a.completed_at || 0);
   450→      const bDate = new Date(b.completed_at || 0);
   451→      return bDate.getTime() - aDate.getTime();
   452→    })
   453→    .slice(0, 5); // Last 3-5 completed tasks per AC-2
   454→
   455→  const completedNotes = collectRecentNotes(
   456→    recentlyCompletedForNotes,
   457→    index,
   458→    { limit: noteLimitPerStatus, since: sinceDate },
   459→  );
   460→
   461→  // Combine notes from all statuses, preserving representation from each
   462→  const recentNotes = [...inProgressNotes, ...pendingReviewNotes, ...completedNotes]
   463→    .sort(
   464→      (a, b) =>
   465→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   466→    );
   467→
   468→  // Get incomplete todos from active tasks
   469→  const activeTodos = collectIncompleteTodos(
   470→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   471→    index,
   472→    { limit: options.full ? limit * 2 : limit },
   473→  );
   474→
   475→  // Get ready tasks (optionally filtered to automation-eligible only)
   476→  const readyTasks = getReadyTasks(allTasks)
   477→    .filter((t) => !options.eligible || t.automation === "eligible")
   478→    .slice(0, options.full ? undefined : limit)
   479→    .map((t) => toReadyTaskSummary(t, index));
   480→
   481→  // Get blocked tasks
   482→  const blockedTasks = allTasks
   483→    .filter((t) => t.status === "blocked")
   484→    .slice(0, options.full ? undefined : limit)
   485→    .map((t) => toBlockedTaskSummary(t, allTasks, index));
   486→
   487→  // Get recently completed tasks
   488→  const recentlyCompleted = allTasks
   489→    .filter((t) => {
   490→      if (t.status !== "completed" || !t.completed_at) return false;
   491→      const completedDate = new Date(t.completed_at);
   492→      if (sinceDate && completedDate < sinceDate) return false;
   493→      return true;
   494→    })
   495→    .sort((a, b) => {
   496→      // Sort by completed_at descending (most recent first)
   497→      const aDate = new Date(a.completed_at || 0);
   498→      const bDate = new Date(b.completed_at || 0);
   499→      return bDate.getTime() - aDate.getTime();
   500→    })
   501→    .slice(0, options.full ? undefined : limit)
   502→    .map((t) => toCompletedTaskSummary(t, index));
   503→
   504→  // Get git info
   505→  let branch: string | null = null;
   506→  let recentCommits: CommitSummary[] = [];
   507→  let workingTree: GitWorkingTree | null = null;
   508→
   509→  if (showGit && isGitRepo(ctx.rootDir)) {
   510→    branch = getCurrentBranch(ctx.rootDir);
   511→
   512→    const commits = getRecentCommits({
   513→      limit: options.full ? limit * 2 : limit,
   514→      since: sinceDate || undefined,
   515→      cwd: ctx.rootDir,
   516→    });
   517→
   518→    recentCommits = commits.map((c) => ({
   519→      hash: c.hash,
   520→      full_hash: c.fullHash,
   521→      date: c.date.toISOString(),
   522→      message: c.message,
   523→      author: c.author,
   524→    }));
   525→
   526→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   527→  }
   528→
   529→  // Get inbox items (oldest first to encourage triage)
   530→  const inboxSummaries: InboxSummary[] = inboxItems
   531→    .sort(
   532→      (a, b) =>
   533→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   534→    )
   535→    .slice(0, options.full ? undefined : limit)
   536→    .map((item) => ({
   537→      ref: item._ulid.slice(0, 8),
   538→      text: item.text,
   539→      created_at: item.created_at,
   540→      tags: item.tags,
   541→      added_by: item.added_by || null,
   542→    }));
   543→
   544→  // Load session context (focus, threads, questions)
   545→  const sessionContext = await loadSessionContext(ctx);
   546→
   547→  return {
   548→    generated_at: new Date().toISOString(),
   549→    branch,
   550→    context: sessionContext,
   551→    active_tasks: activeTasks,
   552→    pending_review_tasks: pendingReviewTasks,
   553→    recent_notes: recentNotes,
   554→    active_todos: activeTodos,
   555→    ready_tasks: readyTasks,
   556→    blocked_tasks: blockedTasks,
   557→    recently_completed: recentlyCompleted,
   558→    recent_commits: recentCommits,
   559→    working_tree: workingTree,
   560→    inbox_items: inboxSummaries,
   561→    stats,
   562→  };
   563→}
   564→
   565→// ─── Iteration Stats ─────────────────────────────────────────────────────────
   566→
   567→/**
   568→ * Stats for tasks completed/started within a time window.
   569→ * Used by ralph to track task completions per iteration.
   570→ */
   571→export interface IterationStats {
   572→  /** Number of tasks completed since the given time */
   573→  tasks_completed: number;
   574→  /** Number of tasks started since the given time */
   575→  tasks_started: number;
   576→  /** References of completed tasks */
   577→  completed_refs: string[];
   578→}
   579→
   580→/**
   581→ * Get iteration stats - tasks completed/started since a given time.
   582→ * AC: @ralph-task-limit ac-detection
   583→ */
   584→export async function getIterationStats(
   585→  ctx: KspecContext,
   586→  since: Date,
   587→): Promise<IterationStats> {
   588→  const allTasks = await loadAllTasks(ctx);
   589→
   590→  // Count both completed and pending_review (submitted) tasks toward the limit.
   591→  // Submit means the agent's work is done — it should count the same as complete.
   592→  // AC: @ralph-task-limit ac-detection
   593→  const completedSince = allTasks.filter((t) => {
   594→    if (t.status === "completed" && t.completed_at) {
   595→      return new Date(t.completed_at) >= since;
   596→    }
   597→    if (t.status === "pending_review" && t.submitted_at) {
   598→      return new Date(t.submitted_at) >= since;
   599→    }
   600→    return false;
   601→  });
   602→
   603→  const startedSince = allTasks.filter((t) => {
   604→    if (!t.started_at) return false;
   605→    return new Date(t.started_at) >= since;
   606→  });
   607→
   608→  // Use first slug or ULID prefix as ref
   609→  const getRef = (t: LoadedTask) =>
   610→    t.slugs.length > 0 ? `@${t.slugs[0]}` : `@${t._ulid.slice(0, 8)}`;
   611→
   612→  return {
   613→    tasks_completed: completedSince.length,
   614→    tasks_started: startedSince.length,
   615→    completed_refs: completedSince.map(getRef),
   616→  };
   617→}
   618→
   619→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   620→
   621→export interface CheckpointOptions {
   622→  force?: boolean;
   623→  /** Set when stop hook is already active (retry after previous block) */
   624→  stopHookActive?: boolean;
   625→}
   626→
   627→/** Claude Code hook input for Stop hooks */
   628→export interface StopHookInput {
   629→  session_id?: string;
   630→  transcript_path?: string;
   631→  hook_event_name?: string;
   632→  stop_hook_active?: boolean;
   633→}
   634→
   635→/**
   636→ * Perform session checkpoint - check for uncommitted work before ending session.
   637→ *
   638→ * This is designed for use as a Claude Code stop hook. It checks for:
   639→ * - Uncommitted git changes (staged, unstaged, untracked)
   640→ * - Tasks in in_progress status
   641→ * - Incomplete todos on active tasks
   642→ *
   643→ * Returns a structured result indicating whether the session can end cleanly.
   644→ */
   645→export async function performCheckpoint(
   646→  ctx: KspecContext,
   647→  options: CheckpointOptions,
   648→): Promise<CheckpointResult> {
   649→  const issues: CheckpointIssue[] = [];
   650→  const instructions: string[] = [];
   651→
   652→  // Load tasks
   653→  const allTasks = await loadAllTasks(ctx);
   654→
   655→  // Check for in-progress tasks
   656→  const inProgressTasks = allTasks.filter((t) => t.status === "in_progress");
   657→  for (const task of inProgressTasks) {
   658→    const ref = task.slugs[0]
   659→      ? `@${task.slugs[0]}`
   660→      : `@${task._ulid.slice(0, 8)}`;
   661→    issues.push({
   662→      type: "in_progress_task",
   663→      description: `Task ${ref} is still in progress: ${task.title}`,
   664→      details: {
   665→        ref,
   666→        title: task.title,
   667→        started_at: task.started_at,
   668→      },
   669→    });
   670→
   671→    // Check for incomplete todos on this task
   672→    const incompleteTodos = task.todos.filter((t) => !t.done);
   673→    for (const todo of incompleteTodos) {
   674→      issues.push({
   675→        type: "incomplete_todo",
   676→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   677→        details: {
   678→          task_ref: ref,
   679→          todo_id: todo.id,
   680→          text: todo.text,
   681→        },
   682→      });
   683→    }
   684→  }
   685→
   686→  // Check for uncommitted git changes
   687→  if (isGitRepo(ctx.rootDir)) {
   688→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   689→    if (!workingTree.clean) {
   690→      const changeCount =
   691→        workingTree.staged.length +
   692→        workingTree.unstaged.length +
   693→        workingTree.untracked.length;
   694→
   695→      issues.push({
   696→        type: "uncommitted_changes",
   697→        description: `${changeCount} uncommitted changes in working tree`,
   698→        details: {
   699→          staged: workingTree.staged.length,
   700→          unstaged: workingTree.unstaged.length,
   701→          untracked: workingTree.untracked.length,
   702→        },
   703→      });
   704→    }
   705→  }
   706→
   707→  // Build instructions based on issues
   708→  if (issues.length > 0 && !options.force) {
   709→    instructions.push(
   710→      "If you've been instructed to ignore this message or are working on",
   711→    );
   712→    instructions.push(
   713→      "unrelated things to any in progress tasks then disregard this message,",
   714→    );
   715→    instructions.push("otherwise before ending this session, please:");
   716→
   717→    const hasInProgress = issues.some((i) => i.type === "in_progress_task");
   718→    const hasUncommitted = issues.some((i) => i.type === "uncommitted_changes");
   719→    const hasIncompleteTodos = issues.some((i) => i.type === "incomplete_todo");
   720→
   721→    let step = 1;
   722→
   723→    if (hasInProgress) {
   724→      instructions.push(
   725→        `${step++}. Read in-progress task notes to get full context of the current task status`,
   726→      );
   727→      instructions.push(
   728→        `${step++}. Add notes documenting current state if any context is missing from this session`,
   729→      );
   730→      instructions.push(
   731→        `${step++}. Complete the task if you've completed the objectives and no AC are left uncovered\notherwise leave it in progress for a future session`,
   732→      );
   733→    }
   734→
   735→    if (hasIncompleteTodos) {
   736→      instructions.push(
   737→        `${step++}. Complete or acknowledge incomplete todos on active tasks`,
   738→      );
   739→    }
   740→
   741→    if (hasUncommitted) {
   742→      instructions.push(
   743→        `${step++}. Commit your changes with a descriptive message`,
   744→      );
   745→
   746→      // Add WIP commit guidance if there are in-progress tasks
   747→      if (inProgressTasks.length > 0) {
   748→        const task = inProgressTasks[0];
   749→        const guidance = formatCommitGuidance(task, { wip: true });
   750→        instructions.push("");
   751→        instructions.push("Suggested WIP commit:");
   752→        instructions.push(`  ${guidance.message}`);
   753→        instructions.push("");
   754→        for (const trailer of guidance.trailers) {
   755→          instructions.push(`  ${trailer}`);
   756→        }
   757→      }
   758→    }
   759→
   760→    instructions.push("");
   761→    instructions.push("Use: kspec task @task to get current task state");
   762→    instructions.push(
   763→      'Use: kspec task note @task "Progress notes..." to document state',
   764→    );
   765→    instructions.push(
   766→      'Use: kspec task complete @task --reason "Summary" if task is done',
   767→    );
   768→  }
   769→
   770→  // Allow stop if:
   771→  // - No issues found
   772→  // - --force flag passed
   773→  // - This is a retry (stop_hook_active = true from previous block)
   774→  const isRetry = options.stopHookActive === true;
   775→  const ok = issues.length === 0 || options.force === true || isRetry;
   776→
   777→  let message: string;
   778→  if (isRetry && issues.length > 0) {
   779→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   780→  } else if (ok) {
   781→    message = "[kspec] Session checkpoint passed - ready to end session";
   782→  } else {
   783→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   784→  }
   785→
   786→  return {
   787→    ok,
   788→    message,
   789→    issues,
   790→    instructions,
   791→  };
   792→}
   793→
   794→// ─── Output Formatting ───────────────────────────────────────────────────────
   795→
   796→function formatCheckpointResult(result: CheckpointResult): void {
   797→  if (result.ok) {
   798→    console.log(chalk.green(result.message));
   799→  } else {
   800→    console.log(chalk.yellow(result.message));
   801→    console.log("");
   802→
   803→    for (const issue of result.issues) {
   804→      const icon =
   805→        issue.type === "uncommitted_changes"
   806→          ? chalk.yellow("⚠")
   807→          : issue.type === "in_progress_task"
   808→            ? chalk.blue("●")
   809→            : chalk.gray("○");
   810→      console.log(`  ${icon} ${issue.description}`);
   811→    }
   812→
   813→    if (result.instructions.length > 0) {
   814→      console.log("");
   815→      for (const instruction of result.instructions) {
   816→        console.log(chalk.gray(instruction));
   817→      }
   818→    }
   819→  }
   820→}
   821→
   822→function formatSessionContext(
   823→  ctx: SessionContext,
   824→  options: SessionOptions,
   825→): void {
   826→  const isBrief = !options.full;
   827→
   828→  // Header
   829→  console.log(`\n${sessionHeaders.title}`);
   830→  const age = formatRelativeTime(new Date(ctx.generated_at));
   831→  if (ctx.branch) {
   832→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   833→  } else {
   834→    console.log(chalk.gray(`Generated: ${age}`));
   835→  }
   836→
   837→  // Stats summary
   838→  const pendingReviewNote =
   839→    ctx.stats.pending_review > 0
   840→      ? `${ctx.stats.pending_review} awaiting review, `
   841→      : "";
   842→  const inboxNote =
   843→    ctx.stats.inbox_items > 0 ? ` | Inbox: ${ctx.stats.inbox_items}` : "";
   844→  console.log(
   845→    chalk.gray(
   846→      `Tasks: ${ctx.stats.in_progress} active, ${pendingReviewNote}${ctx.stats.ready} ready, ` +
   847→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`,
   848→    ),
   849→  );
   850→
   851→  // Session context section (focus, threads, questions)
   852→  if (
   853→    ctx.context &&
   854→    (ctx.context.focus ||
   855→      ctx.context.threads.length > 0 ||
   856→      ctx.context.open_questions.length > 0)
   857→  ) {
   858→    console.log("\n--- Session Context ---");
   859→
   860→    if (ctx.context.focus) {
   861→      console.log(`  ${chalk.cyan("Focus:")} ${ctx.context.focus}`);
   862→    }
   863→
   864→    if (ctx.context.threads.length > 0) {
   865→      console.log(`  ${chalk.cyan("Active Threads:")}`);
   866→      for (const thread of ctx.context.threads) {
   867→        console.log(`    - ${thread}`);
   868→      }
   869→    }
   870→
   871→    if (ctx.context.open_questions.length > 0) {
   872→      console.log(`  ${chalk.cyan("Open Questions:")}`);
   873→      for (const question of ctx.context.open_questions) {
   874→        console.log(`    - ${question}`);
   875→      }
   876→    }
   877→  }
   878→
   879→  // Active tasks section
   880→  if (ctx.active_tasks.length > 0) {
   881→    console.log(`\n${sessionHeaders.activeWork}`);
   882→    for (const task of ctx.active_tasks) {
   883→      const started = task.started_at
   884→        ? chalk.gray(
   885→            ` (started ${formatRelativeTime(new Date(task.started_at))})`,
   886→          )
   887→        : "";
   888→      const priority =
   889→        task.priority <= 2
   890→          ? chalk.red(`P${task.priority}`)
   891→          : chalk.gray(`P${task.priority}`);
   892→      console.log(
   893→        `  ${chalk.blue("[in_progress]")} ${priority} ${task.ref} ${task.title}${started}`,
   894→      );
   895→    }
   896→  } else {
   897→    console.log(`\n${sessionHeaders.noActiveWork}`);
   898→  }
   899→
   900→  // Awaiting review section
   901→  if (ctx.pending_review_tasks.length > 0) {
   902→    console.log(`\n${sessionHeaders.awaitingReview}`);
   903→    for (const task of ctx.pending_review_tasks) {
   904→      const priority =
   905→        task.priority <= 2
   906→          ? chalk.red(`P${task.priority}`)
   907→          : chalk.gray(`P${task.priority}`);
   908→      console.log(
   909→        `  ${chalk.yellow("[pending_review]")} ${priority} ${task.ref} ${task.title}`,
   910→      );
   911→    }
   912→  }
   913→
   914→  // Recently completed section
   915→  if (ctx.recently_completed.length > 0) {
   916→    console.log(`\n${sessionHeaders.recentlyCompleted}`);
   917→    const observationPromotedTasks: string[] = [];
   918→    for (const task of ctx.recently_completed) {
   919→      const completedAge = formatRelativeTime(new Date(task.completed_at));
   920→      let reason = "";
   921→      if (task.closed_reason) {
   922→        const maxLen = isBrief ? 60 : 120;
   923→        const truncated =
   924→          task.closed_reason.length > maxLen
   925→            ? `${task.closed_reason.slice(0, maxLen).trim()}...`
   926→            : task.closed_reason;
   927→        reason = chalk.gray(` - ${truncated}`);
   928→      }
   929→      console.log(
   930→        `  ${chalk.green("[completed]")} ${task.ref} ${task.title} ${chalk.gray(`(${completedAge})`)}${reason}`,
   931→      );
   932→
   933→      // Track tasks that came from observations
   934→      if (task.origin === "observation_promotion") {
   935→        observationPromotedTasks.push(task.ref);
   936→      }
   937→    }
   938→
   939→    // Show reminder about resolving observations
   940→    if (observationPromotedTasks.length > 0) {
   941→      console.log(
   942→        chalk.yellow(
   943→          `\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(", ")}`,
   944→        ),
   945→      );
   946→      console.log(
   947→        chalk.gray(`    Run: kspec meta observations --pending-resolution`),
   948→      );
   949→    }
   950→  }
   951→
   952→  // Recent notes section - grouped by task status
   953→  // AC: @cmd-session-start ac-1, ac-2
   954→  if (ctx.recent_notes.length > 0) {
   955→    console.log(`\n${sessionHeaders.recentNotes}`);
   956→
   957→    // Group notes by task status
   958→    const inProgressNotes = ctx.recent_notes.filter(
   959→      (n) => n.task_status === "in_progress",
   960→    );
   961→    const pendingReviewNotes = ctx.recent_notes.filter(
   962→      (n) => n.task_status === "pending_review",
   963→    );
   964→    const completedNotes = ctx.recent_notes.filter(
   965→      (n) => n.task_status === "completed",
   966→    );
   967→
   968→    // Helper to format a single note
   969→    const formatNote = (note: NoteSummary) => {
   970→      const age = formatRelativeTime(new Date(note.created_at));
   971→      const author = note.author ? chalk.gray(` by ${note.author}`) : "";
   972→      console.log(`    ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
   973→
   974→      // Truncate content in brief mode
   975→      let content = note.content.trim();
   976→      if (isBrief && content.length > 200) {
   977→        content = `${content.slice(0, 200).trim()}...`;
   978→      }
   979→
   980→      // Indent content, limit lines in brief mode
   981→      const lines = content.split("\n");
   982→      const maxLines = isBrief ? 3 : lines.length;
   983→      for (const line of lines.slice(0, maxLines)) {
   984→        console.log(`      ${chalk.white(line)}`);
   985→      }
   986→      if (isBrief && lines.length > maxLines) {
   987→        console.log(
   988→          chalk.gray(`      ... (${lines.length - maxLines} more lines)`),
   989→        );
   990→      }
   991→    };
   992→
   993→    // AC: @cmd-session-start ac-1 - In Progress notes
   994→    if (inProgressNotes.length > 0) {
   995→      console.log(`  ${chalk.blue("In Progress:")}`);
   996→      for (const note of inProgressNotes) {
   997→        formatNote(note);
   998→      }
   999→    }
  1000→
  1001→    // AC: @cmd-session-start ac-1 - Pending Review notes (grouped separately)
  1002→    if (pendingReviewNotes.length > 0) {
  1003→      console.log(`  ${chalk.yellow("Pending Review:")}`);
  1004→      for (const note of pendingReviewNotes) {
  1005→        formatNote(note);
  1006→      }
  1007→    }
  1008→
  1009→    // AC: @cmd-session-start ac-2 - Recently Completed notes
  1010→    if (completedNotes.length > 0) {
  1011→      console.log(`  ${chalk.green("Recently Completed:")}`);
  1012→      for (const note of completedNotes) {
  1013→        formatNote(note);
  1014→      }
  1015→    }
  1016→  }
  1017→
  1018→  // Incomplete todos section
  1019→  if (ctx.active_todos.length > 0) {
  1020→    console.log(`\n${sessionHeaders.incompleteTodos}`);
  1021→    for (const todo of ctx.active_todos) {
  1022→      console.log(
  1023→        `  ${chalk.yellow("[ ]")} ${todo.task_ref}#${todo.id}: ${todo.text}`,
  1024→      );
  1025→    }
  1026→  }
  1027→
  1028→  // Ready tasks section
  1029→  if (ctx.ready_tasks.length > 0) {
  1030→    console.log(`\n${sessionHeaders.readyTasks}`);
  1031→    for (const task of ctx.ready_tasks) {
  1032→      const priority =
  1033→        task.priority <= 2
  1034→          ? chalk.red(`P${task.priority}`)
  1035→          : chalk.gray(`P${task.priority}`);
  1036→      const tags =
  1037→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(" #")}`) : "";
  1038→      console.log(`  ${priority} ${task.ref} ${task.title}${tags}`);
  1039→    }
  1040→  }
  1041→
  1042→  // Blocked tasks section
  1043→  if (ctx.blocked_tasks.length > 0) {
  1044→    console.log(`\n${sessionHeaders.blocked}`);
  1045→    for (const task of ctx.blocked_tasks) {
  1046→      console.log(`  ${chalk.red("[blocked]")} ${task.ref} ${task.title}`);
  1047→      if (task.blocked_by.length > 0) {
  1048→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(", ")}`));
  1049→      }
  1050→      if (task.unmet_deps.length > 0) {
  1051→        console.log(
  1052→          chalk.gray(`    Waiting on: ${task.unmet_deps.join(", ")}`),
  1053→        );
  1054→      }
  1055→    }
  1056→  }
  1057→
  1058→  // Git commits section
  1059→  if (ctx.recent_commits.length > 0) {
  1060→    console.log(`\n${sessionHeaders.recentCommits}`);
  1061→    for (const commit of ctx.recent_commits) {
  1062→      const age = formatRelativeTime(new Date(commit.date));
  1063→      console.log(
  1064→        `  ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${age}, ${commit.author})`)}`,
  1065→      );
  1066→    }
  1067→  }
  1068→
  1069→  // Inbox section (oldest first to encourage triage)
  1070→  if (ctx.inbox_items.length > 0) {
  1071→    console.log(`\n${sessionHeaders.inbox}`);
  1072→    for (const item of ctx.inbox_items) {
  1073→      const age = formatRelativeTime(new Date(item.created_at));
  1074→      const author = item.added_by ? ` by ${item.added_by}` : "";
  1075→      const tags =
  1076→        item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(", ")}]`) : "";
  1077→      // Truncate text in brief mode
  1078→      let text = item.text;
  1079→      if (isBrief && text.length > 60) {
  1080→        text = `${text.slice(0, 60).trim()}...`;
  1081→      }
  1082→      console.log(
  1083→        `  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`,
  1084→      );
  1085→      console.log(`    ${text}`);
  1086→    }
  1087→    console.log(`  ${hints.inboxPromote}`);
  1088→  }
  1089→
  1090→  // Working tree section
  1091→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1092→    console.log(`\n${sessionHeaders.workingTree}`);
  1093→
  1094→    if (ctx.working_tree.staged.length > 0) {
  1095→      console.log(chalk.green("  Staged:"));
  1096→      for (const file of ctx.working_tree.staged) {
  1097→        console.log(
  1098→          `    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`,
  1099→        );
  1100→      }
  1101→    }
  1102→
  1103→    if (ctx.working_tree.unstaged.length > 0) {
  1104→      console.log(chalk.red("  Modified:"));
  1105→      for (const file of ctx.working_tree.unstaged) {
  1106→        console.log(
  1107→          `    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`,
  1108→        );
  1109→      }
  1110→    }
  1111→
  1112→    if (ctx.working_tree.untracked.length > 0) {
  1113→      console.log(chalk.gray("  Untracked:"));
  1114→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
  1115→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
  1116→        console.log(`    ${chalk.gray("?")} ${path}`);
  1117→      }
  1118→      if (isBrief && ctx.working_tree.untracked.length > limit) {
  1119→        console.log(
  1120→          chalk.gray(
  1121→            `    ... and ${ctx.working_tree.untracked.length - limit} more`,
  1122→          ),
  1123→        );
  1124→      }
  1125→    }
  1126→  } else if (ctx.working_tree?.clean) {
  1127→    console.log(`\n${sessionHeaders.workingTreeClean}`);
  1128→  }
  1129→
  1130→  // Quick Commands section - contextual hints based on state
  1131→  const quickCommands: string[] = [];
  1132→
  1133→  if (ctx.active_tasks.length > 0) {
  1134→    const ref = ctx.active_tasks[0].ref;
  1135→    quickCommands.push(
  1136→      `kspec task note @${ref} "Progress..."  ${chalk.gray("# document work")}`,
  1137→    );
  1138→    quickCommands.push(
  1139→      `kspec task complete @${ref} --reason "..."  ${chalk.gray("# finish task")}`,
  1140→    );
  1141→  } else if (ctx.ready_tasks.length > 0) {
  1142→    const ref = ctx.ready_tasks[0].ref;
  1143→    quickCommands.push(
  1144→      `kspec task start @${ref}  ${chalk.gray("# begin work")}`,
  1145→    );
  1146→  }
  1147→
  1148→  if (ctx.inbox_items.length > 0) {
  1149→    const ref = ctx.inbox_items[0].ref;
  1150→    quickCommands.push(
  1151→      `kspec inbox promote @${ref} --title "..."  ${chalk.gray("# convert to task")}`,
  1152→    );
  1153→  }
  1154→
  1155→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1156→    quickCommands.push(
  1157→      `git add . && git commit -m "..."  ${chalk.gray("# commit changes")}`,
  1158→    );
  1159→  }
  1160→
  1161→  if (quickCommands.length > 0) {
  1162→    console.log(`\n${sessionHeaders.quickCommands}`);
  1163→    for (const hint of quickCommands) {
  1164→      console.log(`  ${hint}`);
  1165→    }
  1166→  }
  1167→
  1168→  console.log(""); // Final newline
  1169→}
  1170→
  1171→// ─── Command Registration ────────────────────────────────────────────────────
  1172→
  1173→async function sessionStartAction(options: SessionOptions): Promise<void> {
  1174→  try {
  1175→    const ctx = await initContext();
  1176→
  1177→    // AC: @shadow-sync ac-2 - Pull remote changes before showing session context
  1178→    let syncResult: ShadowSyncResult | null = null;
  1179→    if (ctx.shadow?.enabled) {
  1180→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
  1181→      // AC: @shadow-sync ac-3 - Warn about conflicts but continue with local state
  1182→      if (syncResult.hadConflict) {
  1183→        warn("Shadow sync conflict detected. Run `kspec shadow resolve` to fix.");
  1184→        info("Continuing with local state...");
  1185→      } else if (syncResult.pulled) {
  1186→        info("Synced shadow branch from remote");
  1187→      }
  1188→    }
  1189→
  1190→    const sessionCtx = await gatherSessionContext(ctx, options);
  1191→
  1192→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
  1193→  } catch (err) {
  1194→    error(errors.failures.gatherSessionContext, err);
  1195→    process.exit(EXIT_CODES.ERROR);
  1196→  }
  1197→}
  1198→
  1199→/**
  1200→ * Read stdin if available (non-blocking check for hook input)
  1201→ */
  1202→async function readStdinIfAvailable(): Promise<string | null> {
  1203→  // Check if stdin is a TTY (interactive) - if so, don't try to read
  1204→  if (process.stdin.isTTY) {
  1205→    return null;
  1206→  }
  1207→
  1208→  return new Promise((resolve) => {
  1209→    let data = "";
  1210→    const timeout = setTimeout(() => {
  1211→      process.stdin.removeAllListeners();
  1212→      resolve(data || null);
  1213→    }, 100); // 100ms timeout for stdin
  1214→
  1215→    process.stdin.setEncoding("utf8");
  1216→    process.stdin.on("data", (chunk) => {
  1217→      data += chunk;
  1218→    });
  1219→    process.stdin.on("end", () => {
  1220→      clearTimeout(timeout);
  1221→      resolve(data || null);
  1222→    });
  1223→    process.stdin.on("error", () => {
  1224→      clearTimeout(timeout);
  1225→      resolve(null);
  1226→    });
  1227→    process.stdin.resume();
  1228→  });
  1229→}
  1230→
  1231→/**
  1232→ * Parse Claude Code hook input from stdin
  1233→ */
  1234→function parseHookInput(stdin: string | null): StopHookInput | null {
  1235→  if (!stdin) return null;
  1236→  try {
  1237→    return JSON.parse(stdin.trim()) as StopHookInput;
  1238→  } catch {
  1239→    return null;
  1240→  }
  1241→}
  1242→
  1243→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
  1244→
  1245→/**
  1246→ * Output spec-first reminder for UserPromptSubmit hook.
  1247→ *
  1248→ * This is a simple context injection - always outputs the reminder,
  1249→ * and Claude (Opus) is smart enough to apply it when relevant.
  1250→ */
  1251→async function sessionPromptCheckAction(): Promise<void> {
  1252→  // Lean, instructive reminder with kspec prefix
  1253→  console.log(sessionPrompt.specCheck);
  1254→}
  1255→
  1256→async function sessionCheckpointAction(
  1257→  options: CheckpointOptions,
  1258→): Promise<void> {
  1259→  try {
  1260→    // Read stdin for Claude Code hook input
  1261→    const stdin = await readStdinIfAvailable();
  1262→    const hookInput = parseHookInput(stdin);
  1263→
  1264→    // Check if this is a retry (stop hook already active)
  1265→    if (hookInput?.stop_hook_active) {
  1266→      options.stopHookActive = true;
  1267→    }
  1268→
  1269→    const ctx = await initContext();
  1270→    const result = await performCheckpoint(ctx, options);
  1271→
  1272→    // Output format depends on mode:
  1273→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
  1274→    // - Human mode: Output formatted checkpoint result
  1275→    if (isJsonMode()) {
  1276→      if (!result.ok) {
  1277→        // Build reason message with issues and instructions
  1278→        const issueLines = result.issues
  1279→          .map((i) => `- ${i.description}`)
  1280→          .join("\n");
  1281→        const instructionLines = result.instructions
  1282→          .filter((i) => i.trim())
  1283→          .join("\n");
  1284→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
  1285→        console.log(JSON.stringify({ decision: "block", reason }));
  1286→      }
  1287→      // If ok, exit silently (Claude Code expects no output when allowing stop)
  1288→    } else {
  1289→      formatCheckpointResult(result);
  1290→      if (!result.ok) {
  1291→        process.exit(EXIT_CODES.ERROR);
  1292→      }
  1293→    }
  1294→  } catch (err) {
  1295→    // Handle RUNNING_FROM_SHADOW gracefully - skip with warning instead of erroring
  1296→    // This happens when the stop hook runs while cwd is inside .kspec/ directory
  1297→    if (err instanceof ShadowError && err.code === "RUNNING_FROM_SHADOW") {
  1298→      if (!isJsonMode()) {
  1299→        console.log(
  1300→          chalk.yellow(
  1301→            "[kspec] Session checkpoint skipped - running from inside .kspec/ directory",
  1302→          ),
  1303→        );
  1304→      }
  1305→      // Allow stop to proceed (exit successfully, no JSON output blocks the stop)
  1306→      return;
  1307→    }
  1308→    error(errors.failures.runCheckpoint, err);
  1309→    process.exit(EXIT_CODES.ERROR);
  1310→  }
  1311→}
  1312→
  1313→// ─── Session Log List ─────────────────────────────────────────────────────────
  1314→
  1315→interface SessionLogListOptions {
  1316→  status?: string;
  1317→  agent?: string;
  1318→  since?: string;
  1319→  sort?: string;
  1320→  count?: boolean;
  1321→  limit?: string;
  1322→}
  1323→
  1324→type SortField =
  1325→  | "started_at"
  1326→  | "duration"
  1327→  | "events"
  1328→  | "iterations"
  1329→  | "tasks_completed";
  1330→
  1331→const VALID_SORT_FIELDS: SortField[] = [
  1332→  "started_at",
  1333→  "duration",
  1334→  "events",
  1335→  "iterations",
  1336→  "tasks_completed",
  1337→];
  1338→
  1339→/**
  1340→ * Format a duration in milliseconds to a human-readable string.
  1341→ */
  1342→function formatDuration(ms: number): string {
  1343→  if (ms < 0) return "—";
  1344→  const totalSec = Math.floor(ms / 1000);
  1345→  const hours = Math.floor(totalSec / 3600);
  1346→  const minutes = Math.floor((totalSec % 3600) / 60);
  1347→  if (hours > 0) {
  1348→    return `${hours}h ${minutes}m`;
  1349→  }
  1350→  if (minutes > 0) {
  1351→    return `${minutes}m`;
  1352→  }
  1353→  return `${totalSec}s`;
  1354→}
  1355→
  1356→/**
  1357→ * Sort session summaries by the specified field.
  1358→ * Default: started_at descending.
  1359→ *
  1360→ * AC: @session-log-list ac-5
  1361→ */
  1362→function sortSessions(
  1363→  sessions: SessionLogSummary[],
  1364→  sortField: SortField,
  1365→): SessionLogSummary[] {
  1366→  return [...sessions].sort((a, b) => {
  1367→    switch (sortField) {
  1368→      case "started_at":
  1369→        return (
  1370→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1371→        );
  1372→      case "duration":
  1373→        return b.duration_ms - a.duration_ms;
  1374→      case "events":
  1375→        return b.event_count - a.event_count;
  1376→      case "iterations":
  1377→        return b.iteration_count - a.iteration_count;
  1378→      case "tasks_completed":
  1379→        return b.tasks_completed - a.tasks_completed;
  1380→      default:
  1381→        return (
  1382→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1383→        );
  1384→    }
  1385→  });
  1386→}
  1387→
  1388→/**
  1389→ * Format the session log list as a table.
  1390→ *
  1391→ * AC: @session-log-list ac-1
  1392→ */
  1393→function formatSessionLogList(sessions: SessionLogSummary[]): void {
  1394→  if (sessions.length === 0) {
  1395→    // AC: @session-log-list ac-6
  1396→    console.log("No sessions found.");
  1397→    return;
  1398→  }
  1399→
  1400→  // Table header
  1401→  console.log(
  1402→    chalk.gray(
  1403→      `${"ID".padEnd(10)} ${"Status".padEnd(11)} ${"Agent".padEnd(20)} ${"Started".padEnd(16)} ${"Duration".padEnd(10)} ${"Events".padEnd(8)} ${"Iters".padEnd(7)} Tasks`,
  1404→    ),
  1405→  );
  1406→  console.log(chalk.gray("─".repeat(95)));
  1407→
  1408→  for (const s of sessions) {
  1409→    const id = s.id.slice(0, 8);
  1410→    const statusColor =
  1411→      s.status === "completed"
  1412→        ? chalk.green
  1413→        : s.status === "active"
  1414→          ? chalk.blue
  1415→          : chalk.yellow;
  1416→    const status = statusColor(s.status.padEnd(11));
  1417→    const agent = s.agent_type.slice(0, 20).padEnd(20);
  1418→    const started = formatRelativeTime(new Date(s.started_at)).padEnd(16);
  1419→    const duration = formatDuration(s.duration_ms).padEnd(10);
  1420→    const events = String(s.event_count).padEnd(8);
  1421→    const iters = String(s.iteration_count).padEnd(7);
  1422→    const tasks = String(s.tasks_completed);
  1423→
  1424→    console.log(
  1425→      `${chalk.yellow(id)} ${status} ${chalk.gray(agent)} ${chalk.gray(started)} ${duration} ${events} ${iters} ${tasks}`,
  1426→    );
  1427→  }
  1428→
  1429→  console.log(chalk.gray(`\n${sessions.length} session(s)`));
  1430→}
  1431→
  1432→/**
  1433→ * Session log list action handler.
  1434→ */
  1435→async function sessionLogListAction(
  1436→  options: SessionLogListOptions,
  1437→): Promise<void> {
  1438→  try {
  1439→    const ctx = await initContext();
  1440→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1441→
  1442→    // AC: @session-log-list ac-2 - Filter by status
  1443→    if (options.status) {
  1444→      const statusFilter = options.status as SessionStatus;
  1445→      sessions = sessions.filter((s) => s.status === statusFilter);
  1446→    }
  1447→
  1448→    // AC: @session-log-list ac-4 - Filter by agent type
  1449→    if (options.agent) {
  1450→      const agentFilter = options.agent;
  1451→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1452→    }
  1453→
  1454→    // AC: @session-log-list ac-3 - Filter by since date
  1455→    if (options.since) {
  1456→      const sinceDate = parseTimeSpec(options.since);
  1457→      if (sinceDate) {
  1458→        sessions = sessions.filter(
  1459→          (s) => new Date(s.started_at) >= sinceDate,
  1460→        );
  1461→      }
  1462→    }
  1463→
  1464→    // AC: @session-log-list ac-5 - Sort
  1465→    const sortField: SortField =
  1466→      options.sort && VALID_SORT_FIELDS.includes(options.sort as SortField)
  1467→        ? (options.sort as SortField)
  1468→        : "started_at";
  1469→    sessions = sortSessions(sessions, sortField);
  1470→
  1471→    // AC: @session-log-list ac-7 - Limit output count
  1472→    if (options.count) {
  1473→      // AC: @trait-filterable-list ac-8
  1474→      output({ count: sessions.length }, () => {
  1475→        console.log(sessions.length);
  1476→      });
  1477→      return;
  1478→    }
  1479→
  1480→    // Apply --limit (after filtering/sorting, before display)
  1481→    if (options.limit) {
  1482→      const limit = parseInt(options.limit, 10);
  1483→      if (!Number.isNaN(limit) && limit > 0) {
  1484→        sessions = sessions.slice(0, limit);
  1485→      }
  1486→    }
  1487→
  1488→    output(sessions, () => formatSessionLogList(sessions));
  1489→  } catch (err) {
  1490→    error("Failed to list session logs", err);
  1491→    process.exit(EXIT_CODES.ERROR);
  1492→  }
  1493→}
  1494→
  1495→// ─── Session Log Show ─────────────────────────────────────────────────────────
  1496→
  1497→interface SessionLogShowOptions {
  1498→  events?: boolean;
  1499→  type?: string;
  1500→  limit?: string;
  1501→  context?: string;
  1502→}
  1503→
  1504→/**
  1505→ * Format an event timestamp as relative time from session start.
  1506→ */
  1507→function formatEventTimestamp(
  1508→  eventTs: number,
  1509→  sessionStartTs: number,
  1510→): string {
  1511→  const relativeMs = eventTs - sessionStartTs;
  1512→  const totalSec = Math.floor(relativeMs / 1000);
  1513→  const minutes = Math.floor(totalSec / 60);
  1514→  const seconds = totalSec % 60;
  1515→  if (minutes > 0) {
  1516→    return `+${minutes}m${seconds}s`;
  1517→  }
  1518→  return `+${seconds}s`;
  1519→}
  1520→
  1521→/**
  1522→ * Summarize event data for display.
  1523→ * Returns a short string describing the event payload.
  1524→ */
  1525→function summarizeEventData(event: SessionEvent): string {
  1526→  const data = event.data as Record<string, unknown> | null;
  1527→  if (!data) return "";
  1528→
  1529→  // Handle tool_call events
  1530→  if (event.type === "session.update") {
  1531→    const update = data.update as {
  1532→      sessionUpdate?: string;
  1533→      rawInput?: { command?: string };
  1534→      _meta?: { claudeCode?: { toolName?: string } };
  1535→    } | null;
  1536→    if (update?.sessionUpdate === "tool_call") {
  1537→      const toolName = update._meta?.claudeCode?.toolName || "unknown";
  1538→      const command = update.rawInput?.command;
  1539→      if (command) {
  1540→        const truncated =
  1541→          command.length > 60 ? command.slice(0, 57) + "..." : command;
  1542→        return `${toolName}: ${truncated}`;
  1543→      }
  1544→      return toolName;
  1545→    }
  1546→  }
  1547→
  1548→  // Handle prompt.sent events
  1549→  if (event.type === "prompt.sent") {
  1550→    const prompt = data.prompt as string | null;
  1551→    if (prompt) {
  1552→      const truncated =
  1553→        prompt.length > 60 ? prompt.slice(0, 57) + "..." : prompt;
  1554→      return truncated;
  1555→    }
  1556→  }
  1557→
  1558→  // Handle session.start/end
  1559→  if (event.type === "session.start") {
  1560→    return "Session started";
  1561→  }
  1562→  if (event.type === "session.end") {
  1563→    const reason = data.reason as string | null;
  1564→    return reason ? `Session ended: ${reason}` : "Session ended";
  1565→  }
  1566→
  1567→  // Default: show first key
  1568→  const keys = Object.keys(data);
  1569→  if (keys.length > 0) {
  1570→    return `{${keys.slice(0, 3).join(", ")}${keys.length > 3 ? ", ..." : ""}}`;
  1571→  }
  1572→  return "";
  1573→}
  1574→
  1575→/**
  1576→ * Format the session log show output.
  1577→ *
  1578→ * AC: @session-log-show ac-1
  1579→ */
  1580→function formatSessionLogShow(
  1581→  detail: SessionLogDetail,
  1582→  events: SessionEvent[] | null,
  1583→  contextSnapshot: unknown | null,
  1584→  sessionStartTs: number,
  1585→): void {
  1586→  // AC: @session-log-show ac-1 - Session metadata
  1587→  console.log(chalk.bold(`Session ${detail.id.slice(0, 8)}`));
  1588→  console.log(chalk.gray("─".repeat(60)));
  1589→  console.log(`  ID:        ${detail.id}`);
  1590→
  1591→  const statusColor =
  1592→    detail.status === "completed"
  1593→      ? chalk.green
  1594→      : detail.status === "active"
  1595→        ? chalk.blue
  1596→        : chalk.yellow;
  1597→  console.log(`  Status:    ${statusColor(detail.status)}`);
  1598→  console.log(`  Agent:     ${detail.agent_type}`);
  1599→  if (detail.task_id) {
  1600→    console.log(`  Task:      ${detail.task_id}`);
  1601→  }
  1602→  console.log(`  Started:   ${detail.started_at}`);
  1603→  if (detail.ended_at) {
  1604→    console.log(`  Ended:     ${detail.ended_at}`);
  1605→  }
  1606→  console.log(`  Duration:  ${formatDuration(detail.duration_ms)}`);
  1607→  console.log(`  Events:    ${detail.event_count}`);
  1608→  console.log(`  Iterations: ${detail.iteration_count}`);
  1609→
  1610→  // AC: @session-log-show ac-2 - Per-iteration summary
  1611→  if (detail.iterations.length > 0) {
  1612→    console.log("\n" + chalk.bold("Iterations"));
  1613→    console.log(chalk.gray("─".repeat(60)));
  1614→    for (const iter of detail.iterations) {
  1615→      const taskInfo: string[] = [];
  1616→      if (iter.tasks_started.length > 0) {
  1617→        taskInfo.push(`started: ${iter.tasks_started.join(", ")}`);
  1618→      }
  1619→      if (iter.tasks_completed.length > 0) {
  1620→        taskInfo.push(`completed: ${iter.tasks_completed.join(", ")}`);
  1621→      }
  1622→      const taskStr = taskInfo.length > 0 ? ` | ${taskInfo.join(" | ")}` : "";
  1623→      console.log(
  1624→        `  ${chalk.cyan(`[${iter.iteration}]`)} ${iter.event_count} events${taskStr}`,
  1625→      );
  1626→    }
  1627→  }
  1628→
  1629→  // AC: @session-log-show ac-3 - Event timeline
  1630→  if (events !== null) {
  1631→    console.log("\n" + chalk.bold("Events"));
  1632→    console.log(chalk.gray("─".repeat(60)));
  1633→    if (events.length === 0) {
  1634→      console.log(chalk.gray("  No events to display."));
  1635→    } else {
  1636→      for (const event of events) {
  1637→        const timestamp = formatEventTimestamp(event.ts, sessionStartTs);
  1638→        const summary = summarizeEventData(event);
  1639→        const typeColor =
  1640→          event.type === "session.start" || event.type === "session.end"
  1641→            ? chalk.green
  1642→            : event.type === "session.update"
  1643→              ? chalk.blue
  1644→              : chalk.gray;
  1645→        console.log(
  1646→          `  ${chalk.yellow(timestamp.padEnd(10))} ${typeColor(event.type.padEnd(16))} ${chalk.gray(summary)}`,
  1647→        );
  1648→      }
  1649→    }
  1650→  }
  1651→
  1652→  // AC: @session-log-show ac-6 - Context snapshot
  1653→  if (contextSnapshot !== null) {
  1654→    console.log("\n" + chalk.bold("Context Snapshot"));
  1655→    console.log(chalk.gray("─".repeat(60)));
  1656→    console.log(JSON.stringify(contextSnapshot, null, 2));
  1657→  }
  1658→}
  1659→
  1660→/**
  1661→ * Session log show action handler.
  1662→ */
  1663→async function sessionLogShowAction(
  1664→  sessionRef: string,
  1665→  options: SessionLogShowOptions,
  1666→): Promise<void> {
  1667→  try {
  1668→    const ctx = await initContext();
  1669→
  1670→    // AC: @session-log-show ac-7, ac-8, ac-9 - Resolve session ID
  1671→    const resolution = await resolveSessionId(ctx.specDir, sessionRef);
  1672→
  1673→    if (!resolution.ok) {
  1674→      if (resolution.error === "not_found") {
  1675→        // AC: @session-log-show ac-9
  1676→        error(`Session not found: ${sessionRef}`);
  1677→        process.exit(EXIT_CODES.NOT_FOUND);
  1678→      } else {
  1679→        // AC: @session-log-show ac-8
  1680→        error(
  1681→          `Ambiguous session ID prefix. Matches:\n  ${resolution.matches.join("\n  ")}\nPlease provide a more specific prefix.`,
  1682→        );
  1683→        process.exit(EXIT_CODES.VALIDATION_FAILED);
  1684→      }
  1685→    }
  1686→
  1687→    const sessionId = resolution.id;
  1688→
  1689→    // Get session detail
  1690→    const detail = await getSessionLogDetail(ctx.specDir, sessionId);
  1691→    if (!detail) {
  1692→      error(`Session not found: ${sessionId}`);
  1693→      process.exit(EXIT_CODES.NOT_FOUND);
  1694→    }
  1695→
  1696→    // AC: @session-log-show ac-3, ac-4, ac-5 - Event timeline
  1697→    let events: SessionEvent[] | null = null;
  1698→    if (options.events) {
  1699→      let allEvents = deduplicatePhasedToolCalls(
  1700→        await readEvents(ctx.specDir, sessionId),
  1701→      );
  1702→
  1703→      // AC: @session-log-show ac-4 - Filter by type
  1704→      if (options.type) {
  1705→        const typeFilter = options.type;
  1706→        allEvents = allEvents.filter((e) => e.type === typeFilter);
  1707→      }
  1708→
  1709→      // AC: @session-log-show ac-5 - Limit to last N events
  1710→      if (options.limit) {
  1711→        const limit = parseInt(options.limit, 10);
  1712→        if (!Number.isNaN(limit) && limit > 0) {
  1713→          allEvents = allEvents.slice(-limit);
  1714→        }
  1715→      }
  1716→
  1717→      events = allEvents;
  1718→    }
  1719→
  1720→    // AC: @session-log-show ac-6 - Context snapshot
  1721→    let contextSnapshot: unknown | null = null;
  1722→    if (options.context) {
  1723→      const iterNum = parseInt(options.context, 10);
  1724→      if (!Number.isNaN(iterNum) && iterNum > 0) {
  1725→        contextSnapshot = await readSessionContext(
  1726→          ctx.specDir,
  1727→          sessionId,
  1728→          iterNum,
  1729→        );
  1730→        if (contextSnapshot === null) {
  1731→          error(`No context snapshot found for iteration ${iterNum}`);
  1732→          process.exit(EXIT_CODES.NOT_FOUND);
  1733→        }
  1734→      } else {
  1735→        error(`Invalid iteration number: ${options.context}`);
  1736→        process.exit(EXIT_CODES.USAGE_ERROR);
  1737→      }
  1738→    }
  1739→
  1740→    const sessionStartTs = new Date(detail.started_at).getTime();
  1741→
  1742→    // Build JSON output structure
  1743→    const jsonOutput = {
  1744→      ...detail,
  1745→      ...(events !== null ? { events } : {}),
  1746→      ...(contextSnapshot !== null ? { context: contextSnapshot } : {}),
  1747→    };
  1748→
  1749→    output(jsonOutput, () =>
  1750→      formatSessionLogShow(detail, events, contextSnapshot, sessionStartTs),
  1751→    );
  1752→  } catch (err) {
  1753→    error("Failed to show session log", err);
  1754→    process.exit(EXIT_CODES.ERROR);
  1755→  }
  1756→}
  1757→
  1758→// ─── Session Log Stats ─────────────────────────────────────────────────────────
  1759→
  1760→interface SessionLogStatsOptions {
  1761→  since?: string;
  1762→  agent?: string;
  1763→  toolUsage?: boolean;
  1764→  byDay?: boolean;
  1765→  byWeek?: boolean;
  1766→}
  1767→
  1768→/**
  1769→ * Full stats output including optional tool usage and time period data.
  1770→ */
  1771→interface SessionLogStatsOutput {
  1772→  stats: SessionLogStats;
  1773→  tool_usage?: ToolUsageStats[];
  1774→  time_periods?: TimePeriodStats[];
  1775→}
  1776→
  1777→/**
  1778→ * Format a duration in milliseconds to human-readable format.
  1779→ * Reuses formatDuration from session log list but handles hours/minutes/seconds.
  1780→ */
  1781→function formatDurationLong(ms: number): string {
  1782→  if (ms < 0) return "—";
  1783→  const totalSec = Math.floor(ms / 1000);
  1784→  const hours = Math.floor(totalSec / 3600);
  1785→  const minutes = Math.floor((totalSec % 3600) / 60);
  1786→  const seconds = totalSec % 60;
  1787→  if (hours > 0 && minutes > 0) {
  1788→    return `${hours}h ${minutes}m`;
  1789→  }
  1790→  if (hours > 0) {
  1791→    return `${hours}h`;
  1792→  }
  1793→  if (minutes > 0) {
  1794→    return `${minutes}m ${seconds}s`;
  1795→  }
  1796→  return `${seconds}s`;
  1797→}
  1798→
  1799→/**
  1800→ * Format the session log stats output.
  1801→ *
  1802→ * AC: @session-log-stats ac-1, ac-2, ac-3
  1803→ */
  1804→function formatSessionLogStats(
  1805→  stats: SessionLogStats,
  1806→  toolUsage: ToolUsageStats[] | null,
  1807→  timePeriods: TimePeriodStats[] | null,
  1808→  groupBy: "day" | "week" | null,
  1809→): void {
  1810→  // AC: @session-log-stats ac-1 - Totals
  1811→  console.log(chalk.bold("Session Statistics"));
  1812→  console.log(chalk.gray("─".repeat(50)));
  1813→  console.log(`  Total Sessions:     ${stats.total_sessions}`);
  1814→  console.log(`  Total Events:       ${stats.total_events}`);
  1815→  console.log(`  Total Iterations:   ${stats.total_iterations}`);
  1816→  console.log(`  Tasks Completed:    ${stats.total_tasks_completed}`);
  1817→  console.log(`  Total Duration:     ${formatDurationLong(stats.total_duration_ms)}`);
  1818→
  1819→  // AC: @session-log-stats ac-2 - Averages
  1820→  console.log("\n" + chalk.bold("Averages"));
  1821→  console.log(chalk.gray("─".repeat(50)));
  1822→  console.log(`  Avg Duration/Session:     ${formatDurationLong(stats.avg_duration_ms)}`);
  1823→  console.log(`  Avg Iterations/Session:   ${stats.avg_iterations_per_session}`);
  1824→  console.log(`  Avg Tasks/Session:        ${stats.avg_tasks_per_session}`);
  1825→
  1826→  // AC: @session-log-stats ac-3 - Status breakdown
  1827→  if (stats.status_breakdown.length > 0) {
  1828→    console.log("\n" + chalk.bold("Status Breakdown"));
  1829→    console.log(chalk.gray("─".repeat(50)));
  1830→    for (const item of stats.status_breakdown) {
  1831→      const statusColor =
  1832→        item.status === "completed"
  1833→          ? chalk.green
  1834→          : item.status === "active"
  1835→            ? chalk.blue
  1836→            : chalk.yellow;
  1837→      console.log(
  1838→        `  ${statusColor(item.status.padEnd(12))} ${String(item.count).padEnd(6)} ${item.percentage}%`,
  1839→      );
  1840→    }
  1841→  }
  1842→
  1843→  // AC: @session-log-stats ac-6 - Tool usage
  1844→  if (toolUsage !== null && toolUsage.length > 0) {
  1845→    console.log("\n" + chalk.bold("Top Tool Usage"));
  1846→    console.log(chalk.gray("─".repeat(50)));
  1847→    for (const tool of toolUsage) {
  1848→      console.log(
  1849→        `  ${tool.tool_name.padEnd(20)} ${String(tool.count).padEnd(8)} ${tool.percentage}%`,
  1850→      );
  1851→    }
  1852→  }
  1853→
  1854→  // AC: @session-log-stats ac-7 - Time periods
  1855→  if (timePeriods !== null && timePeriods.length > 0) {
  1856→    const label = groupBy === "week" ? "By Week" : "By Day";
  1857→    console.log("\n" + chalk.bold(label));
  1858→    console.log(chalk.gray("─".repeat(50)));
  1859→    console.log(
  1860→      chalk.gray(
  1861→        `  ${"Period".padEnd(14)} ${"Sessions".padEnd(10)} ${"Tasks".padEnd(8)} Duration`,
  1862→      ),
  1863→    );
  1864→    for (const period of timePeriods) {
  1865→      console.log(
  1866→        `  ${period.period.padEnd(14)} ${String(period.sessions_count).padEnd(10)} ${String(period.tasks_completed).padEnd(8)} ${formatDurationLong(period.total_duration_ms)}`,
  1867→      );
  1868→    }
  1869→  }
  1870→}
  1871→
  1872→/**
  1873→ * Session log stats action handler.
  1874→ */
  1875→async function sessionLogStatsAction(
  1876→  options: SessionLogStatsOptions,
  1877→): Promise<void> {
  1878→  try {
  1879→    const ctx = await initContext();
  1880→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1881→
  1882→    // AC: @session-log-stats ac-4 - Filter by since
  1883→    if (options.since) {
  1884→      const sinceDate = parseTimeSpec(options.since);
  1885→      if (sinceDate) {
  1886→        sessions = sessions.filter(
  1887→          (s) => new Date(s.started_at) >= sinceDate,
  1888→        );
  1889→      }
  1890→    }
  1891→
  1892→    // AC: @session-log-stats ac-5 - Filter by agent type
  1893→    if (options.agent) {
  1894→      const agentFilter = options.agent;
  1895→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1896→    }
  1897→
  1898→    // AC: @session-log-stats ac-8 - No sessions match criteria
  1899→    if (sessions.length === 0) {
  1900→      output({ message: "No sessions match criteria" }, () => {
  1901→        console.log("No sessions match criteria.");
  1902→      });
  1903→      return;
  1904→    }
  1905→
  1906→    // Compute base stats
  1907→    const stats = computeSessionLogStats(sessions);
  1908→
  1909→    // AC: @session-log-stats ac-6 - Tool usage (optional)
  1910→    let toolUsage: ToolUsageStats[] | null = null;
  1911→    if (options.toolUsage) {
  1912→      const sessionIds = sessions.map((s) => s.id);
  1913→      toolUsage = await computeToolUsageStats(ctx.specDir, sessionIds);
  1914→    }
  1915→
  1916→    // AC: @session-log-stats ac-7 - Time periods (optional)
  1917→    let timePeriods: TimePeriodStats[] | null = null;
  1918→    let groupBy: "day" | "week" | null = null;
  1919→    if (options.byDay) {
  1920→      groupBy = "day";
  1921→      timePeriods = computeTimePeriodStats(sessions, "day");
  1922→    } else if (options.byWeek) {
  1923→      groupBy = "week";
  1924→      timePeriods = computeTimePeriodStats(sessions, "week");
  1925→    }
  1926→
  1927→    // Build output structure
  1928→    const jsonOutput: SessionLogStatsOutput = { stats };
  1929→    if (toolUsage !== null) {
  1930→      jsonOutput.tool_usage = toolUsage;
  1931→    }
  1932→    if (timePeriods !== null) {
  1933→      jsonOutput.time_periods = timePeriods;
  1934→    }
  1935→
  1936→    output(jsonOutput, () =>
  1937→      formatSessionLogStats(stats, toolUsage, timePeriods, groupBy),
  1938→    );
  1939→  } catch (err) {
  1940→    error("Failed to compute session log stats", err);
  1941→    process.exit(EXIT_CODES.ERROR);
  1942→  }
  1943→}
  1944→
  1945→// ─── Session Log Search ─────────────────────────────────────────────────────────
  1946→
  1947→interface SessionLogSearchOptions {
  1948→  type?: string;
  1949→  since?: string;
  1950→  agent?: string;
  1951→  limit?: string;
  1952→}
  1953→
  1954→/**
  1955→ * Format relative timestamp from event timestamp (Unix ms) to session start.
  1956→ */
  1957→function formatSearchTimestamp(eventTs: number): string {
  1958→  return new Date(eventTs).toISOString();
  1959→}
  1960→
  1961→/**
  1962→ * Format the session log search output.
  1963→ *
  1964→ * AC: @session-log-search ac-1, ac-4
  1965→ */
  1966→function formatSessionLogSearch(results: SessionSearchResult[]): void {
  1967→  if (results.length === 0) {
  1968→    // AC: @session-log-search ac-6
  1969→    console.log("No matches found.");
  1970→    return;
  1971→  }
  1972→
  1973→  let totalMatches = 0;
  1974→  for (const session of results) {
  1975→    totalMatches += session.matches.length;
  1976→  }
  1977→
  1978→  console.log(chalk.bold(`Found ${totalMatches} match(es) in ${results.length} session(s)`));
  1979→  console.log(chalk.gray("─".repeat(60)));
  1980→
  1981→  for (const session of results) {
  1982→    // Session header
  1983→    console.log(
  1984→      `\n${chalk.cyan(`Session ${session.session_id.slice(0, 8)}`)} ` +
  1985→        `${chalk.gray(`(${session.agent_type}, started ${formatRelativeTime(new Date(session.started_at))})`)}`
  1986→    );
  1987→
  1988→    // AC: @session-log-search ac-4 - Show matches with session ID, timestamp, type, excerpt
  1989→    for (const match of session.matches) {
  1990→      const ts = formatSearchTimestamp(match.timestamp);
  1991→      const typeColor =
  1992→        match.event_type === "session.start" || match.event_type === "session.end"
  1993→          ? chalk.green
  1994→          : match.event_type === "session.update"
  1995→            ? chalk.blue
  1996→            : chalk.gray;
  1997→      console.log(
  1998→        `  ${chalk.yellow(ts)} ${typeColor(match.event_type.padEnd(16))}`,
  1999→      );
  2000→      // Content excerpt on next line, indented
  2001→      console.log(`    ${chalk.gray(match.content_excerpt)}`);
  2002→    }
  2003→  }
  2004→}
  2005→
  2006→/**
  2007→ * Session log search action handler.
  2008→ *
  2009→ * AC: @session-log-search ac-1 through ac-7
  2010→ */
  2011→async function sessionLogSearchAction(
  2012→  pattern: string,
  2013→  options: SessionLogSearchOptions,
  2014→): Promise<void> {
  2015→  try {
  2016→    const ctx = await initContext();
  2017→
  2018→    // Parse options - validate limit as positive integer
  2019→    let limit = 50;
  2020→    if (options.limit) {
  2021→      const parsed = parseInt(options.limit, 10);
  2022→      if (Number.isNaN(parsed) || parsed <= 0) {
  2023→        error(`Invalid limit: ${options.limit}. Must be a positive integer.`);
  2024→        process.exit(EXIT_CODES.USAGE_ERROR);
  2025→      }
  2026→      limit = parsed;
  2027→    }
  2028→    const sinceDate = options.since ? parseTimeSpec(options.since) : undefined;
  2029→
  2030→    // AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7
  2031→    const results = await searchSessionEvents(ctx.specDir, pattern, {
  2032→      eventType: options.type,
  2033→      sinceDate: sinceDate || undefined,
  2034→      agentType: options.agent,
  2035→      limit,
  2036→    });
  2037→
  2038→    // AC: @session-log-search ac-6 - No matches found message
  2039→    // exit code 0 regardless (per @trait-semantic-exit-codes ac-5)
  2040→
  2041→    output(results, () => formatSessionLogSearch(results));
  2042→  } catch (err) {
  2043→    error("Failed to search session logs", err);
  2044→    process.exit(EXIT_CODES.ERROR);
  2045→  }
  2046→}
  2047→
  2048→// ─── Session Create Action ─────────────────────────────────────────────────
  2049→
  2050→/**
  2051→ * Action handler for `kspec session create`.
  2052→ *
  2053→ * Creates a new session with optional budget and environment injection.
  2054→ *
  2055→ * AC: @session-creation-and-env-injection ac-create
  2056→ * AC: @session-creation-and-env-injection ac-budget
  2057→ * AC: @session-creation-and-env-injection ac-budget-local
  2058→ * AC: @session-creation-and-env-injection ac-inject-claude
  2059→ * AC: @session-creation-and-env-injection ac-inject-codex
  2060→ * AC: @session-creation-and-env-injection ac-inject-fallback
  2061→ *
  2062→ * Exit codes documented per @trait-semantic-exit-codes ac-8:
  2063→ * - 0: Session created successfully
  2064→ * - 1: Validation error (invalid budget value)
  2065→ * - 3: Runtime error (filesystem failure)
  2066→ */
  2067→async function sessionCreateAction(options: {
  2068→  agentType: string;
  2069→  budget?: string;
  2070→  inject?: boolean;
  2071→  taskId?: string;
  2072→}): Promise<void> {
  2073→  try {
  2074→    const ctx = await initContext();
  2075→
  2076→    // AC: @session-creation-and-env-injection ac-invalid-session
  2077→    // Validate existing KSPEC_SESSION_ID if set — warn user if it's stale/corrupt
  2078→    const existingSessionId = process.env.KSPEC_SESSION_ID;
  2079→    if (existingSessionId) {
  2080→      const validation = await validateSessionId(ctx.specDir, existingSessionId);
  2081→      if (!validation.valid) {
  2082→        warn(
  2083→          `Current KSPEC_SESSION_ID (${existingSessionId}) is invalid: ${validation.error}`,
  2084→        );
  2085→        info(validation.suggestion || "Creating a new session will generate a fresh ID.");
  2086→      }
  2087→    }
  2088→
  2089→    // Validate budget if provided
  2090→    // AC: @trait-error-guidance ac-5 - indicate which field/value failed
  2091→    let budgetNum: number | undefined;
  2092→    if (options.budget !== undefined) {
  2093→      // Use Number() instead of parseInt to reject "3.5", "3abc", "1e2" etc.
  2094→      budgetNum = Number(options.budget);
  2095→      if (isNaN(budgetNum) || budgetNum <= 0 || !Number.isInteger(budgetNum) || !/^\d+$/.test(options.budget)) {
  2096→        // AC: @trait-error-guidance ac-2, ac-5 - include suggested action and field info
  2097→        // AC: @trait-error-guidance ac-6 - guidance included in structured error
  2098→        error(
  2099→          `Invalid budget value: "${options.budget}". Must be a positive integer.`,
  2100→          { suggestion: "Usage: kspec session create --budget <positive-integer>" },
  2101→        );
  2102→        process.exit(EXIT_CODES.USAGE_ERROR);
  2103→      }
  2104→    }
  2105→
  2106→    // Generate session ID
  2107→    const sessionId = ulid();
  2108→
  2109→    // AC: @session-creation-and-env-injection ac-create, ac-budget, ac-budget-local
  2110→    const result = await createSessionWithBudget(ctx.specDir, {
  2111→      id: sessionId,
  2112→      agent_type: options.agentType,
  2113→      task_id: options.taskId,
  2114→      budget: budgetNum,
  2115→    });
  2116→
  2117→    // Handle environment injection if requested
  2118→    let injection: EnvInjectionResult | null = null;
  2119→    if (options.inject) {
  2120→      injection = await performEnvInjection(sessionId);
  2121→    }
  2122→
  2123→    // Build output data
  2124→    const outputData: Record<string, unknown> = {
  2125→      session_id: result.session_id,
  2126→      agent_type: result.session.agent_type,
  2127→      status: result.session.status,
  2128→      started_at: result.session.started_at,
  2129→    };
  2130→
  2131→    if (result.session.task_id) {
  2132→      outputData.task_id = result.session.task_id;
  2133→    }
  2134→
  2135→    if (result.budget) {
  2136→      outputData.budget = {
  2137→        max_per_cycle: result.budget.max_per_cycle,
  2138→        started_this_cycle: result.budget.started_this_cycle,
  2139→      };
  2140→    }
  2141→
  2142→    if (injection) {
  2143→      outputData.env_injection = {
  2144→        method: injection.method,
  2145→        injected: injection.injected,
  2146→        description: injection.description,
  2147→        ...(injection.path ? { path: injection.path } : {}),
  2148→      };
  2149→    }
  2150→
  2151→    // AC: @trait-json-output ac-1, ac-2, ac-5 - JSON with all data, ISO timestamps
  2152→    output(outputData, () => {
  2153→      // AC: @session-creation-and-env-injection ac-create - print session ID to stdout
  2154→      success(`Created session: ${sessionId}`, { session_id: sessionId });
  2155→      info(`Agent type: ${options.agentType}`);
  2156→
  2157→      if (result.budget) {
  2158→        info(
  2159→          `Budget: ${result.budget.max_per_cycle} tasks per cycle`,
  2160→        );
  2161→      }
  2162→
  2163→      if (injection) {
  2164→        if (injection.injected) {
  2165→          info(injection.description);
  2166→        } else {
  2167→          // AC: @session-creation-and-env-injection ac-inject-fallback
  2168→          console.log(injection.description);
  2169→        }
  2170→      }
  2171→    });
  2172→  } catch (err) {
  2173→    // AC: @trait-error-guidance ac-1 - describe what went wrong
  2174→    // AC: @trait-json-output ac-3 - error as JSON object
  2175→    error("Failed to create session", err);
  2176→    process.exit(EXIT_CODES.ERROR);
  2177→  }
  2178→}
  2179→
  2180→/**
  2181→ * Detect agent harness and perform environment injection.
  2182→ *
  2183→ * AC: @session-creation-and-env-injection ac-inject-claude
  2184→ * AC: @session-creation-and-env-injection ac-inject-codex
  2185→ * AC: @session-creation-and-env-injection ac-inject-fallback
  2186→ */
  2187→async function performEnvInjection(
  2188→  sessionId: string,
  2189→): Promise<EnvInjectionResult> {
  2190→  // Detect Claude Code
  2191→  if (
  2192→    process.env.CLAUDECODE === "1" ||
  2193→    process.env.CLAUDE_CODE_ENTRYPOINT ||
  2194→    process.env.CLAUDE_PROJECT_DIR
  2195→  ) {
  2196→    return injectClaudeCodeEnv(sessionId);
  2197→  }
  2198→
  2199→  // Detect Codex CLI
  2200→  if (process.env.CODEX_SANDBOX) {
  2201→    return injectCodexEnv(sessionId);
  2202→  }
  2203→
  2204→  // Fallback for unknown harnesses
  2205→  return getFallbackInjectionInstructions(sessionId);
  2206→}
  2207→
  2208→/**
  2209→ * Register the 'session' command group and aliases
  2210→ */
  2211→export function registerSessionCommands(program: Command): void {
  2212→  const session = program
  2213→    .command("session")
  2214→    .description("Session management and context");
  2215→
  2216→  // Session create subcommand
  2217→  markMutating(session.command("create"))
  2218→    .description("Create a new kspec session with optional budget")
  2219→    .option(
  2220→      "--agent-type <type>",
  2221→      "Agent type (e.g., claude-code, codex-cli)",
  2222→      "claude-code",
  2223→    )
  2224→    .option("--budget <n>", "Maximum tasks per cycle (positive integer)")
  2225→    .option("--inject", "Inject KSPEC_SESSION_ID into agent environment")
  2226→    .option("--task-id <id>", "Optional task ID being worked on")
  2227→    .action(sessionCreateAction);
  2228→
  2229→  session
  2230→    .command("start")
  2231→    .alias("resume")
  2232→    .description("Surface relevant context for starting a new working session")
  2233→    .option("--brief", "Compact summary (default)")
  2234→    .option("--full", "Comprehensive context dump")
  2235→    .option(
  2236→      "--since <time>",
  2237→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  2238→    )
  2239→    .option("--no-git", "Skip git commit information")
  2240→    .option("-n, --limit <n>", "Limit items per section", "10")
  2241→    .action(sessionStartAction);
  2242→
  2243→  // Session log subcommand group
  2244→  const log = session
  2245→    .command("log")
  2246→    .description("Session log analysis commands");
  2247→
  2248→  log
  2249→    .command("list")
  2250→    .description("List session logs with summary statistics")
  2251→    .option(
  2252→      "-s, --status <status>",
  2253→      "Filter by status (active, completed, abandoned)",
  2254→    )
  2255→    .option("--agent <type>", "Filter by agent type")
  2256→    .option(
  2257→      "--since <time>",
  2258→      "Only show sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2259→    )
  2260→    .option(
  2261→      "--sort <field>",
  2262→      "Sort by field (started_at, duration, events, iterations, tasks_completed)",
  2263→      "started_at",
  2264→    )
  2265→    .option("--count", "Show only the count of matching sessions")
  2266→    .option("-n, --limit <n>", "Limit number of sessions shown")
  2267→    .action(sessionLogListAction);
  2268→
  2269→  log
  2270→    .command("show <session-id>")
  2271→    .description("Show detailed view of a single session")
  2272→    .option("-e, --events", "Include chronological event timeline")
  2273→    .option("-t, --type <type>", "Filter events by type (e.g., tool.call)")
  2274→    .option("-n, --limit <n>", "Show only the last N events")
  2275→    .option("-c, --context <n>", "Show context snapshot for iteration N")
  2276→    .action(sessionLogShowAction);
  2277→
  2278→  log
  2279→    .command("stats")
  2280→    .description("Aggregate analytics across sessions")
  2281→    .option(
  2282→      "--since <time>",
  2283→      "Only include sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2284→    )
  2285→    .option("--agent <type>", "Only include sessions with this agent type")
  2286→    .option("--tool-usage", "Display top 10 tool calls by frequency")
  2287→    .option("--by-day", "Group stats by day")
  2288→    .option("--by-week", "Group stats by week")
  2289→    .action(sessionLogStatsAction);
  2290→
  2291→  log
  2292→    .command("search <pattern>")
  2293→    .description("Search across session events by content")
  2294→    .option("-t, --type <type>", "Only search events of this type (e.g., session.update)")
  2295→    .option(
  2296→      "--since <time>",
  2297→      "Only search sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2298→    )
  2299→    .option("--agent <type>", "Only search sessions with this agent type")
  2300→    .option("-n, --limit <n>", "Maximum matches to return (default: 50)")
  2301→    .action(sessionLogSearchAction);
  2302→
  2303→  session
  2304→    .command("checkpoint")
  2305→    .description(
  2306→      "Pre-stop hook: check for uncommitted work before ending session",
  2307→    )
  2308→    .option("--force", "Allow session end regardless of issues")
  2309→    .action(sessionCheckpointAction);
  2310→
  2311→  session
  2312→    .command("prompt-check")
  2313→    .description("UserPromptSubmit hook: inject spec-first reminder")
  2314→    .action(sessionPromptCheckAction);
  2315→
  2316→  // Top-level alias: kspec context
