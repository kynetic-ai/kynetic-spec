     1→/**
     2→ * Behavioral integration tests for ralph session budget integration.
     3→ *
     4→ * Tests verify that the session budget lifecycle works correctly
     5→ * when exercised in the same sequence ralph uses:
     6→ * create session with budget → reset at iteration boundary →
     7→ * budget enforcement via task start → cleanup on exit.
     8→ *
     9→ * Producer-side tests use a mock ACP agent (tests/fixtures/mock-acp-agent.mjs)
    10→ * to verify env injection and cleanup through the real ralph code paths.
    11→ *
    12→ * AC: @ralph-session-budget-integration ac-create-budget, ac-reset-iteration,
    13→ *     ac-env-inject, ac-remove-marker-code, ac-session-close-all-paths
    14→ */
    15→import { describe, it, expect, beforeEach, afterEach } from "vitest";
    16→import { spawn as nodeSpawn } from "node:child_process";
    17→import * as fs from "node:fs/promises";
    18→import * as path from "node:path";
    19→import * as os from "node:os";
    20→import {
    21→  createSessionWithBudget,
    22→  resetBudget,
    23→  getBudget,
    24→  incrementBudget,
    25→  getSessionBudgetPath,
    26→} from "../../src/sessions/store.js";
    27→import { spawnAgent } from "../../src/agents/spawner.js";
    28→import {
    29→  kspec,
    30→  setupTempFixtures,
    31→  cleanupTempDir,
    32→  testUlid,
    33→  CLI_PATH,
    34→  FIXTURES_DIR,
    35→} from "../helpers/cli";
    36→
    37→/** Path to the mock ACP agent script */
    38→const MOCK_AGENT_PATH = path.join(FIXTURES_DIR, "mock-acp-agent.mjs");
    39→
    40→// ─── Budget Creation (ac-create-budget) ─────────────────────────────────────
    41→
    42→describe("ac-create-budget: session creation with budget", () => {
    43→  let specDir: string;
    44→
    45→  beforeEach(async () => {
    46→    specDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-ralph-budget-"));
    47→  });
    48→
    49→  afterEach(async () => {
    50→    await fs.rm(specDir, { recursive: true });
    51→  });
    52→
    53→  // AC: @ralph-session-budget-integration ac-create-budget
    54→  it("should write budget.json with max_per_cycle=N when budget > 0", async () => {
    55→    const sessionId = testUlid("RBUDG", 1);
    56→    const result = await createSessionWithBudget(specDir, {
    57→      id: sessionId,
    58→      agent_type: "claude-code",
    59→      budget: 3,
    60→    });
    61→
    62→    expect(result.budget).not.toBeNull();
    63→    expect(result.budget!.max_per_cycle).toBe(3);
    64→    expect(result.budget!.started_this_cycle).toBe(0);
    65→
    66→    // Verify file on disk
    67→    const budgetPath = getSessionBudgetPath(specDir, sessionId);
    68→    const content = await fs.readFile(budgetPath, "utf-8");
    69→    const parsed = JSON.parse(content);
    70→    expect(parsed.max_per_cycle).toBe(3);
    71→    expect(parsed.started_this_cycle).toBe(0);
    72→  });
    73→
    74→  // AC: @ralph-session-budget-integration ac-create-budget
    75→  it("should NOT write budget.json when budget is 0 (unlimited)", async () => {
    76→    const sessionId = testUlid("RBUDG", 2);
    77→    const result = await createSessionWithBudget(specDir, {
    78→      id: sessionId,
    79→      agent_type: "claude-code",
    80→      budget: 0,
    81→    });
    82→
    83→    expect(result.budget).toBeNull();
    84→
    85→    // budget.json should not exist
    86→    const budgetPath = getSessionBudgetPath(specDir, sessionId);
    87→    await expect(fs.access(budgetPath)).rejects.toThrow();
    88→  });
    89→
    90→  // AC: @ralph-session-budget-integration ac-create-budget
    91→  it("should create budget with max_per_cycle matching --max-tasks value", async () => {
    92→    for (const maxTasks of [1, 5, 10]) {
    93→      const sessionId = testUlid("RBUDG", maxTasks + 10);
    94→      const result = await createSessionWithBudget(specDir, {
    95→        id: sessionId,
    96→        agent_type: "claude-code",
    97→        budget: maxTasks,
    98→      });
    99→
   100→      expect(result.budget!.max_per_cycle).toBe(maxTasks);
   101→    }
   102→  });
   103→});
   104→
   105→// ─── Budget Reset (ac-reset-iteration) ──────────────────────────────────────
   106→
   107→describe("ac-reset-iteration: budget reset at iteration boundary", () => {
   108→  let specDir: string;
   109→  let sessionId: string;
   110→
   111→  beforeEach(async () => {
   112→    specDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-ralph-reset-"));
   113→    sessionId = testUlid("RRESET", 1);
   114→    await createSessionWithBudget(specDir, {
   115→      id: sessionId,
   116→      agent_type: "claude-code",
   117→      budget: 2,
   118→    });
   119→  });
   120→
   121→  afterEach(async () => {
   122→    await fs.rm(specDir, { recursive: true });
   123→  });
   124→
   125→  // AC: @ralph-session-budget-integration ac-reset-iteration
   126→  it("should reset started_this_cycle to 0 after tasks were started", async () => {
   127→    // Simulate agent starting tasks during an iteration
   128→    await incrementBudget(specDir, sessionId);
   129→    await incrementBudget(specDir, sessionId);
   130→
   131→    let budget = await getBudget(specDir, sessionId);
   132→    expect(budget!.started_this_cycle).toBe(2);
   133→
   134→    // Simulate ralph calling resetBudget at iteration boundary
   135→    await resetBudget(specDir, sessionId);
   136→
   137→    budget = await getBudget(specDir, sessionId);
   138→    expect(budget!.started_this_cycle).toBe(0);
   139→    expect(budget!.max_per_cycle).toBe(2); // max unchanged
   140→  });
   141→
   142→  // AC: @ralph-session-budget-integration ac-reset-iteration
   143→  it("should no-op when no budget exists (maxTasks=0)", async () => {
   144→    const noBudgetSessionId = testUlid("RRESET", 2);
   145→    await createSessionWithBudget(specDir, {
   146→      id: noBudgetSessionId,
   147→      agent_type: "claude-code",
   148→      budget: 0,
   149→    });
   150→
   151→    // resetBudget should return null (no budget to reset)
   152→    const result = await resetBudget(specDir, noBudgetSessionId);
   153→    expect(result).toBeNull();
   154→  });
   155→});
   156→
   157→// ─── Env Injection — Consumer Side (ac-env-inject) ──────────────────────────
   158→
   159→describe("ac-env-inject: KSPEC_SESSION_ID budget enforcement via task start", () => {
   160→  let tempDir: string;
   161→
   162→  beforeEach(async () => {
   163→    tempDir = await setupTempFixtures();
   164→  });
   165→
   166→  afterEach(async () => {
   167→    await cleanupTempDir(tempDir);
   168→  });
   169→
   170→  // AC: @ralph-session-budget-integration ac-env-inject
   171→  it("should enforce budget when KSPEC_SESSION_ID is set and budget exhausted", async () => {
   172→    // Create a session with budget in the fixtures dir (tempDir IS specDir)
   173→    const sessionId = testUlid("RENV", 1);
   174→    await createSessionWithBudget(tempDir, {
   175→      id: sessionId,
   176→      agent_type: "claude-code",
   177→      budget: 1,
   178→    });
   179→
   180→    // Exhaust the budget
   181→    await incrementBudget(tempDir, sessionId);
   182→
   183→    // Now task start should be blocked when KSPEC_SESSION_ID is set
   184→    const result = kspec("task start @test-task-pending", tempDir, {
   185→      expectFail: true,
   186→      env: { KSPEC_SESSION_ID: sessionId },
   187→    });
   188→
   189→    expect(result.exitCode).toBe(4); // VALIDATION_FAILED
   190→    expect(result.stderr).toContain("budget");
   191→  });
   192→
   193→  // AC: @ralph-session-budget-integration ac-env-inject
   194→  it("should allow task start when KSPEC_SESSION_ID is set and budget available", async () => {
   195→    const sessionId = testUlid("RENV", 2);
   196→    await createSessionWithBudget(tempDir, {
   197→      id: sessionId,
   198→      agent_type: "claude-code",
   199→      budget: 5,
   200→    });
   201→
   202→    // Budget not exhausted — task start should succeed
   203→    const result = kspec("task start @test-task-pending", tempDir, {
   204→      env: { KSPEC_SESSION_ID: sessionId },
   205→    });
   206→
   207→    expect(result.exitCode).toBe(0);
   208→  });
   209→
   210→  // AC: @ralph-session-budget-integration ac-env-inject
   211→  it("should not enforce budget when KSPEC_SESSION_ID is not set", async () => {
   212→    // No session ID → no budget check → task start should succeed
   213→    const result = kspec("task start @test-task-pending", tempDir);
   214→    expect(result.exitCode).toBe(0);
   215→  });
   216→});
   217→
   218→// ─── Env Injection — Producer Side (ac-env-inject) ──────────────────────────
   219→
   220→describe("ac-env-inject: spawnAgent passes KSPEC_SESSION_ID to child process", () => {
   221→  let tempDir: string;
   222→  let envFile: string;
   223→
   224→  beforeEach(async () => {
   225→    tempDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-ralph-spawn-"));
   226→    envFile = path.join(tempDir, "agent-env.json");
   227→  });
   228→
   229→  afterEach(async () => {
   230→    await fs.rm(tempDir, { recursive: true });
   231→  });
   232→
   233→  // AC: @ralph-session-budget-integration ac-env-inject
   234→  it("should pass KSPEC_SESSION_ID to spawned agent via env", async () => {
   235→    const sessionId = testUlid("RSPAWN", 1);
   236→
   237→    // Spawn mock agent with the same env pattern ralph uses
   238→    const agent = spawnAgent(
   239→      { command: "node", args: [MOCK_AGENT_PATH], description: "mock" },
   240→      {
   241→        cwd: tempDir,
   242→        env: {
   243→          KSPEC_SESSION_ID: sessionId,
   244→          MOCK_ACP_ENV_FILE: envFile,
   245→        },
   246→      },
   247→    );
   248→
   249→    try {
   250→      // Initialize to prove the agent is alive and responding
   251→      await agent.client.initialize();
   252→
   253→      // Mock agent writes env to file on startup — verify it received the session ID
   254→      const envData = JSON.parse(await fs.readFile(envFile, "utf-8"));
   255→      expect(envData.KSPEC_SESSION_ID).toBe(sessionId);
   256→    } finally {
   257→      agent.kill();
   258→    }
   259→  });
   260→
   261→  // AC: @ralph-session-budget-integration ac-env-inject
   262→  it("should not leak KSPEC_SESSION_ID when env is not provided", async () => {
   263→    // Ensure KSPEC_SESSION_ID is NOT in the current process env for this test
   264→    const originalValue = process.env.KSPEC_SESSION_ID;
   265→    delete process.env.KSPEC_SESSION_ID;
   266→
   267→    try {
   268→      const agent = spawnAgent(
   269→        { command: "node", args: [MOCK_AGENT_PATH], description: "mock" },
   270→        {
   271→          cwd: tempDir,
   272→          env: { MOCK_ACP_ENV_FILE: envFile },
   273→        },
   274→      );
   275→
   276→      try {
   277→        await agent.client.initialize();
   278→        const envData = JSON.parse(await fs.readFile(envFile, "utf-8"));
   279→        expect(envData.KSPEC_SESSION_ID).toBeNull();
   280→      } finally {
   281→        agent.kill();
   282→      }
   283→    } finally {
   284→      // Restore original value
   285→      if (originalValue !== undefined) {
   286→        process.env.KSPEC_SESSION_ID = originalValue;
   287→      }
   288→    }
   289→  });
   290→});
   291→
   292→// ─── Marker Code Removal (ac-remove-marker-code) ────────────────────────────
   293→
   294→describe("ac-remove-marker-code: no marker file code in ralph.ts", () => {
   295→  let ralphSource: string;
   296→
   297→  beforeEach(async () => {
   298→    ralphSource = await fs.readFile(
   299→      path.resolve("src/cli/commands/ralph.ts"),
   300→      "utf-8",
   301→    );
   302→  });
   303→
   304→  // Task-limit marker artifacts
   305→  const removedPatterns = [
   306→    "TaskLimitMarker",
   307→    "TASK_LIMIT_MARKER",
   308→    "ralph-task-limit.json",
   309→    "detectTaskCompleteCommand",
   310→    "extractBashCommand",
   311→    "TASK LIMIT REACHED",
   312→    "writeTaskLimitMarker",
   313→    "readTaskLimitMarker",
   314→    "clearTaskLimitMarker",
   315→    "clearStaleMarker",
   316→    "STALE_MARKER_THRESHOLD",
   317→    "taskLimitReached",
   318→    "tasksCompletedThisIteration",
   319→    // End-loop marker artifacts (removed in end-loop migration)
   320→    "END_LOOP_MARKER_PATH",
   321→    "ralph-end-loop.json",
   322→    "writeEndLoopMarker",
   323→    "readEndLoopMarker",
   324→    "clearEndLoopMarker",
   325→  ];
   326→
   327→  // AC: @ralph-session-budget-integration ac-remove-marker-code
   328→  for (const pattern of removedPatterns) {
   329→    it(`should not contain "${pattern}"`, () => {
   330→      expect(ralphSource).not.toContain(pattern);
   331→    });
   332→  }
   333→
   334→  // AC: @ralph-session-budget-integration ac-remove-marker-code
   335→  it("should not import getIterationStats", () => {
   336→    expect(ralphSource).not.toMatch(/import.*getIterationStats/);
   337→  });
   338→});
   339→
   340→// ─── Session Close All Paths (ac-session-close-all-paths) ───────────────────
   341→
   342→describe("ac-session-close-all-paths: ralph cleans up budget on exit", () => {
   343→  let tempDir: string;
   344→
   345→  beforeEach(async () => {
   346→    tempDir = await setupTempFixtures();
   347→  });
   348→
   349→  afterEach(async () => {
   350→    await cleanupTempDir(tempDir);
   351→  });
   352→
   353→  /**
   354→   * Helper: spawn kspec ralph as a subprocess.
   355→   * Watches stderr for a marker string, then resolves.
   356→   * Ralph may not exit cleanly due to open Node handles, so we
   357→   * kill the process after the marker is seen and cleanup has occurred.
   358→   */
   359→  /**
   360→   * Helper: spawn kspec ralph as a subprocess.
   361→   * Watches combined output for a marker string, then resolves.
   362→   * Ralph may not exit cleanly due to open Node handles, so we
   363→   * kill the process after the marker is seen and cleanup has occurred.
   364→   */
   365→  function spawnRalphUntil(
   366→    args: string[],
   367→    marker: string,
   368→    env: Record<string, string> = {},
   369→  ): Promise<{ output: string }> {
   370→    return new Promise((resolve, reject) => {
   371→      const child = nodeSpawn("node", [CLI_PATH, "ralph", ...args], {
   372→        cwd: process.cwd(),
   373→        env: {
   374→          ...process.env,
   375→          KSPEC_SPEC_DIR: tempDir,
   376→          KSPEC_AUTHOR: "@test",
   377→          ...env,
   378→        },
   379→        stdio: ["pipe", "pipe", "pipe"],
   380→      });
   381→
   382→      let output = "";
   383→      let resolved = false;
   384→
   385→      const onData = (d: Buffer) => {
   386→        output += d.toString();
   387→        // Once we see the marker, cleanup is done — give a small grace period then kill
   388→        if (!resolved && output.includes(marker)) {
   389→          resolved = true;
   390→          setTimeout(() => {
   391→            child.kill("SIGKILL");
   392→            resolve({ output });
   393→          }, 500);
   394→        }
   395→      };
   396→      child.stdout!.on("data", onData);
   397→      child.stderr!.on("data", onData);
   398→
   399→      child.on("close", () => {
   400→        if (!resolved) {
   401→          resolved = true;
   402→          resolve({ output });
   403→        }
   404→      });
   405→
   406→      // Safety timeout
   407→      setTimeout(() => {
   408→        if (!resolved) {
   409→          resolved = true;
   410→          child.kill("SIGKILL");
   411→          reject(new Error(`Timed out waiting for marker "${marker}"\noutput: ${output}`));
   412→        }
   413→      }, 25_000);
   414→    });
   415→  }
   416→
   417→  // AC: @ralph-session-budget-integration ac-session-close-all-paths
   418→  it("should clean up budget.json after normal exit (max-iterations reached)", async () => {
   419→    // Run ralph with mock agent for 1 iteration.
   420→    // Wait for "Ralph loop completed" which appears after all cleanup.
   421→    const result = await spawnRalphUntil(
   422→      ["--adapter-cmd", `node ${MOCK_AGENT_PATH}`, "--max-loops", "1", "--max-tasks", "2"],
   423→      "Ralph loop completed",
   424→    );
   425→
   426→    expect(result.output).toContain("Completed iteration 1");
   427→
   428→    // Find the session directory ralph created
   429→    const sessionsDir = path.join(tempDir, "sessions");
   430→    const sessionDirs = await fs.readdir(sessionsDir);
   431→
   432→    // Ralph should have created exactly one session
   433→    expect(sessionDirs.length).toBe(1);
   434→
   435→    // Budget.json should NOT exist after ralph cleanup
   436→    const budgetPath = path.join(sessionsDir, sessionDirs[0], "budget.json");
   437→    const budgetExists = await fs.access(budgetPath).then(() => true).catch(() => false);
   438→    expect(budgetExists).toBe(false);
   439→
   440→    // Session should be closed as completed
   441→    const sessionPath = path.join(sessionsDir, sessionDirs[0], "session.yaml");
   442→    const content = await fs.readFile(sessionPath, "utf-8");
   443→    expect(content).toContain("status: completed");
   444→  }, 30_000);
   445→
   446→  /**
   447→   * Helper: spawn ralph, wait for it to start, send a signal, verify cleanup.
   448→   */
   449→  async function testSignalCleanup(signal: "SIGINT" | "SIGTERM") {
   450→    const child = nodeSpawn(
   451→      "node",
   452→      [CLI_PATH, "ralph", "--adapter-cmd", `node ${MOCK_AGENT_PATH}`, "--max-loops", "999", "--max-tasks", "2"],
   453→      {
   454→        cwd: process.cwd(),
   455→        env: {
   456→          ...process.env,
   457→          KSPEC_SPEC_DIR: tempDir,
   458→          KSPEC_AUTHOR: "@test",
   459→        },
   460→        stdio: ["pipe", "pipe", "pipe"],
   461→      },
   462→    );
   463→
   464→    let output = "";
   465→    const onData = (d: Buffer) => { output += d.toString(); };
   466→    child.stdout!.on("data", onData);
   467→    child.stderr!.on("data", onData);
   468→
   469→    // Wait for ralph to create the session and start working
   470→    await new Promise<void>((resolve) => {
   471→      const check = () => {
   472→        if (output.includes("Creating ACP session")) {
   473→          resolve();
   474→        } else {
   475→          setTimeout(check, 50);
   476→        }
   477→      };
   478→      check();
   479→      setTimeout(resolve, 5_000);
   480→    });
   481→
   482→    // Send the signal
   483→    child.kill(signal);
   484→
   485→    // Wait for process to exit
   486→    await new Promise<void>((resolve) => {
   487→      child.on("close", () => resolve());
   488→      setTimeout(() => {
   489→        child.kill("SIGKILL");
   490→        resolve();
   491→      }, 10_000);
   492→    });
   493→
   494→    // Verify budget.json was cleaned up
   495→    const sessionsDir = path.join(tempDir, "sessions");
   496→    const sessionDirs = await fs.readdir(sessionsDir);
   497→    expect(sessionDirs.length).toBe(1);
   498→
   499→    const budgetPath = path.join(sessionsDir, sessionDirs[0], "budget.json");
   500→    const budgetExists = await fs.access(budgetPath).then(() => true).catch(() => false);
   501→    expect(budgetExists).toBe(false);
   502→
   503→    // Session should be closed as abandoned with signal name
   504→    const sessionPath = path.join(sessionsDir, sessionDirs[0], "session.yaml");
   505→    const content = await fs.readFile(sessionPath, "utf-8");
   506→    expect(content).toContain("status: abandoned");
   507→    expect(content).toContain(signal);
   508→  }
   509→
   510→  // AC: @ralph-session-budget-integration ac-session-close-all-paths
   511→  it("should clean up budget.json after signal (SIGINT)", async () => {
   512→    await testSignalCleanup("SIGINT");
   513→  }, 30_000);
   514→
   515→  // AC: @ralph-session-budget-integration ac-session-close-all-paths
   516→  it("should clean up budget.json after signal (SIGTERM)", async () => {
   517→    await testSignalCleanup("SIGTERM");
   518→  }, 30_000);
   519→
   520→  // AC: @ralph-session-budget-integration ac-session-close-all-paths
   521→  it("should clean up budget.json after agent crash (error path)", async () => {
   522→    const crashAgent = path.join(FIXTURES_DIR, "mock-acp-agent-crash.mjs");
   523→
   524→    // Ralph with a crashing agent — retries exhaust, then finally block cleans up.
   525→    // Wait for "Ralph loop completed" (capital R) which appears after all cleanup.
   526→    const result = await spawnRalphUntil(
   527→      ["--adapter-cmd", `node ${crashAgent}`, "--max-loops", "1", "--max-tasks", "2"],
   528→      "Ralph loop completed",
   529→    );
   530→
   531→    // Ralph should have logged iteration failures
   532→    expect(result.output).toContain("Iteration failed");
   533→
   534→    // Find the session directory ralph created
   535→    const sessionsDir = path.join(tempDir, "sessions");
   536→    const sessionDirs = await fs.readdir(sessionsDir);
   537→    expect(sessionDirs.length).toBe(1);
   538→
   539→    // Budget.json should be cleaned up by finally block
   540→    const budgetPath = path.join(sessionsDir, sessionDirs[0], "budget.json");
   541→    const budgetExists = await fs.access(budgetPath).then(() => true).catch(() => false);
   542→    expect(budgetExists).toBe(false);
   543→  }, 30_000);
   544→});
   545→