    69→  gatherSessionContext,
    70→  type ActiveTaskSummary,
    71→  type SessionContext,
    72→} from "./session.js";
    73→
    74→
    75→// ─── Explicit Task Scope ─────────────────────────────────────────────────────
    76→
    77→/**
    78→ * Parsed explicit task scope for --tasks flag.
    79→ * AC: @cli-ralph ac-21
    80→ */
    81→interface ExplicitTaskScope {
    82→  /** Original refs as provided by user */
    83→  refs: string[];
    84→  /** Resolved ULIDs for the tasks */
    85→  ulids: string[];
    86→}
    87→
    88→/**
    89→ * Parse and validate --tasks flag value.
    90→ * Returns resolved ULIDs for the specified task refs.
    91→ * AC: @cli-ralph ac-21
    92→ *
    93→ * @throws Error if any ref cannot be resolved or is not a task
    94→ */
    95→async function parseExplicitTasks(
    96→  ctx: KspecContext,
    97→  tasksArg: string,
    98→): Promise<ExplicitTaskScope> {
    99→  const refs = tasksArg.split(",").map((r) => r.trim()).filter(Boolean);
   100→
   101→  if (refs.length === 0) {
   102→    throw new Error("--tasks requires at least one task reference");
   103→  }
   104→
   105→  // Load tasks and items for resolution
   106→  const tasks = await loadAllTasks(ctx);
   107→  const items = await loadAllItems(ctx);
   108→  const index = new ReferenceIndex(tasks, items);
   109→
   110→  const ulids: string[] = [];
   111→
   112→  for (const ref of refs) {
   113→    const result = index.resolve(ref);
   114→    if (!result.ok) {
   115→      throw new Error(`Cannot resolve task reference: ${ref}`);
   116→    }
   117→
   118→    // Verify it's a task (not a spec item)
   119→    const task = tasks.find((t) => t._ulid === result.ulid);
   120→    if (!task) {
   121→      throw new Error(`Reference ${ref} is not a task`);
   122→    }
   123→
   124→    ulids.push(result.ulid);
   125→  }
   126→
   127→  return { refs, ulids };
   128→}
   129→
   130→/**
   131→ * Filter session context to only include tasks from explicit scope.
   132→ * AC: @cli-ralph ac-21
   133→ */
   134→function filterByExplicitTasks(
   135→  ctx: SessionContext,
   136→  scope: ExplicitTaskScope,
   137→): SessionContext {
   138→  // Task refs in context are short ULIDs (variable length from shortUlid())
   139→  // Check if the context ref is a prefix of any explicit ULID
   140→  const matchesScope = (taskRef: string) => {
   141→    return scope.ulids.some((ulid) => ulid.startsWith(taskRef));
   142→  };
   143→
   144→  return {
   145→    ...ctx,
   146→    active_tasks: ctx.active_tasks.filter((t) => matchesScope(t.ref)),
   147→    pending_review_tasks: ctx.pending_review_tasks.filter((t) => matchesScope(t.ref)),
   148→    ready_tasks: ctx.ready_tasks.filter((t) => matchesScope(t.ref)),
   149→  };
   150→}
   151→
   152→/**
   153→ * Check if all explicit tasks are completed or blocked.
   154→ * AC: @cli-ralph ac-21
   155→ */
   156→async function allExplicitTasksDone(
   157→  ctx: KspecContext,
   158→  scope: ExplicitTaskScope,
   159→): Promise<{ done: boolean; statuses: Map<string, string> }> {
   160→  const tasks = await loadAllTasks(ctx);
   161→  const statuses = new Map<string, string>();
   162→
   163→  for (const ulid of scope.ulids) {
   164→    const task = tasks.find((t) => t._ulid === ulid);
   165→    if (task) {
   166→      statuses.set(ulid.slice(0, 8), task.status);
   167→    }
   168→  }
   169→
   170→  // Check if all are completed or blocked
   171→  const done = scope.ulids.every((ulid) => {
   172→    const status = statuses.get(ulid.slice(0, 8));
   173→    return status === "completed" || status === "blocked";
   174→  });
   175→
   176→  return { done, statuses };
   177→}
   178→
   179→// ─── Prompt Template ─────────────────────────────────────────────────────────
   180→
   181→// AC: @ralph-skill-delegation ac-1, ac-2, ac-3
   182→function buildTaskWorkPrompt(
   183→  sessionCtx: SessionContext,
   184→  iteration: number,
   185→  maxLoops: number,
   186→  sessionId: string,
   187→  skillTaskWork: string,
   188→  focus?: string,
   189→  explicitTaskScope?: ExplicitTaskScope,
   190→): string {
   191→  const focusSection = focus
   192→    ? `
   193→## Session Focus (applies to ALL iterations)
   194→
   195→> **${focus}**
   196→
   197→Keep this focus in mind throughout your work. It takes priority over default task selection.
   198→`
   199→    : "";
   200→
   201→  // AC: @cli-ralph ac-21 - Explicit task scope indicator in prompt
   202→  const taskScopeSection = explicitTaskScope
   203→    ? `
   204→## Explicit Task Scope
   205→
   206→This session is scoped to specific tasks: ${explicitTaskScope.refs.join(", ")}
   207→
   208→**Only work on these tasks.** The loop will exit when all listed tasks are completed or blocked.
   209→`
   210→    : "";
   211→
   212→  const modeDescription = explicitTaskScope
   213→    ? "Loop mode means: no confirmations, auto-resolve decisions, explicit task scope (only the listed tasks)."
   214→    : "Loop mode means: no confirmations, auto-resolve decisions, automation-eligible tasks only.";
   215→
   216→  return `# Kspec Automation Session - Task Work
   217→
   218→**Session ID:** \`${sessionId}\`
   219→**Iteration:** ${iteration} of ${maxLoops}
   220→**Mode:** Automated (no human in the loop)
   221→${focusSection}${taskScopeSection}
   222→
   223→## Current State
   224→\`\`\`json
   225→${JSON.stringify(sessionCtx, null, 2)}
   226→\`\`\`
   227→
   228→## Instructions
   229→
   230→Run the task-work skill in loop mode:
   231→
   232→\`\`\`
   233→${skillTaskWork} loop
   234→\`\`\`
   235→
   236→${modeDescription}
   237→
   238→**Normal flow:** Work on a task, create a PR, then stop responding. Ralph continues automatically —
   239→it checks for remaining eligible tasks at the start of each iteration and exits the loop itself when none remain.
   240→
   241→**Do NOT call \`end-loop\` after completing a task.** Simply stop responding.
   242→\`end-loop\` is a rare escape hatch for when work is stalling across multiple iterations with no progress — not a normal exit path.
   243→`;
   244→}
   245→
   246→/**
   247→ * Build the reflect prompt sent after task-work completes.
   248→ * Ralph sends this as a separate prompt to ensure reflection always happens.
   249→ */
   250→function buildReflectPrompt(
   251→  iteration: number,
   252→  maxLoops: number,
   253→  sessionId: string,
   254→  skillReflect: string,
   255→): string {
   256→  const isFinal = iteration === maxLoops;
   257→
   258→  return `# Kspec Automation Session - Reflection
   259→
   260→**Session ID:** \`${sessionId}\`
   261→**Iteration:** ${iteration} of ${maxLoops}
   262→**Phase:** Post-task reflection
   263→
   264→## Instructions
   265→
   266→Run the reflect skill in loop mode:
   267→
   268→\`\`\`
   269→${skillReflect} loop
   270→\`\`\`
   271→
   272→Loop mode means: high-confidence captures only, must search existing before capturing, no user prompts.
   273→${
   274→  isFinal
   275→    ? `
   276→**FINAL ITERATION** - This is the last chance to capture insights from this session.
   277→`
   278→    : ""
   279→}
   280→Exit when reflection is complete.
   281→`;
   282→}
   283→
   284→// ─── Streaming Output ────────────────────────────────────────────────────────
   285→
   286→// Translator and renderer are created per-session in the action handler.
   287→// This allows the architecture to be reused by future TUI renderers.
   288→
   289→// ─── Adapter Validation ──────────────────────────────────────────────────────
   290→
   291→// AC: @ralph-adapter-validation valid-adapter-proceeds, invalid-adapter-error, validation-before-spawn
   292→/**
   293→ * Validate that the specified ACP adapter package exists.
   294→ * Uses npx --no-install to check both global and local node_modules.
   295→ *
   296→ * @throws {Error} Never throws - exits process with code 3 if validation fails
   297→ */
   298→function validateAdapter(adapterPackage: string): void {
   299→  // Use npx --no-install with --version to check if package exists
   300→  // This checks both global and local node_modules, handles scoped packages
   301→  const result = spawnSync(
   302→    "npx",
   303→    ["--no-install", adapterPackage, "--version"],
   304→    {
   305→      encoding: "utf-8",
   306→      stdio: "pipe",
   307→    },
   308→  );
   309→
   310→  if (result.status !== 0) {
   311→    error(
   312→      `Adapter package not found: ${adapterPackage}. Install with: npm install -g ${adapterPackage}`,
   313→    );
   314→    process.exit(EXIT_CODES.NOT_FOUND);
   315→  }
   316→}
   317→
   318→// ─── Tool Request Handler ────────────────────────────────────────────────────
   319→
   320→/**
   321→ * Handle tool requests from ACP agent.
   322→ * Implements file operations, terminal commands, and permission handling.
   323→ */
   324→async function handleRequest(
   325→  client: ACPClient,
   326→  id: string | number,
   327→  method: string,
   328→  params: unknown,
   329→  yolo: boolean,
   330→): Promise<void> {
   331→  try {
   332→    switch (method) {
   333→      case "session/request_permission": {
   334→        const p = params as RequestPermissionRequest;
   335→        // In yolo mode, auto-approve all permissions
   336→        // In normal mode, would need to implement permission UI
   337→        const options = p.options || [];
   338→
   339→        if (yolo) {
   340→          // Find an "allow" option (prefer allow_always, then allow_once)
   341→          const allowOption =
   342→            options.find((o) => o.kind === "allow_always") ||
   343→            options.find((o) => o.kind === "allow_once");
   344→
   345→          if (allowOption) {
   346→            client.respondPermission(id, {
   347→              outcome: { outcome: "selected", optionId: allowOption.optionId },
   348→            });
   349→          } else {
   350→            // No allow option available - cancel
   351→            client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   352→          }
   353→        } else {
   354→          // TODO: Implement permission prompting
   355→          client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   356→        }
   357→        break;
   358→      }
   359→
   360→      case "file/read": {
   361→        const p = params as ReadTextFileRequest;
   362→        const content = await fs.readFile(p.path, "utf-8");
   363→        client.respondReadTextFile(id, { content });
   364→        break;
   365→      }
   366→
   367→      case "file/write": {
   368→        const p = params as WriteTextFileRequest;
   369→        await fs.mkdir(path.dirname(p.path), { recursive: true });
   370→        await fs.writeFile(p.path, p.content, "utf-8");
   371→        client.respondWriteTextFile(id, {});
   372→        break;
   373→      }
   374→
   375→      case "terminal/run": {
   376→        // Custom method (not part of ACP spec - ACP uses createTerminal instead)
   377→        // TODO: Consider migrating to standard ACP terminal methods
   378→        const p = params as {
   379→          command: string;
   380→          cwd?: string;
   381→          timeout?: number;
   382→        };
   383→        const command = p.command;
   384→        const cwd = p.cwd || process.cwd();
   385→        const timeout = p.timeout || 60000;
   386→
   387→        const result = await new Promise<{
   388→          stdout: string;
   389→          stderr: string;
   390→          exitCode: number;
   391→        }>((resolve) => {
   392→          const child = spawn(command, [], {
   393→            cwd,
   394→            shell: true,
   395→            timeout,
   396→          });
   397→
   398→          let stdout = "";
   399→          let stderr = "";
   400→
   401→          child.stdout?.on("data", (data) => {
   402→            stdout += data.toString();
   403→          });
   404→
   405→          child.stderr?.on("data", (data) => {
   406→            stderr += data.toString();
   407→          });
   408→
   409→          child.on("close", (code) => {
   410→            resolve({ stdout, stderr, exitCode: code ?? 1 });
   411→          });
   412→
   413→          child.on("error", (err) => {
   414→            resolve({ stdout, stderr: err.message, exitCode: 1 });
   415→          });
   416→        });
   417→
   418→        // Using generic respond() since this is a custom method
   419→        client.respond(id, result);
   420→        break;
   421→      }
   422→
   423→      default:
   424→        // Unknown method - return error
   425→        client.respondError(id, -32601, `Method not found: ${method}`);
   426→    }
   427→  } catch (err) {
   428→    const message = err instanceof Error ? err.message : String(err);
   429→    client.respondError(id, -32000, message);
   430→  }
   431→}
   432→
   433→// ─── Subagent Support ─────────────────────────────────────────────────────────
   434→
   435→/**
   436→ * Build context for a PR review subagent.
   437→ * AC: @ralph-subagent-spawning ac-10
   438→ */
   439→async function buildSubagentContext(
   440→  ctx: KspecContext,
   441→  taskRef: string,
   442→): Promise<SubagentContext> {
   443→  // Load all tasks and items
   444→  const tasks = await loadAllTasks(ctx);
   445→  const items = await loadAllItems(ctx);
   446→  const index = new ReferenceIndex(tasks, items);
   447→
   448→  // Resolve task reference
   449→  const taskResult = index.resolve(taskRef);
   450→  if (!taskResult.ok) {
   451→    throw new Error(`Task not found: ${taskRef}`);
   452→  }
   453→
   454→  const task = tasks.find((t) => t._ulid === taskResult.ulid);
   455→  if (!task) {
   456→    throw new Error(`Task not found by ULID: ${taskResult.ulid}`);
   457→  }
   458→
   459→  // Get linked spec with ACs if spec_ref exists
   460→  let specWithACs: Record<string, unknown> | null = null;
   461→  if (task.spec_ref) {
   462→    const specResult = index.resolve(task.spec_ref);
   463→    if (specResult.ok) {
   464→      const item = items.find((i) => i._ulid === specResult.ulid);
   465→      if (item) {
   466→        specWithACs = item as unknown as Record<string, unknown>;
   467→      }
   468→    }
   469→  }
   470→
   471→  // Get git branch
   472→  const gitBranch = getCurrentBranch(ctx.rootDir) || "unknown";
   473→
   474→  return {
   475→    taskRef,
   476→    taskDetails: task as unknown as Record<string, unknown>,
   477→    specWithACs,
   478→    gitBranch,
   479→  };
   480→}
   481→
   482→/**
   483→ * Get the current status of a task.
   484→ * AC: @ralph-subagent-spawning ac-12
   485→ */
   486→function getTaskStatus(taskRef: string): string | null {
   487→  const result = spawnSync("kspec", ["task", "get", taskRef, "--json"], {
   488→    encoding: "utf-8",
   489→    stdio: "pipe",
   490→  });
   491→
   492→  if (result.status !== 0) {
   493→    warn(`Failed to check task status for ${taskRef}: ${result.stderr}`);
   494→    return null;
   495→  }
   496→
   497→  try {
   498→    return JSON.parse(result.stdout).status;
   499→  } catch {
   500→    warn(`Failed to parse task status for ${taskRef}`);
   501→    return null;
   502→  }
   503→}
   504→
   505→/**
   506→ * Mark a task as needing review due to subagent timeout.
   507→ * AC: @ralph-subagent-spawning ac-9
   508→ */
   509→async function markTaskNeedsReview(
   510→  taskRef: string,
   511→  reason: string,
   512→): Promise<void> {
   513→  const { spawnSync } = await import("node:child_process");
   514→
   515→  // Use kspec CLI to set automation status
   516→  const result = spawnSync(
   517→    "kspec",
   518→    ["task", "set-automation", taskRef, "needs_review"],
   519→    {
   520→      encoding: "utf-8",
   521→      stdio: "pipe",
   522→    },
   523→  );
   524→
   525→  if (result.status !== 0) {
   526→    warn(`Failed to mark task ${taskRef} as needs_review: ${result.stderr}`);
   527→  }
   528→
   529→  // Add a note explaining the timeout
   530→  const noteResult = spawnSync(
   531→    "kspec",
   532→    ["task", "note", taskRef, `[RALPH SUBAGENT] ${reason}`],
   533→    {
   534→      encoding: "utf-8",
   535→      stdio: "pipe",
   536→    },
   537→  );
   538→
   539→  if (noteResult.status !== 0) {
   540→    warn(`Failed to add timeout note to task ${taskRef}: ${noteResult.stderr}`);
   541→  }
   542→}
   543→
   544→/**
   545→ * Post a comment on the open PR for a task's branch, noting incomplete review.
   546→ * Uses `gh pr list --head <branch>` to find the PR and add a warning.
   547→ */
   548→async function commentOnPRReviewIncomplete(branch: string, reason: string): Promise<void> {
   549→  if (!branch || branch === "unknown") {
   550→    return;
   551→  }
   552→
   553→  const prListResult = spawnSync(
   554→    "gh",
   555→    ["pr", "list", "--state", "open", "--head", branch, "--json", "number", "--jq", ".[0].number"],
   556→    { encoding: "utf-8", stdio: "pipe" },
   557→  );
   558→
   559→  const prNumber = prListResult.stdout?.trim();
   560→  if (!prNumber || prListResult.status !== 0) {
   561→    // No open PR found — may already be merged or branch has no PR
   562→    return;
   563→  }
   564→
   565→  const body = `⚠️ **Review incomplete**: ${reason}\n\nThis PR was not fully reviewed by the ralph review subagent. Manual review recommended before merging.`;
   566→  const commentResult = spawnSync(
   567→    "gh",
   568→    ["pr", "comment", prNumber, "--body", body],
   569→    { encoding: "utf-8", stdio: "pipe" },
   570→  );
   571→
   572→  if (commentResult.status !== 0) {
   573→    warn(`Failed to comment on PR #${prNumber}: ${commentResult.stderr}`);
   574→  } else {
   575→    info(`${DEFAULT_SUBAGENT_PREFIX} Posted review-incomplete comment on PR #${prNumber}`);
   576→  }
   577→}
   578→
   579→/**
   580→ * Handle failed iteration by tracking per-task failures and escalating at threshold.
   581→ * AC: @loop-mode-error-handling ac-1, ac-2, ac-3, ac-4, ac-5, ac-8
   582→ */
   583→async function handleIterationFailure(
   584→  ctx: KspecContext,
   585→  tasksInProgressAtStart: ActiveTaskSummary[],
   586→  iterationStartTime: Date,
   587→  errorDescription: string,
   588→): Promise<void> {
   589→  if (tasksInProgressAtStart.length === 0) {
   590→    return;
   591→  }
   592→
   593→  // Re-load current tasks to check progress
   594→  const currentTasks = await loadAllTasks(ctx);
   595→  const index = new ReferenceIndex(currentTasks, await loadAllItems(ctx));
   596→
   597→  // Convert ActiveTaskSummary to Task-like objects for processing
   598→  const tasksInProgressFull = tasksInProgressAtStart
   599→    .map((summary) => {
   600→      const resolved = index.resolve(summary.ref);
   601→      if (!resolved.ok) return undefined;
   602→      // Check if the resolved item is a task (not a spec item or meta item)
   603→      const item = resolved.item;
   604→      if (!("status" in item)) return undefined; // Spec items don't have status
   605→      return currentTasks.find((t) => t._ulid === resolved.ulid);
   606→    })
   607→    .filter((t): t is LoadedTask => t !== undefined && t.status === "in_progress");
   608→
   609→  if (tasksInProgressFull.length === 0) {
   610→    return;
   611→  }
   612→
   613→  // Process failures
   614→  const { processFailedIteration, createFailureNote, getTaskFailureCount } = await import("../../ralph/index.js");
   615→
   616→  const results = processFailedIteration(
   617→    tasksInProgressFull,
   618→    currentTasks,
   619→    iterationStartTime,
   620→    errorDescription,
   621→  );
   622→
   623→  // Add notes and escalate tasks
   624→  for (const result of results) {
   625→    const taskRef = result.taskRef;
   626→    const task = currentTasks.find((t) => t._ulid === taskRef);
   627→    if (!task) continue;
   628→
   629→    const priorCount = result.failureCount - 1;
   630→    const noteContent = createFailureNote(taskRef, errorDescription, priorCount);
   631→
   632→    // Add LOOP-FAIL note
   633→    const noteResult = spawnSync(
   634→      "kspec",
   635→      ["task", "note", `@${taskRef}`, noteContent],
   636→      {
   637→        encoding: "utf-8",
   638→        stdio: "pipe",
   639→        cwd: process.cwd(),
   640→      },
   641→    );
   642→
   643→    if (noteResult.status !== 0) {
   644→      warn(`Failed to add failure note to task ${taskRef}: ${noteResult.stderr}`);
   645→      continue;
   646→    }
   647→
   648→    // AC: @loop-mode-error-handling ac-5 - Escalate at threshold
   649→    if (result.escalated) {
   650→      const escalateResult = spawnSync(
   651→        "kspec",
   652→        [
   653→          "task",
   654→          "set",
   655→          `@${taskRef}`,
   656→          "--automation",
   657→          "needs_review",
   658→          "--reason",
   659→          `Loop mode: 3 consecutive failures without progress`,
   660→        ],
   661→        {
   662→          encoding: "utf-8",
   663→          stdio: "pipe",
   664→          cwd: process.cwd(),
   665→        },
   666→      );
   667→
   668→      if (escalateResult.status !== 0) {
   669→        warn(`Failed to escalate task ${taskRef}: ${escalateResult.stderr}`);
   670→      } else {
   671→        info(`Escalated task ${taskRef} to automation:needs_review after 3 failures`);
   672→      }
   673→    }
   674→  }
   675→}
   676→
   677→/**
   678→ * Process pending_review tasks by spawning subagents.
   679→ * AC: @ralph-subagent-spawning ac-6, ac-8
   680→ */
   681→async function processPendingReviewTasks(
   682→  ctx: KspecContext,
   683→  adapter: AgentAdapter,
   684→  pendingReviewTasks: ActiveTaskSummary[],
   685→  options: {
   686→    yolo: boolean;
   687→    maxRetries: number;
   688→    maxFailures: number;
   689→    cwd: string;
   690→    subagentTimeout: number;
   691→  },
   692→  consecutiveFailures: { count: number },
   693→): Promise<boolean> {
   694→  if (pendingReviewTasks.length === 0) {
   695→    return true;
   696→  }
   697→
   698→  // Visual separator for subagent section
   699→  console.log("");
   700→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   701→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Processing Pending Review Tasks`));
   702→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   703→  console.log("");
   704→
   705→  info(
   706→    `${DEFAULT_SUBAGENT_PREFIX} Found ${pendingReviewTasks.length} pending_review task(s)`,
   707→  );
   708→
   709→  // AC: @ralph-subagent-spawning ac-6 - Process one at a time
   710→  for (const task of pendingReviewTasks) {
   711→    info(`${DEFAULT_SUBAGENT_PREFIX} Processing: ${task.ref} - ${task.title}`);
   712→
   713→    try {
   714→      // Build context for this task
   715→      const subagentCtx = await buildSubagentContext(ctx, task.ref);
   716→
   717→      // AC: @ralph-subagent-spawning ac-1, ac-3 - Spawn and wait
   718→      const result = await runSubagent(
   719→        adapter,
   720→        subagentCtx,
   721→        {
   722→          timeout: options.subagentTimeout,
   723→          outputPrefix: DEFAULT_SUBAGENT_PREFIX,
   724→          skillName: ctx.config.ralph.skills.pr_review,
   725→        },
   726→        {
   727→          yolo: options.yolo,
   728→          cwd: options.cwd,
   729→          handleRequest: (client, reqId, method, params) =>
   730→            handleRequest(client, reqId, method, params, options.yolo),
   731→        },
   732→      );
   733→
   734→      if (result.timedOut) {
   735→        // AC: @ralph-subagent-spawning ac-9
   736→        warn(
   737→          `${DEFAULT_SUBAGENT_PREFIX} Subagent timed out for ${task.ref}`,
   738→        );
   739→        const timeoutMinutes = Math.round(options.subagentTimeout / 60000);
   740→        await markTaskNeedsReview(
   741→          task.ref,
   742→          `Subagent timed out after ${timeoutMinutes} minutes`,
   743→        );
   744→        await commentOnPRReviewIncomplete(subagentCtx.gitBranch, `Review subagent timed out after ${timeoutMinutes} minutes for task ${task.ref}.`);
   745→        consecutiveFailures.count++;
   746→      } else if (!result.success) {
   747→        // AC: @ralph-subagent-spawning ac-7
   748→        error(
   749→          `${DEFAULT_SUBAGENT_PREFIX} Subagent failed for ${task.ref}: ${result.error}`,
   750→        );
   751→        await commentOnPRReviewIncomplete(subagentCtx.gitBranch, `Review subagent failed for task ${task.ref}: ${result.error}`);
   752→        consecutiveFailures.count++;
   753→      } else {
   754→        // AC: @ralph-subagent-spawning ac-12 - Verify task outcome
   755→        const currentStatus = getTaskStatus(task.ref);
   756→
   757→        if (currentStatus === "completed") {
   758→          success(`${DEFAULT_SUBAGENT_PREFIX} Completed: ${task.ref}`);
   759→          consecutiveFailures.count = 0;
   760→        } else if (currentStatus === "needs_work") {
   761→          // Expected: reviewer found issues, kicked back to worker
   762→          info(`${DEFAULT_SUBAGENT_PREFIX} Review completed for ${task.ref} — issues found, kicked back to worker`);
   763→          // NOT a failure — the review worked correctly
   764→          consecutiveFailures.count = 0;
   765→        } else if (currentStatus === "pending_review") {
   766→          // Subagent didn't transition or merge — count as soft failure
   767→          warn(
   768→            `${DEFAULT_SUBAGENT_PREFIX} Subagent completed but task ${task.ref} unchanged`,
   769→          );
   770→          await markTaskNeedsReview(
   771→            task.ref,
   772→            "Subagent completed but did not merge or kick back. Review required.",
   773→          );
   774→          consecutiveFailures.count++;
   775→        } else {
   776→          warn(`${DEFAULT_SUBAGENT_PREFIX} Task ${task.ref} in unexpected state: ${currentStatus}`);
   777→          consecutiveFailures.count++;
   778→        }
   779→      }
   780→
   781→      // Check if we've hit max failures
   782→      if (consecutiveFailures.count >= options.maxFailures) {
   783→        error(
   784→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
   785→        );
   786→        return false;
   787→      }
   788→    } catch (err) {
   789→      const message = err instanceof Error ? err.message : String(err);
   790→      error(`${DEFAULT_SUBAGENT_PREFIX} Error processing ${task.ref}: ${message}`);
   791→      consecutiveFailures.count++;
   792→
   793→      if (consecutiveFailures.count >= options.maxFailures) {
   794→        error(
   795→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
   796→        );
   797→        return false;
   798→      }
   799→    }
   800→  }
   801→
   802→  // Visual separator at end of subagent section
   803→  console.log("");
   804→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   805→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Completed Review Processing`));
   806→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   807→  console.log("");
   808→
   809→  return true;
   810→}
   811→
   812→// ─── Command Registration ────────────────────────────────────────────────────
   813→
   814→export function registerRalphCommand(program: Command): void {
   815→  const ralph = program
   816→    .command("ralph")
   817→    .description("Ralph automated task loop and agent control");
   818→
   819→  // end-loop subcommand - allows agent to signal loop termination
   820→  // AC: @session-end-loop-signal ac-signal
   821→  ralph
   822→    .command("end-loop")
   823→    .description("End the ralph loop gracefully (stops all remaining iterations)")
   824→    .option("--reason <reason>", "Reason for ending the loop")
   825→    .action(async (options) => {
   826→      try {
   827→        const ctx = await initContext();
   828→        const sessionId = process.env.KSPEC_SESSION_ID;
   829→
   830→        if (!sessionId) {
   831→          // AC: @trait-error-guidance ac-1, ac-2
   832→          warn("No active ralph session detected (KSPEC_SESSION_ID not set).");
   833→          info("This command requires an active session. It is designed to be called by agents during a ralph loop.");
   834→          info("Suggestion: Ensure KSPEC_SESSION_ID is set, or start a session with: kspec session create --agent-type ralph");
   835→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   836→          return;
   837→        }
   838→
   839→        // AC: @session-end-loop-signal ac-signal - Write end-loop state to session
   840→        const updated = await requestEndLoop(ctx.specDir, sessionId, options.reason);
   841→
   842→        if (!updated) {
   843→          // AC: @trait-error-guidance ac-1, ac-2
   844→          error(`Session not found: ${sessionId}`);
   845→          info("Suggestion: Check session ID with: kspec session log list");
   846→          process.exit(EXIT_CODES.NOT_FOUND);
   847→          return;
   848→        }
   849→
   850→        success("Loop end signal sent");
   851→        if (options.reason) {
   852→          info(`Reason: ${options.reason}`);
   853→        }
   854→      } catch (err) {
   855→        // AC: @trait-error-guidance ac-1
   856→        error("Failed to signal end-loop", err);
   857→        process.exit(EXIT_CODES.ERROR);
   858→      }
   859→    });
   860→
   861→  // Main ralph run command (default behavior when ralph is called directly)
   862→  ralph
   863→    .command("run", { isDefault: true })
   864→    .description("Run ACP agent in a loop to process ready tasks")
   865→    .argument("[args...]", "")
   866→    .option("--max-loops <n>", "Maximum iterations", "5")
   867→    .option("--max-retries <n>", "Max retries per iteration on error", "3")
   868→    .option(
   869→      "--max-failures <n>",
   870→      "Max consecutive failed iterations before exit",
   871→      "3",
   872→    )
   873→    .option("--dry-run", "Show prompt without executing")
   874→    .option("--yolo", "Use dangerously-skip-permissions (default)", true)
   875→    .option("--no-yolo", "Require normal permission prompts")
   876→    .option("--subagent-timeout <minutes>", "Review subagent timeout in minutes", "20")
   877→    .option("--adapter <id>", "Agent adapter to use", "claude-agent-acp")
   878→    .option("--adapter-cmd <cmd>", "Custom adapter command (for testing)")
   879→    .option(
   880→      "--restart-every <n>",
   881→      "Restart agent every N iterations to prevent OOM (0 = never)",
   882→      "10",
   883→    )
   884→    .option(
   885→      "--focus <instructions>",
   886→      "Focus instructions included in every iteration prompt",
   887→    )
   888→    .option(
   889→      "--max-tasks <n>",
   890→      "Max tasks per iteration (0 = unlimited)",
   891→      "1",
   892→    )
   893→    .option(
   894→      "--tasks <refs>",
   895→      "Explicit task scope: only work on these tasks (comma-separated refs, e.g., @task1,@task2)",
   896→    )
   897→    .action(async (args: string[], options) => {
   898→      // Check for unknown subcommands that fell through to default
   899→      // Only check args that look like subcommand names (alphanumeric with hyphens, no quotes)
   900→      if (args.length > 0) {
   901→        const unknownCmd = args[0];
   902→        // Skip if it looks like a malformed option or quoted argument
   903→        const looksLikeSubcommand = /^[a-z][a-z0-9-]*$/i.test(unknownCmd);
   904→        if (looksLikeSubcommand) {
   905→          if (unknownCmd === "end-iteration") {
   906→            error(`Unknown command: ${unknownCmd}. Did you mean 'end-loop'?`);
   907→            info("The command was renamed from 'end-iteration' to 'end-loop' to clarify it ends the entire loop.");
   908→          } else {
   909→            error(`Unknown command: ${unknownCmd}`);
   910→          }
   911→          info("Run 'kspec ralph --help' to see available commands.");
   912→          process.exit(EXIT_CODES.USAGE_ERROR);
   913→        }
   914→      }
   915→      try {
   916→        const maxLoops = parseInt(options.maxLoops, 10);
   917→        const maxRetries = parseInt(options.maxRetries, 10);
   918→        const maxFailures = parseInt(options.maxFailures, 10);
   919→
   920→        if (Number.isNaN(maxLoops) || maxLoops < 1) {
   921→          error(errors.usage.maxLoopsPositive);
   922→          process.exit(EXIT_CODES.ERROR);
   923→        }
   924→
   925→        if (Number.isNaN(maxRetries) || maxRetries < 0) {
   926→          error(errors.usage.maxRetriesNonNegative);
   927→          process.exit(EXIT_CODES.ERROR);
   928→        }
   929→
   930→        if (Number.isNaN(maxFailures) || maxFailures < 1) {
   931→          error(errors.usage.maxFailuresPositive);
   932→          process.exit(EXIT_CODES.ERROR);
   933→        }
   934→
   935→        const subagentTimeout = parseInt(options.subagentTimeout, 10);
   936→        if (Number.isNaN(subagentTimeout) || subagentTimeout < 1) {
   937→          error("--subagent-timeout must be a positive integer (minutes)");
   938→          process.exit(EXIT_CODES.ERROR);
   939→        }
   940→
   941→        const restartEvery = parseInt(options.restartEvery, 10);
   942→        if (Number.isNaN(restartEvery) || restartEvery < 0) {
   943→          error("--restart-every must be a non-negative integer");
   944→          process.exit(EXIT_CODES.ERROR);
   945→        }
   946→
   947→        // AC: @ralph-session-budget-integration ac-create-budget
   948→        const maxTasks = parseInt(options.maxTasks, 10);
   949→        if (Number.isNaN(maxTasks) || maxTasks < 0 || maxTasks > 999) {
   950→          error("--max-tasks must be 0 (unlimited) or a positive integer up to 999");
   951→          process.exit(EXIT_CODES.USAGE_ERROR);
   952→        }
   953→
   954→        // Handle custom adapter command for testing
   955→        if (options.adapterCmd) {
   956→          const parts = options.adapterCmd.split(/\s+/);
   957→          const customAdapter: AgentAdapter = {
   958→            command: parts[0],
   959→            args: parts.slice(1),
   960→            description: "Custom adapter via --adapter-cmd",
   961→          };
   962→          registerAdapter("custom", customAdapter);
   963→          options.adapter = "custom";
   964→        }
   965→
   966→        // Resolve adapter
   967→        const adapter = resolveAdapter(options.adapter);
   968→
   969→        // Validate adapter package exists before proceeding
   970→        // Skip validation for:
   971→        // - Custom adapters (--adapter-cmd)
   972→        // - Non-npx adapters
   973→        // - Dry-run mode with default adapter (doesn't spawn agent, default may not be installed in CI)
   974→        // Note: If user explicitly specifies --adapter, validate even in dry-run to catch typos
   975→        // Accept both new and deprecated adapter names
   976→        const isDefaultAdapter =
   977→          options.adapter === "claude-agent-acp" ||
   978→          options.adapter === "claude-code-acp";
   979→        const skipValidation =
   980→          options.adapterCmd ||
   981→          adapter.command !== "npx" ||
   982→          !adapter.args[0] ||
   983→          (options.dryRun && isDefaultAdapter);
   984→
   985→        if (!skipValidation) {
   986→          validateAdapter(adapter.args[0]);
   987→        }
   988→
   989→        // Add yolo flag to adapter args if needed (accept both new and deprecated names)
   990→        if (options.yolo && isDefaultAdapter) {
   991→          adapter.args = [...adapter.args, "--dangerously-skip-permissions"];
   992→        }
   993→
   994→        const restartInfo =
   995→          restartEvery > 0 ? `, restart every ${restartEvery}` : "";
   996→        const maxTasksInfo =
   997→          maxTasks === 0 ? "unlimited" : `${maxTasks}`;
   998→
   999→        // Initialize kspec context early to validate --tasks
  1000→        const ctx = await initContext();
  1001→
  1002→        // AC: @cli-ralph ac-21 - Parse explicit task scope
  1003→        let explicitTaskScope: ExplicitTaskScope | undefined;
  1004→        if (options.tasks) {
  1005→          try {
  1006→            explicitTaskScope = await parseExplicitTasks(ctx, options.tasks);
  1007→            info(`Explicit task scope: ${explicitTaskScope.refs.join(", ")}`);
  1008→          } catch (err) {
  1009→            error(`Invalid --tasks argument: ${(err as Error).message}`);
  1010→            process.exit(EXIT_CODES.VALIDATION_FAILED);
  1011→          }
  1012→        }
  1013→
  1014→        const taskScopeInfo = explicitTaskScope
  1015→          ? `, tasks=${explicitTaskScope.refs.join(",")}`
  1016→          : "";
  1017→        info(
  1018→          `Starting ralph loop (adapter=${options.adapter}, max ${maxLoops} iterations, ${maxRetries} retries, ${maxFailures} max failures${restartInfo}, max-tasks=${maxTasksInfo}${taskScopeInfo})`,
  1019→        );
  1020→        if (options.focus) {
  1021→          info(`Focus: ${options.focus}`);
  1022→        }
  1023→        const specDir = ctx.specDir;
  1024→
  1025→        // Create session for event tracking
  1026→        const sessionId = ulid();
  1027→
  1028→        // Set session env vars on this process so all spawned agents
  1029→        // (main worker, subagent, wrap-up) inherit them via process.env.
  1030→        // KSPEC_RALPH_SESSION: Used by codex skill safety guard to detect ralph context.
  1031→        // KSPEC_SESSION_ID: Used by kspec task start for budget enforcement.
  1032→        // AC: @ralph-session-budget-integration ac-env-inject
  1033→        process.env.KSPEC_RALPH_SESSION = sessionId;
  1034→        process.env.KSPEC_SESSION_ID = sessionId;
  1035→
  1036→        // AC: @ralph-session-budget-integration ac-create-budget
  1037→        // Create session with budget. When maxTasks=0 (unlimited), no budget.json is created.
  1038→        await createSessionWithBudget(specDir, {
  1039→          id: sessionId,
  1040→          agent_type: options.adapter,
  1041→          budget: maxTasks,
  1042→        });
  1043→
  1044→        // Everything after session creation is wrapped in try/finally to guarantee
  1045→        // budget cleanup even if pre-loop setup (event logging, signal handlers) throws.
  1046→        // AC: @ralph-session-budget-integration ac-session-close-all-paths
  1047→        let consecutiveFailures = 0;
  1048→        let agent: SpawnedAgent | null = null;
  1049→        let acpSessionId: string | null = null;
  1050→        let exitReason: ExitReason | null = null;
  1051→        let lastIterationCtx: SessionContext | null = null;
  1052→        let lastErrorMessage: string | undefined;
  1053→        const recentTaskRefs: string[] = [];
  1054→        const sessionIterationMap = new Map<string, number>();
  1055→
  1056→        // Signal handler refs — declared here so finally can remove them
  1057→        const signalCleanup = (signal: string) => {
  1058→          info(`Received ${signal}, cleaning up...`);
  1059→          if (agent) {
  1060→            agent.kill();
  1061→          }
  1062→          // AC: @ralph-session-budget-integration ac-session-close-all-paths
  1063→          Promise.all([
  1064→            fs.unlink(getSessionBudgetPath(specDir, sessionId)).catch(() => {}),
  1065→            closeSession(specDir, sessionId, "abandoned", `Received ${signal}`),
  1066→          ]).finally(() => {
  1067→            process.exit(0);
  1068→          });
  1069→        };
  1070→        const sigintHandler = () => { signalCleanup("SIGINT"); };
  1071→        const sigtermHandler = () => { signalCleanup("SIGTERM"); };
  1072→
  1073→        try {
  1074→          // AC: @session-end-loop-signal ac-session-close-signal
  1075→          // Install signal handlers FIRST, before any async work, so signals
  1076→          // during startup (e.g. during appendEvent) still trigger cleanup.
  1077→          // AC: @ralph-session-budget-integration ac-session-close-all-paths
  1078→          process.on("SIGINT", sigintHandler);
  1079→          process.on("SIGTERM", sigtermHandler);
  1080→
  1081→          // Log session start
  1082→          await appendEvent(specDir, {
  1083→            session_id: sessionId,
  1084→            type: "session.start",
  1085→            data: {
  1086→              adapter: options.adapter,
  1087→              maxLoops,
  1088→              maxRetries,
  1089→              maxFailures,
  1090→              maxTasks,
  1091→              yolo: options.yolo,
  1092→              focus: options.focus,
  1093→              explicitTasks: explicitTaskScope?.refs,
  1094→            },
  1095→          });
  1096→
  1097→          // Create translator and renderer for this session
  1098→          const translator = createTranslator();
  1099→          const renderer = createCliRenderer();
  1100→
  1101→          for (let iteration = 1; iteration <= maxLoops; iteration++) {
  1102→            renderer.newSection?.(`Iteration ${iteration}/${maxLoops}`);
  1103→
  1104→            // AC: @ralph-session-budget-integration ac-reset-iteration
  1105→            // Reset budget counter at iteration start (no-op when no budget exists)
  1106→            await resetBudget(specDir, sessionId);
  1107→
  1108→            // AC: @session-end-loop-signal ac-detect - Check session state for end-loop
  1109→            const endLoopState = await isEndLoopRequested(specDir, sessionId);
  1110→            if (endLoopState?.requested) {
  1111→              info(`End-loop already requested for this session. Exiting.`);
  1112→              exitReason = "end_loop_signal";
  1113→              break;
  1114→            }
  1115→
  1116→            // Gather fresh context each iteration
  1117→            // AC: @cli-ralph ac-16 - Only automation-eligible tasks (unless explicit scope)
  1118→            // AC: @cli-ralph ac-21 - With explicit task scope, ignore automation eligibility
  1119→            let sessionCtx = await gatherSessionContext(ctx, {
  1120→              limit: "10",
  1121→              eligible: !explicitTaskScope, // Skip eligibility filter if explicit scope
  1122→            });
  1123→
  1124→            // AC: @cli-ralph ac-21 - Filter to explicit tasks if scope is set
  1125→            if (explicitTaskScope) {
  1126→              sessionCtx = filterByExplicitTasks(sessionCtx, explicitTaskScope);
  1127→            }
  1128→
  1129→            // AC: @ralph-subagent-spawning ac-8 - Process pending_review tasks BEFORE main iteration
  1130→            // This wraps consecutiveFailures in an object so it can be mutated by the helper
  1131→            const failureTracker = { count: consecutiveFailures };
  1132→            const continueLoop = await processPendingReviewTasks(
  1133→              ctx,
  1134→              adapter,
  1135→              sessionCtx.pending_review_tasks,
  1136→              {
  1137→                yolo: options.yolo,
  1138→                maxRetries,
  1139→                maxFailures,
  1140→                cwd: process.cwd(),
  1141→                subagentTimeout: subagentTimeout * 60 * 1000,
  1142→              },
  1143→              failureTracker,
  1144→            );
  1145→            consecutiveFailures = failureTracker.count;
  1146→
  1147→            if (!continueLoop) {
  1148→              exitReason = "max_failures";
  1149→              lastIterationCtx = sessionCtx;
  1150→              break;
  1151→            }
  1152→
  1153→            // AC: @cli-ralph ac-20 - Refresh context after pending_review processing
  1154→            // If pending_review tasks were processed, they may have completed and unblocked
  1155→            // dependent tasks. Re-gather context to detect newly available tasks.
  1156→            let currentCtx = sessionCtx;
  1157→            if (sessionCtx.pending_review_tasks.length > 0) {
  1158→              currentCtx = await gatherSessionContext(ctx, {
  1159→                limit: "10",
  1160→                eligible: !explicitTaskScope,
  1161→              });
  1162→              if (explicitTaskScope) {
  1163→                currentCtx = filterByExplicitTasks(currentCtx, explicitTaskScope);
  1164→              }
  1165→            }
  1166→
  1167→            // AC: @cli-ralph ac-21 - Check explicit task completion
  1168→            if (explicitTaskScope) {
  1169→              const { done, statuses } = await allExplicitTasksDone(ctx, explicitTaskScope);
  1170→              if (done) {
  1171→                const statusList = Array.from(statuses.entries())
  1172→                  .map(([ref, status]) => `${ref}: ${status}`)
  1173→                  .join(", ");
  1174→                info(`All explicit tasks completed or blocked (${statusList}). Exiting loop.`);
  1175→                exitReason = "explicit_tasks_done";
  1176→                lastIterationCtx = currentCtx;
  1177→                break;
  1178→              }
  1179→            }
  1180→
  1181→            // Check for automation-eligible tasks (ready or in_progress)
  1182→            // AC: @cli-ralph ac-19
  1183→            const hasActiveTasks = currentCtx.active_tasks.length > 0;
  1184→            const hasReadyTasks = currentCtx.ready_tasks.length > 0;
  1185→
  1186→            if (!hasActiveTasks && !hasReadyTasks) {
  1187→              if (explicitTaskScope) {
  1188→                info("No explicit tasks available (ready or in_progress). Exiting loop.");
  1189→              } else {
  1190→                info("No automation-eligible tasks (ready or in_progress). Exiting loop.");
  1191→              }
  1192→              exitReason = "no_tasks";
  1193→              lastIterationCtx = currentCtx;
  1194→              break;
  1195→            }
  1196→
  1197→            // AC: @loop-mode-error-handling - Track tasks in progress for failure handling
  1198→            const tasksInProgressAtStart = sessionCtx.active_tasks;
  1199→            const iterationStartTime = new Date();
  1200→
  1201→            // Build prompts - task-work first, then reflect
  1202→            // AC: @cli-ralph ac-21 - Include explicit task scope in prompt
  1203→            const taskWorkPrompt = buildTaskWorkPrompt(
  1204→              currentCtx,
  1205→              iteration,
  1206→              maxLoops,
  1207→              sessionId,
  1208→              ctx.config.ralph.skills.task_work,
  1209→              options.focus,
  1210→              explicitTaskScope,
  1211→            );
  1212→            const reflectPrompt = buildReflectPrompt(
  1213→              iteration,
  1214→              maxLoops,
  1215→              sessionId,
  1216→              ctx.config.ralph.skills.reflect,
  1217→            );
  1218→
  1219→            // AC: @cli-ralph ac-21
  1220→            if (options.dryRun) {
  1221→              console.log(
  1222→                chalk.yellow("=== DRY RUN - Configuration ===\n"),
  1223→              );
  1224→              console.log(`  max-loops: ${maxLoops}`);
  1225→              console.log(`  max-tasks: ${maxTasks === 0 ? "unlimited" : maxTasks}`);
  1226→              console.log(`  max-retries: ${maxRetries}`);
  1227→              console.log(`  max-failures: ${maxFailures}`);
  1228→              console.log(`  restart-every: ${restartEvery === 0 ? "never" : restartEvery}`);
  1229→              if (explicitTaskScope) {
  1230→                console.log(`  explicit-tasks: ${explicitTaskScope.refs.join(", ")}`);
  1231→              }
  1232→              console.log(
  1233→                chalk.yellow("\n=== Task Work Prompt ===\n"),
  1234→              );
  1235→              console.log(taskWorkPrompt);
  1236→              console.log(chalk.yellow("\n=== Reflect Prompt ===\n"));
  1237→              console.log(reflectPrompt);
  1238→              console.log(chalk.yellow("\n=== END DRY RUN ==="));
  1239→              break;
  1240→            }
  1241→
  1242→            // Log task-work prompt
  1243→            await appendEvent(specDir, {
  1244→              session_id: sessionId,
  1245→              type: "prompt.sent",
  1246→              data: {
  1247→                iteration,
  1248→                phase: "task-work",
  1249→                prompt: taskWorkPrompt,
  1250→                tasks: {
  1251→                  active: currentCtx.active_tasks.map((t) => t.ref),
  1252→                  ready: currentCtx.ready_tasks.map((t) => t.ref),
  1253→                },
  1254→              },
  1255→            });
  1256→
  1257→            // Retry loop for this iteration
  1258→            let lastError: Error | null = null;
  1259→            let succeeded = false;
  1260→
  1261→            for (let attempt = 1; attempt <= maxRetries + 1; attempt++) {
  1262→              if (attempt > 1) {
  1263→                console.log(
  1264→                  chalk.yellow(
  1265→                    `\nRetry attempt ${attempt - 1}/${maxRetries}...`,
  1266→                  ),
  1267→                );
  1268→              }
  1269→
  1270→              try {
  1271→                // Spawn agent if not already running
  1272→                if (!agent) {
  1273→                  info("Spawning ACP agent...");
  1274→                  // AC: @ralph-session-budget-integration ac-env-inject
  1275→                  agent = await spawnAndInitialize(adapter, {
  1276→                    cwd: process.cwd(),
  1277→                    env: { KSPEC_SESSION_ID: sessionId },
  1278→                    clientOptions: {
  1279→                      clientInfo: {
  1280→                        name: "kspec-ralph",
  1281→                        version: packageVersion,
  1282→                      },
  1283→                      methodTimeouts: {
  1284→                        "session/prompt": RALPH_PROMPT_TIMEOUT,
  1285→                        "session/resume": RALPH_PROMPT_TIMEOUT,
  1286→                      },
  1287→                    },
  1288→                  });
  1289→
  1290→                  // Set up streaming update handler with translator + renderer
  1291→                  agent.client.on(
  1292→                    "update",
  1293→                    (_sid: string, update: SessionUpdate) => {
  1294→                      // Translate ACP event to RalphEvent and render
  1295→                      const event = translator.translate(update);
  1296→                      if (event) {
  1297→                        renderer.render(event);
  1298→                      }
  1299→
  1300→                      // Log raw update event (async, non-blocking)
  1301→                      // Look up iteration by ACP session ID so late updates from
  1302→                      // a previous session are attributed to the correct iteration
  1303→                      const eventIteration = sessionIterationMap.get(_sid) ?? 0;
  1304→                      appendEvent(specDir, {
  1305→                        session_id: sessionId,
  1306→                        type: "session.update",
  1307→                        data: { iteration: eventIteration, update },
  1308→                      }).catch(() => {
  1309→                        // Ignore logging errors during streaming
  1310→                      });
  1311→                    },
  1312→                  );
  1313→
  1314→                  // Set up tool request handler
  1315→                  agent.client.on(
  1316→                    "request",
  1317→                    (
  1318→                      reqId: string | number,
  1319→                      method: string,
  1320→                      params: unknown,
  1321→                    ) => {
  1322→                      // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1323→                      handleRequest(
  1324→                        agent!.client,
  1325→                        reqId,
  1326→                        method,
  1327→                        params,
  1328→                        options.yolo,
  1329→                      ).catch((err) => {
  1330→                        // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1331→                        agent!.client.respondError(reqId, -32000, err.message);
  1332→                      });
  1333→                    },
  1334→                  );
  1335→                }
  1336→
  1337→                // Create fresh ACP session per iteration to keep context clean
  1338→                info("Creating ACP session...");
  1339→                acpSessionId = await agent.client.newSession({
  1340→                  cwd: process.cwd(),
  1341→                  mcpServers: [], // No MCP servers for now
  1342→                });
  1343→                sessionIterationMap.set(acpSessionId, iteration);
  1344→
  1345→                // Phase 1: Task Work
  1346→                info("Sending task-work prompt to agent...");
  1347→                const taskWorkResponse = await agent.client.prompt({
  1348→                  sessionId: acpSessionId!,
  1349→                  prompt: [{ type: "text", text: taskWorkPrompt }],
  1350→                });
  1351→
  1352→                // Log task-work completion
  1353→                await appendEvent(specDir, {
  1354→                  session_id: sessionId,
  1355→                  type: "session.update",
  1356→                  data: {
  1357→                    iteration,
  1358→                    phase: "task-work",
  1359→                    stopReason: taskWorkResponse.stopReason,
  1360→                    completed: true,
  1361→                  },
  1362→                });
  1363→
  1364→                if (taskWorkResponse.stopReason === "cancelled") {
  1365→                  throw new Error(errors.usage.agentPromptCancelled);
  1366→                }
  1367→
  1368→                // Phase 2: Reflect (always sent after task-work completes)
  1369→                info("Sending reflect prompt to agent...");
  1370→                await appendEvent(specDir, {
  1371→                  session_id: sessionId,
  1372→                  type: "prompt.sent",
  1373→                  data: {
  1374→                    iteration,
  1375→                    phase: "reflect",
  1376→                    prompt: reflectPrompt,
  1377→                  },
  1378→                });
  1379→
  1380→                const reflectResponse = await agent.client.prompt({
  1381→                  sessionId: acpSessionId!,
  1382→                  prompt: [{ type: "text", text: reflectPrompt }],
  1383→                });
  1384→
  1385→                // Log reflect completion
  1386→                await appendEvent(specDir, {
  1387→                  session_id: sessionId,
  1388→                  type: "session.update",
  1389→                  data: {
  1390→                    iteration,
  1391→                    phase: "reflect",
  1392→                    stopReason: reflectResponse.stopReason,
  1393→                    completed: true,
  1394→                  },
  1395→                });
  1396→
  1397→                if (reflectResponse.stopReason === "cancelled") {
  1398→                  throw new Error(errors.usage.agentPromptCancelled);
  1399→                }
  1400→
  1401→                succeeded = true;
  1402→                break;
  1403→              } catch (err) {
  1404→                lastError = err as Error;
  1405→                error(errors.failures.iterationFailed(lastError.message));
  1406→
  1407→                // Clean up agent on error - will respawn next attempt
  1408→                if (agent) {
  1409→                  agent.kill();
  1410→                  agent = null;
  1411→                  acpSessionId = null;
  1412→                }
  1413→              }
  1414→            }
  1415→
  1416→            if (succeeded) {
  1417→              console.log(); // Newline after streaming output
  1418→
  1419→              // Save session context snapshot for audit trail
  1420→              await saveSessionContext(
  1421→                specDir,
  1422→                sessionId,
  1423→                iteration,
  1424→                sessionCtx,
  1425→              );
  1426→
  1427→              success(`Completed iteration ${iteration}`);
  1428→              consecutiveFailures = 0;
  1429→
  1430→              // Track task refs from this iteration for wrap-up context
  1431→              for (const t of sessionCtx.active_tasks) {
  1432→                if (!recentTaskRefs.includes(t.ref)) {
  1433→                  recentTaskRefs.push(t.ref);
  1434→                }
  1435→              }
  1436→              lastIterationCtx = sessionCtx;
  1437→
  1438→
  1439→              // Periodic agent restart to prevent OOM
  1440→              // AC: @cli-ralph ac-restart-periodic
  1441→              if (
  1442→                restartEvery > 0 &&
  1443→                iteration % restartEvery === 0 &&
  1444→                iteration < maxLoops
  1445→              ) {
  1446→                info(
  1447→                  `Restarting agent to prevent memory buildup (every ${restartEvery} iterations)...`,
  1448→                );
  1449→                if (agent) {
  1450→                  agent.kill();
  1451→                  agent = null;
  1452→                  acpSessionId = null;
  1453→                }
  1454→              }
  1455→            } else {
  1456→              consecutiveFailures++;
  1457→              error(
  1458→                errors.failures.iterationFailedAfterRetries(
  1459→                  iteration,
  1460→                  maxRetries,
  1461→                  consecutiveFailures,
  1462→                  maxFailures,
  1463→                ),
  1464→              );
  1465→              if (lastError) {
  1466→                error(errors.failures.lastError(lastError.message));
  1467→              }
  1468→
  1469→              // AC: @loop-mode-error-handling - Track per-task failures
  1470→              const errorDesc = lastError?.message || "Iteration failed after retries";
  1471→              await handleIterationFailure(
  1472→                ctx,
  1473→                tasksInProgressAtStart,
  1474→                iterationStartTime,
  1475→                errorDesc,
  1476→              );
  1477→
  1478→              if (consecutiveFailures >= maxFailures) {
  1479→                error(errors.failures.reachedMaxFailures(maxFailures));
  1480→                exitReason = "max_failures";
  1481→                lastErrorMessage = lastError?.message;
  1482→                lastIterationCtx = sessionCtx;
  1483→                break;
  1484→              }
  1485→
  1486→              info("Continuing to next iteration...");
  1487→            }
  1488→          }
  1489→
  1490→          // If loop completed all iterations without breaking
  1491→          if (exitReason === null) {
  1492→            exitReason = "max_iterations";
  1493→          }
  1494→        } catch (loopErr) {
  1495→          // AC: @session-end-loop-signal ac-session-close-error
  1496→          // Unrecoverable error during loop execution
  1497→          exitReason = exitReason ?? "error";
  1498→          lastErrorMessage = (loopErr as Error).message;
  1499→          error("Unrecoverable error in ralph loop", loopErr);
  1500→        } finally {
  1501→          // Remove signal handlers to avoid double cleanup
  1502→          process.off("SIGINT", sigintHandler);
  1503→          process.off("SIGTERM", sigtermHandler);
  1504→
  1505→          // Clean up agent
  1506→          if (agent) {
  1507→            agent.kill();
  1508→            agent = null;
  1509→          }
  1510→
  1511→          // AC: @ralph-session-budget-integration ac-session-close-all-paths
  1512→          // Clean up budget file when session ends
  1513→          await fs.unlink(getSessionBudgetPath(specDir, sessionId)).catch(() => {});
  1514→
  1515→          // Clean up session env vars
  1516→          delete process.env.KSPEC_RALPH_SESSION;
  1517→          delete process.env.KSPEC_SESSION_ID;
  1518→
  1519→          // AC: @ralph-wrap-up-agent-on-loop-exit ac-1, ac-2, ac-3, ac-4, ac-5
  1520→          // Spawn wrap-up agent if not dry-run and we have an exit reason
  1521→          if (!options.dryRun && exitReason) {
  1522→            console.log("");
  1523→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1524→            console.log(chalk.cyan.bold(`${WRAPUP_AGENT_PREFIX} Starting Wrap-Up`));
  1525→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1526→            console.log("");
  1527→
  1528→            const inProgressTasks = lastIterationCtx?.active_tasks || [];
  1529→            const pendingReviewTasks = lastIterationCtx?.pending_review_tasks || [];
  1530→
  1531→            const wrapUpCtx = buildWrapUpContext(
  1532→              exitReason,
  1533→              sessionId,
  1534→              maxLoops, // Use maxLoops as iteration (we're at the end)
  1535→              maxLoops,
  1536→              inProgressTasks,
  1537→              pendingReviewTasks,
  1538→              recentTaskRefs,
  1539→              process.cwd(),
  1540→              lastErrorMessage,
  1541→            );
  1542→
  1543→            info(`Exit reason: ${exitReason}`);
  1544→            info(`Working tree: ${wrapUpCtx.workingTree.clean ? "clean" : "has uncommitted changes"}`);
  1545→
  1546→            const wrapUpResult = await runWrapUpAgent(
  1547→              adapter,
  1548→              wrapUpCtx,
  1549→              {
  1550→                yolo: options.yolo,
  1551→                cwd: process.cwd(),
  1552→                handleRequest: (client, reqId, method, params) =>
  1553→                  handleRequest(client, reqId, method, params, options.yolo),
  1554→              },
  1555→              DEFAULT_WRAPUP_TIMEOUT,
  1556→            );
  1557→
  1558→            // Log wrap-up result
  1559→            await appendEvent(specDir, {
  1560→              session_id: sessionId,
  1561→              type: "session.wrapup",
  1562→              data: {
  1563→                exitReason,
  1564→                result: wrapUpResult,
  1565→              },
  1566→            });
  1567→
  1568→            if (wrapUpResult.skipped) {
  1569→              info(`${WRAPUP_AGENT_PREFIX} Skipped: ${wrapUpResult.skipReason}`);
  1570→            } else if (wrapUpResult.timedOut) {
  1571→              warn(`${WRAPUP_AGENT_PREFIX} Timed out after ${DEFAULT_WRAPUP_TIMEOUT / 1000}s`);
  1572→            } else if (!wrapUpResult.success) {
  1573→              warn(`${WRAPUP_AGENT_PREFIX} Failed: ${wrapUpResult.error}`);
  1574→            } else {
  1575→              success(`${WRAPUP_AGENT_PREFIX} Completed`);
  1576→            }
  1577→
  1578→            console.log("");
  1579→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1580→            console.log(chalk.cyan.bold(`${WRAPUP_AGENT_PREFIX} Wrap-Up Complete`));
  1581→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1582→            console.log("");
  1583→          }
  1584→
  1585→          // Log session end and close session with appropriate status/reason
  1586→          // AC: @session-end-loop-signal ac-session-close-normal, ac-session-close-error
  1587→          const isErrorExit =
  1588→            consecutiveFailures >= maxFailures ||
  1589→            exitReason === "max_failures" ||
  1590→            exitReason === "error";
  1591→          const status = isErrorExit ? "abandoned" : "completed";
  1592→          const closeReason = exitReason === "max_failures"
  1593→            ? `Max failures reached (${consecutiveFailures}/${maxFailures})${lastErrorMessage ? `: ${lastErrorMessage}` : ""}`
  1594→            : exitReason === "error"
  1595→              ? `Unrecoverable error${lastErrorMessage ? `: ${lastErrorMessage}` : ""}`
  1596→              : exitReason === "end_loop_signal"
  1597→                ? "Agent requested end of loop"
  1598→                : exitReason === "max_iterations"
  1599→                  ? `Completed all ${maxLoops} iterations`
  1600→                  : exitReason === "no_tasks"
  1601→                    ? "No eligible tasks remaining"
  1602→                    : exitReason === "explicit_tasks_done"
  1603→                      ? "All explicit tasks completed"
  1604→                      : `Loop ended: ${exitReason}`;
  1605→          await appendEvent(specDir, {
  1606→            session_id: sessionId,
  1607→            type: "session.end",
  1608→            data: {
  1609→              status,
  1610→              consecutiveFailures,
  1611→              exitReason,
  1612→              closeReason,
  1613→            },
  1614→          });
  1615→          await closeSession(specDir, sessionId, status, closeReason);
  1616→        }
  1617→
  1618→        console.log(chalk.green(`\n${"─".repeat(60)}`));
  1619→        success("Ralph loop completed");
  1620→        console.log(chalk.green(`${"─".repeat(60)}\n`));
  1621→      } catch (err) {
  1622→        error(errors.failures.ralphLoop, err);
  1623→        process.exit(EXIT_CODES.ERROR);
  1624→      }
  1625→    });
  1626→}
  1627→