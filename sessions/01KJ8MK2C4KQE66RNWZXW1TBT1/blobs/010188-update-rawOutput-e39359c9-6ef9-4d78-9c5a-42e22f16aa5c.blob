     1→/**
     2→ * Ralph command - automated task loop via ACP.
     3→ *
     4→ * Runs an ACP-compliant agent in a loop to process tasks autonomously.
     5→ * Uses session event storage for full audit trail and streaming output.
     6→ */
     7→
     8→import { spawn, spawnSync } from "node:child_process";
     9→import * as fs from "node:fs/promises";
    10→import { createRequire } from "node:module";
    11→import * as path from "node:path";
    12→import chalk from "chalk";
    13→import type { Command } from "commander";
    14→import { ulid } from "ulid";
    15→
    16→// Read version from package.json for ACP client info
    17→const require = createRequire(import.meta.url);
    18→const { version: packageVersion } = require("../../../package.json");
    19→
    20→import type { ACPClient } from "../../acp/client.js";
    21→import type {
    22→  ReadTextFileRequest,
    23→  RequestPermissionRequest,
    24→  SessionUpdate,
    25→  WriteTextFileRequest,
    26→} from "../../acp/index.js";
    27→import {
    28→  type AgentAdapter,
    29→  registerAdapter,
    30→  resolveAdapter,
    31→} from "../../agents/index.js";
    32→import { type SpawnedAgent, spawnAndInitialize } from "../../agents/spawner.js";
    33→import {
    34→  initContext,
    35→  type KspecContext,
    36→  loadAllItems,
    37→  loadAllTasks,
    38→  type LoadedTask,
    39→  ReferenceIndex,
    40→} from "../../parser/index.js";
    41→import {
    42→  buildWrapUpContext,
    43→  createCliRenderer,
    44→  createTranslator,
    45→  DEFAULT_SUBAGENT_PREFIX,
    46→  DEFAULT_WRAPUP_TIMEOUT,
    47→  type ExitReason,
    48→  RALPH_PROMPT_TIMEOUT,
    49→  runSubagent,
    50→  runWrapUpAgent,
    51→  type SubagentContext,
    52→  WRAPUP_AGENT_PREFIX,
    53→} from "../../ralph/index.js";
    54→import {
    55→  appendEvent,
    56→  closeSession,
    57→  createSessionWithBudget,
    58→  getSessionBudgetPath,
    59→  isEndLoopRequested,
    60→  requestEndLoop,
    61→  resetBudget,
    62→  saveSessionContext,
    63→} from "../../sessions/index.js";
    64→import { errors } from "../../strings/index.js";
    65→import { getCurrentBranch } from "../../utils/git.js";
    66→import { EXIT_CODES } from "../exit-codes.js";
    67→import { error, info, success, warn } from "../output.js";
