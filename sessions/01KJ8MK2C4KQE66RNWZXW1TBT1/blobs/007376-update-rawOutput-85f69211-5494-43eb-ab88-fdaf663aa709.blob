    77→// ─── Types ───────────────────────────────────────────────────────────────────
    78→
    79→export interface CheckpointResult {
    80→  /** Whether session can end cleanly */
    81→  ok: boolean;
    82→
    83→  /** Human-readable message for Claude Code */
    84→  message: string;
    85→
    86→  /** Issues that need attention before stopping */
    87→  issues: CheckpointIssue[];
    88→
    89→  /** Instructions for the agent */
    90→  instructions: string[];
    91→}
    92→
    93→export interface CheckpointIssue {
    94→  type: "uncommitted_changes" | "in_progress_task" | "incomplete_todo";
    95→  description: string;
    96→  details?: Record<string, unknown>;
    97→}
    98→
    99→export interface SessionContext {
   100→  /** When this context was generated */
   101→  generated_at: string;
   102→
   103→  /** Current git branch */
   104→  branch: string | null;
   105→
   106→  /** Session context (focus, threads, questions) */
   107→  context: StoredSessionContext | null;
   108→
   109→  /** Tasks currently in progress */
   110→  active_tasks: ActiveTaskSummary[];
   111→
   112→  /** Tasks awaiting review (code done, PR pending) */
   113→  pending_review_tasks: ActiveTaskSummary[];
   114→
   115→  /** Recent notes from active tasks */
   116→  recent_notes: NoteSummary[];
   117→
   118→  /** Incomplete todos from active tasks */
   119→  active_todos: TodoSummary[];
   120→
   121→  /** Tasks ready to be picked up */
   122→  ready_tasks: ReadyTaskSummary[];
   123→
   124→  /** Blocked tasks with blockers */
   125→  blocked_tasks: BlockedTaskSummary[];
   126→
   127→  /** Recently completed tasks */
   128→  recently_completed: CompletedTaskSummary[];
   129→
   130→  /** Recent git commits */
   131→  recent_commits: CommitSummary[];
   132→
   133→  /** Working tree status */
   134→  working_tree: GitWorkingTree | null;
   135→
   136→  /** Inbox items awaiting triage (oldest first) */
   137→  inbox_items: InboxSummary[];
   138→
   139→  /** Summary statistics */
   140→  stats: SessionStats;
   141→}
   142→
   143→export interface ActiveTaskSummary {
   144→  ref: string;
   145→  title: string;
   146→  started_at: string | null;
   147→  priority: number;
   148→  spec_ref: string | null;
   149→  note_count: number;
   150→  last_note_at: string | null;
   151→  todo_count: number;
   152→  incomplete_todos: number;
   153→}
   154→
   155→export interface NoteSummary {
   156→  task_ref: string;
   157→  task_title: string;
   158→  task_status: "in_progress" | "pending_review" | "needs_work" | "completed";
   159→  note_ulid: string;
   160→  created_at: string;
   161→  author: string | null;
   162→  content: string;
   163→}
   164→
   165→export interface TodoSummary {
   166→  task_ref: string;
   167→  task_title: string;
   168→  id: number;
   169→  text: string;
   170→  added_at: string;
   171→  added_by: string | null;
   172→}
   173→
   174→export interface ReadyTaskSummary {
   175→  ref: string;
   176→  title: string;
   177→  priority: number;
   178→  spec_ref: string | null;
   179→  tags: string[];
   180→  unlocks: number;
   181→}
   182→
   183→export interface BlockedTaskSummary {
   184→  ref: string;
   185→  title: string;
   186→  blocked_by: string[];
   187→  unmet_deps: string[];
   188→  unlocks: number;
   189→}
   190→
   191→export interface CompletedTaskSummary {
   192→  ref: string;
   193→  title: string;
   194→  completed_at: string;
   195→  closed_reason: string | null;
   196→  origin?: "manual" | "derived" | "observation_promotion";
   197→}
   198→
   199→export interface CommitSummary {
   200→  hash: string;
   201→  full_hash: string;
   202→  date: string;
   203→  message: string;
   204→  author: string;
   205→}
   206→
   207→export interface SessionStats {
   208→  total_tasks: number;
   209→  in_progress: number;
   210→  needs_work: number;
   211→  pending_review: number;
   212→  ready: number;
   213→  blocked: number;
   214→  completed: number;
   215→  inbox_items: number;
   216→}
   217→
   218→export interface InboxSummary {
   219→  ref: string;
   220→  text: string;
   221→  created_at: string;
   222→  tags: string[];
   223→  added_by: string | null;
   224→}
   225→
   226→export interface SessionOptions {
   227→  brief?: boolean;
   228→  full?: boolean;
   229→  since?: string;
   230→  git?: boolean;
   231→  limit?: string;
