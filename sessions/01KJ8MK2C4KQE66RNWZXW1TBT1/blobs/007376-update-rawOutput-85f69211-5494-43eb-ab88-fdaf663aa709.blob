   233→}
   234→
   235→// ─── Data Gathering ──────────────────────────────────────────────────────────
   236→
   237→/**
   238→ * Build a reverse dependency map: for each task ULID, count how many
   239→ * pending tasks depend on it. Unresolvable refs are silently skipped.
   240→ */
   241→function computeUnlocksMap(
   242→  allTasks: LoadedTask[],
   243→  index: ReferenceIndex,
   244→): Map<string, number> {
   245→  const counts = new Map<string, number>();
   246→
   247→  for (const task of allTasks) {
   248→    // Only count pending tasks as "unlockable" downstream work per spec
   249→    if (task.status !== "pending") continue;
   250→
   251→    for (const depRef of task.depends_on) {
   252→      const result = index.resolve(depRef);
   253→      if (!result.ok) continue; // AC: unresolvable refs silently skipped
   254→      const depUlid = result.item._ulid;
   255→      counts.set(depUlid, (counts.get(depUlid) || 0) + 1);
   256→    }
   257→  }
   258→
   259→  return counts;
   260→}
   261→
   262→function toActiveTaskSummary(
   263→  task: LoadedTask,
   264→  index: ReferenceIndex,
   265→): ActiveTaskSummary {
   266→  const lastNote =
   267→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   268→  const incompleteTodos = task.todos.filter((t) => !t.done).length;
   269→  return {
   270→    ref: index.shortUlid(task._ulid),
   271→    title: task.title,
   272→    started_at: task.started_at || null,
   273→    priority: task.priority,
   274→    spec_ref: task.spec_ref || null,
   275→    note_count: task.notes.length,
   276→    last_note_at: lastNote ? lastNote.created_at : null,
   277→    todo_count: task.todos.length,
   278→    incomplete_todos: incompleteTodos,
   279→  };
   280→}
   281→
   282→function toReadyTaskSummary(
   283→  task: LoadedTask,
   284→  index: ReferenceIndex,
   285→  unlocksMap: Map<string, number>,
   286→): ReadyTaskSummary {
   287→  return {
   288→    ref: index.shortUlid(task._ulid),
   289→    title: task.title,
   290→    priority: task.priority,
   291→    spec_ref: task.spec_ref || null,
   292→    tags: task.tags,
   293→    unlocks: unlocksMap.get(task._ulid) || 0,
   294→  };
   295→}
   296→
   297→function toBlockedTaskSummary(
   298→  task: LoadedTask,
   299→  _allTasks: LoadedTask[],
   300→  index: ReferenceIndex,
   301→  unlocksMap: Map<string, number>,
   302→): BlockedTaskSummary {
   303→  // Find unmet dependencies
   304→  const unmetDeps: string[] = [];
   305→  for (const depRef of task.depends_on) {
   306→    const result = index.resolve(depRef);
   307→    if (result.ok) {
   308→      const depItem = result.item;
   309→      if ("status" in depItem && depItem.status !== "completed") {
   310→        unmetDeps.push(depRef);
   311→      }
   312→    }
   313→  }
   314→
   315→  return {
   316→    ref: index.shortUlid(task._ulid),
   317→    title: task.title,
   318→    blocked_by: task.blocked_by,
   319→    unmet_deps: unmetDeps,
   320→    unlocks: unlocksMap.get(task._ulid) || 0,
   321→  };
   322→}
   323→
   324→function toCompletedTaskSummary(
   325→  task: LoadedTask,
   326→  index: ReferenceIndex,
   327→): CompletedTaskSummary {
   328→  return {
   329→    ref: index.shortUlid(task._ulid),
   330→    title: task.title,
   331→    completed_at: task.completed_at || "",
   332→    closed_reason: task.closed_reason || null,
   333→    origin: task.origin,
   334→  };
   335→}
   336→
   337→function collectRecentNotes(
   338→  tasks: LoadedTask[],
   339→  index: ReferenceIndex,
   340→  options: { limit: number; since: Date | null },
   341→): NoteSummary[] {
   342→  const allNotes: NoteSummary[] = [];
   343→
   344→  for (const task of tasks) {
   345→    // Only include notes from in_progress, pending_review, or completed tasks
   346→    const taskStatus = task.status as "in_progress" | "pending_review" | "needs_work" | "completed";
   347→    if (!["in_progress", "pending_review", "needs_work", "completed"].includes(taskStatus)) {
   348→      continue;
   349→    }
   350→
   351→    for (const note of task.notes) {
   352→      const noteDate = new Date(note.created_at);
   353→
   354→      // Filter by since date if provided
   355→      if (options.since && noteDate < options.since) {
   356→        continue;
   357→      }
   358→
   359→      // Filter out superseded notes
   360→      if (isNoteSuperseded(note, task.notes)) {
   361→        continue;
   362→      }
   363→
   364→      allNotes.push({
   365→        task_ref: index.shortUlid(task._ulid),
   366→        task_title: task.title,
   367→        task_status: taskStatus,
   368→        note_ulid: note._ulid.slice(0, 8),
   369→        created_at: note.created_at,
   370→        author: note.author || null,
   371→        content: note.content,
   372→      });
   373→    }
   374→  }
   375→
   376→  // Sort by date descending, take limit
   377→  return allNotes
   378→    .sort(
   379→      (a, b) =>
   380→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   381→    )
   382→    .slice(0, options.limit);
   383→}
   384→
   385→function collectIncompleteTodos(
   386→  tasks: LoadedTask[],
   387→  index: ReferenceIndex,
   388→  options: { limit: number },
   389→): TodoSummary[] {
   390→  const allTodos: TodoSummary[] = [];
   391→
   392→  for (const task of tasks) {
   393→    for (const todo of task.todos) {
   394→      // Only include incomplete todos
   395→      if (todo.done) continue;
   396→
   397→      allTodos.push({
   398→        task_ref: index.shortUlid(task._ulid),
   399→        task_title: task.title,
   400→        id: todo.id,
   401→        text: todo.text,
   402→        added_at: todo.added_at,
   403→        added_by: todo.added_by || null,
   404→      });
   405→    }
   406→  }
   407→
   408→  // Sort by added_at descending (most recent first), take limit
   409→  return allTodos
   410→    .sort(
   411→      (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime(),
   412→    )
   413→    .slice(0, options.limit);
   414→}
   415→
   416→/**
   417→ * Gather session context data
   418→ */
   419→export async function gatherSessionContext(
   420→  ctx: KspecContext,
   421→  options: SessionOptions,
   422→): Promise<SessionContext> {
   423→  const limit = parseInt(options.limit || "10", 10);
   424→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   425→  const showGit = options.git !== false; // default true
   426→
   427→  // Load all data
   428→  const allTasks = await loadAllTasks(ctx);
   429→  const items = await loadAllItems(ctx);
   430→  const inboxItems = await loadInboxItems(ctx);
   431→  const index = new ReferenceIndex(allTasks, items);
   432→
   433→  // Compute stats
   434→  const stats: SessionStats = {
   435→    total_tasks: allTasks.length,
   436→    in_progress: allTasks.filter((t) => t.status === "in_progress").length,
   437→    needs_work: allTasks.filter((t) => t.status === "needs_work").length,
   438→    pending_review: allTasks.filter((t) => t.status === "pending_review")
   439→      .length,
   440→    ready: getReadyTasks(allTasks).length,
   441→    blocked: allTasks.filter((t) => t.status === "blocked").length,
   442→    completed: allTasks.filter((t) => t.status === "completed").length,
   443→    inbox_items: inboxItems.length,
   444→  };
   445→
   446→  // Get active tasks (in_progress + needs_work, optionally filtered to automation-eligible only)
   447→  // AC: @cli-ralph ac-16
   448→  const activeTasks = allTasks
   449→    .filter((t) => t.status === "in_progress" || t.status === "needs_work")
   450→    .filter((t) => !options.eligible || t.automation === "eligible")
   451→    .sort((a, b) => a.priority - b.priority)
   452→    .slice(0, options.full ? undefined : limit)
   453→    .map((t) => toActiveTaskSummary(t, index));
   454→
   455→  // Get pending review tasks
   456→  const pendingReviewTasks = allTasks
   457→    .filter((t) => t.status === "pending_review")
   458→    .sort((a, b) => a.priority - b.priority)
   459→    .slice(0, options.full ? undefined : limit)
   460→    .map((t) => toActiveTaskSummary(t, index));
   461→
   462→  // Get recent notes from active, pending_review, and recently completed tasks
   463→  // AC: @cmd-session-start ac-1, ac-2
   464→  // Collect notes per-status first to prevent one status from starving others
   465→  const noteLimitPerStatus = options.full ? limit : Math.ceil(limit / 3);
   466→
   467→  const inProgressNotes = collectRecentNotes(
   468→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   469→    index,
   470→    { limit: noteLimitPerStatus, since: sinceDate },
   471→  );
   472→
   473→  const pendingReviewNotes = collectRecentNotes(
   474→    allTasks.filter((t) => t.status === "pending_review"),
   475→    index,
   476→    { limit: noteLimitPerStatus, since: sinceDate },
   477→  );
   478→
   479→  const recentlyCompletedForNotes = allTasks
   480→    .filter((t) => t.status === "completed" && t.completed_at)
   481→    .sort((a, b) => {
   482→      const aDate = new Date(a.completed_at || 0);
   483→      const bDate = new Date(b.completed_at || 0);
   484→      return bDate.getTime() - aDate.getTime();
   485→    })
   486→    .slice(0, 5); // Last 3-5 completed tasks per AC-2
   487→
   488→  const completedNotes = collectRecentNotes(
   489→    recentlyCompletedForNotes,
   490→    index,
   491→    { limit: noteLimitPerStatus, since: sinceDate },
   492→  );
   493→
   494→  // Combine notes from all statuses, preserving representation from each
   495→  const recentNotes = [...inProgressNotes, ...pendingReviewNotes, ...completedNotes]
   496→    .sort(
   497→      (a, b) =>
   498→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   499→    );
   500→
   501→  // Get incomplete todos from active tasks
   502→  const activeTodos = collectIncompleteTodos(
   503→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   504→    index,
   505→    { limit: options.full ? limit * 2 : limit },
   506→  );
   507→
   508→  // Compute reverse dependency map for "unlocks N" annotations
   509→  const unlocksMap = computeUnlocksMap(allTasks, index);
   510→
   511→  // Get ready tasks (optionally filtered to automation-eligible only)
   512→  const readyTasks = getReadyTasks(allTasks)
   513→    .filter((t) => !options.eligible || t.automation === "eligible")
   514→    .slice(0, options.full ? undefined : limit)
   515→    .map((t) => toReadyTaskSummary(t, index, unlocksMap));
   516→
   517→  // Get blocked tasks
   518→  const blockedTasks = allTasks
   519→    .filter((t) => t.status === "blocked")
   520→    .slice(0, options.full ? undefined : limit)
   521→    .map((t) => toBlockedTaskSummary(t, allTasks, index, unlocksMap));
   522→
   523→  // Get recently completed tasks
   524→  const recentlyCompleted = allTasks
   525→    .filter((t) => {
   526→      if (t.status !== "completed" || !t.completed_at) return false;
   527→      const completedDate = new Date(t.completed_at);
   528→      if (sinceDate && completedDate < sinceDate) return false;
   529→      return true;
   530→    })
   531→    .sort((a, b) => {
   532→      // Sort by completed_at descending (most recent first)
   533→      const aDate = new Date(a.completed_at || 0);
   534→      const bDate = new Date(b.completed_at || 0);
   535→      return bDate.getTime() - aDate.getTime();
   536→    })
   537→    .slice(0, options.full ? undefined : limit)
   538→    .map((t) => toCompletedTaskSummary(t, index));
   539→
   540→  // Get git info
   541→  let branch: string | null = null;
   542→  let recentCommits: CommitSummary[] = [];
   543→  let workingTree: GitWorkingTree | null = null;
   544→
   545→  if (showGit && isGitRepo(ctx.rootDir)) {
   546→    branch = getCurrentBranch(ctx.rootDir);
   547→
   548→    const commits = getRecentCommits({
   549→      limit: options.full ? limit * 2 : limit,
   550→      since: sinceDate || undefined,
   551→      cwd: ctx.rootDir,
   552→    });
   553→
   554→    recentCommits = commits.map((c) => ({
   555→      hash: c.hash,
   556→      full_hash: c.fullHash,
   557→      date: c.date.toISOString(),
   558→      message: c.message,
   559→      author: c.author,
   560→    }));
   561→
   562→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   563→  }
   564→
   565→  // Get inbox items (oldest first to encourage triage)
   566→  const inboxSummaries: InboxSummary[] = inboxItems
   567→    .sort(
   568→      (a, b) =>
   569→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   570→    )
   571→    .slice(0, options.full ? undefined : limit)
   572→    .map((item) => ({
   573→      ref: item._ulid.slice(0, 8),
   574→      text: item.text,
   575→      created_at: item.created_at,
   576→      tags: item.tags,
   577→      added_by: item.added_by || null,
   578→    }));
   579→
   580→  // Load session context (focus, threads, questions)
   581→  const sessionContext = await loadSessionContext(ctx);
   582→
   583→  return {
   584→    generated_at: new Date().toISOString(),
   585→    branch,
   586→    context: sessionContext,
   587→    active_tasks: activeTasks,
   588→    pending_review_tasks: pendingReviewTasks,
   589→    recent_notes: recentNotes,
   590→    active_todos: activeTodos,
   591→    ready_tasks: readyTasks,
   592→    blocked_tasks: blockedTasks,
   593→    recently_completed: recentlyCompleted,
   594→    recent_commits: recentCommits,
   595→    working_tree: workingTree,
   596→    inbox_items: inboxSummaries,
   597→    stats,
   598→  };
   599→}
   600→
   601→// ─── Iteration Stats ─────────────────────────────────────────────────────────
   602→
   603→/**
   604→ * Stats for tasks completed/started within a time window.
   605→ * Used by ralph to track task completions per iteration.
   606→ */
   607→export interface IterationStats {
   608→  /** Number of tasks completed since the given time */
   609→  tasks_completed: number;
   610→  /** Number of tasks started since the given time */
   611→  tasks_started: number;
   612→  /** References of completed tasks */
   613→  completed_refs: string[];
   614→}
   615→
   616→/**
   617→ * Get iteration stats - tasks completed/started since a given time.
   618→ * AC: @ralph-task-limit ac-detection
   619→ */
   620→export async function getIterationStats(
   621→  ctx: KspecContext,
   622→  since: Date,
   623→): Promise<IterationStats> {
   624→  const allTasks = await loadAllTasks(ctx);
   625→
   626→  // Count both completed and pending_review (submitted) tasks toward the limit.
   627→  // Submit means the agent's work is done — it should count the same as complete.
   628→  // AC: @ralph-task-limit ac-detection
   629→  const completedSince = allTasks.filter((t) => {
   630→    if (t.status === "completed" && t.completed_at) {
   631→      return new Date(t.completed_at) >= since;
   632→    }
   633→    if (t.status === "pending_review" && t.submitted_at) {
   634→      return new Date(t.submitted_at) >= since;
   635→    }
   636→    return false;
   637→  });
   638→
   639→  const startedSince = allTasks.filter((t) => {
   640→    if (!t.started_at) return false;
   641→    return new Date(t.started_at) >= since;
   642→  });
   643→
   644→  // Use first slug or ULID prefix as ref
   645→  const getRef = (t: LoadedTask) =>
   646→    t.slugs.length > 0 ? `@${t.slugs[0]}` : `@${t._ulid.slice(0, 8)}`;
   647→
   648→  return {
   649→    tasks_completed: completedSince.length,
   650→    tasks_started: startedSince.length,
   651→    completed_refs: completedSince.map(getRef),
   652→  };
   653→}
   654→
   655→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   656→
   657→export interface CheckpointOptions {
   658→  force?: boolean;
   659→  /** Set when stop hook is already active (retry after previous block) */
   660→  stopHookActive?: boolean;
   661→}
   662→
   663→/** Claude Code hook input for Stop hooks */
   664→export interface StopHookInput {
   665→  session_id?: string;
   666→  transcript_path?: string;
   667→  hook_event_name?: string;
   668→  stop_hook_active?: boolean;
   669→}
   670→
   671→/**
   672→ * Perform session checkpoint - check for uncommitted work before ending session.
   673→ *
   674→ * This is designed for use as a Claude Code stop hook. It checks for:
   675→ * - Uncommitted git changes (staged, unstaged, untracked)
   676→ * - Tasks in in_progress status
   677→ * - Incomplete todos on active tasks
   678→ *
   679→ * Returns a structured result indicating whether the session can end cleanly.
   680→ */
   681→export async function performCheckpoint(
   682→  ctx: KspecContext,
   683→  options: CheckpointOptions,
   684→): Promise<CheckpointResult> {
   685→  const issues: CheckpointIssue[] = [];
   686→  const instructions: string[] = [];
   687→
   688→  // Load tasks
   689→  const allTasks = await loadAllTasks(ctx);
   690→
   691→  // Check for in-progress tasks
   692→  const inProgressTasks = allTasks.filter((t) => t.status === "in_progress");
   693→  for (const task of inProgressTasks) {
   694→    const ref = task.slugs[0]
   695→      ? `@${task.slugs[0]}`
   696→      : `@${task._ulid.slice(0, 8)}`;
   697→    issues.push({
   698→      type: "in_progress_task",
   699→      description: `Task ${ref} is still in progress: ${task.title}`,
   700→      details: {
   701→        ref,
   702→        title: task.title,
   703→        started_at: task.started_at,
   704→      },
   705→    });
   706→
   707→    // Check for incomplete todos on this task
   708→    const incompleteTodos = task.todos.filter((t) => !t.done);
   709→    for (const todo of incompleteTodos) {
   710→      issues.push({
   711→        type: "incomplete_todo",
   712→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   713→        details: {
   714→          task_ref: ref,
   715→          todo_id: todo.id,
   716→          text: todo.text,
   717→        },
   718→      });
   719→    }
   720→  }
   721→
   722→  // Check for uncommitted git changes
   723→  if (isGitRepo(ctx.rootDir)) {
   724→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   725→    if (!workingTree.clean) {
   726→      const changeCount =
   727→        workingTree.staged.length +
   728→        workingTree.unstaged.length +
   729→        workingTree.untracked.length;
   730→
   731→      issues.push({
   732→        type: "uncommitted_changes",
   733→        description: `${changeCount} uncommitted changes in working tree`,
   734→        details: {
   735→          staged: workingTree.staged.length,
   736→          unstaged: workingTree.unstaged.length,
   737→          untracked: workingTree.untracked.length,
   738→        },
   739→      });
   740→    }
   741→  }
   742→
   743→  // Build instructions based on issues
   744→  if (issues.length > 0 && !options.force) {
   745→    instructions.push(
   746→      "If you've been instructed to ignore this message or are working on",
   747→    );
   748→    instructions.push(
   749→      "unrelated things to any in progress tasks then disregard this message,",
   750→    );
   751→    instructions.push("otherwise before ending this session, please:");
   752→
   753→    const hasInProgress = issues.some((i) => i.type === "in_progress_task");
   754→    const hasUncommitted = issues.some((i) => i.type === "uncommitted_changes");
   755→    const hasIncompleteTodos = issues.some((i) => i.type === "incomplete_todo");
   756→
   757→    let step = 1;
   758→
   759→    if (hasInProgress) {
   760→      instructions.push(
   761→        `${step++}. Read in-progress task notes to get full context of the current task status`,
   762→      );
   763→      instructions.push(
   764→        `${step++}. Add notes documenting current state if any context is missing from this session`,
   765→      );
   766→      instructions.push(
   767→        `${step++}. Complete the task if you've completed the objectives and no AC are left uncovered\notherwise leave it in progress for a future session`,
   768→      );
   769→    }
   770→
   771→    if (hasIncompleteTodos) {
   772→      instructions.push(
   773→        `${step++}. Complete or acknowledge incomplete todos on active tasks`,
   774→      );
   775→    }
   776→
   777→    if (hasUncommitted) {
   778→      instructions.push(
   779→        `${step++}. Commit your changes with a descriptive message`,
   780→      );
   781→
   782→      // Add WIP commit guidance if there are in-progress tasks
   783→      if (inProgressTasks.length > 0) {
   784→        const task = inProgressTasks[0];
   785→        const guidance = formatCommitGuidance(task, { wip: true });
   786→        instructions.push("");
   787→        instructions.push("Suggested WIP commit:");
   788→        instructions.push(`  ${guidance.message}`);
   789→        instructions.push("");
   790→        for (const trailer of guidance.trailers) {
   791→          instructions.push(`  ${trailer}`);
   792→        }
   793→      }
   794→    }
   795→
   796→    instructions.push("");
   797→    instructions.push("Use: kspec task @task to get current task state");
   798→    instructions.push(
   799→      'Use: kspec task note @task "Progress notes..." to document state',
   800→    );
   801→    instructions.push(
   802→      'Use: kspec task complete @task --reason "Summary" if task is done',
   803→    );
   804→  }
   805→
   806→  // Allow stop if:
   807→  // - No issues found
   808→  // - --force flag passed
   809→  // - This is a retry (stop_hook_active = true from previous block)
   810→  const isRetry = options.stopHookActive === true;
   811→  const ok = issues.length === 0 || options.force === true || isRetry;
   812→
   813→  let message: string;
   814→  if (isRetry && issues.length > 0) {
   815→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   816→  } else if (ok) {
   817→    message = "[kspec] Session checkpoint passed - ready to end session";
   818→  } else {
   819→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   820→  }
   821→
   822→  return {
   823→    ok,
   824→    message,
   825→    issues,
   826→    instructions,
   827→  };
   828→}
   829→
   830→// ─── Output Formatting ───────────────────────────────────────────────────────
   831→
   832→function formatCheckpointResult(result: CheckpointResult): void {
   833→  if (result.ok) {
   834→    console.log(chalk.green(result.message));
   835→  } else {
   836→    console.log(chalk.yellow(result.message));
   837→    console.log("");
   838→
   839→    for (const issue of result.issues) {
   840→      const icon =
   841→        issue.type === "uncommitted_changes"
   842→          ? chalk.yellow("⚠")
   843→          : issue.type === "in_progress_task"
   844→            ? chalk.blue("●")
   845→            : chalk.gray("○");
   846→      console.log(`  ${icon} ${issue.description}`);
   847→    }
   848→
   849→    if (result.instructions.length > 0) {
   850→      console.log("");
   851→      for (const instruction of result.instructions) {
   852→        console.log(chalk.gray(instruction));
   853→      }
   854→    }
   855→  }
   856→}
   857→
   858→function formatSessionContext(
   859→  ctx: SessionContext,
   860→  options: SessionOptions,
   861→): void {
   862→  const isBrief = !options.full;
   863→
   864→  // Header
   865→  console.log(`\n${sessionHeaders.title}`);
   866→  const age = formatRelativeTime(new Date(ctx.generated_at));
   867→  if (ctx.branch) {
   868→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   869→  } else {
   870→    console.log(chalk.gray(`Generated: ${age}`));
   871→  }
   872→
   873→  // Stats summary
   874→  const pendingReviewNote =
   875→    ctx.stats.pending_review > 0
   876→      ? `${ctx.stats.pending_review} awaiting review, `
   877→      : "";
   878→  const inboxNote =
   879→    ctx.stats.inbox_items > 0 ? ` | Inbox: ${ctx.stats.inbox_items}` : "";
   880→  console.log(
   881→    chalk.gray(
   882→      `Tasks: ${ctx.stats.in_progress} active, ${pendingReviewNote}${ctx.stats.ready} ready, ` +
   883→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`,
   884→    ),
   885→  );
   886→
   887→  // Session context section (focus, threads, questions)
   888→  if (
   889→    ctx.context &&
   890→    (ctx.context.focus ||
   891→      ctx.context.threads.length > 0 ||
   892→      ctx.context.open_questions.length > 0)
   893→  ) {
   894→    console.log("\n--- Session Context ---");
   895→
   896→    if (ctx.context.focus) {
   897→      console.log(`  ${chalk.cyan("Focus:")} ${ctx.context.focus}`);
   898→    }
   899→
   900→    if (ctx.context.threads.length > 0) {
   901→      console.log(`  ${chalk.cyan("Active Threads:")}`);
   902→      for (const thread of ctx.context.threads) {
   903→        console.log(`    - ${thread}`);
   904→      }
   905→    }
   906→
   907→    if (ctx.context.open_questions.length > 0) {
   908→      console.log(`  ${chalk.cyan("Open Questions:")}`);
   909→      for (const question of ctx.context.open_questions) {
   910→        console.log(`    - ${question}`);
   911→      }
   912→    }
   913→  }
   914→
   915→  // Active tasks section
   916→  if (ctx.active_tasks.length > 0) {
   917→    console.log(`\n${sessionHeaders.activeWork}`);
   918→    for (const task of ctx.active_tasks) {
   919→      const started = task.started_at
   920→        ? chalk.gray(
   921→            ` (started ${formatRelativeTime(new Date(task.started_at))})`,
   922→          )
   923→        : "";
   924→      const priority =
   925→        task.priority <= 2
   926→          ? chalk.red(`P${task.priority}`)
   927→          : chalk.gray(`P${task.priority}`);
   928→      console.log(
   929→        `  ${chalk.blue("[in_progress]")} ${priority} ${task.ref} ${task.title}${started}`,
   930→      );
   931→    }
   932→  } else {
   933→    console.log(`\n${sessionHeaders.noActiveWork}`);
   934→  }
   935→
   936→  // Awaiting review section
   937→  if (ctx.pending_review_tasks.length > 0) {
   938→    console.log(`\n${sessionHeaders.awaitingReview}`);
   939→    for (const task of ctx.pending_review_tasks) {
   940→      const priority =
   941→        task.priority <= 2
   942→          ? chalk.red(`P${task.priority}`)
   943→          : chalk.gray(`P${task.priority}`);
   944→      console.log(
   945→        `  ${chalk.yellow("[pending_review]")} ${priority} ${task.ref} ${task.title}`,
   946→      );
   947→    }
   948→  }
   949→
   950→  // Recently completed section
   951→  if (ctx.recently_completed.length > 0) {
   952→    console.log(`\n${sessionHeaders.recentlyCompleted}`);
   953→    const observationPromotedTasks: string[] = [];
   954→    for (const task of ctx.recently_completed) {
   955→      const completedAge = formatRelativeTime(new Date(task.completed_at));
   956→      let reason = "";
   957→      if (task.closed_reason) {
   958→        const maxLen = isBrief ? 60 : 120;
   959→        const truncated =
   960→          task.closed_reason.length > maxLen
   961→            ? `${task.closed_reason.slice(0, maxLen).trim()}...`
   962→            : task.closed_reason;
   963→        reason = chalk.gray(` - ${truncated}`);
   964→      }
   965→      console.log(
   966→        `  ${chalk.green("[completed]")} ${task.ref} ${task.title} ${chalk.gray(`(${completedAge})`)}${reason}`,
   967→      );
   968→
   969→      // Track tasks that came from observations
   970→      if (task.origin === "observation_promotion") {
   971→        observationPromotedTasks.push(task.ref);
   972→      }
   973→    }
   974→
   975→    // Show reminder about resolving observations
   976→    if (observationPromotedTasks.length > 0) {
   977→      console.log(
   978→        chalk.yellow(
   979→          `\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(", ")}`,
   980→        ),
   981→      );
   982→      console.log(
   983→        chalk.gray(`    Run: kspec meta observations --pending-resolution`),
   984→      );
   985→    }
   986→  }
   987→
   988→  // Recent notes section - grouped by task status
   989→  // AC: @cmd-session-start ac-1, ac-2
   990→  if (ctx.recent_notes.length > 0) {
   991→    console.log(`\n${sessionHeaders.recentNotes}`);
   992→
   993→    // Group notes by task status
   994→    const inProgressNotes = ctx.recent_notes.filter(
   995→      (n) => n.task_status === "in_progress",
   996→    );
   997→    const pendingReviewNotes = ctx.recent_notes.filter(
   998→      (n) => n.task_status === "pending_review",
   999→    );
  1000→    const completedNotes = ctx.recent_notes.filter(
  1001→      (n) => n.task_status === "completed",
  1002→    );
  1003→
  1004→    // Helper to format a single note
  1005→    const formatNote = (note: NoteSummary) => {
  1006→      const age = formatRelativeTime(new Date(note.created_at));
  1007→      const author = note.author ? chalk.gray(` by ${note.author}`) : "";
  1008→      console.log(`    ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
  1009→
  1010→      // Truncate content in brief mode
  1011→      let content = note.content.trim();
  1012→      if (isBrief && content.length > 200) {
  1013→        content = `${content.slice(0, 200).trim()}...`;
  1014→      }
  1015→
  1016→      // Indent content, limit lines in brief mode
  1017→      const lines = content.split("\n");
  1018→      const maxLines = isBrief ? 3 : lines.length;
  1019→      for (const line of lines.slice(0, maxLines)) {
  1020→        console.log(`      ${chalk.white(line)}`);
  1021→      }
  1022→      if (isBrief && lines.length > maxLines) {
  1023→        console.log(
  1024→          chalk.gray(`      ... (${lines.length - maxLines} more lines)`),
  1025→        );
  1026→      }
  1027→    };
  1028→
  1029→    // AC: @cmd-session-start ac-1 - In Progress notes
  1030→    if (inProgressNotes.length > 0) {
  1031→      console.log(`  ${chalk.blue("In Progress:")}`);
  1032→      for (const note of inProgressNotes) {
  1033→        formatNote(note);
  1034→      }
  1035→    }
  1036→
  1037→    // AC: @cmd-session-start ac-1 - Pending Review notes (grouped separately)
  1038→    if (pendingReviewNotes.length > 0) {
  1039→      console.log(`  ${chalk.yellow("Pending Review:")}`);
  1040→      for (const note of pendingReviewNotes) {
  1041→        formatNote(note);
  1042→      }
  1043→    }
  1044→
  1045→    // AC: @cmd-session-start ac-2 - Recently Completed notes
  1046→    if (completedNotes.length > 0) {
  1047→      console.log(`  ${chalk.green("Recently Completed:")}`);
  1048→      for (const note of completedNotes) {
  1049→        formatNote(note);
  1050→      }
  1051→    }
  1052→  }
  1053→
  1054→  // Incomplete todos section
  1055→  if (ctx.active_todos.length > 0) {
  1056→    console.log(`\n${sessionHeaders.incompleteTodos}`);
  1057→    for (const todo of ctx.active_todos) {
  1058→      console.log(
  1059→        `  ${chalk.yellow("[ ]")} ${todo.task_ref}#${todo.id}: ${todo.text}`,
  1060→      );
  1061→    }
  1062→  }
  1063→
  1064→  // Ready tasks section
  1065→  if (ctx.ready_tasks.length > 0) {
  1066→    console.log(`\n${sessionHeaders.readyTasks}`);
  1067→    for (const task of ctx.ready_tasks) {
  1068→      const priority =
  1069→        task.priority <= 2
  1070→          ? chalk.red(`P${task.priority}`)
  1071→          : chalk.gray(`P${task.priority}`);
  1072→      const tags =
  1073→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(" #")}`) : "";
  1074→      const unlocks =
  1075→        task.unlocks > 0
  1076→          ? chalk.green(` unlocks ${task.unlocks}`)
  1077→          : "";
  1078→      console.log(`  ${priority} ${task.ref} ${task.title}${unlocks}${tags}`);
  1079→    }
  1080→  }
  1081→
  1082→  // Blocked tasks section
  1083→  if (ctx.blocked_tasks.length > 0) {
  1084→    console.log(`\n${sessionHeaders.blocked}`);
  1085→    for (const task of ctx.blocked_tasks) {
  1086→      const unlocks =
  1087→        task.unlocks > 0
  1088→          ? chalk.green(` unlocks ${task.unlocks}`)
  1089→          : "";
  1090→      console.log(`  ${chalk.red("[blocked]")} ${task.ref} ${task.title}${unlocks}`);
  1091→      if (task.blocked_by.length > 0) {
  1092→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(", ")}`));
  1093→      }
  1094→      if (task.unmet_deps.length > 0) {
  1095→        console.log(
  1096→          chalk.gray(`    Waiting on: ${task.unmet_deps.join(", ")}`),
  1097→        );
  1098→      }
  1099→    }
  1100→  }
  1101→
  1102→  // Git commits section
  1103→  if (ctx.recent_commits.length > 0) {
  1104→    console.log(`\n${sessionHeaders.recentCommits}`);
  1105→    for (const commit of ctx.recent_commits) {
  1106→      const age = formatRelativeTime(new Date(commit.date));
  1107→      console.log(
  1108→        `  ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${age}, ${commit.author})`)}`,
  1109→      );
  1110→    }
  1111→  }
  1112→
  1113→  // Inbox section (oldest first to encourage triage)
  1114→  if (ctx.inbox_items.length > 0) {
  1115→    console.log(`\n${sessionHeaders.inbox}`);
  1116→    for (const item of ctx.inbox_items) {
  1117→      const age = formatRelativeTime(new Date(item.created_at));
  1118→      const author = item.added_by ? ` by ${item.added_by}` : "";
  1119→      const tags =
  1120→        item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(", ")}]`) : "";
  1121→      // Truncate text in brief mode
  1122→      let text = item.text;
  1123→      if (isBrief && text.length > 60) {
  1124→        text = `${text.slice(0, 60).trim()}...`;
  1125→      }
  1126→      console.log(
  1127→        `  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`,
  1128→      );
  1129→      console.log(`    ${text}`);
  1130→    }
  1131→    console.log(`  ${hints.inboxPromote}`);
  1132→  }
  1133→
  1134→  // Working tree section
  1135→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1136→    console.log(`\n${sessionHeaders.workingTree}`);
  1137→
  1138→    if (ctx.working_tree.staged.length > 0) {
  1139→      console.log(chalk.green("  Staged:"));
  1140→      for (const file of ctx.working_tree.staged) {
  1141→        console.log(
  1142→          `    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`,
  1143→        );
  1144→      }
  1145→    }
  1146→
  1147→    if (ctx.working_tree.unstaged.length > 0) {
  1148→      console.log(chalk.red("  Modified:"));
  1149→      for (const file of ctx.working_tree.unstaged) {
  1150→        console.log(
  1151→          `    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`,
  1152→        );
  1153→      }
  1154→    }
  1155→
  1156→    if (ctx.working_tree.untracked.length > 0) {
  1157→      console.log(chalk.gray("  Untracked:"));
  1158→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
  1159→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
  1160→        console.log(`    ${chalk.gray("?")} ${path}`);
  1161→      }
  1162→      if (isBrief && ctx.working_tree.untracked.length > limit) {
  1163→        console.log(
  1164→          chalk.gray(
  1165→            `    ... and ${ctx.working_tree.untracked.length - limit} more`,
  1166→          ),
  1167→        );
  1168→      }
  1169→    }
  1170→  } else if (ctx.working_tree?.clean) {
  1171→    console.log(`\n${sessionHeaders.workingTreeClean}`);
  1172→  }
  1173→
  1174→  // Quick Commands section - contextual hints based on state
  1175→  const quickCommands: string[] = [];
  1176→
  1177→  if (ctx.active_tasks.length > 0) {
  1178→    const ref = ctx.active_tasks[0].ref;
  1179→    quickCommands.push(
  1180→      `kspec task note @${ref} "Progress..."  ${chalk.gray("# document work")}`,
  1181→    );
  1182→    quickCommands.push(
  1183→      `kspec task complete @${ref} --reason "..."  ${chalk.gray("# finish task")}`,
  1184→    );
  1185→  } else if (ctx.ready_tasks.length > 0) {
  1186→    const ref = ctx.ready_tasks[0].ref;
  1187→    quickCommands.push(
  1188→      `kspec task start @${ref}  ${chalk.gray("# begin work")}`,
  1189→    );
  1190→  }
  1191→
  1192→  if (ctx.inbox_items.length > 0) {
  1193→    const ref = ctx.inbox_items[0].ref;
  1194→    quickCommands.push(
  1195→      `kspec inbox promote @${ref} --title "..."  ${chalk.gray("# convert to task")}`,
  1196→    );
  1197→  }
  1198→
  1199→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1200→    quickCommands.push(
  1201→      `git add . && git commit -m "..."  ${chalk.gray("# commit changes")}`,
  1202→    );
  1203→  }
  1204→
  1205→  if (quickCommands.length > 0) {
  1206→    console.log(`\n${sessionHeaders.quickCommands}`);
  1207→    for (const hint of quickCommands) {
  1208→      console.log(`  ${hint}`);
  1209→    }
  1210→  }
  1211→
  1212→  console.log(""); // Final newline
  1213→}
  1214→
  1215→// ─── Command Registration ────────────────────────────────────────────────────
  1216→
  1217→async function sessionStartAction(options: SessionOptions): Promise<void> {
  1218→  try {
  1219→    const ctx = await initContext();
  1220→
  1221→    // AC: @shadow-sync ac-2 - Pull remote changes before showing session context
  1222→    let syncResult: ShadowSyncResult | null = null;
  1223→    if (ctx.shadow?.enabled) {
  1224→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
  1225→      // AC: @shadow-sync ac-3 - Warn about conflicts but continue with local state
  1226→      if (syncResult.hadConflict) {
  1227→        warn("Shadow sync conflict detected. Run `kspec shadow resolve` to fix.");
  1228→        info("Continuing with local state...");
  1229→      } else if (syncResult.pulled) {
  1230→        info("Synced shadow branch from remote");
  1231→      }
  1232→    }
  1233→
  1234→    const sessionCtx = await gatherSessionContext(ctx, options);
  1235→
  1236→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
  1237→  } catch (err) {
  1238→    error(errors.failures.gatherSessionContext, err);
  1239→    process.exit(EXIT_CODES.ERROR);
  1240→  }
  1241→}
  1242→
  1243→/**
  1244→ * Read stdin if available (non-blocking check for hook input)
  1245→ */
  1246→async function readStdinIfAvailable(): Promise<string | null> {
  1247→  // Check if stdin is a TTY (interactive) - if so, don't try to read
  1248→  if (process.stdin.isTTY) {
  1249→    return null;
  1250→  }
  1251→
  1252→  return new Promise((resolve) => {
  1253→    let data = "";
  1254→    const timeout = setTimeout(() => {
  1255→      process.stdin.removeAllListeners();
  1256→      resolve(data || null);
  1257→    }, 100); // 100ms timeout for stdin
  1258→
  1259→    process.stdin.setEncoding("utf8");
  1260→    process.stdin.on("data", (chunk) => {
  1261→      data += chunk;
  1262→    });
  1263→    process.stdin.on("end", () => {
  1264→      clearTimeout(timeout);
  1265→      resolve(data || null);
  1266→    });
  1267→    process.stdin.on("error", () => {
  1268→      clearTimeout(timeout);
  1269→      resolve(null);
  1270→    });
  1271→    process.stdin.resume();
  1272→  });
  1273→}
  1274→
  1275→/**
  1276→ * Parse Claude Code hook input from stdin
  1277→ */
  1278→function parseHookInput(stdin: string | null): StopHookInput | null {
  1279→  if (!stdin) return null;
  1280→  try {
  1281→    return JSON.parse(stdin.trim()) as StopHookInput;
  1282→  } catch {
  1283→    return null;
  1284→  }
  1285→}
  1286→
  1287→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
  1288→
  1289→/**
  1290→ * Output spec-first reminder for UserPromptSubmit hook.
  1291→ *
  1292→ * This is a simple context injection - always outputs the reminder,
  1293→ * and Claude (Opus) is smart enough to apply it when relevant.
  1294→ */
  1295→async function sessionPromptCheckAction(): Promise<void> {
  1296→  // Lean, instructive reminder with kspec prefix
  1297→  console.log(sessionPrompt.specCheck);
  1298→}
  1299→
  1300→async function sessionCheckpointAction(
  1301→  options: CheckpointOptions,
  1302→): Promise<void> {
  1303→  try {
  1304→    // Read stdin for Claude Code hook input
  1305→    const stdin = await readStdinIfAvailable();
  1306→    const hookInput = parseHookInput(stdin);
  1307→
  1308→    // Check if this is a retry (stop hook already active)
  1309→    if (hookInput?.stop_hook_active) {
  1310→      options.stopHookActive = true;
  1311→    }
  1312→
  1313→    const ctx = await initContext();
  1314→    const result = await performCheckpoint(ctx, options);
  1315→
  1316→    // Output format depends on mode:
  1317→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
  1318→    // - Human mode: Output formatted checkpoint result
  1319→    if (isJsonMode()) {
  1320→      if (!result.ok) {
  1321→        // Build reason message with issues and instructions
  1322→        const issueLines = result.issues
  1323→          .map((i) => `- ${i.description}`)
  1324→          .join("\n");
  1325→        const instructionLines = result.instructions
  1326→          .filter((i) => i.trim())
  1327→          .join("\n");
  1328→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
  1329→        console.log(JSON.stringify({ decision: "block", reason }));
  1330→      }
  1331→      // If ok, exit silently (Claude Code expects no output when allowing stop)
  1332→    } else {
  1333→      formatCheckpointResult(result);
  1334→      if (!result.ok) {
  1335→        process.exit(EXIT_CODES.ERROR);
  1336→      }
  1337→    }
  1338→  } catch (err) {
  1339→    // Handle RUNNING_FROM_SHADOW gracefully - skip with warning instead of erroring
  1340→    // This happens when the stop hook runs while cwd is inside .kspec/ directory
  1341→    if (err instanceof ShadowError && err.code === "RUNNING_FROM_SHADOW") {
  1342→      if (!isJsonMode()) {
  1343→        console.log(
  1344→          chalk.yellow(
  1345→            "[kspec] Session checkpoint skipped - running from inside .kspec/ directory",
  1346→          ),
  1347→        );
  1348→      }
  1349→      // Allow stop to proceed (exit successfully, no JSON output blocks the stop)
  1350→      return;
  1351→    }
  1352→    error(errors.failures.runCheckpoint, err);
  1353→    process.exit(EXIT_CODES.ERROR);
  1354→  }
  1355→}
  1356→
  1357→// ─── Session Log List ─────────────────────────────────────────────────────────
  1358→
  1359→interface SessionLogListOptions {
  1360→  status?: string;
  1361→  agent?: string;
  1362→  since?: string;
  1363→  sort?: string;
  1364→  count?: boolean;
  1365→  limit?: string;
  1366→}
  1367→
  1368→type SortField =
  1369→  | "started_at"
  1370→  | "duration"
  1371→  | "events"
  1372→  | "iterations"
  1373→  | "tasks_completed";
  1374→
  1375→const VALID_SORT_FIELDS: SortField[] = [
  1376→  "started_at",
  1377→  "duration",
  1378→  "events",
  1379→  "iterations",
  1380→  "tasks_completed",
  1381→];
  1382→
  1383→/**
  1384→ * Format a duration in milliseconds to a human-readable string.
  1385→ */
  1386→function formatDuration(ms: number): string {
  1387→  if (ms < 0) return "—";
  1388→  const totalSec = Math.floor(ms / 1000);
  1389→  const hours = Math.floor(totalSec / 3600);
  1390→  const minutes = Math.floor((totalSec % 3600) / 60);
  1391→  if (hours > 0) {
  1392→    return `${hours}h ${minutes}m`;
  1393→  }
  1394→  if (minutes > 0) {
  1395→    return `${minutes}m`;
  1396→  }
  1397→  return `${totalSec}s`;
  1398→}
  1399→
  1400→/**
  1401→ * Sort session summaries by the specified field.
  1402→ * Default: started_at descending.
  1403→ *
  1404→ * AC: @session-log-list ac-5
  1405→ */
  1406→function sortSessions(
  1407→  sessions: SessionLogSummary[],
  1408→  sortField: SortField,
  1409→): SessionLogSummary[] {
  1410→  return [...sessions].sort((a, b) => {
  1411→    switch (sortField) {
  1412→      case "started_at":
  1413→        return (
  1414→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1415→        );
  1416→      case "duration":
  1417→        return b.duration_ms - a.duration_ms;
  1418→      case "events":
  1419→        return b.event_count - a.event_count;
  1420→      case "iterations":
  1421→        return b.iteration_count - a.iteration_count;
  1422→      case "tasks_completed":
  1423→        return b.tasks_completed - a.tasks_completed;
  1424→      default:
  1425→        return (
  1426→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1427→        );
  1428→    }
  1429→  });
  1430→}
  1431→
  1432→/**
  1433→ * Format the session log list as a table.
  1434→ *
  1435→ * AC: @session-log-list ac-1
  1436→ */
  1437→function formatSessionLogList(sessions: SessionLogSummary[]): void {
  1438→  if (sessions.length === 0) {
  1439→    // AC: @session-log-list ac-6
  1440→    console.log("No sessions found.");
  1441→    return;
  1442→  }
  1443→
  1444→  // Table header
  1445→  console.log(
  1446→    chalk.gray(
  1447→      `${"ID".padEnd(10)} ${"Status".padEnd(11)} ${"Agent".padEnd(20)} ${"Started".padEnd(16)} ${"Duration".padEnd(10)} ${"Events".padEnd(8)} ${"Iters".padEnd(7)} Tasks`,
  1448→    ),
  1449→  );
  1450→  console.log(chalk.gray("─".repeat(95)));
  1451→
  1452→  for (const s of sessions) {
  1453→    const id = s.id.slice(0, 8);
  1454→    const statusColor =
  1455→      s.status === "completed"
  1456→        ? chalk.green
  1457→        : s.status === "active"
  1458→          ? chalk.blue
  1459→          : chalk.yellow;
  1460→    const status = statusColor(s.status.padEnd(11));
  1461→    const agent = s.agent_type.slice(0, 20).padEnd(20);
  1462→    const started = formatRelativeTime(new Date(s.started_at)).padEnd(16);
  1463→    const duration = formatDuration(s.duration_ms).padEnd(10);
  1464→    const events = String(s.event_count).padEnd(8);
  1465→    const iters = String(s.iteration_count).padEnd(7);
  1466→    const tasks = String(s.tasks_completed);
  1467→
  1468→    console.log(
  1469→      `${chalk.yellow(id)} ${status} ${chalk.gray(agent)} ${chalk.gray(started)} ${duration} ${events} ${iters} ${tasks}`,
  1470→    );
  1471→  }
  1472→
  1473→  console.log(chalk.gray(`\n${sessions.length} session(s)`));
  1474→}
  1475→
  1476→/**
  1477→ * Session log list action handler.
  1478→ */
  1479→async function sessionLogListAction(
  1480→  options: SessionLogListOptions,
  1481→): Promise<void> {
  1482→  try {
  1483→    const ctx = await initContext();
  1484→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1485→
  1486→    // AC: @session-log-list ac-2 - Filter by status
  1487→    if (options.status) {
  1488→      const statusFilter = options.status as SessionStatus;
  1489→      sessions = sessions.filter((s) => s.status === statusFilter);
  1490→    }
  1491→
  1492→    // AC: @session-log-list ac-4 - Filter by agent type
  1493→    if (options.agent) {
  1494→      const agentFilter = options.agent;
  1495→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1496→    }
  1497→
  1498→    // AC: @session-log-list ac-3 - Filter by since date
  1499→    if (options.since) {
  1500→      const sinceDate = parseTimeSpec(options.since);
  1501→      if (sinceDate) {
  1502→        sessions = sessions.filter(
  1503→          (s) => new Date(s.started_at) >= sinceDate,
  1504→        );
  1505→      }
  1506→    }
  1507→
  1508→    // AC: @session-log-list ac-5 - Sort
  1509→    const sortField: SortField =
  1510→      options.sort && VALID_SORT_FIELDS.includes(options.sort as SortField)
  1511→        ? (options.sort as SortField)
  1512→        : "started_at";
  1513→    sessions = sortSessions(sessions, sortField);
  1514→
  1515→    // AC: @session-log-list ac-7 - Limit output count
  1516→    if (options.count) {
  1517→      // AC: @trait-filterable-list ac-8
  1518→      output({ count: sessions.length }, () => {
  1519→        console.log(sessions.length);
  1520→      });
  1521→      return;
  1522→    }
  1523→
  1524→    // Apply --limit (after filtering/sorting, before display)
  1525→    if (options.limit) {
  1526→      const limit = parseInt(options.limit, 10);
  1527→      if (!Number.isNaN(limit) && limit > 0) {
  1528→        sessions = sessions.slice(0, limit);
  1529→      }
  1530→    }
  1531→
  1532→    output(sessions, () => formatSessionLogList(sessions));
  1533→  } catch (err) {
  1534→    error("Failed to list session logs", err);
  1535→    process.exit(EXIT_CODES.ERROR);
  1536→  }
  1537→}
  1538→
  1539→// ─── Session Log Show ─────────────────────────────────────────────────────────
  1540→
  1541→interface SessionLogShowOptions {
  1542→  events?: boolean;
  1543→  type?: string;
  1544→  limit?: string;
  1545→  context?: string;
  1546→}
  1547→
  1548→/**
  1549→ * Format an event timestamp as relative time from session start.
  1550→ */
  1551→function formatEventTimestamp(
  1552→  eventTs: number,
  1553→  sessionStartTs: number,
  1554→): string {
  1555→  const relativeMs = eventTs - sessionStartTs;
  1556→  const totalSec = Math.floor(relativeMs / 1000);
  1557→  const minutes = Math.floor(totalSec / 60);
  1558→  const seconds = totalSec % 60;
  1559→  if (minutes > 0) {
  1560→    return `+${minutes}m${seconds}s`;
  1561→  }
  1562→  return `+${seconds}s`;
  1563→}
  1564→
  1565→/**
  1566→ * Summarize event data for display.
  1567→ * Returns a short string describing the event payload.
  1568→ */
  1569→function summarizeEventData(event: SessionEvent): string {
  1570→  const data = event.data as Record<string, unknown> | null;
  1571→  if (!data) return "";
  1572→
  1573→  // Handle tool_call events
  1574→  if (event.type === "session.update") {
  1575→    const update = data.update as {
  1576→      sessionUpdate?: string;
  1577→      rawInput?: { command?: string };
  1578→      _meta?: { claudeCode?: { toolName?: string } };
  1579→    } | null;
  1580→    if (update?.sessionUpdate === "tool_call") {
  1581→      const toolName = update._meta?.claudeCode?.toolName || "unknown";
  1582→      const command = update.rawInput?.command;
  1583→      if (command) {
  1584→        const truncated =
  1585→          command.length > 60 ? command.slice(0, 57) + "..." : command;
  1586→        return `${toolName}: ${truncated}`;
  1587→      }
  1588→      return toolName;
  1589→    }
  1590→  }
  1591→
  1592→  // Handle prompt.sent events
  1593→  if (event.type === "prompt.sent") {
  1594→    const prompt = data.prompt as string | null;
  1595→    if (prompt) {
  1596→      const truncated =
  1597→        prompt.length > 60 ? prompt.slice(0, 57) + "..." : prompt;
  1598→      return truncated;
  1599→    }
  1600→  }
  1601→
  1602→  // Handle session.start/end
  1603→  if (event.type === "session.start") {
  1604→    return "Session started";
  1605→  }
  1606→  if (event.type === "session.end") {
  1607→    const reason = data.reason as string | null;
  1608→    return reason ? `Session ended: ${reason}` : "Session ended";
  1609→  }
  1610→
  1611→  // Default: show first key
  1612→  const keys = Object.keys(data);
  1613→  if (keys.length > 0) {
  1614→    return `{${keys.slice(0, 3).join(", ")}${keys.length > 3 ? ", ..." : ""}}`;
  1615→  }
  1616→  return "";
  1617→}
  1618→
  1619→/**
  1620→ * Format the session log show output.
  1621→ *
  1622→ * AC: @session-log-show ac-1
  1623→ */
  1624→function formatSessionLogShow(
  1625→  detail: SessionLogDetail,
  1626→  events: SessionEvent[] | null,
  1627→  contextSnapshot: unknown | null,
  1628→  sessionStartTs: number,
  1629→): void {
  1630→  // AC: @session-log-show ac-1 - Session metadata
  1631→  console.log(chalk.bold(`Session ${detail.id.slice(0, 8)}`));
  1632→  console.log(chalk.gray("─".repeat(60)));
  1633→  console.log(`  ID:        ${detail.id}`);
  1634→
  1635→  const statusColor =
  1636→    detail.status === "completed"
  1637→      ? chalk.green
  1638→      : detail.status === "active"
  1639→        ? chalk.blue
  1640→        : chalk.yellow;
  1641→  console.log(`  Status:    ${statusColor(detail.status)}`);
  1642→  console.log(`  Agent:     ${detail.agent_type}`);
  1643→  if (detail.task_id) {
  1644→    console.log(`  Task:      ${detail.task_id}`);
  1645→  }
  1646→  console.log(`  Started:   ${detail.started_at}`);
  1647→  if (detail.ended_at) {
  1648→    console.log(`  Ended:     ${detail.ended_at}`);
  1649→  }
  1650→  console.log(`  Duration:  ${formatDuration(detail.duration_ms)}`);
  1651→  console.log(`  Events:    ${detail.event_count}`);
  1652→  console.log(`  Iterations: ${detail.iteration_count}`);
  1653→
  1654→  // AC: @session-log-show ac-2 - Per-iteration summary
  1655→  if (detail.iterations.length > 0) {
  1656→    console.log("\n" + chalk.bold("Iterations"));
  1657→    console.log(chalk.gray("─".repeat(60)));
  1658→    for (const iter of detail.iterations) {
  1659→      const taskInfo: string[] = [];
  1660→      if (iter.tasks_started.length > 0) {
  1661→        taskInfo.push(`started: ${iter.tasks_started.join(", ")}`);
  1662→      }
  1663→      if (iter.tasks_completed.length > 0) {
  1664→        taskInfo.push(`completed: ${iter.tasks_completed.join(", ")}`);
  1665→      }
  1666→      const taskStr = taskInfo.length > 0 ? ` | ${taskInfo.join(" | ")}` : "";
  1667→      console.log(
  1668→        `  ${chalk.cyan(`[${iter.iteration}]`)} ${iter.event_count} events${taskStr}`,
  1669→      );
  1670→    }
  1671→  }
  1672→
  1673→  // AC: @session-log-show ac-3 - Event timeline
  1674→  if (events !== null) {
  1675→    console.log("\n" + chalk.bold("Events"));
  1676→    console.log(chalk.gray("─".repeat(60)));
  1677→    if (events.length === 0) {
  1678→      console.log(chalk.gray("  No events to display."));
  1679→    } else {
  1680→      for (const event of events) {
  1681→        const timestamp = formatEventTimestamp(event.ts, sessionStartTs);
  1682→        const summary = summarizeEventData(event);
  1683→        const typeColor =
  1684→          event.type === "session.start" || event.type === "session.end"
  1685→            ? chalk.green
  1686→            : event.type === "session.update"
  1687→              ? chalk.blue
  1688→              : chalk.gray;
  1689→        console.log(
  1690→          `  ${chalk.yellow(timestamp.padEnd(10))} ${typeColor(event.type.padEnd(16))} ${chalk.gray(summary)}`,
  1691→        );
  1692→      }
  1693→    }
  1694→  }
  1695→
  1696→  // AC: @session-log-show ac-6 - Context snapshot
  1697→  if (contextSnapshot !== null) {
  1698→    console.log("\n" + chalk.bold("Context Snapshot"));
  1699→    console.log(chalk.gray("─".repeat(60)));
  1700→    console.log(JSON.stringify(contextSnapshot, null, 2));
  1701→  }
  1702→}
  1703→
  1704→/**
  1705→ * Session log show action handler.
  1706→ */
  1707→async function sessionLogShowAction(
  1708→  sessionRef: string,
  1709→  options: SessionLogShowOptions,
  1710→): Promise<void> {
  1711→  try {
  1712→    const ctx = await initContext();
  1713→
  1714→    // AC: @session-log-show ac-7, ac-8, ac-9 - Resolve session ID
  1715→    const resolution = await resolveSessionId(ctx.specDir, sessionRef);
  1716→
  1717→    if (!resolution.ok) {
  1718→      if (resolution.error === "not_found") {
  1719→        // AC: @session-log-show ac-9
  1720→        error(`Session not found: ${sessionRef}`);
  1721→        process.exit(EXIT_CODES.NOT_FOUND);
  1722→      } else {
  1723→        // AC: @session-log-show ac-8
  1724→        error(
  1725→          `Ambiguous session ID prefix. Matches:\n  ${resolution.matches.join("\n  ")}\nPlease provide a more specific prefix.`,
  1726→        );
  1727→        process.exit(EXIT_CODES.VALIDATION_FAILED);
  1728→      }
  1729→    }
  1730→
  1731→    const sessionId = resolution.id;
  1732→
  1733→    // Get session detail
  1734→    const detail = await getSessionLogDetail(ctx.specDir, sessionId);
  1735→    if (!detail) {
  1736→      error(`Session not found: ${sessionId}`);
  1737→      process.exit(EXIT_CODES.NOT_FOUND);
  1738→    }
  1739→
  1740→    // AC: @session-log-show ac-3, ac-4, ac-5 - Event timeline
  1741→    let events: SessionEvent[] | null = null;
  1742→    if (options.events) {
  1743→      let allEvents = deduplicatePhasedToolCalls(
  1744→        await readEvents(ctx.specDir, sessionId),
  1745→      );
  1746→
  1747→      // AC: @session-log-show ac-4 - Filter by type
  1748→      if (options.type) {
  1749→        const typeFilter = options.type;
  1750→        allEvents = allEvents.filter((e) => e.type === typeFilter);
  1751→      }
  1752→
  1753→      // AC: @session-log-show ac-5 - Limit to last N events
  1754→      if (options.limit) {
  1755→        const limit = parseInt(options.limit, 10);
  1756→        if (!Number.isNaN(limit) && limit > 0) {
  1757→          allEvents = allEvents.slice(-limit);
  1758→        }
  1759→      }
  1760→
  1761→      events = allEvents;
  1762→    }
  1763→
  1764→    // AC: @session-log-show ac-6 - Context snapshot
  1765→    let contextSnapshot: unknown | null = null;
  1766→    if (options.context) {
  1767→      const iterNum = parseInt(options.context, 10);
  1768→      if (!Number.isNaN(iterNum) && iterNum > 0) {
  1769→        contextSnapshot = await readSessionContext(
  1770→          ctx.specDir,
  1771→          sessionId,
  1772→          iterNum,
  1773→        );
  1774→        if (contextSnapshot === null) {
  1775→          error(`No context snapshot found for iteration ${iterNum}`);
  1776→          process.exit(EXIT_CODES.NOT_FOUND);
  1777→        }
  1778→      } else {
  1779→        error(`Invalid iteration number: ${options.context}`);
  1780→        process.exit(EXIT_CODES.USAGE_ERROR);
  1781→      }
  1782→    }
  1783→
  1784→    const sessionStartTs = new Date(detail.started_at).getTime();
  1785→
  1786→    // Build JSON output structure
  1787→    const jsonOutput = {
  1788→      ...detail,
  1789→      ...(events !== null ? { events } : {}),
  1790→      ...(contextSnapshot !== null ? { context: contextSnapshot } : {}),
  1791→    };
  1792→
  1793→    output(jsonOutput, () =>
  1794→      formatSessionLogShow(detail, events, contextSnapshot, sessionStartTs),
  1795→    );
  1796→  } catch (err) {
  1797→    error("Failed to show session log", err);
  1798→    process.exit(EXIT_CODES.ERROR);
  1799→  }
  1800→}
  1801→
  1802→// ─── Session Log Stats ─────────────────────────────────────────────────────────
  1803→
  1804→interface SessionLogStatsOptions {
  1805→  since?: string;
  1806→  agent?: string;
  1807→  toolUsage?: boolean;
  1808→  byDay?: boolean;
  1809→  byWeek?: boolean;
  1810→}
  1811→
  1812→/**
  1813→ * Full stats output including optional tool usage and time period data.
  1814→ */
  1815→interface SessionLogStatsOutput {
  1816→  stats: SessionLogStats;
  1817→  tool_usage?: ToolUsageStats[];
  1818→  time_periods?: TimePeriodStats[];
  1819→}
  1820→
  1821→/**
  1822→ * Format a duration in milliseconds to human-readable format.
  1823→ * Reuses formatDuration from session log list but handles hours/minutes/seconds.
  1824→ */
  1825→function formatDurationLong(ms: number): string {
  1826→  if (ms < 0) return "—";
  1827→  const totalSec = Math.floor(ms / 1000);
  1828→  const hours = Math.floor(totalSec / 3600);
  1829→  const minutes = Math.floor((totalSec % 3600) / 60);
  1830→  const seconds = totalSec % 60;
  1831→  if (hours > 0 && minutes > 0) {
  1832→    return `${hours}h ${minutes}m`;
  1833→  }
  1834→  if (hours > 0) {
  1835→    return `${hours}h`;
  1836→  }
  1837→  if (minutes > 0) {
  1838→    return `${minutes}m ${seconds}s`;
  1839→  }
  1840→  return `${seconds}s`;
  1841→}
  1842→
  1843→/**
  1844→ * Format the session log stats output.
  1845→ *
  1846→ * AC: @session-log-stats ac-1, ac-2, ac-3
  1847→ */
  1848→function formatSessionLogStats(
  1849→  stats: SessionLogStats,
  1850→  toolUsage: ToolUsageStats[] | null,
  1851→  timePeriods: TimePeriodStats[] | null,
  1852→  groupBy: "day" | "week" | null,
  1853→): void {
  1854→  // AC: @session-log-stats ac-1 - Totals
  1855→  console.log(chalk.bold("Session Statistics"));
  1856→  console.log(chalk.gray("─".repeat(50)));
  1857→  console.log(`  Total Sessions:     ${stats.total_sessions}`);
  1858→  console.log(`  Total Events:       ${stats.total_events}`);
  1859→  console.log(`  Total Iterations:   ${stats.total_iterations}`);
  1860→  console.log(`  Tasks Completed:    ${stats.total_tasks_completed}`);
  1861→  console.log(`  Total Duration:     ${formatDurationLong(stats.total_duration_ms)}`);
  1862→
  1863→  // AC: @session-log-stats ac-2 - Averages
  1864→  console.log("\n" + chalk.bold("Averages"));
  1865→  console.log(chalk.gray("─".repeat(50)));
  1866→  console.log(`  Avg Duration/Session:     ${formatDurationLong(stats.avg_duration_ms)}`);
  1867→  console.log(`  Avg Iterations/Session:   ${stats.avg_iterations_per_session}`);
  1868→  console.log(`  Avg Tasks/Session:        ${stats.avg_tasks_per_session}`);
  1869→
  1870→  // AC: @session-log-stats ac-3 - Status breakdown
  1871→  if (stats.status_breakdown.length > 0) {
  1872→    console.log("\n" + chalk.bold("Status Breakdown"));
  1873→    console.log(chalk.gray("─".repeat(50)));
  1874→    for (const item of stats.status_breakdown) {
  1875→      const statusColor =
  1876→        item.status === "completed"
  1877→          ? chalk.green
  1878→          : item.status === "active"
  1879→            ? chalk.blue
  1880→            : chalk.yellow;
  1881→      console.log(
  1882→        `  ${statusColor(item.status.padEnd(12))} ${String(item.count).padEnd(6)} ${item.percentage}%`,
  1883→      );
  1884→    }
  1885→  }
  1886→
  1887→  // AC: @session-log-stats ac-6 - Tool usage
  1888→  if (toolUsage !== null && toolUsage.length > 0) {
  1889→    console.log("\n" + chalk.bold("Top Tool Usage"));
  1890→    console.log(chalk.gray("─".repeat(50)));
  1891→    for (const tool of toolUsage) {
  1892→      console.log(
  1893→        `  ${tool.tool_name.padEnd(20)} ${String(tool.count).padEnd(8)} ${tool.percentage}%`,
  1894→      );
  1895→    }
  1896→  }
  1897→
  1898→  // AC: @session-log-stats ac-7 - Time periods
  1899→  if (timePeriods !== null && timePeriods.length > 0) {
  1900→    const label = groupBy === "week" ? "By Week" : "By Day";
  1901→    console.log("\n" + chalk.bold(label));
  1902→    console.log(chalk.gray("─".repeat(50)));
  1903→    console.log(
  1904→      chalk.gray(
  1905→        `  ${"Period".padEnd(14)} ${"Sessions".padEnd(10)} ${"Tasks".padEnd(8)} Duration`,
  1906→      ),
  1907→    );
  1908→    for (const period of timePeriods) {
  1909→      console.log(
  1910→        `  ${period.period.padEnd(14)} ${String(period.sessions_count).padEnd(10)} ${String(period.tasks_completed).padEnd(8)} ${formatDurationLong(period.total_duration_ms)}`,
  1911→      );
  1912→    }
  1913→  }
  1914→}
  1915→
  1916→/**
  1917→ * Session log stats action handler.
  1918→ */
  1919→async function sessionLogStatsAction(
  1920→  options: SessionLogStatsOptions,
  1921→): Promise<void> {
  1922→  try {
  1923→    const ctx = await initContext();
  1924→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1925→
  1926→    // AC: @session-log-stats ac-4 - Filter by since
  1927→    if (options.since) {
  1928→      const sinceDate = parseTimeSpec(options.since);
  1929→      if (sinceDate) {
  1930→        sessions = sessions.filter(
  1931→          (s) => new Date(s.started_at) >= sinceDate,
  1932→        );
  1933→      }
  1934→    }
  1935→
  1936→    // AC: @session-log-stats ac-5 - Filter by agent type
  1937→    if (options.agent) {
  1938→      const agentFilter = options.agent;
  1939→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1940→    }
  1941→
  1942→    // AC: @session-log-stats ac-8 - No sessions match criteria
  1943→    if (sessions.length === 0) {
  1944→      output({ message: "No sessions match criteria" }, () => {
  1945→        console.log("No sessions match criteria.");
  1946→      });
  1947→      return;
  1948→    }
  1949→
  1950→    // Compute base stats
  1951→    const stats = computeSessionLogStats(sessions);
  1952→
  1953→    // AC: @session-log-stats ac-6 - Tool usage (optional)
  1954→    let toolUsage: ToolUsageStats[] | null = null;
  1955→    if (options.toolUsage) {
  1956→      const sessionIds = sessions.map((s) => s.id);
  1957→      toolUsage = await computeToolUsageStats(ctx.specDir, sessionIds);
  1958→    }
  1959→
  1960→    // AC: @session-log-stats ac-7 - Time periods (optional)
  1961→    let timePeriods: TimePeriodStats[] | null = null;
  1962→    let groupBy: "day" | "week" | null = null;
  1963→    if (options.byDay) {
  1964→      groupBy = "day";
  1965→      timePeriods = computeTimePeriodStats(sessions, "day");
  1966→    } else if (options.byWeek) {
  1967→      groupBy = "week";
  1968→      timePeriods = computeTimePeriodStats(sessions, "week");
  1969→    }
  1970→
  1971→    // Build output structure
  1972→    const jsonOutput: SessionLogStatsOutput = { stats };
  1973→    if (toolUsage !== null) {
  1974→      jsonOutput.tool_usage = toolUsage;
  1975→    }
  1976→    if (timePeriods !== null) {
  1977→      jsonOutput.time_periods = timePeriods;
  1978→    }
  1979→
  1980→    output(jsonOutput, () =>
  1981→      formatSessionLogStats(stats, toolUsage, timePeriods, groupBy),
  1982→    );
  1983→  } catch (err) {
  1984→    error("Failed to compute session log stats", err);
  1985→    process.exit(EXIT_CODES.ERROR);
  1986→  }
  1987→}
  1988→
  1989→// ─── Session Log Search ─────────────────────────────────────────────────────────
  1990→
  1991→interface SessionLogSearchOptions {
  1992→  type?: string;
  1993→  since?: string;
  1994→  agent?: string;
  1995→  limit?: string;
  1996→}
  1997→
  1998→/**
  1999→ * Format relative timestamp from event timestamp (Unix ms) to session start.
  2000→ */
  2001→function formatSearchTimestamp(eventTs: number): string {
  2002→  return new Date(eventTs).toISOString();
  2003→}
  2004→
  2005→/**
  2006→ * Format the session log search output.
  2007→ *
  2008→ * AC: @session-log-search ac-1, ac-4
  2009→ */
  2010→function formatSessionLogSearch(results: SessionSearchResult[]): void {
  2011→  if (results.length === 0) {
  2012→    // AC: @session-log-search ac-6
  2013→    console.log("No matches found.");
  2014→    return;
  2015→  }
  2016→
  2017→  let totalMatches = 0;
  2018→  for (const session of results) {
  2019→    totalMatches += session.matches.length;
  2020→  }
  2021→
  2022→  console.log(chalk.bold(`Found ${totalMatches} match(es) in ${results.length} session(s)`));
  2023→  console.log(chalk.gray("─".repeat(60)));
  2024→
  2025→  for (const session of results) {
  2026→    // Session header
  2027→    console.log(
  2028→      `\n${chalk.cyan(`Session ${session.session_id.slice(0, 8)}`)} ` +
  2029→        `${chalk.gray(`(${session.agent_type}, started ${formatRelativeTime(new Date(session.started_at))})`)}`
  2030→    );
  2031→
  2032→    // AC: @session-log-search ac-4 - Show matches with session ID, timestamp, type, excerpt
  2033→    for (const match of session.matches) {
  2034→      const ts = formatSearchTimestamp(match.timestamp);
  2035→      const typeColor =
  2036→        match.event_type === "session.start" || match.event_type === "session.end"
  2037→          ? chalk.green
  2038→          : match.event_type === "session.update"
  2039→            ? chalk.blue
  2040→            : chalk.gray;
  2041→      console.log(
  2042→        `  ${chalk.yellow(ts)} ${typeColor(match.event_type.padEnd(16))}`,
  2043→      );
  2044→      // Content excerpt on next line, indented
  2045→      console.log(`    ${chalk.gray(match.content_excerpt)}`);
  2046→    }
  2047→  }
  2048→}
  2049→
  2050→/**
  2051→ * Session log search action handler.
  2052→ *
  2053→ * AC: @session-log-search ac-1 through ac-7
  2054→ */
  2055→async function sessionLogSearchAction(
  2056→  pattern: string,
  2057→  options: SessionLogSearchOptions,
  2058→): Promise<void> {
  2059→  try {
  2060→    const ctx = await initContext();
  2061→
  2062→    // Parse options - validate limit as positive integer
  2063→    let limit = 50;
  2064→    if (options.limit) {
  2065→      const parsed = parseInt(options.limit, 10);
  2066→      if (Number.isNaN(parsed) || parsed <= 0) {
  2067→        error(`Invalid limit: ${options.limit}. Must be a positive integer.`);
  2068→        process.exit(EXIT_CODES.USAGE_ERROR);
  2069→      }
  2070→      limit = parsed;
  2071→    }
  2072→    const sinceDate = options.since ? parseTimeSpec(options.since) : undefined;
  2073→
  2074→    // AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7
  2075→    const results = await searchSessionEvents(ctx.specDir, pattern, {
  2076→      eventType: options.type,
  2077→      sinceDate: sinceDate || undefined,
  2078→      agentType: options.agent,
  2079→      limit,
  2080→    });
  2081→
  2082→    // AC: @session-log-search ac-6 - No matches found message
  2083→    // exit code 0 regardless (per @trait-semantic-exit-codes ac-5)
  2084→
  2085→    output(results, () => formatSessionLogSearch(results));
  2086→  } catch (err) {
  2087→    error("Failed to search session logs", err);
  2088→    process.exit(EXIT_CODES.ERROR);
  2089→  }
  2090→}
  2091→
  2092→// ─── Session Create Action ─────────────────────────────────────────────────
  2093→
  2094→/**
  2095→ * Action handler for `kspec session create`.
  2096→ *
  2097→ * Creates a new session with optional budget and environment injection.
  2098→ *
  2099→ * AC: @session-creation-and-env-injection ac-create
  2100→ * AC: @session-creation-and-env-injection ac-budget
  2101→ * AC: @session-creation-and-env-injection ac-budget-local
  2102→ * AC: @session-creation-and-env-injection ac-inject-claude
  2103→ * AC: @session-creation-and-env-injection ac-inject-codex
  2104→ * AC: @session-creation-and-env-injection ac-inject-fallback
  2105→ *
  2106→ * Exit codes documented per @trait-semantic-exit-codes ac-8:
  2107→ * - 0: Session created successfully
  2108→ * - 1: Validation error (invalid budget value)
  2109→ * - 3: Runtime error (filesystem failure)
  2110→ */
  2111→async function sessionCreateAction(options: {
  2112→  agentType: string;
  2113→  budget?: string;
  2114→  inject?: boolean;
  2115→  taskId?: string;
  2116→}): Promise<void> {
  2117→  try {
  2118→    const ctx = await initContext();
  2119→
  2120→    // AC: @session-creation-and-env-injection ac-invalid-session
  2121→    // Validate existing KSPEC_SESSION_ID if set — warn user if it's stale/corrupt
  2122→    const existingSessionId = process.env.KSPEC_SESSION_ID;
  2123→    if (existingSessionId) {
  2124→      const validation = await validateSessionId(ctx.specDir, existingSessionId);
  2125→      if (!validation.valid) {
  2126→        warn(
  2127→          `Current KSPEC_SESSION_ID (${existingSessionId}) is invalid: ${validation.error}`,
  2128→        );
  2129→        info(validation.suggestion || "Creating a new session will generate a fresh ID.");
  2130→      }
  2131→    }
  2132→
  2133→    // Validate budget if provided
  2134→    // AC: @trait-error-guidance ac-5 - indicate which field/value failed
  2135→    let budgetNum: number | undefined;
  2136→    if (options.budget !== undefined) {
  2137→      // Use Number() instead of parseInt to reject "3.5", "3abc", "1e2" etc.
  2138→      budgetNum = Number(options.budget);
  2139→      if (isNaN(budgetNum) || budgetNum <= 0 || !Number.isInteger(budgetNum) || !/^\d+$/.test(options.budget)) {
  2140→        // AC: @trait-error-guidance ac-2, ac-5 - include suggested action and field info
  2141→        // AC: @trait-error-guidance ac-6 - guidance included in structured error
  2142→        error(
  2143→          `Invalid budget value: "${options.budget}". Must be a positive integer.`,
  2144→          { suggestion: "Usage: kspec session create --budget <positive-integer>" },
  2145→        );
  2146→        process.exit(EXIT_CODES.USAGE_ERROR);
  2147→      }
  2148→    }
  2149→
  2150→    // Generate session ID
  2151→    const sessionId = ulid();
  2152→
  2153→    // AC: @session-creation-and-env-injection ac-create, ac-budget, ac-budget-local
  2154→    const result = await createSessionWithBudget(ctx.specDir, {
  2155→      id: sessionId,
  2156→      agent_type: options.agentType,
  2157→      task_id: options.taskId,
  2158→      budget: budgetNum,
  2159→    });
  2160→
  2161→    // Handle environment injection if requested
  2162→    let injection: EnvInjectionResult | null = null;
  2163→    if (options.inject) {
  2164→      injection = await performEnvInjection(sessionId);
  2165→    }
  2166→
  2167→    // Build output data
  2168→    const outputData: Record<string, unknown> = {
  2169→      session_id: result.session_id,
  2170→      agent_type: result.session.agent_type,
  2171→      status: result.session.status,
  2172→      started_at: result.session.started_at,
  2173→    };
  2174→
  2175→    if (result.session.task_id) {
  2176→      outputData.task_id = result.session.task_id;
  2177→    }
  2178→
  2179→    if (result.budget) {
  2180→      outputData.budget = {
  2181→        max_per_cycle: result.budget.max_per_cycle,
  2182→        started_this_cycle: result.budget.started_this_cycle,
  2183→      };
  2184→    }
  2185→
  2186→    if (injection) {
  2187→      outputData.env_injection = {
  2188→        method: injection.method,
  2189→        injected: injection.injected,
  2190→        description: injection.description,
  2191→        ...(injection.path ? { path: injection.path } : {}),
  2192→      };
  2193→    }
  2194→
  2195→    // AC: @trait-json-output ac-1, ac-2, ac-5 - JSON with all data, ISO timestamps
  2196→    output(outputData, () => {
  2197→      // AC: @session-creation-and-env-injection ac-create - print session ID to stdout
  2198→      success(`Created session: ${sessionId}`, { session_id: sessionId });
  2199→      info(`Agent type: ${options.agentType}`);
  2200→
  2201→      if (result.budget) {
  2202→        info(
  2203→          `Budget: ${result.budget.max_per_cycle} tasks per cycle`,
  2204→        );
  2205→      }
  2206→
  2207→      if (injection) {
  2208→        if (injection.injected) {
  2209→          info(injection.description);
  2210→        } else {
  2211→          // AC: @session-creation-and-env-injection ac-inject-fallback
  2212→          console.log(injection.description);
  2213→        }
  2214→      }
  2215→    });
  2216→  } catch (err) {
  2217→    // AC: @trait-error-guidance ac-1 - describe what went wrong
  2218→    // AC: @trait-json-output ac-3 - error as JSON object
  2219→    error("Failed to create session", err);
  2220→    process.exit(EXIT_CODES.ERROR);
  2221→  }
  2222→}
  2223→
  2224→/**
  2225→ * Detect agent harness and perform environment injection.
  2226→ *
  2227→ * AC: @session-creation-and-env-injection ac-inject-claude
  2228→ * AC: @session-creation-and-env-injection ac-inject-codex
  2229→ * AC: @session-creation-and-env-injection ac-inject-fallback
  2230→ */
  2231→async function performEnvInjection(
  2232→  sessionId: string,
  2233→): Promise<EnvInjectionResult> {
  2234→  // Detect Claude Code
  2235→  if (
  2236→    process.env.CLAUDECODE === "1" ||
  2237→    process.env.CLAUDE_CODE_ENTRYPOINT ||
  2238→    process.env.CLAUDE_PROJECT_DIR
  2239→  ) {
  2240→    return injectClaudeCodeEnv(sessionId);
  2241→  }
  2242→
  2243→  // Detect Codex CLI
  2244→  if (process.env.CODEX_SANDBOX) {
  2245→    return injectCodexEnv(sessionId);
  2246→  }
  2247→
  2248→  // Detect Gemini CLI
  2249→  if (process.env.GEMINI_CLI === "1") {
  2250→    return injectGeminiEnv(sessionId);
  2251→  }
  2252→
  2253→  // Detect OpenCode
  2254→  if (process.env.OPENCODE_CONFIG_DIR || process.env.OPENCODE_CONFIG) {
  2255→    return injectOpenCodeEnv(sessionId);
  2256→  }
  2257→
  2258→  // Fallback for unknown harnesses
  2259→  return getFallbackInjectionInstructions(sessionId);
  2260→}
  2261→
  2262→/**
  2263→ * Register the 'session' command group and aliases
  2264→ */
  2265→export function registerSessionCommands(program: Command): void {
  2266→  const session = program
  2267→    .command("session")
  2268→    .description("Session management and context");
  2269→
  2270→  // Session create subcommand
  2271→  markMutating(session.command("create"))
  2272→    .description("Create a new kspec session with optional budget")
  2273→    .option(
  2274→      "--agent-type <type>",
  2275→      "Agent type (e.g., claude-code, codex-cli)",
  2276→      "claude-code",
  2277→    )
  2278→    .option("--budget <n>", "Maximum tasks per cycle (positive integer)")
  2279→    .option("--inject", "Inject KSPEC_SESSION_ID into agent environment")
  2280→    .option("--task-id <id>", "Optional task ID being worked on")
  2281→    .action(sessionCreateAction);
  2282→
  2283→  session
  2284→    .command("start")
  2285→    .alias("resume")
  2286→    .description("Surface relevant context for starting a new working session")
  2287→    .option("--brief", "Compact summary (default)")
  2288→    .option("--full", "Comprehensive context dump")
  2289→    .option(
  2290→      "--since <time>",
  2291→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  2292→    )
  2293→    .option("--no-git", "Skip git commit information")
  2294→    .option("-n, --limit <n>", "Limit items per section", "10")
  2295→    .action(sessionStartAction);
  2296→
  2297→  // Session log subcommand group
  2298→  const log = session
  2299→    .command("log")
  2300→    .description("Session log analysis commands");
  2301→
  2302→  log
  2303→    .command("list")
  2304→    .description("List session logs with summary statistics")
  2305→    .option(
  2306→      "-s, --status <status>",
  2307→      "Filter by status (active, completed, abandoned)",
  2308→    )
  2309→    .option("--agent <type>", "Filter by agent type")
  2310→    .option(
  2311→      "--since <time>",
  2312→      "Only show sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2313→    )
  2314→    .option(
  2315→      "--sort <field>",
  2316→      "Sort by field (started_at, duration, events, iterations, tasks_completed)",
  2317→      "started_at",
  2318→    )
  2319→    .option("--count", "Show only the count of matching sessions")
  2320→    .option("-n, --limit <n>", "Limit number of sessions shown")
  2321→    .action(sessionLogListAction);
  2322→
  2323→  log
  2324→    .command("show <session-id>")
  2325→    .description("Show detailed view of a single session")
  2326→    .option("-e, --events", "Include chronological event timeline")
  2327→    .option("-t, --type <type>", "Filter events by type (e.g., tool.call)")
  2328→    .option("-n, --limit <n>", "Show only the last N events")
  2329→    .option("-c, --context <n>", "Show context snapshot for iteration N")
  2330→    .action(sessionLogShowAction);
  2331→
  2332→  log
  2333→    .command("stats")
  2334→    .description("Aggregate analytics across sessions")
  2335→    .option(
  2336→      "--since <time>",
  2337→      "Only include sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2338→    )
  2339→    .option("--agent <type>", "Only include sessions with this agent type")
  2340→    .option("--tool-usage", "Display top 10 tool calls by frequency")
  2341→    .option("--by-day", "Group stats by day")
  2342→    .option("--by-week", "Group stats by week")
  2343→    .action(sessionLogStatsAction);
  2344→
  2345→  log
  2346→    .command("search <pattern>")
  2347→    .description("Search across session events by content")
  2348→    .option("-t, --type <type>", "Only search events of this type (e.g., session.update)")
  2349→    .option(
  2350→      "--since <time>",
  2351→      "Only search sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2352→    )
  2353→    .option("--agent <type>", "Only search sessions with this agent type")
  2354→    .option("-n, --limit <n>", "Maximum matches to return (default: 50)")
  2355→    .action(sessionLogSearchAction);
  2356→
  2357→  session
  2358→    .command("checkpoint")
  2359→    .description(
  2360→      "Pre-stop hook: check for uncommitted work before ending session",
  2361→    )
  2362→    .option("--force", "Allow session end regardless of issues")
  2363→    .action(sessionCheckpointAction);
  2364→
  2365→  session
  2366→    .command("prompt-check")
  2367→    .description("UserPromptSubmit hook: inject spec-first reminder")
  2368→    .action(sessionPromptCheckAction);
  2369→
  2370→  // Top-level alias: kspec context
  2371→  program
  2372→    .command("context")
  2373→    .description("Alias for session start - surface session context")
  2374→    .option("--brief", "Compact summary (default)")
  2375→    .option("--full", "Comprehensive context dump")
  2376→    .option(
  2377→      "--since <time>",
  2378→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  2379→    )
  2380→    .option("--no-git", "Skip git commit information")
  2381→    .option("-n, --limit <n>", "Limit items per section", "10")
  2382→    .action(sessionStartAction);
  2383→}
