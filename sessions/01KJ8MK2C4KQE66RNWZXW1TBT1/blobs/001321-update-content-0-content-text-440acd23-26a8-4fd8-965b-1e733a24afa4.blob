```
     1→/**
     2→ * Enhanced setup command for kspec agent integration.
     3→ *
     4→ * Orchestrates the full onboarding pipeline:
     5→ * - Detect agent environment (Claude Code, Cline, etc.)
     6→ * - Install hooks (UserPromptSubmit, Stop, PreToolUse guards)
     7→ * - Render skills from .kspec/skills/ to .claude/skills/
     8→ * - Generate kspec-agents.md
     9→ *
    10→ * AC: @enhanced-setup ac-1 - summary displayed listing each step performed
    11→ * AC: @enhanced-setup ac-2 - all hook entries (UserPromptSubmit, Stop, PreToolUse) present
    12→ * AC: @enhanced-setup ac-3 - rendered skill files exist for each skill targeting claude-code
    13→ * AC: @enhanced-setup ac-4 - kspec-agents.md exists after setup
    14→ * AC: @enhanced-setup ac-5 - --skip-skills flag skips skill rendering
    15→ * AC: @enhanced-setup ac-6 - --dry-run displays planned actions without changes
    16→ * AC: @enhanced-setup ac-7 - --status reports current state including agent detected
    17→ * AC: @enhanced-setup ac-8 - --status shows hooks status, skills rendered count, agents.md freshness
    18→ * AC: @enhanced-setup ac-9 - skills referenced by ralph (task-work, reflect) are present
    19→ */
    20→
    21→import * as fs from "node:fs/promises";
    22→import * as os from "node:os";
    23→import * as path from "node:path";
    24→import * as readline from "node:readline/promises";
    25→import chalk from "chalk";
    26→import type { Command } from "commander";
    27→import {
    28→  getGitRoot,
    29→  getShadowStatus,
    30→  repairShadow,
    31→  SHADOW_BRANCH_NAME,
    32→} from "../../parser/shadow.js";
    33→import { errors } from "../../strings/index.js";
    34→import { EXIT_CODES } from "../exit-codes.js";
    35→import { error, output, success, warn } from "../output.js";
    36→
    37→/**
    38→ * Log a message at debug level (only when KSPEC_DEBUG=1)
    39→ * AC: @setup-pipeline-unification ac-4
    40→ */
    41→function debugLog(message: string, detail?: unknown): void {
    42→  if (process.env.KSPEC_DEBUG === "1") {
    43→    if (detail) {
    44→      console.error(`[DEBUG] setup: ${message}`, detail);
    45→    } else {
    46→      console.error(`[DEBUG] setup: ${message}`);
    47→    }
    48→  }
    49→}
    50→
    51→/**
    52→ * Supported agent types for auto-configuration
    53→ */
    54→export type AgentType =
    55→  | "claude-code"
    56→  | "cline"
    57→  | "roo-code"
    58→  | "copilot-cli"
    59→  | "gemini-cli"
    60→  | "codex-cli"
    61→  | "aider"
    62→  | "opencode"
    63→  | "amp"
    64→  | "unknown";
    65→
    66→/**
    67→ * Result of agent detection
    68→ */
    69→export interface DetectedAgent {
    70→  type: AgentType;
    71→  confidence: "high" | "medium" | "low";
    72→  configPath?: string;
    73→  envVars?: Record<string, string>;
    74→}
    75→
    76→/**
    77→ * Detect which agent environment we're running in.
    78→ * Returns the detected agent type and confidence level.
    79→ *
    80→ * Detection priority matters - more specific markers checked first.
    81→ */
    82→export function detectAgent(): DetectedAgent {
    83→  // Claude Code: Multiple possible markers
    84→  // CLAUDECODE=1 is set in CLI sessions
    85→  // CLAUDE_CODE_ENTRYPOINT indicates entry point (cli, etc.)
    86→  // CLAUDE_PROJECT_DIR is set in some contexts
    87→  if (
    88→    process.env.CLAUDECODE === "1" ||
    89→    process.env.CLAUDE_CODE_ENTRYPOINT ||
    90→    process.env.CLAUDE_PROJECT_DIR
    91→  ) {
    92→    return {
    93→      type: "claude-code",
    94→      confidence: "high",
    95→      configPath: path.join(os.homedir(), ".claude", "settings.json"),
    96→      envVars: {
    97→        ...(process.env.CLAUDECODE && { CLAUDECODE: process.env.CLAUDECODE }),
    98→        ...(process.env.CLAUDE_CODE_ENTRYPOINT && {
    99→          CLAUDE_CODE_ENTRYPOINT: process.env.CLAUDE_CODE_ENTRYPOINT,
   100→        }),
   101→        ...(process.env.CLAUDE_PROJECT_DIR && {
   102→          CLAUDE_PROJECT_DIR: process.env.CLAUDE_PROJECT_DIR,
   103→        }),
   104→      },
   105→    };
   106→  }
   107→
   108→  // Cline: CLINE_ACTIVE is set when running in Cline terminal
   109→  if (process.env.CLINE_ACTIVE) {
   110→    return {
   111→      type: "cline",
   112→      confidence: "high",
   113→      // Cline uses VS Code settings, but env vars should be in shell profile
   114→      configPath: undefined,
   115→      envVars: { CLINE_ACTIVE: process.env.CLINE_ACTIVE },
   116→    };
   117→  }
   118→
   119→  // GitHub Copilot CLI: Check for copilot-specific markers
   120→  if (process.env.COPILOT_MODEL || process.env.GH_TOKEN) {
   121→    return {
   122→      type: "copilot-cli",
   123→      confidence: "medium",
   124→      configPath: path.join(os.homedir(), ".copilot", "config.json"),
   125→    };
   126→  }
   127→
   128→  // Aider: Check for AIDER_* env vars
   129→  if (process.env.AIDER_MODEL || process.env.AIDER_DARK_MODE !== undefined) {
   130→    return {
   131→      type: "aider",
   132→      confidence: "high",
   133→      configPath: path.join(os.homedir(), ".aider.conf.yml"),
   134→    };
   135→  }
   136→
   137→  // OpenCode: Check for OPENCODE_* env vars
   138→  if (process.env.OPENCODE_CONFIG_DIR || process.env.OPENCODE_CONFIG) {
   139→    return {
   140→      type: "opencode",
   141→      confidence: "high",
   142→      configPath:
   143→        process.env.OPENCODE_CONFIG ||
   144→        path.join(os.homedir(), ".config", "opencode", "opencode.json"),
   145→    };
   146→  }
   147→
   148→  // Gemini CLI: GEMINI_CLI=1 is set when running in Gemini CLI
   149→  if (process.env.GEMINI_CLI === "1") {
   150→    return {
   151→      type: "gemini-cli",
   152→      confidence: "high",
   153→      configPath: path.join(os.homedir(), ".gemini", "settings.json"),
   154→      envVars: { GEMINI_CLI: "1" },
   155→    };
   156→  }
   157→
   158→  // Codex CLI: CODEX_SANDBOX is set when running in sandbox
   159→  if (process.env.CODEX_SANDBOX) {
   160→    return {
   161→      type: "codex-cli",
   162→      confidence: "high",
   163→      configPath: path.join(os.homedir(), ".codex", "config.toml"),
   164→      envVars: { CODEX_SANDBOX: process.env.CODEX_SANDBOX },
   165→    };
   166→  }
   167→
   168→  // Amp (Sourcegraph): Check for AMP_API_KEY or AMP_TOOLBOX
   169→  if (process.env.AMP_API_KEY || process.env.AMP_TOOLBOX) {
   170→    return {
   171→      type: "amp",
   172→      confidence: "medium",
   173→      configPath: path.join(os.homedir(), ".config", "amp", "settings.json"),
   174→    };
   175→  }
   176→
   177→  return {
   178→    type: "unknown",
   179→    confidence: "low",
   180→  };
   181→}
   182→
   183→/**
   184→ * Install KSPEC_AUTHOR config for Claude Code (global settings)
   185→ */
   186→async function installClaudeCodeConfig(author: string): Promise<boolean> {
   187→  const configPath = path.join(os.homedir(), ".claude", "settings.json");
   188→  const configDir = path.dirname(configPath);
   189→
   190→  try {
   191→    // Ensure directory exists
   192→    await fs.mkdir(configDir, { recursive: true });
   193→
   194→    // Read existing config or start fresh
   195→    let config: Record<string, unknown> = {};
   196→    try {
   197→      const existing = await fs.readFile(configPath, "utf-8");
   198→      config = JSON.parse(existing);
   199→    } catch (err) {
   200→      debugLog("No existing Claude Code config, starting fresh", err);
   201→    }
   202→
   203→    // Merge env settings
   204→    const env = (config.env as Record<string, string>) || {};
   205→    env.KSPEC_AUTHOR = author;
   206→    config.env = env;
   207→
   208→    // Write back
   209→    await fs.writeFile(
   210→      configPath,
   211→      `${JSON.stringify(config, null, 2)}\n`,
   212→      "utf-8",
   213→    );
   214→    return true;
   215→  } catch (err) {
   216→    debugLog("Failed to install Claude Code config", err);
   217→    return false;
   218→  }
   219→}
   220→
   221→/**
   222→ * Result of installing hooks
   223→ * AC: @enhanced-setup ac-2 - tracks all hook types
   224→ */
   225→export interface HooksInstallResult {
   226→  promptCheck: boolean;
   227→  stop: boolean;
   228→  preToolUse: boolean;
   229→  guardsCreated: string[];
   230→}
   231→
   232→/**
   233→ * PreToolUse guard hook scripts
   234→ * These are the shell scripts that will be installed to .claude/hooks/
   235→ */
   236→const GUARD_SCRIPTS: Record<string, string> = {
   237→  "kspec-worktree-guard.sh": `#!/bin/bash
   238→# Guard against dangerous git operations in .kspec worktree
   239→#
   240→# This hook prevents accidentally creating branches or switching
   241→# branches in the .kspec worktree, which should always stay on kspec-meta.
   242→
   243→# Read the tool input from stdin
   244→INPUT=$(cat)
   245→
   246→# Extract the command from the JSON input
   247→COMMAND=$(echo "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)
   248→
   249→# If no command, allow (not a Bash tool call)
   250→if [ -z "$COMMAND" ]; then
   251→  echo '{"decision": "allow"}'
   252→  exit 0
   253→fi
   254→
   255→# Two views of the command for safe matching:
   256→# 1. UNQUOTED: remove quote chars (keeps content) to catch split-quote
   257→#    bypasses like: git "reset" --hard → git reset --hard
   258→# 2. STRIPPED: remove entire quoted strings to ignore patterns in args
   259→#    like: echo "git reset" → echo
   260→UNQUOTED=$(echo "$COMMAND" | sed 's/["\\x27]//g')
   261→STRIPPED=$(echo "$COMMAND" | sed -e "s/\\x27[^\\x27]*\\x27//g" -e 's/"[^"]*"//g')
   262→# First command word (handles leading whitespace)
   263→FIRST_CMD=$(echo "$COMMAND" | sed 's/^[[:space:]]*//' | cut -d' ' -f1)
   264→
   265→# Block deleting kspec-meta from anywhere (check unquoted to catch bypasses)
   266→if [[ "$UNQUOTED" == *"git branch -d kspec-meta"* || "$UNQUOTED" == *"git branch -D kspec-meta"* ]]; then
   267→  cat <<EOF
   268→{
   269→  "decision": "block",
   270→  "reason": "[kspec-worktree-guard] BLOCKED: Cannot delete kspec-meta branch. This is the main branch for the .kspec worktree."
   271→}
   272→EOF
   273→  exit 0
   274→fi
   275→
   276→# Get cwd from hook input (not pwd - hook runs in different context)
   277→CWD=$(echo "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)
   278→IN_KSPEC=false
   279→
   280→if [[ "$CWD" == *"/.kspec"* || "$CWD" == *"/.kspec" ]]; then
   281→  IN_KSPEC=true
   282→fi
   283→
   284→# Also check if command contains cd to .kspec
   285→if [[ "$COMMAND" == *"cd "*".kspec"* || "$COMMAND" == *"cd .kspec"* ]]; then
   286→  IN_KSPEC=true
   287→fi
   288→
   289→if [ "$IN_KSPEC" = false ]; then
   290→  echo '{"decision": "allow"}'
   291→  exit 0
   292→fi
   293→
   294→# Dangerous patterns in .kspec (branch creation/modification/history rewriting)
   295→# Note: "git checkout kspec-meta" is safe and allowed
   296→DANGEROUS_PATTERNS=(
   297→  # Branch creation
   298→  "git checkout -b"
   299→  "git checkout -B"
   300→  "git branch -c"
   301→  "git branch -C"
   302→  "git branch -m"
   303→  "git branch -M"
   304→  "git switch -c"
   305→  "git switch -C"
   306→  "git switch --create"
   307→  # History rewriting - these can cause conflicts with active sessions
   308→  "git reset"
   309→  "git rebase"
   310→  "git cherry-pick"
   311→  "git commit --amend"
   312→  # Force push
   313→  "git push --force"
   314→  "git push -f"
   315→  # Discarding changes
   316→  "git stash"
   317→  "git clean"
   318→  "git checkout -- "
   319→  "git restore"
   320→)
   321→
   322→for pattern in "\${DANGEROUS_PATTERNS[@]}"; do
   323→  # Block if:
   324→  # - Pattern matches UNQUOTED AND first command is "git" (catches split-quote bypasses), OR
   325→  # - Pattern matches STRIPPED (actual command outside any quotes)
   326→  # This allows: echo "git reset", grep "git stash" (first cmd is echo/grep, pattern not in STRIPPED)
   327→  # This blocks: git reset, git "reset" --hard, git st'ash' (first cmd is git OR pattern in STRIPPED)
   328→  if [[ "$STRIPPED" == *"$pattern"* ]] || { [[ "$UNQUOTED" == *"$pattern"* ]] && [[ "$FIRST_CMD" == "git" ]]; }; then
   329→    cat <<EOF
   330→{
   331→  "decision": "block",
   332→  "reason": "[kspec-worktree-guard] BLOCKED: Dangerous git operation in .kspec worktree. This worktree contains active session data and must stay on kspec-meta. Operations like reset, rebase, stash, and clean can corrupt session files."
   333→}
   334→EOF
   335→    exit 0
   336→  fi
   337→done
   338→
   339→# Allow all other commands
   340→echo '{"decision": "allow"}'
   341→`,
   342→
   343→};
   344→
   345→/**
   346→ * Install hooks to project-level Claude Code settings (.claude/settings.json)
   347→ * AC: @enhanced-setup ac-2 - all hook entries present
   348→ */
   349→async function installClaudeCodeHooks(
   350→  projectDir: string,
   351→  dryRun = false,
   352→): Promise<HooksInstallResult> {
   353→  const configPath = path.join(projectDir, ".claude", "settings.json");
   354→  const configDir = path.dirname(configPath);
   355→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   356→
   357→  const result: HooksInstallResult = {
   358→    promptCheck: false,
   359→    stop: false,
   360→    preToolUse: false,
   361→    guardsCreated: [],
   362→  };
   363→
   364→  try {
   365→    // Ensure directories exist
   366→    if (!dryRun) {
   367→      await fs.mkdir(configDir, { recursive: true });
   368→      await fs.mkdir(hooksDir, { recursive: true });
   369→    }
   370→
   371→    // Read existing config or start fresh
   372→    let config: Record<string, unknown> = {};
   373→    try {
   374→      const existing = await fs.readFile(configPath, "utf-8");
   375→      config = JSON.parse(existing);
   376→    } catch (err) {
   377→      debugLog("No existing hooks config, starting fresh", err);
   378→    }
   379→
   380→    // Get or create hooks object
   381→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   382→
   383→    // Install UserPromptSubmit hook (spec-first reminder)
   384→    const promptCheckCommand = "kspec session prompt-check";
   385→    const existingPromptHooks = hooks.UserPromptSubmit as
   386→      | Array<{ hooks?: Array<{ command?: string }> }>
   387→      | undefined;
   388→    const promptAlreadyInstalled = existingPromptHooks?.some((entry) =>
   389→      entry.hooks?.some((hook) =>
   390→        hook.command?.includes("session prompt-check"),
   391→      ),
   392→    );
   393→
   394→    if (!promptAlreadyInstalled) {
   395→      hooks.UserPromptSubmit = [
   396→        ...(existingPromptHooks || []),
   397→        {
   398→          hooks: [
   399→            {
   400→              type: "command",
   401→              command: promptCheckCommand,
   402→            },
   403→          ],
   404→        },
   405→      ];
   406→      result.promptCheck = true;
   407→    } else {
   408→      result.promptCheck = true; // Already configured
   409→    }
   410→
   411→    // Install Stop hook (checkpoint)
   412→    const stopHookCommand = "kspec session checkpoint --json";
   413→    const existingStopHooks = hooks.Stop as
   414→      | Array<{ matcher?: string; hooks?: Array<{ command?: string }> }>
   415→      | undefined;
   416→    const stopAlreadyInstalled = existingStopHooks?.some((entry) =>
   417→      entry.hooks?.some((hook) => hook.command?.includes("session checkpoint")),
   418→    );
   419→
   420→    if (!stopAlreadyInstalled) {
   421→      hooks.Stop = [
   422→        ...(existingStopHooks || []),
   423→        {
   424→          matcher: "",
   425→          hooks: [
   426→            {
   427→              type: "command",
   428→              command: stopHookCommand,
   429→            },
   430→          ],
   431→        },
   432→      ];
   433→      result.stop = true;
   434→    } else {
   435→      result.stop = true; // Already configured
   436→    }
   437→
   438→    // AC: @enhanced-setup ac-2 - Install PreToolUse hooks with guards
   439→    const existingPreToolUseHooks = hooks.PreToolUse as
   440→      | Array<{ matcher?: string; hooks?: Array<{ command?: string }> }>
   441→      | undefined;
   442→
   443→    // Check if our guards are already installed
   444→    const guardHookCommands = Object.keys(GUARD_SCRIPTS).map(
   445→      (name) => `.claude/hooks/${name}`,
   446→    );
   447→    const guardsAlreadyInstalled = existingPreToolUseHooks?.some((entry) =>
   448→      entry.hooks?.some((hook) =>
   449→        guardHookCommands.some((cmd) => hook.command?.includes(cmd)),
   450→      ),
   451→    );
   452→
   453→    if (!guardsAlreadyInstalled) {
   454→      // Create guard script files, skipping when content unchanged
   455→      for (const [name, content] of Object.entries(GUARD_SCRIPTS)) {
   456→        const scriptPath = path.join(hooksDir, name);
   457→        // Check if existing script already has the same content
   458→        let existingContent: string | null = null;
   459→        try {
   460→          existingContent = await fs.readFile(scriptPath, "utf-8");
   461→        } catch (_err) {
   462→          // File doesn't exist yet
   463→        }
   464→        if (existingContent !== content) {
   465→          if (!dryRun) {
   466→            await fs.writeFile(scriptPath, content, { mode: 0o755 });
   467→          }
   468→          result.guardsCreated.push(name);
   469→        }
   470→      }
   471→
   472→      // Add PreToolUse hook entry
   473→      hooks.PreToolUse = [
   474→        ...(existingPreToolUseHooks || []),
   475→        {
   476→          matcher: "Bash",
   477→          hooks: Object.keys(GUARD_SCRIPTS).map((name) => ({
   478→            type: "command",
   479→            command: `.claude/hooks/${name}`,
   480→          })),
   481→        },
   482→      ];
   483→      result.preToolUse = true;
   484→    } else {
   485→      result.preToolUse = true; // Already configured
   486→    }
   487→
   488→    config.hooks = hooks;
   489→
   490→    // Write back
   491→    if (!dryRun) {
   492→      await fs.writeFile(
   493→        configPath,
   494→        `${JSON.stringify(config, null, 2)}\n`,
   495→        "utf-8",
   496→      );
   497→    }
   498→    return result;
   499→  } catch (err) {
   500→    debugLog("installClaudeCodeHooks failed", err);
   501→    return result;
   502→  }
   503→}
   504→
   505→/**
   506→ * Install KSPEC_AUTHOR config for Aider (.aider.conf.yml)
   507→ * Aider uses `set-env:` for environment variables in list format
   508→ */
   509→async function installAiderConfig(author: string): Promise<boolean> {
   510→  const configPath = path.join(os.homedir(), ".aider.conf.yml");
   511→
   512→  try {
   513→    let content = "";
   514→    try {
   515→      content = await fs.readFile(configPath, "utf-8");
   516→    } catch (err) {
   517→      debugLog("No existing Aider config, starting fresh", err);
   518→    }
   519→
   520→    // Check if KSPEC_AUTHOR is already set
   521→    if (content.includes("KSPEC_AUTHOR")) {
   522→      // Replace existing value (handles both old and new format)
   523→      content = content.replace(
   524→        /^(\s*-?\s*KSPEC_AUTHOR\s*[=:]\s*).*$/m,
   525→        `  - KSPEC_AUTHOR=${author}`,
   526→      );
   527→    } else {
   528→      // Add to set-env section or create it
   529→      if (content.includes("set-env:")) {
   530→        // Append to existing set-env section
   531→        content = content.replace(
   532→          /(set-env:\s*\n)/m,
   533→          `$1  - KSPEC_AUTHOR=${author}\n`,
   534→        );
   535→      } else {
   536→        // Add new set-env section
   537→        content += `\n# kspec author for note attribution\nset-env:\n  - KSPEC_AUTHOR=${author}\n`;
   538→      }
   539→    }
   540→
   541→    await fs.writeFile(configPath, content, "utf-8");
   542→    return true;
   543→  } catch (err) {
   544→    debugLog("installAiderConfig failed", err);
   545→    return false;
   546→  }
   547→}
   548→
   549→/**
   550→ * Install KSPEC_AUTHOR for generic JSON config files
   551→ */
   552→async function installGenericJsonConfig(
   553→  configPath: string,
   554→  author: string,
   555→): Promise<boolean> {
   556→  try {
   557→    const configDir = path.dirname(configPath);
   558→    await fs.mkdir(configDir, { recursive: true });
   559→
   560→    let config: Record<string, unknown> = {};
   561→    try {
   562→      const existing = await fs.readFile(configPath, "utf-8");
   563→      config = JSON.parse(existing);
   564→    } catch (err) {
   565→      debugLog(`No existing config at ${configPath}, starting fresh`, err);
   566→    }
   567→
   568→    const env = (config.env as Record<string, string>) || {};
   569→    env.KSPEC_AUTHOR = author;
   570→    config.env = env;
   571→
   572→    await fs.writeFile(
   573→      configPath,
   574→      `${JSON.stringify(config, null, 2)}\n`,
   575→      "utf-8",
   576→    );
   577→    return true;
   578→  } catch (err) {
   579→    debugLog(`installGenericJsonConfig failed for ${configPath}`, err);
   580→    return false;
   581→  }
   582→}
