   584→/**
   585→ * Get default author value for an agent type
   586→ */
   587→function getDefaultAuthor(agentType: AgentType): string {
   588→  switch (agentType) {
   589→    case "claude-code":
   590→      return "@claude";
   591→    case "cline":
   592→      return "@cline";
   593→    case "roo-code":
   594→      return "@roo";
   595→    case "copilot-cli":
   596→      return "@copilot";
   597→    case "gemini-cli":
   598→      return "@gemini";
   599→    case "codex-cli":
   600→      return "@codex";
   601→    case "aider":
   602→      return "@aider";
   603→    case "opencode":
   604→      return "@opencode";
   605→    case "amp":
   606→      return "@amp";
   607→    default:
   608→      return "@agent";
   609→  }
   610→}
   611→
   612→/**
   613→ * Prompt user for input with Y/N answer
   614→ */
   615→async function promptYesNo(question: string): Promise<boolean> {
   616→  const rl = readline.createInterface({
   617→    input: process.stdin,
   618→    output: process.stdout,
   619→  });
   620→
   621→  try {
   622→    const answer = await rl.question(`${question} `);
   623→    return answer.toLowerCase() === "y";
   624→  } finally {
   625→    rl.close();
   626→  }
   627→}
   628→
   629→/**
   630→ * Ensure .kspec worktree exists if kspec-meta branch is present.
   631→ * AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
   632→ *
   633→ * @param autoWorktree If true, automatically create worktree without prompting
   634→ * @returns true if worktree is ready to use
   635→ */
   636→async function ensureWorktree(autoWorktree: boolean): Promise<boolean> {
   637→  const projectRoot = getGitRoot(process.cwd());
   638→  if (!projectRoot) {
   639→    // Not in a git repo, skip worktree check
   640→    return true;
   641→  }
   642→
   643→  const status = await getShadowStatus(projectRoot);
   644→
   645→  // AC: worktree-already-exists - if already valid, skip
   646→  if (status.healthy) {
   647→    return true;
   648→  }
   649→
   650→  // AC: detect-existing-repo - branch exists but worktree doesn't
   651→  if (status.branchExists && !status.worktreeExists) {
   652→    // AC: auto-worktree-flag - auto-create if flag set
   653→    if (autoWorktree) {
   654→      console.log(
   655→        `Detected ${SHADOW_BRANCH_NAME} branch without .kspec worktree. Creating...`,
   656→      );
   657→      const result = await repairShadow(projectRoot);
   658→      if (result.success) {
   659→        success("Created .kspec worktree");
   660→        return true;
   661→      } else {
   662→        error(`Failed to create worktree: ${result.error}`);
   663→        return false;
   664→      }
   665→    }
   666→
   667→    // AC: detect-existing-repo - prompt user
   668→    const shouldCreate = await promptYesNo(
   669→      `${SHADOW_BRANCH_NAME} branch exists but .kspec worktree is missing. Create it? (y/N)`,
   670→    );
   671→
   672→    if (shouldCreate) {
   673→      console.log("Creating .kspec worktree...");
   674→      const result = await repairShadow(projectRoot);
   675→      if (result.success) {
   676→        success("Created .kspec worktree");
   677→        return true;
   678→      } else {
   679→        error(`Failed to create worktree: ${result.error}`);
   680→        return false;
   681→      }
   682→    } else {
   683→      warn("Skipping worktree creation");
   684→      return false;
   685→    }
   686→  }
   687→
   688→  // No kspec-meta branch, or already healthy
   689→  return true;
   690→}
   691→
   692→/**
   693→ * Print manual setup instructions
   694→ */
   695→function printManualInstructions(agentType: AgentType): void {
   696→  const author = getDefaultAuthor(agentType);
   697→
   698→  console.log("\nManual setup instructions:\n");
   699→
   700→  switch (agentType) {
   701→    case "claude-code":
   702→      console.log("Add to ~/.claude/settings.json:");
   703→      console.log("```json");
   704→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   705→      console.log("```");
   706→      break;
   707→
   708→    case "cline":
   709→    case "roo-code":
   710→      console.log("Add to your shell profile (~/.bashrc, ~/.zshrc):");
   711→      console.log("```bash");
   712→      console.log(`export KSPEC_AUTHOR="${author}"`);
   713→      console.log("```");
   714→      console.log(
   715→        "\nThis will be inherited by terminals spawned by the VS Code extension.",
   716→      );
   717→      break;
   718→
   719→    case "copilot-cli":
   720→      console.log("Add to ~/.copilot/config.json:");
   721→      console.log("```json");
   722→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   723→      console.log("```");
   724→      break;
   725→
   726→    case "aider":
   727→      console.log("Add to ~/.aider.conf.yml:");
   728→      console.log("```yaml");
   729→      console.log("set-env:");
   730→      console.log(`  - KSPEC_AUTHOR=${author}`);
   731→      console.log("```");
   732→      break;
   733→
   734→    case "codex-cli":
   735→      console.log("Add to ~/.codex/config.toml:");
   736→      console.log("```toml");
   737→      console.log("[shell_environment_policy]");
   738→      console.log(`set = { KSPEC_AUTHOR = "${author}" }`);
   739→      console.log("```");
   740→      break;
   741→
   742→    case "opencode":
   743→      console.log("Add to ~/.config/opencode/opencode.json:");
   744→      console.log("```json");
   745→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   746→      console.log("```");
   747→      break;
   748→
   749→    case "amp":
   750→      console.log("Add to ~/.config/amp/settings.json:");
   751→      console.log("```json");
   752→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   753→      console.log("```");
   754→      break;
   755→
   756→    default:
   757→      console.log("Set the KSPEC_AUTHOR environment variable:");
   758→      console.log("```bash");
   759→      console.log(`export KSPEC_AUTHOR="${author}"`);
   760→      console.log("```");
   761→      console.log("\nOr add to your shell profile (~/.bashrc, ~/.zshrc, etc.)");
   762→  }
   763→}
   764→
   765→/**
   766→ * Result of a setup step
   767→ */
   768→interface SetupStepResult {
   769→  name: string;
   770→  status: "done" | "skipped" | "failed";
   771→  message?: string;
   772→  details?: Record<string, unknown>;
   773→}
   774→
   775→/**
   776→ * Result of running the setup pipeline
   777→ * Used by both the setup command and init --setup
   778→ * AC: @init-setup-integration ac-2, ac-3
   779→ */
   780→export interface SetupPipelineResult {
   781→  success: boolean;
   782→  steps: SetupStepResult[];
   783→  coreSkillsInstalled: number;
   784→  skillsRendered: number;
   785→  hooksInstalled: boolean;
   786→  agentsMdGenerated: boolean;
   787→  permissionsSeeded: boolean;
   788→  memorySeeded: boolean;
   789→}
   790→
   791→/**
   792→ * Options for running the setup pipeline
   793→ */
   794→export interface SetupPipelineOptions {
   795→  dryRun?: boolean;
   796→  skipSkills?: boolean;
   797→  installHooks?: boolean;
   798→  force?: boolean;
   799→  /** Custom author string (overrides auto-detected default) */
   800→  author?: string;
   801→  /** Whether to configure author (only in command handler, not init) */
   802→  configureAuthor?: boolean;
   803→}
   804→
   805→/**
   806→ * Status of the setup state
   807→ * AC: @enhanced-setup ac-7, ac-8 - status reporting
   808→ */
   809→interface SetupStatus {
   810→  agent: {
   811→    detected: AgentType;
   812→    confidence: "high" | "medium" | "low";
   813→  };
   814→  hooks: {
   815→    promptCheck: boolean;
   816→    stop: boolean;
   817→    preToolUse: boolean;
   818→    guardsPresent: string[];
   819→  };
   820→  skills: {
   821→    total: number;
   822→    rendered: number;
   823→    drifted: number;
   824→  };
   825→  plugin: {
   826→    marketplaceRegistered: boolean;
   827→    marketplaceHealthy: boolean;
   828→    pluginEnabled: boolean;
   829→    registeredPath?: string;
   830→    healthMessage?: string;
   831→  };
   832→  agentsMd: {
   833→    exists: boolean;
   834→    // AC: @doctor-command ac-staleness-unknown — includes "unknown" for indeterminate cases
   835→    status: "current" | "stale" | "missing" | "unknown";
   836→    generatedAt?: string;
   837→  };
   838→  seeding: {
   839→    permissionsSeeded: boolean;
   840→    memorySeeded: boolean;
   841→    memoryPath?: string;
   842→  };
   843→}
   844→
   845→/**
   846→ * Check the current setup status
   847→ * AC: @enhanced-setup ac-7, ac-8
   848→ */
   849→async function getSetupStatus(projectDir: string): Promise<SetupStatus> {
   850→  const detected = detectAgent();
   851→  const configPath = path.join(projectDir, ".claude", "settings.json");
   852→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   853→  const agentsMdPath = path.join(projectDir, "kspec-agents.md");
   854→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
   855→  const skillsDir = path.join(projectDir, ".claude", "skills");
   856→
   857→  // Check hooks
   858→  const hooks = {
   859→    promptCheck: false,
   860→    stop: false,
   861→    preToolUse: false,
   862→    guardsPresent: [] as string[],
   863→  };
   864→
   865→  try {
   866→    const configContent = await fs.readFile(configPath, "utf-8");
   867→    const config = JSON.parse(configContent);
   868→    const hooksConfig = config.hooks || {};
   869→
   870→    // Check UserPromptSubmit
   871→    const promptHooks = hooksConfig.UserPromptSubmit as Array<{
   872→      hooks?: Array<{ command?: string }>;
   873→    }> | undefined;
   874→    hooks.promptCheck = promptHooks?.some((entry) =>
   875→      entry.hooks?.some((h) => h.command?.includes("prompt-check")),
   876→    ) ?? false;
   877→
   878→    // Check Stop
   879→    const stopHooks = hooksConfig.Stop as Array<{
   880→      hooks?: Array<{ command?: string }>;
   881→    }> | undefined;
   882→    hooks.stop = stopHooks?.some((entry) =>
   883→      entry.hooks?.some((h) => h.command?.includes("checkpoint")),
   884→    ) ?? false;
   885→
   886→    // Check PreToolUse
   887→    const preToolUseHooks = hooksConfig.PreToolUse as Array<{
   888→      hooks?: Array<{ command?: string }>;
   889→    }> | undefined;
   890→    hooks.preToolUse = preToolUseHooks?.some((entry) =>
   891→      entry.hooks?.some((h) => h.command?.includes(".claude/hooks/")),
   892→    ) ?? false;
   893→  } catch (err) {
   894→    debugLog("Failed to read hooks config for status", err);
   895→  }
   896→
   897→  // Check guard scripts
   898→  try {
   899→    const guardFiles = await fs.readdir(hooksDir);
   900→    for (const name of Object.keys(GUARD_SCRIPTS)) {
   901→      if (guardFiles.includes(name)) {
   902→        hooks.guardsPresent.push(name);
   903→      }
   904→    }
   905→  } catch (err) {
   906→    debugLog("Hooks dir doesn't exist", err);
   907→  }
   908→
   909→  // Check skills
   910→  const skills = {
   911→    total: 0,
   912→    rendered: 0,
   913→    drifted: 0,
   914→  };
   915→
   916→  // Helper to scan a directory for skill subdirs with kspec-managed SKILL.md
   917→  async function scanForSkills(baseDir: string): Promise<void> {
   918→    try {
   919→      const dirs = await fs.readdir(baseDir, { withFileTypes: true });
   920→      for (const dir of dirs) {
   921→        if (dir.isDirectory()) {
   922→          const skillMdPath = path.join(baseDir, dir.name, "SKILL.md");
   923→          try {
   924→            const content = await fs.readFile(skillMdPath, "utf-8");
   925→            if (content.includes("<!-- kspec-managed -->")) {
   926→              skills.total++;
   927→              skills.rendered++;
   928→            }
   929→          } catch (_noSkillMd) {
   930→            // No SKILL.md
   931→          }
   932→        }
   933→      }
   934→    } catch (_notReadable) {
   935→      // Directory doesn't exist
   936→    }
   937→  }
   938→
   939→  // Scan .claude/skills/ (project/local skills)
   940→  await scanForSkills(skillsDir);
   941→
   942→  // Check plugin marketplace health
   943→  // AC: @enhanced-setup ac-7, ac-8
   944→  const plugin: SetupStatus["plugin"] = {
   945→    marketplaceRegistered: false,
   946→    marketplaceHealthy: false,
   947→    pluginEnabled: false,
   948→  };
   949→
   950→  try {
   951→    const { checkMarketplaceHealth } = await import(
   952→      "../../lib/claude-plugin-registry.js"
   953→    );
   954→    const health = await checkMarketplaceHealth();
   955→    plugin.marketplaceRegistered = health.status !== "missing";
   956→    plugin.marketplaceHealthy = health.status === "healthy";
   957→    plugin.registeredPath = health.registeredPath;
   958→    plugin.healthMessage = health.message;
   959→  } catch (err) {
   960→    debugLog("Could not check marketplace health", err);
   961→    plugin.healthMessage = "Health check unavailable";
   962→  }
   963→
   964→  // Check if plugin is enabled in project settings
   965→  try {
   966→    const configContent = await fs.readFile(configPath, "utf-8");
   967→    const config = JSON.parse(configContent);
   968→    plugin.pluginEnabled = config.enabledPlugins?.["kspec@kspec-plugins"] === true;
   969→  } catch (err) {
   970→    debugLog("Could not check plugin enablement", err);
   971→  }
   972→
   973→  // Check agents.md
   974→  const agentsMd: SetupStatus["agentsMd"] = {
   975→    exists: false,
   976→    status: "missing",
   977→  };
   978→
   979→  try {
   980→    await fs.access(agentsMdPath);
   981→    agentsMd.exists = true;
   982→
   983→    try {
   984→      const hashContent = await fs.readFile(hashPath, "utf-8");
   985→      const hashData = JSON.parse(hashContent);
   986→      agentsMd.generatedAt = hashData.generatedAt;
   987→
   988→      // AC: @cross-platform-and-version-robustness ac-4
   989→      // Compare stored hash against current meta to detect staleness
   990→      try {
   991→        const { initContext, loadMetaContext } = await import(
   992→          "../../parser/index.js"
   993→        );
   994→        const { computeMetaHash, loadTemplateSections, getPackageRoot } = await import("./agents.js");
   995→        const ctx = await initContext();
   996→        if (ctx.manifestPath) {
   997→          const metaCtx = await loadMetaContext(ctx);
   998→          let templateSections: string[] = [];
   999→          try {
  1000→            templateSections = await loadTemplateSections(getPackageRoot());
  1001→          } catch (err) {
  1002→            debugLog("Templates not available for staleness check", err);
  1003→          }
  1004→          const currentHash = computeMetaHash(
  1005→            metaCtx.skills,
  1006→            metaCtx.conventions,
  1007→            metaCtx.workflows,
  1008→            templateSections,
  1009→          );
  1010→          agentsMd.status = hashData.metaHash === currentHash ? "current" : "stale";
  1011→        } else {
  1012→          // AC: @doctor-command ac-staleness-unknown — no manifest means we can't determine staleness
  1013→          agentsMd.status = "unknown";
  1014→        }
  1015→      } catch (err) {
  1016→        // AC: @doctor-command ac-staleness-unknown — hash computation failed
  1017→        debugLog("Could not compute meta hash for staleness check", err);
  1018→        agentsMd.status = "unknown";
  1019→      }
  1020→    } catch (err) {
  1021→      debugLog("Hash file missing or invalid, marking stale", err);
  1022→      agentsMd.status = "stale";
  1023→    }
  1024→  } catch (err) {
  1025→    debugLog("kspec-agents.md doesn't exist", err);
  1026→  }
  1027→
  1028→  // Check seeding state
  1029→  const seeding: SetupStatus["seeding"] = {
  1030→    permissionsSeeded: false,
  1031→    memorySeeded: false,
  1032→  };
  1033→
  1034→  try {
  1035→    const configContent = await fs.readFile(
  1036→      path.join(projectDir, ".claude", "settings.json"),
  1037→      "utf-8",
  1038→    );
  1039→    const config = JSON.parse(configContent);
  1040→    seeding.permissionsSeeded = !!config.permissions;
  1041→  } catch (err) {
  1042→    debugLog("Could not check permissions seeding state", err);
  1043→  }
  1044→
  1045→  if (detected.type === "claude-code") {
  1046→    try {
  1047→      const { claudeCodeMemoryWriter } = await import("./setup-seeding.js");
  1048→      const memoryExists = await claudeCodeMemoryWriter.exists(projectDir);
  1049→      seeding.memorySeeded = memoryExists;
  1050→      if (memoryExists) {
  1051→        seeding.memoryPath = claudeCodeMemoryWriter.getMemoryPath(projectDir);
  1052→      }
  1053→    } catch (err) {
  1054→      debugLog("Could not check memory seeding state", err);
  1055→    }
  1056→  }
  1057→
  1058→  return {
  1059→    agent: {
  1060→      detected: detected.type,
  1061→      confidence: detected.confidence,
  1062→    },
  1063→    hooks,
  1064→    skills,
  1065→    plugin,
  1066→    agentsMd,
  1067→    seeding,
  1068→  };
  1069→}
  1070→
  1071→/**
  1072→ * Render skills using the platform renderer registry
  1073→ * AC: @setup-pipeline-unification ac-2 - uses getRenderer/getAllRenderers, not legacy renderClaudeCodeSkill
  1074→ * AC: @setup-pipeline-unification ac-4 - errors logged at debug level
  1075→ */
  1076→async function renderSkillsForSetup(
  1077→  projectDir: string,
  1078→  dryRun: boolean,
  1079→): Promise<{ rendered: number; skipped: number; pluginProvided: number; skillIds: string[] }> {
  1080→  // Dynamically import to avoid circular dependencies
  1081→  const { initContext, loadMetaContext } = await import(
  1082→    "../../parser/index.js"
  1083→  );
  1084→  const { getRenderer } = await import("../../parser/skill-render.js");
  1085→
  1086→  try {
  1087→    const ctx = await initContext();
  1088→
  1089→    if (!ctx.manifestPath) {
  1090→      return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1091→    }
  1092→
  1093→    const metaCtx = await loadMetaContext(ctx);
  1094→
  1095→    // Collect all skills that have a registered renderer for their platform
  1096→    const skillsToRender: Array<{ skill: typeof metaCtx.skills[0]; platform: string }> = [];
  1097→    for (const skill of metaCtx.skills) {
  1098→      for (const platform of skill.platforms) {
  1099→        const renderer = getRenderer(platform);
  1100→        if (renderer) {
  1101→          skillsToRender.push({ skill, platform });
  1102→        }
  1103→      }
  1104→    }
  1105→
  1106→    if (skillsToRender.length === 0) {
  1107→      return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1108→    }
  1109→
  1110→    let rendered = 0;
  1111→    let skipped = 0;
  1112→    let pluginProvided = 0;
  1113→    const skillIds: string[] = [];
  1114→
  1115→    for (const { skill, platform } of skillsToRender) {
  1116→      const renderer = getRenderer(platform)!;
  1117→      try {
  1118→        const result = await renderer.render(ctx, projectDir, skill, {
  1119→          dryRun,
  1120→        });
  1121→        if (result.action === "created" || result.action === "updated") {
  1122→          rendered++;
  1123→          if (!skillIds.includes(skill.id)) {
  1124→            skillIds.push(skill.id);
  1125→          }
  1126→        } else if (result.action === "skipped" && result.skipCode === "plugin-provided") {
  1127→          pluginProvided++;
  1128→        } else {
  1129→          skipped++;
  1130→        }
  1131→      } catch (err) {
  1132→        debugLog(`Failed to render skill ${skill.id} for ${platform}`, err);
  1133→        skipped++;
  1134→      }
  1135→    }
  1136→
  1137→    return { rendered, skipped, pluginProvided, skillIds };
  1138→  } catch (err) {
  1139→    debugLog("renderSkillsForSetup failed", err);
  1140→    return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1141→  }
  1142→}
  1143→
  1144→/**
  1145→ * Generate kspec-agents.md using the canonical implementation from agents.ts
  1146→ * AC: @setup-pipeline-unification ac-1 - calls generateAgentsContent() from agents.ts
  1147→ * AC: @setup-pipeline-unification ac-4 - errors logged at debug level
  1148→ */
  1149→async function generateAgentInstructions(
  1150→  projectDir: string,
  1151→  dryRun: boolean,
  1152→): Promise<{ success: boolean; path: string; skipped?: boolean }> {
  1153→  const outputPath = path.join(projectDir, "kspec-agents.md");
  1154→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
  1155→
  1156→  // Dynamically import to avoid circular dependencies
  1157→  const { initContext, loadMetaContext } = await import(
  1158→    "../../parser/index.js"
  1159→  );
  1160→  const {
  1161→    generateAgentsContent,
  1162→    loadTemplateSections,
  1163→    getPackageRoot,
  1164→    computeMetaHash,
  1165→  } = await import("./agents.js");
  1166→
  1167→  try {
  1168→    const ctx = await initContext();
  1169→
  1170→    if (!ctx.manifestPath) {
  1171→      return { success: false, path: outputPath };
  1172→    }
  1173→
  1174→    const metaCtx = await loadMetaContext(ctx);
  1175→    const timestamp = new Date().toISOString();
  1176→
  1177→    // Load templates using the canonical implementation
  1178→    let templateSections: string[] = [];
  1179→    try {
  1180→      templateSections = await loadTemplateSections(getPackageRoot());
  1181→    } catch (err) {
  1182→      debugLog("Failed to load template sections", err);
  1183→    }
  1184→
  1185→    // Generate content using the canonical implementation from agents.ts
  1186→    const content = await generateAgentsContent(
  1187→      metaCtx.skills,
  1188→      metaCtx.conventions,
  1189→      metaCtx.workflows,
  1190→      timestamp,
  1191→      templateSections,
  1192→    );
  1193→
  1194→    if (!dryRun) {
  1195→      // Compute meta hash for freshness tracking
  1196→      const metaHash = computeMetaHash(
  1197→        metaCtx.skills,
  1198→        metaCtx.conventions,
  1199→        metaCtx.workflows,
  1200→        templateSections,
  1201→      );
  1202→
  1203→      // Skip regeneration when content unchanged (same pattern as kspec agents generate)
  1204→      let storedHash: string | undefined;
  1205→      try {
  1206→        const hashContent = await fs.readFile(hashPath, "utf-8");
  1207→        const hashData = JSON.parse(hashContent);
  1208→        storedHash = hashData.metaHash;
  1209→      } catch (_err) {
  1210→        // No hash file or invalid — regenerate
  1211→      }
  1212→
  1213→      // Only skip if hash matches AND the output file actually exists
  1214→      let outputExists = false;
  1215→      try {
  1216→        await fs.access(outputPath);
  1217→        outputExists = true;
  1218→      } catch (_e) {
  1219→        // File missing — must regenerate even if hash matches
  1220→      }
  1221→
  1222→      if (storedHash === metaHash && outputExists) {
  1223→        return { success: true, path: outputPath, skipped: true };
  1224→      }
  1225→
  1226→      await fs.writeFile(outputPath, content, "utf-8");
  1227→
  1228→      await fs.mkdir(path.dirname(hashPath), { recursive: true });
  1229→      // Dynamically import version to avoid top-level require
  1230→      const { createRequire } = await import("node:module");
  1231→      const req = createRequire(import.meta.url);
  1232→      const { version } = req("../../../package.json");
  1233→
  1234→      await fs.writeFile(
  1235→        hashPath,
  1236→        JSON.stringify(
  1237→          {
  1238→            metaHash,
  1239→            generatedAt: timestamp,
  1240→            version,
  1241→          },
  1242→          null,
  1243→          2,
  1244→        ),
  1245→        "utf-8",
  1246→      );
  1247→    }
  1248→
  1249→    return { success: true, path: outputPath };
  1250→  } catch (err) {
  1251→    debugLog("generateAgentInstructions failed", err);
  1252→    return { success: false, path: outputPath };
  1253→  }
  1254→}
  1255→
  1256→/**
  1257→ * Install core skills for the setup pipeline
  1258→ * AC: @init-setup-integration ac-2 - core skills installed
  1259→ */
  1260→async function installCoreSkillsForSetup(
  1261→  projectDir: string,
  1262→  dryRun: boolean
  1263→): Promise<{
  1264→  installed: number;
  1265→  skipped: number;
  1266→  marketplaceRegistered?: boolean;
  1267→  pluginEnabled?: boolean;
  1268→  marketplaceMessage?: string;
  1269→  enableMessage?: string;
  1270→}> {
  1271→  // Dynamically import to avoid circular dependencies
  1272→  const {
  1273→    initContext,
  1274→    loadMetaContext,
  1275→    saveMetaItem,
  1276→    getSkillContentPath,
  1277→  } = await import("../../parser/index.js");
  1278→  const { commitIfShadow } = await import("../../parser/shadow.js");
  1279→  const { SkillSchema } = await import("../../schema/index.js");
  1280→  const {
  1281→    loadCoreSkillsManifest,
  1282→    copyCoreSkillFiles,
  1283→    getKspecPackageVersion,
  1284→  } = await import("./skill.js");
  1285→  const { ulid } = await import("ulid");
  1286→
  1287→  let installed = 0;
  1288→  let skipped = 0;
  1289→
  1290→  try {
  1291→    const ctx = await initContext();
  1292→
  1293→    if (!ctx.manifestPath) {
  1294→      return { installed: 0, skipped: 0 };
  1295→    }
  1296→
  1297→    const metaCtx = await loadMetaContext(ctx);
  1298→    const coreSkills = await loadCoreSkillsManifest();
  1299→    // AC: @cross-platform-and-version-robustness ac-3
  1300→    const kspecVersion = await getKspecPackageVersion();
  1301→    if (!kspecVersion) {
  1302→      debugLog("Could not determine kspec version — skills installed without version tracking");
  1303→    }
  1304→
  1305→    for (const coreSkill of coreSkills) {
  1306→      // Check if skill exists
  1307→      const existingSkill = metaCtx.skills.find((s) => s.id === coreSkill.id);
  1308→
  1309→      if (existingSkill && existingSkill.origin !== "core") {
  1310→        // Custom/project skill exists, skip
  1311→        skipped++;
  1312→        continue;
  1313→      }
  1314→
  1315→      // Build skill data
  1316→      const skillData = {
  1317→        _ulid: existingSkill?._ulid || ulid(),
  1318→        id: coreSkill.id,
  1319→        name: coreSkill.name,
  1320→        description: coreSkill.description,
  1321→        origin: "core" as const,
  1322→        ...(kspecVersion && { version: kspecVersion }),
  1323→        platforms: coreSkill.platforms || ["claude-code"],
  1324→        depends_on: [],
  1325→        tags: ["core"],
  1326→      };
  1327→
  1328→      const parsed = SkillSchema.safeParse(skillData);
  1329→      if (!parsed.success) {
  1330→        skipped++;
  1331→        continue;
  1332→      }
  1333→
  1334→      if (!dryRun) {
  1335→        await saveMetaItem(ctx, parsed.data, "skill");
  1336→
  1337→        // Copy skill files (SKILL.md + supporting dirs)
  1338→        const targetDir = path.dirname(getSkillContentPath(ctx, parsed.data.id));
  1339→        await copyCoreSkillFiles(coreSkill.id, targetDir);
  1340→      }
  1341→
  1342→      installed++;
  1343→    }
  1344→
  1345→    // Commit changes
  1346→    if (!dryRun && installed > 0) {
  1347→      const ctx2 = await initContext();
  1348→      await commitIfShadow(
  1349→        ctx2.shadow,
  1350→        "skill-install-core",
  1351→        `${installed} core skills`
  1352→      );
  1353→    }
  1354→
  1355→    // AC: @core-skill-install ac-6, ac-7 - Register marketplace and enable plugin
  1356→    let marketplaceResult;
  1357→    let enableResult;
  1358→    if (!dryRun) {
  1359→      const {
  1360→        registerCorePluginMarketplace,
  1361→        enablePluginInProject,
  1362→      } = await import("../../lib/claude-plugin-registry.js");
  1363→      marketplaceResult = await registerCorePluginMarketplace();
  1364→      enableResult = await enablePluginInProject(projectDir);
  1365→    }
  1366→
  1367→    return {
  1368→      installed,
  1369→      skipped,
  1370→      marketplaceRegistered: marketplaceResult?.success ?? false,
  1371→      pluginEnabled: enableResult?.success ?? false,
  1372→      marketplaceMessage: marketplaceResult?.message,
  1373→      enableMessage: enableResult?.message,
  1374→    };
  1375→  } catch (err) {
  1376→    debugLog("installCoreSkillsForSetup failed", err);
  1377→    return { installed: 0, skipped: 0 };
  1378→  }
  1379→}
  1380→
  1381→/**
  1382→ * Run the full setup pipeline programmatically.
  1383→ * Used by both 'kspec setup' command and 'kspec init --setup'.
  1384→ * AC: @init-setup-integration ac-2, ac-3
  1385→ */
  1386→export async function runSetupPipeline(
  1387→  projectDir: string,
  1388→  options: SetupPipelineOptions
  1389→): Promise<SetupPipelineResult> {
  1390→  const dryRun = options.dryRun ?? false;
  1391→  const skipSkills = options.skipSkills ?? false;
  1392→  const installHooksFlag = options.installHooks ?? true;
  1393→
  1394→  const steps: SetupStepResult[] = [];
  1395→  let coreSkillsInstalled = 0;
  1396→  let skillsRendered = 0;
  1397→  let hooksInstalled = false;
  1398→  let agentsMdGenerated = false;
  1399→  let permissionsSeeded = false;
  1400→  let memorySeeded = false;
  1401→
  1402→  try {
  1403→    const detected = detectAgent();
  1404→
  1405→    // Step 1: Agent detection
  1406→    steps.push({
  1407→      name: "Agent detection",
  1408→      status: "done",
  1409→      message: `${detected.type} (${detected.confidence} confidence)`,
  1410→    });
  1411→
  1412→    // Step 2: Install core skills
  1413→    // AC: @init-setup-integration ac-2 - core skills installed in .kspec/skills/
  1414→    const coreResult = await installCoreSkillsForSetup(projectDir, dryRun);
  1415→    coreSkillsInstalled = coreResult.installed;
  1416→
  1417→    if (coreResult.installed > 0 || coreResult.skipped > 0) {
  1418→      steps.push({
  1419→        name: "Install core skills",
  1420→        status: "done",
  1421→        message: `${coreResult.installed} installed, ${coreResult.skipped} skipped`,
  1422→      });
  1423→    } else {
  1424→      steps.push({
  1425→        name: "Install core skills",
  1426→        status: "skipped",
  1427→        message: "No core skills found in package",
  1428→      });
  1429→    }
  1430→
  1431→    // Step 2b: Register plugin marketplace (reports result from installCoreSkillsForSetup)
  1432→    // AC: @core-skill-install ac-6, ac-7
  1433→    if (!dryRun && (coreResult.installed > 0 || coreResult.skipped > 0)) {
  1434→      const bothOk = coreResult.marketplaceRegistered && coreResult.pluginEnabled;
  1435→      if (bothOk) {
  1436→        steps.push({
  1437→          name: "Register plugin marketplace",
  1438→          status: "done",
  1439→          message: "marketplace registered, plugin enabled",
  1440→        });
  1441→      } else {
  1442→        const failures: string[] = [];
  1443→        if (!coreResult.marketplaceRegistered) {
  1444→          failures.push(coreResult.marketplaceMessage || "marketplace registration failed");
  1445→        }
  1446→        if (!coreResult.pluginEnabled) {
  1447→          failures.push(coreResult.enableMessage || "plugin enablement failed");
  1448→        }
  1449→        steps.push({
  1450→          name: "Register plugin marketplace",
  1451→          status: "failed",
  1452→          message: failures.join("; "),
  1453→        });
  1454→      }
  1455→    }
  1456→
  1457→    // Step 3: Install hooks (Claude Code only)
  1458→    // AC: @init-setup-integration ac-3 - hooks present
  1459→    if (detected.type === "claude-code" && installHooksFlag) {
  1460→      const hooksResult = await installClaudeCodeHooks(projectDir, dryRun);
  1461→      const installedHooks: string[] = [];
  1462→      if (hooksResult.promptCheck) installedHooks.push("UserPromptSubmit");
  1463→      if (hooksResult.stop) installedHooks.push("Stop");
  1464→      if (hooksResult.preToolUse) installedHooks.push("PreToolUse");
  1465→
  1466→      hooksInstalled =
  1467→        hooksResult.promptCheck || hooksResult.stop || hooksResult.preToolUse;
  1468→
  1469→      steps.push({
  1470→        name: "Install hooks",
  1471→        status: "done",
  1472→        message: installedHooks.join(", "),
  1473→        details: {
  1474→          guards: hooksResult.guardsCreated,
  1475→        },
  1476→      });
  1477→    } else if (!installHooksFlag) {
  1478→      steps.push({
  1479→        name: "Install hooks",
  1480→        status: "skipped",
  1481→        message: "--no-hooks flag",
  1482→      });
  1483→    } else {
  1484→      steps.push({
  1485→        name: "Install hooks",
  1486→        status: "skipped",
  1487→        message: `not applicable for ${detected.type}`,
  1488→      });
  1489→    }
  1490→
  1491→    // Step 3a: Ensure artifacts directory exists
  1492→    // AC: @artifacts-directory ac-setup-ensures
  1493→    {
  1494→      const artifactsDir = path.join(projectDir, ".kspec", "artifacts");
  1495→      let artifactsCreated = false;
  1496→      try {
  1497→        await fs.access(artifactsDir);
  1498→      } catch (_e) {
  1499→        if (!dryRun) {
  1500→          await fs.mkdir(artifactsDir, { recursive: true });
  1501→        }
  1502→        artifactsCreated = true;
  1503→      }
  1504→      steps.push({
  1505→        name: "Ensure artifacts directory",
  1506→        status: artifactsCreated ? "done" : "skipped",
  1507→        message: artifactsCreated ? "created .kspec/artifacts/" : "already exists",
  1508→      });
  1509→    }
  1510→
  1511→    // Step 3b: Seed permissions (Claude Code only)
  1512→    // AC: @new-project-bootstrapping ac-1
  1513→    {
  1514→      const { seedPermissions } = await import("./setup-seeding.js");
  1515→      const permResult = await seedPermissions(projectDir, detected.type, {
  1516→        dryRun,
  1517→        force: options.force,
  1518→      });
  1519→      permissionsSeeded = permResult.seeded;
  1520→
  1521→      steps.push({
  1522→        name: "Seed permissions",
  1523→        status: permResult.seeded ? "done" : "skipped",
  1524→        message: permResult.message,
  1525→      });
  1526→    }
  1527→
  1528→    // Step 3c: Seed memory (platform-extensible)
  1529→    // AC: @new-project-bootstrapping ac-2
  1530→    {
  1531→      const { seedMemory } = await import("./setup-seeding.js");
  1532→      const memResult = await seedMemory(projectDir, detected.type, {
  1533→        dryRun,
  1534→        force: options.force,
  1535→      });
  1536→      memorySeeded = memResult.seeded;
  1537→
  1538→      steps.push({
  1539→        name: "Seed memory",
  1540→        status: memResult.seeded ? "done" : "skipped",
  1541→        message: memResult.seeded ? memResult.path : memResult.message,
  1542→      });
  1543→    }
  1544→
  1545→    // Step 4: Render skills
  1546→    // AC: @init-setup-integration ac-3 - rendered skill files present
  1547→    if (!skipSkills) {
  1548→      const skillsResult = await renderSkillsForSetup(projectDir, dryRun);
  1549→      skillsRendered = skillsResult.rendered;
  1550→
  1551→      if (skillsResult.rendered > 0 || skillsResult.skipped > 0 || skillsResult.pluginProvided > 0) {
  1552→        const parts = [];
  1553→        if (skillsResult.rendered > 0) parts.push(`${skillsResult.rendered} rendered`);
  1554→        if (skillsResult.pluginProvided > 0) parts.push(`${skillsResult.pluginProvided} plugin-provided`);
  1555→        if (skillsResult.skipped > 0) parts.push(`${skillsResult.skipped} unchanged`);
  1556→        steps.push({
  1557→          name: "Render skills",
  1558→          status: "done",
  1559→          message: parts.join(", "),
  1560→          details: {
  1561→            skillIds: skillsResult.skillIds,
  1562→          },
  1563→        });
  1564→      } else {
  1565→        steps.push({
  1566→          name: "Render skills",
  1567→          status: "skipped",
  1568→          message: "No claude-code skills in meta",
  1569→        });
  1570→      }
  1571→    } else {
  1572→      steps.push({
  1573→        name: "Render skills",
  1574→        status: "skipped",
  1575→        message: "--skip-skills flag",
  1576→      });
  1577→    }
  1578→
  1579→    // Step 5: Generate kspec-agents.md
  1580→    // AC: @init-setup-integration ac-3 - kspec-agents.md present
  1581→    const agentsResult = await generateAgentInstructions(projectDir, dryRun);
  1582→    agentsMdGenerated = agentsResult.success;
  1583→
  1584→    if (agentsResult.success) {
  1585→      steps.push({
  1586→        name: "Generate kspec-agents.md",
  1587→        status: "done",
  1588→        message: agentsResult.skipped
  1589→          ? "already up to date"
  1590→          : agentsResult.path,
  1591→      });
  1592→    } else {
  1593→      steps.push({
  1594→        name: "Generate kspec-agents.md",
  1595→        status: "failed",
  1596→        message: "No kspec project found",
  1597→      });
  1598→    }
  1599→
  1600→    // Step 6: Configure author (optional, used by setup command)
  1601→    if (options.configureAuthor) {
  1602→      const author = options.author || getDefaultAuthor(detected.type);
  1603→      if (!options.force && process.env.KSPEC_AUTHOR) {
  1604→        steps.push({
  1605→          name: "Configure author",
  1606→          status: "skipped",
  1607→          message: `KSPEC_AUTHOR already set to "${process.env.KSPEC_AUTHOR}"`,
  1608→        });
  1609→      } else {
  1610→        let authorInstalled = false;
  1611→        switch (detected.type) {
  1612→          case "claude-code":
  1613→            if (!dryRun) {
  1614→              authorInstalled = await installClaudeCodeConfig(author);
  1615→            } else {
  1616→              authorInstalled = true;
  1617→            }
  1618→            break;
  1619→          case "aider":
  1620→            if (!dryRun) {
  1621→              authorInstalled = await installAiderConfig(author);
  1622→            } else {
  1623→              authorInstalled = true;
  1624→            }
  1625→            break;
  1626→          default:
  1627→            break;
  1628→        }
  1629→
  1630→        if (authorInstalled) {
  1631→          steps.push({
  1632→            name: "Configure author",
  1633→            status: "done",
  1634→            message: `KSPEC_AUTHOR="${author}"`,
  1635→          });
  1636→        }
  1637→      }
  1638→    }
  1639→
  1640→    // Output summary
  1641→    if (!dryRun) {
  1642→      console.log(chalk.bold("kspec Setup Summary\n"));
  1643→
  1644→      for (const step of steps) {
  1645→        const icon =
  1646→          step.status === "done"
  1647→            ? chalk.green("✓")
  1648→            : step.status === "skipped"
  1649→              ? chalk.gray("○")
  1650→              : chalk.red("✗");
  1651→        const statusText =
  1652→          step.status === "done"
  1653→            ? ""
  1654→            : step.status === "skipped"
  1655→              ? chalk.gray(" (skipped)")
  1656→              : chalk.red(" (failed)");
  1657→
  1658→        console.log(`${icon} ${step.name}${statusText}`);
  1659→        if (step.message) {
  1660→          console.log(chalk.gray(`  ${step.message}`));
  1661→        }
  1662→      }
  1663→    }
  1664→
  1665→    const success = steps.every((s) => s.status !== "failed");
  1666→
  1667→    return {
  1668→      success,
  1669→      steps,
  1670→      coreSkillsInstalled,
  1671→      skillsRendered,
  1672→      hooksInstalled,
  1673→      agentsMdGenerated,
  1674→      permissionsSeeded,
  1675→      memorySeeded,
  1676→    };
  1677→  } catch (err) {
  1678→    debugLog("runSetupPipeline failed", err);
  1679→    return {
  1680→      success: false,
  1681→      steps,
  1682→      coreSkillsInstalled,
  1683→      skillsRendered,
  1684→      hooksInstalled,
  1685→      agentsMdGenerated,
  1686→      permissionsSeeded,
  1687→      memorySeeded,
  1688→    };
  1689→  }
  1690→}
  1691→
  1692→/**
  1693→ * Register the 'setup' command
  1694→ * AC: @enhanced-setup ac-1 through ac-9
  1695→ */
  1696→export function registerSetupCommand(program: Command): void {
  1697→  program
  1698→    .command("setup")
  1699→    .description("Configure agent environment for kspec (orchestrated pipeline)")
  1700→    .option("--dry-run", "Show what would be done without making changes")
  1701→    .option(
  1702→      "--author <author>",
  1703→      "Custom author string (default: auto-detected based on agent)",
  1704→    )
  1705→    .option("--no-hooks", "Skip installing hooks")
  1706→    .option("--skip-skills", "Skip rendering skills")
  1707→    .option("--status", "Report current setup state without making changes")
  1708→    .option("--force", "Overwrite existing configuration")
  1709→    .option(
  1710→      "--auto-worktree",
  1711→      "Automatically create .kspec worktree if kspec-meta branch exists",
  1712→    )
  1713→    .action(async (options) => {
  1714→      try {
  1715→        const projectDir = process.cwd();
  1716→
  1717→        // AC: @enhanced-setup ac-7, ac-8 - --status mode
  1718→        if (options.status) {
  1719→          const status = await getSetupStatus(projectDir);
  1720→
  1721→          output(status, () => {
  1722→            console.log(chalk.bold("kspec Setup Status\n"));
  1723→
  1724→            // Agent detection
  1725→            console.log(chalk.gray("Agent:"));
  1726→            console.log(
  1727→              `  Detected: ${status.agent.detected} (${status.agent.confidence} confidence)`,
  1728→            );
  1729→            console.log();
  1730→
  1731→            // Hooks status
  1732→            console.log(chalk.gray("Hooks:"));
  1733→            console.log(
  1734→              `  UserPromptSubmit: ${status.hooks.promptCheck ? chalk.green("✓") : chalk.red("✗")}`,
  1735→            );
  1736→            console.log(
  1737→              `  Stop:             ${status.hooks.stop ? chalk.green("✓") : chalk.red("✗")}`,
  1738→            );
  1739→            console.log(
  1740→              `  PreToolUse:       ${status.hooks.preToolUse ? chalk.green("✓") : chalk.red("✗")}`,
  1741→            );
  1742→            if (status.hooks.guardsPresent.length > 0) {
  1743→              console.log(
  1744→                `  Guards:           ${status.hooks.guardsPresent.join(", ")}`,
  1745→              );
  1746→            }
  1747→            console.log();
  1748→
  1749→            // Skills status
  1750→            console.log(chalk.gray("Skills:"));
  1751→            console.log(`  Rendered: ${status.skills.rendered}`);
  1752→            if (status.skills.drifted > 0) {
  1753→              console.log(
  1754→                `  Drifted:  ${chalk.yellow(status.skills.drifted.toString())}`,
  1755→              );
  1756→            }
  1757→            console.log();
  1758→
  1759→            // Plugin marketplace status
  1760→            // AC: @enhanced-setup ac-7, ac-8
  1761→            console.log(chalk.gray("Plugin:"));
  1762→            console.log(
  1763→              `  Marketplace: ${status.plugin.marketplaceRegistered ? (status.plugin.marketplaceHealthy ? chalk.green("healthy") : chalk.yellow("registered")) : chalk.red("not registered")}`,
  1764→            );
  1765→            console.log(
  1766→              `  Enabled:     ${status.plugin.pluginEnabled ? chalk.green("✓") : chalk.red("✗")}`,
  1767→            );
  1768→            if (status.plugin.registeredPath) {
  1769→              console.log(chalk.gray(`  Path: ${status.plugin.registeredPath}`));
  1770→            }
  1771→            if (status.plugin.healthMessage && !status.plugin.marketplaceHealthy) {
  1772→              console.log(chalk.yellow(`  ${status.plugin.healthMessage}`));
  1773→            }
  1774→            console.log();
  1775→
  1776→            // Agents.md status
  1777→            console.log(chalk.gray("kspec-agents.md:"));
  1778→            if (status.agentsMd.exists) {
  1779→              // AC: @doctor-command ac-staleness-unknown — show appropriate color for unknown status
  1780→              const statusColor =
  1781→                status.agentsMd.status === "current"
  1782→                  ? chalk.green
  1783→                  : status.agentsMd.status === "unknown"
  1784→                    ? chalk.yellow
  1785→                    : chalk.yellow;
  1786→              console.log(`  Status: ${statusColor(status.agentsMd.status)}`);
  1787→              if (status.agentsMd.status === "unknown") {
  1788→                console.log(chalk.gray("  Could not determine staleness (no manifest or hash unavailable)"));
  1789→              }
  1790→              if (status.agentsMd.generatedAt) {
  1791→                console.log(`  Generated: ${status.agentsMd.generatedAt}`);
  1792→              }
  1793→            } else {
  1794→              console.log(`  Status: ${chalk.red("missing")}`);
  1795→              console.log(
  1796→                chalk.gray("  Run 'kspec setup' to generate"),
  1797→              );
  1798→            }
  1799→            console.log();
  1800→
  1801→            // Seeding status
  1802→            console.log(chalk.gray("Seeding:"));
  1803→            console.log(
  1804→              `  Permissions: ${status.seeding.permissionsSeeded ? chalk.green("✓") : chalk.gray("○")}`,
  1805→            );
  1806→            console.log(
  1807→              `  Memory:      ${status.seeding.memorySeeded ? chalk.green("✓") : chalk.gray("○")}`,
  1808→            );
  1809→            if (status.seeding.memoryPath) {
  1810→              console.log(
  1811→                chalk.gray(`  Path: ${status.seeding.memoryPath}`),
  1812→              );
  1813→            }
  1814→          });
  1815→          return;
  1816→        }
  1817→
  1818→        // AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
  1819→        const worktreeReady = await ensureWorktree(
  1820→          options.autoWorktree || false,
  1821→        );
  1822→        if (!worktreeReady) {
  1823→          // User declined worktree creation or it failed
  1824→          process.exit(EXIT_CODES.ERROR);
  1825→        }
  1826→
  1827→        const detected = detectAgent();
  1828→        const dryRun = options.dryRun || false;
  1829→
  1830→        if (detected.type === "unknown") {
  1831→          warn("Could not auto-detect agent environment");
  1832→          printManualInstructions("unknown");
  1833→          return;
  1834→        }
  1835→
  1836→        // AC: @setup-pipeline-unification ac-3 - delegate to runSetupPipeline()
  1837→        // One code path for both 'kspec setup' and 'kspec init --setup'
  1838→        const result = await runSetupPipeline(projectDir, {
  1839→          dryRun,
  1840→          skipSkills: options.skipSkills || false,
  1841→          installHooks: options.hooks !== false,
  1842→          force: options.force || false,
  1843→          author: options.author,
  1844→          configureAuthor: true,
  1845→        });
  1846→
  1847→        // AC: @enhanced-setup ac-1 - Display summary
  1848→        // AC: @enhanced-setup ac-6 - dry-run displays planned actions
  1849→        output(
  1850→          {
  1851→            dry_run: dryRun,
  1852→            steps: result.steps.map((s) => ({
  1853→              name: s.name,
  1854→              status: s.status,
  1855→              message: s.message,
  1856→              details: s.details,
  1857→            })),
  1858→          },
  1859→          () => {
  1860→            if (dryRun) {
  1861→              console.log(chalk.yellow("DRY RUN - No changes made\n"));
  1862→            }
  1863→
  1864→            // Pipeline already prints the summary when not dry-run
  1865→            // For dry-run, print it here since the pipeline skips output
  1866→            if (dryRun) {
  1867→              console.log(chalk.bold("kspec Setup Summary\n"));
  1868→
  1869→              for (const step of result.steps) {
  1870→                const icon =
  1871→                  step.status === "done"
  1872→                    ? chalk.green("✓")
  1873→                    : step.status === "skipped"
  1874→                      ? chalk.gray("○")
  1875→                      : chalk.red("✗");
  1876→                const statusText =
  1877→                  step.status === "done"
  1878→                    ? ""
  1879→                    : step.status === "skipped"
  1880→                      ? chalk.gray(" (skipped)")
  1881→                      : chalk.red(" (failed)");
  1882→
  1883→                console.log(`${icon} ${step.name}${statusText}`);
  1884→                if (step.message) {
  1885→                  console.log(chalk.gray(`  ${step.message}`));
  1886→                }
  1887→              }
  1888→            }
  1889→
  1890→            console.log();
  1891→
  1892→            if (dryRun) {
  1893→              console.log(
  1894→                chalk.yellow("Run without --dry-run to apply changes."),
  1895→              );
  1896→            } else {
  1897→              console.log(
  1898→                chalk.green("Setup complete."),
  1899→              );
  1900→              console.log(
  1901→                chalk.gray("Restart your agent session for changes to take effect."),
  1902→              );
  1903→            }
  1904→          },
  1905→        );
  1906→      } catch (err) {
  1907→        error(errors.failures.setupFailed, err);
  1908→        process.exit(EXIT_CODES.ERROR);
  1909→      }
  1910→    });
  1911→}
  1912→
```