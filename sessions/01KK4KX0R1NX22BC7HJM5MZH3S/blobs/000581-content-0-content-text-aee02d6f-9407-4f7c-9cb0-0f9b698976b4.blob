```
     1→<!--
     2→  AC: @ui-task-board ac-3 — Task detail modal with full task info.
     3→  AC: @ui-task-board ac-6 — Action buttons: Start, Submit, Complete, Block, Add Note.
     4→-->
     5→<script lang="ts">
     6→	import type { TaskDetail } from '@kynetic-ai/shared';
     7→	import {
     8→		fetchTask,
     9→		startTask,
    10→		submitTask,
    11→		completeTask,
    12→		blockTask,
    13→		addTaskNote
    14→	} from '$lib/api';
    15→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    16→	import * as Dialog from '$lib/components/ui/dialog';
    17→	import { Badge } from '$lib/components/ui/badge';
    18→	import { Button } from '$lib/components/ui/button';
    19→	import { Textarea } from '$lib/components/ui/textarea';
    20→	import { Input } from '$lib/components/ui/input';
    21→	import { Separator } from '$lib/components/ui/separator';
    22→	import { Skeleton } from '$lib/components/ui/skeleton';
    23→	import ReferenceLink from '$lib/components/ReferenceLink.svelte';
    24→	import * as Tooltip from '$lib/components/ui/tooltip';
    25→	import { getStatusClasses, formatAge, formatVcsRef } from './board-utils';
    26→	import GitBranch from '@lucide/svelte/icons/git-branch';
    27→	import ExternalLink from '@lucide/svelte/icons/external-link';
    28→
    29→	let {
    30→		open = $bindable(false),
    31→		taskRef = $bindable<string | null>(null),
    32→		onTaskUpdated
    33→	}: {
    34→		open?: boolean;
    35→		taskRef?: string | null;
    36→		onTaskUpdated?: () => void;
    37→	} = $props();
    38→
    39→	let task = $state<TaskDetail | null>(null);
    40→	let loading = $state(false);
    41→	let error = $state('');
    42→	let actionError = $state('');
    43→	let isSubmitting = $state(false);
    44→
    45→	// Note form
    46→	let noteContent = $state('');
    47→
    48→	// Block/Complete reason form
    49→	let reasonInput = $state('');
    50→	let showReasonFor = $state<'block' | 'complete' | null>(null);
    51→
    52→	$effect(() => {
    53→		if (open && taskRef) {
    54→			loadTask(taskRef);
    55→		} else if (!open) {
    56→			task = null;
    57→			error = '';
    58→			actionError = '';
    59→			noteContent = '';
    60→			reasonInput = '';
    61→			showReasonFor = null;
    62→		}
    63→	});
    64→
    65→	async function loadTask(ref: string) {
    66→		loading = true;
    67→		error = '';
    68→		try {
    69→			task = await fetchTask(ref);
    70→		} catch (err) {
    71→			error = err instanceof Error ? err.message : 'Failed to load task';
    72→		} finally {
    73→			loading = false;
    74→		}
    75→	}
    76→
    77→	async function reloadAndNotify() {
    78→		if (task) {
    79→			task = await fetchTask(task._ulid);
    80→		}
    81→		onTaskUpdated?.();
    82→	}
    83→
    84→	async function handleAction(action: () => Promise<void>) {
    85→		isSubmitting = true;
    86→		actionError = '';
    87→		try {
    88→			await action();
    89→			await reloadAndNotify();
    90→		} catch (err) {
    91→			if (err instanceof ReadOnlyModeError) {
    92→				actionError = err.message;
    93→			} else {
    94→				actionError = err instanceof Error ? err.message : 'Action failed';
    95→			}
    96→		} finally {
    97→			isSubmitting = false;
    98→		}
    99→	}
   100→
   101→	function handleStart() {
   102→		if (!task) return;
   103→		handleAction(() => startTask(task!._ulid));
   104→	}
   105→
   106→	function handleSubmit() {
   107→		if (!task) return;
   108→		handleAction(() => submitTask(task!._ulid));
   109→	}
   110→
   111→	function handleComplete() {
   112→		if (!task || !reasonInput.trim()) return;
   113→		const reason = reasonInput.trim();
   114→		handleAction(async () => {
   115→			await completeTask(task!._ulid, reason);
   116→			reasonInput = '';
   117→			showReasonFor = null;
   118→		});
   119→	}
   120→
   121→	function handleBlock() {
   122→		if (!task || !reasonInput.trim()) return;
   123→		const reason = reasonInput.trim();
   124→		handleAction(async () => {
   125→			await blockTask(task!._ulid, reason);
   126→			reasonInput = '';
   127→			showReasonFor = null;
   128→		});
   129→	}
   130→
   131→	function handleAddNote() {
   132→		if (!task || !noteContent.trim()) return;
   133→		const content = noteContent.trim();
   134→		handleAction(async () => {
   135→			await addTaskNote(task!._ulid, content);
   136→			noteContent = '';
   137→		});
   138→	}
   139→
   140→	function formatDate(dateStr: string): string {
   141→		return new Intl.DateTimeFormat('en-US', {
   142→			month: 'short',
   143→			day: 'numeric',
   144→			hour: '2-digit',
   145→			minute: '2-digit'
   146→		}).format(new Date(dateStr));
   147→	}
   148→
   149→	let statusInfo = $derived(task ? getStatusClasses(task.status) : null);
   150→	let slug = $derived(task?.slugs?.[0] ?? task?._ulid?.slice(0, 8) ?? '');
   151→</script>
   152→
   153→<Dialog.Root bind:open>
   154→	<Dialog.Content class="max-w-2xl max-h-[85vh] overflow-y-auto" data-testid="task-detail-modal">
   155→		{#if loading}
   156→			<div class="flex flex-col gap-4 py-4" data-testid="task-detail-skeleton">
   157→				<!-- Title skeleton -->
   158→				<Skeleton class="h-6 w-3/4 ds-shimmer" />
   159→				<Skeleton class="h-3 w-24 ds-shimmer" />
   160→
   161→				<!-- Status/priority badges skeleton -->
   162→				<div class="flex gap-2">
   163→					<Skeleton class="h-5 w-20 rounded-full ds-shimmer" />
   164→					<Skeleton class="h-5 w-24 rounded-full ds-shimmer" />
   165→				</div>
   166→
   167→				<!-- Spec ref skeleton -->
   168→				<div>
   169→					<Skeleton class="h-3 w-10 mb-1 ds-shimmer" />
   170→					<Skeleton class="h-4 w-32 ds-shimmer" />
   171→				</div>
   172→
   173→				<!-- Tags skeleton -->
   174→				<div class="flex gap-1">
   175→					<Skeleton class="h-5 w-12 rounded-full ds-shimmer" />
   176→					<Skeleton class="h-5 w-16 rounded-full ds-shimmer" />
   177→				</div>
   178→
   179→				<!-- Separator -->
   180→				<Skeleton class="h-px w-full ds-shimmer" />
   181→
   182→				<!-- Notes skeleton -->
   183→				<div>
   184→					<Skeleton class="h-3 w-16 mb-2 ds-shimmer" />
   185→					<Skeleton class="h-16 w-full rounded-md ds-shimmer" />
   186→				</div>
   187→			</div>
   188→		{:else if error}
   189→			<div class="bg-destructive/10 text-destructive p-4 rounded-lg" role="alert">
   190→				{error}
   191→			</div>
   192→		{:else if task && statusInfo}
   193→			<Dialog.Header>
   194→				<Dialog.Title data-testid="modal-task-title">{task.title}</Dialog.Title>
   195→				<Dialog.Description>
   196→					<span class="font-mono text-xs">@{slug}</span>
   197→				</Dialog.Description>
   198→			</Dialog.Header>
   199→
   200→			<div class="flex flex-col gap-4">
   201→				<!-- AC: @ui-task-board ac-3 — Description -->
   202→				{#if task.description}
   203→					<p class="text-sm text-muted-foreground" data-testid="modal-description">
   204→						{task.description}
   205→					</p>
   206→				{/if}
   207→
   208→				<!-- Status, priority, type -->
   209→				<div class="flex flex-wrap gap-2 items-center">
   210→					<Badge class="{statusInfo.bg} {statusInfo.fg}" data-testid="modal-status-badge">
   211→						{statusInfo.label}
   212→					</Badge>
   213→					<Badge variant="outline" data-testid="modal-priority">Priority {task.priority}</Badge>
   214→					<Badge variant="outline" data-testid="modal-type">{task.type}</Badge>
   215→					{#if task.automation}
   216→						<Badge variant="secondary" data-testid="modal-automation">
   217→							{task.automation}
   218→						</Badge>
   219→					{/if}
   220→				</div>
   221→
   222→				<!-- Spec ref -->
   223→				{#if task.spec_ref}
   224→					<div data-testid="modal-spec-ref">
   225→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Spec</p>
   226→						<ReferenceLink ref={task.spec_ref} type="spec" />
   227→					</div>
   228→				{/if}
   229→
   230→				<!-- Tags -->
   231→				{#if task.tags?.length > 0}
   232→					<div data-testid="modal-tags">
   233→						<p class="text-xs font-medium text-muted-foreground mb-1">Tags</p>
   234→						<div class="flex flex-wrap gap-1">
   235→							{#each task.tags as tag}
   236→								<Badge variant="secondary">{tag}</Badge>
   237→							{/each}
   238→						</div>
   239→					</div>
   240→				{/if}
   241→
   242→				<!-- Dependencies -->
   243→				{#if task.depends_on?.length > 0}
   244→					<div data-testid="modal-dependencies">
   245→						<p class="text-xs font-medium text-muted-foreground mb-1">Dependencies</p>
   246→						<ul class="text-sm space-y-0.5">
   247→							{#each task.depends_on as dep}
   248→								<li>
   249→									<ReferenceLink ref={dep} type="task" class="text-xs" />
   250→								</li>
   251→							{/each}
   252→						</ul>
   253→					</div>
   254→				{/if}
   255→
   256→				<!-- Blocked by -->
   257→				{#if task.blocked_by?.length > 0}
   258→					<div data-testid="modal-blocked-by">
   259→						<p class="text-xs font-medium text-destructive mb-1">Blocked By</p>
   260→						<ul class="text-sm space-y-0.5">
   261→							{#each task.blocked_by as blocker}
   262→								<li>
   263→									<ReferenceLink ref={blocker} type="task" class="text-xs" />
   264→								</li>
   265→							{/each}
   266→						</ul>
   267→					</div>
   268→				{/if}
   269→
   270→				<!-- AC: @ui-task-board ac-3 — VCS info (branch, PR link) -->
   271→				{#if task.vcs_refs?.length > 0}
   272→					<div data-testid="modal-vcs">
   273→						<p class="text-xs font-medium text-muted-foreground mb-1">VCS</p>
   274→						<ul class="text-sm space-y-1">
   275→							{#each task.vcs_refs as ref}
   276→								{@const vcsInfo = formatVcsRef(ref)}
   277→								<li class="flex items-center gap-1.5">
   278→									<GitBranch class="size-3 text-muted-foreground flex-shrink-0" />
   279→									{#if vcsInfo.url}
   280→										<a
   281→											href={vcsInfo.url}
   282→											target="_blank"
   283→											rel="noopener noreferrer"
   284→											class="text-xs text-primary hover:underline font-mono inline-flex items-center gap-1"
   285→										>
   286→											{vcsInfo.label}
   287→											<ExternalLink class="size-3" />
   288→										</a>
   289→									{:else}
   290→										<span class="text-muted-foreground font-mono text-xs">{vcsInfo.label}</span>
   291→									{/if}
   292→								</li>
   293→							{/each}
   294→						</ul>
   295→					</div>
   296→				{/if}
   297→
   298→				<!-- AC: @ui-task-board ac-3 — Plan ref -->
   299→				{#if task.plan_ref}
   300→					<div data-testid="modal-plan-ref">
   301→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Plan</p>
   302→						<ReferenceLink ref={task.plan_ref} type="plan" />
   303→					</div>
   304→				{:else if task.derivation}
   305→					<div data-testid="modal-plan-ref">
   306→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Derivation</p>
   307→						<p class="text-sm text-muted-foreground">{task.derivation}</p>
   308→					</div>
   309→				{/if}
   310→
   311→				<!-- AC: @ui-task-board ac-3 — Session link -->
   312→				{#if task.session_ref}
   313→					<div data-testid="modal-session-link">
   314→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Session</p>
   315→						<ReferenceLink ref={task.session_ref} type="session" />
   316→					</div>
   317→				{/if}
   318→
   319→				<Separator />
   320→
   321→				<!-- AC: @ui-task-board ac-6 — Actions -->
   322→				{#if !isStaticMode()}
   323→					<div class="flex flex-wrap gap-2" data-testid="modal-actions">
   324→						{#if task.status === 'pending'}
   325→							<Button
   326→								size="sm"
   327→								onclick={handleStart}
   328→								disabled={isSubmitting}
   329→								data-testid="action-start"
   330→							>
   331→								{isSubmitting ? 'Starting...' : 'Start'}
   332→							</Button>
   333→						{/if}
   334→
   335→						{#if task.status === 'in_progress' || task.status === 'needs_work'}
   336→							<Button
   337→								size="sm"
   338→								onclick={handleSubmit}
   339→								disabled={isSubmitting}
   340→								data-testid="action-submit"
   341→							>
   342→								{isSubmitting ? 'Submitting...' : 'Submit for Review'}
   343→							</Button>
   344→						{/if}
   345→
   346→						{#if task.status === 'in_progress' || task.status === 'pending_review'}
   347→							<Button
   348→								size="sm"
   349→								variant="outline"
   350→								onclick={() => {
   351→									showReasonFor = 'complete';
   352→									reasonInput = '';
   353→								}}
   354→								disabled={isSubmitting}
   355→								data-testid="action-complete-toggle"
   356→							>
   357→								Complete
   358→							</Button>
   359→						{/if}
   360→
   361→						{#if task.status !== 'blocked' && task.status !== 'completed' && task.status !== 'cancelled'}
   362→							<Button
   363→								size="sm"
   364→								variant="destructive"
   365→								onclick={() => {
   366→									showReasonFor = 'block';
   367→									reasonInput = '';
   368→								}}
   369→								disabled={isSubmitting}
   370→								data-testid="action-block-toggle"
   371→							>
   372→								Block
   373→							</Button>
   374→						{/if}
   375→					</div>
   376→
   377→					<!-- Reason input for block/complete -->
   378→					{#if showReasonFor}
   379→						<div class="flex gap-2" data-testid="reason-input">
   380→							<Input
   381→								bind:value={reasonInput}
   382→								placeholder="{showReasonFor === 'block' ? 'Block' : 'Completion'} reason..."
   383→								class="flex-1"
   384→							/>
   385→							<Button
   386→								size="sm"
   387→								onclick={showReasonFor === 'block' ? handleBlock : handleComplete}
   388→								disabled={isSubmitting || !reasonInput.trim()}
   389→							>
   390→								Confirm
   391→							</Button>
   392→							<Button
   393→								size="sm"
   394→								variant="ghost"
   395→								onclick={() => {
   396→									showReasonFor = null;
   397→									reasonInput = '';
   398→								}}
   399→							>
   400→								Cancel
   401→							</Button>
   402→						</div>
   403→					{/if}
   404→				{/if}
   405→
   406→				{#if actionError}
   407→					<p class="text-sm text-destructive" data-testid="action-error">{actionError}</p>
   408→				{/if}
   409→
   410→				<Separator />
   411→
   412→				<!-- Todos -->
   413→				{#if task.todos && task.todos.length > 0}
   414→					<div data-testid="modal-todos">
   415→						<p class="text-xs font-medium text-muted-foreground mb-1">
   416→							Todos ({task.todos.length})
   417→						</p>
   418→						<ul class="space-y-1">
   419→							{#each task.todos as todo}
   420→								<li class="flex items-start gap-2 text-sm">
   421→									<span class="mt-0.5 text-xs">
   422→										{#if todo.done}
   423→											&#x2705;
   424→										{:else}
   425→											&#x23F8;&#xFE0F;
   426→										{/if}
   427→									</span>
   428→									<span class:line-through={todo.done}>
   429→										{todo.text}
   430→									</span>
   431→								</li>
   432→							{/each}
   433→						</ul>
   434→					</div>
   435→					<Separator />
   436→				{/if}
   437→
   438→				<!-- Notes -->
   439→				<div data-testid="modal-notes">
   440→					<p class="text-xs font-medium text-muted-foreground mb-2">
   441→						Notes ({task.notes?.length ?? 0})
   442→					</p>
   443→
   444→					<!-- Add Note form -->
   445→					{#if !isStaticMode()}
   446→						<div class="mb-3 space-y-2" data-testid="modal-add-note">
   447→							<Textarea
   448→								placeholder="Add a note..."
   449→								bind:value={noteContent}
   450→								disabled={isSubmitting}
   451→								rows={2}
   452→							/>
   453→							<Button
   454→								size="sm"
   455→								onclick={handleAddNote}
   456→								disabled={isSubmitting || !noteContent.trim()}
   457→								data-testid="action-add-note"
   458→							>
   459→								{isSubmitting ? 'Adding...' : 'Add Note'}
   460→							</Button>
   461→						</div>
   462→					{/if}
   463→
   464→					<!-- Notes list -->
   465→					<div class="space-y-3">
   466→						{#if (task.notes ?? []).length === 0}
   467→							<div class="text-center py-4 text-muted-foreground text-xs" data-testid="notes-empty">
   468→								{#if isStaticMode()}
   469→									No notes recorded. Use <code class="bg-muted px-1 rounded">kspec task note</code> to add context.
   470→								{:else}
   471→									Add a note above to document decisions, progress, or findings.
   472→								{/if}
   473→							</div>
   474→						{:else}
   475→							{#each task.notes ?? [] as note}
   476→								<div class="border rounded-md p-2.5" data-testid="note-item">
   477→									<div class="flex justify-between items-start mb-1">
   478→										<span class="text-[10px] text-muted-foreground">{note.author}</span>
   479→										<span class="text-[10px] text-muted-foreground">{formatDate(note.created_at)}</span>
   480→									</div>
   481→									<p class="text-sm whitespace-pre-wrap">{note.content}</p>
   482→								</div>
   483→							{/each}
   484→						{/if}
   485→					</div>
   486→				</div>
   487→			</div>
   488→		{/if}
   489→	</Dialog.Content>
   490→</Dialog.Root>
   491→
```