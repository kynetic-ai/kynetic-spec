   355→  test.describe('Task Actions', () => {
   356→    // AC: @web-dashboard ac-7
   357→    test('starts a pending task', async ({ page, daemon }) => {
   358→      await page.goto('/tasks?status=pending');
   359→
   360→      // Click pending task to open detail
   361→      const taskItem = page.getByTestId('task-list-item').first();
   362→      await taskItem.click();
   363→
   364→      const detailPanel = page.getByTestId('task-detail-panel');
   365→      const startButton = detailPanel.getByTestId('start-task-button');
   366→      await expect(startButton).toBeVisible();
   367→
   368→      // Set up request interception to verify API call
   369→      const requestPromise = page.waitForRequest((request) => {
   370→        return request.url().includes('/api/tasks/') && request.url().includes('/start');
   371→      });
   372→
   373→      // Click start button
   374→      await startButton.click();
   375→
   376→      // Verify API request was made
   377→      const request = await requestPromise;
   378→      expect(request.method()).toBe('POST');
   379→
   380→      // Status badge should update to "pending"
   381→      const statusBadge = detailPanel.getByTestId('task-status-badge');
   382→      await expect(statusBadge).toContainText(/pending/i);
   383→    });
   384→
   385→    // AC: @web-dashboard ac-8
   386→    test('adds note to task', async ({ page, daemon }) => {
   387→      await page.goto('/tasks');
   388→
   389→      // Open task detail
   390→      const taskItem = page.getByTestId('task-list-item').first();
   391→      await taskItem.click();
   392→
   393→      const detailPanel = page.getByTestId('task-detail-panel');
   394→      const addNoteForm = detailPanel.getByTestId('add-note-form');
   395→      await expect(addNoteForm).toBeVisible();
   396→
   397→      // Type note content
   398→      const noteTextarea = addNoteForm.getByTestId('note-textarea');
   399→      const noteContent = 'Test note added via E2E test';
   400→      await noteTextarea.fill(noteContent);
   401→
   402→      // Set up request interception
   403→      const requestPromise = page.waitForRequest((request) => {
   404→        return request.url().includes('/api/tasks/') && request.url().includes('/note');
   405→      });
   406→
   407→      // Submit note
   408→      const submitButton = addNoteForm.getByTestId('add-note-button');
   409→      await submitButton.click();
   410→
   411→      // Verify API request
   412→      const request = await requestPromise;
   413→      expect(request.method()).toBe('POST');
   414→
   415→      // Note should appear in notes list
   416→      const notesSection = detailPanel.getByTestId('task-notes');
   417→      await expect(notesSection).toContainText(noteContent);
   418→
   419→      // Textarea should be cleared
   420→      await expect(noteTextarea).toHaveValue('');
   421→    });
