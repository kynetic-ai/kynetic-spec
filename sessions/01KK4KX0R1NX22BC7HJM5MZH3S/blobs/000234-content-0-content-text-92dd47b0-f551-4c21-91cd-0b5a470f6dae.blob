   423→    // AC: @web-dashboard ac-33
   424→    // Note: This test requires WebSocket to be working. Currently, the daemon's
   425→    // WebSocket upgrade returns 200 instead of 101 in the test environment,
   426→    // causing the connection to fail. The UI code correctly handles WebSocket
   427→    // updates when the connection is available.
   428→    test.skip('highlights task on WebSocket update', async ({ page, daemon }) => {
   429→      await page.goto('/tasks');
   430→
   431→      // Wait for page to fully load
   432→      const taskList = page.getByTestId('task-list');
   433→      const firstTask = taskList.getByTestId('task-list-item').first();
   434→      await expect(firstTask).toBeVisible();
   435→
   436→      // Get task ref from first task (this is the slug or ULID)
   437→      const taskRef = await firstTask.getAttribute('data-task-ref');
   438→      expect(taskRef).toBeTruthy();
   439→
   440→      // Simulate external update via API (would trigger WebSocket event)
   441→      const response = await fetch(`${daemon.baseUrl}/api/tasks/${taskRef}/note`, {
   442→        method: 'POST',
   443→        headers: {
   444→          'Content-Type': 'application/json',
   445→        },
   446→        body: JSON.stringify({
   447→          content: 'External note added',
   448→          author: '@external',
   449→        }),
   450→      });
   451→      expect(response.ok).toBe(true);
   452→
   453→      // Find the task by data-task-ref attribute (not by text content)
   454→      const highlightedTask = taskList.locator(`[data-task-ref="${taskRef}"]`);
   455→      await expect(highlightedTask).toBeVisible();
   456→
   457→      // Check for highlight class or animation (the component uses animate-pulse)
   458→      await expect(highlightedTask).toHaveClass(/animate-pulse/, { timeout: 5000 });
   459→
   460→      // Highlight should fade after 3 seconds (per implementation)
   461→      await page.waitForTimeout(3500);
   462→      await expect(highlightedTask).not.toHaveClass(/animate-pulse/);
   463→    });
   464→  });
