     1→import { test, expect } from '../fixtures/test-base';
     2→
     3→/**
     4→ * Tasks View E2E Tests
     5→ *
     6→ * Tests for the tasks view in the web dashboard.
     7→ * These tests document expected behavior and will be enabled
     8→ * once the task UI components are implemented.
     9→ *
    10→ * Covered ACs:
    11→ * - AC-4: Task list displays with status, priority, spec_ref, notes count
    12→ * - AC-5: Task detail panel with notes, todos, dependencies
    13→ * - AC-6: Spec reference as clickable link
    14→ * - AC-7: Start Task button triggers state change
    15→ * - AC-8: Add Note form appends note
    16→ * - AC-9: Filter controls for status, type, tag, assignee, automation
    17→ * - AC-10: URL updates with filter params
    18→ * - AC-33: WebSocket updates highlight changed items
    19→ */
    20→
    21→test.describe('Tasks View', () => {
    22→  test.describe('Task List', () => {
    23→    // AC: @web-dashboard ac-4
    24→    test('displays task with title, status badge, priority, spec_ref, notes count', async ({
    25→      page,
    26→      daemon,
    27→    }) => {
    28→      await page.goto('/tasks');
    29→
    30→      // Wait for task list to load
    31→      const taskList = page.getByTestId('task-list');
    32→      await expect(taskList).toBeVisible();
    33→
    34→      // Find first task item
    35→      const taskItem = taskList.getByTestId('task-list-item').first();
    36→      await expect(taskItem).toBeVisible();
    37→
    38→      // Verify task displays all required fields
    39→      await expect(taskItem.getByTestId('task-title')).toBeVisible();
    40→      await expect(taskItem.getByTestId('task-status-badge')).toBeVisible();
    41→      await expect(taskItem.getByTestId('task-priority')).toBeVisible();
    42→      await expect(taskItem.getByTestId('task-spec-ref')).toBeVisible();
    43→      await expect(taskItem.getByTestId('task-notes-count')).toBeVisible();
    44→    });
    45→
    46→    // AC: @web-dashboard ac-9
    47→    test('filters tasks by status', async ({ page, daemon }) => {
    48→      await page.goto('/tasks');
    49→
    50→      // Wait for task list to load first (ensures page is ready)
    51→      const taskList = page.getByTestId('task-list');
    52→      await expect(taskList).toBeVisible();
    53→      const taskItems = page.getByTestId('task-list-item');
    54→      await expect(taskItems.first()).toBeVisible({ timeout: 10000 });
    55→
    56→      // Wait for filter controls
    57→      const filterStatus = page.getByTestId('filter-status');
    58→      await expect(filterStatus).toBeVisible();
    59→
    60→      // Select "pending" status
    61→      await filterStatus.click();
    62→      await page.getByRole('option', { name: 'Pending', exact: true }).click();
    63→
    64→      // Wait for URL to update with filter
    65→      await page.waitForURL(/status=pending/, { timeout: 10000 });
    66→
    67→      // Verify filtered results - should now show only pending tasks
    68→      await expect(taskItems.first()).toBeVisible({ timeout: 5000 });
    69→
    70→      // All visible tasks should have "pending" status badge
    71→      const count = await taskItems.count();
    72→      for (let i = 0; i < count; i++) {
    73→        const statusBadge = taskItems.nth(i).getByTestId('task-status-badge');
    74→        await expect(statusBadge).toContainText(/pending/i);
    75→      }
    76→    });
    77→
    78→    // AC: @web-dashboard ac-9
    79→    test('filters tasks by type', async ({ page, daemon }) => {
    80→      await page.goto('/tasks');
    81→
    82→      const filterType = page.getByTestId('filter-type');
    83→      await expect(filterType).toBeVisible();
    84→
    85→      // Select "task" type (use exact match to avoid matching "Subtask")
