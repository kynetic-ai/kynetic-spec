   226→  test.describe('Task Detail', () => {
   227→    // AC: @web-dashboard ac-5
   228→    test('opens detail panel when task clicked', async ({ page, daemon }) => {
   229→      // Capture console logs
   230→      const consoleLogs: string[] = [];
   231→      page.on('console', (msg) => {
   232→        consoleLogs.push(`${msg.type()}: ${msg.text()}`);
   233→      });
   234→
   235→      // Capture network requests
   236→      const apiCalls: string[] = [];
   237→      page.on('request', (request) => {
   238→        if (request.url().includes('/api/')) {
   239→          apiCalls.push(`${request.method()} ${request.url()}`);
   240→        }
   241→      });
   242→      page.on('response', (response) => {
   243→        if (response.url().includes('/api/')) {
   244→          apiCalls.push(`-> ${response.status()} ${response.url()}`);
   245→        }
   246→      });
   247→
   248→      await page.goto('/tasks');
   249→
   250→      // Wait for task list to load
   251→      const taskList = page.getByTestId('task-list');
   252→      await expect(taskList).toBeVisible();
   253→
   254→      // Wait for tasks to appear
   255→      const taskItem = page.getByTestId('task-list-item').first();
   256→      await expect(taskItem).toBeVisible();
   257→
   258→
   259→      // Click the first task
   260→      await taskItem.click();
   261→
   262→      // Wait briefly for API call and sheet animation
   263→      await page.waitForTimeout(2000);
   264→
   265→      // Debug output
   266→      console.log('=== Console logs ===');
   267→      consoleLogs.forEach(log => console.log(log));
   268→      console.log('=== API calls ===');
   269→      apiCalls.forEach(call => console.log(call));
   270→
   271→      // Detail panel should open
   272→      const detailPanel = page.getByTestId('task-detail-panel');
   273→      await expect(detailPanel).toBeVisible({ timeout: 5000 });
   274→
   275→      // Verify panel contains expected sections
   276→      await expect(detailPanel.getByTestId('task-description')).toBeVisible();
   277→      await expect(detailPanel.getByTestId('task-notes')).toBeVisible();
   278→    });
   279→
   280→    // AC: @web-dashboard ac-5
   281→    test('displays notes in chronological order', async ({ page, daemon }) => {
   282→      await page.goto('/tasks');
   283→
