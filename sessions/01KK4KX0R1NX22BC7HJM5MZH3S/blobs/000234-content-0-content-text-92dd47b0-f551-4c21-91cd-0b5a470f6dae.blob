   288→      // Get notes section
   289→      const notesSection = page.getByTestId('task-notes');
   290→      await expect(notesSection).toBeVisible();
   291→
   292→      // Notes should be ordered by timestamp
   293→      const noteItems = notesSection.getByTestId('note-item');
   294→      const count = await noteItems.count();
   295→
   296→      if (count > 1) {
   297→        // Check first note timestamp is earlier than last note timestamp
   298→        const firstNoteTime = await noteItems.first().getByTestId('note-timestamp').textContent();
   299→        const lastNoteTime = await noteItems.last().getByTestId('note-timestamp').textContent();
   300→        // Both should be present (chronological order validation)
   301→        expect(firstNoteTime).toBeTruthy();
   302→        expect(lastNoteTime).toBeTruthy();
   303→      }
   304→    });
