    92→      // Verify tasks displayed match selected type
    93→      const taskItems = page.getByTestId('task-list-item');
    94→      await expect(taskItems.first()).toBeVisible({ timeout: 5000 });
    95→    });
    96→
    97→    // AC: @web-dashboard ac-9
    98→    test('filters tasks by tag', async ({ page, daemon }) => {
    99→      await page.goto('/tasks');
   100→
   101→      // Wait for task list to load
   102→      const taskList = page.getByTestId('task-list');
