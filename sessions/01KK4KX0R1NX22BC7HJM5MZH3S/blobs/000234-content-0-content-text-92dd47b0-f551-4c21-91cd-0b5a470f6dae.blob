   183→    // AC: @web-dashboard ac-10
   184→    test('URL updates with filter query params', async ({ page, daemon }) => {
   185→      await page.goto('/tasks');
   186→
   187→      // Apply status filter
   188→      const filterStatus = page.getByTestId('filter-status');
   189→      await filterStatus.click();
   190→      await page.getByRole('option', { name: 'Pending', exact: true }).click();
