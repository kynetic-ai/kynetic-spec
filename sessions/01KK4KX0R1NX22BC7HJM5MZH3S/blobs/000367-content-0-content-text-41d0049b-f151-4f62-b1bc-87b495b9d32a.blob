   495→      const moduleNode = specTree.locator('[data-testid*="tree-node-module"]').first();
   496→      await moduleNode.locator('> div').first().getByTestId('node-title').click();
   497→
   498→      // Detail panel should slide over without navigating away
   499→      const detailPanel = page.getByTestId('spec-detail-panel');
