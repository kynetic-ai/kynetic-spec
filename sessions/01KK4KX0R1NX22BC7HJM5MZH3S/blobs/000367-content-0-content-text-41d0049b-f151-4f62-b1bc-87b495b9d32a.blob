   350→  test.describe('Acceptance Criteria Expansion (AC-15)', () => {
   351→    test('expands AC to show full Given/When/Then text', async ({ page, daemon }) => {
   352→      await page.goto('/items');
   353→
   354→      // Navigate to test-feature which has ACs
   355→      const specTree = page.getByTestId('spec-tree').first();
   356→      const moduleNode = specTree.locator('[data-testid*="tree-node-module"]').first();
   357→      await moduleNode.locator('> div').first().getByTestId('expand-toggle').click();
   358→
   359→      const childContainer = moduleNode.getByTestId('tree-node-child');
   360→      const featureNode = childContainer.locator('[data-testid*="tree-node-feature"]').first();
   361→      await featureNode.locator('> div').first().getByTestId('node-title').click();
   362→
   363→      const detailPanel = page.getByTestId('spec-detail-panel');
   364→      const acItem = detailPanel.getByTestId('ac-item').first();
   365→
   366→      // Initially, full content should be hidden (accordion collapsed)
   367→      const whenFull = acItem.getByTestId('ac-when-full');
   368→      const thenFull = acItem.getByTestId('ac-then-full');
   369→      await expect(whenFull).not.toBeVisible();
   370→      await expect(thenFull).not.toBeVisible();
   371→
   372→      // Click to expand
   373→      const expandToggle = acItem.getByTestId('ac-expand-toggle');
   374→      await expandToggle.click();
   375→
   376→      // Full GWT should now be visible with actual content
   377→      const givenFull = acItem.getByTestId('ac-given-full');
   378→      await expect(givenFull).toBeVisible();
   379→      await expect(givenFull).toContainText('a user is viewing the feature');
   380→
   381→      await expect(whenFull).toBeVisible();
   382→      await expect(whenFull).toContainText('they check the status');
   383→
   384→      await expect(thenFull).toBeVisible();
   385→      await expect(thenFull).toContainText('the feature shows as in progress');
   386→    });
   387→
   388→    test('collapses AC to hide full text', async ({ page, daemon }) => {
   389→      await page.goto('/items');
   390→
   391→      // Navigate to test-feature
   392→      const specTree = page.getByTestId('spec-tree').first();
   393→      const moduleNode = specTree.locator('[data-testid*="tree-node-module"]').first();
   394→      await moduleNode.locator('> div').first().getByTestId('expand-toggle').click();
   395→
   396→      const childContainer = moduleNode.getByTestId('tree-node-child');
   397→      const featureNode = childContainer.locator('[data-testid*="tree-node-feature"]').first();
   398→      await featureNode.locator('> div').first().getByTestId('node-title').click();
   399→
   400→      const detailPanel = page.getByTestId('spec-detail-panel');
   401→      const acItem = detailPanel.getByTestId('ac-item').first();
   402→      const expandToggle = acItem.getByTestId('ac-expand-toggle');
   403→
   404→      // Expand first
   405→      await expandToggle.click();
   406→      const whenFull = acItem.getByTestId('ac-when-full');
   407→      await expect(whenFull).toBeVisible();
   408→
   409→      // Collapse
   410→      await expandToggle.click();
   411→
   412→      // Full content should be hidden again
   413→      await expect(whenFull).not.toBeVisible();
   414→    });
   415→
