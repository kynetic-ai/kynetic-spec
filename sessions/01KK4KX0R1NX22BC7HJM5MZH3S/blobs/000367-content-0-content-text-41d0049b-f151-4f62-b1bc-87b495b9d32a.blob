   473→  test.describe('Responsive Layout', () => {
   474→    // AC: @web-dashboard ac-26
   475→    test('adapts to mobile viewport', async ({ page, daemon }) => {
   476→      await page.setViewportSize({ width: 375, height: 667 });
   477→      await page.goto('/items');
   478→
   479→      // Spec tree should be visible
   480→      const specTree = page.getByTestId('spec-tree').first();
   481→      await expect(specTree).toBeVisible();
   482→
   483→      // Container should adapt to narrow viewport
   484→      const treeContainer = page.getByTestId('spec-tree-container').first();
   485→      await expect(treeContainer).toBeVisible();
   486→    });
   487→
   488→    // AC: @web-dashboard ac-27
   489→    test('shows detail panel as slide-over on desktop', async ({ page, daemon }) => {
   490→      await page.setViewportSize({ width: 1280, height: 720 });
   491→      await page.goto('/items');
   492→
   493→      // Click spec item to open detail
