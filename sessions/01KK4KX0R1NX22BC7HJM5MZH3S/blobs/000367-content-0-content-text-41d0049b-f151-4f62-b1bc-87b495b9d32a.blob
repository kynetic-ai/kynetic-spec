```
     1→import { test, expect } from '../fixtures/test-base';
     2→
     3→/**
     4→ * Items View E2E Tests
     5→ *
     6→ * Tests for the spec items view in the web dashboard.
     7→ * Tests verify actual behavior, not just element visibility.
     8→ *
     9→ * Covered ACs:
    10→ * - AC-11: Spec tree with hierarchical display, expand/collapse
    11→ * - AC-12: Item detail panel with title, description, ACs (GWT), traits, implementation status
    12→ * - AC-13: Linked tasks section shows tasks with status
    13→ * - AC-14: Traits shown as chips, clickable to trait detail
    14→ * - AC-15: AC row expansion showing full Given/When/Then with test coverage
    15→ */
    16→
    17→test.describe('Items View', () => {
    18→  test.describe('Spec Tree (AC-11)', () => {
    19→    test('displays hierarchical spec tree with modules', async ({ page, daemon }) => {
    20→      await page.goto('/items');
    21→
    22→      // Wait for spec tree to load
    23→      const specTree = page.getByTestId('spec-tree').first();
    24→      await expect(specTree).toBeVisible();
    25→
    26→      // Verify module node is present with actual content
    27→      const moduleNode = specTree.locator('[data-testid*="tree-node-module"]').first();
    28→      await expect(moduleNode).toBeVisible();
    29→
    30→      // Verify module displays title with actual text - node-title is direct child, not inside expand-toggle
    31→      const nodeTitle = moduleNode.locator('> div').first().getByTestId('node-title');
    32→      await expect(nodeTitle).toBeVisible();
    33→      await expect(nodeTitle).toContainText('Core Module');
    34→    });
    35→
    36→    test('expands module to show nested features', async ({ page, daemon }) => {
    37→      await page.goto('/items');
    38→
    39→      const specTree = page.getByTestId('spec-tree').first();
    40→      const moduleNode = specTree.locator('[data-testid*="tree-node-module"]').first();
    41→      await expect(moduleNode).toBeVisible();
    42→
    43→      // Click expand toggle on module
    44→      const expandToggle = moduleNode.locator('> div').first().getByTestId('expand-toggle');
    45→      await expandToggle.click();
    46→
    47→      // Child content should be visible - look for feature node
    48→      const childContainer = moduleNode.getByTestId('tree-node-child');
    49→      await expect(childContainer).toBeVisible();
    50→
    51→      // Feature should be present with actual title
    52→      const featureNode = childContainer.locator('[data-testid*="tree-node-feature"]').first();
    53→      await expect(featureNode).toBeVisible();
    54→
    55→      const featureTitle = featureNode.locator('> div').first().getByTestId('node-title');
    56→      await expect(featureTitle).toContainText('Test Feature');
    57→    });
    58→
    59→    test('expands feature to show nested requirements', async ({ page, daemon }) => {
    60→      await page.goto('/items');
    61→
    62→      const specTree = page.getByTestId('spec-tree').first();
    63→
    64→      // Expand module first
    65→      const moduleNode = specTree.locator('[data-testid*="tree-node-module"]').first();
    66→      await moduleNode.locator('> div').first().getByTestId('expand-toggle').click();
    67→
    68→      // Find and expand feature
    69→      const childContainer = moduleNode.getByTestId('tree-node-child');
    70→      const featureNode = childContainer.locator('[data-testid*="tree-node-feature"]').first();
    71→      await featureNode.locator('> div').first().getByTestId('expand-toggle').click();
    72→
    73→      // Requirement should be visible
    74→      const featureChildContainer = featureNode.getByTestId('tree-node-child');
    75→      await expect(featureChildContainer).toBeVisible();
    76→
    77→      const requirementNode = featureChildContainer.locator('[data-testid*="tree-node-requirement"]').first();
    78→      await expect(requirementNode).toBeVisible();
    79→
    80→      // Requirements don't have expand toggle (no children), just title
    81→      const reqTitle = requirementNode.locator('> div').first().getByTestId('node-title');
    82→      await expect(reqTitle).toContainText('Test Requirement');
    83→    });
    84→
    85→    test('collapses expanded node to hide children', async ({ page, daemon }) => {
    86→      await page.goto('/items');
    87→
    88→      const specTree = page.getByTestId('spec-tree').first();
    89→      const moduleNode = specTree.locator('[data-testid*="tree-node-module"]').first();
    90→
    91→      // Expand module
    92→      await moduleNode.locator('> div').first().getByTestId('expand-toggle').click();
    93→      const childContainer = moduleNode.getByTestId('tree-node-child');
    94→      await expect(childContainer).toBeVisible();
    95→
    96→      // Collapse module
    97→      await moduleNode.locator('> div').first().getByTestId('expand-toggle').click();
    98→
    99→      // Children should be hidden
   100→      await expect(childContainer).not.toBeVisible();
   101→    });
   102→
   103→    test('clicking item title opens detail panel (not expand)', async ({ page, daemon }) => {
   104→      await page.goto('/items');
   105→
   106→      const specTree = page.getByTestId('spec-tree').first();
