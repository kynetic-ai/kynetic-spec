```
     1→/**
     2→ * Agent Dispatch Engine
     3→ *
     4→ * Core dispatch runtime for the daemon. Watches for task state changes via
     5→ * file watcher events and direct API event emission from CLI commands. Matches
     6→ * state changes against agent dispatch rules, queues invocations, manages
     7→ * concurrency, and handles deduplication of events from dual sources.
     8→ * Serializes shadow branch mutations when multiple agents run concurrently.
     9→ *
    10→ * AC: @agent-dispatch-engine ac-1 through ac-12
    11→ */
    12→
    13→import * as path from "node:path";
    14→import { spawnSync } from "node:child_process";
    15→import { ulid } from "ulid";
    16→import {
    17→  initContext,
    18→  loadAllTasks,
    19→  loadMetaContext,
    20→  type LoadedTask,
    21→  type LoadedAgent,
    22→} from "../parser/index.js";
    23→import { runInvocation } from "./invocation.js";
    24→import type { InvocationOptions } from "./invocation.js";
    25→import { getAdapter } from "../agents/adapters.js";
    26→import type {
    27→  AgentDispatchRule,
    28→  AgentDispatchFilter,
    29→} from "../schema/meta.js";
    30→import type { SessionTrigger } from "../sessions/types.js";
    31→
    32→// ─── Simple Mutex ─────────────────────────────────────────────────────────────
    33→
    34→/**
    35→ * A minimal promise-based mutex for serializing async operations.
    36→ * AC: @agent-dispatch-engine ac-12
    37→ */
    38→class Mutex {
    39→  private _queue: Array<() => void> = [];
    40→  private _locked = false;
    41→
    42→  async runExclusive<T>(fn: () => Promise<T>): Promise<T> {
    43→    await this._acquire();
    44→    try {
    45→      return await fn();
    46→    } finally {
    47→      this._release();
    48→    }
    49→  }
    50→
    51→  private _acquire(): Promise<void> {
    52→    if (!this._locked) {
    53→      this._locked = true;
    54→      return Promise.resolve();
    55→    }
    56→    return new Promise<void>((resolve) => {
    57→      this._queue.push(resolve);
    58→    });
    59→  }
    60→
    61→  private _release(): void {
    62→    const next = this._queue.shift();
    63→    if (next) {
    64→      next();
    65→    } else {
    66→      this._locked = false;
    67→    }
    68→  }
    69→}
    70→
    71→// ─── Types ────────────────────────────────────────────────────────────────────
    72→
    73→/**
    74→ * Task state as used for dispatch tracking.
    75→ */
    76→export type TaskStatus =
    77→  | "pending"
    78→  | "in_progress"
    79→  | "pending_review"
    80→  | "needs_work"
    81→  | "blocked"
    82→  | "completed"
    83→  | "cancelled";
    84→
    85→/**
    86→ * Mapping from dispatch event names to task statuses.
    87→ * AC: @agent-dispatch-engine ac-1
    88→ */
    89→const EVENT_TO_STATUS: Record<string, TaskStatus> = {
    90→  "task.in_progress": "in_progress",
    91→  "task.ready": "pending",
    92→  "task.needs_work": "needs_work",
    93→  "task.pending_review": "pending_review",
    94→};
    95→
    96→const STATUS_TO_EVENT: Record<TaskStatus, string | undefined> = {
    97→  in_progress: "task.in_progress",
    98→  pending: "task.ready",
    99→  needs_work: "task.needs_work",
   100→  pending_review: "task.pending_review",
   101→  blocked: undefined,
   102→  completed: undefined,
   103→  cancelled: undefined,
   104→};
   105→
   106→/**
   107→ * Dispatch precedence for runnable task statuses.
   108→ * Lower number = higher scheduling priority.
   109→ *
   110→ * AC: @dispatch-in-progress-priority ac-1
   111→ */
   112→const STATUS_PRECEDENCE: Record<TaskStatus, number> = {
   113→  in_progress: 0,
   114→  needs_work: 1,
   115→  pending: 2,
   116→  pending_review: 3,
   117→  blocked: 4,
   118→  completed: 5,
   119→  cancelled: 6,
   120→};
   121→
   122→// ─── Prompt Helpers (exported for testing) ───────────────────────────────────
   123→
   124→/**
   125→ * Interpolate {{variable}} placeholders in a prompt template.
   126→ * Unresolved variables pass through unchanged.
   127→ *
   128→ * AC: @agent-dispatch-engine ac-16
   129→ */
   130→export function interpolateTemplate(
   131→  template: string,
   132→  vars: Record<string, string>,
   133→): string {
   134→  return template.replace(
   135→    /\{\{(\w+)\}\}/g,
   136→    (match, key: string) => vars[key] ?? match,
   137→  );
   138→}
   139→
   140→/**
   141→ * Human-readable trigger description for orientation context.
   142→ */
   143→function triggerDescription(trigger: string): string {
   144→  switch (trigger) {
   145→    case "task.ready":
   146→      return "New task assignment.";
   147→    case "task.in_progress":
   148→      return "Continuing in-progress work.";
   149→    case "task.needs_work":
   150→      return "Fix cycle \u2014 this task was kicked back from review. Address the feedback below.";
   151→    case "task.pending_review":
   152→      return "Task submitted for review.";
   153→    default:
   154→      return `Trigger: ${trigger}`;
   155→  }
   156→}
   157→
   158→/**
   159→ * Format recent notes for inclusion in dispatch prompts.
   160→ * Takes last N notes, truncates each to maxLen characters, strips newlines.
   161→ */
   162→function formatRecentNotes(
   163→  notes: Array<{ created_at: string; author?: string; content: string }>,
   164→  count = 3,
   165→  maxLen = 200,
   166→): string {
   167→  if (!notes || notes.length === 0) return "";
   168→  const recent = notes.slice(-count);
   169→  const lines = recent.map((n) => {
   170→    const date = n.created_at.slice(0, 10);
   171→    const author = n.author ? `@${n.author}` : "unknown";
   172→    const content = n.content.replace(/\n/g, " ").slice(0, maxLen);
   173→    return `- [${date}] ${author}: ${content}`;
   174→  });
   175→  return lines.join("\n");
   176→}
   177→
   178→/**
   179→ * Build orientation context block for a dispatch prompt.
   180→ * Provides the agent with task title, trigger meaning, and relevant context.
   181→ *
   182→ * AC: @agent-dispatch-engine ac-13, ac-14, ac-15
   183→ */
   184→export function buildOrientationContext(
   185→  taskRef: string,
   186→  trigger: string,
   187→  task?: {
   188→    title: string;
   189→    notes?: Array<{ created_at: string; author?: string; content: string }>;
   190→    review_url?: string;
   191→  },
   192→): string {
   193→  const title = task?.title ?? "(unavailable)";
   194→  const lines = [
   195→    "## Task Context",
   196→    `Task: ${taskRef} \u2014 "${title}"`,
   197→    `Trigger: ${triggerDescription(trigger)}`,
   198→  ];
   199→
   200→  // AC: @agent-dispatch-engine ac-14 - Include recent notes for fix cycles
   201→  if (trigger === "task.needs_work" && task?.notes && task.notes.length > 0) {
   202→    const noteText = formatRecentNotes(task.notes);
   203→    if (noteText) {
   204→      lines.push("", "Recent notes:", noteText);
   205→    }
   206→  }
   207→
   208→  // AC: @agent-dispatch-engine ac-15 - Include review URL for reviewer
   209→  if (trigger === "task.pending_review") {
   210→    const url = task?.review_url ?? "Not provided \u2014 find PR via task notes or git log.";
   211→    lines.push(`Review URL: ${url}`);
   212→  }
   213→
   214→  return lines.join("\n");
   215→}
   216→
   217→// ─── Types ───────────────────────────────────────────────────────────────────
   218→
   219→/**
   220→ * A state change event for a single task.
   221→ */
   222→export interface TaskStateChange {
   223→  taskId: string;
   224→  taskRef: string;
   225→  fromStatus: TaskStatus;
   226→  toStatus: TaskStatus;
   227→  timestamp: number;
   228→  /** Optional task data used for filter evaluation (AC-6) */
   229→  task?: LoadedTask;
   230→}
   231→
   232→/**
   233→ * An entry in the dispatch queue.
   234→ */
   235→interface QueueEntry {
   236→  agent: LoadedAgent;
   237→  change: TaskStateChange;
   238→  retryCount: number;
   239→  nextRetryAt: number;
   240→  /** When this entry was first enqueued (for wait-time display) */
   241→  enqueuedAtMs: number;
   242→  /** Monotonic sequence for deterministic tie-breaking */
   243→  sequence: number;
   244→}
   245→
   246→/**
   247→ * Tracking record for an active invocation.
   248→ * AC: @cli-agent-commands ac-6
   249→ */
   250→interface ActiveInvocationRecord {
   251→  invocationId: string;
   252→  sessionId: string;
   253→  agentId: string;
   254→  agentName: string;
   255→  taskRef: string | undefined;
   256→  startedAtMs: number;
   257→}
   258→
   259→/**
   260→ * Deduplication key for recent state changes.
   261→ * AC: @agent-dispatch-engine ac-7
   262→ */
   263→type DedupKey = `${string}:${string}:${string}`;
   264→
   265→/**
   266→ * Invocation lifecycle event payload.
   267→ * AC: @daemon-agent-dispatch ac-3, ac-4
   268→ */
   269→export interface InvocationEvent {
   270→  type: "started" | "completed" | "failed";
   271→  session_id: string;
   272→  agent_id: string;
   273→  task_id: string | undefined;
   274→  status: "started" | "completed" | "failed";
   275→  timestamp: number;
   276→}
   277→
   278→/**
   279→ * Options for creating a DispatchEngine.
   280→ */
   281→export interface DispatchEngineOptions {
   282→  /** Project root directory */
   283→  projectDir: string;
   284→  /**
   285→   * Spec directory (.kspec/ for shadow mode, or same as projectDir for traditional mode).
   286→   * Defaults to projectDir/.kspec if not specified.
   287→   */
   288→  specDir?: string;
   289→  /** Working directory for spawned agents */
   290→  cwd?: string;
   291→  /** Deduplication window in milliseconds (default 2000) */
   292→  dedupWindowMs?: number;
   293→  /**
   294→   * Periodic reconciliation interval in milliseconds (default 60000).
   295→   * Re-evaluates all task states against dispatch rules, enqueuing any that
   296→   * match but have no active or queued invocation. Set to 0 or null to disable.
   297→   * AC: @agent-dispatch-engine ac-20
   298→   */
   299→  reconcileIntervalMs?: number | null;
   300→  /** Path to kspec CLI binary (for task notes) */
   301→  kspecCliPath?: string;
   302→  /**
   303→   * Optional callback invoked on invocation lifecycle events (start, complete, fail).
   304→   * AC: @daemon-agent-dispatch ac-3, ac-4
   305→   */
   306→  onInvocationEvent?: (event: InvocationEvent) => void;
   307→  /**
   308→   * Optional callback invoked for each text chunk produced by a running agent.
   309→   * AC: @cli-agent-commands ac-13 (broadcast to watch subscribers)
   310→   * AC: @daemon-agent-dispatch ac-8
   311→   */
   312→  onTextChunk?: (sessionId: string, agentId: string, taskId: string | null, text: string) => void;
   313→}
   314→
   315→// ─── DispatchEngine ───────────────────────────────────────────────────────────
   316→
   317→/**
   318→ * The core dispatch runtime.
   319→ *
   320→ * Lifecycle:
   321→ *   1. Create with new DispatchEngine(options)
   322→ *   2. Call start() to bootstrap and begin processing
   323→ *   3. Feed state changes via handleStateChange()
   324→ *   4. Call stop() for graceful shutdown
   325→ *
   326→ * AC: @agent-dispatch-engine ac-1 through ac-12
   327→ */
   328→export class DispatchEngine {
   329→  private projectDir: string;
   330→  private specDir: string;
   331→  private cwd: string;
   332→  private dedupWindowMs: number;
   333→  private reconcileIntervalMs: number;
   334→  private kspecCliPath?: string;
   335→  private onInvocationEvent?: (event: InvocationEvent) => void;
   336→  private onTextChunk?: (sessionId: string, agentId: string, taskId: string | null, text: string) => void;
   337→
   338→  /** Queue of pending dispatch entries, per agent id */
   339→  private queues: Map<string, QueueEntry[]> = new Map();
   340→  /** Count of active (running) invocations per agent id */
   341→  private activeCount: Map<string, number> = new Map();
   342→  /** Recent dedup keys with their expiry timestamps */
   343→  private recentEvents: Map<DedupKey, number> = new Map();
   344→  /** Previous task states (for file watcher diffing) */
   345→  private prevTaskStates: Map<string, TaskStatus> = new Map();
   346→  /** Mutex serializing shadow branch mutations */
   347→  private shadowMutex = new Mutex();
   348→  /** Whether the engine is currently running */
   349→  private running = false;
   350→  /** Set of running invocation promises (for graceful shutdown) */
   351→  private runningInvocations: Set<Promise<void>> = new Set();
   352→  /** AbortControllers for active invocations (for graceful cancel on stop) */
   353→  private invocationAbortControllers: Set<AbortController> = new Set();
   354→  /** Per-invocation tracking records for status display */
   355→  private activeInvocationDetails: Map<string, ActiveInvocationRecord> = new Map();
   356→  /** Monotonic enqueue sequence for deterministic queue ordering */
   357→  private nextQueueSequence = 0;
   358→  /** Timer handle for periodic reconciliation. AC: @agent-dispatch-engine ac-20 */
   359→  private reconcileTimer: ReturnType<typeof setInterval> | null = null;
   360→
   361→  constructor(options: DispatchEngineOptions) {
   362→    this.projectDir = options.projectDir;
   363→    this.specDir = options.specDir ?? path.join(options.projectDir, ".kspec");
   364→    this.cwd = options.cwd ?? options.projectDir;
   365→    this.dedupWindowMs = options.dedupWindowMs ?? 2000;
   366→    this.reconcileIntervalMs = (options.reconcileIntervalMs === null || options.reconcileIntervalMs === 0)
   367→      ? 0
   368→      : (options.reconcileIntervalMs ?? 60_000);
   369→    this.kspecCliPath = options.kspecCliPath;
   370→    this.onInvocationEvent = options.onInvocationEvent;
   371→    this.onTextChunk = options.onTextChunk;
   372→  }
   373→
   374→  // ─── Public API ─────────────────────────────────────────────────────────────
   375→
   376→  /**
   377→   * Start the dispatch engine.
   378→   *
   379→   * Loads current task states and evaluates dispatch rules for bootstrap.
   380→   * AC: @agent-dispatch-engine ac-8
   381→   */
   382→  async start(): Promise<void> {
   383→    this.running = true;
   384→
   385→    // AC: @agent-dispatch-engine ac-8 - Bootstrap: evaluate existing task states
   386→    await this._bootstrap();
   387→
   388→    // AC: @agent-dispatch-engine ac-19, ac-20 - Start periodic reconciliation
   389→    if (this.reconcileIntervalMs > 0) {
   390→      this.reconcileTimer = setInterval(() => {
   391→        if (this.running) {
   392→          this._reconcile().catch((err) => {
   393→            console.error("[dispatch] Reconciliation error:", err);
   394→          });
   395→        }
   396→      }, this.reconcileIntervalMs);
   397→      this.reconcileTimer.unref();
   398→    }
   399→  }
   400→
   401→  /**
   402→   * Handle a task state change event from any source (file watcher or API).
   403→   *
   404→   * AC: @agent-dispatch-engine ac-1, ac-2, ac-4, ac-5, ac-6, ac-7
   405→   */
   406→  async handleStateChange(change: TaskStateChange): Promise<void> {
   407→    if (!this.running) return;
   408→
   409→    // AC: @agent-dispatch-engine ac-7 - Deduplication
   410→    if (this._isDuplicate(change)) {
   411→      return;
   412→    }
   413→    this._recordEvent(change);
   414→
   415→    // AC: @agent-dispatch-engine ac-1 - Match against dispatch rules
   416→    const agents = await this._loadAgents();
   417→    const eventType = STATUS_TO_EVENT[change.toStatus];
   418→    if (!eventType) return;
   419→
   420→    // Load task data for filter evaluation if not provided
   421→    let taskData = change.task;
   422→    if (!taskData && change.taskId) {
   423→      try {
   424→        const ctx = await initContext(this.projectDir);
   425→        const tasks = await loadAllTasks(ctx);
   426→        taskData = tasks.find((t) => t._ulid === change.taskId);
   427→      } catch {
   428→        // Can't load task, filter evaluation will be lenient
   429→      }
   430→    }
   431→    // Make loaded task available for prompt building (AC: @agent-dispatch-engine ac-13)
   432→    if (taskData && !change.task) {
   433→      change.task = taskData;
   434→    }
   435→
   436→    for (const agent of agents) {
   437→      for (const rule of (agent.dispatch ?? [])) {
   438→        if (rule.on !== eventType) continue;
   439→
   440→        // AC: @agent-dispatch-engine ac-6 - Apply filters
   441→        if (!this._matchesFilter(change, rule, taskData)) continue;
   442→
   443→        // AC: @agent-dispatch-engine ac-2 - Each matching agent queued independently
   444→        this._enqueue(agent, change);
   445→      }
   446→    }
   447→
   448→    // Drain queues after enqueuing
   449→    await this._drainQueues(agents);
   450→  }
   451→
   452→  /**
   453→   * Handle file watcher notification: diff previous vs current task states.
   454→   *
   455→   * AC: @agent-dispatch-engine ac-5
   456→   */
   457→  async handleFileChange(specDir: string): Promise<void> {
   458→    if (!this.running) return;
   459→
   460→    try {
   461→      const ctx = await initContext(this.projectDir);
   462→      const tasks = await loadAllTasks(ctx);
   463→
   464→      const changes: TaskStateChange[] = [];
   465→      const now = Date.now();
   466→
   467→      for (const task of tasks) {
   468→        const taskId = task._ulid;
   469→        const currentStatus = task.status as TaskStatus;
   470→        const prevStatus = this.prevTaskStates.get(taskId);
   471→
   472→        if (prevStatus !== undefined && prevStatus !== currentStatus) {
   473→          changes.push({
   474→            taskId,
   475→            taskRef: `@${taskId}`,
   476→            fromStatus: prevStatus,
   477→            toStatus: currentStatus,
   478→            timestamp: now,
   479→            task,
   480→          });
   481→        }
   482→
   483→        this.prevTaskStates.set(taskId, currentStatus);
   484→      }
   485→
   486→      // Emit change events for detected transitions
   487→      for (const change of changes) {
   488→        await this.handleStateChange(change);
   489→      }
   490→    } catch (err) {
   491→      console.error("[dispatch] Error processing file change:", err);
   492→    }
   493→  }
   494→
   495→  /**
   496→   * Stop the dispatch engine gracefully.
   497→   *
   498→   * Sends cancel signals to all active invocations and waits for them to finish.
   499→   * AC: @agent-dispatch-engine ac-11
   500→   */
   501→  async stop(): Promise<void> {
   502→    this.running = false;
   503→
   504→    // AC: @agent-dispatch-engine ac-20 - Stop periodic reconciliation
   505→    if (this.reconcileTimer !== null) {
   506→      clearInterval(this.reconcileTimer);
   507→      this.reconcileTimer = null;
   508→    }
   509→
   510→    // AC: @agent-dispatch-engine ac-11 - Send graceful cancel to all active invocations
   511→    for (const controller of this.invocationAbortControllers) {
   512→      controller.abort();
   513→    }
   514→
   515→    // Wait for all running invocations to complete (or abort)
   516→    if (this.runningInvocations.size > 0) {
   517→      await Promise.allSettled(Array.from(this.runningInvocations));
   518→    }
   519→
   520→    this.queues.clear();
   521→    this.activeCount.clear();
   522→    this.recentEvents.clear();
   523→    this.invocationAbortControllers.clear();
   524→    this.activeInvocationDetails.clear();
   525→  }
   526→
   527→  /**
   528→   * Get the shadow mutex for external callers that need to serialize mutations.
   529→   * AC: @agent-dispatch-engine ac-12
   530→   */
   531→  getShadowMutex(): Mutex {
   532→    return this.shadowMutex;
   533→  }
   534→
   535→  /**
   536→   * Returns current engine status info including per-invocation details.
   537→   * AC: @cli-agent-commands ac-6
   538→   */
   539→  getStatus(): {
   540→    running: boolean;
   541→    activeInvocations: number;
   542→    queuedInvocations: number;
   543→    invocations: Array<{
   544→      invocationId: string;
   545→      sessionId: string;
   546→      agentId: string;
   547→      agentName: string;
   548→      taskRef: string | undefined;
   549→      elapsedMs: number;
   550→    }>;
   551→    queued: Array<{
   552→      agentId: string;
   553→      agentName: string;
   554→      taskRef: string | undefined;
   555→      waitMs: number;
   556→    }>;
   557→  } {
   558→    let active = 0;
   559→    let queued = 0;
   560→    for (const count of this.activeCount.values()) active += count;
   561→    for (const entries of this.queues.values()) queued += entries.length;
   562→    const now = Date.now();
   563→    const invocations = Array.from(this.activeInvocationDetails.values()).map((r) => ({
   564→      invocationId: r.invocationId,
   565→      sessionId: r.sessionId,
   566→      agentId: r.agentId,
   567→      agentName: r.agentName,
   568→      taskRef: r.taskRef,
   569→      elapsedMs: now - r.startedAtMs,
   570→    }));
   571→    const queuedItems = Array.from(this.queues.values()).flatMap((entries) =>
   572→      entries.map((e) => ({
   573→        agentId: e.agent.id,
   574→        agentName: e.agent.name,
   575→        taskRef: e.change.taskRef,
   576→        waitMs: now - e.enqueuedAtMs,
   577→      })),
   578→    );
   579→    return { running: this.running, activeInvocations: active, queuedInvocations: queued, invocations, queued: queuedItems };
   580→  }
   581→
   582→  // ─── Private helpers ─────────────────────────────────────────────────────────
   583→
   584→  /**
   585→   * Bootstrap: evaluate all current tasks against dispatch rules.
   586→   * AC: @agent-dispatch-engine ac-8
   587→   */
   588→  private async _bootstrap(): Promise<void> {
   589→    try {
   590→      const enqueued = await this._evaluateAllTasks({ skipIfActive: false });
   591→      if (enqueued > 0) {
   592→        const agents = await this._loadAgents();
   593→        await this._drainQueues(agents);
   594→      }
   595→    } catch (err) {
   596→      console.error("[dispatch] Bootstrap error:", err);
   597→    }
   598→  }
   599→
   600→  /**
   601→   * Periodic reconciliation: re-evaluate all task states against dispatch rules.
   602→   * Enqueues tasks that match but have no active or queued invocation.
   603→   * AC: @agent-dispatch-engine ac-19
   604→   */
   605→  private async _reconcile(): Promise<void> {
   606→    const enqueued = await this._evaluateAllTasks({ skipIfActive: true });
   607→    if (enqueued > 0) {
   608→      console.log(`[dispatch] Reconciliation enqueued ${enqueued} task(s)`);
   609→      const agents = await this._loadAgents();
   610→      await this._drainQueues(agents);
   611→    }
   612→  }
   613→
   614→  /**
   615→   * Shared logic for bootstrap and reconciliation: load all tasks, seed
   616→   * prevTaskStates, and enqueue tasks matching agent dispatch rules.
   617→   *
   618→   * When skipIfActive is true (reconciliation), tasks with an existing
   619→   * active or queued invocation are skipped.
   620→   *
   621→   * AC: @agent-dispatch-engine ac-8, ac-19
   622→   */
   623→  private async _evaluateAllTasks(opts: { skipIfActive: boolean }): Promise<number> {
   624→    const ctx = await initContext(this.projectDir);
   625→    const tasks = await loadAllTasks(ctx);
   626→    const agents = await this._loadAgents();
   627→    const now = Date.now();
   628→    let enqueued = 0;
   629→
   630→    // Seed/update prevTaskStates so file watcher diffs work correctly
   631→    for (const task of tasks) {
   632→      this.prevTaskStates.set(task._ulid, task.status as TaskStatus);
   633→    }
   634→
   635→    for (const task of tasks) {
   636→      const currentStatus = task.status as TaskStatus;
   637→      const eventType = STATUS_TO_EVENT[currentStatus];
   638→      if (!eventType) continue;
   639→
   640→      for (const agent of agents) {
   641→        for (const rule of (agent.dispatch ?? [])) {
   642→          if (rule.on !== eventType) continue;
   643→
   644→          const change: TaskStateChange = {
   645→            taskId: task._ulid,
   646→            taskRef: `@${task._ulid}`,
   647→            fromStatus: currentStatus,
   648→            toStatus: currentStatus,
   649→            timestamp: now,
   650→            task,
   651→          };
   652→
   653→          if (!this._matchesFilter(change, rule, task)) continue;
   654→          if (opts.skipIfActive && this._hasActiveOrQueuedInvocation(agent.id, task._ulid)) continue;
   655→
   656→          this._enqueue(agent, change);
   657→          enqueued++;
   658→        }
   659→      }
   660→    }
   661→
   662→    return enqueued;
   663→  }
   664→
   665→  /**
   666→   * Check if an agent already has an active or queued invocation for a task.
   667→   * AC: @agent-dispatch-engine ac-19
   668→   */
   669→  private _hasActiveOrQueuedInvocation(agentId: string, taskId: string): boolean {
   670→    // Check active invocations
   671→    for (const record of this.activeInvocationDetails.values()) {
   672→      if (record.agentId === agentId && record.taskRef === `@${taskId}`) {
   673→        return true;
   674→      }
   675→    }
   676→    // Check queued entries
   677→    const queue = this.queues.get(agentId) ?? [];
   678→    return queue.some((entry) => entry.change.taskId === taskId);
   679→  }
   680→
   681→  /**
   682→   * Load agent definitions from meta context.
   683→   */
   684→  private async _loadAgents(): Promise<LoadedAgent[]> {
   685→    try {
   686→      const ctx = await initContext(this.projectDir);
   687→      const meta = await loadMetaContext(ctx);
   688→      return meta.agents;
   689→    } catch {
   690→      return [];
   691→    }
   692→  }
   693→
   694→  /**
   695→   * Check if a state change matches a dispatch rule's filters.
   696→   * AC: @agent-dispatch-engine ac-6
   697→   * AC: @agent-dispatch-engine ac-21
   698→   */
   699→  private _matchesFilter(
   700→    change: TaskStateChange,
   701→    rule: AgentDispatchRule,
   702→    task?: LoadedTask,
   703→  ): boolean {
   704→    // AC: @agent-dispatch-engine ac-21 — default to automation: eligible for
   705→    // task.ready and task.needs_work when no filter is specified
   706→    const defaultsToEligible =
   707→      rule.on === "task.ready" || rule.on === "task.needs_work";
   708→    if (!rule.filter && !defaultsToEligible) return true;
   709→
   710→    // We need the task to evaluate filters — if not provided, reject to avoid
   711→    // enqueuing non-matching tasks (AC-6: all filters must match)
   712→    if (!task) return false;
   713→
   714→    const filter: AgentDispatchFilter = rule.filter ?? {};
   715→
   716→    // Apply default automation filter for task.ready/task.needs_work
   717→    const effectiveAutomation =
   718→      filter.automation ?? (defaultsToEligible ? "eligible" : undefined);
   719→
   720→    // Automation filter
   721→    if (effectiveAutomation !== undefined) {
   722→      if ((task as LoadedTask & { automation?: string }).automation !== effectiveAutomation) {
   723→        return false;
   724→      }
   725→    }
   726→
   727→    // Tags filter
   728→    if (filter.tags && filter.tags.length > 0) {
   729→      const taskTags: string[] = (task as LoadedTask & { tags?: string[] }).tags ?? [];
   730→      if (!filter.tags.every((tag) => taskTags.includes(tag))) {
   731→        return false;
   732→      }
   733→    }
   734→
   735→    // Priority filter — threshold semantics: task priority at or above (numerically <=)
   736→    // AC: @ui-agent-dispatch ac-8
   737→    if (filter.priority !== undefined) {
   738→      const taskPriority = (task as LoadedTask & { priority?: number }).priority;
   739→      if (taskPriority === undefined || taskPriority > filter.priority) {
   740→        return false;
   741→      }
   742→    }
   743→
   744→    return true;
   745→  }
   746→
   747→  /**
   748→   * Build a deduplication key for a state change.
   749→   * AC: @agent-dispatch-engine ac-7
   750→   */
   751→  private _dedupKey(change: TaskStateChange): DedupKey {
   752→    return `${change.taskId}:${change.fromStatus}:${change.toStatus}`;
   753→  }
   754→
   755→  /**
   756→   * Check whether this event is a duplicate within the dedup window.
   757→   * AC: @agent-dispatch-engine ac-7
   758→   */
   759→  private _isDuplicate(change: TaskStateChange): boolean {
   760→    const key = this._dedupKey(change);
   761→    const expiry = this.recentEvents.get(key);
   762→    if (expiry === undefined) return false;
   763→    return change.timestamp < expiry;
   764→  }
   765→
   766→  /**
   767→   * Record a state change for deduplication.
   768→   * AC: @agent-dispatch-engine ac-7
   769→   */
   770→  private _recordEvent(change: TaskStateChange): void {
   771→    const key = this._dedupKey(change);
   772→    this.recentEvents.set(key, change.timestamp + this.dedupWindowMs);
   773→
   774→    // Prune expired entries periodically
   775→    if (this.recentEvents.size > 1000) {
   776→      const now = Date.now();
   777→      for (const [k, expiry] of this.recentEvents) {
   778→        if (expiry < now) this.recentEvents.delete(k);
   779→      }
   780→    }
   781→  }
   782→
   783→  /**
   784→   * Enqueue a dispatch entry for an agent.
   785→   * AC: @agent-dispatch-engine ac-3
   786→   */
   787→  private _enqueue(agent: LoadedAgent, change: TaskStateChange): void {
   788→    const queue = this.queues.get(agent.id) ?? [];
   789→    const entry: QueueEntry = {
   790→      agent,
   791→      change,
   792→      retryCount: 0,
   793→      nextRetryAt: 0,
   794→      enqueuedAtMs: Date.now(),
   795→      sequence: this.nextQueueSequence++,
   796→    };
   797→    this._insertQueueEntry(queue, entry);
   798→    this.queues.set(agent.id, queue);
   799→  }
   800→
   801→  /**
   802→   * Insert an entry into an agent queue using deterministic status precedence.
   803→   * AC: @dispatch-in-progress-priority ac-1
   804→   */
   805→  private _insertQueueEntry(queue: QueueEntry[], entry: QueueEntry): void {
   806→    const insertAt = queue.findIndex((queued) => this._compareQueueEntries(entry, queued) < 0);
   807→    if (insertAt === -1) {
   808→      queue.push(entry);
   809→      return;
   810→    }
   811→    queue.splice(insertAt, 0, entry);
   812→  }
   813→
   814→  /**
   815→   * Compare queue entries by dispatch precedence, then by enqueue sequence.
   816→   * AC: @dispatch-in-progress-priority ac-1
   817→   */
   818→  private _compareQueueEntries(a: QueueEntry, b: QueueEntry): number {
   819→    const statusDelta = STATUS_PRECEDENCE[a.change.toStatus] - STATUS_PRECEDENCE[b.change.toStatus];
   820→    if (statusDelta !== 0) return statusDelta;
   821→    return a.sequence - b.sequence;
   822→  }
   823→
   824→  /**
   825→   * Drain queues, spawning invocations up to each agent's max_concurrent limit.
   826→   * AC: @agent-dispatch-engine ac-3, ac-17
   827→   */
   828→  private async _drainQueues(agents: LoadedAgent[]): Promise<void> {
   829→    // Prevent new invocation starts during/after shutdown.
   830→    if (!this.running) return;
   831→
   832→    // AC: @agent-dispatch-engine ac-17 - Load current task states once for staleness checks
   833→    let currentTaskStates: Map<string, TaskStatus> | undefined;
   834→    try {
   835→      const ctx = await initContext(this.projectDir);
   836→      const tasks = await loadAllTasks(ctx);
   837→      currentTaskStates = new Map(
   838→        tasks.map((t) => [t._ulid, t.status as TaskStatus]),
   839→      );
   840→    } catch {
   841→      // If we can't load tasks, skip staleness checks (best effort)
   842→    }
   843→
   844→    for (const agent of agents) {
   845→      const maxConcurrent = agent.concurrency?.max_concurrent ?? 1;
   846→      const active = this.activeCount.get(agent.id) ?? 0;
   847→      const queue = this.queues.get(agent.id) ?? [];
   848→
   849→      // AC: @agent-dispatch-engine ac-17 - Discard stale entries before spawning.
   850→      // Only discard when we have positive evidence the task moved: either the task
   851→      // exists on disk with a different status, or the task was previously tracked
   852→      // (in prevTaskStates) but is no longer found (deleted).
   853→      if (currentTaskStates) {
   854→        const before = queue.length;
   855→        for (let i = queue.length - 1; i >= 0; i--) {
   856→          const entry = queue[i];
   857→          const currentStatus = currentTaskStates.get(entry.change.taskId);
   858→          const expectedEvent = STATUS_TO_EVENT[entry.change.toStatus];
   859→          if (!expectedEvent) continue; // No event mapping — skip check
   860→          if (currentStatus === undefined) {
   861→            // Task not on disk — only discard if we previously knew about it
   862→            // (it was deleted). Tasks from pure handleStateChange events without
   863→            // on-disk presence should still be processed.
   864→            if (this.prevTaskStates.has(entry.change.taskId)) {
   865→              queue.splice(i, 1);
   866→            }
   867→          } else {
   868→            const currentEvent = STATUS_TO_EVENT[currentStatus];
   869→            if (currentEvent !== expectedEvent) {
   870→              queue.splice(i, 1);
   871→            }
   872→          }
   873→        }
   874→        if (before > queue.length) {
   875→          console.log(
   876→            `[dispatch] Discarded ${before - queue.length} stale queue entries for agent "${agent.id}"`,
   877→          );
   878→        }
   879→      }
   880→
   881→      let slots = maxConcurrent - active;
   882→      while (slots > 0 && queue.length > 0) {
   883→        const now = Date.now();
   884→        const nextReadyIndex = queue.findIndex((entry) => entry.nextRetryAt <= now);
   885→        if (nextReadyIndex === -1) {
   886→          break;
   887→        }
   888→        const [entry] = queue.splice(nextReadyIndex, 1);
   889→        const spawned = this._spawnInvocation(agent, entry);
   890→        if (spawned) slots--;
   891→      }
   892→
   893→      this.queues.set(agent.id, queue);
   894→    }
   895→  }
   896→
   897→  /**
   898→   * Build dispatch-mode prompt guardrails to keep autonomous agents from
   899→   * stopping with handoff text instead of performing required actions.
   900→   *
   901→   * AC: @agent-dispatch-engine ac-13, ac-14, ac-15, ac-16
   902→   */
   903→  private _buildDispatchPrompt(agent: LoadedAgent, change: TaskStateChange): string {
   904→    const trigger = (STATUS_TO_EVENT[change.toStatus] ?? "task.ready") as SessionTrigger;
   905→    const taskRef = change.taskRef;
   906→
   907→    // AC: @agent-dispatch-engine ac-16 - Interpolate prompt_template variables
   908→    const templateVars: Record<string, string> = {
   909→      task_ref: taskRef,
   910→      task_title: change.task?.title ?? "(unavailable)",
   911→      trigger,
   912→      review_url: change.task?.review_url ?? "",
   913→    };
   914→    const rawTemplate = agent.prompt_template ?? `Work on task ${taskRef}`;
   915→    const basePrompt = interpolateTemplate(rawTemplate, templateVars);
   916→
   917→    // AC: @agent-dispatch-engine ac-13 - Orientation context
   918→    const orientation = buildOrientationContext(taskRef, trigger, change.task);
   919→
   920→    const autonomousPreamble = [
   921→      "AUTONOMOUS DISPATCH MODE (no interactive user is available).",
   922→      "- Do not ask for confirmation, approval, or next-step handoff.",
   923→      "- Execute required commands directly in this invocation.",
   924→      "- Do not end your turn with a recommendations-only summary. Perform the next required action yourself.",
   925→      "- Do not end your turn until the expected task transition is complete, or you have explicitly blocked the task with `kspec task block <task> --reason \"...\"`.",
   926→      "- If you find an open PR/branch from a different task, create or switch to a dedicated branch for this task before committing to avoid PR conflation.",
   927→    ];
   928→
   929→    const triggerSpecific =
   930→      trigger === "task.pending_review"
   931→        ? [
   932→            `Review flow completion criteria for ${taskRef}:`,
   933→            "- Execute your configured review workflow directly (no handoff).",
   934→            `- If blocking issues are found, transition ${taskRef} out of pending_review appropriately (for example needs_work).`,
   935→            `- If review gates are clean, perform your workflow's completion actions directly in this invocation.`,
   936→          ]
   937→        : [
   938→            `Work flow completion criteria for ${taskRef}:`,
   939→            "- Execute your configured work workflow directly (no handoff).",
   940→            `- Perform the required commands to move ${taskRef} to the next appropriate state in this same invocation.`,
   941→            "- If your workflow includes git or PR steps, execute them directly instead of deferring to a human.",
   942→          ];
   943→
   944→    return `${basePrompt}\n\n${orientation}\n\n${autonomousPreamble.join("\n")}\n\n${triggerSpecific.join("\n")}`;
   945→  }
   946→
   947→  /**
   948→   * Spawn a single invocation for a queue entry.
   949→   * Returns true if an invocation was actually started, false if skipped.
   950→   * AC: @agent-dispatch-engine ac-9, ac-10, ac-11, ac-12
   951→   */
   952→  private _spawnInvocation(agent: LoadedAgent, entry: QueueEntry): boolean {
   953→    const agentId = agent.id;
   954→
   955→    // Increment active count
   956→    this.activeCount.set(agentId, (this.activeCount.get(agentId) ?? 0) + 1);
   957→
   958→    // AC: @agent-dispatch-engine ac-10 - Check adapter resolvability before spawn
   959→    const adapterId = agent.adapter ?? "claude-agent-acp";
   960→    const adapter = getAdapter(adapterId);
   961→    if (!adapter) {
   962→      console.error(
   963→        `[dispatch] Cannot resolve adapter "${adapterId}" for agent "${agentId}". Skipping invocation.`,
   964→      );
   965→      // Decrement active count since we're not actually running
   966→      const currentActive = this.activeCount.get(agentId) ?? 1;
   967→      this.activeCount.set(agentId, Math.max(0, currentActive - 1));
   968→      // AC: @agent-dispatch-engine ac-10 - Add task note for unresolvable adapter
   969→      if (this.kspecCliPath) {
   970→        spawnSync(process.execPath, [
   971→          this.kspecCliPath,
   972→          "task", "note", entry.change.taskRef,
   973→          `[AGENT-SKIP] Cannot resolve adapter "${adapterId}" for agent "${agentId}". Invocation skipped.`,
   974→        ], { cwd: this.cwd });
   975→      }
   976→      return false;
   977→    }
   978→
   979→    // AC: @agent-dispatch-engine ac-11 - Create abort controller for graceful cancellation
   980→    const abortController = new AbortController();
   981→    this.invocationAbortControllers.add(abortController);
   982→
   983→    // AC: @cli-agent-commands ac-6 - Pre-assign session ID for status tracking
   984→    const preSessionId = ulid();
   985→    const invocationId = ulid();
   986→    const trackingRecord: ActiveInvocationRecord = {
   987→      invocationId,
   988→      sessionId: preSessionId,
   989→      agentId,
   990→      agentName: agent.name,
   991→      taskRef: entry.change.taskRef,
   992→      startedAtMs: Date.now(),
   993→    };
   994→    this.activeInvocationDetails.set(invocationId, trackingRecord);
   995→
   996→    // AC: @daemon-agent-dispatch ac-3, ac-4 - Emit started event
   997→    this.onInvocationEvent?.({
   998→      type: "started",
   999→      session_id: preSessionId,
  1000→      agent_id: agentId,
  1001→      task_id: entry.change.taskRef,
  1002→      status: "started",
  1003→      timestamp: Date.now(),
  1004→    });
  1005→
  1006→    // AC: @cli-agent-commands ac-13, @daemon-agent-dispatch ac-8 - stream text chunks to watchers
  1007→    const taskId = entry.change.taskRef ?? null;
  1008→    const onUpdate = this.onTextChunk
  1009→      ? (update: import("../acp/index.js").SessionUpdate) => {
  1010→          if (
  1011→            update.sessionUpdate === "agent_message_chunk" &&
  1012→            update.content.type === "text"
  1013→          ) {
  1014→            this.onTextChunk!(preSessionId, agentId, taskId, update.content.text);
  1015→            return;
  1016→          }
  1017→          // Non-text updates (especially tool events) delimit logical message runs.
  1018→          // Emit an empty sentinel so watch renderers can end the current line
  1019→          // without needing to infer boundaries from prose punctuation.
  1020→          this.onTextChunk!(preSessionId, agentId, taskId, "");
  1021→        }
  1022→      : undefined;
  1023→
  1024→    const options: InvocationOptions = {
  1025→      agent,
  1026→      specDir: this.specDir,
  1027→      cwd: this.cwd,
  1028→      taskRef: entry.change.taskRef,
  1029→      prompt: this._buildDispatchPrompt(agent, entry.change),
  1030→      trigger: (STATUS_TO_EVENT[entry.change.toStatus] ?? "task.ready") as SessionTrigger,
  1031→      kspecCliPath: this.kspecCliPath,
  1032→      abortSignal: abortController.signal,
  1033→      sessionId: preSessionId,
  1034→      onUpdate,
  1035→    };
  1036→
  1037→    // AC: @agent-dispatch-engine ac-12 - Wrap invocation in shadow mutex
  1038→    const invocationPromise = this.shadowMutex
  1039→      .runExclusive(async () => {
  1040→        // AC: @agent-dispatch-engine ac-9 - Retry on transient errors
  1041→        try {
  1042→          await runInvocation(options);
  1043→          // Reset retry count on success
  1044→          entry.retryCount = 0;
  1045→          // AC: @daemon-agent-dispatch ac-3, ac-4 - Emit completed event
  1046→          this.onInvocationEvent?.({
  1047→            type: "completed",
  1048→            session_id: preSessionId,
  1049→            agent_id: agentId,
  1050→            task_id: entry.change.taskRef,
  1051→            status: "completed",
  1052→            timestamp: Date.now(),
  1053→          });
  1054→        } catch (err) {
  1055→          const retryLimit = agent.budget?.max_retries ?? 3;
  1056→          if (entry.retryCount < retryLimit) {
  1057→            entry.retryCount++;
  1058→            const backoffMs = Math.min(
  1059→              1000 * Math.pow(2, entry.retryCount - 1),
  1060→              30_000,
  1061→            );
  1062→            entry.nextRetryAt = Date.now() + backoffMs;
  1063→            console.warn(
  1064→              `[dispatch] Invocation for agent "${agentId}" failed (attempt ${entry.retryCount}/${retryLimit}), retrying in ${backoffMs}ms`,
  1065→              err,
  1066→            );
  1067→            // Re-enqueue for retry while preserving status precedence ordering.
  1068→            const queue = this.queues.get(agentId) ?? [];
  1069→            this._insertQueueEntry(queue, entry);
  1070→            this.queues.set(agentId, queue);
  1071→            // AC: @agent-dispatch-engine ac-9 - Schedule wake-up to drain retry
  1072→            setTimeout(() => {
  1073→              if (this.running) {
  1074→                this._loadAgents()
  1075→                  .then((agents) => this._drainQueues(agents))
  1076→                  .catch(() => {/* best effort */});
  1077→              }
  1078→            }, backoffMs);
  1079→          } else {
  1080→            console.error(
  1081→              `[dispatch] Agent "${agentId}" exceeded retry limit. Dropping invocation.`,
  1082→              err,
  1083→            );
  1084→            // AC: @daemon-agent-dispatch ac-3, ac-4 - Emit failed event when retry limit exceeded
  1085→            this.onInvocationEvent?.({
  1086→              type: "failed",
  1087→              session_id: preSessionId,
  1088→              agent_id: agentId,
  1089→              task_id: entry.change.taskRef,
  1090→              status: "failed",
  1091→              timestamp: Date.now(),
  1092→            });
  1093→          }
  1094→        }
  1095→      })
  1096→      .then(async () => {
  1097→        // Decrement active count and drain again
  1098→        const currentActive = this.activeCount.get(agentId) ?? 1;
  1099→        this.activeCount.set(agentId, Math.max(0, currentActive - 1));
  1100→
  1101→        if (!this.running) return;
  1102→
  1103→        // Try to drain more items
  1104→        try {
  1105→          const agents = await this._loadAgents();
  1106→          await this._drainQueues(agents);
  1107→        } catch {
  1108→          // Best effort
  1109→        }
  1110→      })
  1111→      .finally(() => {
  1112→        this.runningInvocations.delete(invocationPromise);
  1113→        this.invocationAbortControllers.delete(abortController);
  1114→        this.activeInvocationDetails.delete(invocationId);
  1115→      });
  1116→
  1117→    this.runningInvocations.add(invocationPromise);
  1118→    return true;
  1119→  }
  1120→}
  1121→
```