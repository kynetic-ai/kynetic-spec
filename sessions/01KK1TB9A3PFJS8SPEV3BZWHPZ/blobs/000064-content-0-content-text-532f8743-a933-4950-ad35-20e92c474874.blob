```
     1→<!--
     2→  AC: @ui-dashboard-overview ac-1 — Dashboard home view
     3→  Active work section, status summary, needs-attention aggregation.
     4→-->
     5→<script lang="ts">
     6→	import { onMount, onDestroy } from 'svelte';
     7→	import { goto } from '$app/navigation';
     8→	import { base } from '$app/paths';
     9→	import {
    10→		fetchTasks,
    11→		fetchInbox,
    12→		fetchObservations,
    13→		fetchValidation,
    14→		fetchAgentStatus,
    15→		type AgentDispatchStatus,
    16→		type ActiveInvocation
    17→	} from '$lib/api';
    18→	import { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';
    19→	import { Badge } from '$lib/components/ui/badge';
    20→	import { Skeleton } from '$lib/components/ui/skeleton';
    21→	import { getProjectVersion } from '$lib/stores/project.svelte';
    22→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    23→	import { isStaticMode } from '$lib/stores/mode.svelte';
    24→	import AlertTriangle from '@lucide/svelte/icons/triangle-alert';
    25→	import InboxIcon from '@lucide/svelte/icons/inbox';
    26→	import Eye from '@lucide/svelte/icons/eye';
    27→	import ShieldAlert from '@lucide/svelte/icons/shield-alert';
    28→	import Ban from '@lucide/svelte/icons/ban';
    29→	import Activity from '@lucide/svelte/icons/activity';
    30→	import Bot from '@lucide/svelte/icons/bot';
    31→	import ExternalLink from '@lucide/svelte/icons/external-link';
    32→
    33→	// --- State ---
    34→	let loading = $state(true);
    35→	let error = $state<string | null>(null);
    36→
    37→	// Task counts
    38→	interface TaskCounts {
    39→		ready: number;
    40→		in_progress: number;
    41→		needs_work: number;
    42→		pending_review: number;
    43→		blocked: number;
    44→		completed: number;
    45→		cancelled: number;
    46→	}
    47→
    48→	let counts = $state<TaskCounts>({
    49→		ready: 0,
    50→		in_progress: 0,
    51→		needs_work: 0,
    52→		pending_review: 0,
    53→		blocked: 0,
    54→		completed: 0,
    55→		cancelled: 0
    56→	});
    57→
    58→	// Active work
    59→	let agentStatus = $state<AgentDispatchStatus | null>(null);
    60→	let taskTitles = $state<Record<string, string>>({});
    61→
    62→	let hasActiveWork = $derived(
    63→		agentStatus?.dispatch_enabled && (agentStatus?.active_invocations?.length ?? 0) > 0
    64→	);
    65→
    66→	// Needs attention
    67→	let inboxUntriaged = $state(0);
    68→	let observationsUnresolved = $state(0);
    69→	let validationWarnings = $state(0);
    70→	let blockedTasks = $state(0);
    71→
    72→	let totalAttention = $derived(
    73→		inboxUntriaged + observationsUnresolved + validationWarnings + blockedTasks
    74→	);
    75→
    76→	// --- Status config with design system tokens ---
    77→	// AC: @ui-dashboard-overview ac-1 — clickable count cards per status
    78→	const statusConfig = [
    79→		{
    80→			key: 'ready' as const,
    81→			label: 'Ready',
    82→			dotClass: 'bg-status-pending',
    83→			filterStatus: 'pending'
    84→		},
    85→		{
    86→			key: 'in_progress' as const,
    87→			label: 'In Progress',
    88→			dotClass: 'bg-status-in-progress',
    89→			filterStatus: 'in_progress'
    90→		},
    91→		{
    92→			key: 'needs_work' as const,
    93→			label: 'Needs Work',
    94→			dotClass: 'bg-status-needs-work',
    95→			filterStatus: 'needs_work'
    96→		},
    97→		{
    98→			key: 'pending_review' as const,
    99→			label: 'Review',
   100→			dotClass: 'bg-status-pending-review',
   101→			filterStatus: 'pending_review'
   102→		},
   103→		{
   104→			key: 'blocked' as const,
   105→			label: 'Blocked',
   106→			dotClass: 'bg-status-blocked',
   107→			filterStatus: 'blocked'
   108→		},
   109→		{
   110→			key: 'completed' as const,
   111→			label: 'Completed',
   112→			dotClass: 'bg-status-completed',
   113→			filterStatus: 'completed'
   114→		},
   115→		{
   116→			key: 'cancelled' as const,
   117→			label: 'Cancelled',
   118→			dotClass: 'bg-status-cancelled',
   119→			filterStatus: 'cancelled'
   120→		}
   121→	];
   122→
   123→	// --- Needs attention items config ---
   124→	const attentionItems = $derived([
   125→		{
   126→			key: 'inbox',
   127→			label: 'Untriaged inbox',
   128→			count: inboxUntriaged,
   129→			icon: InboxIcon,
   130→			href: `${base}/inbox`,
   131→			colorClass: 'text-status-pending-review'
   132→		},
   133→		{
   134→			key: 'observations',
   135→			label: 'Unresolved observations',
   136→			count: observationsUnresolved,
   137→			icon: Eye,
   138→			href: `${base}/observations`,
   139→			colorClass: 'text-status-in-progress'
   140→		},
   141→		{
   142→			key: 'validation',
   143→			label: 'Validation warnings',
   144→			count: validationWarnings,
   145→			icon: ShieldAlert,
   146→			href: `${base}/validate`,
   147→			colorClass: 'text-status-needs-work'
   148→		},
   149→		{
   150→			key: 'blocked',
   151→			label: 'Blocked tasks',
   152→			count: blockedTasks,
   153→			icon: Ban,
   154→			href: `${base}/tasks?status=blocked`,
   155→			colorClass: 'text-status-blocked'
   156→		}
   157→	]);
   158→
   159→	// --- Elapsed time formatting ---
   160→	function formatElapsed(ms: number): string {
   161→		const secs = Math.floor(ms / 1000);
   162→		const mins = Math.floor(secs / 60);
   163→		const hours = Math.floor(mins / 60);
   164→		if (hours > 0) return `${hours}h ${mins % 60}m`;
   165→		if (mins > 0) return `${mins}m ${secs % 60}s`;
   166→		return `${secs}s`;
   167→	}
   168→
   169→	// --- Data loading ---
   170→	async function loadDashboard() {
   171→		loading = true;
   172→		error = null;
   173→
   174→		try {
   175→			const [tasksResponse, inboxResponse, obsResponse, validationResult, agentStatusResult] =
   176→				await Promise.all([
   177→					fetchTasks({ limit: 1000 }),
   178→					fetchInbox({ limit: 0 }),
   179→					fetchObservations({ resolved: false }),
   180→					fetchValidation().catch(() => null),
   181→					isStaticMode()
   182→						? Promise.resolve(null)
   183→						: fetchAgentStatus().catch(() => null)
   184→				]);
   185→
   186→			// Compute task counts
   187→			const tasks = tasksResponse.items;
   188→			const newCounts: TaskCounts = {
   189→				ready: 0,
   190→				in_progress: 0,
   191→				needs_work: 0,
   192→				pending_review: 0,
   193→				blocked: 0,
   194→				completed: 0,
   195→				cancelled: 0
   196→			};
   197→
   198→			const completedRefs = new Set(
   199→				tasks
   200→					.filter((t) => t.status === 'completed')
   201→					.flatMap((t) => [t._ulid, ...(t.slugs || [])])
   202→			);
   203→
   204→			const titles: Record<string, string> = {};
   205→
   206→			for (const task of tasks) {
   207→				// Build task titles for active fleet
   208→				if (task.slugs?.length) {
   209→					for (const slug of task.slugs) {
   210→						titles[`@${slug}`] = task.title;
   211→					}
   212→				}
   213→				titles[`@${task._ulid}`] = task.title;
   214→
   215→				switch (task.status) {
   216→					case 'completed':
   217→						newCounts.completed++;
   218→						break;
   219→					case 'in_progress':
   220→						newCounts.in_progress++;
   221→						break;
   222→					case 'pending_review':
   223→						newCounts.pending_review++;
   224→						break;
   225→					case 'blocked':
   226→						newCounts.blocked++;
   227→						break;
   228→					case 'needs_work':
   229→						newCounts.needs_work++;
   230→						break;
   231→					case 'cancelled':
   232→						newCounts.cancelled++;
   233→						break;
   234→					case 'pending': {
   235→						const deps = task.depends_on || [];
   236→						const hasUnmetDeps = deps.some((dep: string) => {
   237→							const ref = dep.startsWith('@') ? dep.slice(1) : dep;
   238→							return !completedRefs.has(ref);
   239→						});
   240→						if (hasUnmetDeps) {
   241→							newCounts.blocked++;
   242→						} else {
   243→							newCounts.ready++;
   244→						}
   245→						break;
   246→					}
   247→				}
   248→			}
   249→
   250→			counts = newCounts;
   251→			taskTitles = titles;
   252→			blockedTasks = newCounts.blocked;
   253→
   254→			// Inbox count
   255→			inboxUntriaged = inboxResponse.total;
   256→
   257→			// Observations: unresolved count
   258→			observationsUnresolved = obsResponse.total;
   259→
   260→			// Validation warnings
   261→			if (validationResult) {
   262→				validationWarnings =
   263→					validationResult.refWarnings.length +
   264→					validationResult.completenessWarnings.length +
   265→					validationResult.schemaErrors.length +
   266→					validationResult.refErrors.length;
   267→			}
   268→
   269→			// Agent status
   270→			if (agentStatusResult) {
   271→				agentStatus = agentStatusResult;
   272→			}
   273→		} catch (err) {
   274→			error = err instanceof Error ? err.message : 'Failed to load dashboard data';
   275→			console.error('Dashboard load error:', err);
   276→		} finally {
   277→			loading = false;
   278→		}
   279→	}
   280→
   281→	function navigateToTasks(status: string) {
   282→		goto(`${base}/tasks?status=${status}`);
   283→	}
   284→
   285→	// --- WebSocket real-time updates ---
   286→	function handleTaskUpdate() {
   287→		loadDashboard();
   288→	}
   289→
   290→	function handleAgentEvent() {
   291→		fetchAgentStatus()
   292→			.then((s) => {
   293→				agentStatus = s;
   294→			})
   295→			.catch(() => {});
   296→	}
   297→
   298→	// --- Lifecycle ---
   299→	onMount(() => {
   300→		loadDashboard();
   301→
   302→		if (!isStaticMode()) {
   303→			subscribe(['tasks', 'agents']);
   304→			on('tasks', handleTaskUpdate);
   305→			on('agents', handleAgentEvent);
   306→		}
   307→	});
   308→
   309→	onDestroy(() => {
   310→		if (!isStaticMode()) {
   311→			off('tasks', handleTaskUpdate);
   312→			off('agents', handleAgentEvent);
   313→			unsubscribe(['tasks', 'agents']);
   314→		}
   315→	});
   316→
   317→	// Reload on project change
   318→	$effect(() => {
   319→		const version = getProjectVersion();
   320→		if (version > 0) {
   321→			loadDashboard();
   322→		}
   323→	});
   324→</script>
   325→
   326→<div class="flex flex-col gap-6 p-6" data-testid="dashboard">
   327→	<h1 class="text-2xl font-bold">Dashboard</h1>
   328→
   329→	{#if error}
   330→		<!-- Error state -->
   331→		<div
   332→			class="flex items-center gap-3 rounded-lg border border-destructive/50 bg-destructive/10 p-4"
   333→			role="alert"
   334→			data-testid="dashboard-error"
   335→		>
   336→			<AlertTriangle class="size-5 text-destructive" />
   337→			<div>
   338→				<p class="text-sm font-medium text-destructive">Failed to load dashboard</p>
   339→				<p class="text-xs text-muted-foreground">{error}</p>
   340→			</div>
   341→			<button
   342→				class="ml-auto text-xs text-muted-foreground underline hover:text-foreground"
   343→				onclick={loadDashboard}
   344→			>
   345→				Retry
   346→			</button>
   347→		</div>
   348→	{/if}
   349→
   350→	{#if loading}
   351→		<!-- Loading skeleton -->
   352→		<div data-testid="dashboard-skeleton">
   353→			<!-- Active work skeleton -->
   354→			<div class="mb-6">
   355→				<Skeleton class="mb-2 h-5 w-32 ds-shimmer" />
   356→				<div class="flex gap-3">
   357→					<Skeleton class="h-20 w-72 ds-shimmer" />
   358→				</div>
   359→			</div>
   360→
   361→			<!-- Status summary skeleton -->
   362→			<div class="mb-6">
   363→				<Skeleton class="mb-3 h-5 w-40 ds-shimmer" />
   364→				<div class="grid gap-4 md:grid-cols-4 lg:grid-cols-7">
   365→					{#each Array(7) as _}
   366→						<Skeleton class="h-24 ds-shimmer" />
   367→					{/each}
   368→				</div>
   369→			</div>
   370→
   371→			<!-- Needs attention skeleton -->
   372→			<div>
   373→				<Skeleton class="mb-3 h-5 w-40 ds-shimmer" />
   374→				<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
   375→					{#each Array(4) as _}
   376→						<Skeleton class="h-20 ds-shimmer" />
   377→					{/each}
   378→				</div>
   379→			</div>
   380→		</div>
   381→	{:else}
   382→		<!-- AC: @ui-dashboard-overview ac-1 — Active work section -->
   383→		<section data-testid="active-work-section">
   384→			{#if hasActiveWork}
   385→				<div class="mb-4">
   386→					<div class="flex items-center gap-2 mb-2">
   387→						<Activity class="size-4 text-status-in-progress" />
   388→						<h2 class="text-sm font-medium">Active Fleet</h2>
   389→						<Badge variant="secondary" class="text-[10px]">
   390→							{agentStatus?.active_invocations.length} running
   391→						</Badge>
   392→					</div>
   393→					<div class="flex gap-3 overflow-x-auto pb-2" data-testid="active-fleet-row">
   394→						{#each agentStatus?.active_invocations ?? [] as invocation (invocation.session_id)}
   395→							{@const title = invocation.task_ref ? taskTitles[invocation.task_ref] : undefined}
   396→							<div
   397→								class="flex-shrink-0 w-72 rounded-lg border bg-card p-3 ds-breathe"
   398→								data-testid="fleet-card"
   399→							>
   400→								<div class="flex items-center gap-2 mb-1.5">
   401→									<Bot class="size-4 text-muted-foreground" />
   402→									<span class="text-xs font-medium truncate">{invocation.agent_id}</span>
   403→								</div>
   404→
   405→								{#if invocation.task_ref}
   406→									{#if title}
   407→										<p class="text-xs text-foreground truncate mb-0.5">{title}</p>
   408→									{/if}
   409→									<p class="text-[10px] text-muted-foreground font-mono truncate mb-1">
   410→										{invocation.task_ref}
   411→									</p>
   412→								{/if}
   413→
   414→								<div class="flex items-center justify-between text-[10px] text-muted-foreground">
   415→									<div class="flex items-center gap-1.5">
   416→										<!-- Pulse indicator -->
   417→										<span class="relative flex size-2">
   418→											<span
   419→												class="absolute inline-flex h-full w-full rounded-full bg-status-in-progress opacity-75 ds-breathe"
   420→											></span>
   421→											<span
   422→												class="relative inline-flex size-2 rounded-full bg-status-in-progress"
   423→											></span>
   424→										</span>
   425→										<span>{formatElapsed(invocation.elapsed_ms)}</span>
   426→									</div>
   427→
   428→									<a
   429→										href="{base}/sessions/{invocation.session_id}"
   430→										class="inline-flex items-center gap-1 text-primary hover:underline"
   431→									>
   432→										Stream
   433→										<ExternalLink class="size-3" />
   434→									</a>
   435→								</div>
   436→							</div>
   437→						{/each}
   438→					</div>
   439→				</div>
   440→			{:else}
   441→				<div
   442→					class="flex items-center gap-2 rounded-lg border border-dashed p-4 text-sm text-muted-foreground"
   443→					data-testid="no-active-work"
   444→				>
   445→					<Activity class="size-4" />
   446→					<span>No agents currently running</span>
   447→				</div>
   448→			{/if}
   449→		</section>
   450→
   451→		<!-- AC: @ui-dashboard-overview ac-1 — Status summary with clickable count cards -->
   452→		<section data-testid="status-summary-section">
   453→			<h2 class="mb-3 text-sm font-medium text-muted-foreground">Status Summary</h2>
   454→			<div class="grid gap-3 md:grid-cols-4 lg:grid-cols-7" data-testid="dashboard-counts">
   455→				{#each statusConfig as status}
   456→					<button
   457→						class="text-left"
   458→						onclick={() => navigateToTasks(status.filterStatus)}
   459→						data-testid="task-count-{status.key}"
   460→					>
   461→						<Card class="transition-colors hover:bg-muted/50 cursor-pointer h-full">
   462→							<CardHeader
   463→								class="flex flex-row items-center justify-between pb-1 pt-3 px-3 space-y-0"
   464→							>
   465→								<CardTitle class="text-xs font-medium text-muted-foreground">
   466→									{status.label}
   467→								</CardTitle>
   468→								<span class="inline-block size-2.5 rounded-full {status.dotClass}"></span>
   469→							</CardHeader>
   470→							<CardContent class="px-3 pb-3">
   471→								<div class="text-2xl font-bold tabular-nums">
   472→									{counts[status.key]}
   473→								</div>
   474→							</CardContent>
   475→						</Card>
   476→					</button>
   477→				{/each}
   478→			</div>
   479→		</section>
   480→
   481→		<!-- AC: @ui-dashboard-overview ac-1 — Needs attention aggregation -->
   482→		<section data-testid="needs-attention-section">
   483→			<div class="mb-3 flex items-center gap-2">
   484→				<h2 class="text-sm font-medium text-muted-foreground">Needs Attention</h2>
   485→				{#if totalAttention > 0}
   486→					<Badge variant="secondary" class="text-[10px]">{totalAttention}</Badge>
   487→				{/if}
   488→			</div>
   489→
   490→			{#if totalAttention === 0}
   491→				<div
   492→					class="flex items-center gap-2 rounded-lg border border-dashed p-4 text-sm text-muted-foreground"
   493→					data-testid="no-attention-needed"
   494→				>
   495→					<span>Nothing needs attention right now</span>
   496→				</div>
   497→			{:else}
   498→				<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4" data-testid="attention-cards">
   499→					{#each attentionItems as item}
   500→						{#if item.count > 0}
   501→							<a href={item.href} class="block" data-testid="attention-{item.key}">
   502→								<Card class="transition-colors hover:bg-muted/50 cursor-pointer h-full">
   503→									<CardContent class="flex items-center gap-3 p-4">
   504→										<div class="rounded-md bg-muted p-2">
   505→											<item.icon class="size-4 {item.colorClass}" />
   506→										</div>
   507→										<div>
   508→											<p class="text-2xl font-bold tabular-nums">{item.count}</p>
   509→											<p class="text-xs text-muted-foreground">{item.label}</p>
   510→										</div>
   511→									</CardContent>
   512→								</Card>
   513→							</a>
   514→						{/if}
   515→					{/each}
   516→				</div>
   517→			{/if}
   518→		</section>
   519→	{/if}
   520→</div>
   521→
```