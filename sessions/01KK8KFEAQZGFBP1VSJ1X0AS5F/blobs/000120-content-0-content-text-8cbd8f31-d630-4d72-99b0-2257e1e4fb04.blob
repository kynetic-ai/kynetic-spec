```
     1→/**
     2→ * Kspec Daemon Server
     3→ *
     4→ * Elysia.js HTTP server with WebSocket support for real-time kspec state updates.
     5→ * Implements localhost-only security, file watching, and graceful shutdown.
     6→ */
     7→
     8→import { Elysia } from 'elysia';
     9→import { cors } from '@elysiajs/cors';
    10→import { staticPlugin } from '@elysiajs/static';
    11→import { ulid } from 'ulidx';
    12→import { existsSync } from 'fs';
    13→import { fileURLToPath } from 'url';
    14→import { dirname } from 'path';
    15→import { PubSubManager } from './websocket/pubsub';
    16→import { HeartbeatManager } from './websocket/heartbeat';
    17→import { WebSocketHandler } from './websocket/handler';
    18→import { handleWebSocketClose } from './websocket/lifecycle';
    19→import type { ConnectionData, ConnectedEvent } from './websocket/types';
    20→import { PidFileManager } from './pid';
    21→import { projectContextMiddleware } from './middleware/project-context';
    22→import { createTasksRoutes } from './routes/tasks';
    23→import { createItemsRoutes } from './routes/items';
    24→import { createInboxRoutes } from './routes/inbox';
    25→import { createMetaRoutes } from './routes/meta';
    26→import { createValidationRoutes } from './routes/validation';
    27→import { createProjectsRoutes } from './routes/projects';
    28→import { createTriageRoutes } from './routes/triage';
    29→import { createAgentDispatchRoutes, getDispatchEngine, stopAllEngines } from './routes/agent-dispatch';
    30→import { createSessionRoutes } from './routes/sessions';
    31→import { createPlansRoutes } from './routes/plans';
    32→import { ShadowSyncScheduler } from './shadow-sync';
    33→import { join } from 'path';
    34→
    35→export interface ServerOptions {
    36→  port: number;
    37→  isDaemon: boolean;
    38→  kspecDir?: string; // Path to .kspec directory (default: .kspec in cwd)
    39→  webUiDir?: string; // Path to web UI build directory (default: auto-detect)
    40→}
    41→
    42→/**
    43→ * Resolves the path to the web UI build directory.
    44→ * Tries multiple locations in order:
    45→ * 1. Explicit webUiDir option
    46→ * 2. WEB_UI_DIR environment variable
    47→ * 3. packages/web-ui/build in current working directory (monorepo dev)
    48→ * 4. web-ui/build in current working directory
    49→ * 5. Bundled dist/web-ui/ relative to this module (npm package installs)
    50→ *
    51→ * Exported for testing only.
    52→ */
    53→export function resolveWebUiPath(webUiDir?: string): string | null {
    54→  // 1. Explicit option
    55→  if (webUiDir && existsSync(webUiDir)) {
    56→    return webUiDir;
    57→  }
    58→
    59→  // 2. Environment variable
    60→  const envPath = process.env.WEB_UI_DIR;
    61→  if (envPath && existsSync(envPath)) {
    62→    return envPath;
    63→  }
    64→
    65→  // 3. Monorepo development: packages/web-ui/build from cwd
    66→  // The daemon is spawned with cwd set to project root
    67→  const monorepoPath = join(process.cwd(), 'packages', 'web-ui', 'build');
    68→  if (existsSync(monorepoPath)) {
    69→    return monorepoPath;
    70→  }
    71→
    72→  // 4. Alternate location: web-ui/build in cwd
    73→  const altPath = join(process.cwd(), 'web-ui', 'build');
    74→  if (existsSync(altPath)) {
    75→    return altPath;
    76→  }
    77→
    78→  // 5. Bundled assets: dist/web-ui/ relative to daemon module location
    79→  // Covers npm package installs where no local web UI build exists.
    80→  // import.meta.url resolves to dist/daemon/server.js → sibling is dist/web-ui/
    81→  const selfDir = dirname(fileURLToPath(import.meta.url));
    82→  const bundledPath = join(selfDir, '..', 'web-ui');
    83→  if (existsSync(bundledPath)) {
    84→    return bundledPath;
    85→  }
    86→
    87→  return null;
    88→}
    89→
    90→// WebSocket pub/sub and heartbeat managers
    91→let pubsubManager: PubSubManager;
    92→let heartbeatManager: HeartbeatManager;
    93→let wsHandler: WebSocketHandler;
    94→let projectManager: import('./project-context').ProjectContextManager | undefined;
    95→let shadowSyncScheduler: ShadowSyncScheduler | undefined;
    96→
    97→/**
    98→ * Middleware to enforce localhost-only connections.
    99→ * AC-3: Reject non-localhost connections with 403 Forbidden
   100→ */
   101→function localhostOnly() {
   102→  return (context: { request: Request }) => {
   103→    const host = context.request.headers.get('host');
   104→    if (!host) {
   105→      return new Response(JSON.stringify({
   106→        error: 'Forbidden',
   107→        message: 'This server only accepts connections from localhost'
   108→      }), {
   109→        status: 403,
   110→        headers: { 'Content-Type': 'application/json' }
   111→      });
   112→    }
   113→
   114→    // Extract hostname, handling IPv6 brackets
   115→    let hostname: string;
   116→    if (host.startsWith('[')) {
   117→      // IPv6 with brackets: [::1]:3456 -> ::1
   118→      const closeBracket = host.indexOf(']');
   119→      hostname = closeBracket > 0 ? host.substring(1, closeBracket) : host;
   120→    } else {
   121→      // IPv4 or hostname: localhost:3456 -> localhost
   122→      hostname = host.split(':')[0];
   123→    }
   124→
   125→    // Allow localhost, 127.0.0.1, and ::1
   126→    const isLocalhost =
   127→      hostname === 'localhost' ||
   128→      hostname === '127.0.0.1' ||
   129→      hostname === '::1';
   130→
   131→    if (!isLocalhost) {
   132→      return new Response(JSON.stringify({
   133→        error: 'Forbidden',
   134→        message: 'This server only accepts connections from localhost'
   135→      }), {
   136→        status: 403,
   137→        headers: { 'Content-Type': 'application/json' }
   138→      });
   139→    }
   140→  };
   141→}
   142→
   143→/**
   144→ * Creates and configures the Elysia server instance.
   145→ *
   146→ * AC Coverage:
   147→ * - ac-1: Server starts on configurable port (default 3456)
   148→ * - ac-2: Binds to localhost only (127.0.0.1 and ::1)
   149→ * - ac-3: Rejects non-localhost connections with 403
   150→ * - ac-15: Uses plugin pattern for middleware
   151→ */
   152→export async function createServer(options: ServerOptions) {
   153→  const { port, isDaemon, kspecDir = join(process.cwd(), '.kspec'), webUiDir } = options;
   154→
   155→  // Determine startup project path (project root, not .kspec/)
   156→  // AC: @multi-directory-daemon ac-2 - daemon uses startup directory as default project
   157→  const startupProjectPath = kspecDir.endsWith('.kspec')
   158→    ? kspecDir.slice(0, -('.kspec'.length + 1)) // Remove '/.kspec'
   159→    : kspecDir;
   160→
   161→  // Import ProjectContextManager (needed for WebSocket binding)
   162→  const { ProjectContextManager } = await import('./project-context');
   163→
   164→  // AC: @daemon-server ac-17 - Resolve web UI path for static file serving
   165→  const resolvedWebUiPath = resolveWebUiPath(webUiDir);
   166→  if (resolvedWebUiPath) {
   167→    console.log(`[daemon] Web UI assets found at: ${resolvedWebUiPath}`);
   168→  } else {
   169→    console.log('[daemon] Web UI assets not found - UI will not be served');
   170→    console.log('[daemon] Build the web UI with: cd packages/web-ui && npm run build');
   171→  }
   172→
   173→  // Initialize PID file manager (uses global ~/.config/kspec/)
   174→  const pidManager = new PidFileManager();
   175→
   176→  // AC: @multi-directory-daemon ac-9 - Write PID and port files in daemon mode
   177→  if (isDaemon) {
   178→    pidManager.writePid();
   179→    pidManager.writePort(port);
   180→    console.log(`[daemon] PID file written: ${process.pid}`);
   181→    console.log(`[daemon] Port file written: ${port}`);
   182→  }
   183→
   184→  // Initialize WebSocket managers
   185→  pubsubManager = new PubSubManager();
   186→  heartbeatManager = new HeartbeatManager();
   187→  wsHandler = new WebSocketHandler(pubsubManager);
   188→
   189→  // WeakMap to store project path during WebSocket upgrade (keyed by Request object)
   190→  // Using WeakMap avoids needing to pass a requestId through beforeHandle return value,
   191→  // which breaks WebSocket upgrade in Elysia 1.4 when derive middleware is present.
   192→  const wsProjectPaths = new WeakMap<Request, string>();
   193→
   194→  const app = new Elysia()
   195→    // AC-15: Plugin pattern for middleware
   196→    // AC: @api-contract ac-1 - Allow CORS from dev server on localhost:5173
   197→    .use(cors({
   198→      origin: ['http://localhost:5173', 'http://127.0.0.1:5173'], // Dev server origins
   199→      credentials: true,
   200→      methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS']
   201→    }))
   202→
   203→    // AC-3: Enforce localhost-only connections
   204→    .onRequest(localhostOnly());
   205→
   206→  // AC: @multi-directory-daemon ac-1, ac-2, ac-3 - Project context middleware
   207→  const { manager: projectContextManager, middleware: projectMiddleware } = projectContextMiddleware({
   208→    startupProject: startupProjectPath,
   209→    pubsub: pubsubManager
   210→  });
   211→
   212→  // Store manager globally for shutdown
   213→  projectManager = projectContextManager;
   214→
   215→  app.use(projectMiddleware)
   216→
   217→    // AC-11: Health check endpoint
   218→    .get('/api/health', () => ({
   219→      status: 'ok',
   220→      uptime: process.uptime(),
   221→      connections: pubsubManager.getConnectionCount(),
   222→      version: '0.1.0'
   223→    }))
   224→
   225→    // AC: @api-contract ac-2 through ac-7 - Task API endpoints
   226→    // AC: @multi-directory-daemon ac-24 - Routes use projectContext from middleware
   227→    .use(createTasksRoutes({ pubsub: pubsubManager }))
   228→
   229→    // AC: @api-contract ac-8 through ac-11 - Spec Item API endpoints
   230→    .use(createItemsRoutes())
   231→
   232→    // AC: @api-contract ac-12 through ac-14 - Inbox API endpoints
   233→    .use(createInboxRoutes({ pubsub: pubsubManager }))
   234→
   235→    // AC: @api-contract ac-15 through ac-18 - Meta API endpoints
   236→    .use(createMetaRoutes())
   237→
   238→    // AC: @triage-daemon-api ac-1 through ac-9 - Triage API endpoints
   239→    .use(createTriageRoutes({ pubsub: pubsubManager }))
   240→
   241→    // AC: @api-contract ac-19 through ac-21 - Validation and search endpoints
   242→    .use(createValidationRoutes())
   243→
   244→    // AC: @multi-directory-daemon ac-28, ac-29, ac-30 - Projects management endpoints
   245→    .use(createProjectsRoutes({ projectManager: projectContextManager }))
   246→
   247→    // AC: @ui-session-stream ac-1, ac-4 - Session data endpoints
   248→    .use(createSessionRoutes())
   249→
   250→    // AC: @ui-plans-view ac-1 - Plans data endpoints
   251→    .use(createPlansRoutes())
   252→
   253→    // AC: @agent-dispatch-engine ac-4 - Agent dispatch API endpoints
   254→    // AC: @daemon-agent-dispatch ac-3, ac-4 - Pass pubsub for WebSocket broadcast on invocation events
   255→    .use(createAgentDispatchRoutes({ pubsub: pubsubManager }))
   256→
   257→    // AC-4: WebSocket endpoint for real-time updates
   258→    .ws<ConnectionData>('/ws', {
   259→      beforeHandle({ request, store }) {
   260→        // AC: @multi-directory-daemon ac-21, ac-22, ac-23, ac-34 - Extract and validate project binding
   261→        // AC: @multi-directory-daemon ac-34 - Browser WebSocket API doesn't support custom headers,
   262→        // so we also accept project path as query parameter
   263→        const url = new URL(request.url, `http://${request.headers.get('host')}`);
   264→        const projectPath = request.headers.get('X-Kspec-Dir')
   265→                        || url.searchParams.get('project')
   266→                        || undefined;
   267→
   268→        // IMPORTANT: Do NOT return a value from ws beforeHandle.
   269→        // In Elysia 1.4 with derive middleware, returning a value short-circuits
   270→        // the WebSocket upgrade and sends the value as an HTTP 200 response.
   271→        // Use a WeakMap keyed by Request object to pass data to open().
   272→        try {
   273→          const manager = (store as Record<string, unknown>).projectManager as import('./project-context').ProjectContextManager | undefined;
   274→          if (!manager) {
   275→            // Fallback: project manager not initialized yet
   276→            wsProjectPaths.set(request, startupProjectPath);
   277→            return;
   278→          }
   279→
   280→          let projectContext;
   281→          if (projectPath) {
   282→            // Explicit project specified
   283→            try {
   284→              projectContext = manager.getProject(projectPath);
   285→            } catch {
   286→              // AC: @multi-directory-daemon ac-4 - auto-register
   287→              projectContext = manager.registerProject(projectPath);
   288→            }
   289→          } else {
   290→            // AC: @multi-directory-daemon ac-22, ac-23 - Use default or reject
   291→            try {
   292→              projectContext = manager.getProject();
   293→            } catch (err: unknown) {
   294→              // AC: @multi-directory-daemon ac-23 - Reject when no default
   295→              if (err instanceof Error && err.message.includes('No default project configured')) {
   296→                throw new Error('No project specified');
   297→              }
   298→              throw err;
   299→            }
   300→          }
   301→
   302→          // Store resolved path for open() handler via WeakMap
   303→          wsProjectPaths.set(request, projectContext.path);
   304→        } catch (err: unknown) {
   305→          console.error(`[daemon] WebSocket connection rejected: ${err instanceof Error ? err.message : String(err)}`);
   306→          throw err;
   307→        }
   308→      },
   309→      open(ws) {
   310→        // AC: @api-contract ac-25, @trait-websocket-protocol ac-1
   311→        const sessionId = ulid();
   312→        const openContext = ws.data as { id?: unknown; request?: unknown } | undefined;
   313→        const contextId = typeof openContext?.id === 'string' ? openContext.id : undefined;
   314→
   315→        // AC: @multi-directory-daemon ac-21 - Get bound project path
   316→        // Retrieve project path from WeakMap via the request object on ws.data
   317→        const request = openContext?.request as Request | undefined;
   318→        const projectPath = request ? wsProjectPaths.get(request) || startupProjectPath : startupProjectPath;
   319→
   320→        ws.data = {
   321→          sessionId,
   322→          topics: new Set<string>(),
   323→          seq: 0,
   324→          lastPing: undefined,
   325→          lastPong: Date.now(),
   326→          projectPath // AC: @multi-directory-daemon ac-21 - immutable binding
   327→        };
   328→
   329→        pubsubManager.addConnection(sessionId, ws, contextId);
   330→        console.log(`[daemon] WebSocket client connected: ${sessionId} bound to ${projectPath} (${pubsubManager.getConnectionCount()} total)`);
   331→
   332→        // Send connected event with session_id
   333→        const connectedEvent: ConnectedEvent = {
   334→          event: 'connected',
   335→          data: {
   336→            session_id: sessionId
   337→          }
   338→        };
   339→        ws.send(JSON.stringify(connectedEvent));
   340→      },
   341→      message(ws, message) {
   342→        // AC: @api-contract ac-26, ac-27
   343→        wsHandler.handleMessage(ws, message);
   344→      },
   345→      pong(ws) {
   346→        // AC: @trait-websocket-protocol ac-5
   347→        heartbeatManager.recordPong(ws);
   348→      },
   349→      close(ws, code, reason) {
   350→        handleWebSocketClose(pubsubManager, ws, code, reason);
   351→      }
   352→    });
   353→
   354→  // AC: @daemon-server ac-17 - Serve web UI static assets
   355→  // Added after API routes so API routes take precedence
   356→  if (resolvedWebUiPath) {
   357→    const indexHtmlPath = join(resolvedWebUiPath, 'index.html');
   358→
   359→    // Serve static files from web UI build directory
   360→    app.use(await staticPlugin({
   361→      assets: resolvedWebUiPath,
   362→      prefix: '/',
   363→      noCache: process.env.NODE_ENV === 'development', // Disable cache in dev
   364→    }));
   365→
   366→    // SPA fallback routes for client-side routing
   367→    // These catch paths like /tasks, /items, /inbox that don't have static files
   368→    const spaRoutes = [
   369→      '/',
   370→      '/tasks', '/tasks/*',
   371→      '/items', '/items/*',
   372→      '/inbox',
   373→      '/observations',
   374→      '/triage',
   375→      '/validate',
   376→      '/sessions', '/sessions/*',
   377→      '/agents',
   378→      '/specs',
   379→      '/workflows',
   380→      '/plans',
   381→      '/settings',
   382→    ];
   383→    for (const route of spaRoutes) {
   384→      app.get(route, () => Bun.file(indexHtmlPath));
   385→    }
   386→
   387→    console.log('[daemon] Web UI static file serving enabled');
   388→  }
   389→
   390→  // AC-1, AC-2: Start server on localhost only
   391→  // Using 'localhost' hostname allows Bun/OS to bind to both 127.0.0.1 and ::1
   392→  app.listen({
   393→    port,
   394→    hostname: 'localhost', // Resolves to both IPv4 and IPv6 loopback
   395→  });
   396→
   397→  console.log(`[daemon] Server listening on http://localhost:${port} (IPv4: 127.0.0.1, IPv6: ::1)`);
   398→  console.log(`[daemon] WebSocket available at ws://localhost:${port}/ws`);
   399→
   400→  // AC: @agent-dispatch-engine ac-5 - Wire file change callback to dispatch engine
   401→  projectContextManager.setFileChangeCallback((projectPath, file) => {
   402→    // Only forward changes to project.tasks.yaml
   403→    if (!file.endsWith('project.tasks.yaml')) return;
   404→    const engine = getDispatchEngine(projectPath);
   405→    if (engine) {
   406→      engine.handleFileChange(projectPath).catch((err) => {
   407→        console.error('[dispatch] Error handling file change:', err);
   408→      });
   409→    }
   410→  });
   411→
   412→  // AC: @multi-directory-daemon ac-17 - Start file watcher for startup project
   413→  if (startupProjectPath) {
   414→    try {
   415→      await projectContextManager.startWatcher(startupProjectPath);
   416→      console.log(`[daemon] File watcher started for startup project: ${startupProjectPath}`);
   417→    } catch (error) {
   418→      console.error('[daemon] Failed to start file watcher for startup project:', error);
   419→    }
   420→  }
   421→
   422→  // AC: @config-shadow ac-12 - Start periodic shadow sync if remote tracking configured
   423→  if (startupProjectPath) {
   424→    try {
   425→      const { loadProjectConfig } = await import('../parser/config.js');
   426→      const { config } = await loadProjectConfig(startupProjectPath);
   427→      const syncInterval = config.shadow.sync_interval;
   428→      const worktreeDir = join(startupProjectPath, config.shadow.directory);
   429→
   430→      if (syncInterval > 0) {
   431→        shadowSyncScheduler = new ShadowSyncScheduler({
   432→          worktreeDir,
   433→          intervalSeconds: syncInterval,
   434→          shadowOptions: {
   435→            branchName: config.shadow.branch,
   436→            directory: config.shadow.directory,
   437→            remote: config.shadow.remote?.value,
   438→            remoteType: config.shadow.remote?.type,
   439→          },
   440→          pubsub: pubsubManager,
   441→        });
   442→        shadowSyncScheduler.start();
   443→      }
   444→    } catch (error) {
   445→      console.error('[daemon] Failed to initialize shadow sync scheduler:', error);
   446→    }
   447→  }
   448→
   449→  // AC: @daemon-server ac-13, ac-14 - Start heartbeat monitoring
   450→  heartbeatManager.start(pubsubManager.getAllConnections());
   451→
   452→  // AC-12: Graceful shutdown on SIGTERM/SIGINT
   453→  const shutdown = async (signal: string) => {
   454→    console.log(`[daemon] Received ${signal}, shutting down gracefully...`);
   455→
   456→    try {
   457→      // Stop heartbeat monitoring
   458→      heartbeatManager.stop();
   459→
   460→      // AC: @config-shadow ac-12 - Stop shadow sync scheduler
   461→      shadowSyncScheduler?.stop();
   462→
   463→      // AC: @agent-dispatch-engine ac-11 - Stop all dispatch engines before shutting down
   464→      await stopAllEngines();
   465→
   466→      // AC: @multi-directory-daemon ac-11b - Stop all file watchers
   467→      await projectContextManager.stopAllWatchers();
   468→      console.log('[daemon] All file watchers stopped');
   469→
   470→      // Close all WebSocket connections with code 1000 (clean close)
   471→      // AC: @trait-websocket-protocol ac-7
   472→      for (const [sessionId, ws] of pubsubManager.getAllConnections()) {
   473→        ws.close(1000, 'Server shutting down');
   474→      }
   475→
   476→      // Stop the server
   477→      await app.server?.stop();
   478→
   479→      // AC: @daemon-server ac-10 - Remove PID file on shutdown
   480→      if (isDaemon) {
   481→        pidManager.remove();
   482→        console.log('[daemon] PID file removed');
   483→      }
   484→
   485→      console.log('[daemon] Server stopped successfully');
   486→      process.exit(0);
   487→    } catch (error) {
   488→      console.error('[daemon] Error during shutdown:', error);
   489→      process.exit(1);
   490→    }
   491→  };
   492→
   493→  process.on('SIGTERM', () => shutdown('SIGTERM'));
   494→  process.on('SIGINT', () => shutdown('SIGINT'));
   495→
   496→  return app;
   497→}
   498→
```