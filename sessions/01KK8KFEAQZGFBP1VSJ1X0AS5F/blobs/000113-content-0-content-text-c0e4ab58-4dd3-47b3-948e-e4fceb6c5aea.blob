```
     1→import { execSync } from "node:child_process";
     2→import chalk from "chalk";
     3→import type { Command } from "commander";
     4→import {
     5→  getGitRoot,
     6→  getShadowStatus,
     7→  hasRemoteTracking,
     8→  repairShadow,
     9→  SHADOW_BRANCH_NAME,
    10→  SHADOW_WORKTREE_DIR,
    11→  SESSIONS_WORKTREE_DIR,
    12→  type ShadowStatus,
    13→  shadowSync,
    14→} from "../../parser/shadow.js";
    15→import {
    16→  getSessionBranchStatus,
    17→  repairSessionBranch,
    18→  type SessionBranchStatus,
    19→} from "../../parser/session-branch.js";
    20→import { shadowCommands } from "../../strings/index.js";
    21→import { EXIT_CODES } from "../exit-codes.js";
    22→import { error, info, output, success, warn } from "../output.js";
    23→
    24→/**
    25→ * Format shadow status for display
    26→ */
    27→function formatShadowStatus(
    28→  status: ShadowStatus,
    29→  gitRoot: string,
    30→  sessionStatus?: SessionBranchStatus,
    31→  sessionBranchName?: string,
    32→): void {
    33→  console.log(chalk.bold("Shadow Branch Status"));
    34→  console.log(chalk.gray("─".repeat(40)));
    35→  console.log(`Project root: ${gitRoot}`);
    36→  console.log(`Branch name:  ${SHADOW_BRANCH_NAME}`);
    37→  console.log(`Worktree:     ${SHADOW_WORKTREE_DIR}/`);
    38→  console.log();
    39→
    40→  if (status.healthy) {
    41→    console.log(chalk.green.bold("✓ Shadow branch is healthy"));
    42→    console.log(chalk.green("  ✓ Branch exists"));
    43→    console.log(chalk.green("  ✓ Worktree exists"));
    44→    console.log(chalk.green("  ✓ Worktree linked"));
    45→  } else if (!status.exists) {
    46→    console.log(chalk.yellow("○ Shadow branch not initialized"));
    47→    console.log(chalk.gray("  Run `kspec init` to set up shadow branch"));
    48→  } else {
    49→    console.log(chalk.red.bold("✗ Shadow branch has issues"));
    50→    console.log(
    51→      status.branchExists
    52→        ? chalk.green("  ✓ Branch exists")
    53→        : chalk.red("  ✗ Branch missing"),
    54→    );
    55→    console.log(
    56→      status.worktreeExists
    57→        ? chalk.green("  ✓ Worktree exists")
    58→        : chalk.red("  ✗ Worktree missing"),
    59→    );
    60→    console.log(
    61→      status.worktreeLinked
    62→        ? chalk.green("  ✓ Worktree linked")
    63→        : chalk.red("  ✗ Worktree not linked"),
    64→    );
    65→
    66→    if (status.error) {
    67→      console.log();
    68→      console.log(chalk.yellow(`Issue: ${status.error}`));
    69→    }
    70→
    71→    if (status.branchExists) {
    72→      console.log();
    73→      console.log(chalk.gray("Run `kspec shadow repair` to fix"));
    74→    } else {
    75→      console.log();
    76→      console.log(chalk.gray("Run `kspec init --force` to reinitialize"));
    77→    }
    78→  }
    79→
    80→  // AC: @session-branch-worktree ac-status — report session branch health
    81→  if (sessionStatus) {
    82→    console.log();
    83→    console.log(chalk.bold("Session Branch Status"));
    84→    console.log(chalk.gray("─".repeat(40)));
    85→    console.log(`Branch name:  ${sessionBranchName || "kspec-sessions"}`);
    86→    console.log(`Worktree:     ${SESSIONS_WORKTREE_DIR}/`);
    87→    console.log();
    88→
    89→    if (sessionStatus.healthy) {
    90→      console.log(chalk.green.bold("✓ Session branch is healthy"));
    91→      console.log(chalk.green("  ✓ Branch exists"));
    92→      console.log(chalk.green("  ✓ Worktree exists"));
    93→      console.log(chalk.green("  ✓ Worktree linked"));
    94→    } else if (!sessionStatus.exists) {
    95→      console.log(chalk.gray("○ Session branch not configured"));
    96→      console.log(
    97→        chalk.gray(
    98→          '  Set sessions.storage: "branch" in manifest and run `kspec setup`',
    99→        ),
   100→      );
   101→    } else {
   102→      console.log(chalk.red.bold("✗ Session branch has issues"));
   103→      console.log(
   104→        sessionStatus.branchExists
   105→          ? chalk.green("  ✓ Branch exists")
   106→          : chalk.red("  ✗ Branch missing"),
   107→      );
   108→      console.log(
   109→        sessionStatus.worktreeExists
   110→          ? chalk.green("  ✓ Worktree exists")
   111→          : chalk.red("  ✗ Worktree missing"),
   112→      );
   113→      console.log(
   114→        sessionStatus.worktreeLinked
   115→          ? chalk.green("  ✓ Worktree linked")
   116→          : chalk.red("  ✗ Worktree not linked"),
   117→      );
   118→
   119→      if (sessionStatus.error) {
   120→        console.log();
   121→        console.log(chalk.yellow(`Issue: ${sessionStatus.error}`));
   122→      }
   123→
   124→      console.log();
   125→      console.log(chalk.gray("Run `kspec shadow repair` to fix"));
   126→    }
   127→  }
   128→}
   129→
   130→/**
   131→ * Register shadow commands
   132→ */
   133→export function registerShadowCommands(program: Command): void {
   134→  const shadow = program
   135→    .command("shadow")
   136→    .description("Manage shadow branch for spec storage");
   137→
   138→  shadow
   139→    .command("status")
   140→    .description("Show shadow branch status")
   141→    .action(async () => {
   142→      try {
   143→        const gitRoot = getGitRoot(process.cwd());
   144→
   145→        if (!gitRoot) {
   146→          error(shadowCommands.notGitRepo);
   147→          process.exit(EXIT_CODES.ERROR);
   148→        }
   149→
   150→        const status = await getShadowStatus(gitRoot);
   151→
   152→        // AC: @session-branch-worktree ac-status — check session branch if configured
   153→        let sessionStatus: SessionBranchStatus | undefined;
   154→        let sessionBranchName: string | undefined;
   155→        try {
   156→          const { initContext } = await import("../../parser/index.js");
   157→          const ctx = await initContext();
   158→          if (ctx.manifest?.sessions?.storage === "branch") {
   159→            sessionBranchName =
   160→              ctx.manifest.sessions.branch || "kspec-sessions";
   161→            sessionStatus = await getSessionBranchStatus(
   162→              gitRoot,
   163→              sessionBranchName,
   164→            );
   165→          }
   166→        } catch {
   167→          // Context not available — skip session branch status
   168→        }
   169→
   170→        output(
   171→          {
   172→            ...status,
   173→            gitRoot,
   174→            branchName: SHADOW_BRANCH_NAME,
   175→            worktreeDir: SHADOW_WORKTREE_DIR,
   176→            ...(sessionStatus && {
   177→              sessionBranch: {
   178→                ...sessionStatus,
   179→                branchName: sessionBranchName,
   180→                worktreeDir: SESSIONS_WORKTREE_DIR,
   181→              },
   182→            }),
   183→          },
   184→          () =>
   185→            formatShadowStatus(
   186→              status,
   187→              gitRoot,
   188→              sessionStatus,
   189→              sessionBranchName,
   190→            ),
   191→        );
   192→
   193→        if (!status.healthy && status.exists) {
   194→          process.exit(EXIT_CODES.ERROR);
   195→        }
   196→      } catch (err) {
   197→        error(shadowCommands.statusFailed, err);
   198→        process.exit(EXIT_CODES.ERROR);
   199→      }
   200→    });
   201→
   202→  shadow
   203→    .command("repair")
   204→    .description("Repair broken shadow branch worktree")
   205→    .action(async () => {
   206→      try {
   207→        const gitRoot = getGitRoot(process.cwd());
   208→
   209→        if (!gitRoot) {
   210→          error(shadowCommands.notGitRepo);
   211→          process.exit(EXIT_CODES.ERROR);
   212→        }
   213→
   214→        const status = await getShadowStatus(gitRoot);
   215→
   216→        if (status.healthy) {
   217→          info(shadowCommands.repair.alreadyHealthy);
   218→          return;
   219→        }
   220→
   221→        if (!status.branchExists) {
   222→          error(shadowCommands.repair.branchNotExist);
   223→          console.log(shadowCommands.repair.initHint);
   224→          process.exit(EXIT_CODES.ERROR);
   225→        }
   226→
   227→        info(shadowCommands.repair.repairing);
   228→
   229→        const result = await repairShadow(gitRoot);
   230→
   231→        if (result.success) {
   232→          if (result.alreadyExists) {
   233→            info(shadowCommands.repair.stillHealthy);
   234→          } else {
   235→            success(shadowCommands.repair.repaired, {
   236→              worktreeCreated: result.worktreeCreated,
   237→            });
   238→            console.log(
   239→              shadowCommands.repair.worktreeCreated(SHADOW_WORKTREE_DIR),
   240→            );
   241→          }
   242→        } else {
   243→          error(shadowCommands.repair.failed(result.error || "Unknown error"));
   244→          process.exit(EXIT_CODES.ERROR);
   245→        }
   246→
   247→        // AC: @session-branch-worktree ac-repair — repair session branch independently
   248→        try {
   249→          const { initContext } = await import("../../parser/index.js");
   250→          const ctx = await initContext();
   251→          if (ctx.manifest?.sessions?.storage === "branch") {
   252→            const sessionBranchName =
   253→              ctx.manifest.sessions.branch || "kspec-sessions";
   254→            const sessionStatus = await getSessionBranchStatus(
   255→              gitRoot,
   256→              sessionBranchName,
   257→            );
   258→            if (!sessionStatus.healthy && sessionStatus.exists) {
   259→              info("Repairing session branch worktree...");
   260→              const sessionResult = await repairSessionBranch(
   261→                gitRoot,
   262→                sessionBranchName,
   263→              );
   264→              if (sessionResult.success) {
   265→                if (sessionResult.alreadyExists) {
   266→                  info("Session branch already healthy");
   267→                } else {
   268→                  success("Session branch repaired", {
   269→                    worktreeCreated: sessionResult.worktreeCreated,
   270→                  });
   271→                }
   272→              } else {
   273→                warn(
   274→                  `Session branch repair failed: ${sessionResult.error || "Unknown error"}`,
   275→                );
   276→              }
   277→            }
   278→          }
   279→        } catch {
   280→          // Session branch repair is optional
   281→        }
   282→      } catch (err) {
   283→        error(shadowCommands.repair.commandFailed, err);
   284→        process.exit(EXIT_CODES.ERROR);
   285→      }
   286→    });
   287→
   288→  shadow
   289→    .command("log")
   290→    .description("Show recent shadow branch commits")
   291→    .option("-n, --count <n>", "Number of commits to show", "10")
   292→    .action(async (options) => {
   293→      try {
   294→        const gitRoot = getGitRoot(process.cwd());
   295→
   296→        if (!gitRoot) {
   297→          error(shadowCommands.notGitRepo);
   298→          process.exit(EXIT_CODES.ERROR);
   299→        }
   300→
   301→        const status = await getShadowStatus(gitRoot);
   302→
   303→        if (!status.healthy) {
   304→          if (!status.branchExists) {
   305→            warn(shadowCommands.log.branchNotExist);
   306→            console.log(shadowCommands.log.initHint);
   307→          } else {
   308→            warn(shadowCommands.log.hasIssues);
   309→            console.log(shadowCommands.log.repairHint);
   310→          }
   311→          process.exit(EXIT_CODES.ERROR);
   312→        }
   313→
   314→        const count = parseInt(options.count, 10) || 10;
   315→
   316→        const log = execSync(
   317→          `git log --oneline -n ${count} ${SHADOW_BRANCH_NAME}`,
   318→          { cwd: gitRoot, encoding: "utf-8" },
   319→        ).trim();
   320→
   321→        if (!log) {
   322→          info(shadowCommands.log.noCommits);
   323→          return;
   324→        }
   325→
   326→        console.log(chalk.bold(`Recent commits on ${SHADOW_BRANCH_NAME}:`));
   327→        console.log(chalk.gray("─".repeat(40)));
   328→        console.log(log);
   329→      } catch (err) {
   330→        error(shadowCommands.log.failed, err);
   331→        process.exit(EXIT_CODES.ERROR);
   332→      }
   333→    });
   334→
   335→  // AC: @shadow-sync ac-5 - Shadow resolve command for conflict resolution
   336→  shadow
   337→    .command("resolve")
   338→    .description("Resolve shadow branch sync conflicts")
   339→    .option("--theirs", "Accept all remote changes, discard local")
   340→    .option("--ours", "Keep all local changes, discard remote")
   341→    .action(async (options) => {
   342→      try {
   343→        const gitRoot = getGitRoot(process.cwd());
   344→
   345→        if (!gitRoot) {
   346→          error(shadowCommands.notGitRepo);
   347→          process.exit(EXIT_CODES.ERROR);
   348→        }
   349→
   350→        const status = await getShadowStatus(gitRoot);
   351→
   352→        if (!status.healthy) {
   353→          error(shadowCommands.resolve.notHealthy);
   354→          console.log(shadowCommands.resolve.repairHint);
   355→          process.exit(EXIT_CODES.ERROR);
   356→        }
   357→
   358→        const worktreeDir = `${gitRoot}/${SHADOW_WORKTREE_DIR}`;
   359→
   360→        // Check if there's a rebase in progress
   361→        let inRebase = false;
   362→        try {
   363→          execSync("git rebase --show-current-patch", {
   364→            cwd: worktreeDir,
   365→            stdio: ["pipe", "pipe", "pipe"],
   366→          });
   367→          inRebase = true;
   368→        } catch {
   369→          // Not in rebase
   370→        }
   371→
   372→        if (options.theirs) {
   373→          // Accept remote changes
   374→          info(shadowCommands.resolve.acceptingRemote);
   375→          if (inRebase) {
   376→            execSync("git rebase --abort", {
   377→              cwd: worktreeDir,
   378→              stdio: "inherit",
   379→            });
   380→          }
   381→          execSync(`git fetch origin ${SHADOW_BRANCH_NAME}`, {
   382→            cwd: worktreeDir,
   383→            stdio: "inherit",
   384→          });
   385→          execSync(`git reset --hard origin/${SHADOW_BRANCH_NAME}`, {
   386→            cwd: worktreeDir,
   387→            stdio: "inherit",
   388→          });
   389→          success(shadowCommands.resolve.acceptedRemote);
   390→        } else if (options.ours) {
   391→          // Keep local changes
   392→          info(shadowCommands.resolve.keepingLocal);
   393→          if (inRebase) {
   394→            execSync("git rebase --abort", {
   395→              cwd: worktreeDir,
   396→              stdio: "inherit",
   397→            });
   398→          }
   399→          // Force push to override remote
   400→          try {
   401→            execSync("git push --force-with-lease", {
   402→              cwd: worktreeDir,
   403→              stdio: "inherit",
   404→            });
   405→            success(shadowCommands.resolve.keptLocal);
   406→          } catch {
   407→            warn(shadowCommands.resolve.pushFailed);
   408→            console.log(shadowCommands.resolve.localPreserved);
   409→          }
   410→        } else {
   411→          // Interactive guidance
   412→          console.log(shadowCommands.resolve.interactive.header);
   413→          console.log(shadowCommands.resolve.interactive.separator);
   414→
   415→          if (inRebase) {
   416→            console.log(shadowCommands.resolve.interactive.rebaseInProgress);
   417→            console.log();
   418→          }
   419→
   420→          console.log(shadowCommands.resolve.interactive.options);
   421→          console.log();
   422→          console.log(shadowCommands.resolve.interactive.theirs.command);
   423→          console.log(shadowCommands.resolve.interactive.theirs.description);
   424→          console.log();
   425→          console.log(shadowCommands.resolve.interactive.ours.command);
   426→          console.log(shadowCommands.resolve.interactive.ours.description);
   427→          console.log();
   428→          console.log(shadowCommands.resolve.interactive.manual.header);
   429→          console.log(
   430→            shadowCommands.resolve.interactive.manual.cdCommand(
   431→              SHADOW_WORKTREE_DIR,
   432→            ),
   433→          );
   434→          if (inRebase) {
   435→            shadowCommands.resolve.interactive.manual.rebaseSteps.forEach(
   436→              (step) => console.log(step),
   437→            );
   438→          } else {
   439→            shadowCommands.resolve.interactive.manual.pullSteps.forEach(
   440→              (step) => console.log(step),
   441→            );
   442→          }
   443→        }
   444→      } catch (err) {
   445→        error(shadowCommands.resolve.failed, err);
   446→        process.exit(EXIT_CODES.ERROR);
   447→      }
   448→    });
   449→
   450→  // Explicit sync command
   451→  shadow
   452→    .command("sync")
   453→    .description("Manually sync shadow branch with remote (pull then push)")
   454→    .action(async () => {
   455→      try {
   456→        const gitRoot = getGitRoot(process.cwd());
   457→
   458→        if (!gitRoot) {
   459→          error(shadowCommands.notGitRepo);
   460→          process.exit(EXIT_CODES.ERROR);
   461→        }
   462→
   463→        const status = await getShadowStatus(gitRoot);
   464→
   465→        if (!status.healthy) {
   466→          error(shadowCommands.sync.notHealthy);
   467→          console.log(shadowCommands.sync.repairHint);
   468→          process.exit(EXIT_CODES.ERROR);
   469→        }
   470→
   471→        const worktreeDir = `${gitRoot}/${SHADOW_WORKTREE_DIR}`;
   472→
   473→        if (!(await hasRemoteTracking(worktreeDir))) {
   474→          info(shadowCommands.sync.noRemote);
   475→          console.log(shadowCommands.sync.localOnly);
   476→          return;
   477→        }
   478→
   479→        info(shadowCommands.sync.syncing);
   480→
   481→        const result = await shadowSync(worktreeDir);
   482→
   483→        if (result.hadConflict) {
   484→          warn(shadowCommands.sync.conflictDetected);
   485→          console.log(shadowCommands.sync.resolveHint);
   486→          process.exit(EXIT_CODES.ERROR);
   487→        }
   488→
   489→        if (result.pulled && result.pushed) {
   490→          success(shadowCommands.sync.syncedBoth);
   491→        } else if (result.pulled) {
   492→          success(shadowCommands.sync.syncedPull);
   493→        } else if (result.pushed) {
   494→          success(shadowCommands.sync.syncedPush);
   495→        } else {
   496→          info(shadowCommands.sync.alreadyInSync);
   497→        }
   498→      } catch (err) {
   499→        error(shadowCommands.sync.failed, err);
   500→        process.exit(EXIT_CODES.ERROR);
   501→      }
   502→    });
   503→}
   504→
```