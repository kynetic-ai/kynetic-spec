3e730097098c8383616ddae2528ebb7377c026de\",\n      \"date\": \"2026-02-28T22:27:43.000Z\",\n      \"message\": \"feat: add ralph iteration-timeout guard\",\n      \"author\": \"Jacob Chapel\",\n      \"task_refs\": [\n        \"01KJDQ17W\"\n      ]\n    },\n    {\n      \"hash\": \"69c3b62\",\n      \"full_hash\": \"69c3b626dd3218c543d810a42602d99843f7db98\",\n      \"date\": \"2026-02-28T22:18:59.000Z\",\n      \"message\": \"feat: add stale auto-abandon metadata helpers (#607)\",\n      \"author\": \"Jacob Chapel\",\n      \"task_refs\": [\n        \"implement-auto-abandon-metadata-and-audit-trail\"\n      ]\n    },\n    {\n      \"hash\": \"8131a37\",\n      \"full_hash\": \"8131a376222f82b2cf75463731a4deaa19bc0c96\",\n      \"date\": \"2026-02-28T22:08:42.000Z\",\n      \"message\": \"fix: add shadow-commit support for stale auto-abandon metadata\",\n      \"author\": \"Jacob Chapel\",\n      \"task_refs\": [\n        \"implement-auto-abandon-metadata-and-audit-trail\"\n      ]\n    },\n    {\n      \"hash\": \"ed22e4f\",\n      \"full_hash\": \"ed22e4f783bddf25cf5454ecc1e93a2a5d5e745c\",\n      \"date\": \"2026-02-28T22:08:35.000Z\",\n      \"message\": \"Revert \\\"feat: add ralph iteration-timeout guard\\\"\",\n      \"author\": \"Jacob Chapel\",\n      \"task_refs\": []\n    }\n  ],\n  \"activity_timeline\": [\n    {\n      \"type\": \"commit\",\n      \"date\": \"2026-02-28T23:19:12.000Z\",\n      \"commit\": {\n        \"hash\": \"4c81ac5\",\n        \"full_hash\": \"4c81ac594ebc432e3e7114e003b0c374a5464704\",\n        \"date\": \"2026-02-28T23:19:12.000Z\",\n        \"message\": \"fix: use session-scoped ralph update attribution\",\n        \"author\": \"Jacob Chapel\",\n        \"task_refs\": [\n          \"01KJDQ1AF125H0FK29HE769R4P\"\n        ]\n      }\n    },\n    {\n      \"type\": \"linked_commit\",\n      \"date\": \"2026-02-28T23:14:18.000Z\",\n      \"commit\": {\n        \"hash\": \"3935ca8\",\n        \"full_hash\": \"3935ca808c131813871ec5a48e7550f9a239a5a1\",\n        \"date\": \"2026-02-28T23:14:04.000Z\",\n        \"message\": \"fix: prevent unhandled rejection on iteration timeout (Node.js 22) (#610)\",\n        \"author\": \"Jacob Chapel\",\n        \"task_refs\": [\n          \"01KJDQ17W\"\n        ]\n      },\n      \"task\": {\n        \"ref\": \"01KJDQ17W\",\n        \"slug\": null,\n        \"title\": \"Ralph loop needs iteration-level timeout. When a spawned agent gets stuck (e.g., tool call hanging o\",\n        \"completed_at\": \"2026-02-28T23:14:18.000Z\",\n        \"closed_reason\": \"Merged in PR #610. Implemented iteration-timeout hardening by capturing runIterationPrompts() promise and attaching catch before Promise.race to prevent Node.js 22 unhandled rejection on timeout/dispose path. Added/confirmed @cli-ralph ac-24/ac-25/ac-26 for iteration-timeout defaults, validation, and iteration.timeout event behavior, with AC annotations in tests/ralph.test.ts. Verified @cli-ralph AC annotation coverage across ac-1..ac-26 and green PR CI on merge commit 3935ca808c131813871ec5a48e7550f9a239a5a1.\"\n      }\n    },\n    {\n      \"type\": \"linked_commit\",\n      \"date\": \"2026-02-28T23:14:18.000Z\",\n      \"commit\": {\n        \"hash\": \"0b1fbc2\",\n        \"full_hash\": \"0b1fbc2df9e77af7fbf28e09211f70134816a845\",\n        \"date\": \"2026-02-28T22:53:06.000Z\",\n        \"message\": \"fix: prevent unhandled rejection on iteration timeout in Node.js 22\",\n        \"author\": \"Jacob Chapel\",\n        \"task_refs\": [\n          \"01KJDQ17W\"\n        ]\n      },\n      \"task\": {\n        \"ref\": \"01KJDQ17W\",\n        \"slug\": null,\n        \"title\": \"Ralph loop needs iteration-level timeout. When a spawned agent gets stuck (e.g., tool call hanging o\",\n        \"completed_at\": \"2026-02-28T23:14:18.000Z\",\n        \"closed_reason\": \"Merged in PR #610. Implemented iteration-timeout hardening by capturing runIterationPrompts() promise and attaching catch before Promise.race to prevent Node.js 22 unhandled rejection on timeout/dispose path. Added/confirmed @cli-ralph ac-24/ac-25/ac-26 for iteration-timeout defaults, validation, and iteration.timeout event behavior, with AC annotations in tests/ralph.test.ts. Verified @cli-ralph AC annotation coverage across ac-1..ac-26 and green PR CI on merge commit 3935ca808c131813871ec5a48e7550f9a239a5a1.\"\n      }\n    },\n    {\n      \"type\": \"linked_commit\",\n      \"date\": \"2026-02-28T23:14:18.000Z\",\n      \"commit\": {\n        \"hash\": \"866d0ef\",\n        \"full_hash\": \"866d0ef28bed9a8adfb52d8af1e440339f8e2cb8\",\n        \"date\": \"2026-02-28T22:45:55.000Z\",\n        \"message\": \"feat: add ralph iteration-timeout guard (#608)\",\n        \"author\": \"Jacob Chapel\",\n        \"task_refs\": [\n          \"01KJDQ17W\"\n        ]\n      },\n      \"task\": {\n        \"ref\": \"01KJDQ17W\",\n        \"slug\": null,\n        \"title\": \"Ralph loop needs iteration-level timeout. When a spawned agent gets stuck (e.g., tool call hanging o\",\n        \"completed_at\": \"2026-02-28T23:14:18.000Z\",\n        \"closed_reason\": \"Merged in PR #610. Implemented iteration-timeout hardening by capturing runIterationPrompts() promise and attaching catch before Promise.race to prevent Node.js 22 unhandled rejection on timeout/dispose path. Added/confirmed @cli-ralph ac-24/ac-25/ac-26 for iteration-timeout defaults, validation, and iteration.timeout event behavior, with AC annotations in tests/ralph.test.ts. Verified @cli-ralph AC annotation coverage across ac-1..ac-26 and green PR CI on merge commit 3935ca808c131813871ec5a48e7550f9a239a5a1.\"\n      }\n    },\n    {\n      \"type\": \"linked_commit\",\n      \"date\": \"2026-02-28T23:14:18.000Z\",\n      \"commit\": {\n        \"hash\": \"3e73009\",\n        \"full_hash\": \"3e730097098c8383616ddae2528ebb7377c026de\",\n        \"date\": \"2026-02-28T22:27:43.000Z\",\n        \"message\": \"feat: add ralph iteration-timeout guard\",\n        \"author\": \"Jacob Chapel\",\n        \"task_refs\": [\n          \"01KJDQ17W\"\n        ]\n      },\n      \"task\": {\n        \"ref\": \"01KJDQ17W\",\n        \"slug\": null,\n        \"title\": \"Ralph loop needs iteration-level timeout. When a spawned agent gets stuck (e.g., tool call hanging o\",\n        \"completed_at\": \"2026-02-28T23:14:18.000Z\",\n        \"closed_reason\": \"Merged in PR #610. Implemented iteration-timeout hardening by capturing runIterationPrompts() promise and attaching catch before Promise.race to prevent Node.js 22 unhandled rejection on timeout/dispose path. Added/confirmed @cli-ralph ac-24/ac-25/ac-26 for iteration-timeout defaults, validation, and iteration.timeout event behavior, with AC annotations in tests/ralph.test.ts. Verified @cli-ralph AC annotation coverage across ac-1..ac-26 and green PR CI on merge commit 3935ca808c131813871ec5a48e7550f9a239a5a1.\"\n      }\n    },\n    {\n      \"type\": \"linked_commit\",\n      \"date\": \"2026-02-28T23:05:33.314Z\",\n      \"commit\": {\n        \"hash\": \"18ca84b\",\n        \"full_hash\": \"18ca84bc8b20998fce148644e19632d62777368d\",\n        \"date\": \"2026-02-28T23:05:21.000Z\",\n        \"message\": \"fix: keep warning-only plan import successful in batch (#609)\",\n        \"author\": \"Jacob Chapel\",\n        \"task_refs\": [\n          \"01KJDQ1B9C62DT55EK8WK01BP0\"\n        ]\n      },\n      \"task\": {\n        \"ref\": \"01KJDQ1B\",\n        \"slug\": null,\n        \"title\": \"Plan import warnings treated as errors in batch mode. The no YAML code block in specs section warnin\",\n        \"completed_at\": \"2026-02-28T23:05:33.314Z\",\n        \"closed_reason\": \"Merged in PR #609. Fixed batch-mode plan import by replacing process.exit(EXIT_CODES.SUCCESS) with return in plan-import.ts success path, preventing BatchExitError interception. Added regression test in batch-exec-engine.test.ts covering warning-only plan import succeeds in batch (ac-34, ac-23). All CI checks passed.\"\n      }\n    },\n    {\n      \"type\": \"linked_commit\",\n      \"date\": \"2026-02-28T23:05:33.314Z\",\n      \"commit\": {\n        \"hash\": \"eca0f63\",\n        \"full_hash\": \"eca0f6391629d681d64c87524a471dada1390a6e\",\n        \"date\": \"2026-02-28T22:37:02.000Z\",\n        \"message\": \"fix: keep warning-only plan import successful in batch\",\n        \"author\": \"Jacob Chapel\",\n        \"task_refs\": [\n          \"01KJDQ1B9C62DT55EK8WK01BP0\"\n        ]\n      },\n      \"task\": {\n        \"ref\": \"01KJDQ1B\",\n        \"slug\": null,\n        \"title\": \"Plan import warnings treated as errors in batch mode. The no YAML code block in specs section warnin\",\n        \"completed_at\": \"2026-02-28T23:05:33.314Z\",\n        \"closed_reason\": \"Merged in PR #609. Fixed batch-mode plan import by replacing process.exit(EXIT_CODES.SUCCESS) with return in plan-import.ts success path, preventing BatchExitError interception. Added regression test in batch-exec-engine.test.ts covering warning-only plan import succeeds in batch (ac-34, ac-23). All CI checks passed.\"\n      }\n    },\n    {\n      \"type\": \"linked_commit\",\n      \"date\": \"2026-02-28T22:19:13.639Z\",\n      \"commit\": {\n        \"hash\": \"69c3b62\",\n        \"full_hash\": \"69c3b626dd3218c543d810a42602d99843f7db98\",\n        \"date\": \"2026-02-28T22:18:59.000Z\",\n        \"message\": \"feat: add stale auto-abandon metadata helpers (#607)\",\n        \"author\": \"Jacob Chapel\",\n        \"task_refs\": [\n          \"implement-auto-abandon-metadata-and-audit-trail\"\n        ]\n      },\n      \"task\": {\n        \"ref\": \"01KJGBWP\",\n        \"slug\": \"implement-auto-abandon-metadata-and-audit-trail\",\n        \"title\": \"Implement Auto-abandon Metadata and Audit Trail\",\n        \"completed_at\": \"2026-02-28T22:19:13.639Z\",\n        \"closed_reason\": \"Merged in PR #607. Implemented stale auto-abandon metadata apply helper with canonical close_reason format, shared ended_at/status=abandoned updates, dry-run preview, and one command-specific shadow commit path for multi-session persistence. Verified AC coverage for @session-stale-close-metadata ac-1..ac-4 in tests/session-stale-criteria.test.ts and confirmed green CI on commit 8131a376.\"\n      }\n    },\n    {\n      \"type\": \"linked_commit\",\n      \"date\": \"2026-02-28T22:19:13.639Z\",\n      \"commit\": {\n        \"hash\": \"8131a37\",\n        \"full_hash\": \"8131a376222f82b2cf75463731a4deaa19bc0c96\",\n        \"date\": \"2026-02-28T22:08:42.000Z\",\n        \"message\": \"fix: add shadow-commit support for stale auto-abandon metadata\",\n        \"author\": \"Jacob Chapel\",\n        \"task_refs\": [\n          \"implement-auto-abandon-metadata-and-audit-trail\"\n        ]\n      },\n      \"task\": {\n        \"ref\": \"01KJGBWP\",\n        \"slug\": \"implement-auto-abandon-metadata-and-audit-trail\",\n        \"title\": \"Implement Auto-abandon Metadata and Audit Trail\",\n        \"completed_at\": \"2026-02-28T22:19:13.639Z\",\n        \"closed_reason\": \"Merged in PR #607. Implemented stale auto-abandon metadata apply helper with canonical close_reason format, shared ended_at/status=abandoned updates, dry-run preview, and one command-specific shadow commit path for multi-session persistence. Verified AC coverage for @session-stale-close-metadata ac-1..ac-4 in tests/session-stale-criteria.test.ts and confirmed green CI on commit 8131a376.\"\n      }\n    },\n    {\n      \"type\": \"commit\",\n      \"date\": \"2026-02-28T22:08:35.000Z\",\n      \"commit\": {\n        \"hash\": \"ed22e4f\",\n        \"full_hash\": \"ed22e4f783bddf25cf5454ecc1e93a2a5d5e745c\",\n        \"date\": \"2026-02-28T22:08:35.000Z\",\n        \"message\": \"Revert \\\"feat: add ralph iteration-timeout guard\\\"\",\n        \"author\": \"Jacob Chapel\",\n        \"task_refs\": []\n      }\n    }\n  ],\n  \"working_tree\": {\n    \"clean\": true,\n    \"staged\": [],\n    \"unstaged\": [],\n    \"untracked\": []\n  },\n  \"inbox_items\": [\n    {\n      \"ref\": \"01KFH76C\",\n      \"text\": \"Cross-feature requirement pattern: How to express that core features (search, validate, export) must support all entity types. When new entity type added, should automatically imply tasks for core features. Options: (1) applies_to field on feature specs, (2) trait on entity types like @trait-searchable, (3) validation warning for missing coverage, (4) parent spec that entity types must satisfy. Surfaced when realizing search doesn't cover inbox.\",\n      \"created_at\": \"2026-01-21T21:25:59.163Z\",\n      \"tags\": [\n        \"design\",\n        \"spec-model\",\n        \"meta\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"spec-gap\"\n    },\n    {\n      \"ref\": \"01KFHJNZ\",\n      \"text\": \"Reverse spec lookup - kspec which <file> or kspec which <file:line> to find specs/ACs that reference or are implemented by a given code path. Useful for bug fixes to quickly discover what specs need updating. Could scan for // AC: annotations and spec_ref links. Instructive, helps find already-instrumented code.\",\n      \"created_at\": \"2026-01-22T00:46:44.345Z\",\n      \"tags\": [\n        \"dx\",\n        \"tooling\",\n        \"reflection\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KFPDCY\",\n      \"text\": \"Add cross-platform CI matrix testing - run core functionality tests on Windows, macOS, and Linux. Would catch issues like Unix-specific commands (which, cp -r) before they reach PR review. Consider: matrix strategy in GitHub Actions, platform-specific test skips where needed, focus on CLI commands and daemon lifecycle.\",\n      \"created_at\": \"2026-01-23T21:50:37.263Z\",\n      \"tags\": [\n        \"ci\",\n        \"testing\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KFQ517\",\n      \"text\": \"E2E tests: Use isolated port range (not 3456) + cross-platform cleanup. Current approach conflicts with existing daemons. Should use high ephemeral port range and improve cleanup mechanism.\",\n      \"created_at\": \"2026-01-24T04:43:39.058Z\",\n      \"tags\": [\n        \"e2e\",\n        \"testing\",\n        \"reflection\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KFYAHF\",\n      \"text\": \"E2E test dev mode - configure Playwright to work with vite dev server instead of requiring full build for faster test iteration (12+ seconds to 1-2 seconds)\",\n      \"created_at\": \"2026-01-26T23:34:35.746Z\",\n      \"tags\": [\n        \"e2e\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGG6GY\",\n      \"text\": \"Improve derive granularity: Research suggests specs with 4+ ACs are candidates for splitting. Potential enhancements: (1) --by-ac flag to create tasks per AC group, (2) --max-acs N to auto-group, (3) implementation_phases field in specs, (4) derive templates for common patterns (cli-command, api-endpoint), (5) complexity warnings when specs are too large. See session research on task decomposition patterns from Linear, Atlassian, BDD/Example Mapping, and AI coding assistants.\",\n      \"created_at\": \"2026-02-02T22:10:44.331Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGGEMM\",\n      \"text\": \"Daemon debugging improvements: (1) Add --log-file or --verbose to 'kspec serve start', (2) Log resolved web UI path on startup, (3) Capture and show stderr when daemon fails to start within timeout. Consolidated from @01KFQ586, @01KFQ595, @01KFPH3D.\",\n      \"created_at\": \"2026-02-03T00:32:32.926Z\",\n      \"tags\": [\n        \"daemon\",\n        \"dx\",\n        \"deferred\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGGF4Y\",\n      \"text\": \"Project config file (kspec.config.yaml or .kspecrc): Configure shadow remote URL (enable separate repo for specs), feature toggles, default values (author, priority), validation strictness. Enables multi-repo projects sharing specs and tailoring kspec to project needs. Consolidated from @01KFGVVJ, @01KFGVVN.\",\n      \"created_at\": \"2026-02-03T00:41:28.272Z\",\n      \"tags\": [\n        \"feature\",\n        \"config\",\n        \"dx\",\n        \"deferred\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGGFB2\",\n      \"text\": \"AC test coverage analysis: 'kspec coverage @spec-ref' command to scan codebase for '// AC: @spec ac-N' annotations and report which ACs have test coverage vs gaps. Soft check for review, not blocking. Consolidated from @01KFHJNR, @01KFP9A6.\",\n      \"created_at\": \"2026-02-03T00:44:48.658Z\",\n      \"tags\": [\n        \"cli\",\n        \"testing\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGGG0K\",\n      \"text\": \"Shadow sync improvements: (1) Auto-resolve using rebase/merge-driver for cleaner sync, (2) Make sync warnings visible in CLI output (currently silent unless KSPEC_DEBUG=1), (3) Auto-detect common issues with suggested fixes. Consolidated from @01KFTDA7, @01KFHZR4.\",\n      \"created_at\": \"2026-02-03T00:56:34.557Z\",\n      \"tags\": [\n        \"shadow\",\n        \"dx\",\n        \"cli\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGGKNX\",\n      \"text\": \"CLI array field flag patterns: (1) Generic --clear <field> or --<field> [] for clearing arrays, (2) --add-<field> vs multiple flags for append semantics. Design unified approach for depends-on, tags, blocked-by, etc. Consolidated from @01KFGRV6, @01KFR0KN.\",\n      \"created_at\": \"2026-02-03T02:00:37.758Z\",\n      \"tags\": [\n        \"cli\",\n        \"design\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGGP9F\",\n      \"text\": \"Inbox CLI improvements: (1) Add filtering to list: --before/--after <date>, --author <name> (--tag exists), (2) Add merge command: 'kspec inbox merge @source @target' for consolidating duplicates, (3) Add --priority and --automation flags to promote command. Consolidated from @01KG95JP, @01KG95JQ, @01KG95JS.\",\n      \"created_at\": \"2026-02-03T02:46:16.141Z\",\n      \"tags\": [\n        \"cli\",\n        \"inbox\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGGPJ6\",\n      \"text\": \"Workflow CLI improvements: (1) 'workflow show' should infer active run like 'workflow next', (2) Warn when --input flags passed but step has no inputs defined, (3) Improve 'workflow show' output format with vertical display, status indicators, indented notes. Consolidated from @01KFKSF6, @01KFKSGC, @01KFKTNR.\",\n      \"created_at\": \"2026-02-03T02:51:01.566Z\",\n      \"tags\": [\n        \"workflow\",\n        \"cli\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGGPSR\",\n      \"text\": \"Spec item slug/addressing improvements: (1) Warn/error on slug collision when creating items, (2) Make nested requirements addressable by slug (currently kspec item ac add @slug fails for items under requirements:). Consolidated from @01KGDCRG, @01KGDCRJ.\",\n      \"created_at\": \"2026-02-03T02:55:09.815Z\",\n      \"tags\": [\n        \"cli\",\n        \"validation\",\n        \"ux\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGGTT3\",\n      \"text\": \"Expand @trait-multi-ref-batch to remaining commands: trait add/remove, task set --automation, inbox delete, task note. Enables batch operations like 'kspec task note @ref1 @ref2 @ref3 \\\"shared content\\\"'. Consolidated from @01KG71J2, @01KG95JM, @01KFVXBM.\",\n      \"created_at\": \"2026-02-03T04:05:15.022Z\",\n      \"tags\": [\n        \"cli\",\n        \"batch\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGKVK9\",\n      \"text\": \"Add --spec-ref filter to kspec task list command to filter tasks by linked spec item\",\n      \"created_at\": \"2026-02-04T08:16:44.365Z\",\n      \"tags\": [\n        \"cli\",\n        \"reflection\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGQY6Q\",\n      \"text\": \"Workflow lifecycle CLI design (from mining run 01KFS6MJ): kspec workflow complete @run-ref (mark run completed, archive), kspec workflow cancel @run-ref (cancel abandoned run), kspec workflow cleanup --older-than Nd (auto-cancel stale runs). Extends existing @01KFPH39 auto-cleanup with concrete subcommand design.\",\n      \"created_at\": \"2026-02-05T22:19:16.313Z\",\n      \"tags\": [\n        \"workflow\",\n        \"cli\",\n        \"dx\",\n        \"deferred\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGVK8R\",\n      \"text\": \"Item list --module flag and tree view: kspec item list --module cli to scope output to a specific module. kspec item tree @module for hierarchical view (features -> requirements). Currently 50+ items display flat, making it hard to find the right parent for new specs. Friction: during automation triage had to grep YAML files to find parent specs.\",\n      \"created_at\": \"2026-02-07T08:25:05.490Z\",\n      \"tags\": [\n        \"cli\",\n        \"dx\",\n        \"reflection\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGWG99\",\n      \"text\": \"Define typed event data schemas per EventType — session.start, session.update (with tool_call/sessionUpdate variants), session.end, prompt.sent, tool.call, tool.result, note. Current z.unknown() data field makes it impossible to reliably query events without reverse-engineering from real JSONL files.\",\n      \"created_at\": \"2026-02-07T16:52:11.891Z\",\n      \"tags\": [\n        \"reflection\",\n        \"sessions\",\n        \"schema\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGWQ2T\",\n      \"text\": \"Session log compaction: at end of each ralph loop, replace raw events.jsonl with a compiled stats file (event counts by type, tool usage frequency, duration, task transitions, error summary). Keep session folders and context snapshots intact but prune the raw log. This gives trend analysis capability without unbounded log growth. Could be a kspec session compact command or automatic post-loop step.\",\n      \"created_at\": \"2026-02-07T18:51:00.259Z\",\n      \"tags\": [\n        \"deferred\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KGWZR7\",\n      \"text\": \"Active context from meta: use the meta database (observations, conventions, patterns) as a dynamic context source that automatically surfaces relevant entries based on current activity. E.g. when reviewing plan-import code, auto-surface friction observations tagged with plan-import. When doing code review, pull in resolved friction patterns as review priors. Replaces manual markdown maintenance (AGENTS.md, skill docs) with structured data that stays current as observations accumulate. Could use conventions or a new meta item type for durable patterns distinct from one-off observations.\",\n      \"created_at\": \"2026-02-07T21:22:29.717Z\",\n      \"tags\": [\n        \"reflection\",\n        \"meta\",\n        \"architecture\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KH20S1\",\n      \"text\": \"Centralize daemon port default (3456) — currently hardcoded in 6 places: src/schema/spec.ts, src/cli/index.ts, src/cli/commands/serve.ts, packages/daemon/src/index.ts, packages/web-ui/src/lib/constants.ts, packages/web-ui/tests/fixtures/test-base.ts. Extract to a shared constant to prevent drift.\",\n      \"created_at\": \"2026-02-09T20:16:36.881Z\",\n      \"tags\": [\n        \"code-hygiene\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHA982\",\n      \"text\": \"Formalize CLI usage analysis as a repeatable workflow. Tools exist in .claude-research/tools/ (parse-ralph-logs.mjs, parse-claude-logs.mjs, compile-data.mjs) plus interactive HTML report. Consider: kspec skill, CLI command, or standalone workflow. Re-run after implementing the 6 CLI agent-UX improvements to measure impact.\",\n      \"created_at\": \"2026-02-13T01:18:34.385Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHCYW7\",\n      \"text\": \"Add repeated-flag support to --status filter (ac-repeated-flag gap from PR #354). Commander.js .option() needs a collect function to accumulate repeated --status flags into an array. Currently only comma-separated works. Small fix: change .option('-s, --status <status>') to use Commander's variadic/collect pattern, then feed array into parseMultiStatus().\",\n      \"created_at\": \"2026-02-14T02:15:03.519Z\",\n      \"tags\": [\n        \"cli\",\n        \"dx\",\n        \"reflection\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHF37M\",\n      \"text\": \"Shadow branch diff/changelog — since .kspec/ is git-tracked, we could show changes to stored artifacts (workflows, tasks, specs, inbox) over time. Something like kspec history @ref or kspec diff --since '1 week ago' that leverages the git history on kspec-meta branch. Could show task state transitions, spec evolution, workflow modifications, etc.\",\n      \"created_at\": \"2026-02-14T22:09:40.225Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHFCDS\",\n      \"text\": \"Version pinning: all projects use whatever global kspec version is installed. No lock file or constraint resolution. Consider adding version constraints to kynetic.yaml manifest.\",\n      \"created_at\": \"2026-02-15T00:50:18.887Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHFCDS\",\n      \"text\": \"Memory seeding: seed MEMORY.md with project-relevant starting notes during kspec setup. Could bootstrap agent effectiveness in new projects.\",\n      \"created_at\": \"2026-02-15T00:50:18.899Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHG6F1\",\n      \"text\": \"Tech debt: Pre-existing test anti-patterns - daemon-api-projects.test.ts has 10 no-op tests behind existsSync guards. ralph.test.ts and ralph-context-refresh.test.ts have conditional assertions without preceding guard assertions. Not from ralph loop but should fix.\",\n      \"created_at\": \"2026-02-15T08:25:22.783Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHHJ27\",\n      \"text\": \"Fix daemon-executable.test.ts - bun build --compile fails when routes import from parent packages. Pre-existing failure, root cause: ESM imports from parent packages can't be bundled. AC-16 on @daemon-server claimed complete but test doesn't pass.\",\n      \"created_at\": \"2026-02-15T21:07:20.590Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHHJMA\",\n      \"text\": \"kspec tasks assess automation --all should display stored automation status (eligible/needs_review/manual_only) alongside criteria recommendation. Currently only shows criteria-based recommendation even for already-assessed tasks, making it impossible to verify batch operations.\",\n      \"created_at\": \"2026-02-15T21:17:13.469Z\",\n      \"tags\": [\n        \"kspec-cli\",\n        \"reflection\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHJ4RV\",\n      \"text\": \"Silent error swallowing in setup pipeline: multiple bare catch {} blocks in setup.ts lose diagnostic info. At minimum should log at debug/verbose level for troubleshooting.\",\n      \"created_at\": \"2026-02-16T02:34:16.813Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHJ4RV\",\n      \"text\": \"Legacy renderClaudeCodeSkill diverges from claudeCodeRenderer: uses old writeRenderHash (not platform-specific), lacks outputDir support, returns old type. setup.ts still uses it. Should route through registry and deprecate standalone function.\",\n      \"created_at\": \"2026-02-16T02:34:16.835Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHKTNJ\",\n      \"text\": \"Codex and Claude Code renderers share ~70% duplicated render logic (content loading, frontmatter stripping, idempotency check, file writing, hash storage, dir copying). Extract shared base render function with hooks for platform-specific steps.\\n\\n---\\n\\nTriage 2026-02-22: 8/13 sub-items RESOLVED by PRs #408 #412 #403. Remaining: getSetupStatus staleness, skill update mutation, naming inconsistency, redundant defaults, deprecated_target reuse.\",\n      \"created_at\": \"2026-02-16T18:16:11.540Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHKTNJ\",\n      \"text\": \"getSetupStatus always reports \\\"current\\\" if hash file exists, cannot detect staleness. Should load meta context and compare hash to detect when agents.md needs regeneration.\",\n      \"created_at\": \"2026-02-16T18:16:11.605Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHKTNJ\",\n      \"text\": \"skill update mutates loaded skill objects in-place before saveMetaItem. If save fails partway, in-memory state diverges from disk. Should copy before mutation.\",\n      \"created_at\": \"2026-02-16T18:16:11.623Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHKTNJ\",\n      \"text\": \"Naming inconsistency: isKspecManagedSkill (skill-render.ts) vs isKspecManaged (skill.ts) for same logic. Standardize to one name.\",\n      \"created_at\": \"2026-02-16T18:16:11.644Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHKTNJ\",\n      \"text\": \"Redundant platform/tags/depends_on defaults in skill CLI — manually set before SkillSchema.safeParse which already applies them. Remove manual defaults.\",\n      \"created_at\": \"2026-02-16T18:16:11.678Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHKTNJ\",\n      \"text\": \"deprecated_target warning type reused for skill-specific warnings (depends_on validation, orphaned dirs). Add proper skill warning types for better filtering.\",\n      \"created_at\": \"2026-02-16T18:16:11.692Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHKVQG\",\n      \"text\": \"Ralph loop consolidation pass: add a cleanup/consolidation iteration every N PRs or at loop end. The PR-by-PR review process misses cross-PR duplication accumulation — 32 PRs in last loop produced 24 inbox items of tech debt. A periodic consolidation step would catch dead code, duplicated utilities, and superseded implementations before they compound.\",\n      \"created_at\": \"2026-02-16T18:34:44.339Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHPYJ2\",\n      \"text\": \"Codex skill: handle own-PR reviews — GitHub rejects REQUEST_CHANGES on your own PRs, Codex should use COMMENT event instead. Bundle this fix with skill importing refinement so it propagates to all projects.\",\n      \"created_at\": \"2026-02-17T23:21:55.357Z\",\n      \"tags\": [\n        \"codex\",\n        \"skills\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHRTEV\",\n      \"text\": \"Task-specific ephemeral AC: Support acceptance criteria directly on tasks (not just via spec_ref). Useful for implementation requirements, refactoring criteria, and one-off work that doesn't warrant a spec item. Task ACs would be checked during review but wouldn't live in the spec hierarchy. Addresses the gap where plan-imported ACs are behavioral specs vs task-level implementation requirements.\",\n      \"created_at\": \"2026-02-18T16:48:43.957Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHRX2P\",\n      \"text\": \"skill-render.ts lines 492, 730, 924 have LF-only frontmatter regexes. Low risk in render path (kspec generates these files with LF) but should be hardened for consistency with the CRLF fixes in skill.ts/validate-skills.ts.\",\n      \"created_at\": \"2026-02-18T17:34:31.166Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHSJJR\",\n      \"text\": \"Feature request: ralph loop boundary tracking in session logs. Currently no easy way to see what happened in a ralph loop iteration without cross-referencing PR timestamps, git log, and task states. A session log showing PR-to-task mapping per loop iteration would help audit and review. Originated from imgen project observation.\",\n      \"created_at\": \"2026-02-18T23:50:17.810Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHV3EX\",\n      \"text\": \"Design section configuration for agents generate — allow projects to control which sections appear (skills table, conventions, workflows, static templates). Key questions: where does config live, include vs exclude list, defaults, custom sections, ordering, data vs template distinction, migration path. See plan doc for full requirements.\",\n      \"created_at\": \"2026-02-19T14:04:31.825Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"spec-gap\"\n    },\n    {\n      \"ref\": \"01KHVCPE\",\n      \"text\": \"Inbox tag management: no way to add/remove tags on existing inbox items. Only settable at creation via inbox add --tag. Need: kspec inbox tag add @ref <tag> and kspec inbox tag remove @ref <tag>.\",\n      \"created_at\": \"2026-02-19T16:45:56.496Z\",\n      \"tags\": [\n        \"inbox\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHVCPE\",\n      \"text\": \"Batch command arg naming inconsistency: inbox add accepts tag (singular) not tags. No documentation of which args each batch command accepts. Consider: consistent plural naming or better error messages with valid arg list.\",\n      \"created_at\": \"2026-02-19T16:45:56.513Z\",\n      \"tags\": [\n        \"batch\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHVCPE\",\n      \"text\": \"Stale workflow runs accumulate: no way to prune or auto-expire old runs. After many sessions, every workflow next command requires specifying a run ID because 7+ active runs exist. Need: kspec workflow prune (expire runs older than N days) or kspec workflow cancel @run-id.\",\n      \"created_at\": \"2026-02-19T16:45:56.528Z\",\n      \"tags\": [\n        \"workflow\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHVE47\",\n      \"text\": \"When spawning parallel review agents (e.g. Codex + /pr-review), instruct the /pr-review agent not to merge — only review. The parent agent should control the merge decision after all reviews complete. Update /pr-review skill or add a --no-merge flag.\",\n      \"created_at\": \"2026-02-19T17:10:56.412Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHVQVV\",\n      \"text\": \"Template/example repo for new kspec consumers: either a GitHub template repo or 'kspec create-project' command showing a fully configured consumer project (manifest, CLAUDE.md with @kspec-agents.md, skills, hooks). Real consumer projects (kynetic-bot, imgen, comfy-ecaj-nodes) serve as informal examples but a clean minimal template would lower onboarding friction.\",\n      \"created_at\": \"2026-02-19T20:01:07.957Z\",\n      \"tags\": [\n        \"dx\",\n        \"external\",\n        \"adoption\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHVR5K\",\n      \"text\": \"Per-module task files and task archiving: Original design intent was project.tasks.yaml for non-spec tasks, <module>.tasks.yaml for module-scoped tasks. Never fully implemented — everything goes to project.tasks.yaml. Tradeoffs: splitting reduces file size (comfy-ecaj-nodes has 97 tasks in one file) but requires reading more files. Related: need task archiving to move completed tasks out of the active file. Both address the same scaling problem (task files growing unbounded) from different angles.\",\n      \"created_at\": \"2026-02-19T20:06:26.877Z\",\n      \"tags\": [\n        \"design\",\n        \"tasks\",\n        \"scaling\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHWTXF\",\n      \"text\": \"kspec validate @spec or @task — targeted validation that checks a single spec/task's AC coverage against codebase. Not full approval, just verifies each AC has at least one // AC: annotation in test files. Would make trait AC gaps immediately visible during task-work. Could be used by local-review skill as a concrete check instead of relying on agent diligence.\",\n      \"created_at\": \"2026-02-20T06:13:40.815Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"spec-gap\"\n    },\n    {\n      \"ref\": \"01KHWWM9\",\n      \"text\": \"CLI DX: accept tags as alias for tag in batch commands\",\n      \"created_at\": \"2026-02-20T06:43:36.989Z\",\n      \"tags\": [\n        \"dx\",\n        \"cli\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHWWMA\",\n      \"text\": \"CLI DX: accept spec_ref as alias for spec-ref in batch commands\",\n      \"created_at\": \"2026-02-20T06:43:38.301Z\",\n      \"tags\": [\n        \"dx\",\n        \"cli\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHWWMC\",\n      \"text\": \"CLI DX: accept P1/P2/P3 format as alias for numeric priority in batch commands\",\n      \"created_at\": \"2026-02-20T06:43:39.734Z\",\n      \"tags\": [\n        \"dx\",\n        \"cli\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHWWMD\",\n      \"text\": \"CLI DX: add --description flag to task set command (currently requires task patch --data)\",\n      \"created_at\": \"2026-02-20T06:43:41.083Z\",\n      \"tags\": [\n        \"dx\",\n        \"cli\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHY9YB\",\n      \"text\": \"Terminal exit code display in ralph CLI renderer — claude-agent-acp PR #316 adds _meta.terminal_exit.exit_code on Bash tool completions (opt-in via clientCapabilities._meta.terminal_output). Low priority, ~40 lines across events.ts + cli-renderer.ts. Only concrete gain from the terminal streaming protocol — the output data itself is identical to existing _meta.claudeCode.toolResponse path. Worth adopting if Bash failure debugging becomes a pain point.\",\n      \"created_at\": \"2026-02-20T19:55:32.246Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHYAGZ\",\n      \"text\": \"Bash code fence language change in claude-agent-acp v0.18.0 — formatted Bash output changed from ```sh to ```console. Check if ralph's noise suppression patterns, session log rendering, or any regex patterns in cli-renderer.ts or events.ts match on the code fence language. Low risk since ralph primarily reads from _meta.claudeCode.toolResponse not content blocks, but worth a grep.\",\n      \"created_at\": \"2026-02-20T20:05:43.175Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHYAV7\",\n      \"text\": \"Surface ACP usage/cost data in ralph session stats — after SDK bump to 0.14.x, new Usage/UsageUpdate/Cost types are available. Could add token usage per iteration and cumulative cost to session log stats and web UI. The usage_update SessionUpdate variant fires during sessions with context window utilization data.\\n\\n---\\n\\nIMPORTANT FINDING: Neither claude-agent-acp nor codex-acp actually emit usage_update events or populate PromptResponse.usage. Both have raw token data available but discard it. kynetic-bot works around this by scraping /context stderr (fragile regex). Upstream PR to claude-agent-acp is highest-value path — Anthropic API stream events contain usage data, just needs wiring to ACP protocol.\",\n      \"created_at\": \"2026-02-20T20:11:19.317Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHYDW5\",\n      \"text\": \"Explore CLAUDE_CODE_SIMPLE mode for ralph loops — sets minimal system prompt with only Bash, file read, and file edit tools. Disables MCP tools, attachments, hooks, and CLAUDE.md. Could reduce token overhead and speed up startup, but ralph would need to inject all project context (AGENTS.md rules, spec-first workflow, kspec conventions) into the prompt itself instead of relying on Claude Code's built-in mechanisms. Tradeoff: simpler/faster agent vs ralph becomes responsible for all context bootstrapping. Ref: anthropics/claude-code#27019\",\n      \"created_at\": \"2026-02-20T21:04:14.935Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHYFD9\",\n      \"text\": \"Ralph worktree isolation for task work — spawn each agent in a git worktree under a gitignored .worktrees/ dir for branch isolation. Pattern proven in kynetic-internal with jj workspaces. Key insight: kspec resolves .kspec/ via git root, but worktrees return their own root from rev-parse --show-toplevel. Solution: ralph sets KSPEC_SPEC_DIR to point to main tree's .kspec/ when spawning agents (env var already exists for batch mode). Benefits: isolated branches per task, parallel agent work, trivial cleanup of failed work, clean main branch. Unknowns: shadow branch commands from worktree context, git config inheritance, worktree lifecycle management in ralph.\",\n      \"created_at\": \"2026-02-20T21:31:05.321Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHYTNN\",\n      \"text\": \"Single-source task state diagram: currently duplicated in AGENTS.md, templates/agents-sections/03-task-lifecycle.md, and src/cli/help/content.ts. Adding needs_work required updating all three independently. Generate from schema or single template to avoid triple-update when adding states.\",\n      \"created_at\": \"2026-02-21T00:47:53.828Z\",\n      \"tags\": [\n        \"reflection\",\n        \"dx\",\n        \"agents\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KHYTNN\",\n      \"text\": \"Distinguish behavioral vs testable ACs in kspec validate: workflow ACs (agent behavioral specs enforced by skills/prompts) get flagged as uncovered in test coverage, creating false MUST-FIX findings in reviews. Allow tagging ACs or specs as agent-enforced to report separately from code-testable ACs.\",\n      \"created_at\": \"2026-02-21T00:47:53.854Z\",\n      \"tags\": [\n        \"reflection\",\n        \"validate\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KJ0K9C\",\n      \"text\": \"inbox promote missing --slug option: cannot set task slug during promotion, must use default auto-generated slug. Add --slug <slug> option to inbox promote command.\",\n      \"created_at\": \"2026-02-21T17:17:20.221Z\",\n      \"tags\": [\n        \"cli\",\n        \"dx\",\n        \"reflection\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KJ1RW3\",\n      \"text\": \"CLI gap: kspec skill set should support --id to rename a skill without delete+recreate\",\n      \"created_at\": \"2026-02-22T04:14:10.666Z\",\n      \"tags\": [\n        \"cli\",\n        \"skill\",\n        \"friction\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KJ27VR\",\n      \"text\": \"Spec and test kspec behavior without git: ensure kspec works in projects without git initialized, and handles git being introduced into an existing project where kspec is already in use. Cover shadow branch initialization, worktree setup on first git init, migration of .kspec/ state when git appears, and graceful degradation of git-dependent features (auto-commit, sync, shadow status).\",\n      \"created_at\": \"2026-02-22T08:36:08.131Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KJ3318\",\n      \"text\": \"Session checkpoint hook noise: fires repeatedly for intentionally uncommitted files (e.g. generated reports). No way to suppress for specific paths. Could support .kspec/checkpoint-ignore listing paths to exclude from dirty-tree check, or respect gitignore-like patterns. Fired 6+ times in one session for a triage report artifact.\",\n      \"created_at\": \"2026-02-22T16:31:00.545Z\",\n      \"tags\": [\n        \"reflection\",\n        \"hooks\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KJ331E\",\n      \"text\": \"CLI parity: kspec task add requires --title flag but kspec inbox add accepts positional text argument. task add should accept positional title for consistency. Small change in Commander.js argument definition.\",\n      \"created_at\": \"2026-02-22T16:31:06.276Z\",\n      \"tags\": [\n        \"reflection\",\n        \"cli\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KJ35CN\",\n      \"text\": \"Plugin registry tests: validate structurally instead of exact output matching. Current tests assert exact JSON shapes (e.g. source field structure) which breaks when Claude Code schema evolves. Better: (1) Validate marketplace.json against a Zod schema capturing required fields (plugins array, name, source, version) rather than exact values. (2) Test build output structurally — 'has plugins array with our entry' not exact field matching. (3) For known_marketplaces.json registry, test entry exists with valid path, not exact source object shape. Motivation: the source field assertion broke twice already (local → directory object) because tests coupled to implementation details.\",\n      \"created_at\": \"2026-02-22T17:12:10.776Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KJ43CP\",\n      \"text\": \"Include triage records in static snapshot (kspec-snapshot.json). Currently the snapshot format (KspecSnapshot type) doesn't include triage records, so the triage page in static/GitHub Pages mode shows an empty state with a notice instead of displaying existing triage decisions read-only. AC-8 of @interactive-triage-ui expects read-only display. Needs: add triage records to export snapshot, update KspecSnapshot type, add fetchTriageRecordsStatic to read from snapshot.\",\n      \"created_at\": \"2026-02-23T01:56:29.205Z\",\n      \"tags\": [\n        \"feature\",\n        \"web-ui\",\n        \"static-mode\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"spec-gap\"\n    },\n    {\n      \"ref\": \"01KJ4FFA\",\n      \"text\": \"Web UI list pages hardcode limit: 1000 with no pagination — triage page confirmed, likely affects inbox/tasks pages too. Silent truncation for large datasets. Need pagination or virtual scrolling pattern across all list views.\",\n      \"created_at\": \"2026-02-23T05:27:38.653Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KJ4KFA\",\n      \"text\": \"Trait AC annotation gaps on @triage-cli-commands: @trait-error-guidance ac-3, @trait-semantic-exit-codes ac-3/4/6/7, @trait-filterable-list ac-2, @trait-shadow-commit ac-2/3/4/6/7/8, @trait-dry-run ac-4/6. Pre-existing, not introduced by PR #458.\",\n      \"created_at\": \"2026-02-23T06:37:32.984Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KJ4TET\",\n      \"text\": \"Web UI WebSocket connection unreliable - continually disconnects and reconnects. Needs investigation into reconnection logic, heartbeat handling, or fallback to polling.\",\n      \"created_at\": \"2026-02-23T08:39:36.357Z\",\n      \"tags\": [\n        \"bug\",\n        \"web-ui\",\n        \"daemon\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJ4TET\",\n      \"text\": \"Web UI triage page: add filter controls for triage action types (promote, delete, defer, spec-gap, duplicate). Currently no way to filter triage records by action.\",\n      \"created_at\": \"2026-02-23T08:39:36.389Z\",\n      \"tags\": [\n        \"feature\",\n        \"web-ui\",\n        \"triage\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJ4TET\",\n      \"text\": \"Web UI: persist all filter state and current view in URL query params so refreshing the page preserves state. Applies to all list/filter pages (triage, inbox, tasks, etc).\",\n      \"created_at\": \"2026-02-23T08:39:36.406Z\",\n      \"tags\": [\n        \"feature\",\n        \"web-ui\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJ4VDK\",\n      \"text\": \"Triage promote action should optionally delete the inbox item after creating the task. Currently promoted items stay in inbox requiring manual cleanup. Consider --consume flag or making deletion the default for promote (with snapshot preserved in triage record).\",\n      \"created_at\": \"2026-02-23T08:56:24.534Z\",\n      \"tags\": [\n        \"triage\",\n        \"dx\",\n        \"reflection\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJ4VHN\",\n      \"text\": \"ULID short ref ambiguity in batch operations: when two ULIDs share a prefix (e.g. 01KJ4SNE9 and 01KJ4SNEC), short refs like @01KJ4SNE fail. kspec already has a shortest-unique-ID utility — this should be used anywhere refs are displayed (triage list, task list, inbox list, promote result_ref, etc.) so that presented refs are always unambiguous and copy-pasteable into subsequent commands.\",\n      \"created_at\": \"2026-02-23T08:58:37.792Z\",\n      \"tags\": [\n        \"cli\",\n        \"dx\",\n        \"batch\",\n        \"reflection\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJ63QD\",\n      \"text\": \"Agents should check plan_ref when starting tasks. If a task has plan_ref, run kspec plan get @plan-ref to read implementation notes, algorithm details, and context. Update task-work skill and task-work-loop workflow to include this step. Plans are the right place for rich implementation context instead of cramming it into task notes.\",\n      \"created_at\": \"2026-02-23T20:40:49.913Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJ63RW\",\n      \"text\": \"Plan import --update replaces all ACs instead of merging. When extending an existing spec with a new AC via plan import, --update overwrites acceptance_criteria entirely. Need AC-merge strategy: append new AC IDs, preserve existing ones. Encountered during spec-plan for session-log-show ac-10.\",\n      \"created_at\": \"2026-02-23T20:41:37.216Z\",\n      \"tags\": [\n        \"reflection\",\n        \"plan-import\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJ63RW\",\n      \"text\": \"Plan import warnings treated as errors in batch mode. The no YAML code block in specs section warning causes batch atomic rollback even though the task creation succeeded. Warnings should not cause batch failure — only actual errors should.\",\n      \"created_at\": \"2026-02-23T20:41:37.244Z\",\n      \"tags\": [\n        \"reflection\",\n        \"batch\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJ67G4\",\n      \"text\": \"Ralph event handler iteration attribution should use session-scoped mapping instead of shared mutable currentIteration. Codex review on PR #484 identified that late updates from a previous ACP session can still be tagged with wrong iteration. Use session_id→iteration map or session-scoped listener. See PR #484 review comment.\",\n      \"created_at\": \"2026-02-23T21:46:45.158Z\",\n      \"tags\": [\n        \"ralph\",\n        \"events\",\n        \"bug\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJ6KTD\",\n      \"text\": \"CLI args should accept both kebab-case and underscore variants (e.g. depends-on and depends_on). Currently batch commands reject underscore variants even though the error message suggests the kebab form. Normalizing both forms would reduce friction, especially for agents generating JSON batch payloads where underscore is the natural convention.\",\n      \"created_at\": \"2026-02-24T01:22:04.870Z\",\n      \"tags\": [\n        \"cli\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJ6ZXC\",\n      \"text\": \"kspec batch --commands '' hangs instead of erroring — empty/missing args should fail fast with a clear error, not block on stdin. Discovered when ralph loop got stuck calling batch with empty string arg.\",\n      \"created_at\": \"2026-02-24T04:53:24.637Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJ76Y8\",\n      \"text\": \"Session-scoped workflow runs: workflow runs could carry a session_id, filtering workflow show/list to current session by default. Session end could auto-close orphaned runs. Reduces noise when multiple sessions active (ralph + interactive). Natural fit since workflows are already ephemeral.\",\n      \"created_at\": \"2026-02-24T06:56:13.360Z\",\n      \"tags\": [\n        \"session\",\n        \"workflows\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KJ778T\",\n      \"text\": \"Ralph loop logs 'Unexpected case' for rate_limit_event messages from Claude API. These are informational SSE events (status: allowed) that the event handler doesn't recognize. Should either handle gracefully (ignore/log at debug level) or add to known event types. Currently noisy in ralph output.\",\n      \"created_at\": \"2026-02-24T07:01:59.509Z\",\n      \"tags\": [\n        \"ralph\",\n        \"dx\",\n        \"cli\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KJ77S4\",\n      \"text\": \"Ralph loop needs iteration-level timeout. When a spawned agent gets stuck (e.g., tool call hanging on stdin), ralph has no mechanism to detect or recover. A configurable per-iteration timeout (e.g., 15-20 min) that kills the stuck agent and logs the failure would prevent indefinite hangs. Separate from Claude Code's per-bash-command timeout which didn't prevent the kspec batch stdin hang.\",\n      \"created_at\": \"2026-02-24T07:10:54.335Z\",\n      \"tags\": [\n        \"ralph\",\n        \"reliability\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJ7CNA\",\n      \"text\": \"Shadow branch index inconsistency: observation @01KJ73ME appeared in search results but failed on kspec item get. Possible write conflict or index corruption during ralph loop session. Investigate shadow branch integrity.\",\n      \"created_at\": \"2026-02-24T08:36:12.919Z\",\n      \"tags\": [\n        \"shadow-branch\",\n        \"bug\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJ8N68\",\n      \"text\": \"Ralph CLI renderer: parallel tool calls produce confusing output. tool_result events render sequentially with no association to their tool_start, so when multiple tools run in parallel, results appear under the wrong header. Fix: include tool summary (e.g. filename) in the completed/failed status line so each result is self-identifying regardless of interleaving.\",\n      \"created_at\": \"2026-02-24T20:24:30.082Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KJ8NDT\",\n      \"text\": \"Tests fail when run inside ralph loop due to environment contamination: (1) ralph.test.ts KSPEC_RALPH_SESSION assertion expects null but env var is inherited from ralph process, (2) session-create.test.ts active session warning in stderr breaks JSON parsing, (3) session-budget-integration.test.ts references nonexistent task set-automation command. Tests should isolate from parent process env vars (KSPEC_RALPH_SESSION, KSPEC_SESSION_ID) to be reliable in all contexts.\",\n      \"created_at\": \"2026-02-24T20:28:38.662Z\",\n      \"tags\": [\n        \"testing\",\n        \"ralph\",\n        \"environment\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJ8X52\",\n      \"text\": \"Session event log tool-level filtering: kspec session log show <id> --tool Read would avoid grep/python one-liners when debugging ralph event issues\",\n      \"created_at\": \"2026-02-24T22:43:39.859Z\",\n      \"tags\": [\n        \"cli\",\n        \"ralph\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KJ93W2\",\n      \"text\": \"kspec task set --priority accepts numbers (1-5) but all documentation, conventions, and plan documents use P1/P2/P3 notation. Error message says 'Priority must be a number between 1 and 5' which is confusing when you've been writing P1 everywhere. Should either accept both formats or align documentation with the numeric API.\",\n      \"created_at\": \"2026-02-25T00:41:05.500Z\",\n      \"tags\": [\n        \"dx\",\n        \"docs\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJ9BEN\",\n      \"text\": \"kspec meta set convention: add --update-rule and --remove-rule flags. Currently the only way to fix a rule is to delete the entire convention and recreate it. Surfaced during skill CLI lookups task when codex review caught a wording issue in one rule.\",\n      \"created_at\": \"2026-02-25T02:53:34.540Z\",\n      \"tags\": [\n        \"cli\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"spec-gap\"\n    },\n    {\n      \"ref\": \"01KJ9NJC\",\n      \"text\": \"kspec setup should work without CLAUDECODE=1 env var in non-interactive contexts. Either add a --agent flag (e.g. kspec setup --agent claude-code) to explicitly specify the agent type, or detect based on installed tooling (~/.claude exists) rather than requiring runtime env vars. Discovered while building containerized ralph runner — entrypoint bash script can't set CLAUDECODE=1 globally because claude blocks nested sessions.\",\n      \"created_at\": \"2026-02-25T05:50:21.943Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJA6SX\",\n      \"text\": \"kspec agents generate should include package version in content hash (or add --force flag) so version bumps during releases automatically trigger regeneration. Currently skips because content is identical, but the version comment in the header is stale. Workaround: manually edit the version line.\",\n      \"created_at\": \"2026-02-25T10:51:35.115Z\",\n      \"tags\": [\n        \"cli\",\n        \"dx\",\n        \"release\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJA6SX\",\n      \"text\": \"Ralph PR merge should auto-delete remote branches after merge. Currently accumulates stale branches (found 13 after one session). The gh pr merge command supports --delete-branch. Add to pr-review-loop workflow merge step.\",\n      \"created_at\": \"2026-02-25T10:51:35.149Z\",\n      \"tags\": [\n        \"ralph\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJA6SX\",\n      \"text\": \"Session summary/stats command — kspec session stats @id or kspec session show @id --summary. Parse events.jsonl to show: iteration count, tasks started/completed/blocked, PRs created/merged, total duration, exit reason. Currently requires custom python scripts to extract from 14k+ line event logs.\",\n      \"created_at\": \"2026-02-25T10:51:35.173Z\",\n      \"tags\": [\n        \"cli\",\n        \"session\",\n        \"dx\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"defer\"\n    },\n    {\n      \"ref\": \"01KJBQ62\",\n      \"text\": \"@cmd-validate spec is stale — missing flags: --completeness, --staleness, --drift, --alignment, --skills, --conventions (all already implemented in code). Pre-existing drift, not introduced by trait AC task.\",\n      \"created_at\": \"2026-02-26T00:57:05.085Z\",\n      \"tags\": [],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"spec-gap\"\n    },\n    {\n      \"ref\": \"01KJCTQG\",\n      \"text\": \"Fix @observations slug ambiguity — kspec validate reports 6 errors for duplicate slug. Pre-existing issue across main.\",\n      \"created_at\": \"2026-02-26T11:18:16.551Z\",\n      \"tags\": [\n        \"bug\",\n        \"schema\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJCTQG\",\n      \"text\": \"Triage API spec says ac-4 and ac-5 use PUT method but implementation uses POST /:ref/override and POST /:ref/act. Spec needs updating to match reality.\",\n      \"created_at\": \"2026-02-26T11:18:16.589Z\",\n      \"tags\": [\n        \"bug\",\n        \"spec\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"spec-gap\"\n    },\n    {\n      \"ref\": \"01KJCTQG\",\n      \"text\": \"Triage ac-5 says sets result_ref but delete action may not produce one. Verify behavior and update spec or add test assertion.\",\n      \"created_at\": \"2026-02-26T11:18:16.618Z\",\n      \"tags\": [\n        \"spec\",\n        \"cli\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"spec-gap\"\n    },\n    {\n      \"ref\": \"01KJCXMR\",\n      \"text\": \"kspec task patch appears to hang indefinitely — had to kill and use task set + task note as workaround\",\n      \"created_at\": \"2026-02-26T12:09:11.586Z\",\n      \"tags\": [\n        \"cli\",\n        \"bug\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJDFFJ\",\n      \"text\": \"Plan import: generate richer task descriptions from Implementation Notes section — include file paths, what to change, verification steps instead of generic 'See plan...' text\",\n      \"created_at\": \"2026-02-26T17:20:56.270Z\",\n      \"tags\": [\n        \"cli\",\n        \"reflection\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"spec-gap\"\n    },\n    {\n      \"ref\": \"01KJDFFJ\",\n      \"text\": \"Merge driver: auto-resolve .kspec-agents-hash file conflicts (deterministic hash, should always take latest)\",\n      \"created_at\": \"2026-02-26T17:20:56.295Z\",\n      \"tags\": [\n        \"infra\",\n        \"reflection\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"spec-gap\"\n    },\n    {\n      \"ref\": \"01KJDFFJ\",\n      \"text\": \"Shadow repair: handle missing /bin/sh — use direct git commands instead of spawning shell, fails on fish-only systems\",\n      \"created_at\": \"2026-02-26T17:20:56.317Z\",\n      \"tags\": [\n        \"cli\",\n        \"reflection\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": true,\n      \"triage_action\": \"promote\"\n    },\n    {\n      \"ref\": \"01KJDXC0\",\n      \"text\": \"Handle EPIPE in ACP framing layer — src/acp/framing.ts send() throws uncaught EPIPE when child process pipe is dead during shutdown. Should catch EPIPE and treat as connection-closed. Currently requires process-level uncaughtException handlers in tests that spawn/kill agents.\",\n      \"created_at\": \"2026-02-26T21:23:39.292Z\",\n      \"tags\": [\n        \"bug\",\n        \"acp\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJDZBA\",\n      \"text\": \"Add second mock adapter registration for ralph tests. Currently --adapter-cmd registers a single 'custom' adapter, making it impossible to test different adapter IDs in real (non-dry-run) runs. Options: (1) --worker-adapter-cmd / --reviewer-adapter-cmd flags, (2) env-based adapter registration (e.g. KSPEC_TEST_ADAPTERS JSON), (3) allow --adapter-cmd to accept an optional name prefix like --adapter-cmd 'worker:node mock.js'. This would enable proper integration tests for ac-2 (reviewer subagent uses reviewer adapter), ac-7 (env injection for both adapters with different harness targets), and ac-12 (different adapter IDs in session metadata). Currently these are covered by code-level AC annotations and dry-run output tests, but lack end-to-end verification with the mock ACP.\",\n      \"created_at\": \"2026-02-26T21:58:14.307Z\",\n      \"tags\": [\n        \"testing\",\n        \"ralph\",\n        \"infra\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJF69V\",\n      \"text\": \"kspec validate should warn about items with identical titles in the same module — two items both named 'Generation Progress UX' with different ULIDs caused confusion during a fix session in imgen project\",\n      \"created_at\": \"2026-02-27T09:19:00.640Z\",\n      \"tags\": [\n        \"cli\",\n        \"validation\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJG5A7\",\n      \"text\": \"Task budget false-positive outside ralph loop when stale KSPEC_SESSION_ID is present (observed in codex session). Repro: with KSPEC_SESSION_ID set to an old session that has budget.json started_this_cycle=max_per_cycle, 'kspec task start @ref' fails with 'Task budget exhausted ... let iteration end naturally' even when not running ralph and no in-progress tasks. Expected: budget guard should apply only during active ralph loop iteration context, or stale/non-ralph session IDs should be ignored.\",\n      \"created_at\": \"2026-02-27T18:20:58.984Z\",\n      \"tags\": [\n        \"bug\",\n        \"ralph\",\n        \"codex\",\n        \"sessions\"\n      ],\n      \"added_by\": \"Jacob Chapel\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJGA18\",\n      \"text\": \"Diagnose skill verify drift/no-hash for plugin-provided core skills.\\n\\nObserved behavior:\\n- kspec skill verify reports codex statuses as drifted/no-hash for help, observations, triage, reflect, triage-inbox, writing-specs.\\n- kspec skill diff reports plugin-provided (no local render to diff).\\n- Rendered skill files exist under .agents/skills.\\n\\nInvestigate:\\n- render-hash semantics in .kspec/skills for plugin-provided skills\\n- plugin-provided status handling in skill verify/status/diff paths\\n- whether this is expected behavior or a bug in drift detection\",\n      \"created_at\": \"2026-02-27T19:43:28.105Z\",\n      \"tags\": [\n        \"bug\",\n        \"infra\",\n        \"skills\",\n        \"setup\"\n      ],\n      \"added_by\": \"Jacob Chapel\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJGAE2\",\n      \"text\": \"task set --description: task set has no --description option, making it impossible to update task descriptions after creation. Workaround: add detailed task notes. Came up when plan-derived task had null description and needed standalone context for automation.\",\n      \"created_at\": \"2026-02-27T19:50:27.203Z\",\n      \"tags\": [\n        \"cli\",\n        \"tasks\",\n        \"friction\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJGAE2\",\n      \"text\": \"derive_from_specs produces sparse tasks: derived tasks get null description, no tags, automation unassessed. Agents picking up these tasks lack context to work independently. Consider: auto-populate description from spec description, copy plan tags, or allow plan document to specify per-task fields.\",\n      \"created_at\": \"2026-02-27T19:50:27.246Z\",\n      \"tags\": [\n        \"plan-import\",\n        \"automation\",\n        \"friction\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJGEEQ\",\n      \"text\": \"Reflection follow-up: add explicit parent/ancestor context to kspec item get output (human and --json) so hierarchy is unambiguous without separate tree queries.\",\n      \"created_at\": \"2026-02-27T21:00:42.908Z\",\n      \"tags\": [\n        \"reflection\",\n        \"cli\",\n        \"spec\"\n      ],\n      \"added_by\": \"Jacob Chapel\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJGEEQ\",\n      \"text\": \"Reflection follow-up: add optional ancestor-chain display for kspec item list --tree --search so matched descendants show parent context and avoid false orphan interpretation.\",\n      \"created_at\": \"2026-02-27T21:00:42.945Z\",\n      \"tags\": [\n        \"reflection\",\n        \"cli\",\n        \"ux\"\n      ],\n      \"added_by\": \"Jacob Chapel\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJGEEQ\",\n      \"text\": \"Reflection follow-up: add validation check for trait/command-contract contradictions (e.g., command AC prohibits --refs while applied traits require batch refs semantics).\",\n      \"created_at\": \"2026-02-27T21:00:42.975Z\",\n      \"tags\": [\n        \"reflection\",\n        \"validation\",\n        \"traits\"\n      ],\n      \"added_by\": \"Jacob Chapel\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJGFKJ\",\n      \"text\": \"Unified kspec get @ref dispatch: currently plans require 'kspec plan get' while specs/tasks use 'kspec item get' / 'kspec task get'. A single 'kspec get @ref' that auto-dispatches to the right entity type would reduce friction for agents and humans who don't know the entity type upfront.\",\n      \"created_at\": \"2026-02-27T21:20:50.617Z\",\n      \"tags\": [\n        \"cli\",\n        \"ux\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJGW8Z\",\n      \"text\": \"Add stale-dist guard for CLI-based tests: detect outdated dist/cli build in tests/helpers/cli.ts and fail fast with actionable guidance (or optional auto-build) to avoid misleading failures.\",\n      \"created_at\": \"2026-02-28T01:02:14.839Z\",\n      \"tags\": [\n        \"reflection\",\n        \"testing\",\n        \"cli\"\n      ],\n      \"added_by\": \"Jacob Chapel\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJHAFV\",\n      \"text\": \"Meta workflow editing gap: kspec meta set cannot update workflow steps. Agents must delete+recreate workflow to edit a step, which can churn workflow ULIDs and temporarily break references. Add safe step-level update support (e.g., --set-step <index> --content/--on-fail) or preserve ULID on replace to avoid reference drift.\",\n      \"created_at\": \"2026-02-28T05:10:40.560Z\",\n      \"tags\": [\n        \"reflection\",\n        \"cli\",\n        \"workflow\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJJHAR\",\n      \"text\": \"Worktree guard escape hatch: add env var KSPEC_GUARD_OVERRIDE_DONT_USE that bypasses the guard hook for intentional recovery operations (git reset, rebase in .kspec). Name deliberately long to discourage agent use — humans-only for recovery scenarios.\",\n      \"created_at\": \"2026-02-28T16:29:27.938Z\",\n      \"tags\": [\n        \"infra\",\n        \"cli\",\n        \"reflection\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJK3YZ\",\n      \"text\": \"Add commit-scope guard for automated task work: before committing, detect pre-existing staged files unrelated to the current task and prevent accidental inclusion (or require explicit acknowledgment). In this iteration, unrelated staged files were included because they were already in the index before git add on task files.\",\n      \"created_at\": \"2026-02-28T21:55:04.627Z\",\n      \"tags\": [\n        \"reflection\",\n        \"git\",\n        \"automation\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJK5XG\",\n      \"text\": \"tests/ralph.test.ts helper runRalph splits args on whitespace, so quoted values (e.g., --focus \\\"keep scope narrow\\\") break and cause misleading unknown-command/option failures. Improve helper to accept argv arrays or robust shell-like parsing for test args.\",\n      \"created_at\": \"2026-02-28T22:29:13.640Z\",\n      \"tags\": [\n        \"reflection\",\n        \"testing\",\n        \"ralph\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": false,\n      \"triage_action\": null\n    },\n    {\n      \"ref\": \"01KJK84Y\",\n      \"text\": \"Reflection: fix-cycle ergonomics mismatch — task-work guidance says 're-submit' needs_work tasks, but CLI rejects kspec task submit when status is needs_work and requires explicit kspec task start first. Consider allowing direct submit from needs_work (auto-transition to in_progress) or improving error/help text to show required two-step command sequence.\",\n      \"created_at\": \"2026-02-28T23:08:14.675Z\",\n      \"tags\": [\n        \"reflection\",\n        \"cli\",\n        \"tasks\"\n      ],\n      \"added_by\": \"@claude\",\n      \"triaged\": false,\n      \"triage_action\": null\n    }\n  ],\n  \"inbox_stats\": {\n    \"total\": 120,\n    \"untriaged\": 17,\n    \"deferred\": 72,\n    \"triaged\": 103\n  },\n  \"observations\": [],\n  \"stats\": {\n    \"total_tasks\": 735,\n    \"in_progress\": 0,\n    \"needs_work\": 1,\n    \"pending_review\": 0,\n    \"ready\": 32,\n    \"blocked\": 0,\n    \"completed\": 681,\n    \"inbox_items\": 120\n  },\n  \"computed\": {\n    \"inbox_untriaged_count\": 17,\n    \"inbox_deferred_count\": 72,\n    \"inbox_total\": 120,\n    \"task_unlocks\": {\n      \"01KF4WVW7\": 1,\n      \"01KHY9WV\": 1,\n      \"01KJGBWNW\": 1,\n      \"01KJGBWP\": 1\n    },\n    \"recent_activity\": [\n      {\n        \"type\": \"commit\",\n        \"date\": \"2026-02-28T23:19:12.000Z\",\n        \"commit\": {\n          \"hash\": \"4c81ac5\",\n          \"full_hash\": \"4c81ac594ebc432e3e7114e003b0c374a5464704\",\n          \"date\": \"2026-02-28T23:19:12.000Z\",\n          \"message\": \"fix: use session-scoped ralph update attribution\",\n          \"author\": \"Jacob Chapel\",\n          \"task_refs\": [\n            \"01KJDQ1AF125H0FK29HE769R4P\"\n          ]\n        }\n      },\n      {\n        \"type\": \"linked_commit\",\n        \"date\": \"2026-02-28T23:14:18.000Z\",\n        \"commit\": {\n          \"hash\": \"3935ca8\",\n          \"full_hash\": \"3935ca808c131813871ec5a48e7550f9a239a5a1\",\n          \"date\": \"2026-02-28T23:14:04.000Z\",\n          \"message\": \"fix: prevent unhandled rejection on iteration timeout (Node.js 22) (#610)\",\n          \"author\": \"Jacob Chapel\",\n          \"task_refs\": [\n            \"01KJDQ17W\"\n          ]\n        },\n        \"task\": {\n          \"ref\": \"01KJDQ17W\",\n          \"slug\": null,\n          \"title\": \"Ralph loop needs iteration-level timeout. When a spawned agent gets stuck (e.g., tool call hanging o\",\n          \"completed_at\": \"2026-02-28T23:14:18.000Z\",\n          \"closed_reason\": \"Merged in PR #610. Implemented iteration-timeout hardening by capturing runIterationPrompts() promise and attaching catch before Promise.race to prevent Node.js 22 unhandled rejection on timeout/dispose path. Added/confirmed @cli-ralph ac-24/ac-25/ac-26 for iteration-timeout defaults, validation, and iteration.timeout event behavior, with AC annotations in tests/ralph.test.ts. Verified @cli-ralph AC annotation coverage across ac-1..ac-26 and green PR CI on merge commit 3935ca808c131813871ec5a48e7550f9a239a5a1.\"\n        }\n      },\n      {\n        \"type\": \"linked_commit\",\n        \"date\": \"2026-02-28T23:14:18.000Z\",\n        \"commit\": {\n          \"hash\": \"0b1fbc2\",\n          \"full_hash\": \"0b1fbc2df9e77af7fbf28e09211f70134816a845\",\n          \"date\": \"2026-02-28T22:53:06.000Z\",\n          \"message\": \"fix: prevent unhandled rejection on iteration timeout in Node.js 22\",\n          \"author\": \"Jacob Chapel\",\n          \"task_refs\": [\n            \"01KJDQ17W\"\n          ]\n        },\n        \"task\": {\n          \"ref\": \"01KJDQ17W\",\n          \"slug\": null,\n          \"title\": \"Ralph loop needs iteration-level timeout. When a spawned agent gets stuck (e.g., tool call hanging o\",\n          \"completed_at\": \"2026-02-28T23:14:18.000Z\",\n          \"closed_reason\": \"Merged in PR #610. Implemented iteration-timeout hardening by capturing runIterationPrompts() promise and attaching catch before Promise.race to prevent Node.js 22 unhandled rejection on timeout/dispose path. Added/confirmed @cli-ralph ac-24/ac-25/ac-26 for iteration-timeout defaults, validation, and iteration.timeout event behavior, with AC annotations in tests/ralph.test.ts. Verified @cli-ralph AC annotation coverage across ac-1..ac-26 and green PR CI on merge commit 3935ca808c131813871ec5a48e7550f9a239a5a1.\"\n        }\n      },\n      {\n        \"type\": \"linked_commit\",\n        \"date\": \"2026-02-28T23:14:18.000Z\",\n        \"commit\": {\n          \"hash\": \"866d0ef\",\n          \"full_hash\": \"866d0ef28bed9a8adfb52d8af1e440339f8e2cb8\",\n          \"date\": \"2026-02-28T22:45:55.000Z\",\n          \"message\": \"feat: add ralph iteration-timeout guard (#608)\",\n          \"author\": \"Jacob Chapel\",\n          \"task_refs\": [\n            \"01KJDQ17W\"\n          ]\n        },\n        \"task\": {\n          \"ref\": \"01KJDQ17W\",\n          \"slug\": null,\n          \"title\": \"Ralph loop needs iteration-level timeout. When a spawned agent gets stuck (e.g., tool call hanging o\",\n          \"completed_at\": \"2026-02-28T23:14:18.000Z\",\n          \"closed_reason\": \"Merged in PR #610. Implemented iteration-timeout hardening by capturing runIterationPrompts() promise and attaching catch before Promise.race to prevent Node.js 22 unhandled rejection on timeout/dispose path. Added/confirmed @cli-ralph ac-24/ac-25/ac-26 for iteration-timeout defaults, validation, and iteration.timeout event behavior, with AC annotations in tests/ralph.test.ts. Verified @cli-ralph AC annotation coverage across ac-1..ac-26 and green PR CI on merge commit 3935ca808c131813871ec5a48e7550f9a239a5a1.\"\n        }\n      },\n      {\n        \"type\": \"linked_commit\",\n        \"date\": \"2026-02-28T23:14:18.000Z\",\n        \"commit\": {\n          \"hash\": \"3e73009\",\n          \"full_hash\": \"3e730097098c8383616ddae2528ebb7377c026de\",\n          \"date\": \"2026-02-28T22:27:43.000Z\",\n          \"message\": \"feat: add ralph iteration-timeout guard\",\n          \"author\": \"Jacob Chapel\",\n          \"task_refs\": [\n            \"01KJDQ17W\"\n          ]\n        },\n        \"task\": {\n          \"ref\": \"01KJDQ17W\",\n          \"slug\": null,\n          \"title\": \"Ralph loop needs iteration-level timeout. When a spawned agent gets stuck (e.g., tool call hanging o\",\n          \"completed_at\": \"2026-02-28T23:14:18.000Z\",\n          \"closed_reason\": \"Merged in PR #610. Implemented iteration-timeout hardening by capturing runIterationPrompts() promise and attaching catch before Promise.race to prevent Node.js 22 unhandled rejection on timeout/dispose path. Added/confirmed @cli-ralph ac-24/ac-25/ac-26 for iteration-timeout defaults, validation, and iteration.timeout event behavior, with AC annotations in tests/ralph.test.ts. Verified @cli-ralph AC annotation coverage across ac-1..ac-26 and green PR CI on merge commit 3935ca808c131813871ec5a48e7550f9a239a5a1.\"\n        }\n      },\n      {\n        \"type\": \"linked_commit\",\n        \"date\": \"2026-02-28T23:05:33.314Z\",\n        \"commit\": {\n          \"hash\": \"18ca84b\",\n          \"full_hash\": \"18ca84bc8b20998fce148644e19632d62777368d\",\n          \"date\": \"2026-02-28T23:05:21.000Z\",\n          \"message\": \"fix: keep warning-only plan import successful in batch (#609)\",\n          \"author\": \"Jacob Chapel\",\n          \"task_refs\": [\n            \"01KJDQ1B9C62DT55EK8WK01BP0\"\n          ]\n        },\n        \"task\": {\n          \"ref\": \"01KJDQ1B\",\n          \"slug\": null,\n          \"title\": \"Plan import warnings treated as errors in batch mode. The no YAML code block in specs section warnin\",\n          \"completed_at\": \"2026-02-28T23:05:33.314Z\",\n          \"closed_reason\": \"Merged in PR #609. Fixed batch-mode plan import by replacing process.exit(EXIT_CODES.SUCCESS) with return in plan-import.ts success path, preventing BatchExitError interception. Added regression test in batch-exec-engine.test.ts covering warning-only plan import succeeds in batch (ac-34, ac-23). All CI checks passed.\"\n        }\n      },\n      {\n        \"type\": \"linked_commit\",\n        \"date\": \"2026-02-28T23:05:33.314Z\",\n        \"commit\": {\n          \"hash\": \"eca0f63\",\n          \"full_hash\": \"eca0f6391629d681d64c87524a471dada1390a6e\",\n          \"date\": \"2026-02-28T22:37:02.000Z\",\n          \"message\": \"fix: keep warning-only plan import successful in batch\",\n          \"author\": \"Jacob Chapel\",\n          \"task_refs\": [\n            \"01KJDQ1B9C62DT55EK8WK01BP0\"\n          ]\n        },\n        \"task\": {\n          \"ref\": \"01KJDQ1B\",\n          \"slug\": null,\n          \"title\": \"Plan import warnings treated as errors in batch mode. The no YAML code block in specs section warnin\",\n          \"completed_at\": \"2026-02-28T23:05:33.314Z\",\n          \"closed_reason\": \"Merged in PR #609. Fixed batch-mode plan import by replacing process.exit(EXIT_CODES.SUCCESS) with return in plan-import.ts success path, preventing BatchExitError interception. Added regression test in batch-exec-engine.test.ts covering warning-only plan import succeeds in batch (ac-34, ac-23). All CI checks passed.\"\n        }\n      },\n      {\n        \"type\": \"linked_commit\",\n        \"date\": \"2026-02-28T22:19:13.639Z\",\n        \"commit\": {\n          \"hash\": \"69c3b62\",\n          \"full_hash\": \"69c3b626dd3218c543d810a42602d99843f7db98\",\n          \"date\": \"2026-02-28T22:18:59.000Z\",\n          \"message\": \"feat: add stale auto-abandon metadata helpers (#607)\",\n          \"author\": \"Jacob Chapel\",\n          \"task_refs\": [\n            \"implement-auto-abandon-metadata-and-audit-trail\"\n          ]\n        },\n        \"task\": {\n          \"ref\": \"01KJGBWP\",\n          \"slug\": \"implement-auto-abandon-metadata-and-audit-trail\",\n          \"title\": \"Implement Auto-abandon Metadata and Audit Trail\",\n          \"completed_at\": \"2026-02-28T22:19:13.639Z\",\n          \"closed_reason\": \"Merged in PR #607. Implemented stale auto-abandon metadata apply helper with canonical close_reason format, shared ended_at/status=abandoned updates, dry-run preview, and one command-specific shadow commit path for multi-session persistence. Verified AC coverage for @session-stale-close-metadata ac-1..ac-4 in tests/session-stale-criteria.test.ts and confirmed green CI on commit 8131a376.\"\n        }\n      },\n      {\n        \"type\": \"linked_commit\",\n        \"date\": \"2026-02-28T22:19:13.639Z\",\n        \"commit\": {\n          \"hash\": \"8131a37\",\n          \"full_hash\": \"8131a376222f82b2cf75463731a4deaa19bc0c96\",\n          \"date\": \"2026-02-28T22:08:42.000Z\",\n          \"message\": \"fix: add shadow-commit support for stale auto-abandon metadata\",\n          \"author\": \"Jacob Chapel\",\n          \"task_refs\": [\n            \"implement-auto-abandon-metadata-and-audit-trail\"\n          ]\n        },\n        \"task\": {\n          \"ref\": \"01KJGBWP\",\n          \"slug\": \"implement-auto-abandon-metadata-and-audit-trail\",\n          \"title\": \"Implement Auto-abandon Metadata and Audit Trail\",\n          \"completed_at\": \"2026-02-28T22:19:13.639Z\",\n          \"closed_reason\": \"Merged in PR #607. Implemented stale auto-abandon metadata apply helper with canonical close_reason format, shared ended_at/status=abandoned updates, dry-run preview, and one command-specific shadow commit path for multi-session persistence. Verified AC coverage for @session-stale-close-metadata ac-1..ac-4 in tests/session-stale-criteria.test.ts and confirmed green CI on commit 8131a376.\"\n        }\n      },\n      {\n        \"type\": \"commit\",\n        \"date\": \"2026-02-28T22:08:35.000Z\",\n        \"commit\": {\n          \"hash\": \"ed22e4f\",\n          \"full_hash\": \"ed22e4f783bddf25cf5454ecc1e93a2a5d5e745c\",\n          \"date\": \"2026-02-28T22:08:35.000Z\",\n          \"message\": \"Revert \\\"feat: add ralph iteration-timeout guard\\\"\",\n          \"author\": \"Jacob Chapel\",\n          \"task_refs\": []\n        }\n      }\n    ]\n  }\n}\n---\n[\n  {\n    \"_ulid\": \"01KJDQ1C22TH9SEXXGBYQT8Y3Z\",\n    \"slugs\": [],\n    \"title\": \"Plan import --update replaces all ACs instead of merging. When extending an existing spec with a new\",\n    \"type\": \"task\",\n    \"description\": \"Plan import --update replaces all ACs instead of merging. When extending an existing spec with a new AC via plan import, --update overwrites acceptance_criteria entirely. Need AC-merge strategy: append new AC IDs, preserve existing ones. Encountered during spec-plan for session-log-show ac-10.\",\n    \"spec_ref\": \"@plan-import\",\n    \"status\": \"pending\",\n    \"blocked_by\": [],\n    \"depends_on\": [],\n    \"context\": [],\n    \"priority\": 3,\n    \"tags\": [],\n    \"vcs_refs\": [],\n    \"created_at\": \"2026-02-26T19:32:59.586Z\",\n    \"notes\": [\n      {\n        \"_ulid\": \"01KJDQ8ZD10EG4Z7MHEAHWBMAT\",\n        \"created_at\": \"2026-02-26T19:37:08.769Z\",\n        \"author\": \"@claude\",\n        \"content\": \"ENRICHMENT — Standalone context for this task:\\n\\n**What**: When `kspec plan import --update` encounters an existing spec, it replaces the entire `acceptance_criteria` array instead of merging. If a spec already has ac-1 through ac-9 and a plan adds ac-10, --update overwrites all ACs with only what the plan document contains, losing ac-1 through ac-9.\\n\\n**Where**: `src/cli/commands/plan-import.ts` lines 271-303 (the --update branch). The update logic builds a `Partial<SpecItemInput>` and sets `updates.acceptance_criteria = spec.acceptance_criteria` (line 296), passed to `updateSpecItem()` in `src/parser/yaml.ts` line 1522. `updateSpecItem` does direct property assignment (`targetObj[key] = value` at line 1560) with no merge logic.\\n\\n**How**: Implement an AC merge strategy in the update path. When `updates.acceptance_criteria` is set and the existing item already has ACs:\\n1. Index existing ACs by their `id` field (e.g., \\\"ac-1\\\", \\\"ac-2\\\")\\n2. For each AC in the plan update: if an AC with the same `id` exists, replace it; otherwise append it\\n3. Preserve existing ACs whose IDs are not in the update set\\nBest done in `plan-import.ts` before calling `updateSpecItem`, since general updateSpecItem callers may want full replacement semantics.\\n\\n**Done when**:\\n- `kspec plan import --update` with a plan that adds one new AC to an existing spec preserves all pre-existing ACs and appends the new one\\n- A plan that modifies an existing AC (same id) updates that AC in place while preserving others\\n- Tests cover: append-only new AC, update existing AC by id, mixed append+update, no ACs in plan (preserves existing), empty existing ACs (creates all from plan)\",\n        \"supersedes\": null\n      }\n    ],\n    \"todos\": [],\n    \"automation\": \"eligible\",\n    \"_sourceFile\": \"/workspace/.kspec/project.tasks.yaml\"\n  },\n  {\n    \"_ulid\": \"01KJDQ1CTV35WDA9G51NEH943K\",\n    \"slugs\": [],\n    \"title\": \"Agents should check plan_ref when starting tasks. If a task has plan_ref, run kspec plan get @plan-r\",\n    \"type\": \"task\",\n    \"description\": \"Agents should check plan_ref when starting tasks. If a task has plan_ref, run kspec plan get @plan-ref to read implementation notes, algorithm details, and context. Update task-work skill and task-work-loop workflow to include this step. Plans are the right place for rich implementation context instead of cramming it into task notes.\",\n    \"spec_ref\": null,\n    \"status\": \"pending\",\n    \"blocked_by\": [],\n    \"depends_on\": [],\n    \"context\": [],\n    \"priority\": 3,\n    \"tags\": [],\n    \"vcs_refs\": [],\n    \"created_at\": \"2026-02-26T19:33:00.379Z\",\n    \"notes\": [\n      {\n        \"_ulid\": \"01KJDQ9E2V7MF4XRKW0MQQC59X\",\n        \"created_at\": \"2026-02-26T19:37:23.804Z\",\n        \"author\": \"@claude\",\n        \"content\": \"ENRICHMENT — Standalone context for this task:\\n\\n**What**: When agents start a task that has a `plan_ref` field, they should automatically retrieve the plan to get implementation notes, algorithm details, and design context. Currently the task-work skill and task-work-loop workflow do not mention checking plan_ref. Plans are the intended home for rich implementation context rather than cramming it into task descriptions or notes.\\n\\n**Where**: \\n- `templates/skills/task-work/SKILL.md` — Step 3 \\\"Start Task\\\" section (line 86-90) needs a substep: \\\"If task has plan_ref, run `kspec plan get @plan-ref` to read implementation notes\\\"\\n- Task-work-loop workflow definition in `.kspec/` (the workflow YAML) — add the same step\\n- `src/cli/commands/task.ts` — the `task get` output already shows `plan_ref` when present; the `task start` command could optionally print a hint like \\\"This task has a plan: run `kspec plan get @plan-ref` for implementation context\\\"\\n\\n**How**:\\n1. Update `templates/skills/task-work/SKILL.md` step 3 to add: \\\"If `kspec task get @ref` shows a `plan_ref`, run `kspec plan get @plan-ref` to read implementation notes and design context before starting work.\\\"\\n2. Update the task-work-loop workflow to include the same check in its automated flow\\n3. Optionally enhance `kspec task start` in `src/cli/commands/task.ts` to print an info message when the started task has a non-null plan_ref\\n4. Run `kspec agents generate` after template changes\\n\\n**Done when**:\\n- The task-work skill documents checking plan_ref when starting tasks\\n- The task-work-loop workflow includes plan context retrieval\\n- Agents following the skill will automatically get plan context when a task has plan_ref\\n- `kspec agents generate` produces updated kspec-agents.md\",\n        \"supersedes\": null\n      },\n      {\n        \"_ulid\": \"01KJDQVPYHQ56GVPJH0EKJ6TWV\",\n        \"created_at\": \"2026-02-26T19:47:22.705Z\",\n        \"author\": \"@claude\",\n        \"content\": \"Infra: Workflow/skill documentation change. Agents check plan_ref when starting tasks. No code change needed, skill template update.\",\n        \"supersedes\": null\n      }\n    ],\n    \"todos\": [],\n    \"automation\": \"eligible\",\n    \"_sourceFile\": \"/workspace/.kspec/project.tasks.yaml\"\n  },\n  {\n    \"_ulid\": \"01KJDQ1DQMCBX32KDVWBJBF8W1\",\n    \"slugs\": [],\n    \"title\": \"ULID short ref ambiguity in batch operations: when two ULIDs share a prefix (e.g. 01KJ4SNE9 and 01KJ\",\n    \"type\": \"task\",\n    \"description\": \"ULID short ref ambiguity in batch operations: when two ULIDs share a prefix (e.g. 01KJ4SNE9 and 01KJ4SNEC), short refs like @01KJ4SNE fail. kspec already has a shortest-unique-ID utility — this should be used anywhere refs are displayed (triage list, task list, inbox list, promote result_ref, etc.) so that presented refs are always unambiguous and copy-pasteable into subsequent commands.\",\n    \"spec_ref\": \"@batch-exec\",\n    \"status\": \"pending\",\n    \"blocked_by\": [],\n    \"depends_on\": [],\n    \"context\": [],\n    \"priority\": 3,\n    \"tags\": [],\n    \"vcs_refs\": [],\n    \"created_at\": \"2026-02-26T19:33:01.300Z\",\n    \"notes\": [\n      {\n        \"_ulid\": \"01KJDQA0MV956KKZREMG980AE6\",\n        \"created_at\": \"2026-02-26T19:37:42.812Z\",\n        \"author\": \"@claude\",\n        \"content\": \"ENRICHMENT — Standalone context for this task:\\n\\n**What**: When two ULIDs share a prefix (e.g., 01KJ4SNE9... and 01KJ4SNEC...), the default 8-character short ref `@01KJ4SNE` is ambiguous and fails to resolve. The `ReferenceIndex.shortUlid()` method (in `src/parser/refs.ts` line 310) already computes the minimum unique prefix, but many places in the codebase use a hardcoded `_ulid.slice(0, 8)` instead. There are 69 occurrences of `_ulid.slice(0, 8)` across 19 files.\\n\\n**Where**: All places that format ULID refs for display need to use `shortUlid()` instead of `_ulid.slice(0, 8)`. Key files with hardcoded slicing:\\n- `src/cli/commands/triage.ts` (14 occurrences) — triage list, record, act, get, start\\n- `src/cli/commands/inbox.ts` (9 occurrences) — inbox list, add, promote\\n- `src/cli/commands/item.ts` (6 occurrences) — item list, get, add\\n- `src/cli/commands/plan.ts` (9 occurrences) — plan list, get\\n- `src/cli/commands/search.ts` (4 occurrences) — search results\\n- `src/cli/commands/session/context.ts` (4 occurrences) — session context display\\n- `src/triage/actions.ts` (1 occurrence) — promote result ref\\n- `src/parser/validate.ts` (8 occurrences) — validation output\\n- Several other files with 1-3 occurrences each\\n\\nThe `ReferenceIndex` is already available in most of these contexts (it's built during `initContext()` or `buildIndexes()`).\\n\\n**How**:\\n1. For each file, replace `_ulid.slice(0, 8)` with `index.shortUlid(_ulid)` where a ReferenceIndex is in scope\\n2. For files where no index is available, either thread the index through or create a lightweight shortening utility\\n3. For triage records (which aren't indexed in the main ReferenceIndex), consider building a local index or a dedicated triage ULID shortener\\n4. Ensure that refs displayed by any list/get/result command are always copy-pasteable into subsequent commands without ambiguity\\n\\n**Done when**:\\n- No occurrences of `_ulid.slice(0, 8)` remain in display-facing code paths\\n- All displayed refs (triage list, task list, inbox list, search results, promote result_ref, etc.) use `shortUlid()` or equivalent\\n- A test with two items sharing an 8-character ULID prefix shows that displayed refs are still unique and resolvable\",\n        \"supersedes\": null\n      }\n    ],\n    \"todos\": [],\n    \"automation\": \"eligible\",\n    \"_sourceFile\": \"/workspace/.kspec/project.tasks.yaml\"\n  },\n  {\n    \"_ulid\": \"01KJDQ1EKVV4V60V7WT6DCK3H3\",\n    \"slugs\": [],\n    \"title\": \"Triage promote action should optionally delete the inbox item after creating the task. Currently pro\",\n    \"type\": \"task\",\n    \"description\": \"Triage promote action should optionally delete the inbox item after creating the task. Currently promoted items stay in inbox requiring manual cleanup. Consider --consume flag or making deletion the default for promote (with snapshot preserved in triage record).\",\n    \"spec_ref\": \"@triage-cli-commands\",\n    \"status\": \"pending\",\n    \"blocked_by\": [],\n    \"depends_on\": [],\n    \"context\": [],\n    \"priority\": 3,\n    \"tags\": [],\n    \"vcs_refs\": [],\n    \"created_at\": \"2026-02-26T19:33:02.203Z\",\n    \"notes\": [\n      {\n        \"_ulid\": \"01KJDQAHM5SX18W9F5V0ET02G6\",\n        \"created_at\": \"2026-02-26T19:38:00.197Z\",\n        \"author\": \"@claude\",\n        \"content\": \"ENRICHMENT — Standalone context for this task:\\n\\n**What**: When `kspec triage act` executes a \\\"promote\\\" action, it creates a new task from the inbox item but leaves the original inbox item in the inbox. This requires a separate manual `kspec inbox delete` step to clean up, which is tedious and easy to forget. The inbox item's text is already preserved in the triage record's `item_snapshot` field, so the original is not needed for audit trail purposes.\\n\\n**Where**: \\n- `src/triage/actions.ts` lines 54-74 — the `promote` case in `executeTriageAction()`. Currently creates the task and returns, but never calls `deleteInboxItem()` for the promoted item.\\n- `src/cli/commands/triage.ts` lines 235-289 — the `triage act` command handler. This is where the `--consume` flag would be parsed and passed to `executeTriageAction()`.\\n- The `delete` and `duplicate` cases (lines 77-90, 117-130) already call `deleteInboxItem()` — the promote case can follow the same pattern.\\n\\n**How**: Two reasonable approaches:\\n1. **Flag approach**: Add `--consume` flag to `kspec triage act` that deletes the inbox item after promote. Pass it through `ExecuteTriageActionOptions` to `executeTriageAction()`.\\n2. **Default behavior**: Make deletion the default for promote (since the snapshot is preserved in the triage record), with a `--keep` flag to opt out.\\n\\nRecommendation: Option 2 (delete by default) is cleaner since every promoted item has its text preserved in `item_snapshot`. The `--keep` flag is the escape hatch. The `delete` and `duplicate` cases already delete inbox items as their default behavior, so promote doing the same is consistent.\\n\\nImplementation:\\n1. Add `consume` option to `ExecuteTriageActionOptions` (default true for promote)\\n2. In the `promote` case of `executeTriageAction()`, after creating the task, call `deleteInboxItem()` for `record.inbox_ref` unless consume is false\\n3. Add `--keep` flag to `kspec triage act` command that sets `consume: false`\\n4. Update dry-run output to mention deletion\\n\\n**Done when**:\\n- `kspec triage act <ref>` on a promote record creates the task AND deletes the inbox item\\n- `kspec triage act <ref> --keep` creates the task but preserves the inbox item\\n- Dry-run output mentions that the inbox item would be deleted\\n- The `item_snapshot` in the triage record still contains the original text for audit trail\\n- Tests cover: promote with deletion (default), promote with --keep, dry-run output\",\n        \"supersedes\": null\n      }\n    ],\n    \"todos\": [],\n    \"automation\": \"eligible\",\n    \"_sourceFile\": \"/workspace/.kspec/project.tasks.yaml\"\n  },\n  {\n    \"_ulid\": \"01KJDQ1FCWDDH5FM5JKSWNYVBX\",\n    \"slugs\": [],\n    \"title\": \"Web UI: persist all filter state and current view in URL query params so refreshing the page preserv\",\n    \"type\": \"task\",\n    \"description\": \"Web UI: persist all filter state and current view in URL query params so refreshing the page preserves state. Applies to all list/filter pages (triage, inbox, tasks, etc).\",\n    \"spec_ref\": \"@web-ui\",\n    \"status\": \"pending\",\n    \"blocked_by\": [],\n    \"depends_on\": [],\n    \"context\": [],\n    \"priority\": 3,\n    \"tags\": [],\n    \"vcs_refs\": [],\n    \"created_at\": \"2026-02-26T19:33:03.004Z\",\n    \"notes\": [\n      {\n        \"_ulid\": \"01KJDQB2J9SKA1QNC3SG3NN8WF\",\n        \"created_at\": \"2026-02-26T19:38:17.546Z\",\n        \"author\": \"@claude\",\n        \"content\": \"ENRICHMENT — Standalone context for this task:\\n\\n**What**: Web UI pages lose their filter state when the browser refreshes. For example, filtering tasks by status=in_progress or triage by tag=cli is lost on reload. Filter state should be persisted in URL query parameters so that refreshing preserves the view, and URLs are shareable/bookmarkable.\\n\\n**Where**: The tasks page (`packages/web-ui/src/routes/tasks/+page.svelte`) already partially implements URL-based filters — it reads from `$page.url.searchParams` (line 39-47) via the `filterParams` derived value. However, the triage page (`packages/web-ui/src/routes/triage/+page.svelte`) uses local `$state` variables (`filterTag`, `filterStatus` at lines 43-44) that are NOT synced to URL params. Other list pages (items, inbox) likely have the same issue.\\n\\nKey files to update:\\n- `packages/web-ui/src/routes/triage/+page.svelte` — filterTag and filterStatus need URL param sync\\n- `packages/web-ui/src/routes/items/+page.svelte` — check if filters use URL params\\n- Any other list/filter pages under `packages/web-ui/src/routes/`\\n\\n**How**: Follow the pattern already established in the tasks page:\\n1. Read initial filter values from `$page.url.searchParams` (from `$app/stores`)\\n2. When a filter changes, use `goto()` (from `$app/navigation`) to update URL params without a full page reload: `goto(\\\\`?status=\\\\${filterStatus}&tag=\\\\${filterTag}\\\\`, { replaceState: true, keepFocus: true })`\\n3. Use `$derived` to compute filter values from URL params (like tasks page does)\\n4. This approach gives: URL persistence, back/forward navigation, shareable links\\n\\nFor the triage page specifically:\\n- Replace `let filterTag = $state('')` with reading from `$page.url.searchParams.get('tag')`\\n- Replace `let filterStatus = $state('all')` with reading from `$page.url.searchParams.get('status')`\\n- Add `goto()` calls when filters change\\n\\n**Done when**:\\n- All list/filter pages read initial state from URL query params\\n- Changing a filter updates the URL without full page reload\\n- Refreshing the page preserves filter state\\n- Browser back/forward navigates between filter states\\n- The triage page URL shows filters like `?status=untriaged&tag=cli`\",\n        \"supersedes\": null\n      },\n      {\n        \"_ulid\": \"01KJDQWG9550XY4Y8F7V6W5W47\",\n        \"created_at\": \"2026-02-26T19:47:48.645Z\",\n        \"author\": \"@claude\",\n        \"content\": \"Linked to @web-ui module. URL state persistence for filter/view params across all list pages.\",\n        \"supersedes\": null\n      }\n    ],\n    \"todos\": [],\n    \"automation\": \"eligible\",\n    \"_sourceFile\": \"/workspace/.kspec/project.tasks.yaml\"\n  },\n  {\n    \"_ulid\": \"01KJDQ1G6HBSJRXVSWEWQ9W9E4\",\n    \"slugs\": [],\n    \"title\": \"Web UI triage page: add filter controls for triage action types (promote, delete, defer, spec-gap, d\",\n    \"type\": \"task\",\n    \"description\": \"Web UI triage page: add filter controls for triage action types (promote, delete, defer, spec-gap, duplicate). Currently no way to filter triage records by action.\",\n    \"spec_ref\": \"@interactive-triage-ui\",\n    \"status\": \"pending\",\n    \"blocked_by\": [],\n    \"depends_on\": [],\n    \"context\": [],\n    \"priority\": 3,\n    \"tags\": [],\n    \"vcs_refs\": [],\n    \"created_at\": \"2026-02-26T19:33:03.825Z\",\n    \"notes\": [\n      {\n        \"_ulid\": \"01KJDQBJ4QTDMCZJ4NAY7B1KGP\",\n        \"created_at\": \"2026-02-26T19:38:33.495Z\",\n        \"author\": \"@claude\",\n        \"content\": \"ENRICHMENT — Standalone context for this task:\\n\\n**What**: The triage page has status and tag filters (lines 326-347 of `packages/web-ui/src/routes/triage/+page.svelte`) but no way to filter triage records by their action type (promote, delete, defer, spec-gap, duplicate). When reviewing triage history, users often want to see \\\"all promote decisions\\\" or \\\"all spec-gap findings\\\" without scrolling through mixed results.\\n\\n**Where**: `packages/web-ui/src/routes/triage/+page.svelte`:\\n- Existing filters: `filterStatus` (all/untriaged/triaged/acted_on) at line 44, `filterTag` at line 43\\n- Filter UI: lines 324-347 (the filter controls div with data-testid=\\\"triage-filters\\\")\\n- Filtered items computation: `filteredItems` derived at lines 78-96 — currently filters by tag and status only\\n- The `TriageAction` type includes: promote, delete, defer, spec-gap, duplicate (defined in `$lib/types/triage`)\\n\\n**How**:\\n1. Add a new `filterAction` state variable: `let filterAction = $state<TriageAction | ''>('')`\\n2. Add a new `<select>` element in the filters div (alongside status and tag filters) with options for each action type\\n3. Add action filtering to the `filteredItems` derived computation:\\n   ```\\n   if (filterAction) {\\n     items = items.filter((i) => i.record?.action === filterAction);\\n   }\\n   ```\\n4. Include the action filter in the `$effect` that resets `currentIndex` when filters change (line 296-302)\\n5. If implementing URL state persistence (task @01KJDQ1F), also sync this filter to URL params\\n\\n**Done when**:\\n- A dropdown/select control for triage action type appears in the filter bar\\n- Selecting \\\"promote\\\" shows only items with promote decisions\\n- Selecting \\\"spec-gap\\\" shows only spec-gap items\\n- The empty/default option shows all items (no action filter)\\n- Changing the filter resets the card navigation index to 0\\n- E2E test covers filtering by action type\",\n        \"supersedes\": null\n      },\n      {\n        \"_ulid\": \"01KJDQWRKV7J9BSC3BY2NNPNG8\",\n        \"created_at\": \"2026-02-26T19:47:57.179Z\",\n        \"author\": \"@claude\",\n        \"content\": \"Linked to @interactive-triage-ui spec. Add filter controls for triage action types on triage page.\",\n        \"supersedes\": null\n      }\n    ],\n    \"todos\": [],\n    \"automation\": \"eligible\",\n    \"_sourceFile\": \"/workspace/.kspec/project.tasks.yaml\"\n  },\n  {\n    \"_ulid\": \"01KJDQ1GZVK77Y8CETXW2E56TG\",\n    \"slugs\": [],\n    \"title\": \"Web UI WebSocket connection unreliable - continually disconnects and reconnects. Needs investigation\",\n    \"type\": \"task\",\n    \"description\": \"Web UI WebSocket connection unreliable - continually disconnects and reconnects. Needs investigation into reconnection logic, heartbeat handling, or fallback to polling.\",\n    \"spec_ref\": \"@daemon-server\",\n    \"status\": \"pending\",\n    \"blocked_by\": [],\n    \"depends_on\": [],\n    \"context\": [],\n    \"priority\": 3,\n    \"tags\": [],\n    \"vcs_refs\": [],\n    \"created_at\": \"2026-02-26T19:33:04.635Z\",\n    \"notes\": [\n      {\n        \"_ulid\": \"01KJDQC6EMCTTQFKDBQX9JCG55\",\n        \"created_at\": \"2026-02-26T19:38:54.292Z\",\n        \"author\": \"@claude\",\n        \"content\": \"ENRICHMENT — Standalone context for this task:\\n\\n**What**: The Web UI WebSocket connection continually disconnects and reconnects. The `WebSocketManager` in `packages/web-ui/src/lib/websocket/manager.ts` has exponential backoff reconnection (1s, 2s, 4s... max 30s, max 10 attempts), but users report seeing frequent disconnect/reconnect cycles in the console logs. This suggests either the server is closing connections, the keepalive/heartbeat mechanism is missing, or reconnection resets are happening incorrectly.\\n\\n**Where**:\\n- `packages/web-ui/src/lib/websocket/manager.ts` — The WebSocketManager class. Key areas:\\n  - `connect()` (line 150): creates WebSocket, sets up onopen/onmessage/onerror/onclose handlers\\n  - `scheduleReconnect()` (line 371): exponential backoff logic, max 10 attempts\\n  - `onclose` handler (line 183): triggers reconnect on any close event, even clean ones\\n  - No heartbeat/ping mechanism — if the server expects periodic pings, the connection may time out\\n- `packages/web-ui/src/lib/stores/connection.svelte.ts` — Connection store wrapping the manager\\n- Server-side WebSocket handler (in the daemon code) — check if it sends pings or has idle timeouts\\n\\n**How**: Investigation and fix areas:\\n1. **Add heartbeat/ping**: Implement a periodic ping from client to server (e.g., every 30s). Many WebSocket servers close idle connections after a timeout (often 60s). The client should send a ping command and expect a pong response.\\n2. **Don't reconnect on clean close**: The `onclose` handler (line 183) calls `scheduleReconnect()` unconditionally. If `event.code === 1000` (normal closure) and the client initiated it via `disconnect()`, skip reconnection. Currently `disconnect()` clears the timer, but there's a race if onclose fires after disconnect resets state.\\n3. **Check server-side idle timeout**: The daemon's WebSocket server may have an idle timeout that closes connections. Either increase it or implement heartbeat to keep alive.\\n4. **Consider connection health check**: After reconnecting, verify the connection is actually healthy (e.g., send a ping and wait for response) before transitioning to 'connected' state.\\n5. **Investigate MAX_RECONNECT_ATTEMPTS**: After 10 failed reconnects, the connection is abandoned permanently. Consider resetting the attempt counter after a successful connection that lasts longer than some threshold (e.g., 60s).\\n\\n**Done when**:\\n- WebSocket connection remains stable for extended periods without spurious disconnects\\n- Client sends periodic heartbeat/ping to prevent idle timeout\\n- Clean disconnects (code 1000 from client-initiated disconnect) don't trigger reconnection\\n- Console shows clean connection lifecycle without repeated disconnect/reconnect spam\\n- Connection lost indicator (10s threshold) only triggers for genuine server unavailability\\n- Tests cover: heartbeat keeps connection alive, clean close doesn't reconnect, reconnection works after genuine server restart\",\n        \"supersedes\": null\n      },\n      {\n        \"_ulid\": \"01KJDQX0Y1T915X3M23D1VS9PP\",\n        \"created_at\": \"2026-02-26T19:48:05.698Z\",\n        \"author\": \"@claude\",\n        \"content\": \"Linked to @daemon-server spec (covers WebSocket protocol). Investigate and fix WebSocket reconnection reliability.\",\n        \"supersedes\": null\n      }\n    ],\n    \"todos\": [],\n    \"automation\": \"eligible\",\n    \"_sourceFile\": \"/workspace/.kspec/project.tasks.yaml\"\n  },\n  {\n    \"_ulid\": \"01KJGBWNF7Q24AKX2H006YG2RG\",\n    \"slugs\": [\n      \"implement-stale-active-session-cleanup\"\n    ],\n    \"title\": \"Implement Stale Active Session Cleanup\",\n    \"type\": \"task\",\n    \"spec_ref\": \"@session-stale-cleanup\",\n    \"plan_ref\": \"@plan-auto-close-stale-active-sessions\",\n    \"status\": \"pending\",\n    \"blocked_by\": [],\n    \"depends_on\": [\n      \"@implement-stale-session-candidate-criteria\",\n      \"@implement-auto-abandon-metadata-and-audit-trail\"\n    ],\n    \"context\": [],\n    \"priority\": 3,\n    \"tags\": [],\n    \"vcs_refs\": [],\n    \"created_at\": \"2026-02-27T20:15:54.343Z\",\n    \"notes\": [\n      {\n        \"_ulid\": \"01KJGBWNF783W553MKSVK92XCE\",\n        \"created_at\": \"2026-02-27T20:15:54.343Z\",\n        \"author\": \"Jacob Chapel\",\n        \"content\": \"See plan @plan-auto-close-stale-active-sessions for implementation notes\"\n      },\n      {\n        \"_ulid\": \"01KJGCHNSP93AZEXNFGSW9SGBV\",\n        \"created_at\": \"2026-02-27T20:27:22.807Z\",\n        \"author\": \"Jacob Chapel\",\n        \"content\": \"Review follow-up: parent task now depends on criteria + metadata tasks to enforce implementation order. Parent task scope is command orchestration + integration tests after dependencies land.\",\n        \"supersedes\": null\n      },\n      {\n        \"_ulid\": \"01KJGD47RS0VH81V4AT3R6R76W\",\n        \"created_at\": \"2026-02-27T20:37:31.033Z\",\n        \"author\": \"@claude\",\n        \"content\": \"Automation triage: eligible. 9 own ACs + 6 traits (43 inherited ACs). Depends on @implement-stale-session-candidate-criteria and @implement-auto-abandon-metadata-and-audit-trail.\",\n        \"supersedes\": null\n      }\n    ],\n    \"todos\": [],\n    \"automation\": \"eligible\",\n    \"_sourceFile\": \"/workspace/.kspec/project.tasks.yaml\"\n  }\n]\n","stderr":"","aggregated_output":"ℹ Synced shadow branch from remote\n{\n  \"generated_at\": \"2026-02-28T23:25:50.342Z\",\n  \"branch\": \"fix/ralph-session-update-attribution\",\n  \"context\": {\n    \"focus\": null,\n    \"threads\": [],\n    \"open_questions\": [],\n    \"updated_at\": \"2026-01-22T21:05:45.847Z\"\n  },\n  \"active_tasks\": [\n    {\n      \"ref\": \"01KJDQ1A\",\n      \"slug\": null,\n      \"title\": \"Ralph event handler iteration attribution should use session-scoped mapping instead of shared mutabl\",\n      \"description\": \"**What**: Ralph event handler uses a `sessionIterationMap` (Map<string, number>) to attribute late ACP session updates to the correct iteration. However, the current implementation has a race condition: when a new ACP session starts for iteration N+1, late updates from iteration N's session can arrive after `sessionIterationMap.set(newSessionId, N+1)` but the old session's listener may still fire. The `_sid` closure variable in the `on('update')` handler captures the session ID correctly, but there is no cleanup of old listeners when starting a new session.\\n\\nThe Codex review on PR #484 identified that the shared mutable `sessionIterationMap` approach is fragile — a session-scoped listener pattern would be more robust.\\n\\n**Where**:\\n- `src/cli/commands/ralph.ts` line 1061 — `sessionIterationMap` declaration\\n- `src/cli/commands/ralph.ts` lines 1305-1337 — the `on('update')` handler that uses `sessionIterationMap.get(_sid)` for iteration lookup\\n- `src/cli/commands/ralph.ts` line 1369 — where new sessions are registered in the map\\n\\n**How**:\\nTwo approaches (pick one):\\n\\n1. **Session-scoped listeners** (recommended): Instead of one persistent `on('update')` handler, register a new listener per ACP session that captures the iteration number in its closure. Remove the old listener when the session ends or a new one starts. This eliminates the shared mutable map entirely.\\n\\n2. **Cleanup old sessions**: When starting a new ACP session, remove the previous session's entry from `sessionIterationMap` and call `agent.client.off('update', oldHandler)` to prevent stale callbacks. Less clean but simpler delta.\\n\\nBoth approaches should also ensure the translator is reset between iterations (it already creates a fresh translator per retry, but verify per-iteration reset).\\n\\n**Done when**:\\n- Late updates from a previous ACP session are attributed to the correct iteration (the one that created that session)\\n- No shared mutable state for iteration tracking — either session-scoped closures or explicit cleanup\\n- Existing event logging tests still pass\\n- Event log entries show correct iteration numbers even when sessions overlap\",\n      \"status\": \"needs_work\",\n      \"started_at\": \"2026-02-28T23:19:28.481Z\",\n      \"priority\": 3,\n      \"spec_ref\": \"@cli-ralph\",\n      \"note_count\": 4,\n      \"last_note_at\": \"2026-02-28T23:25:23.674Z\",\n      \"todo_count\": 0,\n      \"incomplete_todos\": 0\n    }\n  ],\n  \"pending_review_tasks\": [],\n  \"recent_notes\": [\n    {\n      \"task_ref\": \"01KJDQ1A\",\n      \"task_title\": \"Ralph event handler iteration attribution should use session-scoped mapping instead of shared mutabl\",\n      \"task_status\": \"needs_work\",\n      \"note_ulid\": \"01KJK94B\",\n      \"created_at\": \"2026-02-28T23:25:23.674Z\",\n      \"author\": \"@claude\",\n      \"content\": \"[FIX_CYCLE: 1] Review findings: MUST-FIX: PR #612 adds a new update listener per iteration without removing prior listeners; listener accumulation risks memory leaks and EventEmitter warnings over long ralph loops.\"\n    },\n    {\n      \"task_ref\": \"01KJDQ1A\",\n      \"task_title\": \"Ralph event handler iteration attribution should use session-scoped mapping instead of shared mutabl\",\n      \"task_status\": \"needs_work\",\n      \"note_ulid\": \"01KJK8RV\",\n      \"created_at\": \"2026-02-28T23:19:07.489Z\",\n      \"author\": \"@claude\",\n      \"content\": \"Implemented session-scoped streaming update attribution for Ralph iterations.\\n- Replaced shared mutable sessionIterationMap approach with createSessionUpdateLogger(acpSessionId, iteration, logUpdate).\\n- Each ACP session now registers a logger that captures iteration in closure and ignores updates from other session IDs.\\n- Logging callback now safely swallows both sync and async logging failures.\\n- Updated helper tests in tests/ralph.test.ts to cover session-bound attribution and logger error swallowing.\\nVerification: npm test -- tests/ralph.test.ts (141 passed).\"\n    },\n    {\n      \"task_ref\": \"01KJDQ1A\",\n      \"task_title\": \"Ralph event handler iteration attribution should use session-scoped mapping instead of shared mutabl\",\n      \"task_status\": \"needs_work\",\n      \"note_ulid\": \"01KJK8HK\",\n      \"created_at\": \"2026-02-28T23:15:09.710Z\",\n      \"author\": \"@claude\",\n      \"content\": \"Execution context:\\n- Background: Ralph logs session.update events from ACP stream and must attribute each event to the iteration that created that ACP session.\\n- Scope: Replace shared mutable session-iteration mapping with session-scoped update listener behavior and explicit listener cleanup when session rotates/disposes.\\n- Files: src/cli/commands/ralph.ts plus focused tests in tests/ralph.test.ts.\\n- Verification: targeted ralph tests for update attribution plus full ralph test file and kspec validate.\"\n    },\n    {\n      \"task_ref\": \"01KJDQ17W\",\n      \"task_title\": \"Ralph loop needs iteration-level timeout. When a spawned agent gets stuck (e.g., tool call hanging o\",\n      \"task_status\": \"completed\",\n      \"note_ulid\": \"01KJK83G\",\n      \"created_at\": \"2026-02-28T23:07:27.825Z\",\n      \"author\": \"@claude\",\n      \"content\": \"FIX_CYCLE: 6 Inherited needs_work task and verified PR #610 currently has no review comments/threads and all checks passing. Transitioned task through in_progress and re-submitted to pending_review for external review/merge.\"\n    },\n    {\n      \"task_ref\": \"01KJDQ1B\",\n      \"task_title\": \"Plan import warnings treated as errors in batch mode. The no YAML code block in specs section warnin\",\n      \"task_status\": \"completed\",\n      \"note_ulid\": \"01KJK81Q\",\n      \"created_at\": \"2026-02-28T23:06:29.741Z\",\n      \"author\": \"@claude\",\n      \"content\": \"[RALPH SUBAGENT] Subagent timed out after 20 minutes\"\n    },\n    {\n      \"task_ref\": \"01KJDQ1B\",\n      \"task_title\": \"Plan import warnings treated as errors in batch mode. The no YAML code block in specs section warnin\",\n      \"task_status\": \"completed\",\n      \"note_ulid\": \"01KJK81N\",\n      \"created_at\": \"2026-02-28T23:06:26.776Z\",\n      \"author\": \"@claude\",\n      \"content\": \"Automation status set to needs_review: Subagent timed out after 20 minutes\"\n    },\n    {\n      \"task_ref\": \"01KJDQ17W\",\n      \"task_title\": \"Ralph loop needs iteration-level timeout. When a spawned agent gets stuck (e.g., tool call hanging o\",\n      \"task_status\": \"completed\",\n      \"note_ulid\": \"01KJK7AY\",\n      \"created_at\": \"2026-02-28T22:54:03.228Z\",\n      \"author\": \"@claude\",\n      \"content\": \"FIX_CYCLE: 5 complete. Opened PR #610 (https://github.com/kynetic-ai/kynetic-spec/pull/610) with:\\n1. Fixed floating runIterationPrompts() promise (.catch(() => {}) before Promise.race)\\n2. Added @cli-ralph ac-24/ac-25/ac-26 for --iteration-timeout feature\\n3. Added // AC: annotations to tests/ralph.test.ts\\nAll 140 ralph tests pass.\"\n    },\n    {\n      \"task_ref\": \"01KJDQ1A\",\n      \"task_title\": \"Ralph event handler iteration attribution should use session-scoped mapping instead of shared mutabl\",\n      \"task_status\": \"needs_work\",\n      \"note_ulid\": \"01KJDQVH\",\n      \"created_at\": \"2026-02-26T19:47:16.689Z\",\n      \"author\": \"@claude\",\n      \"content\": \"Linked to @cli-ralph spec. Ralph internal: session-scoped event listener mapping. Clear scope from enrichment.\"\n    }\n  ],\n  \"active_todos\": [],\n  \"ready_tasks\": [\n    {\n      \"ref\": \"01KJGDR9\",\n      \"slug\": null,\n      \"title\": \"Fix ralph session-budget-integration test timeouts\",\n      \"description\": \"2 tests failing in tests/ralph/session-budget-integration.test.ts: (1) ralph loop times out waiting for completion marker, (2) output doesn't contain expected 'Iteration failed' string. These are race conditions or mock issues in the ralph loop test harness, not version bump related. Originally bundled in @01KJDSXEME66TYKVVGGFW6PYT2 which was cancelled after the version-bump failures resolved themselves.\",\n      \"priority\": 1,\n      \"spec_ref\": null,\n      \"tags\": [\n        \"bug\",\n        \"testing\",\n        \"ralph\"\n      ],\n      \"unlocks\": 0\n    },\n    {\n      \"ref\": \"01KHF2BK\",\n      \"slug\": null,\n      \"title\": \"Revisit ralph wrap-up agent design and test coverage\",\n      \"description\": \"PR #369 added a wrap-up agent that runs on ralph loop exit. Retrospective flagged it as over-engineered but the intent is broader than simple cleanup: it ensures all work is completed, finds in-progress work where task state doesn't match reality, root-causes whether work is still needed, and does best-effort to get the project into a clean state (either continue the loop or put work on a branch with a task for the user). Too many possible states to rely on code alone — the agent approach is intentional. However: runWrapUpAgent() has zero integration tests (all 37 tests only check prompt strings and boolean helpers). Revisit AC coverage, add integration tests for the actual agent spawn/timeout/cleanup paths, and verify the prompt adequately covers the intended scenarios.\",\n      \"priority\": 2,\n      \"spec_ref\": null,\n      \"tags\": [],\n      \"unlocks\": 0\n    },\n    {\n      \"ref\": \"01KHF2BN\",\n      \"slug\": null,\n      \"title\": \"Create spec for validate --drift feature\",\n      \"description\": \"PR #362 added kspec validate --drift, a user-facing CLI flag for AC schema field validation. This was shipped without a spec item or formal ACs, violating the spec-before-code rule. Create a spec item with acceptance criteria covering: field detection from prose, conceptual vs schema fields, strict mode, exit codes, and false positive handling.\",\n      \"priority\": 2,\n      \"spec_ref\": null,\n      \"tags\": [],\n      \"unlocks\": 0\n    },\n    {\n      \"ref\": \"01KHF34K\",\n      \"slug\": null,\n      \"title\": \"Add code-level reflect gating in ralph based on iteration delta\",\n      \"description\": \"PR #357 added skill-file instructions to gate reflection on meaningful work, but this has no enforcement. Instead: ralph should snapshot session state (task statuses, working tree, commit count) before each iteration, compare at the end, and only issue the reflect prompt if something measurably changed (task transitions, commits, file changes). The reflect prompt itself was already efficient at avoiding noisy observations — the issue is invoking it at all when nothing happened.\",\n      \"priority\": 2,\n      \"spec_ref\": null,\n      \"tags\": [],\n      \"unlocks\": 0\n    },\n    {\n      \"ref\": \"01KHVMWP\",\n      \"slug\": null,\n      \"title\": \"Write getting-started tutorial and README for external users\",\n      \"description\": \"kspec has no end-to-end tutorial for new users. INSTALL.md covers setup mechanics but doesn't show the workflow. README.md is either missing or developer-focused on the kspec project itself, not on using kspec as a tool.\\n\\n## What's needed\\n\\n**README.md** — Public-facing, explains:\\n- What kspec is (spec-first task management for AI-assisted development)\\n- Why (shadow branch, spec-driven workflow, agent integration)\\n- Quick install and init\\n- Link to getting-started tutorial\\n\\n**Getting-started tutorial** (docs/getting-started.md or similar):\\n- Walk through from 'npm install -g' to first completed task\\n- Create a spec item with acceptance criteria\\n- Derive a task from the spec\\n- Work the task (start, implement, note, submit)\\n- Create a PR with kspec trailers\\n- Complete the task\\n- Show the spec-first loop in action\\n\\n**Reference points:**\\n- kynetic-bot, imgen, comfy-ecaj-nodes are real consumer projects showing actual usage patterns\\n- All three independently converged on the same Quick Start: kspec init → kspec setup → kspec session start\\n- The workflow skills (task-work, pr, spec) contain detailed command references that the tutorial can link to rather than duplicate\\n- INSTALL.md already covers setup mechanics — tutorial should reference it, not repeat it\\n\\n## Scope boundaries\\n- README is for the npm package / GitHub repo landing page\\n- Tutorial is for humans AND agents onboarding to a new kspec project\\n- Don't duplicate skill content — link to skills for detailed command syntax\\n- Keep it practical with real examples, not abstract descriptions\",\n      \"priority\": 2,\n      \"spec_ref\": null,\n      \"tags\": [],\n      \"unlocks\": 0\n    }\n  ],\n  \"blocked_tasks\": [],\n  \"recently_completed\": [\n    {\n      \"ref\": \"01KJDQ17W\",\n      \"slug\": null,\n      \"title\": \"Ralph loop needs iteration-level timeout. When a spawned agent gets stuck (e.g., tool call hanging o\",\n      \"completed_at\": \"2026-02-28T23:14:18.000Z\",\n      \"closed_reason\": \"Merged in PR #610. Implemented iteration-timeout hardening by capturing runIterationPrompts() promise and attaching catch before Promise.race to prevent Node.js 22 unhandled rejection on timeout/dispose path. Added/confirmed @cli-ralph ac-24/ac-25/ac-26 for iteration-timeout defaults, validation, and iteration.timeout event behavior, with AC annotations in tests/ralph.test.ts. Verified @cli-ralph AC annotation coverage across ac-1..ac-26 and green PR CI on merge commit 3935ca808c131813871ec5a48e7550f9a239a5a1.\"\n    },\n    {\n      \"ref\": \"01KJDQ1B\",\n      \"slug\": null,\n      \"title\": \"Plan import warnings treated as errors in batch mode. The no YAML code block in specs section warnin\",\n      \"completed_at\": \"2026-02-28T23:05:33.314Z\",\n      \"closed_reason\": \"Merged in PR #609. Fixed batch-mode plan import by replacing process.exit(EXIT_CODES.SUCCESS) with return in plan-import.ts success path, preventing BatchExitError interception. Added regression test in batch-exec-engine.test.ts covering warning-only plan import succeeds in batch (ac-34, ac-23). All CI checks passed.\"\n    },\n    {\n      \"ref\": \"01KJGBWP\",\n      \"slug\": \"implement-auto-abandon-metadata-and-audit-trail\",\n      \"title\": \"Implement Auto-abandon Metadata and Audit Trail\",\n      \"completed_at\": \"2026-02-28T22:19:13.639Z\",\n      \"closed_reason\": \"Merged in PR #607. Implemented stale auto-abandon metadata apply helper with canonical close_reason format, shared ended_at/status=abandoned updates, dry-run preview, and one command-specific shadow commit path for multi-session persistence. Verified AC coverage for @session-stale-close-metadata ac-1..ac-4 in tests/session-stale-criteria.test.ts and confirmed green CI on commit 8131a376.\"\n    },\n    {\n      \"ref\": \"01KJGBWNW\",\n      \"slug\": \"implement-stale-session-candidate-criteria\",\n      \"title\": \"Implement Stale Session Candidate Criteria\",\n      \"completed_at\": \"2026-02-28T21:43:37.853Z\",\n      \"closed_reason\": \"Merged in PR #605. Implemented stale session candidate criteria engine with relative-duration validation/defaults, AND threshold evaluation, started_at fallback, strict corrupt/unreadable events handling with skipped/failure reporting, and liveness guard suppression. AC coverage verified for @session-stale-criteria ac-1 through ac-8 (including unreadable events path).\"\n    },\n    {\n      \"ref\": \"01KJGQVK\",\n      \"slug\": null,\n      \"title\": \"Clarify core skill update behavior for local template edits\",\n      \"completed_at\": \"2026-02-28T20:58:20.117Z\",\n      \"closed_reason\": \"Merged in PR #603. Implemented same-version template drift detection in skill update and explicit guidance to run 'kspec skill install-core' when local files differ despite matching version, including dry-run output. Added regression tests for drift guidance in tests/core-skill-update.test.ts. AC coverage confirmed for @core-skill-update ac-1, ac-2, ac-3; full regression suite passed via npm test.\",\n      \"origin\": \"observation_promotion\"\n    },\n    {\n      \"ref\": \"01KJGV65\",\n      \"slug\": null,\n      \"title\": \"Add integration test for config-aware init output messaging\",\n      \"completed_at\": \"2026-02-28T20:51:34.652Z\",\n      \"closed_reason\": \"Merged in PR #604. Added integration test coverage in tests/init-setup-integration.test.ts for config-aware init output messaging when running without --setup; verifies custom shadow directory (.specs) and branch (specs-meta) are shown in Next steps/Note output and guards against fallback to hardcoded defaults. AC coverage confirmed for @init-setup-integration ac-1 through ac-4 (trait ACs N/A).\"\n    },\n    {\n      \"ref\": \"01KJHAD8\",\n      \"slug\": null,\n      \"title\": \"Fix: Truncate oversized ACP prompt payloads\",\n      \"completed_at\": \"2026-02-28T19:01:41.319Z\",\n      \"closed_reason\": \"PR #590 reviewed and merged at head 690d0648\"\n    },\n    {\n      \"ref\": \"01KJJGJ1\",\n      \"slug\": null,\n      \"title\": \"Fix merge driver non-interactive flag and improve conflict resolution\",\n      \"completed_at\": \"2026-02-28T16:58:33.763Z\",\n      \"closed_reason\": \"Merged in PR #601. Fixed merge driver: (1) shadow.ts validates/fixes stale config missing --non-interactive, (2) TTY detection auto-enables non-interactive when stdin is not TTY, (3) non-interactive mode exits 0 even with conflicts per spec ac-10. All tests pass.\"\n    },\n    {\n      \"ref\": \"01KJDQ19\",\n      \"slug\": null,\n      \"title\": \"CLI args should accept both kebab-case and underscore variants (e.g. depends-on and depends_on). Cur\",\n      \"completed_at\": \"2026-02-28T14:07:12.388Z\",\n      \"closed_reason\": \"Merged in PR #600. Implemented canonical arg-key normalization for batch args so kebab-case, camelCase, and underscore variants are accepted consistently in validation, required-arg checks, and argv generation. Added underscore regression tests in batch schema and batch exec engine coverage. Verified by full npm test (3550 passed) and green PR CI checks on commit b7b44fb4a11a5a4d655333b96a9e13368d95b9ed.\"\n    },\n    {\n      \"ref\": \"01KJDQ11\",\n      \"slug\": null,\n      \"title\": \"Fix @observations slug ambiguity — kspec validate reports 6 errors for duplicate slug. Pre-existing \",\n      \"completed_at\": \"2026-02-28T13:53:13.698Z\",\n      \"closed_reason\": \"Merged in PR #599 (commit 5ee2254244a7c9aa718493418964a600869f4b97). Removed legacy /kspec:observations skill entry ambiguity by retaining canonical /kspec:observe in generated agent instructions; duplicate @observations reference errors resolved (References: OK). AC coverage N/A for this infra task (no spec_ref). Local regression: npm test passed (3548 passed, 0 failed).\"\n    }\n  ],\n  \"recent_commits\": [\n    {\n      \"hash\": \"4c81ac5\",\n      \"full_hash\": \"4c81ac594ebc432e3e7114e003b0c374a5464704\",\n      \"date\": \"2026-02-28T23:19:12.000Z\",\n      \"message\": \"fix: use session-scoped ralph update attribution\",\n      \"author\": \"Jacob Chapel\",\n      \"task_refs\": [\n        \"01KJDQ1AF125H0FK29HE769R4P\"\n      ]\n    },\n    {\n      \"hash\": \"3935ca8\",\n      \"full_hash\": \"3935ca808c131813871ec5a48e7550f9a239a5a1\",\n      \"date\": \"2026-02-28T23:14:04.000Z\",\n      \"message\": \"fix: prevent unhandled rejection on iteration timeout (Node.js 22) (#610)\",\n      \"author\": \"Jacob Chapel\",\n      \"task_refs\": [\n        \"01KJDQ17W\"\n      ]\n    },\n    {\n      \"hash\": \"18ca84b\",\n      \"full_hash\": \"18ca84bc8b20998fce148644e19632d62777368d\",\n      \"date\": \"2026-02-28T23:05:21.000Z\",\n      \"message\": \"fix: keep warning-only plan import successful in batch (#609)\",\n      \"author\": \"Jacob Chapel\",\n      \"task_refs\": [\n        \"01KJDQ1B9C62DT55EK8WK01BP0\"\n      ]\n    },\n    {\n      \"hash\": \"0b1fbc2\",\n      \"full_hash\": \"0b1fbc2df9e77af7fbf28e09211f70134816a845\",\n      \"date\": \"2026-02-28T22:53:06.000Z\",\n      \"message\": \"fix: prevent unhandled rejection on iteration timeout in Node.js 22\",\n      \"author\": \"Jacob Chapel\",\n      \"task_refs\": [\n        \"01KJDQ17W\"\n      ]\n    },\n    {\n      \"hash\": \"866d0ef\",\n      \"full_hash\": \"866d0ef28bed9a8adfb52d8af1e440339f8e2cb8\",\n      \"date\": \"2026-02-28T22:45:55.000Z\",\n      \"message\": \"feat: add ralph iteration-timeout guard (#608)\",\n      \"author\": \"Jacob Chapel\",\n      \"task_refs\": [\n        \"01KJDQ17W\"\n      ]\n    },\n    {\n      \"hash\": \"eca0f63\",\n      \"full_hash\": \"eca0f6391629d681d64c87524a471dada1390a6e\",\n      \"date\": \"2026-02-28T22:37:02.000Z\",\n      \"message\": \"fix: keep warning-only plan import successful in batch\",\n      \"author\": \"Jacob Chapel\",\n      \"task_refs\": [\n        \"01KJDQ1B9C62DT55EK8WK01BP0\"\n      ]\n    },\n    {\n      \"hash\": \"3e73009\",\n      \"full_hash\": \"3e730097098c8383616ddae2528ebb7377c026de\