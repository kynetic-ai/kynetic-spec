  {
    "_ulid": "01KHWQEHECGPFNSCHEWF6AQ5Y3",
    "slugs": [],
    "title": "Add merge blocker when review subagent times out",
    "type": "task",
    "description": "When a ralph review subagent times out, markTaskNeedsReview is called but the PR itself has no GitHub-level blocker. The next iteration's worker or CI auto-merge can merge the PR without any review having occurred.\n\nWhen a review subagent times out or fails:\n- Add a 'review-pending' label to the PR, OR\n- Post a comment noting the review was incomplete\n- Do not proceed to merge until a review subagent successfully completes\n\nThis prevents the rubber-stamp pattern observed in session 01KHW4RP where all 10 PRs merged with zero reviews.",
    "spec_ref": null,
    "meta_ref": null,
    "plan_ref": null,
    "status": "completed",
    "blocked_by": [],
    "closed_reason": "Merged in PR #424. Added commentOnPRReviewIncomplete() that posts warning comment on PR when review subagent times out or fails, using task's branch for correct PR lookup.",
    "depends_on": [],
    "context": [],
    "priority": 2,
    "tags": [
      "ralph",
      "infra"
    ],
    "vcs_refs": [],
    "created_at": "2026-02-20T05:13:05.740Z",
    "started_at": "2026-02-20T05:39:31.107Z",
    "completed_at": "2026-02-20T06:05:23.184Z",
    "notes": [
      {
        "_ulid": "01KHWS1EV61C1WEDAVPBHWKCZD",
        "created_at": "2026-02-20T05:40:54.246Z",
        "author": "@claude",
        "content": "Added commentOnPRReviewIncomplete() function that uses 'gh pr list' to find the open PR on the current branch and posts a warning comment when the review subagent times out or fails. Called from both the timeout and failure paths in processPendingReviewTasks. The comment warns that the PR was not fully reviewed and recommends manual review before merging. This creates a visible GitHub-level marker that the check-unresolved-comments CI check can surface.",
        "supersedes": null
      }
    ],
    "todos": [],
    "automation": "eligible",
    "_sourceFile": "/workspace/.kspec/project.tasks.yaml"
