    "_ulid": "01KGYBZMG0VMHRX7SB89F8W3YB",
    "slugs": [
      "agents-md-cross-pollinate"
    ],
    "title": "Apply kynetic-bot AGENTS.md learnings to kynetic-spec",
    "type": "task",
    "spec_ref": null,
    "meta_ref": null,
    "plan_ref": null,
    "status": "completed",
    "blocked_by": [],
    "closed_reason": "Fixed 4 factual errors in AGENTS.md Running Services (PR #351, merged). Dual defaults captured as inbox item @01KH20S1. PR agent limitations finding not applicable. Duplicate guidance is minor — no action taken.",
    "depends_on": [],
