        "_ulid": "01KHAPKTPZD285ZFYZMVKMT30J",
        "created_at": "2026-02-13T05:12:10.720Z",
        "author": "@claude",
        "content": "Bug: --depends-on stores bare IDs without @ prefix, breaking dependency resolution. Fix: normalize references in task set, task add, and derive. Implements ac-1 on @rel-depends-on.",
        "supersedes": null
      }
    ],
    "todos": [],
    "_sourceFile": "/workspace/.kspec/project.tasks.yaml"
