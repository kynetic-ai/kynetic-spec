    "derivation": "auto",
    "status": "completed",
    "blocked_by": [],
    "closed_reason": "Merged in PR #212. Created @task-work-loop workflow with 8 steps for autonomous agents. Updated spec to remove ralph-specific ACs (ac-2, ac-10) and keep verification (ac-6).",
    "depends_on": [
