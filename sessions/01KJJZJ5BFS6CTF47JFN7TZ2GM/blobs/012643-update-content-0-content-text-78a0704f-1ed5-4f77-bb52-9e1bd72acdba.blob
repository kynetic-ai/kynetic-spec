    "spec_ref": null,
    "status": "completed",
    "blocked_by": [],
    "closed_reason": "Fixed spec status persistence gap by adding commitIfShadow calls after spec sync in both task start and task complete commands. All tests pass (561/561).",
    "depends_on": [],
    "context": [],
    "priority": 3,
    "tags": [
      "workflow",
      "spec",
      "gap"
    ],
    "vcs_refs": [],
