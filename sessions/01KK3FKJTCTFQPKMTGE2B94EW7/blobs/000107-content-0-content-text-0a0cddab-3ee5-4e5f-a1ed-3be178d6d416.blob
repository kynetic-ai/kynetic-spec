   527→							>
   528→								{isSubmitting ? 'Adding...' : 'Add Note'}
   529→							</Button>
   530→						</div>
   531→					{/if}
   532→
   533→					<!-- Notes List -->
   534→					<div class="space-y-4" data-testid="task-notes-list">
   535→						{#each panel.task.notes ?? [] as note}
   536→							<div class="border rounded-lg p-3" data-testid="note-item">
