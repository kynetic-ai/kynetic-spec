   315→	<TaskFilters />
   316→
   317→	{#if filterParams.plan}
   318→		<div class="flex items-center gap-2 text-sm text-muted-foreground bg-muted/50 rounded-md px-3 py-2" data-testid="plan-filter-banner">
   319→			Filtered by plan: <code class="bg-muted px-1 py-0.5 rounded text-xs">@{filterParams.plan}</code>
   320→			<a href="{base}/tasks" class="ml-auto text-primary hover:underline text-xs">Clear filter</a>
   321→		</div>
   322→	{/if}
   323→
   324→	{#if error}
   325→		<div class="bg-destructive/10 text-destructive p-4 rounded-lg" data-testid="error-message" role="alert">
   326→			{error}
   327→		</div>
   328→	{/if}
   329→
   330→	{#if loading}
   331→		<div class="flex justify-center items-center py-12">
