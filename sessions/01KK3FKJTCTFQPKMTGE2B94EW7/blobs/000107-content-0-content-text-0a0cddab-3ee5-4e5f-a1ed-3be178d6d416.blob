```
     1→<script lang="ts">
     2→	// AC: @web-dashboard ac-4, ac-5, ac-9, ac-10, ac-33
     3→	// AC: @multi-directory-daemon ac-27 - Reload on project change
     4→	// AC: @gh-pages-export ac-16 - Disable Start Task in static mode
     5→	import { page } from '$app/stores';
     6→	import { base } from '$app/paths';
     7→	import { onMount, onDestroy, flushSync } from 'svelte';
     8→	import type { TaskSummary, TaskDetail, BroadcastEvent } from '@kynetic-ai/shared';
     9→	import TaskFilters from '$lib/components/TaskFilters.svelte';
    10→	import TaskList from '$lib/components/TaskList.svelte';
    11→	import { fetchTasks, fetchTask, startTask, addTaskNote } from '$lib/api';
    12→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    13→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    14→	import { Button } from '$lib/components/ui/button';
    15→	import { Badge } from '$lib/components/ui/badge';
    16→	import { Textarea } from '$lib/components/ui/textarea';
    17→	import { Separator } from '$lib/components/ui/separator';
    18→	import * as Tooltip from '$lib/components/ui/tooltip';
    19→	import XIcon from '@lucide/svelte/icons/x';
    20→	import LayoutGrid from '@lucide/svelte/icons/layout-grid';
    21→	import ListIcon from '@lucide/svelte/icons/list';
    22→	import { getProjectVersion } from '$lib/stores/project.svelte';
    23→
    24→	let tasks = $state<TaskSummary[]>([]);
    25→	let total = $state(0);
    26→	let loading = $state(true);
    27→	let error = $state('');
    28→	let updatedTaskIds = $state<Set<string>>(new Set());
    29→
    30→	// Use $state with an object for panel state to ensure deep reactivity
    31→	let panel = $state<{ open: boolean; task: TaskDetail | null }>({
    32→		open: false,
    33→		task: null
    34→	});
    35→
    36→	let noteContent = $state('');
    37→	let isSubmitting = $state(false);
    38→	let panelError = $state('');
    39→
    40→	// Reactive: re-fetch when URL params change
    41→	let filterParams = $derived({
    42→		status: $page.url.searchParams.get('status') || undefined,
    43→		type: $page.url.searchParams.get('type') || undefined,
    44→		tag: $page.url.searchParams.get('tag') || undefined,
    45→		assignee: $page.url.searchParams.get('assignee') || undefined,
    46→		automation: $page.url.searchParams.get('automation') || undefined,
    47→		plan: $page.url.searchParams.get('plan') || undefined,
    48→		limit: 50,
    49→		offset: 0
    50→	});
    51→
    52→	// Track the last processed ref to avoid infinite loops
    53→	let lastProcessedRef = $state('');
    54→
    55→	$effect(() => {
    56→		// Re-fetch when filterParams changes - explicitly access all properties for dependency tracking
    57→		const { status, type, tag, assignee, automation, plan, limit, offset } = filterParams;
    58→		loadTasks();
    59→	});
    60→
    61→	// AC: @multi-directory-daemon ac-27 - Reload data when project changes
    62→	$effect(() => {
    63→		const version = getProjectVersion();
    64→		if (version > 0) {
    65→			// Only reload if version has been incremented (not on initial load)
    66→			loadTasks();
    67→		}
    68→	});
    69→
    70→	// AC: Open task detail when URL has ref param
    71→	$effect(() => {
    72→		const urlRef = $page.url.searchParams.get('ref');
    73→		if (urlRef && urlRef !== lastProcessedRef) {
    74→			lastProcessedRef = urlRef;
    75→			handleSelectTask(urlRef);
    76→		}
    77→	});
    78→
    79→	async function loadTasks() {
    80→		loading = true;
    81→		error = '';
    82→
    83→		try {
    84→			const response = await fetchTasks(filterParams);
    85→			tasks = response.items;
    86→			total = response.total;
    87→		} catch (err) {
    88→			error = err instanceof Error ? err.message : 'Failed to load tasks';
    89→			console.error('Error loading tasks:', err);
    90→		} finally {
    91→			loading = false;
    92→		}
    93→	}
    94→
    95→	async function handleSelectTask(taskId: string) {
    96→		console.log('[TasksPage] handleSelectTask called for:', taskId);
    97→		try {
    98→			console.log('[TasksPage] Fetching task details...');
    99→			const task = await fetchTask(taskId);
   100→			console.log('[TasksPage] Task fetched:', task?.title);
   101→			// Update panel state using flushSync to ensure synchronous DOM update
   102→			flushSync(() => {
   103→				panel.task = task;
   104→				panel.open = true;
   105→			});
   106→			console.log('[TasksPage] panel.open set to true, panel.task:', panel.task?.title);
   107→		} catch (err) {
   108→			error = err instanceof Error ? err.message : 'Failed to load task details';
   109→			console.error('[TasksPage] Error loading task:', err);
   110→		}
   111→	}
   112→
   113→	// Legacy event handler for backwards compatibility
   114→	function handleSelectTaskEvent(event: CustomEvent<string>) {
   115→		handleSelectTask(event.detail);
   116→	}
   117→
   118→	function handleCloseDetail() {
   119→		panel.open = false;
   120→		panel.task = null;
   121→		noteContent = '';
   122→		panelError = '';
   123→		lastProcessedRef = ''; // Reset so we can reopen same task if URL param set again
   124→	}
   125→
   126→	// Handle clicking outside the panel
   127→	function handleOverlayClick(e: MouseEvent) {
   128→		if (e.target === e.currentTarget) {
   129→			handleCloseDetail();
   130→		}
   131→	}
   132→
   133→	// Handle escape key
   134→	function handleKeydown(e: KeyboardEvent) {
   135→		if (e.key === 'Escape' && panel.open) {
   136→			handleCloseDetail();
   137→		}
   138→	}
   139→
   140→	async function handleStartTask() {
   141→		if (!panel.task) return;
   142→
   143→		// AC: @gh-pages-export ac-16, ac-18 - Check static mode
   144→		if (isStaticMode()) {
   145→			panelError = 'Cannot start task in read-only mode. Use the kspec CLI.';
   146→			return;
   147→		}
   148→
   149→		isSubmitting = true;
   150→		panelError = '';
   151→
   152→		try {
   153→			await startTask(panel.task._ulid);
   154→			// Reload task to get updated status
   155→			const updated = await fetchTask(panel.task._ulid);
   156→			panel.task = updated;
   157→			loadTasks();
   158→		} catch (err) {
   159→			// AC: @gh-pages-export ac-18 - Graceful error message
   160→			if (err instanceof ReadOnlyModeError) {
   161→				panelError = err.message;
   162→			} else {
   163→				panelError = err instanceof Error ? err.message : 'Failed to start task';
   164→			}
   165→		} finally {
   166→			isSubmitting = false;
   167→		}
   168→	}
   169→
   170→	async function handleAddNote() {
   171→		if (!panel.task || !noteContent.trim()) return;
   172→
   173→		// AC: @gh-pages-export ac-18 - Check static mode
   174→		if (isStaticMode()) {
   175→			panelError = 'Cannot add notes in read-only mode. Use the kspec CLI.';
   176→			return;
   177→		}
   178→
   179→		isSubmitting = true;
   180→		panelError = '';
   181→
   182→		try {
   183→			await addTaskNote(panel.task._ulid, noteContent);
   184→			noteContent = '';
   185→			// Reload task to get updated notes
   186→			const updated = await fetchTask(panel.task._ulid);
   187→			panel.task = updated;
   188→			loadTasks();
   189→		} catch (err) {
   190→			// AC: @gh-pages-export ac-18 - Graceful error message
   191→			if (err instanceof ReadOnlyModeError) {
   192→				panelError = err.message;
   193→			} else {
   194→				panelError = err instanceof Error ? err.message : 'Failed to add note';
   195→			}
   196→		} finally {
   197→			isSubmitting = false;
   198→		}
   199→	}
   200→
   201→	function formatDate(dateStr: string): string {
   202→		const date = new Date(dateStr);
   203→		return new Intl.DateTimeFormat('en-US', {
   204→			year: 'numeric',
   205→			month: 'short',
   206→			day: 'numeric',
   207→			hour: '2-digit',
   208→			minute: '2-digit'
   209→		}).format(date);
   210→	}
   211→
   212→	function getStatusColor(status: string): string {
   213→		const colors: Record<string, string> = {
   214→			pending: 'bg-status-pending text-status-pending-fg',
   215→			in_progress: 'bg-status-in-progress text-status-in-progress-fg',
   216→			pending_review: 'bg-status-pending-review text-status-pending-review-fg',
   217→			needs_work: 'bg-status-needs-work text-status-needs-work-fg',
   218→			blocked: 'bg-status-blocked text-status-blocked-fg',
   219→			completed: 'bg-status-completed text-status-completed-fg',
   220→			cancelled: 'bg-status-cancelled text-status-cancelled-fg'
   221→		};
   222→		return colors[status] || 'bg-status-cancelled text-status-cancelled-fg';
   223→	}
   224→
   225→	function formatStatus(status: string): string {
   226→		const labels: Record<string, string> = {
   227→			pending: 'Pending',
   228→			in_progress: 'In Progress',
   229→			pending_review: 'Pending Review',
   230→			needs_work: 'Needs Work',
   231→			blocked: 'Blocked',
   232→			completed: 'Completed',
   233→			cancelled: 'Cancelled'
   234→		};
   235→		return labels[status] || status;
   236→	}
   237→
   238→	// AC: @web-dashboard ac-33 - Handle WebSocket task updates
   239→	function handleTaskUpdate(event: BroadcastEvent) {
   240→		console.log('[TasksPage] Task update received:', event);
   241→
   242→		// Mark task as updated for highlight animation
   243→		if (event.data?.ulid) {
   244→			updatedTaskIds.add(event.data.ulid);
   245→			updatedTaskIds = new Set(updatedTaskIds);
   246→
   247→			// Remove highlight after 3s
   248→			setTimeout(() => {
   249→				updatedTaskIds.delete(event.data.ulid);
   250→				updatedTaskIds = new Set(updatedTaskIds);
   251→			}, 3000);
   252→		}
   253→
   254→		// Reload tasks list
   255→		loadTasks();
   256→
   257→		// Reload selected task if it's the one that updated
   258→		if (panel.task && event.data?.ulid === panel.task._ulid) {
   259→			fetchTask(panel.task._ulid)
   260→				.then((updated) => {
   261→					panel.task = updated;
   262→				})
   263→				.catch((err) => {
   264→					console.error('Error reloading task:', err);
   265→				});
   266→		}
   267→	}
   268→
   269→	onMount(() => {
   270→		loadTasks();
   271→
   272→		// AC: @web-dashboard ac-32, ac-33 - Subscribe to task updates
   273→		subscribe(['tasks']);
   274→		on('tasks', handleTaskUpdate);
   275→	});
   276→
   277→	onDestroy(() => {
   278→		// Clean up subscription
   279→		off('tasks', handleTaskUpdate);
   280→		unsubscribe(['tasks']);
   281→	});
   282→</script>
   283→
   284→<svelte:window onkeydown={handleKeydown} />
   285→
   286→<div class="flex flex-col gap-6 p-6">
   287→	<div class="flex items-center justify-between">
   288→		<div>
   289→			<h1 class="text-3xl font-bold mb-2">Tasks</h1>
   290→			{#if !loading}
   291→				<p class="text-muted-foreground">
   292→					Showing {tasks.length} of {total} tasks
   293→				</p>
   294→			{/if}
   295→		</div>
   296→		<!-- View toggle -->
   297→		<div class="flex items-center gap-1 border rounded-lg p-0.5">
