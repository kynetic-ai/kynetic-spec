   333→		</div>
   334→	{:else}
   335→		<!-- AC: @web-dashboard ac-33 -->
   336→		<TaskList {tasks} {updatedTaskIds} onSelectTask={handleSelectTask} on:select={handleSelectTaskEvent} />
   337→	{/if}
