   358→			onkeydown={(e) => e.stopPropagation()}
   359→		>
   360→			<!-- Header -->
   361→			<div class="flex items-center justify-between p-6 border-b">
   362→				<h2 class="text-lg font-semibold" data-testid="task-description">{panel.task.title}</h2>
   363→				<button
   364→					onclick={handleCloseDetail}
