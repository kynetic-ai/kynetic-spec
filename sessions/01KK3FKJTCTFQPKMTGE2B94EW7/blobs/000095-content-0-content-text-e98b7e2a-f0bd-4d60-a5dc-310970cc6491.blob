   808→// AC: @ui-session-stream ac-1, ac-2, ac-4
   809→// ============================================================
   810→
   811→/**
   812→ * Session summary from the daemon API.
   813→ */
   814→export interface SessionSummary {
   815→	id: string;
   816→	status: 'active' | 'completed' | 'abandoned' | 'timed_out' | 'failed';
   817→	agent_type: string;
   818→	session_type: 'loop' | 'invocation';
   819→	/** Dispatch trigger for distinguishing dispatched agent vs manual CLI run. */
   820→	trigger?: string;
