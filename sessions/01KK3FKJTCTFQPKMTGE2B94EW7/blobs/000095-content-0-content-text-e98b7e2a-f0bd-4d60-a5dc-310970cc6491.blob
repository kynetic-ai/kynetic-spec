   911→
   912→/**
   913→ * Fetch session events (optionally incremental via since_seq).
   914→ * AC: @ui-session-stream ac-1, ac-2
   915→ */
   916→export async function fetchSessionEvents(
   917→	id: string,
   918→	sinceSeq?: number
   919→): Promise<{ events: SessionEvent[]; total: number }> {
   920→	if (isStaticMode()) {
   921→		return { events: [], total: 0 };
