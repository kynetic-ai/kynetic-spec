   925→	if (sinceSeq !== undefined) {
   926→		url.searchParams.set('since_seq', String(sinceSeq));
   927→	}
   928→
   929→	const response = await fetch(url.toString(), {
   930→		headers: getProjectHeaders()
   931→	});
   932→	if (!response.ok) {
   933→		await handleResponseError(response);
   934→	}
   935→
   936→	return response.json();
   937→}
