   847→	started_this_cycle: number;
   848→}
   849→
   850→/**
   851→ * Session detail with additional metadata.
   852→ * AC: @ui-session-stream ac-4
   853→ */
   854→export interface SessionDetail extends SessionSummary {
   855→	task_id?: string;
   856→	agent_id?: string;
   857→	trigger?: string;
   858→	spec_context?: SessionSpecContext | null;
   859→	budget?: SessionBudget | null;
   860→}
   861→
   862→/**
   863→ * A single event from events.jsonl.
   864→ */
   865→export interface SessionEvent {
   866→	ts: number;
   867→	seq: number;
   868→	type: string;
   869→	session_id: string;
   870→	trace_id?: string;
   871→	data: unknown;
   872→}
   873→
   874→/**
   875→ * Fetch all sessions with summaries.
   876→ * AC: @ui-session-stream ac-1
   877→ */
   878→export async function fetchSessions(): Promise<{ items: SessionSummary[]; total: number }> {
   879→	if (isStaticMode()) {
