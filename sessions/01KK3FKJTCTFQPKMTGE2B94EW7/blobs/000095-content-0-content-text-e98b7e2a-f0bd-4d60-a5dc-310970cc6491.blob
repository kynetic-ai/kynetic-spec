   975→
   976→export type CompletenessWarningType =
   977→	| 'missing_acceptance_criteria'
   978→	| 'missing_description'
   979→	| 'status_inconsistency'
   980→	| 'missing_test_coverage'
   981→	| 'automation_eligible_no_spec'
