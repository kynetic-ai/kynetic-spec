   893→/**
   894→ * Fetch a single session by ID.
   895→ * AC: @ui-session-stream ac-4
   896→ */
   897→export async function fetchSession(id: string): Promise<SessionDetail> {
   898→	if (isStaticMode()) {
   899→		throw new Error('Session data not available in static mode');
   900→	}
   901→
   902→	const response = await fetch(`${API_BASE}/api/sessions/${id}`, {
   903→		headers: getProjectHeaders()
   904→	});
   905→	if (!response.ok) {
