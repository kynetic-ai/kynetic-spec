   766→			if (value !== undefined && value !== '') {
   767→				url.searchParams.set(key, String(value));
   768→			}
   769→		});
   770→	}
   771→
   772→	const response = await fetch(url.toString(), {
   773→		headers: getProjectHeaders()
   774→	});
   775→	if (!response.ok) {
   776→		await handleResponseError(response);
   777→	}
   778→
   779→	return response.json();
   780→}
