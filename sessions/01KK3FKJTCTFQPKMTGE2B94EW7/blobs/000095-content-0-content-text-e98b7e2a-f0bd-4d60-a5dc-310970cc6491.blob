   494→/**
   495→ * Search across all entities
   496→ * AC: @web-dashboard ac-24
   497→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   498→ * AC: @gh-pages-export ac-11 - Static mode support
   499→ */
   500→export async function search(query: string): Promise<SearchResponse> {
   501→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   502→	if (isStaticMode()) {
   503→		return searchStatic(query);
   504→	}
   505→
   506→	const url = new URL(`${API_BASE}/api/search`);
   507→	url.searchParams.set('q', query);
   508→
   509→	const response = await fetch(url.toString(), {
   510→		headers: getProjectHeaders()
   511→	});
   512→	if (!response.ok) {
   513→		await handleResponseError(response);
   514→	}
   515→
   516→	return response.json();
   517→}
