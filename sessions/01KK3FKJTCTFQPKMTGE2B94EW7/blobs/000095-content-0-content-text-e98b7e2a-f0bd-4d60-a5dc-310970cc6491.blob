   837→	title: string;
   838→	acceptance_criteria: Array<{ id: string; description: string }>;
   839→}
   840→
   841→/**
   842→ * Session budget info.
   843→ * AC: @ui-session-stream ac-4
   844→ */
   845→export interface SessionBudget {
