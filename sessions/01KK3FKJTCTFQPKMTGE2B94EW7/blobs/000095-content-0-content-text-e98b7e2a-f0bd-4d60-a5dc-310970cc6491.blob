   616→// ============================================================
   617→// Agent & Dispatch API Functions
   618→// AC: @ui-agent-dispatch ac-1, ac-2, ac-3
   619→// ============================================================
   620→
   621→// AgentDefinition and AgentUpdatePayload are imported from @kynetic-ai/shared
   622→// (schema-driven types mirroring AgentSchema from src/schema/meta.ts)
   623→// Re-exported so existing imports from '$lib/api' continue to work.
   624→// AC: @ui-agent-dispatch ac-4
   625→export type { AgentDefinition, AgentUpdatePayload };
   626→
   627→/**
   628→ * Active invocation from GET /api/agent/status
   629→ */
   630→export interface ActiveInvocation {
   631→	session_id: string;
   632→	agent_id: string;
   633→	task_ref: string | null;
   634→	elapsed_ms: number;
   635→}
   636→
   637→/**
   638→ * Agent dispatch status from GET /api/agent/status
   639→ */
   640→export interface AgentDispatchStatus {
   641→	dispatch_enabled: boolean;
   642→	active_invocations: ActiveInvocation[];
   643→	queue_depth: number;
   644→	agent_definitions: Array<{
   645→		id: string;
   646→		name: string;
   647→		adapter: string;
   648→		completed_sessions?: number;
   649→	}>;
   650→}
   651→
   652→/**
   653→ * Fetch agent dispatch status (dispatch state + active invocations)
   654→ * AC: @ui-agent-dispatch ac-1, ac-2, ac-3
   655→ */
   656→export async function fetchAgentStatus(): Promise<AgentDispatchStatus> {
