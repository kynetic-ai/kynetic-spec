```
     1→/**
     2→ * API Client
     3→ *
     4→ * Helper functions for making requests to the kspec daemon API.
     5→ * Supports both daemon mode (live) and static mode (read-only JSON).
     6→ *
     7→ * AC Coverage:
     8→ * - ac-26 (@multi-directory-daemon): X-Kspec-Dir header injection
     9→ * - ac-36 (@multi-directory-daemon): Invalid project error detection
    10→ * - ac-11 (@gh-pages-export): Mode-aware API dispatch
    11→ * - ac-18 (@gh-pages-export): Graceful no-op for write operations
    12→ */
    13→
    14→import type {
    15→	TaskSummary,
    16→	TaskDetail,
    17→	ItemSummary,
    18→	ItemDetail,
    19→	InboxItem,
    20→	SessionContext,
    21→	Observation,
    22→	Workflow,
    23→	PaginatedResponse,
    24→	PlanSummary,
    25→	ErrorResponse,
    26→	SearchResponse,
    27→	AgentDefinition,
    28→	AgentUpdatePayload
    29→} from '@kynetic-ai/shared';
    30→import type { TriageRecord } from './types/triage';
    31→import {
    32→	getSelectedProjectPath,
    33→	clearInvalidSelection,
    34→	isInvalidProjectError,
    35→	type Project
    36→} from './stores/project.svelte';
    37→import { isStaticMode, assertWritable } from './stores/mode.svelte';
    38→import {
    39→	fetchTasksStatic,
    40→	fetchTaskStatic,
    41→	fetchItemsStatic,
    42→	fetchItemStatic,
    43→	fetchItemTasksStatic,
    44→	fetchInboxStatic,
    45→	fetchSessionContextStatic,
    46→	fetchObservationsStatic,
    47→	searchStatic,
    48→	fetchTriageRecordsStatic,
    49→	fetchPlansStatic,
    50→	fetchWorkflowsStatic
    51→} from './api-static';
    52→import { DAEMON_API_BASE } from './constants';
    53→
    54→const API_BASE = DAEMON_API_BASE;
    55→
    56→/**
    57→ * Get headers for API requests, including X-Kspec-Dir if project is selected
    58→ * AC: @multi-directory-daemon ac-26
    59→ */
    60→function getProjectHeaders(): HeadersInit {
    61→	const path = getSelectedProjectPath();
    62→	return path ? { 'X-Kspec-Dir': path } : {};
    63→}
    64→
    65→/**
    66→ * Handle response errors, detecting invalid project errors
    67→ * AC: @multi-directory-daemon ac-36
    68→ */
    69→async function handleResponseError(response: Response): Promise<never> {
    70→	const error: ErrorResponse = await response.json();
    71→	const message = error.message || error.error;
    72→
    73→	// Check if this is an invalid project error
    74→	if (isInvalidProjectError(response, message)) {
    75→		clearInvalidSelection();
    76→	}
    77→
    78→	throw new Error(message);
    79→}
    80→
    81→/**
    82→ * Fetch registered projects
    83→ * AC: @multi-directory-daemon ac-25, ac-28
    84→ */
    85→export async function fetchProjects(): Promise<{ projects: Project[] }> {
    86→	const response = await fetch(`${API_BASE}/api/projects`);
    87→	if (!response.ok) {
    88→		await handleResponseError(response);
    89→	}
    90→	return response.json();
    91→}
    92→
    93→/**
    94→ * Fetch tasks with optional filters
    95→ * AC: @web-dashboard ac-9, ac-10
    96→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
    97→ * AC: @gh-pages-export ac-11 - Static mode support
    98→ */
    99→export async function fetchTasks(params?: {
   100→	status?: string;
   101→	type?: string;
   102→	tag?: string;
   103→	assignee?: string;
   104→	automation?: string;
   105→	plan?: string;
   106→	limit?: number;
   107→	offset?: number;
   108→}): Promise<PaginatedResponse<TaskSummary>> {
   109→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   110→	if (isStaticMode()) {
   111→		return fetchTasksStatic(params);
   112→	}
   113→
   114→	const url = new URL(`${API_BASE}/api/tasks`);
   115→
   116→	if (params) {
   117→		Object.entries(params).forEach(([key, value]) => {
   118→			if (value !== undefined && value !== '') {
   119→				url.searchParams.set(key, String(value));
   120→			}
   121→		});
   122→	}
   123→
   124→	const response = await fetch(url.toString(), {
   125→		headers: getProjectHeaders()
   126→	});
   127→	if (!response.ok) {
   128→		await handleResponseError(response);
   129→	}
   130→
   131→	return response.json();
   132→}
   133→
   134→/**
   135→ * Fetch single task by reference
   136→ * AC: @web-dashboard ac-5
   137→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   138→ * AC: @gh-pages-export ac-12 - Static mode deep linking
   139→ */
   140→export async function fetchTask(ref: string): Promise<TaskDetail> {
   141→	// AC: @gh-pages-export ac-12 - Use static data in static mode
   142→	if (isStaticMode()) {
   143→		const task = fetchTaskStatic(ref);
   144→		if (!task) {
   145→			throw new Error(`Task not found: ${ref}`);
   146→		}
   147→		return task;
   148→	}
   149→
   150→	const response = await fetch(`${API_BASE}/api/tasks/${ref}`, {
   151→		headers: getProjectHeaders()
   152→	});
   153→	if (!response.ok) {
   154→		await handleResponseError(response);
   155→	}
   156→
   157→	return response.json();
   158→}
   159→
   160→/**
   161→ * Start a task (change status to in_progress)
   162→ * AC: @web-dashboard ac-7
   163→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   164→ * AC: @gh-pages-export ac-16, ac-18 - Disabled in static mode
   165→ */
   166→export async function startTask(ref: string): Promise<void> {
   167→	// AC: @gh-pages-export ac-16, ac-18 - Write operations throw in static mode
   168→	assertWritable('start task');
   169→
   170→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/start`, {
   171→		method: 'POST',
   172→		headers: getProjectHeaders()
   173→	});
   174→	if (!response.ok) {
   175→		await handleResponseError(response);
   176→	}
   177→}
   178→
   179→/**
   180→ * Add a note to a task
   181→ * AC: @web-dashboard ac-8
   182→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   183→ * AC: @gh-pages-export ac-18 - Disabled in static mode
   184→ */
   185→export async function addTaskNote(ref: string, content: string): Promise<void> {
   186→	// AC: @gh-pages-export ac-18 - Write operations throw in static mode
   187→	assertWritable('add note');
   188→
   189→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/note`, {
   190→		method: 'POST',
   191→		headers: {
   192→			'Content-Type': 'application/json',
   193→			...getProjectHeaders()
   194→		},
   195→		body: JSON.stringify({ content })
   196→	});
   197→	if (!response.ok) {
   198→		await handleResponseError(response);
   199→	}
   200→}
