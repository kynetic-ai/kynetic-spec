   992→
   993→export interface TraitCycleError {
   994→	traitRef: string;
   995→	traitTitle: string;
   996→	cycle: string[];
   997→	message: string;
   998→}
   999→
  1000→export interface ValidationResponse {
  1001→	valid: boolean;
  1002→	schemaErrors: SchemaValidationError[];
  1003→	refErrors: RefValidationError[];
  1004→	refWarnings: RefValidationWarning[];
  1005→	orphans: OrphanItem[];
  1006→	completenessWarnings: CompletenessWarning[];
  1007→	traitCycles: TraitCycleError[];
  1008→}
  1009→
  1010→/** Alias for backward compatibility with dashboard overview */
  1011→export type ValidationResult = ValidationResponse;
  1012→
  1013→export interface AlignmentWarning {
  1014→	type: 'orphaned_spec' | 'status_mismatch' | 'stale_implementation';
  1015→	specUlid?: string;
  1016→	specTitle?: string;
