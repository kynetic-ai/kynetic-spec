   263→/**
   264→ * Fetch spec items with optional filters
   265→ * AC: @web-dashboard ac-11
   266→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   267→ * AC: @gh-pages-export ac-11 - Static mode support
   268→ */
   269→export async function fetchItems(params?: {
   270→	type?: string | string[];
   271→	tag?: string;
   272→	plan?: string;
   273→	limit?: number;
   274→	offset?: number;
   275→}): Promise<PaginatedResponse<ItemSummary>> {
   276→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   277→	if (isStaticMode()) {
   278→		return fetchItemsStatic(params);
   279→	}
   280→
   281→	const url = new URL(`${API_BASE}/api/items`);
   282→
   283→	if (params) {
   284→		Object.entries(params).forEach(([key, value]) => {
   285→			if (value !== undefined && value !== '') {
   286→				if (Array.isArray(value)) {
   287→					value.forEach((v) => url.searchParams.append(key, String(v)));
   288→				} else {
   289→					url.searchParams.set(key, String(value));
   290→				}
   291→			}
   292→		});
   293→	}
   294→
   295→	const response = await fetch(url.toString(), {
   296→		headers: getProjectHeaders()
   297→	});
   298→	if (!response.ok) {
   299→		await handleResponseError(response);
   300→	}
   301→
   302→	return response.json();
   303→}
