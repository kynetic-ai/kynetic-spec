   907→diff --git a/src/cli/introspection.ts b/src/cli/introspection.ts
   908→new file mode 100644
   909→index 0000000..ad11e38
   910→--- /dev/null
   911→+++ b/src/cli/introspection.ts
   912→@@ -0,0 +1,203 @@
   913→+// AC: @auto-cli-docs ac-1
   914→+/**
   915→+ * Commander.js introspection - extracts command tree from program definition
   916→+ *
   917→+ * This module provides the foundation for auto-generated CLI documentation
   918→+ * by extracting command metadata directly from Commander.js definitions.
   919→+ */
   920→+
   921→+import { Command, Option as CommanderOption } from 'commander';
   922→+
   923→+/**
   924→+ * Metadata for a single command option
   925→+ */
   926→+export interface OptionMeta {
   927→+  /** Option flags (e.g., "-n, --name <value>") */
   928→+  flags: string;
   929→+  /** Option description */
   930→+  description: string;
   931→+  /** Whether option is required */
   932→+  required: boolean;
   933→+  /** Default value if any */
   934→+  defaultValue?: unknown;
   935→+  /** Whether option can be repeated */
   936→+  variadic: boolean;
   937→+}
   938→+
   939→+/**
   940→+ * Metadata for a command argument
   941→+ */
   942→+export interface ArgumentMeta {
   943→+  /** Argument name */
   944→+  name: string;
   945→+  /** Argument description */
   946→+  description: string;
   947→+  /** Whether argument is required */
   948→+  required: boolean;
   949→+  /** Whether argument can be repeated */
   950→+  variadic: boolean;
   951→+}
   952→+
   953→+/**
   954→+ * Complete metadata for a command
   955→+ */
   956→+export interface CommandMeta {
   957→+  /** Command name */
   958→+  name: string;
   959→+  /** Full command path from root (e.g., ["task", "add"]) */
   960→+  fullPath: string[];
   961→+  /** Command description */
   962→+  description: string;
   963→+  /** Command aliases */
   964→+  aliases: string[];
   965→+  /** Command arguments */
   966→+  arguments: ArgumentMeta[];
   967→+  /** Command options */
   968→+  options: OptionMeta[];
   969→+  /** Subcommands */
   970→+  subcommands: CommandMeta[];
   971→+  /** Whether this command is hidden */
   972→+  hidden: boolean;
   973→+}
   974→+
   975→+/**
   976→+ * Extract metadata for a single option
   977→+ */
   978→+function extractOptionMeta(option: CommanderOption): OptionMeta {
   979→+  return {
   980→+    flags: option.flags,
   981→+    description: option.description || '',
   982→+    required: option.required,
   983→+    defaultValue: option.defaultValue,
   984→+    variadic: option.variadic,
   985→+  };
   986→+}
   987→+
   988→+/**
   989→+ * Extract metadata for command arguments
   990→+ */
   991→+function extractArgumentsMeta(command: Command): ArgumentMeta[] {
   992→+  // Commander stores processed arguments with metadata
   993→+  const args = command.registeredArguments || [];
   994→+  return args.map((arg) => ({
   995→+    name: arg.name(),
   996→+    description: arg.description || '',
   997→+    required: arg.required,
   998→+    variadic: arg.variadic,
   999→+  }));
  1000→+}
  1001→+
  1002→+/**
  1003→+ * Extract complete command tree from a Commander program
  1004→+ *
  1005→+ * @param command - Commander command to introspect
  1006→+ * @param parentPath - Parent command path (for recursion)
  1007→+ * @returns Complete command metadata tree
  1008→+ */
  1009→+export function extractCommandTree(
  1010→+  command: Command,
  1011→+  parentPath: string[] = []
  1012→+): CommandMeta {
  1013→+  // Get command name - use first name if command has multiple
  1014→+  const commandName = command.name();
  1015→+  const fullPath = [...parentPath, commandName];
  1016→+
  1017→+  // Extract options (filter out help option if needed)
  1018→+  const options = command.options.map(extractOptionMeta);
  1019→+
  1020→+  // Extract arguments
  1021→+  const args = extractArgumentsMeta(command);
  1022→+
  1023→+  // Recursively extract subcommands
  1024→+  // Cast to any to access _hidden private property
  1025→+  const isHidden = (cmd: Command): boolean => (cmd as any)._hidden || false;
  1026→+
  1027→+  const subcommands = command.commands
  1028→+    .filter((cmd) => !isHidden(cmd)) // Filter hidden commands
  1029→+    .map((cmd) => extractCommandTree(cmd, fullPath));
  1030→+
  1031→+  return {
  1032→+    name: commandName,
  1033→+    fullPath,
  1034→+    description: command.description() || '',
  1035→+    aliases: command.aliases(),
  1036→+    arguments: args,
  1037→+    options,
  1038→+    subcommands,
  1039→+    hidden: isHidden(command),
  1040→+  };
  1041→+}
  1042→+
  1043→+/**
  1044→+ * Find a command in the tree by path
  1045→+ *
  1046→+ * @param tree - Command tree to search
  1047→+ * @param path - Command path (e.g., ["task", "add"])
  1048→+ * @returns Command metadata if found, null otherwise
  1049→+ */
  1050→+export function findCommand(tree: CommandMeta, path: string[]): CommandMeta | null {
  1051→+  if (path.length === 0) {
  1052→+    return tree;
  1053→+  }
  1054→+
  1055→+  // If we're at the right level
  1056→+  if (path.length === 1 && path[0] === tree.name) {
  1057→+    return tree;
  1058→+  }
  1059→+
  1060→+  // Search in subcommands
  1061→+  const [first, ...rest] = path;
  1062→+  const subcommand = tree.subcommands.find((cmd) => cmd.name === first);
  1063→+
  1064→+  if (!subcommand) {
  1065→+    return null;
  1066→+  }
  1067→+
  1068→+  if (rest.length === 0) {
  1069→+    return subcommand;
  1070→+  }
  1071→+
  1072→+  return findCommand(subcommand, rest);
  1073→+}
  1074→+
  1075→+/**
  1076→+ * Flatten command tree into a list of all commands
  1077→+ *
  1078→+ * @param tree - Command tree to flatten
  1079→+ * @returns Array of all commands in the tree
  1080→+ */
  1081→+export function flattenCommandTree(tree: CommandMeta): CommandMeta[] {
  1082→+  const result: CommandMeta[] = [tree];
  1083→+
  1084→+  for (const subcommand of tree.subcommands) {
  1085→+    result.push(...flattenCommandTree(subcommand));
  1086→+  }
  1087→+
  1088→+  return result;
  1089→+}
  1090→+
  1091→+/**
  1092→+ * Format command usage string
  1093→+ *
  1094→+ * @param command - Command metadata
  1095→+ * @returns Usage string (e.g., "kspec task add [options]")
  1096→+ */
  1097→+export function formatCommandUsage(command: CommandMeta): string {
  1098→+  const parts = ['kspec', ...command.fullPath.slice(1)]; // Skip root 'kspec'
  1099→+
  1100→+  // Add arguments
  1101→+  for (const arg of command.arguments) {
  1102→+    if (arg.required) {
  1103→+      parts.push(`<${arg.name}${arg.variadic ? '...' : ''}>`);
  1104→+    } else {
  1105→+      parts.push(`[${arg.name}${arg.variadic ? '...' : ''}]`);
  1106→+    }
  1107→+  }
  1108→+
  1109→+  // Add [options] if command has options
  1110→+  if (command.options.length > 0) {
  1111→+    parts.push('[options]');
  1112→+  }
  1113→+
  1114→+  return parts.join(' ');
  1115→+}
  1116→diff --git a/tests/help.test.ts b/tests/help.test.ts
  1117→new file mode 100644
  1118→index 0000000..fc7fd30
  1119→--- /dev/null
  1120→+++ b/tests/help.test.ts
  1121→@@ -0,0 +1,222 @@
  1122→+// AC: @auto-cli-docs ac-1, ac-2, ac-3, ac-4, ac-5
  1123→+import { describe, it, expect } from 'vitest';
  1124→+import { Command } from 'commander';
  1125→+import {
  1126→+  extractCommandTree,
  1127→+  findCommand,
  1128→+  flattenCommandTree,
  1129→+  formatCommandUsage,
  1130→+} from '../src/cli/introspection.js';
  1131→+
  1132→+describe('extractCommandTree', () => {
  1133→+  it('should extract basic command metadata', () => {
  1134→+    const program = new Command()
  1135→+      .name('test')
  1136→+      .description('Test program')
  1137→+      .version('1.0.0');
  1138→+
  1139→+    const tree = extractCommandTree(program);
  1140→+
  1141→+    expect(tree.name).toBe('test');
  1142→+    expect(tree.description).toBe('Test program');
  1143→+    expect(tree.fullPath).toEqual(['test']);
  1144→+    expect(tree.aliases).toEqual([]);
  1145→+    expect(tree.subcommands).toEqual([]);
  1146→+  });
  1147→+
  1148→+  it('should extract command with options', () => {
  1149→+    const program = new Command()
  1150→+      .name('test')
  1151→+      .option('-v, --verbose', 'Verbose output')
  1152→+      .option('-f, --force', 'Force operation', false);
  1153→+
  1154→+    const tree = extractCommandTree(program);
  1155→+
  1156→+    expect(tree.options).toHaveLength(2);
  1157→+    expect(tree.options[0].flags).toBe('-v, --verbose');
  1158→+    expect(tree.options[0].description).toBe('Verbose output');
  1159→+    expect(tree.options[1].flags).toBe('-f, --force');
  1160→+    expect(tree.options[1].description).toBe('Force operation');
  1161→+  });
  1162→+
  1163→+  it('should extract command with arguments', () => {
  1164→+    const program = new Command().name('test').argument('<file>', 'Input file');
  1165→+
  1166→+    const tree = extractCommandTree(program);
  1167→+
  1168→+    expect(tree.arguments).toHaveLength(1);
  1169→+    expect(tree.arguments[0].name).toBe('file');
  1170→+    expect(tree.arguments[0].description).toBe('Input file');
  1171→+    expect(tree.arguments[0].required).toBe(true);
  1172→+  });
  1173→+
  1174→+  it('should extract command with subcommands', () => {
  1175→+    const program = new Command().name('test');
  1176→+
  1177→+    program.command('add').description('Add something').option('-f, --force', 'Force');
  1178→+
  1179→+    program.command('list').description('List items');
  1180→+
  1181→+    const tree = extractCommandTree(program);
  1182→+
  1183→+    expect(tree.subcommands).toHaveLength(2);
