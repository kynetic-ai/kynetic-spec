   395→+function showCommandHelp(command: CommandMeta): void {
   396→+  const content = helpContent[command.name];
   397→+
   398→+  // Title: use content title, or command name
   399→+  const title = content?.title || `${command.name} - ${command.description}`;
   400→+  console.log(chalk.bold.cyan(title));
   401→+  console.log(chalk.gray('─'.repeat(40)));
   402→+
   403→+  // Usage
   404→+  console.log(chalk.bold('\nUsage:'));
   405→+  console.log(`  ${formatCommandUsage(command)}`);
   406→+
   407→+  // Subcommands (auto-generated from Commander)
   408→+  if (command.subcommands.length > 0) {
   409→+    console.log(chalk.bold('\nCommands:'));
   410→+    for (const sub of command.subcommands) {
   411→+      const nameCol = sub.name.padEnd(20);
   412→+      console.log(`  ${chalk.green(nameCol)} ${sub.description}`);
   413→+    }
   414→+  }
   415→+
   416→+  // Options (auto-generated from Commander)
   417→+  if (command.options.length > 0) {
   418→+    console.log(chalk.bold('\nOptions:'));
   419→+    for (const opt of command.options) {
   420→+      // Format flags column
   421→+      const flagsCol = opt.flags.padEnd(30);
   422→+      console.log(`  ${chalk.green(flagsCol)} ${opt.description}`);
   423→+    }
   424→   }
   425→ 
   426→-  console.log(chalk.bold.cyan(help.title));
   427→+  // Conceptual content (curated)
   428→+  if (content) {
   429→+    if (content.concept.trim()) {
   430→+      console.log(chalk.bold('\nDetails:'));
   431→+      console.log(content.concept.trim());
   432→+    }
   433→+
   434→+    if (content.examples && content.examples.length > 0) {
   435→+      console.log(chalk.bold('\nExamples:'));
   436→+      for (const example of content.examples) {
   437→+        console.log(chalk.green(`  ${example}`));
   438→+      }
   439→+    }
   440→+
   441→+    if (content.seeAlso && content.seeAlso.length > 0) {
   442→+      console.log(
   443→+        chalk.gray(`\nSee also: ${content.seeAlso.map((t) => `kspec help ${t}`).join(', ')}`)
   444→+      );
   445→+    }
   446→+  }
