   602→diff --git a/src/cli/help/content.ts b/src/cli/help/content.ts
   603→new file mode 100644
   604→index 0000000..4f9f9ce
   605→--- /dev/null
   606→+++ b/src/cli/help/content.ts
   607→@@ -0,0 +1,282 @@
   608→+/**
   609→+ * Curated help content for kspec commands and concepts
   610→+ *
   611→+ * This module contains conceptual documentation, examples, and cross-references
   612→+ * that complement the auto-generated command syntax from Commander introspection.
   613→+ *
   614→+ * What goes here:
   615→+ * - Conceptual explanations
   616→+ * - Usage examples
   617→+ * - Cross-references (seeAlso)
   618→+ * - Workflow guidance
   619→+ *
   620→+ * What doesn't go here:
   621→+ * - Command names (auto-generated)
   622→+ * - Option lists (auto-generated)
   623→+ * - Subcommand lists (auto-generated)
   624→+ */
   625→+
   626→+/**
   627→+ * Curated help content for a command or concept
   628→+ */
   629→+export interface HelpContent {
   630→+  /** Topic title (can be overridden, defaults to command description) */
   631→+  title?: string;
   632→+  /** Conceptual explanation (what, why, how) */
   633→+  concept: string;
   634→+  /** Usage examples */
   635→+  examples?: string[];
   636→+  /** Related topics */
   637→+  seeAlso?: string[];
   638→+}
   639→+
   640→+/**
   641→+ * All curated help content keyed by command path or concept name
   642→+ */
   643→+export const helpContent: Record<string, HelpContent> = {
   644→+  // Command-specific content
   645→+  task: {
   646→+    concept: `
   647→+Individual task operations for managing task lifecycle.
   648→+
   649→+Task References:
   650→+  Tasks can be referenced by slug (@task-slug) or ULID prefix (@01KEZ).
   651→+  The @ prefix is optional in commands.
   652→+
   653→+Notes vs Todos:
   654→+  - Notes: Append-only work log entries for tracking progress and findings
   655→+  - Todos: Lightweight checklist items that emerge during work
   656→+
   657→+Blocking vs Dependencies:
   658→+  - blocked_by: Manual blockers (strings like "waiting on design review")
   659→+  - depends_on: Task references that auto-resolve when completed
   660→+
   661→+  Use 'task block' for manual blockers. Dependencies are set in YAML.
   662→+`,
   663→+    examples: [
   664→+      'kspec task get @task-cli-help',
   665→+      'kspec task add --title "Fix login bug" --priority 1 --tag bug',
   666→+      'kspec task start @my-task',
   667→+      'kspec task note @my-task "Investigated root cause, found issue in auth module"',
   668→+      'kspec task complete @my-task --reason "Fixed by updating token validation"',
   669→+      'kspec task todo add @my-task "Review error handling"',
   670→+      'kspec task todo done @my-task 1',
   671→+      'kspec task todos @my-task',
   672→+    ],
   673→+    seeAlso: ['tasks', 'refs', 'statuses'],
   674→+  },
   675→+
   676→+  tasks: {
   677→+    concept: `
   678→+Query and list tasks with various filters.
   679→+
   680→+Output shows: ULID (short), slug, status, priority, and title.
   681→+`,
   682→+    examples: [
   683→+      'kspec tasks ready',
   684→+      'kspec tasks ready --priority 1',
   685→+      'kspec tasks active',
   686→+      'kspec tasks all --tag mvp',
   687→+      'kspec tasks completed --limit 5',
   688→+    ],
   689→+    seeAlso: ['task', 'statuses'],
   690→+  },
   691→+
   692→+  validate: {
   693→+    concept: `
   694→+Validate spec files for schema conformance and reference integrity.
   695→+
   696→+Default runs all checks. Exit code 1 if errors found.
   697→+
   698→+What it checks:
   699→+  - Schema: All items conform to Zod schemas
   700→+  - References: All @refs resolve to existing items
   701→+  - Orphans: Items not referenced by any task (warning)
   702→+
   703→+Alias: 'kspec lint' does the same thing.
   704→+`,
   705→+    examples: [
   706→+      'kspec validate',
   707→+      'kspec validate --refs',
   708→+      'kspec validate --strict',
   709→+      'kspec validate --json',
   710→+    ],
   711→+    seeAlso: ['refs'],
   712→+  },
   713→+
   714→+  session: {
   715→+    concept: `
   716→+Get context for a work session - what's active, ready, and recent.
   717→+
   718→+The session start command is designed for agents to quickly understand:
   719→+  - What work is currently in progress
   720→+  - What was recently completed
   721→+  - What tasks are ready to pick up
   722→+  - Recent git activity
   723→+  - Uncommitted changes
   724→+
   725→+Alias: 'kspec context' does the same thing.
   726→+`,
   727→+    examples: [
   728→+      'kspec session start',
   729→+      'kspec session start --full',
   730→+      'kspec session start --since 1d',
   731→+      'kspec context',
   732→+    ],
   733→+    seeAlso: ['tasks'],
   734→+  },
   735→+
   736→+  init: {
   737→+    concept: `
   738→+Initialize a new kspec project with scaffolding.
   739→+
   740→+Creates:
   741→+  - kynetic.yaml (manifest)
   742→+  - kynetic.tasks.yaml (task file)
   743→+  - spec/ directory with module files
   744→+
   745→+Run in an existing directory or specify a path.
   746→+`,
   747→+    examples: [
   748→+      'kspec init',
   749→+      'kspec init --name my-project',
   750→+      'kspec init ./new-project --yes',
   751→+    ],
   752→+  },
   753→+
   754→+  setup: {
   755→+    concept: `
   756→+Configure agent environment for kspec integration.
   757→+
   758→+Auto-detects:
   759→+  - Claude Code (CLAUDE.md)
   760→+  - Cursor (.cursor/rules)
   761→+  - Other agent environments
   762→+
   763→+Creates or updates agent configuration files with kspec instructions,
   764→+including quick-start commands and workflow guidance.
   765→+
   766→+Run this after 'kspec init' to set up agent integration.
   767→+`,
   768→+    examples: [
   769→+      'kspec setup',
   770→+      'kspec setup --agent claude-code',
   771→+      'kspec setup --dry-run',
   772→+    ],
   773→+    seeAlso: ['init', 'workflow'],
   774→+  },
   775→+
   776→+  item: {
   777→+    concept: `
   778→+CRUD operations on spec items (features, requirements, constraints).
   779→+
   780→+Spec items define WHAT to build. Tasks track the WORK of building.
   781→+Items are nested: modules contain features, features contain requirements.
   782→+`,
   783→+    examples: [
   784→+      'kspec item list --type feature',
   785→+      'kspec item get @ref-validation',
   786→+      'kspec item add --under @core --title "New Feature" --type feature',
   787→+      'kspec item add --under @spec-item --title "New Req" --type requirement',
   788→+      'kspec item set @my-feature --status implemented',
   789→+      'kspec item delete @old-feature',
   790→+    ],
   791→+    seeAlso: ['refs', 'task'],
   792→+  },
   793→+
   794→+  // Concept topics
   795→+  refs: {
   796→+    title: 'References (@refs)',
   797→+    concept: `
   798→+References link items together using @ prefix.
   799→+
   800→+Formats:
   801→+  @slug           Human-friendly name (e.g., @task-cli-help)
   802→+  @ULID           Full 26-char ULID (e.g., @01KEZJNSGPTVRCMT9NHNPJ93D8)
   803→+  @prefix         ULID prefix, must be unique (e.g., @01KEZ)
   804→+
   805→+Where refs are used:
   806→+  - spec_ref: Links task to spec item it implements
   807→+  - depends_on: Task dependencies (auto-resolve when target completes)
   808→+  - implements: Spec item implements another
   809→+  - context: Related items for reference
   810→+
   811→+Resolution order:
   812→+  1. Exact slug match
   813→+  2. Full ULID match
   814→+  3. ULID prefix match (must be unambiguous)
   815→+
   816→+Validate refs with: kspec validate --refs
   817→+`,
   818→+    examples: [
   819→+      'kspec task get @task-cli-help',
   820→+      'kspec task get @01KEZJNS',
   821→+      'kspec item get @ref-validation',
   822→+    ],
   823→+    seeAlso: ['validate', 'task'],
   824→+  },
   825→+
   826→+  statuses: {
   827→+    title: 'Task Statuses',
   828→+    concept: `
   829→+Task lifecycle states and transitions.
   830→+
   831→+States:
   832→+  pending      → Ready to start (or waiting on dependencies)
   833→+  in_progress  → Currently being worked on
   834→+  completed    → Done
   835→+  blocked      → Manually blocked (has blocked_by entries)
   836→+  cancelled    → Cancelled, won't be done
   837→+
   838→+Transitions:
   839→+  pending → in_progress     kspec task start
   840→+  in_progress → completed   kspec task complete
   841→+  in_progress → blocked     kspec task block
   842→+  blocked → pending         kspec task unblock
   843→+  any → cancelled           kspec task cancel
   844→+
   845→+Auto-blocking:
   846→+  Tasks with unfinished depends_on entries are effectively blocked
   847→+  but show as 'pending'. They become 'ready' when deps complete.
   848→+
   849→+The 'tasks ready' command shows pending tasks with no blockers
   850→+and no incomplete dependencies.
   851→+`,
   852→+    seeAlso: ['task', 'tasks'],
   853→+  },
   854→+
   855→+  workflow: {
   856→+    title: 'Typical Workflow',
   857→+    concept: `
   858→+Common workflow for working on tasks.
   859→+
   860→+Starting a session:
   861→+  1. kspec session start     # See what's active and ready
   862→+  2. Pick a task from ready list
   863→+
   864→+Working on a task:
   865→+  1. kspec task start @task  # Mark as in_progress
   866→+  2. kspec task note @task "Starting work on X..."
   867→+  3. Do the work (use todos for tracking sub-items)
   868→+  4. kspec task note @task "Completed X, approach was Y..."
   869→+  5. kspec task complete @task --reason "Summary"
   870→+
   871→+Using todos during work:
   872→+  kspec task todo add @task "Review error handling"
   873→+  kspec task todo add @task "Add tests"
   874→+  kspec task todo done @task 1
   875→+  kspec task todos @task
   876→+
   877→+Creating new tasks:
   878→+  kspec task add --title "Task name" --spec-ref @item --priority 2
   879→+
   880→+Blocking/unblocking:
   881→+  kspec task block @task --reason "Waiting on X"
   882→+  kspec task unblock @task
   883→+
   884→+Validating changes:
   885→+  kspec validate
   886→+`,
   887→+    seeAlso: ['session', 'task', 'tasks'],
   888→+  },
   889→+};
