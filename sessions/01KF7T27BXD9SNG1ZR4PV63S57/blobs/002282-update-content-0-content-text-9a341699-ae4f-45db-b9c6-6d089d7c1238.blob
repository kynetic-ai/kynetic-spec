   538→+/**
   539→+ * Show full reference (all commands with options)
   540→+ */
   541→+function showFullReference(): void {
   542→+  const tree = extractCommandTree(program);
   543→+  const allCommands = flattenCommandTree(tree).filter((cmd) => cmd.name !== 'kspec');
   544→+
   545→+  console.log(chalk.bold.cyan('kspec - Full Command Reference'));
   546→+  console.log(chalk.gray('─'.repeat(60)));
   547→+
   548→+  for (const cmd of allCommands) {
   549→+    console.log(chalk.bold(`\n${formatCommandUsage(cmd)}`));
   550→+    if (cmd.description) {
   551→+      console.log(`  ${cmd.description}`);
   552→+    }
   553→+
   554→+    if (cmd.options.length > 0) {
   555→+      console.log(chalk.gray('  Options:'));
   556→+      for (const opt of cmd.options) {
   557→+        console.log(chalk.gray(`    ${opt.flags.padEnd(30)} ${opt.description}`));
   558→+      }
   559→+    }
   560→+  }
   561→+}
