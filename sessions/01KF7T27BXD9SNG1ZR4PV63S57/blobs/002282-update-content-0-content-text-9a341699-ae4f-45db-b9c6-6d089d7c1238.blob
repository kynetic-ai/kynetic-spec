   478→+/**
   479→+ * Get all available topics (commands + concepts)
   480→+ */
   481→+function getAllTopics(tree: CommandMeta): string[] {
   482→+  const commands = flattenCommandTree(tree)
   483→+    .filter((cmd) => cmd.name !== 'kspec') // Skip root
   484→+    .map((cmd) => cmd.name);
   485→+
   486→+  const concepts = Object.keys(helpContent).filter((key) => !commands.includes(key));
   487→+
   488→+  return [...new Set([...commands, ...concepts])];
   489→+}
