   273→  describe('repairShadow', () => {
   274→    // Helper to set up a healthy shadow branch
   275→    async function setupHealthyShadow(): Promise<void> {
   276→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   277→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   278→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   279→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   280→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   281→      await initializeShadow(testDir);
   282→    }
   283→
   284→    // AC-recovery-1: Branch exists but .kspec/ deleted → repair recreates
   285→    it('recreates worktree when .kspec/ directory is deleted', async () => {
   286→      await setupHealthyShadow();
   287→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   288→
   289→      // Verify healthy before breaking
   290→      let status = await getShadowStatus(testDir);
   291→      expect(status.healthy).toBe(true);
   292→
   293→      // Break: delete the worktree directory
   294→      // First remove from git worktree list to avoid stale reference
   295→      execSync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, { cwd: testDir, stdio: 'pipe' });
   296→
   297→      // Verify broken
   298→      status = await getShadowStatus(testDir);
   299→      expect(status.healthy).toBe(false);
   300→      expect(status.branchExists).toBe(true);
   301→      expect(status.worktreeExists).toBe(false);
   302→
   303→      // Repair
   304→      const result = await repairShadow(testDir);
   305→      expect(result.success).toBe(true);
   306→      expect(result.worktreeCreated).toBe(true);
   307→
   308→      // Verify healthy again
   309→      status = await getShadowStatus(testDir);
   310→      expect(status.healthy).toBe(true);
   311→      expect(await isValidWorktree(worktreeDir)).toBe(true);
   312→    });
   313→
   314→    // AC-recovery-2: .kspec/ exists but .git file corrupt → repair recreates
   315→    it('recreates worktree when .git file is corrupted', async () => {
   316→      await setupHealthyShadow();
   317→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   318→      const gitFile = path.join(worktreeDir, '.git');
   319→
   320→      // Verify healthy before breaking
   321→      let status = await getShadowStatus(testDir);
   322→      expect(status.healthy).toBe(true);
   323→
   324→      // Break: corrupt the .git file
   325→      await fs.writeFile(gitFile, 'corrupted content');
   326→
   327→      // Verify broken
   328→      status = await getShadowStatus(testDir);
   329→      expect(status.healthy).toBe(false);
   330→      expect(status.worktreeExists).toBe(true);
   331→      expect(status.worktreeLinked).toBe(false);
   332→
   333→      // Repair
   334→      const result = await repairShadow(testDir);
   335→      expect(result.success).toBe(true);
   336→      expect(result.worktreeCreated).toBe(true);
   337→
   338→      // Verify healthy again
   339→      status = await getShadowStatus(testDir);
   340→      expect(status.healthy).toBe(true);
   341→    });
   342→
   343→    // AC-recovery-3: No shadow branch → repair fails suggesting init
   344→    it('fails with helpful error when shadow branch does not exist', async () => {
   345→      // Just a git repo without shadow branch
   346→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   347→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   348→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   349→
   350→      const result = await repairShadow(testDir);
   351→      expect(result.success).toBe(false);
   352→      expect(result.error).toContain('kspec init');
   353→    });
   354→
   355→    // AC-recovery-4: Healthy → repair succeeds without changes (idempotent)
   356→    it('succeeds without changes when already healthy', async () => {
   357→      await setupHealthyShadow();
   358→
   359→      const result = await repairShadow(testDir);
   360→      expect(result.success).toBe(true);
   361→      expect(result.alreadyExists).toBe(true);
   362→      expect(result.worktreeCreated).toBe(false);
   363→    });
   364→
   365→    // AC-recovery-5: Healthy → status reports healthy
   366→    it('status reports healthy when shadow is working', async () => {
   367→      await setupHealthyShadow();
   368→
   369→      const status = await getShadowStatus(testDir);
   370→      expect(status.healthy).toBe(true);
   371→      expect(status.branchExists).toBe(true);
   372→      expect(status.worktreeExists).toBe(true);
   373→      expect(status.worktreeLinked).toBe(true);
   374→      expect(status.error).toBeUndefined();
   375→    });
   376→
   377→    // AC-recovery-6: Issues → status reports issue and suggests repair
   378→    it('status reports specific issue when worktree is broken', async () => {
   379→      await setupHealthyShadow();
   380→
   381→      // Break: remove worktree
   382→      execSync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, { cwd: testDir, stdio: 'pipe' });
   383→
   384→      const status = await getShadowStatus(testDir);
   385→      expect(status.healthy).toBe(false);
   386→      expect(status.branchExists).toBe(true);
   387→      expect(status.worktreeExists).toBe(false);
   388→      expect(status.error).toContain('worktree missing');
   389→    });
   390→  });
