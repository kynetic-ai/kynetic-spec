   610→    }
   611→
   612→    // AC-4: No remote tracking → sync silently skipped
   613→    it('hasRemoteTracking returns false when no tracking configured', async () => {
   614→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   615→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   616→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
