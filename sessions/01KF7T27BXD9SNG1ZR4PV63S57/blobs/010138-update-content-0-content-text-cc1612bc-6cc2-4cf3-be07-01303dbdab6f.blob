   131→  describe('ShadowError', () => {
   132→    it('creates error with code and suggestion', () => {
   133→      const err = new ShadowError(
   134→        'Test message',
   135→        'NOT_INITIALIZED',
   136→        'Run kspec init'
   137→      );
   138→      expect(err.message).toBe('Test message');
   139→      expect(err.code).toBe('NOT_INITIALIZED');
   140→      expect(err.suggestion).toBe('Run kspec init');
