   392→  // AC: @shadow-init-remote - Remote detection tests
   393→  describe('initializeShadow with remote', () => {
   394→    // Create a bare repo to act as a "remote"
   395→    const remoteDir = path.join('/tmp', `kspec-remote-test-${Date.now()}`);
   396→
   397→    beforeEach(async () => {
   398→      // Clean up remote directory
   399→      try {
   400→        await fs.rm(remoteDir, { recursive: true });
   401→      } catch {
   402→        // Doesn't exist
   403→      }
   404→    });
   405→
   406→    afterEach(async () => {
   407→      try {
   408→        await fs.rm(remoteDir, { recursive: true });
   409→      } catch {
   410→        // Best effort cleanup
   411→      }
   412→    });
   413→
   414→    // Helper to set up a bare repo as remote
   415→    async function setupBareRemote(): Promise<void> {
   416→      await fs.mkdir(remoteDir, { recursive: true });
   417→      execSync('git init --bare', { cwd: remoteDir, stdio: 'pipe' });
   418→    }
   419→
   420→    // Helper to set up a local repo with remote
   421→    async function setupLocalWithRemote(): Promise<void> {
   422→      execSync('git init -b main', { cwd: testDir, stdio: 'pipe' });
   423→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   424→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   425→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   426→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   427→      execSync(`git remote add origin ${remoteDir}`, { cwd: testDir, stdio: 'pipe' });
   428→      execSync('git push -u origin main', { cwd: testDir, stdio: 'pipe' });
   429→    }
   430→
   431→    // Helper to push shadow branch to remote
   432→    async function pushShadowToRemote(): Promise<void> {
   433→      execSync(`git -C ${testDir}/.kspec push -u origin ${SHADOW_BRANCH_NAME}`, { stdio: 'pipe' });
   434→    }
   435→
   436→    it('hasRemote returns false when no remote configured', async () => {
   437→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   438→      expect(await hasRemote(testDir)).toBe(false);
   439→    });
   440→
   441→    it('hasRemote returns true when origin exists', async () => {
   442→      await setupBareRemote();
   443→      await setupLocalWithRemote();
   444→      expect(await hasRemote(testDir)).toBe(true);
   445→    });
   446→
   447→    it('remoteBranchExists returns false when branch not on remote', async () => {
   448→      await setupBareRemote();
   449→      await setupLocalWithRemote();
   450→      expect(await remoteBranchExists(testDir, SHADOW_BRANCH_NAME)).toBe(false);
   451→    });
   452→
   453→    it('remoteBranchExists returns true after pushing shadow branch', async () => {
   454→      await setupBareRemote();
   455→      await setupLocalWithRemote();
   456→
   457→      // Initialize shadow locally
   458→      await initializeShadow(testDir);
   459→
   460→      // Push to remote
   461→      await pushShadowToRemote();
   462→
   463→      // Now check - need to fetch first
   464→      await fetchRemote(testDir);
   465→      expect(await remoteBranchExists(testDir, SHADOW_BRANCH_NAME)).toBe(true);
   466→    });
   467→
   468→    // AC-1: Remote has shadow branch → creates worktree from it with tracking
   469→    it('attaches to existing remote shadow branch', async () => {
   470→      await setupBareRemote();
   471→      await setupLocalWithRemote();
   472→
   473→      // Initialize shadow in first repo and push
   474→      const result1 = await initializeShadow(testDir);
   475→      expect(result1.success).toBe(true);
   476→      expect(result1.branchCreated).toBe(true);
   477→
   478→      // Push shadow to remote
   479→      await pushShadowToRemote();
   480→
   481→      // Create a "clone" (new repo pointing to same remote)
   482→      const cloneDir = path.join('/tmp', `kspec-clone-test-${Date.now()}`);
   483→      try {
   484→        execSync(`git clone ${remoteDir} ${cloneDir}`, { stdio: 'pipe' });
   485→        execSync('git config user.email "test@test.com"', { cwd: cloneDir, stdio: 'pipe' });
   486→        execSync('git config user.name "Test"', { cwd: cloneDir, stdio: 'pipe' });
   487→
   488→        // Initialize shadow in clone - should attach to remote branch
   489→        const result2 = await initializeShadow(cloneDir);
   490→        expect(result2.success).toBe(true);
   491→        expect(result2.createdFromRemote).toBe(true);
   492→        expect(result2.branchCreated).toBe(false);
   493→        expect(result2.worktreeCreated).toBe(true);
   494→
   495→        // Verify worktree is healthy
   496→        const status = await getShadowStatus(cloneDir);
   497→        expect(status.healthy).toBe(true);
   498→
   499→        // Verify tracking is set up
   500→        const tracking = execSync(`git -C ${cloneDir} config branch.${SHADOW_BRANCH_NAME}.remote`, {
   501→          encoding: 'utf-8',
   502→          stdio: ['pipe', 'pipe', 'pipe'],
   503→        }).trim();
   504→        expect(tracking).toBe('origin');
   505→      } finally {
   506→        await fs.rm(cloneDir, { recursive: true, force: true });
   507→      }
   508→    });
   509→
   510→    // AC-2: Remote exists but no shadow branch → creates orphan and pushes
   511→    it('creates orphan branch and pushes to remote', async () => {
   512→      await setupBareRemote();
   513→      await setupLocalWithRemote();
   514→
   515→      // Verify no shadow branch on remote yet
   516→      expect(await remoteBranchExists(testDir, SHADOW_BRANCH_NAME)).toBe(false);
   517→
   518→      // Initialize shadow - should create and push
   519→      const result = await initializeShadow(testDir);
   520→      expect(result.success).toBe(true);
   521→      expect(result.branchCreated).toBe(true);
   522→      expect(result.pushedToRemote).toBe(true);
   523→
   524→      // Verify shadow branch now exists on remote
   525→      await fetchRemote(testDir);
   526→      expect(await remoteBranchExists(testDir, SHADOW_BRANCH_NAME)).toBe(true);
   527→    });
   528→
   529→    // AC-3: No remote configured → creates orphan locally (no push attempt)
   530→    it('creates orphan locally when no remote configured', async () => {
   531→      // Just a local git repo, no remote
   532→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   533→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   534→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   535→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   536→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   537→
   538→      const result = await initializeShadow(testDir);
   539→      expect(result.success).toBe(true);
   540→      expect(result.branchCreated).toBe(true);
   541→      expect(result.pushedToRemote).toBe(false);
   542→      expect(result.createdFromRemote).toBe(false);
   543→    });
   544→
   545→    // AC-4: Fetches before checking for remote branch
   546→    it('fetches before checking remote branch existence', async () => {
   547→      await setupBareRemote();
   548→      await setupLocalWithRemote();
   549→
   550→      // Initialize in first repo, push shadow
   551→      await initializeShadow(testDir);
   552→      await pushShadowToRemote();
   553→
   554→      // Create clone
   555→      const cloneDir = path.join('/tmp', `kspec-clone-test-${Date.now()}`);
   556→      try {
   557→        execSync(`git clone ${remoteDir} ${cloneDir}`, { stdio: 'pipe' });
   558→        execSync('git config user.email "test@test.com"', { cwd: cloneDir, stdio: 'pipe' });
   559→        execSync('git config user.name "Test"', { cwd: cloneDir, stdio: 'pipe' });
   560→
   561→        // Clone won't have the remote refs yet until we fetch
   562→        // The init should fetch automatically
   563→        const result = await initializeShadow(cloneDir);
   564→
   565→        // Should have detected and attached to remote (proves fetch happened)
   566→        expect(result.success).toBe(true);
   567→        expect(result.createdFromRemote).toBe(true);
   568→      } finally {
   569→        await fs.rm(cloneDir, { recursive: true, force: true });
   570→      }
   571→    });
   572→  });
