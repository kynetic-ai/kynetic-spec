    91→      expect(msg).toBe('Start @my-task');
    92→    });
    93→
    94→    it('generates task-complete message with reason', () => {
    95→      const msg = generateCommitMessage('task-complete', 'my-task', 'Done with implementation');
    96→      expect(msg).toBe('Complete @my-task: Done with implementation');
    97→    });
    98→
    99→    it('generates task-note message', () => {
