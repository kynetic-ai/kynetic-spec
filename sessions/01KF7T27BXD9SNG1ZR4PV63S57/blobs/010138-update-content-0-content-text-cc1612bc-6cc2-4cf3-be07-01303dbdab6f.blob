   601→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   602→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   603→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   604→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   605→      execSync(`git remote add origin ${remoteDir}`, { cwd: testDir, stdio: 'pipe' });
   606→      execSync('git push -u origin main', { cwd: testDir, stdio: 'pipe' });
