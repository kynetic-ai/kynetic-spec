   687→        expect(result.hadConflict).toBe(false);
   688→
   689→        // Verify the change was pulled
   690→        const content = await fs.readFile(path.join(worktreeDir, tasksFile!), 'utf-8');
   691→        expect(content).toContain('# Remote change');
   692→      } finally {
   693→        await fs.rm(cloneDir, { recursive: true, force: true });
   694→      }
   695→    });
   696→
   697→    // shadowSync does pull then push
   698→    it('shadowSync pulls and pushes', async () => {
   699→      await setupSyncTest();
