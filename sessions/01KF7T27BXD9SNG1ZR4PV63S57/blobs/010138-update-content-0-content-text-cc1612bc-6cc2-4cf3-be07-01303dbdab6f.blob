   217→
   218→  describe('initializeShadow', () => {
   219→    it('creates shadow branch and worktree in git repo', async () => {
   220→      // Initialize git repo with an initial commit
   221→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   222→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   223→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   224→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   225→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   226→
   227→      const result = await initializeShadow(testDir, { projectName: 'Test Project' });
   228→
   229→      expect(result.success).toBe(true);
   230→      expect(result.branchCreated).toBe(true);
   231→      expect(result.worktreeCreated).toBe(true);
   232→      expect(result.gitignoreUpdated).toBe(true);
   233→
   234→      // Verify branch exists
   235→      expect(await branchExists(testDir, SHADOW_BRANCH_NAME)).toBe(true);
   236→
   237→      // Verify worktree exists and is valid
   238→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   239→      expect(await isValidWorktree(worktreeDir)).toBe(true);
   240→
   241→      // Verify status is healthy
   242→      const status = await getShadowStatus(testDir);
   243→      expect(status.healthy).toBe(true);
   244→    });
   245→
   246→    it('is idempotent - succeeds if already initialized', async () => {
   247→      // Initialize git repo
   248→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   249→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   250→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   251→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   252→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   253→
   254→      // First init
   255→      const result1 = await initializeShadow(testDir);
   256→      expect(result1.success).toBe(true);
   257→      expect(result1.branchCreated).toBe(true);
   258→
   259→      // Second init - should succeed without creating branch again
   260→      const result2 = await initializeShadow(testDir);
   261→      expect(result2.success).toBe(true);
   262→      expect(result2.alreadyExists).toBe(true);
   263→      expect(result2.branchCreated).toBe(false);
   264→    });
   265→
   266→    it('fails if not a git repo', async () => {
   267→      const result = await initializeShadow(testDir);
   268→      expect(result.success).toBe(false);
   269→      expect(result.error).toBe('Not a git repository');
   270→    });
   271→  });
