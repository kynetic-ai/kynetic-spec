   660→        execSync('git config user.name "Test"', { cwd: cloneDir, stdio: 'pipe' });
   661→        execSync(`git worktree add .kspec ${SHADOW_BRANCH_NAME}`, { cwd: cloneDir, stdio: 'pipe' });
   662→
   663→        // Modify a file in the clone's shadow
   664→        const tasksFile = (await fs.readdir(path.join(cloneDir, '.kspec')))
   665→          .find(f => f.endsWith('.tasks.yaml'));
   666→        if (tasksFile) {
   667→          await fs.appendFile(
   668→            path.join(cloneDir, '.kspec', tasksFile),
   669→            '\n# Remote change\n'
   670→          );
   671→          execSync('git add -A && git commit -m "Remote change"', {
   672→            cwd: path.join(cloneDir, '.kspec'),
   673→            stdio: 'pipe',
   674→          });
   675→          execSync(`git push origin ${SHADOW_BRANCH_NAME}`, {
   676→            cwd: path.join(cloneDir, '.kspec'),
   677→            stdio: 'pipe',
   678→          });
   679→        }
   680→
   681→        // Now pull in original repo
