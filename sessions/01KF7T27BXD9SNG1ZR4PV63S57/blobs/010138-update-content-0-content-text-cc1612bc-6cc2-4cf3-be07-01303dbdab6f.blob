   650→
   651→    // AC-6: shadowPull uses --ff-only first, falls back to --rebase
   652→    it('shadowPull pulls changes from remote', async () => {
   653→      await setupSyncTest();
   654→
   655→      // Make a change on remote by cloning, modifying, and pushing
   656→      const cloneDir = path.join('/tmp', `kspec-sync-clone-${Date.now()}`);
   657→      try {
   658→        execSync(`git clone ${remoteDir} ${cloneDir}`, { stdio: 'pipe' });
