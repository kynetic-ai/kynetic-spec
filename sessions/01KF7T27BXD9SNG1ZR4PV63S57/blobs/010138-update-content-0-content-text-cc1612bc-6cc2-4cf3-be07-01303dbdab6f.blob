    28→describe('Shadow Branch', () => {
    29→  // Use /tmp to ensure we're outside any git repo for proper isolation
    30→  const testDir = path.join('/tmp', `kspec-shadow-test-${Date.now()}`);
    31→
    32→  beforeEach(async () => {
    33→    // Clean up any previous test directory
    34→    try {
    35→      await fs.rm(testDir, { recursive: true });
    36→    } catch {
    37→      // Doesn't exist, that's fine
    38→    }
    39→    await fs.mkdir(testDir, { recursive: true });
    40→  });
    41→
    42→  afterEach(async () => {
    43→    try {
    44→      await fs.rm(testDir, { recursive: true });
    45→    } catch {
    46→      // Best effort cleanup
    47→    }
    48→  });
    49→
    50→  describe('detectShadow', () => {
    51→    it('returns null for non-git directory', async () => {
    52→      const result = await detectShadow(testDir);
    53→      expect(result).toBeNull();
    54→    });
    55→
    56→    it('returns null for git repo without .kspec', async () => {
    57→      // Initialize a git repo
    58→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
    59→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
    60→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
    61→
    62→      const result = await detectShadow(testDir);
    63→      expect(result).toBeNull();
    64→    });
    65→  });
    66→
    67→  describe('getShadowStatus', () => {
    68→    it('reports not a git repo', async () => {
    69→      const status = await getShadowStatus(testDir);
    70→      expect(status.exists).toBe(false);
    71→      expect(status.healthy).toBe(false);
    72→      expect(status.error).toBe('Not a git repository');
    73→    });
    74→
    75→    it('reports no shadow branch for fresh git repo', async () => {
    76→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
    77→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
    78→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
    79→
    80→      const status = await getShadowStatus(testDir);
    81→      expect(status.exists).toBe(false);
    82→      expect(status.healthy).toBe(false);
    83→      expect(status.branchExists).toBe(false);
    84→      expect(status.worktreeExists).toBe(false);
    85→    });
    86→  });
