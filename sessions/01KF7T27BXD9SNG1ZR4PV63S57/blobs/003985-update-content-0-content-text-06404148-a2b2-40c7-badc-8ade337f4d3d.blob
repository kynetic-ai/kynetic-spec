   931→        slugs:
   932→          - cmd-log
   933→        title: kspec log
   934→        type: requirement
   935→        tags: []
   936→        description: >-
   937→          kspec log [ref]
   938→
   939→
   940→          Search git history for commits referencing spec items or tasks. Wraps git log --grep to
   941→          search for trailer patterns (Task: @ref, Spec: @ref).
   942→
   943→
   944→          Options:
   945→
   946→          - <ref>: Task or spec reference to search for
   947→
   948→          - --spec <ref>: Search for Spec: trailer specifically
   949→
   950→          - --task <ref>: Search for Task: trailer specifically
   951→
   952→          - -n, --limit <n>: Limit results (default: 10)
   953→
   954→          - --oneline: Compact output format
   955→
   956→          - --since <time>: Only commits after date
   957→
   958→
   959→          Examples:
   960→
   961→          - kspec log @my-task        # Commits for task
   962→
   963→          - kspec log --spec @auth    # Commits for spec item
   964→
   965→          - kspec log @task --oneline # Compact format
   966→        depends_on: []
   967→        implements: []
   968→        relates_to: []
   969→        tests: []
   970→        created: '2026-01-16T18:41:48.245Z'
   971→        acceptance_criteria:
   972→          - id: ac-1
   973→            given: 'commits exist with Task: @my-task trailer'
   974→            when: kspec log @my-task runs
   975→            then: matching commits are displayed
   976→          - id: ac-2
   977→            given: reference is a spec item
   978→            when: kspec log @spec-item runs
   979→            then: 'searches for both Spec: trailer and Task: trailers of linked tasks'
   980→          - id: ac-3
   981→            given: no matching commits exist
   982→            when: kspec log @ref runs
   983→            then: displays 'No commits found' message
   984→          - id: ac-4
   985→            given: '--oneline flag provided'
   986→            when: kspec log @ref --oneline runs
   987→            then: shows compact hash + subject format
   988→          - id: ac-5
   989→            given: reference doesn't exist
   990→            when: kspec log @invalid runs
   991→            then: shows error 'Reference not found' with exit code 3
   992→        status:
   993→          maturity: draft
   994→          implementation: implemented
