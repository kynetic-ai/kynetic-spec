   238→        acceptance_criteria:
   239→          - id: ac-1
   240→            given: item @my-item exists with slugs ['original']
   241→            when: kspec item set @my-item --slug new-slug runs
   242→            then: item now has slugs ['original', 'new-slug']
   243→          - id: ac-2
   244→            given: item @my-item exists with slugs ['keep', 'remove']
   245→            when: kspec item set @my-item --remove-slug remove runs
   246→            then: item now has slugs ['keep']
   247→          - id: ac-3
   248→            given: item @my-item has only one slug 'only-one'
   249→            when: kspec item set @my-item --remove-slug only-one runs
   250→            then: 'error: cannot remove last slug'
   251→          - id: ac-4
   252→            given: item @my-item exists
   253→            when: kspec item set @my-item --status implemented runs
   254→            then: item's implementation status is updated to 'implemented'
