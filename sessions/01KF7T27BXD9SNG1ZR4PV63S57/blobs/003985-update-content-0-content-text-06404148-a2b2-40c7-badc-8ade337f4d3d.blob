  1896→    title: ACP Protocol Client
  1897→    type: feature
  1898→    tags: []
  1899→    description: >-
  1900→      JSON-RPC 2.0 based client for Agent Client Protocol communication. Handles bidirectional stdio
  1901→      communication with ACP-compliant agents, request/response correlation, session lifecycle, and
  1902→      event streaming.
  1903→    depends_on: []
  1904→    implements: []
  1905→    relates_to: []
  1906→    tests: []
  1907→    created: '2026-01-17T15:15:27.389Z'
  1908→    acceptance_criteria:
  1909→      - id: ac-1
  1910→        given: an ACP agent process
  1911→        when: client.initialize() is called
  1912→        then: returns agent capabilities including supported features
  1913→      - id: ac-2
  1914→        given: an initialized client
  1915→        when: client.newSession({ cwd, _meta }) is called
  1916→        then: creates a new session and returns sessionId
  1917→      - id: ac-3
  1918→        given: an active session
  1919→        when: client.prompt({ sessionId, prompt }) is called
  1920→        then: sends prompt and returns PromptResponse with stopReason
  1921→      - id: ac-4
  1922→        given: streaming updates from agent
  1923→        when: update events arrive
  1924→        then: client emits 'update' events with sessionId and update data
  1925→      - id: ac-5
  1926→        given: a pending request
  1927→        when: no response within timeout (default 30s, 5min for prompt)
  1928→        then: request rejects with timeout error
  1929→      - id: ac-6
  1930→        given: incoming agent activity (requests/notifications)
  1931→        when: activity is detected
  1932→        then: timeout timers reset (keepalive mechanism)
  1933→      - id: ac-7
  1934→        given: an active session
  1935→        when: client.cancel(sessionId) is called
  1936→        then: sends cancel request (optional method with graceful fallback)
  1937→      - id: ac-8
  1938→        given: client is closed
  1939→        when: any method is called
  1940→        then: throws 'client closed' error
  1941→      - id: ac-9
  1942→        given: malformed JSON from agent
  1943→        when: message is parsed
  1944→        then: sends JSON-RPC parse error response
  1945→    status:
  1946→      maturity: draft
  1947→      implementation: implemented
