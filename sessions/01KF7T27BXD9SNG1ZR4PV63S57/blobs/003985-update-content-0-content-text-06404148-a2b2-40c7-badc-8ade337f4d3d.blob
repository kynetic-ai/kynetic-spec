   274→        slugs:
   275→          - item-ac
   276→        title: kspec item ac
   277→        type: requirement
   278→        tags: []
   279→        description: |-
   280→          kspec item ac <subcommand>
   281→
   282→          Subcommands:
   283→          - add <ref> --given '...' --when '...' --then '...': Add acceptance criterion
   284→          - list <ref>: List acceptance criteria for an item
   285→          - set <ref> <ac-id> [options]: Update an acceptance criterion
   286→          - remove <ref> <ac-id> [--force]: Remove an acceptance criterion
   287→
   288→          Manages acceptance criteria on spec items via CLI.
   289→          Handles proper YAML escaping to prevent formatting errors.
   290→        depends_on: []
   291→        implements: []
   292→        relates_to: []
   293→        tests: []
   294→        acceptance_criteria:
   295→          - id: ac-item-ac-add
   296→            given: a spec item exists
   297→            when: kspec item ac add @ref --given "precondition" --when "action" --then "outcome" runs
   298→            then: >-
   299→              AC is added with auto-generated ID; outputs "OK Added acceptance criterion: ac-N to
   300→              @ref"
   301→          - id: ac-item-ac-add-id
   302→            given: a spec item exists
   303→            when: kspec item ac add @ref --id custom-id --given "..." --when "..." --then "..." runs
   304→            then: AC is added with the specified ID
   305→          - id: ac-item-ac-add-dup
   306→            given: a spec item with AC id "ac-1" exists
   307→            when: kspec item ac add @ref --id ac-1 --given "..." --when "..." --then "..." runs
   308→            then: exits code 3; error "Acceptance criterion ac-1 already exists"
   309→          - id: ac-item-ac-add-task
   310→            given: a task exists (not a spec item)
   311→            when: kspec item ac add @task-ref --given "..." --when "..." --then "..." runs
   312→            then: exits code 3; error "Tasks don't have acceptance criteria"
   313→          - id: ac-item-ac-list
   314→            given: a spec item with acceptance criteria
   315→            when: kspec item ac list @ref runs
   316→            then: displays all AC in Given/When/Then format with IDs
   317→          - id: ac-item-ac-list-empty
   318→            given: a spec item without acceptance criteria
   319→            when: kspec item ac list @ref runs
   320→            then: displays "No acceptance criteria"
   321→          - id: ac-item-ac-set
   322→            given: a spec item with AC id "ac-1"
   323→            when: kspec item ac set @ref ac-1 --then "new outcome" runs
   324→            then: >-
   325→              AC then field is updated; outputs "OK Updated acceptance criterion: ac-1 on @ref
   326→              (then)"
   327→          - id: ac-item-ac-set-notfound
   328→            given: a spec item without AC id "ac-99"
   329→            when: kspec item ac set @ref ac-99 --then "..." runs
   330→            then: exits code 3; error "Acceptance criterion ac-99 not found"
   331→          - id: ac-item-ac-remove
   332→            given: a spec item with AC id "ac-1"
   333→            when: kspec item ac remove @ref ac-1 --force runs
   334→            then: 'AC is removed; outputs "OK Removed acceptance criterion: ac-1 from @ref"'
   335→          - id: ac-item-ac-remove-confirm
   336→            given: a spec item with AC id "ac-1"
   337→            when: kspec item ac remove @ref ac-1 runs (no --force)
   338→            then: prompts for confirmation before removing
