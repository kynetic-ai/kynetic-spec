    36→/**
    37→ * Spec item with runtime metadata for source tracking.
    38→ * _sourceFile is not serialized - it's used to know where to write updates.
    39→ * _path tracks location within the file for nested items (e.g., "features[0].requirements[2]")
    40→ */
    41→export interface LoadedSpecItem extends SpecItem {
    42→  _sourceFile?: string;
    43→  _path?: string;
    44→}
    45→
    46→/**
    47→ * Task with runtime metadata for source tracking.
    48→ * _sourceFile is not serialized - it's used to know where to write updates.
    49→ */
    50→export interface LoadedTask extends Task {
    51→  _sourceFile?: string;
    52→}
    53→
    54→/**
    55→ * Parse YAML content into an object
    56→ */
    57→export function parseYaml<T>(content: string): T {
    58→  return yaml.load(content) as T;
    59→}
    60→
    61→/**
    62→ * Serialize object to YAML
    63→ */
    64→export function toYaml(obj: unknown): string {
    65→  return yaml.dump(obj, {
    66→    indent: 2,
    67→    lineWidth: 100,
    68→    noRefs: true,
    69→    sortKeys: false,
    70→  });
    71→}
    72→
    73→/**
    74→ * Read and parse a YAML file
    75→ */
    76→export async function readYamlFile<T>(filePath: string): Promise<T> {
    77→  const content = await fs.readFile(filePath, 'utf-8');
    78→  return parseYaml<T>(content);
    79→}
    80→
    81→/**
    82→ * Write object to YAML file
    83→ */
    84→export async function writeYamlFile(filePath: string, data: unknown): Promise<void> {
    85→  const content = toYaml(data);
    86→  await fs.writeFile(filePath, content, 'utf-8');
    87→}
    88→
    89→/**
    90→ * Find task files in a directory
    91→ */
    92→export async function findTaskFiles(dir: string): Promise<string[]> {
    93→  const files: string[] = [];
    94→
    95→  try {
    96→    const entries = await fs.readdir(dir, { withFileTypes: true });
    97→
    98→    for (const entry of entries) {
    99→      const fullPath = path.join(dir, entry.name);
   100→
   101→      if (entry.isDirectory()) {
   102→        // Recurse into subdirectories
   103→        const subFiles = await findTaskFiles(fullPath);
   104→        files.push(...subFiles);
   105→      } else if (entry.isFile() && entry.name.endsWith('.tasks.yaml')) {
   106→        files.push(fullPath);
   107→      }
   108→    }
   109→  } catch (error) {
   110→    // Directory doesn't exist or not readable
   111→  }
   112→
   113→  return files;
   114→}
   115→
   116→/**
   117→ * Find the manifest file (kynetic.yaml or kynetic.spec.yaml)
   118→ */
   119→export async function findManifest(startDir: string): Promise<string | null> {
   120→  let dir = startDir;
   121→
   122→  while (true) {
   123→    const candidates = ['kynetic.yaml', 'kynetic.spec.yaml'];
   124→
   125→    for (const candidate of candidates) {
   126→      const filePath = path.join(dir, candidate);
   127→      try {
   128→        await fs.access(filePath);
   129→        return filePath;
   130→      } catch {
   131→        // File doesn't exist, try next
   132→      }
   133→    }
   134→
   135→    // Also check in spec/ subdirectory
   136→    const specDir = path.join(dir, 'spec');
   137→    for (const candidate of candidates) {
   138→      const filePath = path.join(specDir, candidate);
   139→      try {
   140→        await fs.access(filePath);
   141→        return filePath;
   142→      } catch {
   143→        // File doesn't exist, try next
   144→      }
   145→    }
   146→
   147→    const parentDir = path.dirname(dir);
   148→    if (parentDir === dir) {
   149→      // Reached root
   150→      return null;
   151→    }
   152→    dir = parentDir;
   153→  }
   154→}
   155→
   156→/**
   157→ * Context for working with spec/task files.
   158→ *
   159→ * When shadow branch is enabled:
   160→ * - rootDir points to the project root (where .kspec/ lives)
   161→ * - specDir points to .kspec/ (where spec files are read/written)
   162→ * - All file operations use specDir for resolution
   163→ *
   164→ * Without shadow branch:
   165→ * - rootDir is the project root
   166→ * - specDir is rootDir/spec/ (traditional layout)
   167→ */
   168→export interface KspecContext {
   169→  /** Project root directory */
   170→  rootDir: string;
   171→  /** Spec files directory (.kspec/ when shadow enabled, otherwise spec/) */
   172→  specDir: string;
   173→  /** Path to manifest file */
   174→  manifestPath: string | null;
   175→  /** Parsed manifest */
   176→  manifest: Manifest | null;
   177→  /** Shadow branch configuration (null if not using shadow) */
   178→  shadow: ShadowConfig | null;
   179→}
   180→
   181→/**
   182→ * Initialize context by finding manifest.
   183→ *
   184→ * Detection order:
   185→ * 1. Check for shadow branch (.kspec/ directory)
   186→ * 2. Fall back to traditional spec/ directory
   187→ *
   188→ * When shadow is detected, all operations use .kspec/ as specDir.
   189→ */
   190→export async function initContext(startDir?: string): Promise<KspecContext> {
   191→  const cwd = startDir || process.cwd();
   192→
   193→  // Try to detect shadow branch first
   194→  const shadow = await detectShadow(cwd);
   195→
   196→  if (shadow?.enabled) {
   197→    // Shadow mode: use .kspec/ for everything
   198→    const specDir = shadow.worktreeDir;
   199→    const manifestPath = await findManifestInDir(specDir);
   200→
   201→    let manifest: Manifest | null = null;
   202→    if (manifestPath) {
   203→      try {
   204→        const rawManifest = await readYamlFile<unknown>(manifestPath);
   205→        manifest = ManifestSchema.parse(rawManifest);
   206→      } catch {
   207→        // Manifest exists but may be invalid
   208→      }
   209→    }
   210→
   211→    return {
   212→      rootDir: shadow.projectRoot,
   213→      specDir,
   214→      manifestPath,
   215→      manifest,
   216→      shadow,
   217→    };
   218→  }
   219→
   220→  // Traditional mode: find manifest in spec/ or current directory
   221→  const manifestPath = await findManifest(cwd);
   222→
   223→  let manifest: Manifest | null = null;
   224→  let rootDir = cwd;
   225→  let specDir = cwd;
   226→
   227→  if (manifestPath) {
   228→    const manifestDir = path.dirname(manifestPath);
   229→    // Handle spec/ subdirectory
   230→    if (path.basename(manifestDir) === 'spec') {
   231→      rootDir = path.dirname(manifestDir);
   232→      specDir = manifestDir;
   233→    } else {
   234→      rootDir = manifestDir;
   235→      specDir = manifestDir;
   236→    }
   237→
   238→    try {
   239→      const rawManifest = await readYamlFile<unknown>(manifestPath);
   240→      manifest = ManifestSchema.parse(rawManifest);
   241→    } catch {
   242→      // Manifest exists but may be invalid
   243→    }
   244→  }
   245→
   246→  return { rootDir, specDir, manifestPath, manifest, shadow: null };
   247→}
   248→
   249→/**
   250→ * Find manifest file within a specific directory (no parent traversal).
   251→ * Used for shadow mode where we know exactly where to look.
   252→ */
   253→async function findManifestInDir(dir: string): Promise<string | null> {
   254→  const candidates = ['kynetic.yaml', 'kynetic.spec.yaml'];
   255→
   256→  for (const candidate of candidates) {
   257→    const filePath = path.join(dir, candidate);
   258→    try {
   259→      await fs.access(filePath);
   260→      return filePath;
   261→    } catch {
   262→      // File doesn't exist, try next
   263→    }
   264→  }
   265→
   266→  return null;
   267→}
   268→
   269→/**
   270→ * Load tasks from a single file.
   271→ * Helper function used by loadAllTasks.
   272→ */
   273→async function loadTasksFromFile(filePath: string): Promise<LoadedTask[]> {
   274→  const tasks: LoadedTask[] = [];
   275→
   276→  try {
   277→    const raw = await readYamlFile<unknown>(filePath);
   278→
   279→    // Handle both array format and object format
   280→    let taskList: unknown[];
   281→
   282→    if (Array.isArray(raw)) {
   283→      taskList = raw;
   284→    } else if (raw && typeof raw === 'object' && 'tasks' in raw) {
   285→      const parsed = TasksFileSchema.safeParse(raw);
   286→      if (parsed.success) {
   287→        // Add _sourceFile to each task from this file
   288→        for (const task of parsed.data.tasks) {
   289→          tasks.push({ ...task, _sourceFile: filePath });
   290→        }
   291→        return tasks;
   292→      }
   293→      taskList = (raw as { tasks: unknown[] }).tasks || [];
   294→    } else {
   295→      // Single task object
   296→      taskList = [raw];
   297→    }
   298→
   299→    for (const taskData of taskList) {
   300→      const result = TaskSchema.safeParse(taskData);
   301→      if (result.success) {
   302→        // Add _sourceFile metadata
   303→        tasks.push({ ...result.data, _sourceFile: filePath });
   304→      }
   305→    }
   306→  } catch {
   307→    // Skip invalid files
   308→  }
   309→
   310→  return tasks;
   311→}
   312→
   313→/**
   314→ * Load all tasks from the project.
   315→ * Each task includes _sourceFile metadata for write-back routing.
   316→ *
   317→ * When shadow is enabled, tasks are loaded from .kspec/ (ctx.specDir).
   318→ * Otherwise, searches in traditional locations (rootDir, spec/, tasks/).
   319→ */
   320→export async function loadAllTasks(ctx: KspecContext): Promise<LoadedTask[]> {
   321→  const tasks: LoadedTask[] = [];
   322→
   323→  // When shadow is enabled, look only in specDir
   324→  if (ctx.shadow?.enabled) {
   325→    const taskFiles = await findTaskFiles(ctx.specDir);
   326→
   327→    // Also check for standalone files in specDir
   328→    const standaloneLocations = [
   329→      path.join(ctx.specDir, 'tasks.yaml'),
   330→      path.join(ctx.specDir, 'project.tasks.yaml'),
   331→      path.join(ctx.specDir, 'kynetic.tasks.yaml'),
   332→      path.join(ctx.specDir, 'backlog.tasks.yaml'),
   333→      path.join(ctx.specDir, 'active.tasks.yaml'),
   334→    ];
   335→
   336→    for (const loc of standaloneLocations) {
   337→      try {
   338→        await fs.access(loc);
   339→        if (!taskFiles.includes(loc)) {
   340→          taskFiles.push(loc);
   341→        }
   342→      } catch {
   343→        // File doesn't exist
   344→      }
   345→    }
   346→
   347→    // Deduplicate and load
   348→    const uniqueFiles = [...new Set(taskFiles)];
   349→    for (const filePath of uniqueFiles) {
   350→      const fileTasks = await loadTasksFromFile(filePath);
   351→      tasks.push(...fileTasks);
   352→    }
   353→
   354→    return tasks;
   355→  }
   356→
   357→  // Traditional mode: look in multiple locations
   358→  const taskFiles = await findTaskFiles(ctx.rootDir);
   359→
   360→  // Also check common locations
   361→  const additionalPaths = [
   362→    path.join(ctx.rootDir, 'tasks'),
   363→    path.join(ctx.rootDir, 'spec'),
   364→  ];
   365→
   366→  for (const additionalPath of additionalPaths) {
   367→    const files = await findTaskFiles(additionalPath);
   368→    taskFiles.push(...files);
   369→  }
   370→
   371→  // Also look for standalone tasks.yaml and project.tasks.yaml
   372→  const standaloneLocations = [
   373→    path.join(ctx.rootDir, 'tasks.yaml'),
   374→    path.join(ctx.rootDir, 'project.tasks.yaml'),
   375→    path.join(ctx.rootDir, 'spec', 'project.tasks.yaml'),
   376→    path.join(ctx.rootDir, 'backlog.tasks.yaml'),
   377→    path.join(ctx.rootDir, 'active.tasks.yaml'),
   378→  ];
   379→
   380→  for (const loc of standaloneLocations) {
   381→    try {
   382→      await fs.access(loc);
   383→      if (!taskFiles.includes(loc)) {
   384→        taskFiles.push(loc);
   385→      }
   386→    } catch {
   387→      // File doesn't exist
   388→    }
   389→  }
   390→
   391→  // Deduplicate and load
   392→  const uniqueFiles = [...new Set(taskFiles)];
   393→
   394→  for (const filePath of uniqueFiles) {
   395→    const fileTasks = await loadTasksFromFile(filePath);
   396→    tasks.push(...fileTasks);
   397→  }
   398→
   399→  return tasks;
   400→}
   401→
   402→/**
   403→ * Find a task by reference (ULID, slug, or short reference)
   404→ */
   405→export function findTaskByRef(tasks: LoadedTask[], ref: string): LoadedTask | undefined {
   406→  // Remove @ prefix if present
   407→  const cleanRef = ref.startsWith('@') ? ref.slice(1) : ref;
   408→
   409→  return tasks.find(task => {
   410→    // Match full ULID
   411→    if (task._ulid === cleanRef) return true;
   412→
   413→    // Match short ULID (prefix)
   414→    if (task._ulid.toLowerCase().startsWith(cleanRef.toLowerCase())) return true;
   415→
   416→    // Match slug
   417→    if (task.slugs.includes(cleanRef)) return true;
   418→
   419→    return false;
   420→  });
   421→}
   422→
   423→/**
   424→ * Get the default task file path for new tasks without a spec_ref.
   425→ *
   426→ * When shadow enabled: .kspec/project.tasks.yaml
   427→ * Otherwise: spec/project.tasks.yaml
   428→ */
   429→export function getDefaultTaskFilePath(ctx: KspecContext): string {
   430→  return path.join(ctx.specDir, 'project.tasks.yaml');
   431→}
   432→
   433→/**
   434→ * Strip runtime metadata before serialization
   435→ */
   436→function stripRuntimeMetadata(task: LoadedTask): Task {
   437→  const { _sourceFile, ...cleanTask } = task;
   438→  return cleanTask as Task;
   439→}
   440→
   441→/**
   442→ * Save a task to its source file (or default location for new tasks).
   443→ * Preserves file format (tasks: [...] wrapper vs plain array).
   444→ */
   445→export async function saveTask(ctx: KspecContext, task: LoadedTask): Promise<void> {
   446→  // Determine target file: use _sourceFile if present, otherwise default
   447→  const taskFilePath = task._sourceFile || getDefaultTaskFilePath(ctx);
   448→
   449→  // Ensure directory exists
   450→  const dir = path.dirname(taskFilePath);
   451→  await fs.mkdir(dir, { recursive: true });
   452→
   453→  // Load existing tasks from the target file
   454→  let existingRaw: unknown = null;
   455→  let useTasksWrapper = false;
   456→
   457→  try {
   458→    existingRaw = await readYamlFile<unknown>(taskFilePath);
   459→    // Detect if file uses { tasks: [...] } format
   460→    if (existingRaw && typeof existingRaw === 'object' && 'tasks' in existingRaw) {
   461→      useTasksWrapper = true;
   462→    }
   463→  } catch {
   464→    // File doesn't exist, start fresh
   465→  }
   466→
   467→  // Parse existing tasks from file
   468→  let fileTasks: Task[] = [];
   469→
   470→  if (existingRaw) {
   471→    if (Array.isArray(existingRaw)) {
   472→      for (const t of existingRaw) {
   473→        const result = TaskSchema.safeParse(t);
   474→        if (result.success) {
   475→          fileTasks.push(result.data);
   476→        }
   477→      }
   478→    } else if (useTasksWrapper) {
   479→      // Try TasksFileSchema first (has kynetic_tasks version)
   480→      const parsed = TasksFileSchema.safeParse(existingRaw);
   481→      if (parsed.success) {
   482→        fileTasks = parsed.data.tasks;
   483→      } else {
   484→        // Fall back to raw tasks array (common format without version field)
   485→        const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   486→        if (Array.isArray(rawTasks)) {
   487→          for (const t of rawTasks) {
   488→            const result = TaskSchema.safeParse(t);
   489→            if (result.success) {
   490→              fileTasks.push(result.data);
   491→            }
   492→          }
   493→        }
   494→      }
   495→    }
   496→  }
   497→
   498→  // Strip runtime metadata before saving
   499→  const cleanTask = stripRuntimeMetadata(task);
   500→
   501→  // Update existing or add new
   502→  const existingIndex = fileTasks.findIndex(t => t._ulid === task._ulid);
   503→  if (existingIndex >= 0) {
   504→    fileTasks[existingIndex] = cleanTask;
   505→  } else {
   506→    fileTasks.push(cleanTask);
   507→  }
   508→
   509→  // Save in the same format as original (or tasks: wrapper for new files)
   510→  if (useTasksWrapper) {
   511→    await writeYamlFile(taskFilePath, { tasks: fileTasks });
   512→  } else {
   513→    await writeYamlFile(taskFilePath, fileTasks);
   514→  }
   515→}
   516→
   517→/**
   518→ * Delete a task from its source file.
   519→ * Requires _sourceFile to know which file to modify.
   520→ */
   521→export async function deleteTask(ctx: KspecContext, task: LoadedTask): Promise<void> {
   522→  if (!task._sourceFile) {
   523→    throw new Error('Cannot delete task without _sourceFile metadata');
   524→  }
   525→
   526→  const taskFilePath = task._sourceFile;
   527→
   528→  // Load existing file
   529→  let existingRaw: unknown = null;
   530→  let useTasksWrapper = false;
   531→
   532→  try {
   533→    existingRaw = await readYamlFile<unknown>(taskFilePath);
   534→    if (existingRaw && typeof existingRaw === 'object' && 'tasks' in existingRaw) {
   535→      useTasksWrapper = true;
   536→    }
   537→  } catch {
   538→    throw new Error(`Task file not found: ${taskFilePath}`);
   539→  }
   540→
   541→  // Parse existing tasks
   542→  let fileTasks: Task[] = [];
   543→
   544→  if (existingRaw) {
   545→    if (Array.isArray(existingRaw)) {
   546→      for (const t of existingRaw) {
   547→        const result = TaskSchema.safeParse(t);
   548→        if (result.success) {
   549→          fileTasks.push(result.data);
   550→        }
   551→      }
   552→    } else if (useTasksWrapper) {
   553→      const parsed = TasksFileSchema.safeParse(existingRaw);
   554→      if (parsed.success) {
   555→        fileTasks = parsed.data.tasks;
   556→      } else {
   557→        const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   558→        if (Array.isArray(rawTasks)) {
   559→          for (const t of rawTasks) {
   560→            const result = TaskSchema.safeParse(t);
   561→            if (result.success) {
   562→              fileTasks.push(result.data);
   563→            }
   564→          }
   565→        }
   566→      }
   567→    }
   568→  }
   569→
   570→  // Remove the task
   571→  const originalCount = fileTasks.length;
   572→  fileTasks = fileTasks.filter(t => t._ulid !== task._ulid);
   573→
   574→  if (fileTasks.length === originalCount) {
   575→    throw new Error(`Task not found in file: ${task._ulid}`);
   576→  }
   577→
   578→  // Save the modified file
   579→  if (useTasksWrapper) {
   580→    await writeYamlFile(taskFilePath, { tasks: fileTasks });
   581→  } else {
   582→    await writeYamlFile(taskFilePath, fileTasks);
   583→  }
   584→}
   585→
   586→/**
   587→ * Create a new task with auto-generated fields
   588→ */
   589→export function createTask(input: TaskInput): Task {
   590→  const now = new Date().toISOString();
   591→
   592→  return {
   593→    ...input,
   594→    _ulid: input._ulid || ulid(),
   595→    slugs: input.slugs || [],
   596→    type: input.type || 'task',
   597→    status: input.status || 'pending',
   598→    blocked_by: input.blocked_by || [],
   599→    depends_on: input.depends_on || [],
   600→    context: input.context || [],
   601→    priority: input.priority || 3,
   602→    tags: input.tags || [],
   603→    vcs_refs: input.vcs_refs || [],
   604→    created_at: input.created_at || now,
   605→    notes: input.notes || [],
   606→    todos: input.todos || [],
   607→  };
   608→}
   609→
   610→/**
   611→ * Get author from environment with fallback chain.
   612→ * Priority:
   613→ *   1. KSPEC_AUTHOR env var (explicit config, agent-agnostic)
   614→ *   2. git user.name (developer identity)
   615→ *   3. USER/USERNAME env var (system user)
   616→ *   4. undefined (will show as 'unknown' in output)
   617→ *
   618→ * For Claude Code integration, add to ~/.claude/settings.json:
   619→ *   { "env": { "KSPEC_AUTHOR": "@claude" } }
   620→ */
   621→export function getAuthor(): string | undefined {
   622→  // 1. Explicit config (works for any agent)
   623→  if (process.env.KSPEC_AUTHOR) {
   624→    return process.env.KSPEC_AUTHOR;
   625→  }
   626→
   627→  // 2. Git user.name
   628→  try {
   629→    const gitUser = execSync('git config user.name', {
   630→      encoding: 'utf-8',
   631→      stdio: ['pipe', 'pipe', 'ignore'],
   632→    }).trim();
   633→    if (gitUser) {
   634→      return gitUser;
   635→    }
   636→  } catch {
   637→    // git not available or not in a repo
   638→  }
   639→
   640→  // 3. System user
   641→  const systemUser = process.env.USER || process.env.USERNAME;
   642→  if (systemUser) {
   643→    return systemUser;
   644→  }
   645→
   646→  // 4. No author available
   647→  return undefined;
   648→}
   649→
   650→/**
   651→ * Create a new note entry.
   652→ * If author is not provided, attempts to auto-detect from environment.
   653→ */
   654→export function createNote(content: string, author?: string, supersedes?: string): Note {
   655→  return {
   656→    _ulid: ulid(),
   657→    created_at: new Date().toISOString(),
   658→    author: author ?? getAuthor(),
   659→    content,
   660→    supersedes: supersedes || null,
   661→  };
   662→}
   663→
   664→/**
   665→ * Create a new todo item.
   666→ * The id should be the next available id for the task's todos array.
   667→ */
   668→export function createTodo(id: number, text: string, addedBy?: string): Todo {
   669→  return {
   670→    id,
   671→    text,
   672→    done: false,
   673→    added_at: new Date().toISOString(),
   674→    added_by: addedBy ?? getAuthor(),
   675→  };
   676→}
   677→
   678→/**
   679→ * Check if task dependencies are met
   680→ */
   681→export function areDependenciesMet(task: LoadedTask, allTasks: LoadedTask[]): boolean {
   682→  if (task.depends_on.length === 0) return true;
   683→
   684→  for (const depRef of task.depends_on) {
   685→    const depTask = findTaskByRef(allTasks, depRef);
   686→    if (!depTask || depTask.status !== 'completed') {
   687→      return false;
   688→    }
   689→  }
   690→
   691→  return true;
   692→}
   693→
   694→/**
   695→ * Check if task is ready (pending + deps met + not blocked)
   696→ */
   697→export function isTaskReady(task: LoadedTask, allTasks: LoadedTask[]): boolean {
   698→  if (task.status !== 'pending') return false;
   699→  if (task.blocked_by.length > 0) return false;
   700→  return areDependenciesMet(task, allTasks);
   701→}
   702→
   703→/**
   704→ * Get ready tasks (pending + deps met + not blocked), sorted by priority then creation time.
   705→ * Within the same priority tier, older tasks come first (FIFO).
   706→ */
   707→export function getReadyTasks(tasks: LoadedTask[]): LoadedTask[] {
   708→  return tasks
   709→    .filter(task => isTaskReady(task, tasks))
   710→    .sort((a, b) => {
   711→      // Primary: priority (lower number = higher priority)
   712→      if (a.priority !== b.priority) {
   713→        return a.priority - b.priority;
   714→      }
   715→      // Secondary: creation time (older first - FIFO within priority)
   716→      return new Date(a.created_at).getTime() - new Date(b.created_at).getTime();
   717→    });
   718→}
   719→
   720→// ============================================================
   721→// SPEC ITEM LOADING
   722→// ============================================================
   723→
   724→/**
   725→ * Expand a glob-like include pattern to file paths.
   726→ * Supports simple patterns like "modules/*.yaml" or "**\/*.yaml"
   727→ */
   728→export async function expandIncludePattern(
   729→  pattern: string,
   730→  baseDir: string
   731→): Promise<string[]> {
   732→  const fullPattern = path.isAbsolute(pattern) ? pattern : path.join(baseDir, pattern);
   733→
   734→  // If no glob characters, just return the path if it exists
   735→  if (!pattern.includes('*')) {
   736→    try {
   737→      await fs.access(fullPattern);
   738→      return [fullPattern];
   739→    } catch {
   740→      return [];
   741→    }
   742→  }
   743→
   744→  // Split pattern into directory part and file pattern
   745→  const parts = pattern.split('/');
   746→  let currentDir = baseDir;
   747→  const result: string[] = [];
   748→
   749→  // Find the first part with a glob
   750→  let globIndex = parts.findIndex(p => p.includes('*'));
   751→
   752→  // Navigate to the directory before the glob
   753→  if (globIndex > 0) {
   754→    currentDir = path.join(baseDir, ...parts.slice(0, globIndex));
   755→  }
   756→
   757→  // Get the remaining pattern
   758→  const remainingPattern = parts.slice(globIndex).join('/');
   759→
   760→  await expandGlobRecursive(currentDir, remainingPattern, result);
   761→  return result;
   762→}
   763→
   764→/**
   765→ * Recursively expand glob patterns
   766→ */
   767→async function expandGlobRecursive(
   768→  dir: string,
   769→  pattern: string,
   770→  result: string[]
   771→): Promise<void> {
   772→  const parts = pattern.split('/');
   773→  const currentPattern = parts[0];
   774→  const remainingPattern = parts.slice(1).join('/');
   775→
   776→  try {
   777→    const entries = await fs.readdir(dir, { withFileTypes: true });
   778→
   779→    for (const entry of entries) {
   780→      const matches = matchGlobPart(entry.name, currentPattern);
   781→
   782→      if (matches) {
   783→        const fullPath = path.join(dir, entry.name);
   784→
   785→        if (remainingPattern) {
   786→          // More pattern parts to process
   787→          if (entry.isDirectory()) {
   788→            await expandGlobRecursive(fullPath, remainingPattern, result);
   789→          }
   790→        } else {
   791→          // This is the final pattern part
   792→          if (currentPattern === '**') {
   793→            // ** matches any depth - need special handling
   794→            if (entry.isDirectory()) {
   795→              await expandGlobRecursive(fullPath, '**', result);
   796→            }
   797→            // Also match files at this level
   798→            result.push(fullPath);
   799→          } else if (entry.isFile()) {
   800→            result.push(fullPath);
   801→          }
   802→        }
   803→      }
   804→
   805→      // Handle ** - also recurse into directories without consuming the pattern
   806→      if (currentPattern === '**' && entry.isDirectory()) {
   807→        const fullPath = path.join(dir, entry.name);
   808→        await expandGlobRecursive(fullPath, pattern, result);
   809→      }
   810→    }
   811→  } catch {
   812→    // Directory doesn't exist or not readable
   813→  }
   814→}
   815→
   816→/**
   817→ * Match a single path component against a glob pattern part
   818→ */
   819→function matchGlobPart(name: string, pattern: string): boolean {
   820→  if (pattern === '*') return true;
   821→  if (pattern === '**') return true;
   822→
   823→  // Convert glob pattern to regex
   824→  const regexPattern = pattern
   825→    .replace(/[.+^${}()|[\]\\]/g, '\\$&') // Escape special regex chars
   826→    .replace(/\*/g, '.*') // * matches anything
   827→    .replace(/\?/g, '.'); // ? matches single char
   828→
   829→  const regex = new RegExp(`^${regexPattern}$`);
   830→  return regex.test(name);
   831→}
   832→
   833→/**
   834→ * Fields that may contain nested spec items
   835→ */
   836→const NESTED_ITEM_FIELDS = [
   837→  'modules',
   838→  'features',
   839→  'requirements',
   840→  'constraints',
   841→  'decisions',
   842→  'acceptance_criteria',
   843→];
   844→
   845→/**
   846→ * Recursively extract all spec items from a raw YAML structure.
   847→ * Items can be nested under modules/features/requirements/etc.
   848→ * Tracks the path within the file for each item.
   849→ */
   850→export function extractItemsFromRaw(
   851→  raw: unknown,
   852→  sourceFile: string,
   853→  items: LoadedSpecItem[] = [],
   854→  currentPath: string = ''
   855→): LoadedSpecItem[] {
   856→  if (!raw || typeof raw !== 'object') {
   857→    return items;
   858→  }
   859→
   860→  // Check if this object is itself a spec item (has _ulid)
   861→  if ('_ulid' in raw && typeof (raw as Record<string, unknown>)._ulid === 'string') {
   862→    const result = SpecItemSchema.safeParse(raw);
   863→    if (result.success) {
   864→      items.push({
   865→        ...result.data,
   866→        _sourceFile: sourceFile,
   867→        _path: currentPath || undefined,
   868→      });
   869→    }
   870→
   871→    // Even if the item itself was added, also extract nested items
   872→    const rawObj = raw as Record<string, unknown>;
   873→    for (const field of NESTED_ITEM_FIELDS) {
   874→      if (field in rawObj && Array.isArray(rawObj[field])) {
   875→        const arr = rawObj[field] as unknown[];
   876→        for (let i = 0; i < arr.length; i++) {
   877→          const nestedPath = currentPath ? `${currentPath}.${field}[${i}]` : `${field}[${i}]`;
   878→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
   879→        }
   880→      }
   881→    }
   882→  } else if (Array.isArray(raw)) {
   883→    // Array of items at root level
   884→    for (let i = 0; i < raw.length; i++) {
   885→      const itemPath = currentPath ? `${currentPath}[${i}]` : `[${i}]`;
   886→      extractItemsFromRaw(raw[i], sourceFile, items, itemPath);
   887→    }
   888→  } else {
   889→    // Object that might contain item arrays (like manifest with modules/features/etc)
   890→    const rawObj = raw as Record<string, unknown>;
   891→    for (const field of NESTED_ITEM_FIELDS) {
   892→      if (field in rawObj && Array.isArray(rawObj[field])) {
   893→        const arr = rawObj[field] as unknown[];
   894→        for (let i = 0; i < arr.length; i++) {
   895→          const nestedPath = currentPath ? `${currentPath}.${field}[${i}]` : `${field}[${i}]`;
   896→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
   897→        }
   898→      }
   899→    }
   900→  }
   901→
   902→  return items;
   903→}
   904→
   905→/**
   906→ * Load spec items from a single file.
   907→ * Handles module files (the file itself is an item with nested children).
   908→ */
   909→export async function loadSpecFile(filePath: string): Promise<LoadedSpecItem[]> {
   910→  try {
   911→    const raw = await readYamlFile<unknown>(filePath);
   912→    return extractItemsFromRaw(raw, filePath);
   913→  } catch (error) {
   914→    // File doesn't exist or parse error
   915→    return [];
   916→  }
   917→}
   918→
   919→/**
   920→ * Load all spec items from the project.
   921→ * Parses manifest, follows includes, and builds unified collection.
   922→ */
   923→export async function loadAllItems(ctx: KspecContext): Promise<LoadedSpecItem[]> {
   924→  const items: LoadedSpecItem[] = [];
   925→
   926→  if (!ctx.manifest || !ctx.manifestPath) {
   927→    return items;
   928→  }
   929→
   930→  const manifestDir = path.dirname(ctx.manifestPath);
   931→
   932→  // Extract items from manifest itself (inline modules/features/etc)
   933→  const manifestItems = extractItemsFromRaw(ctx.manifest, ctx.manifestPath);
   934→  items.push(...manifestItems);
   935→
   936→  // Process includes
   937→  const includes = ctx.manifest.includes || [];
   938→
   939→  for (const include of includes) {
   940→    const expandedPaths = await expandIncludePattern(include, manifestDir);
   941→
   942→    for (const filePath of expandedPaths) {
   943→      const fileItems = await loadSpecFile(filePath);
   944→      items.push(...fileItems);
   945→    }
   946→  }
   947→
   948→  return items;
   949→}
   950→
   951→/**
   952→ * Find a spec item by reference (ULID, slug, or short reference)
   953→ */
   954→export function findItemByRef(
   955→  items: LoadedSpecItem[],
   956→  ref: string
   957→): LoadedSpecItem | undefined {
   958→  // Remove @ prefix if present
   959→  const cleanRef = ref.startsWith('@') ? ref.slice(1) : ref;
   960→
   961→  return items.find(item => {
   962→    // Match full ULID
   963→    if (item._ulid === cleanRef) return true;
   964→
   965→    // Match short ULID (prefix)
   966→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase())) return true;
   967→
   968→    // Match slug
   969→    if (item.slugs.includes(cleanRef)) return true;
   970→
   971→    return false;
   972→  });
   973→}
   974→
   975→/**
   976→ * Combined item type for unified queries across tasks and spec items
   977→ */
   978→export type AnyLoadedItem = LoadedTask | LoadedSpecItem;
   979→
   980→/**
   981→ * Find any item (task or spec item) by reference
   982→ */
   983→export function findAnyItemByRef(
   984→  tasks: LoadedTask[],
   985→  items: LoadedSpecItem[],
   986→  ref: string
   987→): AnyLoadedItem | undefined {
   988→  // Try tasks first (more commonly referenced)
   989→  const task = findTaskByRef(tasks, ref);
   990→  if (task) return task;
   991→
   992→  // Then try spec items
   993→  return findItemByRef(items, ref);
   994→}
   995→
   996→/**
   997→ * Build a ReferenceIndex from context.
   998→ * Loads all tasks and spec items, then builds the index.
   999→ */
  1000→export async function buildReferenceIndex(ctx: KspecContext): Promise<{
  1001→  index: ReferenceIndex;
  1002→  tasks: LoadedTask[];
  1003→  items: LoadedSpecItem[];
  1004→}> {
  1005→  const tasks = await loadAllTasks(ctx);
  1006→  const items = await loadAllItems(ctx);
  1007→  const index = new ReferenceIndex(tasks, items);
  1008→  return { index, tasks, items };
  1009→}
  1010→
  1011→/**
  1012→ * Build both ReferenceIndex and ItemIndex from context.
  1013→ * Use this when you need query capabilities in addition to reference resolution.
  1014→ */
  1015→export async function buildIndexes(ctx: KspecContext): Promise<{
  1016→  refIndex: ReferenceIndex;
  1017→  itemIndex: ItemIndex;
  1018→  tasks: LoadedTask[];
  1019→  items: LoadedSpecItem[];
  1020→}> {
  1021→  const tasks = await loadAllTasks(ctx);
  1022→  const items = await loadAllItems(ctx);
  1023→  const refIndex = new ReferenceIndex(tasks, items);
  1024→  const itemIndex = new ItemIndex(tasks, items);
  1025→  return { refIndex, itemIndex, tasks, items };
  1026→}
  1027→
  1028→// ============================================================
  1029→// SPEC ITEM CRUD (supports nested structures)
  1030→// ============================================================
  1031→
  1032→/**
  1033→ * Strip runtime metadata from spec item before serialization
  1034→ */
  1035→function stripSpecItemMetadata(item: LoadedSpecItem): SpecItem {
  1036→  const { _sourceFile, _path, ...cleanItem } = item;
  1037→  return cleanItem as SpecItem;
  1038→}
  1039→
  1040→/**
  1041→ * Parse a path string into segments.
  1042→ * e.g., "features[0].requirements[2]" -> [["features", 0], ["requirements", 2]]
  1043→ */
  1044→function parsePath(pathStr: string): Array<[string, number]> {
  1045→  const segments: Array<[string, number]> = [];
  1046→  const regex = /(\w+)\[(\d+)\]/g;
  1047→  let match;
  1048→  while ((match = regex.exec(pathStr)) !== null) {
  1049→    segments.push([match[1], parseInt(match[2], 10)]);
  1050→  }
  1051→  return segments;
  1052→}
  1053→
  1054→/**
  1055→ * Navigate to a location in a YAML structure using a path.
  1056→ * Returns the parent object and the array containing the target item.
  1057→ */
  1058→function navigateToPath(
  1059→  root: unknown,
  1060→  pathStr: string
  1061→): { parent: Record<string, unknown>; array: unknown[]; index: number } | null {
  1062→  if (!pathStr) return null;
  1063→
  1064→  const segments = parsePath(pathStr);
  1065→  if (segments.length === 0) return null;
  1066→
  1067→  let current: unknown = root;
  1068→
  1069→  // Navigate to the parent of the last segment
  1070→  for (let i = 0; i < segments.length - 1; i++) {
  1071→    const [field, index] = segments[i];
  1072→    if (typeof current !== 'object' || current === null) return null;
  1073→    const obj = current as Record<string, unknown>;
  1074→    if (!Array.isArray(obj[field])) return null;
  1075→    current = (obj[field] as unknown[])[index];
  1076→  }
  1077→
  1078→  // Get the final array and index
  1079→  const [finalField, finalIndex] = segments[segments.length - 1];
  1080→  if (typeof current !== 'object' || current === null) return null;
  1081→  const parent = current as Record<string, unknown>;
  1082→  if (!Array.isArray(parent[finalField])) return null;
  1083→
  1084→  return {
  1085→    parent,
  1086→    array: parent[finalField] as unknown[],
  1087→    index: finalIndex,
  1088→  };
  1089→}
  1090→
  1091→/**
  1092→ * Find an item by ULID in a nested YAML structure.
  1093→ * Returns the path segments to reach it.
  1094→ */
  1095→function findItemInStructure(
  1096→  root: unknown,
  1097→  ulid: string,
  1098→  currentPath: string = ''
  1099→): { path: string; item: Record<string, unknown> } | null {
  1100→  if (!root || typeof root !== 'object') return null;
  1101→
  1102→  const obj = root as Record<string, unknown>;
  1103→
  1104→  // Check if this is the item we're looking for
  1105→  if (obj._ulid === ulid) {
  1106→    return { path: currentPath, item: obj };
  1107→  }
  1108→
  1109→  // Search nested item fields
  1110→  for (const field of NESTED_ITEM_FIELDS) {
  1111→    if (Array.isArray(obj[field])) {
  1112→      const arr = obj[field] as unknown[];
  1113→      for (let i = 0; i < arr.length; i++) {
  1114→        const nestedPath = currentPath ? `${currentPath}.${field}[${i}]` : `${field}[${i}]`;
  1115→        const result = findItemInStructure(arr[i], ulid, nestedPath);
  1116→        if (result) return result;
  1117→      }
  1118→    }
  1119→  }
  1120→
  1121→  return null;
  1122→}
  1123→
  1124→/**
  1125→ * Create a new spec item with auto-generated fields
  1126→ */
  1127→export function createSpecItem(input: SpecItemInput): SpecItem {
  1128→  return {
  1129→    _ulid: input._ulid || ulid(),
  1130→    slugs: input.slugs || [],
  1131→    title: input.title,
  1132→    type: input.type,
  1133→    status: input.status,
  1134→    priority: input.priority,
  1135→    tags: input.tags || [],
  1136→    description: input.description,
  1137→    depends_on: input.depends_on || [],
  1138→    implements: input.implements || [],
  1139→    relates_to: input.relates_to || [],
  1140→    tests: input.tests || [],
  1141→    created: input.created || new Date().toISOString(),
  1142→    created_by: input.created_by,
  1143→  };
  1144→}
  1145→
  1146→/**
  1147→ * Map from item type to the field name used to store children of that type.
  1148→ */
  1149→const TYPE_TO_CHILD_FIELD: Record<string, string> = {
  1150→  feature: 'features',
  1151→  requirement: 'requirements',
  1152→  constraint: 'constraints',
  1153→  decision: 'decisions',
  1154→  module: 'modules',
  1155→};
  1156→
  1157→/**
  1158→ * Add a spec item as a child of a parent item.
  1159→ * @param parent The parent item to add under
  1160→ * @param child The new child item to add
  1161→ * @param childField Optional field name override (defaults based on child.type)
  1162→ */
  1163→export async function addChildItem(
  1164→  ctx: KspecContext,
  1165→  parent: LoadedSpecItem,
  1166→  child: SpecItem,
  1167→  childField?: string
  1168→): Promise<{ item: SpecItem; path: string }> {
  1169→  if (!parent._sourceFile) {
  1170→    throw new Error('Parent item has no source file');
  1171→  }
  1172→
  1173→  const field = childField || TYPE_TO_CHILD_FIELD[child.type || 'feature'] || 'features';
  1174→
  1175→  // Load the raw YAML
  1176→  const raw = await readYamlFile<unknown>(parent._sourceFile);
  1177→
  1178→  // Find the parent in the structure
  1179→  let parentObj: Record<string, unknown>;
  1180→  let parentPath: string;
  1181→
  1182→  if (parent._path) {
  1183→    const nav = navigateToPath(raw, parent._path);
  1184→    if (!nav) {
  1185→      throw new Error(`Could not navigate to parent path: ${parent._path}`);
  1186→    }
  1187→    parentObj = nav.array[nav.index] as Record<string, unknown>;
  1188→    parentPath = parent._path;
  1189→  } else {
  1190→    // Parent is the root item
  1191→    parentObj = raw as Record<string, unknown>;
  1192→    parentPath = '';
  1193→  }
  1194→
  1195→  // Ensure the child field array exists
  1196→  if (!Array.isArray(parentObj[field])) {
  1197→    parentObj[field] = [];
  1198→  }
  1199→
  1200→  // Add the child
  1201→  const childArray = parentObj[field] as unknown[];
  1202→  const cleanChild = stripSpecItemMetadata(child as LoadedSpecItem);
  1203→  childArray.push(cleanChild);
  1204→
  1205→  // Calculate the new child's path
  1206→  const childIndex = childArray.length - 1;
  1207→  const childPath = parentPath ? `${parentPath}.${field}[${childIndex}]` : `${field}[${childIndex}]`;
  1208→
  1209→  // Write back
  1210→  await writeYamlFile(parent._sourceFile, raw);
  1211→
  1212→  return { item: cleanChild, path: childPath };
  1213→}
  1214→
  1215→/**
  1216→ * Update a spec item in place within its source file.
  1217→ * Works with nested structures using the _path field.
  1218→ */
  1219→export async function updateSpecItem(
  1220→  ctx: KspecContext,
  1221→  item: LoadedSpecItem,
  1222→  updates: Partial<SpecItemInput>
  1223→): Promise<SpecItem> {
  1224→  if (!item._sourceFile) {
  1225→    throw new Error('Item has no source file');
  1226→  }
  1227→
  1228→  // Load the raw YAML
  1229→  const raw = await readYamlFile<unknown>(item._sourceFile);
  1230→
  1231→  // Find the item in the structure (use stored path or search by ULID)
  1232→  let targetObj: Record<string, unknown>;
  1233→
  1234→  if (item._path) {
  1235→    const nav = navigateToPath(raw, item._path);
  1236→    if (!nav) {
  1237→      throw new Error(`Could not navigate to path: ${item._path}`);
  1238→    }
  1239→    targetObj = nav.array[nav.index] as Record<string, unknown>;
  1240→  } else {
  1241→    // Item might be the root, or we need to find it
  1242→    const found = findItemInStructure(raw, item._ulid);
  1243→    if (found) {
  1244→      targetObj = found.item;
  1245→    } else if ((raw as Record<string, unknown>)._ulid === item._ulid) {
  1246→      targetObj = raw as Record<string, unknown>;
  1247→    } else {
  1248→      throw new Error(`Could not find item ${item._ulid} in structure`);
  1249→    }
  1250→  }
  1251→
  1252→  // Apply updates (but never change _ulid)
  1253→  for (const [key, value] of Object.entries(updates)) {
  1254→    if (key !== '_ulid' && key !== '_sourceFile' && key !== '_path') {
  1255→      targetObj[key] = value;
  1256→    }
  1257→  }
  1258→
  1259→  // Write back
  1260→  await writeYamlFile(item._sourceFile, raw);
  1261→
  1262→  return { ...item, ...updates, _ulid: item._ulid } as SpecItem;
  1263→}
  1264→
  1265→/**
  1266→ * Delete a spec item from its source file.
  1267→ * Works with nested structures using the _path field.
  1268→ */
  1269→export async function deleteSpecItem(ctx: KspecContext, item: LoadedSpecItem): Promise<boolean> {
  1270→  if (!item._sourceFile) {
  1271→    return false;
  1272→  }
  1273→
  1274→  try {
  1275→    const raw = await readYamlFile<unknown>(item._sourceFile);
  1276→
  1277→    // If item has a path, navigate to it and remove from parent array
  1278→    if (item._path) {
  1279→      const nav = navigateToPath(raw, item._path);
  1280→      if (!nav) {
  1281→        return false;
  1282→      }
  1283→      // Remove the item from the array
  1284→      nav.array.splice(nav.index, 1);
  1285→      await writeYamlFile(item._sourceFile, raw);
  1286→      return true;
  1287→    }
  1288→
  1289→    // No path - try to find it by ULID
  1290→    const found = findItemInStructure(raw, item._ulid);
  1291→    if (found && found.path) {
  1292→      const nav = navigateToPath(raw, found.path);
  1293→      if (nav) {
  1294→        nav.array.splice(nav.index, 1);
  1295→        await writeYamlFile(item._sourceFile, raw);
  1296→        return true;
  1297→      }
  1298→    }
  1299→
  1300→    // Maybe it's a root-level array item
  1301→    if (Array.isArray(raw)) {
  1302→      const index = raw.findIndex((i: unknown) =>
  1303→        typeof i === 'object' && i !== null && (i as Record<string, unknown>)._ulid === item._ulid
  1304→      );
  1305→      if (index >= 0) {
  1306→        raw.splice(index, 1);
  1307→        await writeYamlFile(item._sourceFile, raw);
  1308→        return true;
  1309→      }
  1310→    }
  1311→
  1312→    return false;
  1313→  } catch {
  1314→    return false;
  1315→  }
  1316→}
  1317→
  1318→/**
  1319→ * Save a spec item - either updates existing or adds to parent.
  1320→ * For new items, use addChildItem instead.
  1321→ */
  1322→export async function saveSpecItem(ctx: KspecContext, item: LoadedSpecItem): Promise<void> {
  1323→  // If item has a source file and path, it's an update
  1324→  if (item._sourceFile && item._path) {
  1325→    await updateSpecItem(ctx, item, item);
  1326→    return;
  1327→  }
  1328→
  1329→  // Otherwise, this is more complex - would need a parent
  1330→  throw new Error('Cannot save new item without parent. Use addChildItem instead.');
  1331→}
  1332→
  1333→// ============================================================
  1334→// INBOX SYSTEM
  1335→// ============================================================
  1336→
  1337→/**
  1338→ * Inbox item with runtime metadata for source tracking.
  1339→ */
  1340→export interface LoadedInboxItem extends InboxItem {
  1341→  _sourceFile?: string;
  1342→}
  1343→
  1344→/**
  1345→ * Get the inbox file path.
  1346→ *
  1347→ * When shadow enabled: .kspec/project.inbox.yaml
  1348→ * Otherwise: spec/project.inbox.yaml
  1349→ */
  1350→export function getInboxFilePath(ctx: KspecContext): string {
  1351→  return path.join(ctx.specDir, 'project.inbox.yaml');
  1352→}
  1353→
  1354→/**
  1355→ * Load all inbox items from the project.
  1356→ */
  1357→export async function loadInboxItems(ctx: KspecContext): Promise<LoadedInboxItem[]> {
  1358→  const inboxPath = getInboxFilePath(ctx);
  1359→
  1360→  try {
  1361→    const raw = await readYamlFile<unknown>(inboxPath);
  1362→
  1363→    // Handle { inbox: [...] } format
  1364→    if (raw && typeof raw === 'object' && 'inbox' in raw) {
  1365→      const parsed = InboxFileSchema.safeParse(raw);
  1366→      if (parsed.success) {
  1367→        return parsed.data.inbox.map(item => ({ ...item, _sourceFile: inboxPath }));
  1368→      }
  1369→    }
  1370→
  1371→    // Handle plain array format
  1372→    if (Array.isArray(raw)) {
  1373→      const items: LoadedInboxItem[] = [];
  1374→      for (const item of raw) {
  1375→        const result = InboxItemSchema.safeParse(item);
  1376→        if (result.success) {
  1377→          items.push({ ...result.data, _sourceFile: inboxPath });
  1378→        }
  1379→      }
  1380→      return items;
  1381→    }
  1382→
  1383→    return [];
  1384→  } catch {
  1385→    // File doesn't exist or parse error
  1386→    return [];
  1387→  }
  1388→}
  1389→
  1390→/**
  1391→ * Create a new inbox item with auto-generated fields.
  1392→ */
  1393→export function createInboxItem(input: InboxItemInput): InboxItem {
  1394→  return {
  1395→    _ulid: input._ulid || ulid(),
  1396→    text: input.text,
  1397→    created_at: input.created_at || new Date().toISOString(),
  1398→    tags: input.tags || [],
  1399→    added_by: input.added_by ?? getAuthor(),
  1400→  };
  1401→}
  1402→
  1403→/**
  1404→ * Strip runtime metadata before serialization.
  1405→ */
  1406→function stripInboxMetadata(item: LoadedInboxItem): InboxItem {
  1407→  const { _sourceFile, ...cleanItem } = item;
  1408→  return cleanItem as InboxItem;
  1409→}
  1410→
  1411→/**
  1412→ * Save an inbox item (add or update).
  1413→ */
  1414→export async function saveInboxItem(ctx: KspecContext, item: LoadedInboxItem): Promise<void> {
  1415→  const inboxPath = getInboxFilePath(ctx);
  1416→
  1417→  // Ensure directory exists
  1418→  const dir = path.dirname(inboxPath);
  1419→  await fs.mkdir(dir, { recursive: true });
  1420→
  1421→  // Load existing items
  1422→  let existingItems: InboxItem[] = [];
  1423→
  1424→  try {
  1425→    const raw = await readYamlFile<unknown>(inboxPath);
  1426→    if (raw && typeof raw === 'object' && 'inbox' in raw) {
  1427→      const parsed = InboxFileSchema.safeParse(raw);
  1428→      if (parsed.success) {
  1429→        existingItems = parsed.data.inbox;
  1430→      }
  1431→    } else if (Array.isArray(raw)) {
  1432→      for (const i of raw) {
  1433→        const result = InboxItemSchema.safeParse(i);
  1434→        if (result.success) {
  1435→          existingItems.push(result.data);
  1436→        }
  1437→      }
  1438→    }
  1439→  } catch {
  1440→    // File doesn't exist, start fresh
  1441→  }
  1442→
  1443→  const cleanItem = stripInboxMetadata(item);
  1444→
  1445→  // Update existing or add new
  1446→  const existingIndex = existingItems.findIndex(i => i._ulid === item._ulid);
  1447→  if (existingIndex >= 0) {
  1448→    existingItems[existingIndex] = cleanItem;
  1449→  } else {
  1450→    existingItems.push(cleanItem);
  1451→  }
  1452→
  1453→  // Save with { inbox: [...] } format
  1454→  await writeYamlFile(inboxPath, { inbox: existingItems });
  1455→}
  1456→
  1457→/**
  1458→ * Delete an inbox item by ULID.
  1459→ */
  1460→export async function deleteInboxItem(ctx: KspecContext, ulid: string): Promise<boolean> {
  1461→  const inboxPath = getInboxFilePath(ctx);
  1462→
  1463→  try {
  1464→    const raw = await readYamlFile<unknown>(inboxPath);
  1465→    let existingItems: InboxItem[] = [];
  1466→
  1467→    if (raw && typeof raw === 'object' && 'inbox' in raw) {
  1468→      const parsed = InboxFileSchema.safeParse(raw);
  1469→      if (parsed.success) {
  1470→        existingItems = parsed.data.inbox;
  1471→      }
  1472→    }
  1473→
  1474→    const index = existingItems.findIndex(i => i._ulid === ulid);
  1475→    if (index < 0) {
  1476→      return false;
  1477→    }
  1478→
  1479→    existingItems.splice(index, 1);
  1480→    await writeYamlFile(inboxPath, { inbox: existingItems });
  1481→    return true;
  1482→  } catch {
  1483→    return false;
  1484→  }
  1485→}
  1486→
  1487→/**
  1488→ * Find an inbox item by reference (ULID or short ULID).
  1489→ */
  1490→export function findInboxItemByRef(
  1491→  items: LoadedInboxItem[],
  1492→  ref: string
  1493→): LoadedInboxItem | undefined {
  1494→  const cleanRef = ref.startsWith('@') ? ref.slice(1) : ref;
  1495→
  1496→  return items.find(item => {
  1497→    // Match full ULID
  1498→    if (item._ulid === cleanRef) return true;
  1499→    // Match short ULID (prefix)
  1500→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase())) return true;
  1501→    return false;
  1502→  });
  1503→}
  1504→
  1505→// ─── Patch Operations ────────────────────────────────────────────────────────
  1506→
  1507→/**
  1508→ * A single patch operation for bulk patching
  1509→ */
  1510→export interface PatchOperation {
  1511→  ref: string;
  1512→  data: Record<string, unknown>;
  1513→}
  1514→
  1515→/**
  1516→ * Result of a single patch operation
  1517→ */
  1518→export interface PatchResult {
  1519→  ref: string;
  1520→  status: 'updated' | 'skipped' | 'error';
  1521→  ulid?: string;
  1522→  error?: string;
  1523→}
  1524→
  1525→/**
  1526→ * Result of a bulk patch operation
  1527→ */
  1528→export interface BulkPatchResult {
  1529→  results: PatchResult[];
  1530→  summary: {
  1531→    total: number;
  1532→    updated: number;
  1533→    failed: number;
  1534→    skipped: number;
  1535→  };
  1536→}
  1537→
  1538→/**
  1539→ * Options for patch operations
  1540→ */
  1541→export interface PatchOptions {
  1542→  allowUnknown?: boolean;
  1543→  dryRun?: boolean;
  1544→  failFast?: boolean;
  1545→}
  1546→
  1547→/**
  1548→ * Bulk patch spec items.
  1549→ * Resolves refs, validates data, applies patches.
  1550→ * Continues on error by default (use failFast to stop on first error).
  1551→ */
  1552→export async function patchSpecItems(
  1553→  ctx: KspecContext,
  1554→  refIndex: ReferenceIndex,
  1555→  items: LoadedSpecItem[],
  1556→  patches: PatchOperation[],
  1557→  options: PatchOptions = {}
  1558→): Promise<BulkPatchResult> {
  1559→  const results: PatchResult[] = [];
  1560→  let stopProcessing = false;
  1561→
  1562→  for (const patch of patches) {
  1563→    if (stopProcessing) {
  1564→      results.push({ ref: patch.ref, status: 'skipped' });
  1565→      continue;
  1566→    }
  1567→
  1568→    // Resolve ref
  1569→    const resolved = refIndex.resolve(patch.ref);
  1570→    if (!resolved.ok) {
  1571→      const errorMsg = resolved.error === 'not_found'
  1572→        ? `Item not found: ${patch.ref}`
  1573→        : resolved.error === 'ambiguous'
  1574→          ? `Ambiguous ref: ${patch.ref}`
  1575→          : `Duplicate slug: ${patch.ref}`;
  1576→      results.push({ ref: patch.ref, status: 'error', error: errorMsg });
  1577→      if (options.failFast) {
  1578→        stopProcessing = true;
  1579→      }
  1580→      continue;
  1581→    }
  1582→
  1583→    // Find the item
  1584→    const item = items.find(i => i._ulid === resolved.ulid);
  1585→    if (!item) {
  1586→      // Ref resolved but it's not a spec item (might be a task)
  1587→      results.push({ ref: patch.ref, status: 'error', error: 'Not a spec item' });
  1588→      if (options.failFast) {
  1589→        stopProcessing = true;
  1590→      }
  1591→      continue;
  1592→    }
  1593→
  1594→    // Dry run - just record what would happen
  1595→    if (options.dryRun) {
  1596→      results.push({ ref: patch.ref, status: 'updated', ulid: item._ulid });
  1597→      continue;
  1598→    }
  1599→
  1600→    // Apply the patch
  1601→    try {
  1602→      await updateSpecItem(ctx, item, patch.data);
  1603→      results.push({ ref: patch.ref, status: 'updated', ulid: item._ulid });
  1604→    } catch (err) {
  1605→      const errorMsg = err instanceof Error ? err.message : String(err);
  1606→      results.push({ ref: patch.ref, status: 'error', error: errorMsg });
  1607→      if (options.failFast) {
  1608→        stopProcessing = true;
  1609→      }
  1610→    }
  1611→  }
  1612→
  1613→  return {
  1614→    results,
  1615→    summary: {
  1616→      total: patches.length,
  1617→      updated: results.filter(r => r.status === 'updated').length,
  1618→      failed: results.filter(r => r.status === 'error').length,
  1619→      skipped: results.filter(r => r.status === 'skipped').length,
  1620→    },
  1621→  };
  1622→}
  1623→

<system-reminder>
