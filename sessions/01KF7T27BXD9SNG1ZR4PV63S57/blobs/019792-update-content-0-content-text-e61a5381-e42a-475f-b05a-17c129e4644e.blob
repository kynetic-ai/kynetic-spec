```
     1→/**
     2→ * Meta CLI commands for interacting with meta-spec.
     3→ *
     4→ * AC-meta-manifest-1: kspec meta show outputs summary
     5→ * AC-meta-manifest-2: kspec validate includes meta line
     6→ * AC-meta-manifest-3: kspec validate shows meta errors with prefix
     7→ * AC-agent-1: kspec meta agents outputs table
     8→ * AC-agent-2: kspec meta agents --json outputs JSON
     9→ */
    10→
    11→import { Command } from 'commander';
    12→import chalk from 'chalk';
    13→import Table from 'cli-table3';
    14→import { ulid } from 'ulid';
    15→import {
    16→  initContext,
    17→  loadMetaContext,
    18→  getMetaStats,
    19→  createObservation,
    20→  saveObservation,
    21→  saveMetaItem,
    22→  deleteMetaItem,
    23→  createTask,
    24→  saveTask,
    25→  loadAllTasks,
    26→  type MetaContext,
    27→  type Agent,
    28→  type Workflow,
    29→  type Convention,
    30→  type Observation,
    31→} from '../../parser/index.js';
    32→import { type ObservationType } from '../../schema/index.js';
    33→import { output, error, success, isJsonMode } from '../output.js';
    34→import { errors } from '../../strings/errors.js';
    35→
    36→/**
    37→ * Resolve a meta reference to its ULID
    38→ * Handles semantic IDs (agent.id, workflow.id, convention.domain) and ULID prefixes
    39→ */
    40→function resolveMetaRefToUlid(
    41→  ref: string,
    42→  metaCtx: MetaContext
    43→): { ulid: string; type: 'agent' | 'workflow' | 'convention' | 'observation' } | null {
    44→  const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
    45→
    46→  // Check agents
    47→  const agent = (metaCtx.manifest?.agents || []).find(
    48→    (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
    49→  );
    50→  if (agent) return { ulid: agent._ulid, type: 'agent' };
    51→
    52→  // Check workflows
    53→  const workflow = (metaCtx.manifest?.workflows || []).find(
    54→    (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
    55→  );
    56→  if (workflow) return { ulid: workflow._ulid, type: 'workflow' };
    57→
    58→  // Check conventions
    59→  const convention = (metaCtx.manifest?.conventions || []).find(
    60→    (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
    61→  );
    62→  if (convention) return { ulid: convention._ulid, type: 'convention' };
    63→
    64→  // Check observations
    65→  const observation = (metaCtx.manifest?.observations || []).find((o) =>
    66→    o._ulid.startsWith(normalizedRef)
    67→  );
    68→  if (observation) return { ulid: observation._ulid, type: 'observation' };
    69→
    70→  return null;
    71→}
    72→
    73→/**
    74→ * Format meta show output
    75→ */
    76→function formatMetaShow(meta: MetaContext): void {
    77→  const stats = getMetaStats(meta);
    78→
    79→  if (!meta.manifest) {
    80→    console.log(chalk.yellow('No meta manifest found (kynetic.meta.yaml)'));
    81→    console.log(chalk.gray('Create one to define agents, workflows, conventions, and observations'));
    82→    return;
    83→  }
    84→
    85→  console.log(chalk.bold('Meta-Spec Summary'));
    86→  console.log(chalk.gray('─'.repeat(40)));
    87→  console.log(`Agents:       ${stats.agents}`);
    88→  console.log(`Workflows:    ${stats.workflows}`);
    89→  console.log(`Conventions:  ${stats.conventions}`);
    90→  console.log(`Observations: ${stats.observations} (${stats.unresolvedObservations} unresolved)`);
    91→}
    92→
    93→/**
    94→ * Format agents table output
    95→ * AC-agent-1: outputs table with columns: ID, Name, Capabilities
    96→ */
    97→function formatAgents(agents: Agent[]): void {
    98→  if (agents.length === 0) {
    99→    console.log(chalk.yellow('No agents defined'));
   100→    return;
   101→  }
   102→
   103→  const table = new Table({
   104→    head: [chalk.bold('ID'), chalk.bold('Name'), chalk.bold('Capabilities')],
   105→    style: {
   106→      head: [],
   107→      border: [],
   108→    },
   109→  });
   110→
   111→  for (const agent of agents) {
   112→    table.push([
   113→      agent.id,
   114→      agent.name,
   115→      agent.capabilities.join(', '),
   116→    ]);
   117→  }
   118→
   119→  console.log(table.toString());
   120→}
   121→
   122→/**
   123→ * Format workflows table output
   124→ * AC-workflow-1: outputs table with columns: ID, Trigger, Steps (count)
   125→ */
   126→function formatWorkflows(workflows: Workflow[]): void {
   127→  if (workflows.length === 0) {
   128→    console.log(chalk.yellow('No workflows defined'));
   129→    return;
   130→  }
   131→
   132→  const table = new Table({
   133→    head: [chalk.bold('ID'), chalk.bold('Trigger'), chalk.bold('Steps')],
   134→    style: {
   135→      head: [],
   136→      border: [],
   137→    },
   138→  });
   139→
   140→  for (const workflow of workflows) {
   141→    table.push([
   142→      workflow.id,
   143→      workflow.trigger,
   144→      workflow.steps.length.toString(),
   145→    ]);
   146→  }
   147→
   148→  console.log(table.toString());
   149→}
   150→
   151→/**
   152→ * Format workflows verbose output
   153→ * AC-workflow-2: outputs each workflow with full step list
   154→ */
   155→function formatWorkflowsVerbose(workflows: Workflow[]): void {
   156→  if (workflows.length === 0) {
   157→    console.log(chalk.yellow('No workflows defined'));
   158→    return;
   159→  }
   160→
   161→  for (const workflow of workflows) {
   162→    console.log(chalk.bold(`${workflow.id} - ${workflow.trigger}`));
   163→    if (workflow.description) {
   164→      console.log(chalk.gray(workflow.description));
   165→    }
   166→    console.log(chalk.gray('─'.repeat(60)));
   167→
   168→    for (const step of workflow.steps) {
   169→      const prefix = {
   170→        check: chalk.yellow('[check]'),
   171→        action: chalk.blue('[action]'),
   172→        decision: chalk.magenta('[decision]'),
   173→      }[step.type];
   174→
   175→      console.log(`${prefix} ${step.content}`);
   176→
   177→      if (step.on_fail) {
   178→        console.log(chalk.gray(`  → on fail: ${step.on_fail}`));
   179→      }
   180→
   181→      if (step.options && step.options.length > 0) {
   182→        for (const option of step.options) {
   183→          console.log(chalk.gray(`  • ${option}`));
   184→        }
   185→      }
   186→    }
   187→
   188→    console.log('');
   189→  }
   190→}
   191→
   192→/**
   193→ * Format conventions table output
   194→ * AC-conv-1: outputs table with columns: Domain, Rules (count), Validation (yes/no)
   195→ */
   196→function formatConventions(conventions: Convention[]): void {
   197→  if (conventions.length === 0) {
   198→    console.log(chalk.yellow('No conventions defined'));
   199→    return;
   200→  }
   201→
   202→  const table = new Table({
   203→    head: [chalk.bold('Domain'), chalk.bold('Rules'), chalk.bold('Validation')],
   204→    style: {
   205→      head: [],
   206→      border: [],
   207→    },
   208→  });
   209→
   210→  for (const convention of conventions) {
   211→    table.push([
   212→      convention.domain,
   213→      convention.rules.length.toString(),
   214→      convention.validation ? 'yes' : 'no',
   215→    ]);
   216→  }
   217→
   218→  console.log(table.toString());
   219→}
   220→
   221→/**
   222→ * Format convention detail output
   223→ * AC-conv-2: outputs full rules list and examples
   224→ */
   225→function formatConventionDetail(convention: Convention): void {
   226→  console.log(chalk.bold(`${convention.domain} Convention`));
   227→  console.log(chalk.gray('─'.repeat(60)));
   228→
   229→  console.log(chalk.bold('\nRules:'));
   230→  for (const rule of convention.rules) {
   231→    console.log(`  • ${rule}`);
   232→  }
   233→
   234→  if (convention.examples && convention.examples.length > 0) {
   235→    console.log(chalk.bold('\nExamples:'));
   236→    for (const example of convention.examples) {
   237→      console.log(chalk.green(`  ✓ ${example.good}`));
   238→      console.log(chalk.red(`  ✗ ${example.bad}`));
   239→    }
   240→  }
   241→
   242→  if (convention.validation) {
   243→    console.log(chalk.bold('\nValidation:'));
   244→    console.log(`  Type: ${convention.validation.type}`);
   245→    if (convention.validation.pattern) {
   246→      console.log(`  Pattern: ${convention.validation.pattern}`);
   247→    }
   248→    if (convention.validation.message) {
   249→      console.log(`  Message: ${convention.validation.message}`);
   250→    }
   251→  }
   252→
   253→  console.log('');
   254→}
   255→
   256→/**
   257→ * Format observations table output
   258→ * AC-obs-2: outputs table with columns: ID, Type, Workflow, Created, Content (truncated)
   259→ */
   260→function formatObservations(observations: Observation[], showResolved: boolean): void {
   261→  const filtered = showResolved ? observations : observations.filter(o => !o.resolved);
   262→
   263→  if (filtered.length === 0) {
   264→    console.log(chalk.yellow(showResolved ? 'No observations found' : 'No unresolved observations'));
   265→    return;
   266→  }
   267→
   268→  const table = new Table({
   269→    head: [
   270→      chalk.bold('ID'),
   271→      chalk.bold('Type'),
   272→      chalk.bold('Workflow'),
   273→      chalk.bold('Created'),
   274→      chalk.bold('Content'),
   275→    ],
   276→    style: {
   277→      head: [],
   278→      border: [],
   279→    },
   280→    colWidths: [10, 10, 20, 12, 50],
   281→    wordWrap: true,
   282→  });
   283→
   284→  for (const obs of filtered) {
   285→    const id = obs._ulid.substring(0, 8);
   286→    const workflow = obs.workflow_ref || '-';
   287→    const created = new Date(obs.created_at).toISOString().split('T')[0];
   288→    const content = obs.content.length > 47 ? obs.content.substring(0, 47) + '...' : obs.content;
   289→
   290→    table.push([id, obs.type, workflow, created, content]);
   291→  }
   292→
   293→  console.log(table.toString());
   294→}
   295→
   296→/**
   297→ * Register meta commands
   298→ */
   299→export function registerMetaCommands(program: Command): void {
   300→  const meta = program
   301→    .command('meta')
   302→    .description('Meta-spec commands (agents, workflows, conventions, observations)');
   303→
   304→  // AC-meta-manifest-1: kspec meta show outputs summary with counts
   305→  meta
   306→    .command('show')
   307→    .description('Display meta-spec summary')
   308→    .action(async () => {
   309→      try {
   310→        const ctx = await initContext();
   311→
   312→        if (!ctx.manifestPath) {
   313→          error(errors.project.noKspecProject);
   314→          process.exit(1);
   315→        }
   316→
   317→        const metaCtx = await loadMetaContext(ctx);
   318→        const stats = getMetaStats(metaCtx);
   319→
   320→        output(
   321→          {
   322→            manifest: metaCtx.manifestPath,
   323→            stats,
   324→          },
   325→          () => formatMetaShow(metaCtx)
   326→        );
   327→      } catch (err) {
   328→        error(errors.failures.showMeta, err);
   329→        process.exit(1);
   330→      }
   331→    });
   332→
   333→  // AC-agent-1, AC-agent-2: kspec meta agents
   334→  meta
   335→    .command('agents')
   336→    .description('List agents defined in meta-spec')
   337→    .action(async () => {
   338→      try {
   339→        const ctx = await initContext();
   340→
   341→        if (!ctx.manifestPath) {
   342→          error(errors.project.noKspecProject);
   343→          process.exit(1);
   344→        }
   345→
   346→        const metaCtx = await loadMetaContext(ctx);
   347→        const agents = metaCtx.manifest?.agents || [];
   348→
   349→        // AC-agent-2: JSON output includes full agent details
   350→        output(
   351→          agents.map((agent) => ({
   352→            id: agent.id,
   353→            name: agent.name,
   354→            description: agent.description,
   355→            capabilities: agent.capabilities,
   356→            tools: agent.tools,
   357→            session_protocol: agent.session_protocol,
   358→            conventions: agent.conventions,
   359→          })),
   360→          // AC-agent-1: Table output with ID, Name, Capabilities
   361→          () => formatAgents(agents)
   362→        );
   363→      } catch (err) {
   364→        error(errors.failures.listAgents, err);
   365→        process.exit(1);
   366→      }
   367→    });
   368→
   369→  // AC-workflow-1, AC-workflow-2, AC-workflow-4: kspec meta workflows
   370→  meta
   371→    .command('workflows')
   372→    .description('List workflows defined in meta-spec')
   373→    .option('--verbose', 'Show full workflow details with all steps')
   374→    .action(async (options) => {
   375→      try {
   376→        const ctx = await initContext();
   377→
   378→        if (!ctx.manifestPath) {
   379→          error(errors.project.noKspecProject);
   380→          process.exit(1);
   381→        }
   382→
   383→        const metaCtx = await loadMetaContext(ctx);
   384→        const workflows = metaCtx.manifest?.workflows || [];
   385→
   386→        // AC-workflow-4: JSON output includes full workflow details
   387→        output(
   388→          workflows.map((workflow) => ({
   389→            id: workflow.id,
   390→            trigger: workflow.trigger,
   391→            description: workflow.description,
   392→            steps: workflow.steps,
   393→          })),
   394→          // AC-workflow-1 (table) or AC-workflow-2 (verbose)
   395→          () => {
   396→            if (options.verbose) {
   397→              formatWorkflowsVerbose(workflows);
   398→            } else {
   399→              formatWorkflows(workflows);
   400→            }
   401→          }
   402→        );
   403→      } catch (err) {
   404→        error(errors.failures.listWorkflows, err);
   405→        process.exit(1);
   406→      }
   407→    });
   408→
   409→  // AC-conv-1, AC-conv-2, AC-conv-5: kspec meta conventions
   410→  meta
   411→    .command('conventions')
   412→    .description('List conventions defined in meta-spec')
   413→    .option('--domain <domain>', 'Filter by specific domain')
   414→    .action(async (options) => {
   415→      try {
   416→        const ctx = await initContext();
   417→
   418→        if (!ctx.manifestPath) {
   419→          error(errors.project.noKspecProject);
   420→          process.exit(1);
   421→        }
   422→
   423→        const metaCtx = await loadMetaContext(ctx);
   424→        const conventions = metaCtx.manifest?.conventions || [];
   425→
   426→        // AC-conv-2: Filter by domain if specified
   427→        const filtered = options.domain
   428→          ? conventions.filter((c) => c.domain === options.domain)
   429→          : conventions;
   430→
   431→        // AC-conv-5: JSON output includes full convention details
   432→        output(
   433→          filtered.map((convention) => ({
   434→            domain: convention.domain,
   435→            rules: convention.rules,
   436→            examples: convention.examples,
   437→            validation: convention.validation,
   438→          })),
   439→          // AC-conv-1 (table) or AC-conv-2 (detail for single domain)
   440→          () => {
   441→            if (options.domain && filtered.length === 1) {
   442→              formatConventionDetail(filtered[0]);
   443→            } else {
   444→              formatConventions(filtered);
   445→            }
   446→          }
   447→        );
   448→      } catch (err) {
   449→        error(errors.failures.listConventions, err);
   450→        process.exit(1);
   451→      }
   452→    });
   453→
   454→  // meta-get-cmd: kspec meta get <ref>
   455→  meta
   456→    .command('get <ref>')
   457→    .description('Get a meta item by reference (agent, workflow, convention, or observation)')
   458→    .action(async (ref: string) => {
   459→      try {
   460→        const ctx = await initContext();
   461→
   462→        if (!ctx.manifestPath) {
   463→          error(errors.project.noKspecProject);
   464→          process.exit(1);
   465→        }
   466→
   467→        const metaCtx = await loadMetaContext(ctx);
   468→
   469→        // Normalize reference
   470→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   471→
   472→        // Search in all meta item types
   473→        const agents = metaCtx.manifest?.agents || [];
   474→        const workflows = metaCtx.manifest?.workflows || [];
   475→        const conventions = metaCtx.manifest?.conventions || [];
   476→        const observations = metaCtx.manifest?.observations || [];
   477→
   478→        // Try to find by ID or ULID prefix
   479→        let found: any = null;
   480→        let itemType: string = '';
   481→
   482→        // Check agents (by id or ULID)
   483→        const agent = agents.find((a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef));
   484→        if (agent) {
   485→          found = agent;
   486→          itemType = 'agent';
   487→        }
   488→
   489→        // Check workflows (by id or ULID)
   490→        if (!found) {
   491→          const workflow = workflows.find((w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef));
   492→          if (workflow) {
   493→            found = workflow;
   494→            itemType = 'workflow';
   495→          }
   496→        }
   497→
   498→        // Check conventions (by domain or ULID)
   499→        if (!found) {
   500→          const convention = conventions.find((c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef));
   501→          if (convention) {
   502→            found = convention;
   503→            itemType = 'convention';
   504→          }
   505→        }
   506→
   507→        // Check observations (by ULID)
   508→        if (!found) {
   509→          const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   510→          if (observation) {
   511→            found = observation;
   512→            itemType = 'observation';
   513→          }
   514→        }
   515→
   516→        if (!found) {
   517→          error(errors.reference.metaNotFound(ref));
   518→          process.exit(1);
   519→        }
   520→
   521→        // Output the item
   522→        output(found, () => {
   523→          console.log(chalk.bold(`${itemType.charAt(0).toUpperCase() + itemType.slice(1)}: ${ref}`));
   524→          console.log(chalk.gray('─'.repeat(60)));
   525→          console.log(JSON.stringify(found, null, 2));
   526→        });
   527→      } catch (err) {
   528→        error(errors.failures.getMetaItem, err);
   529→        process.exit(1);
   530→      }
   531→    });
   532→
   533→  // meta-list-cmd: kspec meta list
   534→  meta
   535→    .command('list')
   536→    .description('List all meta items')
   537→    .option('--type <type>', 'Filter by type (agent, workflow, convention, observation)')
   538→    .action(async (options) => {
   539→      try {
   540→        const ctx = await initContext();
   541→
   542→        if (!ctx.manifestPath) {
   543→          error(errors.project.noKspecProject);
   544→          process.exit(1);
   545→        }
   546→
   547→        const metaCtx = await loadMetaContext(ctx);
   548→
   549→        // Collect all meta items with type information
   550→        interface MetaListItem {
   551→          id: string;
   552→          type: string;
   553→          context: string;
   554→          ulid: string;
   555→        }
   556→
   557→        const items: MetaListItem[] = [];
   558→
   559→        // Add agents
   560→        if (!options.type || options.type === 'agent') {
   561→          for (const agent of metaCtx.manifest?.agents || []) {
   562→            items.push({
   563→              id: agent.id,
   564→              type: 'agent',
   565→              context: agent.name,
   566→              ulid: agent._ulid,
   567→            });
   568→          }
   569→        }
   570→
   571→        // Add workflows
   572→        if (!options.type || options.type === 'workflow') {
   573→          for (const workflow of metaCtx.manifest?.workflows || []) {
   574→            items.push({
   575→              id: workflow.id,
   576→              type: 'workflow',
   577→              context: workflow.trigger,
   578→              ulid: workflow._ulid,
   579→            });
   580→          }
   581→        }
   582→
   583→        // Add conventions
   584→        if (!options.type || options.type === 'convention') {
   585→          for (const convention of metaCtx.manifest?.conventions || []) {
   586→            items.push({
   587→              id: convention.domain,
   588→              type: 'convention',
   589→              context: `${convention.rules.length} rules`,
   590→              ulid: convention._ulid,
   591→            });
   592→          }
   593→        }
   594→
   595→        // Add observations
   596→        if (!options.type || options.type === 'observation') {
   597→          for (const observation of metaCtx.manifest?.observations || []) {
   598→            const ulidPrefix = observation._ulid.substring(0, 8);
   599→            items.push({
   600→              id: ulidPrefix,
   601→              type: 'observation',
   602→              context: `${observation.type} ${observation.resolved ? '(resolved)' : ''}`,
   603→              ulid: observation._ulid,
   604→            });
   605→          }
   606→        }
   607→
   608→        // Output
   609→        output(items, () => {
   610→          if (items.length === 0) {
   611→            console.log(chalk.yellow('No meta items found'));
   612→            return;
   613→          }
   614→
   615→          const table = new Table({
   616→            head: [chalk.bold('ID'), chalk.bold('Type'), chalk.bold('Context')],
   617→            style: {
   618→              head: [],
   619→              border: [],
   620→            },
   621→          });
   622→
   623→          for (const item of items) {
   624→            table.push([item.id, item.type, item.context]);
   625→          }
   626→
   627→          console.log(table.toString());
   628→        });
   629→      } catch (err) {
   630→        error(errors.failures.listMetaItems, err);
   631→        process.exit(1);
   632→      }
   633→    });
   634→
   635→  // AC-obs-1: kspec meta observe <type> <content>
   636→  meta
   637→    .command('observe <type> <content>')
   638→    .description('Create an observation (friction, success, question, idea)')
   639→    .option('--workflow <ref>', 'Reference to workflow this observation relates to')
   640→    .option('--author <author>', 'Author of the observation')
   641→    .action(async (type: string, content: string, options) => {
   642→      try {
   643→        const ctx = await initContext();
   644→
   645→        if (!ctx.manifestPath) {
   646→          error(errors.project.noKspecProject);
   647→          process.exit(1);
   648→        }
   649→
   650→        // Validate observation type
   651→        const validTypes: ObservationType[] = ['friction', 'success', 'question', 'idea'];
   652→        if (!validTypes.includes(type as ObservationType)) {
   653→          error(errors.validation.invalidObservationType(type));
   654→          console.log(`Valid types: ${validTypes.join(', ')}`);
   655→          process.exit(1);
   656→        }
   657→
   658→        // Create observation
   659→        const observation = createObservation(type as ObservationType, content, {
   660→          workflow_ref: options.workflow,
   661→          author: options.author,
   662→        });
   663→
   664→        // Save to manifest
   665→        await saveObservation(ctx, observation);
   666→
   667→        // AC-obs-1: outputs "OK Created observation: <ULID-prefix>"
   668→        success(`Created observation: ${observation._ulid.substring(0, 8)}`);
   669→      } catch (err) {
   670→        error(errors.failures.createObservation, err);
   671→        process.exit(1);
   672→      }
   673→    });
   674→
   675→  // AC-obs-2, AC-obs-5: kspec meta observations
   676→  meta
   677→    .command('observations')
   678→    .description('List observations (shows unresolved by default)')
   679→    .option('--all', 'Include resolved observations')
   680→    .action(async (options) => {
   681→      try {
   682→        const ctx = await initContext();
   683→
   684→        if (!ctx.manifestPath) {
   685→          error(errors.project.noKspecProject);
   686→          process.exit(1);
   687→        }
   688→
   689→        const metaCtx = await loadMetaContext(ctx);
   690→        const observations = metaCtx.observations || [];
   691→
   692→        // AC-obs-5: JSON output includes full observation objects
   693→        output(
   694→          observations.map((obs) => ({
   695→            _ulid: obs._ulid,
   696→            type: obs.type,
   697→            content: obs.content,
   698→            workflow_ref: obs.workflow_ref ?? null,
   699→            created_at: obs.created_at,
   700→            author: obs.author ?? null,
   701→            resolved: obs.resolved,
   702→            resolution: obs.resolution ?? null,
   703→            resolved_at: obs.resolved_at ?? null,
   704→            resolved_by: obs.resolved_by ?? null,
   705→            promoted_to: obs.promoted_to ?? null,
   706→          })),
   707→          // AC-obs-2: Table output with ID, Type, Workflow, Created, Content
   708→          () => formatObservations(observations, options.all)
   709→        );
   710→      } catch (err) {
   711→        error(errors.failures.listObservations, err);
   712→        process.exit(1);
   713→      }
   714→    });
   715→
   716→  // AC-obs-3, AC-obs-6, AC-obs-8: kspec meta promote
   717→  meta
   718→    .command('promote <ref>')
   719→    .description('Promote observation to a task')
   720→    .requiredOption('--title <title>', 'Task title')
   721→    .option('--priority <priority>', 'Task priority (1-3)', '2')
   722→    .option('--force', 'Force promotion even if observation is resolved')
   723→    .action(async (ref: string, options) => {
   724→      try {
   725→        const ctx = await initContext();
   726→
   727→        if (!ctx.manifestPath) {
   728→          error(errors.project.noKspecProject);
   729→          process.exit(1);
   730→        }
   731→
   732→        const metaCtx = await loadMetaContext(ctx);
   733→        const observations = metaCtx.manifest?.observations || [];
   734→
   735→        // Find observation
   736→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   737→        const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   738→
   739→        if (!observation) {
   740→          error(errors.reference.observationNotFound(ref));
   741→          process.exit(1);
   742→        }
   743→
   744→        // AC-obs-6: Check if already promoted
   745→        if (observation.promoted_to) {
   746→          error(errors.conflict.observationAlreadyPromoted(observation.promoted_to));
   747→          process.exit(1);
   748→        }
   749→
   750→        // AC-obs-8: Check if resolved
   751→        if (observation.resolved && !options.force) {
   752→          error(errors.operation.cannotPromoteResolved);
   753→          process.exit(1);
   754→        }
   755→
   756→        // Create task directly using the API
   757→        const task = createTask({
   758→          title: options.title,
   759→          priority: Number.parseInt(options.priority, 10),
   760→          meta_ref: observation.workflow_ref,
   761→        });
   762→
   763→        // Save task
   764→        await saveTask(ctx, task);
   765→        const taskRef = `@${task._ulid.substring(0, 8)}`;
   766→
   767→        // Update observation with promoted_to field
   768→        observation.promoted_to = taskRef;
   769→        await saveObservation(ctx, observation);
   770→
   771→        // AC-obs-3: outputs "OK Created task: <ULID-prefix>"
   772→        success(`Created task: ${taskRef.substring(0, 9)}`);
   773→      } catch (err) {
   774→        error(errors.failures.promoteObservation, err);
   775→        process.exit(1);
   776→      }
   777→    });
   778→
   779→  // AC-obs-4, AC-obs-7, AC-obs-9: kspec meta resolve
   780→  meta
   781→    .command('resolve <ref> [resolution]')
   782→    .description('Resolve an observation')
   783→    .action(async (ref: string, resolution: string | undefined) => {
   784→      try {
   785→        const ctx = await initContext();
   786→
   787→        if (!ctx.manifestPath) {
   788→          error(errors.project.noKspecProject);
   789→          process.exit(1);
   790→        }
   791→
   792→        const metaCtx = await loadMetaContext(ctx);
   793→        const observations = metaCtx.manifest?.observations || [];
   794→
   795→        // Find observation
   796→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   797→        const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   798→
   799→        if (!observation) {
   800→          error(errors.reference.observationNotFound(ref));
   801→          process.exit(1);
   802→        }
   803→
   804→        // AC-obs-7: Check if already resolved
   805→        if (observation.resolved) {
   806→          const resolvedDate = new Date(observation.resolved_at!).toISOString().split('T')[0];
   807→          const resolutionText = observation.resolution || '';
   808→          const truncated = resolutionText.length > 50
   809→            ? resolutionText.substring(0, 50) + '...'
   810→            : resolutionText;
   811→          error(errors.conflict.observationAlreadyResolved(resolvedDate, truncated));
   812→          process.exit(1);
   813→        }
   814→
   815→        // AC-obs-9: Auto-populate resolution from task completion if promoted
   816→        let finalResolution = resolution;
   817→        if (!finalResolution && observation.promoted_to) {
   818→          // TODO: Fetch task completion reason from promoted task
   819→          // For now, just use a placeholder
   820→          finalResolution = `Promoted to task ${observation.promoted_to}`;
   821→        }
   822→
   823→        if (!finalResolution) {
   824→          error(errors.validation.resolutionRequired);
   825→          process.exit(1);
   826→        }
   827→
   828→        // AC-obs-4: Update observation
   829→        observation.resolved = true;
   830→        observation.resolution = finalResolution;
   831→        observation.resolved_at = new Date().toISOString();
   832→        observation.resolved_by = observation.author; // Use same author
   833→
   834→        await saveObservation(ctx, observation);
   835→
   836→        // AC-obs-4: outputs "OK Resolved: <ULID-prefix>"
   837→        success(`Resolved: ${observation._ulid.substring(0, 8)}`);
   838→      } catch (err) {
   839→        error(errors.failures.resolveObservation, err);
   840→        process.exit(1);
   841→      }
   842→    });
   843→
   844→  // Meta add command - create new meta items
   845→  meta
   846→    .command('add <type>')
   847→    .description('Create a new meta item (agent, workflow, or convention)')
   848→    .option('--id <id>', 'Semantic ID (required for agents and workflows)')
   849→    .option('--domain <domain>', 'Domain (required for conventions)')
   850→    .option('--name <name>', 'Name (for agents)')
   851→    .option('--trigger <trigger>', 'Trigger (for workflows)')
   852→    .option('--description <desc>', 'Description')
   853→    .option('--capability <cap...>', 'Capabilities (for agents)')
   854→    .option('--tool <tool...>', 'Tools (for agents)')
   855→    .option('--convention <conv...>', 'Convention references (for agents)')
   856→    .option('--rule <rule...>', 'Rules (for conventions)')
   857→    .action(async (type: string, options) => {
   858→      try {
   859→        const ctx = await initContext();
   860→
   861→        // Validate type
   862→        const validTypes = ['agent', 'workflow', 'convention'];
   863→        if (!validTypes.includes(type)) {
   864→          error(errors.validation.invalidType(type, validTypes));
   865→          process.exit(1);
   866→        }
   867→
   868→        // Generate ULID
   869→        const itemUlid = ulid();
   870→
   871→        // Create the item based on type
   872→        let item: Agent | Workflow | Convention;
   873→
   874→        if (type === 'agent') {
   875→          // Validate required fields
   876→          if (!options.id) {
   877→            error(errors.validation.agentRequiresId);
   878→            process.exit(1);
   879→          }
   880→          if (!options.name) {
   881→            error(errors.validation.agentRequiresName);
   882→            process.exit(1);
   883→          }
   884→
   885→          item = {
   886→            _ulid: itemUlid,
   887→            id: options.id,
   888→            name: options.name,
   889→            description: options.description || '',
   890→            capabilities: options.capability || [],
   891→            tools: options.tool || [],
   892→            conventions: options.convention || [],
   893→          };
   894→        } else if (type === 'workflow') {
   895→          // Validate required fields
   896→          if (!options.id) {
   897→            error(errors.validation.workflowRequiresId);
   898→            process.exit(1);
   899→          }
   900→          if (!options.trigger) {
   901→            error(errors.validation.workflowRequiresTrigger);
   902→            process.exit(1);
   903→          }
   904→
   905→          item = {
   906→            _ulid: itemUlid,
   907→            id: options.id,
   908→            trigger: options.trigger,
   909→            description: options.description || '',
   910→            steps: [],
   911→          };
   912→        } else {
   913→          // convention
   914→          if (!options.domain) {
   915→            error(errors.validation.conventionRequiresDomain);
   916→            process.exit(1);
   917→          }
   918→
   919→          item = {
   920→            _ulid: itemUlid,
   921→            domain: options.domain,
   922→            rules: options.rule || [],
   923→            examples: [],
   924→          };
   925→        }
   926→
   927→        // Save the item
   928→        await saveMetaItem(ctx, item, type as 'agent' | 'workflow' | 'convention');
   929→
   930→        if (isJsonMode()) {
   931→          // In JSON mode, output the item data directly
   932→          console.log(JSON.stringify(item, null, 2));
   933→        } else {
   934→          const idOrDomain = 'id' in item ? item.id : 'domain' in item ? item.domain : itemUlid;
   935→          success(`Created ${type}: ${idOrDomain} (@${itemUlid.substring(0, 8)})`);
   936→        }
   937→      } catch (err) {
   938→        error(errors.failures.createMeta(type), err);
   939→        process.exit(1);
   940→      }
   941→    });
   942→
   943→  // Meta set command - update existing meta items
   944→  meta
   945→    .command('set <ref>')
   946→    .description('Update an existing meta item')
   947→    .option('--name <name>', 'Update name (for agents)')
   948→    .option('--description <desc>', 'Update description')
   949→    .option('--trigger <trigger>', 'Update trigger (for workflows)')
   950→    .option('--add-capability <cap>', 'Add capability (for agents)')
   951→    .option('--add-tool <tool>', 'Add tool (for agents)')
   952→    .option('--add-convention <conv>', 'Add convention reference (for agents)')
   953→    .option('--add-rule <rule>', 'Add rule (for conventions)')
   954→    .action(async (ref: string, options) => {
   955→      try {
   956→        const ctx = await initContext();
   957→        const metaCtx = await loadMetaContext(ctx);
   958→
   959→        // Find the item using unified lookup
   960→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   961→        let found: Agent | Workflow | Convention | null = null;
   962→        let itemType: 'agent' | 'workflow' | 'convention' | null = null;
   963→
   964→        // Search in agents
   965→        const agents = metaCtx.manifest?.agents || [];
   966→        const agent = agents.find(
   967→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
   968→        );
   969→        if (agent) {
   970→          found = agent;
   971→          itemType = 'agent';
   972→        }
   973→
   974→        // Search in workflows
   975→        if (!found) {
   976→          const workflows = metaCtx.manifest?.workflows || [];
   977→          const workflow = workflows.find(
   978→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
   979→          );
   980→          if (workflow) {
   981→            found = workflow;
   982→            itemType = 'workflow';
   983→          }
   984→        }
   985→
   986→        // Search in conventions
   987→        if (!found) {
   988→          const conventions = metaCtx.manifest?.conventions || [];
   989→          const convention = conventions.find(
   990→            (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
   991→          );
   992→          if (convention) {
   993→            found = convention;
   994→            itemType = 'convention';
   995→          }
   996→        }
   997→
   998→        if (!found || !itemType) {
   999→          error(errors.reference.metaNotFound(ref));
  1000→          process.exit(1);
  1001→        }
  1002→
  1003→        // Update fields based on type
  1004→        if (itemType === 'agent') {
  1005→          const item = found as Agent;
  1006→          if (options.name) item.name = options.name;
  1007→          if (options.description !== undefined) item.description = options.description;
  1008→          if (options.addCapability) {
  1009→            if (!item.capabilities.includes(options.addCapability)) {
  1010→              item.capabilities.push(options.addCapability);
  1011→            }
  1012→          }
  1013→          if (options.addTool) {
  1014→            if (!item.tools.includes(options.addTool)) {
  1015→              item.tools.push(options.addTool);
  1016→            }
  1017→          }
  1018→          if (options.addConvention) {
  1019→            if (!item.conventions.includes(options.addConvention)) {
  1020→              item.conventions.push(options.addConvention);
  1021→            }
  1022→          }
  1023→        } else if (itemType === 'workflow') {
  1024→          const item = found as Workflow;
  1025→          if (options.trigger) item.trigger = options.trigger;
  1026→          if (options.description !== undefined) item.description = options.description;
  1027→        } else {
  1028→          const item = found as Convention;
  1029→          // Convention doesn't have a description field
  1030→          if (options.addRule) {
  1031→            if (!item.rules.includes(options.addRule)) {
  1032→              item.rules.push(options.addRule);
  1033→            }
  1034→          }
  1035→        }
  1036→
  1037→        // Save the updated item
  1038→        await saveMetaItem(ctx, found, itemType);
  1039→
  1040→        if (isJsonMode()) {
  1041→          // In JSON mode, output the item data directly
  1042→          console.log(JSON.stringify(found, null, 2));
  1043→        } else {
  1044→          const idOrDomain =
  1045→            itemType === 'agent'
  1046→              ? (found as Agent).id
  1047→              : itemType === 'workflow'
  1048→                ? (found as Workflow).id
  1049→                : (found as Convention).domain;
  1050→          success(`Updated ${itemType}: ${idOrDomain}`);
  1051→        }
  1052→      } catch (err) {
  1053→        error(errors.failures.updateMetaItem, err);
  1054→        process.exit(1);
  1055→      }
  1056→    });
  1057→
  1058→  // Meta delete command - delete meta items
  1059→  meta
  1060→    .command('delete <ref>')
  1061→    .description('Delete a meta item')
  1062→    .option('--confirm', 'Skip confirmation prompt')
  1063→    .action(async (ref: string, options) => {
  1064→      try {
  1065→        const ctx = await initContext();
  1066→        const metaCtx = await loadMetaContext(ctx);
  1067→
  1068→        // Find the item to determine type
  1069→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
  1070→        let itemType: 'agent' | 'workflow' | 'convention' | 'observation' | null = null;
  1071→        let itemUlid: string | null = null;
  1072→        let itemLabel: string | null = null;
  1073→
  1074→        // Search in agents
  1075→        const agents = metaCtx.manifest?.agents || [];
  1076→        const agent = agents.find(
  1077→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
  1078→        );
  1079→        if (agent) {
  1080→          itemType = 'agent';
  1081→          itemUlid = agent._ulid;
  1082→          itemLabel = `agent ${agent.id}`;
  1083→        }
  1084→
  1085→        // Search in workflows
  1086→        if (!itemType) {
  1087→          const workflows = metaCtx.manifest?.workflows || [];
  1088→          const workflow = workflows.find(
  1089→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
  1090→          );
  1091→          if (workflow) {
  1092→            itemType = 'workflow';
  1093→            itemUlid = workflow._ulid;
  1094→            itemLabel = `workflow ${workflow.id}`;
  1095→          }
  1096→        }
  1097→
  1098→        // Search in conventions
  1099→        if (!itemType) {
  1100→          const conventions = metaCtx.manifest?.conventions || [];
  1101→          const convention = conventions.find(
  1102→            (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
  1103→          );
  1104→          if (convention) {
  1105→            itemType = 'convention';
  1106→            itemUlid = convention._ulid;
  1107→            itemLabel = `convention ${convention.domain}`;
  1108→          }
  1109→        }
  1110→
  1111→        // Search in observations
  1112→        if (!itemType) {
  1113→          const observations = metaCtx.manifest?.observations || [];
  1114→          const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
  1115→          if (observation) {
  1116→            itemType = 'observation';
  1117→            itemUlid = observation._ulid;
  1118→            itemLabel = `observation ${observation._ulid.substring(0, 8)}`;
  1119→          }
  1120→        }
  1121→
  1122→        if (!itemType || !itemUlid || !itemLabel) {
  1123→          error(errors.reference.metaNotFound(ref));
  1124→          process.exit(1);
  1125→        }
  1126→
  1127→        // Check for dangling references (unless --confirm is used to override)
  1128→        if (!options.confirm) {
  1129→          // Check tasks with meta_ref
  1130→          const tasks = await loadAllTasks(ctx);
  1131→          const referencingTasks = tasks.filter((t) => {
  1132→            if (!t.meta_ref) return false;
  1133→            // Resolve the task's meta_ref to a ULID
  1134→            const taskMetaRef = resolveMetaRefToUlid(t.meta_ref, metaCtx);
  1135→            // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1136→            return taskMetaRef && taskMetaRef.ulid === itemUlid;
  1137→          });
  1138→
  1139→          if (referencingTasks.length > 0) {
  1140→            const taskRefs = referencingTasks
  1141→              .map((t) => `@${t.slugs?.[0] || t._ulid.substring(0, 8)}`)
  1142→              .join(', ');
  1143→            error(errors.operation.cannotDeleteReferencedByTasks(itemLabel, referencingTasks.length, taskRefs));
  1144→            process.exit(1);
  1145→          }
  1146→
  1147→          // Check observations with workflow_ref (only for workflows)
  1148→          if (itemType === 'workflow') {
  1149→            const observations = metaCtx.manifest?.observations || [];
  1150→            const referencingObservations = observations.filter((o) => {
  1151→              if (!o.workflow_ref) return false;
  1152→              // Resolve the observation's workflow_ref to a ULID
  1153→              const obsWorkflowRef = resolveMetaRefToUlid(o.workflow_ref, metaCtx);
  1154→              // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1155→              return obsWorkflowRef && obsWorkflowRef.ulid === itemUlid;
  1156→            });
  1157→
  1158→            if (referencingObservations.length > 0) {
  1159→              const obsRefs = referencingObservations
  1160→                .map((o) => `@${o._ulid.substring(0, 8)}`)
  1161→                .join(', ');
  1162→              error(errors.operation.cannotDeleteReferencedByObservations(itemLabel, referencingObservations.length, obsRefs));
  1163→              process.exit(1);
  1164→            }
  1165→          }
  1166→
  1167→          // Show confirmation prompt even if no references found
  1168→          error(errors.operation.confirmRequired(itemLabel));
  1169→          process.exit(1);
  1170→        }
  1171→
  1172→        // Delete the item
  1173→        const deleted = await deleteMetaItem(ctx, itemUlid, itemType);
  1174→
  1175→        if (!deleted) {
  1176→          error(errors.operation.deleteItemFailed(itemLabel));
  1177→          process.exit(1);
  1178→        }
  1179→
  1180→        success(`Deleted ${itemLabel}`);
  1181→      } catch (err) {
  1182→        error(errors.failures.deleteMetaItem, err);
  1183→        process.exit(1);
  1184→      }
  1185→    });
  1186→}
  1187→

