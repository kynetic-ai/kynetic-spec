  1125→      // Create a task that references by semantic ID
  1126→      kspec('task add --title "Test task" --meta-ref @ulid-test-agent', tempDir);
  1127→
  1128→      // Try to delete using ULID prefix - should still detect the reference
  1129→      try {
  1130→        kspec(`meta delete ${ulidPrefix}`, tempDir);
  1131→        expect.fail('Should have detected reference');
  1132→      } catch (e: any) {
  1133→        expect(e.message).toContain('Referenced by');
  1134→        expect(e.message).toContain('task(s)');
  1135→      }
  1136→
  1137→      // Verify agent still exists
