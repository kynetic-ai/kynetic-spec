  1062→
  1063→    it('should prevent deletion of workflow referenced by observation', () => {
  1064→      // Create a workflow
  1065→      kspec(
  1066→        'meta add workflow --id ref-workflow --trigger "test trigger" --description "Test workflow"',
  1067→        tempDir
  1068→      );
  1069→
  1070→      // Create an observation that references this workflow
  1071→      kspec('meta observe friction "Test friction" --workflow @ref-workflow', tempDir);
  1072→
  1073→      // Try to delete the workflow without --confirm
  1074→      try {
  1075→        kspec('meta delete @ref-workflow', tempDir);
  1076→        expect.fail('Should have prevented deletion');
  1077→      } catch (e: any) {
  1078→        expect(e.message).toContain('Referenced by');
  1079→        expect(e.message).toContain('observation(s)');
  1080→        expect(e.message).toContain('Use --confirm to override');
  1081→      }
