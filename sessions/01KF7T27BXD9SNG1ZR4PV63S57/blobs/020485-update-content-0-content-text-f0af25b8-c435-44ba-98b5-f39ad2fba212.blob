   973→        expect(e.message).toContain('not found');
   974→      }
   975→    });
   976→
   977→    it('should delete a workflow', () => {
   978→      kspec('meta add workflow --id delete-wf --trigger "delete-trigger"', tempDir);
   979→
   980→      const output = kspec('meta delete @delete-wf --confirm', tempDir);
   981→      expect(output).toContain('Deleted workflow delete-wf');
   982→    });
   983→
   984→    it('should delete a convention', () => {
   985→      kspec('meta add convention --domain delete-conv', tempDir);
   986→
   987→      const output = kspec('meta delete @delete-conv --confirm', tempDir);
   988→      expect(output).toContain('Deleted convention delete-conv');
   989→    });
   990→
   991→    it('should work with ULID prefix references', () => {
   992→      const output = kspec('meta add agent --id ulid-delete --name "ULID Delete"', tempDir);
   993→      const match = output.match(/@(\w{8})/);
   994→      const ulidPrefix = match![1];
   995→
   996→      kspec(`meta delete @${ulidPrefix} --confirm`, tempDir);
   997→
   998→      try {
   999→        kspec('meta get @ulid-delete', tempDir);
  1000→        expect.fail('Should have thrown error');
  1001→      } catch (e: any) {
  1002→        expect(e.message).toContain('not found');
  1003→      }
  1004→    });
  1005→
  1006→    it('should require --confirm flag', () => {
  1007→      kspec('meta add agent --id confirm-agent --name "Confirm Agent"', tempDir);
  1008→
  1009→      try {
  1010→        kspec('meta delete @confirm-agent', tempDir);
  1011→        expect.fail('Should have thrown error');
  1012→      } catch (e: any) {
  1013→        expect(e.message).toContain('Use --confirm to skip this prompt');
  1014→      }
  1015→
  1016→      // Verify it wasn't deleted
  1017→      const agent = kspecJson<any>('meta get @confirm-agent', tempDir);
  1018→      expect(agent.id).toBe('confirm-agent');
  1019→    });
  1020→
  1021→    it('should fail for non-existent item', () => {
  1022→      try {
  1023→        kspec('meta delete @nonexistent --confirm', tempDir);
  1024→        expect.fail('Should have thrown error');
  1025→      } catch (e: any) {
  1026→        expect(e.message).toContain('Meta item not found');
  1027→      }
  1028→    });
  1029→
  1030→    it('should prevent deletion of agent referenced by task', () => {
  1031→      // Create an agent
  1032→      kspec('meta add agent --id ref-agent --name "Referenced Agent"', tempDir);
  1033→
  1034→      // Create a task that references this agent
  1035→      kspec('task add --title "Test task" --meta-ref @ref-agent', tempDir);
  1036→
  1037→      // Try to delete the agent without --confirm
  1038→      try {
  1039→        kspec('meta delete @ref-agent', tempDir);
  1040→        expect.fail('Should have prevented deletion');
  1041→      } catch (e: any) {
  1042→        expect(e.message).toContain('Referenced by');
  1043→        expect(e.message).toContain('task(s)');
  1044→        expect(e.message).toContain('Use --confirm to override');
  1045→      }
  1046→
  1047→      // Verify agent still exists
  1048→      const agent = kspecJson<any>('meta get @ref-agent', tempDir);
  1049→      expect(agent.id).toBe('ref-agent');
  1050→
  1051→      // Can delete with --confirm flag
  1052→      kspec('meta delete @ref-agent --confirm', tempDir);
  1053→
  1054→      // Verify it's deleted
  1055→      try {
  1056→        kspec('meta get @ref-agent', tempDir);
  1057→        expect.fail('Agent should be deleted');
  1058→      } catch (e: any) {
  1059→        expect(e.message).toContain('Meta item not found');
  1060→      }
