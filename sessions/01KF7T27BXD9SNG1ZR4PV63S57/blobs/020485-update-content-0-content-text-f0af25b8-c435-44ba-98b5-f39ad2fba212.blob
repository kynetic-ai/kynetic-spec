  1109→        expect(e.message).not.toContain('Referenced by');
  1110→      }
  1111→
  1112→      // Delete with --confirm
  1113→      kspec('meta delete @unreferenced-agent --confirm', tempDir);
  1114→    });
  1115→
  1116→    it('should detect references when deleting by ULID prefix', () => {
