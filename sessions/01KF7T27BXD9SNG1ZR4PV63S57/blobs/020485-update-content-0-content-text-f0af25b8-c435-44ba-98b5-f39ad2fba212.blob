   763→describe('Integration: meta mutation commands', () => {
   764→  let tempDir: string;
   765→
   766→  beforeEach(async () => {
   767→    tempDir = await setupTempFixtures();
   768→  });
   769→
   770→  afterEach(async () => {
   771→    await cleanupTempDir(tempDir);
   772→  });
   773→
   774→  describe('meta add', () => {
   775→    it('should create a new agent with required fields', () => {
   776→      const output = kspec(
   777→        'meta add agent --id new-agent --name "New Agent" --description "A new agent"',
   778→        tempDir
   779→      );
   780→
   781→      expect(output).toContain('Created agent: new-agent');
   782→      expect(output).toMatch(/@\w{8}/); // ULID prefix
   783→
   784→      // Verify it was created
   785→      const agent = kspecJson<any>('meta get @new-agent', tempDir);
   786→      expect(agent.id).toBe('new-agent');
   787→      expect(agent.name).toBe('New Agent');
   788→      expect(agent.description).toBe('A new agent');
   789→    });
   790→
   791→    it('should create agent with capabilities and tools', () => {
   792→      kspec(
   793→        'meta add agent --id capable-agent --name "Capable Agent" --capability code --capability test --tool bash --tool git',
   794→        tempDir
   795→      );
   796→
   797→      const agent = kspecJson<any>('meta get @capable-agent', tempDir);
   798→      expect(agent.capabilities).toEqual(['code', 'test']);
   799→      expect(agent.tools).toEqual(['bash', 'git']);
   800→    });
   801→
   802→    it('should create a new workflow with required fields', () => {
   803→      const output = kspec(
   804→        'meta add workflow --id new-workflow --trigger "on-commit" --description "A new workflow"',
   805→        tempDir
   806→      );
   807→
   808→      expect(output).toContain('Created workflow: new-workflow');
   809→
   810→      const workflow = kspecJson<any>('meta get @new-workflow', tempDir);
   811→      expect(workflow.id).toBe('new-workflow');
   812→      expect(workflow.trigger).toBe('on-commit');
   813→      expect(workflow.description).toBe('A new workflow');
   814→      expect(workflow.steps).toEqual([]);
   815→    });
   816→
   817→    it('should create a new convention with rules', () => {
   818→      const output = kspec(
   819→        'meta add convention --domain testing --rule "Write tests first" --rule "Use descriptive names"',
   820→        tempDir
   821→      );
   822→
   823→      expect(output).toContain('Created convention: testing');
   824→
   825→      const convention = kspecJson<any>('meta get @testing', tempDir);
   826→      expect(convention.domain).toBe('testing');
   827→      expect(convention.rules).toEqual(['Write tests first', 'Use descriptive names']);
   828→    });
   829→
   830→    it('should fail when required fields are missing', () => {
   831→      try {
   832→        kspec('meta add agent --name "Agent without ID"', tempDir);
   833→        expect.fail('Should have thrown error');
   834→      } catch (e: any) {
   835→        expect(e.message).toContain('Agent requires --id');
   836→      }
   837→
   838→      try {
   839→        kspec('meta add workflow --id workflow-no-trigger', tempDir);
   840→        expect.fail('Should have thrown error');
   841→      } catch (e: any) {
   842→        expect(e.message).toContain('Workflow requires --trigger');
   843→      }
   844→
   845→      try {
   846→        kspec('meta add convention --rule "Rule without domain"', tempDir);
   847→        expect.fail('Should have thrown error');
   848→      } catch (e: any) {
   849→        expect(e.message).toContain('Convention requires --domain');
   850→      }
   851→    });
   852→
   853→    it('should support JSON output', () => {
   854→      const agent = kspecJson<any>(
   855→        'meta add agent --id json-agent --name "JSON Agent"',
   856→        tempDir
   857→      );
   858→
   859→      expect(agent.id).toBe('json-agent');
   860→      expect(agent.name).toBe('JSON Agent');
   861→      expect(agent._ulid).toMatch(/^[0-7][0-9A-HJKMNP-TV-Z]{25}$/);
   862→    });
   863→  });
   864→
   865→  describe('meta set', () => {
   866→    it('should update agent name and description', () => {
   867→      // Create an agent
   868→      kspec('meta add agent --id update-agent --name "Original Name"', tempDir);
   869→
   870→      // Update it
   871→      const output = kspec(
   872→        'meta set @update-agent --name "Updated Name" --description "New description"',
   873→        tempDir
   874→      );
   875→
   876→      expect(output).toContain('Updated agent: update-agent');
   877→
   878→      const agent = kspecJson<any>('meta get @update-agent', tempDir);
   879→      expect(agent.name).toBe('Updated Name');
   880→      expect(agent.description).toBe('New description');
   881→    });
   882→
   883→    it('should add capabilities and tools to agent', () => {
   884→      kspec('meta add agent --id add-agent --name "Add Agent"', tempDir);
   885→
   886→      kspec('meta set @add-agent --add-capability code', tempDir);
   887→      kspec('meta set @add-agent --add-capability test', tempDir);
   888→      kspec('meta set @add-agent --add-tool bash', tempDir);
   889→
   890→      const agent = kspecJson<any>('meta get @add-agent', tempDir);
   891→      expect(agent.capabilities).toContain('code');
   892→      expect(agent.capabilities).toContain('test');
   893→      expect(agent.tools).toContain('bash');
   894→    });
   895→
   896→    it('should not duplicate capabilities or tools', () => {
   897→      kspec(
   898→        'meta add agent --id dup-agent --name "Dup Agent" --capability code --tool bash',
   899→        tempDir
   900→      );
   901→
   902→      kspec('meta set @dup-agent --add-capability code --add-tool bash', tempDir);
   903→
   904→      const agent = kspecJson<any>('meta get @dup-agent', tempDir);
   905→      expect(agent.capabilities).toEqual(['code']); // Should not duplicate
   906→      expect(agent.tools).toEqual(['bash']);
   907→    });
   908→
   909→    it('should update workflow trigger and description', () => {
   910→      kspec('meta add workflow --id update-wf --trigger "old-trigger"', tempDir);
   911→
   912→      kspec(
   913→        'meta set @update-wf --trigger "new-trigger" --description "Updated workflow"',
   914→        tempDir
   915→      );
   916→
   917→      const workflow = kspecJson<any>('meta get @update-wf', tempDir);
   918→      expect(workflow.trigger).toBe('new-trigger');
   919→      expect(workflow.description).toBe('Updated workflow');
   920→    });
   921→
   922→    it('should add rules to convention', () => {
   923→      kspec('meta add convention --domain update-conv --rule "Rule 1"', tempDir);
   924→
   925→      kspec('meta set @update-conv --add-rule "Rule 2"', tempDir);
   926→
   927→      const convention = kspecJson<any>('meta get @update-conv', tempDir);
   928→      expect(convention.rules).toContain('Rule 1');
   929→      expect(convention.rules).toContain('Rule 2');
   930→    });
   931→
   932→    it('should work with ULID prefix references', () => {
   933→      const output = kspec('meta add agent --id ulid-ref --name "ULID Ref Agent"', tempDir);
   934→      const match = output.match(/@(\w{8})/);
   935→      expect(match).toBeTruthy();
   936→      const ulidPrefix = match![1];
   937→
   938→      kspec(`meta set @${ulidPrefix} --name "Updated via ULID"`, tempDir);
   939→
   940→      const agent = kspecJson<any>('meta get @ulid-ref', tempDir);
   941→      expect(agent.name).toBe('Updated via ULID');
   942→    });
   943→
   944→    it('should support JSON output', () => {
   945→      kspec('meta add agent --id json-update --name "JSON Update"', tempDir);
   946→
   947→      const agent = kspecJson<any>('meta set @json-update --name "JSON Updated"', tempDir);
   948→      expect(agent.name).toBe('JSON Updated');
   949→    });
   950→
   951→    it('should fail for non-existent item', () => {
   952→      try {
   953→        kspec('meta set @nonexistent --name "Should fail"', tempDir);
   954→        expect.fail('Should have thrown error');
   955→      } catch (e: any) {
   956→        expect(e.message).toContain('Meta item not found');
   957→      }
   958→    });
   959→  });
   960→
   961→  describe('meta delete', () => {
   962→    it('should delete an agent', () => {
   963→      kspec('meta add agent --id delete-agent --name "Delete Agent"', tempDir);
   964→
   965→      const output = kspec('meta delete @delete-agent --confirm', tempDir);
   966→      expect(output).toContain('Deleted agent delete-agent');
   967→
   968→      // Verify it's gone
