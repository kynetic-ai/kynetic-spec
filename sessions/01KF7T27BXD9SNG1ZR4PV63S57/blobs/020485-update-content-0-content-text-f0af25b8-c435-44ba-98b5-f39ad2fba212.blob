   234→
   235→  // AC: @workflow-definitions ac-workflow-1
   236→  it('should output table with ID, Trigger, Steps columns', () => {
   237→    const output = kspec('meta workflows', tempDir);
   238→
   239→    // Should contain table headers
   240→    expect(output).toContain('ID');
