```
     1→/**
     2→ * Meta CLI commands for interacting with meta-spec.
     3→ *
     4→ * AC-meta-manifest-1: kspec meta show outputs summary
     5→ * AC-meta-manifest-2: kspec validate includes meta line
     6→ * AC-meta-manifest-3: kspec validate shows meta errors with prefix
     7→ * AC-agent-1: kspec meta agents outputs table
     8→ * AC-agent-2: kspec meta agents --json outputs JSON
     9→ */
    10→
    11→import { Command } from 'commander';
    12→import chalk from 'chalk';
    13→import Table from 'cli-table3';
    14→import { ulid } from 'ulid';
    15→import {
    16→  initContext,
    17→  loadMetaContext,
    18→  getMetaStats,
    19→  createObservation,
    20→  saveObservation,
    21→  saveMetaItem,
    22→  deleteMetaItem,
    23→  createTask,
    24→  saveTask,
    25→  loadAllTasks,
    26→  loadAllItems,
    27→  ReferenceIndex,
    28→  type MetaContext,
    29→  type Agent,
    30→  type Workflow,
    31→  type Convention,
    32→  type Observation,
    33→  type LoadedTask,
    34→} from '../../parser/index.js';
    35→import { type ObservationType } from '../../schema/index.js';
    36→import { output, error, success, isJsonMode } from '../output.js';
    37→import { errors } from '../../strings/errors.js';
    38→import { commitIfShadow } from '../../parser/shadow.js';
    39→
    40→/**
    41→ * Resolve a meta reference to its ULID
    42→ * Handles semantic IDs (agent.id, workflow.id, convention.domain) and ULID prefixes
    43→ */
    44→function resolveMetaRefToUlid(
    45→  ref: string,
    46→  metaCtx: MetaContext
    47→): { ulid: string; type: 'agent' | 'workflow' | 'convention' | 'observation' } | null {
    48→  const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
    49→
    50→  // Check agents
    51→  const agent = (metaCtx.agents || []).find(
    52→    (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
    53→  );
    54→  if (agent) return { ulid: agent._ulid, type: 'agent' };
    55→
    56→  // Check workflows
    57→  const workflow = (metaCtx.workflows || []).find(
    58→    (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
    59→  );
    60→  if (workflow) return { ulid: workflow._ulid, type: 'workflow' };
    61→
    62→  // Check conventions
    63→  const convention = (metaCtx.conventions || []).find(
    64→    (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
    65→  );
    66→  if (convention) return { ulid: convention._ulid, type: 'convention' };
    67→
    68→  // Check observations
    69→  const observation = (metaCtx.observations || []).find((o) =>
    70→    o._ulid.startsWith(normalizedRef)
    71→  );
    72→  if (observation) return { ulid: observation._ulid, type: 'observation' };
    73→
    74→  return null;
    75→}
    76→
    77→/**
    78→ * Format meta show output
    79→ */
    80→function formatMetaShow(meta: MetaContext): void {
    81→  const stats = getMetaStats(meta);
    82→
    83→  if (!meta.manifest) {
    84→    console.log(chalk.yellow('No meta manifest found (kynetic.meta.yaml)'));
    85→    console.log(chalk.gray('Create one to define agents, workflows, conventions, and observations'));
    86→    return;
    87→  }
    88→
    89→  console.log(chalk.bold('Meta-Spec Summary'));
    90→  console.log(chalk.gray('─'.repeat(40)));
    91→  console.log(`Agents:       ${stats.agents}`);
    92→  console.log(`Workflows:    ${stats.workflows}`);
    93→  console.log(`Conventions:  ${stats.conventions}`);
    94→  console.log(`Observations: ${stats.observations} (${stats.unresolvedObservations} unresolved)`);
    95→}
    96→
    97→/**
    98→ * Format agents table output
    99→ * AC-agent-1: outputs table with columns: ID, Name, Capabilities
   100→ */
   101→function formatAgents(agents: Agent[]): void {
   102→  if (agents.length === 0) {
   103→    console.log(chalk.yellow('No agents defined'));
   104→    return;
   105→  }
   106→
   107→  const table = new Table({
   108→    head: [chalk.bold('ID'), chalk.bold('Name'), chalk.bold('Capabilities')],
   109→    style: {
   110→      head: [],
   111→      border: [],
   112→    },
   113→  });
   114→
   115→  for (const agent of agents) {
   116→    table.push([
   117→      agent.id,
   118→      agent.name,
   119→      agent.capabilities.join(', '),
   120→    ]);
   121→  }
   122→
   123→  console.log(table.toString());
   124→}
   125→
   126→/**
   127→ * Format workflows table output
   128→ * AC-workflow-1: outputs table with columns: ID, Trigger, Steps (count)
   129→ */
   130→function formatWorkflows(workflows: Workflow[]): void {
   131→  if (workflows.length === 0) {
   132→    console.log(chalk.yellow('No workflows defined'));
   133→    return;
   134→  }
   135→
   136→  const table = new Table({
   137→    head: [chalk.bold('ID'), chalk.bold('Trigger'), chalk.bold('Steps')],
   138→    style: {
   139→      head: [],
   140→      border: [],
   141→    },
   142→  });
   143→
   144→  for (const workflow of workflows) {
   145→    table.push([
   146→      workflow.id,
   147→      workflow.trigger,
   148→      workflow.steps.length.toString(),
   149→    ]);
   150→  }
   151→
   152→  console.log(table.toString());
   153→}
   154→
   155→/**
   156→ * Format workflows verbose output
   157→ * AC-workflow-2: outputs each workflow with full step list
   158→ */
   159→function formatWorkflowsVerbose(workflows: Workflow[]): void {
   160→  if (workflows.length === 0) {
   161→    console.log(chalk.yellow('No workflows defined'));
   162→    return;
   163→  }
   164→
   165→  for (const workflow of workflows) {
   166→    console.log(chalk.bold(`${workflow.id} - ${workflow.trigger}`));
   167→    if (workflow.description) {
   168→      console.log(chalk.gray(workflow.description));
   169→    }
   170→    console.log(chalk.gray('─'.repeat(60)));
   171→
   172→    for (const step of workflow.steps) {
   173→      const prefix = {
   174→        check: chalk.yellow('[check]'),
   175→        action: chalk.blue('[action]'),
   176→        decision: chalk.magenta('[decision]'),
   177→      }[step.type];
   178→
   179→      console.log(`${prefix} ${step.content}`);
   180→
   181→      if (step.on_fail) {
   182→        console.log(chalk.gray(`  → on fail: ${step.on_fail}`));
   183→      }
   184→
   185→      if (step.options && step.options.length > 0) {
   186→        for (const option of step.options) {
   187→          console.log(chalk.gray(`  • ${option}`));
   188→        }
   189→      }
   190→    }
   191→
   192→    console.log('');
   193→  }
   194→}
   195→
   196→/**
   197→ * Format conventions table output
   198→ * AC-conv-1: outputs table with columns: Domain, Rules (count), Validation (yes/no)
   199→ */
   200→function formatConventions(conventions: Convention[]): void {
   201→  if (conventions.length === 0) {
   202→    console.log(chalk.yellow('No conventions defined'));
   203→    return;
   204→  }
   205→
   206→  const table = new Table({
   207→    head: [chalk.bold('Domain'), chalk.bold('Rules'), chalk.bold('Validation')],
   208→    style: {
   209→      head: [],
   210→      border: [],
   211→    },
   212→  });
   213→
   214→  for (const convention of conventions) {
   215→    table.push([
   216→      convention.domain,
   217→      convention.rules.length.toString(),
   218→      convention.validation ? 'yes' : 'no',
   219→    ]);
   220→  }
   221→
   222→  console.log(table.toString());
   223→}
   224→
   225→/**
   226→ * Format convention detail output
   227→ * AC-conv-2: outputs full rules list and examples
   228→ */
   229→function formatConventionDetail(convention: Convention): void {
   230→  console.log(chalk.bold(`${convention.domain} Convention`));
   231→  console.log(chalk.gray('─'.repeat(60)));
   232→
   233→  console.log(chalk.bold('\nRules:'));
   234→  for (const rule of convention.rules) {
   235→    console.log(`  • ${rule}`);
   236→  }
   237→
   238→  if (convention.examples && convention.examples.length > 0) {
   239→    console.log(chalk.bold('\nExamples:'));
   240→    for (const example of convention.examples) {
   241→      console.log(chalk.green(`  ✓ ${example.good}`));
   242→      console.log(chalk.red(`  ✗ ${example.bad}`));
   243→    }
   244→  }
   245→
   246→  if (convention.validation) {
   247→    console.log(chalk.bold('\nValidation:'));
   248→    console.log(`  Type: ${convention.validation.type}`);
   249→    if (convention.validation.pattern) {
   250→      console.log(`  Pattern: ${convention.validation.pattern}`);
   251→    }
   252→    if (convention.validation.message) {
   253→      console.log(`  Message: ${convention.validation.message}`);
   254→    }
   255→  }
   256→
   257→  console.log('');
   258→}
   259→
   260→/**
   261→ * Format observations table output
   262→ * AC-obs-2: outputs table with columns: ID, Type, Workflow, Created, Content (truncated)
   263→ */
   264→function formatObservations(observations: Observation[], showResolved: boolean): void {
   265→  const filtered = showResolved ? observations : observations.filter(o => !o.resolved);
   266→
   267→  if (filtered.length === 0) {
   268→    console.log(chalk.yellow(showResolved ? 'No observations found' : 'No unresolved observations'));
   269→    return;
   270→  }
   271→
   272→  const table = new Table({
   273→    head: [
   274→      chalk.bold('ID'),
   275→      chalk.bold('Type'),
   276→      chalk.bold('Workflow'),
   277→      chalk.bold('Created'),
   278→      chalk.bold('Content'),
   279→    ],
   280→    style: {
   281→      head: [],
   282→      border: [],
   283→    },
   284→    colWidths: [10, 10, 20, 12, 50],
   285→    wordWrap: true,
   286→  });
   287→
   288→  for (const obs of filtered) {
   289→    const id = obs._ulid.substring(0, 8);
   290→    const workflow = obs.workflow_ref || '-';
   291→    const created = new Date(obs.created_at).toISOString().split('T')[0];
   292→    const content = obs.content.length > 47 ? obs.content.substring(0, 47) + '...' : obs.content;
   293→
   294→    table.push([id, obs.type, workflow, created, content]);
   295→  }
   296→
   297→  console.log(table.toString());
   298→}
   299→
   300→/**
   301→ * Register meta commands
   302→ */
   303→export function registerMetaCommands(program: Command): void {
   304→  const meta = program
   305→    .command('meta')
   306→    .description('Meta-spec commands (agents, workflows, conventions, observations)');
   307→
   308→  // AC-meta-manifest-1: kspec meta show outputs summary with counts
   309→  meta
   310→    .command('show')
   311→    .description('Display meta-spec summary')
   312→    .action(async () => {
   313→      try {
   314→        const ctx = await initContext();
   315→
   316→        if (!ctx.manifestPath) {
   317→          error(errors.project.noKspecProject);
   318→          process.exit(1);
   319→        }
   320→
   321→        const metaCtx = await loadMetaContext(ctx);
   322→        const stats = getMetaStats(metaCtx);
   323→
   324→        output(
   325→          {
   326→            manifest: metaCtx.manifestPath,
   327→            stats,
   328→          },
   329→          () => formatMetaShow(metaCtx)
   330→        );
   331→      } catch (err) {
   332→        error(errors.failures.showMeta, err);
   333→        process.exit(1);
   334→      }
   335→    });
   336→
   337→  // AC-agent-1, AC-agent-2: kspec meta agents
   338→  meta
   339→    .command('agents')
   340→    .description('List agents defined in meta-spec')
   341→    .action(async () => {
   342→      try {
   343→        const ctx = await initContext();
   344→
   345→        if (!ctx.manifestPath) {
   346→          error(errors.project.noKspecProject);
   347→          process.exit(1);
   348→        }
   349→
   350→        const metaCtx = await loadMetaContext(ctx);
   351→        const agents = metaCtx.agents || [];
   352→
   353→        // AC-agent-2: JSON output includes full agent details
   354→        output(
   355→          agents.map((agent) => ({
   356→            id: agent.id,
   357→            name: agent.name,
   358→            description: agent.description,
   359→            capabilities: agent.capabilities,
   360→            tools: agent.tools,
   361→            session_protocol: agent.session_protocol,
   362→            conventions: agent.conventions,
   363→          })),
   364→          // AC-agent-1: Table output with ID, Name, Capabilities
   365→          () => formatAgents(agents)
   366→        );
   367→      } catch (err) {
   368→        error(errors.failures.listAgents, err);
   369→        process.exit(1);
   370→      }
   371→    });
   372→
   373→  // AC-workflow-1, AC-workflow-2, AC-workflow-4: kspec meta workflows
   374→  meta
   375→    .command('workflows')
   376→    .description('List workflows defined in meta-spec')
   377→    .option('--verbose', 'Show full workflow details with all steps')
   378→    .action(async (options) => {
   379→      try {
   380→        const ctx = await initContext();
   381→
   382→        if (!ctx.manifestPath) {
   383→          error(errors.project.noKspecProject);
   384→          process.exit(1);
   385→        }
   386→
   387→        const metaCtx = await loadMetaContext(ctx);
   388→        const workflows = metaCtx.workflows || [];
   389→
   390→        // AC-workflow-4: JSON output includes full workflow details
   391→        output(
   392→          workflows.map((workflow) => ({
   393→            id: workflow.id,
   394→            trigger: workflow.trigger,
   395→            description: workflow.description,
   396→            steps: workflow.steps,
   397→          })),
   398→          // AC-workflow-1 (table) or AC-workflow-2 (verbose)
   399→          () => {
   400→            if (options.verbose) {
   401→              formatWorkflowsVerbose(workflows);
   402→            } else {
   403→              formatWorkflows(workflows);
   404→            }
   405→          }
   406→        );
   407→      } catch (err) {
   408→        error(errors.failures.listWorkflows, err);
   409→        process.exit(1);
   410→      }
   411→    });
   412→
   413→  // AC-conv-1, AC-conv-2, AC-conv-5: kspec meta conventions
   414→  meta
   415→    .command('conventions')
   416→    .description('List conventions defined in meta-spec')
   417→    .option('--domain <domain>', 'Filter by specific domain')
   418→    .action(async (options) => {
   419→      try {
   420→        const ctx = await initContext();
   421→
   422→        if (!ctx.manifestPath) {
   423→          error(errors.project.noKspecProject);
   424→          process.exit(1);
   425→        }
   426→
   427→        const metaCtx = await loadMetaContext(ctx);
   428→        const conventions = metaCtx.conventions || [];
   429→
   430→        // AC-conv-2: Filter by domain if specified
   431→        const filtered = options.domain
   432→          ? conventions.filter((c) => c.domain === options.domain)
   433→          : conventions;
   434→
   435→        // AC-conv-5: JSON output includes full convention details
   436→        output(
   437→          filtered.map((convention) => ({
   438→            domain: convention.domain,
   439→            rules: convention.rules,
   440→            examples: convention.examples,
   441→            validation: convention.validation,
   442→          })),
   443→          // AC-conv-1 (table) or AC-conv-2 (detail for single domain)
   444→          () => {
   445→            if (options.domain && filtered.length === 1) {
   446→              formatConventionDetail(filtered[0]);
   447→            } else {
   448→              formatConventions(filtered);
   449→            }
   450→          }
   451→        );
   452→      } catch (err) {
   453→        error(errors.failures.listConventions, err);
   454→        process.exit(1);
   455→      }
   456→    });
   457→
   458→  // meta-get-cmd: kspec meta get <ref>
   459→  meta
   460→    .command('get <ref>')
   461→    .description('Get a meta item by reference (agent, workflow, convention, or observation)')
   462→    .action(async (ref: string) => {
   463→      try {
   464→        const ctx = await initContext();
   465→
   466→        if (!ctx.manifestPath) {
   467→          error(errors.project.noKspecProject);
   468→          process.exit(1);
   469→        }
   470→
   471→        const metaCtx = await loadMetaContext(ctx);
   472→
   473→        // Normalize reference
   474→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   475→
   476→        // Search in all meta item types
   477→        const agents = metaCtx.agents || [];
   478→        const workflows = metaCtx.workflows || [];
   479→        const conventions = metaCtx.conventions || [];
   480→        const observations = metaCtx.observations || [];
   481→
   482→        // Try to find by ID or ULID prefix
   483→        let found: any = null;
   484→        let itemType: string = '';
   485→
   486→        // Check agents (by id or ULID)
   487→        const agent = agents.find((a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef));
   488→        if (agent) {
   489→          found = agent;
   490→          itemType = 'agent';
   491→        }
   492→
   493→        // Check workflows (by id or ULID)
   494→        if (!found) {
   495→          const workflow = workflows.find((w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef));
   496→          if (workflow) {
   497→            found = workflow;
   498→            itemType = 'workflow';
   499→          }
   500→        }
   501→
   502→        // Check conventions (by domain or ULID)
   503→        if (!found) {
   504→          const convention = conventions.find((c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef));
   505→          if (convention) {
   506→            found = convention;
   507→            itemType = 'convention';
   508→          }
   509→        }
   510→
   511→        // Check observations (by ULID)
   512→        if (!found) {
   513→          const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   514→          if (observation) {
   515→            found = observation;
   516→            itemType = 'observation';
   517→          }
   518→        }
   519→
   520→        if (!found) {
   521→          error(errors.reference.metaNotFound(ref));
   522→          process.exit(1);
   523→        }
   524→
   525→        // Output the item
   526→        output(found, () => {
   527→          console.log(chalk.bold(`${itemType.charAt(0).toUpperCase() + itemType.slice(1)}: ${ref}`));
   528→          console.log(chalk.gray('─'.repeat(60)));
   529→          console.log(JSON.stringify(found, null, 2));
   530→        });
   531→      } catch (err) {
   532→        error(errors.failures.getMetaItem, err);
   533→        process.exit(1);
   534→      }
   535→    });
   536→
   537→  // meta-list-cmd: kspec meta list
   538→  meta
   539→    .command('list')
   540→    .description('List all meta items')
   541→    .option('--type <type>', 'Filter by type (agent, workflow, convention, observation)')
   542→    .action(async (options) => {
   543→      try {
   544→        const ctx = await initContext();
   545→
   546→        if (!ctx.manifestPath) {
   547→          error(errors.project.noKspecProject);
   548→          process.exit(1);
   549→        }
   550→
   551→        const metaCtx = await loadMetaContext(ctx);
   552→
   553→        // Collect all meta items with type information
   554→        interface MetaListItem {
   555→          id: string;
   556→          type: string;
   557→          context: string;
   558→          ulid: string;
   559→        }
   560→
   561→        const items: MetaListItem[] = [];
   562→
   563→        // Add agents
   564→        if (!options.type || options.type === 'agent') {
   565→          for (const agent of metaCtx.agents || []) {
   566→            items.push({
   567→              id: agent.id,
   568→              type: 'agent',
   569→              context: agent.name,
   570→              ulid: agent._ulid,
   571→            });
   572→          }
   573→        }
   574→
   575→        // Add workflows
   576→        if (!options.type || options.type === 'workflow') {
   577→          for (const workflow of metaCtx.workflows || []) {
   578→            items.push({
   579→              id: workflow.id,
   580→              type: 'workflow',
   581→              context: workflow.trigger,
   582→              ulid: workflow._ulid,
   583→            });
   584→          }
   585→        }
   586→
   587→        // Add conventions
   588→        if (!options.type || options.type === 'convention') {
   589→          for (const convention of metaCtx.conventions || []) {
   590→            items.push({
   591→              id: convention.domain,
   592→              type: 'convention',
   593→              context: `${convention.rules.length} rules`,
   594→              ulid: convention._ulid,
   595→            });
   596→          }
   597→        }
   598→
   599→        // Add observations
   600→        if (!options.type || options.type === 'observation') {
   601→          for (const observation of metaCtx.observations || []) {
   602→            const ulidPrefix = observation._ulid.substring(0, 8);
   603→            items.push({
   604→              id: ulidPrefix,
   605→              type: 'observation',
   606→              context: `${observation.type} ${observation.resolved ? '(resolved)' : ''}`,
   607→              ulid: observation._ulid,
   608→            });
   609→          }
   610→        }
   611→
   612→        // Output
   613→        output(items, () => {
   614→          if (items.length === 0) {
   615→            console.log(chalk.yellow('No meta items found'));
   616→            return;
   617→          }
   618→
   619→          const table = new Table({
   620→            head: [chalk.bold('ID'), chalk.bold('Type'), chalk.bold('Context')],
   621→            style: {
   622→              head: [],
   623→              border: [],
   624→            },
   625→          });
   626→
   627→          for (const item of items) {
   628→            table.push([item.id, item.type, item.context]);
   629→          }
   630→
   631→          console.log(table.toString());
   632→        });
   633→      } catch (err) {
   634→        error(errors.failures.listMetaItems, err);
   635→        process.exit(1);
   636→      }
   637→    });
   638→
   639→  // AC-obs-1: kspec meta observe <type> <content>
   640→  meta
   641→    .command('observe <type> <content>')
   642→    .description('Create an observation (friction, success, question, idea)')
   643→    .option('--workflow <ref>', 'Reference to workflow this observation relates to')
   644→    .option('--author <author>', 'Author of the observation')
   645→    .action(async (type: string, content: string, options) => {
   646→      try {
   647→        const ctx = await initContext();
   648→
   649→        if (!ctx.manifestPath) {
   650→          error(errors.project.noKspecProject);
   651→          process.exit(1);
   652→        }
   653→
   654→        // Validate observation type
   655→        const validTypes: ObservationType[] = ['friction', 'success', 'question', 'idea'];
   656→        if (!validTypes.includes(type as ObservationType)) {
   657→          error(errors.validation.invalidObservationType(type));
   658→          console.log(`Valid types: ${validTypes.join(', ')}`);
   659→          process.exit(1);
   660→        }
   661→
   662→        // Create observation
   663→        const observation = createObservation(type as ObservationType, content, {
   664→          workflow_ref: options.workflow,
   665→          author: options.author,
   666→        });
   667→
   668→        // Save to manifest
   669→        await saveObservation(ctx, observation);
   670→
   671→        // AC-obs-1: outputs "OK Created observation: <ULID-prefix>"
   672→        success(`Created observation: ${observation._ulid.substring(0, 8)}`);
   673→      } catch (err) {
   674→        error(errors.failures.createObservation, err);
   675→        process.exit(1);
   676→      }
   677→    });
   678→
   679→  // AC-obs-2, AC-obs-5: kspec meta observations
   680→  meta
   681→    .command('observations')
   682→    .description('List observations (shows unresolved by default)')
   683→    .option('--all', 'Include resolved observations')
   684→    .option('--promoted', 'Show only observations promoted to tasks')
   685→    .option('--pending-resolution', 'Show observations with completed tasks awaiting resolution')
   686→    .action(async (options) => {
   687→      try {
   688→        const ctx = await initContext();
   689→
   690→        if (!ctx.manifestPath) {
   691→          error(errors.project.noKspecProject);
   692→          process.exit(1);
   693→        }
   694→
   695→        const metaCtx = await loadMetaContext(ctx);
   696→        let observations = metaCtx.observations || [];
   697→
   698→        // Apply filters
   699→        if (options.promoted) {
   700→          observations = observations.filter((obs) => obs.promoted_to !== undefined);
   701→        }
   702→
   703→        if (options.pendingResolution) {
   704→          // Load tasks to check if promoted tasks are completed
   705→          const tasks = await loadAllTasks(ctx);
   706→          const items = await loadAllItems(ctx);
   707→          const index = new ReferenceIndex(tasks, items);
   708→
   709→          observations = observations.filter((obs) => {
   710→            if (!obs.promoted_to || obs.resolved) return false;
   711→            const taskResult = index.resolve(obs.promoted_to);
   712→            if (!taskResult.ok) return false;
   713→            const item = taskResult.item;
   714→            // Type guard: check if item is a task (has status and depends_on properties)
   715→            return 'status' in item && 'depends_on' in item && item.status === 'completed';
   716→          });
   717→        }
   718→
   719→        // AC-obs-5: JSON output includes full observation objects
   720→        output(
   721→          observations.map((obs) => ({
   722→            _ulid: obs._ulid,
   723→            type: obs.type,
   724→            content: obs.content,
   725→            workflow_ref: obs.workflow_ref ?? null,
   726→            created_at: obs.created_at,
   727→            author: obs.author ?? null,
   728→            resolved: obs.resolved,
   729→            resolution: obs.resolution ?? null,
   730→            resolved_at: obs.resolved_at ?? null,
   731→            resolved_by: obs.resolved_by ?? null,
   732→            promoted_to: obs.promoted_to ?? null,
   733→          })),
   734→          // AC-obs-2: Table output with ID, Type, Workflow, Created, Content
   735→          () => formatObservations(observations, options.all)
   736→        );
   737→      } catch (err) {
   738→        error(errors.failures.listObservations, err);
   739→        process.exit(1);
   740→      }
   741→    });
   742→
   743→  // AC-obs-3, AC-obs-6, AC-obs-8: kspec meta promote
   744→  meta
   745→    .command('promote <ref>')
   746→    .description('Promote observation to a task')
   747→    .requiredOption('--title <title>', 'Task title')
   748→    .option('--priority <priority>', 'Task priority (1-3)', '2')
   749→    .option('--force', 'Force promotion even if observation is resolved')
   750→    .action(async (ref: string, options) => {
   751→      try {
   752→        const ctx = await initContext();
   753→
   754→        if (!ctx.manifestPath) {
   755→          error(errors.project.noKspecProject);
   756→          process.exit(1);
   757→        }
   758→
   759→        const metaCtx = await loadMetaContext(ctx);
   760→        const observations = metaCtx.observations || [];
   761→
   762→        // Find observation
   763→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   764→        const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   765→
   766→        if (!observation) {
   767→          error(errors.reference.observationNotFound(ref));
   768→          process.exit(1);
   769→        }
   770→
   771→        // AC-obs-6: Check if already promoted
   772→        if (observation.promoted_to) {
   773→          error(errors.conflict.observationAlreadyPromoted(observation.promoted_to));
   774→          process.exit(1);
   775→        }
   776→
   777→        // AC-obs-8: Check if resolved
   778→        if (observation.resolved && !options.force) {
   779→          error(errors.operation.cannotPromoteResolved);
   780→          process.exit(1);
   781→        }
   782→
   783→        // AC-obs-3: Create task with title, description from observation, meta_ref, and origin
   784→        const task = createTask({
   785→          title: options.title,
   786→          description: observation.content,
   787→          priority: Number.parseInt(options.priority, 10),
   788→          meta_ref: observation.workflow_ref,
   789→          origin: 'observation_promotion',
   790→        });
   791→
   792→        // Save task
   793→        await saveTask(ctx, task);
   794→        await commitIfShadow(ctx.shadow, 'task-add', task.slugs[0] || task._ulid.slice(0, 8), task.title);
   795→        const taskRef = `@${task._ulid.substring(0, 8)}`;
   796→
   797→        // Update observation with promoted_to field
   798→        observation.promoted_to = taskRef;
   799→        await saveObservation(ctx, observation);
   800→
   801→        // AC-obs-3: outputs "OK Created task: <ULID-prefix>"
   802→        success(`Created task: ${taskRef.substring(0, 9)}`);
   803→      } catch (err) {
   804→        error(errors.failures.promoteObservation, err);
   805→        process.exit(1);
   806→      }
   807→    });
   808→
   809→  // AC-obs-4, AC-obs-7, AC-obs-9: kspec meta resolve
   810→  meta
   811→    .command('resolve <ref> [resolution]')
   812→    .description('Resolve an observation')
   813→    .action(async (ref: string, resolution: string | undefined) => {
   814→      try {
   815→        const ctx = await initContext();
   816→
   817→        if (!ctx.manifestPath) {
   818→          error(errors.project.noKspecProject);
   819→          process.exit(1);
   820→        }
   821→
   822→        const metaCtx = await loadMetaContext(ctx);
   823→        const observations = metaCtx.observations || [];
   824→
   825→        // Find observation
   826→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   827→        const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   828→
   829→        if (!observation) {
   830→          error(errors.reference.observationNotFound(ref));
   831→          process.exit(1);
   832→        }
   833→
   834→        // AC-obs-7: Check if already resolved
   835→        if (observation.resolved) {
   836→          const resolvedDate = new Date(observation.resolved_at!).toISOString().split('T')[0];
   837→          const resolutionText = observation.resolution || '';
   838→          const truncated = resolutionText.length > 50
   839→            ? resolutionText.substring(0, 50) + '...'
   840→            : resolutionText;
   841→          error(errors.conflict.observationAlreadyResolved(resolvedDate, truncated));
   842→          process.exit(1);
   843→        }
   844→
   845→        // AC-obs-9: Auto-populate resolution from task completion if promoted
   846→        let finalResolution = resolution;
   847→        if (!finalResolution && observation.promoted_to) {
   848→          // Fetch task to get completion reason
   849→          const tasks = await loadAllTasks(ctx);
   850→          const items = await loadAllItems(ctx);
   851→          const index = new ReferenceIndex(tasks, items);
   852→          const taskResult = index.resolve(observation.promoted_to);
   853→
   854→          if (taskResult.ok) {
   855→            const item = taskResult.item;
   856→            // Type guard: ensure this is a task (has status and depends_on properties)
   857→            if ('status' in item && 'depends_on' in item) {
   858→              const task = item as LoadedTask;
   859→              if (task.status === 'completed' && task.closed_reason) {
   860→                finalResolution = `Resolved via task ${observation.promoted_to}: ${task.closed_reason}`;
   861→              } else if (task.status === 'completed') {
   862→                finalResolution = `Resolved via task ${observation.promoted_to}`;
   863→              } else {
   864→                error(`Task ${observation.promoted_to} is not completed yet`);
   865→                process.exit(1);
   866→              }
   867→            } else {
   868→              error(`Reference ${observation.promoted_to} is not a task`);
   869→              process.exit(1);
   870→            }
   871→          } else {
   872→            error(`Task ${observation.promoted_to} not found`);
   873→            process.exit(1);
   874→          }
   875→        }
   876→
   877→        if (!finalResolution) {
   878→          error(errors.validation.resolutionRequired);
   879→          process.exit(1);
   880→        }
   881→
   882→        // AC-obs-4: Update observation
   883→        observation.resolved = true;
   884→        observation.resolution = finalResolution;
   885→        observation.resolved_at = new Date().toISOString();
   886→        observation.resolved_by = observation.author; // Use same author
   887→
   888→        await saveObservation(ctx, observation);
   889→
   890→        // AC-obs-4: outputs "OK Resolved: <ULID-prefix>"
   891→        success(`Resolved: ${observation._ulid.substring(0, 8)}`);
   892→      } catch (err) {
   893→        error(errors.failures.resolveObservation, err);
   894→        process.exit(1);
   895→      }
   896→    });
   897→
   898→  // Meta add command - create new meta items
   899→  meta
   900→    .command('add <type>')
   901→    .description('Create a new meta item (agent, workflow, or convention)')
   902→    .option('--id <id>', 'Semantic ID (required for agents and workflows)')
   903→    .option('--domain <domain>', 'Domain (required for conventions)')
   904→    .option('--name <name>', 'Name (for agents)')
   905→    .option('--trigger <trigger>', 'Trigger (for workflows)')
   906→    .option('--description <desc>', 'Description')
   907→    .option('--capability <cap...>', 'Capabilities (for agents)')
   908→    .option('--tool <tool...>', 'Tools (for agents)')
   909→    .option('--convention <conv...>', 'Convention references (for agents)')
   910→    .option('--rule <rule...>', 'Rules (for conventions)')
   911→    .action(async (type: string, options) => {
   912→      try {
   913→        const ctx = await initContext();
   914→
   915→        // Validate type
   916→        const validTypes = ['agent', 'workflow', 'convention'];
   917→        if (!validTypes.includes(type)) {
   918→          error(errors.validation.invalidType(type, validTypes));
   919→          process.exit(1);
   920→        }
   921→
   922→        // Generate ULID
   923→        const itemUlid = ulid();
   924→
   925→        // Create the item based on type
   926→        let item: Agent | Workflow | Convention;
   927→
   928→        if (type === 'agent') {
   929→          // Validate required fields
   930→          if (!options.id) {
   931→            error(errors.validation.agentRequiresId);
   932→            process.exit(1);
   933→          }
   934→          if (!options.name) {
   935→            error(errors.validation.agentRequiresName);
   936→            process.exit(1);
   937→          }
   938→
   939→          item = {
   940→            _ulid: itemUlid,
   941→            id: options.id,
   942→            name: options.name,
   943→            description: options.description || '',
   944→            capabilities: options.capability || [],
   945→            tools: options.tool || [],
   946→            conventions: options.convention || [],
   947→          };
   948→        } else if (type === 'workflow') {
   949→          // Validate required fields
   950→          if (!options.id) {
   951→            error(errors.validation.workflowRequiresId);
   952→            process.exit(1);
   953→          }
   954→          if (!options.trigger) {
   955→            error(errors.validation.workflowRequiresTrigger);
   956→            process.exit(1);
   957→          }
   958→
   959→          item = {
   960→            _ulid: itemUlid,
   961→            id: options.id,
   962→            trigger: options.trigger,
   963→            description: options.description || '',
   964→            steps: [],
   965→          };
   966→        } else {
   967→          // convention
   968→          if (!options.domain) {
   969→            error(errors.validation.conventionRequiresDomain);
   970→            process.exit(1);
   971→          }
   972→
   973→          item = {
   974→            _ulid: itemUlid,
   975→            domain: options.domain,
   976→            rules: options.rule || [],
   977→            examples: [],
   978→          };
   979→        }
   980→
   981→        // Save the item
   982→        await saveMetaItem(ctx, item, type as 'agent' | 'workflow' | 'convention');
   983→
   984→        if (isJsonMode()) {
   985→          // In JSON mode, output the item data directly
   986→          console.log(JSON.stringify(item, null, 2));
   987→        } else {
   988→          const idOrDomain = 'id' in item ? item.id : 'domain' in item ? item.domain : itemUlid;
   989→          success(`Created ${type}: ${idOrDomain} (@${itemUlid.substring(0, 8)})`);
   990→        }
   991→      } catch (err) {
   992→        error(errors.failures.createMeta(type), err);
   993→        process.exit(1);
   994→      }
   995→    });
   996→
   997→  // Meta set command - update existing meta items
   998→  meta
   999→    .command('set <ref>')
  1000→    .description('Update an existing meta item')
  1001→    .option('--name <name>', 'Update name (for agents)')
  1002→    .option('--description <desc>', 'Update description')
  1003→    .option('--trigger <trigger>', 'Update trigger (for workflows)')
  1004→    .option('--add-capability <cap>', 'Add capability (for agents)')
  1005→    .option('--add-tool <tool>', 'Add tool (for agents)')
  1006→    .option('--add-convention <conv>', 'Add convention reference (for agents)')
  1007→    .option('--add-rule <rule>', 'Add rule (for conventions)')
  1008→    .action(async (ref: string, options) => {
  1009→      try {
  1010→        const ctx = await initContext();
  1011→        const metaCtx = await loadMetaContext(ctx);
  1012→
  1013→        // Find the item using unified lookup
  1014→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
  1015→        let found: Agent | Workflow | Convention | null = null;
  1016→        let itemType: 'agent' | 'workflow' | 'convention' | null = null;
  1017→
  1018→        // Search in agents
  1019→        const agents = metaCtx.manifest?.agents || [];
  1020→        const agent = agents.find(
  1021→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
  1022→        );
  1023→        if (agent) {
  1024→          found = agent;
  1025→          itemType = 'agent';
  1026→        }
  1027→
  1028→        // Search in workflows
  1029→        if (!found) {
  1030→          const workflows = metaCtx.manifest?.workflows || [];
  1031→          const workflow = workflows.find(
  1032→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
  1033→          );
  1034→          if (workflow) {
  1035→            found = workflow;
  1036→            itemType = 'workflow';
  1037→          }
  1038→        }
  1039→
  1040→        // Search in conventions
  1041→        if (!found) {
  1042→          const conventions = metaCtx.manifest?.conventions || [];
  1043→          const convention = conventions.find(
  1044→            (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
  1045→          );
  1046→          if (convention) {
  1047→            found = convention;
  1048→            itemType = 'convention';
  1049→          }
  1050→        }
  1051→
  1052→        if (!found || !itemType) {
  1053→          error(errors.reference.metaNotFound(ref));
  1054→          process.exit(1);
  1055→        }
  1056→
  1057→        // Update fields based on type
  1058→        if (itemType === 'agent') {
  1059→          const item = found as Agent;
  1060→          if (options.name) item.name = options.name;
  1061→          if (options.description !== undefined) item.description = options.description;
  1062→          if (options.addCapability) {
  1063→            if (!item.capabilities.includes(options.addCapability)) {
  1064→              item.capabilities.push(options.addCapability);
  1065→            }
  1066→          }
  1067→          if (options.addTool) {
  1068→            if (!item.tools.includes(options.addTool)) {
  1069→              item.tools.push(options.addTool);
  1070→            }
  1071→          }
  1072→          if (options.addConvention) {
  1073→            if (!item.conventions.includes(options.addConvention)) {
  1074→              item.conventions.push(options.addConvention);
  1075→            }
  1076→          }
  1077→        } else if (itemType === 'workflow') {
  1078→          const item = found as Workflow;
  1079→          if (options.trigger) item.trigger = options.trigger;
  1080→          if (options.description !== undefined) item.description = options.description;
  1081→        } else {
  1082→          const item = found as Convention;
  1083→          // Convention doesn't have a description field
  1084→          if (options.addRule) {
  1085→            if (!item.rules.includes(options.addRule)) {
  1086→              item.rules.push(options.addRule);
  1087→            }
  1088→          }
  1089→        }
  1090→
  1091→        // Save the updated item
  1092→        await saveMetaItem(ctx, found, itemType);
  1093→
  1094→        if (isJsonMode()) {
  1095→          // In JSON mode, output the item data directly
  1096→          console.log(JSON.stringify(found, null, 2));
  1097→        } else {
  1098→          const idOrDomain =
  1099→            itemType === 'agent'
  1100→              ? (found as Agent).id
  1101→              : itemType === 'workflow'
  1102→                ? (found as Workflow).id
  1103→                : (found as Convention).domain;
  1104→          success(`Updated ${itemType}: ${idOrDomain}`);
  1105→        }
  1106→      } catch (err) {
  1107→        error(errors.failures.updateMetaItem, err);
  1108→        process.exit(1);
  1109→      }
  1110→    });
  1111→
  1112→  // Meta delete command - delete meta items
  1113→  meta
  1114→    .command('delete <ref>')
  1115→    .description('Delete a meta item')
  1116→    .option('--confirm', 'Skip confirmation prompt')
  1117→    .action(async (ref: string, options) => {
  1118→      try {
  1119→        const ctx = await initContext();
  1120→        const metaCtx = await loadMetaContext(ctx);
  1121→
  1122→        // Find the item to determine type
  1123→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
  1124→        let itemType: 'agent' | 'workflow' | 'convention' | 'observation' | null = null;
  1125→        let itemUlid: string | null = null;
  1126→        let itemLabel: string | null = null;
  1127→
  1128→        // Search in agents
  1129→        const agents = metaCtx.manifest?.agents || [];
  1130→        const agent = agents.find(
  1131→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
  1132→        );
  1133→        if (agent) {
  1134→          itemType = 'agent';
  1135→          itemUlid = agent._ulid;
  1136→          itemLabel = `agent ${agent.id}`;
  1137→        }
  1138→
  1139→        // Search in workflows
  1140→        if (!itemType) {
  1141→          const workflows = metaCtx.manifest?.workflows || [];
  1142→          const workflow = workflows.find(
  1143→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
  1144→          );
  1145→          if (workflow) {
  1146→            itemType = 'workflow';
  1147→            itemUlid = workflow._ulid;
  1148→            itemLabel = `workflow ${workflow.id}`;
  1149→          }
  1150→        }
  1151→
  1152→        // Search in conventions
  1153→        if (!itemType) {
  1154→          const conventions = metaCtx.manifest?.conventions || [];
  1155→          const convention = conventions.find(
  1156→            (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
  1157→          );
  1158→          if (convention) {
  1159→            itemType = 'convention';
  1160→            itemUlid = convention._ulid;
  1161→            itemLabel = `convention ${convention.domain}`;
  1162→          }
  1163→        }
  1164→
  1165→        // Search in observations
  1166→        if (!itemType) {
  1167→          const observations = metaCtx.observations || [];
  1168→          const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
  1169→          if (observation) {
  1170→            itemType = 'observation';
  1171→            itemUlid = observation._ulid;
  1172→            itemLabel = `observation ${observation._ulid.substring(0, 8)}`;
  1173→          }
  1174→        }
  1175→
  1176→        if (!itemType || !itemUlid || !itemLabel) {
  1177→          error(errors.reference.metaNotFound(ref));
  1178→          process.exit(1);
  1179→        }
  1180→
  1181→        // Check for dangling references (unless --confirm is used to override)
  1182→        if (!options.confirm) {
  1183→          // Check tasks with meta_ref
  1184→          const tasks = await loadAllTasks(ctx);
  1185→          const referencingTasks = tasks.filter((t) => {
  1186→            if (!t.meta_ref) return false;
  1187→            // Resolve the task's meta_ref to a ULID
  1188→            const taskMetaRef = resolveMetaRefToUlid(t.meta_ref, metaCtx);
  1189→            // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1190→            return taskMetaRef && taskMetaRef.ulid === itemUlid;
  1191→          });
  1192→
  1193→          if (referencingTasks.length > 0) {
  1194→            const taskRefs = referencingTasks
  1195→              .map((t) => `@${t.slugs?.[0] || t._ulid.substring(0, 8)}`)
  1196→              .join(', ');
  1197→            error(errors.operation.cannotDeleteReferencedByTasks(itemLabel, referencingTasks.length, taskRefs));
  1198→            process.exit(1);
  1199→          }
  1200→
  1201→          // Check observations with workflow_ref (only for workflows)
  1202→          if (itemType === 'workflow') {
  1203→            const observations = metaCtx.observations || [];
  1204→            const referencingObservations = observations.filter((o) => {
  1205→              if (!o.workflow_ref) return false;
  1206→              // Resolve the observation's workflow_ref to a ULID
  1207→              const obsWorkflowRef = resolveMetaRefToUlid(o.workflow_ref, metaCtx);
  1208→              // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1209→              return obsWorkflowRef && obsWorkflowRef.ulid === itemUlid;
  1210→            });
  1211→
  1212→            if (referencingObservations.length > 0) {
  1213→              const obsRefs = referencingObservations
  1214→                .map((o) => `@${o._ulid.substring(0, 8)}`)
  1215→                .join(', ');
  1216→              error(errors.operation.cannotDeleteReferencedByObservations(itemLabel, referencingObservations.length, obsRefs));
  1217→              process.exit(1);
  1218→            }
  1219→          }
  1220→
  1221→          // Show confirmation prompt even if no references found
  1222→          error(errors.operation.confirmRequired(itemLabel));
  1223→          process.exit(1);
  1224→        }
  1225→
  1226→        // Delete the item
  1227→        const deleted = await deleteMetaItem(ctx, itemUlid, itemType);
  1228→
  1229→        if (!deleted) {
  1230→          error(errors.operation.deleteItemFailed(itemLabel));
  1231→          process.exit(1);
  1232→        }
  1233→
  1234→        success(`Deleted ${itemLabel}`);
  1235→      } catch (err) {
  1236→        error(errors.failures.deleteMetaItem, err);
  1237→        process.exit(1);
  1238→      }
  1239→    });
  1240→}
  1241→

