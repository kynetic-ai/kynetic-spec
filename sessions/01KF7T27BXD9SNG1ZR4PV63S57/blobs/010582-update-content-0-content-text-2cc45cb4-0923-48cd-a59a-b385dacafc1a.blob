```
     1→/**
     2→ * Shadow branch utilities for transparent spec/task state tracking.
     3→ *
     4→ * Shadow branch concept:
     5→ * - Orphan branch (kspec-meta) stores kspec state
     6→ * - .kspec/ directory is a git worktree pointing to shadow branch
     7→ * - Main branch gitignores .kspec/
     8→ * - All kspec read/write operations target .kspec/
     9→ * - Changes auto-commit to shadow branch
    10→ */
    11→
    12→import * as fs from 'node:fs/promises';
    13→import * as path from 'node:path';
    14→import { execSync, exec } from 'node:child_process';
    15→import { promisify } from 'node:util';
    16→
    17→const execAsync = promisify(exec);
    18→
    19→/**
    20→ * Shadow branch configuration
    21→ */
    22→export interface ShadowConfig {
    23→  /** Whether shadow branch is enabled/detected */
    24→  enabled: boolean;
    25→  /** Path to .kspec/ worktree directory */
    26→  worktreeDir: string;
    27→  /** Shadow branch name (default: kspec-meta) */
    28→  branchName: string;
    29→  /** Project root (where .kspec/ lives) */
    30→  projectRoot: string;
    31→}
    32→
    33→/**
    34→ * Shadow branch status
    35→ */
    36→export interface ShadowStatus {
    37→  exists: boolean;
    38→  healthy: boolean;
    39→  branchExists: boolean;
    40→  worktreeExists: boolean;
    41→  worktreeLinked: boolean;
    42→  error?: string;
    43→}
    44→
    45→/**
    46→ * Error types for shadow branch issues
    47→ */
    48→export class ShadowError extends Error {
    49→  constructor(
    50→    message: string,
    51→    public code: 'NOT_INITIALIZED' | 'WORKTREE_DISCONNECTED' | 'DIRECTORY_MISSING' | 'GIT_ERROR',
    52→    public suggestion: string
    53→  ) {
    54→    super(message);
    55→    this.name = 'ShadowError';
    56→  }
    57→}
    58→
    59→/**
    60→ * Default shadow branch name
    61→ */
    62→export const SHADOW_BRANCH_NAME = 'kspec-meta';
    63→
    64→/**
    65→ * Default shadow worktree directory
    66→ */
    67→export const SHADOW_WORKTREE_DIR = '.kspec';
    68→
    69→/**
    70→ * Check if we're in a git repository
    71→ */
    72→export async function isGitRepo(dir: string): Promise<boolean> {
    73→  try {
    74→    execSync('git rev-parse --git-dir', {
    75→      cwd: dir,
    76→      stdio: ['pipe', 'pipe', 'pipe'],
    77→      encoding: 'utf-8',
    78→    });
    79→    return true;
    80→  } catch {
    81→    return false;
    82→  }
    83→}
    84→
    85→/**
    86→ * Get the git root directory
    87→ */
    88→export function getGitRoot(dir: string): string | null {
    89→  try {
    90→    const result = execSync('git rev-parse --show-toplevel', {
    91→      cwd: dir,
    92→      stdio: ['pipe', 'pipe', 'pipe'],
    93→      encoding: 'utf-8',
    94→    }).trim();
    95→    return result;
    96→  } catch {
    97→    return null;
    98→  }
    99→}
   100→
   101→/**
   102→ * Check if a branch exists
   103→ */
   104→export async function branchExists(dir: string, branchName: string): Promise<boolean> {
   105→  try {
   106→    execSync(`git show-ref --verify --quiet refs/heads/${branchName}`, {
   107→      cwd: dir,
   108→      stdio: ['pipe', 'pipe', 'pipe'],
   109→    });
   110→    return true;
   111→  } catch {
   112→    return false;
   113→  }
   114→}
   115→
   116→/**
   117→ * Check if a directory is a valid git worktree
   118→ */
   119→export async function isValidWorktree(worktreeDir: string): Promise<boolean> {
   120→  try {
   121→    // Check if .git file exists (worktrees have a .git file, not directory)
   122→    const gitPath = path.join(worktreeDir, '.git');
   123→    const stat = await fs.stat(gitPath);
   124→
   125→    if (stat.isFile()) {
   126→      // Read the .git file to verify it points to a worktree
   127→      const content = await fs.readFile(gitPath, 'utf-8');
   128→      return content.trim().startsWith('gitdir:');
   129→    }
   130→
   131→    return false;
   132→  } catch {
   133→    return false;
   134→  }
   135→}
   136→
   137→/**
   138→ * Detect shadow branch configuration from a directory.
   139→ * Returns shadow config if .kspec/ exists and is valid.
   140→ */
   141→export async function detectShadow(startDir: string): Promise<ShadowConfig | null> {
   142→  const gitRoot = getGitRoot(startDir);
   143→  if (!gitRoot) {
   144→    return null;
   145→  }
   146→
   147→  const worktreeDir = path.join(gitRoot, SHADOW_WORKTREE_DIR);
   148→
   149→  try {
   150→    await fs.access(worktreeDir);
   151→
   152→    // Verify it's a valid worktree
   153→    if (await isValidWorktree(worktreeDir)) {
   154→      return {
   155→        enabled: true,
   156→        worktreeDir,
   157→        branchName: SHADOW_BRANCH_NAME,
   158→        projectRoot: gitRoot,
   159→      };
   160→    }
   161→
   162→    // Directory exists but not a valid worktree
   163→    return null;
   164→  } catch {
   165→    // .kspec/ doesn't exist
   166→    return null;
   167→  }
   168→}
   169→
   170→/**
   171→ * Get detailed shadow branch status
   172→ */
   173→export async function getShadowStatus(projectRoot: string): Promise<ShadowStatus> {
   174→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
   175→
   176→  const status: ShadowStatus = {
   177→    exists: false,
   178→    healthy: false,
   179→    branchExists: false,
   180→    worktreeExists: false,
   181→    worktreeLinked: false,
   182→  };
   183→
   184→  // Check if we're in a git repo
   185→  if (!(await isGitRepo(projectRoot))) {
   186→    status.error = 'Not a git repository';
   187→    return status;
   188→  }
   189→
   190→  // Check if branch exists
   191→  status.branchExists = await branchExists(projectRoot, SHADOW_BRANCH_NAME);
   192→
   193→  // Check if worktree directory exists
   194→  try {
   195→    await fs.access(worktreeDir);
   196→    status.worktreeExists = true;
   197→  } catch {
   198→    status.worktreeExists = false;
   199→  }
   200→
   201→  // Check if worktree is properly linked
   202→  if (status.worktreeExists) {
   203→    status.worktreeLinked = await isValidWorktree(worktreeDir);
   204→  }
   205→
   206→  // Determine overall status
   207→  status.exists = status.branchExists || status.worktreeExists;
   208→  status.healthy = status.branchExists && status.worktreeExists && status.worktreeLinked;
   209→
   210→  if (!status.healthy && status.exists) {
   211→    if (!status.branchExists) {
   212→      status.error = 'Shadow branch missing but worktree exists';
   213→    } else if (!status.worktreeExists) {
   214→      status.error = 'Shadow branch exists but worktree missing';
   215→    } else if (!status.worktreeLinked) {
   216→      status.error = 'Worktree exists but not properly linked';
   217→    }
   218→  }
   219→
   220→  return status;
   221→}
   222→
   223→/**
   224→ * Create an appropriate ShadowError based on status
   225→ */
   226→export function createShadowError(status: ShadowStatus): ShadowError {
   227→  if (!status.branchExists && !status.worktreeExists) {
   228→    return new ShadowError(
   229→      'Shadow branch not initialized',
   230→      'NOT_INITIALIZED',
   231→      'Run `kspec init` to create shadow branch and worktree.'
   232→    );
   233→  }
   234→
   235→  if (status.branchExists && !status.worktreeExists) {
   236→    return new ShadowError(
   237→      '.kspec/ directory missing',
   238→      'DIRECTORY_MISSING',
   239→      'Run `kspec shadow repair` to recreate the worktree.'
   240→    );
   241→  }
   242→
   243→  if (status.worktreeExists && !status.worktreeLinked) {
   244→    return new ShadowError(
   245→      'Worktree disconnected from git',
   246→      'WORKTREE_DISCONNECTED',
   247→      'Run `kspec shadow repair` to fix the worktree link.'
   248→    );
   249→  }
   250→
   251→  return new ShadowError(
   252→    status.error || 'Unknown shadow branch error',
   253→    'GIT_ERROR',
   254→    'Check git status and try `kspec shadow repair`.'
   255→  );
   256→}
   257→
   258→/**
   259→ * Auto-commit changes to shadow branch.
   260→ * Called after write operations when shadow is enabled.
   261→ *
   262→ * @param worktreeDir Path to .kspec/ directory
   263→ * @param message Commit message
   264→ * @returns true if commit succeeded, false if nothing to commit
   265→ */
   266→export async function shadowAutoCommit(
   267→  worktreeDir: string,
   268→  message: string
   269→): Promise<boolean> {
   270→  try {
   271→    // Stage all changes
   272→    execSync('git add -A', {
   273→      cwd: worktreeDir,
   274→      stdio: ['pipe', 'pipe', 'pipe'],
   275→    });
   276→
   277→    // Check if there are staged changes
   278→    try {
   279→      execSync('git diff --cached --quiet', {
   280→        cwd: worktreeDir,
   281→        stdio: ['pipe', 'pipe', 'pipe'],
   282→      });
   283→      // No error = no changes
   284→      return false;
   285→    } catch {
   286→      // Error = there are changes, proceed with commit
   287→    }
   288→
   289→    // Commit with message
   290→    execSync(`git commit -m "${message.replace(/"/g, '\\"')}"`, {
   291→      cwd: worktreeDir,
   292→      stdio: ['pipe', 'pipe', 'pipe'],
   293→    });
   294→
   295→    return true;
   296→  } catch (error) {
   297→    // Log error but don't throw - auto-commit failure shouldn't break the operation
   298→    console.error('Shadow auto-commit failed:', error);
   299→    return false;
   300→  }
   301→}
   302→
   303→/**
   304→ * Generate commit message for a kspec operation.
   305→ */
   306→export function generateCommitMessage(
   307→  operation: string,
   308→  ref?: string,
   309→  detail?: string
   310→): string {
   311→  const parts: string[] = [];
   312→
   313→  switch (operation) {
   314→    case 'task-start':
   315→      parts.push(`Start @${ref}`);
   316→      break;
   317→    case 'task-complete':
   318→      parts.push(`Complete @${ref}`);
   319→      if (detail) parts.push(`: ${detail}`);
   320→      break;
   321→    case 'task-note':
   322→      parts.push(`Note on @${ref}`);
   323→      break;
   324→    case 'task-add':
   325→      parts.push(`Add task: ${detail || ref}`);
   326→      break;
   327→    case 'inbox-add':
   328→      parts.push(`Inbox: ${detail?.slice(0, 50)}${(detail?.length || 0) > 50 ? '...' : ''}`);
   329→      break;
   330→    case 'inbox-promote':
   331→      parts.push(`Promote to @${ref}`);
   332→      break;
   333→    case 'item-add':
   334→      parts.push(`Add @${ref}`);
   335→      break;
   336→    case 'item-set':
   337→      parts.push(`Update @${ref}`);
   338→      break;
   339→    case 'item-delete':
   340→      parts.push(`Delete @${ref}`);
   341→      break;
   342→    case 'derive':
   343→      parts.push(`Derive from @${ref}`);
   344→      break;
   345→    default:
   346→      parts.push(operation);
   347→      if (ref) parts.push(` @${ref}`);
   348→  }
   349→
   350→  return parts.join('');
   351→}
   352→
   353→/**
   354→ * Resolve a path relative to shadow worktree if enabled.
   355→ * Falls back to original path if shadow is not enabled.
   356→ */
   357→export function resolveShadowPath(
   358→  originalPath: string,
   359→  shadowConfig: ShadowConfig | null,
   360→  projectRoot: string
   361→): string {
   362→  if (!shadowConfig?.enabled) {
   363→    return originalPath;
   364→  }
   365→
   366→  // If the path is within the project root, rewrite to shadow worktree
   367→  const relativePath = path.relative(projectRoot, originalPath);
   368→
   369→  // Skip if path is outside project or already in .kspec
   370→  if (relativePath.startsWith('..') || relativePath.startsWith(SHADOW_WORKTREE_DIR)) {
   371→    return originalPath;
   372→  }
   373→
   374→  // Handle spec/ -> .kspec/ mapping
   375→  if (relativePath.startsWith('spec/') || relativePath.startsWith('spec\\')) {
   376→    const specRelative = relativePath.slice(5); // Remove 'spec/'
   377→    return path.join(shadowConfig.worktreeDir, specRelative);
   378→  }
   379→
   380→  // For task/inbox files at root, move to .kspec
   381→  if (relativePath.endsWith('.tasks.yaml') || relativePath.endsWith('.inbox.yaml')) {
   382→    return path.join(shadowConfig.worktreeDir, relativePath);
   383→  }
   384→
   385→  return originalPath;
   386→}
   387→
   388→/**
   389→ * Commit changes to shadow branch if enabled.
   390→ * This is the primary interface for CLI commands to trigger auto-commit.
   391→ *
   392→ * @param shadowConfig Shadow configuration (from KspecContext.shadow)
   393→ * @param operation Operation type (e.g., 'task-start', 'task-complete')
   394→ * @param ref Reference slug or ULID (optional)
   395→ * @param detail Additional detail for commit message (optional)
   396→ * @returns true if committed, false if shadow not enabled or nothing to commit
   397→ */
   398→export async function commitIfShadow(
   399→  shadowConfig: ShadowConfig | null,
   400→  operation: string,
   401→  ref?: string,
   402→  detail?: string
   403→): Promise<boolean> {
   404→  if (!shadowConfig?.enabled) {
   405→    return false;
   406→  }
   407→
   408→  const message = generateCommitMessage(operation, ref, detail);
   409→  const committed = await shadowAutoCommit(shadowConfig.worktreeDir, message);
   410→
   411→  // AC-1: Fire-and-forget push after each commit
   412→  if (committed) {
   413→    shadowPushAsync(shadowConfig.worktreeDir);
   414→  }
   415→
   416→  return committed;
   417→}
   418→
   419→/**
   420→ * Check if shadow is required but not available, and throw appropriate error.
   421→ * Use this at the start of commands that require shadow mode.
   422→ *
   423→ * @param shadowConfig Shadow configuration from context
   424→ * @param projectRoot Project root for status check
   425→ * @throws ShadowError if shadow is not properly configured
   426→ */
   427→export async function requireShadow(
   428→  shadowConfig: ShadowConfig | null,
   429→  projectRoot: string
   430→): Promise<void> {
   431→  if (shadowConfig?.enabled) {
   432→    return; // Shadow is available
   433→  }
   434→
   435→  const status = await getShadowStatus(projectRoot);
   436→  throw createShadowError(status);
   437→}
   438→
   439→/**
   440→ * Format a ShadowError for display in CLI.
   441→ * Returns a user-friendly message with suggestion.
   442→ */
   443→export function formatShadowError(error: ShadowError): string {
   444→  return `${error.message}\n\nSuggestion: ${error.suggestion}`;
   445→}
   446→
   447→/**
   448→ * Result from shadow initialization
   449→ */
   450→export interface ShadowInitResult {
   451→  success: boolean;
   452→  branchCreated: boolean;
   453→  worktreeCreated: boolean;
   454→  gitignoreUpdated: boolean;
   455→  initialCommit: boolean;
   456→  alreadyExists: boolean;
   457→  /** Whether shadow was created from existing remote branch */
   458→  createdFromRemote: boolean;
   459→  /** Whether new branch was pushed to remote to establish tracking */
   460→  pushedToRemote: boolean;
   461→  error?: string;
   462→}
   463→
   464→/**
   465→ * Options for shadow initialization
   466→ */
   467→export interface ShadowInitOptions {
   468→  /** Project name for manifest */
   469→  projectName?: string;
   470→  /** Force reinitialize even if exists */
   471→  force?: boolean;
   472→}
   473→
   474→/**
   475→ * Check if a remote exists (default: origin)
   476→ */
   477→export async function hasRemote(projectRoot: string, remoteName = 'origin'): Promise<boolean> {
   478→  try {
   479→    const { stdout } = await execAsync(`git remote get-url ${remoteName}`, {
   480→      cwd: projectRoot,
   481→    });
   482→    return stdout.trim().length > 0;
   483→  } catch {
   484→    return false;
   485→  }
   486→}
   487→
   488→/**
   489→ * Check if a branch exists on a remote
   490→ */
   491→export async function remoteBranchExists(
   492→  projectRoot: string,
   493→  branchName: string,
   494→  remoteName = 'origin'
   495→): Promise<boolean> {
   496→  try {
   497→    execSync(`git show-ref --verify --quiet refs/remotes/${remoteName}/${branchName}`, {
   498→      cwd: projectRoot,
   499→      stdio: ['pipe', 'pipe', 'pipe'],
   500→    });
   501→    return true;
   502→  } catch {
   503→    return false;
   504→  }
   505→}
   506→
   507→/**
   508→ * Fetch from remote to ensure refs are up to date.
   509→ * Returns true if fetch succeeded, false otherwise.
   510→ */
   511→export async function fetchRemote(projectRoot: string, remoteName = 'origin'): Promise<boolean> {
   512→  try {
   513→    await execAsync(`git fetch ${remoteName}`, {
   514→      cwd: projectRoot,
   515→    });
   516→    return true;
   517→  } catch {
   518→    return false;
   519→  }
   520→}
   521→
   522→/**
   523→ * Push shadow branch to remote with tracking.
   524→ * Returns true if push succeeded, false otherwise.
   525→ */
   526→export async function pushShadowBranch(
   527→  worktreeDir: string,
   528→  remoteName = 'origin'
   529→): Promise<boolean> {
   530→  try {
   531→    await execAsync(`git push -u ${remoteName} ${SHADOW_BRANCH_NAME}`, {
   532→      cwd: worktreeDir,
   533→    });
   534→    return true;
   535→  } catch {
   536→    return false;
   537→  }
   538→}
   539→
   540→/**
   541→ * Check if shadow branch has remote tracking configured.
   542→ * AC-4: Used to determine whether sync should be attempted.
   543→ */
   544→export async function hasRemoteTracking(worktreeDir: string): Promise<boolean> {
   545→  try {
   546→    const { stdout } = await execAsync(
   547→      `git config branch.${SHADOW_BRANCH_NAME}.remote`,
   548→      { cwd: worktreeDir }
   549→    );
   550→    return stdout.trim().length > 0;
   551→  } catch {
   552→    return false;
   553→  }
   554→}
   555→
   556→/**
   557→ * Ensure shadow branch has remote tracking configured.
   558→ * AC-8: If shadow has no tracking but main branch has origin remote,
   559→ * automatically configure tracking to origin/kspec-meta.
   560→ *
   561→ * @param worktreeDir Path to .kspec/ worktree
   562→ * @param projectRoot Git repository root
   563→ * @returns true if tracking is now configured (was already or just set up)
   564→ */
   565→export async function ensureRemoteTracking(
   566→  worktreeDir: string,
   567→  projectRoot: string
   568→): Promise<boolean> {
   569→  // Check if already has tracking
   570→  if (await hasRemoteTracking(worktreeDir)) {
   571→    return true;
   572→  }
   573→
   574→  // Check if main branch has origin remote
   575→  if (!(await hasRemote(projectRoot))) {
   576→    return false;
   577→  }
   578→
   579→  // Set up tracking for shadow branch to origin/kspec-meta
   580→  try {
   581→    await execAsync(
   582→      `git config branch.${SHADOW_BRANCH_NAME}.remote origin`,
   583→      { cwd: worktreeDir }
   584→    );
   585→    await execAsync(
   586→      `git config branch.${SHADOW_BRANCH_NAME}.merge refs/heads/${SHADOW_BRANCH_NAME}`,
   587→      { cwd: worktreeDir }
   588→    );
   589→    return true;
   590→  } catch {
   591→    return false;
   592→  }
   593→}
   594→
   595→/**
   596→ * Result from a sync operation
   597→ */
   598→export interface ShadowSyncResult {
   599→  success: boolean;
   600→  pulled: boolean;
   601→  pushed: boolean;
   602→  hadConflict: boolean;
   603→  error?: string;
   604→}
   605→
   606→/**
   607→ * Fire-and-forget push to remote.
   608→ * AC-1: Called after each auto-commit when tracking is configured.
   609→ * AC-8: Automatically sets up tracking if main branch has remote.
   610→ * Silently ignores errors - the local commit succeeded regardless.
   611→ */
   612→export async function shadowPushAsync(worktreeDir: string): Promise<void> {
   613→  // AC-8: Auto-configure tracking if main has remote but shadow doesn't
   614→  const projectRoot = path.dirname(worktreeDir);
   615→  await ensureRemoteTracking(worktreeDir, projectRoot);
   616→
   617→  // Check if tracking is configured before attempting push
   618→  if (!(await hasRemoteTracking(worktreeDir))) {
   619→    return; // AC-4: silently skip if no tracking
   620→  }
   621→
   622→  try {
   623→    // Don't await - fire and forget
   624→    execAsync('git push', { cwd: worktreeDir }).catch(() => {
   625→      // Silently ignore push failures - local state is correct
   626→    });
   627→  } catch {
   628→    // Ignore
   629→  }
   630→}
   631→
   632→/**
   633→ * Pull remote changes to shadow branch.
   634→ * AC-2: Called at session start to sync before operations.
   635→ * AC-6: Uses --ff-only first, falls back to --rebase.
   636→ * AC-3: On conflict, returns failure with suggestion.
   637→ * AC-8: Automatically sets up tracking if main branch has remote.
   638→ */
   639→export async function shadowPull(worktreeDir: string): Promise<ShadowSyncResult> {
   640→  const result: ShadowSyncResult = {
   641→    success: false,
   642→    pulled: false,
   643→    pushed: false,
   644→    hadConflict: false,
   645→  };
   646→
   647→  // AC-8: Auto-configure tracking if main has remote but shadow doesn't
   648→  const projectRoot = path.dirname(worktreeDir);
   649→  await ensureRemoteTracking(worktreeDir, projectRoot);
   650→
   651→  // AC-4: Skip if no remote tracking
   652→  if (!(await hasRemoteTracking(worktreeDir))) {
   653→    result.success = true;
   654→    return result;
   655→  }
   656→
   657→  // Check if remote branch exists before attempting pull
   658→  // Fetch first to ensure refs are up to date
   659→  await fetchRemote(projectRoot);
   660→  const remoteHasBranch = await remoteBranchExists(projectRoot, SHADOW_BRANCH_NAME);
   661→  if (!remoteHasBranch) {
   662→    // Remote branch doesn't exist yet - nothing to pull, but success
   663→    result.success = true;
   664→    return result;
   665→  }
   666→
   667→  try {
   668→    // Try fast-forward only first (cleanest)
   669→    await execAsync('git pull --ff-only', { cwd: worktreeDir });
   670→    result.success = true;
   671→    result.pulled = true;
   672→    return result;
   673→  } catch {
   674→    // Fast-forward failed, try rebase
   675→  }
   676→
   677→  try {
   678→    // AC-6: Fall back to rebase
   679→    await execAsync('git pull --rebase', { cwd: worktreeDir });
   680→    result.success = true;
   681→    result.pulled = true;
   682→    return result;
   683→  } catch {
   684→    // Rebase failed - likely conflict
   685→  }
   686→
   687→  // AC-3: Conflict detected - abort rebase and report
   688→  try {
   689→    await execAsync('git rebase --abort', { cwd: worktreeDir });
   690→  } catch {
   691→    // May not be in rebase state, ignore
   692→  }
   693→
   694→  result.hadConflict = true;
   695→  result.error = 'Sync conflict detected. Run `kspec shadow resolve` to fix.';
   696→  return result;
   697→}
   698→
   699→/**
   700→ * Full sync operation: pull then push.
   701→ * Used by session start and explicit sync commands.
   702→ */
   703→export async function shadowSync(worktreeDir: string): Promise<ShadowSyncResult> {
   704→  // First pull
   705→  const pullResult = await shadowPull(worktreeDir);
   706→  if (!pullResult.success) {
   707→    return pullResult;
   708→  }
   709→
   710→  // Then push (only if tracking configured, checked inside)
   711→  if (await hasRemoteTracking(worktreeDir)) {
   712→    try {
   713→      await execAsync('git push', { cwd: worktreeDir });
   714→      pullResult.pushed = true;
   715→    } catch {
   716→      // Push failed - not a critical error, local state is correct
   717→      // Could be permissions, network, etc.
   718→    }
   719→  }
   720→
   721→  return pullResult;
   722→}
   723→
   724→/**
   725→ * Check if .gitignore has uncommitted changes
   726→ */
   727→async function hasUncommittedGitignore(projectRoot: string): Promise<boolean> {
   728→  try {
   729→    // Check both staged and unstaged changes to .gitignore
   730→    const { stdout } = await execAsync('git status --porcelain .gitignore', {
   731→      cwd: projectRoot,
   732→    });
   733→    return stdout.trim().length > 0;
   734→  } catch {
   735→    return false;
   736→  }
   737→}
   738→
   739→/**
   740→ * Commit only .gitignore with a message
   741→ */
   742→async function commitGitignore(projectRoot: string): Promise<void> {
   743→  await execAsync('git add .gitignore', { cwd: projectRoot });
   744→  await execAsync('git commit -m "chore: add .kspec/ to .gitignore for shadow branch"', {
   745→    cwd: projectRoot,
   746→  });
   747→}
   748→
   749→/**
   750→ * Add .kspec/ to .gitignore if not already present.
   751→ * Fails if .gitignore has uncommitted changes.
   752→ * Commits the change after adding.
   753→ */
   754→async function ensureGitignore(projectRoot: string): Promise<boolean> {
   755→  const gitignorePath = path.join(projectRoot, '.gitignore');
   756→  const entry = `${SHADOW_WORKTREE_DIR}/`;
   757→
   758→  // Fail fast if .gitignore has uncommitted changes
   759→  if (await hasUncommittedGitignore(projectRoot)) {
   760→    throw new ShadowError(
   761→      '.gitignore has uncommitted changes',
   762→      'GIT_ERROR',
   763→      'Commit or stash your .gitignore changes before running kspec init.'
   764→    );
   765→  }
   766→
   767→  try {
   768→    let content = '';
   769→    try {
   770→      content = await fs.readFile(gitignorePath, 'utf-8');
   771→    } catch {
   772→      // File doesn't exist, will create
   773→    }
   774→
   775→    // Check if already present (handle various formats)
   776→    const lines = content.split('\n');
   777→    const patterns = [
   778→      SHADOW_WORKTREE_DIR,
   779→      `${SHADOW_WORKTREE_DIR}/`,
   780→      `/${SHADOW_WORKTREE_DIR}`,
   781→      `/${SHADOW_WORKTREE_DIR}/`,
   782→    ];
   783→
   784→    for (const line of lines) {
   785→      const trimmed = line.trim();
   786→      if (patterns.includes(trimmed)) {
   787→        return false; // Already present
   788→      }
   789→    }
   790→
   791→    // Add to gitignore
   792→    const newContent = content.endsWith('\n') || content === ''
   793→      ? `${content}${entry}\n`
   794→      : `${content}\n${entry}\n`;
   795→
   796→    await fs.writeFile(gitignorePath, newContent, 'utf-8');
   797→
   798→    // Commit the change
   799→    await commitGitignore(projectRoot);
   800→
   801→    return true;
   802→  } catch (error) {
   803→    if (error instanceof ShadowError) {
   804→      throw error;
   805→    }
   806→    throw new ShadowError(
   807→      `Failed to update .gitignore: ${error}`,
   808→      'GIT_ERROR',
   809→      'Check file permissions for .gitignore'
   810→    );
   811→  }
   812→}
   813→
   814→/**
   815→ * Generate initial manifest content for shadow branch
   816→ */
   817→function generateShadowManifest(projectName: string): string {
   818→  return `# ${projectName} - Kynetic Spec
   819→# Generated by kspec init
   820→
   821→kynetic: "1.0"
   822→
   823→project:
   824→  name: "${projectName}"
   825→  version: "0.1.0"
   826→  status: draft
   827→  description: |
   828→    Add your project description here.
   829→
   830→# Module includes
   831→includes:
   832→  - modules/main.yaml
   833→
   834→# Configuration
   835→config:
   836→  validation:
   837→    strict_refs: true
   838→    require_acceptance: false
   839→`;
   840→}
   841→
   842→/**
   843→ * Generate initial module content
   844→ */
   845→function generateShadowModule(projectName: string): string {
   846→  return `# ${projectName} - Main Module
   847→# Add your spec items here
   848→
   849→items: []
   850→`;
   851→}
   852→
   853→/**
   854→ * Generate initial tasks file
   855→ */
   856→function generateShadowTasks(projectName: string): string {
   857→  return `# ${projectName} - Tasks
   858→# Track implementation work here
   859→
   860→tasks: []
   861→`;
   862→}
   863→
   864→/**
   865→ * Generate initial inbox file
   866→ */
   867→function generateShadowInbox(): string {
   868→  return `# Inbox - Quick Capture
   869→# Ideas and notes that haven't been triaged yet
   870→
   871→items: []
   872→`;
   873→}
   874→
   875→/**
   876→ * Convert project name to slug (kebab-case)
   877→ */
   878→function toSlug(projectName: string): string {
   879→  return projectName
   880→    .toLowerCase()
   881→    .replace(/[^a-z0-9]+/g, '-')
   882→    .replace(/^-|-$/g, '');
   883→}
   884→
   885→/**
   886→ * Initialize shadow branch and worktree.
   887→ * Creates orphan branch, worktree, updates gitignore, and creates initial structure.
   888→ *
   889→ * @param projectRoot Git repository root
   890→ * @param options Initialization options
   891→ * @returns Result indicating what was created
   892→ */
   893→export async function initializeShadow(
   894→  projectRoot: string,
   895→  options: ShadowInitOptions = {}
   896→): Promise<ShadowInitResult> {
   897→  const result: ShadowInitResult = {
   898→    success: false,
   899→    branchCreated: false,
   900→    worktreeCreated: false,
   901→    gitignoreUpdated: false,
   902→    initialCommit: false,
   903→    alreadyExists: false,
   904→    createdFromRemote: false,
   905→    pushedToRemote: false,
   906→  };
   907→
   908→  // Check if we're in a git repo
   909→  if (!(await isGitRepo(projectRoot))) {
   910→    result.error = 'Not a git repository';
   911→    return result;
   912→  }
   913→
   914→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
   915→
   916→  // Check current status
   917→  const status = await getShadowStatus(projectRoot);
   918→
   919→  // Handle existing shadow branch
   920→  if (status.healthy && !options.force) {
   921→    result.alreadyExists = true;
   922→    result.success = true;
   923→    return result;
   924→  }
   925→
   926→  // Derive project name if not provided
   927→  const projectName = options.projectName || path.basename(projectRoot)
   928→    .replace(/[-_]/g, ' ')
   929→    .replace(/\b\w/g, (c) => c.toUpperCase());
   930→
   931→  const slug = toSlug(projectName);
   932→
   933→  // Check for remote shadow branch (AC-4: fetch to ensure refs are up to date)
   934→  const remoteExists = await hasRemote(projectRoot);
   935→  let remoteHasShadow = false;
   936→  if (remoteExists) {
   937→    await fetchRemote(projectRoot); // Best effort, ignore failures
   938→    remoteHasShadow = await remoteBranchExists(projectRoot, SHADOW_BRANCH_NAME);
   939→  }
   940→
   941→  try {
   942→    // Step 1: Update .gitignore first (before creating .kspec/)
   943→    result.gitignoreUpdated = await ensureGitignore(projectRoot);
   944→
   945→    // Step 2: Create worktree with orphan branch (or attach to existing branch)
   946→    if (!status.worktreeExists || !status.worktreeLinked) {
   947→      // Remove existing directory if present but not linked
   948→      if (status.worktreeExists && !status.worktreeLinked) {
   949→        await fs.rm(worktreeDir, { recursive: true, force: true });
   950→      }
   951→
   952→      // Remove stale worktree reference if any
   953→      try {
   954→        await execAsync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, {
   955→          cwd: projectRoot,
   956→        });
   957→      } catch {
   958→        // Ignore - worktree may not exist in git's list
   959→      }
   960→
   961→      if (remoteHasShadow) {
   962→        // AC-1: Remote has shadow branch - create worktree from it with tracking
   963→        await execAsync(
   964→          `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
   965→          { cwd: projectRoot }
   966→        );
   967→        // Set up tracking for the branch
   968→        await execAsync(
   969→          `git branch --set-upstream-to=origin/${SHADOW_BRANCH_NAME} ${SHADOW_BRANCH_NAME}`,
   970→          { cwd: projectRoot }
   971→        );
   972→        result.createdFromRemote = true;
   973→      } else if (!status.branchExists) {
   974→        // AC-2/AC-3: No remote branch or no remote - create orphan branch
   975→        await execAsync(
   976→          `git worktree add --orphan -b ${SHADOW_BRANCH_NAME} ${SHADOW_WORKTREE_DIR}`,
   977→          { cwd: projectRoot }
   978→        );
   979→        result.branchCreated = true;
   980→      } else {
   981→        // Attach to existing local branch
   982→        await execAsync(
   983→          `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
   984→          { cwd: projectRoot }
   985→        );
   986→      }
   987→
   988→      result.worktreeCreated = true;
   989→    }
   990→
   991→    // Step 3: Create initial structure if empty (only for new branches, not remote)
   992→    const manifestPath = path.join(worktreeDir, `${slug}.yaml`);
   993→    const modulesDir = path.join(worktreeDir, 'modules');
   994→    const moduleFilePath = path.join(modulesDir, 'main.yaml');
   995→    const tasksPath = path.join(worktreeDir, `${slug}.tasks.yaml`);
   996→    const inboxPath = path.join(worktreeDir, `${slug}.inbox.yaml`);
   997→
   998→    let filesCreated = false;
   999→
  1000→    // Only create files if manifest doesn't exist (remote branches will have files)
  1001→    try {
  1002→      // Look for any .yaml manifest file (project name may differ)
  1003→      const files = await fs.readdir(worktreeDir);
  1004→      const hasManifest = files.some(f => f.endsWith('.yaml') && !f.includes('.tasks.') && !f.includes('.inbox.'));
  1005→      if (!hasManifest) {
  1006→        throw new Error('No manifest found');
  1007→      }
  1008→    } catch {
  1009→      // Manifest doesn't exist, create initial structure
  1010→      await fs.mkdir(modulesDir, { recursive: true });
  1011→      await fs.writeFile(manifestPath, generateShadowManifest(projectName), 'utf-8');
  1012→      await fs.writeFile(moduleFilePath, generateShadowModule(projectName), 'utf-8');
  1013→      await fs.writeFile(tasksPath, generateShadowTasks(projectName), 'utf-8');
  1014→      await fs.writeFile(inboxPath, generateShadowInbox(), 'utf-8');
  1015→      filesCreated = true;
  1016→    }
  1017→
  1018→    // Step 4: Initial commit if files were created
  1019→    if (filesCreated) {
  1020→      result.initialCommit = await shadowAutoCommit(
  1021→        worktreeDir,
  1022→        `Initialize ${projectName} spec`
  1023→      );
  1024→    }
  1025→
  1026→    // Step 5: AC-2: Push new branch to remote to establish tracking
  1027→    if (result.branchCreated && remoteExists && !remoteHasShadow) {
  1028→      result.pushedToRemote = await pushShadowBranch(worktreeDir);
  1029→    }
  1030→
  1031→    result.success = true;
  1032→    return result;
  1033→  } catch (error) {
  1034→    result.error = error instanceof Error ? error.message : String(error);
  1035→    return result;
  1036→  }
  1037→}
  1038→
  1039→/**
  1040→ * Repair a broken shadow branch setup.
  1041→ * Handles cases where worktree is disconnected or directory is missing.
  1042→ *
  1043→ * @param projectRoot Git repository root
  1044→ * @returns Result indicating what was repaired
  1045→ */
  1046→export async function repairShadow(projectRoot: string): Promise<ShadowInitResult> {
  1047→  const status = await getShadowStatus(projectRoot);
  1048→
  1049→  if (status.healthy) {
  1050→    return {
  1051→      success: true,
  1052→      branchCreated: false,
  1053→      worktreeCreated: false,
  1054→      gitignoreUpdated: false,
  1055→      initialCommit: false,
  1056→      alreadyExists: true,
  1057→      createdFromRemote: false,
  1058→      pushedToRemote: false,
  1059→    };
  1060→  }
  1061→
  1062→  if (!status.branchExists) {
  1063→    // Can't repair without a branch - need full init
  1064→    return {
  1065→      success: false,
  1066→      branchCreated: false,
  1067→      worktreeCreated: false,
  1068→      gitignoreUpdated: false,
  1069→      initialCommit: false,
  1070→      alreadyExists: false,
  1071→      createdFromRemote: false,
  1072→      pushedToRemote: false,
  1073→      error: 'Shadow branch does not exist. Run `kspec init` instead.',
  1074→    };
  1075→  }
  1076→
  1077→  // Branch exists but worktree is broken - repair it
  1078→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
  1079→
  1080→  try {
  1081→    // Remove stale worktree reference
  1082→    try {
  1083→      await execAsync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, {
  1084→        cwd: projectRoot,
  1085→      });
  1086→    } catch {
  1087→      // Ignore - worktree may not be in git's list
  1088→    }
  1089→
  1090→    // Remove directory if exists (handles corrupted .git file case)
  1091→    await fs.rm(worktreeDir, { recursive: true, force: true });
  1092→
  1093→    // Prune stale worktree references (cleans up orphaned entries)
  1094→    try {
  1095→      await execAsync('git worktree prune', { cwd: projectRoot });
  1096→    } catch {
  1097→      // Ignore - prune is best-effort
  1098→    }
  1099→
  1100→    // Recreate worktree
  1101→    await execAsync(
  1102→      `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1103→      { cwd: projectRoot }
  1104→    );
  1105→
  1106→    return {
  1107→      success: true,
  1108→      branchCreated: false,
  1109→      worktreeCreated: true,
  1110→      gitignoreUpdated: false,
  1111→      initialCommit: false,
  1112→      alreadyExists: false,
  1113→      createdFromRemote: false,
  1114→      pushedToRemote: false,
  1115→    };
  1116→  } catch (error) {
  1117→    return {
  1118→      success: false,
  1119→      branchCreated: false,
  1120→      worktreeCreated: false,
  1121→      gitignoreUpdated: false,
  1122→      initialCommit: false,
  1123→      alreadyExists: false,
  1124→      createdFromRemote: false,
  1125→      pushedToRemote: false,
  1126→      error: error instanceof Error ? error.message : String(error),
  1127→    };
  1128→  }
  1129→}
  1130→

