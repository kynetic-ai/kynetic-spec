```
     1→/**
     2→ * Meta CLI commands for interacting with meta-spec.
     3→ *
     4→ * AC-meta-manifest-1: kspec meta show outputs summary
     5→ * AC-meta-manifest-2: kspec validate includes meta line
     6→ * AC-meta-manifest-3: kspec validate shows meta errors with prefix
     7→ * AC-agent-1: kspec meta agents outputs table
     8→ * AC-agent-2: kspec meta agents --json outputs JSON
     9→ */
    10→
    11→import { Command } from 'commander';
    12→import chalk from 'chalk';
    13→import Table from 'cli-table3';
    14→import { ulid } from 'ulid';
    15→import {
    16→  initContext,
    17→  loadMetaContext,
    18→  getMetaStats,
    19→  createObservation,
    20→  saveObservation,
    21→  saveMetaItem,
    22→  deleteMetaItem,
    23→  createTask,
    24→  saveTask,
    25→  loadAllTasks,
    26→  loadAllItems,
    27→  ReferenceIndex,
    28→  type MetaContext,
    29→  type Agent,
    30→  type Workflow,
    31→  type Convention,
    32→  type Observation,
    33→  type LoadedTask,
    34→} from '../../parser/index.js';
    35→import { type ObservationType } from '../../schema/index.js';
    36→import { output, error, success, isJsonMode } from '../output.js';
    37→import { errors } from '../../strings/errors.js';
    38→import { commitIfShadow } from '../../parser/shadow.js';
    39→
    40→/**
    41→ * Resolve a meta reference to its ULID
    42→ * Handles semantic IDs (agent.id, workflow.id, convention.domain) and ULID prefixes
    43→ */
    44→function resolveMetaRefToUlid(
    45→  ref: string,
    46→  metaCtx: MetaContext
    47→): { ulid: string; type: 'agent' | 'workflow' | 'convention' | 'observation' } | null {
    48→  const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
    49→
    50→  // Check agents
    51→  const agent = (metaCtx.agents || []).find(
    52→    (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
    53→  );
    54→  if (agent) return { ulid: agent._ulid, type: 'agent' };
    55→
    56→  // Check workflows
    57→  const workflow = (metaCtx.workflows || []).find(
    58→    (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
    59→  );
    60→  if (workflow) return { ulid: workflow._ulid, type: 'workflow' };
    61→
    62→  // Check conventions
    63→  const convention = (metaCtx.conventions || []).find(
    64→    (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
    65→  );
    66→  if (convention) return { ulid: convention._ulid, type: 'convention' };
    67→
    68→  // Check observations
    69→  const observation = (metaCtx.observations || []).find((o) =>
    70→    o._ulid.startsWith(normalizedRef)
    71→  );
    72→  if (observation) return { ulid: observation._ulid, type: 'observation' };
    73→
    74→  return null;
    75→}
    76→
    77→/**
    78→ * Format meta show output
    79→ */
    80→function formatMetaShow(meta: MetaContext): void {
    81→  const stats = getMetaStats(meta);
    82→
    83→  if (!meta.manifest) {
    84→    console.log(chalk.yellow('No meta manifest found (kynetic.meta.yaml)'));
    85→    console.log(chalk.gray('Create one to define agents, workflows, conventions, and observations'));
    86→    return;
    87→  }
    88→
    89→  console.log(chalk.bold('Meta-Spec Summary'));
    90→  console.log(chalk.gray('─'.repeat(40)));
    91→  console.log(`Agents:       ${stats.agents}`);
    92→  console.log(`Workflows:    ${stats.workflows}`);
    93→  console.log(`Conventions:  ${stats.conventions}`);
    94→  console.log(`Observations: ${stats.observations} (${stats.unresolvedObservations} unresolved)`);
    95→}
    96→
    97→/**
    98→ * Format agents table output
    99→ * AC-agent-1: outputs table with columns: ID, Name, Capabilities
   100→ */
   101→function formatAgents(agents: Agent[]): void {
   102→  if (agents.length === 0) {
   103→    console.log(chalk.yellow('No agents defined'));
   104→    return;
   105→  }
   106→
   107→  const table = new Table({
   108→    head: [chalk.bold('ID'), chalk.bold('Name'), chalk.bold('Capabilities')],
   109→    style: {
   110→      head: [],
   111→      border: [],
   112→    },
   113→  });
   114→
   115→  for (const agent of agents) {
   116→    table.push([
   117→      agent.id,
   118→      agent.name,
   119→      agent.capabilities.join(', '),
   120→    ]);
   121→  }
   122→
   123→  console.log(table.toString());
   124→}
   125→
   126→/**
   127→ * Format workflows table output
   128→ * AC-workflow-1: outputs table with columns: ID, Trigger, Steps (count)
   129→ */
   130→function formatWorkflows(workflows: Workflow[]): void {
   131→  if (workflows.length === 0) {
   132→    console.log(chalk.yellow('No workflows defined'));
   133→    return;
   134→  }
   135→
   136→  const table = new Table({
   137→    head: [chalk.bold('ID'), chalk.bold('Trigger'), chalk.bold('Steps')],
   138→    style: {
   139→      head: [],
   140→      border: [],
   141→    },
   142→  });
   143→
   144→  for (const workflow of workflows) {
   145→    table.push([
   146→      workflow.id,
   147→      workflow.trigger,
   148→      workflow.steps.length.toString(),
   149→    ]);
   150→  }
   151→
   152→  console.log(table.toString());
   153→}
   154→
   155→/**
   156→ * Format workflows verbose output
   157→ * AC-workflow-2: outputs each workflow with full step list
   158→ */
   159→function formatWorkflowsVerbose(workflows: Workflow[]): void {
   160→  if (workflows.length === 0) {
   161→    console.log(chalk.yellow('No workflows defined'));
   162→    return;
   163→  }
   164→
   165→  for (const workflow of workflows) {
   166→    console.log(chalk.bold(`${workflow.id} - ${workflow.trigger}`));
   167→    if (workflow.description) {
   168→      console.log(chalk.gray(workflow.description));
   169→    }
   170→    console.log(chalk.gray('─'.repeat(60)));
   171→
   172→    for (const step of workflow.steps) {
   173→      const prefix = {
   174→        check: chalk.yellow('[check]'),
   175→        action: chalk.blue('[action]'),
   176→        decision: chalk.magenta('[decision]'),
   177→      }[step.type];
   178→
   179→      console.log(`${prefix} ${step.content}`);
   180→
   181→      if (step.on_fail) {
   182→        console.log(chalk.gray(`  → on fail: ${step.on_fail}`));
   183→      }
   184→
   185→      if (step.options && step.options.length > 0) {
   186→        for (const option of step.options) {
   187→          console.log(chalk.gray(`  • ${option}`));
   188→        }
   189→      }
   190→    }
   191→
   192→    console.log('');
   193→  }
   194→}
   195→
   196→/**
   197→ * Format conventions table output
   198→ * AC-conv-1: outputs table with columns: Domain, Rules (count), Validation (yes/no)
   199→ */
   200→function formatConventions(conventions: Convention[]): void {
   201→  if (conventions.length === 0) {
   202→    console.log(chalk.yellow('No conventions defined'));
   203→    return;
   204→  }
   205→
   206→  const table = new Table({
   207→    head: [chalk.bold('Domain'), chalk.bold('Rules'), chalk.bold('Validation')],
   208→    style: {
   209→      head: [],
   210→      border: [],
   211→    },
   212→  });
   213→
   214→  for (const convention of conventions) {
   215→    table.push([
   216→      convention.domain,
   217→      convention.rules.length.toString(),
   218→      convention.validation ? 'yes' : 'no',
   219→    ]);
   220→  }
   221→
   222→  console.log(table.toString());
   223→}
   224→
   225→/**
   226→ * Format convention detail output
   227→ * AC-conv-2: outputs full rules list and examples
   228→ */
   229→function formatConventionDetail(convention: Convention): void {
   230→  console.log(chalk.bold(`${convention.domain} Convention`));
   231→  console.log(chalk.gray('─'.repeat(60)));
   232→
   233→  console.log(chalk.bold('\nRules:'));
   234→  for (const rule of convention.rules) {
   235→    console.log(`  • ${rule}`);
   236→  }
   237→
   238→  if (convention.examples && convention.examples.length > 0) {
   239→    console.log(chalk.bold('\nExamples:'));
   240→    for (const example of convention.examples) {
   241→      console.log(chalk.green(`  ✓ ${example.good}`));
   242→      console.log(chalk.red(`  ✗ ${example.bad}`));
   243→    }
   244→  }
   245→
   246→  if (convention.validation) {
   247→    console.log(chalk.bold('\nValidation:'));
   248→    console.log(`  Type: ${convention.validation.type}`);
   249→    if (convention.validation.pattern) {
   250→      console.log(`  Pattern: ${convention.validation.pattern}`);
   251→    }
   252→    if (convention.validation.message) {
   253→      console.log(`  Message: ${convention.validation.message}`);
   254→    }
   255→  }
   256→
   257→  console.log('');
   258→}
   259→
   260→/**
   261→ * Format observations table output
   262→ * AC-obs-2: outputs table with columns: ID, Type, Workflow, Created, Content (truncated)
   263→ */
   264→function formatObservations(observations: Observation[], showResolved: boolean): void {
   265→  const filtered = showResolved ? observations : observations.filter(o => !o.resolved);
   266→
   267→  if (filtered.length === 0) {
   268→    console.log(chalk.yellow(showResolved ? 'No observations found' : 'No unresolved observations'));
   269→    return;
   270→  }
   271→
   272→  const table = new Table({
   273→    head: [
   274→      chalk.bold('ID'),
   275→      chalk.bold('Type'),
   276→      chalk.bold('Workflow'),
   277→      chalk.bold('Created'),
   278→      chalk.bold('Content'),
   279→    ],
   280→    style: {
   281→      head: [],
   282→      border: [],
   283→    },
   284→    colWidths: [10, 10, 20, 12, 50],
   285→    wordWrap: true,
   286→  });
   287→
   288→  for (const obs of filtered) {
   289→    const id = obs._ulid.substring(0, 8);
   290→    const workflow = obs.workflow_ref || '-';
   291→    const created = new Date(obs.created_at).toISOString().split('T')[0];
   292→    const content = obs.content.length > 47 ? obs.content.substring(0, 47) + '...' : obs.content;
   293→
   294→    table.push([id, obs.type, workflow, created, content]);
   295→  }
   296→
   297→  console.log(table.toString());
   298→}
   299→
   300→/**
   301→ * Register meta commands
   302→ */
   303→export function registerMetaCommands(program: Command): void {
   304→  const meta = program
   305→    .command('meta')
   306→    .description('Meta-spec commands (agents, workflows, conventions, observations)');
   307→
   308→  // AC-meta-manifest-1: kspec meta show outputs summary with counts
   309→  meta
   310→    .command('show')
   311→    .description('Display meta-spec summary')
   312→    .action(async () => {
   313→      try {
   314→        const ctx = await initContext();
   315→
   316→        if (!ctx.manifestPath) {
   317→          error(errors.project.noKspecProject);
   318→          process.exit(1);
   319→        }
   320→
   321→        const metaCtx = await loadMetaContext(ctx);
   322→        const stats = getMetaStats(metaCtx);
   323→
   324→        output(
   325→          {
   326→            manifest: metaCtx.manifestPath,
   327→            stats,
   328→          },
   329→          () => formatMetaShow(metaCtx)
   330→        );
   331→      } catch (err) {
   332→        error(errors.failures.showMeta, err);
   333→        process.exit(1);
   334→      }
   335→    });
   336→
   337→  // AC-agent-1, AC-agent-2: kspec meta agents
   338→  meta
   339→    .command('agents')
   340→    .description('List agents defined in meta-spec')
   341→    .action(async () => {
   342→      try {
   343→        const ctx = await initContext();
   344→
   345→        if (!ctx.manifestPath) {
   346→          error(errors.project.noKspecProject);
   347→          process.exit(1);
   348→        }
   349→
   350→        const metaCtx = await loadMetaContext(ctx);
   351→        const agents = metaCtx.agents || [];
   352→
   353→        // AC-agent-2: JSON output includes full agent details
   354→        output(
   355→          agents.map((agent) => ({
   356→            id: agent.id,
   357→            name: agent.name,
   358→            description: agent.description,
   359→            capabilities: agent.capabilities,
   360→            tools: agent.tools,
   361→            session_protocol: agent.session_protocol,
   362→            conventions: agent.conventions,
   363→          })),
   364→          // AC-agent-1: Table output with ID, Name, Capabilities
   365→          () => formatAgents(agents)
   366→        );
   367→      } catch (err) {
   368→        error(errors.failures.listAgents, err);
   369→        process.exit(1);
   370→      }
   371→    });
   372→
   373→  // AC-workflow-1, AC-workflow-2, AC-workflow-4: kspec meta workflows
   374→  meta
   375→    .command('workflows')
   376→    .description('List workflows defined in meta-spec')
   377→    .option('--verbose', 'Show full workflow details with all steps')
   378→    .action(async (options) => {
   379→      try {
   380→        const ctx = await initContext();
   381→
   382→        if (!ctx.manifestPath) {
   383→          error(errors.project.noKspecProject);
   384→          process.exit(1);
   385→        }
   386→
   387→        const metaCtx = await loadMetaContext(ctx);
   388→        const workflows = metaCtx.workflows || [];
   389→
   390→        // AC-workflow-4: JSON output includes full workflow details
   391→        output(
   392→          workflows.map((workflow) => ({
   393→            id: workflow.id,
   394→            trigger: workflow.trigger,
   395→            description: workflow.description,
   396→            steps: workflow.steps,
   397→          })),
   398→          // AC-workflow-1 (table) or AC-workflow-2 (verbose)
   399→          () => {
   400→            if (options.verbose) {
   401→              formatWorkflowsVerbose(workflows);
   402→            } else {
   403→              formatWorkflows(workflows);
   404→            }
   405→          }
   406→        );
   407→      } catch (err) {
   408→        error(errors.failures.listWorkflows, err);
   409→        process.exit(1);
   410→      }
   411→    });
   412→
   413→  // AC-conv-1, AC-conv-2, AC-conv-5: kspec meta conventions
   414→  meta
   415→    .command('conventions')
   416→    .description('List conventions defined in meta-spec')
   417→    .option('--domain <domain>', 'Filter by specific domain')
   418→    .action(async (options) => {
   419→      try {
   420→        const ctx = await initContext();
   421→
   422→        if (!ctx.manifestPath) {
   423→          error(errors.project.noKspecProject);
   424→          process.exit(1);
   425→        }
   426→
   427→        const metaCtx = await loadMetaContext(ctx);
   428→        const conventions = metaCtx.conventions || [];
   429→
   430→        // AC-conv-2: Filter by domain if specified
   431→        const filtered = options.domain
   432→          ? conventions.filter((c) => c.domain === options.domain)
   433→          : conventions;
   434→
   435→        // AC-conv-5: JSON output includes full convention details
   436→        output(
   437→          filtered.map((convention) => ({
   438→            domain: convention.domain,
   439→            rules: convention.rules,
   440→            examples: convention.examples,
   441→            validation: convention.validation,
   442→          })),
   443→          // AC-conv-1 (table) or AC-conv-2 (detail for single domain)
   444→          () => {
   445→            if (options.domain && filtered.length === 1) {
   446→              formatConventionDetail(filtered[0]);
   447→            } else {
   448→              formatConventions(filtered);
   449→            }
   450→          }
   451→        );
   452→      } catch (err) {
   453→        error(errors.failures.listConventions, err);
   454→        process.exit(1);
   455→      }
   456→    });
   457→
   458→  // meta-get-cmd: kspec meta get <ref>
   459→  meta
   460→    .command('get <ref>')
   461→    .description('Get a meta item by reference (agent, workflow, convention, or observation)')
   462→    .action(async (ref: string) => {
   463→      try {
   464→        const ctx = await initContext();
   465→
   466→        if (!ctx.manifestPath) {
   467→          error(errors.project.noKspecProject);
   468→          process.exit(1);
   469→        }
   470→
   471→        const metaCtx = await loadMetaContext(ctx);
   472→
   473→        // Normalize reference
   474→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   475→
   476→        // Search in all meta item types
   477→        const agents = metaCtx.agents || [];
   478→        const workflows = metaCtx.workflows || [];
   479→        const conventions = metaCtx.conventions || [];
   480→        const observations = metaCtx.observations || [];
   481→
   482→        // Try to find by ID or ULID prefix
   483→        let found: any = null;
   484→        let itemType: string = '';
   485→
   486→        // Check agents (by id or ULID)
   487→        const agent = agents.find((a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef));
   488→        if (agent) {
   489→          found = agent;
   490→          itemType = 'agent';
   491→        }
   492→
   493→        // Check workflows (by id or ULID)
   494→        if (!found) {
   495→          const workflow = workflows.find((w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef));
   496→          if (workflow) {
   497→            found = workflow;
   498→            itemType = 'workflow';
   499→          }
   500→        }
   501→
   502→        // Check conventions (by domain or ULID)
   503→        if (!found) {
   504→          const convention = conventions.find((c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef));
   505→          if (convention) {
   506→            found = convention;
   507→            itemType = 'convention';
   508→          }
   509→        }
   510→
   511→        // Check observations (by ULID)
   512→        if (!found) {
   513→          const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   514→          if (observation) {
   515→            found = observation;
   516→            itemType = 'observation';
   517→          }
   518→        }
   519→
   520→        if (!found) {
   521→          error(errors.reference.metaNotFound(ref));
   522→          process.exit(1);
   523→        }
   524→
   525→        // Output the item
   526→        output(found, () => {
   527→          console.log(chalk.bold(`${itemType.charAt(0).toUpperCase() + itemType.slice(1)}: ${ref}`));
   528→          console.log(chalk.gray('─'.repeat(60)));
   529→          console.log(JSON.stringify(found, null, 2));
   530→        });
   531→      } catch (err) {
   532→        error(errors.failures.getMetaItem, err);
   533→        process.exit(1);
   534→      }
   535→    });
   536→
   537→  // meta-list-cmd: kspec meta list
   538→  meta
   539→    .command('list')
   540→    .description('List all meta items')
   541→    .option('--type <type>', 'Filter by type (agent, workflow, convention, observation)')
   542→    .action(async (options) => {
   543→      try {
   544→        const ctx = await initContext();
   545→
   546→        if (!ctx.manifestPath) {
   547→          error(errors.project.noKspecProject);
   548→          process.exit(1);
   549→        }
   550→
   551→        const metaCtx = await loadMetaContext(ctx);
   552→
   553→        // Collect all meta items with type information
   554→        interface MetaListItem {
   555→          id: string;
   556→          type: string;
   557→          context: string;
   558→          ulid: string;
   559→        }
   560→
   561→        const items: MetaListItem[] = [];
   562→
   563→        // Add agents
   564→        if (!options.type || options.type === 'agent') {
   565→          for (const agent of metaCtx.agents || []) {
   566→            items.push({
   567→              id: agent.id,
   568→              type: 'agent',
   569→              context: agent.name,
   570→              ulid: agent._ulid,
   571→            });
   572→          }
   573→        }
   574→
   575→        // Add workflows
   576→        if (!options.type || options.type === 'workflow') {
   577→          for (const workflow of metaCtx.workflows || []) {
   578→            items.push({
   579→              id: workflow.id,
   580→              type: 'workflow',
   581→              context: workflow.trigger,
   582→              ulid: workflow._ulid,
   583→            });
   584→          }
   585→        }
   586→
   587→        // Add conventions
   588→        if (!options.type || options.type === 'convention') {
   589→          for (const convention of metaCtx.conventions || []) {
   590→            items.push({
   591→              id: convention.domain,
   592→              type: 'convention',
   593→              context: `${convention.rules.length} rules`,
   594→              ulid: convention._ulid,
   595→            });
   596→          }
   597→        }
   598→
   599→        // Add observations
   600→        if (!options.type || options.type === 'observation') {
   601→          for (const observation of metaCtx.observations || []) {
   602→            const ulidPrefix = observation._ulid.substring(0, 8);
   603→            items.push({
   604→              id: ulidPrefix,
   605→              type: 'observation',
   606→              context: `${observation.type} ${observation.resolved ? '(resolved)' : ''}`,
   607→              ulid: observation._ulid,
   608→            });
   609→          }
   610→        }
   611→
   612→        // Output
   613→        output(items, () => {
   614→          if (items.length === 0) {
   615→            console.log(chalk.yellow('No meta items found'));
   616→            return;
   617→          }
   618→
   619→          const table = new Table({
   620→            head: [chalk.bold('ID'), chalk.bold('Type'), chalk.bold('Context')],
   621→            style: {
   622→              head: [],
   623→              border: [],
   624→            },
   625→          });
   626→
   627→          for (const item of items) {
   628→            table.push([item.id, item.type, item.context]);
   629→          }
   630→
   631→          console.log(table.toString());
   632→        });
   633→      } catch (err) {
   634→        error(errors.failures.listMetaItems, err);
   635→        process.exit(1);
   636→      }
   637→    });
   638→
   639→  // AC-obs-1: kspec meta observe <type> <content>
   640→  meta
   641→    .command('observe <type> <content>')
   642→    .description('Create an observation (friction, success, question, idea)')
   643→    .option('--workflow <ref>', 'Reference to workflow this observation relates to')
   644→    .option('--author <author>', 'Author of the observation')
   645→    .action(async (type: string, content: string, options) => {
   646→      try {
   647→        const ctx = await initContext();
   648→
   649→        if (!ctx.manifestPath) {
   650→          error(errors.project.noKspecProject);
   651→          process.exit(1);
   652→        }
   653→
   654→        // Validate observation type
   655→        const validTypes: ObservationType[] = ['friction', 'success', 'question', 'idea'];
   656→        if (!validTypes.includes(type as ObservationType)) {
   657→          error(errors.validation.invalidObservationType(type));
   658→          console.log(`Valid types: ${validTypes.join(', ')}`);
   659→          process.exit(1);
   660→        }
   661→
   662→        // Create observation
   663→        const observation = createObservation(type as ObservationType, content, {
   664→          workflow_ref: options.workflow,
   665→          author: options.author,
   666→        });
   667→
   668→        // Save to manifest
   669→        await saveObservation(ctx, observation);
   670→
   671→        // AC-obs-1: outputs "OK Created observation: <ULID-prefix>"
   672→        // In JSON mode, return the created observation object
   673→        output(
   674→          observation,
   675→          () => success(`Created observation: ${observation._ulid.substring(0, 8)}`)
   676→        );
   677→      } catch (err) {
   678→        error(errors.failures.createObservation, err);
   679→        process.exit(1);
   680→      }
   681→    });
   682→
   683→  // AC-obs-2, AC-obs-5: kspec meta observations
   684→  meta
   685→    .command('observations')
   686→    .description('List observations (shows unresolved by default)')
   687→    .option('--type <type>', 'Filter by observation type (friction/success/question/idea)')
   688→    .option('--workflow <ref>', 'Filter by workflow reference')
   689→    .option('--all', 'Include resolved observations')
   690→    .option('--promoted', 'Show only observations promoted to tasks')
   691→    .option('--pending-resolution', 'Show observations with completed tasks awaiting resolution')
   692→    .action(async (options) => {
   693→      try {
   694→        const ctx = await initContext();
   695→
   696→        if (!ctx.manifestPath) {
   697→          error(errors.project.noKspecProject);
   698→          process.exit(1);
   699→        }
   700→
   701→        const metaCtx = await loadMetaContext(ctx);
   702→        let observations = metaCtx.observations || [];
   703→
   704→        // Apply filters
   705→        if (options.type) {
   706→          observations = observations.filter((obs) => obs.type === options.type);
   707→        }
   708→
   709→        if (options.workflow) {
   710→          observations = observations.filter((obs) => obs.workflow_ref === options.workflow);
   711→        }
   712→
   713→        if (options.promoted) {
   714→          observations = observations.filter((obs) => obs.promoted_to !== undefined);
   715→        }
   716→
   717→        if (options.pendingResolution) {
   718→          // Load tasks to check if promoted tasks are completed
   719→          const tasks = await loadAllTasks(ctx);
   720→          const items = await loadAllItems(ctx);
   721→          const index = new ReferenceIndex(tasks, items);
   722→
   723→          observations = observations.filter((obs) => {
   724→            if (!obs.promoted_to || obs.resolved) return false;
   725→            const taskResult = index.resolve(obs.promoted_to);
   726→            if (!taskResult.ok) return false;
   727→            const item = taskResult.item;
   728→            // Type guard: check if item is a task (has status and depends_on properties)
   729→            return 'status' in item && 'depends_on' in item && item.status === 'completed';
   730→          });
   731→        }
   732→
   733→        // AC-obs-5: JSON output includes full observation objects
   734→        output(
   735→          observations.map((obs) => ({
   736→            _ulid: obs._ulid,
   737→            type: obs.type,
   738→            content: obs.content,
   739→            workflow_ref: obs.workflow_ref ?? null,
   740→            created_at: obs.created_at,
   741→            author: obs.author ?? null,
   742→            resolved: obs.resolved,
   743→            resolution: obs.resolution ?? null,
   744→            resolved_at: obs.resolved_at ?? null,
   745→            resolved_by: obs.resolved_by ?? null,
   746→            promoted_to: obs.promoted_to ?? null,
   747→          })),
   748→          // AC-obs-2: Table output with ID, Type, Workflow, Created, Content
   749→          () => formatObservations(observations, options.all)
   750→        );
   751→      } catch (err) {
   752→        error(errors.failures.listObservations, err);
   753→        process.exit(1);
   754→      }
   755→    });
   756→
   757→  // AC-obs-3, AC-obs-6, AC-obs-8: kspec meta promote
   758→  meta
   759→    .command('promote <ref>')
   760→    .description('Promote observation to a task')
   761→    .requiredOption('--title <title>', 'Task title')
   762→    .option('--priority <priority>', 'Task priority (1-5)', '2')
   763→    .option('--force', 'Force promotion even if observation is resolved')
   764→    .action(async (ref: string, options) => {
   765→      try {
   766→        const ctx = await initContext();
   767→
   768→        if (!ctx.manifestPath) {
   769→          error(errors.project.noKspecProject);
   770→          process.exit(1);
   771→        }
   772→
   773→        const metaCtx = await loadMetaContext(ctx);
   774→        const observations = metaCtx.observations || [];
   775→
   776→        // Find observation
   777→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   778→        const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   779→
   780→        if (!observation) {
   781→          error(errors.reference.observationNotFound(ref));
   782→          process.exit(1);
   783→        }
   784→
   785→        // AC-obs-6: Check if already promoted
   786→        if (observation.promoted_to) {
   787→          error(errors.conflict.observationAlreadyPromoted(observation.promoted_to));
   788→          process.exit(1);
   789→        }
   790→
   791→        // AC-obs-8: Check if resolved
   792→        if (observation.resolved && !options.force) {
   793→          error(errors.operation.cannotPromoteResolved);
   794→          process.exit(1);
   795→        }
   796→
   797→        // AC-obs-3: Create task with title, description from observation, meta_ref, and origin
   798→        const task = createTask({
   799→          title: options.title,
   800→          description: observation.content,
   801→          priority: Number.parseInt(options.priority, 10),
   802→          meta_ref: observation.workflow_ref,
   803→          origin: 'observation_promotion',
   804→        });
   805→
   806→        // Save task
   807→        await saveTask(ctx, task);
   808→        await commitIfShadow(ctx.shadow, 'task-add', task.slugs[0] || task._ulid.slice(0, 8), task.title);
   809→        const taskRef = `@${task._ulid.substring(0, 8)}`;
   810→
   811→        // Update observation with promoted_to field
   812→        observation.promoted_to = taskRef;
   813→        await saveObservation(ctx, observation);
   814→
   815→        // AC-obs-3: outputs "OK Created task: <ULID-prefix>"
   816→        // In JSON mode, return the created task object
   817→        output(
   818→          task,
   819→          () => success(`Created task: ${taskRef.substring(0, 9)}`)
   820→        );
   821→      } catch (err) {
   822→        error(errors.failures.promoteObservation, err);
   823→        process.exit(1);
   824→      }
   825→    });
   826→
   827→  // AC-obs-4, AC-obs-7, AC-obs-9: kspec meta resolve
   828→  meta
   829→    .command('resolve <ref> [resolution]')
   830→    .description('Resolve an observation')
   831→    .action(async (ref: string, resolution: string | undefined) => {
   832→      try {
   833→        const ctx = await initContext();
   834→
   835→        if (!ctx.manifestPath) {
   836→          error(errors.project.noKspecProject);
   837→          process.exit(1);
   838→        }
   839→
   840→        const metaCtx = await loadMetaContext(ctx);
   841→        const observations = metaCtx.observations || [];
   842→
   843→        // Find observation
   844→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   845→        const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   846→
   847→        if (!observation) {
   848→          error(errors.reference.observationNotFound(ref));
   849→          process.exit(1);
   850→        }
   851→
   852→        // AC-obs-7: Check if already resolved
   853→        if (observation.resolved) {
   854→          const resolvedDate = new Date(observation.resolved_at!).toISOString().split('T')[0];
   855→          const resolutionText = observation.resolution || '';
   856→          const truncated = resolutionText.length > 50
   857→            ? resolutionText.substring(0, 50) + '...'
   858→            : resolutionText;
   859→          error(errors.conflict.observationAlreadyResolved(resolvedDate, truncated));
   860→          process.exit(1);
   861→        }
   862→
   863→        // AC-obs-9: Auto-populate resolution from task completion if promoted
   864→        let finalResolution = resolution;
   865→        if (!finalResolution && observation.promoted_to) {
   866→          // Fetch task to get completion reason
   867→          const tasks = await loadAllTasks(ctx);
   868→          const items = await loadAllItems(ctx);
   869→          const index = new ReferenceIndex(tasks, items);
   870→          const taskResult = index.resolve(observation.promoted_to);
   871→
   872→          if (taskResult.ok) {
   873→            const item = taskResult.item;
   874→            // Type guard: ensure this is a task (has status and depends_on properties)
   875→            if ('status' in item && 'depends_on' in item) {
   876→              const task = item as LoadedTask;
   877→              if (task.status === 'completed' && task.closed_reason) {
   878→                finalResolution = `Resolved via task ${observation.promoted_to}: ${task.closed_reason}`;
   879→              } else if (task.status === 'completed') {
   880→                finalResolution = `Resolved via task ${observation.promoted_to}`;
   881→              } else {
   882→                error(`Task ${observation.promoted_to} is not completed yet`);
   883→                process.exit(1);
   884→              }
   885→            } else {
   886→              error(`Reference ${observation.promoted_to} is not a task`);
   887→              process.exit(1);
   888→            }
   889→          } else {
   890→            error(`Task ${observation.promoted_to} not found`);
   891→            process.exit(1);
   892→          }
   893→        }
   894→
   895→        if (!finalResolution) {
   896→          error(errors.validation.resolutionRequired);
   897→          process.exit(1);
   898→        }
   899→
   900→        // AC-obs-4: Update observation
   901→        observation.resolved = true;
   902→        observation.resolution = finalResolution;
   903→        observation.resolved_at = new Date().toISOString();
   904→        observation.resolved_by = observation.author; // Use same author
   905→
   906→        await saveObservation(ctx, observation);
   907→
   908→        // AC-obs-4: outputs "OK Resolved: <ULID-prefix>"
   909→        success(`Resolved: ${observation._ulid.substring(0, 8)}`);
   910→      } catch (err) {
   911→        error(errors.failures.resolveObservation, err);
   912→        process.exit(1);
   913→      }
   914→    });
   915→
   916→  // Meta add command - create new meta items
   917→  meta
   918→    .command('add <type>')
   919→    .description('Create a new meta item (agent, workflow, or convention)')
   920→    .option('--id <id>', 'Semantic ID (required for agents and workflows)')
   921→    .option('--domain <domain>', 'Domain (required for conventions)')
   922→    .option('--name <name>', 'Name (for agents)')
   923→    .option('--trigger <trigger>', 'Trigger (for workflows)')
   924→    .option('--description <desc>', 'Description')
   925→    .option('--capability <cap...>', 'Capabilities (for agents)')
   926→    .option('--tool <tool...>', 'Tools (for agents)')
   927→    .option('--convention <conv...>', 'Convention references (for agents)')
   928→    .option('--rule <rule...>', 'Rules (for conventions)')
   929→    .action(async (type: string, options) => {
   930→      try {
   931→        const ctx = await initContext();
   932→
   933→        // Validate type
   934→        const validTypes = ['agent', 'workflow', 'convention'];
   935→        if (!validTypes.includes(type)) {
   936→          error(errors.validation.invalidType(type, validTypes));
   937→          process.exit(1);
   938→        }
   939→
   940→        // Generate ULID
   941→        const itemUlid = ulid();
   942→
   943→        // Create the item based on type
   944→        let item: Agent | Workflow | Convention;
   945→
   946→        if (type === 'agent') {
   947→          // Validate required fields
   948→          if (!options.id) {
   949→            error(errors.validation.agentRequiresId);
   950→            process.exit(1);
   951→          }
   952→          if (!options.name) {
   953→            error(errors.validation.agentRequiresName);
   954→            process.exit(1);
   955→          }
   956→
   957→          item = {
   958→            _ulid: itemUlid,
   959→            id: options.id,
   960→            name: options.name,
   961→            description: options.description || '',
   962→            capabilities: options.capability || [],
   963→            tools: options.tool || [],
   964→            conventions: options.convention || [],
   965→          };
   966→        } else if (type === 'workflow') {
   967→          // Validate required fields
   968→          if (!options.id) {
   969→            error(errors.validation.workflowRequiresId);
   970→            process.exit(1);
   971→          }
   972→          if (!options.trigger) {
   973→            error(errors.validation.workflowRequiresTrigger);
   974→            process.exit(1);
   975→          }
   976→
   977→          item = {
   978→            _ulid: itemUlid,
   979→            id: options.id,
   980→            trigger: options.trigger,
   981→            description: options.description || '',
   982→            steps: [],
   983→          };
   984→        } else {
   985→          // convention
   986→          if (!options.domain) {
   987→            error(errors.validation.conventionRequiresDomain);
   988→            process.exit(1);
   989→          }
   990→
   991→          item = {
   992→            _ulid: itemUlid,
   993→            domain: options.domain,
   994→            rules: options.rule || [],
   995→            examples: [],
   996→          };
   997→        }
   998→
   999→        // Save the item
  1000→        await saveMetaItem(ctx, item, type as 'agent' | 'workflow' | 'convention');
  1001→
  1002→        if (isJsonMode()) {
  1003→          // In JSON mode, output the item data directly
  1004→          console.log(JSON.stringify(item, null, 2));
  1005→        } else {
  1006→          const idOrDomain = 'id' in item ? item.id : 'domain' in item ? item.domain : itemUlid;
  1007→          success(`Created ${type}: ${idOrDomain} (@${itemUlid.substring(0, 8)})`);
  1008→        }
  1009→      } catch (err) {
  1010→        error(errors.failures.createMeta(type), err);
  1011→        process.exit(1);
  1012→      }
  1013→    });
  1014→
  1015→  // Meta set command - update existing meta items
  1016→  meta
  1017→    .command('set <ref>')
  1018→    .description('Update an existing meta item')
  1019→    .option('--name <name>', 'Update name (for agents)')
  1020→    .option('--description <desc>', 'Update description')
  1021→    .option('--trigger <trigger>', 'Update trigger (for workflows)')
  1022→    .option('--add-capability <cap>', 'Add capability (for agents)')
  1023→    .option('--add-tool <tool>', 'Add tool (for agents)')
  1024→    .option('--add-convention <conv>', 'Add convention reference (for agents)')
  1025→    .option('--add-rule <rule>', 'Add rule (for conventions)')
  1026→    .action(async (ref: string, options) => {
  1027→      try {
  1028→        const ctx = await initContext();
  1029→        const metaCtx = await loadMetaContext(ctx);
  1030→
  1031→        // Find the item using unified lookup
  1032→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
  1033→        let found: Agent | Workflow | Convention | null = null;
  1034→        let itemType: 'agent' | 'workflow' | 'convention' | null = null;
  1035→
  1036→        // Search in agents
  1037→        const agents = metaCtx.manifest?.agents || [];
  1038→        const agent = agents.find(
  1039→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
  1040→        );
  1041→        if (agent) {
  1042→          found = agent;
  1043→          itemType = 'agent';
  1044→        }
  1045→
  1046→        // Search in workflows
  1047→        if (!found) {
  1048→          const workflows = metaCtx.manifest?.workflows || [];
  1049→          const workflow = workflows.find(
  1050→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
  1051→          );
  1052→          if (workflow) {
  1053→            found = workflow;
  1054→            itemType = 'workflow';
  1055→          }
  1056→        }
  1057→
  1058→        // Search in conventions
  1059→        if (!found) {
  1060→          const conventions = metaCtx.manifest?.conventions || [];
  1061→          const convention = conventions.find(
  1062→            (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
  1063→          );
  1064→          if (convention) {
  1065→            found = convention;
  1066→            itemType = 'convention';
  1067→          }
  1068→        }
  1069→
  1070→        if (!found || !itemType) {
  1071→          error(errors.reference.metaNotFound(ref));
  1072→          process.exit(1);
  1073→        }
  1074→
  1075→        // Update fields based on type
  1076→        if (itemType === 'agent') {
  1077→          const item = found as Agent;
  1078→          if (options.name) item.name = options.name;
  1079→          if (options.description !== undefined) item.description = options.description;
  1080→          if (options.addCapability) {
  1081→            if (!item.capabilities.includes(options.addCapability)) {
  1082→              item.capabilities.push(options.addCapability);
  1083→            }
  1084→          }
  1085→          if (options.addTool) {
  1086→            if (!item.tools.includes(options.addTool)) {
  1087→              item.tools.push(options.addTool);
  1088→            }
  1089→          }
  1090→          if (options.addConvention) {
  1091→            if (!item.conventions.includes(options.addConvention)) {
  1092→              item.conventions.push(options.addConvention);
  1093→            }
  1094→          }
  1095→        } else if (itemType === 'workflow') {
  1096→          const item = found as Workflow;
  1097→          if (options.trigger) item.trigger = options.trigger;
  1098→          if (options.description !== undefined) item.description = options.description;
  1099→        } else {
  1100→          const item = found as Convention;
  1101→          // Convention doesn't have a description field
  1102→          if (options.addRule) {
  1103→            if (!item.rules.includes(options.addRule)) {
  1104→              item.rules.push(options.addRule);
  1105→            }
  1106→          }
  1107→        }
  1108→
  1109→        // Save the updated item
  1110→        await saveMetaItem(ctx, found, itemType);
  1111→
  1112→        if (isJsonMode()) {
  1113→          // In JSON mode, output the item data directly
  1114→          console.log(JSON.stringify(found, null, 2));
  1115→        } else {
  1116→          const idOrDomain =
  1117→            itemType === 'agent'
  1118→              ? (found as Agent).id
  1119→              : itemType === 'workflow'
  1120→                ? (found as Workflow).id
  1121→                : (found as Convention).domain;
  1122→          success(`Updated ${itemType}: ${idOrDomain}`);
  1123→        }
  1124→      } catch (err) {
  1125→        error(errors.failures.updateMetaItem, err);
  1126→        process.exit(1);
  1127→      }
  1128→    });
  1129→
  1130→  // Meta delete command - delete meta items
  1131→  meta
  1132→    .command('delete <ref>')
  1133→    .description('Delete a meta item')
  1134→    .option('--confirm', 'Skip confirmation prompt')
  1135→    .action(async (ref: string, options) => {
  1136→      try {
  1137→        const ctx = await initContext();
  1138→        const metaCtx = await loadMetaContext(ctx);
  1139→
  1140→        // Find the item to determine type
  1141→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
  1142→        let itemType: 'agent' | 'workflow' | 'convention' | 'observation' | null = null;
  1143→        let itemUlid: string | null = null;
  1144→        let itemLabel: string | null = null;
  1145→
  1146→        // Search in agents
  1147→        const agents = metaCtx.manifest?.agents || [];
  1148→        const agent = agents.find(
  1149→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
  1150→        );
  1151→        if (agent) {
  1152→          itemType = 'agent';
  1153→          itemUlid = agent._ulid;
  1154→          itemLabel = `agent ${agent.id}`;
  1155→        }
  1156→
  1157→        // Search in workflows
  1158→        if (!itemType) {
  1159→          const workflows = metaCtx.manifest?.workflows || [];
  1160→          const workflow = workflows.find(
  1161→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
  1162→          );
  1163→          if (workflow) {
  1164→            itemType = 'workflow';
  1165→            itemUlid = workflow._ulid;
  1166→            itemLabel = `workflow ${workflow.id}`;
  1167→          }
  1168→        }
  1169→
  1170→        // Search in conventions
  1171→        if (!itemType) {
  1172→          const conventions = metaCtx.manifest?.conventions || [];
  1173→          const convention = conventions.find(
  1174→            (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
  1175→          );
  1176→          if (convention) {
  1177→            itemType = 'convention';
  1178→            itemUlid = convention._ulid;
  1179→            itemLabel = `convention ${convention.domain}`;
  1180→          }
  1181→        }
  1182→
  1183→        // Search in observations
  1184→        if (!itemType) {
  1185→          const observations = metaCtx.observations || [];
  1186→          const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
  1187→          if (observation) {
  1188→            itemType = 'observation';
  1189→            itemUlid = observation._ulid;
  1190→            itemLabel = `observation ${observation._ulid.substring(0, 8)}`;
  1191→          }
  1192→        }
  1193→
  1194→        if (!itemType || !itemUlid || !itemLabel) {
  1195→          error(errors.reference.metaNotFound(ref));
  1196→          process.exit(1);
  1197→        }
  1198→
  1199→        // Check for dangling references (unless --confirm is used to override)
  1200→        if (!options.confirm) {
  1201→          // Check tasks with meta_ref
  1202→          const tasks = await loadAllTasks(ctx);
  1203→          const referencingTasks = tasks.filter((t) => {
  1204→            if (!t.meta_ref) return false;
  1205→            // Resolve the task's meta_ref to a ULID
  1206→            const taskMetaRef = resolveMetaRefToUlid(t.meta_ref, metaCtx);
  1207→            // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1208→            return taskMetaRef && taskMetaRef.ulid === itemUlid;
  1209→          });
  1210→
  1211→          if (referencingTasks.length > 0) {
  1212→            const taskRefs = referencingTasks
  1213→              .map((t) => `@${t.slugs?.[0] || t._ulid.substring(0, 8)}`)
  1214→              .join(', ');
  1215→            error(errors.operation.cannotDeleteReferencedByTasks(itemLabel, referencingTasks.length, taskRefs));
  1216→            process.exit(1);
  1217→          }
  1218→
  1219→          // Check observations with workflow_ref (only for workflows)
  1220→          if (itemType === 'workflow') {
  1221→            const observations = metaCtx.observations || [];
  1222→            const referencingObservations = observations.filter((o) => {
  1223→              if (!o.workflow_ref) return false;
  1224→              // Resolve the observation's workflow_ref to a ULID
  1225→              const obsWorkflowRef = resolveMetaRefToUlid(o.workflow_ref, metaCtx);
  1226→              // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1227→              return obsWorkflowRef && obsWorkflowRef.ulid === itemUlid;
  1228→            });
  1229→
  1230→            if (referencingObservations.length > 0) {
  1231→              const obsRefs = referencingObservations
  1232→                .map((o) => `@${o._ulid.substring(0, 8)}`)
  1233→                .join(', ');
  1234→              error(errors.operation.cannotDeleteReferencedByObservations(itemLabel, referencingObservations.length, obsRefs));
  1235→              process.exit(1);
  1236→            }
  1237→          }
  1238→
  1239→          // Show confirmation prompt even if no references found
  1240→          error(errors.operation.confirmRequired(itemLabel));
  1241→          process.exit(1);
  1242→        }
  1243→
  1244→        // Delete the item
  1245→        const deleted = await deleteMetaItem(ctx, itemUlid, itemType);
  1246→
  1247→        if (!deleted) {
  1248→          error(errors.operation.deleteItemFailed(itemLabel));
  1249→          process.exit(1);
  1250→        }
  1251→
  1252→        success(`Deleted ${itemLabel}`);
  1253→      } catch (err) {
  1254→        error(errors.failures.deleteMetaItem, err);
  1255→        process.exit(1);
  1256→      }
  1257→    });
  1258→}
  1259→

