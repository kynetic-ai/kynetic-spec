    22→/**
    23→ * Format completeness warnings for display
    24→ * AC: @spec-completeness ac-4
    25→ */
    26→function formatCompletenessWarnings(warnings: CompletenessWarning[], verbose: boolean): void {
    27→  if (warnings.length === 0) {
    28→    console.log(chalk.green('Completeness: OK'));
    29→    return;
    30→  }
    31→
    32→  console.log(chalk.yellow(`\nCompleteness warnings: ${warnings.length}`));
    33→
    34→  // Group by type
    35→  const missingAC = warnings.filter(w => w.type === 'missing_acceptance_criteria');
    36→  const missingDesc = warnings.filter(w => w.type === 'missing_description');
    37→  const statusMismatch = warnings.filter(w => w.type === 'status_inconsistency');
    38→
    39→  // AC: @spec-completeness ac-4
    40→  // Show summary with counts by issue type
    41→  if (missingAC.length > 0) {
    42→    console.log(chalk.yellow(`  Missing acceptance criteria: ${missingAC.length}`));
    43→    const shown = verbose ? missingAC : missingAC.slice(0, 3);
    44→    for (const w of shown) {
    45→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
    46→    }
    47→    if (!verbose && missingAC.length > 3) {
    48→      console.log(chalk.gray(`    ... and ${missingAC.length - 3} more`));
    49→    }
    50→  }
    51→
    52→  if (missingDesc.length > 0) {
    53→    console.log(chalk.yellow(`  Missing descriptions: ${missingDesc.length}`));
    54→    const shown = verbose ? missingDesc : missingDesc.slice(0, 3);
    55→    for (const w of shown) {
    56→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
    57→    }
    58→    if (!verbose && missingDesc.length > 3) {
    59→      console.log(chalk.gray(`    ... and ${missingDesc.length - 3} more`));
    60→    }
    61→  }
    62→
    63→  if (statusMismatch.length > 0) {
    64→    console.log(chalk.yellow(`  Status inconsistencies: ${statusMismatch.length}`));
    65→    for (const w of statusMismatch) {
    66→      console.log(chalk.yellow(`    ! ${w.message}`));
    67→      if (w.details) {
    68→        console.log(chalk.gray(`      ${w.details}`));
    69→      }
    70→    }
    71→  }
    72→}
    73→
    74→/**
    75→ * Format alignment warnings for display
    76→ */
    77→function formatAlignmentWarnings(warnings: AlignmentWarning[], verbose: boolean): void {
    78→  if (warnings.length === 0) {
    79→    console.log(chalk.green('Alignment: OK'));
    80→    return;
    81→  }
    82→
    83→  console.log(chalk.yellow(`\nAlignment warnings: ${warnings.length}`));
    84→
    85→  // Group by type
    86→  const orphaned = warnings.filter(w => w.type === 'orphaned_spec');
    87→  const mismatches = warnings.filter(w => w.type === 'status_mismatch');
    88→  const stale = warnings.filter(w => w.type === 'stale_implementation');
    89→
    90→  if (orphaned.length > 0) {
    91→    console.log(chalk.yellow(`  Orphaned specs (no tasks): ${orphaned.length}`));
    92→    const shown = verbose ? orphaned : orphaned.slice(0, 3);
    93→    for (const w of shown) {
    94→      console.log(chalk.gray(`    ○ ${w.specTitle}`));
    95→    }
    96→    if (!verbose && orphaned.length > 3) {
    97→      console.log(chalk.gray(`    ... and ${orphaned.length - 3} more`));
    98→    }
    99→  }
   100→
   101→  if (mismatches.length > 0) {
   102→    console.log(chalk.yellow(`  Status mismatches: ${mismatches.length}`));
   103→    for (const w of mismatches) {
   104→      console.log(chalk.yellow(`    ! ${w.specTitle}`));
   105→      console.log(chalk.gray(`      ${w.message}`));
   106→    }
   107→  }
   108→
   109→  if (stale.length > 0) {
   110→    console.log(chalk.yellow(`  Stale implementation status: ${stale.length}`));
   111→    for (const w of stale) {
   112→      console.log(chalk.yellow(`    ! ${w.message}`));
   113→    }
   114→  }
   115→}
   116→
   117→/**
   118→ * Format fix results for display
   119→ */
   120→function formatFixResult(result: FixResult): void {
   121→  if (result.fixesApplied.length === 0) {
   122→    console.log(chalk.gray('\nNo auto-fixable issues found.'));
   123→    return;
   124→  }
   125→
   126→  console.log(chalk.cyan(`\n✓ Applied ${result.fixesApplied.length} fix(es) to ${result.filesModified} file(s):`));
   127→
   128→  for (const fix of result.fixesApplied) {
   129→    const typeLabel = {
   130→      ulid_regenerated: 'ULID regenerated',
   131→      timestamp_added: 'Timestamp added',
   132→      status_added: 'Status added',
   133→    }[fix.type];
   134→
   135→    const shortFile = path.basename(fix.file);
   136→    console.log(chalk.cyan(`  ✓ ${shortFile}:${fix.path} - ${typeLabel}`));
   137→  }
   138→
   139→  if (result.errors.length > 0) {
   140→    console.log(chalk.yellow(`\nFix errors: ${result.errors.length}`));
   141→    for (const err of result.errors) {
   142→      console.log(chalk.yellow(`  ! ${err.file}: ${err.message}`));
   143→    }
   144→  }
   145→}
   146→
   147→/**
   148→ * Collect all files that can be fixed
   149→ */
   150→async function collectFixableFiles(ctx: { rootDir: string; specDir?: string; manifest?: { includes?: string[] } | null; manifestPath?: string | null }): Promise<string[]> {
   151→  const files: string[] = [];
   152→
   153→  // Task files (exclude test fixtures)
   154→  const taskFiles = await findTaskFiles(ctx.rootDir);
   155→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, 'spec'));
   156→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
   157→  files.push(...allTaskFiles.filter(f => !f.includes('fixtures') && !f.includes('test')));
   158→
   159→  // Spec files from includes
   160→  if (ctx.manifest && ctx.manifestPath) {
   161→    const manifestDir = path.dirname(ctx.manifestPath);
   162→    const includes = ctx.manifest.includes || [];
   163→
   164→    for (const include of includes) {
   165→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   166→      files.push(...expandedPaths);
   167→    }
   168→  }
   169→
   170→  // Inbox file
   171→  const inboxPath = path.join(ctx.rootDir, 'spec', 'kynetic.inbox.yaml');
   172→  try {
   173→    await import('node:fs/promises').then(fs => fs.access(inboxPath));
   174→    files.push(inboxPath);
   175→  } catch {
   176→    // Inbox file doesn't exist, skip
   177→  }
   178→
   179→  return [...new Set(files)];
   180→}
