     1→import * as path from 'node:path';
     2→import { Command } from 'commander';
     3→import chalk from 'chalk';
     4→import {
     5→  initContext,
     6→  validate,
     7→  loadAllTasks,
     8→  loadAllItems,
     9→  AlignmentIndex,
    10→  ReferenceIndex,
    11→  fixFiles,
    12→  findTaskFiles,
    13→  expandIncludePattern,
    14→  type ValidationResult,
    15→  type AlignmentWarning,
    16→  type CompletenessWarning,
    17→  type FixResult,
    18→} from '../../parser/index.js';
    19→import { output, success, error, info } from '../output.js';
    20→import { validation as validationStrings } from '../../strings/index.js';
