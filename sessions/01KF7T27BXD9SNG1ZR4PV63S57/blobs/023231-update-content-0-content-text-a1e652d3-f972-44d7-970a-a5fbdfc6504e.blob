   182→/**
   183→ * Format validation result for display
   184→ */
   185→function formatValidationResult(result: ValidationResult, verbose: boolean): void {
   186→  // Header
   187→  if (result.valid) {
   188→    console.log(chalk.green.bold('✓ Validation passed'));
   189→  } else {
   190→    console.log(chalk.red.bold('✗ Validation failed'));
   191→  }
   192→
   193→  console.log(chalk.gray('─'.repeat(40)));
   194→  console.log(`Files checked: ${result.stats.filesChecked}`);
   195→  console.log(`Items checked: ${result.stats.itemsChecked}`);
   196→  console.log(`Tasks checked: ${result.stats.tasksChecked}`);
   197→
   198→  // AC-meta-manifest-2: Display meta summary line
   199→  if (result.metaStats) {
   200→    console.log(`Meta: ${result.metaStats.agents} agents, ${result.metaStats.workflows} workflows, ${result.metaStats.conventions} conventions`);
   201→  }
   202→
   203→  // Schema errors
   204→  if (result.schemaErrors.length > 0) {
   205→    console.log(chalk.red(`\nSchema errors: ${result.schemaErrors.length}`));
   206→    for (const err of result.schemaErrors) {
   207→      const location = err.path ? `${err.file}:${err.path}` : err.file;
   208→      console.log(chalk.red(`  ✗ ${location}`));
   209→      console.log(chalk.gray(`    ${err.message}`));
   210→      if (verbose && err.details) {
   211→        console.log(chalk.gray(`    ${JSON.stringify(err.details)}`));
   212→      }
   213→    }
   214→  } else {
   215→    console.log(chalk.green('\nSchema: OK'));
   216→  }
   217→
   218→  // Reference errors
   219→  if (result.refErrors.length > 0) {
   220→    console.log(chalk.red(`\nReference errors: ${result.refErrors.length}`));
   221→    for (const err of result.refErrors) {
   222→      const location = err.sourceFile
   223→        ? `${err.sourceFile} (${err.field})`
   224→        : `${err.sourceUlid?.slice(0, 8)} (${err.field})`;
   225→      console.log(chalk.red(`  ✗ ${err.ref}`));
   226→      console.log(chalk.gray(`    ${err.message}`));
   227→      console.log(chalk.gray(`    in: ${location}`));
   228→    }
   229→  } else {
   230→    console.log(chalk.green('References: OK'));
   231→  }
   232→
   233→  // Reference warnings (deprecated targets)
   234→  if (result.refWarnings.length > 0) {
   235→    console.log(chalk.yellow(`\nReference warnings: ${result.refWarnings.length}`));
   236→    const shown = verbose ? result.refWarnings : result.refWarnings.slice(0, 5);
   237→    for (const warn of shown) {
   238→      const location = warn.sourceFile
   239→        ? `${warn.sourceFile} (${warn.field})`
   240→        : `${warn.sourceUlid?.slice(0, 8)} (${warn.field})`;
   241→      console.log(chalk.yellow(`  ⚠ ${warn.ref}`));
   242→      console.log(chalk.gray(`    ${warn.message}`));
   243→      console.log(chalk.gray(`    in: ${location}`));
   244→    }
   245→    if (!verbose && result.refWarnings.length > 5) {
   246→      console.log(chalk.gray(`  ... and ${result.refWarnings.length - 5} more (use -v to see all)`));
   247→    }
   248→  }
   249→
   250→  // Orphans (warnings, not errors)
   251→  if (result.orphans.length > 0) {
   252→    console.log(chalk.yellow(`\nOrphans (not referenced): ${result.orphans.length}`));
   253→    if (verbose) {
   254→      for (const orphan of result.orphans) {
   255→        console.log(chalk.yellow(`  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`));
   256→      }
   257→    } else {
   258→      // Show first few
   259→      const shown = result.orphans.slice(0, 5);
   260→      for (const orphan of shown) {
   261→        console.log(chalk.yellow(`  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`));
   262→      }
   263→      if (result.orphans.length > 5) {
   264→        console.log(chalk.gray(`  ... and ${result.orphans.length - 5} more (use -v to see all)`));
   265→      }
   266→    }
   267→  }
   268→}
   269→
   270→/**
   271→ * Register validate command
   272→ */
   273→export function registerValidateCommand(program: Command): void {
   274→  program
   275→    .command('validate')
   276→    .description('Validate spec files')
   277→    .option('--schema', 'Check schema conformance only')
   278→    .option('--refs', 'Check reference resolution only')
   279→    .option('--orphans', 'Find orphaned items only')
   280→    .option('--alignment', 'Check spec-task alignment')
   281→    .option('--completeness', 'Check spec completeness (missing AC, descriptions, status inconsistencies)')
   282→    .option('--fix', 'Auto-fix issues where possible (invalid ULIDs, missing timestamps)')
   283→    .option('-v, --verbose', 'Show detailed output')
   284→    .option('--strict', 'Treat orphans as errors')
   285→    .action(async (options) => {
   286→      try {
   287→        const ctx = await initContext();
   288→
   289→        if (!ctx.manifestPath) {
   290→          error(validationStrings.noManifest);
   291→          console.log(validationStrings.initHint);
   292→          process.exit(1);
   293→        }
   294→
   295→        // Determine which checks to run
   296→        const runAll = !options.schema && !options.refs && !options.orphans && !options.alignment && !options.completeness;
   297→        const validateOptions = {
   298→          schema: runAll || options.schema,
   299→          refs: runAll || options.refs,
   300→          orphans: runAll || options.orphans,
   301→          completeness: runAll || options.completeness,
   302→        };
   303→
   304→        const result = await validate(ctx, validateOptions);
   305→
   306→        // In strict mode, orphans are errors
   307→        if (options.strict && result.orphans.length > 0) {
   308→          result.valid = false;
   309→        }
   310→
   311→        output(result, () => formatValidationResult(result, options.verbose));
   312→
   313→        // Run auto-fix if requested
   314→        if (options.fix) {
   315→          const filesToFix = await collectFixableFiles(ctx);
   316→          const fixResult = await fixFiles(filesToFix);
   317→          formatFixResult(fixResult);
   318→
   319→          // Re-run validation after fixes to show updated status
   320→          if (fixResult.fixesApplied.length > 0) {
   321→            console.log(validationStrings.revalidating);
   322→            const revalidateResult = await validate(ctx, validateOptions);
   323→            if (revalidateResult.valid) {
   324→              console.log(validationStrings.nowPasses);
   325→            } else {
   326→              console.log(validationStrings.issuesRemain);
   327→            }
   328→            // Update result for exit code
   329→            result.valid = revalidateResult.valid;
   330→            result.schemaErrors = revalidateResult.schemaErrors;
   331→            result.refErrors = revalidateResult.refErrors;
   332→          }
   333→        }
   334→
   335→        // Run alignment check if requested or running all checks
   336→        if (options.alignment || runAll) {
   337→          const tasks = await loadAllTasks(ctx);
   338→          const items = await loadAllItems(ctx);
   339→          const refIndex = new ReferenceIndex(tasks, items);
   340→          const alignmentIndex = new AlignmentIndex(tasks, items);
   341→          alignmentIndex.buildLinks(refIndex);
   342→
   343→          const alignmentWarnings = alignmentIndex.findAlignmentWarnings();
   344→          formatAlignmentWarnings(alignmentWarnings, options.verbose);
   345→
   346→          // Show alignment stats
   347→          const stats = alignmentIndex.getStats();
   348→          console.log(
   349→            validationStrings.alignmentStats(stats.specsWithTasks, stats.totalSpecs, stats.alignedSpecs)
   350→          );
   351→        }
   352→
   353→        // Show completeness warnings if any
   354→        // AC: @spec-completeness ac-4
   355→        if (result.completenessWarnings.length > 0) {
   356→          formatCompletenessWarnings(result.completenessWarnings, options.verbose);
   357→        }
   358→
   359→        if (!result.valid) {
   360→          process.exit(1);
   361→        }
   362→      } catch (err) {
   363→        error(validationStrings.failed, err);
   364→        process.exit(1);
   365→      }
   366→    });
   367→
   368→  // Alias: kspec lint
   369→  program
   370→    .command('lint')
   371→    .description('Alias for validate with style checks')
   372→    .option('--schema', 'Check schema conformance only')
   373→    .option('--refs', 'Check reference resolution only')
   374→    .option('--orphans', 'Find orphaned items only')
   375→    .option('--completeness', 'Check spec completeness (missing AC, descriptions, status inconsistencies)')
   376→    .option('--fix', 'Auto-fix issues where possible (invalid ULIDs, missing timestamps)')
   377→    .option('-v, --verbose', 'Show detailed output')
   378→    .option('--strict', 'Treat orphans as errors')
   379→    .action(async (options) => {
   380→      try {
   381→        const ctx = await initContext();
   382→
   383→        if (!ctx.manifestPath) {
   384→          error(validationStrings.noManifest);
   385→          process.exit(1);
   386→        }
   387→
   388→        const runAll = !options.schema && !options.refs && !options.orphans && !options.completeness;
   389→        const validateOptions = {
   390→          schema: runAll || options.schema,
   391→          refs: runAll || options.refs,
   392→          orphans: runAll || options.orphans,
   393→          completeness: runAll || options.completeness,
   394→        };
   395→
   396→        const result = await validate(ctx, validateOptions);
   397→
   398→        if (options.strict && result.orphans.length > 0) {
   399→          result.valid = false;
   400→        }
   401→
   402→        output(result, () => formatValidationResult(result, options.verbose));
   403→
   404→        // Run auto-fix if requested
   405→        if (options.fix) {
   406→          const filesToFix = await collectFixableFiles(ctx);
   407→          const fixResult = await fixFiles(filesToFix);
   408→          formatFixResult(fixResult);
   409→
   410→          // Re-run validation after fixes
   411→          if (fixResult.fixesApplied.length > 0) {
   412→            console.log(validationStrings.revalidating);
   413→            const revalidateResult = await validate(ctx, validateOptions);
   414→            if (revalidateResult.valid) {
   415→              console.log(validationStrings.nowPasses);
   416→            } else {
   417→              console.log(validationStrings.issuesRemain);
   418→            }
   419→            result.valid = revalidateResult.valid;
   420→          }
   421→        }
   422→
   423→        if (!result.valid) {
   424→          process.exit(1);
   425→        }
   426→      } catch (err) {
   427→        error(validationStrings.lintFailed, err);
   428→        process.exit(1);
   429→      }
   430→    });
   431→}
