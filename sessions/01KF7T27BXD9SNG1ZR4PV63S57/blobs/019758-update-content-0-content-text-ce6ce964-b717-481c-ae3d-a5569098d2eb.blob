```
     1→/**
     2→ * Meta manifest loading and operations.
     3→ *
     4→ * The meta manifest (kynetic.meta.yaml) contains process definitions:
     5→ * - Agents: roles, capabilities, conventions
     6→ * - Workflows: structured processes with steps
     7→ * - Conventions: project rules and standards
     8→ * - Observations: feedback about processes
     9→ */
    10→
    11→import * as fs from 'node:fs/promises';
    12→import * as path from 'node:path';
    13→import { ulid } from 'ulid';
    14→import {
    15→  MetaManifestSchema,
    16→  AgentSchema,
    17→  WorkflowSchema,
    18→  ConventionSchema,
    19→  ObservationSchema,
    20→  type MetaManifest,
    21→  type Agent,
    22→  type Workflow,
    23→  type Convention,
    24→  type Observation,
    25→  type MetaItem,
    26→  type ObservationType,
    27→  getMetaItemType,
    28→} from '../schema/index.js';
    29→import { readYamlFile, writeYamlFile, expandIncludePattern, getAuthor } from './yaml.js';
    30→import type { KspecContext } from './yaml.js';
    31→
    32→/**
    33→ * Loaded agent with runtime metadata
    34→ */
    35→export interface LoadedAgent extends Agent {
    36→  _sourceFile?: string;
    37→}
    38→
    39→/**
    40→ * Loaded workflow with runtime metadata
    41→ */
    42→export interface LoadedWorkflow extends Workflow {
    43→  _sourceFile?: string;
    44→}
    45→
    46→/**
    47→ * Loaded convention with runtime metadata
    48→ */
    49→export interface LoadedConvention extends Convention {
    50→  _sourceFile?: string;
    51→}
    52→
    53→/**
    54→ * Loaded observation with runtime metadata
    55→ */
    56→export interface LoadedObservation extends Observation {
    57→  _sourceFile?: string;
    58→}
    59→
    60→/**
    61→ * Any loaded meta item
    62→ */
    63→export type LoadedMetaItem = LoadedAgent | LoadedWorkflow | LoadedConvention | LoadedObservation;
    64→
    65→/**
    66→ * Meta context containing all loaded meta items
    67→ */
    68→export interface MetaContext {
    69→  manifest: MetaManifest | null;
    70→  manifestPath: string | null;
    71→  agents: LoadedAgent[];
    72→  workflows: LoadedWorkflow[];
    73→  conventions: LoadedConvention[];
    74→  observations: LoadedObservation[];
    75→}
    76→
    77→/**
    78→ * Find the meta manifest file (kynetic.meta.yaml)
    79→ */
    80→export async function findMetaManifest(specDir: string): Promise<string | null> {
    81→  const candidates = ['kynetic.meta.yaml'];
    82→
    83→  for (const candidate of candidates) {
    84→    const filePath = path.join(specDir, candidate);
    85→    try {
    86→      await fs.access(filePath);
    87→      return filePath;
    88→    } catch {
    89→      // File doesn't exist, try next
    90→    }
    91→  }
    92→
    93→  return null;
    94→}
    95→
    96→/**
    97→ * Get the meta manifest file path.
    98→ * Returns path even if file doesn't exist yet.
    99→ */
   100→export function getMetaManifestPath(ctx: KspecContext): string {
   101→  return path.join(ctx.specDir, 'kynetic.meta.yaml');
   102→}
   103→
   104→/**
   105→ * Load meta items from a single file.
   106→ */
   107→async function loadMetaFile(
   108→  filePath: string
   109→): Promise<{
   110→  agents: LoadedAgent[];
   111→  workflows: LoadedWorkflow[];
   112→  conventions: LoadedConvention[];
   113→  observations: LoadedObservation[];
   114→}> {
   115→  const result: {
   116→    agents: LoadedAgent[];
   117→    workflows: LoadedWorkflow[];
   118→    conventions: LoadedConvention[];
   119→    observations: LoadedObservation[];
   120→  } = {
   121→    agents: [],
   122→    workflows: [],
   123→    conventions: [],
   124→    observations: [],
   125→  };
   126→
   127→  try {
   128→    const raw = await readYamlFile<unknown>(filePath);
   129→    if (!raw || typeof raw !== 'object') {
   130→      return result;
   131→    }
   132→
   133→    const obj = raw as Record<string, unknown>;
   134→
   135→    // Parse agents
   136→    if (Array.isArray(obj.agents)) {
   137→      for (const agent of obj.agents) {
   138→        const parsed = AgentSchema.safeParse(agent);
   139→        if (parsed.success) {
   140→          result.agents.push({ ...parsed.data, _sourceFile: filePath });
   141→        }
   142→      }
   143→    }
   144→
   145→    // Parse workflows
   146→    if (Array.isArray(obj.workflows)) {
   147→      for (const workflow of obj.workflows) {
   148→        const parsed = WorkflowSchema.safeParse(workflow);
   149→        if (parsed.success) {
   150→          result.workflows.push({ ...parsed.data, _sourceFile: filePath });
   151→        }
   152→      }
   153→    }
   154→
   155→    // Parse conventions
   156→    if (Array.isArray(obj.conventions)) {
   157→      for (const convention of obj.conventions) {
   158→        const parsed = ConventionSchema.safeParse(convention);
   159→        if (parsed.success) {
   160→          result.conventions.push({ ...parsed.data, _sourceFile: filePath });
   161→        }
   162→      }
   163→    }
   164→
   165→    // Parse observations
   166→    if (Array.isArray(obj.observations)) {
   167→      for (const observation of obj.observations) {
   168→        const parsed = ObservationSchema.safeParse(observation);
   169→        if (parsed.success) {
   170→          result.observations.push({ ...parsed.data, _sourceFile: filePath });
   171→        }
   172→      }
   173→    }
   174→  } catch {
   175→    // File doesn't exist or parse error
   176→  }
   177→
   178→  return result;
   179→}
   180→
   181→/**
   182→ * Load the meta context from a kspec context.
   183→ * Loads meta manifest and follows includes.
   184→ */
   185→export async function loadMetaContext(ctx: KspecContext): Promise<MetaContext> {
   186→  const result: MetaContext = {
   187→    manifest: null,
   188→    manifestPath: null,
   189→    agents: [],
   190→    workflows: [],
   191→    conventions: [],
   192→    observations: [],
   193→  };
   194→
   195→  const manifestPath = await findMetaManifest(ctx.specDir);
   196→  if (!manifestPath) {
   197→    return result;
   198→  }
   199→
   200→  result.manifestPath = manifestPath;
   201→
   202→  try {
   203→    const raw = await readYamlFile<unknown>(manifestPath);
   204→    const parsed = MetaManifestSchema.safeParse(raw);
   205→
   206→    if (!parsed.success) {
   207→      // Invalid manifest, but we can still try to extract items
   208→      const items = await loadMetaFile(manifestPath);
   209→      result.agents.push(...items.agents);
   210→      result.workflows.push(...items.workflows);
   211→      result.conventions.push(...items.conventions);
   212→      result.observations.push(...items.observations);
   213→      return result;
   214→    }
   215→
   216→    result.manifest = parsed.data;
   217→
   218→    // Load items from manifest
   219→    const manifestItems = await loadMetaFile(manifestPath);
   220→    result.agents.push(...manifestItems.agents);
   221→    result.workflows.push(...manifestItems.workflows);
   222→    result.conventions.push(...manifestItems.conventions);
   223→    result.observations.push(...manifestItems.observations);
   224→
   225→    // Process includes
   226→    const includes = parsed.data.includes || [];
   227→    const manifestDir = path.dirname(manifestPath);
   228→
   229→    for (const include of includes) {
   230→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   231→
   232→      for (const filePath of expandedPaths) {
   233→        const items = await loadMetaFile(filePath);
   234→        result.agents.push(...items.agents);
   235→        result.workflows.push(...items.workflows);
   236→        result.conventions.push(...items.conventions);
   237→        result.observations.push(...items.observations);
   238→      }
   239→    }
   240→  } catch {
   241→    // Manifest exists but may be invalid
   242→  }
   243→
   244→  return result;
   245→}
   246→
   247→/**
   248→ * Get meta stats summary
   249→ */
   250→export function getMetaStats(meta: MetaContext): {
   251→  agents: number;
   252→  workflows: number;
   253→  conventions: number;
   254→  observations: number;
   255→  unresolvedObservations: number;
   256→} {
   257→  return {
   258→    agents: meta.agents.length,
   259→    workflows: meta.workflows.length,
   260→    conventions: meta.conventions.length,
   261→    observations: meta.observations.length,
   262→    unresolvedObservations: meta.observations.filter((o) => !o.resolved).length,
   263→  };
   264→}
   265→
   266→/**
   267→ * Find a meta item by reference (ULID, short ULID, or id)
   268→ */
   269→export function findMetaItemByRef(
   270→  meta: MetaContext,
   271→  ref: string
   272→): LoadedMetaItem | undefined {
   273→  const cleanRef = ref.startsWith('@') ? ref.slice(1) : ref;
   274→
   275→  // Search all item types
   276→  const allItems: LoadedMetaItem[] = [
   277→    ...meta.agents,
   278→    ...meta.workflows,
   279→    ...meta.conventions,
   280→    ...meta.observations,
   281→  ];
   282→
   283→  for (const item of allItems) {
   284→    // Match full ULID
   285→    if (item._ulid === cleanRef) return item;
   286→
   287→    // Match short ULID (prefix)
   288→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase())) return item;
   289→
   290→    // Match by id (for agents and workflows)
   291→    if ('id' in item && item.id === cleanRef) return item;
   292→
   293→    // Match by domain (for conventions)
   294→    if ('domain' in item && item.domain === cleanRef) return item;
   295→  }
   296→
   297→  return undefined;
   298→}
   299→
   300→/**
   301→ * Determine if an item is a meta item type
   302→ */
   303→export function isMetaItemType(type: string): boolean {
   304→  return ['agent', 'workflow', 'convention', 'observation'].includes(type);
   305→}
   306→
   307→// ============================================================
   308→// META ITEM CRUD
   309→// ============================================================
   310→
   311→/**
   312→ * Save the entire meta manifest to file
   313→ */
   314→async function saveMetaManifest(
   315→  manifestPath: string,
   316→  manifest: MetaManifest
   317→): Promise<void> {
   318→  await writeYamlFile(manifestPath, manifest);
   319→}
   320→
   321→/**
   322→ * Strip runtime metadata before serialization
   323→ */
   324→function stripMetaMetadata<T extends LoadedMetaItem>(item: T): Omit<T, '_sourceFile'> {
   325→  const { _sourceFile, ...cleanItem } = item;
   326→  return cleanItem as Omit<T, '_sourceFile'>;
   327→}
   328→
   329→/**
   330→ * Create a new observation
   331→ */
   332→export function createObservation(
   333→  type: ObservationType,
   334→  content: string,
   335→  options: {
   336→    workflow_ref?: string;
   337→    author?: string;
   338→  } = {}
   339→): Observation {
   340→  return {
   341→    _ulid: ulid(),
   342→    type,
   343→    content,
   344→    workflow_ref: options.workflow_ref,
   345→    created_at: new Date().toISOString(),
   346→    author: options.author ?? getAuthor(),
   347→    resolved: false,
   348→    resolution: null,
   349→  };
   350→}
   351→
   352→/**
   353→ * Save an observation to the meta manifest
   354→ */
   355→export async function saveObservation(
   356→  ctx: KspecContext,
   357→  observation: LoadedObservation
   358→): Promise<void> {
   359→  const manifestPath = getMetaManifestPath(ctx);
   360→
   361→  // Ensure directory exists
   362→  const dir = path.dirname(manifestPath);
   363→  await fs.mkdir(dir, { recursive: true });
   364→
   365→  // Load existing manifest
   366→  let manifest: MetaManifest = {
   367→    kynetic_meta: '1.0',
   368→    agents: [],
   369→    workflows: [],
   370→    conventions: [],
   371→    observations: [],
   372→    includes: [],
   373→  };
   374→
   375→  try {
   376→    const raw = await readYamlFile<unknown>(manifestPath);
   377→    const parsed = MetaManifestSchema.safeParse(raw);
   378→    if (parsed.success) {
   379→      manifest = parsed.data;
   380→    }
   381→  } catch {
   382→    // File doesn't exist, use defaults
   383→  }
   384→
   385→  // Strip runtime metadata
   386→  const cleanObs = stripMetaMetadata(observation);
   387→
   388→  // Update or add
   389→  const existingIndex = manifest.observations.findIndex(
   390→    (o) => o._ulid === observation._ulid
   391→  );
   392→  if (existingIndex >= 0) {
   393→    manifest.observations[existingIndex] = cleanObs as Observation;
   394→  } else {
   395→    manifest.observations.push(cleanObs as Observation);
   396→  }
   397→
   398→  await saveMetaManifest(manifestPath, manifest);
   399→}
   400→
   401→/**
   402→ * Delete an observation from the meta manifest
   403→ */
   404→export async function deleteObservation(
   405→  ctx: KspecContext,
   406→  ulid: string
   407→): Promise<boolean> {
   408→  const manifestPath = getMetaManifestPath(ctx);
   409→
   410→  try {
   411→    const raw = await readYamlFile<unknown>(manifestPath);
   412→    const parsed = MetaManifestSchema.safeParse(raw);
   413→    if (!parsed.success) {
   414→      return false;
   415→    }
   416→
   417→    const manifest = parsed.data;
   418→    const index = manifest.observations.findIndex((o) => o._ulid === ulid);
   419→    if (index < 0) {
   420→      return false;
   421→    }
   422→
   423→    manifest.observations.splice(index, 1);
   424→    await saveMetaManifest(manifestPath, manifest);
   425→    return true;
   426→  } catch {
   427→    return false;
   428→  }
   429→}
   430→
   431→// Re-export the getMetaItemType function
   432→export { getMetaItemType };
   433→export type { Agent, Workflow, Convention, Observation, MetaItem };
   434→
   435→// ============================================================
   436→// GENERIC META ITEM CRUD
   437→// ============================================================
   438→
   439→/**
   440→ * Save any meta item (agent, workflow, convention) to the manifest
   441→ */
   442→export async function saveMetaItem(
   443→  ctx: KspecContext,
   444→  item: LoadedMetaItem,
   445→  itemType: 'agent' | 'workflow' | 'convention'
   446→): Promise<void> {
   447→  const manifestPath = getMetaManifestPath(ctx);
   448→
   449→  // Ensure directory exists
   450→  const dir = path.dirname(manifestPath);
   451→  await fs.mkdir(dir, { recursive: true });
   452→
   453→  // Load existing manifest
   454→  let manifest: MetaManifest = {
   455→    kynetic_meta: '1.0',
   456→    agents: [],
   457→    workflows: [],
   458→    conventions: [],
   459→    observations: [],
   460→    includes: [],
   461→  };
   462→
   463→  try {
   464→    const raw = await readYamlFile<unknown>(manifestPath);
   465→    const parsed = MetaManifestSchema.safeParse(raw);
   466→    if (parsed.success) {
   467→      manifest = parsed.data;
   468→    }
   469→  } catch {
   470→    // File doesn't exist, use defaults
   471→  }
   472→
   473→  // Strip runtime metadata
   474→  const cleanItem = stripMetaMetadata(item);
   475→
   476→  // Get the appropriate array
   477→  const getArray = () => {
   478→    switch (itemType) {
   479→      case 'agent':
   480→        return manifest.agents;
   481→      case 'workflow':
   482→        return manifest.workflows;
   483→      case 'convention':
   484→        return manifest.conventions;
   485→    }
   486→  };
   487→
   488→  const array = getArray();
   489→
   490→  // Update or add
   491→  const existingIndex = array.findIndex((i) => i._ulid === item._ulid);
   492→  if (existingIndex >= 0) {
   493→    (array as unknown[])[existingIndex] = cleanItem;
   494→  } else {
   495→    (array as unknown[]).push(cleanItem);
   496→  }
   497→
   498→  await saveMetaManifest(manifestPath, manifest);
   499→}
   500→
   501→/**
   502→ * Delete any meta item from the manifest
   503→ */
   504→export async function deleteMetaItem(
   505→  ctx: KspecContext,
   506→  itemUlid: string,
   507→  itemType: 'agent' | 'workflow' | 'convention' | 'observation'
   508→): Promise<boolean> {
   509→  const manifestPath = getMetaManifestPath(ctx);
   510→
   511→  try {
   512→    const raw = await readYamlFile<unknown>(manifestPath);
   513→    const parsed = MetaManifestSchema.safeParse(raw);
   514→    if (!parsed.success) {
   515→      return false;
   516→    }
   517→
   518→    const manifest = parsed.data;
   519→
   520→    const getArray = () => {
   521→      switch (itemType) {
   522→        case 'agent':
   523→          return manifest.agents;
   524→        case 'workflow':
   525→          return manifest.workflows;
   526→        case 'convention':
   527→          return manifest.conventions;
   528→        case 'observation':
   529→          return manifest.observations;
   530→      }
   531→    };
   532→
   533→    const array = getArray();
   534→    const index = array.findIndex((i) => i._ulid === itemUlid);
   535→    if (index < 0) {
   536→      return false;
   537→    }
   538→
   539→    array.splice(index, 1);
   540→    await saveMetaManifest(manifestPath, manifest);
   541→    return true;
   542→  } catch {
   543→    return false;
   544→  }
   545→}
   546→
   547→// ============================================================
   548→// SESSION CONTEXT
   549→// ============================================================
   550→
   551→/**
   552→ * Session context for ephemeral session state
   553→ */
   554→export interface SessionContext {
   555→  focus: string | null;
   556→  threads: string[];
   557→  open_questions: string[];
   558→  updated_at: string;
   559→}
   560→
   561→/**
   562→ * Get the session context file path
   563→ */
   564→export function getSessionContextPath(ctx: KspecContext): string {
   565→  return path.join(ctx.specDir, '.kspec-session');
   566→}
   567→
   568→/**
   569→ * Load session context (or return empty context if not exists)
   570→ */
   571→export async function loadSessionContext(ctx: KspecContext): Promise<SessionContext> {
   572→  const contextPath = getSessionContextPath(ctx);
   573→
   574→  try {
   575→    const raw = await readYamlFile<unknown>(contextPath);
   576→    if (!raw || typeof raw !== 'object') {
   577→      return {
   578→        focus: null,
   579→        threads: [],
   580→        open_questions: [],
   581→        updated_at: new Date().toISOString(),
   582→      };
   583→    }
   584→
   585→    const obj = raw as Record<string, unknown>;
   586→    return {
   587→      focus: typeof obj.focus === 'string' ? obj.focus : null,
   588→      threads: Array.isArray(obj.threads) ? obj.threads.filter((t): t is string => typeof t === 'string') : [],
   589→      open_questions: Array.isArray(obj.open_questions) ? obj.open_questions.filter((q): q is string => typeof q === 'string') : [],
   590→      updated_at: typeof obj.updated_at === 'string' ? obj.updated_at : new Date().toISOString(),
   591→    };
   592→  } catch {
   593→    return {
   594→      focus: null,
   595→      threads: [],
   596→      open_questions: [],
   597→      updated_at: new Date().toISOString(),
   598→    };
   599→  }
   600→}
   601→
   602→/**
   603→ * Save session context
   604→ */
   605→export async function saveSessionContext(ctx: KspecContext, context: SessionContext): Promise<void> {
   606→  const contextPath = getSessionContextPath(ctx);
   607→
   608→  // Update timestamp
   609→  context.updated_at = new Date().toISOString();
   610→
   611→  await writeYamlFile(contextPath, context);
   612→}
