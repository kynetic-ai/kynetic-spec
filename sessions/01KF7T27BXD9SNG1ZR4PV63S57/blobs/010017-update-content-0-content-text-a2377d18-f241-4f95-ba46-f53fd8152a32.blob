   254→    slugs:
   255→      - shadow-init
   256→    title: Shadow Initialization
   257→    type: feature
   258→    status:
   259→      maturity: draft
   260→      implementation: implemented
   261→    priority: high
   262→    tags:
   263→      - infrastructure
   264→      - cli
   265→    description: |
   266→      kspec init creates shadow branch and worktree by default.
   267→
   268→      Steps:
   269→      1. Add .kspec/ to .gitignore and commit (fails if .gitignore is dirty)
   270→      2. Create git worktree at .kspec/ with orphan branch kspec-meta
   271→      3. Create initial manifest and structure in .kspec/
   272→      4. Initial commit on shadow branch
   273→    acceptance_criteria:
   274→      - id: ac-shadow-init-1
   275→        given: a git repository without shadow branch
   276→        when: kspec init runs
   277→        then: orphan branch kspec-meta is created
   278→      - id: ac-shadow-init-2
   279→        given: kspec init has run
   280→        when: checking .kspec/ directory
   281→        then: it is a valid git worktree pointing to kspec-meta
   282→      - id: ac-shadow-init-3
   283→        given: kspec init has run
   284→        when: checking git log
   285→        then: .gitignore change is committed to main branch
   286→      - id: ac-shadow-init-4
   287→        given: shadow branch already exists
   288→        when: kspec init runs again
   289→        then: it succeeds without error (idempotent)
   290→      - id: ac-shadow-init-5
   291→        given: .gitignore has uncommitted changes
   292→        when: kspec init runs
   293→        then: it fails with error explaining the issue
   294→    implements:
   295→      - '@cmd-init'
   296→    requirements:
   297→      - _ulid: 01KF1V20ZWB6DG3DAYKHMHM0XN
