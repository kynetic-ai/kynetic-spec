```
     1→import { Command } from 'commander';
     2→import { ulid } from 'ulid';
     3→import {
     4→  initContext,
     5→  loadAllTasks,
     6→  loadAllItems,
     7→  saveTask,
     8→  deleteTask,
     9→  createTask,
    10→  createNote,
    11→  createTodo,
    12→  syncSpecImplementationStatus,
    13→  ReferenceIndex,
    14→  checkSlugUniqueness,
    15→  type LoadedTask,
    16→} from '../../parser/index.js';
    17→import { commitIfShadow } from '../../parser/shadow.js';
    18→import {
    19→  output,
    20→  formatTaskDetails,
    21→  success,
    22→  error,
    23→  warn,
    24→  info,
    25→  isJsonMode,
    26→} from '../output.js';
    27→import { formatCommitGuidance, printCommitGuidance } from '../../utils/commit.js';
    28→import type { Task, TaskInput } from '../../schema/index.js';
    29→import { alignmentCheck, errors } from '../../strings/index.js';
    30→
    31→/**
    32→ * Find a task by reference with detailed error reporting.
    33→ * Returns the task or exits with appropriate error.
    34→ */
    35→function resolveTaskRef(
    36→  ref: string,
    37→  tasks: LoadedTask[],
    38→  index: ReferenceIndex
    39→): LoadedTask {
    40→  const result = index.resolve(ref);
    41→
    42→  if (!result.ok) {
    43→    switch (result.error) {
    44→      case 'not_found':
    45→        error(errors.reference.taskNotFound(ref));
    46→        break;
    47→      case 'ambiguous':
    48→        error(errors.reference.ambiguous(ref));
    49→        for (const candidate of result.candidates) {
    50→          const task = tasks.find(t => t._ulid === candidate);
    51→          const slug = task?.slugs[0] || '';
    52→          console.error(`  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ''}`);
    53→        }
    54→        break;
    55→      case 'duplicate_slug':
    56→        error(errors.reference.slugMapsToMultiple(ref));
    57→        for (const candidate of result.candidates) {
    58→          console.error(`  - ${index.shortUlid(candidate)}`);
    59→        }
    60→        break;
    61→    }
    62→    process.exit(3);
    63→  }
    64→
    65→  // Check if it's actually a task
    66→  const task = tasks.find(t => t._ulid === result.ulid);
    67→  if (!task) {
    68→    error(errors.reference.notTask(ref));
    69→    process.exit(3);
    70→  }
    71→
    72→  return task;
    73→}
    74→
    75→/**
    76→ * Register the 'task' command group (singular - operations on individual tasks)
    77→ */
    78→export function registerTaskCommands(program: Command): void {
    79→  const task = program
    80→    .command('task')
    81→    .description('Operations on individual tasks');
    82→
    83→  // kspec task get <ref>
    84→  task
    85→    .command('get <ref>')
    86→    .description('Get task details')
    87→    .action(async (ref: string) => {
    88→      try {
    89→        const ctx = await initContext();
    90→        const tasks = await loadAllTasks(ctx);
    91→        const items = await loadAllItems(ctx);
    92→        const index = new ReferenceIndex(tasks, items);
    93→        const foundTask = resolveTaskRef(ref, tasks, index);
    94→
    95→        output(foundTask, () => formatTaskDetails(foundTask, index));
    96→      } catch (err) {
    97→        error(errors.failures.getTask, err);
    98→        process.exit(1);
    99→      }
   100→    });
   101→
   102→  // kspec task add
   103→  task
   104→    .command('add')
   105→    .description('Create a new task')
   106→    .requiredOption('--title <title>', 'Task title')
   107→    .option('--type <type>', 'Task type (task, epic, bug, spike, infra)', 'task')
   108→    .option('--spec-ref <ref>', 'Reference to spec item')
   109→    .option('--meta-ref <ref>', 'Reference to meta item (workflow, agent, or convention)')
   110→    .option('--priority <n>', 'Priority (1-5)', '3')
   111→    .option('--slug <slug>', 'Human-friendly slug')
   112→    .option('--tag <tag...>', 'Tags')
   113→    .action(async (options) => {
   114→      try {
   115→        const ctx = await initContext();
   116→        const tasks = await loadAllTasks(ctx);
   117→        const items = await loadAllItems(ctx);
   118→
   119→        // Load meta items for validation
   120→        const { loadMetaContext } = await import('../../parser/meta.js');
   121→        const metaContext = await loadMetaContext(ctx);
   122→        const allMetaItems = [
   123→          ...metaContext.agents,
   124→          ...metaContext.workflows,
   125→          ...metaContext.conventions,
   126→          ...metaContext.observations,
   127→        ];
   128→
   129→        // Build index for reference validation
   130→        const refIndex = new ReferenceIndex(tasks, items, allMetaItems);
   131→
   132→        // Check slug uniqueness if provided
   133→        if (options.slug) {
   134→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   135→          if (!slugCheck.ok) {
   136→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   137→            process.exit(1);
   138→          }
   139→        }
   140→
   141→        // Validate meta_ref if provided (AC-meta-ref-3, AC-meta-ref-4)
   142→        if (options.metaRef) {
   143→          const metaRefResult = refIndex.resolve(options.metaRef);
   144→
   145→          if (!metaRefResult.ok) {
   146→            error(errors.reference.metaRefNotFound(options.metaRef));
   147→            process.exit(3);
   148→          }
   149→
   150→          // Check if the resolved item is a meta item (not a spec item or task)
   151→          const isTask = tasks.some(t => t._ulid === metaRefResult.ulid);
   152→          const isSpecItem = items.some(i => i._ulid === metaRefResult.ulid);
   153→
   154→          if (isTask || isSpecItem) {
   155→            error(errors.reference.metaRefPointsToSpec(options.metaRef));
   156→            process.exit(3);
   157→          }
   158→        }
   159→
   160→        const input: TaskInput = {
   161→          title: options.title,
   162→          type: options.type,
   163→          spec_ref: options.specRef || null,
   164→          meta_ref: options.metaRef || null,
   165→          priority: parseInt(options.priority, 10),
   166→          slugs: options.slug ? [options.slug] : [],
   167→          tags: options.tag || [],
   168→        };
   169→
   170→        const newTask = createTask(input);
   171→        await saveTask(ctx, newTask);
   172→        await commitIfShadow(ctx.shadow, 'task-add', newTask.slugs[0] || newTask._ulid.slice(0, 8), newTask.title);
   173→
   174→        // Build index including the new task for accurate short ULID
   175→        const index = new ReferenceIndex([...tasks, newTask], items, allMetaItems);
   176→        success(`Created task: ${index.shortUlid(newTask._ulid)}`, { task: newTask });
   177→      } catch (err) {
   178→        error(errors.failures.createTask, err);
   179→        process.exit(1);
   180→      }
   181→    });
   182→
   183→  // kspec task set <ref>
   184→  task
   185→    .command('set <ref>')
   186→    .description('Update task fields')
   187→    .option('--title <title>', 'Update task title')
   188→    .option('--spec-ref <ref>', 'Link to spec item')
   189→    .option('--meta-ref <ref>', 'Link to meta item (workflow, agent, or convention)')
   190→    .option('--priority <n>', 'Set priority (1-5)')
   191→    .option('--slug <slug>', 'Add a slug alias')
   192→    .option('--tag <tag...>', 'Add tags')
   193→    .option('--depends-on <refs...>', 'Set dependencies (replaces existing)')
   194→    .action(async (ref: string, options) => {
   195→      try {
   196→        const ctx = await initContext();
   197→        const tasks = await loadAllTasks(ctx);
   198→        const items = await loadAllItems(ctx);
   199→
   200→        // Load meta items for validation
   201→        const { loadMetaContext } = await import('../../parser/meta.js');
   202→        const metaContext = await loadMetaContext(ctx);
   203→        const allMetaItems = [
   204→          ...metaContext.agents,
   205→          ...metaContext.workflows,
   206→          ...metaContext.conventions,
   207→          ...metaContext.observations,
   208→        ];
   209→
   210→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   211→        const foundTask = resolveTaskRef(ref, tasks, index);
   212→
   213→        // Check slug uniqueness if adding a new slug
   214→        if (options.slug) {
   215→          const slugCheck = checkSlugUniqueness(index, [options.slug], foundTask._ulid);
   216→          if (!slugCheck.ok) {
   217→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   218→            process.exit(1);
   219→          }
   220→        }
   221→
   222→        // Build updated task with only provided options
   223→        const updatedTask: Task = { ...foundTask };
   224→        const changes: string[] = [];
   225→
   226→        if (options.title) {
   227→          updatedTask.title = options.title;
   228→          changes.push('title');
   229→        }
   230→
   231→        if (options.specRef) {
   232→          // Validate the spec ref exists and is a spec item
   233→          const specResult = index.resolve(options.specRef);
   234→          if (!specResult.ok) {
   235→            error(errors.reference.specRefNotFound(options.specRef));
   236→            process.exit(3);
   237→          }
   238→          // Check it's not a task
   239→          const isTask = tasks.some(t => t._ulid === specResult.ulid);
   240→          if (isTask) {
   241→            error(errors.reference.specRefIsTask(options.specRef));
   242→            process.exit(3);
   243→          }
   244→          updatedTask.spec_ref = options.specRef;
   245→          changes.push('spec_ref');
   246→        }
   247→
   248→        if (options.metaRef) {
   249→          // Validate the meta ref exists and is a meta item
   250→          const metaRefResult = index.resolve(options.metaRef);
   251→          if (!metaRefResult.ok) {
   252→            error(errors.reference.metaRefNotFound(options.metaRef));
   253→            process.exit(3);
   254→          }
   255→
   256→          // Check if the resolved item is a meta item (not a spec item or task)
   257→          const isTask = tasks.some(t => t._ulid === metaRefResult.ulid);
   258→          const isSpecItem = items.some(i => i._ulid === metaRefResult.ulid);
   259→
   260→          if (isTask || isSpecItem) {
   261→            error(errors.reference.metaRefPointsToSpec(options.metaRef));
   262→            process.exit(3);
   263→          }
   264→
   265→          updatedTask.meta_ref = options.metaRef;
   266→          changes.push('meta_ref');
   267→        }
   268→
   269→        if (options.priority) {
   270→          const priority = parseInt(options.priority, 10);
   271→          if (isNaN(priority) || priority < 1 || priority > 5) {
   272→            error(errors.validation.priorityOutOfRange);
   273→            process.exit(3);
   274→          }
   275→          updatedTask.priority = priority;
   276→          changes.push('priority');
   277→        }
   278→
   279→        if (options.slug) {
   280→          if (!updatedTask.slugs.includes(options.slug)) {
   281→            updatedTask.slugs = [...updatedTask.slugs, options.slug];
   282→            changes.push('slug');
   283→          }
   284→        }
   285→
   286→        if (options.tag) {
   287→          const newTags = options.tag.filter((t: string) => !updatedTask.tags.includes(t));
   288→          if (newTags.length > 0) {
   289→            updatedTask.tags = [...updatedTask.tags, ...newTags];
   290→            changes.push('tags');
   291→          }
   292→        }
   293→
   294→        if (options.dependsOn) {
   295→          // Validate all dependency refs
   296→          for (const depRef of options.dependsOn) {
   297→            const depResult = index.resolve(depRef);
   298→            if (!depResult.ok) {
   299→              error(errors.reference.depNotFound(depRef));
   300→              process.exit(3);
   301→            }
   302→          }
   303→          updatedTask.depends_on = options.dependsOn;
   304→          changes.push('depends_on');
   305→        }
   306→
   307→        if (changes.length === 0) {
   308→          warn('No changes specified');
   309→          return;
   310→        }
   311→
   312→        await saveTask(ctx, updatedTask);
   313→        await commitIfShadow(ctx.shadow, 'task-set', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), changes.join(', '));
   314→        success(`Updated task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(', ')})`, { task: updatedTask });
   315→      } catch (err) {
   316→        error(errors.failures.updateTask, err);
   317→        process.exit(1);
   318→      }
   319→    });
   320→
   321→  // kspec task patch <ref>
   322→  task
   323→    .command('patch <ref>')
   324→    .description('Update task with JSON data')
   325→    .option('--data <json>', 'JSON object with fields to update')
   326→    .option('--dry-run', 'Show what would change without writing')
   327→    .option('--allow-unknown', 'Allow unknown fields (for extending format)')
   328→    .action(async (ref: string, options) => {
   329→      try {
   330→        const ctx = await initContext();
   331→        const tasks = await loadAllTasks(ctx);
   332→        const items = await loadAllItems(ctx);
   333→
   334→        // Load meta items for validation
   335→        const { loadMetaContext } = await import('../../parser/meta.js');
   336→        const metaContext = await loadMetaContext(ctx);
   337→        const allMetaItems = [
   338→          ...metaContext.agents,
   339→          ...metaContext.workflows,
   340→          ...metaContext.conventions,
   341→          ...metaContext.observations,
   342→        ];
   343→
   344→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   345→        const foundTask = resolveTaskRef(ref, tasks, index);
   346→
   347→        // Get JSON data from --data flag or stdin
   348→        let jsonData: string;
   349→        if (options.data) {
   350→          jsonData = options.data;
   351→        } else {
   352→          // Read from stdin
   353→          const chunks: Buffer[] = [];
   354→          for await (const chunk of process.stdin) {
   355→            chunks.push(chunk);
   356→          }
   357→          jsonData = Buffer.concat(chunks).toString('utf-8');
   358→        }
   359→
   360→        // Parse JSON
   361→        let patchData: Record<string, unknown>;
   362→        try {
   363→          patchData = JSON.parse(jsonData);
   364→        } catch (parseErr) {
   365→          error(errors.validation.invalidJson, parseErr);
   366→          process.exit(1);
   367→        }
   368→
   369→        // Validate against TaskInputSchema (partial)
   370→        const { TaskInputSchema } = await import('../../schema/index.js');
   371→
   372→        // Create a partial schema for validation
   373→        const partialSchema = options.allowUnknown
   374→          ? TaskInputSchema.partial().passthrough()
   375→          : TaskInputSchema.partial().strict();
   376→
   377→        let validatedPatch: Partial<TaskInput>;
   378→        try {
   379→          validatedPatch = partialSchema.parse(patchData);
   380→        } catch (validationErr) {
   381→          error(errors.validation.invalidPatchData(String(validationErr)), validationErr);
   382→          process.exit(1);
   383→        }
   384→
   385→        // Check for unknown fields if strict mode
   386→        if (!options.allowUnknown) {
   387→          const knownFields = Object.keys(TaskInputSchema.shape);
   388→          const providedFields = Object.keys(patchData);
   389→          const unknownFields = providedFields.filter(f => !knownFields.includes(f));
   390→
   391→          if (unknownFields.length > 0) {
   392→            error(errors.validation.unknownFields(unknownFields));
   393→            process.exit(1);
   394→          }
   395→        }
   396→
   397→        // Build updated task
   398→        const updatedTask: Task = { ...foundTask, ...validatedPatch };
   399→
   400→        // Track changes for output
   401→        const changes = Object.keys(validatedPatch);
   402→
   403→        if (options.dryRun) {
   404→          info('Dry run - no changes will be written');
   405→          info(`Would update: ${changes.join(', ')}`);
   406→          output({ changes, updated: updatedTask }, () => {
   407→            console.log(`\nChanges: ${changes.join(', ')}\n`);
   408→            return formatTaskDetails(updatedTask, index);
   409→          });
   410→          return;
   411→        }
   412→
   413→        await saveTask(ctx, updatedTask);
   414→        await commitIfShadow(ctx.shadow, 'task-patch', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), changes.join(', '));
   415→        success(`Patched task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(', ')})`, { task: updatedTask });
   416→      } catch (err) {
   417→        error(errors.failures.patchTask, err);
   418→        process.exit(1);
   419→      }
   420→    });
   421→
   422→  // kspec task start <ref>
   423→  task
   424→    .command('start <ref>')
   425→    .description('Start working on a task (pending -> in_progress)')
   426→    .option('--no-sync', 'Skip syncing spec implementation status')
   427→    .action(async (ref: string, options) => {
   428→      try {
   429→        const ctx = await initContext();
   430→        const tasks = await loadAllTasks(ctx);
   431→        const items = await loadAllItems(ctx);
   432→        const index = new ReferenceIndex(tasks, items);
   433→        const foundTask = resolveTaskRef(ref, tasks, index);
   434→
   435→        if (foundTask.status === 'in_progress') {
   436→          warn('Task is already in progress');
   437→          output(foundTask, () => formatTaskDetails(foundTask));
   438→          return;
   439→        }
   440→
   441→        if (foundTask.status !== 'pending') {
   442→          error(errors.status.cannotStart(foundTask.status));
   443→          process.exit(4); // Exit code 4 = invalid state
   444→        }
   445→
   446→        // Update status
   447→        const updatedTask: Task = {
   448→          ...foundTask,
   449→          status: 'in_progress',
   450→          started_at: new Date().toISOString(),
   451→        };
   452→
   453→        await saveTask(ctx, updatedTask);
   454→        await commitIfShadow(ctx.shadow, 'task-start', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   455→        success(`Started task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   456→
   457→        // Sync spec implementation status (unless --no-sync)
   458→        if (options.sync !== false && foundTask.spec_ref) {
   459→          const updatedTasks = tasks.map(t =>
   460→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t
   461→          );
   462→          const syncResult = await syncSpecImplementationStatus(
   463→            ctx,
   464→            updatedTask as LoadedTask,
   465→            updatedTasks as LoadedTask[],
   466→            items,
   467→            index
   468→          );
   469→          if (syncResult) {
   470→            info(`Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   471→          }
   472→        }
   473→      } catch (err) {
   474→        error(errors.failures.startTask, err);
   475→        process.exit(1);
   476→      }
   477→    });
   478→
   479→  // kspec task complete <ref>
   480→  task
   481→    .command('complete <ref>')
   482→    .description('Complete a task (in_progress -> completed)')
   483→    .option('--reason <reason>', 'Completion reason/notes')
   484→    .option('--no-sync', 'Skip syncing spec implementation status')
   485→    .action(async (ref: string, options) => {
   486→      try {
   487→        const ctx = await initContext();
   488→        const tasks = await loadAllTasks(ctx);
   489→        const items = await loadAllItems(ctx);
   490→        const index = new ReferenceIndex(tasks, items);
   491→        const foundTask = resolveTaskRef(ref, tasks, index);
   492→
   493→        if (foundTask.status === 'completed') {
   494→          warn('Task is already completed');
   495→          output(foundTask, () => formatTaskDetails(foundTask));
   496→          return;
   497→        }
   498→
   499→        if (foundTask.status !== 'in_progress' && foundTask.status !== 'pending') {
   500→          error(errors.status.cannotComplete(foundTask.status));
   501→          process.exit(4);
   502→        }
   503→
   504→        const now = new Date().toISOString();
   505→
   506→        // Update status
   507→        const updatedTask: Task = {
   508→          ...foundTask,
   509→          status: 'completed',
   510→          completed_at: now,
   511→          closed_reason: options.reason || null,
   512→          started_at: foundTask.started_at || now, // Set started_at if not already
   513→        };
   514→
   515→        await saveTask(ctx, updatedTask);
   516→        await commitIfShadow(ctx.shadow, 'task-complete', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), options.reason);
   517→        success(`Completed task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   518→
   519→        // Output commit guidance (suppressed in JSON mode)
   520→        if (!isJsonMode()) {
   521→          const guidance = formatCommitGuidance(updatedTask);
   522→          printCommitGuidance(guidance);
   523→        }
   524→
   525→        // Sync spec implementation status (unless --no-sync)
   526→        if (options.sync !== false && foundTask.spec_ref) {
   527→          // Update task list to reflect the change we just made
   528→          const updatedTasks = tasks.map(t =>
   529→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t
   530→          );
   531→          const syncResult = await syncSpecImplementationStatus(
   532→            ctx,
   533→            updatedTask as LoadedTask,
   534→            updatedTasks as LoadedTask[],
   535→            items,
   536→            index
   537→          );
   538→          if (syncResult) {
   539→            info(`Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   540→          }
   541→        }
   542→      } catch (err) {
   543→        error(errors.failures.completeTask, err);
   544→        process.exit(1);
   545→      }
   546→    });
   547→
   548→  // kspec task block <ref>
   549→  task
   550→    .command('block <ref>')
   551→    .description('Block a task')
   552→    .requiredOption('--reason <reason>', 'Reason for blocking')
   553→    .action(async (ref: string, options) => {
   554→      try {
   555→        const ctx = await initContext();
   556→        const tasks = await loadAllTasks(ctx);
   557→        const items = await loadAllItems(ctx);
   558→        const index = new ReferenceIndex(tasks, items);
   559→        const foundTask = resolveTaskRef(ref, tasks, index);
   560→
   561→        if (foundTask.status === 'completed' || foundTask.status === 'cancelled') {
   562→          error(errors.status.cannotBlock(foundTask.status));
   563→          process.exit(4);
   564→        }
   565→
   566→        const updatedTask: Task = {
   567→          ...foundTask,
   568→          status: 'blocked',
   569→          blocked_by: [...foundTask.blocked_by, options.reason],
   570→        };
   571→
   572→        await saveTask(ctx, updatedTask);
   573→        await commitIfShadow(ctx.shadow, 'task-block', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   574→        success(`Blocked task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   575→      } catch (err) {
   576→        error(errors.failures.blockTask, err);
   577→        process.exit(1);
   578→      }
   579→    });
   580→
   581→  // kspec task unblock <ref>
   582→  task
   583→    .command('unblock <ref>')
   584→    .description('Unblock a task')
   585→    .action(async (ref: string) => {
   586→      try {
   587→        const ctx = await initContext();
   588→        const tasks = await loadAllTasks(ctx);
   589→        const items = await loadAllItems(ctx);
   590→        const index = new ReferenceIndex(tasks, items);
   591→        const foundTask = resolveTaskRef(ref, tasks, index);
   592→
   593→        if (foundTask.status !== 'blocked') {
   594→          warn('Task is not blocked');
   595→          return;
   596→        }
   597→
   598→        const updatedTask: Task = {
   599→          ...foundTask,
   600→          status: 'pending',
   601→          blocked_by: [],
   602→        };
   603→
   604→        await saveTask(ctx, updatedTask);
   605→        await commitIfShadow(ctx.shadow, 'task-unblock', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   606→        success(`Unblocked task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   607→      } catch (err) {
   608→        error(errors.failures.unblockTask, err);
   609→        process.exit(1);
   610→      }
   611→    });
   612→
   613→  // kspec task cancel <ref>
   614→  task
   615→    .command('cancel <ref>')
   616→    .description('Cancel a task')
   617→    .option('--reason <reason>', 'Cancellation reason')
   618→    .action(async (ref: string, options) => {
   619→      try {
   620→        const ctx = await initContext();
   621→        const tasks = await loadAllTasks(ctx);
   622→        const items = await loadAllItems(ctx);
   623→        const index = new ReferenceIndex(tasks, items);
   624→        const foundTask = resolveTaskRef(ref, tasks, index);
   625→
   626→        if (foundTask.status === 'completed' || foundTask.status === 'cancelled') {
   627→          warn(`Task is already ${foundTask.status}`);
   628→          return;
   629→        }
   630→
   631→        const updatedTask: Task = {
   632→          ...foundTask,
   633→          status: 'cancelled',
   634→          closed_reason: options.reason || null,
   635→        };
   636→
   637→        await saveTask(ctx, updatedTask);
   638→        await commitIfShadow(ctx.shadow, 'task-cancel', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   639→        success(`Cancelled task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   640→      } catch (err) {
   641→        error(errors.failures.cancelTask, err);
   642→        process.exit(1);
   643→      }
   644→    });
   645→
   646→  // kspec task delete <ref>
   647→  task
   648→    .command('delete <ref>')
   649→    .description('Delete a task permanently')
   650→    .option('--force', 'Skip confirmation')
   651→    .option('--dry-run', 'Show what would be deleted without deleting')
   652→    .action(async (ref: string, options) => {
   653→      try {
   654→        const ctx = await initContext();
   655→        const tasks = await loadAllTasks(ctx);
   656→        const items = await loadAllItems(ctx);
   657→        const index = new ReferenceIndex(tasks, items);
   658→        const foundTask = resolveTaskRef(ref, tasks, index);
   659→
   660→        const taskDisplay = `${foundTask.title} (${index.shortUlid(foundTask._ulid)})`;
   661→
   662→        if (options.dryRun) {
   663→          info(`Would delete task: ${taskDisplay}`);
   664→          console.log(`  Source file: ${foundTask._sourceFile}`);
   665→          console.log(`  Status: ${foundTask.status}`);
   666→          if (foundTask.notes.length > 0) {
   667→            console.log(`  Notes: ${foundTask.notes.length}`);
   668→          }
   669→          return;
   670→        }
   671→
   672→        // Confirm unless --force
   673→        if (!options.force) {
   674→          const readline = await import('readline');
   675→          const rl = readline.createInterface({
   676→            input: process.stdin,
   677→            output: process.stdout,
   678→          });
   679→
   680→          const answer = await new Promise<string>((resolve) => {
   681→            rl.question(`Delete task "${taskDisplay}"? [y/N] `, resolve);
   682→          });
   683→          rl.close();
   684→
   685→          if (answer.toLowerCase() !== 'y') {
   686→            info('Deletion cancelled');
   687→            return;
   688→          }
   689→        }
   690→
   691→        await deleteTask(ctx, foundTask);
   692→        await commitIfShadow(ctx.shadow, 'task-delete', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), foundTask.title);
   693→        success(`Deleted task: ${taskDisplay}`);
   694→      } catch (err) {
   695→        error(errors.failures.deleteTask, err);
   696→        process.exit(1);
   697→      }
   698→    });
   699→
   700→  // kspec task note <ref> <message>
   701→  task
   702→    .command('note <ref> <message>')
   703→    .description('Add a note to a task')
   704→    .option('--author <author>', 'Note author')
   705→    .option('--supersedes <ulid>', 'ULID of note this supersedes')
   706→    .action(async (ref: string, message: string, options) => {
   707→      try {
   708→        const ctx = await initContext();
   709→        const tasks = await loadAllTasks(ctx);
   710→        const items = await loadAllItems(ctx);
   711→        const index = new ReferenceIndex(tasks, items);
   712→        const foundTask = resolveTaskRef(ref, tasks, index);
   713→
   714→        const note = createNote(message, options.author, options.supersedes);
   715→
   716→        const updatedTask: Task = {
   717→          ...foundTask,
   718→          notes: [...foundTask.notes, note],
   719→        };
   720→
   721→        await saveTask(ctx, updatedTask);
   722→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   723→        success(`Added note to task: ${index.shortUlid(updatedTask._ulid)}`, { note });
   724→
   725→        // Proactive alignment guidance for tasks with spec_ref
   726→        if (foundTask.spec_ref) {
   727→          console.log('');
   728→          console.log(alignmentCheck.header);
   729→          console.log(alignmentCheck.beyondSpec);
   730→          console.log(alignmentCheck.updateSpec(foundTask.spec_ref));
   731→          console.log(alignmentCheck.addAC);
   732→
   733→          // Check if linked spec has acceptance criteria and remind about test coverage
   734→          const specResult = index.resolve(foundTask.spec_ref);
   735→          if (specResult.ok && specResult.item) {
   736→            const specItem = specResult.item as { acceptance_criteria?: unknown[] };
   737→            if (specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
   738→              console.log('');
   739→              console.log(alignmentCheck.testCoverage(specItem.acceptance_criteria.length));
   740→            }
   741→          }
   742→        }
   743→      } catch (err) {
   744→        error(errors.failures.addNote, err);
   745→        process.exit(1);
   746→      }
   747→    });
   748→
   749→  // kspec task notes <ref>
   750→  task
   751→    .command('notes <ref>')
   752→    .description('Show notes for a task')
   753→    .action(async (ref: string) => {
   754→      try {
   755→        const ctx = await initContext();
   756→        const tasks = await loadAllTasks(ctx);
   757→        const items = await loadAllItems(ctx);
   758→        const index = new ReferenceIndex(tasks, items);
   759→        const foundTask = resolveTaskRef(ref, tasks, index);
   760→
   761→        output(foundTask.notes, () => {
   762→          if (foundTask.notes.length === 0) {
   763→            console.log('No notes');
   764→          } else {
   765→            for (const note of foundTask.notes) {
   766→              const author = note.author || 'unknown';
   767→              console.log(`[${note.created_at}] ${author}:`);
   768→              console.log(note.content);
   769→              console.log('');
   770→            }
   771→          }
   772→        });
   773→      } catch (err) {
   774→        error(errors.failures.getNotes, err);
   775→        process.exit(1);
   776→      }
   777→    });
   778→
   779→  // kspec task todos <ref>
   780→  task
   781→    .command('todos <ref>')
   782→    .description('Show todos for a task')
   783→    .action(async (ref: string) => {
   784→      try {
   785→        const ctx = await initContext();
   786→        const tasks = await loadAllTasks(ctx);
   787→        const items = await loadAllItems(ctx);
   788→        const index = new ReferenceIndex(tasks, items);
   789→        const foundTask = resolveTaskRef(ref, tasks, index);
   790→
   791→        output(foundTask.todos, () => {
   792→          if (foundTask.todos.length === 0) {
   793→            console.log('No todos');
   794→          } else {
   795→            for (const todo of foundTask.todos) {
   796→              const status = todo.done ? '[x]' : '[ ]';
   797→              const doneInfo = todo.done && todo.done_at ? ` (done ${todo.done_at})` : '';
   798→              console.log(`${status} ${todo.id}. ${todo.text}${doneInfo}`);
   799→            }
   800→          }
   801→        });
   802→      } catch (err) {
   803→        error(errors.failures.getTodos, err);
   804→        process.exit(1);
   805→      }
   806→    });
   807→
   808→  // Create subcommand group for todo operations
   809→  const todoCmd = task
   810→    .command('todo')
   811→    .description('Manage task todos');
   812→
   813→  // kspec task todo add <ref> <text>
   814→  todoCmd
   815→    .command('add <ref> <text>')
   816→    .description('Add a todo to a task')
   817→    .option('--author <author>', 'Todo author')
   818→    .action(async (ref: string, text: string, options) => {
   819→      try {
   820→        const ctx = await initContext();
   821→        const tasks = await loadAllTasks(ctx);
   822→        const items = await loadAllItems(ctx);
   823→        const index = new ReferenceIndex(tasks, items);
   824→        const foundTask = resolveTaskRef(ref, tasks, index);
   825→
   826→        // Calculate next ID (max existing + 1, or 1 if none)
   827→        const nextId = foundTask.todos.length > 0
   828→          ? Math.max(...foundTask.todos.map(t => t.id)) + 1
   829→          : 1;
   830→
   831→        const todo = createTodo(nextId, text, options.author);
   832→
   833→        const updatedTask: Task = {
   834→          ...foundTask,
   835→          todos: [...foundTask.todos, todo],
   836→        };
   837→
   838→        await saveTask(ctx, updatedTask);
   839→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   840→        success(`Added todo #${todo.id} to task: ${index.shortUlid(updatedTask._ulid)}`, { todo });
   841→      } catch (err) {
   842→        error(errors.failures.addTodo, err);
   843→        process.exit(1);
   844→      }
   845→    });
   846→
   847→  // kspec task todo done <ref> <id>
   848→  todoCmd
   849→    .command('done <ref> <id>')
   850→    .description('Mark a todo as done')
   851→    .action(async (ref: string, idStr: string) => {
   852→      try {
   853→        const ctx = await initContext();
   854→        const tasks = await loadAllTasks(ctx);
   855→        const items = await loadAllItems(ctx);
   856→        const index = new ReferenceIndex(tasks, items);
   857→        const foundTask = resolveTaskRef(ref, tasks, index);
   858→
   859→        const id = parseInt(idStr, 10);
   860→        if (isNaN(id)) {
   861→          error(errors.todo.invalidId(idStr));
   862→          process.exit(3);
   863→        }
   864→
   865→        const todoIndex = foundTask.todos.findIndex(t => t.id === id);
   866→        if (todoIndex === -1) {
   867→          error(errors.todo.notFound(id));
   868→          process.exit(3);
   869→        }
   870→
   871→        if (foundTask.todos[todoIndex].done) {
   872→          warn(`Todo #${id} is already done`);
   873→          return;
   874→        }
   875→
   876→        const updatedTodos = [...foundTask.todos];
   877→        updatedTodos[todoIndex] = {
   878→          ...updatedTodos[todoIndex],
   879→          done: true,
   880→          done_at: new Date().toISOString(),
   881→        };
   882→
   883→        const updatedTask: Task = {
   884→          ...foundTask,
   885→          todos: updatedTodos,
   886→        };
   887→
   888→        await saveTask(ctx, updatedTask);
   889→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   890→        success(`Marked todo #${id} as done`, { todo: updatedTodos[todoIndex] });
   891→      } catch (err) {
   892→        error(errors.failures.markTodoDone, err);
   893→        process.exit(1);
   894→      }
   895→    });
   896→
   897→  // kspec task todo undone <ref> <id>
   898→  todoCmd
   899→    .command('undone <ref> <id>')
   900→    .description('Mark a todo as not done')
   901→    .action(async (ref: string, idStr: string) => {
   902→      try {
   903→        const ctx = await initContext();
   904→        const tasks = await loadAllTasks(ctx);
   905→        const items = await loadAllItems(ctx);
   906→        const index = new ReferenceIndex(tasks, items);
   907→        const foundTask = resolveTaskRef(ref, tasks, index);
   908→
   909→        const id = parseInt(idStr, 10);
   910→        if (isNaN(id)) {
   911→          error(errors.todo.invalidId(idStr));
   912→          process.exit(3);
   913→        }
   914→
   915→        const todoIndex = foundTask.todos.findIndex(t => t.id === id);
   916→        if (todoIndex === -1) {
   917→          error(errors.todo.notFound(id));
   918→          process.exit(3);
   919→        }
   920→
   921→        if (!foundTask.todos[todoIndex].done) {
   922→          warn(`Todo #${id} is not done`);
   923→          return;
   924→        }
   925→
   926→        const updatedTodos = [...foundTask.todos];
   927→        updatedTodos[todoIndex] = {
   928→          ...updatedTodos[todoIndex],
   929→          done: false,
   930→          done_at: undefined,
   931→        };
   932→
   933→        const updatedTask: Task = {
   934→          ...foundTask,
   935→          todos: updatedTodos,
   936→        };
   937→
   938→        await saveTask(ctx, updatedTask);
   939→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   940→        success(`Marked todo #${id} as not done`, { todo: updatedTodos[todoIndex] });
   941→      } catch (err) {
   942→        error(errors.failures.markTodoNotDone, err);
   943→        process.exit(1);
   944→      }
   945→    });
   946→}
