```
     1→import { Command } from 'commander';
     2→import chalk from 'chalk';
     3→import {
     4→  initContext,
     5→  buildIndexes,
     6→  createSpecItem,
     7→  deleteSpecItem,
     8→  updateSpecItem,
     9→  addChildItem,
    10→  loadAllItems,
    11→  loadAllTasks,
    12→  ReferenceIndex,
    13→  AlignmentIndex,
    14→  checkSlugUniqueness,
    15→  patchSpecItems,
    16→  type LoadedSpecItem,
    17→  type PatchOperation,
    18→  type BulkPatchResult,
    19→} from '../../parser/index.js';
    20→import { commitIfShadow } from '../../parser/shadow.js';
    21→import type { ItemFilter } from '../../parser/items.js';
    22→import type { ItemType, Maturity, ImplementationStatus, SpecItemInput, AcceptanceCriterion } from '../../schema/index.js';
    23→import { SpecItemPatchSchema } from '../../schema/index.js';
    24→import { output, error, success, warn, isJsonMode } from '../output.js';
    25→import { grepItem, formatMatchedFields } from '../../utils/grep.js';
    26→import { errors } from '../../strings/errors.js';
    27→import { fieldLabels, sectionHeaders } from '../../strings/labels.js';
    28→
    29→/**
    30→ * Format a spec item for display
    31→ */
    32→function formatItem(item: LoadedSpecItem, verbose = false, grepPattern?: string): string {
    33→  const shortId = item._ulid.slice(0, 8);
    34→  const slugStr = item.slugs.length > 0 ? chalk.cyan(`@${item.slugs[0]}`) : '';
    35→  const typeStr = chalk.gray(`[${item.type}]`);
    36→
    37→  let status = '';
    38→  if (item.status && typeof item.status === 'object') {
    39→    const s = item.status as { maturity?: string; implementation?: string };
    40→    if (s.implementation) {
    41→      const implColor = s.implementation === 'verified' ? chalk.green
    42→        : s.implementation === 'implemented' ? chalk.cyan
    43→          : s.implementation === 'in_progress' ? chalk.yellow
    44→            : chalk.gray;
    45→      status = implColor(s.implementation);
    46→    } else if (s.maturity) {
    47→      status = chalk.gray(s.maturity);
    48→    }
    49→  }
    50→
    51→  let line = `${chalk.gray(shortId)} ${typeStr} ${item.title}`;
    52→  if (slugStr) line += ` ${slugStr}`;
    53→  if (status) line += ` ${status}`;
    54→
    55→  if (verbose) {
    56→    const tags = 'tags' in item && Array.isArray(item.tags) ? item.tags : [];
    57→    if (tags.length > 0) {
    58→      line += chalk.blue(` #${tags.join(' #')}`);
    59→    }
    60→  }
    61→
    62→  // Show matched fields if grep pattern provided
    63→  if (grepPattern) {
    64→    const match = grepItem(item as unknown as Record<string, unknown>, grepPattern);
    65→    if (match && match.matchedFields.length > 0) {
    66→      line += '\n  ' + chalk.gray(`matched: ${formatMatchedFields(match.matchedFields)}`);
    67→    }
    68→  }
    69→
    70→  return line;
    71→}
    72→
    73→/**
    74→ * Format item list for display
    75→ */
    76→function formatItemList(items: LoadedSpecItem[], verbose = false, grepPattern?: string): void {
    77→  if (items.length === 0) {
    78→    console.log(chalk.gray('No items found'));
    79→    return;
    80→  }
    81→
    82→  for (const item of items) {
    83→    console.log(formatItem(item, verbose, grepPattern));
    84→  }
    85→
    86→  console.log(chalk.gray(`\n${items.length} item(s)`));
    87→}
    88→
    89→/**
    90→ * Register item commands
    91→ */
    92→export function registerItemCommands(program: Command): void {
    93→  const item = program
    94→    .command('item')
    95→    .description('Spec item commands');
    96→
    97→  // kspec item list
    98→  item
    99→    .command('list')
   100→    .description('List spec items with optional filters')
   101→    .option('-t, --type <type>', 'Filter by item type (module, feature, requirement, constraint, decision)')
   102→    .option('-s, --status <status>', 'Filter by implementation status (not_started, in_progress, implemented, verified)')
   103→    .option('-m, --maturity <maturity>', 'Filter by maturity (draft, proposed, stable, deprecated)')
   104→    .option('--tag <tag>', 'Filter by tag (can specify multiple)', (val, prev: string[]) => [...prev, val], [])
   105→    .option('--has <field>', 'Filter items that have field present', (val, prev: string[]) => [...prev, val], [])
   106→    .option('-q, --search <text>', 'Search in title')
   107→    .option('-g, --grep <pattern>', 'Search content with regex pattern')
   108→    .option('-v, --verbose', 'Show more details')
   109→    .option('--limit <n>', 'Limit results', '50')
   110→    .action(async (options) => {
   111→      try {
   112→        const ctx = await initContext();
   113→        const { itemIndex, items } = await buildIndexes(ctx);
   114→
   115→        // Build filter from options
   116→        const filter: ItemFilter = {
   117→          specItemsOnly: true, // Only spec items, not tasks
   118→        };
   119→
   120→        if (options.type) {
   121→          filter.type = options.type as ItemType;
   122→        }
   123→
   124→        if (options.status) {
   125→          filter.implementation = options.status as ImplementationStatus;
   126→        }
   127→
   128→        if (options.maturity) {
   129→          filter.maturity = options.maturity as Maturity;
   130→        }
   131→
   132→        if (options.tag && options.tag.length > 0) {
   133→          filter.tags = options.tag;
   134→        }
   135→
   136→        if (options.has && options.has.length > 0) {
   137→          filter.hasFields = options.has;
   138→        }
   139→
   140→        if (options.search) {
   141→          filter.titleContains = options.search;
   142→        }
   143→
   144→        if (options.grep) {
   145→          filter.grepSearch = options.grep;
   146→        }
   147→
   148→        const limit = parseInt(options.limit, 10) || 50;
   149→        const result = itemIndex.queryPaginated(filter, 0, limit);
   150→
   151→        // Filter to only LoadedSpecItem (not tasks)
   152→        const specItems = result.items.filter((item): item is LoadedSpecItem =>
   153→          !('status' in item && typeof item.status === 'string')
   154→        );
   155→
   156→        output(
   157→          {
   158→            items: specItems,
   159→            total: result.total,
   160→            showing: specItems.length,
   161→            grepPattern: options.grep,
   162→          },
   163→          () => formatItemList(specItems, options.verbose, options.grep)
   164→        );
   165→      } catch (err) {
   166→        error(errors.failures.listItems, err);
   167→        process.exit(1);
   168→      }
   169→    });
   170→
   171→  // kspec item get <ref>
   172→  item
   173→    .command('get <ref>')
   174→    .description('Get details for a specific item')
   175→    .action(async (ref) => {
   176→      try {
   177→        const ctx = await initContext();
   178→        const { refIndex, items } = await buildIndexes(ctx);
   179→
   180→        const result = refIndex.resolve(ref);
   181→
   182→        if (!result.ok) {
   183→          error(errors.reference.itemNotFound(ref));
   184→          process.exit(1);
   185→        }
   186→
   187→        const item = result.item as LoadedSpecItem;
   188→
   189→        output(item, () => {
   190→          console.log(chalk.bold(item.title));
   191→          console.log(chalk.gray('─'.repeat(40)));
   192→          console.log(`${fieldLabels.ulid}      ${item._ulid}`);
   193→          if (item.slugs.length > 0) {
   194→            console.log(`${fieldLabels.slugs}     ${item.slugs.join(', ')}`);
   195→          }
   196→          console.log(`${fieldLabels.type}      ${item.type}`);
   197→
   198→          if (item.status && typeof item.status === 'object') {
   199→            const s = item.status as { maturity?: string; implementation?: string };
   200→            if (s.maturity) console.log(`${fieldLabels.maturity}  ${s.maturity}`);
   201→            if (s.implementation) console.log(`${fieldLabels.implementation}${s.implementation}`);
   202→          }
   203→
   204→          if ('tags' in item && Array.isArray(item.tags) && item.tags.length > 0) {
   205→            console.log(`${fieldLabels.tags}      ${item.tags.join(', ')}`);
   206→          }
   207→
   208→          if (item.description) {
   209→            console.log('\n' + sectionHeaders.description);
   210→            console.log(item.description);
   211→          }
   212→
   213→          if ('acceptance_criteria' in item && Array.isArray(item.acceptance_criteria) && item.acceptance_criteria.length > 0) {
   214→            console.log('\n' + sectionHeaders.acceptanceCriteria);
   215→            for (const ac of item.acceptance_criteria) {
   216→              if (ac && typeof ac === 'object' && 'id' in ac) {
   217→                const acObj = ac as AcceptanceCriterion;
   218→                console.log(chalk.cyan(`  [${acObj.id}]`));
   219→                if (acObj.given) console.log(`    Given: ${acObj.given}`);
   220→                if (acObj.when) console.log(`    When: ${acObj.when}`);
   221→                if (acObj.then) console.log(`    Then: ${acObj.then}`);
   222→              }
   223→            }
   224→          }
   225→        });
   226→      } catch (err) {
   227→        error(errors.failures.getItem, err);
   228→        process.exit(1);
   229→      }
   230→    });
   231→
   232→  // kspec item types - show available types and counts
   233→  item
   234→    .command('types')
   235→    .description('Show item types and counts')
   236→    .action(async () => {
   237→      try {
   238→        const ctx = await initContext();
   239→        const { itemIndex } = await buildIndexes(ctx);
   240→
   241→        const typeCounts = itemIndex.getTypeCounts();
   242→
   243→        output(
   244→          Object.fromEntries(typeCounts),
   245→          () => {
   246→            console.log(chalk.bold('Item Types'));
   247→            console.log(chalk.gray('─'.repeat(30)));
   248→            for (const [type, count] of typeCounts) {
   249→              console.log(`  ${type}: ${count}`);
   250→            }
   251→            console.log(chalk.gray(`\nTotal: ${itemIndex.size} items`));
   252→          }
   253→        );
   254→      } catch (err) {
   255→        error(errors.failures.getTypes, err);
   256→        process.exit(1);
   257→      }
   258→    });
   259→
   260→  // kspec item tags - show available tags and counts
   261→  item
   262→    .command('tags')
   263→    .description('Show tags and counts')
   264→    .action(async () => {
   265→      try {
   266→        const ctx = await initContext();
   267→        const { itemIndex } = await buildIndexes(ctx);
   268→
   269→        const tagCounts = itemIndex.getTagCounts();
   270→
   271→        output(
   272→          Object.fromEntries(tagCounts),
   273→          () => {
   274→            console.log(chalk.bold('Tags'));
   275→            console.log(chalk.gray('─'.repeat(30)));
   276→            for (const [tag, count] of tagCounts) {
   277→              console.log(`  #${tag}: ${count}`);
   278→            }
   279→          }
   280→        );
   281→      } catch (err) {
   282→        error(errors.failures.getTags, err);
   283→        process.exit(1);
   284→      }
   285→    });
   286→
   287→  // kspec item add - create a new spec item under a parent
   288→  item
   289→    .command('add')
   290→    .description('Create a new spec item under a parent')
   291→    .requiredOption('--under <ref>', 'Parent item reference (e.g., @core-primitives)')
   292→    .requiredOption('--title <title>', 'Item title')
   293→    .option('--type <type>', 'Item type (feature, requirement, constraint, decision)', 'feature')
   294→    .option('--slug <slug>', 'Human-friendly slug')
   295→    .option('--priority <priority>', 'Priority (high, medium, low)')
   296→    .option('--tag <tag...>', 'Tags')
   297→    .option('--description <desc>', 'Description')
   298→    .option('--as <field>', 'Child field override (e.g., requirements, constraints)')
   299→    .action(async (options) => {
   300→      try {
   301→        const ctx = await initContext();
   302→        const { refIndex, items } = await buildIndexes(ctx);
   303→
   304→        // Find the parent item
   305→        const parentResult = refIndex.resolve(options.under);
   306→        if (!parentResult.ok) {
   307→          error(errors.reference.itemNotFound(options.under));
   308→          process.exit(1);
   309→        }
   310→
   311→        const parent = parentResult.item as LoadedSpecItem;
   312→
   313→        // Check it's not a task
   314→        if ('status' in parent && typeof parent.status === 'string') {
   315→          error(errors.reference.parentIsTask(options.under));
   316→          process.exit(1);
   317→        }
   318→
   319→        // Check slug uniqueness if provided
   320→        if (options.slug) {
   321→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   322→          if (!slugCheck.ok) {
   323→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   324→            process.exit(1);
   325→          }
   326→        }
   327→
   328→        const input: SpecItemInput = {
   329→          title: options.title,
   330→          type: options.type as ItemType,
   331→          slugs: options.slug ? [options.slug] : [],
   332→          priority: options.priority,
   333→          tags: options.tag || [],
   334→          description: options.description,
   335→          depends_on: [],
   336→          implements: [],
   337→          relates_to: [],
   338→          tests: [],
   339→        };
   340→
   341→        const newItem = createSpecItem(input);
   342→        const result = await addChildItem(ctx, parent, newItem, options.as);
   343→
   344→        // Build index including the new item for accurate short ULID
   345→        const index = new ReferenceIndex([], [...items, result.item as LoadedSpecItem]);
   346→        const itemSlug = (result.item as LoadedSpecItem).slugs?.[0] || index.shortUlid(result.item._ulid);
   347→        await commitIfShadow(ctx.shadow, 'item-add', itemSlug);
   348→        success(`Created item: ${index.shortUlid(result.item._ulid)} under @${parent.slugs[0] || parent._ulid.slice(0, 8)}`, {
   349→          item: result.item,
   350→          path: result.path,
   351→        });
   352→
   353→        // Derive hint
   354→        if (!isJsonMode()) {
   355→          const refSlug = (result.item as LoadedSpecItem).slugs?.[0] || index.shortUlid(result.item._ulid);
   356→          console.log(chalk.gray(`\nDerive implementation task? kspec derive @${refSlug}`));
   357→        }
   358→      } catch (err) {
   359→        error(errors.failures.createItem, err);
   360→        process.exit(1);
   361→      }
   362→    });
   363→
   364→  // kspec item set - update a spec item field
   365→  item
   366→    .command('set <ref>')
   367→    .description('Update a spec item field')
   368→    .option('--title <title>', 'Set title')
   369→    .option('--type <type>', 'Set type')
   370→    .option('--slug <slug>', 'Add a slug')
   371→    .option('--remove-slug <slug>', 'Remove a slug')
   372→    .option('--priority <priority>', 'Set priority')
   373→    .option('--tag <tag...>', 'Set tags (replaces existing)')
   374→    .option('--description <desc>', 'Set description')
   375→    .option('--status <status>', 'Set implementation status (not_started, in_progress, implemented, verified)')
   376→    .option('--maturity <maturity>', 'Set maturity (draft, proposed, stable, deprecated)')
   377→    .action(async (ref, options) => {
   378→      try {
   379→        const ctx = await initContext();
   380→        const { refIndex, items } = await buildIndexes(ctx);
   381→
   382→        const result = refIndex.resolve(ref);
   383→        if (!result.ok) {
   384→          error(errors.reference.itemNotFound(ref));
   385→          process.exit(1);
   386→        }
   387→
   388→        const foundItem = result.item as LoadedSpecItem;
   389→
   390→        // Check if it's a task (tasks should use task commands)
   391→        if ('status' in foundItem && typeof foundItem.status === 'string') {
   392→          error(errors.reference.taskUseTaskCommands(ref));
   393→          process.exit(1);
   394→        }
   395→
   396→        // Check slug uniqueness if adding a new slug
   397→        if (options.slug) {
   398→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug], foundItem._ulid);
   399→          if (!slugCheck.ok) {
   400→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   401→            process.exit(1);
   402→          }
   403→        }
   404→
   405→        // Validate --remove-slug
   406→        if (options.removeSlug) {
   407→          const currentSlugs = foundItem.slugs || [];
   408→          if (!currentSlugs.includes(options.removeSlug)) {
   409→            error(errors.slug.notFound(options.removeSlug));
   410→            process.exit(1);
   411→          }
   412→          if (currentSlugs.length === 1) {
   413→            error(errors.slug.cannotRemoveLast(options.removeSlug));
   414→            process.exit(1);
   415→          }
   416→        }
   417→
   418→        // Build updates object
   419→        const updates: Partial<SpecItemInput> = {};
   420→
   421→        if (options.title) updates.title = options.title;
   422→        if (options.type) updates.type = options.type as ItemType;
   423→        if (options.slug || options.removeSlug) {
   424→          let slugs = [...(foundItem.slugs || [])];
   425→          if (options.removeSlug) {
   426→            slugs = slugs.filter(s => s !== options.removeSlug);
   427→          }
   428→          if (options.slug) {
   429→            slugs.push(options.slug);
   430→          }
   431→          updates.slugs = slugs;
   432→        }
   433→        if (options.priority) updates.priority = options.priority;
   434→        if (options.tag) updates.tags = options.tag;
   435→        if (options.description) updates.description = options.description;
   436→
   437→        // Handle status updates
   438→        if (options.status || options.maturity) {
   439→          const currentStatus = foundItem.status && typeof foundItem.status === 'object'
   440→            ? foundItem.status
   441→            : {};
   442→          updates.status = {
   443→            ...currentStatus,
   444→            ...(options.status && { implementation: options.status }),
   445→            ...(options.maturity && { maturity: options.maturity }),
   446→          };
   447→        }
   448→
   449→        if (Object.keys(updates).length === 0) {
   450→          warn('No updates specified');
   451→          return;
   452→        }
   453→
   454→        const updated = await updateSpecItem(ctx, foundItem, updates);
   455→        const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   456→        await commitIfShadow(ctx.shadow, 'item-set', itemSlug);
   457→        success(`Updated item: ${refIndex.shortUlid(updated._ulid)}`, { item: updated });
   458→
   459→        // Derive hint
   460→        if (!isJsonMode()) {
   461→          const refSlug = updated.slugs?.[0] || refIndex.shortUlid(updated._ulid);
   462→          console.log(chalk.gray(`\nDerive implementation task? kspec derive @${refSlug}`));
   463→        }
   464→      } catch (err) {
   465→        error(errors.failures.updateItem, err);
   466→        process.exit(1);
   467→      }
   468→    });
   469→
   470→  // kspec item delete - delete a spec item
   471→  item
   472→    .command('delete <ref>')
   473→    .description('Delete a spec item (including nested items)')
   474→    .option('--force', 'Skip confirmation')
   475→    .action(async (ref, options) => {
   476→      try {
   477→        const ctx = await initContext();
   478→        const { refIndex, items } = await buildIndexes(ctx);
   479→
   480→        const result = refIndex.resolve(ref);
   481→        if (!result.ok) {
   482→          error(errors.reference.itemNotFound(ref));
   483→          process.exit(1);
   484→        }
   485→
   486→        const foundItem = result.item as LoadedSpecItem;
   487→
   488→        // Check if it's a task
   489→        if ('status' in foundItem && typeof foundItem.status === 'string') {
   490→          error(errors.reference.itemUseTaskCancel(ref));
   491→          process.exit(1);
   492→        }
   493→
   494→        if (!foundItem._sourceFile) {
   495→          error(errors.operation.cannotDeleteNoSource);
   496→          process.exit(1);
   497→        }
   498→
   499→        // Warn about nested children being deleted too
   500→        // TODO: could add a check here for child items
   501→
   502→        const deleted = await deleteSpecItem(ctx, foundItem);
   503→        if (deleted) {
   504→          const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   505→          await commitIfShadow(ctx.shadow, 'item-delete', itemSlug);
   506→          success(`Deleted item: ${foundItem.title}`, { deleted: true, ulid: foundItem._ulid });
   507→        } else {
   508→          error(errors.failures.deleteItem);
   509→          console.log(chalk.gray('Edit the source file directly: ' + foundItem._sourceFile));
   510→          process.exit(1);
   511→        }
   512→      } catch (err) {
   513→        error(errors.failures.deleteItem, err);
   514→        process.exit(1);
   515→      }
   516→    });
   517→
   518→  // kspec item patch - update item fields via JSON
   519→  item
   520→    .command('patch [ref]')
   521→    .description('Update spec item fields via JSON patch')
   522→    .option('--data <json>', 'JSON data to patch')
   523→    .option('--bulk', 'Read patches from stdin (JSONL or JSON array)')
   524→    .option('--allow-unknown', 'Allow fields not in schema')
   525→    .option('--dry-run', 'Preview changes without applying')
   526→    .option('--fail-fast', 'Stop on first error (bulk mode)')
   527→    .action(async (ref: string | undefined, options) => {
   528→      try {
   529→        const ctx = await initContext();
   530→
   531→        if (options.bulk) {
   532→          // Bulk mode: read from stdin
   533→          const stdin = await readStdinFully();
   534→          if (!stdin) {
   535→            error(errors.validation.noInputProvided);
   536→            process.exit(1);
   537→          }
   538→
   539→          let patches: PatchOperation[];
   540→          try {
   541→            patches = parseBulkInput(stdin);
   542→          } catch (err) {
   543→            error(errors.validation.failedToParseBulk(err instanceof Error ? err.message : String(err)));
   544→            process.exit(1);
   545→          }
   546→
   547→          if (patches.length === 0) {
   548→            error(errors.validation.noPatchesProvided);
   549→            process.exit(1);
   550→          }
   551→
   552→          const { refIndex, items } = await buildIndexes(ctx);
   553→          const result = await patchSpecItems(ctx, refIndex, items, patches, {
   554→            allowUnknown: options.allowUnknown,
   555→            failFast: options.failFast,
   556→            dryRun: options.dryRun,
   557→          });
   558→
   559→          // Shadow commit if any updates
   560→          if (!options.dryRun && result.summary.updated > 0) {
   561→            await commitIfShadow(ctx.shadow, 'item-patch', `${result.summary.updated} items`);
   562→          }
   563→
   564→          output(result, () => formatBulkPatchResult(result, options.dryRun));
   565→
   566→          if (result.summary.failed > 0) {
   567→            process.exit(1);
   568→          }
   569→        } else {
   570→          // Single item mode
   571→          if (!ref) {
   572→            error(errors.usage.patchNeedRef);
   573→            process.exit(1);
   574→          }
   575→
   576→          let data: Record<string, unknown>;
   577→
   578→          // Get data from --data option or stdin
   579→          if (options.data) {
   580→            try {
   581→              data = JSON.parse(options.data);
   582→            } catch (err) {
   583→              error(errors.validation.invalidJsonInData(err instanceof Error ? err.message : ''));
   584→              process.exit(1);
   585→            }
   586→          } else {
   587→            const stdin = await readStdinIfAvailable();
   588→            if (stdin) {
   589→              try {
   590→                data = JSON.parse(stdin.trim());
   591→              } catch (err) {
   592→                error(errors.validation.invalidJsonFromStdin(err instanceof Error ? err.message : ''));
   593→                process.exit(1);
   594→              }
   595→            } else {
   596→              error(errors.validation.noPatchData);
   597→              process.exit(1);
   598→            }
   599→          }
   600→
   601→          // Validate against schema (unless --allow-unknown)
   602→          if (!options.allowUnknown) {
   603→            // Use strict schema (no passthrough)
   604→            const strictSchema = SpecItemPatchSchema.strict();
   605→            const parseResult = strictSchema.safeParse(data);
   606→            if (!parseResult.success) {
   607→              const issues = parseResult.error.issues.map(i => `${i.path.join('.')}: ${i.message}`).join('; ');
   608→              error(errors.validation.invalidPatchDataWithIssues(issues));
   609→              process.exit(1);
   610→            }
   611→          }
   612→
   613→          const { refIndex, items } = await buildIndexes(ctx);
   614→
   615→          // Resolve ref
   616→          const resolved = refIndex.resolve(ref);
   617→          if (!resolved.ok) {
   618→            error(errors.reference.itemNotFound(ref));
   619→            process.exit(1);
   620→          }
   621→
   622→          // Find the item
   623→          const foundItem = items.find(i => i._ulid === resolved.ulid);
   624→          if (!foundItem) {
   625→            error(errors.reference.notItem(ref));
   626→            process.exit(1);
   627→          }
   628→
   629→          if (options.dryRun) {
   630→            output({ ref, data, wouldApplyTo: foundItem.title, ulid: foundItem._ulid }, () => {
   631→              console.log(chalk.yellow('Would patch:'), foundItem.title);
   632→              console.log(chalk.gray('ULID:'), foundItem._ulid.slice(0, 8));
   633→              console.log(chalk.gray('Changes:'));
   634→              console.log(JSON.stringify(data, null, 2));
   635→            });
   636→            return;
   637→          }
   638→
   639→          const updated = await updateSpecItem(ctx, foundItem, data);
   640→          const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   641→          await commitIfShadow(ctx.shadow, 'item-patch', itemSlug);
   642→
   643→          success(`Patched item: ${itemSlug}`, { item: updated });
   644→        }
   645→      } catch (err) {
   646→        error(errors.failures.patchItems, err);
   647→        process.exit(1);
   648→      }
   649→    });
   650→
   651→  // kspec item status - show implementation status with linked tasks
   652→  item
   653→    .command('status <ref>')
   654→    .description('Show implementation status and linked tasks for a spec item')
   655→    .action(async (ref) => {
   656→      try {
   657→        const ctx = await initContext();
   658→        const tasks = await loadAllTasks(ctx);
   659→        const items = await loadAllItems(ctx);
   660→        const refIndex = new ReferenceIndex(tasks, items);
   661→
   662→        const result = refIndex.resolve(ref);
   663→        if (!result.ok) {
   664→          error(errors.reference.itemNotFound(ref));
   665→          process.exit(1);
   666→        }
   667→
   668→        const foundItem = result.item as LoadedSpecItem;
   669→
   670→        // Check if it's a task
   671→        if ('status' in foundItem && typeof foundItem.status === 'string') {
   672→          error(errors.reference.notItem(ref));
   673→          process.exit(1);
   674→        }
   675→
   676→        // Build alignment index
   677→        const alignmentIndex = new AlignmentIndex(tasks, items);
   678→        alignmentIndex.buildLinks(refIndex);
   679→
   680→        const summary = alignmentIndex.getImplementationSummary(foundItem._ulid);
   681→
   682→        if (!summary) {
   683→          error(errors.project.couldNotGetImplSummary);
   684→          process.exit(1);
   685→        }
   686→
   687→        output(summary, () => {
   688→          console.log(chalk.bold(foundItem.title));
   689→          console.log(chalk.gray('─'.repeat(40)));
   690→
   691→          // Status
   692→          const currentColor = summary.currentStatus === 'implemented' ? chalk.green
   693→            : summary.currentStatus === 'in_progress' ? chalk.yellow
   694→              : chalk.gray;
   695→          const expectedColor = summary.expectedStatus === 'implemented' ? chalk.green
   696→            : summary.expectedStatus === 'in_progress' ? chalk.yellow
   697→              : chalk.gray;
   698→
   699→          console.log(`Current status:  ${currentColor(summary.currentStatus)}`);
   700→          console.log(`Expected status: ${expectedColor(summary.expectedStatus)}`);
   701→
   702→          if (!summary.isAligned) {
   703→            console.log(chalk.yellow('\n⚠ Status mismatch - run task complete to sync'));
   704→          } else {
   705→            console.log(chalk.green('\n✓ Aligned'));
   706→          }
   707→
   708→          // Linked tasks
   709→          console.log(chalk.bold('\nLinked Tasks:'));
   710→          if (summary.linkedTasks.length === 0) {
   711→            console.log(chalk.gray('  No tasks reference this spec item'));
   712→          } else {
   713→            for (const task of summary.linkedTasks) {
   714→              const statusColor = task.taskStatus === 'completed' ? chalk.green
   715→                : task.taskStatus === 'in_progress' ? chalk.blue
   716→                  : chalk.gray;
   717→              const shortId = task.taskUlid.slice(0, 8);
   718→              const notes = task.hasNotes ? chalk.gray(' (has notes)') : '';
   719→              console.log(`  ${statusColor(`[${task.taskStatus}]`)} ${shortId} ${task.taskTitle}${notes}`);
   720→            }
   721→          }
   722→        });
   723→      } catch (err) {
   724→        error(errors.failures.getItemStatus, err);
   725→        process.exit(1);
   726→      }
   727→    });
   728→
   729→  // Create subcommand group for acceptance criteria operations
   730→  const acCmd = item
   731→    .command('ac')
   732→    .description('Manage acceptance criteria on spec items');
   733→
   734→  // Helper: Generate next AC ID based on existing AC
   735→  function generateNextAcId(existingAc: AcceptanceCriterion[] | undefined): string {
   736→    if (!existingAc || existingAc.length === 0) return 'ac-1';
   737→
   738→    const numericIds = existingAc
   739→      .map(ac => ac.id.match(/^ac-(\d+)$/)?.[1])
   740→      .filter((id): id is string => id !== null && id !== undefined)
   741→      .map(Number);
   742→
   743→    const maxId = numericIds.length > 0 ? Math.max(...numericIds) : 0;
   744→    return `ac-${maxId + 1}`;
   745→  }
   746→
   747→  // Helper: Resolve ref to spec item (not task)
   748→  async function resolveSpecItem(ref: string): Promise<{ ctx: Awaited<ReturnType<typeof initContext>>; item: LoadedSpecItem; refIndex: ReferenceIndex }> {
   749→    const ctx = await initContext();
   750→    const { refIndex, items } = await buildIndexes(ctx);
   751→
   752→    const result = refIndex.resolve(ref);
   753→    if (!result.ok) {
   754→      error(errors.reference.itemNotFound(ref));
   755→      process.exit(3);
   756→    }
   757→
   758→    const foundItem = result.item as LoadedSpecItem;
   759→
   760→    // Check if it's a task
   761→    if ('status' in foundItem && typeof foundItem.status === 'string') {
   762→      error(errors.operation.tasksNoAcceptanceCriteria(ref));
   763→      process.exit(3);
   764→    }
   765→
   766→    return { ctx, item: foundItem, refIndex };
   767→  }
   768→
   769→  // kspec item ac list <ref>
   770→  acCmd
   771→    .command('list <ref>')
   772→    .description('List acceptance criteria for a spec item')
   773→    .action(async (ref: string) => {
   774→      try {
   775→        const { item, refIndex } = await resolveSpecItem(ref);
   776→        const ac = item.acceptance_criteria || [];
   777→
   778→        output(ac, () => {
   779→          console.log(chalk.bold(`Acceptance Criteria for: ${item.title} (@${item.slugs[0] || refIndex.shortUlid(item._ulid)})`));
   780→          console.log();
   781→
   782→          if (ac.length === 0) {
   783→            console.log(chalk.gray('No acceptance criteria'));
   784→          } else {
   785→            for (const criterion of ac) {
   786→              console.log(chalk.cyan(`  [${criterion.id}]`));
   787→              console.log(chalk.gray(`    Given: ${criterion.given}`));
   788→              console.log(chalk.gray(`    When:  ${criterion.when}`));
   789→              console.log(chalk.gray(`    Then:  ${criterion.then}`));
   790→              console.log();
   791→            }
   792→          }
   793→
   794→          console.log(chalk.gray(`${ac.length} acceptance criteria`));
   795→        });
   796→      } catch (err) {
   797→        error(errors.failures.listAc, err);
   798→        process.exit(1);
   799→      }
   800→    });
   801→
   802→  // kspec item ac add <ref>
   803→  acCmd
   804→    .command('add <ref>')
   805→    .description('Add an acceptance criterion to a spec item')
   806→    .option('--id <id>', 'AC identifier (auto-generated if not provided)')
   807→    .requiredOption('--given <text>', 'The precondition (Given...)')
   808→    .requiredOption('--when <text>', 'The action/trigger (When...)')
   809→    .requiredOption('--then <text>', 'The expected outcome (Then...)')
   810→    .action(async (ref: string, options) => {
   811→      try {
   812→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
   813→        const existingAc = item.acceptance_criteria || [];
   814→
   815→        // Determine ID
   816→        const acId = options.id || generateNextAcId(existingAc);
   817→
   818→        // Check for duplicate ID
   819→        if (existingAc.some(ac => ac.id === acId)) {
   820→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
   821→          error(errors.conflict.acAlreadyExists(acId, itemRef));
   822→          process.exit(3);
   823→        }
   824→
   825→        // Create new AC
   826→        const newAc: AcceptanceCriterion = {
   827→          id: acId,
   828→          given: options.given,
   829→          when: options.when,
   830→          then: options.then,
   831→        };
   832→
   833→        // Update item with new AC
   834→        const updatedAc = [...existingAc, newAc];
   835→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
   836→
   837→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
   838→        await commitIfShadow(ctx.shadow, 'item-ac-add', itemSlug);
   839→        success(`Added acceptance criterion: ${acId} to @${itemSlug}`, { ac: newAc });
   840→      } catch (err) {
   841→        error(errors.failures.addAc, err);
   842→        process.exit(1);
   843→      }
   844→    });
   845→
   846→  // kspec item ac set <ref> <ac-id>
   847→  acCmd
   848→    .command('set <ref> <acId>')
   849→    .description('Update an acceptance criterion')
   850→    .option('--id <newId>', 'Rename the AC ID')
   851→    .option('--given <text>', 'Update the precondition')
   852→    .option('--when <text>', 'Update the action/trigger')
   853→    .option('--then <text>', 'Update the expected outcome')
   854→    .action(async (ref: string, acId: string, options) => {
   855→      try {
   856→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
   857→        const existingAc = item.acceptance_criteria || [];
   858→
   859→        // Find the AC
   860→        const acIndex = existingAc.findIndex(ac => ac.id === acId);
   861→        if (acIndex === -1) {
   862→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
   863→          error(errors.reference.acNotFound(acId, itemRef));
   864→          process.exit(3);
   865→        }
   866→
   867→        // Check for no updates
   868→        if (!options.id && !options.given && !options.when && !options.then) {
   869→          warn('No updates specified');
   870→          return;
   871→        }
   872→
   873→        // Check for duplicate ID if renaming
   874→        if (options.id && options.id !== acId && existingAc.some(ac => ac.id === options.id)) {
   875→          error(errors.conflict.acIdAlreadyExists(options.id));
   876→          process.exit(3);
   877→        }
   878→
   879→        // Build updated AC
   880→        const updatedAc = [...existingAc];
   881→        const updatedFields: string[] = [];
   882→
   883→        updatedAc[acIndex] = {
   884→          ...updatedAc[acIndex],
   885→          ...(options.id && { id: options.id }),
   886→          ...(options.given && { given: options.given }),
   887→          ...(options.when && { when: options.when }),
   888→          ...(options.then && { then: options.then }),
   889→        };
   890→
   891→        if (options.id) updatedFields.push('id');
   892→        if (options.given) updatedFields.push('given');
   893→        if (options.when) updatedFields.push('when');
   894→        if (options.then) updatedFields.push('then');
   895→
   896→        // Update item
   897→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
   898→
   899→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
   900→        await commitIfShadow(ctx.shadow, 'item-ac-set', itemSlug);
   901→        success(`Updated acceptance criterion: ${acId} on @${itemSlug} (${updatedFields.join(', ')})`, { ac: updatedAc[acIndex] });
   902→      } catch (err) {
   903→        error(errors.failures.updateAc, err);
   904→        process.exit(1);
   905→      }
   906→    });
   907→
   908→  // kspec item ac remove <ref> <ac-id>
   909→  acCmd
   910→    .command('remove <ref> <acId>')
   911→    .description('Remove an acceptance criterion')
   912→    .option('--force', 'Skip confirmation')
   913→    .action(async (ref: string, acId: string, options) => {
   914→      try {
   915→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
   916→        const existingAc = item.acceptance_criteria || [];
   917→
   918→        // Find the AC
   919→        const acIndex = existingAc.findIndex(ac => ac.id === acId);
   920→        if (acIndex === -1) {
   921→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
   922→          error(errors.reference.acNotFound(acId, itemRef));
   923→          process.exit(3);
   924→        }
   925→
   926→        // TODO: Add confirmation prompt when !options.force
   927→        // For now, proceed with deletion
   928→
   929→        // Remove the AC
   930→        const updatedAc = existingAc.filter(ac => ac.id !== acId);
   931→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
   932→
   933→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
   934→        await commitIfShadow(ctx.shadow, 'item-ac-remove', itemSlug);
   935→        success(`Removed acceptance criterion: ${acId} from @${itemSlug}`, { removed: acId });
   936→      } catch (err) {
   937→        error(errors.failures.removeAc, err);
   938→        process.exit(1);
   939→      }
   940→    });
   941→}
   942→
   943→// ─── Patch Helpers ───────────────────────────────────────────────────────────
   944→
   945→/**
   946→ * Read stdin fully with timeout (for bulk input).
   947→ * Returns null if stdin is a TTY or empty.
   948→ */
   949→async function readStdinFully(): Promise<string | null> {
   950→  if (process.stdin.isTTY) {
   951→    return null;
   952→  }
   953→
   954→  return new Promise((resolve) => {
   955→    let data = '';
   956→    const timeout = setTimeout(() => {
   957→      process.stdin.removeAllListeners();
   958→      resolve(data || null);
   959→    }, 5000); // 5 second timeout for bulk input
   960→
   961→    process.stdin.setEncoding('utf8');
   962→    process.stdin.on('data', (chunk) => {
   963→      data += chunk;
   964→    });
   965→    process.stdin.on('end', () => {
   966→      clearTimeout(timeout);
   967→      resolve(data || null);
   968→    });
   969→    process.stdin.on('error', () => {
   970→      clearTimeout(timeout);
   971→      resolve(null);
   972→    });
   973→    process.stdin.resume();
   974→  });
   975→}
   976→
   977→/**
   978→ * Read stdin if available (non-blocking for single item mode).
   979→ * Returns null quickly if no data available.
   980→ */
   981→async function readStdinIfAvailable(): Promise<string | null> {
   982→  if (process.stdin.isTTY) {
   983→    return null;
   984→  }
   985→
   986→  return new Promise((resolve) => {
   987→    let data = '';
   988→    const timeout = setTimeout(() => {
   989→      process.stdin.removeAllListeners();
   990→      resolve(data || null);
   991→    }, 100); // 100ms timeout for quick check
   992→
   993→    process.stdin.setEncoding('utf8');
   994→    process.stdin.on('data', (chunk) => {
   995→      data += chunk;
   996→    });
   997→    process.stdin.on('end', () => {
   998→      clearTimeout(timeout);
   999→      resolve(data || null);
  1000→    });
  1001→    process.stdin.on('error', () => {
  1002→      clearTimeout(timeout);
  1003→      resolve(null);
  1004→    });
  1005→    process.stdin.resume();
  1006→  });
  1007→}
  1008→
  1009→/**
  1010→ * Parse bulk input (JSONL or JSON array)
  1011→ */
  1012→function parseBulkInput(input: string): PatchOperation[] {
  1013→  const trimmed = input.trim();
  1014→
  1015→  // Try JSON array first
  1016→  if (trimmed.startsWith('[')) {
  1017→    const parsed = JSON.parse(trimmed);
  1018→    if (!Array.isArray(parsed)) {
  1019→      throw new Error('Expected JSON array');
  1020→    }
  1021→    return parsed.map((item, i) => validatePatchOperation(item, i));
  1022→  }
  1023→
  1024→  // Parse as JSONL (one JSON object per line)
  1025→  const lines = trimmed.split('\n').filter(line => line.trim());
  1026→  return lines.map((line, i) => {
  1027→    try {
  1028→      return validatePatchOperation(JSON.parse(line), i);
  1029→    } catch (err) {
  1030→      throw new Error(`Line ${i + 1}: ${err instanceof Error ? err.message : 'Invalid JSON'}`);
  1031→    }
  1032→  });
  1033→}
  1034→
  1035→/**
  1036→ * Validate a patch operation object
  1037→ */
  1038→function validatePatchOperation(obj: unknown, index: number): PatchOperation {
  1039→  if (!obj || typeof obj !== 'object') {
  1040→    throw new Error(`Item ${index + 1}: Patch must be an object`);
  1041→  }
  1042→  const op = obj as Record<string, unknown>;
  1043→  if (typeof op.ref !== 'string' || !op.ref) {
  1044→    throw new Error(`Item ${index + 1}: Patch must have "ref" string`);
  1045→  }
  1046→  if (!op.data || typeof op.data !== 'object') {
  1047→    throw new Error(`Item ${index + 1}: Patch must have "data" object`);
  1048→  }
  1049→  return { ref: op.ref, data: op.data as Record<string, unknown> };
  1050→}
  1051→
  1052→/**
  1053→ * Format bulk patch result for human output
  1054→ */
  1055→function formatBulkPatchResult(result: BulkPatchResult, isDryRun = false): void {
  1056→  const prefix = isDryRun ? 'Would patch' : 'Patched';
  1057→
  1058→  for (const r of result.results) {
  1059→    if (r.status === 'updated') {
  1060→      console.log(chalk.green('OK'), `${prefix}: ${r.ref} (${r.ulid?.slice(0, 8)})`);
  1061→    } else if (r.status === 'error') {
  1062→      console.log(chalk.red('ERR'), `${r.ref}: ${r.error}`);
  1063→    } else {
  1064→      console.log(chalk.gray('SKIP'), r.ref);
  1065→    }
  1066→  }
  1067→
  1068→  console.log('');
  1069→  console.log(chalk.bold('Summary:'));
  1070→  console.log(`  Total: ${result.summary.total}`);
  1071→  console.log(chalk.green(`  Updated: ${result.summary.updated}`));
  1072→  if (result.summary.failed > 0) {
  1073→    console.log(chalk.red(`  Failed: ${result.summary.failed}`));
  1074→  }
  1075→  if (result.summary.skipped > 0) {
  1076→    console.log(chalk.gray(`  Skipped: ${result.summary.skipped}`));
  1077→  }
  1078→}
  1079→

