```
     1→/**
     2→ * Session management commands
     3→ *
     4→ * Provides context for starting/resuming work sessions.
     5→ */
     6→
     7→import { Command } from 'commander';
     8→import chalk from 'chalk';
     9→import {
    10→  initContext,
    11→  loadAllTasks,
    12→  loadAllItems,
    13→  loadInboxItems,
    14→  loadMetaContext,
    15→  getReadyTasks,
    16→  ReferenceIndex,
    17→  type LoadedTask,
    18→  type LoadedInboxItem,
    19→  type KspecContext,
    20→} from '../../parser/index.js';
    21→import { output, error, info, isJsonMode } from '../output.js';
    22→import { sessionHeaders, hints, sessionPrompt, errors } from '../../strings/index.js';
    23→import {
    24→  parseTimeSpec,
    25→  formatRelativeTime,
    26→  isGitRepo,
    27→  getRecentCommits,
    28→  getCurrentBranch,
    29→  getWorkingTreeStatus,
    30→  formatCommitGuidance,
    31→  type GitCommit,
    32→  type GitWorkingTree,
    33→} from '../../utils/index.js';
    34→import { shadowPull, type ShadowSyncResult } from '../../parser/shadow.js';
    35→import type { Note, Todo } from '../../schema/index.js';
    36→
    37→// ─── Types ───────────────────────────────────────────────────────────────────
    38→
    39→export interface CheckpointResult {
    40→  /** Whether session can end cleanly */
    41→  ok: boolean;
    42→
    43→  /** Human-readable message for Claude Code */
    44→  message: string;
    45→
    46→  /** Issues that need attention before stopping */
    47→  issues: CheckpointIssue[];
    48→
    49→  /** Instructions for the agent */
    50→  instructions: string[];
    51→}
    52→
    53→export interface CheckpointIssue {
    54→  type: 'uncommitted_changes' | 'in_progress_task' | 'incomplete_todo';
    55→  description: string;
    56→  details?: Record<string, unknown>;
    57→}
    58→
    59→export interface SessionContext {
    60→  /** When this context was generated */
    61→  generated_at: string;
    62→
    63→  /** Current git branch */
    64→  branch: string | null;
    65→
    66→  /** Tasks currently in progress */
    67→  active_tasks: ActiveTaskSummary[];
    68→
    69→  /** Recent notes from active tasks */
    70→  recent_notes: NoteSummary[];
    71→
    72→  /** Incomplete todos from active tasks */
    73→  active_todos: TodoSummary[];
    74→
    75→  /** Tasks ready to be picked up */
    76→  ready_tasks: ReadyTaskSummary[];
    77→
    78→  /** Blocked tasks with blockers */
    79→  blocked_tasks: BlockedTaskSummary[];
    80→
    81→  /** Recently completed tasks */
    82→  recently_completed: CompletedTaskSummary[];
    83→
    84→  /** Recent git commits */
    85→  recent_commits: CommitSummary[];
    86→
    87→  /** Working tree status */
    88→  working_tree: GitWorkingTree | null;
    89→
    90→  /** Inbox items awaiting triage (oldest first) */
    91→  inbox_items: InboxSummary[];
    92→
    93→  /** Summary statistics */
    94→  stats: SessionStats;
    95→}
    96→
    97→export interface ActiveTaskSummary {
    98→  ref: string;
    99→  title: string;
   100→  started_at: string | null;
   101→  priority: number;
   102→  spec_ref: string | null;
   103→  note_count: number;
   104→  last_note_at: string | null;
   105→  todo_count: number;
   106→  incomplete_todos: number;
   107→}
   108→
   109→export interface NoteSummary {
   110→  task_ref: string;
   111→  task_title: string;
   112→  note_ulid: string;
   113→  created_at: string;
   114→  author: string | null;
   115→  content: string;
   116→}
   117→
   118→export interface TodoSummary {
   119→  task_ref: string;
   120→  task_title: string;
   121→  id: number;
   122→  text: string;
   123→  added_at: string;
   124→  added_by: string | null;
   125→}
   126→
   127→export interface ReadyTaskSummary {
   128→  ref: string;
   129→  title: string;
   130→  priority: number;
   131→  spec_ref: string | null;
   132→  tags: string[];
   133→}
   134→
   135→export interface BlockedTaskSummary {
   136→  ref: string;
   137→  title: string;
   138→  blocked_by: string[];
   139→  unmet_deps: string[];
   140→}
   141→
   142→export interface CompletedTaskSummary {
   143→  ref: string;
   144→  title: string;
   145→  completed_at: string;
   146→  closed_reason: string | null;
   147→  origin?: 'manual' | 'derived' | 'observation_promotion';
   148→}
   149→
   150→export interface CommitSummary {
   151→  hash: string;
   152→  full_hash: string;
   153→  date: string;
   154→  message: string;
   155→  author: string;
   156→}
   157→
   158→export interface SessionStats {
   159→  total_tasks: number;
   160→  in_progress: number;
   161→  ready: number;
   162→  blocked: number;
   163→  completed: number;
   164→  inbox_items: number;
   165→}
   166→
   167→export interface InboxSummary {
   168→  ref: string;
   169→  text: string;
   170→  created_at: string;
   171→  tags: string[];
   172→  added_by: string | null;
   173→}
   174→
   175→export interface SessionOptions {
   176→  brief?: boolean;
   177→  full?: boolean;
   178→  since?: string;
   179→  git?: boolean;
   180→  limit?: string;
   181→}
   182→
   183→// ─── Data Gathering ──────────────────────────────────────────────────────────
   184→
   185→function toActiveTaskSummary(
   186→  task: LoadedTask,
   187→  index: ReferenceIndex
   188→): ActiveTaskSummary {
   189→  const lastNote =
   190→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   191→  const incompleteTodos = task.todos.filter(t => !t.done).length;
   192→  return {
   193→    ref: index.shortUlid(task._ulid),
   194→    title: task.title,
   195→    started_at: task.started_at || null,
   196→    priority: task.priority,
   197→    spec_ref: task.spec_ref || null,
   198→    note_count: task.notes.length,
   199→    last_note_at: lastNote ? lastNote.created_at : null,
   200→    todo_count: task.todos.length,
   201→    incomplete_todos: incompleteTodos,
   202→  };
   203→}
   204→
   205→function toReadyTaskSummary(
   206→  task: LoadedTask,
   207→  index: ReferenceIndex
   208→): ReadyTaskSummary {
   209→  return {
   210→    ref: index.shortUlid(task._ulid),
   211→    title: task.title,
   212→    priority: task.priority,
   213→    spec_ref: task.spec_ref || null,
   214→    tags: task.tags,
   215→  };
   216→}
   217→
   218→function toBlockedTaskSummary(
   219→  task: LoadedTask,
   220→  allTasks: LoadedTask[],
   221→  index: ReferenceIndex
   222→): BlockedTaskSummary {
   223→  // Find unmet dependencies
   224→  const unmetDeps: string[] = [];
   225→  for (const depRef of task.depends_on) {
   226→    const result = index.resolve(depRef);
   227→    if (result.ok) {
   228→      const depItem = result.item;
   229→      if ('status' in depItem && depItem.status !== 'completed') {
   230→        unmetDeps.push(depRef);
   231→      }
   232→    }
   233→  }
   234→
   235→  return {
   236→    ref: index.shortUlid(task._ulid),
   237→    title: task.title,
   238→    blocked_by: task.blocked_by,
   239→    unmet_deps: unmetDeps,
   240→  };
   241→}
   242→
   243→function toCompletedTaskSummary(
   244→  task: LoadedTask,
   245→  index: ReferenceIndex
   246→): CompletedTaskSummary {
   247→  return {
   248→    ref: index.shortUlid(task._ulid),
   249→    title: task.title,
   250→    completed_at: task.completed_at || '',
   251→    closed_reason: task.closed_reason || null,
   252→    origin: task.origin,
   253→  };
   254→}
   255→
   256→function collectRecentNotes(
   257→  tasks: LoadedTask[],
   258→  index: ReferenceIndex,
   259→  options: { limit: number; since: Date | null }
   260→): NoteSummary[] {
   261→  const allNotes: NoteSummary[] = [];
   262→
   263→  for (const task of tasks) {
   264→    for (const note of task.notes) {
   265→      const noteDate = new Date(note.created_at);
   266→
   267→      // Filter by since date if provided
   268→      if (options.since && noteDate < options.since) {
   269→        continue;
   270→      }
   271→
   272→      allNotes.push({
   273→        task_ref: index.shortUlid(task._ulid),
   274→        task_title: task.title,
   275→        note_ulid: note._ulid.slice(0, 8),
   276→        created_at: note.created_at,
   277→        author: note.author || null,
   278→        content: note.content,
   279→      });
   280→    }
   281→  }
   282→
   283→  // Sort by date descending, take limit
   284→  return allNotes
   285→    .sort(
   286→      (a, b) =>
   287→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
   288→    )
   289→    .slice(0, options.limit);
   290→}
   291→
   292→function collectIncompleteTodos(
   293→  tasks: LoadedTask[],
   294→  index: ReferenceIndex,
   295→  options: { limit: number }
   296→): TodoSummary[] {
   297→  const allTodos: TodoSummary[] = [];
   298→
   299→  for (const task of tasks) {
   300→    for (const todo of task.todos) {
   301→      // Only include incomplete todos
   302→      if (todo.done) continue;
   303→
   304→      allTodos.push({
   305→        task_ref: index.shortUlid(task._ulid),
   306→        task_title: task.title,
   307→        id: todo.id,
   308→        text: todo.text,
   309→        added_at: todo.added_at,
   310→        added_by: todo.added_by || null,
   311→      });
   312→    }
   313→  }
   314→
   315→  // Sort by added_at descending (most recent first), take limit
   316→  return allTodos
   317→    .sort(
   318→      (a, b) =>
   319→        new Date(b.added_at).getTime() - new Date(a.added_at).getTime()
   320→    )
   321→    .slice(0, options.limit);
   322→}
   323→
   324→/**
   325→ * Gather session context data
   326→ */
   327→export async function gatherSessionContext(
   328→  ctx: KspecContext,
   329→  options: SessionOptions
   330→): Promise<SessionContext> {
   331→  const limit = parseInt(options.limit || '10', 10);
   332→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   333→  const showGit = options.git !== false; // default true
   334→
   335→  // Load all data
   336→  const allTasks = await loadAllTasks(ctx);
   337→  const items = await loadAllItems(ctx);
   338→  const inboxItems = await loadInboxItems(ctx);
   339→  const index = new ReferenceIndex(allTasks, items);
   340→
   341→  // Compute stats
   342→  const stats: SessionStats = {
   343→    total_tasks: allTasks.length,
   344→    in_progress: allTasks.filter((t) => t.status === 'in_progress').length,
   345→    ready: getReadyTasks(allTasks).length,
   346→    blocked: allTasks.filter((t) => t.status === 'blocked').length,
   347→    completed: allTasks.filter((t) => t.status === 'completed').length,
   348→    inbox_items: inboxItems.length,
   349→  };
   350→
   351→  // Get active tasks
   352→  const activeTasks = allTasks
   353→    .filter((t) => t.status === 'in_progress')
   354→    .sort((a, b) => a.priority - b.priority)
   355→    .slice(0, options.full ? undefined : limit)
   356→    .map((t) => toActiveTaskSummary(t, index));
   357→
   358→  // Get recent notes from active tasks
   359→  const recentNotes = collectRecentNotes(
   360→    allTasks.filter((t) => t.status === 'in_progress'),
   361→    index,
   362→    { limit: options.full ? limit * 2 : limit, since: sinceDate }
   363→  );
   364→
   365→  // Get incomplete todos from active tasks
   366→  const activeTodos = collectIncompleteTodos(
   367→    allTasks.filter((t) => t.status === 'in_progress'),
   368→    index,
   369→    { limit: options.full ? limit * 2 : limit }
   370→  );
   371→
   372→  // Get ready tasks
   373→  const readyTasks = getReadyTasks(allTasks)
   374→    .slice(0, options.full ? undefined : limit)
   375→    .map((t) => toReadyTaskSummary(t, index));
   376→
   377→  // Get blocked tasks
   378→  const blockedTasks = allTasks
   379→    .filter((t) => t.status === 'blocked')
   380→    .slice(0, options.full ? undefined : limit)
   381→    .map((t) => toBlockedTaskSummary(t, allTasks, index));
   382→
   383→  // Get recently completed tasks
   384→  const recentlyCompleted = allTasks
   385→    .filter((t) => {
   386→      if (t.status !== 'completed' || !t.completed_at) return false;
   387→      const completedDate = new Date(t.completed_at);
   388→      if (sinceDate && completedDate < sinceDate) return false;
   389→      return true;
   390→    })
   391→    .sort((a, b) => {
   392→      // Sort by completed_at descending (most recent first)
   393→      const aDate = new Date(a.completed_at || 0);
   394→      const bDate = new Date(b.completed_at || 0);
   395→      return bDate.getTime() - aDate.getTime();
   396→    })
   397→    .slice(0, options.full ? undefined : limit)
   398→    .map((t) => toCompletedTaskSummary(t, index));
   399→
   400→  // Get git info
   401→  let branch: string | null = null;
   402→  let recentCommits: CommitSummary[] = [];
   403→  let workingTree: GitWorkingTree | null = null;
   404→
   405→  if (showGit && isGitRepo(ctx.rootDir)) {
   406→    branch = getCurrentBranch(ctx.rootDir);
   407→
   408→    const commits = getRecentCommits({
   409→      limit: options.full ? limit * 2 : limit,
   410→      since: sinceDate || undefined,
   411→      cwd: ctx.rootDir,
   412→    });
   413→
   414→    recentCommits = commits.map((c) => ({
   415→      hash: c.hash,
   416→      full_hash: c.fullHash,
   417→      date: c.date.toISOString(),
   418→      message: c.message,
   419→      author: c.author,
   420→    }));
   421→
   422→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   423→  }
   424→
   425→  // Get inbox items (oldest first to encourage triage)
   426→  const inboxSummaries: InboxSummary[] = inboxItems
   427→    .sort((a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime())
   428→    .slice(0, options.full ? undefined : limit)
   429→    .map((item) => ({
   430→      ref: item._ulid.slice(0, 8),
   431→      text: item.text,
   432→      created_at: item.created_at,
   433→      tags: item.tags,
   434→      added_by: item.added_by || null,
   435→    }));
   436→
   437→  return {
   438→    generated_at: new Date().toISOString(),
   439→    branch,
   440→    active_tasks: activeTasks,
   441→    recent_notes: recentNotes,
   442→    active_todos: activeTodos,
   443→    ready_tasks: readyTasks,
   444→    blocked_tasks: blockedTasks,
   445→    recently_completed: recentlyCompleted,
   446→    recent_commits: recentCommits,
   447→    working_tree: workingTree,
   448→    inbox_items: inboxSummaries,
   449→    stats,
   450→  };
   451→}
   452→
   453→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   454→
   455→export interface CheckpointOptions {
   456→  force?: boolean;
   457→  /** Set when stop hook is already active (retry after previous block) */
   458→  stopHookActive?: boolean;
   459→}
   460→
   461→/** Claude Code hook input for Stop hooks */
   462→export interface StopHookInput {
   463→  session_id?: string;
   464→  transcript_path?: string;
   465→  hook_event_name?: string;
   466→  stop_hook_active?: boolean;
   467→}
   468→
   469→/**
   470→ * Perform session checkpoint - check for uncommitted work before ending session.
   471→ *
   472→ * This is designed for use as a Claude Code stop hook. It checks for:
   473→ * - Uncommitted git changes (staged, unstaged, untracked)
   474→ * - Tasks in in_progress status
   475→ * - Incomplete todos on active tasks
   476→ *
   477→ * Returns a structured result indicating whether the session can end cleanly.
   478→ */
   479→export async function performCheckpoint(
   480→  ctx: KspecContext,
   481→  options: CheckpointOptions
   482→): Promise<CheckpointResult> {
   483→  const issues: CheckpointIssue[] = [];
   484→  const instructions: string[] = [];
   485→
   486→  // Load tasks
   487→  const allTasks = await loadAllTasks(ctx);
   488→
   489→  // Check for in-progress tasks
   490→  const inProgressTasks = allTasks.filter((t) => t.status === 'in_progress');
   491→  for (const task of inProgressTasks) {
   492→    const ref = task.slugs[0] ? `@${task.slugs[0]}` : `@${task._ulid.slice(0, 8)}`;
   493→    issues.push({
   494→      type: 'in_progress_task',
   495→      description: `Task ${ref} is still in progress: ${task.title}`,
   496→      details: {
   497→        ref,
   498→        title: task.title,
   499→        started_at: task.started_at,
   500→      },
   501→    });
   502→
   503→    // Check for incomplete todos on this task
   504→    const incompleteTodos = task.todos.filter((t) => !t.done);
   505→    for (const todo of incompleteTodos) {
   506→      issues.push({
   507→        type: 'incomplete_todo',
   508→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   509→        details: {
   510→          task_ref: ref,
   511→          todo_id: todo.id,
   512→          text: todo.text,
   513→        },
   514→      });
   515→    }
   516→  }
   517→
   518→  // Check for uncommitted git changes
   519→  if (isGitRepo(ctx.rootDir)) {
   520→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   521→    if (!workingTree.clean) {
   522→      const changeCount =
   523→        workingTree.staged.length +
   524→        workingTree.unstaged.length +
   525→        workingTree.untracked.length;
   526→
   527→      issues.push({
   528→        type: 'uncommitted_changes',
   529→        description: `${changeCount} uncommitted changes in working tree`,
   530→        details: {
   531→          staged: workingTree.staged.length,
   532→          unstaged: workingTree.unstaged.length,
   533→          untracked: workingTree.untracked.length,
   534→        },
   535→      });
   536→    }
   537→  }
   538→
   539→  // Build instructions based on issues
   540→  if (issues.length > 0 && !options.force) {
   541→    instructions.push('Before ending this session, please:');
   542→
   543→    const hasInProgress = issues.some((i) => i.type === 'in_progress_task');
   544→    const hasUncommitted = issues.some((i) => i.type === 'uncommitted_changes');
   545→    const hasIncompleteTodos = issues.some((i) => i.type === 'incomplete_todo');
   546→
   547→    let step = 1;
   548→
   549→    if (hasInProgress) {
   550→      instructions.push(
   551→        `${step++}. Add notes to in-progress tasks documenting current state`
   552→      );
   553→      instructions.push(
   554→        `${step++}. Either complete the tasks or leave them in_progress with clear notes for next session`
   555→      );
   556→    }
   557→
   558→    if (hasIncompleteTodos) {
   559→      instructions.push(
   560→        `${step++}. Complete or acknowledge incomplete todos on active tasks`
   561→      );
   562→    }
   563→
   564→    if (hasUncommitted) {
   565→      instructions.push(`${step++}. Commit your changes with a descriptive message`);
   566→
   567→      // Add WIP commit guidance if there are in-progress tasks
   568→      if (inProgressTasks.length > 0) {
   569→        const task = inProgressTasks[0];
   570→        const guidance = formatCommitGuidance(task, { wip: true });
   571→        instructions.push('');
   572→        instructions.push('Suggested WIP commit:');
   573→        instructions.push(`  ${guidance.message}`);
   574→        instructions.push('');
   575→        for (const trailer of guidance.trailers) {
   576→          instructions.push(`  ${trailer}`);
   577→        }
   578→      }
   579→    }
   580→
   581→    instructions.push('');
   582→    instructions.push(
   583→      'Use: kspec task note @task "Progress notes..." to document state'
   584→    );
   585→    instructions.push(
   586→      'Use: kspec task complete @task --reason "Summary" if task is done'
   587→    );
   588→  }
   589→
   590→  // Allow stop if:
   591→  // - No issues found
   592→  // - --force flag passed
   593→  // - This is a retry (stop_hook_active = true from previous block)
   594→  const isRetry = options.stopHookActive === true;
   595→  const ok = issues.length === 0 || options.force === true || isRetry;
   596→
   597→  let message: string;
   598→  if (isRetry && issues.length > 0) {
   599→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   600→  } else if (ok) {
   601→    message = '[kspec] Session checkpoint passed - ready to end session';
   602→  } else {
   603→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   604→  }
   605→
   606→  return {
   607→    ok,
   608→    message,
   609→    issues,
   610→    instructions,
   611→  };
   612→}
   613→
   614→// ─── Output Formatting ───────────────────────────────────────────────────────
   615→
   616→function formatCheckpointResult(result: CheckpointResult): void {
   617→  if (result.ok) {
   618→    console.log(chalk.green(result.message));
   619→  } else {
   620→    console.log(chalk.yellow(result.message));
   621→    console.log('');
   622→
   623→    for (const issue of result.issues) {
   624→      const icon =
   625→        issue.type === 'uncommitted_changes'
   626→          ? chalk.yellow('⚠')
   627→          : issue.type === 'in_progress_task'
   628→            ? chalk.blue('●')
   629→            : chalk.gray('○');
   630→      console.log(`  ${icon} ${issue.description}`);
   631→    }
   632→
   633→    if (result.instructions.length > 0) {
   634→      console.log('');
   635→      for (const instruction of result.instructions) {
   636→        console.log(chalk.gray(instruction));
   637→      }
   638→    }
   639→  }
   640→}
   641→
   642→function formatSessionContext(ctx: SessionContext, options: SessionOptions): void {
   643→  const isBrief = !options.full;
   644→
   645→  // Header
   646→  console.log(`\n${sessionHeaders.title}`);
   647→  const age = formatRelativeTime(new Date(ctx.generated_at));
   648→  if (ctx.branch) {
   649→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   650→  } else {
   651→    console.log(chalk.gray(`Generated: ${age}`));
   652→  }
   653→
   654→  // Stats summary
   655→  const inboxNote = ctx.stats.inbox_items > 0
   656→    ? ` | Inbox: ${ctx.stats.inbox_items}`
   657→    : '';
   658→  console.log(
   659→    chalk.gray(
   660→      `Tasks: ${ctx.stats.in_progress} active, ${ctx.stats.ready} ready, ` +
   661→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`
   662→    )
   663→  );
   664→
   665→  // Active tasks section
   666→  if (ctx.active_tasks.length > 0) {
   667→    console.log(`\n${sessionHeaders.activeWork}`);
   668→    for (const task of ctx.active_tasks) {
   669→      const started = task.started_at
   670→        ? chalk.gray(` (started ${formatRelativeTime(new Date(task.started_at))})`)
   671→        : '';
   672→      const priority =
   673→        task.priority <= 2
   674→          ? chalk.red(`P${task.priority}`)
   675→          : chalk.gray(`P${task.priority}`);
   676→      console.log(
   677→        `  ${chalk.blue('[in_progress]')} ${priority} ${task.ref} ${task.title}${started}`
   678→      );
   679→    }
   680→  } else {
   681→    console.log(`\n${sessionHeaders.noActiveWork}`);
   682→  }
   683→
   684→  // Recently completed section
   685→  if (ctx.recently_completed.length > 0) {
   686→    console.log(`\n${sessionHeaders.recentlyCompleted}`);
   687→    const observationPromotedTasks: string[] = [];
   688→    for (const task of ctx.recently_completed) {
   689→      const completedAge = formatRelativeTime(new Date(task.completed_at));
   690→      let reason = '';
   691→      if (task.closed_reason) {
   692→        const maxLen = isBrief ? 60 : 120;
   693→        const truncated = task.closed_reason.length > maxLen
   694→          ? task.closed_reason.slice(0, maxLen).trim() + '...'
   695→          : task.closed_reason;
   696→        reason = chalk.gray(` - ${truncated}`);
   697→      }
   698→      console.log(
   699→        `  ${chalk.green('[completed]')} ${task.ref} ${task.title} ${chalk.gray(`(${completedAge})`)}${reason}`
   700→      );
   701→
   702→      // Track tasks that came from observations
   703→      if (task.origin === 'observation_promotion') {
   704→        observationPromotedTasks.push(task.ref);
   705→      }
   706→    }
   707→
   708→    // Show reminder about resolving observations
   709→    if (observationPromotedTasks.length > 0) {
   710→      console.log(chalk.yellow(`\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(', ')}`));
   711→      console.log(chalk.gray(`    Run: kspec meta observations --pending-resolution`));
   712→    }
   713→  }
   714→
   715→  // Recent notes section
   716→  if (ctx.recent_notes.length > 0) {
   717→    console.log(`\n${sessionHeaders.recentNotes}`);
   718→    for (const note of ctx.recent_notes) {
   719→      const age = formatRelativeTime(new Date(note.created_at));
   720→      const author = note.author ? chalk.gray(` by ${note.author}`) : '';
   721→      console.log(`  ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
   722→
   723→      // Truncate content in brief mode
   724→      let content = note.content.trim();
   725→      if (isBrief && content.length > 200) {
   726→        content = content.slice(0, 200).trim() + '...';
   727→      }
   728→
   729→      // Indent content, limit lines in brief mode
   730→      const lines = content.split('\n');
   731→      const maxLines = isBrief ? 3 : lines.length;
   732→      for (const line of lines.slice(0, maxLines)) {
   733→        console.log(`    ${chalk.white(line)}`);
   734→      }
   735→      if (isBrief && lines.length > maxLines) {
   736→        console.log(chalk.gray(`    ... (${lines.length - maxLines} more lines)`));
   737→      }
   738→    }
   739→  }
   740→
   741→  // Incomplete todos section
   742→  if (ctx.active_todos.length > 0) {
   743→    console.log(`\n${sessionHeaders.incompleteTodos}`);
   744→    for (const todo of ctx.active_todos) {
   745→      console.log(`  ${chalk.yellow('[ ]')} ${todo.task_ref}#${todo.id}: ${todo.text}`);
   746→    }
   747→  }
   748→
   749→  // Ready tasks section
   750→  if (ctx.ready_tasks.length > 0) {
   751→    console.log(`\n${sessionHeaders.readyTasks}`);
   752→    for (const task of ctx.ready_tasks) {
   753→      const priority =
   754→        task.priority <= 2
   755→          ? chalk.red(`P${task.priority}`)
   756→          : chalk.gray(`P${task.priority}`);
   757→      const tags =
   758→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(' #')}`) : '';
   759→      console.log(`  ${priority} ${task.ref} ${task.title}${tags}`);
   760→    }
   761→  }
   762→
   763→  // Blocked tasks section
   764→  if (ctx.blocked_tasks.length > 0) {
   765→    console.log(`\n${sessionHeaders.blocked}`);
   766→    for (const task of ctx.blocked_tasks) {
   767→      console.log(`  ${chalk.red('[blocked]')} ${task.ref} ${task.title}`);
   768→      if (task.blocked_by.length > 0) {
   769→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(', ')}`));
   770→      }
   771→      if (task.unmet_deps.length > 0) {
   772→        console.log(chalk.gray(`    Waiting on: ${task.unmet_deps.join(', ')}`));
   773→      }
   774→    }
   775→  }
   776→
   777→  // Git commits section
   778→  if (ctx.recent_commits.length > 0) {
   779→    console.log(`\n${sessionHeaders.recentCommits}`);
   780→    for (const commit of ctx.recent_commits) {
   781→      const age = formatRelativeTime(new Date(commit.date));
   782→      console.log(
   783→        `  ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${age}, ${commit.author})`)}`
   784→      );
   785→    }
   786→  }
   787→
   788→  // Inbox section (oldest first to encourage triage)
   789→  if (ctx.inbox_items.length > 0) {
   790→    console.log(`\n${sessionHeaders.inbox}`);
   791→    for (const item of ctx.inbox_items) {
   792→      const age = formatRelativeTime(new Date(item.created_at));
   793→      const author = item.added_by ? ` by ${item.added_by}` : '';
   794→      const tags = item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(', ')}]`) : '';
   795→      // Truncate text in brief mode
   796→      let text = item.text;
   797→      if (isBrief && text.length > 60) {
   798→        text = text.slice(0, 60).trim() + '...';
   799→      }
   800→      console.log(`  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`);
   801→      console.log(`    ${text}`);
   802→    }
   803→    console.log(`  ${hints.inboxPromote}`);
   804→  }
   805→
   806→  // Working tree section
   807→  if (ctx.working_tree && !ctx.working_tree.clean) {
   808→    console.log(`\n${sessionHeaders.workingTree}`);
   809→
   810→    if (ctx.working_tree.staged.length > 0) {
   811→      console.log(chalk.green('  Staged:'));
   812→      for (const file of ctx.working_tree.staged) {
   813→        console.log(`    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`);
   814→      }
   815→    }
   816→
   817→    if (ctx.working_tree.unstaged.length > 0) {
   818→      console.log(chalk.red('  Modified:'));
   819→      for (const file of ctx.working_tree.unstaged) {
   820→        console.log(`    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`);
   821→      }
   822→    }
   823→
   824→    if (ctx.working_tree.untracked.length > 0) {
   825→      console.log(chalk.gray('  Untracked:'));
   826→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
   827→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
   828→        console.log(`    ${chalk.gray('?')} ${path}`);
   829→      }
   830→      if (isBrief && ctx.working_tree.untracked.length > limit) {
   831→        console.log(chalk.gray(`    ... and ${ctx.working_tree.untracked.length - limit} more`));
   832→      }
   833→    }
   834→  } else if (ctx.working_tree?.clean) {
   835→    console.log(`\n${sessionHeaders.workingTreeClean}`);
   836→  }
   837→
   838→  // Quick Commands section - contextual hints based on state
   839→  const quickCommands: string[] = [];
   840→
   841→  if (ctx.active_tasks.length > 0) {
   842→    const ref = ctx.active_tasks[0].ref;
   843→    quickCommands.push(`kspec task note @${ref} "Progress..."  ${chalk.gray('# document work')}`);
   844→    quickCommands.push(`kspec task complete @${ref} --reason "..."  ${chalk.gray('# finish task')}`);
   845→  } else if (ctx.ready_tasks.length > 0) {
   846→    const ref = ctx.ready_tasks[0].ref;
   847→    quickCommands.push(`kspec task start @${ref}  ${chalk.gray('# begin work')}`);
   848→  }
   849→
   850→  if (ctx.inbox_items.length > 0) {
   851→    const ref = ctx.inbox_items[0].ref;
   852→    quickCommands.push(`kspec inbox promote @${ref} --title "..."  ${chalk.gray('# convert to task')}`);
   853→  }
   854→
   855→  if (ctx.working_tree && !ctx.working_tree.clean) {
   856→    quickCommands.push(`git add . && git commit -m "..."  ${chalk.gray('# commit changes')}`);
   857→  }
   858→
   859→  if (quickCommands.length > 0) {
   860→    console.log(`\n${sessionHeaders.quickCommands}`);
   861→    for (const hint of quickCommands) {
   862→      console.log(`  ${hint}`);
   863→    }
   864→  }
   865→
   866→  console.log(''); // Final newline
   867→}
   868→
   869→// ─── Command Registration ────────────────────────────────────────────────────
   870→
   871→async function sessionStartAction(options: SessionOptions): Promise<void> {
   872→  try {
   873→    const ctx = await initContext();
   874→
   875→    // AC-2: Pull remote changes before showing session context
   876→    let syncResult: ShadowSyncResult | null = null;
   877→    if (ctx.shadow?.enabled) {
   878→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
   879→      // AC-3: Warn about conflicts but continue with local state
   880→      if (syncResult.hadConflict) {
   881→        console.log(
   882→          chalk.yellow('⚠ Shadow sync conflict detected. Run `kspec shadow resolve` to fix.')
   883→        );
   884→        console.log(chalk.gray('  Continuing with local state...'));
   885→        console.log('');
   886→      } else if (syncResult.pulled) {
   887→        console.log(chalk.gray('ℹ Synced shadow branch from remote'));
   888→      }
   889→    }
   890→
   891→    const sessionCtx = await gatherSessionContext(ctx, options);
   892→
   893→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
   894→  } catch (err) {
   895→    error(errors.failures.gatherSessionContext, err);
   896→    process.exit(1);
   897→  }
   898→}
   899→
   900→/**
   901→ * Read stdin if available (non-blocking check for hook input)
   902→ */
   903→async function readStdinIfAvailable(): Promise<string | null> {
   904→  // Check if stdin is a TTY (interactive) - if so, don't try to read
   905→  if (process.stdin.isTTY) {
   906→    return null;
   907→  }
   908→
   909→  return new Promise((resolve) => {
   910→    let data = '';
   911→    const timeout = setTimeout(() => {
   912→      process.stdin.removeAllListeners();
   913→      resolve(data || null);
   914→    }, 100); // 100ms timeout for stdin
   915→
   916→    process.stdin.setEncoding('utf8');
   917→    process.stdin.on('data', (chunk) => {
   918→      data += chunk;
   919→    });
   920→    process.stdin.on('end', () => {
   921→      clearTimeout(timeout);
   922→      resolve(data || null);
   923→    });
   924→    process.stdin.on('error', () => {
   925→      clearTimeout(timeout);
   926→      resolve(null);
   927→    });
   928→    process.stdin.resume();
   929→  });
   930→}
   931→
   932→/**
   933→ * Parse Claude Code hook input from stdin
   934→ */
   935→function parseHookInput(stdin: string | null): StopHookInput | null {
   936→  if (!stdin) return null;
   937→  try {
   938→    return JSON.parse(stdin.trim()) as StopHookInput;
   939→  } catch {
   940→    return null;
   941→  }
   942→}
   943→
   944→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
   945→
   946→/**
   947→ * Output spec-first reminder for UserPromptSubmit hook.
   948→ *
   949→ * This is a simple context injection - always outputs the reminder,
   950→ * and Claude (Opus) is smart enough to apply it when relevant.
   951→ */
   952→async function sessionPromptCheckAction(): Promise<void> {
   953→  // Lean, instructive reminder with kspec prefix
   954→  console.log(sessionPrompt.specCheck);
   955→}
   956→
   957→async function sessionCheckpointAction(options: CheckpointOptions): Promise<void> {
   958→  try {
   959→    // Read stdin for Claude Code hook input
   960→    const stdin = await readStdinIfAvailable();
   961→    const hookInput = parseHookInput(stdin);
   962→
   963→    // Check if this is a retry (stop hook already active)
   964→    if (hookInput?.stop_hook_active) {
   965→      options.stopHookActive = true;
   966→    }
   967→
   968→    const ctx = await initContext();
   969→    const result = await performCheckpoint(ctx, options);
   970→
   971→    // Output format depends on mode:
   972→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
   973→    // - Human mode: Output formatted checkpoint result
   974→    if (isJsonMode()) {
   975→      if (!result.ok) {
   976→        // Build reason message with issues and instructions
   977→        const issueLines = result.issues.map(i => `- ${i.description}`).join('\n');
   978→        const instructionLines = result.instructions.filter(i => i.trim()).join('\n');
   979→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
   980→        console.log(JSON.stringify({ decision: 'block', reason }));
   981→      }
   982→      // If ok, exit silently (Claude Code expects no output when allowing stop)
   983→    } else {
   984→      formatCheckpointResult(result);
   985→      if (!result.ok) {
   986→        process.exit(1);
   987→      }
   988→    }
   989→  } catch (err) {
   990→    error(errors.failures.runCheckpoint, err);
   991→    process.exit(1);
   992→  }
   993→}
   994→
   995→/**
   996→ * Register the 'session' command group and aliases
   997→ */
   998→export function registerSessionCommands(program: Command): void {
   999→  const session = program
  1000→    .command('session')
  1001→    .description('Session management and context');
  1002→
  1003→  session
  1004→    .command('start')
  1005→    .alias('resume')
  1006→    .description('Surface relevant context for starting a new working session')
  1007→    .option('--brief', 'Compact summary (default)')
  1008→    .option('--full', 'Comprehensive context dump')
  1009→    .option('--since <time>', 'Filter by recency (ISO8601 or relative: 1h, 2d, 1w)')
  1010→    .option('--no-git', 'Skip git commit information')
  1011→    .option('-n, --limit <n>', 'Limit items per section', '10')
  1012→    .action(sessionStartAction);
  1013→
  1014→  session
  1015→    .command('checkpoint')
  1016→    .description('Pre-stop hook: check for uncommitted work before ending session')
  1017→    .option('--force', 'Allow session end regardless of issues')
  1018→    .action(sessionCheckpointAction);
  1019→
  1020→  session
  1021→    .command('prompt-check')
  1022→    .description('UserPromptSubmit hook: inject spec-first reminder')
  1023→    .action(sessionPromptCheckAction);
  1024→
  1025→  // Top-level alias: kspec context
  1026→  program
  1027→    .command('context')
  1028→    .description('Alias for session start - surface session context')
  1029→    .option('--brief', 'Compact summary (default)')
  1030→    .option('--full', 'Comprehensive context dump')
  1031→    .option('--since <time>', 'Filter by recency (ISO8601 or relative: 1h, 2d, 1w)')
  1032→    .option('--no-git', 'Skip git commit information')
  1033→    .option('-n, --limit <n>', 'Limit items per section', '10')
  1034→    .action(sessionStartAction);
  1035→}
