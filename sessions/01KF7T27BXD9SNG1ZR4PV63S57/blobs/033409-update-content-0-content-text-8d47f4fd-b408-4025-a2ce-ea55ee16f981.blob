   376→// ─── Event Storage Tests ─────────────────────────────────────────────────────
   377→
   378→describe('Event storage', () => {
   379→  let testDir: string;
   380→  const sessionId = '01KF123456789ABCDEFGHJKMNP';
   381→
   382→  beforeEach(async () => {
   383→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-event-test-'));
   384→  });
   385→
   386→  afterEach(async () => {
   387→    await fs.rm(testDir, { recursive: true });
   388→  });
   389→
   390→  describe('appendEvent', () => {
   391→    // AC: @session-events ac-2
   392→    it('should append event with auto-assigned ts and seq', async () => {
   393→      const input: SessionEventInput = {
   394→        type: 'session.start',
   395→        session_id: sessionId,
   396→        data: { message: 'Starting session' },
   397→      };
   398→
   399→      const event = await appendEvent(testDir, input);
   400→
   401→      expect(event.ts).toBeDefined();
   402→      expect(event.ts).toBeGreaterThan(0);
   403→      expect(event.seq).toBe(0);
   404→      expect(event.type).toBe('session.start');
   405→      expect(event.session_id).toBe(sessionId);
   406→      expect(event.data).toEqual({ message: 'Starting session' });
   407→    });
   408→
   409→    // AC: @session-events ac-2
   410→    it('should auto-increment seq for subsequent events', async () => {
   411→      const event1 = await appendEvent(testDir, {
   412→        type: 'session.start',
   413→        session_id: sessionId,
   414→        data: null,
   415→      });
   416→
   417→      const event2 = await appendEvent(testDir, {
   418→        type: 'prompt.sent',
   419→        session_id: sessionId,
   420→        data: { prompt: 'Hello' },
   421→      });
   422→
   423→      const event3 = await appendEvent(testDir, {
   424→        type: 'tool.call',
   425→        session_id: sessionId,
   426→        data: { tool: 'Read' },
   427→      });
   428→
   429→      expect(event1.seq).toBe(0);
   430→      expect(event2.seq).toBe(1);
   431→      expect(event3.seq).toBe(2);
   432→    });
   433→
   434→    // AC: @session-events ac-3
   435→    it('should create session directory if it does not exist (lazy creation)', async () => {
   436→      const event = await appendEvent(testDir, {
   437→        type: 'session.start',
   438→        session_id: sessionId,
   439→        data: null,
   440→      });
   441→
   442→      expect(event.seq).toBe(0);
   443→
   444→      // Verify directory was created
   445→      const sessionDir = getSessionDir(testDir, sessionId);
   446→      const stat = await fs.stat(sessionDir);
   447→      expect(stat.isDirectory()).toBe(true);
   448→    });
   449→
   450→    it('should preserve optional trace_id', async () => {
   451→      const event = await appendEvent(testDir, {
   452→        type: 'session.start',
   453→        session_id: sessionId,
   454→        trace_id: 'trace-abc-123',
   455→        data: null,
   456→      });
   457→
   458→      expect(event.trace_id).toBe('trace-abc-123');
   459→    });
   460→
   461→    // AC: @session-events ac-3
   462→    it('should write event as JSON line to events.jsonl', async () => {
   463→      await appendEvent(testDir, {
   464→        type: 'session.start',
   465→        session_id: sessionId,
   466→        data: { key: 'value' },
   467→      });
   468→
   469→      await appendEvent(testDir, {
   470→        type: 'prompt.sent',
   471→        session_id: sessionId,
   472→        data: { prompt: 'test' },
   473→      });
   474→
   475→      const eventsPath = getSessionEventsPath(testDir, sessionId);
   476→      const content = await fs.readFile(eventsPath, 'utf-8');
   477→      const lines = content.trim().split('\n');
   478→
   479→      expect(lines).toHaveLength(2);
   480→
   481→      const event1 = JSON.parse(lines[0]);
   482→      expect(event1.type).toBe('session.start');
   483→      expect(event1.seq).toBe(0);
   484→
   485→      const event2 = JSON.parse(lines[1]);
   486→      expect(event2.type).toBe('prompt.sent');
   487→      expect(event2.seq).toBe(1);
   488→    });
   489→  });
   490→
   491→  describe('readEvents', () => {
   492→    // AC: @session-events ac-4
   493→    it('should read all events in sequence order', async () => {
   494→      await appendEvent(testDir, {
   495→        type: 'session.start',
   496→        session_id: sessionId,
   497→        data: null,
   498→      });
   499→
   500→      await appendEvent(testDir, {
   501→        type: 'prompt.sent',
   502→        session_id: sessionId,
   503→        data: { prompt: 'Hello' },
   504→      });
   505→
   506→      await appendEvent(testDir, {
   507→        type: 'session.end',
   508→        session_id: sessionId,
   509→        data: null,
   510→      });
   511→
   512→      const events = await readEvents(testDir, sessionId);
   513→
   514→      expect(events).toHaveLength(3);
   515→      expect(events[0].type).toBe('session.start');
   516→      expect(events[0].seq).toBe(0);
   517→      expect(events[1].type).toBe('prompt.sent');
   518→      expect(events[1].seq).toBe(1);
   519→      expect(events[2].type).toBe('session.end');
   520→      expect(events[2].seq).toBe(2);
   521→    });
   522→
   523→    it('should return empty array if no events', async () => {
   524→      const events = await readEvents(testDir, sessionId);
   525→
   526→      expect(events).toHaveLength(0);
   527→    });
   528→
   529→    it('should return empty array for nonexistent session', async () => {
   530→      const events = await readEvents(testDir, 'nonexistent');
   531→
   532→      expect(events).toHaveLength(0);
   533→    });
   534→
   535→    it('should skip invalid JSON lines', async () => {
   536→      // Create session dir and write some invalid JSON
   537→      const sessionDir = getSessionDir(testDir, sessionId);
   538→      await fs.mkdir(sessionDir, { recursive: true });
   539→
   540→      const eventsPath = getSessionEventsPath(testDir, sessionId);
   541→      const content = [
   542→        JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: sessionId, data: null }),
   543→        'invalid json line',
   544→        JSON.stringify({ ts: 2000, seq: 1, type: 'session.end', session_id: sessionId, data: null }),
   545→      ].join('\n');
   546→      await fs.writeFile(eventsPath, content + '\n', 'utf-8');
   547→
   548→      const events = await readEvents(testDir, sessionId);
   549→
   550→      expect(events).toHaveLength(2);
   551→      expect(events[0].seq).toBe(0);
   552→      expect(events[1].seq).toBe(1);
   553→    });
   554→  });
   555→
   556→  describe('readEventsSince', () => {
   557→    it('should filter events by timestamp', async () => {
   558→      // Create events with specific timestamps
   559→      await appendEvent(testDir, {
   560→        type: 'session.start',
   561→        session_id: sessionId,
   562→        ts: 1000,
   563→        data: null,
   564→      });
   565→
   566→      await appendEvent(testDir, {
   567→        type: 'prompt.sent',
   568→        session_id: sessionId,
   569→        ts: 2000,
   570→        data: null,
   571→      });
   572→
   573→      await appendEvent(testDir, {
   574→        type: 'session.end',
   575→        session_id: sessionId,
   576→        ts: 3000,
   577→        data: null,
   578→      });
   579→
   580→      const events = await readEventsSince(testDir, sessionId, 1500);
   581→
   582→      expect(events).toHaveLength(2);
   583→      expect(events[0].ts).toBe(2000);
   584→      expect(events[1].ts).toBe(3000);
   585→    });
   586→
   587→    it('should filter events by time range', async () => {
   588→      await appendEvent(testDir, {
   589→        type: 'session.start',
   590→        session_id: sessionId,
   591→        ts: 1000,
   592→        data: null,
   593→      });
   594→
   595→      await appendEvent(testDir, {
   596→        type: 'prompt.sent',
   597→        session_id: sessionId,
   598→        ts: 2000,
   599→        data: null,
   600→      });
   601→
   602→      await appendEvent(testDir, {
   603→        type: 'session.end',
   604→        session_id: sessionId,
   605→        ts: 3000,
   606→        data: null,
   607→      });
   608→
   609→      const events = await readEventsSince(testDir, sessionId, 1500, 2500);
   610→
   611→      expect(events).toHaveLength(1);
   612→      expect(events[0].ts).toBe(2000);
   613→    });
   614→  });
   615→
   616→  describe('getLastEvent', () => {
   617→    it('should return the last event', async () => {
   618→      await appendEvent(testDir, {
