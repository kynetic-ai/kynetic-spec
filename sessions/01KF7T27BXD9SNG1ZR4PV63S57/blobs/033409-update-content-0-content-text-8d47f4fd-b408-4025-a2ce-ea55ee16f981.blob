   201→// ─── Storage Tests ───────────────────────────────────────────────────────────
   202→
   203→describe('Session storage', () => {
   204→  let testDir: string;
   205→
   206→  beforeEach(async () => {
   207→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-test-'));
   208→  });
   209→
   210→  afterEach(async () => {
   211→    await fs.rm(testDir, { recursive: true });
   212→  });
   213→
   214→  describe('createSession', () => {
   215→    // AC: @session-events ac-1
   216→    it('should create session directory and metadata file', async () => {
   217→      const input: SessionMetadataInput = {
   218→        id: '01KF123456789ABCDEFGHJKMNP',
   219→        agent_type: 'claude-code',
   220→      };
   221→
   222→      const metadata = await createSession(testDir, input);
   223→
   224→      // Check metadata returned
   225→      expect(metadata.id).toBe(input.id);
   226→      expect(metadata.agent_type).toBe(input.agent_type);
   227→      expect(metadata.status).toBe('active');
   228→      expect(metadata.started_at).toBeDefined();
   229→
   230→      // Check directory was created
   231→      const sessionDir = getSessionDir(testDir, input.id);
   232→      const stat = await fs.stat(sessionDir);
   233→      expect(stat.isDirectory()).toBe(true);
   234→
   235→      // Check metadata file was created
   236→      const metadataPath = getSessionMetadataPath(testDir, input.id);
   237→      const content = await fs.readFile(metadataPath, 'utf-8');
   238→      expect(content).toContain('id: ' + input.id);
   239→      expect(content).toContain('agent_type: claude-code');
   240→      expect(content).toContain('status: active');
   241→    });
   242→
   243→    // AC: @session-events ac-5
   244→    it('should include optional task_id in metadata', async () => {
   245→      const input: SessionMetadataInput = {
   246→        id: '01KF123456789ABCDEFGHJKMNP',
   247→        agent_type: 'claude-code',
   248→        task_id: '@my-task',
   249→      };
   250→
   251→      const metadata = await createSession(testDir, input);
   252→
   253→      expect(metadata.task_id).toBe('@my-task');
   254→
   255→      const metadataPath = getSessionMetadataPath(testDir, input.id);
   256→      const content = await fs.readFile(metadataPath, 'utf-8');
   257→      expect(content).toContain("task_id: '@my-task'");
   258→    });
   259→
   260→    it('should use provided started_at if given', async () => {
   261→      const startTime = '2026-01-17T10:00:00.000Z';
   262→      const input: SessionMetadataInput = {
   263→        id: '01KF123456789ABCDEFGHJKMNP',
   264→        agent_type: 'claude-code',
   265→        started_at: startTime,
   266→      };
   267→
   268→      const metadata = await createSession(testDir, input);
   269→
   270→      expect(metadata.started_at).toBe(startTime);
   271→    });
   272→  });
   273→
   274→  describe('getSession', () => {
   275→    it('should return session metadata if exists', async () => {
   276→      const input: SessionMetadataInput = {
   277→        id: '01KF123456789ABCDEFGHJKMNP',
   278→        agent_type: 'claude-code',
   279→      };
   280→
   281→      await createSession(testDir, input);
   282→      const metadata = await getSession(testDir, input.id);
   283→
   284→      expect(metadata).not.toBeNull();
   285→      expect(metadata?.id).toBe(input.id);
   286→      expect(metadata?.agent_type).toBe(input.agent_type);
   287→    });
   288→
   289→    it('should return null if session does not exist', async () => {
   290→      const metadata = await getSession(testDir, 'nonexistent');
   291→
   292→      expect(metadata).toBeNull();
   293→    });
   294→  });
   295→
   296→  describe('updateSessionStatus', () => {
   297→    // AC: @session-events ac-6
   298→    it('should update status and set ended_at when completing', async () => {
   299→      const input: SessionMetadataInput = {
   300→        id: '01KF123456789ABCDEFGHJKMNP',
   301→        agent_type: 'claude-code',
   302→      };
   303→
   304→      await createSession(testDir, input);
   305→      const updated = await updateSessionStatus(testDir, input.id, 'completed');
   306→
   307→      expect(updated).not.toBeNull();
   308→      expect(updated?.status).toBe('completed');
   309→      expect(updated?.ended_at).toBeDefined();
   310→
   311→      // Verify persisted
   312→      const reloaded = await getSession(testDir, input.id);
   313→      expect(reloaded?.status).toBe('completed');
   314→      expect(reloaded?.ended_at).toBeDefined();
   315→    });
   316→
   317→    // AC: @session-events ac-6
   318→    it('should set ended_at when abandoning', async () => {
   319→      const input: SessionMetadataInput = {
   320→        id: '01KF123456789ABCDEFGHJKMNP',
   321→        agent_type: 'claude-code',
   322→      };
   323→
   324→      await createSession(testDir, input);
   325→      const updated = await updateSessionStatus(testDir, input.id, 'abandoned');
   326→
   327→      expect(updated?.status).toBe('abandoned');
   328→      expect(updated?.ended_at).toBeDefined();
   329→    });
   330→
   331→    it('should return null if session does not exist', async () => {
   332→      const updated = await updateSessionStatus(testDir, 'nonexistent', 'completed');
   333→
   334→      expect(updated).toBeNull();
   335→    });
   336→  });
   337→
   338→  describe('listSessions', () => {
   339→    it('should list all session IDs', async () => {
   340→      await createSession(testDir, { id: 'session-a', agent_type: 'claude-code' });
   341→      await createSession(testDir, { id: 'session-b', agent_type: 'claude-code' });
   342→      await createSession(testDir, { id: 'session-c', agent_type: 'test-agent' });
   343→
   344→      const sessions = await listSessions(testDir);
   345→
   346→      expect(sessions).toHaveLength(3);
   347→      expect(sessions).toContain('session-a');
   348→      expect(sessions).toContain('session-b');
   349→      expect(sessions).toContain('session-c');
   350→    });
   351→
   352→    it('should return empty array if no sessions', async () => {
   353→      const sessions = await listSessions(testDir);
   354→
   355→      expect(sessions).toHaveLength(0);
   356→    });
   357→  });
   358→
   359→  describe('sessionExists', () => {
   360→    it('should return true if session exists', async () => {
   361→      await createSession(testDir, { id: 'my-session', agent_type: 'claude-code' });
   362→
   363→      const exists = await sessionExists(testDir, 'my-session');
   364→
   365→      expect(exists).toBe(true);
   366→    });
   367→
   368→    it('should return false if session does not exist', async () => {
   369→      const exists = await sessionExists(testDir, 'nonexistent');
   370→
   371→      expect(exists).toBe(false);
   372→    });
   373→  });
   374→});
