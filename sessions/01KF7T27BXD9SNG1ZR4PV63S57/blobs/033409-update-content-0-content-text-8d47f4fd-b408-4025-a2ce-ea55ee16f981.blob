     1→/**
     2→ * Session event storage tests.
     3→ *
     4→ * Tests for JSONL-based event storage for agent sessions.
     5→ */
     6→
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import * as fs from 'node:fs/promises';
     9→import * as path from 'node:path';
    10→import * as os from 'node:os';
    11→import {
    12→  SessionMetadataSchema,
    13→  SessionEventSchema,
    14→  SessionStatusSchema,
    15→  EventTypeSchema,
    16→  type SessionMetadataInput,
    17→  type SessionEventInput,
    18→} from '../src/sessions/types.js';
    19→import {
    20→  createSession,
    21→  getSession,
    22→  updateSessionStatus,
    23→  listSessions,
    24→  sessionExists,
    25→  appendEvent,
    26→  readEvents,
    27→  readEventsSince,
    28→  getLastEvent,
    29→  getSessionsDir,
    30→  getSessionDir,
    31→  getSessionMetadataPath,
    32→  getSessionEventsPath,
    33→} from '../src/sessions/store.js';
    34→
    35→// ─── Schema Tests ────────────────────────────────────────────────────────────
    36→
    37→describe('SessionStatusSchema', () => {
    38→  it('should accept valid status values', () => {
    39→    expect(SessionStatusSchema.safeParse('active').success).toBe(true);
    40→    expect(SessionStatusSchema.safeParse('completed').success).toBe(true);
    41→    expect(SessionStatusSchema.safeParse('abandoned').success).toBe(true);
    42→  });
    43→
    44→  it('should reject invalid status values', () => {
    45→    expect(SessionStatusSchema.safeParse('invalid').success).toBe(false);
    46→    expect(SessionStatusSchema.safeParse('pending').success).toBe(false);
    47→    expect(SessionStatusSchema.safeParse('').success).toBe(false);
    48→  });
    49→});
    50→
    51→describe('EventTypeSchema', () => {
    52→  it('should accept valid event types', () => {
    53→    expect(EventTypeSchema.safeParse('session.start').success).toBe(true);
    54→    expect(EventTypeSchema.safeParse('session.update').success).toBe(true);
    55→    expect(EventTypeSchema.safeParse('session.end').success).toBe(true);
    56→    expect(EventTypeSchema.safeParse('prompt.sent').success).toBe(true);
    57→    expect(EventTypeSchema.safeParse('tool.call').success).toBe(true);
    58→    expect(EventTypeSchema.safeParse('tool.result').success).toBe(true);
    59→    expect(EventTypeSchema.safeParse('note').success).toBe(true);
    60→  });
    61→
    62→  it('should reject invalid event types', () => {
    63→    expect(EventTypeSchema.safeParse('invalid').success).toBe(false);
    64→    expect(EventTypeSchema.safeParse('session_start').success).toBe(false);
    65→    expect(EventTypeSchema.safeParse('').success).toBe(false);
    66→  });
    67→});
