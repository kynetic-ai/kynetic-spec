    69→describe('SessionMetadataSchema', () => {
    70→  // AC: @session-events ac-5
    71→  it('should accept valid session metadata with all fields', () => {
    72→    const metadata = {
    73→      id: '01KF123456789ABCDEFGHJKMNP',
    74→      task_id: '@my-task',
    75→      agent_type: 'claude-code',
    76→      status: 'active',
    77→      started_at: '2026-01-17T10:00:00.000Z',
    78→    };
    79→
    80→    const result = SessionMetadataSchema.safeParse(metadata);
    81→    expect(result.success).toBe(true);
    82→  });
    83→
    84→  // AC: @session-events ac-5
    85→  it('should accept metadata without optional task_id', () => {
    86→    const metadata = {
    87→      id: '01KF123456789ABCDEFGHJKMNP',
    88→      agent_type: 'claude-code',
    89→      status: 'active',
    90→      started_at: '2026-01-17T10:00:00.000Z',
    91→    };
    92→
    93→    const result = SessionMetadataSchema.safeParse(metadata);
    94→    expect(result.success).toBe(true);
    95→  });
    96→
    97→  it('should accept completed status with ended_at', () => {
    98→    const metadata = {
    99→      id: '01KF123456789ABCDEFGHJKMNP',
   100→      agent_type: 'claude-code',
   101→      status: 'completed',
   102→      started_at: '2026-01-17T10:00:00.000Z',
   103→      ended_at: '2026-01-17T11:00:00.000Z',
   104→    };
   105→
   106→    const result = SessionMetadataSchema.safeParse(metadata);
   107→    expect(result.success).toBe(true);
   108→  });
   109→
   110→  it('should reject metadata without required fields', () => {
   111→    const metadata = {
   112→      id: '01KF123456789ABCDEFGHJKMNP',
   113→      status: 'active',
   114→    };
   115→
   116→    const result = SessionMetadataSchema.safeParse(metadata);
   117→    expect(result.success).toBe(false);
   118→  });
   119→});
