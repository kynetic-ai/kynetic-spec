   174→// ─── Path Helper Tests ───────────────────────────────────────────────────────
   175→
   176→describe('Path helpers', () => {
   177→  const specDir = '/test/.kspec';
   178→  const sessionId = '01KF123456789ABCDEFGHJKMNP';
   179→
   180→  it('should construct sessions directory path', () => {
   181→    expect(getSessionsDir(specDir)).toBe('/test/.kspec/sessions');
   182→  });
   183→
   184→  it('should construct session directory path', () => {
   185→    expect(getSessionDir(specDir, sessionId)).toBe(`/test/.kspec/sessions/${sessionId}`);
   186→  });
   187→
   188→  it('should construct metadata file path', () => {
   189→    expect(getSessionMetadataPath(specDir, sessionId)).toBe(
   190→      `/test/.kspec/sessions/${sessionId}/session.yaml`
   191→    );
   192→  });
   193→
   194→  it('should construct events file path', () => {
   195→    expect(getSessionEventsPath(specDir, sessionId)).toBe(
   196→      `/test/.kspec/sessions/${sessionId}/events.jsonl`
   197→    );
   198→  });
   199→});
