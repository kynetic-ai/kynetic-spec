   121→describe('SessionEventSchema', () => {
   122→  // AC: @session-events ac-2
   123→  it('should accept valid event with all fields', () => {
   124→    const event = {
   125→      ts: Date.now(),
   126→      seq: 0,
   127→      type: 'session.start',
   128→      session_id: '01KF123456789ABCDEFGHJKMNP',
   129→      trace_id: 'trace-123',
   130→      data: { message: 'Session started' },
   131→    };
   132→
   133→    const result = SessionEventSchema.safeParse(event);
   134→    expect(result.success).toBe(true);
   135→  });
   136→
   137→  it('should accept event without optional trace_id', () => {
   138→    const event = {
   139→      ts: Date.now(),
   140→      seq: 0,
   141→      type: 'session.start',
   142→      session_id: '01KF123456789ABCDEFGHJKMNP',
   143→      data: null,
   144→    };
   145→
   146→    const result = SessionEventSchema.safeParse(event);
   147→    expect(result.success).toBe(true);
   148→  });
   149→
   150→  it('should reject event without required fields', () => {
   151→    const event = {
   152→      ts: Date.now(),
   153→      type: 'session.start',
   154→    };
   155→
   156→    const result = SessionEventSchema.safeParse(event);
   157→    expect(result.success).toBe(false);
   158→  });
   159→
   160→  it('should reject negative sequence number', () => {
   161→    const event = {
   162→      ts: Date.now(),
   163→      seq: -1,
   164→      type: 'session.start',
   165→      session_id: '01KF123456789ABCDEFGHJKMNP',
   166→      data: null,
   167→    };
   168→
   169→    const result = SessionEventSchema.safeParse(event);
   170→    expect(result.success).toBe(false);
   171→  });
   172→});
