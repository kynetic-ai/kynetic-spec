   868→describe('Integration: meta mutation commands', () => {
   869→  let tempDir: string;
   870→
   871→  beforeEach(async () => {
   872→    tempDir = await setupTempFixtures();
   873→  });
   874→
   875→  afterEach(async () => {
   876→    await cleanupTempDir(tempDir);
   877→  });
   878→
   879→  describe('meta add', () => {
   880→    it('should create a new agent with required fields', () => {
   881→      const output = kspec(
   882→        'meta add agent --id new-agent --name "New Agent" --description "A new agent"',
   883→        tempDir
   884→      );
   885→
   886→      expect(output).toContain('Created agent: new-agent');
   887→      expect(output).toMatch(/@\w{8}/); // ULID prefix
   888→
   889→      // Verify it was created
   890→      const agent = kspecJson<any>('meta get @new-agent', tempDir);
   891→      expect(agent.id).toBe('new-agent');
   892→      expect(agent.name).toBe('New Agent');
   893→      expect(agent.description).toBe('A new agent');
   894→    });
   895→
   896→    it('should create agent with capabilities and tools', () => {
   897→      kspec(
   898→        'meta add agent --id capable-agent --name "Capable Agent" --capability code --capability test --tool bash --tool git',
   899→        tempDir
   900→      );
   901→
   902→      const agent = kspecJson<any>('meta get @capable-agent', tempDir);
   903→      expect(agent.capabilities).toEqual(['code', 'test']);
   904→      expect(agent.tools).toEqual(['bash', 'git']);
   905→    });
   906→
   907→    it('should create a new workflow with required fields', () => {
   908→      const output = kspec(
   909→        'meta add workflow --id new-workflow --trigger "on-commit" --description "A new workflow"',
   910→        tempDir
   911→      );
   912→
   913→      expect(output).toContain('Created workflow: new-workflow');
   914→
   915→      const workflow = kspecJson<any>('meta get @new-workflow', tempDir);
   916→      expect(workflow.id).toBe('new-workflow');
   917→      expect(workflow.trigger).toBe('on-commit');
   918→      expect(workflow.description).toBe('A new workflow');
   919→      expect(workflow.steps).toEqual([]);
   920→    });
   921→
   922→    it('should create a new convention with rules', () => {
   923→      const output = kspec(
   924→        'meta add convention --domain testing --rule "Write tests first" --rule "Use descriptive names"',
   925→        tempDir
   926→      );
   927→
   928→      expect(output).toContain('Created convention: testing');
   929→
   930→      const convention = kspecJson<any>('meta get @testing', tempDir);
   931→      expect(convention.domain).toBe('testing');
   932→      expect(convention.rules).toEqual(['Write tests first', 'Use descriptive names']);
   933→    });
   934→
   935→    it('should fail when required fields are missing', () => {
   936→      try {
   937→        kspec('meta add agent --name "Agent without ID"', tempDir);
   938→        expect.fail('Should have thrown error');
   939→      } catch (e: any) {
   940→        expect(e.message).toContain('Agent requires --id');
   941→      }
   942→
   943→      try {
   944→        kspec('meta add workflow --id workflow-no-trigger', tempDir);
   945→        expect.fail('Should have thrown error');
   946→      } catch (e: any) {
   947→        expect(e.message).toContain('Workflow requires --trigger');
   948→      }
   949→
   950→      try {
   951→        kspec('meta add convention --rule "Rule without domain"', tempDir);
   952→        expect.fail('Should have thrown error');
   953→      } catch (e: any) {
   954→        expect(e.message).toContain('Convention requires --domain');
   955→      }
   956→    });
   957→
   958→    it('should support JSON output', () => {
   959→      const agent = kspecJson<any>(
   960→        'meta add agent --id json-agent --name "JSON Agent"',
   961→        tempDir
   962→      );
   963→
   964→      expect(agent.id).toBe('json-agent');
   965→      expect(agent.name).toBe('JSON Agent');
   966→      expect(agent._ulid).toMatch(/^[0-7][0-9A-HJKMNP-TV-Z]{25}$/);
   967→    });
   968→  });
   969→
   970→  describe('meta set', () => {
   971→    it('should update agent name and description', () => {
   972→      // Create an agent
   973→      kspec('meta add agent --id update-agent --name "Original Name"', tempDir);
   974→
   975→      // Update it
   976→      const output = kspec(
   977→        'meta set @update-agent --name "Updated Name" --description "New description"',
   978→        tempDir
   979→      );
   980→
   981→      expect(output).toContain('Updated agent: update-agent');
   982→
   983→      const agent = kspecJson<any>('meta get @update-agent', tempDir);
   984→      expect(agent.name).toBe('Updated Name');
   985→      expect(agent.description).toBe('New description');
   986→    });
   987→
   988→    it('should add capabilities and tools to agent', () => {
   989→      kspec('meta add agent --id add-agent --name "Add Agent"', tempDir);
   990→
   991→      kspec('meta set @add-agent --add-capability code', tempDir);
   992→      kspec('meta set @add-agent --add-capability test', tempDir);
   993→      kspec('meta set @add-agent --add-tool bash', tempDir);
   994→
   995→      const agent = kspecJson<any>('meta get @add-agent', tempDir);
   996→      expect(agent.capabilities).toContain('code');
   997→      expect(agent.capabilities).toContain('test');
   998→      expect(agent.tools).toContain('bash');
   999→    });
  1000→
  1001→    it('should not duplicate capabilities or tools', () => {
  1002→      kspec(
  1003→        'meta add agent --id dup-agent --name "Dup Agent" --capability code --tool bash',
  1004→        tempDir
  1005→      );
  1006→
  1007→      kspec('meta set @dup-agent --add-capability code --add-tool bash', tempDir);
  1008→
  1009→      const agent = kspecJson<any>('meta get @dup-agent', tempDir);
  1010→      expect(agent.capabilities).toEqual(['code']); // Should not duplicate
  1011→      expect(agent.tools).toEqual(['bash']);
  1012→    });
  1013→
  1014→    it('should update workflow trigger and description', () => {
  1015→      kspec('meta add workflow --id update-wf --trigger "old-trigger"', tempDir);
  1016→
  1017→      kspec(
  1018→        'meta set @update-wf --trigger "new-trigger" --description "Updated workflow"',
  1019→        tempDir
  1020→      );
  1021→
  1022→      const workflow = kspecJson<any>('meta get @update-wf', tempDir);
  1023→      expect(workflow.trigger).toBe('new-trigger');
  1024→      expect(workflow.description).toBe('Updated workflow');
  1025→    });
  1026→
  1027→    it('should add rules to convention', () => {
  1028→      kspec('meta add convention --domain update-conv --rule "Rule 1"', tempDir);
  1029→
  1030→      kspec('meta set @update-conv --add-rule "Rule 2"', tempDir);
  1031→
  1032→      const convention = kspecJson<any>('meta get @update-conv', tempDir);
  1033→      expect(convention.rules).toContain('Rule 1');
  1034→      expect(convention.rules).toContain('Rule 2');
  1035→    });
  1036→
  1037→    it('should work with ULID prefix references', () => {
  1038→      const output = kspec('meta add agent --id ulid-ref --name "ULID Ref Agent"', tempDir);
  1039→      const match = output.match(/@(\w{8})/);
  1040→      expect(match).toBeTruthy();
  1041→      const ulidPrefix = match![1];
  1042→
  1043→      kspec(`meta set @${ulidPrefix} --name "Updated via ULID"`, tempDir);
  1044→
  1045→      const agent = kspecJson<any>('meta get @ulid-ref', tempDir);
  1046→      expect(agent.name).toBe('Updated via ULID');
  1047→    });
  1048→
  1049→    it('should support JSON output', () => {
  1050→      kspec('meta add agent --id json-update --name "JSON Update"', tempDir);
  1051→
  1052→      const agent = kspecJson<any>('meta set @json-update --name "JSON Updated"', tempDir);
  1053→      expect(agent.name).toBe('JSON Updated');
  1054→    });
  1055→
  1056→    it('should fail for non-existent item', () => {
  1057→      try {
  1058→        kspec('meta set @nonexistent --name "Should fail"', tempDir);
  1059→        expect.fail('Should have thrown error');
  1060→      } catch (e: any) {
  1061→        expect(e.message).toContain('Meta item not found');
  1062→      }
  1063→    });
  1064→  });
  1065→
  1066→  describe('meta delete', () => {
  1067→    it('should delete an agent', () => {
  1068→      kspec('meta add agent --id delete-agent --name "Delete Agent"', tempDir);
  1069→
  1070→      const output = kspec('meta delete @delete-agent --confirm', tempDir);
