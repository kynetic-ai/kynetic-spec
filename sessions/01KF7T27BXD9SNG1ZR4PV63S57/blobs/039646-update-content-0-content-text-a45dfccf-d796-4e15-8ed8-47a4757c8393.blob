  1132→      }
  1133→    });
  1134→
  1135→    it('should prevent deletion of agent referenced by task', () => {
  1136→      // Create an agent
  1137→      kspec('meta add agent --id ref-agent --name "Referenced Agent"', tempDir);
  1138→
  1139→      // Create a task that references this agent
