  1244→      expect(agent.id).toBe('ulid-test-agent');
  1245→    });
  1246→
  1247→    it('should detect references with mixed reference formats', () => {
  1248→      // Create a workflow
  1249→      const workflowOutput = kspec(
  1250→        'meta add workflow --id ulid-workflow --trigger "test trigger"',
  1251→        tempDir
  1252→      );
  1253→
  1254→      // Extract ULID prefix from: "Created workflow: ulid-workflow (@01KF7...)"
  1255→      const ulidMatch = workflowOutput.match(/\((@[\w]+)\)/);
  1256→      expect(ulidMatch).toBeTruthy();
  1257→      const ulidPrefix = ulidMatch![1];
  1258→
  1259→      // Create observation using ULID prefix
  1260→      kspec(`meta observe friction "Test friction" --workflow ${ulidPrefix}`, tempDir);
  1261→
  1262→      // Try to delete using semantic ID - should still detect reference
  1263→      try {
  1264→        kspec('meta delete @ulid-workflow', tempDir);
  1265→        expect.fail('Should have detected reference');
  1266→      } catch (e: any) {
  1267→        expect(e.message).toContain('Referenced by');
  1268→        expect(e.message).toContain('observation(s)');
  1269→      }
  1270→
  1271→      // Verify workflow still exists
  1272→      const workflow = kspecJson<any>('meta get @ulid-workflow', tempDir);
  1273→      expect(workflow.id).toBe('ulid-workflow');
  1274→    });
  1275→  });
  1276→});
