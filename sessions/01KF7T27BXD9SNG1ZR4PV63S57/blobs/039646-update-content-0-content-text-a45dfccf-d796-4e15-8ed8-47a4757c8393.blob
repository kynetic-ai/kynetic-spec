  1073→      // Verify it's gone
  1074→      try {
  1075→        kspec('meta get @delete-agent', tempDir);
  1076→        expect.fail('Should have thrown error');
  1077→      } catch (e: any) {
  1078→        expect(e.message).toContain('not found');
  1079→      }
  1080→    });
  1081→
  1082→    it('should delete a workflow', () => {
  1083→      kspec('meta add workflow --id delete-wf --trigger "delete-trigger"', tempDir);
