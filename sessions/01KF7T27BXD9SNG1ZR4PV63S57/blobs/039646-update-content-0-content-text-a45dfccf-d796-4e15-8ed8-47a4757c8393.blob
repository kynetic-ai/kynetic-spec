  1278→describe('Integration: meta includes', () => {
  1279→  let tempDir: string;
  1280→
  1281→  beforeEach(async () => {
  1282→    tempDir = await setupTempFixtures();
  1283→  });
  1284→
  1285→  afterEach(async () => {
  1286→    await cleanupTempDir(tempDir);
  1287→  });
  1288→
  1289→  it('should load meta items from included files', async () => {
  1290→    // Create a meta/ directory for included files
  1291→    const metaDir = path.join(tempDir, 'meta');
  1292→    await fs.mkdir(metaDir, { recursive: true });
  1293→
  1294→    // Create separate files for agents and workflows
  1295→    const agentsFile = path.join(metaDir, 'agents.yaml');
  1296→    await fs.writeFile(
  1297→      agentsFile,
  1298→      `agents:
  1299→  - _ulid: 01KF8850000000000000000001
  1300→    id: include-agent-1
  1301→    name: Include Agent 1
  1302→    description: Agent from included file
  1303→    capabilities:
  1304→      - code
  1305→    tools:
  1306→      - git
  1307→    conventions: []
  1308→
  1309→  - _ulid: 01KF8850000000000000000002
  1310→    id: include-agent-2
  1311→    name: Include Agent 2
  1312→    description: Another agent from included file
  1313→    capabilities:
  1314→      - review
  1315→    tools:
  1316→      - kspec
  1317→    conventions: []
  1318→`
  1319→    );
  1320→
  1321→    const workflowsFile = path.join(metaDir, 'workflows.yaml');
  1322→    await fs.writeFile(
  1323→      workflowsFile,
  1324→      `workflows:
  1325→  - _ulid: 01KF8850000000000000000003
  1326→    id: include-workflow-1
  1327→    trigger: "Test trigger from include"
  1328→    description: Workflow from included file
  1329→    steps:
  1330→      - type: check
  1331→        content: Check something
  1332→        on_fail: Do something else
  1333→      - type: action
  1334→        content: Take an action
  1335→`
  1336→    );
  1337→
  1338→    // Update the meta manifest to include these files
  1339→    const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
  1340→    let metaContent = await fs.readFile(metaPath, 'utf-8');
  1341→
  1342→    // Add includes section if not present
  1343→    if (!metaContent.includes('includes:')) {
  1344→      metaContent += '\nincludes:\n  - meta/agents.yaml\n  - meta/workflows.yaml\n';
  1345→    } else {
  1346→      metaContent = metaContent.replace(
  1347→        'includes:',
  1348→        'includes:\n  - meta/agents.yaml\n  - meta/workflows.yaml'
  1349→      );
  1350→    }
  1351→
  1352→    await fs.writeFile(metaPath, metaContent);
  1353→
  1354→    // Verify agents from included files are loaded
  1355→    const agents = kspecJson<any[]>('meta agents', tempDir);
  1356→    const includeAgent1 = agents.find(a => a.id === 'include-agent-1');
  1357→    const includeAgent2 = agents.find(a => a.id === 'include-agent-2');
  1358→
  1359→    expect(includeAgent1).toBeDefined();
  1360→    expect(includeAgent1?.name).toBe('Include Agent 1');
  1361→    expect(includeAgent1?.description).toBe('Agent from included file');
  1362→    expect(includeAgent1?.capabilities).toEqual(['code']);
  1363→    expect(includeAgent1?.tools).toEqual(['git']);
  1364→
  1365→    expect(includeAgent2).toBeDefined();
  1366→    expect(includeAgent2?.name).toBe('Include Agent 2');
  1367→    expect(includeAgent2?.capabilities).toEqual(['review']);
  1368→
  1369→    // Verify workflows from included files are loaded
  1370→    const workflows = kspecJson<any[]>('meta workflows', tempDir);
  1371→    const includeWorkflow = workflows.find(w => w.id === 'include-workflow-1');
  1372→
  1373→    expect(includeWorkflow).toBeDefined();
  1374→    expect(includeWorkflow?.trigger).toBe('Test trigger from include');
  1375→    expect(includeWorkflow?.description).toBe('Workflow from included file');
  1376→    expect(includeWorkflow?.steps).toHaveLength(2);
  1377→    expect(includeWorkflow?.steps[0].type).toBe('check');
  1378→    expect(includeWorkflow?.steps[1].type).toBe('action');
  1379→  });
  1380→
  1381→  it('should load meta items from both manifest and includes', async () => {
  1382→    // The test fixtures already have agents and workflows in kynetic.meta.yaml
  1383→    // We'll add an include file to verify both are loaded
  1384→
  1385→    const metaDir = path.join(tempDir, 'meta');
  1386→    await fs.mkdir(metaDir, { recursive: true });
  1387→
  1388→    const conventionsFile = path.join(metaDir, 'conventions.yaml');
  1389→    await fs.writeFile(
  1390→      conventionsFile,
  1391→      `conventions:
  1392→  - _ulid: 01KF8850000000000000000010
  1393→    domain: testing-include
  1394→    rules:
  1395→      - Write tests for included items
  1396→      - Verify include loading
  1397→    examples: []
  1398→`
  1399→    );
  1400→
  1401→    // Add includes to meta manifest
  1402→    const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
  1403→    let metaContent = await fs.readFile(metaPath, 'utf-8');
  1404→    metaContent += '\nincludes:\n  - meta/conventions.yaml\n';
  1405→    await fs.writeFile(metaPath, metaContent);
  1406→
  1407→    // Verify both original agents and included convention are present
  1408→    const agents = kspecJson<any[]>('meta agents', tempDir);
  1409→    expect(agents.some(a => a.id === 'test-agent')).toBe(true); // From manifest
  1410→    expect(agents.some(a => a.id === 'review-agent')).toBe(true); // From manifest
  1411→
  1412→    const conventions = kspecJson<any[]>('meta conventions', tempDir);
  1413→    const includeConvention = conventions.find(c => c.domain === 'testing-include');
  1414→    expect(includeConvention).toBeDefined();
  1415→    expect(includeConvention?.rules).toContain('Write tests for included items');
  1416→  });
  1417→
  1418→  it('should handle glob patterns in includes', async () => {
  1419→    // Create multiple files matching a pattern
  1420→    const metaDir = path.join(tempDir, 'meta');
  1421→    await fs.mkdir(metaDir, { recursive: true });
  1422→
  1423→    await fs.writeFile(
  1424→      path.join(metaDir, 'agent-1.yaml'),
  1425→      `agents:
  1426→  - _ulid: 01KF8850000000000000000020
  1427→    id: glob-agent-1
  1428→    name: Glob Agent 1
  1429→    capabilities: []
  1430→    tools: []
  1431→    conventions: []
  1432→`
  1433→    );
  1434→
  1435→    await fs.writeFile(
  1436→      path.join(metaDir, 'agent-2.yaml'),
  1437→      `agents:
  1438→  - _ulid: 01KF8850000000000000000021
  1439→    id: glob-agent-2
  1440→    name: Glob Agent 2
  1441→    capabilities: []
  1442→    tools: []
  1443→    conventions: []
  1444→`
  1445→    );
  1446→
  1447→    // Update meta manifest to include all agent-*.yaml files
  1448→    const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
  1449→    let metaContent = await fs.readFile(metaPath, 'utf-8');
  1450→    metaContent += '\nincludes:\n  - meta/agent-*.yaml\n';
  1451→    await fs.writeFile(metaPath, metaContent);
  1452→
  1453→    // Verify both agents are loaded
  1454→    const agents = kspecJson<any[]>('meta agents', tempDir);
  1455→    expect(agents.some(a => a.id === 'glob-agent-1')).toBe(true);
  1456→    expect(agents.some(a => a.id === 'glob-agent-2')).toBe(true);
  1457→  });
  1458→
  1459→  it('should gracefully handle missing include files', async () => {
  1460→    // Add an include that doesn't exist
  1461→    const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
  1462→    let metaContent = await fs.readFile(metaPath, 'utf-8');
  1463→    metaContent += '\nincludes:\n  - meta/nonexistent.yaml\n';
  1464→    await fs.writeFile(metaPath, metaContent);
  1465→
  1466→    // Should still load successfully without the missing file
  1467→    const agents = kspecJson<any[]>('meta agents', tempDir);
  1468→    expect(agents.some(a => a.id === 'test-agent')).toBe(true);
  1469→  });
  1470→
  1471→  it('should validate references across included files', async () => {
  1472→    // Create an included workflow file
  1473→    const metaDir = path.join(tempDir, 'meta');
  1474→    await fs.mkdir(metaDir, { recursive: true });
  1475→
  1476→    const workflowsFile = path.join(metaDir, 'test-workflows.yaml');
  1477→    await fs.writeFile(
  1478→      workflowsFile,
  1479→      `workflows:
  1480→  - _ulid: 01KF8850000000000000000030
  1481→    id: include-ref-workflow
  1482→    trigger: "Test trigger"
  1483→    description: Workflow from include for reference test
  1484→    steps:
  1485→      - type: action
  1486→        content: Do something
  1487→`
  1488→    );
  1489→
  1490→    // Add includes to meta manifest
  1491→    const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
  1492→    let metaContent = await fs.readFile(metaPath, 'utf-8');
  1493→    metaContent += '\nincludes:\n  - meta/test-workflows.yaml\n';
  1494→    await fs.writeFile(metaPath, metaContent);
  1495→
  1496→    // Create a task that references the workflow from the included file
  1497→    const tasksPath = path.join(tempDir, 'project.tasks.yaml');
  1498→    let tasksContent = await fs.readFile(tasksPath, 'utf-8');
  1499→
  1500→    const newTask = `
  1501→  - _ulid: 01KF8850000000000000000031
  1502→    title: Test task referencing included workflow
  1503→    status: pending
  1504→    priority: 1
  1505→    created_at: "2024-01-01T00:00:00Z"
  1506→    meta_ref: "@include-ref-workflow"
  1507→    slugs:
  1508→      - test-task-include-ref
  1509→    depends_on: []
  1510→    notes: []
  1511→    todos: []
  1512→    blocked_by: []
  1513→    tags: []
  1514→`;
  1515→    tasksContent = tasksContent.replace('tasks:', `tasks:${newTask}`);
  1516→    await fs.writeFile(tasksPath, tasksContent);
  1517→
  1518→    // Validate should pass because include-ref-workflow exists in included file
  1519→    const output = kspec('validate --refs', tempDir);
  1520→    expect(output).toContain('References: OK');
  1521→  });
  1522→});
  1523→
  1524→// AC: @convention-schema
  1525→describe('Integration: conventions', () => {
  1526→  let tempDir: string;
  1527→
  1528→  beforeEach(async () => {
  1529→    tempDir = await setupTempFixtures();
  1530→  });
  1531→
  1532→  afterEach(async () => {
  1533→    await fs.rm(tempDir, { recursive: true, force: true });
  1534→  });
  1535→
  1536→  it('should list conventions with domain, rules, and validation', async () => {
  1537→    // Add test conventions to meta manifest
  1538→    const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
  1539→    const metaContent = await fs.readFile(metaPath, 'utf-8');
  1540→
  1541→    const conventions = `
  1542→conventions:
  1543→  - _ulid: 01KF8850000000000000000030
  1544→    domain: commits
  1545→    rules:
  1546→      - Use conventional commit format
  1547→      - Reference task in commit body
  1548→    examples:
  1549→      - good: "feat: add feature"
  1550→        bad: "added stuff"
  1551→    validation:
  1552→      type: regex
  1553→      pattern: "^(feat|fix):"
  1554→      message: "Must start with feat: or fix:"
  1555→
  1556→  - _ulid: 01KF8850000000000000000031
  1557→    domain: notes
  1558→    rules:
  1559→      - Keep notes concise
  1560→      - Document decisions
  1561→    examples:
  1562→      - good: "Chose approach A because of constraint X"
  1563→        bad: "done"
  1564→`;
  1565→
  1566→    await fs.writeFile(metaPath, metaContent + conventions);
  1567→
  1568→    // List conventions in JSON format
  1569→    const result = kspecJson<Array<{
  1570→      domain: string;
  1571→      rules: string[];
  1572→      examples: Array<{ good: string; bad: string }>;
  1573→      validation?: {
  1574→        type: string;
  1575→        pattern?: string;
  1576→        message?: string;
  1577→      };
  1578→    }>>('meta conventions', tempDir);
  1579→
  1580→    // Verify structure
  1581→    expect(result.length).toBeGreaterThanOrEqual(2);
  1582→
  1583→    const commitConvention = result.find(c => c.domain === 'commits');
  1584→    expect(commitConvention).toBeDefined();
  1585→    expect(commitConvention?.rules).toHaveLength(2);
  1586→    expect(commitConvention?.rules[0]).toBe('Use conventional commit format');
  1587→    expect(commitConvention?.examples).toHaveLength(1);
  1588→    expect(commitConvention?.examples[0].good).toBe('feat: add feature');
  1589→    expect(commitConvention?.examples[0].bad).toBe('added stuff');
  1590→    expect(commitConvention?.validation?.type).toBe('regex');
  1591→    expect(commitConvention?.validation?.pattern).toBe('^(feat|fix):');
  1592→    expect(commitConvention?.validation?.message).toBe('Must start with feat: or fix:');
  1593→
  1594→    const noteConvention = result.find(c => c.domain === 'notes');
  1595→    expect(noteConvention).toBeDefined();
  1596→    expect(noteConvention?.validation).toBeUndefined();
  1597→  });
  1598→
  1599→  it('should support all validation types', async () => {
  1600→    const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
  1601→
  1602→    const conventions = `
  1603→kynetic_meta: "1.0"
  1604→conventions:
  1605→  - _ulid: 01KF8850000000000000000040
  1606→    domain: test-regex
  1607→    rules:
  1608→      - Rule 1
  1609→    validation:
  1610→      type: regex
  1611→      pattern: "^test:"
