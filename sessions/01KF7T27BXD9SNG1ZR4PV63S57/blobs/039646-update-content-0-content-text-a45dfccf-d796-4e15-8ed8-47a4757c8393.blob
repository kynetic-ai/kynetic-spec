   649→describe('Integration: observation-task resolution loop', () => {
   650→  let tempDir: string;
   651→
   652→  beforeEach(async () => {
   653→    tempDir = await setupTempFixtures();
   654→  });
   655→
   656→  afterEach(async () => {
   657→    await cleanupTempDir(tempDir);
   658→  });
   659→
   660→  it('should auto-populate resolution from completed task', () => {
   661→    // Create observation
   662→    const createOutput = kspec('meta observe friction "CLI is slow"', tempDir);
   663→    const match = createOutput.match(/Created observation: ([A-Z0-9]{8})/);
   664→    const obsRef = match![1];
   665→
   666→    // Promote to task
   667→    const promoteOutput = kspec(`meta promote @${obsRef} --title "Optimize CLI performance"`, tempDir);
   668→    const taskMatch = promoteOutput.match(/Created task: @([A-Z0-9]{8})/);
   669→    const taskRef = taskMatch![1];
   670→
   671→    // Start and complete the task
   672→    kspec(`task start @${taskRef}`, tempDir);
   673→    kspec(`task complete @${taskRef} --reason "Reduced startup time by 50%"`, tempDir);
   674→
   675→    // Resolve observation without explicit text (should auto-populate)
   676→    const resolveOutput = kspec(`meta resolve @${obsRef}`, tempDir);
   677→    expect(resolveOutput).toMatch(/Resolved: [A-Z0-9]{8}/);
   678→
   679→    // Verify resolution includes task info
   680→    const observations = kspecJson<any[]>('meta observations --all', tempDir);
   681→    const obs = observations.find(o => o._ulid.startsWith(obsRef));
   682→
   683→    expect(obs.resolved).toBe(true);
   684→    expect(obs.resolution).toContain(`@${taskRef}`);
   685→    expect(obs.resolution).toContain('Reduced startup time by 50%');
   686→  });
   687→
   688→  it('should filter observations with --promoted', () => {
   689→    // Create two observations, promote one
   690→    kspec('meta observe friction "Issue 1"', tempDir);
   691→    const obs2Output = kspec('meta observe friction "Issue 2"', tempDir);
   692→    const match = obs2Output.match(/Created observation: ([A-Z0-9]{8})/);
   693→    const obsRef = match![1];
   694→
   695→    kspec(`meta promote @${obsRef} --title "Fix Issue 2"`, tempDir);
   696→
   697→    // List promoted observations
   698→    const promoted = kspecJson<any[]>('meta observations --promoted', tempDir);
   699→
   700→    // Only the promoted one should appear
   701→    expect(promoted.length).toBe(1);
   702→    expect(promoted[0]._ulid.startsWith(obsRef)).toBe(true);
   703→    expect(promoted[0].promoted_to).toBeDefined();
   704→  });
   705→
   706→  it('should filter observations with --pending-resolution', () => {
   707→    // Create observation, promote, complete task
   708→    const createOutput = kspec('meta observe friction "Needs fix"', tempDir);
   709→    const match = createOutput.match(/Created observation: ([A-Z0-9]{8})/);
   710→    const obsRef = match![1];
   711→
   712→    const promoteOutput = kspec(`meta promote @${obsRef} --title "Fix the issue"`, tempDir);
   713→    const taskMatch = promoteOutput.match(/Created task: @([A-Z0-9]{8})/);
   714→    const taskRef = taskMatch![1];
   715→
   716→    kspec(`task start @${taskRef}`, tempDir);
   717→    kspec(`task complete @${taskRef} --reason "Fixed"`, tempDir);
   718→
   719→    // List pending resolution
   720→    const pending = kspecJson<any[]>('meta observations --pending-resolution', tempDir);
   721→
   722→    // Should include our observation
   723→    const found = pending.find(o => o._ulid.startsWith(obsRef));
   724→    expect(found).toBeDefined();
   725→    expect(found.resolved).toBe(false);
   726→    expect(found.promoted_to).toBeDefined();
   727→
   728→    // After resolving, should not appear
   729→    kspec(`meta resolve @${obsRef}`, tempDir);
   730→    const pendingAfter = kspecJson<any[]>('meta observations --pending-resolution', tempDir);
   731→    const foundAfter = pendingAfter.find(o => o._ulid.startsWith(obsRef));
   732→    expect(foundAfter).toBeUndefined();
   733→  });
   734→
   735→  it('should error when resolving with incomplete task', () => {
   736→    // Create observation, promote, but don't complete task
   737→    const createOutput = kspec('meta observe friction "Not done yet"', tempDir);
   738→    const match = createOutput.match(/Created observation: ([A-Z0-9]{8})/);
   739→    const obsRef = match![1];
   740→
   741→    kspec(`meta promote @${obsRef} --title "WIP task"`, tempDir);
   742→
   743→    // Try to resolve without text (task not completed)
   744→    try {
   745→      const output = kspec(`meta resolve @${obsRef}`, tempDir);
   746→      expect(output).toContain('not completed yet');
   747→    } catch (e: any) {
   748→      const stdout = e.message || '';
   749→      expect(stdout).toContain('not completed yet');
   750→    }
   751→  });
   752→});
   753→
   754→describe('Integration: meta_ref in tasks', () => {
   755→  let tempDir: string;
   756→
   757→  beforeEach(async () => {
   758→    tempDir = await setupTempFixtures();
   759→  });
   760→
   761→  afterEach(async () => {
   762→    await cleanupTempDir(tempDir);
   763→  });
   764→
   765→  // AC: @meta-ref ac-meta-ref-1
   766→  it('should create task with valid meta_ref to workflow', () => {
   767→    // AC-meta-ref-1: task add --meta-ref @workflow-id creates task with meta_ref field
   768→    const output = kspec('task add --title "Improve workflow" --meta-ref "@task-start"', tempDir);
   769→
   770→    // Should output "OK Created task: <ULID-prefix>"
   771→    expect(output).toMatch(/Created task: [A-Z0-9]{8}/);
   772→
   773→    // Verify task was created with meta_ref
   774→    const match = output.match(/Created task: ([A-Z0-9]{8})/);
   775→    const taskRef = match![1];
   776→
   777→    const task = kspecJson<any>(`task get @${taskRef}`, tempDir);
   778→    expect(task.meta_ref).toBe('@task-start');
   779→  });
   780→
   781→  // AC: @meta-ref ac-meta-ref-1
   782→  it('should create task with valid meta_ref to agent', () => {
   783→    const output = kspec('task add --title "Update agent capabilities" --meta-ref "@test-agent"', tempDir);
   784→    expect(output).toMatch(/Created task: [A-Z0-9]{8}/);
   785→
   786→    const match = output.match(/Created task: ([A-Z0-9]{8})/);
   787→    const taskRef = match![1];
   788→
   789→    const task = kspecJson<any>(`task get @${taskRef}`, tempDir);
   790→    expect(task.meta_ref).toBe('@test-agent');
   791→  });
   792→
   793→  // AC: @meta-ref ac-meta-ref-2
   794→  it('should filter tasks by meta_ref', () => {
   795→    // Create tasks with different meta_refs
   796→    kspec('task add --title "Task 1" --meta-ref "@task-start"', tempDir);
   797→    kspec('task add --title "Task 2" --meta-ref "@test-agent"', tempDir);
   798→    kspec('task add --title "Task 3" --meta-ref "@task-start"', tempDir);
   799→    kspec('task add --title "Task 4"', tempDir); // No meta_ref
   800→
   801→    // AC-meta-ref-2: tasks list --meta-ref @workflow filters by meta_ref
   802→    const tasks = kspecJson<any[]>('tasks list --meta-ref "@task-start"', tempDir);
   803→
   804→    // Should only include tasks with meta_ref = @task-start
   805→    const taskTitles = tasks.map(t => t.title);
   806→    expect(taskTitles).toContain('Task 1');
   807→    expect(taskTitles).toContain('Task 3');
   808→    expect(taskTitles).not.toContain('Task 2');
   809→    expect(taskTitles).not.toContain('Task 4');
   810→  });
   811→
   812→  // AC: @meta-ref ac-meta-ref-3
   813→  it('should error when meta_ref does not resolve', () => {
   814→    try {
   815→      const output = kspec('task add --title "Test task" --meta-ref "@invalid-ref-123456"', tempDir);
   816→      // AC-meta-ref-3: Should error with specific message
   817→      expect(output).toContain("meta_ref '@invalid-ref-123456' not found");
   818→    } catch (e: any) {
   819→      const stdout = e.message || '';
   820→      expect(stdout).toContain("meta_ref '@invalid-ref-123456' not found");
   821→    }
   822→  });
   823→
   824→  // AC: @meta-ref ac-meta-ref-4
   825→  it('should error when meta_ref points to spec item', () => {
   826→    try {
   827→      // test-feature is a spec item, not a meta item
   828→      const output = kspec('task add --title "Test task" --meta-ref "@test-feature"', tempDir);
   829→      // AC-meta-ref-4: Should error with specific message
   830→      expect(output).toContain("meta_ref '@test-feature' points to a spec item; use --spec-ref for product spec references");
   831→    } catch (e: any) {
   832→      const stdout = e.message || '';
   833→      expect(stdout).toContain("meta_ref '@test-feature' points to a spec item; use --spec-ref for product spec references");
   834→    }
   835→  });
   836→
   837→  it('should update task meta_ref with task set', () => {
   838→    // Create task without meta_ref
   839→    const createOutput = kspec('task add --title "Test task"', tempDir);
   840→    const match = createOutput.match(/Created task: ([A-Z0-9]{8})/);
   841→    const taskRef = match![1];
   842→
   843→    // Update with meta_ref
   844→    kspec(`task set @${taskRef} --meta-ref "@task-start"`, tempDir);
   845→
   846→    // Verify update
   847→    const task = kspecJson<any>(`task get @${taskRef}`, tempDir);
   848→    expect(task.meta_ref).toBe('@task-start');
   849→  });
   850→
   851→  it('should validate meta_ref in task set', () => {
   852→    // Create task
   853→    const createOutput = kspec('task add --title "Test task"', tempDir);
   854→    const match = createOutput.match(/Created task: ([A-Z0-9]{8})/);
   855→    const taskRef = match![1];
   856→
   857→    // Try to set invalid meta_ref
   858→    try {
   859→      const output = kspec(`task set @${taskRef} --meta-ref "@invalid-workflow"`, tempDir);
   860→      expect(output).toContain("meta_ref '@invalid-workflow' not found");
   861→    } catch (e: any) {
   862→      const stdout = e.message || '';
   863→      expect(stdout).toContain("meta_ref '@invalid-workflow' not found");
   864→    }
   865→  });
   866→});
