     1→/**
     2→ * Reference resolution system for @references.
     3→ *
     4→ * Handles resolution of @slug and @ulid references to actual items,
     5→ * with proper error handling for not-found and ambiguous cases.
     6→ */
     7→
     8→import type { LoadedSpecItem, LoadedTask, AnyLoadedItem } from './yaml.js';
     9→import type { LoadedMetaItem } from './meta.js';
    10→
    11→// ============================================================
    12→// TYPES
    13→// ============================================================
    14→
    15→/**
    16→ * Successful resolution result
    17→ * AC: @agent-definitions ac-agent-3
    18→ */
    19→export interface ResolveSuccess {
    20→  ok: true;
    21→  ulid: string;
    22→  item: AnyLoadedItem | LoadedMetaItem;
    23→  /** How the reference was matched */
    24→  matchType: 'slug' | 'ulid-full' | 'ulid-prefix';
    25→}
    26→
    27→/**
    28→ * Failed resolution - reference not found
    29→ */
    30→export interface ResolveNotFound {
    31→  ok: false;
    32→  error: 'not_found';
    33→  ref: string;
    34→}
    35→
    36→/**
    37→ * Failed resolution - ambiguous ULID prefix
    38→ */
    39→export interface ResolveAmbiguous {
    40→  ok: false;
    41→  error: 'ambiguous';
    42→  ref: string;
    43→  /** The matching ULIDs */
    44→  candidates: string[];
    45→}
    46→
    47→/**
    48→ * Failed resolution - duplicate slug
    49→ */
    50→export interface ResolveDuplicateSlug {
    51→  ok: false;
    52→  error: 'duplicate_slug';
    53→  ref: string;
    54→  /** The ULIDs that share this slug */
    55→  candidates: string[];
    56→}
    57→
    58→export type ResolveResult =
    59→  | ResolveSuccess
    60→  | ResolveNotFound
    61→  | ResolveAmbiguous
    62→  | ResolveDuplicateSlug;
    63→
    64→/**
    65→ * Validation error for a single reference
    66→ */
    67→export interface RefValidationError {
    68→  /** The reference string that failed */
    69→  ref: string;
    70→  /** Where this reference was found */
    71→  sourceFile?: string;
    72→  /** The item containing this reference */
    73→  sourceUlid?: string;
    74→  /** The field containing this reference */
    75→  field: string;
    76→  /** Error type */
    77→  error: 'not_found' | 'ambiguous' | 'duplicate_slug';
    78→  /** Additional context */
    79→  message: string;
    80→}
    81→
    82→// ============================================================
    83→// REFERENCE INDEX
    84→// ============================================================
    85→
    86→/**
    87→ * Index for efficient reference resolution.
    88→ * Build once when loading the spec, then resolve many times.
    89→ * AC: @agent-definitions ac-agent-3
    90→ */
    91→export class ReferenceIndex {
    92→  /** slug → ULID mapping */
    93→  private slugIndex = new Map<string, string[]>();
    94→
    95→  /** ULID → item mapping */
    96→  private ulidIndex = new Map<string, AnyLoadedItem | LoadedMetaItem>();
    97→
    98→  /** All ULIDs for prefix matching */
    99→  private allUlids: string[] = [];
   100→
   101→  /**
   102→   * Build index from loaded items and meta items
   103→   * AC: @agent-definitions ac-agent-3
   104→   */
   105→  constructor(
   106→    tasks: LoadedTask[],
   107→    items: LoadedSpecItem[],
   108→    metaItems: LoadedMetaItem[] = []
   109→  ) {
   110→    // Index tasks
   111→    for (const task of tasks) {
   112→      this.indexItem(task);
   113→    }
   114→
   115→    // Index spec items
   116→    for (const item of items) {
   117→      this.indexItem(item);
   118→    }
   119→
   120→    // Index meta items (agents, workflows, conventions, observations)
   121→    // AC: @agent-definitions ac-agent-3
   122→    for (const metaItem of metaItems) {
   123→      this.indexMetaItem(metaItem);
   124→    }
   125→
   126→    // Sort ULIDs for consistent ordering
   127→    this.allUlids.sort();
   128→  }
   129→
   130→  private indexItem(item: AnyLoadedItem): void {
   131→    const ulid = item._ulid;
   132→
   133→    // Index by ULID
   134→    this.ulidIndex.set(ulid, item);
   135→    this.allUlids.push(ulid);
   136→
   137→    // Index by slugs
   138→    for (const slug of item.slugs) {
   139→      const existing = this.slugIndex.get(slug);
   140→      if (existing) {
   141→        existing.push(ulid);
   142→      } else {
   143→        this.slugIndex.set(slug, [ulid]);
   144→      }
   145→    }
   146→  }
   147→
   148→  /**
   149→   * Index a meta item (agent, workflow, convention, observation)
   150→   * Meta items use 'id' field as their slug
   151→   * AC: @agent-definitions ac-agent-3
   152→   */
   153→  private indexMetaItem(item: LoadedMetaItem): void {
   154→    const ulid = item._ulid;
   155→
   156→    // Index by ULID
   157→    this.ulidIndex.set(ulid, item);
   158→    this.allUlids.push(ulid);
   159→
   160→    // Index by id (acts like a slug for meta items)
   161→    const metaItem = item as { id?: string };
   162→    if (metaItem.id) {
   163→      const existing = this.slugIndex.get(metaItem.id);
   164→      if (existing) {
   165→        existing.push(ulid);
   166→      } else {
   167→        this.slugIndex.set(metaItem.id, [ulid]);
   168→      }
   169→    }
   170→  }
   171→
   172→  /**
   173→   * Resolve a reference to an item.
   174→   *
   175→   * Resolution order:
   176→   * 1. Exact slug match
   177→   * 2. Full ULID match
   178→   * 3. ULID prefix match (must be unique)
   179→   */
   180→  resolve(ref: string): ResolveResult {
   181→    // Strip @ prefix if present
   182→    const cleanRef = ref.startsWith('@') ? ref.slice(1) : ref;
   183→    const cleanRefLower = cleanRef.toLowerCase();
   184→
   185→    // 1. Try slug match first
   186→    const slugMatches = this.slugIndex.get(cleanRef);
   187→    if (slugMatches) {
   188→      if (slugMatches.length > 1) {
   189→        return {
   190→          ok: false,
   191→          error: 'duplicate_slug',
   192→          ref,
   193→          candidates: slugMatches,
   194→        };
   195→      }
   196→      const ulid = slugMatches[0];
   197→      const item = this.ulidIndex.get(ulid)!;
   198→      return { ok: true, ulid, item, matchType: 'slug' };
   199→    }
   200→
   201→    // 2. Try full ULID match
   202→    const exactMatch = this.ulidIndex.get(cleanRef.toUpperCase());
   203→    if (exactMatch) {
   204→      return {
   205→        ok: true,
   206→        ulid: exactMatch._ulid,
   207→        item: exactMatch,
   208→        matchType: 'ulid-full',
   209→      };
   210→    }
   211→
   212→    // 3. Try ULID prefix match
   213→    const prefixMatches = this.allUlids.filter(ulid =>
   214→      ulid.toLowerCase().startsWith(cleanRefLower)
   215→    );
   216→
   217→    if (prefixMatches.length === 0) {
   218→      return { ok: false, error: 'not_found', ref };
   219→    }
   220→
   221→    if (prefixMatches.length > 1) {
   222→      return {
   223→        ok: false,
   224→        error: 'ambiguous',
   225→        ref,
   226→        candidates: prefixMatches,
   227→      };
   228→    }
   229→
   230→    const ulid = prefixMatches[0];
   231→    const item = this.ulidIndex.get(ulid)!;
   232→    return { ok: true, ulid, item, matchType: 'ulid-prefix' };
   233→  }
   234→
   235→  /**
   236→   * Get an item by exact ULID (no resolution, direct lookup)
   237→   */
   238→  getByUlid(ulid: string): AnyLoadedItem | LoadedMetaItem | undefined {
   239→    return this.ulidIndex.get(ulid);
   240→  }
   241→
   242→  /**
   243→   * Get the minimum unique prefix for a ULID.
   244→   * Returns the shortest prefix that uniquely identifies this ULID
   245→   * among all indexed items.
   246→   *
   247→   * @param ulid The full ULID to shorten
   248→   * @param minLength Minimum prefix length (default 8)
   249→   * @returns Shortest unique prefix
   250→   */
   251→  shortUlid(ulid: string, minLength = 8): string {
   252→    // Start with minimum length
   253→    let length = minLength;
   254→
   255→    while (length < ulid.length) {
   256→      const prefix = ulid.slice(0, length);
   257→      const matches = this.allUlids.filter(u =>
   258→        u.toUpperCase().startsWith(prefix.toUpperCase())
   259→      );
   260→
   261→      if (matches.length === 1) {
   262→        return prefix;
   263→      }
   264→
   265→      length++;
   266→    }
   267→
   268→    // Return full ULID if no shorter unique prefix found
   269→    return ulid;
   270→  }
   271→
   272→  /**
   273→   * Get all indexed ULIDs
   274→   */
   275→  getAllUlids(): string[] {
   276→    return [...this.allUlids];
   277→  }
   278→
   279→  /**
   280→   * Get all slugs and their mappings
   281→   */
   282→  getAllSlugs(): Map<string, string[]> {
   283→    return new Map(this.slugIndex);
   284→  }
   285→
   286→  /**
   287→   * Check if a slug exists
   288→   */
   289→  hasSlug(slug: string): boolean {
   290→    return this.slugIndex.has(slug);
   291→  }
   292→
   293→  /**
   294→   * Get count of indexed items
   295→   */
   296→  get size(): number {
   297→    return this.ulidIndex.size;
   298→  }
   299→}
   300→
   301→// ============================================================
   302→// VALIDATION
   303→// ============================================================
   304→
   305→/**
   306→ * Fields that contain references
   307→ * AC: @agent-definitions ac-agent-3 - added_by for agent references
   308→ * AC: @workflow-definitions ac-workflow-3 - meta_ref for workflow references
   309→ */
   310→const REF_FIELDS = [
   311→  'depends_on',
   312→  'blocked_by',
   313→  'implements',
   314→  'relates_to',
   315→  'tests',
   316→  'supersedes',
   317→  'spec_ref',
   318→  'context',
   319→  'added_by', // Agent reference
   320→  'author', // Agent reference
   321→  'resolved_by', // Agent reference
   322→  'workflow_ref', // Workflow reference
   323→  'meta_ref', // Meta reference (workflow, agent, convention)
   324→];
   325→
   326→/**
   327→ * Extract all references from an item
   328→ * AC: @agent-definitions ac-agent-3 - also checks nested notes for author refs
   329→ */
   330→function extractRefs(item: AnyLoadedItem): Array<{ field: string; ref: string }> {
   331→  const refs: Array<{ field: string; ref: string }> = [];
   332→  const obj = item as unknown as Record<string, unknown>;
   333→
   334→  for (const field of REF_FIELDS) {
   335→    const value = obj[field];
   336→
   337→    if (typeof value === 'string' && value.startsWith('@')) {
   338→      refs.push({ field, ref: value });
   339→    } else if (Array.isArray(value)) {
   340→      for (const v of value) {
   341→        if (typeof v === 'string' && v.startsWith('@')) {
   342→          refs.push({ field, ref: v });
   343→        }
   344→      }
   345→    }
   346→  }
   347→
   348→  // Check nested notes for author references
   349→  // AC: @agent-definitions ac-agent-3
   350→  if ('notes' in obj && Array.isArray(obj.notes)) {
   351→    for (const note of obj.notes) {
   352→      if (note && typeof note === 'object' && 'author' in note) {
   353→        const author = (note as { author?: string }).author;
   354→        if (typeof author === 'string' && author.startsWith('@')) {
   355→          refs.push({ field: 'notes[].author', ref: author });
   356→        }
   357→      }
   358→    }
   359→  }
   360→
   361→  // Check nested todos for added_by references
   362→  if ('todos' in obj && Array.isArray(obj.todos)) {
   363→    for (const todo of obj.todos) {
   364→      if (todo && typeof todo === 'object' && 'added_by' in todo) {
   365→        const addedBy = (todo as { added_by?: string }).added_by;
   366→        if (typeof addedBy === 'string' && addedBy.startsWith('@')) {
   367→          refs.push({ field: 'todos[].added_by', ref: addedBy });
   368→        }
   369→      }
   370→    }
   371→  }
   372→
   373→  return refs;
   374→}
   375→
   376→/**
   377→ * Validate all references in the spec.
   378→ * Returns list of validation errors.
   379→ */
   380→export function validateRefs(
   381→  index: ReferenceIndex,
   382→  tasks: LoadedTask[],
   383→  items: LoadedSpecItem[]
   384→): RefValidationError[] {
   385→  const errors: RefValidationError[] = [];
   386→
   387→  const allItems: AnyLoadedItem[] = [...tasks, ...items];
   388→
   389→  for (const item of allItems) {
   390→    const refs = extractRefs(item);
   391→    const sourceFile = (item as LoadedTask | LoadedSpecItem)._sourceFile;
   392→
   393→    for (const { field, ref } of refs) {
   394→      const result = index.resolve(ref);
   395→
   396→      if (!result.ok) {
   397→        let message: string;
   398→
   399→        switch (result.error) {
   400→          case 'not_found':
   401→            message = `Reference "${ref}" not found`;
   402→            break;
   403→          case 'ambiguous':
   404→            message = `Reference "${ref}" is ambiguous, matches: ${result.candidates.join(', ')}`;
   405→            break;
   406→          case 'duplicate_slug':
   407→            message = `Slug "${ref}" maps to multiple items: ${result.candidates.join(', ')}`;
   408→            break;
   409→        }
   410→
   411→        errors.push({
   412→          ref,
   413→          sourceFile,
   414→          sourceUlid: item._ulid,
   415→          field,
   416→          error: result.error,
   417→          message,
   418→        });
   419→      }
   420→    }
   421→  }
   422→
   423→  return errors;
   424→}
   425→
   426→/**
   427→ * Find duplicate slugs in the index.
   428→ * Returns map of slug → ULIDs for slugs with multiple items.
   429→ */
   430→export function findDuplicateSlugs(index: ReferenceIndex): Map<string, string[]> {
   431→  const duplicates = new Map<string, string[]>();
   432→
   433→  for (const [slug, ulids] of index.getAllSlugs()) {
   434→    if (ulids.length > 1) {
   435→      duplicates.set(slug, ulids);
   436→    }
   437→  }
   438→
   439→  return duplicates;
   440→}
   441→
   442→// ============================================================
   443→// SLUG UNIQUENESS CHECK
   444→// ============================================================
   445→
   446→/**
   447→ * Result of checking slug uniqueness
   448→ */
   449→export interface SlugCheckSuccess {
   450→  ok: true;
   451→}
   452→
   453→export interface SlugCheckConflict {
   454→  ok: false;
   455→  slug: string;
   456→  existingUlid: string;
   457→}
   458→
   459→export type SlugCheckResult = SlugCheckSuccess | SlugCheckConflict;
   460→
   461→/**
   462→ * Check if proposed slugs are unique (don't conflict with existing items).
   463→ *
   464→ * @param index The reference index to check against
   465→ * @param slugs Array of proposed slugs to check
   466→ * @param excludeUlid Optional ULID to exclude from conflict check (for updates)
   467→ * @returns Success if all slugs are available, or conflict info if one exists
   468→ */
   469→export function checkSlugUniqueness(
   470→  index: ReferenceIndex,
   471→  slugs: string[],
   472→  excludeUlid?: string
   473→): SlugCheckResult {
   474→  const allSlugs = index.getAllSlugs();
   475→
   476→  for (const slug of slugs) {
   477→    const existingUlids = allSlugs.get(slug);
   478→    if (existingUlids) {
   479→      // Filter out the item being updated (if provided)
   480→      const conflictingUlids = excludeUlid
   481→        ? existingUlids.filter(ulid => ulid !== excludeUlid)
   482→        : existingUlids;
   483→
   484→      if (conflictingUlids.length > 0) {
   485→        return {
   486→          ok: false,
   487→          slug,
   488→          existingUlid: conflictingUlids[0],
   489→        };
   490→      }
   491→    }
   492→  }
   493→
   494→  return { ok: true };
   495→}
   496→

