```
     1→/**
     2→ * Validation module for kspec files.
     3→ *
     4→ * Provides schema validation, reference validation, and orphan detection.
     5→ */
     6→
     7→import * as fs from 'node:fs/promises';
     8→import * as path from 'node:path';
     9→import {
    10→  TaskSchema,
    11→  TasksFileSchema,
    12→  ManifestSchema,
    13→  SpecItemSchema,
    14→  MetaManifestSchema,
    15→  AgentSchema,
    16→  WorkflowSchema,
    17→  ConventionSchema,
    18→  ObservationSchema,
    19→  UlidSchema,
    20→} from '../schema/index.js';
    21→import type { KspecContext, LoadedTask, LoadedSpecItem } from './yaml.js';
    22→import {
    23→  readYamlFile,
    24→  findTaskFiles,
    25→  loadSpecFile,
    26→  expandIncludePattern,
    27→} from './yaml.js';
    28→import { ReferenceIndex, validateRefs, type RefValidationError, type RefValidationWarning } from './refs.js';
    29→import { findMetaManifest, loadMetaContext, type MetaContext } from './meta.js';
    30→
    31→// ============================================================
    32→// TYPES
    33→// ============================================================
    34→
    35→/**
    36→ * Schema validation error
    37→ */
    38→export interface SchemaValidationError {
    39→  file: string;
    40→  path?: string;
    41→  message: string;
    42→  details?: unknown;
    43→}
    44→
    45→/**
    46→ * Orphan item (not referenced by anything)
    47→ */
    48→export interface OrphanItem {
    49→  ulid: string;
    50→  title: string;
    51→  type: string;
    52→  file?: string;
    53→}
    54→
    55→/**
    56→ * Completeness warning types
    57→ */
    58→export type CompletenessWarningType =
    59→  | 'missing_acceptance_criteria'
    60→  | 'missing_description'
    61→  | 'status_inconsistency';
    62→
    63→/**
    64→ * Completeness warning
    65→ */
    66→export interface CompletenessWarning {
    67→  type: CompletenessWarningType;
    68→  itemRef: string;
    69→  itemTitle: string;
    70→  message: string;
    71→  details?: string;
    72→}
    73→
    74→/**
    75→ * Complete validation result
    76→ */
    77→export interface ValidationResult {
    78→  valid: boolean;
    79→  schemaErrors: SchemaValidationError[];
    80→  refErrors: RefValidationError[];
    81→  refWarnings: RefValidationWarning[];
    82→  orphans: OrphanItem[];
    83→  completenessWarnings: CompletenessWarning[];
    84→  stats: {
    85→    filesChecked: number;
    86→    itemsChecked: number;
    87→    tasksChecked: number;
    88→  };
    89→  metaStats?: {
    90→    agents: number;
    91→    workflows: number;
    92→    conventions: number;
    93→    observations: number;
    94→  };
    95→}
    96→
    97→/**
    98→ * Validation options
    99→ */
   100→export interface ValidateOptions {
   101→  /** Check schema conformance */
   102→  schema?: boolean;
   103→  /** Check reference resolution */
   104→  refs?: boolean;
   105→  /** Find orphaned items */
   106→  orphans?: boolean;
   107→  /** Check spec completeness (missing AC, descriptions, status inconsistencies) */
   108→  completeness?: boolean;
   109→}
   110→
   111→// ============================================================
   112→// SCHEMA VALIDATION
   113→// ============================================================
   114→
   115→/**
   116→ * Validate a manifest file against schema
   117→ */
   118→async function validateManifestFile(filePath: string): Promise<SchemaValidationError[]> {
   119→  const errors: SchemaValidationError[] = [];
   120→
   121→  try {
   122→    const raw = await readYamlFile<unknown>(filePath);
   123→    const result = ManifestSchema.safeParse(raw);
   124→
   125→    if (!result.success) {
   126→      for (const issue of result.error.issues) {
   127→        errors.push({
   128→          file: filePath,
   129→          path: issue.path.join('.'),
   130→          message: issue.message,
   131→          details: issue,
   132→        });
   133→      }
   134→    }
   135→  } catch (err) {
   136→    errors.push({
   137→      file: filePath,
   138→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   139→    });
   140→  }
   141→
   142→  return errors;
   143→}
   144→
   145→/**
   146→ * Validate a tasks file against schema
   147→ */
   148→async function validateTasksFile(filePath: string): Promise<SchemaValidationError[]> {
   149→  const errors: SchemaValidationError[] = [];
   150→
   151→  try {
   152→    const raw = await readYamlFile<unknown>(filePath);
   153→
   154→    // Handle both formats: { tasks: [...] } and plain array
   155→    let taskList: unknown[];
   156→
   157→    if (Array.isArray(raw)) {
   158→      taskList = raw;
   159→    } else if (raw && typeof raw === 'object' && 'tasks' in raw) {
   160→      // Try full TasksFile schema first
   161→      const fileResult = TasksFileSchema.safeParse(raw);
   162→      if (!fileResult.success) {
   163→        // If TasksFile fails, just validate individual tasks
   164→        taskList = (raw as { tasks: unknown[] }).tasks || [];
   165→      } else {
   166→        // File schema passed, validate individual tasks for detailed errors
   167→        taskList = fileResult.data.tasks;
   168→      }
   169→    } else {
   170→      errors.push({
   171→        file: filePath,
   172→        message: 'Invalid tasks file format: expected array or { tasks: [...] }',
   173→      });
   174→      return errors;
   175→    }
   176→
   177→    // Validate each task
   178→    for (let i = 0; i < taskList.length; i++) {
   179→      const task = taskList[i];
   180→      const result = TaskSchema.safeParse(task);
   181→
   182→      if (!result.success) {
   183→        for (const issue of result.error.issues) {
   184→          errors.push({
   185→            file: filePath,
   186→            path: `tasks[${i}].${issue.path.join('.')}`,
   187→            message: issue.message,
   188→            details: issue,
   189→          });
   190→        }
   191→      }
   192→    }
   193→  } catch (err) {
   194→    errors.push({
   195→      file: filePath,
   196→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   197→    });
   198→  }
   199→
   200→  return errors;
   201→}
   202→
   203→/**
   204→ * Validate a spec module file against schema
   205→ */
   206→async function validateSpecFile(filePath: string): Promise<SchemaValidationError[]> {
   207→  const errors: SchemaValidationError[] = [];
   208→
   209→  try {
   210→    const raw = await readYamlFile<unknown>(filePath);
   211→
   212→    // Recursively validate spec items
   213→    validateSpecItemRecursive(raw, filePath, '', errors);
   214→  } catch (err) {
   215→    errors.push({
   216→      file: filePath,
   217→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   218→    });
   219→  }
   220→
   221→  return errors;
   222→}
   223→
   224→/**
   225→ * Validate meta manifest file with strict ULID validation
   226→ * AC-meta-manifest-3: Invalid schema exits with code 1 and shows field path + expected type
   227→ */
   228→async function validateMetaManifestFile(filePath: string): Promise<SchemaValidationError[]> {
   229→  const errors: SchemaValidationError[] = [];
   230→
   231→  try {
   232→    const raw = await readYamlFile<unknown>(filePath);
   233→
   234→    // Validate overall manifest structure
   235→    const manifestResult = MetaManifestSchema.safeParse(raw);
   236→    if (!manifestResult.success) {
   237→      for (const issue of manifestResult.error.issues) {
   238→        errors.push({
   239→          file: filePath,
   240→          path: issue.path.join('.'),
   241→          message: issue.message,
   242→          details: issue,
   243→        });
   244→      }
   245→      return errors;
   246→    }
   247→
   248→    // Validate each agent with strict ULID validation
   249→    if (raw && typeof raw === 'object' && 'agents' in raw && Array.isArray((raw as Record<string, unknown>).agents)) {
   250→      const agents = (raw as Record<string, unknown>).agents as unknown[];
   251→      for (let i = 0; i < agents.length; i++) {
   252→        const agent = agents[i];
   253→        const agentResult = AgentSchema.safeParse(agent);
   254→        if (!agentResult.success) {
   255→          for (const issue of agentResult.error.issues) {
   256→            errors.push({
   257→              file: filePath,
   258→              path: `agents[${i}].${issue.path.join('.')}`,
   259→              message: issue.message,
   260→              details: issue,
   261→            });
   262→          }
   263→        }
   264→
   265→        // Strict ULID validation
   266→        if (agent && typeof agent === 'object' && '_ulid' in agent) {
   267→          const ulidResult = UlidSchema.safeParse((agent as Record<string, unknown>)._ulid);
   268→          if (!ulidResult.success) {
   269→            errors.push({
   270→              file: filePath,
   271→              path: `agents[${i}]._ulid`,
   272→              message: 'Invalid ULID format (expected 26 characters)',
   273→            });
   274→          }
   275→        }
   276→      }
   277→    }
   278→
   279→    // Validate each workflow with strict ULID validation
   280→    if (raw && typeof raw === 'object' && 'workflows' in raw && Array.isArray((raw as Record<string, unknown>).workflows)) {
   281→      const workflows = (raw as Record<string, unknown>).workflows as unknown[];
   282→      for (let i = 0; i < workflows.length; i++) {
   283→        const workflow = workflows[i];
   284→        const workflowResult = WorkflowSchema.safeParse(workflow);
   285→        if (!workflowResult.success) {
   286→          for (const issue of workflowResult.error.issues) {
   287→            errors.push({
   288→              file: filePath,
   289→              path: `workflows[${i}].${issue.path.join('.')}`,
   290→              message: issue.message,
   291→              details: issue,
   292→            });
   293→          }
   294→        }
   295→
   296→        // Strict ULID validation
   297→        if (workflow && typeof workflow === 'object' && '_ulid' in workflow) {
   298→          const ulidResult = UlidSchema.safeParse((workflow as Record<string, unknown>)._ulid);
   299→          if (!ulidResult.success) {
   300→            errors.push({
   301→              file: filePath,
   302→              path: `workflows[${i}]._ulid`,
   303→              message: 'Invalid ULID format (expected 26 characters)',
   304→            });
   305→          }
   306→        }
   307→      }
   308→    }
   309→
   310→    // Validate each convention with strict ULID validation
   311→    if (raw && typeof raw === 'object' && 'conventions' in raw && Array.isArray((raw as Record<string, unknown>).conventions)) {
   312→      const conventions = (raw as Record<string, unknown>).conventions as unknown[];
   313→      for (let i = 0; i < conventions.length; i++) {
   314→        const convention = conventions[i];
   315→        const conventionResult = ConventionSchema.safeParse(convention);
   316→        if (!conventionResult.success) {
   317→          for (const issue of conventionResult.error.issues) {
   318→            errors.push({
   319→              file: filePath,
   320→              path: `conventions[${i}].${issue.path.join('.')}`,
   321→              message: issue.message,
   322→              details: issue,
   323→            });
   324→          }
   325→        }
   326→
   327→        // Strict ULID validation
   328→        if (convention && typeof convention === 'object' && '_ulid' in convention) {
   329→          const ulidResult = UlidSchema.safeParse((convention as Record<string, unknown>)._ulid);
   330→          if (!ulidResult.success) {
   331→            errors.push({
   332→              file: filePath,
   333→              path: `conventions[${i}]._ulid`,
   334→              message: 'Invalid ULID format (expected 26 characters)',
   335→            });
   336→          }
   337→        }
   338→      }
   339→    }
   340→
   341→    // Validate each observation with strict ULID validation
   342→    if (raw && typeof raw === 'object' && 'observations' in raw && Array.isArray((raw as Record<string, unknown>).observations)) {
   343→      const observations = (raw as Record<string, unknown>).observations as unknown[];
   344→      for (let i = 0; i < observations.length; i++) {
   345→        const observation = observations[i];
   346→        const observationResult = ObservationSchema.safeParse(observation);
   347→        if (!observationResult.success) {
   348→          for (const issue of observationResult.error.issues) {
   349→            errors.push({
   350→              file: filePath,
   351→              path: `observations[${i}].${issue.path.join('.')}`,
   352→              message: issue.message,
   353→              details: issue,
   354→            });
   355→          }
   356→        }
   357→
   358→        // Strict ULID validation
   359→        if (observation && typeof observation === 'object' && '_ulid' in observation) {
   360→          const ulidResult = UlidSchema.safeParse((observation as Record<string, unknown>)._ulid);
   361→          if (!ulidResult.success) {
   362→            errors.push({
   363→              file: filePath,
   364→              path: `observations[${i}]._ulid`,
   365→              message: 'Invalid ULID format (expected 26 characters)',
   366→            });
   367→          }
   368→        }
   369→      }
   370→    }
   371→  } catch (err) {
   372→    errors.push({
   373→      file: filePath,
   374→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   375→    });
   376→  }
   377→
   378→  return errors;
   379→}
   380→
   381→/**
   382→ * Recursively validate spec items in a structure
   383→ */
   384→function validateSpecItemRecursive(
   385→  raw: unknown,
   386→  file: string,
   387→  pathPrefix: string,
   388→  errors: SchemaValidationError[]
   389→): void {
   390→  if (!raw || typeof raw !== 'object') return;
   391→
   392→  // Check if this is a spec item (has _ulid)
   393→  if ('_ulid' in raw) {
   394→    const result = SpecItemSchema.safeParse(raw);
   395→    if (!result.success) {
   396→      for (const issue of result.error.issues) {
   397→        errors.push({
   398→          file,
   399→          path: pathPrefix ? `${pathPrefix}.${issue.path.join('.')}` : issue.path.join('.'),
   400→          message: issue.message,
   401→          details: issue,
   402→        });
   403→      }
   404→    }
   405→  }
   406→
   407→  // Recurse into nested structures
   408→  const nestedFields = ['modules', 'features', 'requirements', 'constraints', 'decisions', 'items'];
   409→  const obj = raw as Record<string, unknown>;
   410→
   411→  for (const field of nestedFields) {
   412→    if (field in obj && Array.isArray(obj[field])) {
   413→      const arr = obj[field] as unknown[];
   414→      for (let i = 0; i < arr.length; i++) {
   415→        const newPath = pathPrefix ? `${pathPrefix}.${field}[${i}]` : `${field}[${i}]`;
   416→        validateSpecItemRecursive(arr[i], file, newPath, errors);
   417→      }
   418→    }
   419→  }
   420→}
   421→
   422→// ============================================================
   423→// ORPHAN DETECTION
   424→// ============================================================
   425→
   426→/**
   427→ * Find items that are not referenced by any other item
   428→ */
   429→function findOrphans(
   430→  tasks: LoadedTask[],
   431→  items: LoadedSpecItem[],
   432→  index: ReferenceIndex
   433→): OrphanItem[] {
   434→  const orphans: OrphanItem[] = [];
   435→
   436→  // Build set of all referenced ULIDs
   437→  const referenced = new Set<string>();
   438→
   439→  const allItems = [...tasks, ...items];
   440→
   441→  // Fields that contain references
   442→  const refFields = [
   443→    'depends_on',
   444→    'blocked_by',
   445→    'implements',
   446→    'relates_to',
   447→    'tests',
   448→    'supersedes',
   449→    'spec_ref',
   450→    'context',
   451→  ];
   452→
   453→  for (const item of allItems) {
   454→    const obj = item as unknown as Record<string, unknown>;
   455→
   456→    for (const field of refFields) {
   457→      const value = obj[field];
   458→
   459→      if (typeof value === 'string' && value.startsWith('@')) {
   460→        const resolved = index.resolve(value);
   461→        if (resolved.ok) {
   462→          referenced.add(resolved.ulid);
   463→        }
   464→      } else if (Array.isArray(value)) {
   465→        for (const v of value) {
   466→          if (typeof v === 'string' && v.startsWith('@')) {
   467→            const resolved = index.resolve(v);
   468→            if (resolved.ok) {
   469→              referenced.add(resolved.ulid);
   470→            }
   471→          }
   472→        }
   473→      }
   474→    }
   475→  }
   476→
   477→  // Find items not in the referenced set
   478→  // Skip entry point types: modules are spec entry points, tasks are work items
   479→  const entryPointTypes = ['module', 'task', 'epic', 'bug', 'spike', 'infra'];
   480→
   481→  for (const item of items) {
   482→    // Only check spec items, not tasks
   483→    if (!referenced.has(item._ulid)) {
   484→      // Skip entry point types
   485→      if (entryPointTypes.includes(item.type || '')) continue;
   486→
   487→      // Skip nested items - they're implicitly referenced by their parent
   488→      // _path indicates nesting (e.g., "features[0].requirements[2]")
   489→      if (item._path) continue;
   490→
   491→      orphans.push({
   492→        ulid: item._ulid,
   493→        title: item.title,
   494→        type: item.type || 'unknown',
   495→        file: item._sourceFile,
   496→      });
   497→    }
   498→  }
   499→
   500→  return orphans;
   501→}
   502→
   503→// ============================================================
   504→// COMPLETENESS VALIDATION
   505→// ============================================================
   506→
   507→/**
   508→ * Check spec items for completeness
   509→ * AC: @spec-completeness ac-1, ac-2, ac-3
   510→ */
   511→function checkCompleteness(
   512→  items: LoadedSpecItem[],
   513→  index: ReferenceIndex
   514→): CompletenessWarning[] {
   515→  const warnings: CompletenessWarning[] = [];
   516→
   517→  for (const item of items) {
   518→    const itemRef = item.slugs?.[0] ? `@${item.slugs[0]}` : `@${item._ulid.slice(0, 8)}`;
   519→
   520→    // AC: @spec-completeness ac-1
   521→    // Check for missing acceptance criteria
   522→    if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
   523→      warnings.push({
   524→        type: 'missing_acceptance_criteria',
   525→        itemRef,
   526→        itemTitle: item.title,
   527→        message: `Item ${itemRef} has no acceptance criteria`,
   528→      });
   529→    }
   530→
   531→    // AC: @spec-completeness ac-2
   532→    // Check for missing description
   533→    if (!item.description || item.description.trim() === '') {
   534→      warnings.push({
   535→        type: 'missing_description',
   536→        itemRef,
   537→        itemTitle: item.title,
   538→        message: `Item ${itemRef} has no description`,
   539→      });
   540→    }
   541→
   542→    // AC: @spec-completeness ac-3
   543→    // Check for status inconsistency between parent and children
   544→    if (item.status?.implementation === 'implemented') {
   545→      // Check if this item has children with not_started status
   546→      const childFields = [
   547→        'modules',
   548→        'features',
   549→        'requirements',
   550→        'constraints',
   551→        'epics',
   552→        'themes',
   553→        'capabilities',
   554→      ];
   555→
   556→      for (const field of childFields) {
   557→        const children = (item as any)[field];
   558→        if (Array.isArray(children)) {
   559→          for (const child of children) {
   560→            if (child.status?.implementation === 'not_started') {
   561→              const childRef = child.slugs?.[0]
   562→                ? `@${child.slugs[0]}`
   563→                : `@${child._ulid?.slice(0, 8) || 'unknown'}`;
   564→              warnings.push({
   565→                type: 'status_inconsistency',
   566→                itemRef,
   567→                itemTitle: item.title,
   568→                message: `Parent ${itemRef} is implemented but child ${childRef} is not_started`,
   569→                details: `Child: ${child.title}`,
   570→              });
   571→            }
   572→          }
   573→        }
   574→      }
   575→    }
   576→  }
   577→
   578→  return warnings;
   579→}
   580→
   581→// ============================================================
   582→// MAIN VALIDATION
   583→// ============================================================
   584→
   585→/**
   586→ * Run full validation on a kspec project
   587→ */
   588→export async function validate(
   589→  ctx: KspecContext,
   590→  options: ValidateOptions = {}
   591→): Promise<ValidationResult> {
   592→  // Default: run all checks
   593→  const runSchema = options.schema !== false;
   594→  const runRefs = options.refs !== false;
   595→  const runOrphans = options.orphans !== false;
   596→  const runCompleteness = options.completeness !== false;
   597→
   598→  const result: ValidationResult = {
   599→    valid: true,
   600→    schemaErrors: [],
   601→    refErrors: [],
   602→    refWarnings: [],
   603→    orphans: [],
   604→    completenessWarnings: [],
   605→    stats: {
   606→      filesChecked: 0,
   607→      itemsChecked: 0,
   608→      tasksChecked: 0,
   609→    },
   610→  };
   611→
   612→  const allTasks: LoadedTask[] = [];
   613→  const allItems: LoadedSpecItem[] = [];
   614→
   615→  // Validate manifest
   616→  if (ctx.manifestPath && runSchema) {
   617→    const manifestErrors = await validateManifestFile(ctx.manifestPath);
   618→    result.schemaErrors.push(...manifestErrors);
   619→    result.stats.filesChecked++;
   620→  }
   621→
   622→  // Find and validate task files
   623→  const taskFiles = await findTaskFiles(ctx.rootDir);
   624→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, 'spec'));
   625→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
   626→
   627→  for (const taskFile of allTaskFiles) {
   628→    if (runSchema) {
   629→      const taskErrors = await validateTasksFile(taskFile);
   630→      result.schemaErrors.push(...taskErrors);
   631→    }
   632→    result.stats.filesChecked++;
   633→
   634→    // Load tasks for ref validation
   635→    try {
   636→      const raw = await readYamlFile<unknown>(taskFile);
   637→      let taskList: unknown[] = [];
   638→
   639→      if (Array.isArray(raw)) {
   640→        taskList = raw;
   641→      } else if (raw && typeof raw === 'object' && 'tasks' in raw) {
   642→        taskList = (raw as { tasks: unknown[] }).tasks || [];
   643→      }
   644→
   645→      for (const t of taskList) {
   646→        const parsed = TaskSchema.safeParse(t);
   647→        if (parsed.success) {
   648→          allTasks.push({ ...parsed.data, _sourceFile: taskFile });
   649→          result.stats.tasksChecked++;
   650→        }
   651→      }
   652→    } catch {
   653→      // Already reported in schema validation
   654→    }
   655→  }
   656→
   657→  // Validate spec files (from includes)
   658→  if (ctx.manifest && ctx.manifestPath) {
   659→    const manifestDir = path.dirname(ctx.manifestPath);
   660→    const includes = ctx.manifest.includes || [];
   661→
   662→    for (const include of includes) {
   663→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   664→
   665→      for (const filePath of expandedPaths) {
   666→        if (runSchema) {
   667→          const specErrors = await validateSpecFile(filePath);
   668→          result.schemaErrors.push(...specErrors);
   669→        }
   670→        result.stats.filesChecked++;
   671→
   672→        // Load items for ref validation
   673→        try {
   674→          const items = await loadSpecFile(filePath);
   675→          allItems.push(...items);
   676→          result.stats.itemsChecked += items.length;
   677→        } catch {
   678→          // Already reported in schema validation
   679→        }
   680→      }
   681→    }
   682→  }
   683→
   684→  // Load meta items for reference validation
   685→  // AC: @agent-definitions ac-agent-3
   686→  const metaCtx = await loadMetaContext(ctx);
   687→  const allMetaItems = [
   688→    ...metaCtx.agents,
   689→    ...metaCtx.workflows,
   690→    ...metaCtx.conventions,
   691→    ...metaCtx.observations,
   692→  ];
   693→
   694→  // Reference validation
   695→  if (runRefs && (allTasks.length > 0 || allItems.length > 0 || allMetaItems.length > 0)) {
   696→    const index = new ReferenceIndex(allTasks, allItems, allMetaItems);
   697→    const refResult = validateRefs(index, allTasks, allItems);
   698→    result.refErrors = refResult.errors;
   699→    result.refWarnings = refResult.warnings;
   700→
   701→    // Orphan detection
   702→    if (runOrphans) {
   703→      result.orphans = findOrphans(allTasks, allItems, index);
   704→    }
   705→
   706→    // Completeness validation
   707→    // AC: @spec-completeness ac-1, ac-2, ac-3
   708→    if (runCompleteness) {
   709→      result.completenessWarnings = checkCompleteness(allItems, index);
   710→    }
   711→  }
   712→
   713→  // Meta manifest validation (AC-meta-manifest-2, AC-meta-manifest-3)
   714→  const metaManifestPath = await findMetaManifest(ctx.specDir);
   715→  if (metaManifestPath) {
   716→    // Use metaCtx already loaded above
   717→    result.metaStats = {
   718→      agents: metaCtx.agents.length,
   719→      workflows: metaCtx.workflows.length,
   720→      conventions: metaCtx.conventions.length,
   721→      observations: metaCtx.observations.length,
   722→    };
   723→
   724→    // Validate meta manifest schema with strict ULID validation
   725→    if (runSchema) {
   726→      const metaErrors = await validateMetaManifestFile(metaManifestPath);
   727→      // Prefix all meta errors with "meta:"
   728→      for (const err of metaErrors) {
   729→        err.path = err.path ? `meta:${err.path}` : 'meta:';
   730→      }
   731→      result.schemaErrors.push(...metaErrors);
   732→      result.stats.filesChecked++;
   733→    }
   734→  }
   735→
   736→  // Set valid flag
   737→  result.valid = result.schemaErrors.length === 0 && result.refErrors.length === 0;
   738→
   739→  return result;
   740→}
   741→

