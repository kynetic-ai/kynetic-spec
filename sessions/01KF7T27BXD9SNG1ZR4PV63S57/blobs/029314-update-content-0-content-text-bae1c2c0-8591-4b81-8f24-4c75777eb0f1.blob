```
     1→/**
     2→ * Meta CLI commands for interacting with meta-spec.
     3→ *
     4→ * AC-meta-manifest-1: kspec meta show outputs summary
     5→ * AC-meta-manifest-2: kspec validate includes meta line
     6→ * AC-meta-manifest-3: kspec validate shows meta errors with prefix
     7→ * AC-agent-1: kspec meta agents outputs table
     8→ * AC-agent-2: kspec meta agents --json outputs JSON
     9→ */
    10→
    11→import { Command } from 'commander';
    12→import chalk from 'chalk';
    13→import Table from 'cli-table3';
    14→import { ulid } from 'ulid';
    15→import {
    16→  initContext,
    17→  loadMetaContext,
    18→  getMetaStats,
    19→  createObservation,
    20→  saveObservation,
    21→  saveMetaItem,
    22→  deleteMetaItem,
    23→  createTask,
    24→  saveTask,
    25→  loadAllTasks,
    26→  type MetaContext,
    27→  type Agent,
    28→  type Workflow,
    29→  type Convention,
    30→  type Observation,
    31→} from '../../parser/index.js';
    32→import { type ObservationType } from '../../schema/index.js';
    33→import { output, error, success, isJsonMode } from '../output.js';
    34→import { errors } from '../../strings/errors.js';
    35→
    36→/**
    37→ * Resolve a meta reference to its ULID
    38→ * Handles semantic IDs (agent.id, workflow.id, convention.domain) and ULID prefixes
    39→ */
    40→function resolveMetaRefToUlid(
    41→  ref: string,
    42→  metaCtx: MetaContext
    43→): { ulid: string; type: 'agent' | 'workflow' | 'convention' | 'observation' } | null {
    44→  const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
    45→
    46→  // Check agents
    47→  const agent = (metaCtx.agents || []).find(
    48→    (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
    49→  );
    50→  if (agent) return { ulid: agent._ulid, type: 'agent' };
    51→
    52→  // Check workflows
    53→  const workflow = (metaCtx.workflows || []).find(
    54→    (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
    55→  );
    56→  if (workflow) return { ulid: workflow._ulid, type: 'workflow' };
    57→
    58→  // Check conventions
    59→  const convention = (metaCtx.conventions || []).find(
    60→    (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
    61→  );
    62→  if (convention) return { ulid: convention._ulid, type: 'convention' };
    63→
    64→  // Check observations
    65→  const observation = (metaCtx.observations || []).find((o) =>
    66→    o._ulid.startsWith(normalizedRef)
    67→  );
    68→  if (observation) return { ulid: observation._ulid, type: 'observation' };
    69→
    70→  return null;
    71→}
    72→
    73→/**
    74→ * Format meta show output
    75→ */
    76→function formatMetaShow(meta: MetaContext): void {
    77→  const stats = getMetaStats(meta);
    78→
    79→  if (!meta.manifest) {
    80→    console.log(chalk.yellow('No meta manifest found (kynetic.meta.yaml)'));
    81→    console.log(chalk.gray('Create one to define agents, workflows, conventions, and observations'));
    82→    return;
    83→  }
    84→
    85→  console.log(chalk.bold('Meta-Spec Summary'));
    86→  console.log(chalk.gray('─'.repeat(40)));
    87→  console.log(`Agents:       ${stats.agents}`);
    88→  console.log(`Workflows:    ${stats.workflows}`);
    89→  console.log(`Conventions:  ${stats.conventions}`);
    90→  console.log(`Observations: ${stats.observations} (${stats.unresolvedObservations} unresolved)`);
    91→}
    92→
    93→/**
    94→ * Format agents table output
    95→ * AC-agent-1: outputs table with columns: ID, Name, Capabilities
    96→ */
    97→function formatAgents(agents: Agent[]): void {
    98→  if (agents.length === 0) {
    99→    console.log(chalk.yellow('No agents defined'));
   100→    return;
   101→  }
   102→
   103→  const table = new Table({
   104→    head: [chalk.bold('ID'), chalk.bold('Name'), chalk.bold('Capabilities')],
   105→    style: {
   106→      head: [],
   107→      border: [],
   108→    },
   109→  });
   110→
   111→  for (const agent of agents) {
   112→    table.push([
   113→      agent.id,
   114→      agent.name,
   115→      agent.capabilities.join(', '),
   116→    ]);
   117→  }
   118→
   119→  console.log(table.toString());
   120→}
   121→
   122→/**
   123→ * Format workflows table output
   124→ * AC-workflow-1: outputs table with columns: ID, Trigger, Steps (count)
   125→ */
   126→function formatWorkflows(workflows: Workflow[]): void {
   127→  if (workflows.length === 0) {
   128→    console.log(chalk.yellow('No workflows defined'));
   129→    return;
   130→  }
   131→
   132→  const table = new Table({
   133→    head: [chalk.bold('ID'), chalk.bold('Trigger'), chalk.bold('Steps')],
   134→    style: {
   135→      head: [],
   136→      border: [],
   137→    },
   138→  });
   139→
   140→  for (const workflow of workflows) {
   141→    table.push([
   142→      workflow.id,
   143→      workflow.trigger,
   144→      workflow.steps.length.toString(),
   145→    ]);
   146→  }
   147→
   148→  console.log(table.toString());
   149→}
   150→
   151→/**
   152→ * Format workflows verbose output
   153→ * AC-workflow-2: outputs each workflow with full step list
   154→ */
   155→function formatWorkflowsVerbose(workflows: Workflow[]): void {
   156→  if (workflows.length === 0) {
   157→    console.log(chalk.yellow('No workflows defined'));
   158→    return;
   159→  }
   160→
   161→  for (const workflow of workflows) {
   162→    console.log(chalk.bold(`${workflow.id} - ${workflow.trigger}`));
   163→    if (workflow.description) {
   164→      console.log(chalk.gray(workflow.description));
   165→    }
   166→    console.log(chalk.gray('─'.repeat(60)));
   167→
   168→    for (const step of workflow.steps) {
   169→      const prefix = {
   170→        check: chalk.yellow('[check]'),
   171→        action: chalk.blue('[action]'),
   172→        decision: chalk.magenta('[decision]'),
   173→      }[step.type];
   174→
   175→      console.log(`${prefix} ${step.content}`);
   176→
   177→      if (step.on_fail) {
   178→        console.log(chalk.gray(`  → on fail: ${step.on_fail}`));
   179→      }
   180→
   181→      if (step.options && step.options.length > 0) {
   182→        for (const option of step.options) {
   183→          console.log(chalk.gray(`  • ${option}`));
   184→        }
   185→      }
   186→    }
   187→
   188→    console.log('');
   189→  }
   190→}
   191→
   192→/**
   193→ * Format conventions table output
   194→ * AC-conv-1: outputs table with columns: Domain, Rules (count), Validation (yes/no)
   195→ */
   196→function formatConventions(conventions: Convention[]): void {
   197→  if (conventions.length === 0) {
   198→    console.log(chalk.yellow('No conventions defined'));
   199→    return;
   200→  }
   201→
   202→  const table = new Table({
   203→    head: [chalk.bold('Domain'), chalk.bold('Rules'), chalk.bold('Validation')],
   204→    style: {
   205→      head: [],
   206→      border: [],
   207→    },
   208→  });
   209→
   210→  for (const convention of conventions) {
   211→    table.push([
   212→      convention.domain,
   213→      convention.rules.length.toString(),
   214→      convention.validation ? 'yes' : 'no',
   215→    ]);
   216→  }
   217→
   218→  console.log(table.toString());
   219→}
   220→
   221→/**
   222→ * Format convention detail output
   223→ * AC-conv-2: outputs full rules list and examples
   224→ */
   225→function formatConventionDetail(convention: Convention): void {
   226→  console.log(chalk.bold(`${convention.domain} Convention`));
   227→  console.log(chalk.gray('─'.repeat(60)));
   228→
   229→  console.log(chalk.bold('\nRules:'));
   230→  for (const rule of convention.rules) {
   231→    console.log(`  • ${rule}`);
   232→  }
   233→
   234→  if (convention.examples && convention.examples.length > 0) {
   235→    console.log(chalk.bold('\nExamples:'));
   236→    for (const example of convention.examples) {
   237→      console.log(chalk.green(`  ✓ ${example.good}`));
   238→      console.log(chalk.red(`  ✗ ${example.bad}`));
   239→    }
   240→  }
   241→
   242→  if (convention.validation) {
   243→    console.log(chalk.bold('\nValidation:'));
   244→    console.log(`  Type: ${convention.validation.type}`);
   245→    if (convention.validation.pattern) {
   246→      console.log(`  Pattern: ${convention.validation.pattern}`);
   247→    }
   248→    if (convention.validation.message) {
   249→      console.log(`  Message: ${convention.validation.message}`);
   250→    }
   251→  }
   252→
   253→  console.log('');
   254→}
   255→
   256→/**
   257→ * Format observations table output
   258→ * AC-obs-2: outputs table with columns: ID, Type, Workflow, Created, Content (truncated)
   259→ */
   260→function formatObservations(observations: Observation[], showResolved: boolean): void {
   261→  const filtered = showResolved ? observations : observations.filter(o => !o.resolved);
   262→
   263→  if (filtered.length === 0) {
   264→    console.log(chalk.yellow(showResolved ? 'No observations found' : 'No unresolved observations'));
   265→    return;
   266→  }
   267→
   268→  const table = new Table({
   269→    head: [
   270→      chalk.bold('ID'),
   271→      chalk.bold('Type'),
   272→      chalk.bold('Workflow'),
   273→      chalk.bold('Created'),
   274→      chalk.bold('Content'),
   275→    ],
   276→    style: {
   277→      head: [],
   278→      border: [],
   279→    },
   280→    colWidths: [10, 10, 20, 12, 50],
   281→    wordWrap: true,
   282→  });
   283→
   284→  for (const obs of filtered) {
   285→    const id = obs._ulid.substring(0, 8);
   286→    const workflow = obs.workflow_ref || '-';
   287→    const created = new Date(obs.created_at).toISOString().split('T')[0];
   288→    const content = obs.content.length > 47 ? obs.content.substring(0, 47) + '...' : obs.content;
   289→
   290→    table.push([id, obs.type, workflow, created, content]);
   291→  }
   292→
   293→  console.log(table.toString());
   294→}
   295→
   296→/**
   297→ * Register meta commands
   298→ */
   299→export function registerMetaCommands(program: Command): void {
   300→  const meta = program
   301→    .command('meta')
   302→    .description('Meta-spec commands (agents, workflows, conventions, observations)');
   303→
   304→  // AC-meta-manifest-1: kspec meta show outputs summary with counts
   305→  meta
   306→    .command('show')
   307→    .description('Display meta-spec summary')
   308→    .action(async () => {
   309→      try {
   310→        const ctx = await initContext();
   311→
   312→        if (!ctx.manifestPath) {
   313→          error(errors.project.noKspecProject);
   314→          process.exit(1);
   315→        }
   316→
   317→        const metaCtx = await loadMetaContext(ctx);
   318→        const stats = getMetaStats(metaCtx);
   319→
   320→        output(
   321→          {
   322→            manifest: metaCtx.manifestPath,
   323→            stats,
   324→          },
   325→          () => formatMetaShow(metaCtx)
   326→        );
   327→      } catch (err) {
   328→        error(errors.failures.showMeta, err);
   329→        process.exit(1);
   330→      }
   331→    });
   332→
   333→  // AC-agent-1, AC-agent-2: kspec meta agents
   334→  meta
   335→    .command('agents')
   336→    .description('List agents defined in meta-spec')
   337→    .action(async () => {
   338→      try {
   339→        const ctx = await initContext();
   340→
   341→        if (!ctx.manifestPath) {
   342→          error(errors.project.noKspecProject);
   343→          process.exit(1);
   344→        }
   345→
   346→        const metaCtx = await loadMetaContext(ctx);
   347→        const agents = metaCtx.agents || [];
   348→
   349→        // AC-agent-2: JSON output includes full agent details
   350→        output(
   351→          agents.map((agent) => ({
   352→            id: agent.id,
   353→            name: agent.name,
   354→            description: agent.description,
   355→            capabilities: agent.capabilities,
   356→            tools: agent.tools,
   357→            session_protocol: agent.session_protocol,
   358→            conventions: agent.conventions,
   359→          })),
   360→          // AC-agent-1: Table output with ID, Name, Capabilities
   361→          () => formatAgents(agents)
   362→        );
   363→      } catch (err) {
   364→        error(errors.failures.listAgents, err);
   365→        process.exit(1);
   366→      }
   367→    });
   368→
   369→  // AC-workflow-1, AC-workflow-2, AC-workflow-4: kspec meta workflows
   370→  meta
   371→    .command('workflows')
   372→    .description('List workflows defined in meta-spec')
   373→    .option('--verbose', 'Show full workflow details with all steps')
   374→    .action(async (options) => {
   375→      try {
   376→        const ctx = await initContext();
   377→
   378→        if (!ctx.manifestPath) {
   379→          error(errors.project.noKspecProject);
   380→          process.exit(1);
   381→        }
   382→
   383→        const metaCtx = await loadMetaContext(ctx);
   384→        const workflows = metaCtx.workflows || [];
   385→
   386→        // AC-workflow-4: JSON output includes full workflow details
   387→        output(
   388→          workflows.map((workflow) => ({
   389→            id: workflow.id,
   390→            trigger: workflow.trigger,
   391→            description: workflow.description,
   392→            steps: workflow.steps,
   393→          })),
   394→          // AC-workflow-1 (table) or AC-workflow-2 (verbose)
   395→          () => {
   396→            if (options.verbose) {
   397→              formatWorkflowsVerbose(workflows);
   398→            } else {
   399→              formatWorkflows(workflows);
   400→            }
   401→          }
   402→        );
   403→      } catch (err) {
   404→        error(errors.failures.listWorkflows, err);
   405→        process.exit(1);
   406→      }
   407→    });
   408→
   409→  // AC-conv-1, AC-conv-2, AC-conv-5: kspec meta conventions
   410→  meta
   411→    .command('conventions')
   412→    .description('List conventions defined in meta-spec')
   413→    .option('--domain <domain>', 'Filter by specific domain')
   414→    .action(async (options) => {
   415→      try {
   416→        const ctx = await initContext();
   417→
   418→        if (!ctx.manifestPath) {
   419→          error(errors.project.noKspecProject);
   420→          process.exit(1);
   421→        }
   422→
   423→        const metaCtx = await loadMetaContext(ctx);
   424→        const conventions = metaCtx.conventions || [];
   425→
   426→        // AC-conv-2: Filter by domain if specified
   427→        const filtered = options.domain
   428→          ? conventions.filter((c) => c.domain === options.domain)
   429→          : conventions;
   430→
   431→        // AC-conv-5: JSON output includes full convention details
   432→        output(
   433→          filtered.map((convention) => ({
   434→            domain: convention.domain,
   435→            rules: convention.rules,
   436→            examples: convention.examples,
   437→            validation: convention.validation,
   438→          })),
   439→          // AC-conv-1 (table) or AC-conv-2 (detail for single domain)
   440→          () => {
   441→            if (options.domain && filtered.length === 1) {
   442→              formatConventionDetail(filtered[0]);
   443→            } else {
   444→              formatConventions(filtered);
   445→            }
   446→          }
   447→        );
   448→      } catch (err) {
   449→        error(errors.failures.listConventions, err);
   450→        process.exit(1);
   451→      }
   452→    });
   453→
   454→  // meta-get-cmd: kspec meta get <ref>
   455→  meta
   456→    .command('get <ref>')
   457→    .description('Get a meta item by reference (agent, workflow, convention, or observation)')
   458→    .action(async (ref: string) => {
   459→      try {
   460→        const ctx = await initContext();
   461→
   462→        if (!ctx.manifestPath) {
   463→          error(errors.project.noKspecProject);
   464→          process.exit(1);
   465→        }
   466→
   467→        const metaCtx = await loadMetaContext(ctx);
   468→
   469→        // Normalize reference
   470→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   471→
   472→        // Search in all meta item types
   473→        const agents = metaCtx.agents || [];
   474→        const workflows = metaCtx.workflows || [];
   475→        const conventions = metaCtx.conventions || [];
   476→        const observations = metaCtx.observations || [];
   477→
   478→        // Try to find by ID or ULID prefix
   479→        let found: any = null;
   480→        let itemType: string = '';
   481→
   482→        // Check agents (by id or ULID)
   483→        const agent = agents.find((a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef));
   484→        if (agent) {
   485→          found = agent;
   486→          itemType = 'agent';
   487→        }
   488→
   489→        // Check workflows (by id or ULID)
   490→        if (!found) {
   491→          const workflow = workflows.find((w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef));
   492→          if (workflow) {
   493→            found = workflow;
   494→            itemType = 'workflow';
   495→          }
   496→        }
   497→
   498→        // Check conventions (by domain or ULID)
   499→        if (!found) {
   500→          const convention = conventions.find((c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef));
   501→          if (convention) {
   502→            found = convention;
   503→            itemType = 'convention';
   504→          }
   505→        }
   506→
   507→        // Check observations (by ULID)
   508→        if (!found) {
   509→          const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   510→          if (observation) {
   511→            found = observation;
   512→            itemType = 'observation';
   513→          }
   514→        }
   515→
   516→        if (!found) {
   517→          error(errors.reference.metaNotFound(ref));
   518→          process.exit(1);
   519→        }
   520→
   521→        // Output the item
   522→        output(found, () => {
   523→          console.log(chalk.bold(`${itemType.charAt(0).toUpperCase() + itemType.slice(1)}: ${ref}`));
   524→          console.log(chalk.gray('─'.repeat(60)));
   525→          console.log(JSON.stringify(found, null, 2));
   526→        });
   527→      } catch (err) {
   528→        error(errors.failures.getMetaItem, err);
   529→        process.exit(1);
   530→      }
   531→    });
   532→
   533→  // meta-list-cmd: kspec meta list
   534→  meta
   535→    .command('list')
   536→    .description('List all meta items')
   537→    .option('--type <type>', 'Filter by type (agent, workflow, convention, observation)')
   538→    .action(async (options) => {
   539→      try {
   540→        const ctx = await initContext();
   541→
   542→        if (!ctx.manifestPath) {
   543→          error(errors.project.noKspecProject);
   544→          process.exit(1);
   545→        }
   546→
   547→        const metaCtx = await loadMetaContext(ctx);
   548→
   549→        // Collect all meta items with type information
   550→        interface MetaListItem {
   551→          id: string;
   552→          type: string;
   553→          context: string;
   554→          ulid: string;
   555→        }
   556→
   557→        const items: MetaListItem[] = [];
   558→
   559→        // Add agents
   560→        if (!options.type || options.type === 'agent') {
   561→          for (const agent of metaCtx.agents || []) {
   562→            items.push({
   563→              id: agent.id,
   564→              type: 'agent',
   565→              context: agent.name,
   566→              ulid: agent._ulid,
   567→            });
   568→          }
   569→        }
   570→
   571→        // Add workflows
   572→        if (!options.type || options.type === 'workflow') {
   573→          for (const workflow of metaCtx.workflows || []) {
   574→            items.push({
   575→              id: workflow.id,
   576→              type: 'workflow',
   577→              context: workflow.trigger,
   578→              ulid: workflow._ulid,
   579→            });
   580→          }
   581→        }
   582→
   583→        // Add conventions
   584→        if (!options.type || options.type === 'convention') {
   585→          for (const convention of metaCtx.conventions || []) {
   586→            items.push({
   587→              id: convention.domain,
   588→              type: 'convention',
   589→              context: `${convention.rules.length} rules`,
   590→              ulid: convention._ulid,
   591→            });
   592→          }
   593→        }
   594→
   595→        // Add observations
   596→        if (!options.type || options.type === 'observation') {
   597→          for (const observation of metaCtx.observations || []) {
   598→            const ulidPrefix = observation._ulid.substring(0, 8);
   599→            items.push({
   600→              id: ulidPrefix,
   601→              type: 'observation',
   602→              context: `${observation.type} ${observation.resolved ? '(resolved)' : ''}`,
   603→              ulid: observation._ulid,
   604→            });
   605→          }
   606→        }
   607→
   608→        // Output
   609→        output(items, () => {
   610→          if (items.length === 0) {
   611→            console.log(chalk.yellow('No meta items found'));
   612→            return;
   613→          }
   614→
   615→          const table = new Table({
   616→            head: [chalk.bold('ID'), chalk.bold('Type'), chalk.bold('Context')],
   617→            style: {
   618→              head: [],
   619→              border: [],
   620→            },
   621→          });
   622→
   623→          for (const item of items) {
   624→            table.push([item.id, item.type, item.context]);
   625→          }
   626→
   627→          console.log(table.toString());
   628→        });
   629→      } catch (err) {
   630→        error(errors.failures.listMetaItems, err);
   631→        process.exit(1);
   632→      }
   633→    });
   634→
   635→  // AC-obs-1: kspec meta observe <type> <content>
   636→  meta
   637→    .command('observe <type> <content>')
   638→    .description('Create an observation (friction, success, question, idea)')
   639→    .option('--workflow <ref>', 'Reference to workflow this observation relates to')
   640→    .option('--author <author>', 'Author of the observation')
   641→    .action(async (type: string, content: string, options) => {
   642→      try {
   643→        const ctx = await initContext();
   644→
   645→        if (!ctx.manifestPath) {
   646→          error(errors.project.noKspecProject);
   647→          process.exit(1);
   648→        }
   649→
   650→        // Validate observation type
   651→        const validTypes: ObservationType[] = ['friction', 'success', 'question', 'idea'];
   652→        if (!validTypes.includes(type as ObservationType)) {
   653→          error(errors.validation.invalidObservationType(type));
   654→          console.log(`Valid types: ${validTypes.join(', ')}`);
   655→          process.exit(1);
   656→        }
   657→
   658→        // Create observation
   659→        const observation = createObservation(type as ObservationType, content, {
   660→          workflow_ref: options.workflow,
   661→          author: options.author,
   662→        });
   663→
   664→        // Save to manifest
   665→        await saveObservation(ctx, observation);
   666→
   667→        // AC-obs-1: outputs "OK Created observation: <ULID-prefix>"
   668→        success(`Created observation: ${observation._ulid.substring(0, 8)}`);
   669→      } catch (err) {
   670→        error(errors.failures.createObservation, err);
   671→        process.exit(1);
   672→      }
   673→    });
   674→
   675→  // AC-obs-2, AC-obs-5: kspec meta observations
   676→  meta
   677→    .command('observations')
   678→    .description('List observations (shows unresolved by default)')
   679→    .option('--all', 'Include resolved observations')
   680→    .action(async (options) => {
   681→      try {
   682→        const ctx = await initContext();
   683→
   684→        if (!ctx.manifestPath) {
   685→          error(errors.project.noKspecProject);
   686→          process.exit(1);
   687→        }
   688→
   689→        const metaCtx = await loadMetaContext(ctx);
   690→        const observations = metaCtx.observations || [];
   691→
   692→        // AC-obs-5: JSON output includes full observation objects
   693→        output(
   694→          observations.map((obs) => ({
   695→            _ulid: obs._ulid,
   696→            type: obs.type,
   697→            content: obs.content,
   698→            workflow_ref: obs.workflow_ref ?? null,
   699→            created_at: obs.created_at,
   700→            author: obs.author ?? null,
   701→            resolved: obs.resolved,
   702→            resolution: obs.resolution ?? null,
   703→            resolved_at: obs.resolved_at ?? null,
   704→            resolved_by: obs.resolved_by ?? null,
   705→            promoted_to: obs.promoted_to ?? null,
   706→          })),
   707→          // AC-obs-2: Table output with ID, Type, Workflow, Created, Content
   708→          () => formatObservations(observations, options.all)
   709→        );
   710→      } catch (err) {
   711→        error(errors.failures.listObservations, err);
   712→        process.exit(1);
   713→      }
   714→    });
   715→
   716→  // AC-obs-3, AC-obs-6, AC-obs-8: kspec meta promote
   717→  meta
   718→    .command('promote <ref>')
   719→    .description('Promote observation to a task')
   720→    .requiredOption('--title <title>', 'Task title')
   721→    .option('--priority <priority>', 'Task priority (1-3)', '2')
   722→    .option('--force', 'Force promotion even if observation is resolved')
   723→    .action(async (ref: string, options) => {
   724→      try {
   725→        const ctx = await initContext();
   726→
   727→        if (!ctx.manifestPath) {
   728→          error(errors.project.noKspecProject);
   729→          process.exit(1);
   730→        }
   731→
   732→        const metaCtx = await loadMetaContext(ctx);
   733→        const observations = metaCtx.observations || [];
   734→
   735→        // Find observation
   736→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   737→        const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   738→
   739→        if (!observation) {
   740→          error(errors.reference.observationNotFound(ref));
   741→          process.exit(1);
   742→        }
   743→
   744→        // AC-obs-6: Check if already promoted
   745→        if (observation.promoted_to) {
   746→          error(errors.conflict.observationAlreadyPromoted(observation.promoted_to));
   747→          process.exit(1);
   748→        }
   749→
   750→        // AC-obs-8: Check if resolved
   751→        if (observation.resolved && !options.force) {
   752→          error(errors.operation.cannotPromoteResolved);
   753→          process.exit(1);
   754→        }
   755→
   756→        // AC-obs-3: Create task with title, description from observation, meta_ref, and origin
   757→        const task = createTask({
   758→          title: options.title,
   759→          description: observation.content,
   760→          priority: Number.parseInt(options.priority, 10),
   761→          meta_ref: observation.workflow_ref,
   762→          origin: 'observation_promotion',
   763→        });
   764→
   765→        // Save task
   766→        await saveTask(ctx, task);
   767→        const taskRef = `@${task._ulid.substring(0, 8)}`;
   768→
   769→        // Update observation with promoted_to field
   770→        observation.promoted_to = taskRef;
   771→        await saveObservation(ctx, observation);
   772→
   773→        // AC-obs-3: outputs "OK Created task: <ULID-prefix>"
   774→        success(`Created task: ${taskRef.substring(0, 9)}`);
   775→      } catch (err) {
   776→        error(errors.failures.promoteObservation, err);
   777→        process.exit(1);
   778→      }
   779→    });
   780→
   781→  // AC-obs-4, AC-obs-7, AC-obs-9: kspec meta resolve
   782→  meta
   783→    .command('resolve <ref> [resolution]')
   784→    .description('Resolve an observation')
   785→    .action(async (ref: string, resolution: string | undefined) => {
   786→      try {
   787→        const ctx = await initContext();
   788→
   789→        if (!ctx.manifestPath) {
   790→          error(errors.project.noKspecProject);
   791→          process.exit(1);
   792→        }
   793→
   794→        const metaCtx = await loadMetaContext(ctx);
   795→        const observations = metaCtx.observations || [];
   796→
   797→        // Find observation
   798→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   799→        const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   800→
   801→        if (!observation) {
   802→          error(errors.reference.observationNotFound(ref));
   803→          process.exit(1);
   804→        }
   805→
   806→        // AC-obs-7: Check if already resolved
   807→        if (observation.resolved) {
   808→          const resolvedDate = new Date(observation.resolved_at!).toISOString().split('T')[0];
   809→          const resolutionText = observation.resolution || '';
   810→          const truncated = resolutionText.length > 50
   811→            ? resolutionText.substring(0, 50) + '...'
   812→            : resolutionText;
   813→          error(errors.conflict.observationAlreadyResolved(resolvedDate, truncated));
   814→          process.exit(1);
   815→        }
   816→
   817→        // AC-obs-9: Auto-populate resolution from task completion if promoted
   818→        let finalResolution = resolution;
   819→        if (!finalResolution && observation.promoted_to) {
   820→          // TODO: Fetch task completion reason from promoted task
   821→          // For now, just use a placeholder
   822→          finalResolution = `Promoted to task ${observation.promoted_to}`;
   823→        }
   824→
   825→        if (!finalResolution) {
   826→          error(errors.validation.resolutionRequired);
   827→          process.exit(1);
   828→        }
   829→
   830→        // AC-obs-4: Update observation
   831→        observation.resolved = true;
   832→        observation.resolution = finalResolution;
   833→        observation.resolved_at = new Date().toISOString();
   834→        observation.resolved_by = observation.author; // Use same author
   835→
   836→        await saveObservation(ctx, observation);
   837→
   838→        // AC-obs-4: outputs "OK Resolved: <ULID-prefix>"
   839→        success(`Resolved: ${observation._ulid.substring(0, 8)}`);
   840→      } catch (err) {
   841→        error(errors.failures.resolveObservation, err);
   842→        process.exit(1);
   843→      }
   844→    });
   845→
   846→  // Meta add command - create new meta items
   847→  meta
   848→    .command('add <type>')
   849→    .description('Create a new meta item (agent, workflow, or convention)')
   850→    .option('--id <id>', 'Semantic ID (required for agents and workflows)')
   851→    .option('--domain <domain>', 'Domain (required for conventions)')
   852→    .option('--name <name>', 'Name (for agents)')
   853→    .option('--trigger <trigger>', 'Trigger (for workflows)')
   854→    .option('--description <desc>', 'Description')
   855→    .option('--capability <cap...>', 'Capabilities (for agents)')
   856→    .option('--tool <tool...>', 'Tools (for agents)')
   857→    .option('--convention <conv...>', 'Convention references (for agents)')
   858→    .option('--rule <rule...>', 'Rules (for conventions)')
   859→    .action(async (type: string, options) => {
   860→      try {
   861→        const ctx = await initContext();
   862→
   863→        // Validate type
   864→        const validTypes = ['agent', 'workflow', 'convention'];
   865→        if (!validTypes.includes(type)) {
   866→          error(errors.validation.invalidType(type, validTypes));
   867→          process.exit(1);
   868→        }
   869→
   870→        // Generate ULID
   871→        const itemUlid = ulid();
   872→
   873→        // Create the item based on type
   874→        let item: Agent | Workflow | Convention;
   875→
   876→        if (type === 'agent') {
   877→          // Validate required fields
   878→          if (!options.id) {
   879→            error(errors.validation.agentRequiresId);
   880→            process.exit(1);
   881→          }
   882→          if (!options.name) {
   883→            error(errors.validation.agentRequiresName);
   884→            process.exit(1);
   885→          }
   886→
   887→          item = {
   888→            _ulid: itemUlid,
   889→            id: options.id,
   890→            name: options.name,
   891→            description: options.description || '',
   892→            capabilities: options.capability || [],
   893→            tools: options.tool || [],
   894→            conventions: options.convention || [],
   895→          };
   896→        } else if (type === 'workflow') {
   897→          // Validate required fields
   898→          if (!options.id) {
   899→            error(errors.validation.workflowRequiresId);
   900→            process.exit(1);
   901→          }
   902→          if (!options.trigger) {
   903→            error(errors.validation.workflowRequiresTrigger);
   904→            process.exit(1);
   905→          }
   906→
   907→          item = {
   908→            _ulid: itemUlid,
   909→            id: options.id,
   910→            trigger: options.trigger,
   911→            description: options.description || '',
   912→            steps: [],
   913→          };
   914→        } else {
   915→          // convention
   916→          if (!options.domain) {
   917→            error(errors.validation.conventionRequiresDomain);
   918→            process.exit(1);
   919→          }
   920→
   921→          item = {
   922→            _ulid: itemUlid,
   923→            domain: options.domain,
   924→            rules: options.rule || [],
   925→            examples: [],
   926→          };
   927→        }
   928→
   929→        // Save the item
   930→        await saveMetaItem(ctx, item, type as 'agent' | 'workflow' | 'convention');
   931→
   932→        if (isJsonMode()) {
   933→          // In JSON mode, output the item data directly
   934→          console.log(JSON.stringify(item, null, 2));
   935→        } else {
   936→          const idOrDomain = 'id' in item ? item.id : 'domain' in item ? item.domain : itemUlid;
   937→          success(`Created ${type}: ${idOrDomain} (@${itemUlid.substring(0, 8)})`);
   938→        }
   939→      } catch (err) {
   940→        error(errors.failures.createMeta(type), err);
   941→        process.exit(1);
   942→      }
   943→    });
   944→
   945→  // Meta set command - update existing meta items
   946→  meta
   947→    .command('set <ref>')
   948→    .description('Update an existing meta item')
   949→    .option('--name <name>', 'Update name (for agents)')
   950→    .option('--description <desc>', 'Update description')
   951→    .option('--trigger <trigger>', 'Update trigger (for workflows)')
   952→    .option('--add-capability <cap>', 'Add capability (for agents)')
   953→    .option('--add-tool <tool>', 'Add tool (for agents)')
   954→    .option('--add-convention <conv>', 'Add convention reference (for agents)')
   955→    .option('--add-rule <rule>', 'Add rule (for conventions)')
   956→    .action(async (ref: string, options) => {
   957→      try {
   958→        const ctx = await initContext();
   959→        const metaCtx = await loadMetaContext(ctx);
   960→
   961→        // Find the item using unified lookup
   962→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   963→        let found: Agent | Workflow | Convention | null = null;
   964→        let itemType: 'agent' | 'workflow' | 'convention' | null = null;
   965→
   966→        // Search in agents
   967→        const agents = metaCtx.manifest?.agents || [];
   968→        const agent = agents.find(
   969→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
   970→        );
   971→        if (agent) {
   972→          found = agent;
   973→          itemType = 'agent';
   974→        }
   975→
   976→        // Search in workflows
   977→        if (!found) {
   978→          const workflows = metaCtx.manifest?.workflows || [];
   979→          const workflow = workflows.find(
   980→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
   981→          );
   982→          if (workflow) {
   983→            found = workflow;
   984→            itemType = 'workflow';
   985→          }
   986→        }
   987→
   988→        // Search in conventions
   989→        if (!found) {
   990→          const conventions = metaCtx.manifest?.conventions || [];
   991→          const convention = conventions.find(
   992→            (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
   993→          );
   994→          if (convention) {
   995→            found = convention;
   996→            itemType = 'convention';
   997→          }
   998→        }
   999→
  1000→        if (!found || !itemType) {
  1001→          error(errors.reference.metaNotFound(ref));
  1002→          process.exit(1);
  1003→        }
  1004→
  1005→        // Update fields based on type
  1006→        if (itemType === 'agent') {
  1007→          const item = found as Agent;
  1008→          if (options.name) item.name = options.name;
  1009→          if (options.description !== undefined) item.description = options.description;
  1010→          if (options.addCapability) {
  1011→            if (!item.capabilities.includes(options.addCapability)) {
  1012→              item.capabilities.push(options.addCapability);
  1013→            }
  1014→          }
  1015→          if (options.addTool) {
  1016→            if (!item.tools.includes(options.addTool)) {
  1017→              item.tools.push(options.addTool);
  1018→            }
  1019→          }
  1020→          if (options.addConvention) {
  1021→            if (!item.conventions.includes(options.addConvention)) {
  1022→              item.conventions.push(options.addConvention);
  1023→            }
  1024→          }
  1025→        } else if (itemType === 'workflow') {
  1026→          const item = found as Workflow;
  1027→          if (options.trigger) item.trigger = options.trigger;
  1028→          if (options.description !== undefined) item.description = options.description;
  1029→        } else {
  1030→          const item = found as Convention;
  1031→          // Convention doesn't have a description field
  1032→          if (options.addRule) {
  1033→            if (!item.rules.includes(options.addRule)) {
  1034→              item.rules.push(options.addRule);
  1035→            }
  1036→          }
  1037→        }
  1038→
  1039→        // Save the updated item
  1040→        await saveMetaItem(ctx, found, itemType);
  1041→
  1042→        if (isJsonMode()) {
  1043→          // In JSON mode, output the item data directly
  1044→          console.log(JSON.stringify(found, null, 2));
  1045→        } else {
  1046→          const idOrDomain =
  1047→            itemType === 'agent'
  1048→              ? (found as Agent).id
  1049→              : itemType === 'workflow'
  1050→                ? (found as Workflow).id
  1051→                : (found as Convention).domain;
  1052→          success(`Updated ${itemType}: ${idOrDomain}`);
  1053→        }
  1054→      } catch (err) {
  1055→        error(errors.failures.updateMetaItem, err);
  1056→        process.exit(1);
  1057→      }
  1058→    });
  1059→
  1060→  // Meta delete command - delete meta items
  1061→  meta
  1062→    .command('delete <ref>')
  1063→    .description('Delete a meta item')
  1064→    .option('--confirm', 'Skip confirmation prompt')
  1065→    .action(async (ref: string, options) => {
  1066→      try {
  1067→        const ctx = await initContext();
  1068→        const metaCtx = await loadMetaContext(ctx);
  1069→
  1070→        // Find the item to determine type
  1071→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
  1072→        let itemType: 'agent' | 'workflow' | 'convention' | 'observation' | null = null;
  1073→        let itemUlid: string | null = null;
  1074→        let itemLabel: string | null = null;
  1075→
  1076→        // Search in agents
  1077→        const agents = metaCtx.manifest?.agents || [];
  1078→        const agent = agents.find(
  1079→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
  1080→        );
  1081→        if (agent) {
  1082→          itemType = 'agent';
  1083→          itemUlid = agent._ulid;
  1084→          itemLabel = `agent ${agent.id}`;
  1085→        }
  1086→
  1087→        // Search in workflows
  1088→        if (!itemType) {
  1089→          const workflows = metaCtx.manifest?.workflows || [];
  1090→          const workflow = workflows.find(
  1091→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
  1092→          );
  1093→          if (workflow) {
  1094→            itemType = 'workflow';
  1095→            itemUlid = workflow._ulid;
  1096→            itemLabel = `workflow ${workflow.id}`;
  1097→          }
  1098→        }
  1099→
  1100→        // Search in conventions
  1101→        if (!itemType) {
  1102→          const conventions = metaCtx.manifest?.conventions || [];
  1103→          const convention = conventions.find(
  1104→            (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
  1105→          );
  1106→          if (convention) {
  1107→            itemType = 'convention';
  1108→            itemUlid = convention._ulid;
  1109→            itemLabel = `convention ${convention.domain}`;
  1110→          }
  1111→        }
  1112→
  1113→        // Search in observations
  1114→        if (!itemType) {
  1115→          const observations = metaCtx.observations || [];
  1116→          const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
  1117→          if (observation) {
  1118→            itemType = 'observation';
  1119→            itemUlid = observation._ulid;
  1120→            itemLabel = `observation ${observation._ulid.substring(0, 8)}`;
  1121→          }
  1122→        }
  1123→
  1124→        if (!itemType || !itemUlid || !itemLabel) {
  1125→          error(errors.reference.metaNotFound(ref));
  1126→          process.exit(1);
  1127→        }
  1128→
  1129→        // Check for dangling references (unless --confirm is used to override)
  1130→        if (!options.confirm) {
  1131→          // Check tasks with meta_ref
  1132→          const tasks = await loadAllTasks(ctx);
  1133→          const referencingTasks = tasks.filter((t) => {
  1134→            if (!t.meta_ref) return false;
  1135→            // Resolve the task's meta_ref to a ULID
  1136→            const taskMetaRef = resolveMetaRefToUlid(t.meta_ref, metaCtx);
  1137→            // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1138→            return taskMetaRef && taskMetaRef.ulid === itemUlid;
  1139→          });
  1140→
  1141→          if (referencingTasks.length > 0) {
  1142→            const taskRefs = referencingTasks
  1143→              .map((t) => `@${t.slugs?.[0] || t._ulid.substring(0, 8)}`)
  1144→              .join(', ');
  1145→            error(errors.operation.cannotDeleteReferencedByTasks(itemLabel, referencingTasks.length, taskRefs));
  1146→            process.exit(1);
  1147→          }
  1148→
  1149→          // Check observations with workflow_ref (only for workflows)
  1150→          if (itemType === 'workflow') {
  1151→            const observations = metaCtx.observations || [];
  1152→            const referencingObservations = observations.filter((o) => {
  1153→              if (!o.workflow_ref) return false;
  1154→              // Resolve the observation's workflow_ref to a ULID
  1155→              const obsWorkflowRef = resolveMetaRefToUlid(o.workflow_ref, metaCtx);
  1156→              // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1157→              return obsWorkflowRef && obsWorkflowRef.ulid === itemUlid;
  1158→            });
  1159→
  1160→            if (referencingObservations.length > 0) {
  1161→              const obsRefs = referencingObservations
  1162→                .map((o) => `@${o._ulid.substring(0, 8)}`)
  1163→                .join(', ');
  1164→              error(errors.operation.cannotDeleteReferencedByObservations(itemLabel, referencingObservations.length, obsRefs));
  1165→              process.exit(1);
  1166→            }
  1167→          }
  1168→
  1169→          // Show confirmation prompt even if no references found
  1170→          error(errors.operation.confirmRequired(itemLabel));
  1171→          process.exit(1);
  1172→        }
  1173→
  1174→        // Delete the item
  1175→        const deleted = await deleteMetaItem(ctx, itemUlid, itemType);
  1176→
  1177→        if (!deleted) {
  1178→          error(errors.operation.deleteItemFailed(itemLabel));
  1179→          process.exit(1);
  1180→        }
  1181→
  1182→        success(`Deleted ${itemLabel}`);
  1183→      } catch (err) {
  1184→        error(errors.failures.deleteMetaItem, err);
  1185→        process.exit(1);
  1186→      }
  1187→    });
  1188→}
  1189→

