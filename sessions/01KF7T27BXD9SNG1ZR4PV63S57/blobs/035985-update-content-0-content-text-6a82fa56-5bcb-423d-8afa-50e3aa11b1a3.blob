```
     1→import chalk from 'chalk';
     2→import type { Task, TaskStatus } from '../schema/index.js';
     3→import type { ReferenceIndex } from '../parser/index.js';
     4→import { grepItem, formatMatchedFields } from '../utils/grep.js';
     5→import { fieldLabels, sectionHeaders, summaries } from '../strings/labels.js';
     6→
     7→/**
     8→ * Output options
     9→ */
    10→export interface OutputOptions {
    11→  json?: boolean;
    12→}
    13→
    14→/**
    15→ * Global output format (set by --json flag)
    16→ */
    17→let globalJsonMode = false;
    18→
    19→export function setJsonMode(enabled: boolean): void {
    20→  globalJsonMode = enabled;
    21→}
    22→
    23→export function isJsonMode(): boolean {
    24→  return globalJsonMode;
    25→}
    26→
    27→/**
    28→ * Global verbose mode (set by --verbose flag)
    29→ */
    30→let globalVerboseMode = false;
    31→
    32→export function setVerboseMode(enabled: boolean): void {
    33→  globalVerboseMode = enabled;
    34→}
    35→
    36→export function getVerboseMode(): boolean {
    37→  return globalVerboseMode;
    38→}
    39→
    40→/**
    41→ * Output data - JSON if --json flag, otherwise formatted
    42→ */
    43→export function output(data: unknown, formatter?: () => void): void {
    44→  if (globalJsonMode) {
    45→    console.log(JSON.stringify(data, null, 2));
    46→  } else if (formatter) {
    47→    formatter();
    48→  } else {
    49→    console.log(data);
    50→  }
    51→}
    52→
    53→/**
    54→ * Output success message
    55→ */
    56→export function success(message: string, data?: Record<string, unknown>): void {
    57→  if (globalJsonMode) {
    58→    console.log(JSON.stringify({ success: true, message, ...data }));
    59→  } else {
    60→    console.log(chalk.green('OK'), message);
    61→  }
    62→}
    63→
    64→/**
    65→ * Output error message
    66→ */
    67→export function error(message: string, details?: unknown): void {
    68→  if (globalJsonMode) {
    69→    console.error(JSON.stringify({ success: false, error: message, details }));
    70→  } else {
    71→    console.error(chalk.red('✗'), message);
    72→    if (details) {
    73→      console.error(chalk.gray(String(details)));
    74→    }
    75→  }
    76→}
    77→
    78→/**
    79→ * Output warning message
    80→ */
    81→export function warn(message: string): void {
    82→  if (globalJsonMode) {
    83→    // Warnings are suppressed in JSON mode
    84→  } else {
    85→    console.warn(chalk.yellow('⚠'), message);
    86→  }
    87→}
    88→
    89→/**
    90→ * Output info message
    91→ */
    92→export function info(message: string): void {
    93→  if (globalJsonMode) {
    94→    // Info messages suppressed in JSON mode
    95→  } else {
    96→    console.log(chalk.blue('ℹ'), message);
    97→  }
    98→}
    99→
   100→/**
   101→ * Get color for task status
   102→ */
   103→function statusColor(status: TaskStatus): (text: string) => string {
   104→  switch (status) {
   105→    case 'pending':
   106→      return (t: string) => chalk.gray(t);
   107→    case 'in_progress':
   108→      return (t: string) => chalk.blue(t);
   109→    case 'blocked':
   110→      return (t: string) => chalk.red(t);
   111→    case 'completed':
   112→      return (t: string) => chalk.green(t);
   113→    case 'cancelled':
   114→      return (t: string) => chalk.strikethrough.gray(t);
   115→    default:
   116→      return (t: string) => chalk.white(t);
   117→  }
   118→}
   119→
   120→/**
   121→ * Format a task reference (short ULID + slug if available)
   122→ * @param task The task to format
   123→ * @param index Optional ReferenceIndex for dynamic short ULID computation
   124→ */
   125→export function formatTaskRef(task: Task, index?: ReferenceIndex): string {
   126→  const shortId = index ? index.shortUlid(task._ulid) : task._ulid.slice(0, 8);
   127→  if (task.slugs.length > 0) {
   128→    return `${shortId} (${task.slugs[0]})`;
   129→  }
   130→  return shortId;
   131→}
   132→
   133→/**
   134→ * Format task for display
   135→ */
   136→export function formatTask(task: Task, verbose = false, index?: ReferenceIndex, full = false): string {
   137→  const ref = formatTaskRef(task, index);
   138→  const status = statusColor(task.status)(`[${task.status}]`);
   139→  const priority = task.priority <= 2 ? chalk.red(`P${task.priority}`) : chalk.gray(`P${task.priority}`);
   140→
   141→  let line = `${ref} ${status} ${priority} ${task.title}`;
   142→
   143→  if (verbose && !full) {
   144→    // AC-2: Single verbose (-v) shows current behavior
   145→    if (task.spec_ref) {
   146→      line += chalk.gray(` (spec: ${task.spec_ref})`);
   147→    }
   148→    if (task.depends_on.length > 0) {
   149→      line += chalk.gray(` deps: [${task.depends_on.join(', ')}]`);
   150→    }
   151→    if (task.tags.length > 0) {
   152→      line += chalk.cyan(` #${task.tags.join(' #')}`);
   153→    }
   154→  }
   155→
   156→  return line;
   157→}
   158→
   159→/**
   160→ * Get first line of text, truncated to max length
   161→ */
   162→function getFirstLine(text: string | undefined, maxLength: number = 70): string | undefined {
   163→  if (!text) return undefined;
   164→  const firstLine = text.split('\n')[0].trim();
   165→  if (firstLine.length <= maxLength) return firstLine;
   166→  return firstLine.slice(0, maxLength - 3) + '...';
   167→}
   168→
   169→/**
   170→ * Format full mode context for a task (AC-1, AC-3, AC-5)
   171→ */
   172→function formatFullModeContext(task: Task, index?: ReferenceIndex): void {
   173→  const indent = '    ';
   174→
   175→  // Show timestamps (AC-1)
   176→  console.log(chalk.gray(`${indent}Created: ${task.created_at}`));
   177→  if (task.started_at) {
   178→    console.log(chalk.gray(`${indent}Started: ${task.started_at}`));
   179→  }
   180→  if (task.completed_at) {
   181→    console.log(chalk.gray(`${indent}Completed: ${task.completed_at}`));
   182→  }
   183→
   184→  // Show notes count and most recent note (AC-1, AC-3)
   185→  if (task.notes && task.notes.length > 0) {
   186→    const mostRecent = task.notes[task.notes.length - 1];
   187→    const preview = getFirstLine(mostRecent.content, 50);
   188→    console.log(chalk.gray(`${indent}Notes: ${task.notes.length} (latest: "${preview}")`));
   189→  }
   190→
   191→  // Show pending todos count (AC-1, AC-3)
   192→  if (task.todos && task.todos.length > 0) {
   193→    const pendingCount = task.todos.filter(t => !t.done).length;
   194→    if (pendingCount > 0) {
   195→      console.log(chalk.gray(`${indent}Pending todos: ${pendingCount}`));
   196→    }
   197→  }
   198→
   199→  // Show spec context (AC-5)
   200→  if (task.spec_ref && index) {
   201→    const result = index.resolve(task.spec_ref);
   202→    if (result.ok) {
   203→      const spec = result.item;
   204→      const specName = 'title' in spec ? spec.title : ('name' in spec ? spec.name : ('id' in spec ? spec.id : task.spec_ref));
   205→      console.log(chalk.gray(`${indent}Spec: ${task.spec_ref}`));
   206→      console.log(chalk.cyan(`${indent}  ${specName}`));
   207→
   208→      // Show spec description if available
   209→      if ('description' in spec && spec.description) {
   210→        const descPreview = getFirstLine(spec.description as string, 70);
   211→        console.log(chalk.gray(`${indent}  ${descPreview}`));
   212→      }
   213→
   214→      // Show acceptance criteria if available
   215→      if ('acceptance_criteria' in spec && Array.isArray(spec.acceptance_criteria)) {
   216→        const ac = spec.acceptance_criteria;
   217→        if (ac.length > 0) {
   218→          console.log(chalk.gray(`${indent}  Acceptance Criteria: ${ac.length}`));
   219→          // Show first AC as preview
   220→          const firstAC = ac[0];
   221→          if (typeof firstAC === 'object' && firstAC !== null && 'id' in firstAC) {
   222→            console.log(chalk.gray(`${indent}    [${firstAC.id}] ${firstAC.then}`));
   223→          }
   224→        }
   225→      }
   226→    }
   227→  }
   228→
   229→  // Show tags and dependencies if present
   230→  if (task.tags && task.tags.length > 0) {
   231→    console.log(chalk.gray(`${indent}Tags: ${task.tags.join(', ')}`));
   232→  }
   233→  if (task.depends_on && task.depends_on.length > 0) {
   234→    console.log(chalk.gray(`${indent}Depends on: ${task.depends_on.join(', ')}`));
   235→  }
   236→}
   237→
   238→/**
   239→ * Format a list of tasks
   240→ */
   241→export function formatTaskList(tasks: Task[], verbose = false, index?: ReferenceIndex, grepPattern?: string, full = false): void {
   242→  if (tasks.length === 0) {
   243→    console.log(summaries.noTasks);
   244→    return;
   245→  }
   246→
   247→  for (const task of tasks) {
   248→    console.log(formatTask(task, verbose, index, full));
   249→
   250→    // Show matched fields if grep pattern provided
   251→    if (grepPattern) {
   252→      const match = grepItem(task as unknown as Record<string, unknown>, grepPattern);
   253→      if (match && match.matchedFields.length > 0) {
   254→        console.log(chalk.gray(`    matched: ${formatMatchedFields(match.matchedFields)}`));
   255→      }
   256→    } else if (full) {
   257→      // AC-1: Full mode shows richer context
   258→      formatFullModeContext(task, index);
   259→    } else {
   260→      // Show context line: first line of description (if present)
   261→      const context = getFirstLine(task.description);
   262→      if (context) {
   263→        console.log(chalk.gray(`    ${context}`));
   264→      }
   265→    }
   266→  }
   267→
   268→  console.log(summaries.taskCount(tasks.length));
   269→}
   270→
   271→/**
   272→ * Format task details
   273→ */
   274→export function formatTaskDetails(task: Task, index?: ReferenceIndex): void {
   275→  console.log(chalk.bold(task.title));
   276→  console.log(chalk.gray('─'.repeat(40)));
   277→  console.log(`${fieldLabels.ulid}      ${task._ulid}`);
   278→  if (task.slugs.length > 0) {
   279→    console.log(`${fieldLabels.slugs}     ${task.slugs.join(', ')}`);
   280→  }
   281→  console.log(`${fieldLabels.type}      ${task.type}`);
   282→  console.log(`${fieldLabels.status}    ${statusColor(task.status)(task.status)}`);
   283→  console.log(`${fieldLabels.priority}  ${task.priority}`);
   284→
   285→  if (task.spec_ref) {
   286→    console.log(`${fieldLabels.specRef}  ${task.spec_ref}`);
   287→  }
   288→
   289→  if (task.depends_on.length > 0) {
   290→    if (index) {
   291→      console.log(fieldLabels.depends);
   292→      for (const ref of task.depends_on) {
   293→        const result = index.resolve(ref);
   294→        if (result.ok) {
   295→          const item = result.item;
   296→          const status = 'status' in item && typeof item.status === 'string'
   297→            ? statusColor(item.status as TaskStatus)(`[${item.status}]`)
   298→            : chalk.gray('[spec]');
   299→          // Handle both spec items (with title) and meta items (with name or id)
   300→          const itemName = 'title' in item ? item.title : ('name' in item ? item.name : ('id' in item ? item.id : ref));
   301→          console.log(`  ${ref} ${chalk.gray('→')} ${itemName} ${status}`);
   302→        } else {
   303→          console.log(`  ${ref} ${chalk.red('(unresolved)')}`);
   304→        }
   305→      }
   306→    } else {
   307→      console.log(`${fieldLabels.depends}   ${task.depends_on.join(', ')}`);
   308→    }
   309→  }
   310→
   311→  if (task.blocked_by.length > 0) {
   312→    console.log(chalk.red(`${fieldLabels.blocked}   ${task.blocked_by.join(', ')}`));
   313→  }
   314→
   315→  if (task.tags.length > 0) {
   316→    console.log(`${fieldLabels.tags}      ${task.tags.join(', ')}`);
   317→  }
   318→
   319→  console.log(`${fieldLabels.created}   ${task.created_at}`);
   320→  if (task.started_at) {
   321→    console.log(`${fieldLabels.started}   ${task.started_at}`);
   322→  }
   323→  if (task.completed_at) {
   324→    console.log(`${fieldLabels.completed} ${task.completed_at}`);
   325→  }
   326→
   327→  // Show resolved spec information
   328→  if (task.spec_ref && index) {
   329→    const result = index.resolve(task.spec_ref);
   330→    if (result.ok) {
   331→      const spec = result.item;
   332→      console.log(`\n${sectionHeaders.specContext}`);
   333→      // Handle both spec items (with title) and meta items (with name)
   334→      const specName = 'title' in spec ? spec.title : ('name' in spec ? spec.name : ('id' in spec ? spec.id : task.spec_ref));
   335→      console.log(chalk.cyan(specName));
   336→      if ('type' in spec && spec.type) {
   337→        console.log(chalk.gray(`${fieldLabels.type} ${spec.type}`));
   338→      }
   339→      // Show implementation status
   340→      if ('status' in spec && spec.status && typeof spec.status === 'object') {
   341→        const status = spec.status as { maturity?: string; implementation?: string };
   342→        if (status.implementation) {
   343→          const implColor = status.implementation === 'verified' ? chalk.green
   344→            : status.implementation === 'implemented' ? chalk.cyan
   345→            : status.implementation === 'in_progress' ? chalk.yellow
   346→            : chalk.gray;
   347→          console.log(chalk.gray(fieldLabels.implementation) + implColor(status.implementation));
   348→        }
   349→      }
   350→      if ('description' in spec && spec.description) {
   351→        console.log(chalk.gray(fieldLabels.description));
   352→        // Indent description lines
   353→        const desc = String(spec.description).trim();
   354→        for (const line of desc.split('\n')) {
   355→          console.log(chalk.gray(`  ${line}`));
   356→        }
   357→      }
   358→      if ('acceptance_criteria' in spec && Array.isArray(spec.acceptance_criteria) && spec.acceptance_criteria.length > 0) {
   359→        console.log(chalk.gray(fieldLabels.acceptanceCriteria));
   360→        for (const ac of spec.acceptance_criteria) {
   361→          if (ac && typeof ac === 'object' && 'id' in ac) {
   362→            const acObj = ac as { id: string; given?: string; when?: string; then?: string };
   363→            console.log(chalk.gray(`  [${acObj.id}]`));
   364→            if (acObj.given) console.log(chalk.gray(`    Given: ${acObj.given}`));
   365→            if (acObj.when) console.log(chalk.gray(`    When: ${acObj.when}`));
   366→            if (acObj.then) console.log(chalk.gray(`    Then: ${acObj.then}`));
   367→          }
   368→        }
   369→      }
   370→      // Show traceability if present
   371→      if ('traceability' in spec && spec.traceability && typeof spec.traceability === 'object') {
   372→        const trace = spec.traceability as {
   373→          implementation?: Array<{ path: string; function?: string; lines?: string }>;
   374→          tests?: Array<{ path: string }>;
   375→          commits?: string[];
   376→          issues?: string[];
   377→        };
   378→        const hasTrace = trace.implementation?.length || trace.tests?.length || trace.commits?.length || trace.issues?.length;
   379→        if (hasTrace) {
   380→          console.log(chalk.gray(fieldLabels.traceability));
   381→          if (trace.implementation?.length) {
   382→            for (const impl of trace.implementation) {
   383→              let loc = `  Code: ${impl.path}`;
   384→              if (impl.function) loc += `::${impl.function}`;
   385→              if (impl.lines) loc += `:${impl.lines}`;
   386→              console.log(chalk.gray(loc));
   387→            }
   388→          }
   389→          if (trace.tests?.length) {
   390→            for (const test of trace.tests) {
   391→              console.log(chalk.gray(`  Test: ${test.path}`));
   392→            }
   393→          }
   394→          if (trace.commits?.length) {
   395→            console.log(chalk.gray(`  Commits: ${trace.commits.join(', ')}`));
   396→          }
   397→          if (trace.issues?.length) {
   398→            console.log(chalk.gray(`  Issues: ${trace.issues.join(', ')}`));
   399→          }
   400→        }
   401→      }
   402→    }
   403→  }
   404→
   405→  if (task.notes.length > 0) {
   406→    console.log(`\n${sectionHeaders.notes}`);
   407→    for (const note of task.notes) {
   408→      const author = note.author || 'unknown';
   409→      console.log(chalk.gray(`[${note.created_at}] ${author}:`));
   410→      console.log(note.content);
   411→    }
   412→  }
   413→
   414→  if (task.todos.length > 0) {
   415→    console.log(`\n${sectionHeaders.todos}`);
   416→    for (const todo of task.todos) {
   417→      const check = todo.done ? chalk.green('✓') : chalk.gray('○');
   418→      const text = todo.done ? chalk.strikethrough.gray(todo.text) : todo.text;
   419→      console.log(`${check} [${todo.id}] ${text}`);
   420→    }
   421→  }
   422→}
