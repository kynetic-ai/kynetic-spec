+{"ts":1768725654460,"seq":15753,"type":"session.update","session_id":"01KF7T27BXD9SNG1ZR4PV63S57","data":{"iteration":1,"update":{"_meta":{"claudeCode":{"toolResponse":{"stdout":"> @kynetic/spec@0.1.0 dev\n> tsx src/cli/index.ts item get @task-completion-guardrails\n\nTask Completion Guardrails\n────────────────────────────────────────\nULID:      01KF3H24BBZ5JXXMEP8JJS9SEJ\nSlugs:     task-completion-guardrails\nType:      requirement\nMaturity:  draft\nImplementation: implemented\nTags:      workflow, dx\n\n─── Description ───\nWhen completing a task, CLI provides guardrails to ensure work is properly documented and aligned with spec.\n\n─── Acceptance Criteria ───\n  [ac-1]\n    Given: A task with spec_ref is completed via 'kspec task complete'\n    When: The task is marked completed\n    Then: CLI prompts: 'Update @spec-ref status to implemented? [y/n]'\n  [ac-2]\n    Given: A task with spec_ref is completed and the linked spec has acceptance_criteria\n    When: The user chooses to update spec status\n    Then: CLI shows a reminder: 'Linked spec has N acceptance criteria - verify they are covered'\n  [ac-3]\n    Given: A task without spec_ref is completed\n    When: The task is marked completed\n    Then: No status update prompt is shown (only applies to spec-linked tasks)","stderr":"","interrupted":false,"isImage":false},"toolName":"Bash"}},"toolCallId":"toolu_01V2LLZU1GKTkBubuiYfk6VR","sessionUpdate":"tool_call_update"}}}
