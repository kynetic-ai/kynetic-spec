```
   560→    expect(item).toContain('DryRun Test');
   561→    expect(item).not.toContain('New Title');
   562→  });
   563→
   564→  // AC: @item-patch ac-5
   565→  it('should reject unknown fields by default', () => {
   566→    kspec('item add --under @test-core --title "Unknown Test" --slug unknown-test --type feature', tempDir);
   567→
   568→    expect(() => {
   569→      execSync(
   570→        `npx tsx ${CLI_PATH} item patch @unknown-test --data '{"foobar":"value"}'`,
   571→        { cwd: tempDir, encoding: 'utf-8', stdio: 'pipe' }
   572→      );
   573→    }).toThrow();
   574→  });
   575→
   576→  // AC: @item-patch ac-6
   577→  it('should allow unknown fields with --allow-unknown', () => {
