   686→describe('Integration: derive', () => {
   687→  let tempDir: string;
   688→
   689→  beforeEach(async () => {
   690→    tempDir = await setupTempFixtures();
   691→  });
   692→
   693→  afterEach(async () => {
   694→    await cleanupTempDir(tempDir);
   695→  });
   696→
   697→  it('should derive task from spec item', () => {
   698→    const output = kspec('derive @test-feature', tempDir);
   699→    expect(output).toContain('Created');
   700→
   701→    // Verify task was created with spec_ref
   702→    const listOutput = kspec('tasks list', tempDir);
   703→    expect(listOutput).toContain('Test Feature');
   704→  });
   705→
   706→  it('should show dry-run without creating', () => {
   707→    const output = kspec('derive @test-feature --dry-run', tempDir);
   708→    expect(output).toContain('Would create');
   709→
   710→    // Verify no task was actually created
   711→    const listOutput = kspec('tasks list', tempDir);
   712→    expect(listOutput).not.toContain('Implement: Test Feature');
   713→  });
   714→
   715→  // AC: @cmd-derive ac-2
   716→  it('should recursively derive tasks for parent and children', () => {
   717→    // test-feature has one child: test-requirement
   718→    const output = kspec('derive @test-feature', tempDir);
   719→    expect(output).toContain('Created 2 task(s)');
   720→
   721→    // Verify both tasks were created
   722→    const listOutput = kspec('tasks list', tempDir);
   723→    expect(listOutput).toContain('Test Feature');
   724→    expect(listOutput).toContain('Test Requirement');
   725→  });
   726→
   727→  // AC: @cmd-derive ac-3
   728→  it('should only derive single item with --flat', () => {
   729→    const output = kspec('derive @test-feature --flat', tempDir);
   730→    expect(output).toContain('Created 1 task(s)');
   731→
   732→    // Verify only parent task was created, not child
   733→    const listOutput = kspec('tasks list', tempDir);
   734→    expect(listOutput).toContain('Test Feature');
   735→    expect(listOutput).not.toContain('Test Requirement');
   736→  });
   737→
   738→  // AC: @cmd-derive ac-4, ac-5
   739→  it('should set depends_on for child tasks', () => {
   740→    // Derive recursively to create both tasks
   741→    kspec('derive @test-feature', tempDir);
   742→
   743→    // Get the child task details
   744→    const taskOutput = kspec('task get @task-test-requirement --json', tempDir);
   745→    const task = JSON.parse(taskOutput);
   746→
   747→    // Child task should depend on parent task
   748→    expect(task.depends_on).toContain('@task-test-feature');
   749→  });
   750→
   751→  // AC: @cmd-derive ac-6
   752→  it('should use existing parent task for depends_on', () => {
   753→    // First derive just the parent
   754→    kspec('derive @test-feature --flat', tempDir);
   755→
   756→    // Then derive the child - should depend on existing parent task
   757→    kspec('derive @test-requirement', tempDir);
   758→
   759→    // Get the child task details
   760→    const taskOutput = kspec('task get @task-test-requirement --json', tempDir);
   761→    const task = JSON.parse(taskOutput);
   762→
   763→    // Child task should depend on existing parent task
   764→    expect(task.depends_on).toContain('@task-test-feature');
   765→  });
   766→
   767→  // AC: @cmd-derive ac-7
   768→  it('should skip existing tasks without --force', () => {
   769→    // First derive
   770→    kspec('derive @test-feature --flat', tempDir);
   771→
   772→    // Second derive should skip
   773→    const output = kspec('derive @test-feature --flat', tempDir);
   774→    expect(output).toContain('Skipped');
   775→    expect(output).toContain('task exists');
   776→  });
   777→
   778→  // AC: @cmd-derive ac-8
   779→  it('should handle partial derivation (some children have tasks)', () => {
   780→    // Derive the parent flat first
   781→    kspec('derive @test-feature --flat', tempDir);
   782→
   783→    // Now recursive derive the whole tree
   784→    const output = kspec('derive @test-feature', tempDir);
   785→
   786→    // Should create only the child, skip the parent
   787→    expect(output).toContain('Created 1 task(s)');
   788→    expect(output).toContain('Skipped 1');
   789→  });
   790→
   791→  // AC: @cmd-derive ac-10
   792→  it('should show dry-run for recursive derive', () => {
   793→    const output = kspec('derive @test-feature --dry-run', tempDir);
   794→    expect(output).toContain('Would create:');
   795→    expect(output).toContain('Test Feature');
   796→    expect(output).toContain('Test Requirement');
   797→    expect(output).toContain('depends:');
   798→  });
   799→
   800→  // AC: @cmd-derive ac-11
   801→  it('should output JSON with correct format', () => {
   802→    const output = kspec('derive @test-feature --dry-run --json', tempDir);
   803→    const results = JSON.parse(output);
   804→
   805→    expect(results).toHaveLength(2);
   806→    expect(results[0]).toHaveProperty('ulid');
   807→    expect(results[0]).toHaveProperty('slug');
   808→    expect(results[0]).toHaveProperty('spec_ref');
   809→    expect(results[0]).toHaveProperty('depends_on');
   810→    expect(results[0]).toHaveProperty('action');
   811→
   812→    // First item (parent) should have no deps
   813→    expect(results[0].depends_on).toEqual([]);
   814→
   815→    // Second item (child) should depend on parent
   816→    expect(results[1].depends_on).toContain('@task-test-feature');
   817→  });
   818→
   819→  // AC: @cmd-derive ac-13
   820→  it('should error on invalid reference', () => {
   821→    expect(() => {
   822→      execSync(`npx tsx ${CLI_PATH} derive @nonexistent`, {
   823→        cwd: tempDir,
   824→        encoding: 'utf-8',
   825→        stdio: ['pipe', 'pipe', 'pipe'],
   826→      });
   827→    }).toThrow();
   828→  });
   829→});
