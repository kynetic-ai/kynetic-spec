  1268→describe('Integration: link commands', () => {
  1269→  let tempDir: string;
  1270→
  1271→  beforeEach(async () => {
  1272→    tempDir = await setupTempFixtures();
  1273→  });
  1274→
  1275→  afterEach(async () => {
  1276→    await cleanupTempDir(tempDir);
  1277→  });
  1278→
  1279→  it('should create a relationship between items', () => {
  1280→    const output = kspec('link create @test-core @test-feature --type depends_on', tempDir);
  1281→    expect(output).toContain('OK');
  1282→    expect(output).toContain('Created relationship');
  1283→    expect(output).toContain('depends_on');
  1284→  });
  1285→
  1286→  it('should list relationships from an item', () => {
  1287→    // Create a relationship first
  1288→    kspec('link create @test-feature @test-requirement --type implements', tempDir);
  1289→
  1290→    // List it
  1291→    const output = kspec('link list --from @test-feature', tempDir);
  1292→    expect(output).toContain('Relationships from @test-feature');
  1293→    expect(output).toContain('implements');
  1294→    expect(output).toContain('@test-requirement');
  1295→  });
  1296→
  1297→  it('should list relationships to an item (reverse lookup)', () => {
  1298→    // Create a relationship
  1299→    kspec('link create @test-feature @test-requirement --type implements', tempDir);
  1300→
  1301→    // List reverse
  1302→    const output = kspec('link list --to @test-requirement', tempDir);
  1303→    expect(output).toContain('Relationships to @test-requirement');
  1304→    expect(output).toContain('implements');
  1305→    expect(output).toContain('@test-feature');
  1306→  });
  1307→
  1308→  it('should filter relationships by type', () => {
  1309→    // Create different types of relationships
  1310→    kspec('link create @test-feature @test-requirement --type implements', tempDir);
  1311→    kspec('link create @test-feature @test-core --type depends_on', tempDir);
  1312→
  1313→    // Filter by type
  1314→    const output = kspec('link list --from @test-feature --type implements', tempDir);
  1315→    expect(output).toContain('implements');
  1316→    expect(output).not.toContain('depends_on');
  1317→  });
  1318→
  1319→  it('should delete a relationship', () => {
  1320→    // Create relationship
  1321→    kspec('link create @test-feature @test-requirement --type relates_to', tempDir);
  1322→
  1323→    // Delete it
  1324→    const output = kspec('link delete @test-feature @test-requirement --type relates_to', tempDir);
  1325→    expect(output).toContain('OK');
  1326→    expect(output).toContain('Removed relationship');
  1327→
  1328→    // Verify it's gone
  1329→    const listOutput = kspec('link list --from @test-feature', tempDir);
  1330→    expect(listOutput).toContain('No relationships found');
  1331→  });
  1332→
  1333→  it('should not create duplicate relationships', () => {
  1334→    // Create relationship
  1335→    kspec('link create @test-feature @test-requirement --type depends_on', tempDir);
  1336→
  1337→    // Try to create again
  1338→    const output = kspec('link create @test-feature @test-requirement --type depends_on', tempDir);
  1339→    expect(output).toContain('already exists');
  1340→  });
  1341→
  1342→  it('should error on invalid relationship type', () => {
  1343→    expect(() => {
  1344→      execSync(
  1345→        `npx tsx ${CLI_PATH} link create @test-feature @test-requirement --type invalid_type`,
  1346→        { cwd: tempDir, encoding: 'utf-8', stdio: 'pipe' }
  1347→      );
  1348→    }).toThrow();
  1349→  });
  1350→
  1351→  it('should error when referencing non-existent item', () => {
  1352→    expect(() => {
  1353→      execSync(
  1354→        `npx tsx ${CLI_PATH} link create @test-feature @nonexistent --type depends_on`,
  1355→        { cwd: tempDir, encoding: 'utf-8', stdio: 'pipe' }
  1356→      );
  1357→    }).toThrow();
  1358→  });
  1359→
  1360→  it('should return JSON with --json flag', () => {
  1361→    const result = kspecJson<{ success: boolean; from: string; to: string; type: string }>(
  1362→      'link create @test-feature @test-requirement --type depends_on',
  1363→      tempDir
  1364→    );
  1365→    expect(result.success).toBe(true);
  1366→    expect(result.from).toBe('@test-feature');
  1367→    expect(result.to).toBe('@test-requirement');
  1368→    expect(result.type).toBe('depends_on');
  1369→  });
  1370→});
