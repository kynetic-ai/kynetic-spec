   579→
   580→    // This should not throw
   581→    kspec('item patch @allow-unknown-test --data \'{"custom_field":"value"}\' --allow-unknown', tempDir);
   582→  });
   583→
   584→  // AC: @item-patch ac-7
   585→  it('should patch multiple items from JSONL', () => {
   586→    kspec('item add --under @test-core --title "Bulk Test 1" --slug bulk-test-1 --type feature', tempDir);
   587→    kspec('item add --under @test-core --title "Bulk Test 2" --slug bulk-test-2 --type feature', tempDir);
   588→
   589→    const jsonl = '{"ref":"@bulk-test-1","data":{"priority":"high"}}\\n{"ref":"@bulk-test-2","data":{"priority":"low"}}';
   590→    const result = execSync(
   591→      `printf '${jsonl}' | npx tsx ${CLI_PATH} item patch --bulk --json`,
   592→      { cwd: tempDir, encoding: 'utf-8' }
   593→    );
   594→
   595→    const parsed = JSON.parse(result);
   596→    expect(parsed.summary.total).toBe(2);
   597→    expect(parsed.summary.updated).toBe(2);
   598→  });
   599→
   600→  // AC: @item-patch ac-8
   601→  it('should patch multiple items from JSON array', () => {
   602→    kspec('item add --under @test-core --title "Array Test 1" --slug array-test-1 --type feature', tempDir);
   603→    kspec('item add --under @test-core --title "Array Test 2" --slug array-test-2 --type feature', tempDir);
   604→
   605→    const json = JSON.stringify([
   606→      { ref: '@array-test-1', data: { priority: 'high' } },
   607→      { ref: '@array-test-2', data: { priority: 'low' } }
   608→    ]);
   609→    const result = execSync(
   610→      `echo '${json}' | npx tsx ${CLI_PATH} item patch --bulk --json`,
   611→      { cwd: tempDir, encoding: 'utf-8' }
   612→    );
   613→
   614→    const parsed = JSON.parse(result);
   615→    expect(parsed.summary.updated).toBe(2);
   616→  });
   617→
   618→  // AC: @item-patch ac-9
   619→  it('should continue on error by default in bulk mode', () => {
   620→    kspec('item add --under @test-core --title "Continue Test" --slug continue-test --type feature', tempDir);
   621→
   622→    const jsonl = '{"ref":"@nonexistent","data":{"title":"X"}}\\n{"ref":"@continue-test","data":{"priority":"high"}}';
   623→    try {
   624→      const result = execSync(
   625→        `printf '${jsonl}' | npx tsx ${CLI_PATH} item patch --bulk --json`,
   626→        { cwd: tempDir, encoding: 'utf-8' }
   627→      );
   628→      const parsed = JSON.parse(result);
   629→      expect(parsed.summary.failed).toBe(1);
   630→      expect(parsed.summary.updated).toBe(1);
   631→    } catch (error: unknown) {
   632→      // Command exits with 1 when there are failures, but stdout has the result
   633→      const execError = error as { stdout?: string };
   634→      if (execError.stdout) {
   635→        const parsed = JSON.parse(execError.stdout);
   636→        expect(parsed.summary.failed).toBe(1);
   637→        expect(parsed.summary.updated).toBe(1);
   638→      } else {
   639→        throw error;
   640→      }
   641→    }
   642→  });
   643→
   644→  // AC: @item-patch ac-10
   645→  it('should stop on first error with --fail-fast', () => {
   646→    kspec('item add --under @test-core --title "Failfast Test" --slug failfast-test --type feature', tempDir);
   647→
   648→    const jsonl = '{"ref":"@nonexistent","data":{"title":"X"}}\\n{"ref":"@failfast-test","data":{"priority":"high"}}';
   649→    try {
   650→      execSync(
   651→        `printf '${jsonl}' | npx tsx ${CLI_PATH} item patch --bulk --fail-fast --json`,
   652→        { cwd: tempDir, encoding: 'utf-8' }
   653→      );
   654→    } catch (error: unknown) {
   655→      const execError = error as { stdout?: string };
   656→      if (execError.stdout) {
   657→        const parsed = JSON.parse(execError.stdout);
   658→        expect(parsed.summary.failed).toBe(1);
   659→        expect(parsed.summary.skipped).toBe(1);
   660→        expect(parsed.summary.updated).toBe(0);
   661→      }
   662→    }
   663→  });
   664→
   665→  // AC: @item-patch ac-11
   666→  it('should reject task refs', () => {
   667→    expect(() => {
   668→      execSync(
   669→        `npx tsx ${CLI_PATH} item patch @test-task-pending --data '{"title":"X"}'`,
   670→        { cwd: tempDir, encoding: 'utf-8', stdio: 'pipe' }
   671→      );
   672→    }).toThrow(/is a task, not a spec item/);
   673→  });
   674→
   675→  // AC: @item-patch ac-12
   676→  it('should error on nonexistent ref', () => {
   677→    expect(() => {
   678→      execSync(
   679→        `npx tsx ${CLI_PATH} item patch @nonexistent --data '{"title":"X"}'`,
   680→        { cwd: tempDir, encoding: 'utf-8', stdio: 'pipe' }
   681→      );
   682→    }).toThrow(/Item not found/);
   683→  });
   684→});
