  1043→describe('Integration: task delete', () => {
  1044→  let tempDir: string;
  1045→
  1046→  beforeEach(async () => {
  1047→    tempDir = await setupTempFixtures();
  1048→  });
  1049→
  1050→  afterEach(async () => {
  1051→    await cleanupTempDir(tempDir);
  1052→  });
  1053→
  1054→  // AC: @cmd-task-delete ac-1
  1055→  it('should show dry-run output without deleting', () => {
  1056→    // First create a task to delete
  1057→    kspec('task add --title "Task to Delete" --slug delete-test', tempDir);
  1058→
  1059→    // Verify task exists
  1060→    const before = kspec('tasks list', tempDir);
  1061→    expect(before).toContain('Task to Delete');
  1062→
  1063→    // Run dry-run
  1064→    const output = kspec('task delete @delete-test --dry-run', tempDir);
  1065→    expect(output).toContain('Would delete task');
  1066→    expect(output).toContain('Task to Delete');
  1067→    expect(output).toContain('Source file:');
  1068→
  1069→    // Verify task still exists
  1070→    const after = kspec('tasks list', tempDir);
  1071→    expect(after).toContain('Task to Delete');
  1072→  });
  1073→
  1074→  // AC: @cmd-task-delete ac-2
  1075→  it('should delete task with --force', () => {
  1076→    // First create a task to delete
  1077→    kspec('task add --title "Task to Force Delete" --slug force-delete-test', tempDir);
  1078→
  1079→    // Verify task exists
  1080→    const before = kspec('tasks list', tempDir);
  1081→    expect(before).toContain('Task to Force Delete');
  1082→
  1083→    // Delete with --force
  1084→    const output = kspec('task delete @force-delete-test --force', tempDir);
  1085→    expect(output).toContain('Deleted task');
  1086→    expect(output).toContain('Task to Force Delete');
  1087→
  1088→    // Verify task is gone
  1089→    const after = kspec('tasks list', tempDir);
  1090→    expect(after).not.toContain('Task to Force Delete');
  1091→  });
  1092→
  1093→  it('should reject deleting nonexistent task', () => {
