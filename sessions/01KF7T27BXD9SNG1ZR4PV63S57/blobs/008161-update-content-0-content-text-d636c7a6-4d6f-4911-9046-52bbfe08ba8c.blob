     1→/**
     2→ * Validation module for kspec files.
     3→ *
     4→ * Provides schema validation, reference validation, and orphan detection.
     5→ */
     6→
     7→import * as fs from 'node:fs/promises';
     8→import * as path from 'node:path';
     9→import {
    10→  TaskSchema,
    11→  TasksFileSchema,
    12→  ManifestSchema,
    13→  SpecItemSchema,
    14→  MetaManifestSchema,
    15→  AgentSchema,
    16→  WorkflowSchema,
    17→  ConventionSchema,
    18→  ObservationSchema,
    19→  UlidSchema,
    20→} from '../schema/index.js';
    21→import type { KspecContext, LoadedTask, LoadedSpecItem } from './yaml.js';
    22→import {
    23→  readYamlFile,
    24→  findTaskFiles,
    25→  loadSpecFile,
    26→  expandIncludePattern,
    27→} from './yaml.js';
    28→import { ReferenceIndex, validateRefs, type RefValidationError } from './refs.js';
    29→import { findMetaManifest, loadMetaContext, type MetaContext } from './meta.js';
    30→
    31→// ============================================================
    32→// TYPES
    33→// ============================================================
    34→
    35→/**
    36→ * Schema validation error
    37→ */
    38→export interface SchemaValidationError {
    39→  file: string;
    40→  path?: string;
    41→  message: string;
    42→  details?: unknown;
    43→}
    44→
    45→/**
    46→ * Orphan item (not referenced by anything)
    47→ */
    48→export interface OrphanItem {
    49→  ulid: string;
    50→  title: string;
    51→  type: string;
    52→  file?: string;
    53→}
    54→
    55→/**
    56→ * Complete validation result
    57→ */
    58→export interface ValidationResult {
    59→  valid: boolean;
    60→  schemaErrors: SchemaValidationError[];
    61→  refErrors: RefValidationError[];
    62→  orphans: OrphanItem[];
    63→  stats: {
    64→    filesChecked: number;
    65→    itemsChecked: number;
    66→    tasksChecked: number;
    67→  };
    68→  metaStats?: {
    69→    agents: number;
    70→    workflows: number;
    71→    conventions: number;
    72→    observations: number;
    73→  };
    74→}
    75→
    76→/**
    77→ * Validation options
    78→ */
    79→export interface ValidateOptions {
    80→  /** Check schema conformance */
    81→  schema?: boolean;
    82→  /** Check reference resolution */
    83→  refs?: boolean;
    84→  /** Find orphaned items */
    85→  orphans?: boolean;
    86→}
    87→
    88→// ============================================================
    89→// SCHEMA VALIDATION
    90→// ============================================================
    91→
    92→/**
    93→ * Validate a manifest file against schema
    94→ */
    95→async function validateManifestFile(filePath: string): Promise<SchemaValidationError[]> {
    96→  const errors: SchemaValidationError[] = [];
    97→
    98→  try {
    99→    const raw = await readYamlFile<unknown>(filePath);
   100→    const result = ManifestSchema.safeParse(raw);
   101→
   102→    if (!result.success) {
   103→      for (const issue of result.error.issues) {
   104→        errors.push({
   105→          file: filePath,
   106→          path: issue.path.join('.'),
   107→          message: issue.message,
   108→          details: issue,
   109→        });
   110→      }
   111→    }
   112→  } catch (err) {
   113→    errors.push({
   114→      file: filePath,
   115→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   116→    });
   117→  }
   118→
   119→  return errors;
   120→}
   121→
   122→/**
   123→ * Validate a tasks file against schema
   124→ */
   125→async function validateTasksFile(filePath: string): Promise<SchemaValidationError[]> {
   126→  const errors: SchemaValidationError[] = [];
   127→
   128→  try {
   129→    const raw = await readYamlFile<unknown>(filePath);
   130→
   131→    // Handle both formats: { tasks: [...] } and plain array
   132→    let taskList: unknown[];
   133→
   134→    if (Array.isArray(raw)) {
   135→      taskList = raw;
   136→    } else if (raw && typeof raw === 'object' && 'tasks' in raw) {
   137→      // Try full TasksFile schema first
   138→      const fileResult = TasksFileSchema.safeParse(raw);
   139→      if (!fileResult.success) {
   140→        // If TasksFile fails, just validate individual tasks
   141→        taskList = (raw as { tasks: unknown[] }).tasks || [];
   142→      } else {
   143→        // File schema passed, validate individual tasks for detailed errors
   144→        taskList = fileResult.data.tasks;
   145→      }
   146→    } else {
   147→      errors.push({
   148→        file: filePath,
   149→        message: 'Invalid tasks file format: expected array or { tasks: [...] }',
   150→      });
   151→      return errors;
   152→    }
   153→
   154→    // Validate each task
   155→    for (let i = 0; i < taskList.length; i++) {
   156→      const task = taskList[i];
   157→      const result = TaskSchema.safeParse(task);
   158→
   159→      if (!result.success) {
   160→        for (const issue of result.error.issues) {
   161→          errors.push({
   162→            file: filePath,
   163→            path: `tasks[${i}].${issue.path.join('.')}`,
   164→            message: issue.message,
   165→            details: issue,
   166→          });
   167→        }
   168→      }
   169→    }
   170→  } catch (err) {
   171→    errors.push({
   172→      file: filePath,
   173→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   174→    });
   175→  }
   176→
   177→  return errors;
   178→}
   179→
   180→/**
   181→ * Validate a spec module file against schema
   182→ */
   183→async function validateSpecFile(filePath: string): Promise<SchemaValidationError[]> {
   184→  const errors: SchemaValidationError[] = [];
   185→
   186→  try {
   187→    const raw = await readYamlFile<unknown>(filePath);
   188→
   189→    // Recursively validate spec items
   190→    validateSpecItemRecursive(raw, filePath, '', errors);
   191→  } catch (err) {
   192→    errors.push({
   193→      file: filePath,
   194→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   195→    });
   196→  }
   197→
   198→  return errors;
   199→}
   200→
   201→/**
   202→ * Validate meta manifest file with strict ULID validation
   203→ * AC-meta-manifest-3: Invalid schema exits with code 1 and shows field path + expected type
   204→ */
   205→async function validateMetaManifestFile(filePath: string): Promise<SchemaValidationError[]> {
   206→  const errors: SchemaValidationError[] = [];
   207→
   208→  try {
   209→    const raw = await readYamlFile<unknown>(filePath);
   210→
   211→    // Validate overall manifest structure
   212→    const manifestResult = MetaManifestSchema.safeParse(raw);
   213→    if (!manifestResult.success) {
   214→      for (const issue of manifestResult.error.issues) {
   215→        errors.push({
   216→          file: filePath,
   217→          path: issue.path.join('.'),
   218→          message: issue.message,
   219→          details: issue,
   220→        });
   221→      }
   222→      return errors;
   223→    }
   224→
   225→    // Validate each agent with strict ULID validation
   226→    if (raw && typeof raw === 'object' && 'agents' in raw && Array.isArray((raw as Record<string, unknown>).agents)) {
   227→      const agents = (raw as Record<string, unknown>).agents as unknown[];
   228→      for (let i = 0; i < agents.length; i++) {
   229→        const agent = agents[i];
   230→        const agentResult = AgentSchema.safeParse(agent);
   231→        if (!agentResult.success) {
   232→          for (const issue of agentResult.error.issues) {
   233→            errors.push({
   234→              file: filePath,
   235→              path: `agents[${i}].${issue.path.join('.')}`,
   236→              message: issue.message,
   237→              details: issue,
   238→            });
   239→          }
   240→        }
   241→
   242→        // Strict ULID validation
   243→        if (agent && typeof agent === 'object' && '_ulid' in agent) {
   244→          const ulidResult = UlidSchema.safeParse((agent as Record<string, unknown>)._ulid);
   245→          if (!ulidResult.success) {
   246→            errors.push({
   247→              file: filePath,
   248→              path: `agents[${i}]._ulid`,
   249→              message: 'Invalid ULID format (expected 26 characters)',
   250→            });
   251→          }
   252→        }
   253→      }
   254→    }
   255→
   256→    // Validate each workflow with strict ULID validation
   257→    if (raw && typeof raw === 'object' && 'workflows' in raw && Array.isArray((raw as Record<string, unknown>).workflows)) {
   258→      const workflows = (raw as Record<string, unknown>).workflows as unknown[];
   259→      for (let i = 0; i < workflows.length; i++) {
   260→        const workflow = workflows[i];
   261→        const workflowResult = WorkflowSchema.safeParse(workflow);
   262→        if (!workflowResult.success) {
   263→          for (const issue of workflowResult.error.issues) {
   264→            errors.push({
   265→              file: filePath,
   266→              path: `workflows[${i}].${issue.path.join('.')}`,
   267→              message: issue.message,
   268→              details: issue,
   269→            });
   270→          }
   271→        }
   272→
   273→        // Strict ULID validation
   274→        if (workflow && typeof workflow === 'object' && '_ulid' in workflow) {
   275→          const ulidResult = UlidSchema.safeParse((workflow as Record<string, unknown>)._ulid);
   276→          if (!ulidResult.success) {
   277→            errors.push({
   278→              file: filePath,
   279→              path: `workflows[${i}]._ulid`,
   280→              message: 'Invalid ULID format (expected 26 characters)',
   281→            });
   282→          }
   283→        }
   284→      }
   285→    }
   286→
   287→    // Validate each convention with strict ULID validation
   288→    if (raw && typeof raw === 'object' && 'conventions' in raw && Array.isArray((raw as Record<string, unknown>).conventions)) {
   289→      const conventions = (raw as Record<string, unknown>).conventions as unknown[];
   290→      for (let i = 0; i < conventions.length; i++) {
   291→        const convention = conventions[i];
   292→        const conventionResult = ConventionSchema.safeParse(convention);
   293→        if (!conventionResult.success) {
   294→          for (const issue of conventionResult.error.issues) {
   295→            errors.push({
   296→              file: filePath,
   297→              path: `conventions[${i}].${issue.path.join('.')}`,
   298→              message: issue.message,
   299→              details: issue,
   300→            });
   301→          }
   302→        }
   303→
   304→        // Strict ULID validation
   305→        if (convention && typeof convention === 'object' && '_ulid' in convention) {
   306→          const ulidResult = UlidSchema.safeParse((convention as Record<string, unknown>)._ulid);
   307→          if (!ulidResult.success) {
   308→            errors.push({
   309→              file: filePath,
   310→              path: `conventions[${i}]._ulid`,
   311→              message: 'Invalid ULID format (expected 26 characters)',
   312→            });
   313→          }
   314→        }
   315→      }
   316→    }
   317→
   318→    // Validate each observation with strict ULID validation
   319→    if (raw && typeof raw === 'object' && 'observations' in raw && Array.isArray((raw as Record<string, unknown>).observations)) {
   320→      const observations = (raw as Record<string, unknown>).observations as unknown[];
   321→      for (let i = 0; i < observations.length; i++) {
   322→        const observation = observations[i];
   323→        const observationResult = ObservationSchema.safeParse(observation);
   324→        if (!observationResult.success) {
   325→          for (const issue of observationResult.error.issues) {
   326→            errors.push({
   327→              file: filePath,
   328→              path: `observations[${i}].${issue.path.join('.')}`,
   329→              message: issue.message,
   330→              details: issue,
   331→            });
   332→          }
   333→        }
   334→
   335→        // Strict ULID validation
   336→        if (observation && typeof observation === 'object' && '_ulid' in observation) {
   337→          const ulidResult = UlidSchema.safeParse((observation as Record<string, unknown>)._ulid);
   338→          if (!ulidResult.success) {
   339→            errors.push({
   340→              file: filePath,
   341→              path: `observations[${i}]._ulid`,
   342→              message: 'Invalid ULID format (expected 26 characters)',
   343→            });
   344→          }
   345→        }
   346→      }
   347→    }
   348→  } catch (err) {
   349→    errors.push({
   350→      file: filePath,
   351→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   352→    });
   353→  }
   354→
   355→  return errors;
   356→}
   357→
   358→/**
   359→ * Recursively validate spec items in a structure
   360→ */
   361→function validateSpecItemRecursive(
   362→  raw: unknown,
   363→  file: string,
   364→  pathPrefix: string,
   365→  errors: SchemaValidationError[]
   366→): void {
   367→  if (!raw || typeof raw !== 'object') return;
   368→
   369→  // Check if this is a spec item (has _ulid)
   370→  if ('_ulid' in raw) {
   371→    const result = SpecItemSchema.safeParse(raw);
   372→    if (!result.success) {
   373→      for (const issue of result.error.issues) {
   374→        errors.push({
   375→          file,
   376→          path: pathPrefix ? `${pathPrefix}.${issue.path.join('.')}` : issue.path.join('.'),
   377→          message: issue.message,
   378→          details: issue,
   379→        });
   380→      }
   381→    }
   382→  }
   383→
   384→  // Recurse into nested structures
   385→  const nestedFields = ['modules', 'features', 'requirements', 'constraints', 'decisions', 'items'];
   386→  const obj = raw as Record<string, unknown>;
   387→
   388→  for (const field of nestedFields) {
   389→    if (field in obj && Array.isArray(obj[field])) {
   390→      const arr = obj[field] as unknown[];
   391→      for (let i = 0; i < arr.length; i++) {
   392→        const newPath = pathPrefix ? `${pathPrefix}.${field}[${i}]` : `${field}[${i}]`;
   393→        validateSpecItemRecursive(arr[i], file, newPath, errors);
   394→      }
   395→    }
   396→  }
   397→}
   398→
   399→// ============================================================
   400→// ORPHAN DETECTION
   401→// ============================================================
   402→
   403→/**
   404→ * Find items that are not referenced by any other item
   405→ */
   406→function findOrphans(
   407→  tasks: LoadedTask[],
   408→  items: LoadedSpecItem[],
   409→  index: ReferenceIndex
   410→): OrphanItem[] {
   411→  const orphans: OrphanItem[] = [];
   412→
   413→  // Build set of all referenced ULIDs
   414→  const referenced = new Set<string>();
   415→
   416→  const allItems = [...tasks, ...items];
   417→
   418→  // Fields that contain references
   419→  const refFields = [
   420→    'depends_on',
   421→    'blocked_by',
   422→    'implements',
   423→    'relates_to',
   424→    'tests',
   425→    'supersedes',
   426→    'spec_ref',
   427→    'context',
   428→  ];
   429→
   430→  for (const item of allItems) {
   431→    const obj = item as unknown as Record<string, unknown>;
   432→
   433→    for (const field of refFields) {
   434→      const value = obj[field];
   435→
   436→      if (typeof value === 'string' && value.startsWith('@')) {
   437→        const resolved = index.resolve(value);
   438→        if (resolved.ok) {
   439→          referenced.add(resolved.ulid);
   440→        }
   441→      } else if (Array.isArray(value)) {
   442→        for (const v of value) {
   443→          if (typeof v === 'string' && v.startsWith('@')) {
   444→            const resolved = index.resolve(v);
   445→            if (resolved.ok) {
   446→              referenced.add(resolved.ulid);
   447→            }
   448→          }
   449→        }
   450→      }
   451→    }
   452→  }
   453→
   454→  // Find items not in the referenced set
   455→  // Skip entry point types: modules are spec entry points, tasks are work items
   456→  const entryPointTypes = ['module', 'task', 'epic', 'bug', 'spike', 'infra'];
   457→
   458→  for (const item of items) {
   459→    // Only check spec items, not tasks
   460→    if (!referenced.has(item._ulid)) {
   461→      // Skip entry point types
   462→      if (entryPointTypes.includes(item.type || '')) continue;
   463→
   464→      // Skip nested items - they're implicitly referenced by their parent
   465→      // _path indicates nesting (e.g., "features[0].requirements[2]")
   466→      if (item._path) continue;
   467→
   468→      orphans.push({
   469→        ulid: item._ulid,
   470→        title: item.title,
   471→        type: item.type || 'unknown',
   472→        file: item._sourceFile,
   473→      });
   474→    }
   475→  }
   476→
   477→  return orphans;
   478→}
   479→
   480→// ============================================================
   481→// MAIN VALIDATION
   482→// ============================================================
   483→
   484→/**
   485→ * Run full validation on a kspec project
   486→ */
   487→export async function validate(
   488→  ctx: KspecContext,
   489→  options: ValidateOptions = {}
   490→): Promise<ValidationResult> {
   491→  // Default: run all checks
   492→  const runSchema = options.schema !== false;
   493→  const runRefs = options.refs !== false;
   494→  const runOrphans = options.orphans !== false;
   495→
   496→  const result: ValidationResult = {
   497→    valid: true,
   498→    schemaErrors: [],
   499→    refErrors: [],
   500→    orphans: [],
   501→    stats: {
   502→      filesChecked: 0,
   503→      itemsChecked: 0,
   504→      tasksChecked: 0,
   505→    },
   506→  };
   507→
   508→  const allTasks: LoadedTask[] = [];
   509→  const allItems: LoadedSpecItem[] = [];
   510→
   511→  // Validate manifest
   512→  if (ctx.manifestPath && runSchema) {
   513→    const manifestErrors = await validateManifestFile(ctx.manifestPath);
   514→    result.schemaErrors.push(...manifestErrors);
   515→    result.stats.filesChecked++;
   516→  }
   517→
   518→  // Find and validate task files
   519→  const taskFiles = await findTaskFiles(ctx.rootDir);
   520→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, 'spec'));
   521→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
   522→
   523→  for (const taskFile of allTaskFiles) {
   524→    if (runSchema) {
   525→      const taskErrors = await validateTasksFile(taskFile);
   526→      result.schemaErrors.push(...taskErrors);
   527→    }
   528→    result.stats.filesChecked++;
   529→
   530→    // Load tasks for ref validation
   531→    try {
   532→      const raw = await readYamlFile<unknown>(taskFile);
   533→      let taskList: unknown[] = [];
   534→
   535→      if (Array.isArray(raw)) {
   536→        taskList = raw;
   537→      } else if (raw && typeof raw === 'object' && 'tasks' in raw) {
   538→        taskList = (raw as { tasks: unknown[] }).tasks || [];
   539→      }
   540→
   541→      for (const t of taskList) {
   542→        const parsed = TaskSchema.safeParse(t);
   543→        if (parsed.success) {
   544→          allTasks.push({ ...parsed.data, _sourceFile: taskFile });
   545→          result.stats.tasksChecked++;
   546→        }
   547→      }
   548→    } catch {
   549→      // Already reported in schema validation
   550→    }
   551→  }
   552→
   553→  // Validate spec files (from includes)
   554→  if (ctx.manifest && ctx.manifestPath) {
   555→    const manifestDir = path.dirname(ctx.manifestPath);
   556→    const includes = ctx.manifest.includes || [];
   557→
   558→    for (const include of includes) {
   559→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   560→
   561→      for (const filePath of expandedPaths) {
   562→        if (runSchema) {
   563→          const specErrors = await validateSpecFile(filePath);
   564→          result.schemaErrors.push(...specErrors);
   565→        }
   566→        result.stats.filesChecked++;
   567→
   568→        // Load items for ref validation
   569→        try {
   570→          const items = await loadSpecFile(filePath);
   571→          allItems.push(...items);
   572→          result.stats.itemsChecked += items.length;
   573→        } catch {
   574→          // Already reported in schema validation
   575→        }
   576→      }
   577→    }
   578→  }
   579→
   580→  // Load meta items for reference validation
   581→  // AC: @agent-definitions ac-agent-3
   582→  const metaCtx = await loadMetaContext(ctx);
   583→  const allMetaItems = [
   584→    ...metaCtx.agents,
   585→    ...metaCtx.workflows,
   586→    ...metaCtx.conventions,
   587→    ...metaCtx.observations,
   588→  ];
   589→
   590→  // Reference validation
   591→  if (runRefs && (allTasks.length > 0 || allItems.length > 0 || allMetaItems.length > 0)) {
   592→    const index = new ReferenceIndex(allTasks, allItems, allMetaItems);
   593→    result.refErrors = validateRefs(index, allTasks, allItems);
   594→
   595→    // Orphan detection
   596→    if (runOrphans) {
   597→      result.orphans = findOrphans(allTasks, allItems, index);
   598→    }
   599→  }
   600→
   601→  // Meta manifest validation (AC-meta-manifest-2, AC-meta-manifest-3)
   602→  const metaManifestPath = await findMetaManifest(ctx.specDir);
   603→  if (metaManifestPath) {
   604→    // Use metaCtx already loaded above
   605→    result.metaStats = {
   606→      agents: metaCtx.agents.length,
   607→      workflows: metaCtx.workflows.length,
   608→      conventions: metaCtx.conventions.length,
   609→      observations: metaCtx.observations.length,
   610→    };
   611→
   612→    // Validate meta manifest schema with strict ULID validation
   613→    if (runSchema) {
   614→      const metaErrors = await validateMetaManifestFile(metaManifestPath);
   615→      // Prefix all meta errors with "meta:"
   616→      for (const err of metaErrors) {
   617→        err.path = err.path ? `meta:${err.path}` : 'meta:';
   618→      }
   619→      result.schemaErrors.push(...metaErrors);
   620→      result.stats.filesChecked++;
   621→    }
   622→  }
   623→
   624→  // Set valid flag
   625→  result.valid = result.schemaErrors.length === 0 && result.refErrors.length === 0;
   626→
   627→  return result;
   628→}
   629→

<system-reminder>
