```
     1→/**
     2→ * Meta CLI commands for interacting with meta-spec.
     3→ *
     4→ * AC-meta-manifest-1: kspec meta show outputs summary
     5→ * AC-meta-manifest-2: kspec validate includes meta line
     6→ * AC-meta-manifest-3: kspec validate shows meta errors with prefix
     7→ * AC-agent-1: kspec meta agents outputs table
     8→ * AC-agent-2: kspec meta agents --json outputs JSON
     9→ */
    10→
    11→import { Command } from 'commander';
    12→import chalk from 'chalk';
    13→import Table from 'cli-table3';
    14→import { ulid } from 'ulid';
    15→import {
    16→  initContext,
    17→  loadMetaContext,
    18→  getMetaStats,
    19→  createObservation,
    20→  saveObservation,
    21→  saveMetaItem,
    22→  deleteMetaItem,
    23→  createTask,
    24→  saveTask,
    25→  loadAllTasks,
    26→  type MetaContext,
    27→  type Agent,
    28→  type Workflow,
    29→  type Convention,
    30→  type Observation,
    31→} from '../../parser/index.js';
    32→import { type ObservationType } from '../../schema/index.js';
    33→import { output, error, success, isJsonMode } from '../output.js';
    34→
    35→/**
    36→ * Resolve a meta reference to its ULID
    37→ * Handles semantic IDs (agent.id, workflow.id, convention.domain) and ULID prefixes
    38→ */
    39→function resolveMetaRefToUlid(
    40→  ref: string,
    41→  metaCtx: MetaContext
    42→): { ulid: string; type: 'agent' | 'workflow' | 'convention' | 'observation' } | null {
    43→  const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
    44→
    45→  // Check agents
    46→  const agent = (metaCtx.manifest?.agents || []).find(
    47→    (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
    48→  );
    49→  if (agent) return { ulid: agent._ulid, type: 'agent' };
    50→
    51→  // Check workflows
    52→  const workflow = (metaCtx.manifest?.workflows || []).find(
    53→    (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
    54→  );
    55→  if (workflow) return { ulid: workflow._ulid, type: 'workflow' };
    56→
    57→  // Check conventions
    58→  const convention = (metaCtx.manifest?.conventions || []).find(
    59→    (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
    60→  );
    61→  if (convention) return { ulid: convention._ulid, type: 'convention' };
    62→
    63→  // Check observations
    64→  const observation = (metaCtx.manifest?.observations || []).find((o) =>
    65→    o._ulid.startsWith(normalizedRef)
    66→  );
    67→  if (observation) return { ulid: observation._ulid, type: 'observation' };
    68→
    69→  return null;
    70→}
    71→
    72→/**
    73→ * Format meta show output
    74→ */
    75→function formatMetaShow(meta: MetaContext): void {
    76→  const stats = getMetaStats(meta);
    77→
    78→  if (!meta.manifest) {
    79→    console.log(chalk.yellow('No meta manifest found (kynetic.meta.yaml)'));
    80→    console.log(chalk.gray('Create one to define agents, workflows, conventions, and observations'));
    81→    return;
    82→  }
    83→
    84→  console.log(chalk.bold('Meta-Spec Summary'));
    85→  console.log(chalk.gray('─'.repeat(40)));
    86→  console.log(`Agents:       ${stats.agents}`);
    87→  console.log(`Workflows:    ${stats.workflows}`);
    88→  console.log(`Conventions:  ${stats.conventions}`);
    89→  console.log(`Observations: ${stats.observations} (${stats.unresolvedObservations} unresolved)`);
    90→}
    91→
    92→/**
    93→ * Format agents table output
    94→ * AC-agent-1: outputs table with columns: ID, Name, Capabilities
    95→ */
    96→function formatAgents(agents: Agent[]): void {
    97→  if (agents.length === 0) {
    98→    console.log(chalk.yellow('No agents defined'));
    99→    return;
   100→  }
   101→
   102→  const table = new Table({
   103→    head: [chalk.bold('ID'), chalk.bold('Name'), chalk.bold('Capabilities')],
   104→    style: {
   105→      head: [],
   106→      border: [],
   107→    },
   108→  });
   109→
   110→  for (const agent of agents) {
   111→    table.push([
   112→      agent.id,
   113→      agent.name,
   114→      agent.capabilities.join(', '),
   115→    ]);
   116→  }
   117→
   118→  console.log(table.toString());
   119→}
   120→
   121→/**
   122→ * Format workflows table output
   123→ * AC-workflow-1: outputs table with columns: ID, Trigger, Steps (count)
   124→ */
   125→function formatWorkflows(workflows: Workflow[]): void {
   126→  if (workflows.length === 0) {
   127→    console.log(chalk.yellow('No workflows defined'));
   128→    return;
   129→  }
   130→
   131→  const table = new Table({
   132→    head: [chalk.bold('ID'), chalk.bold('Trigger'), chalk.bold('Steps')],
   133→    style: {
   134→      head: [],
   135→      border: [],
   136→    },
   137→  });
   138→
   139→  for (const workflow of workflows) {
   140→    table.push([
   141→      workflow.id,
   142→      workflow.trigger,
   143→      workflow.steps.length.toString(),
   144→    ]);
   145→  }
   146→
   147→  console.log(table.toString());
   148→}
   149→
   150→/**
   151→ * Format workflows verbose output
   152→ * AC-workflow-2: outputs each workflow with full step list
   153→ */
   154→function formatWorkflowsVerbose(workflows: Workflow[]): void {
   155→  if (workflows.length === 0) {
   156→    console.log(chalk.yellow('No workflows defined'));
   157→    return;
   158→  }
   159→
   160→  for (const workflow of workflows) {
   161→    console.log(chalk.bold(`${workflow.id} - ${workflow.trigger}`));
   162→    if (workflow.description) {
   163→      console.log(chalk.gray(workflow.description));
   164→    }
   165→    console.log(chalk.gray('─'.repeat(60)));
   166→
   167→    for (const step of workflow.steps) {
   168→      const prefix = {
   169→        check: chalk.yellow('[check]'),
   170→        action: chalk.blue('[action]'),
   171→        decision: chalk.magenta('[decision]'),
   172→      }[step.type];
   173→
   174→      console.log(`${prefix} ${step.content}`);
   175→
   176→      if (step.on_fail) {
   177→        console.log(chalk.gray(`  → on fail: ${step.on_fail}`));
   178→      }
   179→
   180→      if (step.options && step.options.length > 0) {
   181→        for (const option of step.options) {
   182→          console.log(chalk.gray(`  • ${option}`));
   183→        }
   184→      }
   185→    }
   186→
   187→    console.log('');
   188→  }
   189→}
   190→
   191→/**
   192→ * Format conventions table output
   193→ * AC-conv-1: outputs table with columns: Domain, Rules (count), Validation (yes/no)
   194→ */
   195→function formatConventions(conventions: Convention[]): void {
   196→  if (conventions.length === 0) {
   197→    console.log(chalk.yellow('No conventions defined'));
   198→    return;
   199→  }
   200→
   201→  const table = new Table({
   202→    head: [chalk.bold('Domain'), chalk.bold('Rules'), chalk.bold('Validation')],
   203→    style: {
   204→      head: [],
   205→      border: [],
   206→    },
   207→  });
   208→
   209→  for (const convention of conventions) {
   210→    table.push([
   211→      convention.domain,
   212→      convention.rules.length.toString(),
   213→      convention.validation ? 'yes' : 'no',
   214→    ]);
   215→  }
   216→
   217→  console.log(table.toString());
   218→}
   219→
   220→/**
   221→ * Format convention detail output
   222→ * AC-conv-2: outputs full rules list and examples
   223→ */
   224→function formatConventionDetail(convention: Convention): void {
   225→  console.log(chalk.bold(`${convention.domain} Convention`));
   226→  console.log(chalk.gray('─'.repeat(60)));
   227→
   228→  console.log(chalk.bold('\nRules:'));
   229→  for (const rule of convention.rules) {
   230→    console.log(`  • ${rule}`);
   231→  }
   232→
   233→  if (convention.examples && convention.examples.length > 0) {
   234→    console.log(chalk.bold('\nExamples:'));
   235→    for (const example of convention.examples) {
   236→      console.log(chalk.green(`  ✓ ${example.good}`));
   237→      console.log(chalk.red(`  ✗ ${example.bad}`));
   238→    }
   239→  }
   240→
   241→  if (convention.validation) {
   242→    console.log(chalk.bold('\nValidation:'));
   243→    console.log(`  Type: ${convention.validation.type}`);
   244→    if (convention.validation.pattern) {
   245→      console.log(`  Pattern: ${convention.validation.pattern}`);
   246→    }
   247→    if (convention.validation.message) {
   248→      console.log(`  Message: ${convention.validation.message}`);
   249→    }
   250→  }
   251→
   252→  console.log('');
   253→}
   254→
   255→/**
   256→ * Format observations table output
   257→ * AC-obs-2: outputs table with columns: ID, Type, Workflow, Created, Content (truncated)
   258→ */
   259→function formatObservations(observations: Observation[], showResolved: boolean): void {
   260→  const filtered = showResolved ? observations : observations.filter(o => !o.resolved);
   261→
   262→  if (filtered.length === 0) {
   263→    console.log(chalk.yellow(showResolved ? 'No observations found' : 'No unresolved observations'));
   264→    return;
   265→  }
   266→
   267→  const table = new Table({
   268→    head: [
   269→      chalk.bold('ID'),
   270→      chalk.bold('Type'),
   271→      chalk.bold('Workflow'),
   272→      chalk.bold('Created'),
   273→      chalk.bold('Content'),
   274→    ],
   275→    style: {
   276→      head: [],
   277→      border: [],
   278→    },
   279→    colWidths: [10, 10, 20, 12, 50],
   280→    wordWrap: true,
   281→  });
   282→
   283→  for (const obs of filtered) {
   284→    const id = obs._ulid.substring(0, 8);
   285→    const workflow = obs.workflow_ref || '-';
   286→    const created = new Date(obs.created_at).toISOString().split('T')[0];
   287→    const content = obs.content.length > 47 ? obs.content.substring(0, 47) + '...' : obs.content;
   288→
   289→    table.push([id, obs.type, workflow, created, content]);
   290→  }
   291→
   292→  console.log(table.toString());
   293→}
   294→
   295→/**
   296→ * Register meta commands
   297→ */
   298→export function registerMetaCommands(program: Command): void {
   299→  const meta = program
   300→    .command('meta')
   301→    .description('Meta-spec commands (agents, workflows, conventions, observations)');
   302→
   303→  // AC-meta-manifest-1: kspec meta show outputs summary with counts
   304→  meta
   305→    .command('show')
   306→    .description('Display meta-spec summary')
   307→    .action(async () => {
   308→      try {
   309→        const ctx = await initContext();
   310→
   311→        if (!ctx.manifestPath) {
   312→          error('No kspec project found');
   313→          process.exit(1);
   314→        }
   315→
   316→        const metaCtx = await loadMetaContext(ctx);
   317→        const stats = getMetaStats(metaCtx);
   318→
   319→        output(
   320→          {
   321→            manifest: metaCtx.manifestPath,
   322→            stats,
   323→          },
   324→          () => formatMetaShow(metaCtx)
   325→        );
   326→      } catch (err) {
   327→        error('Failed to show meta', err);
   328→        process.exit(1);
   329→      }
   330→    });
   331→
   332→  // AC-agent-1, AC-agent-2: kspec meta agents
   333→  meta
   334→    .command('agents')
   335→    .description('List agents defined in meta-spec')
   336→    .action(async () => {
   337→      try {
   338→        const ctx = await initContext();
   339→
   340→        if (!ctx.manifestPath) {
   341→          error('No kspec project found');
   342→          process.exit(1);
   343→        }
   344→
   345→        const metaCtx = await loadMetaContext(ctx);
   346→        const agents = metaCtx.manifest?.agents || [];
   347→
   348→        // AC-agent-2: JSON output includes full agent details
   349→        output(
   350→          agents.map((agent) => ({
   351→            id: agent.id,
   352→            name: agent.name,
   353→            description: agent.description,
   354→            capabilities: agent.capabilities,
   355→            tools: agent.tools,
   356→            session_protocol: agent.session_protocol,
   357→            conventions: agent.conventions,
   358→          })),
   359→          // AC-agent-1: Table output with ID, Name, Capabilities
   360→          () => formatAgents(agents)
   361→        );
   362→      } catch (err) {
   363→        error('Failed to list agents', err);
   364→        process.exit(1);
   365→      }
   366→    });
   367→
   368→  // AC-workflow-1, AC-workflow-2, AC-workflow-4: kspec meta workflows
   369→  meta
   370→    .command('workflows')
   371→    .description('List workflows defined in meta-spec')
   372→    .option('--verbose', 'Show full workflow details with all steps')
   373→    .action(async (options) => {
   374→      try {
   375→        const ctx = await initContext();
   376→
   377→        if (!ctx.manifestPath) {
   378→          error('No kspec project found');
   379→          process.exit(1);
   380→        }
   381→
   382→        const metaCtx = await loadMetaContext(ctx);
   383→        const workflows = metaCtx.manifest?.workflows || [];
   384→
   385→        // AC-workflow-4: JSON output includes full workflow details
   386→        output(
   387→          workflows.map((workflow) => ({
   388→            id: workflow.id,
   389→            trigger: workflow.trigger,
   390→            description: workflow.description,
   391→            steps: workflow.steps,
   392→          })),
   393→          // AC-workflow-1 (table) or AC-workflow-2 (verbose)
   394→          () => {
   395→            if (options.verbose) {
   396→              formatWorkflowsVerbose(workflows);
   397→            } else {
   398→              formatWorkflows(workflows);
   399→            }
   400→          }
   401→        );
   402→      } catch (err) {
   403→        error('Failed to list workflows', err);
   404→        process.exit(1);
   405→      }
   406→    });
   407→
   408→  // AC-conv-1, AC-conv-2, AC-conv-5: kspec meta conventions
   409→  meta
   410→    .command('conventions')
   411→    .description('List conventions defined in meta-spec')
   412→    .option('--domain <domain>', 'Filter by specific domain')
   413→    .action(async (options) => {
   414→      try {
   415→        const ctx = await initContext();
   416→
   417→        if (!ctx.manifestPath) {
   418→          error('No kspec project found');
   419→          process.exit(1);
   420→        }
   421→
   422→        const metaCtx = await loadMetaContext(ctx);
   423→        const conventions = metaCtx.manifest?.conventions || [];
   424→
   425→        // AC-conv-2: Filter by domain if specified
   426→        const filtered = options.domain
   427→          ? conventions.filter((c) => c.domain === options.domain)
   428→          : conventions;
   429→
   430→        // AC-conv-5: JSON output includes full convention details
   431→        output(
   432→          filtered.map((convention) => ({
   433→            domain: convention.domain,
   434→            rules: convention.rules,
   435→            examples: convention.examples,
   436→            validation: convention.validation,
   437→          })),
   438→          // AC-conv-1 (table) or AC-conv-2 (detail for single domain)
   439→          () => {
   440→            if (options.domain && filtered.length === 1) {
   441→              formatConventionDetail(filtered[0]);
   442→            } else {
   443→              formatConventions(filtered);
   444→            }
   445→          }
   446→        );
   447→      } catch (err) {
   448→        error('Failed to list conventions', err);
   449→        process.exit(1);
   450→      }
   451→    });
   452→
   453→  // meta-get-cmd: kspec meta get <ref>
   454→  meta
   455→    .command('get <ref>')
   456→    .description('Get a meta item by reference (agent, workflow, convention, or observation)')
   457→    .action(async (ref: string) => {
   458→      try {
   459→        const ctx = await initContext();
   460→
   461→        if (!ctx.manifestPath) {
   462→          error('No kspec project found');
   463→          process.exit(1);
   464→        }
   465→
   466→        const metaCtx = await loadMetaContext(ctx);
   467→
   468→        // Normalize reference
   469→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   470→
   471→        // Search in all meta item types
   472→        const agents = metaCtx.manifest?.agents || [];
   473→        const workflows = metaCtx.manifest?.workflows || [];
   474→        const conventions = metaCtx.manifest?.conventions || [];
   475→        const observations = metaCtx.manifest?.observations || [];
   476→
   477→        // Try to find by ID or ULID prefix
   478→        let found: any = null;
   479→        let itemType: string = '';
   480→
   481→        // Check agents (by id or ULID)
   482→        const agent = agents.find((a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef));
   483→        if (agent) {
   484→          found = agent;
   485→          itemType = 'agent';
   486→        }
   487→
   488→        // Check workflows (by id or ULID)
   489→        if (!found) {
   490→          const workflow = workflows.find((w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef));
   491→          if (workflow) {
   492→            found = workflow;
   493→            itemType = 'workflow';
   494→          }
   495→        }
   496→
   497→        // Check conventions (by domain or ULID)
   498→        if (!found) {
   499→          const convention = conventions.find((c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef));
   500→          if (convention) {
   501→            found = convention;
   502→            itemType = 'convention';
   503→          }
   504→        }
   505→
   506→        // Check observations (by ULID)
   507→        if (!found) {
   508→          const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   509→          if (observation) {
   510→            found = observation;
   511→            itemType = 'observation';
   512→          }
   513→        }
   514→
   515→        if (!found) {
   516→          error(`Meta item not found: ${ref}`);
   517→          process.exit(1);
   518→        }
   519→
   520→        // Output the item
   521→        output(found, () => {
   522→          console.log(chalk.bold(`${itemType.charAt(0).toUpperCase() + itemType.slice(1)}: ${ref}`));
   523→          console.log(chalk.gray('─'.repeat(60)));
   524→          console.log(JSON.stringify(found, null, 2));
   525→        });
   526→      } catch (err) {
   527→        error('Failed to get meta item', err);
   528→        process.exit(1);
   529→      }
   530→    });
   531→
   532→  // meta-list-cmd: kspec meta list
   533→  meta
   534→    .command('list')
   535→    .description('List all meta items')
   536→    .option('--type <type>', 'Filter by type (agent, workflow, convention, observation)')
   537→    .action(async (options) => {
   538→      try {
   539→        const ctx = await initContext();
   540→
   541→        if (!ctx.manifestPath) {
   542→          error('No kspec project found');
   543→          process.exit(1);
   544→        }
   545→
   546→        const metaCtx = await loadMetaContext(ctx);
   547→
   548→        // Collect all meta items with type information
   549→        interface MetaListItem {
   550→          id: string;
   551→          type: string;
   552→          context: string;
   553→          ulid: string;
   554→        }
   555→
   556→        const items: MetaListItem[] = [];
   557→
   558→        // Add agents
   559→        if (!options.type || options.type === 'agent') {
   560→          for (const agent of metaCtx.manifest?.agents || []) {
   561→            items.push({
   562→              id: agent.id,
   563→              type: 'agent',
   564→              context: agent.name,
   565→              ulid: agent._ulid,
   566→            });
   567→          }
   568→        }
   569→
   570→        // Add workflows
   571→        if (!options.type || options.type === 'workflow') {
   572→          for (const workflow of metaCtx.manifest?.workflows || []) {
   573→            items.push({
   574→              id: workflow.id,
   575→              type: 'workflow',
   576→              context: workflow.trigger,
   577→              ulid: workflow._ulid,
   578→            });
   579→          }
   580→        }
   581→
   582→        // Add conventions
   583→        if (!options.type || options.type === 'convention') {
   584→          for (const convention of metaCtx.manifest?.conventions || []) {
   585→            items.push({
   586→              id: convention.domain,
   587→              type: 'convention',
   588→              context: `${convention.rules.length} rules`,
   589→              ulid: convention._ulid,
   590→            });
   591→          }
   592→        }
   593→
   594→        // Add observations
   595→        if (!options.type || options.type === 'observation') {
   596→          for (const observation of metaCtx.manifest?.observations || []) {
   597→            const ulidPrefix = observation._ulid.substring(0, 8);
   598→            items.push({
   599→              id: ulidPrefix,
   600→              type: 'observation',
   601→              context: `${observation.type} ${observation.resolved ? '(resolved)' : ''}`,
   602→              ulid: observation._ulid,
   603→            });
   604→          }
   605→        }
   606→
   607→        // Output
   608→        output(items, () => {
   609→          if (items.length === 0) {
   610→            console.log(chalk.yellow('No meta items found'));
   611→            return;
   612→          }
   613→
   614→          const table = new Table({
   615→            head: [chalk.bold('ID'), chalk.bold('Type'), chalk.bold('Context')],
   616→            style: {
   617→              head: [],
   618→              border: [],
   619→            },
   620→          });
   621→
   622→          for (const item of items) {
   623→            table.push([item.id, item.type, item.context]);
   624→          }
   625→
   626→          console.log(table.toString());
   627→        });
   628→      } catch (err) {
   629→        error('Failed to list meta items', err);
   630→        process.exit(1);
   631→      }
   632→    });
   633→
   634→  // AC-obs-1: kspec meta observe <type> <content>
   635→  meta
   636→    .command('observe <type> <content>')
   637→    .description('Create an observation (friction, success, question, idea)')
   638→    .option('--workflow <ref>', 'Reference to workflow this observation relates to')
   639→    .option('--author <author>', 'Author of the observation')
   640→    .action(async (type: string, content: string, options) => {
   641→      try {
   642→        const ctx = await initContext();
   643→
   644→        if (!ctx.manifestPath) {
   645→          error('No kspec project found');
   646→          process.exit(1);
   647→        }
   648→
   649→        // Validate observation type
   650→        const validTypes: ObservationType[] = ['friction', 'success', 'question', 'idea'];
   651→        if (!validTypes.includes(type as ObservationType)) {
   652→          error(`Invalid observation type: ${type}`);
   653→          console.log(`Valid types: ${validTypes.join(', ')}`);
   654→          process.exit(1);
   655→        }
   656→
   657→        // Create observation
   658→        const observation = createObservation(type as ObservationType, content, {
   659→          workflow_ref: options.workflow,
   660→          author: options.author,
   661→        });
   662→
   663→        // Save to manifest
   664→        await saveObservation(ctx, observation);
   665→
   666→        // AC-obs-1: outputs "OK Created observation: <ULID-prefix>"
   667→        success(`Created observation: ${observation._ulid.substring(0, 8)}`);
   668→      } catch (err) {
   669→        error('Failed to create observation', err);
   670→        process.exit(1);
   671→      }
   672→    });
   673→
   674→  // AC-obs-2, AC-obs-5: kspec meta observations
   675→  meta
   676→    .command('observations')
   677→    .description('List observations (shows unresolved by default)')
   678→    .option('--all', 'Include resolved observations')
   679→    .action(async (options) => {
   680→      try {
   681→        const ctx = await initContext();
   682→
   683→        if (!ctx.manifestPath) {
   684→          error('No kspec project found');
   685→          process.exit(1);
   686→        }
   687→
   688→        const metaCtx = await loadMetaContext(ctx);
   689→        const observations = metaCtx.observations || [];
   690→
   691→        // AC-obs-5: JSON output includes full observation objects
   692→        output(
   693→          observations.map((obs) => ({
   694→            _ulid: obs._ulid,
   695→            type: obs.type,
   696→            content: obs.content,
   697→            workflow_ref: obs.workflow_ref ?? null,
   698→            created_at: obs.created_at,
   699→            author: obs.author ?? null,
   700→            resolved: obs.resolved,
   701→            resolution: obs.resolution ?? null,
   702→            resolved_at: obs.resolved_at ?? null,
   703→            resolved_by: obs.resolved_by ?? null,
   704→            promoted_to: obs.promoted_to ?? null,
   705→          })),
   706→          // AC-obs-2: Table output with ID, Type, Workflow, Created, Content
   707→          () => formatObservations(observations, options.all)
   708→        );
   709→      } catch (err) {
   710→        error('Failed to list observations', err);
   711→        process.exit(1);
   712→      }
   713→    });
   714→
   715→  // AC-obs-3, AC-obs-6, AC-obs-8: kspec meta promote
   716→  meta
   717→    .command('promote <ref>')
   718→    .description('Promote observation to a task')
   719→    .requiredOption('--title <title>', 'Task title')
   720→    .option('--priority <priority>', 'Task priority (1-3)', '2')
   721→    .option('--force', 'Force promotion even if observation is resolved')
   722→    .action(async (ref: string, options) => {
   723→      try {
   724→        const ctx = await initContext();
   725→
   726→        if (!ctx.manifestPath) {
   727→          error('No kspec project found');
   728→          process.exit(1);
   729→        }
   730→
   731→        const metaCtx = await loadMetaContext(ctx);
   732→        const observations = metaCtx.manifest?.observations || [];
   733→
   734→        // Find observation
   735→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   736→        const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   737→
   738→        if (!observation) {
   739→          error(`Observation not found: ${ref}`);
   740→          process.exit(1);
   741→        }
   742→
   743→        // AC-obs-6: Check if already promoted
   744→        if (observation.promoted_to) {
   745→          error(`Observation already promoted to task ${observation.promoted_to}; resolve or delete the task first`);
   746→          process.exit(1);
   747→        }
   748→
   749→        // AC-obs-8: Check if resolved
   750→        if (observation.resolved && !options.force) {
   751→          error(`Cannot promote resolved observation; use --force to override`);
   752→          process.exit(1);
   753→        }
   754→
   755→        // Create task directly using the API
   756→        const task = createTask({
   757→          title: options.title,
   758→          priority: Number.parseInt(options.priority, 10),
   759→          meta_ref: observation.workflow_ref,
   760→        });
   761→
   762→        // Save task
   763→        await saveTask(ctx, task);
   764→        const taskRef = `@${task._ulid.substring(0, 8)}`;
   765→
   766→        // Update observation with promoted_to field
   767→        observation.promoted_to = taskRef;
   768→        await saveObservation(ctx, observation);
   769→
   770→        // AC-obs-3: outputs "OK Created task: <ULID-prefix>"
   771→        success(`Created task: ${taskRef.substring(0, 9)}`);
   772→      } catch (err) {
   773→        error('Failed to promote observation', err);
   774→        process.exit(1);
   775→      }
   776→    });
   777→
   778→  // AC-obs-4, AC-obs-7, AC-obs-9: kspec meta resolve
   779→  meta
   780→    .command('resolve <ref> [resolution]')
   781→    .description('Resolve an observation')
   782→    .action(async (ref: string, resolution: string | undefined) => {
   783→      try {
   784→        const ctx = await initContext();
   785→
   786→        if (!ctx.manifestPath) {
   787→          error('No kspec project found');
   788→          process.exit(1);
   789→        }
   790→
   791→        const metaCtx = await loadMetaContext(ctx);
   792→        const observations = metaCtx.manifest?.observations || [];
   793→
   794→        // Find observation
   795→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   796→        const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   797→
   798→        if (!observation) {
   799→          error(`Observation not found: ${ref}`);
   800→          process.exit(1);
   801→        }
   802→
   803→        // AC-obs-7: Check if already resolved
   804→        if (observation.resolved) {
   805→          const resolvedDate = new Date(observation.resolved_at!).toISOString().split('T')[0];
   806→          const resolutionText = observation.resolution || '';
   807→          const truncated = resolutionText.length > 50
   808→            ? resolutionText.substring(0, 50) + '...'
   809→            : resolutionText;
   810→          error(`Observation already resolved on ${resolvedDate}: '${truncated}'`);
   811→          process.exit(1);
   812→        }
   813→
   814→        // AC-obs-9: Auto-populate resolution from task completion if promoted
   815→        let finalResolution = resolution;
   816→        if (!finalResolution && observation.promoted_to) {
   817→          // TODO: Fetch task completion reason from promoted task
   818→          // For now, just use a placeholder
   819→          finalResolution = `Promoted to task ${observation.promoted_to}`;
   820→        }
   821→
   822→        if (!finalResolution) {
   823→          error('Resolution text is required');
   824→          process.exit(1);
   825→        }
   826→
   827→        // AC-obs-4: Update observation
   828→        observation.resolved = true;
   829→        observation.resolution = finalResolution;
   830→        observation.resolved_at = new Date().toISOString();
   831→        observation.resolved_by = observation.author; // Use same author
   832→
   833→        await saveObservation(ctx, observation);
   834→
   835→        // AC-obs-4: outputs "OK Resolved: <ULID-prefix>"
   836→        success(`Resolved: ${observation._ulid.substring(0, 8)}`);
   837→      } catch (err) {
   838→        error('Failed to resolve observation', err);
   839→        process.exit(1);
   840→      }
   841→    });
   842→
   843→  // Meta add command - create new meta items
   844→  meta
   845→    .command('add <type>')
   846→    .description('Create a new meta item (agent, workflow, or convention)')
   847→    .option('--id <id>', 'Semantic ID (required for agents and workflows)')
   848→    .option('--domain <domain>', 'Domain (required for conventions)')
   849→    .option('--name <name>', 'Name (for agents)')
   850→    .option('--trigger <trigger>', 'Trigger (for workflows)')
   851→    .option('--description <desc>', 'Description')
   852→    .option('--capability <cap...>', 'Capabilities (for agents)')
   853→    .option('--tool <tool...>', 'Tools (for agents)')
   854→    .option('--convention <conv...>', 'Convention references (for agents)')
   855→    .option('--rule <rule...>', 'Rules (for conventions)')
   856→    .action(async (type: string, options) => {
   857→      try {
   858→        const ctx = await initContext();
   859→
   860→        // Validate type
   861→        const validTypes = ['agent', 'workflow', 'convention'];
   862→        if (!validTypes.includes(type)) {
   863→          error(`Invalid type: ${type}. Must be one of: ${validTypes.join(', ')}`);
   864→          process.exit(1);
   865→        }
   866→
   867→        // Generate ULID
   868→        const itemUlid = ulid();
   869→
   870→        // Create the item based on type
   871→        let item: Agent | Workflow | Convention;
   872→
   873→        if (type === 'agent') {
   874→          // Validate required fields
   875→          if (!options.id) {
   876→            error('Agent requires --id');
   877→            process.exit(1);
   878→          }
   879→          if (!options.name) {
   880→            error('Agent requires --name');
   881→            process.exit(1);
   882→          }
   883→
   884→          item = {
   885→            _ulid: itemUlid,
   886→            id: options.id,
   887→            name: options.name,
   888→            description: options.description || '',
   889→            capabilities: options.capability || [],
   890→            tools: options.tool || [],
   891→            conventions: options.convention || [],
   892→          };
   893→        } else if (type === 'workflow') {
   894→          // Validate required fields
   895→          if (!options.id) {
   896→            error('Workflow requires --id');
   897→            process.exit(1);
   898→          }
   899→          if (!options.trigger) {
   900→            error('Workflow requires --trigger');
   901→            process.exit(1);
   902→          }
   903→
   904→          item = {
   905→            _ulid: itemUlid,
   906→            id: options.id,
   907→            trigger: options.trigger,
   908→            description: options.description || '',
   909→            steps: [],
   910→          };
   911→        } else {
   912→          // convention
   913→          if (!options.domain) {
   914→            error('Convention requires --domain');
   915→            process.exit(1);
   916→          }
   917→
   918→          item = {
   919→            _ulid: itemUlid,
   920→            domain: options.domain,
   921→            rules: options.rule || [],
   922→            examples: [],
   923→          };
   924→        }
   925→
   926→        // Save the item
   927→        await saveMetaItem(ctx, item, type as 'agent' | 'workflow' | 'convention');
   928→
   929→        if (isJsonMode()) {
   930→          // In JSON mode, output the item data directly
   931→          console.log(JSON.stringify(item, null, 2));
   932→        } else {
   933→          const idOrDomain = 'id' in item ? item.id : 'domain' in item ? item.domain : itemUlid;
   934→          success(`Created ${type}: ${idOrDomain} (@${itemUlid.substring(0, 8)})`);
   935→        }
   936→      } catch (err) {
   937→        error(`Failed to create ${type}`, err);
   938→        process.exit(1);
   939→      }
   940→    });
   941→
   942→  // Meta set command - update existing meta items
   943→  meta
   944→    .command('set <ref>')
   945→    .description('Update an existing meta item')
   946→    .option('--name <name>', 'Update name (for agents)')
   947→    .option('--description <desc>', 'Update description')
   948→    .option('--trigger <trigger>', 'Update trigger (for workflows)')
   949→    .option('--add-capability <cap>', 'Add capability (for agents)')
   950→    .option('--add-tool <tool>', 'Add tool (for agents)')
   951→    .option('--add-convention <conv>', 'Add convention reference (for agents)')
   952→    .option('--add-rule <rule>', 'Add rule (for conventions)')
   953→    .action(async (ref: string, options) => {
   954→      try {
   955→        const ctx = await initContext();
   956→        const metaCtx = await loadMetaContext(ctx);
   957→
   958→        // Find the item using unified lookup
   959→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   960→        let found: Agent | Workflow | Convention | null = null;
   961→        let itemType: 'agent' | 'workflow' | 'convention' | null = null;
   962→
   963→        // Search in agents
   964→        const agents = metaCtx.manifest?.agents || [];
   965→        const agent = agents.find(
   966→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
   967→        );
   968→        if (agent) {
   969→          found = agent;
   970→          itemType = 'agent';
   971→        }
   972→
   973→        // Search in workflows
   974→        if (!found) {
   975→          const workflows = metaCtx.manifest?.workflows || [];
   976→          const workflow = workflows.find(
   977→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
   978→          );
   979→          if (workflow) {
   980→            found = workflow;
   981→            itemType = 'workflow';
   982→          }
   983→        }
   984→
   985→        // Search in conventions
   986→        if (!found) {
   987→          const conventions = metaCtx.manifest?.conventions || [];
   988→          const convention = conventions.find(
   989→            (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
   990→          );
   991→          if (convention) {
   992→            found = convention;
   993→            itemType = 'convention';
   994→          }
   995→        }
   996→
   997→        if (!found || !itemType) {
   998→          error(`Meta item not found: ${ref}`);
   999→          process.exit(1);
  1000→        }
  1001→
  1002→        // Update fields based on type
  1003→        if (itemType === 'agent') {
  1004→          const item = found as Agent;
  1005→          if (options.name) item.name = options.name;
  1006→          if (options.description !== undefined) item.description = options.description;
  1007→          if (options.addCapability) {
  1008→            if (!item.capabilities.includes(options.addCapability)) {
  1009→              item.capabilities.push(options.addCapability);
  1010→            }
  1011→          }
  1012→          if (options.addTool) {
  1013→            if (!item.tools.includes(options.addTool)) {
  1014→              item.tools.push(options.addTool);
  1015→            }
  1016→          }
  1017→          if (options.addConvention) {
  1018→            if (!item.conventions.includes(options.addConvention)) {
  1019→              item.conventions.push(options.addConvention);
  1020→            }
  1021→          }
  1022→        } else if (itemType === 'workflow') {
  1023→          const item = found as Workflow;
  1024→          if (options.trigger) item.trigger = options.trigger;
  1025→          if (options.description !== undefined) item.description = options.description;
  1026→        } else {
  1027→          const item = found as Convention;
  1028→          // Convention doesn't have a description field
  1029→          if (options.addRule) {
  1030→            if (!item.rules.includes(options.addRule)) {
  1031→              item.rules.push(options.addRule);
  1032→            }
  1033→          }
  1034→        }
  1035→
  1036→        // Save the updated item
  1037→        await saveMetaItem(ctx, found, itemType);
  1038→
  1039→        if (isJsonMode()) {
  1040→          // In JSON mode, output the item data directly
  1041→          console.log(JSON.stringify(found, null, 2));
  1042→        } else {
  1043→          const idOrDomain =
  1044→            itemType === 'agent'
  1045→              ? (found as Agent).id
  1046→              : itemType === 'workflow'
  1047→                ? (found as Workflow).id
  1048→                : (found as Convention).domain;
  1049→          success(`Updated ${itemType}: ${idOrDomain}`);
  1050→        }
  1051→      } catch (err) {
  1052→        error('Failed to update meta item', err);
  1053→        process.exit(1);
  1054→      }
  1055→    });
  1056→
  1057→  // Meta delete command - delete meta items
  1058→  meta
  1059→    .command('delete <ref>')
  1060→    .description('Delete a meta item')
  1061→    .option('--confirm', 'Skip confirmation prompt')
  1062→    .action(async (ref: string, options) => {
  1063→      try {
  1064→        const ctx = await initContext();
  1065→        const metaCtx = await loadMetaContext(ctx);
  1066→
  1067→        // Find the item to determine type
  1068→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
  1069→        let itemType: 'agent' | 'workflow' | 'convention' | 'observation' | null = null;
  1070→        let itemUlid: string | null = null;
  1071→        let itemLabel: string | null = null;
  1072→
  1073→        // Search in agents
  1074→        const agents = metaCtx.manifest?.agents || [];
  1075→        const agent = agents.find(
  1076→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
  1077→        );
  1078→        if (agent) {
  1079→          itemType = 'agent';
  1080→          itemUlid = agent._ulid;
  1081→          itemLabel = `agent ${agent.id}`;
  1082→        }
  1083→
  1084→        // Search in workflows
  1085→        if (!itemType) {
  1086→          const workflows = metaCtx.manifest?.workflows || [];
  1087→          const workflow = workflows.find(
  1088→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
  1089→          );
  1090→          if (workflow) {
  1091→            itemType = 'workflow';
  1092→            itemUlid = workflow._ulid;
  1093→            itemLabel = `workflow ${workflow.id}`;
  1094→          }
  1095→        }
  1096→
  1097→        // Search in conventions
  1098→        if (!itemType) {
  1099→          const conventions = metaCtx.manifest?.conventions || [];
  1100→          const convention = conventions.find(
  1101→            (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
  1102→          );
  1103→          if (convention) {
  1104→            itemType = 'convention';
  1105→            itemUlid = convention._ulid;
  1106→            itemLabel = `convention ${convention.domain}`;
  1107→          }
  1108→        }
  1109→
  1110→        // Search in observations
  1111→        if (!itemType) {
  1112→          const observations = metaCtx.manifest?.observations || [];
  1113→          const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
  1114→          if (observation) {
  1115→            itemType = 'observation';
  1116→            itemUlid = observation._ulid;
  1117→            itemLabel = `observation ${observation._ulid.substring(0, 8)}`;
  1118→          }
  1119→        }
  1120→
  1121→        if (!itemType || !itemUlid || !itemLabel) {
  1122→          error(`Meta item not found: ${ref}`);
  1123→          process.exit(1);
  1124→        }
  1125→
  1126→        // Check for dangling references (unless --confirm is used to override)
  1127→        if (!options.confirm) {
  1128→          // Check tasks with meta_ref
  1129→          const tasks = await loadAllTasks(ctx);
  1130→          const referencingTasks = tasks.filter((t) => {
  1131→            if (!t.meta_ref) return false;
  1132→            // Resolve the task's meta_ref to a ULID
  1133→            const taskMetaRef = resolveMetaRefToUlid(t.meta_ref, metaCtx);
  1134→            // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1135→            return taskMetaRef && taskMetaRef.ulid === itemUlid;
  1136→          });
  1137→
  1138→          if (referencingTasks.length > 0) {
  1139→            const taskRefs = referencingTasks
  1140→              .map((t) => `@${t.slugs?.[0] || t._ulid.substring(0, 8)}`)
  1141→              .join(', ');
  1142→            error(
  1143→              `Cannot delete ${itemLabel}: Referenced by ${referencingTasks.length} task(s): ${taskRefs}. Use --confirm to override.`
  1144→            );
  1145→            process.exit(1);
  1146→          }
  1147→
  1148→          // Check observations with workflow_ref (only for workflows)
  1149→          if (itemType === 'workflow') {
  1150→            const observations = metaCtx.manifest?.observations || [];
  1151→            const referencingObservations = observations.filter((o) => {
  1152→              if (!o.workflow_ref) return false;
  1153→              // Resolve the observation's workflow_ref to a ULID
  1154→              const obsWorkflowRef = resolveMetaRefToUlid(o.workflow_ref, metaCtx);
  1155→              // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1156→              return obsWorkflowRef && obsWorkflowRef.ulid === itemUlid;
  1157→            });
  1158→
  1159→            if (referencingObservations.length > 0) {
  1160→              const obsRefs = referencingObservations
  1161→                .map((o) => `@${o._ulid.substring(0, 8)}`)
  1162→                .join(', ');
  1163→              error(
  1164→                `Cannot delete ${itemLabel}: Referenced by ${referencingObservations.length} observation(s): ${obsRefs}. Use --confirm to override.`
  1165→              );
  1166→              process.exit(1);
  1167→            }
  1168→          }
  1169→
  1170→          // Show confirmation prompt even if no references found
  1171→          error(`Warning: This will delete ${itemLabel}. Use --confirm to skip this prompt`);
  1172→          process.exit(1);
  1173→        }
  1174→
  1175→        // Delete the item
  1176→        const deleted = await deleteMetaItem(ctx, itemUlid, itemType);
  1177→
  1178→        if (!deleted) {
  1179→          error(`Failed to delete ${itemLabel}`);
  1180→          process.exit(1);
  1181→        }
  1182→
  1183→        success(`Deleted ${itemLabel}`);
  1184→      } catch (err) {
  1185→        error('Failed to delete meta item', err);
  1186→        process.exit(1);
  1187→      }
  1188→    });
  1189→}
  1190→

