```
     1→/**
     2→ * Shadow branch utilities for transparent spec/task state tracking.
     3→ *
     4→ * Shadow branch concept:
     5→ * - Orphan branch (kspec-meta) stores kspec state
     6→ * - .kspec/ directory is a git worktree pointing to shadow branch
     7→ * - Main branch gitignores .kspec/
     8→ * - All kspec read/write operations target .kspec/
     9→ * - Changes auto-commit to shadow branch
    10→ */
    11→
    12→import * as fs from 'node:fs/promises';
    13→import * as path from 'node:path';
    14→import { execSync, exec } from 'node:child_process';
    15→import { promisify } from 'node:util';
    16→
    17→const execAsync = promisify(exec);
    18→
    19→// Import getVerboseMode for checking CLI --debug-shadow flag
    20→// We use a getter function to avoid issues with circular dependencies
    21→let getVerboseModeFunc: (() => boolean) | null = null;
    22→
    23→export function setVerboseModeGetter(getter: () => boolean): void {
    24→  getVerboseModeFunc = getter;
    25→}
    26→
    27→/**
    28→ * Shadow branch configuration
    29→ */
    30→export interface ShadowConfig {
    31→  /** Whether shadow branch is enabled/detected */
    32→  enabled: boolean;
    33→  /** Path to .kspec/ worktree directory */
    34→  worktreeDir: string;
    35→  /** Shadow branch name (default: kspec-meta) */
    36→  branchName: string;
    37→  /** Project root (where .kspec/ lives) */
    38→  projectRoot: string;
    39→}
    40→
    41→/**
    42→ * Shadow branch status
    43→ */
    44→export interface ShadowStatus {
    45→  exists: boolean;
    46→  healthy: boolean;
    47→  branchExists: boolean;
    48→  worktreeExists: boolean;
    49→  worktreeLinked: boolean;
    50→  error?: string;
    51→}
    52→
    53→/**
    54→ * Error types for shadow branch issues
    55→ */
    56→export class ShadowError extends Error {
    57→  constructor(
    58→    message: string,
    59→    public code: 'NOT_INITIALIZED' | 'WORKTREE_DISCONNECTED' | 'DIRECTORY_MISSING' | 'GIT_ERROR' | 'RUNNING_FROM_SHADOW',
    60→    public suggestion: string
    61→  ) {
    62→    super(message);
    63→    this.name = 'ShadowError';
    64→  }
    65→}
    66→
    67→/**
    68→ * Default shadow branch name
    69→ */
    70→export const SHADOW_BRANCH_NAME = 'kspec-meta';
    71→
    72→/**
    73→ * Default shadow worktree directory
    74→ */
    75→export const SHADOW_WORKTREE_DIR = '.kspec';
    76→
    77→/**
    78→ * Check if debug mode is enabled.
    79→ * Debug mode can be enabled via:
    80→ * - KSPEC_DEBUG=1 environment variable
    81→ * - Verbose flag (passed from CLI --debug-shadow option)
    82→ *
    83→ * When enabled, shadow branch operations output detailed information.
    84→ */
    85→export function isDebugMode(verboseFlag?: boolean): boolean {
    86→  if (process.env.KSPEC_DEBUG === '1') {
    87→    return true;
    88→  }
    89→  if (verboseFlag === true) {
    90→    return true;
    91→  }
    92→  // Check CLI --debug-shadow flag via getter
    93→  if (getVerboseModeFunc?.()) {
    94→    return true;
    95→  }
    96→  return false;
    97→}
    98→
    99→/**
   100→ * Check if we're in a git repository
   101→ */
   102→export async function isGitRepo(dir: string): Promise<boolean> {
   103→  try {
   104→    execSync('git rev-parse --git-dir', {
   105→      cwd: dir,
   106→      stdio: ['pipe', 'pipe', 'pipe'],
   107→      encoding: 'utf-8',
   108→    });
   109→    return true;
   110→  } catch {
   111→    return false;
   112→  }
   113→}
   114→
   115→/**
   116→ * Get the git root directory
   117→ */
   118→export function getGitRoot(dir: string): string | null {
   119→  try {
   120→    const result = execSync('git rev-parse --show-toplevel', {
   121→      cwd: dir,
   122→      stdio: ['pipe', 'pipe', 'pipe'],
   123→      encoding: 'utf-8',
   124→    }).trim();
   125→    return result;
   126→  } catch {
   127→    return null;
   128→  }
   129→}
   130→
   131→/**
   132→ * Check if a branch exists
   133→ */
   134→export async function branchExists(dir: string, branchName: string): Promise<boolean> {
   135→  try {
   136→    execSync(`git show-ref --verify --quiet refs/heads/${branchName}`, {
   137→      cwd: dir,
   138→      stdio: ['pipe', 'pipe', 'pipe'],
   139→    });
   140→    return true;
   141→  } catch {
   142→    return false;
   143→  }
   144→}
   145→
   146→/**
   147→ * Check if a directory is a valid git worktree
   148→ */
   149→export async function isValidWorktree(worktreeDir: string): Promise<boolean> {
   150→  try {
   151→    // Check if .git file exists (worktrees have a .git file, not directory)
   152→    const gitPath = path.join(worktreeDir, '.git');
   153→    const stat = await fs.stat(gitPath);
   154→
   155→    if (stat.isFile()) {
   156→      // Read the .git file to verify it points to a worktree
   157→      const content = await fs.readFile(gitPath, 'utf-8');
   158→      return content.trim().startsWith('gitdir:');
   159→    }
   160→
   161→    return false;
   162→  } catch {
   163→    return false;
   164→  }
   165→}
   166→
   167→/**
   168→ * Detect if running from inside the shadow worktree directory.
   169→ * Returns the main project root if detected, null otherwise.
   170→ *
   171→ * Detection logic:
   172→ * 1. Check if .git is a file (worktrees have .git files, not directories)
   173→ * 2. Read the gitdir reference from the .git file
   174→ * 3. Check if it points to a worktree for .kspec (pattern: <project>/.git/worktrees/-kspec)
   175→ */
   176→export async function detectRunningFromShadowWorktree(cwd: string): Promise<string | null> {
   177→  try {
   178→    const gitPath = path.join(cwd, '.git');
   179→    const stat = await fs.stat(gitPath);
   180→
   181→    // Worktrees have a .git file, not directory
   182→    if (!stat.isFile()) {
   183→      return null;
   184→    }
   185→
   186→    const content = await fs.readFile(gitPath, 'utf-8');
   187→    const match = content.trim().match(/^gitdir:\s*(.+)$/);
   188→    if (!match) {
   189→      return null;
   190→    }
   191→
   192→    const gitdir = match[1];
   193→
   194→    // Check if this is a shadow worktree (pattern: <project>/.git/worktrees/-kspec)
   195→    if (gitdir.includes('.git/worktrees/')) {
   196→      const worktreesMatch = gitdir.match(/^(.+)\/\.git\/worktrees\//);
   197→      if (worktreesMatch) {
   198→        const mainProjectRoot = worktreesMatch[1];
   199→        const cwdBase = path.basename(cwd);
   200→        const worktreeName = path.basename(gitdir);
   201→
   202→        if (cwdBase === SHADOW_WORKTREE_DIR || worktreeName.includes('kspec')) {
   203→          return mainProjectRoot;
   204→        }
   205→      }
   206→    }
   207→
   208→    return null;
   209→  } catch {
   210→    return null;
   211→  }
   212→}
   213→
   214→/**
   215→ * Detect shadow branch configuration from a directory.
   216→ * Returns shadow config if .kspec/ exists and is valid.
   217→ */
   218→export async function detectShadow(startDir: string): Promise<ShadowConfig | null> {
   219→  const gitRoot = getGitRoot(startDir);
   220→  if (!gitRoot) {
   221→    return null;
   222→  }
   223→
   224→  const worktreeDir = path.join(gitRoot, SHADOW_WORKTREE_DIR);
   225→
   226→  try {
   227→    await fs.access(worktreeDir);
   228→
   229→    // Verify it's a valid worktree
   230→    if (await isValidWorktree(worktreeDir)) {
   231→      return {
   232→        enabled: true,
   233→        worktreeDir,
   234→        branchName: SHADOW_BRANCH_NAME,
   235→        projectRoot: gitRoot,
   236→      };
   237→    }
   238→
   239→    // Directory exists but not a valid worktree
   240→    return null;
   241→  } catch {
   242→    // .kspec/ doesn't exist
   243→    return null;
   244→  }
   245→}
   246→
   247→/**
   248→ * Get detailed shadow branch status
   249→ */
   250→export async function getShadowStatus(projectRoot: string): Promise<ShadowStatus> {
   251→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
   252→
   253→  const status: ShadowStatus = {
   254→    exists: false,
   255→    healthy: false,
   256→    branchExists: false,
   257→    worktreeExists: false,
   258→    worktreeLinked: false,
   259→  };
   260→
   261→  // Check if we're in a git repo
   262→  if (!(await isGitRepo(projectRoot))) {
   263→    status.error = 'Not a git repository';
   264→    return status;
   265→  }
   266→
   267→  // Check if branch exists
   268→  status.branchExists = await branchExists(projectRoot, SHADOW_BRANCH_NAME);
   269→
   270→  // Check if worktree directory exists
   271→  try {
   272→    await fs.access(worktreeDir);
   273→    status.worktreeExists = true;
   274→  } catch {
   275→    status.worktreeExists = false;
   276→  }
   277→
   278→  // Check if worktree is properly linked
   279→  if (status.worktreeExists) {
   280→    status.worktreeLinked = await isValidWorktree(worktreeDir);
   281→  }
   282→
   283→  // Determine overall status
   284→  status.exists = status.branchExists || status.worktreeExists;
   285→  status.healthy = status.branchExists && status.worktreeExists && status.worktreeLinked;
   286→
   287→  if (!status.healthy && status.exists) {
   288→    if (!status.branchExists) {
   289→      status.error = 'Shadow branch missing but worktree exists';
   290→    } else if (!status.worktreeExists) {
   291→      status.error = 'Shadow branch exists but worktree missing';
   292→    } else if (!status.worktreeLinked) {
   293→      status.error = 'Worktree exists but not properly linked';
   294→    }
   295→  }
   296→
   297→  return status;
   298→}
   299→
   300→/**
   301→ * Create an appropriate ShadowError based on status
   302→ */
   303→export function createShadowError(status: ShadowStatus): ShadowError {
   304→  if (!status.branchExists && !status.worktreeExists) {
   305→    return new ShadowError(
   306→      'Shadow branch not initialized',
   307→      'NOT_INITIALIZED',
   308→      'Run `kspec init` to create shadow branch and worktree.'
   309→    );
   310→  }
   311→
   312→  if (status.branchExists && !status.worktreeExists) {
   313→    return new ShadowError(
   314→      '.kspec/ directory missing',
   315→      'DIRECTORY_MISSING',
   316→      'Run `kspec shadow repair` to recreate the worktree.'
   317→    );
   318→  }
   319→
   320→  if (status.worktreeExists && !status.worktreeLinked) {
   321→    return new ShadowError(
   322→      'Worktree disconnected from git',
   323→      'WORKTREE_DISCONNECTED',
   324→      'Run `kspec shadow repair` to fix the worktree link.'
   325→    );
   326→  }
   327→
   328→  return new ShadowError(
   329→    status.error || 'Unknown shadow branch error',
   330→    'GIT_ERROR',
   331→    'Check git status and try `kspec shadow repair`.'
   332→  );
   333→}
   334→
   335→/**
   336→ * Auto-commit changes to shadow branch.
   337→ * Called after write operations when shadow is enabled.
   338→ *
   339→ * @param worktreeDir Path to .kspec/ directory
   340→ * @param message Commit message
   341→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   342→ * @returns true if commit succeeded, false if nothing to commit
   343→ */
   344→export async function shadowAutoCommit(
   345→  worktreeDir: string,
   346→  message: string,
   347→  verbose?: boolean
   348→): Promise<boolean> {
   349→  const debug = isDebugMode(verbose);
   350→
   351→  try {
   352→    if (debug) {
   353→      console.error(`[DEBUG] Shadow auto-commit: git add -A (cwd: ${worktreeDir})`);
   354→    }
   355→
   356→    // Stage all changes
   357→    execSync('git add -A', {
   358→      cwd: worktreeDir,
   359→      stdio: ['pipe', 'pipe', 'pipe'],
   360→    });
   361→
   362→    // Check if there are staged changes
   363→    try {
   364→      if (debug) {
   365→        console.error(`[DEBUG] Shadow auto-commit: git diff --cached --quiet`);
   366→      }
   367→
   368→      execSync('git diff --cached --quiet', {
   369→        cwd: worktreeDir,
   370→        stdio: ['pipe', 'pipe', 'pipe'],
   371→      });
   372→      // No error = no changes
   373→      if (debug) {
   374→        console.error(`[DEBUG] Shadow auto-commit: No changes to commit`);
   375→      }
   376→      return false;
   377→    } catch {
   378→      // Error = there are changes, proceed with commit
   379→    }
   380→
   381→    if (debug) {
   382→      console.error(`[DEBUG] Shadow auto-commit: git commit -m "${message}"`);
   383→    }
   384→
   385→    // Commit with message
   386→    // Set KSPEC_SHADOW_COMMIT=1 to signal authorized commit to git hooks
   387→    execSync(`git commit -m "${message.replace(/"/g, '\\"')}"`, {
   388→      cwd: worktreeDir,
   389→      stdio: ['pipe', 'pipe', 'pipe'],
   390→      env: { ...process.env, KSPEC_SHADOW_COMMIT: '1' },
   391→    });
   392→
   393→    if (debug) {
   394→      console.error(`[DEBUG] Shadow auto-commit: Success`);
   395→    }
   396→
   397→    return true;
   398→  } catch (error) {
   399→    // AC: Only log error if debug mode enabled
   400→    if (debug) {
   401→      console.error('Shadow auto-commit failed:', error);
   402→    }
   403→    return false;
   404→  }
   405→}
   406→
   407→/**
   408→ * Generate commit message for a kspec operation.
   409→ */
   410→export function generateCommitMessage(
   411→  operation: string,
   412→  ref?: string,
   413→  detail?: string
   414→): string {
   415→  const parts: string[] = [];
   416→
   417→  switch (operation) {
   418→    case 'task-start':
   419→      parts.push(`Start @${ref}`);
   420→      break;
   421→    case 'task-complete':
   422→      parts.push(`Complete @${ref}`);
   423→      if (detail) parts.push(`: ${detail}`);
   424→      break;
   425→    case 'task-note':
   426→      parts.push(`Note on @${ref}`);
   427→      break;
   428→    case 'task-add':
   429→      parts.push(`Add task: ${detail || ref}`);
   430→      break;
   431→    case 'inbox-add':
   432→      parts.push(`Inbox: ${detail?.slice(0, 50)}${(detail?.length || 0) > 50 ? '...' : ''}`);
   433→      break;
   434→    case 'inbox-promote':
   435→      parts.push(`Promote to @${ref}`);
   436→      break;
   437→    case 'item-add':
   438→      parts.push(`Add @${ref}`);
   439→      break;
   440→    case 'item-set':
   441→      parts.push(`Update @${ref}`);
   442→      break;
   443→    case 'item-delete':
   444→      parts.push(`Delete @${ref}`);
   445→      break;
   446→    case 'derive':
   447→      parts.push(`Derive from @${ref}`);
   448→      break;
   449→    default:
   450→      parts.push(operation);
   451→      if (ref) parts.push(` @${ref}`);
   452→  }
   453→
   454→  return parts.join('');
   455→}
   456→
   457→/**
   458→ * Resolve a path relative to shadow worktree if enabled.
   459→ * Falls back to original path if shadow is not enabled.
   460→ */
   461→export function resolveShadowPath(
   462→  originalPath: string,
   463→  shadowConfig: ShadowConfig | null,
   464→  projectRoot: string
   465→): string {
   466→  if (!shadowConfig?.enabled) {
   467→    return originalPath;
   468→  }
   469→
   470→  // If the path is within the project root, rewrite to shadow worktree
   471→  const relativePath = path.relative(projectRoot, originalPath);
   472→
   473→  // Skip if path is outside project or already in .kspec
   474→  if (relativePath.startsWith('..') || relativePath.startsWith(SHADOW_WORKTREE_DIR)) {
   475→    return originalPath;
   476→  }
   477→
   478→  // Handle spec/ -> .kspec/ mapping
   479→  if (relativePath.startsWith('spec/') || relativePath.startsWith('spec\\')) {
   480→    const specRelative = relativePath.slice(5); // Remove 'spec/'
   481→    return path.join(shadowConfig.worktreeDir, specRelative);
   482→  }
   483→
   484→  // For task/inbox files at root, move to .kspec
   485→  if (relativePath.endsWith('.tasks.yaml') || relativePath.endsWith('.inbox.yaml')) {
   486→    return path.join(shadowConfig.worktreeDir, relativePath);
   487→  }
   488→
   489→  return originalPath;
   490→}
   491→
   492→/**
   493→ * Commit changes to shadow branch if enabled.
   494→ * This is the primary interface for CLI commands to trigger auto-commit.
   495→ *
   496→ * @param shadowConfig Shadow configuration (from KspecContext.shadow)
   497→ * @param operation Operation type (e.g., 'task-start', 'task-complete')
   498→ * @param ref Reference slug or ULID (optional)
   499→ * @param detail Additional detail for commit message (optional)
   500→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   501→ * @returns true if committed, false if shadow not enabled or nothing to commit
   502→ */
   503→export async function commitIfShadow(
   504→  shadowConfig: ShadowConfig | null,
   505→  operation: string,
   506→  ref?: string,
   507→  detail?: string,
   508→  verbose?: boolean
   509→): Promise<boolean> {
   510→  if (!shadowConfig?.enabled) {
   511→    return false;
   512→  }
   513→
   514→  const message = generateCommitMessage(operation, ref, detail);
   515→  const committed = await shadowAutoCommit(shadowConfig.worktreeDir, message, verbose);
   516→
   517→  // AC-1: Fire-and-forget push after each commit
   518→  if (committed) {
   519→    shadowPushAsync(shadowConfig.worktreeDir, verbose);
   520→  }
   521→
   522→  return committed;
   523→}
   524→
   525→/**
   526→ * Check if shadow is required but not available, and throw appropriate error.
   527→ * Use this at the start of commands that require shadow mode.
   528→ *
   529→ * @param shadowConfig Shadow configuration from context
   530→ * @param projectRoot Project root for status check
   531→ * @throws ShadowError if shadow is not properly configured
   532→ */
   533→export async function requireShadow(
   534→  shadowConfig: ShadowConfig | null,
   535→  projectRoot: string
   536→): Promise<void> {
   537→  if (shadowConfig?.enabled) {
   538→    return; // Shadow is available
   539→  }
   540→
   541→  const status = await getShadowStatus(projectRoot);
   542→  throw createShadowError(status);
   543→}
   544→
   545→/**
   546→ * Format a ShadowError for display in CLI.
   547→ * Returns a user-friendly message with suggestion.
   548→ */
   549→export function formatShadowError(error: ShadowError): string {
   550→  return `${error.message}\n\nSuggestion: ${error.suggestion}`;
   551→}
   552→
   553→/**
   554→ * Result from shadow initialization
   555→ */
   556→export interface ShadowInitResult {
   557→  success: boolean;
   558→  branchCreated: boolean;
   559→  worktreeCreated: boolean;
   560→  gitignoreUpdated: boolean;
   561→  initialCommit: boolean;
   562→  alreadyExists: boolean;
   563→  /** Whether shadow was created from existing remote branch */
   564→  createdFromRemote: boolean;
   565→  /** Whether new branch was pushed to remote to establish tracking */
   566→  pushedToRemote: boolean;
   567→  error?: string;
   568→}
   569→
   570→/**
   571→ * Options for shadow initialization
   572→ */
   573→export interface ShadowInitOptions {
   574→  /** Project name for manifest */
   575→  projectName?: string;
   576→  /** Force reinitialize even if exists */
   577→  force?: boolean;
   578→}
   579→
   580→/**
   581→ * Check if a remote exists (default: origin)
   582→ */
   583→export async function hasRemote(projectRoot: string, remoteName = 'origin'): Promise<boolean> {
   584→  try {
   585→    const { stdout } = await execAsync(`git remote get-url ${remoteName}`, {
   586→      cwd: projectRoot,
   587→    });
   588→    return stdout.trim().length > 0;
   589→  } catch {
   590→    return false;
   591→  }
   592→}
   593→
   594→/**
   595→ * Check if a branch exists on a remote
   596→ */
   597→export async function remoteBranchExists(
   598→  projectRoot: string,
   599→  branchName: string,
   600→  remoteName = 'origin'
   601→): Promise<boolean> {
   602→  try {
   603→    execSync(`git show-ref --verify --quiet refs/remotes/${remoteName}/${branchName}`, {
   604→      cwd: projectRoot,
   605→      stdio: ['pipe', 'pipe', 'pipe'],
   606→    });
   607→    return true;
   608→  } catch {
   609→    return false;
   610→  }
   611→}
   612→
   613→/**
   614→ * Fetch from remote to ensure refs are up to date.
   615→ * Returns true if fetch succeeded, false otherwise.
   616→ */
   617→export async function fetchRemote(projectRoot: string, remoteName = 'origin'): Promise<boolean> {
   618→  try {
   619→    await execAsync(`git fetch ${remoteName}`, {
   620→      cwd: projectRoot,
   621→    });
   622→    return true;
   623→  } catch {
   624→    return false;
   625→  }
   626→}
   627→
   628→/**
   629→ * Push shadow branch to remote with tracking.
   630→ * Returns true if push succeeded, false otherwise.
   631→ */
   632→export async function pushShadowBranch(
   633→  worktreeDir: string,
   634→  remoteName = 'origin'
   635→): Promise<boolean> {
   636→  try {
   637→    await execAsync(`git push -u ${remoteName} ${SHADOW_BRANCH_NAME}`, {
   638→      cwd: worktreeDir,
   639→    });
   640→    return true;
   641→  } catch {
   642→    return false;
   643→  }
   644→}
   645→
   646→/**
   647→ * Check if shadow branch has remote tracking configured.
   648→ * AC-4: Used to determine whether sync should be attempted.
   649→ */
   650→export async function hasRemoteTracking(worktreeDir: string): Promise<boolean> {
   651→  try {
   652→    const { stdout } = await execAsync(
   653→      `git config branch.${SHADOW_BRANCH_NAME}.remote`,
   654→      { cwd: worktreeDir }
   655→    );
   656→    return stdout.trim().length > 0;
   657→  } catch {
   658→    return false;
   659→  }
   660→}
   661→
   662→/**
   663→ * Ensure shadow branch has remote tracking configured.
   664→ * AC-8: If shadow has no tracking but main branch has origin remote,
   665→ * automatically configure tracking to origin/kspec-meta.
   666→ *
   667→ * @param worktreeDir Path to .kspec/ worktree
   668→ * @param projectRoot Git repository root
   669→ * @returns true if tracking is now configured (was already or just set up)
   670→ */
   671→export async function ensureRemoteTracking(
   672→  worktreeDir: string,
   673→  projectRoot: string
   674→): Promise<boolean> {
   675→  // Check if already has tracking
   676→  if (await hasRemoteTracking(worktreeDir)) {
   677→    return true;
   678→  }
   679→
   680→  // Check if main branch has origin remote
   681→  if (!(await hasRemote(projectRoot))) {
   682→    return false;
   683→  }
   684→
   685→  // Set up tracking for shadow branch to origin/kspec-meta
   686→  try {
   687→    await execAsync(
   688→      `git config branch.${SHADOW_BRANCH_NAME}.remote origin`,
   689→      { cwd: worktreeDir }
   690→    );
   691→    await execAsync(
   692→      `git config branch.${SHADOW_BRANCH_NAME}.merge refs/heads/${SHADOW_BRANCH_NAME}`,
   693→      { cwd: worktreeDir }
   694→    );
   695→    return true;
   696→  } catch {
   697→    return false;
   698→  }
   699→}
   700→
   701→/**
   702→ * Result from a sync operation
   703→ */
   704→export interface ShadowSyncResult {
   705→  success: boolean;
   706→  pulled: boolean;
   707→  pushed: boolean;
   708→  hadConflict: boolean;
   709→  error?: string;
   710→}
   711→
   712→/**
   713→ * Fire-and-forget push to remote.
   714→ * AC-1: Called after each auto-commit when tracking is configured.
   715→ * AC-8: Automatically sets up tracking if main branch has remote.
   716→ * Silently ignores errors - the local commit succeeded regardless.
   717→ *
   718→ * @param worktreeDir Path to .kspec/ worktree
   719→ * @param verbose Enable debug output
   720→ */
   721→export async function shadowPushAsync(worktreeDir: string, verbose?: boolean): Promise<void> {
   722→  const debug = isDebugMode(verbose);
   723→
   724→  // AC-8: Auto-configure tracking if main has remote but shadow doesn't
   725→  const projectRoot = path.dirname(worktreeDir);
   726→  await ensureRemoteTracking(worktreeDir, projectRoot);
   727→
   728→  // Check if tracking is configured before attempting push
   729→  if (!(await hasRemoteTracking(worktreeDir))) {
   730→    if (debug) {
   731→      console.error('[DEBUG] Shadow push: No remote tracking configured, skipping');
   732→    }
   733→    return; // AC-4: silently skip if no tracking
   734→  }
   735→
   736→  try {
   737→    if (debug) {
   738→      console.error(`[DEBUG] Shadow push: git push (cwd: ${worktreeDir})`);
   739→    }
   740→
   741→    // Don't await - fire and forget
   742→    execAsync('git push', { cwd: worktreeDir }).catch((err) => {
   743→      if (debug) {
   744→        console.error('[DEBUG] Shadow push failed:', err);
   745→      }
   746→      // Silently ignore push failures - local state is correct
   747→    });
   748→  } catch (err) {
   749→    if (debug) {
   750→      console.error('[DEBUG] Shadow push error:', err);
   751→    }
   752→  }
   753→}
   754→
   755→/**
   756→ * Pull remote changes to shadow branch.
   757→ * AC-2: Called at session start to sync before operations.
   758→ * AC-6: Uses --ff-only first, falls back to --rebase.
   759→ * AC-3: On conflict, returns failure with suggestion.
   760→ * AC-8: Automatically sets up tracking if main branch has remote.
   761→ */
   762→export async function shadowPull(worktreeDir: string): Promise<ShadowSyncResult> {
   763→  const result: ShadowSyncResult = {
   764→    success: false,
   765→    pulled: false,
   766→    pushed: false,
   767→    hadConflict: false,
   768→  };
   769→
   770→  // AC-8: Auto-configure tracking if main has remote but shadow doesn't
   771→  const projectRoot = path.dirname(worktreeDir);
   772→  await ensureRemoteTracking(worktreeDir, projectRoot);
   773→
   774→  // AC-4: Skip if no remote tracking
   775→  if (!(await hasRemoteTracking(worktreeDir))) {
   776→    result.success = true;
   777→    return result;
   778→  }
   779→
   780→  // Check if remote branch exists before attempting pull
   781→  // Fetch first to ensure refs are up to date
   782→  await fetchRemote(projectRoot);
   783→  const remoteHasBranch = await remoteBranchExists(projectRoot, SHADOW_BRANCH_NAME);
   784→  if (!remoteHasBranch) {
   785→    // Remote branch doesn't exist yet - nothing to pull, but success
   786→    result.success = true;
   787→    return result;
   788→  }
   789→
   790→  try {
   791→    // Try fast-forward only first (cleanest)
   792→    await execAsync('git pull --ff-only', { cwd: worktreeDir });
   793→    result.success = true;
   794→    result.pulled = true;
   795→    return result;
   796→  } catch {
   797→    // Fast-forward failed, try rebase
   798→  }
   799→
   800→  try {
   801→    // AC-6: Fall back to rebase
   802→    await execAsync('git pull --rebase', { cwd: worktreeDir });
   803→    result.success = true;
   804→    result.pulled = true;
   805→    return result;
   806→  } catch {
   807→    // Rebase failed - likely conflict
   808→  }
   809→
   810→  // AC-3: Conflict detected - abort rebase and report
   811→  try {
   812→    await execAsync('git rebase --abort', { cwd: worktreeDir });
   813→  } catch {
   814→    // May not be in rebase state, ignore
   815→  }
   816→
   817→  result.hadConflict = true;
   818→  result.error = 'Sync conflict detected. Run `kspec shadow resolve` to fix.';
   819→  return result;
   820→}
   821→
   822→/**
   823→ * Full sync operation: pull then push.
   824→ * Used by session start and explicit sync commands.
   825→ */
   826→export async function shadowSync(worktreeDir: string): Promise<ShadowSyncResult> {
   827→  // First pull
   828→  const pullResult = await shadowPull(worktreeDir);
   829→  if (!pullResult.success) {
   830→    return pullResult;
   831→  }
   832→
   833→  // Then push (only if tracking configured, checked inside)
   834→  if (await hasRemoteTracking(worktreeDir)) {
   835→    try {
   836→      await execAsync('git push', { cwd: worktreeDir });
   837→      pullResult.pushed = true;
   838→    } catch {
   839→      // Push failed - not a critical error, local state is correct
   840→      // Could be permissions, network, etc.
   841→    }
   842→  }
   843→
   844→  return pullResult;
   845→}
   846→
   847→/**
   848→ * Check if .gitignore has uncommitted changes
   849→ */
   850→async function hasUncommittedGitignore(projectRoot: string): Promise<boolean> {
   851→  try {
   852→    // Check both staged and unstaged changes to .gitignore
   853→    const { stdout } = await execAsync('git status --porcelain .gitignore', {
   854→      cwd: projectRoot,
   855→    });
   856→    return stdout.trim().length > 0;
   857→  } catch {
   858→    return false;
   859→  }
   860→}
   861→
   862→/**
   863→ * Commit only .gitignore with a message
   864→ */
   865→async function commitGitignore(projectRoot: string): Promise<void> {
   866→  await execAsync('git add .gitignore', { cwd: projectRoot });
   867→  await execAsync('git commit -m "chore: add .kspec/ to .gitignore for shadow branch"', {
   868→    cwd: projectRoot,
   869→  });
   870→}
   871→
   872→/**
   873→ * Add .kspec/ to .gitignore if not already present.
   874→ * Fails if .gitignore has uncommitted changes.
   875→ * Commits the change after adding.
   876→ */
   877→async function ensureGitignore(projectRoot: string): Promise<boolean> {
   878→  const gitignorePath = path.join(projectRoot, '.gitignore');
   879→  const entry = `${SHADOW_WORKTREE_DIR}/`;
   880→
   881→  // Fail fast if .gitignore has uncommitted changes
   882→  if (await hasUncommittedGitignore(projectRoot)) {
   883→    throw new ShadowError(
   884→      '.gitignore has uncommitted changes',
   885→      'GIT_ERROR',
   886→      'Commit or stash your .gitignore changes before running kspec init.'
   887→    );
   888→  }
   889→
   890→  try {
   891→    let content = '';
   892→    try {
   893→      content = await fs.readFile(gitignorePath, 'utf-8');
   894→    } catch {
   895→      // File doesn't exist, will create
   896→    }
   897→
   898→    // Check if already present (handle various formats)
   899→    const lines = content.split('\n');
   900→    const patterns = [
   901→      SHADOW_WORKTREE_DIR,
   902→      `${SHADOW_WORKTREE_DIR}/`,
   903→      `/${SHADOW_WORKTREE_DIR}`,
   904→      `/${SHADOW_WORKTREE_DIR}/`,
   905→    ];
   906→
   907→    for (const line of lines) {
   908→      const trimmed = line.trim();
   909→      if (patterns.includes(trimmed)) {
   910→        return false; // Already present
   911→      }
   912→    }
   913→
   914→    // Add to gitignore
   915→    const newContent = content.endsWith('\n') || content === ''
   916→      ? `${content}${entry}\n`
   917→      : `${content}\n${entry}\n`;
   918→
   919→    await fs.writeFile(gitignorePath, newContent, 'utf-8');
   920→
   921→    // Commit the change
   922→    await commitGitignore(projectRoot);
   923→
   924→    return true;
   925→  } catch (error) {
   926→    if (error instanceof ShadowError) {
   927→      throw error;
   928→    }
   929→    throw new ShadowError(
   930→      `Failed to update .gitignore: ${error}`,
   931→      'GIT_ERROR',
   932→      'Check file permissions for .gitignore'
   933→    );
   934→  }
   935→}
   936→
   937→/**
   938→ * Generate initial manifest content for shadow branch
   939→ */
   940→function generateShadowManifest(projectName: string): string {
   941→  return `# ${projectName} - Kynetic Spec
   942→# Generated by kspec init
   943→
   944→kynetic: "1.0"
   945→
   946→project:
   947→  name: "${projectName}"
   948→  version: "0.1.0"
   949→  status: draft
   950→  description: |
   951→    Add your project description here.
   952→
   953→# Module includes
   954→includes:
   955→  - modules/main.yaml
   956→
   957→# Configuration
   958→config:
   959→  validation:
   960→    strict_refs: true
   961→    require_acceptance: false
   962→`;
   963→}
   964→
   965→/**
   966→ * Generate initial module content
   967→ */
   968→function generateShadowModule(projectName: string): string {
   969→  return `# ${projectName} - Main Module
   970→# Add your spec items here
   971→
   972→items: []
   973→`;
   974→}
   975→
   976→/**
   977→ * Generate initial tasks file
   978→ */
   979→function generateShadowTasks(projectName: string): string {
   980→  return `# ${projectName} - Tasks
   981→# Track implementation work here
   982→
   983→tasks: []
   984→`;
   985→}
   986→
   987→/**
   988→ * Generate initial inbox file
   989→ */
   990→function generateShadowInbox(): string {
   991→  return `# Inbox - Quick Capture
   992→# Ideas and notes that haven't been triaged yet
   993→
   994→items: []
   995→`;
   996→}
   997→
   998→/**
   999→ * Install pre-commit hook to protect kspec-meta branch.
  1000→ * Hook prevents direct commits to shadow branch unless KSPEC_SHADOW_COMMIT=1.
  1001→ *
  1002→ * Note: Git worktrees use hooks from the main .git/hooks directory (via commondir),
  1003→ * not from .git/worktrees/-kspec/hooks. So we install to main hooks directory.
  1004→ *
  1005→ * @param projectRoot Git repository root
  1006→ * @returns true if hook was installed, false if already exists
  1007→ */
  1008→async function installShadowHook(projectRoot: string): Promise<boolean> {
  1009→  const hooksDir = path.join(projectRoot, '.git', 'hooks');
  1010→  const hookPath = path.join(hooksDir, 'pre-commit');
  1011→  const sourceHookPath = path.join(projectRoot, 'hooks', 'pre-commit');
  1012→
  1013→  try {
  1014→    // Check if source hook exists
  1015→    try {
  1016→      await fs.access(sourceHookPath);
  1017→    } catch {
  1018→      // Source hook doesn't exist - skip installation
  1019→      return false;
  1020→    }
  1021→
  1022→    // Check if hook already exists
  1023→    try {
  1024→      await fs.access(hookPath);
  1025→      // Hook exists - don't overwrite (user may have custom hooks)
  1026→      return false;
  1027→    } catch {
  1028→      // Hook doesn't exist - install it
  1029→    }
  1030→
  1031→    // Copy hook from source
  1032→    const hookContent = await fs.readFile(sourceHookPath, 'utf-8');
  1033→    await fs.writeFile(hookPath, hookContent, { mode: 0o755 });
  1034→    return true;
  1035→  } catch (error) {
  1036→    // Silently fail - hook installation is optional
  1037→    return false;
  1038→  }
  1039→}
  1040→
  1041→/**
  1042→ * Convert project name to slug (kebab-case)
  1043→ */
  1044→function toSlug(projectName: string): string {
  1045→  return projectName
  1046→    .toLowerCase()
  1047→    .replace(/[^a-z0-9]+/g, '-')
  1048→    .replace(/^-|-$/g, '');
  1049→}
  1050→
  1051→/**
  1052→ * Initialize shadow branch and worktree.
  1053→ * Creates orphan branch, worktree, updates gitignore, and creates initial structure.
  1054→ *
  1055→ * @param projectRoot Git repository root
  1056→ * @param options Initialization options
  1057→ * @returns Result indicating what was created
  1058→ */
  1059→export async function initializeShadow(
  1060→  projectRoot: string,
  1061→  options: ShadowInitOptions = {}
  1062→): Promise<ShadowInitResult> {
  1063→  const result: ShadowInitResult = {
  1064→    success: false,
  1065→    branchCreated: false,
  1066→    worktreeCreated: false,
  1067→    gitignoreUpdated: false,
  1068→    initialCommit: false,
  1069→    alreadyExists: false,
  1070→    createdFromRemote: false,
  1071→    pushedToRemote: false,
  1072→  };
  1073→
  1074→  // Check if we're in a git repo
  1075→  if (!(await isGitRepo(projectRoot))) {
  1076→    result.error = 'Not a git repository';
  1077→    return result;
  1078→  }
  1079→
  1080→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
  1081→
  1082→  // Check current status
  1083→  const status = await getShadowStatus(projectRoot);
  1084→
  1085→  // Handle existing shadow branch
  1086→  if (status.healthy && !options.force) {
  1087→    result.alreadyExists = true;
  1088→    result.success = true;
  1089→    return result;
  1090→  }
  1091→
  1092→  // Derive project name if not provided
  1093→  const projectName = options.projectName || path.basename(projectRoot)
  1094→    .replace(/[-_]/g, ' ')
  1095→    .replace(/\b\w/g, (c) => c.toUpperCase());
  1096→
  1097→  const slug = toSlug(projectName);
  1098→
  1099→  // Check for remote shadow branch (AC-4: fetch to ensure refs are up to date)
  1100→  const remoteExists = await hasRemote(projectRoot);
  1101→  let remoteHasShadow = false;
  1102→  if (remoteExists) {
  1103→    await fetchRemote(projectRoot); // Best effort, ignore failures
  1104→    remoteHasShadow = await remoteBranchExists(projectRoot, SHADOW_BRANCH_NAME);
  1105→  }
  1106→
  1107→  try {
  1108→    // Step 1: Update .gitignore first (before creating .kspec/)
  1109→    result.gitignoreUpdated = await ensureGitignore(projectRoot);
  1110→
  1111→    // Step 2: Create worktree with orphan branch (or attach to existing branch)
  1112→    if (!status.worktreeExists || !status.worktreeLinked) {
  1113→      // Remove existing directory if present but not linked
  1114→      if (status.worktreeExists && !status.worktreeLinked) {
  1115→        await fs.rm(worktreeDir, { recursive: true, force: true });
  1116→      }
  1117→
  1118→      // Remove stale worktree reference if any
  1119→      try {
  1120→        await execAsync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, {
  1121→          cwd: projectRoot,
  1122→        });
  1123→      } catch {
  1124→        // Ignore - worktree may not exist in git's list
  1125→      }
  1126→
  1127→      if (remoteHasShadow) {
  1128→        // AC-1: Remote has shadow branch - create worktree from it with tracking
  1129→        await execAsync(
  1130→          `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1131→          { cwd: projectRoot }
  1132→        );
  1133→        // Set up tracking for the branch
  1134→        await execAsync(
  1135→          `git branch --set-upstream-to=origin/${SHADOW_BRANCH_NAME} ${SHADOW_BRANCH_NAME}`,
  1136→          { cwd: projectRoot }
  1137→        );
  1138→        result.createdFromRemote = true;
  1139→      } else if (!status.branchExists) {
  1140→        // AC-2/AC-3: No remote branch or no remote - create orphan branch
  1141→        await execAsync(
  1142→          `git worktree add --orphan -b ${SHADOW_BRANCH_NAME} ${SHADOW_WORKTREE_DIR}`,
  1143→          { cwd: projectRoot }
  1144→        );
  1145→        result.branchCreated = true;
  1146→      } else {
  1147→        // Attach to existing local branch
  1148→        await execAsync(
  1149→          `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1150→          { cwd: projectRoot }
  1151→        );
  1152→      }
  1153→
  1154→      result.worktreeCreated = true;
  1155→    }
  1156→
  1157→    // Step 3: Create initial structure if empty (only for new branches, not remote)
  1158→    const manifestPath = path.join(worktreeDir, `${slug}.yaml`);
  1159→    const modulesDir = path.join(worktreeDir, 'modules');
  1160→    const moduleFilePath = path.join(modulesDir, 'main.yaml');
  1161→    const tasksPath = path.join(worktreeDir, `${slug}.tasks.yaml`);
  1162→    const inboxPath = path.join(worktreeDir, `${slug}.inbox.yaml`);
  1163→
  1164→    let filesCreated = false;
  1165→
  1166→    // Only create files if manifest doesn't exist (remote branches will have files)
  1167→    try {
  1168→      // Look for any .yaml manifest file (project name may differ)
  1169→      const files = await fs.readdir(worktreeDir);
  1170→      const hasManifest = files.some(f => f.endsWith('.yaml') && !f.includes('.tasks.') && !f.includes('.inbox.'));
  1171→      if (!hasManifest) {
  1172→        throw new Error('No manifest found');
  1173→      }
  1174→    } catch {
  1175→      // Manifest doesn't exist, create initial structure
  1176→      await fs.mkdir(modulesDir, { recursive: true });
  1177→      await fs.writeFile(manifestPath, generateShadowManifest(projectName), 'utf-8');
  1178→      await fs.writeFile(moduleFilePath, generateShadowModule(projectName), 'utf-8');
  1179→      await fs.writeFile(tasksPath, generateShadowTasks(projectName), 'utf-8');
  1180→      await fs.writeFile(inboxPath, generateShadowInbox(), 'utf-8');
  1181→      filesCreated = true;
  1182→    }
  1183→
  1184→    // Step 4: Initial commit if files were created
  1185→    if (filesCreated) {
  1186→      result.initialCommit = await shadowAutoCommit(
  1187→        worktreeDir,
  1188→        `Initialize ${projectName} spec`
  1189→      );
  1190→    }
  1191→
  1192→    // Step 5: AC-2: Push new branch to remote to establish tracking
  1193→    if (result.branchCreated && remoteExists && !remoteHasShadow) {
  1194→      result.pushedToRemote = await pushShadowBranch(worktreeDir);
  1195→    }
  1196→
  1197→    // Step 6: Install pre-commit hook to protect shadow branch
  1198→    await installShadowHook(projectRoot);
  1199→
  1200→    result.success = true;
  1201→    return result;
  1202→  } catch (error) {
  1203→    result.error = error instanceof Error ? error.message : String(error);
  1204→    return result;
  1205→  }
  1206→}
  1207→
  1208→/**
  1209→ * Repair a broken shadow branch setup.
  1210→ * Handles cases where worktree is disconnected or directory is missing.
  1211→ *
  1212→ * @param projectRoot Git repository root
  1213→ * @returns Result indicating what was repaired
  1214→ */
  1215→export async function repairShadow(projectRoot: string): Promise<ShadowInitResult> {
  1216→  const status = await getShadowStatus(projectRoot);
  1217→
  1218→  if (status.healthy) {
  1219→    return {
  1220→      success: true,
  1221→      branchCreated: false,
  1222→      worktreeCreated: false,
  1223→      gitignoreUpdated: false,
  1224→      initialCommit: false,
  1225→      alreadyExists: true,
  1226→      createdFromRemote: false,
  1227→      pushedToRemote: false,
  1228→    };
  1229→  }
  1230→
  1231→  if (!status.branchExists) {
  1232→    // Can't repair without a branch - need full init
  1233→    return {
  1234→      success: false,
  1235→      branchCreated: false,
  1236→      worktreeCreated: false,
  1237→      gitignoreUpdated: false,
  1238→      initialCommit: false,
  1239→      alreadyExists: false,
  1240→      createdFromRemote: false,
  1241→      pushedToRemote: false,
  1242→      error: 'Shadow branch does not exist. Run `kspec init` instead.',
  1243→    };
  1244→  }
  1245→
  1246→  // Branch exists but worktree is broken - repair it
  1247→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
  1248→
  1249→  try {
  1250→    // Remove stale worktree reference
  1251→    try {
  1252→      await execAsync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, {
  1253→        cwd: projectRoot,
  1254→      });
  1255→    } catch {
  1256→      // Ignore - worktree may not be in git's list
  1257→    }
  1258→
  1259→    // Remove directory if exists (handles corrupted .git file case)
  1260→    await fs.rm(worktreeDir, { recursive: true, force: true });
  1261→
  1262→    // Prune stale worktree references (cleans up orphaned entries)
  1263→    try {
  1264→      await execAsync('git worktree prune', { cwd: projectRoot });
  1265→    } catch {
  1266→      // Ignore - prune is best-effort
  1267→    }
  1268→
  1269→    // Recreate worktree
  1270→    await execAsync(
  1271→      `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1272→      { cwd: projectRoot }
  1273→    );
  1274→
  1275→    // Install pre-commit hook
  1276→    await installShadowHook(projectRoot);
  1277→
  1278→    return {
  1279→      success: true,
  1280→      branchCreated: false,
  1281→      worktreeCreated: true,
  1282→      gitignoreUpdated: false,
  1283→      initialCommit: false,
  1284→      alreadyExists: false,
  1285→      createdFromRemote: false,
  1286→      pushedToRemote: false,
  1287→    };
  1288→  } catch (error) {
  1289→    return {
  1290→      success: false,
  1291→      branchCreated: false,
  1292→      worktreeCreated: false,
  1293→      gitignoreUpdated: false,
  1294→      initialCommit: false,
  1295→      alreadyExists: false,
  1296→      createdFromRemote: false,
  1297→      pushedToRemote: false,
  1298→      error: error instanceof Error ? error.message : String(error),
  1299→    };
  1300→  }
  1301→}
  1302→

