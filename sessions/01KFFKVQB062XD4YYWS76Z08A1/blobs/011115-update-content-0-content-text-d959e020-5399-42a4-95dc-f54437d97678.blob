```
     1→import chalk from 'chalk';
     2→import type { Task, TaskStatus } from '../schema/index.js';
     3→import type { ReferenceIndex } from '../parser/index.js';
     4→import { grepItem, formatMatchedFields } from '../utils/grep.js';
     5→import { fieldLabels, sectionHeaders, summaries } from '../strings/labels.js';
     6→
     7→/**
     8→ * Output options
     9→ */
    10→export interface OutputOptions {
    11→  json?: boolean;
    12→}
    13→
    14→/**
    15→ * Global output format (set by --json flag)
    16→ */
    17→let globalJsonMode = false;
    18→
    19→export function setJsonMode(enabled: boolean): void {
    20→  globalJsonMode = enabled;
    21→}
    22→
    23→export function isJsonMode(): boolean {
    24→  return globalJsonMode;
    25→}
    26→
    27→/**
    28→ * Global verbose mode (set by --verbose flag)
    29→ */
    30→let globalVerboseMode = false;
    31→
    32→export function setVerboseMode(enabled: boolean): void {
    33→  globalVerboseMode = enabled;
    34→}
    35→
    36→export function getVerboseMode(): boolean {
    37→  return globalVerboseMode;
    38→}
    39→
    40→/**
    41→ * Output data - JSON if --json flag, otherwise formatted
    42→ */
    43→export function output(data: unknown, formatter?: () => void): void {
    44→  if (globalJsonMode) {
    45→    console.log(JSON.stringify(data, null, 2));
    46→  } else if (formatter) {
    47→    formatter();
    48→  } else {
    49→    console.log(data);
    50→  }
    51→}
    52→
    53→/**
    54→ * Output success message
    55→ */
    56→export function success(message: string, data?: Record<string, unknown>): void {
    57→  if (globalJsonMode) {
    58→    console.log(JSON.stringify({ success: true, message, ...data }));
    59→  } else {
    60→    console.log(chalk.green('OK'), message);
    61→  }
    62→}
    63→
    64→/**
    65→ * Output error message
    66→ */
    67→export function error(message: string, details?: unknown): void {
    68→  if (globalJsonMode) {
    69→    console.error(JSON.stringify({ success: false, error: message, details }));
    70→  } else {
    71→    console.error(chalk.red('✗'), message);
    72→    if (details) {
    73→      console.error(chalk.gray(String(details)));
    74→      // Show suggestion if it's a ShadowError with a suggestion
    75→      if (details && typeof details === 'object' && 'suggestion' in details) {
    76→        const suggestion = (details as { suggestion?: string }).suggestion;
    77→        if (suggestion) {
    78→          console.error(chalk.yellow('  Suggestion:'), suggestion);
    79→        }
    80→      }
    81→    }
    82→  }
    83→}
    84→
    85→/**
    86→ * Output warning message
    87→ */
    88→export function warn(message: string): void {
    89→  if (globalJsonMode) {
    90→    // Warnings are suppressed in JSON mode
    91→  } else {
    92→    console.warn(chalk.yellow('⚠'), message);
    93→  }
    94→}
    95→
    96→/**
    97→ * Output info message
    98→ */
    99→export function info(message: string): void {
   100→  if (globalJsonMode) {
   101→    // Info messages suppressed in JSON mode
   102→  } else {
   103→    console.log(chalk.blue('ℹ'), message);
   104→  }
   105→}
   106→
   107→/**
   108→ * Get color for task status
   109→ */
   110→function statusColor(status: TaskStatus): (text: string) => string {
   111→  switch (status) {
   112→    case 'pending':
   113→      return (t: string) => chalk.gray(t);
   114→    case 'in_progress':
   115→      return (t: string) => chalk.blue(t);
   116→    case 'blocked':
   117→      return (t: string) => chalk.red(t);
   118→    case 'completed':
   119→      return (t: string) => chalk.green(t);
   120→    case 'cancelled':
   121→      return (t: string) => chalk.strikethrough.gray(t);
   122→    default:
   123→      return (t: string) => chalk.white(t);
   124→  }
   125→}
   126→
   127→/**
   128→ * Format a task reference (short ULID + slug if available)
   129→ * @param task The task to format
   130→ * @param index Optional ReferenceIndex for dynamic short ULID computation
   131→ */
   132→export function formatTaskRef(task: Task, index?: ReferenceIndex): string {
   133→  const shortId = index ? index.shortUlid(task._ulid) : task._ulid.slice(0, 8);
   134→  if (task.slugs.length > 0) {
   135→    return `${shortId} (${task.slugs[0]})`;
   136→  }
   137→  return shortId;
   138→}
   139→
   140→/**
   141→ * Format task for display
   142→ */
   143→export function formatTask(task: Task, verbose = false, index?: ReferenceIndex, full = false): string {
   144→  const ref = formatTaskRef(task, index);
   145→  const status = statusColor(task.status)(`[${task.status}]`);
   146→  const priority = task.priority <= 2 ? chalk.red(`P${task.priority}`) : chalk.gray(`P${task.priority}`);
   147→
   148→  let line = `${ref} ${status} ${priority} ${task.title}`;
   149→
   150→  if (verbose && !full) {
   151→    // AC-2: Single verbose (-v) shows current behavior
   152→    if (task.spec_ref) {
   153→      line += chalk.gray(` (spec: ${task.spec_ref})`);
   154→    }
   155→    if (task.depends_on.length > 0) {
   156→      line += chalk.gray(` deps: [${task.depends_on.join(', ')}]`);
   157→    }
   158→    if (task.tags.length > 0) {
   159→      line += chalk.cyan(` #${task.tags.join(' #')}`);
   160→    }
   161→  }
   162→
   163→  return line;
   164→}
   165→
   166→/**
   167→ * Get first line of text, truncated to max length
   168→ */
   169→function getFirstLine(text: string | undefined, maxLength: number = 70): string | undefined {
   170→  if (!text) return undefined;
   171→  const firstLine = text.split('\n')[0].trim();
   172→  if (firstLine.length <= maxLength) return firstLine;
   173→  return firstLine.slice(0, maxLength - 3) + '...';
   174→}
   175→
   176→/**
   177→ * Format full mode context for a task (AC-1, AC-3, AC-5)
   178→ */
   179→function formatFullModeContext(task: Task, index?: ReferenceIndex): void {
   180→  const indent = '    ';
   181→
   182→  // Show timestamps (AC-1)
   183→  console.log(chalk.gray(`${indent}Created: ${task.created_at}`));
   184→  if (task.started_at) {
   185→    console.log(chalk.gray(`${indent}Started: ${task.started_at}`));
   186→  }
   187→  if (task.completed_at) {
   188→    console.log(chalk.gray(`${indent}Completed: ${task.completed_at}`));
   189→  }
   190→
   191→  // Show notes count and most recent note (AC-1, AC-3)
   192→  if (task.notes && task.notes.length > 0) {
   193→    const mostRecent = task.notes[task.notes.length - 1];
   194→    const preview = getFirstLine(mostRecent.content, 50);
   195→    console.log(chalk.gray(`${indent}Notes: ${task.notes.length} (latest: "${preview}")`));
   196→  }
   197→
   198→  // Show pending todos count (AC-1, AC-3)
   199→  if (task.todos && task.todos.length > 0) {
   200→    const pendingCount = task.todos.filter(t => !t.done).length;
   201→    if (pendingCount > 0) {
   202→      console.log(chalk.gray(`${indent}Pending todos: ${pendingCount}`));
   203→    }
   204→  }
   205→
   206→  // Show spec context (AC-5)
   207→  if (task.spec_ref && index) {
   208→    const result = index.resolve(task.spec_ref);
   209→    if (result.ok) {
   210→      const spec = result.item;
   211→      const specName = 'title' in spec ? spec.title : ('name' in spec ? spec.name : ('id' in spec ? spec.id : task.spec_ref));
   212→      console.log(chalk.gray(`${indent}Spec: ${task.spec_ref}`));
   213→      console.log(chalk.cyan(`${indent}  ${specName}`));
   214→
   215→      // Show spec description if available
   216→      if ('description' in spec && spec.description) {
   217→        const descPreview = getFirstLine(spec.description as string, 70);
   218→        console.log(chalk.gray(`${indent}  ${descPreview}`));
   219→      }
   220→
   221→      // Show acceptance criteria if available
   222→      if ('acceptance_criteria' in spec && Array.isArray(spec.acceptance_criteria)) {
   223→        const ac = spec.acceptance_criteria;
   224→        if (ac.length > 0) {
   225→          console.log(chalk.gray(`${indent}  Acceptance Criteria: ${ac.length}`));
   226→          // Show first AC as preview
   227→          const firstAC = ac[0];
   228→          if (typeof firstAC === 'object' && firstAC !== null && 'id' in firstAC) {
   229→            console.log(chalk.gray(`${indent}    [${firstAC.id}] ${firstAC.then}`));
   230→          }
   231→        }
   232→      }
   233→    }
   234→  }
   235→
   236→  // Show tags and dependencies if present
   237→  if (task.tags && task.tags.length > 0) {
   238→    console.log(chalk.gray(`${indent}Tags: ${task.tags.join(', ')}`));
   239→  }
   240→  if (task.depends_on && task.depends_on.length > 0) {
   241→    console.log(chalk.gray(`${indent}Depends on: ${task.depends_on.join(', ')}`));
   242→  }
   243→}
   244→
   245→/**
   246→ * Format automation status as a colored label
   247→ * AC: @task-automation-eligibility ac-14
   248→ */
   249→function formatAutomationStatus(automation: string | undefined): string {
   250→  if (!automation) {
   251→    return chalk.gray('[unassessed]');
   252→  }
   253→  switch (automation) {
   254→    case 'eligible':
   255→      return chalk.green('[eligible]');
   256→    case 'needs_review':
   257→      return chalk.yellow('[needs_review]');
   258→    case 'manual_only':
   259→      return chalk.red('[manual_only]');
   260→    default:
   261→      return chalk.gray(`[${automation}]`);
   262→  }
   263→}
   264→
   265→/**
   266→ * Format a list of tasks with automation status
   267→ * AC: @task-automation-eligibility ac-14
   268→ */
   269→export function formatTaskListWithAutomation(tasks: Task[], verbose = false, index?: ReferenceIndex, grepPattern?: string, full = false): void {
   270→  if (tasks.length === 0) {
   271→    console.log(summaries.noTasks);
   272→    return;
   273→  }
   274→
   275→  for (const task of tasks) {
   276→    const ref = formatTaskRef(task, index);
   277→    const status = statusColor(task.status)(`[${task.status}]`);
   278→    const priority = task.priority <= 2 ? chalk.red(`P${task.priority}`) : chalk.gray(`P${task.priority}`);
   279→    const automationLabel = formatAutomationStatus(task.automation);
   280→
   281→    let line = `${ref} ${status} ${priority} ${automationLabel} ${task.title}`;
   282→
   283→    if (verbose && !full) {
   284→      if (task.spec_ref) {
   285→        line += chalk.gray(` (spec: ${task.spec_ref})`);
   286→      }
   287→      if (task.depends_on.length > 0) {
   288→        line += chalk.gray(` deps: [${task.depends_on.join(', ')}]`);
   289→      }
   290→      if (task.tags.length > 0) {
   291→        line += chalk.cyan(` #${task.tags.join(' #')}`);
   292→      }
   293→    }
   294→
   295→    console.log(line);
   296→
   297→    // Show matched fields if grep pattern provided
   298→    if (grepPattern) {
   299→      const match = grepItem(task as unknown as Record<string, unknown>, grepPattern);
   300→      if (match && match.matchedFields.length > 0) {
   301→        console.log(chalk.gray(`    matched: ${formatMatchedFields(match.matchedFields)}`));
   302→      }
   303→    } else if (full) {
   304→      formatFullModeContext(task, index);
   305→    } else {
   306→      // Show context line: first line of description (if present)
   307→      const context = getFirstLine(task.description);
   308→      if (context) {
   309→        console.log(chalk.gray(`    ${context}`));
   310→      }
   311→    }
   312→  }
   313→
   314→  console.log(summaries.taskCount(tasks.length));
   315→}
   316→
   317→/**
   318→ * Format a list of tasks
   319→ */
   320→export function formatTaskList(tasks: Task[], verbose = false, index?: ReferenceIndex, grepPattern?: string, full = false): void {
   321→  if (tasks.length === 0) {
   322→    console.log(summaries.noTasks);
   323→    return;
   324→  }
   325→
   326→  for (const task of tasks) {
   327→    console.log(formatTask(task, verbose, index, full));
   328→
   329→    // Show matched fields if grep pattern provided
   330→    if (grepPattern) {
   331→      const match = grepItem(task as unknown as Record<string, unknown>, grepPattern);
   332→      if (match && match.matchedFields.length > 0) {
   333→        console.log(chalk.gray(`    matched: ${formatMatchedFields(match.matchedFields)}`));
   334→      }
   335→    } else if (full) {
   336→      // AC-1: Full mode shows richer context
   337→      formatFullModeContext(task, index);
   338→    } else {
   339→      // Show context line: first line of description (if present)
   340→      const context = getFirstLine(task.description);
   341→      if (context) {
   342→        console.log(chalk.gray(`    ${context}`));
   343→      }
   344→    }
   345→  }
   346→
   347→  console.log(summaries.taskCount(tasks.length));
   348→}
   349→
   350→/**
   351→ * Format task details
   352→ */
   353→export function formatTaskDetails(task: Task, index?: ReferenceIndex): void {
   354→  console.log(chalk.bold(task.title));
   355→  console.log(chalk.gray('─'.repeat(40)));
   356→  console.log(`${fieldLabels.ulid}      ${task._ulid}`);
   357→  if (task.slugs.length > 0) {
   358→    console.log(`${fieldLabels.slugs}     ${task.slugs.join(', ')}`);
   359→  }
   360→  console.log(`${fieldLabels.type}      ${task.type}`);
   361→  console.log(`${fieldLabels.status}    ${statusColor(task.status)(task.status)}`);
   362→  console.log(`${fieldLabels.priority}  ${task.priority}`);
   363→
   364→  // AC: @task-automation-eligibility ac-17 - show automation status
   365→  const automationDisplay = task.automation || 'unassessed';
   366→  const automationColor = task.automation === 'eligible' ? chalk.green
   367→    : task.automation === 'needs_review' ? chalk.yellow
   368→    : task.automation === 'manual_only' ? chalk.red
   369→    : chalk.gray;
   370→  console.log(`${fieldLabels.automation} ${automationColor(automationDisplay)}`);
   371→
   372→  if (task.spec_ref) {
   373→    console.log(`${fieldLabels.specRef}  ${task.spec_ref}`);
   374→  }
   375→
   376→  if (task.depends_on.length > 0) {
   377→    if (index) {
   378→      console.log(fieldLabels.depends);
   379→      for (const ref of task.depends_on) {
   380→        const result = index.resolve(ref);
   381→        if (result.ok) {
   382→          const item = result.item;
   383→          const status = 'status' in item && typeof item.status === 'string'
   384→            ? statusColor(item.status as TaskStatus)(`[${item.status}]`)
   385→            : chalk.gray('[spec]');
   386→          // Handle both spec items (with title) and meta items (with name or id)
   387→          const itemName = 'title' in item ? item.title : ('name' in item ? item.name : ('id' in item ? item.id : ref));
   388→          console.log(`  ${ref} ${chalk.gray('→')} ${itemName} ${status}`);
   389→        } else {
   390→          console.log(`  ${ref} ${chalk.red('(unresolved)')}`);
   391→        }
   392→      }
   393→    } else {
   394→      console.log(`${fieldLabels.depends}   ${task.depends_on.join(', ')}`);
   395→    }
   396→  }
   397→
   398→  if (task.blocked_by.length > 0) {
   399→    console.log(chalk.red(`${fieldLabels.blocked}   ${task.blocked_by.join(', ')}`));
   400→  }
   401→
   402→  if (task.tags.length > 0) {
   403→    console.log(`${fieldLabels.tags}      ${task.tags.join(', ')}`);
   404→  }
   405→
   406→  console.log(`${fieldLabels.created}   ${task.created_at}`);
   407→  if (task.started_at) {
   408→    console.log(`${fieldLabels.started}   ${task.started_at}`);
   409→  }
   410→  if (task.completed_at) {
   411→    console.log(`${fieldLabels.completed} ${task.completed_at}`);
   412→  }
   413→
   414→  // Show resolved spec information
   415→  if (task.spec_ref && index) {
   416→    const result = index.resolve(task.spec_ref);
   417→    if (result.ok) {
   418→      const spec = result.item;
   419→      console.log(`\n${sectionHeaders.specContext}`);
   420→      // Handle both spec items (with title) and meta items (with name)
   421→      const specName = 'title' in spec ? spec.title : ('name' in spec ? spec.name : ('id' in spec ? spec.id : task.spec_ref));
   422→      console.log(chalk.cyan(specName));
   423→      if ('type' in spec && spec.type) {
   424→        console.log(chalk.gray(`${fieldLabels.type} ${spec.type}`));
   425→      }
   426→      // Show implementation status
   427→      if ('status' in spec && spec.status && typeof spec.status === 'object') {
   428→        const status = spec.status as { maturity?: string; implementation?: string };
   429→        if (status.implementation) {
   430→          const implColor = status.implementation === 'verified' ? chalk.green
   431→            : status.implementation === 'implemented' ? chalk.cyan
   432→            : status.implementation === 'in_progress' ? chalk.yellow
   433→            : chalk.gray;
   434→          console.log(chalk.gray(fieldLabels.implementation) + implColor(status.implementation));
   435→        }
   436→      }
   437→      if ('description' in spec && spec.description) {
   438→        console.log(chalk.gray(fieldLabels.description));
   439→        // Indent description lines
   440→        const desc = String(spec.description).trim();
   441→        for (const line of desc.split('\n')) {
   442→          console.log(chalk.gray(`  ${line}`));
   443→        }
   444→      }
   445→      if ('acceptance_criteria' in spec && Array.isArray(spec.acceptance_criteria) && spec.acceptance_criteria.length > 0) {
   446→        console.log(chalk.gray(fieldLabels.acceptanceCriteria));
   447→        for (const ac of spec.acceptance_criteria) {
   448→          if (ac && typeof ac === 'object' && 'id' in ac) {
   449→            const acObj = ac as { id: string; given?: string; when?: string; then?: string };
   450→            console.log(chalk.gray(`  [${acObj.id}]`));
   451→            if (acObj.given) console.log(chalk.gray(`    Given: ${acObj.given}`));
   452→            if (acObj.when) console.log(chalk.gray(`    When: ${acObj.when}`));
   453→            if (acObj.then) console.log(chalk.gray(`    Then: ${acObj.then}`));
   454→          }
   455→        }
   456→      }
   457→      // Show traceability if present
   458→      if ('traceability' in spec && spec.traceability && typeof spec.traceability === 'object') {
   459→        const trace = spec.traceability as {
   460→          implementation?: Array<{ path: string; function?: string; lines?: string }>;
   461→          tests?: Array<{ path: string }>;
   462→          commits?: string[];
   463→          issues?: string[];
   464→        };
   465→        const hasTrace = trace.implementation?.length || trace.tests?.length || trace.commits?.length || trace.issues?.length;
   466→        if (hasTrace) {
   467→          console.log(chalk.gray(fieldLabels.traceability));
   468→          if (trace.implementation?.length) {
   469→            for (const impl of trace.implementation) {
   470→              let loc = `  Code: ${impl.path}`;
   471→              if (impl.function) loc += `::${impl.function}`;
   472→              if (impl.lines) loc += `:${impl.lines}`;
   473→              console.log(chalk.gray(loc));
   474→            }
   475→          }
   476→          if (trace.tests?.length) {
   477→            for (const test of trace.tests) {
   478→              console.log(chalk.gray(`  Test: ${test.path}`));
   479→            }
   480→          }
   481→          if (trace.commits?.length) {
   482→            console.log(chalk.gray(`  Commits: ${trace.commits.join(', ')}`));
   483→          }
   484→          if (trace.issues?.length) {
   485→            console.log(chalk.gray(`  Issues: ${trace.issues.join(', ')}`));
   486→          }
   487→        }
   488→      }
   489→    }
   490→  }
   491→
   492→  if (task.notes.length > 0) {
   493→    console.log(`\n${sectionHeaders.notes}`);
   494→    for (const note of task.notes) {
   495→      const author = note.author || 'unknown';
   496→      console.log(chalk.gray(`[${note.created_at}] ${author}:`));
   497→      console.log(note.content);
   498→    }
   499→  }
   500→
   501→  if (task.todos.length > 0) {
   502→    console.log(`\n${sectionHeaders.todos}`);
   503→    for (const todo of task.todos) {
   504→      const check = todo.done ? chalk.green('✓') : chalk.gray('○');
   505→      const text = todo.done ? chalk.strikethrough.gray(todo.text) : todo.text;
   506→      console.log(`${check} [${todo.id}] ${text}`);
   507→    }
   508→  }
   509→}
