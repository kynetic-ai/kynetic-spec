  1180→
  1181→  // kspec task review <ref>
  1182→  task
  1183→    .command('review <ref>')
  1184→    .description('Get task context for review (task details, spec, ACs, git diff)')
  1185→    .action(async (ref: string) => {
  1186→      try {
  1187→        const ctx = await initContext();
  1188→        const tasks = await loadAllTasks(ctx);
  1189→        const items = await loadAllItems(ctx);
  1190→        const index = new ReferenceIndex(tasks, items);
  1191→        const foundTask = resolveTaskRef(ref, tasks, index);
  1192→
  1193→        // Import getDiffSince from utils
  1194→        const { getDiffSince } = await import('../../utils/index.js');
  1195→
  1196→        // Import scanTestCoverage (we'll need to export it from validate.ts)
  1197→        // For now, duplicate the logic here
  1198→        const scanTestCoverage = async (rootDir: string): Promise<Set<string>> => {
  1199→          const coveredACs = new Set<string>();
  1200→          const testsDir = path.join(rootDir, 'tests');
  1201→          const fs = await import('node:fs/promises');
  1202→
  1203→          try {
  1204→            await fs.access(testsDir);
  1205→            const files = await fs.readdir(testsDir);
  1206→            const testFiles = files.filter(f => f.endsWith('.test.ts') || f.endsWith('.test.js'));
  1207→
  1208→            for (const file of testFiles) {
  1209→              const filePath = path.join(testsDir, file);
  1210→              const content = await fs.readFile(filePath, 'utf-8');
  1211→              const acPattern = /\/\/\s*AC:\s*(@[\w-]+)(?:\s+(ac-\d+(?:\s*,\s*ac-\d+)*))?/g;
  1212→              let match;
  1213→
  1214→              while ((match = acPattern.exec(content)) !== null) {
  1215→                const specRef = match[1];
  1216→                const acList = match[2];
  1217→
  1218→                if (acList) {
  1219→                  const acs = acList.split(',').map(ac => ac.trim());
  1220→                  for (const ac of acs) {
  1221→                    coveredACs.add(`${specRef} ${ac}`);
  1222→                  }
  1223→                } else {
  1224→                  coveredACs.add(specRef);
  1225→                }
  1226→              }
  1227→            }
  1228→          } catch (err) {
  1229→            // Tests directory doesn't exist or can't be read
  1230→          }
  1231→
  1232→          return coveredACs;
  1233→        };
  1234→
  1235→        // Gather review context
  1236→        const reviewContext: {
  1237→          task: typeof foundTask;
  1238→          spec: LoadedSpecItem | null;
  1239→          diff: string | null;
  1240→          started_at: string | null;
  1241→          testCoverage?: { covered: string[]; uncovered: string[] };
  1242→        } = {
  1243→          task: foundTask,
  1244→          spec: null,
  1245→          diff: null,
  1246→          started_at: foundTask.started_at || null,
  1247→        };
  1248→
  1249→        // Get spec item if task has spec_ref
  1250→        if (foundTask.spec_ref) {
  1251→          const specResult = index.resolve(foundTask.spec_ref);
  1252→          if (specResult.ok) {
  1253→            const specItem = items.find(i => i._ulid === specResult.ulid);
  1254→            reviewContext.spec = specItem || null;
  1255→
  1256→            // Check test coverage for ACs if spec has them
  1257→            if (specItem && specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
  1258→              const coveredACs = await scanTestCoverage(ctx.rootDir);
  1259→              const covered: string[] = [];
  1260→              const uncovered: string[] = [];
  1261→
  1262→              for (const ac of specItem.acceptance_criteria) {
  1263→                // Build possible references
  1264→                const possibleRefs: string[] = [];
  1265→                if (specItem.slugs && specItem.slugs.length > 0) {
  1266→                  possibleRefs.push(`@${specItem.slugs[0]} ${ac.id}`);
  1267→                  possibleRefs.push(`@${specItem.slugs[0]}`);
  1268→                }
  1269→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)} ${ac.id}`);
  1270→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)}`);
  1271→
  1272→                const isCovered = possibleRefs.some(ref => coveredACs.has(ref));
  1273→                if (isCovered) {
  1274→                  covered.push(ac.id);
  1275→                } else {
  1276→                  uncovered.push(ac.id);
  1277→                }
  1278→              }
  1279→
  1280→              reviewContext.testCoverage = { covered, uncovered };
  1281→            }
  1282→          }
  1283→        }
  1284→
  1285→        // Get git diff since task started
  1286→        if (foundTask.started_at) {
  1287→          const startedDate = new Date(foundTask.started_at);
  1288→          reviewContext.diff = getDiffSince(startedDate, ctx.rootDir);
  1289→        }
  1290→
  1291→        output(reviewContext, () => {
  1292→          console.log('='.repeat(60));
  1293→          console.log('Task Review Context');
  1294→          console.log('='.repeat(60));
  1295→          console.log();
  1296→
  1297→          // Task details
  1298→          console.log('TASK DETAILS');
  1299→          console.log('-'.repeat(60));
  1300→          console.log(formatTaskDetails(foundTask, index));
  1301→          console.log();
  1302→
  1303→          // Spec details
  1304→          if (reviewContext.spec) {
  1305→            console.log('LINKED SPEC');
  1306→            console.log('-'.repeat(60));
  1307→            console.log(`Title: ${reviewContext.spec.title}`);
  1308→            console.log(`Type: ${reviewContext.spec.type}`);
  1309→            if (reviewContext.spec.description) {
  1310→              console.log(`\nDescription:\n${reviewContext.spec.description}`);
  1311→            }
  1312→            if (reviewContext.spec.acceptance_criteria && reviewContext.spec.acceptance_criteria.length > 0) {
  1313→              console.log(`\nAcceptance Criteria (${reviewContext.spec.acceptance_criteria.length}):`);
  1314→              for (const ac of reviewContext.spec.acceptance_criteria) {
  1315→                const isCovered = reviewContext.testCoverage?.covered.includes(ac.id);
  1316→                const coverageMarker = isCovered ? chalk.green('✓') : chalk.yellow('○');
  1317→                console.log(`  ${coverageMarker} [${ac.id}]`);
  1318→                console.log(`    Given: ${ac.given}`);
  1319→                console.log(`    When: ${ac.when}`);
  1320→                console.log(`    Then: ${ac.then}`);
  1321→              }
  1322→
  1323→              // Test coverage summary
  1324→              if (reviewContext.testCoverage) {
  1325→                const { covered, uncovered } = reviewContext.testCoverage;
  1326→                console.log();
  1327→                if (uncovered.length === 0) {
  1328→                  console.log(chalk.green(`  ✓ All ${covered.length} AC(s) have test coverage`));
  1329→                } else {
  1330→                  console.log(chalk.yellow(`  Test coverage: ${covered.length}/${covered.length + uncovered.length} ACs covered`));
  1331→                  console.log(chalk.yellow(`  Missing coverage for: ${uncovered.join(', ')}`));
  1332→                }
  1333→              }
  1334→            }
  1335→            console.log();
  1336→          }
  1337→
  1338→          // Git diff
  1339→          if (reviewContext.diff) {
  1340→            console.log('CHANGES SINCE TASK STARTED');
  1341→            console.log('-'.repeat(60));
  1342→            console.log(`Started at: ${foundTask.started_at}`);
  1343→            console.log();
  1344→            console.log(reviewContext.diff);
  1345→            console.log();
  1346→          } else if (foundTask.started_at) {
  1347→            console.log('CHANGES SINCE TASK STARTED');
  1348→            console.log('-'.repeat(60));
  1349→            console.log(`Started at: ${foundTask.started_at}`);
  1350→            console.log('No changes detected');
  1351→            console.log();
  1352→          }
  1353→
  1354→          console.log('='.repeat(60));
  1355→          console.log('Review Checklist:');
  1356→          console.log('- Does the implementation match the task description?');
  1357→          if (reviewContext.spec) {
  1358→            console.log('- Are all acceptance criteria covered?');
  1359→            console.log('- Is test coverage adequate?');
  1360→          }
  1361→          console.log('- Are there any gaps or issues?');
  1362→          console.log('='.repeat(60));
  1363→        });
  1364→      } catch (err) {
  1365→        error('Failed to generate review context', err);
  1366→        process.exit(EXIT_CODES.ERROR);
  1367→      }
  1368→    });
  1369→
  1370→  // kspec task todos <ref>
  1371→  task
  1372→    .command('todos <ref>')
  1373→    .description('Show todos for a task')
  1374→    .action(async (ref: string) => {
  1375→      try {
  1376→        const ctx = await initContext();
  1377→        const tasks = await loadAllTasks(ctx);
  1378→        const items = await loadAllItems(ctx);
