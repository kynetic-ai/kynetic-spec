```
     1→import { Command } from 'commander';
     2→import { ulid } from 'ulid';
     3→import chalk from 'chalk';
     4→import * as path from 'node:path';
     5→import {
     6→  initContext,
     7→  loadAllTasks,
     8→  loadAllItems,
     9→  saveTask,
    10→  deleteTask,
    11→  createTask,
    12→  createNote,
    13→  createTodo,
    14→  syncSpecImplementationStatus,
    15→  ReferenceIndex,
    16→  checkSlugUniqueness,
    17→  type LoadedTask,
    18→  type LoadedSpecItem,
    19→} from '../../parser/index.js';
    20→import { commitIfShadow } from '../../parser/shadow.js';
    21→import {
    22→  output,
    23→  formatTaskDetails,
    24→  success,
    25→  error,
    26→  warn,
    27→  info,
    28→  isJsonMode,
    29→} from '../output.js';
    30→import { formatCommitGuidance, printCommitGuidance } from '../../utils/commit.js';
    31→import type { Task, TaskInput } from '../../schema/index.js';
    32→import { alignmentCheck, errors } from '../../strings/index.js';
    33→import { executeBatchOperation, formatBatchOutput } from '../batch.js';
    34→import { EXIT_CODES } from '../exit-codes.js';
    35→
    36→/**
    37→ * Find a task by reference with detailed error reporting.
    38→ * Returns the task or exits with appropriate error.
    39→ */
    40→function resolveTaskRef(
    41→  ref: string,
    42→  tasks: LoadedTask[],
    43→  index: ReferenceIndex
    44→): LoadedTask {
    45→  const result = index.resolve(ref);
    46→
    47→  if (!result.ok) {
    48→    switch (result.error) {
    49→      case 'not_found':
    50→        error(errors.reference.taskNotFound(ref));
    51→        break;
    52→      case 'ambiguous':
    53→        error(errors.reference.ambiguous(ref));
    54→        for (const candidate of result.candidates) {
    55→          const task = tasks.find(t => t._ulid === candidate);
    56→          const slug = task?.slugs[0] || '';
    57→          console.error(`  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ''}`);
    58→        }
    59→        break;
    60→      case 'duplicate_slug':
    61→        error(errors.reference.slugMapsToMultiple(ref));
    62→        for (const candidate of result.candidates) {
    63→          console.error(`  - ${index.shortUlid(candidate)}`);
    64→        }
    65→        break;
    66→    }
    67→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    68→    process.exit(EXIT_CODES.NOT_FOUND);
    69→  }
    70→
    71→  // Check if it's actually a task
    72→  const task = tasks.find(t => t._ulid === result.ulid);
    73→  if (!task) {
    74→    error(errors.reference.notTask(ref));
    75→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    76→    process.exit(EXIT_CODES.NOT_FOUND);
    77→  }
    78→
    79→  return task;
    80→}
    81→
    82→/**
    83→ * Batch-compatible resolver that returns null instead of calling process.exit().
    84→ * Used by executeBatchOperation to handle errors without terminating the process.
    85→ * AC: @multi-ref-batch ac-4, ac-8 - Partial failure handling and ref resolution
    86→ */
    87→function resolveTaskRefForBatch(
    88→  ref: string,
    89→  tasks: LoadedTask[],
    90→  index: ReferenceIndex
    91→): { task: LoadedTask | null; error?: string } {
    92→  const result = index.resolve(ref);
    93→
    94→  if (!result.ok) {
    95→    let errorMsg: string;
    96→    switch (result.error) {
    97→      case 'not_found':
    98→        errorMsg = `Reference "${ref}" not found`;
    99→        break;
   100→      case 'ambiguous':
   101→        errorMsg = `Reference "${ref}" is ambiguous (matches ${result.candidates.length} items)`;
   102→        break;
   103→      case 'duplicate_slug':
   104→        errorMsg = `Slug "${ref}" maps to multiple items`;
   105→        break;
   106→    }
   107→    return { task: null, error: errorMsg };
   108→  }
   109→
   110→  // Check if it's actually a task
   111→  const task = tasks.find(t => t._ulid === result.ulid);
   112→  if (!task) {
   113→    return { task: null, error: `Reference "${ref}" is not a task` };
   114→  }
   115→
   116→  return { task };
   117→}
   118→
   119→/**
   120→ * Register the 'task' command group (singular - operations on individual tasks)
   121→ */
   122→export function registerTaskCommands(program: Command): void {
   123→  const task = program
   124→    .command('task')
   125→    .description('Operations on individual tasks');
   126→
   127→  // kspec task get <ref>
   128→  task
   129→    .command('get <ref>')
   130→    .description('Get task details')
   131→    .action(async (ref: string) => {
   132→      try {
   133→        const ctx = await initContext();
   134→        const tasks = await loadAllTasks(ctx);
   135→        const items = await loadAllItems(ctx);
   136→
   137→        // Build all indexes including TraitIndex
   138→        const { refIndex: index, traitIndex } = await (async () => {
   139→          const { buildIndexes } = await import('../../parser/index.js');
   140→          return buildIndexes(ctx);
   141→        })();
   142→
   143→        const foundTask = resolveTaskRef(ref, tasks, index);
   144→
   145→        // AC: @trait-display ac-3 - task get shows inherited AC sections
   146→        // Get inherited traits if task has spec_ref
   147→        let inheritedTraits: Array<{ trait: { ulid: string; slug: string; title: string; description?: string }; acs: Array<{ id: string; given?: string; when?: string; then?: string }> }> = [];
   148→        if (foundTask.spec_ref) {
   149→          const specResult = index.resolve(foundTask.spec_ref);
   150→          if (specResult.ok) {
   151→            const specUlid = specResult.ulid;
   152→            const inheritedAC = traitIndex.getInheritedAC(specUlid);
   153→            const traitsByTrait = new Map<string, { trait: typeof inheritedAC[0]['trait']; acs: Array<{ id: string; given?: string; when?: string; then?: string }> }>();
   154→            for (const { trait, ac } of inheritedAC) {
   155→              if (!traitsByTrait.has(trait.ulid)) {
   156→                traitsByTrait.set(trait.ulid, { trait, acs: [] });
   157→              }
   158→              traitsByTrait.get(trait.ulid)!.acs.push(ac);
   159→            }
   160→            inheritedTraits = Array.from(traitsByTrait.values());
   161→          }
   162→        }
   163→
   164→        // Build JSON output with inherited traits (AC: @trait-display ac-2)
   165→        const jsonOutput = {
   166→          ...foundTask,
   167→          ...(inheritedTraits.length > 0 && {
   168→            inherited_traits: inheritedTraits.map(({ trait, acs }) => ({
   169→              ref: `@${trait.slug}`,
   170→              title: trait.title,
   171→              acceptance_criteria: acs,
   172→            })),
   173→          }),
   174→        };
   175→
   176→        output(jsonOutput, () => {
   177→          formatTaskDetails(foundTask, index);
   178→
   179→          // AC: @trait-display ac-3, ac-4, ac-5 - Show inherited AC per trait in labeled sections
   180→          if (inheritedTraits.length > 0) {
   181→            for (const { trait, acs } of inheritedTraits) {
   182→              console.log(chalk.gray(`\n─── Inherited from @${trait.slug} ───`));
   183→              for (const ac of acs) {
   184→                console.log(chalk.cyan(`  [${ac.id}]`) + chalk.gray(` (from @${trait.slug})`));
   185→                if (ac.given) console.log(`    Given: ${ac.given}`);
   186→                if (ac.when) console.log(`    When: ${ac.when}`);
   187→                if (ac.then) console.log(`    Then: ${ac.then}`);
   188→              }
   189→            }
   190→          }
   191→        });
   192→      } catch (err) {
   193→        error(errors.failures.getTask, err);
   194→        process.exit(EXIT_CODES.ERROR);
   195→      }
   196→    });
   197→
   198→  // kspec task add
   199→  task
   200→    .command('add')
   201→    .description('Create a new task')
   202→    .requiredOption('--title <title>', 'Task title')
   203→    .option('--type <type>', 'Task type (task, epic, bug, spike, infra)', 'task')
   204→    .option('--spec-ref <ref>', 'Reference to spec item')
   205→    .option('--meta-ref <ref>', 'Reference to meta item (workflow, agent, or convention)')
   206→    .option('--priority <n>', 'Priority (1-5)', '3')
   207→    .option('--slug <slug>', 'Human-friendly slug')
   208→    .option('--tag <tag...>', 'Tags')
   209→    .option('--automation <status>', 'Automation eligibility (eligible, needs_review, manual_only)')
   210→    .action(async (options) => {
   211→      try {
   212→        const ctx = await initContext();
   213→        const tasks = await loadAllTasks(ctx);
   214→        const items = await loadAllItems(ctx);
   215→
   216→        // Load meta items for validation
   217→        const { loadMetaContext } = await import('../../parser/meta.js');
   218→        const metaContext = await loadMetaContext(ctx);
   219→        const allMetaItems = [
   220→          ...metaContext.agents,
   221→          ...metaContext.workflows,
   222→          ...metaContext.conventions,
   223→          ...metaContext.observations,
   224→        ];
   225→
   226→        // Build index for reference validation
   227→        const refIndex = new ReferenceIndex(tasks, items, allMetaItems);
   228→
   229→        // Check slug uniqueness if provided
   230→        if (options.slug) {
   231→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   232→          if (!slugCheck.ok) {
   233→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   234→            process.exit(EXIT_CODES.CONFLICT);
   235→          }
   236→        }
   237→
   238→        // Validate meta_ref if provided (AC-meta-ref-3, AC-meta-ref-4)
   239→        if (options.metaRef) {
   240→          const metaRefResult = refIndex.resolve(options.metaRef);
   241→
   242→          if (!metaRefResult.ok) {
   243→            error(errors.reference.metaRefNotFound(options.metaRef));
   244→            process.exit(EXIT_CODES.NOT_FOUND);
   245→          }
   246→
   247→          // Check if the resolved item is a meta item (not a spec item or task)
   248→          const isTask = tasks.some(t => t._ulid === metaRefResult.ulid);
   249→          const isSpecItem = items.some(i => i._ulid === metaRefResult.ulid);
   250→
   251→          if (isTask || isSpecItem) {
   252→            error(errors.reference.metaRefPointsToSpec(options.metaRef));
   253→            process.exit(EXIT_CODES.NOT_FOUND);
   254→          }
   255→        }
   256→
   257→        // AC: @task-automation-eligibility ac-13 - validate automation if provided
   258→        let automationValue: 'eligible' | 'needs_review' | 'manual_only' | undefined;
   259→        if (options.automation) {
   260→          const validStatuses = ['eligible', 'needs_review', 'manual_only'];
   261→          if (!validStatuses.includes(options.automation)) {
   262→            error(`Invalid automation status: ${options.automation}. Must be one of: ${validStatuses.join(', ')}`);
   263→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   264→          }
   265→          automationValue = options.automation as 'eligible' | 'needs_review' | 'manual_only';
   266→        }
   267→
   268→        const input: TaskInput = {
   269→          title: options.title,
   270→          type: options.type,
   271→          spec_ref: options.specRef || null,
   272→          meta_ref: options.metaRef || null,
   273→          priority: parseInt(options.priority, 10),
   274→          slugs: options.slug ? [options.slug] : [],
   275→          tags: options.tag || [],
   276→          automation: automationValue,
   277→        };
   278→
   279→        const newTask = createTask(input);
   280→        await saveTask(ctx, newTask);
   281→        await commitIfShadow(ctx.shadow, 'task-add', newTask.slugs[0] || newTask._ulid.slice(0, 8), newTask.title);
   282→
   283→        // Build index including the new task for accurate short ULID
   284→        const index = new ReferenceIndex([...tasks, newTask], items, allMetaItems);
   285→        success(`Created task: ${index.shortUlid(newTask._ulid)}`, { task: newTask });
   286→      } catch (err) {
   287→        error(errors.failures.createTask, err);
   288→        process.exit(EXIT_CODES.ERROR);
   289→      }
   290→    });
   291→
   292→  // kspec task set <ref>
   293→  // TODO: Add batch support with --refs flag (see @multi-ref-batch)
   294→  task
   295→    .command('set <ref>')
   296→    .description('Update task fields')
   297→    .option('--title <title>', 'Update task title')
   298→    .option('--spec-ref <ref>', 'Link to spec item')
   299→    .option('--meta-ref <ref>', 'Link to meta item (workflow, agent, or convention)')
   300→    .option('--priority <n>', 'Set priority (1-5)')
   301→    .option('--slug <slug>', 'Add a slug alias')
   302→    .option('--tag <tag...>', 'Add tags')
   303→    .option('--depends-on <refs...>', 'Set dependencies (replaces existing)')
   304→    .option('--automation <status>', 'Set automation eligibility (eligible, needs_review, manual_only)')
   305→    .option('--no-automation', 'Clear automation status (return to unassessed)')
   306→    .option('--reason <reason>', 'Reason for status change (required when setting needs_review)')
   307→    .action(async (ref: string, options) => {
   308→      try {
   309→        const ctx = await initContext();
   310→        const tasks = await loadAllTasks(ctx);
   311→        const items = await loadAllItems(ctx);
   312→
   313→        // Load meta items for validation
   314→        const { loadMetaContext } = await import('../../parser/meta.js');
   315→        const metaContext = await loadMetaContext(ctx);
   316→        const allMetaItems = [
   317→          ...metaContext.agents,
   318→          ...metaContext.workflows,
   319→          ...metaContext.conventions,
   320→          ...metaContext.observations,
   321→        ];
   322→
   323→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   324→        const foundTask = resolveTaskRef(ref, tasks, index);
   325→
   326→        // Check slug uniqueness if adding a new slug
   327→        if (options.slug) {
   328→          const slugCheck = checkSlugUniqueness(index, [options.slug], foundTask._ulid);
   329→          if (!slugCheck.ok) {
   330→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   331→            process.exit(EXIT_CODES.CONFLICT);
   332→          }
   333→        }
   334→
   335→        // Build updated task with only provided options
   336→        const updatedTask: Task = { ...foundTask };
   337→        const changes: string[] = [];
   338→
   339→        if (options.title) {
   340→          updatedTask.title = options.title;
   341→          changes.push('title');
   342→        }
   343→
   344→        if (options.specRef) {
   345→          // Validate the spec ref exists and is a spec item
   346→          const specResult = index.resolve(options.specRef);
   347→          if (!specResult.ok) {
   348→            error(errors.reference.specRefNotFound(options.specRef));
   349→            process.exit(EXIT_CODES.NOT_FOUND);
   350→          }
   351→          // Check it's not a task
   352→          const isTask = tasks.some(t => t._ulid === specResult.ulid);
   353→          if (isTask) {
   354→            error(errors.reference.specRefIsTask(options.specRef));
   355→            process.exit(EXIT_CODES.NOT_FOUND);
   356→          }
   357→          updatedTask.spec_ref = options.specRef;
   358→          changes.push('spec_ref');
   359→        }
   360→
   361→        if (options.metaRef) {
   362→          // Validate the meta ref exists and is a meta item
   363→          const metaRefResult = index.resolve(options.metaRef);
   364→          if (!metaRefResult.ok) {
   365→            error(errors.reference.metaRefNotFound(options.metaRef));
   366→            process.exit(EXIT_CODES.NOT_FOUND);
   367→          }
   368→
   369→          // Check if the resolved item is a meta item (not a spec item or task)
   370→          const isTask = tasks.some(t => t._ulid === metaRefResult.ulid);
   371→          const isSpecItem = items.some(i => i._ulid === metaRefResult.ulid);
   372→
   373→          if (isTask || isSpecItem) {
   374→            error(errors.reference.metaRefPointsToSpec(options.metaRef));
   375→            process.exit(EXIT_CODES.NOT_FOUND);
   376→          }
   377→
   378→          updatedTask.meta_ref = options.metaRef;
   379→          changes.push('meta_ref');
   380→        }
   381→
   382→        if (options.priority) {
   383→          const priority = parseInt(options.priority, 10);
   384→          if (isNaN(priority) || priority < 1 || priority > 5) {
   385→            error(errors.validation.priorityOutOfRange);
   386→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   387→          }
   388→          updatedTask.priority = priority;
   389→          changes.push('priority');
   390→        }
   391→
   392→        if (options.slug) {
   393→          if (!updatedTask.slugs.includes(options.slug)) {
   394→            updatedTask.slugs = [...updatedTask.slugs, options.slug];
   395→            changes.push('slug');
   396→          }
   397→        }
   398→
   399→        if (options.tag) {
   400→          const newTags = options.tag.filter((t: string) => !updatedTask.tags.includes(t));
   401→          if (newTags.length > 0) {
   402→            updatedTask.tags = [...updatedTask.tags, ...newTags];
   403→            changes.push('tags');
   404→          }
   405→        }
   406→
   407→        if (options.dependsOn) {
   408→          // Validate all dependency refs
   409→          for (const depRef of options.dependsOn) {
   410→            const depResult = index.resolve(depRef);
   411→            if (!depResult.ok) {
   412→              error(errors.reference.depNotFound(depRef));
   413→              process.exit(EXIT_CODES.NOT_FOUND);
   414→            }
   415→          }
   416→          updatedTask.depends_on = options.dependsOn;
   417→          changes.push('depends_on');
   418→        }
   419→
   420→        // AC: @task-automation-eligibility ac-5, ac-11, ac-12, ac-18
   421→        // Handle automation status changes
   422→        // Note: --no-automation sets options.automation to false, so check that first
   423→        if (options.automation === false) {
   424→          // --no-automation flag clears the automation status (AC: ac-12)
   425→          delete updatedTask.automation;
   426→          changes.push('automation');
   427→        } else if (options.automation !== undefined) {
   428→          const validStatuses = ['eligible', 'needs_review', 'manual_only'];
   429→          if (!validStatuses.includes(options.automation)) {
   430→            error(`Invalid automation status: ${options.automation}. Must be one of: ${validStatuses.join(', ')}`);
   431→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   432→          }
   433→
   434→          // AC: @task-automation-eligibility ac-18 - require reason for needs_review
   435→          if (options.automation === 'needs_review' && !options.reason) {
   436→            error('Setting automation to needs_review requires --reason flag explaining why');
   437→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   438→          }
   439→
   440→          updatedTask.automation = options.automation as 'eligible' | 'needs_review' | 'manual_only';
   441→          changes.push('automation');
   442→
   443→          // If reason provided, add a note documenting the change
   444→          if (options.reason) {
   445→            const note = createNote(
   446→              `Automation status set to ${options.automation}: ${options.reason}`,
   447→              '@human'
   448→            );
   449→            updatedTask.notes = [...updatedTask.notes, note];
   450→            changes.push('note');
   451→          }
   452→        }
   453→
   454→        if (changes.length === 0) {
   455→          warn('No changes specified');
   456→          return;
   457→        }
   458→
   459→        await saveTask(ctx, updatedTask);
   460→        await commitIfShadow(ctx.shadow, 'task-set', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), changes.join(', '));
   461→        success(`Updated task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(', ')})`, { task: updatedTask });
   462→      } catch (err) {
   463→        error(errors.failures.updateTask, err);
   464→        process.exit(EXIT_CODES.ERROR);
   465→      }
   466→    });
   467→
   468→  // kspec task patch <ref>
   469→  task
   470→    .command('patch <ref>')
   471→    .description('Update task with JSON data')
   472→    .option('--data <json>', 'JSON object with fields to update')
   473→    .option('--dry-run', 'Show what would change without writing')
   474→    .option('--allow-unknown', 'Allow unknown fields (for extending format)')
   475→    .action(async (ref: string, options) => {
   476→      try {
   477→        const ctx = await initContext();
   478→        const tasks = await loadAllTasks(ctx);
   479→        const items = await loadAllItems(ctx);
   480→
   481→        // Load meta items for validation
   482→        const { loadMetaContext } = await import('../../parser/meta.js');
   483→        const metaContext = await loadMetaContext(ctx);
   484→        const allMetaItems = [
   485→          ...metaContext.agents,
   486→          ...metaContext.workflows,
   487→          ...metaContext.conventions,
   488→          ...metaContext.observations,
   489→        ];
   490→
   491→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   492→        const foundTask = resolveTaskRef(ref, tasks, index);
   493→
   494→        // Get JSON data from --data flag or stdin
   495→        let jsonData: string;
   496→        if (options.data) {
   497→          jsonData = options.data;
   498→        } else {
   499→          // Read from stdin
   500→          const chunks: Buffer[] = [];
   501→          for await (const chunk of process.stdin) {
   502→            chunks.push(chunk);
   503→          }
   504→          jsonData = Buffer.concat(chunks).toString('utf-8');
   505→        }
   506→
   507→        // Parse JSON
   508→        let patchData: Record<string, unknown>;
   509→        try {
   510→          patchData = JSON.parse(jsonData);
   511→        } catch (parseErr) {
   512→          error(errors.validation.invalidJson, parseErr);
   513→          process.exit(EXIT_CODES.ERROR);
   514→        }
   515→
   516→        // Validate against TaskInputSchema (partial)
   517→        const { TaskInputSchema } = await import('../../schema/index.js');
   518→
   519→        // Create a partial schema for validation
   520→        const partialSchema = options.allowUnknown
   521→          ? TaskInputSchema.partial().passthrough()
   522→          : TaskInputSchema.partial().strict();
   523→
   524→        let validatedPatch: Partial<TaskInput>;
   525→        try {
   526→          validatedPatch = partialSchema.parse(patchData);
   527→        } catch (validationErr) {
   528→          error(errors.validation.invalidPatchData(String(validationErr)), validationErr);
   529→          process.exit(EXIT_CODES.ERROR);
   530→        }
   531→
   532→        // Check for unknown fields if strict mode
   533→        if (!options.allowUnknown) {
   534→          const knownFields = Object.keys(TaskInputSchema.shape);
   535→          const providedFields = Object.keys(patchData);
   536→          const unknownFields = providedFields.filter(f => !knownFields.includes(f));
   537→
   538→          if (unknownFields.length > 0) {
   539→            error(errors.validation.unknownFields(unknownFields));
   540→            process.exit(EXIT_CODES.ERROR);
   541→          }
   542→        }
   543→
   544→        // Build updated task
   545→        const updatedTask: Task = { ...foundTask, ...validatedPatch };
   546→
   547→        // Track changes for output
   548→        const changes = Object.keys(validatedPatch);
   549→
   550→        if (options.dryRun) {
   551→          info('Dry run - no changes will be written');
   552→          info(`Would update: ${changes.join(', ')}`);
   553→          output({ changes, updated: updatedTask }, () => {
   554→            console.log(`\nChanges: ${changes.join(', ')}\n`);
   555→            return formatTaskDetails(updatedTask, index);
   556→          });
   557→          return;
   558→        }
   559→
   560→        await saveTask(ctx, updatedTask);
   561→        await commitIfShadow(ctx.shadow, 'task-patch', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), changes.join(', '));
   562→        success(`Patched task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(', ')})`, { task: updatedTask });
   563→      } catch (err) {
   564→        error(errors.failures.patchTask, err);
   565→        process.exit(EXIT_CODES.ERROR);
   566→      }
   567→    });
   568→
   569→  // kspec task start <ref>
   570→  task
   571→    .command('start <ref>')
   572→    .description('Start working on a task (pending -> in_progress)')
   573→    .option('--no-sync', 'Skip syncing spec implementation status')
   574→    .action(async (ref: string, options) => {
   575→      try {
   576→        const ctx = await initContext();
   577→        const tasks = await loadAllTasks(ctx);
   578→        const items = await loadAllItems(ctx);
   579→        const index = new ReferenceIndex(tasks, items);
   580→        const foundTask = resolveTaskRef(ref, tasks, index);
   581→
   582→        if (foundTask.status === 'in_progress') {
   583→          warn('Task is already in progress');
   584→          output(foundTask, () => formatTaskDetails(foundTask));
   585→          return;
   586→        }
   587→
   588→        if (foundTask.status !== 'pending') {
   589→          error(errors.status.cannotStart(foundTask.status));
   590→          process.exit(EXIT_CODES.VALIDATION_FAILED); // Exit code 4 = invalid state
   591→        }
   592→
   593→        // Update status
   594→        const updatedTask: Task = {
   595→          ...foundTask,
   596→          status: 'in_progress',
   597→          started_at: new Date().toISOString(),
   598→        };
   599→
   600→        await saveTask(ctx, updatedTask);
   601→        await commitIfShadow(ctx.shadow, 'task-start', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   602→        success(`Started task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   603→
   604→        // Show spec context and AC guidance (suppressed in JSON mode)
   605→        if (!isJsonMode() && foundTask.spec_ref) {
   606→          const specResult = index.resolve(foundTask.spec_ref);
   607→          if (specResult.ok) {
   608→            const specItem = items.find(i => i._ulid === specResult.ulid);
   609→            if (specItem) {
   610→              console.log('');
   611→              console.log('--- Spec Context ---');
   612→              console.log(`Implementing: ${specItem.title}`);
   613→              if (specItem.description) {
   614→                console.log(`\n${specItem.description}`);
   615→              }
   616→
   617→              if (specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
   618→                console.log(`\nAcceptance Criteria (${specItem.acceptance_criteria.length}):`);
   619→                for (const ac of specItem.acceptance_criteria) {
   620→                  console.log(`  [${ac.id}]`);
   621→                  console.log(`    Given: ${ac.given}`);
   622→                  console.log(`    When: ${ac.when}`);
   623→                  console.log(`    Then: ${ac.then}`);
   624→                }
   625→                console.log('');
   626→                console.log('Remember: Add test coverage for each AC and mark tests with // AC: @spec-ref ac-N');
   627→              }
   628→              console.log('');
   629→            }
   630→          }
   631→        }
   632→
   633→        // Sync spec implementation status (unless --no-sync)
   634→        if (options.sync !== false && foundTask.spec_ref) {
   635→          const updatedTasks = tasks.map(t =>
   636→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t
   637→          );
   638→          const syncResult = await syncSpecImplementationStatus(
   639→            ctx,
   640→            updatedTask as LoadedTask,
   641→            updatedTasks as LoadedTask[],
   642→            items,
   643→            index
   644→          );
   645→          if (syncResult) {
   646→            info(`Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   647→            // Commit the spec status change
   648→            await commitIfShadow(ctx.shadow, 'spec-sync', syncResult.specUlid.slice(0, 8), `${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   649→          }
   650→        }
   651→      } catch (err) {
   652→        error(errors.failures.startTask, err);
   653→        process.exit(EXIT_CODES.ERROR);
   654→      }
   655→    });
   656→
   657→  // kspec task complete <ref> | --refs <refs...>
   658→  // AC: @multi-ref-batch ac-1 - Basic multi-ref syntax
   659→  // AC: @multi-ref-batch ac-2 - Backward compatibility
   660→  task
   661→    .command('complete [ref]')
   662→    .description('Complete a task (in_progress -> completed)')
   663→    .option('--refs <refs...>', 'Complete multiple tasks by ref')
   664→    .option('--reason <reason>', 'Completion reason/notes')
   665→    .option('--no-sync', 'Skip syncing spec implementation status')
   666→    .action(async (ref: string | undefined, options) => {
   667→      try {
   668→        const ctx = await initContext();
   669→        const tasks = await loadAllTasks(ctx);
   670→        const items = await loadAllItems(ctx);
   671→        const index = new ReferenceIndex(tasks, items);
   672→
   673→        // AC: @multi-ref-batch ac-1, ac-2, ac-3, ac-4
   674→        const result = await executeBatchOperation({
   675→          positionalRef: ref,
   676→          refsFlag: options.refs,
   677→          context: { ctx, tasks, items, index, options },
   678→          items: tasks,
   679→          index,
   680→          resolveRef: (refStr, taskList, idx) => {
   681→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
   682→            return { item: resolved.task, error: resolved.error };
   683→          },
   684→          executeOperation: async (foundTask, { ctx, tasks, items, index, options }) => {
   685→            try {
   686→              if (foundTask.status === 'completed') {
   687→                return {
   688→                  success: false,
   689→                  error: 'Task is already completed',
   690→                };
   691→              }
   692→
   693→              if (foundTask.status !== 'in_progress' && foundTask.status !== 'pending' && foundTask.status !== 'pending_review') {
   694→                return {
   695→                  success: false,
   696→                  error: errors.status.cannotComplete(foundTask.status),
   697→                };
   698→              }
   699→
   700→              const now = new Date().toISOString();
   701→
   702→              // Update status
   703→              const updatedTask: Task = {
   704→                ...foundTask,
   705→                status: 'completed',
   706→                completed_at: now,
   707→                closed_reason: options.reason || null,
   708→                started_at: foundTask.started_at || now,
   709→              };
   710→
   711→              await saveTask(ctx, updatedTask);
   712→              await commitIfShadow(ctx.shadow, 'task-complete', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), options.reason);
   713→
   714→              // Sync spec implementation status (unless --no-sync)
   715→              if (options.sync !== false && foundTask.spec_ref) {
   716→                const updatedTasks = tasks.map(t =>
   717→                  t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t
   718→                );
   719→                const syncResult = await syncSpecImplementationStatus(
   720→                  ctx,
   721→                  updatedTask as LoadedTask,
   722→                  updatedTasks as LoadedTask[],
   723→                  items,
   724→                  index
   725→                );
   726→                if (syncResult && !isJsonMode()) {
   727→                  info(`Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   728→                  await commitIfShadow(ctx.shadow, 'spec-sync', syncResult.specUlid.slice(0, 8), `${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   729→                }
   730→              }
   731→
   732→              // Show AC reminder for single-ref mode only (not in batch)
   733→              if (!options.refs && foundTask.spec_ref && !isJsonMode()) {
   734→                const specResult = index.resolve(foundTask.spec_ref);
   735→                if (specResult.ok && specResult.item) {
   736→                  const specItem = items.find(i => i._ulid === specResult.ulid);
   737→                  if (specItem && specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
   738→                    const count = specItem.acceptance_criteria.length;
   739→                    console.log(`\n⚠ Linked spec ${foundTask.spec_ref} has ${count} acceptance criteri${count === 1 ? 'on' : 'a'} - verify they are covered\n`);
   740→                  }
   741→                }
   742→              }
   743→
   744→              return {
   745→                success: true,
   746→                message: `Completed task: ${index.shortUlid(updatedTask._ulid)}`,
   747→                data: updatedTask,
   748→              };
   749→            } catch (err) {
   750→              return {
   751→                success: false,
   752→                error: err instanceof Error ? err.message : String(err),
   753→              };
   754→            }
   755→          },
   756→          getUlid: (task) => task._ulid,
   757→        });
   758→
   759→        // AC: @multi-ref-batch ac-5, ac-6
   760→        formatBatchOutput(result, 'Complete');
   761→
   762→        // Show commit guidance for single-ref mode only
   763→        if (!options.refs && result.success && result.results.length === 1 && !isJsonMode()) {
   764→          const taskData = result.results[0].data as Task | undefined;
   765→          if (taskData) {
   766→            const guidance = formatCommitGuidance(taskData);
   767→            printCommitGuidance(guidance);
   768→          }
   769→        }
   770→      } catch (err) {
   771→        error(errors.failures.completeTask, err);
   772→        process.exit(EXIT_CODES.ERROR);
   773→      }
   774→    });
   775→
   776→  // kspec task submit <ref>
   777→  // Transitions in_progress → pending_review (code done, awaiting merge)
   778→  task
   779→    .command('submit <ref>')
   780→    .description('Submit task for review (transitions to pending_review)')
   781→    .action(async (ref: string) => {
   782→      try {
   783→        const ctx = await initContext();
