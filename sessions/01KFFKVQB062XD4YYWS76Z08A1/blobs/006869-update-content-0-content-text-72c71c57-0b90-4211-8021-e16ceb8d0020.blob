  1398→
  1399→  // Create subcommand group for todo operations
  1400→  const todoCmd = task
  1401→    .command('todo')
  1402→    .description('Manage task todos');
  1403→
  1404→  // kspec task todo add <ref> <text>
  1405→  todoCmd
  1406→    .command('add <ref> <text>')
  1407→    .description('Add a todo to a task')
  1408→    .option('--author <author>', 'Todo author')
  1409→    .action(async (ref: string, text: string, options) => {
  1410→      try {
  1411→        const ctx = await initContext();
  1412→        const tasks = await loadAllTasks(ctx);
  1413→        const items = await loadAllItems(ctx);
  1414→        const index = new ReferenceIndex(tasks, items);
  1415→        const foundTask = resolveTaskRef(ref, tasks, index);
  1416→
  1417→        // Calculate next ID (max existing + 1, or 1 if none)
  1418→        const nextId = foundTask.todos.length > 0
  1419→          ? Math.max(...foundTask.todos.map(t => t.id)) + 1
  1420→          : 1;
  1421→
  1422→        const todo = createTodo(nextId, text, options.author);
  1423→
  1424→        const updatedTask: Task = {
  1425→          ...foundTask,
  1426→          todos: [...foundTask.todos, todo],
  1427→        };
  1428→
  1429→        await saveTask(ctx, updatedTask);
  1430→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
  1431→        success(`Added todo #${todo.id} to task: ${index.shortUlid(updatedTask._ulid)}`, { todo });
  1432→      } catch (err) {
  1433→        error(errors.failures.addTodo, err);
  1434→        process.exit(EXIT_CODES.ERROR);
  1435→      }
  1436→    });
  1437→
  1438→  // kspec task todo done <ref> <id>
  1439→  todoCmd
  1440→    .command('done <ref> <id>')
  1441→    .description('Mark a todo as done')
  1442→    .action(async (ref: string, idStr: string) => {
  1443→      try {
  1444→        const ctx = await initContext();
  1445→        const tasks = await loadAllTasks(ctx);
  1446→        const items = await loadAllItems(ctx);
  1447→        const index = new ReferenceIndex(tasks, items);
  1448→        const foundTask = resolveTaskRef(ref, tasks, index);
  1449→
  1450→        const id = parseInt(idStr, 10);
  1451→        if (isNaN(id)) {
  1452→          error(errors.todo.invalidId(idStr));
  1453→          process.exit(EXIT_CODES.USAGE_ERROR);
  1454→        }
  1455→
  1456→        const todoIndex = foundTask.todos.findIndex(t => t.id === id);
  1457→        if (todoIndex === -1) {
  1458→          error(errors.todo.notFound(id));
  1459→          process.exit(EXIT_CODES.NOT_FOUND);
  1460→        }
  1461→
  1462→        if (foundTask.todos[todoIndex].done) {
  1463→          warn(`Todo #${id} is already done`);
  1464→          return;
  1465→        }
  1466→
  1467→        const updatedTodos = [...foundTask.todos];
  1468→        updatedTodos[todoIndex] = {
  1469→          ...updatedTodos[todoIndex],
  1470→          done: true,
  1471→          done_at: new Date().toISOString(),
  1472→        };
  1473→
  1474→        const updatedTask: Task = {
  1475→          ...foundTask,
  1476→          todos: updatedTodos,
  1477→        };
  1478→
  1479→        await saveTask(ctx, updatedTask);
  1480→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
  1481→        success(`Marked todo #${id} as done`, { todo: updatedTodos[todoIndex] });
  1482→      } catch (err) {
  1483→        error(errors.failures.markTodoDone, err);
  1484→        process.exit(EXIT_CODES.ERROR);
  1485→      }
  1486→    });
  1487→
  1488→  // kspec task todo undone <ref> <id>
  1489→  todoCmd
  1490→    .command('undone <ref> <id>')
  1491→    .description('Mark a todo as not done')
  1492→    .action(async (ref: string, idStr: string) => {
  1493→      try {
  1494→        const ctx = await initContext();
  1495→        const tasks = await loadAllTasks(ctx);
  1496→        const items = await loadAllItems(ctx);
  1497→        const index = new ReferenceIndex(tasks, items);
  1498→        const foundTask = resolveTaskRef(ref, tasks, index);
  1499→
  1500→        const id = parseInt(idStr, 10);
  1501→        if (isNaN(id)) {
  1502→          error(errors.todo.invalidId(idStr));
  1503→          process.exit(EXIT_CODES.USAGE_ERROR);
  1504→        }
  1505→
  1506→        const todoIndex = foundTask.todos.findIndex(t => t.id === id);
  1507→        if (todoIndex === -1) {
  1508→          error(errors.todo.notFound(id));
  1509→          process.exit(EXIT_CODES.NOT_FOUND);
  1510→        }
  1511→
  1512→        if (!foundTask.todos[todoIndex].done) {
  1513→          warn(`Todo #${id} is not done`);
  1514→          return;
  1515→        }
  1516→
  1517→        const updatedTodos = [...foundTask.todos];
  1518→        updatedTodos[todoIndex] = {
  1519→          ...updatedTodos[todoIndex],
  1520→          done: false,
  1521→          done_at: undefined,
  1522→        };
  1523→
  1524→        const updatedTask: Task = {
  1525→          ...foundTask,
  1526→          todos: updatedTodos,
  1527→        };
  1528→
  1529→        await saveTask(ctx, updatedTask);
  1530→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
  1531→        success(`Marked todo #${id} as not done`, { todo: updatedTodos[todoIndex] });
  1532→      } catch (err) {
  1533→        error(errors.failures.markTodoNotDone, err);
  1534→        process.exit(EXIT_CODES.ERROR);
  1535→      }
  1536→    });
  1537→}
