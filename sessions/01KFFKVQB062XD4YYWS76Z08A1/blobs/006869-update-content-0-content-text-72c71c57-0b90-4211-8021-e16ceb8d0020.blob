   873→  // kspec task cancel <ref> | --refs <refs...>
   874→  // AC: @multi-ref-batch ac-1, ac-2
   875→  task
   876→    .command('cancel [ref]')
   877→    .description('Cancel a task')
   878→    .option('--refs <refs...>', 'Cancel multiple tasks by ref')
   879→    .option('--reason <reason>', 'Cancellation reason')
   880→    .action(async (ref: string | undefined, options) => {
   881→      try {
   882→        const ctx = await initContext();
   883→        const tasks = await loadAllTasks(ctx);
   884→        const items = await loadAllItems(ctx);
   885→        const index = new ReferenceIndex(tasks, items);
   886→
   887→        const result = await executeBatchOperation({
   888→          positionalRef: ref,
   889→          refsFlag: options.refs,
   890→          context: { ctx, tasks, items, index, options },
   891→          items: tasks,
   892→          index,
   893→          resolveRef: (refStr, taskList, idx) => {
   894→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
   895→            return { item: resolved.task, error: resolved.error };
   896→          },
   897→          executeOperation: async (foundTask, { ctx, index, options }) => {
   898→            try {
   899→              if (foundTask.status === 'completed' || foundTask.status === 'cancelled') {
   900→                return {
   901→                  success: false,
   902→                  error: `Task is already ${foundTask.status}`,
   903→                };
   904→              }
   905→
   906→              const updatedTask: Task = {
   907→                ...foundTask,
   908→                status: 'cancelled',
   909→                closed_reason: options.reason || null,
   910→              };
   911→
   912→              await saveTask(ctx, updatedTask);
   913→              await commitIfShadow(ctx.shadow, 'task-cancel', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   914→
   915→              return {
   916→                success: true,
   917→                message: `Cancelled task: ${index.shortUlid(updatedTask._ulid)}`,
   918→                data: updatedTask,
   919→              };
   920→            } catch (err) {
   921→              return {
   922→                success: false,
   923→                error: err instanceof Error ? err.message : String(err),
   924→              };
   925→            }
   926→          },
   927→          getUlid: (task) => task._ulid,
   928→        });
   929→
   930→        formatBatchOutput(result, 'Cancel');
   931→      } catch (err) {
   932→        error(errors.failures.cancelTask, err);
   933→        process.exit(EXIT_CODES.ERROR);
   934→      }
   935→    });
   936→
   937→  // kspec task reset <ref>
   938→  // AC: @spec-task-reset ac-1, ac-2, ac-3, ac-4, ac-5, ac-6
   939→  task
   940→    .command('reset <ref>')
   941→    .description('Reset a task to pending state')
   942→    .action(async (ref: string) => {
   943→      try {
   944→        const ctx = await initContext();
   945→        const tasks = await loadAllTasks(ctx);
   946→        const items = await loadAllItems(ctx);
   947→        const index = new ReferenceIndex(tasks, items);
   948→        const foundTask = resolveTaskRef(ref, tasks, index);
   949→
   950→        // AC: @spec-task-reset ac-2 - Error if already pending
   951→        if (foundTask.status === 'pending') {
   952→          error('Task is already pending');
   953→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   954→        }
   955→
   956→        // Track previous status and reason for note (AC-4)
   957→        const previousStatus = foundTask.status;
   958→        const hadCancelReason = foundTask.closed_reason && foundTask.status === 'cancelled';
   959→        const cancelReasonText = hadCancelReason ? ` (was cancelled: ${foundTask.closed_reason})` : '';
   960→
   961→        // AC: @spec-task-reset ac-1 - Reset to pending, clear completion-related fields
   962→        const clearedFields: string[] = [];
   963→        const updatedTask: Task = {
   964→          ...foundTask,
   965→          status: 'pending',
   966→        };
   967→
   968→        // Clear timestamps and reasons based on previous status
   969→        if (foundTask.completed_at !== undefined && foundTask.completed_at !== null) {
   970→          updatedTask.completed_at = null;
   971→          clearedFields.push('completed_at');
   972→        }
   973→        if (foundTask.started_at !== undefined && foundTask.started_at !== null) {
   974→          updatedTask.started_at = null;
   975→          clearedFields.push('started_at');
   976→        }
   977→        if (foundTask.closed_reason !== undefined && foundTask.closed_reason !== null) {
   978→          updatedTask.closed_reason = null;
   979→          clearedFields.push('closed_reason');
   980→        }
   981→        if (foundTask.blocked_by.length > 0) {
   982→          updatedTask.blocked_by = [];
   983→          clearedFields.push('blocked_by');
   984→        }
   985→
   986→        // AC: @spec-task-reset ac-4 - Add note documenting the reset
   987→        const noteContent = `Reset from ${previousStatus} to pending${cancelReasonText}`;
   988→        const note = createNote(noteContent, '@human');
   989→        updatedTask.notes = [...updatedTask.notes, note];
   990→
   991→        await saveTask(ctx, updatedTask);
   992→        // AC: @spec-task-reset ac-3 - Shadow commit with message task-reset
   993→        await commitIfShadow(ctx.shadow, 'task-reset', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), `from ${previousStatus}`);
   994→
   995→        // AC: @spec-task-reset ac-6 - JSON output includes previous_status, new_status, cleared_fields
   996→        const jsonOutput = {
   997→          task: updatedTask,
   998→          previous_status: previousStatus,
   999→          new_status: 'pending' as const,
  1000→          cleared_fields: clearedFields,
  1001→        };
  1002→
  1003→        output(jsonOutput, () => {
  1004→          success(`Reset task: ${index.shortUlid(updatedTask._ulid)} (${previousStatus} → pending)`, undefined);
  1005→          if (clearedFields.length > 0) {
  1006→            info(`Cleared fields: ${clearedFields.join(', ')}`);
  1007→          }
  1008→        });
  1009→      } catch (err) {
  1010→        error('Failed to reset task', err);
  1011→        process.exit(EXIT_CODES.ERROR);
  1012→      }
  1013→    });
  1014→
  1015→  // kspec task delete <ref> | --refs <refs...>
  1016→  // AC: @multi-ref-batch ac-1, ac-2
  1017→  task
  1018→    .command('delete [ref]')
  1019→    .description('Delete a task permanently')
  1020→    .option('--refs <refs...>', 'Delete multiple tasks by ref')
  1021→    .option('--force', 'Skip confirmation (required for --refs)')
  1022→    .option('--dry-run', 'Show what would be deleted without deleting')
  1023→    .action(async (ref: string | undefined, options) => {
  1024→      try {
  1025→        const ctx = await initContext();
  1026→        const tasks = await loadAllTasks(ctx);
  1027→        const items = await loadAllItems(ctx);
  1028→        const index = new ReferenceIndex(tasks, items);
  1029→
  1030→        // For batch mode (--refs), require --force
  1031→        if (options.refs && options.refs.length > 0 && !options.force && !options.dryRun) {
  1032→          error('Batch delete requires --force flag');
  1033→          process.exit(EXIT_CODES.USAGE_ERROR);
  1034→        }
  1035→
  1036→        const result = await executeBatchOperation({
  1037→          positionalRef: ref,
  1038→          refsFlag: options.refs,
  1039→          context: { ctx, tasks, items, index, options },
  1040→          items: tasks,
  1041→          index,
  1042→          resolveRef: (refStr, taskList, idx) => {
  1043→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1044→            return { item: resolved.task, error: resolved.error };
  1045→          },
  1046→          executeOperation: async (foundTask, { ctx, index, options }) => {
  1047→            try {
  1048→              const taskDisplay = `${foundTask.title} (${index.shortUlid(foundTask._ulid)})`;
  1049→
  1050→              if (options.dryRun) {
  1051→                return {
  1052→                  success: true,
  1053→                  message: `Would delete: ${taskDisplay}`,
  1054→                };
  1055→              }
  1056→
  1057→              // For single-ref mode (not --refs), prompt for confirmation unless --force
  1058→              if (!options.refs && !options.force) {
  1059→                const readline = await import('readline');
  1060→                const rl = readline.createInterface({
  1061→                  input: process.stdin,
  1062→                  output: process.stdout,
  1063→                });
  1064→
  1065→                const answer = await new Promise<string>((resolve) => {
  1066→                  rl.question(`Delete task "${taskDisplay}"? [y/N] `, resolve);
  1067→                });
  1068→                rl.close();
  1069→
  1070→                if (answer.toLowerCase() !== 'y') {
  1071→                  return {
  1072→                    success: false,
  1073→                    error: 'Deletion cancelled by user',
  1074→                  };
  1075→                }
  1076→              }
  1077→
  1078→              await deleteTask(ctx, foundTask);
  1079→              await commitIfShadow(ctx.shadow, 'task-delete', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), foundTask.title);
  1080→
  1081→              return {
  1082→                success: true,
  1083→                message: `Deleted task: ${taskDisplay}`,
  1084→              };
  1085→            } catch (err) {
  1086→              return {
  1087→                success: false,
  1088→                error: err instanceof Error ? err.message : String(err),
  1089→              };
  1090→            }
  1091→          },
  1092→          getUlid: (task) => task._ulid,
  1093→        });
  1094→
  1095→        formatBatchOutput(result, 'Delete');
  1096→      } catch (err) {
  1097→        error(errors.failures.deleteTask, err);
  1098→        process.exit(EXIT_CODES.ERROR);
  1099→      }
  1100→    });
  1101→
  1102→  // kspec task note <ref> <message>
  1103→  task
  1104→    .command('note <ref> <message>')
  1105→    .description('Add a note to a task')
  1106→    .option('--author <author>', 'Note author')
  1107→    .option('--supersedes <ulid>', 'ULID of note this supersedes')
  1108→    .action(async (ref: string, message: string, options) => {
  1109→      try {
  1110→        const ctx = await initContext();
  1111→        const tasks = await loadAllTasks(ctx);
  1112→        const items = await loadAllItems(ctx);
  1113→        const index = new ReferenceIndex(tasks, items);
  1114→        const foundTask = resolveTaskRef(ref, tasks, index);
  1115→
  1116→        const note = createNote(message, options.author, options.supersedes);
  1117→
  1118→        const updatedTask: Task = {
  1119→          ...foundTask,
  1120→          notes: [...foundTask.notes, note],
  1121→        };
  1122→
  1123→        await saveTask(ctx, updatedTask);
  1124→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
  1125→        success(`Added note to task: ${index.shortUlid(updatedTask._ulid)}`, { note });
  1126→
  1127→        // Proactive alignment guidance for tasks with spec_ref
  1128→        if (foundTask.spec_ref) {
  1129→          console.log('');
  1130→          console.log(alignmentCheck.header);
  1131→          console.log(alignmentCheck.beyondSpec);
  1132→          console.log(alignmentCheck.updateSpec(foundTask.spec_ref));
  1133→          console.log(alignmentCheck.addAC);
  1134→
  1135→          // Check if linked spec has acceptance criteria and remind about test coverage
  1136→          const specResult = index.resolve(foundTask.spec_ref);
  1137→          if (specResult.ok && specResult.item) {
  1138→            const specItem = specResult.item as { acceptance_criteria?: unknown[] };
  1139→            if (specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
  1140→              console.log('');
  1141→              console.log(alignmentCheck.testCoverage(specItem.acceptance_criteria.length));
  1142→            }
  1143→          }
  1144→        }
  1145→      } catch (err) {
  1146→        error(errors.failures.addNote, err);
  1147→        process.exit(EXIT_CODES.ERROR);
  1148→      }
  1149→    });
  1150→
  1151→  // kspec task notes <ref>
  1152→  task
  1153→    .command('notes <ref>')
  1154→    .description('Show notes for a task')
  1155→    .action(async (ref: string) => {
  1156→      try {
  1157→        const ctx = await initContext();
  1158→        const tasks = await loadAllTasks(ctx);
  1159→        const items = await loadAllItems(ctx);
