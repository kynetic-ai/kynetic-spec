   351→/**
   352→ * Format fix results for display
   353→ */
   354→function formatFixResult(result: FixResult): void {
   355→  if (result.fixesApplied.length === 0) {
   356→    console.log(chalk.gray('\nNo auto-fixable issues found.'));
   357→    return;
   358→  }
   359→
   360→  console.log(chalk.cyan(`\n✓ Applied ${result.fixesApplied.length} fix(es) to ${result.filesModified} file(s):`));
   361→
   362→  for (const fix of result.fixesApplied) {
   363→    const typeLabel = {
   364→      ulid_regenerated: 'ULID regenerated',
   365→      timestamp_added: 'Timestamp added',
   366→      status_added: 'Status added',
   367→    }[fix.type];
   368→
   369→    const shortFile = path.basename(fix.file);
   370→    console.log(chalk.cyan(`  ✓ ${shortFile}:${fix.path} - ${typeLabel}`));
   371→  }
   372→
   373→  if (result.errors.length > 0) {
   374→    console.log(chalk.yellow(`\nFix errors: ${result.errors.length}`));
   375→    for (const err of result.errors) {
   376→      console.log(chalk.yellow(`  ! ${err.file}: ${err.message}`));
   377→    }
   378→  }
   379→}
   380→
   381→/**
   382→ * Collect all files that can be fixed
   383→ */
   384→async function collectFixableFiles(ctx: { rootDir: string; specDir?: string; manifest?: { includes?: string[] } | null; manifestPath?: string | null }): Promise<string[]> {
   385→  const files: string[] = [];
   386→
   387→  // Task files (exclude test fixtures)
   388→  const taskFiles = await findTaskFiles(ctx.rootDir);
   389→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, 'spec'));
   390→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
   391→  files.push(...allTaskFiles.filter(f => !f.includes('fixtures') && !f.includes('test')));
   392→
   393→  // Spec files from includes
   394→  if (ctx.manifest && ctx.manifestPath) {
   395→    const manifestDir = path.dirname(ctx.manifestPath);
   396→    const includes = ctx.manifest.includes || [];
   397→
   398→    for (const include of includes) {
   399→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   400→      files.push(...expandedPaths);
   401→    }
   402→  }
   403→
   404→  // Inbox file
   405→  const inboxPath = path.join(ctx.rootDir, 'spec', 'kynetic.inbox.yaml');
   406→  try {
   407→    await import('node:fs/promises').then(fs => fs.access(inboxPath));
   408→    files.push(inboxPath);
   409→  } catch {
   410→    // Inbox file doesn't exist, skip
   411→  }
   412→
   413→  return [...new Set(files)];
   414→}
   415→
   416→/**
   417→ * Format validation result for display
   418→ */
   419→function formatValidationResult(result: ValidationResult, verbose: boolean): void {
   420→  // Header
   421→  if (result.valid) {
   422→    console.log(chalk.green.bold('✓ Validation passed'));
   423→  } else {
   424→    console.log(chalk.red.bold('✗ Validation failed'));
   425→  }
   426→
   427→  console.log(chalk.gray('─'.repeat(40)));
   428→  console.log(`Files checked: ${result.stats.filesChecked}`);
   429→  console.log(`Items checked: ${result.stats.itemsChecked}`);
   430→  console.log(`Tasks checked: ${result.stats.tasksChecked}`);
   431→
   432→  // AC-meta-manifest-2: Display meta summary line
   433→  if (result.metaStats) {
   434→    console.log(`Meta: ${result.metaStats.agents} agents, ${result.metaStats.workflows} workflows, ${result.metaStats.conventions} conventions`);
   435→  }
   436→
   437→  // Schema errors
   438→  if (result.schemaErrors.length > 0) {
   439→    console.log(chalk.red(`\nSchema errors: ${result.schemaErrors.length}`));
   440→    for (const err of result.schemaErrors) {
   441→      const location = err.path ? `${err.file}:${err.path}` : err.file;
   442→      console.log(chalk.red(`  ✗ ${location}`));
   443→      console.log(chalk.gray(`    ${err.message}`));
   444→      if (verbose && err.details) {
   445→        console.log(chalk.gray(`    ${JSON.stringify(err.details)}`));
   446→      }
   447→    }
   448→  } else {
   449→    console.log(chalk.green('\nSchema: OK'));
   450→  }
   451→
   452→  // Reference errors
   453→  if (result.refErrors.length > 0) {
   454→    console.log(chalk.red(`\nReference errors: ${result.refErrors.length}`));
   455→    for (const err of result.refErrors) {
   456→      const location = err.sourceFile
   457→        ? `${err.sourceFile} (${err.field})`
   458→        : `${err.sourceUlid?.slice(0, 8)} (${err.field})`;
   459→      console.log(chalk.red(`  ✗ ${err.ref}`));
   460→      console.log(chalk.gray(`    ${err.message}`));
   461→      console.log(chalk.gray(`    in: ${location}`));
   462→    }
   463→  } else {
   464→    console.log(chalk.green('References: OK'));
   465→  }
   466→
   467→  // Reference warnings (deprecated targets)
   468→  if (result.refWarnings.length > 0) {
   469→    console.log(chalk.yellow(`\nReference warnings: ${result.refWarnings.length}`));
   470→    const shown = verbose ? result.refWarnings : result.refWarnings.slice(0, 5);
   471→    for (const warn of shown) {
   472→      const location = warn.sourceFile
   473→        ? `${warn.sourceFile} (${warn.field})`
   474→        : `${warn.sourceUlid?.slice(0, 8)} (${warn.field})`;
   475→      console.log(chalk.yellow(`  ⚠ ${warn.ref}`));
   476→      console.log(chalk.gray(`    ${warn.message}`));
   477→      console.log(chalk.gray(`    in: ${location}`));
   478→    }
   479→    if (!verbose && result.refWarnings.length > 5) {
   480→      console.log(chalk.gray(`  ... and ${result.refWarnings.length - 5} more (use -v to see all)`));
   481→    }
   482→  }
   483→
   484→  // AC: @trait-edge-cases ac-2
   485→  // Trait cycle errors
   486→  if (result.traitCycleErrors.length > 0) {
   487→    console.log(chalk.red(`\nTrait cycle errors: ${result.traitCycleErrors.length}`));
   488→    for (const err of result.traitCycleErrors) {
   489→      console.log(chalk.red(`  ✗ ${err.traitRef} - ${err.traitTitle}`));
   490→      console.log(chalk.gray(`    ${err.message}`));
   491→    }
   492→  }
   493→
   494→  // Orphans (warnings, not errors)
   495→  if (result.orphans.length > 0) {
   496→    console.log(chalk.yellow(`\nOrphans (not referenced): ${result.orphans.length}`));
   497→    if (verbose) {
   498→      for (const orphan of result.orphans) {
   499→        console.log(chalk.yellow(`  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`));
   500→      }
   501→    } else {
   502→      // Show first few
   503→      const shown = result.orphans.slice(0, 5);
   504→      for (const orphan of shown) {
   505→        console.log(chalk.yellow(`  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`));
   506→      }
   507→      if (result.orphans.length > 5) {
   508→        console.log(chalk.gray(`  ... and ${result.orphans.length - 5} more (use -v to see all)`));
   509→      }
   510→    }
   511→  }
   512→}
   513→
   514→/**
   515→ * Register validate command
   516→ */
   517→export function registerValidateCommand(program: Command): void {
   518→  program
   519→    .command('validate')
   520→    .description('Validate spec files')
   521→    .option('--schema', 'Check schema conformance only')
   522→    .option('--refs', 'Check reference resolution only')
   523→    .option('--orphans', 'Find orphaned items only')
   524→    .option('--alignment', 'Check spec-task alignment')
   525→    .option('--completeness', 'Check spec completeness (missing AC, descriptions, status inconsistencies)')
   526→    .option('--conventions', 'Validate conventions')
   527→    .option('--staleness', 'Check for stale status mismatches between specs and tasks')
   528→    .option('--fix', 'Auto-fix issues where possible (invalid ULIDs, missing timestamps)')
   529→    .option('-v, --verbose', 'Show detailed output')
   530→    .option('--strict', 'Treat orphans and staleness warnings as errors')
   531→    .action(async (options) => {
   532→      try {
   533→        const ctx = await initContext();
   534→
   535→        if (!ctx.manifestPath) {
   536→          error(validationStrings.noManifest);
   537→          console.log(validationStrings.initHint);
   538→          process.exit(EXIT_CODES.ERROR);
   539→        }
   540→
   541→        // Determine which checks to run
   542→        const runAll = !options.schema && !options.refs && !options.orphans && !options.alignment && !options.completeness && !options.conventions;
   543→        const validateOptions = {
   544→          schema: runAll || options.schema,
   545→          refs: runAll || options.refs,
   546→          orphans: runAll || options.orphans,
   547→          completeness: runAll || options.completeness,
   548→        };
   549→
   550→        const result = await validate(ctx, validateOptions);
   551→
   552→        // In strict mode, orphans are errors
   553→        if (options.strict && result.orphans.length > 0) {
   554→          result.valid = false;
   555→        }
   556→
   557→        output(result, () => formatValidationResult(result, options.verbose));
   558→
   559→        // Run auto-fix if requested
   560→        if (options.fix) {
   561→          const filesToFix = await collectFixableFiles(ctx);
   562→          const fixResult = await fixFiles(filesToFix);
   563→          formatFixResult(fixResult);
   564→
   565→          // Re-run validation after fixes to show updated status
   566→          if (fixResult.fixesApplied.length > 0) {
   567→            console.log(validationStrings.revalidating);
   568→            const revalidateResult = await validate(ctx, validateOptions);
   569→            if (revalidateResult.valid) {
   570→              console.log(validationStrings.nowPasses);
   571→            } else {
   572→              console.log(validationStrings.issuesRemain);
   573→            }
   574→            // Update result for exit code
   575→            result.valid = revalidateResult.valid;
   576→            result.schemaErrors = revalidateResult.schemaErrors;
   577→            result.refErrors = revalidateResult.refErrors;
   578→          }
   579→        }
   580→
   581→        // Run alignment check if requested or running all checks
   582→        if (options.alignment || runAll) {
   583→          const tasks = await loadAllTasks(ctx);
   584→          const items = await loadAllItems(ctx);
   585→          const refIndex = new ReferenceIndex(tasks, items);
   586→          const alignmentIndex = new AlignmentIndex(tasks, items);
   587→          alignmentIndex.buildLinks(refIndex);
   588→
   589→          const alignmentWarnings = alignmentIndex.findAlignmentWarnings();
   590→          formatAlignmentWarnings(alignmentWarnings, options.verbose);
   591→
   592→          // Show alignment stats
   593→          const stats = alignmentIndex.getStats();
   594→          console.log(
   595→            validationStrings.alignmentStats(stats.specsWithTasks, stats.totalSpecs, stats.alignedSpecs)
   596→          );
   597→        }
   598→
   599→        // Show completeness warnings if any
   600→        // AC: @spec-completeness ac-4
   601→        if (result.completenessWarnings.length > 0) {
   602→          formatCompletenessWarnings(result.completenessWarnings, options.verbose);
   603→        }
   604→
   605→        // Run convention validation if requested
   606→        // AC: @convention-definitions ac-3, ac-4
   607→        if (options.conventions) {
   608→          try {
   609→            const metaCtx = await loadMetaContext(ctx);
   610→            if (metaCtx && metaCtx.conventions.length > 0) {
   611→              // For now, we just validate that conventions are well-formed
   612→              // Full validation against actual content (commits, notes, etc.)
   613→              // would require additional content gathering logic
   614→              const conventionResult = validateConventions(metaCtx.conventions, {});
   615→              formatConventionValidationResult(conventionResult);
   616→
   617→              if (!conventionResult.valid) {
   618→                result.valid = false;
   619→              }
   620→            } else {
   621→              console.log(chalk.gray('No conventions defined in meta manifest'));
   622→            }
   623→          } catch (err) {
   624→            console.log(chalk.yellow('Warning: Could not load meta manifest for convention validation'));
   625→          }
   626→        }
   627→
   628→        // Run staleness checks if requested
   629→        // AC: @stale-status-detection ac-4, ac-5
   630→        if (options.staleness) {
   631→          const tasks = await loadAllTasks(ctx);
   632→          const items = await loadAllItems(ctx);
   633→          const refIndex = new ReferenceIndex(tasks, items);
   634→
   635→          const stalenessWarnings = checkStaleness(items, tasks, refIndex);
   636→          formatStalenessWarnings(stalenessWarnings, options.verbose);
   637→
   638→          // AC: @stale-status-detection ac-5 (staleness-exit-code)
   639→          // With --strict, staleness warnings cause validation failure
   640→          if (options.strict && stalenessWarnings.length > 0) {
   641→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   642→          }
   643→        }
   644→
   645→        if (!result.valid) {
   646→          process.exit(EXIT_CODES.ERROR);
   647→        }
   648→      } catch (err) {
   649→        error(validationStrings.failed, err);
   650→        process.exit(EXIT_CODES.ERROR);
   651→      }
   652→    });
   653→
   654→  // Alias: kspec lint
   655→  program
