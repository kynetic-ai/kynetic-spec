   308→/**
   309→ * Format alignment warnings for display
   310→ */
   311→function formatAlignmentWarnings(warnings: AlignmentWarning[], verbose: boolean): void {
   312→  if (warnings.length === 0) {
   313→    console.log(chalk.green('Alignment: OK'));
   314→    return;
   315→  }
   316→
   317→  console.log(chalk.yellow(`\nAlignment warnings: ${warnings.length}`));
   318→
   319→  // Group by type
   320→  const orphaned = warnings.filter(w => w.type === 'orphaned_spec');
   321→  const mismatches = warnings.filter(w => w.type === 'status_mismatch');
   322→  const stale = warnings.filter(w => w.type === 'stale_implementation');
   323→
   324→  if (orphaned.length > 0) {
   325→    console.log(chalk.yellow(`  Orphaned specs (no tasks): ${orphaned.length}`));
   326→    const shown = verbose ? orphaned : orphaned.slice(0, 3);
   327→    for (const w of shown) {
   328→      console.log(chalk.gray(`    ○ ${w.specTitle}`));
   329→    }
   330→    if (!verbose && orphaned.length > 3) {
   331→      console.log(chalk.gray(`    ... and ${orphaned.length - 3} more`));
   332→    }
   333→  }
   334→
   335→  if (mismatches.length > 0) {
   336→    console.log(chalk.yellow(`  Status mismatches: ${mismatches.length}`));
   337→    for (const w of mismatches) {
   338→      console.log(chalk.yellow(`    ! ${w.specTitle}`));
   339→      console.log(chalk.gray(`      ${w.message}`));
   340→    }
   341→  }
   342→
   343→  if (stale.length > 0) {
   344→    console.log(chalk.yellow(`  Stale implementation status: ${stale.length}`));
   345→    for (const w of stale) {
   346→      console.log(chalk.yellow(`    ! ${w.message}`));
   347→    }
   348→  }
   349→}
