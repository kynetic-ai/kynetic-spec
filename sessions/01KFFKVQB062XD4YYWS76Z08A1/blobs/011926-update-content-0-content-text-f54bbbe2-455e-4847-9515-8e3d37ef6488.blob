   227→/**
   228→ * Format completeness warnings for display
   229→ * AC: @spec-completeness ac-4
   230→ */
   231→function formatCompletenessWarnings(warnings: CompletenessWarning[], verbose: boolean): void {
   232→  if (warnings.length === 0) {
   233→    console.log(chalk.green('Completeness: OK'));
   234→    return;
   235→  }
   236→
   237→  console.log(chalk.yellow(`\nCompleteness warnings: ${warnings.length}`));
   238→
   239→  // Group by type
   240→  const missingAC = warnings.filter(w => w.type === 'missing_acceptance_criteria');
   241→  const missingDesc = warnings.filter(w => w.type === 'missing_description');
   242→  const statusMismatch = warnings.filter(w => w.type === 'status_inconsistency');
   243→  const missingTestCoverage = warnings.filter(w => w.type === 'missing_test_coverage');
   244→  const automationNoSpec = warnings.filter(w => w.type === 'automation_eligible_no_spec');
   245→
   246→  // AC: @spec-completeness ac-4
   247→  // Show summary with counts by issue type
   248→  if (missingAC.length > 0) {
   249→    console.log(chalk.yellow(`  Missing acceptance criteria: ${missingAC.length}`));
   250→    const shown = verbose ? missingAC : missingAC.slice(0, 3);
   251→    for (const w of shown) {
   252→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
   253→    }
   254→    if (!verbose && missingAC.length > 3) {
   255→      console.log(chalk.gray(`    ... and ${missingAC.length - 3} more`));
   256→    }
   257→  }
   258→
   259→  if (missingDesc.length > 0) {
   260→    console.log(chalk.yellow(`  Missing descriptions: ${missingDesc.length}`));
   261→    const shown = verbose ? missingDesc : missingDesc.slice(0, 3);
   262→    for (const w of shown) {
   263→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
   264→    }
   265→    if (!verbose && missingDesc.length > 3) {
   266→      console.log(chalk.gray(`    ... and ${missingDesc.length - 3} more`));
   267→    }
   268→  }
   269→
   270→  if (statusMismatch.length > 0) {
   271→    console.log(chalk.yellow(`  Status inconsistencies: ${statusMismatch.length}`));
   272→    for (const w of statusMismatch) {
   273→      console.log(chalk.yellow(`    ! ${w.message}`));
   274→      if (w.details) {
   275→        console.log(chalk.gray(`      ${w.details}`));
   276→      }
   277→    }
   278→  }
   279→
   280→  if (missingTestCoverage.length > 0) {
   281→    console.log(chalk.yellow(`  Missing test coverage: ${missingTestCoverage.length}`));
   282→    const shown = verbose ? missingTestCoverage : missingTestCoverage.slice(0, 3);
   283→    for (const w of shown) {
   284→      console.log(chalk.yellow(`    ! ${w.itemRef} - ${w.itemTitle}`));
   285→      if (w.details) {
   286→        console.log(chalk.gray(`      ${w.details}`));
   287→      }
   288→    }
   289→    if (!verbose && missingTestCoverage.length > 3) {
   290→      console.log(chalk.gray(`    ... and ${missingTestCoverage.length - 3} more`));
   291→    }
   292→  }
   293→
   294→  // AC: @task-automation-eligibility ac-21, ac-23
   295→  if (automationNoSpec.length > 0) {
   296→    console.log(chalk.yellow(`  Automation without spec: ${automationNoSpec.length}`));
   297→    const shown = verbose ? automationNoSpec : automationNoSpec.slice(0, 3);
   298→    for (const w of shown) {
   299→      console.log(chalk.yellow(`    ! ${w.itemRef} - ${w.itemTitle}`));
   300→      console.log(chalk.gray(`      ${w.message}`));
   301→    }
   302→    if (!verbose && automationNoSpec.length > 3) {
   303→      console.log(chalk.gray(`    ... and ${automationNoSpec.length - 3} more`));
   304→    }
   305→  }
   306→}
