```
     1→import * as path from 'node:path';
     2→import { Command } from 'commander';
     3→import chalk from 'chalk';
     4→import {
     5→  initContext,
     6→  validate,
     7→  loadAllTasks,
     8→  loadAllItems,
     9→  AlignmentIndex,
    10→  ReferenceIndex,
    11→  fixFiles,
    12→  findTaskFiles,
    13→  expandIncludePattern,
    14→  loadMetaContext,
    15→  validateConventions,
    16→  type ValidationResult,
    17→  type AlignmentWarning,
    18→  type CompletenessWarning,
    19→  type FixResult,
    20→  type ConventionValidationResult,
    21→} from '../../parser/index.js';
    22→import { output, success, error, info } from '../output.js';
    23→import { validation as validationStrings } from '../../strings/index.js';
    24→import { EXIT_CODES } from '../exit-codes.js';
    25→import type { LoadedTask, LoadedSpecItem } from '../../parser/index.js';
    26→
    27→/**
    28→ * Staleness warning types
    29→ * AC: @stale-status-detection
    30→ */
    31→interface StalenessWarning {
    32→  type: 'parent-pending-children-done' | 'spec-implemented-no-task' | 'task-done-spec-not-started';
    33→  message: string;
    34→  refs: string[];
    35→}
    36→
    37→/**
    38→ * Check for stale status mismatches between specs and tasks
    39→ * AC: @stale-status-detection ac-1, ac-2, ac-3
    40→ */
    41→function checkStaleness(items: LoadedSpecItem[], tasks: LoadedTask[], refIndex: ReferenceIndex): StalenessWarning[] {
    42→  const warnings: StalenessWarning[] = [];
    43→
    44→  // AC: @stale-status-detection ac-1 (parent-pending-children-done)
    45→  // Check if task with dependencies is pending but all dependencies are completed
    46→  for (const task of tasks) {
    47→    // Only check pending/in_progress tasks with dependencies
    48→    if (task.status !== 'pending' && task.status !== 'in_progress') continue;
    49→    if (!task.depends_on || task.depends_on.length === 0) continue;
    50→
    51→    // Resolve all dependency tasks
    52→    const depTasks = task.depends_on
    53→      .map(depRef => {
    54→        const result = refIndex.resolve(depRef);
    55→        if (!result.ok) return null;
    56→        return tasks.find(t => t._ulid === result.ulid);
    57→      })
    58→      .filter((t): t is LoadedTask => t !== null);
    59→
    60→    if (depTasks.length === 0) continue;
    61→
    62→    // Check if all dependencies are completed and their linked specs are implemented
    63→    const allDepsDone = depTasks.every(depTask => {
    64→      if (depTask.status !== 'completed') return false;
    65→
    66→      // If the dep task has a spec_ref, check if that spec is implemented
    67→      if (depTask.spec_ref) {
    68→        const result = refIndex.resolve(depTask.spec_ref);
    69→        if (!result.ok) return true; // Missing spec ref doesn't block
    70→        const spec = items.find(item => item._ulid === result.ulid);
    71→        return spec?.status?.implementation === 'implemented';
    72→      }
    73→      return true;
    74→    });
    75→
    76→    if (allDepsDone) {
    77→      const taskRef = task.slugs[0] || refIndex.shortUlid(task._ulid);
    78→      warnings.push({
    79→        type: 'parent-pending-children-done',
    80→        message: `Task @${taskRef} is ${task.status} but all dependencies are completed. Consider completing or reviewing.`,
    81→        refs: [task._ulid],
    82→      });
    83→    }
    84→  }
    85→
    86→  // AC: @stale-status-detection ac-2 (spec-implemented-no-task)
    87→  // Check if spec is implemented but has no completed tasks
    88→  for (const item of items) {
    89→    if (item.status?.implementation !== 'implemented') continue;
    90→
    91→    // Find completed tasks that reference this spec
    92→    const completedTasks = tasks.filter(task => {
    93→      if (task.status !== 'completed' || !task.spec_ref) return false;
    94→      const result = refIndex.resolve(task.spec_ref);
    95→      return result.ok && result.ulid === item._ulid;
    96→    });
    97→
    98→    if (completedTasks.length === 0) {
    99→      const specRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
   100→      warnings.push({
   101→        type: 'spec-implemented-no-task',
   102→        message: `Spec @${specRef} is implemented but has no completed tasks. Verify implementation or link existing task.`,
   103→        refs: [item._ulid],
   104→      });
   105→    }
   106→  }
   107→
   108→  // AC: @stale-status-detection ac-3 (task-done-spec-not-started)
   109→  // Check if task is completed but spec is still not_started
   110→  for (const task of tasks) {
   111→    if (task.status !== 'completed') continue;
   112→    if (!task.spec_ref) continue;
   113→
   114→    // Resolve spec reference
   115→    const result = refIndex.resolve(task.spec_ref);
   116→    if (!result.ok) continue;
   117→
   118→    const spec = items.find(item => item._ulid === result.ulid);
   119→    if (!spec) continue;
   120→
   121→    if (spec.status?.implementation === 'not_started') {
   122→      const taskRef = task.slugs[0] || refIndex.shortUlid(task._ulid);
   123→      const specRef = spec.slugs[0] || refIndex.shortUlid(spec._ulid);
   124→      warnings.push({
   125→        type: 'task-done-spec-not-started',
   126→        message: `Task @${taskRef} completed but spec @${specRef} is not_started. Update spec status.`,
   127→        refs: [task._ulid, spec._ulid],
   128→      });
   129→    }
   130→  }
   131→
   132→  return warnings;
   133→}
   134→
   135→/**
   136→ * Format staleness warnings for display
   137→ * AC: @stale-status-detection ac-4
   138→ */
   139→function formatStalenessWarnings(warnings: StalenessWarning[], verbose: boolean): void {
   140→  if (warnings.length === 0) {
   141→    console.log(chalk.green('Staleness: OK'));
   142→    return;
   143→  }
   144→
   145→  console.log(chalk.yellow(`\nStaleness warnings: ${warnings.length}`));
   146→
   147→  // Group by type
   148→  const parentPending = warnings.filter(w => w.type === 'parent-pending-children-done');
   149→  const specNoTask = warnings.filter(w => w.type === 'spec-implemented-no-task');
   150→  const taskDoneSpecNot = warnings.filter(w => w.type === 'task-done-spec-not-started');
   151→
   152→  if (parentPending.length > 0) {
   153→    console.log(chalk.yellow(`  Parent pending, children done: ${parentPending.length}`));
   154→    const shown = verbose ? parentPending : parentPending.slice(0, 3);
   155→    for (const w of shown) {
   156→      console.log(chalk.yellow(`    ! ${w.message}`));
   157→    }
   158→    if (!verbose && parentPending.length > 3) {
   159→      console.log(chalk.gray(`    ... and ${parentPending.length - 3} more`));
   160→    }
   161→  }
   162→
   163→  if (specNoTask.length > 0) {
   164→    console.log(chalk.yellow(`  Spec implemented, no task: ${specNoTask.length}`));
   165→    const shown = verbose ? specNoTask : specNoTask.slice(0, 3);
   166→    for (const w of shown) {
   167→      console.log(chalk.yellow(`    ! ${w.message}`));
   168→    }
   169→    if (!verbose && specNoTask.length > 3) {
   170→      console.log(chalk.gray(`    ... and ${specNoTask.length - 3} more`));
   171→    }
   172→  }
   173→
   174→  if (taskDoneSpecNot.length > 0) {
   175→    console.log(chalk.yellow(`  Task done, spec not started: ${taskDoneSpecNot.length}`));
   176→    const shown = verbose ? taskDoneSpecNot : taskDoneSpecNot.slice(0, 3);
   177→    for (const w of shown) {
   178→      console.log(chalk.yellow(`    ! ${w.message}`));
   179→    }
   180→    if (!verbose && taskDoneSpecNot.length > 3) {
   181→      console.log(chalk.gray(`    ... and ${taskDoneSpecNot.length - 3} more`));
   182→    }
   183→  }
   184→}
   185→
   186→/**
   187→ * Format convention validation results for display
   188→ * AC: @convention-definitions ac-3, ac-4
   189→ */
   190→function formatConventionValidationResult(result: ConventionValidationResult): void {
   191→  if (result.valid && result.skipped.length === 0) {
   192→    console.log(chalk.green('Conventions: OK'));
   193→    return;
   194→  }
   195→
   196→  // AC: @convention-definitions ac-4
   197→  // Skipped prose conventions
   198→  if (result.skipped.length > 0) {
   199→    for (const domain of result.skipped) {
   200→      console.log(chalk.gray(`ℹ Skipping prose convention: ${domain}`));
   201→    }
   202→  }
   203→
   204→  // AC: @convention-definitions ac-3
   205→  // Validation errors
   206→  if (result.errors.length > 0) {
   207→    console.log(chalk.red(`\nConvention violations: ${result.errors.length}`));
   208→    for (const err of result.errors) {
   209→      console.log(chalk.red(`  ✗ ${err.domain}`));
   210→      console.log(chalk.gray(`    ${err.message}`));
   211→      if (err.expected) {
   212→        console.log(chalk.gray(`    Expected: ${err.expected}`));
   213→      }
   214→      if (err.location) {
   215→        console.log(chalk.gray(`    Location: ${err.location}`));
   216→      }
   217→    }
   218→  } else {
   219→    console.log(chalk.green('\nConventions: OK'));
   220→  }
   221→
   222→  // Stats
   223→  console.log(chalk.gray(`\nConventions checked: ${result.stats.conventionsChecked}`));
   224→  console.log(chalk.gray(`Conventions skipped: ${result.stats.conventionsSkipped}`));
   225→}
