  1152→    created: 2026-01-21T05:25:15.560Z
  1153→    description: "Add --refs support to kspec task set for bulk updates. Note: status changes must use
  1154→      dedicated commands (start, complete, etc.), not task set."
  1155→    acceptance_criteria:
  1156→      - id: ac-1
  1157→        given: multiple refs provided
  1158→        when: kspec task set --refs @a @b @c --priority 1 executed
  1159→        then: all tasks updated with same field values
  1160→      - id: ac-2
  1161→        given: setting multiple fields
  1162→        when: kspec task set --refs @a @b --priority 2 --tag urgent executed
  1163→        then: all specified fields updated
  1164→      - id: ac-3
  1165→        given: attempting to set status
  1166→        when: kspec task set --refs @a @b --status completed executed
  1167→        then: "error: Use state transition commands (start, complete, block, etc.) to change status"
  1168→      - id: ac-4
  1169→        given: no changes specified
  1170→        when: kspec task set --refs @a @b (no field flags) executed
  1171→        then: warns No changes specified for each, no changes saved
  1172→      - id: ac-5
  1173→        given: partial validation failure
  1174→        when: --refs @a @b where @a has invalid spec-ref target executed
  1175→        then: "@b updated, @a fails with validation error, exit code 1"
