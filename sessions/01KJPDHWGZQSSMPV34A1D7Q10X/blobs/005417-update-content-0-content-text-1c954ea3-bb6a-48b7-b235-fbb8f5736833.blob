   922→
   923→/**
   924→ * Get the current status of a task.
   925→ * AC: @ralph-subagent-spawning ac-12
   926→ */
   927→function runKspecCli(args: string[]) {
   928→  const cliPath = process.env.KSPEC_CLI_PATH || DEFAULT_KSPEC_CLI_PATH;
   929→  return spawnSync(process.execPath, [cliPath, ...args], {
   930→    encoding: "utf-8",
   931→    stdio: "pipe",
   932→    cwd: process.cwd(),
   933→  });
   934→}
   935→
   936→function getTaskStatus(taskRef: string): string | null {
   937→  const result = runKspecCli(["task", "get", taskRef, "--json"]);
   938→
   939→  if (result.status !== 0) {
   940→    warn(`Failed to check task status for ${taskRef}: ${result.stderr}`);
   941→    return null;
   942→  }
   943→
   944→  try {
   945→    return JSON.parse(result.stdout).status;
   946→  } catch {
   947→    warn(`Failed to parse task status for ${taskRef}`);
   948→    return null;
   949→  }
   950→}
   951→
   952→/**
   953→ * Mark a task as needing review due to subagent timeout.
   954→ * AC: @ralph-subagent-spawning ac-9
   955→ */
   956→async function markTaskNeedsReview(
   957→  taskRef: string,
   958→  reason: string,
   959→): Promise<void> {
   960→  // Use kspec CLI to set automation status
   961→  const result = runKspecCli(
   962→    ["task", "set", taskRef, "--automation", "needs_review", "--reason", reason],
   963→  );
   964→
   965→  if (result.status !== 0) {
   966→    warn(`Failed to mark task ${taskRef} as needs_review: ${result.stderr}`);
   967→  }
   968→
   969→  // Add a note explaining the timeout
   970→  const noteResult = runKspecCli(
   971→    ["task", "note", taskRef, `[RALPH SUBAGENT] ${reason}`],
   972→  );
   973→
   974→  if (noteResult.status !== 0) {
   975→    warn(`Failed to add timeout note to task ${taskRef}: ${noteResult.stderr}`);
   976→  }
   977→}
   978→
   979→/**
   980→ * Post a comment on the open PR for a task's branch, noting incomplete review.
   981→ * Uses `gh pr list --head <branch>` to find the PR and add a warning.
   982→ */
   983→async function commentOnPRReviewIncomplete(branch: string, reason: string): Promise<void> {
   984→  if (!branch || branch === "unknown") {
   985→    return;
   986→  }
   987→
   988→  const prListResult = spawnSync(
   989→    "gh",
   990→    ["pr", "list", "--state", "open", "--head", branch, "--json", "number", "--jq", ".[0].number"],
   991→    { encoding: "utf-8", stdio: "pipe" },
   992→  );
   993→
   994→  const prNumber = prListResult.stdout?.trim();
   995→  if (!prNumber || prListResult.status !== 0) {
   996→    // No open PR found — may already be merged or branch has no PR
   997→    return;
   998→  }
   999→
  1000→  const body = `⚠️ **Review incomplete**: ${reason}\n\nThis PR was not fully reviewed by the ralph review subagent. Manual review recommended before merging.`;
  1001→  const commentResult = spawnSync(
  1002→    "gh",
  1003→    ["pr", "comment", prNumber, "--body", body],
  1004→    { encoding: "utf-8", stdio: "pipe" },
  1005→  );
  1006→
  1007→  if (commentResult.status !== 0) {
  1008→    warn(`Failed to comment on PR #${prNumber}: ${commentResult.stderr}`);
  1009→  } else {
  1010→    info(`${DEFAULT_SUBAGENT_PREFIX} Posted review-incomplete comment on PR #${prNumber}`);
  1011→  }
  1012→}
  1013→
  1014→/**
  1015→ * Handle failed iteration by tracking per-task failures and escalating at threshold.
  1016→ * AC: @loop-mode-error-handling ac-1, ac-2, ac-3, ac-4, ac-5, ac-8
  1017→ */
  1018→async function handleIterationFailure(
  1019→  ctx: KspecContext,
  1020→  tasksInProgressAtStart: ActiveTaskSummary[],
  1021→  iterationStartTime: Date,
  1022→  errorDescription: string,
  1023→): Promise<void> {
  1024→  if (tasksInProgressAtStart.length === 0) {
  1025→    return;
  1026→  }
  1027→
  1028→  // Re-load current tasks to check progress
  1029→  const currentTasks = await loadAllTasks(ctx);
  1030→  const index = new ReferenceIndex(currentTasks, await loadAllItems(ctx));
  1031→
  1032→  // Convert ActiveTaskSummary to Task-like objects for processing
  1033→  const tasksInProgressFull = tasksInProgressAtStart
  1034→    .map((summary) => {
  1035→      const resolved = index.resolve(summary.ref);
  1036→      if (!resolved.ok) return undefined;
  1037→      // Check if the resolved item is a task (not a spec item or meta item)
  1038→      const item = resolved.item;
  1039→      if (!("status" in item)) return undefined; // Spec items don't have status
  1040→      return currentTasks.find((t) => t._ulid === resolved.ulid);
  1041→    })
  1042→    .filter((t): t is LoadedTask => t !== undefined && t.status === "in_progress");
  1043→
  1044→  if (tasksInProgressFull.length === 0) {
  1045→    return;
  1046→  }
  1047→
  1048→  // Process failures
  1049→  const { processFailedIteration, createFailureNote, getTaskFailureCount } = await import("../../ralph/index.js");
  1050→
  1051→  const results = processFailedIteration(
  1052→    tasksInProgressFull,
  1053→    currentTasks,
  1054→    iterationStartTime,
  1055→    errorDescription,
  1056→  );
  1057→
  1058→  // Add notes and escalate tasks
  1059→  for (const result of results) {
  1060→    const taskRef = result.taskRef;
  1061→    const task = currentTasks.find((t) => t._ulid === taskRef);
  1062→    if (!task) continue;
  1063→
  1064→    const priorCount = result.failureCount - 1;
  1065→    const noteContent = createFailureNote(taskRef, errorDescription, priorCount);
  1066→
  1067→    // Add LOOP-FAIL note
  1068→    const noteResult = spawnSync(
  1069→      "kspec",
  1070→      ["task", "note", `@${taskRef}`, noteContent],
  1071→      {
  1072→        encoding: "utf-8",
  1073→        stdio: "pipe",
  1074→        cwd: process.cwd(),
  1075→      },
  1076→    );
  1077→
  1078→    if (noteResult.status !== 0) {
  1079→      warn(`Failed to add failure note to task ${taskRef}: ${noteResult.stderr}`);
  1080→      continue;
  1081→    }
  1082→
  1083→    // AC: @loop-mode-error-handling ac-5 - Escalate at threshold
  1084→    if (result.escalated) {
  1085→      const escalateResult = spawnSync(
  1086→        "kspec",
  1087→        [
  1088→          "task",
  1089→          "set",
  1090→          `@${taskRef}`,
  1091→          "--automation",
  1092→          "needs_review",
  1093→          "--reason",
  1094→          `Loop mode: 3 consecutive failures without progress`,
  1095→        ],
  1096→        {
  1097→          encoding: "utf-8",
  1098→          stdio: "pipe",
  1099→          cwd: process.cwd(),
  1100→        },
  1101→      );
  1102→
  1103→      if (escalateResult.status !== 0) {
  1104→        warn(`Failed to escalate task ${taskRef}: ${escalateResult.stderr}`);
  1105→      } else {
  1106→        info(`Escalated task ${taskRef} to automation:needs_review after 3 failures`);
  1107→      }
  1108→    }
  1109→  }
  1110→}
  1111→
  1112→/**
  1113→ * Process pending_review tasks by spawning subagents.
  1114→ * AC: @ralph-subagent-spawning ac-6, ac-8
  1115→ */
  1116→async function processPendingReviewTasks(
  1117→  ctx: KspecContext,
  1118→  adapter: AgentAdapter,
  1119→  pendingReviewTasks: ActiveTaskSummary[],
  1120→  options: {
  1121→    yolo: boolean;
  1122→    specDir: string;
  1123→    sessionId: string;
  1124→    maxRetries: number;
  1125→    maxFailures: number;
  1126→    cwd: string;
  1127→    subagentTimeout: number;
  1128→    autoApproveArgs?: string[];
  1129→    prReviewSkillName: string;
  1130→  },
  1131→  consecutiveFailures: { count: number },
  1132→): Promise<boolean> {
  1133→  if (pendingReviewTasks.length === 0) {
  1134→    return true;
  1135→  }
  1136→
  1137→  // Visual separator for subagent section
  1138→  console.log("");
  1139→  console.log(chalk.cyan(`${"═".repeat(60)}`));
  1140→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Processing Pending Review Tasks`));
  1141→  console.log(chalk.cyan(`${"═".repeat(60)}`));
  1142→  console.log("");
  1143→
  1144→  info(
  1145→    `${DEFAULT_SUBAGENT_PREFIX} Found ${pendingReviewTasks.length} pending_review task(s)`,
  1146→  );
  1147→
  1148→  // AC: @ralph-subagent-spawning ac-6 - Process one at a time
  1149→  for (const task of pendingReviewTasks) {
  1150→    info(`${DEFAULT_SUBAGENT_PREFIX} Processing: ${task.ref} - ${task.title}`);
  1151→
  1152→    try {
  1153→      // Build context for this task
  1154→      const subagentCtx = await buildSubagentContext(ctx, task.ref);
  1155→
  1156→      // AC: @ralph-subagent-spawning ac-1, ac-3 - Spawn and wait
  1157→      const result = await runSubagent(
  1158→        adapter,
  1159→        subagentCtx,
  1160→        {
  1161→          timeout: options.subagentTimeout,
  1162→          outputPrefix: DEFAULT_SUBAGENT_PREFIX,
  1163→          skillName: options.prReviewSkillName,
  1164→        },
  1165→        {
  1166→          yolo: options.yolo,
  1167→          cwd: options.cwd,
  1168→          extraArgs: options.autoApproveArgs,
  1169→          handleRequest: (client, reqId, method, params) =>
  1170→            handleRequest(client, reqId, method, params, {
  1171→              yolo: options.yolo,
  1172→              specDir: options.specDir,
  1173→              sessionId: options.sessionId,
  1174→            }),
  1175→        },
  1176→      );
  1177→
  1178→      if (result.timedOut) {
  1179→        // AC: @ralph-subagent-spawning ac-9
  1180→        warn(
  1181→          `${DEFAULT_SUBAGENT_PREFIX} Subagent timed out for ${task.ref}`,
  1182→        );
  1183→        const timeoutMinutes = Math.round(options.subagentTimeout / 60000);
  1184→        await markTaskNeedsReview(
  1185→          task.ref,
  1186→          `Subagent timed out after ${timeoutMinutes} minutes`,
  1187→        );
  1188→        await commentOnPRReviewIncomplete(subagentCtx.gitBranch, `Review subagent timed out after ${timeoutMinutes} minutes for task ${task.ref}.`);
  1189→        consecutiveFailures.count++;
  1190→      } else if (!result.success) {
  1191→        // AC: @ralph-subagent-spawning ac-7
  1192→        error(
  1193→          `${DEFAULT_SUBAGENT_PREFIX} Subagent failed for ${task.ref}: ${result.error}`,
  1194→        );
  1195→        await commentOnPRReviewIncomplete(subagentCtx.gitBranch, `Review subagent failed for task ${task.ref}: ${result.error}`);
  1196→        consecutiveFailures.count++;
  1197→      } else {
  1198→        // AC: @ralph-subagent-spawning ac-12 - Verify task outcome
  1199→        const currentStatus = getTaskStatus(task.ref);
  1200→
  1201→        if (currentStatus === "completed") {
  1202→          success(`${DEFAULT_SUBAGENT_PREFIX} Completed: ${task.ref}`);
  1203→          consecutiveFailures.count = 0;
  1204→        } else if (currentStatus === "needs_work") {
  1205→          // Expected: reviewer found issues, kicked back to worker
  1206→          info(`${DEFAULT_SUBAGENT_PREFIX} Review completed for ${task.ref} — issues found, kicked back to worker`);
  1207→          // NOT a failure — the review worked correctly
  1208→          consecutiveFailures.count = 0;
  1209→        } else if (currentStatus === "pending_review") {
  1210→          // Subagent didn't transition or merge — count as soft failure
  1211→          warn(
  1212→            `${DEFAULT_SUBAGENT_PREFIX} Subagent completed but task ${task.ref} unchanged`,
  1213→          );
  1214→          await markTaskNeedsReview(
  1215→            task.ref,
  1216→            "Subagent completed but did not merge or kick back. Review required.",
  1217→          );
  1218→          consecutiveFailures.count++;
  1219→        } else {
  1220→          warn(`${DEFAULT_SUBAGENT_PREFIX} Task ${task.ref} in unexpected state: ${currentStatus}`);
  1221→          consecutiveFailures.count++;
  1222→        }
  1223→      }
  1224→
  1225→      // Check if we've hit max failures
  1226→      if (consecutiveFailures.count >= options.maxFailures) {
  1227→        error(
  1228→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
  1229→        );
  1230→        return false;
  1231→      }
  1232→    } catch (err) {
  1233→      const message = err instanceof Error ? err.message : String(err);
  1234→      error(`${DEFAULT_SUBAGENT_PREFIX} Error processing ${task.ref}: ${message}`);
  1235→      consecutiveFailures.count++;
  1236→
  1237→      if (consecutiveFailures.count >= options.maxFailures) {
  1238→        error(
  1239→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
  1240→        );
  1241→        return false;
  1242→      }
  1243→    }
  1244→  }
  1245→
  1246→  // Visual separator at end of subagent section
  1247→  console.log("");
  1248→  console.log(chalk.cyan(`${"═".repeat(60)}`));
  1249→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Completed Review Processing`));
  1250→  console.log(chalk.cyan(`${"═".repeat(60)}`));
  1251→  console.log("");
  1252→
  1253→  return true;
  1254→}
  1255→
  1256→// ─── Command Registration ────────────────────────────────────────────────────
  1257→
  1258→export function registerRalphCommand(program: Command): void {
  1259→  const ralph = program
  1260→    .command("ralph")
  1261→    .description("Ralph automated task loop and agent control");
  1262→
  1263→  // end-loop subcommand - allows agent to signal loop termination
  1264→  // AC: @session-end-loop-signal ac-signal
  1265→  ralph
  1266→    .command("end-loop")
  1267→    .description("End the ralph loop gracefully (stops all remaining iterations)")
  1268→    .option("--reason <reason>", "Reason for ending the loop")
  1269→    .action(async (options) => {
  1270→      try {
  1271→        const ctx = await initContext();
  1272→        const sessionId = process.env.KSPEC_SESSION_ID;
  1273→
  1274→        if (!sessionId) {
  1275→          // AC: @trait-error-guidance ac-1, ac-2
  1276→          warn("No active ralph session detected (KSPEC_SESSION_ID not set).");
  1277→          info("This command requires an active session. It is designed to be called by agents during a ralph loop.");
  1278→          info("Suggestion: Ensure KSPEC_SESSION_ID is set, or start a session with: kspec session create --agent-type ralph");
  1279→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1280→          return;
  1281→        }
  1282→
  1283→        // AC: @session-end-loop-signal ac-signal - Write end-loop state to session
  1284→        const updated = await requestEndLoop(ctx.specDir, sessionId, options.reason);
  1285→
  1286→        if (!updated) {
  1287→          // AC: @trait-error-guidance ac-1, ac-2
  1288→          error(`Session not found: ${sessionId}`);
  1289→          info("Suggestion: Check session ID with: kspec session log list");
  1290→          process.exit(EXIT_CODES.NOT_FOUND);
  1291→          return;
  1292→        }
  1293→
  1294→        success("Loop end signal sent");
  1295→        if (options.reason) {
  1296→          info(`Reason: ${options.reason}`);
  1297→        }
  1298→      } catch (err) {
  1299→        // AC: @trait-error-guidance ac-1

