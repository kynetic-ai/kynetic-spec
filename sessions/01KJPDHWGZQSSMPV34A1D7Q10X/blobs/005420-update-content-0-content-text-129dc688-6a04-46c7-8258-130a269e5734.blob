  1475→            process.exit(EXIT_CODES.VALIDATION_FAILED);
  1476→          }
  1477→        }
  1478→
  1479→        const skillOrigins = await loadSkillOriginsForRalph(ctx);
  1480→        const workerPromptPlatform = getPromptPlatformForAdapter(workerAdapterId);
  1481→        const reviewerPromptPlatform = getPromptPlatformForAdapter(reviewerAdapterId);
  1482→        const workerTaskWorkSkill = resolveRalphSkillInvocation(
