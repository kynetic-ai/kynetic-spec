   292→// ─── AC-6: Session log list shows session type ────────────────────────────────
   293→
   294→// AC: @session-model-evolution ac-6
   295→describe("kspec session log list session type display (CLI)", () => {
   296→  let tempDir: string;
   297→
   298→  beforeEach(async () => {
   299→    tempDir = await setupTempFixtures();
   300→
   301→    const sessionsDir = path.join(tempDir, "sessions");
   302→    await fs.mkdir(sessionsDir, { recursive: true });
   303→
   304→    // Legacy session (no trigger = loop type)
   305→    const s1 = testUlid("SESS", 1);
   306→    const s1Dir = path.join(sessionsDir, s1);
   307→    await fs.mkdir(s1Dir);
   308→    await fs.writeFile(path.join(s1Dir, "session.yaml"), YAML.stringify({
   309→      id: s1,
   310→      agent_type: "ralph",
   311→      status: "completed",
   312→      started_at: "2026-01-15T10:00:00.000Z",
   313→      ended_at: "2026-01-15T11:30:00.000Z",
   314→    }));
   315→    await fs.writeFile(path.join(s1Dir, "events.jsonl"), "");
   316→
   317→    // New invocation session (with trigger = task.ready)
   318→    const s2 = testUlid("SESS", 2);
   319→    const s2Dir = path.join(sessionsDir, s2);
   320→    await fs.mkdir(s2Dir);
   321→    await fs.writeFile(path.join(s2Dir, "session.yaml"), YAML.stringify({
   322→      id: s2,
   323→      agent_type: "claude-agent-acp",
   324→      agent_id: "@agent-worker",
   325→      trigger: "task.ready",
   326→      task_id: "@my-task",
   327→      status: "completed",
   328→      started_at: "2026-02-10T10:00:00.000Z",
   329→      ended_at: "2026-02-10T11:00:00.000Z",
   330→    }));
   331→    await fs.writeFile(path.join(s2Dir, "events.jsonl"), "");
   332→  });
   333→
   334→  afterEach(async () => {
   335→    await cleanupTempDir(tempDir);
   336→  });
   337→
   338→  it("should show session_type field in JSON output", () => {
   339→    const sessions = kspecJson<SessionLogSummary[]>("session log list", tempDir);
   340→    expect(sessions).toHaveLength(2);
   341→
   342→    const legacy = sessions.find((s) => s.agent_type === "ralph");
   343→    const invocation = sessions.find((s) => s.agent_type === "claude-agent-acp");
   344→
   345→    expect(legacy).toBeDefined();
   346→    expect(legacy!.session_type).toBe("loop");
   347→
   348→    expect(invocation).toBeDefined();
   349→    expect(invocation!.session_type).toBe("invocation");
   350→  });
   351→
   352→  it("should display Type column in text output", () => {
   353→    const result = kspec("session log list", tempDir);
   354→    expect(result.exitCode).toBe(0);
   355→    expect(result.stdout).toContain("Type");
   356→    expect(result.stdout).toContain("loop");
   357→    expect(result.stdout).toContain("invocation");
   358→  });
   359→});
