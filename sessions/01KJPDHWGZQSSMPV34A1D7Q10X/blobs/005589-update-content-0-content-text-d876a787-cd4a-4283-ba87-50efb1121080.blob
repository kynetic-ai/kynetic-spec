     1→/**
     2→ * Session Model Evolution tests.
     3→ *
     4→ * Tests for extended session metadata (trigger, agent_id), new status values,
     5→ * new event types, and session type classification (loop vs invocation).
     6→ *
     7→ * Task: @implement-session-model-evolution
     8→ * Spec: @session-model-evolution
     9→ */
    10→
    11→import { describe, it, expect, beforeEach, afterEach } from "vitest";
    12→import * as fs from "node:fs/promises";
    13→import * as os from "node:os";
    14→import * as path from "node:path";
    15→import * as YAML from "yaml";
    16→import {
    17→  createSession,
    18→  appendEvent,
    19→  getSession,
    20→  getSessionLogSummary,
    21→  getSessionLogDetail,
    22→  type SessionLogSummary,
    23→  type SessionLogDetail,
    24→} from "../src/sessions/store.js";
    25→import {
    26→  SessionStatusSchema,
    27→  EventTypeSchema,
    28→  SessionMetadataSchema,
    29→} from "../src/sessions/types.js";
    30→import {
    31→  setupTempFixtures,
    32→  cleanupTempDir,
    33→  kspec,
    34→  kspecJson,
    35→  testUlid,
    36→} from "./helpers/cli.js";
