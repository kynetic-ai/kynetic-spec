   361→// ─── AC-7: Session log show renders agent.* events ───────────────────────────
   362→
   363→// AC: @session-model-evolution ac-7
   364→describe("kspec session log show agent.* event rendering (CLI)", () => {
   365→  let tempDir: string;
   366→  const sessionId = testUlid("SESS");
   367→
   368→  beforeEach(async () => {
   369→    tempDir = await setupTempFixtures();
   370→
   371→    const sessionsDir = path.join(tempDir, "sessions");
   372→    await fs.mkdir(sessionsDir, { recursive: true });
   373→
   374→    const sDir = path.join(sessionsDir, sessionId);
   375→    await fs.mkdir(sDir);
   376→    await fs.writeFile(path.join(sDir, "session.yaml"), YAML.stringify({
   377→      id: sessionId,
   378→      agent_type: "claude-agent-acp",
   379→      agent_id: "@agent-worker",
   380→      trigger: "task.ready",
   381→      task_id: "@my-task",
   382→      status: "completed",
   383→      started_at: "2026-02-10T10:00:00.000Z",
   384→      ended_at: "2026-02-10T11:00:00.000Z",
   385→    }));
   386→
   387→    // Write events including agent.* types
   388→    const events = [
   389→      JSON.stringify({ ts: 1000, seq: 0, type: "agent.dispatched", session_id: sessionId, data: { task_id: "@my-task" } }),
   390→      JSON.stringify({ ts: 2000, seq: 1, type: "agent.started", session_id: sessionId, data: { task_id: "@my-task" } }),
   391→      JSON.stringify({ ts: 5000, seq: 2, type: "agent.completed", session_id: sessionId, data: { task_id: "@my-task", outcome: "success", duration_ms: 3000 } }),
   392→    ];
   393→    await fs.writeFile(path.join(sDir, "events.jsonl"), events.join("\n") + "\n");
   394→  });
   395→
   396→  afterEach(async () => {
   397→    await cleanupTempDir(tempDir);
   398→  });
   399→
   400→  it("should display session type in show output", () => {
   401→    const result = kspec(`session log show ${sessionId}`, tempDir);
   402→    expect(result.exitCode).toBe(0);
   403→    expect(result.stdout).toContain("Type:");
   404→    expect(result.stdout).toContain("invocation");
   405→  });
   406→
   407→  it("should include session_type in JSON output", () => {
   408→    const detail = kspecJson<SessionLogDetail>(`session log show ${sessionId}`, tempDir);
   409→    expect(detail.session_type).toBe("invocation");
   410→  });
   411→
   412→  it("should render agent.* events in event timeline", () => {
   413→    const result = kspec(`session log show ${sessionId} --events`, tempDir);
   414→    expect(result.exitCode).toBe(0);
   415→    expect(result.stdout).toContain("agent.dispatched");
   416→    expect(result.stdout).toContain("agent.started");
   417→    expect(result.stdout).toContain("agent.completed");
   418→  });
   419→
   420→  it("should include agent.* events in JSON output with --events", () => {
   421→    const detail = kspecJson<SessionLogDetail & { events?: Array<{ type: string; data: Record<string, unknown> }> }>(
   422→      `session log show ${sessionId} --events`,
   423→      tempDir,
   424→    );
   425→    expect(detail.events).toBeDefined();
   426→    expect(detail.events!.length).toBe(3);
   427→
   428→    const dispatched = detail.events!.find((e) => e.type === "agent.dispatched");
   429→    const started = detail.events!.find((e) => e.type === "agent.started");
   430→    const completed = detail.events!.find((e) => e.type === "agent.completed");
   431→
   432→    expect(dispatched).toBeDefined();
   433→    expect(started).toBeDefined();
   434→    expect(completed).toBeDefined();
   435→
   436→    // AC: @session-model-evolution ac-5 — agent.completed has task_id, outcome, duration_ms
   437→    expect(completed!.data.task_id).toBe("@my-task");
   438→    expect(completed!.data.outcome).toBe("success");
   439→    expect(completed!.data.duration_ms).toBe(3000);
   440→  });
   441→
   442→  it("should show human-readable summary for agent.* events", () => {
   443→    const result = kspec(`session log show ${sessionId} --events`, tempDir);
   444→    expect(result.exitCode).toBe(0);
   445→    // agent.dispatched shows "Dispatched for @my-task"
   446→    expect(result.stdout).toContain("Dispatched for @my-task");
   447→    // agent.started shows "Started work on @my-task"
   448→    expect(result.stdout).toContain("Started work on @my-task");
   449→    // agent.completed shows task_id, outcome, duration
   450→    expect(result.stdout).toContain("@my-task");
   451→    expect(result.stdout).toContain("success");
   452→  });
   453→});
