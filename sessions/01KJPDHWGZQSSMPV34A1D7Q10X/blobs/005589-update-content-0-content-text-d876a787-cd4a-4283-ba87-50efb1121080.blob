   103→// ─── AC-1: SessionMetadata with trigger and agent_id ─────────────────────────
   104→
   105→// AC: @session-model-evolution ac-1
   106→describe("SessionMetadata trigger and agent_id fields", () => {
   107→  let testDir: string;
   108→
   109→  beforeEach(async () => {
   110→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-session-model-"));
   111→  });
   112→
   113→  afterEach(async () => {
   114→    await fs.rm(testDir, { recursive: true });
   115→  });
   116→
   117→  it("should accept trigger and agent_id in session metadata", async () => {
   118→    const sessionId = testUlid("SESS");
   119→    await createSession(testDir, {
   120→      id: sessionId,
   121→      agent_type: "claude-agent-acp",
   122→      agent_id: "@agent-worker",
   123→      trigger: "task.ready",
   124→      task_id: "@my-task",
   125→    });
   126→
   127→    // Read back to verify persistence
   128→    const loaded = await getSession(testDir, sessionId);
   129→    expect(loaded).not.toBeNull();
   130→    expect(loaded!.agent_id).toBe("@agent-worker");
   131→    expect(loaded!.trigger).toBe("task.ready");
   132→    expect(loaded!.task_id).toBe("@my-task");
   133→  });
   134→
   135→  it("should accept all trigger enum values", () => {
   136→    const triggers = ["manual", "task.ready", "task.needs_work", "task.pending_review", "legacy"];
   137→    for (const trigger of triggers) {
   138→      const result = SessionMetadataSchema.safeParse({
   139→        id: "01SESS00000000000000000001",
   140→        agent_type: "test-agent",
   141→        trigger,
   142→        status: "active",
   143→        started_at: "2026-01-01T00:00:00.000Z",
   144→      });
   145→      expect(result.success).toBe(true);
   146→    }
   147→  });
   148→});
   149→
   150→// ─── AC-2: Backward compatibility for legacy sessions ─────────────────────────
   151→
   152→// AC: @session-model-evolution ac-2
   153→describe("Legacy session backward compatibility", () => {
   154→  let testDir: string;
   155→
   156→  beforeEach(async () => {
   157→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-legacy-session-"));
   158→  });
   159→
   160→  afterEach(async () => {
   161→    await fs.rm(testDir, { recursive: true });
   162→  });
   163→
   164→  it("should parse legacy session without trigger or agent_id without error", async () => {
   165→    const sessionId = testUlid("SESS");
   166→    // Write a legacy session.yaml directly (old format, no trigger/agent_id)
   167→    const sessionDir = path.join(testDir, "sessions", sessionId);
   168→    await fs.mkdir(sessionDir, { recursive: true });
   169→    await fs.writeFile(path.join(sessionDir, "session.yaml"), YAML.stringify({
   170→      id: sessionId,
   171→      agent_type: "ralph",
   172→      status: "completed",
   173→      started_at: "2026-01-15T10:00:00.000Z",
   174→      ended_at: "2026-01-15T12:00:00.000Z",
   175→    }));
   176→
   177→    // Should parse without error
   178→    const loaded = await getSession(testDir, sessionId);
   179→    expect(loaded).not.toBeNull();
   180→    expect(loaded!.agent_type).toBe("ralph");
   181→    // AC: @session-model-evolution ac-2 — legacy defaults are materialized on read
   182→    expect(loaded!.trigger).toBe("legacy");
   183→    expect(loaded!.agent_id).toBe("ralph"); // defaults to agent_type value
   184→  });
   185→
   186→  it("should classify legacy session as loop type in summary", async () => {
   187→    const sessionId = testUlid("SESS");
   188→    const sessionDir = path.join(testDir, "sessions", sessionId);
   189→    await fs.mkdir(sessionDir, { recursive: true });
   190→    await fs.writeFile(path.join(sessionDir, "session.yaml"), YAML.stringify({
   191→      id: sessionId,
   192→      agent_type: "ralph",
   193→      status: "completed",
   194→      started_at: "2026-01-15T10:00:00.000Z",
   195→      ended_at: "2026-01-15T12:00:00.000Z",
   196→    }));
   197→    await fs.writeFile(path.join(sessionDir, "events.jsonl"), "");
   198→
   199→    const summary = await getSessionLogSummary(testDir, sessionId);
   200→    expect(summary).not.toBeNull();
   201→    // Legacy session (no trigger) should be classified as "loop"
   202→    expect(summary!.session_type).toBe("loop");
   203→  });
   204→
   205→  it("should classify session with trigger=legacy as loop type", async () => {
   206→    const sessionId = testUlid("SESS", 1);
   207→    const sessionDir = path.join(testDir, "sessions", sessionId);
   208→    await fs.mkdir(sessionDir, { recursive: true });
   209→    await fs.writeFile(path.join(sessionDir, "session.yaml"), YAML.stringify({
   210→      id: sessionId,
   211→      agent_type: "ralph",
   212→      trigger: "legacy",
   213→      status: "completed",
   214→      started_at: "2026-01-15T10:00:00.000Z",
   215→      ended_at: "2026-01-15T12:00:00.000Z",
   216→    }));
   217→    await fs.writeFile(path.join(sessionDir, "events.jsonl"), "");
   218→
   219→    const summary = await getSessionLogSummary(testDir, sessionId);
   220→    expect(summary).not.toBeNull();
   221→    expect(summary!.session_type).toBe("loop");
   222→  });
   223→});
   224→
   225→// ─── AC-5: Structured agent.completed event ──────────────────────────────────
   226→
   227→// AC: @session-model-evolution ac-5
   228→describe("agent.completed event structure", () => {
   229→  let testDir: string;
   230→
   231→  beforeEach(async () => {
   232→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-agent-event-"));
   233→  });
   234→
   235→  afterEach(async () => {
   236→    await fs.rm(testDir, { recursive: true });
   237→  });
   238→
   239→  it("should append agent.completed event with task_id, outcome, and duration_ms", async () => {
   240→    const sessionId = testUlid("SESS");
   241→    await createSession(testDir, {
   242→      id: sessionId,
   243→      agent_type: "claude-agent-acp",
   244→    });
   245→
   246→    // Append structured agent.completed event
   247→    await appendEvent(testDir, {
   248→      type: "agent.completed",
   249→      session_id: sessionId,
   250→      data: {
   251→        task_id: "@my-task",
   252→        outcome: "success",
   253→        duration_ms: 45000,
   254→      },
   255→    });
   256→
   257→    // Read back events to verify
   258→    const eventsPath = path.join(testDir, "sessions", sessionId, "events.jsonl");
   259→    const content = await fs.readFile(eventsPath, "utf-8");
   260→    const lines = content.trim().split("\n").filter(Boolean);
   261→    expect(lines.length).toBe(1);
   262→
   263→    const event = JSON.parse(lines[0]);
   264→    expect(event.type).toBe("agent.completed");
   265→    expect(event.data.task_id).toBe("@my-task");
   266→    expect(event.data.outcome).toBe("success");
   267→    expect(event.data.duration_ms).toBe(45000);
   268→  });
   269→
   270→  it("should accept all outcome values for agent.completed", async () => {
   271→    const sessionId = testUlid("SESS", 1);
   272→    await createSession(testDir, {
   273→      id: sessionId,
   274→      agent_type: "claude-agent-acp",
   275→    });
   276→
   277→    for (const outcome of ["success", "blocked", "failed"]) {
   278→      await appendEvent(testDir, {
   279→        type: "agent.completed",
   280→        session_id: sessionId,
   281→        data: { task_id: "@task", outcome, duration_ms: 1000 },
   282→      });
   283→    }
   284→
   285→    const eventsPath = path.join(testDir, "sessions", sessionId, "events.jsonl");
   286→    const content = await fs.readFile(eventsPath, "utf-8");
   287→    const lines = content.trim().split("\n").filter(Boolean);
   288→    expect(lines.length).toBe(3);
   289→  });
   290→});
