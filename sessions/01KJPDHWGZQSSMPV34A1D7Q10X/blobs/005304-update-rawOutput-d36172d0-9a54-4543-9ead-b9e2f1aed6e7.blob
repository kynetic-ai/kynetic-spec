    89→
    90→// ─── Explicit Task Scope ─────────────────────────────────────────────────────
    91→
    92→/**
    93→ * Parsed explicit task scope for --tasks flag.
    94→ * AC: @cli-ralph ac-21
    95→ */
    96→interface ExplicitTaskScope {
    97→  /** Original refs as provided by user */
    98→  refs: string[];
    99→  /** Resolved ULIDs for the tasks */
   100→  ulids: string[];
   101→}
   102→
   103→/**
   104→ * Parse and validate --tasks flag value.
   105→ * Returns resolved ULIDs for the specified task refs.
   106→ * AC: @cli-ralph ac-21
   107→ *
   108→ * @throws Error if any ref cannot be resolved or is not a task
   109→ */
   110→async function parseExplicitTasks(
   111→  ctx: KspecContext,
   112→  tasksArg: string,
   113→): Promise<ExplicitTaskScope> {
   114→  const refs = tasksArg.split(",").map((r) => r.trim()).filter(Boolean);
   115→
   116→  if (refs.length === 0) {
   117→    throw new Error("--tasks requires at least one task reference");
   118→  }
   119→
   120→  // Load tasks and items for resolution
   121→  const tasks = await loadAllTasks(ctx);
   122→  const items = await loadAllItems(ctx);
   123→  const index = new ReferenceIndex(tasks, items);
   124→
   125→  const ulids: string[] = [];
   126→
   127→  for (const ref of refs) {
   128→    const result = index.resolve(ref);
   129→    if (!result.ok) {
   130→      throw new Error(`Cannot resolve task reference: ${ref}`);
   131→    }
   132→
   133→    // Verify it's a task (not a spec item)
   134→    const task = tasks.find((t) => t._ulid === result.ulid);
   135→    if (!task) {
   136→      throw new Error(`Reference ${ref} is not a task`);
   137→    }
   138→
   139→    ulids.push(result.ulid);
   140→  }
   141→
   142→  return { refs, ulids };
   143→}
   144→
   145→/**
   146→ * Filter session context to only include tasks from explicit scope.
   147→ * AC: @cli-ralph ac-21
   148→ */
   149→function filterByExplicitTasks(
   150→  ctx: SessionStartContext,
   151→  scope: ExplicitTaskScope,
   152→): SessionStartContext {
   153→  // Task refs in context are short ULIDs (variable length from shortUlid())
   154→  // Check if the context ref is a prefix of any explicit ULID
   155→  const matchesScope = (taskRef: string) => {
   156→    return scope.ulids.some((ulid) => ulid.startsWith(taskRef));
   157→  };
   158→
   159→  return {
   160→    ...ctx,
   161→    active_tasks: ctx.active_tasks.filter((t) => matchesScope(t.ref)),
   162→    pending_review_tasks: ctx.pending_review_tasks.filter((t) => matchesScope(t.ref)),
   163→    ready_tasks: ctx.ready_tasks.filter((t) => matchesScope(t.ref)),
   164→  };
   165→}
   166→
   167→/**
   168→ * Check if all explicit tasks are completed or blocked.
   169→ * AC: @cli-ralph ac-21
   170→ */
   171→async function allExplicitTasksDone(
   172→  ctx: KspecContext,
   173→  scope: ExplicitTaskScope,
   174→): Promise<{ done: boolean; statuses: Map<string, string> }> {
   175→  const tasks = await loadAllTasks(ctx);
   176→  const statuses = new Map<string, string>();
   177→
   178→  for (const ulid of scope.ulids) {
   179→    const task = tasks.find((t) => t._ulid === ulid);
   180→    if (task) {
   181→      statuses.set(ulid.slice(0, 8), task.status);
   182→    }
   183→  }
   184→
   185→  // Check if all are completed or blocked
   186→  const done = scope.ulids.every((ulid) => {
   187→    const status = statuses.get(ulid.slice(0, 8));
   188→    return status === "completed" || status === "blocked";
   189→  });
   190→
   191→  return { done, statuses };
   192→}
   193→
   194→// ─── Prompt Template ─────────────────────────────────────────────────────────
   195→
   196→type RalphPromptPlatform = "claude-code" | "codex" | "unknown";
   197→
   198→type SkillOrigin = LoadedSkill["origin"];
   199→
   200→const FALLBACK_CORE_SKILLS = new Set(["task-work", "reflect", "review"]);
   201→const ADAPTER_VALIDATION_PROBES = [["--help"], ["--version"]];
   202→const TERMINAL_PREVIEW_MAX_BYTES = 64 * 1024;
   203→const TOOL_OUTPUT_DIR = "tool-output";
   204→const RECENT_TASK_REF_LIMIT = 50;
   205→const DEFAULT_ITERATION_TIMEOUT_MINUTES = 20;
   206→const MAX_SESSION_UPDATE_QUEUE = 1000;
   207→
   208→type SpawnedAgentLike = Pick<SpawnedAgent, "client" | "kill">;
   209→
   210→class IterationTimeoutError extends Error {
   211→  constructor(public readonly timeoutMinutes: number, public readonly timeoutMs: number) {
   212→    super(
   213→      `Iteration timed out after ${timeoutMinutes} minute${timeoutMinutes === 1 ? "" : "s"}`,
   214→    );
   215→    this.name = "IterationTimeoutError";
   216→  }
   217→}
   218→
   219→export function pushRecentTaskRef(
   220→  recentTaskRefs: string[],
   221→  ref: string,
   222→  limit = RECENT_TASK_REF_LIMIT,
   223→): void {
   224→  const existingIndex = recentTaskRefs.indexOf(ref);
   225→  if (existingIndex !== -1) {
   226→    recentTaskRefs.splice(existingIndex, 1);
   227→  }
   228→  recentTaskRefs.push(ref);
   229→  if (recentTaskRefs.length > limit) {
   230→    recentTaskRefs.splice(0, recentTaskRefs.length - limit);
   231→  }
   232→}
   233→
   234→export function createSessionUpdateLogger(
   235→  acpSessionId: string,
   236→  iteration: number,
   237→  logUpdate: (
   238→    iteration: number,
   239→    update: SessionUpdate,
   240→  ) => Promise<void> | void,
   241→): (sessionId: string, update: SessionUpdate) => void {
   242→  const queue: SessionUpdate[] = [];
   243→  let draining = false;
   244→
   245→  const drainQueue = async (): Promise<void> => {
   246→    if (draining) {
   247→      return;
   248→    }
   249→    draining = true;
   250→    try {
   251→      while (queue.length > 0) {
   252→        const nextUpdate = queue.shift();
   253→        if (!nextUpdate) {
   254→          continue;
   255→        }
   256→        try {
   257→          await logUpdate(iteration, nextUpdate);
   258→        } catch {
   259→          // Ignore logging errors during streaming
   260→        }
   261→      }
   262→    } finally {
   263→      draining = false;
   264→      if (queue.length > 0) {
   265→        void drainQueue();
   266→      }
   267→    }
   268→  };
   269→
   270→  return (sessionId: string, update: SessionUpdate) => {
   271→    if (sessionId !== acpSessionId) {
   272→      return;
   273→    }
   274→    if (queue.length >= MAX_SESSION_UPDATE_QUEUE) {
   275→      queue.shift();
   276→    }
   277→    queue.push(update);
   278→    void drainQueue();
   279→  };
   280→}
   281→
   282→type SessionUpdateLogger = (sessionId: string, update: SessionUpdate) => void;
   283→type SessionUpdateLoggerClient = {
   284→  on(event: "update", listener: SessionUpdateLogger): unknown;
   285→  off(event: "update", listener: SessionUpdateLogger): unknown;
   286→};
   287→
   288→export function replaceSessionUpdateLogger(
   289→  client: SessionUpdateLoggerClient,
   290→  currentLogger: SessionUpdateLogger | null,
   291→  nextLogger: SessionUpdateLogger | null,
   292→): SessionUpdateLogger | null {
   293→  if (currentLogger) {
   294→    client.off("update", currentLogger);
   295→  }
   296→  if (nextLogger) {
   297→    client.on("update", nextLogger);
   298→  }
   299→  return nextLogger;
   300→}
   301→
   302→export function disposeSpawnedAgent(spawned: SpawnedAgentLike | null): null {
   303→  if (!spawned) {
   304→    return null;
   305→  }
   306→  // Remove callbacks first so captured loop state can be garbage-collected.
   307→  spawned.client.removeAllListeners();
   308→  spawned.kill();
   309→  if (!spawned.client.isClosed()) {
   310→    spawned.client.close();
   311→  }
   312→  return null;
   313→}
   314→
   315→/**
   316→ * Map adapter IDs to prompt rendering platforms.
   317→ */
   318→export function getPromptPlatformForAdapter(adapterId: string): RalphPromptPlatform {
   319→  switch (adapterId) {
   320→    case "claude-agent-acp":
   321→    case "claude-code-acp":
   322→      return "claude-code";
   323→    case "codex-acp":
   324→      return "codex";
   325→    default:
   326→      return "unknown";
   327→  }
   328→}
   329→
   330→/**
   331→ * Build skill origin map from meta skills.
   332→ */
   333→async function loadSkillOriginsForRalph(ctx: KspecContext): Promise<Map<string, SkillOrigin>> {
   334→  const meta = await loadMetaContext(ctx);
   335→  const origins = new Map<string, SkillOrigin>();
   336→  for (const skill of meta.skills) {
   337→    origins.set(skill.id, skill.origin);
   338→  }
   339→  // Fallback for core skills frequently used by ralph, even if core skills
   340→  // were not loaded into project meta for any reason.
   341→  for (const coreSkill of FALLBACK_CORE_SKILLS) {
   342→    if (!origins.has(coreSkill)) {
   343→      origins.set(coreSkill, "core");
   344→    }
   345→  }
   346→  return origins;
   347→}
   348→
   349→/**
   350→ * Normalize legacy literal invocation syntax for a target platform.
   351→ * Keeps backward compatibility for existing slash-style config values.
   352→ */
   353→function normalizeLegacyInvocation(
   354→  invocation: string,
   355→  platform: RalphPromptPlatform,
   356→): string {
   357→  if (platform === "codex") {
   358→    if (/^\/kspec:([a-z0-9][a-z0-9-]*)$/.test(invocation)) {
   359→      return invocation.replace(
   360→        /^\/kspec:([a-z0-9][a-z0-9-]*)$/,
   361→        (_m, skillId: string) => `$kspec-${skillId}`,
   362→      );
   363→    }
   364→    if (/^\/([a-z0-9][a-z0-9-]*)$/.test(invocation)) {
   365→      return invocation.replace(
   366→        /^\/([a-z0-9][a-z0-9-]*)$/,
   367→        (_m, skillId: string) => `$${skillId}`,
   368→      );
   369→    }
   370→  }
   371→
   372→  if (platform === "claude-code") {
   373→    if (/^\$kspec-([a-z0-9][a-z0-9-]*)$/.test(invocation)) {
   374→      return invocation.replace(
   375→        /^\$kspec-([a-z0-9][a-z0-9-]*)$/,
   376→        (_m, skillId: string) => `/kspec:${skillId}`,
   377→      );
   378→    }
   379→    if (/^\$([a-z0-9][a-z0-9-]*)$/.test(invocation)) {
   380→      return invocation.replace(
   381→        /^\$([a-z0-9][a-z0-9-]*)$/,
   382→        (_m, skillId: string) => `/${skillId}`,
   383→      );
   384→    }
   385→  }
   386→
   387→  return invocation;
   388→}
   389→
   390→/**
   391→ * Resolve configured skill invocation string for a specific platform.
   392→ * Supports portable {skill:<id>} syntax and legacy literal strings.
   393→ */
   394→export function resolveRalphSkillInvocation(
   395→  invocation: string,
   396→  platform: RalphPromptPlatform,
   397→  skillOrigins: Map<string, SkillOrigin>,
   398→): string {
   399→  if (platform === "unknown") {
   400→    return invocation;
   401→  }
   402→
   403→  const tokenResolved = resolveSkillReferenceTokensForPlatform(
   404→    invocation,
   405→    platform,
   406→    skillOrigins,
   407→  );
   408→  if (tokenResolved !== invocation) {
   409→    return tokenResolved;
   410→  }
   411→
   412→  return normalizeLegacyInvocation(invocation, platform);
   413→}
   414→
   415→// AC: @ralph-skill-delegation ac-1, ac-2, ac-3
   416→function buildTaskWorkPrompt(
   417→  sessionCtx: SessionStartContext,
   418→  iteration: number,
   419→  maxLoops: number,
   420→  sessionId: string,
   421→  skillTaskWork: string,
   422→  focus?: string,
   423→  explicitTaskScope?: ExplicitTaskScope,
   424→): string {
   425→  const focusSection = focus
   426→    ? `
   427→## Session Focus (applies to ALL iterations)
   428→
   429→> **${focus}**
   430→
   431→Keep this focus in mind throughout your work. It takes priority over default task selection.
   432→`
   433→    : "";
   434→
   435→  // AC: @cli-ralph ac-21 - Explicit task scope indicator in prompt
   436→  const taskScopeSection = explicitTaskScope
   437→    ? `
   438→## Explicit Task Scope
   439→
   440→This session is scoped to specific tasks: ${explicitTaskScope.refs.join(", ")}
   441→
   442→**Only work on these tasks.** The loop will exit when all listed tasks are completed or blocked.
   443→`
   444→    : "";
   445→
   446→  const modeDescription = explicitTaskScope
   447→    ? "Loop mode means: no confirmations, auto-resolve decisions, explicit task scope (only the listed tasks)."
   448→    : "Loop mode means: no confirmations, auto-resolve decisions, automation-eligible tasks only.";
   449→
   450→  const stateSection = formatJsonSection(
   451→    sessionCtx as unknown as Record<string, unknown>,
   452→    "Current State",
   453→    `kspec session start --json`,
   454→  );
   455→  const sections: PromptSection[] = [stateSection.section];
   456→
   457→  const prompt = `# Kspec Automation Session - Task Work
   458→
   459→**Session ID:** \`${sessionId}\`
   460→**Iteration:** ${iteration} of ${maxLoops}
   461→**Mode:** Automated (no human in the loop)
   462→${focusSection}${taskScopeSection}
   463→
   464→${stateSection.text}
   465→
   466→## Instructions
   467→
   468→Run the task-work skill in loop mode:
   469→
   470→\`\`\`
   471→${skillTaskWork} loop
   472→\`\`\`
   473→
   474→${modeDescription}
   475→
   476→**Normal flow:** Work on a task, create a PR, then stop responding. Ralph continues automatically —
   477→it checks for remaining eligible tasks at the start of each iteration and exits the loop itself when none remain.
   478→
   479→**Do NOT call \`end-loop\` after completing a task.** Simply stop responding.
   480→\`end-loop\` is a rare escape hatch for when work is stalling across multiple iterations with no progress — not a normal exit path.
   481→`;
   482→
   483→  return truncatePromptIfNeeded(prompt, sections, WORKER_PROMPT_MAX_BYTES);
   484→}
   485→
   486→/**
   487→ * Build the reflect prompt sent after task-work completes.
   488→ * Ralph sends this as a separate prompt to ensure reflection always happens.
   489→ */
   490→function buildReflectPrompt(
   491→  iteration: number,
   492→  maxLoops: number,
   493→  sessionId: string,
   494→  skillReflect: string,
   495→): string {
   496→  const isFinal = iteration === maxLoops;
   497→
   498→  return `# Kspec Automation Session - Reflection
   499→
   500→**Session ID:** \`${sessionId}\`
   501→**Iteration:** ${iteration} of ${maxLoops}
   502→**Phase:** Post-task reflection
   503→
   504→## Instructions
   505→
   506→Run the reflect skill in loop mode:
   507→
   508→\`\`\`
   509→${skillReflect} loop
   510→\`\`\`
   511→
   512→Loop mode means: high-confidence captures only, must search existing before capturing, no user prompts.
   513→${
   514→  isFinal
   515→    ? `
   516→**FINAL ITERATION** - This is the last chance to capture insights from this session.
   517→`
   518→    : ""
   519→}
   520→Exit when reflection is complete.
   521→`;
   522→}
   523→
   524→// ─── Streaming Output ────────────────────────────────────────────────────────
   525→
   526→// Translator and renderer are created per-session in the action handler.
   527→// This allows the architecture to be reused by future TUI renderers.
   528→
   529→// ─── Adapter Validation ──────────────────────────────────────────────────────
   530→
   531→// AC: @ralph-adapter-validation valid-adapter-proceeds, invalid-adapter-error, validation-before-spawn
   532→type AdapterValidationRunner = (
   533→  command: string,
   534→  args: string[],
   535→  options: { encoding: "utf-8"; stdio: "pipe" },
   536→) => { status: number | null };
   537→
   538→/**
   539→ * Check whether an adapter package appears to be installed and executable.
   540→ * Uses multiple non-installing probes because CLIs differ on supported flags.
   541→ */
   542→export function isAdapterPackageAvailable(
   543→  adapterPackage: string,
   544→  runner: AdapterValidationRunner = spawnSync,
   545→): boolean {
   546→  for (const probeArgs of ADAPTER_VALIDATION_PROBES) {
   547→    const result = runner(
   548→      "npx",
   549→      ["--no-install", adapterPackage, ...probeArgs],
   550→      {
   551→        encoding: "utf-8",
   552→        stdio: "pipe",
   553→      },
   554→    );
   555→
   556→    if (result.status === 0) {
   557→      return true;
   558→    }
   559→  }
   560→
   561→  return false;
   562→}
   563→
   564→/**
   565→ * Validate that the specified ACP adapter package exists.
   566→ * Uses npx --no-install probes to check both global and local node_modules.
   567→ *
   568→ * @throws {Error} Never throws - exits process with code 3 if validation fails
   569→ */
   570→function validateAdapter(adapterPackage: string, adapterId?: string): void {
   571→  if (!isAdapterPackageAvailable(adapterPackage)) {
   572→    const label =
   573→      adapterId && adapterId !== adapterPackage
   574→        ? `${adapterId} (${adapterPackage})`
   575→        : adapterPackage;
   576→    error(
   577→      `Adapter not found: ${label}. Install with: npm install -g ${adapterPackage}`,
   578→    );
   579→    process.exit(EXIT_CODES.NOT_FOUND);
   580→  }
   581→}
   582→
   583→interface HandleRequestOptions {
   584→  yolo: boolean;
   585→  specDir?: string;
   586→  sessionId?: string;
   587→}
   588→
   589→interface TerminalRunResult {
   590→  stdout: string;
   591→  stderr: string;
   592→  exitCode: number;
   593→  stdout_path?: string;
   594→  stderr_path?: string;
   595→  stdout_bytes: number;
   596→  stderr_bytes: number;
   597→  preview_truncated: boolean;
   598→}
   599→
   600→interface TerminalRunOptions {
   601→  command: string;
   602→  cwd: string;
   603→  timeout: number;
   604→  toolCallId: string | number;
   605→  specDir?: string;
   606→  sessionId?: string;
   607→  previewMaxBytes?: number;
   608→}
   609→
   610→interface StreamCaptureState {
   611→  bytes: number;
   612→  previewBytes: number;
   613→  previewParts: string[];
   614→  truncated: boolean;
   615→  stream?: WriteStream;
   616→}
   617→
   618→function sanitizeToolCallId(toolCallId: string | number): string {
   619→  const raw = String(toolCallId).trim();
   620→  if (!raw) {
   621→    return "tool-call";
   622→  }
   623→
   624→  return raw.replace(/[^a-zA-Z0-9._-]/g, "_");
   625→}
   626→
   627→function updateStreamPreview(
   628→  state: StreamCaptureState,
   629→  chunk: Buffer,
   630→  maxPreviewBytes: number,
   631→): void {
   632→  state.bytes += chunk.length;
   633→  const remaining = maxPreviewBytes - state.previewBytes;
   634→
   635→  if (remaining <= 0) {
   636→    state.truncated = true;
   637→    return;
   638→  }
   639→
   640→  if (chunk.length > remaining) {
   641→    state.previewParts.push(chunk.subarray(0, remaining).toString("utf-8"));
   642→    state.previewBytes += remaining;
   643→    state.truncated = true;
   644→    return;
   645→  }
   646→
   647→  state.previewParts.push(chunk.toString("utf-8"));
   648→  state.previewBytes += chunk.length;
   649→}
   650→
   651→function closeStream(stream?: WriteStream): Promise<void> {
   652→  if (!stream) {
   653→    return Promise.resolve();
   654→  }
   655→
   656→  return new Promise((resolve, reject) => {
   657→    const onError = (err: Error) => {
   658→      stream.off("finish", onFinish);
   659→      reject(err);
   660→    };
   661→    const onFinish = () => {
   662→      stream.off("error", onError);
   663→      resolve();
   664→    };
   665→
   666→    stream.once("error", onError);
   667→    stream.once("finish", onFinish);
   668→    stream.end();
   669→  });
   670→}
   671→
   672→/**
   673→ * Execute terminal/run request with bounded in-memory preview and streamed
   674→ * session artifacts for full stdout/stderr retention.
   675→ */
   676→export async function runTerminalCommandWithArtifacts(
   677→  options: TerminalRunOptions,
   678→): Promise<TerminalRunResult> {
   679→  const previewMaxBytes = options.previewMaxBytes ?? TERMINAL_PREVIEW_MAX_BYTES;
   680→  const shouldWriteArtifacts = Boolean(options.specDir && options.sessionId);
   681→
   682→  let stdoutPath: string | undefined;
   683→  let stderrPath: string | undefined;
   684→  if (shouldWriteArtifacts) {
   685→    const outputDir = path.join(
   686→      getSessionDir(options.specDir!, options.sessionId!),
   687→      TOOL_OUTPUT_DIR,
   688→    );
   689→    await fs.mkdir(outputDir, { recursive: true });
   690→    const safeToolCallId = sanitizeToolCallId(options.toolCallId);
   691→    stdoutPath = path.join(outputDir, `${safeToolCallId}.stdout.log`);
   692→    stderrPath = path.join(outputDir, `${safeToolCallId}.stderr.log`);
   693→  }
   694→
   695→  const stdoutState: StreamCaptureState = {
   696→    bytes: 0,
   697→    previewBytes: 0,
   698→    previewParts: [],
   699→    truncated: false,
   700→    stream: stdoutPath ? createWriteStream(stdoutPath) : undefined,
   701→  };
   702→  const stderrState: StreamCaptureState = {
   703→    bytes: 0,
   704→    previewBytes: 0,
   705→    previewParts: [],
   706→    truncated: false,
   707→    stream: stderrPath ? createWriteStream(stderrPath) : undefined,
   708→  };
   709→
   710→  return await new Promise<TerminalRunResult>((resolve, reject) => {
   711→    let settled = false;
   712→    const child = spawn(options.command, [], {
   713→      cwd: options.cwd,
   714→      shell: true,
   715→      timeout: options.timeout,
   716→    });
   717→
   718→    const finalize = async (
   719→      exitCode: number,
   720→      errorMessage?: string,
   721→    ): Promise<void> => {
   722→      if (settled) {
   723→        return;
   724→      }
   725→      settled = true;
   726→
   727→      if (errorMessage) {
   728→        const errChunk = Buffer.from(errorMessage, "utf-8");
   729→        stderrState.stream?.write(errChunk);
   730→        updateStreamPreview(stderrState, errChunk, previewMaxBytes);
   731→      }
   732→
   733→      try {
   734→        await Promise.all([
   735→          closeStream(stdoutState.stream),
   736→          closeStream(stderrState.stream),
   737→        ]);
   738→      } catch (streamErr) {
   739→        reject(streamErr);
   740→        return;
   741→      }
   742→
   743→      resolve({
   744→        stdout: stdoutState.previewParts.join(""),
   745→        stderr: stderrState.previewParts.join(""),
   746→        exitCode,
   747→        stdout_path: stdoutPath,
   748→        stderr_path: stderrPath,
   749→        stdout_bytes: stdoutState.bytes,
   750→        stderr_bytes: stderrState.bytes,
   751→        preview_truncated: stdoutState.truncated || stderrState.truncated,
   752→      });
   753→    };
   754→
   755→    child.stdout?.on("data", (data) => {
   756→      const chunk = Buffer.isBuffer(data)
   757→        ? data
   758→        : Buffer.from(String(data), "utf-8");
   759→      stdoutState.stream?.write(chunk);
   760→      updateStreamPreview(stdoutState, chunk, previewMaxBytes);
   761→    });
   762→
   763→    child.stderr?.on("data", (data) => {
   764→      const chunk = Buffer.isBuffer(data)
   765→        ? data
   766→        : Buffer.from(String(data), "utf-8");
   767→      stderrState.stream?.write(chunk);
   768→      updateStreamPreview(stderrState, chunk, previewMaxBytes);
   769→    });
   770→
   771→    child.on("close", (code) => {
   772→      void finalize(code ?? 1);
   773→    });
   774→
   775→    child.on("error", (err) => {
   776→      void finalize(1, err.message);
   777→    });
   778→  });
   779→}
   780→
   781→// ─── Tool Request Handler ────────────────────────────────────────────────────
   782→
   783→/**
   784→ * Handle tool requests from ACP agent.
   785→ * Implements file operations, terminal commands, and permission handling.
   786→ */
   787→async function handleRequest(
   788→  client: ACPClient,
   789→  id: string | number,
   790→  method: string,
   791→  params: unknown,
   792→  options: HandleRequestOptions,
   793→): Promise<void> {
   794→  try {
   795→    switch (method) {
   796→      case "session/request_permission": {
   797→        const p = params as RequestPermissionRequest;
   798→        // In yolo mode, auto-approve all permissions
   799→        // In normal mode, would need to implement permission UI
   800→        const permissionOptions = p.options || [];
   801→
   802→        if (options.yolo) {
   803→          // Find an "allow" option (prefer allow_always, then allow_once)
   804→          const allowOption =
   805→            permissionOptions.find((o) => o.kind === "allow_always") ||
   806→            permissionOptions.find((o) => o.kind === "allow_once");
   807→
   808→          if (allowOption) {
   809→            client.respondPermission(id, {
   810→              outcome: { outcome: "selected", optionId: allowOption.optionId },
   811→            });
   812→          } else {
   813→            // No allow option available - cancel
   814→            client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   815→          }
   816→        } else {
   817→          // TODO: Implement permission prompting
   818→          client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   819→        }
   820→        break;
   821→      }
   822→
   823→      case "file/read": {
   824→        const p = params as ReadTextFileRequest;
   825→        const content = await fs.readFile(p.path, "utf-8");
   826→        client.respondReadTextFile(id, { content });
   827→        break;
   828→      }
   829→
   830→      case "file/write": {
   831→        const p = params as WriteTextFileRequest;
   832→        await fs.mkdir(path.dirname(p.path), { recursive: true });
   833→        await fs.writeFile(p.path, p.content, "utf-8");
   834→        client.respondWriteTextFile(id, {});
   835→        break;
   836→      }
   837→
   838→      case "terminal/run": {
   839→        // Custom method (not part of ACP spec - ACP uses createTerminal instead)
   840→        // TODO: Consider migrating to standard ACP terminal methods
   841→        const p = params as {
   842→          command: string;
   843→          cwd?: string;
   844→          timeout?: number;
   845→        };
   846→        const command = p.command;
   847→        const cwd = p.cwd || process.cwd();
   848→        const timeout = p.timeout || 60000;
   849→
   850→        const result = await runTerminalCommandWithArtifacts({
   851→          command,
   852→          cwd,
   853→          timeout,
   854→          toolCallId: id,
   855→          specDir: options.specDir,
   856→          sessionId: options.sessionId,
   857→        });
   858→
   859→        // Using generic respond() since this is a custom method
   860→        client.respond(id, result);
   861→        break;
   862→      }
   863→
   864→      default:
   865→        // Unknown method - return error
   866→        client.respondError(id, -32601, `Method not found: ${method}`);
   867→    }
   868→  } catch (err) {
   869→    const message = err instanceof Error ? err.message : String(err);
   870→    client.respondError(id, -32000, message);
   871→  }
   872→}
   873→
   874→// ─── Subagent Support ─────────────────────────────────────────────────────────
   875→
   876→/**
   877→ * Build context for a PR review subagent.
   878→ * AC: @ralph-subagent-spawning ac-10
   879→ */
   880→async function buildSubagentContext(
   881→  ctx: KspecContext,
   882→  taskRef: string,
   883→): Promise<SubagentContext> {
   884→  // Load all tasks and items
   885→  const tasks = await loadAllTasks(ctx);
   886→  const items = await loadAllItems(ctx);
   887→  const index = new ReferenceIndex(tasks, items);
   888→
   889→  // Resolve task reference
   890→  const taskResult = index.resolve(taskRef);
   891→  if (!taskResult.ok) {
   892→    throw new Error(`Task not found: ${taskRef}`);
   893→  }
   894→
   895→  const task = tasks.find((t) => t._ulid === taskResult.ulid);
   896→  if (!task) {
   897→    throw new Error(`Task not found by ULID: ${taskResult.ulid}`);
   898→  }
   899→
   900→  // Get linked spec with ACs if spec_ref exists
   901→  let specWithACs: Record<string, unknown> | null = null;
   902→  if (task.spec_ref) {
   903→    const specResult = index.resolve(task.spec_ref);
   904→    if (specResult.ok) {
   905→      const item = items.find((i) => i._ulid === specResult.ulid);
   906→      if (item) {
   907→        specWithACs = item as unknown as Record<string, unknown>;
   908→      }
   909→    }
   910→  }
   911→
   912→  // Get git branch
   913→  const gitBranch = getCurrentBranch(ctx.rootDir) || "unknown";
   914→
   915→  return {
   916→    taskRef,
   917→    taskDetails: task as unknown as Record<string, unknown>,
   918→    specWithACs,
   919→    gitBranch,
   920→  };
   921→}
   922→
   923→/**
   924→ * Get the current status of a task.
   925→ * AC: @ralph-subagent-spawning ac-12
   926→ */
   927→function runKspecCli(args: string[]) {
   928→  const cliPath = process.env.KSPEC_CLI_PATH || DEFAULT_KSPEC_CLI_PATH;
   929→  return spawnSync(process.execPath, [cliPath, ...args], {
   930→    encoding: "utf-8",
   931→    stdio: "pipe",
   932→    cwd: process.cwd(),
   933→  });
   934→}
   935→
   936→function getTaskStatus(taskRef: string): string | null {
   937→  const result = runKspecCli(["task", "get", taskRef, "--json"]);
   938→
   939→  if (result.status !== 0) {
   940→    warn(`Failed to check task status for ${taskRef}: ${result.stderr}`);
   941→    return null;
   942→  }
   943→
   944→  try {
   945→    return JSON.parse(result.stdout).status;
   946→  } catch {
   947→    warn(`Failed to parse task status for ${taskRef}`);
   948→    return null;
   949→  }
   950→}
   951→
   952→/**
   953→ * Mark a task as needing review due to subagent timeout.
   954→ * AC: @ralph-subagent-spawning ac-9
   955→ */
   956→async function markTaskNeedsReview(
   957→  taskRef: string,
   958→  reason: string,
   959→): Promise<void> {
   960→  // Use kspec CLI to set automation status
   961→  const result = runKspecCli(
   962→    ["task", "set", taskRef, "--automation", "needs_review", "--reason", reason],
   963→  );
   964→
   965→  if (result.status !== 0) {
   966→    warn(`Failed to mark task ${taskRef} as needs_review: ${result.stderr}`);
   967→  }
   968→
   969→  // Add a note explaining the timeout
   970→  const noteResult = runKspecCli(
   971→    ["task", "note", taskRef, `[RALPH SUBAGENT] ${reason}`],
   972→  );
   973→
   974→  if (noteResult.status !== 0) {
   975→    warn(`Failed to add timeout note to task ${taskRef}: ${noteResult.stderr}`);
   976→  }
   977→}
   978→
   979→/**
   980→ * Post a comment on the open PR for a task's branch, noting incomplete review.
   981→ * Uses `gh pr list --head <branch>` to find the PR and add a warning.
   982→ */
   983→async function commentOnPRReviewIncomplete(branch: string, reason: string): Promise<void> {
   984→  if (!branch || branch === "unknown") {
   985→    return;
   986→  }
   987→
   988→  const prListResult = spawnSync(
   989→    "gh",
   990→    ["pr", "list", "--state", "open", "--head", branch, "--json", "number", "--jq", ".[0].number"],
   991→    { encoding: "utf-8", stdio: "pipe" },
   992→  );
   993→
   994→  const prNumber = prListResult.stdout?.trim();
   995→  if (!prNumber || prListResult.status !== 0) {
   996→    // No open PR found — may already be merged or branch has no PR
   997→    return;
   998→  }
   999→
  1000→  const body = `⚠️ **Review incomplete**: ${reason}\n\nThis PR was not fully reviewed by the ralph review subagent. Manual review recommended before merging.`;
  1001→  const commentResult = spawnSync(
  1002→    "gh",
  1003→    ["pr", "comment", prNumber, "--body", body],
  1004→    { encoding: "utf-8", stdio: "pipe" },
  1005→  );
  1006→
  1007→  if (commentResult.status !== 0) {
  1008→    warn(`Failed to comment on PR #${prNumber}: ${commentResult.stderr}`);
  1009→  } else {
  1010→    info(`${DEFAULT_SUBAGENT_PREFIX} Posted review-incomplete comment on PR #${prNumber}`);
  1011→  }
  1012→}
  1013→
  1014→/**
  1015→ * Handle failed iteration by tracking per-task failures and escalating at threshold.
  1016→ * AC: @loop-mode-error-handling ac-1, ac-2, ac-3, ac-4, ac-5, ac-8
  1017→ */
  1018→async function handleIterationFailure(
  1019→  ctx: KspecContext,
  1020→  tasksInProgressAtStart: ActiveTaskSummary[],
  1021→  iterationStartTime: Date,
  1022→  errorDescription: string,
  1023→): Promise<void> {
  1024→  if (tasksInProgressAtStart.length === 0) {
  1025→    return;
  1026→  }
  1027→
  1028→  // Re-load current tasks to check progress
  1029→  const currentTasks = await loadAllTasks(ctx);
  1030→  const index = new ReferenceIndex(currentTasks, await loadAllItems(ctx));
  1031→
  1032→  // Convert ActiveTaskSummary to Task-like objects for processing
  1033→  const tasksInProgressFull = tasksInProgressAtStart
  1034→    .map((summary) => {
  1035→      const resolved = index.resolve(summary.ref);
  1036→      if (!resolved.ok) return undefined;
  1037→      // Check if the resolved item is a task (not a spec item or meta item)
  1038→      const item = resolved.item;
  1039→      if (!("status" in item)) return undefined; // Spec items don't have status
  1040→      return currentTasks.find((t) => t._ulid === resolved.ulid);
  1041→    })
  1042→    .filter((t): t is LoadedTask => t !== undefined && t.status === "in_progress");
  1043→
  1044→  if (tasksInProgressFull.length === 0) {
  1045→    return;
  1046→  }
  1047→
  1048→  // Process failures
  1049→  const { processFailedIteration, createFailureNote, getTaskFailureCount } = await import("../../ralph/index.js");
  1050→
  1051→  const results = processFailedIteration(
  1052→    tasksInProgressFull,
  1053→    currentTasks,
  1054→    iterationStartTime,
  1055→    errorDescription,
  1056→  );
  1057→
  1058→  // Add notes and escalate tasks
  1059→  for (const result of results) {
  1060→    const taskRef = result.taskRef;
  1061→    const task = currentTasks.find((t) => t._ulid === taskRef);
  1062→    if (!task) continue;
  1063→
  1064→    const priorCount = result.failureCount - 1;
  1065→    const noteContent = createFailureNote(taskRef, errorDescription, priorCount);
  1066→
  1067→    // Add LOOP-FAIL note
  1068→    const noteResult = spawnSync(
  1069→      "kspec",
  1070→      ["task", "note", `@${taskRef}`, noteContent],
  1071→      {
  1072→        encoding: "utf-8",
  1073→        stdio: "pipe",
  1074→        cwd: process.cwd(),
  1075→      },
  1076→    );
  1077→
  1078→    if (noteResult.status !== 0) {
  1079→      warn(`Failed to add failure note to task ${taskRef}: ${noteResult.stderr}`);
  1080→      continue;
  1081→    }
  1082→
  1083→    // AC: @loop-mode-error-handling ac-5 - Escalate at threshold
  1084→    if (result.escalated) {
  1085→      const escalateResult = spawnSync(
  1086→        "kspec",
  1087→        [
  1088→          "task",
  1089→          "set",
  1090→          `@${taskRef}`,
  1091→          "--automation",
  1092→          "needs_review",
  1093→          "--reason",
  1094→          `Loop mode: 3 consecutive failures without progress`,
  1095→        ],
  1096→        {
  1097→          encoding: "utf-8",
  1098→          stdio: "pipe",
  1099→          cwd: process.cwd(),
  1100→        },
  1101→      );
  1102→
  1103→      if (escalateResult.status !== 0) {
  1104→        warn(`Failed to escalate task ${taskRef}: ${escalateResult.stderr}`);
  1105→      } else {
  1106→        info(`Escalated task ${taskRef} to automation:needs_review after 3 failures`);
  1107→      }
  1108→    }
  1109→  }
  1110→}
  1111→
  1112→/**
  1113→ * Process pending_review tasks by spawning subagents.
  1114→ * AC: @ralph-subagent-spawning ac-6, ac-8
  1115→ */
  1116→async function processPendingReviewTasks(
  1117→  ctx: KspecContext,
  1118→  adapter: AgentAdapter,
  1119→  pendingReviewTasks: ActiveTaskSummary[],
  1120→  options: {
  1121→    yolo: boolean;
  1122→    specDir: string;
  1123→    sessionId: string;
  1124→    maxRetries: number;
  1125→    maxFailures: number;
  1126→    cwd: string;
  1127→    subagentTimeout: number;
  1128→    autoApproveArgs?: string[];
  1129→    prReviewSkillName: string;
  1130→  },
  1131→  consecutiveFailures: { count: number },
  1132→): Promise<boolean> {
  1133→  if (pendingReviewTasks.length === 0) {
  1134→    return true;
  1135→  }
  1136→
  1137→  // Visual separator for subagent section
  1138→  console.log("");
  1139→  console.log(chalk.cyan(`${"═".repeat(60)}`));
  1140→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Processing Pending Review Tasks`));
  1141→  console.log(chalk.cyan(`${"═".repeat(60)}`));
  1142→  console.log("");
  1143→
  1144→  info(
  1145→    `${DEFAULT_SUBAGENT_PREFIX} Found ${pendingReviewTasks.length} pending_review task(s)`,
  1146→  );
  1147→
  1148→  // AC: @ralph-subagent-spawning ac-6 - Process one at a time
  1149→  for (const task of pendingReviewTasks) {
  1150→    info(`${DEFAULT_SUBAGENT_PREFIX} Processing: ${task.ref} - ${task.title}`);
  1151→
  1152→    try {
  1153→      // Build context for this task
  1154→      const subagentCtx = await buildSubagentContext(ctx, task.ref);
  1155→
  1156→      // AC: @ralph-subagent-spawning ac-1, ac-3 - Spawn and wait
  1157→      const result = await runSubagent(
  1158→        adapter,
  1159→        subagentCtx,
  1160→        {
  1161→          timeout: options.subagentTimeout,
  1162→          outputPrefix: DEFAULT_SUBAGENT_PREFIX,
  1163→          skillName: options.prReviewSkillName,
  1164→        },
  1165→        {
  1166→          yolo: options.yolo,
  1167→          cwd: options.cwd,
  1168→          extraArgs: options.autoApproveArgs,
  1169→          handleRequest: (client, reqId, method, params) =>
  1170→            handleRequest(client, reqId, method, params, {
  1171→              yolo: options.yolo,
  1172→              specDir: options.specDir,
  1173→              sessionId: options.sessionId,
  1174→            }),
  1175→        },
  1176→      );
  1177→
  1178→      if (result.timedOut) {
  1179→        // AC: @ralph-subagent-spawning ac-9
  1180→        warn(
  1181→          `${DEFAULT_SUBAGENT_PREFIX} Subagent timed out for ${task.ref}`,
  1182→        );
  1183→        const timeoutMinutes = Math.round(options.subagentTimeout / 60000);
  1184→        await markTaskNeedsReview(
  1185→          task.ref,
  1186→          `Subagent timed out after ${timeoutMinutes} minutes`,
  1187→        );
  1188→        await commentOnPRReviewIncomplete(subagentCtx.gitBranch, `Review subagent timed out after ${timeoutMinutes} minutes for task ${task.ref}.`);
  1189→        consecutiveFailures.count++;
  1190→      } else if (!result.success) {
  1191→        // AC: @ralph-subagent-spawning ac-7
  1192→        error(
  1193→          `${DEFAULT_SUBAGENT_PREFIX} Subagent failed for ${task.ref}: ${result.error}`,
  1194→        );
  1195→        await commentOnPRReviewIncomplete(subagentCtx.gitBranch, `Review subagent failed for task ${task.ref}: ${result.error}`);
  1196→        consecutiveFailures.count++;
  1197→      } else {
  1198→        // AC: @ralph-subagent-spawning ac-12 - Verify task outcome
  1199→        const currentStatus = getTaskStatus(task.ref);
  1200→
  1201→        if (currentStatus === "completed") {
  1202→          success(`${DEFAULT_SUBAGENT_PREFIX} Completed: ${task.ref}`);
  1203→          consecutiveFailures.count = 0;
  1204→        } else if (currentStatus === "needs_work") {
  1205→          // Expected: reviewer found issues, kicked back to worker
  1206→          info(`${DEFAULT_SUBAGENT_PREFIX} Review completed for ${task.ref} — issues found, kicked back to worker`);
  1207→          // NOT a failure — the review worked correctly
  1208→          consecutiveFailures.count = 0;
  1209→        } else if (currentStatus === "pending_review") {
  1210→          // Subagent didn't transition or merge — count as soft failure
  1211→          warn(
  1212→            `${DEFAULT_SUBAGENT_PREFIX} Subagent completed but task ${task.ref} unchanged`,
  1213→          );
  1214→          await markTaskNeedsReview(
  1215→            task.ref,
  1216→            "Subagent completed but did not merge or kick back. Review required.",
  1217→          );
  1218→          consecutiveFailures.count++;
  1219→        } else {
  1220→          warn(`${DEFAULT_SUBAGENT_PREFIX} Task ${task.ref} in unexpected state: ${currentStatus}`);
  1221→          consecutiveFailures.count++;
  1222→        }
  1223→      }
  1224→
  1225→      // Check if we've hit max failures
  1226→      if (consecutiveFailures.count >= options.maxFailures) {
  1227→        error(
  1228→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
  1229→        );
  1230→        return false;
  1231→      }
  1232→    } catch (err) {
  1233→      const message = err instanceof Error ? err.message : String(err);
  1234→      error(`${DEFAULT_SUBAGENT_PREFIX} Error processing ${task.ref}: ${message}`);
  1235→      consecutiveFailures.count++;
  1236→
  1237→      if (consecutiveFailures.count >= options.maxFailures) {
  1238→        error(
  1239→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
  1240→        );
  1241→        return false;
  1242→      }
  1243→    }
  1244→  }
  1245→
  1246→  // Visual separator at end of subagent section
  1247→  console.log("");
  1248→  console.log(chalk.cyan(`${"═".repeat(60)}`));
  1249→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Completed Review Processing`));
  1250→  console.log(chalk.cyan(`${"═".repeat(60)}`));
  1251→  console.log("");
  1252→
  1253→  return true;
  1254→}
  1255→
  1256→// ─── Command Registration ────────────────────────────────────────────────────
  1257→
  1258→export function registerRalphCommand(program: Command): void {
  1259→  const ralph = program
  1260→    .command("ralph")
  1261→    .description("Ralph automated task loop and agent control");
  1262→
  1263→  // end-loop subcommand - allows agent to signal loop termination
  1264→  // AC: @session-end-loop-signal ac-signal
  1265→  ralph
  1266→    .command("end-loop")
  1267→    .description("End the ralph loop gracefully (stops all remaining iterations)")
  1268→    .option("--reason <reason>", "Reason for ending the loop")
  1269→    .action(async (options) => {
  1270→      try {
  1271→        const ctx = await initContext();
  1272→        const sessionId = process.env.KSPEC_SESSION_ID;
  1273→
  1274→        if (!sessionId) {
  1275→          // AC: @trait-error-guidance ac-1, ac-2
  1276→          warn("No active ralph session detected (KSPEC_SESSION_ID not set).");
  1277→          info("This command requires an active session. It is designed to be called by agents during a ralph loop.");
  1278→          info("Suggestion: Ensure KSPEC_SESSION_ID is set, or start a session with: kspec session create --agent-type ralph");
  1279→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1280→          return;
  1281→        }
  1282→
  1283→        // AC: @session-end-loop-signal ac-signal - Write end-loop state to session
  1284→        const updated = await requestEndLoop(ctx.specDir, sessionId, options.reason);
  1285→
  1286→        if (!updated) {
  1287→          // AC: @trait-error-guidance ac-1, ac-2
  1288→          error(`Session not found: ${sessionId}`);
  1289→          info("Suggestion: Check session ID with: kspec session log list");
  1290→          process.exit(EXIT_CODES.NOT_FOUND);
  1291→          return;
  1292→        }
  1293→
  1294→        success("Loop end signal sent");
  1295→        if (options.reason) {
  1296→          info(`Reason: ${options.reason}`);
  1297→        }
  1298→      } catch (err) {
  1299→        // AC: @trait-error-guidance ac-1
  1300→        error("Failed to signal end-loop", err);
  1301→        process.exit(EXIT_CODES.ERROR);
  1302→      }
  1303→    });
  1304→
  1305→  // Main ralph run command (default behavior when ralph is called directly)
  1306→  ralph
  1307→    .command("run", { isDefault: true })
  1308→    .description("Run ACP agent in a loop to process ready tasks")
  1309→    .argument("[args...]", "")
  1310→    .option("--max-loops <n>", "Maximum iterations", "5")
  1311→    .option("--max-retries <n>", "Max retries per iteration on error", "3")
  1312→    .option(
  1313→      "--max-failures <n>",
  1314→      "Max consecutive failed iterations before exit",
  1315→      "3",
  1316→    )
  1317→    .option(
  1318→      "--iteration-timeout <minutes>",
  1319→      "Max minutes per iteration attempt before aborting",
  1320→      String(DEFAULT_ITERATION_TIMEOUT_MINUTES),
  1321→    )
  1322→    .option("--dry-run", "Show prompt without executing")
  1323→    .option("--yolo", "Use dangerously-skip-permissions (default)", true)
  1324→    .option("--no-yolo", "Require normal permission prompts")
  1325→    .option("--subagent-timeout <minutes>", "Review subagent timeout in minutes", "20")
  1326→    .option("--adapter <id>", "Agent adapter to use", "claude-agent-acp")
  1327→    .option("--worker-adapter <id>", "Adapter for task-work agent (overrides --adapter)")
  1328→    .option("--reviewer-adapter <id>", "Adapter for review subagent (overrides --adapter)")
  1329→    .option("--adapter-cmd <cmd>", "Custom adapter command (for testing)")
  1330→    .option(
  1331→      "--restart-every <n>",
  1332→      "Restart agent every N iterations to prevent OOM (0 = never)",
  1333→      "10",
  1334→    )
  1335→    .option(
  1336→      "--focus <instructions>",
  1337→      "Focus instructions included in every iteration prompt",
  1338→    )
  1339→    .option(
  1340→      "--max-tasks <n>",
  1341→      "Max tasks per iteration (0 = unlimited)",
  1342→      "1",
  1343→    )
  1344→    .option(
  1345→      "--tasks <refs>",
  1346→      "Explicit task scope: only work on these tasks (comma-separated refs, e.g., @task1,@task2)",
  1347→    )
  1348→    .action(async (args: string[], options) => {
  1349→      // Check for unknown subcommands that fell through to default
  1350→      // Only check args that look like subcommand names (alphanumeric with hyphens, no quotes)
  1351→      if (args.length > 0) {
  1352→        const unknownCmd = args[0];
  1353→        // Skip if it looks like a malformed option or quoted argument
  1354→        const looksLikeSubcommand = /^[a-z][a-z0-9-]*$/i.test(unknownCmd);
  1355→        if (looksLikeSubcommand) {
  1356→          if (unknownCmd === "end-iteration") {
  1357→            error(`Unknown command: ${unknownCmd}. Did you mean 'end-loop'?`);
  1358→            info("The command was renamed from 'end-iteration' to 'end-loop' to clarify it ends the entire loop.");
  1359→          } else {
  1360→            error(`Unknown command: ${unknownCmd}`);
  1361→          }
  1362→          info("Run 'kspec ralph --help' to see available commands.");
  1363→          process.exit(EXIT_CODES.USAGE_ERROR);
  1364→        }
  1365→      }
  1366→      try {
  1367→        const maxLoops = parseInt(options.maxLoops, 10);
  1368→        const maxRetries = parseInt(options.maxRetries, 10);
  1369→        const maxFailures = parseInt(options.maxFailures, 10);
  1370→        const iterationTimeoutMinutes = Number(options.iterationTimeout);
  1371→        const iterationTimeoutMs = Math.max(
  1372→          1,
  1373→          Math.round(iterationTimeoutMinutes * 60 * 1000),
  1374→        );
  1375→
  1376→        if (Number.isNaN(maxLoops) || maxLoops < 1) {
  1377→          error(errors.usage.maxLoopsPositive);
  1378→          process.exit(EXIT_CODES.ERROR);
  1379→        }
  1380→
  1381→        if (Number.isNaN(maxRetries) || maxRetries < 0) {
  1382→          error(errors.usage.maxRetriesNonNegative);
  1383→          process.exit(EXIT_CODES.ERROR);
  1384→        }
  1385→
  1386→        if (Number.isNaN(maxFailures) || maxFailures < 1) {
  1387→          error(errors.usage.maxFailuresPositive);
  1388→          process.exit(EXIT_CODES.ERROR);
  1389→        }
  1390→
  1391→        if (!Number.isFinite(iterationTimeoutMinutes) || iterationTimeoutMinutes <= 0) {
  1392→          error("--iteration-timeout must be a positive number of minutes");
  1393→          process.exit(EXIT_CODES.ERROR);
  1394→        }
  1395→
  1396→        const subagentTimeout = parseInt(options.subagentTimeout, 10);
  1397→        if (Number.isNaN(subagentTimeout) || subagentTimeout < 1) {
  1398→          error("--subagent-timeout must be a positive integer (minutes)");
  1399→          process.exit(EXIT_CODES.ERROR);
  1400→        }
  1401→
  1402→        const restartEvery = parseInt(options.restartEvery, 10);
  1403→        if (Number.isNaN(restartEvery) || restartEvery < 0) {
  1404→          error("--restart-every must be a non-negative integer");
  1405→          process.exit(EXIT_CODES.ERROR);
  1406→        }
  1407→
  1408→        // AC: @ralph-session-budget-integration ac-create-budget
  1409→        const maxTasks = parseInt(options.maxTasks, 10);
  1410→        if (Number.isNaN(maxTasks) || maxTasks < 0 || maxTasks > 999) {
  1411→          error("--max-tasks must be 0 (unlimited) or a positive integer up to 999");
  1412→          process.exit(EXIT_CODES.USAGE_ERROR);
  1413→        }
  1414→
  1415→        // Handle custom adapter command for testing
  1416→        if (options.adapterCmd) {
  1417→          const parts = options.adapterCmd.split(/\s+/);
  1418→          const customAdapter: AgentAdapter = {
  1419→            command: parts[0],
  1420→            args: parts.slice(1),
  1421→            description: "Custom adapter via --adapter-cmd",
  1422→          };
  1423→          registerAdapter("custom", customAdapter);
  1424→          options.adapter = "custom";
  1425→        }
  1426→
  1427→        // AC: @ralph-per-role-adapters ac-3, ac-4, ac-5
  1428→        // Resolve per-role adapters with precedence: role flag > --adapter > default
  1429→        const workerAdapterId = options.workerAdapter ?? options.adapter;
  1430→        const reviewerAdapterId = options.reviewerAdapter ?? options.adapter;
  1431→
  1432→        const workerAdapter = resolveAdapter(workerAdapterId);
  1433→        const reviewerAdapter = resolveAdapter(reviewerAdapterId);
  1434→
  1435→        // AC: @ralph-per-role-adapters ac-6, ac-9, ac-11
  1436→        // Validate adapter packages — deduplicate when same ID
  1437→        const adapterIdsToValidate = new Set([workerAdapterId, reviewerAdapterId]);
  1438→        for (const id of adapterIdsToValidate) {
  1439→          const resolved = resolveAdapter(id);
  1440→          const isDefault = id === "claude-agent-acp" || id === "claude-code-acp";
  1441→          const skip =
  1442→            resolved.command !== "npx" ||
  1443→            !resolved.args[0] ||
  1444→            (options.dryRun && isDefault);
  1445→
  1446→          if (!skip) {
  1447→            validateAdapter(resolved.args[0], id);
  1448→          }
  1449→        }
  1450→
  1451→        // Build auto-approve extra args per adapter (applied per-spawn to prevent cross-role leakage)
  1452→        const workerAutoApproveArgs = options.yolo
  1453→          ? workerAdapter.autoApproveArgs
  1454→          : undefined;
  1455→        const reviewerAutoApproveArgs = options.yolo
  1456→          ? reviewerAdapter.autoApproveArgs
  1457→          : undefined;
  1458→
  1459→        const restartInfo =
  1460→          restartEvery > 0 ? `, restart every ${restartEvery}` : "";
  1461→        const maxTasksInfo =
  1462→          maxTasks === 0 ? "unlimited" : `${maxTasks}`;
  1463→
  1464→        // Initialize kspec context early to validate --tasks
  1465→        const ctx = await initContext();
  1466→
  1467→        // AC: @cli-ralph ac-21 - Parse explicit task scope
  1468→        let explicitTaskScope: ExplicitTaskScope | undefined;
  1469→        if (options.tasks) {
  1470→          try {
  1471→            explicitTaskScope = await parseExplicitTasks(ctx, options.tasks);
  1472→            info(`Explicit task scope: ${explicitTaskScope.refs.join(", ")}`);
  1473→          } catch (err) {
  1474→            error(`Invalid --tasks argument: ${(err as Error).message}`);
  1475→            process.exit(EXIT_CODES.VALIDATION_FAILED);
  1476→          }
  1477→        }
  1478→
  1479→        const skillOrigins = await loadSkillOriginsForRalph(ctx);
  1480→        const workerPromptPlatform = getPromptPlatformForAdapter(workerAdapterId);
  1481→        const reviewerPromptPlatform = getPromptPlatformForAdapter(reviewerAdapterId);
  1482→        const workerTaskWorkSkill = resolveRalphSkillInvocation(
  1483→          ctx.config.ralph.skills.task_work,
  1484→          workerPromptPlatform,
  1485→          skillOrigins,
  1486→        );
  1487→        const workerReflectSkill = resolveRalphSkillInvocation(
  1488→          ctx.config.ralph.skills.reflect,
  1489→          workerPromptPlatform,
  1490→          skillOrigins,
  1491→        );
  1492→        const reviewerPrReviewSkill = resolveRalphSkillInvocation(
  1493→          ctx.config.ralph.skills.pr_review,
  1494→          reviewerPromptPlatform,
  1495→          skillOrigins,
  1496→        );
  1497→
  1498→        const taskScopeInfo = explicitTaskScope
  1499→          ? `, tasks=${explicitTaskScope.refs.join(",")}`
  1500→          : "";
  1501→        const adapterInfo = workerAdapterId === reviewerAdapterId
  1502→          ? `adapter=${workerAdapterId}`
  1503→          : `worker=${workerAdapterId}, reviewer=${reviewerAdapterId}`;
  1504→        info(
  1505→          `Starting ralph loop (${adapterInfo}, max ${maxLoops} iterations, ${maxRetries} retries, ${maxFailures} max failures${restartInfo}, max-tasks=${maxTasksInfo}${taskScopeInfo})`,
  1506→        );
  1507→        info(`Iteration timeout: ${iterationTimeoutMinutes} minute(s)`);
  1508→        if (options.focus) {
  1509→          info(`Focus: ${options.focus}`);
  1510→        }
  1511→        const specDir = ctx.specDir;
  1512→
  1513→        // Create session for event tracking
  1514→        const sessionId = ulid();
  1515→
  1516→        // Set session env vars on this process so all spawned agents
  1517→        // (main worker, subagent, wrap-up) inherit them via process.env.
  1518→        // KSPEC_RALPH_SESSION: Used by codex skill safety guard to detect ralph context.
  1519→        // KSPEC_SESSION_ID: Used by kspec task start for budget enforcement.
  1520→        // AC: @ralph-session-budget-integration ac-env-inject
  1521→        process.env.KSPEC_RALPH_SESSION = sessionId;
  1522→        process.env.KSPEC_SESSION_ID = sessionId;
  1523→
  1524→        // AC: @ralph-session-budget-integration ac-create-budget
  1525→        // Create session with budget. When maxTasks=0 (unlimited), no budget.json is created.
  1526→        await createSessionWithBudget(specDir, {
  1527→          id: sessionId,
  1528→          agent_type: workerAdapterId,
  1529→          budget: maxTasks,
  1530→        });
  1531→
  1532→        // AC: @ralph-per-role-adapters ac-6, ac-7
  1533→        // Adapter IDs for harness-specific env injection/cleanup.
  1534→        // Deduplicate by harness target, not just adapter ID. claude-code-acp is
  1535→        // an alias for claude-agent-acp — both inject to the same Claude Code
  1536→        // settings file. Without normalization, injecting twice would clobber the
  1537→        // previousValue and break cleanup restoration.
  1538→        const normalizeForEnv = (id: string) =>
  1539→          id === "claude-code-acp" ? "claude-agent-acp" : id;
  1540→        const uniqueAdapterIds = [...new Set([
  1541→          normalizeForEnv(workerAdapterId),
  1542→          normalizeForEnv(reviewerAdapterId),
  1543→        ])];
  1544→
  1545→        // Everything after session creation is wrapped in try/finally to guarantee
  1546→        // budget cleanup even if pre-loop setup (event logging, signal handlers) throws.
  1547→        // AC: @ralph-session-budget-integration ac-session-close-all-paths
  1548→        let consecutiveFailures = 0;
  1549→        let agent: SpawnedAgent | null = null;
  1550→        let acpSessionId: string | null = null;
  1551→        let sessionUpdateLogger: SessionUpdateLogger | null = null;
  1552→        let exitReason: ExitReason | null = null;
  1553→        let lastIterationCtx: SessionStartContext | null = null;
  1554→        let lastErrorMessage: string | undefined;
  1555→        // AC: @ralph-per-role-adapters ac-7
  1556→        // Track previous env values per adapter for cleanup restoration
  1557→        const previousEnvValues = new Map<string, string | null | undefined>();
  1558→        const recentTaskRefs: string[] = [];
  1559→        const endAcpSession = (
  1560→          spawned: SpawnedAgent | null,
  1561→          sessionToEnd: string | null,
  1562→        ): null => {
  1563→          if (!spawned || !sessionToEnd) {
  1564→            return null;
  1565→          }
  1566→          spawned.client.endSession(sessionToEnd);
  1567→          return null;
  1568→        };
  1569→
  1570→        // Signal handler refs — declared here so finally can remove them
  1571→        // AC: @ralph-task-limit ac-signal-cleanup
  1572→        const signalCleanup = (signal: string) => {
  1573→          info(`Received ${signal}, cleaning up...`);
  1574→          if (agent) {
  1575→            acpSessionId = endAcpSession(agent, acpSessionId);
  1576→            agent = disposeSpawnedAgent(agent);
  1577→          }
  1578→          // AC: @ralph-session-budget-integration ac-session-close-all-paths
  1579→          // Must use async IIFE — signal handlers are called synchronously,
  1580→          // but cleanup needs async I/O. The IIFE keeps the event loop alive
  1581→          // until cleanup completes, then exits explicitly.
  1582→          void (async () => {
  1583→            try {
  1584→              await Promise.all([
  1585→                fs.unlink(getSessionBudgetPath(specDir, sessionId)).catch(() => {}),
  1586→                closeSession(specDir, sessionId, "abandoned", `Received ${signal}`),
  1587→                ...uniqueAdapterIds.map((id) =>
  1588→                  removeEnvForAdapter(id, previousEnvValues.get(id)),
  1589→                ),
  1590→              ]);
  1591→            } catch {
  1592→              // Best-effort cleanup — don't let errors prevent exit
  1593→            } finally {
  1594→              process.exit(0);
  1595→            }
  1596→          })();
  1597→        };
  1598→        const sigintHandler = () => { signalCleanup("SIGINT"); };
  1599→        const sigtermHandler = () => { signalCleanup("SIGTERM"); };
  1600→
  1601→        try {
  1602→          // AC: @session-end-loop-signal ac-session-close-signal
  1603→          // Install signal handlers FIRST, before any async work, so signals
  1604→          // during startup (e.g. during appendEvent) still trigger cleanup.
  1605→          // AC: @ralph-session-budget-integration ac-session-close-all-paths
  1606→          process.on("SIGINT", sigintHandler);
  1607→          process.on("SIGTERM", sigtermHandler);
  1608→
  1609→          // AC: @ralph-per-role-adapters ac-6, ac-7
  1610→          // Inject KSPEC_SESSION_ID into agent harness config for each unique adapter.
  1611→          // Process env alone is insufficient — some harnesses (e.g., Claude Code)
  1612→          // sandbox child processes and don't forward arbitrary parent env vars.
  1613→          // AC: @ralph-session-budget-integration ac-env-inject
  1614→          for (const id of uniqueAdapterIds) {
  1615→            const injectionResult = await injectEnvForAdapter(id, sessionId);
  1616→            previousEnvValues.set(id, injectionResult?.previousValue);
  1617→          }
  1618→
  1619→          // AC: @ralph-per-role-adapters ac-12
  1620→          // Log session start with both adapter IDs
  1621→          await appendEvent(specDir, {
  1622→            session_id: sessionId,
  1623→            type: "session.start",
  1624→            data: {
  1625→              adapter: workerAdapterId,
  1626→              workerAdapter: workerAdapterId,
  1627→              reviewerAdapter: reviewerAdapterId,
  1628→              maxLoops,
  1629→              maxRetries,
  1630→              maxFailures,
  1631→              iterationTimeoutMinutes,
  1632→              maxTasks,
  1633→              yolo: options.yolo,
  1634→              focus: options.focus,
  1635→              explicitTasks: explicitTaskScope?.refs,
  1636→            },
  1637→          });
  1638→
  1639→          // Create translator and renderer for this session
  1640→          const translator = createTranslator();
  1641→          const renderer = createCliRenderer();
  1642→
  1643→          for (let iteration = 1; iteration <= maxLoops; iteration++) {
  1644→            renderer.newSection?.(`Iteration ${iteration}/${maxLoops}`);
  1645→
  1646→            // AC: @ralph-session-budget-integration ac-reset-iteration
  1647→            // Reset budget counter at iteration start (no-op when no budget exists)
  1648→            await resetBudget(specDir, sessionId);
  1649→
  1650→            // AC: @session-end-loop-signal ac-detect - Check session state for end-loop
  1651→            const endLoopState = await isEndLoopRequested(specDir, sessionId);
  1652→            if (endLoopState?.requested) {
  1653→              info(`End-loop already requested for this session. Exiting.`);
  1654→              exitReason = "end_loop_signal";
  1655→              break;
  1656→            }
  1657→
  1658→            // Gather fresh context each iteration
  1659→            // AC: @cli-ralph ac-16 - Only automation-eligible tasks (unless explicit scope)
  1660→            // AC: @cli-ralph ac-21 - With explicit task scope, ignore automation eligibility
  1661→            let sessionCtx = await gatherSessionContext(ctx, {
  1662→              limit: "10",
  1663→              eligible: !explicitTaskScope, // Skip eligibility filter if explicit scope
  1664→            });
  1665→
  1666→            // AC: @cli-ralph ac-21 - Filter to explicit tasks if scope is set
  1667→            if (explicitTaskScope) {
  1668→              sessionCtx = filterByExplicitTasks(sessionCtx, explicitTaskScope);
  1669→            }
  1670→
  1671→            // AC: @ralph-subagent-spawning ac-8 - Process pending_review tasks BEFORE main iteration
  1672→            // AC: @ralph-per-role-adapters ac-2 - Use reviewer adapter for review subagents
  1673→            // This wraps consecutiveFailures in an object so it can be mutated by the helper
  1674→            const failureTracker = { count: consecutiveFailures };
  1675→            const continueLoop = await processPendingReviewTasks(
  1676→              ctx,
  1677→              reviewerAdapter,
  1678→              sessionCtx.pending_review_tasks,
  1679→              {
  1680→                yolo: options.yolo,
  1681→                maxRetries,
  1682→                maxFailures,
  1683→                cwd: process.cwd(),
  1684→                specDir,
  1685→                sessionId,
  1686→                subagentTimeout: subagentTimeout * 60 * 1000,
  1687→                autoApproveArgs: reviewerAutoApproveArgs,
  1688→                prReviewSkillName: reviewerPrReviewSkill,
  1689→              },
  1690→              failureTracker,
  1691→            );
  1692→            consecutiveFailures = failureTracker.count;
  1693→
  1694→            if (!continueLoop) {
  1695→              exitReason = "max_failures";
  1696→              lastIterationCtx = sessionCtx;
  1697→              break;
  1698→            }
  1699→
  1700→            // AC: @cli-ralph ac-20 - Refresh context after pending_review processing
  1701→            // If pending_review tasks were processed, they may have completed and unblocked
  1702→            // dependent tasks. Re-gather context to detect newly available tasks.
  1703→            let currentCtx = sessionCtx;
  1704→            if (sessionCtx.pending_review_tasks.length > 0) {
  1705→              currentCtx = await gatherSessionContext(ctx, {
  1706→                limit: "10",
  1707→                eligible: !explicitTaskScope,
  1708→              });
  1709→              if (explicitTaskScope) {
  1710→                currentCtx = filterByExplicitTasks(currentCtx, explicitTaskScope);
  1711→              }
  1712→            }
  1713→
  1714→            // AC: @cli-ralph ac-21 - Check explicit task completion
  1715→            if (explicitTaskScope) {
  1716→              const { done, statuses } = await allExplicitTasksDone(ctx, explicitTaskScope);
  1717→              if (done) {
  1718→                const statusList = Array.from(statuses.entries())
  1719→                  .map(([ref, status]) => `${ref}: ${status}`)
  1720→                  .join(", ");
  1721→                info(`All explicit tasks completed or blocked (${statusList}). Exiting loop.`);
  1722→                exitReason = "explicit_tasks_done";
  1723→                lastIterationCtx = currentCtx;
  1724→                break;
  1725→              }
  1726→            }
  1727→
  1728→            // Check for automation-eligible tasks (ready or in_progress)
  1729→            // AC: @cli-ralph ac-19
  1730→            const hasActiveTasks = currentCtx.active_tasks.length > 0;
  1731→            const hasReadyTasks = currentCtx.ready_tasks.length > 0;
  1732→
  1733→            if (!hasActiveTasks && !hasReadyTasks) {
  1734→              if (explicitTaskScope) {
  1735→                info("No explicit tasks available (ready or in_progress). Exiting loop.");
  1736→              } else {
  1737→                info("No automation-eligible tasks (ready or in_progress). Exiting loop.");
  1738→              }
  1739→              exitReason = "no_tasks";
  1740→              lastIterationCtx = currentCtx;
  1741→              break;
  1742→            }
  1743→
  1744→            // AC: @loop-mode-error-handling - Track tasks in progress for failure handling
  1745→            const tasksInProgressAtStart = sessionCtx.active_tasks;
  1746→            const iterationStartTime = new Date();
  1747→
  1748→            // Build prompts - task-work first, then reflect
  1749→            // AC: @cli-ralph ac-21 - Include explicit task scope in prompt
  1750→            const taskWorkPrompt = buildTaskWorkPrompt(
  1751→              currentCtx,
  1752→              iteration,
  1753→              maxLoops,
  1754→              sessionId,
  1755→              workerTaskWorkSkill,
  1756→              options.focus,
  1757→              explicitTaskScope,
  1758→            );
  1759→            const reflectPrompt = buildReflectPrompt(
  1760→              iteration,
  1761→              maxLoops,
  1762→              sessionId,
  1763→              workerReflectSkill,
  1764→            );
  1765→
  1766→            // AC: @cli-ralph ac-21
  1767→            // AC: @ralph-per-role-adapters ac-10
  1768→            if (options.dryRun) {
  1769→              console.log(
  1770→                chalk.yellow("=== DRY RUN - Configuration ===\n"),
  1771→              );
  1772→              console.log(`  worker-adapter: ${workerAdapterId}`);
  1773→              console.log(`  reviewer-adapter: ${reviewerAdapterId}`);
  1774→              console.log(`  max-loops: ${maxLoops}`);
  1775→              console.log(`  max-tasks: ${maxTasks === 0 ? "unlimited" : maxTasks}`);
  1776→              console.log(`  max-retries: ${maxRetries}`);
  1777→              console.log(`  max-failures: ${maxFailures}`);
  1778→              console.log(`  iteration-timeout: ${iterationTimeoutMinutes} minute(s)`);
  1779→              console.log(`  restart-every: ${restartEvery === 0 ? "never" : restartEvery}`);
  1780→              console.log(`  worker-task-work-skill: ${workerTaskWorkSkill}`);
  1781→              console.log(`  worker-reflect-skill: ${workerReflectSkill}`);
  1782→              console.log(`  reviewer-pr-review-skill: ${reviewerPrReviewSkill}`);
  1783→              if (explicitTaskScope) {
  1784→                console.log(`  explicit-tasks: ${explicitTaskScope.refs.join(", ")}`);
  1785→              }
  1786→              console.log(
  1787→                chalk.yellow("\n=== Task Work Prompt ===\n"),
  1788→              );
  1789→              console.log(taskWorkPrompt);
  1790→              console.log(chalk.yellow("\n=== Reflect Prompt ===\n"));
  1791→              console.log(reflectPrompt);
  1792→              console.log(chalk.yellow("\n=== END DRY RUN ==="));
  1793→              break;
  1794→            }
  1795→
  1796→            // Log task-work prompt
  1797→            await appendEvent(specDir, {
  1798→              session_id: sessionId,
  1799→              type: "prompt.sent",
  1800→              data: {
  1801→                iteration,
  1802→                phase: "task-work",
  1803→                prompt: taskWorkPrompt,
  1804→                tasks: {
  1805→                  active: currentCtx.active_tasks.map((t) => t.ref),
  1806→                  ready: currentCtx.ready_tasks.map((t) => t.ref),
  1807→                },
  1808→              },
  1809→            });
  1810→
  1811→            // Retry loop for this iteration
  1812→            let lastError: Error | null = null;
  1813→            let succeeded = false;
  1814→
  1815→            for (let attempt = 1; attempt <= maxRetries + 1; attempt++) {
  1816→              if (attempt > 1) {
  1817→                console.log(
  1818→                  chalk.yellow(
  1819→                    `\nRetry attempt ${attempt - 1}/${maxRetries}...`,
  1820→                  ),
  1821→                );
  1822→              }
  1823→
  1824→              try {
  1825→                // Spawn agent if not already running
  1826→                // AC: @ralph-per-role-adapters ac-1 - Use worker adapter for task-work
  1827→                if (!agent) {
  1828→                  info("Spawning ACP agent...");
  1829→                  // AC: @ralph-session-budget-integration ac-env-inject
  1830→                  // AC: @ralph-adapter-auto-approve ac-1, ac-2, ac-3
  1831→                  agent = await spawnAndInitialize(workerAdapter, {
  1832→                    cwd: process.cwd(),
  1833→                    env: { KSPEC_SESSION_ID: sessionId },
  1834→                    extraArgs: workerAutoApproveArgs,
  1835→                    clientOptions: {
  1836→                      clientInfo: {
  1837→                        name: "kspec-ralph",
  1838→                        version: packageVersion,
  1839→                      },
  1840→                      methodTimeouts: {
  1841→                        "session/prompt": RALPH_PROMPT_TIMEOUT,
  1842→                        "session/resume": RALPH_PROMPT_TIMEOUT,
  1843→                      },
  1844→                    },
  1845→                  });
  1846→
  1847→                  // Set up streaming update handler with translator + renderer
  1848→                  agent.client.on(
  1849→                    "update",
  1850→                    (_sid: string, update: SessionUpdate) => {
  1851→                      // Translate ACP event to RalphEvent and render
  1852→                      const event = translator.translate(update);
  1853→                      if (event) {
  1854→                        renderer.render(event);
  1855→                      }
  1856→
  1857→                    },
  1858→                  );
  1859→
  1860→                  // Set up tool request handler
  1861→                  agent.client.on(
  1862→                    "request",
  1863→                    (
  1864→                      reqId: string | number,
  1865→                      method: string,
  1866→                      params: unknown,
  1867→                    ) => {
  1868→                      // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1869→                      handleRequest(
  1870→                        agent!.client,
  1871→                        reqId,
  1872→                        method,
  1873→                        params,
  1874→                        {
  1875→                          yolo: options.yolo,
  1876→                          specDir,
  1877→                          sessionId,
  1878→                        },
  1879→                      ).catch((err) => {
  1880→                        // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1881→                        agent!.client.respondError(reqId, -32000, err.message);
  1882→                      });
  1883→                    },
  1884→                  );
  1885→                }
  1886→
  1887→                // AC: @cli-ralph ac-14 - Create fresh ACP session per iteration
  1888→                // to keep context clean.
  1889→                info("Creating ACP session...");
  1890→                acpSessionId = await agent.client.newSession({
  1891→                  cwd: process.cwd(),
  1892→                  mcpServers: [], // No MCP servers for now
  1893→                });
  1894→                const nextUpdateLogger = createSessionUpdateLogger(
  1895→                  acpSessionId,
  1896→                  iteration,
  1897→                  async (eventIteration, update) => {
  1898→                    await appendEvent(specDir, {
  1899→                      session_id: sessionId,
  1900→                      type: "session.update",
  1901→                      data: { iteration: eventIteration, update },
  1902→                    });
  1903→                  },
  1904→                );
  1905→                sessionUpdateLogger = replaceSessionUpdateLogger(
  1906→                  agent.client,
  1907→                  sessionUpdateLogger,
  1908→                  nextUpdateLogger,
  1909→                );
  1910→
  1911→                const runIterationPrompts = async () => {
  1912→                  // Phase 1: Task Work
  1913→                  info("Sending task-work prompt to agent...");
  1914→                  const taskWorkResponse = await agent!.client.prompt({
  1915→                    sessionId: acpSessionId!,
  1916→                    prompt: [{ type: "text", text: taskWorkPrompt }],
  1917→                  });
  1918→
  1919→                  // Log task-work completion
  1920→                  await appendEvent(specDir, {
  1921→                    session_id: sessionId,
  1922→                    type: "session.update",
  1923→                    data: {
  1924→                      iteration,
  1925→                      phase: "task-work",
  1926→                      stopReason: taskWorkResponse.stopReason,
  1927→                      completed: true,
  1928→                    },
  1929→                  });
  1930→
  1931→                  if (taskWorkResponse.stopReason === "cancelled") {
  1932→                    throw new Error(errors.usage.agentPromptCancelled);
  1933→                  }
  1934→
  1935→                  // Phase 2: Reflect (always sent after task-work completes)
  1936→                  info("Sending reflect prompt to agent...");
  1937→                  await appendEvent(specDir, {
  1938→                    session_id: sessionId,
  1939→                    type: "prompt.sent",
  1940→                    data: {
  1941→                      iteration,
  1942→                      phase: "reflect",
  1943→                      prompt: reflectPrompt,
  1944→                    },
  1945→                  });
  1946→
  1947→                  const reflectResponse = await agent!.client.prompt({
  1948→                    sessionId: acpSessionId!,
  1949→                    prompt: [{ type: "text", text: reflectPrompt }],
  1950→                  });
  1951→
  1952→                  // Log reflect completion
  1953→                  await appendEvent(specDir, {
  1954→                    session_id: sessionId,
  1955→                    type: "session.update",
  1956→                    data: {
  1957→                      iteration,
  1958→                      phase: "reflect",
  1959→                      stopReason: reflectResponse.stopReason,
  1960→                      completed: true,
  1961→                    },
  1962→                  });
  1963→
  1964→                  if (reflectResponse.stopReason === "cancelled") {
  1965→                    throw new Error(errors.usage.agentPromptCancelled);
  1966→                  }
  1967→                };
  1968→
  1969→                let timeoutHandle: NodeJS.Timeout | null = null;
  1970→                try {
  1971→                  const iterationPromptsPromise = runIterationPrompts();
  1972→                  // Prevent unhandled rejection if timeout wins the race and
  1973→                  // disposeSpawnedAgent() causes the pending prompt to reject.
  1974→                  iterationPromptsPromise.catch(() => {});
  1975→                  await Promise.race([
  1976→                    iterationPromptsPromise,
  1977→                    new Promise<never>((_resolve, reject) => {
  1978→                      timeoutHandle = setTimeout(() => {
  1979→                        reject(
  1980→                          new IterationTimeoutError(
  1981→                            iterationTimeoutMinutes,
  1982→                            iterationTimeoutMs,
  1983→                          ),
  1984→                        );
  1985→                      }, iterationTimeoutMs);
  1986→                    }),
  1987→                  ]);
  1988→                } finally {
  1989→                  if (timeoutHandle) {
  1990→                    clearTimeout(timeoutHandle);
  1991→                  }
  1992→                }
  1993→
  1994→                sessionUpdateLogger = replaceSessionUpdateLogger(
  1995→                  agent.client,
  1996→                  sessionUpdateLogger,
  1997→                  null,
  1998→                );
  1999→                acpSessionId = endAcpSession(agent, acpSessionId);
  2000→                succeeded = true;
  2001→                break;
  2002→              } catch (err) {
  2003→                lastError = err as Error;
  2004→                if (lastError instanceof IterationTimeoutError) {
  2005→                  await appendEvent(specDir, {
  2006→                    session_id: sessionId,
  2007→                    type: "iteration.timeout",
  2008→                    data: {
  2009→                      iteration,
  2010→                      attempt,
  2011→                      timeout_minutes: lastError.timeoutMinutes,
  2012→                      timeout_ms: lastError.timeoutMs,
  2013→                    },
  2014→                  });
  2015→                }
  2016→                error(errors.failures.iterationFailed(lastError.message));
  2017→
  2018→                // Clean up agent on error - will respawn next attempt
  2019→                if (agent) {
  2020→                  sessionUpdateLogger = replaceSessionUpdateLogger(
  2021→                    agent.client,
  2022→                    sessionUpdateLogger,
  2023→                    null,
  2024→                  );
  2025→                  acpSessionId = endAcpSession(agent, acpSessionId);
  2026→                  agent = disposeSpawnedAgent(agent);
  2027→                }
  2028→              }
  2029→            }
  2030→
  2031→            if (succeeded) {
  2032→              console.log(); // Newline after streaming output
  2033→
  2034→              // Save session context snapshot for audit trail
  2035→              await saveSessionContext(
  2036→                specDir,
  2037→                sessionId,
  2038→                iteration,
  2039→                sessionCtx,
  2040→              );
  2041→
  2042→              success(`Completed iteration ${iteration}`);
  2043→              consecutiveFailures = 0;
  2044→
  2045→              // Track task refs from this iteration for wrap-up context
  2046→              for (const t of sessionCtx.active_tasks) {
  2047→                pushRecentTaskRef(recentTaskRefs, t.ref);
  2048→              }
  2049→              lastIterationCtx = sessionCtx;
  2050→
  2051→
  2052→              // Periodic agent restart to prevent OOM.
  2053→              // AC: @cli-ralph ac-17
  2054→              if (
  2055→                restartEvery > 0 &&
  2056→                iteration % restartEvery === 0 &&
  2057→                iteration < maxLoops
  2058→              ) {
  2059→                info(
  2060→                  `Restarting agent to prevent memory buildup (every ${restartEvery} iterations)...`,
  2061→                );
  2062→                if (agent) {
  2063→                  sessionUpdateLogger = replaceSessionUpdateLogger(
  2064→                    agent.client,
  2065→                    sessionUpdateLogger,
  2066→                    null,
  2067→                  );
  2068→                  acpSessionId = endAcpSession(agent, acpSessionId);
  2069→                  agent = disposeSpawnedAgent(agent);
  2070→                }
  2071→              }
  2072→            } else {
  2073→              consecutiveFailures++;
  2074→              error(
  2075→                errors.failures.iterationFailedAfterRetries(
  2076→                  iteration,
  2077→                  maxRetries,
  2078→                  consecutiveFailures,
  2079→                  maxFailures,
  2080→                ),
  2081→              );
  2082→              if (lastError) {
  2083→                error(errors.failures.lastError(lastError.message));
  2084→              }
  2085→
  2086→              // AC: @loop-mode-error-handling - Track per-task failures
  2087→              const errorDesc = lastError?.message || "Iteration failed after retries";
  2088→              await handleIterationFailure(
  2089→                ctx,
  2090→                tasksInProgressAtStart,
  2091→                iterationStartTime,
  2092→                errorDesc,
  2093→              );
  2094→
  2095→              if (consecutiveFailures >= maxFailures) {
  2096→                error(errors.failures.reachedMaxFailures(maxFailures));
  2097→                exitReason = "max_failures";
  2098→                lastErrorMessage = lastError?.message;
  2099→                lastIterationCtx = sessionCtx;
  2100→                break;
  2101→              }
  2102→
  2103→              info("Continuing to next iteration...");
  2104→            }
  2105→          }
  2106→
  2107→          // If loop completed all iterations without breaking
  2108→          if (exitReason === null) {
  2109→            exitReason = "max_iterations";
  2110→          }
  2111→        } catch (loopErr) {
  2112→          // AC: @session-end-loop-signal ac-session-close-error
  2113→          // Unrecoverable error during loop execution
  2114→          exitReason = exitReason ?? "error";
  2115→          lastErrorMessage = (loopErr as Error).message;
  2116→          error("Unrecoverable error in ralph loop", loopErr);
  2117→        } finally {
  2118→          // Remove signal handlers to avoid double cleanup
  2119→          process.off("SIGINT", sigintHandler);
  2120→          process.off("SIGTERM", sigtermHandler);
  2121→
  2122→          // Clean up agent
  2123→          if (agent) {
  2124→            sessionUpdateLogger = replaceSessionUpdateLogger(
  2125→              agent.client,
  2126→              sessionUpdateLogger,
  2127→              null,
  2128→            );
  2129→            acpSessionId = endAcpSession(agent, acpSessionId);
  2130→            agent = disposeSpawnedAgent(agent);
  2131→          }
  2132→
  2133→          // AC: @ralph-session-budget-integration ac-session-close-all-paths
  2134→          // AC: @ralph-per-role-adapters ac-7 - Clean up env for all unique adapters
  2135→          await fs.unlink(getSessionBudgetPath(specDir, sessionId)).catch(() => {});
  2136→          for (const id of uniqueAdapterIds) {
  2137→            await removeEnvForAdapter(id, previousEnvValues.get(id));
  2138→          }
  2139→
  2140→          // Clean up session env vars
  2141→          delete process.env.KSPEC_RALPH_SESSION;
  2142→          delete process.env.KSPEC_SESSION_ID;
  2143→
  2144→          // AC: @ralph-wrap-up-agent-on-loop-exit ac-1, ac-2, ac-3, ac-4, ac-5
  2145→          // Spawn wrap-up agent if not dry-run and we have an exit reason
  2146→          if (!options.dryRun && exitReason) {
  2147→            console.log("");
  2148→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  2149→            console.log(chalk.cyan.bold(`${WRAPUP_AGENT_PREFIX} Starting Wrap-Up`));
  2150→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  2151→            console.log("");
  2152→
  2153→            const inProgressTasks = lastIterationCtx?.active_tasks || [];
  2154→            const pendingReviewTasks = lastIterationCtx?.pending_review_tasks || [];
  2155→
  2156→            const wrapUpCtx = buildWrapUpContext(
  2157→              exitReason,
  2158→              sessionId,
  2159→              maxLoops, // Use maxLoops as iteration (we're at the end)
  2160→              maxLoops,
  2161→              inProgressTasks,
  2162→              pendingReviewTasks,
  2163→              recentTaskRefs,
  2164→              process.cwd(),
  2165→              lastErrorMessage,
  2166→            );
  2167→
  2168→            info(`Exit reason: ${exitReason}`);
  2169→            info(`Working tree: ${wrapUpCtx.workingTree.clean ? "clean" : "has uncommitted changes"}`);
  2170→
  2171→            // AC: @ralph-per-role-adapters ac-8 - Wrap-up uses worker adapter
  2172→            const wrapUpResult = await runWrapUpAgent(
  2173→              workerAdapter,
  2174→              wrapUpCtx,
  2175→              {
  2176→                yolo: options.yolo,
  2177→                cwd: process.cwd(),
  2178→                extraArgs: workerAutoApproveArgs,
  2179→                handleRequest: (client, reqId, method, params) =>
  2180→                  handleRequest(client, reqId, method, params, {
  2181→                    yolo: options.yolo,
  2182→                    specDir,
  2183→                    sessionId,
  2184→                  }),
  2185→              },
  2186→              DEFAULT_WRAPUP_TIMEOUT,
  2187→            );
  2188→
  2189→            // Log wrap-up result
  2190→            await appendEvent(specDir, {
  2191→              session_id: sessionId,
  2192→              type: "session.wrapup",
  2193→              data: {
  2194→                exitReason,
  2195→                result: wrapUpResult,
  2196→              },
  2197→            });
  2198→
  2199→            if (wrapUpResult.skipped) {
  2200→              info(`${WRAPUP_AGENT_PREFIX} Skipped: ${wrapUpResult.skipReason}`);
  2201→            } else if (wrapUpResult.timedOut) {
  2202→              warn(`${WRAPUP_AGENT_PREFIX} Timed out after ${DEFAULT_WRAPUP_TIMEOUT / 1000}s`);
  2203→            } else if (!wrapUpResult.success) {
  2204→              warn(`${WRAPUP_AGENT_PREFIX} Failed: ${wrapUpResult.error}`);
  2205→            } else {
  2206→              success(`${WRAPUP_AGENT_PREFIX} Completed`);
  2207→            }
  2208→
  2209→            console.log("");
  2210→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  2211→            console.log(chalk.cyan.bold(`${WRAPUP_AGENT_PREFIX} Wrap-Up Complete`));
  2212→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  2213→            console.log("");
  2214→          }
  2215→
  2216→          // Log session end and close session with appropriate status/reason
  2217→          // AC: @session-end-loop-signal ac-session-close-normal, ac-session-close-error
  2218→          const isErrorExit =
  2219→            consecutiveFailures >= maxFailures ||
  2220→            exitReason === "max_failures" ||
  2221→            exitReason === "error";
  2222→          const status = isErrorExit ? "abandoned" : "completed";
  2223→          const closeReason = exitReason === "max_failures"
  2224→            ? `Max failures reached (${consecutiveFailures}/${maxFailures})${lastErrorMessage ? `: ${lastErrorMessage}` : ""}`
  2225→            : exitReason === "error"
  2226→              ? `Unrecoverable error${lastErrorMessage ? `: ${lastErrorMessage}` : ""}`
  2227→              : exitReason === "end_loop_signal"
  2228→                ? "Agent requested end of loop"
  2229→                : exitReason === "max_iterations"
  2230→                  ? `Completed all ${maxLoops} iterations`
  2231→                  : exitReason === "no_tasks"
  2232→                    ? "No eligible tasks remaining"
  2233→                    : exitReason === "explicit_tasks_done"
  2234→                      ? "All explicit tasks completed"
  2235→                      : `Loop ended: ${exitReason}`;
  2236→          await appendEvent(specDir, {
  2237→            session_id: sessionId,
  2238→            type: "session.end",
  2239→            data: {
  2240→              status,
  2241→              consecutiveFailures,
  2242→              exitReason,
  2243→              closeReason,
  2244→            },
  2245→          });
  2246→          await closeSession(specDir, sessionId, status, closeReason);
  2247→        }
  2248→
  2249→        console.log(chalk.green(`\n${"─".repeat(60)}`));
  2250→        success("Ralph loop completed");
  2251→        console.log(chalk.green(`${"─".repeat(60)}\n`));
  2252→      } catch (err) {
  2253→        error(errors.failures.ralphLoop, err);
  2254→        process.exit(EXIT_CODES.ERROR);
  2255→      }
  2256→    });
  2257→}
  2258→

