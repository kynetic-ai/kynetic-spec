     1→/**
     2→ * Agent Invocation Lifecycle
     3→ *
     4→ * Per-invocation session creation, ACP agent spawn, prompt delivery,
     5→ * event logging, timeout handling, and structured completion tracking.
     6→ *
     7→ * This is the core building block used by both the dispatch engine and
     8→ * CLI one-shot mode. Each invocation creates an isolated session with
     9→ * its own event log and metadata.
    10→ *
    11→ * AC: @agent-invocation-lifecycle ac-1 through ac-9
    12→ */
    13→
    14→import * as path from "node:path";
    15→import { spawnSync } from "node:child_process";
    16→import { ulid } from "ulid";
    17→import type { Agent } from "../schema/meta.js";
    18→import type { AgentAdapter } from "../agents/adapters.js";
    19→import { resolveAdapter } from "../agents/adapters.js";
    20→import { spawnAndInitialize } from "../agents/spawner.js";
    21→import type { SpawnedAgent } from "../agents/spawner.js";
    22→import type { ACPClient } from "../acp/client.js";
    23→import type { SessionUpdate } from "../acp/index.js";
    24→import {
    25→  createSession,
    26→  closeSession,
    27→  appendEvent,
    28→  injectEnvForAdapter,
    29→  removeEnvForAdapter,
    30→} from "../sessions/store.js";
    31→import type { SessionMetadata, SessionTrigger } from "../sessions/types.js";
    32→
    33→// ─── Constants ────────────────────────────────────────────────────────────────
    34→
    35→const DEFAULT_KSPEC_CLI_PATH = path.resolve(
    36→  path.dirname(new URL(import.meta.url).pathname),
    37→  "../../bin/kspec.cjs",
    38→);
    39→
    40→// ─── Types ────────────────────────────────────────────────────────────────────
    41→
    42→/**
    43→ * Options for running a single agent invocation.
    44→ */
    45→export interface InvocationOptions {
    46→  /** The agent definition describing capabilities and configuration */
    47→  agent: Agent;
    48→  /** The spec directory (.kspec/) */
    49→  specDir: string;
    50→  /** Working directory for spawned agent */
    51→  cwd: string;
    52→  /** Task reference being worked on (e.g., "@01KJP277A") */
    53→  taskRef: string;
    54→  /** The prompt to send to the agent */
    55→  prompt: string;
    56→  /** Trigger source for this invocation */
    57→  trigger: SessionTrigger;
    58→  /** Timeout in minutes (overrides agent.budget.timeout_minutes if set) */
    59→  timeoutMinutes?: number;
    60→  /** Whether to use auto-approve (yolo) args for adapter */
    61→  autoApprove?: boolean;
    62→  /** Extra environment variables for the spawned agent */
    63→  env?: Record<string, string>;
    64→  /** Called for each streaming update from the agent */
    65→  onUpdate?: (update: SessionUpdate) => void;
    66→  /** Path to kspec CLI (defaults to resolved bin/kspec.cjs) */
    67→  kspecCliPath?: string;
    68→}
    69→
    70→/**
    71→ * Result of a completed agent invocation.
    72→ */
    73→export interface InvocationResult {
    74→  /** Session that was created for this invocation */
    75→  session: SessionMetadata;
    76→  /** How the invocation ended */
    77→  outcome: "success" | "timed_out" | "failed";
    78→  /** Stop reason from ACP (e.g., "end_turn") if the invocation completed */
    79→  stopReason?: string;
    80→  /** Error message if the invocation failed */
    81→  error?: string;
    82→  /** Total duration in milliseconds */
    83→  durationMs: number;
    84→}
    85→
    86→/**
    87→ * Internal state tracked during invocation execution.
    88→ */
    89→interface InvocationState {
    90→  sessionId: string;
    91→  specDir: string;
    92→  taskRef: string;
    93→  adapterId: string;
    94→  previousEnvValue?: string | null;
    95→  agent: SpawnedAgent | null;
    96→  acpSessionId: string | null;
    97→}
    98→
    99→// ─── Helpers ──────────────────────────────────────────────────────────────────
   100→
   101→/**
   102→ * Run a kspec CLI command synchronously.
   103→ */
   104→function runKspecCli(args: string[], cwd: string, kspecCliPath: string): { stdout: string; stderr: string; status: number | null } {
   105→  const result = spawnSync(process.execPath, [kspecCliPath, ...args], {
   106→    encoding: "utf-8",
   107→    stdio: "pipe",
   108→    cwd,
   109→  });
   110→  return {
   111→    stdout: result.stdout ?? "",
   112→    stderr: result.stderr ?? "",
   113→    status: result.status,
   114→  };
   115→}
   116→
   117→/**
   118→ * Add a note to a task via kspec CLI.
   119→ */
   120→function addTaskNote(taskRef: string, note: string, cwd: string, kspecCliPath: string): void {
   121→  runKspecCli(["task", "note", taskRef, note], cwd, kspecCliPath);
   122→}
   123→
   124→/**
   125→ * Block a task via kspec CLI.
   126→ */
   127→function blockTask(taskRef: string, reason: string, cwd: string, kspecCliPath: string): void {
   128→  runKspecCli(["task", "block", taskRef, "--reason", reason], cwd, kspecCliPath);
   129→}
   130→
   131→/**
   132→ * Get the consecutive failure count for a task from its notes.
   133→ * Looks for AGENT-FAIL notes added by previous invocations.
   134→ */
   135→function getConsecutiveFailureCount(taskRef: string, cwd: string, kspecCliPath: string): number {
   136→  const result = runKspecCli(["task", "get", taskRef, "--json"], cwd, kspecCliPath);
   137→  if (result.status !== 0) return 0;
   138→
   139→  try {
   140→    const task = JSON.parse(result.stdout);
   141→    const notes: Array<{ content: string }> = task.notes ?? [];
   142→    // Count consecutive AGENT-FAIL notes from the end
   143→    let count = 0;
   144→    for (let i = notes.length - 1; i >= 0; i--) {
   145→      if (notes[i].content?.includes("[AGENT-FAIL]")) {
   146→        count++;
   147→      } else {
   148→        break;
   149→      }
   150→    }
   151→    return count;
   152→  } catch {
   153→    return 0;
   154→  }
   155→}
   156→
   157→/**
   158→ * Resolve skills for the agent and build skill content section for the prompt.
   159→ * AC: @agent-invocation-lifecycle ac-7
   160→ */
   161→async function resolveSkillsForAgent(
   162→  agent: Agent,
   163→  specDir: string,
   164→): Promise<string> {
   165→  if (!agent.skills || agent.skills.length === 0) {
   166→    return "";
   167→  }
   168→
   169→  const skillSections: string[] = [];
   170→
   171→  for (const skillId of agent.skills) {
   172→    try {
   173→      const skillContentPath = path.join(specDir, "skills", skillId, "SKILL.md");
   174→      const { readFile } = await import("node:fs/promises");
   175→      const content = await readFile(skillContentPath, "utf-8");
   176→      skillSections.push(`<!-- Skill: ${skillId} -->\n${content}`);
   177→    } catch {
   178→      // Skill content not found — skip silently
   179→    }
   180→  }
   181→
   182→  if (skillSections.length === 0) {
   183→    return "";
   184→  }
   185→
   186→  return `\n\n## Skills\n\n${skillSections.join("\n\n")}`;
   187→}
   188→
   189→/**
   190→ * Dispose a spawned agent, terminating the process if running.
   191→ * AC: @agent-invocation-lifecycle ac-8
   192→ */
   193→function disposeAgent(agent: SpawnedAgent | null): null {
   194→  if (agent) {
   195→    try {
   196→      agent.kill("SIGTERM");
   197→    } catch {
   198→      // Best-effort termination
   199→    }
   200→  }
   201→  return null;
   202→}
   203→
   204→// ─── Core Invocation ──────────────────────────────────────────────────────────
   205→
   206→/**
   207→ * Run a single agent invocation for a task.
   208→ *
   209→ * Creates a session, spawns the agent, injects KSPEC_SESSION_ID,
   210→ * sends the prompt, streams events, and closes the session on completion.
   211→ *
   212→ * AC: @agent-invocation-lifecycle ac-1 through ac-9
   213→ */
   214→export async function runInvocation(options: InvocationOptions): Promise<InvocationResult> {
   215→  const {
   216→    agent,
   217→    specDir,
   218→    cwd,
   219→    taskRef,
   220→    trigger,
   221→    autoApprove = agent.auto_approve,
   222→    env = {},
   223→    onUpdate,
   224→    kspecCliPath = DEFAULT_KSPEC_CLI_PATH,
   225→  } = options;
   226→
   227→  const startTime = Date.now();
   228→  const sessionId = ulid();
   229→
   230→  // Resolve adapter
   231→  const adapterId = agent.adapter ?? "claude-agent-acp";
   232→  const adapter = resolveAdapter(adapterId);
   233→
   234→  // Build extra args for auto-approve
   235→  const extraArgs = autoApprove ? (adapter.autoApproveArgs ?? []) : [];
   236→
   237→  // Resolve timeout: option overrides agent budget
   238→  const timeoutMinutes =
   239→    options.timeoutMinutes ??
   240→    agent.budget?.timeout_minutes ??
   241→    30;
   242→  const timeoutMs = timeoutMinutes * 60 * 1000;
   243→
   244→  // Resolve skill content for prompt
   245→  const skillsContent = await resolveSkillsForAgent(agent, specDir);
   246→  const fullPrompt = options.prompt + skillsContent;
   247→
   248→  const state: InvocationState = {
   249→    sessionId,
   250→    specDir,
   251→    taskRef,
   252→    adapterId,
   253→    previousEnvValue: undefined,
   254→    agent: null,
   255→    acpSessionId: null,
   256→  };
   257→
   258→  // ─── Create session ───────────────────────────────────────────────────────
   259→  // AC: @agent-invocation-lifecycle ac-1
   260→  const session = await createSession(specDir, {
   261→    id: sessionId,
   262→    agent_type: adapterId,
   263→    agent_id: agent.id,
   264→    trigger,
   265→    task_id: taskRef,
   266→  });
   267→
   268→  // ─── Log agent.dispatched event ───────────────────────────────────────────
   269→  await appendEvent(specDir, {
   270→    type: "agent.dispatched",
   271→    session_id: sessionId,
   272→    data: {
   273→      task_id: taskRef,
   274→      agent_id: agent.id,
   275→      adapter: adapterId,
   276→      trigger,
   277→    },
   278→  });
   279→
   280→  try {
   281→    // ─── Inject KSPEC_SESSION_ID ──────────────────────────────────────────
   282→    // AC: @agent-invocation-lifecycle ac-2
   283→    const injectionResult = await injectEnvForAdapter(adapterId, sessionId);
   284→    state.previousEnvValue = injectionResult?.previousValue;
   285→    process.env.KSPEC_SESSION_ID = sessionId;
   286→
   287→    // ─── Spawn agent ──────────────────────────────────────────────────────
   288→    state.agent = await spawnAndInitialize(adapter, {
   289→      cwd,
   290→      env: {
   291→        ...env,
   292→        KSPEC_SESSION_ID: sessionId,
   293→      },
   294→      extraArgs,
   295→    });
   296→
   297→    // ─── Create ACP session ───────────────────────────────────────────────
   298→    state.acpSessionId = await state.agent.client.newSession({
   299→      cwd,
   300→      mcpServers: [],
   301→    });
   302→
   303→    // ─── Log agent.started event ──────────────────────────────────────────
   304→    await appendEvent(specDir, {
   305→      type: "agent.started",
   306→      session_id: sessionId,
   307→      data: {
   308→        task_id: taskRef,
   309→        agent_id: agent.id,
   310→        acp_session_id: state.acpSessionId,
   311→      },
   312→    });
   313→
   314→    // ─── Register update handler ──────────────────────────────────────────
   315→    // AC: @agent-invocation-lifecycle ac-6
   316→    const updateHandler = async (acpSessionId: string, update: SessionUpdate) => {
   317→      if (acpSessionId !== state.acpSessionId) return;
   318→
   319→      // Log event to JSONL (with blob externalization from store.ts)
   320→      await appendEvent(specDir, {
   321→        type: "session.update",
   322→        session_id: sessionId,
   323→        data: update,
   324→      });
   325→
   326→      onUpdate?.(update);
   327→    };
   328→
   329→    state.agent.client.on("update", updateHandler);
   330→
   331→    // ─── Send prompt with timeout ─────────────────────────────────────────
   332→    // AC: @agent-invocation-lifecycle ac-3
   333→    const timeoutPromise = new Promise<never>((_, reject) => {
   334→      setTimeout(() => {
   335→        reject(new InvocationTimeoutError(timeoutMinutes));
   336→      }, timeoutMs);
   337→    });
   338→
   339→    const promptPromise = state.agent.client.prompt({
   340→      sessionId: state.acpSessionId,
   341→      prompt: [{ type: "text", text: fullPrompt }],
   342→    });
   343→
   344→    const promptResult = await Promise.race([promptPromise, timeoutPromise]);
   345→
   346→    // ─── Log agent.completed event ────────────────────────────────────────
   347→    // AC: @agent-invocation-lifecycle ac-4
   348→    const durationMs = Date.now() - startTime;
   349→    await appendEvent(specDir, {
   350→      type: "agent.completed",
   351→      session_id: sessionId,
   352→      data: {
   353→        task_id: taskRef,
   354→        outcome: "success",
   355→        stop_reason: promptResult.stopReason,
   356→        duration_ms: durationMs,
   357→      },
   358→    });
   359→
   360→    // ─── Close session as completed ───────────────────────────────────────
   361→    const finalSession = await closeSession(specDir, sessionId, "completed", "Invocation completed normally");
   362→
   363→    return {
   364→      session: finalSession ?? session,
   365→      outcome: "success",
   366→      stopReason: promptResult.stopReason,
   367→      durationMs,
   368→    };
   369→  } catch (err) {
   370→    const durationMs = Date.now() - startTime;
   371→
   372→    if (err instanceof InvocationTimeoutError) {
   373→      // ─── Handle timeout ──────────────────────────────────────────────
   374→      // AC: @agent-invocation-lifecycle ac-3
   375→      try {
   376→        if (state.acpSessionId && state.agent) {
   377→          await state.agent.client.cancel(state.acpSessionId);
   378→        }
   379→      } catch {
   380→        // Best-effort cancel
   381→      }
   382→
   383→      await appendEvent(specDir, {
   384→        type: "agent.timeout",
   385→        session_id: sessionId,
   386→        data: {
   387→          task_id: taskRef,
   388→          timeout_minutes: timeoutMinutes,
   389→          duration_ms: durationMs,
   390→        },
   391→      });
   392→
   393→      const finalSession = await closeSession(specDir, sessionId, "timed_out", `Timeout after ${timeoutMinutes} minutes`);
   394→
   395→      // Add timeout note to task
   396→      addTaskNote(
   397→        taskRef,
   398→        `[AGENT-TIMEOUT] Invocation timed out after ${timeoutMinutes} minutes`,
   399→        cwd,
   400→        kspecCliPath,
   401→      );
   402→
   403→      return {
   404→        session: finalSession ?? session,
   405→        outcome: "timed_out",
   406→        error: err.message,
   407→        durationMs,
   408→      };
   409→    }
   410→
   411→    // ─── Handle failure ──────────────────────────────────────────────────
   412→    // AC: @agent-invocation-lifecycle ac-5
   413→    const errorMessage = err instanceof Error ? err.message : String(err);
   414→
   415→    await appendEvent(specDir, {
   416→      type: "agent.failed",
   417→      session_id: sessionId,
   418→      data: {
   419→        task_id: taskRef,
   420→        error: errorMessage,
   421→        duration_ms: durationMs,
   422→      },
   423→    });
   424→
   425→    const finalSession = await closeSession(specDir, sessionId, "failed", `Invocation failed: ${errorMessage}`);
   426→
   427→    // Add failure note to task
   428→    addTaskNote(
   429→      taskRef,
   430→      `[AGENT-FAIL] Invocation failed: ${errorMessage}`,
   431→      cwd,
   432→      kspecCliPath,
   433→    );
   434→
   435→    // ─── Check retry threshold ────────────────────────────────────────────
   436→    // AC: @agent-invocation-lifecycle ac-9
   437→    const retryLimit = agent.budget?.max_tasks ?? 3;
   438→    const consecutiveFailures = getConsecutiveFailureCount(taskRef, cwd, kspecCliPath);
   439→
   440→    if (consecutiveFailures >= retryLimit) {
   441→      blockTask(
   442→        taskRef,
   443→        `Agent ${agent.id} failed ${consecutiveFailures} consecutive times: ${errorMessage}`,
   444→        cwd,
   445→        kspecCliPath,
   446→      );
   447→    }
   448→
   449→    return {
   450→      session: finalSession ?? session,
   451→      outcome: "failed",
   452→      error: errorMessage,
   453→      durationMs,
   454→    };
   455→  } finally {
   456→    // ─── Cleanup ──────────────────────────────────────────────────────────
   457→    // AC: @agent-invocation-lifecycle ac-8
   458→
   459→    // End ACP session
   460→    if (state.acpSessionId && state.agent) {
   461→      try {
   462→        state.agent.client.endSession(state.acpSessionId);
   463→      } catch {
   464→        // Best-effort
   465→      }
   466→    }
   467→
   468→    // Terminate agent process
   469→    state.agent = disposeAgent(state.agent);
   470→
   471→    // Restore env injection
   472→    await removeEnvForAdapter(adapterId, state.previousEnvValue);
   473→
   474→    // Restore process env
   475→    if (process.env.KSPEC_SESSION_ID === sessionId) {
   476→      delete process.env.KSPEC_SESSION_ID;
   477→    }
   478→  }
   479→}
   480→
   481→// ─── Error Types ──────────────────────────────────────────────────────────────
   482→
   483→/**
   484→ * Thrown when an invocation exceeds its configured timeout.
   485→ */
   486→export class InvocationTimeoutError extends Error {
   487→  constructor(public readonly timeoutMinutes: number) {
   488→    super(`Agent invocation timed out after ${timeoutMinutes} minutes`);
   489→    this.name = "InvocationTimeoutError";
   490→  }
   491→}
   492→

