     1→/**
     2→ * Session log commands (list, show, stats, search).
     3→ *
     4→ * These commands have zero dependency on the session-start code.
     5→ */
     6→
     7→import chalk from "chalk";
     8→import {
     9→  initContext,
    10→} from "../../../parser/index.js";
    11→import {
    12→  type SessionLogSummary,
    13→  type SessionLogDetail,
    14→  type SessionLogStats,
    15→  type ToolUsageStats,
    16→  type TimePeriodStats,
    17→  type SessionSearchResult,
    18→  getAllSessionLogSummaries,
    19→  getSessionLogDetail,
    20→  resolveSessionId,
    21→  readEvents,
    22→  readSessionContext,
    23→  computeSessionLogStats,
    24→  computeToolUsageStats,
    25→  computeTimePeriodStats,
    26→  searchSessionEvents,
    27→  deduplicatePhasedToolCalls,
    28→  resolveSessionBlobPointers,
    29→} from "../../../sessions/store.js";
    30→import type { SessionEvent } from "../../../sessions/types.js";
    31→import { SessionStatusSchema } from "../../../sessions/types.js";
    32→import {
    33→  formatRelativeTime,
    34→  parseTimeSpec,
    35→} from "../../../utils/index.js";
    36→import { isObject } from "../../../acp/types.js";
    37→import { EXIT_CODES } from "../../exit-codes.js";
    38→import { error, output, warn } from "../../output.js";
    39→
    40→// ─── Shared Helpers ─────────────────────────────────────────────────────────
    41→
    42→/**
    43→ * Format a duration in milliseconds to a compact human-readable string.
    44→ * Omits seconds when minutes are present (e.g., "5m" not "5m 30s").
    45→ */
    46→function formatDurationCompact(ms: number): string {
    47→  if (ms < 0) return "—";
    48→  const totalSec = Math.floor(ms / 1000);
    49→  const hours = Math.floor(totalSec / 3600);
    50→  const minutes = Math.floor((totalSec % 3600) / 60);
    51→  if (hours > 0) {
    52→    return `${hours}h ${minutes}m`;
    53→  }
    54→  if (minutes > 0) {
    55→    return `${minutes}m`;
    56→  }
    57→  return `${totalSec}s`;
    58→}
    59→
    60→/**
    61→ * Format a duration in milliseconds to a verbose human-readable string.
    62→ * Shows seconds when minutes are present (e.g., "5m 30s" not "5m").
    63→ */
    64→function formatDurationVerbose(ms: number): string {
    65→  if (ms < 0) return "—";
    66→  const totalSec = Math.floor(ms / 1000);
    67→  const hours = Math.floor(totalSec / 3600);
    68→  const minutes = Math.floor((totalSec % 3600) / 60);
    69→  const seconds = totalSec % 60;
    70→  if (hours > 0 && minutes > 0) {
    71→    return `${hours}h ${minutes}m`;
    72→  }
    73→  if (hours > 0) {
    74→    return `${hours}h`;
    75→  }
    76→  if (minutes > 0) {
    77→    return `${minutes}m ${seconds}s`;
    78→  }
    79→  return `${seconds}s`;
    80→}
    81→
    82→/**
    83→ * Map session status to chalk color function.
    84→ * Unlike statusColor() in format.ts (which handles task statuses),
    85→ * this handles session lifecycle statuses: completed, active, abandoned.
    86→ */
    87→function sessionStatusColor(
    88→  status: string,
    89→): typeof chalk.green {
    90→  switch (status) {
    91→    case "completed":
    92→      return chalk.green;
    93→    case "active":
    94→      return chalk.blue;
    95→    case "abandoned":
    96→      return chalk.yellow;
    97→    default:
    98→      return chalk.gray;
    99→  }
   100→}
   101→
   102→// ─── Session Log List ───────────────────────────────────────────────────────
   103→
   104→interface SessionLogListOptions {
   105→  status?: string;
   106→  agent?: string;
   107→  since?: string;
   108→  sort?: string;
   109→  count?: boolean;
   110→  limit?: string;
   111→}
   112→
   113→type SortField =
   114→  | "started_at"
   115→  | "duration"
   116→  | "events"
   117→  | "iterations"
   118→  | "tasks_completed";
   119→
   120→const VALID_SORT_FIELDS: SortField[] = [
   121→  "started_at",
   122→  "duration",
   123→  "events",
   124→  "iterations",
   125→  "tasks_completed",
   126→];
   127→
   128→/**
   129→ * Sort session summaries by the specified field.
   130→ * Default: started_at descending.
   131→ *
   132→ * AC: @session-log-list ac-5
   133→ */
   134→function sortSessions(
   135→  sessions: SessionLogSummary[],
   136→  sortField: SortField,
   137→): SessionLogSummary[] {
   138→  return [...sessions].sort((a, b) => {
   139→    switch (sortField) {
   140→      case "started_at":
   141→        return (
   142→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
   143→        );
   144→      case "duration":
   145→        return b.duration_ms - a.duration_ms;
   146→      case "events":
   147→        return b.event_count - a.event_count;
   148→      case "iterations":
   149→        return b.iteration_count - a.iteration_count;
   150→      case "tasks_completed":
   151→        return b.tasks_completed - a.tasks_completed;
   152→      default:
   153→        return (
   154→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
   155→        );
   156→    }
   157→  });
   158→}
   159→
   160→/**
   161→ * Format the session log list as a table.
   162→ *
   163→ * AC: @session-log-list ac-1
   164→ */
   165→function formatSessionLogList(sessions: SessionLogSummary[]): void {
   166→  if (sessions.length === 0) {
   167→    // AC: @session-log-list ac-6
   168→    console.log("No sessions found.");
   169→    return;
   170→  }
   171→
   172→  // Table header
   173→  console.log(
   174→    chalk.gray(
   175→      `${"ID".padEnd(10)} ${"Status".padEnd(11)} ${"Agent".padEnd(20)} ${"Started".padEnd(16)} ${"Duration".padEnd(10)} ${"Events".padEnd(8)} ${"Iters".padEnd(7)} Tasks`,
   176→    ),
   177→  );
   178→  console.log(chalk.gray("─".repeat(95)));
   179→
   180→  for (const s of sessions) {
   181→    const id = s.id.slice(0, 8);
   182→    const colorFn = sessionStatusColor(s.status);
   183→    const status = colorFn(s.status.padEnd(11));
   184→    const agent = s.agent_type.slice(0, 20).padEnd(20);
   185→    const started = formatRelativeTime(new Date(s.started_at)).padEnd(16);
   186→    const duration = formatDurationCompact(s.duration_ms).padEnd(10);
   187→    const events = String(s.event_count).padEnd(8);
   188→    const iters = String(s.iteration_count).padEnd(7);
   189→    const tasks = String(s.tasks_completed);
   190→
   191→    console.log(
   192→      `${chalk.yellow(id)} ${status} ${chalk.gray(agent)} ${chalk.gray(started)} ${duration} ${events} ${iters} ${tasks}`,
   193→    );
   194→  }
   195→
   196→  console.log(chalk.gray(`\n${sessions.length} session(s)`));
   197→}
   198→
   199→/**
   200→ * Session log list action handler.
   201→ */
   202→export async function sessionLogListAction(
   203→  options: SessionLogListOptions,
   204→): Promise<void> {
   205→  try {
   206→    const ctx = await initContext();
   207→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
   208→
   209→    // AC: @session-log-list ac-2 - Filter by status
   210→    if (options.status) {
   211→      const parsed = SessionStatusSchema.safeParse(options.status);
   212→      if (!parsed.success) {
   213→        const valid = SessionStatusSchema.options.join(", ");
   214→        error(`Invalid status: '${options.status}'. Valid values: ${valid}`);
   215→        process.exit(EXIT_CODES.USAGE_ERROR);
   216→      }
   217→      const statusFilter = parsed.data;
   218→      sessions = sessions.filter((s) => s.status === statusFilter);
   219→    }
   220→
   221→    // AC: @session-log-list ac-4 - Filter by agent type
   222→    if (options.agent) {
   223→      const agentFilter = options.agent;
   224→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
   225→    }
   226→
   227→    // AC: @session-log-list ac-3 - Filter by since date
   228→    if (options.since) {
   229→      const sinceDate = parseTimeSpec(options.since);
   230→      if (sinceDate) {
   231→        sessions = sessions.filter(
   232→          (s) => new Date(s.started_at) >= sinceDate,
   233→        );
   234→      }
   235→    }
   236→
   237→    // AC: @session-log-list ac-5 - Sort
   238→    const sortField: SortField =
   239→      options.sort && VALID_SORT_FIELDS.includes(options.sort as SortField)
   240→        ? (options.sort as SortField)
   241→        : "started_at";
   242→    sessions = sortSessions(sessions, sortField);
   243→
   244→    // AC: @session-log-list ac-7 - Limit output count
   245→    if (options.count) {
   246→      // AC: @trait-filterable-list ac-8
   247→      output({ count: sessions.length }, () => {
   248→        console.log(sessions.length);
   249→      });
   250→      return;
   251→    }
   252→
   253→    // Apply --limit (after filtering/sorting, before display)
   254→    if (options.limit) {
   255→      const limit = parseInt(options.limit, 10);
   256→      if (!Number.isNaN(limit) && limit > 0) {
   257→        sessions = sessions.slice(0, limit);
   258→      }
   259→    }
   260→
   261→    output(sessions, () => formatSessionLogList(sessions));
   262→  } catch (err) {
   263→    error("Failed to list session logs", err);
   264→    process.exit(EXIT_CODES.ERROR);
   265→  }
   266→}
   267→
   268→// ─── Session Log Show ───────────────────────────────────────────────────────
   269→
   270→interface SessionLogShowOptions {
   271→  events?: boolean;
   272→  type?: string;
   273→  limit?: string;
   274→  context?: string;
   275→  resolveBlobs?: boolean;
   276→}
   277→
   278→/**
   279→ * Format an event timestamp as relative time from session start.
   280→ */
   281→function formatEventTimestamp(
   282→  eventTs: number,
   283→  sessionStartTs: number,
   284→): string {
   285→  const relativeMs = eventTs - sessionStartTs;
   286→  const totalSec = Math.floor(relativeMs / 1000);
   287→  const minutes = Math.floor(totalSec / 60);
   288→  const seconds = totalSec % 60;
   289→  if (minutes > 0) {
   290→    return `+${minutes}m${seconds}s`;
   291→  }
   292→  return `+${seconds}s`;
   293→}
   294→
   295→/**
   296→ * Summarize event data for display.
   297→ * Returns a short string describing the event payload.
   298→ */
   299→function summarizeEventData(event: SessionEvent): string {
   300→  const data = event.data;
   301→  if (!isObject(data)) return "";
   302→
   303→  // Handle tool_call events
   304→  if (event.type === "session.update") {
   305→    const update = data.update;
   306→    if (isObject(update) && update.sessionUpdate === "tool_call") {
   307→      const meta = update._meta;
   308→      let toolName = "unknown";
   309→      if (isObject(meta)) {
   310→        const claudeCode = meta.claudeCode;
   311→        if (isObject(claudeCode) && typeof claudeCode.toolName === "string") {
   312→          toolName = claudeCode.toolName;
   313→        }
   314→      }
   315→      const rawInput = update.rawInput;
   316→      if (isObject(rawInput) && typeof rawInput.command === "string") {
   317→        const command = rawInput.command;
   318→        const truncated =
   319→          command.length > 60 ? command.slice(0, 57) + "..." : command;
   320→        return `${toolName}: ${truncated}`;
   321→      }
   322→      return toolName;
   323→    }
   324→  }
   325→
   326→  // Handle prompt.sent events
   327→  if (event.type === "prompt.sent") {
   328→    const prompt = data.prompt;
   329→    if (typeof prompt === "string" && prompt.length > 0) {
   330→      const truncated =
   331→        prompt.length > 60 ? prompt.slice(0, 57) + "..." : prompt;
   332→      return truncated;
   333→    }
   334→  }
   335→
   336→  // Handle session.start/end
   337→  if (event.type === "session.start") {
   338→    return "Session started";
   339→  }
   340→  if (event.type === "session.end") {
   341→    const reason = data.reason;
   342→    return typeof reason === "string" ? `Session ended: ${reason}` : "Session ended";
   343→  }
   344→
   345→  // Default: show first key
   346→  const keys = Object.keys(data);
   347→  if (keys.length > 0) {
   348→    return `{${keys.slice(0, 3).join(", ")}${keys.length > 3 ? ", ..." : ""}}`;
   349→  }
   350→  return "";
   351→}
   352→
   353→/**
   354→ * Format the session log show output.
   355→ *
   356→ * AC: @session-log-show ac-1
   357→ */
   358→function formatSessionLogShow(
   359→  detail: SessionLogDetail,
   360→  events: SessionEvent[] | null,
   361→  contextSnapshot: unknown,
   362→  sessionStartTs: number,
   363→): void {
   364→  // AC: @session-log-show ac-1 - Session metadata
   365→  console.log(chalk.bold(`Session ${detail.id.slice(0, 8)}`));
   366→  console.log(chalk.gray("─".repeat(60)));
   367→  console.log(`  ID:        ${detail.id}`);
   368→
   369→  console.log(`  Status:    ${sessionStatusColor(detail.status)(detail.status)}`);
   370→  console.log(`  Agent:     ${detail.agent_type}`);
   371→  if (detail.task_id) {
   372→    console.log(`  Task:      ${detail.task_id}`);
   373→  }
   374→  console.log(`  Started:   ${detail.started_at}`);
   375→  if (detail.ended_at) {
   376→    console.log(`  Ended:     ${detail.ended_at}`);
   377→  }
   378→  console.log(`  Duration:  ${formatDurationCompact(detail.duration_ms)}`);
   379→  console.log(`  Events:    ${detail.event_count}`);
   380→  console.log(`  Iterations: ${detail.iteration_count}`);
   381→
   382→  // AC: @session-log-show ac-2 - Per-iteration summary
   383→  if (detail.iterations.length > 0) {
   384→    console.log("\n" + chalk.bold("Iterations"));
   385→    console.log(chalk.gray("─".repeat(60)));
   386→    for (const iter of detail.iterations) {
   387→      const taskInfo: string[] = [];
   388→      if (iter.tasks_started.length > 0) {
   389→        taskInfo.push(`started: ${iter.tasks_started.join(", ")}`);
   390→      }
   391→      if (iter.tasks_completed.length > 0) {
   392→        taskInfo.push(`completed: ${iter.tasks_completed.join(", ")}`);
   393→      }
   394→      const taskStr = taskInfo.length > 0 ? ` | ${taskInfo.join(" | ")}` : "";
   395→      console.log(
   396→        `  ${chalk.cyan(`[${iter.iteration}]`)} ${iter.event_count} events${taskStr}`,
   397→      );
   398→    }
   399→  }
   400→
   401→  // AC: @session-log-show ac-3 - Event timeline
   402→  if (events !== null) {
   403→    console.log("\n" + chalk.bold("Events"));
   404→    console.log(chalk.gray("─".repeat(60)));
   405→    if (events.length === 0) {
   406→      console.log(chalk.gray("  No events to display."));
   407→    } else {
   408→      for (const event of events) {
   409→        const timestamp = formatEventTimestamp(event.ts, sessionStartTs);
   410→        const summary = summarizeEventData(event);
   411→        const typeColor =
   412→          event.type === "session.start" || event.type === "session.end"
   413→            ? chalk.green
   414→            : event.type === "session.update"
   415→              ? chalk.blue
   416→              : chalk.gray;
   417→        console.log(
   418→          `  ${chalk.yellow(timestamp.padEnd(10))} ${typeColor(event.type.padEnd(16))} ${chalk.gray(summary)}`,
   419→        );
   420→      }
   421→    }
   422→  }
   423→
   424→  // AC: @session-log-show ac-6 - Context snapshot
   425→  if (contextSnapshot !== null) {
   426→    console.log("\n" + chalk.bold("Context Snapshot"));
   427→    console.log(chalk.gray("─".repeat(60)));
   428→    console.log(JSON.stringify(contextSnapshot, null, 2));
   429→  }
   430→}
   431→
   432→/**
   433→ * Session log show action handler.
   434→ */
   435→export async function sessionLogShowAction(
   436→  sessionRef: string,
   437→  options: SessionLogShowOptions,
   438→): Promise<void> {
   439→  try {
   440→    const ctx = await initContext();
   441→
   442→    // AC: @session-log-show ac-7, ac-8, ac-9 - Resolve session ID
   443→    const resolution = await resolveSessionId(ctx.specDir, sessionRef);
   444→
   445→    if (!resolution.ok) {
   446→      if (resolution.error === "not_found") {
   447→        // AC: @session-log-show ac-9
   448→        error(`Session not found: ${sessionRef}`);
   449→        process.exit(EXIT_CODES.NOT_FOUND);
   450→      } else {
   451→        // AC: @session-log-show ac-8
   452→        error(
   453→          `Ambiguous session ID prefix. Matches:\n  ${resolution.matches.join("\n  ")}\nPlease provide a more specific prefix.`,
   454→        );
   455→        process.exit(EXIT_CODES.VALIDATION_FAILED);
   456→      }
   457→    }
   458→
   459→    const sessionId = resolution.id;
   460→
   461→    // Get session detail
   462→    const detail = await getSessionLogDetail(ctx.specDir, sessionId);
   463→    if (!detail) {
   464→      error(`Session not found: ${sessionId}`);
   465→      process.exit(EXIT_CODES.NOT_FOUND);
   466→    }
   467→
   468→    if (options.resolveBlobs && !options.events) {
   469→      warn("--resolve-blobs has no effect without --events; showing metadata only.");
   470→    }
   471→
   472→    // AC: @session-log-show ac-3, ac-4, ac-5 - Event timeline
   473→    let events: SessionEvent[] | null = null;
   474→    if (options.events) {
   475→      let allEvents = deduplicatePhasedToolCalls(
   476→        await readEvents(ctx.specDir, sessionId),
   477→      );
   478→
   479→      // AC: @session-log-show ac-4 - Filter by type
   480→      if (options.type) {
   481→        const typeFilter = options.type;
   482→        allEvents = allEvents.filter((e) => e.type === typeFilter);
   483→      }
   484→
   485→      // AC: @session-log-show ac-5 - Limit to last N events
   486→      if (options.limit) {
   487→        const limit = parseInt(options.limit, 10);
   488→        if (!Number.isNaN(limit) && limit > 0) {
   489→          allEvents = allEvents.slice(-limit);
   490→        }
   491→      }
   492→
   493→      if (options.resolveBlobs) {
   494→        allEvents = await Promise.all(
   495→          allEvents.map(async (event) => ({
   496→            ...event,
   497→            data: await resolveSessionBlobPointers(
   498→              ctx.specDir,
   499→              sessionId,
   500→              event.data,
   501→            ),
   502→          })),
   503→        );
   504→      }
   505→
   506→      events = allEvents;
   507→    }
   508→
   509→    // AC: @session-log-show ac-6 - Context snapshot
   510→    let contextSnapshot: unknown = null;
   511→    if (options.context) {
   512→      const iterNum = parseInt(options.context, 10);
   513→      if (!Number.isNaN(iterNum) && iterNum > 0) {
   514→        contextSnapshot = await readSessionContext(
   515→          ctx.specDir,
   516→          sessionId,
   517→          iterNum,
   518→        );
   519→        if (contextSnapshot === null) {
   520→          error(`No context snapshot found for iteration ${iterNum}`);
   521→          process.exit(EXIT_CODES.NOT_FOUND);
   522→        }
   523→      } else {
   524→        error(`Invalid iteration number: ${options.context}`);
   525→        process.exit(EXIT_CODES.USAGE_ERROR);
   526→      }
   527→    }
   528→
   529→    const sessionStartTs = new Date(detail.started_at).getTime();
   530→
   531→    // Build JSON output structure
   532→    const jsonOutput = {
   533→      ...detail,
   534→      ...(events !== null ? { events } : {}),
   535→      ...(contextSnapshot !== null ? { context: contextSnapshot } : {}),
   536→    };
   537→
   538→    output(jsonOutput, () =>
   539→      formatSessionLogShow(detail, events, contextSnapshot, sessionStartTs),
   540→    );
   541→  } catch (err) {
   542→    error("Failed to show session log", err);
   543→    process.exit(EXIT_CODES.ERROR);
   544→  }
   545→}
   546→
   547→// ─── Session Log Stats ──────────────────────────────────────────────────────
   548→
   549→interface SessionLogStatsOptions {
   550→  since?: string;
   551→  agent?: string;
   552→  toolUsage?: boolean;
   553→  byDay?: boolean;
   554→  byWeek?: boolean;
   555→}
   556→
   557→/**
   558→ * Full stats output including optional tool usage and time period data.
   559→ */
   560→interface SessionLogStatsOutput {
   561→  stats: SessionLogStats;
   562→  tool_usage?: ToolUsageStats[];
   563→  time_periods?: TimePeriodStats[];
   564→}
   565→
   566→/**
   567→ * Format the session log stats output.
   568→ *
   569→ * AC: @session-log-stats ac-1, ac-2, ac-3
   570→ */
   571→function formatSessionLogStats(
   572→  stats: SessionLogStats,
   573→  toolUsage: ToolUsageStats[] | null,
   574→  timePeriods: TimePeriodStats[] | null,
   575→  groupBy: "day" | "week" | null,
   576→): void {
   577→  // AC: @session-log-stats ac-1 - Totals
   578→  console.log(chalk.bold("Session Statistics"));
   579→  console.log(chalk.gray("─".repeat(50)));
   580→  console.log(`  Total Sessions:     ${stats.total_sessions}`);
   581→  console.log(`  Total Events:       ${stats.total_events}`);
   582→  console.log(`  Total Iterations:   ${stats.total_iterations}`);
   583→  console.log(`  Tasks Completed:    ${stats.total_tasks_completed}`);
   584→  console.log(`  Total Duration:     ${formatDurationVerbose(stats.total_duration_ms)}`);
   585→
   586→  // AC: @session-log-stats ac-2 - Averages
   587→  console.log("\n" + chalk.bold("Averages"));
   588→  console.log(chalk.gray("─".repeat(50)));
   589→  console.log(`  Avg Duration/Session:     ${formatDurationVerbose(stats.avg_duration_ms)}`);
   590→  console.log(`  Avg Iterations/Session:   ${stats.avg_iterations_per_session}`);
   591→  console.log(`  Avg Tasks/Session:        ${stats.avg_tasks_per_session}`);
   592→
   593→  // AC: @session-log-stats ac-3 - Status breakdown
   594→  if (stats.status_breakdown.length > 0) {
   595→    console.log("\n" + chalk.bold("Status Breakdown"));
   596→    console.log(chalk.gray("─".repeat(50)));
   597→    for (const item of stats.status_breakdown) {
   598→      console.log(
   599→        `  ${sessionStatusColor(item.status)(item.status.padEnd(12))} ${String(item.count).padEnd(6)} ${item.percentage}%`,
   600→      );
   601→    }
   602→  }
   603→
   604→  // AC: @session-log-stats ac-6 - Tool usage
   605→  if (toolUsage !== null && toolUsage.length > 0) {
   606→    console.log("\n" + chalk.bold("Top Tool Usage"));
   607→    console.log(chalk.gray("─".repeat(50)));
   608→    for (const tool of toolUsage) {
   609→      console.log(
   610→        `  ${tool.tool_name.padEnd(20)} ${String(tool.count).padEnd(8)} ${tool.percentage}%`,
   611→      );
   612→    }
   613→  }
   614→
   615→  // AC: @session-log-stats ac-7 - Time periods
   616→  if (timePeriods !== null && timePeriods.length > 0) {
   617→    const label = groupBy === "week" ? "By Week" : "By Day";
   618→    console.log("\n" + chalk.bold(label));
   619→    console.log(chalk.gray("─".repeat(50)));
   620→    console.log(
   621→      chalk.gray(
   622→        `  ${"Period".padEnd(14)} ${"Sessions".padEnd(10)} ${"Tasks".padEnd(8)} Duration`,
   623→      ),
   624→    );
   625→    for (const period of timePeriods) {
   626→      console.log(
   627→        `  ${period.period.padEnd(14)} ${String(period.sessions_count).padEnd(10)} ${String(period.tasks_completed).padEnd(8)} ${formatDurationVerbose(period.total_duration_ms)}`,
   628→      );
   629→    }
   630→  }
   631→}
   632→
   633→/**
   634→ * Session log stats action handler.
   635→ */
   636→export async function sessionLogStatsAction(
   637→  options: SessionLogStatsOptions,
   638→): Promise<void> {
   639→  try {
   640→    const ctx = await initContext();
   641→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
   642→
   643→    // AC: @session-log-stats ac-4 - Filter by since
   644→    if (options.since) {
   645→      const sinceDate = parseTimeSpec(options.since);
   646→      if (sinceDate) {
   647→        sessions = sessions.filter(
   648→          (s) => new Date(s.started_at) >= sinceDate,
   649→        );
   650→      }
   651→    }
   652→
   653→    // AC: @session-log-stats ac-5 - Filter by agent type
   654→    if (options.agent) {
   655→      const agentFilter = options.agent;
   656→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
   657→    }
   658→
   659→    // AC: @session-log-stats ac-8 - No sessions match criteria
   660→    if (sessions.length === 0) {
   661→      output({ message: "No sessions match criteria" }, () => {
   662→        console.log("No sessions match criteria.");
   663→      });
   664→      return;
   665→    }
   666→
   667→    // Compute base stats
   668→    const stats = computeSessionLogStats(sessions);
   669→
   670→    // AC: @session-log-stats ac-6 - Tool usage (optional)
   671→    let toolUsage: ToolUsageStats[] | null = null;
   672→    if (options.toolUsage) {
   673→      const sessionIds = sessions.map((s) => s.id);
   674→      toolUsage = await computeToolUsageStats(ctx.specDir, sessionIds);
   675→    }
   676→
   677→    // AC: @session-log-stats ac-7 - Time periods (optional)
   678→    let timePeriods: TimePeriodStats[] | null = null;
   679→    let groupBy: "day" | "week" | null = null;
   680→    if (options.byDay) {
   681→      groupBy = "day";
   682→      timePeriods = computeTimePeriodStats(sessions, "day");
   683→    } else if (options.byWeek) {
   684→      groupBy = "week";
   685→      timePeriods = computeTimePeriodStats(sessions, "week");
   686→    }
   687→
   688→    // Build output structure
   689→    const jsonOutput: SessionLogStatsOutput = { stats };
   690→    if (toolUsage !== null) {
   691→      jsonOutput.tool_usage = toolUsage;
   692→    }
   693→    if (timePeriods !== null) {
   694→      jsonOutput.time_periods = timePeriods;
   695→    }
   696→
   697→    output(jsonOutput, () =>
   698→      formatSessionLogStats(stats, toolUsage, timePeriods, groupBy),
   699→    );
   700→  } catch (err) {
   701→    error("Failed to compute session log stats", err);
   702→    process.exit(EXIT_CODES.ERROR);
   703→  }
   704→}
   705→
   706→// ─── Session Log Search ─────────────────────────────────────────────────────
   707→
   708→interface SessionLogSearchOptions {
   709→  type?: string;
   710→  since?: string;
   711→  agent?: string;
   712→  limit?: string;
   713→  resolveBlobs?: boolean;
   714→}
   715→
   716→/**
   717→ * Format the session log search output.
   718→ *
   719→ * AC: @session-log-search ac-1, ac-4
   720→ */
   721→function formatSessionLogSearch(results: SessionSearchResult[]): void {
   722→  if (results.length === 0) {
   723→    // AC: @session-log-search ac-6
   724→    console.log("No matches found.");
   725→    return;
   726→  }
   727→
   728→  let totalMatches = 0;
   729→  for (const session of results) {
   730→    totalMatches += session.matches.length;
   731→  }
   732→
   733→  console.log(chalk.bold(`Found ${totalMatches} match(es) in ${results.length} session(s)`));
   734→  console.log(chalk.gray("─".repeat(60)));
   735→
   736→  for (const session of results) {
   737→    // Session header
   738→    console.log(
   739→      `\n${chalk.cyan(`Session ${session.session_id.slice(0, 8)}`)} ` +
   740→        `${chalk.gray(`(${session.agent_type}, started ${formatRelativeTime(new Date(session.started_at))})`)}`
   741→    );
   742→
   743→    // AC: @session-log-search ac-4 - Show matches with session ID, timestamp, type, excerpt
   744→    for (const match of session.matches) {
   745→      const ts = new Date(match.timestamp).toISOString();
   746→      const typeColor =
   747→        match.event_type === "session.start" || match.event_type === "session.end"
   748→          ? chalk.green
   749→          : match.event_type === "session.update"
   750→            ? chalk.blue
   751→            : chalk.gray;
   752→      console.log(
   753→        `  ${chalk.yellow(ts)} ${typeColor(match.event_type.padEnd(16))}`,
   754→      );
   755→      // Content excerpt on next line, indented
   756→      console.log(`    ${chalk.gray(match.content_excerpt)}`);
   757→    }
   758→  }
   759→}
   760→
   761→/**
   762→ * Session log search action handler.
   763→ *
   764→ * AC: @session-log-search ac-1 through ac-7
   765→ */
   766→export async function sessionLogSearchAction(
   767→  pattern: string,
   768→  options: SessionLogSearchOptions,
   769→): Promise<void> {
   770→  try {
   771→    const ctx = await initContext();
   772→
   773→    // Parse options - validate limit as positive integer
   774→    let limit = 50;
   775→    if (options.limit) {
   776→      const parsed = parseInt(options.limit, 10);
   777→      if (Number.isNaN(parsed) || parsed <= 0) {
   778→        error(`Invalid limit: ${options.limit}. Must be a positive integer.`);
   779→        process.exit(EXIT_CODES.USAGE_ERROR);
   780→      }
   781→      limit = parsed;
   782→    }
   783→    const sinceDate = options.since ? parseTimeSpec(options.since) : undefined;
   784→
   785→    // AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7
   786→    const results = await searchSessionEvents(ctx.specDir, pattern, {
   787→      eventType: options.type,
   788→      sinceDate: sinceDate || undefined,
   789→      agentType: options.agent,
   790→      limit,
   791→      resolveBlobs: options.resolveBlobs,
   792→    });
   793→
   794→    // AC: @session-log-search ac-6 - No matches found message
   795→    // exit code 0 regardless (per @trait-semantic-exit-codes ac-5)
   796→
   797→    output(results, () => formatSessionLogSearch(results));
   798→  } catch (err) {
   799→    error("Failed to search session logs", err);
   800→    process.exit(EXIT_CODES.ERROR);
   801→  }
   802→}
