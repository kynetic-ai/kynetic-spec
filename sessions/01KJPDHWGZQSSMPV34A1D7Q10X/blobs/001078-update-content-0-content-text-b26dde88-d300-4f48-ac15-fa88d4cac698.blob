   142→
   143→  it('should accept event without optional trace_id', () => {
   144→    const event = {
   145→      ts: Date.now(),
   146→      seq: 0,
   147→      type: 'session.start',
   148→      session_id: '01KF123456789ABCDEFGHJKMNP',
   149→      data: null,
   150→    };
   151→
   152→    const result = SessionEventSchema.safeParse(event);
   153→    expect(result.success).toBe(true);
