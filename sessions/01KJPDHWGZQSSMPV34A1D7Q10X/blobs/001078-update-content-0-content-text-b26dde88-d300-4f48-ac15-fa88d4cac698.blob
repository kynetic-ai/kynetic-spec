   207→// ─── Storage Tests ───────────────────────────────────────────────────────────
   208→
   209→describe('Session storage', () => {
   210→  let testDir: string;
   211→
   212→  beforeEach(async () => {
   213→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-test-'));
   214→  });
   215→
   216→  afterEach(async () => {
   217→    await fs.rm(testDir, { recursive: true });
   218→  });
   219→
   220→  describe('createSession', () => {
   221→    // AC: @session-events ac-1
   222→    it('should create session directory and metadata file', async () => {
   223→      const input: SessionMetadataInput = {
   224→        id: '01KF123456789ABCDEFGHJKMNP',
   225→        agent_type: 'claude-code',
   226→      };
   227→
   228→      const metadata = await createSession(testDir, input);
   229→
   230→      // Check metadata returned
   231→      expect(metadata.id).toBe(input.id);
   232→      expect(metadata.agent_type).toBe(input.agent_type);
   233→      expect(metadata.status).toBe('active');
   234→      expect(metadata.started_at).toBeDefined();
   235→
   236→      // Check directory was created
   237→      const sessionDir = getSessionDir(testDir, input.id);
   238→      const stat = await fs.stat(sessionDir);
   239→      expect(stat.isDirectory()).toBe(true);
   240→
   241→      // Check metadata file was created
   242→      const metadataPath = getSessionMetadataPath(testDir, input.id);
   243→      const content = await fs.readFile(metadataPath, 'utf-8');
   244→      expect(content).toContain('id: ' + input.id);
   245→      expect(content).toContain('agent_type: claude-code');
   246→      expect(content).toContain('status: active');
   247→    });
   248→
   249→    // AC: @session-events ac-5
   250→    it('should include optional task_id in metadata', async () => {
   251→      const input: SessionMetadataInput = {
   252→        id: '01KF123456789ABCDEFGHJKMNP',
   253→        agent_type: 'claude-code',
   254→        task_id: '@my-task',
   255→      };
   256→
   257→      const metadata = await createSession(testDir, input);
   258→
   259→      expect(metadata.task_id).toBe('@my-task');
   260→
   261→      const metadataPath = getSessionMetadataPath(testDir, input.id);
   262→      const content = await fs.readFile(metadataPath, 'utf-8');
   263→      // Accept both single and double quotes (yaml library uses double quotes)
   264→      expect(content).toMatch(/task_id: ["']@my-task["']/);
   265→    });
   266→
   267→    it('should use provided started_at if given', async () => {
   268→      const startTime = '2026-01-17T10:00:00.000Z';
   269→      const input: SessionMetadataInput = {
   270→        id: '01KF123456789ABCDEFGHJKMNP',
   271→        agent_type: 'claude-code',
   272→        started_at: startTime,
   273→      };
   274→
   275→      const metadata = await createSession(testDir, input);
   276→
   277→      expect(metadata.started_at).toBe(startTime);
   278→    });
   279→  });
   280→
   281→  describe('getSession', () => {
   282→    it('should return session metadata if exists', async () => {
   283→      const input: SessionMetadataInput = {
   284→        id: '01KF123456789ABCDEFGHJKMNP',
   285→        agent_type: 'claude-code',
   286→      };
   287→
   288→      await createSession(testDir, input);
   289→      const metadata = await getSession(testDir, input.id);
   290→
   291→      expect(metadata).not.toBeNull();
   292→      expect(metadata?.id).toBe(input.id);
   293→      expect(metadata?.agent_type).toBe(input.agent_type);
   294→    });
   295→
   296→    it('should return null if session does not exist', async () => {
   297→      const metadata = await getSession(testDir, 'nonexistent');
   298→
   299→      expect(metadata).toBeNull();
   300→    });
   301→  });
   302→
   303→  describe('updateSessionStatus', () => {
   304→    // AC: @session-events ac-6
   305→    it('should update status and set ended_at when completing', async () => {
   306→      const input: SessionMetadataInput = {
   307→        id: '01KF123456789ABCDEFGHJKMNP',
   308→        agent_type: 'claude-code',
   309→      };
   310→
   311→      await createSession(testDir, input);
   312→      const updated = await updateSessionStatus(testDir, input.id, 'completed');
   313→
   314→      expect(updated).not.toBeNull();
   315→      expect(updated?.status).toBe('completed');
   316→      expect(updated?.ended_at).toBeDefined();
   317→
   318→      // Verify persisted
   319→      const reloaded = await getSession(testDir, input.id);
   320→      expect(reloaded?.status).toBe('completed');
   321→      expect(reloaded?.ended_at).toBeDefined();
   322→    });
   323→
   324→    // AC: @session-events ac-6
   325→    it('should set ended_at when abandoning', async () => {
   326→      const input: SessionMetadataInput = {
   327→        id: '01KF123456789ABCDEFGHJKMNP',
   328→        agent_type: 'claude-code',
   329→      };
   330→
   331→      await createSession(testDir, input);
   332→      const updated = await updateSessionStatus(testDir, input.id, 'abandoned');
   333→
   334→      expect(updated?.status).toBe('abandoned');
   335→      expect(updated?.ended_at).toBeDefined();
   336→    });
   337→
   338→    it('should return null if session does not exist', async () => {
   339→      const updated = await updateSessionStatus(testDir, 'nonexistent', 'completed');
   340→
   341→      expect(updated).toBeNull();
   342→    });
   343→  });
   344→
   345→  describe('listSessions', () => {
   346→    it('should list all session IDs', async () => {
   347→      await createSession(testDir, { id: 'session-a', agent_type: 'claude-code' });
   348→      await createSession(testDir, { id: 'session-b', agent_type: 'claude-code' });
   349→      await createSession(testDir, { id: 'session-c', agent_type: 'test-agent' });
   350→
   351→      const sessions = await listSessions(testDir);
   352→
   353→      expect(sessions).toHaveLength(3);
   354→      expect(sessions).toContain('session-a');
   355→      expect(sessions).toContain('session-b');
   356→      expect(sessions).toContain('session-c');
   357→    });
   358→
   359→    it('should return empty array if no sessions', async () => {
   360→      const sessions = await listSessions(testDir);
   361→
   362→      expect(sessions).toHaveLength(0);
   363→    });
   364→  });
   365→
   366→  describe('sessionExists', () => {
   367→    it('should return true if session exists', async () => {
   368→      await createSession(testDir, { id: 'my-session', agent_type: 'claude-code' });
   369→
   370→      const exists = await sessionExists(testDir, 'my-session');
   371→
   372→      expect(exists).toBe(true);
   373→    });
   374→
   375→    it('should return false if session does not exist', async () => {
   376→      const exists = await sessionExists(testDir, 'nonexistent');
   377→
   378→      expect(exists).toBe(false);
   379→    });
   380→  });
   381→});
