    40→// ─── Schema Tests ────────────────────────────────────────────────────────────
    41→
    42→describe('SessionStatusSchema', () => {
    43→  it('should accept valid status values', () => {
    44→    expect(SessionStatusSchema.safeParse('active').success).toBe(true);
    45→    expect(SessionStatusSchema.safeParse('completed').success).toBe(true);
    46→    expect(SessionStatusSchema.safeParse('abandoned').success).toBe(true);
    47→  });
    48→
    49→  it('should reject invalid status values', () => {
    50→    expect(SessionStatusSchema.safeParse('invalid').success).toBe(false);
    51→    expect(SessionStatusSchema.safeParse('pending').success).toBe(false);
    52→    expect(SessionStatusSchema.safeParse('').success).toBe(false);
    53→  });
    54→});
    55→
    56→describe('EventTypeSchema', () => {
    57→  it('should accept valid event types', () => {
    58→    expect(EventTypeSchema.safeParse('session.start').success).toBe(true);
    59→    expect(EventTypeSchema.safeParse('session.update').success).toBe(true);
    60→    expect(EventTypeSchema.safeParse('iteration.timeout').success).toBe(true);
    61→    expect(EventTypeSchema.safeParse('session.end').success).toBe(true);
    62→    expect(EventTypeSchema.safeParse('prompt.sent').success).toBe(true);
    63→    expect(EventTypeSchema.safeParse('tool.call').success).toBe(true);
    64→    expect(EventTypeSchema.safeParse('tool.result').success).toBe(true);
    65→    expect(EventTypeSchema.safeParse('note').success).toBe(true);
    66→  });
    67→
    68→  it('should reject invalid event types', () => {
    69→    expect(EventTypeSchema.safeParse('invalid').success).toBe(false);
    70→    expect(EventTypeSchema.safeParse('session_start').success).toBe(false);
    71→    expect(EventTypeSchema.safeParse('').success).toBe(false);
    72→  });
    73→});
    74→
    75→describe('SessionMetadataSchema', () => {
    76→  // AC: @session-events ac-5
    77→  it('should accept valid session metadata with all fields', () => {
    78→    const metadata = {
    79→      id: '01KF123456789ABCDEFGHJKMNP',
    80→      task_id: '@my-task',
    81→      agent_type: 'claude-code',
    82→      status: 'active',
    83→      started_at: '2026-01-17T10:00:00.000Z',
    84→    };
    85→
    86→    const result = SessionMetadataSchema.safeParse(metadata);
    87→    expect(result.success).toBe(true);
    88→  });
    89→
    90→  // AC: @session-events ac-5
    91→  it('should accept metadata without optional task_id', () => {
    92→    const metadata = {
    93→      id: '01KF123456789ABCDEFGHJKMNP',
    94→      agent_type: 'claude-code',
    95→      status: 'active',
    96→      started_at: '2026-01-17T10:00:00.000Z',
    97→    };
    98→
    99→    const result = SessionMetadataSchema.safeParse(metadata);
   100→    expect(result.success).toBe(true);
   101→  });
   102→
   103→  it('should accept completed status with ended_at', () => {
   104→    const metadata = {
   105→      id: '01KF123456789ABCDEFGHJKMNP',
   106→      agent_type: 'claude-code',
   107→      status: 'completed',
   108→      started_at: '2026-01-17T10:00:00.000Z',
   109→      ended_at: '2026-01-17T11:00:00.000Z',
   110→    };
   111→
   112→    const result = SessionMetadataSchema.safeParse(metadata);
   113→    expect(result.success).toBe(true);
   114→  });
   115→
   116→  it('should reject metadata without required fields', () => {
   117→    const metadata = {
   118→      id: '01KF123456789ABCDEFGHJKMNP',
   119→      status: 'active',
   120→    };
   121→
   122→    const result = SessionMetadataSchema.safeParse(metadata);
