   197→    );
   198→  });
   199→
   200→  it('should construct events file path', () => {
   201→    expect(getSessionEventsPath(specDir, sessionId)).toBe(
   202→      `/test/.kspec/sessions/${sessionId}/events.jsonl`
   203→    );
   204→  });
   205→});
