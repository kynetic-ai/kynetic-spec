   789→  describe('commit boundary inclusion', () => {
   790→    // AC: @session-events ac-7
   791→    it('should include accumulated events in the next git commit', async () => {
   792→      const repoDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-commit-test-'));
   793→      const boundarySessionId = '01KF123456789ABCDEFGHJKMNQ';
   794→
   795→      const runGit = (...args: string[]) => {
   796→        const result = spawnSync('git', args, {
   797→          cwd: repoDir,
   798→          encoding: 'utf-8',
   799→        });
   800→        if (result.status !== 0) {
   801→          throw new Error(result.stderr || `git ${args.join(' ')} failed`);
   802→        }
   803→        return result.stdout.trim();
   804→      };
   805→
   806→      try {
   807→        runGit('init', '-b', 'main');
   808→        runGit('config', 'user.email', 'test@example.com');
   809→        runGit('config', 'user.name', 'Test User');
   810→
   811→        await fs.writeFile(path.join(repoDir, 'README.md'), '# test\n', 'utf-8');
   812→        runGit('add', 'README.md');
   813→        runGit('commit', '-m', 'test: initial commit');
   814→
   815→        await appendEvent(repoDir, {
   816→          type: 'session.update',
   817→          session_id: boundarySessionId,
   818→          data: {
   819→            update: {
   820→              rawInput: {
   821→                command: 'kspec task complete @task-ref --reason "Done"',
   822→              },
   823→            },
   824→          },
   825→        });
   826→
   827→        runGit('add', '.');
   828→        runGit('commit', '-m', 'test: commit boundary includes session events');
   829→
   830→        const committedFiles = runGit('show', '--name-only', '--pretty=format:', 'HEAD');
   831→        expect(committedFiles).toContain(`sessions/${boundarySessionId}/events.jsonl`);
   832→      } finally {
   833→        await fs.rm(repoDir, { recursive: true, force: true });
   834→      }
   835→    });
   836→  });
