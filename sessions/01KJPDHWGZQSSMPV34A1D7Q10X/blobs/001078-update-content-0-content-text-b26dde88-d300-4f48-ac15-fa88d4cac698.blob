   165→
   166→  it('should reject negative sequence number', () => {
   167→    const event = {
   168→      ts: Date.now(),
   169→      seq: -1,
   170→      type: 'session.start',
   171→      session_id: '01KF123456789ABCDEFGHJKMNP',
   172→      data: null,
   173→    };
   174→
   175→    const result = SessionEventSchema.safeParse(event);
