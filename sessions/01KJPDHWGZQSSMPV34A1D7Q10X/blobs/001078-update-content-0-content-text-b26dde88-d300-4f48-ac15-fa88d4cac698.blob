   186→  it('should construct sessions directory path', () => {
   187→    expect(getSessionsDir(specDir)).toBe('/test/.kspec/sessions');
   188→  });
   189→
   190→  it('should construct session directory path', () => {
   191→    expect(getSessionDir(specDir, sessionId)).toBe(`/test/.kspec/sessions/${sessionId}`);
   192→  });
   193→
   194→  it('should construct metadata file path', () => {
