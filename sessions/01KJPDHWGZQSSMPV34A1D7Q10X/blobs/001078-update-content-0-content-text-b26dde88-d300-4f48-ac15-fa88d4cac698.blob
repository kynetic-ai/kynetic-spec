   383→// ─── Event Storage Tests ─────────────────────────────────────────────────────
   384→
   385→describe('Event storage', () => {
   386→  let testDir: string;
   387→  const sessionId = '01KF123456789ABCDEFGHJKMNP';
   388→
   389→  beforeEach(async () => {
   390→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-event-test-'));
   391→  });
   392→
   393→  afterEach(async () => {
   394→    await fs.rm(testDir, { recursive: true });
   395→  });
   396→
   397→  describe('appendEvent', () => {
   398→    // AC: @session-events ac-2
   399→    it('should append event with auto-assigned ts and seq', async () => {
   400→      const input: SessionEventInput = {
   401→        type: 'session.start',
   402→        session_id: sessionId,
   403→        data: { message: 'Starting session' },
   404→      };
   405→
   406→      const event = await appendEvent(testDir, input);
   407→
   408→      expect(event.ts).toBeDefined();
   409→      expect(event.ts).toBeGreaterThan(0);
   410→      expect(event.seq).toBe(0);
   411→      expect(event.type).toBe('session.start');
   412→      expect(event.session_id).toBe(sessionId);
   413→      expect(event.data).toEqual({ message: 'Starting session' });
   414→    });
   415→
   416→    // AC: @session-events ac-2
   417→    it('should auto-increment seq for subsequent events', async () => {
   418→      const event1 = await appendEvent(testDir, {
   419→        type: 'session.start',
   420→        session_id: sessionId,
   421→        data: null,
   422→      });
   423→
   424→      const event2 = await appendEvent(testDir, {
   425→        type: 'prompt.sent',
   426→        session_id: sessionId,
   427→        data: { prompt: 'Hello' },
   428→      });
   429→
   430→      const event3 = await appendEvent(testDir, {
   431→        type: 'tool.call',
   432→        session_id: sessionId,
   433→        data: { tool: 'Read' },
   434→      });
   435→
   436→      expect(event1.seq).toBe(0);
   437→      expect(event2.seq).toBe(1);
   438→      expect(event3.seq).toBe(2);
   439→    });
   440→
   441→    // AC: @session-events ac-2
   442→    it('should derive next seq from the last stored event seq', async () => {
   443→      const sessionDir = getSessionDir(testDir, sessionId);
   444→      const eventsPath = getSessionEventsPath(testDir, sessionId);
   445→      await fs.mkdir(sessionDir, { recursive: true });
   446→
   447→      const existing = [
   448→        {
   449→          ts: 1000,
   450→          seq: 5,
   451→          type: 'session.start',
   452→          session_id: sessionId,
   453→          data: null,
   454→        },
   455→        {
   456→          ts: 2000,
   457→          seq: 9,
   458→          type: 'session.update',
   459→          session_id: sessionId,
   460→          data: { message: 'existing tail event' },
   461→        },
   462→      ];
   463→      await fs.writeFile(
   464→        eventsPath,
   465→        `${existing.map((event) => JSON.stringify(event)).join('\n')}\n`,
   466→        'utf-8',
   467→      );
   468→
   469→      const next = await appendEvent(testDir, {
   470→        type: 'prompt.sent',
   471→        session_id: sessionId,
   472→        data: { prompt: 'new event' },
   473→      });
   474→
   475→      expect(next.seq).toBe(10);
   476→    });
   477→
   478→    // AC: @session-events ac-3
   479→    it('should create session directory if it does not exist (lazy creation)', async () => {
   480→      const event = await appendEvent(testDir, {
   481→        type: 'session.start',
   482→        session_id: sessionId,
   483→        data: null,
   484→      });
   485→
   486→      expect(event.seq).toBe(0);
   487→
   488→      // Verify directory was created
   489→      const sessionDir = getSessionDir(testDir, sessionId);
   490→      const stat = await fs.stat(sessionDir);
   491→      expect(stat.isDirectory()).toBe(true);
   492→    });
   493→
   494→    it('should preserve optional trace_id', async () => {
   495→      const event = await appendEvent(testDir, {
   496→        type: 'session.start',
   497→        session_id: sessionId,
   498→        trace_id: 'trace-abc-123',
   499→        data: null,
   500→      });
   501→
   502→      expect(event.trace_id).toBe('trace-abc-123');
   503→    });
   504→
   505→    // AC: @session-events ac-3
   506→    it('should write event as JSON line to events.jsonl', async () => {
   507→      await appendEvent(testDir, {
   508→        type: 'session.start',
   509→        session_id: sessionId,
   510→        data: { key: 'value' },
   511→      });
   512→
   513→      await appendEvent(testDir, {
   514→        type: 'prompt.sent',
   515→        session_id: sessionId,
   516→        data: { prompt: 'test' },
   517→      });
   518→
   519→      const eventsPath = getSessionEventsPath(testDir, sessionId);
   520→      const content = await fs.readFile(eventsPath, 'utf-8');
   521→      const lines = content.trim().split('\n');
   522→
   523→      expect(lines).toHaveLength(2);
   524→
   525→      const event1 = JSON.parse(lines[0]);
   526→      expect(event1.type).toBe('session.start');
   527→      expect(event1.seq).toBe(0);
   528→
   529→      const event2 = JSON.parse(lines[1]);
   530→      expect(event2.type).toBe('prompt.sent');
   531→      expect(event2.seq).toBe(1);
   532→    });
   533→
   534→    // AC: @session-events ac-8
   535→    // AC: @session-events ac-9
   536→    it('should externalize oversized rawOutput and store pointer metadata', async () => {
   537→      const rawOutput = 'X'.repeat(20_000);
   538→
   539→      await appendEvent(testDir, {
   540→        type: 'session.update',
   541→        session_id: sessionId,
   542→        data: {
   543→          iteration: 1,
   544→          update: {
   545→            sessionUpdate: 'tool_call_update',
   546→            rawOutput,
   547→          },
   548→        },
   549→      });
   550→
   551→      const eventsPath = getSessionEventsPath(testDir, sessionId);
   552→      const lines = (await fs.readFile(eventsPath, 'utf-8')).trim().split('\n');
   553→      expect(lines).toHaveLength(1);
   554→
   555→      const stored = JSON.parse(lines[0]);
   556→      const pointer = stored.data.update.rawOutput as {
   557→        path: string;
   558→        bytes: number;
   559→        sha256: string;
   560→        truncated: boolean;
   561→        preview: string;
   562→      };
   563→      expect(pointer.path).toMatch(/^blobs\//);
   564→      expect(pointer.bytes).toBe(rawOutput.length);
   565→      expect(pointer.sha256).toBe(
   566→        createHash('sha256').update(rawOutput).digest('hex'),
   567→      );
   568→      expect(pointer.truncated).toBe(true);
   569→      expect(pointer.preview.length).toBeGreaterThan(0);
   570→      expect(pointer.preview.length).toBeLessThan(rawOutput.length);
   571→
   572→      const blobPath = path.join(getSessionDir(testDir, sessionId), pointer.path);
   573→      const blobContent = await fs.readFile(blobPath, 'utf-8');
   574→      expect(blobContent).toBe(rawOutput);
   575→    });
   576→
   577→    it('should generate UTF-8 safe previews for externalized payloads', async () => {
   578→      const rawOutput = '漢'.repeat(7_000);
   579→
   580→      await appendEvent(testDir, {
   581→        type: 'session.update',
   582→        session_id: sessionId,
   583→        data: {
   584→          iteration: 1,
   585→          update: {
   586→            sessionUpdate: 'tool_call_update',
   587→            rawOutput,
   588→          },
   589→        },
   590→      });
   591→
   592→      const eventsPath = getSessionEventsPath(testDir, sessionId);
   593→      const stored = JSON.parse((await fs.readFile(eventsPath, 'utf-8')).trim());
   594→      const pointer = stored.data.update.rawOutput as { preview: string };
   595→
   596→      expect(pointer.preview).toContain('...');
   597→      expect(pointer.preview).not.toContain('\uFFFD');
   598→    });
   599→
   600→    it('should cap oversized event lines by externalizing whole payload', async () => {
   601→      const giantPayload = 'Y'.repeat(320_000);
   602→
   603→      await appendEvent(testDir, {
   604→        type: 'prompt.sent',
   605→        session_id: sessionId,
   606→        data: {
   607→          prompt: giantPayload,
   608→        },
   609→      });
   610→
   611→      const eventsPath = getSessionEventsPath(testDir, sessionId);
   612→      const rawLine = (await fs.readFile(eventsPath, 'utf-8')).trim();
   613→      expect(Buffer.byteLength(rawLine, 'utf-8')).toBeLessThan(256 * 1024);
   614→
   615→      const parsed = JSON.parse(rawLine);
   616→      const pointer = parsed.data as {
   617→        path: string;
   618→        bytes: number;
   619→      };
   620→      expect(pointer.path).toMatch(/^blobs\//);
   621→
   622→      const blobPath = path.join(getSessionDir(testDir, sessionId), pointer.path);
   623→      const blobContent = await fs.readFile(blobPath, 'utf-8');
   624→      expect(Buffer.byteLength(blobContent, 'utf-8')).toBe(pointer.bytes);
   625→      expect(JSON.parse(blobContent)).toEqual({ prompt: giantPayload });
