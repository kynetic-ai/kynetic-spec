```
     1→/**
     2→ * Validation module for kspec files.
     3→ *
     4→ * Provides schema validation, reference validation, and orphan detection.
     5→ */
     6→
     7→import * as fs from "node:fs/promises";
     8→import * as path from "node:path";
     9→import {
    10→  AgentSchema,
    11→  ConventionSchema,
    12→  isSkill,
    13→  ManifestSchema,
    14→  MetaManifestSchema,
    15→  ObservationSchema,
    16→  SkillSchema,
    17→  SpecItemSchema,
    18→  TaskSchema,
    19→  TasksFileSchema,
    20→  UlidSchema,
    21→  WorkflowSchema,
    22→} from "../schema/index.js";
    23→import { findMetaManifest, getSkillContentPath, loadMetaContext, type LoadedSkill } from "./meta.js";
    24→import { loadPlans } from "./plans.js";
    25→import {
    26→  ReferenceIndex,
    27→  type RefValidationError,
    28→  type RefValidationWarning,
    29→  shortestUniqueUlid,
    30→  validateRefs,
    31→} from "./refs.js";
    32→import { TraitIndex } from "./traits.js";
    33→import type { KspecContext, LoadedSpecItem, LoadedTask } from "./yaml.js";
    34→import {
    35→  expandIncludePattern,
    36→  extractItemsFromRaw,
    37→  findTaskFiles,
    38→  loadSpecFile,
    39→  readYamlFile,
    40→} from "./yaml.js";
    41→
    42→// ============================================================
    43→// TYPES
    44→// ============================================================
    45→
    46→/**
    47→ * Schema validation error
    48→ */
    49→export interface SchemaValidationError {
    50→  file: string;
    51→  path?: string;
    52→  message: string;
    53→  details?: unknown;
    54→}
    55→
    56→/**
    57→ * Orphan item (not referenced by anything)
    58→ */
    59→export interface OrphanItem {
    60→  ulid: string;
    61→  title: string;
    62→  type: string;
    63→  file?: string;
    64→}
    65→
    66→/**
    67→ * Completeness warning types
    68→ */
    69→export type CompletenessWarningType =
    70→  | "missing_acceptance_criteria"
    71→  | "missing_description"
    72→  | "status_inconsistency"
    73→  | "missing_test_coverage"
    74→  | "automation_eligible_no_spec"
    75→  | "ac_schema_field_mismatch";
    76→
    77→/**
    78→ * Trait cycle error
    79→ */
    80→export interface TraitCycleError {
    81→  traitRef: string;
    82→  traitTitle: string;
    83→  cycle: string[];
    84→  message: string;
    85→}
    86→
    87→/**
    88→ * Completeness warning
    89→ */
    90→export interface CompletenessWarning {
    91→  type: CompletenessWarningType;
    92→  subtype?: "own_ac" | "trait_ac";
    93→  itemRef: string;
    94→  itemTitle: string;
    95→  message: string;
    96→  details?: string;
    97→}
    98→
    99→/**
   100→ * Complete validation result
   101→ */
   102→export interface ValidationResult {
   103→  valid: boolean;
   104→  schemaErrors: SchemaValidationError[];
   105→  refErrors: RefValidationError[];
   106→  refWarnings: RefValidationWarning[];
   107→  orphans: OrphanItem[];
   108→  completenessWarnings: CompletenessWarning[];
   109→  traitCycleErrors: TraitCycleError[];
   110→  stats: {
   111→    filesChecked: number;
   112→    itemsChecked: number;
   113→    tasksChecked: number;
   114→  };
   115→  metaStats?: {
   116→    agents: number;
   117→    workflows: number;
   118→    conventions: number;
   119→    observations: number;
   120→    skills: number;
   121→  };
   122→}
   123→
   124→/**
   125→ * Validation options
   126→ */
   127→export interface ValidateOptions {
   128→  /** Check schema conformance */
   129→  schema?: boolean;
   130→  /** Check reference resolution */
   131→  refs?: boolean;
   132→  /** Find orphaned items */
   133→  orphans?: boolean;
   134→  /** Check spec completeness (missing AC, descriptions, status inconsistencies) */
   135→  completeness?: boolean;
   136→  /**
   137→   * When true, dangling references are treated as errors instead of warnings.
   138→   * AC: @config-validation ac-2 ac-3 ac-4
   139→   */
   140→  strictRefs?: boolean;
   141→  /**
   142→   * When true, missing acceptance criteria are treated as errors instead of warnings.
   143→   * AC: @config-validation ac-1
   144→   */
   145→  requireAcceptance?: boolean;
   146→}
   147→
   148→// ============================================================
   149→// SCHEMA VALIDATION
   150→// ============================================================
   151→
   152→/**
   153→ * Validate a manifest file against schema
   154→ */
   155→async function validateManifestFile(
   156→  filePath: string,
   157→): Promise<SchemaValidationError[]> {
   158→  const errors: SchemaValidationError[] = [];
   159→
   160→  try {
   161→    const raw = await readYamlFile<unknown>(filePath);
   162→    const result = ManifestSchema.safeParse(raw);
   163→
   164→    if (!result.success) {
   165→      for (const issue of result.error.issues) {
   166→        errors.push({
   167→          file: filePath,
   168→          path: issue.path.join("."),
   169→          message: issue.message,
   170→          details: issue,
   171→        });
   172→      }
   173→    }
   174→  } catch (err) {
   175→    errors.push({
   176→      file: filePath,
   177→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   178→    });
   179→  }
   180→
   181→  return errors;
   182→}
   183→
   184→/**
   185→ * Validate a tasks file against schema
   186→ */
   187→async function validateTasksFile(
   188→  filePath: string,
   189→): Promise<SchemaValidationError[]> {
   190→  const errors: SchemaValidationError[] = [];
   191→
   192→  try {
   193→    const raw = await readYamlFile<unknown>(filePath);
   194→
   195→    // Handle both formats: { tasks: [...] } and plain array
   196→    let taskList: unknown[];
   197→
   198→    if (Array.isArray(raw)) {
   199→      taskList = raw;
   200→    } else if (raw && typeof raw === "object" && "tasks" in raw) {
   201→      // Try full TasksFile schema first
   202→      const fileResult = TasksFileSchema.safeParse(raw);
   203→      if (!fileResult.success) {
   204→        // If TasksFile fails, just validate individual tasks
   205→        taskList = (raw as { tasks: unknown[] }).tasks || [];
   206→      } else {
   207→        // File schema passed, validate individual tasks for detailed errors
   208→        taskList = fileResult.data.tasks;
   209→      }
   210→    } else {
   211→      errors.push({
   212→        file: filePath,
   213→        message:
   214→          "Invalid tasks file format: expected array or { tasks: [...] }",
   215→      });
   216→      return errors;
   217→    }
   218→
   219→    // Validate each task
   220→    for (let i = 0; i < taskList.length; i++) {
   221→      const task = taskList[i];
   222→      const result = TaskSchema.safeParse(task);
   223→
   224→      if (!result.success) {
   225→        for (const issue of result.error.issues) {
   226→          errors.push({
   227→            file: filePath,
   228→            path: `tasks[${i}].${issue.path.join(".")}`,
   229→            message: issue.message,
   230→            details: issue,
   231→          });
   232→        }
   233→      }
   234→    }
   235→  } catch (err) {
   236→    errors.push({
   237→      file: filePath,
   238→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   239→    });
   240→  }
   241→
   242→  return errors;
   243→}
   244→
   245→/**
   246→ * Validate a spec module file against schema
   247→ */
   248→async function validateSpecFile(
   249→  filePath: string,
   250→): Promise<SchemaValidationError[]> {
   251→  const errors: SchemaValidationError[] = [];
   252→
   253→  try {
   254→    const raw = await readYamlFile<unknown>(filePath);
   255→
   256→    // Recursively validate spec items
   257→    validateSpecItemRecursive(raw, filePath, "", errors);
   258→  } catch (err) {
   259→    errors.push({
   260→      file: filePath,
   261→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   262→    });
   263→  }
   264→
   265→  return errors;
   266→}
