     1→/**
     2→ * Meta CLI commands for interacting with meta-spec.
     3→ *
     4→ * AC-meta-manifest-1: kspec meta show outputs summary
     5→ * AC-meta-manifest-2: kspec validate includes meta line
     6→ * AC-meta-manifest-3: kspec validate shows meta errors with prefix
     7→ * AC-agent-1: kspec meta agents outputs table
     8→ * AC-agent-2: kspec meta agents --json outputs JSON
     9→ */
    10→
    11→import chalk from "chalk";
    12→import Table from "cli-table3";
    13→import type { Command } from "commander";
    14→import { ulid } from "ulid";
    15→import {
    16→  type Agent,
    17→  type Convention,
    18→  createObservation,
    19→  createTask,
    20→  deleteInboxItem,
    21→  deleteMetaItem,
    22→  findInboxItemByRef,
    23→  getMetaStats,
    24→  initContext,
    25→  type LoadedTask,
    26→  loadAllItems,
    27→  loadAllTasks,
    28→  loadInboxItems,
    29→  loadMetaContext,
    30→  loadSessionContext,
    31→  type MetaContext,
    32→  type Observation,
    33→  ReferenceIndex,
    34→  saveMetaItem,
    35→  saveObservation,
    36→  saveSessionContext,
    37→  saveTask,
    38→  type Workflow,
    39→} from "../../parser/index.js";
    40→import { commitIfShadow } from "../../parser/shadow.js";
    41→import { z } from "zod";
    42→import {
    43→  type ObservationType,
    44→  type WorkflowStep,
    45→  WorkflowStepSchema,
    46→} from "../../schema/index.js";
    47→import { errors } from "../../strings/errors.js";
    48→import { EXIT_CODES } from "../exit-codes.js";
    49→import { error, isJsonMode, output, success } from "../output.js";
    50→
    51→/**
    52→ * Resolve a meta reference to its ULID
    53→ * Handles semantic IDs (agent.id, workflow.id, convention.domain) and ULID prefixes
    54→ */
    55→function resolveMetaRefToUlid(
    56→  ref: string,
    57→  metaCtx: MetaContext,
    58→): {
    59→  ulid: string;
    60→  type: "agent" | "workflow" | "convention" | "observation";
    61→} | null {
    62→  const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
    63→
    64→  // Check agents
    65→  const agent = (metaCtx.agents || []).find(
    66→    (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
    67→  );
    68→  if (agent) return { ulid: agent._ulid, type: "agent" };
    69→
    70→  // Check workflows
    71→  const workflow = (metaCtx.workflows || []).find(
    72→    (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
    73→  );
    74→  if (workflow) return { ulid: workflow._ulid, type: "workflow" };
    75→
    76→  // Check conventions
    77→  const convention = (metaCtx.conventions || []).find(
    78→    (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
    79→  );
    80→  if (convention) return { ulid: convention._ulid, type: "convention" };
    81→
    82→  // Check observations
    83→  const observation = (metaCtx.observations || []).find((o) =>
    84→    o._ulid.startsWith(normalizedRef),
    85→  );
    86→  if (observation) return { ulid: observation._ulid, type: "observation" };
    87→
    88→  return null;
    89→}
    90→
    91→/**
    92→ * Format meta show output
    93→ */
    94→function formatMetaShow(meta: MetaContext): void {
    95→  const stats = getMetaStats(meta);
    96→
    97→  if (!meta.manifest) {
    98→    console.log(chalk.yellow("No meta manifest found (kynetic.meta.yaml)"));
    99→    console.log(
   100→      chalk.gray(
   101→        "Create one to define agents, workflows, conventions, and observations",
   102→      ),
   103→    );
   104→    return;
   105→  }
   106→
   107→  console.log(chalk.bold("Meta-Spec Summary"));
   108→  console.log(chalk.gray("─".repeat(40)));
   109→  console.log(`Agents:       ${stats.agents}`);
   110→  console.log(`Workflows:    ${stats.workflows}`);
   111→  console.log(`Conventions:  ${stats.conventions}`);
   112→  console.log(
   113→    `Observations: ${stats.observations} (${stats.unresolvedObservations} unresolved)`,
   114→  );
   115→}
   116→
   117→/**
   118→ * Format agents table output
   119→ * AC-agent-1: outputs table with columns: ID, Name, Capabilities
   120→ */
   121→function formatAgents(agents: Agent[]): void {
   122→  if (agents.length === 0) {
   123→    console.log(chalk.yellow("No agents defined"));
   124→    return;
   125→  }
   126→
   127→  const table = new Table({
   128→    head: [chalk.bold("ID"), chalk.bold("Name"), chalk.bold("Capabilities")],
   129→    style: {
   130→      head: [],
   131→      border: [],
   132→    },
   133→  });
   134→
   135→  for (const agent of agents) {
   136→    table.push([agent.id, agent.name, agent.capabilities.join(", ")]);
   137→  }
   138→
   139→  console.log(table.toString());
   140→}
   141→
   142→/**
   143→ * Format workflows table output
   144→ * AC-workflow-1: outputs table with columns: ID, Trigger, Steps (count), Mode
   145→ */
   146→function formatWorkflows(workflows: Workflow[]): void {
   147→  if (workflows.length === 0) {
   148→    console.log(chalk.yellow("No workflows defined"));
   149→    return;
   150→  }
   151→
   152→  const table = new Table({
   153→    head: [
   154→      chalk.bold("ID"),
   155→      chalk.bold("Trigger"),
   156→      chalk.bold("Steps"),
   157→      chalk.bold("Mode"),
   158→    ],
   159→    style: {
   160→      head: [],
   161→      border: [],
   162→    },
   163→  });
   164→
   165→  for (const workflow of workflows) {
   166→    table.push([
   167→      workflow.id,
   168→      workflow.trigger,
   169→      workflow.steps.length.toString(),
   170→      workflow.mode || "interactive",
   171→    ]);
   172→  }
   173→
   174→  console.log(table.toString());
   175→}
   176→
   177→/**
   178→ * Format workflows verbose output
   179→ * AC-workflow-2: outputs each workflow with full step list
   180→ * AC: @loop-mode-workflows ac-3 (shows based_on field)
   181→ */
   182→function formatWorkflowsVerbose(workflows: Workflow[]): void {
   183→  if (workflows.length === 0) {
   184→    console.log(chalk.yellow("No workflows defined"));
   185→    return;
   186→  }
   187→
   188→  for (const workflow of workflows) {
   189→    console.log(chalk.bold(`${workflow.id} - ${workflow.trigger}`));
   190→    // Show mode if it's loop (skip for interactive as it's default)
   191→    if (workflow.mode === "loop") {
   192→      console.log(chalk.cyan(`Mode: ${workflow.mode}`));
   193→    }
   194→    // AC: @loop-mode-workflows ac-3 - Show based_on reference
   195→    if (workflow.based_on) {
   196→      console.log(chalk.cyan(`Based on: ${workflow.based_on}`));
   197→    }
   198→    if (workflow.description) {
   199→      console.log(chalk.gray(workflow.description));
   200→    }
   201→    console.log(chalk.gray("─".repeat(60)));
   202→
   203→    for (const step of workflow.steps) {
   204→      const prefix = {
   205→        check: chalk.yellow("[check]"),
   206→        action: chalk.blue("[action]"),
   207→        decision: chalk.magenta("[decision]"),
   208→      }[step.type];
   209→
   210→      console.log(`${prefix} ${step.content}`);
   211→
   212→      if (step.on_fail) {
   213→        console.log(chalk.gray(`  → on fail: ${step.on_fail}`));
   214→      }
   215→
   216→      if (step.options && step.options.length > 0) {
   217→        for (const option of step.options) {
   218→          console.log(chalk.gray(`  • ${option}`));
   219→        }
   220→      }
   221→    }
   222→
   223→    console.log("");
   224→  }
   225→}
   226→
   227→/**
   228→ * Format conventions table output
   229→ * AC-conv-1: outputs table with columns: Domain, Rules (count), Validation (yes/no)
   230→ */
   231→function formatConventions(conventions: Convention[]): void {
   232→  if (conventions.length === 0) {
   233→    console.log(chalk.yellow("No conventions defined"));
   234→    return;
   235→  }
   236→
   237→  const table = new Table({
   238→    head: [chalk.bold("Domain"), chalk.bold("Rules"), chalk.bold("Validation")],
   239→    style: {
   240→      head: [],
   241→      border: [],
   242→    },
   243→  });
   244→
   245→  for (const convention of conventions) {
   246→    table.push([
   247→      convention.domain,
   248→      convention.rules.length.toString(),
   249→      convention.validation ? "yes" : "no",
   250→    ]);
   251→  }
   252→
   253→  console.log(table.toString());
   254→}
   255→
   256→/**
   257→ * Format convention detail output
   258→ * AC-conv-2: outputs full rules list and examples
   259→ */
   260→function formatConventionDetail(convention: Convention): void {
   261→  console.log(chalk.bold(`${convention.domain} Convention`));
   262→  console.log(chalk.gray("─".repeat(60)));
   263→
   264→  console.log(chalk.bold("\nRules:"));
   265→  for (const rule of convention.rules) {
   266→    console.log(`  • ${rule}`);
   267→  }
   268→
   269→  if (convention.examples && convention.examples.length > 0) {
   270→    console.log(chalk.bold("\nExamples:"));
   271→    for (const example of convention.examples) {
   272→      console.log(chalk.green(`  ✓ ${example.good}`));
   273→      console.log(chalk.red(`  ✗ ${example.bad}`));
   274→    }
   275→  }
   276→
   277→  if (convention.validation) {
   278→    console.log(chalk.bold("\nValidation:"));
   279→    console.log(`  Type: ${convention.validation.type}`);
   280→    if (convention.validation.pattern) {
   281→      console.log(`  Pattern: ${convention.validation.pattern}`);
   282→    }
   283→    if (convention.validation.message) {
   284→      console.log(`  Message: ${convention.validation.message}`);
   285→    }
   286→  }
   287→
   288→  console.log("");
   289→}
   290→
   291→/**
   292→ * Format observations table output
   293→ * AC-obs-2: outputs table with columns: ID, Type, Workflow, Created, Content (truncated)
   294→ */
   295→function formatObservations(
   296→  observations: Observation[],
   297→  showResolved: boolean,
   298→): void {
   299→  const filtered = showResolved
   300→    ? observations
   301→    : observations.filter((o) => !o.resolved);
   302→
   303→  if (filtered.length === 0) {
   304→    console.log(
   305→      chalk.yellow(
   306→        showResolved ? "No observations found" : "No unresolved observations",
   307→      ),
   308→    );
   309→    return;
   310→  }
   311→
   312→  const table = new Table({
   313→    head: [
   314→      chalk.bold("ID"),
   315→      chalk.bold("Type"),
   316→      chalk.bold("Workflow"),
   317→      chalk.bold("Created"),
   318→      chalk.bold("Content"),
   319→    ],
   320→    style: {
   321→      head: [],
   322→      border: [],
   323→    },
   324→    colWidths: [10, 10, 20, 12, 50],
   325→    wordWrap: true,
   326→  });
   327→
   328→  for (const obs of filtered) {
   329→    const id = obs._ulid.substring(0, 8);
   330→    const workflow = obs.workflow_ref || "-";
   331→    const created = new Date(obs.created_at).toISOString().split("T")[0];
   332→    const content =
   333→      obs.content.length > 47
   334→        ? `${obs.content.substring(0, 47)}...`
   335→        : obs.content;
   336→
   337→    table.push([id, obs.type, workflow, created, content]);
   338→  }
   339→
   340→  console.log(table.toString());
   341→}
   342→
   343→/**
   344→ * Register meta commands
   345→ */
   346→export function registerMetaCommands(program: Command): void {
   347→  const meta = program
   348→    .command("meta")
   349→    .description(
   350→      "Meta-spec commands (agents, workflows, conventions, observations)",
   351→    );
   352→
   353→  // AC-meta-manifest-1: kspec meta show outputs summary with counts
   354→  meta
   355→    .command("show")
   356→    .description("Display meta-spec summary")
   357→    .action(async () => {
   358→      try {
   359→        const ctx = await initContext();
   360→
   361→        if (!ctx.manifestPath) {
   362→          error(errors.project.noKspecProject);
   363→          process.exit(EXIT_CODES.ERROR);
   364→        }
   365→
   366→        const metaCtx = await loadMetaContext(ctx);
   367→        const stats = getMetaStats(metaCtx);
   368→
   369→        output(
   370→          {
   371→            manifest: metaCtx.manifestPath,
   372→            stats,
   373→          },
   374→          () => formatMetaShow(metaCtx),
   375→        );
   376→      } catch (err) {
   377→        error(errors.failures.showMeta, err);
   378→        process.exit(EXIT_CODES.ERROR);
   379→      }
   380→    });
   381→
   382→  // AC-agent-1, AC-agent-2: kspec meta agents
   383→  meta
   384→    .command("agents")
   385→    .description("List agents defined in meta-spec")
   386→    .action(async () => {
   387→      try {
   388→        const ctx = await initContext();
   389→
   390→        if (!ctx.manifestPath) {
   391→          error(errors.project.noKspecProject);
   392→          process.exit(EXIT_CODES.ERROR);
   393→        }
   394→
   395→        const metaCtx = await loadMetaContext(ctx);
   396→        const agents = metaCtx.agents || [];
   397→
   398→        // AC-agent-2: JSON output includes full agent details
   399→        output(
   400→          agents.map((agent) => ({
   401→            id: agent.id,
   402→            name: agent.name,
   403→            description: agent.description,
   404→            capabilities: agent.capabilities,
   405→            tools: agent.tools,
   406→            session_protocol: agent.session_protocol,
   407→            conventions: agent.conventions,
   408→          })),
   409→          // AC-agent-1: Table output with ID, Name, Capabilities
   410→          () => formatAgents(agents),
   411→        );
   412→      } catch (err) {
   413→        error(errors.failures.listAgents, err);
   414→        process.exit(EXIT_CODES.ERROR);
   415→      }
   416→    });
   417→
   418→  // AC-workflow-1, AC-workflow-2, AC-workflow-4: kspec meta workflows
   419→  // AC: @loop-mode-workflows ac-1 (--tag loop filtering)
   420→  meta
   421→    .command("workflows")
   422→    .description("List workflows defined in meta-spec")
   423→    .option("--verbose", "Show full workflow details with all steps")
   424→    .option("--tag <tag>", "Filter workflows by tag (e.g., --tag loop)")
   425→    .action(async (options) => {
   426→      try {
   427→        const ctx = await initContext();
   428→
   429→        if (!ctx.manifestPath) {
   430→          error(errors.project.noKspecProject);
   431→          process.exit(EXIT_CODES.ERROR);
   432→        }
   433→
   434→        const metaCtx = await loadMetaContext(ctx);
   435→        let workflows = metaCtx.workflows || [];
   436→
   437→        // AC: @loop-mode-workflows ac-1 - Filter by tag
   438→        if (options.tag) {
   439→          workflows = workflows.filter((w) => {
   440→            // Match by explicit tags array or by mode field (for "loop" tag)
   441→            const tags = w.tags || [];
   442→            if (tags.includes(options.tag)) return true;
   443→            // Special case: --tag loop also matches mode: loop
   444→            if (options.tag === "loop" && w.mode === "loop") return true;
   445→            return false;
   446→          });
   447→        }
   448→
   449→        // AC-workflow-4: JSON output includes full workflow details
   450→        output(
   451→          workflows.map((workflow) => ({
   452→            id: workflow.id,
   453→            trigger: workflow.trigger,
   454→            description: workflow.description,
   455→            steps: workflow.steps,
   456→            mode: workflow.mode || "interactive",
   457→            based_on: workflow.based_on,
   458→            tags: workflow.tags || [],
   459→          })),
   460→          // AC-workflow-1 (table) or AC-workflow-2 (verbose)
   461→          () => {
   462→            if (options.verbose) {
   463→              formatWorkflowsVerbose(workflows);
   464→            } else {
   465→              formatWorkflows(workflows);
   466→            }
   467→          },
   468→        );
   469→      } catch (err) {
   470→        error(errors.failures.listWorkflows, err);
   471→        process.exit(EXIT_CODES.ERROR);
   472→      }
   473→    });
   474→
   475→  // AC-conv-1, AC-conv-2, AC-conv-5: kspec meta conventions
   476→  meta
   477→    .command("conventions")
   478→    .description("List conventions defined in meta-spec")
   479→    .option("--domain <domain>", "Filter by specific domain")
   480→    .action(async (options) => {
   481→      try {
   482→        const ctx = await initContext();
   483→
   484→        if (!ctx.manifestPath) {
   485→          error(errors.project.noKspecProject);
   486→          process.exit(EXIT_CODES.ERROR);
   487→        }
   488→
   489→        const metaCtx = await loadMetaContext(ctx);
   490→        const conventions = metaCtx.conventions || [];
   491→
   492→        // AC-conv-2: Filter by domain if specified
   493→        const filtered = options.domain
   494→          ? conventions.filter((c) => c.domain === options.domain)
   495→          : conventions;
   496→
   497→        // AC-conv-5: JSON output includes full convention details
   498→        output(
   499→          filtered.map((convention) => ({
   500→            domain: convention.domain,
   501→            rules: convention.rules,
   502→            examples: convention.examples,
   503→            validation: convention.validation,
   504→          })),
   505→          // AC-conv-1 (table) or AC-conv-2 (detail for single domain)
   506→          () => {
   507→            if (options.domain && filtered.length === 1) {
   508→              formatConventionDetail(filtered[0]);
   509→            } else {
   510→              formatConventions(filtered);
   511→            }
   512→          },
   513→        );
   514→      } catch (err) {
   515→        error(errors.failures.listConventions, err);
   516→        process.exit(EXIT_CODES.ERROR);
   517→      }
   518→    });
   519→
   520→  // meta-get-cmd: kspec meta get <ref>
   521→  meta
   522→    .command("get <ref>")
   523→    .description(
   524→      "Get a meta item by reference (agent, workflow, convention, or observation)",
   525→    )
   526→    .action(async (ref: string) => {
   527→      try {
   528→        const ctx = await initContext();
   529→
   530→        if (!ctx.manifestPath) {
   531→          error(errors.project.noKspecProject);
   532→          process.exit(EXIT_CODES.ERROR);
   533→        }
   534→
   535→        const metaCtx = await loadMetaContext(ctx);
   536→
   537→        // Normalize reference
   538→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
   539→
   540→        // Search in all meta item types
   541→        const agents = metaCtx.agents || [];
   542→        const workflows = metaCtx.workflows || [];
   543→        const conventions = metaCtx.conventions || [];
   544→        const observations = metaCtx.observations || [];
   545→
   546→        // Try to find by ID or ULID prefix
   547→        let found: any = null;
   548→        let itemType: string = "";
   549→
   550→        // Check agents (by id or ULID)
   551→        const agent = agents.find(
   552→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
   553→        );
   554→        if (agent) {
   555→          found = agent;
   556→          itemType = "agent";
   557→        }
   558→
   559→        // Check workflows (by id or ULID)
   560→        if (!found) {
   561→          const workflow = workflows.find(
   562→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
   563→          );
   564→          if (workflow) {
   565→            found = workflow;
   566→            itemType = "workflow";
   567→          }
   568→        }
   569→
   570→        // Check conventions (by domain or ULID)
   571→        if (!found) {
   572→          const convention = conventions.find(
   573→            (c) =>
   574→              c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
   575→          );
   576→          if (convention) {
   577→            found = convention;
   578→            itemType = "convention";
   579→          }
   580→        }
   581→
   582→        // Check observations (by ULID)
   583→        if (!found) {
   584→          const observation = observations.find((o) =>
   585→            o._ulid.startsWith(normalizedRef),
   586→          );
   587→          if (observation) {
   588→            found = observation;
   589→            itemType = "observation";
   590→          }
   591→        }
   592→
   593→        if (!found) {
   594→          error(errors.reference.metaNotFound(ref));
   595→          process.exit(EXIT_CODES.ERROR);
   596→        }
   597→
   598→        // Output the item
   599→        output(found, () => {
   600→          console.log(
   601→            chalk.bold(
   602→              `${itemType.charAt(0).toUpperCase() + itemType.slice(1)}: ${ref}`,
   603→            ),
   604→          );
   605→          console.log(chalk.gray("─".repeat(60)));
   606→          console.log(JSON.stringify(found, null, 2));
   607→        });
   608→      } catch (err) {
   609→        error(errors.failures.getMetaItem, err);
   610→        process.exit(EXIT_CODES.ERROR);
   611→      }
   612→    });
   613→
   614→  // meta-list-cmd: kspec meta list
   615→  meta
   616→    .command("list")
   617→    .description("List all meta items")
   618→    .option(
   619→      "--type <type>",
   620→      "Filter by type (agent, workflow, convention, observation)",
   621→    )
   622→    .action(async (options) => {
   623→      try {
   624→        const ctx = await initContext();
   625→
   626→        if (!ctx.manifestPath) {
   627→          error(errors.project.noKspecProject);
   628→          process.exit(EXIT_CODES.ERROR);
   629→        }
   630→
   631→        const metaCtx = await loadMetaContext(ctx);
   632→
   633→        // Collect all meta items with type information
   634→        interface MetaListItem {
   635→          id: string;
   636→          type: string;
   637→          context: string;
   638→          ulid: string;
   639→        }
   640→
   641→        const items: MetaListItem[] = [];
   642→
   643→        // Add agents
   644→        if (!options.type || options.type === "agent") {
   645→          for (const agent of metaCtx.agents || []) {
   646→            items.push({
   647→              id: agent.id,
   648→              type: "agent",
   649→              context: agent.name,
   650→              ulid: agent._ulid,
   651→            });
   652→          }
   653→        }
   654→
   655→        // Add workflows
   656→        if (!options.type || options.type === "workflow") {
   657→          for (const workflow of metaCtx.workflows || []) {
   658→            items.push({
   659→              id: workflow.id,
   660→              type: "workflow",
   661→              context: workflow.trigger,
   662→              ulid: workflow._ulid,
   663→            });
   664→          }
   665→        }
   666→
   667→        // Add conventions
   668→        if (!options.type || options.type === "convention") {
   669→          for (const convention of metaCtx.conventions || []) {
   670→            items.push({
   671→              id: convention.domain,
   672→              type: "convention",
   673→              context: `${convention.rules.length} rules`,
   674→              ulid: convention._ulid,
   675→            });
   676→          }
   677→        }
   678→
   679→        // Add observations
   680→        if (!options.type || options.type === "observation") {
   681→          for (const observation of metaCtx.observations || []) {
   682→            const ulidPrefix = observation._ulid.substring(0, 8);
   683→            items.push({
   684→              id: ulidPrefix,
   685→              type: "observation",
   686→              context: `${observation.type} ${observation.resolved ? "(resolved)" : ""}`,
   687→              ulid: observation._ulid,
   688→            });
   689→          }
   690→        }
   691→
   692→        // Output
   693→        output(items, () => {
   694→          if (items.length === 0) {
   695→            console.log(chalk.yellow("No meta items found"));
   696→            return;
   697→          }
   698→
   699→          const table = new Table({
   700→            head: [chalk.bold("ID"), chalk.bold("Type"), chalk.bold("Context")],
   701→            style: {
   702→              head: [],
   703→              border: [],
   704→            },
   705→          });
   706→
   707→          for (const item of items) {
   708→            table.push([item.id, item.type, item.context]);
   709→          }
   710→
   711→          console.log(table.toString());
   712→        });
   713→      } catch (err) {
   714→        error(errors.failures.listMetaItems, err);
   715→        process.exit(EXIT_CODES.ERROR);
   716→      }
   717→    });
   718→
   719→  // AC-obs-1: kspec meta observe <type> <content>
   720→  // AC: @meta-observe-cmd from-inbox-conversion
   721→  meta
   722→    .command("observe [type] [content]")
   723→    .description("Create an observation (friction, success, question, idea)")
   724→    .option(
   725→      "--workflow <ref>",
   726→      "Reference to workflow this observation relates to",
   727→    )
   728→    .option("--author <author>", "Author of the observation")
   729→    .option("--from-inbox <ref>", "Convert inbox item to observation")
   730→    .option(
   731→      "--type <type>",
   732→      "Override type when using --from-inbox (defaults to idea)",
   733→    )
   734→    .action(
   735→      async (
   736→        type: string | undefined,
   737→        content: string | undefined,
   738→        options,
   739→      ) => {
   740→        try {
   741→          const ctx = await initContext();
   742→
   743→          if (!ctx.manifestPath) {
   744→            error(errors.project.noKspecProject);
   745→            process.exit(EXIT_CODES.ERROR);
   746→          }
   747→
   748→          // AC: @meta-observe-cmd from-inbox-conversion
   749→          // Handle --from-inbox flag
   750→          if (options.fromInbox) {
   751→            // Load inbox items
   752→            const inboxItems = await loadInboxItems(ctx);
   753→            const item = findInboxItemByRef(inboxItems, options.fromInbox);
   754→
   755→            if (!item) {
   756→              error(errors.reference.inboxNotFound(options.fromInbox));
   757→              process.exit(EXIT_CODES.NOT_FOUND);
   758→            }
   759→
   760→            // Use inbox item content
   761→            const observationContent = item.text;
   762→
   763→            // Type defaults to 'idea' but can be overridden with --type flag
   764→            const observationType = (options.type || "idea") as ObservationType;
   765→
   766→            // Validate observation type
   767→            const validTypes: ObservationType[] = [
   768→              "friction",
   769→              "success",
   770→              "question",
   771→              "idea",
   772→            ];
   773→            if (!validTypes.includes(observationType)) {
   774→              error(errors.validation.invalidObservationType(observationType));
   775→              console.log(`Valid types: ${validTypes.join(", ")}`);
   776→              process.exit(EXIT_CODES.ERROR);
   777→            }
   778→
   779→            // Create observation
   780→            const observation = createObservation(
   781→              observationType,
   782→              observationContent,
   783→              {
   784→                workflow_ref: options.workflow,
   785→                author: options.author,
   786→              },
   787→            );
   788→
   789→            // Save observation
   790→            await saveObservation(ctx, observation);
   791→
   792→            // Delete inbox item
   793→            const deleted = await deleteInboxItem(ctx, item._ulid);
   794→            if (!deleted) {
   795→              error("Failed to delete inbox item after creating observation");
   796→              process.exit(EXIT_CODES.ERROR);
   797→            }
   798→
   799→            await commitIfShadow(
   800→              ctx.shadow,
   801→              "meta-observe-from-inbox",
   802→              observation._ulid.substring(0, 8),
   803→              `Convert inbox item to ${observationType} observation`,
   804→            );
   805→
   806→            // Return observation ref
   807→            output(observation, () =>
   808→              success(
   809→                `Created observation: ${observation._ulid.substring(0, 8)}`,
   810→              ),
   811→            );
   812→            return;
   813→          }
   814→
   815→          // Standard observe flow (without --from-inbox)
   816→          if (!type || !content) {
   817→            error("Type and content are required when not using --from-inbox");
   818→            process.exit(EXIT_CODES.ERROR);
   819→          }
   820→
   821→          // Validate observation type
   822→          const validTypes: ObservationType[] = [
   823→            "friction",
   824→            "success",
   825→            "question",
   826→            "idea",
   827→          ];
   828→          if (!validTypes.includes(type as ObservationType)) {
   829→            error(errors.validation.invalidObservationType(type));
   830→            console.log(`Valid types: ${validTypes.join(", ")}`);
   831→            process.exit(EXIT_CODES.ERROR);
   832→          }
   833→
   834→          // Create observation
   835→          const observation = createObservation(
   836→            type as ObservationType,
   837→            content,
   838→            {
   839→              workflow_ref: options.workflow,
   840→              author: options.author,
   841→            },
   842→          );
   843→
   844→          // Save to manifest
   845→          await saveObservation(ctx, observation);
   846→
   847→          // AC: @trait-shadow-commit ac-1
   848→          await commitIfShadow(
   849→            ctx.shadow,
   850→            "meta-observe",
   851→            observation._ulid.substring(0, 8),
   852→            type as string,
   853→          );
   854→
   855→          // AC-obs-1: outputs "OK Created observation: <ULID-prefix>"
   856→          // In JSON mode, return the created observation object
   857→          output(observation, () =>
   858→            success(
   859→              `Created observation: ${observation._ulid.substring(0, 8)}`,
   860→            ),
   861→          );
   862→        } catch (err) {
   863→          error(errors.failures.createObservation, err);
   864→          process.exit(EXIT_CODES.ERROR);
   865→        }
   866→      },
   867→    );
   868→
   869→  // AC-obs-2, AC-obs-5: kspec meta observations
   870→  meta
   871→    .command("observations")
   872→    .description("List observations (shows unresolved by default)")
   873→    .option(
   874→      "--type <type>",
   875→      "Filter by observation type (friction/success/question/idea)",
   876→    )
   877→    .option("--workflow <ref>", "Filter by workflow reference")
   878→    .option("--all", "Include resolved observations")
   879→    .option("--promoted", "Show only observations promoted to tasks")
   880→    .option(
   881→      "--pending-resolution",
   882→      "Show observations with completed tasks awaiting resolution",
   883→    )
   884→    .action(async (options) => {
   885→      try {
   886→        const ctx = await initContext();
   887→
   888→        if (!ctx.manifestPath) {
   889→          error(errors.project.noKspecProject);
   890→          process.exit(EXIT_CODES.ERROR);
   891→        }
   892→
   893→        const metaCtx = await loadMetaContext(ctx);
   894→        let observations = metaCtx.observations || [];
   895→
   896→        // Apply filters
   897→        if (options.type) {
   898→          observations = observations.filter(
   899→            (obs) => obs.type === options.type,
   900→          );
   901→        }
   902→
   903→        if (options.workflow) {
   904→          observations = observations.filter(
   905→            (obs) => obs.workflow_ref === options.workflow,
   906→          );
   907→        }
   908→
   909→        if (options.promoted) {
   910→          observations = observations.filter(
   911→            (obs) => obs.promoted_to !== undefined,
   912→          );
   913→        }
   914→
   915→        if (options.pendingResolution) {
   916→          // Load tasks to check if promoted tasks are completed
   917→          const tasks = await loadAllTasks(ctx);
   918→          const items = await loadAllItems(ctx);
   919→          const index = new ReferenceIndex(tasks, items);
   920→
   921→          observations = observations.filter((obs) => {
   922→            if (!obs.promoted_to || obs.resolved) return false;
   923→            const taskResult = index.resolve(obs.promoted_to);
   924→            if (!taskResult.ok) return false;
   925→            const item = taskResult.item;
   926→            // Type guard: check if item is a task (has status and depends_on properties)
   927→            return (
   928→              "status" in item &&
   929→              "depends_on" in item &&
   930→              item.status === "completed"
   931→            );
   932→          });
   933→        }
   934→
   935→        // AC-obs-5: JSON output includes full observation objects
   936→        output(
   937→          observations.map((obs) => ({
   938→            _ulid: obs._ulid,
   939→            type: obs.type,
   940→            content: obs.content,
   941→            workflow_ref: obs.workflow_ref ?? null,
   942→            created_at: obs.created_at,
   943→            author: obs.author ?? null,
   944→            resolved: obs.resolved,
   945→            resolution: obs.resolution ?? null,
   946→            resolved_at: obs.resolved_at ?? null,
   947→            resolved_by: obs.resolved_by ?? null,
   948→            promoted_to: obs.promoted_to ?? null,
   949→          })),
   950→          // AC-obs-2: Table output with ID, Type, Workflow, Created, Content
   951→          () => formatObservations(observations, options.all),
   952→        );
   953→      } catch (err) {
   954→        error(errors.failures.listObservations, err);
   955→        process.exit(EXIT_CODES.ERROR);
   956→      }
   957→    });
   958→
   959→  // AC-obs-3, AC-obs-6, AC-obs-8: kspec meta promote
   960→  meta
   961→    .command("promote <ref>")
   962→    .description("Promote observation to a task")
   963→    .requiredOption("--title <title>", "Task title")
   964→    .option("--priority <priority>", "Task priority (1-5)", "2")
   965→    .option("--force", "Force promotion even if observation is resolved")
   966→    .action(async (ref: string, options) => {
   967→      try {
   968→        const ctx = await initContext();
   969→
   970→        if (!ctx.manifestPath) {
   971→          error(errors.project.noKspecProject);
   972→          process.exit(EXIT_CODES.ERROR);
   973→        }
   974→
   975→        const metaCtx = await loadMetaContext(ctx);
   976→        const observations = metaCtx.observations || [];
   977→
   978→        // Find observation
   979→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
   980→        const observation = observations.find((o) =>
   981→          o._ulid.startsWith(normalizedRef),
   982→        );
   983→
   984→        if (!observation) {
   985→          error(errors.reference.observationNotFound(ref));
   986→          process.exit(EXIT_CODES.ERROR);
   987→        }
   988→
   989→        // AC-obs-6: Check if already promoted
   990→        if (observation.promoted_to) {
   991→          error(
   992→            errors.conflict.observationAlreadyPromoted(observation.promoted_to),
   993→          );
   994→          process.exit(EXIT_CODES.CONFLICT);
   995→        }
   996→
   997→        // AC-obs-8: Check if resolved
   998→        if (observation.resolved && !options.force) {
   999→          error(errors.operation.cannotPromoteResolved);
  1000→          process.exit(EXIT_CODES.ERROR);
  1001→        }
  1002→
  1003→        // AC-obs-3: Create task with title, description from observation, meta_ref, and origin
  1004→        const task = createTask({
  1005→          title: options.title,
  1006→          description: observation.content,
  1007→          priority: Number.parseInt(options.priority, 10),
  1008→          meta_ref: observation.workflow_ref,
  1009→          origin: "observation_promotion",
  1010→        });
  1011→
  1012→        // Save task
  1013→        await saveTask(ctx, task);
  1014→        await commitIfShadow(
  1015→          ctx.shadow,
  1016→          "task-add",
  1017→          task.slugs[0] || task._ulid.slice(0, 8),
  1018→          task.title,
  1019→        );
  1020→        const taskRef = `@${task._ulid.substring(0, 8)}`;
  1021→
  1022→        // Update observation with promoted_to field
  1023→        observation.promoted_to = taskRef;
  1024→        await saveObservation(ctx, observation);
  1025→
  1026→        // AC: @trait-shadow-commit ac-1
  1027→        await commitIfShadow(
  1028→          ctx.shadow,
  1029→          "observation-promote",
  1030→          observation._ulid.substring(0, 8),
  1031→        );
  1032→
  1033→        // AC-obs-3: outputs "OK Created task: <ULID-prefix>"
  1034→        // In JSON mode, return the created task object
  1035→        output(task, () => success(`Created task: ${taskRef.substring(0, 9)}`));
  1036→      } catch (err) {
  1037→        error(errors.failures.promoteObservation, err);
  1038→        process.exit(EXIT_CODES.ERROR);
  1039→      }
  1040→    });
  1041→
  1042→  // AC-obs-4, AC-obs-7, AC-obs-9: kspec meta resolve
  1043→  meta
  1044→    .command("resolve <ref> [resolution]")
  1045→    .description("Resolve an observation")
  1046→    .action(async (ref: string, resolution: string | undefined) => {
  1047→      try {
  1048→        const ctx = await initContext();
  1049→
  1050→        if (!ctx.manifestPath) {
  1051→          error(errors.project.noKspecProject);
  1052→          process.exit(EXIT_CODES.ERROR);
  1053→        }
  1054→
  1055→        const metaCtx = await loadMetaContext(ctx);
  1056→        const observations = metaCtx.observations || [];
  1057→
  1058→        // Find observation
  1059→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1060→        const observation = observations.find((o) =>
  1061→          o._ulid.startsWith(normalizedRef),
  1062→        );
  1063→
  1064→        if (!observation) {
  1065→          error(errors.reference.observationNotFound(ref));
  1066→          process.exit(EXIT_CODES.ERROR);
  1067→        }
  1068→
  1069→        // AC-obs-7: Check if already resolved
  1070→        if (observation.resolved) {
  1071→          const resolvedDate = new Date(observation.resolved_at!)
  1072→            .toISOString()
  1073→            .split("T")[0];
  1074→          const resolutionText = observation.resolution || "";
  1075→          const truncated =
  1076→            resolutionText.length > 50
  1077→              ? `${resolutionText.substring(0, 50)}...`
  1078→              : resolutionText;
  1079→          error(
  1080→            errors.conflict.observationAlreadyResolved(resolvedDate, truncated),
  1081→          );
  1082→          process.exit(EXIT_CODES.CONFLICT);
  1083→        }
  1084→
  1085→        // AC-obs-9: Auto-populate resolution from task completion if promoted
  1086→        let finalResolution = resolution;
  1087→        if (!finalResolution && observation.promoted_to) {
  1088→          // Fetch task to get completion reason
  1089→          const tasks = await loadAllTasks(ctx);
  1090→          const items = await loadAllItems(ctx);
  1091→          const index = new ReferenceIndex(tasks, items);
  1092→          const taskResult = index.resolve(observation.promoted_to);
  1093→
  1094→          if (taskResult.ok) {
  1095→            const item = taskResult.item;
  1096→            // Type guard: ensure this is a task (has status and depends_on properties)
  1097→            if ("status" in item && "depends_on" in item) {
  1098→              const task = item as LoadedTask;
  1099→              if (task.status === "completed" && task.closed_reason) {
  1100→                finalResolution = `Resolved via task ${observation.promoted_to}: ${task.closed_reason}`;
  1101→              } else if (task.status === "completed") {
  1102→                finalResolution = `Resolved via task ${observation.promoted_to}`;
  1103→              } else {
  1104→                error(`Task ${observation.promoted_to} is not completed yet`);
  1105→                process.exit(EXIT_CODES.ERROR);
  1106→              }
  1107→            } else {
  1108→              error(`Reference ${observation.promoted_to} is not a task`);
  1109→              process.exit(EXIT_CODES.ERROR);
  1110→            }
  1111→          } else {
  1112→            error(`Task ${observation.promoted_to} not found`);
  1113→            process.exit(EXIT_CODES.ERROR);
  1114→          }
  1115→        }
  1116→
  1117→        if (!finalResolution) {
  1118→          error(errors.validation.resolutionRequired);
  1119→          process.exit(EXIT_CODES.ERROR);
  1120→        }
  1121→
  1122→        // AC-obs-4: Update observation
  1123→        observation.resolved = true;
  1124→        observation.resolution = finalResolution;
  1125→        observation.resolved_at = new Date().toISOString();
  1126→        observation.resolved_by = observation.author; // Use same author
  1127→
  1128→        await saveObservation(ctx, observation);
  1129→
  1130→        // AC: @trait-shadow-commit ac-1
  1131→        await commitIfShadow(
  1132→          ctx.shadow,
  1133→          "observation-resolve",
  1134→          observation._ulid.substring(0, 8),
  1135→        );
  1136→
  1137→        // AC-obs-4: outputs "OK Resolved: <ULID-prefix>"
  1138→        success(`Resolved: ${observation._ulid.substring(0, 8)}`);
  1139→      } catch (err) {
  1140→        error(errors.failures.resolveObservation, err);
  1141→        process.exit(EXIT_CODES.ERROR);
  1142→      }
  1143→    });
  1144→
  1145→  // Meta add command - create new meta items
  1146→  meta
  1147→    .command("add <type>")
  1148→    .description("Create a new meta item (agent, workflow, or convention)")
  1149→    .option("--id <id>", "Semantic ID (required for agents and workflows)")
  1150→    .option("--domain <domain>", "Domain (required for conventions)")
  1151→    .option("--name <name>", "Name (for agents)")
  1152→    .option("--trigger <trigger>", "Trigger (for workflows)")
  1153→    .option("--description <desc>", "Description")
  1154→    .option("--capability <cap...>", "Capabilities (for agents)")
  1155→    .option("--tool <tool...>", "Tools (for agents)")
  1156→    .option("--convention <conv...>", "Convention references (for agents)")
  1157→    .option("--rule <rule...>", "Rules (for conventions)")
  1158→    .option("--steps <json>", "Workflow steps as JSON array (for workflows)")
  1159→    .option(
  1160→      "--mode <mode>",
  1161→      "Workflow mode: interactive (default) or loop (for workflows)",
  1162→    )
  1163→    .option("--based-on <ref>", "Base workflow reference (for loop workflows)")
  1164→    .option("--tag <tag...>", "Tags for the workflow (for workflows)")
  1165→    .action(async (type: string, options) => {
  1166→      try {
  1167→        const ctx = await initContext();
  1168→
  1169→        // Validate type
  1170→        const validTypes = ["agent", "workflow", "convention"];
  1171→        if (!validTypes.includes(type)) {
  1172→          error(errors.validation.invalidType(type, validTypes));
  1173→          process.exit(EXIT_CODES.ERROR);
  1174→        }
  1175→
  1176→        // Generate ULID
  1177→        const itemUlid = ulid();
  1178→
  1179→        // Create the item based on type
  1180→        let item: Agent | Workflow | Convention;
  1181→
  1182→        if (type === "agent") {
  1183→          // Validate required fields
  1184→          if (!options.id) {
  1185→            error(errors.validation.agentRequiresId);
  1186→            process.exit(EXIT_CODES.ERROR);
  1187→          }
  1188→          if (!options.name) {
  1189→            error(errors.validation.agentRequiresName);
  1190→            process.exit(EXIT_CODES.ERROR);
  1191→          }
  1192→
  1193→          item = {
  1194→            _ulid: itemUlid,
  1195→            id: options.id,
  1196→            name: options.name,
  1197→            description: options.description || "",
  1198→            capabilities: options.capability || [],
  1199→            tools: options.tool || [],
  1200→            conventions: options.convention || [],
  1201→          };
  1202→        } else if (type === "workflow") {
  1203→          // Validate required fields
  1204→          if (!options.id) {
  1205→            error(errors.validation.workflowRequiresId);
  1206→            process.exit(EXIT_CODES.ERROR);
  1207→          }
  1208→          if (!options.trigger) {
  1209→            error(errors.validation.workflowRequiresTrigger);
  1210→            process.exit(EXIT_CODES.ERROR);
  1211→          }
  1212→
  1213→          // Parse and validate --steps if provided
  1214→          let steps: WorkflowStep[] = [];
  1215→          if (options.steps) {
  1216→            // AC: @meta-add-cmd ac-2 - Parse JSON
  1217→            let parsedSteps: unknown;
  1218→            try {
  1219→              parsedSteps = JSON.parse(options.steps);
  1220→            } catch (err) {
  1221→              const message = err instanceof Error ? err.message : String(err);
  1222→              error(errors.validation.invalidStepsJson(message));
  1223→              process.exit(EXIT_CODES.ERROR);
  1224→            }
  1225→
  1226→            // AC: @meta-add-cmd ac-3 - Verify it's an array
  1227→            if (!Array.isArray(parsedSteps)) {
  1228→              error(errors.validation.stepsNotArray);
  1229→              process.exit(EXIT_CODES.ERROR);
  1230→            }
  1231→
  1232→            // AC: @meta-add-cmd ac-4 - Validate with schema
  1233→            const result = z.array(WorkflowStepSchema).safeParse(parsedSteps);
  1234→            if (!result.success) {
  1235→              const issues = result.error.issues
  1236→                .map((i) => `${i.path.join(".")}: ${i.message}`)
  1237→                .join("; ");
  1238→              error(errors.validation.invalidStepsSchema(issues));
  1239→              process.exit(EXIT_CODES.ERROR);
  1240→            }
  1241→            steps = result.data;
  1242→          }
  1243→
  1244→          // Validate mode if provided
  1245→          const validModes = ["interactive", "loop"];
  1246→          if (options.mode && !validModes.includes(options.mode)) {
  1247→            error(
  1248→              `Invalid mode: ${options.mode}. Valid modes: ${validModes.join(", ")}`,
  1249→            );
  1250→            process.exit(EXIT_CODES.ERROR);
  1251→          }
  1252→
  1253→          item = {
  1254→            _ulid: itemUlid,
  1255→            id: options.id,
  1256→            trigger: options.trigger,
  1257→            description: options.description || "",
  1258→            steps,
  1259→            ...(options.mode && { mode: options.mode }),
  1260→            ...(options.basedOn && { based_on: options.basedOn }),
  1261→            ...(options.tag && options.tag.length > 0 && { tags: options.tag }),
  1262→          };
  1263→        } else {
  1264→          // convention
  1265→          if (!options.domain) {
  1266→            error(errors.validation.conventionRequiresDomain);
  1267→            process.exit(EXIT_CODES.ERROR);
  1268→          }
  1269→
  1270→          item = {
  1271→            _ulid: itemUlid,
  1272→            domain: options.domain,
  1273→            rules: options.rule || [],
  1274→            examples: [],
  1275→          };
  1276→        }
  1277→
  1278→        // Save the item
  1279→        await saveMetaItem(
  1280→          ctx,
  1281→          item,
  1282→          type as "agent" | "workflow" | "convention",
  1283→        );
  1284→
  1285→        // AC: @trait-shadow-commit ac-1
  1286→        await commitIfShadow(
  1287→          ctx.shadow,
  1288→          `meta-add-${type}`,
  1289→          itemUlid.substring(0, 8),
  1290→          "id" in item ? item.id : "domain" in item ? item.domain : undefined,
  1291→        );
  1292→
  1293→        if (isJsonMode()) {
  1294→          // In JSON mode, output the item data directly
  1295→          console.log(JSON.stringify(item, null, 2));
  1296→        } else {
  1297→          const idOrDomain =
  1298→            "id" in item ? item.id : "domain" in item ? item.domain : itemUlid;
  1299→          success(
  1300→            `Created ${type}: ${idOrDomain} (@${itemUlid.substring(0, 8)})`,
  1301→          );
  1302→        }
  1303→      } catch (err) {
  1304→        error(errors.failures.createMeta(type), err);
  1305→        process.exit(EXIT_CODES.ERROR);
  1306→      }
  1307→    });
  1308→
  1309→  // Meta set command - update existing meta items
  1310→  meta
  1311→    .command("set <ref>")
  1312→    .description("Update an existing meta item")
  1313→    .option("--name <name>", "Update name (for agents)")
  1314→    .option("--description <desc>", "Update description")
  1315→    .option("--trigger <trigger>", "Update trigger (for workflows)")
  1316→    .option("--add-capability <cap>", "Add capability (for agents)")
  1317→    .option("--add-tool <tool>", "Add tool (for agents)")
  1318→    .option("--add-convention <conv>", "Add convention reference (for agents)")
  1319→    .option("--add-rule <rule>", "Add rule (for conventions)")
  1320→    .action(async (ref: string, options) => {
  1321→      try {
  1322→        const ctx = await initContext();
  1323→        const metaCtx = await loadMetaContext(ctx);
  1324→
  1325→        // Find the item using unified lookup
  1326→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1327→        let found: Agent | Workflow | Convention | null = null;
  1328→        let itemType: "agent" | "workflow" | "convention" | null = null;
  1329→
  1330→        // Search in agents
  1331→        const agents = metaCtx.manifest?.agents || [];
  1332→        const agent = agents.find(
  1333→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
  1334→        );
  1335→        if (agent) {
  1336→          found = agent;
  1337→          itemType = "agent";
  1338→        }
  1339→
  1340→        // Search in workflows
  1341→        if (!found) {
  1342→          const workflows = metaCtx.manifest?.workflows || [];
  1343→          const workflow = workflows.find(
  1344→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
  1345→          );
  1346→          if (workflow) {
  1347→            found = workflow;
  1348→            itemType = "workflow";
  1349→          }
  1350→        }
  1351→
  1352→        // Search in conventions
  1353→        if (!found) {
  1354→          const conventions = metaCtx.manifest?.conventions || [];
  1355→          const convention = conventions.find(
  1356→            (c) =>
  1357→              c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
  1358→          );
  1359→          if (convention) {
  1360→            found = convention;
  1361→            itemType = "convention";
  1362→          }
  1363→        }
  1364→
  1365→        if (!found || !itemType) {
  1366→          error(errors.reference.metaNotFound(ref));
  1367→          process.exit(EXIT_CODES.ERROR);
  1368→        }
  1369→
  1370→        // Update fields based on type
  1371→        if (itemType === "agent") {
  1372→          const item = found as Agent;
  1373→          if (options.name) item.name = options.name;
  1374→          if (options.description !== undefined)
  1375→            item.description = options.description;
  1376→          if (options.addCapability) {
  1377→            if (!item.capabilities.includes(options.addCapability)) {
  1378→              item.capabilities.push(options.addCapability);
  1379→            }
  1380→          }
  1381→          if (options.addTool) {
  1382→            if (!item.tools.includes(options.addTool)) {
  1383→              item.tools.push(options.addTool);
  1384→            }
  1385→          }
  1386→          if (options.addConvention) {
  1387→            if (!item.conventions.includes(options.addConvention)) {
  1388→              item.conventions.push(options.addConvention);
  1389→            }
  1390→          }
  1391→        } else if (itemType === "workflow") {
  1392→          const item = found as Workflow;
  1393→          if (options.trigger) item.trigger = options.trigger;
  1394→          if (options.description !== undefined)
  1395→            item.description = options.description;
  1396→        } else {
  1397→          const item = found as Convention;
  1398→          // Convention doesn't have a description field
  1399→          if (options.addRule) {
  1400→            if (!item.rules.includes(options.addRule)) {
  1401→              item.rules.push(options.addRule);
  1402→            }
  1403→          }
  1404→        }
  1405→
  1406→        // Save the updated item
  1407→        await saveMetaItem(ctx, found, itemType);
  1408→
  1409→        // AC: @trait-shadow-commit ac-1
  1410→        await commitIfShadow(
  1411→          ctx.shadow,
  1412→          `meta-set-${itemType}`,
  1413→          found._ulid.substring(0, 8),
  1414→        );
  1415→
  1416→        if (isJsonMode()) {
  1417→          // In JSON mode, output the item data directly
  1418→          console.log(JSON.stringify(found, null, 2));
  1419→        } else {
  1420→          const idOrDomain =
  1421→            itemType === "agent"
  1422→              ? (found as Agent).id
  1423→              : itemType === "workflow"
  1424→                ? (found as Workflow).id
  1425→                : (found as Convention).domain;
  1426→          success(`Updated ${itemType}: ${idOrDomain}`);
  1427→        }
  1428→      } catch (err) {
  1429→        error(errors.failures.updateMetaItem, err);
  1430→        process.exit(EXIT_CODES.ERROR);
  1431→      }
  1432→    });
  1433→
  1434→  // Meta delete command - delete meta items
  1435→  meta
  1436→    .command("delete <ref>")
  1437→    .description("Delete a meta item")
  1438→    .option("--confirm", "Skip confirmation prompt")
  1439→    .action(async (ref: string, options) => {
  1440→      try {
  1441→        const ctx = await initContext();
  1442→        const metaCtx = await loadMetaContext(ctx);
  1443→
  1444→        // Find the item to determine type
  1445→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1446→        let itemType:
  1447→          | "agent"
  1448→          | "workflow"
  1449→          | "convention"
  1450→          | "observation"
  1451→          | null = null;
  1452→        let itemUlid: string | null = null;
  1453→        let itemLabel: string | null = null;
  1454→
  1455→        // Search in agents
  1456→        const agents = metaCtx.manifest?.agents || [];
  1457→        const agent = agents.find(
  1458→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
  1459→        );
  1460→        if (agent) {
  1461→          itemType = "agent";
  1462→          itemUlid = agent._ulid;
  1463→          itemLabel = `agent ${agent.id}`;
  1464→        }
  1465→
  1466→        // Search in workflows
  1467→        if (!itemType) {
  1468→          const workflows = metaCtx.manifest?.workflows || [];
  1469→          const workflow = workflows.find(
  1470→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
  1471→          );
  1472→          if (workflow) {
  1473→            itemType = "workflow";
  1474→            itemUlid = workflow._ulid;
  1475→            itemLabel = `workflow ${workflow.id}`;
  1476→          }
  1477→        }
  1478→
  1479→        // Search in conventions
  1480→        if (!itemType) {
  1481→          const conventions = metaCtx.manifest?.conventions || [];
  1482→          const convention = conventions.find(
  1483→            (c) =>
  1484→              c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
  1485→          );
  1486→          if (convention) {
  1487→            itemType = "convention";
  1488→            itemUlid = convention._ulid;
  1489→            itemLabel = `convention ${convention.domain}`;
  1490→          }
  1491→        }
  1492→
  1493→        // Search in observations
  1494→        if (!itemType) {
  1495→          const observations = metaCtx.observations || [];
  1496→          const observation = observations.find((o) =>
  1497→            o._ulid.startsWith(normalizedRef),
  1498→          );
  1499→          if (observation) {
  1500→            itemType = "observation";
  1501→            itemUlid = observation._ulid;
  1502→            itemLabel = `observation ${observation._ulid.substring(0, 8)}`;
  1503→          }
  1504→        }
  1505→
  1506→        if (!itemType || !itemUlid || !itemLabel) {
  1507→          error(errors.reference.metaNotFound(ref));
  1508→          process.exit(EXIT_CODES.ERROR);
  1509→        }
  1510→
  1511→        // Check for dangling references (unless --confirm is used to override)
  1512→        if (!options.confirm) {
  1513→          // Check tasks with meta_ref
  1514→          const tasks = await loadAllTasks(ctx);
  1515→          const referencingTasks = tasks.filter((t) => {
  1516→            if (!t.meta_ref) return false;
  1517→            // Resolve the task's meta_ref to a ULID
  1518→            const taskMetaRef = resolveMetaRefToUlid(t.meta_ref, metaCtx);
  1519→            // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1520→            return taskMetaRef && taskMetaRef.ulid === itemUlid;
  1521→          });
  1522→
  1523→          if (referencingTasks.length > 0) {
  1524→            const taskRefs = referencingTasks
  1525→              .map((t) => `@${t.slugs?.[0] || t._ulid.substring(0, 8)}`)
  1526→              .join(", ");
  1527→            error(
  1528→              errors.operation.cannotDeleteReferencedByTasks(
  1529→                itemLabel,
  1530→                referencingTasks.length,
  1531→                taskRefs,
  1532→              ),
  1533→            );
  1534→            process.exit(EXIT_CODES.ERROR);
  1535→          }
  1536→
  1537→          // Check observations with workflow_ref (only for workflows)
  1538→          if (itemType === "workflow") {
  1539→            const observations = metaCtx.observations || [];
  1540→            const referencingObservations = observations.filter((o) => {
  1541→              if (!o.workflow_ref) return false;
  1542→              // Resolve the observation's workflow_ref to a ULID
  1543→              const obsWorkflowRef = resolveMetaRefToUlid(
  1544→                o.workflow_ref,
  1545→                metaCtx,
  1546→              );
  1547→              // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1548→              return obsWorkflowRef && obsWorkflowRef.ulid === itemUlid;
  1549→            });
  1550→
  1551→            if (referencingObservations.length > 0) {
  1552→              const obsRefs = referencingObservations
  1553→                .map((o) => `@${o._ulid.substring(0, 8)}`)
  1554→                .join(", ");
  1555→              error(
  1556→                errors.operation.cannotDeleteReferencedByObservations(
  1557→                  itemLabel,
  1558→                  referencingObservations.length,
  1559→                  obsRefs,
  1560→                ),
  1561→              );
  1562→              process.exit(EXIT_CODES.ERROR);
  1563→            }
  1564→          }
  1565→
  1566→          // Show confirmation prompt even if no references found
  1567→          error(errors.operation.confirmRequired(itemLabel));
  1568→          process.exit(EXIT_CODES.ERROR);
  1569→        }
  1570→
  1571→        // Delete the item
  1572→        const deleted = await deleteMetaItem(ctx, itemUlid, itemType);
  1573→
  1574→        if (!deleted) {
  1575→          error(errors.operation.deleteItemFailed(itemLabel));
  1576→          process.exit(EXIT_CODES.ERROR);
  1577→        }
  1578→
  1579→        // AC: @trait-shadow-commit ac-1
  1580→        await commitIfShadow(
  1581→          ctx.shadow,
  1582→          `meta-delete-${itemType}`,
  1583→          itemUlid.substring(0, 8),
  1584→        );
  1585→
  1586→        success(`Deleted ${itemLabel}`);
  1587→      } catch (err) {
  1588→        error(errors.failures.deleteMetaItem, err);
  1589→        process.exit(EXIT_CODES.ERROR);
  1590→      }
  1591→    });
  1592→
  1593→  // meta-focus-cmd: kspec meta focus [ref]
  1594→  meta
  1595→    .command("focus [ref]")
  1596→    .description("Get or set session focus")
  1597→    .option("--clear", "Clear current focus")
  1598→    .action(async (ref: string | undefined, options) => {
  1599→      try {
  1600→        const ctx = await initContext();
  1601→
  1602→        if (!ctx.manifestPath) {
  1603→          error(errors.project.noKspecProject);
  1604→          process.exit(EXIT_CODES.ERROR);
  1605→        }
  1606→
  1607→        const sessionCtx = await loadSessionContext(ctx);
  1608→
  1609→        // Clear focus
  1610→        if (options.clear) {
  1611→          sessionCtx.focus = null;
  1612→          await saveSessionContext(ctx, sessionCtx);
  1613→
  1614→          output({ focus: null }, () => success("Cleared session focus"));
  1615→          return;
  1616→        }
  1617→
  1618→        // Show current focus
  1619→        if (!ref) {
  1620→          output({ focus: sessionCtx.focus }, () => {
  1621→            if (sessionCtx.focus) {
  1622→              console.log(`Current focus: ${sessionCtx.focus}`);
  1623→            } else {
  1624→              console.log(chalk.yellow("No focus set"));
  1625→            }
  1626→          });
  1627→          return;
  1628→        }
  1629→
  1630→        // Set focus to ref
  1631→        sessionCtx.focus = ref.startsWith("@") ? ref : `@${ref}`;
  1632→        await saveSessionContext(ctx, sessionCtx);
  1633→
  1634→        output({ focus: sessionCtx.focus }, () =>
  1635→          success(`Set focus to: ${sessionCtx.focus}`),
  1636→        );
  1637→      } catch (err) {
  1638→        error(errors.failures.updateSessionContext, err);
  1639→        process.exit(EXIT_CODES.ERROR);
  1640→      }
  1641→    });
  1642→
  1643→  // meta-thread-cmd: kspec meta thread <action> [text]
  1644→  meta
  1645→    .command("thread <action> [text]")
  1646→    .description("Manage active threads")
  1647→    .action(async (action: string, text: string | undefined) => {
  1648→      try {
  1649→        const ctx = await initContext();
  1650→
  1651→        if (!ctx.manifestPath) {
  1652→          error(errors.project.noKspecProject);
  1653→          process.exit(EXIT_CODES.ERROR);
  1654→        }
  1655→
  1656→        const sessionCtx = await loadSessionContext(ctx);
  1657→
  1658→        // List threads
  1659→        if (action === "list") {
  1660→          output({ threads: sessionCtx.threads }, () => {
  1661→            if (sessionCtx.threads.length === 0) {
  1662→              console.log(chalk.yellow("No active threads"));
  1663→            } else {
  1664→              console.log("Active threads:");
  1665→              sessionCtx.threads.forEach((thread, idx) => {
  1666→                console.log(`  ${idx + 1}. ${thread}`);
  1667→              });
  1668→            }
  1669→          });
  1670→          return;
  1671→        }
  1672→
  1673→        // Clear all threads
  1674→        if (action === "clear") {
  1675→          sessionCtx.threads = [];
  1676→          await saveSessionContext(ctx, sessionCtx);
  1677→
  1678→          output({ threads: [] }, () => success("Cleared all threads"));
  1679→          return;
  1680→        }
  1681→
  1682→        // Add thread
  1683→        if (action === "add") {
  1684→          if (!text) {
  1685→            error("Thread text is required for add action");
  1686→            process.exit(EXIT_CODES.ERROR);
  1687→          }
  1688→
  1689→          sessionCtx.threads.push(text);
  1690→          await saveSessionContext(ctx, sessionCtx);
  1691→
  1692→          output({ threads: sessionCtx.threads, added: text }, () =>
  1693→            success(`Added thread: ${text}`),
  1694→          );
  1695→          return;
  1696→        }
  1697→
  1698→        // Remove thread by index (1-based)
  1699→        if (action === "remove") {
  1700→          if (!text) {
  1701→            error("Index is required for remove action");
  1702→            process.exit(EXIT_CODES.ERROR);
  1703→          }
  1704→
  1705→          const index = parseInt(text, 10);
  1706→          if (
  1707→            Number.isNaN(index) ||
  1708→            index < 1 ||
  1709→            index > sessionCtx.threads.length
  1710→          ) {
  1711→            error(
  1712→              `Invalid index: ${text}. Must be between 1 and ${sessionCtx.threads.length}`,
  1713→            );
  1714→            process.exit(EXIT_CODES.ERROR);
  1715→          }
  1716→
  1717→          const removed = sessionCtx.threads.splice(index - 1, 1)[0];
  1718→          await saveSessionContext(ctx, sessionCtx);
  1719→
  1720→          output({ threads: sessionCtx.threads, removed }, () =>
  1721→            success(`Removed thread: ${removed}`),
  1722→          );
  1723→          return;
  1724→        }
  1725→
  1726→        // Unknown action
  1727→        error(`Unknown action: ${action}. Use add, remove, list, or clear`);
  1728→        process.exit(EXIT_CODES.ERROR);
  1729→      } catch (err) {
  1730→        error(errors.failures.updateSessionContext, err);
  1731→        process.exit(EXIT_CODES.ERROR);
  1732→      }
  1733→    });
  1734→
  1735→  // meta-question-cmd: kspec meta question <action> [text]
  1736→  meta
  1737→    .command("question <action> [text]")
  1738→    .description("Manage open questions")
  1739→    .action(async (action: string, text: string | undefined) => {
  1740→      try {
  1741→        const ctx = await initContext();
  1742→
  1743→        if (!ctx.manifestPath) {
  1744→          error(errors.project.noKspecProject);
  1745→          process.exit(EXIT_CODES.ERROR);
  1746→        }
  1747→
  1748→        const sessionCtx = await loadSessionContext(ctx);
  1749→
  1750→        // List questions
  1751→        if (action === "list") {
  1752→          output({ questions: sessionCtx.open_questions }, () => {
  1753→            if (sessionCtx.open_questions.length === 0) {
  1754→              console.log(chalk.yellow("No open questions"));
  1755→            } else {
  1756→              console.log("Open questions:");
  1757→              sessionCtx.open_questions.forEach((question, idx) => {
  1758→                console.log(`  ${idx + 1}. ${question}`);
  1759→              });
  1760→            }
  1761→          });
  1762→          return;
  1763→        }
  1764→
  1765→        // Clear all questions
  1766→        if (action === "clear") {
  1767→          sessionCtx.open_questions = [];
  1768→          await saveSessionContext(ctx, sessionCtx);
  1769→
  1770→          output({ questions: [] }, () => success("Cleared all questions"));
  1771→          return;
  1772→        }
  1773→
  1774→        // Add question
  1775→        if (action === "add") {
  1776→          if (!text) {
  1777→            error("Question text is required for add action");
  1778→            process.exit(EXIT_CODES.ERROR);
  1779→          }
  1780→
  1781→          sessionCtx.open_questions.push(text);
  1782→          await saveSessionContext(ctx, sessionCtx);
  1783→
  1784→          output({ questions: sessionCtx.open_questions, added: text }, () =>
  1785→            success(`Added question: ${text}`),
  1786→          );
  1787→          return;
  1788→        }
  1789→
  1790→        // Remove question by index (1-based)
  1791→        if (action === "remove") {
  1792→          if (!text) {
  1793→            error("Index is required for remove action");
  1794→            process.exit(EXIT_CODES.ERROR);
  1795→          }
  1796→
  1797→          const index = parseInt(text, 10);
  1798→          if (
  1799→            Number.isNaN(index) ||
  1800→            index < 1 ||
  1801→            index > sessionCtx.open_questions.length
  1802→          ) {
  1803→            error(
  1804→              `Invalid index: ${text}. Must be between 1 and ${sessionCtx.open_questions.length}`,
  1805→            );
  1806→            process.exit(EXIT_CODES.ERROR);
  1807→          }
  1808→
  1809→          const removed = sessionCtx.open_questions.splice(index - 1, 1)[0];
  1810→          await saveSessionContext(ctx, sessionCtx);
  1811→
  1812→          output({ questions: sessionCtx.open_questions, removed }, () =>
  1813→            success(`Removed question: ${removed}`),
  1814→          );
  1815→          return;
  1816→        }
  1817→
  1818→        // Unknown action
  1819→        error(`Unknown action: ${action}. Use add, remove, list, or clear`);
  1820→        process.exit(EXIT_CODES.ERROR);
  1821→      } catch (err) {
  1822→        error(errors.failures.updateSessionContext, err);
  1823→        process.exit(EXIT_CODES.ERROR);
  1824→      }
  1825→    });
  1826→
  1827→  // meta-context-cmd: kspec meta context
  1828→  meta
  1829→    .command("context")
  1830→    .description("Show full session context")
  1831→    .option("--clear", "Clear all session context")
  1832→    .action(async (options) => {
  1833→      try {
  1834→        const ctx = await initContext();
  1835→
  1836→        if (!ctx.manifestPath) {
  1837→          error(errors.project.noKspecProject);
  1838→          process.exit(EXIT_CODES.ERROR);
  1839→        }
  1840→
  1841→        const sessionCtx = await loadSessionContext(ctx);
  1842→
  1843→        // Clear all context
  1844→        if (options.clear) {
  1845→          sessionCtx.focus = null;
  1846→          sessionCtx.threads = [];
  1847→          sessionCtx.open_questions = [];
  1848→          await saveSessionContext(ctx, sessionCtx);
  1849→
  1850→          output(
  1851→            {
  1852→              focus: null,
  1853→              threads: [],
  1854→              open_questions: [],
  1855→              updated_at: sessionCtx.updated_at,
  1856→            },
  1857→            () => success("Cleared all session context"),
  1858→          );
  1859→          return;
  1860→        }
  1861→
  1862→        // Show full session context
  1863→        output(
  1864→          {
  1865→            focus: sessionCtx.focus,
  1866→            threads: sessionCtx.threads,
  1867→            open_questions: sessionCtx.open_questions,
  1868→            updated_at: sessionCtx.updated_at,
  1869→          },
  1870→          () => {
  1871→            console.log(chalk.bold("Session Context"));
  1872→            console.log(chalk.gray("─".repeat(60)));
  1873→
  1874→            // Focus
  1875→            console.log(chalk.bold("\nFocus:"));
  1876→            if (sessionCtx.focus) {
  1877→              console.log(`  ${sessionCtx.focus}`);
  1878→            } else {
  1879→              console.log(chalk.gray("  (none)"));
  1880→            }
  1881→
  1882→            // Active threads
  1883→            console.log(chalk.bold("\nActive Threads:"));
  1884→            if (sessionCtx.threads.length > 0) {
  1885→              sessionCtx.threads.forEach((thread, idx) => {
  1886→                console.log(`  ${idx + 1}. ${thread}`);
  1887→              });
  1888→            } else {
  1889→              console.log(chalk.gray("  (none)"));
  1890→            }
  1891→
  1892→            // Open questions
  1893→            console.log(chalk.bold("\nOpen Questions:"));
  1894→            if (sessionCtx.open_questions.length > 0) {
  1895→              sessionCtx.open_questions.forEach((question, idx) => {
  1896→                console.log(`  ${idx + 1}. ${question}`);
  1897→              });
  1898→            } else {
  1899→              console.log(chalk.gray("  (none)"));
  1900→            }
  1901→
  1902→            // Last updated
  1903→            console.log(chalk.bold("\nLast Updated:"));
  1904→            const updatedDate = new Date(sessionCtx.updated_at);
  1905→            console.log(`  ${updatedDate.toISOString()}`);
  1906→            console.log(chalk.gray(`  (${updatedDate.toLocaleString()})`));
  1907→          },
  1908→        );
  1909→      } catch (err) {
  1910→        error(errors.failures.updateSessionContext, err);
  1911→        process.exit(EXIT_CODES.ERROR);
  1912→      }
  1913→    });
  1914→}
  1915→

