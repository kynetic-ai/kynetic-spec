```
     1→/**
     2→ * Meta CLI commands for interacting with meta-spec.
     3→ *
     4→ * AC-meta-manifest-1: kspec meta show outputs summary
     5→ * AC-meta-manifest-2: kspec validate includes meta line
     6→ * AC-meta-manifest-3: kspec validate shows meta errors with prefix
     7→ * AC-agent-1: kspec meta agents outputs table
     8→ * AC-agent-2: kspec meta agents --json outputs JSON
     9→ */
    10→
    11→import chalk from "chalk";
    12→import Table from "cli-table3";
    13→import type { Command } from "commander";
    14→import { ulid } from "ulid";
    15→import {
    16→  type Agent,
    17→  type Convention,
    18→  createObservation,
    19→  createTask,
    20→  deleteInboxItem,
    21→  deleteMetaItem,
    22→  findInboxItemByRef,
    23→  getMetaStats,
    24→  initContext,
    25→  type LoadedTask,
    26→  loadAllItems,
    27→  loadAllTasks,
    28→  loadInboxItems,
    29→  loadMetaContext,
    30→  loadSessionContext,
    31→  type MetaContext,
    32→  type Observation,
    33→  ReferenceIndex,
    34→  saveMetaItem,
    35→  saveObservation,
    36→  saveSessionContext,
    37→  saveTask,
    38→  type Workflow,
    39→} from "../../parser/index.js";
    40→import { commitIfShadow } from "../../parser/shadow.js";
    41→import { z } from "zod";
    42→import {
    43→  type ObservationType,
    44→  type WorkflowStep,
    45→  WorkflowStepSchema,
    46→} from "../../schema/index.js";
    47→import { errors } from "../../strings/errors.js";
    48→import { EXIT_CODES } from "../exit-codes.js";
    49→import { error, isJsonMode, output, success } from "../output.js";
    50→
    51→/**
    52→ * Resolve a meta reference to its ULID
    53→ * Handles semantic IDs (agent.id, workflow.id, convention.domain) and ULID prefixes
    54→ */
    55→function resolveMetaRefToUlid(
    56→  ref: string,
    57→  metaCtx: MetaContext,
    58→): {
    59→  ulid: string;
    60→  type: "agent" | "workflow" | "convention" | "observation";
    61→} | null {
    62→  const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
    63→
    64→  // Check agents
    65→  const agent = (metaCtx.agents || []).find(
    66→    (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
    67→  );
    68→  if (agent) return { ulid: agent._ulid, type: "agent" };
    69→
    70→  // Check workflows
    71→  const workflow = (metaCtx.workflows || []).find(
    72→    (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
    73→  );
    74→  if (workflow) return { ulid: workflow._ulid, type: "workflow" };
    75→
    76→  // Check conventions
    77→  const convention = (metaCtx.conventions || []).find(
    78→    (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
    79→  );
    80→  if (convention) return { ulid: convention._ulid, type: "convention" };
    81→
    82→  // Check observations
    83→  const observation = (metaCtx.observations || []).find((o) =>
    84→    o._ulid.startsWith(normalizedRef),
    85→  );
    86→  if (observation) return { ulid: observation._ulid, type: "observation" };
    87→
    88→  return null;
    89→}
    90→
    91→/**
    92→ * Format meta show output
    93→ */
    94→function formatMetaShow(meta: MetaContext): void {
    95→  const stats = getMetaStats(meta);
    96→
    97→  if (!meta.manifest) {
    98→    console.log(chalk.yellow("No meta manifest found (kynetic.meta.yaml)"));
    99→    console.log(
   100→      chalk.gray(
   101→        "Create one to define agents, workflows, conventions, and observations",
   102→      ),
   103→    );
   104→    return;
   105→  }
   106→
   107→  console.log(chalk.bold("Meta-Spec Summary"));
   108→  console.log(chalk.gray("─".repeat(40)));
   109→  console.log(`Agents:       ${stats.agents}`);
   110→  console.log(`Workflows:    ${stats.workflows}`);
   111→  console.log(`Conventions:  ${stats.conventions}`);
   112→  console.log(
   113→    `Observations: ${stats.observations} (${stats.unresolvedObservations} unresolved)`,
   114→  );
   115→}
   116→
   117→/**
   118→ * Format agents table output
   119→ * AC-agent-1: outputs table with columns: ID, Name, Capabilities
   120→ */
   121→function formatAgents(agents: Agent[]): void {
   122→  if (agents.length === 0) {
   123→    console.log(chalk.yellow("No agents defined"));
   124→    return;
   125→  }
   126→
   127→  const table = new Table({
   128→    head: [chalk.bold("ID"), chalk.bold("Name"), chalk.bold("Capabilities")],
   129→    style: {
   130→      head: [],
   131→      border: [],
   132→    },
   133→  });
   134→
   135→  for (const agent of agents) {
   136→    table.push([agent.id, agent.name, agent.capabilities.join(", ")]);
   137→  }
   138→
   139→  console.log(table.toString());
   140→}
   141→
   142→/**
   143→ * Format workflows table output
   144→ * AC-workflow-1: outputs table with columns: ID, Trigger, Steps (count), Mode
   145→ */
   146→function formatWorkflows(workflows: Workflow[]): void {
   147→  if (workflows.length === 0) {
   148→    console.log(chalk.yellow("No workflows defined"));
   149→    return;
   150→  }
   151→
   152→  const table = new Table({
   153→    head: [
   154→      chalk.bold("ID"),
   155→      chalk.bold("Trigger"),
   156→      chalk.bold("Steps"),
   157→      chalk.bold("Mode"),
   158→    ],
   159→    style: {
   160→      head: [],
   161→      border: [],
   162→    },
   163→  });
   164→
   165→  for (const workflow of workflows) {
   166→    table.push([
   167→      workflow.id,
   168→      workflow.trigger,
   169→      workflow.steps.length.toString(),
   170→      workflow.mode || "interactive",
   171→    ]);
   172→  }
   173→
   174→  console.log(table.toString());
   175→}
   176→
   177→/**
   178→ * Format workflows verbose output
   179→ * AC-workflow-2: outputs each workflow with full step list
   180→ * AC: @loop-mode-workflows ac-3 (shows based_on field)
   181→ */
   182→function formatWorkflowsVerbose(workflows: Workflow[]): void {
   183→  if (workflows.length === 0) {
   184→    console.log(chalk.yellow("No workflows defined"));
   185→    return;
   186→  }
   187→
   188→  for (const workflow of workflows) {
   189→    console.log(chalk.bold(`${workflow.id} - ${workflow.trigger}`));
   190→    // Show mode if it's loop (skip for interactive as it's default)
   191→    if (workflow.mode === "loop") {
   192→      console.log(chalk.cyan(`Mode: ${workflow.mode}`));
   193→    }
   194→    // AC: @loop-mode-workflows ac-3 - Show based_on reference
   195→    if (workflow.based_on) {
   196→      console.log(chalk.cyan(`Based on: ${workflow.based_on}`));
   197→    }
   198→    if (workflow.description) {
   199→      console.log(chalk.gray(workflow.description));
   200→    }
   201→    console.log(chalk.gray("─".repeat(60)));
   202→
   203→    for (const step of workflow.steps) {
   204→      const prefix = {
   205→        check: chalk.yellow("[check]"),
   206→        action: chalk.blue("[action]"),
   207→        decision: chalk.magenta("[decision]"),
   208→      }[step.type];
   209→
   210→      console.log(`${prefix} ${step.content}`);
   211→
   212→      if (step.on_fail) {
   213→        console.log(chalk.gray(`  → on fail: ${step.on_fail}`));
   214→      }
   215→
   216→      if (step.options && step.options.length > 0) {
   217→        for (const option of step.options) {
   218→          console.log(chalk.gray(`  • ${option}`));
   219→        }
   220→      }
   221→    }
   222→
   223→    console.log("");
   224→  }
   225→}
   226→
   227→/**
   228→ * Format conventions table output
   229→ * AC-conv-1: outputs table with columns: Domain, Rules (count), Validation (yes/no)
   230→ */
   231→function formatConventions(conventions: Convention[]): void {
   232→  if (conventions.length === 0) {
   233→    console.log(chalk.yellow("No conventions defined"));
   234→    return;
   235→  }
   236→
   237→  const table = new Table({
   238→    head: [chalk.bold("Domain"), chalk.bold("Rules"), chalk.bold("Validation")],
   239→    style: {
   240→      head: [],
   241→      border: [],
   242→    },
   243→  });
   244→
   245→  for (const convention of conventions) {
   246→    table.push([
   247→      convention.domain,
   248→      convention.rules.length.toString(),
   249→      convention.validation ? "yes" : "no",
   250→    ]);
   251→  }
   252→
   253→  console.log(table.toString());
   254→}
   255→
   256→/**
   257→ * Format convention detail output
   258→ * AC-conv-2: outputs full rules list and examples
   259→ */
   260→function formatConventionDetail(convention: Convention): void {
   261→  console.log(chalk.bold(`${convention.domain} Convention`));
   262→  console.log(chalk.gray("─".repeat(60)));
   263→
   264→  console.log(chalk.bold("\nRules:"));
   265→  for (const rule of convention.rules) {
   266→    console.log(`  • ${rule}`);
   267→  }
   268→
   269→  if (convention.examples && convention.examples.length > 0) {
   270→    console.log(chalk.bold("\nExamples:"));
   271→    for (const example of convention.examples) {
   272→      console.log(chalk.green(`  ✓ ${example.good}`));
   273→      console.log(chalk.red(`  ✗ ${example.bad}`));
   274→    }
   275→  }
   276→
   277→  if (convention.validation) {
   278→    console.log(chalk.bold("\nValidation:"));
   279→    console.log(`  Type: ${convention.validation.type}`);
   280→    if (convention.validation.pattern) {
   281→      console.log(`  Pattern: ${convention.validation.pattern}`);
   282→    }
   283→    if (convention.validation.message) {
   284→      console.log(`  Message: ${convention.validation.message}`);
   285→    }
   286→  }
   287→
   288→  console.log("");
   289→}
   290→
   291→/**
   292→ * Format observations table output
   293→ * AC-obs-2: outputs table with columns: ID, Type, Workflow, Created, Content (truncated)
   294→ * AC: @obs-list-display ac-1 - When --all flag used, show Resolved column with ✓/✗
   295→ */
   296→function formatObservations(
   297→  observations: Observation[],
   298→  showResolved: boolean,
   299→): void {
   300→  const filtered = showResolved
   301→    ? observations
   302→    : observations.filter((o) => !o.resolved);
   303→
   304→  if (filtered.length === 0) {
   305→    console.log(
   306→      chalk.yellow(
   307→        showResolved ? "No observations found" : "No unresolved observations",
   308→      ),
   309→    );
   310→    return;
   311→  }
   312→
   313→  // AC: @obs-list-display ac-1 - Include Resolved column when showing all observations
   314→  const headers = showResolved
   315→    ? [
   316→        chalk.bold("ID"),
   317→        chalk.bold("Type"),
   318→        chalk.bold("Resolved"),
   319→        chalk.bold("Workflow"),
   320→        chalk.bold("Created"),
   321→        chalk.bold("Content"),
   322→      ]
   323→    : [
   324→        chalk.bold("ID"),
   325→        chalk.bold("Type"),
   326→        chalk.bold("Workflow"),
   327→        chalk.bold("Created"),
   328→        chalk.bold("Content"),
   329→      ];
   330→
   331→  const colWidths = showResolved
   332→    ? [10, 10, 10, 20, 12, 40]
   333→    : [10, 10, 20, 12, 50];
   334→
   335→  const table = new Table({
   336→    head: headers,
   337→    style: {
   338→      head: [],
   339→      border: [],
   340→    },
   341→    colWidths,
   342→    wordWrap: true,
   343→  });
   344→
   345→  for (const obs of filtered) {
   346→    const id = obs._ulid.substring(0, 8);
   347→    const workflow = obs.workflow_ref || "-";
   348→    const created = new Date(obs.created_at).toISOString().split("T")[0];
   349→    // Adjust content truncation based on available column width
   350→    const maxContentLen = showResolved ? 37 : 47;
   351→    const content =
   352→      obs.content.length > maxContentLen
   353→        ? `${obs.content.substring(0, maxContentLen)}...`
   354→        : obs.content;
   355→
   356→    // AC: @obs-list-display ac-1 - Show ✓ for resolved, ✗ for unresolved
   357→    if (showResolved) {
   358→      const resolvedIndicator = obs.resolved
   359→        ? chalk.green("✓")
   360→        : chalk.red("✗");
   361→      table.push([id, obs.type, resolvedIndicator, workflow, created, content]);
   362→    } else {
   363→      table.push([id, obs.type, workflow, created, content]);
   364→    }
   365→  }
   366→
   367→  console.log(table.toString());
   368→}
   369→
   370→/**
   371→ * Register meta commands
   372→ */
   373→export function registerMetaCommands(program: Command): void {
   374→  const meta = program
   375→    .command("meta")
   376→    .description(
   377→      "Meta-spec commands (agents, workflows, conventions, observations)",
   378→    );
   379→
   380→  // AC-meta-manifest-1: kspec meta show outputs summary with counts
   381→  meta
   382→    .command("show")
   383→    .description("Display meta-spec summary")
   384→    .action(async () => {
   385→      try {
   386→        const ctx = await initContext();
   387→
   388→        if (!ctx.manifestPath) {
   389→          error(errors.project.noKspecProject);
   390→          process.exit(EXIT_CODES.ERROR);
   391→        }
   392→
   393→        const metaCtx = await loadMetaContext(ctx);
   394→        const stats = getMetaStats(metaCtx);
   395→
   396→        output(
   397→          {
   398→            manifest: metaCtx.manifestPath,
   399→            stats,
   400→          },
   401→          () => formatMetaShow(metaCtx),
   402→        );
   403→      } catch (err) {
   404→        error(errors.failures.showMeta, err);
   405→        process.exit(EXIT_CODES.ERROR);
   406→      }
   407→    });
   408→
   409→  // AC-agent-1, AC-agent-2: kspec meta agents
   410→  meta
   411→    .command("agents")
   412→    .description("List agents defined in meta-spec")
   413→    .action(async () => {
   414→      try {
   415→        const ctx = await initContext();
   416→
   417→        if (!ctx.manifestPath) {
   418→          error(errors.project.noKspecProject);
   419→          process.exit(EXIT_CODES.ERROR);
   420→        }
   421→
   422→        const metaCtx = await loadMetaContext(ctx);
   423→        const agents = metaCtx.agents || [];
   424→
   425→        // AC-agent-2: JSON output includes full agent details
   426→        output(
   427→          agents.map((agent) => ({
   428→            id: agent.id,
   429→            name: agent.name,
   430→            description: agent.description,
   431→            capabilities: agent.capabilities,
   432→            tools: agent.tools,
   433→            session_protocol: agent.session_protocol,
   434→            conventions: agent.conventions,
   435→          })),
   436→          // AC-agent-1: Table output with ID, Name, Capabilities
   437→          () => formatAgents(agents),
   438→        );
   439→      } catch (err) {
   440→        error(errors.failures.listAgents, err);
   441→        process.exit(EXIT_CODES.ERROR);
   442→      }
   443→    });
   444→
   445→  // AC-workflow-1, AC-workflow-2, AC-workflow-4: kspec meta workflows
   446→  // AC: @loop-mode-workflows ac-1 (--tag loop filtering)
   447→  meta
   448→    .command("workflows")
   449→    .description("List workflows defined in meta-spec")
   450→    .option("--verbose", "Show full workflow details with all steps")
   451→    .option("--tag <tag>", "Filter workflows by tag (e.g., --tag loop)")
   452→    .action(async (options) => {
   453→      try {
   454→        const ctx = await initContext();
   455→
   456→        if (!ctx.manifestPath) {
   457→          error(errors.project.noKspecProject);
   458→          process.exit(EXIT_CODES.ERROR);
   459→        }
   460→
   461→        const metaCtx = await loadMetaContext(ctx);
   462→        let workflows = metaCtx.workflows || [];
   463→
   464→        // AC: @loop-mode-workflows ac-1 - Filter by tag
   465→        if (options.tag) {
   466→          workflows = workflows.filter((w) => {
   467→            // Match by explicit tags array or by mode field (for "loop" tag)
   468→            const tags = w.tags || [];
   469→            if (tags.includes(options.tag)) return true;
   470→            // Special case: --tag loop also matches mode: loop
   471→            if (options.tag === "loop" && w.mode === "loop") return true;
   472→            return false;
   473→          });
   474→        }
   475→
   476→        // AC-workflow-4: JSON output includes full workflow details
   477→        output(
   478→          workflows.map((workflow) => ({
   479→            id: workflow.id,
   480→            trigger: workflow.trigger,
   481→            description: workflow.description,
   482→            steps: workflow.steps,
   483→            mode: workflow.mode || "interactive",
   484→            based_on: workflow.based_on,
   485→            tags: workflow.tags || [],
   486→          })),
   487→          // AC-workflow-1 (table) or AC-workflow-2 (verbose)
   488→          () => {
   489→            if (options.verbose) {
   490→              formatWorkflowsVerbose(workflows);
   491→            } else {
   492→              formatWorkflows(workflows);
   493→            }
   494→          },
   495→        );
   496→      } catch (err) {
   497→        error(errors.failures.listWorkflows, err);
   498→        process.exit(EXIT_CODES.ERROR);
   499→      }
   500→    });
   501→
   502→  // AC-conv-1, AC-conv-2, AC-conv-5: kspec meta conventions
   503→  meta
   504→    .command("conventions")
   505→    .description("List conventions defined in meta-spec")
   506→    .option("--domain <domain>", "Filter by specific domain")
   507→    .action(async (options) => {
   508→      try {
   509→        const ctx = await initContext();
   510→
   511→        if (!ctx.manifestPath) {
   512→          error(errors.project.noKspecProject);
   513→          process.exit(EXIT_CODES.ERROR);
   514→        }
   515→
   516→        const metaCtx = await loadMetaContext(ctx);
   517→        const conventions = metaCtx.conventions || [];
   518→
   519→        // AC-conv-2: Filter by domain if specified
   520→        const filtered = options.domain
   521→          ? conventions.filter((c) => c.domain === options.domain)
   522→          : conventions;
   523→
   524→        // AC-conv-5: JSON output includes full convention details
   525→        output(
   526→          filtered.map((convention) => ({
   527→            domain: convention.domain,
   528→            rules: convention.rules,
   529→            examples: convention.examples,
   530→            validation: convention.validation,
   531→          })),
   532→          // AC-conv-1 (table) or AC-conv-2 (detail for single domain)
   533→          () => {
   534→            if (options.domain && filtered.length === 1) {
   535→              formatConventionDetail(filtered[0]);
   536→            } else {
   537→              formatConventions(filtered);
   538→            }
   539→          },
   540→        );
   541→      } catch (err) {
   542→        error(errors.failures.listConventions, err);
   543→        process.exit(EXIT_CODES.ERROR);
   544→      }
   545→    });
   546→
   547→  // meta-get-cmd: kspec meta get <ref>
   548→  meta
   549→    .command("get <ref>")
   550→    .description(
   551→      "Get a meta item by reference (agent, workflow, convention, or observation)",
   552→    )
   553→    .action(async (ref: string) => {
   554→      try {
   555→        const ctx = await initContext();
   556→
   557→        if (!ctx.manifestPath) {
   558→          error(errors.project.noKspecProject);
   559→          process.exit(EXIT_CODES.ERROR);
   560→        }
   561→
   562→        const metaCtx = await loadMetaContext(ctx);
   563→
   564→        // Normalize reference
   565→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
   566→
   567→        // Search in all meta item types
   568→        const agents = metaCtx.agents || [];
   569→        const workflows = metaCtx.workflows || [];
   570→        const conventions = metaCtx.conventions || [];
   571→        const observations = metaCtx.observations || [];
   572→
   573→        // Try to find by ID or ULID prefix
   574→        let found: any = null;
   575→        let itemType: string = "";
   576→
   577→        // Check agents (by id or ULID)
   578→        const agent = agents.find(
   579→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
   580→        );
   581→        if (agent) {
   582→          found = agent;
   583→          itemType = "agent";
   584→        }
   585→
   586→        // Check workflows (by id or ULID)
   587→        if (!found) {
   588→          const workflow = workflows.find(
   589→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
   590→          );
   591→          if (workflow) {
   592→            found = workflow;
   593→            itemType = "workflow";
   594→          }
   595→        }
   596→
   597→        // Check conventions (by domain or ULID)
   598→        if (!found) {
   599→          const convention = conventions.find(
   600→            (c) =>
   601→              c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
   602→          );
   603→          if (convention) {
   604→            found = convention;
   605→            itemType = "convention";
   606→          }
   607→        }
   608→
   609→        // Check observations (by ULID)
   610→        if (!found) {
   611→          const observation = observations.find((o) =>
   612→            o._ulid.startsWith(normalizedRef),
   613→          );
   614→          if (observation) {
   615→            found = observation;
   616→            itemType = "observation";
   617→          }
   618→        }
   619→
   620→        if (!found) {
   621→          error(errors.reference.metaNotFound(ref));
   622→          process.exit(EXIT_CODES.ERROR);
   623→        }
   624→
   625→        // Output the item
   626→        output(found, () => {
   627→          console.log(
   628→            chalk.bold(
   629→              `${itemType.charAt(0).toUpperCase() + itemType.slice(1)}: ${ref}`,
   630→            ),
   631→          );
   632→          console.log(chalk.gray("─".repeat(60)));
   633→          console.log(JSON.stringify(found, null, 2));
   634→        });
   635→      } catch (err) {
   636→        error(errors.failures.getMetaItem, err);
   637→        process.exit(EXIT_CODES.ERROR);
   638→      }
   639→    });
   640→
   641→  // meta-list-cmd: kspec meta list
   642→  meta
   643→    .command("list")
   644→    .description("List all meta items")
   645→    .option(
   646→      "--type <type>",
   647→      "Filter by type (agent, workflow, convention, observation)",
   648→    )
   649→    .action(async (options) => {
   650→      try {
   651→        const ctx = await initContext();
   652→
   653→        if (!ctx.manifestPath) {
   654→          error(errors.project.noKspecProject);
   655→          process.exit(EXIT_CODES.ERROR);
   656→        }
   657→
   658→        const metaCtx = await loadMetaContext(ctx);
   659→
   660→        // Collect all meta items with type information
   661→        interface MetaListItem {
   662→          id: string;
   663→          type: string;
   664→          context: string;
   665→          ulid: string;
   666→        }
   667→
   668→        const items: MetaListItem[] = [];
   669→
   670→        // Add agents
   671→        if (!options.type || options.type === "agent") {
   672→          for (const agent of metaCtx.agents || []) {
   673→            items.push({
   674→              id: agent.id,
   675→              type: "agent",
   676→              context: agent.name,
   677→              ulid: agent._ulid,
   678→            });
   679→          }
   680→        }
   681→
   682→        // Add workflows
   683→        if (!options.type || options.type === "workflow") {
   684→          for (const workflow of metaCtx.workflows || []) {
   685→            items.push({
   686→              id: workflow.id,
   687→              type: "workflow",
   688→              context: workflow.trigger,
   689→              ulid: workflow._ulid,
   690→            });
   691→          }
   692→        }
   693→
   694→        // Add conventions
   695→        if (!options.type || options.type === "convention") {
   696→          for (const convention of metaCtx.conventions || []) {
   697→            items.push({
   698→              id: convention.domain,
   699→              type: "convention",
   700→              context: `${convention.rules.length} rules`,
   701→              ulid: convention._ulid,
   702→            });
   703→          }
   704→        }
   705→
   706→        // Add observations
   707→        if (!options.type || options.type === "observation") {
   708→          for (const observation of metaCtx.observations || []) {
   709→            const ulidPrefix = observation._ulid.substring(0, 8);
   710→            items.push({
   711→              id: ulidPrefix,
   712→              type: "observation",
   713→              context: `${observation.type} ${observation.resolved ? "(resolved)" : ""}`,
   714→              ulid: observation._ulid,
   715→            });
   716→          }
   717→        }
   718→
   719→        // Output
   720→        output(items, () => {
   721→          if (items.length === 0) {
   722→            console.log(chalk.yellow("No meta items found"));
   723→            return;
   724→          }
   725→
   726→          const table = new Table({
   727→            head: [chalk.bold("ID"), chalk.bold("Type"), chalk.bold("Context")],
   728→            style: {
   729→              head: [],
   730→              border: [],
   731→            },
   732→          });
   733→
   734→          for (const item of items) {
   735→            table.push([item.id, item.type, item.context]);
   736→          }
   737→
   738→          console.log(table.toString());
   739→        });
   740→      } catch (err) {
   741→        error(errors.failures.listMetaItems, err);
   742→        process.exit(EXIT_CODES.ERROR);
   743→      }
   744→    });
   745→
   746→  // AC-obs-1: kspec meta observe <type> <content>
   747→  // AC: @meta-observe-cmd from-inbox-conversion
   748→  meta
   749→    .command("observe [type] [content]")
   750→    .description("Create an observation (friction, success, question, idea)")
   751→    .option(
   752→      "--workflow <ref>",
   753→      "Reference to workflow this observation relates to",
   754→    )
   755→    .option("--author <author>", "Author of the observation")
   756→    .option("--from-inbox <ref>", "Convert inbox item to observation")
   757→    .option(
   758→      "--type <type>",
   759→      "Override type when using --from-inbox (defaults to idea)",
   760→    )
   761→    .action(
   762→      async (
   763→        type: string | undefined,
   764→        content: string | undefined,
   765→        options,
   766→      ) => {
   767→        try {
   768→          const ctx = await initContext();
   769→
   770→          if (!ctx.manifestPath) {
   771→            error(errors.project.noKspecProject);
   772→            process.exit(EXIT_CODES.ERROR);
   773→          }
   774→
   775→          // AC: @meta-observe-cmd from-inbox-conversion
   776→          // Handle --from-inbox flag
   777→          if (options.fromInbox) {
   778→            // Load inbox items
   779→            const inboxItems = await loadInboxItems(ctx);
   780→            const item = findInboxItemByRef(inboxItems, options.fromInbox);
   781→
   782→            if (!item) {
   783→              error(errors.reference.inboxNotFound(options.fromInbox));
   784→              process.exit(EXIT_CODES.NOT_FOUND);
   785→            }
   786→
   787→            // Use inbox item content
   788→            const observationContent = item.text;
   789→
   790→            // Type defaults to 'idea' but can be overridden with --type flag
   791→            const observationType = (options.type || "idea") as ObservationType;
   792→
   793→            // Validate observation type
   794→            const validTypes: ObservationType[] = [
   795→              "friction",
   796→              "success",
   797→              "question",
   798→              "idea",
   799→            ];
   800→            if (!validTypes.includes(observationType)) {
   801→              error(errors.validation.invalidObservationType(observationType));
   802→              console.log(`Valid types: ${validTypes.join(", ")}`);
   803→              process.exit(EXIT_CODES.ERROR);
   804→            }
   805→
   806→            // Create observation
   807→            const observation = createObservation(
   808→              observationType,
   809→              observationContent,
   810→              {
   811→                workflow_ref: options.workflow,
   812→                author: options.author,
   813→              },
   814→            );
   815→
   816→            // Save observation
   817→            await saveObservation(ctx, observation);
   818→
   819→            // Delete inbox item
   820→            const deleted = await deleteInboxItem(ctx, item._ulid);
   821→            if (!deleted) {
   822→              error("Failed to delete inbox item after creating observation");
   823→              process.exit(EXIT_CODES.ERROR);
   824→            }
   825→
   826→            await commitIfShadow(
   827→              ctx.shadow,
   828→              "meta-observe-from-inbox",
   829→              observation._ulid.substring(0, 8),
   830→              `Convert inbox item to ${observationType} observation`,
   831→            );
   832→
   833→            // Return observation ref
   834→            output(observation, () =>
   835→              success(
   836→                `Created observation: ${observation._ulid.substring(0, 8)}`,
   837→              ),
   838→            );
   839→            return;
   840→          }
   841→
   842→          // Standard observe flow (without --from-inbox)
   843→          if (!type || !content) {
   844→            error("Type and content are required when not using --from-inbox");
   845→            process.exit(EXIT_CODES.ERROR);
   846→          }
   847→
   848→          // Validate observation type
   849→          const validTypes: ObservationType[] = [
   850→            "friction",
   851→            "success",
   852→            "question",
   853→            "idea",
   854→          ];
   855→          if (!validTypes.includes(type as ObservationType)) {
   856→            error(errors.validation.invalidObservationType(type));
   857→            console.log(`Valid types: ${validTypes.join(", ")}`);
   858→            process.exit(EXIT_CODES.ERROR);
   859→          }
   860→
   861→          // Create observation
   862→          const observation = createObservation(
   863→            type as ObservationType,
   864→            content,
   865→            {
   866→              workflow_ref: options.workflow,
   867→              author: options.author,
   868→            },
   869→          );
   870→
   871→          // Save to manifest
   872→          await saveObservation(ctx, observation);
   873→
   874→          // AC: @trait-shadow-commit ac-1
   875→          await commitIfShadow(
   876→            ctx.shadow,
   877→            "meta-observe",
   878→            observation._ulid.substring(0, 8),
   879→            type as string,
   880→          );
   881→
   882→          // AC-obs-1: outputs "OK Created observation: <ULID-prefix>"
   883→          // In JSON mode, return the created observation object
   884→          output(observation, () =>
   885→            success(
   886→              `Created observation: ${observation._ulid.substring(0, 8)}`,
   887→            ),
   888→          );
   889→        } catch (err) {
   890→          error(errors.failures.createObservation, err);
   891→          process.exit(EXIT_CODES.ERROR);
   892→        }
   893→      },
   894→    );
   895→
   896→  // AC-obs-2, AC-obs-5: kspec meta observations
   897→  meta
   898→    .command("observations")
   899→    .description("List observations (shows unresolved by default)")
   900→    .option(
   901→      "--type <type>",
   902→      "Filter by observation type (friction/success/question/idea)",
   903→    )
   904→    .option("--workflow <ref>", "Filter by workflow reference")
   905→    .option("--all", "Include resolved observations")
   906→    .option("--promoted", "Show only observations promoted to tasks")
   907→    .option(
   908→      "--pending-resolution",
   909→      "Show observations with completed tasks awaiting resolution",
   910→    )
   911→    .action(async (options) => {
   912→      try {
   913→        const ctx = await initContext();
   914→
   915→        if (!ctx.manifestPath) {
   916→          error(errors.project.noKspecProject);
   917→          process.exit(EXIT_CODES.ERROR);
   918→        }
   919→
   920→        const metaCtx = await loadMetaContext(ctx);
   921→        let observations = metaCtx.observations || [];
   922→
   923→        // Apply filters
   924→        if (options.type) {
   925→          observations = observations.filter(
   926→            (obs) => obs.type === options.type,
   927→          );
   928→        }
   929→
   930→        if (options.workflow) {
   931→          observations = observations.filter(
   932→            (obs) => obs.workflow_ref === options.workflow,
   933→          );
   934→        }
   935→
   936→        if (options.promoted) {
   937→          observations = observations.filter(
   938→            (obs) => obs.promoted_to !== undefined,
   939→          );
   940→        }
   941→
   942→        if (options.pendingResolution) {
   943→          // Load tasks to check if promoted tasks are completed
   944→          const tasks = await loadAllTasks(ctx);
   945→          const items = await loadAllItems(ctx);
   946→          const index = new ReferenceIndex(tasks, items);
   947→
   948→          observations = observations.filter((obs) => {
   949→            if (!obs.promoted_to || obs.resolved) return false;
   950→            const taskResult = index.resolve(obs.promoted_to);
   951→            if (!taskResult.ok) return false;
   952→            const item = taskResult.item;
   953→            // Type guard: check if item is a task (has status and depends_on properties)
   954→            return (
   955→              "status" in item &&
   956→              "depends_on" in item &&
   957→              item.status === "completed"
   958→            );
   959→          });
   960→        }
   961→
   962→        // AC-obs-5: JSON output includes full observation objects
   963→        output(
   964→          observations.map((obs) => ({
   965→            _ulid: obs._ulid,
   966→            type: obs.type,
   967→            content: obs.content,
   968→            workflow_ref: obs.workflow_ref ?? null,
   969→            created_at: obs.created_at,
   970→            author: obs.author ?? null,
   971→            resolved: obs.resolved,
   972→            resolution: obs.resolution ?? null,
   973→            resolved_at: obs.resolved_at ?? null,
   974→            resolved_by: obs.resolved_by ?? null,
   975→            promoted_to: obs.promoted_to ?? null,
   976→          })),
   977→          // AC-obs-2: Table output with ID, Type, Workflow, Created, Content
   978→          () => formatObservations(observations, options.all),
   979→        );
   980→      } catch (err) {
   981→        error(errors.failures.listObservations, err);
   982→        process.exit(EXIT_CODES.ERROR);
   983→      }
   984→    });
   985→
   986→  // AC-obs-3, AC-obs-6, AC-obs-8: kspec meta promote
   987→  meta
   988→    .command("promote <ref>")
   989→    .description("Promote observation to a task")
   990→    .requiredOption("--title <title>", "Task title")
   991→    .option("--priority <priority>", "Task priority (1-5)", "2")
   992→    .option("--force", "Force promotion even if observation is resolved")
   993→    .action(async (ref: string, options) => {
   994→      try {
   995→        const ctx = await initContext();
   996→
   997→        if (!ctx.manifestPath) {
   998→          error(errors.project.noKspecProject);
   999→          process.exit(EXIT_CODES.ERROR);
  1000→        }
  1001→
  1002→        const metaCtx = await loadMetaContext(ctx);
  1003→        const observations = metaCtx.observations || [];
  1004→
  1005→        // Find observation
  1006→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1007→        const observation = observations.find((o) =>
  1008→          o._ulid.startsWith(normalizedRef),
  1009→        );
  1010→
  1011→        if (!observation) {
  1012→          error(errors.reference.observationNotFound(ref));
  1013→          process.exit(EXIT_CODES.ERROR);
  1014→        }
  1015→
  1016→        // AC-obs-6: Check if already promoted
  1017→        if (observation.promoted_to) {
  1018→          error(
  1019→            errors.conflict.observationAlreadyPromoted(observation.promoted_to),
  1020→          );
  1021→          process.exit(EXIT_CODES.CONFLICT);
  1022→        }
  1023→
  1024→        // AC-obs-8: Check if resolved
  1025→        if (observation.resolved && !options.force) {
  1026→          error(errors.operation.cannotPromoteResolved);
  1027→          process.exit(EXIT_CODES.ERROR);
  1028→        }
  1029→
  1030→        // AC-obs-3: Create task with title, description from observation, meta_ref, and origin
  1031→        const task = createTask({
  1032→          title: options.title,
  1033→          description: observation.content,
  1034→          priority: Number.parseInt(options.priority, 10),
  1035→          meta_ref: observation.workflow_ref,
  1036→          origin: "observation_promotion",
  1037→        });
  1038→
  1039→        // Save task
  1040→        await saveTask(ctx, task);
  1041→        await commitIfShadow(
  1042→          ctx.shadow,
  1043→          "task-add",
  1044→          task.slugs[0] || task._ulid.slice(0, 8),
  1045→          task.title,
  1046→        );
  1047→        const taskRef = `@${task._ulid.substring(0, 8)}`;
  1048→
  1049→        // Update observation with promoted_to field
  1050→        observation.promoted_to = taskRef;
  1051→        await saveObservation(ctx, observation);
  1052→
  1053→        // AC: @trait-shadow-commit ac-1
  1054→        await commitIfShadow(
  1055→          ctx.shadow,
  1056→          "observation-promote",
  1057→          observation._ulid.substring(0, 8),
  1058→        );
  1059→
  1060→        // AC-obs-3: outputs "OK Created task: <ULID-prefix>"
  1061→        // In JSON mode, return the created task object
  1062→        output(task, () => success(`Created task: ${taskRef.substring(0, 9)}`));
  1063→      } catch (err) {
  1064→        error(errors.failures.promoteObservation, err);
  1065→        process.exit(EXIT_CODES.ERROR);
  1066→      }
  1067→    });
  1068→
  1069→  // AC-obs-4, AC-obs-7, AC-obs-9: kspec meta resolve
  1070→  meta
  1071→    .command("resolve <ref> [resolution]")
  1072→    .description("Resolve an observation")
  1073→    .action(async (ref: string, resolution: string | undefined) => {
  1074→      try {
  1075→        const ctx = await initContext();
  1076→
  1077→        if (!ctx.manifestPath) {
  1078→          error(errors.project.noKspecProject);
  1079→          process.exit(EXIT_CODES.ERROR);
  1080→        }
  1081→
  1082→        const metaCtx = await loadMetaContext(ctx);
  1083→        const observations = metaCtx.observations || [];
  1084→
  1085→        // Find observation
  1086→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1087→        const observation = observations.find((o) =>
  1088→          o._ulid.startsWith(normalizedRef),
  1089→        );
  1090→
  1091→        if (!observation) {
  1092→          error(errors.reference.observationNotFound(ref));
  1093→          process.exit(EXIT_CODES.ERROR);
  1094→        }
  1095→
  1096→        // AC-obs-7: Check if already resolved
  1097→        if (observation.resolved) {
  1098→          const resolvedDate = new Date(observation.resolved_at!)
  1099→            .toISOString()
  1100→            .split("T")[0];
  1101→          const resolutionText = observation.resolution || "";
  1102→          const truncated =
  1103→            resolutionText.length > 50
  1104→              ? `${resolutionText.substring(0, 50)}...`
  1105→              : resolutionText;
  1106→          error(
  1107→            errors.conflict.observationAlreadyResolved(resolvedDate, truncated),
  1108→          );
  1109→          process.exit(EXIT_CODES.CONFLICT);
  1110→        }
  1111→
  1112→        // AC-obs-9: Auto-populate resolution from task completion if promoted
  1113→        let finalResolution = resolution;
  1114→        if (!finalResolution && observation.promoted_to) {
  1115→          // Fetch task to get completion reason
  1116→          const tasks = await loadAllTasks(ctx);
  1117→          const items = await loadAllItems(ctx);
  1118→          const index = new ReferenceIndex(tasks, items);
  1119→          const taskResult = index.resolve(observation.promoted_to);
  1120→
  1121→          if (taskResult.ok) {
  1122→            const item = taskResult.item;
  1123→            // Type guard: ensure this is a task (has status and depends_on properties)
  1124→            if ("status" in item && "depends_on" in item) {
  1125→              const task = item as LoadedTask;
  1126→              if (task.status === "completed" && task.closed_reason) {
  1127→                finalResolution = `Resolved via task ${observation.promoted_to}: ${task.closed_reason}`;
  1128→              } else if (task.status === "completed") {
  1129→                finalResolution = `Resolved via task ${observation.promoted_to}`;
  1130→              } else {
  1131→                error(`Task ${observation.promoted_to} is not completed yet`);
  1132→                process.exit(EXIT_CODES.ERROR);
  1133→              }
  1134→            } else {
  1135→              error(`Reference ${observation.promoted_to} is not a task`);
  1136→              process.exit(EXIT_CODES.ERROR);
  1137→            }
  1138→          } else {
  1139→            error(`Task ${observation.promoted_to} not found`);
  1140→            process.exit(EXIT_CODES.ERROR);
  1141→          }
  1142→        }
  1143→
  1144→        if (!finalResolution) {
  1145→          error(errors.validation.resolutionRequired);
  1146→          process.exit(EXIT_CODES.ERROR);
  1147→        }
  1148→
  1149→        // AC-obs-4: Update observation
  1150→        observation.resolved = true;
  1151→        observation.resolution = finalResolution;
  1152→        observation.resolved_at = new Date().toISOString();
  1153→        observation.resolved_by = observation.author; // Use same author
  1154→
  1155→        await saveObservation(ctx, observation);
  1156→
  1157→        // AC: @trait-shadow-commit ac-1
  1158→        await commitIfShadow(
  1159→          ctx.shadow,
  1160→          "observation-resolve",
  1161→          observation._ulid.substring(0, 8),
  1162→        );
  1163→
  1164→        // AC-obs-4: outputs "OK Resolved: <ULID-prefix>"
  1165→        success(`Resolved: ${observation._ulid.substring(0, 8)}`);
  1166→      } catch (err) {
  1167→        error(errors.failures.resolveObservation, err);
  1168→        process.exit(EXIT_CODES.ERROR);
  1169→      }
  1170→    });
  1171→
  1172→  // Meta add command - create new meta items
  1173→  meta
  1174→    .command("add <type>")
  1175→    .description("Create a new meta item (agent, workflow, or convention)")
  1176→    .option("--id <id>", "Semantic ID (required for agents and workflows)")
  1177→    .option("--domain <domain>", "Domain (required for conventions)")
  1178→    .option("--name <name>", "Name (for agents)")
  1179→    .option("--trigger <trigger>", "Trigger (for workflows)")
  1180→    .option("--description <desc>", "Description")
  1181→    .option("--capability <cap...>", "Capabilities (for agents)")
  1182→    .option("--tool <tool...>", "Tools (for agents)")
  1183→    .option("--convention <conv...>", "Convention references (for agents)")
  1184→    .option("--rule <rule...>", "Rules (for conventions)")
  1185→    .option("--steps <json>", "Workflow steps as JSON array (for workflows)")
  1186→    .option(
  1187→      "--mode <mode>",
  1188→      "Workflow mode: interactive (default) or loop (for workflows)",
  1189→    )
  1190→    .option("--based-on <ref>", "Base workflow reference (for loop workflows)")
  1191→    .option("--tag <tag...>", "Tags for the workflow (for workflows)")
  1192→    .action(async (type: string, options) => {
  1193→      try {
  1194→        const ctx = await initContext();
  1195→
  1196→        // Validate type
  1197→        const validTypes = ["agent", "workflow", "convention"];
  1198→        if (!validTypes.includes(type)) {
  1199→          error(errors.validation.invalidType(type, validTypes));
  1200→          process.exit(EXIT_CODES.ERROR);
  1201→        }
  1202→
  1203→        // Generate ULID
  1204→        const itemUlid = ulid();
  1205→
  1206→        // Create the item based on type
  1207→        let item: Agent | Workflow | Convention;
  1208→
  1209→        if (type === "agent") {
  1210→          // Validate required fields
  1211→          if (!options.id) {
  1212→            error(errors.validation.agentRequiresId);
  1213→            process.exit(EXIT_CODES.ERROR);
  1214→          }
  1215→          if (!options.name) {
  1216→            error(errors.validation.agentRequiresName);
  1217→            process.exit(EXIT_CODES.ERROR);
  1218→          }
  1219→
  1220→          item = {
  1221→            _ulid: itemUlid,
  1222→            id: options.id,
  1223→            name: options.name,
  1224→            description: options.description || "",
  1225→            capabilities: options.capability || [],
  1226→            tools: options.tool || [],
  1227→            conventions: options.convention || [],
  1228→          };
  1229→        } else if (type === "workflow") {
  1230→          // Validate required fields
  1231→          if (!options.id) {
  1232→            error(errors.validation.workflowRequiresId);
  1233→            process.exit(EXIT_CODES.ERROR);
  1234→          }
  1235→          if (!options.trigger) {
  1236→            error(errors.validation.workflowRequiresTrigger);
  1237→            process.exit(EXIT_CODES.ERROR);
  1238→          }
  1239→
  1240→          // Parse and validate --steps if provided
  1241→          let steps: WorkflowStep[] = [];
  1242→          if (options.steps) {
  1243→            // AC: @meta-add-cmd ac-2 - Parse JSON
  1244→            let parsedSteps: unknown;
  1245→            try {
  1246→              parsedSteps = JSON.parse(options.steps);
  1247→            } catch (err) {
  1248→              const message = err instanceof Error ? err.message : String(err);
  1249→              error(errors.validation.invalidStepsJson(message));
  1250→              process.exit(EXIT_CODES.ERROR);
  1251→            }
  1252→
  1253→            // AC: @meta-add-cmd ac-3 - Verify it's an array
  1254→            if (!Array.isArray(parsedSteps)) {
  1255→              error(errors.validation.stepsNotArray);
  1256→              process.exit(EXIT_CODES.ERROR);
  1257→            }
  1258→
  1259→            // AC: @meta-add-cmd ac-4 - Validate with schema
  1260→            const result = z.array(WorkflowStepSchema).safeParse(parsedSteps);
  1261→            if (!result.success) {
  1262→              const issues = result.error.issues
  1263→                .map((i) => `${i.path.join(".")}: ${i.message}`)
  1264→                .join("; ");
  1265→              error(errors.validation.invalidStepsSchema(issues));
  1266→              process.exit(EXIT_CODES.ERROR);
  1267→            }
  1268→            steps = result.data;
  1269→          }
  1270→
  1271→          // Validate mode if provided
  1272→          const validModes = ["interactive", "loop"];
  1273→          if (options.mode && !validModes.includes(options.mode)) {
  1274→            error(
  1275→              `Invalid mode: ${options.mode}. Valid modes: ${validModes.join(", ")}`,
  1276→            );
  1277→            process.exit(EXIT_CODES.ERROR);
  1278→          }
  1279→
  1280→          item = {
  1281→            _ulid: itemUlid,
  1282→            id: options.id,
  1283→            trigger: options.trigger,
  1284→            description: options.description || "",
  1285→            steps,
  1286→            ...(options.mode && { mode: options.mode }),
  1287→            ...(options.basedOn && { based_on: options.basedOn }),
  1288→            ...(options.tag && options.tag.length > 0 && { tags: options.tag }),
  1289→          };
  1290→        } else {
  1291→          // convention
  1292→          if (!options.domain) {
  1293→            error(errors.validation.conventionRequiresDomain);
  1294→            process.exit(EXIT_CODES.ERROR);
  1295→          }
  1296→
  1297→          item = {
  1298→            _ulid: itemUlid,
  1299→            domain: options.domain,
  1300→            rules: options.rule || [],
  1301→            examples: [],
  1302→          };
  1303→        }
  1304→
  1305→        // Save the item
  1306→        await saveMetaItem(
  1307→          ctx,
  1308→          item,
  1309→          type as "agent" | "workflow" | "convention",
  1310→        );
  1311→
  1312→        // AC: @trait-shadow-commit ac-1
  1313→        await commitIfShadow(
  1314→          ctx.shadow,
  1315→          `meta-add-${type}`,
  1316→          itemUlid.substring(0, 8),
  1317→          "id" in item ? item.id : "domain" in item ? item.domain : undefined,
  1318→        );
  1319→
  1320→        if (isJsonMode()) {
  1321→          // In JSON mode, output the item data directly
  1322→          console.log(JSON.stringify(item, null, 2));
  1323→        } else {
  1324→          const idOrDomain =
  1325→            "id" in item ? item.id : "domain" in item ? item.domain : itemUlid;
  1326→          success(
  1327→            `Created ${type}: ${idOrDomain} (@${itemUlid.substring(0, 8)})`,
  1328→          );
  1329→        }
  1330→      } catch (err) {
  1331→        error(errors.failures.createMeta(type), err);
  1332→        process.exit(EXIT_CODES.ERROR);
  1333→      }
  1334→    });
  1335→
  1336→  // Meta set command - update existing meta items
  1337→  meta
  1338→    .command("set <ref>")
  1339→    .description("Update an existing meta item")
  1340→    .option("--name <name>", "Update name (for agents)")
  1341→    .option("--description <desc>", "Update description")
  1342→    .option("--trigger <trigger>", "Update trigger (for workflows)")
  1343→    .option("--add-capability <cap>", "Add capability (for agents)")
  1344→    .option("--add-tool <tool>", "Add tool (for agents)")
  1345→    .option("--add-convention <conv>", "Add convention reference (for agents)")
  1346→    .option("--add-rule <rule>", "Add rule (for conventions)")
  1347→    .action(async (ref: string, options) => {
  1348→      try {
  1349→        const ctx = await initContext();
  1350→        const metaCtx = await loadMetaContext(ctx);
  1351→
  1352→        // Find the item using unified lookup
  1353→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1354→        let found: Agent | Workflow | Convention | null = null;
  1355→        let itemType: "agent" | "workflow" | "convention" | null = null;
  1356→
  1357→        // Search in agents
  1358→        const agents = metaCtx.manifest?.agents || [];
  1359→        const agent = agents.find(
  1360→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
  1361→        );
  1362→        if (agent) {
  1363→          found = agent;
  1364→          itemType = "agent";
  1365→        }
  1366→
  1367→        // Search in workflows
  1368→        if (!found) {
  1369→          const workflows = metaCtx.manifest?.workflows || [];
  1370→          const workflow = workflows.find(
  1371→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
  1372→          );
  1373→          if (workflow) {
  1374→            found = workflow;
  1375→            itemType = "workflow";
  1376→          }
  1377→        }
  1378→
  1379→        // Search in conventions
  1380→        if (!found) {
  1381→          const conventions = metaCtx.manifest?.conventions || [];
  1382→          const convention = conventions.find(
  1383→            (c) =>
  1384→              c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
  1385→          );
  1386→          if (convention) {
  1387→            found = convention;
  1388→            itemType = "convention";
  1389→          }
  1390→        }
  1391→
  1392→        if (!found || !itemType) {
  1393→          error(errors.reference.metaNotFound(ref));
  1394→          process.exit(EXIT_CODES.ERROR);
  1395→        }
  1396→
  1397→        // Update fields based on type
  1398→        if (itemType === "agent") {
  1399→          const item = found as Agent;
  1400→          if (options.name) item.name = options.name;
  1401→          if (options.description !== undefined)
  1402→            item.description = options.description;
  1403→          if (options.addCapability) {
  1404→            if (!item.capabilities.includes(options.addCapability)) {
  1405→              item.capabilities.push(options.addCapability);
  1406→            }
  1407→          }
  1408→          if (options.addTool) {
  1409→            if (!item.tools.includes(options.addTool)) {
  1410→              item.tools.push(options.addTool);
  1411→            }
  1412→          }
  1413→          if (options.addConvention) {
  1414→            if (!item.conventions.includes(options.addConvention)) {
  1415→              item.conventions.push(options.addConvention);
  1416→            }
  1417→          }
  1418→        } else if (itemType === "workflow") {
  1419→          const item = found as Workflow;
  1420→          if (options.trigger) item.trigger = options.trigger;
  1421→          if (options.description !== undefined)
  1422→            item.description = options.description;
  1423→        } else {
  1424→          const item = found as Convention;
  1425→          // Convention doesn't have a description field
  1426→          if (options.addRule) {
  1427→            if (!item.rules.includes(options.addRule)) {
  1428→              item.rules.push(options.addRule);
  1429→            }
  1430→          }
  1431→        }
  1432→
  1433→        // Save the updated item
  1434→        await saveMetaItem(ctx, found, itemType);
  1435→
  1436→        // AC: @trait-shadow-commit ac-1
  1437→        await commitIfShadow(
  1438→          ctx.shadow,
  1439→          `meta-set-${itemType}`,
  1440→          found._ulid.substring(0, 8),
  1441→        );
  1442→
  1443→        if (isJsonMode()) {
  1444→          // In JSON mode, output the item data directly
  1445→          console.log(JSON.stringify(found, null, 2));
  1446→        } else {
  1447→          const idOrDomain =
  1448→            itemType === "agent"
  1449→              ? (found as Agent).id
  1450→              : itemType === "workflow"
  1451→                ? (found as Workflow).id
  1452→                : (found as Convention).domain;
  1453→          success(`Updated ${itemType}: ${idOrDomain}`);
  1454→        }
  1455→      } catch (err) {
  1456→        error(errors.failures.updateMetaItem, err);
  1457→        process.exit(EXIT_CODES.ERROR);
  1458→      }
  1459→    });
  1460→
  1461→  // Meta delete command - delete meta items
  1462→  meta
  1463→    .command("delete <ref>")
  1464→    .description("Delete a meta item")
  1465→    .option("--confirm", "Skip confirmation prompt")
  1466→    .action(async (ref: string, options) => {
  1467→      try {
  1468→        const ctx = await initContext();
  1469→        const metaCtx = await loadMetaContext(ctx);
  1470→
  1471→        // Find the item to determine type
  1472→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1473→        let itemType:
  1474→          | "agent"
  1475→          | "workflow"
  1476→          | "convention"
  1477→          | "observation"
  1478→          | null = null;
  1479→        let itemUlid: string | null = null;
  1480→        let itemLabel: string | null = null;
  1481→
  1482→        // Search in agents
  1483→        const agents = metaCtx.manifest?.agents || [];
  1484→        const agent = agents.find(
  1485→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
  1486→        );
  1487→        if (agent) {
  1488→          itemType = "agent";
  1489→          itemUlid = agent._ulid;
  1490→          itemLabel = `agent ${agent.id}`;
  1491→        }
  1492→
  1493→        // Search in workflows
  1494→        if (!itemType) {
  1495→          const workflows = metaCtx.manifest?.workflows || [];
  1496→          const workflow = workflows.find(
  1497→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
  1498→          );
  1499→          if (workflow) {
  1500→            itemType = "workflow";
  1501→            itemUlid = workflow._ulid;
  1502→            itemLabel = `workflow ${workflow.id}`;
  1503→          }
  1504→        }
  1505→
  1506→        // Search in conventions
  1507→        if (!itemType) {
  1508→          const conventions = metaCtx.manifest?.conventions || [];
  1509→          const convention = conventions.find(
  1510→            (c) =>
  1511→              c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
  1512→          );
  1513→          if (convention) {
  1514→            itemType = "convention";
  1515→            itemUlid = convention._ulid;
  1516→            itemLabel = `convention ${convention.domain}`;
  1517→          }
  1518→        }
  1519→
  1520→        // Search in observations
  1521→        if (!itemType) {
  1522→          const observations = metaCtx.observations || [];
  1523→          const observation = observations.find((o) =>
  1524→            o._ulid.startsWith(normalizedRef),
  1525→          );
  1526→          if (observation) {
  1527→            itemType = "observation";
  1528→            itemUlid = observation._ulid;
  1529→            itemLabel = `observation ${observation._ulid.substring(0, 8)}`;
  1530→          }
  1531→        }
  1532→
  1533→        if (!itemType || !itemUlid || !itemLabel) {
  1534→          error(errors.reference.metaNotFound(ref));
  1535→          process.exit(EXIT_CODES.ERROR);
  1536→        }
  1537→
  1538→        // Check for dangling references (unless --confirm is used to override)
  1539→        if (!options.confirm) {
  1540→          // Check tasks with meta_ref
  1541→          const tasks = await loadAllTasks(ctx);
  1542→          const referencingTasks = tasks.filter((t) => {
  1543→            if (!t.meta_ref) return false;
  1544→            // Resolve the task's meta_ref to a ULID
  1545→            const taskMetaRef = resolveMetaRefToUlid(t.meta_ref, metaCtx);
  1546→            // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1547→            return taskMetaRef && taskMetaRef.ulid === itemUlid;
  1548→          });
  1549→
  1550→          if (referencingTasks.length > 0) {
  1551→            const taskRefs = referencingTasks
  1552→              .map((t) => `@${t.slugs?.[0] || t._ulid.substring(0, 8)}`)
  1553→              .join(", ");
  1554→            error(
  1555→              errors.operation.cannotDeleteReferencedByTasks(
  1556→                itemLabel,
  1557→                referencingTasks.length,
  1558→                taskRefs,
  1559→              ),
  1560→            );
  1561→            process.exit(EXIT_CODES.ERROR);
  1562→          }
  1563→
  1564→          // Check observations with workflow_ref (only for workflows)
  1565→          if (itemType === "workflow") {
  1566→            const observations = metaCtx.observations || [];
  1567→            const referencingObservations = observations.filter((o) => {
  1568→              if (!o.workflow_ref) return false;
  1569→              // Resolve the observation's workflow_ref to a ULID
  1570→              const obsWorkflowRef = resolveMetaRefToUlid(
  1571→                o.workflow_ref,
  1572→                metaCtx,
  1573→              );
  1574→              // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1575→              return obsWorkflowRef && obsWorkflowRef.ulid === itemUlid;
  1576→            });
  1577→
  1578→            if (referencingObservations.length > 0) {
  1579→              const obsRefs = referencingObservations
  1580→                .map((o) => `@${o._ulid.substring(0, 8)}`)
  1581→                .join(", ");
  1582→              error(
  1583→                errors.operation.cannotDeleteReferencedByObservations(
  1584→                  itemLabel,
  1585→                  referencingObservations.length,
  1586→                  obsRefs,
  1587→                ),
  1588→              );
  1589→              process.exit(EXIT_CODES.ERROR);
  1590→            }
  1591→          }
  1592→
  1593→          // Show confirmation prompt even if no references found
  1594→          error(errors.operation.confirmRequired(itemLabel));
  1595→          process.exit(EXIT_CODES.ERROR);
  1596→        }
  1597→
  1598→        // Delete the item
  1599→        const deleted = await deleteMetaItem(ctx, itemUlid, itemType);
  1600→
  1601→        if (!deleted) {
  1602→          error(errors.operation.deleteItemFailed(itemLabel));
  1603→          process.exit(EXIT_CODES.ERROR);
  1604→        }
  1605→
  1606→        // AC: @trait-shadow-commit ac-1
  1607→        await commitIfShadow(
  1608→          ctx.shadow,
  1609→          `meta-delete-${itemType}`,
  1610→          itemUlid.substring(0, 8),
  1611→        );
  1612→
  1613→        success(`Deleted ${itemLabel}`);
  1614→      } catch (err) {
  1615→        error(errors.failures.deleteMetaItem, err);
  1616→        process.exit(EXIT_CODES.ERROR);
  1617→      }
  1618→    });
  1619→
  1620→  // meta-focus-cmd: kspec meta focus [ref]
  1621→  meta
  1622→    .command("focus [ref]")
  1623→    .description("Get or set session focus")
  1624→    .option("--clear", "Clear current focus")
  1625→    .action(async (ref: string | undefined, options) => {
  1626→      try {
  1627→        const ctx = await initContext();
  1628→
  1629→        if (!ctx.manifestPath) {
  1630→          error(errors.project.noKspecProject);
  1631→          process.exit(EXIT_CODES.ERROR);
  1632→        }
  1633→
  1634→        const sessionCtx = await loadSessionContext(ctx);
  1635→
  1636→        // Clear focus
  1637→        if (options.clear) {
  1638→          sessionCtx.focus = null;
  1639→          await saveSessionContext(ctx, sessionCtx);
  1640→
  1641→          output({ focus: null }, () => success("Cleared session focus"));
  1642→          return;
  1643→        }
  1644→
  1645→        // Show current focus
  1646→        if (!ref) {
  1647→          output({ focus: sessionCtx.focus }, () => {
  1648→            if (sessionCtx.focus) {
  1649→              console.log(`Current focus: ${sessionCtx.focus}`);
  1650→            } else {
  1651→              console.log(chalk.yellow("No focus set"));
  1652→            }
  1653→          });
  1654→          return;
  1655→        }
  1656→
  1657→        // Set focus to ref
  1658→        sessionCtx.focus = ref.startsWith("@") ? ref : `@${ref}`;
  1659→        await saveSessionContext(ctx, sessionCtx);
  1660→
  1661→        output({ focus: sessionCtx.focus }, () =>
  1662→          success(`Set focus to: ${sessionCtx.focus}`),
  1663→        );
  1664→      } catch (err) {
  1665→        error(errors.failures.updateSessionContext, err);
  1666→        process.exit(EXIT_CODES.ERROR);
  1667→      }
  1668→    });
  1669→
  1670→  // meta-thread-cmd: kspec meta thread <action> [text]
  1671→  meta
  1672→    .command("thread <action> [text]")
  1673→    .description("Manage active threads")
  1674→    .action(async (action: string, text: string | undefined) => {
  1675→      try {
  1676→        const ctx = await initContext();
  1677→
  1678→        if (!ctx.manifestPath) {
  1679→          error(errors.project.noKspecProject);
  1680→          process.exit(EXIT_CODES.ERROR);
  1681→        }
  1682→
  1683→        const sessionCtx = await loadSessionContext(ctx);
  1684→
  1685→        // List threads
  1686→        if (action === "list") {
  1687→          output({ threads: sessionCtx.threads }, () => {
  1688→            if (sessionCtx.threads.length === 0) {
  1689→              console.log(chalk.yellow("No active threads"));
  1690→            } else {
  1691→              console.log("Active threads:");
  1692→              sessionCtx.threads.forEach((thread, idx) => {
  1693→                console.log(`  ${idx + 1}. ${thread}`);
  1694→              });
  1695→            }
  1696→          });
  1697→          return;
  1698→        }
  1699→
  1700→        // Clear all threads
  1701→        if (action === "clear") {
  1702→          sessionCtx.threads = [];
  1703→          await saveSessionContext(ctx, sessionCtx);
  1704→
  1705→          output({ threads: [] }, () => success("Cleared all threads"));
  1706→          return;
  1707→        }
  1708→
  1709→        // Add thread
  1710→        if (action === "add") {
  1711→          if (!text) {
  1712→            error("Thread text is required for add action");
  1713→            process.exit(EXIT_CODES.ERROR);
  1714→          }
  1715→
  1716→          sessionCtx.threads.push(text);
  1717→          await saveSessionContext(ctx, sessionCtx);
  1718→
  1719→          output({ threads: sessionCtx.threads, added: text }, () =>
  1720→            success(`Added thread: ${text}`),
  1721→          );
  1722→          return;
  1723→        }
  1724→
  1725→        // Remove thread by index (1-based)
  1726→        if (action === "remove") {
  1727→          if (!text) {
  1728→            error("Index is required for remove action");
  1729→            process.exit(EXIT_CODES.ERROR);
  1730→          }
  1731→
  1732→          const index = parseInt(text, 10);
  1733→          if (
  1734→            Number.isNaN(index) ||
  1735→            index < 1 ||
  1736→            index > sessionCtx.threads.length
  1737→          ) {
  1738→            error(
  1739→              `Invalid index: ${text}. Must be between 1 and ${sessionCtx.threads.length}`,
  1740→            );
  1741→            process.exit(EXIT_CODES.ERROR);
  1742→          }
  1743→
  1744→          const removed = sessionCtx.threads.splice(index - 1, 1)[0];
  1745→          await saveSessionContext(ctx, sessionCtx);
  1746→
  1747→          output({ threads: sessionCtx.threads, removed }, () =>
  1748→            success(`Removed thread: ${removed}`),
  1749→          );
  1750→          return;
  1751→        }
  1752→
  1753→        // Unknown action
  1754→        error(`Unknown action: ${action}. Use add, remove, list, or clear`);
  1755→        process.exit(EXIT_CODES.ERROR);
  1756→      } catch (err) {
  1757→        error(errors.failures.updateSessionContext, err);
  1758→        process.exit(EXIT_CODES.ERROR);
  1759→      }
  1760→    });
  1761→
  1762→  // meta-question-cmd: kspec meta question <action> [text]
  1763→  meta
  1764→    .command("question <action> [text]")
  1765→    .description("Manage open questions")
  1766→    .action(async (action: string, text: string | undefined) => {
  1767→      try {
  1768→        const ctx = await initContext();
  1769→
  1770→        if (!ctx.manifestPath) {
  1771→          error(errors.project.noKspecProject);
  1772→          process.exit(EXIT_CODES.ERROR);
  1773→        }
  1774→
  1775→        const sessionCtx = await loadSessionContext(ctx);
  1776→
  1777→        // List questions
  1778→        if (action === "list") {
  1779→          output({ questions: sessionCtx.open_questions }, () => {
  1780→            if (sessionCtx.open_questions.length === 0) {
  1781→              console.log(chalk.yellow("No open questions"));
  1782→            } else {
  1783→              console.log("Open questions:");
  1784→              sessionCtx.open_questions.forEach((question, idx) => {
  1785→                console.log(`  ${idx + 1}. ${question}`);
  1786→              });
  1787→            }
  1788→          });
  1789→          return;
  1790→        }
  1791→
  1792→        // Clear all questions
  1793→        if (action === "clear") {
  1794→          sessionCtx.open_questions = [];
  1795→          await saveSessionContext(ctx, sessionCtx);
  1796→
  1797→          output({ questions: [] }, () => success("Cleared all questions"));
  1798→          return;
  1799→        }
  1800→
  1801→        // Add question
  1802→        if (action === "add") {
  1803→          if (!text) {
  1804→            error("Question text is required for add action");
  1805→            process.exit(EXIT_CODES.ERROR);
  1806→          }
  1807→
  1808→          sessionCtx.open_questions.push(text);
  1809→          await saveSessionContext(ctx, sessionCtx);
  1810→
  1811→          output({ questions: sessionCtx.open_questions, added: text }, () =>
  1812→            success(`Added question: ${text}`),
  1813→          );
  1814→          return;
  1815→        }
  1816→
  1817→        // Remove question by index (1-based)
  1818→        if (action === "remove") {
  1819→          if (!text) {
  1820→            error("Index is required for remove action");
  1821→            process.exit(EXIT_CODES.ERROR);
  1822→          }
  1823→
  1824→          const index = parseInt(text, 10);
  1825→          if (
  1826→            Number.isNaN(index) ||
  1827→            index < 1 ||
  1828→            index > sessionCtx.open_questions.length
  1829→          ) {
  1830→            error(
  1831→              `Invalid index: ${text}. Must be between 1 and ${sessionCtx.open_questions.length}`,
  1832→            );
  1833→            process.exit(EXIT_CODES.ERROR);
  1834→          }
  1835→
  1836→          const removed = sessionCtx.open_questions.splice(index - 1, 1)[0];
  1837→          await saveSessionContext(ctx, sessionCtx);
  1838→
  1839→          output({ questions: sessionCtx.open_questions, removed }, () =>
  1840→            success(`Removed question: ${removed}`),
  1841→          );
  1842→          return;
  1843→        }
  1844→
  1845→        // Unknown action
  1846→        error(`Unknown action: ${action}. Use add, remove, list, or clear`);
  1847→        process.exit(EXIT_CODES.ERROR);
  1848→      } catch (err) {
  1849→        error(errors.failures.updateSessionContext, err);
  1850→        process.exit(EXIT_CODES.ERROR);
  1851→      }
  1852→    });
  1853→
  1854→  // meta-context-cmd: kspec meta context
  1855→  meta
  1856→    .command("context")
  1857→    .description("Show full session context")
  1858→    .option("--clear", "Clear all session context")
  1859→    .action(async (options) => {
  1860→      try {
  1861→        const ctx = await initContext();
  1862→
  1863→        if (!ctx.manifestPath) {
  1864→          error(errors.project.noKspecProject);
  1865→          process.exit(EXIT_CODES.ERROR);
  1866→        }
  1867→
  1868→        const sessionCtx = await loadSessionContext(ctx);
  1869→
  1870→        // Clear all context
  1871→        if (options.clear) {
  1872→          sessionCtx.focus = null;
  1873→          sessionCtx.threads = [];
  1874→          sessionCtx.open_questions = [];
  1875→          await saveSessionContext(ctx, sessionCtx);
  1876→
  1877→          output(
  1878→            {
  1879→              focus: null,
  1880→              threads: [],
  1881→              open_questions: [],
  1882→              updated_at: sessionCtx.updated_at,
  1883→            },
  1884→            () => success("Cleared all session context"),
  1885→          );
  1886→          return;
  1887→        }
  1888→
  1889→        // Show full session context
  1890→        output(
  1891→          {
  1892→            focus: sessionCtx.focus,
  1893→            threads: sessionCtx.threads,
  1894→            open_questions: sessionCtx.open_questions,
  1895→            updated_at: sessionCtx.updated_at,
  1896→          },
  1897→          () => {
  1898→            console.log(chalk.bold("Session Context"));
  1899→            console.log(chalk.gray("─".repeat(60)));
  1900→
  1901→            // Focus
  1902→            console.log(chalk.bold("\nFocus:"));
  1903→            if (sessionCtx.focus) {
  1904→              console.log(`  ${sessionCtx.focus}`);
  1905→            } else {
  1906→              console.log(chalk.gray("  (none)"));
  1907→            }
  1908→
  1909→            // Active threads
  1910→            console.log(chalk.bold("\nActive Threads:"));
  1911→            if (sessionCtx.threads.length > 0) {
  1912→              sessionCtx.threads.forEach((thread, idx) => {
  1913→                console.log(`  ${idx + 1}. ${thread}`);
  1914→              });
  1915→            } else {
  1916→              console.log(chalk.gray("  (none)"));
  1917→            }
  1918→
  1919→            // Open questions
  1920→            console.log(chalk.bold("\nOpen Questions:"));
  1921→            if (sessionCtx.open_questions.length > 0) {
  1922→              sessionCtx.open_questions.forEach((question, idx) => {
  1923→                console.log(`  ${idx + 1}. ${question}`);
  1924→              });
  1925→            } else {
  1926→              console.log(chalk.gray("  (none)"));
  1927→            }
  1928→
  1929→            // Last updated
  1930→            console.log(chalk.bold("\nLast Updated:"));
  1931→            const updatedDate = new Date(sessionCtx.updated_at);
  1932→            console.log(`  ${updatedDate.toISOString()}`);
  1933→            console.log(chalk.gray(`  (${updatedDate.toLocaleString()})`));
  1934→          },
  1935→        );
  1936→      } catch (err) {
  1937→        error(errors.failures.updateSessionContext, err);
  1938→        process.exit(EXIT_CODES.ERROR);
  1939→      }
  1940→    });
  1941→}
  1942→

