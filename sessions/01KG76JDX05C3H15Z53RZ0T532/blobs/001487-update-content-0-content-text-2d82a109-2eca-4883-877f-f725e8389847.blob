  1389→            return { item: resolved.task, error: resolved.error };
  1390→          },
  1391→          executeOperation: async (foundTask, { ctx, index, options }) => {
  1392→            try {
  1393→              if (
  1394→                foundTask.status === "completed" ||
  1395→                foundTask.status === "cancelled"
  1396→              ) {
  1397→                return {
  1398→                  success: false,
