  1400→                };
  1401→              }
  1402→
  1403→              const updatedTask: Task = {
  1404→                ...foundTask,
  1405→                status: "cancelled",
  1406→                closed_reason: options.reason || null,
  1407→              };
  1408→
  1409→              await saveTask(ctx, updatedTask);
  1410→              await commitIfShadow(
  1411→                ctx.shadow,
  1412→                "task-cancel",
  1413→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1414→              );
  1415→
  1416→              return {
  1417→                success: true,
  1418→                message: `Cancelled task: ${index.shortUlid(updatedTask._ulid)}`,
  1419→                data: updatedTask,
  1420→              };
  1421→            } catch (err) {
  1422→              return {
  1423→                success: false,
  1424→                error: err instanceof Error ? err.message : String(err),
  1425→              };
  1426→            }
  1427→          },
  1428→          getUlid: (task) => task._ulid,
  1429→        });
  1430→
  1431→        formatBatchOutput(result, "Cancel");
  1432→      } catch (err) {
  1433→        error(errors.failures.cancelTask, err);
  1434→        process.exit(EXIT_CODES.ERROR);
  1435→      }
  1436→    });
  1437→
  1438→  // kspec task reset <ref>
  1439→  // AC: @spec-task-reset ac-1, ac-2, ac-3, ac-4, ac-5, ac-6
  1440→  task
  1441→    .command("reset <ref>")
  1442→    .description("Reset a task to pending state")
  1443→    .action(async (ref: string) => {
  1444→      try {
  1445→        const ctx = await initContext();
  1446→        const tasks = await loadAllTasks(ctx);
  1447→        const items = await loadAllItems(ctx);
  1448→        const index = new ReferenceIndex(tasks, items);
  1449→        const foundTask = resolveTaskRef(ref, tasks, index);
  1450→
  1451→        // AC: @spec-task-reset ac-2 - Error if already pending
  1452→        if (foundTask.status === "pending") {
  1453→          error("Task is already pending");
  1454→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1455→        }
  1456→
  1457→        // Track previous status and reason for note (AC-4)
  1458→        const previousStatus = foundTask.status;
  1459→        const hadCancelReason =
  1460→          foundTask.closed_reason && foundTask.status === "cancelled";
  1461→        const cancelReasonText = hadCancelReason
  1462→          ? ` (was cancelled: ${foundTask.closed_reason})`
  1463→          : "";
  1464→
  1465→        // AC: @spec-task-reset ac-1 - Reset to pending, clear completion-related fields
  1466→        const clearedFields: string[] = [];
  1467→        const updatedTask: Task = {
  1468→          ...foundTask,
  1469→          status: "pending",
  1470→        };
  1471→
  1472→        // Clear timestamps and reasons based on previous status
  1473→        if (
  1474→          foundTask.completed_at !== undefined &&
  1475→          foundTask.completed_at !== null
  1476→        ) {
  1477→          updatedTask.completed_at = null;
  1478→          clearedFields.push("completed_at");
  1479→        }
  1480→        if (
  1481→          foundTask.started_at !== undefined &&
  1482→          foundTask.started_at !== null
  1483→        ) {
  1484→          updatedTask.started_at = null;
  1485→          clearedFields.push("started_at");
  1486→        }
  1487→        if (
  1488→          foundTask.closed_reason !== undefined &&
  1489→          foundTask.closed_reason !== null
  1490→        ) {
  1491→          updatedTask.closed_reason = null;
  1492→          clearedFields.push("closed_reason");
  1493→        }
  1494→        if (foundTask.blocked_by.length > 0) {
  1495→          updatedTask.blocked_by = [];
  1496→          clearedFields.push("blocked_by");
  1497→        }
  1498→
  1499→        // AC: @spec-task-reset ac-4 - Add note documenting the reset
  1500→        // AC: @spec-task-reset ac-author
  1501→        const noteContent = `Reset from ${previousStatus} to pending${cancelReasonText}`;
  1502→        const note = createNote(noteContent, getAuthor());
  1503→        updatedTask.notes = [...updatedTask.notes, note];
  1504→
  1505→        await saveTask(ctx, updatedTask);
  1506→        // AC: @spec-task-reset ac-3 - Shadow commit with message task-reset
  1507→        await commitIfShadow(
  1508→          ctx.shadow,
  1509→          "task-reset",
  1510→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1511→          `from ${previousStatus}`,
  1512→        );
  1513→
  1514→        // AC: @spec-task-reset ac-6 - JSON output includes previous_status, new_status, cleared_fields
  1515→        const jsonOutput = {
  1516→          task: updatedTask,
  1517→          previous_status: previousStatus,
  1518→          new_status: "pending" as const,
  1519→          cleared_fields: clearedFields,
  1520→        };
  1521→
  1522→        output(jsonOutput, () => {
  1523→          success(
  1524→            `Reset task: ${index.shortUlid(updatedTask._ulid)} (${previousStatus} → pending)`,
  1525→            undefined,
  1526→          );
  1527→          if (clearedFields.length > 0) {
  1528→            info(`Cleared fields: ${clearedFields.join(", ")}`);
  1529→          }
  1530→        });
  1531→      } catch (err) {
  1532→        error("Failed to reset task", err);
  1533→        process.exit(EXIT_CODES.ERROR);
  1534→      }
  1535→    });
  1536→
  1537→  // kspec task delete <ref> | --refs <refs...>
  1538→  // AC: @multi-ref-batch ac-1, ac-2
  1539→  task
  1540→    .command("delete [ref]")
  1541→    .description("Delete a task permanently")
  1542→    .option("--refs <refs...>", "Delete multiple tasks by ref")
  1543→    .option("--force", "Skip confirmation (required for --refs)")
  1544→    .option("--dry-run", "Show what would be deleted without deleting")
  1545→    .action(async (ref: string | undefined, options) => {
  1546→      try {
  1547→        const ctx = await initContext();
  1548→        const tasks = await loadAllTasks(ctx);
  1549→        const items = await loadAllItems(ctx);
  1550→        const index = new ReferenceIndex(tasks, items);
  1551→
  1552→        // For batch mode (--refs), require --force
  1553→        if (
  1554→          options.refs &&
  1555→          options.refs.length > 0 &&
  1556→          !options.force &&
  1557→          !options.dryRun
  1558→        ) {
  1559→          error("Batch delete requires --force flag");
  1560→          process.exit(EXIT_CODES.USAGE_ERROR);
  1561→        }
  1562→
  1563→        const result = await executeBatchOperation({
  1564→          positionalRef: ref,
  1565→          refsFlag: options.refs,
  1566→          context: { ctx, tasks, items, index, options },
  1567→          items: tasks,
  1568→          index,
  1569→          resolveRef: (refStr, taskList, idx) => {
  1570→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1571→            return { item: resolved.task, error: resolved.error };
  1572→          },
  1573→          executeOperation: async (foundTask, { ctx, index, options }) => {
  1574→            try {
  1575→              const taskDisplay = `${foundTask.title} (${index.shortUlid(foundTask._ulid)})`;
  1576→
  1577→              if (options.dryRun) {
  1578→                return {
  1579→                  success: true,
  1580→                  message: `Would delete: ${taskDisplay}`,
  1581→                };
  1582→              }
  1583→
  1584→              // For single-ref mode (not --refs), prompt for confirmation unless --force
  1585→              if (!options.refs && !options.force) {
  1586→                const readline = await import("node:readline");
  1587→                const rl = readline.createInterface({
  1588→                  input: process.stdin,
  1589→                  output: process.stdout,
  1590→                });
  1591→
  1592→                const answer = await new Promise<string>((resolve) => {
  1593→                  rl.question(`Delete task "${taskDisplay}"? [y/N] `, resolve);
  1594→                });
  1595→                rl.close();
  1596→
  1597→                if (answer.toLowerCase() !== "y") {
  1598→                  return {
  1599→                    success: false,
  1600→                    error: "Deletion cancelled by user",
  1601→                  };
  1602→                }
  1603→              }
  1604→
  1605→              await deleteTask(ctx, foundTask);
  1606→              await commitIfShadow(
  1607→                ctx.shadow,
  1608→                "task-delete",
  1609→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1610→                foundTask.title,
  1611→              );
  1612→
  1613→              return {
  1614→                success: true,
  1615→                message: `Deleted task: ${taskDisplay}`,
  1616→              };
  1617→            } catch (err) {
  1618→              return {
  1619→                success: false,
  1620→                error: err instanceof Error ? err.message : String(err),
  1621→              };
  1622→            }
  1623→          },
  1624→          getUlid: (task) => task._ulid,
  1625→        });
  1626→
  1627→        formatBatchOutput(result, "Delete");
  1628→      } catch (err) {
  1629→        error(errors.failures.deleteTask, err);
  1630→        process.exit(EXIT_CODES.ERROR);
  1631→      }
  1632→    });
  1633→
  1634→  // kspec task note <ref> <message>
  1635→  task
  1636→    .command("note <ref> <message>")
  1637→    .description("Add a note to a task")
  1638→    .option("--author <author>", "Note author")
  1639→    .option("--supersedes <ulid>", "ULID of note this supersedes")
  1640→    .action(async (ref: string, message: string, options) => {
