  1670→          console.log(alignmentCheck.updateSpec(foundTask.spec_ref));
  1671→          console.log(alignmentCheck.addAC);
  1672→
  1673→          // Check if linked spec has acceptance criteria and remind about test coverage
  1674→          const specResult = index.resolve(foundTask.spec_ref);
