    41→
    42→/**
    43→ * Find a task by reference with detailed error reporting.
    44→ * Returns the task or exits with appropriate error.
    45→ */
    46→function resolveTaskRef(
    47→  ref: string,
    48→  tasks: LoadedTask[],
    49→  index: ReferenceIndex,
    50→): LoadedTask {
    51→  const result = index.resolve(ref);
    52→
    53→  if (!result.ok) {
    54→    switch (result.error) {
    55→      case "not_found":
    56→        error(errors.reference.taskNotFound(ref));
    57→        break;
    58→      case "ambiguous":
    59→        error(errors.reference.ambiguous(ref));
    60→        for (const candidate of result.candidates) {
    61→          const task = tasks.find((t) => t._ulid === candidate);
    62→          const slug = task?.slugs[0] || "";
    63→          console.error(
    64→            `  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ""}`,
    65→          );
    66→        }
    67→        break;
    68→      case "duplicate_slug":
    69→        error(errors.reference.slugMapsToMultiple(ref));
    70→        for (const candidate of result.candidates) {
    71→          console.error(`  - ${index.shortUlid(candidate)}`);
    72→        }
    73→        break;
    74→    }
    75→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    76→    process.exit(EXIT_CODES.NOT_FOUND);
    77→  }
    78→
    79→  // Check if it's actually a task
    80→  const task = tasks.find((t) => t._ulid === result.ulid);
    81→  if (!task) {
    82→    error(errors.reference.notTask(ref));
    83→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    84→    process.exit(EXIT_CODES.NOT_FOUND);
    85→  }
    86→
    87→  return task;
    88→}
    89→
    90→/**
    91→ * Batch-compatible resolver that returns null instead of calling process.exit().
    92→ * Used by executeBatchOperation to handle errors without terminating the process.
    93→ * AC: @multi-ref-batch ac-4, ac-8 - Partial failure handling and ref resolution
    94→ */
    95→function resolveTaskRefForBatch(
    96→  ref: string,
    97→  tasks: LoadedTask[],
    98→  index: ReferenceIndex,
    99→): { task: LoadedTask | null; error?: string } {
   100→  const result = index.resolve(ref);
   101→
   102→  if (!result.ok) {
   103→    let errorMsg: string;
   104→    switch (result.error) {
   105→      case "not_found":
   106→        errorMsg = `Reference "${ref}" not found`;
   107→        break;
   108→      case "ambiguous":
   109→        errorMsg = `Reference "${ref}" is ambiguous (matches ${result.candidates.length} items)`;
   110→        break;
   111→      case "duplicate_slug":
   112→        errorMsg = `Slug "${ref}" maps to multiple items`;
   113→        break;
   114→    }
   115→    return { task: null, error: errorMsg };
   116→  }
   117→
   118→  // Check if it's actually a task
   119→  const task = tasks.find((t) => t._ulid === result.ulid);
   120→  if (!task) {
   121→    return { task: null, error: `Reference "${ref}" is not a task` };
   122→  }
   123→
   124→  return { task };
   125→}
   126→
   127→/**
   128→ * Helper function to update task fields.
   129→ * Used by both single-ref and batch modes of task set.
   130→ * AC: @spec-task-set-batch ac-1, ac-2, ac-4, ac-5
   131→ */
   132→async function setTaskFields(
   133→  foundTask: LoadedTask,
   134→  ctx: any,
   135→  tasks: LoadedTask[],
   136→  items: LoadedSpecItem[],
   137→  _allMetaItems: any[],
   138→  index: ReferenceIndex,
   139→  options: any,
   140→): Promise<{
   141→  success: boolean;
   142→  message?: string;
   143→  error?: string;
   144→  data?: unknown;
   145→}> {
   146→  try {
   147→    // Check slug uniqueness if adding a new slug
   148→    if (options.slug) {
   149→      const slugCheck = checkSlugUniqueness(
   150→        index,
   151→        [options.slug],
   152→        foundTask._ulid,
   153→      );
   154→      if (!slugCheck.ok) {
   155→        return {
   156→          success: false,
   157→          error: `Slug "${slugCheck.slug}" already exists on ${slugCheck.existingUlid}`,
   158→        };
   159→      }
   160→    }
   161→
   162→    // Build updated task with only provided options
   163→    const updatedTask: Task = { ...foundTask };
   164→    const changes: string[] = [];
   165→
   166→    if (options.title) {
   167→      updatedTask.title = options.title;
   168→      changes.push("title");
   169→    }
   170→
   171→    if (options.specRef) {
   172→      // Validate the spec ref exists and is a spec item
   173→      const specResult = index.resolve(options.specRef);
   174→      if (!specResult.ok) {
   175→        return {
   176→          success: false,
   177→          error: errors.reference.specRefNotFound(options.specRef),
   178→        };
   179→      }
   180→      // Check it's not a task
   181→      const isTask = tasks.some((t) => t._ulid === specResult.ulid);
   182→      if (isTask) {
   183→        return {
   184→          success: false,
   185→          error: errors.reference.specRefIsTask(options.specRef),
   186→        };
   187→      }
   188→      updatedTask.spec_ref = options.specRef;
   189→      changes.push("spec_ref");
   190→    }
   191→
   192→    if (options.metaRef) {
   193→      // Validate the meta ref exists and is a meta item
   194→      const metaRefResult = index.resolve(options.metaRef);
   195→      if (!metaRefResult.ok) {
   196→        return {
   197→          success: false,
   198→          error: errors.reference.metaRefNotFound(options.metaRef),
   199→        };
   200→      }
   201→
   202→      // Check if the resolved item is a meta item (not a spec item or task)
   203→      const isTask = tasks.some((t) => t._ulid === metaRefResult.ulid);
   204→      const isSpecItem = items.some((i) => i._ulid === metaRefResult.ulid);
   205→
   206→      if (isTask || isSpecItem) {
   207→        return {
   208→          success: false,
   209→          error: errors.reference.metaRefPointsToSpec(options.metaRef),
   210→        };
   211→      }
   212→
   213→      updatedTask.meta_ref = options.metaRef;
   214→      changes.push("meta_ref");
   215→    }
   216→
   217→    if (options.priority) {
   218→      const priority = parseInt(options.priority, 10);
   219→      if (Number.isNaN(priority) || priority < 1 || priority > 5) {
   220→        return {
   221→          success: false,
   222→          error: "Priority must be between 1 and 5",
   223→        };
   224→      }
   225→      updatedTask.priority = priority;
   226→      changes.push("priority");
   227→    }
   228→
   229→    if (options.slug) {
   230→      if (!updatedTask.slugs.includes(options.slug)) {
   231→        updatedTask.slugs = [...updatedTask.slugs, options.slug];
   232→        changes.push("slug");
   233→      }
   234→    }
   235→
   236→    if (options.tag) {
   237→      const newTags = options.tag.filter(
   238→        (t: string) => !updatedTask.tags.includes(t),
   239→      );
   240→      if (newTags.length > 0) {
   241→        updatedTask.tags = [...updatedTask.tags, ...newTags];
   242→        changes.push("tags");
   243→      }
   244→    }
   245→
   246→    if (options.dependsOn) {
   247→      // Validate all dependency refs
   248→      for (const depRef of options.dependsOn) {
   249→        const depResult = index.resolve(depRef);
   250→        if (!depResult.ok) {
   251→          return {
   252→            success: false,
   253→            error: errors.reference.depNotFound(depRef),
   254→          };
   255→        }
   256→      }
   257→      updatedTask.depends_on = options.dependsOn;
   258→      changes.push("depends_on");
   259→    }
   260→
   261→    // AC: @spec-task-clear-deps ac-1, ac-2 - Clear all dependencies
   262→    if (options.clearDeps) {
   263→      if (foundTask.depends_on.length === 0) {
   264→        // AC: @spec-task-clear-deps ac-2 - No changes needed
   265→        return {
   266→          success: true,
   267→          message: "No changes: task has no dependencies to clear",
   268→        };
   269→      }
   270→      updatedTask.depends_on = [];
   271→      changes.push("depends_on");
   272→
   273→      // Add note documenting the change
   274→      // AC: @task-set ac-author
   275→      const note = createNote(
   276→        `Dependencies cleared (was: ${foundTask.depends_on.join(", ")})`,
   277→        getAuthor(),
   278→      );
   279→      updatedTask.notes = [...updatedTask.notes, note];
   280→    }
   281→
   282→    // AC: @task-automation-eligibility ac-5, ac-11, ac-12, ac-18
   283→    // Handle automation status changes
   284→    // Note: --no-automation sets options.automation to false, so check that first
   285→    if (options.automation === false) {
   286→      // --no-automation flag clears the automation status (AC: ac-12)
   287→      delete updatedTask.automation;
   288→      changes.push("automation");
   289→    } else if (options.automation !== undefined) {
   290→      const validStatuses = ["eligible", "needs_review", "manual_only"];
   291→      if (!validStatuses.includes(options.automation)) {
   292→        return {
   293→          success: false,
   294→          error: `Invalid automation status: ${options.automation}. Must be one of: ${validStatuses.join(", ")}`,
   295→        };
   296→      }
   297→
   298→      // AC: @task-automation-eligibility ac-18 - require reason for needs_review
   299→      if (options.automation === "needs_review" && !options.reason) {
   300→        return {
   301→          success: false,
   302→          error:
   303→            "Setting automation to needs_review requires --reason flag explaining why",
   304→        };
   305→      }
   306→
   307→      updatedTask.automation = options.automation as
   308→        | "eligible"
   309→        | "needs_review"
   310→        | "manual_only";
   311→      changes.push("automation");
   312→
   313→      // If reason provided, add a note documenting the change
   314→      // AC: @task-set ac-author
   315→      if (options.reason) {
   316→        const note = createNote(
   317→          `Automation status set to ${options.automation}: ${options.reason}`,
   318→          getAuthor(),
   319→        );
   320→        updatedTask.notes = [...updatedTask.notes, note];
   321→        changes.push("note");
   322→      }
   323→    }
   324→
   325→    // AC: @spec-task-set-batch ac-4 - Warn on no changes, don't fail
   326→    if (changes.length === 0) {
   327→      return {
   328→        success: true,
   329→        message: "No changes specified",
   330→        data: { task: updatedTask },
   331→      };
   332→    }
   333→
   334→    await saveTask(ctx, updatedTask);
   335→    await commitIfShadow(
   336→      ctx.shadow,
   337→      "task-set",
   338→      foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
   339→      changes.join(", "),
   340→    );
   341→
   342→    return {
   343→      success: true,
   344→      message: `Updated task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(", ")})`,
   345→      data: { task: updatedTask },
   346→    };
   347→  } catch (err) {
   348→    return {
   349→      success: false,
   350→      error: err instanceof Error ? err.message : String(err),
   351→    };
   352→  }
   353→}
   354→
   355→/**
   356→ * Register the 'task' command group (singular - operations on individual tasks)
   357→ */
   358→export function registerTaskCommands(program: Command): void {
   359→  const task = program
   360→    .command("task")
   361→    .description("Operations on individual tasks");
   362→
   363→  // kspec task list - alias for 'kspec tasks list'
   364→  task
   365→    .command("list")
   366→    .description("List all tasks (alias for 'kspec tasks list')")
   367→    .option("-s, --status <status>", "Filter by status")
   368→    .option("-t, --type <type>", "Filter by type")
   369→    .option("--tag <tag>", "Filter by tag")
   370→    .option("--meta-ref <ref>", "Filter by meta reference")
   371→    .option("-g, --grep <pattern>", "Search content with regex pattern")
   372→    .option("-v, --verbose", "Show more details")
   373→    .option("--full", "Show full details (notes, todos, timestamps)")
   374→    .action(async (options) => {
   375→      try {
   376→        const ctx = await initContext();
   377→        const allTasks = await loadAllTasks(ctx);
   378→        const items = await loadAllItems(ctx);
   379→
   380→        // Load meta items if filtering by meta-ref
   381→        const { loadMetaContext } = await import("../../parser/meta.js");
   382→        const metaContext = await loadMetaContext(ctx);
   383→        const allMetaItems = [
   384→          ...metaContext.agents,
   385→          ...metaContext.workflows,
   386→          ...metaContext.conventions,
   387→          ...metaContext.observations,
   388→        ];
   389→
   390→        const index = new ReferenceIndex(allTasks, items, allMetaItems);
   391→
   392→        let taskList = allTasks;
   393→
   394→        // Apply filters
   395→        if (options.status) {
   396→          taskList = taskList.filter((t) => t.status === options.status);
   397→        }
   398→        if (options.type) {
   399→          taskList = taskList.filter((t) => t.type === options.type);
   400→        }
   401→        if (options.tag) {
   402→          taskList = taskList.filter((t) => t.tags.includes(options.tag));
   403→        }
   404→        if (options.metaRef) {
   405→          const metaRefResult = index.resolve(options.metaRef);
   406→          if (!metaRefResult.ok) {
   407→            error(errors.reference.metaRefNotFound(options.metaRef));
   408→            process.exit(EXIT_CODES.NOT_FOUND);
   409→          }
   410→          const targetRef = options.metaRef.startsWith("@")
   411→            ? options.metaRef
   412→            : `@${options.metaRef}`;
   413→          taskList = taskList.filter(
   414→            (t) => t.meta_ref === targetRef || t.meta_ref === options.metaRef,
   415→          );
   416→        }
   417→        if (options.grep) {
   418→          taskList = taskList.filter((t) => {
   419→            const match = grepItem(
   420→              t as unknown as Record<string, unknown>,
   421→              options.grep,
   422→            );
   423→            return match !== null;
   424→          });
   425→        }
   426→
   427→        output(taskList, () =>
   428→          formatTaskList(
   429→            taskList,
   430→            options.verbose,
   431→            index,
   432→            options.grep,
   433→            options.full,
   434→          ),
   435→        );
   436→      } catch (err) {
   437→        error(errors.failures.listTasks, err);
   438→        process.exit(EXIT_CODES.ERROR);
   439→      }
   440→    });
   441→
   442→  // kspec task get <ref>
   443→  task
   444→    .command("get <ref>")
   445→    .description("Get task details")
   446→    .action(async (ref: string) => {
   447→      try {
   448→        const ctx = await initContext();
   449→        const tasks = await loadAllTasks(ctx);
   450→        const _items = await loadAllItems(ctx);
   451→
   452→        // Build all indexes including TraitIndex
   453→        const { refIndex: index, traitIndex } = await (async () => {
   454→          const { buildIndexes } = await import("../../parser/index.js");
   455→          return buildIndexes(ctx);
   456→        })();
   457→
   458→        const foundTask = resolveTaskRef(ref, tasks, index);
   459→
   460→        // AC: @trait-display ac-3 - task get shows inherited AC sections
   461→        // Get inherited traits if task has spec_ref
   462→        let inheritedTraits: Array<{
   463→          trait: {
   464→            ulid: string;
   465→            slug: string;
   466→            title: string;
   467→            description?: string;
   468→          };
   469→          acs: Array<{
   470→            id: string;
   471→            given?: string;
   472→            when?: string;
   473→            then?: string;
   474→          }>;
   475→        }> = [];
   476→        if (foundTask.spec_ref) {
   477→          const specResult = index.resolve(foundTask.spec_ref);
   478→          if (specResult.ok) {
   479→            const specUlid = specResult.ulid;
   480→            const inheritedAC = traitIndex.getInheritedAC(specUlid);
   481→            const traitsByTrait = new Map<
   482→              string,
   483→              {
   484→                trait: (typeof inheritedAC)[0]["trait"];
   485→                acs: Array<{
   486→                  id: string;
   487→                  given?: string;
   488→                  when?: string;
   489→                  then?: string;
   490→                }>;
   491→              }
   492→            >();
   493→            for (const { trait, ac } of inheritedAC) {
   494→              if (!traitsByTrait.has(trait.ulid)) {
   495→                traitsByTrait.set(trait.ulid, { trait, acs: [] });
   496→              }
   497→              traitsByTrait.get(trait.ulid)?.acs.push(ac);
   498→            }
   499→            inheritedTraits = Array.from(traitsByTrait.values());
   500→          }
   501→        }
   502→
   503→        // Build JSON output with inherited traits (AC: @trait-display ac-2)
   504→        const jsonOutput = {
   505→          ...foundTask,
   506→          ...(inheritedTraits.length > 0 && {
   507→            inherited_traits: inheritedTraits.map(({ trait, acs }) => ({
   508→              ref: `@${trait.slug}`,
   509→              title: trait.title,
   510→              acceptance_criteria: acs,
   511→            })),
   512→          }),
   513→        };
   514→
   515→        output(jsonOutput, () => {
   516→          formatTaskDetails(foundTask, index);
   517→
   518→          // AC: @trait-display ac-3, ac-4, ac-5 - Show inherited AC per trait in labeled sections
   519→          if (inheritedTraits.length > 0) {
   520→            for (const { trait, acs } of inheritedTraits) {
   521→              console.log(
   522→                chalk.gray(`\n─── Inherited from @${trait.slug} ───`),
   523→              );
   524→              for (const ac of acs) {
   525→                console.log(
   526→                  chalk.cyan(`  [${ac.id}]`) +
   527→                    chalk.gray(` (from @${trait.slug})`),
   528→                );
   529→                if (ac.given) console.log(`    Given: ${ac.given}`);
   530→                if (ac.when) console.log(`    When: ${ac.when}`);
   531→                if (ac.then) console.log(`    Then: ${ac.then}`);
   532→              }
   533→            }
   534→          }
   535→        });
   536→      } catch (err) {
   537→        error(errors.failures.getTask, err);
   538→        process.exit(EXIT_CODES.ERROR);
   539→      }
   540→    });
   541→
   542→  // kspec task add
   543→  task
   544→    .command("add")
   545→    .description("Create a new task")
   546→    .requiredOption("--title <title>", "Task title")
   547→    .option("--description <description>", "Task description")
   548→    .option(
   549→      "--type <type>",
   550→      "Task type (task, epic, bug, spike, infra)",
   551→      "task",
   552→    )
   553→    .option("--spec-ref <ref>", "Reference to spec item")
   554→    .option(
   555→      "--meta-ref <ref>",
   556→      "Reference to meta item (workflow, agent, or convention)",
   557→    )
   558→    .option("--priority <n>", "Priority (1-5)", "3")
   559→    .option("--slug <slug>", "Human-friendly slug")
   560→    .option("--tag <tag...>", "Tags")
   561→    .option(
   562→      "--automation <status>",
   563→      "Automation eligibility (eligible, needs_review, manual_only)",
   564→    )
   565→    .action(async (options) => {
   566→      try {
   567→        const ctx = await initContext();
   568→        const tasks = await loadAllTasks(ctx);
   569→        const items = await loadAllItems(ctx);
   570→
   571→        // Load meta items for validation
   572→        const { loadMetaContext } = await import("../../parser/meta.js");
   573→        const metaContext = await loadMetaContext(ctx);
   574→        const allMetaItems = [
   575→          ...metaContext.agents,
   576→          ...metaContext.workflows,
   577→          ...metaContext.conventions,
   578→          ...metaContext.observations,
   579→        ];
   580→
   581→        // Build index for reference validation
   582→        const refIndex = new ReferenceIndex(tasks, items, allMetaItems);
   583→
   584→        // Check slug uniqueness if provided
   585→        if (options.slug) {
   586→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   587→          if (!slugCheck.ok) {
   588→            error(
   589→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
   590→            );
   591→            process.exit(EXIT_CODES.CONFLICT);
   592→          }
   593→        }
   594→
   595→        // Validate meta_ref if provided (AC-meta-ref-3, AC-meta-ref-4)
   596→        if (options.metaRef) {
   597→          const metaRefResult = refIndex.resolve(options.metaRef);
   598→
   599→          if (!metaRefResult.ok) {
   600→            error(errors.reference.metaRefNotFound(options.metaRef));
   601→            process.exit(EXIT_CODES.NOT_FOUND);
   602→          }
   603→
   604→          // Check if the resolved item is a meta item (not a spec item or task)
   605→          const isTask = tasks.some((t) => t._ulid === metaRefResult.ulid);
   606→          const isSpecItem = items.some((i) => i._ulid === metaRefResult.ulid);
   607→
   608→          if (isTask || isSpecItem) {
   609→            error(errors.reference.metaRefPointsToSpec(options.metaRef));
   610→            process.exit(EXIT_CODES.NOT_FOUND);
   611→          }
   612→        }
   613→
   614→        // AC: @task-automation-eligibility ac-13 - validate automation if provided
   615→        let automationValue:
   616→          | "eligible"
   617→          | "needs_review"
   618→          | "manual_only"
   619→          | undefined;
   620→        if (options.automation) {
   621→          const validStatuses = ["eligible", "needs_review", "manual_only"];
   622→          if (!validStatuses.includes(options.automation)) {
   623→            error(
   624→              `Invalid automation status: ${options.automation}. Must be one of: ${validStatuses.join(", ")}`,
   625→            );
   626→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   627→          }
   628→          automationValue = options.automation as
   629→            | "eligible"
   630→            | "needs_review"
   631→            | "manual_only";
   632→        }
   633→
   634→        // AC: @spec-task-add-description ac-6 - Omit description if empty string
   635→        const descriptionValue =
   636→          options.description && options.description.trim() !== ""
   637→            ? options.description
   638→            : undefined;
   639→
   640→        const input: TaskInput = {
   641→          title: options.title,
   642→          description: descriptionValue,
   643→          type: options.type,
   644→          spec_ref: options.specRef || null,
   645→          meta_ref: options.metaRef || null,
   646→          priority: parseInt(options.priority, 10),
   647→          slugs: options.slug ? [options.slug] : [],
   648→          tags: options.tag || [],
   649→          automation: automationValue,
   650→        };
   651→
   652→        const newTask = createTask(input);
   653→        await saveTask(ctx, newTask);
   654→        await commitIfShadow(
   655→          ctx.shadow,
   656→          "task-add",
   657→          newTask.slugs[0] || newTask._ulid.slice(0, 8),
   658→          newTask.title,
   659→        );
   660→
   661→        // Build index including the new task for accurate short ULID
   662→        const index = new ReferenceIndex(
   663→          [...tasks, newTask],
   664→          items,
   665→          allMetaItems,
   666→        );
   667→        success(`Created task: ${index.shortUlid(newTask._ulid)}`, {
   668→          task: newTask,
   669→        });
   670→      } catch (err) {
   671→        error(errors.failures.createTask, err);
   672→        process.exit(EXIT_CODES.ERROR);
   673→      }
   674→    });
   675→
   676→  // kspec task set <ref>
   677→  task
   678→    .command("set [ref]")
   679→    .description("Update task fields")
   680→    .option(
   681→      "--refs <refs...>",
   682→      "Update multiple tasks (AC: @spec-task-set-batch ac-1)",
   683→    )
   684→    .option("--title <title>", "Update task title")
   685→    .option("--spec-ref <ref>", "Link to spec item")
   686→    .option(
   687→      "--meta-ref <ref>",
   688→      "Link to meta item (workflow, agent, or convention)",
   689→    )
   690→    .option("--priority <n>", "Set priority (1-5)")
   691→    .option("--slug <slug>", "Add a slug alias")
   692→    .option("--tag <tag...>", "Add tags")
   693→    .option("--depends-on <refs...>", "Set dependencies (replaces existing)")
   694→    .option("--clear-deps", "Clear all dependencies")
   695→    .option(
   696→      "--automation <status>",
   697→      "Set automation eligibility (eligible, needs_review, manual_only)",
   698→    )
   699→    .option("--no-automation", "Clear automation status (return to unassessed)")
   700→    .option(
   701→      "--reason <reason>",
   702→      "Reason for status change (required when setting needs_review)",
   703→    )
   704→    .option(
   705→      "--status <status>",
   706→      "Reject with error - use state transition commands instead",
   707→    )
   708→    .action(async (ref: string | undefined, options) => {
   709→      try {
   710→        // AC: @spec-task-set-batch ac-3 - Reject --status flag
   711→        if (options.status !== undefined) {
   712→          error(
   713→            "Use state transition commands (start, complete, block, etc.) to change status",
   714→          );
   715→          process.exit(EXIT_CODES.USAGE_ERROR);
   716→        }
   717→
   718→        // AC: @spec-task-clear-deps ac-3 - Mutual exclusivity check
   719→        if (options.clearDeps && options.dependsOn) {
   720→          error("Cannot use --clear-deps and --depends-on together");
   721→          process.exit(EXIT_CODES.USAGE_ERROR);
   722→        }
   723→
   724→        const ctx = await initContext();
   725→        const tasks = await loadAllTasks(ctx);
   726→        const items = await loadAllItems(ctx);
   727→
   728→        // Load meta items for validation
   729→        const { loadMetaContext } = await import("../../parser/meta.js");
   730→        const metaContext = await loadMetaContext(ctx);
   731→        const allMetaItems = [
   732→          ...metaContext.agents,
   733→          ...metaContext.workflows,
   734→          ...metaContext.conventions,
   735→          ...metaContext.observations,
   736→        ];
   737→
   738→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   739→
   740→        // AC: @trait-multi-ref-batch ac-8 - Deduplicate refs
   741→        const refsFlag = options.refs
   742→          ? [...new Set(options.refs as string[])]
   743→          : undefined;
   744→
   745→        // Batch mode or single mode?
   746→        if (refsFlag && refsFlag.length > 0) {
   747→          // Batch mode - AC: @spec-task-set-batch ac-1, ac-2, ac-5
   748→          const result = await executeBatchOperation({
   749→            positionalRef: ref,
   750→            refsFlag,
   751→            context: { ctx, tasks, items, allMetaItems, index, options },
   752→            items: tasks,
   753→            index,
   754→            resolveRef: (
   755→              refStr: string,
   756→              taskList: LoadedTask[],
   757→              idx: ReferenceIndex,
   758→            ) => {
   759→              const result = resolveTaskRefForBatch(refStr, taskList, idx);
   760→              return { item: result.task, error: result.error };
   761→            },
   762→            executeOperation: async (task: LoadedTask, context) => {
   763→              return await setTaskFields(
   764→                task,
   765→                context.ctx,
   766→                context.tasks,
   767→                context.items,
   768→                context.allMetaItems,
   769→                context.index,
   770→                context.options,
   771→              );
   772→            },
   773→            getUlid: (task: LoadedTask) => task._ulid,
   774→          });
   775→
   776→          formatBatchOutput(result, "Set");
   777→        } else {
   778→          // Single mode - existing behavior
   779→          if (!ref) {
   780→            error("Either provide a positional ref or use --refs flag");
   781→            process.exit(EXIT_CODES.USAGE_ERROR);
   782→          }
   783→
   784→          const foundTask = resolveTaskRef(ref, tasks, index);
   785→          const result = await setTaskFields(
   786→            foundTask,
   787→            ctx,
   788→            tasks,
   789→            items,
   790→            allMetaItems,
   791→            index,
   792→            options,
   793→          );
   794→
   795→          if (!result.success) {
   796→            error(result.error || "Failed to update task");
   797→            process.exit(EXIT_CODES.ERROR);
   798→          }
   799→
   800→          if (result.message) {
   801→            // AC: @spec-task-set-batch ac-4 - Warn on no changes
   802→            if (result.message.includes("No changes")) {
   803→              if (isJsonMode()) {
   804→                output({ success: true, message: result.message });
   805→              } else {
   806→                warn(result.message);
   807→              }
   808→            } else {
   809→              success(
   810→                result.message,
   811→                result.data as Record<string, unknown> | undefined,
   812→              );
   813→            }
   814→          }
   815→        }
   816→      } catch (err) {
   817→        error(errors.failures.updateTask, err);
   818→        process.exit(EXIT_CODES.ERROR);
   819→      }
   820→    });
   821→
   822→  // kspec task patch <ref>
   823→  task
   824→    .command("patch <ref>")
   825→    .description("Update task with JSON data")
   826→    .option("--data <json>", "JSON object with fields to update")
   827→    .option("--dry-run", "Show what would change without writing")
   828→    .option("--allow-unknown", "Allow unknown fields (for extending format)")
   829→    .action(async (ref: string, options) => {
   830→      try {
   831→        const ctx = await initContext();
   832→        const tasks = await loadAllTasks(ctx);
   833→        const items = await loadAllItems(ctx);
   834→
   835→        // Load meta items for validation
   836→        const { loadMetaContext } = await import("../../parser/meta.js");
   837→        const metaContext = await loadMetaContext(ctx);
   838→        const allMetaItems = [
   839→          ...metaContext.agents,
   840→          ...metaContext.workflows,
   841→          ...metaContext.conventions,
   842→          ...metaContext.observations,
   843→        ];
   844→
   845→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   846→        const foundTask = resolveTaskRef(ref, tasks, index);
   847→
   848→        // Get JSON data from --data flag or stdin
   849→        let jsonData: string;
   850→        if (options.data) {
   851→          jsonData = options.data;
   852→        } else {
   853→          // Read from stdin
   854→          const chunks: Buffer[] = [];
   855→          for await (const chunk of process.stdin) {
   856→            chunks.push(chunk);
   857→          }
   858→          jsonData = Buffer.concat(chunks).toString("utf-8");
   859→        }
   860→
   861→        // Parse JSON
   862→        let patchData: Record<string, unknown>;
   863→        try {
   864→          patchData = JSON.parse(jsonData);
   865→        } catch (parseErr) {
   866→          error(errors.validation.invalidJson, parseErr);
   867→          process.exit(EXIT_CODES.ERROR);
   868→        }
   869→
   870→        // Validate against TaskInputSchema (partial)
   871→        const { TaskInputSchema } = await import("../../schema/index.js");
   872→
   873→        // Create a partial schema for validation
   874→        const partialSchema = options.allowUnknown
   875→          ? TaskInputSchema.partial().passthrough()
   876→          : TaskInputSchema.partial().strict();
   877→
   878→        let validatedPatch: Partial<TaskInput>;
   879→        try {
   880→          validatedPatch = partialSchema.parse(patchData);
   881→        } catch (validationErr) {
   882→          error(
   883→            errors.validation.invalidPatchData(String(validationErr)),
   884→            validationErr,
   885→          );
   886→          process.exit(EXIT_CODES.ERROR);
   887→        }
   888→
   889→        // Check for unknown fields if strict mode
   890→        if (!options.allowUnknown) {
   891→          const knownFields = Object.keys(TaskInputSchema.shape);
   892→          const providedFields = Object.keys(patchData);
   893→          const unknownFields = providedFields.filter(
   894→            (f) => !knownFields.includes(f),
   895→          );
   896→
   897→          if (unknownFields.length > 0) {
   898→            error(errors.validation.unknownFields(unknownFields));
   899→            process.exit(EXIT_CODES.ERROR);
   900→          }
   901→        }
   902→
   903→        // Build updated task
   904→        const updatedTask: Task = { ...foundTask, ...validatedPatch };
   905→
   906→        // Track changes for output
   907→        const changes = Object.keys(validatedPatch);
   908→
   909→        if (options.dryRun) {
   910→          info("Dry run - no changes will be written");
   911→          info(`Would update: ${changes.join(", ")}`);
   912→          output({ changes, updated: updatedTask }, () => {
   913→            console.log(`\nChanges: ${changes.join(", ")}\n`);
   914→            return formatTaskDetails(updatedTask, index);
   915→          });
   916→          return;
   917→        }
   918→
   919→        await saveTask(ctx, updatedTask);
   920→        await commitIfShadow(
   921→          ctx.shadow,
   922→          "task-patch",
   923→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
   924→          changes.join(", "),
   925→        );
   926→        success(
   927→          `Patched task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(", ")})`,
   928→          { task: updatedTask },
   929→        );
   930→      } catch (err) {
   931→        error(errors.failures.patchTask, err);
   932→        process.exit(EXIT_CODES.ERROR);
   933→      }
   934→    });
   935→
   936→  // kspec task start <ref>
   937→  task
   938→    .command("start <ref>")
   939→    .description("Start working on a task (pending -> in_progress)")
   940→    .option("--no-sync", "Skip syncing spec implementation status")
   941→    .action(async (ref: string, options) => {
   942→      try {
   943→        const ctx = await initContext();
   944→        const tasks = await loadAllTasks(ctx);
   945→        const items = await loadAllItems(ctx);
   946→        const index = new ReferenceIndex(tasks, items);
   947→        const foundTask = resolveTaskRef(ref, tasks, index);
   948→
   949→        if (foundTask.status === "in_progress") {
   950→          warn("Task is already in progress");
   951→          output(foundTask, () => formatTaskDetails(foundTask));
   952→          return;
   953→        }
   954→
   955→        if (foundTask.status !== "pending") {
   956→          error(errors.status.cannotStart(foundTask.status));
   957→          process.exit(EXIT_CODES.VALIDATION_FAILED); // Exit code 4 = invalid state
   958→        }
   959→
   960→        // Update status
   961→        const updatedTask: Task = {
   962→          ...foundTask,
   963→          status: "in_progress",
   964→          started_at: new Date().toISOString(),
   965→        };
   966→
   967→        await saveTask(ctx, updatedTask);
   968→        await commitIfShadow(
   969→          ctx.shadow,
   970→          "task-start",
   971→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
   972→        );
   973→        success(`Started task: ${index.shortUlid(updatedTask._ulid)}`, {
   974→          task: updatedTask,
   975→        });
   976→
   977→        // Show spec context and AC guidance (suppressed in JSON mode)
   978→        if (!isJsonMode() && foundTask.spec_ref) {
   979→          const specResult = index.resolve(foundTask.spec_ref);
   980→          if (specResult.ok) {
   981→            const specItem = items.find((i) => i._ulid === specResult.ulid);
   982→            if (specItem) {
   983→              console.log("");
   984→              console.log("--- Spec Context ---");
   985→              console.log(`Implementing: ${specItem.title}`);
   986→              if (specItem.description) {
   987→                console.log(`\n${specItem.description}`);
   988→              }
   989→
   990→              if (
   991→                specItem.acceptance_criteria &&
   992→                specItem.acceptance_criteria.length > 0
   993→              ) {
   994→                console.log(
   995→                  `\nAcceptance Criteria (${specItem.acceptance_criteria.length}):`,
   996→                );
   997→                for (const ac of specItem.acceptance_criteria) {
   998→                  console.log(`  [${ac.id}]`);
   999→                  console.log(`    Given: ${ac.given}`);
  1000→                  console.log(`    When: ${ac.when}`);
  1001→                  console.log(`    Then: ${ac.then}`);
  1002→                }
  1003→                console.log("");
  1004→                console.log(
  1005→                  "Remember: Add test coverage for each AC and mark tests with // AC: @spec-ref ac-N",
  1006→                );
  1007→              }
  1008→              console.log("");
  1009→            }
  1010→          }
  1011→        }
  1012→
  1013→        // Sync spec implementation status (unless --no-sync)
  1014→        if (options.sync !== false && foundTask.spec_ref) {
  1015→          const updatedTasks = tasks.map((t) =>
  1016→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t,
  1017→          );
  1018→          const syncResult = await syncSpecImplementationStatus(
  1019→            ctx,
  1020→            updatedTask as LoadedTask,
  1021→            updatedTasks as LoadedTask[],
  1022→            items,
  1023→            index,
  1024→          );
  1025→          if (syncResult) {
  1026→            info(
  1027→              `Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1028→            );
  1029→            // Commit the spec status change
  1030→            await commitIfShadow(
  1031→              ctx.shadow,
  1032→              "spec-sync",
  1033→              syncResult.specUlid.slice(0, 8),
  1034→              `${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1035→            );
  1036→          }
  1037→        }
  1038→      } catch (err) {
  1039→        error(errors.failures.startTask, err);
  1040→        process.exit(EXIT_CODES.ERROR);
  1041→      }
  1042→    });
  1043→
  1044→  // kspec task complete <ref> | --refs <refs...>
  1045→  // AC: @multi-ref-batch ac-1 - Basic multi-ref syntax
  1046→  // AC: @multi-ref-batch ac-2 - Backward compatibility
  1047→  task
  1048→    .command("complete [ref]")
  1049→    .description("Complete a task (pending_review -> completed)")
  1050→    .option("--refs <refs...>", "Complete multiple tasks by ref")
  1051→    .option("--reason <reason>", "Completion reason/notes")
  1052→    .option("--skip-review", "Skip review requirement (requires --reason)")
  1053→    .option("--no-sync", "Skip syncing spec implementation status")
  1054→    .action(async (ref: string | undefined, options) => {
  1055→      try {
  1056→        const ctx = await initContext();
  1057→        const tasks = await loadAllTasks(ctx);
  1058→        const items = await loadAllItems(ctx);
  1059→        const index = new ReferenceIndex(tasks, items);
  1060→
  1061→        // AC: @spec-completion-enforcement ac-8
  1062→        if (options.skipReview && !options.reason) {
  1063→          error(errors.status.skipReviewRequiresReason);
  1064→          process.exit(EXIT_CODES.ERROR);
  1065→        }
  1066→
  1067→        // AC: @multi-ref-batch ac-1, ac-2, ac-3, ac-4
  1068→        const result = await executeBatchOperation({
  1069→          positionalRef: ref,
  1070→          refsFlag: options.refs,
  1071→          context: { ctx, tasks, items, index, options },
  1072→          items: tasks,
  1073→          index,
  1074→          resolveRef: (refStr, taskList, idx) => {
  1075→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1076→            return { item: resolved.task, error: resolved.error };
  1077→          },
  1078→          executeOperation: async (
  1079→            foundTask,
  1080→            { ctx, tasks, items, index, options },
  1081→          ) => {
  1082→            try {
  1083→              // AC: @spec-completion-enforcement ac-6
  1084→              if (foundTask.status === "completed") {
  1085→                return {
  1086→                  success: false,
  1087→                  error: errors.status.completeAlreadyCompleted,
  1088→                };
  1089→              }
  1090→
  1091→              // AC: @spec-completion-enforcement ac-7 - Allow skip-review bypass
  1092→              if (!options.skipReview) {
  1093→                // AC: @spec-completion-enforcement ac-2
  1094→                if (foundTask.status === "in_progress") {
  1095→                  return {
  1096→                    success: false,
  1097→                    error: errors.status.completeRequiresReview,
  1098→                  };
  1099→                }
  1100→
  1101→                // AC: @spec-completion-enforcement ac-3
  1102→                if (foundTask.status === "pending") {
  1103→                  return {
  1104→                    success: false,
  1105→                    error: errors.status.completeRequiresStart,
  1106→                  };
  1107→                }
  1108→
  1109→                // AC: @spec-completion-enforcement ac-4
  1110→                if (foundTask.status === "blocked") {
  1111→                  return {
  1112→                    success: false,
  1113→                    error: errors.status.completeBlockedTask,
  1114→                  };
  1115→                }
  1116→
  1117→                // AC: @spec-completion-enforcement ac-5
  1118→                if (foundTask.status === "cancelled") {
  1119→                  return {
  1120→                    success: false,
  1121→                    error: errors.status.completeCancelledTask,
  1122→                  };
  1123→                }
  1124→
  1125→                // AC: @spec-completion-enforcement ac-1 - Only pending_review allowed
  1126→                if (foundTask.status !== "pending_review") {
  1127→                  return {
  1128→                    success: false,
  1129→                    error: errors.status.cannotComplete(foundTask.status),
  1130→                  };
  1131→                }
  1132→              }
  1133→
  1134→              const now = new Date().toISOString();
  1135→
  1136→              // AC: @spec-completion-enforcement ac-7 - Document skip-review reason
  1137→              // AC: @spec-completion-enforcement ac-author
  1138→              let taskNotes = foundTask.notes;
  1139→              if (options.skipReview && options.reason) {
  1140→                const skipNote = createNote(
  1141→                  `Completed with --skip-review: ${options.reason}`,
  1142→                  getAuthor(),
  1143→                );
  1144→                taskNotes = [...taskNotes, skipNote];
  1145→              }
  1146→
  1147→              // Update status
  1148→              const updatedTask: Task = {
  1149→                ...foundTask,
  1150→                status: "completed",
  1151→                completed_at: now,
  1152→                closed_reason: options.reason || null,
  1153→                started_at: foundTask.started_at || now,
  1154→                notes: taskNotes,
  1155→              };
  1156→
  1157→              await saveTask(ctx, updatedTask);
  1158→              await commitIfShadow(
  1159→                ctx.shadow,
  1160→                "task-complete",
  1161→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1162→                options.reason,
  1163→              );
  1164→
  1165→              // Sync spec implementation status (unless --no-sync)
  1166→              if (options.sync !== false && foundTask.spec_ref) {
  1167→                const updatedTasks = tasks.map((t) =>
  1168→                  t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t,
  1169→                );
  1170→                const syncResult = await syncSpecImplementationStatus(
  1171→                  ctx,
  1172→                  updatedTask as LoadedTask,
  1173→                  updatedTasks as LoadedTask[],
  1174→                  items,
  1175→                  index,
  1176→                );
  1177→                if (syncResult && !isJsonMode()) {
  1178→                  info(
  1179→                    `Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1180→                  );
  1181→                  await commitIfShadow(
  1182→                    ctx.shadow,
  1183→                    "spec-sync",
  1184→                    syncResult.specUlid.slice(0, 8),
  1185→                    `${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1186→                  );
  1187→                }
  1188→              }
  1189→
  1190→              // Show AC reminder for single-ref mode only (not in batch)
  1191→              if (!options.refs && foundTask.spec_ref && !isJsonMode()) {
  1192→                const specResult = index.resolve(foundTask.spec_ref);
  1193→                if (specResult.ok && specResult.item) {
  1194→                  const specItem = items.find(
  1195→                    (i) => i._ulid === specResult.ulid,
  1196→                  );
  1197→                  if (
  1198→                    specItem?.acceptance_criteria &&
  1199→                    specItem.acceptance_criteria.length > 0
  1200→                  ) {
  1201→                    const count = specItem.acceptance_criteria.length;
  1202→                    console.log(
  1203→                      `\n⚠ Linked spec ${foundTask.spec_ref} has ${count} acceptance criteri${count === 1 ? "on" : "a"} - verify they are covered\n`,
  1204→                    );
  1205→                  }
  1206→                }
  1207→              }
  1208→
  1209→              return {
  1210→                success: true,
  1211→                message: `Completed task: ${index.shortUlid(updatedTask._ulid)}`,
  1212→                data: updatedTask,
  1213→              };
  1214→            } catch (err) {
  1215→              return {
  1216→                success: false,
  1217→                error: err instanceof Error ? err.message : String(err),
  1218→              };
  1219→            }
  1220→          },
  1221→          getUlid: (task) => task._ulid,
  1222→        });
  1223→
  1224→        // AC: @multi-ref-batch ac-5, ac-6
  1225→        formatBatchOutput(result, "Complete");
  1226→
  1227→        // Show commit guidance for single-ref mode only
  1228→        if (
  1229→          !options.refs &&
  1230→          result.success &&
  1231→          result.results.length === 1 &&
  1232→          !isJsonMode()
  1233→        ) {
  1234→          const taskData = result.results[0].data as Task | undefined;
  1235→          if (taskData) {
  1236→            const guidance = formatCommitGuidance(taskData);
  1237→            printCommitGuidance(guidance);
  1238→          }
  1239→        }
  1240→      } catch (err) {
  1241→        error(errors.failures.completeTask, err);
  1242→        process.exit(EXIT_CODES.ERROR);
  1243→      }
  1244→    });
  1245→
  1246→  // kspec task submit <ref>
  1247→  // Transitions in_progress → pending_review (code done, awaiting merge)
  1248→  task
  1249→    .command("submit <ref>")
  1250→    .description("Submit task for review (transitions to pending_review)")
  1251→    .action(async (ref: string) => {
  1252→      try {
  1253→        const ctx = await initContext();
  1254→        const tasks = await loadAllTasks(ctx);
  1255→        const items = await loadAllItems(ctx);
  1256→        const index = new ReferenceIndex(tasks, items);
  1257→        const foundTask = resolveTaskRef(ref, tasks, index);
  1258→
  1259→        if (foundTask.status !== "in_progress") {
  1260→          error(
  1261→            `Cannot submit task with status: ${foundTask.status}. Task must be in_progress.`,
  1262→          );
  1263→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1264→        }
  1265→
  1266→        const updatedTask: Task = {
  1267→          ...foundTask,
  1268→          status: "pending_review",
  1269→        };
  1270→
  1271→        await saveTask(ctx, updatedTask);
  1272→        await commitIfShadow(
  1273→          ctx.shadow,
  1274→          "task-submit",
  1275→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1276→        );
  1277→        success(
  1278→          `Submitted task for review: ${index.shortUlid(updatedTask._ulid)}`,
  1279→          { task: updatedTask },
  1280→        );
  1281→      } catch (err) {
  1282→        error(errors.failures.updateTask, err);
  1283→        process.exit(EXIT_CODES.ERROR);
  1284→      }
  1285→    });
  1286→
  1287→  // kspec task block <ref>
  1288→  task
  1289→    .command("block <ref>")
  1290→    .description("Block a task")
  1291→    .requiredOption("--reason <reason>", "Reason for blocking")
  1292→    .action(async (ref: string, options) => {
  1293→      try {
  1294→        const ctx = await initContext();
  1295→        const tasks = await loadAllTasks(ctx);
  1296→        const items = await loadAllItems(ctx);
  1297→        const index = new ReferenceIndex(tasks, items);
  1298→        const foundTask = resolveTaskRef(ref, tasks, index);
  1299→
  1300→        if (
  1301→          foundTask.status === "completed" ||
  1302→          foundTask.status === "cancelled"
  1303→        ) {
  1304→          error(errors.status.cannotBlock(foundTask.status));
  1305→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1306→        }
  1307→
  1308→        const updatedTask: Task = {
  1309→          ...foundTask,
