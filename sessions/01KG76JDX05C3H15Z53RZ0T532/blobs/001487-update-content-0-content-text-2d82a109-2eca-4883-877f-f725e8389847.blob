  1727→
  1728→  // kspec task review <ref>
  1729→  task
  1730→    .command("review <ref>")
  1731→    .description(
  1732→      "Get task context for review (task details, spec, ACs, git diff)",
  1733→    )
  1734→    .action(async (ref: string) => {
  1735→      try {
  1736→        const ctx = await initContext();
  1737→        const tasks = await loadAllTasks(ctx);
  1738→        const items = await loadAllItems(ctx);
  1739→        const index = new ReferenceIndex(tasks, items);
  1740→        const foundTask = resolveTaskRef(ref, tasks, index);
  1741→
  1742→        // Import getDiffSince from utils
  1743→        const { getDiffSince } = await import("../../utils/index.js");
  1744→
  1745→        // Gather review context
  1746→        const reviewContext: {
  1747→          task: typeof foundTask;
  1748→          spec: LoadedSpecItem | null;
  1749→          diff: string | null;
  1750→          started_at: string | null;
  1751→          testCoverage?: { covered: string[]; uncovered: string[] };
  1752→        } = {
  1753→          task: foundTask,
  1754→          spec: null,
  1755→          diff: null,
  1756→          started_at: foundTask.started_at || null,
  1757→        };
  1758→
  1759→        // Get spec item if task has spec_ref
  1760→        if (foundTask.spec_ref) {
  1761→          const specResult = index.resolve(foundTask.spec_ref);
  1762→          if (specResult.ok) {
  1763→            const specItem = items.find((i) => i._ulid === specResult.ulid);
  1764→            reviewContext.spec = specItem || null;
  1765→
  1766→            // Check test coverage for ACs if spec has them
  1767→            if (
  1768→              specItem?.acceptance_criteria &&
  1769→              specItem.acceptance_criteria.length > 0
  1770→            ) {
  1771→              const coveredACs = await scanTestCoverage(ctx.rootDir);
  1772→              const covered: string[] = [];
  1773→              const uncovered: string[] = [];
  1774→
  1775→              for (const ac of specItem.acceptance_criteria) {
  1776→                // Build possible references
  1777→                const possibleRefs: string[] = [];
  1778→                if (specItem.slugs && specItem.slugs.length > 0) {
  1779→                  possibleRefs.push(`@${specItem.slugs[0]} ${ac.id}`);
  1780→                  possibleRefs.push(`@${specItem.slugs[0]}`);
  1781→                }
  1782→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)} ${ac.id}`);
  1783→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)}`);
  1784→
  1785→                const isCovered = possibleRefs.some((ref) =>
  1786→                  coveredACs.has(ref),
  1787→                );
  1788→                if (isCovered) {
  1789→                  covered.push(ac.id);
  1790→                } else {
  1791→                  uncovered.push(ac.id);
  1792→                }
  1793→              }
  1794→
  1795→              reviewContext.testCoverage = { covered, uncovered };
  1796→            }
  1797→          }
  1798→        }
  1799→
  1800→        // Get git diff since task started
  1801→        if (foundTask.started_at) {
  1802→          const startedDate = new Date(foundTask.started_at);
  1803→          reviewContext.diff = getDiffSince(startedDate, ctx.rootDir);
  1804→        }
  1805→
  1806→        output(reviewContext, () => {
  1807→          console.log("=".repeat(60));
  1808→          console.log("Task Review Context");
  1809→          console.log("=".repeat(60));
  1810→          console.log();
  1811→
  1812→          // Task details
  1813→          console.log("TASK DETAILS");
  1814→          console.log("-".repeat(60));
  1815→          console.log(formatTaskDetails(foundTask, index));
  1816→          console.log();
  1817→
  1818→          // Spec details
  1819→          if (reviewContext.spec) {
  1820→            console.log("LINKED SPEC");
  1821→            console.log("-".repeat(60));
  1822→            console.log(`Title: ${reviewContext.spec.title}`);
  1823→            console.log(`Type: ${reviewContext.spec.type}`);
  1824→            if (reviewContext.spec.description) {
  1825→              console.log(`\nDescription:\n${reviewContext.spec.description}`);
  1826→            }
  1827→            if (
  1828→              reviewContext.spec.acceptance_criteria &&
  1829→              reviewContext.spec.acceptance_criteria.length > 0
  1830→            ) {
  1831→              console.log(
  1832→                `\nAcceptance Criteria (${reviewContext.spec.acceptance_criteria.length}):`,
  1833→              );
  1834→              for (const ac of reviewContext.spec.acceptance_criteria) {
  1835→                const isCovered = reviewContext.testCoverage?.covered.includes(
  1836→                  ac.id,
  1837→                );
  1838→                const coverageMarker = isCovered
  1839→                  ? chalk.green("✓")
  1840→                  : chalk.yellow("○");
  1841→                console.log(`  ${coverageMarker} [${ac.id}]`);
  1842→                console.log(`    Given: ${ac.given}`);
  1843→                console.log(`    When: ${ac.when}`);
  1844→                console.log(`    Then: ${ac.then}`);
  1845→              }
  1846→
  1847→              // Test coverage summary
  1848→              if (reviewContext.testCoverage) {
  1849→                const { covered, uncovered } = reviewContext.testCoverage;
  1850→                console.log();
  1851→                if (uncovered.length === 0) {
  1852→                  console.log(
  1853→                    chalk.green(
  1854→                      `  ✓ All ${covered.length} AC(s) have test coverage`,
  1855→                    ),
  1856→                  );
  1857→                } else {
  1858→                  console.log(
  1859→                    chalk.yellow(
  1860→                      `  Test coverage: ${covered.length}/${covered.length + uncovered.length} ACs covered`,
  1861→                    ),
  1862→                  );
  1863→                  console.log(
  1864→                    chalk.yellow(
  1865→                      `  Missing coverage for: ${uncovered.join(", ")}`,
  1866→                    ),
  1867→                  );
  1868→                }
  1869→              }
  1870→            }
  1871→            console.log();
  1872→          }
  1873→
  1874→          // Git diff
  1875→          if (reviewContext.diff) {
  1876→            console.log("CHANGES SINCE TASK STARTED");
  1877→            console.log("-".repeat(60));
  1878→            console.log(`Started at: ${foundTask.started_at}`);
  1879→            console.log();
  1880→            console.log(reviewContext.diff);
  1881→            console.log();
  1882→          } else if (foundTask.started_at) {
  1883→            console.log("CHANGES SINCE TASK STARTED");
  1884→            console.log("-".repeat(60));
  1885→            console.log(`Started at: ${foundTask.started_at}`);
  1886→            console.log("No changes detected");
  1887→            console.log();
  1888→          }
  1889→
  1890→          console.log("=".repeat(60));
  1891→          console.log("Review Checklist:");
  1892→          console.log("- Does the implementation match the task description?");
  1893→          if (reviewContext.spec) {
  1894→            console.log("- Are all acceptance criteria covered?");
  1895→            console.log("- Is test coverage adequate?");
  1896→          }
  1897→          console.log("- Are there any gaps or issues?");
  1898→          console.log("=".repeat(60));
  1899→        });
  1900→      } catch (err) {
  1901→        error("Failed to generate review context", err);
  1902→        process.exit(EXIT_CODES.ERROR);
  1903→      }
  1904→    });
  1905→
  1906→  // kspec task todos <ref>
  1907→  task
  1908→    .command("todos <ref>")
  1909→    .description("Show todos for a task")
  1910→    .action(async (ref: string) => {
  1911→      try {
  1912→        const ctx = await initContext();
  1913→        const tasks = await loadAllTasks(ctx);
  1914→        const items = await loadAllItems(ctx);
  1915→        const index = new ReferenceIndex(tasks, items);
  1916→        const foundTask = resolveTaskRef(ref, tasks, index);
  1917→
  1918→        output(foundTask.todos, () => {
  1919→          if (foundTask.todos.length === 0) {
  1920→            console.log("No todos");
  1921→          } else {
  1922→            for (const todo of foundTask.todos) {
  1923→              const status = todo.done ? "[x]" : "[ ]";
  1924→              const doneInfo =
  1925→                todo.done && todo.done_at ? ` (done ${todo.done_at})` : "";
  1926→              console.log(`${status} ${todo.id}. ${todo.text}${doneInfo}`);
  1927→            }
  1928→          }
  1929→        });
  1930→      } catch (err) {
  1931→        error(errors.failures.getTodos, err);
  1932→        process.exit(EXIT_CODES.ERROR);
  1933→      }
  1934→    });
  1935→
  1936→  // Create subcommand group for todo operations
  1937→  const todoCmd = task.command("todo").description("Manage task todos");
  1938→
  1939→  // kspec task todo add <ref> <text>
  1940→  todoCmd
  1941→    .command("add <ref> <text>")
  1942→    .description("Add a todo to a task")
  1943→    .option("--author <author>", "Todo author")
  1944→    .action(async (ref: string, text: string, options) => {
  1945→      try {
  1946→        const ctx = await initContext();
  1947→        const tasks = await loadAllTasks(ctx);
  1948→        const items = await loadAllItems(ctx);
  1949→        const index = new ReferenceIndex(tasks, items);
  1950→        const foundTask = resolveTaskRef(ref, tasks, index);
  1951→
  1952→        // Calculate next ID (max existing + 1, or 1 if none)
  1953→        const nextId =
  1954→          foundTask.todos.length > 0
  1955→            ? Math.max(...foundTask.todos.map((t) => t.id)) + 1
  1956→            : 1;
  1957→
  1958→        const todo = createTodo(nextId, text, options.author);
  1959→
  1960→        const updatedTask: Task = {
  1961→          ...foundTask,
  1962→          todos: [...foundTask.todos, todo],
  1963→        };
  1964→
  1965→        await saveTask(ctx, updatedTask);
  1966→        await commitIfShadow(
  1967→          ctx.shadow,
  1968→          "task-note",
  1969→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1970→        );
  1971→        success(
  1972→          `Added todo #${todo.id} to task: ${index.shortUlid(updatedTask._ulid)}`,
  1973→          { todo },
  1974→        );
  1975→      } catch (err) {
  1976→        error(errors.failures.addTodo, err);
  1977→        process.exit(EXIT_CODES.ERROR);
  1978→      }
  1979→    });
  1980→
  1981→  // kspec task todo done <ref> <id>
  1982→  todoCmd
  1983→    .command("done <ref> <id>")
  1984→    .description("Mark a todo as done")
  1985→    .action(async (ref: string, idStr: string) => {
  1986→      try {
  1987→        const ctx = await initContext();
  1988→        const tasks = await loadAllTasks(ctx);
  1989→        const items = await loadAllItems(ctx);
  1990→        const index = new ReferenceIndex(tasks, items);
  1991→        const foundTask = resolveTaskRef(ref, tasks, index);
  1992→
  1993→        const id = parseInt(idStr, 10);
  1994→        if (Number.isNaN(id)) {
  1995→          error(errors.todo.invalidId(idStr));
  1996→          process.exit(EXIT_CODES.USAGE_ERROR);
  1997→        }
  1998→
  1999→        const todoIndex = foundTask.todos.findIndex((t) => t.id === id);
  2000→        if (todoIndex === -1) {
  2001→          error(errors.todo.notFound(id));
  2002→          process.exit(EXIT_CODES.NOT_FOUND);
  2003→        }
  2004→
  2005→        if (foundTask.todos[todoIndex].done) {
  2006→          warn(`Todo #${id} is already done`);
  2007→          return;
  2008→        }
  2009→
  2010→        const updatedTodos = [...foundTask.todos];
  2011→        updatedTodos[todoIndex] = {
  2012→          ...updatedTodos[todoIndex],
  2013→          done: true,
  2014→          done_at: new Date().toISOString(),
  2015→        };
  2016→
  2017→        const updatedTask: Task = {
  2018→          ...foundTask,
  2019→          todos: updatedTodos,
  2020→        };
  2021→
  2022→        await saveTask(ctx, updatedTask);
  2023→        await commitIfShadow(
  2024→          ctx.shadow,
  2025→          "task-note",
  2026→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2027→        );
  2028→        success(`Marked todo #${id} as done`, {
  2029→          todo: updatedTodos[todoIndex],
  2030→        });
  2031→      } catch (err) {
  2032→        error(errors.failures.markTodoDone, err);
  2033→        process.exit(EXIT_CODES.ERROR);
  2034→      }
  2035→    });
  2036→
  2037→  // kspec task todo undone <ref> <id>
  2038→  todoCmd
  2039→    .command("undone <ref> <id>")
  2040→    .description("Mark a todo as not done")
  2041→    .action(async (ref: string, idStr: string) => {
  2042→      try {
  2043→        const ctx = await initContext();
  2044→        const tasks = await loadAllTasks(ctx);
  2045→        const items = await loadAllItems(ctx);
  2046→        const index = new ReferenceIndex(tasks, items);
  2047→        const foundTask = resolveTaskRef(ref, tasks, index);
  2048→
  2049→        const id = parseInt(idStr, 10);
  2050→        if (Number.isNaN(id)) {
  2051→          error(errors.todo.invalidId(idStr));
  2052→          process.exit(EXIT_CODES.USAGE_ERROR);
  2053→        }
  2054→
  2055→        const todoIndex = foundTask.todos.findIndex((t) => t.id === id);
  2056→        if (todoIndex === -1) {
  2057→          error(errors.todo.notFound(id));
  2058→          process.exit(EXIT_CODES.NOT_FOUND);
  2059→        }
  2060→
  2061→        if (!foundTask.todos[todoIndex].done) {
  2062→          warn(`Todo #${id} is not done`);
  2063→          return;
  2064→        }
  2065→
  2066→        const updatedTodos = [...foundTask.todos];
  2067→        updatedTodos[todoIndex] = {
  2068→          ...updatedTodos[todoIndex],
  2069→          done: false,
  2070→          done_at: undefined,
  2071→        };
  2072→
  2073→        const updatedTask: Task = {
  2074→          ...foundTask,
  2075→          todos: updatedTodos,
  2076→        };
  2077→
  2078→        await saveTask(ctx, updatedTask);
  2079→        await commitIfShadow(
  2080→          ctx.shadow,
  2081→          "task-note",
  2082→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2083→        );
  2084→        success(`Marked todo #${id} as not done`, {
  2085→          todo: updatedTodos[todoIndex],
  2086→        });
  2087→      } catch (err) {
  2088→        error(errors.failures.markTodoNotDone, err);
  2089→        process.exit(EXIT_CODES.ERROR);
  2090→      }
  2091→    });
  2092→}
