  1681→              specItem.acceptance_criteria.length > 0
  1682→            ) {
  1683→              console.log("");
  1684→              console.log(
  1685→                alignmentCheck.testCoverage(
  1686→                  specItem.acceptance_criteria.length,
  1687→                ),
  1688→              );
  1689→            }
  1690→          }
  1691→        }
  1692→      } catch (err) {
  1693→        error(errors.failures.addNote, err);
  1694→        process.exit(EXIT_CODES.ERROR);
  1695→      }
  1696→    });
  1697→
  1698→  // kspec task notes <ref>
  1699→  task
  1700→    .command("notes <ref>")
  1701→    .description("Show notes for a task")
  1702→    .action(async (ref: string) => {
  1703→      try {
