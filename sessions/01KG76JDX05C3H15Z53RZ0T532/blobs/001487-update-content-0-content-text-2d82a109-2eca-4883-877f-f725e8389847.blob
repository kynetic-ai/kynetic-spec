  1312→        };
  1313→
  1314→        await saveTask(ctx, updatedTask);
  1315→        await commitIfShadow(
  1316→          ctx.shadow,
  1317→          "task-block",
  1318→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1319→        );
  1320→        success(`Blocked task: ${index.shortUlid(updatedTask._ulid)}`, {
  1321→          task: updatedTask,
  1322→        });
  1323→      } catch (err) {
  1324→        error(errors.failures.blockTask, err);
  1325→        process.exit(EXIT_CODES.ERROR);
  1326→      }
  1327→    });
  1328→
  1329→  // kspec task unblock <ref>
  1330→  task
  1331→    .command("unblock <ref>")
