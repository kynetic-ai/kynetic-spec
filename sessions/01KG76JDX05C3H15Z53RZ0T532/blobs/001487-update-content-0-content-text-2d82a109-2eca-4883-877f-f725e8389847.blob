```
     1→import * as path from "node:path";
     2→import chalk from "chalk";
     3→import type { Command } from "commander";
     4→import {
     5→  checkSlugUniqueness,
     6→  createNote,
     7→  createTask,
     8→  createTodo,
     9→  deleteTask,
    10→  getAuthor,
    11→  initContext,
    12→  type LoadedSpecItem,
    13→  type LoadedTask,
    14→  loadAllItems,
    15→  loadAllTasks,
    16→  ReferenceIndex,
    17→  saveTask,
    18→  scanTestCoverage,
    19→  syncSpecImplementationStatus,
    20→} from "../../parser/index.js";
    21→import { commitIfShadow } from "../../parser/shadow.js";
    22→import type { Task, TaskInput } from "../../schema/index.js";
    23→import { alignmentCheck, errors } from "../../strings/index.js";
    24→import {
    25→  formatCommitGuidance,
    26→  printCommitGuidance,
    27→} from "../../utils/commit.js";
    28→import { executeBatchOperation, formatBatchOutput } from "../batch.js";
    29→import { EXIT_CODES } from "../exit-codes.js";
    30→import {
    31→  error,
    32→  formatTaskDetails,
    33→  formatTaskList,
    34→  info,
    35→  isJsonMode,
    36→  output,
    37→  success,
    38→  warn,
    39→} from "../output.js";
