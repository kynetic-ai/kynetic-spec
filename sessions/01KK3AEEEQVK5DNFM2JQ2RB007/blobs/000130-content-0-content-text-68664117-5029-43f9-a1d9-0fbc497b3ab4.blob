   425→        then: receives connected event with {session_id}
   426→      - id: ac-26
   427→        given: WebSocket connection active
   428→        when: client sends command
   429→        then: command format is {action, request_id?, payload}
   430→      - id: ac-27
   431→        given: command received
   432→        when: processed
   433→        then: "server sends {ack: true, request_id, success, error?}"
   434→      - id: ac-28
   435→        given: WebSocket connection
   436→        when: "client sends {action: 'subscribe', topics: ['files:updates']}"
   437→        then: server tracks subscription and sends events for that topic
   438→      - id: ac-29
   439→        given: file changes in .kspec/
   440→        when: WebSocket client subscribed to files:updates
   441→        then: "receives event with format {msg_id, seq, timestamp, topic, event, data: {ref, action}}"
   442→      - id: ac-30
   443→        given: malformed command received
   444→        when: parsed
   445→        then: "return {ack: false, error: 'validation_error', details: ...}"
   446→      - id: ac-31
   447→        given: connection closing
   448→        when: close initiated
   449→        then: use code 1000 for clean, 1001 for timeout, 1011 for error
   450→      - id: ac-32
   451→        given: server sends to slow client
   452→        when: backpressure limit reached
   453→        then: pause non-critical broadcasts until drain event
   454→      - id: ac-33
   455→        given: daemon is shutting down
   456→        when: WebSocket connection active
   457→        then: receives shutdown event with {reason}, connection closes gracefully
