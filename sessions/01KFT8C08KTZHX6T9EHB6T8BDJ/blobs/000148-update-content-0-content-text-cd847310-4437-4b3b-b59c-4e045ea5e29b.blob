     1→/**
     2→ * Tests for Global PID/Port Management
     3→ *
     4→ * Tests the new multi-directory daemon architecture where PID and port files
     5→ * are stored globally at ~/.config/kspec/ instead of per-project .kspec/.
     6→ *
     7→ * AC: @multi-directory-daemon ac-9, ac-9b, ac-9c, ac-10, ac-10b, ac-11, ac-13
     8→ */
     9→
    10→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
    11→import { createTempDir, cleanupTempDir } from './helpers/cli';
    12→import { writeFileSync, readFileSync, existsSync, mkdirSync, statSync, unlinkSync } from 'fs';
    13→import { join } from 'path';
    14→import { homedir } from 'os';
    15→
    16→// Mock PidFileManager for global paths
    17→class GlobalPidFileManager {
    18→  private configDir: string;
    19→  private pidFilePath: string;
    20→  private portFilePath: string;
    21→
    22→  constructor(configDir: string = join(homedir(), '.config', 'kspec')) {
    23→    this.configDir = configDir;
    24→    this.pidFilePath = join(configDir, 'daemon.pid');
    25→    this.portFilePath = join(configDir, 'daemon.port');
    26→  }
    27→
    28→  // AC: @multi-directory-daemon ac-9b
    29→  private ensureConfigDir(): void {
    30→    if (!existsSync(this.configDir)) {
    31→      mkdirSync(this.configDir, { recursive: true, mode: 0o755 });
    32→    }
    33→  }
    34→
    35→  // AC: @multi-directory-daemon ac-9
    36→  writePid(): void {
    37→    this.ensureConfigDir();
    38→    writeFileSync(this.pidFilePath, process.pid.toString(), 'utf-8');
    39→  }
    40→
    41→  // AC: @multi-directory-daemon ac-9
    42→  writePort(port: number): void {
    43→    this.ensureConfigDir();
    44→    writeFileSync(this.portFilePath, port.toString(), 'utf-8');
    45→  }
    46→
    47→  readPid(): number | null {
    48→    if (!existsSync(this.pidFilePath)) {
    49→      return null;
    50→    }
    51→
    52→    try {
    53→      const content = readFileSync(this.pidFilePath, 'utf-8').trim();
    54→      const pid = parseInt(content, 10);
    55→      return isNaN(pid) ? null : pid;
    56→    } catch {
    57→      return null;
    58→    }
    59→  }
    60→
    61→  // AC: @multi-directory-daemon ac-9c, ac-13
    62→  readPort(): number {
    63→    if (!existsSync(this.portFilePath)) {
    64→      throw new Error('Invalid daemon port file');
    65→    }
    66→
    67→    try {
    68→      const content = readFileSync(this.portFilePath, 'utf-8').trim();
    69→      const port = parseInt(content, 10);
    70→
    71→      // AC: @multi-directory-daemon ac-9c - validate port content
    72→      if (isNaN(port) || port < 1 || port > 65535) {
    73→        throw new Error('Invalid daemon port file');
    74→      }
    75→
    76→      return port;
    77→    } catch (err) {
    78→      throw new Error('Invalid daemon port file');
    79→    }
    80→  }
    81→
    82→  // AC: @multi-directory-daemon ac-11
    83→  remove(): void {
    84→    if (existsSync(this.pidFilePath)) {
    85→      unlinkSync(this.pidFilePath);
    86→    }
    87→    if (existsSync(this.portFilePath)) {
    88→      unlinkSync(this.portFilePath);
    89→    }
    90→  }
    91→
    92→  isProcessRunning(pid: number): boolean {
    93→    try {
    94→      process.kill(pid, 0);
    95→      return true;
    96→    } catch {
    97→      return false;
    98→    }
    99→  }
   100→
   101→  // AC: @multi-directory-daemon ac-10
   102→  isDaemonRunning(): boolean {
   103→    const pid = this.readPid();
   104→    if (pid === null) {
   105→      return false;
   106→    }
   107→    return this.isProcessRunning(pid);
   108→  }
   109→}
   110→
   111→describe('Global PID/Port Management', () => {
   112→  let tempConfigDir: string;
   113→  let pidManager: GlobalPidFileManager;
   114→
   115→  beforeEach(async () => {
   116→    // Use temp dir instead of actual ~/.config/kspec for testing
   117→    tempConfigDir = await createTempDir();
   118→    pidManager = new GlobalPidFileManager(tempConfigDir);
   119→  });
   120→
   121→  afterEach(async () => {
   122→    await cleanupTempDir(tempConfigDir);
   123→  });
   124→
   125→  describe('PID file management', () => {
   126→    // AC: @multi-directory-daemon ac-9
   127→    it('should write PID to global location', () => {
   128→      pidManager.writePid();
   129→
   130→      const pidFilePath = join(tempConfigDir, 'daemon.pid');
   131→      expect(existsSync(pidFilePath)).toBe(true);
   132→
   133→      const content = readFileSync(pidFilePath, 'utf-8').trim();
   134→      expect(content).toBe(process.pid.toString());
   135→    });
   136→
   137→    // AC: @multi-directory-daemon ac-9
   138→    it('should read PID from global location', () => {
   139→      pidManager.writePid();
   140→      const pid = pidManager.readPid();
   141→
   142→      expect(pid).toBe(process.pid);
   143→    });
   144→
   145→    // AC: @multi-directory-daemon ac-9
   146→    it('should return null when PID file does not exist', () => {
   147→      const pid = pidManager.readPid();
   148→      expect(pid).toBeNull();
   149→    });
   150→
   151→    // AC: @multi-directory-daemon ac-9
   152→    it('should return null when PID file contains invalid content', () => {
   153→      const pidFilePath = join(tempConfigDir, 'daemon.pid');
   154→      mkdirSync(tempConfigDir, { recursive: true });
   155→      writeFileSync(pidFilePath, 'not-a-number', 'utf-8');
   156→
   157→      const pid = pidManager.readPid();
   158→      expect(pid).toBeNull();
   159→    });
   160→  });
   161→
   162→  describe('Port file management', () => {
   163→    // AC: @multi-directory-daemon ac-9
   164→    it('should write port to global location', () => {
   165→      const port = 3456;
   166→      pidManager.writePort(port);
   167→
   168→      const portFilePath = join(tempConfigDir, 'daemon.port');
   169→      expect(existsSync(portFilePath)).toBe(true);
   170→
   171→      const content = readFileSync(portFilePath, 'utf-8').trim();
   172→      expect(content).toBe(port.toString());
   173→    });
   174→
   175→    // AC: @multi-directory-daemon ac-13
   176→    it('should read port from global location', () => {
   177→      const port = 3456;
   178→      pidManager.writePort(port);
   179→
   180→      const readPort = pidManager.readPort();
   181→      expect(readPort).toBe(port);
   182→    });
   183→
   184→    // AC: @multi-directory-daemon ac-13
   185→    it('should throw error when port file does not exist', () => {
   186→      expect(() => pidManager.readPort()).toThrow('Invalid daemon port file');
   187→    });
   188→
   189→    // AC: @multi-directory-daemon ac-9c
   190→    it('should throw error when port file contains invalid content', () => {
   191→      const portFilePath = join(tempConfigDir, 'daemon.port');
   192→      mkdirSync(tempConfigDir, { recursive: true });
   193→      writeFileSync(portFilePath, 'not-a-number', 'utf-8');
   194→
   195→      expect(() => pidManager.readPort()).toThrow('Invalid daemon port file');
   196→    });
   197→
   198→    // AC: @multi-directory-daemon ac-9c
   199→    it('should throw error when port is out of valid range (too low)', () => {
   200→      const portFilePath = join(tempConfigDir, 'daemon.port');
   201→      mkdirSync(tempConfigDir, { recursive: true });
   202→      writeFileSync(portFilePath, '0', 'utf-8');
   203→
   204→      expect(() => pidManager.readPort()).toThrow('Invalid daemon port file');
   205→    });
   206→
   207→    // AC: @multi-directory-daemon ac-9c
   208→    it('should throw error when port is out of valid range (too high)', () => {
   209→      const portFilePath = join(tempConfigDir, 'daemon.port');
   210→      mkdirSync(tempConfigDir, { recursive: true });
   211→      writeFileSync(portFilePath, '65536', 'utf-8');
   212→
   213→      expect(() => pidManager.readPort()).toThrow('Invalid daemon port file');
   214→    });
   215→
   216→    // AC: @multi-directory-daemon ac-9c
   217→    it('should accept valid port at lower boundary', () => {
   218→      pidManager.writePort(1);
   219→      expect(pidManager.readPort()).toBe(1);
   220→    });
   221→
   222→    // AC: @multi-directory-daemon ac-9c
   223→    it('should accept valid port at upper boundary', () => {
   224→      pidManager.writePort(65535);
   225→      expect(pidManager.readPort()).toBe(65535);
   226→    });
   227→  });
   228→
   229→  describe('Config directory creation', () => {
   230→    // AC: @multi-directory-daemon ac-9b
   231→    it('should create config directory when writing PID if it does not exist', async () => {
   232→      // Use a non-existent subdirectory to test directory creation
   233→      const nestedConfigDir = join(tempConfigDir, 'nested', 'config');
   234→      const nestedPidManager = new GlobalPidFileManager(nestedConfigDir);
   235→
   236→      expect(existsSync(nestedConfigDir)).toBe(false);
   237→
   238→      nestedPidManager.writePid();
   239→
   240→      expect(existsSync(nestedConfigDir)).toBe(true);
   241→    });
   242→
   243→    // AC: @multi-directory-daemon ac-9b
   244→    it('should create config directory when writing port if it does not exist', async () => {
   245→      // Use a non-existent subdirectory to test directory creation
   246→      const nestedConfigDir = join(tempConfigDir, 'nested2', 'config');
   247→      const nestedPidManager = new GlobalPidFileManager(nestedConfigDir);
   248→
   249→      expect(existsSync(nestedConfigDir)).toBe(false);
   250→
   251→      nestedPidManager.writePort(3456);
   252→
   253→      expect(existsSync(nestedConfigDir)).toBe(true);
   254→    });
   255→
   256→    // AC: @multi-directory-daemon ac-9b
   257→    it('should create config directory with mode 0755', () => {
   258→      pidManager.writePid();
   259→
   260→      const stats = statSync(tempConfigDir);
   261→      // Mode is platform-specific, but should have at least rwx for owner
   262→      const mode = stats.mode & 0o777;
   263→      expect(mode & 0o700).toBe(0o700); // Owner has rwx
   264→    });
   265→
   266→    // AC: @multi-directory-daemon ac-9b
   267→    it('should not fail when config directory already exists', () => {
   268→      mkdirSync(tempConfigDir, { recursive: true });
   269→
   270→      expect(() => pidManager.writePid()).not.toThrow();
   271→      expect(() => pidManager.writePort(3456)).not.toThrow();
   272→    });
   273→  });
   274→
   275→  describe('Daemon status detection', () => {
   276→    // AC: @multi-directory-daemon ac-10
   277→    it('should detect running daemon based on PID file', () => {
   278→      pidManager.writePid();
   279→      expect(pidManager.isDaemonRunning()).toBe(true);
   280→    });
   281→
   282→    // AC: @multi-directory-daemon ac-10
   283→    it('should detect daemon not running when PID file absent', () => {
   284→      expect(pidManager.isDaemonRunning()).toBe(false);
   285→    });
   286→
   287→    // AC: @multi-directory-daemon ac-10
   288→    it('should detect daemon not running when PID file is stale', () => {
   289→      const pidFilePath = join(tempConfigDir, 'daemon.pid');
   290→      mkdirSync(tempConfigDir, { recursive: true });
   291→      writeFileSync(pidFilePath, '999999', 'utf-8');
   292→
   293→      expect(pidManager.isDaemonRunning()).toBe(false);
   294→    });
   295→
   296→    // AC: @multi-directory-daemon ac-10
   297→    it('should detect process running', () => {
   298→      const isRunning = pidManager.isProcessRunning(process.pid);
   299→      expect(isRunning).toBe(true);
   300→    });
   301→
   302→    // AC: @multi-directory-daemon ac-10
   303→    it('should detect process not running', () => {
   304→      const isRunning = pidManager.isProcessRunning(999999);
   305→      expect(isRunning).toBe(false);
   306→    });
   307→  });
   308→
   309→  describe('Cleanup on stop', () => {
   310→    // AC: @multi-directory-daemon ac-11
   311→    it('should remove both PID and port files', () => {
   312→      pidManager.writePid();
   313→      pidManager.writePort(3456);
   314→
   315→      const pidFilePath = join(tempConfigDir, 'daemon.pid');
   316→      const portFilePath = join(tempConfigDir, 'daemon.port');
   317→
   318→      expect(existsSync(pidFilePath)).toBe(true);
   319→      expect(existsSync(portFilePath)).toBe(true);
   320→
   321→      pidManager.remove();
   322→
   323→      expect(existsSync(pidFilePath)).toBe(false);
   324→      expect(existsSync(portFilePath)).toBe(false);
   325→    });
   326→
   327→    // AC: @multi-directory-daemon ac-11
   328→    it('should not throw when removing non-existent files', () => {
   329→      expect(() => pidManager.remove()).not.toThrow();
   330→    });
   331→
   332→    // AC: @multi-directory-daemon ac-11
   333→    it('should handle partial cleanup (only PID file exists)', () => {
   334→      pidManager.writePid();
   335→
   336→      const pidFilePath = join(tempConfigDir, 'daemon.pid');
   337→      expect(existsSync(pidFilePath)).toBe(true);
   338→
   339→      expect(() => pidManager.remove()).not.toThrow();
   340→      expect(existsSync(pidFilePath)).toBe(false);
   341→    });
   342→
   343→    // AC: @multi-directory-daemon ac-11
   344→    it('should handle partial cleanup (only port file exists)', () => {
   345→      pidManager.writePort(3456);
   346→
   347→      const portFilePath = join(tempConfigDir, 'daemon.port');
   348→      expect(existsSync(portFilePath)).toBe(true);
   349→
   350→      expect(() => pidManager.remove()).not.toThrow();
   351→      expect(existsSync(portFilePath)).toBe(false);
   352→    });
   353→  });
   354→
   355→  describe('Multiple daemon prevention', () => {
   356→    // AC: @multi-directory-daemon ac-10
   357→    it('should detect existing daemon from any directory', () => {
   358→      // Simulate daemon started from project A
   359→      pidManager.writePid();
   360→      pidManager.writePort(3456);
   361→
   362→      // Create a new manager instance (as if from different directory)
   363→      const secondManager = new GlobalPidFileManager(tempConfigDir);
   364→
   365→      // Should detect the same daemon
   366→      expect(secondManager.isDaemonRunning()).toBe(true);
   367→      expect(secondManager.readPort()).toBe(3456);
   368→    });
   369→
   370→    // AC: @multi-directory-daemon ac-10
   371→    it('should prevent second daemon instance when first is running', () => {
   372→      pidManager.writePid();
   373→
   374→      // Simulate second kspec serve start
   375→      const secondManager = new GlobalPidFileManager(tempConfigDir);
   376→
   377→      expect(secondManager.isDaemonRunning()).toBe(true);
   378→      // In real CLI, this would exit with "Daemon already running" message
   379→    });
   380→
   381→    // AC: @multi-directory-daemon ac-10
   382→    it('should allow daemon start when PID file exists but process is dead', () => {
   383→      // Write stale PID
   384→      const pidFilePath = join(tempConfigDir, 'daemon.pid');
   385→      mkdirSync(tempConfigDir, { recursive: true });
   386→      writeFileSync(pidFilePath, '999999', 'utf-8');
   387→
   388→      expect(pidManager.isDaemonRunning()).toBe(false);
   389→
   390→      // Should be able to start new daemon
   391→      pidManager.writePid();
   392→      expect(pidManager.isDaemonRunning()).toBe(true);
   393→    });
   394→  });
   395→
   396→  describe('Cross-directory operation', () => {
   397→    // AC: @multi-directory-daemon ac-10, ac-13
   398→    it('should work from any directory (global state)', () => {
   399→      // Start daemon from project A (tempConfigDir)
   400→      pidManager.writePid();
   401→      pidManager.writePort(3456);
   402→
   403→      // Access from different location
   404→      const managerFromOtherDir = new GlobalPidFileManager(tempConfigDir);
   405→
   406→      expect(managerFromOtherDir.isDaemonRunning()).toBe(true);
   407→      expect(managerFromOtherDir.readPort()).toBe(3456);
   408→      expect(managerFromOtherDir.readPid()).toBe(process.pid);
   409→    });
   410→
   411→    // AC: @multi-directory-daemon ac-11
   412→    it('should stop daemon from any directory', () => {
   413→      pidManager.writePid();
   414→      pidManager.writePort(3456);
   415→
   416→      // Stop from different directory
   417→      const managerFromOtherDir = new GlobalPidFileManager(tempConfigDir);
   418→      managerFromOtherDir.remove();
   419→
   420→      // Verify cleanup
   421→      const pidFilePath = join(tempConfigDir, 'daemon.pid');
   422→      const portFilePath = join(tempConfigDir, 'daemon.port');
   423→
   424→      expect(existsSync(pidFilePath)).toBe(false);
   425→      expect(existsSync(portFilePath)).toBe(false);
   426→    });
   427→  });
   428→});
