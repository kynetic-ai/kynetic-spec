ailedIteration, createFailureNote, getTaskFailureCount } = await import(\"../../ralph/index.js\");\n\n  const results = processFailedIteration(\n    tasksInProgressFull,\n    currentTasks,\n    iterationStartTime,\n    errorDescription,\n  );\n\n  // Add notes and escalate tasks\n  for (const result of results) {\n    const taskRef = result.taskRef;\n    const task = currentTasks.find((t) => t._ulid === taskRef);\n    if (!task) continue;\n","status":"completed"}