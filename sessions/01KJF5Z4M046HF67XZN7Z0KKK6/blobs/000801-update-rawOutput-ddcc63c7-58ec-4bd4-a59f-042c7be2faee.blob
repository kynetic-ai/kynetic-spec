rmission\": {\n   467\t        const p = params as RequestPermissionRequest;\n   468\t        // In yolo mode, auto-approve all permissions\n   469\t        // In normal mode, would need to implement permission UI\n   470\t        const options = p.options || [];\n   471\t\n   472\t        if (yolo) {\n   473\t          // Find an \"allow\" option (prefer allow_always, then allow_once)\n   474\t          const allowOption =\n   475\t            options.find((o) => o.kind === \"allow_always\") ||\n   476\t            options.find((o) => o.kind === \"allow_once\");\n   477\t\n   478\t          if (allowOption) {\n   479\t            client.respondPermission(id, {\n   480\t              outcome: { outcome: \"selected\", optionId: allowOption.optionId },\n   481\t            });\n   482\t          } else {\n   483\t            // No allow option available - cancel\n   484\t            client.respondPermission(id, { outcome: { outcome: \"cancelled\" } });\n   485\t          }\n   486\t        } else {\n   487\t          // TODO: Implement permission prompting\n   488\t          client.respondPermission(id, { outcome: { outcome: \"cancelled\" } });\n   489\t        }\n   490\t        break;\n   491\t      }\n   492\t\n   493\t      case \"file/read\": {\n   494\t        const p = params as ReadTextFileRequest;\n   495\t        const content = await fs.readFile(p.path, \"utf-8\");\n   496\t        client.respondReadTextFile(id, { content });\n   497\t        break;\n   498\t      }\n   499\t\n   500\t      case \"file/write\": {\n   501\t        const p = params as WriteTextFileRequest;\n   502\t        await fs.mkdir(path.dirname(p.path), { recursive: true });\n   503\t        await fs.writeFile(p.path, p.content, \"utf-8\");\n   504\t        client.respondWriteTextFile(id, {});\n   505\t        break;\n   506\t      }\n   507\t\n   508\t      case \"terminal/run\": {\n   509\t        // Custom method (not part of ACP spec - ACP uses createTerminal instead)\n   510\t        // TODO: Consider migrating to standard ACP terminal methods\n   511\t        const p = params as {\n   512\t          command: string;\n   513\t          cwd?: string;\n   514\t          timeout?: number;\n   515\t        };\n   516\t        const command = p.command;\n   517\t        const cwd = p.cwd || process.cwd();\n   518\t        const timeout = p.timeout || 60000;\n   519\t\n   520\t        const result = await new Promise<{\n   521\t          stdout: string;\n   522\t          stderr: string;\n   523\t          exitCode: number;\n   524\t        }>((resolve) => {\n   525\t          const child = spawn(command, [], {\n   526\t            cwd,\n   527\t            shell: true,\n   528\t            timeout,\n   529\t          });\n   530\t\n   531\t          let stdout = \"\";\n   532\t          let stderr = \"\";\n   533\t\n   534\t          child.stdout?.on(\"data\", (data) => {\n   535\t            stdout += data.toString();\n   536\t          });\n   537\t\n   538\t          child.stderr?.on(\"data\", (data) => {\n   539\t            stderr += data.toString();\n   540\t          });\n   541\t\n   542\t          child.on(\"close\", (code) => {\n   543\t            resolve({ stdout, stderr, exitCode: code ?? 1 });\n   544\t          });\n   545\t\n   546\t          child.on(\"error\", (err) => {\n   547\t            resolve({ stdout, stderr: err.message, exitCode: 1 });\n   548\t          });\n   549\t        });\n   550\t\n   551\t        // Using generic respond() since this is a custom method\n   552\t        client.respond(id, result);\n   553\t        break;\n   554\t      }\n   555\t\n   556\t      default:\n   557\t        // Unknown method - return error\n   558\t        client.respondError(id, -32601, `Method not found: ${method}`);\n   559\t    }\n   560\t  } catch (err) {\n   561\t    const message = err instanceof Error ? err.message : String(err);\n   562\t    client.respondError(id, -32000, message);\n   563\t  }\n   564\t}\n   565\t\n   566\t// ─── Subagent Support ─────────────────────────────────────────────────────────\n   567\t\n   568\t/**\n   569\t * Build context for a PR review subagent.\n   570\t * AC: @ralph-subagent-spawning ac-10\n   571\t */\n   572\tasync function buildSubagentContext(\n   573\t  ctx: KspecContext,\n   574\t  taskRef: string,\n   575\t): Promise<SubagentContext> {\n   576\t  // Load all tasks and items\n   577\t  const tasks = await loadAllTasks(ctx);\n   578\t  const items = await loadAllItems(ctx);\n   579\t  const index = new ReferenceIndex(tasks, items);\n   580\t\n   581\t  // Resolve task reference\n   582\t  const taskResult = index.resolve(taskRef);\n   583\t  if (!taskResult.ok) {\n   584\t    throw new Error(`Task not found: ${taskRef}`);\n   585\t  }\n   586\t\n   587\t  const task = tasks.find((t) => t._ulid === taskResult.ulid);\n   588\t  if (!task) {\n   589\t    throw new Error(`Task not found by ULID: ${taskResult.ulid}`);\n   590\t  }\n   591\t\n   592\t  // Get linked spec with ACs if spec_ref exists\n   593\t  let specWithACs: Record<string, unknown> | null = null;\n   594\t  if (task.spec_ref) {\n   595\t    const specResult = index.resolve(task.spec_ref);\n   596\t    if (specResult.ok) {\n   597\t      const item = items.find((i) => i._ulid === specResult.ulid);\n   598\t      if (item) {\n   599\t        specWithACs = item as unknown as Record<string, unknown>;\n   600\t      }\n   601\t    }\n   602\t  }\n   603\t\n   604\t  // Get git branch\n   605\t  const gitBranch = getCurrentBranch(ctx.rootDir) || \"unknown\";\n   606\t\n   607\t  return {\n   608\t    taskRef,\n   609\t    taskDetails: task as unknown as Record<string, unknown>,\n   610\t    specWithACs,\n   611\t    gitBranch,\n   612\t  };\n   613\t}\n   614\t\n   615\t/**\n   616\t * Get the current status of a task.\n   617\t * AC: @ralph-subagent-spawning ac-12\n   618\t */\n   619\tfunction getTaskStatus(taskRef: string): string | null {\n   620\t  const result = spawnSync(\"kspec\"