```
     1→<!--
     2→  AC: @ui-task-board ac-3 — Task detail modal with full task info.
     3→  AC: @ui-task-board ac-6 — Action buttons: Start, Submit, Complete, Block, Add Note.
     4→-->
     5→<script lang="ts">
     6→	import type { TaskDetail } from '@kynetic-ai/shared';
     7→	import {
     8→		fetchTask,
     9→		startTask,
    10→		submitTask,
    11→		completeTask,
    12→		blockTask,
    13→		addTaskNote
    14→	} from '$lib/api';
    15→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    16→	import * as Dialog from '$lib/components/ui/dialog';
    17→	import { Badge } from '$lib/components/ui/badge';
    18→	import { Button } from '$lib/components/ui/button';
    19→	import { Textarea } from '$lib/components/ui/textarea';
    20→	import { Input } from '$lib/components/ui/input';
    21→	import { Separator } from '$lib/components/ui/separator';
    22→	import { Skeleton } from '$lib/components/ui/skeleton';
    23→	import ReferenceLink from '$lib/components/ReferenceLink.svelte';
    24→	import { getStatusClasses, formatAge, formatVcsRef } from './board-utils';
    25→	import GitBranch from '@lucide/svelte/icons/git-branch';
    26→	import ExternalLink from '@lucide/svelte/icons/external-link';
    27→
    28→	let {
    29→		open = $bindable(false),
    30→		taskRef = $bindable<string | null>(null),
    31→		onTaskUpdated
    32→	}: {
    33→		open?: boolean;
    34→		taskRef?: string | null;
    35→		onTaskUpdated?: () => void;
    36→	} = $props();
    37→
    38→	let task = $state<TaskDetail | null>(null);
    39→	let loading = $state(false);
    40→	let error = $state('');
    41→	let actionError = $state('');
    42→	let isSubmitting = $state(false);
    43→
    44→	// Note form
    45→	let noteContent = $state('');
    46→
    47→	// Block/Complete reason form
    48→	let reasonInput = $state('');
    49→	let showReasonFor = $state<'block' | 'complete' | null>(null);
    50→
    51→	$effect(() => {
    52→		if (open && taskRef) {
    53→			loadTask(taskRef);
    54→		} else if (!open) {
    55→			task = null;
    56→			error = '';
    57→			actionError = '';
    58→			noteContent = '';
    59→			reasonInput = '';
    60→			showReasonFor = null;
    61→		}
    62→	});
    63→
    64→	async function loadTask(ref: string) {
    65→		loading = true;
    66→		error = '';
    67→		try {
    68→			task = await fetchTask(ref);
    69→		} catch (err) {
    70→			error = err instanceof Error ? err.message : 'Failed to load task';
    71→		} finally {
    72→			loading = false;
    73→		}
    74→	}
    75→
    76→	async function reloadAndNotify() {
    77→		if (task) {
    78→			task = await fetchTask(task._ulid);
    79→		}
    80→		onTaskUpdated?.();
    81→	}
    82→
    83→	async function handleAction(action: () => Promise<void>) {
    84→		isSubmitting = true;
    85→		actionError = '';
    86→		try {
    87→			await action();
    88→			await reloadAndNotify();
    89→		} catch (err) {
    90→			if (err instanceof ReadOnlyModeError) {
    91→				actionError = err.message;
    92→			} else {
    93→				actionError = err instanceof Error ? err.message : 'Action failed';
    94→			}
    95→		} finally {
    96→			isSubmitting = false;
    97→		}
    98→	}
    99→
   100→	function handleStart() {
   101→		if (!task) return;
   102→		handleAction(() => startTask(task!._ulid));
   103→	}
   104→
   105→	function handleSubmit() {
   106→		if (!task) return;
   107→		handleAction(() => submitTask(task!._ulid));
   108→	}
   109→
   110→	function handleComplete() {
   111→		if (!task || !reasonInput.trim()) return;
   112→		const reason = reasonInput.trim();
   113→		handleAction(async () => {
   114→			await completeTask(task!._ulid, reason);
   115→			reasonInput = '';
   116→			showReasonFor = null;
   117→		});
   118→	}
   119→
   120→	function handleBlock() {
   121→		if (!task || !reasonInput.trim()) return;
   122→		const reason = reasonInput.trim();
   123→		handleAction(async () => {
   124→			await blockTask(task!._ulid, reason);
   125→			reasonInput = '';
   126→			showReasonFor = null;
   127→		});
   128→	}
   129→
   130→	function handleAddNote() {
   131→		if (!task || !noteContent.trim()) return;
   132→		const content = noteContent.trim();
   133→		handleAction(async () => {
   134→			await addTaskNote(task!._ulid, content);
   135→			noteContent = '';
   136→		});
   137→	}
   138→
   139→	function formatDate(dateStr: string): string {
   140→		return new Intl.DateTimeFormat('en-US', {
   141→			month: 'short',
   142→			day: 'numeric',
   143→			hour: '2-digit',
   144→			minute: '2-digit'
   145→		}).format(new Date(dateStr));
   146→	}
   147→
   148→	let statusInfo = $derived(task ? getStatusClasses(task.status) : null);
   149→	let slug = $derived(task?.slugs?.[0] ?? task?._ulid?.slice(0, 8) ?? '');
   150→</script>
   151→
   152→<Dialog.Root bind:open>
   153→	<Dialog.Content class="max-w-2xl max-h-[85vh] overflow-y-auto" data-testid="task-detail-modal">
   154→		{#if loading}
   155→			<div class="flex flex-col gap-4 py-4" data-testid="task-detail-skeleton">
   156→				<!-- Title skeleton -->
   157→				<Skeleton class="h-6 w-3/4 ds-shimmer" />
   158→				<Skeleton class="h-3 w-24 ds-shimmer" />
   159→
   160→				<!-- Status/priority badges skeleton -->
   161→				<div class="flex gap-2">
   162→					<Skeleton class="h-5 w-20 rounded-full ds-shimmer" />
   163→					<Skeleton class="h-5 w-24 rounded-full ds-shimmer" />
   164→				</div>
   165→
   166→				<!-- Spec ref skeleton -->
   167→				<div>
   168→					<Skeleton class="h-3 w-10 mb-1 ds-shimmer" />
   169→					<Skeleton class="h-4 w-32 ds-shimmer" />
   170→				</div>
   171→
   172→				<!-- Tags skeleton -->
   173→				<div class="flex gap-1">
   174→					<Skeleton class="h-5 w-12 rounded-full ds-shimmer" />
   175→					<Skeleton class="h-5 w-16 rounded-full ds-shimmer" />
   176→				</div>
   177→
   178→				<!-- Separator -->
   179→				<Skeleton class="h-px w-full ds-shimmer" />
   180→
   181→				<!-- Notes skeleton -->
   182→				<div>
   183→					<Skeleton class="h-3 w-16 mb-2 ds-shimmer" />
   184→					<Skeleton class="h-16 w-full rounded-md ds-shimmer" />
   185→				</div>
   186→			</div>
   187→		{:else if error}
   188→			<div class="bg-destructive/10 text-destructive p-4 rounded-lg" role="alert">
   189→				{error}
   190→			</div>
   191→		{:else if task && statusInfo}
   192→			<Dialog.Header>
   193→				<Dialog.Title data-testid="modal-task-title">{task.title}</Dialog.Title>
   194→				<Dialog.Description>
   195→					<span class="font-mono text-xs">@{slug}</span>
   196→				</Dialog.Description>
   197→			</Dialog.Header>
   198→
   199→			<div class="flex flex-col gap-4">
   200→				<!-- AC: @ui-task-board ac-3 — Description -->
   201→				{#if task.description}
   202→					<p class="text-sm text-muted-foreground" data-testid="modal-description">
   203→						{task.description}
   204→					</p>
   205→				{/if}
   206→
   207→				<!-- Status, priority, type -->
   208→				<div class="flex flex-wrap gap-2 items-center">
   209→					<Badge class="{statusInfo.bg} {statusInfo.fg}" data-testid="modal-status-badge">
   210→						{statusInfo.label}
   211→					</Badge>
   212→					<Badge variant="outline" data-testid="modal-priority">Priority {task.priority}</Badge>
   213→					<Badge variant="outline" data-testid="modal-type">{task.type}</Badge>
   214→					{#if task.automation}
   215→						<Badge variant="secondary" data-testid="modal-automation">
   216→							{task.automation}
   217→						</Badge>
   218→					{/if}
   219→				</div>
   220→
   221→				<!-- Spec ref -->
   222→				{#if task.spec_ref}
   223→					<div data-testid="modal-spec-ref">
   224→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Spec</p>
   225→						<ReferenceLink ref={task.spec_ref} type="spec" />
   226→					</div>
   227→				{/if}
   228→
   229→				<!-- Tags -->
   230→				{#if task.tags?.length > 0}
   231→					<div data-testid="modal-tags">
   232→						<p class="text-xs font-medium text-muted-foreground mb-1">Tags</p>
   233→						<div class="flex flex-wrap gap-1">
   234→							{#each task.tags as tag}
   235→								<Badge variant="secondary">{tag}</Badge>
   236→							{/each}
   237→						</div>
   238→					</div>
   239→				{/if}
   240→
   241→				<!-- Dependencies -->
   242→				{#if task.depends_on?.length > 0}
   243→					<div data-testid="modal-dependencies">
   244→						<p class="text-xs font-medium text-muted-foreground mb-1">Dependencies</p>
   245→						<ul class="text-sm space-y-0.5">
   246→							{#each task.depends_on as dep}
   247→								<li>
   248→									<ReferenceLink ref={dep} type="task" class="text-xs" />
   249→								</li>
   250→							{/each}
   251→						</ul>
   252→					</div>
   253→				{/if}
   254→
   255→				<!-- Blocked by -->
   256→				{#if task.blocked_by?.length > 0}
   257→					<div data-testid="modal-blocked-by">
   258→						<p class="text-xs font-medium text-destructive mb-1">Blocked By</p>
   259→						<ul class="text-sm space-y-0.5">
   260→							{#each task.blocked_by as blocker}
   261→								<li>
   262→									<ReferenceLink ref={blocker} type="task" class="text-xs" />
   263→								</li>
   264→							{/each}
   265→						</ul>
   266→					</div>
   267→				{/if}
   268→
   269→				<!-- AC: @ui-task-board ac-3 — VCS info (branch, PR link) -->
   270→				{#if task.vcs_refs?.length > 0}
   271→					<div data-testid="modal-vcs">
   272→						<p class="text-xs font-medium text-muted-foreground mb-1">VCS</p>
   273→						<ul class="text-sm space-y-1">
   274→							{#each task.vcs_refs as ref}
   275→								{@const vcsInfo = formatVcsRef(ref)}
   276→								<li class="flex items-center gap-1.5">
   277→									<GitBranch class="size-3 text-muted-foreground flex-shrink-0" />
   278→									{#if vcsInfo.url}
   279→										<a
   280→											href={vcsInfo.url}
   281→											target="_blank"
   282→											rel="noopener noreferrer"
   283→											class="text-xs text-primary hover:underline font-mono inline-flex items-center gap-1"
   284→										>
   285→											{vcsInfo.label}
   286→											<ExternalLink class="size-3" />
   287→										</a>
   288→									{:else}
   289→										<span class="text-muted-foreground font-mono text-xs">{vcsInfo.label}</span>
   290→									{/if}
   291→								</li>
   292→							{/each}
   293→						</ul>
   294→					</div>
   295→				{/if}
   296→
   297→				<!-- AC: @ui-task-board ac-3 — Plan ref -->
   298→				{#if task.plan_ref}
   299→					<div data-testid="modal-plan-ref">
   300→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Plan</p>
   301→						<ReferenceLink ref={task.plan_ref} type="plan" />
   302→					</div>
   303→				{:else if task.derivation}
   304→					<div data-testid="modal-plan-ref">
   305→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Derivation</p>
   306→						<p class="text-sm text-muted-foreground">{task.derivation}</p>
   307→					</div>
   308→				{/if}
   309→
   310→				<!-- AC: @ui-task-board ac-3 — Session link -->
   311→				{#if task.session_ref}
   312→					<div data-testid="modal-session-link">
   313→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Session</p>
   314→						<ReferenceLink ref={task.session_ref} type="session" />
   315→					</div>
   316→				{/if}
   317→
   318→				<Separator />
   319→
   320→				<!-- AC: @ui-task-board ac-6 — Actions -->
   321→				{#if !isStaticMode()}
   322→					<div class="flex flex-wrap gap-2" data-testid="modal-actions">
   323→						{#if task.status === 'pending'}
   324→							<Button
   325→								size="sm"
   326→								onclick={handleStart}
   327→								disabled={isSubmitting}
   328→								data-testid="action-start"
   329→							>
   330→								{isSubmitting ? 'Starting...' : 'Start'}
   331→							</Button>
   332→						{/if}
   333→
   334→						{#if task.status === 'in_progress' || task.status === 'needs_work'}
   335→							<Button
   336→								size="sm"
   337→								onclick={handleSubmit}
   338→								disabled={isSubmitting}
   339→								data-testid="action-submit"
   340→							>
   341→								{isSubmitting ? 'Submitting...' : 'Submit for Review'}
   342→							</Button>
   343→						{/if}
   344→
   345→						{#if task.status === 'in_progress' || task.status === 'pending_review'}
   346→							<Button
   347→								size="sm"
   348→								variant="outline"
   349→								onclick={() => {
   350→									showReasonFor = 'complete';
   351→									reasonInput = '';
   352→								}}
   353→								disabled={isSubmitting}
   354→								data-testid="action-complete-toggle"
   355→							>
   356→								Complete
   357→							</Button>
   358→						{/if}
   359→
   360→						{#if task.status !== 'blocked' && task.status !== 'completed' && task.status !== 'cancelled'}
   361→							<Button
   362→								size="sm"
   363→								variant="destructive"
   364→								onclick={() => {
   365→									showReasonFor = 'block';
   366→									reasonInput = '';
   367→								}}
   368→								disabled={isSubmitting}
   369→								data-testid="action-block-toggle"
   370→							>
   371→								Block
   372→							</Button>
   373→						{/if}
   374→					</div>
   375→
   376→					<!-- Reason input for block/complete -->
   377→					{#if showReasonFor}
   378→						<div class="flex gap-2" data-testid="reason-input">
   379→							<Input
   380→								bind:value={reasonInput}
   381→								placeholder="{showReasonFor === 'block' ? 'Block' : 'Completion'} reason..."
   382→								class="flex-1"
   383→							/>
   384→							<Button
   385→								size="sm"
   386→								onclick={showReasonFor === 'block' ? handleBlock : handleComplete}
   387→								disabled={isSubmitting || !reasonInput.trim()}
   388→							>
   389→								Confirm
   390→							</Button>
   391→							<Button
   392→								size="sm"
   393→								variant="ghost"
   394→								onclick={() => {
   395→									showReasonFor = null;
   396→									reasonInput = '';
   397→								}}
   398→							>
   399→								Cancel
   400→							</Button>
   401→						</div>
   402→					{/if}
   403→				{/if}
   404→
   405→				{#if actionError}
   406→					<p class="text-sm text-destructive" data-testid="action-error">{actionError}</p>
   407→				{/if}
   408→
   409→				<Separator />
   410→
   411→				<!-- Todos -->
   412→				{#if task.todos && task.todos.length > 0}
   413→					<div data-testid="modal-todos">
   414→						<p class="text-xs font-medium text-muted-foreground mb-1">
   415→							Todos ({task.todos.length})
   416→						</p>
   417→						<ul class="space-y-1">
   418→							{#each task.todos as todo}
   419→								<li class="flex items-start gap-2 text-sm">
   420→									<span class="mt-0.5 text-xs">
   421→										{#if todo.done}
   422→											&#x2705;
   423→										{:else}
   424→											&#x23F8;&#xFE0F;
   425→										{/if}
   426→									</span>
   427→									<span class:line-through={todo.done}>
   428→										{todo.text}
   429→									</span>
   430→								</li>
   431→							{/each}
   432→						</ul>
   433→					</div>
   434→					<Separator />
   435→				{/if}
   436→
   437→				<!-- Notes -->
   438→				<div data-testid="modal-notes">
   439→					<p class="text-xs font-medium text-muted-foreground mb-2">
   440→						Notes ({task.notes?.length ?? 0})
   441→					</p>
   442→
   443→					<!-- Add Note form -->
   444→					{#if !isStaticMode()}
   445→						<div class="mb-3 space-y-2" data-testid="modal-add-note">
   446→							<Textarea
   447→								placeholder="Add a note..."
   448→								bind:value={noteContent}
   449→								disabled={isSubmitting}
   450→								rows={2}
   451→							/>
   452→							<Button
   453→								size="sm"
   454→								onclick={handleAddNote}
   455→								disabled={isSubmitting || !noteContent.trim()}
   456→								data-testid="action-add-note"
   457→							>
   458→								{isSubmitting ? 'Adding...' : 'Add Note'}
   459→							</Button>
   460→						</div>
   461→					{/if}
   462→
   463→					<!-- Notes list -->
   464→					<div class="space-y-3">
   465→						{#if (task.notes ?? []).length === 0}
   466→							<div class="text-center py-4 text-muted-foreground text-xs" data-testid="notes-empty">
   467→								{#if isStaticMode()}
   468→									No notes recorded. Use <code class="bg-muted px-1 rounded">kspec task note</code> to add context.
   469→								{:else}
   470→									Add a note above to document decisions, progress, or findings.
   471→								{/if}
   472→							</div>
   473→						{:else}
   474→							{#each task.notes ?? [] as note}
   475→								<div class="border rounded-md p-2.5" data-testid="note-item">
   476→									<div class="flex justify-between items-start mb-1">
   477→										<span class="text-[10px] text-muted-foreground">{note.author}</span>
   478→										<span class="text-[10px] text-muted-foreground">{formatDate(note.created_at)}</span>
   479→									</div>
   480→									<p class="text-sm whitespace-pre-wrap">{note.content}</p>
   481→								</div>
   482→							{/each}
   483→						{/if}
   484→					</div>
   485→				</div>
   486→			</div>
   487→		{/if}
   488→	</Dialog.Content>
   489→</Dialog.Root>
   490→
```