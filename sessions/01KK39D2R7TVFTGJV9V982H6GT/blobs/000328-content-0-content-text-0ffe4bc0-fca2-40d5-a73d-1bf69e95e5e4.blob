```
     1→/**
     2→ * Shadow branch utilities for transparent spec/task state tracking.
     3→ *
     4→ * Shadow branch concept:
     5→ * - Orphan branch (kspec-meta) stores kspec state
     6→ * - .kspec/ directory is a git worktree pointing to shadow branch
     7→ * - Main branch gitignores .kspec/
     8→ * - All kspec read/write operations target .kspec/
     9→ * - Changes auto-commit to shadow branch
    10→ */
    11→
    12→import { execFile, spawn, spawnSync } from "node:child_process";
    13→import * as fs from "node:fs/promises";
    14→import * as path from "node:path";
    15→import { promisify } from "node:util";
    16→import { fileURLToPath } from "node:url";
    17→import { isBatchMode } from "../cli/batch-context.js";
    18→
    19→const __filename = fileURLToPath(import.meta.url);
    20→const __dirname = path.dirname(__filename);
    21→
    22→const execFileAsync = promisify(execFile);
    23→
    24→interface RunCommandOptions {
    25→  cwd?: string;
    26→  env?: NodeJS.ProcessEnv;
    27→}
    28→
    29→function runCommandSync(
    30→  command: string,
    31→  args: string[],
    32→  options: RunCommandOptions = {},
    33→): { ok: boolean; stdout: string; stderr: string } {
    34→  const result = spawnSync(command, args, {
    35→    cwd: options.cwd,
    36→    env: options.env,
    37→    stdio: ["ignore", "pipe", "pipe"],
    38→    encoding: "utf-8",
    39→  });
    40→
    41→  return {
    42→    ok: !result.error && result.status === 0,
    43→    stdout: (result.stdout || "").toString(),
    44→    stderr: (result.stderr || "").toString(),
    45→  };
    46→}
    47→
    48→async function runGitAsync(
    49→  cwd: string,
    50→  args: string[],
    51→  env?: NodeJS.ProcessEnv,
    52→): Promise<{ stdout: string; stderr: string }> {
    53→  const { stdout = "", stderr = "" } = await execFileAsync("git", args, {
    54→    cwd,
    55→    env,
    56→    encoding: "utf-8",
    57→  });
    58→  return { stdout: stdout.toString(), stderr: stderr.toString() };
    59→}
    60→
    61→function runGitSync(
    62→  cwd: string,
    63→  args: string[],
    64→): { ok: boolean; stdout: string } {
    65→  const result = spawnSync("git", args, {
    66→    cwd,
    67→    stdio: ["ignore", "pipe", "pipe"],
    68→    encoding: "utf-8",
    69→  });
    70→
    71→  return {
    72→    ok: !result.error && result.status === 0,
    73→    stdout: (result.stdout || "").toString(),
    74→  };
    75→}
    76→
    77→// Import getVerboseMode for checking CLI --debug-shadow flag
    78→// We use a getter function to avoid issues with circular dependencies
    79→let getVerboseModeFunc: (() => boolean) | null = null;
    80→
    81→export function setVerboseModeGetter(getter: () => boolean): void {
    82→  getVerboseModeFunc = getter;
    83→}
    84→
    85→/**
    86→ * Shadow branch configuration
    87→ */
    88→export interface ShadowConfig {
    89→  /** Whether shadow branch is enabled/detected */
    90→  enabled: boolean;
    91→  /** Path to .kspec/ worktree directory */
    92→  worktreeDir: string;
    93→  /** Shadow branch name (default: kspec-meta) */
    94→  branchName: string;
    95→  /** Project root (where .kspec/ lives) */
    96→  projectRoot: string;
    97→}
    98→
    99→/**
   100→ * Shadow branch status
   101→ */
   102→export interface ShadowStatus {
   103→  exists: boolean;
   104→  healthy: boolean;
   105→  branchExists: boolean;
   106→  worktreeExists: boolean;
   107→  worktreeLinked: boolean;
   108→  artifactsDirExists: boolean;
   109→  error?: string;
   110→}
   111→
   112→/**
   113→ * Error types for shadow branch issues
   114→ */
   115→export class ShadowError extends Error {
   116→  constructor(
   117→    message: string,
   118→    public code:
   119→      | "NOT_INITIALIZED"
   120→      | "WORKTREE_DISCONNECTED"
   121→      | "DIRECTORY_MISSING"
   122→      | "GIT_ERROR"
   123→      | "RUNNING_FROM_SHADOW",
   124→    public suggestion: string,
   125→  ) {
   126→    super(message);
   127→    this.name = "ShadowError";
   128→  }
   129→}
   130→
   131→/**
   132→ * Default shadow branch name
   133→ */
   134→export const SHADOW_BRANCH_NAME = "kspec-meta";
   135→
   136→/**
   137→ * Default shadow worktree directory
   138→ */
   139→export const SHADOW_WORKTREE_DIR = ".kspec";
   140→
   141→/**
   142→ * Options for shadow branch operations.
   143→ *
   144→ * AC: @config-shadow ac-7 — all fields optional for backward compatibility
   145→ *
   146→ * When not provided, functions use SHADOW_BRANCH_NAME and SHADOW_WORKTREE_DIR constants.
   147→ */
   148→export interface ShadowOptions {
   149→  /** Branch name (default: kspec-meta) */
   150→  branchName?: string;
   151→  /** Worktree directory name (default: .kspec) */
   152→  directory?: string;
   153→  /**
   154→   * Remote target for push/pull. Can be:
   155→   * - Named remote (e.g., "origin", "specs-origin")
   156→   * - Local filesystem path (starts with /, ./, or ~)
   157→   * - Git URL (contains :// or starts with git@)
   158→   */
   159→  remote?: string;
   160→  /** Type of remote (detected from remote string) */
   161→  remoteType?: "named" | "path" | "url";
   162→}
   163→
   164→/**
   165→ * Get effective branch name from options or default.
   166→ * AC: @config-shadow ac-7 — backward compat when called without config
   167→ */
   168→function getBranchName(options?: ShadowOptions): string {
   169→  return options?.branchName ?? SHADOW_BRANCH_NAME;
   170→}
   171→
   172→/**
   173→ * Get effective directory name from options or default.
   174→ * AC: @config-shadow ac-7 — backward compat when called without config
   175→ */
   176→function getDirectoryName(options?: ShadowOptions): string {
   177→  return options?.directory ?? SHADOW_WORKTREE_DIR;
   178→}
   179→
   180→/**
   181→ * Check if debug mode is enabled.
   182→ * Debug mode can be enabled via:
   183→ * - KSPEC_DEBUG=1 environment variable
   184→ * - Verbose flag (passed from CLI --debug-shadow option)
   185→ *
   186→ * When enabled, shadow branch operations output detailed information.
   187→ */
   188→export function isDebugMode(verboseFlag?: boolean): boolean {
   189→  if (process.env.KSPEC_DEBUG === "1") {
   190→    return true;
   191→  }
   192→  if (verboseFlag === true) {
   193→    return true;
   194→  }
   195→  // Check CLI --debug-shadow flag via getter
   196→  if (getVerboseModeFunc?.()) {
   197→    return true;
   198→  }
   199→  return false;
   200→}
   201→
   202→/**
   203→ * Check if we're in a git repository
   204→ */
   205→export async function isGitRepo(dir: string): Promise<boolean> {
   206→  return runGitSync(dir, ["rev-parse", "--git-dir"]).ok;
   207→}
   208→
   209→/**
   210→ * Get the git root directory
   211→ */
   212→export function getGitRoot(dir: string): string | null {
   213→  const result = runGitSync(dir, ["rev-parse", "--show-toplevel"]);
   214→  if (!result.ok) {
   215→    return null;
   216→  }
   217→  return result.stdout.trim();
   218→}
   219→
   220→/**
   221→ * Check if a branch exists
   222→ */
   223→export async function branchExists(
   224→  dir: string,
   225→  branchName: string,
   226→): Promise<boolean> {
   227→  return runGitSync(dir, [
   228→    "show-ref",
   229→    "--verify",
   230→    "--quiet",
   231→    `refs/heads/${branchName}`,
   232→  ]).ok;
   233→}
   234→
   235→/**
   236→ * Check if a directory is a valid git worktree
   237→ */
   238→export async function isValidWorktree(worktreeDir: string): Promise<boolean> {
   239→  try {
   240→    // Check if .git file exists (worktrees have a .git file, not directory)
   241→    const gitPath = path.join(worktreeDir, ".git");
   242→    const stat = await fs.stat(gitPath);
   243→
   244→    if (stat.isFile()) {
   245→      // Read the .git file to verify it points to a worktree
   246→      const content = await fs.readFile(gitPath, "utf-8");
   247→      return content.trim().startsWith("gitdir:");
   248→    }
   249→
   250→    return false;
   251→  } catch {
   252→    return false;
   253→  }
   254→}
   255→
   256→/**
   257→ * Detect if running from inside the shadow worktree directory.
   258→ * Returns the main project root if detected, null otherwise.
   259→ *
   260→ * AC: @config-shadow ac-8 — detects custom worktree directories using git metadata
   261→ *
   262→ * Detection logic:
   263→ * 1. Check if .git is a file (worktrees have .git files, not directories)
   264→ * 2. Read the gitdir reference from the .git file
   265→ * 3. Check if it points to a worktree for kspec (pattern: <project>/.git/worktrees/...)
   266→ *
   267→ * For custom directories, we detect ANY worktree that:
   268→ * - Has a kspec manifest in it (indicating it's a kspec shadow worktree)
   269→ * - Or has a worktree name containing "kspec" or the configured directory name
   270→ *
   271→ * @param cwd Current working directory
   272→ * @param configuredDirectory Optional configured directory name for matching
   273→ */
   274→export async function detectRunningFromShadowWorktree(
   275→  cwd: string,
   276→  configuredDirectory?: string,
   277→): Promise<string | null> {
   278→  try {
   279→    const gitPath = path.join(cwd, ".git");
   280→    const stat = await fs.stat(gitPath);
   281→
   282→    // Worktrees have a .git file, not directory
   283→    if (!stat.isFile()) {
   284→      return null;
   285→    }
   286→
   287→    const content = await fs.readFile(gitPath, "utf-8");
   288→    const match = content.trim().match(/^gitdir:\s*(.+)$/);
   289→    if (!match) {
   290→      return null;
   291→    }
   292→
   293→    const gitdir = match[1];
   294→
   295→    // Check if this is a worktree (pattern: <project>/.git/worktrees/<name>)
   296→    if (gitdir.includes(".git/worktrees/")) {
   297→      const worktreesMatch = gitdir.match(/^(.+)\/\.git\/worktrees\//);
   298→      if (worktreesMatch) {
   299→        const mainProjectRoot = worktreesMatch[1];
   300→        const cwdBase = path.basename(cwd);
   301→        const worktreeName = path.basename(gitdir);
   302→
   303→        // AC: ac-8 — check multiple patterns for shadow worktree detection
   304→        const directoryToCheck = configuredDirectory || SHADOW_WORKTREE_DIR;
   305→
   306→        // Check if directory name matches default, configured, or worktree contains "kspec"
   307→        if (
   308→          cwdBase === SHADOW_WORKTREE_DIR ||
   309→          cwdBase === directoryToCheck ||
   310→          worktreeName.includes("kspec")
   311→        ) {
   312→          return mainProjectRoot;
   313→        }
   314→
   315→        // Additional check: see if this directory has a kspec manifest
   316→        // This catches custom directories that don't have "kspec" in the name
   317→        try {
   318→          const files = await fs.readdir(cwd);
   319→          const hasKspecManifest = files.some(
   320→            (f) =>
   321→              (f.endsWith(".yaml") || f.endsWith(".yml")) &&
   322→              !f.includes(".tasks.") &&
   323→              !f.includes(".inbox."),
   324→          );
   325→          // Check for modules directory or tasks file as additional signals
   326→          const hasModules = files.includes("modules");
   327→          const hasTasksFile = files.some((f) => f.includes(".tasks."));
   328→
   329→          if (hasKspecManifest && (hasModules || hasTasksFile)) {
   330→            return mainProjectRoot;
   331→          }
   332→        } catch {
   333→          // Ignore read errors
   334→        }
   335→      }
   336→    }
   337→
   338→    return null;
   339→  } catch {
   340→    return null;
   341→  }
   342→}
   343→
   344→/**
   345→ * Detect shadow branch configuration from a directory.
   346→ * Returns shadow config if worktree directory exists and is valid.
   347→ *
   348→ * AC: @config-shadow ac-1 ac-2 — uses configured branch/directory names
   349→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
   350→ *
   351→ * @param startDir Directory to start detection from
   352→ * @param options Optional shadow configuration (branch name, directory)
   353→ */
   354→export async function detectShadow(
   355→  startDir: string,
   356→  options?: ShadowOptions,
   357→): Promise<ShadowConfig | null> {
   358→  const gitRoot = getGitRoot(startDir);
   359→  if (!gitRoot) {
   360→    return null;
   361→  }
   362→
   363→  const directoryName = getDirectoryName(options);
   364→  const branchName = getBranchName(options);
   365→  const worktreeDir = path.join(gitRoot, directoryName);
   366→
   367→  try {
   368→    await fs.access(worktreeDir);
   369→
   370→    // Verify it's a valid worktree
   371→    if (await isValidWorktree(worktreeDir)) {
   372→      return {
   373→        enabled: true,
   374→        worktreeDir,
   375→        branchName,
   376→        projectRoot: gitRoot,
   377→      };
   378→    }
   379→
   380→    // Directory exists but not a valid worktree
   381→    return null;
   382→  } catch {
   383→    // Worktree directory doesn't exist
   384→    return null;
   385→  }
   386→}
   387→
   388→/**
   389→ * Get detailed shadow branch status.
   390→ *
   391→ * AC: @config-shadow ac-1 ac-2 — uses configured branch/directory names
   392→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
   393→ *
   394→ * @param projectRoot Git repository root
   395→ * @param options Optional shadow configuration
   396→ */
   397→export async function getShadowStatus(
   398→  projectRoot: string,
   399→  options?: ShadowOptions,
   400→): Promise<ShadowStatus> {
   401→  const directoryName = getDirectoryName(options);
   402→  const branchName = getBranchName(options);
   403→  const worktreeDir = path.join(projectRoot, directoryName);
   404→
   405→  const status: ShadowStatus = {
   406→    exists: false,
   407→    healthy: false,
   408→    branchExists: false,
   409→    worktreeExists: false,
   410→    worktreeLinked: false,
   411→    artifactsDirExists: false,
   412→  };
   413→
   414→  // Check if we're in a git repo
   415→  if (!(await isGitRepo(projectRoot))) {
   416→    status.error = "Not a git repository";
   417→    return status;
   418→  }
   419→
   420→  // Check if branch exists
   421→  status.branchExists = await branchExists(projectRoot, branchName);
   422→
   423→  // Check if worktree directory exists
   424→  try {
   425→    await fs.access(worktreeDir);
   426→    status.worktreeExists = true;
   427→  } catch {
   428→    status.worktreeExists = false;
   429→  }
   430→
   431→  // Check if worktree is properly linked
   432→  if (status.worktreeExists) {
   433→    status.worktreeLinked = await isValidWorktree(worktreeDir);
   434→
   435→    // AC: @artifacts-directory ac-doctor-checks
   436→    try {
   437→      await fs.access(path.join(worktreeDir, "artifacts"));
   438→      status.artifactsDirExists = true;
   439→    } catch {
   440→      status.artifactsDirExists = false;
   441→    }
   442→  }
   443→
   444→  // Determine overall status
   445→  status.exists = status.branchExists || status.worktreeExists;
   446→  status.healthy =
   447→    status.branchExists && status.worktreeExists && status.worktreeLinked;
   448→
   449→  if (!status.healthy && status.exists) {
   450→    if (!status.branchExists) {
   451→      status.error = "Shadow branch missing but worktree exists";
   452→    } else if (!status.worktreeExists) {
   453→      status.error = "Shadow branch exists but worktree missing";
   454→    } else if (!status.worktreeLinked) {
   455→      status.error = "Worktree exists but not properly linked";
   456→    }
   457→  }
   458→
   459→  return status;
   460→}
   461→
   462→/**
   463→ * Result from checking config mismatch.
   464→ */
   465→export interface ShadowConfigMismatch {
   466→  /** Whether there is a mismatch */
   467→  hasMismatch: boolean;
   468→  /** Mismatched branch name (detected vs configured) */
   469→  branchMismatch?: { detected: string; configured: string };
   470→  /** Mismatched directory (detected vs configured) */
   471→  directoryMismatch?: { detected: string; configured: string };
   472→  /** Guidance message for the user */
   473→  guidance?: string;
   474→}
   475→
   476→/**
   477→ * Check if detected shadow branch settings match the configuration.
   478→ *
   479→ * AC: @config-shadow ac-9 — detect mismatch and guide user to migrate
   480→ *
   481→ * This function detects when:
   482→ * - A shadow branch exists with default settings (kspec-meta, .kspec)
   483→ * - But config specifies different settings
   484→ *
   485→ * @param projectRoot Git repository root
   486→ * @param configuredBranch Configured branch name
   487→ * @param configuredDirectory Configured directory name
   488→ */
   489→export async function checkConfigMismatch(
   490→  projectRoot: string,
   491→  configuredBranch: string,
   492→  configuredDirectory: string,
   493→): Promise<ShadowConfigMismatch> {
   494→  const result: ShadowConfigMismatch = { hasMismatch: false };
   495→
   496→  // First check if default shadow exists
   497→  const defaultStatus = await getShadowStatus(projectRoot, {
   498→    branchName: SHADOW_BRANCH_NAME,
   499→    directory: SHADOW_WORKTREE_DIR,
   500→  });
   501→
   502→  if (!defaultStatus.healthy) {
   503→    // No existing shadow with defaults - no mismatch possible
   504→    return result;
   505→  }
   506→
   507→  // Check if configured settings differ from defaults
   508→  const branchDiffers = configuredBranch !== SHADOW_BRANCH_NAME;
   509→  const directoryDiffers = configuredDirectory !== SHADOW_WORKTREE_DIR;
   510→
   511→  if (!branchDiffers && !directoryDiffers) {
   512→    // Config matches defaults - no mismatch
   513→    return result;
   514→  }
   515→
   516→  // There's a mismatch - existing shadow uses defaults but config specifies different values
   517→  result.hasMismatch = true;
   518→
   519→  if (branchDiffers) {
   520→    result.branchMismatch = {
   521→      detected: SHADOW_BRANCH_NAME,
   522→      configured: configuredBranch,
   523→    };
   524→  }
   525→
   526→  if (directoryDiffers) {
   527→    result.directoryMismatch = {
   528→      detected: SHADOW_WORKTREE_DIR,
   529→      configured: configuredDirectory,
   530→    };
   531→  }
   532→
   533→  // Build guidance message
   534→  const parts: string[] = [];
   535→  if (result.branchMismatch) {
   536→    parts.push(
   537→      `branch "${SHADOW_BRANCH_NAME}" (config wants "${configuredBranch}")`,
   538→    );
   539→  }
   540→  if (result.directoryMismatch) {
   541→    parts.push(
   542→      `directory "${SHADOW_WORKTREE_DIR}" (config wants "${configuredDirectory}")`,
   543→    );
   544→  }
   545→
   546→  result.guidance = [
   547→    `Shadow branch exists with ${parts.join(" and ")}.`,
   548→    "",
   549→    "To migrate to configured settings:",
   550→    "  1. Export your specs: kspec export --all > backup.yaml",
   551→    "  2. Remove existing shadow: rm -rf .kspec && git branch -D kspec-meta",
   552→    "  3. Re-initialize: kspec init",
   553→    "  4. Import specs: kspec import backup.yaml",
   554→    "",
   555→    "Or update kspec.config.yaml to match existing settings.",
   556→  ].join("\n");
   557→
   558→  return result;
   559→}
   560→
   561→/**
   562→ * Create an appropriate ShadowError based on status
   563→ */
   564→export function createShadowError(status: ShadowStatus): ShadowError {
   565→  if (!status.branchExists && !status.worktreeExists) {
   566→    return new ShadowError(
   567→      "Shadow branch not initialized",
   568→      "NOT_INITIALIZED",
   569→      "Run `kspec init` to create shadow branch and worktree.",
   570→    );
   571→  }
   572→
   573→  if (status.branchExists && !status.worktreeExists) {
   574→    return new ShadowError(
   575→      ".kspec/ directory missing",
   576→      "DIRECTORY_MISSING",
   577→      "Run `kspec shadow repair` to recreate the worktree.",
   578→    );
   579→  }
   580→
   581→  if (status.worktreeExists && !status.worktreeLinked) {
   582→    return new ShadowError(
   583→      "Worktree disconnected from git",
   584→      "WORKTREE_DISCONNECTED",
   585→      "Run `kspec shadow repair` to fix the worktree link.",
   586→    );
   587→  }
   588→
   589→  return new ShadowError(
   590→    status.error || "Unknown shadow branch error",
   591→    "GIT_ERROR",
   592→    "Check git status and try `kspec shadow repair`.",
   593→  );
   594→}
   595→
   596→/**
   597→ * Auto-commit changes to shadow branch.
   598→ * Called after write operations when shadow is enabled.
   599→ *
   600→ * @param worktreeDir Path to .kspec/ directory
   601→ * @param message Commit message
   602→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   603→ * @returns true if commit succeeded, false if nothing to commit
   604→ */
   605→export async function shadowAutoCommit(
   606→  worktreeDir: string,
   607→  message: string,
   608→  verbose?: boolean,
   609→): Promise<boolean> {
   610→  const debug = isDebugMode(verbose);
   611→
   612→  try {
   613→    if (debug) {
   614→      console.error(
   615→        `[DEBUG] Shadow auto-commit: git add -A (cwd: ${worktreeDir})`,
   616→      );
   617→    }
   618→
   619→    // Stage all changes
   620→    const addResult = runCommandSync("git", ["add", "-A"], { cwd: worktreeDir });
   621→    if (!addResult.ok) {
   622→      throw new Error(addResult.stderr || "git add failed");
   623→    }
   624→
   625→    // Check if there are staged changes
   626→    try {
   627→      if (debug) {
   628→        console.error(`[DEBUG] Shadow auto-commit: git diff --cached --quiet`);
   629→      }
   630→
   631→      const diffResult = runCommandSync(
   632→        "git",
   633→        ["diff", "--cached", "--quiet"],
   634→        { cwd: worktreeDir },
   635→      );
   636→      if (!diffResult.ok) {
   637→        throw new Error("changes staged");
   638→      }
   639→      // No error = no changes
   640→      if (debug) {
   641→        console.error(`[DEBUG] Shadow auto-commit: No changes to commit`);
   642→      }
   643→      return false;
   644→    } catch {
   645→      // Error = there are changes, proceed with commit
   646→    }
   647→
   648→    if (debug) {
   649→      console.error(`[DEBUG] Shadow auto-commit: git commit -m "${message}"`);
   650→    }
   651→
   652→    // Commit with message
   653→    // Set KSPEC_SHADOW_COMMIT=1 to signal authorized commit to git hooks
   654→    const commitResult = runCommandSync("git", ["commit", "-m", message], {
   655→      cwd: worktreeDir,
   656→      env: { ...process.env, KSPEC_SHADOW_COMMIT: "1" },
   657→    });
   658→    if (!commitResult.ok) {
   659→      throw new Error(commitResult.stderr || "git commit failed");
   660→    }
   661→
   662→    if (debug) {
   663→      console.error(`[DEBUG] Shadow auto-commit: Success`);
   664→    }
   665→
   666→    return true;
   667→  } catch (error) {
   668→    // AC: Only log error if debug mode enabled
   669→    if (debug) {
   670→      console.error("Shadow auto-commit failed:", error);
   671→    }
   672→    return false;
   673→  }
   674→}
   675→
   676→/**
   677→ * Generate commit message for a kspec operation.
   678→ */
   679→export function generateCommitMessage(
   680→  operation: string,
   681→  ref?: string,
   682→  detail?: string,
   683→): string {
   684→  const parts: string[] = [];
   685→
   686→  switch (operation) {
   687→    case "task-start":
   688→      parts.push(`Start @${ref}`);
   689→      break;
   690→    case "task-complete":
   691→      parts.push(`Complete @${ref}`);
   692→      if (detail) parts.push(`: ${detail}`);
   693→      break;
   694→    case "task-note":
   695→      parts.push(`Note on @${ref}`);
   696→      break;
   697→    case "task-add":
   698→      parts.push(`Add task: ${detail || ref}`);
   699→      break;
   700→    case "inbox-add":
   701→      parts.push(
   702→        `Inbox: ${detail?.slice(0, 50)}${(detail?.length || 0) > 50 ? "..." : ""}`,
   703→      );
   704→      break;
   705→    case "inbox-promote":
   706→      parts.push(`Promote to @${ref}`);
   707→      break;
   708→    case "item-add":
   709→      parts.push(`Add @${ref}`);
   710→      break;
   711→    case "item-set":
   712→      parts.push(`Update @${ref}`);
   713→      break;
   714→    case "item-delete":
   715→      parts.push(`Delete @${ref}`);
   716→      break;
   717→    case "derive":
   718→      parts.push(`Derive from @${ref}`);
   719→      break;
   720→    default:
   721→      parts.push(operation);
   722→      if (ref) parts.push(` @${ref}`);
   723→  }
   724→
   725→  return parts.join("");
   726→}
   727→
   728→/**
   729→ * Resolve a path relative to shadow worktree if enabled.
   730→ * Falls back to original path if shadow is not enabled.
   731→ *
   732→ * Uses the worktreeDir from shadowConfig for custom directory support.
   733→ */
   734→export function resolveShadowPath(
   735→  originalPath: string,
   736→  shadowConfig: ShadowConfig | null,
   737→  projectRoot: string,
   738→): string {
   739→  if (!shadowConfig?.enabled) {
   740→    return originalPath;
   741→  }
   742→
   743→  // If the path is within the project root, rewrite to shadow worktree
   744→  const relativePath = path.relative(projectRoot, originalPath);
   745→
   746→  // Get the directory name from the worktree path (supports custom directories)
   747→  const worktreeDirName = path.basename(shadowConfig.worktreeDir);
   748→
   749→  // Skip if path is outside project or already in shadow worktree
   750→  if (
   751→    relativePath.startsWith("..") ||
   752→    relativePath.startsWith(worktreeDirName)
   753→  ) {
   754→    return originalPath;
   755→  }
   756→
   757→  // Handle spec/ -> shadow worktree mapping
   758→  if (relativePath.startsWith("spec/") || relativePath.startsWith("spec\\")) {
   759→    const specRelative = relativePath.slice(5); // Remove 'spec/'
   760→    return path.join(shadowConfig.worktreeDir, specRelative);
   761→  }
   762→
   763→  // For task/inbox files at root, move to shadow worktree
   764→  if (
   765→    relativePath.endsWith(".tasks.yaml") ||
   766→    relativePath.endsWith(".inbox.yaml")
   767→  ) {
   768→    return path.join(shadowConfig.worktreeDir, relativePath);
   769→  }
   770→
   771→  return originalPath;
   772→}
   773→
   774→/**
   775→ * Commit changes to shadow branch if enabled.
   776→ * This is the primary interface for CLI commands to trigger auto-commit.
   777→ *
   778→ * @param shadowConfig Shadow configuration (from KspecContext.shadow)
   779→ * @param operation Operation type (e.g., 'task-start', 'task-complete')
   780→ * @param ref Reference slug or ULID (optional)
   781→ * @param detail Additional detail for commit message (optional)
   782→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   783→ * @returns true if committed, false if shadow not enabled or nothing to commit
   784→ */
   785→export async function commitIfShadow(
   786→  shadowConfig: ShadowConfig | null,
   787→  operation: string,
   788→  ref?: string,
   789→  detail?: string,
   790→  verbose?: boolean,
   791→): Promise<boolean> {
   792→  // Suppress auto-commits during atomic batch execution
   793→  if (isBatchMode()) {
   794→    return false;
   795→  }
   796→
   797→  if (!shadowConfig?.enabled) {
   798→    return false;
   799→  }
   800→
   801→  const message = generateCommitMessage(operation, ref, detail);
   802→  const committed = await shadowAutoCommit(
   803→    shadowConfig.worktreeDir,
   804→    message,
   805→    verbose,
   806→  );
   807→
   808→  // AC: @shadow-sync ac-1 - Fire-and-forget push after each commit
   809→  if (committed) {
   810→    shadowPushAsync(shadowConfig.worktreeDir, verbose);
   811→  }
   812→
   813→  return committed;
   814→}
   815→
   816→/**
   817→ * Check if shadow is required but not available, and throw appropriate error.
   818→ * Use this at the start of commands that require shadow mode.
   819→ *
   820→ * @param shadowConfig Shadow configuration from context
   821→ * @param projectRoot Project root for status check
   822→ * @throws ShadowError if shadow is not properly configured
   823→ */
   824→export async function requireShadow(
   825→  shadowConfig: ShadowConfig | null,
   826→  projectRoot: string,
   827→): Promise<void> {
   828→  if (shadowConfig?.enabled) {
   829→    return; // Shadow is available
   830→  }
   831→
   832→  const status = await getShadowStatus(projectRoot);
   833→  throw createShadowError(status);
   834→}
   835→
   836→/**
   837→ * Format a ShadowError for display in CLI.
   838→ * Returns a user-friendly message with suggestion.
   839→ */
   840→export function formatShadowError(error: ShadowError): string {
   841→  return `${error.message}\n\nSuggestion: ${error.suggestion}`;
   842→}
   843→
   844→/**
   845→ * Result from shadow initialization
   846→ */
   847→export interface ShadowInitResult {
   848→  success: boolean;
   849→  branchCreated: boolean;
   850→  worktreeCreated: boolean;
   851→  gitignoreUpdated: boolean;
   852→  initialCommit: boolean;
   853→  alreadyExists: boolean;
   854→  /** Whether shadow was created from existing remote branch */
   855→  createdFromRemote: boolean;
   856→  /** Whether new branch was pushed to remote to establish tracking */
   857→  pushedToRemote: boolean;
   858→  error?: string;
   859→}
   860→
   861→/**
   862→ * Options for shadow initialization.
   863→ *
   864→ * AC: @config-shadow ac-1 ac-2 — branch and directory configurable
   865→ */
   866→export interface ShadowInitOptions {
   867→  /** Project name for manifest */
   868→  projectName?: string;
   869→  /** Force reinitialize even if exists */
   870→  force?: boolean;
   871→  /** Shadow branch/directory/remote configuration */
   872→  shadow?: ShadowOptions;
   873→}
   874→
   875→/**
   876→ * Check if a remote exists (default: origin)
   877→ */
   878→export async function hasRemote(
   879→  projectRoot: string,
   880→  remoteName = "origin",
   881→): Promise<boolean> {
   882→  try {
   883→    const { stdout } = await runGitAsync(projectRoot, [
   884→      "remote",
   885→      "get-url",
   886→      remoteName,
   887→    ]);
   888→    return stdout.trim().length > 0;
   889→  } catch {
   890→    return false;
   891→  }
   892→}
   893→
   894→/**
   895→ * Check if a branch exists on a remote.
   896→ * Uses git ls-remote to query the remote directly, which works in both
   897→ * full and shallow clones.
   898→ *
   899→ * AC: @shadow-init-remote ac-5 — works in shallow clones
   900→ */
   901→export async function remoteBranchExists(
   902→  projectRoot: string,
   903→  branchName: string,
   904→  remoteName = "origin",
   905→): Promise<boolean> {
   906→  try {
   907→    const { stdout } = await runGitAsync(projectRoot, [
   908→      "ls-remote",
   909→      "--heads",
   910→      remoteName,
   911→      branchName,
   912→    ]);
   913→    return stdout.trim().length > 0;
   914→  } catch {
   915→    return false;
   916→  }
   917→}
   918→
   919→/**
   920→ * Fetch from remote to ensure refs are up to date.
   921→ * Returns true if fetch succeeded, false otherwise.
   922→ */
   923→export async function fetchRemote(
   924→  projectRoot: string,
   925→  remoteName = "origin",
   926→): Promise<boolean> {
   927→  try {
   928→    await runGitAsync(projectRoot, ["fetch", remoteName]);
   929→    return true;
   930→  } catch {
   931→    return false;
   932→  }
   933→}
   934→
   935→/**
   936→ * Push shadow branch to remote with tracking.
   937→ * Returns true if push succeeded, false otherwise.
   938→ *
   939→ * AC: @config-shadow ac-3 — uses configured remote name
   940→ * AC: @config-shadow ac-7 — defaults to origin when not provided
   941→ *
   942→ * @param worktreeDir Path to shadow worktree
   943→ * @param remoteName Remote name (default: origin)
   944→ * @param options Optional shadow configuration
   945→ */
   946→export async function pushShadowBranch(
   947→  worktreeDir: string,
   948→  remoteName = "origin",
   949→  options?: ShadowOptions,
   950→): Promise<boolean> {
   951→  const branchName = getBranchName(options);
   952→  try {
   953→    await runGitAsync(worktreeDir, ["push", "-u", remoteName, branchName]);
   954→    return true;
   955→  } catch {
   956→    return false;
   957→  }
   958→}
   959→
   960→/**
   961→ * Check if shadow branch has remote tracking configured.
   962→ * AC-4: Used to determine whether sync should be attempted.
   963→ *
   964→ * AC: @config-shadow ac-7 — backward compat when called without config
   965→ *
   966→ * @param worktreeDir Path to shadow worktree
   967→ * @param options Optional shadow configuration
   968→ */
   969→export async function hasRemoteTracking(
   970→  worktreeDir: string,
   971→  options?: ShadowOptions,
   972→): Promise<boolean> {
   973→  const branchName = getBranchName(options);
   974→  try {
   975→    const { stdout } = await runGitAsync(worktreeDir, [
   976→      "config",
   977→      `branch.${branchName}.remote`,
   978→    ]);
   979→    return stdout.trim().length > 0;
   980→  } catch {
   981→    return false;
   982→  }
   983→}
   984→
   985→/**
   986→ * Ensure shadow branch has remote tracking configured.
   987→ * AC-8: If shadow has no tracking but main branch has origin remote,
   988→ * automatically configure tracking to origin/kspec-meta.
   989→ *
   990→ * AC: @config-shadow ac-3 ac-4 ac-5 — handles different remote types
   991→ * AC: @config-shadow ac-6 — error with guidance if named remote doesn't exist
   992→ * AC: @config-shadow ac-7 — backward compat when called without config
   993→ *
   994→ * @param worktreeDir Path to shadow worktree
   995→ * @param projectRoot Git repository root
   996→ * @param options Optional shadow configuration
   997→ * @returns Result with success status and error details if applicable
   998→ */
   999→export async function ensureRemoteTracking(
  1000→  worktreeDir: string,
  1001→  projectRoot: string,
  1002→  options?: ShadowOptions,
  1003→): Promise<EnsureRemoteTrackingResult> {
  1004→  const branchName = getBranchName(options);
  1005→
  1006→  // Check if already has tracking
  1007→  if (await hasRemoteTracking(worktreeDir, options)) {
  1008→    return { success: true };
  1009→  }
  1010→
  1011→  // Determine remote name to use
  1012→  let remoteName = "origin";
  1013→
  1014→  if (options?.remote) {
  1015→    const remoteType = options.remoteType ?? "named";
  1016→
  1017→    if (remoteType === "named") {
  1018→      // AC: ac-3 — use the named remote directly
  1019→      remoteName = options.remote;
  1020→
  1021→      // AC: ac-6 — verify the named remote exists with guidance
  1022→      if (!(await hasRemote(projectRoot, remoteName))) {
  1023→        // Named remote doesn't exist - provide helpful guidance
  1024→        return {
  1025→          success: false,
  1026→          missingRemote: remoteName,
  1027→          guidance: `Remote '${remoteName}' does not exist. To fix this:\n` +
  1028→            `  1. Add the remote: git remote add ${remoteName} <url>\n` +
  1029→            `  2. Or update kspec.config.yaml to use an existing remote\n` +
  1030→            `  3. Or remove shadow.remote to use the default 'origin' remote`,
  1031→        };
  1032→      }
  1033→    } else if (remoteType === "path" || remoteType === "url") {
  1034→      // AC: ac-4 ac-5 — add a git remote for path/URL if not already present
  1035→      const specRemoteName = "kspec-specs";
  1036→      const hasSpecsRemote = await hasRemote(projectRoot, specRemoteName);
  1037→
  1038→      if (!hasSpecsRemote) {
  1039→        try {
  1040→          // Expand tilde for paths if needed
  1041→          let remoteTarget = options.remote;
  1042→          if (remoteType === "path" && remoteTarget.startsWith("~")) {
  1043→            remoteTarget = remoteTarget.replace(
  1044→              /^~/,
  1045→              process.env.HOME || process.env.USERPROFILE || "~",
  1046→            );
  1047→          }
  1048→
  1049→          await runGitAsync(projectRoot, [
  1050→            "remote",
  1051→            "add",
  1052→            specRemoteName,
  1053→            remoteTarget,
  1054→          ]);
  1055→        } catch {
  1056→          // Remote add failed - may already exist with different URL
  1057→          return { success: false };
  1058→        }
  1059→      }
  1060→
  1061→      remoteName = specRemoteName;
  1062→    }
  1063→  } else {
  1064→    // No remote configured - check if main branch has origin
  1065→    if (!(await hasRemote(projectRoot))) {
  1066→      return { success: false };
  1067→    }
  1068→  }
  1069→
  1070→  // Set up tracking for shadow branch
  1071→  try {
  1072→    await runGitAsync(worktreeDir, [
  1073→      "config",
  1074→      `branch.${branchName}.remote`,
  1075→      remoteName,
  1076→    ]);
  1077→    await runGitAsync(worktreeDir, [
  1078→      "config",
  1079→      `branch.${branchName}.merge`,
  1080→      `refs/heads/${branchName}`,
  1081→    ]);
  1082→    return { success: true };
  1083→  } catch {
  1084→    return { success: false };
  1085→  }
  1086→}
  1087→
  1088→/**
  1089→ * Result from ensuring remote tracking
  1090→ * AC: @config-shadow ac-6 — includes error details when named remote doesn't exist
  1091→ */
  1092→export interface EnsureRemoteTrackingResult {
  1093→  success: boolean;
  1094→  /** Error when remote doesn't exist (AC-6) */
  1095→  missingRemote?: string;
  1096→  /** Guidance message for user */
  1097→  guidance?: string;
  1098→}
  1099→
  1100→/**
  1101→ * Result from a sync operation
  1102→ */
  1103→export interface ShadowSyncResult {
  1104→  success: boolean;
  1105→  pulled: boolean;
  1106→  pushed: boolean;
  1107→  hadConflict: boolean;
  1108→  error?: string;
  1109→}
  1110→
  1111→const SHADOW_PUSH_FAILURE_ESCALATION_THRESHOLD = 3;
  1112→const shadowPushFailureCounts = new Map<string, number>();
  1113→
  1114→function summarizeShadowPushError(
  1115→  stderr: string,
  1116→  code: number | null,
  1117→  signal: NodeJS.Signals | null,
  1118→): string {
  1119→  const lines = stderr
  1120→    .split(/\r?\n/)
  1121→    .map((line) => line.trim())
  1122→    .filter(Boolean);
  1123→
  1124→  if (lines.length > 0) {
  1125→    const lastLine = lines[lines.length - 1];
  1126→    if (lastLine.length <= 240) {
  1127→      return lastLine;
  1128→    }
  1129→    return `${lastLine.slice(0, 237)}...`;
  1130→  }
  1131→
  1132→  if (code !== null) {
  1133→    return `git push exited with code ${code}`;
  1134→  }
  1135→  if (signal) {
  1136→    return `git push terminated by signal ${signal}`;
  1137→  }
  1138→  return "git push failed";
  1139→}
  1140→
  1141→function noteShadowPushFailure(worktreeDir: string, reason: string): void {
  1142→  const nextCount = (shadowPushFailureCounts.get(worktreeDir) ?? 0) + 1;
  1143→  shadowPushFailureCounts.set(worktreeDir, nextCount);
  1144→
  1145→  console.error(
  1146→    `[WARN] Shadow auto-push failed (consecutive: ${nextCount}). Local shadow commits were kept. ${reason}`,
  1147→  );
  1148→
  1149→  if (nextCount >= SHADOW_PUSH_FAILURE_ESCALATION_THRESHOLD) {
  1150→    console.error(
  1151→      `[WARN] Shadow auto-push has failed ${nextCount} times in a row. Remote shadow state is stale. Run \`kspec shadow sync\` (or \`kspec shadow resolve\` if conflicts are reported).`,
  1152→    );
  1153→  }
  1154→}
  1155→
  1156→function noteShadowPushSuccess(worktreeDir: string): void {
  1157→  shadowPushFailureCounts.delete(worktreeDir);
  1158→}
  1159→
  1160→/**
  1161→ * Fire-and-forget push to remote.
  1162→ * AC-1: Called after each auto-commit when tracking is configured.
  1163→ * AC-8: Automatically sets up tracking if main branch has remote.
  1164→ * Push failures are surfaced as warnings, but local commits still succeed.
  1165→ *
  1166→ * AC: @config-shadow ac-7 — backward compat when called without config
  1167→ *
  1168→ * @param worktreeDir Path to shadow worktree
  1169→ * @param verbose Enable debug output
  1170→ * @param options Optional shadow configuration
  1171→ */
  1172→export async function shadowPushAsync(
  1173→  worktreeDir: string,
  1174→  verbose?: boolean,
  1175→  options?: ShadowOptions,
  1176→): Promise<void> {
  1177→  const debug = isDebugMode(verbose);
  1178→
  1179→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
  1180→  const projectRoot = path.dirname(worktreeDir);
  1181→  const trackingResult = await ensureRemoteTracking(worktreeDir, projectRoot, options);
  1182→
  1183→  // AC: @config-shadow ac-6 — log guidance if named remote doesn't exist
  1184→  if (!trackingResult.success && trackingResult.missingRemote) {
  1185→    if (debug) {
  1186→      console.error(`[DEBUG] Shadow push: ${trackingResult.guidance}`);
  1187→    }
  1188→    return;
  1189→  }
  1190→
  1191→  // Check if tracking is configured before attempting push
  1192→  if (!(await hasRemoteTracking(worktreeDir, options))) {
  1193→    if (debug) {
  1194→      console.error(
  1195→        "[DEBUG] Shadow push: No remote tracking configured, skipping",
  1196→      );
  1197→    }
  1198→    return; // AC: @shadow-sync ac-4 - silently skip if no tracking
  1199→  }
  1200→
  1201→  try {
  1202→    if (debug) {
  1203→      console.error(`[DEBUG] Shadow push: git push (cwd: ${worktreeDir})`);
  1204→    }
  1205→
  1206→    // Fire and forget: detached + unref allows CLI exit without waiting for push.
  1207→    // We still collect stderr and exit code while process is alive to surface failures.
  1208→    const child = spawn("git", ["push"], {
  1209→      cwd: worktreeDir,
  1210→      stdio: ["ignore", "ignore", "pipe"],
  1211→      detached: true,
  1212→    });
  1213→
  1214→    const stderrChunks: string[] = [];
  1215→    child.stderr?.setEncoding("utf-8");
  1216→    child.stderr?.on("data", (chunk) => {
  1217→      stderrChunks.push(chunk);
  1218→    });
  1219→    child.stderr?.resume();
  1220→
  1221→    (child.stderr as { unref?: () => void } | null)?.unref?.();
  1222→    child.unref();
  1223→    if (debug) {
  1224→      console.error("[DEBUG] Shadow push: spawned background git push");
  1225→    }
  1226→
  1227→    const exit = await new Promise<{
  1228→      code: number | null;
  1229→      signal: NodeJS.Signals | null;
  1230→      error?: Error;
  1231→    }>((resolve) => {
  1232→      let settled = false;
  1233→      const finish = (result: {
  1234→        code: number | null;
  1235→        signal: NodeJS.Signals | null;
  1236→        error?: Error;
  1237→      }) => {
  1238→        if (settled) {
  1239→          return;
  1240→        }
  1241→        settled = true;
  1242→        resolve(result);
  1243→      };
  1244→
  1245→      child.once("error", (error) => finish({ code: null, signal: null, error }));
  1246→      child.once("close", (code, signal) => finish({ code, signal }));
  1247→    });
  1248→
  1249→    if (exit.error) {
  1250→      noteShadowPushFailure(worktreeDir, exit.error.message);
  1251→      if (debug) {
  1252→        console.error("[DEBUG] Shadow push spawn error:", exit.error);
  1253→      }
  1254→      return;
  1255→    }
  1256→
  1257→    if (exit.code !== 0) {
  1258→      const reason = summarizeShadowPushError(
  1259→        stderrChunks.join(""),
  1260→        exit.code,
  1261→        exit.signal,
  1262→      );
  1263→      noteShadowPushFailure(worktreeDir, reason);
  1264→      return;
  1265→    }
  1266→
  1267→    noteShadowPushSuccess(worktreeDir);
  1268→  } catch (err) {
  1269→    const reason = err instanceof Error ? err.message : String(err);
  1270→    noteShadowPushFailure(worktreeDir, reason);
  1271→
  1272→    if (debug) {
  1273→      console.error("[DEBUG] Shadow push error:", err);
  1274→    }
  1275→  }
  1276→}
  1277→
  1278→/**
  1279→ * Pull remote changes to shadow branch.
  1280→ * AC-2: Called at session start to sync before operations.
  1281→ * AC-6: Uses --ff-only first, falls back to --rebase.
  1282→ * AC-3: On conflict, returns failure with suggestion.
  1283→ * AC-8: Automatically sets up tracking if main branch has remote.
  1284→ *
  1285→ * AC: @config-shadow ac-7 — backward compat when called without config
  1286→ *
  1287→ * @param worktreeDir Path to shadow worktree
  1288→ * @param options Optional shadow configuration
  1289→ */
  1290→export async function shadowPull(
  1291→  worktreeDir: string,
  1292→  options?: ShadowOptions,
  1293→): Promise<ShadowSyncResult> {
  1294→  const branchName = getBranchName(options);
  1295→  const result: ShadowSyncResult = {
  1296→    success: false,
  1297→    pulled: false,
  1298→    pushed: false,
  1299→    hadConflict: false,
  1300→  };
  1301→
  1302→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
  1303→  const projectRoot = path.dirname(worktreeDir);
  1304→  const trackingResult = await ensureRemoteTracking(worktreeDir, projectRoot, options);
  1305→
  1306→  // AC: @config-shadow ac-6 — error with guidance if named remote doesn't exist
  1307→  if (!trackingResult.success && trackingResult.missingRemote) {
  1308→    result.error = trackingResult.guidance;
  1309→    return result;
  1310→  }
  1311→
  1312→  // AC: @shadow-sync ac-4 - Skip if no remote tracking
  1313→  if (!(await hasRemoteTracking(worktreeDir, options))) {
  1314→    result.success = true;
  1315→    return result;
  1316→  }
  1317→
  1318→  // Check if remote branch exists before attempting pull
  1319→  // Fetch first to ensure refs are up to date
  1320→  await fetchRemote(projectRoot);
  1321→  const remoteHasBranch = await remoteBranchExists(projectRoot, branchName);
  1322→  if (!remoteHasBranch) {
  1323→    // Remote branch doesn't exist yet - nothing to pull, but success
  1324→    result.success = true;
  1325→    return result;
  1326→  }
  1327→
  1328→  try {
  1329→    // Try fast-forward only first (cleanest)
  1330→    await runGitAsync(worktreeDir, ["pull", "--ff-only"]);
  1331→    result.success = true;
  1332→    result.pulled = true;
  1333→    return result;
  1334→  } catch {
  1335→    // Fast-forward failed, try rebase
  1336→  }
  1337→
  1338→  try {
  1339→    // AC: @shadow-sync ac-6 - Fall back to rebase
  1340→    await runGitAsync(worktreeDir, ["pull", "--rebase"]);
  1341→    result.success = true;
  1342→    result.pulled = true;
  1343→    return result;
  1344→  } catch {
  1345→    // Rebase failed - likely conflict
  1346→  }
  1347→
  1348→  // AC: @shadow-sync ac-3 - Conflict detected - abort rebase and report
  1349→  try {
  1350→    await runGitAsync(worktreeDir, ["rebase", "--abort"]);
  1351→  } catch {
  1352→    // May not be in rebase state, ignore
  1353→  }
  1354→
  1355→  result.hadConflict = true;
  1356→  result.error = "Sync conflict detected. Run `kspec shadow resolve` to fix.";
  1357→  return result;
  1358→}
  1359→
  1360→/**
  1361→ * Full sync operation: pull then push.
  1362→ * Used by session start and explicit sync commands.
  1363→ *
  1364→ * AC: @config-shadow ac-7 — backward compat when called without config
  1365→ *
  1366→ * @param worktreeDir Path to shadow worktree
  1367→ * @param options Optional shadow configuration
  1368→ */
  1369→export async function shadowSync(
  1370→  worktreeDir: string,
  1371→  options?: ShadowOptions,
  1372→): Promise<ShadowSyncResult> {
  1373→  // First pull
  1374→  const pullResult = await shadowPull(worktreeDir, options);
  1375→  if (!pullResult.success) {
  1376→    return pullResult;
  1377→  }
  1378→
  1379→  // Then push (only if tracking configured, checked inside)
  1380→  if (await hasRemoteTracking(worktreeDir, options)) {
  1381→    try {
  1382→      await runGitAsync(worktreeDir, ["push"]);
  1383→      pullResult.pushed = true;
  1384→    } catch {
  1385→      // Push failed - not a critical error, local state is correct
  1386→      // Could be permissions, network, etc.
  1387→    }
  1388→  }
  1389→
  1390→  return pullResult;
  1391→}
  1392→
  1393→/**
  1394→ * Check if .gitignore has uncommitted changes
  1395→ */
  1396→async function hasUncommittedGitignore(projectRoot: string): Promise<boolean> {
  1397→  try {
  1398→    // Check both staged and unstaged changes to .gitignore
  1399→    const { stdout } = await runGitAsync(projectRoot, [
  1400→      "status",
  1401→      "--porcelain",
  1402→      ".gitignore",
  1403→    ]);
  1404→    return stdout.trim().length > 0;
  1405→  } catch {
  1406→    return false;
  1407→  }
  1408→}
  1409→
  1410→/**
  1411→ * Commit only .gitignore with a message.
  1412→ *
  1413→ * @param projectRoot Git repository root
  1414→ * @param directoryName Shadow directory name (for commit message)
  1415→ */
  1416→async function commitGitignore(
  1417→  projectRoot: string,
  1418→  directoryName: string,
  1419→): Promise<void> {
  1420→  await runGitAsync(projectRoot, ["add", ".gitignore"]);
  1421→  await runGitAsync(projectRoot, [
  1422→    "commit",
  1423→    "-m",
  1424→    `chore: add ${directoryName}/ to .gitignore for shadow branch`,
  1425→  ]);
  1426→}
  1427→
  1428→/**
  1429→ * Add shadow directory to .gitignore if not already present.
  1430→ * Fails if .gitignore has uncommitted changes.
  1431→ * Commits the change after adding.
  1432→ *
  1433→ * AC: @config-shadow ac-2 — uses configured directory name
  1434→ * AC: @config-shadow ac-7 — defaults to .kspec when not provided
  1435→ *
  1436→ * @param projectRoot Git repository root
  1437→ * @param options Optional shadow configuration
  1438→ */
  1439→async function ensureGitignore(
  1440→  projectRoot: string,
  1441→  options?: ShadowOptions,
  1442→): Promise<boolean> {
  1443→  const directoryName = getDirectoryName(options);
  1444→  const gitignorePath = path.join(projectRoot, ".gitignore");
  1445→  const entry = `${directoryName}/`;
  1446→
  1447→  // Fail fast if .gitignore has uncommitted changes
  1448→  if (await hasUncommittedGitignore(projectRoot)) {
  1449→    throw new ShadowError(
  1450→      ".gitignore has uncommitted changes",
  1451→      "GIT_ERROR",
  1452→      "Commit or stash your .gitignore changes before running kspec init.",
  1453→    );
  1454→  }
  1455→
  1456→  try {
  1457→    let content = "";
  1458→    try {
  1459→      content = await fs.readFile(gitignorePath, "utf-8");
  1460→    } catch {
  1461→      // File doesn't exist, will create
  1462→    }
  1463→
  1464→    // Check if already present (handle various formats)
  1465→    const lines = content.split("\n");
  1466→    const patterns = [
  1467→      directoryName,
  1468→      `${directoryName}/`,
  1469→      `/${directoryName}`,
  1470→      `/${directoryName}/`,
  1471→    ];
  1472→
  1473→    for (const line of lines) {
  1474→      const trimmed = line.trim();
  1475→      if (patterns.includes(trimmed)) {
  1476→        return false; // Already present
  1477→      }
  1478→    }
  1479→
  1480→    // Add to gitignore
  1481→    const newContent =
  1482→      content.endsWith("\n") || content === ""
  1483→        ? `${content}${entry}\n`
  1484→        : `${content}\n${entry}\n`;
  1485→
  1486→    await fs.writeFile(gitignorePath, newContent, "utf-8");
  1487→
  1488→    // Commit the change
  1489→    await commitGitignore(projectRoot, directoryName);
  1490→
  1491→    return true;
  1492→  } catch (error) {
  1493→    if (error instanceof ShadowError) {
  1494→      throw error;
  1495→    }
  1496→    throw new ShadowError(
  1497→      `Failed to update .gitignore: ${error}`,
  1498→      "GIT_ERROR",
  1499→      "Check file permissions for .gitignore",
  1500→    );
  1501→  }
  1502→}
  1503→
  1504→/**
  1505→ * Generate initial manifest content for shadow branch
  1506→ */
  1507→function generateShadowManifest(projectName: string): string {
  1508→  return `# ${projectName} - Kynetic Spec
  1509→# Generated by kspec init
  1510→
  1511→kynetic: "1.0"
  1512→
  1513→project:
  1514→  name: "${projectName}"
  1515→  version: "0.1.0"
  1516→  status: draft
  1517→  description: |
  1518→    Add your project description here.
  1519→
  1520→# Module includes
  1521→includes:
  1522→  - modules/main.yaml
  1523→`;
  1524→}
  1525→
  1526→/**
  1527→ * Generate initial module content
  1528→ */
  1529→function generateShadowModule(projectName: string): string {
  1530→  return `# ${projectName} - Main Module
  1531→# Add your spec items here
  1532→
  1533→items: []
  1534→`;
  1535→}
  1536→
  1537→/**
  1538→ * Generate initial tasks file
  1539→ */
  1540→function generateShadowTasks(projectName: string): string {
  1541→  return `# ${projectName} - Tasks
  1542→# Track implementation work here
  1543→
  1544→tasks: []
  1545→`;
  1546→}
  1547→
  1548→/**
  1549→ * Generate initial inbox file
  1550→ */
  1551→function generateShadowInbox(): string {
  1552→  return `# Inbox - Quick Capture
  1553→# Ideas and notes that haven't been triaged yet
  1554→
  1555→items: []
  1556→`;
  1557→}
  1558→
  1559→/**
  1560→ * Get the kspec package root directory.
  1561→ * Navigates from dist/parser/ to package root.
  1562→ */
  1563→function getPackageRoot(): string {
  1564→  return path.resolve(__dirname, "..", "..");
  1565→}
  1566→
  1567→/**
  1568→ * Install pre-commit hook to protect kspec-meta branch.
  1569→ * Hook prevents direct commits to shadow branch unless KSPEC_SHADOW_COMMIT=1.
  1570→ *
  1571→ * Note: Git worktrees use hooks from the main .git/hooks directory (via commondir),
  1572→ * not from .git/worktrees/-kspec/hooks. So we install to main hooks directory.
  1573→ *
  1574→ * The hook source is located in the kspec package's templates/hooks/ directory.
  1575→ *
  1576→ * @param projectRoot Git repository root
  1577→ * @returns true if hook was installed, false if already exists
  1578→ */
  1579→async function installShadowHook(projectRoot: string): Promise<boolean> {
  1580→  const hooksDir = path.join(projectRoot, ".git", "hooks");
  1581→  const hookPath = path.join(hooksDir, "pre-commit");
  1582→
  1583→  // Look for hook in package templates directory
  1584→  const packageRoot = getPackageRoot();
  1585→  const sourceHookPath = path.join(packageRoot, "templates", "hooks", "pre-commit");
  1586→
  1587→  try {
  1588→    // Check if source hook exists in package templates
  1589→    try {
  1590→      await fs.access(sourceHookPath);
  1591→    } catch {
  1592→      // Source hook doesn't exist - skip installation
  1593→      return false;
  1594→    }
  1595→
  1596→    // Check if hook already exists
  1597→    try {
  1598→      await fs.access(hookPath);
  1599→      // Hook exists - don't overwrite (user may have custom hooks)
  1600→      return false;
  1601→    } catch {
  1602→      // Hook doesn't exist - install it
  1603→    }
  1604→
  1605→    // Copy hook from package templates
  1606→    const hookContent = await fs.readFile(sourceHookPath, "utf-8");
  1607→    await fs.writeFile(hookPath, hookContent, { mode: 0o755 });
  1608→    return true;
  1609→  } catch (_error) {
  1610→    // Silently fail - hook installation is optional
  1611→    return false;
  1612→  }
  1613→}
  1614→
  1615→/**
  1616→ * Convert project name to slug (kebab-case)
  1617→ */
  1618→function toSlug(projectName: string): string {
  1619→  return projectName
  1620→    .toLowerCase()
  1621→    .replace(/[^a-z0-9]+/g, "-")
  1622→    .replace(/^-|-$/g, "");
  1623→}
  1624→
  1625→/**
  1626→ * Configure git merge driver for kspec YAML files.
  1627→ * AC: @yaml-merge-driver ac-12
  1628→ *
  1629→ * Configures the merge driver in .git/config and adds .gitattributes in the shadow branch.
  1630→ *
  1631→ * @param projectRoot Git repository root
  1632→ * @param worktreeDir Path to shadow worktree directory
  1633→ * @returns true if configuration was successful
  1634→ */
  1635→async function configureMergeDriver(
  1636→  projectRoot: string,
  1637→  worktreeDir: string,
  1638→): Promise<boolean> {
  1639→  try {
  1640→    // Step 1: Configure merge driver in .git/config
  1641→    const kspecPathResult = runCommandSync("which", ["kspec"]);
  1642→    if (!kspecPathResult.ok) {
  1643→      throw new Error(kspecPathResult.stderr || "kspec executable not found");
  1644→    }
  1645→    const kspecPath = kspecPathResult.stdout.trim();
  1646→
  1647→    // Add merge driver configuration to git config
  1648→    try {
  1649→      const setNameResult = runCommandSync(
  1650→        "git",
  1651→        ["config", "merge.kspec.name", "Kspec YAML semantic merge driver"],
  1652→        { cwd: projectRoot },
  1653→      );
  1654→      if (!setNameResult.ok) {
  1655→        throw new Error(setNameResult.stderr || "failed to set merge.kspec.name");
  1656→      }
  1657→
  1658→      const setDriverResult = runCommandSync(
  1659→        "git",
  1660→        [
  1661→          "config",
  1662→          "merge.kspec.driver",
  1663→          `${kspecPath} merge-driver %O %A %B --non-interactive`,
  1664→        ],
  1665→        { cwd: projectRoot },
  1666→      );
  1667→      if (!setDriverResult.ok) {
  1668→        throw new Error(setDriverResult.stderr || "failed to set merge.kspec.driver");
  1669→      }
  1670→    } catch (error) {
  1671→      // Config may fail if already set - check if it's set correctly
  1672→      try {
  1673→        const existingDriverResult = runCommandSync(
  1674→          "git",
  1675→          ["config", "merge.kspec.driver"],
  1676→          { cwd: projectRoot },
  1677→        );
  1678→        if (!existingDriverResult.ok) {
  1679→          throw new Error(existingDriverResult.stderr || "failed to read merge.kspec.driver");
  1680→        }
  1681→        const existingDriver = existingDriverResult.stdout.trim();
  1682→
  1683→        if (!existingDriver.includes("kspec merge-driver")) {
  1684→          throw new Error("Merge driver config exists but is incorrect");
  1685→        }
  1686→
  1687→        // Ensure --non-interactive flag is present (older registrations may lack it)
  1688→        if (!existingDriver.includes("--non-interactive")) {
  1689→          const fixResult = runCommandSync(
  1690→            "git",
  1691→            [
  1692→              "config",
  1693→              "merge.kspec.driver",
  1694→              `${kspecPath} merge-driver %O %A %B --non-interactive`,
  1695→            ],
  1696→            { cwd: projectRoot },
  1697→          );
  1698→          if (!fixResult.ok) {
  1699→            throw new Error(
  1700→              fixResult.stderr || "failed to update merge.kspec.driver with --non-interactive",
  1701→            );
  1702→          }
  1703→        }
  1704→      } catch {
  1705→        throw error; // Re-throw original error
  1706→      }
  1707→    }
  1708→
  1709→    // Step 2: Create .gitattributes in shadow branch
  1710→    const gitattributesPath = path.join(worktreeDir, ".gitattributes");
  1711→
  1712→    // Check if .gitattributes exists
  1713→    let existingContent = "";
  1714→    try {
  1715→      existingContent = await fs.readFile(gitattributesPath, "utf-8");
  1716→    } catch {
  1717→      // File doesn't exist, that's fine
  1718→    }
  1719→
  1720→    // Check if merge driver is already configured
  1721→    if (!existingContent.includes("merge=kspec")) {
  1722→      const attributesContent = existingContent
  1723→        ? existingContent + "\n"
  1724→        : "# Git attributes for kspec\n\n";
  1725→
  1726→      await fs.writeFile(
  1727→        gitattributesPath,
  1728→        attributesContent + "*.yaml merge=kspec\n*.yml merge=kspec\n",
  1729→        "utf-8",
  1730→      );
  1731→
  1732→      // Commit .gitattributes to shadow branch
  1733→      await shadowAutoCommit(worktreeDir, "Configure kspec merge driver");
  1734→    }
  1735→
  1736→    return true;
  1737→  } catch (_error) {
  1738→    // Silently fail - merge driver configuration is optional
  1739→    return false;
  1740→  }
  1741→}
  1742→
  1743→/**
  1744→ * Initialize shadow branch and worktree.
  1745→ * Creates orphan branch, worktree, updates gitignore, and creates initial structure.
  1746→ *
  1747→ * AC: @config-shadow ac-1 — creates orphan branch with configured name
  1748→ * AC: @config-shadow ac-2 — creates worktree at configured directory
  1749→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
  1750→ *
  1751→ * @param projectRoot Git repository root
  1752→ * @param options Initialization options
  1753→ * @returns Result indicating what was created
  1754→ */
  1755→export async function initializeShadow(
  1756→  projectRoot: string,
  1757→  options: ShadowInitOptions = {},
  1758→): Promise<ShadowInitResult> {
  1759→  const result: ShadowInitResult = {
  1760→    success: false,
  1761→    branchCreated: false,
  1762→    worktreeCreated: false,
  1763→    gitignoreUpdated: false,
  1764→    initialCommit: false,
  1765→    alreadyExists: false,
  1766→    createdFromRemote: false,
  1767→    pushedToRemote: false,
  1768→  };
  1769→
  1770→  // Check if we're in a git repo
  1771→  if (!(await isGitRepo(projectRoot))) {
  1772→    result.error = "Not a git repository";
  1773→    return result;
  1774→  }
  1775→
  1776→  // AC: ac-1 ac-2 — use configured branch/directory or defaults
  1777→  const branchName = getBranchName(options.shadow);
  1778→  const directoryName = getDirectoryName(options.shadow);
  1779→  const worktreeDir = path.join(projectRoot, directoryName);
  1780→
  1781→  // Check current status with configured options
  1782→  const status = await getShadowStatus(projectRoot, options.shadow);
  1783→
  1784→  // Handle existing shadow branch
  1785→  if (status.healthy && !options.force) {
  1786→    result.alreadyExists = true;
  1787→    result.success = true;
  1788→    return result;
  1789→  }
  1790→
  1791→  // Derive project name if not provided
  1792→  const projectName =
  1793→    options.projectName ||
  1794→    path
  1795→      .basename(projectRoot)
  1796→      .replace(/[-_]/g, " ")
  1797→      .replace(/\b\w/g, (c) => c.toUpperCase());
  1798→
  1799→  const slug = toSlug(projectName);
  1800→
  1801→  // Determine remote name to use
  1802→  let remoteName = "origin";
  1803→  if (options.shadow?.remote && options.shadow.remoteType === "named") {
  1804→    remoteName = options.shadow.remote;
  1805→  }
  1806→
  1807→  // Check for remote shadow branch
  1808→  // AC: @shadow-init-remote ac-4 ac-5 — queries remote directly via ls-remote
  1809→  const remoteExists = await hasRemote(projectRoot, remoteName);
  1810→  let remoteHasShadow = false;
  1811→  if (remoteExists) {
  1812→    remoteHasShadow = await remoteBranchExists(projectRoot, branchName, remoteName);
  1813→  }
  1814→
  1815→  try {
  1816→    // Step 1: Update .gitignore first (before creating worktree)
  1817→    result.gitignoreUpdated = await ensureGitignore(projectRoot, options.shadow);
  1818→
  1819→    // Step 2: Create worktree with orphan branch (or attach to existing branch)
  1820→    if (!status.worktreeExists || !status.worktreeLinked) {
  1821→      // Remove existing directory if present but not linked
  1822→      if (status.worktreeExists && !status.worktreeLinked) {
  1823→        await fs.rm(worktreeDir, { recursive: true, force: true });
  1824→      }
  1825→
  1826→      // Remove stale worktree reference if any
  1827→      try {
  1828→        await runGitAsync(projectRoot, [
  1829→          "worktree",
  1830→          "remove",
  1831→          directoryName,
  1832→          "--force",
  1833→        ]);
  1834→      } catch {
  1835→        // Ignore - worktree may not exist in git's list
  1836→      }
  1837→
  1838→      if (remoteHasShadow) {
  1839→        // AC: @shadow-init-remote ac-1, ac-5 - Remote has shadow branch - fetch and create worktree
  1840→        // Fetch with refspec to create a local branch ref (required in shallow clones
  1841→        // where plain `git fetch origin kspec-meta` only populates FETCH_HEAD)
  1842→        await runGitAsync(projectRoot, [
  1843→          "fetch",
  1844→          remoteName,
  1845→          `${branchName}:${branchName}`,
  1846→        ]);
  1847→        await runGitAsync(projectRoot, [
  1848→          "worktree",
  1849→          "add",
  1850→          directoryName,
  1851→          branchName,
  1852→        ]);
  1853→        // Set up tracking for the branch
  1854→        // Use git config directly — `git branch --set-upstream-to` requires
  1855→        // the remote tracking ref to exist locally, which may not be the case
  1856→        // in shallow clones where we only fetched the branch itself
  1857→        await runGitAsync(projectRoot, [
  1858→          "config",
  1859→          `branch.${branchName}.remote`,
  1860→          remoteName,
  1861→        ]);
  1862→        await runGitAsync(projectRoot, [
  1863→          "config",
  1864→          `branch.${branchName}.merge`,
  1865→          `refs/heads/${branchName}`,
  1866→        ]);
  1867→        result.createdFromRemote = true;
  1868→      } else if (!status.branchExists) {
  1869→        // AC: @shadow-init-remote ac-2 ac-3 - No remote branch or no remote - create orphan branch
  1870→        // AC: @config-shadow ac-1 — use configured branch name
  1871→        await runGitAsync(projectRoot, [
  1872→          "worktree",
  1873→          "add",
  1874→          "--orphan",
  1875→          "-b",
  1876→          branchName,
  1877→          directoryName,
  1878→        ]);
  1879→        result.branchCreated = true;
  1880→      } else {
  1881→        // Attach to existing local branch
  1882→        await runGitAsync(projectRoot, [
  1883→          "worktree",
  1884→          "add",
  1885→          directoryName,
  1886→          branchName,
  1887→        ]);
  1888→      }
  1889→
  1890→      result.worktreeCreated = true;
  1891→    }
  1892→
  1893→    // Step 3: Create initial structure if empty (only for new branches, not remote)
  1894→    const manifestPath = path.join(worktreeDir, `${slug}.yaml`);
  1895→    const modulesDir = path.join(worktreeDir, "modules");
  1896→    const moduleFilePath = path.join(modulesDir, "main.yaml");
  1897→    const tasksPath = path.join(worktreeDir, `${slug}.tasks.yaml`);
  1898→    const inboxPath = path.join(worktreeDir, `${slug}.inbox.yaml`);
  1899→
  1900→    let filesCreated = false;
  1901→
  1902→    // Only create files if manifest doesn't exist (remote branches will have files)
  1903→    try {
  1904→      // Look for any .yaml manifest file (project name may differ)
  1905→      const files = await fs.readdir(worktreeDir);
  1906→      const hasManifest = files.some(
  1907→        (f) =>
  1908→          f.endsWith(".yaml") &&
  1909→          !f.includes(".tasks.") &&
  1910→          !f.includes(".inbox."),
  1911→      );
  1912→      if (!hasManifest) {
  1913→        throw new Error("No manifest found");
  1914→      }
  1915→    } catch {
  1916→      // Manifest doesn't exist, create initial structure
  1917→      await fs.mkdir(modulesDir, { recursive: true });
  1918→      await fs.writeFile(
  1919→        manifestPath,
  1920→        generateShadowManifest(projectName),
  1921→        "utf-8",
  1922→      );
  1923→      await fs.writeFile(
  1924→        moduleFilePath,
  1925→        generateShadowModule(projectName),
  1926→        "utf-8",
  1927→      );
  1928→      await fs.writeFile(tasksPath, generateShadowTasks(projectName), "utf-8");
  1929→      await fs.writeFile(inboxPath, generateShadowInbox(), "utf-8");
  1930→
  1931→      // AC: @artifacts-directory ac-init-creates, ac-gitignore-entry
  1932→      const artifactsDir = path.join(worktreeDir, "artifacts");
  1933→      await fs.mkdir(artifactsDir, { recursive: true });
  1934→      await fs.writeFile(
  1935→        path.join(worktreeDir, ".gitignore"),
  1936→        "# Ephemeral artifacts - reports, exports, generated files\n# Not tracked in shadow branch\nartifacts/\n",
  1937→        "utf-8",
  1938→      );
  1939→
  1940→      filesCreated = true;
  1941→    }
  1942→
  1943→    // Step 4: Initial commit if files were created
  1944→    if (filesCreated) {
  1945→      result.initialCommit = await shadowAutoCommit(
  1946→        worktreeDir,
  1947→        `Initialize ${projectName} spec`,
  1948→      );
  1949→    }
  1950→
  1951→    // Step 5: AC-2: Push new branch to remote to establish tracking
  1952→    if (result.branchCreated && remoteExists && !remoteHasShadow) {
  1953→      result.pushedToRemote = await pushShadowBranch(worktreeDir, remoteName, options.shadow);
  1954→    }
  1955→
  1956→    // Step 6: Install pre-commit hook to protect shadow branch
  1957→    await installShadowHook(projectRoot);
  1958→
  1959→    // Step 7: Configure merge driver for semantic YAML merging
  1960→    // AC: @yaml-merge-driver ac-12
  1961→    await configureMergeDriver(projectRoot, worktreeDir);
  1962→
  1963→    result.success = true;
  1964→    return result;
  1965→  } catch (error) {
  1966→    result.error = error instanceof Error ? error.message : String(error);
  1967→    return result;
  1968→  }
  1969→}
  1970→
  1971→/**
  1972→ * Repair a broken shadow branch setup.
  1973→ * Handles cases where worktree is disconnected or directory is missing.
  1974→ *
  1975→ * AC: @config-shadow ac-7 — backward compat when called without config
  1976→ *
  1977→ * @param projectRoot Git repository root
  1978→ * @param options Optional shadow configuration
  1979→ * @returns Result indicating what was repaired
  1980→ */
  1981→export async function repairShadow(
  1982→  projectRoot: string,
  1983→  options?: ShadowOptions,
  1984→): Promise<ShadowInitResult> {
  1985→  const branchName = getBranchName(options);
  1986→  const directoryName = getDirectoryName(options);
  1987→  const status = await getShadowStatus(projectRoot, options);
  1988→
  1989→  if (status.healthy) {
  1990→    return {
  1991→      success: true,
  1992→      branchCreated: false,
  1993→      worktreeCreated: false,
  1994→      gitignoreUpdated: false,
  1995→      initialCommit: false,
  1996→      alreadyExists: true,
  1997→      createdFromRemote: false,
  1998→      pushedToRemote: false,
  1999→    };
  2000→  }
  2001→
  2002→  if (!status.branchExists) {
  2003→    // Can't repair without a branch - need full init
  2004→    return {
  2005→      success: false,
  2006→      branchCreated: false,
  2007→      worktreeCreated: false,
  2008→      gitignoreUpdated: false,
  2009→      initialCommit: false,
  2010→      alreadyExists: false,
  2011→      createdFromRemote: false,
  2012→      pushedToRemote: false,
  2013→      error: "Shadow branch does not exist. Run `kspec init` instead.",
  2014→    };
  2015→  }
  2016→
  2017→  // Branch exists but worktree is broken - repair it
  2018→  const worktreeDir = path.join(projectRoot, directoryName);
  2019→
  2020→  try {
  2021→    // Remove stale worktree reference
  2022→    try {
  2023→      await runGitAsync(projectRoot, [
  2024→        "worktree",
  2025→        "remove",
  2026→        directoryName,
  2027→        "--force",
  2028→      ]);
  2029→    } catch {
  2030→      // Ignore - worktree may not be in git's list
  2031→    }
  2032→
  2033→    // Remove directory if exists (handles corrupted .git file case)
  2034→    await fs.rm(worktreeDir, { recursive: true, force: true });
  2035→
  2036→    // Prune stale worktree references (cleans up orphaned entries)
  2037→    try {
  2038→      await runGitAsync(projectRoot, ["worktree", "prune"]);
  2039→    } catch {
  2040→      // Ignore - prune is best-effort
  2041→    }
  2042→
  2043→    // Recreate worktree
  2044→    await runGitAsync(projectRoot, [
  2045→      "worktree",
  2046→      "add",
  2047→      directoryName,
  2048→      branchName,
  2049→    ]);
  2050→
  2051→    // Install pre-commit hook
  2052→    await installShadowHook(projectRoot);
  2053→
  2054→    // AC: @artifacts-directory ac-repair-recreates
  2055→    const artifactsDir = path.join(worktreeDir, "artifacts");
  2056→    await fs.mkdir(artifactsDir, { recursive: true });
  2057→
  2058→    return {
  2059→      success: true,
  2060→      branchCreated: false,
  2061→      worktreeCreated: true,
  2062→      gitignoreUpdated: false,
  2063→      initialCommit: false,
  2064→      alreadyExists: false,
  2065→      createdFromRemote: false,
  2066→      pushedToRemote: false,
  2067→    };
  2068→  } catch (error) {
  2069→    return {
  2070→      success: false,
  2071→      branchCreated: false,
  2072→      worktreeCreated: false,
  2073→      gitignoreUpdated: false,
  2074→      initialCommit: false,
  2075→      alreadyExists: false,
  2076→      createdFromRemote: false,
  2077→      pushedToRemote: false,
  2078→      error: error instanceof Error ? error.message : String(error),
  2079→    };
  2080→  }
  2081→}
  2082→
```