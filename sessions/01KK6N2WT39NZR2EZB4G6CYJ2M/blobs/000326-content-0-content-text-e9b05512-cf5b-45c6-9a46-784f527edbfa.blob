```
     1→/**
     2→ * kspec serve commands - daemon server lifecycle management
     3→ * AC: @cli-serve-commands
     4→ */
     5→
     6→import type { Command } from 'commander';
     7→import { spawn, execSync } from 'child_process';
     8→import { existsSync, readdirSync, statSync } from 'fs';
     9→import { join, dirname } from 'path';
    10→import { fileURLToPath } from 'url';
    11→import { error, info, output, success, warn, isJsonMode } from '../output.js';
    12→import { EXIT_CODES } from '../exit-codes.js';
    13→import { PidFileManager } from '../pid-utils.js';
    14→import { loadProjectConfig } from '../../parser/config.js';
    15→import { initContext } from '../../parser/yaml.js';
    16→
    17→/**
    18→ * Check if Bun runtime is available.
    19→ * Daemon requires Bun to run TypeScript directly.
    20→ */
    21→function isBunAvailable(): boolean {
    22→  try {
    23→    execSync('bun --version', { stdio: 'pipe' });
    24→    return true;
    25→  } catch {
    26→    return false;
    27→  }
    28→}
    29→
    30→const __filename = fileURLToPath(import.meta.url);
    31→const __dirname = dirname(__filename);
    32→
    33→/**
    34→ * Check if daemon dist files are stale (source newer than dist)
    35→ * Returns true if rebuild is recommended
    36→ */
    37→function checkDaemonStaleness(): boolean {
    38→  // __dirname is dist/cli/commands, go up 3 levels to package root, then into packages/daemon/src
    39→  const sourceDir = join(__dirname, '../../../packages/daemon/src');
    40→  // dist/daemon is 2 levels up from __dirname
    41→  const distDir = join(__dirname, '../../daemon');
    42→
    43→  if (!existsSync(sourceDir) || !existsSync(distDir)) return false;
    44→
    45→  try {
    46→    const getNewestMtime = (dir: string): number => {
    47→      const files = readdirSync(dir, { withFileTypes: true });
    48→      let newest = 0;
    49→      for (const f of files) {
    50→        const fullPath = join(dir, f.name);
    51→        if (f.isDirectory()) {
    52→          newest = Math.max(newest, getNewestMtime(fullPath));
    53→        } else if (f.name.endsWith('.ts')) {
    54→          newest = Math.max(newest, statSync(fullPath).mtimeMs);
    55→        }
    56→      }
    57→      return newest;
    58→    };
    59→
    60→    const newestSource = getNewestMtime(sourceDir);
    61→    const newestDist = getNewestMtime(distDir);
    62→
    63→    return newestSource > newestDist;
    64→  } catch {
    65→    return false; // Don't warn if check fails
    66→  }
    67→}
    68→
    69→/**
    70→ * Normalize daemon uptime payloads to seconds.
    71→ * Some runtimes may serialize uptime as structured objects instead of a number.
    72→ */
    73→function parseUptimeSeconds(raw: unknown): number | null {
    74→  if (typeof raw === 'number' && Number.isFinite(raw)) {
    75→    return raw;
    76→  }
    77→
    78→  if (!raw || typeof raw !== 'object') {
    79→    return null;
    80→  }
    81→
    82→  const candidate = raw as { seconds?: unknown; milliseconds?: unknown; ms?: unknown };
    83→  if (typeof candidate.seconds === 'number' && Number.isFinite(candidate.seconds)) {
    84→    return candidate.seconds;
    85→  }
    86→  if (typeof candidate.milliseconds === 'number' && Number.isFinite(candidate.milliseconds)) {
    87→    return candidate.milliseconds / 1000;
    88→  }
    89→  if (typeof candidate.ms === 'number' && Number.isFinite(candidate.ms)) {
    90→    return candidate.ms / 1000;
    91→  }
    92→
    93→  return null;
    94→}
    95→
    96→
    97→/**
    98→ * AC: @cli-serve-commands ac-11
    99→ * Refuse to modify daemon lifecycle when running inside an agent invocation.
   100→ * Agents inherit KSPEC_SESSION_ID — stopping the daemon would kill the dispatch engine.
   101→ */
   102→function guardAgentContext(action: string): void {
   103→  if (process.env.KSPEC_SESSION_ID) {
   104→    if (isJsonMode()) {
   105→      output({
   106→        error: `Cannot ${action} daemon from inside an agent invocation.`,
   107→        reason: 'Stopping or restarting the daemon would kill the dispatch engine hosting this agent.',
   108→        suggestion: 'The daemon is managed externally. Do not run kspec serve commands from agent code.',
   109→      });
   110→    } else {
   111→      error(`Cannot ${action} daemon from inside an agent invocation.`);
   112→      error('Stopping or restarting the daemon would kill the dispatch engine hosting this agent.');
   113→      error('The daemon is managed externally. Do not run kspec serve commands from agent code.');
   114→    }
   115→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   116→  }
   117→}
   118→
   119→/**
   120→ * Register serve commands
   121→ */
   122→export function registerServeCommands(program: Command): void {
   123→  const serve = program
   124→    .command('serve')
   125→    .description('Manage the kspec daemon server');
   126→
   127→  // AC: @cli-serve-commands ac-1, ac-2, ac-3
   128→  // AC: @config-daemon ac-1, ac-2 — port from config, CLI flag overrides
   129→  serve
   130→    .command('start', { isDefault: true })
   131→    .description('Start the daemon server')
   132→    .option('-d, --daemon', 'Run in background (detached mode)')
   133→    .option('-p, --port <port>', 'Server port (uses config daemon.port if not specified)')
   134→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   135→    .option('--json', 'Output as JSON')
   136→    .action(async (opts) => {
   137→      try {
   138→        await startServer(opts);
   139→      } catch (err) {
   140→        if (isJsonMode()) {
   141→          output({ error: err instanceof Error ? err.message : String(err) });
   142→        } else {
   143→          error(`Failed to start server: ${err instanceof Error ? err.message : String(err)}`);
   144→        }
   145→        process.exit(EXIT_CODES.ERROR);
   146→      }
   147→    });
   148→
   149→  // AC: @cli-serve-commands ac-4, ac-5
   150→  serve
   151→    .command('stop')
   152→    .description('Stop the daemon server')
   153→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   154→    .option('--json', 'Output as JSON')
   155→    .action(async (opts) => {
   156→      try {
   157→        await stopServer(opts);
   158→      } catch (err) {
   159→        if (isJsonMode()) {
   160→          output({ error: err instanceof Error ? err.message : String(err) });
   161→        } else {
   162→          error(`Failed to stop server: ${err instanceof Error ? err.message : String(err)}`);
   163→        }
   164→        process.exit(EXIT_CODES.ERROR);
   165→      }
   166→    });
   167→
   168→  // AC: @cli-serve-commands ac-6
   169→  serve
   170→    .command('status')
   171→    .description('Check daemon server status')
   172→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   173→    .option('--json', 'Output as JSON')
   174→    .action(async (opts) => {
   175→      try {
   176→        await statusServer(opts);
   177→      } catch (err) {
   178→        if (isJsonMode()) {
   179→          output({ error: err instanceof Error ? err.message : String(err) });
   180→        } else {
   181→          error(`Failed to check status: ${err instanceof Error ? err.message : String(err)}`);
   182→        }
   183→        process.exit(EXIT_CODES.ERROR);
   184→      }
   185→    });
   186→
   187→  // AC: @cli-serve-commands ac-7
   188→  serve
   189→    .command('restart')
   190→    .description('Restart the daemon server')
   191→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   192→    .option('--json', 'Output as JSON')
   193→    .action(async (opts) => {
   194→      try {
   195→        await restartServer(opts);
   196→      } catch (err) {
   197→        if (isJsonMode()) {
   198→          output({ error: err instanceof Error ? err.message : String(err) });
   199→        } else {
   200→          error(`Failed to restart server: ${err instanceof Error ? err.message : String(err)}`);
   201→        }
   202→        process.exit(EXIT_CODES.ERROR);
   203→      }
   204→    });
   205→}
   206→
   207→/**
   208→ * Start the daemon server
   209→ * AC: @cli-serve-commands ac-1 (foreground), ac-2 (daemon), ac-3 (port), ac-10 (port error)
   210→ * AC: @config-daemon ac-1 — port from config, ac-2 — CLI flag overrides config
   211→ */
   212→async function startServer(opts: {
   213→  daemon?: boolean;
   214→  port?: string;
   215→  kspecDir: string;
   216→}): Promise<void> {
   217→  // AC: @cli-serve-commands ac-11
   218→  guardAgentContext('start');
   219→  const jsonMode = isJsonMode();
   220→
   221→  // AC: @config-daemon ac-1, ac-2 — load config for default port, CLI flag overrides
   222→  const { config } = await loadProjectConfig();
   223→  const configPort = config.daemon.port;
   224→
   225→  // AC: @config-daemon ac-2 — CLI flag takes precedence over config
   226→  const port = opts.port ? parseInt(opts.port, 10) : configPort;
   227→
   228→  // AC: @cli-serve-commands ac-10
   229→  if (isNaN(port) || port < 1 || port > 65535) {
   230→    if (jsonMode) {
   231→      output({
   232→        error: 'Invalid port number. Must be between 1 and 65535.',
   233→        hint: 'Try: kspec serve --port <PORT>',
   234→      });
   235→    } else {
   236→      error('Invalid port number. Must be between 1 and 65535.');
   237→      error('Try: kspec serve --port <PORT>');
   238→    }
   239→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   240→  }
   241→
   242→  const pidManager = new PidFileManager();
   243→
   244→  // Check if already running
   245→  if (pidManager.isDaemonRunning()) {
   246→    const pid = pidManager.readPid();
   247→    const existingPort = pidManager.readPort();
   248→    if (isJsonMode()) {
   249→      output({ running: true, pid, port: existingPort, message: 'Daemon already running' });
   250→    } else {
   251→      warn(`Daemon already running on port ${existingPort}`);
   252→    }
   253→    process.exit(EXIT_CODES.SUCCESS);
   254→  }
   255→
   256→  // Get path to daemon entry point
   257→  // Daemon source is bundled at dist/daemon/index.ts (relative to package root)
   258→  // __dirname is dist/cli/commands, so go up 2 levels to dist/, then into daemon/
   259→  // Note: Daemon is TypeScript source - requires Bun runtime
   260→  const daemonBinary = join(__dirname, '../../daemon/index.ts');
   261→
   262→  if (!existsSync(daemonBinary)) {
   263→    if (isJsonMode()) {
   264→      output({ error: `Daemon binary not found at ${daemonBinary}`, hint: 'Ensure the kspec package is properly installed' });
   265→    } else {
   266→      error(`Daemon binary not found at: ${daemonBinary}`);
   267→      error('Ensure the kspec package is properly installed');
   268→    }
   269→    process.exit(EXIT_CODES.ERROR);
   270→  }
   271→
   272→  // AC: @web-ui ac-2 — clear error with install URL when Bun is missing
   273→  if (!isBunAvailable()) {
   274→    const installHint = process.platform === 'win32'
   275→      ? 'Install Bun: powershell -c "irm bun.sh/install.ps1 | iex"'
   276→      : 'Install Bun: curl -fsSL https://bun.sh/install | bash';
   277→    if (isJsonMode()) {
   278→      output({
   279→        error: 'Bun runtime is required for the kspec daemon',
   280→        hint: installHint,
   281→        url: 'https://bun.sh/docs/installation',
   282→      });
   283→    } else {
   284→      error('Bun runtime is required for the kspec daemon');
   285→      error('The daemon uses Elysia (a Bun-native framework) and cannot run on Node.js alone.');
   286→      info(installHint);
   287→      info('For more options: https://bun.sh/docs/installation');
   288→    }
   289→    process.exit(EXIT_CODES.ERROR);
   290→  }
   291→
   292→  // Check for stale daemon build (dev experience improvement)
   293→  if (checkDaemonStaleness() && !jsonMode) {
   294→    warn('Warning: dist/daemon/ may be stale (source files are newer).');
   295→    warn('  Run "npm run build:daemon" to update.');
   296→  }
   297→
   298→  // AC: @cli-serve-commands ac-2 - background mode
   299→  if (opts.daemon) {
   300→    const runtime = 'bun';
   301→
   302→    // Spawn detached process
   303→    // Set BUN_ENV=production to prevent Bun dev mode HTML transformation
   304→    // which can cause asset hash mismatches in the web UI
   305→    const child = spawn(runtime, [daemonBinary, '--port', String(port), '--kspec-dir', opts.kspecDir], {
   306→      detached: true,
   307→      stdio: 'ignore', // TODO: redirect to log file when logging implemented
   308→      cwd: process.cwd(),
   309→      env: { ...process.env, BUN_ENV: 'production' },
   310→    });
   311→
   312→    // Detach from parent
   313→    child.unref();
   314→
   315→    // Poll for PID file with timeout (max 5 seconds)
   316→    const maxWait = 5000;
   317→    const startTime = Date.now();
   318→    let pid: number | null = null;
   319→
   320→    while (Date.now() - startTime < maxWait) {
   321→      pid = pidManager.readPid();
   322→      if (pid && pidManager.isDaemonRunning()) {
   323→        break;
   324→      }
   325→      await new Promise(resolve => setTimeout(resolve, 100));
   326→    }
   327→
   328→    if (pid && pidManager.isDaemonRunning()) {
   329→      if (isJsonMode()) {
   330→        output({ running: true, pid, port });
   331→      } else {
   332→        success(`Daemon started with PID ${pid} on port ${port}`);
   333→        output({ running: true, pid, port });
   334→      }
   335→    } else {
   336→      if (isJsonMode()) {
   337→        output({ error: 'Daemon failed to start within 5 seconds' });
   338→      } else {
   339→        error('Daemon failed to start within 5 seconds');
   340→      }
   341→      process.exit(EXIT_CODES.ERROR);
   342→    }
   343→  } else {
   344→    // AC: @cli-serve-commands ac-1 - foreground mode
   345→    if (!isJsonMode()) {
   346→      info(`Starting server in foreground on port ${port}...`);
   347→      info('Press Ctrl+C to stop');
   348→    }
   349→
   350→    const runtime = 'bun';
   351→
   352→    // Set BUN_ENV=production to prevent Bun dev mode HTML transformation
   353→    const child = spawn(runtime, [daemonBinary, '--port', String(port), '--kspec-dir', opts.kspecDir], {
   354→      stdio: 'inherit',
   355→      cwd: process.cwd(),
   356→      env: { ...process.env, BUN_ENV: 'production' },
   357→    });
   358→
   359→    // Handle Ctrl+C - forward SIGTERM to child for graceful shutdown
   360→    process.on('SIGINT', () => {
   361→      if (!isJsonMode()) {
   362→        info('\nStopping server...');
   363→      }
   364→      child.kill('SIGTERM');
   365→
   366→      // Wait for graceful shutdown (max 5 seconds)
   367→      const shutdownTimeout = setTimeout(() => {
   368→        child.kill('SIGKILL'); // Force kill if not stopped
   369→      }, 5000);
   370→
   371→      child.on('exit', () => {
   372→        clearTimeout(shutdownTimeout);
   373→      });
   374→    });
   375→
   376→    // Wait for process to exit
   377→    child.on('exit', (code) => {
   378→      process.exit(code ?? 0);
   379→    });
   380→  }
   381→}
   382→
   383→/**
   384→ * Stop the daemon server
   385→ * AC: @cli-serve-commands ac-4 (stop), ac-5 (idempotent)
   386→ */
   387→async function stopServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {
   388→  // AC: @cli-serve-commands ac-11
   389→  guardAgentContext('stop');
   390→
   391→  const pidManager = new PidFileManager();
   392→
   393→  if (!pidManager.isDaemonRunning()) {
   394→    // AC: @cli-serve-commands ac-5
   395→    if (isJsonMode()) {
   396→      output({ running: false });
   397→    } else {
   398→      info('Daemon not running');
   399→      output({ running: false });
   400→    }
   401→    process.exit(EXIT_CODES.SUCCESS);
   402→  }
   403→
   404→  const pid = pidManager.readPid();
   405→  if (!pid) {
   406→    if (isJsonMode()) {
   407→      output({ error: 'Failed to read PID file' });
   408→    } else {
   409→      error('Failed to read PID file');
   410→    }
   411→    process.exit(EXIT_CODES.ERROR);
   412→  }
   413→
   414→  // AC: @cli-serve-commands ac-4
   415→  if (!isJsonMode()) {
   416→    info(`Stopping daemon (PID ${pid})...`);
   417→  }
   418→
   419→  try {
   420→    // Send SIGTERM
   421→    process.kill(pid, 'SIGTERM');
   422→
   423→    // Wait for clean shutdown (max 5 seconds)
   424→    const maxWait = 5000;
   425→    const startTime = Date.now();
   426→    while (Date.now() - startTime < maxWait) {
   427→      if (!pidManager.isDaemonRunning()) {
   428→        break;
   429→      }
   430→      await new Promise(resolve => setTimeout(resolve, 100));
   431→    }
   432→
   433→    if (pidManager.isDaemonRunning()) {
   434→      if (!isJsonMode()) {
   435→        warn(`Daemon did not stop gracefully, forcing...`);
   436→      }
   437→      process.kill(pid, 'SIGKILL');
   438→      await new Promise(resolve => setTimeout(resolve, 500));
   439→    }
   440→
   441→    if (isJsonMode()) {
   442→      output({ stopped: true, pid });
   443→    } else {
   444→      success('Daemon stopped');
   445→      output({ stopped: true, pid });
   446→    }
   447→  } catch (err) {
   448→    if (isJsonMode()) {
   449→      output({ error: err instanceof Error ? err.message : String(err) });
   450→    } else {
   451→      error(`Failed to stop daemon: ${err instanceof Error ? err.message : String(err)}`);
   452→    }
   453→    process.exit(EXIT_CODES.ERROR);
   454→  }
   455→}
   456→
   457→/**
   458→ * Check daemon server status
   459→ * AC: @cli-serve-commands ac-6, @multi-directory-daemon ac-12
   460→ */
   461→async function statusServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {
   462→  if (isJsonMode()) {
   463→  }
   464→
   465→  const pidManager = new PidFileManager();
   466→  const running = pidManager.isDaemonRunning();
   467→  const pid = pidManager.readPid();
   468→
   469→  // Read port from global config (AC: @multi-directory-daemon ac-13)
   470→  let port: number | null = null;
   471→  if (running) {
   472→    try {
   473→      port = pidManager.readPort();
   474→    } catch {
   475→      // Port file might not exist or be invalid
   476→      port = null;
   477→    }
   478→  }
   479→
   480→  // AC: @multi-directory-daemon ac-12 - Fetch list of registered projects and uptime
   481→  let projects: Array<{ path: string; registeredAt: string; watcherStatus: string }> = [];
   482→  let uptime: number | null = null;
   483→  if (running && port) {
   484→    try {
   485→      const response = await fetch(`http://localhost:${port}/api/projects`);
   486→      if (response.ok) {
   487→        const data = await response.json() as { projects: Array<{ path: string; registeredAt: string; watcherStatus: string }> };
   488→        projects = data.projects || [];
   489→      }
   490→    } catch {
   491→      // If daemon is not responding, continue without projects list
   492→      // This can happen if daemon is still starting up or network issues
   493→    }
   494→
   495→    // Fetch uptime from health endpoint.
   496→    // Retry briefly to reduce startup races where status is checked immediately after daemon start.
   497→    for (let attempt = 1; attempt <= 5 && uptime === null; attempt++) {
   498→      try {
   499→        const healthResponse = await fetch(`http://localhost:${port}/api/health`);
   500→        if (healthResponse.ok) {
   501→          const healthData = await healthResponse.json() as { status: string; uptime?: unknown };
   502→          const parsed = parseUptimeSeconds(healthData.uptime);
   503→          if (parsed !== null) {
   504→            uptime = parsed;
   505→            break;
   506→          }
   507→        }
   508→      } catch {
   509→        // If health endpoint fails, continue retry loop.
   510→      }
   511→
   512→      if (attempt < 5) {
   513→        await new Promise(resolve => setTimeout(resolve, 200));
   514→      }
   515→    }
   516→  }
   517→
   518→  const status = {
   519→    running,
   520→    pid: pid ?? null,
   521→    port,
   522→    uptime,
   523→    projects,
   524→  };
   525→
   526→  if (isJsonMode()) {
   527→    output(status);
   528→  } else {
   529→    if (running) {
   530→      output(`Daemon running (PID: ${pid})`);
   531→      if (port) {
   532→        output(`  Port: ${port}`);
   533→      }
   534→      // AC: @multi-directory-daemon ac-12 - Show uptime
   535→      if (uptime !== null) {
   536→        const hours = Math.floor(uptime / 3600);
   537→        const minutes = Math.floor((uptime % 3600) / 60);
   538→        const seconds = Math.floor(uptime % 60);
   539→        if (hours > 0) {
   540→          output(`  Uptime: ${hours}h ${minutes}m ${seconds}s`);
   541→        } else if (minutes > 0) {
   542→          output(`  Uptime: ${minutes}m ${seconds}s`);
   543→        } else {
   544→          output(`  Uptime: ${seconds}s`);
   545→        }
   546→      }
   547→      // AC: @multi-directory-daemon ac-12 - Show registered projects
   548→      if (projects.length > 0) {
   549→        output(`\nRegistered projects (${projects.length}):`);
   550→        for (const project of projects) {
   551→          output(`  ${project.path} (watcher: ${project.watcherStatus})`);
   552→        }
   553→      } else {
   554→        output(`\nNo projects registered`);
   555→      }
   556→    } else {
   557→      output('Daemon not running');
   558→    }
   559→  }
   560→}
   561→
   562→/**
   563→ * Restart the daemon server
   564→ * AC: @cli-serve-commands ac-7
   565→ */
   566→async function restartServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {
   567→  // AC: @cli-serve-commands ac-11
   568→  guardAgentContext('restart');
   569→  const pidManager = new PidFileManager();
   570→
   571→  // AC: @cli-serve-commands ac-7 - preserve port across restarts
   572→  // Try to read port from existing daemon, otherwise startServer will use config default
   573→  let port: string | undefined;
   574→  try {
   575→    port = pidManager.readPort().toString();
   576→  } catch {
   577→    // Port file doesn't exist or is invalid, let startServer use config
   578→  }
   579→
   580→  if (pidManager.isDaemonRunning()) {
   581→    if (!isJsonMode()) {
   582→      info('Stopping daemon...');
   583→    }
   584→    await stopServer(opts);
   585→  }
   586→
   587→  if (!isJsonMode()) {
   588→    info('Starting daemon...');
   589→  }
   590→  await startServer({ daemon: true, port, kspecDir: opts.kspecDir });
   591→}
