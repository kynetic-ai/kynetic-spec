```
     1→<!--
     2→  AC: @ui-task-board ac-3 — Task detail modal with full task info.
     3→  AC: @ui-task-board ac-6 — Action buttons: Start, Submit, Complete, Block, Add Note.
     4→  AC: @gh-pages-export ac-16 — Buttons disabled with tooltip in static mode.
     5→-->
     6→<script lang="ts">
     7→	import type { TaskDetail } from '@kynetic-ai/shared';
     8→	import {
     9→		fetchTask,
    10→		startTask,
    11→		submitTask,
    12→		completeTask,
    13→		blockTask,
    14→		addTaskNote
    15→	} from '$lib/api';
    16→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    17→	import * as Dialog from '$lib/components/ui/dialog';
    18→	import { Badge } from '$lib/components/ui/badge';
    19→	import { Button } from '$lib/components/ui/button';
    20→	import { Textarea } from '$lib/components/ui/textarea';
    21→	import { Input } from '$lib/components/ui/input';
    22→	import { Separator } from '$lib/components/ui/separator';
    23→	import { Skeleton } from '$lib/components/ui/skeleton';
    24→	import ReferenceLink from '$lib/components/ReferenceLink.svelte';
    25→	import * as Tooltip from '$lib/components/ui/tooltip';
    26→	import { getStatusClasses, formatAge, formatVcsRef } from './board-utils';
    27→	import GitBranch from '@lucide/svelte/icons/git-branch';
    28→	import ExternalLink from '@lucide/svelte/icons/external-link';
    29→
    30→	let {
    31→		open = $bindable(false),
    32→		taskRef = $bindable<string | null>(null),
    33→		onTaskUpdated
    34→	}: {
    35→		open?: boolean;
    36→		taskRef?: string | null;
    37→		onTaskUpdated?: () => void;
    38→	} = $props();
    39→
    40→	let task = $state<TaskDetail | null>(null);
    41→	let loading = $state(false);
    42→	let error = $state('');
    43→	let actionError = $state('');
    44→	let isSubmitting = $state(false);
    45→
    46→	// Note form
    47→	let noteContent = $state('');
    48→
    49→	// Block/Complete reason form
    50→	let reasonInput = $state('');
    51→	let showReasonFor = $state<'block' | 'complete' | null>(null);
    52→
    53→	$effect(() => {
    54→		if (open && taskRef) {
    55→			loadTask(taskRef);
    56→		} else if (!open) {
    57→			task = null;
    58→			error = '';
    59→			actionError = '';
    60→			noteContent = '';
    61→			reasonInput = '';
    62→			showReasonFor = null;
    63→		}
    64→	});
    65→
    66→	async function loadTask(ref: string) {
    67→		loading = true;
    68→		error = '';
    69→		try {
    70→			task = await fetchTask(ref);
    71→		} catch (err) {
    72→			error = err instanceof Error ? err.message : 'Failed to load task';
    73→		} finally {
    74→			loading = false;
    75→		}
    76→	}
    77→
    78→	async function reloadAndNotify() {
    79→		if (task) {
    80→			task = await fetchTask(task._ulid);
    81→		}
    82→		onTaskUpdated?.();
    83→	}
    84→
    85→	async function handleAction(action: () => Promise<void>) {
    86→		isSubmitting = true;
    87→		actionError = '';
    88→		try {
    89→			await action();
    90→			await reloadAndNotify();
    91→		} catch (err) {
    92→			if (err instanceof ReadOnlyModeError) {
    93→				actionError = err.message;
    94→			} else {
    95→				actionError = err instanceof Error ? err.message : 'Action failed';
    96→			}
    97→		} finally {
    98→			isSubmitting = false;
    99→		}
   100→	}
   101→
   102→	function handleStart() {
   103→		if (!task) return;
   104→		handleAction(() => startTask(task!._ulid));
   105→	}
   106→
   107→	function handleSubmit() {
   108→		if (!task) return;
   109→		handleAction(() => submitTask(task!._ulid));
   110→	}
   111→
   112→	function handleComplete() {
   113→		if (!task || !reasonInput.trim()) return;
   114→		const reason = reasonInput.trim();
   115→		handleAction(async () => {
   116→			await completeTask(task!._ulid, reason);
   117→			reasonInput = '';
   118→			showReasonFor = null;
   119→		});
   120→	}
   121→
   122→	function handleBlock() {
   123→		if (!task || !reasonInput.trim()) return;
   124→		const reason = reasonInput.trim();
   125→		handleAction(async () => {
   126→			await blockTask(task!._ulid, reason);
   127→			reasonInput = '';
   128→			showReasonFor = null;
   129→		});
   130→	}
   131→
   132→	function handleAddNote() {
   133→		if (!task || !noteContent.trim()) return;
   134→		const content = noteContent.trim();
   135→		handleAction(async () => {
   136→			await addTaskNote(task!._ulid, content);
   137→			noteContent = '';
   138→		});
   139→	}
   140→
   141→	function formatDate(dateStr: string): string {
   142→		return new Intl.DateTimeFormat('en-US', {
   143→			month: 'short',
   144→			day: 'numeric',
   145→			hour: '2-digit',
   146→			minute: '2-digit'
   147→		}).format(new Date(dateStr));
   148→	}
   149→
   150→	let statusInfo = $derived(task ? getStatusClasses(task.status) : null);
   151→	let slug = $derived(task?.slugs?.[0] ?? task?._ulid?.slice(0, 8) ?? '');
   152→	let readOnly = $derived(isStaticMode());
   153→</script>
   154→
   155→<Dialog.Root bind:open>
   156→	<Dialog.Content class="max-w-2xl max-h-[85vh] overflow-y-auto" data-testid="task-detail-modal">
   157→		{#if loading}
   158→			<div class="flex flex-col gap-4 py-4" data-testid="task-detail-skeleton">
   159→				<!-- Title skeleton -->
   160→				<Skeleton class="h-6 w-3/4 ds-shimmer" />
   161→				<Skeleton class="h-3 w-24 ds-shimmer" />
   162→
   163→				<!-- Status/priority badges skeleton -->
   164→				<div class="flex gap-2">
   165→					<Skeleton class="h-5 w-20 rounded-full ds-shimmer" />
   166→					<Skeleton class="h-5 w-24 rounded-full ds-shimmer" />
   167→				</div>
   168→
   169→				<!-- Spec ref skeleton -->
   170→				<div>
   171→					<Skeleton class="h-3 w-10 mb-1 ds-shimmer" />
   172→					<Skeleton class="h-4 w-32 ds-shimmer" />
   173→				</div>
   174→
   175→				<!-- Tags skeleton -->
   176→				<div class="flex gap-1">
   177→					<Skeleton class="h-5 w-12 rounded-full ds-shimmer" />
   178→					<Skeleton class="h-5 w-16 rounded-full ds-shimmer" />
   179→				</div>
   180→
   181→				<!-- Separator -->
   182→				<Skeleton class="h-px w-full ds-shimmer" />
   183→
   184→				<!-- Notes skeleton -->
   185→				<div>
   186→					<Skeleton class="h-3 w-16 mb-2 ds-shimmer" />
   187→					<Skeleton class="h-16 w-full rounded-md ds-shimmer" />
   188→				</div>
   189→			</div>
   190→		{:else if error}
   191→			<div class="bg-destructive/10 text-destructive p-4 rounded-lg" role="alert">
   192→				{error}
   193→			</div>
   194→		{:else if task && statusInfo}
   195→			<Dialog.Header>
   196→				<Dialog.Title data-testid="modal-task-title">{task.title}</Dialog.Title>
   197→				<Dialog.Description>
   198→					<span class="font-mono text-xs">@{slug}</span>
   199→				</Dialog.Description>
   200→			</Dialog.Header>
   201→
   202→			<div class="flex flex-col gap-4">
   203→				<!-- AC: @ui-task-board ac-3 — Description -->
   204→				{#if task.description}
   205→					<p class="text-sm text-muted-foreground" data-testid="modal-description">
   206→						{task.description}
   207→					</p>
   208→				{/if}
   209→
   210→				<!-- Status, priority, type -->
   211→				<div class="flex flex-wrap gap-2 items-center">
   212→					<Badge class="{statusInfo.bg} {statusInfo.fg}" data-testid="modal-status-badge">
   213→						{statusInfo.label}
   214→					</Badge>
   215→					<Badge variant="outline" data-testid="modal-priority">Priority {task.priority}</Badge>
   216→					<Badge variant="outline" data-testid="modal-type">{task.type}</Badge>
   217→					{#if task.automation}
   218→						<Badge variant="secondary" data-testid="modal-automation">
   219→							{task.automation}
   220→						</Badge>
   221→					{/if}
   222→				</div>
   223→
   224→				<!-- Spec ref -->
   225→				{#if task.spec_ref}
   226→					<div data-testid="modal-spec-ref">
   227→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Spec</p>
   228→						<ReferenceLink ref={task.spec_ref} type="spec" />
   229→					</div>
   230→				{/if}
   231→
   232→				<!-- Tags -->
   233→				{#if task.tags?.length > 0}
   234→					<div data-testid="modal-tags">
   235→						<p class="text-xs font-medium text-muted-foreground mb-1">Tags</p>
   236→						<div class="flex flex-wrap gap-1">
   237→							{#each task.tags as tag}
   238→								<Badge variant="secondary">{tag}</Badge>
   239→							{/each}
   240→						</div>
   241→					</div>
   242→				{/if}
   243→
   244→				<!-- Dependencies -->
   245→				{#if task.depends_on?.length > 0}
   246→					<div data-testid="modal-dependencies">
   247→						<p class="text-xs font-medium text-muted-foreground mb-1">Dependencies</p>
   248→						<ul class="text-sm space-y-0.5">
   249→							{#each task.depends_on as dep}
   250→								<li>
   251→									<ReferenceLink ref={dep} type="task" class="text-xs" />
   252→								</li>
   253→							{/each}
   254→						</ul>
   255→					</div>
   256→				{/if}
   257→
   258→				<!-- Blocked by -->
   259→				{#if task.blocked_by?.length > 0}
   260→					<div data-testid="modal-blocked-by">
   261→						<p class="text-xs font-medium text-destructive mb-1">Blocked By</p>
   262→						<ul class="text-sm space-y-0.5">
   263→							{#each task.blocked_by as blocker}
   264→								<li>
   265→									<ReferenceLink ref={blocker} type="task" class="text-xs" />
   266→								</li>
   267→							{/each}
   268→						</ul>
   269→					</div>
   270→				{/if}
   271→
   272→				<!-- AC: @ui-task-board ac-3 — VCS info (branch, PR link) -->
   273→				{#if task.vcs_refs?.length > 0}
   274→					<div data-testid="modal-vcs">
   275→						<p class="text-xs font-medium text-muted-foreground mb-1">VCS</p>
   276→						<ul class="text-sm space-y-1">
   277→							{#each task.vcs_refs as ref}
   278→								{@const vcsInfo = formatVcsRef(ref)}
   279→								<li class="flex items-center gap-1.5">
   280→									<GitBranch class="size-3 text-muted-foreground flex-shrink-0" />
   281→									{#if vcsInfo.url}
   282→										<a
   283→											href={vcsInfo.url}
   284→											target="_blank"
   285→											rel="noopener noreferrer"
   286→											class="text-xs text-primary hover:underline font-mono inline-flex items-center gap-1"
   287→										>
   288→											{vcsInfo.label}
   289→											<ExternalLink class="size-3" />
   290→										</a>
   291→									{:else}
   292→										<span class="text-muted-foreground font-mono text-xs">{vcsInfo.label}</span>
   293→									{/if}
   294→								</li>
   295→							{/each}
   296→						</ul>
   297→					</div>
   298→				{/if}
   299→
   300→				<!-- AC: @ui-task-board ac-3 — Plan ref -->
   301→				{#if task.plan_ref}
   302→					<div data-testid="modal-plan-ref">
   303→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Plan</p>
   304→						<ReferenceLink ref={task.plan_ref} type="plan" />
   305→					</div>
   306→				{:else if task.derivation}
   307→					<div data-testid="modal-plan-ref">
   308→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Derivation</p>
   309→						<p class="text-sm text-muted-foreground">{task.derivation}</p>
   310→					</div>
   311→				{/if}
   312→
   313→				<!-- AC: @ui-task-board ac-3 — Session link -->
   314→				{#if task.session_ref}
   315→					<div data-testid="modal-session-link">
   316→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Session</p>
   317→						<ReferenceLink ref={task.session_ref} type="session" />
   318→					</div>
   319→				{/if}
   320→
   321→				<Separator />
   322→
   323→				<!-- AC: @ui-task-board ac-6 — Actions -->
   324→				<!-- AC: @gh-pages-export ac-16 — Buttons disabled with tooltip in static mode -->
   325→				<div class="flex flex-wrap gap-2" data-testid="modal-actions">
   326→					{#if task.status === 'pending'}
   327→						{#if readOnly}
   328→							<Tooltip.Root>
   329→								<Tooltip.Trigger>
   330→									{#snippet child({ props })}
   331→										<Button
   332→											{...props}
   333→											size="sm"
   334→											disabled={true}
   335→											data-testid="action-start"
   336→										>
   337→											Start
   338→										</Button>
   339→									{/snippet}
   340→								</Tooltip.Trigger>
   341→								<Tooltip.Content>
   342→									<p>Read-only mode — use CLI to start task</p>
   343→								</Tooltip.Content>
   344→							</Tooltip.Root>
   345→						{:else}
   346→							<Button
   347→								size="sm"
   348→								onclick={handleStart}
   349→								disabled={isSubmitting}
   350→								data-testid="action-start"
   351→							>
   352→								{isSubmitting ? 'Starting...' : 'Start'}
   353→							</Button>
   354→						{/if}
   355→					{/if}
   356→
   357→					{#if task.status === 'in_progress' || task.status === 'needs_work'}
   358→						{#if readOnly}
   359→							<Tooltip.Root>
   360→								<Tooltip.Trigger>
   361→									{#snippet child({ props })}
   362→										<Button
   363→											{...props}
   364→											size="sm"
   365→											disabled={true}
   366→											data-testid="action-submit"
   367→										>
   368→											Submit for Review
   369→										</Button>
   370→									{/snippet}
   371→								</Tooltip.Trigger>
   372→								<Tooltip.Content>
   373→									<p>Read-only mode — use CLI to submit task</p>
   374→								</Tooltip.Content>
   375→							</Tooltip.Root>
   376→						{:else}
   377→							<Button
   378→								size="sm"
   379→								onclick={handleSubmit}
   380→								disabled={isSubmitting}
   381→								data-testid="action-submit"
   382→							>
   383→								{isSubmitting ? 'Submitting...' : 'Submit for Review'}
   384→							</Button>
   385→						{/if}
   386→					{/if}
   387→
   388→					{#if task.status === 'in_progress' || task.status === 'pending_review'}
   389→						{#if readOnly}
   390→							<Tooltip.Root>
   391→								<Tooltip.Trigger>
   392→									{#snippet child({ props })}
   393→										<Button
   394→											{...props}
   395→											size="sm"
   396→											variant="outline"
   397→											disabled={true}
   398→											data-testid="action-complete-toggle"
   399→										>
   400→											Complete
   401→										</Button>
   402→									{/snippet}
   403→								</Tooltip.Trigger>
   404→								<Tooltip.Content>
   405→									<p>Read-only mode — use CLI to complete task</p>
   406→								</Tooltip.Content>
   407→							</Tooltip.Root>
   408→						{:else}
   409→							<Button
   410→								size="sm"
   411→								variant="outline"
   412→								onclick={() => {
   413→									showReasonFor = 'complete';
   414→									reasonInput = '';
   415→								}}
   416→								disabled={isSubmitting}
   417→								data-testid="action-complete-toggle"
   418→							>
   419→								Complete
   420→							</Button>
   421→						{/if}
   422→					{/if}
   423→
   424→					{#if task.status !== 'blocked' && task.status !== 'completed' && task.status !== 'cancelled'}
   425→						{#if readOnly}
   426→							<Tooltip.Root>
   427→								<Tooltip.Trigger>
   428→									{#snippet child({ props })}
   429→										<Button
   430→											{...props}
   431→											size="sm"
   432→											variant="destructive"
   433→											disabled={true}
   434→											data-testid="action-block-toggle"
   435→										>
   436→											Block
   437→										</Button>
   438→									{/snippet}
   439→								</Tooltip.Trigger>
   440→								<Tooltip.Content>
   441→									<p>Read-only mode — use CLI to block task</p>
   442→								</Tooltip.Content>
   443→							</Tooltip.Root>
   444→						{:else}
   445→							<Button
   446→								size="sm"
   447→								variant="destructive"
   448→								onclick={() => {
   449→									showReasonFor = 'block';
   450→									reasonInput = '';
   451→								}}
   452→								disabled={isSubmitting}
   453→								data-testid="action-block-toggle"
   454→							>
   455→								Block
   456→							</Button>
   457→						{/if}
   458→					{/if}
   459→				</div>
   460→
   461→				<!-- Reason input for block/complete (only in daemon mode) -->
   462→				{#if !readOnly && showReasonFor}
   463→					<div class="flex gap-2" data-testid="reason-input">
   464→						<Input
   465→							bind:value={reasonInput}
   466→							placeholder="{showReasonFor === 'block' ? 'Block' : 'Completion'} reason..."
   467→							class="flex-1"
   468→						/>
   469→						<Button
   470→							size="sm"
   471→							onclick={showReasonFor === 'block' ? handleBlock : handleComplete}
   472→							disabled={isSubmitting || !reasonInput.trim()}
   473→						>
   474→							Confirm
   475→						</Button>
   476→						<Button
   477→							size="sm"
   478→							variant="ghost"
   479→							onclick={() => {
   480→								showReasonFor = null;
   481→								reasonInput = '';
   482→							}}
   483→						>
   484→							Cancel
   485→						</Button>
   486→					</div>
   487→				{/if}
   488→
   489→				{#if actionError}
   490→					<p class="text-sm text-destructive" data-testid="action-error">{actionError}</p>
   491→				{/if}
   492→
   493→				<Separator />
   494→
   495→				<!-- Todos -->
   496→				{#if task.todos && task.todos.length > 0}
   497→					<div data-testid="modal-todos">
   498→						<p class="text-xs font-medium text-muted-foreground mb-1">
   499→							Todos ({task.todos.length})
   500→						</p>
   501→						<ul class="space-y-1">
   502→							{#each task.todos as todo}
   503→								<li class="flex items-start gap-2 text-sm">
   504→									<span class="mt-0.5 text-xs">
   505→										{#if todo.done}
   506→											&#x2705;
   507→										{:else}
   508→											&#x23F8;&#xFE0F;
   509→										{/if}
   510→									</span>
   511→									<span class:line-through={todo.done}>
   512→										{todo.text}
   513→									</span>
   514→								</li>
   515→							{/each}
   516→						</ul>
   517→					</div>
   518→					<Separator />
   519→				{/if}
   520→
   521→				<!-- Notes -->
   522→				<div data-testid="modal-notes">
   523→					<p class="text-xs font-medium text-muted-foreground mb-2">
   524→						Notes ({task.notes?.length ?? 0})
   525→					</p>
   526→
   527→					<!-- Add Note form -->
   528→					<!-- AC: @gh-pages-export ac-17 — Note form disabled in static mode -->
   529→					{#if readOnly}
   530→						<div class="mb-3 space-y-2" data-testid="modal-add-note">
   531→							<Textarea
   532→								placeholder="Add a note..."
   533→								disabled={true}
   534→								rows={2}
   535→							/>
   536→							<Tooltip.Root>
   537→								<Tooltip.Trigger>
   538→									{#snippet child({ props })}
   539→										<Button
   540→											{...props}
   541→											size="sm"
   542→											disabled={true}
   543→											data-testid="action-add-note"
   544→										>
   545→											Add Note
   546→										</Button>
   547→									{/snippet}
   548→								</Tooltip.Trigger>
   549→								<Tooltip.Content>
   550→									<p>Read-only mode — use CLI to add notes</p>
   551→								</Tooltip.Content>
   552→							</Tooltip.Root>
   553→						</div>
   554→					{:else}
   555→						<div class="mb-3 space-y-2" data-testid="modal-add-note">
   556→							<Textarea
   557→								placeholder="Add a note..."
   558→								bind:value={noteContent}
   559→								disabled={isSubmitting}
   560→								rows={2}
   561→							/>
   562→							<Button
   563→								size="sm"
   564→								onclick={handleAddNote}
   565→								disabled={isSubmitting || !noteContent.trim()}
   566→								data-testid="action-add-note"
   567→							>
   568→								{isSubmitting ? 'Adding...' : 'Add Note'}
   569→							</Button>
   570→						</div>
   571→					{/if}
   572→
   573→					<!-- Notes list -->
   574→					<div class="space-y-3">
   575→						{#if (task.notes ?? []).length === 0}
   576→							<div class="text-center py-4 text-muted-foreground text-xs" data-testid="notes-empty">
   577→								{#if readOnly}
   578→									No notes recorded. Use <code class="bg-muted px-1 rounded">kspec task note</code> to add context.
   579→								{:else}
   580→									Add a note above to document decisions, progress, or findings.
   581→								{/if}
   582→							</div>
   583→						{:else}
   584→							{#each task.notes ?? [] as note}
   585→								<div class="border rounded-md p-2.5" data-testid="note-item">
   586→									<div class="flex justify-between items-start mb-1">
   587→										<span class="text-[10px] text-muted-foreground">{note.author}</span>
   588→										<span class="text-[10px] text-muted-foreground">{formatDate(note.created_at)}</span>
   589→									</div>
   590→									<p class="text-sm whitespace-pre-wrap">{note.content}</p>
   591→								</div>
   592→							{/each}
   593→						{/if}
   594→					</div>
   595→				</div>
   596→			</div>
   597→		{/if}
   598→	</Dialog.Content>
   599→</Dialog.Root>
   600→
```