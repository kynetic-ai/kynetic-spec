   579→
   580→    // Helper to set up a bare repo as remote
   581→    async function setupBareRemote(): Promise<void> {
   582→      await fs.mkdir(remoteDir, { recursive: true });
   583→      execSync('git init --bare', { cwd: remoteDir, stdio: 'pipe' });
   584→    }
   585→
   586→    // Helper to set up a local repo with remote
   587→    async function setupLocalWithRemote(): Promise<void> {
   588→      execSync('git init -b main', { cwd: testDir, stdio: 'pipe' });
   589→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
