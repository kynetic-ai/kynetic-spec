   502→
   503→    // AC: @shadow-recovery ac-recovery-4 - Healthy → repair succeeds without changes (idempotent)
   504→    it('succeeds without changes when already healthy', async () => {
   505→      await setupHealthyShadow();
   506→
   507→      const result = await repairShadow(testDir);
