   757→    // AC: @shadow-init-remote ac-4 - Queries remote refs directly (ls-remote)
   758→    it('detects remote branch without relying on locally-fetched refs', async () => {
   759→      await setupBareRemote();
   760→      await setupLocalWithRemote();
   761→
   762→      // Initialize in first repo, push shadow
   763→      await initializeShadow(testDir);
   764→      await pushShadowToRemote();
   765→
   766→      // Create clone — remote refs for kspec-meta won't be local yet
   767→      const cloneDir = path.join('/tmp', `kspec-clone-test-${Date.now()}`);
   768→      try {
   769→        execSync(`git clone ${remoteDir} ${cloneDir}`, { stdio: 'pipe' });
   770→        execSync('git config user.email "test@test.com"', { cwd: cloneDir, stdio: 'pipe' });
   771→        execSync('git config user.name "Test"', { cwd: cloneDir, stdio: 'pipe' });
   772→
   773→        // Verify kspec-meta is not in local remote refs before init
   774→        const hasLocalRef = (() => {
   775→          try {
   776→            execSync(`git show-ref --verify refs/remotes/origin/${SHADOW_BRANCH_NAME}`, {
   777→              cwd: cloneDir,
   778→              stdio: ['pipe', 'pipe', 'pipe'],
   779→            });
   780→            return true;
   781→          } catch {
   782→            return false;
   783→          }
   784→        })();
   785→
   786→        // Init should detect remote branch via ls-remote (direct remote query)
   787→        // regardless of whether local refs exist
   788→        const result = await initializeShadow(cloneDir);
   789→
   790→        expect(result.success).toBe(true);
   791→        expect(result.createdFromRemote).toBe(true);
   792→
   793→        // ls-remote works even when local refs are absent
   794→        // (in full clones they may exist from clone, but this proves
   795→        // init doesn't depend on them)
   796→        expect(await remoteBranchExists(cloneDir, SHADOW_BRANCH_NAME)).toBe(true);
   797→      } finally {
   798→        await fs.rm(cloneDir, { recursive: true, force: true });
   799→      }
   800→    });
   801→  });
