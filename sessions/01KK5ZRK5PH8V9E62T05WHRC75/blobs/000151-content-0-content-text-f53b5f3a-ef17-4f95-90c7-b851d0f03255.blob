    78→      const result = await detectShadow(testDir);
    79→      expect(result).toBeNull();
    80→    });
    81→
    82→    it('returns null for git repo without .kspec', async () => {
    83→      // Initialize a git repo
    84→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
    85→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
    86→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
    87→
    88→      const result = await detectShadow(testDir);
    89→      expect(result).toBeNull();
    90→    });
    91→  });
    92→
    93→  describe('getShadowStatus', () => {
