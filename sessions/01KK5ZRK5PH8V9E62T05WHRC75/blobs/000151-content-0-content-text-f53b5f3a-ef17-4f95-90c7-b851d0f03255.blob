  1533→        expect(shadow?.worktreeDir).toBe(path.join(testDir, SHADOW_WORKTREE_DIR));
  1534→      });
  1535→
  1536→      it('getShadowStatus uses defaults when no options provided', async () => {
  1537→        // Initialize git repo
