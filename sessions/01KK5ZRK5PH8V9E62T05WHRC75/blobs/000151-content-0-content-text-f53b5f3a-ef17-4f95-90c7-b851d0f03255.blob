  1552→
  1553→      it('getShadowStatus reports healthy with directory name, not full path', async () => {
  1554→        // Regression: daemon was passing the full worktreeDir path (e.g. /tmp/x/.kspec)
  1555→        // as the directory option instead of the directory name (e.g. .kspec).
  1556→        // getShadowStatus joins projectRoot + directory, so a full path produced an
  1557→        // invalid path like /tmp/x//tmp/x/.kspec, causing a false unhealthy report.
  1558→        execSync('git init', { cwd: testDir, stdio: 'pipe' });
  1559→        execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
  1560→        execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
  1561→        await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
  1562→        execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
  1563→
  1564→        await initializeShadow(testDir);
  1565→
  1566→        // Directory name (correct) — should be healthy
  1567→        const statusWithName = await getShadowStatus(testDir, {
  1568→          directory: SHADOW_WORKTREE_DIR,
  1569→        });
  1570→        expect(statusWithName.healthy).toBe(true);
  1571→
  1572→        // Full path (bug) — should NOT be healthy because path.join produces garbage
  1573→        const fullPath = path.join(testDir, SHADOW_WORKTREE_DIR);
  1574→        const statusWithFullPath = await getShadowStatus(testDir, {
  1575→          directory: fullPath,
  1576→        });
  1577→        expect(statusWithFullPath.healthy).toBe(false);
  1578→      });
  1579→    });
