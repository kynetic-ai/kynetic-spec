   591→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   592→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   593→      execSync(`git remote add origin ${remoteDir}`, { cwd: testDir, stdio: 'pipe' });
   594→      execSync('git push -u origin main', { cwd: testDir, stdio: 'pipe' });
   595→    }
   596→
   597→    // Helper to push shadow branch to remote
   598→    async function pushShadowToRemote(): Promise<void> {
   599→      execSync(`git -C ${testDir}/.kspec push -u origin ${SHADOW_BRANCH_NAME}`, { stdio: 'pipe' });
   600→    }
   601→
   602→    it('hasRemote returns false when no remote configured', async () => {
