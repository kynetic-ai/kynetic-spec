  1377→  // Shadow hook installation and authorization tests
  1378→  // AC: @package-distribution ac-4 - pre-commit hook source included in package
  1379→  describe('installShadowHook', () => {
  1380→    it('installs pre-commit hook during shadow initialization', async () => {
  1381→      // The pre-commit hook is now loaded from the package templates directory
  1382→      // (templates/hooks/pre-commit), not from the project root.
  1383→      // This test verifies that the hook from the package gets installed.
  1384→
  1385→      // Initialize git repo with initial commit
  1386→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
  1387→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
  1388→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
  1389→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
  1390→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
  1391→
  1392→      // Initialize shadow - should install hook from package templates
  1393→      const result = await initializeShadow(testDir);
  1394→      expect(result.success).toBe(true);
  1395→
  1396→      // Verify hook was installed to .git/hooks/pre-commit
  1397→      const installedHookPath = path.join(testDir, '.git', 'hooks', 'pre-commit');
  1398→      try {
  1399→        const hookContent = await fs.readFile(installedHookPath, 'utf-8');
  1400→        // Hook should contain the kspec-meta branch protection logic
  1401→        expect(hookContent).toContain('kspec-meta branch protection');
  1402→        expect(hookContent).toContain('KSPEC_SHADOW_COMMIT');
  1403→
  1404→        // Verify hook is executable
  1405→        const stats = await fs.stat(installedHookPath);
  1406→        expect(stats.mode & 0o111).toBeGreaterThan(0); // At least one execute bit set
  1407→      } catch (err) {
  1408→        expect.fail(`Hook should be installed at ${installedHookPath}: ${err}`);
  1409→      }
  1410→    });
  1411→
  1412→    it('blocks unauthorized commits to shadow branch', async () => {
  1413→      // The pre-commit hook is now loaded from the package templates directory.
  1414→      // This test verifies the hook blocks unauthorized commits to the shadow branch.
  1415→
  1416→      // Initialize git repo
  1417→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
  1418→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
  1419→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
  1420→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
  1421→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
  1422→
  1423→      // Initialize shadow
  1424→      await initializeShadow(testDir);
  1425→
  1426→      // Try to commit to shadow branch WITHOUT authorization
  1427→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
  1428→      await fs.writeFile(path.join(worktreeDir, 'test.yaml'), 'test: unauthorized');
  1429→      execSync('git add -A', { cwd: worktreeDir, stdio: 'pipe' });
  1430→
  1431→      // Attempt commit without KSPEC_SHADOW_COMMIT - should fail
  1432→      try {
  1433→        execSync('git commit -m "unauthorized commit"', {
  1434→          cwd: worktreeDir,
  1435→          stdio: 'pipe',
  1436→        });
  1437→        expect.fail('Commit should have been blocked by pre-commit hook');
  1438→      } catch (err: any) {
  1439→        // Hook should have blocked the commit
  1440→        expect(err.status).toBe(1);
  1441→      }
  1442→
  1443→      // Verify no commit was created (still at initial shadow commit)
  1444→      // Note: In local dev with kspec in PATH, there may be 2 commits (initial + merge driver config)
  1445→      // In CI without kspec, there will be 1 commit (initial only)
  1446→      const logOutput = execSync('git log --oneline', {
  1447→        cwd: worktreeDir,
  1448→        encoding: 'utf-8',
  1449→      });
  1450→      const commitCount = logOutput.trim().split('\n').length;
  1451→      expect(commitCount).toBeGreaterThanOrEqual(1); // At least the initial commit
  1452→      expect(commitCount).toBeLessThanOrEqual(2); // At most initial + merge driver config
  1453→    });
  1454→
  1455→    it('allows commits with KSPEC_SHADOW_COMMIT=1 env var', async () => {
  1456→      // Setup with real kspec pre-commit hook
  1457→      const realHookPath = path.resolve(__dirname, '../hooks/pre-commit');
  1458→      const hooksSourceDir = path.join(testDir, 'hooks');
  1459→      const sourceHookPath = path.join(hooksSourceDir, 'pre-commit');
  1460→
  1461→      await fs.mkdir(hooksSourceDir, { recursive: true });
  1462→      const realHookContent = await fs.readFile(realHookPath, 'utf-8');
  1463→      await fs.writeFile(sourceHookPath, realHookContent, { mode: 0o755 });
  1464→
  1465→      // Initialize git repo
  1466→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
  1467→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
  1468→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
  1469→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
  1470→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
  1471→
  1472→      // Initialize shadow
  1473→      await initializeShadow(testDir);
  1474→
  1475→      // Try to commit WITH authorization
  1476→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
  1477→      await fs.writeFile(path.join(worktreeDir, 'test.yaml'), 'test: authorized');
  1478→      execSync('git add -A', { cwd: worktreeDir, stdio: 'pipe' });
  1479→
  1480→      // Commit with KSPEC_SHADOW_COMMIT=1 - should succeed
  1481→      execSync('git commit -m "authorized commit"', {
  1482→        cwd: worktreeDir,
  1483→        stdio: 'pipe',
  1484→        env: { ...process.env, KSPEC_SHADOW_COMMIT: '1' },
  1485→      });
  1486→
  1487→      // Verify commit was created
  1488→      // Note: In local dev with kspec in PATH, there will be 3 commits (initial + merge driver config + authorized)
  1489→      // In CI without kspec, there will be 2 commits (initial + authorized)
  1490→      const logOutput = execSync('git log --oneline', {
  1491→        cwd: worktreeDir,
  1492→        encoding: 'utf-8',
  1493→      });
  1494→      const commitCount = logOutput.trim().split('\n').length;
  1495→      expect(commitCount).toBeGreaterThanOrEqual(2); // At least initial + authorized
  1496→      expect(commitCount).toBeLessThanOrEqual(3); // At most initial + merge driver config + authorized
  1497→
  1498→      // Verify commit message
  1499→      const latestCommit = execSync('git log -1 --pretty=%B', {
  1500→        cwd: worktreeDir,
  1501→        encoding: 'utf-8',
  1502→      }).trim();
  1503→      expect(latestCommit).toBe('authorized commit');
  1504→    });
  1505→  });
