   711→    // AC: @shadow-init-remote ac-5 - Works in shallow clones
   712→    it('attaches to existing remote shadow branch from shallow clone', async () => {
   713→      await setupBareRemote();
   714→      await setupLocalWithRemote();
   715→
   716→      // Initialize shadow in first repo and push
   717→      await initializeShadow(testDir);
   718→      await pushShadowToRemote();
   719→
   720→      // Shallow clone — only gets default branch, no kspec-meta refs
   721→      // Use file:// protocol so --depth is respected (ignored for local path clones)
   722→      const cloneDir = path.join('/tmp', `kspec-shallow-test-${Date.now()}`);
   723→      try {
   724→        execSync(`git clone --depth 1 file://${remoteDir} ${cloneDir}`, { stdio: 'pipe' });
   725→        execSync('git config user.email "test@test.com"', { cwd: cloneDir, stdio: 'pipe' });
   726→        execSync('git config user.name "Test"', { cwd: cloneDir, stdio: 'pipe' });
   727→
   728→        // Verify kspec-meta is NOT in local refs (shallow clone doesn't have it)
   729→        try {
   730→          execSync(`git show-ref --verify refs/remotes/origin/${SHADOW_BRANCH_NAME}`, {
   731→            cwd: cloneDir,
   732→            stdio: ['pipe', 'pipe', 'pipe'],
   733→          });
   734→          throw new Error('Expected show-ref to fail in shallow clone');
   735→        } catch (err: unknown) {
   736→          // Expected — the ref doesn't exist locally
   737→          if (err instanceof Error && err.message === 'Expected show-ref to fail in shallow clone') {
   738→            throw err;
   739→          }
   740→        }
   741→
   742→        // Initialize shadow — should detect remote branch via ls-remote and attach
   743→        const result = await initializeShadow(cloneDir);
   744→        expect(result.success).toBe(true);
   745→        expect(result.createdFromRemote).toBe(true);
   746→        expect(result.branchCreated).toBe(false);
   747→        expect(result.worktreeCreated).toBe(true);
   748→
   749→        // Verify worktree is healthy
   750→        const status = await getShadowStatus(cloneDir);
   751→        expect(status.healthy).toBe(true);
   752→      } finally {
   753→        await fs.rm(cloneDir, { recursive: true, force: true });
   754→      }
   755→    });
