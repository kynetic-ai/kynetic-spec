   297→
   298→    // AC: @yaml-merge-driver ac-12
   299→    // Uses a temporary kspec wrapper in PATH pointing to the project's built CLI,
   300→    // so the test works without a global kspec install (e.g. in CI).
   301→    // Requires git >= 2.42 for --orphan worktree support used by initializeShadow.
   302→    it.skipIf(!canRunShadowInitTests)(
   303→      'configures merge driver during initialization',
   304→      async () => {
   305→        // Initialize git repo with an initial commit
   306→        execSync('git init', { cwd: testDir, stdio: 'pipe' });
   307→        execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   308→        execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   309→        await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   310→        execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   311→
   312→        // Create a temporary bin directory with a kspec wrapper that delegates
   313→        // to the project's built CLI, so `which kspec` succeeds without a global install
   314→        const binDir = path.join(testDir, '_bin');
   315→        await fs.mkdir(binDir, { recursive: true });
   316→        await fs.writeFile(
   317→          path.join(binDir, 'kspec'),
   318→          `#!/bin/sh\nexec node "${projectCli}" "$@"\n`,
   319→          { mode: 0o755 },
   320→        );
   321→
   322→        // Prepend our bin dir to PATH so configureMergeDriver finds it
   323→        const originalPath = process.env.PATH;
   324→        process.env.PATH = `${binDir}:${originalPath}`;
   325→        try {
   326→          const result = await initializeShadow(testDir, { projectName: 'Test Project' });
   327→
   328→          expect(result.success).toBe(true);
   329→
   330→          // Verify merge driver is configured in .git/config
   331→          const mergeDriverName = execSync('git config merge.kspec.name', {
   332→            cwd: testDir,
   333→            encoding: 'utf-8',
   334→            stdio: ['pipe', 'pipe', 'pipe'],
   335→          }).trim();
   336→          expect(mergeDriverName).toBe('Kspec YAML semantic merge driver');
   337→
   338→          const mergeDriverCmd = execSync('git config merge.kspec.driver', {
   339→            cwd: testDir,
   340→            encoding: 'utf-8',
   341→            stdio: ['pipe', 'pipe', 'pipe'],
   342→          }).trim();
   343→          expect(mergeDriverCmd).toContain('kspec merge-driver');
   344→          expect(mergeDriverCmd).toContain('--non-interactive');
   345→
   346→          // Verify .gitattributes exists in shadow branch
   347→          const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   348→          const gitattributesPath = path.join(worktreeDir, '.gitattributes');
   349→          const gitattributesContent = await fs.readFile(gitattributesPath, 'utf-8');
   350→          expect(gitattributesContent).toContain('*.yaml merge=kspec');
   351→          expect(gitattributesContent).toContain('*.yml merge=kspec');
   352→        } finally {
   353→          // Restore original PATH
   354→          process.env.PATH = originalPath;
   355→        }
   356→      },
   357→    );
