  1512→  describe('Configurable Shadow Branch', () => {
  1513→    // AC: @config-shadow ac-7 — backward compat when called without config
  1514→    describe('backward compatibility (ac-7)', () => {
  1515→      it('detectShadow uses defaults when no options provided', async () => {
  1516→        // Initialize git repo
  1517→        execSync('git init', { cwd: testDir, stdio: 'pipe' });
