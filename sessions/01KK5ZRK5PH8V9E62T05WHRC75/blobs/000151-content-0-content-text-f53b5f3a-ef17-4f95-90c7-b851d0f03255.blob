    38→// Check if git supports --orphan worktree (requires >= 2.42) and built CLI exists.
    39→// initializeShadow needs both to work.
    40→const projectCli = path.resolve(__dirname, '..', 'dist', 'cli', 'index.js');
    41→const canRunShadowInitTests = (() => {
    42→  try {
    43→    const version = execSync('git --version', { encoding: 'utf-8' }).trim();
    44→    const match = version.match(/(\d+)\.(\d+)/);
    45→    if (!match) return false;
    46→    const [, major, minor] = match.map(Number);
    47→    const gitSupportsOrphan = major > 2 || (major === 2 && minor >= 42);
    48→    return gitSupportsOrphan && existsSync(projectCli);
    49→  } catch {
    50→    return false;
    51→  }
    52→})();
    53→
    54→describe('Shadow Branch', () => {
    55→  // Use /tmp to ensure we're outside any git repo for proper isolation
    56→  const testDir = path.join('/tmp', `kspec-shadow-test-${Date.now()}`);
    57→
    58→  beforeEach(async () => {
    59→    // Clean up any previous test directory
    60→    try {
    61→      await fs.rm(testDir, { recursive: true });
    62→    } catch {
    63→      // Doesn't exist, that's fine
    64→    }
    65→    await fs.mkdir(testDir, { recursive: true });
    66→  });
    67→
    68→  afterEach(async () => {
    69→    try {
    70→      await fs.rm(testDir, { recursive: true });
    71→    } catch {
    72→      // Best effort cleanup
    73→    }
    74→  });
    75→
    76→  describe('detectShadow', () => {
