   923→    // AC: @shadow-sync ac-6 - shadowPull uses --ff-only first, falls back to --rebase
   924→    it('shadowPull pulls changes from remote', async () => {
   925→      await setupSyncTest();
   926→
   927→      // Make a change on remote by cloning, modifying, and pushing
   928→      const cloneDir = path.join('/tmp', `kspec-sync-clone-${Date.now()}`);
   929→      try {
   930→        execSync(`git clone ${remoteDir} ${cloneDir}`, { stdio: 'pipe' });
   931→        execSync('git config user.email "test@test.com"', { cwd: cloneDir, stdio: 'pipe' });
   932→        execSync('git config user.name "Test"', { cwd: cloneDir, stdio: 'pipe' });
   933→        execSync(`git worktree add .kspec ${SHADOW_BRANCH_NAME}`, { cwd: cloneDir, stdio: 'pipe' });
   934→
   935→        // Modify a file in the clone's shadow
   936→        const tasksFile = (await fs.readdir(path.join(cloneDir, '.kspec')))
   937→          .find(f => f.endsWith('.tasks.yaml'));
   938→        if (tasksFile) {
   939→          await fs.appendFile(
   940→            path.join(cloneDir, '.kspec', tasksFile),
   941→            '\n# Remote change\n'
   942→          );
   943→          execSync('git add -A && git commit -m "Remote change"', {
   944→            cwd: path.join(cloneDir, '.kspec'),
   945→            stdio: 'pipe',
   946→          });
   947→          execSync(`git push origin ${SHADOW_BRANCH_NAME}`, {
   948→            cwd: path.join(cloneDir, '.kspec'),
   949→            stdio: 'pipe',
   950→          });
   951→        }
   952→
   953→        // Now pull in original repo
   954→        const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   955→        const result = await shadowPull(worktreeDir);
   956→
   957→        expect(result.success).toBe(true);
   958→        expect(result.pulled).toBe(true);
   959→        expect(result.hadConflict).toBe(false);
   960→
   961→        // Verify the change was pulled
   962→        const content = await fs.readFile(path.join(worktreeDir, tasksFile!), 'utf-8');
   963→        expect(content).toContain('# Remote change');
   964→      } finally {
   965→        await fs.rm(cloneDir, { recursive: true, force: true });
   966→      }
   967→    });
