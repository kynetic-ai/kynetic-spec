   509→      expect(result.alreadyExists).toBe(true);
   510→      expect(result.worktreeCreated).toBe(false);
   511→    });
   512→
   513→    // AC: @artifacts-directory ac-repair-recreates
   514→    it('recreates artifacts directory after repair', async () => {
   515→      await setupHealthyShadow();
   516→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   517→
   518→      // Break: delete the worktree directory
   519→      execSync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, { cwd: testDir, stdio: 'pipe' });
   520→
   521→      // Repair
