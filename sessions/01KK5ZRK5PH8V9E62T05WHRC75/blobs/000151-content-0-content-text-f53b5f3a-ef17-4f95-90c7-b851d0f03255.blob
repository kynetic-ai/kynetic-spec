   421→  describe('repairShadow', () => {
   422→    // Helper to set up a healthy shadow branch
   423→    async function setupHealthyShadow(): Promise<void> {
   424→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   425→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   426→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   427→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   428→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   429→      await initializeShadow(testDir);
   430→    }
   431→
   432→    // AC: @shadow-recovery ac-recovery-1 - Branch exists but .kspec/ deleted → repair recreates
   433→    it('recreates worktree when .kspec/ directory is deleted', async () => {
   434→      await setupHealthyShadow();
   435→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   436→
   437→      // Verify healthy before breaking
   438→      let status = await getShadowStatus(testDir);
   439→      expect(status.healthy).toBe(true);
   440→
   441→      // Break: delete the worktree directory
   442→      // First remove from git worktree list to avoid stale reference
   443→      execSync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, { cwd: testDir, stdio: 'pipe' });
   444→
   445→      // Verify broken
   446→      status = await getShadowStatus(testDir);
   447→      expect(status.healthy).toBe(false);
   448→      expect(status.branchExists).toBe(true);
   449→      expect(status.worktreeExists).toBe(false);
   450→
   451→      // Repair
   452→      const result = await repairShadow(testDir);
   453→      expect(result.success).toBe(true);
   454→      expect(result.worktreeCreated).toBe(true);
   455→
   456→      // Verify healthy again
   457→      status = await getShadowStatus(testDir);
   458→      expect(status.healthy).toBe(true);
   459→      expect(await isValidWorktree(worktreeDir)).toBe(true);
   460→    });
   461→
   462→    // AC: @shadow-recovery ac-recovery-2 - .kspec/ exists but .git file corrupt → repair recreates
   463→    it('recreates worktree when .git file is corrupted', async () => {
   464→      await setupHealthyShadow();
   465→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   466→      const gitFile = path.join(worktreeDir, '.git');
   467→
   468→      // Verify healthy before breaking
   469→      let status = await getShadowStatus(testDir);
   470→      expect(status.healthy).toBe(true);
   471→
   472→      // Break: corrupt the .git file
   473→      await fs.writeFile(gitFile, 'corrupted content');
   474→
   475→      // Verify broken
   476→      status = await getShadowStatus(testDir);
   477→      expect(status.healthy).toBe(false);
   478→      expect(status.worktreeExists).toBe(true);
   479→      expect(status.worktreeLinked).toBe(false);
   480→
   481→      // Repair
   482→      const result = await repairShadow(testDir);
   483→      expect(result.success).toBe(true);
   484→      expect(result.worktreeCreated).toBe(true);
   485→
   486→      // Verify healthy again
   487→      status = await getShadowStatus(testDir);
   488→      expect(status.healthy).toBe(true);
   489→    });
   490→
   491→    // AC: @shadow-recovery ac-recovery-3 - No shadow branch → repair fails suggesting init
   492→    it('fails with helpful error when shadow branch does not exist', async () => {
   493→      // Just a git repo without shadow branch
   494→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   495→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   496→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
