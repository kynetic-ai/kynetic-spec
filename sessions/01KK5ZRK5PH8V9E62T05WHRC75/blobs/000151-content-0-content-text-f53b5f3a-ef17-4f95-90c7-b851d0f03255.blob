   244→  describe('initializeShadow', () => {
   245→    it('creates shadow branch and worktree in git repo', async () => {
   246→      // Initialize git repo with an initial commit
   247→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   248→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   249→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   250→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   251→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   252→
   253→      const result = await initializeShadow(testDir, { projectName: 'Test Project' });
   254→
   255→      expect(result.success).toBe(true);
   256→      expect(result.branchCreated).toBe(true);
   257→      expect(result.worktreeCreated).toBe(true);
   258→      expect(result.gitignoreUpdated).toBe(true);
   259→
   260→      // Verify branch exists
   261→      expect(await branchExists(testDir, SHADOW_BRANCH_NAME)).toBe(true);
   262→
   263→      // Verify worktree exists and is valid
   264→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   265→      expect(await isValidWorktree(worktreeDir)).toBe(true);
   266→
   267→      // Verify status is healthy
   268→      const status = await getShadowStatus(testDir);
   269→      expect(status.healthy).toBe(true);
   270→    });
   271→
   272→    it('is idempotent - succeeds if already initialized', async () => {
   273→      // Initialize git repo
   274→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   275→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   276→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   277→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   278→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   279→
   280→      // First init
   281→      const result1 = await initializeShadow(testDir);
   282→      expect(result1.success).toBe(true);
