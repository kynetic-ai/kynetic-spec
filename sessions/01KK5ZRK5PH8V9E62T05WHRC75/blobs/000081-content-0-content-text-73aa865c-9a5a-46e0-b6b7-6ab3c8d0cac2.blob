     1→/**
     2→ * Centralized error messages for CLI commands
     3→ *
     4→ * Organizes error messages by category to improve maintainability and consistency.
     5→ * Each category corresponds to a common error pattern across command files.
     6→ */
     7→
     8→/**
     9→ * Reference resolution errors (not found, ambiguous, wrong type)
    10→ */
    11→export const referenceErrors = {
    12→  // Not found
    13→  itemNotFound: (ref: string) => `Item not found: ${ref}`,
    14→  taskNotFound: (ref: string) => `Task not found: ${ref}`,
    15→  specNotFound: (ref: string) => `Spec item not found: ${ref}`,
    16→  metaNotFound: (ref: string) => `Meta item not found: ${ref}`,
    17→  inboxNotFound: (ref: string) => `Inbox item not found: ${ref}`,
    18→  observationNotFound: (ref: string) => `Observation not found: ${ref}`,
    19→  planNotFound: (ref: string) => `Plan not found: ${ref}`,
    20→  depNotFound: (ref: string) => `Dependency reference not found: ${ref}`,
    21→  acNotFound: (acId: string, itemRef: string) =>
    22→    `Acceptance criterion "${acId}" not found on @${itemRef}`,
    23→
    24→  // Ambiguous references
    25→  ambiguous: (ref: string) => `Reference "${ref}" is ambiguous. Matches:`,
    26→  slugMapsToMultiple: (ref: string) =>
    27→    `Slug "${ref}" maps to multiple items. Use ULID instead:`,
    28→
    29→  // Wrong type
    30→  notTask: (ref: string) =>
    31→    `Reference "${ref}" is not a task (it's a spec item)`,
    32→  notItem: (ref: string) =>
    33→    `"${ref}" is a task, not a spec item. Use 'kspec task get' instead.`,
    34→  taskUseTaskCommands: (ref: string) =>
    35→    `"${ref}" is a task. Use 'kspec task' commands instead.`,
    36→  itemUseTaskCancel: (ref: string) =>
    37→    `"${ref}" is a task. Use 'kspec task cancel' instead.`,
    38→  parentIsTask: (ref: string) =>
    39→    `"${ref}" is a task. Items can only be added under spec items.`,
    40→  notSpecItem: (ref: string) =>
    41→    `Reference "${ref}" is a task, not a spec item. Derive only works on spec items.`,
    42→
    43→  // Meta reference errors
    44→  metaRefNotFound: (ref: string) => `meta_ref '${ref}' not found`,
    45→  metaRefPointsToSpec: (ref: string) =>
    46→    `meta_ref '${ref}' points to a spec item; use --spec-ref for product spec references`,
    47→
    48→  // Spec reference errors
    49→  specRefNotFound: (ref: string) => `Spec reference not found: ${ref}`,
    50→  specRefIsTask: (ref: string) =>
    51→    `Reference "${ref}" is a task, not a spec item`,
    52→
    53→  // Reference not found (generic)
    54→  refNotFound: (ref: string) => `Reference not found: ${ref}`,
    55→} as const;
    56→
    57→/**
    58→ * Slug validation errors
    59→ */
    60→export const slugErrors = {
    61→  alreadyExists: (slug: string, existingUlid: string) =>
