   107→  invalidTodoId: (id: string) => `Invalid todo ID: ${id}`,
   108→
   109→  // Required fields
   110→  titleRequired: "Task title is required",
   111→  resolutionRequired: "Resolution text is required",
   112→  agentRequiresId: "Agent requires --id",
   113→  agentRequiresName: "Agent requires --name",
   114→  workflowRequiresId: "Workflow requires --id",
   115→  workflowRequiresTrigger: "Workflow requires --trigger",
   116→  conventionRequiresDomain: "Convention requires --domain",
   117→
   118→  // Workflow steps validation
   119→  invalidStepsJson: (err: string) =>
