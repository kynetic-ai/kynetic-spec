   572→  // AC: @cli-serve-commands ac-11
   573→  describe('dispatch agent guard', () => {
   574→    // AC: @trait-semantic-exit-codes ac-2 — validation error exit code
   575→    it('should refuse serve start when KSPEC_SESSION_ID is set', async () => {
   576→      const result = runKspec(
   577→        `serve start --kspec-dir ${join(tempDir, '.kspec')}`,
   578→        tempDir,
   579→        { expectFail: true, env: { KSPEC_SESSION_ID: 'test-session-id' } }
   580→      );
   581→
   582→      expect(result.exitCode).toBe(4); // VALIDATION_FAILED
   583→      expect(result.stderr).toContain('Cannot start daemon from inside an agent invocation');
   584→      expect(result.stderr).toContain('dispatch engine');
   585→    });
   586→
   587→    it('should refuse serve stop when KSPEC_SESSION_ID is set', async () => {
   588→      const result = runKspec(
   589→        `serve stop --kspec-dir ${join(tempDir, '.kspec')}`,
   590→        tempDir,
   591→        { expectFail: true, env: { KSPEC_SESSION_ID: 'test-session-id' } }
   592→      );
   593→
   594→      expect(result.exitCode).toBe(4); // VALIDATION_FAILED
   595→      expect(result.stderr).toContain('Cannot stop daemon from inside an agent invocation');
   596→      expect(result.stderr).toContain('dispatch engine');
   597→    });
   598→
   599→    it('should refuse serve restart when KSPEC_SESSION_ID is set', async () => {
