   379→    );
   380→
   381→    await waitForDaemonHealth(port);
   382→
   383→    // Register a project via API
   384→    const testProjectPath = tempDir;
   385→    await fetch(`http://localhost:${port}/api/projects`, {
   386→      method: 'POST',
   387→      headers: { 'Content-Type': 'application/json' },
   388→      body: JSON.stringify({ path: testProjectPath }),
   389→    });
   390→
   391→    // Check status - should list registered projects
   392→    const result = runKspec(`serve status --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   393→
   394→    // Human-readable output should mention projects
   395→    expect(result.stdout).toContain('Registered projects');
   396→    expect(result.stdout).toContain(testProjectPath);
   397→    expect(result.stdout).toContain('watcher:');
   398→
   399→    // Cleanup
