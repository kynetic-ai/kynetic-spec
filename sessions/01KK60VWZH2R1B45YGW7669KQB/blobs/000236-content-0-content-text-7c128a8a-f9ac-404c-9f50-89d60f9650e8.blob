```
     1→/**
     2→ * E2E tests for kspec serve CLI commands
     3→ * Spec: @cli-serve-commands
     4→ */
     5→
     6→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     7→import {
     8→  createTempDir,
     9→  cleanupTempDir,
    10→  createIsolatedKspecHome,
    11→  initGitRepo,
    12→  kspec,
    13→  waitForStartup,
    14→  type KspecOptions,
    15→} from './helpers/cli';
    16→import { spawn, execSync } from 'child_process';
    17→import { join } from 'path';
    18→import { readFileSync, existsSync, mkdirSync } from 'fs';
    19→import { createServer } from 'net';
    20→
    21→// Check if Bun runtime is available
    22→let bunAvailable = false;
    23→try {
    24→  execSync('which bun', { stdio: 'pipe' });
    25→  bunAvailable = true;
    26→} catch {
    27→  console.log('⊘ Bun runtime not available - skipping daemon tests requiring actual daemon process');
    28→}
    29→
    30→describe('kspec serve commands', () => {
    31→  let tempDir: string;
    32→  let isolatedHome: string;
    33→  let testEnv: Record<string, string>;
    34→  let globalPidFilePath: string;
    35→  let globalPortFilePath: string;
    36→
    37→  async function getAvailablePort(): Promise<number> {
    38→    return await new Promise((resolve, reject) => {
    39→      const server = createServer();
    40→      server.once('error', reject);
    41→      server.listen(0, '127.0.0.1', () => {
    42→        const address = server.address();
    43→        if (!address || typeof address === 'string') {
    44→          server.close(() => reject(new Error('Failed to allocate ephemeral port')));
    45→          return;
    46→        }
    47→        const { port } = address;
    48→        server.close((error) => {
    49→          if (error) {
    50→            reject(error);
    51→            return;
    52→          }
    53→          resolve(port);
    54→        });
    55→      });
    56→    });
    57→  }
    58→
    59→  function runKspec(args: string, cwd = tempDir, options: KspecOptions = {}) {
    60→    return kspec(args, cwd, {
    61→      ...options,
    62→      env: { ...testEnv, ...(options.env ?? {}) },
    63→    });
    64→  }
    65→
    66→  async function waitForDaemonHealth(port: number): Promise<void> {
    67→    await waitForStartup(`daemon health endpoint on port ${port}`, async () => {
    68→      const url = `http://localhost:${port}/api/health`;
    69→      try {
    70→        const response = await fetch(url);
    71→        const body = (await response.text()).trim();
    72→        const bodyReportsHealthy = body.includes('"status":"ok"');
    73→        return {
    74→          ok: response.ok || bodyReportsHealthy,
    75→          details: `status=${response.status} body=${body || '<empty>'}`,
    76→        };
    77→      } catch (error) {
    78→        const message = error instanceof Error ? error.message : String(error);
    79→        return { ok: false, details: `fetch error=${message}` };
    80→      }
    81→    }, { timeoutMs: 10_000 });
    82→  }
    83→
    84→  async function waitForDaemonUptime(minUptimeSeconds: number): Promise<void> {
    85→    await waitForStartup(
    86→      `daemon uptime >= ${minUptimeSeconds}s`,
    87→      async () => {
    88→        const result = runKspec(`serve status --json --kspec-dir ${join(tempDir, '.kspec')}`, tempDir, {
    89→          expectFail: true
    90→        });
    91→        if (result.exitCode !== 0) {
    92→          return {
    93→            ok: false,
    94→            details: `exit=${result.exitCode} stderr=${result.stderr || '<empty>'}`,
    95→          };
    96→        }
    97→
    98→        try {
    99→          const status = JSON.parse(result.stdout);
   100→          const uptime = typeof status.uptime === 'number' ? status.uptime : -1;
   101→          return {
   102→            ok: uptime >= minUptimeSeconds,
   103→            details: `running=${Boolean(status.running)} uptime=${uptime}`,
   104→          };
   105→        } catch (error) {
   106→          const message = error instanceof Error ? error.message : String(error);
   107→          return { ok: false, details: `invalid-json=${message}` };
   108→        }
   109→      },
   110→      { timeoutMs: 10_000 }
   111→    );
   112→  }
   113→
   114→  beforeEach(async () => {
   115→    tempDir = await createTempDir();
   116→    await initGitRepo(tempDir);
   117→    mkdirSync(join(tempDir, '.kspec'), { recursive: true });
   118→    const isolated = await createIsolatedKspecHome(tempDir);
   119→    isolatedHome = isolated.homeDir;
   120→    testEnv = isolated.env;
   121→    globalPidFilePath = isolated.daemonPidFilePath;
   122→    globalPortFilePath = isolated.daemonPortFilePath;
   123→
   124→    // Ensure this test HOME starts from clean daemon state.
   125→    try {
   126→      runKspec(`serve stop --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   127→    } catch {
   128→      // Ignore: this is best-effort cleanup.
   129→    }
   130→  });
   131→
   132→  afterEach(async () => {
   133→    // Stop daemon scoped to isolated HOME so we never touch ambient daemon state.
   134→    try {
   135→      runKspec(`serve stop --kspec-dir ${join(tempDir, '.kspec')}`, tempDir, { expectFail: true });
   136→    } catch {
   137→      // Ignore cleanup errors
   138→    }
   139→
   140→    await cleanupTempDir(tempDir);
   141→  });
   142→
   143→  // AC: @daemon-sensitive-cli-test-determinism ac-1
   144→  it('should include actionable context when readiness wait times out', async () => {
   145→    await expect(waitForStartup(
   146→      'synthetic daemon readiness',
   147→      async () => ({ ok: false, details: 'status=503 body=warming-up' }),
   148→      { timeoutMs: 120, intervalMs: 20 }
   149→    )).rejects.toThrow(/Last observation: status=503 body=warming-up/);
   150→  });
   151→
   152→  // AC: @cli-serve-commands ac-1
   153→  // AC: @daemon-server ac-12
   154→  it('should start in foreground mode with Ctrl+C support', async () => {
   155→    if (!bunAvailable) {
   156→      console.log('  ⊘ Skipping test - Bun runtime required');
   157→      return;
   158→    }
   159→
   160→    // Use a unique port for this test
   161→    const port = await getAvailablePort();
   162→
   163→    // Spawn kspec serve in foreground
   164→    // Strip KSPEC_SESSION_ID to prevent dispatch guard from blocking
   165→    // when tests run inside an agent dispatch session
   166→    const { KSPEC_SESSION_ID: _, ...cleanProcessEnv } = process.env;
   167→    const child = spawn('node', [
   168→      join(__dirname, '../dist/cli/index.js'),
   169→      'serve',
   170→      'start',
   171→      '--port',
   172→      String(port),
   173→      '--kspec-dir',
   174→      join(tempDir, '.kspec')
   175→    ], {
   176→      cwd: tempDir,
   177→      stdio: ['pipe', 'pipe', 'pipe'],
   178→      env: { ...cleanProcessEnv, ...testEnv },
   179→    });
   180→
   181→    let output = '';
   182→    child.stdout?.on('data', (data) => {
   183→      output += data.toString();
   184→    });
   185→
   186→    child.stderr?.on('data', (data) => {
   187→      output += data.toString();
   188→    });
   189→
   190→    // Wait for startup message (CI can be slower than local runs)
   191→    const started = await new Promise<boolean>((resolve) => {
   192→      const start = Date.now();
   193→      const interval = setInterval(() => {
   194→        if (
   195→          output.includes('Starting server in foreground')
   196→          && output.includes(`port ${port}`)
   197→        ) {
   198→          clearInterval(interval);
   199→          resolve(true);
   200→          return;
   201→        }
   202→        if (Date.now() - start > 15_000 || child.exitCode !== null) {
   203→          clearInterval(interval);
   204→          resolve(false);
   205→        }
   206→      }, 100);
   207→    });
   208→
   209→    expect(started, `foreground startup output missing:\n${output}`).toBe(true);
   210→
   211→    // Send SIGINT (Ctrl+C)
   212→    if (child.exitCode === null) {
   213→      child.kill('SIGINT');
   214→    }
   215→
   216→    // Wait for shutdown
   217→    await new Promise<void>((resolve) => {
   218→      if (child.exitCode !== null) {
   219→        resolve();
   220→        return;
   221→      }
   222→      child.on('exit', () => resolve());
   223→    });
   224→
   225→    expect(child.exitCode).toBe(0);
   226→  });
   227→
   228→  // AC: @cli-serve-commands ac-2
   229→  // AC: @daemon-sensitive-cli-test-determinism ac-2
   230→  it('should start in daemon mode and detach', async () => {
   231→    if (!bunAvailable) {
   232→      console.log('  ⊘ Skipping test - Bun runtime required');
   233→      return;
   234→    }
   235→
   236→    const port = await getAvailablePort();
   237→
   238→    const result = runKspec(
   239→      `serve start --daemon --port ${port} --kspec-dir ${join(tempDir, '.kspec')}`,
   240→      tempDir
   241→    );
   242→
   243→    // Should report success
   244→    expect(result.stdout).toContain('Daemon started');
   245→    expect(result.stdout).toContain(`port ${port}`);
   246→
   247→    // PID file should exist
   248→    expect(existsSync(globalPidFilePath)).toBe(true);
   249→    expect(existsSync(globalPortFilePath)).toBe(true);
   250→    expect(globalPidFilePath.startsWith(isolatedHome)).toBe(true);
   251→    expect(globalPortFilePath.startsWith(isolatedHome)).toBe(true);
   252→
   253→    const pid = parseInt(readFileSync(globalPidFilePath, 'utf-8').trim(), 10);
   254→    expect(pid).toBeGreaterThan(0);
   255→
   256→    // Process should be running
   257→    let processRunning = false;
   258→    try {
   259→      process.kill(pid, 0); // Signal 0 checks existence
   260→      processRunning = true;
   261→    } catch {
   262→      processRunning = false;
   263→    }
   264→    expect(processRunning).toBe(true);
   265→
   266→    // Cleanup
   267→    runKspec(`serve stop --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   268→  });
