   365→  // AC: @multi-directory-daemon ac-12
   366→  // AC: @daemon-sensitive-cli-test-determinism ac-3
   367→  it('should show registered projects with paths in status output', async () => {
   368→    if (!bunAvailable) {
   369→      console.log('  ⊘ Skipping test - Bun runtime required');
