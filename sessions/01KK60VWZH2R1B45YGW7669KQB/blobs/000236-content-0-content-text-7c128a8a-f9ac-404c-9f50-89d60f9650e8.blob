   703→    it('should use ISO 8601 timestamps in JSON output', async () => {
   704→      // serve status doesn't currently include timestamps, but when it does they should be ISO 8601
   705→      const result = runKspec(`serve status --json --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   706→      const output = JSON.parse(result.stdout);
   707→
   708→      // Defensive test for when uptime/timestamps are added
