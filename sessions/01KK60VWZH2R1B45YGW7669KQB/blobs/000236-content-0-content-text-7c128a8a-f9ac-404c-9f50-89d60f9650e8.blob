   311→    expect(result.stdout).toContain('Stopping daemon');
   312→    expect(result.stdout).toContain(`PID ${pid}`);
   313→    expect(result.stdout).toContain('Daemon stopped');
   314→
   315→    // PID file should be removed (eventually by daemon cleanup, but may still exist during test)
   316→    // Process should not be running
   317→    let processRunning = false;
   318→    try {
   319→      process.kill(pid, 0);
   320→      processRunning = true;
   321→    } catch {
