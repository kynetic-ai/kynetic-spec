   628→  // Trait tests: @trait-json-output
   629→  describe('JSON output mode', () => {
   630→    // AC: @trait-json-output ac-1, ac-2
   631→    it('should output valid JSON with --json for serve status', async () => {
   632→      const result = runKspec(`serve status --json --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   633→
   634→      // Should be valid JSON
   635→      expect(() => JSON.parse(result.stdout)).not.toThrow();
   636→
   637→      const output = JSON.parse(result.stdout);
   638→      expect(output).toHaveProperty('running');
   639→      expect(output).toHaveProperty('pid');
   640→    });
   641→
   642→    // AC: @trait-json-output ac-3, @trait-error-guidance ac-6
   643→    it('should output errors as JSON with --json flag', async () => {
   644→      const result = runKspec(
   645→        `serve start --port 99999 --json --kspec-dir ${join(tempDir, '.kspec')}`,
   646→        tempDir,
   647→        { expectFail: true }
   648→      );
   649→
   650→      // Should be valid JSON
   651→      expect(() => JSON.parse(result.stdout)).not.toThrow();
   652→
   653→      const output = JSON.parse(result.stdout);
   654→      expect(output).toHaveProperty('error');
   655→      expect(output.error).toContain('Invalid port number');
   656→      expect(output).toHaveProperty('hint');
   657→      expect(output.hint).toContain('Try: kspec serve --port');
   658→    });
   659→
   660→    // AC: @trait-json-output ac-2
   661→    it('should include all data in JSON mode that appears in human mode', async () => {
   662→      if (!bunAvailable) {
   663→        console.log('  ⊘ Skipping test - Bun runtime required');
   664→        return;
   665→      }
   666→
   667→      const port = await getAvailablePort();
   668→
   669→      // Start daemon
   670→      runKspec(
   671→        `serve start --daemon --port ${port} --kspec-dir ${join(tempDir, '.kspec')}`,
   672→        tempDir
   673→      );
   674→
   675→      // Compare JSON vs human output
   676→      const humanResult = runKspec(`serve status --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   677→      const jsonResult = runKspec(`serve status --json --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   678→
   679→      const jsonData = JSON.parse(jsonResult.stdout);
   680→
   681→      // Human output should contain the same data
   682→      expect(humanResult.stdout).toContain(String(jsonData.pid));
   683→      expect(humanResult.stdout).toContain(jsonData.running ? 'running' : 'not running');
   684→
   685→      // Cleanup
   686→      runKspec(`serve stop --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   687→    });
   688→
   689→    // AC: @trait-json-output ac-4
   690→    it('should use @ prefix for references in JSON output', async () => {
   691→      // serve commands don't output references, but we can verify the pattern if they did
   692→      // This test ensures future additions follow the trait
   693→      const result = runKspec(`serve status --json --kspec-dir ${join(tempDir, '.kspec')}`, tempDir);
   694→      const output = JSON.parse(result.stdout);
   695→
   696→      // Defensive test: if refs are ever added, they should use @ prefix
   697→      // For now, just verify JSON is valid and doesn't contain bare ULID prefixes like "01TASK"
   698→      const jsonStr = JSON.stringify(output);
   699→      expect(jsonStr).not.toMatch(/[^@]01[A-Z0-9]{6}/); // No bare ULID prefixes
   700→    });
