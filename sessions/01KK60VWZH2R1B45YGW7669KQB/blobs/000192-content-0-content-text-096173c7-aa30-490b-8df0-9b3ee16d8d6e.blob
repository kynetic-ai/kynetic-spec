     1→/**
     2→ * kspec serve commands - daemon server lifecycle management
     3→ * AC: @cli-serve-commands
     4→ */
     5→
     6→import type { Command } from 'commander';
     7→import { spawn, execSync } from 'child_process';
     8→import { existsSync, readdirSync, statSync } from 'fs';
     9→import { join, dirname } from 'path';
    10→import { fileURLToPath } from 'url';
    11→import { error, info, output, success, warn, isJsonMode } from '../output.js';
    12→import { EXIT_CODES } from '../exit-codes.js';
    13→import { PidFileManager } from '../pid-utils.js';
    14→import { loadProjectConfig } from '../../parser/config.js';
    15→import { initContext } from '../../parser/yaml.js';
    16→
    17→/**
    18→ * Check if Bun runtime is available.
    19→ * Daemon requires Bun to run TypeScript directly.
    20→ */
    21→function isBunAvailable(): boolean {
    22→  try {
    23→    execSync('bun --version', { stdio: 'pipe' });
    24→    return true;
    25→  } catch {
    26→    return false;
    27→  }
    28→}
    29→
    30→const __filename = fileURLToPath(import.meta.url);
    31→const __dirname = dirname(__filename);
    32→
    33→/**
    34→ * Check if daemon dist files are stale (source newer than dist)
    35→ * Returns true if rebuild is recommended
    36→ */
    37→function checkDaemonStaleness(): boolean {
    38→  // __dirname is dist/cli/commands, go up 3 levels to package root, then into packages/daemon/src
    39→  const sourceDir = join(__dirname, '../../../packages/daemon/src');
    40→  // dist/daemon is 2 levels up from __dirname
    41→  const distDir = join(__dirname, '../../daemon');
    42→
    43→  if (!existsSync(sourceDir) || !existsSync(distDir)) return false;
    44→
    45→  try {
    46→    const getNewestMtime = (dir: string): number => {
    47→      const files = readdirSync(dir, { withFileTypes: true });
    48→      let newest = 0;
    49→      for (const f of files) {
    50→        const fullPath = join(dir, f.name);
    51→        if (f.isDirectory()) {
    52→          newest = Math.max(newest, getNewestMtime(fullPath));
    53→        } else if (f.name.endsWith('.ts')) {
    54→          newest = Math.max(newest, statSync(fullPath).mtimeMs);
    55→        }
    56→      }
    57→      return newest;
    58→    };
    59→
    60→    const newestSource = getNewestMtime(sourceDir);
    61→    const newestDist = getNewestMtime(distDir);
    62→
    63→    return newestSource > newestDist;
    64→  } catch {
    65→    return false; // Don't warn if check fails
    66→  }
    67→}
    68→
    69→/**
    70→ * Normalize daemon uptime payloads to seconds.
    71→ * Some runtimes may serialize uptime as structured objects instead of a number.
    72→ */
    73→function parseUptimeSeconds(raw: unknown): number | null {
    74→  if (typeof raw === 'number' && Number.isFinite(raw)) {
    75→    return raw;
    76→  }
    77→
    78→  if (!raw || typeof raw !== 'object') {
    79→    return null;
    80→  }
    81→
    82→  const candidate = raw as { seconds?: unknown; milliseconds?: unknown; ms?: unknown };
    83→  if (typeof candidate.seconds === 'number' && Number.isFinite(candidate.seconds)) {
    84→    return candidate.seconds;
    85→  }
    86→  if (typeof candidate.milliseconds === 'number' && Number.isFinite(candidate.milliseconds)) {
    87→    return candidate.milliseconds / 1000;
    88→  }
    89→  if (typeof candidate.ms === 'number' && Number.isFinite(candidate.ms)) {
    90→    return candidate.ms / 1000;
    91→  }
    92→
    93→  return null;
    94→}
    95→
    96→
    97→/**
    98→ * AC: @cli-serve-commands ac-11
    99→ * Refuse to modify daemon lifecycle when running inside an agent invocation.
   100→ * Agents inherit KSPEC_SESSION_ID — stopping the daemon would kill the dispatch engine.
   101→ */
   102→function guardAgentContext(action: string): void {
   103→  if (process.env.KSPEC_SESSION_ID) {
   104→    if (isJsonMode()) {
   105→      output({
   106→        error: `Cannot ${action} daemon from inside an agent invocation.`,
   107→        reason: 'Stopping or restarting the daemon would kill the dispatch engine hosting this agent.',
   108→        suggestion: 'The daemon is managed externally. Do not run kspec serve commands from agent code.',
   109→      });
   110→    } else {
   111→      error(`Cannot ${action} daemon from inside an agent invocation.`);
   112→      error('Stopping or restarting the daemon would kill the dispatch engine hosting this agent.');
   113→      error('The daemon is managed externally. Do not run kspec serve commands from agent code.');
   114→    }
   115→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   116→  }
   117→}
   118→
   119→/**
   120→ * Register serve commands
   121→ */
   122→export function registerServeCommands(program: Command): void {
   123→  const serve = program
   124→    .command('serve')
   125→    .description('Manage the kspec daemon server');
   126→
   127→  // AC: @cli-serve-commands ac-1, ac-2, ac-3
   128→  // AC: @config-daemon ac-1, ac-2 — port from config, CLI flag overrides
   129→  serve
   130→    .command('start', { isDefault: true })
   131→    .description('Start the daemon server')
   132→    .option('-d, --daemon', 'Run in background (detached mode)')
   133→    .option('-p, --port <port>', 'Server port (uses config daemon.port if not specified)')
   134→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   135→    .option('--json', 'Output as JSON')
   136→    .action(async (opts) => {
   137→      try {
   138→        await startServer(opts);
   139→      } catch (err) {
   140→        if (isJsonMode()) {
   141→          output({ error: err instanceof Error ? err.message : String(err) });
   142→        } else {
   143→          error(`Failed to start server: ${err instanceof Error ? err.message : String(err)}`);
   144→        }
   145→        process.exit(EXIT_CODES.ERROR);
   146→      }
   147→    });
   148→
   149→  // AC: @cli-serve-commands ac-4, ac-5
   150→  serve
   151→    .command('stop')
   152→    .description('Stop the daemon server')
   153→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   154→    .option('--json', 'Output as JSON')
   155→    .action(async (opts) => {
   156→      try {
   157→        await stopServer(opts);
   158→      } catch (err) {
   159→        if (isJsonMode()) {
   160→          output({ error: err instanceof Error ? err.message : String(err) });
   161→        } else {
   162→          error(`Failed to stop server: ${err instanceof Error ? err.message : String(err)}`);
   163→        }
   164→        process.exit(EXIT_CODES.ERROR);
   165→      }
   166→    });
   167→
   168→  // AC: @cli-serve-commands ac-6
   169→  serve
   170→    .command('status')
   171→    .description('Check daemon server status')
   172→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   173→    .option('--json', 'Output as JSON')
   174→    .action(async (opts) => {
   175→      try {
   176→        await statusServer(opts);
   177→      } catch (err) {
   178→        if (isJsonMode()) {
   179→          output({ error: err instanceof Error ? err.message : String(err) });
   180→        } else {
   181→          error(`Failed to check status: ${err instanceof Error ? err.message : String(err)}`);
   182→        }
   183→        process.exit(EXIT_CODES.ERROR);
   184→      }
   185→    });
   186→
   187→  // AC: @cli-serve-commands ac-7
   188→  serve
   189→    .command('restart')
   190→    .description('Restart the daemon server')
   191→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   192→    .option('--json', 'Output as JSON')
   193→    .action(async (opts) => {
   194→      try {
   195→        await restartServer(opts);
   196→      } catch (err) {
   197→        if (isJsonMode()) {
   198→          output({ error: err instanceof Error ? err.message : String(err) });
   199→        } else {
   200→          error(`Failed to restart server: ${err instanceof Error ? err.message : String(err)}`);
   201→        }
   202→        process.exit(EXIT_CODES.ERROR);
   203→      }
   204→    });
   205→}
   206→
   207→/**
   208→ * Start the daemon server
   209→ * AC: @cli-serve-commands ac-1 (foreground), ac-2 (daemon), ac-3 (port), ac-10 (port error)
   210→ * AC: @config-daemon ac-1 — port from config, ac-2 — CLI flag overrides config
   211→ */
   212→async function startServer(opts: {
   213→  daemon?: boolean;
   214→  port?: string;
   215→  kspecDir: string;
   216→}): Promise<void> {
   217→  // AC: @cli-serve-commands ac-11
   218→  guardAgentContext('start');
   219→  const jsonMode = isJsonMode();
   220→
   221→  // AC: @config-daemon ac-1, ac-2 — load config for default port, CLI flag overrides
   222→  const { config } = await loadProjectConfig();
   223→  const configPort = config.daemon.port;
   224→
   225→  // AC: @config-daemon ac-2 — CLI flag takes precedence over config
   226→  const port = opts.port ? parseInt(opts.port, 10) : configPort;
   227→
   228→  // AC: @cli-serve-commands ac-10
   229→  if (isNaN(port) || port < 1 || port > 65535) {
   230→    if (jsonMode) {
   231→      output({
   232→        error: 'Invalid port number. Must be between 1 and 65535.',
   233→        hint: 'Try: kspec serve --port <PORT>',
   234→      });
   235→    } else {
   236→      error('Invalid port number. Must be between 1 and 65535.');
   237→      error('Try: kspec serve --port <PORT>');
   238→    }
   239→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   240→  }
   241→
   242→  const pidManager = new PidFileManager();
   243→
   244→  // Check if already running
   245→  if (pidManager.isDaemonRunning()) {
   246→    const pid = pidManager.readPid();
   247→    const existingPort = pidManager.readPort();
   248→    if (isJsonMode()) {
   249→      output({ running: true, pid, port: existingPort, message: 'Daemon already running' });
   250→    } else {
   251→      warn(`Daemon already running on port ${existingPort}`);
   252→    }
   253→    process.exit(EXIT_CODES.SUCCESS);
   254→  }
   255→
   256→  // Get path to daemon entry point
   257→  // Daemon source is bundled at dist/daemon/index.ts (relative to package root)
   258→  // __dirname is dist/cli/commands, so go up 2 levels to dist/, then into daemon/
   259→  // Note: Daemon is TypeScript source - requires Bun runtime
   260→  const daemonBinary = join(__dirname, '../../daemon/index.ts');
   261→
   262→  if (!existsSync(daemonBinary)) {
   263→    if (isJsonMode()) {
   264→      output({ error: `Daemon binary not found at ${daemonBinary}`, hint: 'Ensure the kspec package is properly installed' });
   265→    } else {
   266→      error(`Daemon binary not found at: ${daemonBinary}`);
   267→      error('Ensure the kspec package is properly installed');
   268→    }
   269→    process.exit(EXIT_CODES.ERROR);
   270→  }
   271→
   272→  // Daemon requires Bun to run TypeScript directly
   273→  if (!isBunAvailable()) {
   274→    if (isJsonMode()) {
   275→      output({ error: 'Bun runtime not found', hint: 'Install Bun: https://bun.sh/docs/installation' });
   276→    } else {
   277→      error('Bun runtime is required for the daemon server');
   278→      error('Install Bun: https://bun.sh/docs/installation');
   279→    }
   280→    process.exit(EXIT_CODES.ERROR);
   281→  }
   282→
   283→  // Check for stale daemon build (dev experience improvement)
   284→  if (checkDaemonStaleness() && !jsonMode) {
   285→    warn('Warning: dist/daemon/ may be stale (source files are newer).');
   286→    warn('  Run "npm run build:daemon" to update.');
   287→  }
   288→
   289→  // AC: @cli-serve-commands ac-2 - background mode
   290→  if (opts.daemon) {
   291→    const runtime = 'bun';
   292→
   293→    // Spawn detached process
   294→    // Set BUN_ENV=production to prevent Bun dev mode HTML transformation
   295→    // which can cause asset hash mismatches in the web UI
   296→    const child = spawn(runtime, [daemonBinary, '--port', String(port), '--kspec-dir', opts.kspecDir], {
   297→      detached: true,
   298→      stdio: 'ignore', // TODO: redirect to log file when logging implemented
   299→      cwd: process.cwd(),
   300→      env: { ...process.env, BUN_ENV: 'production' },
   301→    });
   302→
   303→    // Detach from parent
   304→    child.unref();
   305→
   306→    // Poll for PID file with timeout (max 5 seconds)
   307→    const maxWait = 5000;
   308→    const startTime = Date.now();
   309→    let pid: number | null = null;
   310→
   311→    while (Date.now() - startTime < maxWait) {
   312→      pid = pidManager.readPid();
   313→      if (pid && pidManager.isDaemonRunning()) {
   314→        break;
   315→      }
   316→      await new Promise(resolve => setTimeout(resolve, 100));
   317→    }
   318→
   319→    if (pid && pidManager.isDaemonRunning()) {
   320→      if (isJsonMode()) {
   321→        output({ running: true, pid, port });
   322→      } else {
   323→        success(`Daemon started with PID ${pid} on port ${port}`);
   324→        output({ running: true, pid, port });
   325→      }
   326→    } else {
   327→      if (isJsonMode()) {
   328→        output({ error: 'Daemon failed to start within 5 seconds' });
   329→      } else {
   330→        error('Daemon failed to start within 5 seconds');
   331→      }
   332→      process.exit(EXIT_CODES.ERROR);
   333→    }
   334→  } else {
   335→    // AC: @cli-serve-commands ac-1 - foreground mode
   336→    if (!isJsonMode()) {
   337→      info(`Starting server in foreground on port ${port}...`);
   338→      info('Press Ctrl+C to stop');
   339→    }
   340→
   341→    const runtime = 'bun';
   342→
   343→    // Set BUN_ENV=production to prevent Bun dev mode HTML transformation
   344→    const child = spawn(runtime, [daemonBinary, '--port', String(port), '--kspec-dir', opts.kspecDir], {
   345→      stdio: 'inherit',
   346→      cwd: process.cwd(),
   347→      env: { ...process.env, BUN_ENV: 'production' },
   348→    });
   349→
   350→    // Handle Ctrl+C - forward SIGTERM to child for graceful shutdown
   351→    process.on('SIGINT', () => {
   352→      if (!isJsonMode()) {
   353→        info('\nStopping server...');
   354→      }
   355→      child.kill('SIGTERM');
   356→
   357→      // Wait for graceful shutdown (max 5 seconds)
   358→      const shutdownTimeout = setTimeout(() => {
   359→        child.kill('SIGKILL'); // Force kill if not stopped
   360→      }, 5000);
   361→
   362→      child.on('exit', () => {
   363→        clearTimeout(shutdownTimeout);
   364→      });
   365→    });
   366→
   367→    // Wait for process to exit
   368→    child.on('exit', (code) => {
   369→      process.exit(code ?? 0);
   370→    });
   371→  }
   372→}
   373→
   374→/**
   375→ * Stop the daemon server
   376→ * AC: @cli-serve-commands ac-4 (stop), ac-5 (idempotent)
   377→ */
   378→async function stopServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {
   379→  // AC: @cli-serve-commands ac-11
   380→  guardAgentContext('stop');
   381→
   382→  const pidManager = new PidFileManager();
   383→
   384→  if (!pidManager.isDaemonRunning()) {
   385→    // AC: @cli-serve-commands ac-5
   386→    if (isJsonMode()) {
   387→      output({ running: false });
   388→    } else {
   389→      info('Daemon not running');
   390→      output({ running: false });
   391→    }
   392→    process.exit(EXIT_CODES.SUCCESS);
   393→  }
   394→
   395→  const pid = pidManager.readPid();
   396→  if (!pid) {
   397→    if (isJsonMode()) {
   398→      output({ error: 'Failed to read PID file' });
   399→    } else {
   400→      error('Failed to read PID file');
   401→    }
   402→    process.exit(EXIT_CODES.ERROR);
   403→  }
   404→
   405→  // AC: @cli-serve-commands ac-4
   406→  if (!isJsonMode()) {
   407→    info(`Stopping daemon (PID ${pid})...`);
   408→  }
   409→
   410→  try {
   411→    // Send SIGTERM
   412→    process.kill(pid, 'SIGTERM');
   413→
   414→    // Wait for clean shutdown (max 5 seconds)
   415→    const maxWait = 5000;
   416→    const startTime = Date.now();
   417→    while (Date.now() - startTime < maxWait) {
   418→      if (!pidManager.isDaemonRunning()) {
   419→        break;
   420→      }
   421→      await new Promise(resolve => setTimeout(resolve, 100));
   422→    }
   423→
   424→    if (pidManager.isDaemonRunning()) {
   425→      if (!isJsonMode()) {
   426→        warn(`Daemon did not stop gracefully, forcing...`);
   427→      }
   428→      process.kill(pid, 'SIGKILL');
   429→      await new Promise(resolve => setTimeout(resolve, 500));
   430→    }
   431→
   432→    if (isJsonMode()) {
   433→      output({ stopped: true, pid });
   434→    } else {
   435→      success('Daemon stopped');
   436→      output({ stopped: true, pid });
   437→    }
   438→  } catch (err) {
   439→    if (isJsonMode()) {
   440→      output({ error: err instanceof Error ? err.message : String(err) });
   441→    } else {
   442→      error(`Failed to stop daemon: ${err instanceof Error ? err.message : String(err)}`);
   443→    }
   444→    process.exit(EXIT_CODES.ERROR);
   445→  }
   446→}
   447→
   448→/**
   449→ * Check daemon server status
   450→ * AC: @cli-serve-commands ac-6, @multi-directory-daemon ac-12
   451→ */
   452→async function statusServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {
   453→  if (isJsonMode()) {
   454→  }
   455→
   456→  const pidManager = new PidFileManager();
   457→  const running = pidManager.isDaemonRunning();
   458→  const pid = pidManager.readPid();
   459→
   460→  // Read port from global config (AC: @multi-directory-daemon ac-13)
   461→  let port: number | null = null;
   462→  if (running) {
   463→    try {
   464→      port = pidManager.readPort();
   465→    } catch {
   466→      // Port file might not exist or be invalid
   467→      port = null;
   468→    }
   469→  }
   470→
   471→  // AC: @multi-directory-daemon ac-12 - Fetch list of registered projects and uptime
   472→  let projects: Array<{ path: string; registeredAt: string; watcherStatus: string }> = [];
   473→  let uptime: number | null = null;
   474→  if (running && port) {
   475→    try {
   476→      const response = await fetch(`http://localhost:${port}/api/projects`);
   477→      if (response.ok) {
   478→        const data = await response.json() as { projects: Array<{ path: string; registeredAt: string; watcherStatus: string }> };
   479→        projects = data.projects || [];
   480→      }
   481→    } catch {
   482→      // If daemon is not responding, continue without projects list
   483→      // This can happen if daemon is still starting up or network issues
   484→    }
   485→
   486→    // Fetch uptime from health endpoint.
   487→    // Retry briefly to reduce startup races where status is checked immediately after daemon start.
   488→    for (let attempt = 1; attempt <= 5 && uptime === null; attempt++) {
   489→      try {
   490→        const healthResponse = await fetch(`http://localhost:${port}/api/health`);
   491→        if (healthResponse.ok) {
   492→          const healthData = await healthResponse.json() as { status: string; uptime?: unknown };
   493→          const parsed = parseUptimeSeconds(healthData.uptime);
   494→          if (parsed !== null) {
   495→            uptime = parsed;
   496→            break;
   497→          }
   498→        }
   499→      } catch {
   500→        // If health endpoint fails, continue retry loop.
   501→      }
   502→
   503→      if (attempt < 5) {
   504→        await new Promise(resolve => setTimeout(resolve, 200));
   505→      }
   506→    }
   507→  }
   508→
   509→  const status = {
   510→    running,
   511→    pid: pid ?? null,
   512→    port,
   513→    uptime,
   514→    projects,
   515→  };
   516→
   517→  if (isJsonMode()) {
   518→    output(status);
   519→  } else {
   520→    if (running) {
   521→      output(`Daemon running (PID: ${pid})`);
   522→      if (port) {
   523→        output(`  Port: ${port}`);
   524→      }
   525→      // AC: @multi-directory-daemon ac-12 - Show uptime
   526→      if (uptime !== null) {
   527→        const hours = Math.floor(uptime / 3600);
   528→        const minutes = Math.floor((uptime % 3600) / 60);
   529→        const seconds = Math.floor(uptime % 60);
   530→        if (hours > 0) {
   531→          output(`  Uptime: ${hours}h ${minutes}m ${seconds}s`);
   532→        } else if (minutes > 0) {
   533→          output(`  Uptime: ${minutes}m ${seconds}s`);
   534→        } else {
   535→          output(`  Uptime: ${seconds}s`);
   536→        }
   537→      }
   538→      // AC: @multi-directory-daemon ac-12 - Show registered projects
   539→      if (projects.length > 0) {
   540→        output(`\nRegistered projects (${projects.length}):`);
   541→        for (const project of projects) {
   542→          output(`  ${project.path} (watcher: ${project.watcherStatus})`);
   543→        }
   544→      } else {
   545→        output(`\nNo projects registered`);
   546→      }
   547→    } else {
   548→      output('Daemon not running');
   549→    }
   550→  }
   551→}
   552→
   553→/**
   554→ * Restart the daemon server
   555→ * AC: @cli-serve-commands ac-7
   556→ */
   557→async function restartServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {
   558→  // AC: @cli-serve-commands ac-11
   559→  guardAgentContext('restart');
   560→  const pidManager = new PidFileManager();
   561→
   562→  // AC: @cli-serve-commands ac-7 - preserve port across restarts
   563→  // Try to read port from existing daemon, otherwise startServer will use config default
   564→  let port: string | undefined;
   565→  try {
   566→    port = pidManager.readPort().toString();
   567→  } catch {
   568→    // Port file doesn't exist or is invalid, let startServer use config
   569→  }
   570→
   571→  if (pidManager.isDaemonRunning()) {
   572→    if (!isJsonMode()) {
   573→      info('Stopping daemon...');
   574→    }
   575→    await stopServer(opts);
   576→  }
   577→
   578→  if (!isJsonMode()) {
   579→    info('Starting daemon...');
   580→  }
   581→  await startServer({ daemon: true, port, kspecDir: opts.kspecDir });
   582→}
