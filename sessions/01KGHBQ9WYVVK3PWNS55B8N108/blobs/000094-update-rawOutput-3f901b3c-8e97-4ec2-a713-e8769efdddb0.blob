    65→
    66→// ─── Task Limit Marker ──────────────────────────────────────────────────────
    67→
    68→/**
    69→ * Marker file schema for task limit enforcement.
    70→ * AC: @ralph-task-limit ac-marker-format
    71→ */
    72→interface TaskLimitMarker {
    73→  active: boolean;
    74→  since: string; // ISO8601
    75→  max: number;
    76→  completed: number;
    77→  sessionId: string;
    78→}
    79→
    80→const TASK_LIMIT_MARKER_PATH = ".claude/ralph-task-limit.json";
    81→const END_ITERATION_MARKER_PATH = ".claude/ralph-end-iteration.json";
    82→const STALE_MARKER_THRESHOLD_MS = 60 * 60 * 1000; // 1 hour
    83→
    84→// ─── End Iteration Marker ───────────────────────────────────────────────────
    85→
    86→/**
    87→ * Marker file schema for explicit end-iteration signaling.
    88→ * AC: @ralph-end-iteration ac-cmd
    89→ */
    90→interface EndIterationMarker {
    91→  requested: boolean;
    92→  timestamp: string; // ISO8601
    93→  reason?: string;
    94→}
    95→
    96→/**
    97→ * Write task limit marker file.
    98→ * AC: @ralph-task-limit ac-wrapup, ac-marker-format
    99→ */
   100→async function writeTaskLimitMarker(
   101→  rootDir: string,
   102→  marker: TaskLimitMarker,
   103→): Promise<void> {
   104→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   105→  const dir = path.dirname(markerPath);
   106→  await fs.mkdir(dir, { recursive: true });
   107→  await fs.writeFile(markerPath, JSON.stringify(marker, null, 2));
   108→}
   109→
   110→/**
   111→ * Read task limit marker file if it exists.
   112→ */
   113→async function readTaskLimitMarker(
   114→  rootDir: string,
   115→): Promise<TaskLimitMarker | null> {
   116→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   117→  try {
   118→    const content = await fs.readFile(markerPath, "utf-8");
   119→    return JSON.parse(content) as TaskLimitMarker;
   120→  } catch {
   121→    return null;
   122→  }
   123→}
   124→
   125→/**
   126→ * Clear task limit marker file.
   127→ * AC: @ralph-task-limit ac-reset
   128→ */
   129→async function clearTaskLimitMarker(rootDir: string): Promise<void> {
   130→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   131→  try {
   132→    await fs.unlink(markerPath);
   133→  } catch {
   134→    // Ignore if file doesn't exist
   135→  }
   136→}
   137→
   138→/**
   139→ * Clear stale marker files (older than 1 hour).
   140→ * AC: @ralph-task-limit ac-reset
   141→ */
   142→async function clearStaleMarker(rootDir: string): Promise<boolean> {
   143→  const marker = await readTaskLimitMarker(rootDir);
   144→  if (!marker) return false;
   145→
   146→  const markerAge = Date.now() - new Date(marker.since).getTime();
   147→  if (markerAge > STALE_MARKER_THRESHOLD_MS) {
   148→    await clearTaskLimitMarker(rootDir);
   149→    return true;
   150→  }
   151→  return false;
   152→}
   153→
   154→/**
   155→ * Write end-iteration marker file.
   156→ * AC: @ralph-end-iteration ac-cmd
   157→ */
   158→async function writeEndIterationMarker(
   159→  rootDir: string,
   160→  reason?: string,
   161→): Promise<void> {
   162→  const markerPath = path.join(rootDir, END_ITERATION_MARKER_PATH);
   163→  const dir = path.dirname(markerPath);
   164→  await fs.mkdir(dir, { recursive: true });
   165→  const marker: EndIterationMarker = {
   166→    requested: true,
   167→    timestamp: new Date().toISOString(),
   168→    reason,
   169→  };
   170→  await fs.writeFile(markerPath, JSON.stringify(marker, null, 2));
   171→}
   172→
   173→/**
   174→ * Read end-iteration marker file if it exists.
   175→ * AC: @ralph-end-iteration ac-detect
   176→ */
   177→async function readEndIterationMarker(
   178→  rootDir: string,
   179→): Promise<EndIterationMarker | null> {
   180→  const markerPath = path.join(rootDir, END_ITERATION_MARKER_PATH);
   181→  try {
   182→    const content = await fs.readFile(markerPath, "utf-8");
   183→    return JSON.parse(content) as EndIterationMarker;
   184→  } catch {
   185→    return null;
   186→  }
   187→}
   188→
   189→/**
   190→ * Clear end-iteration marker file.
   191→ * AC: @ralph-end-iteration ac-cleanup
   192→ */
   193→async function clearEndIterationMarker(rootDir: string): Promise<void> {
   194→  const markerPath = path.join(rootDir, END_ITERATION_MARKER_PATH);
   195→  try {
   196→    await fs.unlink(markerPath);
   197→  } catch {
   198→    // Ignore if file doesn't exist
   199→  }
   200→}
   201→
   202→/**
   203→ * Clear stale end-iteration markers (older than 1 hour).
   204→ * AC: @ralph-end-iteration ac-cleanup
   205→ */
   206→async function clearStaleEndIterationMarker(rootDir: string): Promise<boolean> {
   207→  const marker = await readEndIterationMarker(rootDir);
   208→  if (!marker) return false;
   209→
   210→  const markerAge = Date.now() - new Date(marker.timestamp).getTime();
   211→  if (markerAge > STALE_MARKER_THRESHOLD_MS) {
   212→    await clearEndIterationMarker(rootDir);
   213→    return true;
   214→  }
   215→  return false;
   216→}
   217→
   218→/**
   219→ * Detect if a Bash command is a task complete command.
   220→ * AC: @ralph-task-limit ac-detection
   221→ */
   222→function detectTaskCompleteCommand(command: string): boolean {
   223→  // Match variations of "kspec task complete"
   224→  // Don't match "kspec task submit" - that's just status change to pending_review
   225→  return /\bkspec\s+task\s+complete\b/.test(command);
   226→}
   227→
   228→/**
   229→ * Detect if a Bash command is an end-iteration command.
   230→ * AC: @ralph-end-iteration ac-detect
   231→ */
   232→function detectEndIterationCommand(command: string): boolean {
   233→  // Match "kspec ralph end-iteration" with any arguments
   234→  return /\bkspec\s+ralph\s+end-iteration\b/.test(command);
   235→}
   236→
   237→/**
   238→ * Extract Bash command from SessionUpdate if it's a tool_call or tool_call_update event.
   239→ * Returns null if not a Bash tool call.
   240→ */
   241→function extractBashCommand(update: SessionUpdate): string | null {
   242→  const u = update as Record<string, unknown>;
   243→
   244→  // Check if this is a tool call event
   245→  if (u.sessionUpdate !== "tool_call" && u.sessionUpdate !== "tool_call_update") {
   246→    return null;
   247→  }
   248→
   249→  // Extract tool name - check various locations Claude Code uses
   250→  let toolName: string | undefined;
   251→
   252→  // Try _meta.claudeCode.toolName first (Claude Code pattern)
   253→  const meta = u._meta as Record<string, unknown> | undefined;
   254→  if (meta) {
   255→    const claudeCode = meta.claudeCode as Record<string, unknown> | undefined;
   256→    if (claudeCode?.toolName) {
   257→      toolName = String(claudeCode.toolName);
   258→    } else if (meta.toolName) {
   259→      toolName = String(meta.toolName);
   260→    }
   261→  }
   262→
   263→  // Fall back to name or title field
   264→  if (!toolName && u.name) {
   265→    toolName = String(u.name);
   266→  }
   267→  if (!toolName && u.title) {
   268→    toolName = String(u.title);
   269→  }
   270→
   271→  // Check if it's a Bash tool (handle MCP prefix variations)
   272→  if (!toolName) return null;
   273→  const isBash = toolName === "Bash" || toolName.endsWith("__Bash");
   274→  if (!isBash) return null;
   275→
   276→  // Extract command from input
   277→  const input = (u.rawInput || u.input || u.params) as Record<string, unknown> | undefined;
   278→  if (!input) return null;
   279→
   280→  const command = input.command;
   281→  if (typeof command !== "string") return null;
   282→
   283→  return command;
   284→}
   285→
   286→// ─── Prompt Template ─────────────────────────────────────────────────────────
   287→
   288→// AC: @ralph-skill-delegation ac-1, ac-2, ac-3
   289→function buildTaskWorkPrompt(
   290→  sessionCtx: SessionContext,
   291→  iteration: number,
   292→  maxLoops: number,
   293→  sessionId: string,
   294→  focus?: string,
   295→): string {
   296→  const focusSection = focus
   297→    ? `
   298→## Session Focus (applies to ALL iterations)
   299→
   300→> **${focus}**
   301→
   302→Keep this focus in mind throughout your work. It takes priority over default task selection.
   303→`
   304→    : "";
   305→
   306→  return `# Kspec Automation Session - Task Work
   307→
   308→**Session ID:** \`${sessionId}\`
   309→**Iteration:** ${iteration} of ${maxLoops}
   310→**Mode:** Automated (no human in the loop)
   311→${focusSection}
   312→
   313→## Current State
   314→\`\`\`json
   315→${JSON.stringify(sessionCtx, null, 2)}
   316→\`\`\`
   317→
   318→## Instructions
   319→
   320→Run the task-work skill in loop mode:
   321→
   322→\`\`\`
   323→/task-work loop
   324→\`\`\`
   325→
   326→Loop mode means: no confirmations, auto-resolve decisions, automation-eligible tasks only.
   327→
   328→Exit when task work is complete or no eligible tasks remain.
   329→`;
   330→}
   331→
   332→/**
   333→ * Build the reflect prompt sent after task-work completes.
   334→ * Ralph sends this as a separate prompt to ensure reflection always happens.
   335→ */
   336→function buildReflectPrompt(
   337→  iteration: number,
   338→  maxLoops: number,
   339→  sessionId: string,
   340→): string {
   341→  const isFinal = iteration === maxLoops;
   342→
   343→  return `# Kspec Automation Session - Reflection
   344→
   345→**Session ID:** \`${sessionId}\`
   346→**Iteration:** ${iteration} of ${maxLoops}
   347→**Phase:** Post-task reflection
   348→
   349→## Instructions
   350→
   351→Run the reflect skill in loop mode:
   352→
   353→\`\`\`
   354→/reflect loop
   355→\`\`\`
   356→
   357→Loop mode means: high-confidence captures only, must search existing before capturing, no user prompts.
   358→${
   359→  isFinal
   360→    ? `
   361→**FINAL ITERATION** - This is the last chance to capture insights from this session.
   362→`
   363→    : ""
   364→}
   365→Exit when reflection is complete.
   366→`;
   367→}
