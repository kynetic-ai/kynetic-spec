   369→// ─── Streaming Output ────────────────────────────────────────────────────────
   370→
   371→// Translator and renderer are created per-session in the action handler.
   372→// This allows the architecture to be reused by future TUI renderers.
   373→
   374→// ─── Adapter Validation ──────────────────────────────────────────────────────
   375→
   376→// AC: @ralph-adapter-validation valid-adapter-proceeds, invalid-adapter-error, validation-before-spawn
   377→/**
   378→ * Validate that the specified ACP adapter package exists.
   379→ * Uses npx --no-install to check both global and local node_modules.
   380→ *
   381→ * @throws {Error} Never throws - exits process with code 3 if validation fails
   382→ */
   383→function validateAdapter(adapterPackage: string): void {
   384→  // Use npx --no-install with --version to check if package exists
   385→  // This checks both global and local node_modules, handles scoped packages
   386→  const result = spawnSync(
   387→    "npx",
   388→    ["--no-install", adapterPackage, "--version"],
   389→    {
   390→      encoding: "utf-8",
   391→      stdio: "pipe",
   392→    },
   393→  );
   394→
   395→  if (result.status !== 0) {
   396→    error(
   397→      `Adapter package not found: ${adapterPackage}. Install with: npm install -g ${adapterPackage}`,
   398→    );
   399→    process.exit(EXIT_CODES.NOT_FOUND);
   400→  }
   401→}
   402→
   403→// ─── Tool Request Handler ────────────────────────────────────────────────────
   404→
   405→/**
   406→ * Handle tool requests from ACP agent.
   407→ * Implements file operations, terminal commands, and permission handling.
   408→ */
   409→async function handleRequest(
   410→  client: ACPClient,
   411→  id: string | number,
   412→  method: string,
   413→  params: unknown,
   414→  yolo: boolean,
   415→): Promise<void> {
   416→  try {
   417→    switch (method) {
   418→      case "session/request_permission": {
   419→        const p = params as RequestPermissionRequest;
   420→        // In yolo mode, auto-approve all permissions
   421→        // In normal mode, would need to implement permission UI
   422→        const options = p.options || [];
   423→
   424→        if (yolo) {
   425→          // Find an "allow" option (prefer allow_always, then allow_once)
   426→          const allowOption =
   427→            options.find((o) => o.kind === "allow_always") ||
   428→            options.find((o) => o.kind === "allow_once");
   429→
   430→          if (allowOption) {
   431→            client.respondPermission(id, {
   432→              outcome: { outcome: "selected", optionId: allowOption.optionId },
   433→            });
   434→          } else {
   435→            // No allow option available - cancel
   436→            client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   437→          }
   438→        } else {
   439→          // TODO: Implement permission prompting
   440→          client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   441→        }
   442→        break;
   443→      }
   444→
   445→      case "file/read": {
   446→        const p = params as ReadTextFileRequest;
   447→        const content = await fs.readFile(p.path, "utf-8");
   448→        client.respondReadTextFile(id, { content });
   449→        break;
   450→      }
   451→
   452→      case "file/write": {
   453→        const p = params as WriteTextFileRequest;
   454→        await fs.mkdir(path.dirname(p.path), { recursive: true });
   455→        await fs.writeFile(p.path, p.content, "utf-8");
   456→        client.respondWriteTextFile(id, {});
   457→        break;
   458→      }
   459→
   460→      case "terminal/run": {
   461→        // Custom method (not part of ACP spec - ACP uses createTerminal instead)
   462→        // TODO: Consider migrating to standard ACP terminal methods
   463→        const p = params as {
   464→          command: string;
   465→          cwd?: string;
   466→          timeout?: number;
   467→        };
   468→        const command = p.command;
   469→        const cwd = p.cwd || process.cwd();
   470→        const timeout = p.timeout || 60000;
   471→
   472→        const result = await new Promise<{
   473→          stdout: string;
   474→          stderr: string;
   475→          exitCode: number;
   476→        }>((resolve) => {
   477→          const child = spawn(command, [], {
   478→            cwd,
   479→            shell: true,
   480→            timeout,
   481→          });
   482→
   483→          let stdout = "";
   484→          let stderr = "";
   485→
   486→          child.stdout?.on("data", (data) => {
   487→            stdout += data.toString();
   488→          });
   489→
   490→          child.stderr?.on("data", (data) => {
   491→            stderr += data.toString();
   492→          });
   493→
   494→          child.on("close", (code) => {
   495→            resolve({ stdout, stderr, exitCode: code ?? 1 });
   496→          });
   497→
   498→          child.on("error", (err) => {
   499→            resolve({ stdout, stderr: err.message, exitCode: 1 });
   500→          });
   501→        });
   502→
   503→        // Using generic respond() since this is a custom method
   504→        client.respond(id, result);
   505→        break;
   506→      }
   507→
   508→      default:
   509→        // Unknown method - return error
   510→        client.respondError(id, -32601, `Method not found: ${method}`);
   511→    }
   512→  } catch (err) {
   513→    const message = err instanceof Error ? err.message : String(err);
   514→    client.respondError(id, -32000, message);
   515→  }
   516→}
   517→
   518→// ─── Subagent Support ─────────────────────────────────────────────────────────
   519→
   520→/**
   521→ * Build context for a PR review subagent.
   522→ * AC: @ralph-subagent-spawning ac-10
   523→ */
   524→async function buildSubagentContext(
   525→  ctx: KspecContext,
   526→  taskRef: string,
   527→): Promise<SubagentContext> {
   528→  // Load all tasks and items
   529→  const tasks = await loadAllTasks(ctx);
   530→  const items = await loadAllItems(ctx);
   531→  const index = new ReferenceIndex(tasks, items);
   532→
   533→  // Resolve task reference
   534→  const taskResult = index.resolve(taskRef);
   535→  if (!taskResult.ok) {
   536→    throw new Error(`Task not found: ${taskRef}`);
   537→  }
   538→
   539→  const task = tasks.find((t) => t._ulid === taskResult.ulid);
   540→  if (!task) {
   541→    throw new Error(`Task not found by ULID: ${taskResult.ulid}`);
   542→  }
   543→
   544→  // Get linked spec with ACs if spec_ref exists
   545→  let specWithACs: Record<string, unknown> | null = null;
   546→  if (task.spec_ref) {
   547→    const specResult = index.resolve(task.spec_ref);
   548→    if (specResult.ok) {
   549→      const item = items.find((i) => i._ulid === specResult.ulid);
   550→      if (item) {
   551→        specWithACs = item as unknown as Record<string, unknown>;
   552→      }
   553→    }
   554→  }
   555→
   556→  // Get git branch
   557→  const gitBranch = getCurrentBranch(ctx.rootDir) || "unknown";
   558→
   559→  return {
   560→    taskRef,
   561→    taskDetails: task as unknown as Record<string, unknown>,
   562→    specWithACs,
   563→    gitBranch,
   564→  };
   565→}
   566→
   567→/**
   568→ * Check if a task was completed by the subagent.
   569→ * AC: @ralph-subagent-spawning ac-12
   570→ */
   571→async function verifyTaskCompleted(taskRef: string): Promise<boolean> {
   572→  const result = spawnSync("kspec", ["task", "get", taskRef, "--json"], {
   573→    encoding: "utf-8",
   574→    stdio: "pipe",
   575→  });
   576→
   577→  if (result.status !== 0) {
   578→    warn(`Failed to check task status for ${taskRef}: ${result.stderr}`);
   579→    return false;
   580→  }
   581→
   582→  try {
   583→    const task = JSON.parse(result.stdout);
   584→    return task.status === "completed";
   585→  } catch {
   586→    warn(`Failed to parse task status for ${taskRef}`);
   587→    return false;
   588→  }
   589→}
   590→
   591→/**
   592→ * Mark a task as needing review due to subagent timeout.
   593→ * AC: @ralph-subagent-spawning ac-9
   594→ */
   595→async function markTaskNeedsReview(
   596→  taskRef: string,
   597→  reason: string,
   598→): Promise<void> {
   599→  const { spawnSync } = await import("node:child_process");
   600→
   601→  // Use kspec CLI to set automation status
   602→  const result = spawnSync(
   603→    "kspec",
   604→    ["task", "set-automation", taskRef, "needs_review"],
   605→    {
   606→      encoding: "utf-8",
   607→      stdio: "pipe",
   608→    },
   609→  );
   610→
   611→  if (result.status !== 0) {
   612→    warn(`Failed to mark task ${taskRef} as needs_review: ${result.stderr}`);
   613→  }
   614→
   615→  // Add a note explaining the timeout
   616→  const noteResult = spawnSync(
   617→    "kspec",
   618→    ["task", "note", taskRef, `[RALPH SUBAGENT] ${reason}`],
   619→    {
   620→      encoding: "utf-8",
   621→      stdio: "pipe",
   622→    },
   623→  );
   624→
   625→  if (noteResult.status !== 0) {
   626→    warn(`Failed to add timeout note to task ${taskRef}: ${noteResult.stderr}`);
   627→  }
   628→}
   629→
   630→/**
   631→ * Handle failed iteration by tracking per-task failures and escalating at threshold.
   632→ * AC: @loop-mode-error-handling ac-1, ac-2, ac-3, ac-4, ac-5, ac-8
   633→ */
   634→async function handleIterationFailure(
   635→  ctx: KspecContext,
   636→  tasksInProgressAtStart: ActiveTaskSummary[],
   637→  iterationStartTime: Date,
   638→  errorDescription: string,
   639→): Promise<void> {
   640→  if (tasksInProgressAtStart.length === 0) {
   641→    return;
   642→  }
   643→
   644→  // Re-load current tasks to check progress
   645→  const currentTasks = await loadAllTasks(ctx);
   646→  const index = new ReferenceIndex(currentTasks, await loadAllItems(ctx));
   647→
   648→  // Convert ActiveTaskSummary to Task-like objects for processing
   649→  const tasksInProgressFull = tasksInProgressAtStart
   650→    .map((summary) => {
   651→      const resolved = index.resolve(summary.ref);
   652→      if (!resolved.ok) return undefined;
   653→      // Check if the resolved item is a task (not a spec item or meta item)
   654→      const item = resolved.item;
   655→      if (!("status" in item)) return undefined; // Spec items don't have status
   656→      return currentTasks.find((t) => t._ulid === resolved.ulid);
   657→    })
   658→    .filter((t): t is LoadedTask => t !== undefined && t.status === "in_progress");
   659→
   660→  if (tasksInProgressFull.length === 0) {
   661→    return;
   662→  }
   663→
   664→  // Process failures
   665→  const { processFailedIteration, createFailureNote, getTaskFailureCount } = await import("../../ralph/index.js");
   666→
   667→  const results = processFailedIteration(
   668→    tasksInProgressFull,
   669→    currentTasks,
   670→    iterationStartTime,
   671→    errorDescription,
   672→  );
   673→
   674→  // Add notes and escalate tasks
   675→  for (const result of results) {
   676→    const taskRef = result.taskRef;
   677→    const task = currentTasks.find((t) => t._ulid === taskRef);
   678→    if (!task) continue;
   679→
   680→    const priorCount = result.failureCount - 1;
   681→    const noteContent = createFailureNote(taskRef, errorDescription, priorCount);
   682→
   683→    // Add LOOP-FAIL note
   684→    const noteResult = spawnSync(
   685→      "kspec",
   686→      ["task", "note", `@${taskRef}`, noteContent],
   687→      {
   688→        encoding: "utf-8",
   689→        stdio: "pipe",
   690→        cwd: process.cwd(),
   691→      },
   692→    );
   693→
   694→    if (noteResult.status !== 0) {
   695→      warn(`Failed to add failure note to task ${taskRef}: ${noteResult.stderr}`);
   696→      continue;
   697→    }
   698→
   699→    // AC: @loop-mode-error-handling ac-5 - Escalate at threshold
   700→    if (result.escalated) {
   701→      const escalateResult = spawnSync(
   702→        "kspec",
   703→        [
   704→          "task",
   705→          "set",
   706→          `@${taskRef}`,
   707→          "--automation",
   708→          "needs_review",
   709→          "--reason",
   710→          `Loop mode: 3 consecutive failures without progress`,
   711→        ],
   712→        {
   713→          encoding: "utf-8",
   714→          stdio: "pipe",
   715→          cwd: process.cwd(),
   716→        },
   717→      );
   718→
   719→      if (escalateResult.status !== 0) {
   720→        warn(`Failed to escalate task ${taskRef}: ${escalateResult.stderr}`);
   721→      } else {
   722→        info(`Escalated task ${taskRef} to automation:needs_review after 3 failures`);
   723→      }
   724→    }
   725→  }
   726→}
   727→
   728→/**
   729→ * Process pending_review tasks by spawning subagents.
   730→ * AC: @ralph-subagent-spawning ac-6, ac-8
   731→ */
   732→async function processPendingReviewTasks(
   733→  ctx: KspecContext,
   734→  adapter: AgentAdapter,
   735→  pendingReviewTasks: ActiveTaskSummary[],
   736→  options: {
   737→    yolo: boolean;
   738→    maxRetries: number;
   739→    maxFailures: number;
   740→    cwd: string;
   741→  },
   742→  consecutiveFailures: { count: number },
   743→): Promise<boolean> {
   744→  if (pendingReviewTasks.length === 0) {
   745→    return true;
   746→  }
   747→
   748→  info(
   749→    `${DEFAULT_SUBAGENT_PREFIX} Found ${pendingReviewTasks.length} pending_review task(s)`,
   750→  );
   751→
   752→  // AC: @ralph-subagent-spawning ac-6 - Process one at a time
   753→  for (const task of pendingReviewTasks) {
   754→    info(`${DEFAULT_SUBAGENT_PREFIX} Processing: ${task.ref} - ${task.title}`);
   755→
   756→    try {
   757→      // Build context for this task
   758→      const subagentCtx = await buildSubagentContext(ctx, task.ref);
   759→
   760→      // AC: @ralph-subagent-spawning ac-1, ac-3 - Spawn and wait
   761→      const result = await runSubagent(
   762→        adapter,
   763→        subagentCtx,
   764→        {
   765→          timeout: DEFAULT_SUBAGENT_TIMEOUT,
   766→          outputPrefix: DEFAULT_SUBAGENT_PREFIX,
   767→        },
   768→        {
   769→          yolo: options.yolo,
   770→          cwd: options.cwd,
   771→          handleRequest: (client, reqId, method, params) =>
   772→            handleRequest(client, reqId, method, params, options.yolo),
   773→        },
   774→      );
   775→
   776→      if (result.timedOut) {
   777→        // AC: @ralph-subagent-spawning ac-9
   778→        warn(
   779→          `${DEFAULT_SUBAGENT_PREFIX} Subagent timed out for ${task.ref}`,
   780→        );
   781→        await markTaskNeedsReview(
   782→          task.ref,
   783→          "Subagent timed out after 10 minutes",
   784→        );
   785→        consecutiveFailures.count++;
   786→      } else if (!result.success) {
   787→        // AC: @ralph-subagent-spawning ac-7
   788→        error(
   789→          `${DEFAULT_SUBAGENT_PREFIX} Subagent failed for ${task.ref}: ${result.error}`,
   790→        );
   791→        consecutiveFailures.count++;
   792→      } else {
   793→        // AC: @ralph-subagent-spawning ac-12 - Verify task was completed
   794→        const wasCompleted = await verifyTaskCompleted(task.ref);
   795→        if (wasCompleted) {
   796→          success(`${DEFAULT_SUBAGENT_PREFIX} Completed: ${task.ref}`);
   797→          consecutiveFailures.count = 0;
   798→        } else {
   799→          // Task wasn't completed - subagent likely exited early
   800→          warn(
   801→            `${DEFAULT_SUBAGENT_PREFIX} Subagent succeeded but task ${task.ref} is still pending_review`,
   802→          );
   803→          await markTaskNeedsReview(
   804→            task.ref,
   805→            "Subagent merged PR but did not complete the task. Review required to verify merge and complete task manually.",
   806→          );
   807→          consecutiveFailures.count++;
   808→        }
   809→      }
   810→
   811→      // Check if we've hit max failures
   812→      if (consecutiveFailures.count >= options.maxFailures) {
   813→        error(
   814→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
   815→        );
   816→        return false;
   817→      }
   818→    } catch (err) {
   819→      const message = err instanceof Error ? err.message : String(err);
   820→      error(`${DEFAULT_SUBAGENT_PREFIX} Error processing ${task.ref}: ${message}`);
   821→      consecutiveFailures.count++;
   822→
   823→      if (consecutiveFailures.count >= options.maxFailures) {
   824→        error(
   825→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
   826→        );
   827→        return false;
   828→      }
   829→    }
   830→  }
   831→
   832→  return true;
   833→}
   834→
   835→// ─── Command Registration ────────────────────────────────────────────────────
   836→
   837→export function registerRalphCommand(program: Command): void {
   838→  const ralph = program
   839→    .command("ralph")
   840→    .description("Ralph automated task loop and agent control");
   841→
   842→  // end-iteration subcommand - allows agent to signal loop end
   843→  // AC: @ralph-end-iteration ac-cmd, ac-reason, ac-noop-outside
   844→  ralph
   845→    .command("end-iteration")
   846→    .description("Signal ralph to end the current iteration gracefully")
   847→    .option("--reason <reason>", "Reason for ending the iteration")
   848→    .action(async (options) => {
   849→      try {
   850→        const ctx = await initContext();
   851→
   852→        // Check if we're in a ralph session by looking for any ralph marker
   853→        const taskLimitMarker = await readTaskLimitMarker(ctx.rootDir);
   854→        const endIterationMarker = await readEndIterationMarker(ctx.rootDir);
   855→
   856→        // Write the marker with reason if provided
   857→        await writeEndIterationMarker(ctx.rootDir, options.reason);
   858→
   859→        // Determine if we're likely in a ralph session
   860→        const inRalphSession = taskLimitMarker !== null || endIterationMarker !== null;
   861→
   862→        if (!inRalphSession) {
   863→          // AC: @ralph-end-iteration ac-noop-outside
   864→          warn("No active ralph session detected. Marker written but may have no effect.");
   865→          info("This command is designed to be called by agents during a ralph loop.");
   866→        } else {
   867→          success("End-iteration signal sent");
   868→        }
   869→
   870→        if (options.reason) {
   871→          info(`Reason: ${options.reason}`);
   872→        }
   873→      } catch (err) {
   874→        error("Failed to signal end-iteration", err);
   875→        process.exit(EXIT_CODES.ERROR);
   876→      }
   877→    });
   878→
   879→  // Main ralph run command (default behavior when ralph is called directly)
   880→  ralph
   881→    .command("run", { isDefault: true })
   882→    .description("Run ACP agent in a loop to process ready tasks")
   883→    .option("--max-loops <n>", "Maximum iterations", "5")
   884→    .option("--max-retries <n>", "Max retries per iteration on error", "3")
   885→    .option(
   886→      "--max-failures <n>",
   887→      "Max consecutive failed iterations before exit",
   888→      "3",
   889→    )
   890→    .option("--dry-run", "Show prompt without executing")
   891→    .option("--yolo", "Use dangerously-skip-permissions (default)", true)
   892→    .option("--no-yolo", "Require normal permission prompts")
   893→    .option("--adapter <id>", "Agent adapter to use", "claude-code-acp")
   894→    .option("--adapter-cmd <cmd>", "Custom adapter command (for testing)")
   895→    .option(
   896→      "--restart-every <n>",
   897→      "Restart agent every N iterations to prevent OOM (0 = never)",
   898→      "10",
   899→    )
   900→    .option(
   901→      "--focus <instructions>",
   902→      "Focus instructions included in every iteration prompt",
   903→    )
   904→    .option(
   905→      "--max-tasks <n>",
   906→      "Max tasks per iteration (0 = unlimited)",
   907→      "1",
   908→    )
   909→    .action(async (options) => {
   910→      try {
   911→        const maxLoops = parseInt(options.maxLoops, 10);
   912→        const maxRetries = parseInt(options.maxRetries, 10);
   913→        const maxFailures = parseInt(options.maxFailures, 10);
   914→
   915→        if (Number.isNaN(maxLoops) || maxLoops < 1) {
   916→          error(errors.usage.maxLoopsPositive);
   917→          process.exit(EXIT_CODES.ERROR);
   918→        }
   919→
   920→        if (Number.isNaN(maxRetries) || maxRetries < 0) {
   921→          error(errors.usage.maxRetriesNonNegative);
   922→          process.exit(EXIT_CODES.ERROR);
   923→        }
   924→
   925→        if (Number.isNaN(maxFailures) || maxFailures < 1) {
   926→          error(errors.usage.maxFailuresPositive);
   927→          process.exit(EXIT_CODES.ERROR);
   928→        }
   929→
   930→        const restartEvery = parseInt(options.restartEvery, 10);
   931→        if (Number.isNaN(restartEvery) || restartEvery < 0) {
   932→          error("--restart-every must be a non-negative integer");
   933→          process.exit(EXIT_CODES.ERROR);
   934→        }
   935→
   936→        // AC: @ralph-task-limit ac-flag
   937→        const maxTasks = parseInt(options.maxTasks, 10);
   938→        if (Number.isNaN(maxTasks) || maxTasks < 0 || maxTasks > 999) {
   939→          error("--max-tasks must be 0 (unlimited) or a positive integer up to 999");
   940→          process.exit(EXIT_CODES.USAGE_ERROR);
   941→        }
   942→
   943→        // Handle custom adapter command for testing
   944→        if (options.adapterCmd) {
   945→          const parts = options.adapterCmd.split(/\s+/);
   946→          const customAdapter: AgentAdapter = {
   947→            command: parts[0],
   948→            args: parts.slice(1),
   949→            description: "Custom adapter via --adapter-cmd",
   950→          };
   951→          registerAdapter("custom", customAdapter);
   952→          options.adapter = "custom";
   953→        }
   954→
   955→        // Resolve adapter
   956→        const adapter = resolveAdapter(options.adapter);
   957→
   958→        // Validate adapter package exists before proceeding
   959→        // Skip validation for:
   960→        // - Custom adapters (--adapter-cmd)
   961→        // - Non-npx adapters
   962→        // - Dry-run mode with default adapter (doesn't spawn agent, default may not be installed in CI)
   963→        // Note: If user explicitly specifies --adapter, validate even in dry-run to catch typos
   964→        const isDefaultAdapter = options.adapter === "claude-code-acp";
   965→        const skipValidation =
   966→          options.adapterCmd ||
   967→          adapter.command !== "npx" ||
   968→          !adapter.args[0] ||
   969→          (options.dryRun && isDefaultAdapter);
   970→
   971→        if (!skipValidation) {
   972→          validateAdapter(adapter.args[0]);
   973→        }
   974→
   975→        // Add yolo flag to adapter args if needed
   976→        if (options.yolo && options.adapter === "claude-code-acp") {
   977→          adapter.args = [...adapter.args, "--dangerously-skip-permissions"];
   978→        }
   979→
   980→        const restartInfo =
   981→          restartEvery > 0 ? `, restart every ${restartEvery}` : "";
   982→        const maxTasksInfo =
   983→          maxTasks === 0 ? "unlimited" : `${maxTasks}`;
   984→        info(
   985→          `Starting ralph loop (adapter=${options.adapter}, max ${maxLoops} iterations, ${maxRetries} retries, ${maxFailures} max failures${restartInfo}, max-tasks=${maxTasksInfo})`,
   986→        );
   987→        if (options.focus) {
   988→          info(`Focus: ${options.focus}`);
   989→        }
   990→
   991→        // Initialize kspec context
   992→        const ctx = await initContext();
   993→        const specDir = ctx.specDir;
   994→
   995→        // Create session for event tracking
   996→        const sessionId = ulid();
   997→        await createSession(specDir, {
   998→          id: sessionId,
   999→          agent_type: options.adapter,
  1000→          task_id: undefined, // Will be determined per iteration
  1001→        });
  1002→
  1003→        // Log session start
  1004→        await appendEvent(specDir, {
  1005→          session_id: sessionId,
  1006→          type: "session.start",
  1007→          data: {
  1008→            adapter: options.adapter,
  1009→            maxLoops,
  1010→            maxRetries,
  1011→            maxFailures,
  1012→            maxTasks,
  1013→            yolo: options.yolo,
  1014→            focus: options.focus,
  1015→          },
  1016→        });
  1017→
  1018→        let consecutiveFailures = 0;
  1019→        let agent: SpawnedAgent | null = null;
  1020→        let acpSessionId: string | null = null;
  1021→
  1022→        // AC: @ralph-end-iteration ac-signal-cleanup, @ralph-task-limit ac-signal-cleanup
  1023→        // Signal handlers for cleanup on Ctrl+C or kill
  1024→        // Note: Signal handlers must be synchronous, so we use Promise.finally()
  1025→        // to ensure cleanup completes before exit
  1026→        const signalCleanup = (signal: string) => {
  1027→          info(`Received ${signal}, cleaning up...`);
  1028→          // Kill agent if running
  1029→          if (agent) {
  1030→            agent.kill();
  1031→          }
  1032→          // Clean up marker files, then exit after cleanup completes
  1033→          Promise.all([
  1034→            clearTaskLimitMarker(ctx.rootDir),
  1035→            clearEndIterationMarker(ctx.rootDir),
  1036→          ]).finally(() => {
  1037→            process.exit(0);
  1038→          });
  1039→        };
  1040→        const sigintHandler = () => { signalCleanup("SIGINT"); };
  1041→        const sigtermHandler = () => { signalCleanup("SIGTERM"); };
  1042→        process.on("SIGINT", sigintHandler);
  1043→        process.on("SIGTERM", sigtermHandler);
  1044→
  1045→        // Create translator and renderer for this session
  1046→        const translator = createTranslator();
  1047→        const renderer = createCliRenderer();
  1048→
  1049→        // Task limit state - tracks completions per iteration
  1050→        // AC: @ralph-task-limit ac-reset, ac-wrapup
  1051→        let taskLimitReached = false;
  1052→        let tasksCompletedThisIteration = 0;
  1053→
  1054→        // End-iteration signal state
  1055→        // AC: @ralph-end-iteration ac-detect, ac-graceful
  1056→        let endIterationRequested = false;
  1057→
  1058→        try {
  1059→          for (let iteration = 1; iteration <= maxLoops; iteration++) {
  1060→            renderer.newSection?.(`Iteration ${iteration}/${maxLoops}`);
  1061→
  1062→            // AC: @ralph-task-limit ac-reset - Reset counter and clear stale markers at iteration start
  1063→            taskLimitReached = false;
  1064→            tasksCompletedThisIteration = 0;
  1065→            const wasStale = await clearStaleMarker(ctx.rootDir);
  1066→            if (wasStale) {
  1067→              info("Cleared stale task limit marker from previous session");
  1068→            }
  1069→            // Also clear any marker from previous iteration of this session
  1070→            await clearTaskLimitMarker(ctx.rootDir);
  1071→
  1072→            // AC: @ralph-end-iteration ac-cleanup - Reset end-iteration state
  1073→            endIterationRequested = false;
  1074→            const wasStaleEndIteration = await clearStaleEndIterationMarker(ctx.rootDir);
  1075→            if (wasStaleEndIteration) {
  1076→              info("Cleared stale end-iteration marker from previous session");
  1077→            }
  1078→            await clearEndIterationMarker(ctx.rootDir);
  1079→
  1080→            // Gather fresh context each iteration (only automation-eligible tasks)
  1081→            // AC: @cli-ralph ac-16
  1082→            const sessionCtx = await gatherSessionContext(ctx, {
  1083→              limit: "10",
  1084→              eligible: true,
  1085→            });
  1086→
  1087→            // AC: @ralph-subagent-spawning ac-8 - Process pending_review tasks BEFORE main iteration
  1088→            // This wraps consecutiveFailures in an object so it can be mutated by the helper
  1089→            const failureTracker = { count: consecutiveFailures };
  1090→            const continueLoop = await processPendingReviewTasks(
  1091→              ctx,
  1092→              adapter,
  1093→              sessionCtx.pending_review_tasks,
  1094→              {
  1095→                yolo: options.yolo,
  1096→                maxRetries,
  1097→                maxFailures,
  1098→                cwd: process.cwd(),
  1099→              },
  1100→              failureTracker,
  1101→            );
  1102→            consecutiveFailures = failureTracker.count;
  1103→
  1104→            if (!continueLoop) {
  1105→              break;
  1106→            }
  1107→
  1108→            // AC: @cli-ralph ac-20 - Refresh context after pending_review processing
  1109→            // If pending_review tasks were processed, they may have completed and unblocked
  1110→            // dependent tasks. Re-gather context to detect newly available tasks.
  1111→            let currentCtx = sessionCtx;
  1112→            if (sessionCtx.pending_review_tasks.length > 0) {
  1113→              currentCtx = await gatherSessionContext(ctx, {
  1114→                limit: "10",
  1115→                eligible: true,
  1116→              });
  1117→            }
  1118→
  1119→            // Check for automation-eligible tasks (ready or in_progress)
  1120→            // AC: @cli-ralph ac-19
  1121→            const hasActiveTasks = currentCtx.active_tasks.length > 0;
  1122→            const hasReadyTasks = currentCtx.ready_tasks.length > 0;
  1123→
  1124→            if (!hasActiveTasks && !hasReadyTasks) {
  1125→              info("No automation-eligible tasks (ready or in_progress). Exiting loop.");
  1126→              break;
  1127→            }
  1128→
  1129→            // AC: @loop-mode-error-handling - Track tasks in progress for failure handling
  1130→            const tasksInProgressAtStart = sessionCtx.active_tasks;
  1131→            const iterationStartTime = new Date();
  1132→
  1133→            // Build prompts - task-work first, then reflect
  1134→            const taskWorkPrompt = buildTaskWorkPrompt(
  1135→              currentCtx,
  1136→              iteration,
  1137→              maxLoops,
  1138→              sessionId,
  1139→              options.focus,
  1140→            );
  1141→            const reflectPrompt = buildReflectPrompt(
  1142→              iteration,
  1143→              maxLoops,
  1144→              sessionId,
  1145→            );
  1146→
  1147→            // AC: @ralph-task-limit ac-dryrun
  1148→            if (options.dryRun) {
  1149→              console.log(
  1150→                chalk.yellow("=== DRY RUN - Configuration ===\n"),
  1151→              );
  1152→              console.log(`  max-loops: ${maxLoops}`);
  1153→              console.log(`  max-tasks: ${maxTasks === 0 ? "unlimited" : maxTasks}`);
  1154→              console.log(`  max-retries: ${maxRetries}`);
  1155→              console.log(`  max-failures: ${maxFailures}`);
  1156→              console.log(`  restart-every: ${restartEvery === 0 ? "never" : restartEvery}`);
  1157→              console.log(
  1158→                chalk.yellow("\n=== Task Work Prompt ===\n"),
  1159→              );
  1160→              console.log(taskWorkPrompt);
  1161→              console.log(chalk.yellow("\n=== Reflect Prompt ===\n"));
  1162→              console.log(reflectPrompt);
  1163→              console.log(chalk.yellow("\n=== END DRY RUN ==="));
  1164→              break;
  1165→            }
  1166→
  1167→            // Log task-work prompt
  1168→            await appendEvent(specDir, {
  1169→              session_id: sessionId,
  1170→              type: "prompt.sent",
  1171→              data: {
  1172→                iteration,
  1173→                phase: "task-work",
  1174→                prompt: taskWorkPrompt,
  1175→                tasks: {
  1176→                  active: currentCtx.active_tasks.map((t) => t.ref),
  1177→                  ready: currentCtx.ready_tasks.map((t) => t.ref),
  1178→                },
  1179→              },
  1180→            });
  1181→
  1182→            // Retry loop for this iteration
  1183→            let lastError: Error | null = null;
  1184→            let succeeded = false;
  1185→
  1186→            for (let attempt = 1; attempt <= maxRetries + 1; attempt++) {
  1187→              if (attempt > 1) {
  1188→                console.log(
  1189→                  chalk.yellow(
  1190→                    `\nRetry attempt ${attempt - 1}/${maxRetries}...`,
  1191→                  ),
  1192→                );
  1193→              }
  1194→
  1195→              try {
  1196→                // Spawn agent if not already running
  1197→                if (!agent) {
  1198→                  info("Spawning ACP agent...");
  1199→                  agent = await spawnAndInitialize(adapter, {
  1200→                    cwd: process.cwd(),
  1201→                    clientOptions: {
  1202→                      clientInfo: {
  1203→                        name: "kspec-ralph",
  1204→                        version: packageVersion,
  1205→                      },
  1206→                    },
  1207→                  });
  1208→
  1209→                  // Set up streaming update handler with translator + renderer
  1210→                  agent.client.on(
  1211→                    "update",
  1212→                    (_sid: string, update: SessionUpdate) => {
  1213→                      // Translate ACP event to RalphEvent and render
  1214→                      const event = translator.translate(update);
  1215→                      if (event) {
  1216→                        renderer.render(event);
  1217→                      }
  1218→
  1219→                      // AC: @ralph-task-limit ac-detection, ac-wrapup
  1220→                      // Detect task completions for limit enforcement
  1221→                      if (maxTasks > 0 && !taskLimitReached) {
  1222→                        const bashCmd = extractBashCommand(update);
  1223→                        if (bashCmd && detectTaskCompleteCommand(bashCmd)) {
  1224→                          // Pattern matched - verify via kspec query
  1225→                          getIterationStats(ctx, iterationStartTime)
  1226→                            .then(async (stats) => {
  1227→                              if (stats.tasks_completed >= maxTasks && !taskLimitReached) {
  1228→                                taskLimitReached = true;
  1229→                                tasksCompletedThisIteration = stats.tasks_completed;
  1230→                                info(`Task limit reached (${stats.tasks_completed}/${maxTasks})`);
  1231→
  1232→                                // AC: @ralph-task-limit ac-marker-format, ac-wrapup
  1233→                                // Write marker file for hook enforcement
  1234→                                const marker: TaskLimitMarker = {
  1235→                                  active: true,
  1236→                                  since: iterationStartTime.toISOString(),
  1237→                                  max: maxTasks,
  1238→                                  completed: stats.tasks_completed,
  1239→                                  sessionId,
  1240→                                };
  1241→                                await writeTaskLimitMarker(ctx.rootDir, marker);
  1242→
  1243→                                // Inject wrap-up message to agent
  1244→                                if (agent && acpSessionId) {
  1245→                                  const wrapUpMsg = `\n\n**TASK LIMIT REACHED** - ${stats.tasks_completed} task(s) completed this iteration (limit: ${maxTasks}).\n\nPlease wrap up your current work and exit cleanly. Do not start new tasks.\n\nCompleted tasks this iteration: ${stats.completed_refs.join(", ")}`;
  1246→                                  agent.client.prompt({
  1247→                                    sessionId: acpSessionId,
  1248→                                    prompt: [{ type: "text", text: wrapUpMsg }],
  1249→                                  }).catch(() => {
  1250→                                    // Ignore if message injection fails
  1251→                                  });
  1252→                                }
  1253→                              }
  1254→                            })
  1255→                            .catch(() => {
  1256→                              // Ignore query failures - detection is best-effort
  1257→                            });
  1258→                        }
  1259→                      }
  1260→
  1261→                      // AC: @ralph-end-iteration ac-detect
  1262→                      // Detect explicit end-iteration command
  1263→                      if (!endIterationRequested) {
  1264→                        const bashCmd = extractBashCommand(update);
  1265→                        if (bashCmd && detectEndIterationCommand(bashCmd)) {
  1266→                          endIterationRequested = true;
  1267→                          // Read marker to get reason if present
  1268→                          readEndIterationMarker(ctx.rootDir)
  1269→                            .then((marker) => {
  1270→                              const reason = marker?.reason
  1271→                                ? ` (${marker.reason})`
  1272→                                : "";
  1273→                              info(`End-iteration signal received${reason}`);
  1274→                            })
  1275→                            .catch(() => {
  1276→                              info("End-iteration signal received");
  1277→                            });
  1278→                        }
  1279→                      }
  1280→
  1281→                      // Log raw update event (async, non-blocking)
  1282→                      appendEvent(specDir, {
  1283→                        session_id: sessionId,
  1284→                        type: "session.update",
  1285→                        data: { iteration, update },
  1286→                      }).catch(() => {
  1287→                        // Ignore logging errors during streaming
  1288→                      });
  1289→                    },
  1290→                  );
  1291→
  1292→                  // Set up tool request handler
  1293→                  agent.client.on(
  1294→                    "request",
  1295→                    (
  1296→                      reqId: string | number,
  1297→                      method: string,
  1298→                      params: unknown,
  1299→                    ) => {
  1300→                      // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1301→                      handleRequest(
  1302→                        agent!.client,
  1303→                        reqId,
  1304→                        method,
  1305→                        params,
  1306→                        options.yolo,
  1307→                      ).catch((err) => {
  1308→                        // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1309→                        agent!.client.respondError(reqId, -32000, err.message);
  1310→                      });
  1311→                    },
  1312→                  );
  1313→                }
  1314→
  1315→                // Create fresh ACP session per iteration to keep context clean
  1316→                info("Creating ACP session...");
  1317→                acpSessionId = await agent.client.newSession({
  1318→                  cwd: process.cwd(),
  1319→                  mcpServers: [], // No MCP servers for now
  1320→                });
  1321→
  1322→                // Phase 1: Task Work
  1323→                info("Sending task-work prompt to agent...");
  1324→                const taskWorkResponse = await agent.client.prompt({
  1325→                  sessionId: acpSessionId!,
  1326→                  prompt: [{ type: "text", text: taskWorkPrompt }],
  1327→                });
  1328→
  1329→                // Log task-work completion
  1330→                await appendEvent(specDir, {
  1331→                  session_id: sessionId,
  1332→                  type: "session.update",
  1333→                  data: {
  1334→                    iteration,
  1335→                    phase: "task-work",
  1336→                    stopReason: taskWorkResponse.stopReason,
  1337→                    completed: true,
  1338→                  },
  1339→                });
  1340→
  1341→                if (taskWorkResponse.stopReason === "cancelled") {
  1342→                  throw new Error(errors.usage.agentPromptCancelled);
  1343→                }
  1344→
  1345→                // Phase 2: Reflect (always sent after task-work completes)
  1346→                info("Sending reflect prompt to agent...");
  1347→                await appendEvent(specDir, {
  1348→                  session_id: sessionId,
  1349→                  type: "prompt.sent",
  1350→                  data: {
  1351→                    iteration,
  1352→                    phase: "reflect",
  1353→                    prompt: reflectPrompt,
  1354→                  },
  1355→                });
  1356→
  1357→                const reflectResponse = await agent.client.prompt({
  1358→                  sessionId: acpSessionId!,
  1359→                  prompt: [{ type: "text", text: reflectPrompt }],
  1360→                });
  1361→
  1362→                // Log reflect completion
  1363→                await appendEvent(specDir, {
  1364→                  session_id: sessionId,
  1365→                  type: "session.update",
  1366→                  data: {
  1367→                    iteration,
  1368→                    phase: "reflect",
  1369→                    stopReason: reflectResponse.stopReason,
  1370→                    completed: true,
  1371→                  },
  1372→                });
  1373→
  1374→                if (reflectResponse.stopReason === "cancelled") {
  1375→                  throw new Error(errors.usage.agentPromptCancelled);
  1376→                }
  1377→
  1378→                succeeded = true;
  1379→                break;
  1380→              } catch (err) {
  1381→                lastError = err as Error;
  1382→                error(errors.failures.iterationFailed(lastError.message));
  1383→
  1384→                // Clean up agent on error - will respawn next attempt
  1385→                if (agent) {
  1386→                  agent.kill();
  1387→                  agent = null;
  1388→                  acpSessionId = null;
  1389→                }
  1390→              }
  1391→            }
  1392→
  1393→            if (succeeded) {
  1394→              console.log(); // Newline after streaming output
  1395→
  1396→              // Save session context snapshot for audit trail
  1397→              await saveSessionContext(
  1398→                specDir,
  1399→                sessionId,
  1400→                iteration,
  1401→                sessionCtx,
  1402→              );
  1403→
  1404→              success(`Completed iteration ${iteration}`);
  1405→              consecutiveFailures = 0;
  1406→
  1407→              // AC: @ralph-end-iteration ac-graceful - Check for end-iteration signal
  1408→              if (endIterationRequested) {
  1409→                info("Agent requested end of loop. Exiting gracefully.");
  1410→                break;
  1411→              }
  1412→
  1413→              // Periodic agent restart to prevent OOM
  1414→              // AC: @cli-ralph ac-restart-periodic
  1415→              if (
  1416→                restartEvery > 0 &&
  1417→                iteration % restartEvery === 0 &&
  1418→                iteration < maxLoops
  1419→              ) {
  1420→                info(
  1421→                  `Restarting agent to prevent memory buildup (every ${restartEvery} iterations)...`,
  1422→                );
  1423→                if (agent) {
  1424→                  agent.kill();
  1425→                  agent = null;
  1426→                  acpSessionId = null;
  1427→                }
  1428→              }
  1429→            } else {
  1430→              consecutiveFailures++;
  1431→              error(
  1432→                errors.failures.iterationFailedAfterRetries(
  1433→                  iteration,
  1434→                  maxRetries,
  1435→                  consecutiveFailures,
  1436→                  maxFailures,
  1437→                ),
  1438→              );
  1439→              if (lastError) {
  1440→                error(errors.failures.lastError(lastError.message));
  1441→              }
  1442→
  1443→              // AC: @loop-mode-error-handling - Track per-task failures
  1444→              const errorDesc = lastError?.message || "Iteration failed after retries";
  1445→              await handleIterationFailure(
  1446→                ctx,
  1447→                tasksInProgressAtStart,
  1448→                iterationStartTime,
  1449→                errorDesc,
  1450→              );
  1451→
  1452→              if (consecutiveFailures >= maxFailures) {
  1453→                error(errors.failures.reachedMaxFailures(maxFailures));
  1454→                break;
  1455→              }
  1456→
  1457→              info("Continuing to next iteration...");
  1458→            }
  1459→          }
  1460→        } finally {
  1461→          // Remove signal handlers to avoid double cleanup
  1462→          process.off("SIGINT", sigintHandler);
  1463→          process.off("SIGTERM", sigtermHandler);
  1464→
  1465→          // Clean up agent
  1466→          if (agent) {
  1467→            agent.kill();
  1468→          }
  1469→
  1470→          // AC: @ralph-task-limit ac-reset - Clear marker file when session ends
  1471→          await clearTaskLimitMarker(ctx.rootDir);
  1472→
  1473→          // AC: @ralph-end-iteration ac-cleanup - Clear end-iteration marker when session ends
  1474→          await clearEndIterationMarker(ctx.rootDir);
  1475→
  1476→          // Log session end
  1477→          const status =
  1478→            consecutiveFailures >= maxFailures ? "abandoned" : "completed";
  1479→          await appendEvent(specDir, {
  1480→            session_id: sessionId,
  1481→            type: "session.end",
  1482→            data: {
  1483→              status,
  1484→              consecutiveFailures,
  1485→            },
  1486→          });
  1487→          await updateSessionStatus(specDir, sessionId, status);
  1488→        }
  1489→
  1490→        console.log(chalk.green(`\n${"─".repeat(60)}`));
  1491→        success("Ralph loop completed");
  1492→        console.log(chalk.green(`${"─".repeat(60)}\n`));
  1493→      } catch (err) {
  1494→        error(errors.failures.ralphLoop, err);
  1495→        process.exit(EXIT_CODES.ERROR);
  1496→      }
  1497→    });
  1498→}
  1499→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
