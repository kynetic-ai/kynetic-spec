```
     1→/**
     2→ * Project-level configuration for kspec.
     3→ *
     4→ * Loads kspec.config.yaml from the project root (main branch) before shadow
     5→ * branch detection. All fields are optional with backward-compatible defaults.
     6→ *
     7→ * Priority: env vars > config file > defaults
     8→ *
     9→ * @module
    10→ */
    11→
    12→import * as fs from "node:fs/promises";
    13→import * as path from "node:path";
    14→import { z } from "zod";
    15→import * as YAML from "yaml";
    16→import { getGitRoot } from "./shadow.js";
    17→
    18→// ── Schema ──────────────────────────────────────────────────────────────
    19→
    20→/**
    21→ * Schema for shadow branch configuration.
    22→ *
    23→ * AC: @config-shadow — shadow.branch, shadow.directory, shadow.remote configurable
    24→ */
    25→const ShadowConfigSchema = z
    26→  .object({
    27→    /** Branch name for shadow branch (default: kspec-meta) */
    28→    branch: z.string().optional(),
    29→    /** Worktree directory name (default: .kspec) */
    30→    directory: z.string().optional(),
    31→    /**
    32→     * Remote target for shadow branch. Can be:
    33→     * - Named remote (e.g., "origin", "specs-origin")
    34→     * - Local filesystem path (starts with /, ./, or ~)
    35→     * - Git URL (contains :// or starts with git@)
    36→     */
    37→    remote: z.string().optional(),
    38→    /**
    39→     * Interval in seconds for periodic background shadow pull in daemon mode.
    40→     * Set to 0 to disable periodic sync. Default: 60.
    41→     *
    42→     * AC: @config-shadow ac-12 — configurable sync interval for daemon background pull
    43→     */
    44→    sync_interval: z.number().int().min(0).optional(),
    45→  })
    46→  .strict()
    47→  .optional();
    48→
    49→/**
    50→ * Schema for identity configuration.
    51→ */
    52→const IdentityConfigSchema = z
    53→  .object({
    54→    /** Default author for notes/tasks (overridden by KSPEC_AUTHOR env var) */
    55→    author: z.string().optional(),
    56→  })
    57→  .strict()
    58→  .optional();
    59→
    60→/**
    61→ * Schema for validation configuration.
    62→ *
    63→ * AC: @config-validation — validation settings configurable in kspec.config.yaml
    64→ */
    65→const ValidationConfigSchema = z
    66→  .object({
    67→    /**
    68→     * When true, dangling references are treated as errors instead of warnings.
    69→     * AC: @config-validation ac-2 ac-3 — strict_refs configurable
    70→     */
    71→    strict_refs: z.boolean().optional(),
    72→    /**
    73→     * When true, specs missing acceptance criteria are reported as errors not warnings.
    74→     * AC: @config-validation ac-1 — require_acceptance configurable
    75→     */
    76→    require_acceptance: z.boolean().optional(),
    77→  })
    78→  .strict()
    79→  .optional();
    80→
    81→/**
    82→ * Schema for daemon configuration.
    83→ *
    84→ * AC: @config-daemon — daemon.port, daemon.auto_start configurable
    85→ */
    86→const DaemonConfigSchema = z
    87→  .object({
    88→    /** Default port for daemon (default: 3456) */
    89→    port: z.number().int().min(1).max(65535).optional(),
    90→    /** Host to bind to (default: localhost) */
    91→    host: z.string().optional(),
    92→    /**
    93→     * Whether to auto-start daemon when running kspec commands.
    94→     * AC: @config-daemon ac-3 — auto_start configurable
    95→     */
    96→    auto_start: z.boolean().optional(),
    97→  })
    98→  .strict()
    99→  .optional();
   100→
   101→/**
   102→ * Schema for ralph skill name overrides.
   103→ *
   104→ * Ralph prompts reference skills by invocation name. These default to
   105→ * kspec: namespace core skills but can be overridden per-project for
   106→ * projects that use project-specific skill names.
   107→ */
   108→const RalphSkillsSchema = z
   109→  .object({
   110→    /** Skill invocation for task-work (default: /kspec:task-work) */
   111→    task_work: z.string().optional(),
   112→    /** Skill invocation for reflect (default: /kspec:reflect) */
   113→    reflect: z.string().optional(),
   114→    /** Skill invocation for PR review (default: /kspec:review) */
   115→    pr_review: z.string().optional(),
   116→  })
   117→  .strict()
   118→  .optional();
   119→
   120→/**
   121→ * Schema for ralph configuration.
   122→ */
   123→const RalphConfigSchema = z
   124→  .object({
   125→    /** Skill invocation name overrides */
   126→    skills: RalphSkillsSchema,
   127→  })
   128→  .strict()
   129→  .optional();
   130→
   131→/**
   132→ * Complete schema for kspec.config.yaml.
   133→ *
   134→ * AC: @project-config ac-4 — unknown fields are ignored via passthrough
   135→ */
   136→export const KspecConfigSchema = z
   137→  .object({
   138→    /** Shadow branch configuration */
   139→    shadow: ShadowConfigSchema,
   140→    /** Identity configuration */
   141→    identity: IdentityConfigSchema,
   142→    /** Validation configuration */
   143→    validation: ValidationConfigSchema,
   144→    /** Daemon configuration */
   145→    daemon: DaemonConfigSchema,
   146→    /** Ralph automation configuration */
   147→    ralph: RalphConfigSchema,
   148→  })
   149→  .passthrough(); // AC: ac-4 — ignore unknown fields
   150→
   151→/**
   152→ * Raw config type as parsed from YAML file.
   153→ */
   154→export type KspecConfig = z.infer<typeof KspecConfigSchema>;
   155→
   156→/**
   157→ * Remote type for shadow branch configuration.
   158→ * - "named": Git remote name (e.g., "origin", "specs-origin")
   159→ * - "path": Local filesystem path
   160→ * - "url": Git URL (https://, git@, etc.)
   161→ */
   162→export type ShadowRemoteType = "named" | "path" | "url";
   163→
   164→/**
   165→ * Resolved shadow remote configuration.
   166→ */
   167→export interface ResolvedShadowRemote {
   168→  /** The remote value from config */
   169→  value: string;
   170→  /** Detected type of the remote */
   171→  type: ShadowRemoteType;
   172→}
   173→
   174→/**
   175→ * Detect the type of a shadow remote string.
   176→ *
   177→ * AC: @config-shadow ac-3 ac-4 ac-5 — remote type detection
   178→ *
   179→ * @param remote Remote string from config
   180→ * @returns Detected type: "path" for filesystem, "url" for git URLs, "named" for git remote names
   181→ */
   182→export function detectRemoteType(remote: string): ShadowRemoteType {
   183→  // AC: ac-4 — Local filesystem path (starts with /, ./, ../, or ~)
   184→  if (
   185→    remote.startsWith("/") ||
   186→    remote.startsWith("./") ||
   187→    remote.startsWith("../") ||
   188→    remote.startsWith("~")
   189→  ) {
   190→    return "path";
   191→  }
   192→  // AC: ac-5 — Git URL (contains :// or starts with git@)
   193→  if (remote.includes("://") || remote.startsWith("git@")) {
   194→    return "url";
   195→  }
   196→  // AC: ac-3 — Otherwise it's a named remote
   197→  return "named";
   198→}
   199→
   200→/**
   201→ * Resolved config with all values finalized (env vars applied, defaults filled).
   202→ */
   203→export interface ResolvedKspecConfig {
   204→  shadow: {
   205→    /** Branch name (default: kspec-meta) */
   206→    branch: string;
   207→    /** Worktree directory name (default: .kspec) */
   208→    directory: string;
   209→    /** Remote configuration, null if not specified */
   210→    remote: ResolvedShadowRemote | null;
   211→    /**
   212→     * Interval in seconds for periodic background shadow pull in daemon mode.
   213→     * 0 disables periodic sync. Default: 60.
   214→     * AC: @config-shadow ac-12
   215→     */
   216→    sync_interval: number;
   217→  };
   218→  identity: {
   219→    author: string | null;
   220→  };
   221→  validation: {
   222→    /**
   223→     * When true, dangling references are treated as errors instead of warnings.
   224→     * AC: @config-validation ac-2 ac-3
   225→     */
   226→    strict_refs: boolean;
   227→    /**
   228→     * When true, specs missing acceptance criteria are reported as errors not warnings.
   229→     * AC: @config-validation ac-1
   230→     */
   231→    require_acceptance: boolean;
   232→  };
   233→  daemon: {
   234→    port: number;
   235→    host: string;
   236→    /**
   237→     * Whether to auto-start daemon when running kspec commands.
   238→     * AC: @config-daemon ac-3
   239→     */
   240→    auto_start: boolean;
   241→  };
   242→  ralph: {
   243→    skills: {
   244→      /** Skill invocation for task-work (default: /kspec:task-work) */
   245→      task_work: string;
   246→      /** Skill invocation for reflect (default: /kspec:reflect) */
   247→      reflect: string;
   248→      /** Skill invocation for PR review (default: /kspec:review) */
   249→      pr_review: string;
   250→    };
   251→  };
   252→}
   253→
   254→// ── Defaults ────────────────────────────────────────────────────────────
   255→
   256→/**
   257→ * Default configuration values.
   258→ *
   259→ * AC: @project-config ac-1 — these are the current defaults
   260→ */
   261→const DEFAULT_CONFIG: ResolvedKspecConfig = {
   262→  shadow: {
   263→    branch: "kspec-meta",
   264→    directory: ".kspec",
   265→    remote: null,
   266→    sync_interval: 60, // AC: @config-shadow ac-12 — default 60s
   267→  },
   268→  identity: {
   269→    author: null,
   270→  },
   271→  validation: {
   272→    // AC: @config-validation — defaults preserve existing behavior
   273→    // strict_refs: true = dangling refs are errors (existing behavior)
   274→    // require_acceptance: false = missing AC is warning (existing behavior)
   275→    strict_refs: true,
   276→    require_acceptance: false,
   277→  },
   278→  daemon: {
   279→    port: 3456,
   280→    host: "localhost",
   281→    auto_start: true, // AC: @config-daemon — default auto-start enabled
   282→  },
   283→  ralph: {
   284→    skills: {
   285→      task_work: "/kspec:task-work",
   286→      reflect: "/kspec:reflect",
   287→      pr_review: "/kspec:review",
   288→    },
   289→  },
   290→};
   291→
   292→// ── Loading ─────────────────────────────────────────────────────────────
   293→
   294→const CONFIG_FILENAME = "kspec.config.yaml";
   295→
   296→/**
   297→ * Result of loading project config.
   298→ */
   299→export interface LoadConfigResult {
   300→  /** Resolved configuration with all values finalized */
   301→  config: ResolvedKspecConfig;
   302→  /** Path to config file if found, null otherwise */
   303→  configPath: string | null;
   304→  /** Warning message if config had issues but was recoverable */
   305→  warning: string | null;
   306→  /** The git root directory where config was loaded from */
   307→  gitRoot: string | null;
   308→}
   309→
   310→/**
   311→ * Find git root directory, handling KSPEC_SPEC_DIR batch mode.
   312→ *
   313→ * AC: @project-config ac-7 — in batch mode, we need the REAL project root
   314→ *
   315→ * When KSPEC_SPEC_DIR is set (batch atomic mode), the cwd might be the temp
   316→ * directory. We need to find the real project root by checking:
   317→ * 1. If KSPEC_BATCH_PROJECT_ROOT is set, use that (set by batch executor)
   318→ * 2. Otherwise, use git root from cwd
   319→ *
   320→ * AC: @project-config ac-6 — loads from git root, not cwd subdirectory
   321→ */
   322→export function findProjectRoot(startDir: string): string | null {
   323→  // In batch mode, the batch executor should set this to the real root
   324→  // before redirecting KSPEC_SPEC_DIR
   325→  const batchRoot = process.env.KSPEC_BATCH_PROJECT_ROOT;
   326→  if (batchRoot) {
   327→    return batchRoot;
   328→  }
   329→
   330→  // Normal mode: find git root
   331→  return getGitRoot(startDir);
   332→}
   333→
   334→/**
   335→ * Load project configuration from kspec.config.yaml.
   336→ *
   337→ * AC: @project-config ac-1 — no config = all defaults
   338→ * AC: @project-config ac-2 — config parsed and available before shadow detection
   339→ * AC: @project-config ac-3 — invalid YAML = defaults + warning
   340→ * AC: @project-config ac-4 — unknown fields ignored
   341→ * AC: @project-config ac-5 — env vars take precedence
   342→ * AC: @project-config ac-6 — loads from git root
   343→ * AC: @project-config ac-7 — batch mode uses real project root
   344→ *
   345→ * @param startDir Starting directory for git root detection
   346→ */
   347→export async function loadProjectConfig(
   348→  startDir: string = process.cwd(),
   349→): Promise<LoadConfigResult> {
   350→  const gitRoot = findProjectRoot(startDir);
   351→
   352→  if (!gitRoot) {
   353→    // Not in a git repo, use defaults
   354→    return {
   355→      config: resolveConfig(null),
   356→      configPath: null,
   357→      warning: null,
   358→      gitRoot: null,
   359→    };
   360→  }
   361→
   362→  const configPath = path.join(gitRoot, CONFIG_FILENAME);
   363→
   364→  // Check if config file exists
   365→  try {
   366→    await fs.access(configPath);
   367→  } catch {
   368→    // AC: ac-1 — no config file, use defaults
   369→    return {
   370→      config: resolveConfig(null),
   371→      configPath: null,
   372→      warning: null,
   373→      gitRoot,
   374→    };
   375→  }
   376→
   377→  // Try to load and parse config
   378→  try {
   379→    const content = await fs.readFile(configPath, "utf-8");
   380→    const raw = YAML.parse(content);
   381→
   382→    // Validate against schema
   383→    const result = KspecConfigSchema.safeParse(raw);
   384→
   385→    if (!result.success) {
   386→      // AC: ac-3 — validation error = defaults + warning
   387→      const issues = result.error.issues
   388→        .map((i) => `${i.path.join(".")}: ${i.message}`)
   389→        .join("; ");
   390→      return {
   391→        config: resolveConfig(null),
   392→        configPath,
   393→        warning: `Config validation failed: ${issues}. Using defaults.`,
   394→        gitRoot,
   395→      };
   396→    }
   397→
   398→    // AC: ac-5 — apply env var overrides during resolution
   399→    return {
   400→      config: resolveConfig(result.data),
   401→      configPath,
   402→      warning: null,
   403→      gitRoot,
   404→    };
   405→  } catch (err) {
   406→    // AC: ac-3 — parse error = defaults + warning
   407→    const message = err instanceof Error ? err.message : String(err);
   408→    return {
   409→      config: resolveConfig(null),
   410→      configPath,
   411→      warning: `Failed to parse ${CONFIG_FILENAME}: ${message}. Using defaults.`,
   412→      gitRoot,
   413→    };
   414→  }
   415→}
   416→
   417→/**
   418→ * Resolve configuration by merging file config with env vars and defaults.
   419→ *
   420→ * Priority: env vars > config file > defaults
   421→ *
   422→ * AC: @project-config ac-5 — env vars take precedence
   423→ */
   424→export function resolveConfig(fileConfig: KspecConfig | null): ResolvedKspecConfig {
   425→  const file = fileConfig || {};
   426→
   427→  // Get env var overrides
   428→  const envAuthor = process.env.KSPEC_AUTHOR;
   429→  const envPort = process.env.KSPEC_DAEMON_PORT
   430→    ? parseInt(process.env.KSPEC_DAEMON_PORT, 10)
   431→    : undefined;
   432→  const envHost = process.env.KSPEC_DAEMON_HOST;
   433→
   434→  // Resolve shadow remote if specified
   435→  const remoteValue = file.shadow?.remote;
   436→  const resolvedRemote: ResolvedShadowRemote | null = remoteValue
   437→    ? { value: remoteValue, type: detectRemoteType(remoteValue) }
   438→    : DEFAULT_CONFIG.shadow.remote;
   439→
   440→  return {
   441→    shadow: {
   442→      branch: file.shadow?.branch ?? DEFAULT_CONFIG.shadow.branch,
   443→      directory: file.shadow?.directory ?? DEFAULT_CONFIG.shadow.directory,
   444→      remote: resolvedRemote,
   445→      sync_interval: file.shadow?.sync_interval ?? DEFAULT_CONFIG.shadow.sync_interval,
   446→    },
   447→    identity: {
   448→      // AC: ac-5 — env var takes precedence
   449→      author: envAuthor ?? file.identity?.author ?? DEFAULT_CONFIG.identity.author,
   450→    },
   451→    validation: {
   452→      // AC: @config-validation ac-2 ac-3 — strict_refs from config
   453→      strict_refs:
   454→        file.validation?.strict_refs ?? DEFAULT_CONFIG.validation.strict_refs,
   455→      // AC: @config-validation ac-1 — require_acceptance from config
   456→      require_acceptance:
   457→        file.validation?.require_acceptance ?? DEFAULT_CONFIG.validation.require_acceptance,
   458→    },
   459→    daemon: {
   460→      // AC: ac-5 — env vars take precedence
   461→      port:
   462→        (envPort && !isNaN(envPort) ? envPort : undefined) ??
   463→        file.daemon?.port ??
   464→        DEFAULT_CONFIG.daemon.port,
   465→      // AC: @config-daemon ac-5 ac-6 — host from config/env
   466→      host: envHost ?? file.daemon?.host ?? DEFAULT_CONFIG.daemon.host,
   467→      // AC: @config-daemon ac-3 — auto_start from config
   468→      auto_start: file.daemon?.auto_start ?? DEFAULT_CONFIG.daemon.auto_start,
   469→    },
   470→    ralph: {
   471→      skills: {
   472→        task_work: file.ralph?.skills?.task_work ?? DEFAULT_CONFIG.ralph.skills.task_work,
   473→        reflect: file.ralph?.skills?.reflect ?? DEFAULT_CONFIG.ralph.skills.reflect,
   474→        pr_review: file.ralph?.skills?.pr_review ?? DEFAULT_CONFIG.ralph.skills.pr_review,
   475→      },
   476→    },
   477→  };
   478→}
   479→
   480→/**
   481→ * Get the default configuration (no file, no env vars).
   482→ * Useful for testing or when config loading fails completely.
   483→ * Returns a deep copy to prevent mutation of shared defaults.
   484→ */
   485→export function getDefaultConfig(): ResolvedKspecConfig {
   486→  return {
   487→    shadow: {
   488→      branch: DEFAULT_CONFIG.shadow.branch,
   489→      directory: DEFAULT_CONFIG.shadow.directory,
   490→      remote: DEFAULT_CONFIG.shadow.remote,
   491→      sync_interval: DEFAULT_CONFIG.shadow.sync_interval,
   492→    },
   493→    identity: { ...DEFAULT_CONFIG.identity },
   494→    validation: {
   495→      strict_refs: DEFAULT_CONFIG.validation.strict_refs,
   496→      require_acceptance: DEFAULT_CONFIG.validation.require_acceptance,
   497→    },
   498→    daemon: {
   499→      port: DEFAULT_CONFIG.daemon.port,
   500→      host: DEFAULT_CONFIG.daemon.host,
   501→      auto_start: DEFAULT_CONFIG.daemon.auto_start,
   502→    },
   503→    ralph: {
   504→      skills: { ...DEFAULT_CONFIG.ralph.skills },
   505→    },
   506→  };
   507→}
   508→
