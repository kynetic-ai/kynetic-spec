   159→// AC: @session-branch-worktree ac-repair
   160→describe("session branch repair", () => {
   161→  it("repairs broken worktree by recreating it", async () => {
   162→    // AC: @session-branch-worktree ac-repair
   163→    await initializeSessionBranch(tempDir);
   164→
   165→    // Break the worktree
   166→    const worktreeDir = path.join(tempDir, SESSIONS_WORKTREE_DIR);
   167→    await fs.rm(worktreeDir, { recursive: true, force: true });
   168→
   169→    // Verify it's broken
   170→    const brokenStatus = await getSessionBranchStatus(tempDir);
   171→    expect(brokenStatus.healthy).toBe(false);
   172→
   173→    // Repair
   174→    const result = await repairSessionBranch(tempDir);
   175→    expect(result.success).toBe(true);
   176→    expect(result.worktreeCreated).toBe(true);
   177→
   178→    // Verify it's healthy again
   179→    const healthyStatus = await getSessionBranchStatus(tempDir);
   180→    expect(healthyStatus.healthy).toBe(true);
   181→  });
   182→
   183→  it("returns alreadyExists when worktree is healthy", async () => {
   184→    // AC: @session-branch-worktree ac-repair
   185→    await initializeSessionBranch(tempDir);
   186→    const result = await repairSessionBranch(tempDir);
   187→
   188→    expect(result.success).toBe(true);
   189→    expect(result.alreadyExists).toBe(true);
   190→  });
   191→
   192→  it("fails when branch does not exist", async () => {
   193→    // AC: @session-branch-worktree ac-repair
   194→    const result = await repairSessionBranch(tempDir);
   195→
   196→    expect(result.success).toBe(false);
   197→    expect(result.error).toContain("does not exist");
   198→  });
   199→});
