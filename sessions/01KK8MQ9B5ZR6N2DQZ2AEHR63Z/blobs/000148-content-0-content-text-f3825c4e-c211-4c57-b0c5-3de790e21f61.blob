     1→/**
     2→ * Tests for session branch worktree management.
     3→ *
     4→ * AC: @session-branch-worktree — all ACs
     5→ */
     6→
     7→import { describe, it, expect, beforeEach, afterEach } from "vitest";
     8→import * as fs from "node:fs/promises";
     9→import * as path from "node:path";
    10→import { execSync } from "node:child_process";
    11→import { createTempDir, initGitRepo, git } from "./helpers/cli.js";
    12→
    13→import {
    14→  initializeSessionBranch,
    15→  getSessionBranchStatus,
    16→  repairSessionBranch,
    17→  sessionBranchAutoCommit,
    18→  sessionBranchPull,
    19→  resolveSessionBranchConfig,
    20→  SESSION_BRANCH_NAME,
    21→} from "../src/parser/session-branch.js";
    22→import { SESSIONS_WORKTREE_DIR } from "../src/parser/shadow.js";
    23→import { SessionSyncScheduler } from "../src/parser/session-sync-scheduler.js";
    24→
    25→let tempDir: string;
    26→
    27→beforeEach(async () => {
    28→  tempDir = await createTempDir("session-branch-test-");
    29→  initGitRepo(tempDir);
    30→  // Need at least one commit on main for worktree operations
    31→  await fs.writeFile(path.join(tempDir, "README.md"), "# Test\n", "utf-8");
    32→  git("add -A", tempDir);
    33→  git('commit -m "Initial commit"', tempDir);
    34→});
    35→
    36→afterEach(async () => {
    37→  // Clean up worktrees before removing temp dir
    38→  try {
    39→    execSync("git worktree list --porcelain", {
    40→      cwd: tempDir,
    41→      encoding: "utf-8",
    42→    });
    43→    execSync(`git worktree remove ${SESSIONS_WORKTREE_DIR} --force 2>/dev/null || true`, {
    44→      cwd: tempDir,
    45→      stdio: "pipe",
    46→    });
    47→  } catch {
    48→    // Ignore cleanup errors
    49→  }
    50→  await fs.rm(tempDir, { recursive: true, force: true });
    51→});
    52→
    53→// AC: @session-branch-worktree ac-init
    54→describe("session branch initialization", () => {
    55→  it("creates orphan branch and worktree at .kspec-sessions/", async () => {
    56→    // AC: @session-branch-worktree ac-init
    57→    const result = await initializeSessionBranch(tempDir);
    58→
    59→    expect(result.success).toBe(true);
    60→    expect(result.branchCreated).toBe(true);
    61→    expect(result.worktreeCreated).toBe(true);
    62→
    63→    // Verify worktree directory exists
    64→    const worktreeDir = path.join(tempDir, SESSIONS_WORKTREE_DIR);
    65→    const stat = await fs.stat(worktreeDir);
    66→    expect(stat.isDirectory()).toBe(true);
    67→
    68→    // Verify it's a proper git worktree (.git file, not directory)
    69→    const gitPath = path.join(worktreeDir, ".git");
    70→    const gitStat = await fs.stat(gitPath);
    71→    expect(gitStat.isFile()).toBe(true);
    72→
    73→    // Verify branch exists
    74→    const branches = execSync("git branch --list kspec-sessions", {
    75→      cwd: tempDir,
    76→      encoding: "utf-8",
    77→    }).trim();
    78→    expect(branches).toContain("kspec-sessions");
    79→  });
    80→
    81→  it("uses custom branch name when provided", async () => {
    82→    // AC: @session-branch-worktree ac-init
    83→    const customName = "my-sessions";
    84→    const result = await initializeSessionBranch(tempDir, customName);
    85→
    86→    expect(result.success).toBe(true);
    87→
    88→    // Verify custom branch exists
    89→    const branches = execSync(`git branch --list ${customName}`, {
    90→      cwd: tempDir,
    91→      encoding: "utf-8",
    92→    }).trim();
    93→    expect(branches).toContain(customName);
    94→  });
    95→
    96→  it("returns alreadyExists when worktree is healthy", async () => {
    97→    // AC: @session-branch-worktree ac-init
    98→    await initializeSessionBranch(tempDir);
    99→    const result = await initializeSessionBranch(tempDir);
   100→
   101→    expect(result.success).toBe(true);
   102→    expect(result.alreadyExists).toBe(true);
   103→    expect(result.branchCreated).toBe(false);
   104→    expect(result.worktreeCreated).toBe(false);
   105→  });
   106→
   107→  it("fails gracefully for non-git directory", async () => {
   108→    // AC: @session-branch-worktree ac-init
   109→    const nonGit = await createTempDir("non-git-");
   110→    const result = await initializeSessionBranch(nonGit);
   111→
   112→    expect(result.success).toBe(false);
   113→    expect(result.error).toContain("Not a git repository");
   114→
   115→    await fs.rm(nonGit, { recursive: true, force: true });
   116→  });
   117→});
   118→
   119→// AC: @session-branch-worktree ac-status
   120→describe("session branch status", () => {
   121→  it("reports healthy when branch and worktree exist", async () => {
   122→    // AC: @session-branch-worktree ac-status
   123→    await initializeSessionBranch(tempDir);
   124→    const status = await getSessionBranchStatus(tempDir);
   125→
   126→    expect(status.healthy).toBe(true);
   127→    expect(status.branchExists).toBe(true);
   128→    expect(status.worktreeExists).toBe(true);
   129→    expect(status.worktreeLinked).toBe(true);
   130→  });
   131→
   132→  it("reports not exists when nothing initialized", async () => {
   133→    // AC: @session-branch-worktree ac-status
   134→    const status = await getSessionBranchStatus(tempDir);
   135→
   136→    expect(status.healthy).toBe(false);
   137→    expect(status.exists).toBe(false);
   138→    expect(status.branchExists).toBe(false);
   139→    expect(status.worktreeExists).toBe(false);
   140→  });
   141→
   142→  it("reports unhealthy when worktree directory is deleted", async () => {
   143→    // AC: @session-branch-worktree ac-status
   144→    await initializeSessionBranch(tempDir);
   145→
   146→    // Remove the worktree directory to simulate corruption
   147→    const worktreeDir = path.join(tempDir, SESSIONS_WORKTREE_DIR);
   148→    await fs.rm(worktreeDir, { recursive: true, force: true });
   149→
   150→    const status = await getSessionBranchStatus(tempDir);
   151→
   152→    expect(status.healthy).toBe(false);
   153→    expect(status.branchExists).toBe(true);
   154→    expect(status.worktreeExists).toBe(false);
   155→    expect(status.error).toContain("worktree missing");
   156→  });
   157→});
