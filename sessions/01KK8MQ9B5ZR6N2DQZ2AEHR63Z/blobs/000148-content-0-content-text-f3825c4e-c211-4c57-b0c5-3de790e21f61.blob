   246→// resolveSessionBranchConfig
   247→describe("resolveSessionBranchConfig", () => {
   248→  it('returns config when storage is "branch"', () => {
   249→    const config = resolveSessionBranchConfig("/project", {
   250→      sessions: { storage: "branch", branch: "my-sessions" },
   251→    });
   252→
   253→    expect(config).not.toBeNull();
   254→    expect(config!.enabled).toBe(true);
   255→    expect(config!.branchName).toBe("my-sessions");
   256→    expect(config!.worktreeDir).toBe(
   257→      path.join("/project", SESSIONS_WORKTREE_DIR),
   258→    );
   259→  });
   260→
   261→  it("uses default branch name when not configured", () => {
   262→    const config = resolveSessionBranchConfig("/project", {
   263→      sessions: { storage: "branch" },
   264→    });
   265→
   266→    expect(config).not.toBeNull();
   267→    expect(config!.branchName).toBe(SESSION_BRANCH_NAME);
   268→  });
   269→
   270→  it('returns null when storage is "local"', () => {
   271→    const config = resolveSessionBranchConfig("/project", {
   272→      sessions: { storage: "local" },
   273→    });
   274→
   275→    expect(config).toBeNull();
   276→  });
   277→
   278→  it("returns null when manifest is null", () => {
   279→    const config = resolveSessionBranchConfig("/project", null);
   280→
   281→    expect(config).toBeNull();
   282→  });
   283→
   284→  it("returns null when sessions config is missing", () => {
   285→    const config = resolveSessionBranchConfig("/project", {});
   286→
   287→    expect(config).toBeNull();
   288→  });
   289→});
