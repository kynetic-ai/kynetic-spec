   291→// AC: @session-branch-worktree ac-sync
   292→describe("session branch sync", () => {
   293→  it("sessionBranchPull returns success without pulling when no remote tracking", async () => {
   294→    // AC: @session-branch-worktree ac-sync
   295→    await initializeSessionBranch(tempDir);
   296→
   297→    const worktreeDir = path.join(tempDir, SESSIONS_WORKTREE_DIR);
   298→    const result = await sessionBranchPull(worktreeDir, SESSION_BRANCH_NAME);
   299→
   300→    expect(result.success).toBe(true);
   301→    expect(result.pulled).toBe(false);
   302→    expect(result.hadConflict).toBe(false);
   303→  });
   304→
   305→  it("sessionBranchPull pulls from remote when tracking is configured", async () => {
   306→    // AC: @session-branch-worktree ac-sync
   307→    await initializeSessionBranch(tempDir);
   308→
   309→    const worktreeDir = path.join(tempDir, SESSIONS_WORKTREE_DIR);
   310→
   311→    // Create a bare repo as remote
   312→    const remoteDir = await createTempDir("session-remote-");
   313→    execSync("git init --bare", { cwd: remoteDir, stdio: "pipe" });
   314→
   315→    // Push session branch to remote
   316→    execSync(`git remote add origin ${remoteDir}`, {
   317→      cwd: worktreeDir,
   318→      stdio: "pipe",
   319→    });
   320→    execSync(`git push -u origin ${SESSION_BRANCH_NAME}`, {
   321→      cwd: worktreeDir,
   322→      stdio: "pipe",
   323→    });
   324→
   325→    // Simulate a remote change by pushing from a clone
   326→    const cloneDir = await createTempDir("session-clone-");
   327→    execSync(`git clone ${remoteDir} .`, { cwd: cloneDir, stdio: "pipe" });
   328→    execSync(`git checkout ${SESSION_BRANCH_NAME}`, {
   329→      cwd: cloneDir,
   330→      stdio: "pipe",
   331→    });
   332→    await fs.writeFile(
   333→      path.join(cloneDir, "remote-session.yaml"),
   334→      "id: remote-session\n",
   335→      "utf-8",
   336→    );
   337→    execSync("git add -A", { cwd: cloneDir, stdio: "pipe" });
   338→    execSync(
   339→      'git -c user.name="Test" -c user.email="test@test.com" commit -m "Remote session"',
   340→      { cwd: cloneDir, stdio: "pipe" },
   341→    );
   342→    execSync(`git push origin ${SESSION_BRANCH_NAME}`, {
   343→      cwd: cloneDir,
   344→      stdio: "pipe",
   345→    });
   346→
   347→    // Now pull should detect remote changes
   348→    const result = await sessionBranchPull(worktreeDir, SESSION_BRANCH_NAME);
   349→
   350→    expect(result.success).toBe(true);
   351→    expect(result.pulled).toBe(true);
   352→    expect(result.hadConflict).toBe(false);
   353→
   354→    // Verify the remote file was pulled
   355→    const remoteFile = path.join(worktreeDir, "remote-session.yaml");
   356→    const stat = await fs.stat(remoteFile);
   357→    expect(stat.isFile()).toBe(true);
   358→
   359→    // Clean up
   360→    await fs.rm(remoteDir, { recursive: true, force: true });
   361→    await fs.rm(cloneDir, { recursive: true, force: true });
   362→  });
   363→
   364→  it("SessionSyncScheduler calls syncOnce on interval and can be stopped", async () => {
   365→    // AC: @session-branch-worktree ac-sync
   366→    await initializeSessionBranch(tempDir);
   367→
   368→    const worktreeDir = path.join(tempDir, SESSIONS_WORKTREE_DIR);
   369→
   370→    const broadcasts: Array<{ channel: string; type: string; data: Record<string, unknown> }> = [];
   371→    const pubsub = {
   372→      broadcast(channel: string, type: string, data: Record<string, unknown>) {
   373→        broadcasts.push({ channel, type, data });
   374→      },
   375→    };
   376→
   377→    const scheduler = new SessionSyncScheduler({
   378→      worktreeDir,
   379→      intervalSeconds: 0.1, // 100ms for fast test
   380→      branchName: SESSION_BRANCH_NAME,
   381→      pubsub,
   382→    });
   383→
   384→    // Start and wait for at least one interval
   385→    scheduler.start();
   386→
   387→    // Wait for sync to run (200ms should allow at least one interval fire)
   388→    await new Promise((resolve) => setTimeout(resolve, 200));
   389→
   390→    scheduler.stop();
   391→
   392→    // Scheduler should have run syncOnce at least once without error
   393→    // (no remote tracking, so it exits early — but it ran without crashing)
   394→    // The key assertion: scheduler starts and stops cleanly
   395→    expect(scheduler).toBeDefined();
   396→  });
   397→
   398→  it("SessionSyncScheduler does nothing when interval is 0", () => {
   399→    // AC: @session-branch-worktree ac-sync
   400→    const scheduler = new SessionSyncScheduler({
   401→      worktreeDir: "/nonexistent",
   402→      intervalSeconds: 0,
   403→      branchName: SESSION_BRANCH_NAME,
   404→    });
   405→
   406→    // start() should be a no-op
   407→    scheduler.start();
   408→    scheduler.stop();
   409→  });
   410→
   411→  it("session branch sync is independent from kspec-meta sync", async () => {
   412→    // AC: @session-branch-worktree ac-sync
   413→    // Session sync failure should not affect kspec-meta operations
   414→    await initializeSessionBranch(tempDir);
   415→
   416→    const worktreeDir = path.join(tempDir, SESSIONS_WORKTREE_DIR);
   417→
   418→    // sessionBranchPull uses its own in-flight dedup, independent from shadow pull
   419→    const [result1, result2] = await Promise.all([
   420→      sessionBranchPull(worktreeDir, SESSION_BRANCH_NAME),
   421→      sessionBranchPull(worktreeDir, SESSION_BRANCH_NAME),
   422→    ]);
   423→
   424→    // Both should succeed (second reuses first's in-flight promise)
   425→    expect(result1.success).toBe(true);
   426→    expect(result2.success).toBe(true);
   427→    // Both should be the same promise result (in-flight dedup)
   428→    expect(result1).toBe(result2);
   429→  });
   430→});
