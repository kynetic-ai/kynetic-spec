   201→// AC: @session-branch-worktree ac-commit-boundaries
   202→describe("session branch auto-commit", () => {
   203→  it("commits changes to the session worktree", async () => {
   204→    // AC: @session-branch-worktree ac-commit-boundaries
   205→    await initializeSessionBranch(tempDir);
   206→
   207→    const worktreeDir = path.join(tempDir, SESSIONS_WORKTREE_DIR);
   208→
   209→    // Create a session file
   210→    const sessionDir = path.join(worktreeDir, "test-session");
   211→    await fs.mkdir(sessionDir, { recursive: true });
   212→    await fs.writeFile(
   213→      path.join(sessionDir, "session.yaml"),
   214→      "id: test-session\nstatus: active\n",
   215→      "utf-8",
   216→    );
   217→
   218→    // Auto-commit
   219→    const committed = await sessionBranchAutoCommit(
   220→      worktreeDir,
   221→      "session: create (test-session)",
   222→    );
   223→    expect(committed).toBe(true);
   224→
   225→    // Verify commit exists on session branch
   226→    const log = execSync("git log --oneline -1 kspec-sessions", {
   227→      cwd: tempDir,
   228→      encoding: "utf-8",
   229→    }).trim();
   230→    expect(log).toContain("session: create");
   231→  });
   232→
   233→  it("returns false when there are no changes", async () => {
   234→    // AC: @session-branch-worktree ac-commit-boundaries
   235→    await initializeSessionBranch(tempDir);
   236→
   237→    const worktreeDir = path.join(tempDir, SESSIONS_WORKTREE_DIR);
   238→    const committed = await sessionBranchAutoCommit(
   239→      worktreeDir,
   240→      "session: no-op",
   241→    );
   242→    expect(committed).toBe(false);
   243→  });
   244→});
