   386→// ─── Event Storage Tests ─────────────────────────────────────────────────────
   387→
   388→describe('Event storage', () => {
   389→  let testDir: string;
   390→  let sessionsDir: string;
   391→  const sessionId = '01KF123456789ABCDEFGHJKMNP';
   392→
   393→  beforeEach(async () => {
   394→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-event-test-'));
   395→    sessionsDir = path.join(testDir, 'sessions');
   396→  });
   397→
   398→  afterEach(async () => {
   399→    await fs.rm(testDir, { recursive: true });
   400→  });
   401→
   402→  describe('appendEvent', () => {
   403→    // AC: @session-events ac-2
   404→    it('should append event with auto-assigned ts and seq', async () => {
   405→      const input: SessionEventInput = {
   406→        type: 'session.start',
   407→        session_id: sessionId,
   408→        data: { message: 'Starting session' },
   409→      };
   410→
   411→      const event = await appendEvent(sessionsDir, input);
   412→
   413→      expect(event.ts).toBeDefined();
   414→      expect(event.ts).toBeGreaterThan(0);
   415→      expect(event.seq).toBe(0);
   416→      expect(event.type).toBe('session.start');
   417→      expect(event.session_id).toBe(sessionId);
   418→      expect(event.data).toEqual({ message: 'Starting session' });
   419→    });
   420→
   421→    // AC: @session-events ac-2
   422→    it('should auto-increment seq for subsequent events', async () => {
   423→      const event1 = await appendEvent(sessionsDir, {
   424→        type: 'session.start',
   425→        session_id: sessionId,
   426→        data: null,
   427→      });
   428→
   429→      const event2 = await appendEvent(sessionsDir, {
   430→        type: 'prompt.sent',
   431→        session_id: sessionId,
   432→        data: { prompt: 'Hello' },
   433→      });
   434→
   435→      const event3 = await appendEvent(sessionsDir, {
   436→        type: 'tool.call',
   437→        session_id: sessionId,
   438→        data: { tool: 'Read' },
   439→      });
   440→
   441→      expect(event1.seq).toBe(0);
   442→      expect(event2.seq).toBe(1);
   443→      expect(event3.seq).toBe(2);
   444→    });
   445→
   446→    // AC: @session-events ac-2
   447→    it('should derive next seq from the last stored event seq', async () => {
   448→      const sessionDir = getSessionDir(sessionsDir, sessionId);
   449→      const eventsPath = getSessionEventsPath(sessionsDir, sessionId);
   450→      await fs.mkdir(sessionDir, { recursive: true });
   451→
   452→      const existing = [
   453→        {
   454→          ts: 1000,
   455→          seq: 5,
   456→          type: 'session.start',
   457→          session_id: sessionId,
   458→          data: null,
   459→        },
   460→        {
   461→          ts: 2000,
   462→          seq: 9,
   463→          type: 'session.update',
   464→          session_id: sessionId,
   465→          data: { message: 'existing tail event' },
   466→        },
   467→      ];
   468→      await fs.writeFile(
   469→        eventsPath,
   470→        `${existing.map((event) => JSON.stringify(event)).join('\n')}\n`,
   471→        'utf-8',
   472→      );
   473→
   474→      const next = await appendEvent(sessionsDir, {
   475→        type: 'prompt.sent',
   476→        session_id: sessionId,
   477→        data: { prompt: 'new event' },
   478→      });
   479→
   480→      expect(next.seq).toBe(10);
   481→    });
   482→
   483→    // AC: @session-events ac-3
   484→    it('should create session directory if it does not exist (lazy creation)', async () => {
   485→      const event = await appendEvent(sessionsDir, {
   486→        type: 'session.start',
   487→        session_id: sessionId,
   488→        data: null,
   489→      });
   490→
   491→      expect(event.seq).toBe(0);
   492→
   493→      // Verify directory was created
   494→      const sessionDir = getSessionDir(sessionsDir, sessionId);
   495→      const stat = await fs.stat(sessionDir);
   496→      expect(stat.isDirectory()).toBe(true);
   497→    });
   498→
   499→    it('should preserve optional trace_id', async () => {
   500→      const event = await appendEvent(sessionsDir, {
   501→        type: 'session.start',
   502→        session_id: sessionId,
   503→        trace_id: 'trace-abc-123',
   504→        data: null,
   505→      });
   506→
   507→      expect(event.trace_id).toBe('trace-abc-123');
   508→    });
   509→
   510→    // AC: @session-events ac-3
   511→    it('should write event as JSON line to events.jsonl', async () => {
   512→      await appendEvent(sessionsDir, {
   513→        type: 'session.start',
   514→        session_id: sessionId,
   515→        data: { key: 'value' },
   516→      });
   517→
   518→      await appendEvent(sessionsDir, {
   519→        type: 'prompt.sent',
   520→        session_id: sessionId,
   521→        data: { prompt: 'test' },
   522→      });
   523→
   524→      const eventsPath = getSessionEventsPath(sessionsDir, sessionId);
   525→      const content = await fs.readFile(eventsPath, 'utf-8');
   526→      const lines = content.trim().split('\n');
   527→
   528→      expect(lines).toHaveLength(2);
   529→
   530→      const event1 = JSON.parse(lines[0]);
   531→      expect(event1.type).toBe('session.start');
   532→      expect(event1.seq).toBe(0);
   533→
   534→      const event2 = JSON.parse(lines[1]);
   535→      expect(event2.type).toBe('prompt.sent');
   536→      expect(event2.seq).toBe(1);
   537→    });
   538→
   539→    // AC: @session-events ac-8
   540→    // AC: @session-events ac-9
   541→    it('should externalize oversized rawOutput and store pointer metadata', async () => {
   542→      const rawOutput = 'X'.repeat(20_000);
   543→
   544→      await appendEvent(sessionsDir, {
   545→        type: 'session.update',
   546→        session_id: sessionId,
   547→        data: {
   548→          iteration: 1,
   549→          update: {
   550→            sessionUpdate: 'tool_call_update',
   551→            rawOutput,
   552→          },
   553→        },
   554→      });
   555→
   556→      const eventsPath = getSessionEventsPath(sessionsDir, sessionId);
   557→      const lines = (await fs.readFile(eventsPath, 'utf-8')).trim().split('\n');
   558→      expect(lines).toHaveLength(1);
   559→
   560→      const stored = JSON.parse(lines[0]);
   561→      const pointer = stored.data.update.rawOutput as {
   562→        path: string;
   563→        bytes: number;
   564→        sha256: string;
   565→        truncated: boolean;
   566→        preview: string;
   567→      };
   568→      expect(pointer.path).toMatch(/^blobs\//);
   569→      expect(pointer.bytes).toBe(rawOutput.length);
   570→      expect(pointer.sha256).toBe(
   571→        createHash('sha256').update(rawOutput).digest('hex'),
   572→      );
   573→      expect(pointer.truncated).toBe(true);
   574→      expect(pointer.preview.length).toBeGreaterThan(0);
   575→      expect(pointer.preview.length).toBeLessThan(rawOutput.length);
   576→
   577→      const blobPath = path.join(getSessionDir(sessionsDir, sessionId), pointer.path);
   578→      const blobContent = await fs.readFile(blobPath, 'utf-8');
   579→      expect(blobContent).toBe(rawOutput);
   580→    });
   581→
   582→    it('should generate UTF-8 safe previews for externalized payloads', async () => {
   583→      const rawOutput = '\u6F22'.repeat(7_000);
   584→
   585→      await appendEvent(sessionsDir, {
   586→        type: 'session.update',
   587→        session_id: sessionId,
   588→        data: {
   589→          iteration: 1,
   590→          update: {
   591→            sessionUpdate: 'tool_call_update',
   592→            rawOutput,
   593→          },
   594→        },
   595→      });
   596→
   597→      const eventsPath = getSessionEventsPath(sessionsDir, sessionId);
   598→      const stored = JSON.parse((await fs.readFile(eventsPath, 'utf-8')).trim());
   599→      const pointer = stored.data.update.rawOutput as { preview: string };
   600→
   601→      expect(pointer.preview).toContain('...');
   602→      expect(pointer.preview).not.toContain('\uFFFD');
   603→    });
   604→
   605→    it('should cap oversized event lines by externalizing whole payload', async () => {
   606→      const giantPayload = 'Y'.repeat(320_000);
   607→
   608→      await appendEvent(sessionsDir, {
   609→        type: 'prompt.sent',
   610→        session_id: sessionId,
   611→        data: {
   612→          prompt: giantPayload,
   613→        },
   614→      });
   615→
   616→      const eventsPath = getSessionEventsPath(sessionsDir, sessionId);
   617→      const rawLine = (await fs.readFile(eventsPath, 'utf-8')).trim();
   618→      expect(Buffer.byteLength(rawLine, 'utf-8')).toBeLessThan(256 * 1024);
   619→
   620→      const parsed = JSON.parse(rawLine);
   621→      const pointer = parsed.data as {
   622→        path: string;
   623→        bytes: number;
   624→      };
   625→      expect(pointer.path).toMatch(/^blobs\//);
   626→
   627→      const blobPath = path.join(getSessionDir(sessionsDir, sessionId), pointer.path);
   628→      const blobContent = await fs.readFile(blobPath, 'utf-8');
   629→      expect(Buffer.byteLength(blobContent, 'utf-8')).toBe(pointer.bytes);
   630→      expect(JSON.parse(blobContent)).toEqual({ prompt: giantPayload });
   631→    });
   632→  });
