   934→// ─── Completed Session Counts ─────────────────────────────────────────────────
   935→
   936→// AC: @ui-agent-dispatch ac-1
   937→describe('getCompletedSessionCountsByAgent', () => {
   938→  let testDir: string;
   939→  let sessionsDir: string;
   940→
   941→  beforeEach(async () => {
   942→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-completed-count-'));
   943→    sessionsDir = path.join(testDir, 'sessions');
   944→  });
   945→
   946→  afterEach(async () => {
   947→    await fs.rm(testDir, { recursive: true });
   948→  });
   949→
   950→  it('should return empty object when no sessions exist', async () => {
   951→    const counts = await getCompletedSessionCountsByAgent(sessionsDir);
   952→    expect(counts).toEqual({});
   953→  });
   954→
   955→  it('should count completed sessions per agent_id', async () => {
   956→    // Create sessions with different agents and statuses
   957→    await createSession(sessionsDir, {
   958→      id: '01KF123456789ABCDEFGHJKM01',
   959→      agent_type: 'claude-code',
   960→      agent_id: 'task-worker',
   961→    });
   962→    await updateSessionStatus(sessionsDir, '01KF123456789ABCDEFGHJKM01', 'completed');
   963→
   964→    await createSession(sessionsDir, {
   965→      id: '01KF123456789ABCDEFGHJKM02',
   966→      agent_type: 'claude-code',
   967→      agent_id: 'task-worker',
   968→    });
   969→    await updateSessionStatus(sessionsDir, '01KF123456789ABCDEFGHJKM02', 'completed');
   970→
   971→    await createSession(sessionsDir, {
   972→      id: '01KF123456789ABCDEFGHJKM03',
   973→      agent_type: 'claude-code',
   974→      agent_id: 'pr-reviewer',
   975→    });
   976→    await updateSessionStatus(sessionsDir, '01KF123456789ABCDEFGHJKM03', 'completed');
   977→
   978→    // Active session should not be counted
   979→    await createSession(sessionsDir, {
   980→      id: '01KF123456789ABCDEFGHJKM04',
   981→      agent_type: 'claude-code',
   982→      agent_id: 'task-worker',
   983→    });
   984→
   985→    const counts = await getCompletedSessionCountsByAgent(sessionsDir);
   986→    expect(counts).toEqual({
   987→      'task-worker': 2,
   988→      'pr-reviewer': 1,
   989→    });
   990→  });
   991→
   992→  it('should not count abandoned or failed sessions', async () => {
   993→    await createSession(sessionsDir, {
   994→      id: '01KF123456789ABCDEFGHJKM05',
   995→      agent_type: 'claude-code',
   996→      agent_id: 'task-worker',
   997→    });
   998→    await updateSessionStatus(sessionsDir, '01KF123456789ABCDEFGHJKM05', 'abandoned');
   999→
  1000→    await createSession(sessionsDir, {
  1001→      id: '01KF123456789ABCDEFGHJKM06',
  1002→      agent_type: 'claude-code',
  1003→      agent_id: 'task-worker',
  1004→    });
  1005→    await updateSessionStatus(sessionsDir, '01KF123456789ABCDEFGHJKM06', 'failed');
  1006→
  1007→    const counts = await getCompletedSessionCountsByAgent(sessionsDir);
  1008→    expect(counts).toEqual({});
  1009→  });
  1010→
  1011→  it('should fall back to agent_type when agent_id is not set', async () => {
  1012→    await createSession(sessionsDir, {
  1013→      id: '01KF123456789ABCDEFGHJKM07',
  1014→      agent_type: 'claude-code',
  1015→    });
  1016→    await updateSessionStatus(sessionsDir, '01KF123456789ABCDEFGHJKM07', 'completed');
  1017→
  1018→    const counts = await getCompletedSessionCountsByAgent(sessionsDir);
  1019→    // getSession() materializes agent_id from agent_type for legacy sessions
  1020→    expect(counts).toEqual({
  1021→      'claude-code': 1,
  1022→    });
  1023→  });
  1024→});
