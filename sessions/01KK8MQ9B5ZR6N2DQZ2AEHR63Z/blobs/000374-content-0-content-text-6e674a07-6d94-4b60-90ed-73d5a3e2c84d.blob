   208→// ─── Storage Tests ───────────────────────────────────────────────────────────
   209→
   210→describe('Session storage', () => {
   211→  let testDir: string;
   212→  let sessionsDir: string;
   213→
   214→  beforeEach(async () => {
   215→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-test-'));
   216→    sessionsDir = path.join(testDir, 'sessions');
   217→  });
   218→
   219→  afterEach(async () => {
   220→    await fs.rm(testDir, { recursive: true });
   221→  });
   222→
   223→  describe('createSession', () => {
   224→    // AC: @session-events ac-1
   225→    it('should create session directory and metadata file', async () => {
   226→      const input: SessionMetadataInput = {
   227→        id: '01KF123456789ABCDEFGHJKMNP',
   228→        agent_type: 'claude-code',
   229→      };
   230→
   231→      const metadata = await createSession(sessionsDir, input);
   232→
   233→      // Check metadata returned
   234→      expect(metadata.id).toBe(input.id);
   235→      expect(metadata.agent_type).toBe(input.agent_type);
   236→      expect(metadata.status).toBe('active');
   237→      expect(metadata.started_at).toBeDefined();
   238→
   239→      // Check directory was created
   240→      const sessionDir = getSessionDir(sessionsDir, input.id);
   241→      const stat = await fs.stat(sessionDir);
   242→      expect(stat.isDirectory()).toBe(true);
   243→
   244→      // Check metadata file was created
   245→      const metadataPath = getSessionMetadataPath(sessionsDir, input.id);
   246→      const content = await fs.readFile(metadataPath, 'utf-8');
   247→      expect(content).toContain('id: ' + input.id);
   248→      expect(content).toContain('agent_type: claude-code');
   249→      expect(content).toContain('status: active');
   250→    });
   251→
   252→    // AC: @session-events ac-5
   253→    it('should include optional task_id in metadata', async () => {
   254→      const input: SessionMetadataInput = {
   255→        id: '01KF123456789ABCDEFGHJKMNP',
   256→        agent_type: 'claude-code',
   257→        task_id: '@my-task',
   258→      };
   259→
   260→      const metadata = await createSession(sessionsDir, input);
   261→
   262→      expect(metadata.task_id).toBe('@my-task');
   263→
   264→      const metadataPath = getSessionMetadataPath(sessionsDir, input.id);
   265→      const content = await fs.readFile(metadataPath, 'utf-8');
   266→      // Accept both single and double quotes (yaml library uses double quotes)
   267→      expect(content).toMatch(/task_id: ["']@my-task["']/);
   268→    });
   269→
   270→    it('should use provided started_at if given', async () => {
   271→      const startTime = '2026-01-17T10:00:00.000Z';
   272→      const input: SessionMetadataInput = {
   273→        id: '01KF123456789ABCDEFGHJKMNP',
   274→        agent_type: 'claude-code',
   275→        started_at: startTime,
   276→      };
   277→
   278→      const metadata = await createSession(sessionsDir, input);
   279→
   280→      expect(metadata.started_at).toBe(startTime);
   281→    });
   282→  });
   283→
   284→  describe('getSession', () => {
   285→    it('should return session metadata if exists', async () => {
   286→      const input: SessionMetadataInput = {
   287→        id: '01KF123456789ABCDEFGHJKMNP',
   288→        agent_type: 'claude-code',
   289→      };
   290→
   291→      await createSession(sessionsDir, input);
   292→      const metadata = await getSession(sessionsDir, input.id);
   293→
   294→      expect(metadata).not.toBeNull();
   295→      expect(metadata?.id).toBe(input.id);
   296→      expect(metadata?.agent_type).toBe(input.agent_type);
   297→    });
   298→
   299→    it('should return null if session does not exist', async () => {
   300→      const metadata = await getSession(sessionsDir, 'nonexistent');
   301→
   302→      expect(metadata).toBeNull();
   303→    });
   304→  });
   305→
   306→  describe('updateSessionStatus', () => {
   307→    // AC: @session-events ac-6
   308→    it('should update status and set ended_at when completing', async () => {
   309→      const input: SessionMetadataInput = {
   310→        id: '01KF123456789ABCDEFGHJKMNP',
   311→        agent_type: 'claude-code',
   312→      };
   313→
   314→      await createSession(sessionsDir, input);
   315→      const updated = await updateSessionStatus(sessionsDir, input.id, 'completed');
   316→
   317→      expect(updated).not.toBeNull();
   318→      expect(updated?.status).toBe('completed');
   319→      expect(updated?.ended_at).toBeDefined();
   320→
   321→      // Verify persisted
   322→      const reloaded = await getSession(sessionsDir, input.id);
   323→      expect(reloaded?.status).toBe('completed');
   324→      expect(reloaded?.ended_at).toBeDefined();
   325→    });
   326→
   327→    // AC: @session-events ac-6
   328→    it('should set ended_at when abandoning', async () => {
   329→      const input: SessionMetadataInput = {
   330→        id: '01KF123456789ABCDEFGHJKMNP',
   331→        agent_type: 'claude-code',
   332→      };
   333→
   334→      await createSession(sessionsDir, input);
   335→      const updated = await updateSessionStatus(sessionsDir, input.id, 'abandoned');
   336→
   337→      expect(updated?.status).toBe('abandoned');
   338→      expect(updated?.ended_at).toBeDefined();
   339→    });
   340→
   341→    it('should return null if session does not exist', async () => {
   342→      const updated = await updateSessionStatus(sessionsDir, 'nonexistent', 'completed');
   343→
   344→      expect(updated).toBeNull();
   345→    });
   346→  });
   347→
   348→  describe('listSessions', () => {
   349→    it('should list all session IDs', async () => {
   350→      await createSession(sessionsDir, { id: 'session-a', agent_type: 'claude-code' });
   351→      await createSession(sessionsDir, { id: 'session-b', agent_type: 'claude-code' });
   352→      await createSession(sessionsDir, { id: 'session-c', agent_type: 'test-agent' });
   353→
   354→      const sessions = await listSessions(sessionsDir);
   355→
   356→      expect(sessions).toHaveLength(3);
   357→      expect(sessions).toContain('session-a');
   358→      expect(sessions).toContain('session-b');
   359→      expect(sessions).toContain('session-c');
   360→    });
   361→
   362→    it('should return empty array if no sessions', async () => {
   363→      const sessions = await listSessions(sessionsDir);
   364→
   365→      expect(sessions).toHaveLength(0);
   366→    });
   367→  });
   368→
   369→  describe('sessionExists', () => {
   370→    it('should return true if session exists', async () => {
   371→      await createSession(sessionsDir, { id: 'my-session', agent_type: 'claude-code' });
   372→
   373→      const exists = await sessionExists(sessionsDir, 'my-session');
   374→
   375→      expect(exists).toBe(true);
   376→    });
   377→
   378→    it('should return false if session does not exist', async () => {
   379→      const exists = await sessionExists(sessionsDir, 'nonexistent');
   380→
   381→      expect(exists).toBe(false);
   382→    });
   383→  });
   384→});
