   794→  describe('commit boundary inclusion', () => {
   795→    // AC: @session-events ac-7
   796→    it('should include accumulated events in the next git commit', async () => {
   797→      const repoDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-commit-test-'));
   798→      const repoSessionsDir = path.join(repoDir, 'sessions');
   799→      const boundarySessionId = '01KF123456789ABCDEFGHJKMNQ';
   800→
   801→      const runGit = (...args: string[]) => {
   802→        const result = spawnSync('git', args, {
   803→          cwd: repoDir,
   804→          encoding: 'utf-8',
   805→        });
   806→        if (result.status !== 0) {
   807→          throw new Error(result.stderr || `git ${args.join(' ')} failed`);
   808→        }
   809→        return result.stdout.trim();
   810→      };
   811→
   812→      try {
   813→        runGit('init', '-b', 'main');
   814→        runGit('config', 'user.email', 'test@example.com');
   815→        runGit('config', 'user.name', 'Test User');
   816→
   817→        await fs.writeFile(path.join(repoDir, 'README.md'), '# test\n', 'utf-8');
   818→        runGit('add', 'README.md');
   819→        runGit('commit', '-m', 'test: initial commit');
   820→
   821→        await appendEvent(repoSessionsDir, {
   822→          type: 'session.update',
   823→          session_id: boundarySessionId,
   824→          data: {
   825→            update: {
   826→              rawInput: {
   827→                command: 'kspec task complete @task-ref --reason "Done"',
   828→              },
   829→            },
   830→          },
   831→        });
   832→
   833→        runGit('add', '.');
   834→        runGit('commit', '-m', 'test: commit boundary includes session events');
   835→
   836→        const committedFiles = runGit('show', '--name-only', '--pretty=format:', 'HEAD');
   837→        expect(committedFiles).toContain(`sessions/${boundarySessionId}/events.jsonl`);
   838→      } finally {
   839→        await fs.rm(repoDir, { recursive: true, force: true });
   840→      }
   841→    });
   842→  });
