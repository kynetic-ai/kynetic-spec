```
     1→/**
     2→ * Session log commands (list, show, stats, search).
     3→ *
     4→ * These commands have zero dependency on the session-start code.
     5→ */
     6→
     7→import chalk from "chalk";
     8→import {
     9→  initContext,
    10→} from "../../../parser/index.js";
    11→import {
    12→  type SessionLogSummary,
    13→  type SessionLogDetail,
    14→  type SessionLogStats,
    15→  type ToolUsageStats,
    16→  type TimePeriodStats,
    17→  type SessionSearchResult,
    18→  getAllSessionLogSummaries,
    19→  getSessionLogDetail,
    20→  resolveSessionId,
    21→  readEvents,
    22→  readSessionContext,
    23→  computeSessionLogStats,
    24→  computeToolUsageStats,
    25→  computeTimePeriodStats,
    26→  searchSessionEvents,
    27→  deduplicatePhasedToolCalls,
    28→} from "../../../sessions/store.js";
    29→import type { SessionEvent, SessionStatus } from "../../../sessions/types.js";
    30→import {
    31→  formatRelativeTime,
    32→  parseTimeSpec,
    33→} from "../../../utils/index.js";
    34→import { EXIT_CODES } from "../../exit-codes.js";
    35→import { error, output } from "../../output.js";
    36→
    37→// ─── Shared Helpers ─────────────────────────────────────────────────────────
    38→
    39→/**
    40→ * Format a duration in milliseconds to a human-readable string.
    41→ */
    42→function formatDuration(ms: number): string {
    43→  if (ms < 0) return "—";
    44→  const totalSec = Math.floor(ms / 1000);
    45→  const hours = Math.floor(totalSec / 3600);
    46→  const minutes = Math.floor((totalSec % 3600) / 60);
    47→  if (hours > 0) {
    48→    return `${hours}h ${minutes}m`;
    49→  }
    50→  if (minutes > 0) {
    51→    return `${minutes}m`;
    52→  }
    53→  return `${totalSec}s`;
    54→}
    55→
    56→/**
    57→ * Format a duration in milliseconds to human-readable format (long form).
    58→ * Handles hours/minutes/seconds.
    59→ */
    60→function formatDurationLong(ms: number): string {
    61→  if (ms < 0) return "—";
    62→  const totalSec = Math.floor(ms / 1000);
    63→  const hours = Math.floor(totalSec / 3600);
    64→  const minutes = Math.floor((totalSec % 3600) / 60);
    65→  const seconds = totalSec % 60;
    66→  if (hours > 0 && minutes > 0) {
    67→    return `${hours}h ${minutes}m`;
    68→  }
    69→  if (hours > 0) {
    70→    return `${hours}h`;
    71→  }
    72→  if (minutes > 0) {
    73→    return `${minutes}m ${seconds}s`;
    74→  }
    75→  return `${seconds}s`;
    76→}
    77→
    78→// ─── Session Log List ───────────────────────────────────────────────────────
    79→
    80→interface SessionLogListOptions {
    81→  status?: string;
    82→  agent?: string;
    83→  since?: string;
    84→  sort?: string;
    85→  count?: boolean;
    86→  limit?: string;
    87→}
    88→
    89→type SortField =
    90→  | "started_at"
    91→  | "duration"
    92→  | "events"
    93→  | "iterations"
    94→  | "tasks_completed";
    95→
    96→const VALID_SORT_FIELDS: SortField[] = [
    97→  "started_at",
    98→  "duration",
    99→  "events",
   100→  "iterations",
   101→  "tasks_completed",
   102→];
   103→
   104→/**
   105→ * Sort session summaries by the specified field.
   106→ * Default: started_at descending.
   107→ *
   108→ * AC: @session-log-list ac-5
   109→ */
   110→function sortSessions(
   111→  sessions: SessionLogSummary[],
   112→  sortField: SortField,
   113→): SessionLogSummary[] {
   114→  return [...sessions].sort((a, b) => {
   115→    switch (sortField) {
   116→      case "started_at":
   117→        return (
   118→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
   119→        );
   120→      case "duration":
   121→        return b.duration_ms - a.duration_ms;
   122→      case "events":
   123→        return b.event_count - a.event_count;
   124→      case "iterations":
   125→        return b.iteration_count - a.iteration_count;
   126→      case "tasks_completed":
   127→        return b.tasks_completed - a.tasks_completed;
   128→      default:
   129→        return (
   130→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
   131→        );
   132→    }
   133→  });
   134→}
   135→
   136→/**
   137→ * Format the session log list as a table.
   138→ *
   139→ * AC: @session-log-list ac-1
   140→ */
   141→function formatSessionLogList(sessions: SessionLogSummary[]): void {
   142→  if (sessions.length === 0) {
   143→    // AC: @session-log-list ac-6
   144→    console.log("No sessions found.");
   145→    return;
   146→  }
   147→
   148→  // Table header
   149→  console.log(
   150→    chalk.gray(
   151→      `${"ID".padEnd(10)} ${"Status".padEnd(11)} ${"Agent".padEnd(20)} ${"Started".padEnd(16)} ${"Duration".padEnd(10)} ${"Events".padEnd(8)} ${"Iters".padEnd(7)} Tasks`,
   152→    ),
   153→  );
   154→  console.log(chalk.gray("─".repeat(95)));
   155→
   156→  for (const s of sessions) {
   157→    const id = s.id.slice(0, 8);
   158→    const statusColor =
   159→      s.status === "completed"
   160→        ? chalk.green
   161→        : s.status === "active"
   162→          ? chalk.blue
   163→          : chalk.yellow;
   164→    const status = statusColor(s.status.padEnd(11));
   165→    const agent = s.agent_type.slice(0, 20).padEnd(20);
   166→    const started = formatRelativeTime(new Date(s.started_at)).padEnd(16);
   167→    const duration = formatDuration(s.duration_ms).padEnd(10);
   168→    const events = String(s.event_count).padEnd(8);
   169→    const iters = String(s.iteration_count).padEnd(7);
   170→    const tasks = String(s.tasks_completed);
   171→
   172→    console.log(
   173→      `${chalk.yellow(id)} ${status} ${chalk.gray(agent)} ${chalk.gray(started)} ${duration} ${events} ${iters} ${tasks}`,
   174→    );
   175→  }
   176→
   177→  console.log(chalk.gray(`\n${sessions.length} session(s)`));
   178→}
   179→
   180→/**
   181→ * Session log list action handler.
   182→ */
   183→export async function sessionLogListAction(
   184→  options: SessionLogListOptions,
   185→): Promise<void> {
   186→  try {
   187→    const ctx = await initContext();
   188→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
   189→
   190→    // AC: @session-log-list ac-2 - Filter by status
   191→    if (options.status) {
   192→      const statusFilter = options.status as SessionStatus;
   193→      sessions = sessions.filter((s) => s.status === statusFilter);
   194→    }
   195→
   196→    // AC: @session-log-list ac-4 - Filter by agent type
   197→    if (options.agent) {
   198→      const agentFilter = options.agent;
   199→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
   200→    }
   201→
   202→    // AC: @session-log-list ac-3 - Filter by since date
   203→    if (options.since) {
   204→      const sinceDate = parseTimeSpec(options.since);
   205→      if (sinceDate) {
   206→        sessions = sessions.filter(
   207→          (s) => new Date(s.started_at) >= sinceDate,
   208→        );
   209→      }
   210→    }
   211→
   212→    // AC: @session-log-list ac-5 - Sort
   213→    const sortField: SortField =
   214→      options.sort && VALID_SORT_FIELDS.includes(options.sort as SortField)
   215→        ? (options.sort as SortField)
   216→        : "started_at";
   217→    sessions = sortSessions(sessions, sortField);
   218→
   219→    // AC: @session-log-list ac-7 - Limit output count
   220→    if (options.count) {
   221→      // AC: @trait-filterable-list ac-8
   222→      output({ count: sessions.length }, () => {
   223→        console.log(sessions.length);
   224→      });
   225→      return;
   226→    }
   227→
   228→    // Apply --limit (after filtering/sorting, before display)
   229→    if (options.limit) {
   230→      const limit = parseInt(options.limit, 10);
   231→      if (!Number.isNaN(limit) && limit > 0) {
   232→        sessions = sessions.slice(0, limit);
   233→      }
   234→    }
   235→
   236→    output(sessions, () => formatSessionLogList(sessions));
   237→  } catch (err) {
   238→    error("Failed to list session logs", err);
   239→    process.exit(EXIT_CODES.ERROR);
   240→  }
   241→}
   242→
   243→// ─── Session Log Show ───────────────────────────────────────────────────────
   244→
   245→interface SessionLogShowOptions {
   246→  events?: boolean;
   247→  type?: string;
   248→  limit?: string;
   249→  context?: string;
   250→}
   251→
   252→/**
   253→ * Format an event timestamp as relative time from session start.
   254→ */
   255→function formatEventTimestamp(
   256→  eventTs: number,
   257→  sessionStartTs: number,
   258→): string {
   259→  const relativeMs = eventTs - sessionStartTs;
   260→  const totalSec = Math.floor(relativeMs / 1000);
   261→  const minutes = Math.floor(totalSec / 60);
   262→  const seconds = totalSec % 60;
   263→  if (minutes > 0) {
   264→    return `+${minutes}m${seconds}s`;
   265→  }
   266→  return `+${seconds}s`;
   267→}
   268→
   269→/**
   270→ * Summarize event data for display.
   271→ * Returns a short string describing the event payload.
   272→ */
   273→function summarizeEventData(event: SessionEvent): string {
   274→  const data = event.data as Record<string, unknown> | null;
   275→  if (!data) return "";
   276→
   277→  // Handle tool_call events
   278→  if (event.type === "session.update") {
   279→    const update = data.update as {
   280→      sessionUpdate?: string;
   281→      rawInput?: { command?: string };
   282→      _meta?: { claudeCode?: { toolName?: string } };
   283→    } | null;
   284→    if (update?.sessionUpdate === "tool_call") {
   285→      const toolName = update._meta?.claudeCode?.toolName || "unknown";
   286→      const command = update.rawInput?.command;
   287→      if (command) {
   288→        const truncated =
   289→          command.length > 60 ? command.slice(0, 57) + "..." : command;
   290→        return `${toolName}: ${truncated}`;
   291→      }
   292→      return toolName;
   293→    }
   294→  }
   295→
   296→  // Handle prompt.sent events
   297→  if (event.type === "prompt.sent") {
   298→    const prompt = data.prompt as string | null;
   299→    if (prompt) {
   300→      const truncated =
   301→        prompt.length > 60 ? prompt.slice(0, 57) + "..." : prompt;
   302→      return truncated;
   303→    }
   304→  }
   305→
   306→  // Handle session.start/end
   307→  if (event.type === "session.start") {
   308→    return "Session started";
   309→  }
   310→  if (event.type === "session.end") {
   311→    const reason = data.reason as string | null;
   312→    return reason ? `Session ended: ${reason}` : "Session ended";
   313→  }
   314→
   315→  // Default: show first key
   316→  const keys = Object.keys(data);
   317→  if (keys.length > 0) {
   318→    return `{${keys.slice(0, 3).join(", ")}${keys.length > 3 ? ", ..." : ""}}`;
   319→  }
   320→  return "";
   321→}
   322→
   323→/**
   324→ * Format the session log show output.
   325→ *
   326→ * AC: @session-log-show ac-1
   327→ */
   328→function formatSessionLogShow(
   329→  detail: SessionLogDetail,
   330→  events: SessionEvent[] | null,
   331→  contextSnapshot: unknown | null,
   332→  sessionStartTs: number,
   333→): void {
   334→  // AC: @session-log-show ac-1 - Session metadata
   335→  console.log(chalk.bold(`Session ${detail.id.slice(0, 8)}`));
   336→  console.log(chalk.gray("─".repeat(60)));
   337→  console.log(`  ID:        ${detail.id}`);
   338→
   339→  const statusColor =
   340→    detail.status === "completed"
   341→      ? chalk.green
   342→      : detail.status === "active"
   343→        ? chalk.blue
   344→        : chalk.yellow;
   345→  console.log(`  Status:    ${statusColor(detail.status)}`);
   346→  console.log(`  Agent:     ${detail.agent_type}`);
   347→  if (detail.task_id) {
   348→    console.log(`  Task:      ${detail.task_id}`);
   349→  }
   350→  console.log(`  Started:   ${detail.started_at}`);
   351→  if (detail.ended_at) {
   352→    console.log(`  Ended:     ${detail.ended_at}`);
   353→  }
   354→  console.log(`  Duration:  ${formatDuration(detail.duration_ms)}`);
   355→  console.log(`  Events:    ${detail.event_count}`);
   356→  console.log(`  Iterations: ${detail.iteration_count}`);
   357→
   358→  // AC: @session-log-show ac-2 - Per-iteration summary
   359→  if (detail.iterations.length > 0) {
   360→    console.log("\n" + chalk.bold("Iterations"));
   361→    console.log(chalk.gray("─".repeat(60)));
   362→    for (const iter of detail.iterations) {
   363→      const taskInfo: string[] = [];
   364→      if (iter.tasks_started.length > 0) {
   365→        taskInfo.push(`started: ${iter.tasks_started.join(", ")}`);
   366→      }
   367→      if (iter.tasks_completed.length > 0) {
   368→        taskInfo.push(`completed: ${iter.tasks_completed.join(", ")}`);
   369→      }
   370→      const taskStr = taskInfo.length > 0 ? ` | ${taskInfo.join(" | ")}` : "";
   371→      console.log(
   372→        `  ${chalk.cyan(`[${iter.iteration}]`)} ${iter.event_count} events${taskStr}`,
   373→      );
   374→    }
   375→  }
   376→
   377→  // AC: @session-log-show ac-3 - Event timeline
   378→  if (events !== null) {
   379→    console.log("\n" + chalk.bold("Events"));
   380→    console.log(chalk.gray("─".repeat(60)));
   381→    if (events.length === 0) {
   382→      console.log(chalk.gray("  No events to display."));
   383→    } else {
   384→      for (const event of events) {
   385→        const timestamp = formatEventTimestamp(event.ts, sessionStartTs);
   386→        const summary = summarizeEventData(event);
   387→        const typeColor =
   388→          event.type === "session.start" || event.type === "session.end"
   389→            ? chalk.green
   390→            : event.type === "session.update"
   391→              ? chalk.blue
   392→              : chalk.gray;
   393→        console.log(
   394→          `  ${chalk.yellow(timestamp.padEnd(10))} ${typeColor(event.type.padEnd(16))} ${chalk.gray(summary)}`,
   395→        );
   396→      }
   397→    }
   398→  }
   399→
   400→  // AC: @session-log-show ac-6 - Context snapshot
   401→  if (contextSnapshot !== null) {
   402→    console.log("\n" + chalk.bold("Context Snapshot"));
   403→    console.log(chalk.gray("─".repeat(60)));
   404→    console.log(JSON.stringify(contextSnapshot, null, 2));
   405→  }
   406→}
   407→
   408→/**
   409→ * Session log show action handler.
   410→ */
   411→export async function sessionLogShowAction(
   412→  sessionRef: string,
   413→  options: SessionLogShowOptions,
   414→): Promise<void> {
   415→  try {
   416→    const ctx = await initContext();
   417→
   418→    // AC: @session-log-show ac-7, ac-8, ac-9 - Resolve session ID
   419→    const resolution = await resolveSessionId(ctx.specDir, sessionRef);
   420→
   421→    if (!resolution.ok) {
   422→      if (resolution.error === "not_found") {
   423→        // AC: @session-log-show ac-9
   424→        error(`Session not found: ${sessionRef}`);
   425→        process.exit(EXIT_CODES.NOT_FOUND);
   426→      } else {
   427→        // AC: @session-log-show ac-8
   428→        error(
   429→          `Ambiguous session ID prefix. Matches:\n  ${resolution.matches.join("\n  ")}\nPlease provide a more specific prefix.`,
   430→        );
   431→        process.exit(EXIT_CODES.VALIDATION_FAILED);
   432→      }
   433→    }
   434→
   435→    const sessionId = resolution.id;
   436→
   437→    // Get session detail
   438→    const detail = await getSessionLogDetail(ctx.specDir, sessionId);
   439→    if (!detail) {
   440→      error(`Session not found: ${sessionId}`);
   441→      process.exit(EXIT_CODES.NOT_FOUND);
   442→    }
   443→
   444→    // AC: @session-log-show ac-3, ac-4, ac-5 - Event timeline
   445→    let events: SessionEvent[] | null = null;
   446→    if (options.events) {
   447→      let allEvents = deduplicatePhasedToolCalls(
   448→        await readEvents(ctx.specDir, sessionId),
   449→      );
   450→
   451→      // AC: @session-log-show ac-4 - Filter by type
   452→      if (options.type) {
   453→        const typeFilter = options.type;
   454→        allEvents = allEvents.filter((e) => e.type === typeFilter);
   455→      }
   456→
   457→      // AC: @session-log-show ac-5 - Limit to last N events
   458→      if (options.limit) {
   459→        const limit = parseInt(options.limit, 10);
   460→        if (!Number.isNaN(limit) && limit > 0) {
   461→          allEvents = allEvents.slice(-limit);
   462→        }
   463→      }
   464→
   465→      events = allEvents;
   466→    }
   467→
   468→    // AC: @session-log-show ac-6 - Context snapshot
   469→    let contextSnapshot: unknown | null = null;
   470→    if (options.context) {
   471→      const iterNum = parseInt(options.context, 10);
   472→      if (!Number.isNaN(iterNum) && iterNum > 0) {
   473→        contextSnapshot = await readSessionContext(
   474→          ctx.specDir,
   475→          sessionId,
   476→          iterNum,
   477→        );
   478→        if (contextSnapshot === null) {
   479→          error(`No context snapshot found for iteration ${iterNum}`);
   480→          process.exit(EXIT_CODES.NOT_FOUND);
   481→        }
   482→      } else {
   483→        error(`Invalid iteration number: ${options.context}`);
   484→        process.exit(EXIT_CODES.USAGE_ERROR);
   485→      }
   486→    }
   487→
   488→    const sessionStartTs = new Date(detail.started_at).getTime();
   489→
   490→    // Build JSON output structure
   491→    const jsonOutput = {
   492→      ...detail,
   493→      ...(events !== null ? { events } : {}),
   494→      ...(contextSnapshot !== null ? { context: contextSnapshot } : {}),
   495→    };
   496→
   497→    output(jsonOutput, () =>
   498→      formatSessionLogShow(detail, events, contextSnapshot, sessionStartTs),
   499→    );
   500→  } catch (err) {
   501→    error("Failed to show session log", err);
   502→    process.exit(EXIT_CODES.ERROR);
   503→  }
   504→}
   505→
   506→// ─── Session Log Stats ──────────────────────────────────────────────────────
   507→
   508→interface SessionLogStatsOptions {
   509→  since?: string;
   510→  agent?: string;
   511→  toolUsage?: boolean;
   512→  byDay?: boolean;
   513→  byWeek?: boolean;
   514→}
   515→
   516→/**
   517→ * Full stats output including optional tool usage and time period data.
   518→ */
   519→interface SessionLogStatsOutput {
   520→  stats: SessionLogStats;
   521→  tool_usage?: ToolUsageStats[];
   522→  time_periods?: TimePeriodStats[];
   523→}
   524→
   525→/**
   526→ * Format the session log stats output.
   527→ *
   528→ * AC: @session-log-stats ac-1, ac-2, ac-3
   529→ */
   530→function formatSessionLogStats(
   531→  stats: SessionLogStats,
   532→  toolUsage: ToolUsageStats[] | null,
   533→  timePeriods: TimePeriodStats[] | null,
   534→  groupBy: "day" | "week" | null,
   535→): void {
   536→  // AC: @session-log-stats ac-1 - Totals
   537→  console.log(chalk.bold("Session Statistics"));
   538→  console.log(chalk.gray("─".repeat(50)));
   539→  console.log(`  Total Sessions:     ${stats.total_sessions}`);
   540→  console.log(`  Total Events:       ${stats.total_events}`);
   541→  console.log(`  Total Iterations:   ${stats.total_iterations}`);
   542→  console.log(`  Tasks Completed:    ${stats.total_tasks_completed}`);
   543→  console.log(`  Total Duration:     ${formatDurationLong(stats.total_duration_ms)}`);
   544→
   545→  // AC: @session-log-stats ac-2 - Averages
   546→  console.log("\n" + chalk.bold("Averages"));
   547→  console.log(chalk.gray("─".repeat(50)));
   548→  console.log(`  Avg Duration/Session:     ${formatDurationLong(stats.avg_duration_ms)}`);
   549→  console.log(`  Avg Iterations/Session:   ${stats.avg_iterations_per_session}`);
   550→  console.log(`  Avg Tasks/Session:        ${stats.avg_tasks_per_session}`);
   551→
   552→  // AC: @session-log-stats ac-3 - Status breakdown
   553→  if (stats.status_breakdown.length > 0) {
   554→    console.log("\n" + chalk.bold("Status Breakdown"));
   555→    console.log(chalk.gray("─".repeat(50)));
   556→    for (const item of stats.status_breakdown) {
   557→      const statusColor =
   558→        item.status === "completed"
   559→          ? chalk.green
   560→          : item.status === "active"
   561→            ? chalk.blue
   562→            : chalk.yellow;
   563→      console.log(
   564→        `  ${statusColor(item.status.padEnd(12))} ${String(item.count).padEnd(6)} ${item.percentage}%`,
   565→      );
   566→    }
   567→  }
   568→
   569→  // AC: @session-log-stats ac-6 - Tool usage
   570→  if (toolUsage !== null && toolUsage.length > 0) {
   571→    console.log("\n" + chalk.bold("Top Tool Usage"));
   572→    console.log(chalk.gray("─".repeat(50)));
   573→    for (const tool of toolUsage) {
   574→      console.log(
   575→        `  ${tool.tool_name.padEnd(20)} ${String(tool.count).padEnd(8)} ${tool.percentage}%`,
   576→      );
   577→    }
   578→  }
   579→
   580→  // AC: @session-log-stats ac-7 - Time periods
   581→  if (timePeriods !== null && timePeriods.length > 0) {
   582→    const label = groupBy === "week" ? "By Week" : "By Day";
   583→    console.log("\n" + chalk.bold(label));
   584→    console.log(chalk.gray("─".repeat(50)));
   585→    console.log(
   586→      chalk.gray(
   587→        `  ${"Period".padEnd(14)} ${"Sessions".padEnd(10)} ${"Tasks".padEnd(8)} Duration`,
   588→      ),
   589→    );
   590→    for (const period of timePeriods) {
   591→      console.log(
   592→        `  ${period.period.padEnd(14)} ${String(period.sessions_count).padEnd(10)} ${String(period.tasks_completed).padEnd(8)} ${formatDurationLong(period.total_duration_ms)}`,
   593→      );
   594→    }
   595→  }
   596→}
   597→
   598→/**
   599→ * Session log stats action handler.
   600→ */
   601→export async function sessionLogStatsAction(
   602→  options: SessionLogStatsOptions,
   603→): Promise<void> {
   604→  try {
   605→    const ctx = await initContext();
   606→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
   607→
   608→    // AC: @session-log-stats ac-4 - Filter by since
   609→    if (options.since) {
   610→      const sinceDate = parseTimeSpec(options.since);
   611→      if (sinceDate) {
   612→        sessions = sessions.filter(
   613→          (s) => new Date(s.started_at) >= sinceDate,
   614→        );
   615→      }
   616→    }
   617→
   618→    // AC: @session-log-stats ac-5 - Filter by agent type
   619→    if (options.agent) {
   620→      const agentFilter = options.agent;
   621→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
   622→    }
   623→
   624→    // AC: @session-log-stats ac-8 - No sessions match criteria
   625→    if (sessions.length === 0) {
   626→      output({ message: "No sessions match criteria" }, () => {
   627→        console.log("No sessions match criteria.");
   628→      });
   629→      return;
   630→    }
   631→
   632→    // Compute base stats
   633→    const stats = computeSessionLogStats(sessions);
   634→
   635→    // AC: @session-log-stats ac-6 - Tool usage (optional)
   636→    let toolUsage: ToolUsageStats[] | null = null;
   637→    if (options.toolUsage) {
   638→      const sessionIds = sessions.map((s) => s.id);
   639→      toolUsage = await computeToolUsageStats(ctx.specDir, sessionIds);
   640→    }
   641→
   642→    // AC: @session-log-stats ac-7 - Time periods (optional)
   643→    let timePeriods: TimePeriodStats[] | null = null;
   644→    let groupBy: "day" | "week" | null = null;
   645→    if (options.byDay) {
   646→      groupBy = "day";
   647→      timePeriods = computeTimePeriodStats(sessions, "day");
   648→    } else if (options.byWeek) {
   649→      groupBy = "week";
   650→      timePeriods = computeTimePeriodStats(sessions, "week");
   651→    }
   652→
   653→    // Build output structure
   654→    const jsonOutput: SessionLogStatsOutput = { stats };
   655→    if (toolUsage !== null) {
   656→      jsonOutput.tool_usage = toolUsage;
   657→    }
   658→    if (timePeriods !== null) {
   659→      jsonOutput.time_periods = timePeriods;
   660→    }
   661→
   662→    output(jsonOutput, () =>
   663→      formatSessionLogStats(stats, toolUsage, timePeriods, groupBy),
   664→    );
   665→  } catch (err) {
   666→    error("Failed to compute session log stats", err);
   667→    process.exit(EXIT_CODES.ERROR);
   668→  }
   669→}
   670→
   671→// ─── Session Log Search ─────────────────────────────────────────────────────
   672→
   673→interface SessionLogSearchOptions {
   674→  type?: string;
   675→  since?: string;
   676→  agent?: string;
   677→  limit?: string;
   678→}
   679→
   680→/**
   681→ * Format relative timestamp from event timestamp (Unix ms) to session start.
   682→ */
   683→function formatSearchTimestamp(eventTs: number): string {
   684→  return new Date(eventTs).toISOString();
   685→}
   686→
   687→/**
   688→ * Format the session log search output.
   689→ *
   690→ * AC: @session-log-search ac-1, ac-4
   691→ */
   692→function formatSessionLogSearch(results: SessionSearchResult[]): void {
   693→  if (results.length === 0) {
   694→    // AC: @session-log-search ac-6
   695→    console.log("No matches found.");
   696→    return;
   697→  }
   698→
   699→  let totalMatches = 0;
   700→  for (const session of results) {
   701→    totalMatches += session.matches.length;
   702→  }
   703→
   704→  console.log(chalk.bold(`Found ${totalMatches} match(es) in ${results.length} session(s)`));
   705→  console.log(chalk.gray("─".repeat(60)));
   706→
   707→  for (const session of results) {
   708→    // Session header
   709→    console.log(
   710→      `\n${chalk.cyan(`Session ${session.session_id.slice(0, 8)}`)} ` +
   711→        `${chalk.gray(`(${session.agent_type}, started ${formatRelativeTime(new Date(session.started_at))})`)}`
   712→    );
   713→
   714→    // AC: @session-log-search ac-4 - Show matches with session ID, timestamp, type, excerpt
   715→    for (const match of session.matches) {
   716→      const ts = formatSearchTimestamp(match.timestamp);
   717→      const typeColor =
   718→        match.event_type === "session.start" || match.event_type === "session.end"
   719→          ? chalk.green
   720→          : match.event_type === "session.update"
   721→            ? chalk.blue
   722→            : chalk.gray;
   723→      console.log(
   724→        `  ${chalk.yellow(ts)} ${typeColor(match.event_type.padEnd(16))}`,
   725→      );
   726→      // Content excerpt on next line, indented
   727→      console.log(`    ${chalk.gray(match.content_excerpt)}`);
   728→    }
   729→  }
   730→}
   731→
   732→/**
   733→ * Session log search action handler.
   734→ *
   735→ * AC: @session-log-search ac-1 through ac-7
   736→ */
   737→export async function sessionLogSearchAction(
   738→  pattern: string,
   739→  options: SessionLogSearchOptions,
   740→): Promise<void> {
   741→  try {
   742→    const ctx = await initContext();
   743→
   744→    // Parse options - validate limit as positive integer
   745→    let limit = 50;
   746→    if (options.limit) {
   747→      const parsed = parseInt(options.limit, 10);
   748→      if (Number.isNaN(parsed) || parsed <= 0) {
   749→        error(`Invalid limit: ${options.limit}. Must be a positive integer.`);
   750→        process.exit(EXIT_CODES.USAGE_ERROR);
   751→      }
   752→      limit = parsed;
   753→    }
   754→    const sinceDate = options.since ? parseTimeSpec(options.since) : undefined;
   755→
   756→    // AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7
   757→    const results = await searchSessionEvents(ctx.specDir, pattern, {
   758→      eventType: options.type,
   759→      sinceDate: sinceDate || undefined,
   760→      agentType: options.agent,
   761→      limit,
   762→    });
   763→
   764→    // AC: @session-log-search ac-6 - No matches found message
   765→    // exit code 0 regardless (per @trait-semantic-exit-codes ac-5)
   766→
   767→    output(results, () => formatSessionLogSearch(results));
   768→  } catch (err) {
   769→    error("Failed to search session logs", err);
   770→    process.exit(EXIT_CODES.ERROR);
   771→  }
   772→}
   773→
```