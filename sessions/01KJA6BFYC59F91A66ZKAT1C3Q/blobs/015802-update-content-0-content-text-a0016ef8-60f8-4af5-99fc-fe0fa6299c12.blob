   509→/**
   510→ * Get default author value for an agent type
   511→ */
   512→function getDefaultAuthor(agentType: AgentType): string {
   513→  switch (agentType) {
   514→    case "claude-code":
   515→      return "@claude";
   516→    case "cline":
   517→      return "@cline";
   518→    case "roo-code":
   519→      return "@roo";
   520→    case "copilot-cli":
   521→      return "@copilot";
   522→    case "gemini-cli":
   523→      return "@gemini";
   524→    case "codex-cli":
   525→      return "@codex";
   526→    case "aider":
   527→      return "@aider";
   528→    case "opencode":
   529→      return "@opencode";
   530→    case "amp":
   531→      return "@amp";
   532→    default:
   533→      return "@agent";
   534→  }
   535→}
   536→
   537→/**
   538→ * Prompt user for input with Y/N answer
   539→ */
   540→async function promptYesNo(question: string): Promise<boolean> {
   541→  const rl = readline.createInterface({
   542→    input: process.stdin,
   543→    output: process.stdout,
   544→  });
   545→
   546→  try {
   547→    const answer = await rl.question(`${question} `);
   548→    return answer.toLowerCase() === "y";
   549→  } finally {
   550→    rl.close();
   551→  }
   552→}
   553→
   554→/**
   555→ * Ensure .kspec worktree exists if kspec-meta branch is present.
   556→ * AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
   557→ *
   558→ * @param autoWorktree If true, automatically create worktree without prompting
   559→ * @returns true if worktree is ready to use
   560→ */
   561→async function ensureWorktree(autoWorktree: boolean): Promise<boolean> {
   562→  const projectRoot = getGitRoot(process.cwd());
   563→  if (!projectRoot) {
   564→    // Not in a git repo, skip worktree check
   565→    return true;
   566→  }
   567→
   568→  const status = await getShadowStatus(projectRoot);
   569→
   570→  // AC: worktree-already-exists - if already valid, skip
   571→  if (status.healthy) {
   572→    return true;
   573→  }
   574→
   575→  // AC: detect-existing-repo - branch exists but worktree doesn't
   576→  if (status.branchExists && !status.worktreeExists) {
   577→    // AC: auto-worktree-flag - auto-create if flag set
   578→    if (autoWorktree) {
   579→      console.log(
   580→        `Detected ${SHADOW_BRANCH_NAME} branch without .kspec worktree. Creating...`,
   581→      );
   582→      const result = await repairShadow(projectRoot);
   583→      if (result.success) {
   584→        success("Created .kspec worktree");
   585→        return true;
   586→      } else {
   587→        error(`Failed to create worktree: ${result.error}`);
   588→        return false;
   589→      }
   590→    }
   591→
   592→    // AC: detect-existing-repo - prompt user
   593→    const shouldCreate = await promptYesNo(
   594→      `${SHADOW_BRANCH_NAME} branch exists but .kspec worktree is missing. Create it? (y/N)`,
   595→    );
   596→
   597→    if (shouldCreate) {
   598→      console.log("Creating .kspec worktree...");
   599→      const result = await repairShadow(projectRoot);
   600→      if (result.success) {
   601→        success("Created .kspec worktree");
   602→        return true;
   603→      } else {
   604→        error(`Failed to create worktree: ${result.error}`);
   605→        return false;
   606→      }
   607→    } else {
   608→      warn("Skipping worktree creation");
   609→      return false;
   610→    }
   611→  }
   612→
   613→  // No kspec-meta branch, or already healthy
   614→  return true;
   615→}
   616→
   617→/**
   618→ * Print manual setup instructions
   619→ */
   620→function printManualInstructions(agentType: AgentType): void {
   621→  const author = getDefaultAuthor(agentType);
   622→
   623→  console.log("\nManual setup instructions:\n");
   624→
   625→  switch (agentType) {
   626→    case "claude-code":
   627→      console.log("Add to ~/.claude/settings.json:");
   628→      console.log("```json");
   629→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   630→      console.log("```");
   631→      break;
   632→
   633→    case "cline":
   634→    case "roo-code":
   635→      console.log("Add to your shell profile (~/.bashrc, ~/.zshrc):");
   636→      console.log("```bash");
   637→      console.log(`export KSPEC_AUTHOR="${author}"`);
   638→      console.log("```");
   639→      console.log(
   640→        "\nThis will be inherited by terminals spawned by the VS Code extension.",
   641→      );
   642→      break;
   643→
   644→    case "copilot-cli":
   645→      console.log("Add to ~/.copilot/config.json:");
   646→      console.log("```json");
   647→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   648→      console.log("```");
   649→      break;
   650→
   651→    case "aider":
   652→      console.log("Add to ~/.aider.conf.yml:");
   653→      console.log("```yaml");
   654→      console.log("set-env:");
   655→      console.log(`  - KSPEC_AUTHOR=${author}`);
   656→      console.log("```");
   657→      break;
   658→
   659→    case "codex-cli":
   660→      console.log("Add to ~/.codex/config.toml:");
   661→      console.log("```toml");
   662→      console.log("[shell_environment_policy]");
   663→      console.log(`set = { KSPEC_AUTHOR = "${author}" }`);
   664→      console.log("```");
   665→      break;
   666→
   667→    case "opencode":
   668→      console.log("Add to ~/.config/opencode/opencode.json:");
   669→      console.log("```json");
   670→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   671→      console.log("```");
   672→      break;
   673→
   674→    case "amp":
   675→      console.log("Add to ~/.config/amp/settings.json:");
   676→      console.log("```json");
   677→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   678→      console.log("```");
   679→      break;
   680→
   681→    default:
   682→      console.log("Set the KSPEC_AUTHOR environment variable:");
   683→      console.log("```bash");
   684→      console.log(`export KSPEC_AUTHOR="${author}"`);
   685→      console.log("```");
   686→      console.log("\nOr add to your shell profile (~/.bashrc, ~/.zshrc, etc.)");
   687→  }
   688→}
   689→
   690→/**
   691→ * Result of a setup step
   692→ */
   693→interface SetupStepResult {
   694→  name: string;
   695→  status: "done" | "skipped" | "failed";
   696→  message?: string;
   697→  details?: Record<string, unknown>;
   698→}
   699→
   700→/**
   701→ * Result of running the setup pipeline
   702→ * Used by both the setup command and init --setup
   703→ * AC: @init-setup-integration ac-2, ac-3
   704→ */
   705→export interface SetupPipelineResult {
   706→  success: boolean;
   707→  steps: SetupStepResult[];
   708→  coreSkillsInstalled: number;
   709→  skillsRendered: number;
   710→  hooksInstalled: boolean;
   711→  agentsMdGenerated: boolean;
   712→  permissionsSeeded: boolean;
   713→  memorySeeded: boolean;
   714→}
   715→
   716→/**
   717→ * Options for running the setup pipeline
   718→ */
   719→export interface SetupPipelineOptions {
   720→  dryRun?: boolean;
   721→  skipSkills?: boolean;
   722→  installHooks?: boolean;
   723→  force?: boolean;
   724→  /** Custom author string (overrides auto-detected default) */
   725→  author?: string;
   726→  /** Whether to configure author (only in command handler, not init) */
   727→  configureAuthor?: boolean;
   728→}
   729→
   730→/**
   731→ * Status of the setup state
   732→ * AC: @enhanced-setup ac-7, ac-8 - status reporting
   733→ */
   734→interface SetupStatus {
   735→  agent: {
   736→    detected: AgentType;
   737→    confidence: "high" | "medium" | "low";
   738→  };
   739→  hooks: {
   740→    promptCheck: boolean;
   741→    stop: boolean;
   742→    preToolUse: boolean;
   743→    guardsPresent: string[];
   744→  };
   745→  skills: {
   746→    total: number;
   747→    rendered: number;
   748→    drifted: number;
   749→  };
   750→  plugin: {
   751→    marketplaceRegistered: boolean;
   752→    marketplaceHealthy: boolean;
   753→    pluginEnabled: boolean;
   754→    registeredPath?: string;
   755→    healthMessage?: string;
   756→  };
   757→  agentsMd: {
   758→    exists: boolean;
   759→    // AC: @doctor-command ac-staleness-unknown — includes "unknown" for indeterminate cases
   760→    status: "current" | "stale" | "missing" | "unknown";
   761→    generatedAt?: string;
   762→  };
   763→  seeding: {
   764→    permissionsSeeded: boolean;
   765→    memorySeeded: boolean;
   766→    memoryPath?: string;
   767→  };
   768→}
   769→
   770→/**
   771→ * Check the current setup status
   772→ * AC: @enhanced-setup ac-7, ac-8
   773→ */
   774→async function getSetupStatus(projectDir: string): Promise<SetupStatus> {
   775→  const detected = detectAgent();
   776→  const configPath = path.join(projectDir, ".claude", "settings.json");
   777→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   778→  const agentsMdPath = path.join(projectDir, "kspec-agents.md");
   779→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
   780→  const skillsDir = path.join(projectDir, ".claude", "skills");
   781→
   782→  // Check hooks
   783→  const hooks = {
   784→    promptCheck: false,
   785→    stop: false,
   786→    preToolUse: false,
   787→    guardsPresent: [] as string[],
   788→  };
   789→
   790→  try {
   791→    const configContent = await fs.readFile(configPath, "utf-8");
   792→    const config = JSON.parse(configContent);
   793→    const hooksConfig = config.hooks || {};
   794→
   795→    // Check UserPromptSubmit
   796→    const promptHooks = hooksConfig.UserPromptSubmit as Array<{
   797→      hooks?: Array<{ command?: string }>;
   798→    }> | undefined;
   799→    hooks.promptCheck = promptHooks?.some((entry) =>
   800→      entry.hooks?.some((h) => h.command?.includes("prompt-check")),
   801→    ) ?? false;
   802→
   803→    // Check Stop
   804→    const stopHooks = hooksConfig.Stop as Array<{
   805→      hooks?: Array<{ command?: string }>;
   806→    }> | undefined;
   807→    hooks.stop = stopHooks?.some((entry) =>
   808→      entry.hooks?.some((h) => h.command?.includes("checkpoint")),
   809→    ) ?? false;
   810→
   811→    // Check PreToolUse — look for native kspec guard worktree command
   812→    const preToolUseHooks = hooksConfig.PreToolUse as Array<{
   813→      hooks?: Array<{ command?: string }>;
   814→    }> | undefined;
   815→    hooks.preToolUse = preToolUseHooks?.some((entry) =>
   816→      entry.hooks?.some((h) =>
   817→        h.command === NATIVE_GUARD_COMMAND || h.command?.includes(".claude/hooks/"),
   818→      ),
   819→    ) ?? false;
   820→
   821→    // Check for native guard command
   822→    if (preToolUseHooks?.some((entry) =>
   823→      entry.hooks?.some((h) => h.command === NATIVE_GUARD_COMMAND),
   824→    )) {
   825→      hooks.guardsPresent.push("kspec guard worktree");
   826→    }
   827→    // Check for legacy bash scripts still present
   828→    if (preToolUseHooks?.some((entry) =>
   829→      entry.hooks?.some((h) =>
   830→        OLD_GUARD_SCRIPTS.some((name) => h.command?.includes(name)),
   831→      ),
   832→    )) {
   833→      hooks.guardsPresent.push("legacy:bash-scripts");
   834→    }
   835→  } catch (err) {
   836→    debugLog("Failed to read hooks config for status", err);
   837→  }
   838→
   839→  // Check for legacy guard script files on disk
   840→  try {
   841→    const guardFiles = await fs.readdir(hooksDir);
   842→    for (const name of OLD_GUARD_SCRIPTS) {
   843→      if (guardFiles.includes(name)) {
   844→        hooks.guardsPresent.push(`legacy-file:${name}`);
   845→      }
   846→    }
   847→  } catch (err) {
   848→    debugLog("Hooks dir doesn't exist", err);
   849→  }
   850→
   851→  // Check skills
   852→  const skills = {
   853→    total: 0,
   854→    rendered: 0,
   855→    drifted: 0,
   856→  };
   857→
   858→  // Helper to scan a directory for skill subdirs with kspec-managed SKILL.md
   859→  async function scanForSkills(baseDir: string): Promise<void> {
   860→    try {
   861→      const dirs = await fs.readdir(baseDir, { withFileTypes: true });
   862→      for (const dir of dirs) {
   863→        if (dir.isDirectory()) {
   864→          const skillMdPath = path.join(baseDir, dir.name, "SKILL.md");
   865→          try {
   866→            const content = await fs.readFile(skillMdPath, "utf-8");
   867→            if (content.includes("<!-- kspec-managed -->")) {
   868→              skills.total++;
   869→              skills.rendered++;
   870→            }
   871→          } catch (_noSkillMd) {
   872→            // No SKILL.md
   873→          }
   874→        }
   875→      }
   876→    } catch (_notReadable) {
   877→      // Directory doesn't exist
   878→    }
   879→  }
   880→
   881→  // Scan .claude/skills/ (project/local skills)
   882→  await scanForSkills(skillsDir);
   883→
   884→  // Check plugin marketplace health
   885→  // AC: @enhanced-setup ac-7, ac-8
   886→  const plugin: SetupStatus["plugin"] = {
   887→    marketplaceRegistered: false,
   888→    marketplaceHealthy: false,
   889→    pluginEnabled: false,
   890→  };
   891→
   892→  try {
   893→    const { checkMarketplaceHealth } = await import(
   894→      "../../lib/claude-plugin-registry.js"
   895→    );
   896→    const health = await checkMarketplaceHealth();
   897→    plugin.marketplaceRegistered = health.status !== "missing";
   898→    plugin.marketplaceHealthy = health.status === "healthy";
   899→    plugin.registeredPath = health.registeredPath;
   900→    plugin.healthMessage = health.message;
   901→  } catch (err) {
   902→    debugLog("Could not check marketplace health", err);
   903→    plugin.healthMessage = "Health check unavailable";
   904→  }
   905→
   906→  // Check if plugin is enabled in project settings
   907→  try {
   908→    const configContent = await fs.readFile(configPath, "utf-8");
   909→    const config = JSON.parse(configContent);
   910→    plugin.pluginEnabled = config.enabledPlugins?.["kspec@kspec-plugins"] === true;
   911→  } catch (err) {
   912→    debugLog("Could not check plugin enablement", err);
   913→  }
   914→
   915→  // Check agents.md
   916→  const agentsMd: SetupStatus["agentsMd"] = {
   917→    exists: false,
   918→    status: "missing",
   919→  };
   920→
   921→  try {
   922→    await fs.access(agentsMdPath);
   923→    agentsMd.exists = true;
   924→
   925→    try {
   926→      const hashContent = await fs.readFile(hashPath, "utf-8");
   927→      const hashData = JSON.parse(hashContent);
   928→      agentsMd.generatedAt = hashData.generatedAt;
   929→
   930→      // AC: @cross-platform-and-version-robustness ac-4
   931→      // Compare stored hash against current meta to detect staleness
   932→      try {
   933→        const { initContext, loadMetaContext } = await import(
   934→          "../../parser/index.js"
   935→        );
   936→        const { computeMetaHash, loadTemplateSections, getPackageRoot } = await import("./agents.js");
   937→        const ctx = await initContext();
   938→        if (ctx.manifestPath) {
   939→          const metaCtx = await loadMetaContext(ctx);
   940→          let templateSections: string[] = [];
   941→          try {
   942→            templateSections = await loadTemplateSections(getPackageRoot());
   943→          } catch (err) {
   944→            debugLog("Templates not available for staleness check", err);
   945→          }
   946→          const currentHash = computeMetaHash(
   947→            metaCtx.skills,
   948→            metaCtx.conventions,
   949→            metaCtx.workflows,
   950→            templateSections,
   951→          );
   952→          agentsMd.status = hashData.metaHash === currentHash ? "current" : "stale";
   953→        } else {
   954→          // AC: @doctor-command ac-staleness-unknown — no manifest means we can't determine staleness
   955→          agentsMd.status = "unknown";
   956→        }
   957→      } catch (err) {
   958→        // AC: @doctor-command ac-staleness-unknown — hash computation failed
   959→        debugLog("Could not compute meta hash for staleness check", err);
   960→        agentsMd.status = "unknown";
   961→      }
   962→    } catch (err) {
   963→      debugLog("Hash file missing or invalid, marking stale", err);
   964→      agentsMd.status = "stale";
   965→    }
   966→  } catch (err) {
   967→    debugLog("kspec-agents.md doesn't exist", err);
   968→  }
   969→
   970→  // Check seeding state
   971→  const seeding: SetupStatus["seeding"] = {
   972→    permissionsSeeded: false,
   973→    memorySeeded: false,
   974→  };
   975→
   976→  try {
   977→    const configContent = await fs.readFile(
   978→      path.join(projectDir, ".claude", "settings.json"),
   979→      "utf-8",
   980→    );
   981→    const config = JSON.parse(configContent);
   982→    seeding.permissionsSeeded = !!config.permissions;
   983→  } catch (err) {
   984→    debugLog("Could not check permissions seeding state", err);
   985→  }
   986→
   987→  if (detected.type === "claude-code") {
   988→    try {
   989→      const { claudeCodeMemoryWriter } = await import("./setup-seeding.js");
   990→      const memoryExists = await claudeCodeMemoryWriter.exists(projectDir);
   991→      seeding.memorySeeded = memoryExists;
   992→      if (memoryExists) {
   993→        seeding.memoryPath = claudeCodeMemoryWriter.getMemoryPath(projectDir);
   994→      }
   995→    } catch (err) {
   996→      debugLog("Could not check memory seeding state", err);
   997→    }
   998→  }
   999→
  1000→  return {
  1001→    agent: {
  1002→      detected: detected.type,
  1003→      confidence: detected.confidence,
  1004→    },
  1005→    hooks,
  1006→    skills,
  1007→    plugin,
  1008→    agentsMd,
  1009→    seeding,
  1010→  };
  1011→}
  1012→
  1013→/**
  1014→ * Render skills using the platform renderer registry
  1015→ * AC: @setup-pipeline-unification ac-2 - uses getRenderer/getAllRenderers, not legacy renderClaudeCodeSkill
  1016→ * AC: @setup-pipeline-unification ac-4 - errors logged at debug level
  1017→ */
  1018→async function renderSkillsForSetup(
  1019→  projectDir: string,
  1020→  dryRun: boolean,
  1021→): Promise<{ rendered: number; skipped: number; pluginProvided: number; skillIds: string[] }> {
  1022→  // Dynamically import to avoid circular dependencies
  1023→  const { initContext, loadMetaContext } = await import(
  1024→    "../../parser/index.js"
  1025→  );
  1026→  const { getRenderer } = await import("../../parser/skill-render.js");
  1027→
  1028→  try {
  1029→    const ctx = await initContext();
  1030→
  1031→    if (!ctx.manifestPath) {
  1032→      return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1033→    }
  1034→
  1035→    const metaCtx = await loadMetaContext(ctx);
  1036→
  1037→    // Collect all skills that have a registered renderer for their platform
  1038→    const skillsToRender: Array<{ skill: typeof metaCtx.skills[0]; platform: string }> = [];
  1039→    for (const skill of metaCtx.skills) {
  1040→      for (const platform of skill.platforms) {
  1041→        const renderer = getRenderer(platform);
  1042→        if (renderer) {
  1043→          skillsToRender.push({ skill, platform });
  1044→        }
  1045→      }
  1046→    }
  1047→
  1048→    if (skillsToRender.length === 0) {
  1049→      return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1050→    }
  1051→
  1052→    let rendered = 0;
  1053→    let skipped = 0;
  1054→    let pluginProvided = 0;
  1055→    const skillIds: string[] = [];
  1056→
  1057→    for (const { skill, platform } of skillsToRender) {
  1058→      const renderer = getRenderer(platform)!;
  1059→      try {
  1060→        const result = await renderer.render(ctx, projectDir, skill, {
  1061→          dryRun,
  1062→        });
  1063→        if (result.action === "created" || result.action === "updated") {
  1064→          rendered++;
  1065→          if (!skillIds.includes(skill.id)) {
  1066→            skillIds.push(skill.id);
  1067→          }
  1068→        } else if (result.action === "skipped" && result.skipCode === "plugin-provided") {
  1069→          pluginProvided++;
  1070→        } else {
  1071→          skipped++;
  1072→        }
  1073→      } catch (err) {
  1074→        debugLog(`Failed to render skill ${skill.id} for ${platform}`, err);
  1075→        skipped++;
  1076→      }
  1077→    }
  1078→
  1079→    return { rendered, skipped, pluginProvided, skillIds };
  1080→  } catch (err) {
  1081→    debugLog("renderSkillsForSetup failed", err);
  1082→    return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1083→  }
  1084→}
  1085→
  1086→/**
  1087→ * Generate kspec-agents.md using the canonical implementation from agents.ts
  1088→ * AC: @setup-pipeline-unification ac-1 - calls generateAgentsContent() from agents.ts
  1089→ * AC: @setup-pipeline-unification ac-4 - errors logged at debug level
  1090→ */
  1091→async function generateAgentInstructions(
  1092→  projectDir: string,
  1093→  dryRun: boolean,
  1094→): Promise<{ success: boolean; path: string; skipped?: boolean }> {
  1095→  const outputPath = path.join(projectDir, "kspec-agents.md");
  1096→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
  1097→
  1098→  // Dynamically import to avoid circular dependencies
  1099→  const { initContext, loadMetaContext } = await import(
  1100→    "../../parser/index.js"
  1101→  );
  1102→  const {
  1103→    generateAgentsContent,
  1104→    loadTemplateSections,
  1105→    getPackageRoot,
  1106→    computeMetaHash,
  1107→  } = await import("./agents.js");
  1108→
  1109→  try {
  1110→    const ctx = await initContext();
  1111→
  1112→    if (!ctx.manifestPath) {
  1113→      return { success: false, path: outputPath };
  1114→    }
  1115→
  1116→    const metaCtx = await loadMetaContext(ctx);
  1117→    const timestamp = new Date().toISOString();
  1118→
  1119→    // Load templates using the canonical implementation
  1120→    let templateSections: string[] = [];
  1121→    try {
  1122→      templateSections = await loadTemplateSections(getPackageRoot());
  1123→    } catch (err) {
  1124→      debugLog("Failed to load template sections", err);
  1125→    }
  1126→
  1127→    // Generate content using the canonical implementation from agents.ts
  1128→    const content = await generateAgentsContent(
  1129→      metaCtx.skills,
  1130→      metaCtx.conventions,
  1131→      metaCtx.workflows,
  1132→      timestamp,
  1133→      templateSections,
  1134→    );
  1135→
  1136→    if (!dryRun) {
  1137→      // Compute meta hash for freshness tracking
  1138→      const metaHash = computeMetaHash(
  1139→        metaCtx.skills,
  1140→        metaCtx.conventions,
  1141→        metaCtx.workflows,
  1142→        templateSections,
  1143→      );
  1144→
  1145→      // Skip regeneration when content unchanged (same pattern as kspec agents generate)
  1146→      let storedHash: string | undefined;
  1147→      try {
  1148→        const hashContent = await fs.readFile(hashPath, "utf-8");
  1149→        const hashData = JSON.parse(hashContent);
  1150→        storedHash = hashData.metaHash;
  1151→      } catch (_err) {
  1152→        // No hash file or invalid — regenerate
  1153→      }
  1154→
  1155→      // Only skip if hash matches AND the output file actually exists
  1156→      let outputExists = false;
  1157→      try {
  1158→        await fs.access(outputPath);
  1159→        outputExists = true;
  1160→      } catch (_e) {
  1161→        // File missing — must regenerate even if hash matches
  1162→      }
  1163→
  1164→      if (storedHash === metaHash && outputExists) {
  1165→        return { success: true, path: outputPath, skipped: true };
  1166→      }
  1167→
  1168→      await fs.writeFile(outputPath, content, "utf-8");
  1169→
  1170→      await fs.mkdir(path.dirname(hashPath), { recursive: true });
  1171→      // Dynamically import version to avoid top-level require
  1172→      const { createRequire } = await import("node:module");
  1173→      const req = createRequire(import.meta.url);
  1174→      const { version } = req("../../../package.json");
  1175→
  1176→      await fs.writeFile(
  1177→        hashPath,
  1178→        JSON.stringify(
  1179→          {
  1180→            metaHash,
  1181→            generatedAt: timestamp,
  1182→            version,
  1183→          },
  1184→          null,
  1185→          2,
  1186→        ),
  1187→        "utf-8",
  1188→      );
  1189→    }
  1190→
  1191→    return { success: true, path: outputPath };
  1192→  } catch (err) {
  1193→    debugLog("generateAgentInstructions failed", err);
  1194→    return { success: false, path: outputPath };
  1195→  }
  1196→}
  1197→
  1198→/**
  1199→ * Install core skills for the setup pipeline
  1200→ * AC: @init-setup-integration ac-2 - core skills installed
  1201→ */
  1202→async function installCoreSkillsForSetup(
  1203→  projectDir: string,
  1204→  dryRun: boolean
  1205→): Promise<{
  1206→  installed: number;
  1207→  skipped: number;
  1208→  marketplaceRegistered?: boolean;
  1209→  pluginEnabled?: boolean;
  1210→  marketplaceMessage?: string;
  1211→  enableMessage?: string;
  1212→}> {
  1213→  // Dynamically import to avoid circular dependencies
  1214→  const {
  1215→    initContext,
  1216→    loadMetaContext,
  1217→    saveMetaItem,
  1218→    getSkillContentPath,
  1219→  } = await import("../../parser/index.js");
  1220→  const { commitIfShadow } = await import("../../parser/shadow.js");
  1221→  const { SkillSchema } = await import("../../schema/index.js");
  1222→  const {
  1223→    loadCoreSkillsManifest,
  1224→    copyCoreSkillFiles,
  1225→    getKspecPackageVersion,
  1226→  } = await import("./skill.js");
  1227→  const { ulid } = await import("ulid");
  1228→
  1229→  let installed = 0;
  1230→  let skipped = 0;
  1231→
  1232→  try {
  1233→    const ctx = await initContext();
  1234→
  1235→    if (!ctx.manifestPath) {
  1236→      return { installed: 0, skipped: 0 };
  1237→    }
  1238→
  1239→    const metaCtx = await loadMetaContext(ctx);
  1240→    const coreSkills = await loadCoreSkillsManifest();
  1241→    // AC: @cross-platform-and-version-robustness ac-3
  1242→    const kspecVersion = await getKspecPackageVersion();
  1243→    if (!kspecVersion) {
  1244→      debugLog("Could not determine kspec version — skills installed without version tracking");
  1245→    }
  1246→
  1247→    for (const coreSkill of coreSkills) {
  1248→      // Check if skill exists
  1249→      const existingSkill = metaCtx.skills.find((s) => s.id === coreSkill.id);
  1250→
  1251→      if (existingSkill && existingSkill.origin !== "core") {
  1252→        // Custom/project skill exists, skip
  1253→        skipped++;
  1254→        continue;
  1255→      }
  1256→
  1257→      // Build skill data
  1258→      const skillData = {
  1259→        _ulid: existingSkill?._ulid || ulid(),
  1260→        id: coreSkill.id,
  1261→        name: coreSkill.name,
  1262→        description: coreSkill.description,
  1263→        origin: "core" as const,
  1264→        ...(kspecVersion && { version: kspecVersion }),
  1265→        platforms: coreSkill.platforms || ["claude-code"],
  1266→        depends_on: [],
  1267→        tags: ["core"],
  1268→      };
  1269→
  1270→      const parsed = SkillSchema.safeParse(skillData);
  1271→      if (!parsed.success) {
  1272→        skipped++;
  1273→        continue;
  1274→      }
  1275→
  1276→      if (!dryRun) {
  1277→        await saveMetaItem(ctx, parsed.data, "skill");
  1278→
  1279→        // Copy skill files (SKILL.md + supporting dirs)
  1280→        const targetDir = path.dirname(getSkillContentPath(ctx, parsed.data.id));
  1281→        await copyCoreSkillFiles(coreSkill.id, targetDir);
  1282→      }
  1283→
  1284→      installed++;
  1285→    }
  1286→
  1287→    // Commit changes
  1288→    if (!dryRun && installed > 0) {
  1289→      const ctx2 = await initContext();
  1290→      await commitIfShadow(
  1291→        ctx2.shadow,
  1292→        "skill-install-core",
  1293→        `${installed} core skills`
  1294→      );
  1295→    }
  1296→
  1297→    // AC: @core-skill-install ac-6, ac-7 - Register marketplace and enable plugin
  1298→    let marketplaceResult;
  1299→    let enableResult;
  1300→    if (!dryRun) {
  1301→      const {
  1302→        registerCorePluginMarketplace,
  1303→        enablePluginInProject,
  1304→      } = await import("../../lib/claude-plugin-registry.js");
  1305→      marketplaceResult = await registerCorePluginMarketplace();
  1306→      enableResult = await enablePluginInProject(projectDir);
  1307→    }
  1308→
  1309→    return {
  1310→      installed,
  1311→      skipped,
  1312→      marketplaceRegistered: marketplaceResult?.success ?? false,
  1313→      pluginEnabled: enableResult?.success ?? false,
  1314→      marketplaceMessage: marketplaceResult?.message,
  1315→      enableMessage: enableResult?.message,
  1316→    };
  1317→  } catch (err) {
  1318→    debugLog("installCoreSkillsForSetup failed", err);
  1319→    return { installed: 0, skipped: 0 };
  1320→  }
  1321→}
  1322→
  1323→/**
  1324→ * Run the full setup pipeline programmatically.
  1325→ * Used by both 'kspec setup' command and 'kspec init --setup'.
  1326→ * AC: @init-setup-integration ac-2, ac-3
  1327→ */
  1328→export async function runSetupPipeline(
  1329→  projectDir: string,
  1330→  options: SetupPipelineOptions
  1331→): Promise<SetupPipelineResult> {
  1332→  const dryRun = options.dryRun ?? false;
  1333→  const skipSkills = options.skipSkills ?? false;
  1334→  const installHooksFlag = options.installHooks ?? true;
  1335→
  1336→  const steps: SetupStepResult[] = [];
  1337→  let coreSkillsInstalled = 0;
  1338→  let skillsRendered = 0;
  1339→  let hooksInstalled = false;
  1340→  let agentsMdGenerated = false;
  1341→  let permissionsSeeded = false;
  1342→  let memorySeeded = false;
  1343→
  1344→  try {
  1345→    const detected = detectAgent();
  1346→
  1347→    // Step 1: Agent detection
  1348→    steps.push({
  1349→      name: "Agent detection",
  1350→      status: "done",
  1351→      message: `${detected.type} (${detected.confidence} confidence)`,
  1352→    });
  1353→
  1354→    // Step 2: Install core skills
  1355→    // AC: @init-setup-integration ac-2 - core skills installed in .kspec/skills/
  1356→    const coreResult = await installCoreSkillsForSetup(projectDir, dryRun);
  1357→    coreSkillsInstalled = coreResult.installed;
  1358→
  1359→    if (coreResult.installed > 0 || coreResult.skipped > 0) {
  1360→      steps.push({
  1361→        name: "Install core skills",
  1362→        status: "done",
  1363→        message: `${coreResult.installed} installed, ${coreResult.skipped} skipped`,
  1364→      });
  1365→    } else {
  1366→      steps.push({
  1367→        name: "Install core skills",
  1368→        status: "skipped",
  1369→        message: "No core skills found in package",
  1370→      });
  1371→    }
  1372→
  1373→    // Step 2b: Register plugin marketplace (reports result from installCoreSkillsForSetup)
  1374→    // AC: @core-skill-install ac-6, ac-7
  1375→    if (!dryRun && (coreResult.installed > 0 || coreResult.skipped > 0)) {
  1376→      const bothOk = coreResult.marketplaceRegistered && coreResult.pluginEnabled;
  1377→      if (bothOk) {
  1378→        steps.push({
  1379→          name: "Register plugin marketplace",
  1380→          status: "done",
  1381→          message: "marketplace registered, plugin enabled",
  1382→        });
  1383→      } else {
  1384→        const failures: string[] = [];
  1385→        if (!coreResult.marketplaceRegistered) {
  1386→          failures.push(coreResult.marketplaceMessage || "marketplace registration failed");
  1387→        }
  1388→        if (!coreResult.pluginEnabled) {
  1389→          failures.push(coreResult.enableMessage || "plugin enablement failed");
  1390→        }
  1391→        steps.push({
  1392→          name: "Register plugin marketplace",
  1393→          status: "failed",
  1394→          message: failures.join("; "),
  1395→        });
  1396→      }
  1397→    }
  1398→
  1399→    // Step 3: Install hooks (Claude Code only)
  1400→    // AC: @init-setup-integration ac-3 - hooks present
  1401→    if (detected.type === "claude-code" && installHooksFlag) {
  1402→      const hooksResult = await installClaudeCodeHooks(projectDir, dryRun);
  1403→      const installedHooks: string[] = [];
  1404→      if (hooksResult.promptCheck) installedHooks.push("UserPromptSubmit");
  1405→      if (hooksResult.stop) installedHooks.push("Stop");
  1406→      if (hooksResult.preToolUse) installedHooks.push("PreToolUse");
  1407→
  1408→      hooksInstalled =
  1409→        hooksResult.promptCheck || hooksResult.stop || hooksResult.preToolUse;
  1410→
  1411→      steps.push({
  1412→        name: "Install hooks",
  1413→        status: "done",
  1414→        message: installedHooks.join(", "),
  1415→        details: {
  1416→          guards: hooksResult.guardsCreated,
  1417→        },
  1418→      });
  1419→    } else if (!installHooksFlag) {
  1420→      steps.push({
  1421→        name: "Install hooks",
  1422→        status: "skipped",
  1423→        message: "--no-hooks flag",
  1424→      });
  1425→    } else {
  1426→      steps.push({
  1427→        name: "Install hooks",
  1428→        status: "skipped",
  1429→        message: `not applicable for ${detected.type}`,
  1430→      });
  1431→    }
  1432→
  1433→    // Step 3a: Ensure artifacts directory exists
  1434→    // AC: @artifacts-directory ac-setup-ensures
  1435→    {
  1436→      const artifactsDir = path.join(projectDir, ".kspec", "artifacts");
  1437→      let artifactsCreated = false;
  1438→      try {
  1439→        await fs.access(artifactsDir);
  1440→      } catch (_e) {
  1441→        if (!dryRun) {
  1442→          await fs.mkdir(artifactsDir, { recursive: true });
  1443→        }
  1444→        artifactsCreated = true;
  1445→      }
  1446→      steps.push({
  1447→        name: "Ensure artifacts directory",
  1448→        status: artifactsCreated ? "done" : "skipped",
  1449→        message: artifactsCreated ? "created .kspec/artifacts/" : "already exists",
  1450→      });
  1451→    }
  1452→
  1453→    // Step 3b: Seed permissions (Claude Code only)
  1454→    // AC: @new-project-bootstrapping ac-1
  1455→    {
  1456→      const { seedPermissions } = await import("./setup-seeding.js");
  1457→      const permResult = await seedPermissions(projectDir, detected.type, {
  1458→        dryRun,
  1459→        force: options.force,
  1460→      });
  1461→      permissionsSeeded = permResult.seeded;
  1462→
  1463→      steps.push({
  1464→        name: "Seed permissions",
  1465→        status: permResult.seeded ? "done" : "skipped",
  1466→        message: permResult.message,
  1467→      });
  1468→    }
  1469→
  1470→    // Step 3c: Seed memory (platform-extensible)
  1471→    // AC: @new-project-bootstrapping ac-2
  1472→    {
  1473→      const { seedMemory } = await import("./setup-seeding.js");
  1474→      const memResult = await seedMemory(projectDir, detected.type, {
  1475→        dryRun,
  1476→        force: options.force,
  1477→      });
  1478→      memorySeeded = memResult.seeded;
  1479→
  1480→      steps.push({
  1481→        name: "Seed memory",
  1482→        status: memResult.seeded ? "done" : "skipped",
  1483→        message: memResult.seeded ? memResult.path : memResult.message,
  1484→      });
  1485→    }
  1486→
  1487→    // Step 4: Render skills
  1488→    // AC: @init-setup-integration ac-3 - rendered skill files present
  1489→    if (!skipSkills) {
  1490→      const skillsResult = await renderSkillsForSetup(projectDir, dryRun);
  1491→      skillsRendered = skillsResult.rendered;
  1492→
  1493→      if (skillsResult.rendered > 0 || skillsResult.skipped > 0 || skillsResult.pluginProvided > 0) {
  1494→        const parts = [];
  1495→        if (skillsResult.rendered > 0) parts.push(`${skillsResult.rendered} rendered`);
  1496→        if (skillsResult.pluginProvided > 0) parts.push(`${skillsResult.pluginProvided} plugin-provided`);
  1497→        if (skillsResult.skipped > 0) parts.push(`${skillsResult.skipped} unchanged`);
  1498→        steps.push({
  1499→          name: "Render skills",
  1500→          status: "done",
  1501→          message: parts.join(", "),
  1502→          details: {
  1503→            skillIds: skillsResult.skillIds,
  1504→          },
  1505→        });
  1506→      } else {
  1507→        steps.push({
  1508→          name: "Render skills",
  1509→          status: "skipped",
  1510→          message: "No claude-code skills in meta",
  1511→        });
  1512→      }
  1513→    } else {
  1514→      steps.push({
  1515→        name: "Render skills",
  1516→        status: "skipped",
  1517→        message: "--skip-skills flag",
  1518→      });
  1519→    }
  1520→
  1521→    // Step 5: Generate kspec-agents.md
  1522→    // AC: @init-setup-integration ac-3 - kspec-agents.md present
  1523→    const agentsResult = await generateAgentInstructions(projectDir, dryRun);
  1524→    agentsMdGenerated = agentsResult.success;
  1525→
  1526→    if (agentsResult.success) {
  1527→      steps.push({
  1528→        name: "Generate kspec-agents.md",
  1529→        status: "done",
  1530→        message: agentsResult.skipped
  1531→          ? "already up to date"
  1532→          : agentsResult.path,
  1533→      });
  1534→    } else {
  1535→      steps.push({
  1536→        name: "Generate kspec-agents.md",
  1537→        status: "failed",
  1538→        message: "No kspec project found",
  1539→      });
  1540→    }
  1541→
  1542→    // Step 6: Configure author (optional, used by setup command)
  1543→    if (options.configureAuthor) {
  1544→      const author = options.author || getDefaultAuthor(detected.type);
  1545→      if (!options.force && process.env.KSPEC_AUTHOR) {
  1546→        steps.push({
  1547→          name: "Configure author",
  1548→          status: "skipped",
  1549→          message: `KSPEC_AUTHOR already set to "${process.env.KSPEC_AUTHOR}"`,
  1550→        });
  1551→      } else {
  1552→        let authorInstalled = false;
  1553→        switch (detected.type) {
  1554→          case "claude-code":
  1555→            if (!dryRun) {
  1556→              authorInstalled = await installClaudeCodeConfig(author);
  1557→            } else {
  1558→              authorInstalled = true;
  1559→            }
  1560→            break;
  1561→          case "aider":
  1562→            if (!dryRun) {
  1563→              authorInstalled = await installAiderConfig(author);
  1564→            } else {
  1565→              authorInstalled = true;
  1566→            }
  1567→            break;
  1568→          default:
  1569→            break;
  1570→        }
  1571→
  1572→        if (authorInstalled) {
  1573→          steps.push({
  1574→            name: "Configure author",
  1575→            status: "done",
  1576→            message: `KSPEC_AUTHOR="${author}"`,
  1577→          });
  1578→        }
  1579→      }
  1580→    }
  1581→
  1582→    // Output summary
  1583→    if (!dryRun) {
  1584→      console.log(chalk.bold("kspec Setup Summary\n"));
  1585→
  1586→      for (const step of steps) {
  1587→        const icon =
  1588→          step.status === "done"
  1589→            ? chalk.green("✓")
  1590→            : step.status === "skipped"
  1591→              ? chalk.gray("○")
  1592→              : chalk.red("✗");
  1593→        const statusText =
  1594→          step.status === "done"
  1595→            ? ""
  1596→            : step.status === "skipped"
  1597→              ? chalk.gray(" (skipped)")
  1598→              : chalk.red(" (failed)");
  1599→
  1600→        console.log(`${icon} ${step.name}${statusText}`);
  1601→        if (step.message) {
  1602→          console.log(chalk.gray(`  ${step.message}`));
  1603→        }
  1604→      }
  1605→    }
  1606→
  1607→    const success = steps.every((s) => s.status !== "failed");
  1608→
  1609→    return {
  1610→      success,
  1611→      steps,
  1612→      coreSkillsInstalled,
  1613→      skillsRendered,
  1614→      hooksInstalled,
  1615→      agentsMdGenerated,
  1616→      permissionsSeeded,
  1617→      memorySeeded,
  1618→    };
  1619→  } catch (err) {
  1620→    debugLog("runSetupPipeline failed", err);
  1621→    return {
  1622→      success: false,
  1623→      steps,
  1624→      coreSkillsInstalled,
  1625→      skillsRendered,
  1626→      hooksInstalled,
  1627→      agentsMdGenerated,
  1628→      permissionsSeeded,
  1629→      memorySeeded,
  1630→    };
  1631→  }
  1632→}
  1633→
  1634→/**
  1635→ * Register the 'setup' command
  1636→ * AC: @enhanced-setup ac-1 through ac-9
  1637→ */
  1638→export function registerSetupCommand(program: Command): void {
  1639→  program
  1640→    .command("setup")
  1641→    .description("Configure agent environment for kspec (orchestrated pipeline)")
  1642→    .option("--dry-run", "Show what would be done without making changes")
  1643→    .option(
  1644→      "--author <author>",
  1645→      "Custom author string (default: auto-detected based on agent)",
  1646→    )
  1647→    .option("--no-hooks", "Skip installing hooks")
  1648→    .option("--skip-skills", "Skip rendering skills")
  1649→    .option("--status", "Report current setup state without making changes")
  1650→    .option("--force", "Overwrite existing configuration")
  1651→    .option(
  1652→      "--auto-worktree",
  1653→      "Automatically create .kspec worktree if kspec-meta branch exists",
  1654→    )
  1655→    .action(async (options) => {
  1656→      try {
  1657→        const projectDir = process.cwd();
  1658→
  1659→        // AC: @enhanced-setup ac-7, ac-8 - --status mode
  1660→        if (options.status) {
  1661→          const status = await getSetupStatus(projectDir);
  1662→
  1663→          output(status, () => {
  1664→            console.log(chalk.bold("kspec Setup Status\n"));
  1665→
  1666→            // Agent detection
  1667→            console.log(chalk.gray("Agent:"));
  1668→            console.log(
  1669→              `  Detected: ${status.agent.detected} (${status.agent.confidence} confidence)`,
  1670→            );
  1671→            console.log();
  1672→
  1673→            // Hooks status
  1674→            console.log(chalk.gray("Hooks:"));
  1675→            console.log(
  1676→              `  UserPromptSubmit: ${status.hooks.promptCheck ? chalk.green("✓") : chalk.red("✗")}`,
  1677→            );
  1678→            console.log(
  1679→              `  Stop:             ${status.hooks.stop ? chalk.green("✓") : chalk.red("✗")}`,
  1680→            );
  1681→            console.log(
  1682→              `  PreToolUse:       ${status.hooks.preToolUse ? chalk.green("✓") : chalk.red("✗")}`,
  1683→            );
  1684→            if (status.hooks.guardsPresent.length > 0) {
  1685→              console.log(
  1686→                `  Guards:           ${status.hooks.guardsPresent.join(", ")}`,
  1687→              );
  1688→            }
  1689→            console.log();
  1690→
  1691→            // Skills status
  1692→            console.log(chalk.gray("Skills:"));
  1693→            console.log(`  Rendered: ${status.skills.rendered}`);
  1694→            if (status.skills.drifted > 0) {
  1695→              console.log(
  1696→                `  Drifted:  ${chalk.yellow(status.skills.drifted.toString())}`,
  1697→              );
  1698→            }
  1699→            console.log();
  1700→
  1701→            // Plugin marketplace status
  1702→            // AC: @enhanced-setup ac-7, ac-8
  1703→            console.log(chalk.gray("Plugin:"));
  1704→            console.log(
  1705→              `  Marketplace: ${status.plugin.marketplaceRegistered ? (status.plugin.marketplaceHealthy ? chalk.green("healthy") : chalk.yellow("registered")) : chalk.red("not registered")}`,
  1706→            );
  1707→            console.log(
  1708→              `  Enabled:     ${status.plugin.pluginEnabled ? chalk.green("✓") : chalk.red("✗")}`,
  1709→            );
  1710→            if (status.plugin.registeredPath) {
  1711→              console.log(chalk.gray(`  Path: ${status.plugin.registeredPath}`));
  1712→            }
  1713→            if (status.plugin.healthMessage && !status.plugin.marketplaceHealthy) {
  1714→              console.log(chalk.yellow(`  ${status.plugin.healthMessage}`));
  1715→            }
  1716→            console.log();
  1717→
  1718→            // Agents.md status
  1719→            console.log(chalk.gray("kspec-agents.md:"));
  1720→            if (status.agentsMd.exists) {
  1721→              // AC: @doctor-command ac-staleness-unknown — show appropriate color for unknown status
  1722→              const statusColor =
  1723→                status.agentsMd.status === "current"
  1724→                  ? chalk.green
  1725→                  : status.agentsMd.status === "unknown"
  1726→                    ? chalk.yellow
  1727→                    : chalk.yellow;
  1728→              console.log(`  Status: ${statusColor(status.agentsMd.status)}`);
  1729→              if (status.agentsMd.status === "unknown") {
  1730→                console.log(chalk.gray("  Could not determine staleness (no manifest or hash unavailable)"));
  1731→              }
  1732→              if (status.agentsMd.generatedAt) {
  1733→                console.log(`  Generated: ${status.agentsMd.generatedAt}`);
  1734→              }
  1735→            } else {
  1736→              console.log(`  Status: ${chalk.red("missing")}`);
  1737→              console.log(
  1738→                chalk.gray("  Run 'kspec setup' to generate"),
  1739→              );
  1740→            }
  1741→            console.log();
  1742→
  1743→            // Seeding status
  1744→            console.log(chalk.gray("Seeding:"));
  1745→            console.log(
  1746→              `  Permissions: ${status.seeding.permissionsSeeded ? chalk.green("✓") : chalk.gray("○")}`,
  1747→            );
  1748→            console.log(
  1749→              `  Memory:      ${status.seeding.memorySeeded ? chalk.green("✓") : chalk.gray("○")}`,
  1750→            );
  1751→            if (status.seeding.memoryPath) {
  1752→              console.log(
  1753→                chalk.gray(`  Path: ${status.seeding.memoryPath}`),
  1754→              );
  1755→            }
  1756→          });
  1757→          return;
  1758→        }
  1759→
  1760→        // AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
  1761→        const worktreeReady = await ensureWorktree(
  1762→          options.autoWorktree || false,
  1763→        );
  1764→        if (!worktreeReady) {
  1765→          // User declined worktree creation or it failed
  1766→          process.exit(EXIT_CODES.ERROR);
  1767→        }
  1768→
  1769→        const detected = detectAgent();
  1770→        const dryRun = options.dryRun || false;
  1771→
  1772→        if (detected.type === "unknown") {
  1773→          warn("Could not auto-detect agent environment");
  1774→          printManualInstructions("unknown");
  1775→          return;
  1776→        }
  1777→
  1778→        // AC: @setup-pipeline-unification ac-3 - delegate to runSetupPipeline()
  1779→        // One code path for both 'kspec setup' and 'kspec init --setup'
  1780→        const result = await runSetupPipeline(projectDir, {
  1781→          dryRun,
  1782→          skipSkills: options.skipSkills || false,
  1783→          installHooks: options.hooks !== false,
  1784→          force: options.force || false,
  1785→          author: options.author,
  1786→          configureAuthor: true,
  1787→        });
  1788→
  1789→        // AC: @enhanced-setup ac-1 - Display summary
  1790→        // AC: @enhanced-setup ac-6 - dry-run displays planned actions
  1791→        output(
  1792→          {
  1793→            dry_run: dryRun,
  1794→            steps: result.steps.map((s) => ({
  1795→              name: s.name,
  1796→              status: s.status,
  1797→              message: s.message,
  1798→              details: s.details,
  1799→            })),
  1800→          },
  1801→          () => {
  1802→            if (dryRun) {
  1803→              console.log(chalk.yellow("DRY RUN - No changes made\n"));
  1804→            }
  1805→
  1806→            // Pipeline already prints the summary when not dry-run
  1807→            // For dry-run, print it here since the pipeline skips output
  1808→            if (dryRun) {
  1809→              console.log(chalk.bold("kspec Setup Summary\n"));
  1810→
  1811→              for (const step of result.steps) {
  1812→                const icon =
  1813→                  step.status === "done"
  1814→                    ? chalk.green("✓")
  1815→                    : step.status === "skipped"
  1816→                      ? chalk.gray("○")
  1817→                      : chalk.red("✗");
  1818→                const statusText =
  1819→                  step.status === "done"
  1820→                    ? ""
  1821→                    : step.status === "skipped"
  1822→                      ? chalk.gray(" (skipped)")
  1823→                      : chalk.red(" (failed)");
  1824→
  1825→                console.log(`${icon} ${step.name}${statusText}`);
  1826→                if (step.message) {
  1827→                  console.log(chalk.gray(`  ${step.message}`));
  1828→                }
  1829→              }
  1830→            }
  1831→
  1832→            console.log();
  1833→
  1834→            if (dryRun) {
  1835→              console.log(
  1836→                chalk.yellow("Run without --dry-run to apply changes."),
  1837→              );
  1838→            } else {
  1839→              console.log(
  1840→                chalk.green("Setup complete."),
  1841→              );
  1842→              console.log(
  1843→                chalk.gray("Restart your agent session for changes to take effect."),
  1844→              );
  1845→            }
  1846→          },
  1847→        );
  1848→      } catch (err) {
  1849→        error(errors.failures.setupFailed, err);
  1850→        process.exit(EXIT_CODES.ERROR);
  1851→      }
  1852→    });
  1853→}
  1854→
