```
     1→/**
     2→ * Enhanced setup command for kspec agent integration.
     3→ *
     4→ * Orchestrates the full onboarding pipeline:
     5→ * - Detect agent environment (Claude Code, Cline, etc.)
     6→ * - Install hooks (UserPromptSubmit, Stop, PreToolUse guards)
     7→ * - Render skills from .kspec/skills/ to .claude/skills/
     8→ * - Generate kspec-agents.md
     9→ *
    10→ * AC: @enhanced-setup ac-1 - summary displayed listing each step performed
    11→ * AC: @enhanced-setup ac-2 - all hook entries (UserPromptSubmit, Stop, PreToolUse) present
    12→ * AC: @enhanced-setup ac-3 - rendered skill files exist for each skill targeting claude-code
    13→ * AC: @enhanced-setup ac-4 - kspec-agents.md exists after setup
    14→ * AC: @enhanced-setup ac-5 - --skip-skills flag skips skill rendering
    15→ * AC: @enhanced-setup ac-6 - --dry-run displays planned actions without changes
    16→ * AC: @enhanced-setup ac-7 - --status reports current state including agent detected
    17→ * AC: @enhanced-setup ac-8 - --status shows hooks status, skills rendered count, agents.md freshness
    18→ * AC: @enhanced-setup ac-9 - skills referenced by ralph (task-work, reflect) are present
    19→ */
    20→
    21→import * as fs from "node:fs/promises";
    22→import * as os from "node:os";
    23→import * as path from "node:path";
    24→import * as readline from "node:readline/promises";
    25→import chalk from "chalk";
    26→import type { Command } from "commander";
    27→import {
    28→  getGitRoot,
    29→  getShadowStatus,
    30→  repairShadow,
    31→  SHADOW_BRANCH_NAME,
    32→} from "../../parser/shadow.js";
    33→import { errors } from "../../strings/index.js";
    34→import { EXIT_CODES } from "../exit-codes.js";
    35→import { error, output, success, warn } from "../output.js";
    36→
    37→/**
    38→ * Log a message at debug level (only when KSPEC_DEBUG=1)
    39→ * AC: @setup-pipeline-unification ac-4
    40→ */
    41→function debugLog(message: string, detail?: unknown): void {
    42→  if (process.env.KSPEC_DEBUG === "1") {
    43→    if (detail) {
    44→      console.error(`[DEBUG] setup: ${message}`, detail);
    45→    } else {
    46→      console.error(`[DEBUG] setup: ${message}`);
    47→    }
    48→  }
    49→}
    50→
    51→/**
    52→ * Supported agent types for auto-configuration
    53→ */
    54→export type AgentType =
    55→  | "claude-code"
    56→  | "cline"
    57→  | "roo-code"
    58→  | "copilot-cli"
    59→  | "gemini-cli"
    60→  | "codex-cli"
    61→  | "aider"
    62→  | "opencode"
    63→  | "amp"
    64→  | "unknown";
    65→
    66→/**
    67→ * Result of agent detection
    68→ */
    69→export interface DetectedAgent {
    70→  type: AgentType;
    71→  confidence: "high" | "medium" | "low";
    72→  configPath?: string;
    73→  envVars?: Record<string, string>;
    74→}
    75→
    76→/**
    77→ * Detect which agent environment we're running in.
    78→ * Returns the detected agent type and confidence level.
    79→ *
    80→ * Detection priority matters - more specific markers checked first.
    81→ */
    82→export function detectAgent(): DetectedAgent {
    83→  // Claude Code: Multiple possible markers
    84→  // CLAUDECODE=1 is set in CLI sessions
    85→  // CLAUDE_CODE_ENTRYPOINT indicates entry point (cli, etc.)
    86→  // CLAUDE_PROJECT_DIR is set in some contexts
    87→  if (
    88→    process.env.CLAUDECODE === "1" ||
    89→    process.env.CLAUDE_CODE_ENTRYPOINT ||
    90→    process.env.CLAUDE_PROJECT_DIR
    91→  ) {
    92→    return {
    93→      type: "claude-code",
    94→      confidence: "high",
    95→      configPath: path.join(os.homedir(), ".claude", "settings.json"),
    96→      envVars: {
    97→        ...(process.env.CLAUDECODE && { CLAUDECODE: process.env.CLAUDECODE }),
    98→        ...(process.env.CLAUDE_CODE_ENTRYPOINT && {
    99→          CLAUDE_CODE_ENTRYPOINT: process.env.CLAUDE_CODE_ENTRYPOINT,
   100→        }),
   101→        ...(process.env.CLAUDE_PROJECT_DIR && {
   102→          CLAUDE_PROJECT_DIR: process.env.CLAUDE_PROJECT_DIR,
   103→        }),
   104→      },
   105→    };
   106→  }
   107→
   108→  // Cline: CLINE_ACTIVE is set when running in Cline terminal
   109→  if (process.env.CLINE_ACTIVE) {
   110→    return {
   111→      type: "cline",
   112→      confidence: "high",
   113→      // Cline uses VS Code settings, but env vars should be in shell profile
   114→      configPath: undefined,
   115→      envVars: { CLINE_ACTIVE: process.env.CLINE_ACTIVE },
   116→    };
   117→  }
   118→
   119→  // GitHub Copilot CLI: Check for copilot-specific markers
   120→  if (process.env.COPILOT_MODEL || process.env.GH_TOKEN) {
   121→    return {
   122→      type: "copilot-cli",
   123→      confidence: "medium",
   124→      configPath: path.join(os.homedir(), ".copilot", "config.json"),
   125→    };
   126→  }
   127→
   128→  // Aider: Check for AIDER_* env vars
   129→  if (process.env.AIDER_MODEL || process.env.AIDER_DARK_MODE !== undefined) {
   130→    return {
   131→      type: "aider",
   132→      confidence: "high",
   133→      configPath: path.join(os.homedir(), ".aider.conf.yml"),
   134→    };
   135→  }
   136→
   137→  // OpenCode: Check for OPENCODE_* env vars
   138→  if (process.env.OPENCODE_CONFIG_DIR || process.env.OPENCODE_CONFIG) {
   139→    return {
   140→      type: "opencode",
   141→      confidence: "high",
   142→      configPath:
   143→        process.env.OPENCODE_CONFIG ||
   144→        path.join(os.homedir(), ".config", "opencode", "opencode.json"),
   145→    };
   146→  }
   147→
   148→  // Gemini CLI: GEMINI_CLI=1 is set when running in Gemini CLI
   149→  if (process.env.GEMINI_CLI === "1") {
   150→    return {
   151→      type: "gemini-cli",
   152→      confidence: "high",
   153→      configPath: path.join(os.homedir(), ".gemini", "settings.json"),
   154→      envVars: { GEMINI_CLI: "1" },
   155→    };
   156→  }
   157→
   158→  // Codex CLI: CODEX_SANDBOX is set when running in sandbox
   159→  if (process.env.CODEX_SANDBOX) {
   160→    return {
   161→      type: "codex-cli",
   162→      confidence: "high",
   163→      configPath: path.join(os.homedir(), ".codex", "config.toml"),
   164→      envVars: { CODEX_SANDBOX: process.env.CODEX_SANDBOX },
   165→    };
   166→  }
   167→
   168→  // Amp (Sourcegraph): Check for AMP_API_KEY or AMP_TOOLBOX
   169→  if (process.env.AMP_API_KEY || process.env.AMP_TOOLBOX) {
   170→    return {
   171→      type: "amp",
   172→      confidence: "medium",
   173→      configPath: path.join(os.homedir(), ".config", "amp", "settings.json"),
   174→    };
   175→  }
   176→
   177→  return {
   178→    type: "unknown",
   179→    confidence: "low",
   180→  };
   181→}
   182→
   183→/**
   184→ * Install KSPEC_AUTHOR config for Claude Code (global settings)
   185→ */
   186→async function installClaudeCodeConfig(author: string): Promise<boolean> {
   187→  const configPath = path.join(os.homedir(), ".claude", "settings.json");
   188→  const configDir = path.dirname(configPath);
   189→
   190→  try {
   191→    // Ensure directory exists
   192→    await fs.mkdir(configDir, { recursive: true });
   193→
   194→    // Read existing config or start fresh
   195→    let config: Record<string, unknown> = {};
   196→    try {
   197→      const existing = await fs.readFile(configPath, "utf-8");
   198→      config = JSON.parse(existing);
   199→    } catch (err) {
   200→      debugLog("No existing Claude Code config, starting fresh", err);
   201→    }
   202→
   203→    // Merge env settings
   204→    const env = (config.env as Record<string, string>) || {};
   205→    env.KSPEC_AUTHOR = author;
   206→    config.env = env;
   207→
   208→    // Write back
   209→    await fs.writeFile(
   210→      configPath,
   211→      `${JSON.stringify(config, null, 2)}\n`,
   212→      "utf-8",
   213→    );
   214→    return true;
   215→  } catch (err) {
   216→    debugLog("Failed to install Claude Code config", err);
   217→    return false;
   218→  }
   219→}
   220→
   221→/**
   222→ * Result of installing hooks
   223→ * AC: @enhanced-setup ac-2 - tracks all hook types
   224→ */
   225→export interface HooksInstallResult {
   226→  promptCheck: boolean;
   227→  stop: boolean;
   228→  preToolUse: boolean;
   229→  guardsCreated: string[];
   230→}
   231→
   232→/**
   233→ * Native guard command for PreToolUse hooks.
   234→ * Replaces bash shell scripts with `kspec guard worktree`.
   235→ *
   236→ * AC: @native-guard-commands ac-setup-native - references kspec guard worktree
   237→ */
   238→const NATIVE_GUARD_COMMAND = "kspec guard worktree";
   239→
   240→/**
   241→ * Old bash script filenames that should be migrated to native commands.
   242→ * AC: @native-guard-commands ac-migrate-hooks
   243→ */
   244→const OLD_GUARD_SCRIPTS = [
   245→  "kspec-worktree-guard.sh",
   246→  "ralph-task-limit-guard.sh",
   247→];
   248→
   249→/**
   250→ * Install hooks to project-level Claude Code settings (.claude/settings.json)
   251→ * AC: @enhanced-setup ac-2 - all hook entries present
   252→ */
   253→async function installClaudeCodeHooks(
   254→  projectDir: string,
   255→  dryRun = false,
   256→): Promise<HooksInstallResult> {
   257→  const configPath = path.join(projectDir, ".claude", "settings.json");
   258→  const configDir = path.dirname(configPath);
   259→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   260→
   261→  const result: HooksInstallResult = {
   262→    promptCheck: false,
   263→    stop: false,
   264→    preToolUse: false,
   265→    guardsCreated: [],
   266→  };
   267→
   268→  try {
   269→    // Ensure directories exist
   270→    if (!dryRun) {
   271→      await fs.mkdir(configDir, { recursive: true });
   272→      await fs.mkdir(hooksDir, { recursive: true });
   273→    }
   274→
   275→    // Read existing config or start fresh
   276→    let config: Record<string, unknown> = {};
   277→    try {
   278→      const existing = await fs.readFile(configPath, "utf-8");
   279→      config = JSON.parse(existing);
   280→    } catch (err) {
   281→      debugLog("No existing hooks config, starting fresh", err);
   282→    }
   283→
   284→    // Get or create hooks object
   285→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   286→
   287→    // Install UserPromptSubmit hook (spec-first reminder)
   288→    const promptCheckCommand = "kspec session prompt-check";
   289→    const existingPromptHooks = hooks.UserPromptSubmit as
   290→      | Array<{ hooks?: Array<{ command?: string }> }>
   291→      | undefined;
   292→    const promptAlreadyInstalled = existingPromptHooks?.some((entry) =>
   293→      entry.hooks?.some((hook) =>
   294→        hook.command?.includes("session prompt-check"),
   295→      ),
   296→    );
   297→
   298→    if (!promptAlreadyInstalled) {
   299→      hooks.UserPromptSubmit = [
   300→        ...(existingPromptHooks || []),
   301→        {
   302→          hooks: [
   303→            {
   304→              type: "command",
   305→              command: promptCheckCommand,
   306→            },
   307→          ],
   308→        },
   309→      ];
   310→      result.promptCheck = true;
   311→    } else {
   312→      result.promptCheck = true; // Already configured
   313→    }
   314→
   315→    // Install Stop hook (checkpoint)
   316→    const stopHookCommand = "kspec session checkpoint --json";
   317→    const existingStopHooks = hooks.Stop as
   318→      | Array<{ matcher?: string; hooks?: Array<{ command?: string }> }>
   319→      | undefined;
   320→    const stopAlreadyInstalled = existingStopHooks?.some((entry) =>
   321→      entry.hooks?.some((hook) => hook.command?.includes("session checkpoint")),
   322→    );
   323→
   324→    if (!stopAlreadyInstalled) {
   325→      hooks.Stop = [
   326→        ...(existingStopHooks || []),
   327→        {
   328→          matcher: "",
   329→          hooks: [
   330→            {
   331→              type: "command",
   332→              command: stopHookCommand,
   333→            },
   334→          ],
   335→        },
   336→      ];
   337→      result.stop = true;
   338→    } else {
   339→      result.stop = true; // Already configured
   340→    }
   341→
   342→    // AC: @enhanced-setup ac-2 - Install PreToolUse hooks with guards
   343→    // AC: @native-guard-commands ac-setup-native - use native kspec guard worktree
   344→    // AC: @native-guard-commands ac-no-task-limit-hook - no task-limit guard
   345→    // AC: @native-guard-commands ac-migrate-hooks - replace old bash script entries
   346→    // AC: @native-guard-commands ac-idempotent - no duplicate entries
   347→    const existingPreToolUseHooks = hooks.PreToolUse as
   348→      | Array<{ matcher?: string; hooks?: Array<{ type?: string; command?: string }> }>
   349→      | undefined;
   350→
   351→    // Check if native guard command is already installed
   352→    const nativeAlreadyInstalled = existingPreToolUseHooks?.some((entry) =>
   353→      entry.hooks?.some((hook) => hook.command === NATIVE_GUARD_COMMAND),
   354→    );
   355→
   356→    // Check for old bash script entries that need migration
   357→    const hasOldScripts = existingPreToolUseHooks?.some((entry) =>
   358→      entry.hooks?.some((hook) =>
   359→        OLD_GUARD_SCRIPTS.some(
   360→          (name) => hook.command?.includes(name),
   361→        ),
   362→      ),
   363→    );
   364→
   365→    if (hasOldScripts || !nativeAlreadyInstalled) {
   366→      // Remove any PreToolUse entries that reference old bash scripts
   367→      // AC: @native-guard-commands ac-migrate-hooks
   368→      let filteredPreToolUse = (existingPreToolUseHooks || []).map((entry) => ({
   369→        ...entry,
   370→        hooks: entry.hooks?.filter(
   371→          (hook) =>
   372→            !OLD_GUARD_SCRIPTS.some((name) => hook.command?.includes(name)),
   373→        ),
   374→      }));
   375→      // Remove entries with empty hooks arrays
   376→      filteredPreToolUse = filteredPreToolUse.filter(
   377→        (entry) => entry.hooks && entry.hooks.length > 0,
   378→      );
   379→
   380→      // Add native guard command if not already present
   381→      if (!nativeAlreadyInstalled) {
   382→        filteredPreToolUse.push({
   383→          matcher: "Bash",
   384→          hooks: [
   385→            {
   386→              type: "command",
   387→              command: NATIVE_GUARD_COMMAND,
   388→            },
   389→          ],
   390→        });
   391→      }
   392→
   393→      hooks.PreToolUse = filteredPreToolUse;
   394→      result.preToolUse = true;
   395→
   396→      // Delete old bash script files
   397→      // AC: @native-guard-commands ac-migrate-hooks - delete old files
   398→      if (!dryRun) {
   399→        for (const name of OLD_GUARD_SCRIPTS) {
   400→          const scriptPath = path.join(hooksDir, name);
   401→          try {
   402→            await fs.unlink(scriptPath);
   403→            result.guardsCreated.push(`deleted:${name}`);
   404→          } catch (err) {
   405→            debugLog(`Could not delete old guard script ${name}`, err);
   406→          }
   407→        }
   408→      }
   409→    } else {
   410→      result.preToolUse = true; // Already configured with native command
   411→    }
   412→
   413→    config.hooks = hooks;
   414→
   415→    // Write back
   416→    if (!dryRun) {
   417→      await fs.writeFile(
   418→        configPath,
   419→        `${JSON.stringify(config, null, 2)}\n`,
   420→        "utf-8",
   421→      );
   422→    }
   423→    return result;
   424→  } catch (err) {
   425→    debugLog("installClaudeCodeHooks failed", err);
   426→    return result;
   427→  }
   428→}
   429→
   430→/**
   431→ * Install KSPEC_AUTHOR config for Aider (.aider.conf.yml)
   432→ * Aider uses `set-env:` for environment variables in list format
   433→ */
   434→async function installAiderConfig(author: string): Promise<boolean> {
   435→  const configPath = path.join(os.homedir(), ".aider.conf.yml");
   436→
   437→  try {
   438→    let content = "";
   439→    try {
   440→      content = await fs.readFile(configPath, "utf-8");
   441→    } catch (err) {
   442→      debugLog("No existing Aider config, starting fresh", err);
   443→    }
   444→
   445→    // Check if KSPEC_AUTHOR is already set
   446→    if (content.includes("KSPEC_AUTHOR")) {
   447→      // Replace existing value (handles both old and new format)
   448→      content = content.replace(
   449→        /^(\s*-?\s*KSPEC_AUTHOR\s*[=:]\s*).*$/m,
   450→        `  - KSPEC_AUTHOR=${author}`,
   451→      );
   452→    } else {
   453→      // Add to set-env section or create it
   454→      if (content.includes("set-env:")) {
   455→        // Append to existing set-env section
   456→        content = content.replace(
   457→          /(set-env:\s*\n)/m,
   458→          `$1  - KSPEC_AUTHOR=${author}\n`,
   459→        );
   460→      } else {
   461→        // Add new set-env section
   462→        content += `\n# kspec author for note attribution\nset-env:\n  - KSPEC_AUTHOR=${author}\n`;
   463→      }
   464→    }
   465→
   466→    await fs.writeFile(configPath, content, "utf-8");
   467→    return true;
   468→  } catch (err) {
   469→    debugLog("installAiderConfig failed", err);
   470→    return false;
   471→  }
   472→}
   473→
   474→/**
   475→ * Install KSPEC_AUTHOR for generic JSON config files
