   530→  // AC: @cmd-session-start ac-notes-starvation
   531→  describe('notes starvation prevention', () => {
   532→    it('should include notes from all statuses in JSON', { timeout: 20000 }, () => {
   533→      // Create in_progress tasks with many notes
   534→      for (let i = 1; i <= 5; i++) {
   535→        kspec(`task add --title "Active ${i}" --slug active-${i}`, tempDir);
   536→        kspec(`task start @active-${i}`, tempDir);
   537→        kspec(`task note @active-${i} "Active note ${i}"`, tempDir);
   538→      }
   539→
   540→      // Create pending_review task
   541→      kspec('task add --title "Review" --slug review-task', tempDir);
   542→      kspec('task start @review-task', tempDir);
   543→      kspec('task note @review-task "Review note"', tempDir);
   544→      kspec('task submit @review-task', tempDir);
   545→
   546→      // Create completed task
   547→      kspec('task add --title "Done" --slug done-task', tempDir);
   548→      kspec('task start @done-task', tempDir);
   549→      kspec('task note @done-task "Done note"', tempDir);
   550→      kspec('task submit @done-task', tempDir);
   551→      kspec('task complete @done-task --reason "Finished"', tempDir);
   552→
   553→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   554→
   555→      const inProgressNotes = session.recent_notes.filter(
   556→        (n) => n.task_status === 'in_progress',
   557→      );
   558→      const reviewNotes = session.recent_notes.filter(
   559→        (n) => n.task_status === 'pending_review',
   560→      );
   561→      const completedNotes = session.recent_notes.filter(
   562→        (n) => n.task_status === 'completed',
   563→      );
   564→
   565→      // Each status should have at least one note (not starved)
   566→      expect(inProgressNotes.length).toBeGreaterThan(0);
   567→      expect(reviewNotes.length).toBeGreaterThan(0);
   568→      expect(completedNotes.length).toBeGreaterThan(0);
   569→    });
   570→  });
