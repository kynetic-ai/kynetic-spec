   450→
   451→    it('should show recent notes inline under active tasks', () => {
   452→      kspec('task add --title "Active task" --slug active-task', tempDir);
   453→      kspec('task start @active-task', tempDir);
   454→      kspec('task note @active-task "Working on the implementation"', tempDir);
