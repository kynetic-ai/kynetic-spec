   499→
   500→    it('should distinguish needs_work from in_progress in same output', () => {
   501→      kspec('task add --title "Normal task" --slug normal-task', tempDir);
   502→      kspec('task start @normal-task', tempDir);
   503→
   504→      kspec('task add --title "Fix task" --slug fix-task', tempDir);
   505→      kspec('task start @fix-task', tempDir);
   506→      kspec('task submit @fix-task', tempDir);
   507→      kspec('task needs-work @fix-task --reason "Failing tests"', tempDir);
   508→
   509→      const result = kspec('session start', tempDir);
