   474→
   475→  // AC: @cmd-session-start ac-needs-work-indicator
   476→  describe('needs_work visual distinction', () => {
   477→    it('should display [needs_work] label for needs_work tasks', () => {
   478→      kspec('task add --title "Fix task" --slug fix-task', tempDir);
   479→      kspec('task start @fix-task', tempDir);
   480→      kspec('task submit @fix-task', tempDir);
   481→      kspec('task needs-work @fix-task --reason "Failing tests"', tempDir);
   482→
   483→      const result = kspec('session start', tempDir);
   484→      expect(result.stdout).toContain('[needs_work]');
   485→      expect(result.stdout).toContain('Fix task');
   486→    });
   487→
   488→    it('should include needs_work status in JSON', () => {
   489→      kspec('task add --title "Fix task" --slug fix-task', tempDir);
   490→      kspec('task start @fix-task', tempDir);
   491→      kspec('task submit @fix-task', tempDir);
   492→      kspec('task needs-work @fix-task --reason "Failing tests"', tempDir);
   493→
   494→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   495→      const task = session.active_tasks.find((t) => t.slug === 'fix-task');
   496→      expect(task).toBeDefined();
   497→      expect(task!.status).toBe('needs_work');
