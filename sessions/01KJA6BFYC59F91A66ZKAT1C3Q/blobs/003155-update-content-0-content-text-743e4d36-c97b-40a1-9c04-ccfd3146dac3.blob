   514→
   515→  // AC: @cmd-session-start ac-review-detail
   516→  describe('review task detail', () => {
   517→    it('should show title and recent notes for pending_review tasks', () => {
   518→      kspec('task add --title "Review this" --slug review-this', tempDir);
   519→      kspec('task start @review-this', tempDir);
   520→      kspec('task note @review-this "Implementation complete, PR #100"', tempDir);
