```
     1→/**
     2→ * Session context data gathering.
     3→ *
     4→ * Loads and aggregates all data needed for session start output.
     5→ */
     6→
     7→import {
     8→  getReadyTasks,
     9→  type KspecContext,
    10→  type LoadedTask,
    11→  loadAllItems,
    12→  loadAllTasks,
    13→  loadInboxItems,
    14→  loadSessionContext,
    15→  loadTriageRecords,
    16→  ReferenceIndex,
    17→} from "../../../parser/index.js";
    18→import { loadMetaContext } from "../../../parser/meta.js";
    19→import {
    20→  type GitWorkingTree,
    21→  getCurrentBranch,
    22→  getRecentCommits,
    23→  getWorkingTreeStatus,
    24→  isGitRepo,
    25→  parseTimeSpec,
    26→} from "../../../utils/index.js";
    27→import { isNoteSuperseded } from "../../output.js";
    28→import type {
    29→  ActiveTaskSummary,
    30→  ActivityItem,
    31→  BlockedTaskSummary,
    32→  CommitSummary,
    33→  CompletedTaskSummary,
    34→  InboxStats,
    35→  InboxSummary,
    36→  IterationStats,
    37→  NoteSummary,
    38→  ObservationSummary,
    39→  ReadyTaskSummary,
    40→  SessionContext,
    41→  SessionContextComputed,
    42→  SessionOptions,
    43→  SessionStats,
    44→  TodoSummary,
    45→} from "./types.js";
    46→
    47→// ─── Mapper Functions ───────────────────────────────────────────────────────
    48→
    49→/**
    50→ * Build a reverse dependency map: for each task ULID, count how many
    51→ * pending tasks depend on it. Unresolvable refs are silently skipped.
    52→ */
    53→function computeUnlocksMap(
    54→  allTasks: LoadedTask[],
    55→  index: ReferenceIndex,
    56→): Map<string, number> {
    57→  const counts = new Map<string, number>();
    58→
    59→  for (const task of allTasks) {
    60→    // Only count pending tasks as "unlockable" downstream work per spec
    61→    if (task.status !== "pending") continue;
    62→
    63→    for (const depRef of task.depends_on) {
    64→      const result = index.resolve(depRef);
    65→      if (!result.ok) continue; // AC: unresolvable refs silently skipped
    66→      const depUlid = result.item._ulid;
    67→      counts.set(depUlid, (counts.get(depUlid) || 0) + 1);
    68→    }
    69→  }
    70→
    71→  return counts;
    72→}
    73→
    74→function toActiveTaskSummary(
    75→  task: LoadedTask,
    76→  index: ReferenceIndex,
    77→): ActiveTaskSummary {
    78→  const lastNote =
    79→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
    80→  const incompleteTodos = task.todos.filter((t) => !t.done).length;
    81→  return {
    82→    ref: index.shortUlid(task._ulid),
    83→    slug: task.slugs.length > 0 ? task.slugs[0] : null,
    84→    title: task.title,
    85→    description: task.description || null,
    86→    status: task.status as "in_progress" | "needs_work" | "pending_review",
    87→    started_at: task.started_at || null,
    88→    priority: task.priority,
    89→    spec_ref: task.spec_ref || null,
    90→    note_count: task.notes.length,
    91→    last_note_at: lastNote ? lastNote.created_at : null,
    92→    todo_count: task.todos.length,
    93→    incomplete_todos: incompleteTodos,
    94→  };
    95→}
    96→
    97→function toReadyTaskSummary(
    98→  task: LoadedTask,
    99→  index: ReferenceIndex,
   100→  unlocksMap: Map<string, number>,
   101→): ReadyTaskSummary {
   102→  return {
   103→    ref: index.shortUlid(task._ulid),
   104→    slug: task.slugs.length > 0 ? task.slugs[0] : null,
   105→    title: task.title,
   106→    description: task.description || null,
   107→    priority: task.priority,
   108→    spec_ref: task.spec_ref || null,
   109→    tags: task.tags,
   110→    unlocks: unlocksMap.get(task._ulid) || 0,
   111→  };
   112→}
   113→
   114→function toBlockedTaskSummary(
   115→  task: LoadedTask,
   116→  index: ReferenceIndex,
   117→  unlocksMap: Map<string, number>,
   118→): BlockedTaskSummary {
   119→  // Find unmet dependencies
   120→  const unmetDeps: string[] = [];
   121→  for (const depRef of task.depends_on) {
   122→    const result = index.resolve(depRef);
   123→    if (result.ok) {
   124→      const depItem = result.item;
   125→      if ("status" in depItem && depItem.status !== "completed") {
   126→        unmetDeps.push(depRef);
   127→      }
   128→    }
   129→  }
   130→
   131→  return {
   132→    ref: index.shortUlid(task._ulid),
   133→    slug: task.slugs.length > 0 ? task.slugs[0] : null,
   134→    title: task.title,
   135→    description: task.description || null,
   136→    blocked_by: task.blocked_by,
   137→    unmet_deps: unmetDeps,
   138→    unlocks: unlocksMap.get(task._ulid) || 0,
   139→  };
   140→}
   141→
   142→function toCompletedTaskSummary(
   143→  task: LoadedTask,
   144→  index: ReferenceIndex,
   145→): CompletedTaskSummary {
   146→  return {
   147→    ref: index.shortUlid(task._ulid),
   148→    slug: task.slugs.length > 0 ? task.slugs[0] : null,
   149→    title: task.title,
   150→    completed_at: task.completed_at || "",
   151→    closed_reason: task.closed_reason || null,
   152→    origin: task.origin,
   153→  };
   154→}
   155→
   156→function collectRecentNotes(
   157→  tasks: LoadedTask[],
   158→  index: ReferenceIndex,
   159→  options: { limit: number | undefined; since: Date | null },
   160→): NoteSummary[] {
   161→  const allNotes: NoteSummary[] = [];
   162→
   163→  for (const task of tasks) {
   164→    // Only include notes from in_progress, pending_review, or completed tasks
   165→    const taskStatus = task.status as "in_progress" | "pending_review" | "needs_work" | "completed";
   166→    if (!["in_progress", "pending_review", "needs_work", "completed"].includes(taskStatus)) {
   167→      continue;
   168→    }
   169→
   170→    for (const note of task.notes) {
   171→      const noteDate = new Date(note.created_at);
   172→
   173→      // Filter by since date if provided
   174→      if (options.since && noteDate < options.since) {
   175→        continue;
   176→      }
   177→
   178→      // Filter out superseded notes
   179→      if (isNoteSuperseded(note, task.notes)) {
   180→        continue;
   181→      }
   182→
   183→      allNotes.push({
   184→        task_ref: index.shortUlid(task._ulid),
   185→        task_title: task.title,
   186→        task_status: taskStatus,
   187→        note_ulid: note._ulid.slice(0, 8),
   188→        created_at: note.created_at,
   189→        author: note.author || null,
   190→        content: note.content,
   191→      });
   192→    }
   193→  }
   194→
   195→  // Sort by date descending, take limit
   196→  return allNotes
   197→    .sort(
   198→      (a, b) =>
   199→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   200→    )
   201→    .slice(0, options.limit);
   202→}
   203→
   204→function collectIncompleteTodos(
   205→  tasks: LoadedTask[],
   206→  index: ReferenceIndex,
   207→  options: { limit: number },
   208→): TodoSummary[] {
   209→  const allTodos: TodoSummary[] = [];
   210→
   211→  for (const task of tasks) {
   212→    for (const todo of task.todos) {
   213→      // Only include incomplete todos
   214→      if (todo.done) continue;
   215→
   216→      allTodos.push({
   217→        task_ref: index.shortUlid(task._ulid),
   218→        task_title: task.title,
   219→        id: todo.id,
   220→        text: todo.text,
   221→        added_at: todo.added_at,
   222→        added_by: todo.added_by || null,
   223→      });
   224→    }
   225→  }
   226→
   227→  // Sort by added_at descending (most recent first), take limit
   228→  return allTodos
   229→    .sort(
   230→      (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime(),
   231→    )
   232→    .slice(0, options.limit);
   233→}
   234→
   235→/**
   236→ * Build a unified activity timeline from completed tasks and git commits.
   237→ *
   238→ * - Commits with Task: @slug trailers are matched to completed tasks and shown
   239→ *   as combined "linked_commit" entries (AC: ac-activity-trailer-link, ac-activity-dedup)
   240→ * - Unlinked commits appear as standalone "commit" entries
   241→ * - Tasks not linked to any commit appear as standalone "task_completion" entries
   242→ * - All items sorted most recent first (AC: ac-activity-sort)
   243→ *
   244→ * @param completedTasks - Completed task summaries
   245→ * @param commits - Recent commit summaries (with task_refs parsed from trailers)
   246→ * @param taskRefResolver - Maps a trailer ref (slug or ULID prefix) to a completed task's ref (short ULID)
   247→ */
   248→function buildActivityTimeline(
   249→  completedTasks: CompletedTaskSummary[],
   250→  commits: CommitSummary[],
   251→  taskRefResolver: Map<string, string>,
   252→): ActivityItem[] {
   253→  const items: ActivityItem[] = [];
   254→
   255→  // Build lookup from short ULID ref to CompletedTaskSummary
   256→  const taskByRef = new Map<string, CompletedTaskSummary>();
   257→  for (const task of completedTasks) {
   258→    taskByRef.set(task.ref, task);
   259→  }
   260→
   261→  // Track which tasks have been linked to a commit (for dedup)
   262→  const linkedTaskRefs = new Set<string>();
   263→
   264→  for (const commit of commits) {
   265→    if (commit.task_refs.length > 0) {
   266→      let linkedTask: CompletedTaskSummary | undefined;
   267→      for (const trailerRef of commit.task_refs) {
   268→        // Resolve the trailer ref (slug or ULID) to the short ULID ref
   269→        const resolvedRef = taskRefResolver.get(trailerRef);
   270→        if (resolvedRef) {
   271→          linkedTask = taskByRef.get(resolvedRef);
   272→        }
   273→        // Also try direct match on short ULID ref
   274→        if (!linkedTask) {
   275→          linkedTask = taskByRef.get(trailerRef);
   276→        }
   277→        if (linkedTask) {
   278→          linkedTaskRefs.add(linkedTask.ref);
   279→          // Use the later of commit date and task completion date for sort accuracy
   280→          const commitTime = new Date(commit.date).getTime();
   281→          const taskTime = new Date(linkedTask.completed_at).getTime();
   282→          const laterDate =
   283→            taskTime > commitTime ? linkedTask.completed_at : commit.date;
   284→          items.push({
   285→            type: "linked_commit",
   286→            date: laterDate,
   287→            commit,
   288→            task: linkedTask,
   289→          });
   290→          break; // One linked entry per commit
   291→        }
   292→      }
   293→      if (!linkedTask) {
   294→        // Task ref in trailer but no matching completed task found
   295→        items.push({ type: "commit", date: commit.date, commit });
   296→      }
   297→    } else {
   298→      items.push({ type: "commit", date: commit.date, commit });
   299→    }
   300→  }
   301→
   302→  // Add task completions not already linked to a commit
   303→  for (const task of completedTasks) {
   304→    if (!linkedTaskRefs.has(task.ref)) {
   305→      items.push({
   306→        type: "task_completion",
   307→        date: task.completed_at,
   308→        task,
   309→      });
   310→    }
   311→  }
   312→
   313→  // AC: @session-start-activity-timeline ac-activity-sort
   314→  // Sort most recent first
   315→  items.sort(
   316→    (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
   317→  );
   318→
   319→  return items;
   320→}
   321→
   322→// ─── Main Gather Function ───────────────────────────────────────────────────
   323→
   324→/**
   325→ * Gather session context data
   326→ */
   327→export async function gatherSessionContext(
   328→  ctx: KspecContext,
   329→  options: SessionOptions,
   330→): Promise<SessionContext> {
   331→  const limit = parseInt(options.limit || "10", 10);
   332→  if (Number.isNaN(limit) || limit <= 0) {
   333→    throw new RangeError(
   334→      `Invalid limit: "${options.limit}". Must be a positive integer.`,
   335→    );
   336→  }
   337→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   338→  const showGit = options.git !== false; // default true
   339→
   340→  // Load all data
   341→  const allTasks = await loadAllTasks(ctx);
   342→  const items = await loadAllItems(ctx);
   343→  const inboxItems = await loadInboxItems(ctx);
   344→  const triageRecords = await loadTriageRecords(ctx);
   345→  const index = new ReferenceIndex(allTasks, items);
   346→
   347→  // AC: @session-start-inbox-triage ac-inbox-untriaged-def
   348→  // Build lookup: inbox ULID → triage record (most recent if multiple)
   349→  const triageByInboxRef = new Map<string, { action?: string }>();
   350→  for (const record of triageRecords) {
   351→    triageByInboxRef.set(record.inbox_ref, { action: record.action });
   352→  }
   353→
   354→  // ── Single-pass task bucketing ──────────────────────────────────────────
   355→  // Bucket all tasks by status in one pass instead of 14+ separate .filter() calls.
   356→  const tasksByStatus = new Map<string, LoadedTask[]>();
   357→  for (const task of allTasks) {
   358→    const existing = tasksByStatus.get(task.status);
   359→    if (existing) {
   360→      existing.push(task);
   361→    } else {
   362→      tasksByStatus.set(task.status, [task]);
   363→    }
   364→  }
   365→
   366→  // Helper to get a status bucket (returns empty array if none)
   367→  const bucket = (status: string): LoadedTask[] =>
   368→    tasksByStatus.get(status) || [];
   369→
   370→  // Cache getReadyTasks (expensive: checks dependencies for every pending task)
   371→  const allReadyTasks = getReadyTasks(allTasks);
   372→
   373→  // Cache sorted completed tasks (used for notes and recentlyCompleted list)
   374→  const completedWithDate = bucket("completed")
   375→    .filter((t) => t.completed_at)
   376→    .sort((a, b) => {
   377→      const aDate = new Date(a.completed_at || 0);
   378→      const bDate = new Date(b.completed_at || 0);
   379→      return bDate.getTime() - aDate.getTime();
   380→    });
   381→
   382→  // Active tasks = in_progress + needs_work
   383→  const activeStatusTasks = [...bucket("in_progress"), ...bucket("needs_work")];
   384→
   385→  // Compute stats from buckets
   386→  const stats: SessionStats = {
   387→    total_tasks: allTasks.length,
   388→    in_progress: bucket("in_progress").length,
   389→    needs_work: bucket("needs_work").length,
   390→    pending_review: bucket("pending_review").length,
   391→    ready: allReadyTasks.length,
   392→    blocked: bucket("blocked").length,
   393→    completed: bucket("completed").length,
   394→    inbox_items: inboxItems.length,
   395→  };
   396→
   397→  // Get active tasks (in_progress + needs_work, optionally filtered to automation-eligible only)
   398→  // AC: @cli-ralph ac-16
   399→  const activeTasks = activeStatusTasks
   400→    .filter((t) => !options.eligible || t.automation === "eligible")
   401→    .sort((a, b) => a.priority - b.priority)
   402→    .slice(0, options.full ? undefined : limit)
   403→    .map((t) => toActiveTaskSummary(t, index));
   404→
   405→  // Get pending review tasks
   406→  const pendingReviewTasks = bucket("pending_review")
   407→    .sort((a, b) => a.priority - b.priority)
   408→    .slice(0, options.full ? undefined : limit)
   409→    .map((t) => toActiveTaskSummary(t, index));
   410→
   411→  // Get recent notes from active, pending_review, and recently completed tasks
   412→  // AC: @cmd-session-start ac-1, ac-2
   413→  // Collect notes per-status first to prevent one status from starving others
   414→  // In full mode, uncap notes (consistent with other sections that use undefined in full mode).
   415→  // In non-full mode, split limit across 3 status buckets to prevent starvation.
   416→  const noteLimitPerStatus = options.full ? undefined : Math.ceil(limit / 3);
   417→
   418→  const inProgressNotes = collectRecentNotes(
   419→    activeStatusTasks,
   420→    index,
   421→    { limit: noteLimitPerStatus, since: sinceDate },
   422→  );
   423→
   424→  const pendingReviewNotes = collectRecentNotes(
   425→    bucket("pending_review"),
   426→    index,
   427→    { limit: noteLimitPerStatus, since: sinceDate },
   428→  );
   429→
   430→  const recentlyCompletedForNotes = completedWithDate
   431→    .slice(0, 5); // Last 3-5 completed tasks per AC-2
   432→
   433→  const completedNotes = collectRecentNotes(
   434→    recentlyCompletedForNotes,
   435→    index,
   436→    { limit: noteLimitPerStatus, since: sinceDate },
   437→  );
   438→
   439→  // Combine notes from all statuses, preserving representation from each.
   440→  // In non-full mode, apply final cap to handle ceil() rounding across 3 buckets.
   441→  const noteLimit = options.full ? undefined : limit;
   442→  const recentNotes = [...inProgressNotes, ...pendingReviewNotes, ...completedNotes]
   443→    .sort(
   444→      (a, b) =>
   445→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   446→    )
   447→    .slice(0, noteLimit);
   448→
   449→  // Get incomplete todos from active tasks
   450→  const activeTodos = collectIncompleteTodos(
   451→    activeStatusTasks,
   452→    index,
   453→    { limit: options.full ? limit * 2 : limit },
   454→  );
   455→
   456→  // Compute reverse dependency map for "unlocks N" annotations
   457→  const unlocksMap = computeUnlocksMap(allTasks, index);
   458→
   459→  // AC: @cmd-session-start ac-primer-default, ac-full-sections
   460→  // Primer: top 5 ready tasks; Full: all ready tasks
   461→  // Respect --limit as upper bound when provided
   462→  const readyLimit = options.full ? undefined : Math.min(limit, 5);
   463→  const readyTasks = allReadyTasks
   464→    .filter((t) => !options.eligible || t.automation === "eligible")
   465→    .slice(0, readyLimit)
   466→    .map((t) => toReadyTaskSummary(t, index, unlocksMap));
   467→
   468→  // Get blocked tasks
   469→  const blockedTasks = bucket("blocked")
   470→    .slice(0, options.full ? undefined : limit)
   471→    .map((t) => toBlockedTaskSummary(t, index, unlocksMap));
   472→
   473→  // Get recently completed tasks (reuse cached sorted list)
   474→  const recentlyCompleted = completedWithDate
   475→    .filter((t) => {
   476→      if (!sinceDate) return true;
   477→      const completedDate = new Date(t.completed_at || 0);
   478→      return completedDate >= sinceDate;
   479→    })
   480→    .slice(0, options.full ? undefined : limit)
   481→    .map((t) => toCompletedTaskSummary(t, index));
   482→
   483→  // Get git info
   484→  let branch: string | null = null;
   485→  let recentCommits: CommitSummary[] = [];
   486→  let workingTree: GitWorkingTree | null = null;
   487→
   488→  if (showGit && isGitRepo(ctx.rootDir)) {
   489→    branch = getCurrentBranch(ctx.rootDir);
   490→
   491→    const commits = getRecentCommits({
   492→      limit: options.full ? limit * 2 : limit,
   493→      since: sinceDate || undefined,
   494→      cwd: ctx.rootDir,
   495→    });
   496→
   497→    recentCommits = commits.map((c) => ({
   498→      hash: c.hash,
   499→      full_hash: c.fullHash,
   500→      date: c.date.toISOString(),
   501→      message: c.message,
   502→      author: c.author,
   503→      task_refs: c.taskRefs,
   504→    }));
   505→
   506→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   507→  }
   508→
   509→  // Get inbox items with triage status (oldest first to encourage triage)
   510→  // AC: @session-start-inbox-triage ac-inbox-untriaged-def
   511→  const allInboxSummaries: InboxSummary[] = inboxItems
   512→    .sort(
   513→      (a, b) =>
   514→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   515→    )
   516→    .map((item) => {
   517→      const triageInfo = triageByInboxRef.get(item._ulid);
   518→      return {
   519→        ref: item._ulid.slice(0, 8),
   520→        text: item.text,
   521→        created_at: item.created_at,
   522→        tags: item.tags,
   523→        added_by: item.added_by || null,
   524→        triaged: !!triageInfo,
   525→        triage_action: triageInfo?.action ?? null,
   526→      };
   527→    });
   528→
   529→  // AC: @session-start-inbox-triage ac-inbox-stat-line, ac-inbox-all-triaged
   530→  const inboxStats: InboxStats = {
   531→    total: allInboxSummaries.length,
   532→    untriaged: allInboxSummaries.filter((i) => !i.triaged).length,
   533→    deferred: allInboxSummaries.filter((i) => i.triage_action === "defer")
   534→      .length,
   535→    triaged: allInboxSummaries.filter((i) => i.triaged).length,
   536→  };
   537→
   538→  // JSON always gets full list with triage status; human display filters in formatSessionContext
   539→  const inboxSummaries: InboxSummary[] = allInboxSummaries;
   540→
   541→  // Load session context (focus, threads, questions)
   542→  const sessionContext = await loadSessionContext(ctx);
   543→
   544→  // Build task ref resolver for activity timeline: maps slug/ULID to short ref
   545→  // This allows commits with Task: @task-slug trailers to match completed tasks
   546→  const taskRefResolver = new Map<string, string>();
   547→  for (const task of allTasks) {
   548→    if (task.status !== "completed") continue;
   549→    const shortRef = index.shortUlid(task._ulid);
   550→    // Map each slug to the short ref
   551→    for (const slug of task.slugs) {
   552→      taskRefResolver.set(slug, shortRef);
   553→    }
   554→    // Also map the full ULID and short ULID to itself
   555→    taskRefResolver.set(task._ulid, shortRef);
   556→    taskRefResolver.set(shortRef, shortRef);
   557→  }
   558→
   559→  // Build unified activity timeline
   560→  // AC: @session-start-activity-timeline ac-activity-merge
   561→  // AC: @cmd-session-start ac-primer-default, ac-full-sections
   562→  // Primer: 10 items; Full: 20 items
   563→  // Respect --limit as upper bound when provided
   564→  const activityLimit = options.full ? Math.min(limit * 2, 20) : Math.min(limit, 10);
   565→  const activityTimeline = buildActivityTimeline(
   566→    recentlyCompleted,
   567→    recentCommits,
   568→    taskRefResolver,
   569→  ).slice(0, activityLimit);
   570→
   571→  // AC: @cmd-session-start ac-full-sections — observations section (full mode only)
   572→  let observations: ObservationSummary[] = [];
   573→  if (options.full) {
   574→    const metaCtx = await loadMetaContext(ctx);
   575→    observations = metaCtx.observations
   576→      .filter((o) => !o.resolved)
   577→      .sort(
   578→        (a, b) =>
   579→          new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   580→      )
   581→      .map((o) => ({
   582→        ref: o._ulid.slice(0, 8),
   583→        type: o.type,
   584→        content: o.content,
   585→        created_at: o.created_at,
   586→        author: o.author || null,
   587→        resolved: o.resolved,
   588→        workflow_ref: o.workflow_ref || null,
   589→      }));
   590→  }
   591→
   592→  // AC: @session-start-computed-json ac-computed-unlocks
   593→  // Build task_unlocks map: short ULID ref → count of pending dependents
   594→  const taskUnlocks: Record<string, number> = {};
   595→  for (const [taskUlid, count] of unlocksMap) {
   596→    if (count > 0) {
   597→      taskUnlocks[index.shortUlid(taskUlid)] = count;
   598→    }
   599→  }
   600→
   601→  // AC: @session-start-computed-json ac-computed-inbox, ac-computed-unlocks, ac-computed-activity
   602→  const computed: SessionContextComputed = {
   603→    inbox_untriaged_count: inboxStats.untriaged,
   604→    inbox_deferred_count: inboxStats.deferred,
   605→    inbox_total: inboxStats.total,
   606→    task_unlocks: taskUnlocks,
   607→    recent_activity: activityTimeline,
   608→  };
   609→
   610→  return {
   611→    generated_at: new Date().toISOString(),
   612→    branch,
   613→    context: sessionContext,
   614→    active_tasks: activeTasks,
   615→    pending_review_tasks: pendingReviewTasks,
   616→    recent_notes: recentNotes,
   617→    active_todos: activeTodos,
   618→    ready_tasks: readyTasks,
   619→    blocked_tasks: blockedTasks,
   620→    recently_completed: recentlyCompleted,
   621→    recent_commits: recentCommits,
   622→    activity_timeline: activityTimeline,
   623→    working_tree: workingTree,
   624→    inbox_items: inboxSummaries,
   625→    inbox_stats: inboxStats,
   626→    observations,
   627→    stats,
   628→    computed,
   629→  };
   630→}
   631→
   632→// ─── Iteration Stats ────────────────────────────────────────────────────────
   633→
   634→/**
   635→ * Get iteration stats - tasks completed/started since a given time.
   636→ * AC: @ralph-task-limit ac-detection
   637→ */
   638→export async function getIterationStats(
   639→  ctx: KspecContext,
   640→  since: Date,
   641→): Promise<IterationStats> {
   642→  const allTasks = await loadAllTasks(ctx);
   643→
   644→  // Count both completed and pending_review (submitted) tasks toward the limit.
   645→  // Submit means the agent's work is done — it should count the same as complete.
   646→  // AC: @ralph-task-limit ac-detection
   647→  const completedSince = allTasks.filter((t) => {
   648→    if (t.status === "completed" && t.completed_at) {
   649→      return new Date(t.completed_at) >= since;
   650→    }
   651→    if (t.status === "pending_review" && t.submitted_at) {
   652→      return new Date(t.submitted_at) >= since;
   653→    }
   654→    return false;
   655→  });
   656→
   657→  const startedSince = allTasks.filter((t) => {
   658→    if (!t.started_at) return false;
   659→    return new Date(t.started_at) >= since;
   660→  });
   661→
   662→  // Use first slug or ULID prefix as ref
   663→  const getRef = (t: LoadedTask) =>
   664→    t.slugs.length > 0 ? `@${t.slugs[0]}` : `@${t._ulid.slice(0, 8)}`;
   665→
   666→  return {
   667→    tasks_completed: completedSince.length,
   668→    tasks_started: startedSince.length,
   669→    completed_refs: completedSince.map(getRef),
   670→  };
   671→}
   672→
```