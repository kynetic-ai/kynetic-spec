   161→describe('getAllSessionLogSummaries', () => {
   162→  let testDir: string;
   163→
   164→  beforeEach(async () => {
   165→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-log-all-'));
   166→  });
   167→
   168→  afterEach(async () => {
   169→    await fs.rm(testDir, { recursive: true });
   170→  });
   171→
   172→  // AC: @session-log-list ac-6
   173→  it('should return empty array when no sessions exist', async () => {
   174→    const summaries = await getAllSessionLogSummaries(testDir);
   175→    expect(summaries).toEqual([]);
   176→  });
   177→
   178→  it('should return summaries for all sessions', async () => {
   179→    const id1 = testUlid('SESS', 1);
   180→    const id2 = testUlid('SESS', 2);
   181→
   182→    await createSession(testDir, { id: id1, agent_type: 'agent-a' });
   183→    await createSession(testDir, { id: id2, agent_type: 'agent-b' });
   184→
   185→    const summaries = await getAllSessionLogSummaries(testDir);
   186→    expect(summaries).toHaveLength(2);
   187→    expect(summaries.map(s => s.id).sort()).toEqual([id1, id2].sort());
   188→  });
   189→});
