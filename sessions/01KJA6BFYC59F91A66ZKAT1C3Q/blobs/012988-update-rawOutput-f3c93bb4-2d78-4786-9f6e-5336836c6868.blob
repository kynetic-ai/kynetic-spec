     1→/**
     2→ * Session human output formatting.
     3→ *
     4→ * Formats session context and checkpoint results for human-readable CLI output.
     5→ */
     6→
     7→import chalk from "chalk";
     8→import { formatRelativeTime } from "../../../utils/index.js";
     9→import {
    10→  hints,
    11→  sessionHeaders,
    12→} from "../../../strings/index.js";
    13→import type {
    14→  CheckpointResult,
    15→  CompletedTaskSummary,
    16→  CommitSummary,
    17→  NoteSummary,
    18→  SessionStartContext,
    19→  SessionOptions,
    20→} from "./types.js";
    21→
    22→// ─── Shared Formatting Helpers ──────────────────────────────────────────────
    23→
    24→/**
    25→ * Display ref as @slug when available, @short-ulid when not.
    26→ * AC: @cmd-session-start ac-slug-display, ac-slug-fallback
    27→ */
    28→export function getDisplayRef(item: { ref: string; slug?: string | null }): string {
    29→  return item.slug ? `@${item.slug}` : `@${item.ref}`;
    30→}
    31→
    32→/**
    33→ * Format priority with color coding.
    34→ * P1-P2: red (high priority), P3+: gray.
    35→ */
    36→export function formatPriority(level: number): string {
    37→  return level <= 2
    38→    ? chalk.red(`P${level}`)
    39→    : chalk.gray(`P${level}`);
    40→}
    41→
    42→/**
    43→ * Format task status with color coding.
    44→ */
    45→export function statusColor(status: string): ReturnType<typeof chalk.red> {
    46→  switch (status) {
    47→    case "in_progress":
    48→      return chalk.blue("[in_progress]");
    49→    case "needs_work":
    50→      return chalk.red("[needs_work]");
    51→    case "pending_review":
    52→      return chalk.yellow("[pending_review]");
    53→    case "blocked":
    54→      return chalk.red("[blocked]");
    55→    case "completed":
    56→      return chalk.green("[completed]");
    57→    default:
    58→      return chalk.gray(`[${status}]`);
    59→  }
    60→}
    61→
    62→/**
    63→ * Format an inline note for display under a task entry.
    64→ */
    65→function formatInlineNote(
    66→  note: NoteSummary,
    67→  isFull: boolean,
    68→): void {
    69→  const noteAge = formatRelativeTime(new Date(note.created_at));
    70→  const author = note.author
    71→    ? chalk.gray(` by ${note.author}`)
    72→    : "";
    73→  console.log(`    ${chalk.yellow("Note")} ${chalk.gray(`(${noteAge}${author})`)}`);
    74→
    75→  let content = note.content.trim();
    76→  if (!isFull && content.length > 200) {
    77→    content = `${content.slice(0, 200).trim()}...`;
    78→  }
    79→  const lines = content.split("\n");
    80→  const maxLines = isFull ? lines.length : 3;
    81→  for (const line of lines.slice(0, maxLines)) {
    82→    console.log(`      ${chalk.white(line)}`);
    83→  }
    84→  if (!isFull && lines.length > maxLines) {
    85→    console.log(
    86→      chalk.gray(
    87→        `      ... (${lines.length - maxLines} more lines)`,
    88→      ),
    89→    );
    90→  }
    91→}
    92→
    93→// ─── Checkpoint Formatting ──────────────────────────────────────────────────
    94→
    95→export function formatCheckpointResult(result: CheckpointResult): void {
    96→  if (result.ok) {
    97→    console.log(chalk.green(result.message));
    98→  } else {
    99→    console.log(chalk.yellow(result.message));
   100→    console.log("");
   101→
   102→    for (const issue of result.issues) {
   103→      const icon =
   104→        issue.type === "uncommitted_changes"
   105→          ? chalk.yellow("⚠")
   106→          : issue.type === "in_progress_task"
   107→            ? chalk.blue("●")
   108→            : chalk.gray("○");
   109→      console.log(`  ${icon} ${issue.description}`);
   110→    }
   111→
   112→    if (result.instructions.length > 0) {
   113→      console.log("");
   114→      for (const instruction of result.instructions) {
   115→        console.log(chalk.gray(instruction));
   116→      }
   117→    }
   118→  }
   119→}
   120→
   121→// ─── Session Context Formatting ─────────────────────────────────────────────
   122→
   123→export function formatSessionContext(
   124→  ctx: SessionStartContext,
   125→  options: SessionOptions,
   126→): void {
   127→  const isFull = !!options.full;
   128→
   129→  // Header
   130→  console.log(`\n${sessionHeaders.title}`);
   131→  const age = formatRelativeTime(new Date(ctx.generated_at));
   132→  if (ctx.branch) {
   133→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   134→  } else {
   135→    console.log(chalk.gray(`Generated: ${age}`));
   136→  }
   137→
   138→  // Stats summary
   139→  const pendingReviewNote =
   140→    ctx.stats.pending_review > 0
   141→      ? `${ctx.stats.pending_review} awaiting review, `
   142→      : "";
   143→  const inboxNote =
   144→    ctx.stats.inbox_items > 0 ? ` | Inbox: ${ctx.stats.inbox_items}` : "";
   145→  console.log(
   146→    chalk.gray(
   147→      `Tasks: ${ctx.stats.in_progress} active, ${pendingReviewNote}${ctx.stats.ready} ready, ` +
   148→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`,
   149→    ),
   150→  );
   151→
   152→  // Session context section (focus, threads, questions)
   153→  if (
   154→    ctx.context &&
   155→    (ctx.context.focus ||
   156→      ctx.context.threads.length > 0 ||
   157→      ctx.context.open_questions.length > 0)
   158→  ) {
   159→    console.log("\n--- Session Context ---");
   160→
   161→    if (ctx.context.focus) {
   162→      console.log(`  ${chalk.cyan("Focus:")} ${ctx.context.focus}`);
   163→    }
   164→
   165→    if (ctx.context.threads.length > 0) {
   166→      console.log(`  ${chalk.cyan("Active Threads:")}`);
   167→      for (const thread of ctx.context.threads) {
   168→        console.log(`    - ${thread}`);
   169→      }
   170→    }
   171→
   172→    if (ctx.context.open_questions.length > 0) {
   173→      console.log(`  ${chalk.cyan("Open Questions:")}`);
   174→      for (const question of ctx.context.open_questions) {
   175→        console.log(`    - ${question}`);
   176→      }
   177→    }
   178→  }
   179→
   180→  // ── Section ordering per AC: @cmd-session-start ac-section-order ──
   181→  // active tasks → pending review → blocked → ready → recent activity → inbox → working tree → quick commands
   182→  // AC: @cmd-session-start ac-empty-skip — empty sections omitted entirely
   183→
   184→  // ── Active tasks section ──
   185→  // AC: @cmd-session-start ac-active-detail, ac-needs-work-indicator
   186→  if (ctx.active_tasks.length > 0) {
   187→    console.log(`\n${sessionHeaders.activeWork}`);
   188→
   189→    // Collect notes relevant to active tasks for inline display
   190→    const activeTaskNotes = ctx.recent_notes.filter(
   191→      (n) =>
   192→        n.task_status === "in_progress" || n.task_status === "needs_work",
   193→    );
   194→
   195→    for (const task of ctx.active_tasks) {
   196→      const started = task.started_at
   197→        ? chalk.gray(
   198→            ` (started ${formatRelativeTime(new Date(task.started_at))})`,
   199→          )
   200→        : "";
   201→
   202→      // AC: @cmd-session-start ac-needs-work-indicator
   203→      const statusLabel = statusColor(task.status);
   204→
   205→      console.log(
   206→        `  ${statusLabel} ${formatPriority(task.priority)} ${getDisplayRef(task)} ${task.title}${started}`,
   207→      );
   208→
   209→      // AC: @cmd-session-start ac-active-detail — show description
   210→      if (task.description) {
   211→        console.log(chalk.gray(`    ${task.description}`));
   212→      }
   213→
   214→      // AC: @cmd-session-start ac-active-detail — show recent notes inline
   215→      const taskNotes = activeTaskNotes.filter(
   216→        (n) => n.task_ref === task.ref,
   217→      );
   218→      if (taskNotes.length > 0) {
   219→        formatInlineNote(taskNotes[0], isFull); // already sorted most recent first
   220→      }
   221→    }
   222→  }
   223→
   224→  // ── Awaiting review section ──
   225→  // AC: @cmd-session-start ac-review-detail
   226→  if (ctx.pending_review_tasks.length > 0) {
   227→    console.log(`\n${sessionHeaders.awaitingReview}`);
   228→
   229→    const reviewNotes = ctx.recent_notes.filter(
   230→      (n) => n.task_status === "pending_review",
   231→    );
   232→
   233→    for (const task of ctx.pending_review_tasks) {
   234→      console.log(
   235→        `  ${chalk.yellow("[pending_review]")} ${formatPriority(task.priority)} ${getDisplayRef(task)} ${task.title}`,
   236→      );
   237→
   238→      // AC: @cmd-session-start ac-review-detail — show recent notes
   239→      const taskNotes = reviewNotes.filter((n) => n.task_ref === task.ref);
   240→      if (taskNotes.length > 0) {
   241→        formatInlineNote(taskNotes[0], isFull);
   242→      }
   243→    }
   244→  }
   245→
   246→  // ── Blocked tasks section ──
   247→  if (ctx.blocked_tasks.length > 0) {
   248→    console.log(`\n${sessionHeaders.blocked}`);
   249→    for (const task of ctx.blocked_tasks) {
   250→      const unlocks =
   251→        task.unlocks > 0 ? chalk.green(` unlocks ${task.unlocks}`) : "";
   252→      console.log(
   253→        `  ${chalk.red("[blocked]")} ${getDisplayRef(task)} ${task.title}${unlocks}`,
   254→      );
   255→      if (task.blocked_by.length > 0) {
   256→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(", ")}`));
   257→      }
   258→      if (task.unmet_deps.length > 0) {
   259→        console.log(
   260→          chalk.gray(`    Waiting on: ${task.unmet_deps.join(", ")}`),
   261→        );
   262→      }
   263→    }
   264→  }
   265→
   266→  // ── Ready tasks section ──
   267→  if (ctx.ready_tasks.length > 0) {
   268→    console.log(`\n${sessionHeaders.readyTasks}`);
   269→    for (const task of ctx.ready_tasks) {
   270→      const tags =
   271→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(" #")}`) : "";
   272→      const unlocks =
   273→        task.unlocks > 0 ? chalk.green(` unlocks ${task.unlocks}`) : "";
   274→      console.log(
   275→        `  ${formatPriority(task.priority)} ${getDisplayRef(task)} ${task.title}${unlocks}${tags}`,
   276→      );
   277→    }
   278→  }
   279→
   280→  // ── Recent Activity timeline ──
   281→  // AC: @session-start-activity-timeline ac-activity-merge
   282→  if (ctx.activity_timeline.length > 0) {
   283→    formatActivityTimeline(ctx.activity_timeline, isFull);
   284→  }
   285→
   286→  // ── Inbox section ──
   287→  // AC: @session-start-inbox-triage ac-inbox-stat-line, ac-inbox-full-list, ac-inbox-all-triaged
   288→  if (ctx.inbox_stats.total > 0) {
   289→    console.log(`\n${sessionHeaders.inbox}`);
   290→    // Stat line always shown (primer and full)
   291→    const statParts = [
   292→      `${ctx.inbox_stats.untriaged} untriaged`,
   293→      `${ctx.inbox_stats.deferred} deferred`,
   294→      `${ctx.inbox_stats.total} total`,
   295→    ];
   296→    console.log(`  ${statParts.join(" | ")}`);
   297→
   298→    // AC: @cmd-session-start ac-full-sections, @session-start-inbox-triage ac-inbox-full-list
   299→    // Full mode: list untriaged items (up to 20)
   300→    // AC: @cmd-session-start ac-slug-fallback — inbox uses @short-ulid
   301→    const untriagedItems = ctx.inbox_items
   302→      .filter((i) => !i.triaged)
   303→      .slice(0, 20);
   304→    if (isFull && untriagedItems.length > 0) {
   305→      console.log("");
   306→      for (const item of untriagedItems) {
   307→        const itemAge = formatRelativeTime(new Date(item.created_at));
   308→        const author = item.added_by ? ` by ${item.added_by}` : "";
   309→        const tags =
   310→          item.tags.length > 0
   311→            ? chalk.cyan(` [${item.tags.join(", ")}]`)
   312→            : "";
   313→        console.log(
   314→          `  ${chalk.magenta(`@${item.ref}`)} ${chalk.gray(`(${itemAge}${author})`)}${tags}`,
   315→        );
   316→        console.log(`    ${item.text}`);
   317→      }
   318→    }
   319→    if (ctx.inbox_stats.untriaged > 0) {
   320→      console.log(`  ${hints.inboxTriage}`);
   321→    }
   322→  }
   323→
   324→  // ── Observations section (full mode only) ──
   325→  // AC: @cmd-session-start ac-full-sections
   326→  if (isFull && ctx.observations.length > 0) {
   327→    console.log(`\n${chalk.yellow.bold("--- Observations (unresolved) ---")}`);
   328→    for (const obs of ctx.observations) {
   329→      const obsAge = formatRelativeTime(new Date(obs.created_at));
   330→      const author = obs.author ? ` by ${obs.author}` : "";
   331→      const typeLabel = chalk.cyan(`[${obs.type}]`);
   332→      console.log(
   333→        `  ${typeLabel} ${chalk.gray(`@${obs.ref}`)} ${chalk.gray(`(${obsAge}${author})`)}`,
   334→      );
   335→      console.log(`    ${obs.content}`);
   336→    }
   337→  }
   338→
   339→  // ── Session metadata section (full mode only) ──
   340→  // AC: @cmd-session-start ac-full-sections
   341→  if (
   342→    isFull &&
   343→    ctx.context &&
   344→    ctx.context.updated_at
   345→  ) {
   346→    console.log(`\n${chalk.gray.bold("--- Session Metadata ---")}`);
   347→    console.log(
   348→      chalk.gray(
   349→        `  Last updated: ${formatRelativeTime(new Date(ctx.context.updated_at))}`,
   350→      ),
   351→    );
   352→  }
   353→
   354→  // ── Working tree section ──
   355→  // AC: @cmd-session-start ac-dirty-tree-only — only shown when dirty
   356→  if (ctx.working_tree && !ctx.working_tree.clean) {
   357→    console.log(`\n${sessionHeaders.workingTree}`);
   358→
   359→    if (ctx.working_tree.staged.length > 0) {
   360→      console.log(chalk.green("  Staged:"));
   361→      for (const file of ctx.working_tree.staged) {
   362→        console.log(
   363→          `    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`,
   364→        );
   365→      }
   366→    }
   367→
   368→    if (ctx.working_tree.unstaged.length > 0) {
   369→      console.log(chalk.red("  Modified:"));
   370→      for (const file of ctx.working_tree.unstaged) {
   371→        console.log(
   372→          `    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`,
   373→        );
   374→      }
   375→    }
   376→
   377→    if (ctx.working_tree.untracked.length > 0) {
   378→      console.log(chalk.gray("  Untracked:"));
   379→      const untrackedLimit = isFull
   380→        ? ctx.working_tree.untracked.length
   381→        : 5;
   382→      for (const filePath of ctx.working_tree.untracked.slice(
   383→        0,
   384→        untrackedLimit,
   385→      )) {
   386→        console.log(`    ${chalk.gray("?")} ${filePath}`);
   387→      }
   388→      if (!isFull && ctx.working_tree.untracked.length > untrackedLimit) {
   389→        console.log(
   390→          chalk.gray(
   391→            `    ... and ${ctx.working_tree.untracked.length - untrackedLimit} more`,
   392→          ),
   393→        );
   394→      }
   395→    }
   396→  }
   397→
   398→  // ── Quick Commands section ──
   399→  const quickCommands: string[] = [];
   400→
   401→  if (ctx.active_tasks.length > 0) {
   402→    const ref = getDisplayRef(ctx.active_tasks[0]);
   403→    quickCommands.push(
   404→      `kspec task note ${ref} "Progress..."  ${chalk.gray("# document work")}`,
   405→    );
   406→    quickCommands.push(
   407→      `kspec task complete ${ref} --reason "..."  ${chalk.gray("# finish task")}`,
   408→    );
   409→  } else if (ctx.ready_tasks.length > 0) {
   410→    const ref = getDisplayRef(ctx.ready_tasks[0]);
   411→    quickCommands.push(
   412→      `kspec task start ${ref}  ${chalk.gray("# begin work")}`,
   413→    );
   414→  }
   415→
   416→  if (ctx.inbox_stats.untriaged > 0) {
   417→    quickCommands.push(
   418→      `kspec triage inbox  ${chalk.gray("# triage untriaged inbox items")}`,
   419→    );
   420→  }
   421→
   422→  if (ctx.working_tree && !ctx.working_tree.clean) {
   423→    quickCommands.push(
   424→      `git add . && git commit -m "..."  ${chalk.gray("# commit changes")}`,
   425→    );
   426→  }
   427→
   428→  if (quickCommands.length > 0) {
   429→    console.log(`\n${sessionHeaders.quickCommands}`);
   430→    for (const hint of quickCommands) {
   431→      console.log(`  ${hint}`);
   432→    }
   433→  }
   434→
   435→  console.log(""); // Final newline
   436→}
   437→
   438→// ─── Activity Timeline Formatting ───────────────────────────────────────────
   439→
   440→/**
   441→ * Format the activity timeline section with hierarchical grouping.
   442→ * AC: @session-start-activity-timeline ac-activity-hierarchy, ac-activity-dedup
   443→ */
   444→function formatActivityTimeline(
   445→  timeline: SessionStartContext["activity_timeline"],
   446→  isFull: boolean,
   447→): void {
   448→  console.log(`\n${sessionHeaders.recentActivity}`);
   449→  const observationPromotedTasks: string[] = [];
   450→
   451→  // AC: @session-start-activity-timeline ac-activity-hierarchy, ac-activity-dedup
   452→  // Group linked commits by task, then interleave with standalone entries
   453→  type ActivityGroup =
   454→    | {
   455→        kind: "task_group";
   456→        task: CompletedTaskSummary;
   457→        commits: Array<{ commit: CommitSummary; date: string }>;
   458→        sortDate: string;
   459→      }
   460→    | { kind: "task_completion"; task: CompletedTaskSummary; date: string }
   461→    | { kind: "orphan_commit"; commit: CommitSummary; date: string };
   462→
   463→  const taskGroups = new Map<
   464→    string,
   465→    {
   466→      task: CompletedTaskSummary;
   467→      commits: Array<{ commit: CommitSummary; date: string }>;
   468→      sortDate: string;
   469→    }
   470→  >();
   471→  const groups: ActivityGroup[] = [];
   472→
   473→  for (const item of timeline) {
   474→    if (item.type === "linked_commit") {
   475→      const key = item.task.ref;
   476→      let group = taskGroups.get(key);
   477→      if (!group) {
   478→        group = { task: item.task, commits: [], sortDate: item.date };
   479→        taskGroups.set(key, group);
   480→      }
   481→      group.commits.push({ commit: item.commit, date: item.commit.date });
   482→      // Update sortDate to the most recent event in the group
   483→      if (
   484→        new Date(item.date).getTime() > new Date(group.sortDate).getTime()
   485→      ) {
   486→        group.sortDate = item.date;
   487→      }
   488→    } else if (item.type === "task_completion") {
   489→      groups.push({ kind: "task_completion", task: item.task, date: item.date });
   490→    } else if (item.type === "commit") {
   491→      groups.push({ kind: "orphan_commit", commit: item.commit, date: item.date });
   492→    }
   493→  }
   494→
   495→  // Add task groups to the groups array
   496→  for (const group of taskGroups.values()) {
   497→    // AC: @session-start-activity-timeline ac-activity-sort
   498→    // Sort commits within a group chronologically (oldest first)
   499→    group.commits.sort(
   500→      (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime(),
   501→    );
   502→    groups.push({ kind: "task_group", ...group });
   503→  }
   504→
   505→  // AC: @session-start-activity-timeline ac-activity-sort
   506→  // Sort groups by most recent event, most recent first
   507→  groups.sort(
   508→    (a, b) =>
   509→      new Date(b.kind === "task_group" ? b.sortDate : b.date).getTime() -
   510→      new Date(a.kind === "task_group" ? a.sortDate : a.date).getTime(),
   511→  );
   512→
   513→  for (const group of groups) {
   514→    if (group.kind === "task_completion") {
   515→      // Standalone completed task (not linked to any commit)
   516→      let reason = "";
   517→      if (group.task.closed_reason) {
   518→        const maxLen = isFull ? 120 : 60;
   519→        const truncated =
   520→          group.task.closed_reason.length > maxLen
   521→            ? `${group.task.closed_reason.slice(0, maxLen).trim()}...`
   522→            : group.task.closed_reason;
   523→        reason = chalk.gray(` - ${truncated}`);
   524→      }
   525→      // AC: @cmd-session-start ac-slug-display
   526→      const taskDisplay = getDisplayRef(group.task);
   527→      // AC: @cmd-session-start ac-relative-time-human
   528→      const itemAge = formatRelativeTime(new Date(group.date));
   529→      console.log(
   530→        `  ${chalk.green("✓")} ${taskDisplay} ${group.task.title} ${chalk.gray(`(${itemAge})`)}${reason}`,
   531→      );
   532→      if (group.task.origin === "observation_promotion") {
   533→        observationPromotedTasks.push(taskDisplay);
   534→      }
   535→    } else if (group.kind === "task_group") {
   536→      // AC: @session-start-activity-timeline ac-activity-hierarchy, ac-activity-trailer-link
   537→      // Task as top-level entry with linked commits nested beneath
   538→      const taskDisplay = getDisplayRef(group.task);
   539→      const groupAge = formatRelativeTime(new Date(group.sortDate));
   540→      console.log(
   541→        `  ${chalk.green("✓")} ${taskDisplay} ${group.task.title} ${chalk.gray(`(${groupAge})`)}`,
   542→      );
   543→      if (group.task.origin === "observation_promotion") {
   544→        observationPromotedTasks.push(taskDisplay);
   545→      }
   546→      // Render nested commits with visual connectors
   547→      for (let i = 0; i < group.commits.length; i++) {
   548→        const { commit, date } = group.commits[i];
   549→        const isLast = i === group.commits.length - 1;
   550→        const connector = isLast ? "└─" : "├─";
   551→        const commitAge = formatRelativeTime(new Date(date));
   552→        console.log(
   553→          `    ${chalk.gray(connector)} ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${commitAge}, ${commit.author})`)}`,
   554→        );
   555→      }
   556→    } else if (group.kind === "orphan_commit") {
   557→      // AC: @session-start-activity-timeline ac-activity-orphan
   558→      // Orphan commit: visually distinct from task entries
   559→      const commitAge = formatRelativeTime(new Date(group.date));
   560→      console.log(
   561→        `  ${chalk.gray("○")} ${chalk.yellow(group.commit.hash)} ${group.commit.message} ${chalk.gray(`(${commitAge}, ${group.commit.author})`)}`,
   562→      );
   563→    }
   564→  }
   565→
   566→  // Show reminder about resolving observations
   567→  if (observationPromotedTasks.length > 0) {
   568→    console.log(
   569→      chalk.yellow(
   570→        `\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(", ")}`,
   571→      ),
   572→    );
   573→    console.log(
   574→      chalk.gray(`    Run: kspec meta observations --pending-resolution`),
   575→    );
   576→  }
   577→}
   578→