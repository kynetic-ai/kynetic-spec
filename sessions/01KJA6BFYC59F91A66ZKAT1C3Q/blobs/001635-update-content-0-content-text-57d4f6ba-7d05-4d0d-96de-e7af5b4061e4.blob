   529→  // AC: @cmd-session-start ac-notes-starvation
   530→  describe('notes starvation prevention', () => {
   531→    it('should include notes from all statuses in JSON', { timeout: 20000 }, () => {
   532→      // Create in_progress tasks with many notes
   533→      for (let i = 1; i <= 5; i++) {
   534→        kspec(`task add --title "Active ${i}" --slug active-${i}`, tempDir);
   535→        kspec(`task start @active-${i}`, tempDir);
   536→        kspec(`task note @active-${i} "Active note ${i}"`, tempDir);
   537→      }
   538→
   539→      // Create pending_review task
   540→      kspec('task add --title "Review" --slug review-task', tempDir);
   541→      kspec('task start @review-task', tempDir);
   542→      kspec('task note @review-task "Review note"', tempDir);
   543→      kspec('task submit @review-task', tempDir);
   544→
   545→      // Create completed task
   546→      kspec('task add --title "Done" --slug done-task', tempDir);
   547→      kspec('task start @done-task', tempDir);
   548→      kspec('task note @done-task "Done note"', tempDir);
   549→      kspec('task submit @done-task', tempDir);
   550→      kspec('task complete @done-task --reason "Finished"', tempDir);
   551→
   552→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   553→
   554→      const inProgressNotes = session.recent_notes.filter(
   555→        (n) => n.task_status === 'in_progress',
   556→      );
   557→      const reviewNotes = session.recent_notes.filter(
   558→        (n) => n.task_status === 'pending_review',
   559→      );
   560→      const completedNotes = session.recent_notes.filter(
   561→        (n) => n.task_status === 'completed',
   562→      );
   563→
   564→      // Each status should have at least one note (not starved)
   565→      expect(inProgressNotes.length).toBeGreaterThan(0);
   566→      expect(reviewNotes.length).toBeGreaterThan(0);
   567→      expect(completedNotes.length).toBeGreaterThan(0);
   568→    });
   569→  });
