   512→  });
   513→
   514→  // AC: @cmd-session-start ac-review-detail
   515→  describe('review task detail', () => {
   516→    it('should show title and recent notes for pending_review tasks', () => {
   517→      kspec('task add --title "Review this" --slug review-this', tempDir);
   518→      kspec('task start @review-this', tempDir);
   519→      kspec('task note @review-this "Implementation complete, PR #100"', tempDir);
   520→      kspec('task submit @review-this', tempDir);
   521→
   522→      const result = kspec('session start', tempDir);
