   445→      const result = kspec('session start', tempDir);
   446→      expect(result.stdout).toContain('My big feature');
   447→      expect(result.stdout).toContain('Building the next big thing');
   448→    });
   449→
   450→    it('should show recent notes inline under active tasks', () => {
   451→      kspec('task add --title "Active task" --slug active-task', tempDir);
   452→      kspec('task start @active-task', tempDir);
   453→      kspec('task note @active-task "Working on the implementation"', tempDir);
   454→
   455→      const result = kspec('session start', tempDir);
   456→      expect(result.stdout).toContain('Active Work');
   457→      expect(result.stdout).toContain('Working on the implementation');
