   472→  });
   473→
   474→  // AC: @cmd-session-start ac-needs-work-indicator
   475→  describe('needs_work visual distinction', () => {
   476→    it('should display [needs_work] label for needs_work tasks', () => {
   477→      kspec('task add --title "Fix task" --slug fix-task', tempDir);
   478→      kspec('task start @fix-task', tempDir);
   479→      kspec('task submit @fix-task', tempDir);
   480→      kspec('task needs-work @fix-task --reason "Failing tests"', tempDir);
   481→
   482→      const result = kspec('session start', tempDir);
   483→      expect(result.stdout).toContain('[needs_work]');
   484→      expect(result.stdout).toContain('Fix task');
   485→    });
   486→
   487→    it('should include needs_work status in JSON', () => {
   488→      kspec('task add --title "Fix task" --slug fix-task', tempDir);
   489→      kspec('task start @fix-task', tempDir);
   490→      kspec('task submit @fix-task', tempDir);
   491→      kspec('task needs-work @fix-task --reason "Failing tests"', tempDir);
   492→
   493→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   494→      const task = session.active_tasks.find((t) => t.slug === 'fix-task');
   495→      expect(task).toBeDefined();
   496→      expect(task!.status).toBe('needs_work');
   497→    });
   498→
   499→    it('should distinguish needs_work from in_progress in same output', () => {
   500→      kspec('task add --title "Normal task" --slug normal-task', tempDir);
   501→      kspec('task start @normal-task', tempDir);
   502→
   503→      kspec('task add --title "Fix task" --slug fix-task', tempDir);
   504→      kspec('task start @fix-task', tempDir);
   505→      kspec('task submit @fix-task', tempDir);
   506→      kspec('task needs-work @fix-task --reason "Failing tests"', tempDir);
   507→
   508→      const result = kspec('session start', tempDir);
   509→      expect(result.stdout).toContain('[in_progress]');
   510→      expect(result.stdout).toContain('[needs_work]');
