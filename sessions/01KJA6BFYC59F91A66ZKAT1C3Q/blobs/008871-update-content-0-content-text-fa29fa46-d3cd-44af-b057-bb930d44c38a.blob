```
     1→/**
     2→ * Session context data gathering.
     3→ *
     4→ * Loads and aggregates all data needed for session start output.
     5→ */
     6→
     7→import {
     8→  getReadyTasks,
     9→  type KspecContext,
    10→  type LoadedTask,
    11→  loadAllItems,
    12→  loadAllTasks,
    13→  loadInboxItems,
    14→  loadSessionContext,
    15→  loadTriageRecords,
    16→  ReferenceIndex,
    17→} from "../../../parser/index.js";
    18→import { loadMetaContext } from "../../../parser/meta.js";
    19→import {
    20→  type GitWorkingTree,
    21→  getCurrentBranch,
    22→  getRecentCommits,
    23→  getWorkingTreeStatus,
    24→  isGitRepo,
    25→  parseTimeSpec,
    26→} from "../../../utils/index.js";
    27→import { isNoteSuperseded } from "../../output.js";
    28→import type {
    29→  ActiveTaskSummary,
    30→  ActivityItem,
    31→  BlockedTaskSummary,
    32→  CommitSummary,
    33→  CompletedTaskSummary,
    34→  InboxStats,
    35→  InboxSummary,
    36→  IterationStats,
    37→  NoteSummary,
    38→  ObservationSummary,
    39→  ReadyTaskSummary,
    40→  SessionContext,
    41→  SessionContextComputed,
    42→  SessionOptions,
    43→  SessionStats,
    44→  TodoSummary,
    45→} from "./types.js";
    46→
    47→// ─── Mapper Functions ───────────────────────────────────────────────────────
    48→
    49→/**
    50→ * Build a reverse dependency map: for each task ULID, count how many
    51→ * pending tasks depend on it. Unresolvable refs are silently skipped.
    52→ */
    53→function computeUnlocksMap(
    54→  allTasks: LoadedTask[],
    55→  index: ReferenceIndex,
    56→): Map<string, number> {
    57→  const counts = new Map<string, number>();
    58→
    59→  for (const task of allTasks) {
    60→    // Only count pending tasks as "unlockable" downstream work per spec
    61→    if (task.status !== "pending") continue;
    62→
    63→    for (const depRef of task.depends_on) {
    64→      const result = index.resolve(depRef);
    65→      if (!result.ok) continue; // AC: unresolvable refs silently skipped
    66→      const depUlid = result.item._ulid;
    67→      counts.set(depUlid, (counts.get(depUlid) || 0) + 1);
    68→    }
    69→  }
    70→
    71→  return counts;
    72→}
    73→
    74→function toActiveTaskSummary(
    75→  task: LoadedTask,
    76→  index: ReferenceIndex,
    77→): ActiveTaskSummary {
    78→  const lastNote =
    79→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
    80→  const incompleteTodos = task.todos.filter((t) => !t.done).length;
    81→  return {
    82→    ref: index.shortUlid(task._ulid),
    83→    slug: task.slugs.length > 0 ? task.slugs[0] : null,
    84→    title: task.title,
    85→    description: task.description || null,
    86→    status: task.status as "in_progress" | "needs_work" | "pending_review",
    87→    started_at: task.started_at || null,
    88→    priority: task.priority,
    89→    spec_ref: task.spec_ref || null,
    90→    note_count: task.notes.length,
    91→    last_note_at: lastNote ? lastNote.created_at : null,
    92→    todo_count: task.todos.length,
    93→    incomplete_todos: incompleteTodos,
    94→  };
    95→}
    96→
    97→function toReadyTaskSummary(
    98→  task: LoadedTask,
    99→  index: ReferenceIndex,
   100→  unlocksMap: Map<string, number>,
   101→): ReadyTaskSummary {
   102→  return {
   103→    ref: index.shortUlid(task._ulid),
   104→    slug: task.slugs.length > 0 ? task.slugs[0] : null,
   105→    title: task.title,
   106→    description: task.description || null,
   107→    priority: task.priority,
   108→    spec_ref: task.spec_ref || null,
   109→    tags: task.tags,
   110→    unlocks: unlocksMap.get(task._ulid) || 0,
   111→  };
   112→}
   113→
   114→function toBlockedTaskSummary(
   115→  task: LoadedTask,
   116→  index: ReferenceIndex,
   117→  unlocksMap: Map<string, number>,
   118→): BlockedTaskSummary {
   119→  // Find unmet dependencies
   120→  const unmetDeps: string[] = [];
   121→  for (const depRef of task.depends_on) {
   122→    const result = index.resolve(depRef);
   123→    if (result.ok) {
   124→      const depItem = result.item;
   125→      if ("status" in depItem && depItem.status !== "completed") {
   126→        unmetDeps.push(depRef);
   127→      }
   128→    }
   129→  }
   130→
   131→  return {
   132→    ref: index.shortUlid(task._ulid),
   133→    slug: task.slugs.length > 0 ? task.slugs[0] : null,
   134→    title: task.title,
   135→    description: task.description || null,
   136→    blocked_by: task.blocked_by,
   137→    unmet_deps: unmetDeps,
   138→    unlocks: unlocksMap.get(task._ulid) || 0,
   139→  };
   140→}
   141→
   142→function toCompletedTaskSummary(
   143→  task: LoadedTask,
   144→  index: ReferenceIndex,
   145→): CompletedTaskSummary {
   146→  return {
   147→    ref: index.shortUlid(task._ulid),
   148→    slug: task.slugs.length > 0 ? task.slugs[0] : null,
   149→    title: task.title,
   150→    completed_at: task.completed_at || "",
   151→    closed_reason: task.closed_reason || null,
   152→    origin: task.origin,
   153→  };
   154→}
   155→
   156→function collectRecentNotes(
   157→  tasks: LoadedTask[],
   158→  index: ReferenceIndex,
   159→  options: { limit: number | undefined; since: Date | null },
   160→): NoteSummary[] {
   161→  const allNotes: NoteSummary[] = [];
   162→
   163→  for (const task of tasks) {
   164→    // Only include notes from in_progress, pending_review, or completed tasks
   165→    const taskStatus = task.status as "in_progress" | "pending_review" | "needs_work" | "completed";
   166→    if (!["in_progress", "pending_review", "needs_work", "completed"].includes(taskStatus)) {
   167→      continue;
   168→    }
   169→
   170→    for (const note of task.notes) {
   171→      const noteDate = new Date(note.created_at);
   172→
   173→      // Filter by since date if provided
   174→      if (options.since && noteDate < options.since) {
   175→        continue;
   176→      }
   177→
   178→      // Filter out superseded notes
   179→      if (isNoteSuperseded(note, task.notes)) {
   180→        continue;
   181→      }
   182→
   183→      allNotes.push({
   184→        task_ref: index.shortUlid(task._ulid),
   185→        task_title: task.title,
   186→        task_status: taskStatus,
   187→        note_ulid: note._ulid.slice(0, 8),
   188→        created_at: note.created_at,
   189→        author: note.author || null,
   190→        content: note.content,
   191→      });
   192→    }
   193→  }
   194→
   195→  // Sort by date descending, take limit
   196→  return allNotes
   197→    .sort(
   198→      (a, b) =>
   199→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   200→    )
   201→    .slice(0, options.limit);
   202→}
   203→
   204→function collectIncompleteTodos(
   205→  tasks: LoadedTask[],
   206→  index: ReferenceIndex,
   207→  options: { limit: number },
   208→): TodoSummary[] {
   209→  const allTodos: TodoSummary[] = [];
   210→
   211→  for (const task of tasks) {
   212→    for (const todo of task.todos) {
   213→      // Only include incomplete todos
   214→      if (todo.done) continue;
   215→
   216→      allTodos.push({
   217→        task_ref: index.shortUlid(task._ulid),
   218→        task_title: task.title,
   219→        id: todo.id,
   220→        text: todo.text,
   221→        added_at: todo.added_at,
   222→        added_by: todo.added_by || null,
   223→      });
   224→    }
   225→  }
   226→
   227→  // Sort by added_at descending (most recent first), take limit
   228→  return allTodos
   229→    .sort(
   230→      (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime(),
   231→    )
   232→    .slice(0, options.limit);
   233→}
   234→
   235→/**
   236→ * Build a unified activity timeline from completed tasks and git commits.
   237→ *
   238→ * - Commits with Task: @slug trailers are matched to completed tasks and shown
   239→ *   as combined "linked_commit" entries (AC: ac-activity-trailer-link, ac-activity-dedup)
   240→ * - Unlinked commits appear as standalone "commit" entries
   241→ * - Tasks not linked to any commit appear as standalone "task_completion" entries
   242→ * - All items sorted most recent first (AC: ac-activity-sort)
   243→ *
   244→ * @param completedTasks - Completed task summaries
   245→ * @param commits - Recent commit summaries (with task_refs parsed from trailers)
   246→ * @param taskRefResolver - Maps a trailer ref (slug or ULID prefix) to a completed task's ref (short ULID)
   247→ */
   248→function buildActivityTimeline(
   249→  completedTasks: CompletedTaskSummary[],
   250→  commits: CommitSummary[],
   251→  taskRefResolver: Map<string, string>,
   252→): ActivityItem[] {
   253→  const items: ActivityItem[] = [];
   254→
   255→  // Build lookup from short ULID ref to CompletedTaskSummary
   256→  const taskByRef = new Map<string, CompletedTaskSummary>();
   257→  for (const task of completedTasks) {
   258→    taskByRef.set(task.ref, task);
   259→  }
   260→
   261→  // Track which tasks have been linked to a commit (for dedup)
   262→  const linkedTaskRefs = new Set<string>();
   263→
   264→  for (const commit of commits) {
   265→    if (commit.task_refs.length > 0) {
   266→      let linkedTask: CompletedTaskSummary | undefined;
   267→      for (const trailerRef of commit.task_refs) {
   268→        // Resolve the trailer ref (slug or ULID) to the short ULID ref
   269→        const resolvedRef = taskRefResolver.get(trailerRef);
   270→        if (resolvedRef) {
   271→          linkedTask = taskByRef.get(resolvedRef);
   272→        }
   273→        // Also try direct match on short ULID ref
   274→        if (!linkedTask) {
   275→          linkedTask = taskByRef.get(trailerRef);
   276→        }
   277→        if (linkedTask) {
   278→          linkedTaskRefs.add(linkedTask.ref);
   279→          // Use the later of commit date and task completion date for sort accuracy
   280→          const commitTime = new Date(commit.date).getTime();
   281→          const taskTime = new Date(linkedTask.completed_at).getTime();
   282→          const laterDate =
   283→            taskTime > commitTime ? linkedTask.completed_at : commit.date;
   284→          items.push({
   285→            type: "linked_commit",
   286→            date: laterDate,
   287→            commit,
   288→            task: linkedTask,
   289→          });
   290→          break; // One linked entry per commit
   291→        }
   292→      }
   293→      if (!linkedTask) {
   294→        // Task ref in trailer but no matching completed task found
   295→        items.push({ type: "commit", date: commit.date, commit });
   296→      }
   297→    } else {
   298→      items.push({ type: "commit", date: commit.date, commit });
   299→    }
   300→  }
   301→
   302→  // Add task completions not already linked to a commit
   303→  for (const task of completedTasks) {
   304→    if (!linkedTaskRefs.has(task.ref)) {
   305→      items.push({
   306→        type: "task_completion",
   307→        date: task.completed_at,
   308→        task,
   309→      });
   310→    }
   311→  }
   312→
   313→  // AC: @session-start-activity-timeline ac-activity-sort
   314→  // Sort most recent first
   315→  items.sort(
   316→    (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
   317→  );
   318→
   319→  return items;
   320→}
   321→
   322→// ─── Main Gather Function ───────────────────────────────────────────────────
   323→
   324→/**
   325→ * Gather session context data
   326→ */
   327→export async function gatherSessionContext(
   328→  ctx: KspecContext,
   329→  options: SessionOptions,
   330→): Promise<SessionContext> {
   331→  const limit = parseInt(options.limit || "10", 10);
   332→  if (Number.isNaN(limit) || limit <= 0) {
   333→    throw new RangeError(
   334→      `Invalid limit: "${options.limit}". Must be a positive integer.`,
   335→    );
   336→  }
   337→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   338→  const showGit = options.git !== false; // default true
   339→
   340→  // Load all data
   341→  const allTasks = await loadAllTasks(ctx);
   342→  const items = await loadAllItems(ctx);
   343→  const inboxItems = await loadInboxItems(ctx);
   344→  const triageRecords = await loadTriageRecords(ctx);
   345→  const index = new ReferenceIndex(allTasks, items);
   346→
   347→  // AC: @session-start-inbox-triage ac-inbox-untriaged-def
   348→  // Build lookup: inbox ULID → triage record (most recent if multiple)
   349→  const triageByInboxRef = new Map<string, { action?: string }>();
   350→  for (const record of triageRecords) {
   351→    triageByInboxRef.set(record.inbox_ref, { action: record.action });
   352→  }
   353→
   354→  // Compute stats
   355→  const stats: SessionStats = {
   356→    total_tasks: allTasks.length,
   357→    in_progress: allTasks.filter((t) => t.status === "in_progress").length,
   358→    needs_work: allTasks.filter((t) => t.status === "needs_work").length,
   359→    pending_review: allTasks.filter((t) => t.status === "pending_review")
   360→      .length,
   361→    ready: getReadyTasks(allTasks).length,
   362→    blocked: allTasks.filter((t) => t.status === "blocked").length,
   363→    completed: allTasks.filter((t) => t.status === "completed").length,
   364→    inbox_items: inboxItems.length,
   365→  };
   366→
   367→  // Get active tasks (in_progress + needs_work, optionally filtered to automation-eligible only)
   368→  // AC: @cli-ralph ac-16
   369→  const activeTasks = allTasks
   370→    .filter((t) => t.status === "in_progress" || t.status === "needs_work")
   371→    .filter((t) => !options.eligible || t.automation === "eligible")
   372→    .sort((a, b) => a.priority - b.priority)
   373→    .slice(0, options.full ? undefined : limit)
   374→    .map((t) => toActiveTaskSummary(t, index));
   375→
   376→  // Get pending review tasks
   377→  const pendingReviewTasks = allTasks
   378→    .filter((t) => t.status === "pending_review")
   379→    .sort((a, b) => a.priority - b.priority)
   380→    .slice(0, options.full ? undefined : limit)
   381→    .map((t) => toActiveTaskSummary(t, index));
   382→
   383→  // Get recent notes from active, pending_review, and recently completed tasks
   384→  // AC: @cmd-session-start ac-1, ac-2
   385→  // Collect notes per-status first to prevent one status from starving others
   386→  // In full mode, uncap notes (consistent with other sections that use undefined in full mode).
   387→  // In non-full mode, split limit across 3 status buckets to prevent starvation.
   388→  const noteLimitPerStatus = options.full ? undefined : Math.ceil(limit / 3);
   389→
   390→  const inProgressNotes = collectRecentNotes(
   391→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   392→    index,
   393→    { limit: noteLimitPerStatus, since: sinceDate },
   394→  );
   395→
   396→  const pendingReviewNotes = collectRecentNotes(
   397→    allTasks.filter((t) => t.status === "pending_review"),
   398→    index,
   399→    { limit: noteLimitPerStatus, since: sinceDate },
   400→  );
   401→
   402→  const recentlyCompletedForNotes = allTasks
   403→    .filter((t) => t.status === "completed" && t.completed_at)
   404→    .sort((a, b) => {
   405→      const aDate = new Date(a.completed_at || 0);
   406→      const bDate = new Date(b.completed_at || 0);
   407→      return bDate.getTime() - aDate.getTime();
   408→    })
   409→    .slice(0, 5); // Last 3-5 completed tasks per AC-2
   410→
   411→  const completedNotes = collectRecentNotes(
   412→    recentlyCompletedForNotes,
   413→    index,
   414→    { limit: noteLimitPerStatus, since: sinceDate },
   415→  );
   416→
   417→  // Combine notes from all statuses, preserving representation from each.
   418→  // In non-full mode, apply final cap to handle ceil() rounding across 3 buckets.
   419→  const noteLimit = options.full ? undefined : limit;
   420→  const recentNotes = [...inProgressNotes, ...pendingReviewNotes, ...completedNotes]
   421→    .sort(
   422→      (a, b) =>
   423→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   424→    )
   425→    .slice(0, noteLimit);
   426→
   427→  // Get incomplete todos from active tasks
   428→  const activeTodos = collectIncompleteTodos(
   429→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   430→    index,
   431→    { limit: options.full ? limit * 2 : limit },
   432→  );
   433→
   434→  // Compute reverse dependency map for "unlocks N" annotations
   435→  const unlocksMap = computeUnlocksMap(allTasks, index);
   436→
   437→  // AC: @cmd-session-start ac-primer-default, ac-full-sections
   438→  // Primer: top 5 ready tasks; Full: all ready tasks
   439→  // Respect --limit as upper bound when provided
   440→  const readyLimit = options.full ? undefined : Math.min(limit, 5);
   441→  const readyTasks = getReadyTasks(allTasks)
   442→    .filter((t) => !options.eligible || t.automation === "eligible")
   443→    .slice(0, readyLimit)
   444→    .map((t) => toReadyTaskSummary(t, index, unlocksMap));
   445→
   446→  // Get blocked tasks
   447→  const blockedTasks = allTasks
   448→    .filter((t) => t.status === "blocked")
   449→    .slice(0, options.full ? undefined : limit)
   450→    .map((t) => toBlockedTaskSummary(t, index, unlocksMap));
   451→
   452→  // Get recently completed tasks
   453→  const recentlyCompleted = allTasks
   454→    .filter((t) => {
   455→      if (t.status !== "completed" || !t.completed_at) return false;
   456→      const completedDate = new Date(t.completed_at);
   457→      if (sinceDate && completedDate < sinceDate) return false;
   458→      return true;
   459→    })
   460→    .sort((a, b) => {
   461→      // Sort by completed_at descending (most recent first)
   462→      const aDate = new Date(a.completed_at || 0);
   463→      const bDate = new Date(b.completed_at || 0);
   464→      return bDate.getTime() - aDate.getTime();
   465→    })
   466→    .slice(0, options.full ? undefined : limit)
   467→    .map((t) => toCompletedTaskSummary(t, index));
   468→
   469→  // Get git info
   470→  let branch: string | null = null;
   471→  let recentCommits: CommitSummary[] = [];
   472→  let workingTree: GitWorkingTree | null = null;
   473→
   474→  if (showGit && isGitRepo(ctx.rootDir)) {
   475→    branch = getCurrentBranch(ctx.rootDir);
   476→
   477→    const commits = getRecentCommits({
   478→      limit: options.full ? limit * 2 : limit,
   479→      since: sinceDate || undefined,
   480→      cwd: ctx.rootDir,
   481→    });
   482→
   483→    recentCommits = commits.map((c) => ({
   484→      hash: c.hash,
   485→      full_hash: c.fullHash,
   486→      date: c.date.toISOString(),
   487→      message: c.message,
   488→      author: c.author,
   489→      task_refs: c.taskRefs,
   490→    }));
   491→
   492→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   493→  }
   494→
   495→  // Get inbox items with triage status (oldest first to encourage triage)
   496→  // AC: @session-start-inbox-triage ac-inbox-untriaged-def
   497→  const allInboxSummaries: InboxSummary[] = inboxItems
   498→    .sort(
   499→      (a, b) =>
   500→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   501→    )
   502→    .map((item) => {
   503→      const triageInfo = triageByInboxRef.get(item._ulid);
   504→      return {
   505→        ref: item._ulid.slice(0, 8),
   506→        text: item.text,
   507→        created_at: item.created_at,
   508→        tags: item.tags,
   509→        added_by: item.added_by || null,
   510→        triaged: !!triageInfo,
   511→        triage_action: triageInfo?.action ?? null,
   512→      };
   513→    });
   514→
   515→  // AC: @session-start-inbox-triage ac-inbox-stat-line, ac-inbox-all-triaged
   516→  const inboxStats: InboxStats = {
   517→    total: allInboxSummaries.length,
   518→    untriaged: allInboxSummaries.filter((i) => !i.triaged).length,
   519→    deferred: allInboxSummaries.filter((i) => i.triage_action === "defer")
   520→      .length,
   521→    triaged: allInboxSummaries.filter((i) => i.triaged).length,
   522→  };
   523→
   524→  // JSON always gets full list with triage status; human display filters in formatSessionContext
   525→  const inboxSummaries: InboxSummary[] = allInboxSummaries;
   526→
   527→  // Load session context (focus, threads, questions)
   528→  const sessionContext = await loadSessionContext(ctx);
   529→
   530→  // Build task ref resolver for activity timeline: maps slug/ULID to short ref
   531→  // This allows commits with Task: @task-slug trailers to match completed tasks
   532→  const taskRefResolver = new Map<string, string>();
   533→  for (const task of allTasks) {
   534→    if (task.status !== "completed") continue;
   535→    const shortRef = index.shortUlid(task._ulid);
   536→    // Map each slug to the short ref
   537→    for (const slug of task.slugs) {
   538→      taskRefResolver.set(slug, shortRef);
   539→    }
   540→    // Also map the full ULID and short ULID to itself
   541→    taskRefResolver.set(task._ulid, shortRef);
   542→    taskRefResolver.set(shortRef, shortRef);
   543→  }
   544→
   545→  // Build unified activity timeline
   546→  // AC: @session-start-activity-timeline ac-activity-merge
   547→  // AC: @cmd-session-start ac-primer-default, ac-full-sections
   548→  // Primer: 10 items; Full: 20 items
   549→  // Respect --limit as upper bound when provided
   550→  const activityLimit = options.full ? Math.min(limit * 2, 20) : Math.min(limit, 10);
   551→  const activityTimeline = buildActivityTimeline(
   552→    recentlyCompleted,
   553→    recentCommits,
   554→    taskRefResolver,
   555→  ).slice(0, activityLimit);
   556→
   557→  // AC: @cmd-session-start ac-full-sections — observations section (full mode only)
   558→  let observations: ObservationSummary[] = [];
   559→  if (options.full) {
   560→    const metaCtx = await loadMetaContext(ctx);
   561→    observations = metaCtx.observations
   562→      .filter((o) => !o.resolved)
   563→      .sort(
   564→        (a, b) =>
   565→          new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   566→      )
   567→      .map((o) => ({
   568→        ref: o._ulid.slice(0, 8),
   569→        type: o.type,
   570→        content: o.content,
   571→        created_at: o.created_at,
   572→        author: o.author || null,
   573→        resolved: o.resolved,
   574→        workflow_ref: o.workflow_ref || null,
   575→      }));
   576→  }
   577→
   578→  // AC: @session-start-computed-json ac-computed-unlocks
   579→  // Build task_unlocks map: short ULID ref → count of pending dependents
   580→  const taskUnlocks: Record<string, number> = {};
   581→  for (const [taskUlid, count] of unlocksMap) {
   582→    if (count > 0) {
   583→      taskUnlocks[index.shortUlid(taskUlid)] = count;
   584→    }
   585→  }
   586→
   587→  // AC: @session-start-computed-json ac-computed-inbox, ac-computed-unlocks, ac-computed-activity
   588→  const computed: SessionContextComputed = {
   589→    inbox_untriaged_count: inboxStats.untriaged,
   590→    inbox_deferred_count: inboxStats.deferred,
   591→    inbox_total: inboxStats.total,
   592→    task_unlocks: taskUnlocks,
   593→    recent_activity: activityTimeline,
   594→  };
   595→
   596→  return {
   597→    generated_at: new Date().toISOString(),
   598→    branch,
   599→    context: sessionContext,
   600→    active_tasks: activeTasks,
   601→    pending_review_tasks: pendingReviewTasks,
   602→    recent_notes: recentNotes,
   603→    active_todos: activeTodos,
   604→    ready_tasks: readyTasks,
   605→    blocked_tasks: blockedTasks,
   606→    recently_completed: recentlyCompleted,
   607→    recent_commits: recentCommits,
   608→    activity_timeline: activityTimeline,
   609→    working_tree: workingTree,
   610→    inbox_items: inboxSummaries,
   611→    inbox_stats: inboxStats,
   612→    observations,
   613→    stats,
   614→    computed,
   615→  };
   616→}
   617→
   618→// ─── Iteration Stats ────────────────────────────────────────────────────────
   619→
   620→/**
   621→ * Get iteration stats - tasks completed/started since a given time.
   622→ * AC: @ralph-task-limit ac-detection
   623→ */
   624→export async function getIterationStats(
   625→  ctx: KspecContext,
   626→  since: Date,
   627→): Promise<IterationStats> {
   628→  const allTasks = await loadAllTasks(ctx);
   629→
   630→  // Count both completed and pending_review (submitted) tasks toward the limit.
   631→  // Submit means the agent's work is done — it should count the same as complete.
   632→  // AC: @ralph-task-limit ac-detection
   633→  const completedSince = allTasks.filter((t) => {
   634→    if (t.status === "completed" && t.completed_at) {
   635→      return new Date(t.completed_at) >= since;
   636→    }
   637→    if (t.status === "pending_review" && t.submitted_at) {
   638→      return new Date(t.submitted_at) >= since;
   639→    }
   640→    return false;
   641→  });
   642→
   643→  const startedSince = allTasks.filter((t) => {
   644→    if (!t.started_at) return false;
   645→    return new Date(t.started_at) >= since;
   646→  });
   647→
   648→  // Use first slug or ULID prefix as ref
   649→  const getRef = (t: LoadedTask) =>
   650→    t.slugs.length > 0 ? `@${t.slugs[0]}` : `@${t._ulid.slice(0, 8)}`;
   651→
   652→  return {
   653→    tasks_completed: completedSince.length,
   654→    tasks_started: startedSince.length,
   655→    completed_refs: completedSince.map(getRef),
   656→  };
   657→}
   658→
```