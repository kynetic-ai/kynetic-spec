     1→/**
     2→ * Session context data gathering.
     3→ *
     4→ * Loads and aggregates all data needed for session start output.
     5→ */
     6→
     7→import {
     8→  getReadyTasks,
     9→  type KspecContext,
    10→  type LoadedTask,
    11→  loadAllItems,
    12→  loadAllTasks,
    13→  loadInboxItems,
    14→  loadSessionContext,
    15→  loadTriageRecords,
    16→  ReferenceIndex,
    17→} from "../../../parser/index.js";
    18→import { loadMetaContext } from "../../../parser/meta.js";
    19→import {
    20→  type GitWorkingTree,
    21→  getCurrentBranch,
    22→  getRecentCommits,
    23→  getWorkingTreeStatus,
    24→  isGitRepo,
    25→  parseTimeSpec,
    26→} from "../../../utils/index.js";
    27→import { isNoteSuperseded } from "../../output.js";
    28→import type {
    29→  ActiveTaskSummary,
    30→  ActivityItem,
    31→  BlockedTaskSummary,
    32→  CommitSummary,
    33→  CompletedTaskSummary,
    34→  InboxStats,
    35→  InboxSummary,
    36→  IterationStats,
    37→  NoteSummary,
    38→  ObservationSummary,
    39→  ReadyTaskSummary,
    40→  SessionContext,
    41→  SessionContextComputed,
    42→  SessionOptions,
    43→  SessionStats,
    44→  TodoSummary,
    45→} from "./types.js";
    46→
    47→// ─── Mapper Functions ───────────────────────────────────────────────────────
    48→
    49→/**
    50→ * Build a reverse dependency map: for each task ULID, count how many
    51→ * pending tasks depend on it. Unresolvable refs are silently skipped.
    52→ */
    53→function computeUnlocksMap(
    54→  allTasks: LoadedTask[],
    55→  index: ReferenceIndex,
    56→): Map<string, number> {
    57→  const counts = new Map<string, number>();
    58→
    59→  for (const task of allTasks) {
    60→    // Only count pending tasks as "unlockable" downstream work per spec
    61→    if (task.status !== "pending") continue;
    62→
    63→    for (const depRef of task.depends_on) {
    64→      const result = index.resolve(depRef);
    65→      if (!result.ok) continue; // AC: unresolvable refs silently skipped
    66→      const depUlid = result.item._ulid;
    67→      counts.set(depUlid, (counts.get(depUlid) || 0) + 1);
    68→    }
    69→  }
    70→
    71→  return counts;
    72→}
    73→
    74→function toActiveTaskSummary(
    75→  task: LoadedTask,
    76→  index: ReferenceIndex,
    77→): ActiveTaskSummary {
    78→  const lastNote =
    79→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
    80→  const incompleteTodos = task.todos.filter((t) => !t.done).length;
    81→  return {
    82→    ref: index.shortUlid(task._ulid),
    83→    slug: task.slugs.length > 0 ? task.slugs[0] : null,
    84→    title: task.title,
    85→    description: task.description || null,
    86→    status: task.status as "in_progress" | "needs_work" | "pending_review",
    87→    started_at: task.started_at || null,
    88→    priority: task.priority,
    89→    spec_ref: task.spec_ref || null,
    90→    note_count: task.notes.length,
    91→    last_note_at: lastNote ? lastNote.created_at : null,
    92→    todo_count: task.todos.length,
    93→    incomplete_todos: incompleteTodos,
    94→  };
    95→}
    96→
    97→function toReadyTaskSummary(
    98→  task: LoadedTask,
    99→  index: ReferenceIndex,
   100→  unlocksMap: Map<string, number>,
   101→): ReadyTaskSummary {
   102→  return {
   103→    ref: index.shortUlid(task._ulid),
   104→    slug: task.slugs.length > 0 ? task.slugs[0] : null,
   105→    title: task.title,
   106→    description: task.description || null,
   107→    priority: task.priority,
   108→    spec_ref: task.spec_ref || null,
   109→    tags: task.tags,
   110→    unlocks: unlocksMap.get(task._ulid) || 0,
   111→  };
   112→}
   113→
   114→function toBlockedTaskSummary(
   115→  task: LoadedTask,
   116→  index: ReferenceIndex,
   117→  unlocksMap: Map<string, number>,
   118→): BlockedTaskSummary {
   119→  // Find unmet dependencies
   120→  const unmetDeps: string[] = [];
   121→  for (const depRef of task.depends_on) {
   122→    const result = index.resolve(depRef);
   123→    if (result.ok) {
   124→      const depItem = result.item;
   125→      if ("status" in depItem && depItem.status !== "completed") {
   126→        unmetDeps.push(depRef);
   127→      }
   128→    }
   129→  }
   130→
   131→  return {
   132→    ref: index.shortUlid(task._ulid),
   133→    slug: task.slugs.length > 0 ? task.slugs[0] : null,
   134→    title: task.title,
   135→    description: task.description || null,
   136→    blocked_by: task.blocked_by,
   137→    unmet_deps: unmetDeps,
   138→    unlocks: unlocksMap.get(task._ulid) || 0,
   139→  };
   140→}
   141→
   142→function toCompletedTaskSummary(
   143→  task: LoadedTask,
   144→  index: ReferenceIndex,
   145→): CompletedTaskSummary {
   146→  return {
   147→    ref: index.shortUlid(task._ulid),
   148→    slug: task.slugs.length > 0 ? task.slugs[0] : null,
   149→    title: task.title,
   150→    completed_at: task.completed_at || "",
   151→    closed_reason: task.closed_reason || null,
   152→    origin: task.origin,
   153→  };
   154→}
   155→
   156→function collectRecentNotes(
   157→  tasks: LoadedTask[],
   158→  index: ReferenceIndex,
   159→  options: { limit: number; since: Date | null },
   160→): NoteSummary[] {
   161→  const allNotes: NoteSummary[] = [];
   162→
   163→  for (const task of tasks) {
   164→    // Only include notes from in_progress, pending_review, or completed tasks
   165→    const taskStatus = task.status as "in_progress" | "pending_review" | "needs_work" | "completed";
   166→    if (!["in_progress", "pending_review", "needs_work", "completed"].includes(taskStatus)) {
   167→      continue;
   168→    }
   169→
   170→    for (const note of task.notes) {
   171→      const noteDate = new Date(note.created_at);
   172→
   173→      // Filter by since date if provided
   174→      if (options.since && noteDate < options.since) {
   175→        continue;
   176→      }
   177→
   178→      // Filter out superseded notes
   179→      if (isNoteSuperseded(note, task.notes)) {
   180→        continue;
   181→      }
   182→
   183→      allNotes.push({
   184→        task_ref: index.shortUlid(task._ulid),
   185→        task_title: task.title,
   186→        task_status: taskStatus,
   187→        note_ulid: note._ulid.slice(0, 8),
   188→        created_at: note.created_at,
   189→        author: note.author || null,
   190→        content: note.content,
   191→      });
   192→    }
   193→  }
   194→
   195→  // Sort by date descending, take limit
   196→  return allNotes
   197→    .sort(
   198→      (a, b) =>
   199→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   200→    )
   201→    .slice(0, options.limit);
   202→}
   203→
   204→function collectIncompleteTodos(
   205→  tasks: LoadedTask[],
   206→  index: ReferenceIndex,
   207→  options: { limit: number },
   208→): TodoSummary[] {
   209→  const allTodos: TodoSummary[] = [];
   210→
   211→  for (const task of tasks) {
   212→    for (const todo of task.todos) {
   213→      // Only include incomplete todos
   214→      if (todo.done) continue;
   215→
   216→      allTodos.push({
   217→        task_ref: index.shortUlid(task._ulid),
   218→        task_title: task.title,
   219→        id: todo.id,
   220→        text: todo.text,
   221→        added_at: todo.added_at,
   222→        added_by: todo.added_by || null,
   223→      });
   224→    }
   225→  }
   226→
   227→  // Sort by added_at descending (most recent first), take limit
   228→  return allTodos
   229→    .sort(
   230→      (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime(),
   231→    )
   232→    .slice(0, options.limit);
   233→}
   234→
   235→/**
   236→ * Build a unified activity timeline from completed tasks and git commits.
   237→ *
   238→ * - Commits with Task: @slug trailers are matched to completed tasks and shown
   239→ *   as combined "linked_commit" entries (AC: ac-activity-trailer-link, ac-activity-dedup)
   240→ * - Unlinked commits appear as standalone "commit" entries
   241→ * - Tasks not linked to any commit appear as standalone "task_completion" entries
   242→ * - All items sorted most recent first (AC: ac-activity-sort)
   243→ *
   244→ * @param completedTasks - Completed task summaries
   245→ * @param commits - Recent commit summaries (with task_refs parsed from trailers)
   246→ * @param taskRefResolver - Maps a trailer ref (slug or ULID prefix) to a completed task's ref (short ULID)
   247→ */
   248→function buildActivityTimeline(
   249→  completedTasks: CompletedTaskSummary[],
   250→  commits: CommitSummary[],
   251→  taskRefResolver: Map<string, string>,
   252→): ActivityItem[] {
   253→  const items: ActivityItem[] = [];
   254→
   255→  // Build lookup from short ULID ref to CompletedTaskSummary
   256→  const taskByRef = new Map<string, CompletedTaskSummary>();
   257→  for (const task of completedTasks) {
   258→    taskByRef.set(task.ref, task);
   259→  }
   260→
   261→  // Track which tasks have been linked to a commit (for dedup)
   262→  const linkedTaskRefs = new Set<string>();
   263→
   264→  for (const commit of commits) {
   265→    if (commit.task_refs.length > 0) {
   266→      let linkedTask: CompletedTaskSummary | undefined;
   267→      for (const trailerRef of commit.task_refs) {
   268→        // Resolve the trailer ref (slug or ULID) to the short ULID ref
   269→        const resolvedRef = taskRefResolver.get(trailerRef);
   270→        if (resolvedRef) {
   271→          linkedTask = taskByRef.get(resolvedRef);
   272→        }
   273→        // Also try direct match on short ULID ref
   274→        if (!linkedTask) {
   275→          linkedTask = taskByRef.get(trailerRef);
   276→        }
   277→        if (linkedTask) {
   278→          linkedTaskRefs.add(linkedTask.ref);
   279→          // Use the later of commit date and task completion date for sort accuracy
   280→          const commitTime = new Date(commit.date).getTime();
   281→          const taskTime = new Date(linkedTask.completed_at).getTime();
   282→          const laterDate =
   283→            taskTime > commitTime ? linkedTask.completed_at : commit.date;
   284→          items.push({
   285→            type: "linked_commit",
   286→            date: laterDate,
   287→            commit,
   288→            task: linkedTask,
   289→          });
   290→          break; // One linked entry per commit
   291→        }
   292→      }
   293→      if (!linkedTask) {
   294→        // Task ref in trailer but no matching completed task found
   295→        items.push({ type: "commit", date: commit.date, commit });
   296→      }
   297→    } else {
   298→      items.push({ type: "commit", date: commit.date, commit });
   299→    }
   300→  }
   301→
   302→  // Add task completions not already linked to a commit
   303→  for (const task of completedTasks) {
   304→    if (!linkedTaskRefs.has(task.ref)) {
   305→      items.push({
   306→        type: "task_completion",
   307→        date: task.completed_at,
   308→        task,
   309→      });
   310→    }
   311→  }
   312→
   313→  // AC: @session-start-activity-timeline ac-activity-sort
   314→  // Sort most recent first
   315→  items.sort(
   316→    (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
   317→  );
   318→
   319→  return items;
   320→}
   321→
   322→// ─── Main Gather Function ───────────────────────────────────────────────────
   323→
   324→/**
   325→ * Gather session context data
   326→ */
   327→export async function gatherSessionContext(
   328→  ctx: KspecContext,
   329→  options: SessionOptions,
   330→): Promise<SessionContext> {
   331→  const limit = parseInt(options.limit || "10", 10);
   332→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   333→  const showGit = options.git !== false; // default true
   334→
   335→  // Load all data
   336→  const allTasks = await loadAllTasks(ctx);
   337→  const items = await loadAllItems(ctx);
   338→  const inboxItems = await loadInboxItems(ctx);
   339→  const triageRecords = await loadTriageRecords(ctx);
   340→  const index = new ReferenceIndex(allTasks, items);
   341→
   342→  // AC: @session-start-inbox-triage ac-inbox-untriaged-def
   343→  // Build lookup: inbox ULID → triage record (most recent if multiple)
   344→  const triageByInboxRef = new Map<string, { action?: string }>();
   345→  for (const record of triageRecords) {
   346→    triageByInboxRef.set(record.inbox_ref, { action: record.action });
   347→  }
   348→
   349→  // Compute stats
   350→  const stats: SessionStats = {
   351→    total_tasks: allTasks.length,
   352→    in_progress: allTasks.filter((t) => t.status === "in_progress").length,
   353→    needs_work: allTasks.filter((t) => t.status === "needs_work").length,
   354→    pending_review: allTasks.filter((t) => t.status === "pending_review")
   355→      .length,
   356→    ready: getReadyTasks(allTasks).length,
   357→    blocked: allTasks.filter((t) => t.status === "blocked").length,
   358→    completed: allTasks.filter((t) => t.status === "completed").length,
   359→    inbox_items: inboxItems.length,
   360→  };
   361→
   362→  // Get active tasks (in_progress + needs_work, optionally filtered to automation-eligible only)
   363→  // AC: @cli-ralph ac-16
   364→  const activeTasks = allTasks
   365→    .filter((t) => t.status === "in_progress" || t.status === "needs_work")
   366→    .filter((t) => !options.eligible || t.automation === "eligible")
   367→    .sort((a, b) => a.priority - b.priority)
   368→    .slice(0, options.full ? undefined : limit)
   369→    .map((t) => toActiveTaskSummary(t, index));
   370→
   371→  // Get pending review tasks
   372→  const pendingReviewTasks = allTasks
   373→    .filter((t) => t.status === "pending_review")
   374→    .sort((a, b) => a.priority - b.priority)
   375→    .slice(0, options.full ? undefined : limit)
   376→    .map((t) => toActiveTaskSummary(t, index));
   377→
   378→  // Get recent notes from active, pending_review, and recently completed tasks
   379→  // AC: @cmd-session-start ac-1, ac-2
   380→  // Collect notes per-status first to prevent one status from starving others
   381→  const noteLimitPerStatus = options.full ? limit : Math.ceil(limit / 3);
   382→
   383→  const inProgressNotes = collectRecentNotes(
   384→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   385→    index,
   386→    { limit: noteLimitPerStatus, since: sinceDate },
   387→  );
   388→
   389→  const pendingReviewNotes = collectRecentNotes(
   390→    allTasks.filter((t) => t.status === "pending_review"),
   391→    index,
   392→    { limit: noteLimitPerStatus, since: sinceDate },
   393→  );
   394→
   395→  const recentlyCompletedForNotes = allTasks
   396→    .filter((t) => t.status === "completed" && t.completed_at)
   397→    .sort((a, b) => {
   398→      const aDate = new Date(a.completed_at || 0);
   399→      const bDate = new Date(b.completed_at || 0);
   400→      return bDate.getTime() - aDate.getTime();
   401→    })
   402→    .slice(0, 5); // Last 3-5 completed tasks per AC-2
   403→
   404→  const completedNotes = collectRecentNotes(
   405→    recentlyCompletedForNotes,
   406→    index,
   407→    { limit: noteLimitPerStatus, since: sinceDate },
   408→  );
   409→
   410→  // Combine notes from all statuses, preserving representation from each
   411→  const recentNotes = [...inProgressNotes, ...pendingReviewNotes, ...completedNotes]
   412→    .sort(
   413→      (a, b) =>
   414→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   415→    );
   416→
   417→  // Get incomplete todos from active tasks
   418→  const activeTodos = collectIncompleteTodos(
   419→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   420→    index,
   421→    { limit: options.full ? limit * 2 : limit },
   422→  );
   423→
   424→  // Compute reverse dependency map for "unlocks N" annotations
   425→  const unlocksMap = computeUnlocksMap(allTasks, index);
   426→
   427→  // AC: @cmd-session-start ac-primer-default, ac-full-sections
   428→  // Primer: top 5 ready tasks; Full: all ready tasks
   429→  // Respect --limit as upper bound when provided
   430→  const readyLimit = options.full ? undefined : Math.min(limit, 5);
   431→  const readyTasks = getReadyTasks(allTasks)
   432→    .filter((t) => !options.eligible || t.automation === "eligible")
   433→    .slice(0, readyLimit)
   434→    .map((t) => toReadyTaskSummary(t, index, unlocksMap));
   435→
   436→  // Get blocked tasks
   437→  const blockedTasks = allTasks
   438→    .filter((t) => t.status === "blocked")
   439→    .slice(0, options.full ? undefined : limit)
   440→    .map((t) => toBlockedTaskSummary(t, index, unlocksMap));
   441→
   442→  // Get recently completed tasks
   443→  const recentlyCompleted = allTasks
   444→    .filter((t) => {
   445→      if (t.status !== "completed" || !t.completed_at) return false;
   446→      const completedDate = new Date(t.completed_at);
   447→      if (sinceDate && completedDate < sinceDate) return false;
   448→      return true;
   449→    })
   450→    .sort((a, b) => {
   451→      // Sort by completed_at descending (most recent first)
   452→      const aDate = new Date(a.completed_at || 0);
   453→      const bDate = new Date(b.completed_at || 0);
   454→      return bDate.getTime() - aDate.getTime();
   455→    })
   456→    .slice(0, options.full ? undefined : limit)
   457→    .map((t) => toCompletedTaskSummary(t, index));
   458→
   459→  // Get git info
   460→  let branch: string | null = null;
   461→  let recentCommits: CommitSummary[] = [];
   462→  let workingTree: GitWorkingTree | null = null;
   463→
   464→  if (showGit && isGitRepo(ctx.rootDir)) {
   465→    branch = getCurrentBranch(ctx.rootDir);
   466→
   467→    const commits = getRecentCommits({
   468→      limit: options.full ? limit * 2 : limit,
   469→      since: sinceDate || undefined,
   470→      cwd: ctx.rootDir,
   471→    });
   472→
   473→    recentCommits = commits.map((c) => ({
   474→      hash: c.hash,
   475→      full_hash: c.fullHash,
   476→      date: c.date.toISOString(),
   477→      message: c.message,
   478→      author: c.author,
   479→      task_refs: c.taskRefs,
   480→    }));
   481→
   482→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   483→  }
   484→
   485→  // Get inbox items with triage status (oldest first to encourage triage)
   486→  // AC: @session-start-inbox-triage ac-inbox-untriaged-def
   487→  const allInboxSummaries: InboxSummary[] = inboxItems
   488→    .sort(
   489→      (a, b) =>
   490→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   491→    )
   492→    .map((item) => {
   493→      const triageInfo = triageByInboxRef.get(item._ulid);
   494→      return {
   495→        ref: item._ulid.slice(0, 8),
   496→        text: item.text,
   497→        created_at: item.created_at,
   498→        tags: item.tags,
   499→        added_by: item.added_by || null,
   500→        triaged: !!triageInfo,
   501→        triage_action: triageInfo?.action ?? null,
   502→      };
   503→    });
   504→
   505→  // AC: @session-start-inbox-triage ac-inbox-stat-line, ac-inbox-all-triaged
   506→  const inboxStats: InboxStats = {
   507→    total: allInboxSummaries.length,
   508→    untriaged: allInboxSummaries.filter((i) => !i.triaged).length,
   509→    deferred: allInboxSummaries.filter((i) => i.triage_action === "defer")
   510→      .length,
   511→    triaged: allInboxSummaries.filter((i) => i.triaged).length,
   512→  };
   513→
   514→  // JSON always gets full list with triage status; human display filters in formatSessionContext
   515→  const inboxSummaries: InboxSummary[] = allInboxSummaries;
   516→
   517→  // Load session context (focus, threads, questions)
   518→  const sessionContext = await loadSessionContext(ctx);
   519→
   520→  // Build task ref resolver for activity timeline: maps slug/ULID to short ref
   521→  // This allows commits with Task: @task-slug trailers to match completed tasks
   522→  const taskRefResolver = new Map<string, string>();
   523→  for (const task of allTasks) {
   524→    if (task.status !== "completed") continue;
   525→    const shortRef = index.shortUlid(task._ulid);
   526→    // Map each slug to the short ref
   527→    for (const slug of task.slugs) {
   528→      taskRefResolver.set(slug, shortRef);
   529→    }
   530→    // Also map the full ULID and short ULID to itself
   531→    taskRefResolver.set(task._ulid, shortRef);
   532→    taskRefResolver.set(shortRef, shortRef);
   533→  }
   534→
   535→  // Build unified activity timeline
   536→  // AC: @session-start-activity-timeline ac-activity-merge
   537→  // AC: @cmd-session-start ac-primer-default, ac-full-sections
   538→  // Primer: 10 items; Full: 20 items
   539→  // Respect --limit as upper bound when provided
   540→  const activityLimit = options.full ? Math.min(limit * 2, 20) : Math.min(limit, 10);
   541→  const activityTimeline = buildActivityTimeline(
   542→    recentlyCompleted,
   543→    recentCommits,
   544→    taskRefResolver,
   545→  ).slice(0, activityLimit);
   546→
   547→  // AC: @cmd-session-start ac-full-sections — observations section (full mode only)
   548→  let observations: ObservationSummary[] = [];
   549→  if (options.full) {
   550→    const metaCtx = await loadMetaContext(ctx);
   551→    observations = metaCtx.observations
   552→      .filter((o) => !o.resolved)
   553→      .sort(
   554→        (a, b) =>
   555→          new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   556→      )
   557→      .map((o) => ({
   558→        ref: o._ulid.slice(0, 8),
   559→        type: o.type,
   560→        content: o.content,
   561→        created_at: o.created_at,
   562→        author: o.author || null,
   563→        resolved: o.resolved,
   564→        workflow_ref: o.workflow_ref || null,
   565→      }));
   566→  }
   567→
   568→  // AC: @session-start-computed-json ac-computed-unlocks
   569→  // Build task_unlocks map: short ULID ref → count of pending dependents
   570→  const taskUnlocks: Record<string, number> = {};
   571→  for (const [taskUlid, count] of unlocksMap) {
   572→    if (count > 0) {
   573→      taskUnlocks[index.shortUlid(taskUlid)] = count;
   574→    }
   575→  }
   576→
   577→  // AC: @session-start-computed-json ac-computed-inbox, ac-computed-unlocks, ac-computed-activity
   578→  const computed: SessionContextComputed = {
   579→    inbox_untriaged_count: inboxStats.untriaged,
   580→    inbox_deferred_count: inboxStats.deferred,
   581→    inbox_total: inboxStats.total,
   582→    task_unlocks: taskUnlocks,
   583→    recent_activity: activityTimeline,
   584→  };
   585→
   586→  return {
   587→    generated_at: new Date().toISOString(),
   588→    branch,
   589→    context: sessionContext,
   590→    active_tasks: activeTasks,
   591→    pending_review_tasks: pendingReviewTasks,
   592→    recent_notes: recentNotes,
   593→    active_todos: activeTodos,
   594→    ready_tasks: readyTasks,
   595→    blocked_tasks: blockedTasks,
   596→    recently_completed: recentlyCompleted,
   597→    recent_commits: recentCommits,
   598→    activity_timeline: activityTimeline,
   599→    working_tree: workingTree,
   600→    inbox_items: inboxSummaries,
   601→    inbox_stats: inboxStats,
   602→    observations,
   603→    stats,
   604→    computed,
   605→  };
   606→}
   607→
   608→// ─── Iteration Stats ────────────────────────────────────────────────────────
   609→
   610→/**
   611→ * Get iteration stats - tasks completed/started since a given time.
   612→ * AC: @ralph-task-limit ac-detection
   613→ */
   614→export async function getIterationStats(
   615→  ctx: KspecContext,
   616→  since: Date,
   617→): Promise<IterationStats> {
   618→  const allTasks = await loadAllTasks(ctx);
   619→
   620→  // Count both completed and pending_review (submitted) tasks toward the limit.
   621→  // Submit means the agent's work is done — it should count the same as complete.
   622→  // AC: @ralph-task-limit ac-detection
   623→  const completedSince = allTasks.filter((t) => {
   624→    if (t.status === "completed" && t.completed_at) {
   625→      return new Date(t.completed_at) >= since;
   626→    }
   627→    if (t.status === "pending_review" && t.submitted_at) {
   628→      return new Date(t.submitted_at) >= since;
   629→    }
   630→    return false;
   631→  });
   632→
   633→  const startedSince = allTasks.filter((t) => {
   634→    if (!t.started_at) return false;
   635→    return new Date(t.started_at) >= since;
   636→  });
   637→
   638→  // Use first slug or ULID prefix as ref
   639→  const getRef = (t: LoadedTask) =>
   640→    t.slugs.length > 0 ? `@${t.slugs[0]}` : `@${t._ulid.slice(0, 8)}`;
   641→
   642→  return {
   643→    tasks_completed: completedSince.length,
   644→    tasks_started: startedSince.length,
   645→    completed_refs: completedSince.map(getRef),
   646→  };
   647→}
   648→