```
     1→/**
     2→ * Tests for session start activity timeline
     3→ *
     4→ * AC: @session-start-activity-timeline ac-activity-merge
     5→ * AC: @session-start-activity-timeline ac-activity-trailer-link
     6→ * AC: @session-start-activity-timeline ac-activity-sort
     7→ * AC: @session-start-activity-timeline ac-activity-dedup
     8→ * AC: @session-start-activity-timeline ac-activity-no-git
     9→ * AC: @session-start-activity-timeline ac-activity-hierarchy
    10→ * AC: @session-start-activity-timeline ac-activity-orphan
    11→ */
    12→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
    13→import { kspec, kspecJson, setupTempFixtures, cleanupTempDir, initGitRepo, git } from '../helpers/cli';
    14→import { writeFileSync } from 'node:fs';
    15→import { join } from 'node:path';
    16→
    17→interface CommitSummary {
    18→  hash: string;
    19→  full_hash: string;
    20→  date: string;
    21→  message: string;
    22→  author: string;
    23→  task_refs: string[];
    24→}
    25→
    26→interface CompletedTaskSummary {
    27→  ref: string;
    28→  title: string;
    29→  completed_at: string;
    30→  closed_reason: string | null;
    31→}
    32→
    33→interface ActivityItem {
    34→  type: 'task_completion' | 'commit' | 'linked_commit';
    35→  date: string;
    36→  commit?: CommitSummary;
    37→  task?: CompletedTaskSummary;
    38→}
    39→
    40→interface SessionContext {
    41→  recently_completed: CompletedTaskSummary[];
    42→  recent_commits: CommitSummary[];
    43→  activity_timeline: ActivityItem[];
    44→}
    45→
    46→describe('session start activity timeline', () => {
    47→  let tempDir: string;
    48→
    49→  beforeEach(async () => {
    50→    tempDir = await setupTempFixtures();
    51→    initGitRepo(tempDir);
    52→    // Initial commit so git log works
    53→    writeFileSync(join(tempDir, 'README.md'), '# Test\n');
    54→    git('add .', tempDir);
    55→    git('commit -m "initial commit"', tempDir);
    56→  });
    57→
    58→  afterEach(async () => {
    59→    await cleanupTempDir(tempDir);
    60→  });
    61→
    62→  // AC: @session-start-activity-timeline ac-activity-merge
    63→  describe('activity merge (ac-activity-merge)', () => {
    64→    it('should include both completed tasks and commits in a single timeline', () => {
    65→      // Create and complete a task
    66→      kspec('task add --title "Feature alpha" --slug task-alpha', tempDir);
    67→      kspec('task start @task-alpha', tempDir);
    68→      kspec('task submit @task-alpha', tempDir);
    69→      kspec('task complete @task-alpha --reason "Shipped alpha"', tempDir);
    70→
    71→      // Create a git commit (not linked to any task)
    72→      writeFileSync(join(tempDir, 'feature.ts'), 'export const x = 1;\n');
    73→      git('add feature.ts', tempDir);
    74→      git('commit -m "feat: add feature file"', tempDir);
    75→
    76→      const session = kspecJson<SessionContext>('session start --json', tempDir);
    77→
    78→      // activity_timeline should contain entries from both sources
    79→      expect(session.activity_timeline.length).toBeGreaterThanOrEqual(2);
    80→
    81→      const taskEntries = session.activity_timeline.filter(
    82→        (i) => i.type === 'task_completion',
    83→      );
    84→      const commitEntries = session.activity_timeline.filter(
    85→        (i) => i.type === 'commit',
    86→      );
    87→
    88→      expect(taskEntries.length).toBeGreaterThanOrEqual(1);
    89→      expect(commitEntries.length).toBeGreaterThanOrEqual(1);
    90→    });
    91→
    92→    it('should show Recent Activity header in human output instead of separate sections', () => {
    93→      // Create and complete a task
    94→      kspec('task add --title "Feature beta" --slug task-beta', tempDir);
    95→      kspec('task start @task-beta', tempDir);
    96→      kspec('task submit @task-beta', tempDir);
    97→      kspec('task complete @task-beta --reason "Shipped beta"', tempDir);
    98→
    99→      // Create a git commit
   100→      writeFileSync(join(tempDir, 'beta.ts'), 'export const beta = 1;\n');
   101→      git('add beta.ts', tempDir);
   102→      git('commit -m "feat: add beta"', tempDir);
   103→
   104→      const result = kspec('session start', tempDir);
   105→
   106→      // Should have unified "Recent Activity" section
   107→      expect(result.stdout).toContain('Recent Activity');
   108→
   109→      // Should NOT have separate "Recent Commits" section
   110→      // (the section header text is "--- Recent Commits ---")
   111→      expect(result.stdout).not.toContain('Recent Commits ---');
   112→    });
   113→
   114→    it('should preserve raw recently_completed and recent_commits arrays in JSON', () => {
   115→      // Create and complete a task
   116→      kspec('task add --title "Raw check" --slug task-raw', tempDir);
   117→      kspec('task start @task-raw', tempDir);
   118→      kspec('task submit @task-raw', tempDir);
   119→      kspec('task complete @task-raw --reason "Done"', tempDir);
   120→
   121→      // Create a commit
   122→      writeFileSync(join(tempDir, 'raw.ts'), 'export const raw = 1;\n');
   123→      git('add raw.ts', tempDir);
   124→      git('commit -m "feat: raw check"', tempDir);
   125→
   126→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   127→
   128→      // Raw arrays should still be present
   129→      expect(session.recently_completed).toBeDefined();
   130→      expect(session.recently_completed.length).toBeGreaterThanOrEqual(1);
   131→      expect(session.recent_commits).toBeDefined();
   132→      expect(session.recent_commits.length).toBeGreaterThanOrEqual(1);
   133→
   134→      // Plus the unified timeline
   135→      expect(session.activity_timeline).toBeDefined();
   136→      expect(session.activity_timeline.length).toBeGreaterThanOrEqual(2);
   137→    });
   138→  });
   139→
   140→  // AC: @session-start-activity-timeline ac-activity-trailer-link
   141→  describe('trailer linking (ac-activity-trailer-link)', () => {
   142→    it('should show linked task info when commit has Task: @slug trailer', () => {
   143→      // Create and complete a task
   144→      kspec('task add --title "Linked feature" --slug task-linked', tempDir);
   145→      kspec('task start @task-linked', tempDir);
   146→      kspec('task submit @task-linked', tempDir);
   147→      kspec('task complete @task-linked --reason "All done"', tempDir);
   148→
   149→      // Create a commit with a Task: trailer using the task slug (convention)
   150→      writeFileSync(join(tempDir, 'linked.ts'), 'export const linked = 1;\n');
   151→      git('add linked.ts', tempDir);
   152→      git('commit -m "feat: implement linked feature" -m "Task: @task-linked"', tempDir);
   153→
   154→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   155→
   156→      // Should have a linked_commit entry
   157→      const linkedEntries = session.activity_timeline.filter(
   158→        (i) => i.type === 'linked_commit',
   159→      );
   160→      expect(linkedEntries.length).toBe(1);
   161→      expect(linkedEntries[0].commit!.task_refs).toContain('task-linked');
   162→      expect(linkedEntries[0].task!.title).toBe('Linked feature');
   163→    });
   164→
   165→    it('should show linked task info in human output', () => {
   166→      kspec('task add --title "Human linked" --slug task-human-linked', tempDir);
   167→      kspec('task start @task-human-linked', tempDir);
   168→      kspec('task submit @task-human-linked', tempDir);
   169→      kspec('task complete @task-human-linked --reason "Done"', tempDir);
   170→
   171→      writeFileSync(join(tempDir, 'hl.ts'), 'export const hl = 1;\n');
   172→      git('add hl.ts', tempDir);
   173→      git('commit -m "feat: human linked feature" -m "Task: @task-human-linked"', tempDir);
   174→
   175→      const result = kspec('session start', tempDir);
   176→
   177→      // Human output should show commit → task link
   178→      expect(result.stdout).toContain('Human linked');
   179→      expect(result.stdout).toContain('human linked feature');
   180→    });
   181→
   182→    it('should include task_refs in commit summary JSON', () => {
   183→      writeFileSync(join(tempDir, 'refcheck.ts'), 'export const rc = 1;\n');
   184→      git('add refcheck.ts', tempDir);
   185→      git('commit -m "feat: ref check commit" -m "Task: @task-ref-check"', tempDir);
   186→
   187→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   188→
   189→      const commit = session.recent_commits.find((c) =>
   190→        c.message.includes('ref check commit'),
   191→      );
   192→      expect(commit).toBeDefined();
   193→      expect(commit!.task_refs).toContain('task-ref-check');
   194→    });
   195→  });
   196→
   197→  // AC: @session-start-activity-timeline ac-activity-sort
   198→  describe('chronological sort (ac-activity-sort)', () => {
   199→    it('should sort timeline items most recent first', { timeout: 15000 }, () => {
   200→      // Create a task completed "earlier"
   201→      kspec('task add --title "Earlier task" --slug task-earlier', tempDir);
   202→      kspec('task start @task-earlier', tempDir);
   203→      kspec('task submit @task-earlier', tempDir);
   204→      kspec('task complete @task-earlier --reason "Done first"', tempDir);
   205→
   206→      // Create a commit with a future date to guarantee different timestamps
   207→      // Git --date flag sets the author date, ensuring it sorts after the task completion
   208→      writeFileSync(join(tempDir, 'later.ts'), 'export const later = 1;\n');
   209→      git('add later.ts', tempDir);
   210→      git('commit -m "feat: later commit" --date="2099-01-01T00:00:00Z"', tempDir);
   211→
   212→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   213→
   214→      // Should have at least 2 items (task + commit)
   215→      expect(session.activity_timeline.length).toBeGreaterThanOrEqual(2);
   216→
   217→      // Verify sorted most recent first
   218→      for (let i = 1; i < session.activity_timeline.length; i++) {
   219→        const prevDate = new Date(session.activity_timeline[i - 1].date).getTime();
   220→        const currDate = new Date(session.activity_timeline[i].date).getTime();
   221→        expect(prevDate).toBeGreaterThanOrEqual(currDate);
   222→      }
   223→
   224→      // The commit with future date should be first
   225→      expect(session.activity_timeline[0].type).toBe('commit');
   226→      expect(session.activity_timeline[0].commit!.message).toBe('feat: later commit');
   227→    });
   228→  });
   229→
   230→  // AC: @session-start-activity-timeline ac-activity-dedup
   231→  describe('deduplication (ac-activity-dedup)', () => {
   232→    it('should show linked commit+task as single combined entry, not two separate entries', () => {
   233→      kspec('task add --title "Dedup task" --slug task-dedup', tempDir);
   234→      kspec('task start @task-dedup', tempDir);
   235→      kspec('task submit @task-dedup', tempDir);
   236→      kspec('task complete @task-dedup --reason "Dedup done"', tempDir);
   237→
   238→      writeFileSync(join(tempDir, 'dedup.ts'), 'export const dedup = 1;\n');
   239→      git('add dedup.ts', tempDir);
   240→      git('commit -m "feat: dedup feature" -m "Task: @task-dedup"', tempDir);
   241→
   242→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   243→
   244→      // Should have exactly one linked_commit entry for this task
   245→      const linkedEntries = session.activity_timeline.filter(
   246→        (i) => i.type === 'linked_commit' && i.task?.title === 'Dedup task',
   247→      );
   248→      expect(linkedEntries.length).toBe(1);
   249→
   250→      // The task should NOT appear as a separate task_completion entry
   251→      const taskOnlyEntries = session.activity_timeline.filter(
   252→        (i) => i.type === 'task_completion' && i.task?.title === 'Dedup task',
   253→      );
   254→      expect(taskOnlyEntries.length).toBe(0);
   255→
   256→      // The commit should NOT appear as a separate commit entry
   257→      const commitOnlyEntries = session.activity_timeline.filter(
   258→        (i) => i.type === 'commit' && i.commit?.message === 'feat: dedup feature',
   259→      );
   260→      expect(commitOnlyEntries.length).toBe(0);
   261→    });
   262→
   263→    it('should show unlinked commit and unlinked task as separate entries', () => {
   264→      // Complete a task (no commit linked)
   265→      kspec('task add --title "Standalone task" --slug task-standalone', tempDir);
   266→      kspec('task start @task-standalone', tempDir);
   267→      kspec('task submit @task-standalone', tempDir);
   268→      kspec('task complete @task-standalone --reason "Done alone"', tempDir);
   269→
   270→      // Create unlinked commit
   271→      writeFileSync(join(tempDir, 'standalone.ts'), 'export const x = 1;\n');
   272→      git('add standalone.ts', tempDir);
   273→      git('commit -m "chore: standalone commit"', tempDir);
   274→
   275→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   276→
   277→      // Each should appear as its own type
   278→      const taskEntries = session.activity_timeline.filter(
   279→        (i) => i.type === 'task_completion' && i.task?.title === 'Standalone task',
   280→      );
   281→      expect(taskEntries.length).toBe(1);
   282→
   283→      const commitEntries = session.activity_timeline.filter(
   284→        (i) => i.type === 'commit' && i.commit?.message === 'chore: standalone commit',
   285→      );
   286→      expect(commitEntries.length).toBe(1);
   287→    });
   288→  });
   289→
   290→  // AC: @session-start-activity-timeline ac-activity-no-git
   291→  describe('--no-git flag (ac-activity-no-git)', () => {
   292→    it('should only show task completions when --no-git is passed', () => {
   293→      // Create and complete a task
   294→      kspec('task add --title "No-git task" --slug task-no-git', tempDir);
   295→      kspec('task start @task-no-git', tempDir);
   296→      kspec('task submit @task-no-git', tempDir);
   297→      kspec('task complete @task-no-git --reason "Done without git"', tempDir);
   298→
   299→      // Create a commit
   300→      writeFileSync(join(tempDir, 'nogit.ts'), 'export const x = 1;\n');
   301→      git('add nogit.ts', tempDir);
   302→      git('commit -m "feat: should not appear"', tempDir);
   303→
   304→      const session = kspecJson<SessionContext>('session start --json --no-git', tempDir);
   305→
   306→      // Timeline should only contain task_completion entries
   307→      expect(session.activity_timeline.length).toBeGreaterThanOrEqual(1);
   308→      for (const item of session.activity_timeline) {
   309→        expect(item.type).toBe('task_completion');
   310→      }
   311→
   312→      // recent_commits should be empty
   313→      expect(session.recent_commits).toHaveLength(0);
   314→    });
   315→
   316→    it('should not show commit entries in human output with --no-git', () => {
   317→      kspec('task add --title "Visible task" --slug task-visible', tempDir);
   318→      kspec('task start @task-visible', tempDir);
   319→      kspec('task submit @task-visible', tempDir);
   320→      kspec('task complete @task-visible --reason "Visible"', tempDir);
   321→
   322→      writeFileSync(join(tempDir, 'hidden.ts'), 'export const x = 1;\n');
   323→      git('add hidden.ts', tempDir);
   324→      git('commit -m "feat: invisible commit"', tempDir);
   325→
   326→      const result = kspec('session start --no-git', tempDir);
   327→
   328→      // Task should be visible
   329→      expect(result.stdout).toContain('Visible task');
   330→      // Commit should not be visible
   331→      expect(result.stdout).not.toContain('invisible commit');
   332→    });
   333→  });
   334→
   335→  // AC: @session-start-activity-timeline ac-activity-hierarchy
   336→  describe('hierarchical display (ac-activity-hierarchy)', () => {
   337→    it('should show task as top-level entry with linked commits nested beneath using visual connectors', () => {
   338→      // Create and complete a task
   339→      kspec('task add --title "Hierarchy task" --slug task-hier', tempDir);
   340→      kspec('task start @task-hier', tempDir);
   341→      kspec('task submit @task-hier', tempDir);
   342→      kspec('task complete @task-hier --reason "Shipped"', tempDir);
   343→
   344→      // Create a commit linked to the task
   345→      writeFileSync(join(tempDir, 'hier.ts'), 'export const h = 1;\n');
   346→      git('add hier.ts', tempDir);
   347→      git('commit -m "feat: hierarchy feature" -m "Task: @task-hier"', tempDir);
   348→
   349→      const result = kspec('session start', tempDir);
   350→
   351→      // Task should appear as top-level entry with ✓ marker
   352→      expect(result.stdout).toContain('✓');
   353→      expect(result.stdout).toContain('@task-hier');
   354→      expect(result.stdout).toContain('Hierarchy task');
   355→
   356→      // Linked commit should be nested beneath with a visual connector (└─ for single commit)
   357→      expect(result.stdout).toContain('└─');
   358→      expect(result.stdout).toContain('hierarchy feature');
   359→
   360→      // In JSON, the linked_commit type carries both commit and task data
   361→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   362→      const linked = session.activity_timeline.filter(
   363→        (i) => i.type === 'linked_commit' && i.task?.title === 'Hierarchy task',
   364→      );
   365→      expect(linked.length).toBe(1);
   366→      expect(linked[0].commit!.message).toBe('feat: hierarchy feature');
   367→      expect(linked[0].task!.title).toBe('Hierarchy task');
   368→    });
   369→
   370→    it('should nest multiple commits under the same task with ├─ and └─ connectors', () => {
   371→      // Create and complete a task
   372→      kspec('task add --title "Multi commit task" --slug task-multi', tempDir);
   373→      kspec('task start @task-multi', tempDir);
   374→      kspec('task submit @task-multi', tempDir);
   375→      kspec('task complete @task-multi --reason "Shipped"', tempDir);
   376→
   377→      // Create two commits linked to the same task
   378→      writeFileSync(join(tempDir, 'multi1.ts'), 'export const m1 = 1;\n');
   379→      git('add multi1.ts', tempDir);
   380→      git('commit -m "feat: first commit" -m "Task: @task-multi"', tempDir);
   381→
   382→      writeFileSync(join(tempDir, 'multi2.ts'), 'export const m2 = 1;\n');
   383→      git('add multi2.ts', tempDir);
   384→      git('commit -m "feat: second commit" -m "Task: @task-multi"', tempDir);
   385→
   386→      const result = kspec('session start', tempDir);
   387→
   388→      // Task should appear as top-level entry
   389→      expect(result.stdout).toContain('@task-multi');
   390→      expect(result.stdout).toContain('Multi commit task');
   391→
   392→      // Should have ├─ for non-last and └─ for last commit
   393→      expect(result.stdout).toContain('├─');
   394→      expect(result.stdout).toContain('└─');
   395→
   396→      // Both commits should appear
   397→      expect(result.stdout).toContain('first commit');
   398→      expect(result.stdout).toContain('second commit');
   399→
   400→      // Task should appear only once (not repeated per commit)
   401→      const lines = result.stdout.split('\n');
   402→      const taskLines = lines.filter((l) => l.includes('Multi commit task'));
   403→      expect(taskLines.length).toBe(1);
   404→    });
   405→
   406→    it('should show standalone task completions with ✓ marker', () => {
   407→      // Complete a task without linked commits
   408→      kspec('task add --title "Task only" --slug task-only', tempDir);
   409→      kspec('task start @task-only', tempDir);
   410→      kspec('task submit @task-only', tempDir);
   411→      kspec('task complete @task-only --reason "Done"', tempDir);
   412→
   413→      const result = kspec('session start', tempDir);
   414→
   415→      // Task completion should show ✓ marker
   416→      expect(result.stdout).toContain('✓');
   417→      expect(result.stdout).toContain('Task only');
   418→    });
   419→
   420→    it('should show task on its own line, commit on separate nested line', () => {
   421→      kspec('task add --title "Separate lines" --slug task-sep', tempDir);
   422→      kspec('task start @task-sep', tempDir);
   423→      kspec('task submit @task-sep', tempDir);
   424→      kspec('task complete @task-sep --reason "Done"', tempDir);
   425→
   426→      writeFileSync(join(tempDir, 'sep.ts'), 'export const s = 1;\n');
   427→      git('add sep.ts', tempDir);
   428→      git('commit -m "feat: sep commit" -m "Task: @task-sep"', tempDir);
   429→
   430→      const result = kspec('session start', tempDir);
   431→      const lines = result.stdout.split('\n');
   432→
   433→      // Task and commit should be on different lines
   434→      const taskLine = lines.find((l) => l.includes('Separate lines'));
   435→      const commitLine = lines.find((l) => l.includes('sep commit'));
   436→      expect(taskLine).toBeDefined();
   437→      expect(commitLine).toBeDefined();
   438→      expect(taskLine).not.toBe(commitLine);
   439→    });
   440→  });
   441→
   442→  // AC: @session-start-activity-timeline ac-activity-orphan
   443→  describe('orphan commit display (ac-activity-orphan)', () => {
   444→    it('should show orphan commits with ○ marker as standalone indented entries', () => {
   445→      // Create a commit without Task: trailer (orphan)
   446→      writeFileSync(join(tempDir, 'orphan.ts'), 'export const orphan = 1;\n');
   447→      git('add orphan.ts', tempDir);
   448→      git('commit -m "chore: standalone cleanup"', tempDir);
   449→
   450→      const result = kspec('session start', tempDir);
   451→
   452→      // Orphan commit should appear with ○ marker
   453→      expect(result.stdout).toContain('○');
   454→      expect(result.stdout).toContain('standalone cleanup');
   455→    });
   456→
   457→    it('should classify orphan commits as type "commit" in JSON', () => {
   458→      // Create an orphan commit
   459→      writeFileSync(join(tempDir, 'orphan2.ts'), 'export const orphan2 = 1;\n');
   460→      git('add orphan2.ts', tempDir);
   461→      git('commit -m "chore: orphan commit"', tempDir);
   462→
   463→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   464→
   465→      const orphans = session.activity_timeline.filter(
   466→        (i) => i.type === 'commit' && i.commit?.message === 'chore: orphan commit',
   467→      );
   468→      expect(orphans.length).toBe(1);
   469→      // Orphan commits have no task association
   470→      expect(orphans[0]).not.toHaveProperty('task');
   471→    });
   472→
   473→    it('should use different visual markers for orphan commits vs task entries', () => {
   474→      // Create a linked commit (task entry uses ✓)
   475→      kspec('task add --title "Linked task" --slug task-linked', tempDir);
   476→      kspec('task start @task-linked', tempDir);
   477→      kspec('task submit @task-linked', tempDir);
   478→      kspec('task complete @task-linked --reason "Done"', tempDir);
   479→
   480→      writeFileSync(join(tempDir, 'linked.ts'), 'export const linked = 1;\n');
   481→      git('add linked.ts', tempDir);
   482→      git('commit -m "feat: linked work" -m "Task: @task-linked"', tempDir);
   483→
   484→      // Create an orphan commit (uses ○)
   485→      writeFileSync(join(tempDir, 'orphan3.ts'), 'export const o = 1;\n');
   486→      git('add orphan3.ts', tempDir);
   487→      git('commit -m "chore: orphan work"', tempDir);
   488→
   489→      const result = kspec('session start', tempDir);
   490→      const lines = result.stdout.split('\n');
   491→
   492→      // Task entry line should have ✓ marker
   493→      const taskLine = lines.find((l) => l.includes('Linked task'));
   494→      expect(taskLine).toBeDefined();
   495→      expect(taskLine).toContain('✓');
   496→
   497→      // Orphan commit line should have ○ marker
   498→      const orphanLine = lines.find((l) => l.includes('orphan work'));
   499→      expect(orphanLine).toBeDefined();
   500→      expect(orphanLine).toContain('○');
   501→
   502→      // Linked commit should be nested (not on the task line)
   503→      const commitLine = lines.find((l) => l.includes('linked work'));
   504→      expect(commitLine).toBeDefined();
   505→      expect(commitLine).not.toContain('Linked task');
   506→      // Linked commit should have a connector
   507→      expect(commitLine).toContain('└─');
   508→    });
   509→
   510→    it('should not show orphan commits with tree connectors', () => {
   511→      // Orphan commits use ○, not ├─ or └─
   512→      writeFileSync(join(tempDir, 'orphan4.ts'), 'export const o4 = 1;\n');
   513→      git('add orphan4.ts', tempDir);
   514→      git('commit -m "chore: orphan no tree"', tempDir);
   515→
   516→      const result = kspec('session start', tempDir);
   517→      const lines = result.stdout.split('\n');
   518→      const orphanLine = lines.find((l) => l.includes('orphan no tree'));
   519→      expect(orphanLine).toBeDefined();
   520→      expect(orphanLine).not.toContain('├─');
   521→      expect(orphanLine).not.toContain('└─');
   522→    });
   523→  });
   524→});
