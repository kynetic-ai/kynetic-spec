   359→// ============================================================================
   360→// ACPClient Tests
   361→// ============================================================================
   362→
   363→describe('ACPClient', () => {
   364→  let stdin: PassThrough;
   365→  let stdout: PassThrough;
   366→  let client: ACPClient;
   367→
   368→  beforeEach(() => {
   369→    stdin = new PassThrough();
   370→    stdout = new PassThrough();
   371→    client = new ACPClient({
   372→      stdin,
   373→      stdout,
   374→      timeout: 1000,
   375→      clientInfo: {
   376→        name: 'test-client',
   377→        version: '1.0.0',
   378→      },
   379→    });
   380→  });
   381→
   382→  afterEach(() => {
   383→    client.close();
   384→  });
   385→
   386→  /**
   387→   * Helper to respond to the next outgoing request
   388→   */
   389→  function respondToNext(result: unknown) {
   390→    return new Promise<void>((resolve) => {
   391→      stdout.once('data', (chunk: Buffer) => {
   392→        const request = JSON.parse(chunk.toString());
   393→        stdin.write(
   394→          JSON.stringify({
   395→            jsonrpc: '2.0',
   396→            id: request.id,
   397→            result,
   398→          }) + '\n',
   399→        );
   400→        resolve();
   401→      });
   402→    });
   403→  }
   404→
   405→  // AC: @acp-client ac-1
   406→  describe('initialize', () => {
   407→    it('should initialize and return agent capabilities', async () => {
   408→      const initPromise = client.initialize();
   409→
   410→      // Respond with capabilities
   411→      await respondToNext({
   412→        protocolVersion: 1,
   413→        agentCapabilities: {
   414→          streaming: true,
   415→        },
   416→      });
   417→
   418→      const capabilities = await initPromise;
   419→      expect(capabilities).toEqual({ streaming: true });
   420→      expect(client.isInitialized()).toBe(true);
   421→    });
   422→
   423→    it('should throw if already initialized', async () => {
   424→      const initPromise = client.initialize();
   425→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   426→      await initPromise;
   427→
   428→      await expect(client.initialize()).rejects.toThrow('already initialized');
   429→    });
   430→  });
   431→
   432→  // AC: @acp-client ac-2
   433→  describe('newSession', () => {
   434→    it('should create session and return sessionId', async () => {
   435→      // Initialize first
   436→      const initPromise = client.initialize();
   437→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   438→      await initPromise;
   439→
   440→      // Create session
   441→      const sessionPromise = client.newSession({
   442→        cwd: '/test',
   443→        _meta: { test: true },
   444→      });
   445→
   446→      await respondToNext({ sessionId: 'session-123' });
   447→
   448→      const sessionId = await sessionPromise;
   449→      expect(sessionId).toBe('session-123');
   450→
   451→      // Verify session is tracked
   452→      const session = client.getSession('session-123');
   453→      expect(session).toEqual({ id: 'session-123', status: 'idle' });
   454→    });
   455→
   456→    it('should throw if not initialized', async () => {
   457→      await expect(client.newSession({ cwd: '/' })).rejects.toThrow(
   458→        'not initialized',
   459→      );
   460→    });
   461→  });
   462→
   463→  describe('endSession', () => {
   464→    it('removes session tracking when a session lifecycle ends', async () => {
   465→      const initPromise = client.initialize();
   466→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   467→      await initPromise;
   468→
   469→      const sessionPromise = client.newSession({ cwd: '/' });
   470→      await respondToNext({ sessionId: 'session-123' });
   471→      await sessionPromise;
   472→
   473→      expect(client.getAllSessions()).toHaveLength(1);
   474→      client.endSession('session-123');
   475→      expect(client.getSession('session-123')).toBeUndefined();
   476→      expect(client.getAllSessions()).toHaveLength(0);
   477→    });
   478→  });
   479→
   480→  // AC: @acp-client ac-3
   481→  describe('prompt', () => {
   482→    beforeEach(async () => {
   483→      // Initialize and create session for prompt tests
   484→      const initPromise = client.initialize();
   485→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   486→      await initPromise;
   487→
   488→      const sessionPromise = client.newSession({ cwd: '/' });
   489→      await respondToNext({ sessionId: 'session-123' });
   490→      await sessionPromise;
   491→    });
   492→
   493→    it('should send prompt and return response with stopReason', async () => {
   494→      const promptPromise = client.prompt({
   495→        sessionId: 'session-123',
   496→        prompt: [{ type: 'text', text: 'Hello' }],
   497→      });
   498→
   499→      await respondToNext({
   500→        stopReason: 'end_turn',
   501→      });
   502→
   503→      const response = await promptPromise;
   504→      expect(response.stopReason).toBe('end_turn');
   505→    });
   506→
   507→    it('should update session status during prompt', async () => {
   508→      // Capture the request without immediately responding
   509→      let requestId: number | string | undefined;
   510→      const requestReceived = new Promise<void>((resolve) => {
   511→        stdout.once('data', (chunk: Buffer) => {
   512→          const request = JSON.parse(chunk.toString());
   513→          requestId = request.id;
   514→          resolve();
   515→        });
   516→      });
   517→
   518→      const promptPromise = client.prompt({
   519→        sessionId: 'session-123',
   520→        prompt: [{ type: 'text', text: 'Hello' }],
   521→      });
   522→
   523→      // Wait for request to be sent
   524→      await requestReceived;
   525→
   526→      // NOW check status - should be prompting since we haven't responded yet
   527→      expect(client.getSession('session-123')?.status).toBe('prompting');
   528→
   529→      // Send response
   530→      stdin.write(
   531→        JSON.stringify({
   532→          jsonrpc: '2.0',
   533→          id: requestId,
   534→          result: { stopReason: 'end_turn' },
   535→        }) + '\n',
   536→      );
   537→
   538→      await promptPromise;
   539→
   540→      // Check status is idle after
   541→      expect(client.getSession('session-123')?.status).toBe('idle');
   542→    });
   543→
   544→    it('should throw if session not found', async () => {
   545→      await expect(
   546→        client.prompt({
   547→          sessionId: 'nonexistent',
   548→          prompt: [{ type: 'text', text: 'Hello' }],
   549→        }),
   550→      ).rejects.toThrow('Session not found');
   551→    });
   552→
   553→    it('should throw if already prompting', async () => {
   554→      // Capture the first request without immediately responding
   555→      let requestId: number | string | undefined;
   556→      const requestReceived = new Promise<void>((resolve) => {
   557→        stdout.once('data', (chunk: Buffer) => {
   558→          const request = JSON.parse(chunk.toString());
   559→          requestId = request.id;
   560→          resolve();
   561→        });
   562→      });
   563→
   564→      // Start first prompt (don't await)
   565→      const firstPrompt = client.prompt({
   566→        sessionId: 'session-123',
   567→        prompt: [{ type: 'text', text: 'Hello' }],
   568→      });
   569→
   570→      // Wait for first prompt request to be sent
   571→      await requestReceived;
   572→
   573→      // Try second prompt - should fail because first is still prompting
   574→      await expect(
   575→        client.prompt({
   576→          sessionId: 'session-123',
   577→          prompt: [{ type: 'text', text: 'Hello again' }],
   578→        }),
   579→      ).rejects.toThrow('already prompting');
   580→
   581→      // Clean up first prompt by sending response
   582→      stdin.write(
   583→        JSON.stringify({
   584→          jsonrpc: '2.0',
   585→          id: requestId,
   586→          result: { stopReason: 'end_turn' },
   587→        }) + '\n',
   588→      );
   589→      await firstPrompt;
   590→    });
   591→  });
   592→
   593→  // AC: @acp-client ac-4
   594→  describe('update events', () => {
   595→    beforeEach(async () => {
   596→      const initPromise = client.initialize();
   597→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   598→      await initPromise;
   599→
   600→      const sessionPromise = client.newSession({ cwd: '/' });
   601→      await respondToNext({ sessionId: 'session-123' });
   602→      await sessionPromise;
   603→    });
   604→
   605→    it('should emit update events for session updates', async () => {
   606→      const updatePromise = new Promise<{ sessionId: string; update: unknown }>(
   607→        (resolve) => {
   608→          client.on('update', (sessionId, update) => {
   609→            resolve({ sessionId, update });
   610→          });
   611→        },
   612→      );
   613→
   614→      // Send session update notification
   615→      stdin.write(
   616→        JSON.stringify({
   617→          jsonrpc: '2.0',
   618→          method: 'session/update',
   619→          params: {
   620→            sessionId: 'session-123',
   621→            update: {
   622→              sessionUpdate: 'assistant_message_chunk',
   623→              content: { type: 'text', text: 'Hello!' },
   624→            },
   625→          },
   626→        }) + '\n',
   627→      );
   628→
   629→      const { sessionId, update } = await updatePromise;
   630→      expect(sessionId).toBe('session-123');
   631→      expect(update).toEqual({
   632→        sessionUpdate: 'assistant_message_chunk',
   633→        content: { type: 'text', text: 'Hello!' },
   634→      });
   635→    });
   636→  });
   637→
   638→  // AC: @acp-client ac-7
   639→  describe('cancel', () => {
   640→    beforeEach(async () => {
   641→      const initPromise = client.initialize();
   642→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   643→      await initPromise;
   644→
   645→      const sessionPromise = client.newSession({ cwd: '/' });
   646→      await respondToNext({ sessionId: 'session-123' });
   647→      await sessionPromise;
   648→    });
   649→
   650→    it('should send cancel request', async () => {
   651→      const cancelPromise = client.cancel('session-123');
   652→      await respondToNext({});
   653→      await cancelPromise;
   654→
   655→      expect(client.getSession('session-123')?.status).toBe('cancelled');
   656→    });
   657→
   658→    it('should silently handle Method not found errors', async () => {
   659→      // Suppress console.error for this test
   660→      const consoleSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
   661→
   662→      const cancelPromise = client.cancel('session-123');
   663→
   664→      // Respond with Method not found
   665→      stdout.once('data', (chunk: Buffer) => {
   666→        const request = JSON.parse(chunk.toString());
   667→        stdin.write(
   668→          JSON.stringify({
   669→            jsonrpc: '2.0',
   670→            id: request.id,
   671→            error: { code: -32601, message: 'Method not found' },
   672→          }) + '\n',
   673→        );
   674→      });
   675→
   676→      // Should not throw
   677→      await cancelPromise;
   678→
   679→      consoleSpy.mockRestore();
   680→    });
   681→
   682→    it('should throw for other errors', async () => {
   683→      // Suppress console.error for this test
   684→      const consoleSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
   685→
   686→      const cancelPromise = client.cancel('session-123');
   687→
   688→      // Respond with different error
   689→      stdout.once('data', (chunk: Buffer) => {
   690→        const request = JSON.parse(chunk.toString());
   691→        stdin.write(
   692→          JSON.stringify({
   693→            jsonrpc: '2.0',
   694→            id: request.id,
   695→            error: { code: -32603, message: 'Internal error' },
   696→          }) + '\n',
   697→        );
   698→      });
   699→
   700→      await expect(cancelPromise).rejects.toThrow('Internal error');
   701→
   702→      consoleSpy.mockRestore();
   703→    });
   704→  });
   705→
   706→  // AC: @acp-client ac-8
   707→  describe('close', () => {
   708→    it('should close and emit close event', async () => {
   709→      const closePromise = new Promise<void>((resolve) => {
   710→        client.on('close', resolve);
   711→      });
   712→
   713→      client.close();
   714→
   715→      await closePromise;
   716→      expect(client.isClosed()).toBe(true);
   717→    });
   718→
   719→    it('should throw on operations after close', async () => {
   720→      const initPromise = client.initialize();
   721→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   722→      await initPromise;
   723→
   724→      client.close();
   725→
   726→      await expect(client.newSession({ cwd: '/' })).rejects.toThrow('closed');
   727→    });
   728→
   729→    it('clears tracked sessions on close', async () => {
   730→      const initPromise = client.initialize();
   731→      await respondToNext({ protocolVersion: 1, agentCapabilities: {} });
   732→      await initPromise;
   733→
   734→      const sessionPromise = client.newSession({ cwd: '/' });
   735→      await respondToNext({ sessionId: 'session-123' });
   736→      await sessionPromise;
   737→      expect(client.getAllSessions()).toHaveLength(1);
   738→
   739→      client.close();
   740→      expect(client.getAllSessions()).toHaveLength(0);
   741→    });
   742→  });
   743→});
