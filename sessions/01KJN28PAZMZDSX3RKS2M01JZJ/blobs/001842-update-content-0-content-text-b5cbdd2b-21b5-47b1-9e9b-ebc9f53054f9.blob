   745→// ============================================================================
   746→// ACP Mock Tests (for mock agent implementation)
   747→// ============================================================================
   748→
   749→describe('ACP Mock Agent', () => {
   750→  let mockProcess: ReturnType<typeof spawn>;
   751→  let client: ACPClient;
   752→
   753→  beforeEach(() => {
   754→    // Spawn the mock agent as a subprocess
   755→    const { spawn } = require('node:child_process');
   756→    const mockPath = path.join(__dirname, 'mocks', 'acp-mock.js');
   757→    mockProcess = spawn('node', [mockPath]);
   758→
   759→    // Create ACP client connected to the mock
   760→    client = new ACPClient({
   761→      stdin: mockProcess.stdout, // Our stdin reads from mock's stdout
   762→      stdout: mockProcess.stdin, // Our stdout writes to mock's stdin
   763→      timeout: 5000,
   764→      clientInfo: {
   765→        name: 'test-client',
   766→        version: '1.0.0',
   767→      },
   768→    });
   769→  });
   770→
   771→  afterEach(() => {
   772→    client.close();
   773→    mockProcess.kill();
   774→  });
   775→
   776→  describe('session/request_permission', () => {
   777→    beforeEach(async () => {
   778→      // Initialize the mock agent before each test
   779→      await client.initialize();
   780→    });
   781→
   782→    it('should auto-approve with allow_always option', async () => {
   783→      // Send permission request with allow_always option
   784→      // Note: We need to use the framing layer directly since ACPClient doesn't expose requestPermission
   785→      const result = await (client as any).framing.sendRequest('session/request_permission', {
   786→        options: [
   787→          { optionId: 'deny-1', kind: 'deny' },
   788→          { optionId: 'allow-always-1', kind: 'allow_always' },
   789→          { optionId: 'allow-once-1', kind: 'allow_once' },
   790→        ],
   791→      });
   792→
   793→      // Should select the allow_always option
   794→      expect(result).toEqual({
   795→        outcome: { outcome: 'selected', optionId: 'allow-always-1' },
   796→      });
   797→    });
   798→
   799→    it('should auto-approve with allow_once when allow_always not available', async () => {
   800→      const result = await (client as any).framing.sendRequest('session/request_permission', {
   801→        options: [
   802→          { optionId: 'deny-1', kind: 'deny' },
   803→          { optionId: 'allow-once-1', kind: 'allow_once' },
   804→        ],
   805→      });
   806→
   807→      // Should select the allow_once option
   808→      expect(result).toEqual({
   809→        outcome: { outcome: 'selected', optionId: 'allow-once-1' },
   810→      });
   811→    });
   812→
   813→    it('should cancel permission requests with no allow options', async () => {
   814→      const result = await (client as any).framing.sendRequest('session/request_permission', {
   815→        options: [
   816→          { optionId: 'deny-1', kind: 'deny' },
   817→          { optionId: 'deny-2', kind: 'deny' },
   818→        ],
   819→      });
   820→
   821→      // Should cancel since no allow option available
   822→      expect(result).toEqual({
   823→        outcome: { outcome: 'cancelled' },
   824→      });
   825→    });
   826→
   827→    it('should handle empty options array', async () => {
   828→      const result = await (client as any).framing.sendRequest('session/request_permission', {
   829→        options: [],
   830→      });
   831→
   832→      // Should cancel since no options available
   833→      expect(result).toEqual({
   834→        outcome: { outcome: 'cancelled' },
   835→      });
   836→    });
   837→
   838→    it('should prefer allow_always over allow_once', async () => {
   839→      const result = await (client as any).framing.sendRequest('session/request_permission', {
   840→        options: [
   841→          { optionId: 'allow-once-1', kind: 'allow_once' },
   842→          { optionId: 'allow-always-1', kind: 'allow_always' },
   843→        ],
   844→      });
   845→
   846→      // Should prefer allow_always
   847→      expect(result).toEqual({
   848→        outcome: { outcome: 'selected', optionId: 'allow-always-1' },
   849→      });
   850→    });
   851→  });
   852→
   853→  describe('session/request_permission - error handling', () => {
   854→    it('should error on permission requests before initialization', async () => {
   855→      // Don't initialize - create a fresh client and send request directly
   856→      const { spawn } = require('node:child_process');
   857→      const mockPath = path.join(__dirname, 'mocks', 'acp-mock.js');
   858→      const freshMock = spawn('node', [mockPath]);
   859→
   860→      const freshClient = new ACPClient({
   861→        stdin: freshMock.stdout,
   862→        stdout: freshMock.stdin,
   863→        timeout: 5000,
   864→        clientInfo: { name: 'test', version: '1.0.0' },
   865→      });
   866→
   867→      try {
   868→        // Suppress console.error for this test
   869→        const consoleSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
   870→
   871→        await expect(
   872→          (freshClient as any).framing.sendRequest('session/request_permission', {
   873→            options: [{ optionId: 'allow-1', kind: 'allow_once' }],
   874→          }),
   875→        ).rejects.toThrow('Not initialized');
   876→
   877→        consoleSpy.mockRestore();
   878→      } finally {
   879→        freshClient.close();
   880→        freshMock.kill();
   881→      }
   882→    });
   883→  });
   884→});
