     1→import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
     2→import { PassThrough } from 'node:stream';
     3→import { spawn } from 'node:child_process';
     4→import * as path from 'node:path';
     5→import {
     6→  isRequest,
     7→  isResponse,
     8→  isError,
     9→  isNotification,
    10→  JsonRpcFraming,
    11→  ACPClient,
    12→} from '../src/acp/index.js';
    13→
    14→// ============================================================================
    15→// Type Guards Tests
    16→// ============================================================================
    17→
    18→describe('JSON-RPC Type Guards', () => {
    19→  describe('isRequest', () => {
    20→    it('should identify valid requests', () => {
    21→      const request = {
    22→        jsonrpc: '2.0',
    23→        id: 1,
    24→        method: 'test',
    25→        params: { foo: 'bar' },
    26→      };
    27→      expect(isRequest(request)).toBe(true);
    28→    });
    29→
    30→    it('should identify requests with string id', () => {
    31→      const request = {
    32→        jsonrpc: '2.0',
    33→        id: 'abc-123',
    34→        method: 'test',
    35→      };
    36→      expect(isRequest(request)).toBe(true);
    37→    });
    38→
    39→    it('should reject requests without method', () => {
    40→      const request = {
    41→        jsonrpc: '2.0',
    42→        id: 1,
    43→      };
    44→      expect(isRequest(request)).toBe(false);
    45→    });
    46→
    47→    it('should reject requests without id', () => {
    48→      const notification = {
    49→        jsonrpc: '2.0',
    50→        method: 'test',
    51→      };
    52→      expect(isRequest(notification)).toBe(false);
    53→    });
    54→
    55→    it('should reject wrong jsonrpc version', () => {
    56→      const request = {
    57→        jsonrpc: '1.0',
    58→        id: 1,
    59→        method: 'test',
    60→      };
    61→      expect(isRequest(request)).toBe(false);
    62→    });
    63→  });
    64→
    65→  describe('isResponse', () => {
    66→    it('should identify valid responses', () => {
    67→      const response = {
    68→        jsonrpc: '2.0',
    69→        id: 1,
    70→        result: { data: 'test' },
    71→      };
    72→      expect(isResponse(response)).toBe(true);
    73→    });
    74→
    75→    it('should identify responses with null result', () => {
    76→      const response = {
    77→        jsonrpc: '2.0',
    78→        id: 1,
    79→        result: null,
    80→      };
    81→      expect(isResponse(response)).toBe(true);
    82→    });
    83→
    84→    it('should reject responses with error field', () => {
    85→      const error = {
    86→        jsonrpc: '2.0',
    87→        id: 1,
    88→        result: {},
    89→        error: { code: -1, message: 'fail' },
    90→      };
    91→      expect(isResponse(error)).toBe(false);
    92→    });
    93→  });
    94→
    95→  describe('isError', () => {
    96→    it('should identify valid errors', () => {
    97→      const error = {
    98→        jsonrpc: '2.0',
    99→        id: 1,
   100→        error: { code: -32600, message: 'Invalid Request' },
   101→      };
   102→      expect(isError(error)).toBe(true);
   103→    });
   104→
   105→    it('should identify errors with null id', () => {
   106→      const error = {
   107→        jsonrpc: '2.0',
   108→        id: null,
   109→        error: { code: -32700, message: 'Parse error' },
   110→      };
   111→      expect(isError(error)).toBe(true);
   112→    });
   113→
   114→    it('should identify errors with data', () => {
   115→      const error = {
   116→        jsonrpc: '2.0',
   117→        id: 1,
   118→        error: { code: -32600, message: 'Invalid Request', data: { details: 'missing field' } },
   119→      };
   120→      expect(isError(error)).toBe(true);
   121→    });
   122→
   123→    it('should reject errors without error object', () => {
   124→      const response = {
   125→        jsonrpc: '2.0',
   126→        id: 1,
   127→        result: null,
   128→      };
   129→      expect(isError(response)).toBe(false);
   130→    });
   131→  });
   132→
   133→  describe('isNotification', () => {
   134→    it('should identify valid notifications', () => {
   135→      const notification = {
   136→        jsonrpc: '2.0',
   137→        method: 'session/update',
   138→        params: { sessionId: 'abc' },
   139→      };
   140→      expect(isNotification(notification)).toBe(true);
   141→    });
   142→
   143→    it('should identify notifications without params', () => {
   144→      const notification = {
   145→        jsonrpc: '2.0',
   146→        method: 'ping',
   147→      };
   148→      expect(isNotification(notification)).toBe(true);
   149→    });
   150→
   151→    it('should reject notifications with id (those are requests)', () => {
   152→      const request = {
   153→        jsonrpc: '2.0',
   154→        id: 1,
   155→        method: 'test',
   156→      };
   157→      expect(isNotification(request)).toBe(false);
   158→    });
   159→  });
   160→});
