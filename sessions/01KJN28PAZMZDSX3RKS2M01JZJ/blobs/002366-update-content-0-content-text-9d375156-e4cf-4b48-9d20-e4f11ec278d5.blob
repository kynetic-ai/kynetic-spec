   268→/**
   269→ * Validate meta manifest file with strict ULID validation
   270→ * AC-meta-manifest-3: Invalid schema exits with code 1 and shows field path + expected type
   271→ */
   272→async function validateMetaManifestFile(
   273→  filePath: string,
   274→): Promise<SchemaValidationError[]> {
   275→  const errors: SchemaValidationError[] = [];
   276→
   277→  try {
   278→    const raw = await readYamlFile<unknown>(filePath);
   279→
   280→    // Validate overall manifest structure
   281→    const manifestResult = MetaManifestSchema.safeParse(raw);
   282→    if (!manifestResult.success) {
   283→      for (const issue of manifestResult.error.issues) {
   284→        errors.push({
   285→          file: filePath,
   286→          path: issue.path.join("."),
   287→          message: issue.message,
   288→          details: issue,
   289→        });
   290→      }
   291→      return errors;
   292→    }
   293→
   294→    // Validate each agent with strict ULID validation
   295→    if (
   296→      raw &&
   297→      typeof raw === "object" &&
   298→      "agents" in raw &&
   299→      Array.isArray((raw as Record<string, unknown>).agents)
   300→    ) {
   301→      const agents = (raw as Record<string, unknown>).agents as unknown[];
   302→      for (let i = 0; i < agents.length; i++) {
   303→        const agent = agents[i];
   304→        const agentResult = AgentSchema.safeParse(agent);
   305→        if (!agentResult.success) {
   306→          for (const issue of agentResult.error.issues) {
   307→            errors.push({
   308→              file: filePath,
   309→              path: `agents[${i}].${issue.path.join(".")}`,
   310→              message: issue.message,
   311→              details: issue,
   312→            });
   313→          }
   314→        }
   315→
   316→        // Strict ULID validation
   317→        if (agent && typeof agent === "object" && "_ulid" in agent) {
   318→          const ulidResult = UlidSchema.safeParse(
   319→            (agent as Record<string, unknown>)._ulid,
   320→          );
   321→          if (!ulidResult.success) {
   322→            errors.push({
   323→              file: filePath,
   324→              path: `agents[${i}]._ulid`,
   325→              message: "Invalid ULID format (expected 26 characters)",
   326→            });
   327→          }
   328→        }
   329→      }
   330→    }
   331→
   332→    // Validate each workflow with strict ULID validation
   333→    if (
   334→      raw &&
   335→      typeof raw === "object" &&
   336→      "workflows" in raw &&
   337→      Array.isArray((raw as Record<string, unknown>).workflows)
   338→    ) {
   339→      const workflows = (raw as Record<string, unknown>).workflows as unknown[];
   340→      for (let i = 0; i < workflows.length; i++) {
   341→        const workflow = workflows[i];
   342→        const workflowResult = WorkflowSchema.safeParse(workflow);
   343→        if (!workflowResult.success) {
   344→          for (const issue of workflowResult.error.issues) {
   345→            errors.push({
   346→              file: filePath,
   347→              path: `workflows[${i}].${issue.path.join(".")}`,
   348→              message: issue.message,
   349→              details: issue,
   350→            });
   351→          }
   352→        }
   353→
   354→        // Strict ULID validation
   355→        if (workflow && typeof workflow === "object" && "_ulid" in workflow) {
   356→          const ulidResult = UlidSchema.safeParse(
   357→            (workflow as Record<string, unknown>)._ulid,
   358→          );
   359→          if (!ulidResult.success) {
   360→            errors.push({
   361→              file: filePath,
   362→              path: `workflows[${i}]._ulid`,
   363→              message: "Invalid ULID format (expected 26 characters)",
   364→            });
   365→          }
   366→        }
   367→      }
   368→    }
   369→
   370→    // Validate each convention with strict ULID validation
   371→    if (
   372→      raw &&
   373→      typeof raw === "object" &&
   374→      "conventions" in raw &&
   375→      Array.isArray((raw as Record<string, unknown>).conventions)
   376→    ) {
   377→      const conventions = (raw as Record<string, unknown>)
   378→        .conventions as unknown[];
   379→      for (let i = 0; i < conventions.length; i++) {
   380→        const convention = conventions[i];
   381→        const conventionResult = ConventionSchema.safeParse(convention);
   382→        if (!conventionResult.success) {
   383→          for (const issue of conventionResult.error.issues) {
   384→            errors.push({
   385→              file: filePath,
   386→              path: `conventions[${i}].${issue.path.join(".")}`,
   387→              message: issue.message,
   388→              details: issue,
   389→            });
   390→          }
   391→        }
   392→
   393→        // Strict ULID validation
   394→        if (
   395→          convention &&
   396→          typeof convention === "object" &&
   397→          "_ulid" in convention
   398→        ) {
   399→          const ulidResult = UlidSchema.safeParse(
   400→            (convention as Record<string, unknown>)._ulid,
   401→          );
   402→          if (!ulidResult.success) {
   403→            errors.push({
   404→              file: filePath,
   405→              path: `conventions[${i}]._ulid`,
   406→              message: "Invalid ULID format (expected 26 characters)",
   407→            });
   408→          }
   409→        }
   410→      }
   411→    }
   412→
   413→    // Validate each observation with strict ULID validation
   414→    if (
   415→      raw &&
   416→      typeof raw === "object" &&
   417→      "observations" in raw &&
   418→      Array.isArray((raw as Record<string, unknown>).observations)
   419→    ) {
   420→      const observations = (raw as Record<string, unknown>)
   421→        .observations as unknown[];
   422→      for (let i = 0; i < observations.length; i++) {
   423→        const observation = observations[i];
   424→        const observationResult = ObservationSchema.safeParse(observation);
   425→        if (!observationResult.success) {
   426→          for (const issue of observationResult.error.issues) {
   427→            errors.push({
   428→              file: filePath,
   429→              path: `observations[${i}].${issue.path.join(".")}`,
   430→              message: issue.message,
   431→              details: issue,
   432→            });
   433→          }
   434→        }
   435→
   436→        // Strict ULID validation
   437→        if (
   438→          observation &&
   439→          typeof observation === "object" &&
   440→          "_ulid" in observation
   441→        ) {
   442→          const ulidResult = UlidSchema.safeParse(
   443→            (observation as Record<string, unknown>)._ulid,
   444→          );
   445→          if (!ulidResult.success) {
   446→            errors.push({
   447→              file: filePath,
   448→              path: `observations[${i}]._ulid`,
   449→              message: "Invalid ULID format (expected 26 characters)",
   450→            });
   451→          }
   452→        }
   453→      }
   454→    }
   455→
   456→    // AC: @skill-validation ac-4 - validate each skill with strict ULID validation
   457→    if (
   458→      raw &&
   459→      typeof raw === "object" &&
   460→      "skills" in raw &&
   461→      Array.isArray((raw as Record<string, unknown>).skills)
   462→    ) {
   463→      const skills = (raw as Record<string, unknown>).skills as unknown[];
   464→      for (let i = 0; i < skills.length; i++) {
   465→        const skill = skills[i];
   466→        const skillResult = SkillSchema.safeParse(skill);
   467→        if (!skillResult.success) {
   468→          for (const issue of skillResult.error.issues) {
   469→            errors.push({
   470→              file: filePath,
   471→              path: `skills[${i}].${issue.path.join(".")}`,
   472→              message: issue.message,
   473→              details: issue,
   474→            });
   475→          }
   476→        }
   477→
   478→        // Strict ULID validation
   479→        if (skill && typeof skill === "object" && "_ulid" in skill) {
   480→          const ulidResult = UlidSchema.safeParse(
   481→            (skill as Record<string, unknown>)._ulid,
   482→          );
   483→          if (!ulidResult.success) {
   484→            errors.push({
   485→              file: filePath,
   486→              path: `skills[${i}]._ulid`,
   487→              message: "Invalid ULID format (expected 26 characters)",
   488→            });
   489→          }
   490→        }
   491→      }
   492→    }
   493→  } catch (err) {
   494→    errors.push({
   495→      file: filePath,
   496→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   497→    });
   498→  }
   499→
   500→  return errors;
   501→}
   502→
   503→/**
   504→ * Recursively validate spec items in a structure
   505→ */
   506→function validateSpecItemRecursive(
   507→  raw: unknown,
   508→  file: string,
   509→  pathPrefix: string,
   510→  errors: SchemaValidationError[],
   511→): void {
   512→  if (!raw || typeof raw !== "object") return;
   513→
   514→  // Check if this is a spec item (has _ulid)
   515→  if ("_ulid" in raw) {
   516→    const result = SpecItemSchema.safeParse(raw);
   517→    if (!result.success) {
   518→      for (const issue of result.error.issues) {
   519→        errors.push({
   520→          file,
   521→          path: pathPrefix
   522→            ? `${pathPrefix}.${issue.path.join(".")}`
   523→            : issue.path.join("."),
   524→          message: issue.message,
   525→          details: issue,
   526→        });
   527→      }
   528→    }
   529→  }
   530→
   531→  // Recurse into nested structures
   532→  const nestedFields = [
   533→    "modules",
   534→    "features",
   535→    "requirements",
   536→    "constraints",
   537→    "decisions",
   538→    "items",
   539→  ];
   540→  const obj = raw as Record<string, unknown>;
   541→
   542→  for (const field of nestedFields) {
   543→    if (field in obj && Array.isArray(obj[field])) {
   544→      const arr = obj[field] as unknown[];
   545→      for (let i = 0; i < arr.length; i++) {
   546→        const newPath = pathPrefix
   547→          ? `${pathPrefix}.${field}[${i}]`
   548→          : `${field}[${i}]`;
   549→        validateSpecItemRecursive(arr[i], file, newPath, errors);
   550→      }
   551→    }
   552→  }
   553→}
   554→
   555→// ============================================================
   556→// ORPHAN DETECTION
   557→// ============================================================
   558→
   559→/**
   560→ * Find items that are not referenced by any other item
   561→ */
   562→function findOrphans(
   563→  tasks: LoadedTask[],
   564→  items: LoadedSpecItem[],
   565→  index: ReferenceIndex,
   566→): OrphanItem[] {
   567→  const orphans: OrphanItem[] = [];
   568→
   569→  // Build set of all referenced ULIDs
   570→  const referenced = new Set<string>();
   571→
   572→  const allItems = [...tasks, ...items];
   573→
   574→  // Fields that contain references
   575→  const refFields = [
   576→    "depends_on",
   577→    "blocked_by",
   578→    "implements",
   579→    "relates_to",
   580→    "tests",
   581→    "supersedes",
   582→    "spec_ref",
   583→    "context",
   584→  ];
   585→
   586→  for (const item of allItems) {
   587→    const obj = item as unknown as Record<string, unknown>;
   588→
   589→    for (const field of refFields) {
   590→      const value = obj[field];
   591→
   592→      if (typeof value === "string" && value.startsWith("@")) {
   593→        const resolved = index.resolve(value);
   594→        if (resolved.ok) {
   595→          referenced.add(resolved.ulid);
   596→        }
   597→      } else if (Array.isArray(value)) {
   598→        for (const v of value) {
   599→          if (typeof v === "string" && v.startsWith("@")) {
   600→            const resolved = index.resolve(v);
   601→            if (resolved.ok) {
   602→              referenced.add(resolved.ulid);
   603→            }
   604→          }
   605→        }
   606→      }
   607→    }
   608→  }
   609→
   610→  // Find items not in the referenced set
   611→  // Skip entry point types: modules are spec entry points, tasks are work items
   612→  const entryPointTypes = ["module", "task", "epic", "bug", "spike", "infra"];
   613→
   614→  for (const item of items) {
   615→    // Only check spec items, not tasks
   616→    if (!referenced.has(item._ulid)) {
   617→      // Skip entry point types
   618→      if (entryPointTypes.includes(item.type || "")) continue;
   619→
   620→      // Skip nested items - they're implicitly referenced by their parent
   621→      // _path indicates nesting (e.g., "features[0].requirements[2]")
   622→      if (item._path) continue;
   623→
   624→      orphans.push({
   625→        ulid: item._ulid,
   626→        title: item.title,
   627→        type: item.type || "unknown",
   628→        file: item._sourceFile,
   629→      });
   630→    }
   631→  }
   632→
   633→  return orphans;
   634→}
   635→
   636→// ============================================================
   637→// TRAIT CYCLE DETECTION
   638→// ============================================================
   639→
   640→/**
   641→ * Detect circular trait references
   642→ * AC: @trait-edge-cases ac-2
   643→ */
   644→function detectTraitCycles(
   645→  items: LoadedSpecItem[],
   646→  index: ReferenceIndex,
   647→): TraitCycleError[] {
   648→  const errors: TraitCycleError[] = [];
   649→  const traits = items.filter((item) => item.type === "trait");
   650→
   651→  // Build adjacency list: trait ULID → trait ULIDs it references
   652→  const graph = new Map<string, string[]>();
   653→  const traitInfo = new Map<string, { ref: string; title: string }>();
   654→
   655→  for (const trait of traits) {
   656→    const ref = trait.slugs?.[0]
   657→      ? `@${trait.slugs[0]}`
   658→      : `@${index.shortUlid(trait._ulid)}`;
   659→    traitInfo.set(trait._ulid, { ref, title: trait.title });
   660→
   661→    const dependencies: string[] = [];
   662→    if (trait.traits && trait.traits.length > 0) {
   663→      for (const traitRef of trait.traits) {
   664→        const result = index.resolve(traitRef);
   665→        if (result.ok) {
   666→          dependencies.push(result.ulid);
   667→        }
   668→      }
   669→    }
   670→    graph.set(trait._ulid, dependencies);
   671→  }
   672→
   673→  // DFS-based cycle detection
   674→  const visiting = new Set<string>();
   675→  const visited = new Set<string>();
   676→
   677→  function dfs(ulid: string, path: string[]): string[] | null {
   678→    if (visiting.has(ulid)) {
   679→      // Found a cycle - return the cycle path
   680→      const cycleStart = path.indexOf(ulid);
   681→      return path.slice(cycleStart);
   682→    }
   683→
   684→    if (visited.has(ulid)) {
   685→      return null; // Already checked this path
   686→    }
   687→
   688→    visiting.add(ulid);
   689→    path.push(ulid);
   690→
   691→    const dependencies = graph.get(ulid) || [];
   692→    for (const depUlid of dependencies) {
   693→      const cycle = dfs(depUlid, path);
   694→      if (cycle) {
   695→        return cycle;
   696→      }
   697→    }
   698→
   699→    visiting.delete(ulid);
   700→    visited.add(ulid);
   701→    path.pop();
   702→
   703→    return null;
   704→  }
   705→
   706→  // Check each trait for cycles
   707→  for (const trait of traits) {
   708→    if (!visited.has(trait._ulid)) {
   709→      const cycle = dfs(trait._ulid, []);
   710→      if (cycle) {
   711→        const info = traitInfo.get(cycle[0]);
   712→        if (info) {
   713→          const cycleRefs = cycle.map((ulid) => {
   714→            const cycleInfo = traitInfo.get(ulid);
   715→            return cycleInfo ? cycleInfo.ref : `@${index.shortUlid(ulid)}`;
   716→          });
   717→
   718→          errors.push({
   719→            traitRef: info.ref,
   720→            traitTitle: info.title,
   721→            cycle: cycleRefs,
   722→            message: `Circular trait reference: ${cycleRefs.join(" → ")} → ${cycleRefs[0]}`,
   723→          });
   724→        }
   725→
   726→        // Mark all traits in cycle as visited to avoid duplicate errors
   727→        for (const ulid of cycle) {
   728→          visited.add(ulid);
   729→        }
   730→      }
   731→    }
   732→  }
   733→
   734→  return errors;
   735→}
   736→
   737→// ============================================================
   738→// COMPLETENESS VALIDATION
   739→// ============================================================
   740→
   741→/**
   742→ * Recursively find all test files in a directory.
   743→ * Matches .test.ts, .test.js, .spec.ts, and .spec.js files.
   744→ */
   745→async function findTestFilesRecursive(dir: string): Promise<string[]> {
   746→  const testFiles: string[] = [];
   747→
   748→  try {
   749→    const entries = await fs.readdir(dir, { withFileTypes: true });
   750→
   751→    for (const entry of entries) {
   752→      const fullPath = path.join(dir, entry.name);
   753→
   754→      if (entry.isDirectory()) {
   755→        // Recurse into subdirectories
   756→        const subFiles = await findTestFilesRecursive(fullPath);
   757→        testFiles.push(...subFiles);
   758→      } else if (
   759→        entry.isFile() &&
   760→        (entry.name.endsWith(".test.ts") ||
   761→          entry.name.endsWith(".test.js") ||
   762→          entry.name.endsWith(".spec.ts") ||
   763→          entry.name.endsWith(".spec.js"))
   764→      ) {
   765→        testFiles.push(fullPath);
   766→      }
   767→    }
   768→  } catch {
   769→    // Directory doesn't exist or can't be read - return empty
   770→  }
   771→
   772→  return testFiles;
   773→}
   774→
   775→/**
   776→ * Scan a directory of test files for AC annotations and add to the coverage set.
   777→ */
   778→async function scanDirForACAnnotations(
   779→  dir: string,
   780→  coveredACs: Set<string>
   781→): Promise<void> {
   782→  try {
   783→    await fs.access(dir);
   784→  } catch {
   785→    // Directory doesn't exist - skip
   786→    return;
   787→  }
   788→
   789→  const testFiles = await findTestFilesRecursive(dir);
   790→
   791→  for (const filePath of testFiles) {
   792→    const content = await fs.readFile(filePath, "utf-8");
   793→
   794→    // Match AC annotations: // AC: @spec-ref ac-N
   795→    // Also handle multiple ACs on one line: // AC: @spec-ref ac-1, ac-2
   796→    const acPattern =
   797→      /\/\/\s*AC:\s*(@[\w-]+)(?:\s+(ac-\d+(?:\s*,\s*ac-\d+)*))?/g;
   798→    let match;
   799→
   800→    while ((match = acPattern.exec(content)) !== null) {
   801→      const specRef = match[1]; // @spec-ref
   802→      const acList = match[2]; // "ac-1, ac-2" or just "ac-1" or undefined
   803→
   804→      if (acList) {
   805→        // Split by comma and trim
   806→        const acs = acList.split(",").map((ac) => ac.trim());
   807→        for (const ac of acs) {
   808→          coveredACs.add(`${specRef} ${ac}`);
   809→        }
   810→      } else {
   811→        // No specific AC mentioned, just the spec ref
   812→        // We'll consider this as generic coverage
   813→        coveredACs.add(specRef);
   814→      }
   815→    }
   816→  }
   817→}
   818→
   819→/**
   820→ * Scan test files for AC annotations to build coverage index.
   821→ * Scans:
   822→ * - tests/ (unit/integration tests, .test.ts/.test.js)
   823→ * - packages/web-ui/tests/e2e/ (E2E Playwright tests, .spec.ts/.spec.js)
   824→ * Returns a Set of covered ACs in format "@spec-ref ac-N"
   825→ */
   826→export async function scanTestCoverage(rootDir: string): Promise<Set<string>> {
   827→  const coveredACs = new Set<string>();
   828→
   829→  // Scan primary tests directory (unit/integration tests)
   830→  await scanDirForACAnnotations(path.join(rootDir, "tests"), coveredACs);
   831→
   832→  // Scan E2E test directory (Playwright specs)
   833→  await scanDirForACAnnotations(
   834→    path.join(rootDir, "packages", "web-ui", "tests", "e2e"),
   835→    coveredACs
   836→  );
   837→
   838→  return coveredACs;
   839→}
   840→
   841→/**
   842→ * Compute coverage status for acceptance criteria of a spec item.
   843→ * Shared utility used by both daemon API and JSON export.
   844→ *
   845→ * @param item - The spec item containing acceptance_criteria
   846→ * @param coveredACs - Set of covered AC references from scanTestCoverage()
   847→ * @returns Array of ACs with covered field populated
   848→ */
   849→export function computeACCoverage<
   850→  T extends { id: string; given: string; when: string; then: string },
   851→>(
   852→  item: { _ulid: string; slugs?: string[]; acceptance_criteria?: T[] },
   853→  coveredACs: Set<string>,
   854→): Array<T & { covered: boolean }> {
   855→  if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
   856→    return [];
   857→  }
   858→
   859→  return item.acceptance_criteria.map((ac, index) => {
   860→    const acId = `ac-${index + 1}`;
   861→    const possibleRefs: string[] = [];
   862→
   863→    // Try with primary slug
   864→    if (item.slugs && item.slugs.length > 0) {
   865→      possibleRefs.push(`@${item.slugs[0]} ${acId}`);
   866→      possibleRefs.push(`@${item.slugs[0]}`);
   867→    }
   868→
   869→    // Try all ULID prefix lengths (8..full) to support shortest-unique refs
   870→    for (let prefixLength = 8; prefixLength <= item._ulid.length; prefixLength++) {
   871→      const prefix = item._ulid.slice(0, prefixLength);
   872→      possibleRefs.push(`@${prefix} ${acId}`);
   873→      possibleRefs.push(`@${prefix}`);
   874→    }
   875→
   876→    const covered = possibleRefs.some((ref) => coveredACs.has(ref));
   877→    return { ...ac, covered };
   878→  });
   879→}
   880→
   881→/**
   882→ * Check spec items for completeness
   883→ * AC: @spec-completeness ac-1, ac-2, ac-3
   884→ * AC: @trait-validation ac-1, ac-2, ac-3
   885→ */
   886→async function checkCompleteness(
   887→  items: LoadedSpecItem[],
   888→  index: ReferenceIndex,
   889→  rootDir: string,
   890→  traitIndex?: TraitIndex,
   891→): Promise<CompletenessWarning[]> {
   892→  const warnings: CompletenessWarning[] = [];
   893→
   894→  // Scan test files for AC coverage
   895→  const coveredACs = await scanTestCoverage(rootDir);
   896→
   897→  for (const item of items) {
   898→    const itemRef = item.slugs?.[0]
   899→      ? `@${item.slugs[0]}`
   900→      : `@${index.shortUlid(item._ulid)}`;
   901→    const isTrait = item.type === "trait";
   902→
   903→    // AC: @spec-completeness ac-1
   904→    // AC: @trait-type ac-2 - Traits should have acceptance criteria for completeness
   905→    // Check for missing acceptance criteria
   906→    if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
   907→      warnings.push({
   908→        type: "missing_acceptance_criteria",
   909→        itemRef,
   910→        itemTitle: item.title,
   911→        message: `${isTrait ? "Trait" : "Item"} ${itemRef} has no acceptance criteria`,
   912→      });
   913→    }
   914→
   915→    // AC: @spec-completeness ac-2
   916→    // AC: @trait-type ac-3 - Traits should have description for completeness
   917→    // Check for missing description
   918→    if (!item.description || item.description.trim() === "") {
   919→      warnings.push({
   920→        type: "missing_description",
   921→        itemRef,
   922→        itemTitle: item.title,
   923→        message: `${isTrait ? "Trait" : "Item"} ${itemRef} has no description`,
   924→      });
   925→    }
   926→
   927→    // AC: @spec-completeness ac-3
   928→    // Check for status inconsistency between parent and children
   929→    if (item.status?.implementation === "implemented") {
   930→      // Check if this item has children with not_started status
   931→      const childFields = [
   932→        "modules",
   933→        "features",
   934→        "requirements",
   935→        "constraints",
   936→        "epics",
   937→        "themes",
   938→        "capabilities",
   939→      ];
   940→
   941→      for (const field of childFields) {
   942→        const children = (item as any)[field];
   943→        if (Array.isArray(children)) {
   944→          for (const child of children) {
   945→            if (child.status?.implementation === "not_started") {
   946→              const childRef = child.slugs?.[0]
   947→                ? `@${child.slugs[0]}`
   948→                : child._ulid
   949→                  ? `@${shortestUniqueUlid(
   950→                    child._ulid,
   951→                    items.map((candidate) => candidate._ulid),
   952→                  )}`
   953→                  : "@unknown";
   954→              warnings.push({
   955→                type: "status_inconsistency",
   956→                itemRef,
   957→                itemTitle: item.title,
   958→                message: `Parent ${itemRef} is implemented but child ${childRef} is not_started`,
   959→                details: `Child: ${child.title}`,
   960→              });
   961→            }
   962→          }
   963→        }
   964→      }
   965→    }
   966→
   967→    // Check for test coverage of acceptance criteria
   968→    if (item.acceptance_criteria && item.acceptance_criteria.length > 0) {
   969→      const uncoveredACs: string[] = [];
   970→
   971→      for (const ac of item.acceptance_criteria) {
   972→        // Build all possible references for this AC
   973→        const possibleRefs: string[] = [];
   974→
   975→        // Try with primary slug
   976→        if (item.slugs && item.slugs.length > 0) {
   977→          possibleRefs.push(`@${item.slugs[0]} ${ac.id}`);
   978→          // Also check for just the slug without specific AC
   979→          possibleRefs.push(`@${item.slugs[0]}`);
   980→        }
   981→
   982→        // Try all ULID prefix lengths (8..full) to support shortest-unique refs
   983→        for (let prefixLength = 8; prefixLength <= item._ulid.length; prefixLength++) {
   984→          const prefix = item._ulid.slice(0, prefixLength);
   985→          possibleRefs.push(`@${prefix} ${ac.id}`);
   986→          possibleRefs.push(`@${prefix}`);
   987→        }
   988→
   989→        // Check if any of these references are covered
   990→        const isCovered = possibleRefs.some((ref) => coveredACs.has(ref));
   991→
   992→        if (!isCovered) {
   993→          uncoveredACs.push(ac.id);
   994→        }
   995→      }
   996→
   997→      // Only warn if there are uncovered ACs
   998→      if (uncoveredACs.length > 0) {
   999→        warnings.push({
  1000→          type: "missing_test_coverage",
  1001→          subtype: "own_ac",
  1002→          itemRef,
  1003→          itemTitle: item.title,
  1004→          message: `Item ${itemRef} has ${uncoveredACs.length} AC(s) without test coverage`,
  1005→          details: `Uncovered: ${uncoveredACs.join(", ")}`,
  1006→        });
  1007→      }
  1008→    }
  1009→
  1010→    // AC: @trait-validation ac-1, ac-2
  1011→    // Check for test coverage of trait acceptance criteria
  1012→    if (traitIndex && item.traits && item.traits.length > 0) {
  1013→      const inheritedACs = traitIndex.getInheritedAC(item._ulid);
  1014→      const uncoveredTraitACs: Array<{ traitSlug: string; acId: string }> = [];
  1015→
  1016→      for (const { trait, ac } of inheritedACs) {
  1017→        // Build all possible references for this trait AC
  1018→        const possibleRefs: string[] = [];
  1019→
  1020→        // Try with trait slug
  1021→        possibleRefs.push(`@${trait.slug} ${ac.id}`);
  1022→        possibleRefs.push(`@${trait.slug}`);
  1023→
  1024→        // Try all trait ULID prefix lengths (8..full) to support shortest-unique refs
  1025→        for (let prefixLength = 8; prefixLength <= trait.ulid.length; prefixLength++) {
  1026→          const prefix = trait.ulid.slice(0, prefixLength);
  1027→          possibleRefs.push(`@${prefix} ${ac.id}`);
  1028→          possibleRefs.push(`@${prefix}`);
  1029→        }
  1030→
  1031→        // Check if any of these references are covered
  1032→        const isCovered = possibleRefs.some((ref) => coveredACs.has(ref));
  1033→
  1034→        if (!isCovered) {
  1035→          uncoveredTraitACs.push({ traitSlug: trait.slug, acId: ac.id });
  1036→        }
  1037→      }
  1038→
  1039→      // Only warn if there are uncovered trait ACs
  1040→      if (uncoveredTraitACs.length > 0) {
  1041→        const details = uncoveredTraitACs
  1042→          .map(({ traitSlug, acId }) => `@${traitSlug} ${acId}`)
  1043→          .join(", ");
  1044→        warnings.push({
  1045→          type: "missing_test_coverage",
  1046→          subtype: "trait_ac",
  1047→          itemRef,
  1048→          itemTitle: item.title,
  1049→          message: `Item ${itemRef} has ${uncoveredTraitACs.length} inherited trait AC(s) without test coverage`,
  1050→          details: `Uncovered trait ACs: ${details}`,
  1051→        });
  1052→      }
  1053→    }
  1054→
  1055→    // AC: @trait-retrospective ac-2, ac-3
  1056→    // Check retrospective specs have required verification metadata
  1057→    const isRetrospective = item.traits?.includes("@trait-retrospective");
  1058→    if (isRetrospective) {
  1059→      const isImplementedOrVerified =
  1060→        item.status?.implementation === "implemented" ||
  1061→        item.status?.implementation === "verified";
  1062→
  1063→      // AC: @trait-retrospective ac-2
  1064→      // Retrospective specs with implemented/verified status must have verification metadata
  1065→      if (isImplementedOrVerified) {
  1066→        if (!item.verified_at || !item.verified_by) {
  1067→          warnings.push({
  1068→            type: "status_inconsistency",
  1069→            itemRef,
  1070→            itemTitle: item.title,
  1071→            message: `Retrospective spec ${itemRef} is ${item.status?.implementation} but missing verified_at/verified_by`,
  1072→            details:
  1073→              "Specs using @trait-retrospective must have verified_at and verified_by fields when marked as implemented or verified",
  1074→          });
  1075→        }
  1076→      }
  1077→
  1078→      // Inverse validation: If verification metadata exists, status should be implemented/verified
  1079→      if ((item.verified_at || item.verified_by) && !isImplementedOrVerified) {
  1080→        warnings.push({
  1081→          type: "status_inconsistency",
  1082→          itemRef,
  1083→          itemTitle: item.title,
  1084→          message: `Retrospective spec ${itemRef} has verification metadata but status is not implemented/verified`,
  1085→          details:
  1086→            "Retrospective specs with verified_at/verified_by should have implementation status set to 'implemented' or 'verified'",
  1087→        });
  1088→      }
  1089→    }
  1090→  }
  1091→
  1092→  return warnings;
  1093→}
  1094→
  1095→// ============================================================
  1096→// AC SCHEMA DRIFT DETECTION
  1097→// ============================================================
  1098→
  1099→/**
  1100→ * Known schema fields for SpecItem
  1101→ * These are the actual fields defined in SpecItemSchema
  1102→ */
  1103→const SPEC_ITEM_FIELDS = new Set([
  1104→  "_ulid",
  1105→  "slugs",
  1106→  "title",
  1107→  "type",
  1108→  "status",
  1109→  "maturity",
  1110→  "implementation",
  1111→  "priority",
  1112→  "tags",
  1113→  "description",
  1114→  "acceptance_criteria",
  1115→  "depends_on",
  1116→  "implements",
  1117→  "relates_to",
  1118→  "tests",
  1119→  "traits",
  1120→  "supersedes",
  1121→  "traceability",
  1122→  "created",
  1123→  "created_by",
  1124→  "deprecated_in",
  1125→  "superseded_by",
  1126→  "verified_at",
  1127→  "verified_by",
  1128→  "notes",
  1129→]);
  1130→
  1131→/**
  1132→ * Known schema fields for Task
  1133→ * These are the actual fields defined in TaskSchema
  1134→ */
  1135→const TASK_FIELDS = new Set([
  1136→  "_ulid",
  1137→  "slugs",
  1138→  "title",
  1139→  "type",
  1140→  "description",
  1141→  "spec_ref",
  1142→  "derivation",
  1143→  "meta_ref",
  1144→  "plan_ref",
  1145→  "origin",
  1146→  "status",
  1147→  "blocked_by",
  1148→  "closed_reason",
  1149→  "depends_on",
  1150→  "context",
  1151→  "priority",
  1152→  "complexity",
  1153→  "tags",
  1154→  "assignee",
  1155→  "vcs_refs",
  1156→  "created_at",
  1157→  "started_at",
  1158→  "completed_at",
  1159→  "notes",
  1160→  "todos",
  1161→  "automation",
  1162→]);
  1163→
  1164→/**
  1165→ * Known fields that are referenced but are parse-time or conceptual only
  1166→ * These are common pseudo-fields that ACs reference but don't exist in schema
  1167→ */
  1168→const CONCEPTUAL_FIELDS = new Set([
  1169→  "children", // Hierarchy is parse-time only
  1170→  "parent", // Parent references are derived, not stored
  1171→  "modules", // These are container structures in YAML, not item fields
  1172→  "features",
  1173→  "requirements",
  1174→  "constraints",
  1175→  "decisions",
  1176→  "epics",
  1177→  "themes",
  1178→  "capabilities",
  1179→]);
  1180→
  1181→/**
  1182→ * Extract field reference patterns from AC text
  1183→ * Looks for patterns like:
  1184→ * - item.field
  1185→ * - spec.field
  1186→ * - task.field
  1187→ * - status.field
  1188→ * - spec_ref.field
  1189→ * - the field
  1190→ * - their field
  1191→ * - item's field
  1192→ */
  1193→/**
  1194→ * File extensions to exclude from field matching
  1195→ * These are common file extensions that would otherwise match our patterns
  1196→ */
  1197→const FILE_EXTENSIONS = new Set([
  1198→  "yaml",
  1199→  "yml",
  1200→  "json",
  1201→  "js",
  1202→  "ts",
  1203→  "md",
  1204→  "txt",
  1205→  "html",
  1206→  "css",
  1207→  "log",
  1208→]);
  1209→
  1210→function extractFieldReferences(text: string): Array<{ context: string; field: string }> {
  1211→  const references: Array<{ context: string; field: string }> = [];
  1212→
  1213→  // Pattern: context.field (e.g., item.status, spec_ref.children)
  1214→  // This matches entity.property patterns in prose
  1215→  const dotPattern = /\b(item|spec|task|status|spec_ref|task_ref|meta_ref|plan_ref)\.(\w+)/gi;
  1216→  let match: RegExpExecArray | null;
  1217→  while ((match = dotPattern.exec(text)) !== null) {
  1218→    const field = match[2].toLowerCase();
  1219→    // Skip file extensions (e.g., spec.yaml, task.json)
  1220→    if (FILE_EXTENSIONS.has(field)) {
  1221→      continue;
  1222→    }
  1223→    references.push({ context: match[1].toLowerCase(), field });
  1224→  }
  1225→
  1226→  // Pattern: "the <field>" when discussing items/tasks (common in ACs)
  1227→  // Only match known schema-like words to avoid false positives
  1228→  const thePattern = /\bthe\s+(status|children|parent|spec_ref|depends_on|traits|tags|notes|todos|acceptance_criteria)\b/gi;
  1229→  while ((match = thePattern.exec(text)) !== null) {
  1230→    references.push({ context: "item", field: match[1].toLowerCase() });
  1231→  }
  1232→
  1233→  return references;
  1234→}
  1235→
  1236→/**
  1237→ * Check if a field exists in the appropriate schema
  1238→ */
  1239→function isValidSchemaField(context: string, field: string): { valid: boolean; reason?: string } {
  1240→  // If it's a known conceptual field, it's technically invalid but we can give a specific message
  1241→  if (CONCEPTUAL_FIELDS.has(field)) {
  1242→    return { valid: false, reason: `'${field}' is a parse-time/conceptual field, not stored in schema` };
  1243→  }
  1244→
  1245→  // Check based on context
  1246→  switch (context) {
  1247→    case "spec":
  1248→    case "item":
  1249→      if (SPEC_ITEM_FIELDS.has(field)) {
  1250→        return { valid: true };
  1251→      }
  1252→      break;
  1253→
  1254→    case "task":
  1255→      if (TASK_FIELDS.has(field)) {
  1256→        return { valid: true };
  1257→      }
  1258→      break;
  1259→
  1260→    case "status":
  1261→      // status.maturity, status.implementation are valid for specs
  1262→      if (field === "maturity" || field === "implementation") {
  1263→        return { valid: true };
  1264→      }
  1265→      break;
  1266→
  1267→    case "spec_ref":
  1268→    case "task_ref":
  1269→    case "meta_ref":
  1270→    case "plan_ref":
  1271→      // These are string references, not objects with fields
  1272→      return { valid: false, reason: `'${context}' is a reference string, not an object with fields` };
  1273→  }
  1274→
  1275→  // Check if field exists in either schema (might be ambiguous context)
  1276→  if (SPEC_ITEM_FIELDS.has(field) || TASK_FIELDS.has(field)) {
  1277→    return { valid: true };
  1278→  }
  1279→
  1280→  return { valid: false, reason: `'${field}' is not a known schema field` };
  1281→}
  1282→
  1283→/**
  1284→ * Check acceptance criteria for field references that don't exist in schema
  1285→ * Catches drift between spec prose and implementation reality.
  1286→ */
  1287→export function checkACSchemaReferences(
  1288→  items: LoadedSpecItem[],
  1289→): CompletenessWarning[] {
  1290→  const warnings: CompletenessWarning[] = [];
  1291→  const itemUlids = items.map((item) => item._ulid);
  1292→
  1293→  for (const item of items) {
  1294→    if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
  1295→      continue;
  1296→    }
  1297→
  1298→    const itemRef = item.slugs?.[0]
  1299→      ? `@${item.slugs[0]}`
  1300→      : `@${shortestUniqueUlid(item._ulid, itemUlids)}`;
  1301→
  1302→    for (const ac of item.acceptance_criteria) {
  1303→      // Check all three parts of the AC for field references
  1304→      const textToCheck = `${ac.given} ${ac.when} ${ac.then}`;
  1305→      const fieldRefs = extractFieldReferences(textToCheck);
  1306→
  1307→      for (const { context, field } of fieldRefs) {
  1308→        const result = isValidSchemaField(context, field);
  1309→        if (!result.valid) {
  1310→          warnings.push({
  1311→            type: "ac_schema_field_mismatch",
  1312→            itemRef,
  1313→            itemTitle: item.title,
  1314→            message: `AC ${ac.id} references '${context}.${field}' which doesn't exist in schema`,
  1315→            details: result.reason,
  1316→          });
  1317→        }
  1318→      }
  1319→    }
  1320→  }
  1321→
  1322→  return warnings;
  1323→}
  1324→
  1325→// ============================================================
  1326→// SKILL CONTENT VALIDATION
  1327→// ============================================================
  1328→
  1329→/**
  1330→ * Validate that skill meta entries have corresponding SKILL.md files.
  1331→ * AC: @skill-content-model ac-3 - missing content file reports validation error
  1332→ */
  1333→async function validateSkillContentFiles(
  1334→  ctx: KspecContext,
  1335→  skills: LoadedSkill[],
  1336→): Promise<SchemaValidationError[]> {
  1337→  const errors: SchemaValidationError[] = [];
  1338→
  1339→  for (const skill of skills) {
  1340→    const contentPath = getSkillContentPath(ctx, skill.id);
  1341→
  1342→    try {
  1343→      await fs.access(contentPath);
  1344→    } catch {
  1345→      // File doesn't exist - report validation error
  1346→      errors.push({
  1347→        file: skill._sourceFile || "kynetic.meta.yaml",
  1348→        path: `skills.${skill.id}`,
  1349→        message: `Skill '${skill.id}' is missing content file at ${contentPath}`,
  1350→      });
  1351→    }
  1352→  }
  1353→
  1354→  return errors;
  1355→}
  1356→
  1357→// ============================================================
  1358→// AUTOMATION VALIDATION
  1359→// ============================================================
  1360→
  1361→/**
  1362→ * Check task automation status for warnings
  1363→ * AC: @task-automation-eligibility ac-21, ac-23
  1364→ */
  1365→function checkAutomationEligibility(
  1366→  tasks: LoadedTask[],
  1367→  index: ReferenceIndex,
  1368→): CompletenessWarning[] {
  1369→  const warnings: CompletenessWarning[] = [];
  1370→
  1371→  for (const task of tasks) {
  1372→    const taskRef = task.slugs?.[0]
  1373→      ? `@${task.slugs[0]}`
  1374→      : `@${index.shortUlid(task._ulid)}`;
  1375→
  1376→    // AC: @task-automation-eligibility ac-21
  1377→    // Warn if eligible but no spec_ref
  1378→    if (task.automation === "eligible" && !task.spec_ref) {
  1379→      warnings.push({
  1380→        type: "automation_eligible_no_spec",
  1381→        itemRef: taskRef,
  1382→        itemTitle: task.title,
  1383→        message: `Task ${taskRef} is automation: eligible but has no spec_ref - eligible tasks should have linked specs`,
  1384→      });
  1385→    }
  1386→
  1387→    // AC: @task-automation-eligibility ac-23
  1388→    // Warn if eligible but spec_ref doesn't resolve
  1389→    if (task.automation === "eligible" && task.spec_ref) {
  1390→      const specResult = index.resolve(task.spec_ref);
  1391→      if (!specResult.ok) {
  1392→        warnings.push({
  1393→          type: "automation_eligible_no_spec",
  1394→          itemRef: taskRef,
  1395→          itemTitle: task.title,
  1396→          message: `Task ${taskRef} is automation: eligible but spec_ref ${task.spec_ref} cannot be resolved`,
  1397→        });
  1398→      }
  1399→    }
  1400→  }
  1401→
  1402→  return warnings;
  1403→}
  1404→
  1405→// ============================================================
  1406→// SKILL VALIDATION
  1407→// ============================================================
  1408→
  1409→/**
  1410→ * Validate skill depends_on references
  1411→ * AC: @skill-validation ac-2 - broken depends_on ref reports warning
  1412→ */
  1413→function validateSkillDependsOn(
  1414→  skills: LoadedSkill[],
  1415→  index: ReferenceIndex,
  1416→): RefValidationWarning[] {
  1417→  const warnings: RefValidationWarning[] = [];
  1418→
  1419→  for (const skill of skills) {
  1420→    if (!skill.depends_on || skill.depends_on.length === 0) {
  1421→      continue;
  1422→    }
  1423→
  1424→    for (const depRef of skill.depends_on) {
  1425→      const result = index.resolve(depRef);
  1426→      if (!result.ok) {
  1427→        warnings.push({
  1428→          ref: depRef,
  1429→          sourceFile: skill._sourceFile,
  1430→          sourceUlid: skill._ulid,
  1431→          field: "depends_on",
  1432→          warning: "deprecated_target", // Reuse warning type for broken refs
  1433→          message: `Skill '${skill.id}' depends_on reference '${depRef}' cannot be resolved`,
  1434→        });
  1435→      } else {
  1436→        // Check that the resolved item is actually a skill (uses _type discriminant)
  1437→        if (!isSkill(result.item)) {
  1438→          warnings.push({
  1439→            ref: depRef,
  1440→            sourceFile: skill._sourceFile,
  1441→            sourceUlid: skill._ulid,
  1442→            field: "depends_on",
  1443→            warning: "deprecated_target",
  1444→            message: `Skill '${skill.id}' depends_on reference '${depRef}' points to non-skill item`,
  1445→          });
  1446→        }
  1447→      }
  1448→    }
  1449→  }
  1450→
  1451→  return warnings;
  1452→}
  1453→
  1454→/**
  1455→ * Find orphaned skill directories (directories with no corresponding meta entry)
  1456→ * AC: @skill-validation ac-3 - orphaned directory reports warning
  1457→ */
  1458→async function findOrphanedSkillDirectories(
  1459→  ctx: KspecContext,
  1460→  skills: LoadedSkill[],
  1461→): Promise<RefValidationWarning[]> {
  1462→  const warnings: RefValidationWarning[] = [];
  1463→  const skillsDir = path.join(ctx.specDir, "skills");
  1464→
  1465→  try {
  1466→    // Check if skills directory exists
  1467→    await fs.access(skillsDir);
  1468→
  1469→    // Read all directories in skills/
  1470→    const entries = await fs.readdir(skillsDir, { withFileTypes: true });
  1471→    const directories = entries.filter(entry => entry.isDirectory());
  1472→
  1473→    // Build set of skill IDs from meta
  1474→    const skillIds = new Set(skills.map(s => s.id));
  1475→
  1476→    // Find orphaned directories
  1477→    for (const dir of directories) {
  1478→      if (!skillIds.has(dir.name)) {
  1479→        warnings.push({
  1480→          ref: `@${dir.name}`,
  1481→          sourceFile: path.join(skillsDir, dir.name),
  1482→          field: "directory",
  1483→          warning: "deprecated_target", // Reuse warning type
  1484→          message: `Orphaned skill directory '${dir.name}' has no corresponding meta entry`,
  1485→        });
  1486→      }
  1487→    }
  1488→  } catch {
  1489→    // Skills directory doesn't exist - that's fine
  1490→  }
  1491→
  1492→  return warnings;
  1493→}
  1494→
  1495→// ============================================================
  1496→// MAIN VALIDATION
  1497→// ============================================================
  1498→
  1499→/**
  1500→ * Run full validation on a kspec project
  1501→ */
  1502→export async function validate(
  1503→  ctx: KspecContext,
  1504→  options: ValidateOptions = {},
  1505→): Promise<ValidationResult> {
  1506→  // Default: run all checks
  1507→  const runSchema = options.schema !== false;
  1508→  const runRefs = options.refs !== false;
  1509→  const runOrphans = options.orphans !== false;
  1510→  const runCompleteness = options.completeness !== false;
  1511→
  1512→  const result: ValidationResult = {
  1513→    valid: true,
  1514→    schemaErrors: [],
  1515→    refErrors: [],
  1516→    refWarnings: [],
  1517→    orphans: [],
  1518→    completenessWarnings: [],
  1519→    traitCycleErrors: [],
  1520→    stats: {
  1521→      filesChecked: 0,
  1522→      itemsChecked: 0,
  1523→      tasksChecked: 0,
  1524→    },
  1525→  };
  1526→
  1527→  const allTasks: LoadedTask[] = [];
  1528→  const allItems: LoadedSpecItem[] = [];
  1529→
  1530→  // Validate manifest
  1531→  if (ctx.manifestPath && runSchema) {
  1532→    const manifestErrors = await validateManifestFile(ctx.manifestPath);
  1533→    result.schemaErrors.push(...manifestErrors);
  1534→    result.stats.filesChecked++;
  1535→  }
  1536→
  1537→  // Load items from manifest (traits, inline modules, etc.)
  1538→  if (ctx.manifest && ctx.manifestPath) {
  1539→    const manifestItems = extractItemsFromRaw(ctx.manifest, ctx.manifestPath);
  1540→    allItems.push(...manifestItems);
  1541→    result.stats.itemsChecked += manifestItems.length;
  1542→  }
  1543→
  1544→  // Find and validate task files
  1545→  // Exclude test fixtures which have their own self-contained references
  1546→  const taskFiles = await findTaskFiles(ctx.rootDir);
  1547→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, "spec"));
  1548→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])].filter(
  1549→    (f) => !f.includes("/fixtures/"),
  1550→  );
  1551→
  1552→  for (const taskFile of allTaskFiles) {
  1553→    if (runSchema) {
  1554→      const taskErrors = await validateTasksFile(taskFile);
  1555→      result.schemaErrors.push(...taskErrors);
  1556→    }
  1557→    result.stats.filesChecked++;
  1558→
  1559→    // Load tasks for ref validation
  1560→    try {
  1561→      const raw = await readYamlFile<unknown>(taskFile);
  1562→      let taskList: unknown[] = [];
  1563→
  1564→      if (Array.isArray(raw)) {
  1565→        taskList = raw;
  1566→      } else if (raw && typeof raw === "object" && "tasks" in raw) {
  1567→        taskList = (raw as { tasks: unknown[] }).tasks || [];
  1568→      }
  1569→
  1570→      for (const t of taskList) {
  1571→        const parsed = TaskSchema.safeParse(t);
  1572→        if (parsed.success) {
  1573→          allTasks.push({ ...parsed.data, _sourceFile: taskFile });
  1574→          result.stats.tasksChecked++;
  1575→        }
  1576→      }
  1577→    } catch {
  1578→      // Already reported in schema validation
  1579→    }
  1580→  }
  1581→
  1582→  // Validate spec files (from includes)
  1583→  if (ctx.manifest && ctx.manifestPath) {
  1584→    const manifestDir = path.dirname(ctx.manifestPath);
  1585→    const includes = ctx.manifest.includes || [];
  1586→
  1587→    for (const include of includes) {
  1588→      const expandedPaths = await expandIncludePattern(include, manifestDir);
  1589→
  1590→      for (const filePath of expandedPaths) {
  1591→        if (runSchema) {
  1592→          const specErrors = await validateSpecFile(filePath);
  1593→          result.schemaErrors.push(...specErrors);
  1594→        }
  1595→        result.stats.filesChecked++;
  1596→
  1597→        // Load items for ref validation
  1598→        try {
  1599→          const items = await loadSpecFile(filePath);
  1600→          allItems.push(...items);
  1601→          result.stats.itemsChecked += items.length;
  1602→        } catch {
  1603→          // Already reported in schema validation
  1604→        }
  1605→      }
  1606→    }
  1607→  }
  1608→
  1609→  // Load meta items for reference validation
  1610→  // AC: @agent-definitions ac-agent-3
  1611→  const metaCtx = await loadMetaContext(ctx);
  1612→  const allMetaItems = [
  1613→    ...metaCtx.agents,
  1614→    ...metaCtx.workflows,
  1615→    ...metaCtx.conventions,
  1616→    ...metaCtx.observations,
  1617→    ...metaCtx.skills, // Include skills for reference indexing
  1618→  ];
  1619→
  1620→  // Load plans for reference validation
  1621→  // AC: @plan-validation ac-10
  1622→  const allPlans = await loadPlans(ctx);
  1623→
  1624→  // Build reference index when any downstream check needs it.
  1625→  const needsRefIndex = runRefs || runOrphans || runCompleteness;
  1626→  if (
  1627→    needsRefIndex &&
  1628→    (allTasks.length > 0 ||
  1629→      allItems.length > 0 ||
  1630→      allMetaItems.length > 0 ||
  1631→      allPlans.length > 0)
  1632→  ) {
  1633→    const index = new ReferenceIndex(
  1634→      allTasks,
  1635→      allItems,
  1636→      allMetaItems,
  1637→      allPlans,
  1638→    );
  1639→
  1640→    if (runRefs) {
  1641→      const refResult = validateRefs(index, allTasks, allItems);
  1642→
  1643→      // AC: @config-validation ac-2 ac-3 — strict_refs controls error vs warning
  1644→      // When strictRefs is false, demote "not_found" ref errors to warnings
  1645→      if (options.strictRefs === false) {
  1646→        // Move not_found errors to warnings
  1647→        const notFoundErrors = refResult.errors.filter((e) => e.error === "not_found");
  1648→        const otherErrors = refResult.errors.filter((e) => e.error !== "not_found");
  1649→
  1650→        result.refErrors = otherErrors;
  1651→        result.refWarnings = [
  1652→          ...refResult.warnings,
  1653→          ...notFoundErrors.map((e) => ({
  1654→            ref: e.ref,
  1655→            sourceFile: e.sourceFile,
  1656→            sourceUlid: e.sourceUlid,
  1657→            field: e.field,
  1658→            warning: "deprecated_target" as const, // Reuse existing warning type
  1659→            message: e.message,
  1660→          })),
  1661→        ];
  1662→      } else {
  1663→        // Default/strict behavior: not_found refs are errors
  1664→        result.refErrors = refResult.errors;
  1665→        result.refWarnings = refResult.warnings;
  1666→      }
  1667→
  1668→      // AC: @skill-validation ac-2 - validate skill depends_on references
  1669→      const skillDependsOnWarnings = validateSkillDependsOn(metaCtx.skills, index);
  1670→      result.refWarnings.push(...skillDependsOnWarnings);
  1671→
  1672→      // AC: @trait-edge-cases ac-2
  1673→      // Detect circular trait references
  1674→      result.traitCycleErrors = detectTraitCycles(allItems, index);
  1675→    }
  1676→
  1677→    // Orphan detection
  1678→    if (runOrphans) {
  1679→      result.orphans = findOrphans(allTasks, allItems, index);
  1680→    }
  1681→
  1682→    // Completeness validation
  1683→    // AC: @spec-completeness ac-1, ac-2, ac-3
  1684→    // AC: @trait-validation ac-3
  1685→    if (runCompleteness) {
  1686→      // Build trait index for trait AC coverage validation
  1687→      const traitIndex = new TraitIndex(allItems, index);
  1688→      const completenessWarnings = await checkCompleteness(
  1689→        allItems,
  1690→        index,
  1691→        ctx.rootDir,
  1692→        traitIndex,
  1693→      );
  1694→
  1695→      // AC: @task-automation-eligibility ac-21, ac-23
  1696→      // Check automation eligibility warnings for tasks
  1697→      const automationWarnings = checkAutomationEligibility(allTasks, index);
  1698→      completenessWarnings.push(...automationWarnings);
  1699→
  1700→      // AC: @config-validation ac-1 — require_acceptance promotes missing AC to errors
  1701→      if (options.requireAcceptance) {
  1702→        const missingAC = completenessWarnings.filter(
  1703→          (w) => w.type === "missing_acceptance_criteria",
  1704→        );
  1705→        const otherWarnings = completenessWarnings.filter(
  1706→          (w) => w.type !== "missing_acceptance_criteria",
  1707→        );
  1708→
  1709→        // Promote missing AC warnings to schema errors
  1710→        for (const w of missingAC) {
  1711→          result.schemaErrors.push({
  1712→            file: "completeness",
  1713→            path: w.itemRef,
  1714→            message: w.message,
  1715→          });
  1716→        }
  1717→
  1718→        result.completenessWarnings = otherWarnings;
  1719→      } else {
  1720→        result.completenessWarnings = completenessWarnings;
  1721→      }
  1722→    }
  1723→  }
  1724→
  1725→  // Meta manifest validation (AC-meta-manifest-2, AC-meta-manifest-3)
  1726→  const metaManifestPath = await findMetaManifest(ctx.specDir);
  1727→  if (metaManifestPath) {
  1728→    // Use metaCtx already loaded above
  1729→    result.metaStats = {
  1730→      agents: metaCtx.agents.length,
  1731→      workflows: metaCtx.workflows.length,
  1732→      conventions: metaCtx.conventions.length,
  1733→      observations: metaCtx.observations.length,
  1734→      skills: metaCtx.skills.length,
  1735→    };
  1736→
  1737→    // Validate meta manifest schema with strict ULID validation
  1738→    if (runSchema) {
  1739→      const metaErrors = await validateMetaManifestFile(metaManifestPath);
  1740→      // Prefix all meta errors with "meta:"
  1741→      for (const err of metaErrors) {
  1742→        err.path = err.path ? `meta:${err.path}` : "meta:";
  1743→      }
  1744→      result.schemaErrors.push(...metaErrors);
  1745→      result.stats.filesChecked++;
  1746→
  1747→      // AC: @skill-content-model ac-3 - validate skill content files exist
  1748→      if (metaCtx.skills.length > 0) {
  1749→        const skillContentErrors = await validateSkillContentFiles(ctx, metaCtx.skills);
  1750→        result.schemaErrors.push(...skillContentErrors);
  1751→      }
  1752→
  1753→      // AC: @skill-validation ac-3 - detect orphaned skill directories
  1754→      const orphanedSkillWarnings = await findOrphanedSkillDirectories(ctx, metaCtx.skills);
  1755→      result.refWarnings.push(...orphanedSkillWarnings);
  1756→    }
  1757→  }
  1758→
  1759→  // Set valid flag
  1760→  result.valid =
  1761→    result.schemaErrors.length === 0 &&
  1762→    result.refErrors.length === 0 &&
  1763→    result.traitCycleErrors.length === 0;
  1764→
  1765→  return result;
  1766→}
  1767→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
```