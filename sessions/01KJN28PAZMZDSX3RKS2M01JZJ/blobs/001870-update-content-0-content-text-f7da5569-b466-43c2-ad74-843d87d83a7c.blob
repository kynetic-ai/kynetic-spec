     1→/**
     2→ * Ralph Subagent Module
     3→ *
     4→ * Handles spawning and running subagents for dedicated tasks like PR review.
     5→ * Subagents run sequentially - ralph waits for completion before continuing.
     6→ */
     7→
     8→import type { AgentAdapter } from "../agents/adapters.js";
     9→import { spawnAndInitialize, type SpawnedAgent } from "../agents/spawner.js";
    10→import type { SessionUpdate } from "../acp/index.js";
    11→import { createTranslator } from "./events.js";
    12→import { createPrefixedRenderer } from "./cli-renderer.js";
    13→
    14→// ============================================================================
    15→// Types
    16→// ============================================================================
    17→
    18→/**
    19→ * Context provided to a subagent for its task.
    20→ * AC: @ralph-subagent-spawning ac-10
    21→ */
    22→export interface SubagentContext {
    23→  /** Task reference (e.g., @task-slug) */
    24→  taskRef: string;
    25→  /** Full task details from kspec task get */
    26→  taskDetails: Record<string, unknown>;
    27→  /** Linked spec with acceptance criteria, if spec_ref exists */
    28→  specWithACs: Record<string, unknown> | null;
    29→  /** Current git branch */
    30→  gitBranch: string;
    31→}
    32→
    33→/**
    34→ * Configuration for subagent execution.
    35→ */
    36→export interface SubagentConfig {
    37→  /** Timeout in milliseconds (default: 20 minutes) */
    38→  timeout: number;
    39→  /** Output prefix for distinguishing subagent output */
    40→  outputPrefix: string;
    41→  /** Skill invocation name for PR review (from config, defaults to SKILL_PR_REVIEW) */
    42→  skillName?: string;
    43→}
    44→
    45→/**
    46→ * Result of running a subagent.
    47→ */
    48→export interface SubagentResult {
    49→  /** Whether the subagent completed successfully */
    50→  success: boolean;
    51→  /** Whether the subagent timed out */
    52→  timedOut: boolean;
    53→  /** Error message if failed */
    54→  error?: string;
    55→}
    56→
    57→/**
    58→ * Options for running a subagent.
    59→ */
    60→export interface SubagentOptions {
    61→  /** Whether to auto-approve tool requests */
    62→  yolo: boolean;
    63→  /** Working directory */
    64→  cwd: string;
    65→  /** Extra arguments to append to adapter args (e.g., auto-approve flags) */
    66→  extraArgs?: string[];
    67→  /** Tool request handler */
    68→  handleRequest: (
    69→    client: SpawnedAgent["client"],
    70→    reqId: string | number,
    71→    method: string,
    72→    params: unknown,
    73→  ) => Promise<void>;
    74→}
    75→
    76→// ============================================================================
    77→// Default Configuration
    78→// ============================================================================
    79→
    80→/** Default subagent timeout: 20 minutes */
    81→export const DEFAULT_SUBAGENT_TIMEOUT = 20 * 60 * 1000;
    82→
    83→/** Maximum prompt size in bytes for subagent prompts before truncation kicks in.
    84→ * Kept lower than worker prompts because reviewer subagents include additional
    85→ * framing and have hit ACP parser limits with oversized JSON payloads. */
    86→export const SUBAGENT_PROMPT_MAX_BYTES = 16 * 1024;
    87→
    88→/** Maximum prompt size in bytes for worker prompts before truncation kicks in.
    89→ * Worker prompts can retain the prior 32KB budget. */
    90→export const WORKER_PROMPT_MAX_BYTES = 32 * 1024;
    91→
    92→/** Default output prefix for subagent */
    93→export const DEFAULT_SUBAGENT_PREFIX = "[REVIEW SUBAGENT]";
    94→
    95→// ============================================================================
    96→// Skill Invocation Names (Defaults)
    97→// ============================================================================
    98→// Ralph prompts reference skills by invocation name. Defaults use the kspec:
    99→// namespace (core skills). Projects can override via kspec.config.yaml:
   100→//   ralph:
   101→//     skills:
   102→//       task_work: "/my-task-work"
   103→//       reflect: "/my-reflect"
   104→//       pr_review: "/my-review"
   105→
   106→/** Default skill invocation for task-work in ralph worker prompt */
   107→export const SKILL_TASK_WORK = "/kspec:task-work";
   108→
   109→/** Default skill invocation for reflect in ralph reflect prompt */
   110→export const SKILL_REFLECT = "/kspec:reflect";
   111→
   112→/** Default skill invocation for PR review in ralph subagent prompt */
   113→export const SKILL_PR_REVIEW = "/kspec:review";
   114→
   115→/**
   116→ * Default ACP prompt timeout for ralph agents: 30 minutes.
   117→ * The framing layer default (5 min) is too aggressive — API slowness,
   118→ * extended thinking, and large context processing can exceed it even
   119→ * with the keepalive mechanism (which resets on tool calls/notifications).
   120→ */
   121→export const RALPH_PROMPT_TIMEOUT = 30 * 60 * 1000;
   122→
   123→// ============================================================================
   124→// Prompt Truncation
   125→// ============================================================================
   126→
   127→/**
   128→ * Build a compact summary stub for truncated sections.
   129→ * Provides enough identity context to avoid a CLI call for basic triage.
   130→ */
   131→function compactSummary(data: Record<string, unknown>): Record<string, unknown> {
   132→  const summary: Record<string, unknown> = {};
   133→  if (data._ulid != null) summary._ulid = data._ulid;
   134→  if (data.ulid != null) summary._ulid = data.ulid;
   135→  if (data.title != null) summary.title = data.title;
   136→  if (data.status != null) summary.status = data.status;
   137→  if (data.spec_ref != null) summary.spec_ref = data.spec_ref;
   138→  if (data.slug != null) summary.slug = data.slug;
   139→  if (Array.isArray(data.acceptance_criteria)) {
   140→    summary.ac_count = data.acceptance_criteria.length;
   141→  }
   142→  return summary;
   143→}
   144→
   145→/**
   146→ * Represents a replaceable JSON section within a prompt.
   147→ */
   148→export interface PromptSection {
   149→  /** Marker string that appears in the prompt (the full formatted section) */
   150→  marker: string;
   151→  /** Replacement text if this section is truncated */
   152→  truncated: string;
   153→  /** Byte size of the marker */
   154→  size: number;
   155→}
   156→
   157→/**
   158→ * Format a data object as a labeled markdown JSON section.
   159→ * Returns the formatted string and a PromptSection for potential truncation.
   160→ *
   161→ * When not truncated: heading + ```json fence + pretty-printed JSON
   162→ * When truncated: heading + blockquote with compact summary + CLI fetch command
   163→ */
   164→export function formatJsonSection(
   165→  data: Record<string, unknown>,
   166→  label: string,
   167→  fetchCmd: string,
   168→): { text: string; section: PromptSection } {
   169→  const json = JSON.stringify(data, null, 2);
   170→  const text = `### ${label}\n\n\`\`\`json\n${json}\n\`\`\``;
   171→  const summary = JSON.stringify(compactSummary(data));
   172→  const truncated = `### ${label}\n\n> **Truncated** (${Buffer.byteLength(json, "utf8")} bytes). Fetch full data:\n> \`\`\`\n> ${fetchCmd}\n> \`\`\`\n>\n> Summary: \`${summary}\``;
   173→
   174→  return {
   175→    text,
   176→    section: {
   177→      marker: text,
   178→      truncated,
   179→      size: Buffer.byteLength(text, "utf8"),
   180→    },
   181→  };
   182→}
   183→
   184→/**
   185→ * Format a section as a compact summary + CLI fetch command.
   186→ * Intended for subagent prompts to avoid embedding full JSON payloads.
   187→ */
   188→export function formatCompactSection(
   189→  data: Record<string, unknown>,
   190→  label: string,
   191→  fetchCmd: string,
   192→): { text: string; section: PromptSection } {
   193→  const summary = JSON.stringify(compactSummary(data));
   194→  const text = `### ${label}\n\n> Fetch full data:\n> \`\`\`\n> ${fetchCmd}\n> \`\`\`\n>\n> Summary: \`${summary}\``;
   195→  const truncated = `### ${label}\n\n> **Truncated**. Fetch full data:\n> \`\`\`\n> ${fetchCmd}\n> \`\`\``;
   196→
   197→  return {
   198→    text,
   199→    section: {
   200→      marker: text,
   201→      truncated,
   202→      size: Buffer.byteLength(text, "utf8"),
   203→    },
   204→  };
   205→}
   206→
   207→/**
   208→ * If the assembled prompt exceeds the byte budget, truncate the largest
   209→ * section(s) until it fits. Sections are replaced largest-first.
   210→ */
   211→export function truncatePromptIfNeeded(
   212→  prompt: string,
   213→  sections: PromptSection[],
   214→  maxBytes: number = SUBAGENT_PROMPT_MAX_BYTES,
   215→): string {
   216→  let totalBytes = Buffer.byteLength(prompt, "utf8");
   217→  if (totalBytes <= maxBytes) return prompt;
   218→
   219→  // Sort sections largest-first for greedy truncation
   220→  const sorted = [...sections].sort((a, b) => b.size - a.size);
   221→  let result = prompt;
   222→
   223→  for (const section of sorted) {
   224→    if (totalBytes <= maxBytes) break;
   225→    // Only truncate if this section hasn't already been truncated
   226→    if (!result.includes(section.marker)) continue;
   227→
   228→    const savedBytes = Buffer.byteLength(section.marker, "utf8") -
   229→      Buffer.byteLength(section.truncated, "utf8");
   230→    result = result.replace(section.marker, section.truncated);
   231→    totalBytes -= savedBytes;
   232→  }
   233→
   234→  return result;
   235→}
   236→
   237→// ============================================================================
   238→// Prompt Builder
   239→// ============================================================================
   240→
   241→/**
   242→ * Build the prompt for a PR review subagent.
   243→ * AC: @ralph-subagent-spawning ac-2, ac-10, ac-12
   244→ *
   245→ * @param context - Task context for the subagent
   246→ * @param skillName - Skill invocation name for PR review (from config or default)
   247→ */
   248→export function buildSubagentPrompt(context: SubagentContext, skillName: string = SKILL_PR_REVIEW): string {
   249→  // Build compact identity sections to keep subagent payloads small.
   250→  const taskSection = formatCompactSection(
   251→    context.taskDetails,
   252→    "Task Details",
   253→    `kspec task get ${context.taskRef} --json`,
   254→  );
   255→
   256→  const sections: PromptSection[] = [taskSection.section];
   257→
   258→  let specBlock = "";
   259→  let specSection: PromptSection | null = null;
   260→  if (context.specWithACs) {
   261→    const specRef = (context.taskDetails.spec_ref as string) || "@spec";
   262→    const formatted = formatCompactSection(
   263→      context.specWithACs,
   264→      "Linked Spec with Acceptance Criteria",
   265→      `kspec item get ${specRef} --json`,
   266→    );
   267→    specBlock = `\n${formatted.text}\n\n**Verify all ACs have test coverage before merging.**\n`;
   268→    specSection = formatted.section;
   269→    sections.push(specSection);
   270→  }
   271→
   272→  const prompt = `# PR Review Subagent
   273→
   274→You are a subagent spawned by ralph to REVIEW a PR and merge it only if clean.
   275→
   276→## Role Boundary
   277→
   278→You are a REVIEWER, not a fixer. Your responsibilities:
   279→- Review code quality, AC coverage (own + trait), spec alignment
   280→- Post findings as inline PR comments with severity (MUST-FIX:, SHOULD-FIX:, SUGGESTION:)
   281→- Merge the PR ONLY if all quality gates pass (no MUST-FIX or SHOULD-FIX items)
   282→- Complete the task after merge
   283→
   284→You MUST NOT:
   285→- Fix code issues yourself
   286→- Push commits to the PR branch
   287→- Add or modify tests
   288→- Make any code changes
   289→
   290→If you find issues:
   291→1. Post them as inline PR comments with severity prefix
   292→2. Transition the task to needs_work: \`kspec task needs-work ${context.taskRef} --reason "findings..."\`
   293→3. Exit — the worker agent will fix issues in the next iteration
   294→
   295→## Context
   296→
   297→- **Task:** \`${context.taskRef}\`
   298→- **Branch:** \`${context.gitBranch}\`
   299→
   300→${taskSection.text}
   301→${specBlock}
   302→## Instructions
   303→
   304→Run the PR review skill:
   305→
   306→\`\`\`
   307→${skillName} ${context.taskRef}
   308→\`\`\`
   309→
   310→The skill defines all review steps, quality gates, and merge criteria. Follow it completely.
   311→
   312→Do NOT start new work. Do NOT fix code. Your only job is reviewing this task's PR, posting findings, and merging if clean.
   313→`;
   314→
   315→  return truncatePromptIfNeeded(prompt, sections, SUBAGENT_PROMPT_MAX_BYTES);
   316→}
   317→
   318→// ============================================================================
   319→// Subagent Runner
   320→// ============================================================================
   321→
   322→/**
   323→ * Run a subagent for a dedicated task.
   324→ *
   325→ * AC: @ralph-subagent-spawning ac-1 (spawn), ac-3 (sequential), ac-4 (output),
   326→ *     ac-9 (timeout), ac-11 (prefix)
   327→ *
   328→ * @param adapter - Agent adapter to use for spawning
   329→ * @param context - Task context for the subagent
   330→ * @param config - Subagent configuration (timeout, prefix)
   331→ * @param options - Runtime options (cwd, request handler)
   332→ * @returns Result indicating success/failure/timeout
   333→ */
   334→export async function runSubagent(
   335→  adapter: AgentAdapter,
   336→  context: SubagentContext,
   337→  config: SubagentConfig,
   338→  options: SubagentOptions,
   339→): Promise<SubagentResult> {
   340→  const prompt = buildSubagentPrompt(context, config.skillName);
   341→  let agent: SpawnedAgent | null = null;
   342→
   343→  try {
   344→    // AC: @ralph-subagent-spawning ac-1 - Spawn new ACP process
   345→    // AC: @ralph-adapter-auto-approve ac-4
   346→    agent = await spawnAndInitialize(adapter, {
   347→      cwd: options.cwd,
   348→      extraArgs: options.extraArgs,
   349→      clientOptions: {
   350→        clientInfo: {
   351→          name: "kspec-ralph-subagent",
   352→          version: "1.0.0",
   353→        },
   354→        methodTimeouts: {
   355→          "session/prompt": RALPH_PROMPT_TIMEOUT,
   356→          "session/resume": RALPH_PROMPT_TIMEOUT,
   357→        },
   358→      },
   359→    });
   360→
   361→    // AC: @ralph-subagent-spawning ac-4, ac-11 - Prefixed renderer for output
   362→    const translator = createTranslator();
   363→    const renderer = createPrefixedRenderer(config.outputPrefix);
   364→
   365→    // Set up streaming update handler
   366→    agent.client.on("update", (_sid: string, update: SessionUpdate) => {
   367→      const event = translator.translate(update);
   368→      if (event) {
   369→        renderer.render(event);
   370→      }
   371→    });
   372→
   373→    // Set up tool request handler
   374→    agent.client.on(
   375→      "request",
   376→      (reqId: string | number, method: string, params: unknown) => {
   377→        options
   378→          .handleRequest(agent!.client, reqId, method, params)
   379→          .catch((err) => {
   380→            agent!.client.respondError(reqId, -32000, err.message);
   381→          });
   382→      },
   383→    );
   384→
   385→    // Create ACP session
   386→    const acpSessionId = await agent.client.newSession({
   387→      cwd: options.cwd,
   388→      mcpServers: [],
   389→    });
   390→
   391→    // AC: @ralph-subagent-spawning ac-9 - Timeout handling
   392→    const timeoutPromise = new Promise<never>((_, reject) => {
   393→      setTimeout(
   394→        () => reject(new Error("SUBAGENT_TIMEOUT")),
   395→        config.timeout,
   396→      );
   397→    });
   398→
   399→    // AC: @ralph-subagent-spawning ac-3 - Ralph waits for completion
   400→    const promptPromise = agent.client.prompt({
   401→      sessionId: acpSessionId,
   402→      prompt: [{ type: "text", text: prompt }],
   403→    });
   404→
   405→    // Race between completion and timeout
   406→    await Promise.race([promptPromise, timeoutPromise]);
   407→
   408→    return { success: true, timedOut: false };
   409→  } catch (err) {
   410→    const error = err as Error;
   411→
   412→    // AC: @ralph-subagent-spawning ac-9 - Timeout detection
   413→    if (error.message === "SUBAGENT_TIMEOUT") {
   414→      return { success: false, timedOut: true };
   415→    }
   416→
   417→    return { success: false, timedOut: false, error: error.message };
   418→  } finally {
   419→    // Always clean up the agent process
   420→    if (agent) {
   421→      agent.kill();
   422→    }
   423→  }
   424→}
   425→

<system-reminder>
