   374→// AC: @workflow-run-foundation ac-5
   375→describe('workflow abort validation', () => {
   376→  it('should error when aborting a completed run', async () => {
   377→    // Start and manually complete a run
   378→    const startResult = kspec('workflow start @test-workflow --json', tempDir);
   379→    const { run_id } = JSON.parse(startResult.stdout);
   380→
   381→    const runsPath = path.join(tempDir, 'kynetic.runs.yaml');
   382→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   383→    const doc = parseDocument(runsContent);
   384→    const runsData = doc.toJS() as { runs: any[] };
   385→
   386→    runsData.runs[0].status = 'completed';
   387→    runsData.runs[0].completed_at = new Date().toISOString();
   388→
   389→    const doc3 = parseDocument(await fs.readFile(runsPath, 'utf-8'));
   390→    doc3.setIn(['runs', 0, 'status'], 'completed');
   391→    doc3.setIn(['runs', 0, 'completed_at'], runsData.runs[0].completed_at);
   392→    await fs.writeFile(runsPath, doc3.toString(), 'utf-8');
   393→
   394→    // Try to abort
   395→    const result = kspec(`workflow abort @${run_id}`, tempDir, { expectFail: true });
   396→
   397→    expect(result.exitCode).toBe(4); // VALIDATION_FAILED
   398→    expect(result.stderr).toContain('Cannot abort workflow run: already completed');
   399→  });
   400→
   401→  it('should error when aborting an already aborted run', async () => {
   402→    // Start and abort a run
   403→    const startResult = kspec('workflow start @test-workflow --json', tempDir);
   404→    const { run_id } = JSON.parse(startResult.stdout);
   405→
   406→    kspec(`workflow abort @${run_id}`, tempDir);
   407→
   408→    // Try to abort again
   409→    const result = kspec(`workflow abort @${run_id}`, tempDir, { expectFail: true });
   410→
   411→    expect(result.exitCode).toBe(4); // VALIDATION_FAILED
   412→    expect(result.stderr).toContain('Cannot abort workflow run: already aborted');
   413→  });
   414→});
   415→
   416→// AC: @workflow-step-navigation ac-1
   417→describe('workflow next - basic step advancement', () => {
   418→  let runId: string;
   419→
   420→  beforeEach(async () => {
   421→    const result = kspec('workflow start @test-workflow --json', tempDir);
   422→    const output = JSON.parse(result.stdout);
   423→    runId = output.run_id;
   424→  });
   425→
   426→  it('should complete current step and show next step', async () => {
   427→    const result = kspec(`workflow next @${runId}`, tempDir);
   428→
   429→    expect(result.exitCode).toBe(0);
   430→    expect(result.stdout).toContain('Completed step 1/3: [check] Verify prerequisites');
   431→    expect(result.stdout).toContain('Step 2/3: [action] Execute main task');
   432→
   433→    // Verify step result was recorded
   434→    const runsPath = path.join(tempDir, 'kynetic.runs.yaml');
   435→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   436→    const doc = parseDocument(runsContent);
   437→    const runsData = doc.toJS() as { runs: any[] };
   438→
   439→    const run = runsData.runs[0];
   440→    expect(run.current_step).toBe(1);
   441→    // After advancing, we have: step 0 completed + step 1 stub (with entry_confirmed)
   442→    expect(run.step_results).toHaveLength(2);
   443→    expect(run.step_results[0].step_index).toBe(0);
   444→    expect(run.step_results[0].status).toBe('completed');
   445→    expect(run.step_results[0].started_at).toBeDefined();
   446→    expect(run.step_results[0].completed_at).toBeDefined();
   447→    // Step 1 stub created with started_at for tracking entry_confirmed
   448→    expect(run.step_results[1].step_index).toBe(1);
   449→    expect(run.step_results[1].started_at).toBeDefined();
   450→  });
   451→
   452→  it('should work with --json output', async () => {
   453→    const result = kspec(`workflow next @${runId} --json`, tempDir);
   454→
   455→    expect(result.exitCode).toBe(0);
   456→    const output = JSON.parse(result.stdout);
   457→
   458→    expect(output.run_id).toBe(runId);
   459→    expect(output.current_step).toBe(1);
   460→    expect(output.total_steps).toBe(3);
   461→    expect(output.next_step).toEqual({
   462→      type: 'action',
   463→      content: 'Execute main task',
   464→    });
   465→  });
   466→
   467→  it('should advance through multiple steps', async () => {
   468→    // Step 0 -> 1
   469→    kspec(`workflow next @${runId}`, tempDir);
   470→    // Step 1 -> 2
   471→    const result = kspec(`workflow next @${runId}`, tempDir);
   472→
   473→    expect(result.exitCode).toBe(0);
   474→    expect(result.stdout).toContain('Completed step 2/3: [action] Execute main task');
   475→    expect(result.stdout).toContain('Step 3/3: [check] Validate results');
   476→
   477→    const runsPath = path.join(tempDir, 'kynetic.runs.yaml');
   478→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   479→    const doc = parseDocument(runsContent);
   480→    const runsData = doc.toJS() as { runs: any[] };
   481→
   482→    const run = runsData.runs[0];
   483→    expect(run.current_step).toBe(2);
   484→    // After two advances: step 0 complete, step 1 complete, step 2 stub
   485→    expect(run.step_results).toHaveLength(3);
   486→  });
   487→});
   488→
   489→// AC: @workflow-step-navigation ac-2
   490→describe('workflow next - completing last step', () => {
   491→  let runId: string;
   492→
   493→  beforeEach(async () => {
   494→    const result = kspec('workflow start @test-workflow --json', tempDir);
   495→    const output = JSON.parse(result.stdout);
   496→    runId = output.run_id;
   497→
   498→    // Advance to last step
   499→    kspec(`workflow next @${runId}`, tempDir);
   500→    kspec(`workflow next @${runId}`, tempDir);
   501→  });
   502→
   503→  it('should complete the run when advancing from last step', async () => {
   504→    const result = kspec(`workflow next @${runId}`, tempDir);
   505→
   506→    expect(result.exitCode).toBe(0);
   507→    expect(result.stdout).toContain('Completed step 3/3: [check] Validate results');
   508→    expect(result.stdout).toContain('Workflow completed!');
   509→    expect(result.stdout).toMatch(/Duration: \d+s/);
   510→    expect(result.stdout).toContain('Steps completed: 3');
   511→    expect(result.stdout).toContain('Steps skipped: 0');
   512→
   513→    // Verify run is completed
   514→    const runsPath = path.join(tempDir, 'kynetic.runs.yaml');
   515→    const runsContent = await fs.readFile(runsPath, 'utf-8');
   516→    const doc = parseDocument(runsContent);
   517→    const runsData = doc.toJS() as { runs: any[] };
   518→
   519→    const run = runsData.runs[0];
   520→    expect(run.status).toBe('completed');
   521→    expect(run.completed_at).toBeDefined();
   522→    expect(run.step_results).toHaveLength(3);
   523→  });
   524→
   525→  it('should output summary in JSON mode', async () => {
   526→    const result = kspec(`workflow next @${runId} --json`, tempDir);
   527→
   528→    expect(result.exitCode).toBe(0);
   529→    const output = JSON.parse(result.stdout);
   530→
   531→    expect(output.run_id).toBe(runId);
   532→    expect(output.status).toBe('completed');
   533→    expect(output.completed_at).toBeDefined();
   534→    expect(output.total_duration_ms).toBeGreaterThan(0);
   535→    expect(output.steps_completed).toBe(3);
   536→    expect(output.steps_skipped).toBe(0);
   537→  });
   538→
   539→  it('should count skipped steps in summary', async () => {
   540→    // Start a fresh run and skip some steps
