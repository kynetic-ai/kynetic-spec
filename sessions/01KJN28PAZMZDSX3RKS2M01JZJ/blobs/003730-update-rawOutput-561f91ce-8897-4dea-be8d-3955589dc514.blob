   271→    const result = kspec('workflow start @test-workflow --task @test-task --json', tempDir);
   272→    const output = JSON.parse(result.stdout);
   273→    runId = output.run_id;
   274→  });
   275→
   276→  it('should display run details in human-readable format', async () => {
