  1520→/**
  1521→ * Tests for workflow complete command
  1522→ * Distinguishes graceful exit (no_work_available) from abort (actual failure)
  1523→ */
  1524→describe('workflow complete', () => {
  1525→  let runId: string;
  1526→
  1527→  beforeEach(async () => {
  1528→    const result = kspec('workflow start @test-workflow --json', tempDir);
  1529→    const output = JSON.parse(result.stdout);
  1530→    runId = output.run_id;
  1531→  });
  1532→
  1533→  it('should complete an active run with no result', async () => {
  1534→    const result = kspec(`workflow complete @${runId} --json`, tempDir);
  1535→
  1536→    expect(result.exitCode).toBe(0);
