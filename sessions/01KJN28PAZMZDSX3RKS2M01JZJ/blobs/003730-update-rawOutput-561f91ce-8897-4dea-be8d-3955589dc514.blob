  1262→    const runsData = doc.toJS() as { runs: any[] };
  1263→
  1264→    const run = runsData.runs[0];
  1265→    expect(run.status).toBe('paused');
  1266→    expect(run.paused_at).toBeDefined();
  1267→  });
  1268→
  1269→  it('should display human-readable output without --json', async () => {
  1270→    const startResult = kspec('workflow start @test-workflow --json', tempDir);
  1271→    const { run_id } = JSON.parse(startResult.stdout);
  1272→
  1273→    const pauseResult = kspec(`workflow pause @${run_id}`, tempDir);
  1274→    expect(pauseResult.exitCode).toBe(0);
  1275→    expect(pauseResult.stdout).toContain('Paused run');
  1276→    expect(pauseResult.stdout).toContain('at step 1/3');
  1277→  });
  1278→
  1279→  it('should error if run does not exist', async () => {
  1280→    const result = kspec('workflow pause @nonexistent --json', tempDir, { expectFail: true });
  1281→    expect(result.exitCode).toBe(3); // NOT_FOUND
  1282→    expect(result.stderr).toContain('Workflow run not found');
  1283→  });
  1284→
  1285→  it('should error if run is not active', async () => {
  1286→    // Start and manually set to completed
  1287→    const startResult = kspec('workflow start @test-workflow --json', tempDir);
  1288→    const { run_id } = JSON.parse(startResult.stdout);
  1289→
  1290→    const runsPath = path.join(tempDir, 'kynetic.runs.yaml');
  1291→    const doc = parseDocument(await fs.readFile(runsPath, 'utf-8'));
  1292→    doc.setIn(['runs', 0, 'status'], 'completed');
  1293→    await fs.writeFile(runsPath, doc.toString(), 'utf-8');
  1294→
  1295→    const pauseResult = kspec(`workflow pause @${run_id}`, tempDir, { expectFail: true });
  1296→    expect(pauseResult.exitCode).toBe(4); // VALIDATION_FAILED
  1297→    expect(pauseResult.stderr).toContain('Cannot pause run');
  1298→    expect(pauseResult.stderr).toContain('completed');
  1299→  });
  1300→});
