  1241→// AC: @workflow-advanced-features ac-1
  1242→describe('workflow pause', () => {
  1243→  it('should pause an active run', async () => {
  1244→    // Start a workflow run
  1245→    const startResult = kspec('workflow start @test-workflow --json', tempDir);
