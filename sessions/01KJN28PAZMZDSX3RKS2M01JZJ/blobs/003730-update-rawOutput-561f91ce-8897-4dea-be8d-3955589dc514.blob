   309→
   310→  it('should error if run does not exist', async () => {
   311→    const result = kspec('workflow show @01NONEXISTENT', tempDir, { expectFail: true });
   312→
   313→    expect(result.exitCode).toBe(3); // NOT_FOUND
   314→    expect(result.stderr).toContain('Workflow run not found');
   315→  });
   316→});
