  1255→    expect(output.status).toBe('paused');
  1256→    expect(output.paused_at).toBeDefined();
  1257→
  1258→    // Verify paused state is persisted
  1259→    const runsPath = path.join(tempDir, 'kynetic.runs.yaml');
  1260→    const runsContent = await fs.readFile(runsPath, 'utf-8');
