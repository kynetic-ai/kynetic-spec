  1009→// AC: @workflow-enforcement-modes ac-3
  1010→describe('strict mode enforcement', () => {
  1011→  let strictWorkflowUlid: string;
  1012→
  1013→  beforeEach(async () => {
  1014→    strictWorkflowUlid = ulid();
  1015→
  1016→    // Create strict workflow with both entry and exit criteria
  1017→    const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
  1018→    const metaContent = await fs.readFile(metaPath, 'utf-8');
  1019→    const doc = parseDocument(metaContent);
  1020→    const metaData = doc.toJS() as any;
  1021→
  1022→    metaData.workflows.push({
  1023→      _ulid: strictWorkflowUlid,
  1024→      id: 'strict-full-workflow',
  1025→      trigger: 'manual',
  1026→      enforcement: 'strict',
  1027→      steps: [
  1028→        {
  1029→          type: 'action',
  1030→          content: 'First step',
  1031→          exit_criteria: ['First output complete'],
  1032→        },
  1033→        {
  1034→          type: 'action',
  1035→          content: 'Second step',
  1036→          entry_criteria: ['First step verified'],
  1037→          exit_criteria: ['Second output complete'],
  1038→        },
  1039→        { type: 'check', content: 'Final step' },
  1040→      ],
  1041→    });
  1042→
  1043→    await fs.writeFile(metaPath, YAML.stringify(metaData), 'utf-8');
  1044→  });
  1045→
  1046→  it('should require --confirm to proceed with criteria', async () => {
  1047→    const startResult = kspec(`workflow start @strict-full-workflow --json`, tempDir);
  1048→    expect(startResult.exitCode).toBe(0);
  1049→    const { run_id } = JSON.parse(startResult.stdout);
  1050→
  1051→    // Try without --confirm - should fail
  1052→    const failResult = kspec(`workflow next @${run_id}`, tempDir, { expectFail: true });
  1053→    expect(failResult.exitCode).toBe(4);
  1054→    expect(failResult.stderr).toContain('Exit criteria not confirmed');
  1055→
  1056→    // Try with --confirm - should succeed
  1057→    const successResult = kspec(`workflow next @${run_id} --confirm`, tempDir);
  1058→    expect(successResult.exitCode).toBe(0);
  1059→  });
  1060→
  1061→  it('should require --force to skip in strict mode', async () => {
  1062→    const startResult = kspec(`workflow start @strict-full-workflow --json`, tempDir);
  1063→    expect(startResult.exitCode).toBe(0);
  1064→    const { run_id } = JSON.parse(startResult.stdout);
  1065→
  1066→    // Try --skip without --force - should fail
  1067→    const failResult = kspec(`workflow next @${run_id} --skip`, tempDir, { expectFail: true });
  1068→    expect(failResult.exitCode).toBe(4);
  1069→    expect(failResult.stderr).toContain('Cannot skip step in strict mode without --force');
  1070→
  1071→    // Try --skip with --force - should succeed
  1072→    const successResult = kspec(`workflow next @${run_id} --skip --force`, tempDir);
  1073→    expect(successResult.exitCode).toBe(0);
  1074→  });
  1075→
  1076→  it('should record confirmations in step_results', async () => {
  1077→    const startResult = kspec(`workflow start @strict-full-workflow --json`, tempDir);
  1078→    expect(startResult.exitCode).toBe(0);
  1079→    const { run_id } = JSON.parse(startResult.stdout);
  1080→
  1081→    // Advance with --confirm
  1082→    const nextResult = kspec(`workflow next @${run_id} --confirm`, tempDir);
  1083→    expect(nextResult.exitCode).toBe(0);
  1084→
  1085→    // Check that confirmation was recorded
  1086→    const runsPath = path.join(tempDir, 'kynetic.runs.yaml');
  1087→    const runsContent = await fs.readFile(runsPath, 'utf-8');
  1088→    const doc = parseDocument(runsContent);
  1089→    const runsData = doc.toJS() as { runs: any[] };
  1090→
  1091→    const run = runsData.runs.find((r: any) => r._ulid === run_id);
  1092→    expect(run).toBeDefined();
  1093→    // After advance: step 0 complete + step 1 stub
  1094→    expect(run.step_results).toHaveLength(2);
  1095→    // Step 0 should have exit_confirmed
  1096→    expect(run.step_results[0].exit_confirmed).toBe(true);
  1097→    // Step 1 should have entry_confirmed
  1098→    expect(run.step_results[1].entry_confirmed).toBe(true);
  1099→  });
  1100→});
