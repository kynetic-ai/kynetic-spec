   452→  });
   453→
   454→  // AC: @cmd-session-start ac-needs-work-indicator
   455→  describe('needs_work visual distinction', () => {
   456→    it('should display [needs_work] label for needs_work tasks', () => {
   457→      kspec('task add --title "Fix task" --slug fix-task', tempDir);
   458→      kspec('task start @fix-task', tempDir);
   459→      kspec('task submit @fix-task', tempDir);
   460→      kspec('task needs-work @fix-task --reason "Failing tests"', tempDir);
   461→
   462→      const result = kspec('session start', tempDir);
   463→      expect(result.stdout).toContain('[needs_work]');
   464→      expect(result.stdout).toContain('Fix task');
   465→    });
   466→
   467→    it('should include needs_work status in JSON', () => {
   468→      kspec('task add --title "Fix task" --slug fix-task', tempDir);
   469→      kspec('task start @fix-task', tempDir);
   470→      kspec('task submit @fix-task', tempDir);
   471→      kspec('task needs-work @fix-task --reason "Failing tests"', tempDir);
   472→
   473→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   474→      const task = session.active_tasks.find((t) => t.slug === 'fix-task');
   475→      expect(task).toBeDefined();
   476→      expect(task!.status).toBe('needs_work');
   477→    });
   478→
   479→    it('should distinguish needs_work from in_progress in same output', () => {
   480→      kspec('task add --title "Normal task" --slug normal-task', tempDir);
   481→      kspec('task start @normal-task', tempDir);
   482→
   483→      kspec('task add --title "Fix task" --slug fix-task', tempDir);
   484→      kspec('task start @fix-task', tempDir);
   485→      kspec('task submit @fix-task', tempDir);
   486→      kspec('task needs-work @fix-task --reason "Failing tests"', tempDir);
   487→
   488→      const result = kspec('session start', tempDir);
   489→      expect(result.stdout).toContain('[in_progress]');
   490→      expect(result.stdout).toContain('[needs_work]');
   491→    });
   492→  });
   493→
   494→  // AC: @cmd-session-start ac-review-detail
   495→  describe('review task detail', () => {
   496→    it('should show title and recent notes for pending_review tasks', () => {
   497→      kspec('task add --title "Review this" --slug review-this', tempDir);
   498→      kspec('task start @review-this', tempDir);
   499→      kspec('task note @review-this "Implementation complete, PR #100"', tempDir);
   500→      kspec('task submit @review-this', tempDir);
