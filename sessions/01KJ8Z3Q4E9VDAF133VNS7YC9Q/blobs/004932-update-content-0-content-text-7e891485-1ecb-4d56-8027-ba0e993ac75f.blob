   508→
   509→  // AC: @cmd-session-start ac-notes-starvation
   510→  describe('notes starvation prevention', () => {
   511→    it('should include notes from all statuses in JSON', { timeout: 20000 }, () => {
   512→      // Create in_progress tasks with many notes
   513→      for (let i = 1; i <= 5; i++) {
   514→        kspec(`task add --title "Active ${i}" --slug active-${i}`, tempDir);
   515→        kspec(`task start @active-${i}`, tempDir);
   516→        kspec(`task note @active-${i} "Active note ${i}"`, tempDir);
   517→      }
   518→
   519→      // Create pending_review task
   520→      kspec('task add --title "Review" --slug review-task', tempDir);
   521→      kspec('task start @review-task', tempDir);
   522→      kspec('task note @review-task "Review note"', tempDir);
   523→      kspec('task submit @review-task', tempDir);
   524→
   525→      // Create completed task
   526→      kspec('task add --title "Done" --slug done-task', tempDir);
   527→      kspec('task start @done-task', tempDir);
   528→      kspec('task note @done-task "Done note"', tempDir);
   529→      kspec('task submit @done-task', tempDir);
   530→      kspec('task complete @done-task --reason "Finished"', tempDir);
   531→
   532→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   533→
   534→      const inProgressNotes = session.recent_notes.filter(
