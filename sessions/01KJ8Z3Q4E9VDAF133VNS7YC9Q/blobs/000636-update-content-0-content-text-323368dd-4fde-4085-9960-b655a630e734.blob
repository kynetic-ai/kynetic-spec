    95→}
    96→
    97→/**
    98→ * Parse YAML content into an object
    99→ * Uses the modern yaml library which has consistent type handling
   100→ */
   101→export function parseYaml<T>(content: string): T {
   102→  return YAML.parse(content) as T;
   103→}
   104→
   105→/**
   106→ * Serialize object to YAML
   107→ * Uses the modern yaml library for consistent formatting.
   108→ *
   109→ * WORKAROUND: The 'yaml' library (v2.8.2+) has a known behavior where block scalars
   110→ * containing whitespace-only lines accumulate extra blank lines on each parse-stringify
   111→ * cycle. The library's blockString() function adds indentation after newlines, which
   112→ * causes lines containing only spaces to grow. We post-process the output to filter
   113→ * these whitespace-only lines. See: https://github.com/eemeli/yaml - stringifyString.ts
   114→ */
   115→export function toYaml(obj: unknown): string {
   116→  let yamlString = YAML.stringify(obj, {
   117→    indent: 2,
   118→    lineWidth: 100,
   119→    sortMapEntries: false,
   120→  });
   121→
   122→  // Post-process to fix yaml library blank line accumulation bug.
   123→  // Filter out lines that contain only spaces/tabs (not truly empty lines).
   124→  yamlString = yamlString
   125→    .split("\n")
   126→    .filter((line) => !/^[ \t]+$/.test(line))
   127→    .join("\n");
   128→
   129→  return yamlString;
   130→}
   131→
   132→/**
   133→ * Read and parse a YAML file
   134→ */
   135→export async function readYamlFile<T>(filePath: string): Promise<T> {
   136→  const content = await fs.readFile(filePath, "utf-8");
   137→  return parseYaml<T>(content);
   138→}
   139→
   140→/**
   141→ * Write object to YAML file
   142→ */
   143→export async function writeYamlFile(
   144→  filePath: string,
   145→  data: unknown,
   146→): Promise<void> {
   147→  const content = toYaml(data);
   148→  await fs.writeFile(filePath, content, "utf-8");
   149→}
   150→
   151→/**
   152→ * Write object to YAML file while preserving formatting and comments.
   153→ *
   154→ * Note: This function is now equivalent to writeYamlFile() - the "preserve format"
   155→ * naming is historical. Both use toYaml() which includes the whitespace-only line
   156→ * fix. Kept for backwards compatibility with existing callers.
   157→ */
   158→export async function writeYamlFilePreserveFormat(
   159→  filePath: string,
   160→  data: unknown,
   161→): Promise<void> {
   162→  const content = toYaml(data);
   163→  await fs.writeFile(filePath, content, "utf-8");
   164→}
   165→
   166→/**
   167→ * Find task files in a directory
   168→ */
   169→export async function findTaskFiles(dir: string): Promise<string[]> {
   170→  const files: string[] = [];
   171→
   172→  try {
   173→    const entries = await fs.readdir(dir, { withFileTypes: true });
   174→
   175→    for (const entry of entries) {
   176→      const fullPath = path.join(dir, entry.name);
   177→
   178→      if (entry.isDirectory()) {
   179→        // Recurse into subdirectories
   180→        const subFiles = await findTaskFiles(fullPath);
   181→        files.push(...subFiles);
   182→      } else if (entry.isFile() && entry.name.endsWith(".tasks.yaml")) {
   183→        files.push(fullPath);
   184→      }
   185→    }
   186→  } catch (_error) {
   187→    // Directory doesn't exist or not readable
   188→  }
   189→
   190→  return files;
   191→}
   192→
   193→/**
   194→ * Find the manifest file.
   195→ *
   196→ * Discovery algorithm per directory:
   197→ * 1. Check for explicit names: kynetic.yaml, kynetic.spec.yaml (backward compat)
   198→ * 2. If not found, scan for *.yaml files with 'kynetic:' version field
   199→ *
   200→ * Searches current dir, then spec/ subdir, then parent directories.
   201→ */
   202→export async function findManifest(startDir: string): Promise<string | null> {
   203→  let dir = startDir;
   204→
   205→  while (true) {
   206→    // Check current directory
   207→    const manifestInDir = await findManifestInDir(dir);
   208→    if (manifestInDir) {
   209→      return manifestInDir;
   210→    }
   211→
   212→    // Also check in spec/ subdirectory
   213→    const specDir = path.join(dir, "spec");
   214→    try {
   215→      const stat = await fs.stat(specDir);
   216→      if (stat.isDirectory()) {
   217→        const manifestInSpec = await findManifestInDir(specDir);
   218→        if (manifestInSpec) {
   219→          return manifestInSpec;
   220→        }
   221→      }
   222→    } catch {
   223→      // spec/ doesn't exist
   224→    }
   225→
   226→    const parentDir = path.dirname(dir);
   227→    if (parentDir === dir) {
   228→      // Reached root
   229→      return null;
   230→    }
   231→    dir = parentDir;
   232→  }
   233→}
   234→
   235→/**
   236→ * Context for working with spec/task files.
   237→ *
   238→ * When shadow branch is enabled:
   239→ * - rootDir points to the project root (where .kspec/ lives)
   240→ * - specDir points to .kspec/ (where spec files are read/written)
   241→ * - All file operations use specDir for resolution
   242→ *
   243→ * Without shadow branch:
   244→ * - rootDir is the project root
   245→ * - specDir is rootDir/spec/ (traditional layout)
   246→ */
   247→export interface KspecContext {
   248→  /** Project root directory */
   249→  rootDir: string;
   250→  /** Spec files directory (.kspec/ when shadow enabled, otherwise spec/) */
   251→  specDir: string;
   252→  /** Path to manifest file */
   253→  manifestPath: string | null;
   254→  /** Parsed manifest */
   255→  manifest: Manifest | null;
   256→  /** Shadow branch configuration (null if not using shadow) */
   257→  shadow: ShadowConfig | null;
   258→  /**
   259→   * Project configuration from kspec.config.yaml.
   260→   * Loaded before shadow detection. Always present (defaults if no config file).
   261→   *
   262→   * AC: @project-config ac-2 — config available on KspecContext.config
   263→   */
   264→  config: ResolvedKspecConfig;
   265→}
   266→
   267→/**
   268→ * Initialize context by finding manifest.
   269→ *
   270→ * Detection order:
   271→ * 1. Load project config from git root (before shadow detection)
   272→ * 2. Check for shadow branch (.kspec/ directory)
   273→ * 3. Fall back to traditional spec/ directory
   274→ *
   275→ * When shadow is detected, all operations use .kspec/ as specDir.
   276→ *
   277→ * AC: @project-config ac-2 — config loaded before shadow detection
   278→ */
   279→export async function initContext(startDir?: string): Promise<KspecContext> {
   280→  const cwd = startDir || process.cwd();
   281→
   282→  // AC: @project-config ac-2, ac-6, ac-7 — load config before shadow detection
   283→  // Config is loaded from git root, not cwd or KSPEC_SPEC_DIR temp dir
   284→  const configResult = await loadProjectConfig(cwd);
   285→
   286→  // AC: @project-config ac-3 — emit warning to stderr if config had issues
   287→  if (configResult.warning) {
   288→    console.error(`Warning: ${configResult.warning}`);
   289→  }
   290→
   291→  const { config } = configResult;
   292→
   293→  // KSPEC_SPEC_DIR override: used by batch atomic mode to redirect to temp copy
   294→  const specDirOverride = process.env.KSPEC_SPEC_DIR;
   295→  if (specDirOverride) {
   296→    const specDir = path.resolve(specDirOverride);
   297→    const manifestPath = await findManifestInDir(specDir);
   298→
   299→    let manifest: Manifest | null = null;
   300→    if (manifestPath) {
   301→      try {
   302→        const rawManifest = await readYamlFile<unknown>(manifestPath);
   303→        manifest = parseManifestWithWarnings(rawManifest);
   304→      } catch {
   305→        // Manifest exists but may be invalid
   306→      }
   307→    }
   308→
   309→    return {
   310→      rootDir: path.dirname(specDir),
   311→      specDir,
   312→      manifestPath,
   313→      manifest,
   314→      shadow: null, // No shadow in overridden context
   315→      config,
   316→    };
   317→  }
   318→
   319→  // Check if running from inside the shadow worktree
   320→  // AC: @config-shadow ac-8 — pass configured directory for detection
   321→  const mainProjectRoot = await detectRunningFromShadowWorktree(
   322→    cwd,
   323→    config.shadow.directory,
   324→  );
   325→  if (mainProjectRoot) {
   326→    throw new ShadowError(
   327→      errors.project.runningFromShadow,
   328→      "RUNNING_FROM_SHADOW",
   329→      `Run from project root: cd ${path.relative(cwd, mainProjectRoot) || mainProjectRoot}`,
   330→    );
   331→  }
   332→
   333→  // Try to detect shadow branch first
   334→  // AC: @config-shadow ac-1 ac-2 — use configured branch/directory names
   335→  const shadow = await detectShadow(cwd, {
   336→    branchName: config.shadow.branch,
   337→    directory: config.shadow.directory,
   338→  });
   339→
   340→  if (shadow?.enabled) {
   341→    // Shadow mode: use .kspec/ for everything
   342→    const specDir = shadow.worktreeDir;
   343→    const manifestPath = await findManifestInDir(specDir);
   344→
   345→    let manifest: Manifest | null = null;
   346→    if (manifestPath) {
   347→      try {
   348→        const rawManifest = await readYamlFile<unknown>(manifestPath);
   349→        manifest = parseManifestWithWarnings(rawManifest);
   350→      } catch {
   351→        // Manifest exists but may be invalid
   352→      }
   353→    }
   354→
   355→    return {
   356→      rootDir: shadow.projectRoot,
   357→      specDir,
   358→      manifestPath,
   359→      manifest,
   360→      shadow,
   361→      config,
   362→    };
   363→  }
   364→
   365→  // Traditional mode: find manifest in spec/ or current directory
   366→  const manifestPath = await findManifest(cwd);
   367→
   368→  let manifest: Manifest | null = null;
   369→  let rootDir = cwd;
   370→  let specDir = cwd;
   371→
   372→  if (manifestPath) {
   373→    const manifestDir = path.dirname(manifestPath);
   374→    // Handle spec/ subdirectory
   375→    if (path.basename(manifestDir) === "spec") {
   376→      rootDir = path.dirname(manifestDir);
   377→      specDir = manifestDir;
   378→    } else {
   379→      rootDir = manifestDir;
   380→      specDir = manifestDir;
   381→    }
   382→
   383→    try {
   384→      const rawManifest = await readYamlFile<unknown>(manifestPath);
   385→      manifest = parseManifestWithWarnings(rawManifest);
   386→    } catch {
   387→      // Manifest exists but may be invalid
   388→    }
   389→  }
   390→
   391→  return { rootDir, specDir, manifestPath, manifest, shadow: null, config };
   392→}
   393→
   394→/**
   395→ * Check if a filename is a potential manifest file.
   396→ * Excludes files with suffixes that indicate other kspec file types.
   397→ *
   398→ * AC: @manifest-discovery ac-5 (excludes task/inbox/meta/runs files)
   399→ */
   400→function isManifestCandidate(filename: string): boolean {
   401→  if (!filename.endsWith(".yaml")) return false;
   402→  const exclusions = [".tasks.yaml", ".inbox.yaml", ".meta.yaml", ".runs.yaml"];
   403→  return !exclusions.some((excl) => filename.endsWith(excl));
   404→}
   405→
   406→/**
   407→ * Find manifest file within a specific directory (no parent traversal).
   408→ * Used for shadow mode where we know exactly where to look.
   409→ *
   410→ * Discovery algorithm:
   411→ * 1. Check for explicit names: kynetic.yaml, kynetic.spec.yaml (backward compat)
   412→ * 2. If not found, scan directory for *.yaml files (excluding other kspec types)
   413→ * 3. For each candidate, validate it contains a 'kynetic:' version field
   414→ * 4. Return first valid match (alphabetically after explicit names)
   415→ *
   416→ * AC: @manifest-discovery ac-1, ac-2, ac-3, ac-4, ac-5
   417→ */
   418→async function findManifestInDir(dir: string): Promise<string | null> {
   419→  // AC: @manifest-discovery ac-1, ac-2 - explicit names have priority
   420→  const priorityCandidates = ["kynetic.yaml", "kynetic.spec.yaml"];
   421→
   422→  for (const candidate of priorityCandidates) {
   423→    const filePath = path.join(dir, candidate);
   424→    try {
   425→      await fs.access(filePath);
   426→      return filePath;
   427→    } catch {
   428→      // File doesn't exist, try next
   429→    }
   430→  }
   431→
   432→  // AC: @manifest-discovery ac-3, ac-4, ac-5 - glob fallback with validation
   433→  try {
   434→    const entries = await fs.readdir(dir);
   435→    // AC: @manifest-discovery ac-4 - alphabetical order
   436→    const candidates = entries.filter(isManifestCandidate).sort();
   437→
   438→    for (const candidate of candidates) {
   439→      const filePath = path.join(dir, candidate);
   440→      try {
   441→        const raw = await readYamlFile<unknown>(filePath);
   442→        // AC: @manifest-discovery ac-5 - validate kynetic version field
   443→        if (raw && typeof raw === "object" && "kynetic" in raw) {
   444→          return filePath;
   445→        }
   446→      } catch {
   447→        // Skip invalid files
   448→      }
   449→    }
   450→  } catch {
   451→    // Directory read failed
   452→  }
   453→
   454→  return null;
   455→}
   456→
   457→/**
   458→ * Load tasks from a single file.
   459→ * Helper function used by loadAllTasks.
   460→ */
   461→async function loadTasksFromFile(filePath: string): Promise<LoadedTask[]> {
   462→  const tasks: LoadedTask[] = [];
   463→
   464→  try {
   465→    const raw = await readYamlFile<unknown>(filePath);
   466→
   467→    // Handle both array format and object format
   468→    let taskList: unknown[];
   469→
   470→    if (Array.isArray(raw)) {
   471→      taskList = raw;
   472→    } else if (raw && typeof raw === "object" && "tasks" in raw) {
   473→      const parsed = TasksFileSchema.safeParse(raw);
   474→      if (parsed.success) {
   475→        // Add _sourceFile to each task from this file
   476→        for (const task of parsed.data.tasks) {
   477→          tasks.push({ ...task, _sourceFile: filePath });
   478→        }
   479→        return tasks;
   480→      }
   481→      taskList = (raw as { tasks: unknown[] }).tasks || [];
   482→    } else {
   483→      // Single task object
   484→      taskList = [raw];
   485→    }
   486→
   487→    for (const taskData of taskList) {
   488→      const result = TaskSchema.safeParse(taskData);
   489→      if (result.success) {
   490→        // Add _sourceFile metadata
   491→        tasks.push({ ...result.data, _sourceFile: filePath });
   492→      }
   493→    }
   494→  } catch {
   495→    // Skip invalid files
   496→  }
   497→
   498→  return tasks;
   499→}
   500→
   501→/**
   502→ * Load all tasks from the project.
   503→ * Each task includes _sourceFile metadata for write-back routing.
   504→ *
   505→ * When shadow is enabled, tasks are loaded from .kspec/ (ctx.specDir).
   506→ * Otherwise, searches in traditional locations (rootDir, spec/, tasks/).
   507→ */
   508→export async function loadAllTasks(ctx: KspecContext): Promise<LoadedTask[]> {
   509→  const tasks: LoadedTask[] = [];
   510→
   511→  // When shadow is enabled, look only in specDir
   512→  if (ctx.shadow?.enabled) {
   513→    const taskFiles = await findTaskFiles(ctx.specDir);
   514→
   515→    // Also check for standalone files in specDir
   516→    const standaloneLocations = [
   517→      path.join(ctx.specDir, "tasks.yaml"),
   518→      path.join(ctx.specDir, "project.tasks.yaml"),
   519→      path.join(ctx.specDir, "kynetic.tasks.yaml"),
   520→      path.join(ctx.specDir, "backlog.tasks.yaml"),
   521→      path.join(ctx.specDir, "active.tasks.yaml"),
   522→    ];
   523→
   524→    for (const loc of standaloneLocations) {
   525→      try {
   526→        await fs.access(loc);
   527→        if (!taskFiles.includes(loc)) {
   528→          taskFiles.push(loc);
   529→        }
   530→      } catch {
   531→        // File doesn't exist
   532→      }
   533→    }
   534→
   535→    // Deduplicate and load
   536→    const uniqueFiles = [...new Set(taskFiles)];
   537→    for (const filePath of uniqueFiles) {
   538→      const fileTasks = await loadTasksFromFile(filePath);
   539→      tasks.push(...fileTasks);
   540→    }
   541→
   542→    return tasks;
   543→  }
   544→
   545→  // Traditional mode: look in multiple locations
   546→  const taskFiles = await findTaskFiles(ctx.rootDir);
   547→
   548→  // Also check common locations
   549→  const additionalPaths = [
   550→    path.join(ctx.rootDir, "tasks"),
   551→    path.join(ctx.rootDir, "spec"),
   552→  ];
   553→
   554→  for (const additionalPath of additionalPaths) {
   555→    const files = await findTaskFiles(additionalPath);
   556→    taskFiles.push(...files);
   557→  }
   558→
   559→  // Also look for standalone tasks.yaml and project.tasks.yaml
   560→  const standaloneLocations = [
   561→    path.join(ctx.rootDir, "tasks.yaml"),
   562→    path.join(ctx.rootDir, "project.tasks.yaml"),
   563→    path.join(ctx.rootDir, "spec", "project.tasks.yaml"),
   564→    path.join(ctx.rootDir, "backlog.tasks.yaml"),
   565→    path.join(ctx.rootDir, "active.tasks.yaml"),
   566→  ];
   567→
   568→  for (const loc of standaloneLocations) {
   569→    try {
   570→      await fs.access(loc);
   571→      if (!taskFiles.includes(loc)) {
   572→        taskFiles.push(loc);
   573→      }
   574→    } catch {
   575→      // File doesn't exist
   576→    }
   577→  }
   578→
   579→  // Deduplicate and load
   580→  const uniqueFiles = [...new Set(taskFiles)];
   581→
   582→  for (const filePath of uniqueFiles) {
   583→    const fileTasks = await loadTasksFromFile(filePath);
   584→    tasks.push(...fileTasks);
   585→  }
   586→
   587→  return tasks;
   588→}
   589→
   590→/**
   591→ * Find a task by reference (ULID, slug, or short reference)
   592→ */
   593→export function findTaskByRef(
   594→  tasks: LoadedTask[],
   595→  ref: string,
   596→): LoadedTask | undefined {
   597→  // Remove @ prefix if present
   598→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   599→
   600→  return tasks.find((task) => {
   601→    // Match full ULID
   602→    if (task._ulid === cleanRef) return true;
   603→
   604→    // Match short ULID (prefix)
   605→    if (task._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
   606→      return true;
   607→
   608→    // Match slug
   609→    if (task.slugs.includes(cleanRef)) return true;
   610→
   611→    return false;
   612→  });
   613→}
   614→
   615→/**
   616→ * Get the default task file path for new tasks without a spec_ref.
   617→ *
   618→ * When shadow enabled: .kspec/project.tasks.yaml
   619→ * Otherwise: spec/project.tasks.yaml
   620→ */
   621→export function getDefaultTaskFilePath(ctx: KspecContext): string {
   622→  return path.join(ctx.specDir, "project.tasks.yaml");
   623→}
   624→
   625→/**
   626→ * Strip runtime metadata before serialization
   627→ */
   628→function stripRuntimeMetadata(task: LoadedTask): Task {
   629→  const { _sourceFile, ...cleanTask } = task;
   630→  return cleanTask as Task;
   631→}
   632→
   633→/**
   634→ * Save a task to its source file (or default location for new tasks).
   635→ * Preserves file format (tasks: [...] wrapper vs plain array).
   636→ */
   637→export async function saveTask(
   638→  ctx: KspecContext,
   639→  task: LoadedTask,
   640→): Promise<void> {
   641→  // Determine target file: use _sourceFile if present, otherwise default
   642→  const taskFilePath = task._sourceFile || getDefaultTaskFilePath(ctx);
   643→
   644→  // Lock the file to prevent concurrent read-modify-write races
   645→  await withFileLock(taskFilePath, async () => {
   646→    // Ensure directory exists
   647→    const dir = path.dirname(taskFilePath);
   648→    await fs.mkdir(dir, { recursive: true });
   649→
   650→    // Load existing tasks from the target file
   651→    let existingRaw: unknown = null;
   652→    let useTasksWrapper = false;
   653→
   654→    try {
   655→      existingRaw = await readYamlFile<unknown>(taskFilePath);
   656→      // Detect if file uses { tasks: [...] } format
   657→      if (
   658→        existingRaw &&
   659→        typeof existingRaw === "object" &&
   660→        "tasks" in existingRaw
   661→      ) {
   662→        useTasksWrapper = true;
   663→      }
   664→    } catch {
   665→      // File doesn't exist, start fresh
   666→    }
   667→
   668→    // Parse existing tasks from file
   669→    let fileTasks: Task[] = [];
   670→
   671→    if (existingRaw) {
   672→      if (Array.isArray(existingRaw)) {
   673→        for (const t of existingRaw) {
   674→          const result = TaskSchema.safeParse(t);
   675→          if (result.success) {
   676→            fileTasks.push(result.data);
   677→          }
   678→        }
   679→      } else if (useTasksWrapper) {
   680→        // Try TasksFileSchema first (has kynetic_tasks version)
   681→        const parsed = TasksFileSchema.safeParse(existingRaw);
   682→        if (parsed.success) {
   683→          fileTasks = parsed.data.tasks;
   684→        } else {
   685→          // Fall back to raw tasks array (common format without version field)
   686→          const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   687→          if (Array.isArray(rawTasks)) {
   688→            for (const t of rawTasks) {
   689→              const result = TaskSchema.safeParse(t);
   690→              if (result.success) {
   691→                fileTasks.push(result.data);
   692→              }
   693→            }
   694→          }
   695→        }
   696→      }
   697→    }
   698→
   699→    // Strip runtime metadata before saving
   700→    const cleanTask = stripRuntimeMetadata(task);
   701→
   702→    // Update existing or add new
   703→    const existingIndex = fileTasks.findIndex((t) => t._ulid === task._ulid);
   704→    if (existingIndex >= 0) {
   705→      fileTasks[existingIndex] = cleanTask;
   706→    } else {
   707→      fileTasks.push(cleanTask);
   708→    }
   709→
   710→    // Save in the same format as original (or tasks: wrapper for new files)
   711→    // Use format-preserving write to maintain formatting and comments
   712→    if (useTasksWrapper) {
   713→      await writeYamlFilePreserveFormat(taskFilePath, { tasks: fileTasks });
   714→    } else {
   715→      await writeYamlFilePreserveFormat(taskFilePath, fileTasks);
   716→    }
   717→  });
   718→}
   719→
   720→/**
   721→ * Delete a task from its source file.
   722→ * Requires _sourceFile to know which file to modify.
   723→ */
   724→export async function deleteTask(
   725→  _ctx: KspecContext,
   726→  task: LoadedTask,
   727→): Promise<void> {
   728→  if (!task._sourceFile) {
   729→    throw new Error("Cannot delete task without _sourceFile metadata");
   730→  }
   731→
   732→  const taskFilePath = task._sourceFile;
   733→
   734→  // Lock the file to prevent concurrent read-modify-write races
   735→  await withFileLock(taskFilePath, async () => {
   736→    // Load existing file
   737→    let existingRaw: unknown = null;
   738→    let useTasksWrapper = false;
   739→
   740→    try {
   741→      existingRaw = await readYamlFile<unknown>(taskFilePath);
   742→      if (
   743→        existingRaw &&
   744→        typeof existingRaw === "object" &&
   745→        "tasks" in existingRaw
   746→      ) {
   747→        useTasksWrapper = true;
   748→      }
   749→    } catch {
   750→      throw new Error(`Task file not found: ${taskFilePath}`);
   751→    }
   752→
   753→    // Parse existing tasks
   754→    let fileTasks: Task[] = [];
   755→
   756→    if (existingRaw) {
   757→      if (Array.isArray(existingRaw)) {
   758→        for (const t of existingRaw) {
   759→          const result = TaskSchema.safeParse(t);
   760→          if (result.success) {
   761→            fileTasks.push(result.data);
   762→          }
   763→        }
   764→      } else if (useTasksWrapper) {
   765→        const parsed = TasksFileSchema.safeParse(existingRaw);
   766→        if (parsed.success) {
   767→          fileTasks = parsed.data.tasks;
   768→        } else {
   769→          const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   770→          if (Array.isArray(rawTasks)) {
   771→            for (const t of rawTasks) {
   772→              const result = TaskSchema.safeParse(t);
   773→              if (result.success) {
   774→                fileTasks.push(result.data);
   775→              }
   776→            }
   777→          }
   778→        }
   779→      }
   780→    }
   781→
   782→    // Remove the task
   783→    const originalCount = fileTasks.length;
   784→    fileTasks = fileTasks.filter((t) => t._ulid !== task._ulid);
   785→
   786→    if (fileTasks.length === originalCount) {
   787→      throw new Error(`Task not found in file: ${task._ulid}`);
   788→    }
   789→
   790→    // Save the modified file with format preservation
   791→    if (useTasksWrapper) {
   792→      await writeYamlFilePreserveFormat(taskFilePath, { tasks: fileTasks });
   793→    } else {
   794→      await writeYamlFilePreserveFormat(taskFilePath, fileTasks);
   795→    }
   796→  });
   797→}
   798→
   799→/**
   800→ * Create a new task with auto-generated fields
   801→ */
   802→export function createTask(input: TaskInput): Task {
   803→  const now = new Date().toISOString();
   804→
   805→  return {
   806→    ...input,
   807→    _ulid: input._ulid || ulid(),
   808→    slugs: input.slugs || [],
   809→    type: input.type || "task",
   810→    status: input.status || "pending",
   811→    blocked_by: input.blocked_by || [],
   812→    depends_on: input.depends_on || [],
   813→    context: input.context || [],
   814→    priority: input.priority || 3,
   815→    tags: input.tags || [],
   816→    vcs_refs: input.vcs_refs || [],
   817→    created_at: input.created_at || now,
   818→    notes: input.notes || [],
   819→    todos: input.todos || [],
   820→  };
   821→}
   822→
   823→/**
   824→ * Get author from environment with fallback chain.
   825→ * Priority:
   826→ *   1. KSPEC_AUTHOR env var (explicit config, agent-agnostic)
   827→ *   2. kspec.config.yaml identity.author (project-level default)
   828→ *   3. git user.name (developer identity)
   829→ *   4. USER/USERNAME env var (system user)
   830→ *   5. undefined (will show as 'unknown' in output)
   831→ *
   832→ * For Claude Code integration, add to ~/.claude/settings.json:
   833→ *   { "env": { "KSPEC_AUTHOR": "@claude" } }
   834→ *
   835→ * AC: @config-author ac-1 ac-2 ac-3 — author priority chain
   836→ *
   837→ * @param configAuthor Optional author from kspec.config.yaml identity.author
   838→ */
   839→export function getAuthor(configAuthor?: string | null): string | undefined {
   840→  // 1. Explicit env var (works for any agent) — AC: ac-2
   841→  if (process.env.KSPEC_AUTHOR) {
   842→    return process.env.KSPEC_AUTHOR;
   843→  }
   844→
   845→  // 2. Project config author — AC: ac-1
   846→  if (configAuthor) {
   847→    return configAuthor;
   848→  }
   849→
   850→  // 3. Git user.name — AC: ac-3
   851→  try {
   852→    const gitUser = execSync("git config user.name", {
   853→      encoding: "utf-8",
   854→      stdio: ["pipe", "pipe", "ignore"],
   855→    }).trim();
   856→    if (gitUser) {
   857→      return gitUser;
   858→    }
   859→  } catch {
   860→    // git not available or not in a repo
   861→  }
   862→
   863→  // 4. System user — AC: ac-3
   864→  const systemUser = process.env.USER || process.env.USERNAME;
   865→  if (systemUser) {
   866→    return systemUser;
   867→  }
   868→
   869→  // 5. No author available
   870→  return undefined;
   871→}
   872→
   873→/**
   874→ * Create a new note entry.
   875→ * If author is not provided, attempts to auto-detect from environment.
   876→ */
   877→export function createNote(
   878→  content: string,
   879→  author?: string,
   880→  supersedes?: string,
   881→): Note {
   882→  return {
   883→    _ulid: ulid(),
   884→    created_at: new Date().toISOString(),
   885→    author: author ?? getAuthor(),
   886→    // Trim content to prevent whitespace-only lines from accumulating
   887→    // in block scalars during YAML parse-stringify cycles
   888→    content: content.trim(),
   889→    supersedes: supersedes || null,
   890→  };
   891→}
   892→
   893→/**
   894→ * Create a new todo item.
   895→ * The id should be the next available id for the task's todos array.
   896→ */
   897→export function createTodo(id: number, text: string, addedBy?: string): Todo {
   898→  return {
   899→    id,
   900→    // Trim text to prevent whitespace-only lines from accumulating
   901→    // in block scalars during YAML parse-stringify cycles
   902→    text: text.trim(),
   903→    done: false,
   904→    added_at: new Date().toISOString(),
   905→    added_by: addedBy ?? getAuthor(),
   906→  };
   907→}
   908→
   909→/**
   910→ * Check if task dependencies are met
   911→ */
   912→export function areDependenciesMet(
   913→  task: LoadedTask,
   914→  allTasks: LoadedTask[],
   915→): boolean {
   916→  if (task.depends_on.length === 0) return true;
   917→
   918→  for (const depRef of task.depends_on) {
   919→    const depTask = findTaskByRef(allTasks, depRef);
   920→    if (!depTask || depTask.status !== "completed") {
   921→      return false;
   922→    }
   923→  }
   924→
   925→  return true;
   926→}
   927→
   928→/**
   929→ * Check if task is ready (pending + deps met + not blocked)
   930→ */
   931→export function isTaskReady(task: LoadedTask, allTasks: LoadedTask[]): boolean {
   932→  if (task.status !== "pending") return false;
   933→  if (task.blocked_by.length > 0) return false;
   934→  return areDependenciesMet(task, allTasks);
   935→}
   936→
   937→/**
   938→ * Get ready tasks (pending + deps met + not blocked), sorted by priority then creation time.
   939→ * Within the same priority tier, older tasks come first (FIFO).
   940→ */
   941→export function getReadyTasks(tasks: LoadedTask[]): LoadedTask[] {
   942→  return tasks
   943→    .filter((task) => isTaskReady(task, tasks))
   944→    .sort((a, b) => {
   945→      // Primary: priority (lower number = higher priority)
   946→      if (a.priority !== b.priority) {
   947→        return a.priority - b.priority;
   948→      }
   949→      // Secondary: creation time (older first - FIFO within priority)
   950→      return (
   951→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime()
   952→      );
   953→    });
   954→}
   955→
   956→// ============================================================
   957→// SPEC ITEM LOADING
   958→// ============================================================
   959→
   960→/**
   961→ * Expand a glob-like include pattern to file paths.
   962→ * Supports simple patterns like "modules/*.yaml" or "**\/*.yaml"
   963→ */
   964→export async function expandIncludePattern(
   965→  pattern: string,
   966→  baseDir: string,
   967→): Promise<string[]> {
   968→  const fullPattern = path.isAbsolute(pattern)
   969→    ? pattern
   970→    : path.join(baseDir, pattern);
   971→
   972→  // If no glob characters, just return the path if it exists
   973→  if (!pattern.includes("*")) {
   974→    try {
   975→      await fs.access(fullPattern);
   976→      return [fullPattern];
   977→    } catch {
   978→      return [];
   979→    }
   980→  }
   981→
   982→  // Split pattern into directory part and file pattern
   983→  const parts = pattern.split("/");
   984→  let currentDir = baseDir;
   985→  const result: string[] = [];
   986→
   987→  // Find the first part with a glob
   988→  const globIndex = parts.findIndex((p) => p.includes("*"));
   989→
   990→  // Navigate to the directory before the glob
   991→  if (globIndex > 0) {
   992→    currentDir = path.join(baseDir, ...parts.slice(0, globIndex));
   993→  }
   994→
   995→  // Get the remaining pattern
   996→  const remainingPattern = parts.slice(globIndex).join("/");
   997→
   998→  await expandGlobRecursive(currentDir, remainingPattern, result);
   999→  return result;
  1000→}
  1001→
  1002→/**
  1003→ * Recursively expand glob patterns
  1004→ */
  1005→async function expandGlobRecursive(
  1006→  dir: string,
  1007→  pattern: string,
  1008→  result: string[],
  1009→): Promise<void> {
  1010→  const parts = pattern.split("/");
  1011→  const currentPattern = parts[0];
  1012→  const remainingPattern = parts.slice(1).join("/");
  1013→
  1014→  try {
  1015→    const entries = await fs.readdir(dir, { withFileTypes: true });
  1016→
  1017→    for (const entry of entries) {
  1018→      const matches = matchGlobPart(entry.name, currentPattern);
  1019→
  1020→      if (matches) {
  1021→        const fullPath = path.join(dir, entry.name);
  1022→
  1023→        if (remainingPattern) {
  1024→          // More pattern parts to process
  1025→          if (entry.isDirectory()) {
  1026→            await expandGlobRecursive(fullPath, remainingPattern, result);
  1027→          }
  1028→        } else {
  1029→          // This is the final pattern part
  1030→          if (currentPattern === "**") {
  1031→            // ** matches any depth - need special handling
  1032→            if (entry.isDirectory()) {
  1033→              await expandGlobRecursive(fullPath, "**", result);
  1034→            }
  1035→            // Also match files at this level
  1036→            result.push(fullPath);
  1037→          } else if (entry.isFile()) {
  1038→            result.push(fullPath);
  1039→          }
  1040→        }
  1041→      }
  1042→
  1043→      // Handle ** - also recurse into directories without consuming the pattern
  1044→      if (currentPattern === "**" && entry.isDirectory()) {
  1045→        const fullPath = path.join(dir, entry.name);
  1046→        await expandGlobRecursive(fullPath, pattern, result);
  1047→      }
  1048→    }
  1049→  } catch {
  1050→    // Directory doesn't exist or not readable
  1051→  }
  1052→}
  1053→
  1054→/**
  1055→ * Match a single path component against a glob pattern part
  1056→ */
  1057→function matchGlobPart(name: string, pattern: string): boolean {
  1058→  if (pattern === "*") return true;
  1059→  if (pattern === "**") return true;
  1060→
  1061→  // Convert glob pattern to regex
  1062→  const regexPattern = pattern
  1063→    .replace(/[.+^${}()|[\]\\]/g, "\\$&") // Escape special regex chars
  1064→    .replace(/\*/g, ".*") // * matches anything
  1065→    .replace(/\?/g, "."); // ? matches single char
  1066→
  1067→  const regex = new RegExp(`^${regexPattern}$`);
  1068→  return regex.test(name);
  1069→}
  1070→
  1071→/**
  1072→ * Fields that may contain nested spec items
  1073→ */
  1074→const NESTED_ITEM_FIELDS = [
  1075→  "modules",
  1076→  "features",
  1077→  "requirements",
  1078→  "constraints",
  1079→  "decisions",
  1080→  "traits",
  1081→  "acceptance_criteria",
  1082→];
  1083→
  1084→/**
  1085→ * Recursively extract all spec items from a raw YAML structure.
  1086→ * Items can be nested under modules/features/requirements/etc.
  1087→ * Tracks the path within the file for each item.
  1088→ */
  1089→export function extractItemsFromRaw(
  1090→  raw: unknown,
  1091→  sourceFile: string,
  1092→  items: LoadedSpecItem[] = [],
  1093→  currentPath: string = "",
  1094→): LoadedSpecItem[] {
  1095→  if (!raw || typeof raw !== "object") {
  1096→    return items;
  1097→  }
  1098→
  1099→  // Check if this object is itself a spec item (has _ulid)
  1100→  if (
  1101→    "_ulid" in raw &&
  1102→    typeof (raw as Record<string, unknown>)._ulid === "string"
  1103→  ) {
  1104→    // Strip nested item arrays before validation since they're processed separately
  1105→    // and the SpecItemSchema expects refs (strings), not nested objects
  1106→    const rawObj = raw as Record<string, unknown>;
  1107→    const cleanedForValidation: Record<string, unknown> = { ...rawObj };
  1108→    for (const field of NESTED_ITEM_FIELDS) {
  1109→      if (field in cleanedForValidation && Array.isArray(cleanedForValidation[field])) {
  1110→        const arr = cleanedForValidation[field] as unknown[];
  1111→        // Check if array contains nested items (objects with _ulid) vs refs (strings)
  1112→        const hasNestedItems = arr.some(
  1113→          (item) =>
  1114→            item && typeof item === "object" && "_ulid" in (item as Record<string, unknown>)
  1115→        );
  1116→        if (hasNestedItems) {
  1117→          // Strip nested items - they'll be extracted recursively
  1118→          delete cleanedForValidation[field];
  1119→        }
  1120→      }
  1121→    }
  1122→
  1123→    const result = SpecItemSchema.safeParse(cleanedForValidation);
  1124→    if (result.success) {
  1125→      items.push({
  1126→        ...result.data,
  1127→        _sourceFile: sourceFile,
  1128→        _path: currentPath || undefined,
  1129→      });
  1130→    }
  1131→
  1132→    // Even if the item itself was added, also extract nested items
  1133→    for (const field of NESTED_ITEM_FIELDS) {
  1134→      if (field in rawObj && Array.isArray(rawObj[field])) {
  1135→        const arr = rawObj[field] as unknown[];
  1136→        for (let i = 0; i < arr.length; i++) {
  1137→          const nestedPath = currentPath
  1138→            ? `${currentPath}.${field}[${i}]`
  1139→            : `${field}[${i}]`;
  1140→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
  1141→        }
  1142→      }
  1143→    }
  1144→  } else if (Array.isArray(raw)) {
  1145→    // Array of items at root level
  1146→    for (let i = 0; i < raw.length; i++) {
  1147→      const itemPath = currentPath ? `${currentPath}[${i}]` : `[${i}]`;
  1148→      extractItemsFromRaw(raw[i], sourceFile, items, itemPath);
  1149→    }
  1150→  } else {
  1151→    // Object that might contain item arrays (like manifest with modules/features/etc)
  1152→    const rawObj = raw as Record<string, unknown>;
  1153→    for (const field of NESTED_ITEM_FIELDS) {
  1154→      if (field in rawObj && Array.isArray(rawObj[field])) {
  1155→        const arr = rawObj[field] as unknown[];
  1156→        for (let i = 0; i < arr.length; i++) {
  1157→          const nestedPath = currentPath
  1158→            ? `${currentPath}.${field}[${i}]`
  1159→            : `${field}[${i}]`;
  1160→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
  1161→        }
  1162→      }
  1163→    }
  1164→  }
  1165→
  1166→  return items;
  1167→}
  1168→
  1169→/**
  1170→ * Load spec items from a single file.
  1171→ * Handles module files (the file itself is an item with nested children).
  1172→ */
  1173→export async function loadSpecFile(
  1174→  filePath: string,
  1175→): Promise<LoadedSpecItem[]> {
  1176→  try {
  1177→    const content = await fs.readFile(filePath, "utf-8");
  1178→    const items: LoadedSpecItem[] = [];
  1179→
  1180→    // Parse all YAML documents in the file (handles files with ---)
  1181→    const documents = YAML.parseAllDocuments(content);
  1182→
  1183→    for (const doc of documents) {
  1184→      if (doc.errors.length > 0) {
  1185→        // Skip documents with parse errors
  1186→        continue;
  1187→      }
  1188→
  1189→      const raw = doc.toJS();
  1190→      if (raw) {
  1191→        const docItems = extractItemsFromRaw(raw, filePath);
  1192→        items.push(...docItems);
  1193→      }
  1194→    }
  1195→
  1196→    return items;
  1197→  } catch (_error) {
  1198→    // File doesn't exist or parse error
  1199→    return [];
  1200→  }
  1201→}
  1202→
  1203→/**
  1204→ * Load all spec items from the project.
  1205→ * Parses manifest, follows includes, and builds unified collection.
  1206→ */
  1207→export async function loadAllItems(
  1208→  ctx: KspecContext,
  1209→): Promise<LoadedSpecItem[]> {
  1210→  const items: LoadedSpecItem[] = [];
  1211→
  1212→  if (!ctx.manifest || !ctx.manifestPath) {
  1213→    return items;
  1214→  }
  1215→
  1216→  const manifestDir = path.dirname(ctx.manifestPath);
  1217→
  1218→  // Extract items from manifest itself (inline modules/features/etc)
  1219→  const manifestItems = extractItemsFromRaw(ctx.manifest, ctx.manifestPath);
  1220→  items.push(...manifestItems);
  1221→
  1222→  // Process includes
  1223→  const includes = ctx.manifest.includes || [];
  1224→
  1225→  for (const include of includes) {
  1226→    const expandedPaths = await expandIncludePattern(include, manifestDir);
  1227→
  1228→    for (const filePath of expandedPaths) {
  1229→      const fileItems = await loadSpecFile(filePath);
  1230→      items.push(...fileItems);
  1231→    }
  1232→  }
  1233→
  1234→  return items;
  1235→}
  1236→
  1237→/**
  1238→ * Find a spec item by reference (ULID, slug, or short reference)
  1239→ */
  1240→export function findItemByRef(
  1241→  items: LoadedSpecItem[],
  1242→  ref: string,
  1243→): LoadedSpecItem | undefined {
  1244→  // Remove @ prefix if present
  1245→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1246→
  1247→  return items.find((item) => {
  1248→    // Match full ULID
  1249→    if (item._ulid === cleanRef) return true;
  1250→
  1251→    // Match short ULID (prefix)
  1252→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  1253→      return true;
  1254→
  1255→    // Match slug
  1256→    if (item.slugs.includes(cleanRef)) return true;
  1257→
  1258→    return false;
  1259→  });
  1260→}
  1261→
  1262→/**
  1263→ * Combined item type for unified queries across tasks and spec items
  1264→ */
  1265→export type AnyLoadedItem = LoadedTask | LoadedSpecItem;
  1266→
  1267→/**
  1268→ * Find any item (task or spec item) by reference
  1269→ */
  1270→export function findAnyItemByRef(
  1271→  tasks: LoadedTask[],
  1272→  items: LoadedSpecItem[],
  1273→  ref: string,
  1274→): AnyLoadedItem | undefined {
  1275→  // Try tasks first (more commonly referenced)
  1276→  const task = findTaskByRef(tasks, ref);
  1277→  if (task) return task;
  1278→
  1279→  // Then try spec items
  1280→  return findItemByRef(items, ref);
  1281→}
  1282→
  1283→/**
  1284→ * Build a ReferenceIndex from context.
  1285→ * Loads all tasks and spec items, then builds the index.
  1286→ */
  1287→export async function buildReferenceIndex(ctx: KspecContext): Promise<{
  1288→  index: ReferenceIndex;
  1289→  tasks: LoadedTask[];
  1290→  items: LoadedSpecItem[];
  1291→}> {
  1292→  const tasks = await loadAllTasks(ctx);
  1293→  const items = await loadAllItems(ctx);
  1294→  const index = new ReferenceIndex(tasks, items);
  1295→  return { index, tasks, items };
  1296→}
  1297→
  1298→/**
  1299→ * Build both ReferenceIndex and ItemIndex from context.
  1300→ * Use this when you need query capabilities in addition to reference resolution.
  1301→ * Pass plans for cross-namespace slug collision detection (plans aren't loaded by default
  1302→ * to avoid circular dependency with plans.ts).
  1303→ */
  1304→export async function buildIndexes(ctx: KspecContext, plans: LoadedPlan[] = []): Promise<{
  1305→  refIndex: ReferenceIndex;
  1306→  itemIndex: ItemIndex;
  1307→  traitIndex: TraitIndex;
  1308→  tasks: LoadedTask[];
  1309→  items: LoadedSpecItem[];
  1310→}> {
  1311→  const tasks = await loadAllTasks(ctx);
  1312→  const items = await loadAllItems(ctx);
  1313→  const refIndex = new ReferenceIndex(tasks, items, [], plans);
  1314→  const itemIndex = new ItemIndex(tasks, items);
  1315→  const traitIndex = new TraitIndex(items, refIndex);
  1316→  return { refIndex, itemIndex, traitIndex, tasks, items };
  1317→}
  1318→
  1319→// ============================================================
  1320→// SPEC ITEM CRUD (supports nested structures)
  1321→// ============================================================
  1322→
  1323→/**
  1324→ * Strip runtime metadata from spec item before serialization
  1325→ */
  1326→function stripSpecItemMetadata(item: LoadedSpecItem): SpecItem {
  1327→  const { _sourceFile, _path, ...cleanItem } = item;
  1328→  return cleanItem as SpecItem;
  1329→}
  1330→
  1331→/**
  1332→ * Parse a path string into segments.
  1333→ * e.g., "features[0].requirements[2]" -> [["features", 0], ["requirements", 2]]
  1334→ */
  1335→function parsePath(pathStr: string): Array<[string, number]> {
  1336→  const segments: Array<[string, number]> = [];
  1337→  const regex = /(\w+)\[(\d+)\]/g;
  1338→  let match;
  1339→  while ((match = regex.exec(pathStr)) !== null) {
  1340→    segments.push([match[1], parseInt(match[2], 10)]);
  1341→  }
  1342→  return segments;
  1343→}
  1344→
  1345→/**
  1346→ * Navigate to a location in a YAML structure using a path.
  1347→ * Returns the parent object and the array containing the target item.
  1348→ */
  1349→function navigateToPath(
  1350→  root: unknown,
  1351→  pathStr: string,
  1352→): { parent: Record<string, unknown>; array: unknown[]; index: number } | null {
  1353→  if (!pathStr) return null;
  1354→
  1355→  const segments = parsePath(pathStr);
  1356→  if (segments.length === 0) return null;
  1357→
  1358→  let current: unknown = root;
  1359→
  1360→  // Navigate to the parent of the last segment
  1361→  for (let i = 0; i < segments.length - 1; i++) {
  1362→    const [field, index] = segments[i];
  1363→    if (typeof current !== "object" || current === null) return null;
  1364→    const obj = current as Record<string, unknown>;
  1365→    if (!Array.isArray(obj[field])) return null;
  1366→    current = (obj[field] as unknown[])[index];
  1367→  }
  1368→
  1369→  // Get the final array and index
  1370→  const [finalField, finalIndex] = segments[segments.length - 1];
  1371→  if (typeof current !== "object" || current === null) return null;
  1372→  const parent = current as Record<string, unknown>;
  1373→  if (!Array.isArray(parent[finalField])) return null;
  1374→
  1375→  return {
  1376→    parent,
  1377→    array: parent[finalField] as unknown[],
  1378→    index: finalIndex,
  1379→  };
  1380→}
  1381→
  1382→/**
  1383→ * Find an item by ULID in a nested YAML structure.
  1384→ * Returns the path segments to reach it.
  1385→ */
  1386→function findItemInStructure(
  1387→  root: unknown,
  1388→  ulid: string,
  1389→  currentPath: string = "",
  1390→): { path: string; item: Record<string, unknown> } | null {
  1391→  if (!root || typeof root !== "object") return null;
  1392→
  1393→  const obj = root as Record<string, unknown>;
  1394→
  1395→  // Check if this is the item we're looking for
  1396→  if (obj._ulid === ulid) {
  1397→    return { path: currentPath, item: obj };
  1398→  }
  1399→
  1400→  // Search nested item fields
  1401→  for (const field of NESTED_ITEM_FIELDS) {
  1402→    if (Array.isArray(obj[field])) {
  1403→      const arr = obj[field] as unknown[];
  1404→      for (let i = 0; i < arr.length; i++) {
  1405→        const nestedPath = currentPath
  1406→          ? `${currentPath}.${field}[${i}]`
  1407→          : `${field}[${i}]`;
  1408→        const result = findItemInStructure(arr[i], ulid, nestedPath);
  1409→        if (result) return result;
  1410→      }
  1411→    }
  1412→  }
  1413→
  1414→  return null;
  1415→}
  1416→
  1417→/**
  1418→ * Create a new spec item with auto-generated fields
  1419→ */
  1420→export function createSpecItem(input: SpecItemInput): SpecItem {
  1421→  return {
  1422→    _ulid: input._ulid || ulid(),
  1423→    slugs: input.slugs || [],
  1424→    title: input.title,
  1425→    type: input.type,
  1426→    status: input.status,
  1427→    priority: input.priority,
  1428→    tags: input.tags || [],
  1429→    description: input.description,
  1430→    acceptance_criteria: input.acceptance_criteria,
  1431→    depends_on: input.depends_on || [],
  1432→    implements: input.implements || [],
  1433→    relates_to: input.relates_to || [],
  1434→    tests: input.tests || [],
  1435→    traits: input.traits || [],
  1436→    notes: input.notes || [],
  1437→    created: input.created || new Date().toISOString(),
  1438→    created_by: input.created_by,
  1439→  };
  1440→}
  1441→
  1442→/**
  1443→ * Map from item type to the field name used to store children of that type.
  1444→ */
  1445→const TYPE_TO_CHILD_FIELD: Record<string, string> = {
  1446→  feature: "features",
  1447→  requirement: "requirements",
  1448→  constraint: "constraints",
  1449→  decision: "decisions",
  1450→  module: "modules",
  1451→  trait: "traits",
  1452→};
  1453→
  1454→/**
  1455→ * Add a spec item as a child of a parent item.
  1456→ * @param parent The parent item to add under
  1457→ * @param child The new child item to add
  1458→ * @param childField Optional field name override (defaults based on child.type)
  1459→ */
  1460→export async function addChildItem(
  1461→  _ctx: KspecContext,
  1462→  parent: LoadedSpecItem,
  1463→  child: SpecItem,
  1464→  childField?: string,
  1465→): Promise<{ item: SpecItem; path: string }> {
  1466→  if (!parent._sourceFile) {
  1467→    throw new Error("Parent item has no source file");
  1468→  }
  1469→
  1470→  const field =
  1471→    childField || TYPE_TO_CHILD_FIELD[child.type || "feature"] || "features";
  1472→
  1473→  // Lock the file to prevent concurrent read-modify-write races
  1474→  return withFileLock(parent._sourceFile, async () => {
  1475→    // Load the raw YAML
  1476→    const raw = await readYamlFile<unknown>(parent._sourceFile!);
  1477→
  1478→    // Find the parent in the structure
  1479→    let parentObj: Record<string, unknown>;
  1480→    let parentPath: string;
  1481→
  1482→    if (parent._path) {
  1483→      const nav = navigateToPath(raw, parent._path);
  1484→      if (!nav) {
  1485→        throw new Error(`Could not navigate to parent path: ${parent._path}`);
  1486→      }
  1487→      parentObj = nav.array[nav.index] as Record<string, unknown>;
  1488→      parentPath = parent._path;
  1489→    } else {
  1490→      // Parent is the root item
  1491→      parentObj = raw as Record<string, unknown>;
  1492→      parentPath = "";
  1493→    }
  1494→
  1495→    // Ensure the child field array exists
  1496→    if (!Array.isArray(parentObj[field])) {
  1497→      parentObj[field] = [];
  1498→    }
  1499→
  1500→    // Add the child
  1501→    const childArray = parentObj[field] as unknown[];
  1502→    const cleanChild = stripSpecItemMetadata(child as LoadedSpecItem);
  1503→    childArray.push(cleanChild);
  1504→
  1505→    // Calculate the new child's path
  1506→    const childIndex = childArray.length - 1;
  1507→    const childPath = parentPath
  1508→      ? `${parentPath}.${field}[${childIndex}]`
  1509→      : `${field}[${childIndex}]`;
  1510→
  1511→    // Write back with format preservation
  1512→    await writeYamlFilePreserveFormat(parent._sourceFile!, raw);
  1513→
  1514→    return { item: cleanChild, path: childPath };
  1515→  });
  1516→}
  1517→
  1518→/**
  1519→ * Update a spec item in place within its source file.
  1520→ * Works with nested structures using the _path field.
  1521→ */
  1522→export async function updateSpecItem(
  1523→  _ctx: KspecContext,
  1524→  item: LoadedSpecItem,
  1525→  updates: Partial<SpecItemInput>,
  1526→): Promise<SpecItem> {
  1527→  if (!item._sourceFile) {
  1528→    throw new Error("Item has no source file");
  1529→  }
  1530→
  1531→  // Lock the file to prevent concurrent read-modify-write races
  1532→  return withFileLock(item._sourceFile, async () => {
  1533→    // Load the raw YAML
  1534→    const raw = await readYamlFile<unknown>(item._sourceFile!);
  1535→
  1536→    // Find the item in the structure (use stored path or search by ULID)
  1537→    let targetObj: Record<string, unknown>;
  1538→
  1539→    if (item._path) {
  1540→      const nav = navigateToPath(raw, item._path);
  1541→      if (!nav) {
  1542→        throw new Error(`Could not navigate to path: ${item._path}`);
  1543→      }
  1544→      targetObj = nav.array[nav.index] as Record<string, unknown>;
  1545→    } else {
  1546→      // Item might be the root, or we need to find it
  1547→      const found = findItemInStructure(raw, item._ulid);
  1548→      if (found) {
  1549→        targetObj = found.item;
  1550→      } else if ((raw as Record<string, unknown>)._ulid === item._ulid) {
  1551→        targetObj = raw as Record<string, unknown>;
  1552→      } else {
  1553→        throw new Error(`Could not find item ${item._ulid} in structure`);
  1554→      }
  1555→    }
  1556→
  1557→    // Apply updates (but never change _ulid)
  1558→    for (const [key, value] of Object.entries(updates)) {
  1559→      if (key !== "_ulid" && key !== "_sourceFile" && key !== "_path") {
  1560→        targetObj[key] = value;
  1561→      }
  1562→    }
  1563→
  1564→    // Write back with format preservation
  1565→    await writeYamlFilePreserveFormat(item._sourceFile!, raw);
  1566→
  1567→    return { ...item, ...updates, _ulid: item._ulid } as SpecItem;
  1568→  });
  1569→}
  1570→
  1571→/**
  1572→ * Check if an item is a trait with implementors.
  1573→ * Returns array of items that use this trait via the 'traits' field.
  1574→ */
  1575→export function findTraitImplementors(
  1576→  trait: LoadedSpecItem,
  1577→  allItems: LoadedSpecItem[],
  1578→): LoadedSpecItem[] {
  1579→  // Check if the item is actually a trait
  1580→  if (trait.type !== "trait") {
  1581→    return [];
  1582→  }
  1583→
  1584→  // Find all items that reference this trait in their 'traits' array
  1585→  const traitRefs = [`@${trait._ulid}`, ...trait.slugs.map((s) => `@${s}`)];
  1586→  return allItems.filter((item) => {
  1587→    if (!item.traits || item.traits.length === 0) return false;
  1588→    return item.traits.some((traitRef: string) => traitRefs.includes(traitRef));
  1589→  });
  1590→}
  1591→
  1592→/**
  1593→ * Delete a spec item from its source file.
  1594→ * Works with nested structures using the _path field.
  1595→ */
  1596→export async function deleteSpecItem(
  1597→  _ctx: KspecContext,
  1598→  item: LoadedSpecItem,
  1599→): Promise<boolean> {
  1600→  if (!item._sourceFile) {
  1601→    return false;
  1602→  }
  1603→
  1604→  // Lock the file to prevent concurrent read-modify-write races
  1605→  return withFileLock(item._sourceFile, async () => {
  1606→    try {
  1607→      const raw = await readYamlFile<unknown>(item._sourceFile!);
  1608→
  1609→      // If item has a path, navigate to it and remove from parent array
  1610→      if (item._path) {
  1611→        const nav = navigateToPath(raw, item._path);
  1612→        if (!nav) {
  1613→          return false;
  1614→        }
  1615→        // Remove the item from the array
  1616→        nav.array.splice(nav.index, 1);
  1617→        await writeYamlFilePreserveFormat(item._sourceFile!, raw);
  1618→        return true;
  1619→      }
  1620→
  1621→      // No path - try to find it by ULID
  1622→      const found = findItemInStructure(raw, item._ulid);
  1623→      if (found?.path) {
  1624→        const nav = navigateToPath(raw, found.path);
  1625→        if (nav) {
  1626→          nav.array.splice(nav.index, 1);
  1627→          await writeYamlFilePreserveFormat(item._sourceFile!, raw);
  1628→          return true;
  1629→        }
  1630→      }
  1631→
  1632→      // Maybe it's a root-level array item
  1633→      if (Array.isArray(raw)) {
  1634→        const index = raw.findIndex(
  1635→          (i: unknown) =>
  1636→            typeof i === "object" &&
  1637→            i !== null &&
  1638→            (i as Record<string, unknown>)._ulid === item._ulid,
  1639→        );
  1640→        if (index >= 0) {
  1641→          raw.splice(index, 1);
  1642→          await writeYamlFilePreserveFormat(item._sourceFile!, raw);
  1643→          return true;
  1644→        }
  1645→      }
  1646→
  1647→      return false;
  1648→    } catch {
  1649→      return false;
  1650→    }
  1651→  });
  1652→}
  1653→
  1654→/**
  1655→ * Save a spec item - either updates existing or adds to parent.
  1656→ * For new items, use addChildItem instead.
  1657→ */
  1658→export async function saveSpecItem(
  1659→  ctx: KspecContext,
  1660→  item: LoadedSpecItem,
  1661→): Promise<void> {
  1662→  // If item has a source file and path, it's an update
  1663→  if (item._sourceFile && item._path) {
  1664→    await updateSpecItem(ctx, item, item);
  1665→    return;
  1666→  }
  1667→
  1668→  // Otherwise, this is more complex - would need a parent
  1669→  throw new Error(
  1670→    "Cannot save new item without parent. Use addChildItem instead.",
  1671→  );
  1672→}
  1673→
  1674→// ============================================================
  1675→// INBOX SYSTEM
  1676→// ============================================================
  1677→
  1678→/**
  1679→ * Inbox item with runtime metadata for source tracking.
  1680→ */
  1681→export interface LoadedInboxItem extends InboxItem {
  1682→  _sourceFile?: string;
  1683→}
  1684→
  1685→/**
  1686→ * Get the inbox file path.
  1687→ *
  1688→ * When shadow enabled: .kspec/project.inbox.yaml
  1689→ * Otherwise: spec/project.inbox.yaml
  1690→ */
  1691→export function getInboxFilePath(ctx: KspecContext): string {
  1692→  return path.join(ctx.specDir, "project.inbox.yaml");
  1693→}
  1694→
  1695→/**
  1696→ * Load all inbox items from the project.
  1697→ */
  1698→export async function loadInboxItems(
  1699→  ctx: KspecContext,
  1700→): Promise<LoadedInboxItem[]> {
  1701→  const inboxPath = getInboxFilePath(ctx);
  1702→
  1703→  try {
  1704→    const raw = await readYamlFile<unknown>(inboxPath);
  1705→
  1706→    // Handle { inbox: [...] } format
  1707→    if (raw && typeof raw === "object" && "inbox" in raw) {
  1708→      const parsed = InboxFileSchema.safeParse(raw);
  1709→      if (parsed.success) {
  1710→        return parsed.data.inbox.map((item) => ({
  1711→          ...item,
  1712→          _sourceFile: inboxPath,
  1713→        }));
  1714→      }
  1715→    }
  1716→
  1717→    // Handle plain array format
  1718→    if (Array.isArray(raw)) {
  1719→      const items: LoadedInboxItem[] = [];
  1720→      for (const item of raw) {
  1721→        const result = InboxItemSchema.safeParse(item);
  1722→        if (result.success) {
  1723→          items.push({ ...result.data, _sourceFile: inboxPath });
  1724→        }
  1725→      }
  1726→      return items;
  1727→    }
  1728→
  1729→    return [];
  1730→  } catch {
  1731→    // File doesn't exist or parse error
  1732→    return [];
  1733→  }
  1734→}
  1735→
  1736→/**
  1737→ * Create a new inbox item with auto-generated fields.
  1738→ *
  1739→ * AC: @config-author — supports config author in fallback chain
  1740→ *
  1741→ * @param input Inbox item input
  1742→ * @param configAuthor Optional author from kspec.config.yaml identity.author
  1743→ */
  1744→export function createInboxItem(
  1745→  input: InboxItemInput,
  1746→  configAuthor?: string | null,
  1747→): InboxItem {
  1748→  return {
  1749→    _ulid: input._ulid || ulid(),
  1750→    text: input.text,
  1751→    created_at: input.created_at || new Date().toISOString(),
  1752→    tags: input.tags || [],
  1753→    added_by: input.added_by ?? getAuthor(configAuthor),
  1754→  };
  1755→}
  1756→
  1757→/**
  1758→ * Strip runtime metadata before serialization.
  1759→ */
  1760→function stripInboxMetadata(item: LoadedInboxItem): InboxItem {
  1761→  const { _sourceFile, ...cleanItem } = item;
  1762→  return cleanItem as InboxItem;
  1763→}
  1764→
  1765→/**
  1766→ * Save an inbox item (add or update).
  1767→ */
  1768→export async function saveInboxItem(
  1769→  ctx: KspecContext,
  1770→  item: LoadedInboxItem,
  1771→): Promise<void> {
  1772→  const inboxPath = getInboxFilePath(ctx);
  1773→
  1774→  // Lock the file to prevent concurrent read-modify-write races
  1775→  await withFileLock(inboxPath, async () => {
  1776→    // Ensure directory exists
  1777→    const dir = path.dirname(inboxPath);
  1778→    await fs.mkdir(dir, { recursive: true });
  1779→
  1780→    // Load existing items
  1781→    let existingItems: InboxItem[] = [];
  1782→
  1783→    try {
  1784→      const raw = await readYamlFile<unknown>(inboxPath);
  1785→      if (raw && typeof raw === "object" && "inbox" in raw) {
  1786→        const parsed = InboxFileSchema.safeParse(raw);
  1787→        if (parsed.success) {
  1788→          existingItems = parsed.data.inbox;
  1789→        }
  1790→      } else if (Array.isArray(raw)) {
  1791→        for (const i of raw) {
  1792→          const result = InboxItemSchema.safeParse(i);
  1793→          if (result.success) {
  1794→            existingItems.push(result.data);
  1795→          }
  1796→        }
  1797→      }
  1798→    } catch {
  1799→      // File doesn't exist, start fresh
  1800→    }
  1801→
  1802→    const cleanItem = stripInboxMetadata(item);
  1803→
  1804→    // Update existing or add new
  1805→    const existingIndex = existingItems.findIndex(
  1806→      (i) => i._ulid === item._ulid,
  1807→    );
  1808→    if (existingIndex >= 0) {
  1809→      existingItems[existingIndex] = cleanItem;
  1810→    } else {
  1811→      existingItems.push(cleanItem);
  1812→    }
  1813→
  1814→    // Save with { inbox: [...] } format and format preservation
  1815→    await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  1816→  });
  1817→}
  1818→
  1819→/**
  1820→ * Delete an inbox item by ULID.
  1821→ */
  1822→export async function deleteInboxItem(
  1823→  ctx: KspecContext,
  1824→  ulid: string,
  1825→): Promise<boolean> {
  1826→  const inboxPath = getInboxFilePath(ctx);
  1827→
  1828→  // Lock the file to prevent concurrent read-modify-write races
  1829→  return withFileLock(inboxPath, async () => {
  1830→    try {
  1831→      const raw = await readYamlFile<unknown>(inboxPath);
  1832→      let existingItems: InboxItem[] = [];
  1833→
  1834→      if (raw && typeof raw === "object" && "inbox" in raw) {
  1835→        const parsed = InboxFileSchema.safeParse(raw);
  1836→        if (parsed.success) {
  1837→          existingItems = parsed.data.inbox;
  1838→        }
  1839→      }
  1840→
  1841→      const index = existingItems.findIndex((i) => i._ulid === ulid);
  1842→      if (index < 0) {
  1843→        return false;
  1844→      }
  1845→
  1846→      existingItems.splice(index, 1);
  1847→      await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  1848→      return true;
  1849→    } catch {
  1850→      return false;
  1851→    }
  1852→  });
  1853→}
  1854→
  1855→/**
  1856→ * Find an inbox item by reference (ULID or short ULID).
  1857→ */
  1858→export function findInboxItemByRef(
  1859→  items: LoadedInboxItem[],
  1860→  ref: string,
  1861→): LoadedInboxItem | undefined {
  1862→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1863→
  1864→  return items.find((item) => {
  1865→    // Match full ULID
  1866→    if (item._ulid === cleanRef) return true;
  1867→    // Match short ULID (prefix)
  1868→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  1869→      return true;
  1870→    return false;
  1871→  });
  1872→}
  1873→
  1874→// ============================================================
  1875→// TRIAGE SYSTEM
  1876→// ============================================================
  1877→
  1878→/**
  1879→ * Triage record with runtime metadata for source tracking.
  1880→ */
  1881→export interface LoadedTriageRecord extends TriageRecord {
  1882→  _sourceFile?: string;
  1883→}
  1884→
  1885→/**
  1886→ * Get the triage file path.
  1887→ * AC: @triage-record-schema ac-6
  1888→ *
  1889→ * When shadow enabled: .kspec/project.triage.yaml
  1890→ * Otherwise: spec/project.triage.yaml
  1891→ */
  1892→export function getTriageFilePath(ctx: KspecContext): string {
  1893→  return path.join(ctx.specDir, "project.triage.yaml");
  1894→}
  1895→
  1896→/**
  1897→ * Load all triage records from the project.
  1898→ * AC: @triage-record-schema ac-6, ac-7
  1899→ */
  1900→export async function loadTriageRecords(
  1901→  ctx: KspecContext,
  1902→): Promise<LoadedTriageRecord[]> {
  1903→  const triagePath = getTriageFilePath(ctx);
  1904→
  1905→  try {
  1906→    const raw = await readYamlFile<unknown>(triagePath);
  1907→
  1908→    // Handle { kynetic_triage: "1.0", triage: [...] } format
  1909→    if (raw && typeof raw === "object" && "triage" in raw) {
  1910→      const parsed = TriageFileSchema.safeParse(raw);
  1911→      if (parsed.success) {
  1912→        return parsed.data.triage.map((record) => ({
  1913→          ...record,
  1914→          _sourceFile: triagePath,
  1915→        }));
  1916→      }
  1917→    }
  1918→
  1919→    // Handle plain array format
  1920→    if (Array.isArray(raw)) {
  1921→      const records: LoadedTriageRecord[] = [];
  1922→      for (const item of raw) {
  1923→        const result = TriageRecordSchema.safeParse(item);
  1924→        if (result.success) {
  1925→          records.push({ ...result.data, _sourceFile: triagePath });
  1926→        }
  1927→      }
  1928→      return records;
  1929→    }
  1930→
  1931→    return [];
  1932→  } catch {
  1933→    // File doesn't exist or parse error
  1934→    return [];
  1935→  }
  1936→}
  1937→
  1938→/**
  1939→ * Strip runtime metadata before serialization.
  1940→ */
  1941→function stripTriageMetadata(record: LoadedTriageRecord): TriageRecord {
  1942→  const { _sourceFile, ...cleanRecord } = record;
  1943→  return cleanRecord as TriageRecord;
  1944→}
  1945→
  1946→/**
  1947→ * Save a triage record (add or update).
  1948→ * AC: @triage-record-schema ac-8 — upsert on inbox_ref (one record per inbox item)
  1949→ * AC: @triage-record-schema ac-9 — sets updated_at on every mutation
  1950→ */
  1951→export async function saveTriageRecord(
  1952→  ctx: KspecContext,
  1953→  record: LoadedTriageRecord,
  1954→): Promise<void> {
  1955→  const triagePath = getTriageFilePath(ctx);
  1956→
  1957→  // Lock the file to prevent concurrent read-modify-write races
  1958→  await withFileLock(triagePath, async () => {
  1959→    // Ensure directory exists
  1960→    const dir = path.dirname(triagePath);
  1961→    await fs.mkdir(dir, { recursive: true });
  1962→
  1963→    // Load existing records
  1964→    let existingRecords: TriageRecord[] = [];
  1965→
  1966→    try {
  1967→      const raw = await readYamlFile<unknown>(triagePath);
  1968→      if (raw && typeof raw === "object" && "triage" in raw) {
  1969→        const parsed = TriageFileSchema.safeParse(raw);
  1970→        if (parsed.success) {
  1971→          existingRecords = parsed.data.triage;
  1972→        }
  1973→      } else if (Array.isArray(raw)) {
  1974→        for (const item of raw) {
  1975→          const result = TriageRecordSchema.safeParse(item);
  1976→          if (result.success) {
  1977→            existingRecords.push(result.data);
  1978→          }
  1979→        }
  1980→      }
  1981→    } catch {
  1982→      // File doesn't exist, start fresh
  1983→    }
  1984→
  1985→    const cleanRecord = stripTriageMetadata(record);
  1986→
  1987→    // AC: ac-9 — set updated_at on every mutation
  1988→    cleanRecord.updated_at = new Date().toISOString();
  1989→
  1990→    // AC: ac-8 — upsert: check for existing record by ULID first, then by inbox_ref
  1991→    const existingByUlid = existingRecords.findIndex(
  1992→      (r) => r._ulid === record._ulid,
  1993→    );
  1994→    if (existingByUlid >= 0) {
  1995→      existingRecords[existingByUlid] = cleanRecord;
  1996→    } else {
  1997→      // Check for existing record with same inbox_ref (uniqueness constraint)
  1998→      // Preserve existing identity (_ulid, created_at) when upserting by inbox_ref
  1999→      const existingByInboxRef = existingRecords.findIndex(
  2000→        (r) => r.inbox_ref === record.inbox_ref,
  2001→      );
  2002→      if (existingByInboxRef >= 0) {
  2003→        const existing = existingRecords[existingByInboxRef];
  2004→        existingRecords[existingByInboxRef] = {
  2005→          ...cleanRecord,
  2006→          _ulid: existing._ulid,
  2007→          created_at: existing.created_at,
  2008→        };
  2009→      } else {
  2010→        existingRecords.push(cleanRecord);
  2011→      }
  2012→    }
  2013→
  2014→    // Save with { kynetic_triage: "1.0", triage: [...] } format
  2015→    await writeYamlFilePreserveFormat(triagePath, {
  2016→      kynetic_triage: "1.0",
  2017→      triage: existingRecords,
  2018→    });
  2019→  });
  2020→}
  2021→
  2022→/**
  2023→ * Find a triage record by reference (ULID or short ULID).
  2024→ */
  2025→export function findTriageRecordByRef(
  2026→  records: LoadedTriageRecord[],
  2027→  ref: string,
  2028→): LoadedTriageRecord | undefined {
  2029→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  2030→
  2031→  return records.find((record) => {
  2032→    // Match full ULID
  2033→    if (record._ulid === cleanRef) return true;
  2034→    // Match short ULID (prefix)
  2035→    if (record._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  2036→      return true;
  2037→    return false;
  2038→  });
  2039→}
  2040→
  2041→/**
  2042→ * Find a triage record by inbox item reference.
  2043→ * AC: @triage-record-schema ac-8 — lookup by inbox_ref for upsert
  2044→ */
  2045→export function findTriageRecordByInboxRef(
  2046→  records: LoadedTriageRecord[],
  2047→  inboxRef: string,
  2048→): LoadedTriageRecord | undefined {
  2049→  const cleanRef = inboxRef.startsWith("@") ? inboxRef.slice(1) : inboxRef;
  2050→
  2051→  return records.find((record) => record.inbox_ref === cleanRef);
  2052→}
  2053→
  2054→// ─── Patch Operations ────────────────────────────────────────────────────────
  2055→
  2056→/**
  2057→ * A single patch operation for bulk patching
  2058→ */
  2059→export interface PatchOperation {
  2060→  ref: string;
  2061→  data: Record<string, unknown>;
  2062→}
  2063→
  2064→/**
  2065→ * Result of a single patch operation
  2066→ */
  2067→export interface PatchResult {
  2068→  ref: string;
  2069→  status: "updated" | "skipped" | "error";
  2070→  ulid?: string;
  2071→  error?: string;
  2072→}
  2073→
  2074→/**
  2075→ * Result of a bulk patch operation
  2076→ */
  2077→export interface BulkPatchResult {
  2078→  results: PatchResult[];
  2079→  summary: {
  2080→    total: number;
  2081→    updated: number;
  2082→    failed: number;
  2083→    skipped: number;
  2084→  };
  2085→}
  2086→
  2087→/**
  2088→ * Options for patch operations
  2089→ */
  2090→export interface PatchOptions {
  2091→  allowUnknown?: boolean;
  2092→  dryRun?: boolean;
  2093→  failFast?: boolean;
  2094→}
  2095→
  2096→/**
  2097→ * Bulk patch spec items.
  2098→ * Resolves refs, validates data, applies patches.
  2099→ * Continues on error by default (use failFast to stop on first error).
  2100→ */
  2101→export async function patchSpecItems(
  2102→  ctx: KspecContext,
  2103→  refIndex: ReferenceIndex,
  2104→  items: LoadedSpecItem[],
  2105→  patches: PatchOperation[],
  2106→  options: PatchOptions = {},
  2107→): Promise<BulkPatchResult> {
  2108→  const results: PatchResult[] = [];
  2109→  let stopProcessing = false;
  2110→
  2111→  for (const patch of patches) {
  2112→    if (stopProcessing) {
  2113→      results.push({ ref: patch.ref, status: "skipped" });
  2114→      continue;
  2115→    }
  2116→
  2117→    // Resolve ref
  2118→    const resolved = refIndex.resolve(patch.ref);
  2119→    if (!resolved.ok) {
  2120→      const errorMsg =
  2121→        resolved.error === "not_found"
  2122→          ? `Item not found: ${patch.ref}`
  2123→          : resolved.error === "ambiguous"
  2124→            ? `Ambiguous ref: ${patch.ref}`
  2125→            : `Duplicate slug: ${patch.ref}`;
  2126→      results.push({ ref: patch.ref, status: "error", error: errorMsg });
  2127→      if (options.failFast) {
  2128→        stopProcessing = true;
  2129→      }
  2130→      continue;
  2131→    }
  2132→
  2133→    // Find the item
  2134→    const item = items.find((i) => i._ulid === resolved.ulid);
  2135→    if (!item) {
  2136→      // Ref resolved but it's not a spec item (might be a task)
  2137→      results.push({
  2138→        ref: patch.ref,
  2139→        status: "error",
  2140→        error: "Not a spec item",
  2141→      });
  2142→      if (options.failFast) {
  2143→        stopProcessing = true;
  2144→      }
  2145→      continue;
  2146→    }
  2147→
  2148→    // Dry run - just record what would happen
  2149→    if (options.dryRun) {
  2150→      results.push({ ref: patch.ref, status: "updated", ulid: item._ulid });
  2151→      continue;
  2152→    }
  2153→
  2154→    // Apply the patch
  2155→    try {
  2156→      await updateSpecItem(ctx, item, patch.data);
  2157→      results.push({ ref: patch.ref, status: "updated", ulid: item._ulid });
  2158→    } catch (err) {
  2159→      const errorMsg = err instanceof Error ? err.message : String(err);
  2160→      results.push({ ref: patch.ref, status: "error", error: errorMsg });
  2161→      if (options.failFast) {
  2162→        stopProcessing = true;
  2163→      }
  2164→    }
  2165→  }
  2166→
  2167→  return {
  2168→    results,
  2169→    summary: {
  2170→      total: patches.length,
  2171→      updated: results.filter((r) => r.status === "updated").length,
  2172→      failed: results.filter((r) => r.status === "error").length,
  2173→      skipped: results.filter((r) => r.status === "skipped").length,
  2174→    },
  2175→  };
  2176→}
  2177→
```