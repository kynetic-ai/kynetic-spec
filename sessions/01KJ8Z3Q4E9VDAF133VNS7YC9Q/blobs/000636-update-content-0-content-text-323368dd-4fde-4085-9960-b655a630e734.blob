    43→/**
    44→ * Log a debug message (only when KSPEC_DEBUG=1)
    45→ */
    46→function debugLog(prefix: string, message: string): void {
    47→  if (process.env.KSPEC_DEBUG === "1") {
    48→    console.error(`[DEBUG] ${prefix}: ${message}`);
    49→  }
    50→}
    51→
    52→/**
    53→ * Parse a manifest and emit deprecation warnings for deprecated fields.
    54→ *
    55→ * AC: @config-manifest-cleanup ac-4 — debug-level deprecation note for daemon block
    56→ */
    57→function parseManifestWithWarnings(rawManifest: unknown): Manifest {
    58→  const manifest = ManifestSchema.parse(rawManifest);
    59→
    60→  // AC: @config-manifest-cleanup ac-4 — log debug-level deprecation note for daemon block
    61→  if (manifest.daemon) {
    62→    debugLog(
    63→      "manifest",
    64→      'Deprecated "daemon" block found in manifest. Use kspec.config.yaml instead.',
    65→    );
    66→  }
    67→
    68→  // Also warn for deprecated config block
    69→  if (manifest.config) {
    70→    debugLog(
    71→      "manifest",
    72→      'Deprecated "config" block found in manifest. Use kspec.config.yaml instead.',
    73→    );
    74→  }
    75→
    76→  return manifest;
    77→}
    78→
    79→/**
    80→ * Spec item with runtime metadata for source tracking.
    81→ * _sourceFile is not serialized - it's used to know where to write updates.
    82→ * _path tracks location within the file for nested items (e.g., "features[0].requirements[2]")
    83→ */
    84→export interface LoadedSpecItem extends SpecItem {
    85→  _sourceFile?: string;
    86→  _path?: string;
    87→}
    88→
    89→/**
    90→ * Task with runtime metadata for source tracking.
