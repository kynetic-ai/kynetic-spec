    77→// ─── Types ───────────────────────────────────────────────────────────────────
    78→
    79→export interface CheckpointResult {
    80→  /** Whether session can end cleanly */
    81→  ok: boolean;
    82→
    83→  /** Human-readable message for Claude Code */
    84→  message: string;
    85→
    86→  /** Issues that need attention before stopping */
    87→  issues: CheckpointIssue[];
    88→
    89→  /** Instructions for the agent */
    90→  instructions: string[];
    91→}
    92→
    93→export interface CheckpointIssue {
    94→  type: "uncommitted_changes" | "in_progress_task" | "incomplete_todo";
    95→  description: string;
    96→  details?: Record<string, unknown>;
    97→}
    98→
    99→export interface SessionContext {
   100→  /** When this context was generated */
   101→  generated_at: string;
   102→
   103→  /** Current git branch */
   104→  branch: string | null;
   105→
   106→  /** Session context (focus, threads, questions) */
   107→  context: StoredSessionContext | null;
   108→
   109→  /** Tasks currently in progress */
   110→  active_tasks: ActiveTaskSummary[];
   111→
   112→  /** Tasks awaiting review (code done, PR pending) */
   113→  pending_review_tasks: ActiveTaskSummary[];
   114→
   115→  /** Recent notes from active tasks */
   116→  recent_notes: NoteSummary[];
   117→
   118→  /** Incomplete todos from active tasks */
   119→  active_todos: TodoSummary[];
   120→
   121→  /** Tasks ready to be picked up */
   122→  ready_tasks: ReadyTaskSummary[];
   123→
   124→  /** Blocked tasks with blockers */
   125→  blocked_tasks: BlockedTaskSummary[];
   126→
   127→  /** Recently completed tasks */
   128→  recently_completed: CompletedTaskSummary[];
   129→
   130→  /** Recent git commits */
   131→  recent_commits: CommitSummary[];
   132→
   133→  /** Unified activity timeline (merged tasks + commits, deduplicated) */
   134→  activity_timeline: ActivityItem[];
   135→
   136→  /** Working tree status */
   137→  working_tree: GitWorkingTree | null;
   138→
   139→  /** Inbox items awaiting triage (oldest first) */
   140→  inbox_items: InboxSummary[];
   141→
   142→  /** Summary statistics */
   143→  stats: SessionStats;
   144→}
   145→
   146→export interface ActiveTaskSummary {
   147→  ref: string;
   148→  title: string;
   149→  started_at: string | null;
   150→  priority: number;
   151→  spec_ref: string | null;
   152→  note_count: number;
   153→  last_note_at: string | null;
   154→  todo_count: number;
   155→  incomplete_todos: number;
   156→}
   157→
   158→export interface NoteSummary {
   159→  task_ref: string;
   160→  task_title: string;
   161→  task_status: "in_progress" | "pending_review" | "needs_work" | "completed";
   162→  note_ulid: string;
   163→  created_at: string;
   164→  author: string | null;
   165→  content: string;
   166→}
   167→
   168→export interface TodoSummary {
   169→  task_ref: string;
   170→  task_title: string;
   171→  id: number;
   172→  text: string;
   173→  added_at: string;
   174→  added_by: string | null;
   175→}
   176→
   177→export interface ReadyTaskSummary {
   178→  ref: string;
   179→  title: string;
   180→  priority: number;
   181→  spec_ref: string | null;
   182→  tags: string[];
   183→  unlocks: number;
   184→}
   185→
   186→export interface BlockedTaskSummary {
   187→  ref: string;
   188→  title: string;
   189→  blocked_by: string[];
   190→  unmet_deps: string[];
   191→  unlocks: number;
   192→}
   193→
   194→export interface CompletedTaskSummary {
   195→  ref: string;
   196→  title: string;
   197→  completed_at: string;
   198→  closed_reason: string | null;
   199→  origin?: "manual" | "derived" | "observation_promotion";
   200→}
   201→
   202→export interface CommitSummary {
   203→  hash: string;
   204→  full_hash: string;
   205→  date: string;
   206→  message: string;
   207→  author: string;
   208→  task_refs: string[];
   209→}
   210→
   211→/**
   212→ * A single entry in the unified activity timeline.
   213→ * Merges completed tasks and git commits into a chronological view.
   214→ * Commits linked to tasks via Task: @slug trailer are deduplicated into combined entries.
   215→ */
   216→export type ActivityItem =
   217→  | { type: "task_completion"; date: string; task: CompletedTaskSummary }
   218→  | { type: "commit"; date: string; commit: CommitSummary }
   219→  | {
   220→      type: "linked_commit";
   221→      date: string;
   222→      commit: CommitSummary;
   223→      task: CompletedTaskSummary;
   224→    };
   225→
   226→export interface SessionStats {
   227→  total_tasks: number;
   228→  in_progress: number;
   229→  needs_work: number;
   230→  pending_review: number;
   231→  ready: number;
   232→  blocked: number;
   233→  completed: number;
   234→  inbox_items: number;
   235→}
   236→
   237→export interface InboxSummary {
   238→  ref: string;
   239→  text: string;
   240→  created_at: string;
   241→  tags: string[];
   242→  added_by: string | null;
   243→}
   244→
   245→export interface SessionOptions {
   246→  brief?: boolean;
   247→  full?: boolean;
   248→  since?: string;
   249→  git?: boolean;
   250→  limit?: string;
   251→  eligible?: boolean; // Only include automation-eligible tasks in ready_tasks
   252→}
   253→
   254→// ─── Data Gathering ──────────────────────────────────────────────────────────
   255→
   256→/**
   257→ * Build a reverse dependency map: for each task ULID, count how many
   258→ * pending tasks depend on it. Unresolvable refs are silently skipped.
   259→ */
   260→function computeUnlocksMap(
   261→  allTasks: LoadedTask[],
   262→  index: ReferenceIndex,
   263→): Map<string, number> {
   264→  const counts = new Map<string, number>();
   265→
   266→  for (const task of allTasks) {
   267→    // Only count pending tasks as "unlockable" downstream work per spec
   268→    if (task.status !== "pending") continue;
   269→
   270→    for (const depRef of task.depends_on) {
   271→      const result = index.resolve(depRef);
   272→      if (!result.ok) continue; // AC: unresolvable refs silently skipped
   273→      const depUlid = result.item._ulid;
   274→      counts.set(depUlid, (counts.get(depUlid) || 0) + 1);
   275→    }
   276→  }
   277→
   278→  return counts;
   279→}
   280→
   281→function toActiveTaskSummary(
   282→  task: LoadedTask,
   283→  index: ReferenceIndex,
   284→): ActiveTaskSummary {
   285→  const lastNote =
   286→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   287→  const incompleteTodos = task.todos.filter((t) => !t.done).length;
   288→  return {
   289→    ref: index.shortUlid(task._ulid),
   290→    title: task.title,
   291→    started_at: task.started_at || null,
   292→    priority: task.priority,
   293→    spec_ref: task.spec_ref || null,
   294→    note_count: task.notes.length,
   295→    last_note_at: lastNote ? lastNote.created_at : null,
   296→    todo_count: task.todos.length,
   297→    incomplete_todos: incompleteTodos,
   298→  };
   299→}
   300→
   301→function toReadyTaskSummary(
   302→  task: LoadedTask,
   303→  index: ReferenceIndex,
   304→  unlocksMap: Map<string, number>,
   305→): ReadyTaskSummary {
   306→  return {
   307→    ref: index.shortUlid(task._ulid),
   308→    title: task.title,
   309→    priority: task.priority,
   310→    spec_ref: task.spec_ref || null,
   311→    tags: task.tags,
   312→    unlocks: unlocksMap.get(task._ulid) || 0,
   313→  };
   314→}
   315→
   316→function toBlockedTaskSummary(
   317→  task: LoadedTask,
   318→  _allTasks: LoadedTask[],
   319→  index: ReferenceIndex,
   320→  unlocksMap: Map<string, number>,
   321→): BlockedTaskSummary {
   322→  // Find unmet dependencies
   323→  const unmetDeps: string[] = [];
   324→  for (const depRef of task.depends_on) {
   325→    const result = index.resolve(depRef);
   326→    if (result.ok) {
   327→      const depItem = result.item;
   328→      if ("status" in depItem && depItem.status !== "completed") {
   329→        unmetDeps.push(depRef);
   330→      }
   331→    }
   332→  }
   333→
   334→  return {
   335→    ref: index.shortUlid(task._ulid),
   336→    title: task.title,
   337→    blocked_by: task.blocked_by,
   338→    unmet_deps: unmetDeps,
   339→    unlocks: unlocksMap.get(task._ulid) || 0,
   340→  };
   341→}
   342→
   343→function toCompletedTaskSummary(
   344→  task: LoadedTask,
   345→  index: ReferenceIndex,
   346→): CompletedTaskSummary {
   347→  return {
   348→    ref: index.shortUlid(task._ulid),
   349→    title: task.title,
   350→    completed_at: task.completed_at || "",
   351→    closed_reason: task.closed_reason || null,
   352→    origin: task.origin,
   353→  };
   354→}
   355→
   356→function collectRecentNotes(
   357→  tasks: LoadedTask[],
   358→  index: ReferenceIndex,
   359→  options: { limit: number; since: Date | null },
   360→): NoteSummary[] {
   361→  const allNotes: NoteSummary[] = [];
   362→
   363→  for (const task of tasks) {
   364→    // Only include notes from in_progress, pending_review, or completed tasks
   365→    const taskStatus = task.status as "in_progress" | "pending_review" | "needs_work" | "completed";
   366→    if (!["in_progress", "pending_review", "needs_work", "completed"].includes(taskStatus)) {
   367→      continue;
   368→    }
   369→
   370→    for (const note of task.notes) {
   371→      const noteDate = new Date(note.created_at);
   372→
   373→      // Filter by since date if provided
   374→      if (options.since && noteDate < options.since) {
   375→        continue;
   376→      }
   377→
   378→      // Filter out superseded notes
   379→      if (isNoteSuperseded(note, task.notes)) {
   380→        continue;
   381→      }
   382→
   383→      allNotes.push({
   384→        task_ref: index.shortUlid(task._ulid),
   385→        task_title: task.title,
   386→        task_status: taskStatus,
   387→        note_ulid: note._ulid.slice(0, 8),
   388→        created_at: note.created_at,
   389→        author: note.author || null,
   390→        content: note.content,
   391→      });
   392→    }
   393→  }
   394→
   395→  // Sort by date descending, take limit
   396→  return allNotes
   397→    .sort(
   398→      (a, b) =>
   399→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   400→    )
   401→    .slice(0, options.limit);
   402→}
   403→
   404→function collectIncompleteTodos(
   405→  tasks: LoadedTask[],
   406→  index: ReferenceIndex,
   407→  options: { limit: number },
   408→): TodoSummary[] {
   409→  const allTodos: TodoSummary[] = [];
   410→
   411→  for (const task of tasks) {
   412→    for (const todo of task.todos) {
   413→      // Only include incomplete todos
   414→      if (todo.done) continue;
   415→
   416→      allTodos.push({
   417→        task_ref: index.shortUlid(task._ulid),
   418→        task_title: task.title,
   419→        id: todo.id,
   420→        text: todo.text,
   421→        added_at: todo.added_at,
   422→        added_by: todo.added_by || null,
   423→      });
   424→    }
   425→  }
   426→
   427→  // Sort by added_at descending (most recent first), take limit
   428→  return allTodos
   429→    .sort(
   430→      (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime(),
   431→    )
   432→    .slice(0, options.limit);
   433→}
   434→
   435→/**
   436→ * Build a unified activity timeline from completed tasks and git commits.
   437→ *
   438→ * - Commits with Task: @slug trailers are matched to completed tasks and shown
   439→ *   as combined "linked_commit" entries (AC: ac-activity-trailer-link, ac-activity-dedup)
   440→ * - Unlinked commits appear as standalone "commit" entries
   441→ * - Tasks not linked to any commit appear as standalone "task_completion" entries
   442→ * - All items sorted most recent first (AC: ac-activity-sort)
   443→ *
   444→ * @param completedTasks - Completed task summaries
   445→ * @param commits - Recent commit summaries (with task_refs parsed from trailers)
   446→ * @param taskRefResolver - Maps a trailer ref (slug or ULID prefix) to a completed task's ref (short ULID)
   447→ */
   448→function buildActivityTimeline(
   449→  completedTasks: CompletedTaskSummary[],
   450→  commits: CommitSummary[],
   451→  taskRefResolver: Map<string, string>,
   452→): ActivityItem[] {
   453→  const items: ActivityItem[] = [];
   454→
   455→  // Build lookup from short ULID ref to CompletedTaskSummary
   456→  const taskByRef = new Map<string, CompletedTaskSummary>();
   457→  for (const task of completedTasks) {
   458→    taskByRef.set(task.ref, task);
   459→  }
   460→
   461→  // Track which tasks have been linked to a commit (for dedup)
   462→  const linkedTaskRefs = new Set<string>();
   463→
   464→  for (const commit of commits) {
   465→    if (commit.task_refs.length > 0) {
   466→      let linkedTask: CompletedTaskSummary | undefined;
   467→      for (const trailerRef of commit.task_refs) {
   468→        // Resolve the trailer ref (slug or ULID) to the short ULID ref
   469→        const resolvedRef = taskRefResolver.get(trailerRef);
   470→        if (resolvedRef) {
   471→          linkedTask = taskByRef.get(resolvedRef);
   472→        }
   473→        // Also try direct match on short ULID ref
   474→        if (!linkedTask) {
   475→          linkedTask = taskByRef.get(trailerRef);
   476→        }
   477→        if (linkedTask) {
   478→          linkedTaskRefs.add(linkedTask.ref);
   479→          // Use the later of commit date and task completion date for sort accuracy
   480→          const commitTime = new Date(commit.date).getTime();
   481→          const taskTime = new Date(linkedTask.completed_at).getTime();
   482→          const laterDate =
   483→            taskTime > commitTime ? linkedTask.completed_at : commit.date;
   484→          items.push({
   485→            type: "linked_commit",
   486→            date: laterDate,
   487→            commit,
   488→            task: linkedTask,
   489→          });
   490→          break; // One linked entry per commit
   491→        }
   492→      }
   493→      if (!linkedTask) {
   494→        // Task ref in trailer but no matching completed task found
   495→        items.push({ type: "commit", date: commit.date, commit });
   496→      }
   497→    } else {
   498→      items.push({ type: "commit", date: commit.date, commit });
   499→    }
   500→  }
   501→
   502→  // Add task completions not already linked to a commit
   503→  for (const task of completedTasks) {
   504→    if (!linkedTaskRefs.has(task.ref)) {
   505→      items.push({
   506→        type: "task_completion",
   507→        date: task.completed_at,
   508→        task,
   509→      });
   510→    }
   511→  }
   512→
   513→  // AC: @session-start-activity-timeline ac-activity-sort
   514→  // Sort most recent first
   515→  items.sort(
   516→    (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
   517→  );
   518→
   519→  return items;
   520→}
   521→
   522→/**
   523→ * Gather session context data
   524→ */
   525→export async function gatherSessionContext(
   526→  ctx: KspecContext,
   527→  options: SessionOptions,
   528→): Promise<SessionContext> {
   529→  const limit = parseInt(options.limit || "10", 10);
   530→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   531→  const showGit = options.git !== false; // default true
   532→
   533→  // Load all data
   534→  const allTasks = await loadAllTasks(ctx);
   535→  const items = await loadAllItems(ctx);
   536→  const inboxItems = await loadInboxItems(ctx);
   537→  const index = new ReferenceIndex(allTasks, items);
   538→
   539→  // Compute stats
   540→  const stats: SessionStats = {
   541→    total_tasks: allTasks.length,
   542→    in_progress: allTasks.filter((t) => t.status === "in_progress").length,
   543→    needs_work: allTasks.filter((t) => t.status === "needs_work").length,
   544→    pending_review: allTasks.filter((t) => t.status === "pending_review")
   545→      .length,
   546→    ready: getReadyTasks(allTasks).length,
   547→    blocked: allTasks.filter((t) => t.status === "blocked").length,
   548→    completed: allTasks.filter((t) => t.status === "completed").length,
   549→    inbox_items: inboxItems.length,
   550→  };
   551→
   552→  // Get active tasks (in_progress + needs_work, optionally filtered to automation-eligible only)
   553→  // AC: @cli-ralph ac-16
   554→  const activeTasks = allTasks
   555→    .filter((t) => t.status === "in_progress" || t.status === "needs_work")
   556→    .filter((t) => !options.eligible || t.automation === "eligible")
   557→    .sort((a, b) => a.priority - b.priority)
   558→    .slice(0, options.full ? undefined : limit)
   559→    .map((t) => toActiveTaskSummary(t, index));
   560→
   561→  // Get pending review tasks
   562→  const pendingReviewTasks = allTasks
   563→    .filter((t) => t.status === "pending_review")
   564→    .sort((a, b) => a.priority - b.priority)
   565→    .slice(0, options.full ? undefined : limit)
   566→    .map((t) => toActiveTaskSummary(t, index));
   567→
   568→  // Get recent notes from active, pending_review, and recently completed tasks
   569→  // AC: @cmd-session-start ac-1, ac-2
   570→  // Collect notes per-status first to prevent one status from starving others
   571→  const noteLimitPerStatus = options.full ? limit : Math.ceil(limit / 3);
   572→
   573→  const inProgressNotes = collectRecentNotes(
   574→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   575→    index,
   576→    { limit: noteLimitPerStatus, since: sinceDate },
   577→  );
   578→
   579→  const pendingReviewNotes = collectRecentNotes(
   580→    allTasks.filter((t) => t.status === "pending_review"),
   581→    index,
   582→    { limit: noteLimitPerStatus, since: sinceDate },
   583→  );
   584→
   585→  const recentlyCompletedForNotes = allTasks
   586→    .filter((t) => t.status === "completed" && t.completed_at)
   587→    .sort((a, b) => {
   588→      const aDate = new Date(a.completed_at || 0);
   589→      const bDate = new Date(b.completed_at || 0);
   590→      return bDate.getTime() - aDate.getTime();
   591→    })
   592→    .slice(0, 5); // Last 3-5 completed tasks per AC-2
   593→
   594→  const completedNotes = collectRecentNotes(
   595→    recentlyCompletedForNotes,
   596→    index,
   597→    { limit: noteLimitPerStatus, since: sinceDate },
   598→  );
   599→
   600→  // Combine notes from all statuses, preserving representation from each
   601→  const recentNotes = [...inProgressNotes, ...pendingReviewNotes, ...completedNotes]
   602→    .sort(
   603→      (a, b) =>
   604→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   605→    );
   606→
   607→  // Get incomplete todos from active tasks
   608→  const activeTodos = collectIncompleteTodos(
   609→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   610→    index,
   611→    { limit: options.full ? limit * 2 : limit },
   612→  );
   613→
   614→  // Compute reverse dependency map for "unlocks N" annotations
   615→  const unlocksMap = computeUnlocksMap(allTasks, index);
   616→
   617→  // Get ready tasks (optionally filtered to automation-eligible only)
   618→  const readyTasks = getReadyTasks(allTasks)
   619→    .filter((t) => !options.eligible || t.automation === "eligible")
   620→    .slice(0, options.full ? undefined : limit)
   621→    .map((t) => toReadyTaskSummary(t, index, unlocksMap));
   622→
   623→  // Get blocked tasks
   624→  const blockedTasks = allTasks
   625→    .filter((t) => t.status === "blocked")
   626→    .slice(0, options.full ? undefined : limit)
   627→    .map((t) => toBlockedTaskSummary(t, allTasks, index, unlocksMap));
   628→
   629→  // Get recently completed tasks
   630→  const recentlyCompleted = allTasks
   631→    .filter((t) => {
   632→      if (t.status !== "completed" || !t.completed_at) return false;
   633→      const completedDate = new Date(t.completed_at);
   634→      if (sinceDate && completedDate < sinceDate) return false;
   635→      return true;
   636→    })
   637→    .sort((a, b) => {
   638→      // Sort by completed_at descending (most recent first)
   639→      const aDate = new Date(a.completed_at || 0);
   640→      const bDate = new Date(b.completed_at || 0);
   641→      return bDate.getTime() - aDate.getTime();
   642→    })
   643→    .slice(0, options.full ? undefined : limit)
   644→    .map((t) => toCompletedTaskSummary(t, index));
   645→
   646→  // Get git info
   647→  let branch: string | null = null;
   648→  let recentCommits: CommitSummary[] = [];
   649→  let workingTree: GitWorkingTree | null = null;
   650→
   651→  if (showGit && isGitRepo(ctx.rootDir)) {
   652→    branch = getCurrentBranch(ctx.rootDir);
   653→
   654→    const commits = getRecentCommits({
   655→      limit: options.full ? limit * 2 : limit,
   656→      since: sinceDate || undefined,
   657→      cwd: ctx.rootDir,
   658→    });
   659→
   660→    recentCommits = commits.map((c) => ({
   661→      hash: c.hash,
   662→      full_hash: c.fullHash,
   663→      date: c.date.toISOString(),
   664→      message: c.message,
   665→      author: c.author,
   666→      task_refs: c.taskRefs,
   667→    }));
   668→
   669→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   670→  }
   671→
   672→  // Get inbox items (oldest first to encourage triage)
   673→  const inboxSummaries: InboxSummary[] = inboxItems
   674→    .sort(
   675→      (a, b) =>
   676→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   677→    )
   678→    .slice(0, options.full ? undefined : limit)
   679→    .map((item) => ({
   680→      ref: item._ulid.slice(0, 8),
   681→      text: item.text,
   682→      created_at: item.created_at,
   683→      tags: item.tags,
   684→      added_by: item.added_by || null,
   685→    }));
   686→
   687→  // Load session context (focus, threads, questions)
   688→  const sessionContext = await loadSessionContext(ctx);
   689→
   690→  // Build task ref resolver for activity timeline: maps slug/ULID to short ref
   691→  // This allows commits with Task: @task-slug trailers to match completed tasks
   692→  const taskRefResolver = new Map<string, string>();
   693→  for (const task of allTasks) {
   694→    if (task.status !== "completed") continue;
   695→    const shortRef = index.shortUlid(task._ulid);
   696→    // Map each slug to the short ref
   697→    for (const slug of task.slugs) {
   698→      taskRefResolver.set(slug, shortRef);
   699→    }
   700→    // Also map the full ULID and short ULID to itself
   701→    taskRefResolver.set(task._ulid, shortRef);
   702→    taskRefResolver.set(shortRef, shortRef);
   703→  }
   704→
   705→  // Build unified activity timeline
   706→  // AC: @session-start-activity-timeline ac-activity-merge
   707→  const activityTimeline = buildActivityTimeline(
   708→    recentlyCompleted,
   709→    recentCommits,
   710→    taskRefResolver,
   711→  );
   712→
   713→  return {
   714→    generated_at: new Date().toISOString(),
   715→    branch,
   716→    context: sessionContext,
   717→    active_tasks: activeTasks,
   718→    pending_review_tasks: pendingReviewTasks,
   719→    recent_notes: recentNotes,
   720→    active_todos: activeTodos,
   721→    ready_tasks: readyTasks,
   722→    blocked_tasks: blockedTasks,
   723→    recently_completed: recentlyCompleted,
   724→    recent_commits: recentCommits,
   725→    activity_timeline: activityTimeline,
   726→    working_tree: workingTree,
   727→    inbox_items: inboxSummaries,
   728→    stats,
   729→  };
   730→}
   731→
   732→// ─── Iteration Stats ─────────────────────────────────────────────────────────
   733→
   734→/**
   735→ * Stats for tasks completed/started within a time window.
   736→ * Used by ralph to track task completions per iteration.
   737→ */
   738→export interface IterationStats {
   739→  /** Number of tasks completed since the given time */
   740→  tasks_completed: number;
   741→  /** Number of tasks started since the given time */
   742→  tasks_started: number;
   743→  /** References of completed tasks */
   744→  completed_refs: string[];
   745→}
   746→
   747→/**
   748→ * Get iteration stats - tasks completed/started since a given time.
   749→ * AC: @ralph-task-limit ac-detection
   750→ */
   751→export async function getIterationStats(
   752→  ctx: KspecContext,
   753→  since: Date,
   754→): Promise<IterationStats> {
   755→  const allTasks = await loadAllTasks(ctx);
   756→
   757→  // Count both completed and pending_review (submitted) tasks toward the limit.
   758→  // Submit means the agent's work is done — it should count the same as complete.
   759→  // AC: @ralph-task-limit ac-detection
   760→  const completedSince = allTasks.filter((t) => {
   761→    if (t.status === "completed" && t.completed_at) {
   762→      return new Date(t.completed_at) >= since;
   763→    }
   764→    if (t.status === "pending_review" && t.submitted_at) {
   765→      return new Date(t.submitted_at) >= since;
   766→    }
   767→    return false;
   768→  });
   769→
   770→  const startedSince = allTasks.filter((t) => {
   771→    if (!t.started_at) return false;
   772→    return new Date(t.started_at) >= since;
   773→  });
   774→
   775→  // Use first slug or ULID prefix as ref
   776→  const getRef = (t: LoadedTask) =>
   777→    t.slugs.length > 0 ? `@${t.slugs[0]}` : `@${t._ulid.slice(0, 8)}`;
   778→
   779→  return {
   780→    tasks_completed: completedSince.length,
   781→    tasks_started: startedSince.length,
   782→    completed_refs: completedSince.map(getRef),
   783→  };
   784→}
   785→
   786→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   787→
   788→export interface CheckpointOptions {
   789→  force?: boolean;
   790→  /** Set when stop hook is already active (retry after previous block) */
   791→  stopHookActive?: boolean;
   792→}
   793→
   794→/** Claude Code hook input for Stop hooks */
   795→export interface StopHookInput {
   796→  session_id?: string;
   797→  transcript_path?: string;
   798→  hook_event_name?: string;
   799→  stop_hook_active?: boolean;
   800→}
   801→
   802→/**
   803→ * Perform session checkpoint - check for uncommitted work before ending session.
   804→ *
   805→ * This is designed for use as a Claude Code stop hook. It checks for:
   806→ * - Uncommitted git changes (staged, unstaged, untracked)
   807→ * - Tasks in in_progress status
   808→ * - Incomplete todos on active tasks
   809→ *
   810→ * Returns a structured result indicating whether the session can end cleanly.
   811→ */
   812→export async function performCheckpoint(
   813→  ctx: KspecContext,
   814→  options: CheckpointOptions,
   815→): Promise<CheckpointResult> {
   816→  const issues: CheckpointIssue[] = [];
   817→  const instructions: string[] = [];
   818→
   819→  // Load tasks
   820→  const allTasks = await loadAllTasks(ctx);
   821→
   822→  // Check for in-progress tasks
   823→  const inProgressTasks = allTasks.filter((t) => t.status === "in_progress");
   824→  for (const task of inProgressTasks) {
   825→    const ref = task.slugs[0]
   826→      ? `@${task.slugs[0]}`
   827→      : `@${task._ulid.slice(0, 8)}`;
   828→    issues.push({
   829→      type: "in_progress_task",
   830→      description: `Task ${ref} is still in progress: ${task.title}`,
   831→      details: {
   832→        ref,
   833→        title: task.title,
   834→        started_at: task.started_at,
   835→      },
   836→    });
   837→
   838→    // Check for incomplete todos on this task
   839→    const incompleteTodos = task.todos.filter((t) => !t.done);
   840→    for (const todo of incompleteTodos) {
   841→      issues.push({
   842→        type: "incomplete_todo",
   843→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   844→        details: {
   845→          task_ref: ref,
   846→          todo_id: todo.id,
   847→          text: todo.text,
   848→        },
   849→      });
   850→    }
   851→  }
   852→
   853→  // Check for uncommitted git changes
   854→  if (isGitRepo(ctx.rootDir)) {
   855→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   856→    if (!workingTree.clean) {
   857→      const changeCount =
   858→        workingTree.staged.length +
   859→        workingTree.unstaged.length +
   860→        workingTree.untracked.length;
   861→
   862→      issues.push({
   863→        type: "uncommitted_changes",
   864→        description: `${changeCount} uncommitted changes in working tree`,
   865→        details: {
   866→          staged: workingTree.staged.length,
   867→          unstaged: workingTree.unstaged.length,
   868→          untracked: workingTree.untracked.length,
   869→        },
   870→      });
   871→    }
   872→  }
   873→
   874→  // Build instructions based on issues
   875→  if (issues.length > 0 && !options.force) {
   876→    instructions.push(
   877→      "If you've been instructed to ignore this message or are working on",
   878→    );
   879→    instructions.push(
   880→      "unrelated things to any in progress tasks then disregard this message,",
   881→    );
   882→    instructions.push("otherwise before ending this session, please:");
   883→
   884→    const hasInProgress = issues.some((i) => i.type === "in_progress_task");
   885→    const hasUncommitted = issues.some((i) => i.type === "uncommitted_changes");
   886→    const hasIncompleteTodos = issues.some((i) => i.type === "incomplete_todo");
   887→
   888→    let step = 1;
   889→
   890→    if (hasInProgress) {
   891→      instructions.push(
   892→        `${step++}. Read in-progress task notes to get full context of the current task status`,
   893→      );
   894→      instructions.push(
   895→        `${step++}. Add notes documenting current state if any context is missing from this session`,
   896→      );
   897→      instructions.push(
   898→        `${step++}. Complete the task if you've completed the objectives and no AC are left uncovered\notherwise leave it in progress for a future session`,
   899→      );
   900→    }
   901→
   902→    if (hasIncompleteTodos) {
   903→      instructions.push(
   904→        `${step++}. Complete or acknowledge incomplete todos on active tasks`,
   905→      );
   906→    }
   907→
   908→    if (hasUncommitted) {
   909→      instructions.push(
   910→        `${step++}. Commit your changes with a descriptive message`,
   911→      );
   912→
   913→      // Add WIP commit guidance if there are in-progress tasks
   914→      if (inProgressTasks.length > 0) {
   915→        const task = inProgressTasks[0];
   916→        const guidance = formatCommitGuidance(task, { wip: true });
   917→        instructions.push("");
   918→        instructions.push("Suggested WIP commit:");
   919→        instructions.push(`  ${guidance.message}`);
   920→        instructions.push("");
   921→        for (const trailer of guidance.trailers) {
   922→          instructions.push(`  ${trailer}`);
   923→        }
   924→      }
   925→    }
   926→
   927→    instructions.push("");
   928→    instructions.push("Use: kspec task @task to get current task state");
   929→    instructions.push(
   930→      'Use: kspec task note @task "Progress notes..." to document state',
   931→    );
   932→    instructions.push(
   933→      'Use: kspec task complete @task --reason "Summary" if task is done',
   934→    );
   935→  }
   936→
   937→  // Allow stop if:
   938→  // - No issues found
   939→  // - --force flag passed
   940→  // - This is a retry (stop_hook_active = true from previous block)
   941→  const isRetry = options.stopHookActive === true;
   942→  const ok = issues.length === 0 || options.force === true || isRetry;
   943→
   944→  let message: string;
   945→  if (isRetry && issues.length > 0) {
   946→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   947→  } else if (ok) {
   948→    message = "[kspec] Session checkpoint passed - ready to end session";
   949→  } else {
   950→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   951→  }
   952→
   953→  return {
   954→    ok,
   955→    message,
   956→    issues,
   957→    instructions,
   958→  };
   959→}
   960→
   961→// ─── Output Formatting ───────────────────────────────────────────────────────
   962→
   963→function formatCheckpointResult(result: CheckpointResult): void {
   964→  if (result.ok) {
   965→    console.log(chalk.green(result.message));
   966→  } else {
   967→    console.log(chalk.yellow(result.message));
   968→    console.log("");
   969→
   970→    for (const issue of result.issues) {
   971→      const icon =
   972→        issue.type === "uncommitted_changes"
   973→          ? chalk.yellow("⚠")
   974→          : issue.type === "in_progress_task"
   975→            ? chalk.blue("●")
   976→            : chalk.gray("○");
   977→      console.log(`  ${icon} ${issue.description}`);
   978→    }
   979→
   980→    if (result.instructions.length > 0) {
   981→      console.log("");
   982→      for (const instruction of result.instructions) {
   983→        console.log(chalk.gray(instruction));
   984→      }
   985→    }
   986→  }
   987→}
   988→
   989→function formatSessionContext(
   990→  ctx: SessionContext,
   991→  options: SessionOptions,
   992→): void {
   993→  const isBrief = !options.full;
   994→
   995→  // Header
   996→  console.log(`\n${sessionHeaders.title}`);
   997→  const age = formatRelativeTime(new Date(ctx.generated_at));
   998→  if (ctx.branch) {
   999→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
  1000→  } else {
  1001→    console.log(chalk.gray(`Generated: ${age}`));
  1002→  }
  1003→
  1004→  // Stats summary
  1005→  const pendingReviewNote =
  1006→    ctx.stats.pending_review > 0
  1007→      ? `${ctx.stats.pending_review} awaiting review, `
  1008→      : "";
  1009→  const inboxNote =
  1010→    ctx.stats.inbox_items > 0 ? ` | Inbox: ${ctx.stats.inbox_items}` : "";
  1011→  console.log(
  1012→    chalk.gray(
  1013→      `Tasks: ${ctx.stats.in_progress} active, ${pendingReviewNote}${ctx.stats.ready} ready, ` +
  1014→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`,
  1015→    ),
  1016→  );
  1017→
  1018→  // Session context section (focus, threads, questions)
  1019→  if (
  1020→    ctx.context &&
  1021→    (ctx.context.focus ||
  1022→      ctx.context.threads.length > 0 ||
  1023→      ctx.context.open_questions.length > 0)
  1024→  ) {
  1025→    console.log("\n--- Session Context ---");
  1026→
  1027→    if (ctx.context.focus) {
  1028→      console.log(`  ${chalk.cyan("Focus:")} ${ctx.context.focus}`);
  1029→    }
  1030→
  1031→    if (ctx.context.threads.length > 0) {
  1032→      console.log(`  ${chalk.cyan("Active Threads:")}`);
  1033→      for (const thread of ctx.context.threads) {
  1034→        console.log(`    - ${thread}`);
  1035→      }
  1036→    }
  1037→
  1038→    if (ctx.context.open_questions.length > 0) {
  1039→      console.log(`  ${chalk.cyan("Open Questions:")}`);
  1040→      for (const question of ctx.context.open_questions) {
  1041→        console.log(`    - ${question}`);
  1042→      }
  1043→    }
  1044→  }
  1045→
  1046→  // Active tasks section
  1047→  if (ctx.active_tasks.length > 0) {
  1048→    console.log(`\n${sessionHeaders.activeWork}`);
  1049→    for (const task of ctx.active_tasks) {
  1050→      const started = task.started_at
  1051→        ? chalk.gray(
  1052→            ` (started ${formatRelativeTime(new Date(task.started_at))})`,
  1053→          )
  1054→        : "";
  1055→      const priority =
  1056→        task.priority <= 2
  1057→          ? chalk.red(`P${task.priority}`)
  1058→          : chalk.gray(`P${task.priority}`);
  1059→      console.log(
  1060→        `  ${chalk.blue("[in_progress]")} ${priority} ${task.ref} ${task.title}${started}`,
  1061→      );
  1062→    }
  1063→  } else {
  1064→    console.log(`\n${sessionHeaders.noActiveWork}`);
  1065→  }
  1066→
  1067→  // Awaiting review section
  1068→  if (ctx.pending_review_tasks.length > 0) {
  1069→    console.log(`\n${sessionHeaders.awaitingReview}`);
  1070→    for (const task of ctx.pending_review_tasks) {
  1071→      const priority =
  1072→        task.priority <= 2
  1073→          ? chalk.red(`P${task.priority}`)
  1074→          : chalk.gray(`P${task.priority}`);
  1075→      console.log(
  1076→        `  ${chalk.yellow("[pending_review]")} ${priority} ${task.ref} ${task.title}`,
  1077→      );
  1078→    }
  1079→  }
  1080→
  1081→  // Recent Activity timeline (unified view of completed tasks + commits)
  1082→  // AC: @session-start-activity-timeline ac-activity-merge
  1083→  if (ctx.activity_timeline.length > 0) {
  1084→    console.log(`\n${sessionHeaders.recentActivity}`);
  1085→    const observationPromotedTasks: string[] = [];
  1086→    for (const item of ctx.activity_timeline) {
  1087→      const age = formatRelativeTime(new Date(item.date));
  1088→      if (item.type === "task_completion") {
  1089→        let reason = "";
  1090→        if (item.task.closed_reason) {
  1091→          const maxLen = isBrief ? 60 : 120;
  1092→          const truncated =
  1093→            item.task.closed_reason.length > maxLen
  1094→              ? `${item.task.closed_reason.slice(0, maxLen).trim()}...`
  1095→              : item.task.closed_reason;
  1096→          reason = chalk.gray(` - ${truncated}`);
  1097→        }
  1098→        console.log(
  1099→          `  ${chalk.green("[completed]")} ${item.task.ref} ${item.task.title} ${chalk.gray(`(${age})`)}${reason}`,
  1100→        );
  1101→        if (item.task.origin === "observation_promotion") {
  1102→          observationPromotedTasks.push(item.task.ref);
  1103→        }
  1104→      } else if (item.type === "commit") {
  1105→        console.log(
  1106→          `  ${chalk.yellow(item.commit.hash)} ${item.commit.message} ${chalk.gray(`(${age}, ${item.commit.author})`)}`,
  1107→        );
  1108→      } else if (item.type === "linked_commit") {
  1109→        // AC: @session-start-activity-timeline ac-activity-dedup, ac-activity-trailer-link
  1110→        // Combined entry: show commit with linked task info
  1111→        console.log(
  1112→          `  ${chalk.yellow(item.commit.hash)} ${item.commit.message} ${chalk.gray(`(${age}, ${item.commit.author})`)} ${chalk.green(`→ ${item.task.ref} ${item.task.title}`)}`,
  1113→        );
  1114→        if (item.task.origin === "observation_promotion") {
  1115→          observationPromotedTasks.push(item.task.ref);
  1116→        }
  1117→      }
  1118→    }
  1119→
  1120→    // Show reminder about resolving observations
  1121→    if (observationPromotedTasks.length > 0) {
  1122→      console.log(
  1123→        chalk.yellow(
  1124→          `\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(", ")}`,
  1125→        ),
  1126→      );
  1127→      console.log(
  1128→        chalk.gray(`    Run: kspec meta observations --pending-resolution`),
  1129→      );
  1130→    }
  1131→  }
  1132→
  1133→  // Recent notes section - grouped by task status
  1134→  // AC: @cmd-session-start ac-1, ac-2
  1135→  if (ctx.recent_notes.length > 0) {
  1136→    console.log(`\n${sessionHeaders.recentNotes}`);
  1137→
  1138→    // Group notes by task status
  1139→    const inProgressNotes = ctx.recent_notes.filter(
  1140→      (n) => n.task_status === "in_progress",
  1141→    );
  1142→    const pendingReviewNotes = ctx.recent_notes.filter(
  1143→      (n) => n.task_status === "pending_review",
  1144→    );
  1145→    const completedNotes = ctx.recent_notes.filter(
  1146→      (n) => n.task_status === "completed",
  1147→    );
  1148→
  1149→    // Helper to format a single note
  1150→    const formatNote = (note: NoteSummary) => {
  1151→      const age = formatRelativeTime(new Date(note.created_at));
  1152→      const author = note.author ? chalk.gray(` by ${note.author}`) : "";
  1153→      console.log(`    ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
  1154→
  1155→      // Truncate content in brief mode
  1156→      let content = note.content.trim();
  1157→      if (isBrief && content.length > 200) {
  1158→        content = `${content.slice(0, 200).trim()}...`;
  1159→      }
  1160→
  1161→      // Indent content, limit lines in brief mode
  1162→      const lines = content.split("\n");
  1163→      const maxLines = isBrief ? 3 : lines.length;
  1164→      for (const line of lines.slice(0, maxLines)) {
  1165→        console.log(`      ${chalk.white(line)}`);
  1166→      }
  1167→      if (isBrief && lines.length > maxLines) {
  1168→        console.log(
  1169→          chalk.gray(`      ... (${lines.length - maxLines} more lines)`),
  1170→        );
  1171→      }
  1172→    };
  1173→
  1174→    // AC: @cmd-session-start ac-1 - In Progress notes
  1175→    if (inProgressNotes.length > 0) {
  1176→      console.log(`  ${chalk.blue("In Progress:")}`);
  1177→      for (const note of inProgressNotes) {
  1178→        formatNote(note);
  1179→      }
  1180→    }
  1181→
  1182→    // AC: @cmd-session-start ac-1 - Pending Review notes (grouped separately)
  1183→    if (pendingReviewNotes.length > 0) {
  1184→      console.log(`  ${chalk.yellow("Pending Review:")}`);
  1185→      for (const note of pendingReviewNotes) {
  1186→        formatNote(note);
  1187→      }
  1188→    }
  1189→
  1190→    // AC: @cmd-session-start ac-2 - Recently Completed notes
  1191→    if (completedNotes.length > 0) {
  1192→      console.log(`  ${chalk.green("Recently Completed:")}`);
  1193→      for (const note of completedNotes) {
  1194→        formatNote(note);
  1195→      }
  1196→    }
  1197→  }
  1198→
  1199→  // Incomplete todos section
  1200→  if (ctx.active_todos.length > 0) {
  1201→    console.log(`\n${sessionHeaders.incompleteTodos}`);
  1202→    for (const todo of ctx.active_todos) {
  1203→      console.log(
  1204→        `  ${chalk.yellow("[ ]")} ${todo.task_ref}#${todo.id}: ${todo.text}`,
  1205→      );
  1206→    }
  1207→  }
  1208→
  1209→  // Ready tasks section
  1210→  if (ctx.ready_tasks.length > 0) {
  1211→    console.log(`\n${sessionHeaders.readyTasks}`);
  1212→    for (const task of ctx.ready_tasks) {
  1213→      const priority =
  1214→        task.priority <= 2
  1215→          ? chalk.red(`P${task.priority}`)
  1216→          : chalk.gray(`P${task.priority}`);
  1217→      const tags =
  1218→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(" #")}`) : "";
  1219→      const unlocks =
  1220→        task.unlocks > 0
  1221→          ? chalk.green(` unlocks ${task.unlocks}`)
  1222→          : "";
  1223→      console.log(`  ${priority} ${task.ref} ${task.title}${unlocks}${tags}`);
  1224→    }
  1225→  }
  1226→
  1227→  // Blocked tasks section
  1228→  if (ctx.blocked_tasks.length > 0) {
  1229→    console.log(`\n${sessionHeaders.blocked}`);
  1230→    for (const task of ctx.blocked_tasks) {
  1231→      const unlocks =
  1232→        task.unlocks > 0
  1233→          ? chalk.green(` unlocks ${task.unlocks}`)
  1234→          : "";
  1235→      console.log(`  ${chalk.red("[blocked]")} ${task.ref} ${task.title}${unlocks}`);
  1236→      if (task.blocked_by.length > 0) {
  1237→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(", ")}`));
  1238→      }
  1239→      if (task.unmet_deps.length > 0) {
  1240→        console.log(
  1241→          chalk.gray(`    Waiting on: ${task.unmet_deps.join(", ")}`),
  1242→        );
  1243→      }
  1244→    }
  1245→  }
  1246→
  1247→  // Note: Recent Commits section replaced by unified activity timeline above
  1248→
  1249→  // Inbox section (oldest first to encourage triage)
  1250→  if (ctx.inbox_items.length > 0) {
  1251→    console.log(`\n${sessionHeaders.inbox}`);
  1252→    for (const item of ctx.inbox_items) {
  1253→      const age = formatRelativeTime(new Date(item.created_at));
  1254→      const author = item.added_by ? ` by ${item.added_by}` : "";
  1255→      const tags =
  1256→        item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(", ")}]`) : "";
  1257→      // Truncate text in brief mode
  1258→      let text = item.text;
  1259→      if (isBrief && text.length > 60) {
  1260→        text = `${text.slice(0, 60).trim()}...`;
  1261→      }
  1262→      console.log(
  1263→        `  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`,
  1264→      );
  1265→      console.log(`    ${text}`);
  1266→    }
  1267→    console.log(`  ${hints.inboxPromote}`);
  1268→  }
  1269→
  1270→  // Working tree section
  1271→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1272→    console.log(`\n${sessionHeaders.workingTree}`);
  1273→
  1274→    if (ctx.working_tree.staged.length > 0) {
  1275→      console.log(chalk.green("  Staged:"));
  1276→      for (const file of ctx.working_tree.staged) {
  1277→        console.log(
  1278→          `    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`,
  1279→        );
  1280→      }
  1281→    }
  1282→
  1283→    if (ctx.working_tree.unstaged.length > 0) {
  1284→      console.log(chalk.red("  Modified:"));
  1285→      for (const file of ctx.working_tree.unstaged) {
  1286→        console.log(
  1287→          `    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`,
  1288→        );
  1289→      }
  1290→    }
  1291→
  1292→    if (ctx.working_tree.untracked.length > 0) {
  1293→      console.log(chalk.gray("  Untracked:"));
  1294→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
  1295→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
  1296→        console.log(`    ${chalk.gray("?")} ${path}`);
  1297→      }
  1298→      if (isBrief && ctx.working_tree.untracked.length > limit) {
  1299→        console.log(
  1300→          chalk.gray(
  1301→            `    ... and ${ctx.working_tree.untracked.length - limit} more`,
  1302→          ),
  1303→        );
  1304→      }
  1305→    }
  1306→  } else if (ctx.working_tree?.clean) {
  1307→    console.log(`\n${sessionHeaders.workingTreeClean}`);
  1308→  }
  1309→
  1310→  // Quick Commands section - contextual hints based on state
  1311→  const quickCommands: string[] = [];
  1312→
  1313→  if (ctx.active_tasks.length > 0) {
  1314→    const ref = ctx.active_tasks[0].ref;
  1315→    quickCommands.push(
  1316→      `kspec task note @${ref} "Progress..."  ${chalk.gray("# document work")}`,
  1317→    );
  1318→    quickCommands.push(
  1319→      `kspec task complete @${ref} --reason "..."  ${chalk.gray("# finish task")}`,
  1320→    );
  1321→  } else if (ctx.ready_tasks.length > 0) {
  1322→    const ref = ctx.ready_tasks[0].ref;
  1323→    quickCommands.push(
  1324→      `kspec task start @${ref}  ${chalk.gray("# begin work")}`,
  1325→    );
  1326→  }
  1327→
  1328→  if (ctx.inbox_items.length > 0) {
  1329→    const ref = ctx.inbox_items[0].ref;
  1330→    quickCommands.push(
  1331→      `kspec inbox promote @${ref} --title "..."  ${chalk.gray("# convert to task")}`,
  1332→    );
  1333→  }
  1334→
  1335→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1336→    quickCommands.push(
  1337→      `git add . && git commit -m "..."  ${chalk.gray("# commit changes")}`,
  1338→    );
  1339→  }
  1340→
  1341→  if (quickCommands.length > 0) {
  1342→    console.log(`\n${sessionHeaders.quickCommands}`);
  1343→    for (const hint of quickCommands) {
  1344→      console.log(`  ${hint}`);
  1345→    }
  1346→  }
  1347→
  1348→  console.log(""); // Final newline
  1349→}
  1350→
  1351→// ─── Command Registration ────────────────────────────────────────────────────
  1352→
  1353→async function sessionStartAction(options: SessionOptions): Promise<void> {
  1354→  try {
  1355→    const ctx = await initContext();
  1356→
  1357→    // AC: @shadow-sync ac-2 - Pull remote changes before showing session context
  1358→    let syncResult: ShadowSyncResult | null = null;
  1359→    if (ctx.shadow?.enabled) {
  1360→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
  1361→      // AC: @shadow-sync ac-3 - Warn about conflicts but continue with local state
  1362→      if (syncResult.hadConflict) {
  1363→        warn("Shadow sync conflict detected. Run `kspec shadow resolve` to fix.");
  1364→        info("Continuing with local state...");
  1365→      } else if (syncResult.pulled) {
  1366→        info("Synced shadow branch from remote");
  1367→      }
  1368→    }
  1369→
  1370→    const sessionCtx = await gatherSessionContext(ctx, options);
  1371→
  1372→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
  1373→  } catch (err) {
  1374→    error(errors.failures.gatherSessionContext, err);
  1375→    process.exit(EXIT_CODES.ERROR);
  1376→  }
  1377→}
  1378→
  1379→/**
  1380→ * Read stdin if available (non-blocking check for hook input)
  1381→ */
  1382→async function readStdinIfAvailable(): Promise<string | null> {
  1383→  // Check if stdin is a TTY (interactive) - if so, don't try to read
  1384→  if (process.stdin.isTTY) {
  1385→    return null;
  1386→  }
  1387→
  1388→  return new Promise((resolve) => {
  1389→    let data = "";
  1390→    const timeout = setTimeout(() => {
  1391→      process.stdin.removeAllListeners();
  1392→      resolve(data || null);
  1393→    }, 100); // 100ms timeout for stdin
  1394→
  1395→    process.stdin.setEncoding("utf8");
  1396→    process.stdin.on("data", (chunk) => {
  1397→      data += chunk;
  1398→    });
  1399→    process.stdin.on("end", () => {
  1400→      clearTimeout(timeout);
  1401→      resolve(data || null);
  1402→    });
  1403→    process.stdin.on("error", () => {
  1404→      clearTimeout(timeout);
  1405→      resolve(null);
  1406→    });
  1407→    process.stdin.resume();
  1408→  });
  1409→}
  1410→
  1411→/**
  1412→ * Parse Claude Code hook input from stdin
  1413→ */
  1414→function parseHookInput(stdin: string | null): StopHookInput | null {
  1415→  if (!stdin) return null;
  1416→  try {
  1417→    return JSON.parse(stdin.trim()) as StopHookInput;
  1418→  } catch {
  1419→    return null;
  1420→  }
  1421→}
  1422→
  1423→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
  1424→
  1425→/**
  1426→ * Output spec-first reminder for UserPromptSubmit hook.
  1427→ *
  1428→ * This is a simple context injection - always outputs the reminder,
  1429→ * and Claude (Opus) is smart enough to apply it when relevant.
  1430→ */
  1431→async function sessionPromptCheckAction(): Promise<void> {
  1432→  // Lean, instructive reminder with kspec prefix
  1433→  console.log(sessionPrompt.specCheck);
  1434→}
  1435→
  1436→async function sessionCheckpointAction(
  1437→  options: CheckpointOptions,
  1438→): Promise<void> {
  1439→  try {
  1440→    // Read stdin for Claude Code hook input
  1441→    const stdin = await readStdinIfAvailable();
  1442→    const hookInput = parseHookInput(stdin);
  1443→
  1444→    // Check if this is a retry (stop hook already active)
  1445→    if (hookInput?.stop_hook_active) {
  1446→      options.stopHookActive = true;
  1447→    }
  1448→
  1449→    const ctx = await initContext();
  1450→    const result = await performCheckpoint(ctx, options);
  1451→
  1452→    // Output format depends on mode:
  1453→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
  1454→    // - Human mode: Output formatted checkpoint result
  1455→    if (isJsonMode()) {
  1456→      if (!result.ok) {
  1457→        // Build reason message with issues and instructions
  1458→        const issueLines = result.issues
  1459→          .map((i) => `- ${i.description}`)
  1460→          .join("\n");
  1461→        const instructionLines = result.instructions
  1462→          .filter((i) => i.trim())
  1463→          .join("\n");
  1464→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
  1465→        console.log(JSON.stringify({ decision: "block", reason }));
  1466→      }
  1467→      // If ok, exit silently (Claude Code expects no output when allowing stop)
  1468→    } else {
  1469→      formatCheckpointResult(result);
  1470→      if (!result.ok) {
  1471→        process.exit(EXIT_CODES.ERROR);
  1472→      }
  1473→    }
  1474→  } catch (err) {
  1475→    // Handle RUNNING_FROM_SHADOW gracefully - skip with warning instead of erroring
  1476→    // This happens when the stop hook runs while cwd is inside .kspec/ directory
  1477→    if (err instanceof ShadowError && err.code === "RUNNING_FROM_SHADOW") {
  1478→      if (!isJsonMode()) {
  1479→        console.log(
  1480→          chalk.yellow(
  1481→            "[kspec] Session checkpoint skipped - running from inside .kspec/ directory",
  1482→          ),
  1483→        );
  1484→      }
  1485→      // Allow stop to proceed (exit successfully, no JSON output blocks the stop)
  1486→      return;
  1487→    }
  1488→    error(errors.failures.runCheckpoint, err);
  1489→    process.exit(EXIT_CODES.ERROR);
  1490→  }
  1491→}
  1492→
  1493→// ─── Session Log List ─────────────────────────────────────────────────────────
  1494→
  1495→interface SessionLogListOptions {
  1496→  status?: string;
  1497→  agent?: string;
  1498→  since?: string;
  1499→  sort?: string;
  1500→  count?: boolean;
  1501→  limit?: string;
  1502→}
  1503→
  1504→type SortField =
  1505→  | "started_at"
  1506→  | "duration"
  1507→  | "events"
  1508→  | "iterations"
  1509→  | "tasks_completed";
  1510→
  1511→const VALID_SORT_FIELDS: SortField[] = [
  1512→  "started_at",
  1513→  "duration",
  1514→  "events",
  1515→  "iterations",
  1516→  "tasks_completed",
  1517→];
  1518→
  1519→/**
  1520→ * Format a duration in milliseconds to a human-readable string.
  1521→ */
  1522→function formatDuration(ms: number): string {
  1523→  if (ms < 0) return "—";
  1524→  const totalSec = Math.floor(ms / 1000);
  1525→  const hours = Math.floor(totalSec / 3600);
  1526→  const minutes = Math.floor((totalSec % 3600) / 60);
  1527→  if (hours > 0) {
  1528→    return `${hours}h ${minutes}m`;
  1529→  }
  1530→  if (minutes > 0) {
  1531→    return `${minutes}m`;
  1532→  }
  1533→  return `${totalSec}s`;
  1534→}
  1535→
  1536→/**
  1537→ * Sort session summaries by the specified field.
  1538→ * Default: started_at descending.
  1539→ *
  1540→ * AC: @session-log-list ac-5
  1541→ */
  1542→function sortSessions(
  1543→  sessions: SessionLogSummary[],
  1544→  sortField: SortField,
  1545→): SessionLogSummary[] {
  1546→  return [...sessions].sort((a, b) => {
  1547→    switch (sortField) {
  1548→      case "started_at":
  1549→        return (
  1550→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1551→        );
  1552→      case "duration":
  1553→        return b.duration_ms - a.duration_ms;
  1554→      case "events":
  1555→        return b.event_count - a.event_count;
  1556→      case "iterations":
  1557→        return b.iteration_count - a.iteration_count;
  1558→      case "tasks_completed":
  1559→        return b.tasks_completed - a.tasks_completed;
  1560→      default:
  1561→        return (
  1562→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1563→        );
  1564→    }
  1565→  });
  1566→}
  1567→
  1568→/**
  1569→ * Format the session log list as a table.
  1570→ *
  1571→ * AC: @session-log-list ac-1
  1572→ */
  1573→function formatSessionLogList(sessions: SessionLogSummary[]): void {
  1574→  if (sessions.length === 0) {
  1575→    // AC: @session-log-list ac-6
  1576→    console.log("No sessions found.");
  1577→    return;
  1578→  }
  1579→
  1580→  // Table header
  1581→  console.log(
  1582→    chalk.gray(
  1583→      `${"ID".padEnd(10)} ${"Status".padEnd(11)} ${"Agent".padEnd(20)} ${"Started".padEnd(16)} ${"Duration".padEnd(10)} ${"Events".padEnd(8)} ${"Iters".padEnd(7)} Tasks`,
  1584→    ),
  1585→  );
  1586→  console.log(chalk.gray("─".repeat(95)));
  1587→
  1588→  for (const s of sessions) {
  1589→    const id = s.id.slice(0, 8);
  1590→    const statusColor =
  1591→      s.status === "completed"
  1592→        ? chalk.green
  1593→        : s.status === "active"
  1594→          ? chalk.blue
  1595→          : chalk.yellow;
  1596→    const status = statusColor(s.status.padEnd(11));
  1597→    const agent = s.agent_type.slice(0, 20).padEnd(20);
  1598→    const started = formatRelativeTime(new Date(s.started_at)).padEnd(16);
  1599→    const duration = formatDuration(s.duration_ms).padEnd(10);
  1600→    const events = String(s.event_count).padEnd(8);
  1601→    const iters = String(s.iteration_count).padEnd(7);
  1602→    const tasks = String(s.tasks_completed);
  1603→
  1604→    console.log(
  1605→      `${chalk.yellow(id)} ${status} ${chalk.gray(agent)} ${chalk.gray(started)} ${duration} ${events} ${iters} ${tasks}`,
  1606→    );
  1607→  }
  1608→
  1609→  console.log(chalk.gray(`\n${sessions.length} session(s)`));
  1610→}
  1611→
  1612→/**
  1613→ * Session log list action handler.
  1614→ */
  1615→async function sessionLogListAction(
  1616→  options: SessionLogListOptions,
  1617→): Promise<void> {
  1618→  try {
  1619→    const ctx = await initContext();
  1620→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1621→
  1622→    // AC: @session-log-list ac-2 - Filter by status
  1623→    if (options.status) {
  1624→      const statusFilter = options.status as SessionStatus;
  1625→      sessions = sessions.filter((s) => s.status === statusFilter);
  1626→    }
  1627→
  1628→    // AC: @session-log-list ac-4 - Filter by agent type
  1629→    if (options.agent) {
  1630→      const agentFilter = options.agent;
  1631→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1632→    }
  1633→
  1634→    // AC: @session-log-list ac-3 - Filter by since date
  1635→    if (options.since) {
  1636→      const sinceDate = parseTimeSpec(options.since);
  1637→      if (sinceDate) {
  1638→        sessions = sessions.filter(
  1639→          (s) => new Date(s.started_at) >= sinceDate,
  1640→        );
  1641→      }
  1642→    }
  1643→
  1644→    // AC: @session-log-list ac-5 - Sort
  1645→    const sortField: SortField =
  1646→      options.sort && VALID_SORT_FIELDS.includes(options.sort as SortField)
  1647→        ? (options.sort as SortField)
  1648→        : "started_at";
  1649→    sessions = sortSessions(sessions, sortField);
  1650→
  1651→    // AC: @session-log-list ac-7 - Limit output count
  1652→    if (options.count) {
  1653→      // AC: @trait-filterable-list ac-8
  1654→      output({ count: sessions.length }, () => {
  1655→        console.log(sessions.length);
  1656→      });
  1657→      return;
  1658→    }
  1659→
  1660→    // Apply --limit (after filtering/sorting, before display)
  1661→    if (options.limit) {
  1662→      const limit = parseInt(options.limit, 10);
  1663→      if (!Number.isNaN(limit) && limit > 0) {
  1664→        sessions = sessions.slice(0, limit);
  1665→      }
  1666→    }
  1667→
  1668→    output(sessions, () => formatSessionLogList(sessions));
  1669→  } catch (err) {
  1670→    error("Failed to list session logs", err);
  1671→    process.exit(EXIT_CODES.ERROR);
  1672→  }
  1673→}
  1674→
  1675→// ─── Session Log Show ─────────────────────────────────────────────────────────
  1676→
  1677→interface SessionLogShowOptions {
  1678→  events?: boolean;
  1679→  type?: string;
  1680→  limit?: string;
  1681→  context?: string;
  1682→}
  1683→
  1684→/**
  1685→ * Format an event timestamp as relative time from session start.
  1686→ */
  1687→function formatEventTimestamp(
  1688→  eventTs: number,
  1689→  sessionStartTs: number,
  1690→): string {
  1691→  const relativeMs = eventTs - sessionStartTs;
  1692→  const totalSec = Math.floor(relativeMs / 1000);
  1693→  const minutes = Math.floor(totalSec / 60);
  1694→  const seconds = totalSec % 60;
  1695→  if (minutes > 0) {
  1696→    return `+${minutes}m${seconds}s`;
  1697→  }
  1698→  return `+${seconds}s`;
  1699→}
  1700→
  1701→/**
  1702→ * Summarize event data for display.
  1703→ * Returns a short string describing the event payload.
  1704→ */
  1705→function summarizeEventData(event: SessionEvent): string {
  1706→  const data = event.data as Record<string, unknown> | null;
  1707→  if (!data) return "";
  1708→
  1709→  // Handle tool_call events
  1710→  if (event.type === "session.update") {
  1711→    const update = data.update as {
  1712→      sessionUpdate?: string;
  1713→      rawInput?: { command?: string };
  1714→      _meta?: { claudeCode?: { toolName?: string } };
  1715→    } | null;
  1716→    if (update?.sessionUpdate === "tool_call") {
  1717→      const toolName = update._meta?.claudeCode?.toolName || "unknown";
  1718→      const command = update.rawInput?.command;
  1719→      if (command) {
  1720→        const truncated =
  1721→          command.length > 60 ? command.slice(0, 57) + "..." : command;
  1722→        return `${toolName}: ${truncated}`;
  1723→      }
  1724→      return toolName;
  1725→    }
  1726→  }
  1727→
  1728→  // Handle prompt.sent events
  1729→  if (event.type === "prompt.sent") {
  1730→    const prompt = data.prompt as string | null;
  1731→    if (prompt) {
  1732→      const truncated =
  1733→        prompt.length > 60 ? prompt.slice(0, 57) + "..." : prompt;
  1734→      return truncated;
  1735→    }
  1736→  }
  1737→
  1738→  // Handle session.start/end
  1739→  if (event.type === "session.start") {
  1740→    return "Session started";
  1741→  }
  1742→  if (event.type === "session.end") {
  1743→    const reason = data.reason as string | null;
  1744→    return reason ? `Session ended: ${reason}` : "Session ended";
  1745→  }
  1746→
  1747→  // Default: show first key
  1748→  const keys = Object.keys(data);
  1749→  if (keys.length > 0) {
  1750→    return `{${keys.slice(0, 3).join(", ")}${keys.length > 3 ? ", ..." : ""}}`;
  1751→  }
  1752→  return "";
  1753→}
  1754→
  1755→/**
  1756→ * Format the session log show output.
  1757→ *
  1758→ * AC: @session-log-show ac-1
  1759→ */
  1760→function formatSessionLogShow(
  1761→  detail: SessionLogDetail,
  1762→  events: SessionEvent[] | null,
  1763→  contextSnapshot: unknown | null,
  1764→  sessionStartTs: number,
  1765→): void {
  1766→  // AC: @session-log-show ac-1 - Session metadata
  1767→  console.log(chalk.bold(`Session ${detail.id.slice(0, 8)}`));
  1768→  console.log(chalk.gray("─".repeat(60)));
  1769→  console.log(`  ID:        ${detail.id}`);
  1770→
  1771→  const statusColor =
  1772→    detail.status === "completed"
  1773→      ? chalk.green
  1774→      : detail.status === "active"
  1775→        ? chalk.blue
  1776→        : chalk.yellow;
  1777→  console.log(`  Status:    ${statusColor(detail.status)}`);
  1778→  console.log(`  Agent:     ${detail.agent_type}`);
  1779→  if (detail.task_id) {
  1780→    console.log(`  Task:      ${detail.task_id}`);
  1781→  }
  1782→  console.log(`  Started:   ${detail.started_at}`);
  1783→  if (detail.ended_at) {
  1784→    console.log(`  Ended:     ${detail.ended_at}`);
  1785→  }
  1786→  console.log(`  Duration:  ${formatDuration(detail.duration_ms)}`);
  1787→  console.log(`  Events:    ${detail.event_count}`);
  1788→  console.log(`  Iterations: ${detail.iteration_count}`);
  1789→
  1790→  // AC: @session-log-show ac-2 - Per-iteration summary
  1791→  if (detail.iterations.length > 0) {
  1792→    console.log("\n" + chalk.bold("Iterations"));
  1793→    console.log(chalk.gray("─".repeat(60)));
  1794→    for (const iter of detail.iterations) {
  1795→      const taskInfo: string[] = [];
  1796→      if (iter.tasks_started.length > 0) {
  1797→        taskInfo.push(`started: ${iter.tasks_started.join(", ")}`);
  1798→      }
  1799→      if (iter.tasks_completed.length > 0) {
  1800→        taskInfo.push(`completed: ${iter.tasks_completed.join(", ")}`);
  1801→      }
  1802→      const taskStr = taskInfo.length > 0 ? ` | ${taskInfo.join(" | ")}` : "";
  1803→      console.log(
  1804→        `  ${chalk.cyan(`[${iter.iteration}]`)} ${iter.event_count} events${taskStr}`,
  1805→      );
  1806→    }
  1807→  }
  1808→
  1809→  // AC: @session-log-show ac-3 - Event timeline
  1810→  if (events !== null) {
  1811→    console.log("\n" + chalk.bold("Events"));
  1812→    console.log(chalk.gray("─".repeat(60)));
  1813→    if (events.length === 0) {
  1814→      console.log(chalk.gray("  No events to display."));
  1815→    } else {
  1816→      for (const event of events) {
  1817→        const timestamp = formatEventTimestamp(event.ts, sessionStartTs);
  1818→        const summary = summarizeEventData(event);
  1819→        const typeColor =
  1820→          event.type === "session.start" || event.type === "session.end"
  1821→            ? chalk.green
  1822→            : event.type === "session.update"
  1823→              ? chalk.blue
  1824→              : chalk.gray;
  1825→        console.log(
  1826→          `  ${chalk.yellow(timestamp.padEnd(10))} ${typeColor(event.type.padEnd(16))} ${chalk.gray(summary)}`,
  1827→        );
  1828→      }
  1829→    }
  1830→  }
  1831→
  1832→  // AC: @session-log-show ac-6 - Context snapshot
  1833→  if (contextSnapshot !== null) {
  1834→    console.log("\n" + chalk.bold("Context Snapshot"));
  1835→    console.log(chalk.gray("─".repeat(60)));
  1836→    console.log(JSON.stringify(contextSnapshot, null, 2));
  1837→  }
  1838→}
  1839→
  1840→/**
  1841→ * Session log show action handler.
  1842→ */
  1843→async function sessionLogShowAction(
  1844→  sessionRef: string,
  1845→  options: SessionLogShowOptions,
  1846→): Promise<void> {
  1847→  try {
  1848→    const ctx = await initContext();
  1849→
  1850→    // AC: @session-log-show ac-7, ac-8, ac-9 - Resolve session ID
  1851→    const resolution = await resolveSessionId(ctx.specDir, sessionRef);
  1852→
  1853→    if (!resolution.ok) {
  1854→      if (resolution.error === "not_found") {
  1855→        // AC: @session-log-show ac-9
  1856→        error(`Session not found: ${sessionRef}`);
  1857→        process.exit(EXIT_CODES.NOT_FOUND);
  1858→      } else {
  1859→        // AC: @session-log-show ac-8
  1860→        error(
  1861→          `Ambiguous session ID prefix. Matches:\n  ${resolution.matches.join("\n  ")}\nPlease provide a more specific prefix.`,
  1862→        );
  1863→        process.exit(EXIT_CODES.VALIDATION_FAILED);
  1864→      }
  1865→    }
  1866→
  1867→    const sessionId = resolution.id;
  1868→
  1869→    // Get session detail
  1870→    const detail = await getSessionLogDetail(ctx.specDir, sessionId);
  1871→    if (!detail) {
  1872→      error(`Session not found: ${sessionId}`);
  1873→      process.exit(EXIT_CODES.NOT_FOUND);
  1874→    }
  1875→
  1876→    // AC: @session-log-show ac-3, ac-4, ac-5 - Event timeline
  1877→    let events: SessionEvent[] | null = null;
  1878→    if (options.events) {
  1879→      let allEvents = deduplicatePhasedToolCalls(
  1880→        await readEvents(ctx.specDir, sessionId),
  1881→      );
  1882→
  1883→      // AC: @session-log-show ac-4 - Filter by type
  1884→      if (options.type) {
  1885→        const typeFilter = options.type;
  1886→        allEvents = allEvents.filter((e) => e.type === typeFilter);
  1887→      }
  1888→
  1889→      // AC: @session-log-show ac-5 - Limit to last N events
  1890→      if (options.limit) {
  1891→        const limit = parseInt(options.limit, 10);
  1892→        if (!Number.isNaN(limit) && limit > 0) {
  1893→          allEvents = allEvents.slice(-limit);
  1894→        }
  1895→      }
  1896→
  1897→      events = allEvents;
  1898→    }
  1899→
  1900→    // AC: @session-log-show ac-6 - Context snapshot
  1901→    let contextSnapshot: unknown | null = null;
  1902→    if (options.context) {
  1903→      const iterNum = parseInt(options.context, 10);
  1904→      if (!Number.isNaN(iterNum) && iterNum > 0) {
  1905→        contextSnapshot = await readSessionContext(
  1906→          ctx.specDir,
  1907→          sessionId,
  1908→          iterNum,
  1909→        );
  1910→        if (contextSnapshot === null) {
  1911→          error(`No context snapshot found for iteration ${iterNum}`);
  1912→          process.exit(EXIT_CODES.NOT_FOUND);
  1913→        }
  1914→      } else {
  1915→        error(`Invalid iteration number: ${options.context}`);
  1916→        process.exit(EXIT_CODES.USAGE_ERROR);
  1917→      }
  1918→    }
  1919→
  1920→    const sessionStartTs = new Date(detail.started_at).getTime();
  1921→
  1922→    // Build JSON output structure
  1923→    const jsonOutput = {
  1924→      ...detail,
  1925→      ...(events !== null ? { events } : {}),
  1926→      ...(contextSnapshot !== null ? { context: contextSnapshot } : {}),
  1927→    };
  1928→
  1929→    output(jsonOutput, () =>
  1930→      formatSessionLogShow(detail, events, contextSnapshot, sessionStartTs),
  1931→    );
  1932→  } catch (err) {
  1933→    error("Failed to show session log", err);
  1934→    process.exit(EXIT_CODES.ERROR);
  1935→  }
  1936→}
  1937→
  1938→// ─── Session Log Stats ─────────────────────────────────────────────────────────
  1939→
  1940→interface SessionLogStatsOptions {
  1941→  since?: string;
  1942→  agent?: string;
  1943→  toolUsage?: boolean;
  1944→  byDay?: boolean;
  1945→  byWeek?: boolean;
  1946→}
  1947→
  1948→/**
  1949→ * Full stats output including optional tool usage and time period data.
  1950→ */
  1951→interface SessionLogStatsOutput {
  1952→  stats: SessionLogStats;
  1953→  tool_usage?: ToolUsageStats[];
  1954→  time_periods?: TimePeriodStats[];
  1955→}
  1956→
  1957→/**
  1958→ * Format a duration in milliseconds to human-readable format.
  1959→ * Reuses formatDuration from session log list but handles hours/minutes/seconds.
  1960→ */
  1961→function formatDurationLong(ms: number): string {
  1962→  if (ms < 0) return "—";
  1963→  const totalSec = Math.floor(ms / 1000);
  1964→  const hours = Math.floor(totalSec / 3600);
  1965→  const minutes = Math.floor((totalSec % 3600) / 60);
  1966→  const seconds = totalSec % 60;
  1967→  if (hours > 0 && minutes > 0) {
  1968→    return `${hours}h ${minutes}m`;
  1969→  }
  1970→  if (hours > 0) {
  1971→    return `${hours}h`;
  1972→  }
  1973→  if (minutes > 0) {
  1974→    return `${minutes}m ${seconds}s`;
  1975→  }
  1976→  return `${seconds}s`;
  1977→}
  1978→
  1979→/**
  1980→ * Format the session log stats output.
  1981→ *
  1982→ * AC: @session-log-stats ac-1, ac-2, ac-3
  1983→ */
  1984→function formatSessionLogStats(
  1985→  stats: SessionLogStats,
  1986→  toolUsage: ToolUsageStats[] | null,
  1987→  timePeriods: TimePeriodStats[] | null,
  1988→  groupBy: "day" | "week" | null,
  1989→): void {
  1990→  // AC: @session-log-stats ac-1 - Totals
  1991→  console.log(chalk.bold("Session Statistics"));
  1992→  console.log(chalk.gray("─".repeat(50)));
  1993→  console.log(`  Total Sessions:     ${stats.total_sessions}`);
  1994→  console.log(`  Total Events:       ${stats.total_events}`);
  1995→  console.log(`  Total Iterations:   ${stats.total_iterations}`);
  1996→  console.log(`  Tasks Completed:    ${stats.total_tasks_completed}`);
  1997→  console.log(`  Total Duration:     ${formatDurationLong(stats.total_duration_ms)}`);
  1998→
  1999→  // AC: @session-log-stats ac-2 - Averages
  2000→  console.log("\n" + chalk.bold("Averages"));
  2001→  console.log(chalk.gray("─".repeat(50)));
  2002→  console.log(`  Avg Duration/Session:     ${formatDurationLong(stats.avg_duration_ms)}`);
  2003→  console.log(`  Avg Iterations/Session:   ${stats.avg_iterations_per_session}`);
  2004→  console.log(`  Avg Tasks/Session:        ${stats.avg_tasks_per_session}`);
  2005→
  2006→  // AC: @session-log-stats ac-3 - Status breakdown
  2007→  if (stats.status_breakdown.length > 0) {
  2008→    console.log("\n" + chalk.bold("Status Breakdown"));
  2009→    console.log(chalk.gray("─".repeat(50)));
  2010→    for (const item of stats.status_breakdown) {
  2011→      const statusColor =
  2012→        item.status === "completed"
  2013→          ? chalk.green
  2014→          : item.status === "active"
  2015→            ? chalk.blue
  2016→            : chalk.yellow;
  2017→      console.log(
  2018→        `  ${statusColor(item.status.padEnd(12))} ${String(item.count).padEnd(6)} ${item.percentage}%`,
  2019→      );
  2020→    }
  2021→  }
  2022→
  2023→  // AC: @session-log-stats ac-6 - Tool usage
  2024→  if (toolUsage !== null && toolUsage.length > 0) {
  2025→    console.log("\n" + chalk.bold("Top Tool Usage"));
  2026→    console.log(chalk.gray("─".repeat(50)));
  2027→    for (const tool of toolUsage) {
  2028→      console.log(
  2029→        `  ${tool.tool_name.padEnd(20)} ${String(tool.count).padEnd(8)} ${tool.percentage}%`,
  2030→      );
  2031→    }
  2032→  }
  2033→
  2034→  // AC: @session-log-stats ac-7 - Time periods
  2035→  if (timePeriods !== null && timePeriods.length > 0) {
  2036→    const label = groupBy === "week" ? "By Week" : "By Day";
  2037→    console.log("\n" + chalk.bold(label));
  2038→    console.log(chalk.gray("─".repeat(50)));
  2039→    console.log(
  2040→      chalk.gray(
  2041→        `  ${"Period".padEnd(14)} ${"Sessions".padEnd(10)} ${"Tasks".padEnd(8)} Duration`,
  2042→      ),
  2043→    );
  2044→    for (const period of timePeriods) {
  2045→      console.log(
  2046→        `  ${period.period.padEnd(14)} ${String(period.sessions_count).padEnd(10)} ${String(period.tasks_completed).padEnd(8)} ${formatDurationLong(period.total_duration_ms)}`,
  2047→      );
  2048→    }
  2049→  }
  2050→}
  2051→
  2052→/**
  2053→ * Session log stats action handler.
  2054→ */
  2055→async function sessionLogStatsAction(
  2056→  options: SessionLogStatsOptions,
  2057→): Promise<void> {
  2058→  try {
  2059→    const ctx = await initContext();
  2060→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  2061→
  2062→    // AC: @session-log-stats ac-4 - Filter by since
  2063→    if (options.since) {
  2064→      const sinceDate = parseTimeSpec(options.since);
  2065→      if (sinceDate) {
  2066→        sessions = sessions.filter(
  2067→          (s) => new Date(s.started_at) >= sinceDate,
  2068→        );
  2069→      }
  2070→    }
  2071→
  2072→    // AC: @session-log-stats ac-5 - Filter by agent type
  2073→    if (options.agent) {
  2074→      const agentFilter = options.agent;
  2075→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  2076→    }
  2077→
  2078→    // AC: @session-log-stats ac-8 - No sessions match criteria
  2079→    if (sessions.length === 0) {
  2080→      output({ message: "No sessions match criteria" }, () => {
  2081→        console.log("No sessions match criteria.");
  2082→      });
  2083→      return;
  2084→    }
  2085→
  2086→    // Compute base stats
  2087→    const stats = computeSessionLogStats(sessions);
  2088→
  2089→    // AC: @session-log-stats ac-6 - Tool usage (optional)
  2090→    let toolUsage: ToolUsageStats[] | null = null;
  2091→    if (options.toolUsage) {
  2092→      const sessionIds = sessions.map((s) => s.id);
  2093→      toolUsage = await computeToolUsageStats(ctx.specDir, sessionIds);
  2094→    }
  2095→
  2096→    // AC: @session-log-stats ac-7 - Time periods (optional)
  2097→    let timePeriods: TimePeriodStats[] | null = null;
  2098→    let groupBy: "day" | "week" | null = null;
  2099→    if (options.byDay) {
  2100→      groupBy = "day";
  2101→      timePeriods = computeTimePeriodStats(sessions, "day");
  2102→    } else if (options.byWeek) {
  2103→      groupBy = "week";
  2104→      timePeriods = computeTimePeriodStats(sessions, "week");
  2105→    }
  2106→
  2107→    // Build output structure
  2108→    const jsonOutput: SessionLogStatsOutput = { stats };
  2109→    if (toolUsage !== null) {
  2110→      jsonOutput.tool_usage = toolUsage;
  2111→    }
  2112→    if (timePeriods !== null) {
  2113→      jsonOutput.time_periods = timePeriods;
  2114→    }
  2115→
  2116→    output(jsonOutput, () =>
  2117→      formatSessionLogStats(stats, toolUsage, timePeriods, groupBy),
  2118→    );
  2119→  } catch (err) {
  2120→    error("Failed to compute session log stats", err);
  2121→    process.exit(EXIT_CODES.ERROR);
  2122→  }
  2123→}
  2124→
  2125→// ─── Session Log Search ─────────────────────────────────────────────────────────
  2126→
  2127→interface SessionLogSearchOptions {
  2128→  type?: string;
  2129→  since?: string;
  2130→  agent?: string;
  2131→  limit?: string;
  2132→}
  2133→
  2134→/**
  2135→ * Format relative timestamp from event timestamp (Unix ms) to session start.
  2136→ */
  2137→function formatSearchTimestamp(eventTs: number): string {
  2138→  return new Date(eventTs).toISOString();
  2139→}
  2140→
  2141→/**
  2142→ * Format the session log search output.
  2143→ *
  2144→ * AC: @session-log-search ac-1, ac-4
  2145→ */
  2146→function formatSessionLogSearch(results: SessionSearchResult[]): void {
  2147→  if (results.length === 0) {
  2148→    // AC: @session-log-search ac-6
  2149→    console.log("No matches found.");
  2150→    return;
  2151→  }
  2152→
  2153→  let totalMatches = 0;
  2154→  for (const session of results) {
  2155→    totalMatches += session.matches.length;
  2156→  }
  2157→
  2158→  console.log(chalk.bold(`Found ${totalMatches} match(es) in ${results.length} session(s)`));
  2159→  console.log(chalk.gray("─".repeat(60)));
  2160→
  2161→  for (const session of results) {
  2162→    // Session header
  2163→    console.log(
  2164→      `\n${chalk.cyan(`Session ${session.session_id.slice(0, 8)}`)} ` +
  2165→        `${chalk.gray(`(${session.agent_type}, started ${formatRelativeTime(new Date(session.started_at))})`)}`
  2166→    );
  2167→
  2168→    // AC: @session-log-search ac-4 - Show matches with session ID, timestamp, type, excerpt
  2169→    for (const match of session.matches) {
  2170→      const ts = formatSearchTimestamp(match.timestamp);
  2171→      const typeColor =
  2172→        match.event_type === "session.start" || match.event_type === "session.end"
  2173→          ? chalk.green
  2174→          : match.event_type === "session.update"
  2175→            ? chalk.blue
  2176→            : chalk.gray;
  2177→      console.log(
  2178→        `  ${chalk.yellow(ts)} ${typeColor(match.event_type.padEnd(16))}`,
  2179→      );
  2180→      // Content excerpt on next line, indented
  2181→      console.log(`    ${chalk.gray(match.content_excerpt)}`);
  2182→    }
  2183→  }
  2184→}
  2185→
  2186→/**
  2187→ * Session log search action handler.
  2188→ *
  2189→ * AC: @session-log-search ac-1 through ac-7
  2190→ */
  2191→async function sessionLogSearchAction(
  2192→  pattern: string,
  2193→  options: SessionLogSearchOptions,
  2194→): Promise<void> {
  2195→  try {
  2196→    const ctx = await initContext();
  2197→
  2198→    // Parse options - validate limit as positive integer
  2199→    let limit = 50;
  2200→    if (options.limit) {
  2201→      const parsed = parseInt(options.limit, 10);
  2202→      if (Number.isNaN(parsed) || parsed <= 0) {
  2203→        error(`Invalid limit: ${options.limit}. Must be a positive integer.`);
  2204→        process.exit(EXIT_CODES.USAGE_ERROR);
  2205→      }
  2206→      limit = parsed;
  2207→    }
  2208→    const sinceDate = options.since ? parseTimeSpec(options.since) : undefined;
  2209→
  2210→    // AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7
  2211→    const results = await searchSessionEvents(ctx.specDir, pattern, {
  2212→      eventType: options.type,
  2213→      sinceDate: sinceDate || undefined,
  2214→      agentType: options.agent,
  2215→      limit,
  2216→    });
  2217→
  2218→    // AC: @session-log-search ac-6 - No matches found message
  2219→    // exit code 0 regardless (per @trait-semantic-exit-codes ac-5)
  2220→
  2221→    output(results, () => formatSessionLogSearch(results));
  2222→  } catch (err) {
  2223→    error("Failed to search session logs", err);
  2224→    process.exit(EXIT_CODES.ERROR);
  2225→  }
  2226→}
  2227→
  2228→// ─── Session Create Action ─────────────────────────────────────────────────
  2229→
  2230→/**
  2231→ * Action handler for `kspec session create`.
  2232→ *
  2233→ * Creates a new session with optional budget and environment injection.
  2234→ *
  2235→ * AC: @session-creation-and-env-injection ac-create
  2236→ * AC: @session-creation-and-env-injection ac-budget
  2237→ * AC: @session-creation-and-env-injection ac-budget-local
  2238→ * AC: @session-creation-and-env-injection ac-inject-claude
  2239→ * AC: @session-creation-and-env-injection ac-inject-codex
  2240→ * AC: @session-creation-and-env-injection ac-inject-fallback
  2241→ *
  2242→ * Exit codes documented per @trait-semantic-exit-codes ac-8:
  2243→ * - 0: Session created successfully
  2244→ * - 1: Validation error (invalid budget value)
  2245→ * - 3: Runtime error (filesystem failure)
  2246→ */
  2247→async function sessionCreateAction(options: {
  2248→  agentType: string;
  2249→  budget?: string;
  2250→  inject?: boolean;
  2251→  taskId?: string;
  2252→}): Promise<void> {
  2253→  try {
  2254→    const ctx = await initContext();
  2255→
  2256→    // AC: @session-creation-and-env-injection ac-invalid-session
  2257→    // Validate existing KSPEC_SESSION_ID if set — warn user if it's stale/corrupt
  2258→    const existingSessionId = process.env.KSPEC_SESSION_ID;
  2259→    if (existingSessionId) {
  2260→      const validation = await validateSessionId(ctx.specDir, existingSessionId);
  2261→      if (!validation.valid) {
  2262→        warn(
  2263→          `Current KSPEC_SESSION_ID (${existingSessionId}) is invalid: ${validation.error}`,
  2264→        );
  2265→        info(validation.suggestion || "Creating a new session will generate a fresh ID.");
  2266→      }
  2267→    }
  2268→
  2269→    // Validate budget if provided
  2270→    // AC: @trait-error-guidance ac-5 - indicate which field/value failed
  2271→    let budgetNum: number | undefined;
  2272→    if (options.budget !== undefined) {
  2273→      // Use Number() instead of parseInt to reject "3.5", "3abc", "1e2" etc.
  2274→      budgetNum = Number(options.budget);
  2275→      if (isNaN(budgetNum) || budgetNum <= 0 || !Number.isInteger(budgetNum) || !/^\d+$/.test(options.budget)) {
  2276→        // AC: @trait-error-guidance ac-2, ac-5 - include suggested action and field info
  2277→        // AC: @trait-error-guidance ac-6 - guidance included in structured error
  2278→        error(
  2279→          `Invalid budget value: "${options.budget}". Must be a positive integer.`,
  2280→          { suggestion: "Usage: kspec session create --budget <positive-integer>" },
  2281→        );
  2282→        process.exit(EXIT_CODES.USAGE_ERROR);
  2283→      }
  2284→    }
  2285→
  2286→    // Generate session ID
  2287→    const sessionId = ulid();
  2288→
  2289→    // AC: @session-creation-and-env-injection ac-create, ac-budget, ac-budget-local
  2290→    const result = await createSessionWithBudget(ctx.specDir, {
  2291→      id: sessionId,
  2292→      agent_type: options.agentType,
  2293→      task_id: options.taskId,
  2294→      budget: budgetNum,
  2295→    });
  2296→
  2297→    // Handle environment injection if requested
  2298→    let injection: EnvInjectionResult | null = null;
  2299→    if (options.inject) {
  2300→      injection = await performEnvInjection(sessionId);
  2301→    }
  2302→
  2303→    // Build output data
  2304→    const outputData: Record<string, unknown> = {
  2305→      session_id: result.session_id,
  2306→      agent_type: result.session.agent_type,
  2307→      status: result.session.status,
  2308→      started_at: result.session.started_at,
  2309→    };
  2310→
  2311→    if (result.session.task_id) {
  2312→      outputData.task_id = result.session.task_id;
  2313→    }
  2314→
  2315→    if (result.budget) {
  2316→      outputData.budget = {
  2317→        max_per_cycle: result.budget.max_per_cycle,
  2318→        started_this_cycle: result.budget.started_this_cycle,
  2319→      };
  2320→    }
  2321→
  2322→    if (injection) {
  2323→      outputData.env_injection = {
  2324→        method: injection.method,
  2325→        injected: injection.injected,
  2326→        description: injection.description,
  2327→        ...(injection.path ? { path: injection.path } : {}),
  2328→      };
  2329→    }
  2330→
  2331→    // AC: @trait-json-output ac-1, ac-2, ac-5 - JSON with all data, ISO timestamps
  2332→    output(outputData, () => {
  2333→      // AC: @session-creation-and-env-injection ac-create - print session ID to stdout
  2334→      success(`Created session: ${sessionId}`, { session_id: sessionId });
  2335→      info(`Agent type: ${options.agentType}`);
  2336→
  2337→      if (result.budget) {
  2338→        info(
  2339→          `Budget: ${result.budget.max_per_cycle} tasks per cycle`,
  2340→        );
  2341→      }
  2342→
  2343→      if (injection) {
  2344→        if (injection.injected) {
  2345→          info(injection.description);
  2346→        } else {
  2347→          // AC: @session-creation-and-env-injection ac-inject-fallback
  2348→          console.log(injection.description);
  2349→        }
  2350→      }
  2351→    });
  2352→  } catch (err) {
  2353→    // AC: @trait-error-guidance ac-1 - describe what went wrong
  2354→    // AC: @trait-json-output ac-3 - error as JSON object
  2355→    error("Failed to create session", err);
  2356→    process.exit(EXIT_CODES.ERROR);
  2357→  }
  2358→}
  2359→
  2360→/**
  2361→ * Detect agent harness and perform environment injection.
  2362→ *
  2363→ * AC: @session-creation-and-env-injection ac-inject-claude
  2364→ * AC: @session-creation-and-env-injection ac-inject-codex
  2365→ * AC: @session-creation-and-env-injection ac-inject-fallback
  2366→ */
  2367→async function performEnvInjection(
  2368→  sessionId: string,
  2369→): Promise<EnvInjectionResult> {
  2370→  // Detect Claude Code
  2371→  if (
  2372→    process.env.CLAUDECODE === "1" ||
  2373→    process.env.CLAUDE_CODE_ENTRYPOINT ||
  2374→    process.env.CLAUDE_PROJECT_DIR
  2375→  ) {
  2376→    return injectClaudeCodeEnv(sessionId);
  2377→  }
  2378→
  2379→  // Detect Codex CLI
  2380→  if (process.env.CODEX_SANDBOX) {
  2381→    return injectCodexEnv(sessionId);
  2382→  }
  2383→
  2384→  // Detect Gemini CLI
  2385→  if (process.env.GEMINI_CLI === "1") {
  2386→    return injectGeminiEnv(sessionId);
  2387→  }
  2388→
  2389→  // Detect OpenCode
  2390→  if (process.env.OPENCODE_CONFIG_DIR || process.env.OPENCODE_CONFIG) {
  2391→    return injectOpenCodeEnv(sessionId);
  2392→  }
  2393→
  2394→  // Fallback for unknown harnesses
  2395→  return getFallbackInjectionInstructions(sessionId);
  2396→}
  2397→
  2398→/**
  2399→ * Register the 'session' command group and aliases
  2400→ */
  2401→export function registerSessionCommands(program: Command): void {
  2402→  const session = program
  2403→    .command("session")
  2404→    .description("Session management and context");
  2405→
  2406→  // Session create subcommand
  2407→  markMutating(session.command("create"))
  2408→    .description("Create a new kspec session with optional budget")
  2409→    .option(
  2410→      "--agent-type <type>",
  2411→      "Agent type (e.g., claude-code, codex-cli)",
  2412→      "claude-code",
  2413→    )
  2414→    .option("--budget <n>", "Maximum tasks per cycle (positive integer)")
  2415→    .option("--inject", "Inject KSPEC_SESSION_ID into agent environment")
  2416→    .option("--task-id <id>", "Optional task ID being worked on")
  2417→    .action(sessionCreateAction);
  2418→
  2419→  session
  2420→    .command("start")
  2421→    .alias("resume")
  2422→    .description("Surface relevant context for starting a new working session")
  2423→    .option("--brief", "Compact summary (default)")
  2424→    .option("--full", "Comprehensive context dump")
  2425→    .option(
  2426→      "--since <time>",
  2427→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  2428→    )
  2429→    .option("--no-git", "Skip git commit information")
  2430→    .option("-n, --limit <n>", "Limit items per section", "10")
  2431→    .action(sessionStartAction);
  2432→
  2433→  // Session log subcommand group
  2434→  const log = session
  2435→    .command("log")
  2436→    .description("Session log analysis commands");
  2437→
  2438→  log
  2439→    .command("list")
  2440→    .description("List session logs with summary statistics")
  2441→    .option(
  2442→      "-s, --status <status>",
  2443→      "Filter by status (active, completed, abandoned)",
  2444→    )
  2445→    .option("--agent <type>", "Filter by agent type")
  2446→    .option(
  2447→      "--since <time>",
  2448→      "Only show sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2449→    )
  2450→    .option(
  2451→      "--sort <field>",
  2452→      "Sort by field (started_at, duration, events, iterations, tasks_completed)",
  2453→      "started_at",
  2454→    )
  2455→    .option("--count", "Show only the count of matching sessions")
  2456→    .option("-n, --limit <n>", "Limit number of sessions shown")
  2457→    .action(sessionLogListAction);
  2458→
  2459→  log
  2460→    .command("show <session-id>")
  2461→    .description("Show detailed view of a single session")
  2462→    .option("-e, --events", "Include chronological event timeline")
  2463→    .option("-t, --type <type>", "Filter events by type (e.g., tool.call)")
  2464→    .option("-n, --limit <n>", "Show only the last N events")
  2465→    .option("-c, --context <n>", "Show context snapshot for iteration N")
  2466→    .action(sessionLogShowAction);
  2467→
  2468→  log
  2469→    .command("stats")
  2470→    .description("Aggregate analytics across sessions")
  2471→    .option(
  2472→      "--since <time>",
  2473→      "Only include sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2474→    )
  2475→    .option("--agent <type>", "Only include sessions with this agent type")
  2476→    .option("--tool-usage", "Display top 10 tool calls by frequency")
  2477→    .option("--by-day", "Group stats by day")
  2478→    .option("--by-week", "Group stats by week")
  2479→    .action(sessionLogStatsAction);
  2480→
  2481→  log
  2482→    .command("search <pattern>")
  2483→    .description("Search across session events by content")
  2484→    .option("-t, --type <type>", "Only search events of this type (e.g., session.update)")
  2485→    .option(
  2486→      "--since <time>",
  2487→      "Only search sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2488→    )
  2489→    .option("--agent <type>", "Only search sessions with this agent type")
  2490→    .option("-n, --limit <n>", "Maximum matches to return (default: 50)")
  2491→    .action(sessionLogSearchAction);
  2492→
  2493→  session
  2494→    .command("checkpoint")
  2495→    .description(
  2496→      "Pre-stop hook: check for uncommitted work before ending session",
  2497→    )
  2498→    .option("--force", "Allow session end regardless of issues")
  2499→    .action(sessionCheckpointAction);
  2500→
  2501→  session
  2502→    .command("prompt-check")
  2503→    .description("UserPromptSubmit hook: inject spec-first reminder")
  2504→    .action(sessionPromptCheckAction);
  2505→
  2506→  // Top-level alias: kspec context
  2507→  program
  2508→    .command("context")
  2509→    .description("Alias for session start - surface session context")
  2510→    .option("--brief", "Compact summary (default)")
  2511→    .option("--full", "Comprehensive context dump")
  2512→    .option(
  2513→      "--since <time>",
  2514→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  2515→    )
  2516→    .option("--no-git", "Skip git commit information")
  2517→    .option("-n, --limit <n>", "Limit items per section", "10")
  2518→    .action(sessionStartAction);
  2519→}
  2520→