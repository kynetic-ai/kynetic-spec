   382→  // AC: @session-start-activity-timeline ac-activity-orphan
   383→  // Note: visual indentation distinction tracked by @01KJ91Q8 (not yet implemented).
   384→  // These tests verify orphan commits are classified correctly and rendered distinctly from linked commits.
   385→  describe('orphan commit display (ac-activity-orphan)', () => {
   386→    it('should show orphan commits as standalone entries without task reference', () => {
   387→      // Create a commit without Task: trailer (orphan)
   388→      writeFileSync(join(tempDir, 'orphan.ts'), 'export const orphan = 1;\n');
   389→      git('add orphan.ts', tempDir);
   390→      git('commit -m "chore: standalone cleanup"', tempDir);
   391→
   392→      const result = kspec('session start', tempDir);
   393→
   394→      // Orphan commit should appear in output with its hash and message
   395→      expect(result.stdout).toContain('standalone cleanup');
   396→    });
   397→
   398→    it('should classify orphan commits as type "commit" in JSON', () => {
   399→      // Create an orphan commit
   400→      writeFileSync(join(tempDir, 'orphan2.ts'), 'export const orphan2 = 1;\n');
   401→      git('add orphan2.ts', tempDir);
   402→      git('commit -m "chore: orphan commit"', tempDir);
   403→
   404→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   405→
   406→      const orphans = session.activity_timeline.filter(
   407→        (i) => i.type === 'commit' && i.commit?.message === 'chore: orphan commit',
   408→      );
   409→      expect(orphans.length).toBe(1);
   410→      // Orphan commits have no task association
   411→      expect(orphans[0]).not.toHaveProperty('task');
   412→    });
   413→
   414→    it('should visually distinguish orphan commits from linked commits in human output', () => {
   415→      // Create a linked commit
   416→      kspec('task add --title "Linked task" --slug task-linked', tempDir);
   417→      kspec('task start @task-linked', tempDir);
   418→      kspec('task submit @task-linked', tempDir);
   419→      kspec('task complete @task-linked --reason "Done"', tempDir);
   420→
   421→      writeFileSync(join(tempDir, 'linked.ts'), 'export const linked = 1;\n');
   422→      git('add linked.ts', tempDir);
   423→      git('commit -m "feat: linked work" -m "Task: @task-linked"', tempDir);
   424→
   425→      // Create an orphan commit
   426→      writeFileSync(join(tempDir, 'orphan3.ts'), 'export const o = 1;\n');
   427→      git('add orphan3.ts', tempDir);
   428→      git('commit -m "chore: orphan work"', tempDir);
   429→
   430→      const result = kspec('session start', tempDir);
   431→
   432→      // Linked commit should show task reference with arrow
   433→      expect(result.stdout).toContain('Linked task');
   434→      // Orphan commit should appear without task reference
   435→      expect(result.stdout).toContain('orphan work');
   436→      // The linked commit has the → arrow to task; orphan does not
   437→      const lines = result.stdout.split('\n');
   438→      const linkedLine = lines.find((l) => l.includes('linked work'));
   439→      const orphanLine = lines.find((l) => l.includes('orphan work'));
   440→      expect(linkedLine).toBeDefined();
   441→      expect(orphanLine).toBeDefined();
   442→      // Linked line references the task, orphan line does not
   443→      expect(linkedLine).toContain('Linked task');
   444→      expect(orphanLine).not.toContain('Linked task');
   445→    });
   446→  });
   447→});
