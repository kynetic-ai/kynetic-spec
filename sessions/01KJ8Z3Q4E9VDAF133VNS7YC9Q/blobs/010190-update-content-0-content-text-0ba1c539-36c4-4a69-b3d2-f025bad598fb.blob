   335→  // AC: @session-start-activity-timeline ac-activity-hierarchy
   336→  // Note: visual nesting with connectors is tracked by @01KJ91Q8 (not yet implemented).
   337→  // These tests verify the current data model linking commits to tasks.
   338→  describe('hierarchical display (ac-activity-hierarchy)', () => {
   339→    it('should show linked commits associated with their task entry', () => {
   340→      // Create and complete a task
   341→      kspec('task add --title "Hierarchy task" --slug task-hier', tempDir);
   342→      kspec('task start @task-hier', tempDir);
   343→      kspec('task submit @task-hier', tempDir);
   344→      kspec('task complete @task-hier --reason "Shipped"', tempDir);
   345→
   346→      // Create a commit linked to the task
   347→      writeFileSync(join(tempDir, 'hier.ts'), 'export const h = 1;\n');
   348→      git('add hier.ts', tempDir);
   349→      git('commit -m "feat: hierarchy feature" -m "Task: @task-hier"', tempDir);
   350→
   351→      const result = kspec('session start', tempDir);
   352→
   353→      // Linked commit should display with task reference (→ arrow links them)
   354→      expect(result.stdout).toContain('hierarchy feature');
   355→      expect(result.stdout).toContain('Hierarchy task');
   356→
   357→      // In JSON, the linked_commit type carries both commit and task data
   358→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   359→      const linked = session.activity_timeline.filter(
   360→        (i) => i.type === 'linked_commit' && i.task?.title === 'Hierarchy task',
   361→      );
   362→      expect(linked.length).toBe(1);
   363→      expect(linked[0].commit!.message).toBe('feat: hierarchy feature');
   364→      expect(linked[0].task!.title).toBe('Hierarchy task');
   365→    });
   366→
   367→    it('should show task completion entries distinctly from commit entries', () => {
   368→      // Complete a task without linked commits
   369→      kspec('task add --title "Task only" --slug task-only', tempDir);
   370→      kspec('task start @task-only', tempDir);
   371→      kspec('task submit @task-only', tempDir);
   372→      kspec('task complete @task-only --reason "Done"', tempDir);
   373→
   374→      const result = kspec('session start', tempDir);
   375→
   376→      // Task completion should show [completed] badge
   377→      expect(result.stdout).toContain('[completed]');
   378→      expect(result.stdout).toContain('Task only');
   379→    });
   380→  });
