    41→
    42→/**
    43→ * Format a spec item for display
    44→ */
    45→function formatItem(
    46→  item: LoadedSpecItem,
    47→  verbose = false,
    48→  grepPattern?: string,
    49→): string {
    50→  const shortId = item._ulid.slice(0, 8);
    51→  const slugStr = item.slugs.length > 0 ? chalk.cyan(`@${item.slugs[0]}`) : "";
    52→  const typeStr = chalk.gray(`[${item.type}]`);
    53→
    54→  let status = "";
    55→  if (item.status && typeof item.status === "object") {
    56→    const s = item.status as { maturity?: string; implementation?: string };
    57→    if (s.implementation) {
    58→      const implColor =
    59→        s.implementation === "verified"
    60→          ? chalk.green
    61→          : s.implementation === "implemented"
    62→            ? chalk.cyan
    63→            : s.implementation === "in_progress"
    64→              ? chalk.yellow
    65→              : chalk.gray;
    66→      status = implColor(s.implementation);
    67→    } else if (s.maturity) {
    68→      status = chalk.gray(s.maturity);
    69→    }
    70→  }
    71→
    72→  let line = `${chalk.gray(shortId)} ${typeStr} ${item.title}`;
    73→  if (slugStr) line += ` ${slugStr}`;
    74→  if (status) line += ` ${status}`;
    75→
    76→  if (verbose) {
    77→    const tags = "tags" in item && Array.isArray(item.tags) ? item.tags : [];
    78→    if (tags.length > 0) {
    79→      line += chalk.blue(` #${tags.join(" #")}`);
    80→    }
    81→  }
    82→
    83→  // Show matched fields if grep pattern provided
    84→  if (grepPattern) {
    85→    const match = grepItem(
    86→      item as unknown as Record<string, unknown>,
    87→      grepPattern,
    88→    );
    89→    if (match && match.matchedFields.length > 0) {
    90→      line +=
    91→        "\n  " +
    92→        chalk.gray(`matched: ${formatMatchedFields(match.matchedFields)}`);
    93→    }
    94→  }
    95→
    96→  return line;
    97→}
    98→
    99→/**
   100→ * Format item list for display
   101→ */
   102→function formatItemList(
   103→  items: LoadedSpecItem[],
   104→  verbose = false,
   105→  grepPattern?: string,
   106→): void {
   107→  if (items.length === 0) {
   108→    console.log(chalk.gray("No items found"));
   109→    return;
   110→  }
   111→
   112→  for (const item of items) {
   113→    console.log(formatItem(item, verbose, grepPattern));
   114→  }
   115→
   116→  console.log(chalk.gray(`\n${items.length} item(s)`));
   117→}
   118→
   119→/**
   120→ * Format item list as a tree showing parent/child hierarchy
   121→ */
   122→function formatItemTree(
   123→  items: LoadedSpecItem[],
   124→  verbose = false,
   125→  grepPattern?: string,
   126→): void {
   127→  if (items.length === 0) {
   128→    console.log(chalk.gray("No items found"));
   129→    return;
   130→  }
   131→
   132→  // Build parent-child map
   133→  const childrenMap = new Map<string, LoadedSpecItem[]>();
   134→  const rootItems: LoadedSpecItem[] = [];
   135→
   136→  for (const item of items) {
   137→    const path = item._path || "";
   138→
   139→    // Determine parent path
   140→    let parentPath = "";
   141→    if (path) {
   142→      // Extract parent path from current path
   143→      // e.g., "features[0].requirements[1]" -> "features[0]"
   144→      const lastDotIndex = path.lastIndexOf(".");
   145→      if (lastDotIndex !== -1) {
   146→        parentPath = path.substring(0, lastDotIndex);
   147→      }
   148→    }
   149→
   150→    if (parentPath === "") {
   151→      // Root level item
   152→      rootItems.push(item);
   153→    } else {
   154→      // Find parent by path
   155→      const parent = items.find((i) => i._path === parentPath);
   156→      if (parent) {
   157→        const parentUlid = parent._ulid;
   158→        if (!childrenMap.has(parentUlid)) {
   159→          childrenMap.set(parentUlid, []);
   160→        }
   161→        childrenMap.get(parentUlid)?.push(item);
   162→      } else {
   163→        // Parent not in filtered list, show at root
   164→        rootItems.push(item);
   165→      }
   166→    }
   167→  }
   168→
   169→  // Recursive function to print tree
   170→  function printTree(item: LoadedSpecItem, prefix = "", isLast = true): void {
   171→    // Print current item with tree prefix
   172→    const connector = isLast ? "└── " : "├── ";
   173→    const itemLine = formatItem(item, verbose, grepPattern);
   174→    console.log(prefix + connector + itemLine);
   175→
   176→    // Print children
   177→    const children = childrenMap.get(item._ulid) || [];
   178→    const childPrefix = prefix + (isLast ? "    " : "│   ");
   179→
   180→    children.forEach((child, index) => {
   181→      const isLastChild = index === children.length - 1;
   182→      printTree(child, childPrefix, isLastChild);
   183→    });
   184→  }
   185→
   186→  // Print all root items
   187→  rootItems.forEach((item, index) => {
   188→    const isLast = index === rootItems.length - 1;
   189→    printTree(item, "", isLast);
   190→  });
   191→
   192→  console.log(chalk.gray(`\n${items.length} item(s)`));
   193→}
   194→
   195→/**
   196→ * Handle cascading status updates to child items
   197→ * Returns array of updated child items
   198→ */
   199→async function handleStatusCascade(
   200→  ctx: Awaited<ReturnType<typeof initContext>>,
   201→  parent: LoadedSpecItem,
   202→  newStatus: string,
   203→  allItems: LoadedSpecItem[],
   204→  refIndex: ReferenceIndex,
   205→): Promise<LoadedSpecItem[]> {
   206→  // Find direct children
   207→  const children = findChildItems(parent, allItems);
   208→
   209→  if (children.length === 0) {
   210→    return [];
   211→  }
   212→
   213→  // Skip prompt in JSON mode
   214→  if (isJsonMode()) {
   215→    return [];
   216→  }
   217→
   218→  // Prompt user for cascade
   219→  const readline = await import("node:readline");
   220→  const rl = readline.createInterface({
   221→    input: process.stdin,
   222→    output: process.stdout,
   223→  });
   224→
   225→  const answer = await new Promise<string>((resolve) => {
   226→    rl.question(
   227→      `Update ${children.length} child item(s) to ${newStatus}? [y/n] `,
   228→      resolve,
   229→    );
   230→  });
   231→  rl.close();
   232→
   233→  if (answer.toLowerCase() !== "y") {
   234→    return [];
   235→  }
   236→
   237→  // Update children
   238→  const updatedChildren: LoadedSpecItem[] = [];
   239→  for (const child of children) {
   240→    const currentStatus =
   241→      child.status && typeof child.status === "object"
   242→        ? child.status
   243→        : {
   244→            maturity: "draft" as const,
   245→            implementation: "not_started" as const,
   246→          };
   247→
   248→    const updates = {
   249→      status: {
   250→        maturity: currentStatus.maturity || ("draft" as const),
   251→        implementation: newStatus as ImplementationStatus,
   252→      },
   253→    };
   254→
   255→    const updated = await updateSpecItem(ctx, child, updates);
   256→    updatedChildren.push(updated);
   257→
   258→    // Log each child update (non-JSON mode only)
   259→    const childRef = child.slugs[0] || refIndex.shortUlid(child._ulid);
   260→    console.log(chalk.gray(`  ✓ Updated @${childRef}`));
   261→  }
   262→
   263→  return updatedChildren;
   264→}
   265→
   266→/**
   267→ * Register item commands
   268→ */
   269→export function registerItemCommands(program: Command): void {
   270→  const item = program.command("item").description("Spec item commands");
   271→
   272→  // kspec item list
   273→  item
   274→    .command("list")
   275→    .description("List spec items with optional filters")
   276→    .option(
   277→      "-t, --type <type>",
   278→      "Filter by item type (module, feature, requirement, constraint, decision)",
   279→    )
   280→    .option(
   281→      "-s, --status <status>",
   282→      "Filter by implementation status (not_started, in_progress, implemented, verified)",
   283→    )
   284→    .option(
   285→      "-m, --maturity <maturity>",
   286→      "Filter by maturity (draft, proposed, stable, deferred, deprecated)",
   287→    )
   288→    .option(
   289→      "--tag <tag>",
   290→      "Filter by tag (can specify multiple)",
   291→      (val, prev: string[]) => [...prev, val],
   292→      [],
   293→    )
   294→    .option(
   295→      "--has <field>",
   296→      "Filter items that have field present",
   297→      (val, prev: string[]) => [...prev, val],
   298→      [],
   299→    )
   300→    .option("-q, --search <text>", "Search in title")
   301→    .option("-g, --grep <pattern>", "Search content with regex pattern")
   302→    .option("-v, --verbose", "Show more details")
   303→    .option("--tree", "Show parent/child hierarchy")
   304→    .option("--under <ref>", "Scope to descendants of a module or parent item")
   305→    .option("--limit <n>", "Limit results", "50")
   306→    .option("--count", "Show only the count of matching items")
   307→    .action(async (options) => {
   308→      try {
   309→        const ctx = await initContext();
   310→        const { itemIndex, items, refIndex } = await buildIndexes(ctx);
   311→
   312→        // Build filter from options
   313→        const filter: ItemFilter = {
   314→          specItemsOnly: true, // Only spec items, not tasks
   315→        };
   316→
   317→        if (options.type) {
   318→          filter.type = options.type as ItemType;
   319→        }
   320→
   321→        // AC: @multi-value-status-filter ac-item-list-parity, ac-invalid-item-status
   322→        if (options.status) {
   323→          const { parseMultiStatus } = await import("./tasks.js");
   324→          const { ImplementationStatusSchema } = await import("../../schema/common.js");
   325→          const statuses = parseMultiStatus(
   326→            options.status,
   327→            ImplementationStatusSchema.options,
   328→            "implementation status",
   329→          );
   330→          if (statuses) {
   331→            filter.implementation = statuses.length === 1 ? statuses[0] : statuses;
   332→          }
   333→        }
   334→
   335→        if (options.maturity) {
   336→          filter.maturity = options.maturity as Maturity;
   337→        }
   338→
   339→        if (options.tag && options.tag.length > 0) {
   340→          filter.tags = parseTagsArray(options.tag);
   341→        }
   342→
   343→        if (options.has && options.has.length > 0) {
   344→          filter.hasFields = options.has;
   345→        }
   346→
   347→        if (options.search) {
   348→          filter.titleContains = options.search;
   349→        }
   350→
   351→        if (options.grep) {
   352→          filter.grepSearch = options.grep;
   353→        }
   354→
   355→        // AC: @module-scoped-item-listing ac-under-filter, ac-under-invalid-ref
   356→        // Handle --under: scope to descendants of a module or parent item
   357→        let underRoot: LoadedSpecItem | undefined;
   358→        let underDescendantUlids: Set<string> | undefined;
   359→        if (options.under) {
   360→          const underResult = refIndex.resolve(options.under);
   361→          if (!underResult.ok) {
   362→            // AC: @module-scoped-item-listing ac-under-invalid-ref
   363→            error(`Reference not found: ${options.under}. Check with: kspec item get ${options.under}`);
   364→            process.exit(EXIT_CODES.NOT_FOUND);
   365→          }
   366→          underRoot = underResult.item as LoadedSpecItem;
   367→          // Check it's not a task
   368→          if ("status" in underRoot && typeof underRoot.status === "string") {
   369→            error(`Reference ${options.under} is a task, not a spec item`);
   370→            process.exit(EXIT_CODES.USAGE_ERROR);
   371→          }
   372→          // AC: @module-scoped-item-listing ac-nested-descendants
   373→          // Find all descendants based on _path and _sourceFile
   374→          const descendants = findDescendantItems(underRoot, items);
   375→          underDescendantUlids = new Set([underRoot._ulid, ...descendants.map(d => d._ulid)]);
   376→        }
   377→
   378→        const limit = parseInt(options.limit, 10) || 50;
   379→
   380→        // When --under is used, we need to get all items first, then filter by scope,
   381→        // because pagination before scoping could miss items
   382→        let specItems: LoadedSpecItem[];
   383→        let effectiveTotal: number;
   384→
   385→        if (underDescendantUlids) {
   386→          // AC: @module-scoped-item-listing ac-under-filter, ac-under-with-other-filters
   387→          // Get all items matching filters, then scope to descendants
   388→          const allResults = itemIndex.query(filter);
   389→          const allSpecItems = allResults.filter(
   390→            (item): item is LoadedSpecItem =>
   391→              !("status" in item && typeof item.status === "string"),
   392→          );
   393→          // Apply --under filtering (AND logic with other filters)
   394→          const scopedItems = allSpecItems.filter(item => underDescendantUlids!.has(item._ulid));
   395→          effectiveTotal = scopedItems.length;
   396→          specItems = scopedItems.slice(0, limit);
   397→        } else {
   398→          const result = itemIndex.queryPaginated(filter, 0, limit);
   399→          // Filter to only LoadedSpecItem (not tasks)
   400→          specItems = result.items.filter(
   401→            (item): item is LoadedSpecItem =>
   402→              !("status" in item && typeof item.status === "string"),
   403→          );
   404→          effectiveTotal = result.total;
   405→        }
   406→
   407→        // AC: @module-scoped-item-listing ac-count-with-under
   408→        // AC: @trait-filterable-list ac-8
   409→        if (options.count) {
   410→          output({ count: effectiveTotal }, () => {
   411→            console.log(effectiveTotal);
   412→          });
   413→          return;
   414→        }
   415→
   416→        output(
   417→          {
   418→            items: specItems,
   419→            total: effectiveTotal,
   420→            showing: specItems.length,
   421→            grepPattern: options.grep,
   422→            tree: options.tree,
   423→            under: options.under,
   424→          },
   425→          () => {
   426→            if (options.tree) {
   427→              // AC: @module-scoped-item-listing ac-under-with-tree
   428→              formatItemTree(specItems, options.verbose, options.grep);
   429→            } else {
   430→              formatItemList(specItems, options.verbose, options.grep);
   431→            }
   432→          },
   433→        );
   434→      } catch (err) {
   435→        error(errors.failures.listItems, err);
   436→        process.exit(EXIT_CODES.ERROR);
   437→      }
   438→    });
   439→
   440→  // kspec item get <ref>
   441→  item
   442→    .command("get <ref>")
   443→    .description("Get details for a specific item")
   444→    .action(async (ref) => {
   445→      try {
   446→        const ctx = await initContext();
   447→        const { refIndex, traitIndex, items } = await buildIndexes(ctx);
   448→
   449→        const result = refIndex.resolve(ref);
   450→
   451→        if (!result.ok) {
   452→          error(errors.reference.itemNotFound(ref));
   453→          process.exit(EXIT_CODES.ERROR);
   454→        }
   455→
   456→        const item = result.item as LoadedSpecItem;
   457→
   458→        // AC: @trait-display ac-2 - JSON mode includes inherited_traits array
   459→        const inheritedTraits = traitIndex.getInheritedAC(item._ulid);
   460→        const traitsByTrait = new Map<
   461→          string,
   462→          {
   463→            trait: (typeof inheritedTraits)[0]["trait"];
   464→            acs: AcceptanceCriterion[];
   465→          }
   466→        >();
   467→        for (const { trait, ac } of inheritedTraits) {
   468→          if (!traitsByTrait.has(trait.ulid)) {
   469→            traitsByTrait.set(trait.ulid, { trait, acs: [] });
   470→          }
   471→          traitsByTrait.get(trait.ulid)?.acs.push(ac);
   472→        }
   473→
   474→        // Build JSON output with inherited traits
   475→        const jsonOutput = {
   476→          ...item,
   477→          inherited_traits: Array.from(traitsByTrait.values()).map(
   478→            ({ trait, acs }) => ({
   479→              ref: `@${trait.slug}`,
   480→              title: trait.title,
   481→              acceptance_criteria: acs,
   482→            }),
   483→          ),
   484→        };
   485→
   486→        output(jsonOutput, () => {
   487→          console.log(chalk.bold(item.title));
   488→          console.log(chalk.gray("─".repeat(40)));
   489→          console.log(`${fieldLabels.ulid}      ${item._ulid}`);
   490→          if (item.slugs.length > 0) {
   491→            console.log(`${fieldLabels.slugs}     ${item.slugs.join(", ")}`);
   492→          }
   493→          console.log(`${fieldLabels.type}      ${item.type}`);
   494→
   495→          if (item.status && typeof item.status === "object") {
   496→            const s = item.status as {
   497→              maturity?: string;
   498→              implementation?: string;
   499→            };
   500→            if (s.maturity)
   501→              console.log(`${fieldLabels.maturity}  ${s.maturity}`);
   502→            if (s.implementation) {
   503→              // AC: @trait-retrospective ac-4
   504→              // Show retrospective verification source
   505→              const isRetrospective = item.traits?.includes(
   506→                "@trait-retrospective",
   507→              );
   508→              const statusLabel = isRetrospective
   509→                ? `${s.implementation} (retrospective)`
   510→                : s.implementation;
   511→              console.log(`${fieldLabels.implementation}${statusLabel}`);
   512→            }
   513→          }
   514→
   515→          // AC: @trait-retrospective ac-4
   516→          // Show verification metadata for retrospective specs
   517→          const isRetrospective = item.traits?.includes("@trait-retrospective");
   518→          if (isRetrospective && (item.verified_at || item.verified_by)) {
   519→            const verifiedDate = item.verified_at
   520→              ? new Date(item.verified_at).toISOString().split("T")[0]
   521→              : "unknown";
   522→            const verifiedBy = item.verified_by || "unknown";
   523→            console.log(`Verified:   ${verifiedDate} by ${verifiedBy}`);
   524→          }
   525→
   526→          if (
   527→            "tags" in item &&
   528→            Array.isArray(item.tags) &&
   529→            item.tags.length > 0
   530→          ) {
   531→            console.log(`${fieldLabels.tags}      ${item.tags.join(", ")}`);
   532→          }
   533→
   534→          // AC: @item-get ac-4
   535→          if (Array.isArray(item.depends_on) && item.depends_on.length > 0) {
   536→            console.log(`${fieldLabels.dependsOn} ${item.depends_on.join(", ")}`);
   537→          }
   538→          if (Array.isArray(item.implements) && item.implements.length > 0) {
   539→            console.log(`${fieldLabels.implements} ${item.implements.join(", ")}`);
   540→          }
   541→          if (Array.isArray(item.relates_to) && item.relates_to.length > 0) {
   542→            console.log(`${fieldLabels.relatesTo} ${item.relates_to.join(", ")}`);
   543→          }
   544→
   545→          if (item.description) {
   546→            console.log(`\n${sectionHeaders.description}`);
   547→            console.log(item.description);
   548→          }
   549→
   550→          // AC: @trait-display ac-1 - Show own AC first
   551→          if (
   552→            "acceptance_criteria" in item &&
   553→            Array.isArray(item.acceptance_criteria) &&
   554→            item.acceptance_criteria.length > 0
   555→          ) {
   556→            console.log(`\n${sectionHeaders.acceptanceCriteria}`);
   557→            for (const ac of item.acceptance_criteria) {
   558→              if (ac && typeof ac === "object" && "id" in ac) {
   559→                const acObj = ac as AcceptanceCriterion;
   560→                console.log(chalk.cyan(`  [${acObj.id}]`));
   561→                if (acObj.given) console.log(`    Given: ${acObj.given}`);
   562→                if (acObj.when) console.log(`    When: ${acObj.when}`);
   563→                if (acObj.then) console.log(`    Then: ${acObj.then}`);
   564→              }
   565→            }
   566→          }
   567→
   568→          // AC: @trait-display ac-1, ac-4, ac-5 - Show inherited AC per trait in labeled sections
   569→          if (traitsByTrait.size > 0) {
   570→            for (const { trait, acs } of traitsByTrait.values()) {
   571→              console.log(
   572→                chalk.gray(`\n─── Inherited from @${trait.slug} ───`),
   573→              );
   574→              for (const ac of acs) {
   575→                console.log(
   576→                  chalk.cyan(`  [${ac.id}]`) +
   577→                    chalk.gray(` (from @${trait.slug})`),
   578→                );
   579→                if (ac.given) console.log(`    Given: ${ac.given}`);
   580→                if (ac.when) console.log(`    When: ${ac.when}`);
   581→                if (ac.then) console.log(`    Then: ${ac.then}`);
   582→              }
   583→            }
   584→          }
   585→        });
   586→      } catch (err) {
   587→        error(errors.failures.getItem, err);
   588→        process.exit(EXIT_CODES.ERROR);
   589→      }
   590→    });
   591→
   592→  // kspec item types - show available types and counts
   593→  item
   594→    .command("types")
   595→    .description("Show item types and counts")
   596→    .action(async () => {
   597→      try {
   598→        const ctx = await initContext();
   599→        const { itemIndex } = await buildIndexes(ctx);
   600→
   601→        const typeCounts = itemIndex.getTypeCounts();
   602→
   603→        output(Object.fromEntries(typeCounts), () => {
   604→          console.log(chalk.bold("Item Types"));
   605→          console.log(chalk.gray("─".repeat(30)));
   606→          for (const [type, count] of typeCounts) {
   607→            console.log(`  ${type}: ${count}`);
   608→          }
   609→          console.log(chalk.gray(`\nTotal: ${itemIndex.size} items`));
   610→        });
   611→      } catch (err) {
   612→        error(errors.failures.getTypes, err);
   613→        process.exit(EXIT_CODES.ERROR);
   614→      }
   615→    });
   616→
   617→  // kspec item tags - show available tags and counts
   618→  item
   619→    .command("tags")
   620→    .description("Show tags and counts")
   621→    .action(async () => {
   622→      try {
   623→        const ctx = await initContext();
   624→        const { itemIndex } = await buildIndexes(ctx);
   625→
   626→        const tagCounts = itemIndex.getTagCounts();
   627→
   628→        output(Object.fromEntries(tagCounts), () => {
   629→          console.log(chalk.bold("Tags"));
   630→          console.log(chalk.gray("─".repeat(30)));
   631→          for (const [tag, count] of tagCounts) {
   632→            console.log(`  #${tag}: ${count}`);
   633→          }
   634→        });
   635→      } catch (err) {
   636→        error(errors.failures.getTags, err);
   637→        process.exit(EXIT_CODES.ERROR);
   638→      }
   639→    });
   640→
   641→  // kspec item add - create a new spec item under a parent
   642→  markMutating(item.command("add"))
   643→    .description("Create a new spec item under a parent")
   644→    .requiredOption(
   645→      "--under <ref>",
   646→      "Parent item reference (e.g., @core-primitives)",
   647→    )
   648→    .requiredOption("--title <title>", "Item title")
   649→    .option(
   650→      "--type <type>",
   651→      "Item type (feature, requirement, constraint, decision)",
   652→      "feature",
   653→    )
   654→    .option("--slug <slug>", "Human-friendly slug")
   655→    .option("--priority <priority>", "Priority (high, medium, low)")
   656→    .option("--tag <tag...>", "Tags")
   657→    .option("--trait <trait...>", "Traits to apply (e.g., @trait-testable)")
   658→    .option("--description <desc>", "Description")
   659→    .option(
   660→      "--as <field>",
   661→      "Child field override (e.g., requirements, constraints)",
   662→    )
   663→    .addHelpText(
   664→      "after",
   665→      `
   666→Examples:
   667→  $ kspec item add --under @parent --title "Feature name" --type feature
   668→  $ kspec item add --under @parent --title "Multi-tag" --tag api public
   669→  $ kspec item add --under @parent --title "API endpoint" --trait @trait-api-endpoint`,
   670→    )
   671→    .action(async (options) => {
   672→      try {
   673→        const ctx = await initContext();
   674→        const { refIndex, items } = await buildIndexes(ctx);
   675→
   676→        // Find the parent item
   677→        const parentResult = refIndex.resolve(options.under);
   678→        if (!parentResult.ok) {
   679→          error(errors.reference.itemNotFound(options.under));
   680→          process.exit(EXIT_CODES.ERROR);
   681→        }
   682→
   683→        const parent = parentResult.item as LoadedSpecItem;
   684→
   685→        // Check it's not a task
   686→        if ("status" in parent && typeof parent.status === "string") {
   687→          error(errors.reference.parentIsTask(options.under));
   688→          process.exit(EXIT_CODES.ERROR);
   689→        }
   690→
   691→        // Check slug uniqueness if provided
   692→        if (options.slug) {
   693→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   694→          if (!slugCheck.ok) {
   695→            error(
   696→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
   697→            );
   698→            process.exit(EXIT_CODES.CONFLICT);
   699→          }
   700→        }
   701→
   702→        // Validate and canonicalize traits
   703→        const validatedTraits: string[] = [];
   704→        const seenTraitUlids = new Set<string>();
   705→        let hasTraitErrors = false;
   706→
   707→        if (options.trait) {
   708→          for (const traitRef of options.trait) {
   709→            const traitResult = refIndex.resolve(traitRef);
   710→            if (!traitResult.ok) {
   711→              error(`Trait not found: ${traitRef}`);
   712→              hasTraitErrors = true;
   713→              continue;
   714→            }
   715→
   716→            const traitItem = traitResult.item as LoadedSpecItem;
   717→            if (traitItem.type !== "trait") {
   718→              error(`${traitRef} is not a trait (type: ${traitItem.type})`);
   719→              hasTraitErrors = true;
   720→              continue;
   721→            }
   722→
   723→            // Deduplicate by ULID
   724→            if (seenTraitUlids.has(traitItem._ulid)) {
   725→              continue;
   726→            }
   727→            seenTraitUlids.add(traitItem._ulid);
   728→
   729→            // Store canonical ref (prefer slug over ULID)
   730→            const canonicalRef = `@${traitItem.slugs[0] || traitItem._ulid}`;
   731→            validatedTraits.push(canonicalRef);
   732→          }
   733→        }
   734→
   735→        if (hasTraitErrors) {
   736→          process.exit(EXIT_CODES.NOT_FOUND);
   737→        }
   738→
   739→        const input: SpecItemInput = {
   740→          title: options.title,
   741→          type: options.type as ItemType,
   742→          slugs: options.slug ? [options.slug] : [],
   743→          priority: options.priority,
   744→          tags: parseTagsArray(options.tag),
   745→          description: options.description,
   746→          depends_on: [],
   747→          implements: [],
   748→          relates_to: [],
   749→          tests: [],
   750→          traits: validatedTraits,
   751→          notes: [],
   752→        };
   753→
   754→        const newItem = createSpecItem(input);
   755→        const result = await addChildItem(ctx, parent, newItem, options.as);
   756→
   757→        // Build index including the new item for accurate short ULID
   758→        const index = new ReferenceIndex(
   759→          [],
   760→          [...items, result.item as LoadedSpecItem],
   761→        );
   762→        const itemSlug =
   763→          (result.item as LoadedSpecItem).slugs?.[0] ||
   764→          index.shortUlid(result.item._ulid);
   765→        await commitIfShadow(ctx.shadow, "item-add", itemSlug);
   766→        success(
   767→          `Created item: ${index.shortUlid(result.item._ulid)} under @${parent.slugs[0] || parent._ulid.slice(0, 8)}`,
   768→          {
   769→            item: result.item,
   770→            path: result.path,
   771→          },
   772→        );
   773→
   774→        // Derive hint
   775→        if (!isJsonMode()) {
   776→          const refSlug =
   777→            (result.item as LoadedSpecItem).slugs?.[0] ||
   778→            index.shortUlid(result.item._ulid);
   779→          console.log(
   780→            chalk.gray(
   781→              `\nDerive implementation task? kspec derive @${refSlug}`,
   782→            ),
   783→          );
   784→        }
   785→      } catch (err) {
   786→        error(errors.failures.createItem, err);
   787→        process.exit(EXIT_CODES.ERROR);
   788→      }
   789→    });
   790→
   791→  // kspec item set - update a spec item field
   792→  markMutating(item.command("set <ref>"))
   793→    .description("Update a spec item field")
   794→    .option("--title <title>", "Set title")
   795→    .option("--type <type>", "Set type")
   796→    .option("--slug <slug>", "Add a slug")
   797→    .option("--remove-slug <slug>", "Remove a slug")
   798→    .option("--priority <priority>", "Set priority")
   799→    .option("--tag <tag...>", "Set tags (replaces existing)")
   800→    .option("--description <desc>", "Set description")
   801→    .option(
   802→      "--status <status>",
   803→      "Set implementation status (not_started, in_progress, implemented, verified)",
   804→    )
   805→    .option(
   806→      "--maturity <maturity>",
   807→      "Set maturity (draft, proposed, stable, deferred, deprecated)",
   808→    )
   809→    .option(
   810→      "--verified-by <agent-ref>",
   811→      "Set verified_by (for retrospective specs)",
   812→    )
   813→    .option(
   814→      "--verified-at <iso-timestamp>",
   815→      "Set verified_at (defaults to now if --verified-by provided)",
   816→    )
   817→    .option("--trait <trait...>", "Set traits (replaces existing)")
   818→    .option("--relates-to <ref>", "Add a relates_to reference")
   819→    .option("--implements <ref>", "Add an implements reference")
   820→    .option("--depends-on <ref>", "Add a depends_on reference")
   821→    .option("--clear-relates-to", "Clear all relates_to references")
   822→    .option("--clear-implements", "Clear all implements references")
   823→    .option("--clear-depends-on", "Clear all depends_on references")
   824→    .addHelpText(
   825→      "after",
   826→      `
   827→Examples:
   828→  $ kspec item set @item-ref --title "New title"
   829→  $ kspec item set @item-ref --tag api internal security
   830→  $ kspec item set @item-ref --trait reusable testable
   831→  $ kspec item set @item-ref --relates-to @other-item
   832→  $ kspec item set @item-ref --implements @feature-spec
   833→  $ kspec item set @item-ref --depends-on @prereq-spec`,
   834→    )
   835→    .action(async (ref, options) => {
   836→      try {
   837→        const ctx = await initContext();
   838→        const { refIndex, items, tasks } = await buildIndexes(ctx);
   839→
   840→        const result = refIndex.resolve(ref);
   841→        if (!result.ok) {
   842→          error(errors.reference.itemNotFound(ref));
   843→          process.exit(EXIT_CODES.ERROR);
   844→        }
   845→
   846→        const foundItem = result.item as LoadedSpecItem;
   847→
   848→        // Check if it's a task (tasks should use task commands)
   849→        if ("status" in foundItem && typeof foundItem.status === "string") {
   850→          error(errors.reference.taskUseTaskCommands(ref));
   851→          process.exit(EXIT_CODES.ERROR);
   852→        }
   853→
   854→        // Check slug uniqueness if adding a new slug
   855→        if (options.slug) {
   856→          const slugCheck = checkSlugUniqueness(
   857→            refIndex,
   858→            [options.slug],
   859→            foundItem._ulid,
   860→          );
   861→          if (!slugCheck.ok) {
   862→            error(
   863→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
   864→            );
   865→            process.exit(EXIT_CODES.CONFLICT);
   866→          }
   867→        }
   868→
   869→        // Validate --remove-slug
   870→        if (options.removeSlug) {
   871→          const currentSlugs = foundItem.slugs || [];
   872→          if (!currentSlugs.includes(options.removeSlug)) {
   873→            error(errors.slug.notFound(options.removeSlug));
   874→            process.exit(EXIT_CODES.ERROR);
   875→          }
   876→          if (currentSlugs.length === 1) {
   877→            error(errors.slug.cannotRemoveLast(options.removeSlug));
   878→            process.exit(EXIT_CODES.ERROR);
   879→          }
   880→        }
   881→
   882→        // Mutual exclusivity: cannot add and clear same field
   883→        // Check this before ref resolution so usage errors take precedence
   884→        if (options.relatesTo && options.clearRelatesTo) {
   885→          error("Cannot use --relates-to and --clear-relates-to together");
   886→          process.exit(EXIT_CODES.USAGE_ERROR);
   887→        }
   888→        if (options.implements && options.clearImplements) {
   889→          error("Cannot use --implements and --clear-implements together");
   890→          process.exit(EXIT_CODES.USAGE_ERROR);
   891→        }
   892→        if (options.dependsOn && options.clearDependsOn) {
   893→          error("Cannot use --depends-on and --clear-depends-on together");
   894→          process.exit(EXIT_CODES.USAGE_ERROR);
   895→        }
   896→
   897→        // Helper to validate relationship refs (must exist and be a spec item, not a task)
   898→        // Returns { ulid, canonicalRef } for deduplication and user-friendly storage
   899→        const validateRelationshipRef = (refStr: string, flagName: string): { ulid: string; canonicalRef: string } => {
   900→          const refResult = refIndex.resolve(refStr);
   901→          if (!refResult.ok) {
   902→            error(errors.reference.itemNotFound(refStr));
   903→            process.exit(EXIT_CODES.NOT_FOUND);
   904→          }
   905→          // Ensure it's a spec item, not a task
   906→          const isTask = tasks.some((t) => t._ulid === refResult.ulid);
   907→          if (isTask) {
   908→            error(`${flagName} reference must be a spec item, not a task: ${refStr}`);
   909→            process.exit(EXIT_CODES.USAGE_ERROR);
   910→          }
   911→          // Use primary slug if available for user-friendly storage, otherwise ULID
   912→          const item = refResult.item as LoadedSpecItem;
   913→          const canonicalRef = item.slugs?.[0] ? `@${item.slugs[0]}` : `@${refResult.ulid}`;
   914→          return { ulid: refResult.ulid, canonicalRef };
   915→        };
   916→
   917→        // Helper to resolve existing refs to ULIDs for deduplication
   918→        const resolveRefsToUlids = (refs: string[]): Set<string> => {
   919→          const ulids = new Set<string>();
   920→          for (const ref of refs) {
   921→            const result = refIndex.resolve(ref);
   922→            if (result.ok) {
   923→              ulids.add(result.ulid);
   924→            }
   925→          }
   926→          return ulids;
   927→        };
   928→
   929→        // AC: @item-set ac-5 - --relates-to validation
   930→        // Store resolved ULID for deduplication and canonical ref for storage
   931→        let relatesToResolved: { ulid: string; canonicalRef: string } | undefined;
   932→        if (options.relatesTo) {
   933→          relatesToResolved = validateRelationshipRef(options.relatesTo, "--relates-to");
   934→        }
   935→
   936→        // AC: @item-set ac-6 - --implements validation
   937→        let implementsResolved: { ulid: string; canonicalRef: string } | undefined;
   938→        if (options.implements) {
   939→          implementsResolved = validateRelationshipRef(options.implements, "--implements");
   940→        }
   941→
   942→        // AC: @item-set ac-7 - --depends-on validation
   943→        let dependsOnResolved: { ulid: string; canonicalRef: string } | undefined;
   944→        if (options.dependsOn) {
   945→          dependsOnResolved = validateRelationshipRef(options.dependsOn, "--depends-on");
   946→        }
   947→
   948→        // Build updates object
   949→        const updates: Partial<SpecItemInput> = {};
   950→
   951→        if (options.title) updates.title = options.title;
   952→        if (options.type) updates.type = options.type as ItemType;
   953→        if (options.slug || options.removeSlug) {
   954→          let slugs = [...(foundItem.slugs || [])];
   955→          if (options.removeSlug) {
   956→            slugs = slugs.filter((s) => s !== options.removeSlug);
   957→          }
   958→          if (options.slug) {
   959→            slugs.push(options.slug);
   960→          }
   961→          updates.slugs = slugs;
   962→        }
   963→        if (options.priority) updates.priority = options.priority;
   964→        if (options.tag) updates.tags = parseTagsArray(options.tag);
   965→        if (options.trait) updates.traits = options.trait;
   966→        if (options.description) updates.description = options.description;
   967→
   968→        // Handle status updates
   969→        if (options.status || options.maturity) {
   970→          const currentStatus =
   971→            foundItem.status && typeof foundItem.status === "object"
   972→              ? foundItem.status
   973→              : {};
   974→          updates.status = {
   975→            ...currentStatus,
   976→            ...(options.status && { implementation: options.status }),
   977→            ...(options.maturity && { maturity: options.maturity }),
   978→          };
   979→        }
   980→
   981→        // Handle verification metadata (for retrospective specs)
   982→        if (options.verifiedBy) {
   983→          updates.verified_by = options.verifiedBy;
   984→          // Default verified_at to now if not specified
   985→          updates.verified_at = options.verifiedAt || new Date().toISOString();
   986→        } else if (options.verifiedAt) {
   987→          updates.verified_at = options.verifiedAt;
   988→        }
   989→
   990→        // AC: @item-set ac-5 - Handle relates_to (append semantics)
   991→        // Uses resolved ULIDs for deduplication and stores canonical slug format
   992→        if (relatesToResolved) {
   993→          const current = foundItem.relates_to || [];
   994→          const existingUlids = resolveRefsToUlids(current);
   995→          if (!existingUlids.has(relatesToResolved.ulid)) {
   996→            updates.relates_to = [...current, relatesToResolved.canonicalRef];
   997→          }
   998→        }
   999→        if (options.clearRelatesTo) {
  1000→          updates.relates_to = [];
  1001→        }
  1002→
  1003→        // AC: @item-set ac-6 - Handle implements (append semantics)
  1004→        // Uses resolved ULIDs for deduplication and stores canonical slug format
  1005→        if (implementsResolved) {
  1006→          const current = foundItem.implements || [];
  1007→          const existingUlids = resolveRefsToUlids(current);
  1008→          if (!existingUlids.has(implementsResolved.ulid)) {
  1009→            updates.implements = [...current, implementsResolved.canonicalRef];
  1010→          }
  1011→        }
  1012→        if (options.clearImplements) {
  1013→          updates.implements = [];
  1014→        }
  1015→
  1016→        // AC: @item-set ac-7 - Handle depends_on (append semantics)
  1017→        // Uses resolved ULIDs for deduplication and stores canonical slug format
  1018→        if (dependsOnResolved) {
  1019→          const current = foundItem.depends_on || [];
  1020→          const existingUlids = resolveRefsToUlids(current);
  1021→          if (!existingUlids.has(dependsOnResolved.ulid)) {
  1022→            updates.depends_on = [...current, dependsOnResolved.canonicalRef];
  1023→          }
  1024→        }
  1025→        if (options.clearDependsOn) {
  1026→          updates.depends_on = [];
  1027→        }
  1028→
  1029→        if (Object.keys(updates).length === 0) {
  1030→          warn("No updates specified");
  1031→          return;
  1032→        }
  1033→
  1034→        const updated = await updateSpecItem(ctx, foundItem, updates);
  1035→        const itemSlug =
  1036→          foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
  1037→
  1038→        // Handle cascade for implementation status updates
  1039→        const updatedItems: LoadedSpecItem[] = [updated];
  1040→        if (options.status) {
  1041→          const cascadeResult = await handleStatusCascade(
  1042→            ctx,
  1043→            updated,
  1044→            options.status,
  1045→            items,
  1046→            refIndex,
  1047→          );
  1048→          updatedItems.push(...cascadeResult);
  1049→        }
  1050→
  1051→        await commitIfShadow(ctx.shadow, "item-set", itemSlug);
  1052→        success(`Updated item: ${refIndex.shortUlid(updated._ulid)}`, {
  1053→          item: updated,
  1054→        });
  1055→
  1056→        // Derive hint
  1057→        if (!isJsonMode()) {
  1058→          const refSlug =
  1059→            updated.slugs?.[0] || refIndex.shortUlid(updated._ulid);
  1060→          console.log(
  1061→            chalk.gray(
  1062→              `\nDerive implementation task? kspec derive @${refSlug}`,
  1063→            ),
  1064→          );
  1065→        }
  1066→      } catch (err) {
  1067→        error(errors.failures.updateItem, err);
  1068→        process.exit(EXIT_CODES.ERROR);
  1069→      }
  1070→    });
  1071→
  1072→  // kspec item delete - delete a spec item
  1073→  markMutating(item.command("delete <ref>"))
  1074→    .description("Delete a spec item (including nested items)")
  1075→    .option("--force", "Skip confirmation")
  1076→    .option("--cascade", "Delete item and all descendants")
  1077→    .action(async (ref, options) => {
  1078→      try {
  1079→        const ctx = await initContext();
  1080→        const { refIndex, items } = await buildIndexes(ctx);
  1081→
  1082→        const result = refIndex.resolve(ref);
  1083→        if (!result.ok) {
  1084→          error(errors.reference.itemNotFound(ref));
  1085→          process.exit(EXIT_CODES.ERROR);
  1086→        }
  1087→
  1088→        const foundItem = result.item as LoadedSpecItem;
  1089→
  1090→        // Check if it's a task
  1091→        if ("status" in foundItem && typeof foundItem.status === "string") {
  1092→          error(errors.reference.itemUseTaskCancel(ref));
  1093→          process.exit(EXIT_CODES.ERROR);
  1094→        }
  1095→
  1096→        if (!foundItem._sourceFile) {
  1097→          error(errors.operation.cannotDeleteNoSource);
  1098→          process.exit(EXIT_CODES.ERROR);
  1099→        }
  1100→
  1101→        // AC: @spec-item-delete-children ac-7 - Check if this is a trait with implementors
  1102→        const implementors = findTraitImplementors(foundItem, items);
  1103→        if (implementors.length > 0) {
  1104→          const implementorRefs = implementors
  1105→            .map((i) => `@${i.slugs[0] || i._ulid.slice(0, 8)}`)
  1106→            .join(", ");
  1107→          const errorMsg = `Cannot delete: trait is used by ${implementors.length} specs. Remove trait from specs first: ${implementorRefs}`;
  1108→
  1109→          if (isJsonMode()) {
  1110→            error(errorMsg, {
  1111→              error: "trait_in_use",
  1112→              implementors: implementors.map((i) => ({
  1113→                ulid: i._ulid,
  1114→                slug: i.slugs[0],
  1115→                title: i.title,
  1116→              })),
  1117→            });
  1118→          } else {
  1119→            error(errorMsg);
  1120→          }
  1121→          process.exit(EXIT_CODES.ERROR);
  1122→        }
  1123→
  1124→        // AC: @spec-item-delete-children ac-1 ac-8 - Check for child items (nested YAML items, not relates_to refs)
  1125→        const children = findChildItems(foundItem, items);
  1126→
  1127→        if (children.length > 0 && !options.cascade) {
  1128→          // AC: @spec-item-delete-children ac-1 - Block deletion if children exist without --cascade
  1129→          const errorMsg = `Cannot delete: item has ${children.length} children. Use --cascade to delete recursively`;
  1130→
  1131→          if (isJsonMode()) {
  1132→            // AC: @spec-item-delete-children ac-10 - JSON error includes children array
  1133→            error(errorMsg, {
  1134→              error: "has_children",
  1135→              children: children.map((c) => ({
  1136→                ulid: c._ulid,
  1137→                slug: c.slugs[0],
  1138→                title: c.title,
  1139→                ref: `@${c.slugs[0] || c._ulid.slice(0, 8)}`,
  1140→              })),
  1141→            });
  1142→          } else {
  1143→            error(errorMsg);
  1144→          }
  1145→          process.exit(EXIT_CODES.ERROR);
  1146→        }
  1147→
  1148→        // AC: @spec-item-delete-children ac-9 - Custom confirmation prompt for cascade
  1149→        if (children.length > 0 && options.cascade && !options.force) {
  1150→          const itemRef = `@${foundItem.slugs[0] || foundItem._ulid.slice(0, 8)}`;
  1151→
  1152→          // Check for JSON mode - requires --force
  1153→          if (isJsonMode()) {
  1154→            error("Confirmation required. Use --force with --json");
  1155→            process.exit(EXIT_CODES.ERROR);
  1156→          }
  1157→
  1158→          // Check for non-interactive environment
  1159→          const isTTY =
  1160→            process.env.KSPEC_TEST_TTY === "true" || process.stdin.isTTY;
  1161→          if (!isTTY) {
  1162→            error("Non-interactive environment. Use --force to proceed");
  1163→            process.exit(EXIT_CODES.ERROR);
  1164→          }
  1165→
  1166→          // Show confirmation prompt
  1167→          const readline = await import("node:readline");
  1168→          const rl = readline.createInterface({
  1169→            input: process.stdin,
  1170→            output: process.stdout,
  1171→          });
  1172→
  1173→          const response = await new Promise<string>((resolve) => {
  1174→            rl.question(
  1175→              chalk.yellow(
  1176→                `Delete ${itemRef} and ${children.length} descendant items? [y/N] `,
  1177→              ),
  1178→              (answer) => {
  1179→                rl.close();
  1180→                resolve(answer);
  1181→              },
  1182→            );
  1183→          });
  1184→
  1185→          if (response.toLowerCase() !== "y") {
  1186→            console.log(chalk.gray("Operation cancelled"));
  1187→            process.exit(EXIT_CODES.USAGE_ERROR);
  1188→          }
  1189→        }
  1190→
  1191→        // AC: @spec-item-delete-children ac-2 ac-3 - Delete item and all descendants with cascade
  1192→        const itemsToDelete = options.cascade
  1193→          ? [foundItem, ...children]
  1194→          : [foundItem];
  1195→        let deletedCount = 0;
  1196→
  1197→        // Delete in reverse order (deepest first) to avoid path issues
  1198→        const sortedItems = [...itemsToDelete].sort((a, b) => {
  1199→          const aDepth = a._path ? a._path.split(".").length : 0;
  1200→          const bDepth = b._path ? b._path.split(".").length : 0;
  1201→          return bDepth - aDepth;
  1202→        });
  1203→
  1204→        for (const itemToDelete of sortedItems) {
  1205→          const deleted = await deleteSpecItem(ctx, itemToDelete);
  1206→          if (deleted) {
  1207→            deletedCount++;
  1208→          }
  1209→        }
  1210→
  1211→        if (deletedCount > 0) {
  1212→          // AC: @spec-item-delete-children ac-6 - Single shadow commit with all deletions
  1213→          const itemSlug =
  1214→            foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
  1215→          const commitMsg =
  1216→            deletedCount > 1 ? `${deletedCount} items` : itemSlug;
  1217→          await commitIfShadow(ctx.shadow, "item-delete", commitMsg);
  1218→
  1219→          if (deletedCount > 1) {
  1220→            success(`Deleted ${deletedCount} items`, {
  1221→              deleted: deletedCount,
  1222→              root_ulid: foundItem._ulid,
  1223→            });
  1224→          } else {
  1225→            success(`Deleted item: ${foundItem.title}`, {
  1226→              deleted: true,
  1227→              ulid: foundItem._ulid,
  1228→            });
  1229→          }
  1230→        } else {
  1231→          error(errors.failures.deleteItem);
  1232→          console.log(
  1233→            chalk.gray(
  1234→              `Edit the source file directly: ${foundItem._sourceFile}`,
  1235→            ),
  1236→          );
  1237→          process.exit(EXIT_CODES.ERROR);
  1238→        }
  1239→      } catch (err) {
  1240→        error(errors.failures.deleteItem, err);
  1241→        process.exit(EXIT_CODES.ERROR);
  1242→      }
  1243→    });
  1244→
  1245→  // kspec item patch - update item fields via JSON
  1246→  markMutating(item.command("patch [ref]"))
  1247→    .description("Update spec item fields via JSON patch")
  1248→    .option("--data <json>", "JSON data to patch")
  1249→    .option("--bulk", "Read patches from stdin (JSONL or JSON array)")
  1250→    .option("--allow-unknown", "Allow fields not in schema")
  1251→    .option("--dry-run", "Preview changes without applying")
  1252→    .option("--fail-fast", "Stop on first error (bulk mode)")
  1253→    .action(async (ref: string | undefined, options) => {
  1254→      try {
  1255→        const ctx = await initContext();
  1256→
  1257→        if (options.bulk) {
  1258→          // Bulk mode: read from stdin
  1259→          const stdin = await readStdinFully();
  1260→          if (!stdin) {
  1261→            error(errors.validation.noInputProvided);
  1262→            process.exit(EXIT_CODES.ERROR);
  1263→          }
  1264→
  1265→          let patches: PatchOperation[];
  1266→          try {
  1267→            patches = parseBulkInput(stdin);
  1268→          } catch (err) {
  1269→            error(
  1270→              errors.validation.failedToParseBulk(
  1271→                err instanceof Error ? err.message : String(err),
  1272→              ),
  1273→            );
  1274→            process.exit(EXIT_CODES.ERROR);
  1275→          }
  1276→
  1277→          if (patches.length === 0) {
  1278→            error(errors.validation.noPatchesProvided);
  1279→            process.exit(EXIT_CODES.ERROR);
  1280→          }
  1281→
  1282→          const { refIndex, items } = await buildIndexes(ctx);
  1283→          const result = await patchSpecItems(ctx, refIndex, items, patches, {
  1284→            allowUnknown: options.allowUnknown,
  1285→            failFast: options.failFast,
  1286→            dryRun: options.dryRun,
  1287→          });
  1288→
  1289→          // Shadow commit if any updates
  1290→          if (!options.dryRun && result.summary.updated > 0) {
  1291→            await commitIfShadow(
  1292→              ctx.shadow,
  1293→              "item-patch",
  1294→              `${result.summary.updated} items`,
  1295→            );
  1296→          }
  1297→
  1298→          output(result, () => formatBulkPatchResult(result, options.dryRun));
  1299→
  1300→          if (result.summary.failed > 0) {
  1301→            process.exit(EXIT_CODES.ERROR);
  1302→          }
  1303→        } else {
  1304→          // Single item mode
  1305→          if (!ref) {
  1306→            error(errors.usage.patchNeedRef);
  1307→            process.exit(EXIT_CODES.ERROR);
  1308→          }
  1309→
  1310→          let data: Record<string, unknown>;
  1311→
  1312→          // Get data from --data option or stdin
  1313→          if (options.data) {
  1314→            try {
  1315→              data = JSON.parse(options.data);
  1316→            } catch (err) {
  1317→              error(
  1318→                errors.validation.invalidJsonInData(
  1319→                  err instanceof Error ? err.message : "",
  1320→                ),
  1321→              );
  1322→              process.exit(EXIT_CODES.ERROR);
  1323→            }
  1324→          } else {
  1325→            const stdin = await readStdinIfAvailable();
  1326→            if (stdin) {
  1327→              try {
  1328→                data = JSON.parse(stdin.trim());
  1329→              } catch (err) {
  1330→                error(
  1331→                  errors.validation.invalidJsonFromStdin(
  1332→                    err instanceof Error ? err.message : "",
  1333→                  ),
  1334→                );
  1335→                process.exit(EXIT_CODES.ERROR);
  1336→              }
  1337→            } else {
  1338→              error(errors.validation.noPatchData);
  1339→              process.exit(EXIT_CODES.ERROR);
  1340→            }
  1341→          }
  1342→
  1343→          // Validate against schema (unless --allow-unknown)
  1344→          if (!options.allowUnknown) {
  1345→            // Use strict schema (no passthrough)
  1346→            const strictSchema = SpecItemPatchSchema.strict();
  1347→            const parseResult = strictSchema.safeParse(data);
  1348→            if (!parseResult.success) {
  1349→              const issues = parseResult.error.issues
  1350→                .map((i) => `${i.path.join(".")}: ${i.message}`)
  1351→                .join("; ");
  1352→              error(errors.validation.invalidPatchDataWithIssues(issues));
  1353→              process.exit(EXIT_CODES.ERROR);
  1354→            }
  1355→          }
  1356→
  1357→          const { refIndex, items } = await buildIndexes(ctx);
  1358→
  1359→          // Resolve ref
  1360→          const resolved = refIndex.resolve(ref);
  1361→          if (!resolved.ok) {
  1362→            error(errors.reference.itemNotFound(ref));
  1363→            process.exit(EXIT_CODES.ERROR);
  1364→          }
  1365→
  1366→          // Find the item
  1367→          const foundItem = items.find((i) => i._ulid === resolved.ulid);
  1368→          if (!foundItem) {
  1369→            error(errors.reference.notItem(ref));
  1370→            process.exit(EXIT_CODES.ERROR);
  1371→          }
  1372→
  1373→          if (options.dryRun) {
  1374→            output(
  1375→              {
  1376→                ref,
  1377→                data,
  1378→                wouldApplyTo: foundItem.title,
  1379→                ulid: foundItem._ulid,
  1380→              },
  1381→              () => {
  1382→                console.log(chalk.yellow("Would patch:"), foundItem.title);
  1383→                console.log(chalk.gray("ULID:"), foundItem._ulid.slice(0, 8));
  1384→                console.log(chalk.gray("Changes:"));
  1385→                console.log(JSON.stringify(data, null, 2));
  1386→              },
  1387→            );
  1388→            return;
  1389→          }
  1390→
  1391→          const updated = await updateSpecItem(ctx, foundItem, data);
  1392→          const itemSlug =
  1393→            foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
  1394→          await commitIfShadow(ctx.shadow, "item-patch", itemSlug);
  1395→
  1396→          success(`Patched item: ${itemSlug}`, { item: updated });
  1397→        }
  1398→      } catch (err) {
  1399→        error(errors.failures.patchItems, err);
  1400→        process.exit(EXIT_CODES.ERROR);
  1401→      }
  1402→    });
  1403→
  1404→  // kspec item status - show implementation status with linked tasks
  1405→  item
  1406→    .command("status <ref>")
  1407→    .description("Show implementation status and linked tasks for a spec item")
  1408→    .action(async (ref) => {
  1409→      try {
  1410→        const ctx = await initContext();
  1411→        const tasks = await loadAllTasks(ctx);
  1412→        const items = await loadAllItems(ctx);
  1413→        const refIndex = new ReferenceIndex(tasks, items);
  1414→
  1415→        const result = refIndex.resolve(ref);
  1416→        if (!result.ok) {
  1417→          error(errors.reference.itemNotFound(ref));
  1418→          process.exit(EXIT_CODES.ERROR);
  1419→        }
  1420→
  1421→        const foundItem = result.item as LoadedSpecItem;
  1422→
  1423→        // Check if it's a task
  1424→        if ("status" in foundItem && typeof foundItem.status === "string") {
  1425→          error(errors.reference.notItem(ref));
  1426→          process.exit(EXIT_CODES.ERROR);
  1427→        }
  1428→
  1429→        // Build alignment index
  1430→        const alignmentIndex = new AlignmentIndex(tasks, items);
  1431→        alignmentIndex.buildLinks(refIndex);
  1432→
  1433→        const summary = alignmentIndex.getImplementationSummary(
  1434→          foundItem._ulid,
  1435→        );
  1436→
  1437→        if (!summary) {
  1438→          error(errors.project.couldNotGetImplSummary);
  1439→          process.exit(EXIT_CODES.ERROR);
  1440→        }
  1441→
  1442→        output(summary, () => {
  1443→          console.log(chalk.bold(foundItem.title));
  1444→          console.log(chalk.gray("─".repeat(40)));
  1445→
  1446→          // Status
  1447→          const currentColor =
  1448→            summary.currentStatus === "implemented"
  1449→              ? chalk.green
  1450→              : summary.currentStatus === "in_progress"
  1451→                ? chalk.yellow
  1452→                : chalk.gray;
  1453→          const expectedColor =
  1454→            summary.expectedStatus === "implemented"
  1455→              ? chalk.green
  1456→              : summary.expectedStatus === "in_progress"
  1457→                ? chalk.yellow
  1458→                : chalk.gray;
  1459→
  1460→          console.log(
  1461→            `Current status:  ${currentColor(summary.currentStatus)}`,
  1462→          );
  1463→          console.log(
  1464→            `Expected status: ${expectedColor(summary.expectedStatus)}`,
  1465→          );
  1466→
  1467→          if (!summary.isAligned) {
  1468→            console.log(
  1469→              chalk.yellow("\n⚠ Status mismatch - run task complete to sync"),
  1470→            );
  1471→          } else {
  1472→            console.log(chalk.green("\n✓ Aligned"));
  1473→          }
  1474→
  1475→          // Linked tasks
  1476→          console.log(chalk.bold("\nLinked Tasks:"));
  1477→          if (summary.linkedTasks.length === 0) {
  1478→            console.log(chalk.gray("  No tasks reference this spec item"));
  1479→          } else {
  1480→            for (const task of summary.linkedTasks) {
  1481→              const statusColor =
  1482→                task.taskStatus === "completed"
  1483→                  ? chalk.green
  1484→                  : task.taskStatus === "in_progress"
  1485→                    ? chalk.blue
  1486→                    : chalk.gray;
  1487→              const shortId = task.taskUlid.slice(0, 8);
  1488→              const notes = task.hasNotes ? chalk.gray(" (has notes)") : "";
  1489→              console.log(
  1490→                `  ${statusColor(`[${task.taskStatus}]`)} ${shortId} ${task.taskTitle}${notes}`,
  1491→              );
  1492→            }
  1493→          }
  1494→        });
  1495→      } catch (err) {
  1496→        error(errors.failures.getItemStatus, err);
  1497→        process.exit(EXIT_CODES.ERROR);
  1498→      }
  1499→    });
  1500→
  1501→  // kspec item note <ref> <message>
  1502→  markMutating(item.command("note <ref> <message>"))
  1503→    .description("Add a note to a spec item")
  1504→    .option("--author <author>", "Note author")
  1505→    .option("--supersedes <ulid>", "ULID of note this supersedes")
  1506→    .action(async (ref: string, message: string, options) => {
  1507→      try {
  1508→        const ctx = await initContext();
  1509→        const items = await loadAllItems(ctx);
  1510→        const tasks = await loadAllTasks(ctx);
  1511→        const refIndex = new ReferenceIndex(tasks, items);
  1512→
  1513→        const result = refIndex.resolve(ref);
  1514→        if (!result.ok) {
  1515→          error(errors.reference.itemNotFound(ref));
  1516→          process.exit(EXIT_CODES.ERROR);
  1517→        }
  1518→
  1519→        const foundItem = items.find((i) => i._ulid === result.ulid);
  1520→        if (!foundItem) {
  1521→          error(errors.reference.itemNotFound(ref));
  1522→          process.exit(EXIT_CODES.ERROR);
  1523→        }
  1524→
  1525→        const note = createNote(message, options.author, options.supersedes);
  1526→
  1527→        const updatedNotes = [...(foundItem.notes || []), note];
  1528→        await updateSpecItem(ctx, foundItem, { notes: updatedNotes });
  1529→
  1530→        const itemSlug =
  1531→          foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
  1532→        await commitIfShadow(ctx.shadow, "item-note", itemSlug);
  1533→        success(
  1534→          `Added note to spec item: ${refIndex.shortUlid(foundItem._ulid)}`,
  1535→          { note },
  1536→        );
  1537→      } catch (err) {
  1538→        error(errors.failures.addNote, err);
  1539→        process.exit(EXIT_CODES.ERROR);
  1540→      }
  1541→    });
  1542→
  1543→  // kspec item notes <ref>
  1544→  item
  1545→    .command("notes <ref>")
  1546→    .description("Show notes for a spec item")
  1547→    .action(async (ref: string) => {
  1548→      try {
  1549→        const ctx = await initContext();
  1550→        const items = await loadAllItems(ctx);
  1551→        const tasks = await loadAllTasks(ctx);
  1552→        const refIndex = new ReferenceIndex(tasks, items);
  1553→
  1554→        const result = refIndex.resolve(ref);
  1555→        if (!result.ok) {
  1556→          error(errors.reference.itemNotFound(ref));
  1557→          process.exit(EXIT_CODES.ERROR);
  1558→        }
  1559→
  1560→        const foundItem = items.find((i) => i._ulid === result.ulid);
  1561→        if (!foundItem) {
  1562→          error(errors.reference.itemNotFound(ref));
  1563→          process.exit(EXIT_CODES.ERROR);
  1564→        }
  1565→
  1566→        const notes = foundItem.notes || [];
  1567→        output(notes, () => {
  1568→          if (notes.length === 0) {
  1569→            console.log("No notes");
  1570→          } else {
  1571→            for (const note of notes) {
  1572→              const author = note.author || "unknown";
  1573→              console.log(`[${note.created_at}] ${author}:`);
  1574→              console.log(note.content);
  1575→              console.log("");
  1576→            }
  1577→          }
  1578→        });
  1579→      } catch (err) {
  1580→        error(errors.failures.getNotes, err);
  1581→        process.exit(EXIT_CODES.ERROR);
  1582→      }
  1583→    });
  1584→
  1585→  // Create subcommand group for acceptance criteria operations
  1586→  const acCmd = item
  1587→    .command("ac")
  1588→    .description("Manage acceptance criteria on spec items");
  1589→
  1590→  // Helper: Generate next AC ID based on existing AC
  1591→  function generateNextAcId(
  1592→    existingAc: AcceptanceCriterion[] | undefined,
  1593→  ): string {
  1594→    if (!existingAc || existingAc.length === 0) return "ac-1";
  1595→
  1596→    const numericIds = existingAc
  1597→      .map((ac) => ac.id.match(/^ac-(\d+)$/)?.[1])
  1598→      .filter((id): id is string => id !== null && id !== undefined)
  1599→      .map(Number);
  1600→
  1601→    const maxId = numericIds.length > 0 ? Math.max(...numericIds) : 0;
  1602→    return `ac-${maxId + 1}`;
  1603→  }
  1604→
  1605→  // Helper: Resolve ref to spec item (not task)
  1606→  async function resolveSpecItem(ref: string): Promise<{
  1607→    ctx: Awaited<ReturnType<typeof initContext>>;
  1608→    item: LoadedSpecItem;
  1609→    refIndex: ReferenceIndex;
  1610→  }> {
  1611→    const ctx = await initContext();
  1612→    const { refIndex, items } = await buildIndexes(ctx);
  1613→
  1614→    const result = refIndex.resolve(ref);
  1615→    if (!result.ok) {
  1616→      error(errors.reference.itemNotFound(ref));
  1617→      process.exit(EXIT_CODES.NOT_FOUND);
  1618→    }
  1619→
  1620→    const foundItem = result.item as LoadedSpecItem;
  1621→
  1622→    // Check if it's a task
  1623→    if ("status" in foundItem && typeof foundItem.status === "string") {
  1624→      error(errors.operation.tasksNoAcceptanceCriteria(ref));
  1625→      process.exit(EXIT_CODES.NOT_FOUND);
  1626→    }
  1627→
  1628→    return { ctx, item: foundItem, refIndex };
  1629→  }
  1630→
  1631→  // kspec item ac list <ref>
  1632→  acCmd
  1633→    .command("list <ref>")
  1634→    .description("List acceptance criteria for a spec item")
  1635→    .action(async (ref: string) => {
  1636→      try {
  1637→        const { item, refIndex } = await resolveSpecItem(ref);
  1638→        const ac = item.acceptance_criteria || [];
  1639→
  1640→        output(ac, () => {
  1641→          console.log(
  1642→            chalk.bold(
  1643→              `Acceptance Criteria for: ${item.title} (@${item.slugs[0] || refIndex.shortUlid(item._ulid)})`,
  1644→            ),
  1645→          );
  1646→          console.log();
  1647→
  1648→          if (ac.length === 0) {
  1649→            console.log(chalk.gray("No acceptance criteria"));
  1650→          } else {
  1651→            for (const criterion of ac) {
  1652→              console.log(chalk.cyan(`  [${criterion.id}]`));
  1653→              console.log(chalk.gray(`    Given: ${criterion.given}`));
  1654→              console.log(chalk.gray(`    When:  ${criterion.when}`));
  1655→              console.log(chalk.gray(`    Then:  ${criterion.then}`));
  1656→              console.log();
  1657→            }
  1658→          }
  1659→
  1660→          console.log(chalk.gray(`${ac.length} acceptance criteria`));
  1661→        });
  1662→      } catch (err) {
  1663→        error(errors.failures.listAc, err);
  1664→        process.exit(EXIT_CODES.ERROR);
  1665→      }
  1666→    });
  1667→
  1668→  // kspec item ac add <ref>
  1669→  markMutating(acCmd.command("add <ref>"))
  1670→    .description("Add an acceptance criterion to a spec item")
  1671→    .option("--id <id>", "AC identifier (auto-generated if not provided)")
  1672→    .requiredOption("--given <text>", "The precondition (Given...)")
  1673→    .requiredOption("--when <text>", "The action/trigger (When...)")
  1674→    .requiredOption("--then <text>", "The expected outcome (Then...)")
  1675→    .action(async (ref: string, options) => {
  1676→      try {
  1677→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1678→        const existingAc = item.acceptance_criteria || [];
  1679→
  1680→        // Determine ID
  1681→        const acId = options.id || generateNextAcId(existingAc);
  1682→
  1683→        // Check for duplicate ID
  1684→        if (existingAc.some((ac) => ac.id === acId)) {
  1685→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1686→          error(errors.conflict.acAlreadyExists(acId, itemRef));
  1687→          process.exit(EXIT_CODES.CONFLICT);
  1688→        }
  1689→
  1690→        // Create new AC
  1691→        const newAc: AcceptanceCriterion = {
  1692→          id: acId,
  1693→          given: options.given,
  1694→          when: options.when,
  1695→          then: options.then,
  1696→        };
  1697→
  1698→        // Update item with new AC
  1699→        const updatedAc = [...existingAc, newAc];
  1700→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1701→
  1702→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1703→        await commitIfShadow(ctx.shadow, "item-ac-add", itemSlug);
  1704→        success(`Added acceptance criterion: ${acId} to @${itemSlug}`, {
  1705→          ac: newAc,
  1706→        });
  1707→      } catch (err) {
  1708→        error(errors.failures.addAc, err);
  1709→        process.exit(EXIT_CODES.ERROR);
  1710→      }
  1711→    });
  1712→
  1713→  // kspec item ac set <ref> <ac-id>
  1714→  markMutating(acCmd.command("set <ref> <acId>"))
  1715→    .description("Update an acceptance criterion")
  1716→    .option("--id <newId>", "Rename the AC ID")
  1717→    .option("--given <text>", "Update the precondition")
  1718→    .option("--when <text>", "Update the action/trigger")
  1719→    .option("--then <text>", "Update the expected outcome")
  1720→    .action(async (ref: string, acId: string, options) => {
  1721→      try {
  1722→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1723→        const existingAc = item.acceptance_criteria || [];
  1724→
  1725→        // Find the AC
  1726→        const acIndex = existingAc.findIndex((ac) => ac.id === acId);
  1727→        if (acIndex === -1) {
  1728→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1729→          error(errors.reference.acNotFound(acId, itemRef));
  1730→          process.exit(EXIT_CODES.NOT_FOUND);
  1731→        }
  1732→
  1733→        // Check for no updates
  1734→        if (!options.id && !options.given && !options.when && !options.then) {
  1735→          warn("No updates specified");
  1736→          return;
  1737→        }
  1738→
  1739→        // Check for duplicate ID if renaming
  1740→        if (
  1741→          options.id &&
  1742→          options.id !== acId &&
  1743→          existingAc.some((ac) => ac.id === options.id)
  1744→        ) {
  1745→          error(errors.conflict.acIdAlreadyExists(options.id));
  1746→          process.exit(EXIT_CODES.CONFLICT);
  1747→        }
  1748→
  1749→        // Build updated AC
  1750→        const updatedAc = [...existingAc];
  1751→        const updatedFields: string[] = [];
  1752→
  1753→        updatedAc[acIndex] = {
  1754→          ...updatedAc[acIndex],
  1755→          ...(options.id && { id: options.id }),
  1756→          ...(options.given && { given: options.given }),
  1757→          ...(options.when && { when: options.when }),
  1758→          ...(options.then && { then: options.then }),
  1759→        };
  1760→
  1761→        if (options.id) updatedFields.push("id");
  1762→        if (options.given) updatedFields.push("given");
  1763→        if (options.when) updatedFields.push("when");
  1764→        if (options.then) updatedFields.push("then");
  1765→
  1766→        // Update item
  1767→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1768→
  1769→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1770→        await commitIfShadow(ctx.shadow, "item-ac-set", itemSlug);
  1771→        success(
  1772→          `Updated acceptance criterion: ${acId} on @${itemSlug} (${updatedFields.join(", ")})`,
  1773→          { ac: updatedAc[acIndex] },
  1774→        );
  1775→      } catch (err) {
  1776→        error(errors.failures.updateAc, err);
  1777→        process.exit(EXIT_CODES.ERROR);
  1778→      }
  1779→    });
  1780→
  1781→  // kspec item ac remove <ref> <ac-id>
  1782→  markMutating(acCmd.command("remove <ref> <acId>"))
  1783→    .description("Remove an acceptance criterion")
  1784→    .option("--force", "Skip confirmation")
  1785→    .action(async (ref: string, acId: string, options) => {
  1786→      try {
  1787→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1788→        const existingAc = item.acceptance_criteria || [];
  1789→
  1790→        // Find the AC
  1791→        const acIndex = existingAc.findIndex((ac) => ac.id === acId);
  1792→        if (acIndex === -1) {
  1793→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1794→          error(errors.reference.acNotFound(acId, itemRef));
  1795→          process.exit(EXIT_CODES.NOT_FOUND);
  1796→        }
  1797→
  1798→        // Confirmation required unless --force
  1799→        if (!options.force) {
  1800→          // AC: @spec-item-delete-children ac-5 - JSON mode requires --force
  1801→          if (isJsonMode()) {
  1802→            error("Confirmation required. Use --force with --json");
  1803→            process.exit(EXIT_CODES.ERROR);
  1804→          }
  1805→
  1806→          // AC: @spec-item-delete-children ac-6 - Non-interactive environment requires --force
  1807→          // Allow KSPEC_TEST_TTY for testing interactive prompts
  1808→          const isTTY =
  1809→            process.env.KSPEC_TEST_TTY === "1" || process.stdin.isTTY;
  1810→          if (!isTTY) {
  1811→            error("Non-interactive environment. Use --force to proceed");
  1812→            process.exit(EXIT_CODES.ERROR);
  1813→          }
  1814→
  1815→          // AC: @spec-item-delete-children ac-1 - Prompt for confirmation
  1816→          const readline = await import("node:readline");
  1817→          const rl = readline.createInterface({
  1818→            input: process.stdin,
  1819→            output: process.stdout,
  1820→          });
  1821→
  1822→          const answer = await new Promise<string>((resolve) => {
  1823→            rl.question(`Remove acceptance criterion ${acId}? [y/N] `, resolve);
  1824→          });
  1825→          rl.close();
  1826→
  1827→          // AC: @spec-item-delete-children ac-3 - User declines (n, N, or empty)
  1828→          if (answer.toLowerCase() !== "y") {
  1829→            error("Operation cancelled");
  1830→            process.exit(EXIT_CODES.USAGE_ERROR);
  1831→          }
  1832→        }
  1833→
  1834→        // AC: @spec-item-delete-children ac-4 - With --force, proceed immediately without prompt
  1835→        // AC: @spec-item-delete-children ac-2 - User confirmed, proceed with removal
  1836→        const updatedAc = existingAc.filter((ac) => ac.id !== acId);
  1837→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1838→
  1839→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1840→        await commitIfShadow(ctx.shadow, "item-ac-remove", itemSlug);
  1841→        success(`Removed acceptance criterion: ${acId} from @${itemSlug}`, {
  1842→          removed: acId,
  1843→        });
  1844→      } catch (err) {
  1845→        error(errors.failures.removeAc, err);
  1846→        process.exit(EXIT_CODES.ERROR);
  1847→      }
  1848→    });
  1849→}
  1850→
  1851→// ─── Patch Helpers ───────────────────────────────────────────────────────────
  1852→
  1853→/**
  1854→ * Read stdin fully with timeout (for bulk input).
  1855→ * Returns null if stdin is a TTY or empty.
  1856→ */
  1857→async function readStdinFully(): Promise<string | null> {
  1858→  if (process.stdin.isTTY) {
  1859→    return null;
  1860→  }
  1861→
  1862→  return new Promise((resolve) => {
  1863→    let data = "";
  1864→    const timeout = setTimeout(() => {
  1865→      process.stdin.removeAllListeners();
  1866→      resolve(data || null);
  1867→    }, 5000); // 5 second timeout for bulk input
  1868→
  1869→    process.stdin.setEncoding("utf8");
  1870→    process.stdin.on("data", (chunk) => {
  1871→      data += chunk;
  1872→    });
  1873→    process.stdin.on("end", () => {
  1874→      clearTimeout(timeout);
  1875→      resolve(data || null);
  1876→    });
  1877→    process.stdin.on("error", () => {
  1878→      clearTimeout(timeout);
  1879→      resolve(null);
  1880→    });
  1881→    process.stdin.resume();
  1882→  });
  1883→}
  1884→
  1885→/**
  1886→ * Read stdin if available (non-blocking for single item mode).
  1887→ * Returns null quickly if no data available.
  1888→ */
  1889→async function readStdinIfAvailable(): Promise<string | null> {
  1890→  if (process.stdin.isTTY) {
  1891→    return null;
  1892→  }
  1893→
  1894→  return new Promise((resolve) => {
  1895→    let data = "";
  1896→    const timeout = setTimeout(() => {
  1897→      process.stdin.removeAllListeners();
  1898→      resolve(data || null);
  1899→    }, 100); // 100ms timeout for quick check
  1900→
  1901→    process.stdin.setEncoding("utf8");
  1902→    process.stdin.on("data", (chunk) => {
  1903→      data += chunk;
  1904→    });
  1905→    process.stdin.on("end", () => {
  1906→      clearTimeout(timeout);
  1907→      resolve(data || null);
  1908→    });
  1909→    process.stdin.on("error", () => {
  1910→      clearTimeout(timeout);
  1911→      resolve(null);
  1912→    });
  1913→    process.stdin.resume();
  1914→  });
  1915→}
  1916→
  1917→/**
  1918→ * Parse bulk input (JSONL or JSON array)
  1919→ */
  1920→function parseBulkInput(input: string): PatchOperation[] {
  1921→  const trimmed = input.trim();
  1922→
  1923→  // Try JSON array first
  1924→  if (trimmed.startsWith("[")) {
  1925→    const parsed = JSON.parse(trimmed);
  1926→    if (!Array.isArray(parsed)) {
  1927→      throw new Error(errors.validation.expectedJsonArray);
  1928→    }
  1929→    return parsed.map((item, i) => validatePatchOperation(item, i));
  1930→  }
  1931→
  1932→  // Parse as JSONL (one JSON object per line)
  1933→  const lines = trimmed.split("\n").filter((line) => line.trim());
  1934→  return lines.map((line, i) => {
  1935→    try {
  1936→      return validatePatchOperation(JSON.parse(line), i);
  1937→    } catch (err) {
  1938→      throw new Error(
  1939→        errors.validation.jsonLineError(
  1940→          i + 1,
  1941→          err instanceof Error ? err.message : "Invalid JSON",
  1942→        ),
  1943→      );
  1944→    }
  1945→  });
  1946→}
  1947→
  1948→/**
  1949→ * Validate a patch operation object
  1950→ */
  1951→function validatePatchOperation(obj: unknown, index: number): PatchOperation {
  1952→  if (!obj || typeof obj !== "object") {
  1953→    throw new Error(errors.validation.patchMustBeObject(index));
  1954→  }
  1955→  const op = obj as Record<string, unknown>;
  1956→  if (typeof op.ref !== "string" || !op.ref) {
  1957→    throw new Error(errors.validation.patchMustHaveRef(index));
  1958→  }
  1959→  if (!op.data || typeof op.data !== "object") {
  1960→    throw new Error(errors.validation.patchMustHaveData(index));
  1961→  }
  1962→  return { ref: op.ref, data: op.data as Record<string, unknown> };
  1963→}
  1964→
  1965→/**
  1966→ * Format bulk patch result for human output
  1967→ */
  1968→function formatBulkPatchResult(
  1969→  result: BulkPatchResult,
  1970→  isDryRun = false,
  1971→): void {
  1972→  const prefix = isDryRun ? "Would patch" : "Patched";
  1973→
  1974→  for (const r of result.results) {
  1975→    if (r.status === "updated") {
  1976→      console.log(
  1977→        chalk.green("OK"),
  1978→        `${prefix}: ${r.ref} (${r.ulid?.slice(0, 8)})`,
  1979→      );
  1980→    } else if (r.status === "error") {
  1981→      console.log(chalk.red("ERR"), `${r.ref}: ${r.error}`);
  1982→    } else {
  1983→      console.log(chalk.gray("SKIP"), r.ref);
  1984→    }
  1985→  }
  1986→
  1987→  console.log("");
  1988→  console.log(chalk.bold("Summary:"));
  1989→  console.log(`  Total: ${result.summary.total}`);
  1990→  console.log(chalk.green(`  Updated: ${result.summary.updated}`));
  1991→  if (result.summary.failed > 0) {
  1992→    console.log(chalk.red(`  Failed: ${result.summary.failed}`));
  1993→  }
  1994→  if (result.summary.skipped > 0) {
  1995→    console.log(chalk.gray(`  Skipped: ${result.summary.skipped}`));
  1996→  }
  1997→}
  1998→
```