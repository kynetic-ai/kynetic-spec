  1049→function formatSessionContext(
  1050→  ctx: SessionContext,
  1051→  options: SessionOptions,
  1052→): void {
  1053→  const isFull = !!options.full;
  1054→
  1055→  // AC: @cmd-session-start ac-slug-display, ac-slug-fallback
  1056→  // Display ref as @slug when available, @short-ulid when not
  1057→  const displayRef = (task: { ref: string; slug?: string | null }) =>
  1058→    task.slug ? `@${task.slug}` : `@${task.ref}`;
  1059→
  1060→  // Header
  1061→  console.log(`\n${sessionHeaders.title}`);
  1062→  const age = formatRelativeTime(new Date(ctx.generated_at));
  1063→  if (ctx.branch) {
  1064→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
  1065→  } else {
  1066→    console.log(chalk.gray(`Generated: ${age}`));
  1067→  }
  1068→
  1069→  // Stats summary
  1070→  const pendingReviewNote =
  1071→    ctx.stats.pending_review > 0
  1072→      ? `${ctx.stats.pending_review} awaiting review, `
  1073→      : "";
  1074→  const inboxNote =
  1075→    ctx.stats.inbox_items > 0 ? ` | Inbox: ${ctx.stats.inbox_items}` : "";
  1076→  console.log(
  1077→    chalk.gray(
  1078→      `Tasks: ${ctx.stats.in_progress} active, ${pendingReviewNote}${ctx.stats.ready} ready, ` +
  1079→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`,
  1080→    ),
  1081→  );
  1082→
  1083→  // Session context section (focus, threads, questions)
  1084→  if (
  1085→    ctx.context &&
  1086→    (ctx.context.focus ||
  1087→      ctx.context.threads.length > 0 ||
  1088→      ctx.context.open_questions.length > 0)
  1089→  ) {
  1090→    console.log("\n--- Session Context ---");
  1091→
  1092→    if (ctx.context.focus) {
  1093→      console.log(`  ${chalk.cyan("Focus:")} ${ctx.context.focus}`);
  1094→    }
  1095→
  1096→    if (ctx.context.threads.length > 0) {
  1097→      console.log(`  ${chalk.cyan("Active Threads:")}`);
  1098→      for (const thread of ctx.context.threads) {
  1099→        console.log(`    - ${thread}`);
  1100→      }
  1101→    }
  1102→
  1103→    if (ctx.context.open_questions.length > 0) {
  1104→      console.log(`  ${chalk.cyan("Open Questions:")}`);
  1105→      for (const question of ctx.context.open_questions) {
  1106→        console.log(`    - ${question}`);
  1107→      }
  1108→    }
  1109→  }
  1110→
  1111→  // ── Section ordering per AC: @cmd-session-start ac-section-order ──
  1112→  // active tasks → pending review → blocked → ready → recent activity → inbox → working tree → quick commands
  1113→  // AC: @cmd-session-start ac-empty-skip — empty sections omitted entirely
  1114→
  1115→  // ── Active tasks section ──
  1116→  // AC: @cmd-session-start ac-active-detail, ac-needs-work-indicator
  1117→  if (ctx.active_tasks.length > 0) {
  1118→    console.log(`\n${sessionHeaders.activeWork}`);
  1119→
  1120→    // Collect notes relevant to active tasks for inline display
  1121→    const activeTaskNotes = ctx.recent_notes.filter(
  1122→      (n) =>
  1123→        n.task_status === "in_progress" || n.task_status === "needs_work",
  1124→    );
  1125→
  1126→    for (const task of ctx.active_tasks) {
  1127→      const started = task.started_at
  1128→        ? chalk.gray(
  1129→            ` (started ${formatRelativeTime(new Date(task.started_at))})`,
  1130→          )
  1131→        : "";
  1132→      const priority =
  1133→        task.priority <= 2
  1134→          ? chalk.red(`P${task.priority}`)
  1135→          : chalk.gray(`P${task.priority}`);
  1136→
  1137→      // AC: @cmd-session-start ac-needs-work-indicator
  1138→      const statusLabel =
  1139→        task.status === "needs_work"
  1140→          ? chalk.red("[needs_work]")
  1141→          : chalk.blue("[in_progress]");
  1142→
  1143→      console.log(
  1144→        `  ${statusLabel} ${priority} ${displayRef(task)} ${task.title}${started}`,
  1145→      );
  1146→
  1147→      // AC: @cmd-session-start ac-active-detail — show description
  1148→      if (task.description) {
  1149→        console.log(chalk.gray(`    ${task.description}`));
  1150→      }
  1151→
  1152→      // AC: @cmd-session-start ac-active-detail — show recent notes inline
  1153→      const taskNotes = activeTaskNotes.filter(
  1154→        (n) => n.task_ref === task.ref,
  1155→      );
  1156→      if (taskNotes.length > 0) {
  1157→        const latestNote = taskNotes[0]; // already sorted most recent first
  1158→        const noteAge = formatRelativeTime(new Date(latestNote.created_at));
  1159→        const author = latestNote.author
  1160→          ? chalk.gray(` by ${latestNote.author}`)
  1161→          : "";
  1162→        console.log(`    ${chalk.yellow("Note")} ${chalk.gray(`(${noteAge}${author})`)}`);
  1163→
  1164→        let content = latestNote.content.trim();
  1165→        if (!isFull && content.length > 200) {
  1166→          content = `${content.slice(0, 200).trim()}...`;
  1167→        }
  1168→        const lines = content.split("\n");
  1169→        const maxLines = isFull ? lines.length : 3;
  1170→        for (const line of lines.slice(0, maxLines)) {
  1171→          console.log(`      ${chalk.white(line)}`);
  1172→        }
  1173→        if (!isFull && lines.length > maxLines) {
  1174→          console.log(
  1175→            chalk.gray(
  1176→              `      ... (${lines.length - maxLines} more lines)`,
  1177→            ),
  1178→          );
  1179→        }
  1180→      }
  1181→    }
  1182→  }
  1183→
  1184→  // ── Awaiting review section ──
  1185→  // AC: @cmd-session-start ac-review-detail
  1186→  if (ctx.pending_review_tasks.length > 0) {
  1187→    console.log(`\n${sessionHeaders.awaitingReview}`);
  1188→
  1189→    const reviewNotes = ctx.recent_notes.filter(
  1190→      (n) => n.task_status === "pending_review",
  1191→    );
  1192→
  1193→    for (const task of ctx.pending_review_tasks) {
  1194→      const priority =
  1195→        task.priority <= 2
  1196→          ? chalk.red(`P${task.priority}`)
  1197→          : chalk.gray(`P${task.priority}`);
  1198→      console.log(
  1199→        `  ${chalk.yellow("[pending_review]")} ${priority} ${displayRef(task)} ${task.title}`,
  1200→      );
  1201→
  1202→      // AC: @cmd-session-start ac-review-detail — show recent notes
  1203→      const taskNotes = reviewNotes.filter((n) => n.task_ref === task.ref);
  1204→      if (taskNotes.length > 0) {
  1205→        const latestNote = taskNotes[0];
  1206→        const noteAge = formatRelativeTime(new Date(latestNote.created_at));
  1207→        const author = latestNote.author
  1208→          ? chalk.gray(` by ${latestNote.author}`)
  1209→          : "";
  1210→        console.log(`    ${chalk.yellow("Note")} ${chalk.gray(`(${noteAge}${author})`)}`);
  1211→
  1212→        let content = latestNote.content.trim();
  1213→        if (!isFull && content.length > 200) {
  1214→          content = `${content.slice(0, 200).trim()}...`;
  1215→        }
  1216→        const lines = content.split("\n");
  1217→        const maxLines = isFull ? lines.length : 3;
  1218→        for (const line of lines.slice(0, maxLines)) {
  1219→          console.log(`      ${chalk.white(line)}`);
  1220→        }
  1221→        if (!isFull && lines.length > maxLines) {
  1222→          console.log(
  1223→            chalk.gray(
  1224→              `      ... (${lines.length - maxLines} more lines)`,
  1225→            ),
  1226→          );
  1227→        }
  1228→      }
  1229→    }
  1230→  }
  1231→
  1232→  // ── Blocked tasks section ──
  1233→  if (ctx.blocked_tasks.length > 0) {
  1234→    console.log(`\n${sessionHeaders.blocked}`);
  1235→    for (const task of ctx.blocked_tasks) {
  1236→      const unlocks =
  1237→        task.unlocks > 0 ? chalk.green(` unlocks ${task.unlocks}`) : "";
  1238→      console.log(
  1239→        `  ${chalk.red("[blocked]")} ${displayRef(task)} ${task.title}${unlocks}`,
  1240→      );
  1241→      if (task.blocked_by.length > 0) {
  1242→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(", ")}`));
  1243→      }
  1244→      if (task.unmet_deps.length > 0) {
  1245→        console.log(
  1246→          chalk.gray(`    Waiting on: ${task.unmet_deps.join(", ")}`),
  1247→        );
  1248→      }
  1249→    }
  1250→  }
  1251→
  1252→  // ── Ready tasks section ──
  1253→  if (ctx.ready_tasks.length > 0) {
  1254→    console.log(`\n${sessionHeaders.readyTasks}`);
  1255→    for (const task of ctx.ready_tasks) {
  1256→      const priority =
  1257→        task.priority <= 2
  1258→          ? chalk.red(`P${task.priority}`)
  1259→          : chalk.gray(`P${task.priority}`);
  1260→      const tags =
  1261→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(" #")}`) : "";
  1262→      const unlocks =
  1263→        task.unlocks > 0 ? chalk.green(` unlocks ${task.unlocks}`) : "";
  1264→      console.log(
  1265→        `  ${priority} ${displayRef(task)} ${task.title}${unlocks}${tags}`,
  1266→      );
  1267→    }
  1268→  }
  1269→
  1270→  // ── Recent Activity timeline ──
  1271→  // AC: @session-start-activity-timeline ac-activity-merge
  1272→  if (ctx.activity_timeline.length > 0) {
  1273→    console.log(`\n${sessionHeaders.recentActivity}`);
  1274→    const observationPromotedTasks: string[] = [];
  1275→    for (const item of ctx.activity_timeline) {
  1276→      // AC: @cmd-session-start ac-relative-time-human
  1277→      const itemAge = formatRelativeTime(new Date(item.date));
  1278→      if (item.type === "task_completion") {
  1279→        let reason = "";
  1280→        if (item.task.closed_reason) {
  1281→          const maxLen = isFull ? 120 : 60;
  1282→          const truncated =
  1283→            item.task.closed_reason.length > maxLen
  1284→              ? `${item.task.closed_reason.slice(0, maxLen).trim()}...`
  1285→              : item.task.closed_reason;
  1286→          reason = chalk.gray(` - ${truncated}`);
  1287→        }
  1288→        // AC: @cmd-session-start ac-slug-display
  1289→        const taskDisplay = item.task.slug
  1290→          ? `@${item.task.slug}`
  1291→          : `@${item.task.ref}`;
  1292→        console.log(
  1293→          `  ${chalk.green("[completed]")} ${taskDisplay} ${item.task.title} ${chalk.gray(`(${itemAge})`)}${reason}`,
  1294→        );
  1295→        if (item.task.origin === "observation_promotion") {
  1296→          observationPromotedTasks.push(taskDisplay);
  1297→        }
  1298→      } else if (item.type === "commit") {
  1299→        console.log(
  1300→          `  ${chalk.yellow(item.commit.hash)} ${item.commit.message} ${chalk.gray(`(${itemAge}, ${item.commit.author})`)}`,
  1301→        );
  1302→      } else if (item.type === "linked_commit") {
  1303→        // AC: @session-start-activity-timeline ac-activity-dedup, ac-activity-trailer-link
  1304→        const taskDisplay = item.task.slug
  1305→          ? `@${item.task.slug}`
  1306→          : `@${item.task.ref}`;
  1307→        console.log(
  1308→          `  ${chalk.yellow(item.commit.hash)} ${item.commit.message} ${chalk.gray(`(${itemAge}, ${item.commit.author})`)} ${chalk.green(`→ ${taskDisplay} ${item.task.title}`)}`,
  1309→        );
  1310→        if (item.task.origin === "observation_promotion") {
  1311→          observationPromotedTasks.push(taskDisplay);
  1312→        }
  1313→      }
  1314→    }
  1315→
  1316→    // Show reminder about resolving observations
  1317→    if (observationPromotedTasks.length > 0) {
  1318→      console.log(
  1319→        chalk.yellow(
  1320→          `\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(", ")}`,
  1321→        ),
  1322→      );
  1323→      console.log(
  1324→        chalk.gray(`    Run: kspec meta observations --pending-resolution`),
  1325→      );
  1326→    }
  1327→  }
  1328→
  1329→  // ── Inbox section ──
  1330→  // AC: @session-start-inbox-triage ac-inbox-stat-line, ac-inbox-full-list, ac-inbox-all-triaged
  1331→  if (ctx.inbox_stats.total > 0) {
  1332→    console.log(`\n${sessionHeaders.inbox}`);
  1333→    // Stat line always shown (primer and full)
  1334→    const statParts = [
  1335→      `${ctx.inbox_stats.untriaged} untriaged`,
  1336→      `${ctx.inbox_stats.deferred} deferred`,
  1337→      `${ctx.inbox_stats.total} total`,
  1338→    ];
  1339→    console.log(`  ${statParts.join(" | ")}`);
  1340→
  1341→    // AC: @cmd-session-start ac-full-sections, @session-start-inbox-triage ac-inbox-full-list
  1342→    // Full mode: list untriaged items (up to 20)
  1343→    // AC: @cmd-session-start ac-slug-fallback — inbox uses @short-ulid
  1344→    const untriagedItems = ctx.inbox_items
  1345→      .filter((i) => !i.triaged)
  1346→      .slice(0, 20);
  1347→    if (isFull && untriagedItems.length > 0) {
  1348→      console.log("");
  1349→      for (const item of untriagedItems) {
  1350→        const itemAge = formatRelativeTime(new Date(item.created_at));
  1351→        const author = item.added_by ? ` by ${item.added_by}` : "";
  1352→        const tags =
  1353→          item.tags.length > 0
  1354→            ? chalk.cyan(` [${item.tags.join(", ")}]`)
  1355→            : "";
  1356→        console.log(
  1357→          `  ${chalk.magenta(`@${item.ref}`)} ${chalk.gray(`(${itemAge}${author})`)}${tags}`,
  1358→        );
  1359→        console.log(`    ${item.text}`);
  1360→      }
  1361→    }
  1362→    if (ctx.inbox_stats.untriaged > 0) {
  1363→      console.log(`  ${hints.inboxTriage}`);
  1364→    }
  1365→  }
  1366→
  1367→  // ── Working tree section ──
  1368→  // AC: @cmd-session-start ac-dirty-tree-only — only shown when dirty
  1369→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1370→    console.log(`\n${sessionHeaders.workingTree}`);
  1371→
  1372→    if (ctx.working_tree.staged.length > 0) {
  1373→      console.log(chalk.green("  Staged:"));
  1374→      for (const file of ctx.working_tree.staged) {
  1375→        console.log(
  1376→          `    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`,
  1377→        );
  1378→      }
  1379→    }
  1380→
  1381→    if (ctx.working_tree.unstaged.length > 0) {
  1382→      console.log(chalk.red("  Modified:"));
  1383→      for (const file of ctx.working_tree.unstaged) {
  1384→        console.log(
  1385→          `    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`,
  1386→        );
  1387→      }
  1388→    }
  1389→
  1390→    if (ctx.working_tree.untracked.length > 0) {
  1391→      console.log(chalk.gray("  Untracked:"));
  1392→      const untrackedLimit = isFull
  1393→        ? ctx.working_tree.untracked.length
  1394→        : 5;
  1395→      for (const filePath of ctx.working_tree.untracked.slice(
  1396→        0,
  1397→        untrackedLimit,
  1398→      )) {
  1399→        console.log(`    ${chalk.gray("?")} ${filePath}`);
  1400→      }
  1401→      if (!isFull && ctx.working_tree.untracked.length > untrackedLimit) {
  1402→        console.log(
  1403→          chalk.gray(
  1404→            `    ... and ${ctx.working_tree.untracked.length - untrackedLimit} more`,
  1405→          ),
  1406→        );
  1407→      }
  1408→    }
  1409→  }
  1410→
  1411→  // ── Quick Commands section ──
  1412→  const quickCommands: string[] = [];
  1413→
  1414→  if (ctx.active_tasks.length > 0) {
  1415→    const ref = displayRef(ctx.active_tasks[0]);
  1416→    quickCommands.push(
  1417→      `kspec task note ${ref} "Progress..."  ${chalk.gray("# document work")}`,
  1418→    );
  1419→    quickCommands.push(
  1420→      `kspec task complete ${ref} --reason "..."  ${chalk.gray("# finish task")}`,
  1421→    );
  1422→  } else if (ctx.ready_tasks.length > 0) {
  1423→    const ref = displayRef(ctx.ready_tasks[0]);
  1424→    quickCommands.push(
  1425→      `kspec task start ${ref}  ${chalk.gray("# begin work")}`,
  1426→    );
  1427→  }
  1428→
  1429→  if (ctx.inbox_stats.untriaged > 0) {
  1430→    quickCommands.push(
  1431→      `kspec triage inbox  ${chalk.gray("# triage untriaged inbox items")}`,
  1432→    );
  1433→  }
  1434→
  1435→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1436→    quickCommands.push(
  1437→      `git add . && git commit -m "..."  ${chalk.gray("# commit changes")}`,
  1438→    );
  1439→  }
  1440→
  1441→  if (quickCommands.length > 0) {
  1442→    console.log(`\n${sessionHeaders.quickCommands}`);
  1443→    for (const hint of quickCommands) {
  1444→      console.log(`  ${hint}`);
  1445→    }
  1446→  }
  1447→
  1448→  console.log(""); // Final newline