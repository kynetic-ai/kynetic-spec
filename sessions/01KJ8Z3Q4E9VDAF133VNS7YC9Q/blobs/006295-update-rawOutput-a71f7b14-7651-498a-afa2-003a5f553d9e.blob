     1→/**
     2→ * Tests for session start activity timeline
     3→ *
     4→ * AC: @session-start-activity-timeline ac-activity-merge
     5→ * AC: @session-start-activity-timeline ac-activity-trailer-link
     6→ * AC: @session-start-activity-timeline ac-activity-sort
     7→ * AC: @session-start-activity-timeline ac-activity-dedup
     8→ * AC: @session-start-activity-timeline ac-activity-no-git
     9→ */
    10→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
    11→import { kspec, kspecJson, setupTempFixtures, cleanupTempDir, initGitRepo, git } from '../helpers/cli';
    12→import { writeFileSync } from 'node:fs';
    13→import { join } from 'node:path';
    14→
    15→interface CommitSummary {
    16→  hash: string;
    17→  full_hash: string;
    18→  date: string;
    19→  message: string;
    20→  author: string;
    21→  task_refs: string[];
    22→}
    23→
    24→interface CompletedTaskSummary {
    25→  ref: string;
    26→  title: string;
    27→  completed_at: string;
    28→  closed_reason: string | null;
    29→}
    30→
    31→interface ActivityItem {
    32→  type: 'task_completion' | 'commit' | 'linked_commit';
    33→  date: string;
    34→  commit?: CommitSummary;
    35→  task?: CompletedTaskSummary;
    36→}
    37→
    38→interface SessionContext {
    39→  recently_completed: CompletedTaskSummary[];
    40→  recent_commits: CommitSummary[];
    41→  activity_timeline: ActivityItem[];
    42→}
    43→
    44→describe('session start activity timeline', () => {
    45→  let tempDir: string;
    46→
    47→  beforeEach(async () => {
    48→    tempDir = await setupTempFixtures();
    49→    initGitRepo(tempDir);
    50→    // Initial commit so git log works
    51→    writeFileSync(join(tempDir, 'README.md'), '# Test\n');
    52→    git('add .', tempDir);
    53→    git('commit -m "initial commit"', tempDir);
    54→  });
    55→
    56→  afterEach(async () => {
    57→    await cleanupTempDir(tempDir);
    58→  });
    59→
    60→  // AC: @session-start-activity-timeline ac-activity-merge
    61→  describe('activity merge (ac-activity-merge)', () => {
    62→    it('should include both completed tasks and commits in a single timeline', () => {
    63→      // Create and complete a task
    64→      kspec('task add --title "Feature alpha" --slug task-alpha', tempDir);
    65→      kspec('task start @task-alpha', tempDir);
    66→      kspec('task submit @task-alpha', tempDir);
    67→      kspec('task complete @task-alpha --reason "Shipped alpha"', tempDir);
    68→
    69→      // Create a git commit (not linked to any task)
    70→      writeFileSync(join(tempDir, 'feature.ts'), 'export const x = 1;\n');
    71→      git('add feature.ts', tempDir);
    72→      git('commit -m "feat: add feature file"', tempDir);
    73→
    74→      const session = kspecJson<SessionContext>('session start --json', tempDir);
    75→
    76→      // activity_timeline should contain entries from both sources
    77→      expect(session.activity_timeline.length).toBeGreaterThanOrEqual(2);
    78→
    79→      const taskEntries = session.activity_timeline.filter(
    80→        (i) => i.type === 'task_completion',
    81→      );
    82→      const commitEntries = session.activity_timeline.filter(
    83→        (i) => i.type === 'commit',
    84→      );
    85→
    86→      expect(taskEntries.length).toBeGreaterThanOrEqual(1);
    87→      expect(commitEntries.length).toBeGreaterThanOrEqual(1);
    88→    });
    89→
    90→    it('should show Recent Activity header in human output instead of separate sections', () => {
    91→      // Create and complete a task
    92→      kspec('task add --title "Feature beta" --slug task-beta', tempDir);
    93→      kspec('task start @task-beta', tempDir);
    94→      kspec('task submit @task-beta', tempDir);
    95→      kspec('task complete @task-beta --reason "Shipped beta"', tempDir);
    96→
    97→      // Create a git commit
    98→      writeFileSync(join(tempDir, 'beta.ts'), 'export const beta = 1;\n');
    99→      git('add beta.ts', tempDir);
   100→      git('commit -m "feat: add beta"', tempDir);
   101→
   102→      const result = kspec('session start', tempDir);
   103→
   104→      // Should have unified "Recent Activity" section
   105→      expect(result.stdout).toContain('Recent Activity');
   106→
   107→      // Should NOT have separate "Recent Commits" section
   108→      // (the section header text is "--- Recent Commits ---")
   109→      expect(result.stdout).not.toContain('Recent Commits ---');
   110→    });
   111→
   112→    it('should preserve raw recently_completed and recent_commits arrays in JSON', () => {
   113→      // Create and complete a task
   114→      kspec('task add --title "Raw check" --slug task-raw', tempDir);
   115→      kspec('task start @task-raw', tempDir);
   116→      kspec('task submit @task-raw', tempDir);
   117→      kspec('task complete @task-raw --reason "Done"', tempDir);
   118→
   119→      // Create a commit
   120→      writeFileSync(join(tempDir, 'raw.ts'), 'export const raw = 1;\n');
   121→      git('add raw.ts', tempDir);
   122→      git('commit -m "feat: raw check"', tempDir);
   123→
   124→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   125→
   126→      // Raw arrays should still be present
   127→      expect(session.recently_completed).toBeDefined();
   128→      expect(session.recently_completed.length).toBeGreaterThanOrEqual(1);
   129→      expect(session.recent_commits).toBeDefined();
   130→      expect(session.recent_commits.length).toBeGreaterThanOrEqual(1);
   131→
   132→      // Plus the unified timeline
   133→      expect(session.activity_timeline).toBeDefined();
   134→      expect(session.activity_timeline.length).toBeGreaterThanOrEqual(2);
   135→    });
   136→  });
   137→
   138→  // AC: @session-start-activity-timeline ac-activity-trailer-link
   139→  describe('trailer linking (ac-activity-trailer-link)', () => {
   140→    it('should show linked task info when commit has Task: @slug trailer', () => {
   141→      // Create and complete a task
   142→      kspec('task add --title "Linked feature" --slug task-linked', tempDir);
   143→      kspec('task start @task-linked', tempDir);
   144→      kspec('task submit @task-linked', tempDir);
   145→      kspec('task complete @task-linked --reason "All done"', tempDir);
   146→
   147→      // Create a commit with a Task: trailer using the task slug (convention)
   148→      writeFileSync(join(tempDir, 'linked.ts'), 'export const linked = 1;\n');
   149→      git('add linked.ts', tempDir);
   150→      git('commit -m "feat: implement linked feature" -m "Task: @task-linked"', tempDir);
   151→
   152→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   153→
   154→      // Should have a linked_commit entry
   155→      const linkedEntries = session.activity_timeline.filter(
   156→        (i) => i.type === 'linked_commit',
   157→      );
   158→      expect(linkedEntries.length).toBe(1);
   159→      expect(linkedEntries[0].commit!.task_refs).toContain('task-linked');
   160→      expect(linkedEntries[0].task!.title).toBe('Linked feature');
   161→    });
   162→
   163→    it('should show linked task info in human output', () => {
   164→      kspec('task add --title "Human linked" --slug task-human-linked', tempDir);
   165→      kspec('task start @task-human-linked', tempDir);
   166→      kspec('task submit @task-human-linked', tempDir);
   167→      kspec('task complete @task-human-linked --reason "Done"', tempDir);
   168→
   169→      writeFileSync(join(tempDir, 'hl.ts'), 'export const hl = 1;\n');
   170→      git('add hl.ts', tempDir);
   171→      git('commit -m "feat: human linked feature" -m "Task: @task-human-linked"', tempDir);
   172→
   173→      const result = kspec('session start', tempDir);
   174→
   175→      // Human output should show commit → task link
   176→      expect(result.stdout).toContain('Human linked');
   177→      expect(result.stdout).toContain('human linked feature');
   178→    });
   179→
   180→    it('should include task_refs in commit summary JSON', () => {
   181→      writeFileSync(join(tempDir, 'refcheck.ts'), 'export const rc = 1;\n');
   182→      git('add refcheck.ts', tempDir);
   183→      git('commit -m "feat: ref check commit" -m "Task: @task-ref-check"', tempDir);
   184→
   185→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   186→
   187→      const commit = session.recent_commits.find((c) =>
   188→        c.message.includes('ref check commit'),
   189→      );
   190→      expect(commit).toBeDefined();
   191→      expect(commit!.task_refs).toContain('task-ref-check');
   192→    });
   193→  });
   194→
   195→  // AC: @session-start-activity-timeline ac-activity-sort
   196→  describe('chronological sort (ac-activity-sort)', () => {
   197→    it('should sort timeline items most recent first', { timeout: 15000 }, () => {
   198→      // Create a task completed "earlier"
   199→      kspec('task add --title "Earlier task" --slug task-earlier', tempDir);
   200→      kspec('task start @task-earlier', tempDir);
   201→      kspec('task submit @task-earlier', tempDir);
   202→      kspec('task complete @task-earlier --reason "Done first"', tempDir);
   203→
   204→      // Create a commit with a future date to guarantee different timestamps
   205→      // Git --date flag sets the author date, ensuring it sorts after the task completion
   206→      writeFileSync(join(tempDir, 'later.ts'), 'export const later = 1;\n');
   207→      git('add later.ts', tempDir);
   208→      git('commit -m "feat: later commit" --date="2099-01-01T00:00:00Z"', tempDir);
   209→
   210→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   211→
   212→      // Should have at least 2 items (task + commit)
   213→      expect(session.activity_timeline.length).toBeGreaterThanOrEqual(2);
   214→
   215→      // Verify sorted most recent first
   216→      for (let i = 1; i < session.activity_timeline.length; i++) {
   217→        const prevDate = new Date(session.activity_timeline[i - 1].date).getTime();
   218→        const currDate = new Date(session.activity_timeline[i].date).getTime();
   219→        expect(prevDate).toBeGreaterThanOrEqual(currDate);
   220→      }
   221→
   222→      // The commit with future date should be first
   223→      expect(session.activity_timeline[0].type).toBe('commit');
   224→      expect(session.activity_timeline[0].commit!.message).toBe('feat: later commit');
   225→    });
   226→  });
   227→
   228→  // AC: @session-start-activity-timeline ac-activity-dedup
   229→  describe('deduplication (ac-activity-dedup)', () => {
   230→    it('should show linked commit+task as single combined entry, not two separate entries', () => {
   231→      kspec('task add --title "Dedup task" --slug task-dedup', tempDir);
   232→      kspec('task start @task-dedup', tempDir);
   233→      kspec('task submit @task-dedup', tempDir);
   234→      kspec('task complete @task-dedup --reason "Dedup done"', tempDir);
   235→
   236→      writeFileSync(join(tempDir, 'dedup.ts'), 'export const dedup = 1;\n');
   237→      git('add dedup.ts', tempDir);
   238→      git('commit -m "feat: dedup feature" -m "Task: @task-dedup"', tempDir);
   239→
   240→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   241→
   242→      // Should have exactly one linked_commit entry for this task
   243→      const linkedEntries = session.activity_timeline.filter(
   244→        (i) => i.type === 'linked_commit' && i.task?.title === 'Dedup task',
   245→      );
   246→      expect(linkedEntries.length).toBe(1);
   247→
   248→      // The task should NOT appear as a separate task_completion entry
   249→      const taskOnlyEntries = session.activity_timeline.filter(
   250→        (i) => i.type === 'task_completion' && i.task?.title === 'Dedup task',
   251→      );
   252→      expect(taskOnlyEntries.length).toBe(0);
   253→
   254→      // The commit should NOT appear as a separate commit entry
   255→      const commitOnlyEntries = session.activity_timeline.filter(
   256→        (i) => i.type === 'commit' && i.commit?.message === 'feat: dedup feature',
   257→      );
   258→      expect(commitOnlyEntries.length).toBe(0);
   259→    });
   260→
   261→    it('should show unlinked commit and unlinked task as separate entries', () => {
   262→      // Complete a task (no commit linked)
   263→      kspec('task add --title "Standalone task" --slug task-standalone', tempDir);
   264→      kspec('task start @task-standalone', tempDir);
   265→      kspec('task submit @task-standalone', tempDir);
   266→      kspec('task complete @task-standalone --reason "Done alone"', tempDir);
   267→
   268→      // Create unlinked commit
   269→      writeFileSync(join(tempDir, 'standalone.ts'), 'export const x = 1;\n');
   270→      git('add standalone.ts', tempDir);
   271→      git('commit -m "chore: standalone commit"', tempDir);
   272→
   273→      const session = kspecJson<SessionContext>('session start --json', tempDir);
   274→
   275→      // Each should appear as its own type
   276→      const taskEntries = session.activity_timeline.filter(
   277→        (i) => i.type === 'task_completion' && i.task?.title === 'Standalone task',
   278→      );
   279→      expect(taskEntries.length).toBe(1);
   280→
   281→      const commitEntries = session.activity_timeline.filter(
   282→        (i) => i.type === 'commit' && i.commit?.message === 'chore: standalone commit',
   283→      );
   284→      expect(commitEntries.length).toBe(1);
   285→    });
   286→  });
   287→
   288→  // AC: @session-start-activity-timeline ac-activity-no-git
   289→  describe('--no-git flag (ac-activity-no-git)', () => {
   290→    it('should only show task completions when --no-git is passed', () => {
   291→      // Create and complete a task
   292→      kspec('task add --title "No-git task" --slug task-no-git', tempDir);
   293→      kspec('task start @task-no-git', tempDir);
   294→      kspec('task submit @task-no-git', tempDir);
   295→      kspec('task complete @task-no-git --reason "Done without git"', tempDir);
   296→
   297→      // Create a commit
   298→      writeFileSync(join(tempDir, 'nogit.ts'), 'export const x = 1;\n');
   299→      git('add nogit.ts', tempDir);
   300→      git('commit -m "feat: should not appear"', tempDir);
   301→
   302→      const session = kspecJson<SessionContext>('session start --json --no-git', tempDir);
   303→
   304→      // Timeline should only contain task_completion entries
   305→      expect(session.activity_timeline.length).toBeGreaterThanOrEqual(1);
   306→      for (const item of session.activity_timeline) {
   307→        expect(item.type).toBe('task_completion');
   308→      }
   309→
   310→      // recent_commits should be empty
   311→      expect(session.recent_commits).toHaveLength(0);
   312→    });
   313→
   314→    it('should not show commit entries in human output with --no-git', () => {
   315→      kspec('task add --title "Visible task" --slug task-visible', tempDir);
   316→      kspec('task start @task-visible', tempDir);
   317→      kspec('task submit @task-visible', tempDir);
   318→      kspec('task complete @task-visible --reason "Visible"', tempDir);
   319→
   320→      writeFileSync(join(tempDir, 'hidden.ts'), 'export const x = 1;\n');
   321→      git('add hidden.ts', tempDir);
   322→      git('commit -m "feat: invisible commit"', tempDir);
   323→
   324→      const result = kspec('session start --no-git', tempDir);
   325→
   326→      // Task should be visible
   327→      expect(result.stdout).toContain('Visible task');
   328→      // Commit should not be visible
   329→      expect(result.stdout).not.toContain('invisible commit');
   330→    });
   331→  });
   332→});
   333→