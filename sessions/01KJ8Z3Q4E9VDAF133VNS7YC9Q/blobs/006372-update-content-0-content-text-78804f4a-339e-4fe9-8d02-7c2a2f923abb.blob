   500→ * Build a unified activity timeline from completed tasks and git commits.
   501→ *
   502→ * - Commits with Task: @slug trailers are matched to completed tasks and shown
   503→ *   as combined "linked_commit" entries (AC: ac-activity-trailer-link, ac-activity-dedup)
   504→ * - Unlinked commits appear as standalone "commit" entries
   505→ * - Tasks not linked to any commit appear as standalone "task_completion" entries
   506→ * - All items sorted most recent first (AC: ac-activity-sort)
   507→ *
   508→ * @param completedTasks - Completed task summaries
   509→ * @param commits - Recent commit summaries (with task_refs parsed from trailers)
   510→ * @param taskRefResolver - Maps a trailer ref (slug or ULID prefix) to a completed task's ref (short ULID)
   511→ */
   512→function buildActivityTimeline(
   513→  completedTasks: CompletedTaskSummary[],
   514→  commits: CommitSummary[],
   515→  taskRefResolver: Map<string, string>,
   516→): ActivityItem[] {
   517→  const items: ActivityItem[] = [];
   518→
   519→  // Build lookup from short ULID ref to CompletedTaskSummary
   520→  const taskByRef = new Map<string, CompletedTaskSummary>();
   521→  for (const task of completedTasks) {
   522→    taskByRef.set(task.ref, task);
   523→  }
   524→
   525→  // Track which tasks have been linked to a commit (for dedup)
   526→  const linkedTaskRefs = new Set<string>();
   527→
   528→  for (const commit of commits) {
   529→    if (commit.task_refs.length > 0) {
   530→      let linkedTask: CompletedTaskSummary | undefined;
   531→      for (const trailerRef of commit.task_refs) {
   532→        // Resolve the trailer ref (slug or ULID) to the short ULID ref
   533→        const resolvedRef = taskRefResolver.get(trailerRef);
   534→        if (resolvedRef) {
   535→          linkedTask = taskByRef.get(resolvedRef);
   536→        }
   537→        // Also try direct match on short ULID ref
   538→        if (!linkedTask) {
   539→          linkedTask = taskByRef.get(trailerRef);
   540→        }
   541→        if (linkedTask) {
   542→          linkedTaskRefs.add(linkedTask.ref);
   543→          // Use the later of commit date and task completion date for sort accuracy
   544→          const commitTime = new Date(commit.date).getTime();
   545→          const taskTime = new Date(linkedTask.completed_at).getTime();
   546→          const laterDate =
   547→            taskTime > commitTime ? linkedTask.completed_at : commit.date;
   548→          items.push({
   549→            type: "linked_commit",
   550→            date: laterDate,
   551→            commit,
   552→            task: linkedTask,
   553→          });
   554→          break; // One linked entry per commit
   555→        }
   556→      }
   557→      if (!linkedTask) {
   558→        // Task ref in trailer but no matching completed task found
   559→        items.push({ type: "commit", date: commit.date, commit });
   560→      }
   561→    } else {
   562→      items.push({ type: "commit", date: commit.date, commit });
   563→    }
   564→  }
   565→
   566→  // Add task completions not already linked to a commit
   567→  for (const task of completedTasks) {
   568→    if (!linkedTaskRefs.has(task.ref)) {
   569→      items.push({
   570→        type: "task_completion",
   571→        date: task.completed_at,
   572→        task,
   573→      });
   574→    }
   575→  }
   576→
   577→  // AC: @session-start-activity-timeline ac-activity-sort
   578→  // Sort most recent first
   579→  items.sort(
   580→    (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
   581→  );
   582→
   583→  return items;
   584→}
   585→
   586→/**
   587→ * Gather session context data
   588→ */
   589→export async function gatherSessionContext(
   590→  ctx: KspecContext,
   591→  options: SessionOptions,
   592→): Promise<SessionContext> {
   593→  const limit = parseInt(options.limit || "10", 10);
   594→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   595→  const showGit = options.git !== false; // default true
   596→
   597→  // Load all data
   598→  const allTasks = await loadAllTasks(ctx);
   599→  const items = await loadAllItems(ctx);
   600→  const inboxItems = await loadInboxItems(ctx);
   601→  const triageRecords = await loadTriageRecords(ctx);
   602→  const index = new ReferenceIndex(allTasks, items);
   603→
   604→  // AC: @session-start-inbox-triage ac-inbox-untriaged-def
   605→  // Build lookup: inbox ULID → triage record (most recent if multiple)
   606→  const triageByInboxRef = new Map<string, { action?: string }>();
   607→  for (const record of triageRecords) {
   608→    triageByInboxRef.set(record.inbox_ref, { action: record.action });
   609→  }
   610→
   611→  // Compute stats
   612→  const stats: SessionStats = {
   613→    total_tasks: allTasks.length,
   614→    in_progress: allTasks.filter((t) => t.status === "in_progress").length,
   615→    needs_work: allTasks.filter((t) => t.status === "needs_work").length,
   616→    pending_review: allTasks.filter((t) => t.status === "pending_review")
   617→      .length,
   618→    ready: getReadyTasks(allTasks).length,
   619→    blocked: allTasks.filter((t) => t.status === "blocked").length,
   620→    completed: allTasks.filter((t) => t.status === "completed").length,
   621→    inbox_items: inboxItems.length,
   622→  };
   623→
   624→  // Get active tasks (in_progress + needs_work, optionally filtered to automation-eligible only)
   625→  // AC: @cli-ralph ac-16
   626→  const activeTasks = allTasks
   627→    .filter((t) => t.status === "in_progress" || t.status === "needs_work")
   628→    .filter((t) => !options.eligible || t.automation === "eligible")
   629→    .sort((a, b) => a.priority - b.priority)
   630→    .slice(0, options.full ? undefined : limit)
   631→    .map((t) => toActiveTaskSummary(t, index));
   632→
   633→  // Get pending review tasks
   634→  const pendingReviewTasks = allTasks
   635→    .filter((t) => t.status === "pending_review")
   636→    .sort((a, b) => a.priority - b.priority)
   637→    .slice(0, options.full ? undefined : limit)
   638→    .map((t) => toActiveTaskSummary(t, index));
   639→
   640→  // Get recent notes from active, pending_review, and recently completed tasks
   641→  // AC: @cmd-session-start ac-1, ac-2
   642→  // Collect notes per-status first to prevent one status from starving others
   643→  const noteLimitPerStatus = options.full ? limit : Math.ceil(limit / 3);
   644→
   645→  const inProgressNotes = collectRecentNotes(
   646→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   647→    index,
   648→    { limit: noteLimitPerStatus, since: sinceDate },
   649→  );
   650→
   651→  const pendingReviewNotes = collectRecentNotes(
   652→    allTasks.filter((t) => t.status === "pending_review"),
   653→    index,
   654→    { limit: noteLimitPerStatus, since: sinceDate },
   655→  );
   656→
   657→  const recentlyCompletedForNotes = allTasks
   658→    .filter((t) => t.status === "completed" && t.completed_at)
   659→    .sort((a, b) => {
   660→      const aDate = new Date(a.completed_at || 0);
   661→      const bDate = new Date(b.completed_at || 0);
   662→      return bDate.getTime() - aDate.getTime();
   663→    })
   664→    .slice(0, 5); // Last 3-5 completed tasks per AC-2
   665→
   666→  const completedNotes = collectRecentNotes(
   667→    recentlyCompletedForNotes,
   668→    index,
   669→    { limit: noteLimitPerStatus, since: sinceDate },
   670→  );
   671→
   672→  // Combine notes from all statuses, preserving representation from each
   673→  const recentNotes = [...inProgressNotes, ...pendingReviewNotes, ...completedNotes]
   674→    .sort(
   675→      (a, b) =>
   676→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   677→    );
   678→
   679→  // Get incomplete todos from active tasks
   680→  const activeTodos = collectIncompleteTodos(
   681→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   682→    index,
   683→    { limit: options.full ? limit * 2 : limit },
   684→  );
   685→
   686→  // Compute reverse dependency map for "unlocks N" annotations
   687→  const unlocksMap = computeUnlocksMap(allTasks, index);
   688→
   689→  // AC: @cmd-session-start ac-primer-default, ac-full-sections
   690→  // Primer: top 5 ready tasks; Full: all ready tasks
   691→  // Respect --limit as upper bound when provided
   692→  const readyLimit = options.full ? undefined : Math.min(limit, 5);
   693→  const readyTasks = getReadyTasks(allTasks)
   694→    .filter((t) => !options.eligible || t.automation === "eligible")
   695→    .slice(0, readyLimit)
   696→    .map((t) => toReadyTaskSummary(t, index, unlocksMap));
   697→
   698→  // Get blocked tasks
   699→  const blockedTasks = allTasks
   700→    .filter((t) => t.status === "blocked")
   701→    .slice(0, options.full ? undefined : limit)
   702→    .map((t) => toBlockedTaskSummary(t, allTasks, index, unlocksMap));
   703→
   704→  // Get recently completed tasks
   705→  const recentlyCompleted = allTasks
   706→    .filter((t) => {
   707→      if (t.status !== "completed" || !t.completed_at) return false;
   708→      const completedDate = new Date(t.completed_at);
   709→      if (sinceDate && completedDate < sinceDate) return false;
   710→      return true;
   711→    })
   712→    .sort((a, b) => {
   713→      // Sort by completed_at descending (most recent first)
   714→      const aDate = new Date(a.completed_at || 0);
   715→      const bDate = new Date(b.completed_at || 0);
   716→      return bDate.getTime() - aDate.getTime();
   717→    })
   718→    .slice(0, options.full ? undefined : limit)
   719→    .map((t) => toCompletedTaskSummary(t, index));
   720→
   721→  // Get git info
   722→  let branch: string | null = null;
   723→  let recentCommits: CommitSummary[] = [];
   724→  let workingTree: GitWorkingTree | null = null;
   725→
   726→  if (showGit && isGitRepo(ctx.rootDir)) {
   727→    branch = getCurrentBranch(ctx.rootDir);
   728→
   729→    const commits = getRecentCommits({
   730→      limit: options.full ? limit * 2 : limit,
   731→      since: sinceDate || undefined,
   732→      cwd: ctx.rootDir,
   733→    });
   734→
   735→    recentCommits = commits.map((c) => ({
   736→      hash: c.hash,
   737→      full_hash: c.fullHash,
   738→      date: c.date.toISOString(),
   739→      message: c.message,
   740→      author: c.author,
   741→      task_refs: c.taskRefs,
   742→    }));
   743→
   744→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   745→  }
   746→
   747→  // Get inbox items with triage status (oldest first to encourage triage)
   748→  // AC: @session-start-inbox-triage ac-inbox-untriaged-def
   749→  const allInboxSummaries: InboxSummary[] = inboxItems
   750→    .sort(
   751→      (a, b) =>
   752→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   753→    )
   754→    .map((item) => {
   755→      const triageInfo = triageByInboxRef.get(item._ulid);
   756→      return {
   757→        ref: item._ulid.slice(0, 8),
   758→        text: item.text,
   759→        created_at: item.created_at,
   760→        tags: item.tags,
   761→        added_by: item.added_by || null,
   762→        triaged: !!triageInfo,
   763→        triage_action: triageInfo?.action ?? null,
   764→      };
   765→    });
   766→
   767→  // AC: @session-start-inbox-triage ac-inbox-stat-line, ac-inbox-all-triaged
   768→  const inboxStats: InboxStats = {
   769→    total: allInboxSummaries.length,
   770→    untriaged: allInboxSummaries.filter((i) => !i.triaged).length,
   771→    deferred: allInboxSummaries.filter((i) => i.triage_action === "defer")
   772→      .length,
   773→    triaged: allInboxSummaries.filter((i) => i.triaged).length,
   774→  };
   775→
   776→  // JSON always gets full list with triage status; human display filters in formatSessionContext
   777→  const inboxSummaries: InboxSummary[] = allInboxSummaries;
   778→
   779→  // Load session context (focus, threads, questions)
   780→  const sessionContext = await loadSessionContext(ctx);
   781→
   782→  // Build task ref resolver for activity timeline: maps slug/ULID to short ref
   783→  // This allows commits with Task: @task-slug trailers to match completed tasks
   784→  const taskRefResolver = new Map<string, string>();
   785→  for (const task of allTasks) {
   786→    if (task.status !== "completed") continue;
   787→    const shortRef = index.shortUlid(task._ulid);
   788→    // Map each slug to the short ref
   789→    for (const slug of task.slugs) {
   790→      taskRefResolver.set(slug, shortRef);
   791→    }
   792→    // Also map the full ULID and short ULID to itself
   793→    taskRefResolver.set(task._ulid, shortRef);
   794→    taskRefResolver.set(shortRef, shortRef);
   795→  }
   796→
   797→  // Build unified activity timeline
   798→  // AC: @session-start-activity-timeline ac-activity-merge
   799→  // AC: @cmd-session-start ac-primer-default, ac-full-sections
   800→  // Primer: 10 items; Full: 20 items
   801→  // Respect --limit as upper bound when provided
   802→  const activityLimit = options.full ? Math.min(limit * 2, 20) : Math.min(limit, 10);
   803→  const activityTimeline = buildActivityTimeline(
   804→    recentlyCompleted,
   805→    recentCommits,
   806→    taskRefResolver,
   807→  ).slice(0, activityLimit);
   808→
   809→  // AC: @cmd-session-start ac-full-sections — observations section (full mode only)
   810→  let observations: ObservationSummary[] = [];
   811→  if (options.full) {
   812→    const metaCtx = await loadMetaContext(ctx);
   813→    observations = metaCtx.observations
   814→      .filter((o) => !o.resolved)
   815→      .sort(
   816→        (a, b) =>
   817→          new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   818→      )
   819→      .map((o) => ({
   820→        ref: o._ulid.slice(0, 8),
   821→        type: o.type,
   822→        content: o.content,
   823→        created_at: o.created_at,
   824→        author: o.author || null,
   825→        resolved: o.resolved,
   826→        workflow_ref: o.workflow_ref || null,
   827→      }));
   828→  }
   829→
   830→  // AC: @session-start-computed-json ac-computed-unlocks
   831→  // Build task_unlocks map: short ULID ref → count of pending dependents
   832→  const taskUnlocks: Record<string, number> = {};
   833→  for (const [taskUlid, count] of unlocksMap) {
   834→    if (count > 0) {
   835→      taskUnlocks[index.shortUlid(taskUlid)] = count;
   836→    }
   837→  }
   838→
   839→  // AC: @session-start-computed-json ac-computed-inbox, ac-computed-unlocks, ac-computed-activity
   840→  const computed: SessionContextComputed = {
   841→    inbox_untriaged_count: inboxStats.untriaged,
   842→    inbox_deferred_count: inboxStats.deferred,
   843→    inbox_total: inboxStats.total,
   844→    task_unlocks: taskUnlocks,
   845→    recent_activity: activityTimeline,
   846→  };
   847→
   848→  return {
   849→    generated_at: new Date().toISOString(),
   850→    branch,
   851→    context: sessionContext,
   852→    active_tasks: activeTasks,
   853→    pending_review_tasks: pendingReviewTasks,
   854→    recent_notes: recentNotes,
   855→    active_todos: activeTodos,
   856→    ready_tasks: readyTasks,
   857→    blocked_tasks: blockedTasks,
   858→    recently_completed: recentlyCompleted,
   859→    recent_commits: recentCommits,
   860→    activity_timeline: activityTimeline,
   861→    working_tree: workingTree,
   862→    inbox_items: inboxSummaries,
   863→    inbox_stats: inboxStats,
   864→    observations,
   865→    stats,
   866→    computed,
   867→  };
   868→}
   869→
   870→// ─── Iteration Stats ─────────────────────────────────────────────────────────
   871→
   872→/**
   873→ * Stats for tasks completed/started within a time window.
   874→ * Used by ralph to track task completions per iteration.
   875→ */
   876→export interface IterationStats {
   877→  /** Number of tasks completed since the given time */
   878→  tasks_completed: number;
   879→  /** Number of tasks started since the given time */
   880→  tasks_started: number;
   881→  /** References of completed tasks */
   882→  completed_refs: string[];
