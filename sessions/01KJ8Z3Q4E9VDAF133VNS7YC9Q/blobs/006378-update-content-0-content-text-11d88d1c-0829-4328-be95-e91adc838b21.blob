```
   900→      return new Date(t.completed_at) >= since;
   901→    }
   902→    if (t.status === "pending_review" && t.submitted_at) {
   903→      return new Date(t.submitted_at) >= since;
   904→    }
   905→    return false;
   906→  });
   907→
   908→  const startedSince = allTasks.filter((t) => {
   909→    if (!t.started_at) return false;
   910→    return new Date(t.started_at) >= since;
   911→  });
   912→
   913→  // Use first slug or ULID prefix as ref
   914→  const getRef = (t: LoadedTask) =>
   915→    t.slugs.length > 0 ? `@${t.slugs[0]}` : `@${t._ulid.slice(0, 8)}`;
   916→
   917→  return {
   918→    tasks_completed: completedSince.length,
   919→    tasks_started: startedSince.length,
   920→    completed_refs: completedSince.map(getRef),
   921→  };
   922→}
   923→
   924→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   925→
   926→export interface CheckpointOptions {
   927→  force?: boolean;
   928→  /** Set when stop hook is already active (retry after previous block) */
   929→  stopHookActive?: boolean;
   930→}
   931→
   932→/** Claude Code hook input for Stop hooks */
   933→export interface StopHookInput {
   934→  session_id?: string;
   935→  transcript_path?: string;
   936→  hook_event_name?: string;
   937→  stop_hook_active?: boolean;
   938→}
   939→
   940→/**
   941→ * Perform session checkpoint - check for uncommitted work before ending session.
   942→ *
   943→ * This is designed for use as a Claude Code stop hook. It checks for:
   944→ * - Uncommitted git changes (staged, unstaged, untracked)
   945→ * - Tasks in in_progress status
   946→ * - Incomplete todos on active tasks
   947→ *
   948→ * Returns a structured result indicating whether the session can end cleanly.
   949→ */
   950→export async function performCheckpoint(
   951→  ctx: KspecContext,
   952→  options: CheckpointOptions,
   953→): Promise<CheckpointResult> {
   954→  const issues: CheckpointIssue[] = [];
   955→  const instructions: string[] = [];
   956→
   957→  // Load tasks
   958→  const allTasks = await loadAllTasks(ctx);
   959→
   960→  // Check for in-progress tasks
   961→  const inProgressTasks = allTasks.filter((t) => t.status === "in_progress");
   962→  for (const task of inProgressTasks) {
   963→    const ref = task.slugs[0]
   964→      ? `@${task.slugs[0]}`
   965→      : `@${task._ulid.slice(0, 8)}`;
   966→    issues.push({
   967→      type: "in_progress_task",
   968→      description: `Task ${ref} is still in progress: ${task.title}`,
   969→      details: {
   970→        ref,
   971→        title: task.title,
   972→        started_at: task.started_at,
   973→      },
   974→    });
   975→
   976→    // Check for incomplete todos on this task
   977→    const incompleteTodos = task.todos.filter((t) => !t.done);
   978→    for (const todo of incompleteTodos) {
   979→      issues.push({
   980→        type: "incomplete_todo",
   981→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   982→        details: {
   983→          task_ref: ref,
   984→          todo_id: todo.id,
   985→          text: todo.text,
   986→        },
   987→      });
   988→    }
   989→  }
   990→
   991→  // Check for uncommitted git changes
   992→  if (isGitRepo(ctx.rootDir)) {
   993→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   994→    if (!workingTree.clean) {
   995→      const changeCount =
   996→        workingTree.staged.length +
   997→        workingTree.unstaged.length +
   998→        workingTree.untracked.length;
   999→
  1000→      issues.push({
  1001→        type: "uncommitted_changes",
  1002→        description: `${changeCount} uncommitted changes in working tree`,
  1003→        details: {
  1004→          staged: workingTree.staged.length,
  1005→          unstaged: workingTree.unstaged.length,
  1006→          untracked: workingTree.untracked.length,
  1007→        },
  1008→      });
  1009→    }
  1010→  }
  1011→
  1012→  // Build instructions based on issues
  1013→  if (issues.length > 0 && !options.force) {
  1014→    instructions.push(
  1015→      "If you've been instructed to ignore this message or are working on",
  1016→    );
  1017→    instructions.push(
  1018→      "unrelated things to any in progress tasks then disregard this message,",
  1019→    );
  1020→    instructions.push("otherwise before ending this session, please:");
  1021→
  1022→    const hasInProgress = issues.some((i) => i.type === "in_progress_task");
  1023→    const hasUncommitted = issues.some((i) => i.type === "uncommitted_changes");
  1024→    const hasIncompleteTodos = issues.some((i) => i.type === "incomplete_todo");
  1025→
  1026→    let step = 1;
  1027→
  1028→    if (hasInProgress) {
  1029→      instructions.push(
  1030→        `${step++}. Read in-progress task notes to get full context of the current task status`,
  1031→      );
  1032→      instructions.push(
  1033→        `${step++}. Add notes documenting current state if any context is missing from this session`,
  1034→      );
  1035→      instructions.push(
  1036→        `${step++}. Complete the task if you've completed the objectives and no AC are left uncovered\notherwise leave it in progress for a future session`,
  1037→      );
  1038→    }
  1039→
  1040→    if (hasIncompleteTodos) {
  1041→      instructions.push(
  1042→        `${step++}. Complete or acknowledge incomplete todos on active tasks`,
  1043→      );
  1044→    }
  1045→
  1046→    if (hasUncommitted) {
  1047→      instructions.push(
  1048→        `${step++}. Commit your changes with a descriptive message`,
  1049→      );
  1050→
  1051→      // Add WIP commit guidance if there are in-progress tasks
  1052→      if (inProgressTasks.length > 0) {
  1053→        const task = inProgressTasks[0];
  1054→        const guidance = formatCommitGuidance(task, { wip: true });
  1055→        instructions.push("");
  1056→        instructions.push("Suggested WIP commit:");
  1057→        instructions.push(`  ${guidance.message}`);
  1058→        instructions.push("");
  1059→        for (const trailer of guidance.trailers) {
  1060→          instructions.push(`  ${trailer}`);
  1061→        }
  1062→      }
  1063→    }
  1064→
  1065→    instructions.push("");
  1066→    instructions.push("Use: kspec task @task to get current task state");
  1067→    instructions.push(
  1068→      'Use: kspec task note @task "Progress notes..." to document state',
  1069→    );
  1070→    instructions.push(
  1071→      'Use: kspec task complete @task --reason "Summary" if task is done',
  1072→    );
  1073→  }
  1074→
  1075→  // Allow stop if:
  1076→  // - No issues found
  1077→  // - --force flag passed
  1078→  // - This is a retry (stop_hook_active = true from previous block)
  1079→  const isRetry = options.stopHookActive === true;
  1080→  const ok = issues.length === 0 || options.force === true || isRetry;
  1081→
  1082→  let message: string;
  1083→  if (isRetry && issues.length > 0) {
  1084→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
  1085→  } else if (ok) {
  1086→    message = "[kspec] Session checkpoint passed - ready to end session";
  1087→  } else {
  1088→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
  1089→  }
  1090→
  1091→  return {
  1092→    ok,
  1093→    message,
  1094→    issues,
  1095→    instructions,
  1096→  };
  1097→}
  1098→
  1099→// ─── Output Formatting ───────────────────────────────────────────────────────
  1100→
  1101→function formatCheckpointResult(result: CheckpointResult): void {
  1102→  if (result.ok) {
  1103→    console.log(chalk.green(result.message));
  1104→  } else {
  1105→    console.log(chalk.yellow(result.message));
  1106→    console.log("");
  1107→
  1108→    for (const issue of result.issues) {
  1109→      const icon =
  1110→        issue.type === "uncommitted_changes"
  1111→          ? chalk.yellow("⚠")
  1112→          : issue.type === "in_progress_task"
  1113→            ? chalk.blue("●")
  1114→            : chalk.gray("○");
  1115→      console.log(`  ${icon} ${issue.description}`);
  1116→    }
  1117→
  1118→    if (result.instructions.length > 0) {
  1119→      console.log("");
  1120→      for (const instruction of result.instructions) {
  1121→        console.log(chalk.gray(instruction));
  1122→      }
  1123→    }
  1124→  }
  1125→}
  1126→
  1127→function formatSessionContext(
  1128→  ctx: SessionContext,
  1129→  options: SessionOptions,
  1130→): void {
  1131→  const isFull = !!options.full;
  1132→
  1133→  // AC: @cmd-session-start ac-slug-display, ac-slug-fallback
  1134→  // Display ref as @slug when available, @short-ulid when not
  1135→  const displayRef = (task: { ref: string; slug?: string | null }) =>
  1136→    task.slug ? `@${task.slug}` : `@${task.ref}`;
  1137→
  1138→  // Header
  1139→  console.log(`\n${sessionHeaders.title}`);
  1140→  const age = formatRelativeTime(new Date(ctx.generated_at));
  1141→  if (ctx.branch) {
  1142→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
  1143→  } else {
  1144→    console.log(chalk.gray(`Generated: ${age}`));
  1145→  }
  1146→
  1147→  // Stats summary
  1148→  const pendingReviewNote =
  1149→    ctx.stats.pending_review > 0
  1150→      ? `${ctx.stats.pending_review} awaiting review, `
  1151→      : "";
  1152→  const inboxNote =
  1153→    ctx.stats.inbox_items > 0 ? ` | Inbox: ${ctx.stats.inbox_items}` : "";
  1154→  console.log(
  1155→    chalk.gray(
  1156→      `Tasks: ${ctx.stats.in_progress} active, ${pendingReviewNote}${ctx.stats.ready} ready, ` +
  1157→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`,
  1158→    ),
  1159→  );
  1160→
  1161→  // Session context section (focus, threads, questions)
  1162→  if (
  1163→    ctx.context &&
  1164→    (ctx.context.focus ||
  1165→      ctx.context.threads.length > 0 ||
  1166→      ctx.context.open_questions.length > 0)
  1167→  ) {
  1168→    console.log("\n--- Session Context ---");
  1169→
  1170→    if (ctx.context.focus) {
  1171→      console.log(`  ${chalk.cyan("Focus:")} ${ctx.context.focus}`);
  1172→    }
  1173→
  1174→    if (ctx.context.threads.length > 0) {
  1175→      console.log(`  ${chalk.cyan("Active Threads:")}`);
  1176→      for (const thread of ctx.context.threads) {
  1177→        console.log(`    - ${thread}`);
  1178→      }
  1179→    }
  1180→
  1181→    if (ctx.context.open_questions.length > 0) {
  1182→      console.log(`  ${chalk.cyan("Open Questions:")}`);
  1183→      for (const question of ctx.context.open_questions) {
  1184→        console.log(`    - ${question}`);
  1185→      }
  1186→    }
  1187→  }
  1188→
  1189→  // ── Section ordering per AC: @cmd-session-start ac-section-order ──
  1190→  // active tasks → pending review → blocked → ready → recent activity → inbox → working tree → quick commands
  1191→  // AC: @cmd-session-start ac-empty-skip — empty sections omitted entirely
  1192→
  1193→  // ── Active tasks section ──
  1194→  // AC: @cmd-session-start ac-active-detail, ac-needs-work-indicator
  1195→  if (ctx.active_tasks.length > 0) {
  1196→    console.log(`\n${sessionHeaders.activeWork}`);
  1197→
  1198→    // Collect notes relevant to active tasks for inline display
  1199→    const activeTaskNotes = ctx.recent_notes.filter(
  1200→      (n) =>
  1201→        n.task_status === "in_progress" || n.task_status === "needs_work",
  1202→    );
  1203→
  1204→    for (const task of ctx.active_tasks) {
  1205→      const started = task.started_at
  1206→        ? chalk.gray(
  1207→            ` (started ${formatRelativeTime(new Date(task.started_at))})`,
  1208→          )
  1209→        : "";
  1210→      const priority =
  1211→        task.priority <= 2
  1212→          ? chalk.red(`P${task.priority}`)
  1213→          : chalk.gray(`P${task.priority}`);
  1214→
  1215→      // AC: @cmd-session-start ac-needs-work-indicator
  1216→      const statusLabel =
  1217→        task.status === "needs_work"
  1218→          ? chalk.red("[needs_work]")
  1219→          : chalk.blue("[in_progress]");
  1220→
  1221→      console.log(
  1222→        `  ${statusLabel} ${priority} ${displayRef(task)} ${task.title}${started}`,
  1223→      );
  1224→
  1225→      // AC: @cmd-session-start ac-active-detail — show description
  1226→      if (task.description) {
  1227→        console.log(chalk.gray(`    ${task.description}`));
  1228→      }
  1229→
  1230→      // AC: @cmd-session-start ac-active-detail — show recent notes inline
  1231→      const taskNotes = activeTaskNotes.filter(
  1232→        (n) => n.task_ref === task.ref,
  1233→      );
  1234→      if (taskNotes.length > 0) {
  1235→        const latestNote = taskNotes[0]; // already sorted most recent first
  1236→        const noteAge = formatRelativeTime(new Date(latestNote.created_at));
  1237→        const author = latestNote.author
  1238→          ? chalk.gray(` by ${latestNote.author}`)
  1239→          : "";
  1240→        console.log(`    ${chalk.yellow("Note")} ${chalk.gray(`(${noteAge}${author})`)}`);
  1241→
  1242→        let content = latestNote.content.trim();
  1243→        if (!isFull && content.length > 200) {
  1244→          content = `${content.slice(0, 200).trim()}...`;
  1245→        }
  1246→        const lines = content.split("\n");
  1247→        const maxLines = isFull ? lines.length : 3;
  1248→        for (const line of lines.slice(0, maxLines)) {
  1249→          console.log(`      ${chalk.white(line)}`);
  1250→        }
  1251→        if (!isFull && lines.length > maxLines) {
  1252→          console.log(
  1253→            chalk.gray(
  1254→              `      ... (${lines.length - maxLines} more lines)`,
  1255→            ),
  1256→          );
  1257→        }
  1258→      }
  1259→    }
  1260→  }
  1261→
  1262→  // ── Awaiting review section ──
  1263→  // AC: @cmd-session-start ac-review-detail
  1264→  if (ctx.pending_review_tasks.length > 0) {
  1265→    console.log(`\n${sessionHeaders.awaitingReview}`);
  1266→
  1267→    const reviewNotes = ctx.recent_notes.filter(
  1268→      (n) => n.task_status === "pending_review",
  1269→    );
  1270→
  1271→    for (const task of ctx.pending_review_tasks) {
  1272→      const priority =
  1273→        task.priority <= 2
  1274→          ? chalk.red(`P${task.priority}`)
  1275→          : chalk.gray(`P${task.priority}`);
  1276→      console.log(
  1277→        `  ${chalk.yellow("[pending_review]")} ${priority} ${displayRef(task)} ${task.title}`,
  1278→      );
  1279→
  1280→      // AC: @cmd-session-start ac-review-detail — show recent notes
  1281→      const taskNotes = reviewNotes.filter((n) => n.task_ref === task.ref);
  1282→      if (taskNotes.length > 0) {
  1283→        const latestNote = taskNotes[0];
  1284→        const noteAge = formatRelativeTime(new Date(latestNote.created_at));
  1285→        const author = latestNote.author
  1286→          ? chalk.gray(` by ${latestNote.author}`)
  1287→          : "";
  1288→        console.log(`    ${chalk.yellow("Note")} ${chalk.gray(`(${noteAge}${author})`)}`);
  1289→
  1290→        let content = latestNote.content.trim();
  1291→        if (!isFull && content.length > 200) {
  1292→          content = `${content.slice(0, 200).trim()}...`;
  1293→        }
  1294→        const lines = content.split("\n");
  1295→        const maxLines = isFull ? lines.length : 3;
  1296→        for (const line of lines.slice(0, maxLines)) {
  1297→          console.log(`      ${chalk.white(line)}`);
  1298→        }
  1299→        if (!isFull && lines.length > maxLines) {
  1300→          console.log(
  1301→            chalk.gray(
  1302→              `      ... (${lines.length - maxLines} more lines)`,
  1303→            ),
  1304→          );
  1305→        }
  1306→      }
  1307→    }
  1308→  }
  1309→
  1310→  // ── Blocked tasks section ──
  1311→  if (ctx.blocked_tasks.length > 0) {
  1312→    console.log(`\n${sessionHeaders.blocked}`);
  1313→    for (const task of ctx.blocked_tasks) {
  1314→      const unlocks =
  1315→        task.unlocks > 0 ? chalk.green(` unlocks ${task.unlocks}`) : "";
  1316→      console.log(
  1317→        `  ${chalk.red("[blocked]")} ${displayRef(task)} ${task.title}${unlocks}`,
  1318→      );
  1319→      if (task.blocked_by.length > 0) {
  1320→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(", ")}`));
  1321→      }
  1322→      if (task.unmet_deps.length > 0) {
  1323→        console.log(
  1324→          chalk.gray(`    Waiting on: ${task.unmet_deps.join(", ")}`),
  1325→        );
  1326→      }
  1327→    }
  1328→  }
  1329→
  1330→  // ── Ready tasks section ──
  1331→  if (ctx.ready_tasks.length > 0) {
  1332→    console.log(`\n${sessionHeaders.readyTasks}`);
  1333→    for (const task of ctx.ready_tasks) {
  1334→      const priority =
  1335→        task.priority <= 2
  1336→          ? chalk.red(`P${task.priority}`)
  1337→          : chalk.gray(`P${task.priority}`);
  1338→      const tags =
  1339→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(" #")}`) : "";
  1340→      const unlocks =
  1341→        task.unlocks > 0 ? chalk.green(` unlocks ${task.unlocks}`) : "";
  1342→      console.log(
  1343→        `  ${priority} ${displayRef(task)} ${task.title}${unlocks}${tags}`,
  1344→      );
  1345→    }
  1346→  }
  1347→
  1348→  // ── Recent Activity timeline ──
  1349→  // AC: @session-start-activity-timeline ac-activity-merge
  1350→  if (ctx.activity_timeline.length > 0) {
  1351→    console.log(`\n${sessionHeaders.recentActivity}`);
  1352→    const observationPromotedTasks: string[] = [];
  1353→    for (const item of ctx.activity_timeline) {
  1354→      // AC: @cmd-session-start ac-relative-time-human
  1355→      const itemAge = formatRelativeTime(new Date(item.date));
  1356→      if (item.type === "task_completion") {
  1357→        let reason = "";
  1358→        if (item.task.closed_reason) {
  1359→          const maxLen = isFull ? 120 : 60;
  1360→          const truncated =
  1361→            item.task.closed_reason.length > maxLen
  1362→              ? `${item.task.closed_reason.slice(0, maxLen).trim()}...`
  1363→              : item.task.closed_reason;
  1364→          reason = chalk.gray(` - ${truncated}`);
  1365→        }
  1366→        // AC: @cmd-session-start ac-slug-display
  1367→        const taskDisplay = item.task.slug
  1368→          ? `@${item.task.slug}`
  1369→          : `@${item.task.ref}`;
  1370→        console.log(
  1371→          `  ${chalk.green("[completed]")} ${taskDisplay} ${item.task.title} ${chalk.gray(`(${itemAge})`)}${reason}`,
  1372→        );
  1373→        if (item.task.origin === "observation_promotion") {
  1374→          observationPromotedTasks.push(taskDisplay);
  1375→        }
  1376→      } else if (item.type === "commit") {
  1377→        console.log(
  1378→          `  ${chalk.yellow(item.commit.hash)} ${item.commit.message} ${chalk.gray(`(${itemAge}, ${item.commit.author})`)}`,
  1379→        );
  1380→      } else if (item.type === "linked_commit") {
  1381→        // AC: @session-start-activity-timeline ac-activity-dedup, ac-activity-trailer-link
  1382→        const taskDisplay = item.task.slug
  1383→          ? `@${item.task.slug}`
  1384→          : `@${item.task.ref}`;
  1385→        console.log(
  1386→          `  ${chalk.yellow(item.commit.hash)} ${item.commit.message} ${chalk.gray(`(${itemAge}, ${item.commit.author})`)} ${chalk.green(`→ ${taskDisplay} ${item.task.title}`)}`,
  1387→        );
  1388→        if (item.task.origin === "observation_promotion") {
  1389→          observationPromotedTasks.push(taskDisplay);
  1390→        }
  1391→      }
  1392→    }
  1393→
  1394→    // Show reminder about resolving observations
  1395→    if (observationPromotedTasks.length > 0) {
  1396→      console.log(
  1397→        chalk.yellow(
  1398→          `\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(", ")}`,
  1399→        ),
```