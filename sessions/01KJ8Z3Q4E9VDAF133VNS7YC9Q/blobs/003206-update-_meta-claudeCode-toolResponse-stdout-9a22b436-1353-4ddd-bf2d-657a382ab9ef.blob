   290	/**
   291	 * Build a reverse dependency map: for each task ULID, count how many
   292	 * pending tasks depend on it. Unresolvable refs are silently skipped.
   293	 */
   294	function computeUnlocksMap(
   295	  allTasks: LoadedTask[],
   296	  index: ReferenceIndex,
   297	): Map<string, number> {
   298	  const counts = new Map<string, number>();
   299	
   300	  for (const task of allTasks) {
   301	    // Only count pending tasks as "unlockable" downstream work per spec
   302	    if (task.status !== "pending") continue;
   303	
   304	    for (const depRef of task.depends_on) {
   305	      const result = index.resolve(depRef);
   306	      if (!result.ok) continue; // AC: unresolvable refs silently skipped
   307	      const depUlid = result.item._ulid;
   308	      counts.set(depUlid, (counts.get(depUlid) || 0) + 1);
   309	    }

