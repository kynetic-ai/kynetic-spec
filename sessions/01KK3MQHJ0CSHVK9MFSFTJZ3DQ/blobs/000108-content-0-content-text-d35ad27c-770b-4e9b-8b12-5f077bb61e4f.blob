   284→		// AC: @ui-dashboard-overview ac-1 — Validates UI renders correct aggregated counts
   285→		// Fixture: 2 pending (1 ready, 1 dep-blocked), 1 in_progress, 1 pending_review, 1 completed
   286→		// Expected: ready=1, in_progress=1, pending_review=1, blocked=0, completed=1
   287→		test('renders correct aggregated counts from task data', async ({ page }) => {
   288→			await interceptDashboardAPIs(page);
   289→			await page.goto('/');
   290→			await expect(page.getByTestId('status-summary-section')).toBeVisible();
   291→
   292→			// Verify each count card renders the correct number
   293→			await expect(page.getByTestId('task-count-ready')).toContainText('1');
   294→			await expect(page.getByTestId('task-count-in_progress')).toContainText('1');
   295→			await expect(page.getByTestId('task-count-needs_work')).toContainText('0');
   296→			await expect(page.getByTestId('task-count-pending_review')).toContainText('1');
   297→			// Blocked card counts only status=blocked tasks, not dep-blocked pending tasks
   298→			await expect(page.getByTestId('task-count-blocked')).toContainText('0');
   299→			await expect(page.getByTestId('task-count-completed')).toContainText('1');
