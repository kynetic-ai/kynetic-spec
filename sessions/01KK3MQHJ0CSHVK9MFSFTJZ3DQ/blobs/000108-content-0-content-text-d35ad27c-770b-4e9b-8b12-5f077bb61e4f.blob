    82→		total: 5,
    83→		limit: 1000,
    84→		offset: 0
    85→	};
    86→}
    87→
    88→/** Inbox data: 3 items matching fixture */
    89→function fixtureInbox() {
    90→	return { items: [], total: 3, limit: 0, offset: 0 };
    91→}
    92→
    93→/** Observations: 2 unresolved matching fixture */
    94→function fixtureObservations() {
    95→	return { items: [], total: 2, limit: 50, offset: 0 };
    96→}
    97→
    98→/** Validation: some warnings to verify count aggregation */
    99→function fixtureValidation() {
   100→	return {
   101→		valid: false,
   102→		schemaErrors: [],
   103→		refErrors: [{ source: 'test', ref: '@missing', message: 'Missing ref' }],
   104→		refWarnings: [{ source: 'test', ref: '@warn', message: 'Warning' }],
   105→		orphans: [],
   106→		completenessWarnings: [],
   107→		traitCycles: []
   108→	};
   109→}
   110→
   111→/** Agent status: no dispatch running */
   112→function fixtureAgentStatus() {
   113→	return {
   114→		dispatch_enabled: false,
   115→		active_invocations: [],
   116→		queued_tasks: [],
   117→		agents: []
   118→	};
   119→}
   120→
   121→/**
   122→ * Set up page.route() interceptors for all dashboard API calls.
   123→ * Intercepts browser-side fetches to localhost:3456 and fulfills with fixture data.
   124→ */
   125→async function interceptDashboardAPIs(page: import('@playwright/test').Page) {
   126→	await page.route('**/api/tasks?*', (route) => {
   127→		route.fulfill({
   128→			status: 200,
   129→			contentType: 'application/json',
   130→			body: JSON.stringify(fixtureTasks())
   131→		});
   132→	});
   133→
   134→	await page.route('**/api/inbox?*', (route) => {
   135→		route.fulfill({
   136→			status: 200,
   137→			contentType: 'application/json',
   138→			body: JSON.stringify(fixtureInbox())
   139→		});
   140→	});
   141→
   142→	await page.route('**/api/meta/observations?*', (route) => {
   143→		route.fulfill({
   144→			status: 200,
   145→			contentType: 'application/json',
   146→			body: JSON.stringify(fixtureObservations())
   147→		});
   148→	});
   149→
   150→	await page.route('**/api/validate', (route) => {
   151→		route.fulfill({
   152→			status: 200,
   153→			contentType: 'application/json',
   154→			body: JSON.stringify(fixtureValidation())
   155→		});
   156→	});
   157→
   158→	await page.route('**/api/agent/status', (route) => {
   159→		route.fulfill({
   160→			status: 200,
   161→			contentType: 'application/json',
   162→			body: JSON.stringify(fixtureAgentStatus())
   163→		});
   164→	});
   165→}
   166→
