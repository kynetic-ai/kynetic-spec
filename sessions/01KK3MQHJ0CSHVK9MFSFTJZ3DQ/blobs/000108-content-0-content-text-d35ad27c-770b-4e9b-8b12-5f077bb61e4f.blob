   498→	// AC: @ui-dashboard-overview ac-1 — API contract verification
   499→	// These verify the daemon API returns expected fixture data, independent of UI rendering.
   500→	test.describe('API Contract Verification', () => {
   501→		test('daemon returns task counts matching fixture data', async ({ daemon }) => {
   502→			const response = await fetch(`${daemon.baseUrl}/api/tasks?limit=1000`);
   503→			expect(response.ok).toBe(true);
   504→			const data = await response.json();
   505→
   506→			const tasks = data.items;
   507→			expect(tasks).toBeDefined();
   508→
   509→			const statusCounts: Record<string, number> = {};
   510→			for (const task of tasks) {
   511→				statusCounts[task.status] = (statusCounts[task.status] || 0) + 1;
   512→			}
   513→
   514→			// Fixture has: 2 pending (1 ready, 1 dep-blocked), 1 in_progress, 1 pending_review, 1 completed
   515→			expect(statusCounts['pending']).toBe(2);
   516→			expect(statusCounts['in_progress']).toBe(1);
   517→			expect(statusCounts['pending_review']).toBe(1);
   518→			expect(statusCounts['completed']).toBe(1);
   519→		});
   520→
   521→		test('daemon returns inbox items', async ({ daemon }) => {
