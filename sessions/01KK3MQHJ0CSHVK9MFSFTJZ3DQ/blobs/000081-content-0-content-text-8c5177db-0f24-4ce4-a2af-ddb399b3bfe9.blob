```
     1→/**
     2→ * API Client
     3→ *
     4→ * Helper functions for making requests to the kspec daemon API.
     5→ * Supports both daemon mode (live) and static mode (read-only JSON).
     6→ *
     7→ * AC Coverage:
     8→ * - ac-26 (@multi-directory-daemon): X-Kspec-Dir header injection
     9→ * - ac-36 (@multi-directory-daemon): Invalid project error detection
    10→ * - ac-11 (@gh-pages-export): Mode-aware API dispatch
    11→ * - ac-18 (@gh-pages-export): Graceful no-op for write operations
    12→ */
    13→
    14→import type {
    15→	TaskSummary,
    16→	TaskDetail,
    17→	ItemSummary,
    18→	ItemDetail,
    19→	InboxItem,
    20→	SessionContext,
    21→	Observation,
    22→	Workflow,
    23→	Convention,
    24→	PaginatedResponse,
    25→	PlanSummary,
    26→	ErrorResponse,
    27→	SearchResponse,
    28→	AgentDefinition,
    29→	AgentUpdatePayload
    30→} from '@kynetic-ai/shared';
    31→import type { TriageRecord } from './types/triage';
    32→import {
    33→	getSelectedProjectPath,
    34→	clearInvalidSelection,
    35→	isInvalidProjectError,
    36→	type Project
    37→} from './stores/project.svelte';
    38→import { isStaticMode, assertWritable } from './stores/mode.svelte';
    39→import {
    40→	fetchTasksStatic,
    41→	fetchTaskStatic,
    42→	fetchItemsStatic,
    43→	fetchItemStatic,
    44→	fetchItemTasksStatic,
    45→	fetchInboxStatic,
    46→	fetchSessionContextStatic,
    47→	fetchObservationsStatic,
    48→	searchStatic,
    49→	fetchTriageRecordsStatic,
    50→	fetchPlansStatic,
    51→	fetchWorkflowsStatic
    52→} from './api-static';
    53→import { DAEMON_API_BASE } from './constants';
    54→
    55→const API_BASE = DAEMON_API_BASE;
    56→
    57→/**
    58→ * Get headers for API requests, including X-Kspec-Dir if project is selected
    59→ * AC: @multi-directory-daemon ac-26
    60→ */
    61→function getProjectHeaders(): HeadersInit {
    62→	const path = getSelectedProjectPath();
    63→	return path ? { 'X-Kspec-Dir': path } : {};
    64→}
    65→
    66→/**
    67→ * Handle response errors, detecting invalid project errors
    68→ * AC: @multi-directory-daemon ac-36
    69→ */
    70→async function handleResponseError(response: Response): Promise<never> {
    71→	const error: ErrorResponse = await response.json();
    72→	const message = error.message || error.error;
    73→
    74→	// Check if this is an invalid project error
    75→	if (isInvalidProjectError(response, message)) {
    76→		clearInvalidSelection();
    77→	}
    78→
    79→	throw new Error(message);
    80→}
    81→
    82→/**
    83→ * Fetch registered projects
    84→ * AC: @multi-directory-daemon ac-25, ac-28
    85→ */
    86→export async function fetchProjects(): Promise<{ projects: Project[] }> {
    87→	const response = await fetch(`${API_BASE}/api/projects`);
    88→	if (!response.ok) {
    89→		await handleResponseError(response);
    90→	}
    91→	return response.json();
    92→}
    93→
    94→/**
    95→ * Fetch tasks with optional filters
    96→ * AC: @web-dashboard ac-9, ac-10
    97→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
    98→ * AC: @gh-pages-export ac-11 - Static mode support
    99→ */
   100→export async function fetchTasks(params?: {
   101→	status?: string;
   102→	type?: string;
   103→	tag?: string;
   104→	assignee?: string;
   105→	automation?: string;
   106→	plan?: string;
   107→	limit?: number;
   108→	offset?: number;
   109→}): Promise<PaginatedResponse<TaskSummary>> {
   110→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   111→	if (isStaticMode()) {
   112→		return fetchTasksStatic(params);
   113→	}
   114→
   115→	const url = new URL(`${API_BASE}/api/tasks`);
   116→
   117→	if (params) {
   118→		Object.entries(params).forEach(([key, value]) => {
   119→			if (value !== undefined && value !== '') {
   120→				url.searchParams.set(key, String(value));
   121→			}
   122→		});
   123→	}
   124→
   125→	const response = await fetch(url.toString(), {
   126→		headers: getProjectHeaders()
   127→	});
   128→	if (!response.ok) {
   129→		await handleResponseError(response);
   130→	}
   131→
   132→	return response.json();
   133→}
   134→
   135→/**
   136→ * Fetch single task by reference
   137→ * AC: @web-dashboard ac-5
   138→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   139→ * AC: @gh-pages-export ac-12 - Static mode deep linking
   140→ */
   141→export async function fetchTask(ref: string): Promise<TaskDetail> {
   142→	// AC: @gh-pages-export ac-12 - Use static data in static mode
   143→	if (isStaticMode()) {
   144→		const task = fetchTaskStatic(ref);
   145→		if (!task) {
   146→			throw new Error(`Task not found: ${ref}`);
   147→		}
   148→		return task;
   149→	}
   150→
   151→	const response = await fetch(`${API_BASE}/api/tasks/${ref}`, {
   152→		headers: getProjectHeaders()
   153→	});
   154→	if (!response.ok) {
   155→		await handleResponseError(response);
   156→	}
   157→
   158→	return response.json();
   159→}
   160→
   161→/**
   162→ * Start a task (change status to in_progress)
   163→ * AC: @web-dashboard ac-7
   164→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   165→ * AC: @gh-pages-export ac-16, ac-18 - Disabled in static mode
   166→ */
   167→export async function startTask(ref: string): Promise<void> {
   168→	// AC: @gh-pages-export ac-16, ac-18 - Write operations throw in static mode
   169→	assertWritable('start task');
   170→
   171→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/start`, {
   172→		method: 'POST',
   173→		headers: getProjectHeaders()
   174→	});
   175→	if (!response.ok) {
   176→		await handleResponseError(response);
   177→	}
   178→}
   179→
   180→/**
   181→ * Add a note to a task
   182→ * AC: @web-dashboard ac-8
   183→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   184→ * AC: @gh-pages-export ac-18 - Disabled in static mode
   185→ */
   186→export async function addTaskNote(ref: string, content: string): Promise<void> {
   187→	// AC: @gh-pages-export ac-18 - Write operations throw in static mode
   188→	assertWritable('add note');
   189→
   190→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/note`, {
   191→		method: 'POST',
   192→		headers: {
   193→			'Content-Type': 'application/json',
   194→			...getProjectHeaders()
   195→		},
   196→		body: JSON.stringify({ content })
   197→	});
   198→	if (!response.ok) {
   199→		await handleResponseError(response);
   200→	}
   201→}
