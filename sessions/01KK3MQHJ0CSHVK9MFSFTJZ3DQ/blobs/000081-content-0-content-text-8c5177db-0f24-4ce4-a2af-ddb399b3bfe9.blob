  1010→
  1011→/** Alias for backward compatibility with dashboard overview */
  1012→export type ValidationResult = ValidationResponse;
  1013→
  1014→export interface AlignmentWarning {
  1015→	type: 'orphaned_spec' | 'status_mismatch' | 'stale_implementation';
  1016→	specUlid?: string;
  1017→	specTitle?: string;
  1018→	taskUlid?: string;
  1019→	message: string;
  1020→}
  1021→
  1022→export interface AlignmentStats {
