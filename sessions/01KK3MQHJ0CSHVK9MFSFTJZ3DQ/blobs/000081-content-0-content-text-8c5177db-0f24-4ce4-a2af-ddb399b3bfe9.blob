  1031→	warnings: AlignmentWarning[];
  1032→}
  1033→
  1034→/**
  1035→ * Fetch validation results
  1036→ * AC: @ui-validation-view ac-1
  1037→ */
  1038→export async function fetchValidation(): Promise<ValidationResponse> {
  1039→	if (isStaticMode()) {
