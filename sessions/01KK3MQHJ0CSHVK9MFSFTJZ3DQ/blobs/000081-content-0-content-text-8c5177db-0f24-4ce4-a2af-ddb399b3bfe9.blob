  1041→			valid: true,
  1042→			schemaErrors: [],
  1043→			refErrors: [],
  1044→			refWarnings: [],
  1045→			orphans: [],
  1046→			completenessWarnings: [],
  1047→			traitCycles: []
  1048→		};
  1049→	}
  1050→
  1051→	const response = await fetch(`${API_BASE}/api/validate`, {
  1052→		headers: getProjectHeaders()
  1053→	});
  1054→	if (!response.ok) {
  1055→		await handleResponseError(response);
