   979→	| 'missing_description'
   980→	| 'status_inconsistency'
   981→	| 'missing_test_coverage'
   982→	| 'automation_eligible_no_spec'
   983→	| 'ac_schema_field_mismatch';
   984→
   985→export interface CompletenessWarning {
