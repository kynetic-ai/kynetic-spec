   617→// ============================================================
   618→// Agent & Dispatch API Functions
   619→// AC: @ui-agent-dispatch ac-1, ac-2, ac-3
   620→// ============================================================
   621→
   622→// AgentDefinition and AgentUpdatePayload are imported from @kynetic-ai/shared
   623→// (schema-driven types mirroring AgentSchema from src/schema/meta.ts)
   624→// Re-exported so existing imports from '$lib/api' continue to work.
   625→// AC: @ui-agent-dispatch ac-4
   626→export type { AgentDefinition, AgentUpdatePayload };
   627→
   628→/**
   629→ * Active invocation from GET /api/agent/status
   630→ */
   631→export interface ActiveInvocation {
   632→	session_id: string;
   633→	agent_id: string;
   634→	task_ref: string | null;
   635→	elapsed_ms: number;
   636→}
   637→
   638→/**
   639→ * Agent dispatch status from GET /api/agent/status
   640→ */
   641→export interface AgentDispatchStatus {
   642→	dispatch_enabled: boolean;
   643→	active_invocations: ActiveInvocation[];
   644→	queue_depth: number;
   645→	agent_definitions: Array<{
   646→		id: string;
   647→		name: string;
   648→		adapter: string;
   649→		completed_sessions?: number;
   650→	}>;
   651→}
   652→
   653→/**
   654→ * Fetch agent dispatch status (dispatch state + active invocations)
   655→ * AC: @ui-agent-dispatch ac-1, ac-2, ac-3
   656→ */
   657→export async function fetchAgentStatus(): Promise<AgentDispatchStatus> {
