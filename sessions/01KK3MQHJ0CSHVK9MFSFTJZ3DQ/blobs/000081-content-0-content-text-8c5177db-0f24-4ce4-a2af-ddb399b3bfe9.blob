   497→ * AC: @web-dashboard ac-24
   498→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   499→ * AC: @gh-pages-export ac-11 - Static mode support
   500→ */
   501→export async function search(query: string): Promise<SearchResponse> {
   502→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   503→	if (isStaticMode()) {
   504→		return searchStatic(query);
   505→	}
   506→
   507→	const url = new URL(`${API_BASE}/api/search`);
   508→	url.searchParams.set('q', query);
