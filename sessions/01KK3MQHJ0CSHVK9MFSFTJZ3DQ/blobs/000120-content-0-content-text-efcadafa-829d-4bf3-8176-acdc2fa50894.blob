   320→  test.describe('POST /api/tasks/:ref/note', () => {
   321→    // AC: @api-contract ac-7 - append note
   322→    // Route returns { success: true, note, task } shape
   323→    test('appends note to task and returns {success, note, task}', async ({ request, daemon }) => {
   324→      const noteContent = `E2E test note ${Date.now()}`;
   325→      const response = await request.post(
   326→        `${daemon.baseUrl}/api/tasks/@test-task-in-progress/note`,
   327→        {
   328→          data: { content: noteContent, author: '@test' },
   329→        }
   330→      );
   331→      expect(response.status()).toBe(200);
   332→
   333→      const body = await response.json();
   334→      // Route returns { success: true, note, task }
   335→      expect(body).toHaveProperty('success');
   336→      expect(body.success).toBe(true);
   337→      expect(body).toHaveProperty('note');
   338→      expect(body).toHaveProperty('task');
   339→
   340→      // The note in the response should match what we sent
   341→      expect(body.note.content).toBe(noteContent);
   342→
   343→      // The task in the response should include our new note
   344→      expect(Array.isArray(body.task.notes)).toBe(true);
   345→      const addedNote = body.task.notes.find(
   346→        (n: { content: string }) => n.content === noteContent
   347→      );
   348→      expect(addedNote).toBeDefined();
   349→    });
   350→
   351→    // AC: @api-contract ac-7 - note has required fields
   352→    test('created note has _ulid, content, created_at', async ({ request, daemon }) => {
   353→      const noteContent = `Note field check ${Date.now()}`;
   354→      const response = await request.post(
   355→        `${daemon.baseUrl}/api/tasks/@test-task-in-progress/note`,
   356→        {
   357→          data: { content: noteContent },
   358→        }
   359→      );
   360→      expect(response.status()).toBe(200);
   361→
   362→      const body = await response.json();
   363→      const note = body.note;
   364→
   365→      expect(note).toHaveProperty('_ulid');
   366→      expect(note).toHaveProperty('content');
   367→      expect(note).toHaveProperty('created_at');
   368→      expect(typeof note._ulid).toBe('string');
   369→      expect(note._ulid.length).toBeGreaterThan(0);
   370→      expect(note.content).toBe(noteContent);
   371→    });
   372→
   373→    // AC: @api-contract ac-7 (error handling) - 422 for missing content (Elysia schema validation)
   374→    // Elysia validates body schema before handler runs, returning 422 (not 400)
   375→    test('returns 422 validation error when content is missing', async ({ request, daemon }) => {
   376→      const response = await request.post(
   377→        `${daemon.baseUrl}/api/tasks/@test-task-in-progress/note`,
   378→        { data: {} }
   379→      );
   380→      expect(response.status()).toBe(422);
   381→    });
   382→
   383→    // AC: @api-contract ac-7 (error handling) - 404 for invalid ref
   384→    test('returns 404 for non-existent task', async ({ request, daemon }) => {
   385→      const response = await request.post(
   386→        `${daemon.baseUrl}/api/tasks/@nonexistent-task-xyz/note`,
   387→        { data: { content: 'test note' } }
   388→      );
   389→      expect(response.status()).toBe(404);
   390→
   391→      const body = await response.json();
   392→      expect(body.error).toBe('not_found');
   393→    });
   394→  });
   395→
   396→  test.describe('Content-Type and Response Format', () => {
   397→    // AC: @api-contract ac-1 (partial) - JSON content type for GET endpoints
   398→    test('returns JSON content type for GET endpoints', async ({ request, daemon }) => {
   399→      const responses = await Promise.all([
   400→        request.get(`${daemon.baseUrl}/api/tasks`),
   401→        request.get(`${daemon.baseUrl}/api/tasks/@test-task-ready`),
   402→      ]);
   403→
   404→      for (const response of responses) {
   405→        const contentType = response.headers()['content-type'] || '';
   406→        expect(contentType).toContain('application/json');
   407→      }
   408→    });
   409→
   410→    // AC: @api-contract ac-2 - items have consistent shape across list and detail
   411→    test('list and detail responses have consistent task fields', async ({ request, daemon }) => {
   412→      // Get list
   413→      const listResponse = await request.get(`${daemon.baseUrl}/api/tasks`);
   414→      const listBody = await listResponse.json();
   415→      expect(listBody.items.length).toBeGreaterThan(0);
   416→
   417→      const listTask = listBody.items[0];
   418→      expect(listTask._ulid).toBeTruthy();
   419→
   420→      // Get detail by ULID
   421→      const detailResponse = await request.get(`${daemon.baseUrl}/api/tasks/@${listTask._ulid}`);
   422→      expect(detailResponse.status()).toBe(200);
   423→      const detailTask = await detailResponse.json();
   424→
   425→      // Core fields should be consistent
   426→      expect(detailTask._ulid).toBe(listTask._ulid);
   427→      expect(detailTask.title).toBe(listTask.title);
   428→      expect(detailTask.status).toBe(listTask.status);
   429→    });
   430→  });
   431→});
