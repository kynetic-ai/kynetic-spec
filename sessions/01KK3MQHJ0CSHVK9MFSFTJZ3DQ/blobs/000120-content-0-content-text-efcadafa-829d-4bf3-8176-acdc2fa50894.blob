     1→/**
     2→ * E2E API Tests for Daemon Tasks Endpoints
     3→ *
     4→ * Tests verify actual HTTP behavior by calling the running daemon directly.
     5→ * These replace the static analysis tests in tests/daemon-api-tasks.test.ts
     6→ * which only read source files and check string patterns.
     7→ *
     8→ * Covered ACs:
     9→ * - @api-contract ac-2: GET /api/tasks returns tasks with expected fields
    10→ * - @api-contract ac-3: GET /api/tasks?status filter (multi-value)
    11→ * - @api-contract ac-4: GET /api/tasks pagination {items, total, offset, limit}
    12→ * - @api-contract ac-5: GET /api/tasks/:ref returns full task with notes, todos, deps
    13→ * - @api-contract ac-6: POST /api/tasks/:ref/start transitions to in_progress
    14→ * - @api-contract ac-7: POST /api/tasks/:ref/note appends note
    15→ */
    16→
    17→import { test, expect } from '../fixtures/test-base';
    18→
    19→test.describe('Tasks API', () => {
    20→  test.describe('GET /api/tasks', () => {
    21→    // AC: @api-contract ac-2
    22→    test('returns tasks with required fields', async ({ request, daemon }) => {
    23→      const response = await request.get(`${daemon.baseUrl}/api/tasks`);
    24→
    25→      expect(response.status()).toBe(200);
    26→
    27→      const body = await response.json();
    28→
    29→      // Response should have items array (paginated format)
    30→      expect(body).toHaveProperty('items');
    31→      expect(body).toHaveProperty('total');
    32→      expect(body).toHaveProperty('offset');
    33→      expect(body).toHaveProperty('limit');
    34→      expect(Array.isArray(body.items)).toBe(true);
    35→      expect(body.items.length).toBeGreaterThan(0);
    36→
    37→      // Each task should have required fields
    38→      const task = body.items[0];
    39→      expect(task).toHaveProperty('_ulid');
    40→      expect(task).toHaveProperty('title');
    41→      expect(task).toHaveProperty('status');
    42→      expect(task).toHaveProperty('priority');
    43→      // notes_count is derived field
    44→      expect(task).toHaveProperty('notes_count');
    45→    });
    46→
    47→    // AC: @api-contract ac-2 - spec_ref field
    48→    test('returns spec_ref on tasks that have it', async ({ request, daemon }) => {
    49→      const response = await request.get(`${daemon.baseUrl}/api/tasks`);
    50→      expect(response.status()).toBe(200);
    51→
    52→      const body = await response.json();
    53→      expect(Array.isArray(body.items)).toBe(true);
    54→      // Fixtures include tasks with spec_ref — at least one must have it
    55→      expect(body.items.length).toBeGreaterThan(0);
    56→
    57→      // Find a task with spec_ref (fixture has tasks with @test-feature)
    58→      const taskWithSpecRef = body.items.find(
    59→        (t: { spec_ref?: string }) => t.spec_ref !== undefined && t.spec_ref !== null
    60→      );
    61→      expect(taskWithSpecRef).toBeDefined();
    62→      expect(typeof taskWithSpecRef.spec_ref).toBe('string');
    63→      expect(taskWithSpecRef.spec_ref).toMatch(/^@/);
    64→    });
    65→
    66→    // AC: @api-contract ac-3 - status filter (single value)
    67→    test('filters tasks by single status value', async ({ request, daemon }) => {
    68→      const response = await request.get(`${daemon.baseUrl}/api/tasks?status=pending`);
    69→      expect(response.status()).toBe(200);
    70→
    71→      const body = await response.json();
    72→      expect(Array.isArray(body.items)).toBe(true);
    73→      // Fixtures have pending tasks
    74→      expect(body.items.length).toBeGreaterThan(0);
    75→
    76→      // All returned tasks should have pending status
    77→      for (const task of body.items) {
    78→        expect(task.status).toBe('pending');
    79→      }
    80→    });
    81→
    82→    // AC: @api-contract ac-3 - status filter (multi-value, repeated param)
    83→    test('filters tasks by multiple status values using repeated param', async ({
    84→      request,
    85→      daemon,
    86→    }) => {
    87→      const response = await request.get(
    88→        `${daemon.baseUrl}/api/tasks?status=pending&status=in_progress`
    89→      );
    90→      expect(response.status()).toBe(200);
    91→
    92→      const body = await response.json();
    93→      expect(Array.isArray(body.items)).toBe(true);
    94→      // Fixtures have both pending and in_progress tasks
    95→      expect(body.items.length).toBeGreaterThan(0);
    96→
    97→      // All returned tasks should have pending or in_progress status
    98→      for (const task of body.items) {
    99→        expect(['pending', 'in_progress']).toContain(task.status);
   100→      }
   101→    });
   102→
   103→    // AC: @api-contract ac-3 - comma-separated status filter
   104→    test('filters tasks by comma-separated status values', async ({ request, daemon }) => {
   105→      const response = await request.get(
   106→        `${daemon.baseUrl}/api/tasks?status=pending,in_progress`
   107→      );
   108→      expect(response.status()).toBe(200);
   109→
   110→      const body = await response.json();
   111→      expect(Array.isArray(body.items)).toBe(true);
   112→      // Fixtures have pending and in_progress tasks — filter must return non-empty
   113→      expect(body.items.length).toBeGreaterThan(0);
   114→
   115→      // All returned tasks should match the filter
   116→      for (const task of body.items) {
   117→        expect(['pending', 'in_progress']).toContain(task.status);
   118→      }
   119→    });
   120→
   121→    // AC: @api-contract ac-4 - pagination shape
   122→    test('returns paginated response with {items, total, offset, limit}', async ({
   123→      request,
   124→      daemon,
   125→    }) => {
   126→      const response = await request.get(`${daemon.baseUrl}/api/tasks?offset=0&limit=2`);
   127→      expect(response.status()).toBe(200);
   128→
   129→      const body = await response.json();
   130→      expect(body).toHaveProperty('items');
   131→      expect(body).toHaveProperty('total');
   132→      expect(body).toHaveProperty('offset');
   133→      expect(body).toHaveProperty('limit');
   134→
   135→      expect(typeof body.total).toBe('number');
   136→      expect(body.offset).toBe(0);
   137→      expect(body.limit).toBe(2);
   138→      expect(body.items.length).toBeLessThanOrEqual(2);
   139→    });
   140→
   141→    // AC: @api-contract ac-4 - pagination offset
   142→    test('respects offset parameter for pagination', async ({ request, daemon }) => {
   143→      // Get first page
   144→      const page1 = await request.get(`${daemon.baseUrl}/api/tasks?offset=0&limit=2`);
   145→      expect(page1.status()).toBe(200);
   146→      const body1 = await page1.json();
   147→
   148→      // Fixtures have 5 tasks — there must be more than 2 for pagination to be meaningful
   149→      expect(body1.total).toBeGreaterThan(2);
   150→      expect(body1.items.length).toBe(2);
   151→
   152→      // Get second page
   153→      const page2 = await request.get(`${daemon.baseUrl}/api/tasks?offset=2&limit=2`);
   154→      expect(page2.status()).toBe(200);
   155→      const body2 = await page2.json();
   156→
   157→      // Pages should have different items
   158→      const ids1 = body1.items.map((t: { _ulid: string }) => t._ulid);
   159→      const ids2 = body2.items.map((t: { _ulid: string }) => t._ulid);
   160→      // No overlap between pages
   161→      for (const id of ids2) {
   162→        expect(ids1).not.toContain(id);
   163→      }
   164→    });
   165→
   166→    // AC: @api-contract ac-4 - total count is consistent
   167→    test('total count is consistent across paginated requests', async ({ request, daemon }) => {
   168→      const response1 = await request.get(`${daemon.baseUrl}/api/tasks?offset=0&limit=2`);
   169→      const response2 = await request.get(`${daemon.baseUrl}/api/tasks?offset=2&limit=2`);
   170→
   171→      const body1 = await response1.json();
   172→      const body2 = await response2.json();
   173→
   174→      // Total should be the same across pages
   175→      expect(body1.total).toBe(body2.total);
   176→    });
   177→  });
   178→
   179→  test.describe('GET /api/tasks/:ref', () => {
   180→    // AC: @api-contract ac-5 - resolve by slug
   181→    test('resolves task by slug and returns full task', async ({ request, daemon }) => {
   182→      // Use a known task slug from fixtures
   183→      const response = await request.get(`${daemon.baseUrl}/api/tasks/@test-task-ready`);
   184→      expect(response.status()).toBe(200);
   185→
   186→      const task = await response.json();
   187→      expect(task).toHaveProperty('_ulid');
   188→      expect(task).toHaveProperty('title');
   189→      expect(task).toHaveProperty('status');
   190→      expect(task).toHaveProperty('priority');
   191→      expect(task).toHaveProperty('notes');
   192→      expect(task).toHaveProperty('todos');
   193→      expect(task).toHaveProperty('depends_on');
   194→    });
   195→
   196→    // AC: @api-contract ac-5 - returns notes array
   197→    test('returns task with notes array', async ({ request, daemon }) => {
   198→      // test-task-in-progress has a note in the fixture
   199→      const response = await request.get(`${daemon.baseUrl}/api/tasks/@test-task-in-progress`);
   200→      expect(response.status()).toBe(200);
   201→
   202→      const task = await response.json();
   203→      expect(Array.isArray(task.notes)).toBe(true);
   204→      expect(task.notes.length).toBeGreaterThan(0);
   205→
   206→      const note = task.notes[0];
   207→      expect(note).toHaveProperty('_ulid');
   208→      expect(note).toHaveProperty('content');
   209→      expect(note).toHaveProperty('created_at');
   210→    });
   211→
   212→    // AC: @api-contract ac-5 - returns dependencies
   213→    test('returns task with depends_on array', async ({ request, daemon }) => {
   214→      // test-task-blocked depends on test-task-ready
   215→      const response = await request.get(`${daemon.baseUrl}/api/tasks/@test-task-blocked`);
   216→      expect(response.status()).toBe(200);
   217→
   218→      const task = await response.json();
   219→      expect(Array.isArray(task.depends_on)).toBe(true);
   220→      expect(task.depends_on.length).toBeGreaterThan(0);
   221→    });
   222→
   223→    // AC: @api-contract ac-5 - resolve by full ULID
   224→    test('resolves task by full ULID', async ({ request, daemon }) => {
   225→      // First get the task list to find a ULID
   226→      const listResponse = await request.get(`${daemon.baseUrl}/api/tasks`);
   227→      const body = await listResponse.json();
   228→      expect(body.items.length).toBeGreaterThan(0);
   229→
   230→      const firstTask = body.items[0];
   231→      expect(firstTask._ulid).toBeTruthy();
   232→
   233→      // Get by full ULID
   234→      const response = await request.get(`${daemon.baseUrl}/api/tasks/@${firstTask._ulid}`);
   235→      expect(response.status()).toBe(200);
   236→
   237→      const task = await response.json();
   238→      expect(task._ulid).toBe(firstTask._ulid);
   239→      expect(task.title).toBe(firstTask.title);
   240→    });
   241→
   242→    // AC: @api-contract ac-5 (error handling) - 404 for invalid ref
   243→    test('returns 404 for non-existent task ref', async ({ request, daemon }) => {
   244→      const response = await request.get(`${daemon.baseUrl}/api/tasks/@nonexistent-task-xyz`);
   245→      expect(response.status()).toBe(404);
   246→
   247→      const body = await response.json();
   248→      expect(body).toHaveProperty('error');
   249→      expect(body.error).toBe('not_found');
   250→    });
   251→  });
   252→
   253→  test.describe('POST /api/tasks/:ref/start', () => {
   254→    // AC: @api-contract ac-6 - transition to in_progress
   255→    test('transitions pending task to in_progress', async ({ request, daemon }) => {
   256→      // Use a fresh fixture — test-task-ready starts as pending (daemon fixture is test-scoped)
   257→      const startResponse = await request.post(
   258→        `${daemon.baseUrl}/api/tasks/@test-task-ready/start`,
   259→        { data: {} }
   260→      );
   261→      expect(startResponse.status()).toBe(200);
   262→
   263→      const updatedTask = await startResponse.json();
   264→      expect(updatedTask.status).toBe('in_progress');
   265→      expect(updatedTask).toHaveProperty('started_at');
   266→      expect(updatedTask.started_at).toBeTruthy();
   267→    });
   268→
   269→    // AC: @api-contract ac-6 - returns full task shape in response
   270→    test('response includes full task shape after start', async ({ request, daemon }) => {
   271→      // Each test gets a fresh daemon fixture (test-scoped), so test-task-ready is pending again
   272→      const startResponse = await request.post(
   273→        `${daemon.baseUrl}/api/tasks/@test-task-ready/start`,
   274→        { data: {} }
   275→      );
   276→      // Fresh fixture — test-task-ready must be pending, so this must return 200
   277→      expect(startResponse.status()).toBe(200);
   278→
   279→      const task = await startResponse.json();
   280→      expect(task).toHaveProperty('_ulid');
   281→      expect(task).toHaveProperty('status');
   282→      expect(task.status).toBe('in_progress');
   283→      expect(task).toHaveProperty('title');
   284→      expect(task).toHaveProperty('started_at');
   285→    });
   286→
   287→    // AC: @api-contract ac-6 (error handling) - 404 for invalid ref
   288→    test('returns 404 for non-existent task', async ({ request, daemon }) => {
   289→      const response = await request.post(
   290→        `${daemon.baseUrl}/api/tasks/@nonexistent-task-xyz/start`,
   291→        { data: {} }
   292→      );
   293→      expect(response.status()).toBe(404);
   294→
   295→      const body = await response.json();
   296→      expect(body.error).toBe('not_found');
   297→    });
   298→
   299→    // AC: @api-contract ac-6 (error handling) - 409 for invalid state transition
   300→    test('returns 409 with transition info for invalid state transition', async ({
   301→      request,
   302→      daemon,
   303→    }) => {
   304→      // test-task-completed is in completed state — cannot be started
   305→      const response = await request.post(
   306→        `${daemon.baseUrl}/api/tasks/@test-task-completed/start`,
   307→        { data: {} }
   308→      );
   309→      expect(response.status()).toBe(409);
   310→
   311→      const body = await response.json();
   312→      expect(body).toHaveProperty('error');
   313→      expect(body.error).toBe('invalid_transition');
   314→      expect(body).toHaveProperty('current');
   315→      expect(body).toHaveProperty('valid_transitions');
   316→      expect(Array.isArray(body.valid_transitions)).toBe(true);
   317→    });
   318→  });
