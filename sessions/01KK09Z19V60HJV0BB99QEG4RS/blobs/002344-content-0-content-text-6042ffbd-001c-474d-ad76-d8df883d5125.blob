```
     1→<!--
     2→  AC: @ui-task-board ac-3 — Task detail modal with full task info.
     3→  AC: @ui-task-board ac-6 — Action buttons: Start, Submit, Complete, Block, Add Note.
     4→-->
     5→<script lang="ts">
     6→	import type { TaskDetail } from '@kynetic-ai/shared';
     7→	import { base } from '$app/paths';
     8→	import {
     9→		fetchTask,
    10→		startTask,
    11→		submitTask,
    12→		completeTask,
    13→		blockTask,
    14→		addTaskNote
    15→	} from '$lib/api';
    16→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    17→	import * as Dialog from '$lib/components/ui/dialog';
    18→	import { Badge } from '$lib/components/ui/badge';
    19→	import { Button } from '$lib/components/ui/button';
    20→	import { Textarea } from '$lib/components/ui/textarea';
    21→	import { Input } from '$lib/components/ui/input';
    22→	import { Separator } from '$lib/components/ui/separator';
    23→	import { Skeleton } from '$lib/components/ui/skeleton';
    24→	import { getStatusClasses, formatAge, formatVcsRef } from './board-utils';
    25→	import GitBranch from '@lucide/svelte/icons/git-branch';
    26→	import ExternalLink from '@lucide/svelte/icons/external-link';
    27→
    28→	let {
    29→		open = $bindable(false),
    30→		taskRef = $bindable<string | null>(null),
    31→		onTaskUpdated
    32→	}: {
    33→		open?: boolean;
    34→		taskRef?: string | null;
    35→		onTaskUpdated?: () => void;
    36→	} = $props();
    37→
    38→	let task = $state<TaskDetail | null>(null);
    39→	let loading = $state(false);
    40→	let error = $state('');
    41→	let actionError = $state('');
    42→	let isSubmitting = $state(false);
    43→
    44→	// Note form
    45→	let noteContent = $state('');
    46→
    47→	// Block/Complete reason form
    48→	let reasonInput = $state('');
    49→	let showReasonFor = $state<'block' | 'complete' | null>(null);
    50→
    51→	$effect(() => {
    52→		if (open && taskRef) {
    53→			loadTask(taskRef);
    54→		} else if (!open) {
    55→			task = null;
    56→			error = '';
    57→			actionError = '';
    58→			noteContent = '';
    59→			reasonInput = '';
    60→			showReasonFor = null;
    61→		}
    62→	});
    63→
    64→	async function loadTask(ref: string) {
    65→		loading = true;
    66→		error = '';
    67→		try {
    68→			task = await fetchTask(ref);
    69→		} catch (err) {
    70→			error = err instanceof Error ? err.message : 'Failed to load task';
    71→		} finally {
    72→			loading = false;
    73→		}
    74→	}
    75→
    76→	async function reloadAndNotify() {
    77→		if (task) {
    78→			task = await fetchTask(task._ulid);
    79→		}
    80→		onTaskUpdated?.();
    81→	}
    82→
    83→	async function handleAction(action: () => Promise<void>) {
    84→		isSubmitting = true;
    85→		actionError = '';
    86→		try {
    87→			await action();
    88→			await reloadAndNotify();
    89→		} catch (err) {
    90→			if (err instanceof ReadOnlyModeError) {
    91→				actionError = err.message;
    92→			} else {
    93→				actionError = err instanceof Error ? err.message : 'Action failed';
    94→			}
    95→		} finally {
    96→			isSubmitting = false;
    97→		}
    98→	}
    99→
   100→	function handleStart() {
   101→		if (!task) return;
   102→		handleAction(() => startTask(task!._ulid));
   103→	}
   104→
   105→	function handleSubmit() {
   106→		if (!task) return;
   107→		handleAction(() => submitTask(task!._ulid));
   108→	}
   109→
   110→	function handleComplete() {
   111→		if (!task || !reasonInput.trim()) return;
   112→		const reason = reasonInput.trim();
   113→		handleAction(async () => {
   114→			await completeTask(task!._ulid, reason);
   115→			reasonInput = '';
   116→			showReasonFor = null;
   117→		});
   118→	}
   119→
   120→	function handleBlock() {
   121→		if (!task || !reasonInput.trim()) return;
   122→		const reason = reasonInput.trim();
   123→		handleAction(async () => {
   124→			await blockTask(task!._ulid, reason);
   125→			reasonInput = '';
   126→			showReasonFor = null;
   127→		});
   128→	}
   129→
   130→	function handleAddNote() {
   131→		if (!task || !noteContent.trim()) return;
   132→		const content = noteContent.trim();
   133→		handleAction(async () => {
   134→			await addTaskNote(task!._ulid, content);
   135→			noteContent = '';
   136→		});
   137→	}
   138→
   139→	function formatDate(dateStr: string): string {
   140→		return new Intl.DateTimeFormat('en-US', {
   141→			month: 'short',
   142→			day: 'numeric',
   143→			hour: '2-digit',
   144→			minute: '2-digit'
   145→		}).format(new Date(dateStr));
   146→	}
   147→
   148→	let statusInfo = $derived(task ? getStatusClasses(task.status) : null);
   149→	let slug = $derived(task?.slugs?.[0] ?? task?._ulid?.slice(0, 8) ?? '');
   150→</script>
   151→
   152→<Dialog.Root bind:open>
   153→	<Dialog.Content class="max-w-2xl max-h-[85vh] overflow-y-auto" data-testid="task-detail-modal">
   154→		{#if loading}
   155→			<div class="flex flex-col gap-4 py-4" data-testid="task-detail-skeleton">
   156→				<!-- Title skeleton -->
   157→				<Skeleton class="h-6 w-3/4 ds-shimmer" />
   158→				<Skeleton class="h-3 w-24 ds-shimmer" />
   159→
   160→				<!-- Status/priority badges skeleton -->
   161→				<div class="flex gap-2">
   162→					<Skeleton class="h-5 w-20 rounded-full ds-shimmer" />
   163→					<Skeleton class="h-5 w-24 rounded-full ds-shimmer" />
   164→				</div>
   165→
   166→				<!-- Spec ref skeleton -->
   167→				<div>
   168→					<Skeleton class="h-3 w-10 mb-1 ds-shimmer" />
   169→					<Skeleton class="h-4 w-32 ds-shimmer" />
   170→				</div>
   171→
   172→				<!-- Tags skeleton -->
   173→				<div class="flex gap-1">
   174→					<Skeleton class="h-5 w-12 rounded-full ds-shimmer" />
   175→					<Skeleton class="h-5 w-16 rounded-full ds-shimmer" />
   176→				</div>
   177→
   178→				<!-- Separator -->
   179→				<Skeleton class="h-px w-full ds-shimmer" />
   180→
   181→				<!-- Notes skeleton -->
   182→				<div>
   183→					<Skeleton class="h-3 w-16 mb-2 ds-shimmer" />
   184→					<Skeleton class="h-16 w-full rounded-md ds-shimmer" />
   185→				</div>
   186→			</div>
   187→		{:else if error}
   188→			<div class="bg-destructive/10 text-destructive p-4 rounded-lg" role="alert">
   189→				{error}
   190→			</div>
   191→		{:else if task && statusInfo}
   192→			<Dialog.Header>
   193→				<Dialog.Title data-testid="modal-task-title">{task.title}</Dialog.Title>
   194→				<Dialog.Description>
   195→					<span class="font-mono text-xs">@{slug}</span>
   196→				</Dialog.Description>
   197→			</Dialog.Header>
   198→
   199→			<div class="flex flex-col gap-4">
   200→				<!-- AC: @ui-task-board ac-3 — Description -->
   201→				{#if task.description}
   202→					<p class="text-sm text-muted-foreground" data-testid="modal-description">
   203→						{task.description}
   204→					</p>
   205→				{/if}
   206→
   207→				<!-- Status, priority, type -->
   208→				<div class="flex flex-wrap gap-2 items-center">
   209→					<Badge class="{statusInfo.bg} {statusInfo.fg}" data-testid="modal-status-badge">
   210→						{statusInfo.label}
   211→					</Badge>
   212→					<Badge variant="outline" data-testid="modal-priority">Priority {task.priority}</Badge>
   213→					<Badge variant="outline" data-testid="modal-type">{task.type}</Badge>
   214→					{#if task.automation}
   215→						<Badge variant="secondary" data-testid="modal-automation">
   216→							{task.automation}
   217→						</Badge>
   218→					{/if}
   219→				</div>
   220→
   221→				<!-- Spec ref -->
   222→				{#if task.spec_ref}
   223→					<div data-testid="modal-spec-ref">
   224→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Spec</p>
   225→						<a
   226→							href="{base}/specs?ref={encodeURIComponent(task.spec_ref)}"
   227→							class="text-sm text-primary hover:underline font-mono"
   228→						>
   229→							{task.spec_ref}
   230→						</a>
   231→					</div>
   232→				{/if}
   233→
   234→				<!-- Tags -->
   235→				{#if task.tags?.length > 0}
   236→					<div>
   237→						<p class="text-xs font-medium text-muted-foreground mb-1">Tags</p>
   238→						<div class="flex flex-wrap gap-1">
   239→							{#each task.tags as tag}
   240→								<Badge variant="secondary">{tag}</Badge>
   241→							{/each}
   242→						</div>
   243→					</div>
   244→				{/if}
   245→
   246→				<!-- Dependencies -->
   247→				{#if task.depends_on?.length > 0}
   248→					<div data-testid="modal-dependencies">
   249→						<p class="text-xs font-medium text-muted-foreground mb-1">Dependencies</p>
   250→						<ul class="text-sm space-y-0.5">
   251→							{#each task.depends_on as dep}
   252→								<li>
   253→									<a
   254→										href="{base}/tasks/board?ref={encodeURIComponent(dep)}"
   255→										class="text-primary hover:underline font-mono text-xs"
   256→									>
   257→										{dep}
   258→									</a>
   259→								</li>
   260→							{/each}
   261→						</ul>
   262→					</div>
   263→				{/if}
   264→
   265→				<!-- Blocked by -->
   266→				{#if task.blocked_by?.length > 0}
   267→					<div data-testid="modal-blocked-by">
   268→						<p class="text-xs font-medium text-destructive mb-1">Blocked By</p>
   269→						<ul class="text-sm space-y-0.5">
   270→							{#each task.blocked_by as blocker}
   271→								<li class="text-muted-foreground font-mono text-xs">{blocker}</li>
   272→							{/each}
   273→						</ul>
   274→					</div>
   275→				{/if}
   276→
   277→				<!-- AC: @ui-task-board ac-3 — VCS info (branch, PR link) -->
   278→				{#if task.vcs_refs?.length > 0}
   279→					<div data-testid="modal-vcs">
   280→						<p class="text-xs font-medium text-muted-foreground mb-1">VCS</p>
   281→						<ul class="text-sm space-y-1">
   282→							{#each task.vcs_refs as ref}
   283→								{@const vcsInfo = formatVcsRef(ref)}
   284→								<li class="flex items-center gap-1.5">
   285→									<GitBranch class="size-3 text-muted-foreground flex-shrink-0" />
   286→									{#if vcsInfo.url}
   287→										<a
   288→											href={vcsInfo.url}
   289→											target="_blank"
   290→											rel="noopener noreferrer"
   291→											class="text-xs text-primary hover:underline font-mono inline-flex items-center gap-1"
   292→										>
   293→											{vcsInfo.label}
   294→											<ExternalLink class="size-3" />
   295→										</a>
   296→									{:else}
   297→										<span class="text-muted-foreground font-mono text-xs">{vcsInfo.label}</span>
   298→									{/if}
   299→								</li>
   300→							{/each}
   301→						</ul>
   302→					</div>
   303→				{/if}
   304→
   305→				<!-- AC: @ui-task-board ac-3 — Plan ref -->
   306→				{#if task.plan_ref}
   307→					<div data-testid="modal-plan-ref">
   308→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Plan</p>
   309→						<span class="text-sm text-primary font-mono">{task.plan_ref}</span>
   310→					</div>
   311→				{:else if task.derivation}
   312→					<div data-testid="modal-plan-ref">
   313→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Derivation</p>
   314→						<p class="text-sm text-muted-foreground">{task.derivation}</p>
   315→					</div>
   316→				{/if}
   317→
   318→				<!-- AC: @ui-task-board ac-3 — Session link -->
   319→				{#if task.session_ref}
   320→					<div data-testid="modal-session-link">
   321→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Session</p>
   322→						<a
   323→							href="{base}/sessions?ref={encodeURIComponent(task.session_ref)}"
   324→							class="text-sm text-primary hover:underline font-mono"
   325→						>
   326→							{task.session_ref}
   327→						</a>
   328→					</div>
   329→				{/if}
   330→
   331→				<Separator />
   332→
   333→				<!-- AC: @ui-task-board ac-6 — Actions -->
   334→				{#if !isStaticMode()}
   335→					<div class="flex flex-wrap gap-2" data-testid="modal-actions">
   336→						{#if task.status === 'pending'}
   337→							<Button
   338→								size="sm"
   339→								onclick={handleStart}
   340→								disabled={isSubmitting}
   341→								data-testid="action-start"
   342→							>
   343→								{isSubmitting ? 'Starting...' : 'Start'}
   344→							</Button>
   345→						{/if}
   346→
   347→						{#if task.status === 'in_progress' || task.status === 'needs_work'}
   348→							<Button
   349→								size="sm"
   350→								onclick={handleSubmit}
   351→								disabled={isSubmitting}
   352→								data-testid="action-submit"
   353→							>
   354→								{isSubmitting ? 'Submitting...' : 'Submit for Review'}
   355→							</Button>
   356→						{/if}
   357→
   358→						{#if task.status === 'in_progress' || task.status === 'pending_review'}
   359→							<Button
   360→								size="sm"
   361→								variant="outline"
   362→								onclick={() => {
   363→									showReasonFor = 'complete';
   364→									reasonInput = '';
   365→								}}
   366→								disabled={isSubmitting}
   367→								data-testid="action-complete-toggle"
   368→							>
   369→								Complete
   370→							</Button>
   371→						{/if}
   372→
   373→						{#if task.status !== 'blocked' && task.status !== 'completed' && task.status !== 'cancelled'}
   374→							<Button
   375→								size="sm"
   376→								variant="destructive"
   377→								onclick={() => {
   378→									showReasonFor = 'block';
   379→									reasonInput = '';
   380→								}}
   381→								disabled={isSubmitting}
   382→								data-testid="action-block-toggle"
   383→							>
   384→								Block
   385→							</Button>
   386→						{/if}
   387→					</div>
   388→
   389→					<!-- Reason input for block/complete -->
   390→					{#if showReasonFor}
   391→						<div class="flex gap-2" data-testid="reason-input">
   392→							<Input
   393→								bind:value={reasonInput}
   394→								placeholder="{showReasonFor === 'block' ? 'Block' : 'Completion'} reason..."
   395→								class="flex-1"
   396→							/>
   397→							<Button
   398→								size="sm"
   399→								onclick={showReasonFor === 'block' ? handleBlock : handleComplete}
   400→								disabled={isSubmitting || !reasonInput.trim()}
   401→							>
   402→								Confirm
   403→							</Button>
   404→							<Button
   405→								size="sm"
   406→								variant="ghost"
   407→								onclick={() => {
   408→									showReasonFor = null;
   409→									reasonInput = '';
   410→								}}
   411→							>
   412→								Cancel
   413→							</Button>
   414→						</div>
   415→					{/if}
   416→				{/if}
   417→
   418→				{#if actionError}
   419→					<p class="text-sm text-destructive" data-testid="action-error">{actionError}</p>
   420→				{/if}
   421→
   422→				<Separator />
   423→
   424→				<!-- Todos -->
   425→				{#if task.todos && task.todos.length > 0}
   426→					<div data-testid="modal-todos">
   427→						<p class="text-xs font-medium text-muted-foreground mb-1">
   428→							Todos ({task.todos.length})
   429→						</p>
   430→						<ul class="space-y-1">
   431→							{#each task.todos as todo}
   432→								<li class="flex items-start gap-2 text-sm">
   433→									<span class="mt-0.5 text-xs">
   434→										{#if todo.done}
   435→											&#x2705;
   436→										{:else}
   437→											&#x23F8;&#xFE0F;
   438→										{/if}
   439→									</span>
   440→									<span class:line-through={todo.done}>
   441→										{todo.text}
   442→									</span>
   443→								</li>
   444→							{/each}
   445→						</ul>
   446→					</div>
   447→					<Separator />
   448→				{/if}
   449→
   450→				<!-- Notes -->
   451→				<div data-testid="modal-notes">
   452→					<p class="text-xs font-medium text-muted-foreground mb-2">
   453→						Notes ({task.notes?.length ?? 0})
   454→					</p>
   455→
   456→					<!-- Add Note form -->
   457→					{#if !isStaticMode()}
   458→						<div class="mb-3 space-y-2" data-testid="modal-add-note">
   459→							<Textarea
   460→								placeholder="Add a note..."
   461→								bind:value={noteContent}
   462→								disabled={isSubmitting}
   463→								rows={2}
   464→							/>
   465→							<Button
   466→								size="sm"
   467→								onclick={handleAddNote}
   468→								disabled={isSubmitting || !noteContent.trim()}
   469→								data-testid="action-add-note"
   470→							>
   471→								{isSubmitting ? 'Adding...' : 'Add Note'}
   472→							</Button>
   473→						</div>
   474→					{/if}
   475→
   476→					<!-- Notes list -->
   477→					<div class="space-y-3">
   478→						{#if (task.notes ?? []).length === 0}
   479→							<div class="text-center py-4 text-muted-foreground text-xs" data-testid="notes-empty">
   480→								{#if isStaticMode()}
   481→									No notes recorded. Use <code class="bg-muted px-1 rounded">kspec task note</code> to add context.
   482→								{:else}
   483→									Add a note above to document decisions, progress, or findings.
   484→								{/if}
   485→							</div>
   486→						{:else}
   487→							{#each task.notes ?? [] as note}
   488→								<div class="border rounded-md p-2.5" data-testid="note-item">
   489→									<div class="flex justify-between items-start mb-1">
   490→										<span class="text-[10px] text-muted-foreground">{note.author}</span>
   491→										<span class="text-[10px] text-muted-foreground">{formatDate(note.created_at)}</span>
   492→									</div>
   493→									<p class="text-sm whitespace-pre-wrap">{note.content}</p>
   494→								</div>
   495→							{/each}
   496→						{/if}
   497→					</div>
   498→				</div>
   499→			</div>
   500→		{/if}
   501→	</Dialog.Content>
   502→</Dialog.Root>
   503→
```