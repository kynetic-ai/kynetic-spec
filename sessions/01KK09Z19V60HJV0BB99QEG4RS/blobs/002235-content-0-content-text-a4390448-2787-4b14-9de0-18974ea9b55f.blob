```
     1→/**
     2→ * Task API Routes
     3→ *
     4→ * REST endpoints for task operations:
     5→ * - GET /api/tasks - list with filters and pagination
     6→ * - GET /api/tasks/:ref - get single task
     7→ * - POST /api/tasks/:ref/start - start task
     8→ * - POST /api/tasks/:ref/note - add note
     9→ *
    10→ * AC Coverage:
    11→ * - ac-2: GET /api/tasks returns array with status, priority, spec_ref, notes count
    12→ * - ac-3: Status filter with multi-value support
    13→ * - ac-4: Pagination with {items, total, offset, limit} wrapper
    14→ * - ac-5: GET /api/tasks/:ref resolves via ReferenceIndex
    15→ * - ac-6: POST /api/tasks/:ref/start transitions state
    16→ * - ac-7: POST /api/tasks/:ref/note appends note
    17→ * - @ui-task-board ac-6: POST /api/tasks/:ref/submit transitions to pending_review
    18→ * - @ui-task-board ac-6: POST /api/tasks/:ref/complete transitions to completed
    19→ * - @ui-task-board ac-6: POST /api/tasks/:ref/block transitions to blocked
    20→ */
    21→
    22→import { Elysia, t } from 'elysia';
    23→import {
    24→  initContext,
    25→  loadAllTasks,
    26→  loadAllItems,
    27→  ReferenceIndex,
    28→  createNote,
    29→  saveTask,
    30→  getAuthor,
    31→  syncSpecImplementationStatus,
    32→  type LoadedTask,
    33→} from '../../parser/index.js';
    34→import { commitIfShadow } from '../../parser/shadow.js';
    35→import type { PubSubManager } from '../websocket/pubsub';
    36→
    37→interface TasksRouteOptions {
    38→  pubsub: PubSubManager;
    39→}
    40→
    41→export function createTasksRoutes(options: TasksRouteOptions) {
    42→  const { pubsub } = options;
    43→
    44→  return new Elysia({ prefix: '/api/tasks' })
    45→    // AC: @api-contract ac-2, ac-3, ac-4 - List tasks with filters and pagination
    46→    .get(
    47→      '/',
    48→      async ({ query, projectContext }) => {
    49→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
    50→        const ctx = await initContext(projectContext.path);
    51→        const tasks = await loadAllTasks(ctx);
    52→        const specItems = await loadAllItems(ctx);
    53→        const index = new ReferenceIndex(tasks, specItems);
    54→
    55→        // Apply filters
    56→        let filtered = tasks;
    57→
    58→        // AC: @api-contract ac-3 - Multi-value status filter
    59→        if (query.status) {
    60→          const statusFilters = Array.isArray(query.status) ? query.status : [query.status];
    61→          filtered = filtered.filter((task) => statusFilters.includes(task.status));
    62→        }
    63→
    64→        // Type filter (optional, not in ACs but useful)
    65→        if (query.type) {
    66→          const typeFilters = Array.isArray(query.type) ? query.type : [query.type];
    67→          filtered = filtered.filter((task) => task.type && typeFilters.includes(task.type));
    68→        }
    69→
    70→        // Tag filter (optional, not in ACs but useful)
    71→        if (query.tag) {
    72→          const tagFilters = Array.isArray(query.tag) ? query.tag : [query.tag];
    73→          filtered = filtered.filter((task) =>
    74→            task.tags?.some((t) => tagFilters.includes(t))
    75→          );
    76→        }
    77→
    78→        // AC: @api-contract ac-4 - Pagination
    79→        const total = filtered.length;
    80→        const offset = Number(query.offset) || 0;
    81→        const limit = Number(query.limit) || total;
    82→
    83→        const paginated = filtered.slice(offset, offset + limit);
    84→
    85→        // AC: @api-contract ac-2 - Return with status, priority, spec_ref, notes count
    86→        // AC: @web-dashboard ac-1 - Include depends_on for blocked task computation
    87→        const items = paginated.map((task) => ({
    88→          _ulid: task._ulid,
    89→          slugs: task.slugs,
    90→          title: task.title,
    91→          type: task.type || 'task',
    92→          status: task.status,
    93→          priority: task.priority,
    94→          spec_ref: task.spec_ref,
    95→          meta_ref: task.meta_ref,
    96→          tags: task.tags,
    97→          depends_on: task.depends_on || [],
    98→          notes_count: task.notes?.length || 0,
    99→          todos_count: task.todos?.length || 0,
   100→          automation: task.automation,
   101→          started_at: task.started_at,
   102→          completed_at: task.completed_at,
   103→          created_at: task.created_at,
   104→        }));
   105→
   106→        // AC: @api-contract ac-4, @trait-api-endpoint ac-4 - Return pagination wrapper
   107→        return {
   108→          items,
   109→          total,
   110→          offset,
   111→          limit,
   112→        };
   113→      },
   114→      {
   115→        query: t.Object({
   116→          status: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   117→          type: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   118→          tag: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   119→          limit: t.Optional(t.String()),
   120→          offset: t.Optional(t.String()),
   121→        }),
   122→      }
   123→    )
   124→
   125→    // AC: @api-contract ac-5 - Get single task by ref
   126→    .get(
   127→      '/:ref',
   128→      async ({ params, error: errorResponse, projectContext }) => {
   129→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   130→        const ctx = await initContext(projectContext.path);
   131→        const tasks = await loadAllTasks(ctx);
   132→        const items = await loadAllItems(ctx);
   133→        const index = new ReferenceIndex(tasks, items);
   134→
   135→        // AC: @api-contract ac-5, @trait-api-endpoint ac-2 - Resolve ref via ReferenceIndex
   136→        const result = index.resolve(params.ref);
   137→
   138→        if (!result.ok) {
   139→          // AC: @trait-api-endpoint ac-2 - Return 404 with error details
   140→          return errorResponse(404, {
   141→            error: 'not_found',
   142→            message: `Task reference "${params.ref}" not found`,
   143→            suggestion: 'Use kspec task list or kspec search to find valid task references',
   144→          });
   145→        }
   146→
   147→        // Find the task
   148→        const task = tasks.find((t) => t._ulid === result.ulid);
   149→        if (!task) {
   150→          return errorResponse(404, {
   151→            error: 'not_found',
   152→            message: `Reference "${params.ref}" is not a task`,
   153→            suggestion: 'This reference might point to a spec item instead',
   154→          });
   155→        }
   156→
   157→        // AC: @api-contract ac-5 - Return full task with notes, todos, dependencies
   158→        // AC: @ui-task-board ac-3 - Include type, description, blocked_by, vcs_refs, plan_ref, session_ref
   159→        return {
   160→          _ulid: task._ulid,
   161→          slugs: task.slugs,
   162→          title: task.title,
   163→          type: task.type || 'task',
   164→          status: task.status,
   165→          priority: task.priority,
   166→          spec_ref: task.spec_ref,
   167→          meta_ref: task.meta_ref,
   168→          tags: task.tags,
   169→          description: task.description,
   170→          derivation: task.derivation,
   171→          depends_on: task.depends_on,
   172→          blocked_by: task.blocked_by || [],
   173→          context: task.context || [],
   174→          vcs_refs: (task.vcs_refs || []).map((v) =>
   175→            typeof v === 'string' ? v : v.type ? `${v.type}:${v.ref}` : v.ref
   176→          ),
   177→          plan_ref: task.plan_ref,
   178→          session_ref: task.session_id,
   179→          notes: task.notes,
   180→          notes_count: task.notes?.length || 0,
   181→          todos: task.todos,
   182→          todos_count: task.todos?.length || 0,
   183→          started_at: task.started_at,
   184→          completed_at: task.completed_at,
   185→          cancelled_at: task.cancelled_at,
   186→          closed_reason: task.closed_reason,
   187→          automation: task.automation,
   188→          created_at: task.created_at,
   189→        };
   190→      },
   191→      {
   192→        params: t.Object({
   193→          ref: t.String(),
   194→        }),
   195→      }
   196→    )
   197→
   198→    // AC: @api-contract ac-6 - Start task
   199→    .post(
   200→      '/:ref/start',
   201→      async ({ params, error: errorResponse, projectContext }) => {
   202→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   203→        const ctx = await initContext(projectContext.path);
   204→        const tasks = await loadAllTasks(ctx);
   205→        const items = await loadAllItems(ctx);
   206→        const index = new ReferenceIndex(tasks, items);
   207→
   208→        // Resolve ref
   209→        const result = index.resolve(params.ref);
   210→        if (!result.ok) {
   211→          return errorResponse(404, {
   212→            error: 'not_found',
   213→            message: `Task reference "${params.ref}" not found`,
   214→            suggestion: 'Use kspec task list to find valid task references',
   215→          });
   216→        }
   217→
   218→        const task = tasks.find((t) => t._ulid === result.ulid);
   219→        if (!task) {
   220→          return errorResponse(404, {
   221→            error: 'not_found',
   222→            message: `Reference "${params.ref}" is not a task`,
   223→          });
   224→        }
   225→
   226→        // AC: @api-contract ac-6 - Transition to in_progress
   227→        if (task.status === 'in_progress') {
   228→          return errorResponse(409, {
   229→            error: 'invalid_transition',
   230→            message: 'Task is already in_progress',
   231→            current: task.status,
   232→            valid_transitions: ['blocked', 'pending_review', 'completed', 'cancelled'],
   233→          });
   234→        }
   235→
   236→        // Update task status
   237→        const updatedTask: LoadedTask = {
   238→          ...task,
   239→          status: 'in_progress',
   240→          started_at: task.started_at || new Date().toISOString(),
   241→        };
   242→
   243→        // Save and commit
   244→        await saveTask(ctx, updatedTask);
   245→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   246→        await commitIfShadow(ctx.shadow, `task: start ${params.ref}`);
   247→
   248→        // AC: @api-contract ac-6, @trait-api-endpoint ac-5 - WebSocket broadcast
   249→        // AC: @multi-directory-daemon ac-18 - Broadcast scoped to request project
   250→        pubsub.broadcast('tasks:updates', 'task_updated', {
   251→          ref: params.ref,
   252→          ulid: task._ulid,
   253→          action: 'start',
   254→          status: 'in_progress',
   255→        }, projectContext.path);
   256→
   257→        // AC: @api-contract ac-6 - Return updated task
   258→        return updatedTask;
   259→      },
   260→      {
   261→        params: t.Object({
   262→          ref: t.String(),
   263→        }),
   264→      }
   265→    )
   266→
   267→    // AC: @api-contract ac-7 - Add note to task
   268→    .post(
   269→      '/:ref/note',
   270→      async ({ params, body, error: errorResponse, projectContext }) => {
   271→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   272→        const ctx = await initContext(projectContext.path);
   273→        const tasks = await loadAllTasks(ctx);
   274→        const items = await loadAllItems(ctx);
   275→        const index = new ReferenceIndex(tasks, items);
   276→
   277→        // Resolve ref
   278→        const result = index.resolve(params.ref);
   279→        if (!result.ok) {
   280→          return errorResponse(404, {
   281→            error: 'not_found',
   282→            message: `Task reference "${params.ref}" not found`,
   283→          });
   284→        }
   285→
   286→        const task = tasks.find((t) => t._ulid === result.ulid);
   287→        if (!task) {
   288→          return errorResponse(404, {
   289→            error: 'not_found',
   290→            message: `Reference "${params.ref}" is not a task`,
   291→          });
   292→        }
   293→
   294→        // AC: @trait-api-endpoint ac-3 - Validate body
   295→        if (!body.content || typeof body.content !== 'string') {
   296→          return errorResponse(400, {
   297→            error: 'validation_error',
   298→            details: [
   299→              {
   300→                field: 'content',
   301→                message: 'Content is required and must be a string',
   302→              },
   303→            ],
   304→          });
   305→        }
   306→
   307→        // AC: @api-contract ac-7 - Append note
   308→        const author = getAuthor(ctx.config?.identity?.author);
   309→        const note = createNote(body.content, author);
   310→
   311→        const updatedTask: LoadedTask = {
   312→          ...task,
   313→          notes: [...(task.notes || []), note],
   314→        };
   315→
   316→        // AC: @api-contract ac-7, @trait-api-endpoint ac-5 - Shadow commit
   317→        await saveTask(ctx, updatedTask);
   318→        await commitIfShadow(ctx.shadow, `task: add note to ${params.ref}`);
   319→
   320→        // AC: @api-contract ac-7 - WebSocket broadcast
   321→        // AC: @multi-directory-daemon ac-18 - Broadcast scoped to request project
   322→        pubsub.broadcast('tasks:updates', 'task_updated', {
   323→          ref: params.ref,
   324→          ulid: task._ulid,
   325→          action: 'note_added',
   326→          note_ulid: note._ulid,
   327→        }, projectContext.path);
   328→
   329→        return {
   330→          success: true,
   331→          note,
   332→          task: updatedTask,
   333→        };
   334→      },
   335→      {
   336→        params: t.Object({
   337→          ref: t.String(),
   338→        }),
   339→        body: t.Object({
   340→          content: t.String(),
   341→        }),
   342→      }
   343→    )
   344→
   345→    // AC: @ui-task-board ac-6 - Submit task for review
   346→    .post(
   347→      '/:ref/submit',
   348→      async ({ params, error: errorResponse, projectContext }) => {
   349→        const ctx = await initContext(projectContext.path);
   350→        const tasks = await loadAllTasks(ctx);
   351→        const items = await loadAllItems(ctx);
   352→        const index = new ReferenceIndex(tasks, items);
   353→
   354→        const result = index.resolve(params.ref);
   355→        if (!result.ok) {
   356→          return errorResponse(404, {
   357→            error: 'not_found',
   358→            message: `Task reference "${params.ref}" not found`,
   359→          });
   360→        }
   361→
   362→        const task = tasks.find((t) => t._ulid === result.ulid);
   363→        if (!task) {
   364→          return errorResponse(404, {
   365→            error: 'not_found',
   366→            message: `Reference "${params.ref}" is not a task`,
   367→          });
   368→        }
   369→
   370→        if (task.status !== 'in_progress' && task.status !== 'needs_work') {
   371→          return errorResponse(409, {
   372→            error: 'invalid_transition',
   373→            message: `Cannot submit task with status "${task.status}". Must be in_progress or needs_work.`,
   374→            current: task.status,
   375→            valid_transitions: ['pending_review'],
   376→          });
   377→        }
   378→
   379→        const updatedTask: LoadedTask = { ...task, status: 'pending_review' };
   380→        await saveTask(ctx, updatedTask);
   381→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   382→        await commitIfShadow(ctx.shadow, `task: submit ${params.ref}`);
   383→
   384→        pubsub.broadcast('tasks:updates', 'task_updated', {
   385→          ref: params.ref,
   386→          ulid: task._ulid,
   387→          action: 'submit',
   388→          status: 'pending_review',
   389→        }, projectContext.path);
   390→
   391→        return updatedTask;
   392→      },
   393→      { params: t.Object({ ref: t.String() }) }
   394→    )
   395→
   396→    // AC: @ui-task-board ac-6 - Complete task
   397→    .post(
   398→      '/:ref/complete',
   399→      async ({ params, body, error: errorResponse, projectContext }) => {
   400→        const ctx = await initContext(projectContext.path);
   401→        const tasks = await loadAllTasks(ctx);
   402→        const items = await loadAllItems(ctx);
   403→        const index = new ReferenceIndex(tasks, items);
   404→
   405→        const result = index.resolve(params.ref);
   406→        if (!result.ok) {
   407→          return errorResponse(404, {
   408→            error: 'not_found',
   409→            message: `Task reference "${params.ref}" not found`,
   410→          });
   411→        }
   412→
   413→        const task = tasks.find((t) => t._ulid === result.ulid);
   414→        if (!task) {
   415→          return errorResponse(404, {
   416→            error: 'not_found',
   417→            message: `Reference "${params.ref}" is not a task`,
   418→          });
   419→        }
   420→
   421→        const updatedTask: LoadedTask = {
   422→          ...task,
   423→          status: 'completed',
   424→          completed_at: new Date().toISOString(),
   425→          closed_reason: body.reason,
   426→        };
   427→        await saveTask(ctx, updatedTask);
   428→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   429→        await commitIfShadow(ctx.shadow, `task: complete ${params.ref}`);
   430→
   431→        pubsub.broadcast('tasks:updates', 'task_updated', {
   432→          ref: params.ref,
   433→          ulid: task._ulid,
   434→          action: 'complete',
   435→          status: 'completed',
   436→        }, projectContext.path);
   437→
   438→        return updatedTask;
   439→      },
   440→      {
   441→        params: t.Object({ ref: t.String() }),
   442→        body: t.Object({ reason: t.String() }),
   443→      }
   444→    )
   445→
   446→    // AC: @ui-task-board ac-6 - Block task
   447→    .post(
   448→      '/:ref/block',
   449→      async ({ params, body, error: errorResponse, projectContext }) => {
   450→        const ctx = await initContext(projectContext.path);
   451→        const tasks = await loadAllTasks(ctx);
   452→        const items = await loadAllItems(ctx);
   453→        const index = new ReferenceIndex(tasks, items);
   454→
   455→        const result = index.resolve(params.ref);
   456→        if (!result.ok) {
   457→          return errorResponse(404, {
   458→            error: 'not_found',
   459→            message: `Task reference "${params.ref}" not found`,
   460→          });
   461→        }
   462→
   463→        const task = tasks.find((t) => t._ulid === result.ulid);
   464→        if (!task) {
   465→          return errorResponse(404, {
   466→            error: 'not_found',
   467→            message: `Reference "${params.ref}" is not a task`,
   468→          });
   469→        }
   470→
   471→        const author = getAuthor(ctx.config?.identity?.author);
   472→        const note = createNote(`Blocked: ${body.reason}`, author);
   473→
   474→        const updatedTask: LoadedTask = {
   475→          ...task,
   476→          status: 'blocked',
   477→          notes: [...(task.notes || []), note],
   478→        };
   479→        await saveTask(ctx, updatedTask);
   480→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   481→        await commitIfShadow(ctx.shadow, `task: block ${params.ref}`);
   482→
   483→        pubsub.broadcast('tasks:updates', 'task_updated', {
   484→          ref: params.ref,
   485→          ulid: task._ulid,
   486→          action: 'block',
   487→          status: 'blocked',
   488→        }, projectContext.path);
   489→
   490→        return updatedTask;
   491→      },
   492→      {
   493→        params: t.Object({ ref: t.String() }),
   494→        body: t.Object({ reason: t.String() }),
   495→      }
   496→    );
   497→}
   498→
```