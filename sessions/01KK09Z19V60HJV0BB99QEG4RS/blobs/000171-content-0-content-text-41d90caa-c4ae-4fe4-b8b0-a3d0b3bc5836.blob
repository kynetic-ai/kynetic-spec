   276→	// AC: @ui-task-board ac-6
   277→	test('Complete action transitions task to completed with reason', async ({ page, daemon }) => {
   278→		await page.goto('/tasks/board');
   279→		await expect(page.getByTestId('board-columns')).toBeVisible();
