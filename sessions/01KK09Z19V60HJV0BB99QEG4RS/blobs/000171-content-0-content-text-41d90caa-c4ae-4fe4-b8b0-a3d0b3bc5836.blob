   144→	// AC: @ui-task-board ac-1
   145→	test('shows empty state when no tasks exist', async ({ page }) => {
   146→		// Navigate to board (if daemon has no tasks it should show empty state)
   147→		// This test verifies the empty state component renders
   148→		await page.goto('/tasks/board');
   149→
   150→		// Either board columns or empty state should be visible
   151→		const columns = page.getByTestId('board-columns');
   152→		const empty = page.getByTestId('board-empty');
   153→
   154→		// Wait for either to appear
   155→		await expect(columns.or(empty)).toBeVisible();
   156→	});
   157→
   158→	// AC: @ui-task-board ac-5
   159→	test('board updates after task mutation without page refresh', async ({ page, daemon }) => {
   160→		await page.goto('/tasks/board');
   161→		await expect(page.getByTestId('board-columns')).toBeVisible();
   162→
   163→		// Find a pending task card and note its column
   164→		const backlogColumn = page.locator('[data-column-id="backlog"]');
   165→		await expect(backlogColumn).toBeVisible();
   166→		const taskCards = backlogColumn.getByTestId('task-card');
   167→		const initialBacklogCount = await taskCards.count();
   168→
   169→		// Start a pending task via API directly (simulating external state change)
   170→		// Use the ready task which is in pending status
   171→		const startResponse = await page.request.post(
   172→			`${daemon.baseUrl}/api/tasks/01KG0RR6CA45ZT43W2T6HJMVA1/start`
   173→		);
   174→		expect(startResponse.ok()).toBeTruthy();
   175→
   176→		// Wait for the board to update (WebSocket notification or polling triggers reload)
   177→		// The task should move from backlog to in_progress column
   178→		const inProgressColumn = page.locator('[data-column-id="in_progress"]');
   179→		await expect(async () => {
   180→			const inProgressCards = await inProgressColumn.getByTestId('task-card').count();
   181→			expect(inProgressCards).toBeGreaterThan(0);
   182→		}).toPass({ timeout: 10000 });
   183→	});
   184→
