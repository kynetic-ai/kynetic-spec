   361→	// AC: @ui-task-board ac-4
   362→	test('active fleet row shows running agents with title, agent name, elapsed, output, and pulse', async ({
   363→		page,
   364→		daemon
   365→	}) => {
   366→		const mockAgentStatus = {
   367→			dispatch_enabled: true,
   368→			active_invocations: [
   369→				{
   370→					session_id: 'test-session-001',
   371→					agent_id: 'task-worker',
   372→					task_ref: '@01KG0RR8CB8N4YGP991WD7XS9R',
   373→					elapsed_ms: 125000 // 2m 5s
   374→				}
   375→			],
   376→			queue_depth: 0,
   377→			agent_definitions: [
   378→				{ id: 'task-worker', name: 'Task Worker', adapter: 'claude-agent-acp' }
   379→			]
   380→		};
   381→
   382→		await page.route('**/api/agent/status', async (route) => {
   383→			await route.fulfill({
   384→				status: 200,
   385→				contentType: 'application/json',
   386→				body: JSON.stringify(mockAgentStatus)
   387→			});
   388→		});
   389→
   390→		await page.goto('/tasks/board');
   391→		await expect(page.getByTestId('board-columns')).toBeVisible();
   392→
   393→		const fleetRow = page.getByTestId('active-fleet-row');
   394→		await expect(fleetRow).toBeVisible();
   395→
   396→		const fleetCard = page.getByTestId('fleet-card');
   397→		await expect(fleetCard).toBeVisible();
   398→
   399→		// Agent name should be resolved from agent_definitions (not raw agent_id)
   400→		const agentName = page.getByTestId('fleet-agent-name');
   401→		await expect(agentName).toBeVisible();
   402→		await expect(agentName).toHaveText('Task Worker');
   403→
   404→		const taskTitle = page.getByTestId('fleet-task-title');
   405→		await expect(taskTitle).toBeVisible();
   406→		await expect(taskTitle).toHaveText('In progress task');
   407→
   408→		await expect(fleetCard.getByText('2m 5s')).toBeVisible();
   409→
   410→		// Pulse indicator should be visible (animated dot with ds-breathe class)
   411→		const pulseIndicator = fleetCard.locator('.ds-breathe').first();
   412→		await expect(pulseIndicator).toBeVisible();
   413→
   414→		// Empty output placeholder should be visible initially
   415→		const outputEmpty = page.getByTestId('fleet-output-empty');
   416→		await expect(outputEmpty).toBeVisible();
   417→		await expect(outputEmpty).toHaveText(/Awaiting output/);
   418→	});
