```
     1→import { test, expect } from '../fixtures/test-base';
     2→
     3→/**
     4→ * Task Board (Kanban) E2E Tests
     5→ *
     6→ * Tests for the Kanban-style task board view.
     7→ *
     8→ * Covered ACs:
     9→ * - AC-1: Tasks distributed into columns by status
    10→ * - AC-2: Task cards show priority, tags, title, slug, spec ref, metadata
    11→ * - AC-3: Clicking card opens detail modal with full task info
    12→ * - AC-4: Active Fleet row shows running agents
    13→ * - AC-5: Real-time updates via WebSocket
    14→ * - AC-6: Action buttons in detail modal execute mutations via API
    15→ */
    16→
    17→test.describe('Task Board (Kanban)', () => {
    18→	// AC: @ui-task-board ac-1
    19→	test('renders board with five columns', async ({ page, daemon }) => {
    20→		await page.goto('/tasks/board');
    21→
    22→		// Wait for board to load
    23→		const columns = page.getByTestId('board-column');
    24→		await expect(columns.first()).toBeVisible();
    25→
    26→		// Should have 5 columns: Backlog, Ready, In Progress, Review, Done
    27→		await expect(columns).toHaveCount(5);
    28→	});
    29→
    30→	// AC: @ui-task-board ac-1
    31→	test('distributes tasks into correct columns based on status', async ({ page, daemon }) => {
    32→		await page.goto('/tasks/board');
    33→
    34→		const boardColumns = page.getByTestId('board-columns');
    35→		await expect(boardColumns).toBeVisible();
    36→
    37→		// Verify columns exist by their IDs
    38→		await expect(page.locator('[data-column-id="backlog"]')).toBeVisible();
    39→		await expect(page.locator('[data-column-id="ready"]')).toBeVisible();
    40→		await expect(page.locator('[data-column-id="in_progress"]')).toBeVisible();
    41→		await expect(page.locator('[data-column-id="review"]')).toBeVisible();
    42→		await expect(page.locator('[data-column-id="done"]')).toBeVisible();
    43→	});
    44→
    45→	// AC: @ui-task-board ac-2
    46→	test('task card shows priority badge, title, slug, and metadata', async ({ page, daemon }) => {
    47→		await page.goto('/tasks/board');
    48→
    49→		// Find first task card
    50→		const card = page.getByTestId('task-card').first();
    51→		await expect(card).toBeVisible();
    52→
    53→		// Verify card contents
    54→		await expect(card.getByTestId('priority-badge')).toBeVisible();
    55→		await expect(card.getByTestId('task-title')).toBeVisible();
    56→		await expect(card.getByTestId('task-slug')).toBeVisible();
    57→		await expect(card.getByTestId('task-metadata')).toBeVisible();
    58→	});
    59→
    60→	// AC: @ui-task-board ac-3
    61→	test('clicking a task card opens the detail modal', async ({ page, daemon }) => {
    62→		await page.goto('/tasks/board');
    63→
    64→		// Click first task card
    65→		const card = page.getByTestId('task-card').first();
    66→		await expect(card).toBeVisible();
    67→		await card.click();
    68→
    69→		// Verify modal opened
    70→		const modal = page.getByTestId('task-detail-modal');
    71→		await expect(modal).toBeVisible();
    72→
    73→		// Modal should show task title
    74→		await expect(page.getByTestId('modal-task-title')).toBeVisible();
    75→		// Modal should show status badge
    76→		await expect(page.getByTestId('modal-status-badge')).toBeVisible();
    77→		// Modal should show priority
    78→		await expect(page.getByTestId('modal-priority')).toBeVisible();
    79→	});
    80→
    81→	// AC: @ui-task-board ac-3
    82→	test('detail modal shows full task info: type, deps, todos, automation, VCS, plan, session', async ({
    83→		page,
    84→		daemon
    85→	}) => {
    86→		await page.goto('/tasks/board');
    87→
    88→		// Click the in-progress task card — enriched fixture with all AC-3 required fields
    89→		const inProgressColumn = page.locator('[data-column-id="in_progress"]');
    90→		await expect(inProgressColumn).toBeVisible();
    91→		const card = inProgressColumn.getByTestId('task-card').first();
    92→		await expect(card).toBeVisible();
    93→		await card.click();
    94→
    95→		const modal = page.getByTestId('task-detail-modal');
    96→		await expect(modal).toBeVisible();
    97→
    98→		// Title
    99→		await expect(page.getByTestId('modal-task-title')).toHaveText('In progress task');
   100→
   101→		// Description
   102→		await expect(page.getByTestId('modal-description')).toBeVisible();
   103→
   104→		// Status badge
   105→		await expect(page.getByTestId('modal-status-badge')).toHaveText('In Progress');
   106→
   107→		// Priority
   108→		await expect(page.getByTestId('modal-priority')).toContainText('Priority');
   109→
   110→		// Type (AC-3 requires type to be shown)
   111→		await expect(page.getByTestId('modal-type')).toBeVisible();
   112→		await expect(page.getByTestId('modal-type')).toHaveText('task');
   113→
   114→		// Spec ref
   115→		await expect(page.getByTestId('modal-spec-ref')).toBeVisible();
   116→
   117→		// Automation status
   118→		await expect(page.getByTestId('modal-automation')).toBeVisible();
   119→		await expect(page.getByTestId('modal-automation')).toHaveText('eligible');
   120→
   121→		// Dependencies (fixture has depends_on: @test-task-ready)
   122→		await expect(page.getByTestId('modal-dependencies')).toBeVisible();
   123→
   124→		// VCS info (fixture has branch + PR refs)
   125→		await expect(page.getByTestId('modal-vcs')).toBeVisible();
   126→
   127→		// Plan ref (fixture has plan_ref: @test-plan)
   128→		await expect(page.getByTestId('modal-plan-ref')).toBeVisible();
   129→
   130→		// Session link (fixture has session_id: session-abc123)
   131→		await expect(page.getByTestId('modal-session-link')).toBeVisible();
   132→		// Verify session link targets /sessions route (not /session)
   133→		const sessionLink = page.getByTestId('modal-session-link').locator('a');
   134→		await expect(sessionLink).toHaveAttribute('href', /\/sessions\?ref=/);
   135→
   136→
   137→		// Todos (fixture has 2 todos)
   138→		await expect(page.getByTestId('modal-todos')).toBeVisible();
   139→
   140→		// Notes section
   141→		await expect(page.getByTestId('modal-notes')).toBeVisible();
   142→	});
