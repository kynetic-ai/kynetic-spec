```
     1→/**
     2→ * Kspec Daemon Server
     3→ *
     4→ * Elysia.js HTTP server with WebSocket support for real-time kspec state updates.
     5→ * Implements localhost-only security, file watching, and graceful shutdown.
     6→ */
     7→
     8→import { Elysia } from 'elysia';
     9→import { cors } from '@elysiajs/cors';
    10→import { staticPlugin } from '@elysiajs/static';
    11→import { ulid } from 'ulidx';
    12→import { existsSync } from 'fs';
    13→import { fileURLToPath } from 'url';
    14→import { dirname } from 'path';
    15→import { PubSubManager } from './websocket/pubsub';
    16→import { HeartbeatManager } from './websocket/heartbeat';
    17→import { WebSocketHandler } from './websocket/handler';
    18→import { handleWebSocketClose } from './websocket/lifecycle';
    19→import type { ConnectionData, ConnectedEvent } from './websocket/types';
    20→import { PidFileManager } from './pid';
    21→import { projectContextMiddleware } from './middleware/project-context';
    22→import { createTasksRoutes } from './routes/tasks';
    23→import { createItemsRoutes } from './routes/items';
    24→import { createInboxRoutes } from './routes/inbox';
    25→import { createMetaRoutes } from './routes/meta';
    26→import { createValidationRoutes } from './routes/validation';
    27→import { createProjectsRoutes } from './routes/projects';
    28→import { createTriageRoutes } from './routes/triage';
    29→import { createAgentDispatchRoutes, getDispatchEngine, stopAllEngines } from './routes/agent-dispatch';
    30→import { join } from 'path';
    31→
    32→export interface ServerOptions {
    33→  port: number;
    34→  isDaemon: boolean;
    35→  kspecDir?: string; // Path to .kspec directory (default: .kspec in cwd)
    36→  webUiDir?: string; // Path to web UI build directory (default: auto-detect)
    37→}
    38→
    39→/**
    40→ * Resolves the path to the web UI build directory.
    41→ * Tries multiple locations in order:
    42→ * 1. Explicit webUiDir option
    43→ * 2. WEB_UI_DIR environment variable
    44→ * 3. packages/web-ui/build in current working directory (monorepo dev)
    45→ * 4. web-ui/build in current working directory
    46→ * 5. Bundled dist/web-ui/ relative to this module (npm package installs)
    47→ *
    48→ * Exported for testing only.
    49→ */
    50→export function resolveWebUiPath(webUiDir?: string): string | null {
    51→  // 1. Explicit option
    52→  if (webUiDir && existsSync(webUiDir)) {
    53→    return webUiDir;
    54→  }
    55→
    56→  // 2. Environment variable
    57→  const envPath = process.env.WEB_UI_DIR;
    58→  if (envPath && existsSync(envPath)) {
    59→    return envPath;
    60→  }
    61→
    62→  // 3. Monorepo development: packages/web-ui/build from cwd
    63→  // The daemon is spawned with cwd set to project root
    64→  const monorepoPath = join(process.cwd(), 'packages', 'web-ui', 'build');
    65→  if (existsSync(monorepoPath)) {
    66→    return monorepoPath;
    67→  }
    68→
    69→  // 4. Alternate location: web-ui/build in cwd
    70→  const altPath = join(process.cwd(), 'web-ui', 'build');
    71→  if (existsSync(altPath)) {
    72→    return altPath;
    73→  }
    74→
    75→  // 5. Bundled assets: dist/web-ui/ relative to daemon module location
    76→  // Covers npm package installs where no local web UI build exists.
    77→  // import.meta.url resolves to dist/daemon/server.js → sibling is dist/web-ui/
    78→  const selfDir = dirname(fileURLToPath(import.meta.url));
    79→  const bundledPath = join(selfDir, '..', 'web-ui');
    80→  if (existsSync(bundledPath)) {
    81→    return bundledPath;
    82→  }
    83→
    84→  return null;
    85→}
    86→
    87→// WebSocket pub/sub and heartbeat managers
    88→let pubsubManager: PubSubManager;
    89→let heartbeatManager: HeartbeatManager;
    90→let wsHandler: WebSocketHandler;
    91→let projectManager: import('./project-context').ProjectContextManager | undefined;
    92→
    93→/**
    94→ * Middleware to enforce localhost-only connections.
    95→ * AC-3: Reject non-localhost connections with 403 Forbidden
    96→ */
    97→function localhostOnly() {
    98→  return (context: { request: Request }) => {
    99→    const host = context.request.headers.get('host');
   100→    if (!host) {
   101→      return new Response(JSON.stringify({
   102→        error: 'Forbidden',
   103→        message: 'This server only accepts connections from localhost'
   104→      }), {
   105→        status: 403,
   106→        headers: { 'Content-Type': 'application/json' }
   107→      });
   108→    }
   109→
   110→    // Extract hostname, handling IPv6 brackets
   111→    let hostname: string;
   112→    if (host.startsWith('[')) {
   113→      // IPv6 with brackets: [::1]:3456 -> ::1
   114→      const closeBracket = host.indexOf(']');
   115→      hostname = closeBracket > 0 ? host.substring(1, closeBracket) : host;
   116→    } else {
   117→      // IPv4 or hostname: localhost:3456 -> localhost
   118→      hostname = host.split(':')[0];
   119→    }
   120→
   121→    // Allow localhost, 127.0.0.1, and ::1
   122→    const isLocalhost =
   123→      hostname === 'localhost' ||
   124→      hostname === '127.0.0.1' ||
   125→      hostname === '::1';
   126→
   127→    if (!isLocalhost) {
   128→      return new Response(JSON.stringify({
   129→        error: 'Forbidden',
   130→        message: 'This server only accepts connections from localhost'
   131→      }), {
   132→        status: 403,
   133→        headers: { 'Content-Type': 'application/json' }
   134→      });
   135→    }
   136→  };
   137→}
   138→
   139→/**
   140→ * Creates and configures the Elysia server instance.
   141→ *
   142→ * AC Coverage:
   143→ * - ac-1: Server starts on configurable port (default 3456)
   144→ * - ac-2: Binds to localhost only (127.0.0.1 and ::1)
   145→ * - ac-3: Rejects non-localhost connections with 403
   146→ * - ac-15: Uses plugin pattern for middleware
   147→ */
   148→export async function createServer(options: ServerOptions) {
   149→  const { port, isDaemon, kspecDir = join(process.cwd(), '.kspec'), webUiDir } = options;
   150→
   151→  // Determine startup project path (project root, not .kspec/)
   152→  // AC: @multi-directory-daemon ac-2 - daemon uses startup directory as default project
   153→  const startupProjectPath = kspecDir.endsWith('.kspec')
   154→    ? kspecDir.slice(0, -('.kspec'.length + 1)) // Remove '/.kspec'
   155→    : kspecDir;
   156→
   157→  // Import ProjectContextManager (needed for WebSocket binding)
   158→  const { ProjectContextManager } = await import('./project-context');
   159→
   160→  // AC: @daemon-server ac-17 - Resolve web UI path for static file serving
   161→  const resolvedWebUiPath = resolveWebUiPath(webUiDir);
   162→  if (resolvedWebUiPath) {
   163→    console.log(`[daemon] Web UI assets found at: ${resolvedWebUiPath}`);
   164→  } else {
   165→    console.log('[daemon] Web UI assets not found - UI will not be served');
   166→    console.log('[daemon] Build the web UI with: cd packages/web-ui && npm run build');
   167→  }
   168→
   169→  // Initialize PID file manager (uses global ~/.config/kspec/)
   170→  const pidManager = new PidFileManager();
   171→
   172→  // AC: @multi-directory-daemon ac-9 - Write PID and port files in daemon mode
   173→  if (isDaemon) {
   174→    pidManager.writePid();
   175→    pidManager.writePort(port);
   176→    console.log(`[daemon] PID file written: ${process.pid}`);
   177→    console.log(`[daemon] Port file written: ${port}`);
   178→  }
   179→
   180→  // Initialize WebSocket managers
   181→  pubsubManager = new PubSubManager();
   182→  heartbeatManager = new HeartbeatManager();
   183→  wsHandler = new WebSocketHandler(pubsubManager);
   184→
   185→  // WeakMap to store project path during WebSocket upgrade (keyed by Request object)
   186→  // Using WeakMap avoids needing to pass a requestId through beforeHandle return value,
   187→  // which breaks WebSocket upgrade in Elysia 1.4 when derive middleware is present.
   188→  const wsProjectPaths = new WeakMap<Request, string>();
   189→
   190→  const app = new Elysia()
   191→    // AC-15: Plugin pattern for middleware
   192→    // AC: @api-contract ac-1 - Allow CORS from dev server on localhost:5173
   193→    .use(cors({
   194→      origin: ['http://localhost:5173', 'http://127.0.0.1:5173'], // Dev server origins
   195→      credentials: true,
   196→      methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS']
   197→    }))
   198→
   199→    // AC-3: Enforce localhost-only connections
   200→    .onRequest(localhostOnly());
   201→
   202→  // AC: @multi-directory-daemon ac-1, ac-2, ac-3 - Project context middleware
   203→  const { manager: projectContextManager, middleware: projectMiddleware } = projectContextMiddleware({
   204→    startupProject: startupProjectPath,
   205→    pubsub: pubsubManager
   206→  });
   207→
   208→  // Store manager globally for shutdown
   209→  projectManager = projectContextManager;
   210→
   211→  app.use(projectMiddleware)
   212→
   213→    // AC-11: Health check endpoint
   214→    .get('/api/health', () => ({
   215→      status: 'ok',
   216→      uptime: process.uptime(),
   217→      connections: pubsubManager.getConnectionCount(),
   218→      version: '0.1.0'
   219→    }))
   220→
   221→    // AC: @api-contract ac-2 through ac-7 - Task API endpoints
   222→    // AC: @multi-directory-daemon ac-24 - Routes use projectContext from middleware
   223→    .use(createTasksRoutes({ pubsub: pubsubManager }))
   224→
   225→    // AC: @api-contract ac-8 through ac-11 - Spec Item API endpoints
   226→    .use(createItemsRoutes())
   227→
   228→    // AC: @api-contract ac-12 through ac-14 - Inbox API endpoints
   229→    .use(createInboxRoutes({ pubsub: pubsubManager }))
   230→
   231→    // AC: @api-contract ac-15 through ac-18 - Meta API endpoints
   232→    .use(createMetaRoutes())
   233→
   234→    // AC: @triage-daemon-api ac-1 through ac-9 - Triage API endpoints
   235→    .use(createTriageRoutes({ pubsub: pubsubManager }))
   236→
   237→    // AC: @api-contract ac-19 through ac-21 - Validation and search endpoints
   238→    .use(createValidationRoutes())
   239→
   240→    // AC: @multi-directory-daemon ac-28, ac-29, ac-30 - Projects management endpoints
   241→    .use(createProjectsRoutes({ projectManager: projectContextManager }))
   242→
   243→    // AC: @agent-dispatch-engine ac-4 - Agent dispatch API endpoints
   244→    // AC: @daemon-agent-dispatch ac-3, ac-4 - Pass pubsub for WebSocket broadcast on invocation events
   245→    .use(createAgentDispatchRoutes({ pubsub: pubsubManager }))
   246→
   247→    // AC-4: WebSocket endpoint for real-time updates
   248→    .ws<ConnectionData>('/ws', {
   249→      beforeHandle({ request, store }) {
   250→        // AC: @multi-directory-daemon ac-21, ac-22, ac-23, ac-34 - Extract and validate project binding
   251→        // AC: @multi-directory-daemon ac-34 - Browser WebSocket API doesn't support custom headers,
   252→        // so we also accept project path as query parameter
   253→        const url = new URL(request.url, `http://${request.headers.get('host')}`);
   254→        const projectPath = request.headers.get('X-Kspec-Dir')
   255→                        || url.searchParams.get('project')
   256→                        || undefined;
   257→
   258→        // IMPORTANT: Do NOT return a value from ws beforeHandle.
   259→        // In Elysia 1.4 with derive middleware, returning a value short-circuits
   260→        // the WebSocket upgrade and sends the value as an HTTP 200 response.
   261→        // Use a WeakMap keyed by Request object to pass data to open().
   262→        try {
   263→          const manager = (store as Record<string, unknown>).projectManager as import('./project-context').ProjectContextManager | undefined;
   264→          if (!manager) {
   265→            // Fallback: project manager not initialized yet
   266→            wsProjectPaths.set(request, startupProjectPath);
   267→            return;
   268→          }
   269→
   270→          let projectContext;
   271→          if (projectPath) {
   272→            // Explicit project specified
   273→            try {
   274→              projectContext = manager.getProject(projectPath);
   275→            } catch {
   276→              // AC: @multi-directory-daemon ac-4 - auto-register
   277→              projectContext = manager.registerProject(projectPath);
   278→            }
   279→          } else {
   280→            // AC: @multi-directory-daemon ac-22, ac-23 - Use default or reject
   281→            try {
   282→              projectContext = manager.getProject();
   283→            } catch (err: unknown) {
   284→              // AC: @multi-directory-daemon ac-23 - Reject when no default
   285→              if (err instanceof Error && err.message.includes('No default project configured')) {
   286→                throw new Error('No project specified');
   287→              }
   288→              throw err;
   289→            }
   290→          }
   291→
   292→          // Store resolved path for open() handler via WeakMap
   293→          wsProjectPaths.set(request, projectContext.path);
   294→        } catch (err: unknown) {
   295→          console.error(`[daemon] WebSocket connection rejected: ${err instanceof Error ? err.message : String(err)}`);
   296→          throw err;
   297→        }
   298→      },
   299→      open(ws) {
   300→        // AC: @api-contract ac-25, @trait-websocket-protocol ac-1
   301→        const sessionId = ulid();
   302→        const openContext = ws.data as { id?: unknown; request?: unknown } | undefined;
   303→        const contextId = typeof openContext?.id === 'string' ? openContext.id : undefined;
   304→
   305→        // AC: @multi-directory-daemon ac-21 - Get bound project path
   306→        // Retrieve project path from WeakMap via the request object on ws.data
   307→        const request = openContext?.request as Request | undefined;
   308→        const projectPath = request ? wsProjectPaths.get(request) || startupProjectPath : startupProjectPath;
   309→
   310→        ws.data = {
   311→          sessionId,
   312→          topics: new Set<string>(),
   313→          seq: 0,
   314→          lastPing: undefined,
   315→          lastPong: Date.now(),
   316→          projectPath // AC: @multi-directory-daemon ac-21 - immutable binding
   317→        };
   318→
   319→        pubsubManager.addConnection(sessionId, ws, contextId);
   320→        console.log(`[daemon] WebSocket client connected: ${sessionId} bound to ${projectPath} (${pubsubManager.getConnectionCount()} total)`);
   321→
   322→        // Send connected event with session_id
   323→        const connectedEvent: ConnectedEvent = {
   324→          event: 'connected',
   325→          data: {
   326→            session_id: sessionId
   327→          }
   328→        };
   329→        ws.send(JSON.stringify(connectedEvent));
   330→      },
   331→      message(ws, message) {
   332→        // AC: @api-contract ac-26, ac-27
   333→        wsHandler.handleMessage(ws, message);
   334→      },
   335→      pong(ws) {
   336→        // AC: @trait-websocket-protocol ac-5
   337→        heartbeatManager.recordPong(ws);
   338→      },
   339→      close(ws, code, reason) {
   340→        handleWebSocketClose(pubsubManager, ws, code, reason);
   341→      }
   342→    });
   343→
   344→  // AC: @daemon-server ac-17 - Serve web UI static assets
   345→  // Added after API routes so API routes take precedence
   346→  if (resolvedWebUiPath) {
   347→    const indexHtmlPath = join(resolvedWebUiPath, 'index.html');
   348→
   349→    // Serve static files from web UI build directory
   350→    app.use(await staticPlugin({
   351→      assets: resolvedWebUiPath,
   352→      prefix: '/',
   353→      noCache: process.env.NODE_ENV === 'development', // Disable cache in dev
   354→    }));
   355→
   356→    // SPA fallback routes for client-side routing
   357→    // These catch paths like /tasks, /items, /inbox that don't have static files
   358→    const spaRoutes = ['/tasks', '/tasks/*', '/items', '/items/*', '/inbox', '/observations', '/triage'];
   359→    for (const route of spaRoutes) {
   360→      app.get(route, () => Bun.file(indexHtmlPath));
   361→    }
   362→
   363→    console.log('[daemon] Web UI static file serving enabled');
   364→  }
   365→
   366→  // AC-1, AC-2: Start server on localhost only
   367→  // Using 'localhost' hostname allows Bun/OS to bind to both 127.0.0.1 and ::1
   368→  app.listen({
   369→    port,
   370→    hostname: 'localhost', // Resolves to both IPv4 and IPv6 loopback
   371→  });
   372→
   373→  console.log(`[daemon] Server listening on http://localhost:${port} (IPv4: 127.0.0.1, IPv6: ::1)`);
   374→  console.log(`[daemon] WebSocket available at ws://localhost:${port}/ws`);
   375→
   376→  // AC: @agent-dispatch-engine ac-5 - Wire file change callback to dispatch engine
   377→  projectContextManager.setFileChangeCallback((projectPath, file) => {
   378→    // Only forward changes to project.tasks.yaml
   379→    if (!file.endsWith('project.tasks.yaml')) return;
   380→    const engine = getDispatchEngine(projectPath);
   381→    if (engine) {
   382→      engine.handleFileChange(projectPath).catch((err) => {
   383→        console.error('[dispatch] Error handling file change:', err);
   384→      });
   385→    }
   386→  });
   387→
   388→  // AC: @multi-directory-daemon ac-17 - Start file watcher for startup project
   389→  if (startupProjectPath) {
   390→    try {
   391→      await projectContextManager.startWatcher(startupProjectPath);
   392→      console.log(`[daemon] File watcher started for startup project: ${startupProjectPath}`);
   393→    } catch (error) {
   394→      console.error('[daemon] Failed to start file watcher for startup project:', error);
   395→    }
   396→  }
   397→
   398→  // AC: @daemon-server ac-13, ac-14 - Start heartbeat monitoring
   399→  heartbeatManager.start(pubsubManager.getAllConnections());
   400→
   401→  // AC-12: Graceful shutdown on SIGTERM/SIGINT
   402→  const shutdown = async (signal: string) => {
   403→    console.log(`[daemon] Received ${signal}, shutting down gracefully...`);
   404→
   405→    try {
   406→      // Stop heartbeat monitoring
   407→      heartbeatManager.stop();
   408→
   409→      // AC: @agent-dispatch-engine ac-11 - Stop all dispatch engines before shutting down
   410→      await stopAllEngines();
   411→
   412→      // AC: @multi-directory-daemon ac-11b - Stop all file watchers
   413→      await projectContextManager.stopAllWatchers();
   414→      console.log('[daemon] All file watchers stopped');
   415→
   416→      // Close all WebSocket connections with code 1000 (clean close)
   417→      // AC: @trait-websocket-protocol ac-7
   418→      for (const [sessionId, ws] of pubsubManager.getAllConnections()) {
   419→        ws.close(1000, 'Server shutting down');
   420→      }
   421→
   422→      // Stop the server
   423→      await app.server?.stop();
   424→
   425→      // AC: @daemon-server ac-10 - Remove PID file on shutdown
   426→      if (isDaemon) {
   427→        pidManager.remove();
   428→        console.log('[daemon] PID file removed');
   429→      }
   430→
   431→      console.log('[daemon] Server stopped successfully');
   432→      process.exit(0);
   433→    } catch (error) {
   434→      console.error('[daemon] Error during shutdown:', error);
   435→      process.exit(1);
   436→    }
   437→  };
   438→
   439→  process.on('SIGTERM', () => shutdown('SIGTERM'));
   440→  process.on('SIGINT', () => shutdown('SIGINT'));
   441→
   442→  return app;
   443→}
   444→
```