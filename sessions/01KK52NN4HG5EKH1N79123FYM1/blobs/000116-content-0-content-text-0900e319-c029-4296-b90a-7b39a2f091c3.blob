   122→diff --git a/packages/web-ui/src/lib/components/board/TaskDetailContent.svelte b/packages/web-ui/src/lib/components/board/TaskDetailContent.svelte
   123→new file mode 100644
   124→index 000000000..028203039
   125→--- /dev/null
   126→+++ b/packages/web-ui/src/lib/components/board/TaskDetailContent.svelte
   127→@@ -0,0 +1,458 @@
   128→+<!--
   129→+  AC: @web-dashboard ac-5 — Task detail content showing description, notes, todos, dependencies.
   130→+  AC: @web-dashboard ac-6 — Spec reference is clickable link to spec item detail.
   131→+  AC: @web-dashboard ac-7 — Start Task action button.
   132→+  AC: @web-dashboard ac-8 — Add Note textarea and submit.
   133→+
   134→+  Shared task detail content used by both TaskDetailModal (kanban board)
   135→+  and the task list Sheet panel. Handles all task display, actions, and notes.
   136→+-->
   137→+<script lang="ts">
   138→+	import type { TaskDetail } from '@kynetic-ai/shared';
   139→+	import {
   140→+		startTask,
   141→+		submitTask,
   142→+		completeTask,
   143→+		blockTask,
   144→+		addTaskNote
   145→+	} from '$lib/api';
   146→+	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
   147→+	import { Badge } from '$lib/components/ui/badge';
   148→+	import { Button } from '$lib/components/ui/button';
   149→+	import { Textarea } from '$lib/components/ui/textarea';
   150→+	import { Input } from '$lib/components/ui/input';
   151→+	import { Separator } from '$lib/components/ui/separator';
   152→+	import { Skeleton } from '$lib/components/ui/skeleton';
   153→+	import ReferenceLink from '$lib/components/ReferenceLink.svelte';
   154→+	import { getStatusClasses, formatVcsRef } from './board-utils';
   155→+	import GitBranch from '@lucide/svelte/icons/git-branch';
   156→+	import ExternalLink from '@lucide/svelte/icons/external-link';
   157→+
   158→+	interface Props {
   159→+		/** The task detail to display, or null if not yet loaded. */
   160→+		task: TaskDetail | null;
   161→+		/** Whether the task is currently loading. */
   162→+		loading: boolean;
   163→+		/** Error message to display, if any. */
   164→+		error: string;
   165→+		/** Called after a task action succeeds (start, submit, complete, block, add note). */
   166→+		onTaskUpdated?: (task: TaskDetail) => void;
   167→+	}
   168→+
   169→+	let { task, loading, error, onTaskUpdated }: Props = $props();
   170→+
   171→+	let actionError = $state('');
   172→+	let isSubmitting = $state(false);
   173→+
   174→+	// Note form
   175→+	let noteContent = $state('');
   176→+
   177→+	// Block/Complete reason form
   178→+	let reasonInput = $state('');
   179→+	let showReasonFor = $state<'block' | 'complete' | null>(null);
   180→+
   181→+	// Reset local state when task changes
   182→+	$effect(() => {
   183→+		if (task) {
   184→+			// Task changed, reset action-specific state
   185→+			actionError = '';
   186→+			noteContent = '';
   187→+			reasonInput = '';
   188→+			showReasonFor = null;
   189→+		}
   190→+	});
   191→+
   192→+	async function handleAction(action: () => Promise<void>) {
   193→+		if (!task) return;
   194→+		isSubmitting = true;
   195→+		actionError = '';
   196→+		try {
   197→+			await action();
   198→+			// Re-fetch is handled by the parent via onTaskUpdated
   199→+			onTaskUpdated?.(task);
   200→+		} catch (err) {
   201→+			if (err instanceof ReadOnlyModeError) {
   202→+				actionError = err.message;
   203→+			} else {
   204→+				actionError = err instanceof Error ? err.message : 'Action failed';
   205→+			}
   206→+		} finally {
   207→+			isSubmitting = false;
   208→+		}
   209→+	}
   210→+
   211→+	function handleStart() {
   212→+		if (!task) return;
   213→+		handleAction(() => startTask(task!._ulid));
   214→+	}
   215→+
   216→+	function handleSubmit() {
   217→+		if (!task) return;
   218→+		handleAction(() => submitTask(task!._ulid));
   219→+	}
   220→+
   221→+	function handleComplete() {
   222→+		if (!task || !reasonInput.trim()) return;
   223→+		const reason = reasonInput.trim();
   224→+		handleAction(async () => {
   225→+			await completeTask(task!._ulid, reason);
   226→+			reasonInput = '';
   227→+			showReasonFor = null;
   228→+		});
   229→+	}
   230→+
   231→+	function handleBlock() {
   232→+		if (!task || !reasonInput.trim()) return;
   233→+		const reason = reasonInput.trim();
   234→+		handleAction(async () => {
   235→+			await blockTask(task!._ulid, reason);
   236→+			reasonInput = '';
   237→+			showReasonFor = null;
   238→+		});
   239→+	}
   240→+
   241→+	function handleAddNote() {
   242→+		if (!task || !noteContent.trim()) return;
   243→+		const content = noteContent.trim();
   244→+		handleAction(async () => {
   245→+			await addTaskNote(task!._ulid, content);
   246→+			noteContent = '';
   247→+		});
   248→+	}
   249→+
   250→+	function formatDate(dateStr: string): string {
   251→+		return new Intl.DateTimeFormat('en-US', {
   252→+			month: 'short',
   253→+			day: 'numeric',
   254→+			hour: '2-digit',
   255→+			minute: '2-digit'
   256→+		}).format(new Date(dateStr));
   257→+	}
   258→+
   259→+	let statusInfo = $derived(task ? getStatusClasses(task.status) : null);
   260→+	let slug = $derived(task?.slugs?.[0] ?? task?._ulid?.slice(0, 8) ?? '');
   261→+</script>
   262→+
   263→+{#if loading}
   264→+	<div class="flex flex-col gap-4 py-4" data-testid="task-detail-skeleton">
   265→+		<Skeleton class="h-6 w-3/4 ds-shimmer" />
   266→+		<Skeleton class="h-3 w-24 ds-shimmer" />
   267→+		<div class="flex gap-2">
   268→+			<Skeleton class="h-5 w-20 rounded-full ds-shimmer" />
   269→+			<Skeleton class="h-5 w-24 rounded-full ds-shimmer" />
   270→+		</div>
   271→+		<div>
   272→+			<Skeleton class="h-3 w-10 mb-1 ds-shimmer" />
   273→+			<Skeleton class="h-4 w-32 ds-shimmer" />
   274→+		</div>
   275→+		<div class="flex gap-1">
   276→+			<Skeleton class="h-5 w-12 rounded-full ds-shimmer" />
   277→+			<Skeleton class="h-5 w-16 rounded-full ds-shimmer" />
   278→+		</div>
   279→+		<Skeleton class="h-px w-full ds-shimmer" />
   280→+		<div>
   281→+			<Skeleton class="h-3 w-16 mb-2 ds-shimmer" />
   282→+			<Skeleton class="h-16 w-full rounded-md ds-shimmer" />
   283→+		</div>
   284→+	</div>
   285→+{:else if error}
   286→+	<div class="bg-destructive/10 text-destructive p-4 rounded-lg" role="alert">
   287→+		{error}
   288→+	</div>
   289→+{:else if task && statusInfo}
   290→+	<div class="flex flex-col gap-4">
   291→+		<!-- Description -->
   292→+		{#if task.description}
   293→+			<p class="text-sm text-muted-foreground" data-testid="task-description">
   294→+				{task.description}
   295→+			</p>
   296→+		{/if}
   297→+
   298→+		<!-- Status, priority, type -->
   299→+		<div class="flex flex-wrap gap-2 items-center">
   300→+			<Badge class="{statusInfo.bg} {statusInfo.fg}" data-testid="task-status-badge">
   301→+				{statusInfo.label}
   302→+			</Badge>
   303→+			<Badge variant="outline" data-testid="task-priority">Priority {task.priority}</Badge>
   304→+			<Badge variant="outline" data-testid="task-type">{task.type}</Badge>
   305→+			{#if task.automation}
   306→+				<Badge variant="secondary" data-testid="task-automation">
   307→+					{task.automation}
   308→+				</Badge>
   309→+			{/if}
   310→+		</div>
   311→+
   312→+		<!-- Spec ref -->
   313→+		<!-- AC: @web-dashboard ac-6 -->
   314→+		{#if task.spec_ref}
   315→+			<div data-testid="task-spec-ref">
   316→+				<p class="text-xs font-medium text-muted-foreground mb-0.5">Spec</p>
   317→+				<ReferenceLink ref={task.spec_ref} type="spec" />
   318→+			</div>
   319→+		{/if}
   320→+
   321→+		<!-- Tags -->
   322→+		{#if task.tags?.length > 0}
   323→+			<div data-testid="task-tags">
   324→+				<p class="text-xs font-medium text-muted-foreground mb-1">Tags</p>
   325→+				<div class="flex flex-wrap gap-1">
   326→+					{#each task.tags as tag}
   327→+						<Badge variant="secondary">{tag}</Badge>
   328→+					{/each}
   329→+				</div>
   330→+			</div>
   331→+		{/if}
   332→+
   333→+		<!-- Dependencies -->
   334→+		<div data-testid="task-dependencies">
   335→+			{#if task.depends_on?.length > 0}
   336→+				<p class="text-xs font-medium text-muted-foreground mb-1">Dependencies</p>
   337→+				<ul class="text-sm space-y-0.5">
   338→+					{#each task.depends_on as dep}
   339→+						<li>
   340→+							<ReferenceLink ref={dep} type="task" class="text-xs" />
   341→+						</li>
   342→+					{/each}
   343→+				</ul>
   344→+			{:else}
   345→+				<p class="text-sm text-muted-foreground">No dependencies</p>
   346→+			{/if}
   347→+		</div>
   348→+
   349→+		<!-- Blocked by -->
   350→+		{#if task.blocked_by?.length > 0}
   351→+			<div data-testid="task-blocked-by">
   352→+				<p class="text-xs font-medium text-destructive mb-1">Blocked By</p>
   353→+				<ul class="text-sm space-y-0.5">
   354→+					{#each task.blocked_by as blocker}
   355→+						<li>
   356→+							<ReferenceLink ref={blocker} type="task" class="text-xs" />
   357→+						</li>
   358→+					{/each}
   359→+				</ul>
   360→+			</div>
   361→+		{/if}
   362→+
   363→+		<!-- VCS info (branch, PR link) -->
   364→+		{#if task.vcs_refs?.length > 0}
   365→+			<div data-testid="task-vcs">
   366→+				<p class="text-xs font-medium text-muted-foreground mb-1">VCS</p>
   367→+				<ul class="text-sm space-y-1">
   368→+					{#each task.vcs_refs as ref}
   369→+						{@const vcsInfo = formatVcsRef(ref)}
   370→+						<li class="flex items-center gap-1.5">
   371→+							<GitBranch class="size-3 text-muted-foreground flex-shrink-0" />
   372→+							{#if vcsInfo.url}
   373→+								<a
   374→+									href={vcsInfo.url}
   375→+									target="_blank"
   376→+									rel="noopener noreferrer"
   377→+									class="text-xs text-primary hover:underline font-mono inline-flex items-center gap-1"
   378→+								>
   379→+									{vcsInfo.label}
   380→+									<ExternalLink class="size-3" />
   381→+								</a>
   382→+							{:else}
   383→+								<span class="text-muted-foreground font-mono text-xs">{vcsInfo.label}</span>
   384→+							{/if}
   385→+						</li>
   386→+					{/each}
   387→+				</ul>
   388→+			</div>
   389→+		{/if}
   390→+
   391→+		<!-- Plan ref -->
   392→+		{#if task.plan_ref}
   393→+			<div data-testid="task-plan-ref">
   394→+				<p class="text-xs font-medium text-muted-foreground mb-0.5">Plan</p>
   395→+				<ReferenceLink ref={task.plan_ref} type="plan" />
   396→+			</div>
   397→+		{:else if task.derivation}
   398→+			<div data-testid="task-derivation">
   399→+				<p class="text-xs font-medium text-muted-foreground mb-0.5">Derivation</p>
   400→+				<p class="text-sm text-muted-foreground">{task.derivation}</p>
   401→+			</div>
   402→+		{/if}
   403→+
   404→+		<!-- Session link -->
   405→+		{#if task.session_ref}
   406→+			<div data-testid="task-session-ref">
   407→+				<p class="text-xs font-medium text-muted-foreground mb-0.5">Session</p>
   408→+				<ReferenceLink ref={task.session_ref} type="session" />
   409→+			</div>
   410→+		{/if}
   411→+
   412→+		<Separator />
   413→+
   414→+		<!-- Actions -->
   415→+		<!-- AC: @web-dashboard ac-7 -->
   416→+		{#if !isStaticMode()}
   417→+			<div class="flex flex-wrap gap-2" data-testid="task-actions">
   418→+				{#if task.status === 'pending'}
   419→+					<Button
   420→+						size="sm"
   421→+						onclick={handleStart}
   422→+						disabled={isSubmitting}
   423→+						data-testid="action-start"
   424→+					>
   425→+						{isSubmitting ? 'Starting...' : 'Start'}
   426→+					</Button>
   427→+				{/if}
   428→+
   429→+				{#if task.status === 'in_progress' || task.status === 'needs_work'}
   430→+					<Button
   431→+						size="sm"
   432→+						onclick={handleSubmit}
   433→+						disabled={isSubmitting}
   434→+						data-testid="action-submit"
   435→+					>
   436→+						{isSubmitting ? 'Submitting...' : 'Submit for Review'}
   437→+					</Button>
   438→+				{/if}
   439→+
   440→+				{#if task.status === 'in_progress' || task.status === 'pending_review'}
   441→+					<Button
   442→+						size="sm"
   443→+						variant="outline"
   444→+						onclick={() => {
   445→+							showReasonFor = 'complete';
   446→+							reasonInput = '';
   447→+						}}
   448→+						disabled={isSubmitting}
   449→+						data-testid="action-complete-toggle"
   450→+					>
   451→+						Complete
   452→+					</Button>
   453→+				{/if}
   454→+
   455→+				{#if task.status !== 'blocked' && task.status !== 'completed' && task.status !== 'cancelled'}
   456→+					<Button
   457→+						size="sm"
   458→+						variant="destructive"
   459→+						onclick={() => {
   460→+							showReasonFor = 'block';
   461→+							reasonInput = '';
   462→+						}}
   463→+						disabled={isSubmitting}
   464→+						data-testid="action-block-toggle"
   465→+					>
   466→+						Block
   467→+					</Button>
   468→+				{/if}
   469→+			</div>
   470→+
   471→+			<!-- Reason input for block/complete -->
   472→+			{#if showReasonFor}
   473→+				<div class="flex gap-2" data-testid="reason-input">
   474→+					<Input
   475→+						bind:value={reasonInput}
   476→+						placeholder="{showReasonFor === 'block' ? 'Block' : 'Completion'} reason..."
   477→+						class="flex-1"
   478→+					/>
   479→+					<Button
   480→+						size="sm"
   481→+						onclick={showReasonFor === 'block' ? handleBlock : handleComplete}
   482→+						disabled={isSubmitting || !reasonInput.trim()}
   483→+					>
   484→+						Confirm
   485→+					</Button>
   486→+					<Button
   487→+						size="sm"
   488→+						variant="ghost"
   489→+						onclick={() => {
   490→+							showReasonFor = null;
   491→+							reasonInput = '';
   492→+						}}
   493→+					>
   494→+						Cancel
   495→+					</Button>
   496→+				</div>
   497→+			{/if}
   498→+		{/if}
   499→+
   500→+		{#if actionError}
   501→+			<p class="text-sm text-destructive" data-testid="action-error">{actionError}</p>
   502→+		{/if}
   503→+
   504→+		<Separator />
   505→+
