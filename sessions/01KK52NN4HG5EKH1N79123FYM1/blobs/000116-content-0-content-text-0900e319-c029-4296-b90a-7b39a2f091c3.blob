   536→+		<div data-testid="task-notes">
   537→+			<p class="text-xs font-medium text-muted-foreground mb-2">
   538→+				Notes ({task.notes?.length ?? 0})
   539→+			</p>
   540→+
   541→+			<!-- Add Note form -->
   542→+			{#if !isStaticMode()}
   543→+				<div class="mb-3 space-y-2" data-testid="task-add-note">
   544→+					<Textarea
   545→+						placeholder="Add a note..."
   546→+						bind:value={noteContent}
   547→+						disabled={isSubmitting}
   548→+						rows={2}
   549→+					/>
   550→+					<Button
   551→+						size="sm"
   552→+						onclick={handleAddNote}
   553→+						disabled={isSubmitting || !noteContent.trim()}
   554→+						data-testid="action-add-note"
   555→+					>
   556→+						{isSubmitting ? 'Adding...' : 'Add Note'}
   557→+					</Button>
   558→+				</div>
   559→+			{/if}
   560→+
   561→+			<!-- Notes list -->
   562→+			<div class="space-y-3">
   563→+				{#if (task.notes ?? []).length === 0}
   564→+					<div class="text-center py-4 text-muted-foreground text-xs" data-testid="notes-empty">
   565→+						{#if isStaticMode()}
   566→+							No notes recorded. Use <code class="bg-muted px-1 rounded">kspec task note</code> to add context.
   567→+						{:else}
   568→+							Add a note above to document decisions, progress, or findings.
   569→+						{/if}
   570→+					</div>
   571→+				{:else}
   572→+					{#each task.notes ?? [] as note}
   573→+						<div class="border rounded-md p-2.5" data-testid="note-item">
   574→+							<div class="flex justify-between items-start mb-1">
   575→+								<span class="text-[10px] text-muted-foreground">{note.author}</span>
   576→+								<span class="text-[10px] text-muted-foreground" data-testid="note-timestamp">{formatDate(note.created_at)}</span>
   577→+							</div>
   578→+							<p class="text-sm whitespace-pre-wrap">{note.content}</p>
   579→+						</div>
   580→+					{/each}
   581→+				{/if}
   582→+			</div>
   583→+		</div>
   584→+	</div>
   585→+{/if}
