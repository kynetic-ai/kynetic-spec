   518→+								{:else}
   519→+									&#x23F8;&#xFE0F;
   520→+								{/if}
   521→+							</span>
   522→+							<span class:line-through={todo.done}>
   523→+								{todo.text}
   524→+							</span>
   525→+						</li>
   526→+					{/each}
   527→+				</ul>
   528→+			{:else}
   529→+				<p class="text-sm text-muted-foreground">No todos</p>
   530→+			{/if}
   531→+		</div>
   532→+		<Separator />
   533→+
   534→+		<!-- Notes -->
