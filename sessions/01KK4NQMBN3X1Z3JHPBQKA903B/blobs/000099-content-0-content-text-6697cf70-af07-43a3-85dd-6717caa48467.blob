```
     1→<!--
     2→  AC: @ui-dashboard-overview ac-1 — Dashboard home view
     3→  Active work section, status summary, needs-attention aggregation.
     4→-->
     5→<script lang="ts">
     6→	import { onMount, onDestroy } from 'svelte';
     7→	import { goto } from '$app/navigation';
     8→	import { base } from '$app/paths';
     9→	import type { BroadcastEvent } from '@kynetic-ai/shared';
    10→	import {
    11→		fetchTasks,
    12→		fetchInbox,
    13→		fetchObservations,
    14→		fetchValidation,
    15→		fetchAgentStatus,
    16→		type AgentDispatchStatus,
    17→		type ActiveInvocation
    18→	} from '$lib/api';
    19→	import {
    20→		createSessionState,
    21→		processTextChunk,
    22→		type FleetSessionState,
    23→	} from '$lib/components/board/fleet-buffer';
    24→	import { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';
    25→	import { Badge } from '$lib/components/ui/badge';
    26→	import { Skeleton } from '$lib/components/ui/skeleton';
    27→	import ReferenceLink from '$lib/components/ReferenceLink.svelte';
    28→	import { getProjectVersion, isInitialized as isProjectInitialized } from '$lib/stores/project.svelte';
    29→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    30→	import { isStaticMode } from '$lib/stores/mode.svelte';
    31→	import AlertTriangle from '@lucide/svelte/icons/triangle-alert';
    32→	import InboxIcon from '@lucide/svelte/icons/inbox';
    33→	import Eye from '@lucide/svelte/icons/eye';
    34→	import ShieldAlert from '@lucide/svelte/icons/shield-alert';
    35→	import Ban from '@lucide/svelte/icons/ban';
    36→	import Activity from '@lucide/svelte/icons/activity';
    37→	import Bot from '@lucide/svelte/icons/bot';
    38→	import ExternalLink from '@lucide/svelte/icons/external-link';
    39→	import TerminalIcon from '@lucide/svelte/icons/terminal';
    40→
    41→	// --- State ---
    42→	let loading = $state(true);
    43→	let error = $state<string | null>(null);
    44→
    45→	// Task counts
    46→	interface TaskCounts {
    47→		ready: number;
    48→		in_progress: number;
    49→		needs_work: number;
    50→		pending_review: number;
    51→		blocked: number;
    52→		completed: number;
    53→		cancelled: number;
    54→	}
    55→
    56→	let counts = $state<TaskCounts>({
    57→		ready: 0,
    58→		in_progress: 0,
    59→		needs_work: 0,
    60→		pending_review: 0,
    61→		blocked: 0,
    62→		completed: 0,
    63→		cancelled: 0
    64→	});
    65→
    66→	// Active work
    67→	let agentStatus = $state<AgentDispatchStatus | null>(null);
    68→	let taskTitles = $state<Record<string, string>>({});
    69→
    70→	// Buffered output state per agent session (same pattern as board)
    71→	let sessionStates = $state<Record<string, FleetSessionState>>({});
    72→
    73→	let hasActiveWork = $derived(
    74→		agentStatus?.dispatch_enabled && (agentStatus?.active_invocations?.length ?? 0) > 0
    75→	);
    76→
    77→	// Needs attention
    78→	let inboxUntriaged = $state(0);
    79→	let observationsUnresolved = $state(0);
    80→	let validationWarnings = $state(0);
    81→	let blockedTasks = $state(0);
    82→
    83→	let totalAttention = $derived(
    84→		inboxUntriaged + observationsUnresolved + validationWarnings + blockedTasks
    85→	);
    86→
    87→	// --- Status config with design system tokens ---
    88→	// AC: @ui-dashboard-overview ac-1 — clickable count cards per status
    89→	const statusConfig = [
    90→		{
    91→			key: 'ready' as const,
    92→			label: 'Ready',
    93→			dotClass: 'bg-status-pending',
    94→			filterStatus: 'pending'
    95→		},
    96→		{
    97→			key: 'in_progress' as const,
    98→			label: 'In Progress',
    99→			dotClass: 'bg-status-in-progress',
   100→			filterStatus: 'in_progress'
   101→		},
   102→		{
   103→			key: 'needs_work' as const,
   104→			label: 'Needs Work',
   105→			dotClass: 'bg-status-needs-work',
   106→			filterStatus: 'needs_work'
   107→		},
   108→		{
   109→			key: 'pending_review' as const,
   110→			label: 'Review',
   111→			dotClass: 'bg-status-pending-review',
   112→			filterStatus: 'pending_review'
   113→		},
   114→		{
   115→			key: 'blocked' as const,
   116→			label: 'Blocked',
   117→			dotClass: 'bg-status-blocked',
   118→			filterStatus: 'blocked'
   119→		},
   120→		{
   121→			key: 'completed' as const,
   122→			label: 'Completed',
   123→			dotClass: 'bg-status-completed',
   124→			filterStatus: 'completed'
   125→		},
   126→		{
   127→			key: 'cancelled' as const,
   128→			label: 'Cancelled',
   129→			dotClass: 'bg-status-cancelled',
   130→			filterStatus: 'cancelled'
   131→		}
   132→	];
   133→
   134→	// --- Needs attention items config ---
   135→	const attentionItems = $derived([
   136→		{
   137→			key: 'inbox',
   138→			label: 'Untriaged inbox',
   139→			count: inboxUntriaged,
   140→			icon: InboxIcon,
   141→			href: `${base}/inbox`,
   142→			colorClass: 'text-status-pending-review'
   143→		},
   144→		{
   145→			key: 'observations',
   146→			label: 'Unresolved observations',
   147→			count: observationsUnresolved,
   148→			icon: Eye,
   149→			href: `${base}/observations`,
   150→			colorClass: 'text-status-in-progress'
   151→		},
   152→		{
   153→			key: 'validation',
   154→			label: 'Validation warnings',
   155→			count: validationWarnings,
   156→			icon: ShieldAlert,
   157→			href: `${base}/validate`,
   158→			colorClass: 'text-status-needs-work'
   159→		},
   160→		{
   161→			key: 'blocked',
   162→			label: 'Blocked tasks',
   163→			count: blockedTasks,
   164→			icon: Ban,
   165→			href: `${base}/tasks?status=blocked`,
   166→			colorClass: 'text-status-blocked'
   167→		}
   168→	]);
   169→
   170→	// --- Elapsed time formatting ---
   171→	function formatElapsed(ms: number): string {
   172→		const secs = Math.floor(ms / 1000);
   173→		const mins = Math.floor(secs / 60);
   174→		const hours = Math.floor(mins / 60);
   175→		if (hours > 0) return `${hours}h ${mins % 60}m`;
   176→		if (mins > 0) return `${mins}m ${secs % 60}s`;
   177→		return `${secs}s`;
   178→	}
   179→
   180→	// --- Data loading ---
   181→	async function loadDashboard() {
   182→		loading = true;
   183→		error = null;
   184→
   185→		try {
   186→			const [tasksResponse, inboxResponse, obsResponse, validationResult, agentStatusResult] =
   187→				await Promise.all([
   188→					fetchTasks({ limit: 1000 }),
   189→					fetchInbox({ limit: 0 }),
   190→					fetchObservations({ resolved: false }),
   191→					fetchValidation().catch(() => null),
   192→					isStaticMode()
   193→						? Promise.resolve(null)
   194→						: fetchAgentStatus().catch(() => null)
   195→				]);
   196→
   197→			// Compute task counts
   198→			const tasks = tasksResponse.items;
   199→			const newCounts: TaskCounts = {
   200→				ready: 0,
   201→				in_progress: 0,
   202→				needs_work: 0,
   203→				pending_review: 0,
   204→				blocked: 0,
   205→				completed: 0,
   206→				cancelled: 0
   207→			};
   208→
   209→			const completedRefs = new Set(
   210→				tasks
   211→					.filter((t) => t.status === 'completed')
   212→					.flatMap((t) => [t._ulid, ...(t.slugs || [])])
   213→			);
   214→
   215→			const titles: Record<string, string> = {};
   216→
   217→			for (const task of tasks) {
   218→				// Build task titles for active fleet
   219→				if (task.slugs?.length) {
   220→					for (const slug of task.slugs) {
   221→						titles[`@${slug}`] = task.title;
   222→					}
   223→				}
   224→				titles[`@${task._ulid}`] = task.title;
   225→
   226→				switch (task.status) {
   227→					case 'completed':
   228→						newCounts.completed++;
   229→						break;
   230→					case 'in_progress':
   231→						newCounts.in_progress++;
   232→						break;
   233→					case 'pending_review':
   234→						newCounts.pending_review++;
   235→						break;
   236→					case 'blocked':
   237→						newCounts.blocked++;
   238→						break;
   239→					case 'needs_work':
   240→						newCounts.needs_work++;
   241→						break;
   242→					case 'cancelled':
   243→						newCounts.cancelled++;
   244→						break;
   245→					case 'pending': {
   246→						const deps = task.depends_on || [];
   247→						const hasUnmetDeps = deps.some((dep: string) => {
   248→							const ref = dep.startsWith('@') ? dep.slice(1) : dep;
   249→							return !completedRefs.has(ref);
   250→						});
   251→						if (hasUnmetDeps) {
   252→							// Pending tasks with unmet deps are not ready, but don't
   253→							// count as "blocked" (which is status=blocked only). They
   254→							// resolve naturally when predecessor tasks complete.
   255→						} else {
   256→							newCounts.ready++;
   257→						}
   258→						break;
   259→					}
   260→				}
   261→			}
   262→
   263→			counts = newCounts;
   264→			taskTitles = titles;
   265→			// Needs-attention blocked count only includes status=blocked tasks.
   266→			// Pending tasks with unmet deps are excluded — they resolve naturally
   267→			// when predecessor tasks complete, and don't require user intervention.
   268→			blockedTasks = newCounts.blocked;
   269→
   270→			// Inbox count
   271→			inboxUntriaged = inboxResponse.total;
   272→
   273→			// Observations: unresolved count
   274→			observationsUnresolved = obsResponse.total;
   275→
   276→			// Validation warnings
   277→			if (validationResult) {
   278→				validationWarnings =
   279→					validationResult.refWarnings.length +
   280→					validationResult.completenessWarnings.length +
   281→					validationResult.schemaErrors.length +
   282→					validationResult.refErrors.length;
   283→			}
   284→
   285→			// Agent status
   286→			if (agentStatusResult) {
   287→				agentStatus = agentStatusResult;
   288→			}
   289→		} catch (err) {
   290→			error = err instanceof Error ? err.message : 'Failed to load dashboard data';
   291→			console.error('Dashboard load error:', err);
   292→		} finally {
   293→			loading = false;
   294→		}
   295→	}
   296→
   297→	function navigateToTasks(status: string) {
   298→		goto(`${base}/tasks?status=${status}`);
   299→	}
   300→
   301→	// --- WebSocket real-time updates ---
   302→	function handleTaskUpdate() {
   303→		loadDashboard();
   304→	}
   305→
   306→	function handleAgentEvent(event: BroadcastEvent) {
   307→		// Buffer text chunks into complete lines
   308→		if (event.event === 'agent_text_chunk' && event.data?.session_id && event.data?.text) {
   309→			const sessionId = event.data.session_id as string;
   310→			const text = event.data.text as string;
   311→			const current = sessionStates[sessionId] ?? createSessionState();
   312→			sessionStates[sessionId] = processTextChunk(current, text);
   313→			return;
   314→		}
   315→
   316→		// Invocation lifecycle events — refresh status and clean up stale state
   317→		fetchAgentStatus()
   318→			.then((s) => {
   319→				agentStatus = s;
   320→				const activeSessions = new Set(
   321→					s.active_invocations.map((inv) => inv.session_id)
   322→				);
   323→				for (const sessionId of Object.keys(sessionStates)) {
   324→					if (!activeSessions.has(sessionId)) {
   325→						delete sessionStates[sessionId];
   326→					}
   327→				}
   328→			})
   329→			.catch(() => {});
   330→	}
   331→
   332→	// --- Lifecycle ---
   333→	onMount(() => {
   334→		if (!isStaticMode()) {
   335→			subscribe(['tasks', 'agents']);
   336→			on('tasks', handleTaskUpdate);
   337→			on('agents', handleAgentEvent);
   338→		}
   339→	});
   340→
   341→	onDestroy(() => {
   342→		if (!isStaticMode()) {
   343→			off('tasks', handleTaskUpdate);
   344→			off('agents', handleAgentEvent);
   345→			unsubscribe(['tasks', 'agents']);
   346→		}
   347→	});
   348→
   349→	// Load dashboard when project is ready and reload on project change.
   350→	// Gates on isProjectInitialized() to prevent loading with wrong/missing project context.
   351→	$effect(() => {
   352→		const version = getProjectVersion();
   353→		const ready = isProjectInitialized();
   354→		if (!ready) return;
   355→		loadDashboard();
   356→	});
   357→</script>
   358→
   359→<div class="flex flex-col gap-6 p-6" data-testid="dashboard">
   360→	<h1 class="text-2xl font-bold">Dashboard</h1>
   361→
   362→	{#if error}
   363→		<!-- Error state -->
   364→		<div
   365→			class="flex items-center gap-3 rounded-lg border border-destructive/50 bg-destructive/10 p-4"
   366→			role="alert"
   367→			data-testid="dashboard-error"
   368→		>
   369→			<AlertTriangle class="size-5 text-destructive" />
   370→			<div>
   371→				<p class="text-sm font-medium text-destructive">Failed to load dashboard</p>
   372→				<p class="text-xs text-muted-foreground">{error}</p>
   373→			</div>
   374→			<button
   375→				class="ml-auto text-xs text-muted-foreground underline hover:text-foreground"
   376→				onclick={loadDashboard}
   377→			>
   378→				Retry
   379→			</button>
   380→		</div>
   381→	{/if}
   382→
   383→	{#if loading}
   384→		<!-- Loading skeleton -->
   385→		<div data-testid="dashboard-skeleton">
   386→			<!-- Active work skeleton -->
   387→			<div class="mb-6">
   388→				<Skeleton class="mb-2 h-5 w-32 ds-shimmer" />
   389→				<div class="flex gap-3">
   390→					<Skeleton class="h-20 w-72 ds-shimmer" />
   391→				</div>
   392→			</div>
   393→
   394→			<!-- Status summary skeleton -->
   395→			<div class="mb-6">
   396→				<Skeleton class="mb-3 h-5 w-40 ds-shimmer" />
   397→				<div class="grid gap-4 md:grid-cols-4 lg:grid-cols-7">
   398→					{#each Array(7) as _}
   399→						<Skeleton class="h-24 ds-shimmer" />
   400→					{/each}
   401→				</div>
   402→			</div>
   403→
   404→			<!-- Needs attention skeleton -->
   405→			<div>
   406→				<Skeleton class="mb-3 h-5 w-40 ds-shimmer" />
   407→				<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
   408→					{#each Array(4) as _}
   409→						<Skeleton class="h-20 ds-shimmer" />
   410→					{/each}
   411→				</div>
   412→			</div>
   413→		</div>
   414→	{:else}
   415→		<!-- AC: @ui-dashboard-overview ac-1 — Active work section -->
   416→		<section data-testid="active-work-section">
   417→			{#if hasActiveWork}
   418→				<div class="mb-4">
   419→					<div class="flex items-center gap-2 mb-2">
   420→						<Activity class="size-4 text-status-in-progress" />
   421→						<h2 class="text-sm font-medium">Active Fleet</h2>
   422→						<Badge variant="secondary" class="text-[10px]">
   423→							{agentStatus?.active_invocations.length} running
   424→						</Badge>
   425→					</div>
   426→					<div class="flex gap-3 overflow-x-auto pb-2" data-testid="active-fleet-row">
   427→						{#each agentStatus?.active_invocations ?? [] as invocation (invocation.session_id)}
   428→							{@const title = invocation.task_ref ? taskTitles[invocation.task_ref] : undefined}
   429→							{@const sessionState = sessionStates[invocation.session_id]}
   430→							{@const lines = sessionState?.lines ?? []}
   431→							<div
   432→								class="flex-shrink-0 w-72 rounded-lg border bg-card p-3 ds-breathe"
   433→								data-testid="fleet-card"
   434→							>
   435→								<div class="flex items-center gap-2 mb-1.5">
   436→									<Bot class="size-4 text-muted-foreground" />
   437→									<span class="text-xs font-medium truncate">{invocation.agent_id}</span>
   438→								</div>
   439→
   440→								{#if invocation.task_ref}
   441→									<div class="truncate mb-1">
   442→										<ReferenceLink ref={invocation.task_ref} type="task" title={title} class="text-xs" />
   443→									</div>
   444→								{/if}
   445→
   446→								<div class="flex items-center justify-between text-[10px] text-muted-foreground">
   447→									<div class="flex items-center gap-1.5">
   448→										<!-- Pulse indicator -->
   449→										<span class="relative flex size-2">
   450→											<span
   451→												class="absolute inline-flex h-full w-full rounded-full bg-status-in-progress opacity-75 ds-breathe"
   452→											></span>
   453→											<span
   454→												class="relative inline-flex size-2 rounded-full bg-status-in-progress"
   455→											></span>
   456→										</span>
   457→										<span>{formatElapsed(invocation.elapsed_ms)}</span>
   458→									</div>
   459→
   460→									<a
   461→										href="{base}/sessions/{invocation.session_id}"
   462→										class="inline-flex items-center gap-1 text-primary hover:underline"
   463→									>
   464→										Stream
   465→										<ExternalLink class="size-3" />
   466→									</a>
   467→								</div>
   468→
   469→								<!-- Buffered output -->
   470→								{#if lines.length > 0}
   471→									<div
   472→										class="mt-1.5 rounded bg-muted/50 p-1.5 font-mono text-[10px] leading-tight text-muted-foreground overflow-hidden max-h-10"
   473→										aria-live="polite"
   474→										aria-label="Agent output for {title ?? invocation.agent_id}"
   475→										data-testid="fleet-output"
   476→									>
   477→										{#each lines.slice(-2) as line}
   478→											<div class="truncate">{line}</div>
   479→										{/each}
   480→									</div>
   481→								{:else}
   482→									<div
   483→										class="mt-1.5 flex items-center gap-1 text-[10px] text-muted-foreground/50"
   484→										aria-live="polite"
   485→										aria-label="Agent output for {title ?? invocation.agent_id}"
   486→										data-testid="fleet-output-empty"
   487→									>
   488→										<TerminalIcon class="size-3" />
   489→										<span>Awaiting output...</span>
   490→									</div>
   491→								{/if}
   492→							</div>
   493→						{/each}
   494→					</div>
   495→				</div>
   496→			{:else}
   497→				<div
   498→					class="flex items-center gap-2 rounded-lg border border-dashed p-4 text-sm text-muted-foreground"
   499→					data-testid="no-active-work"
   500→				>
   501→					<Activity class="size-4" />
   502→					<span>No agents currently running</span>
   503→				</div>
   504→			{/if}
   505→		</section>
   506→
   507→		<!-- AC: @ui-dashboard-overview ac-1 — Status summary with clickable count cards -->
   508→		<section data-testid="status-summary-section">
   509→			<h2 class="mb-3 text-sm font-medium text-muted-foreground">Status Summary</h2>
   510→			<div class="grid gap-3 md:grid-cols-4 lg:grid-cols-7" data-testid="dashboard-counts">
   511→				{#each statusConfig as status}
   512→					<button
   513→						class="text-left"
   514→						onclick={() => navigateToTasks(status.filterStatus)}
   515→						data-testid="task-count-{status.key}"
   516→					>
   517→						<Card class="transition-colors hover:bg-muted/50 cursor-pointer h-full">
   518→							<CardHeader
   519→								class="flex flex-row items-center justify-between pb-1 pt-3 px-3 space-y-0"
   520→							>
   521→								<CardTitle class="text-xs font-medium text-muted-foreground">
   522→									{status.label}
   523→								</CardTitle>
   524→								<span class="inline-block size-2.5 rounded-full {status.dotClass}"></span>
   525→							</CardHeader>
   526→							<CardContent class="px-3 pb-3">
   527→								<div class="text-2xl font-bold tabular-nums">
   528→									{counts[status.key]}
   529→								</div>
   530→							</CardContent>
   531→						</Card>
   532→					</button>
   533→				{/each}
   534→			</div>
   535→		</section>
   536→
   537→		<!-- AC: @ui-dashboard-overview ac-1 — Needs attention aggregation -->
   538→		<section data-testid="needs-attention-section">
   539→			<div class="mb-3 flex items-center gap-2">
   540→				<h2 class="text-sm font-medium text-muted-foreground">Needs Attention</h2>
   541→				{#if totalAttention > 0}
   542→					<Badge variant="secondary" class="text-[10px]">{totalAttention}</Badge>
   543→				{/if}
   544→			</div>
   545→
   546→			{#if totalAttention === 0}
   547→				<div
   548→					class="flex items-center gap-2 rounded-lg border border-dashed p-4 text-sm text-muted-foreground"
   549→					data-testid="no-attention-needed"
   550→				>
   551→					<span>Nothing needs attention right now</span>
   552→				</div>
   553→			{:else}
   554→				<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4" data-testid="attention-cards">
   555→					{#each attentionItems as item}
   556→						{#if item.count > 0}
   557→							<a href={item.href} class="block" data-testid="attention-{item.key}">
