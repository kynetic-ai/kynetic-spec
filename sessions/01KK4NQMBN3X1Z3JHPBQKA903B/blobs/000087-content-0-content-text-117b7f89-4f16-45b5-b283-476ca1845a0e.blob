```
     1→/**
     2→ * API Client
     3→ *
     4→ * Helper functions for making requests to the kspec daemon API.
     5→ * Supports both daemon mode (live) and static mode (read-only JSON).
     6→ *
     7→ * AC Coverage:
     8→ * - ac-26 (@multi-directory-daemon): X-Kspec-Dir header injection
     9→ * - ac-36 (@multi-directory-daemon): Invalid project error detection
    10→ * - ac-11 (@gh-pages-export): Mode-aware API dispatch
    11→ * - ac-18 (@gh-pages-export): Graceful no-op for write operations
    12→ */
    13→
    14→import type {
    15→	TaskSummary,
    16→	TaskDetail,
    17→	ItemSummary,
    18→	ItemDetail,
    19→	InboxItem,
    20→	SessionContext,
    21→	Observation,
    22→	Workflow,
    23→	Convention,
    24→	PaginatedResponse,
    25→	PlanSummary,
    26→	PlanDetail,
    27→	ErrorResponse,
    28→	SearchResponse,
    29→	AgentDefinition,
    30→	AgentUpdatePayload
    31→} from '@kynetic-ai/shared';
    32→import type { TriageRecord } from './types/triage';
    33→import {
    34→	getSelectedProjectPath,
    35→	clearInvalidSelection,
    36→	isInvalidProjectError,
    37→	type Project
    38→} from './stores/project.svelte';
    39→import { isStaticMode, assertWritable } from './stores/mode.svelte';
    40→import {
    41→	fetchTasksStatic,
    42→	fetchTaskStatic,
    43→	fetchItemsStatic,
    44→	fetchItemStatic,
    45→	fetchItemTasksStatic,
    46→	fetchInboxStatic,
    47→	fetchSessionContextStatic,
    48→	fetchObservationsStatic,
    49→	searchStatic,
    50→	fetchTriageRecordsStatic,
    51→	fetchPlansStatic,
    52→	fetchWorkflowsStatic
    53→} from './api-static';
    54→import { DAEMON_API_BASE } from './constants';
    55→
    56→const API_BASE = DAEMON_API_BASE;
    57→
    58→/**
    59→ * Get headers for API requests, including X-Kspec-Dir if project is selected
    60→ * AC: @multi-directory-daemon ac-26
    61→ */
    62→function getProjectHeaders(): HeadersInit {
    63→	const path = getSelectedProjectPath();
    64→	return path ? { 'X-Kspec-Dir': path } : {};
    65→}
    66→
    67→/**
    68→ * Handle response errors, detecting invalid project errors
    69→ * AC: @multi-directory-daemon ac-36
    70→ */
    71→async function handleResponseError(response: Response): Promise<never> {
    72→	const error: ErrorResponse = await response.json();
    73→	const message = error.message || error.error;
    74→
    75→	// Check if this is an invalid project error
    76→	if (isInvalidProjectError(response, message)) {
    77→		clearInvalidSelection();
    78→	}
    79→
    80→	throw new Error(message);
    81→}
    82→
    83→/**
    84→ * Fetch registered projects
    85→ * AC: @multi-directory-daemon ac-25, ac-28
    86→ */
    87→export async function fetchProjects(): Promise<{ projects: Project[] }> {
    88→	const response = await fetch(`${API_BASE}/api/projects`);
    89→	if (!response.ok) {
    90→		await handleResponseError(response);
    91→	}
    92→	return response.json();
    93→}
    94→
    95→/**
    96→ * Fetch tasks with optional filters
    97→ * AC: @web-dashboard ac-9, ac-10
    98→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
    99→ * AC: @gh-pages-export ac-11 - Static mode support
   100→ */
   101→export async function fetchTasks(params?: {
   102→	status?: string;
   103→	type?: string;
   104→	tag?: string;
   105→	assignee?: string;
   106→	automation?: string;
   107→	plan?: string;
   108→	limit?: number;
   109→	offset?: number;
   110→}): Promise<PaginatedResponse<TaskSummary>> {
   111→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   112→	if (isStaticMode()) {
   113→		return fetchTasksStatic(params);
   114→	}
   115→
   116→	const url = new URL(`${API_BASE}/api/tasks`);
   117→
   118→	if (params) {
   119→		Object.entries(params).forEach(([key, value]) => {
   120→			if (value !== undefined && value !== '') {
   121→				url.searchParams.set(key, String(value));
   122→			}
   123→		});
   124→	}
   125→
   126→	const response = await fetch(url.toString(), {
   127→		headers: getProjectHeaders()
   128→	});
   129→	if (!response.ok) {
   130→		await handleResponseError(response);
   131→	}
   132→
   133→	return response.json();
   134→}
   135→
   136→/**
   137→ * Fetch single task by reference
   138→ * AC: @web-dashboard ac-5
   139→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   140→ * AC: @gh-pages-export ac-12 - Static mode deep linking
   141→ */
   142→export async function fetchTask(ref: string): Promise<TaskDetail> {
   143→	// AC: @gh-pages-export ac-12 - Use static data in static mode
   144→	if (isStaticMode()) {
   145→		const task = fetchTaskStatic(ref);
   146→		if (!task) {
   147→			throw new Error(`Task not found: ${ref}`);
   148→		}
   149→		return task;
   150→	}
   151→
   152→	const response = await fetch(`${API_BASE}/api/tasks/${ref}`, {
   153→		headers: getProjectHeaders()
   154→	});
   155→	if (!response.ok) {
   156→		await handleResponseError(response);
   157→	}
   158→
   159→	return response.json();
   160→}
   161→
   162→/**
   163→ * Start a task (change status to in_progress)
   164→ * AC: @web-dashboard ac-7
   165→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   166→ * AC: @gh-pages-export ac-16, ac-18 - Disabled in static mode
   167→ */
   168→export async function startTask(ref: string): Promise<void> {
   169→	// AC: @gh-pages-export ac-16, ac-18 - Write operations throw in static mode
   170→	assertWritable('start task');
   171→
   172→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/start`, {
   173→		method: 'POST',
   174→		headers: getProjectHeaders()
   175→	});
   176→	if (!response.ok) {
   177→		await handleResponseError(response);
   178→	}
   179→}
   180→
   181→/**
   182→ * Add a note to a task
   183→ * AC: @web-dashboard ac-8
   184→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   185→ * AC: @gh-pages-export ac-18 - Disabled in static mode
   186→ */
   187→export async function addTaskNote(ref: string, content: string): Promise<void> {
   188→	// AC: @gh-pages-export ac-18 - Write operations throw in static mode
   189→	assertWritable('add note');
   190→
   191→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/note`, {
   192→		method: 'POST',
   193→		headers: {
   194→			'Content-Type': 'application/json',
   195→			...getProjectHeaders()
   196→		},
   197→		body: JSON.stringify({ content })
   198→	});
   199→	if (!response.ok) {
   200→		await handleResponseError(response);
   201→	}
   202→}
