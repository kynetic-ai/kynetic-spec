   960→// ============================================================
   961→// Validation & Alignment API Functions
   962→// AC: @ui-validation-view ac-1
   963→// ============================================================
   964→
   965→export interface SchemaValidationError {
   966→	file: string;
   967→	path?: string;
   968→	message: string;
   969→	details?: unknown;
   970→}
   971→
   972→export interface RefValidationError {
   973→	ref: string;
   974→	sourceFile?: string;
   975→	sourceUlid?: string;
   976→	field: string;
   977→	error: 'not_found' | 'ambiguous' | 'duplicate_slug';
   978→	message: string;
   979→}
   980→
   981→export interface RefValidationWarning {
   982→	ref: string;
   983→	sourceFile?: string;
   984→	sourceUlid?: string;
   985→	field: string;
   986→	warning: 'deprecated_target';
   987→	message: string;
   988→}
   989→
   990→export interface OrphanItem {
   991→	ulid: string;
   992→	title: string;
   993→	type: string;
   994→	file?: string;
   995→}
   996→
   997→export type CompletenessWarningType =
   998→	| 'missing_acceptance_criteria'
   999→	| 'missing_description'
  1000→	| 'status_inconsistency'
  1001→	| 'missing_test_coverage'
  1002→	| 'automation_eligible_no_spec'
  1003→	| 'ac_schema_field_mismatch';
  1004→
  1005→export interface CompletenessWarning {
  1006→	type: CompletenessWarningType;
  1007→	subtype?: 'own_ac' | 'trait_ac';
  1008→	itemRef: string;
  1009→	itemTitle: string;
  1010→	message: string;
  1011→	details?: string;
  1012→}
  1013→
  1014→export interface TraitCycleError {
  1015→	traitRef: string;
  1016→	traitTitle: string;
  1017→	cycle: string[];
  1018→	message: string;
  1019→}
  1020→
  1021→export interface ValidationResponse {
  1022→	valid: boolean;
  1023→	schemaErrors: SchemaValidationError[];
  1024→	refErrors: RefValidationError[];
  1025→	refWarnings: RefValidationWarning[];
  1026→	orphans: OrphanItem[];
  1027→	completenessWarnings: CompletenessWarning[];
  1028→	traitCycles: TraitCycleError[];
  1029→}
  1030→
  1031→/** Alias for backward compatibility with dashboard overview */
  1032→export type ValidationResult = ValidationResponse;
  1033→
  1034→export interface AlignmentWarning {
  1035→	type: 'orphaned_spec' | 'status_mismatch' | 'stale_implementation';
  1036→	specUlid?: string;
  1037→	specTitle?: string;
  1038→	taskUlid?: string;
  1039→	message: string;
  1040→}
  1041→
  1042→export interface AlignmentStats {
  1043→	totalSpecs: number;
  1044→	specsWithTasks: number;
  1045→	alignedSpecs: number;
  1046→	orphanedSpecs: number;
  1047→}
  1048→
  1049→export interface AlignmentResponse {
  1050→	stats: AlignmentStats;
  1051→	warnings: AlignmentWarning[];
  1052→}
  1053→
  1054→/**
  1055→ * Fetch validation results
  1056→ * AC: @ui-validation-view ac-1
  1057→ */
  1058→export async function fetchValidation(): Promise<ValidationResponse> {
  1059→	if (isStaticMode()) {
  1060→		return {
  1061→			valid: true,
  1062→			schemaErrors: [],
  1063→			refErrors: [],
  1064→			refWarnings: [],
  1065→			orphans: [],
  1066→			completenessWarnings: [],
  1067→			traitCycles: []
  1068→		};
  1069→	}
  1070→
  1071→	const response = await fetch(`${API_BASE}/api/validate`, {
  1072→		headers: getProjectHeaders()
  1073→	});
  1074→	if (!response.ok) {
  1075→		await handleResponseError(response);
  1076→	}
  1077→
  1078→	const data = await response.json();
  1079→	// Normalize: ensure all array fields exist even if the API omits them
  1080→	return {
  1081→		valid: data.valid ?? true,
  1082→		schemaErrors: data.schemaErrors ?? [],
  1083→		refErrors: data.refErrors ?? [],
  1084→		refWarnings: data.refWarnings ?? [],
  1085→		orphans: data.orphans ?? [],
  1086→		completenessWarnings: data.completenessWarnings ?? [],
  1087→		traitCycles: data.traitCycles ?? []
  1088→	};
  1089→}
  1090→
  1091→/**
  1092→ * Fetch alignment stats and warnings
  1093→ * AC: @ui-validation-view ac-1
  1094→ */
  1095→export async function fetchAlignment(): Promise<AlignmentResponse> {
  1096→	if (isStaticMode()) {
  1097→		return {
  1098→			stats: { totalSpecs: 0, specsWithTasks: 0, alignedSpecs: 0, orphanedSpecs: 0 },
  1099→			warnings: []
  1100→		};
  1101→	}
  1102→
  1103→	const response = await fetch(`${API_BASE}/api/alignment`, {
  1104→		headers: getProjectHeaders()
  1105→	});
  1106→	if (!response.ok) {
  1107→		await handleResponseError(response);
  1108→	}
  1109→
  1110→	return response.json();
  1111→}
