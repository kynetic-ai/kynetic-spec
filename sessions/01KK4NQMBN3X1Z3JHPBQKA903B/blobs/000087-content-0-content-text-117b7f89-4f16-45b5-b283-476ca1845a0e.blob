   441→export async function fetchSessionContext(): Promise<SessionContext> {
   442→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   443→	if (isStaticMode()) {
   444→		const session = fetchSessionContextStatic();
   445→		if (!session) {
   446→			return { focus: null, threads: [], open_questions: [], updated_at: new Date().toISOString() };
   447→		}
   448→		return session;
   449→	}
   450→
   451→	const response = await fetch(`${API_BASE}/api/meta/session`, {
   452→		headers: getProjectHeaders()
   453→	});
   454→	if (!response.ok) {
   455→		await handleResponseError(response);
   456→	}
   457→
   458→	return response.json();
   459→}
