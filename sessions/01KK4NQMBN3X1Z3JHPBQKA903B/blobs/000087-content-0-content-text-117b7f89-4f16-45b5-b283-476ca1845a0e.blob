   765→
   766→	if (params) {
   767→		Object.entries(params).forEach(([key, value]) => {
   768→			if (value !== undefined && value !== '') {
   769→				url.searchParams.set(key, String(value));
   770→			}
   771→		});
   772→	}
   773→
   774→	const response = await fetch(url.toString(), {
   775→		headers: getProjectHeaders()
   776→	});
   777→	if (!response.ok) {
   778→		await handleResponseError(response);
   779→	}
   780→
   781→	return response.json();
   782→}
