   618→// ============================================================
   619→// Agent & Dispatch API Functions
   620→// AC: @ui-agent-dispatch ac-1, ac-2, ac-3
   621→// ============================================================
   622→
   623→// AgentDefinition and AgentUpdatePayload are imported from @kynetic-ai/shared
   624→// (schema-driven types mirroring AgentSchema from src/schema/meta.ts)
   625→// Re-exported so existing imports from '$lib/api' continue to work.
   626→// AC: @ui-agent-dispatch ac-4
   627→export type { AgentDefinition, AgentUpdatePayload };
   628→
   629→/**
   630→ * Active invocation from GET /api/agent/status
   631→ */
   632→export interface ActiveInvocation {
   633→	session_id: string;
   634→	agent_id: string;
   635→	task_ref: string | null;
   636→	elapsed_ms: number;
   637→}
   638→
   639→/**
   640→ * Agent dispatch status from GET /api/agent/status
   641→ */
   642→export interface AgentDispatchStatus {
   643→	dispatch_enabled: boolean;
   644→	active_invocations: ActiveInvocation[];
   645→	queue_depth: number;
   646→	agent_definitions: Array<{
   647→		id: string;
   648→		name: string;
   649→		adapter: string;
   650→		completed_sessions?: number;
   651→	}>;
   652→}
   653→
   654→/**
   655→ * Fetch agent dispatch status (dispatch state + active invocations)
   656→ * AC: @ui-agent-dispatch ac-1, ac-2, ac-3
