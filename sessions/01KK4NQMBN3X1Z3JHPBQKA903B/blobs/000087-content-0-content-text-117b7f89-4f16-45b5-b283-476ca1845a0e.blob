   496→/**
   497→ * Search across all entities
   498→ * AC: @web-dashboard ac-24
   499→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   500→ * AC: @gh-pages-export ac-11 - Static mode support
   501→ */
   502→export async function search(query: string): Promise<SearchResponse> {
   503→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   504→	if (isStaticMode()) {
   505→		return searchStatic(query);
   506→	}
   507→
   508→	const url = new URL(`${API_BASE}/api/search`);
   509→	url.searchParams.set('q', query);
   510→
   511→	const response = await fetch(url.toString(), {
   512→		headers: getProjectHeaders()
   513→	});
   514→	if (!response.ok) {
   515→		await handleResponseError(response);
   516→	}
   517→
   518→	return response.json();
   519→}
