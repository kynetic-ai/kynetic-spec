   265→/**
   266→ * Fetch spec items with optional filters
   267→ * AC: @web-dashboard ac-11
   268→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   269→ * AC: @gh-pages-export ac-11 - Static mode support
   270→ */
   271→export async function fetchItems(params?: {
   272→	type?: string | string[];
   273→	tag?: string;
   274→	plan?: string;
   275→	limit?: number;
   276→	offset?: number;
   277→}): Promise<PaginatedResponse<ItemSummary>> {
   278→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   279→	if (isStaticMode()) {
   280→		return fetchItemsStatic(params);
   281→	}
   282→
   283→	const url = new URL(`${API_BASE}/api/items`);
   284→
   285→	if (params) {
   286→		Object.entries(params).forEach(([key, value]) => {
   287→			if (value !== undefined && value !== '') {
   288→				if (Array.isArray(value)) {
   289→					value.forEach((v) => url.searchParams.append(key, String(v)));
   290→				} else {
   291→					url.searchParams.set(key, String(value));
   292→				}
   293→			}
   294→		});
   295→	}
   296→
   297→	const response = await fetch(url.toString(), {
   298→		headers: getProjectHeaders()
   299→	});
   300→	if (!response.ok) {
   301→		await handleResponseError(response);
   302→	}
   303→
   304→	return response.json();
   305→}
