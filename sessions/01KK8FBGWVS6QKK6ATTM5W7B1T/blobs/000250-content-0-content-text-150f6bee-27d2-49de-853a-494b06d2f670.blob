     1→/**
     2→ * Session log list tests.
     3→ *
     4→ * Tests for the `kspec session log list` command and supporting store functions.
     5→ */
     6→
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import * as fs from 'node:fs/promises';
     9→import * as os from 'node:os';
    10→import * as path from 'node:path';
    11→import * as YAML from 'yaml';
    12→import {
    13→  createSession,
    14→  appendEvent,
    15→  saveSessionContext,
    16→  getSessionLogSummary,
    17→  getAllSessionLogSummaries,
    18→  type SessionLogSummary,
    19→} from '../src/sessions/store.js';
    20→import type { SessionMetadataInput, SessionEventInput } from '../src/sessions/types.js';
    21→import {
    22→  setupTempFixtures,
    23→  cleanupTempDir,
    24→  kspec,
    25→  kspecJson,
    26→  testUlid,
    27→} from './helpers/cli';
    28→
    29→// ─── Store Unit Tests ───────────────────────────────────────────────────────
    30→
    31→describe('getSessionLogSummary', () => {
    32→  let testDir: string;
    33→  let sessionsDir: string;
    34→
    35→  beforeEach(async () => {
    36→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-log-'));
    37→    sessionsDir = path.join(testDir, 'sessions');
    38→  });
    39→
    40→  afterEach(async () => {
    41→    await fs.rm(testDir, { recursive: true });
    42→  });
    43→
    44→  it('should return null for nonexistent session', async () => {
    45→    const summary = await getSessionLogSummary(sessionsDir, 'nonexistent');
    46→    expect(summary).toBeNull();
    47→  });
    48→
    49→  // AC: @session-log-list ac-1
    50→  it('should return summary with all expected fields', async () => {
    51→    const sessionId = testUlid('SESS');
    52→    const startedAt = '2026-01-20T10:00:00.000Z';
    53→    const endedAt = '2026-01-20T11:30:00.000Z';
    54→
    55→    await createSession(sessionsDir, {
    56→      id: sessionId,
    57→      agent_type: 'claude-agent-acp',
    58→      started_at: startedAt,
    59→    });
    60→
    61→    // Simulate completion by writing metadata directly
    62→    const metaPath = path.join(sessionsDir, sessionId, 'session.yaml');
    63→    await fs.writeFile(metaPath, YAML.stringify({
    64→      id: sessionId,
    65→      agent_type: 'claude-agent-acp',
    66→      status: 'completed',
    67→      started_at: startedAt,
    68→      ended_at: endedAt,
    69→    }));
    70→
    71→    // Add some events
    72→    for (let i = 0; i < 5; i++) {
    73→      await appendEvent(sessionsDir, {
    74→        type: i === 0 ? 'session.start' : 'prompt.sent',
    75→        session_id: sessionId,
    76→        data: null,
    77→      });
    78→    }
    79→
    80→    // Add context snapshots
    81→    await saveSessionContext(sessionsDir, sessionId, 1, { iteration: 1 });
    82→    await saveSessionContext(sessionsDir, sessionId, 2, { iteration: 2 });
    83→
    84→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
    85→    expect(summary).not.toBeNull();
    86→    expect(summary!.id).toBe(sessionId);
    87→    expect(summary!.status).toBe('completed');
    88→    expect(summary!.agent_type).toBe('claude-agent-acp');
    89→    expect(summary!.started_at).toBe(startedAt);
    90→    expect(summary!.ended_at).toBe(endedAt);
    91→    expect(summary!.duration_ms).toBe(5400000); // 1.5 hours
    92→    expect(summary!.event_count).toBe(5);
    93→    expect(summary!.iteration_count).toBe(2);
    94→    expect(summary!.tasks_completed).toBe(0);
    95→  });
    96→
    97→  // AC: @ui-session-history ac-1 — task_id included in summary
    98→  it('should include task_id in summary when session has a task', async () => {
    99→    const sessionId = testUlid('SESS', 5);
   100→    const taskId = testUlid('TASK');
   101→    await createSession(sessionsDir, {
   102→      id: sessionId,
   103→      agent_type: 'claude-agent-acp',
   104→      task_id: taskId,
   105→    });
   106→
   107→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
   108→    expect(summary).not.toBeNull();
   109→    expect(summary!.task_id).toBe(taskId);
   110→  });
   111→
   112→  // AC: @ui-session-history ac-1 — task_id undefined when session has no task
   113→  it('should have undefined task_id when session has no task', async () => {
   114→    const sessionId = testUlid('SESS', 6);
   115→    await createSession(sessionsDir, {
   116→      id: sessionId,
   117→      agent_type: 'test-agent',
   118→    });
   119→
   120→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
   121→    expect(summary).not.toBeNull();
   122→    expect(summary!.task_id).toBeUndefined();
   123→  });
   124→
   125→  it('should compute duration from now for active sessions', async () => {
   126→    const sessionId = testUlid('SESS', 1);
   127→    await createSession(sessionsDir, {
   128→      id: sessionId,
   129→      agent_type: 'test-agent',
   130→    });
   131→
   132→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
   133→    expect(summary).not.toBeNull();
   134→    expect(summary!.status).toBe('active');
   135→    expect(summary!.duration_ms).toBeGreaterThan(0);
   136→    expect(summary!.ended_at).toBeUndefined();
   137→  });
   138→
   139→  it('should count task completions from realistic tool_call events', async () => {
   140→    const sessionId = testUlid('SESS', 2);
   141→    await createSession(sessionsDir, {
   142→      id: sessionId,
   143→      agent_type: 'claude-agent-acp',
   144→    });
   145→
   146→    // Append events including realistic task complete tool calls
   147→    await appendEvent(sessionsDir, {
   148→      type: 'session.start',
   149→      session_id: sessionId,
   150→      data: null,
   151→    });
   152→    // Write realistic session.update events with tool_call shape
   153→    const eventsPath = path.join(sessionsDir, sessionId, 'events.jsonl');
   154→    const toolCallEvent1 = JSON.stringify({
   155→      ts: Date.now(),
   156→      seq: 1,
   157→      type: 'session.update',
   158→      session_id: sessionId,
   159→      data: {
   160→        iteration: 1,
   161→        update: {
   162→          _meta: { claudeCode: { toolName: 'Bash' } },
   163→          sessionUpdate: 'tool_call',
   164→          rawInput: { command: 'kspec task complete @my-task --reason "Done"' },
   165→        },
   166→      },
   167→    });
   168→    await fs.appendFile(eventsPath, toolCallEvent1 + '\n');
   169→    const toolCallEvent2 = JSON.stringify({
   170→      ts: Date.now(),
   171→      seq: 2,
   172→      type: 'session.update',
   173→      session_id: sessionId,
   174→      data: {
   175→        iteration: 1,
   176→        update: {
   177→          _meta: { claudeCode: { toolName: 'Bash' } },
   178→          sessionUpdate: 'tool_call',
   179→          rawInput: { command: 'npm run dev -- task complete @another-task --reason "All done"' },
   180→        },
   181→      },
   182→    });
   183→    await fs.appendFile(eventsPath, toolCallEvent2 + '\n');
   184→
   185→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
   186→    expect(summary!.tasks_completed).toBe(2);
   187→    expect(summary!.event_count).toBe(3); // session.start + 2 tool_call updates
   188→  });
   189→
   190→  // AC: @session-log-list ac-1 (claude-agent-acp: commands in tool_call_update events)
   191→  it('should count task completions from tool_call_update events (claude-agent-acp format)', async () => {
   192→    const sessionId = testUlid('SESS', 3);
   193→    await createSession(sessionsDir, { id: sessionId, agent_type: 'claude-agent-acp' });
   194→
   195→    const eventsPath = path.join(sessionsDir, sessionId, 'events.jsonl');
   196→    // claude-agent-acp: initial tool_call has empty rawInput, command arrives in tool_call_update
   197→    const emptyToolCall = JSON.stringify({
   198→      ts: Date.now(), seq: 1, type: 'session.update', session_id: sessionId,
   199→      data: { update: { sessionUpdate: 'tool_call', rawInput: {}, toolCallId: 'tc-1' } },
   200→    });
   201→    await fs.appendFile(eventsPath, emptyToolCall + '\n');
   202→    const populatedUpdate = JSON.stringify({
   203→      ts: Date.now(), seq: 2, type: 'session.update', session_id: sessionId,
   204→      data: { update: { sessionUpdate: 'tool_call_update', rawInput: { command: 'kspec task complete @my-task --reason "Done"', description: 'Complete task' }, toolCallId: 'tc-1' } },
   205→    });
   206→    await fs.appendFile(eventsPath, populatedUpdate + '\n');
   207→
   208→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
   209→    expect(summary!.tasks_completed).toBe(1);
   210→  });
   211→
   212→  // AC: @session-log-list ac-1 (codex-acp: command is array in tool_call events)
   213→  it('should count task completions from array commands (codex-acp format)', async () => {
   214→    const sessionId = testUlid('SESS', 4);
   215→    await createSession(sessionsDir, { id: sessionId, agent_type: 'codex-acp' });
   216→
   217→    const eventsPath = path.join(sessionsDir, sessionId, 'events.jsonl');
   218→    // codex-acp: command is ['/usr/bin/bash', '-lc', 'kspec task complete @ref']
   219→    const arrayCommandEvent = JSON.stringify({
   220→      ts: Date.now(), seq: 1, type: 'session.update', session_id: sessionId,
   221→      data: { update: { sessionUpdate: 'tool_call', rawInput: { command: ['/usr/bin/bash', '-lc', 'kspec task complete @my-task'] } } },
   222→    });
   223→    await fs.appendFile(eventsPath, arrayCommandEvent + '\n');
   224→
   225→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
   226→    expect(summary!.tasks_completed).toBe(1);
   227→  });
   228→});
   229→
   230→describe('getAllSessionLogSummaries', () => {
   231→  let testDir: string;
   232→  let sessionsDir: string;
   233→
   234→  beforeEach(async () => {
   235→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-log-all-'));
   236→    sessionsDir = path.join(testDir, 'sessions');
   237→  });
   238→
   239→  afterEach(async () => {
   240→    await fs.rm(testDir, { recursive: true });
   241→  });
   242→
   243→  // AC: @session-log-list ac-6
   244→  it('should return empty array when no sessions exist', async () => {
   245→    const summaries = await getAllSessionLogSummaries(sessionsDir);
   246→    expect(summaries).toEqual([]);
   247→  });
   248→
   249→  it('should return summaries for all sessions', async () => {
   250→    const id1 = testUlid('SESS', 1);
   251→    const id2 = testUlid('SESS', 2);
   252→
   253→    await createSession(sessionsDir, { id: id1, agent_type: 'agent-a' });
   254→    await createSession(sessionsDir, { id: id2, agent_type: 'agent-b' });
   255→
   256→    const summaries = await getAllSessionLogSummaries(sessionsDir);
   257→    expect(summaries).toHaveLength(2);
   258→    expect(summaries.map(s => s.id).sort()).toEqual([id1, id2].sort());
   259→  });
   260→});
