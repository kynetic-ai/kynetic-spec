   262→// ─── CLI Integration Tests ──────────────────────────────────────────────────
   263→
   264→describe('kspec session log list (CLI)', () => {
   265→  let tempDir: string;
   266→
   267→  beforeEach(async () => {
   268→    tempDir = await setupTempFixtures();
   269→
   270→    // Sessions live at projectRoot/.kspec-sessions/ (outside shadow branch)
   271→    const sessionsDir = path.join(tempDir, '.kspec-sessions');
   272→    await fs.mkdir(sessionsDir, { recursive: true });
   273→
   274→    // Session 1: completed, old
   275→    const s1 = testUlid('SESS', 1);
   276→    const s1Dir = path.join(sessionsDir, s1);
   277→    await fs.mkdir(s1Dir);
   278→    await fs.writeFile(path.join(s1Dir, 'session.yaml'), YAML.stringify({
   279→      id: s1,
   280→      agent_type: 'claude-agent-acp',
   281→      status: 'completed',
   282→      started_at: '2026-01-15T10:00:00.000Z',
   283→      ended_at: '2026-01-15T11:30:00.000Z',
   284→    }));
   285→    await fs.writeFile(path.join(s1Dir, 'events.jsonl'), [
   286→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s1, data: null }),
   287→      JSON.stringify({ ts: 2000, seq: 1, type: 'prompt.sent', session_id: s1, data: null }),
   288→      JSON.stringify({ ts: 3000, seq: 2, type: 'session.end', session_id: s1, data: null }),
   289→    ].join('\n') + '\n');
   290→    await fs.writeFile(path.join(s1Dir, 'context-iter-1.json'), '{}');
   291→
   292→    // Session 2: active, recent
   293→    const s2 = testUlid('SESS', 2);
   294→    const s2Dir = path.join(sessionsDir, s2);
   295→    await fs.mkdir(s2Dir);
   296→    await fs.writeFile(path.join(s2Dir, 'session.yaml'), YAML.stringify({
   297→      id: s2,
   298→      agent_type: 'custom-agent',
   299→      status: 'active',
   300→      started_at: '2026-02-05T08:00:00.000Z',
   301→    }));
   302→    await fs.writeFile(path.join(s2Dir, 'events.jsonl'), [
   303→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s2, data: null }),
   304→      JSON.stringify({ ts: 2000, seq: 1, type: 'prompt.sent', session_id: s2, data: null }),
   305→      JSON.stringify({ ts: 3000, seq: 2, type: 'prompt.sent', session_id: s2, data: null }),
   306→      JSON.stringify({ ts: 4000, seq: 3, type: 'prompt.sent', session_id: s2, data: null }),
   307→      JSON.stringify({ ts: 5000, seq: 4, type: 'prompt.sent', session_id: s2, data: null }),
   308→    ].join('\n') + '\n');
   309→    await fs.writeFile(path.join(s2Dir, 'context-iter-1.json'), '{}');
   310→    await fs.writeFile(path.join(s2Dir, 'context-iter-2.json'), '{}');
   311→    await fs.writeFile(path.join(s2Dir, 'context-iter-3.json'), '{}');
   312→
   313→    // Session 3: completed, recent
   314→    const s3 = testUlid('SESS', 3);
   315→    const s3Dir = path.join(sessionsDir, s3);
   316→    await fs.mkdir(s3Dir);
   317→    await fs.writeFile(path.join(s3Dir, 'session.yaml'), YAML.stringify({
   318→      id: s3,
   319→      agent_type: 'claude-agent-acp',
   320→      status: 'completed',
   321→      started_at: '2026-02-04T14:00:00.000Z',
   322→      ended_at: '2026-02-04T15:00:00.000Z',
   323→    }));
   324→    await fs.writeFile(path.join(s3Dir, 'events.jsonl'), [
   325→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s3, data: null }),
   326→      JSON.stringify({
   327→        ts: 2000, seq: 1, type: 'session.update', session_id: s3,
   328→        data: {
   329→          iteration: 1,
   330→          update: {
   331→            _meta: { claudeCode: { toolName: 'Bash' } },
   332→            sessionUpdate: 'tool_call',
   333→            rawInput: { command: 'kspec task complete @task-1 --reason "Done"' },
   334→          },
   335→        },
   336→      }),
   337→    ].join('\n') + '\n');
   338→  });
   339→
   340→  afterEach(async () => {
   341→    await cleanupTempDir(tempDir);
   342→  });
   343→
   344→  // AC: @session-log-list ac-1
   345→  it('should display sessions in table format', () => {
   346→    const result = kspec('session log list', tempDir);
   347→    expect(result.exitCode).toBe(0);
   348→    expect(result.stdout).toContain('ID');
   349→    expect(result.stdout).toContain('Status');
   350→    expect(result.stdout).toContain('Agent');
   351→    expect(result.stdout).toContain('Started');
   352→    expect(result.stdout).toContain('Duration');
   353→    expect(result.stdout).toContain('Events');
   354→    expect(result.stdout).toContain('Iters');
   355→    expect(result.stdout).toContain('Tasks');
   356→    expect(result.stdout).toContain('3 session(s)');
   357→  });
   358→
   359→  // AC: @session-log-list ac-1 (JSON variant)
   360→  it('should output valid JSON with all fields in --json mode', () => {
   361→    const sessions = kspecJson<SessionLogSummary[]>('session log list', tempDir);
   362→    expect(sessions).toHaveLength(3);
   363→
   364→    for (const session of sessions) {
   365→      expect(session).toHaveProperty('id');
   366→      expect(session).toHaveProperty('status');
   367→      expect(session).toHaveProperty('agent_type');
   368→      expect(session).toHaveProperty('started_at');
   369→      expect(session).toHaveProperty('duration_ms');
   370→      expect(session).toHaveProperty('event_count');
   371→      expect(session).toHaveProperty('iteration_count');
   372→      expect(session).toHaveProperty('tasks_completed');
   373→    }
   374→  });
   375→
   376→  // AC: @session-log-list ac-2
   377→  it('should filter by --status', () => {
   378→    const sessions = kspecJson<SessionLogSummary[]>('session log list --status completed', tempDir);
   379→    expect(sessions).toHaveLength(2);
   380→    for (const s of sessions) {
   381→      expect(s.status).toBe('completed');
   382→    }
   383→  });
   384→
   385→  // AC: @session-log-list ac-2
   386→  it('should filter by --status active', () => {
   387→    const sessions = kspecJson<SessionLogSummary[]>('session log list --status active', tempDir);
   388→    expect(sessions).toHaveLength(1);
   389→    expect(sessions[0].status).toBe('active');
   390→    expect(sessions[0].agent_type).toBe('custom-agent');
   391→  });
   392→
   393→  // AC: @session-log-list ac-3
   394→  it('should filter by --since', () => {
   395→    const sessions = kspecJson<SessionLogSummary[]>('session log list --since 2026-02-01', tempDir);
   396→    // Only sessions 2 and 3 are after Feb 1
   397→    expect(sessions).toHaveLength(2);
   398→    for (const s of sessions) {
   399→      expect(new Date(s.started_at).getTime()).toBeGreaterThanOrEqual(new Date('2026-02-01').getTime());
   400→    }
   401→  });
   402→
   403→  // AC: @session-log-list ac-4
   404→  it('should filter by --agent', () => {
   405→    const sessions = kspecJson<SessionLogSummary[]>('session log list --agent custom-agent', tempDir);
   406→    expect(sessions).toHaveLength(1);
   407→    expect(sessions[0].agent_type).toBe('custom-agent');
   408→  });
   409→
   410→  // AC: @session-log-list ac-4
   411→  it('should filter by --agent for claude-agent-acp', () => {
   412→    const sessions = kspecJson<SessionLogSummary[]>('session log list --agent claude-agent-acp', tempDir);
   413→    expect(sessions).toHaveLength(2);
   414→    for (const s of sessions) {
   415→      expect(s.agent_type).toBe('claude-agent-acp');
   416→    }
   417→  });
   418→
   419→  // AC: @session-log-list ac-5
   420→  it('should sort by started_at descending by default', () => {
   421→    const sessions = kspecJson<SessionLogSummary[]>('session log list', tempDir);
   422→    expect(sessions).toHaveLength(3);
   423→    // Most recent first
   424→    for (let i = 1; i < sessions.length; i++) {
   425→      expect(new Date(sessions[i - 1].started_at).getTime())
   426→        .toBeGreaterThanOrEqual(new Date(sessions[i].started_at).getTime());
   427→    }
   428→  });
   429→
   430→  // AC: @session-log-list ac-5
   431→  it('should sort by events when --sort events is provided', () => {
   432→    const sessions = kspecJson<SessionLogSummary[]>('session log list --sort events', tempDir);
   433→    // Highest event count first
   434→    for (let i = 1; i < sessions.length; i++) {
   435→      expect(sessions[i - 1].event_count).toBeGreaterThanOrEqual(sessions[i].event_count);
   436→    }
   437→  });
   438→
   439→  // AC: @session-log-list ac-5
   440→  it('should sort by iterations when --sort iterations is provided', () => {
   441→    const sessions = kspecJson<SessionLogSummary[]>('session log list --sort iterations', tempDir);
   442→    for (let i = 1; i < sessions.length; i++) {
   443→      expect(sessions[i - 1].iteration_count).toBeGreaterThanOrEqual(sessions[i].iteration_count);
   444→    }
   445→  });
   446→
   447→  // AC: @session-log-list ac-6
   448→  it('should show "No sessions found" when no sessions exist', async () => {
   449→    // Remove all sessions
   450→    const sessionsDir = path.join(tempDir, '.kspec-sessions');
   451→    await fs.rm(sessionsDir, { recursive: true });
   452→    await fs.mkdir(sessionsDir);
   453→
   454→    const result = kspec('session log list', tempDir);
   455→    expect(result.exitCode).toBe(0);
   456→    expect(result.stdout).toContain('No sessions found');
