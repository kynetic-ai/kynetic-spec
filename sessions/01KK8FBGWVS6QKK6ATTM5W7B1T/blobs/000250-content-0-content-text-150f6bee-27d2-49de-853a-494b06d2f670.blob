   458→
   459→  // AC: @session-log-list ac-6 (JSON variant)
   460→  it('should return empty array in JSON mode when no sessions exist', async () => {
   461→    const sessionsDir = path.join(tempDir, '.kspec-sessions');
   462→    await fs.rm(sessionsDir, { recursive: true });
   463→    await fs.mkdir(sessionsDir);
   464→
   465→    const sessions = kspecJson<SessionLogSummary[]>('session log list', tempDir);
   466→    expect(sessions).toEqual([]);
   467→  });
   468→
   469→  // AC: @session-log-list ac-7
   470→  it('should limit output with --count flag (shows count only)', () => {
   471→    const result = kspec('session log list --count', tempDir);
   472→    expect(result.exitCode).toBe(0);
   473→    expect(result.stdout).toBe('3');
   474→  });
   475→
   476→  // AC: @session-log-list ac-7 (JSON --count)
   477→  it('should return count in JSON mode with --count', () => {
   478→    const data = kspecJson<{ count: number }>('session log list --count', tempDir);
   479→    expect(data.count).toBe(3);
   480→  });
   481→
   482→  // AC: @session-log-list ac-7 (--count with filters)
   483→  it('should respect filters with --count', () => {
   484→    const data = kspecJson<{ count: number }>('session log list --count --status completed', tempDir);
   485→    expect(data.count).toBe(2);
   486→  });
   487→
   488→  // --limit flag
   489→  it('should limit number of sessions with -n flag', () => {
   490→    const sessions = kspecJson<SessionLogSummary[]>('session log list -n 2', tempDir);
   491→    expect(sessions).toHaveLength(2);
   492→  });
   493→
   494→  // Combined filters
   495→  it('should combine --status and --agent filters', () => {
   496→    const sessions = kspecJson<SessionLogSummary[]>(
   497→      'session log list --status active --agent custom-agent',
   498→      tempDir,
   499→    );
   500→    expect(sessions).toHaveLength(1);
   501→    expect(sessions[0].status).toBe('active');
   502→    expect(sessions[0].agent_type).toBe('custom-agent');
   503→  });
   504→
   505→  // Task completion counting
