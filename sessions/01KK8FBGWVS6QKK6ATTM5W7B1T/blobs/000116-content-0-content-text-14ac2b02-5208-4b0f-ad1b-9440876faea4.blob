```
     1→/**
     2→ * Session log commands (list, show, stats, search).
     3→ *
     4→ * These commands have zero dependency on the session-start code.
     5→ */
     6→
     7→import chalk from "chalk";
     8→import {
     9→  initContext,
    10→} from "../../../parser/index.js";
    11→import {
    12→  type SessionLogSummary,
    13→  type SessionLogDetail,
    14→  type SessionLogStats,
    15→  type ToolUsageStats,
    16→  type TimePeriodStats,
    17→  type SessionSearchResult,
    18→  getSessionLogDetail,
    19→  readEvents,
    20→  readSessionContext,
    21→  computeSessionLogStats,
    22→  computeTimePeriodStats,
    23→  deduplicatePhasedToolCalls,
    24→  resolveSessionBlobPointers,
    25→} from "../../../sessions/store.js";
    26→import {
    27→  getAllSessionLogSummariesMerged,
    28→  resolveSessionIdWithFallback,
    29→  searchSessionEventsWithFallback,
    30→  computeToolUsageStatsWithFallback,
    31→  getLegacySessionsDir,
    32→} from "../../../sessions/legacy.js";
    33→import type { SessionEvent } from "../../../sessions/types.js";
    34→import { SessionStatusSchema } from "../../../sessions/types.js";
    35→import {
    36→  formatRelativeTime,
    37→  parseTimeSpec,
    38→} from "../../../utils/index.js";
    39→import { isObject } from "../../../acp/types.js";
    40→import { EXIT_CODES } from "../../exit-codes.js";
    41→import { error, isStructuredMode, output, warn } from "../../output.js";
    42→
    43→// ─── Shared Helpers ─────────────────────────────────────────────────────────
    44→
    45→/**
    46→ * Format a duration in milliseconds to a compact human-readable string.
    47→ * Omits seconds when minutes are present (e.g., "5m" not "5m 30s").
    48→ */
    49→function formatDurationCompact(ms: number): string {
    50→  if (ms < 0) return "—";
    51→  const totalSec = Math.floor(ms / 1000);
    52→  const hours = Math.floor(totalSec / 3600);
    53→  const minutes = Math.floor((totalSec % 3600) / 60);
    54→  if (hours > 0) {
    55→    return `${hours}h ${minutes}m`;
    56→  }
    57→  if (minutes > 0) {
    58→    return `${minutes}m`;
    59→  }
    60→  return `${totalSec}s`;
    61→}
    62→
    63→/**
    64→ * Format a duration in milliseconds to a verbose human-readable string.
    65→ * Shows seconds when minutes are present (e.g., "5m 30s" not "5m").
    66→ */
    67→function formatDurationVerbose(ms: number): string {
    68→  if (ms < 0) return "—";
    69→  const totalSec = Math.floor(ms / 1000);
    70→  const hours = Math.floor(totalSec / 3600);
    71→  const minutes = Math.floor((totalSec % 3600) / 60);
    72→  const seconds = totalSec % 60;
    73→  if (hours > 0 && minutes > 0) {
    74→    return `${hours}h ${minutes}m`;
    75→  }
    76→  if (hours > 0) {
    77→    return `${hours}h`;
    78→  }
    79→  if (minutes > 0) {
    80→    return `${minutes}m ${seconds}s`;
    81→  }
    82→  return `${seconds}s`;
    83→}
    84→
    85→/**
    86→ * Map session status to chalk color function.
    87→ * Unlike statusColor() in format.ts (which handles task statuses),
    88→ * this handles session lifecycle statuses: completed, active, abandoned.
    89→ */
    90→function sessionStatusColor(
    91→  status: string,
    92→): typeof chalk.green {
    93→  switch (status) {
    94→    case "completed":
    95→      return chalk.green;
    96→    case "active":
    97→      return chalk.blue;
    98→    case "abandoned":
    99→      return chalk.yellow;
   100→    default:
   101→      return chalk.gray;
   102→  }
   103→}
   104→
   105→// ─── Session Log List ───────────────────────────────────────────────────────
   106→
   107→interface SessionLogListOptions {
   108→  status?: string;
   109→  agent?: string;
   110→  since?: string;
   111→  sort?: string;
   112→  count?: boolean;
   113→  limit?: string;
   114→}
   115→
   116→type SortField =
   117→  | "started_at"
   118→  | "duration"
   119→  | "events"
   120→  | "iterations"
   121→  | "tasks_completed";
   122→
   123→const VALID_SORT_FIELDS: SortField[] = [
   124→  "started_at",
   125→  "duration",
   126→  "events",
   127→  "iterations",
   128→  "tasks_completed",
   129→];
   130→
   131→/**
   132→ * Sort session summaries by the specified field.
   133→ * Default: started_at descending.
   134→ *
   135→ * AC: @session-log-list ac-5
   136→ */
   137→function sortSessions(
   138→  sessions: SessionLogSummary[],
   139→  sortField: SortField,
   140→): SessionLogSummary[] {
   141→  return [...sessions].sort((a, b) => {
   142→    switch (sortField) {
   143→      case "started_at":
   144→        return (
   145→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
   146→        );
   147→      case "duration":
   148→        return b.duration_ms - a.duration_ms;
   149→      case "events":
   150→        return b.event_count - a.event_count;
   151→      case "iterations":
   152→        return b.iteration_count - a.iteration_count;
   153→      case "tasks_completed":
   154→        return b.tasks_completed - a.tasks_completed;
   155→      default:
   156→        return (
   157→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
   158→        );
   159→    }
   160→  });
   161→}
   162→
   163→/**
   164→ * Format the session log list as a table.
   165→ *
   166→ * AC: @session-log-list ac-1
   167→ * AC: @session-model-evolution ac-6
   168→ */
   169→function formatSessionLogList(sessions: SessionLogSummary[]): void {
   170→  if (sessions.length === 0) {
   171→    // AC: @session-log-list ac-6
   172→    console.log("No sessions found.");
   173→    return;
   174→  }
   175→
   176→  // Table header
   177→  console.log(
   178→    chalk.gray(
   179→      `${"ID".padEnd(10)} ${"Status".padEnd(11)} ${"Type".padEnd(12)} ${"Agent".padEnd(20)} ${"Started".padEnd(16)} ${"Duration".padEnd(10)} ${"Events".padEnd(8)} ${"Iters".padEnd(7)} Tasks`,
   180→    ),
   181→  );
   182→  console.log(chalk.gray("─".repeat(107)));
   183→
   184→  for (const s of sessions) {
   185→    const id = s.id.slice(0, 8);
   186→    const colorFn = sessionStatusColor(s.status);
   187→    const status = colorFn(s.status.padEnd(11));
   188→    const sessionType = s.session_type === "invocation"
   189→      ? chalk.cyan(s.session_type.padEnd(12))
   190→      : chalk.gray(s.session_type.padEnd(12));
   191→    const agent = s.agent_type.slice(0, 20).padEnd(20);
   192→    const started = formatRelativeTime(new Date(s.started_at)).padEnd(16);
   193→    const duration = formatDurationCompact(s.duration_ms).padEnd(10);
   194→    const events = String(s.event_count).padEnd(8);
   195→    const iters = String(s.iteration_count).padEnd(7);
   196→    const tasks = String(s.tasks_completed);
   197→
   198→    console.log(
   199→      `${chalk.yellow(id)} ${status} ${sessionType} ${chalk.gray(agent)} ${chalk.gray(started)} ${duration} ${events} ${iters} ${tasks}`,
   200→    );
   201→  }
   202→
   203→  console.log(chalk.gray(`\n${sessions.length} session(s)`));
   204→}
   205→
   206→/**
   207→ * Session log list action handler.
   208→ */
   209→export async function sessionLogListAction(
   210→  options: SessionLogListOptions,
   211→): Promise<void> {
   212→  try {
   213→    const ctx = await initContext();
   214→    // AC: @session-legacy-migration ac-list-merge — merge primary + legacy sessions
   215→    let sessions = await getAllSessionLogSummariesMerged(ctx.sessionsDir, ctx.specDir);
   216→
   217→    // AC: @session-log-list ac-2 - Filter by status
   218→    if (options.status) {
   219→      const parsed = SessionStatusSchema.safeParse(options.status);
   220→      if (!parsed.success) {
   221→        const valid = SessionStatusSchema.options.join(", ");
   222→        error(`Invalid status: '${options.status}'. Valid values: ${valid}`);
   223→        process.exit(EXIT_CODES.USAGE_ERROR);
   224→      }
   225→      const statusFilter = parsed.data;
   226→      sessions = sessions.filter((s) => s.status === statusFilter);
   227→    }
   228→
   229→    // AC: @session-log-list ac-4 - Filter by agent type
   230→    if (options.agent) {
   231→      const agentFilter = options.agent;
   232→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
   233→    }
   234→
   235→    // AC: @session-log-list ac-3 - Filter by since date
   236→    if (options.since) {
   237→      const sinceDate = parseTimeSpec(options.since);
   238→      if (sinceDate) {
   239→        sessions = sessions.filter(
   240→          (s) => new Date(s.started_at) >= sinceDate,
   241→        );
   242→      }
   243→    }
   244→
   245→    // AC: @session-log-list ac-5 - Sort
   246→    const sortField: SortField =
   247→      options.sort && VALID_SORT_FIELDS.includes(options.sort as SortField)
   248→        ? (options.sort as SortField)
   249→        : "started_at";
   250→    sessions = sortSessions(sessions, sortField);
   251→
   252→    // AC: @session-log-list ac-7 - Limit output count
   253→    if (options.count) {
   254→      // AC: @trait-filterable-list ac-8
   255→      output({ count: sessions.length }, () => {
   256→        console.log(sessions.length);
   257→      });
   258→      return;
   259→    }
   260→
   261→    // Apply --limit (after filtering/sorting, before display)
   262→    if (options.limit) {
   263→      const limit = parseInt(options.limit, 10);
   264→      if (!Number.isNaN(limit) && limit > 0) {
   265→        sessions = sessions.slice(0, limit);
   266→      }
   267→    }
   268→
   269→    output(sessions, () => formatSessionLogList(sessions));
   270→  } catch (err) {
   271→    error("Failed to list session logs", err);
   272→    process.exit(EXIT_CODES.ERROR);
   273→  }
   274→}
   275→
   276→// ─── Session Log Show ───────────────────────────────────────────────────────
   277→
   278→interface SessionLogShowOptions {
   279→  events?: boolean;
   280→  text?: boolean;
   281→  type?: string;
   282→  limit?: string;
   283→  context?: string;
   284→  resolveBlobs?: boolean;
   285→}
   286→
   287→/**
   288→ * Extract replayable assistant text from a top-level content block.
   289→ * Text payloads may be plain strings or resolved blob pointers.
   290→ */
   291→function extractContentBlockText(block: unknown): string {
   292→  if (!isObject(block) || block.type !== "text") {
   293→    return "";
   294→  }
   295→  const textValue = block.text;
   296→  if (typeof textValue === "string") {
   297→    return textValue;
   298→  }
   299→  if (isObject(textValue) && typeof textValue.content === "string") {
   300→    return textValue.content;
   301→  }
   302→  return "";
   303→}
   304→
   305→/**
   306→ * Extract assistant text from a session.update payload.
   307→ *
   308→ * `session.update` payloads can carry content as:
   309→ * - `data.content: ContentBlock[]` (full message events)
   310→ * - `data.content: ContentBlock`   (chunk events)
   311→ */
   312→function extractReplayTextFromSessionUpdate(data: unknown): string {
   313→  if (!isObject(data)) {
   314→    return "";
   315→  }
   316→  const content = data.content;
   317→  if (Array.isArray(content)) {
   318→    return content.map((block) => extractContentBlockText(block)).join("");
   319→  }
   320→  return extractContentBlockText(content);
   321→}
   322→
   323→/**
   324→ * Format an event timestamp as relative time from session start.
   325→ */
   326→function formatEventTimestamp(
   327→  eventTs: number,
   328→  sessionStartTs: number,
   329→): string {
   330→  const relativeMs = eventTs - sessionStartTs;
   331→  const totalSec = Math.floor(relativeMs / 1000);
   332→  const minutes = Math.floor(totalSec / 60);
   333→  const seconds = totalSec % 60;
   334→  if (minutes > 0) {
   335→    return `+${minutes}m${seconds}s`;
   336→  }
   337→  return `+${seconds}s`;
   338→}
   339→
   340→/**
   341→ * Summarize event data for display.
   342→ * Returns a short string describing the event payload.
   343→ *
   344→ * AC: @session-model-evolution ac-7
   345→ */
   346→function summarizeEventData(event: SessionEvent): string {
   347→  const data = event.data;
   348→  if (!isObject(data)) return "";
   349→
   350→  // Handle tool_call events
   351→  if (event.type === "session.update") {
   352→    const update = data.update;
   353→    if (isObject(update) && update.sessionUpdate === "tool_call") {
   354→      const meta = update._meta;
   355→      let toolName = "unknown";
   356→      if (isObject(meta)) {
   357→        const claudeCode = meta.claudeCode;
   358→        if (isObject(claudeCode) && typeof claudeCode.toolName === "string") {
   359→          toolName = claudeCode.toolName;
   360→        }
   361→      }
   362→      const rawInput = update.rawInput;
   363→      if (isObject(rawInput) && typeof rawInput.command === "string") {
   364→        const command = rawInput.command;
   365→        const truncated =
   366→          command.length > 60 ? command.slice(0, 57) + "..." : command;
   367→        return `${toolName}: ${truncated}`;
   368→      }
   369→      return toolName;
   370→    }
   371→  }
   372→
   373→  // Handle prompt.sent events
   374→  if (event.type === "prompt.sent") {
   375→    const prompt = data.prompt;
   376→    if (typeof prompt === "string" && prompt.length > 0) {
   377→      const truncated =
   378→        prompt.length > 60 ? prompt.slice(0, 57) + "..." : prompt;
   379→      return truncated;
   380→    }
   381→  }
   382→
   383→  // Handle session.start/end
   384→  if (event.type === "session.start") {
   385→    return "Session started";
   386→  }
   387→  if (event.type === "session.end") {
   388→    const reason = data.reason;
   389→    return typeof reason === "string" ? `Session ended: ${reason}` : "Session ended";
   390→  }
   391→
   392→  // Handle agent.* events with human-readable summaries
   393→  // AC: @session-model-evolution ac-7
   394→  if (event.type === "agent.dispatched") {
   395→    const taskId = data.task_id;
   396→    return typeof taskId === "string" ? `Dispatched for ${taskId}` : "Agent dispatched";
   397→  }
   398→  if (event.type === "agent.started") {
   399→    const taskId = data.task_id;
   400→    return typeof taskId === "string" ? `Started work on ${taskId}` : "Agent started";
   401→  }
   402→  if (event.type === "agent.completed") {
   403→    const taskId = data.task_id;
   404→    const outcome = data.outcome;
   405→    const durationMs = data.duration_ms;
   406→    const parts: string[] = [];
   407→    if (typeof taskId === "string") parts.push(taskId);
   408→    if (typeof outcome === "string") parts.push(`outcome: ${outcome}`);
   409→    if (typeof durationMs === "number") parts.push(`${formatDurationCompact(durationMs)}`);
   410→    return parts.length > 0 ? parts.join(", ") : "Agent completed";
   411→  }
   412→  if (event.type === "agent.failed") {
   413→    const taskId = data.task_id;
   414→    const reason = data.reason;
   415→    if (typeof taskId === "string" && typeof reason === "string") {
   416→      return `${taskId}: ${reason}`;
   417→    }
   418→    return typeof reason === "string" ? reason : "Agent failed";
   419→  }
   420→  if (event.type === "agent.timeout") {
   421→    const taskId = data.task_id;
   422→    return typeof taskId === "string" ? `Timeout on ${taskId}` : "Agent timed out";
   423→  }
   424→
   425→  // Default: show first key
   426→  const keys = Object.keys(data);
   427→  if (keys.length > 0) {
   428→    return `{${keys.slice(0, 3).join(", ")}${keys.length > 3 ? ", ..." : ""}}`;
   429→  }
   430→  return "";
   431→}
   432→
   433→/**
   434→ * Format the session log show output.
   435→ *
   436→ * AC: @session-log-show ac-1
   437→ * AC: @session-model-evolution ac-6, ac-7
   438→ */
   439→function formatSessionLogShow(
   440→  detail: SessionLogDetail,
   441→  events: SessionEvent[] | null,
   442→  contextSnapshot: unknown,
   443→  sessionStartTs: number,
   444→): void {
   445→  // AC: @session-log-show ac-1 - Session metadata
   446→  console.log(chalk.bold(`Session ${detail.id.slice(0, 8)}`));
   447→  console.log(chalk.gray("─".repeat(60)));
   448→  console.log(`  ID:        ${detail.id}`);
   449→
   450→  console.log(`  Status:    ${sessionStatusColor(detail.status)(detail.status)}`);
   451→  // AC: @session-model-evolution ac-6 — show session type
   452→  const sessionTypeDisplay = detail.session_type === "invocation"
   453→    ? chalk.cyan(detail.session_type)
   454→    : chalk.gray(detail.session_type);
   455→  console.log(`  Type:      ${sessionTypeDisplay}`);
   456→  console.log(`  Agent:     ${detail.agent_type}`);
   457→  if (detail.task_id) {
   458→    console.log(`  Task:      ${detail.task_id}`);
   459→  }
   460→  console.log(`  Started:   ${detail.started_at}`);
   461→  if (detail.ended_at) {
   462→    console.log(`  Ended:     ${detail.ended_at}`);
   463→  }
   464→  console.log(`  Duration:  ${formatDurationCompact(detail.duration_ms)}`);
   465→  console.log(`  Events:    ${detail.event_count}`);
   466→  console.log(`  Iterations: ${detail.iteration_count}`);
   467→
   468→  // AC: @session-log-show ac-2 - Per-iteration summary
   469→  if (detail.iterations.length > 0) {
   470→    console.log("\n" + chalk.bold("Iterations"));
   471→    console.log(chalk.gray("─".repeat(60)));
   472→    for (const iter of detail.iterations) {
   473→      const taskInfo: string[] = [];
   474→      if (iter.tasks_started.length > 0) {
   475→        taskInfo.push(`started: ${iter.tasks_started.join(", ")}`);
   476→      }
   477→      if (iter.tasks_completed.length > 0) {
   478→        taskInfo.push(`completed: ${iter.tasks_completed.join(", ")}`);
   479→      }
   480→      const taskStr = taskInfo.length > 0 ? ` | ${taskInfo.join(" | ")}` : "";
   481→      console.log(
   482→        `  ${chalk.cyan(`[${iter.iteration}]`)} ${iter.event_count} events${taskStr}`,
   483→      );
   484→    }
   485→  }
   486→
   487→  // AC: @session-log-show ac-3 - Event timeline
   488→  if (events !== null) {
   489→    console.log("\n" + chalk.bold("Events"));
   490→    console.log(chalk.gray("─".repeat(60)));
   491→    if (events.length === 0) {
   492→      console.log(chalk.gray("  No events to display."));
   493→    } else {
   494→      for (const event of events) {
   495→        const timestamp = formatEventTimestamp(event.ts, sessionStartTs);
   496→        const summary = summarizeEventData(event);
   497→        // AC: @session-model-evolution ac-7 — agent.* events use magenta for visibility
   498→        const typeColor =
   499→          event.type === "session.start" || event.type === "session.end"
   500→            ? chalk.green
   501→            : event.type === "session.update"
   502→              ? chalk.blue
   503→              : event.type.startsWith("agent.")
   504→                ? chalk.magenta
   505→                : chalk.gray;
   506→        console.log(
   507→          `  ${chalk.yellow(timestamp.padEnd(10))} ${typeColor(event.type.padEnd(20))} ${chalk.gray(summary)}`,
   508→        );
   509→      }
   510→    }
   511→  }
   512→
   513→  // AC: @session-log-show ac-6 - Context snapshot
   514→  if (contextSnapshot !== null) {
   515→    console.log("\n" + chalk.bold("Context Snapshot"));
   516→    console.log(chalk.gray("─".repeat(60)));
   517→    console.log(JSON.stringify(contextSnapshot, null, 2));
   518→  }
   519→}
   520→
   521→/**
   522→ * Session log show action handler.
   523→ */
   524→export async function sessionLogShowAction(
   525→  sessionRef: string,
   526→  options: SessionLogShowOptions,
   527→): Promise<void> {
   528→  try {
   529→    const ctx = await initContext();
   530→
   531→    // AC: @session-log-show ac-7, ac-8, ac-9 - Resolve session ID
   532→    // AC: @session-legacy-migration ac-read-fallback — try primary, then legacy
   533→    const resolution = await resolveSessionIdWithFallback(ctx.sessionsDir, sessionRef, ctx.specDir);
   534→
   535→    if (!resolution.ok) {
   536→      if (resolution.error === "not_found") {
   537→        // AC: @session-log-show ac-9
   538→        error(`Session not found: ${sessionRef}`);
   539→        process.exit(EXIT_CODES.NOT_FOUND);
   540→      } else {
   541→        // AC: @session-log-show ac-8
   542→        error(
   543→          `Ambiguous session ID prefix. Matches:\n  ${resolution.matches.join("\n  ")}\nPlease provide a more specific prefix.`,
   544→        );
   545→        process.exit(EXIT_CODES.VALIDATION_FAILED);
   546→      }
   547→    }
   548→
   549→    const sessionId = resolution.id;
   550→    // Use legacy dir for all reads if session was found there
   551→    const effectiveDir = resolution.legacy
   552→      ? getLegacySessionsDir(ctx.specDir)!
   553→      : ctx.sessionsDir;
   554→
   555→    // Get session detail
   556→    const detail = await getSessionLogDetail(effectiveDir, sessionId);
   557→    if (!detail) {
   558→      error(`Session not found: ${sessionId}`);
   559→      process.exit(EXIT_CODES.NOT_FOUND);
   560→    }
   561→
   562→    if (options.resolveBlobs && !options.events && !options.text) {
   563→      warn("--resolve-blobs has no effect without --events; showing metadata only.");
   564→    }
   565→
   566→    // AC: @session-log-show ac-3, ac-4, ac-5 - Event timeline
   567→    let events: SessionEvent[] | null = null;
   568→    if (options.events) {
   569→      let allEvents = deduplicatePhasedToolCalls(
   570→        await readEvents(effectiveDir, sessionId),
   571→      );
   572→
   573→      // AC: @session-log-show ac-4 - Filter by type
   574→      if (options.type) {
   575→        const typeFilter = options.type;
   576→        allEvents = allEvents.filter((e) => e.type === typeFilter);
   577→      }
   578→
   579→      // AC: @session-log-show ac-5 - Limit to last N events
   580→      if (options.limit) {
   581→        const limit = parseInt(options.limit, 10);
   582→        if (!Number.isNaN(limit) && limit > 0) {
   583→          allEvents = allEvents.slice(-limit);
   584→        }
   585→      }
   586→
   587→      if (options.resolveBlobs) {
   588→        allEvents = await Promise.all(
   589→          allEvents.map(async (event) => ({
   590→            ...event,
   591→            data: await resolveSessionBlobPointers(
   592→              effectiveDir,
   593→              sessionId,
   594→              event.data,
   595→            ),
   596→          })),
   597→        );
   598→      }
   599→
   600→      events = allEvents;
   601→    }
   602→
   603→    // AC: @session-log-show ac-11 - Replay assistant text from session.update content blocks
   604→    let replayText: string | null = null;
   605→    if (options.text) {
   606→      const allEvents = await readEvents(effectiveDir, sessionId);
   607→      const chunks: string[] = [];
   608→      for (const event of allEvents) {
   609→        if (event.type !== "session.update") {
   610→          continue;
   611→        }
   612→        const resolvedData = await resolveSessionBlobPointers(
   613→          effectiveDir,
   614→          sessionId,
   615→          event.data,
   616→        );
   617→        const textChunk = extractReplayTextFromSessionUpdate(resolvedData);
   618→        if (textChunk.length > 0) {
   619→          chunks.push(textChunk);
   620→        }
   621→      }
   622→      replayText = chunks.join("");
   623→    }
   624→
   625→    // AC: @session-log-show ac-6 - Context snapshot
   626→    let contextSnapshot: unknown = null;
   627→    if (options.context) {
   628→      const iterNum = parseInt(options.context, 10);
   629→      if (!Number.isNaN(iterNum) && iterNum > 0) {
   630→        contextSnapshot = await readSessionContext(
   631→          effectiveDir,
   632→          sessionId,
   633→          iterNum,
   634→        );
   635→        if (contextSnapshot === null) {
   636→          error(`No context snapshot found for iteration ${iterNum}`);
   637→          process.exit(EXIT_CODES.NOT_FOUND);
   638→        }
   639→      } else {
   640→        error(`Invalid iteration number: ${options.context}`);
   641→        process.exit(EXIT_CODES.USAGE_ERROR);
   642→      }
   643→    }
   644→
   645→    const sessionStartTs = new Date(detail.started_at).getTime();
   646→
   647→    // Build JSON output structure
   648→    const jsonOutput = {
   649→      ...detail,
   650→      ...(events !== null ? { events } : {}),
   651→      ...(replayText !== null ? { text: replayText } : {}),
   652→      ...(contextSnapshot !== null ? { context: contextSnapshot } : {}),
   653→    };
   654→
   655→    output(jsonOutput, () => {
   656→      // In text mode, `--text` alone behaves like a raw replay stream.
   657→      if (options.text && !options.events && !options.context && !isStructuredMode()) {
   658→        process.stdout.write(replayText ?? "");
   659→        return;
   660→      }
   661→
   662→      formatSessionLogShow(detail, events, contextSnapshot, sessionStartTs);
   663→
   664→      // Keep --events/--context independent from --text in text mode.
   665→      if (
   666→        options.text &&
   667→        !isStructuredMode() &&
   668→        (options.events || options.context) &&
   669→        (replayText?.length ?? 0) > 0
   670→      ) {
   671→        process.stdout.write(`\n${replayText}`);
   672→      }
   673→    });
   674→  } catch (err) {
   675→    error("Failed to show session log", err);
   676→    process.exit(EXIT_CODES.ERROR);
   677→  }
   678→}
   679→
   680→// ─── Session Log Stats ──────────────────────────────────────────────────────
   681→
   682→interface SessionLogStatsOptions {
   683→  since?: string;
   684→  agent?: string;
   685→  toolUsage?: boolean;
   686→  byDay?: boolean;
   687→  byWeek?: boolean;
   688→}
   689→
   690→/**
   691→ * Full stats output including optional tool usage and time period data.
   692→ */
   693→interface SessionLogStatsOutput {
   694→  stats: SessionLogStats;
   695→  tool_usage?: ToolUsageStats[];
   696→  time_periods?: TimePeriodStats[];
   697→}
   698→
   699→/**
   700→ * Format the session log stats output.
   701→ *
   702→ * AC: @session-log-stats ac-1, ac-2, ac-3
   703→ */
   704→function formatSessionLogStats(
   705→  stats: SessionLogStats,
   706→  toolUsage: ToolUsageStats[] | null,
   707→  timePeriods: TimePeriodStats[] | null,
   708→  groupBy: "day" | "week" | null,
   709→): void {
   710→  // AC: @session-log-stats ac-1 - Totals
   711→  console.log(chalk.bold("Session Statistics"));
   712→  console.log(chalk.gray("─".repeat(50)));
   713→  console.log(`  Total Sessions:     ${stats.total_sessions}`);
   714→  console.log(`  Total Events:       ${stats.total_events}`);
   715→  console.log(`  Total Iterations:   ${stats.total_iterations}`);
   716→  console.log(`  Tasks Completed:    ${stats.total_tasks_completed}`);
   717→  console.log(`  Total Duration:     ${formatDurationVerbose(stats.total_duration_ms)}`);
   718→
   719→  // AC: @session-log-stats ac-2 - Averages
   720→  console.log("\n" + chalk.bold("Averages"));
   721→  console.log(chalk.gray("─".repeat(50)));
   722→  console.log(`  Avg Duration/Session:     ${formatDurationVerbose(stats.avg_duration_ms)}`);
   723→  console.log(`  Avg Iterations/Session:   ${stats.avg_iterations_per_session}`);
   724→  console.log(`  Avg Tasks/Session:        ${stats.avg_tasks_per_session}`);
   725→
   726→  // AC: @session-log-stats ac-3 - Status breakdown
   727→  if (stats.status_breakdown.length > 0) {
   728→    console.log("\n" + chalk.bold("Status Breakdown"));
   729→    console.log(chalk.gray("─".repeat(50)));
   730→    for (const item of stats.status_breakdown) {
   731→      console.log(
   732→        `  ${sessionStatusColor(item.status)(item.status.padEnd(12))} ${String(item.count).padEnd(6)} ${item.percentage}%`,
   733→      );
   734→    }
   735→  }
   736→
   737→  // AC: @session-log-stats ac-6 - Tool usage
   738→  if (toolUsage !== null && toolUsage.length > 0) {
   739→    console.log("\n" + chalk.bold("Top Tool Usage"));
   740→    console.log(chalk.gray("─".repeat(50)));
   741→    for (const tool of toolUsage) {
   742→      console.log(
   743→        `  ${tool.tool_name.padEnd(20)} ${String(tool.count).padEnd(8)} ${tool.percentage}%`,
   744→      );
   745→    }
   746→  }
   747→
   748→  // AC: @session-log-stats ac-7 - Time periods
   749→  if (timePeriods !== null && timePeriods.length > 0) {
   750→    const label = groupBy === "week" ? "By Week" : "By Day";
   751→    console.log("\n" + chalk.bold(label));
   752→    console.log(chalk.gray("─".repeat(50)));
   753→    console.log(
   754→      chalk.gray(
   755→        `  ${"Period".padEnd(14)} ${"Sessions".padEnd(10)} ${"Tasks".padEnd(8)} Duration`,
   756→      ),
   757→    );
   758→    for (const period of timePeriods) {
   759→      console.log(
   760→        `  ${period.period.padEnd(14)} ${String(period.sessions_count).padEnd(10)} ${String(period.tasks_completed).padEnd(8)} ${formatDurationVerbose(period.total_duration_ms)}`,
   761→      );
   762→    }
   763→  }
   764→}
   765→
   766→/**
   767→ * Session log stats action handler.
   768→ */
   769→export async function sessionLogStatsAction(
   770→  options: SessionLogStatsOptions,
   771→): Promise<void> {
   772→  try {
   773→    const ctx = await initContext();
   774→    // AC: @session-legacy-migration ac-list-merge — merge primary + legacy sessions
   775→    let sessions = await getAllSessionLogSummariesMerged(ctx.sessionsDir, ctx.specDir);
   776→
   777→    // AC: @session-log-stats ac-4 - Filter by since
   778→    if (options.since) {
   779→      const sinceDate = parseTimeSpec(options.since);
   780→      if (sinceDate) {
   781→        sessions = sessions.filter(
   782→          (s) => new Date(s.started_at) >= sinceDate,
   783→        );
   784→      }
   785→    }
   786→
   787→    // AC: @session-log-stats ac-5 - Filter by agent type
   788→    if (options.agent) {
   789→      const agentFilter = options.agent;
   790→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
   791→    }
   792→
   793→    // AC: @session-log-stats ac-8 - No sessions match criteria
   794→    if (sessions.length === 0) {
   795→      output({ message: "No sessions match criteria" }, () => {
   796→        console.log("No sessions match criteria.");
   797→      });
   798→      return;
   799→    }
   800→
   801→    // Compute base stats
   802→    const stats = computeSessionLogStats(sessions);
   803→
   804→    // AC: @session-log-stats ac-6 - Tool usage (optional)
   805→    let toolUsage: ToolUsageStats[] | null = null;
   806→    if (options.toolUsage) {
   807→      const sessionIds = sessions.map((s) => s.id);
   808→      toolUsage = await computeToolUsageStatsWithFallback(ctx.sessionsDir, sessionIds, ctx.specDir);
   809→    }
   810→
   811→    // AC: @session-log-stats ac-7 - Time periods (optional)
   812→    let timePeriods: TimePeriodStats[] | null = null;
   813→    let groupBy: "day" | "week" | null = null;
   814→    if (options.byDay) {
   815→      groupBy = "day";
   816→      timePeriods = computeTimePeriodStats(sessions, "day");
   817→    } else if (options.byWeek) {
   818→      groupBy = "week";
   819→      timePeriods = computeTimePeriodStats(sessions, "week");
   820→    }
   821→
   822→    // Build output structure
   823→    const jsonOutput: SessionLogStatsOutput = { stats };
   824→    if (toolUsage !== null) {
   825→      jsonOutput.tool_usage = toolUsage;
   826→    }
   827→    if (timePeriods !== null) {
   828→      jsonOutput.time_periods = timePeriods;
   829→    }
   830→
   831→    output(jsonOutput, () =>
   832→      formatSessionLogStats(stats, toolUsage, timePeriods, groupBy),
   833→    );
   834→  } catch (err) {
   835→    error("Failed to compute session log stats", err);
   836→    process.exit(EXIT_CODES.ERROR);
   837→  }
   838→}
   839→
   840→// ─── Session Log Search ─────────────────────────────────────────────────────
   841→
   842→interface SessionLogSearchOptions {
   843→  type?: string;
   844→  since?: string;
   845→  agent?: string;
   846→  limit?: string;
   847→  resolveBlobs?: boolean;
   848→}
   849→
   850→/**
   851→ * Format the session log search output.
   852→ *
   853→ * AC: @session-log-search ac-1, ac-4
   854→ */
   855→function formatSessionLogSearch(results: SessionSearchResult[]): void {
   856→  if (results.length === 0) {
   857→    // AC: @session-log-search ac-6
   858→    console.log("No matches found.");
   859→    return;
   860→  }
   861→
   862→  let totalMatches = 0;
   863→  for (const session of results) {
   864→    totalMatches += session.matches.length;
   865→  }
   866→
   867→  console.log(chalk.bold(`Found ${totalMatches} match(es) in ${results.length} session(s)`));
   868→  console.log(chalk.gray("─".repeat(60)));
   869→
   870→  for (const session of results) {
   871→    // Session header
   872→    console.log(
   873→      `\n${chalk.cyan(`Session ${session.session_id.slice(0, 8)}`)} ` +
   874→        `${chalk.gray(`(${session.agent_type}, started ${formatRelativeTime(new Date(session.started_at))})`)}`
   875→    );
   876→
   877→    // AC: @session-log-search ac-4 - Show matches with session ID, timestamp, type, excerpt
   878→    for (const match of session.matches) {
   879→      const ts = new Date(match.timestamp).toISOString();
   880→      const typeColor =
   881→        match.event_type === "session.start" || match.event_type === "session.end"
   882→          ? chalk.green
   883→          : match.event_type === "session.update"
   884→            ? chalk.blue
   885→            : chalk.gray;
   886→      console.log(
   887→        `  ${chalk.yellow(ts)} ${typeColor(match.event_type.padEnd(16))}`,
   888→      );
   889→      // Content excerpt on next line, indented
   890→      console.log(`    ${chalk.gray(match.content_excerpt)}`);
   891→    }
   892→  }
   893→}
   894→
   895→/**
   896→ * Session log search action handler.
   897→ *
   898→ * AC: @session-log-search ac-1 through ac-7
   899→ */
   900→export async function sessionLogSearchAction(
   901→  pattern: string,
   902→  options: SessionLogSearchOptions,
   903→): Promise<void> {
   904→  try {
   905→    const ctx = await initContext();
   906→
   907→    // Parse options - validate limit as positive integer
   908→    let limit = 50;
   909→    if (options.limit) {
   910→      const parsed = parseInt(options.limit, 10);
   911→      if (Number.isNaN(parsed) || parsed <= 0) {
   912→        error(`Invalid limit: ${options.limit}. Must be a positive integer.`);
   913→        process.exit(EXIT_CODES.USAGE_ERROR);
   914→      }
   915→      limit = parsed;
   916→    }
   917→    const sinceDate = options.since ? parseTimeSpec(options.since) : undefined;
   918→
   919→    // AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7
   920→    // AC: @session-legacy-migration ac-read-fallback — search across primary + legacy
   921→    const results = await searchSessionEventsWithFallback(
   922→      ctx.sessionsDir,
   923→      pattern,
   924→      {
   925→        eventType: options.type,
   926→        sinceDate: sinceDate || undefined,
   927→        agentType: options.agent,
   928→        limit,
   929→        resolveBlobs: options.resolveBlobs,
   930→      },
   931→      ctx.specDir,
   932→    );
   933→
   934→    // AC: @session-log-search ac-6 - No matches found message
   935→    // exit code 0 regardless (per @trait-semantic-exit-codes ac-5)
   936→
   937→    output(results, () => formatSessionLogSearch(results));
   938→  } catch (err) {
   939→    error("Failed to search session logs", err);
   940→    process.exit(EXIT_CODES.ERROR);
   941→  }
   942→}
