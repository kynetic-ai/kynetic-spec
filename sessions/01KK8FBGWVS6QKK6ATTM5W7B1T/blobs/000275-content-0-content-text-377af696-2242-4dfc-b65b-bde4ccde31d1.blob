     1→/**
     2→ * Shared CLI test utilities
     3→ *
     4→ * Provides centralized helpers for running kspec CLI commands in tests.
     5→ * Uses pre-built dist/cli/index.js for performance (eliminates tsx transpilation overhead).
     6→ *
     7→ * ## ULID Patterns for Test Fixtures
     8→ *
     9→ * ULIDs use Crockford base32 which EXCLUDES: I, L, O, U
    10→ * Valid characters: 0-9, A-H, J-K, M-N, P-T, V-Z
    11→ *
    12→ * Common test ULID mistakes:
    13→ * - ❌ 01TRAIT10... (contains I)
    14→ * - ❌ 01TASK100... (contains I)
    15→ * - ❌ 01MODULE0... (contains O and U)
    16→ * - ✅ 01TRATT100... (valid - no I, L, O, U)
    17→ * - ✅ 01TASK0000... (valid - T, A, S, K are allowed)
    18→ *
    19→ * Use testUlid() to generate valid test ULIDs with readable prefixes.
    20→ *
    21→ * ## YAML Fixture Creation
    22→ *
    23→ * Don't use JSON.stringify() for YAML - it produces invalid syntax.
    24→ * Options:
    25→ * 1. Use setupTempFixtures() with pre-built fixtures (preferred)
    26→ * 2. Write YAML strings directly with template literals
    27→ * 3. Use the yaml library: import { stringify } from 'yaml'
    28→ */
    29→import { execSync, spawnSync } from 'node:child_process';
    30→import * as fs from 'node:fs/promises';
    31→import * as path from 'node:path';
    32→import * as os from 'node:os';
    33→
    34→// Use built CLI for performance - requires `npm run build` before tests
    35→export const CLI_PATH = path.join(__dirname, '..', '..', 'dist', 'cli', 'index.js');
    36→
    37→// Fixtures directory for test data
    38→export const FIXTURES_DIR = path.join(__dirname, '..', 'fixtures');
    39→
    40→/**
    41→ * Options for running kspec CLI commands
    42→ */
    43→export interface KspecOptions {
    44→  /** Input to pipe to stdin */
    45→  stdin?: string;
    46→  /** Don't throw on non-zero exit code */
    47→  expectFail?: boolean;
    48→  /** Additional environment variables */
    49→  env?: Record<string, string>;
    50→}
    51→
    52→/**
    53→ * Result from running a kspec CLI command
    54→ */
    55→export interface KspecResult {
    56→  /** Exit code (0 = success) */
    57→  exitCode: number;
    58→  /** Standard output (trimmed) */
    59→  stdout: string;
    60→  /** Standard error (trimmed) */
    61→  stderr: string;
    62→}
    63→
    64→/**
    65→ * Result from one startup/readiness probe.
    66→ */
    67→export interface StartupProbeResult {
    68→  /** Whether startup/readiness condition is satisfied */
    69→  ok: boolean;
    70→  /** Diagnostic detail for timeout errors */
    71→  details: string;
    72→}
    73→
    74→/**
    75→ * Options for startup/readiness wait helper.
    76→ */
    77→export interface WaitForStartupOptions {
    78→  /** Maximum wait duration before failing */
    79→  timeoutMs?: number;
    80→  /** Poll interval between probe checks */
    81→  intervalMs?: number;
    82→}
    83→
    84→/**
    85→ * Run a kspec CLI command
    86→ *
    87→ * @param args - CLI arguments (e.g., "task list --json")
    88→ * @param cwd - Working directory to run the command in
    89→ * @param options - Optional settings for stdin, error handling, env vars
    90→ * @returns KspecResult with exitCode, stdout, stderr
    91→ * @throws Error if command fails and expectFail is not set
    92→ *
    93→ * @example
    94→ * // Simple command
    95→ * const result = kspec('task list', tempDir);
    96→ *
    97→ * @example
    98→ * // With stdin
    99→ * const result = kspec('item set @ref --status implemented', tempDir, { stdin: 'y' });
   100→ *
   101→ * @example
   102→ * // Expecting failure
   103→ * const result = kspec('task set @ref --priority 99', tempDir, { expectFail: true });
   104→ * expect(result.exitCode).toBe(1);
   105→ */
   106→export function kspec(args: string, cwd: string, options: KspecOptions = {}): KspecResult {
   107→  const { stdin, expectFail = false, env = {} } = options;
   108→
   109→  // Build clean env: strip ralph-specific vars that pollute tests when running
   110→  // inside a ralph loop. Tests that need these vars pass them explicitly via env.
   111→  const cleanEnv = { ...process.env };
   112→  const RALPH_ENV_VARS = ['KSPEC_RALPH_SESSION', 'KSPEC_SESSION_ID'];
   113→  for (const key of RALPH_ENV_VARS) {
   114→    if (!(key in env)) {
   115→      delete cleanEnv[key];
   116→    }
   117→  }
   118→
   119→  // Use spawnSync with shell to capture both stdout and stderr
   120→  // Always use shell mode to properly handle argument parsing and quoting
   121→  const result = spawnSync('/bin/sh', ['-c', `node ${CLI_PATH} ${args}`], {
   122→    cwd,
   123→    encoding: 'utf-8',
   124→    timeout: 30_000,
   125→    env: { ...cleanEnv, KSPEC_AUTHOR: '@test', ...env },
   126→    input: stdin !== undefined ? (stdin.endsWith('\n') ? stdin : stdin + '\n') : undefined,
   127→  });
   128→
   129→  // Detect timeout (spawnSync kills the process and sets signal)
   130→  if (result.signal === 'SIGTERM' && result.error?.message?.includes('ETIMEDOUT')) {
   131→    throw new Error(`Command timed out after 30s: node ${CLI_PATH} ${args}`);
   132→  }
   133→
   134→  const kspecResult: KspecResult = {
   135→    exitCode: result.status ?? 1,
   136→    stdout: (result.stdout || '').trim(),
   137→    stderr: (result.stderr || '').trim(),
   138→  };
   139→
   140→  // Handle errors
   141→  if (kspecResult.exitCode !== 0) {
   142→    if (expectFail) {
   143→      return kspecResult;
   144→    }
   145→
   146→    // For backwards compatibility: return stdout if present even on error
   147→    // (some commands exit non-zero with valid output)
   148→    if (kspecResult.stdout) {
   149→      return kspecResult;
   150→    }
   151→
   152→    throw new Error(`Command failed: node ${CLI_PATH} ${args}\n${kspecResult.stderr || result.error?.message}`);
   153→  }
   154→
   155→  return kspecResult;
   156→}
   157→
   158→/**
   159→ * Run kspec and return just stdout (convenience wrapper)
   160→ *
   161→ * @param args - CLI arguments
   162→ * @param cwd - Working directory
   163→ * @param options - Optional settings
   164→ * @returns stdout trimmed
   165→ */
   166→export function kspecOutput(args: string, cwd: string, options: KspecOptions = {}): string {
   167→  return kspec(args, cwd, options).stdout;
   168→}
   169→
   170→/**
   171→ * Run kspec and return parsed JSON output
   172→ *
   173→ * @param args - CLI arguments (--json flag is added automatically)
   174→ * @param cwd - Working directory
   175→ * @param options - Optional settings
   176→ * @returns Parsed JSON response
   177→ */
   178→export function kspecJson<T>(args: string, cwd: string, options: KspecOptions = {}): T {
   179→  const result = kspec(`${args} --json`, cwd, options);
   180→  return JSON.parse(result.stdout);
   181→}
   182→
   183→/**
   184→ * Bounded polling helper for startup/readiness checks in daemon/process tests.
   185→ *
   186→ * Throws with the most recent probe details to make timeout failures actionable.
   187→ */
   188→export async function waitForStartup(
   189→  description: string,
   190→  probe: () => StartupProbeResult | Promise<StartupProbeResult>,
   191→  options: WaitForStartupOptions = {}
   192→): Promise<void> {
   193→  const timeoutMs = options.timeoutMs ?? 5_000;
   194→  const intervalMs = options.intervalMs ?? 100;
   195→  const startedAt = Date.now();
   196→  let lastDetails = 'no observation collected';
   197→
   198→  while (Date.now() - startedAt < timeoutMs) {
   199→    const result = await probe();
   200→    lastDetails = result.details;
   201→
   202→    if (result.ok) {
   203→      return;
   204→    }
   205→
   206→    await new Promise((resolve) => setTimeout(resolve, intervalMs));
   207→  }
   208→
   209→  throw new Error(
   210→    `Timed out waiting for ${description} after ${timeoutMs}ms. Last observation: ${lastDetails}`
   211→  );
   212→}
   213→
   214→// Legacy aliases for backwards compatibility
   215→export const kspecExpectFail = (args: string, cwd: string): string => {
   216→  const result = kspec(args, cwd, { expectFail: true });
   217→  return result.stderr || result.stdout;
   218→};
   219→
   220→export const kspecWithStatus = (args: string, cwd: string): KspecResult => {
   221→  return kspec(args, cwd, { expectFail: true });
   222→};
   223→
   224→/**
   225→ * Copy fixtures to a temp directory for isolated testing
   226→ *
   227→ * Excludes the 'multi-dir' subdirectory (use setupMultiDirFixtures() for that).
   228→ *
   229→ * @returns Path to the temp directory
   230→ */
   231→export async function setupTempFixtures(): Promise<string> {
   232→  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-test-'));
   233→
   234→  // Copy all fixtures except multi-dir
   235→  const entries = await fs.readdir(FIXTURES_DIR, { withFileTypes: true });
   236→  for (const entry of entries) {
   237→    if (entry.name === 'multi-dir') continue; // Skip multi-dir fixtures
   238→    const source = path.join(FIXTURES_DIR, entry.name);
   239→    const dest = path.join(tempDir, entry.name);
   240→    if (entry.isDirectory()) {
   241→      await fs.cp(source, dest, { recursive: true });
   242→    } else {
   243→      await fs.copyFile(source, dest);
   244→    }
   245→  }
   246→
   247→  return tempDir;
   248→}
   249→
   250→/**
   251→ * Copy multi-directory daemon fixtures to a temp directory
   252→ *
   253→ * Creates isolated copies of multiple kspec projects for testing
   254→ * multi-directory daemon functionality.
   255→ *
   256→ * @returns Path to the temp directory containing project subdirectories
   257→ *
   258→ * @example
   259→ * const fixturesRoot = await setupMultiDirFixtures();
   260→ * const projectA = path.join(fixturesRoot, 'project-a');
   261→ * const projectB = path.join(fixturesRoot, 'project-b');
   262→ * const projectInvalid = path.join(fixturesRoot, 'project-invalid');
   263→ *
   264→ * // Clean up when done
   265→ * await cleanupTempDir(fixturesRoot);
   266→ */
   267→export async function setupMultiDirFixtures(): Promise<string> {
   268→  const multiDirSource = path.join(FIXTURES_DIR, 'multi-dir');
   269→  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-multi-'));
   270→  await fs.cp(multiDirSource, tempDir, { recursive: true });
   271→  return tempDir;
   272→}
   273→
   274→/**
   275→ * Clean up a temp directory
   276→ *
   277→ * @param dir - Directory to remove
   278→ */
   279→export async function cleanupTempDir(dir: string): Promise<void> {
   280→  await fs.rm(dir, { recursive: true, force: true });
   281→}
   282→
   283→/**
   284→ * Create an empty temp directory (no fixtures)
   285→ *
   286→ * @param prefix - Optional prefix for the temp directory name
   287→ * @returns Path to the temp directory
   288→ */
   289→export async function createTempDir(prefix = 'kspec-test-'): Promise<string> {
   290→  return fs.mkdtemp(path.join(os.tmpdir(), prefix));
   291→}
   292→
   293→/**
   294→ * Isolated HOME/config paths for daemon-sensitive CLI tests.
   295→ */
   296→export interface IsolatedKspecHome {
   297→  /** Home directory used for HOME/USERPROFILE overrides */
   298→  homeDir: string;
   299→  /** kspec config directory under the isolated home */
   300→  configDir: string;
   301→  /** Global daemon PID file path under isolated HOME */
   302→  daemonPidFilePath: string;
   303→  /** Global daemon port file path under isolated HOME */
   304→  daemonPortFilePath: string;
   305→  /** Environment overrides for running commands in isolated HOME */
   306→  env: Record<string, string>;
   307→}
   308→
   309→/**
   310→ * Create isolated HOME/config paths for daemon-sensitive CLI tests.
   311→ *
   312→ * This avoids ambient ~/.config/kspec PID/port state leaking into tests.
   313→ *
   314→ * @param rootDir - Root directory where isolated home will be created
   315→ * @param homeDirName - Optional isolated home subdirectory name
   316→ */
   317→export async function createIsolatedKspecHome(
   318→  rootDir: string,
   319→  homeDirName = '.home'
   320→): Promise<IsolatedKspecHome> {
   321→  const homeDir = path.join(rootDir, homeDirName);
   322→  const configDir = path.join(homeDir, '.config', 'kspec');
   323→  await fs.mkdir(configDir, { recursive: true });
   324→
   325→  return {
   326→    homeDir,
   327→    configDir,
   328→    daemonPidFilePath: path.join(configDir, 'daemon.pid'),
   329→    daemonPortFilePath: path.join(configDir, 'daemon.port'),
   330→    env: {
   331→      HOME: homeDir,
   332→      USERPROFILE: homeDir,
   333→    },
   334→  };
   335→}
   336→
   337→/**
   338→ * Initialize a git repo in a directory (useful for tests that need git)
   339→ *
   340→ * @param dir - Directory to initialize
   341→ */
   342→export function initGitRepo(dir: string): void {
   343→  execSync('git init -b main', { cwd: dir, stdio: 'pipe' });
   344→  execSync('git config user.email "test@example.com"', { cwd: dir, stdio: 'pipe' });
   345→  execSync('git config user.name "Test User"', { cwd: dir, stdio: 'pipe' });
   346→}
   347→
   348→/**
   349→ * Run a git command in a directory
   350→ *
   351→ * @param cmd - Git command (without 'git' prefix)
   352→ * @param cwd - Working directory
   353→ */
   354→export function git(cmd: string, cwd: string): void {
   355→  execSync(`git ${cmd}`, { cwd, stdio: 'pipe' });
   356→}
   357→
   358→/**
   359→ * Crockford base32 alphabet (excludes I, L, O, U)
   360→ * Used for ULID generation
   361→ */
   362→const CROCKFORD_BASE32 = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';
   363→
   364→/**
   365→ * Generate a valid test ULID with an optional readable prefix
   366→ *
   367→ * ULIDs use Crockford base32 which excludes I, L, O, U.
   368→ * This function replaces any invalid characters in the prefix
   369→ * and pads to create a valid 26-character ULID.
   370→ *
   371→ * @param prefix - Optional prefix (invalid chars will be replaced)
   372→ * @returns A valid 26-character ULID
   373→ *
   374→ * @example
   375→ * // Generate deterministic ULID (use sequence for uniqueness)
   376→ * const id = testUlid(); // '01000000000000000000000000'
   377→ *
   378→ * @example
   379→ * // With prefix (great for debugging)
   380→ * testUlid('TASK')    // '01TASK00000000000000000000'
   381→ * testUlid('TASK', 1) // '01TASK00000001000000000001'
   382→ * testUlid('TRAIT')   // '01TRAJT0000000000000000000' (I replaced with J)
   383→ */
   384→export function testUlid(prefix = '', sequence = 0): string {
   385→  // Replace invalid Crockford chars: I->J, L->K, O->0, U->V
   386→  const safePrefix = prefix.toUpperCase()
   387→    .replace(/I/g, 'J')
   388→    .replace(/L/g, 'K')
   389→    .replace(/O/g, '0')
   390→    .replace(/U/g, 'V');
   391→
   392→  // Start with timestamp-like prefix (01 = valid ULID start)
   393→  const base = '01' + safePrefix;
   394→
   395→  // Pad with zeros, leaving room for sequence and checksum
   396→  const padLength = 24 - base.length; // 26 - 2 for suffix
   397→  const sequenceStr = sequence.toString().padStart(Math.min(padLength, 8), '0');
   398→  const padded = base + sequenceStr.slice(0, padLength);
   399→
   400→  // Fill remaining with zeros and add a final valid char
   401→  const filled = padded.padEnd(25, '0');
   402→
   403→  // Use a deterministic final char based on sequence for uniqueness
   404→  const finalChar = CROCKFORD_BASE32[sequence % 32];
   405→
   406→  return (filled + finalChar).slice(0, 26);
   407→}
   408→
   409→/**
   410→ * Generate multiple unique test ULIDs with the same prefix
   411→ *
   412→ * @param prefix - Prefix for all ULIDs
   413→ * @param count - Number of ULIDs to generate
   414→ * @returns Array of unique valid ULIDs
   415→ *
   416→ * @example
   417→ * const [id1, id2, id3] = testUlids('TASK', 3);
   418→ */
   419→export function testUlids(prefix: string, count: number): string[] {
   420→  return Array.from({ length: count }, (_, i) => testUlid(prefix, i));
   421→}
   422→
```