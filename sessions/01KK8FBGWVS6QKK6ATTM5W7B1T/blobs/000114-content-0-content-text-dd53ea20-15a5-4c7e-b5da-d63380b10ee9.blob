   310→  // ─── ac-no-write ───────────────────────────────────────────────────────────
   311→
   312→  // AC: @session-legacy-migration ac-no-write
   313→  describe("ac-no-write: writes go to .kspec-sessions/ only", () => {
   314→    it("createSession writes to primary, not legacy", async () => {
   315→      await createSession(primaryDir, {
   316→        id: "01NEWSESS01",
   317→        agent_type: "claude-code",
   318→        trigger: "manual",
   319→      });
   320→
   321→      // Verify written to primary
   322→      const primaryExists = await fs
   323→        .access(path.join(primaryDir, "01NEWSESS01", "session.yaml"))
   324→        .then(() => true)
   325→        .catch(() => false);
   326→      expect(primaryExists).toBe(true);
   327→
   328→      // Verify NOT written to legacy
   329→      const legacyExists = await fs
   330→        .access(path.join(legacyDir, "01NEWSESS01", "session.yaml"))
   331→        .then(() => true)
   332→        .catch(() => false);
   333→      expect(legacyExists).toBe(false);
   334→    });
   335→
   336→    it("appendEvent writes to primary, not legacy", async () => {
   337→      await createSession(primaryDir, {
   338→        id: "01NEWSESS02",
   339→        agent_type: "claude-code",
   340→        trigger: "manual",
   341→      });
   342→      await appendEvent(primaryDir, {
   343→        session_id: "01NEWSESS02",
   344→        type: "session.start",
   345→        data: {},
   346→      });
   347→
   348→      // Verify events file in primary
   349→      const eventsPath = path.join(
   350→        primaryDir,
   351→        "01NEWSESS02",
   352→        "events.jsonl",
   353→      );
   354→      const exists = await fs
   355→        .access(eventsPath)
   356→        .then(() => true)
   357→        .catch(() => false);
   358→      expect(exists).toBe(true);
   359→
   360→      // Verify no events in legacy
   361→      const legacyPath = path.join(
   362→        legacyDir,
   363→        "01NEWSESS02",
   364→        "events.jsonl",
   365→      );
   366→      const legacyExists = await fs
   367→        .access(legacyPath)
   368→        .then(() => true)
   369→        .catch(() => false);
   370→      expect(legacyExists).toBe(false);
   371→    });
   372→  });
