   501→  // ─── ac-migration-copy ─────────────────────────────────────────────────────
   502→
   503→  // AC: @session-legacy-migration ac-migration-copy
   504→  describe("ac-migration-copy: migrateLegacySessions", () => {
   505→    it("copies session directories from legacy to primary", async () => {
   506→      await createTestSessionWithEvents(legacyDir, "01LEGACY01", [
   507→        { type: "session.start" },
   508→      ]);
   509→      const result = await migrateLegacySessions(primaryDir, specDir);
   510→      expect(result.migrated).toBe(1);
   511→      expect(result.migratedIds).toContain("01LEGACY01");
   512→
   513→      // Verify files exist in primary
   514→      const metadataExists = await fs
   515→        .access(path.join(primaryDir, "01LEGACY01", "session.yaml"))
   516→        .then(() => true)
   517→        .catch(() => false);
   518→      expect(metadataExists).toBe(true);
   519→
   520→      const eventsExists = await fs
   521→        .access(path.join(primaryDir, "01LEGACY01", "events.jsonl"))
   522→        .then(() => true)
   523→        .catch(() => false);
   524→      expect(eventsExists).toBe(true);
   525→    });
   526→
   527→    it("does not delete originals after copy", async () => {
   528→      await createTestSession(legacyDir, "01LEGACY01");
   529→      await migrateLegacySessions(primaryDir, specDir);
   530→
   531→      // Original should still exist
   532→      const originalExists = await fs
   533→        .access(path.join(legacyDir, "01LEGACY01", "session.yaml"))
   534→        .then(() => true)
   535→        .catch(() => false);
   536→      expect(originalExists).toBe(true);
   537→    });
   538→
   539→    it("migrates multiple sessions", async () => {
   540→      await createTestSession(legacyDir, "01LEGACY01");
   541→      await createTestSession(legacyDir, "01LEGACY02");
   542→      await createTestSession(legacyDir, "01LEGACY03");
   543→      const result = await migrateLegacySessions(primaryDir, specDir);
   544→      expect(result.migrated).toBe(3);
   545→      expect(result.migratedIds).toHaveLength(3);
   546→    });
   547→
   548→    it("returns zero counts when no legacy sessions exist", async () => {
   549→      const result = await migrateLegacySessions(primaryDir, specDir);
   550→      expect(result.migrated).toBe(0);
   551→      expect(result.skipped).toBe(0);
   552→    });
   553→  });
