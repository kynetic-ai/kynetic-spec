   555→  // ─── ac-migration-idempotent ───────────────────────────────────────────────
   556→
   557→  // AC: @session-legacy-migration ac-migration-idempotent
   558→  describe("ac-migration-idempotent: skips existing sessions", () => {
   559→    it("skips sessions that already exist in target", async () => {
   560→      await createTestSession(legacyDir, "01LEGACY01");
   561→      await createTestSession(primaryDir, "01LEGACY01"); // Already exists
   562→      const result = await migrateLegacySessions(primaryDir, specDir);
   563→      expect(result.migrated).toBe(0);
   564→      expect(result.skipped).toBe(1);
   565→      expect(result.skippedIds).toContain("01LEGACY01");
   566→    });
   567→
   568→    it("migrates only sessions not already in target", async () => {
   569→      await createTestSession(legacyDir, "01LEGACY01");
   570→      await createTestSession(legacyDir, "01LEGACY02");
   571→      await createTestSession(primaryDir, "01LEGACY01"); // Already exists
   572→      const result = await migrateLegacySessions(primaryDir, specDir);
   573→      expect(result.migrated).toBe(1);
   574→      expect(result.skipped).toBe(1);
   575→      expect(result.migratedIds).toContain("01LEGACY02");
   576→      expect(result.skippedIds).toContain("01LEGACY01");
   577→    });
   578→
   579→    it("reports correct counts after multiple runs", async () => {
   580→      await createTestSession(legacyDir, "01LEGACY01");
   581→      await createTestSession(legacyDir, "01LEGACY02");
   582→
   583→      // First run: migrates both
   584→      const first = await migrateLegacySessions(primaryDir, specDir);
   585→      expect(first.migrated).toBe(2);
   586→      expect(first.skipped).toBe(0);
   587→
   588→      // Second run: skips both
   589→      const second = await migrateLegacySessions(primaryDir, specDir);
   590→      expect(second.migrated).toBe(0);
   591→      expect(second.skipped).toBe(2);
   592→    });
   593→  });
   594→});
