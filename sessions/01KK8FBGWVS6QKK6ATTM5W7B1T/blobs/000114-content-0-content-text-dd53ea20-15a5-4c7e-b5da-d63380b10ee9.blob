   374→  // ─── ac-list-merge ─────────────────────────────────────────────────────────
   375→
   376→  // AC: @session-legacy-migration ac-list-merge
   377→  describe("ac-list-merge: merged session listing with dedup", () => {
   378→    it("lists sessions from both locations", async () => {
   379→      await createTestSession(primaryDir, "01PRIMARY01");
   380→      await createTestSession(legacyDir, "01LEGACY01");
   381→      const { ids, hasLegacy } = await listSessionsMerged(
   382→        primaryDir,
   383→        specDir,
   384→      );
   385→      expect(ids).toContain("01PRIMARY01");
   386→      expect(ids).toContain("01LEGACY01");
   387→      expect(hasLegacy).toBe(true);
   388→    });
   389→
   390→    it("deduplicates by ID, primary takes precedence", async () => {
   391→      await createTestSession(primaryDir, "01BOTH0001");
   392→      await createTestSession(legacyDir, "01BOTH0001");
   393→      await createTestSession(legacyDir, "01LEGACY01");
   394→      const { ids, hasLegacy } = await listSessionsMerged(
   395→        primaryDir,
   396→        specDir,
   397→      );
   398→      // Should have 01BOTH0001 once + 01LEGACY01
   399→      expect(ids).toHaveLength(2);
   400→      expect(ids).toContain("01BOTH0001");
   401→      expect(ids).toContain("01LEGACY01");
   402→      expect(hasLegacy).toBe(true);
   403→    });
   404→
   405→    it("returns only primary when no legacy exists", async () => {
   406→      await createTestSession(primaryDir, "01PRIMARY01");
   407→      await fs.rm(legacyDir, { recursive: true, force: true });
   408→      const { ids, hasLegacy } = await listSessionsMerged(
   409→        primaryDir,
   410→        specDir,
   411→      );
   412→      expect(ids).toEqual(["01PRIMARY01"]);
   413→      expect(hasLegacy).toBe(false);
   414→    });
   415→
   416→    it("works without specDir (no fallback)", async () => {
   417→      await createTestSession(primaryDir, "01PRIMARY01");
   418→      const { ids, hasLegacy } = await listSessionsMerged(primaryDir);
   419→      expect(ids).toEqual(["01PRIMARY01"]);
   420→      expect(hasLegacy).toBe(false);
   421→    });
   422→  });
   423→
   424→  // AC: @session-legacy-migration ac-list-merge
   425→  describe("ac-list-merge: getAllSessionLogSummariesMerged", () => {
   426→    it("merges summaries from both locations", async () => {
   427→      await createTestSession(primaryDir, "01PRIMARY01");
   428→      await createTestSession(legacyDir, "01LEGACY01");
