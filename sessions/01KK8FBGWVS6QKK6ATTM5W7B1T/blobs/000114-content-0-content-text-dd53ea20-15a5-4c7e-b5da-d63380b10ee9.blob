   450→  // ─── ac-deprecation-warning ────────────────────────────────────────────────
   451→
   452→  // AC: @session-legacy-migration ac-deprecation-warning
   453→  describe("ac-deprecation-warning: warning on legacy reads", () => {
   454→    it("emits deprecation warning to stderr on legacy read", async () => {
   455→      const stderrSpy = vi
   456→        .spyOn(console, "error")
   457→        .mockImplementation(() => {});
   458→      await createTestSession(legacyDir, "01LEGACY01");
   459→      await getSessionWithFallback(primaryDir, "01LEGACY01", specDir);
   460→      expect(stderrSpy).toHaveBeenCalledWith(
   461→        expect.stringContaining("legacy location"),
   462→      );
   463→      expect(stderrSpy).toHaveBeenCalledWith(
   464→        expect.stringContaining("kspec session migrate"),
   465→      );
   466→    });
   467→
   468→    it("emits warning only once per process", async () => {
   469→      const stderrSpy = vi
   470→        .spyOn(console, "error")
   471→        .mockImplementation(() => {});
   472→      await createTestSession(legacyDir, "01LEGACY01");
   473→      await createTestSession(legacyDir, "01LEGACY02");
   474→      await getSessionWithFallback(primaryDir, "01LEGACY01", specDir);
   475→      await getSessionWithFallback(primaryDir, "01LEGACY02", specDir);
   476→      // Should only have been called once
   477→      expect(stderrSpy).toHaveBeenCalledTimes(1);
   478→    });
   479→
   480→    it("does not emit warning for primary reads", async () => {
   481→      const stderrSpy = vi
   482→        .spyOn(console, "error")
   483→        .mockImplementation(() => {});
   484→      await createTestSession(primaryDir, "01PRIMARY01");
   485→      await getSessionWithFallback(primaryDir, "01PRIMARY01", specDir);
   486→      expect(stderrSpy).not.toHaveBeenCalled();
   487→    });
   488→
   489→    it("emits warning on merged list with legacy-only sessions", async () => {
   490→      const stderrSpy = vi
   491→        .spyOn(console, "error")
   492→        .mockImplementation(() => {});
   493→      await createTestSession(legacyDir, "01LEGACY01");
   494→      await listSessionsMerged(primaryDir, specDir);
   495→      expect(stderrSpy).toHaveBeenCalledWith(
   496→        expect.stringContaining("legacy location"),
   497→      );
   498→    });
   499→  });
