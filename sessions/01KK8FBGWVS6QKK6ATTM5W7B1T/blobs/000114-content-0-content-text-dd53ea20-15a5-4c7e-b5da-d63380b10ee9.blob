   437→
   438→    it("deduplicates summaries by ID with primary precedence", async () => {
   439→      await createTestSession(primaryDir, "01BOTH0001", "primary-agent");
   440→      await createTestSession(legacyDir, "01BOTH0001", "legacy-agent");
   441→      const summaries = await getAllSessionLogSummariesMerged(
   442→        primaryDir,
   443→        specDir,
   444→      );
