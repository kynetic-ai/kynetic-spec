     1→/**
     2→ * Tests for legacy session read fallback.
     3→ *
     4→ * AC coverage:
     5→ * - @session-legacy-migration ac-read-fallback: Falls back to .kspec/sessions/ when not found in .kspec-sessions/
     6→ * - @session-legacy-migration ac-no-write: Writes always go to .kspec-sessions/, never .kspec/sessions/
     7→ * - @session-legacy-migration ac-list-merge: List results from both locations, deduplicated by ID
     8→ * - @session-legacy-migration ac-deprecation-warning: Deprecation warning emitted on legacy reads
     9→ * - @session-legacy-migration ac-shadow-gitignore: sessions/ added to .kspec/.gitignore
    10→ * - @session-legacy-migration ac-migration-copy: Copies session dirs from .kspec/sessions/ to .kspec-sessions/
    11→ * - @session-legacy-migration ac-migration-idempotent: Skips sessions that already exist in target
    12→ */
    13→
    14→import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
    15→import * as fs from "node:fs/promises";
    16→import * as path from "node:path";
    17→import * as os from "node:os";
    18→import * as YAML from "yaml";
    19→import {
    20→  getLegacySessionsDir,
    21→  hasLegacySessions,
    22→  getSessionWithFallback,
    23→  readEventsWithFallback,
    24→  listSessionsMerged,
    25→  getAllSessionLogSummariesMerged,
    26→  resolveSessionIdWithFallback,
    27→  searchSessionEventsWithFallback,
    28→  migrateLegacySessions,
    29→  emitLegacyDeprecationWarning,
    30→  resetDeprecationWarning,
    31→} from "../src/sessions/legacy.js";
    32→import {
    33→  createSession,
    34→  appendEvent,
    35→  listSessions,
    36→} from "../src/sessions/store.js";
    37→
    38→// ─── Test Helpers ────────────────────────────────────────────────────────────
    39→
    40→let tempDir: string;
    41→let primaryDir: string; // .kspec-sessions/
    42→let specDir: string; // .kspec/ (shadow branch dir)
    43→let legacyDir: string; // .kspec/sessions/ (legacy location)
    44→
    45→async function createTempDirs(): Promise<void> {
    46→  tempDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-legacy-test-"));
    47→  primaryDir = path.join(tempDir, ".kspec-sessions");
    48→  specDir = path.join(tempDir, ".kspec");
    49→  legacyDir = path.join(specDir, "sessions");
    50→  await fs.mkdir(primaryDir, { recursive: true });
    51→  await fs.mkdir(legacyDir, { recursive: true });
    52→}
    53→
    54→async function cleanupTempDir(): Promise<void> {
    55→  if (tempDir) {
    56→    await fs.rm(tempDir, { recursive: true, force: true });
    57→  }
    58→}
    59→
    60→/**
    61→ * Create a session directory with metadata in the given location.
    62→ */
    63→async function createTestSession(
    64→  dir: string,
    65→  sessionId: string,
    66→  agentType: string = "claude-code",
    67→  status: string = "completed",
    68→): Promise<void> {
    69→  const sessionDir = path.join(dir, sessionId);
    70→  await fs.mkdir(sessionDir, { recursive: true });
    71→  const metadata = {
    72→    id: sessionId,
    73→    agent_type: agentType,
    74→    status,
    75→    started_at: "2026-03-01T00:00:00.000Z",
    76→    ended_at: status !== "active" ? "2026-03-01T01:00:00.000Z" : undefined,
    77→  };
    78→  await fs.writeFile(
    79→    path.join(sessionDir, "session.yaml"),
    80→    YAML.stringify(metadata),
    81→  );
    82→}
    83→
    84→/**
    85→ * Create a session with events in the given location.
    86→ */
    87→async function createTestSessionWithEvents(
    88→  dir: string,
    89→  sessionId: string,
    90→  events: Array<{ type: string; data?: unknown }>,
    91→): Promise<void> {
    92→  await createTestSession(dir, sessionId);
    93→  const eventsPath = path.join(dir, sessionId, "events.jsonl");
    94→  const lines = events.map((e, i) =>
    95→    JSON.stringify({
    96→      seq: i + 1,
    97→      ts: Date.now() + i * 1000,
    98→      type: e.type,
    99→      session_id: sessionId,
   100→      data: e.data ?? {},
   101→    }),
   102→  );
   103→  await fs.writeFile(eventsPath, lines.join("\n") + "\n");
   104→}
   105→
   106→// ─── Tests ───────────────────────────────────────────────────────────────────
   107→
   108→describe("Legacy Session Fallback", () => {
   109→  beforeEach(async () => {
   110→    await createTempDirs();
   111→    resetDeprecationWarning();
   112→  });
   113→
   114→  afterEach(async () => {
   115→    await cleanupTempDir();
   116→    vi.restoreAllMocks();
   117→  });
   118→
   119→  // ─── Path Resolution ───────────────────────────────────────────────────────
   120→
   121→  describe("getLegacySessionsDir", () => {
   122→    it("returns .kspec/sessions/ path from specDir", () => {
   123→      const result = getLegacySessionsDir("/project/.kspec");
   124→      expect(result).toBe("/project/.kspec/sessions");
   125→    });
   126→
   127→    it("returns null when specDir is undefined", () => {
   128→      const result = getLegacySessionsDir(undefined);
   129→      expect(result).toBeNull();
   130→    });
   131→  });
   132→
   133→  describe("hasLegacySessions", () => {
   134→    it("returns true when legacy dir has session directories", async () => {
   135→      await createTestSession(legacyDir, "01LEGACY01");
   136→      expect(await hasLegacySessions(specDir)).toBe(true);
   137→    });
   138→
   139→    it("returns false when legacy dir is empty", async () => {
   140→      expect(await hasLegacySessions(specDir)).toBe(false);
   141→    });
   142→
   143→    it("returns false when legacy dir does not exist", async () => {
   144→      await fs.rm(legacyDir, { recursive: true, force: true });
   145→      expect(await hasLegacySessions(specDir)).toBe(false);
   146→    });
   147→
   148→    it("returns false when specDir is undefined", async () => {
   149→      expect(await hasLegacySessions(undefined)).toBe(false);
   150→    });
   151→  });
   152→
   153→  // ─── ac-read-fallback ──────────────────────────────────────────────────────
   154→
   155→  // AC: @session-legacy-migration ac-read-fallback
   156→  describe("ac-read-fallback: getSessionWithFallback", () => {
   157→    it("returns session from primary when it exists there", async () => {
   158→      await createTestSession(primaryDir, "01PRIMARY01");
   159→      const { session, legacy } = await getSessionWithFallback(
   160→        primaryDir,
   161→        "01PRIMARY01",
   162→        specDir,
   163→      );
   164→      expect(session).not.toBeNull();
   165→      expect(session!.id).toBe("01PRIMARY01");
   166→      expect(legacy).toBe(false);
   167→    });
   168→
   169→    it("falls back to legacy when session not in primary", async () => {
   170→      await createTestSession(legacyDir, "01LEGACY01");
   171→      const { session, legacy } = await getSessionWithFallback(
   172→        primaryDir,
   173→        "01LEGACY01",
   174→        specDir,
   175→      );
   176→      expect(session).not.toBeNull();
   177→      expect(session!.id).toBe("01LEGACY01");
   178→      expect(legacy).toBe(true);
   179→    });
   180→
   181→    it("returns null when session not in either location", async () => {
   182→      const { session, legacy } = await getSessionWithFallback(
   183→        primaryDir,
   184→        "01NONEXIST",
   185→        specDir,
   186→      );
   187→      expect(session).toBeNull();
   188→      expect(legacy).toBe(false);
   189→    });
   190→
   191→    it("prefers primary over legacy for same session ID", async () => {
   192→      await createTestSession(primaryDir, "01BOTH0001", "primary-agent");
   193→      await createTestSession(legacyDir, "01BOTH0001", "legacy-agent");
   194→      const { session, legacy } = await getSessionWithFallback(
   195→        primaryDir,
   196→        "01BOTH0001",
   197→        specDir,
   198→      );
   199→      expect(session!.agent_type).toBe("primary-agent");
   200→      expect(legacy).toBe(false);
   201→    });
   202→
   203→    it("works without specDir (no fallback)", async () => {
   204→      const { session, legacy } = await getSessionWithFallback(
   205→        primaryDir,
   206→        "01NONEXIST",
   207→      );
   208→      expect(session).toBeNull();
   209→      expect(legacy).toBe(false);
   210→    });
   211→  });
   212→
   213→  // AC: @session-legacy-migration ac-read-fallback
   214→  describe("ac-read-fallback: readEventsWithFallback", () => {
   215→    it("reads events from primary when session exists there", async () => {
   216→      await createTestSessionWithEvents(primaryDir, "01PRIMARY01", [
   217→        { type: "session.start" },
   218→        { type: "session.end" },
   219→      ]);
   220→      const { events, legacy } = await readEventsWithFallback(
   221→        primaryDir,
   222→        "01PRIMARY01",
   223→        specDir,
   224→      );
   225→      expect(events).toHaveLength(2);
   226→      expect(legacy).toBe(false);
   227→    });
   228→
   229→    it("falls back to legacy events when session not in primary", async () => {
   230→      await createTestSessionWithEvents(legacyDir, "01LEGACY01", [
   231→        { type: "session.start" },
   232→      ]);
   233→      const { events, legacy } = await readEventsWithFallback(
   234→        primaryDir,
   235→        "01LEGACY01",
   236→        specDir,
   237→      );
   238→      expect(events).toHaveLength(1);
   239→      expect(legacy).toBe(true);
   240→    });
   241→
   242→    it("returns empty events when session not in either location", async () => {
   243→      const { events, legacy } = await readEventsWithFallback(
   244→        primaryDir,
   245→        "01NONEXIST",
   246→        specDir,
   247→      );
   248→      expect(events).toHaveLength(0);
   249→      expect(legacy).toBe(false);
   250→    });
   251→  });
   252→
   253→  // AC: @session-legacy-migration ac-read-fallback
   254→  describe("ac-read-fallback: resolveSessionIdWithFallback", () => {
   255→    it("resolves from primary first", async () => {
   256→      await createTestSession(primaryDir, "01PRIMARY01");
   257→      const result = await resolveSessionIdWithFallback(
   258→        primaryDir,
   259→        "01PRIMARY01",
   260→        specDir,
   261→      );
   262→      expect(result.ok).toBe(true);
   263→      if (result.ok) {
   264→        expect(result.id).toBe("01PRIMARY01");
   265→      }
   266→      expect(result.legacy).toBe(false);
   267→    });
   268→
   269→    it("resolves from legacy when not found in primary", async () => {
   270→      await createTestSession(legacyDir, "01LEGACY01");
   271→      const result = await resolveSessionIdWithFallback(
   272→        primaryDir,
   273→        "01LEGACY01",
   274→        specDir,
   275→      );
   276→      expect(result.ok).toBe(true);
   277→      if (result.ok) {
   278→        expect(result.id).toBe("01LEGACY01");
   279→      }
   280→      expect(result.legacy).toBe(true);
   281→    });
   282→
   283→    it("resolves prefix from legacy when not in primary", async () => {
   284→      await createTestSession(legacyDir, "01LEGACY01");
   285→      const result = await resolveSessionIdWithFallback(
   286→        primaryDir,
   287→        "01LEGACY",
   288→        specDir,
   289→      );
   290→      expect(result.ok).toBe(true);
   291→      if (result.ok) {
   292→        expect(result.id).toBe("01LEGACY01");
   293→      }
   294→      expect(result.legacy).toBe(true);
   295→    });
   296→
   297→    it("returns not_found when not in either location", async () => {
   298→      const result = await resolveSessionIdWithFallback(
   299→        primaryDir,
   300→        "01NONEXIST",
   301→        specDir,
   302→      );
   303→      expect(result.ok).toBe(false);
   304→      if (!result.ok) {
   305→        expect(result.error).toBe("not_found");
   306→      }
   307→    });
   308→  });
