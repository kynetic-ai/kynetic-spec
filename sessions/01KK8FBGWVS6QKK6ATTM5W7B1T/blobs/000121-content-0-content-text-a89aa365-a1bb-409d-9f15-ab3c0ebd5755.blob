   504→  describe("config file safety", () => {
   505→    it("should throw on corrupt .claude/settings.local.json instead of overwriting", async () => {
   506→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   507→      const originalCwd = process.cwd();
   508→      delete process.env.CLAUDE_ENV_FILE;
   509→
   510→      try {
   511→        process.chdir(testDir);
   512→        const settingsDir = path.join(testDir, ".claude");
   513→        await fs.mkdir(settingsDir, { recursive: true });
   514→        await fs.writeFile(
   515→          path.join(settingsDir, "settings.local.json"),
   516→          "this is not valid json {{{",
   517→          "utf-8",
   518→        );
   519→
   520→        const sessionId = testUlid("CRPT", 1);
   521→        await expect(injectClaudeCodeEnv(sessionId)).rejects.toThrow(
   522→          "not valid JSON",
   523→        );
   524→      } finally {
   525→        process.chdir(originalCwd);
   526→        if (originalEnv !== undefined) {
   527→          process.env.CLAUDE_ENV_FILE = originalEnv;
