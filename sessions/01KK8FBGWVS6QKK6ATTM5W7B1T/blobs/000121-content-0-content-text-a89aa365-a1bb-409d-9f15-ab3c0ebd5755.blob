   242→// ─── Environment Injection ───────────────────────────────────────────────────
   243→
   244→describe("Environment Injection", () => {
   245→  let testDir: string;
   246→
   247→  beforeEach(async () => {
   248→    testDir = await createTempDir("kspec-env-inject-");
   249→  });
   250→
   251→  afterEach(async () => {
   252→    await cleanupTempDir(testDir);
   253→  });
   254→
   255→  describe("injectClaudeCodeEnv", () => {
   256→    // AC: @session-creation-and-env-injection ac-inject-claude
   257→    it("should write to CLAUDE_ENV_FILE when set", async () => {
   258→      const envFile = path.join(testDir, "claude-env");
   259→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   260→      process.env.CLAUDE_ENV_FILE = envFile;
   261→
   262→      try {
   263→        const sessionId = testUlid("CLDE", 1);
   264→        const result = await injectClaudeCodeEnv(sessionId);
   265→
   266→        expect(result.injected).toBe(true);
   267→        expect(result.method).toBe("claude_env_file");
   268→        expect(result.path).toBe(envFile);
   269→
   270→        const content = await fs.readFile(envFile, "utf-8");
   271→        expect(content).toContain(`KSPEC_SESSION_ID=${sessionId}`);
   272→      } finally {
   273→        if (originalEnv !== undefined) {
   274→          process.env.CLAUDE_ENV_FILE = originalEnv;
   275→        } else {
   276→          delete process.env.CLAUDE_ENV_FILE;
   277→        }
   278→      }
   279→    });
   280→
   281→    // AC: @session-creation-and-env-injection ac-inject-claude
   282→    it("should replace existing KSPEC_SESSION_ID in CLAUDE_ENV_FILE", async () => {
   283→      const envFile = path.join(testDir, "claude-env");
   284→      await fs.writeFile(
   285→        envFile,
   286→        "OTHER_VAR=foo\nKSPEC_SESSION_ID=old-session\nANOTHER=bar\n",
   287→        "utf-8",
   288→      );
   289→
   290→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   291→      process.env.CLAUDE_ENV_FILE = envFile;
   292→
   293→      try {
   294→        const sessionId = testUlid("CLDE", 2);
   295→        await injectClaudeCodeEnv(sessionId);
   296→
   297→        const content = await fs.readFile(envFile, "utf-8");
   298→        expect(content).toContain(`KSPEC_SESSION_ID=${sessionId}`);
   299→        expect(content).not.toContain("old-session");
   300→        expect(content).toContain("OTHER_VAR=foo");
   301→        expect(content).toContain("ANOTHER=bar");
   302→      } finally {
   303→        if (originalEnv !== undefined) {
   304→          process.env.CLAUDE_ENV_FILE = originalEnv;
   305→        } else {
   306→          delete process.env.CLAUDE_ENV_FILE;
   307→        }
   308→      }
   309→    });
   310→
   311→    it("should capture previous value from CLAUDE_ENV_FILE", async () => {
   312→      const envFile = path.join(testDir, "claude-env-prev");
   313→      await fs.writeFile(envFile, "KSPEC_SESSION_ID=old-value\n", "utf-8");
   314→
   315→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   316→      process.env.CLAUDE_ENV_FILE = envFile;
   317→
   318→      try {
   319→        const sessionId = testUlid("CLDE", 4);
   320→        const result = await injectClaudeCodeEnv(sessionId);
   321→
   322→        expect(result.previousValue).toBe("old-value");
   323→      } finally {
   324→        if (originalEnv !== undefined) {
   325→          process.env.CLAUDE_ENV_FILE = originalEnv;
   326→        } else {
   327→          delete process.env.CLAUDE_ENV_FILE;
   328→        }
   329→      }
   330→    });
   331→
   332→    it("should return null previousValue when no prior value exists", async () => {
   333→      const envFile = path.join(testDir, "claude-env-noprev");
   334→
   335→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   336→      process.env.CLAUDE_ENV_FILE = envFile;
   337→
   338→      try {
   339→        const sessionId = testUlid("CLDE", 5);
   340→        const result = await injectClaudeCodeEnv(sessionId);
   341→
   342→        expect(result.previousValue).toBeNull();
   343→      } finally {
   344→        if (originalEnv !== undefined) {
   345→          process.env.CLAUDE_ENV_FILE = originalEnv;
   346→        } else {
   347→          delete process.env.CLAUDE_ENV_FILE;
   348→        }
   349→      }
   350→    });
   351→
   352→    // AC: @session-creation-and-env-injection ac-inject-claude
   353→    it("should write to .claude/settings.local.json when CLAUDE_ENV_FILE not set", async () => {
   354→      const originalEnv = process.env.CLAUDE_ENV_FILE;
   355→      const originalCwd = process.cwd();
   356→      delete process.env.CLAUDE_ENV_FILE;
   357→
   358→      try {
   359→        process.chdir(testDir);
   360→        const sessionId = testUlid("CLDE", 3);
   361→        const result = await injectClaudeCodeEnv(sessionId);
   362→
   363→        expect(result.injected).toBe(true);
   364→        expect(result.method).toBe("claude_settings");
   365→
   366→        const settingsPath = path.join(testDir, ".claude", "settings.local.json");
   367→        const content = await fs.readFile(settingsPath, "utf-8");
   368→        const settings = JSON.parse(content);
   369→        expect(settings.env.KSPEC_SESSION_ID).toBe(sessionId);
   370→      } finally {
   371→        process.chdir(originalCwd);
   372→        if (originalEnv !== undefined) {
   373→          process.env.CLAUDE_ENV_FILE = originalEnv;
   374→        }
   375→      }
   376→    });
   377→  });
   378→
   379→  describe("injectCodexEnv", () => {
   380→    // AC: @session-creation-and-env-injection ac-inject-codex
   381→    it("should add KSPEC_SESSION_ID to codex config", async () => {
   382→      const configDir = path.join(testDir, ".codex");
   383→      const originalHome = process.env.HOME;
   384→      process.env.HOME = testDir;
   385→
   386→      try {
   387→        const sessionId = testUlid("CDEX", 1);
   388→        const result = await injectCodexEnv(sessionId);
   389→
   390→        expect(result.injected).toBe(true);
   391→        expect(result.method).toBe("codex_config");
   392→
   393→        const configPath = path.join(configDir, "config.toml");
   394→        const content = await fs.readFile(configPath, "utf-8");
   395→        const config = parseTOML(content) as Record<string, unknown>;
   396→        const policy = config.shell_environment_policy as Record<string, Record<string, string>>;
   397→        expect(policy.set.KSPEC_SESSION_ID).toBe(sessionId);
   398→      } finally {
   399→        process.env.HOME = originalHome;
   400→      }
   401→    });
   402→
   403→    // AC: @session-creation-and-env-injection ac-inject-codex
   404→    it("should preserve existing codex config values", async () => {
   405→      const configDir = path.join(testDir, ".codex");
   406→      await fs.mkdir(configDir, { recursive: true });
   407→      await fs.writeFile(
   408→        path.join(configDir, "config.toml"),
   409→        stringifyTOML({
   410→          model: "gpt-5",
   411→          shell_environment_policy: {
   412→            set: { EXISTING_VAR: "keep" },
   413→            inherit: "all",
   414→          },
   415→        }),
   416→        "utf-8",
   417→      );
   418→
   419→      const originalHome = process.env.HOME;
   420→      process.env.HOME = testDir;
   421→
   422→      try {
   423→        const sessionId = testUlid("CDEX", 2);
   424→        await injectCodexEnv(sessionId);
   425→
   426→        const content = await fs.readFile(
   427→          path.join(configDir, "config.toml"),
   428→          "utf-8",
   429→        );
   430→        const config = parseTOML(content) as Record<string, unknown>;
   431→        expect(config.model).toBe("gpt-5");
   432→        const policy = config.shell_environment_policy as Record<string, unknown>;
   433→        expect((policy.set as Record<string, string>).EXISTING_VAR).toBe("keep");
   434→        expect((policy.set as Record<string, string>).KSPEC_SESSION_ID).toBe(
   435→          sessionId,
   436→        );
   437→        expect(policy.inherit).toBe("all");
   438→      } finally {
   439→        process.env.HOME = originalHome;
   440→      }
   441→    });
   442→
   443→    // AC: @session-creation-and-env-injection ac-inject-codex
   444→    it("should preserve complex TOML structures during inject/remove round-trip", async () => {
   445→      const configDir = path.join(testDir, ".codex");
   446→      await fs.mkdir(configDir, { recursive: true });
   447→
   448→      // Pre-seed with a realistic codex config.toml containing various TOML types
   449→      const originalConfig = {
   450→        model: "gpt-5.3-codex",
   451→        approval_policy: "never",
   452→        sandbox_mode: "danger-full-access",
   453→        shell_environment_policy: {
   454→          inherit: "all",
   455→          set: { MY_VAR: "keep-this", ANOTHER_VAR: "also-keep" },
   456→        },
   457→      };
   458→      await fs.writeFile(
   459→        path.join(configDir, "config.toml"),
   460→        stringifyTOML(originalConfig),
   461→        "utf-8",
   462→      );
   463→
   464→      const originalHome = process.env.HOME;
   465→      process.env.HOME = testDir;
   466→
   467→      try {
   468→        const sessionId = testUlid("CDEX", 3);
   469→
   470→        // Inject
   471→        const result = await injectCodexEnv(sessionId);
   472→        expect(result.previousValue).toBeNull();
   473→
   474→        // Verify injection didn't clobber other values
   475→        let content = parseTOML(
   476→          await fs.readFile(path.join(configDir, "config.toml"), "utf-8"),
   477→        ) as Record<string, unknown>;
   478→        expect(content.model).toBe("gpt-5.3-codex");
   479→        expect(content.approval_policy).toBe("never");
   480→        expect(content.sandbox_mode).toBe("danger-full-access");
   481→        const policy = content.shell_environment_policy as Record<string, unknown>;
   482→        expect(policy.inherit).toBe("all");
   483→        expect((policy.set as Record<string, string>).MY_VAR).toBe("keep-this");
   484→        expect((policy.set as Record<string, string>).ANOTHER_VAR).toBe("also-keep");
   485→        expect((policy.set as Record<string, string>).KSPEC_SESSION_ID).toBe(sessionId);
   486→
   487→        // Remove — should delete KSPEC_SESSION_ID but preserve everything else
   488→        await removeCodexEnv();
   489→        content = parseTOML(
   490→          await fs.readFile(path.join(configDir, "config.toml"), "utf-8"),
   491→        ) as Record<string, unknown>;
   492→        expect(content.model).toBe("gpt-5.3-codex");
   493→        expect(content.approval_policy).toBe("never");
   494→        const policyAfter = content.shell_environment_policy as Record<string, unknown>;
   495→        expect(policyAfter.inherit).toBe("all");
   496→        expect((policyAfter.set as Record<string, string>).MY_VAR).toBe("keep-this");
   497→        expect((policyAfter.set as Record<string, string>).KSPEC_SESSION_ID).toBeUndefined();
   498→      } finally {
   499→        process.env.HOME = originalHome;
   500→      }
   501→    });
   502→  });
