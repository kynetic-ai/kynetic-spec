   184→// ─── Session Validation ──────────────────────────────────────────────────────
   185→
   186→describe("validateSessionId", () => {
   187→  let testDir: string;
   188→  let sessionsDir: string;
   189→
   190→  beforeEach(async () => {
   191→    testDir = await createTempDir("kspec-session-validate-");
   192→    sessionsDir = path.join(testDir, "sessions");
   193→    await fs.mkdir(sessionsDir, { recursive: true });
   194→  });
   195→
   196→  afterEach(async () => {
   197→    await cleanupTempDir(testDir);
   198→  });
   199→
   200→  // AC: @session-creation-and-env-injection ac-invalid-session
   201→  it("should return valid for existing session with correct metadata", async () => {
   202→    const sessionId = testUlid("VALID", 1);
   203→    await createSession(sessionsDir, {
   204→      id: sessionId,
   205→      agent_type: "claude-code",
   206→    });
   207→
   208→    const result = await validateSessionId(sessionsDir, sessionId);
   209→    expect(result.valid).toBe(true);
   210→    expect(result.session).toBeDefined();
   211→    expect(result.session!.id).toBe(sessionId);
   212→  });
   213→
   214→  // AC: @session-creation-and-env-injection ac-invalid-session
   215→  it("should return error for nonexistent session with clear message", async () => {
   216→    const result = await validateSessionId(sessionsDir, "NONEXISTENT_SESSION");
   217→    expect(result.valid).toBe(false);
   218→    expect(result.error).toContain("Session not found");
   219→    expect(result.error).toContain("NONEXISTENT_SESSION");
   220→    expect(result.suggestion).toContain("kspec session create");
   221→  });
   222→
   223→  // AC: @session-creation-and-env-injection ac-invalid-session
   224→  it("should return error for corrupt session metadata", async () => {
   225→    const sessionId = testUlid("CRPT", 1);
   226→    const sessionDir = path.join(testDir, "sessions", sessionId);
   227→    await fs.mkdir(sessionDir, { recursive: true });
   228→    // Write invalid YAML
   229→    await fs.writeFile(
   230→      path.join(sessionDir, "session.yaml"),
   231→      "this is not valid yaml: [[[",
   232→      "utf-8",
   233→    );
   234→
   235→    const result = await validateSessionId(sessionsDir, sessionId);
   236→    expect(result.valid).toBe(false);
   237→    expect(result.error).toContain("corrupt");
   238→    expect(result.suggestion).toContain("kspec session create");
   239→  });
   240→});
