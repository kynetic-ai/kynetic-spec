    45→// ─── Library Function: createSessionWithBudget ──────────────────────────────
    46→
    47→describe("createSessionWithBudget", () => {
    48→  let testDir: string;
    49→  let sessionsDir: string;
    50→
    51→  beforeEach(async () => {
    52→    testDir = await createTempDir("kspec-session-create-");
    53→    sessionsDir = path.join(testDir, "sessions");
    54→    // Create sessions directory
    55→    await fs.mkdir(sessionsDir, { recursive: true });
    56→  });
    57→
    58→  afterEach(async () => {
    59→    await cleanupTempDir(testDir);
    60→  });
    61→
    62→  // AC: @session-creation-and-env-injection ac-create
    63→  it("should create a session with status active and return metadata", async () => {
    64→    const sessionId = testUlid("SESS", 1);
    65→    const result = await createSessionWithBudget(sessionsDir, {
    66→      id: sessionId,
    67→      agent_type: "claude-code",
    68→    });
    69→
    70→    expect(result.session_id).toBe(sessionId);
    71→    expect(result.session.id).toBe(sessionId);
    72→    expect(result.session.status).toBe("active");
    73→    expect(result.session.agent_type).toBe("claude-code");
    74→    expect(result.session.started_at).toBeTruthy();
    75→    expect(result.budget).toBeNull();
    76→  });
    77→
    78→  // AC: @session-creation-and-env-injection ac-create
    79→  it("should create session directory with session.yaml", async () => {
    80→    const sessionId = testUlid("SESS", 2);
    81→    await createSessionWithBudget(sessionsDir, {
    82→      id: sessionId,
    83→      agent_type: "codex-cli",
    84→    });
    85→
    86→    const sessionDir = path.join(testDir, "sessions", sessionId);
    87→    const stat = await fs.stat(sessionDir);
    88→    expect(stat.isDirectory()).toBe(true);
    89→
    90→    const metadataPath = path.join(sessionDir, "session.yaml");
    91→    const content = await fs.readFile(metadataPath, "utf-8");
    92→    expect(content).toContain("status: active");
    93→    expect(content).toContain("agent_type: codex-cli");
    94→  });
    95→
    96→  // AC: @session-creation-and-env-injection ac-budget
    97→  it("should create budget.json when budget option provided", async () => {
    98→    const sessionId = testUlid("SESS", 3);
    99→    const result = await createSessionWithBudget(sessionsDir, {
   100→      id: sessionId,
   101→      agent_type: "claude-code",
   102→      budget: 5,
   103→    });
   104→
   105→    expect(result.budget).not.toBeNull();
   106→    expect(result.budget!.max_per_cycle).toBe(5);
   107→    expect(result.budget!.started_this_cycle).toBe(0);
   108→  });
   109→
   110→  // AC: @session-creation-and-env-injection ac-budget-local
   111→  it("should store budget.json on local filesystem in session directory", async () => {
   112→    const sessionId = testUlid("SESS", 4);
   113→    await createSessionWithBudget(sessionsDir, {
   114→      id: sessionId,
   115→      agent_type: "claude-code",
   116→      budget: 3,
   117→    });
   118→
   119→    const budgetPath = getSessionBudgetPath(sessionsDir, sessionId);
   120→    const content = await fs.readFile(budgetPath, "utf-8");
   121→    const budget = JSON.parse(content);
   122→    expect(budget.max_per_cycle).toBe(3);
   123→    expect(budget.started_this_cycle).toBe(0);
   124→    // Verify it's in the expected location
   125→    expect(budgetPath).toContain(path.join("sessions", sessionId, "budget.json"));
   126→  });
   127→
   128→  // AC: @session-creation-and-env-injection ac-library
   129→  it("should return metadata without console output", async () => {
   130→    const sessionId = testUlid("SESS", 5);
   131→    // Capture console output
   132→    const consoleLogs: string[] = [];
   133→    const originalLog = console.log;
   134→    console.log = (...args: unknown[]) => consoleLogs.push(args.join(" "));
   135→
   136→    try {
   137→      const result = await createSessionWithBudget(sessionsDir, {
   138→        id: sessionId,
   139→        agent_type: "claude-code",
   140→        budget: 2,
   141→      });
   142→
   143→      // Library function should not produce console output
   144→      expect(consoleLogs).toHaveLength(0);
   145→
   146→      // Should return complete metadata
   147→      expect(result.session_id).toBe(sessionId);
   148→      expect(result.session.id).toBe(sessionId);
   149→      expect(result.session.status).toBe("active");
   150→      expect(result.budget).not.toBeNull();
   151→      expect(result.budget!.max_per_cycle).toBe(2);
   152→    } finally {
   153→      console.log = originalLog;
   154→    }
   155→  });
   156→
   157→  it("should include task_id when provided", async () => {
   158→    const sessionId = testUlid("SESS", 6);
   159→    const taskId = testUlid("TASK", 1);
   160→    const result = await createSessionWithBudget(sessionsDir, {
   161→      id: sessionId,
   162→      agent_type: "claude-code",
   163→      task_id: taskId,
   164→    });
   165→
   166→    expect(result.session.task_id).toBe(taskId);
   167→  });
   168→
   169→  it("should not create budget when budget is undefined", async () => {
   170→    const sessionId = testUlid("SESS", 7);
   171→    const result = await createSessionWithBudget(sessionsDir, {
   172→      id: sessionId,
   173→      agent_type: "claude-code",
   174→    });
   175→
   176→    expect(result.budget).toBeNull();
   177→
   178→    // Verify no budget file exists
   179→    const budgetPath = getSessionBudgetPath(sessionsDir, sessionId);
   180→    await expect(fs.access(budgetPath)).rejects.toThrow();
   181→  });
   182→});
