  1048→        expect(result).not.toBeNull();
  1049→        expect(result!.previousValue).toBe("old-session");
  1050→
  1051→        // Remove via adapter using the captured previousValue — should restore
  1052→        await removeEnvForAdapter("codex-acp", result!.previousValue);
  1053→
  1054→        const configPath = path.join(codexDir, "config.toml");
  1055→        const content = parseTOML(await fs.readFile(configPath, "utf-8")) as Record<string, unknown>;
  1056→        const policy = content.shell_environment_policy as Record<string, Record<string, string>>;
