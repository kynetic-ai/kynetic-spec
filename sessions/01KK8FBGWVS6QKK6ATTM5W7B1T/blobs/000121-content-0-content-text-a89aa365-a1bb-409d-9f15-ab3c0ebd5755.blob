  1070→// ─── CLI Command: session create ─────────────────────────────────────────────
  1071→
  1072→describe("session create CLI", () => {
  1073→  let testDir: string;
  1074→
  1075→  beforeEach(async () => {
  1076→    testDir = await setupTempFixtures();
  1077→  });
  1078→
  1079→  afterEach(async () => {
  1080→    await cleanupTempDir(testDir);
  1081→  });
  1082→
  1083→  // AC: @session-creation-and-env-injection ac-create
  1084→  // AC: @trait-semantic-exit-codes ac-1
  1085→  it("should create a session and print ID to stdout", () => {
  1086→    const result = kspec("session create --agent-type test-agent", testDir);
  1087→    expect(result.exitCode).toBe(0);
  1088→    expect(result.stdout).toContain("Created session:");
  1089→  });
  1090→
  1091→  // AC: @session-creation-and-env-injection ac-budget
  1092→  it("should create budget when --budget flag provided", () => {
  1093→    const result = kspec(
  1094→      "session create --agent-type test-agent --budget 5",
  1095→      testDir,
  1096→    );
  1097→    expect(result.exitCode).toBe(0);
  1098→    // info() routes to stdout in text mode
  1099→    const allOutput = result.stdout + "\n" + result.stderr;
  1100→    expect(allOutput).toContain("Budget: 5 tasks per cycle");
  1101→  });
  1102→
  1103→  // AC: @trait-json-output ac-1 - output is valid JSON with no ANSI
  1104→  it("should output valid JSON when --json flag provided", () => {
  1105→    const result = kspecJson<Record<string, unknown>>(
  1106→      "session create --agent-type test-agent --budget 3",
  1107→      testDir,
  1108→    );
