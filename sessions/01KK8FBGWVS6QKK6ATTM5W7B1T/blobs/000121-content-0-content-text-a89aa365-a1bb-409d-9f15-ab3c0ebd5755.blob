   555→  describe("injectGeminiEnv", () => {
   556→    // Spec: @session-creation-and-env-injection (harness-specific injection for Gemini CLI)
   557→    it("should write KSPEC_SESSION_ID to .gemini/.env", async () => {
   558→      const originalCwd = process.cwd();
   559→
   560→      try {
