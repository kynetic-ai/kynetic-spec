     1→/**
     2→ * Legacy session read fallback.
     3→ *
     4→ * Provides fallback reads from .kspec/sessions/ (shadow branch) for sessions
     5→ * that haven't been migrated to .kspec-sessions/ yet. All writes go to
     6→ * .kspec-sessions/ only — the legacy location is read-only.
     7→ *
     8→ * AC: @session-legacy-migration ac-read-fallback ac-no-write ac-list-merge ac-deprecation-warning
     9→ */
    10→
    11→import * as path from "node:path";
    12→import * as fsPromises from "node:fs/promises";
    13→import type { SessionMetadata, SessionEvent } from "./types.js";
    14→import {
    15→  type SessionLogSummary,
    16→  type SessionSearchResult,
    17→  type SessionIdResolution,
    18→  type ToolUsageStats,
    19→  getSession,
    20→  readEvents,
    21→  listSessions,
    22→  getAllSessionLogSummaries,
    23→  resolveSessionId,
    24→  searchSessionEvents,
    25→  computeToolUsageStats,
    26→  type SearchOptions,
    27→} from "./store.js";
    28→
    29→// ─── Legacy Path Resolution ─────────────────────────────────────────────────
    30→
    31→/**
    32→ * Get the legacy sessions directory path (.kspec/sessions/).
    33→ *
    34→ * @param specDir - The .kspec/ directory (shadow branch worktree)
    35→ * @returns Path to legacy sessions directory, or null if specDir is not available
    36→ */
    37→export function getLegacySessionsDir(
    38→  specDir: string | undefined,
    39→): string | null {
    40→  if (!specDir) return null;
    41→  return path.join(specDir, "sessions");
    42→}
    43→
    44→/**
    45→ * Check if a legacy sessions directory exists and has session subdirectories.
    46→ */
    47→export async function hasLegacySessions(
    48→  specDir: string | undefined,
    49→): Promise<boolean> {
    50→  const legacyDir = getLegacySessionsDir(specDir);
    51→  if (!legacyDir) return false;
    52→
    53→  try {
    54→    const entries = await fsPromises.readdir(legacyDir, {
    55→      withFileTypes: true,
    56→    });
    57→    return entries.some((e) => e.isDirectory());
    58→  } catch {
    59→    return false;
    60→  }
    61→}
    62→
    63→// ─── Deprecation Warning ────────────────────────────────────────────────────
    64→
    65→const DEPRECATION_WARNING =
    66→  "Warning: Reading session from legacy location .kspec/sessions/. " +
    67→  "Run `kspec session migrate` to move sessions to .kspec-sessions/.";
    68→
    69→let deprecationWarningEmitted = false;
    70→
    71→/**
    72→ * Emit a deprecation warning to stderr for legacy session reads.
    73→ * AC: @session-legacy-migration ac-deprecation-warning
    74→ *
    75→ * Emits once per process to avoid spam. Writes to stderr, not stdout,
    76→ * so it doesn't interfere with structured output.
    77→ */
    78→export function emitLegacyDeprecationWarning(): void {
    79→  if (!deprecationWarningEmitted) {
    80→    console.error(DEPRECATION_WARNING);
    81→    deprecationWarningEmitted = true;
    82→  }
    83→}
    84→
    85→/**
    86→ * Reset the deprecation warning state (for testing).
    87→ */
    88→export function resetDeprecationWarning(): void {
    89→  deprecationWarningEmitted = false;
    90→}
    91→
    92→// ─── Fallback Read Operations ───────────────────────────────────────────────
    93→// AC: @session-legacy-migration ac-read-fallback
    94→// Each function tries the primary sessionsDir first, then falls back to
    95→// the legacy .kspec/sessions/ location if the session is not found.
    96→
    97→/**
    98→ * Get session metadata with legacy fallback.
    99→ *
   100→ * Tries .kspec-sessions/ first, then .kspec/sessions/ if not found.
   101→ * Emits deprecation warning when reading from legacy location.
   102→ *
   103→ * @returns Session metadata and whether it came from legacy location
   104→ */
   105→export async function getSessionWithFallback(
   106→  sessionsDir: string,
   107→  sessionId: string,
   108→  specDir?: string,
   109→): Promise<{ session: SessionMetadata | null; legacy: boolean }> {
   110→  // Try primary location first
   111→  const session = await getSession(sessionsDir, sessionId);
   112→  if (session) {
   113→    return { session, legacy: false };
   114→  }
   115→
   116→  // Try legacy location
   117→  const legacyDir = getLegacySessionsDir(specDir);
   118→  if (legacyDir) {
   119→    const legacySession = await getSession(legacyDir, sessionId);
   120→    if (legacySession) {
   121→      emitLegacyDeprecationWarning();
   122→      return { session: legacySession, legacy: true };
   123→    }
   124→  }
   125→
   126→  return { session: null, legacy: false };
   127→}
   128→
   129→/**
   130→ * Read session events with legacy fallback.
   131→ *
   132→ * Tries .kspec-sessions/ first, then .kspec/sessions/ if session not found there.
   133→ */
   134→export async function readEventsWithFallback(
   135→  sessionsDir: string,
   136→  sessionId: string,
   137→  specDir?: string,
   138→): Promise<{ events: SessionEvent[]; legacy: boolean }> {
   139→  // Check if session exists in primary location
   140→  const session = await getSession(sessionsDir, sessionId);
   141→  if (session) {
   142→    const events = await readEvents(sessionsDir, sessionId);
   143→    return { events, legacy: false };
   144→  }
   145→
   146→  // Try legacy location
   147→  const legacyDir = getLegacySessionsDir(specDir);
   148→  if (legacyDir) {
   149→    const legacySession = await getSession(legacyDir, sessionId);
   150→    if (legacySession) {
   151→      emitLegacyDeprecationWarning();
   152→      const events = await readEvents(legacyDir, sessionId);
   153→      return { events, legacy: true };
   154→    }
   155→  }
   156→
   157→  return { events: [], legacy: false };
   158→}
   159→
   160→/**
   161→ * List sessions from both primary and legacy locations, deduplicated.
   162→ *
   163→ * AC: @session-legacy-migration ac-list-merge
   164→ * Results include sessions from both locations, deduplicated by ID,
   165→ * with .kspec-sessions/ taking precedence for duplicates.
   166→ */
   167→export async function listSessionsMerged(
   168→  sessionsDir: string,
   169→  specDir?: string,
   170→): Promise<{ ids: string[]; hasLegacy: boolean }> {
   171→  const primaryIds = await listSessions(sessionsDir);
   172→  const primarySet = new Set(primaryIds);
   173→
   174→  const legacyDir = getLegacySessionsDir(specDir);
   175→  if (!legacyDir) {
   176→    return { ids: primaryIds, hasLegacy: false };
   177→  }
   178→
   179→  const legacyIds = await listSessions(legacyDir);
   180→  if (legacyIds.length === 0) {
   181→    return { ids: primaryIds, hasLegacy: false };
   182→  }
   183→
   184→  // Add legacy IDs that aren't already in primary (dedup)
   185→  let hasLegacy = false;
   186→  const merged = [...primaryIds];
   187→  for (const id of legacyIds) {
   188→    if (!primarySet.has(id)) {
   189→      merged.push(id);
   190→      hasLegacy = true;
   191→    }
   192→  }
   193→
   194→  if (hasLegacy) {
   195→    emitLegacyDeprecationWarning();
   196→  }
   197→
   198→  return { ids: merged, hasLegacy };
   199→}
   200→
   201→/**
   202→ * Get all session log summaries with legacy merge.
   203→ *
   204→ * AC: @session-legacy-migration ac-list-merge
   205→ * Merges summaries from both locations, deduplicating by session ID,
   206→ * with .kspec-sessions/ taking precedence.
   207→ */
   208→export async function getAllSessionLogSummariesMerged(
   209→  sessionsDir: string,
   210→  specDir?: string,
   211→): Promise<SessionLogSummary[]> {
   212→  const primarySummaries = await getAllSessionLogSummaries(sessionsDir);
   213→
   214→  const legacyDir = getLegacySessionsDir(specDir);
   215→  if (!legacyDir) {
   216→    return primarySummaries;
   217→  }
   218→
   219→  const legacySummaries = await getAllSessionLogSummaries(legacyDir);
   220→  if (legacySummaries.length === 0) {
   221→    return primarySummaries;
   222→  }
   223→
   224→  // Dedup: primary takes precedence
   225→  const primaryIds = new Set(primarySummaries.map((s) => s.id));
   226→  const legacyOnly = legacySummaries.filter((s) => !primaryIds.has(s.id));
   227→
   228→  if (legacyOnly.length > 0) {
   229→    emitLegacyDeprecationWarning();
   230→    return [...primarySummaries, ...legacyOnly];
   231→  }
   232→
   233→  return primarySummaries;
   234→}
   235→
   236→/**
   237→ * Resolve a session ID with legacy fallback.
   238→ *
   239→ * Tries primary location first. If not found, tries legacy location.
   240→ * If ambiguous in primary, does not check legacy.
   241→ */
   242→export async function resolveSessionIdWithFallback(
   243→  sessionsDir: string,
   244→  idOrPrefix: string,
   245→  specDir?: string,
   246→): Promise<SessionIdResolution & { legacy?: boolean }> {
   247→  const primaryResult = await resolveSessionId(sessionsDir, idOrPrefix);
   248→  if (primaryResult.ok || primaryResult.error === "ambiguous") {
   249→    return { ...primaryResult, legacy: false };
   250→  }
   251→
   252→  // Not found in primary — try legacy
   253→  const legacyDir = getLegacySessionsDir(specDir);
   254→  if (legacyDir) {
   255→    const legacyResult = await resolveSessionId(legacyDir, idOrPrefix);
   256→    if (legacyResult.ok) {
   257→      emitLegacyDeprecationWarning();
   258→      return { ...legacyResult, legacy: true };
   259→    }
   260→  }
   261→
   262→  return { ...primaryResult, legacy: false };
   263→}
   264→
   265→/**
   266→ * Search session events across both primary and legacy locations.
   267→ *
   268→ * AC: @session-legacy-migration ac-list-merge (for search across all sessions)
   269→ */
   270→export async function searchSessionEventsWithFallback(
   271→  sessionsDir: string,
   272→  pattern: string,
   273→  options: SearchOptions = {},
   274→  specDir?: string,
   275→): Promise<SessionSearchResult[]> {
   276→  const primaryResults = await searchSessionEvents(
   277→    sessionsDir,
   278→    pattern,
   279→    options,
   280→  );
   281→
   282→  const legacyDir = getLegacySessionsDir(specDir);
   283→  if (!legacyDir) {
   284→    return primaryResults;
   285→  }
   286→
   287→  // Get remaining limit after primary results
   288→  const limit = options.limit ?? 50;
   289→  const remaining = limit - primaryResults.length;
   290→  if (remaining <= 0) {
   291→    return primaryResults;
   292→  }
   293→
   294→  const legacyResults = await searchSessionEvents(legacyDir, pattern, {
   295→    ...options,
   296→    limit: remaining,
   297→  });
   298→
   299→  if (legacyResults.length === 0) {
   300→    return primaryResults;
   301→  }
   302→
   303→  // Dedup by session ID — primary takes precedence
   304→  const primarySessionIds = new Set(primaryResults.map((r) => r.session_id));
   305→  const legacyOnly = legacyResults.filter(
   306→    (r) => !primarySessionIds.has(r.session_id),
   307→  );
   308→
   309→  if (legacyOnly.length > 0) {
   310→    emitLegacyDeprecationWarning();
   311→    return [...primaryResults, ...legacyOnly];
   312→  }
   313→
   314→  return primaryResults;
   315→}
   316→
   317→/**
   318→ * Compute tool usage stats across both primary and legacy sessions.
   319→ *
   320→ * Runs computeToolUsageStats against primary dir, then against legacy dir
   321→ * for session IDs not found in primary. Merges results.
   322→ */
   323→export async function computeToolUsageStatsWithFallback(
   324→  sessionsDir: string,
   325→  sessionIds: string[],
   326→  specDir?: string,
   327→  limit?: number,
   328→): Promise<ToolUsageStats[]> {
   329→  const legacyDir = getLegacySessionsDir(specDir);
   330→  if (!legacyDir) {
   331→    return computeToolUsageStats(sessionsDir, sessionIds, limit);
   332→  }
   333→
   334→  // Partition session IDs: which exist in primary vs which need legacy
   335→  const primaryIds: string[] = [];
   336→  const legacyIds: string[] = [];
   337→  const primarySet = new Set(await listSessions(sessionsDir));
   338→
   339→  for (const id of sessionIds) {
   340→    if (primarySet.has(id)) {
   341→      primaryIds.push(id);
   342→    } else {
   343→      legacyIds.push(id);
   344→    }
   345→  }
   346→
   347→  if (legacyIds.length === 0) {
   348→    return computeToolUsageStats(sessionsDir, sessionIds, limit);
   349→  }
   350→
   351→  // Get stats from both locations and merge
   352→  const [primaryStats, legacyStats] = await Promise.all([
   353→    computeToolUsageStats(sessionsDir, primaryIds, 0), // no limit, merge later
   354→    computeToolUsageStats(legacyDir, legacyIds, 0),
   355→  ]);
   356→
   357→  // Merge by tool name
   358→  const merged = new Map<string, number>();
   359→  let total = 0;
   360→  for (const s of [...primaryStats, ...legacyStats]) {
   361→    const prev = merged.get(s.tool_name) ?? 0;
   362→    merged.set(s.tool_name, prev + s.count);
   363→    total += s.count;
   364→  }
   365→
   366→  const effectiveLimit = limit ?? 10;
   367→  return Array.from(merged.entries())
   368→    .map(([tool_name, count]) => ({
   369→      tool_name,
   370→      count,
   371→      percentage: total > 0 ? Math.round((count / total) * 100 * 10) / 10 : 0,
   372→    }))
   373→    .sort((a, b) => b.count - a.count)
   374→    .slice(0, effectiveLimit);
   375→}
   376→
   377→// ─── Migration ──────────────────────────────────────────────────────────────
   378→
   379→/**
   380→ * Result of a session migration operation.
   381→ * AC: @session-legacy-migration ac-migration-copy ac-migration-idempotent
   382→ */
   383→export interface MigrationResult {
   384→  /** Number of sessions copied */
   385→  migrated: number;
   386→  /** Number of sessions skipped (already exist in target) */
   387→  skipped: number;
   388→  /** Session IDs that were migrated */
   389→  migratedIds: string[];
   390→  /** Session IDs that were skipped */
   391→  skippedIds: string[];
   392→}
   393→
   394→/**
   395→ * Copy session directories from legacy to primary location.
   396→ *
   397→ * AC: @session-legacy-migration ac-migration-copy
   398→ * Copies session directories from .kspec/sessions/ to .kspec-sessions/.
   399→ * Does not delete originals.
   400→ *
   401→ * AC: @session-legacy-migration ac-migration-idempotent
   402→ * Skips sessions that already exist in target.
   403→ */
   404→export async function migrateLegacySessions(
   405→  sessionsDir: string,
   406→  specDir: string,
   407→): Promise<MigrationResult> {
   408→  const legacyDir = getLegacySessionsDir(specDir);
   409→  if (!legacyDir) {
   410→    return { migrated: 0, skipped: 0, migratedIds: [], skippedIds: [] };
   411→  }
   412→
   413→  const legacyIds = await listSessions(legacyDir);
   414→  if (legacyIds.length === 0) {
   415→    return { migrated: 0, skipped: 0, migratedIds: [], skippedIds: [] };
   416→  }
   417→
   418→  const primaryIds = new Set(await listSessions(sessionsDir));
   419→  const result: MigrationResult = {
   420→    migrated: 0,
   421→    skipped: 0,
   422→    migratedIds: [],
   423→    skippedIds: [],
   424→  };
   425→
   426→  for (const id of legacyIds) {
   427→    if (primaryIds.has(id)) {
   428→      // AC: ac-migration-idempotent — skip existing
   429→      result.skipped++;
   430→      result.skippedIds.push(id);
   431→      continue;
   432→    }
   433→
   434→    // Copy entire session directory recursively
   435→    const srcDir = path.join(legacyDir, id);
   436→    const destDir = path.join(sessionsDir, id);
   437→    await fsPromises.cp(srcDir, destDir, { recursive: true });
   438→    result.migrated++;
   439→    result.migratedIds.push(id);
   440→  }
   441→
   442→  return result;
   443→}
   444→
```