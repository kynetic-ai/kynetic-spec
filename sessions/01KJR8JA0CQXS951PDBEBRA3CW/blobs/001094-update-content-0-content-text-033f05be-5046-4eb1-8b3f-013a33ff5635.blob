```
     1→/**
     2→ * Kspec Daemon Server
     3→ *
     4→ * Elysia.js HTTP server with WebSocket support for real-time kspec state updates.
     5→ * Implements localhost-only security, file watching, and graceful shutdown.
     6→ */
     7→
     8→import { Elysia } from 'elysia';
     9→import { cors } from '@elysiajs/cors';
    10→import { staticPlugin } from '@elysiajs/static';
    11→import { ulid } from 'ulidx';
    12→import { existsSync } from 'fs';
    13→import { PubSubManager } from './websocket/pubsub';
    14→import { HeartbeatManager } from './websocket/heartbeat';
    15→import { WebSocketHandler } from './websocket/handler';
    16→import type { ConnectionData, ConnectedEvent } from './websocket/types';
    17→import { PidFileManager } from './pid';
    18→import { projectContextMiddleware } from './middleware/project-context';
    19→import { createTasksRoutes } from './routes/tasks';
    20→import { createItemsRoutes } from './routes/items';
    21→import { createInboxRoutes } from './routes/inbox';
    22→import { createMetaRoutes } from './routes/meta';
    23→import { createValidationRoutes } from './routes/validation';
    24→import { createProjectsRoutes } from './routes/projects';
    25→import { createTriageRoutes } from './routes/triage';
    26→import { createAgentDispatchRoutes, getDispatchEngine, stopAllEngines } from './routes/agent-dispatch';
    27→import { join } from 'path';
    28→
    29→export interface ServerOptions {
    30→  port: number;
    31→  isDaemon: boolean;
    32→  kspecDir?: string; // Path to .kspec directory (default: .kspec in cwd)
    33→  webUiDir?: string; // Path to web UI build directory (default: auto-detect)
    34→}
    35→
    36→/**
    37→ * Resolves the path to the web UI build directory.
    38→ * Tries multiple locations in order:
    39→ * 1. Explicit webUiDir option
    40→ * 2. WEB_UI_DIR environment variable
    41→ * 3. packages/web-ui/build in current working directory (monorepo dev)
    42→ * 4. web-ui/build in current working directory
    43→ */
    44→function resolveWebUiPath(webUiDir?: string): string | null {
    45→  // 1. Explicit option
    46→  if (webUiDir && existsSync(webUiDir)) {
    47→    return webUiDir;
    48→  }
    49→
    50→  // 2. Environment variable
    51→  const envPath = process.env.WEB_UI_DIR;
    52→  if (envPath && existsSync(envPath)) {
    53→    return envPath;
    54→  }
    55→
    56→  // 3. Monorepo development: packages/web-ui/build from cwd
    57→  // The daemon is spawned with cwd set to project root
    58→  const monorepoPath = join(process.cwd(), 'packages', 'web-ui', 'build');
    59→  if (existsSync(monorepoPath)) {
    60→    return monorepoPath;
    61→  }
    62→
    63→  // 4. Alternate location: web-ui/build in cwd
    64→  const altPath = join(process.cwd(), 'web-ui', 'build');
    65→  if (existsSync(altPath)) {
    66→    return altPath;
    67→  }
    68→
    69→  return null;
    70→}
    71→
    72→// WebSocket pub/sub and heartbeat managers
    73→let pubsubManager: PubSubManager;
    74→let heartbeatManager: HeartbeatManager;
    75→let wsHandler: WebSocketHandler;
    76→let projectManager: import('./project-context').ProjectContextManager | undefined;
    77→
    78→/**
    79→ * Middleware to enforce localhost-only connections.
    80→ * AC-3: Reject non-localhost connections with 403 Forbidden
    81→ */
    82→function localhostOnly() {
    83→  return (context: { request: Request }) => {
    84→    const host = context.request.headers.get('host');
    85→    if (!host) {
    86→      return new Response(JSON.stringify({
    87→        error: 'Forbidden',
    88→        message: 'This server only accepts connections from localhost'
    89→      }), {
    90→        status: 403,
    91→        headers: { 'Content-Type': 'application/json' }
    92→      });
    93→    }
    94→
    95→    // Extract hostname, handling IPv6 brackets
    96→    let hostname: string;
    97→    if (host.startsWith('[')) {
    98→      // IPv6 with brackets: [::1]:3456 -> ::1
    99→      const closeBracket = host.indexOf(']');
   100→      hostname = closeBracket > 0 ? host.substring(1, closeBracket) : host;
   101→    } else {
   102→      // IPv4 or hostname: localhost:3456 -> localhost
   103→      hostname = host.split(':')[0];
   104→    }
   105→
   106→    // Allow localhost, 127.0.0.1, and ::1
   107→    const isLocalhost =
   108→      hostname === 'localhost' ||
   109→      hostname === '127.0.0.1' ||
   110→      hostname === '::1';
   111→
   112→    if (!isLocalhost) {
   113→      return new Response(JSON.stringify({
   114→        error: 'Forbidden',
   115→        message: 'This server only accepts connections from localhost'
   116→      }), {
   117→        status: 403,
   118→        headers: { 'Content-Type': 'application/json' }
   119→      });
   120→    }
   121→  };
   122→}
   123→
   124→/**
   125→ * Creates and configures the Elysia server instance.
   126→ *
   127→ * AC Coverage:
   128→ * - ac-1: Server starts on configurable port (default 3456)
   129→ * - ac-2: Binds to localhost only (127.0.0.1 and ::1)
   130→ * - ac-3: Rejects non-localhost connections with 403
   131→ * - ac-15: Uses plugin pattern for middleware
   132→ */
   133→export async function createServer(options: ServerOptions) {
   134→  const { port, isDaemon, kspecDir = join(process.cwd(), '.kspec'), webUiDir } = options;
   135→
   136→  // Determine startup project path (project root, not .kspec/)
   137→  // AC: @multi-directory-daemon ac-2 - daemon uses startup directory as default project
   138→  const startupProjectPath = kspecDir.endsWith('.kspec')
   139→    ? kspecDir.slice(0, -('.kspec'.length + 1)) // Remove '/.kspec'
   140→    : kspecDir;
   141→
   142→  // Import ProjectContextManager (needed for WebSocket binding)
   143→  const { ProjectContextManager } = await import('./project-context');
   144→
   145→  // AC: @daemon-server ac-17 - Resolve web UI path for static file serving
   146→  const resolvedWebUiPath = resolveWebUiPath(webUiDir);
   147→  if (resolvedWebUiPath) {
   148→    console.log(`[daemon] Web UI assets found at: ${resolvedWebUiPath}`);
   149→  } else {
   150→    console.log('[daemon] Web UI assets not found - UI will not be served');
   151→    console.log('[daemon] Build the web UI with: cd packages/web-ui && npm run build');
   152→  }
   153→
   154→  // Initialize PID file manager (uses global ~/.config/kspec/)
   155→  const pidManager = new PidFileManager();
   156→
   157→  // AC: @multi-directory-daemon ac-9 - Write PID and port files in daemon mode
   158→  if (isDaemon) {
   159→    pidManager.writePid();
   160→    pidManager.writePort(port);
   161→    console.log(`[daemon] PID file written: ${process.pid}`);
   162→    console.log(`[daemon] Port file written: ${port}`);
   163→  }
   164→
   165→  // Initialize WebSocket managers
   166→  pubsubManager = new PubSubManager();
   167→  heartbeatManager = new HeartbeatManager();
   168→  wsHandler = new WebSocketHandler(pubsubManager);
   169→
   170→  // WeakMap to store project path during WebSocket upgrade (keyed by Request object)
   171→  // Using WeakMap avoids needing to pass a requestId through beforeHandle return value,
   172→  // which breaks WebSocket upgrade in Elysia 1.4 when derive middleware is present.
   173→  const wsProjectPaths = new WeakMap<Request, string>();
   174→
   175→  const app = new Elysia()
   176→    // AC-15: Plugin pattern for middleware
   177→    // AC: @api-contract ac-1 - Allow CORS from dev server on localhost:5173
   178→    .use(cors({
   179→      origin: ['http://localhost:5173', 'http://127.0.0.1:5173'], // Dev server origins
   180→      credentials: true,
   181→      methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS']
   182→    }))
   183→
   184→    // AC-3: Enforce localhost-only connections
   185→    .onRequest(localhostOnly());
   186→
   187→  // AC: @multi-directory-daemon ac-1, ac-2, ac-3 - Project context middleware
   188→  const { manager: projectContextManager, middleware: projectMiddleware } = projectContextMiddleware({
   189→    startupProject: startupProjectPath,
   190→    pubsub: pubsubManager
   191→  });
   192→
   193→  // Store manager globally for shutdown
   194→  projectManager = projectContextManager;
   195→
   196→  app.use(projectMiddleware)
   197→
   198→    // AC-11: Health check endpoint
   199→    .get('/api/health', () => ({
   200→      status: 'ok',
   201→      uptime: process.uptime(),
   202→      connections: pubsubManager.getConnectionCount(),
   203→      version: '0.1.0'
   204→    }))
   205→
   206→    // AC: @api-contract ac-2 through ac-7 - Task API endpoints
   207→    // AC: @multi-directory-daemon ac-24 - Routes use projectContext from middleware
   208→    .use(createTasksRoutes({ pubsub: pubsubManager }))
   209→
   210→    // AC: @api-contract ac-8 through ac-11 - Spec Item API endpoints
   211→    .use(createItemsRoutes())
   212→
   213→    // AC: @api-contract ac-12 through ac-14 - Inbox API endpoints
   214→    .use(createInboxRoutes({ pubsub: pubsubManager }))
   215→
   216→    // AC: @api-contract ac-15 through ac-18 - Meta API endpoints
   217→    .use(createMetaRoutes())
   218→
   219→    // AC: @triage-daemon-api ac-1 through ac-9 - Triage API endpoints
   220→    .use(createTriageRoutes({ pubsub: pubsubManager }))
   221→
   222→    // AC: @api-contract ac-19 through ac-21 - Validation and search endpoints
   223→    .use(createValidationRoutes())
   224→
   225→    // AC: @multi-directory-daemon ac-28, ac-29, ac-30 - Projects management endpoints
   226→    .use(createProjectsRoutes({ projectManager: projectContextManager }))
   227→
   228→    // AC: @agent-dispatch-engine ac-4 - Agent dispatch API endpoints
   229→    .use(createAgentDispatchRoutes())
   230→
   231→    // AC-4: WebSocket endpoint for real-time updates
   232→    .ws<ConnectionData>('/ws', {
   233→      beforeHandle({ request, store }) {
   234→        // AC: @multi-directory-daemon ac-21, ac-22, ac-23, ac-34 - Extract and validate project binding
   235→        // AC: @multi-directory-daemon ac-34 - Browser WebSocket API doesn't support custom headers,
   236→        // so we also accept project path as query parameter
   237→        const url = new URL(request.url, `http://${request.headers.get('host')}`);
   238→        const projectPath = request.headers.get('X-Kspec-Dir')
   239→                        || url.searchParams.get('project')
   240→                        || undefined;
   241→
   242→        // IMPORTANT: Do NOT return a value from ws beforeHandle.
   243→        // In Elysia 1.4 with derive middleware, returning a value short-circuits
   244→        // the WebSocket upgrade and sends the value as an HTTP 200 response.
   245→        // Use a WeakMap keyed by Request object to pass data to open().
   246→        try {
   247→          const manager = (store as Record<string, unknown>).projectManager as import('./project-context').ProjectContextManager | undefined;
   248→          if (!manager) {
   249→            // Fallback: project manager not initialized yet
   250→            wsProjectPaths.set(request, startupProjectPath);
   251→            return;
   252→          }
   253→
   254→          let projectContext;
   255→          if (projectPath) {
   256→            // Explicit project specified
   257→            try {
   258→              projectContext = manager.getProject(projectPath);
   259→            } catch {
   260→              // AC: @multi-directory-daemon ac-4 - auto-register
   261→              projectContext = manager.registerProject(projectPath);
   262→            }
   263→          } else {
   264→            // AC: @multi-directory-daemon ac-22, ac-23 - Use default or reject
   265→            try {
   266→              projectContext = manager.getProject();
   267→            } catch (err: unknown) {
   268→              // AC: @multi-directory-daemon ac-23 - Reject when no default
   269→              if (err instanceof Error && err.message.includes('No default project configured')) {
   270→                throw new Error('No project specified');
   271→              }
   272→              throw err;
   273→            }
   274→          }
   275→
   276→          // Store resolved path for open() handler via WeakMap
   277→          wsProjectPaths.set(request, projectContext.path);
   278→        } catch (err: unknown) {
   279→          console.error(`[daemon] WebSocket connection rejected: ${err instanceof Error ? err.message : String(err)}`);
   280→          throw err;
   281→        }
   282→      },
   283→      open(ws) {
   284→        // AC: @api-contract ac-25, @trait-websocket-protocol ac-1
   285→        const sessionId = ulid();
   286→
   287→        // AC: @multi-directory-daemon ac-21 - Get bound project path
   288→        // Retrieve project path from WeakMap via the request object on ws.data
   289→        const request = (ws.data as Record<string, unknown>).request as Request | undefined;
   290→        const projectPath = request ? wsProjectPaths.get(request) || startupProjectPath : startupProjectPath;
   291→
   292→        ws.data = {
   293→          sessionId,
   294→          topics: new Set<string>(),
   295→          seq: 0,
   296→          lastPing: undefined,
   297→          lastPong: Date.now(),
   298→          projectPath // AC: @multi-directory-daemon ac-21 - immutable binding
   299→        };
   300→
   301→        pubsubManager.addConnection(sessionId, ws);
   302→        console.log(`[daemon] WebSocket client connected: ${sessionId} bound to ${projectPath} (${pubsubManager.getConnectionCount()} total)`);
   303→
   304→        // Send connected event with session_id
   305→        const connectedEvent: ConnectedEvent = {
   306→          event: 'connected',
   307→          data: {
   308→            session_id: sessionId
   309→          }
   310→        };
   311→        ws.send(JSON.stringify(connectedEvent));
   312→      },
   313→      message(ws, message) {
   314→        // AC: @api-contract ac-26, ac-27
   315→        wsHandler.handleMessage(ws, message);
   316→      },
   317→      pong(ws) {
   318→        // AC: @trait-websocket-protocol ac-5
   319→        heartbeatManager.recordPong(ws);
   320→      },
   321→      close(ws, code, reason) {
   322→        pubsubManager.removeConnection(ws.data.sessionId);
   323→        console.log(`[daemon] WebSocket client disconnected: ${ws.data.sessionId} (code: ${code}, reason: ${reason})`);
   324→      }
   325→    });
   326→
   327→  // AC: @daemon-server ac-17 - Serve web UI static assets
   328→  // Added after API routes so API routes take precedence
   329→  if (resolvedWebUiPath) {
   330→    const indexHtmlPath = join(resolvedWebUiPath, 'index.html');
   331→
   332→    // Serve static files from web UI build directory
   333→    app.use(await staticPlugin({
   334→      assets: resolvedWebUiPath,
   335→      prefix: '/',
   336→      noCache: process.env.NODE_ENV === 'development', // Disable cache in dev
   337→    }));
   338→
   339→    // SPA fallback routes for client-side routing
   340→    // These catch paths like /tasks, /items, /inbox that don't have static files
   341→    const spaRoutes = ['/tasks', '/tasks/*', '/items', '/items/*', '/inbox', '/observations', '/triage'];
   342→    for (const route of spaRoutes) {
   343→      app.get(route, () => Bun.file(indexHtmlPath));
   344→    }
   345→
   346→    console.log('[daemon] Web UI static file serving enabled');
   347→  }
   348→
   349→  // AC-1, AC-2: Start server on localhost only
   350→  // Using 'localhost' hostname allows Bun/OS to bind to both 127.0.0.1 and ::1
   351→  app.listen({
   352→    port,
   353→    hostname: 'localhost', // Resolves to both IPv4 and IPv6 loopback
   354→  });
   355→
   356→  console.log(`[daemon] Server listening on http://localhost:${port} (IPv4: 127.0.0.1, IPv6: ::1)`);
   357→  console.log(`[daemon] WebSocket available at ws://localhost:${port}/ws`);
   358→
   359→  // AC: @agent-dispatch-engine ac-5 - Wire file change callback to dispatch engine
   360→  projectContextManager.setFileChangeCallback((projectPath, file) => {
   361→    // Only forward changes to project.tasks.yaml
   362→    if (!file.endsWith('project.tasks.yaml')) return;
   363→    const engine = getDispatchEngine(projectPath);
   364→    if (engine) {
   365→      engine.handleFileChange(projectPath).catch((err) => {
   366→        console.error('[dispatch] Error handling file change:', err);
   367→      });
   368→    }
   369→  });
   370→
   371→  // AC: @multi-directory-daemon ac-17 - Start file watcher for startup project
   372→  if (startupProjectPath) {
   373→    try {
   374→      await projectContextManager.startWatcher(startupProjectPath);
   375→      console.log(`[daemon] File watcher started for startup project: ${startupProjectPath}`);
   376→    } catch (error) {
   377→      console.error('[daemon] Failed to start file watcher for startup project:', error);
   378→    }
   379→  }
   380→
   381→  // AC: @daemon-server ac-13, ac-14 - Start heartbeat monitoring
   382→  heartbeatManager.start(pubsubManager.getAllConnections());
   383→
   384→  // AC-12: Graceful shutdown on SIGTERM/SIGINT
   385→  const shutdown = async (signal: string) => {
   386→    console.log(`[daemon] Received ${signal}, shutting down gracefully...`);
   387→
   388→    try {
   389→      // Stop heartbeat monitoring
   390→      heartbeatManager.stop();
   391→
   392→      // AC: @agent-dispatch-engine ac-11 - Stop all dispatch engines before shutting down
   393→      await stopAllEngines();
   394→
   395→      // AC: @multi-directory-daemon ac-11b - Stop all file watchers
   396→      await projectContextManager.stopAllWatchers();
   397→      console.log('[daemon] All file watchers stopped');
   398→
   399→      // Close all WebSocket connections with code 1000 (clean close)
   400→      // AC: @trait-websocket-protocol ac-7
   401→      for (const [sessionId, ws] of pubsubManager.getAllConnections()) {
   402→        ws.close(1000, 'Server shutting down');
   403→      }
   404→
   405→      // Stop the server
   406→      await app.server?.stop();
   407→
   408→      // AC: @daemon-server ac-10 - Remove PID file on shutdown
   409→      if (isDaemon) {
   410→        pidManager.remove();
   411→        console.log('[daemon] PID file removed');
   412→      }
   413→
   414→      console.log('[daemon] Server stopped successfully');
   415→      process.exit(0);
   416→    } catch (error) {
   417→      console.error('[daemon] Error during shutdown:', error);
   418→      process.exit(1);
   419→    }
   420→  };
   421→
   422→  process.on('SIGTERM', () => shutdown('SIGTERM'));
   423→  process.on('SIGINT', () => shutdown('SIGINT'));
   424→
   425→  return app;
   426→}
   427→

