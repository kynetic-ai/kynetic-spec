## 6. Agent Schema (`src/schema/meta.ts`)

**Key Zod Schemas:**

```typescript
// Agent definition (AC: @agent-definition-schema ac-1 through ac-8)
AgentSchema = z.object({
  _ulid: MetaUlidSchema,
  id: z.string(),             // "task-worker", "pr-reviewer"
  name: z.string(),
  description?: z.string(),
  capabilities: z.array(z.string()),
  tools: z.array(z.string()),
  session_protocol?: SessionProtocolSchema,
  conventions: z.array(z.string()),
  
  // Dispatch/runtime (NEW)
  adapter?: z.string(),       // "claude-agent-acp" (default)
  dispatch: z.array(AgentDispatchRuleSchema),
  skills: z.array(z.string()),
  budget?: AgentBudgetSchema,
  concurrency: AgentConcurrencySchema,  // default { max_concurrent: 1 }
  auto_approve: z.boolean(),  // For yolo mode
  prompt_template?: z.string(),
  automation?: "eligible" | "ineligible",
  tags?: z.array(z.string()),
});

// Dispatch rule: maps event type + optional filters
AgentDispatchRuleSchema = z.object({
  on: z.enum(["task.ready", "task.needs_work", "task.pending_review"]),
  filter?: AgentDispatchFilterSchema,
});

// Filter: narrowing constraints
AgentDispatchFilterSchema = z.object({
  automation?: "eligible" | "ineligible",
  tags?: z.array(z.string()),
  priority?: z.number(),
});

// Budget: task count and time limits
AgentBudgetSchema = z.object({
  max_tasks?: z.number().positive(),
  timeout_minutes?: z.number().positive(),
});

// Concurrency: parallel limits
AgentConcurrencySchema = z.object({
  max_concurrent: z.number().int().positive(),  // default 1
});
```

