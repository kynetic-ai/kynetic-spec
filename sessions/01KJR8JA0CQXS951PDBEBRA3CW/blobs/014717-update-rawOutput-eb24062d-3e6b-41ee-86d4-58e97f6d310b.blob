   467→
   468→    // AC: @trait-dry-run ac-4
   469→    it('should show error but no state changed in dry run mode (ac-4)', async () => {
   470→      // This test would need to trigger an error condition in dry run mode
   471→      // For now, we verify that dry run doesn't create any files even on success
   472→      kspecFull('agents generate --dry-run', tempDir);
   473→
   474→      // No files should be created
