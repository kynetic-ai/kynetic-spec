   536→  // AC: @agent-templates ac-1 through ac-3
   537→  describe('Agent Template System', () => {
   538→    // AC: @agent-templates ac-1
   539→    describe('ac-1: template sections included in defined order', () => {
   540→      it('should include all template sections in the generated output', async () => {
   541→        const result = kspecFull('agents generate', tempDir);
   542→        expect(result.exitCode).toBe(0);
   543→
   544→        const filePath = path.join(tempDir, 'kspec-agents.md');
   545→        const content = await fs.readFile(filePath, 'utf-8');
   546→
   547→        // Verify template sections are present
   548→        expect(content).toContain('## Quick Start');
   549→        expect(content).toContain('## Shadow Branch Architecture');
   550→        expect(content).toContain('## Task Lifecycle');
   551→        expect(content).toContain('## PR Workflow');
   552→        expect(content).toContain('## Commit Convention');
   553→        expect(content).toContain('## Agent Dispatch Mode');
   554→        expect(content).toContain('## Batch Usage');
   555→      });
   556→
   557→      it('should include templates in file order (sorted by prefix)', async () => {
