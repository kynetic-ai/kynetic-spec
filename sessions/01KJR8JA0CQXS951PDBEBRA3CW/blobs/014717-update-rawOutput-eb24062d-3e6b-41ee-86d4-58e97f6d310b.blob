   477→
   478→      const hashPath = path.join(tempDir, '.kspec', '.kspec-agents-hash');
   479→      await expect(fs.access(hashPath)).rejects.toThrow();
   480→    });
   481→
   482→    // AC: @trait-dry-run ac-5 is not applicable (no --force option for agents generate)
   483→
   484→    // AC: @trait-dry-run ac-6
   485→    it('should include dry_run boolean field in JSON output (ac-6)', async () => {
   486→      const result = kspecJson<{ dry_run: boolean; content: string }>(
   487→        'agents generate --dry-run',
   488→        tempDir
   489→      );
   490→
   491→      expect(result.dry_run).toBe(true);
   492→      expect(result.content).toBeTruthy();
   493→      expect(result.content).toContain('# kspec Agent Instructions');
