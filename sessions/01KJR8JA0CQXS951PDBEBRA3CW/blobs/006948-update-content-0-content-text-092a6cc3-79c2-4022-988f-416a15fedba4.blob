   279→        headers: { 'Content-Type': 'application/json' },
   280→      });
   281→      expect(eventResp.status()).toBe(200);
   282→    });
   283→
   284→    // AC: @trait-api-endpoint ac-3 — invalid body returns 400
   285→    test('POST /api/agent/dispatch with invalid action returns 400', async ({ request, daemon }) => {
   286→      const response = await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
   287→        data: { action: 'restart' }, // invalid action
   288→        headers: { 'Content-Type': 'application/json' },
   289→      });
   290→
   291→      // Elysia returns 400 for validation failures
