    46→import { test, expect } from '../fixtures/test-base';
    47→
    48→const DAEMON_URL = 'http://localhost:3456';
    49→
    50→test.describe('Agent Dispatch API', () => {
    51→  test.describe('GET /api/agent/status', () => {
    52→    // AC: @daemon-agent-dispatch ac-5
    53→    test('returns dispatch_enabled, active_invocations, queue_depth, agent_definitions', async ({ request, daemon }) => {
    54→      const response = await request.get(`${DAEMON_URL}/api/agent/status`);
    55→
    56→      expect(response.status()).toBe(200);
    57→
    58→      const body = await response.json();
    59→
    60→      expect(body).toHaveProperty('dispatch_enabled');
    61→      expect(typeof body.dispatch_enabled).toBe('boolean');
    62→
    63→      expect(body).toHaveProperty('active_invocations');
    64→      expect(Array.isArray(body.active_invocations)).toBe(true);
    65→
    66→      expect(body).toHaveProperty('queue_depth');
    67→      expect(typeof body.queue_depth).toBe('number');
    68→
    69→      expect(body).toHaveProperty('agent_definitions');
    70→      expect(Array.isArray(body.agent_definitions)).toBe(true);
    71→    });
    72→
    73→    // AC: @daemon-agent-dispatch ac-5
    74→    test('returns dispatch_enabled=false when engine not started', async ({ request, daemon }) => {
    75→      const response = await request.get(`${DAEMON_URL}/api/agent/status`);
    76→
    77→      expect(response.status()).toBe(200);
    78→
    79→      const body = await response.json();
    80→      expect(body.dispatch_enabled).toBe(false);
    81→      expect(body.active_invocations).toEqual([]);
    82→      expect(body.queue_depth).toBe(0);
    83→    });
    84→  });
    85→
    86→  test.describe('POST /api/agent/dispatch', () => {
    87→    // AC: @daemon-agent-dispatch ac-6
    88→    test('starts dispatch engine with action=start', async ({ request, daemon }) => {
    89→      const response = await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
    90→        data: { action: 'start' },
    91→        headers: { 'Content-Type': 'application/json' },
    92→      });
    93→
    94→      expect(response.status()).toBe(200);
    95→
    96→      const body = await response.json();
    97→      expect(body).toHaveProperty('dispatch_enabled');
    98→      expect(body.dispatch_enabled).toBe(true);
    99→
   100→      // Clean up
   101→      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
   102→        data: { action: 'stop' },
   103→        headers: { 'Content-Type': 'application/json' },
   104→      });
   105→    });
   106→
   107→    // AC: @daemon-agent-dispatch ac-6
   108→    test('stops dispatch engine with action=stop', async ({ request, daemon }) => {
   109→      // Start first
   110→      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
   111→        data: { action: 'start' },
   112→        headers: { 'Content-Type': 'application/json' },
   113→      });
   114→
   115→      const response = await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
   116→        data: { action: 'stop' },
   117→        headers: { 'Content-Type': 'application/json' },
   118→      });
   119→
   120→      expect(response.status()).toBe(200);
   121→
   122→      const body = await response.json();
   123→      expect(body).toHaveProperty('dispatch_enabled');
   124→      expect(body.dispatch_enabled).toBe(false);
   125→    });
   126→
   127→    // AC: @daemon-agent-dispatch ac-6
   128→    test('returns dispatch_enabled=true when GET /api/agent/status is called after start', async ({ request, daemon }) => {
   129→      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
   130→        data: { action: 'start' },
   131→        headers: { 'Content-Type': 'application/json' },
   132→      });
   133→
   134→      const statusResponse = await request.get(`${DAEMON_URL}/api/agent/status`);
   135→      expect(statusResponse.status()).toBe(200);
   136→
   137→      const body = await statusResponse.json();
   138→      expect(body.dispatch_enabled).toBe(true);
   139→
   140→      // Clean up
   141→      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
   142→        data: { action: 'stop' },
   143→        headers: { 'Content-Type': 'application/json' },
   144→      });
   145→    });
   146→  });
   147→
   148→  test.describe('POST /api/agent/events', () => {
   149→    // AC: @daemon-agent-dispatch ac-2, ac-7
   150→    test('returns accepted=false when dispatch engine not running', async ({ request, daemon }) => {
   151→      const response = await request.post(`${DAEMON_URL}/api/agent/events`, {
   152→        data: {
   153→          task_id: '01JXXXXXXXXXXXXXXXXXXXXXXXXX',
   154→          from_status: 'in_progress',
   155→          to_status: 'pending',
   156→          timestamp: Date.now(),
   157→        },
   158→        headers: { 'Content-Type': 'application/json' },
   159→      });
   160→
   161→      expect(response.status()).toBe(200);
   162→
   163→      const body = await response.json();
   164→      // AC: @daemon-agent-dispatch ac-7 - silent fail when engine not running
   165→      expect(body.accepted).toBe(false);
   166→      expect(body.reason).toBeDefined();
   167→    });
   168→
   169→    // AC: @daemon-agent-dispatch ac-2
   170→    test('returns accepted=true when dispatch engine is running', async ({ request, daemon }) => {
   171→      // Start the engine first
   172→      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
   173→        data: { action: 'start' },
   174→        headers: { 'Content-Type': 'application/json' },
   175→      });
   176→
   177→      const response = await request.post(`${DAEMON_URL}/api/agent/events`, {
   178→        data: {
   179→          task_id: '01JXXXXXXXXXXXXXXXXXXXXXXXXX',
   180→          task_ref: '@test-task',
   181→          from_status: 'in_progress',
   182→          to_status: 'pending',
   183→          timestamp: Date.now(),
   184→        },
   185→        headers: { 'Content-Type': 'application/json' },
   186→      });
   187→
   188→      expect(response.status()).toBe(200);
   189→
   190→      const body = await response.json();
   191→      expect(body.accepted).toBe(true);
   192→
   193→      // Clean up
   194→      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
   195→        data: { action: 'stop' },
   196→        headers: { 'Content-Type': 'application/json' },
   197→      });
   198→    });
   199→
   200→    // AC: @daemon-agent-dispatch ac-2
   201→    test('POST /api/agent/event (legacy alias) returns accepted=false when engine not running', async ({ request, daemon }) => {
   202→      const response = await request.post(`${DAEMON_URL}/api/agent/event`, {
   203→        data: {
   204→          task_id: '01JXXXXXXXXXXXXXXXXXXXXXXXXX',
   205→          from_status: 'pending',
   206→          to_status: 'in_progress',
   207→          timestamp: Date.now(),
   208→        },
   209→        headers: { 'Content-Type': 'application/json' },
   210→      });
   211→
   212→      expect(response.status()).toBe(200);
   213→
   214→      const body = await response.json();
