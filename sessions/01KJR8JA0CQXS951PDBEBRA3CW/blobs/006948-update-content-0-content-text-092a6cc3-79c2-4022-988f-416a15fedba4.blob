   216→    });
   217→  });
   218→
   219→  test.describe('GET /api/agent/dispatch/status (internal format)', () => {
   220→    // AC: @daemon-agent-dispatch ac-5 (internal route for backwards compat)
   221→    test('returns running=false when engine not started', async ({ request, daemon }) => {
   222→      const response = await request.get(`${DAEMON_URL}/api/agent/dispatch/status`);
   223→
   224→      expect(response.status()).toBe(200);
   225→
   226→      const body = await response.json();
   227→      expect(body).toHaveProperty('running');
   228→      expect(body.running).toBe(false);
   229→    });
   230→  });
   231→
   232→  test.describe('Legacy dispatch start/stop routes', () => {
   233→    test('POST /api/agent/dispatch/start starts the engine', async ({ request, daemon }) => {
   234→      const response = await request.post(`${DAEMON_URL}/api/agent/dispatch/start`);
   235→
   236→      expect(response.status()).toBe(200);
   237→
   238→      const body = await response.json();
   239→      expect(body.started).toBe(true);
   240→
   241→      // Verify engine is running
   242→      const statusResponse = await request.get(`${DAEMON_URL}/api/agent/dispatch/status`);
   243→      const status = await statusResponse.json();
   244→      expect(status.running).toBe(true);
   245→
   246→      // Clean up
   247→      await request.post(`${DAEMON_URL}/api/agent/dispatch/stop`);
   248→    });
   249→
   250→    test('POST /api/agent/dispatch/stop stops the engine', async ({ request, daemon }) => {
   251→      // Start first
   252→      await request.post(`${DAEMON_URL}/api/agent/dispatch/start`);
   253→
   254→      const response = await request.post(`${DAEMON_URL}/api/agent/dispatch/stop`);
   255→
   256→      expect(response.status()).toBe(200);
   257→
   258→      const body = await response.json();
   259→      expect(body.stopped).toBe(true);
   260→
   261→      // Verify engine is stopped
   262→      const statusResponse = await request.get(`${DAEMON_URL}/api/agent/dispatch/status`);
   263→      const status = await statusResponse.json();
   264→      expect(status.running).toBe(false);
   265→    });
   266→  });
   267→
   268→  test.describe('Trait: @trait-api-endpoint', () => {
   269→    // AC: @trait-api-endpoint ac-1 — valid requests return 2xx
   270→    test('all dispatch endpoints return 2xx for valid requests', async ({ request, daemon }) => {
   271→      const statusResp = await request.get(`${DAEMON_URL}/api/agent/status`);
   272→      expect(statusResp.status()).toBe(200);
   273→
   274→      const dispatchStatusResp = await request.get(`${DAEMON_URL}/api/agent/dispatch/status`);
   275→      expect(dispatchStatusResp.status()).toBe(200);
   276→
   277→      const eventResp = await request.post(`${DAEMON_URL}/api/agent/events`, {
