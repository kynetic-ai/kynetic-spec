   293→    });
   294→
   295→    // AC: @trait-api-endpoint ac-6 — X-Request-Id header
   296→    test('responses include X-Request-Id header', async ({ request, daemon }) => {
   297→      const response = await request.get(`${DAEMON_URL}/api/agent/status`);
   298→
   299→      // Note: X-Request-Id is added by middleware if configured
