```
     1→/**
     2→ * kspec agent commands — manage and run agents.
     3→ *
     4→ * Provides subcommands for listing agent definitions, running one-shot
     5→ * invocations, and managing the dispatch engine lifecycle via the daemon.
     6→ *
     7→ * AC: @cli-agent-commands ac-1 through ac-10
     8→ * AC: @trait-json-output ac-1 through ac-6
     9→ * AC: @trait-semantic-exit-codes ac-1 through ac-8
    10→ * AC: @trait-error-guidance ac-1 through ac-6
    11→ * AC: @trait-dry-run ac-1 through ac-6
    12→ * AC: @trait-filterable-list ac-1 through ac-8
    13→ */
    14→
    15→import type { Command } from "commander";
    16→import chalk from "chalk";
    17→import {
    18→  initContext,
    19→  loadMetaContext,
    20→} from "../../parser/index.js";
    21→import { runInvocation } from "../../agent-runtime/invocation.js";
    22→import { buildPromptWithSkills } from "../../agent-runtime/prompts.js";
    23→import { resolveAdapter } from "../../agents/adapters.js";
    24→import { EXIT_CODES } from "../exit-codes.js";
    25→import { error, output, success, isJsonMode } from "../output.js";
    26→import { parseIntOption } from "../validators.js";
    27→import { PidFileManager } from "../pid-utils.js";
    28→import { errors } from "../../strings/errors.js";
    29→import type { LoadedAgent } from "../../parser/meta.js";
    30→
    31→// ─── Helpers ─────────────────────────────────────────────────────────────────
    32→
    33→/**
    34→ * Get the daemon URL from the PID file manager.
    35→ * Returns null if the daemon is not running.
    36→ * AC: @cli-agent-commands ac-10
    37→ */
    38→function getDaemonUrl(): { url: string; port: number } | null {
    39→  const pidManager = new PidFileManager();
    40→  if (!pidManager.isDaemonRunning()) return null;
    41→  try {
    42→    const port = pidManager.readPort();
    43→    return { url: `http://localhost:${port}`, port };
    44→  } catch {
    45→    return null;
    46→  }
    47→}
    48→
    49→/**
    50→ * Format dispatch rules summary for display.
    51→ */
    52→function formatDispatchRules(agent: LoadedAgent): string {
    53→  if (!agent.dispatch || agent.dispatch.length === 0) {
    54→    return "(none)";
    55→  }
    56→  return agent.dispatch.map((r) => {
    57→    const filterParts: string[] = [];
    58→    if (r.filter?.automation) filterParts.push(`automation=${r.filter.automation}`);
    59→    if (r.filter?.tags?.length) filterParts.push(`tags=${r.filter.tags.join(",")}`);
    60→    if (r.filter?.priority !== undefined) filterParts.push(`priority=${r.filter.priority}`);
    61→    const filterStr = filterParts.length > 0 ? ` [${filterParts.join(", ")}]` : "";
    62→    return `${r.on}${filterStr}`;
    63→  }).join(", ");
    64→}
    65→
    66→// ─── Command Registration ─────────────────────────────────────────────────────
    67→
    68→/**
    69→ * Register the kspec agent command family.
    70→ * AC: @cli-agent-commands ac-1 through ac-10
    71→ */
    72→export function registerAgentCommands(program: Command): void {
    73→  const agent = program
    74→    .command("agent")
    75→    .description("Manage and run agents");
    76→
    77→  // ─── kspec agent list ─────────────────────────────────────────────────────
    78→
    79→  // AC: @cli-agent-commands ac-1
    80→  // AC: @trait-filterable-list ac-1 through ac-8
    81→  agent
    82→    .command("list")
    83→    .description("List all agent definitions")
    84→    .option("--json", "Output as JSON")
    85→    .option("--status <status>", "Filter by automation status (eligible|ineligible)")
    86→    .option("--tag <tag>", "Filter by tag (repeatable)", (val: string, arr: string[]) => [...arr, val], [] as string[])
    87→    .option("--limit <n>", "Maximum number of results")
    88→    .option("--offset <n>", "Skip first N results")
    89→    .option("--count", "Output only the count")
    90→    .action(async (opts) => {
    91→      try {
    92→        const ctx = await initContext();
    93→
    94→        if (!ctx.manifestPath) {
    95→          error(errors.project.noKspecProject);
    96→          process.exit(EXIT_CODES.VALIDATION_FAILED);
    97→        }
    98→
    99→        const meta = await loadMetaContext(ctx);
   100→        let agents = meta.agents;
   101→
   102→        // AC: @trait-filterable-list ac-1 - automation status filter
   103→        if (opts.status) {
   104→          agents = agents.filter((a) =>
   105→            (a as LoadedAgent & { automation?: string }).automation === opts.status,
   106→          );
   107→        }
   108→
   109→        // AC: @trait-filterable-list ac-2 - tag filter
   110→        const tags: string[] = opts.tag ?? [];
   111→        if (tags.length > 0) {
   112→          agents = agents.filter((a) => {
   113→            const agentTags = (a as LoadedAgent & { tags?: string[] }).tags ?? [];
   114→            return tags.every((t) => agentTags.includes(t));
   115→          });
   116→        }
   117→
   118→        const total = agents.length;
   119→
   120→        // AC: @trait-filterable-list ac-8 - count mode
   121→        if (opts.count) {
   122→          output({ count: total }, () => {
   123→            console.log(total);
   124→          });
   125→          return;
   126→        }
   127→
   128→        // AC: @trait-filterable-list ac-3, ac-4 - pagination
   129→        // AC: @trait-semantic-exit-codes ac-2 - invalid numeric input exits with validation error
   130→        let limit = total;
   131→        if (opts.limit !== undefined) {
   132→          const parsed = parseIntOption(opts.limit, {
   133→            min: 0,
   134→            max: Number.MAX_SAFE_INTEGER,
   135→            name: "Limit",
   136→          });
   137→          if (!parsed.ok) {
   138→            error(`Invalid --limit value: ${parsed.error}`, { suggestion: "Example: --limit 10" });
   139→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   140→          }
   141→          limit = parsed.value;
   142→        }
   143→        let offset = 0;
   144→        if (opts.offset !== undefined) {
   145→          const parsed = parseIntOption(opts.offset, {
   146→            min: 0,
   147→            max: Number.MAX_SAFE_INTEGER,
   148→            name: "Offset",
   149→          });
   150→          if (!parsed.ok) {
   151→            error(`Invalid --offset value: ${parsed.error}`, { suggestion: "Example: --offset 5" });
   152→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   153→          }
   154→          offset = parsed.value;
   155→        }
   156→        const paginated = agents.slice(offset, offset + limit);
   157→
   158→        // AC: @trait-semantic-exit-codes ac-5 - empty result set exits 0
   159→        // AC: @trait-filterable-list ac-6 - empty list with informative message
   160→        if (paginated.length === 0) {
   161→          output(
   162→            { items: [], total, offset, limit },
   163→            () => {
   164→              if (opts.status || tags.length > 0) {
   165→                console.log("No agents match the specified filters.");
   166→              } else {
   167→                console.log("No agent definitions found.");
   168→              }
   169→            },
   170→          );
   171→          return;
   172→        }
   173→
   174→        // AC: @trait-json-output ac-1 through ac-5
   175→        output(
   176→          {
   177→            items: paginated.map((a) => ({
   178→              id: a.id,
   179→              name: a.name,
   180→              adapter: a.adapter ?? "claude-agent-acp",
   181→              dispatch: a.dispatch ?? [],
   182→              concurrency: a.concurrency ?? { max_concurrent: 1 },
   183→            })),
   184→            total,
   185→            offset,
   186→            limit,
   187→          },
   188→          () => {
   189→            // AC: @trait-filterable-list ac-7 - summary with total and filter state
   190→            const filterDesc = [
   191→              opts.status ? `status=${opts.status}` : "",
   192→              tags.length > 0 ? `tags=${tags.join(",")}` : "",
   193→            ].filter(Boolean).join(", ");
   194→            const summaryStr = filterDesc ? ` (filtered: ${filterDesc})` : "";
   195→            console.log(chalk.bold(`Agents${summaryStr}: ${paginated.length} of ${total}`));
   196→            console.log();
   197→
   198→            for (const a of paginated) {
   199→              console.log(`  ${chalk.cyan(a.id)}  ${chalk.gray(a.adapter ?? "claude-agent-acp")}`);
   200→              console.log(`    ${chalk.gray("dispatch:")} ${formatDispatchRules(a)}`);
   201→              console.log(`    ${chalk.gray("concurrency:")} max ${a.concurrency?.max_concurrent ?? 1}`);
   202→            }
   203→          },
   204→        );
   205→      } catch (err) {
   206→        error("Failed to list agents", err);
   207→        process.exit(EXIT_CODES.ERROR);
   208→      }
   209→    });
   210→
   211→  // ─── kspec agent run ──────────────────────────────────────────────────────
   212→
   213→  // AC: @cli-agent-commands ac-2, ac-3, ac-7, ac-8
   214→  // AC: @trait-dry-run ac-1 through ac-6
   215→  agent
   216→    .command("run <agent-id> [prompt]")
   217→    .description("Run a one-shot agent invocation")
   218→    .option("--task <ref>", "Task reference to target")
   219→    .option("--timeout <minutes>", "Timeout in minutes (overrides agent default)")
   220→    .option("--budget <n>", "Budget override (max tasks)")
   221→    .option("--adapter <id>", "Adapter override")
   222→    .option("--dry-run", "Show prompt without spawning agent")
   223→    .option("--json", "Output as JSON")
   224→    .action(async (agentId: string, prompt: string | undefined, opts) => {
   225→      try {
   226→        const ctx = await initContext();
   227→
   228→        if (!ctx.manifestPath) {
   229→          error(errors.project.noKspecProject);
   230→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   231→        }
   232→
   233→        const meta = await loadMetaContext(ctx);
   234→        const agentDef = meta.agents.find((a) => a.id === agentId);
   235→
   236→        // AC: @trait-error-guidance ac-3 - not found error with suggestion
   237→        if (!agentDef) {
   238→          error(
   239→            `Agent "${agentId}" not found.`,
   240→            {
   241→              suggestion: `Check available agents with: kspec agent list`,
   242→            },
   243→          );
   244→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   245→        }
   246→
   247→        // Resolve the effective adapter
   248→        const adapterId = opts.adapter ?? agentDef.adapter ?? "claude-agent-acp";
   249→        const adapter = resolveAdapter(adapterId);
   250→
   251→        // Build the prompt
   252→        const taskRef = opts.task as string | undefined;
   253→        const basePrompt = prompt ?? (taskRef
   254→          ? `Work on task ${taskRef} according to your configuration and skills.`
   255→          : `Run as requested.`);
   256→
   257→        // Note: buildPromptWithSkills is called here for the dry-run preview path.
   258→        // runInvocation also calls buildPromptWithSkills internally, so we pass basePrompt
   259→        // to runInvocation (not fullPrompt) to avoid double-expansion.
   260→        const fullPromptForPreview = await buildPromptWithSkills({
   261→          basePrompt,
   262→          skillIds: agentDef.skills ?? [],
   263→          specDir: ctx.specDir,
   264→        });
   265→
   266→        // AC: @trait-dry-run ac-1, ac-2, ac-3 - dry run shows prompt, no changes
   267→        if (opts.dryRun) {
   268→          // Pre-compute overrides so dry-run reflects what the actual invocation would use
   269→          // AC: @cli-agent-commands ac-7 - overrides are visible in dry-run output
   270→          // AC: @trait-semantic-exit-codes ac-2 - validate numeric inputs even in dry-run
   271→          let dryTimeoutOverride: number | undefined;
   272→          if (opts.timeout) {
   273→            const parsed = parseIntOption(opts.timeout, { min: 1, max: 10080, name: "Timeout" });
   274→            if (!parsed.ok) {
   275→              error(`Invalid --timeout value: ${parsed.error}`, { suggestion: "Example: --timeout 30" });
   276→              process.exit(EXIT_CODES.VALIDATION_FAILED);
   277→            }
   278→            dryTimeoutOverride = parsed.value;
   279→          }
   280→          let dryBudgetOverride: number | undefined;
   281→          if (opts.budget) {
   282→            const parsed = parseIntOption(opts.budget, { min: 1, max: 99999, name: "Budget" });
   283→            if (!parsed.ok) {
   284→              error(`Invalid --budget value: ${parsed.error}`, { suggestion: "Example: --budget 10" });
   285→              process.exit(EXIT_CODES.VALIDATION_FAILED);
   286→            }
   287→            dryBudgetOverride = parsed.value;
   288→          }
   289→
   290→          const effectiveTimeoutMinutes = dryTimeoutOverride ?? agentDef.budget?.timeout_minutes;
   291→          const effectiveMaxTasks = dryBudgetOverride ?? agentDef.budget?.max_tasks;
   292→
   293→          // AC: @trait-dry-run ac-6 - JSON output includes dry_run field
   294→          output(
   295→            {
   296→              dry_run: true,
   297→              agent_id: agentId,
   298→              adapter: adapterId,
   299→              task_ref: taskRef ?? null,
   300→              timeout_minutes: effectiveTimeoutMinutes ?? null,
   301→              max_tasks: effectiveMaxTasks ?? null,
   302→              prompt: fullPromptForPreview,
   303→            },
   304→            () => {
   305→              console.log(chalk.yellow("DRY RUN - No agent will be spawned"));
   306→              console.log();
   307→              console.log(chalk.gray(`Agent:   ${agentId}`));
   308→              console.log(chalk.gray(`Adapter: ${adapterId}`));
   309→              if (taskRef) {
   310→                console.log(chalk.gray(`Task:    ${taskRef}`));
   311→              }
   312→              if (effectiveTimeoutMinutes !== undefined) {
   313→                console.log(chalk.gray(`Timeout: ${effectiveTimeoutMinutes} min`));
   314→              }
   315→              console.log();
   316→              console.log(chalk.gray("--- Prompt that would be sent ---"));
   317→              console.log(fullPromptForPreview);
   318→              console.log(chalk.gray("--- End prompt ---"));
   319→            },
   320→          );
   321→          return;
   322→        }
   323→
   324→        // AC: @cli-agent-commands ac-2 - one-shot invocation with task binding
   325→        // AC: @cli-agent-commands ac-3 - one-shot invocation with custom prompt (no task binding)
   326→        // AC: @cli-agent-commands ac-7 - CLI overrides agent defaults
   327→        let timeoutOverride: number | undefined;
   328→        if (opts.timeout) {
   329→          const parsed = parseIntOption(opts.timeout, { min: 1, max: 10080, name: "Timeout" });
   330→          if (!parsed.ok) {
   331→            error(`Invalid --timeout value: ${parsed.error}`, { suggestion: "Example: --timeout 30" });
   332→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   333→          }
   334→          timeoutOverride = parsed.value;
   335→        }
   336→        let budgetOverride: number | undefined;
   337→        if (opts.budget) {
   338→          const parsed = parseIntOption(opts.budget, { min: 1, max: 99999, name: "Budget" });
   339→          if (!parsed.ok) {
   340→            error(`Invalid --budget value: ${parsed.error}`, { suggestion: "Example: --budget 10" });
   341→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   342→          }
   343→          budgetOverride = parsed.value;
   344→        }
   345→
   346→        const effectiveAgent = {
   347→          ...agentDef,
   348→          adapter: adapterId,
   349→          budget: timeoutOverride !== undefined || budgetOverride !== undefined
   350→            ? {
   351→                ...agentDef.budget,
   352→                timeout_minutes: timeoutOverride ?? agentDef.budget?.timeout_minutes,
   353→                max_tasks: budgetOverride ?? agentDef.budget?.max_tasks,
   354→              }
   355→            : agentDef.budget,
   356→        };
   357→
   358→        console.log(chalk.gray(`Running agent "${agentId}"...`));
   359→
   360→        // AC: @cli-agent-commands ac-3 - no task binding when --task not provided
   361→        // Pass basePrompt (not fullPromptForPreview) — runInvocation expands skills internally
   362→        const result = await runInvocation({
   363→          agent: effectiveAgent,
   364→          specDir: ctx.specDir,
   365→          cwd: ctx.rootDir,
   366→          taskRef: taskRef ?? undefined,
   367→          prompt: basePrompt,
   368→          trigger: "manual",
   369→        });
   370→
   371→        output(
   372→          {
   373→            outcome: result.outcome,
   374→            session_id: result.session.id,
   375→            duration_ms: result.durationMs,
   376→            stop_reason: result.stopReason,
   377→          },
   378→          () => {
   379→            if (result.outcome === "success") {
   380→              success(`Agent invocation completed`, {
   381→                session: result.session.id,
   382→                duration: `${Math.round(result.durationMs / 1000)}s`,
   383→              });
   384→            } else {
   385→              error(`Agent invocation ${result.outcome}: ${result.error ?? "unknown"}`);
   386→            }
   387→          },
   388→        );
   389→
   390→        if (result.outcome !== "success") {
   391→          process.exit(EXIT_CODES.ERROR);
   392→        }
   393→      } catch (err) {
   394→        error("Failed to run agent", err);
   395→        process.exit(EXIT_CODES.ERROR);
   396→      }
   397→    });
   398→
   399→  // ─── kspec agent status ───────────────────────────────────────────────────
   400→
   401→  // AC: @cli-agent-commands ac-6
   402→  agent
   403→    .command("status")
   404→    .description("Show active and queued agent invocations")
   405→    .option("--json", "Output as JSON")
   406→    .action(async (opts) => {
   407→      try {
   408→        const daemonConn = getDaemonUrl();
   409→
   410→        // AC: @trait-error-guidance ac-1, ac-2
   411→        if (!daemonConn) {
   412→          error(
   413→            "Daemon is not running. Cannot retrieve agent status.",
   414→            { suggestion: "Start the daemon with: kspec serve" },
   415→          );
   416→          process.exit(EXIT_CODES.ERROR);
   417→        }
   418→
   419→        const ctx = await initContext();
   420→
   421→        const headers: Record<string, string> = {};
   422→        if (ctx.rootDir) {
   423→          headers["X-Kspec-Dir"] = ctx.rootDir;
   424→        }
   425→
   426→        const response = await fetch(`${daemonConn.url}/api/agent/dispatch/status`, { headers });
   427→        if (!response.ok) {
   428→          error(`Daemon returned error: ${response.status} ${response.statusText}`);
   429→          process.exit(EXIT_CODES.ERROR);
   430→        }
   431→
   432→        // AC: @cli-agent-commands ac-6
   433→        const data = await response.json() as {
   434→          running: boolean;
   435→          activeInvocations: number;
   436→          queuedInvocations: number;
   437→          invocations: Array<{
   438→            invocationId: string;
   439→            sessionId: string;
   440→            agentId: string;
   441→            agentName: string;
   442→            taskRef: string | undefined;
   443→            elapsedMs: number;
   444→          }>;
   445→          queued: Array<{
   446→            agentId: string;
   447→            agentName: string;
   448→            taskRef: string | undefined;
   449→            waitMs: number;
   450→          }>;
   451→        };
   452→
   453→        output(data, () => {
   454→          console.log(chalk.bold("Agent Status"));
   455→          console.log();
   456→          console.log(`  Dispatch engine: ${data.running ? chalk.green("running") : chalk.gray("stopped")}`);
   457→          console.log(`  Active invocations: ${chalk.cyan(String(data.activeInvocations))}`);
   458→          console.log(`  Queued invocations: ${chalk.cyan(String(data.queuedInvocations))}`);
   459→
   460→          const invocations = data.invocations ?? [];
   461→          if (invocations.length > 0) {
   462→            console.log();
   463→            console.log(chalk.bold("Active:"));
   464→            for (const inv of invocations) {
   465→              const elapsed = Math.round(inv.elapsedMs / 1000);
   466→              const taskStr = inv.taskRef ? `  task: ${chalk.yellow(inv.taskRef)}` : "";
   467→              console.log(`  ${chalk.cyan(inv.agentId)}  ${chalk.gray(inv.agentName)}`);
   468→              console.log(`    session: ${chalk.gray(inv.sessionId)}  elapsed: ${elapsed}s${taskStr}`);
   469→            }
   470→          }
   471→
   472→          const queuedItems = data.queued ?? [];
   473→          if (queuedItems.length > 0) {
   474→            console.log();
   475→            console.log(chalk.bold("Queued:"));
   476→            for (const q of queuedItems) {
   477→              const wait = Math.round(q.waitMs / 1000);
   478→              const taskStr = q.taskRef ? `  task: ${chalk.yellow(q.taskRef)}` : "";
   479→              console.log(`  ${chalk.cyan(q.agentId)}  ${chalk.gray(q.agentName)}`);
   480→              console.log(`    waiting: ${wait}s${taskStr}`);
   481→            }
   482→          }
   483→        });
   484→      } catch (err) {
   485→        error("Failed to get agent status", err);
   486→        process.exit(EXIT_CODES.ERROR);
   487→      }
   488→    });
   489→
   490→  // ─── kspec agent dispatch ─────────────────────────────────────────────────
   491→
   492→  const dispatch = agent
   493→    .command("dispatch")
   494→    .description("Manage the agent dispatch engine");
   495→
   496→  // AC: @cli-agent-commands ac-4
   497→  // AC: @cli-agent-commands ac-10
   498→  dispatch
   499→    .command("start")
   500→    .description("Start the dispatch engine (daemon must be running)")
   501→    .option("--json", "Output as JSON")
   502→    .action(async (opts) => {
   503→      try {
   504→        const daemonConn = getDaemonUrl();
   505→
   506→        // AC: @cli-agent-commands ac-10 - error when daemon not running
   507→        if (!daemonConn) {
   508→          error(
   509→            "Daemon is not running. The dispatch engine requires the daemon.",
   510→            { suggestion: "Start the daemon first with: kspec serve" },
   511→          );
   512→          process.exit(EXIT_CODES.ERROR);
   513→        }
   514→
   515→        const ctx = await initContext();
   516→
   517→        const headers: Record<string, string> = {
   518→          "Content-Type": "application/json",
   519→        };
   520→        if (ctx.rootDir) {
   521→          headers["X-Kspec-Dir"] = ctx.rootDir;
   522→        }
   523→
   524→        const response = await fetch(`${daemonConn.url}/api/agent/dispatch/start`, {
   525→          method: "POST",
   526→          headers,
   527→        });
   528→
   529→        if (!response.ok) {
   530→          const body = await response.text();
   531→          error(`Failed to start dispatch engine: ${response.status} - ${body}`);
   532→          process.exit(EXIT_CODES.ERROR);
   533→        }
   534→
   535→        const data = await response.json() as {
   536→          started: boolean;
   537→          reason?: string;
   538→          status?: { running: boolean; activeInvocations: number; queuedInvocations: number };
   539→        };
   540→
   541→        output(data, () => {
   542→          if (data.started) {
   543→            success("Dispatch engine started");
   544→          } else {
   545→            console.log(chalk.yellow(`Dispatch engine: ${data.reason ?? "already running"}`));
   546→          }
   547→        });
   548→      } catch (err) {
   549→        error("Failed to start dispatch engine", err);
   550→        process.exit(EXIT_CODES.ERROR);
   551→      }
   552→    });
   553→
   554→  // AC: @cli-agent-commands ac-5
   555→  dispatch
   556→    .command("stop")
   557→    .description("Stop the dispatch engine gracefully")
   558→    .option("--json", "Output as JSON")
   559→    .action(async (opts) => {
   560→      try {
   561→        const daemonConn = getDaemonUrl();
   562→
   563→        if (!daemonConn) {
   564→          error(
   565→            "Daemon is not running.",
   566→            { suggestion: "Start the daemon with: kspec serve" },
   567→          );
   568→          process.exit(EXIT_CODES.ERROR);
   569→        }
   570→
   571→        const ctx = await initContext();
   572→
   573→        const headers: Record<string, string> = {
   574→          "Content-Type": "application/json",
   575→        };
   576→        if (ctx.rootDir) {
   577→          headers["X-Kspec-Dir"] = ctx.rootDir;
   578→        }
   579→
   580→        const response = await fetch(`${daemonConn.url}/api/agent/dispatch/stop`, {
   581→          method: "POST",
   582→          headers,
   583→        });
   584→
   585→        if (!response.ok) {
   586→          const body = await response.text();
   587→          error(`Failed to stop dispatch engine: ${response.status} - ${body}`);
   588→          process.exit(EXIT_CODES.ERROR);
   589→        }
   590→
   591→        const data = await response.json() as { stopped: boolean; reason?: string };
   592→
   593→        output(data, () => {
   594→          if (data.stopped) {
   595→            success("Dispatch engine stopped");
   596→          } else {
   597→            console.log(chalk.yellow(`Dispatch engine: ${data.reason ?? "not running"}`));
   598→          }
   599→        });
   600→      } catch (err) {
   601→        error("Failed to stop dispatch engine", err);
   602→        process.exit(EXIT_CODES.ERROR);
   603→      }
   604→    });
   605→
   606→  // AC: @cli-agent-commands ac-9
   607→  dispatch
   608→    .command("status")
   609→    .description("Show dispatch engine status and loaded agents")
   610→    .option("--json", "Output as JSON")
   611→    .action(async (opts) => {
   612→      try {
   613→        const daemonConn = getDaemonUrl();
   614→
   615→        if (!daemonConn) {
   616→          // Daemon not running — show as disabled
   617→          output(
   618→            { running: false, activeInvocations: 0, queuedInvocations: 0, agents: [] },
   619→            () => {
   620→              console.log(chalk.bold("Dispatch Status"));
   621→              console.log();
   622→              console.log(`  Dispatch engine: ${chalk.gray("not available (daemon offline)")}`);
   623→              console.log(chalk.gray("  Start daemon with: kspec serve"));
   624→            },
   625→          );
   626→          return;
   627→        }
   628→
   629→        const ctx = await initContext();
   630→
   631→        const headers: Record<string, string> = {};
   632→        if (ctx.rootDir) {
   633→          headers["X-Kspec-Dir"] = ctx.rootDir;
   634→        }
   635→
   636→        // Get dispatch status
   637→        const statusResponse = await fetch(`${daemonConn.url}/api/agent/dispatch/status`, { headers });
   638→        if (!statusResponse.ok) {
   639→          error(`Daemon returned error: ${statusResponse.status}`);
   640→          process.exit(EXIT_CODES.ERROR);
   641→        }
   642→
   643→        const statusData = await statusResponse.json() as {
   644→          running: boolean;
   645→          activeInvocations: number;
   646→          queuedInvocations: number;
   647→        };
   648→
   649→        // Get loaded agents
   650→        let agents: Array<{ id: string; name: string }> = [];
   651→        try {
   652→          const meta = await loadMetaContext(ctx);
   653→          agents = meta.agents.map((a) => ({ id: a.id, name: a.name }));
   654→        } catch {
   655→          // Meta may not be available
   656→        }
   657→
   658→        const fullData = { ...statusData, agents };
   659→
   660→        output(fullData, () => {
   661→          console.log(chalk.bold("Dispatch Status"));
   662→          console.log();
   663→          console.log(`  Engine:             ${statusData.running ? chalk.green("enabled") : chalk.yellow("disabled")}`);
   664→          console.log(`  Active invocations: ${chalk.cyan(String(statusData.activeInvocations))}`);
   665→          console.log(`  Queued invocations: ${chalk.cyan(String(statusData.queuedInvocations))}`);
   666→          console.log();
   667→          console.log(chalk.bold("Loaded Agents:"));
   668→          if (agents.length === 0) {
   669→            console.log(chalk.gray("  (none defined)"));
   670→          } else {
   671→            for (const a of agents) {
   672→              console.log(`  ${chalk.cyan(a.id)}  ${chalk.gray(a.name)}`);
   673→            }
   674→          }
   675→        });
   676→      } catch (err) {
   677→        error("Failed to get dispatch status", err);
   678→        process.exit(EXIT_CODES.ERROR);
   679→      }
   680→    });
   681→}
