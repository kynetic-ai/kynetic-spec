```
     1→/**
     2→ * Agent Dispatch Engine
     3→ *
     4→ * Core dispatch runtime for the daemon. Watches for task state changes via
     5→ * file watcher events and direct API event emission from CLI commands. Matches
     6→ * state changes against agent dispatch rules, queues invocations, manages
     7→ * concurrency, and handles deduplication of events from dual sources.
     8→ * Serializes shadow branch mutations when multiple agents run concurrently.
     9→ *
    10→ * AC: @agent-dispatch-engine ac-1 through ac-12
    11→ */
    12→
    13→import * as path from "node:path";
    14→import { spawnSync } from "node:child_process";
    15→import { ulid } from "ulid";
    16→import {
    17→  initContext,
    18→  loadAllTasks,
    19→  loadMetaContext,
    20→  type LoadedTask,
    21→  type LoadedAgent,
    22→} from "../parser/index.js";
    23→import { runInvocation } from "./invocation.js";
    24→import type { InvocationOptions } from "./invocation.js";
    25→import { getAdapter } from "../agents/adapters.js";
    26→import type { AgentDispatchRule } from "../schema/meta.js";
    27→import type { SessionTrigger } from "../sessions/types.js";
    28→
    29→// ─── Simple Mutex ─────────────────────────────────────────────────────────────
    30→
    31→/**
    32→ * A minimal promise-based mutex for serializing async operations.
    33→ * AC: @agent-dispatch-engine ac-12
    34→ */
    35→class Mutex {
    36→  private _queue: Array<() => void> = [];
    37→  private _locked = false;
    38→
    39→  async runExclusive<T>(fn: () => Promise<T>): Promise<T> {
    40→    await this._acquire();
    41→    try {
    42→      return await fn();
    43→    } finally {
    44→      this._release();
    45→    }
    46→  }
    47→
    48→  private _acquire(): Promise<void> {
    49→    if (!this._locked) {
    50→      this._locked = true;
    51→      return Promise.resolve();
    52→    }
    53→    return new Promise<void>((resolve) => {
    54→      this._queue.push(resolve);
    55→    });
    56→  }
    57→
    58→  private _release(): void {
    59→    const next = this._queue.shift();
    60→    if (next) {
    61→      next();
    62→    } else {
    63→      this._locked = false;
    64→    }
    65→  }
    66→}
    67→
    68→// ─── Types ────────────────────────────────────────────────────────────────────
    69→
    70→/**
    71→ * Task state as used for dispatch tracking.
    72→ */
    73→export type TaskStatus =
    74→  | "pending"
    75→  | "in_progress"
    76→  | "pending_review"
    77→  | "needs_work"
    78→  | "blocked"
    79→  | "completed"
    80→  | "cancelled";
    81→
    82→/**
    83→ * Mapping from dispatch event names to task statuses.
    84→ * AC: @agent-dispatch-engine ac-1
    85→ */
    86→const EVENT_TO_STATUS: Record<string, TaskStatus> = {
    87→  "task.ready": "pending",
    88→  "task.needs_work": "needs_work",
    89→  "task.pending_review": "pending_review",
    90→};
    91→
    92→const STATUS_TO_EVENT: Record<TaskStatus, string | undefined> = {
    93→  pending: "task.ready",
    94→  needs_work: "task.needs_work",
    95→  pending_review: "task.pending_review",
    96→  in_progress: undefined,
    97→  blocked: undefined,
    98→  completed: undefined,
    99→  cancelled: undefined,
   100→};
   101→
   102→/**
   103→ * A state change event for a single task.
   104→ */
   105→export interface TaskStateChange {
   106→  taskId: string;
   107→  taskRef: string;
   108→  fromStatus: TaskStatus;
   109→  toStatus: TaskStatus;
   110→  timestamp: number;
   111→  /** Optional task data used for filter evaluation (AC-6) */
   112→  task?: LoadedTask;
   113→}
   114→
   115→/**
   116→ * An entry in the dispatch queue.
   117→ */
   118→interface QueueEntry {
   119→  agent: LoadedAgent;
   120→  change: TaskStateChange;
   121→  retryCount: number;
   122→  nextRetryAt: number;
   123→  /** When this entry was first enqueued (for wait-time display) */
   124→  enqueuedAtMs: number;
   125→}
   126→
   127→/**
   128→ * Tracking record for an active invocation.
   129→ * AC: @cli-agent-commands ac-6
   130→ */
   131→interface ActiveInvocationRecord {
   132→  invocationId: string;
   133→  sessionId: string;
   134→  agentId: string;
   135→  agentName: string;
   136→  taskRef: string | undefined;
   137→  startedAtMs: number;
   138→}
   139→
   140→/**
   141→ * Deduplication key for recent state changes.
   142→ * AC: @agent-dispatch-engine ac-7
   143→ */
   144→type DedupKey = `${string}:${string}:${string}`;
   145→
   146→/**
   147→ * Options for creating a DispatchEngine.
   148→ */
   149→export interface DispatchEngineOptions {
   150→  /** Project root directory */
   151→  projectDir: string;
   152→  /**
   153→   * Spec directory (.kspec/ for shadow mode, or same as projectDir for traditional mode).
   154→   * Defaults to projectDir/.kspec if not specified.
   155→   */
   156→  specDir?: string;
   157→  /** Working directory for spawned agents */
   158→  cwd?: string;
   159→  /** Deduplication window in milliseconds (default 2000) */
   160→  dedupWindowMs?: number;
   161→  /** Path to kspec CLI binary (for task notes) */
   162→  kspecCliPath?: string;
   163→}
   164→
   165→// ─── DispatchEngine ───────────────────────────────────────────────────────────
   166→
   167→/**
   168→ * The core dispatch runtime.
   169→ *
   170→ * Lifecycle:
   171→ *   1. Create with new DispatchEngine(options)
   172→ *   2. Call start() to bootstrap and begin processing
   173→ *   3. Feed state changes via handleStateChange()
   174→ *   4. Call stop() for graceful shutdown
   175→ *
   176→ * AC: @agent-dispatch-engine ac-1 through ac-12
   177→ */
   178→export class DispatchEngine {
   179→  private projectDir: string;
   180→  private specDir: string;
   181→  private cwd: string;
   182→  private dedupWindowMs: number;
   183→  private kspecCliPath?: string;
   184→
   185→  /** Queue of pending dispatch entries, per agent id */
   186→  private queues: Map<string, QueueEntry[]> = new Map();
   187→  /** Count of active (running) invocations per agent id */
   188→  private activeCount: Map<string, number> = new Map();
   189→  /** Recent dedup keys with their expiry timestamps */
   190→  private recentEvents: Map<DedupKey, number> = new Map();
   191→  /** Previous task states (for file watcher diffing) */
   192→  private prevTaskStates: Map<string, TaskStatus> = new Map();
   193→  /** Mutex serializing shadow branch mutations */
   194→  private shadowMutex = new Mutex();
   195→  /** Whether the engine is currently running */
   196→  private running = false;
   197→  /** Set of running invocation promises (for graceful shutdown) */
   198→  private runningInvocations: Set<Promise<void>> = new Set();
   199→  /** AbortControllers for active invocations (for graceful cancel on stop) */
   200→  private invocationAbortControllers: Set<AbortController> = new Set();
   201→  /** Per-invocation tracking records for status display */
   202→  private activeInvocationDetails: Map<string, ActiveInvocationRecord> = new Map();
   203→
   204→  constructor(options: DispatchEngineOptions) {
   205→    this.projectDir = options.projectDir;
   206→    this.specDir = options.specDir ?? path.join(options.projectDir, ".kspec");
   207→    this.cwd = options.cwd ?? options.projectDir;
   208→    this.dedupWindowMs = options.dedupWindowMs ?? 2000;
   209→    this.kspecCliPath = options.kspecCliPath;
   210→  }
   211→
   212→  // ─── Public API ─────────────────────────────────────────────────────────────
   213→
   214→  /**
   215→   * Start the dispatch engine.
   216→   *
   217→   * Loads current task states and evaluates dispatch rules for bootstrap.
   218→   * AC: @agent-dispatch-engine ac-8
   219→   */
   220→  async start(): Promise<void> {
   221→    this.running = true;
   222→
   223→    // AC: @agent-dispatch-engine ac-8 - Bootstrap: evaluate existing task states
   224→    await this._bootstrap();
   225→  }
   226→
   227→  /**
   228→   * Handle a task state change event from any source (file watcher or API).
   229→   *
   230→   * AC: @agent-dispatch-engine ac-1, ac-2, ac-4, ac-5, ac-6, ac-7
   231→   */
   232→  async handleStateChange(change: TaskStateChange): Promise<void> {
   233→    if (!this.running) return;
   234→
   235→    // AC: @agent-dispatch-engine ac-7 - Deduplication
   236→    if (this._isDuplicate(change)) {
   237→      return;
   238→    }
   239→    this._recordEvent(change);
   240→
   241→    // AC: @agent-dispatch-engine ac-1 - Match against dispatch rules
   242→    const agents = await this._loadAgents();
   243→    const eventType = STATUS_TO_EVENT[change.toStatus];
   244→    if (!eventType) return;
   245→
   246→    // Load task data for filter evaluation if not provided
   247→    let taskData = change.task;
   248→    if (!taskData && change.taskId) {
   249→      try {
   250→        const ctx = await initContext(this.projectDir);
   251→        const tasks = await loadAllTasks(ctx);
   252→        taskData = tasks.find((t) => t._ulid === change.taskId);
   253→      } catch {
   254→        // Can't load task, filter evaluation will be lenient
   255→      }
   256→    }
   257→
   258→    for (const agent of agents) {
   259→      for (const rule of (agent.dispatch ?? [])) {
   260→        if (rule.on !== eventType) continue;
   261→
   262→        // AC: @agent-dispatch-engine ac-6 - Apply filters
   263→        if (!this._matchesFilter(change, rule, taskData)) continue;
   264→
   265→        // AC: @agent-dispatch-engine ac-2 - Each matching agent queued independently
   266→        this._enqueue(agent, change);
   267→      }
   268→    }
   269→
   270→    // Drain queues after enqueuing
   271→    await this._drainQueues(agents);
   272→  }
   273→
   274→  /**
   275→   * Handle file watcher notification: diff previous vs current task states.
   276→   *
   277→   * AC: @agent-dispatch-engine ac-5
   278→   */
   279→  async handleFileChange(specDir: string): Promise<void> {
   280→    if (!this.running) return;
   281→
   282→    try {
   283→      const ctx = await initContext(this.projectDir);
   284→      const tasks = await loadAllTasks(ctx);
   285→
   286→      const changes: TaskStateChange[] = [];
   287→      const now = Date.now();
   288→
   289→      for (const task of tasks) {
   290→        const taskId = task._ulid;
   291→        const currentStatus = task.status as TaskStatus;
   292→        const prevStatus = this.prevTaskStates.get(taskId);
   293→
   294→        if (prevStatus !== undefined && prevStatus !== currentStatus) {
   295→          changes.push({
   296→            taskId,
   297→            taskRef: `@${taskId}`,
   298→            fromStatus: prevStatus,
   299→            toStatus: currentStatus,
   300→            timestamp: now,
   301→            task,
   302→          });
   303→        }
   304→
   305→        this.prevTaskStates.set(taskId, currentStatus);
   306→      }
   307→
   308→      // Emit change events for detected transitions
   309→      for (const change of changes) {
   310→        await this.handleStateChange(change);
   311→      }
   312→    } catch (err) {
   313→      console.error("[dispatch] Error processing file change:", err);
   314→    }
   315→  }
   316→
   317→  /**
   318→   * Stop the dispatch engine gracefully.
   319→   *
   320→   * Sends cancel signals to all active invocations and waits for them to finish.
   321→   * AC: @agent-dispatch-engine ac-11
   322→   */
   323→  async stop(): Promise<void> {
   324→    this.running = false;
   325→
   326→    // AC: @agent-dispatch-engine ac-11 - Send graceful cancel to all active invocations
   327→    for (const controller of this.invocationAbortControllers) {
   328→      controller.abort();
   329→    }
   330→
   331→    // Wait for all running invocations to complete (or abort)
   332→    if (this.runningInvocations.size > 0) {
   333→      await Promise.allSettled(Array.from(this.runningInvocations));
   334→    }
   335→
   336→    this.queues.clear();
   337→    this.activeCount.clear();
   338→    this.recentEvents.clear();
   339→    this.invocationAbortControllers.clear();
   340→    this.activeInvocationDetails.clear();
   341→  }
   342→
   343→  /**
   344→   * Get the shadow mutex for external callers that need to serialize mutations.
   345→   * AC: @agent-dispatch-engine ac-12
   346→   */
   347→  getShadowMutex(): Mutex {
   348→    return this.shadowMutex;
   349→  }
   350→
   351→  /**
   352→   * Returns current engine status info including per-invocation details.
   353→   * AC: @cli-agent-commands ac-6
   354→   */
   355→  getStatus(): {
   356→    running: boolean;
   357→    activeInvocations: number;
   358→    queuedInvocations: number;
   359→    invocations: Array<{
   360→      invocationId: string;
   361→      sessionId: string;
   362→      agentId: string;
   363→      agentName: string;
   364→      taskRef: string | undefined;
   365→      elapsedMs: number;
   366→    }>;
   367→    queued: Array<{
   368→      agentId: string;
   369→      agentName: string;
   370→      taskRef: string | undefined;
   371→      waitMs: number;
   372→    }>;
   373→  } {
   374→    let active = 0;
   375→    let queued = 0;
   376→    for (const count of this.activeCount.values()) active += count;
   377→    for (const entries of this.queues.values()) queued += entries.length;
   378→    const now = Date.now();
   379→    const invocations = Array.from(this.activeInvocationDetails.values()).map((r) => ({
   380→      invocationId: r.invocationId,
   381→      sessionId: r.sessionId,
   382→      agentId: r.agentId,
   383→      agentName: r.agentName,
   384→      taskRef: r.taskRef,
   385→      elapsedMs: now - r.startedAtMs,
   386→    }));
   387→    const queuedItems = Array.from(this.queues.values()).flatMap((entries) =>
   388→      entries.map((e) => ({
   389→        agentId: e.agent.id,
   390→        agentName: e.agent.name,
   391→        taskRef: e.change.taskRef,
   392→        waitMs: now - e.enqueuedAtMs,
   393→      })),
   394→    );
   395→    return { running: this.running, activeInvocations: active, queuedInvocations: queued, invocations, queued: queuedItems };
   396→  }
   397→
   398→  // ─── Private helpers ─────────────────────────────────────────────────────────
   399→
   400→  /**
   401→   * Bootstrap: evaluate all current tasks against dispatch rules.
   402→   * AC: @agent-dispatch-engine ac-8
   403→   */
   404→  private async _bootstrap(): Promise<void> {
   405→    try {
   406→      const ctx = await initContext(this.projectDir);
   407→      const tasks = await loadAllTasks(ctx);
   408→      const agents = await this._loadAgents();
   409→      const now = Date.now();
   410→
   411→      // Seed prevTaskStates so subsequent file watcher diffs work correctly
   412→      for (const task of tasks) {
   413→        this.prevTaskStates.set(task._ulid, task.status as TaskStatus);
   414→      }
   415→
   416→      // Evaluate each task against each agent's dispatch rules
   417→      for (const task of tasks) {
   418→        const currentStatus = task.status as TaskStatus;
   419→        const eventType = STATUS_TO_EVENT[currentStatus];
   420→        if (!eventType) continue;
   421→
   422→        for (const agent of agents) {
   423→          for (const rule of (agent.dispatch ?? [])) {
   424→            if (rule.on !== eventType) continue;
   425→
   426→            const change: TaskStateChange = {
   427→              taskId: task._ulid,
   428→              taskRef: `@${task._ulid}`,
   429→              fromStatus: currentStatus, // bootstrap: treated as "just entered"
   430→              toStatus: currentStatus,
   431→              timestamp: now,
   432→              task,
   433→            };
   434→
   435→            if (!this._matchesFilter(change, rule, task)) continue;
   436→
   437→            this._enqueue(agent, change);
   438→          }
   439→        }
   440→      }
   441→
   442→      await this._drainQueues(agents);
   443→    } catch (err) {
   444→      console.error("[dispatch] Bootstrap error:", err);
   445→    }
   446→  }
   447→
   448→  /**
   449→   * Load agent definitions from meta context.
   450→   */
   451→  private async _loadAgents(): Promise<LoadedAgent[]> {
   452→    try {
   453→      const ctx = await initContext(this.projectDir);
   454→      const meta = await loadMetaContext(ctx);
   455→      return meta.agents;
   456→    } catch {
   457→      return [];
   458→    }
   459→  }
   460→
   461→  /**
   462→   * Check if a state change matches a dispatch rule's filters.
   463→   * AC: @agent-dispatch-engine ac-6
   464→   */
   465→  private _matchesFilter(
   466→    change: TaskStateChange,
   467→    rule: AgentDispatchRule,
   468→    task?: LoadedTask,
   469→  ): boolean {
   470→    if (!rule.filter) return true;
   471→
   472→    // We need the task to evaluate filters — if not provided, reject to avoid
   473→    // enqueuing non-matching tasks (AC-6: all filters must match)
   474→    if (!task) return false;
   475→
   476→    const { filter } = rule;
   477→
   478→    // Automation filter
   479→    if (filter.automation !== undefined) {
   480→      if ((task as LoadedTask & { automation?: string }).automation !== filter.automation) {
   481→        return false;
   482→      }
   483→    }
   484→
   485→    // Tags filter
   486→    if (filter.tags && filter.tags.length > 0) {
   487→      const taskTags: string[] = (task as LoadedTask & { tags?: string[] }).tags ?? [];
   488→      if (!filter.tags.every((tag) => taskTags.includes(tag))) {
   489→        return false;
   490→      }
   491→    }
   492→
   493→    // Priority filter
   494→    if (filter.priority !== undefined) {
   495→      if ((task as LoadedTask & { priority?: number }).priority !== filter.priority) {
   496→        return false;
   497→      }
   498→    }
   499→
   500→    return true;
   501→  }
   502→
   503→  /**
   504→   * Build a deduplication key for a state change.
   505→   * AC: @agent-dispatch-engine ac-7
   506→   */
   507→  private _dedupKey(change: TaskStateChange): DedupKey {
   508→    return `${change.taskId}:${change.fromStatus}:${change.toStatus}`;
   509→  }
   510→
   511→  /**
   512→   * Check whether this event is a duplicate within the dedup window.
   513→   * AC: @agent-dispatch-engine ac-7
   514→   */
   515→  private _isDuplicate(change: TaskStateChange): boolean {
   516→    const key = this._dedupKey(change);
   517→    const expiry = this.recentEvents.get(key);
   518→    if (expiry === undefined) return false;
   519→    return change.timestamp < expiry;
   520→  }
   521→
   522→  /**
   523→   * Record a state change for deduplication.
   524→   * AC: @agent-dispatch-engine ac-7
   525→   */
   526→  private _recordEvent(change: TaskStateChange): void {
   527→    const key = this._dedupKey(change);
   528→    this.recentEvents.set(key, change.timestamp + this.dedupWindowMs);
   529→
   530→    // Prune expired entries periodically
   531→    if (this.recentEvents.size > 1000) {
   532→      const now = Date.now();
   533→      for (const [k, expiry] of this.recentEvents) {
   534→        if (expiry < now) this.recentEvents.delete(k);
   535→      }
   536→    }
   537→  }
   538→
   539→  /**
   540→   * Enqueue a dispatch entry for an agent.
   541→   * AC: @agent-dispatch-engine ac-3
   542→   */
   543→  private _enqueue(agent: LoadedAgent, change: TaskStateChange): void {
   544→    const queue = this.queues.get(agent.id) ?? [];
   545→    queue.push({ agent, change, retryCount: 0, nextRetryAt: 0, enqueuedAtMs: Date.now() });
   546→    this.queues.set(agent.id, queue);
   547→  }
   548→
   549→  /**
   550→   * Drain queues, spawning invocations up to each agent's max_concurrent limit.
   551→   * AC: @agent-dispatch-engine ac-3
   552→   */
   553→  private async _drainQueues(agents: LoadedAgent[]): Promise<void> {
   554→    // Prevent new invocation starts during/after shutdown.
   555→    if (!this.running) return;
   556→
   557→    for (const agent of agents) {
   558→      const maxConcurrent = agent.concurrency?.max_concurrent ?? 1;
   559→      const active = this.activeCount.get(agent.id) ?? 0;
   560→      const queue = this.queues.get(agent.id) ?? [];
   561→
   562→      let slots = maxConcurrent - active;
   563→      while (slots > 0 && queue.length > 0) {
   564→        const entry = queue.shift()!;
   565→        if (entry.nextRetryAt > Date.now()) {
   566→          // Not ready for retry yet; put back at front
   567→          queue.unshift(entry);
   568→          break;
   569→        }
   570→        const spawned = this._spawnInvocation(agent, entry);
   571→        if (spawned) slots--;
   572→      }
   573→
   574→      this.queues.set(agent.id, queue);
   575→    }
   576→  }
   577→
   578→  /**
   579→   * Spawn a single invocation for a queue entry.
   580→   * Returns true if an invocation was actually started, false if skipped.
   581→   * AC: @agent-dispatch-engine ac-9, ac-10, ac-11, ac-12
   582→   */
   583→  private _spawnInvocation(agent: LoadedAgent, entry: QueueEntry): boolean {
   584→    const agentId = agent.id;
   585→
   586→    // Increment active count
   587→    this.activeCount.set(agentId, (this.activeCount.get(agentId) ?? 0) + 1);
   588→
   589→    // AC: @agent-dispatch-engine ac-10 - Check adapter resolvability before spawn
   590→    const adapterId = agent.adapter ?? "claude-agent-acp";
   591→    const adapter = getAdapter(adapterId);
   592→    if (!adapter) {
   593→      console.error(
   594→        `[dispatch] Cannot resolve adapter "${adapterId}" for agent "${agentId}". Skipping invocation.`,
   595→      );
   596→      // Decrement active count since we're not actually running
   597→      const currentActive = this.activeCount.get(agentId) ?? 1;
   598→      this.activeCount.set(agentId, Math.max(0, currentActive - 1));
   599→      // AC: @agent-dispatch-engine ac-10 - Add task note for unresolvable adapter
   600→      if (this.kspecCliPath) {
   601→        spawnSync(process.execPath, [
   602→          this.kspecCliPath,
   603→          "task", "note", entry.change.taskRef,
   604→          `[AGENT-SKIP] Cannot resolve adapter "${adapterId}" for agent "${agentId}". Invocation skipped.`,
   605→        ], { cwd: this.cwd });
   606→      }
   607→      return false;
   608→    }
   609→
   610→    // AC: @agent-dispatch-engine ac-11 - Create abort controller for graceful cancellation
   611→    const abortController = new AbortController();
   612→    this.invocationAbortControllers.add(abortController);
   613→
   614→    // AC: @cli-agent-commands ac-6 - Pre-assign session ID for status tracking
   615→    const preSessionId = ulid();
   616→    const invocationId = ulid();
   617→    const trackingRecord: ActiveInvocationRecord = {
   618→      invocationId,
   619→      sessionId: preSessionId,
   620→      agentId,
   621→      agentName: agent.name,
   622→      taskRef: entry.change.taskRef,
   623→      startedAtMs: Date.now(),
   624→    };
   625→    this.activeInvocationDetails.set(invocationId, trackingRecord);
   626→
   627→    const options: InvocationOptions = {
   628→      agent,
   629→      specDir: this.specDir,
   630→      cwd: this.cwd,
   631→      taskRef: entry.change.taskRef,
   632→      prompt: agent.prompt_template ?? `Work on task ${entry.change.taskRef}`,
   633→      trigger: (STATUS_TO_EVENT[entry.change.toStatus] ?? "task.ready") as SessionTrigger,
   634→      kspecCliPath: this.kspecCliPath,
   635→      abortSignal: abortController.signal,
   636→      sessionId: preSessionId,
   637→    };
   638→
   639→    // AC: @agent-dispatch-engine ac-12 - Wrap invocation in shadow mutex
   640→    const invocationPromise = this.shadowMutex
   641→      .runExclusive(async () => {
   642→        // AC: @agent-dispatch-engine ac-9 - Retry on transient errors
   643→        try {
   644→          await runInvocation(options);
   645→          // Reset retry count on success
   646→          entry.retryCount = 0;
   647→        } catch (err) {
   648→          const retryLimit = agent.budget?.max_tasks ?? 3;
   649→          if (entry.retryCount < retryLimit) {
   650→            entry.retryCount++;
   651→            const backoffMs = Math.min(
   652→              1000 * Math.pow(2, entry.retryCount - 1),
   653→              30_000,
   654→            );
   655→            entry.nextRetryAt = Date.now() + backoffMs;
   656→            console.warn(
   657→              `[dispatch] Invocation for agent "${agentId}" failed (attempt ${entry.retryCount}/${retryLimit}), retrying in ${backoffMs}ms`,
   658→              err,
   659→            );
   660→            // Re-enqueue at front for retry
   661→            const queue = this.queues.get(agentId) ?? [];
   662→            queue.unshift(entry);
   663→            this.queues.set(agentId, queue);
   664→            // AC: @agent-dispatch-engine ac-9 - Schedule wake-up to drain retry
   665→            setTimeout(() => {
   666→              if (this.running) {
   667→                this._loadAgents()
   668→                  .then((agents) => this._drainQueues(agents))
   669→                  .catch(() => {/* best effort */});
   670→              }
   671→            }, backoffMs);
   672→          } else {
   673→            console.error(
   674→              `[dispatch] Agent "${agentId}" exceeded retry limit. Dropping invocation.`,
   675→              err,
   676→            );
   677→          }
   678→        }
   679→      })
   680→      .then(async () => {
   681→        // Decrement active count and drain again
   682→        const currentActive = this.activeCount.get(agentId) ?? 1;
   683→        this.activeCount.set(agentId, Math.max(0, currentActive - 1));
   684→
   685→        if (!this.running) return;
   686→
   687→        // Try to drain more items
   688→        try {
   689→          const agents = await this._loadAgents();
   690→          await this._drainQueues(agents);
   691→        } catch {
   692→          // Best effort
   693→        }
   694→      })
   695→      .finally(() => {
   696→        this.runningInvocations.delete(invocationPromise);
   697→        this.invocationAbortControllers.delete(abortController);
   698→        this.activeInvocationDetails.delete(invocationId);
   699→      });
   700→
   701→    this.runningInvocations.add(invocationPromise);
   702→    return true;
   703→  }
   704→}
   705→

