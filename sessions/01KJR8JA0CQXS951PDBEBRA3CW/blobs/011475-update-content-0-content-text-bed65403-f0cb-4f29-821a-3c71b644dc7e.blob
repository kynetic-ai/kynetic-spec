```
     1→/**
     2→ * Agent Dispatch Engine
     3→ *
     4→ * Core dispatch runtime for the daemon. Watches for task state changes via
     5→ * file watcher events and direct API event emission from CLI commands. Matches
     6→ * state changes against agent dispatch rules, queues invocations, manages
     7→ * concurrency, and handles deduplication of events from dual sources.
     8→ * Serializes shadow branch mutations when multiple agents run concurrently.
     9→ *
    10→ * AC: @agent-dispatch-engine ac-1 through ac-12
    11→ */
    12→
    13→import * as path from "node:path";
    14→import { spawnSync } from "node:child_process";
    15→import { ulid } from "ulid";
    16→import {
    17→  initContext,
    18→  loadAllTasks,
    19→  loadMetaContext,
    20→  type LoadedTask,
    21→  type LoadedAgent,
    22→} from "../parser/index.js";
    23→import { runInvocation } from "./invocation.js";
    24→import type { InvocationOptions } from "./invocation.js";
    25→import { getAdapter } from "../agents/adapters.js";
    26→import type { AgentDispatchRule } from "../schema/meta.js";
    27→import type { SessionTrigger } from "../sessions/types.js";
    28→
    29→// ─── Simple Mutex ─────────────────────────────────────────────────────────────
    30→
    31→/**
    32→ * A minimal promise-based mutex for serializing async operations.
    33→ * AC: @agent-dispatch-engine ac-12
    34→ */
    35→class Mutex {
    36→  private _queue: Array<() => void> = [];
    37→  private _locked = false;
    38→
    39→  async runExclusive<T>(fn: () => Promise<T>): Promise<T> {
    40→    await this._acquire();
    41→    try {
    42→      return await fn();
    43→    } finally {
    44→      this._release();
    45→    }
    46→  }
    47→
    48→  private _acquire(): Promise<void> {
    49→    if (!this._locked) {
    50→      this._locked = true;
    51→      return Promise.resolve();
    52→    }
    53→    return new Promise<void>((resolve) => {
    54→      this._queue.push(resolve);
    55→    });
    56→  }
    57→
    58→  private _release(): void {
    59→    const next = this._queue.shift();
    60→    if (next) {
    61→      next();
    62→    } else {
    63→      this._locked = false;
    64→    }
    65→  }
    66→}
    67→
    68→// ─── Types ────────────────────────────────────────────────────────────────────
    69→
    70→/**
    71→ * Task state as used for dispatch tracking.
    72→ */
    73→export type TaskStatus =
    74→  | "pending"
    75→  | "in_progress"
    76→  | "pending_review"
    77→  | "needs_work"
    78→  | "blocked"
    79→  | "completed"
    80→  | "cancelled";
    81→
    82→/**
    83→ * Mapping from dispatch event names to task statuses.
    84→ * AC: @agent-dispatch-engine ac-1
    85→ */
    86→const EVENT_TO_STATUS: Record<string, TaskStatus> = {
    87→  "task.ready": "pending",
    88→  "task.needs_work": "needs_work",
    89→  "task.pending_review": "pending_review",
    90→};
    91→
    92→const STATUS_TO_EVENT: Record<TaskStatus, string | undefined> = {
    93→  pending: "task.ready",
    94→  needs_work: "task.needs_work",
    95→  pending_review: "task.pending_review",
    96→  in_progress: undefined,
    97→  blocked: undefined,
    98→  completed: undefined,
    99→  cancelled: undefined,
   100→};
   101→
   102→/**
   103→ * A state change event for a single task.
   104→ */
   105→export interface TaskStateChange {
   106→  taskId: string;
   107→  taskRef: string;
   108→  fromStatus: TaskStatus;
   109→  toStatus: TaskStatus;
   110→  timestamp: number;
   111→  /** Optional task data used for filter evaluation (AC-6) */
   112→  task?: LoadedTask;
   113→}
   114→
   115→/**
   116→ * An entry in the dispatch queue.
   117→ */
   118→interface QueueEntry {
   119→  agent: LoadedAgent;
   120→  change: TaskStateChange;
   121→  retryCount: number;
   122→  nextRetryAt: number;
   123→  /** When this entry was first enqueued (for wait-time display) */
   124→  enqueuedAtMs: number;
   125→}
   126→
   127→/**
   128→ * Tracking record for an active invocation.
   129→ * AC: @cli-agent-commands ac-6
   130→ */
   131→interface ActiveInvocationRecord {
   132→  invocationId: string;
   133→  sessionId: string;
   134→  agentId: string;
   135→  agentName: string;
   136→  taskRef: string | undefined;
   137→  startedAtMs: number;
   138→}
   139→
   140→/**
   141→ * Deduplication key for recent state changes.
   142→ * AC: @agent-dispatch-engine ac-7
   143→ */
   144→type DedupKey = `${string}:${string}:${string}`;
   145→
   146→/**
   147→ * Invocation lifecycle event payload.
   148→ * AC: @daemon-agent-dispatch ac-3, ac-4
   149→ */
   150→export interface InvocationEvent {
   151→  type: "started" | "completed" | "failed";
   152→  session_id: string;
   153→  agent_id: string;
   154→  task_id: string | undefined;
   155→  status: "started" | "completed" | "failed";
   156→  timestamp: number;
   157→}
   158→
   159→/**
   160→ * Options for creating a DispatchEngine.
   161→ */
   162→export interface DispatchEngineOptions {
   163→  /** Project root directory */
   164→  projectDir: string;
   165→  /**
   166→   * Spec directory (.kspec/ for shadow mode, or same as projectDir for traditional mode).
   167→   * Defaults to projectDir/.kspec if not specified.
   168→   */
   169→  specDir?: string;
   170→  /** Working directory for spawned agents */
   171→  cwd?: string;
   172→  /** Deduplication window in milliseconds (default 2000) */
   173→  dedupWindowMs?: number;
   174→  /** Path to kspec CLI binary (for task notes) */
   175→  kspecCliPath?: string;
   176→  /**
   177→   * Optional callback invoked on invocation lifecycle events (start, complete, fail).
   178→   * AC: @daemon-agent-dispatch ac-3, ac-4
   179→   */
   180→  onInvocationEvent?: (event: InvocationEvent) => void;
   181→}
   182→
   183→// ─── DispatchEngine ───────────────────────────────────────────────────────────
   184→
   185→/**
   186→ * The core dispatch runtime.
   187→ *
   188→ * Lifecycle:
   189→ *   1. Create with new DispatchEngine(options)
   190→ *   2. Call start() to bootstrap and begin processing
   191→ *   3. Feed state changes via handleStateChange()
   192→ *   4. Call stop() for graceful shutdown
   193→ *
   194→ * AC: @agent-dispatch-engine ac-1 through ac-12
   195→ */
   196→export class DispatchEngine {
   197→  private projectDir: string;
   198→  private specDir: string;
   199→  private cwd: string;
   200→  private dedupWindowMs: number;
   201→  private kspecCliPath?: string;
   202→  private onInvocationEvent?: (event: InvocationEvent) => void;
   203→
   204→  /** Queue of pending dispatch entries, per agent id */
   205→  private queues: Map<string, QueueEntry[]> = new Map();
   206→  /** Count of active (running) invocations per agent id */
   207→  private activeCount: Map<string, number> = new Map();
   208→  /** Recent dedup keys with their expiry timestamps */
   209→  private recentEvents: Map<DedupKey, number> = new Map();
   210→  /** Previous task states (for file watcher diffing) */
   211→  private prevTaskStates: Map<string, TaskStatus> = new Map();
   212→  /** Mutex serializing shadow branch mutations */
   213→  private shadowMutex = new Mutex();
   214→  /** Whether the engine is currently running */
   215→  private running = false;
   216→  /** Set of running invocation promises (for graceful shutdown) */
   217→  private runningInvocations: Set<Promise<void>> = new Set();
   218→  /** AbortControllers for active invocations (for graceful cancel on stop) */
   219→  private invocationAbortControllers: Set<AbortController> = new Set();
   220→  /** Per-invocation tracking records for status display */
   221→  private activeInvocationDetails: Map<string, ActiveInvocationRecord> = new Map();
   222→
   223→  constructor(options: DispatchEngineOptions) {
   224→    this.projectDir = options.projectDir;
   225→    this.specDir = options.specDir ?? path.join(options.projectDir, ".kspec");
   226→    this.cwd = options.cwd ?? options.projectDir;
   227→    this.dedupWindowMs = options.dedupWindowMs ?? 2000;
   228→    this.kspecCliPath = options.kspecCliPath;
   229→    this.onInvocationEvent = options.onInvocationEvent;
   230→  }
   231→
   232→  // ─── Public API ─────────────────────────────────────────────────────────────
   233→
   234→  /**
   235→   * Start the dispatch engine.
   236→   *
   237→   * Loads current task states and evaluates dispatch rules for bootstrap.
   238→   * AC: @agent-dispatch-engine ac-8
   239→   */
   240→  async start(): Promise<void> {
   241→    this.running = true;
   242→
   243→    // AC: @agent-dispatch-engine ac-8 - Bootstrap: evaluate existing task states
   244→    await this._bootstrap();
   245→  }
   246→
   247→  /**
   248→   * Handle a task state change event from any source (file watcher or API).
   249→   *
   250→   * AC: @agent-dispatch-engine ac-1, ac-2, ac-4, ac-5, ac-6, ac-7
   251→   */
   252→  async handleStateChange(change: TaskStateChange): Promise<void> {
   253→    if (!this.running) return;
   254→
   255→    // AC: @agent-dispatch-engine ac-7 - Deduplication
   256→    if (this._isDuplicate(change)) {
   257→      return;
   258→    }
   259→    this._recordEvent(change);
   260→
   261→    // AC: @agent-dispatch-engine ac-1 - Match against dispatch rules
   262→    const agents = await this._loadAgents();
   263→    const eventType = STATUS_TO_EVENT[change.toStatus];
   264→    if (!eventType) return;
   265→
   266→    // Load task data for filter evaluation if not provided
   267→    let taskData = change.task;
   268→    if (!taskData && change.taskId) {
   269→      try {
   270→        const ctx = await initContext(this.projectDir);
   271→        const tasks = await loadAllTasks(ctx);
   272→        taskData = tasks.find((t) => t._ulid === change.taskId);
   273→      } catch {
   274→        // Can't load task, filter evaluation will be lenient
   275→      }
   276→    }
   277→
   278→    for (const agent of agents) {
   279→      for (const rule of (agent.dispatch ?? [])) {
   280→        if (rule.on !== eventType) continue;
   281→
   282→        // AC: @agent-dispatch-engine ac-6 - Apply filters
   283→        if (!this._matchesFilter(change, rule, taskData)) continue;
   284→
   285→        // AC: @agent-dispatch-engine ac-2 - Each matching agent queued independently
   286→        this._enqueue(agent, change);
   287→      }
   288→    }
   289→
   290→    // Drain queues after enqueuing
   291→    await this._drainQueues(agents);
   292→  }
   293→
   294→  /**
   295→   * Handle file watcher notification: diff previous vs current task states.
   296→   *
   297→   * AC: @agent-dispatch-engine ac-5
   298→   */
   299→  async handleFileChange(specDir: string): Promise<void> {
   300→    if (!this.running) return;
   301→
   302→    try {
   303→      const ctx = await initContext(this.projectDir);
   304→      const tasks = await loadAllTasks(ctx);
   305→
   306→      const changes: TaskStateChange[] = [];
   307→      const now = Date.now();
   308→
   309→      for (const task of tasks) {
   310→        const taskId = task._ulid;
   311→        const currentStatus = task.status as TaskStatus;
   312→        const prevStatus = this.prevTaskStates.get(taskId);
   313→
   314→        if (prevStatus !== undefined && prevStatus !== currentStatus) {
   315→          changes.push({
   316→            taskId,
   317→            taskRef: `@${taskId}`,
   318→            fromStatus: prevStatus,
   319→            toStatus: currentStatus,
   320→            timestamp: now,
   321→            task,
   322→          });
   323→        }
   324→
   325→        this.prevTaskStates.set(taskId, currentStatus);
   326→      }
   327→
   328→      // Emit change events for detected transitions
   329→      for (const change of changes) {
   330→        await this.handleStateChange(change);
   331→      }
   332→    } catch (err) {
   333→      console.error("[dispatch] Error processing file change:", err);
   334→    }
   335→  }
   336→
   337→  /**
   338→   * Stop the dispatch engine gracefully.
   339→   *
   340→   * Sends cancel signals to all active invocations and waits for them to finish.
   341→   * AC: @agent-dispatch-engine ac-11
   342→   */
   343→  async stop(): Promise<void> {
   344→    this.running = false;
   345→
   346→    // AC: @agent-dispatch-engine ac-11 - Send graceful cancel to all active invocations
   347→    for (const controller of this.invocationAbortControllers) {
   348→      controller.abort();
   349→    }
   350→
   351→    // Wait for all running invocations to complete (or abort)
   352→    if (this.runningInvocations.size > 0) {
   353→      await Promise.allSettled(Array.from(this.runningInvocations));
   354→    }
   355→
   356→    this.queues.clear();
   357→    this.activeCount.clear();
   358→    this.recentEvents.clear();
   359→    this.invocationAbortControllers.clear();
   360→    this.activeInvocationDetails.clear();
   361→  }
   362→
   363→  /**
   364→   * Get the shadow mutex for external callers that need to serialize mutations.
   365→   * AC: @agent-dispatch-engine ac-12
   366→   */
   367→  getShadowMutex(): Mutex {
   368→    return this.shadowMutex;
   369→  }
   370→
   371→  /**
   372→   * Returns current engine status info including per-invocation details.
   373→   * AC: @cli-agent-commands ac-6
   374→   */
   375→  getStatus(): {
   376→    running: boolean;
   377→    activeInvocations: number;
   378→    queuedInvocations: number;
   379→    invocations: Array<{
   380→      invocationId: string;
   381→      sessionId: string;
   382→      agentId: string;
   383→      agentName: string;
   384→      taskRef: string | undefined;
   385→      elapsedMs: number;
   386→    }>;
   387→    queued: Array<{
   388→      agentId: string;
   389→      agentName: string;
   390→      taskRef: string | undefined;
   391→      waitMs: number;
   392→    }>;
   393→  } {
   394→    let active = 0;
   395→    let queued = 0;
   396→    for (const count of this.activeCount.values()) active += count;
   397→    for (const entries of this.queues.values()) queued += entries.length;
   398→    const now = Date.now();
   399→    const invocations = Array.from(this.activeInvocationDetails.values()).map((r) => ({
   400→      invocationId: r.invocationId,
   401→      sessionId: r.sessionId,
   402→      agentId: r.agentId,
   403→      agentName: r.agentName,
   404→      taskRef: r.taskRef,
   405→      elapsedMs: now - r.startedAtMs,
   406→    }));
   407→    const queuedItems = Array.from(this.queues.values()).flatMap((entries) =>
   408→      entries.map((e) => ({
   409→        agentId: e.agent.id,
   410→        agentName: e.agent.name,
   411→        taskRef: e.change.taskRef,
   412→        waitMs: now - e.enqueuedAtMs,
   413→      })),
   414→    );
   415→    return { running: this.running, activeInvocations: active, queuedInvocations: queued, invocations, queued: queuedItems };
   416→  }
   417→
   418→  // ─── Private helpers ─────────────────────────────────────────────────────────
   419→
   420→  /**
   421→   * Bootstrap: evaluate all current tasks against dispatch rules.
   422→   * AC: @agent-dispatch-engine ac-8
   423→   */
   424→  private async _bootstrap(): Promise<void> {
   425→    try {
   426→      const ctx = await initContext(this.projectDir);
   427→      const tasks = await loadAllTasks(ctx);
   428→      const agents = await this._loadAgents();
   429→      const now = Date.now();
   430→
   431→      // Seed prevTaskStates so subsequent file watcher diffs work correctly
   432→      for (const task of tasks) {
   433→        this.prevTaskStates.set(task._ulid, task.status as TaskStatus);
   434→      }
   435→
   436→      // Evaluate each task against each agent's dispatch rules
   437→      for (const task of tasks) {
   438→        const currentStatus = task.status as TaskStatus;
   439→        const eventType = STATUS_TO_EVENT[currentStatus];
   440→        if (!eventType) continue;
   441→
   442→        for (const agent of agents) {
   443→          for (const rule of (agent.dispatch ?? [])) {
   444→            if (rule.on !== eventType) continue;
   445→
   446→            const change: TaskStateChange = {
   447→              taskId: task._ulid,
   448→              taskRef: `@${task._ulid}`,
   449→              fromStatus: currentStatus, // bootstrap: treated as "just entered"
   450→              toStatus: currentStatus,
   451→              timestamp: now,
   452→              task,
   453→            };
   454→
   455→            if (!this._matchesFilter(change, rule, task)) continue;
   456→
   457→            this._enqueue(agent, change);
   458→          }
   459→        }
   460→      }
   461→
   462→      await this._drainQueues(agents);
   463→    } catch (err) {
   464→      console.error("[dispatch] Bootstrap error:", err);
   465→    }
   466→  }
   467→
   468→  /**
   469→   * Load agent definitions from meta context.
   470→   */
   471→  private async _loadAgents(): Promise<LoadedAgent[]> {
   472→    try {
   473→      const ctx = await initContext(this.projectDir);
   474→      const meta = await loadMetaContext(ctx);
   475→      return meta.agents;
   476→    } catch {
   477→      return [];
   478→    }
   479→  }
   480→
   481→  /**
   482→   * Check if a state change matches a dispatch rule's filters.
   483→   * AC: @agent-dispatch-engine ac-6
   484→   */
   485→  private _matchesFilter(
   486→    change: TaskStateChange,
   487→    rule: AgentDispatchRule,
   488→    task?: LoadedTask,
   489→  ): boolean {
   490→    if (!rule.filter) return true;
   491→
   492→    // We need the task to evaluate filters — if not provided, reject to avoid
   493→    // enqueuing non-matching tasks (AC-6: all filters must match)
   494→    if (!task) return false;
   495→
   496→    const { filter } = rule;
   497→
   498→    // Automation filter
   499→    if (filter.automation !== undefined) {
   500→      if ((task as LoadedTask & { automation?: string }).automation !== filter.automation) {
   501→        return false;
   502→      }
   503→    }
   504→
   505→    // Tags filter
   506→    if (filter.tags && filter.tags.length > 0) {
   507→      const taskTags: string[] = (task as LoadedTask & { tags?: string[] }).tags ?? [];
   508→      if (!filter.tags.every((tag) => taskTags.includes(tag))) {
   509→        return false;
   510→      }
   511→    }
   512→
   513→    // Priority filter
   514→    if (filter.priority !== undefined) {
   515→      if ((task as LoadedTask & { priority?: number }).priority !== filter.priority) {
   516→        return false;
   517→      }
   518→    }
   519→
   520→    return true;
   521→  }
   522→
   523→  /**
   524→   * Build a deduplication key for a state change.
   525→   * AC: @agent-dispatch-engine ac-7
   526→   */
   527→  private _dedupKey(change: TaskStateChange): DedupKey {
   528→    return `${change.taskId}:${change.fromStatus}:${change.toStatus}`;
   529→  }
   530→
   531→  /**
   532→   * Check whether this event is a duplicate within the dedup window.
   533→   * AC: @agent-dispatch-engine ac-7
   534→   */
   535→  private _isDuplicate(change: TaskStateChange): boolean {
   536→    const key = this._dedupKey(change);
   537→    const expiry = this.recentEvents.get(key);
   538→    if (expiry === undefined) return false;
   539→    return change.timestamp < expiry;
   540→  }
   541→
   542→  /**
   543→   * Record a state change for deduplication.
   544→   * AC: @agent-dispatch-engine ac-7
   545→   */
   546→  private _recordEvent(change: TaskStateChange): void {
   547→    const key = this._dedupKey(change);
   548→    this.recentEvents.set(key, change.timestamp + this.dedupWindowMs);
   549→
   550→    // Prune expired entries periodically
   551→    if (this.recentEvents.size > 1000) {
   552→      const now = Date.now();
   553→      for (const [k, expiry] of this.recentEvents) {
   554→        if (expiry < now) this.recentEvents.delete(k);
   555→      }
   556→    }
   557→  }
   558→
   559→  /**
   560→   * Enqueue a dispatch entry for an agent.
   561→   * AC: @agent-dispatch-engine ac-3
   562→   */
   563→  private _enqueue(agent: LoadedAgent, change: TaskStateChange): void {
   564→    const queue = this.queues.get(agent.id) ?? [];
   565→    queue.push({ agent, change, retryCount: 0, nextRetryAt: 0, enqueuedAtMs: Date.now() });
   566→    this.queues.set(agent.id, queue);
   567→  }
   568→
   569→  /**
   570→   * Drain queues, spawning invocations up to each agent's max_concurrent limit.
   571→   * AC: @agent-dispatch-engine ac-3
   572→   */
   573→  private async _drainQueues(agents: LoadedAgent[]): Promise<void> {
   574→    // Prevent new invocation starts during/after shutdown.
   575→    if (!this.running) return;
   576→
   577→    for (const agent of agents) {
   578→      const maxConcurrent = agent.concurrency?.max_concurrent ?? 1;
   579→      const active = this.activeCount.get(agent.id) ?? 0;
   580→      const queue = this.queues.get(agent.id) ?? [];
   581→
   582→      let slots = maxConcurrent - active;
   583→      while (slots > 0 && queue.length > 0) {
   584→        const entry = queue.shift()!;
   585→        if (entry.nextRetryAt > Date.now()) {
   586→          // Not ready for retry yet; put back at front
   587→          queue.unshift(entry);
   588→          break;
   589→        }
   590→        const spawned = this._spawnInvocation(agent, entry);
   591→        if (spawned) slots--;
   592→      }
   593→
   594→      this.queues.set(agent.id, queue);
   595→    }
   596→  }
   597→
   598→  /**
   599→   * Spawn a single invocation for a queue entry.
   600→   * Returns true if an invocation was actually started, false if skipped.
   601→   * AC: @agent-dispatch-engine ac-9, ac-10, ac-11, ac-12
   602→   */
   603→  private _spawnInvocation(agent: LoadedAgent, entry: QueueEntry): boolean {
   604→    const agentId = agent.id;
   605→
   606→    // Increment active count
   607→    this.activeCount.set(agentId, (this.activeCount.get(agentId) ?? 0) + 1);
   608→
   609→    // AC: @agent-dispatch-engine ac-10 - Check adapter resolvability before spawn
   610→    const adapterId = agent.adapter ?? "claude-agent-acp";
   611→    const adapter = getAdapter(adapterId);
   612→    if (!adapter) {
   613→      console.error(
   614→        `[dispatch] Cannot resolve adapter "${adapterId}" for agent "${agentId}". Skipping invocation.`,
   615→      );
   616→      // Decrement active count since we're not actually running
   617→      const currentActive = this.activeCount.get(agentId) ?? 1;
   618→      this.activeCount.set(agentId, Math.max(0, currentActive - 1));
   619→      // AC: @agent-dispatch-engine ac-10 - Add task note for unresolvable adapter
   620→      if (this.kspecCliPath) {
   621→        spawnSync(process.execPath, [
   622→          this.kspecCliPath,
   623→          "task", "note", entry.change.taskRef,
   624→          `[AGENT-SKIP] Cannot resolve adapter "${adapterId}" for agent "${agentId}". Invocation skipped.`,
   625→        ], { cwd: this.cwd });
   626→      }
   627→      return false;
   628→    }
   629→
   630→    // AC: @agent-dispatch-engine ac-11 - Create abort controller for graceful cancellation
   631→    const abortController = new AbortController();
   632→    this.invocationAbortControllers.add(abortController);
   633→
   634→    // AC: @cli-agent-commands ac-6 - Pre-assign session ID for status tracking
   635→    const preSessionId = ulid();
   636→    const invocationId = ulid();
   637→    const trackingRecord: ActiveInvocationRecord = {
   638→      invocationId,
   639→      sessionId: preSessionId,
   640→      agentId,
   641→      agentName: agent.name,
   642→      taskRef: entry.change.taskRef,
   643→      startedAtMs: Date.now(),
   644→    };
   645→    this.activeInvocationDetails.set(invocationId, trackingRecord);
   646→
   647→    // AC: @daemon-agent-dispatch ac-3, ac-4 - Emit started event
   648→    this.onInvocationEvent?.({
   649→      type: "started",
   650→      session_id: preSessionId,
   651→      agent_id: agentId,
   652→      task_id: entry.change.taskRef,
   653→      status: "started",
   654→      timestamp: Date.now(),
   655→    });
   656→
   657→    const options: InvocationOptions = {
   658→      agent,
   659→      specDir: this.specDir,
   660→      cwd: this.cwd,
   661→      taskRef: entry.change.taskRef,
   662→      prompt: agent.prompt_template ?? `Work on task ${entry.change.taskRef}`,
   663→      trigger: (STATUS_TO_EVENT[entry.change.toStatus] ?? "task.ready") as SessionTrigger,
   664→      kspecCliPath: this.kspecCliPath,
   665→      abortSignal: abortController.signal,
   666→      sessionId: preSessionId,
   667→    };
   668→
   669→    // AC: @agent-dispatch-engine ac-12 - Wrap invocation in shadow mutex
   670→    const invocationPromise = this.shadowMutex
   671→      .runExclusive(async () => {
   672→        // AC: @agent-dispatch-engine ac-9 - Retry on transient errors
   673→        try {
   674→          await runInvocation(options);
   675→          // Reset retry count on success
   676→          entry.retryCount = 0;
   677→          // AC: @daemon-agent-dispatch ac-3, ac-4 - Emit completed event
   678→          this.onInvocationEvent?.({
   679→            type: "completed",
   680→            session_id: preSessionId,
   681→            agent_id: agentId,
   682→            task_id: entry.change.taskRef,
   683→            status: "completed",
   684→            timestamp: Date.now(),
   685→          });
   686→        } catch (err) {
   687→          const retryLimit = agent.budget?.max_tasks ?? 3;
   688→          if (entry.retryCount < retryLimit) {
   689→            entry.retryCount++;
   690→            const backoffMs = Math.min(
   691→              1000 * Math.pow(2, entry.retryCount - 1),
   692→              30_000,
   693→            );
   694→            entry.nextRetryAt = Date.now() + backoffMs;
   695→            console.warn(
   696→              `[dispatch] Invocation for agent "${agentId}" failed (attempt ${entry.retryCount}/${retryLimit}), retrying in ${backoffMs}ms`,
   697→              err,
   698→            );
   699→            // Re-enqueue at front for retry
   700→            const queue = this.queues.get(agentId) ?? [];
   701→            queue.unshift(entry);
   702→            this.queues.set(agentId, queue);
   703→            // AC: @agent-dispatch-engine ac-9 - Schedule wake-up to drain retry
   704→            setTimeout(() => {
   705→              if (this.running) {
   706→                this._loadAgents()
   707→                  .then((agents) => this._drainQueues(agents))
   708→                  .catch(() => {/* best effort */});
   709→              }
   710→            }, backoffMs);
   711→          } else {
   712→            console.error(
   713→              `[dispatch] Agent "${agentId}" exceeded retry limit. Dropping invocation.`,
   714→              err,
   715→            );
   716→            // AC: @daemon-agent-dispatch ac-3, ac-4 - Emit failed event when retry limit exceeded
   717→            this.onInvocationEvent?.({
   718→              type: "failed",
   719→              session_id: preSessionId,
   720→              agent_id: agentId,
   721→              task_id: entry.change.taskRef,
   722→              status: "failed",
   723→              timestamp: Date.now(),
   724→            });
   725→          }
   726→        }
   727→      })
   728→      .then(async () => {
   729→        // Decrement active count and drain again
   730→        const currentActive = this.activeCount.get(agentId) ?? 1;
   731→        this.activeCount.set(agentId, Math.max(0, currentActive - 1));
   732→
   733→        if (!this.running) return;
   734→
   735→        // Try to drain more items
   736→        try {
   737→          const agents = await this._loadAgents();
   738→          await this._drainQueues(agents);
   739→        } catch {
   740→          // Best effort
   741→        }
   742→      })
   743→      .finally(() => {
   744→        this.runningInvocations.delete(invocationPromise);
   745→        this.invocationAbortControllers.delete(abortController);
   746→        this.activeInvocationDetails.delete(invocationId);
   747→      });
   748→
   749→    this.runningInvocations.add(invocationPromise);
   750→    return true;
   751→  }
   752→}
   753→

