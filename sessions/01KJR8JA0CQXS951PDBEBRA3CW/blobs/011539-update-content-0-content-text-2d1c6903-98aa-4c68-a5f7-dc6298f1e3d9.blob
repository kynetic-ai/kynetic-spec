```
     1→/**
     2→ * Enhanced setup command for kspec agent integration.
     3→ *
     4→ * Orchestrates the full onboarding pipeline:
     5→ * - Detect agent environment (Claude Code, Cline, etc.)
     6→ * - Install hooks (UserPromptSubmit, Stop, PreToolUse guards)
     7→ * - Render skills from .kspec/skills/ to .claude/skills/
     8→ * - Generate kspec-agents.md
     9→ *
    10→ * AC: @enhanced-setup ac-1 - summary displayed listing each step performed
    11→ * AC: @enhanced-setup ac-2 - all hook entries (UserPromptSubmit, Stop, PreToolUse) present
    12→ * AC: @enhanced-setup ac-3 - rendered skill files exist for each skill targeting claude-code
    13→ * AC: @enhanced-setup ac-4 - kspec-agents.md exists after setup
    14→ * AC: @enhanced-setup ac-5 - --skip-skills flag skips skill rendering
    15→ * AC: @enhanced-setup ac-6 - --dry-run displays planned actions without changes
    16→ * AC: @enhanced-setup ac-7 - --status reports current state including agent detected
    17→ * AC: @enhanced-setup ac-8 - --status shows hooks status, skills rendered count, agents.md freshness
    18→ * AC: @enhanced-setup ac-9 - skills referenced by ralph (task-work, reflect) are present
    19→ */
    20→
    21→import * as fs from "node:fs/promises";
    22→import { existsSync } from "node:fs";
    23→import * as os from "node:os";
    24→import * as path from "node:path";
    25→import * as readline from "node:readline/promises";
    26→import chalk from "chalk";
    27→import type { Command } from "commander";
    28→import {
    29→  getGitRoot,
    30→  getShadowStatus,
    31→  repairShadow,
    32→  SHADOW_BRANCH_NAME,
    33→} from "../../parser/shadow.js";
    34→import {
    35→  detectAgentFromEnv,
    36→  type AgentConfidence,
    37→} from "../../parser/agent-detection.js";
    38→import { errors } from "../../strings/index.js";
    39→import { EXIT_CODES } from "../exit-codes.js";
    40→import { error, output, success, warn } from "../output.js";
    41→
    42→/**
    43→ * Log a message at debug level (only when KSPEC_DEBUG=1)
    44→ * AC: @setup-pipeline-unification ac-4
    45→ */
    46→function debugLog(message: string, detail?: unknown): void {
    47→  if (process.env.KSPEC_DEBUG === "1") {
    48→    if (detail) {
    49→      console.error(`[DEBUG] setup: ${message}`, detail);
    50→    } else {
    51→      console.error(`[DEBUG] setup: ${message}`);
    52→    }
    53→  }
    54→}
    55→
    56→/**
    57→ * Supported agent types for auto-configuration
    58→ */
    59→export type AgentType =
    60→  | "claude-code"
    61→  | "cline"
    62→  | "roo-code"
    63→  | "copilot-cli"
    64→  | "gemini-cli"
    65→  | "codex-cli"
    66→  | "aider"
    67→  | "opencode"
    68→  | "amp"
    69→  | "cursor"
    70→  | "windsurf"
    71→  | "unknown";
    72→
    73→/**
    74→ * Result of agent detection
    75→ */
    76→export interface DetectedAgent {
    77→  type: AgentType;
    78→  confidence: AgentConfidence;
    79→  configPath?: string;
    80→  envVars?: Record<string, string>;
    81→}
    82→
    83→const SETUP_AGENT_OVERRIDES = [
    84→  "claude-code",
    85→  "cline",
    86→  "cursor",
    87→  "windsurf",
    88→  "unknown",
    89→] as const;
    90→
    91→type SetupAgentOverride = (typeof SETUP_AGENT_OVERRIDES)[number];
    92→
    93→function parseSetupAgentOverride(value: string): SetupAgentOverride {
    94→  const normalized = value.trim().toLowerCase();
    95→  if (
    96→    (SETUP_AGENT_OVERRIDES as readonly string[]).includes(normalized)
    97→  ) {
    98→    return normalized as SetupAgentOverride;
    99→  }
   100→
   101→  const allowed = SETUP_AGENT_OVERRIDES.join(", ");
   102→  throw new Error(
   103→    `Invalid --agent value "${value}". Supported values: ${allowed}`,
   104→  );
   105→}
   106→
   107→function buildDetectedAgent(type: AgentType): DetectedAgent {
   108→  if (type === "claude-code") {
   109→    return {
   110→      type,
   111→      confidence: "high",
   112→      configPath: path.join(os.homedir(), ".claude", "settings.json"),
   113→    };
   114→  }
   115→  return { type, confidence: "high" };
   116→}
   117→
   118→/**
   119→ * Detect which agent environment we're running in.
   120→ * Returns the detected agent type and confidence level.
   121→ *
   122→ * Detection priority matters - more specific markers checked first.
   123→ */
   124→export function detectAgent(): DetectedAgent {
   125→  const detected = detectAgentFromEnv();
   126→  if (detected.type !== "unknown") {
   127→    return detected;
   128→  }
   129→
   130→  // Fallback for non-interactive contexts where env markers may be absent.
   131→  if (existsSync(path.join(os.homedir(), ".claude"))) {
   132→    return {
   133→      type: "claude-code",
   134→      confidence: "low",
   135→      configPath: path.join(os.homedir(), ".claude", "settings.json"),
   136→    };
   137→  }
   138→
   139→  return detected;
   140→}
   141→
   142→/**
   143→ * Install KSPEC_AUTHOR config for Claude Code (global settings)
   144→ */
   145→async function installClaudeCodeConfig(author: string): Promise<boolean> {
   146→  const configPath = path.join(os.homedir(), ".claude", "settings.json");
   147→  const configDir = path.dirname(configPath);
   148→
   149→  try {
   150→    // Ensure directory exists
   151→    await fs.mkdir(configDir, { recursive: true });
   152→
   153→    // Read existing config or start fresh
   154→    let config: Record<string, unknown> = {};
   155→    try {
   156→      const existing = await fs.readFile(configPath, "utf-8");
   157→      config = JSON.parse(existing);
   158→    } catch (err) {
   159→      debugLog("No existing Claude Code config, starting fresh", err);
   160→    }
   161→
   162→    // Merge env settings
   163→    const env = (config.env as Record<string, string>) || {};
   164→    env.KSPEC_AUTHOR = author;
   165→    config.env = env;
   166→
   167→    // Write back
   168→    await fs.writeFile(
   169→      configPath,
   170→      `${JSON.stringify(config, null, 2)}\n`,
   171→      "utf-8",
   172→    );
   173→    return true;
   174→  } catch (err) {
   175→    debugLog("Failed to install Claude Code config", err);
   176→    return false;
   177→  }
   178→}
   179→
   180→/**
   181→ * Result of installing hooks
   182→ * AC: @enhanced-setup ac-2 - tracks all hook types
   183→ */
   184→export interface HooksInstallResult {
   185→  promptCheck: boolean;
   186→  stop: boolean;
   187→  preToolUse: boolean;
   188→  guardsCreated: string[];
   189→}
   190→
   191→/**
   192→ * Native guard command for PreToolUse hooks.
   193→ * Replaces bash shell scripts with `kspec guard worktree`.
   194→ *
   195→ * AC: @native-guard-commands ac-setup-native - references kspec guard worktree
   196→ */
   197→const NATIVE_GUARD_COMMAND = "kspec guard worktree";
   198→
   199→/**
   200→ * Old bash script filenames that should be migrated to native commands.
   201→ * AC: @native-guard-commands ac-migrate-hooks
   202→ */
   203→const OLD_GUARD_SCRIPTS = [
   204→  "kspec-worktree-guard.sh",
   205→  "ralph-task-limit-guard.sh",
   206→];
   207→
   208→/**
   209→ * Install hooks to project-level Claude Code settings (.claude/settings.json)
   210→ * AC: @enhanced-setup ac-2 - all hook entries present
   211→ */
   212→async function installClaudeCodeHooks(
   213→  projectDir: string,
   214→  dryRun = false,
   215→): Promise<HooksInstallResult> {
   216→  const configPath = path.join(projectDir, ".claude", "settings.json");
   217→  const configDir = path.dirname(configPath);
   218→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   219→
   220→  const result: HooksInstallResult = {
   221→    promptCheck: false,
   222→    stop: false,
   223→    preToolUse: false,
   224→    guardsCreated: [],
   225→  };
   226→
   227→  try {
   228→    // Ensure directories exist
   229→    if (!dryRun) {
   230→      await fs.mkdir(configDir, { recursive: true });
   231→      await fs.mkdir(hooksDir, { recursive: true });
   232→    }
   233→
   234→    // Read existing config or start fresh
   235→    let config: Record<string, unknown> = {};
   236→    try {
   237→      const existing = await fs.readFile(configPath, "utf-8");
   238→      config = JSON.parse(existing);
   239→    } catch (err) {
   240→      debugLog("No existing hooks config, starting fresh", err);
   241→    }
   242→
   243→    // Get or create hooks object
   244→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   245→
   246→    // Install UserPromptSubmit hook (spec-first reminder)
   247→    const promptCheckCommand = "kspec session prompt-check";
   248→    const existingPromptHooks = hooks.UserPromptSubmit as
   249→      | Array<{ hooks?: Array<{ command?: string }> }>
   250→      | undefined;
   251→    const promptAlreadyInstalled = existingPromptHooks?.some((entry) =>
   252→      entry.hooks?.some((hook) =>
   253→        hook.command?.includes("session prompt-check"),
   254→      ),
   255→    );
   256→
   257→    if (!promptAlreadyInstalled) {
   258→      hooks.UserPromptSubmit = [
   259→        ...(existingPromptHooks || []),
   260→        {
   261→          hooks: [
   262→            {
   263→              type: "command",
   264→              command: promptCheckCommand,
   265→            },
   266→          ],
   267→        },
   268→      ];
   269→      result.promptCheck = true;
   270→    } else {
   271→      result.promptCheck = true; // Already configured
   272→    }
   273→
   274→    // Install Stop hook (checkpoint)
   275→    const stopHookCommand = "kspec session checkpoint --json";
   276→    const existingStopHooks = hooks.Stop as
   277→      | Array<{ matcher?: string; hooks?: Array<{ command?: string }> }>
   278→      | undefined;
   279→    const stopAlreadyInstalled = existingStopHooks?.some((entry) =>
   280→      entry.hooks?.some((hook) => hook.command?.includes("session checkpoint")),
   281→    );
   282→
   283→    if (!stopAlreadyInstalled) {
   284→      hooks.Stop = [
   285→        ...(existingStopHooks || []),
   286→        {
   287→          matcher: "",
   288→          hooks: [
   289→            {
   290→              type: "command",
   291→              command: stopHookCommand,
   292→            },
   293→          ],
   294→        },
   295→      ];
   296→      result.stop = true;
   297→    } else {
   298→      result.stop = true; // Already configured
   299→    }
   300→
   301→    // AC: @enhanced-setup ac-2 - Install PreToolUse hooks with guards
   302→    // AC: @native-guard-commands ac-setup-native - use native kspec guard worktree
   303→    // AC: @native-guard-commands ac-no-task-limit-hook - no task-limit guard
   304→    // AC: @native-guard-commands ac-migrate-hooks - replace old bash script entries
   305→    // AC: @native-guard-commands ac-idempotent - no duplicate entries
   306→    const existingPreToolUseHooks = hooks.PreToolUse as
   307→      | Array<{ matcher?: string; hooks?: Array<{ type?: string; command?: string }> }>
   308→      | undefined;
   309→
   310→    // Check if native guard command is already installed
   311→    const nativeAlreadyInstalled = existingPreToolUseHooks?.some((entry) =>
   312→      entry.hooks?.some((hook) => hook.command === NATIVE_GUARD_COMMAND),
   313→    );
   314→
   315→    // Check for old bash script entries that need migration
   316→    const hasOldScripts = existingPreToolUseHooks?.some((entry) =>
   317→      entry.hooks?.some((hook) =>
   318→        OLD_GUARD_SCRIPTS.some(
   319→          (name) => hook.command?.includes(name),
   320→        ),
   321→      ),
   322→    );
   323→
   324→    if (hasOldScripts || !nativeAlreadyInstalled) {
   325→      // Remove any PreToolUse entries that reference old bash scripts
   326→      // AC: @native-guard-commands ac-migrate-hooks
   327→      let filteredPreToolUse = (existingPreToolUseHooks || []).map((entry) => ({
   328→        ...entry,
   329→        hooks: entry.hooks?.filter(
   330→          (hook) =>
   331→            !OLD_GUARD_SCRIPTS.some((name) => hook.command?.includes(name)),
   332→        ),
   333→      }));
   334→      // Remove entries with empty hooks arrays
   335→      filteredPreToolUse = filteredPreToolUse.filter(
   336→        (entry) => entry.hooks && entry.hooks.length > 0,
   337→      );
   338→
   339→      // Add native guard command if not already present
   340→      if (!nativeAlreadyInstalled) {
   341→        filteredPreToolUse.push({
   342→          matcher: "Bash",
   343→          hooks: [
   344→            {
   345→              type: "command",
   346→              command: NATIVE_GUARD_COMMAND,
   347→            },
   348→          ],
   349→        });
   350→      }
   351→
   352→      hooks.PreToolUse = filteredPreToolUse;
   353→      result.preToolUse = true;
   354→
   355→      // Delete old bash script files
   356→      // AC: @native-guard-commands ac-migrate-hooks - delete old files
   357→      if (!dryRun) {
   358→        for (const name of OLD_GUARD_SCRIPTS) {
   359→          const scriptPath = path.join(hooksDir, name);
   360→          try {
   361→            await fs.unlink(scriptPath);
   362→            result.guardsCreated.push(`deleted:${name}`);
   363→          } catch (err) {
   364→            debugLog(`Could not delete old guard script ${name}`, err);
   365→          }
   366→        }
   367→      }
   368→    } else {
   369→      result.preToolUse = true; // Already configured with native command
   370→    }
   371→
   372→    config.hooks = hooks;
   373→
   374→    // Write back
   375→    if (!dryRun) {
   376→      await fs.writeFile(
   377→        configPath,
   378→        `${JSON.stringify(config, null, 2)}\n`,
   379→        "utf-8",
   380→      );
   381→    }
   382→    return result;
   383→  } catch (err) {
   384→    debugLog("installClaudeCodeHooks failed", err);
   385→    return result;
   386→  }
   387→}
   388→
   389→/**
   390→ * Install KSPEC_AUTHOR config for Aider (.aider.conf.yml)
   391→ * Aider uses `set-env:` for environment variables in list format
   392→ */
   393→async function installAiderConfig(author: string): Promise<boolean> {
   394→  const configPath = path.join(os.homedir(), ".aider.conf.yml");
   395→
   396→  try {
   397→    let content = "";
   398→    try {
   399→      content = await fs.readFile(configPath, "utf-8");
   400→    } catch (err) {
   401→      debugLog("No existing Aider config, starting fresh", err);
   402→    }
   403→
   404→    // Check if KSPEC_AUTHOR is already set
   405→    if (content.includes("KSPEC_AUTHOR")) {
   406→      // Replace existing value (handles both old and new format)
   407→      content = content.replace(
   408→        /^(\s*-?\s*KSPEC_AUTHOR\s*[=:]\s*).*$/m,
   409→        `  - KSPEC_AUTHOR=${author}`,
   410→      );
   411→    } else {
   412→      // Add to set-env section or create it
   413→      if (content.includes("set-env:")) {
   414→        // Append to existing set-env section
   415→        content = content.replace(
   416→          /(set-env:\s*\n)/m,
   417→          `$1  - KSPEC_AUTHOR=${author}\n`,
   418→        );
   419→      } else {
   420→        // Add new set-env section
   421→        content += `\n# kspec author for note attribution\nset-env:\n  - KSPEC_AUTHOR=${author}\n`;
   422→      }
   423→    }
   424→
   425→    await fs.writeFile(configPath, content, "utf-8");
   426→    return true;
   427→  } catch (err) {
   428→    debugLog("installAiderConfig failed", err);
   429→    return false;
   430→  }
   431→}
   432→
   433→/**
   434→ * Install KSPEC_AUTHOR for generic JSON config files
   435→ */
   436→async function installGenericJsonConfig(
   437→  configPath: string,
   438→  author: string,
   439→): Promise<boolean> {
   440→  try {
   441→    const configDir = path.dirname(configPath);
   442→    await fs.mkdir(configDir, { recursive: true });
   443→
   444→    let config: Record<string, unknown> = {};
   445→    try {
   446→      const existing = await fs.readFile(configPath, "utf-8");
   447→      config = JSON.parse(existing);
   448→    } catch (err) {
   449→      debugLog(`No existing config at ${configPath}, starting fresh`, err);
   450→    }
   451→
   452→    const env = (config.env as Record<string, string>) || {};
   453→    env.KSPEC_AUTHOR = author;
   454→    config.env = env;
   455→
   456→    await fs.writeFile(
   457→      configPath,
   458→      `${JSON.stringify(config, null, 2)}\n`,
   459→      "utf-8",
   460→    );
   461→    return true;
   462→  } catch (err) {
   463→    debugLog(`installGenericJsonConfig failed for ${configPath}`, err);
   464→    return false;
   465→  }
   466→}
   467→
   468→/**
   469→ * Get default author value for an agent type
   470→ */
   471→function getDefaultAuthor(agentType: AgentType): string {
   472→  switch (agentType) {
   473→    case "claude-code":
   474→      return "@claude";
   475→    case "cline":
   476→      return "@cline";
   477→    case "roo-code":
   478→      return "@roo";
   479→    case "copilot-cli":
   480→      return "@copilot";
   481→    case "gemini-cli":
   482→      return "@gemini";
   483→    case "codex-cli":
   484→      return "@codex";
   485→    case "aider":
   486→      return "@aider";
   487→    case "opencode":
   488→      return "@opencode";
   489→    case "amp":
   490→      return "@amp";
   491→    default:
   492→      return "@agent";
   493→  }
   494→}
   495→
   496→/**
   497→ * Prompt user for input with Y/N answer
   498→ */
   499→async function promptYesNo(question: string): Promise<boolean> {
   500→  const rl = readline.createInterface({
   501→    input: process.stdin,
   502→    output: process.stdout,
   503→  });
   504→
   505→  try {
   506→    const answer = await rl.question(`${question} `);
   507→    return answer.toLowerCase() === "y";
   508→  } finally {
   509→    rl.close();
   510→  }
   511→}
   512→
   513→/**
   514→ * Ensure .kspec worktree exists if kspec-meta branch is present.
   515→ * AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
   516→ *
   517→ * @param autoWorktree If true, automatically create worktree without prompting
   518→ * @returns true if worktree is ready to use
   519→ */
   520→async function ensureWorktree(autoWorktree: boolean): Promise<boolean> {
   521→  const projectRoot = getGitRoot(process.cwd());
   522→  if (!projectRoot) {
   523→    // Not in a git repo, skip worktree check
   524→    return true;
   525→  }
   526→
   527→  const status = await getShadowStatus(projectRoot);
   528→
   529→  // AC: worktree-already-exists - if already valid, skip
   530→  if (status.healthy) {
   531→    return true;
   532→  }
   533→
   534→  // AC: detect-existing-repo - branch exists but worktree doesn't
   535→  if (status.branchExists && !status.worktreeExists) {
   536→    // AC: auto-worktree-flag - auto-create if flag set
   537→    if (autoWorktree) {
   538→      console.log(
   539→        `Detected ${SHADOW_BRANCH_NAME} branch without .kspec worktree. Creating...`,
   540→      );
   541→      const result = await repairShadow(projectRoot);
   542→      if (result.success) {
   543→        success("Created .kspec worktree");
   544→        return true;
   545→      } else {
   546→        error(`Failed to create worktree: ${result.error}`);
   547→        return false;
   548→      }
   549→    }
   550→
   551→    // AC: detect-existing-repo - prompt user
   552→    const shouldCreate = await promptYesNo(
   553→      `${SHADOW_BRANCH_NAME} branch exists but .kspec worktree is missing. Create it? (y/N)`,
   554→    );
   555→
   556→    if (shouldCreate) {
   557→      console.log("Creating .kspec worktree...");
   558→      const result = await repairShadow(projectRoot);
   559→      if (result.success) {
   560→        success("Created .kspec worktree");
   561→        return true;
   562→      } else {
   563→        error(`Failed to create worktree: ${result.error}`);
   564→        return false;
   565→      }
   566→    } else {
   567→      warn("Skipping worktree creation");
   568→      return false;
   569→    }
   570→  }
   571→
   572→  // No kspec-meta branch, or already healthy
   573→  return true;
   574→}
   575→
   576→/**
   577→ * Print manual setup instructions
   578→ */
   579→function printManualInstructions(agentType: AgentType): void {
   580→  const author = getDefaultAuthor(agentType);
   581→
   582→  console.log("\nManual setup instructions:\n");
   583→
   584→  switch (agentType) {
   585→    case "claude-code":
   586→      console.log("Add to ~/.claude/settings.json:");
   587→      console.log("```json");
   588→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   589→      console.log("```");
   590→      break;
   591→
   592→    case "cline":
   593→    case "roo-code":
   594→      console.log("Add to your shell profile (~/.bashrc, ~/.zshrc):");
   595→      console.log("```bash");
   596→      console.log(`export KSPEC_AUTHOR="${author}"`);
   597→      console.log("```");
   598→      console.log(
   599→        "\nThis will be inherited by terminals spawned by the VS Code extension.",
   600→      );
   601→      break;
   602→
   603→    case "copilot-cli":
   604→      console.log("Add to ~/.copilot/config.json:");
   605→      console.log("```json");
   606→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   607→      console.log("```");
   608→      break;
   609→
   610→    case "aider":
   611→      console.log("Add to ~/.aider.conf.yml:");
   612→      console.log("```yaml");
   613→      console.log("set-env:");
   614→      console.log(`  - KSPEC_AUTHOR=${author}`);
   615→      console.log("```");
   616→      break;
   617→
   618→    case "codex-cli":
   619→      console.log("Add to ~/.codex/config.toml:");
   620→      console.log("```toml");
   621→      console.log("[shell_environment_policy]");
   622→      console.log(`set = { KSPEC_AUTHOR = "${author}" }`);
   623→      console.log("```");
   624→      break;
   625→
   626→    case "opencode":
   627→      console.log("Add to ~/.config/opencode/opencode.json:");
   628→      console.log("```json");
   629→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   630→      console.log("```");
   631→      break;
   632→
   633→    case "amp":
   634→      console.log("Add to ~/.config/amp/settings.json:");
   635→      console.log("```json");
   636→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   637→      console.log("```");
   638→      break;
   639→
   640→    default:
   641→      console.log("Set the KSPEC_AUTHOR environment variable:");
   642→      console.log("```bash");
   643→      console.log(`export KSPEC_AUTHOR="${author}"`);
   644→      console.log("```");
   645→      console.log("\nOr add to your shell profile (~/.bashrc, ~/.zshrc, etc.)");
   646→  }
   647→}
   648→
   649→/**
   650→ * Result of a setup step
   651→ */
   652→interface SetupStepResult {
   653→  name: string;
   654→  status: "done" | "skipped" | "failed";
   655→  message?: string;
   656→  details?: Record<string, unknown>;
   657→}
   658→
   659→/**
   660→ * Result of running the setup pipeline
   661→ * Used by both the setup command and init --setup
   662→ * AC: @init-setup-integration ac-2, ac-3
   663→ */
   664→export interface SetupPipelineResult {
   665→  success: boolean;
   666→  steps: SetupStepResult[];
   667→  coreSkillsInstalled: number;
   668→  skillsRendered: number;
   669→  hooksInstalled: boolean;
   670→  agentsMdGenerated: boolean;
   671→  permissionsSeeded: boolean;
   672→  memorySeeded: boolean;
   673→}
   674→
   675→/**
   676→ * Options for running the setup pipeline
   677→ */
   678→export interface SetupPipelineOptions {
   679→  dryRun?: boolean;
   680→  skipSkills?: boolean;
   681→  installHooks?: boolean;
   682→  force?: boolean;
   683→  /** Explicit agent override (bypasses auto-detection) */
   684→  agent?: SetupAgentOverride;
   685→  /** Custom author string (overrides auto-detected default) */
   686→  author?: string;
   687→  /** Whether to configure author (only in command handler, not init) */
   688→  configureAuthor?: boolean;
   689→}
   690→
   691→/**
   692→ * Status of the setup state
   693→ * AC: @enhanced-setup ac-7, ac-8 - status reporting
   694→ */
   695→interface SetupStatus {
   696→  agent: {
   697→    detected: AgentType;
   698→    confidence: "high" | "medium" | "low";
   699→  };
   700→  hooks: {
   701→    promptCheck: boolean;
   702→    stop: boolean;
   703→    preToolUse: boolean;
   704→    guardsPresent: string[];
   705→  };
   706→  skills: {
   707→    total: number;
   708→    rendered: number;
   709→    drifted: number;
   710→  };
   711→  plugin: {
   712→    marketplaceRegistered: boolean;
   713→    marketplaceHealthy: boolean;
   714→    pluginEnabled: boolean;
   715→    registeredPath?: string;
   716→    healthMessage?: string;
   717→  };
   718→  agentsMd: {
   719→    exists: boolean;
   720→    // AC: @doctor-command ac-staleness-unknown — includes "unknown" for indeterminate cases
   721→    status: "current" | "stale" | "missing" | "unknown";
   722→    generatedAt?: string;
   723→  };
   724→  seeding: {
   725→    permissionsSeeded: boolean;
   726→    memorySeeded: boolean;
   727→    memoryPath?: string;
   728→  };
   729→}
   730→
   731→/**
   732→ * Check the current setup status
   733→ * AC: @enhanced-setup ac-7, ac-8
   734→ */
   735→async function getSetupStatus(
   736→  projectDir: string,
   737→  agentOverride?: SetupAgentOverride,
   738→): Promise<SetupStatus> {
   739→  const detected = agentOverride
   740→    ? buildDetectedAgent(agentOverride)
   741→    : detectAgent();
   742→  const configPath = path.join(projectDir, ".claude", "settings.json");
   743→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   744→  const agentsMdPath = path.join(projectDir, "kspec-agents.md");
   745→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
   746→  const skillsDir = path.join(projectDir, ".claude", "skills");
   747→
   748→  // Check hooks
   749→  const hooks = {
   750→    promptCheck: false,
   751→    stop: false,
   752→    preToolUse: false,
   753→    guardsPresent: [] as string[],
   754→  };
   755→
   756→  try {
   757→    const configContent = await fs.readFile(configPath, "utf-8");
   758→    const config = JSON.parse(configContent);
   759→    const hooksConfig = config.hooks || {};
   760→
   761→    // Check UserPromptSubmit
   762→    const promptHooks = hooksConfig.UserPromptSubmit as Array<{
   763→      hooks?: Array<{ command?: string }>;
   764→    }> | undefined;
   765→    hooks.promptCheck = promptHooks?.some((entry) =>
   766→      entry.hooks?.some((h) => h.command?.includes("prompt-check")),
   767→    ) ?? false;
   768→
   769→    // Check Stop
   770→    const stopHooks = hooksConfig.Stop as Array<{
   771→      hooks?: Array<{ command?: string }>;
   772→    }> | undefined;
   773→    hooks.stop = stopHooks?.some((entry) =>
   774→      entry.hooks?.some((h) => h.command?.includes("checkpoint")),
   775→    ) ?? false;
   776→
   777→    // Check PreToolUse — look for native kspec guard worktree command
   778→    const preToolUseHooks = hooksConfig.PreToolUse as Array<{
   779→      hooks?: Array<{ command?: string }>;
   780→    }> | undefined;
   781→    hooks.preToolUse = preToolUseHooks?.some((entry) =>
   782→      entry.hooks?.some((h) =>
   783→        h.command === NATIVE_GUARD_COMMAND || h.command?.includes(".claude/hooks/"),
   784→      ),
   785→    ) ?? false;
   786→
   787→    // Check for native guard command
   788→    if (preToolUseHooks?.some((entry) =>
   789→      entry.hooks?.some((h) => h.command === NATIVE_GUARD_COMMAND),
   790→    )) {
   791→      hooks.guardsPresent.push("kspec guard worktree");
   792→    }
   793→    // Check for legacy bash scripts still present
   794→    if (preToolUseHooks?.some((entry) =>
   795→      entry.hooks?.some((h) =>
   796→        OLD_GUARD_SCRIPTS.some((name) => h.command?.includes(name)),
   797→      ),
   798→    )) {
   799→      hooks.guardsPresent.push("legacy:bash-scripts");
   800→    }
   801→  } catch (err) {
   802→    debugLog("Failed to read hooks config for status", err);
   803→  }
   804→
   805→  // Check for legacy guard script files on disk
   806→  try {
   807→    const guardFiles = await fs.readdir(hooksDir);
   808→    for (const name of OLD_GUARD_SCRIPTS) {
   809→      if (guardFiles.includes(name)) {
   810→        hooks.guardsPresent.push(`legacy-file:${name}`);
   811→      }
   812→    }
   813→  } catch (err) {
   814→    debugLog("Hooks dir doesn't exist", err);
   815→  }
   816→
   817→  // Check skills
   818→  const skills = {
   819→    total: 0,
   820→    rendered: 0,
   821→    drifted: 0,
   822→  };
   823→
   824→  // Helper to scan a directory for skill subdirs with kspec-managed SKILL.md
   825→  async function scanForSkills(baseDir: string): Promise<void> {
   826→    try {
   827→      const dirs = await fs.readdir(baseDir, { withFileTypes: true });
   828→      for (const dir of dirs) {
   829→        if (dir.isDirectory()) {
   830→          const skillMdPath = path.join(baseDir, dir.name, "SKILL.md");
   831→          try {
   832→            const content = await fs.readFile(skillMdPath, "utf-8");
   833→            if (content.includes("<!-- kspec-managed -->")) {
   834→              skills.total++;
   835→              skills.rendered++;
   836→            }
   837→          } catch (_noSkillMd) {
   838→            // No SKILL.md
   839→          }
   840→        }
   841→      }
   842→    } catch (_notReadable) {
   843→      // Directory doesn't exist
   844→    }
   845→  }
   846→
   847→  // Scan .claude/skills/ (project/local skills)
   848→  await scanForSkills(skillsDir);
   849→
   850→  // Check plugin marketplace health
   851→  // AC: @enhanced-setup ac-7, ac-8
   852→  const plugin: SetupStatus["plugin"] = {
   853→    marketplaceRegistered: false,
   854→    marketplaceHealthy: false,
   855→    pluginEnabled: false,
   856→  };
   857→
   858→  try {
   859→    const { checkMarketplaceHealth } = await import(
   860→      "../../lib/claude-plugin-registry.js"
   861→    );
   862→    const health = await checkMarketplaceHealth();
   863→    plugin.marketplaceRegistered = health.status !== "missing";
   864→    plugin.marketplaceHealthy = health.status === "healthy";
   865→    plugin.registeredPath = health.registeredPath;
   866→    plugin.healthMessage = health.message;
   867→  } catch (err) {
   868→    debugLog("Could not check marketplace health", err);
   869→    plugin.healthMessage = "Health check unavailable";
   870→  }
   871→
   872→  // Check if plugin is enabled in project settings
   873→  try {
   874→    const configContent = await fs.readFile(configPath, "utf-8");
   875→    const config = JSON.parse(configContent);
   876→    plugin.pluginEnabled = config.enabledPlugins?.["kspec@kspec-plugins"] === true;
   877→  } catch (err) {
   878→    debugLog("Could not check plugin enablement", err);
   879→  }
   880→
   881→  // Check agents.md
   882→  const agentsMd: SetupStatus["agentsMd"] = {
   883→    exists: false,
   884→    status: "missing",
   885→  };
   886→
   887→  try {
   888→    await fs.access(agentsMdPath);
   889→    agentsMd.exists = true;
   890→
   891→    try {
   892→      const hashContent = await fs.readFile(hashPath, "utf-8");
   893→      const hashData = JSON.parse(hashContent);
   894→      agentsMd.generatedAt = hashData.generatedAt;
   895→
   896→      // AC: @cross-platform-and-version-robustness ac-4
   897→      // Compare stored hash against current meta to detect staleness
   898→      try {
   899→        const { initContext, loadMetaContext } = await import(
   900→          "../../parser/index.js"
   901→        );
   902→        const { computeMetaHash, loadTemplateSections, getPackageRoot } = await import("./agents.js");
   903→        const ctx = await initContext();
   904→        if (ctx.manifestPath) {
   905→          const metaCtx = await loadMetaContext(ctx);
   906→          let templateSections: string[] = [];
   907→          try {
   908→            templateSections = await loadTemplateSections(getPackageRoot());
   909→          } catch (err) {
   910→            debugLog("Templates not available for staleness check", err);
   911→          }
   912→          const currentHash = computeMetaHash(
   913→            metaCtx.skills,
   914→            metaCtx.conventions,
   915→            metaCtx.workflows,
   916→            templateSections,
   917→          );
   918→          agentsMd.status = hashData.metaHash === currentHash ? "current" : "stale";
   919→        } else {
   920→          // AC: @doctor-command ac-staleness-unknown — no manifest means we can't determine staleness
   921→          agentsMd.status = "unknown";
   922→        }
   923→      } catch (err) {
   924→        // AC: @doctor-command ac-staleness-unknown — hash computation failed
   925→        debugLog("Could not compute meta hash for staleness check", err);
   926→        agentsMd.status = "unknown";
   927→      }
   928→    } catch (err) {
   929→      debugLog("Hash file missing or invalid, marking stale", err);
   930→      agentsMd.status = "stale";
   931→    }
   932→  } catch (err) {
   933→    debugLog("kspec-agents.md doesn't exist", err);
   934→  }
   935→
   936→  // Check seeding state
   937→  const seeding: SetupStatus["seeding"] = {
   938→    permissionsSeeded: false,
   939→    memorySeeded: false,
   940→  };
   941→
   942→  try {
   943→    const configContent = await fs.readFile(
   944→      path.join(projectDir, ".claude", "settings.json"),
   945→      "utf-8",
   946→    );
   947→    const config = JSON.parse(configContent);
   948→    seeding.permissionsSeeded = !!config.permissions;
   949→  } catch (err) {
   950→    debugLog("Could not check permissions seeding state", err);
   951→  }
   952→
   953→  if (detected.type === "claude-code") {
   954→    try {
   955→      const { claudeCodeMemoryWriter } = await import("./setup-seeding.js");
   956→      const memoryExists = await claudeCodeMemoryWriter.exists(projectDir);
   957→      seeding.memorySeeded = memoryExists;
   958→      if (memoryExists) {
   959→        seeding.memoryPath = claudeCodeMemoryWriter.getMemoryPath(projectDir);
   960→      }
   961→    } catch (err) {
   962→      debugLog("Could not check memory seeding state", err);
   963→    }
   964→  }
   965→
   966→  return {
   967→    agent: {
   968→      detected: detected.type,
   969→      confidence: detected.confidence,
   970→    },
   971→    hooks,
   972→    skills,
   973→    plugin,
   974→    agentsMd,
   975→    seeding,
   976→  };
   977→}
   978→
   979→/**
   980→ * Render skills using the platform renderer registry
   981→ * AC: @setup-pipeline-unification ac-2 - uses getRenderer/getAllRenderers, not legacy renderClaudeCodeSkill
   982→ * AC: @setup-pipeline-unification ac-4 - errors logged at debug level
   983→ */
   984→async function renderSkillsForSetup(
   985→  projectDir: string,
   986→  dryRun: boolean,
   987→): Promise<{ rendered: number; skipped: number; pluginProvided: number; skillIds: string[] }> {
   988→  // Dynamically import to avoid circular dependencies
   989→  const { initContext, loadMetaContext } = await import(
   990→    "../../parser/index.js"
   991→  );
   992→  const { getRenderer } = await import("../../parser/skill-render.js");
   993→
   994→  try {
   995→    const ctx = await initContext();
   996→
   997→    if (!ctx.manifestPath) {
   998→      return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
   999→    }
  1000→
  1001→    const metaCtx = await loadMetaContext(ctx);
  1002→
  1003→    // Collect all skills that have a registered renderer for their platform
  1004→    const skillsToRender: Array<{ skill: typeof metaCtx.skills[0]; platform: string }> = [];
  1005→    for (const skill of metaCtx.skills) {
  1006→      for (const platform of skill.platforms) {
  1007→        const renderer = getRenderer(platform);
  1008→        if (renderer) {
  1009→          skillsToRender.push({ skill, platform });
  1010→        }
  1011→      }
  1012→    }
  1013→
  1014→    if (skillsToRender.length === 0) {
  1015→      return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1016→    }
  1017→
  1018→    let rendered = 0;
  1019→    let skipped = 0;
  1020→    let pluginProvided = 0;
  1021→    const skillIds: string[] = [];
  1022→
  1023→    for (const { skill, platform } of skillsToRender) {
  1024→      const renderer = getRenderer(platform)!;
  1025→      try {
  1026→        const result = await renderer.render(ctx, projectDir, skill, {
  1027→          dryRun,
  1028→        });
  1029→        if (result.action === "created" || result.action === "updated") {
  1030→          rendered++;
  1031→          if (!skillIds.includes(skill.id)) {
  1032→            skillIds.push(skill.id);
  1033→          }
  1034→        } else if (result.action === "skipped" && result.skipCode === "plugin-provided") {
  1035→          pluginProvided++;
  1036→        } else {
  1037→          skipped++;
  1038→        }
  1039→      } catch (err) {
  1040→        debugLog(`Failed to render skill ${skill.id} for ${platform}`, err);
  1041→        skipped++;
  1042→      }
  1043→    }
  1044→
  1045→    return { rendered, skipped, pluginProvided, skillIds };
  1046→  } catch (err) {
  1047→    debugLog("renderSkillsForSetup failed", err);
  1048→    return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1049→  }
  1050→}
  1051→
  1052→/**
  1053→ * Generate kspec-agents.md using the canonical implementation from agents.ts
  1054→ * AC: @setup-pipeline-unification ac-1 - calls generateAgentsContent() from agents.ts
  1055→ * AC: @setup-pipeline-unification ac-4 - errors logged at debug level
  1056→ */
  1057→async function generateAgentInstructions(
  1058→  projectDir: string,
  1059→  dryRun: boolean,
  1060→): Promise<{ success: boolean; path: string; skipped?: boolean }> {
  1061→  const outputPath = path.join(projectDir, "kspec-agents.md");
  1062→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
  1063→
  1064→  // Dynamically import to avoid circular dependencies
  1065→  const { initContext, loadMetaContext } = await import(
  1066→    "../../parser/index.js"
  1067→  );
  1068→  const {
  1069→    generateAgentsContent,
  1070→    loadTemplateSections,
  1071→    getPackageRoot,
  1072→    computeMetaHash,
  1073→  } = await import("./agents.js");
  1074→
  1075→  try {
  1076→    const ctx = await initContext();
  1077→
  1078→    if (!ctx.manifestPath) {
  1079→      return { success: false, path: outputPath };
  1080→    }
  1081→
  1082→    const metaCtx = await loadMetaContext(ctx);
  1083→    const timestamp = new Date().toISOString();
  1084→
  1085→    // Load templates using the canonical implementation
  1086→    let templateSections: string[] = [];
  1087→    try {
  1088→      templateSections = await loadTemplateSections(getPackageRoot());
  1089→    } catch (err) {
  1090→      debugLog("Failed to load template sections", err);
  1091→    }
  1092→
  1093→    // Generate content using the canonical implementation from agents.ts
  1094→    const content = await generateAgentsContent(
  1095→      metaCtx.skills,
  1096→      metaCtx.conventions,
  1097→      metaCtx.workflows,
  1098→      timestamp,
  1099→      templateSections,
  1100→    );
  1101→
  1102→    if (!dryRun) {
  1103→      // Compute meta hash for freshness tracking
  1104→      const metaHash = computeMetaHash(
  1105→        metaCtx.skills,
  1106→        metaCtx.conventions,
  1107→        metaCtx.workflows,
  1108→        templateSections,
  1109→      );
  1110→
  1111→      // Skip regeneration when content unchanged (same pattern as kspec agents generate)
  1112→      let storedHash: string | undefined;
  1113→      try {
  1114→        const hashContent = await fs.readFile(hashPath, "utf-8");
  1115→        const hashData = JSON.parse(hashContent);
  1116→        storedHash = hashData.metaHash;
  1117→      } catch (_err) {
  1118→        // No hash file or invalid — regenerate
  1119→      }
  1120→
  1121→      // Only skip if hash matches AND the output file actually exists
  1122→      let outputExists = false;
  1123→      try {
  1124→        await fs.access(outputPath);
  1125→        outputExists = true;
  1126→      } catch (_e) {
  1127→        // File missing — must regenerate even if hash matches
  1128→      }
  1129→
  1130→      if (storedHash === metaHash && outputExists) {
  1131→        return { success: true, path: outputPath, skipped: true };
  1132→      }
  1133→
  1134→      await fs.writeFile(outputPath, content, "utf-8");
  1135→
  1136→      await fs.mkdir(path.dirname(hashPath), { recursive: true });
  1137→      // Dynamically import version to avoid top-level require
  1138→      const { createRequire } = await import("node:module");
  1139→      const req = createRequire(import.meta.url);
  1140→      const { version } = req("../../../package.json");
  1141→
  1142→      await fs.writeFile(
  1143→        hashPath,
  1144→        JSON.stringify(
  1145→          {
  1146→            metaHash,
  1147→            generatedAt: timestamp,
  1148→            version,
  1149→          },
  1150→          null,
  1151→          2,
  1152→        ),
  1153→        "utf-8",
  1154→      );
  1155→    }
  1156→
  1157→    return { success: true, path: outputPath };
  1158→  } catch (err) {
  1159→    debugLog("generateAgentInstructions failed", err);
  1160→    return { success: false, path: outputPath };
  1161→  }
  1162→}
  1163→
  1164→/**
  1165→ * Install core skills for the setup pipeline
  1166→ * AC: @init-setup-integration ac-2 - core skills installed
  1167→ */
  1168→async function installCoreSkillsForSetup(
  1169→  projectDir: string,
  1170→  dryRun: boolean
  1171→): Promise<{
  1172→  installed: number;
  1173→  skipped: number;
  1174→  marketplaceRegistered?: boolean;
  1175→  pluginEnabled?: boolean;
  1176→  marketplaceMessage?: string;
  1177→  enableMessage?: string;
  1178→}> {
  1179→  // Dynamically import to avoid circular dependencies
  1180→  const {
  1181→    initContext,
  1182→    loadMetaContext,
  1183→    saveMetaItem,
  1184→    getSkillContentPath,
  1185→  } = await import("../../parser/index.js");
  1186→  const { commitIfShadow } = await import("../../parser/shadow.js");
  1187→  const { SkillSchema } = await import("../../schema/index.js");
  1188→  const {
  1189→    loadCoreSkillsManifest,
  1190→    copyCoreSkillFiles,
  1191→    getKspecPackageVersion,
  1192→  } = await import("./skill.js");
  1193→  const { ulid } = await import("ulid");
  1194→
  1195→  let installed = 0;
  1196→  let skipped = 0;
  1197→
  1198→  try {
  1199→    const ctx = await initContext();
  1200→
  1201→    if (!ctx.manifestPath) {
  1202→      return { installed: 0, skipped: 0 };
  1203→    }
  1204→
  1205→    const metaCtx = await loadMetaContext(ctx);
  1206→    const coreSkills = await loadCoreSkillsManifest();
  1207→    // AC: @cross-platform-and-version-robustness ac-3
  1208→    const kspecVersion = await getKspecPackageVersion();
  1209→    if (!kspecVersion) {
  1210→      debugLog("Could not determine kspec version — skills installed without version tracking");
  1211→    }
  1212→
  1213→    for (const coreSkill of coreSkills) {
  1214→      // Check if skill exists
  1215→      const existingSkill = metaCtx.skills.find((s) => s.id === coreSkill.id);
  1216→
  1217→      if (existingSkill && existingSkill.origin !== "core") {
  1218→        // Custom/project skill exists, skip
  1219→        skipped++;
  1220→        continue;
  1221→      }
  1222→
  1223→      // Build skill data
  1224→      const skillData = {
  1225→        _ulid: existingSkill?._ulid || ulid(),
  1226→        id: coreSkill.id,
  1227→        name: coreSkill.name,
  1228→        description: coreSkill.description,
  1229→        origin: "core" as const,
  1230→        ...(kspecVersion && { version: kspecVersion }),
  1231→        platforms: coreSkill.platforms || ["claude-code"],
  1232→        depends_on: [],
  1233→        tags: ["core"],
  1234→      };
  1235→
  1236→      const parsed = SkillSchema.safeParse(skillData);
  1237→      if (!parsed.success) {
  1238→        skipped++;
  1239→        continue;
  1240→      }
  1241→
  1242→      if (!dryRun) {
  1243→        await saveMetaItem(ctx, parsed.data, "skill");
  1244→
  1245→        // Copy skill files (SKILL.md + supporting dirs)
  1246→        const targetDir = path.dirname(getSkillContentPath(ctx, parsed.data.id));
  1247→        await copyCoreSkillFiles(coreSkill.id, targetDir);
  1248→      }
  1249→
  1250→      installed++;
  1251→    }
  1252→
  1253→    // Commit changes
  1254→    if (!dryRun && installed > 0) {
  1255→      const ctx2 = await initContext();
  1256→      await commitIfShadow(
  1257→        ctx2.shadow,
  1258→        "skill-install-core",
  1259→        `${installed} core skills`
  1260→      );
  1261→    }
  1262→
  1263→    // AC: @core-skill-install ac-6, ac-7 - Register marketplace and enable plugin
  1264→    let marketplaceResult;
  1265→    let enableResult;
  1266→    if (!dryRun) {
  1267→      const {
  1268→        registerCorePluginMarketplace,
  1269→        enablePluginInProject,
  1270→      } = await import("../../lib/claude-plugin-registry.js");
  1271→      marketplaceResult = await registerCorePluginMarketplace();
  1272→      enableResult = await enablePluginInProject(projectDir);
  1273→    }
  1274→
  1275→    return {
  1276→      installed,
  1277→      skipped,
  1278→      marketplaceRegistered: marketplaceResult?.success ?? false,
  1279→      pluginEnabled: enableResult?.success ?? false,
  1280→      marketplaceMessage: marketplaceResult?.message,
  1281→      enableMessage: enableResult?.message,
  1282→    };
  1283→  } catch (err) {
  1284→    debugLog("installCoreSkillsForSetup failed", err);
  1285→    return { installed: 0, skipped: 0 };
  1286→  }
  1287→}
  1288→
  1289→/**
  1290→ * Run the full setup pipeline programmatically.
  1291→ * Used by both 'kspec setup' command and 'kspec init --setup'.
  1292→ * AC: @init-setup-integration ac-2, ac-3
  1293→ */
  1294→export async function runSetupPipeline(
  1295→  projectDir: string,
  1296→  options: SetupPipelineOptions
  1297→): Promise<SetupPipelineResult> {
  1298→  const dryRun = options.dryRun ?? false;
  1299→  const skipSkills = options.skipSkills ?? false;
  1300→  const installHooksFlag = options.installHooks ?? true;
  1301→
  1302→  const steps: SetupStepResult[] = [];
  1303→  let coreSkillsInstalled = 0;
  1304→  let skillsRendered = 0;
  1305→  let hooksInstalled = false;
  1306→  let agentsMdGenerated = false;
  1307→  let permissionsSeeded = false;
  1308→  let memorySeeded = false;
  1309→
  1310→  try {
  1311→    const detected = options.agent
  1312→      ? buildDetectedAgent(options.agent)
  1313→      : detectAgent();
  1314→
  1315→    // Step 1: Agent detection
  1316→    steps.push({
  1317→      name: "Agent detection",
  1318→      status: "done",
  1319→      message: `${detected.type} (${detected.confidence} confidence)`,
  1320→    });
  1321→
  1322→    // Step 2: Install core skills
  1323→    // AC: @init-setup-integration ac-2 - core skills installed in .kspec/skills/
  1324→    const coreResult = await installCoreSkillsForSetup(projectDir, dryRun);
  1325→    coreSkillsInstalled = coreResult.installed;
  1326→
  1327→    if (coreResult.installed > 0 || coreResult.skipped > 0) {
  1328→      steps.push({
  1329→        name: "Install core skills",
  1330→        status: "done",
  1331→        message: `${coreResult.installed} installed, ${coreResult.skipped} skipped`,
  1332→      });
  1333→    } else {
  1334→      steps.push({
  1335→        name: "Install core skills",
  1336→        status: "skipped",
  1337→        message: "No core skills found in package",
  1338→      });
  1339→    }
  1340→
  1341→    // Step 2b: Register plugin marketplace (reports result from installCoreSkillsForSetup)
  1342→    // AC: @core-skill-install ac-6, ac-7
  1343→    if (!dryRun && (coreResult.installed > 0 || coreResult.skipped > 0)) {
  1344→      const bothOk = coreResult.marketplaceRegistered && coreResult.pluginEnabled;
  1345→      if (bothOk) {
  1346→        steps.push({
  1347→          name: "Register plugin marketplace",
  1348→          status: "done",
  1349→          message: "marketplace registered, plugin enabled",
  1350→        });
  1351→      } else {
  1352→        const failures: string[] = [];
  1353→        if (!coreResult.marketplaceRegistered) {
  1354→          failures.push(coreResult.marketplaceMessage || "marketplace registration failed");
  1355→        }
  1356→        if (!coreResult.pluginEnabled) {
  1357→          failures.push(coreResult.enableMessage || "plugin enablement failed");
  1358→        }
  1359→        steps.push({
  1360→          name: "Register plugin marketplace",
  1361→          status: "failed",
  1362→          message: failures.join("; "),
  1363→        });
  1364→      }
  1365→    }
  1366→
  1367→    // Step 3: Install hooks (Claude Code only)
  1368→    // AC: @init-setup-integration ac-3 - hooks present
  1369→    if (detected.type === "claude-code" && installHooksFlag) {
  1370→      const hooksResult = await installClaudeCodeHooks(projectDir, dryRun);
  1371→      const installedHooks: string[] = [];
  1372→      if (hooksResult.promptCheck) installedHooks.push("UserPromptSubmit");
  1373→      if (hooksResult.stop) installedHooks.push("Stop");
  1374→      if (hooksResult.preToolUse) installedHooks.push("PreToolUse");
  1375→
  1376→      hooksInstalled =
  1377→        hooksResult.promptCheck || hooksResult.stop || hooksResult.preToolUse;
  1378→
  1379→      steps.push({
  1380→        name: "Install hooks",
  1381→        status: "done",
  1382→        message: installedHooks.join(", "),
  1383→        details: {
  1384→          guards: hooksResult.guardsCreated,
  1385→        },
  1386→      });
  1387→    } else if (!installHooksFlag) {
  1388→      steps.push({
  1389→        name: "Install hooks",
  1390→        status: "skipped",
  1391→        message: "--no-hooks flag",
  1392→      });
  1393→    } else {
  1394→      steps.push({
  1395→        name: "Install hooks",
  1396→        status: "skipped",
  1397→        message: `not applicable for ${detected.type}`,
  1398→      });
  1399→    }
  1400→
  1401→    // Step 3a: Ensure artifacts directory exists
  1402→    // AC: @artifacts-directory ac-setup-ensures
  1403→    {
  1404→      const artifactsDir = path.join(projectDir, ".kspec", "artifacts");
  1405→      let artifactsCreated = false;
  1406→      try {
  1407→        await fs.access(artifactsDir);
  1408→      } catch (_e) {
  1409→        if (!dryRun) {
  1410→          await fs.mkdir(artifactsDir, { recursive: true });
  1411→        }
  1412→        artifactsCreated = true;
  1413→      }
  1414→      steps.push({
  1415→        name: "Ensure artifacts directory",
  1416→        status: artifactsCreated ? "done" : "skipped",
  1417→        message: artifactsCreated ? "created .kspec/artifacts/" : "already exists",
  1418→      });
  1419→    }
  1420→
  1421→    // Step 3b: Seed permissions (Claude Code only)
  1422→    // AC: @new-project-bootstrapping ac-1
  1423→    {
  1424→      const { seedPermissions } = await import("./setup-seeding.js");
  1425→      const permResult = await seedPermissions(projectDir, detected.type, {
  1426→        dryRun,
  1427→        force: options.force,
  1428→      });
  1429→      permissionsSeeded = permResult.seeded;
  1430→
  1431→      steps.push({
  1432→        name: "Seed permissions",
  1433→        status: permResult.seeded ? "done" : "skipped",
  1434→        message: permResult.message,
  1435→      });
  1436→    }
  1437→
  1438→    // Step 3c: Seed memory (platform-extensible)
  1439→    // AC: @new-project-bootstrapping ac-2, ac-3
  1440→    {
  1441→      const { seedMemory } = await import("./setup-seeding.js");
  1442→      const memResult = await seedMemory(projectDir, detected.type, {
  1443→        dryRun,
  1444→        force: options.force,
  1445→      });
  1446→      memorySeeded = memResult.seeded;
  1447→      const memoryStepStatus =
  1448→        memResult.message.startsWith("failed:")
  1449→          ? "failed"
  1450→          : memResult.seeded
  1451→            ? "done"
  1452→            : "skipped";
  1453→
  1454→      steps.push({
  1455→        name: "Seed memory",
  1456→        status: memoryStepStatus,
  1457→        message: memResult.seeded ? memResult.path : memResult.message,
  1458→      });
  1459→    }
  1460→
  1461→    // Step 4: Render skills
  1462→    // AC: @init-setup-integration ac-3 - rendered skill files present
  1463→    if (!skipSkills) {
  1464→      const skillsResult = await renderSkillsForSetup(projectDir, dryRun);
  1465→      skillsRendered = skillsResult.rendered;
  1466→
  1467→      if (skillsResult.rendered > 0 || skillsResult.skipped > 0 || skillsResult.pluginProvided > 0) {
  1468→        const parts = [];
  1469→        if (skillsResult.rendered > 0) parts.push(`${skillsResult.rendered} rendered`);
  1470→        if (skillsResult.pluginProvided > 0) parts.push(`${skillsResult.pluginProvided} plugin-provided`);
  1471→        if (skillsResult.skipped > 0) parts.push(`${skillsResult.skipped} unchanged`);
  1472→        steps.push({
  1473→          name: "Render skills",
  1474→          status: "done",
  1475→          message: parts.join(", "),
  1476→          details: {
  1477→            skillIds: skillsResult.skillIds,
  1478→          },
  1479→        });
  1480→      } else {
  1481→        steps.push({
  1482→          name: "Render skills",
  1483→          status: "skipped",
  1484→          message: "No skills with registered renderers in meta",
  1485→        });
  1486→      }
  1487→    } else {
  1488→      steps.push({
  1489→        name: "Render skills",
  1490→        status: "skipped",
  1491→        message: "--skip-skills flag",
  1492→      });
  1493→    }
  1494→
  1495→    // Step 5: Generate kspec-agents.md
  1496→    // AC: @init-setup-integration ac-3 - kspec-agents.md present
  1497→    const agentsResult = await generateAgentInstructions(projectDir, dryRun);
  1498→    agentsMdGenerated = agentsResult.success;
  1499→
  1500→    if (agentsResult.success) {
  1501→      steps.push({
  1502→        name: "Generate kspec-agents.md",
  1503→        status: "done",
  1504→        message: agentsResult.skipped
  1505→          ? "already up to date"
  1506→          : agentsResult.path,
  1507→      });
  1508→    } else {
  1509→      steps.push({
  1510→        name: "Generate kspec-agents.md",
  1511→        status: "failed",
  1512→        message: "No kspec project found",
  1513→      });
  1514→    }
  1515→
  1516→    // Step 6: Configure author (optional, used by setup command)
  1517→    if (options.configureAuthor) {
  1518→      const author = options.author || getDefaultAuthor(detected.type);
  1519→      if (!options.force && process.env.KSPEC_AUTHOR) {
  1520→        steps.push({
  1521→          name: "Configure author",
  1522→          status: "skipped",
  1523→          message: `KSPEC_AUTHOR already set to "${process.env.KSPEC_AUTHOR}"`,
  1524→        });
  1525→      } else {
  1526→        let authorInstalled = false;
  1527→        switch (detected.type) {
  1528→          case "claude-code":
  1529→            if (!dryRun) {
  1530→              authorInstalled = await installClaudeCodeConfig(author);
  1531→            } else {
  1532→              authorInstalled = true;
  1533→            }
  1534→            break;
  1535→          case "aider":
  1536→            if (!dryRun) {
  1537→              authorInstalled = await installAiderConfig(author);
  1538→            } else {
  1539→              authorInstalled = true;
  1540→            }
  1541→            break;
  1542→          default:
  1543→            break;
  1544→        }
  1545→
  1546→        if (authorInstalled) {
  1547→          steps.push({
  1548→            name: "Configure author",
  1549→            status: "done",
  1550→            message: `KSPEC_AUTHOR="${author}"`,
  1551→          });
  1552→        }
  1553→      }
  1554→    }
  1555→
  1556→    // Output summary
  1557→    if (!dryRun) {
  1558→      console.log(chalk.bold("kspec Setup Summary\n"));
  1559→
  1560→      for (const step of steps) {
  1561→        const icon =
  1562→          step.status === "done"
  1563→            ? chalk.green("✓")
  1564→            : step.status === "skipped"
  1565→              ? chalk.gray("○")
  1566→              : chalk.red("✗");
  1567→        const statusText =
  1568→          step.status === "done"
  1569→            ? ""
  1570→            : step.status === "skipped"
  1571→              ? chalk.gray(" (skipped)")
  1572→              : chalk.red(" (failed)");
  1573→
  1574→        console.log(`${icon} ${step.name}${statusText}`);
  1575→        if (step.message) {
  1576→          console.log(chalk.gray(`  ${step.message}`));
  1577→        }
  1578→      }
  1579→    }
  1580→
  1581→    const success = steps.every((s) => s.status !== "failed");
  1582→
  1583→    return {
  1584→      success,
  1585→      steps,
  1586→      coreSkillsInstalled,
  1587→      skillsRendered,
  1588→      hooksInstalled,
  1589→      agentsMdGenerated,
  1590→      permissionsSeeded,
  1591→      memorySeeded,
  1592→    };
  1593→  } catch (err) {
  1594→    debugLog("runSetupPipeline failed", err);
  1595→    return {
  1596→      success: false,
  1597→      steps,
  1598→      coreSkillsInstalled,
  1599→      skillsRendered,
  1600→      hooksInstalled,
  1601→      agentsMdGenerated,
  1602→      permissionsSeeded,
  1603→      memorySeeded,
  1604→    };
  1605→  }
  1606→}
  1607→
  1608→/**
  1609→ * Register the 'setup' command
  1610→ * AC: @enhanced-setup ac-1 through ac-9
  1611→ */
  1612→export function registerSetupCommand(program: Command): void {
  1613→  program
  1614→    .command("setup")
  1615→    .description("Configure agent environment for kspec (orchestrated pipeline)")
  1616→    .option(
  1617→      "--agent <type>",
  1618→      "Explicit agent type override (claude-code|cline|cursor|windsurf|unknown)",
  1619→    )
  1620→    .option("--dry-run", "Show what would be done without making changes")
  1621→    .option(
  1622→      "--author <author>",
  1623→      "Custom author string (default: auto-detected based on agent)",
  1624→    )
  1625→    .option("--no-hooks", "Skip installing hooks")
  1626→    .option("--skip-skills", "Skip rendering skills")
  1627→    .option("--status", "Report current setup state without making changes")
  1628→    .option("--force", "Overwrite existing configuration")
  1629→    .option(
  1630→      "--auto-worktree",
  1631→      "Automatically create .kspec worktree if kspec-meta branch exists",
  1632→    )
  1633→    .action(async (options) => {
  1634→      try {
  1635→        const projectDir = process.cwd();
  1636→        const agentOverride = options.agent
  1637→          ? parseSetupAgentOverride(options.agent)
  1638→          : undefined;
  1639→
  1640→        // AC: @enhanced-setup ac-7, ac-8 - --status mode
  1641→        if (options.status) {
  1642→          const status = await getSetupStatus(projectDir, agentOverride);
  1643→
  1644→          output(status, () => {
  1645→            console.log(chalk.bold("kspec Setup Status\n"));
  1646→
  1647→            // Agent detection
  1648→            console.log(chalk.gray("Agent:"));
  1649→            console.log(
  1650→              `  Detected: ${status.agent.detected} (${status.agent.confidence} confidence)`,
  1651→            );
  1652→            console.log();
  1653→
  1654→            // Hooks status
  1655→            console.log(chalk.gray("Hooks:"));
  1656→            console.log(
  1657→              `  UserPromptSubmit: ${status.hooks.promptCheck ? chalk.green("✓") : chalk.red("✗")}`,
  1658→            );
  1659→            console.log(
  1660→              `  Stop:             ${status.hooks.stop ? chalk.green("✓") : chalk.red("✗")}`,
  1661→            );
  1662→            console.log(
  1663→              `  PreToolUse:       ${status.hooks.preToolUse ? chalk.green("✓") : chalk.red("✗")}`,
  1664→            );
  1665→            if (status.hooks.guardsPresent.length > 0) {
  1666→              console.log(
  1667→                `  Guards:           ${status.hooks.guardsPresent.join(", ")}`,
  1668→              );
  1669→            }
  1670→            console.log();
  1671→
  1672→            // Skills status
  1673→            console.log(chalk.gray("Skills:"));
  1674→            console.log(`  Rendered: ${status.skills.rendered}`);
  1675→            if (status.skills.drifted > 0) {
  1676→              console.log(
  1677→                `  Drifted:  ${chalk.yellow(status.skills.drifted.toString())}`,
  1678→              );
  1679→            }
  1680→            console.log();
  1681→
  1682→            // Plugin marketplace status
  1683→            // AC: @enhanced-setup ac-7, ac-8
  1684→            console.log(chalk.gray("Plugin:"));
  1685→            console.log(
  1686→              `  Marketplace: ${status.plugin.marketplaceRegistered ? (status.plugin.marketplaceHealthy ? chalk.green("healthy") : chalk.yellow("registered")) : chalk.red("not registered")}`,
  1687→            );
  1688→            console.log(
  1689→              `  Enabled:     ${status.plugin.pluginEnabled ? chalk.green("✓") : chalk.red("✗")}`,
  1690→            );
  1691→            if (status.plugin.registeredPath) {
  1692→              console.log(chalk.gray(`  Path: ${status.plugin.registeredPath}`));
  1693→            }
  1694→            if (status.plugin.healthMessage && !status.plugin.marketplaceHealthy) {
  1695→              console.log(chalk.yellow(`  ${status.plugin.healthMessage}`));
  1696→            }
  1697→            console.log();
  1698→
  1699→            // Agents.md status
  1700→            console.log(chalk.gray("kspec-agents.md:"));
  1701→            if (status.agentsMd.exists) {
  1702→              // AC: @doctor-command ac-staleness-unknown — show appropriate color for unknown status
  1703→              const statusColor =
  1704→                status.agentsMd.status === "current"
  1705→                  ? chalk.green
  1706→                  : status.agentsMd.status === "unknown"
  1707→                    ? chalk.yellow
  1708→                    : chalk.yellow;
  1709→              console.log(`  Status: ${statusColor(status.agentsMd.status)}`);
  1710→              if (status.agentsMd.status === "unknown") {
  1711→                console.log(chalk.gray("  Could not determine staleness (no manifest or hash unavailable)"));
  1712→              }
  1713→              if (status.agentsMd.generatedAt) {
  1714→                console.log(`  Generated: ${status.agentsMd.generatedAt}`);
  1715→              }
  1716→            } else {
  1717→              console.log(`  Status: ${chalk.red("missing")}`);
  1718→              console.log(
  1719→                chalk.gray("  Run 'kspec setup' to generate"),
  1720→              );
  1721→            }
  1722→            console.log();
  1723→
  1724→            // Seeding status
  1725→            console.log(chalk.gray("Seeding:"));
  1726→            console.log(
  1727→              `  Permissions: ${status.seeding.permissionsSeeded ? chalk.green("✓") : chalk.gray("○")}`,
  1728→            );
  1729→            console.log(
  1730→              `  Memory:      ${status.seeding.memorySeeded ? chalk.green("✓") : chalk.gray("○")}`,
  1731→            );
  1732→            if (status.seeding.memoryPath) {
  1733→              console.log(
  1734→                chalk.gray(`  Path: ${status.seeding.memoryPath}`),
  1735→              );
  1736→            }
  1737→          });
  1738→          return;
  1739→        }
  1740→
  1741→        // AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
  1742→        const worktreeReady = await ensureWorktree(
  1743→          options.autoWorktree || false,
  1744→        );
  1745→        if (!worktreeReady) {
  1746→          // User declined worktree creation or it failed
  1747→          process.exit(EXIT_CODES.ERROR);
  1748→        }
  1749→
  1750→        const detected = agentOverride
  1751→          ? buildDetectedAgent(agentOverride)
  1752→          : detectAgent();
  1753→        const dryRun = options.dryRun || false;
  1754→
  1755→        if (detected.type === "unknown") {
  1756→          warn("Could not auto-detect agent environment");
  1757→          printManualInstructions("unknown");
  1758→          return;
  1759→        }
  1760→
  1761→        // AC: @setup-pipeline-unification ac-3 - delegate to runSetupPipeline()
  1762→        // One code path for both 'kspec setup' and 'kspec init --setup'
  1763→        const result = await runSetupPipeline(projectDir, {
  1764→          dryRun,
  1765→          skipSkills: options.skipSkills || false,
  1766→          installHooks: options.hooks !== false,
  1767→          force: options.force || false,
  1768→          agent: agentOverride,
  1769→          author: options.author,
  1770→          configureAuthor: true,
  1771→        });
  1772→
  1773→        // AC: @enhanced-setup ac-1 - Display summary
  1774→        // AC: @enhanced-setup ac-6 - dry-run displays planned actions
  1775→        output(
  1776→          {
  1777→            dry_run: dryRun,
  1778→            steps: result.steps.map((s) => ({
  1779→              name: s.name,
  1780→              status: s.status,
  1781→              message: s.message,
  1782→              details: s.details,
  1783→            })),
  1784→          },
  1785→          () => {
  1786→            if (dryRun) {
  1787→              console.log(chalk.yellow("DRY RUN - No changes made\n"));
  1788→            }
  1789→
  1790→            // Pipeline already prints the summary when not dry-run
  1791→            // For dry-run, print it here since the pipeline skips output
  1792→            if (dryRun) {
  1793→              console.log(chalk.bold("kspec Setup Summary\n"));
  1794→
  1795→              for (const step of result.steps) {
  1796→                const icon =
  1797→                  step.status === "done"
  1798→                    ? chalk.green("✓")
  1799→                    : step.status === "skipped"
  1800→                      ? chalk.gray("○")
  1801→                      : chalk.red("✗");
  1802→                const statusText =
  1803→                  step.status === "done"
  1804→                    ? ""
  1805→                    : step.status === "skipped"
  1806→                      ? chalk.gray(" (skipped)")
  1807→                      : chalk.red(" (failed)");
  1808→
  1809→                console.log(`${icon} ${step.name}${statusText}`);
  1810→                if (step.message) {
  1811→                  console.log(chalk.gray(`  ${step.message}`));
  1812→                }
  1813→              }
  1814→            }
  1815→
  1816→            console.log();
  1817→
  1818→            if (dryRun) {
