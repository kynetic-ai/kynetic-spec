    85→/**
    86→ * Spec item with runtime metadata for source tracking.
    87→ * _sourceFile is not serialized - it's used to know where to write updates.
    88→ * _path tracks location within the file for nested items (e.g., "features[0].requirements[2]")
    89→ */
    90→export interface LoadedSpecItem extends SpecItem {
    91→  _sourceFile?: string;
    92→  _path?: string;
    93→}
