   102→
   103→/**
   104→ * Parse YAML content into an object
   105→ * Uses the modern yaml library which has consistent type handling
   106→ */
   107→export function parseYaml<T>(content: string): T {
   108→  return YAML.parse(content) as T;
   109→}
   110→
   111→/**
   112→ * Serialize object to YAML
   113→ * Uses the modern yaml library for consistent formatting.
   114→ *
   115→ * WORKAROUND: The 'yaml' library (v2.8.2+) has a known behavior where block scalars
   116→ * containing whitespace-only lines accumulate extra blank lines on each parse-stringify
   117→ * cycle. The library's blockString() function adds indentation after newlines, which
   118→ * causes lines containing only spaces to grow. We post-process the output to filter
   119→ * these whitespace-only lines. See: https://github.com/eemeli/yaml - stringifyString.ts
   120→ */
   121→export function toYaml(obj: unknown): string {
   122→  let yamlString = YAML.stringify(obj, {
   123→    indent: 2,
   124→    lineWidth: 100,
   125→    sortMapEntries: false,
   126→  });
   127→
   128→  // Post-process to fix yaml library blank line accumulation bug.
   129→  // Filter out lines that contain only spaces/tabs (not truly empty lines).
   130→  yamlString = yamlString
   131→    .split("\n")
   132→    .filter((line) => !/^[ \t]+$/.test(line))
   133→    .join("\n");
   134→
   135→  return yamlString;
   136→}
   137→
   138→/**
   139→ * Read a text file with batch buffer overlay semantics.
   140→ */
   141→export async function readFileBufferAware(filePath: string): Promise<string> {
   142→  // AC: @batch-write-buffer ac-2 — check buffer first for read-after-write consistency
   143→  const buffer = getActiveBatchBuffer();
   144→  if (buffer?.isInScope(filePath)) {
   145→    const buffered = buffer.read(filePath);
   146→    if (buffered !== undefined) {
   147→      if (buffered === null) {
   148→        // File was deleted in this batch
   149→        throw Object.assign(new Error(`ENOENT: no such file or directory, open '${filePath}'`), {
   150→          code: "ENOENT",
   151→        });
   152→      }
   153→      return typeof buffered === "string"
   154→        ? buffered
   155→        : Buffer.from(buffered).toString("utf-8");
   156→    }
   157→  }
   158→
   159→  return fs.readFile(filePath, "utf-8");
   160→}
   161→
   162→/**
   163→ * Read and parse a YAML file.
   164→ */
   165→export async function readYamlFile<T>(filePath: string): Promise<T> {
   166→  const content = await readFileBufferAware(filePath);
   167→  return parseYaml<T>(content);
   168→}
   169→
   170→/**
   171→ * Write object to YAML file
   172→ */
   173→export async function writeYamlFile(
   174→  filePath: string,
   175→  data: unknown,
   176→): Promise<void> {
   177→  const content = toYaml(data);
   178→  // AC: @batch-write-buffer ac-1 — buffer write if in batch mode
   179→  const buffer = getActiveBatchBuffer();
   180→  if (buffer?.isInScope(filePath)) {
   181→    buffer.write(filePath, content);
   182→    return;
   183→  }
   184→  await fs.writeFile(filePath, content, "utf-8");
   185→}
   186→
   187→/**
   188→ * Write object to YAML file while preserving formatting and comments.
   189→ *
   190→ * Note: This function is now equivalent to writeYamlFile() - the "preserve format"
   191→ * naming is historical. Both use toYaml() which includes the whitespace-only line
   192→ * fix. Kept for backwards compatibility with existing callers.
   193→ */
   194→export async function writeYamlFilePreserveFormat(
   195→  filePath: string,
   196→  data: unknown,
   197→): Promise<void> {
   198→  const content = toYaml(data);
   199→  // AC: @batch-write-buffer ac-1 — buffer write if in batch mode
   200→  const buffer = getActiveBatchBuffer();
   201→  if (buffer?.isInScope(filePath)) {
   202→    buffer.write(filePath, content);
   203→    return;
   204→  }
   205→  await fs.writeFile(filePath, content, "utf-8");
   206→}
   207→
   208→/**
   209→ * Find task files in a directory
   210→ */
   211→export async function findTaskFiles(dir: string): Promise<string[]> {
   212→  const files: string[] = [];
   213→
   214→  try {
   215→    const entries = await readdirBufferAware(dir, { withFileTypes: true }) as Dirent[];
   216→
   217→    for (const entry of entries) {
   218→      const fullPath = path.join(dir, entry.name);
   219→
   220→      if (entry.isDirectory()) {
   221→        // Recurse into subdirectories
   222→        const subFiles = await findTaskFiles(fullPath);
   223→        files.push(...subFiles);
   224→      } else if (entry.isFile() && entry.name.endsWith(".tasks.yaml")) {
   225→        files.push(fullPath);
   226→      }
   227→    }
   228→  } catch (_error) {
   229→    // Directory doesn't exist or not readable
   230→  }
   231→
   232→  return files;
   233→}
   234→
   235→/**
   236→ * Find the manifest file.
   237→ *
   238→ * Discovery algorithm per directory:
   239→ * 1. Check for explicit names: kynetic.yaml, kynetic.spec.yaml (backward compat)
   240→ * 2. If not found, scan for *.yaml files with 'kynetic:' version field
   241→ *
   242→ * Searches current dir, then spec/ subdir, then parent directories.
   243→ */
   244→export async function findManifest(startDir: string): Promise<string | null> {
   245→  let dir = startDir;
   246→
   247→  while (true) {
   248→    // Check current directory
   249→    const manifestInDir = await findManifestInDir(dir);
   250→    if (manifestInDir) {
   251→      return manifestInDir;
   252→    }
   253→
   254→    // Also check in spec/ subdirectory
   255→    const specDir = path.join(dir, "spec");
   256→    try {
   257→      const stat = await fs.stat(specDir);
   258→      if (stat.isDirectory()) {
   259→        const manifestInSpec = await findManifestInDir(specDir);
   260→        if (manifestInSpec) {
   261→          return manifestInSpec;
   262→        }
   263→      }
   264→    } catch {
   265→      // spec/ doesn't exist
   266→    }
   267→
   268→    const parentDir = path.dirname(dir);
   269→    if (parentDir === dir) {
   270→      // Reached root
   271→      return null;
   272→    }
   273→    dir = parentDir;
   274→  }
   275→}
   276→
   277→/**
   278→ * Context for working with spec/task files.
   279→ *
   280→ * When shadow branch is enabled:
   281→ * - rootDir points to the project root (where .kspec/ lives)
   282→ * - specDir points to .kspec/ (where spec files are read/written)
   283→ * - All file operations use specDir for resolution
   284→ *
   285→ * Without shadow branch:
   286→ * - rootDir is the project root
   287→ * - specDir is rootDir/spec/ (traditional layout)
   288→ */
   289→export interface KspecContext {
   290→  /** Project root directory */
   291→  rootDir: string;
   292→  /** Spec files directory (.kspec/ when shadow enabled, otherwise spec/) */
   293→  specDir: string;
   294→  /** Path to manifest file */
   295→  manifestPath: string | null;
   296→  /** Parsed manifest */
   297→  manifest: Manifest | null;
   298→  /** Shadow branch configuration (null if not using shadow) */
   299→  shadow: ShadowConfig | null;
   300→  /**
   301→   * Project configuration from kspec.config.yaml.
   302→   * Loaded before shadow detection. Always present (defaults if no config file).
   303→   *
   304→   * AC: @project-config ac-2 — config available on KspecContext.config
   305→   */
   306→  config: ResolvedKspecConfig;
   307→}
   308→
   309→/**
   310→ * Initialize context by finding manifest.
   311→ *
   312→ * Detection order:
   313→ * 1. Load project config from git root (before shadow detection)
   314→ * 2. Check for shadow branch (.kspec/ directory)
   315→ * 3. Fall back to traditional spec/ directory
   316→ *
   317→ * When shadow is detected, all operations use .kspec/ as specDir.
   318→ *
   319→ * AC: @project-config ac-2 — config loaded before shadow detection
   320→ */
   321→export async function initContext(startDir?: string): Promise<KspecContext> {
   322→  const cwd = startDir || process.cwd();
   323→
   324→  // AC: @project-config ac-2, ac-6, ac-7 — load config before shadow detection
   325→  // Config is loaded from git root, not cwd or KSPEC_SPEC_DIR temp dir
   326→  const configResult = await loadProjectConfig(cwd);
   327→
   328→  // AC: @project-config ac-3 — emit warning to stderr if config had issues
   329→  if (configResult.warning) {
   330→    console.error(`Warning: ${configResult.warning}`);
   331→  }
   332→
   333→  const { config } = configResult;
   334→
   335→  // KSPEC_SPEC_DIR override: used by batch atomic mode to redirect to temp copy
   336→  const specDirOverride = process.env.KSPEC_SPEC_DIR;
   337→  if (specDirOverride) {
   338→    const specDir = path.resolve(specDirOverride);
   339→    const manifestPath = await findManifestInDir(specDir);
   340→
   341→    let manifest: Manifest | null = null;
   342→    if (manifestPath) {
   343→      try {
   344→        const rawManifest = await readYamlFile<unknown>(manifestPath);
   345→        manifest = parseManifestWithWarnings(rawManifest);
   346→      } catch {
   347→        // Manifest exists but may be invalid
   348→      }
   349→    }
   350→
   351→    return {
   352→      rootDir: path.dirname(specDir),
   353→      specDir,
   354→      manifestPath,
   355→      manifest,
   356→      shadow: null, // No shadow in overridden context
   357→      config,
   358→    };
   359→  }
   360→
   361→  // Check if running from inside the shadow worktree
   362→  // AC: @config-shadow ac-8 — pass configured directory for detection
   363→  const mainProjectRoot = await detectRunningFromShadowWorktree(
   364→    cwd,
   365→    config.shadow.directory,
   366→  );
   367→  if (mainProjectRoot) {
   368→    throw new ShadowError(
   369→      errors.project.runningFromShadow,
   370→      "RUNNING_FROM_SHADOW",
   371→      `Run from project root: cd ${path.relative(cwd, mainProjectRoot) || mainProjectRoot}`,
   372→    );
   373→  }
   374→
   375→  // Try to detect shadow branch first
   376→  // AC: @config-shadow ac-1 ac-2 — use configured branch/directory names
   377→  const shadow = await detectShadow(cwd, {
   378→    branchName: config.shadow.branch,
   379→    directory: config.shadow.directory,
   380→  });
   381→
   382→  if (shadow?.enabled) {
   383→    // Shadow mode: use .kspec/ for everything
   384→    const specDir = shadow.worktreeDir;
   385→    const manifestPath = await findManifestInDir(specDir);
   386→
   387→    let manifest: Manifest | null = null;
   388→    if (manifestPath) {
   389→      try {
   390→        const rawManifest = await readYamlFile<unknown>(manifestPath);
   391→        manifest = parseManifestWithWarnings(rawManifest);
   392→      } catch {
   393→        // Manifest exists but may be invalid
   394→      }
   395→    }
   396→
   397→    return {
   398→      rootDir: shadow.projectRoot,
   399→      specDir,
   400→      manifestPath,
   401→      manifest,
   402→      shadow,
   403→      config,
   404→    };
   405→  }
   406→
   407→  // Traditional mode: find manifest in spec/ or current directory
   408→  const manifestPath = await findManifest(cwd);
   409→
   410→  let manifest: Manifest | null = null;
   411→  let rootDir = cwd;
   412→  let specDir = cwd;
   413→
   414→  if (manifestPath) {
   415→    const manifestDir = path.dirname(manifestPath);
   416→    // Handle spec/ subdirectory
   417→    if (path.basename(manifestDir) === "spec") {
   418→      rootDir = path.dirname(manifestDir);
   419→      specDir = manifestDir;
   420→    } else {
   421→      rootDir = manifestDir;
   422→      specDir = manifestDir;
   423→    }
   424→
   425→    try {
   426→      const rawManifest = await readYamlFile<unknown>(manifestPath);
   427→      manifest = parseManifestWithWarnings(rawManifest);
   428→    } catch {
   429→      // Manifest exists but may be invalid
   430→    }
   431→  }
   432→
   433→  return { rootDir, specDir, manifestPath, manifest, shadow: null, config };
   434→}
   435→
   436→/**
   437→ * Check if a filename is a potential manifest file.
   438→ * Excludes files with suffixes that indicate other kspec file types.
   439→ *
   440→ * AC: @manifest-discovery ac-5 (excludes task/inbox/meta/runs files)
   441→ */
   442→function isManifestCandidate(filename: string): boolean {
   443→  if (!filename.endsWith(".yaml")) return false;
   444→  const exclusions = [".tasks.yaml", ".inbox.yaml", ".meta.yaml", ".runs.yaml"];
   445→  return !exclusions.some((excl) => filename.endsWith(excl));
   446→}
   447→
   448→/**
   449→ * Find manifest file within a specific directory (no parent traversal).
   450→ * Used for shadow mode where we know exactly where to look.
   451→ *
   452→ * Discovery algorithm:
   453→ * 1. Check for explicit names: kynetic.yaml, kynetic.spec.yaml (backward compat)
   454→ * 2. If not found, scan directory for *.yaml files (excluding other kspec types)
   455→ * 3. For each candidate, validate it contains a 'kynetic:' version field
   456→ * 4. Return first valid match (alphabetically after explicit names)
   457→ *
   458→ * AC: @manifest-discovery ac-1, ac-2, ac-3, ac-4, ac-5
   459→ */
   460→async function findManifestInDir(dir: string): Promise<string | null> {
   461→  // AC: @manifest-discovery ac-1, ac-2 - explicit names have priority
   462→  const priorityCandidates = ["kynetic.yaml", "kynetic.spec.yaml"];
   463→
   464→  for (const candidate of priorityCandidates) {
   465→    const filePath = path.join(dir, candidate);
   466→    try {
   467→      await accessBufferAware(filePath);
   468→      return filePath;
   469→    } catch {
   470→      // File doesn't exist, try next
   471→    }
   472→  }
   473→
   474→  // AC: @manifest-discovery ac-3, ac-4, ac-5 - glob fallback with validation
   475→  try {
   476→    const entries = await readdirBufferAware(dir) as string[];
   477→    // AC: @manifest-discovery ac-4 - alphabetical order
   478→    const candidates = entries.filter(isManifestCandidate).sort();
   479→
   480→    for (const candidate of candidates) {
   481→      const filePath = path.join(dir, candidate);
   482→      try {
   483→        const raw = await readYamlFile<unknown>(filePath);
   484→        // AC: @manifest-discovery ac-5 - validate kynetic version field
   485→        if (raw && typeof raw === "object" && "kynetic" in raw) {
   486→          return filePath;
   487→        }
   488→      } catch {
   489→        // Skip invalid files
   490→      }
   491→    }
   492→  } catch {
   493→    // Directory read failed
   494→  }
   495→
   496→  return null;
   497→}
   498→
   499→/**
   500→ * Load tasks from a single file.
   501→ * Helper function used by loadAllTasks.
   502→ */
   503→async function loadTasksFromFile(filePath: string): Promise<LoadedTask[]> {
   504→  const tasks: LoadedTask[] = [];
   505→
   506→  try {
   507→    const raw = await readYamlFile<unknown>(filePath);
   508→
   509→    // Handle both array format and object format
   510→    let taskList: unknown[];
   511→
   512→    if (Array.isArray(raw)) {
   513→      taskList = raw;
   514→    } else if (raw && typeof raw === "object" && "tasks" in raw) {
   515→      const parsed = TasksFileSchema.safeParse(raw);
   516→      if (parsed.success) {
   517→        // Add _sourceFile to each task from this file
   518→        for (const task of parsed.data.tasks) {
   519→          tasks.push({ ...task, _sourceFile: filePath });
   520→        }
   521→        return tasks;
   522→      }
   523→      taskList = (raw as { tasks: unknown[] }).tasks || [];
   524→    } else {
   525→      // Single task object
   526→      taskList = [raw];
   527→    }
   528→
   529→    for (const taskData of taskList) {
   530→      const result = TaskSchema.safeParse(taskData);
   531→      if (result.success) {
   532→        // Add _sourceFile metadata
   533→        tasks.push({ ...result.data, _sourceFile: filePath });
   534→      }
   535→    }
   536→  } catch {
   537→    // Skip invalid files
   538→  }
   539→
   540→  return tasks;
   541→}
   542→
   543→/**
   544→ * Load all tasks from the project.
   545→ * Each task includes _sourceFile metadata for write-back routing.
   546→ *
   547→ * When shadow is enabled, tasks are loaded from .kspec/ (ctx.specDir).
   548→ * Otherwise, searches in traditional locations (rootDir, spec/, tasks/).
   549→ */
   550→export async function loadAllTasks(ctx: KspecContext): Promise<LoadedTask[]> {
   551→  const tasks: LoadedTask[] = [];
   552→
   553→  // When shadow is enabled (or spec dir is explicitly overridden), look only in specDir.
   554→  // KSPEC_SPEC_DIR override is used by batch mode and some integration tests to isolate
   555→  // task state to a temp directory; scanning ctx.rootDir can leak tasks from parent dirs.
   556→  if (ctx.shadow?.enabled || Boolean(process.env.KSPEC_SPEC_DIR)) {
   557→    const taskFiles = await findTaskFiles(ctx.specDir);
   558→
   559→    // Also check for standalone files in specDir
   560→    const standaloneLocations = [
   561→      path.join(ctx.specDir, "tasks.yaml"),
   562→      path.join(ctx.specDir, "project.tasks.yaml"),
   563→      path.join(ctx.specDir, "kynetic.tasks.yaml"),
   564→      path.join(ctx.specDir, "backlog.tasks.yaml"),
   565→      path.join(ctx.specDir, "active.tasks.yaml"),
   566→    ];
   567→
   568→    for (const loc of standaloneLocations) {
   569→      try {
   570→        await accessBufferAware(loc);
   571→        if (!taskFiles.includes(loc)) {
   572→          taskFiles.push(loc);
   573→        }
   574→      } catch {
   575→        // File doesn't exist
   576→      }
   577→    }
   578→
   579→    // Deduplicate and load
   580→    const uniqueFiles = [...new Set(taskFiles)];
   581→    for (const filePath of uniqueFiles) {
   582→      const fileTasks = await loadTasksFromFile(filePath);
   583→      tasks.push(...fileTasks);
   584→    }
   585→
   586→    return tasks;
   587→  }
   588→
   589→  // Traditional mode: look in multiple locations
   590→  const taskFiles = await findTaskFiles(ctx.rootDir);
   591→
   592→  // Also check common locations
   593→  const additionalPaths = [
   594→    path.join(ctx.rootDir, "tasks"),
   595→    path.join(ctx.rootDir, "spec"),
   596→  ];
   597→
   598→  for (const additionalPath of additionalPaths) {
   599→    const files = await findTaskFiles(additionalPath);
   600→    taskFiles.push(...files);
   601→  }
   602→
   603→  // Also look for standalone tasks.yaml and project.tasks.yaml
   604→  const standaloneLocations = [
   605→    path.join(ctx.rootDir, "tasks.yaml"),
   606→    path.join(ctx.rootDir, "project.tasks.yaml"),
   607→    path.join(ctx.rootDir, "spec", "project.tasks.yaml"),
   608→    path.join(ctx.rootDir, "backlog.tasks.yaml"),
   609→    path.join(ctx.rootDir, "active.tasks.yaml"),
   610→  ];
   611→
   612→  for (const loc of standaloneLocations) {
   613→    try {
   614→      await accessBufferAware(loc);
   615→      if (!taskFiles.includes(loc)) {
   616→        taskFiles.push(loc);
   617→      }
   618→    } catch {
   619→      // File doesn't exist
   620→    }
   621→  }
   622→
   623→  // Deduplicate and load
   624→  const uniqueFiles = [...new Set(taskFiles)];
   625→
   626→  for (const filePath of uniqueFiles) {
   627→    const fileTasks = await loadTasksFromFile(filePath);
   628→    tasks.push(...fileTasks);
   629→  }
   630→
   631→  return tasks;
   632→}
   633→
   634→/**
   635→ * Find a task by reference (ULID, slug, or short reference)
   636→ */
   637→export function findTaskByRef(
   638→  tasks: LoadedTask[],
   639→  ref: string,
   640→): LoadedTask | undefined {
   641→  // Remove @ prefix if present
   642→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   643→
   644→  return tasks.find((task) => {
   645→    // Match full ULID
   646→    if (task._ulid === cleanRef) return true;
   647→
   648→    // Match short ULID (prefix)
   649→    if (task._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
   650→      return true;
   651→
   652→    // Match slug
   653→    if (task.slugs.includes(cleanRef)) return true;
   654→
   655→    return false;
   656→  });
   657→}
   658→
   659→/**
   660→ * Get the default task file path for new tasks without a spec_ref.
   661→ *
   662→ * When shadow enabled: .kspec/project.tasks.yaml
   663→ * Otherwise: spec/project.tasks.yaml
   664→ */
   665→export function getDefaultTaskFilePath(ctx: KspecContext): string {
   666→  return path.join(ctx.specDir, "project.tasks.yaml");
   667→}
   668→
   669→/**
   670→ * Strip runtime metadata before serialization
   671→ */
   672→function stripRuntimeMetadata(task: LoadedTask): Task {
   673→  const { _sourceFile, ...cleanTask } = task;
   674→  return cleanTask as Task;
   675→}
   676→
   677→/**
   678→ * Save a task to its source file (or default location for new tasks).
   679→ * Preserves file format (tasks: [...] wrapper vs plain array).
   680→ */
   681→export async function saveTask(
   682→  ctx: KspecContext,
   683→  task: LoadedTask,
   684→): Promise<void> {
   685→  // Determine target file: use _sourceFile if present, otherwise default
   686→  const taskFilePath = task._sourceFile || getDefaultTaskFilePath(ctx);
   687→
   688→  // Lock the file to prevent concurrent read-modify-write races
   689→  await withFileLock(taskFilePath, async () => {
   690→    // Ensure directory exists
   691→    const dir = path.dirname(taskFilePath);
   692→    await fs.mkdir(dir, { recursive: true });
   693→
   694→    // Load existing tasks from the target file
   695→    let existingRaw: unknown = null;
   696→    let useTasksWrapper = false;
   697→
   698→    try {
   699→      existingRaw = await readYamlFile<unknown>(taskFilePath);
   700→      // Detect if file uses { tasks: [...] } format
   701→      if (
   702→        existingRaw &&
   703→        typeof existingRaw === "object" &&
   704→        "tasks" in existingRaw
   705→      ) {
   706→        useTasksWrapper = true;
   707→      }
   708→    } catch {
   709→      // File doesn't exist, start fresh
   710→    }
   711→
   712→    // Parse existing tasks from file
   713→    let fileTasks: Task[] = [];
   714→
   715→    if (existingRaw) {
   716→      if (Array.isArray(existingRaw)) {
   717→        for (const t of existingRaw) {
   718→          const result = TaskSchema.safeParse(t);
   719→          if (result.success) {
   720→            fileTasks.push(result.data);
   721→          }
   722→        }
   723→      } else if (useTasksWrapper) {
   724→        // Try TasksFileSchema first (has kynetic_tasks version)
   725→        const parsed = TasksFileSchema.safeParse(existingRaw);
   726→        if (parsed.success) {
   727→          fileTasks = parsed.data.tasks;
   728→        } else {
   729→          // Fall back to raw tasks array (common format without version field)
   730→          const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   731→          if (Array.isArray(rawTasks)) {
   732→            for (const t of rawTasks) {
   733→              const result = TaskSchema.safeParse(t);
   734→              if (result.success) {
   735→                fileTasks.push(result.data);
   736→              }
   737→            }
   738→          }
   739→        }
   740→      }
   741→    }
   742→
   743→    // Strip runtime metadata before saving
   744→    const cleanTask = stripRuntimeMetadata(task);
   745→
   746→    // Update existing or add new
   747→    const existingIndex = fileTasks.findIndex((t) => t._ulid === task._ulid);
   748→    if (existingIndex >= 0) {
   749→      fileTasks[existingIndex] = cleanTask;
   750→    } else {
   751→      fileTasks.push(cleanTask);
   752→    }
   753→
   754→    // Save in the same format as original (or tasks: wrapper for new files)
   755→    // Use format-preserving write to maintain formatting and comments
   756→    if (useTasksWrapper) {
   757→      await writeYamlFilePreserveFormat(taskFilePath, { tasks: fileTasks });
   758→    } else {
   759→      await writeYamlFilePreserveFormat(taskFilePath, fileTasks);
   760→    }
   761→  });
   762→}
   763→
   764→/**
   765→ * Atomically mutate a task using the latest on-disk state.
   766→ *
   767→ * The callback receives the current task value while holding the task file lock,
   768→ * so concurrent writers cannot clobber unrelated fields (for example status vs notes).
   769→ */
   770→export async function mutateTaskAtomically(
   771→  ctx: KspecContext,
   772→  task: LoadedTask,
   773→  mutate: (latestTask: LoadedTask) => Task | LoadedTask | Promise<Task | LoadedTask>,
   774→): Promise<LoadedTask> {
   775→  const taskFilePath = task._sourceFile || getDefaultTaskFilePath(ctx);
   776→  let updatedTask: LoadedTask | undefined;
   777→
   778→  await withFileLock(taskFilePath, async () => {
   779→    // Ensure directory exists (important for default path in new repos)
   780→    const dir = path.dirname(taskFilePath);
   781→    await fs.mkdir(dir, { recursive: true });
   782→
   783→    // Preserve existing file format (tasks wrapper vs plain array)
   784→    let existingRaw: unknown = null;
   785→    let useTasksWrapper = false;
   786→    try {
   787→      existingRaw = await readYamlFile<unknown>(taskFilePath);
   788→      if (
   789→        existingRaw &&
   790→        typeof existingRaw === "object" &&
   791→        "tasks" in existingRaw
   792→      ) {
   793→        useTasksWrapper = true;
   794→      }
   795→    } catch {
   796→      throw new Error(`Task file not found: ${taskFilePath}`);
   797→    }
   798→
   799→    const fileTasks = await loadTasksFromFile(taskFilePath);
   800→    const taskIndex = fileTasks.findIndex((t) => t._ulid === task._ulid);
   801→    if (taskIndex === -1) {
   802→      throw new Error(`Task not found in file: ${task._ulid}`);
   803→    }
   804→
   805→    const latestTask = fileTasks[taskIndex];
   806→    const mutatedTask = await mutate(latestTask);
   807→    const cleanMutatedTask = stripRuntimeMetadata(mutatedTask as LoadedTask);
   808→
   809→    const serializedTasks = fileTasks.map((fileTask, index) =>
   810→      index === taskIndex ? cleanMutatedTask : stripRuntimeMetadata(fileTask),
   811→    );
   812→
   813→    if (useTasksWrapper) {
   814→      await writeYamlFilePreserveFormat(taskFilePath, { tasks: serializedTasks });
   815→    } else {
   816→      await writeYamlFilePreserveFormat(taskFilePath, serializedTasks);
   817→    }
   818→
   819→    updatedTask = {
   820→      ...cleanMutatedTask,
   821→      _sourceFile: taskFilePath,
   822→    };
   823→  });
   824→
   825→  if (!updatedTask) {
   826→    throw new Error(`Failed to mutate task atomically: ${task._ulid}`);
   827→  }
   828→
   829→  return updatedTask;
   830→}
   831→
   832→/**
   833→ * Delete a task from its source file.
   834→ * Requires _sourceFile to know which file to modify.
   835→ */
   836→export async function deleteTask(
   837→  _ctx: KspecContext,
   838→  task: LoadedTask,
   839→): Promise<void> {
   840→  if (!task._sourceFile) {
   841→    throw new Error("Cannot delete task without _sourceFile metadata");
   842→  }
   843→
   844→  const taskFilePath = task._sourceFile;
   845→
   846→  // Lock the file to prevent concurrent read-modify-write races
   847→  await withFileLock(taskFilePath, async () => {
   848→    // Load existing file
   849→    let existingRaw: unknown = null;
   850→    let useTasksWrapper = false;
   851→
   852→    try {
   853→      existingRaw = await readYamlFile<unknown>(taskFilePath);
   854→      if (
   855→        existingRaw &&
   856→        typeof existingRaw === "object" &&
   857→        "tasks" in existingRaw
   858→      ) {
   859→        useTasksWrapper = true;
   860→      }
   861→    } catch {
   862→      throw new Error(`Task file not found: ${taskFilePath}`);
   863→    }
   864→
   865→    // Parse existing tasks
   866→    let fileTasks: Task[] = [];
   867→
   868→    if (existingRaw) {
   869→      if (Array.isArray(existingRaw)) {
   870→        for (const t of existingRaw) {
   871→          const result = TaskSchema.safeParse(t);
   872→          if (result.success) {
   873→            fileTasks.push(result.data);
   874→          }
   875→        }
   876→      } else if (useTasksWrapper) {
   877→        const parsed = TasksFileSchema.safeParse(existingRaw);
   878→        if (parsed.success) {
   879→          fileTasks = parsed.data.tasks;
   880→        } else {
   881→          const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   882→          if (Array.isArray(rawTasks)) {
   883→            for (const t of rawTasks) {
   884→              const result = TaskSchema.safeParse(t);
   885→              if (result.success) {
   886→                fileTasks.push(result.data);
   887→              }
   888→            }
   889→          }
   890→        }
   891→      }
   892→    }
   893→
   894→    // Remove the task
   895→    const originalCount = fileTasks.length;
   896→    fileTasks = fileTasks.filter((t) => t._ulid !== task._ulid);
   897→
   898→    if (fileTasks.length === originalCount) {
   899→      throw new Error(`Task not found in file: ${task._ulid}`);
   900→    }
   901→
   902→    // Save the modified file with format preservation
   903→    if (useTasksWrapper) {
   904→      await writeYamlFilePreserveFormat(taskFilePath, { tasks: fileTasks });
   905→    } else {
   906→      await writeYamlFilePreserveFormat(taskFilePath, fileTasks);
   907→    }
   908→  });
   909→}
   910→
   911→/**
   912→ * Create a new task with auto-generated fields
   913→ */
   914→export function createTask(input: TaskInput): Task {
   915→  const now = new Date().toISOString();
   916→
   917→  return {
   918→    ...input,
   919→    _ulid: input._ulid || ulid(),
   920→    slugs: input.slugs || [],
   921→    type: input.type || "task",
   922→    status: input.status || "pending",
   923→    blocked_by: input.blocked_by || [],
   924→    depends_on: input.depends_on || [],
   925→    context: input.context || [],
   926→    priority: input.priority || 3,
   927→    tags: input.tags || [],
   928→    vcs_refs: input.vcs_refs || [],
   929→    created_at: input.created_at || now,
   930→    notes: input.notes || [],
   931→    todos: input.todos || [],
   932→  };
   933→}
   934→
   935→/**
   936→ * Get author from environment with fallback chain.
   937→ * Priority:
   938→ *   1. KSPEC_AUTHOR env var (explicit config, agent-agnostic)
   939→ *   2. kspec.config.yaml identity.author (project-level default)
   940→ *   3. git user.name (developer identity)
   941→ *   4. USER/USERNAME env var (system user)
   942→ *   5. undefined (will show as 'unknown' in output)
   943→ *
   944→ * For Claude Code integration, add to ~/.claude/settings.json:
   945→ *   { "env": { "KSPEC_AUTHOR": "@claude" } }
   946→ *
   947→ * AC: @config-author ac-1 ac-2 ac-3 — author priority chain
   948→ *
   949→ * @param configAuthor Optional author from kspec.config.yaml identity.author
   950→ */
   951→export function getAuthor(configAuthor?: string | null): string | undefined {
   952→  // 1. Explicit env var (works for any agent) — AC: ac-2
   953→  if (process.env.KSPEC_AUTHOR) {
   954→    return process.env.KSPEC_AUTHOR;
   955→  }
   956→
   957→  // 2. Project config author — AC: ac-1
   958→  if (configAuthor) {
   959→    return configAuthor;
   960→  }
   961→
   962→  // 3. Git user.name — AC: ac-3
   963→  try {
   964→    const gitUser = execSync("git config user.name", {
   965→      encoding: "utf-8",
   966→      stdio: ["pipe", "pipe", "ignore"],
   967→    }).trim();
   968→    if (gitUser) {
   969→      return gitUser;
   970→    }
   971→  } catch {
   972→    // git not available or not in a repo
   973→  }
   974→
   975→  // 4. System user — AC: ac-3
   976→  const systemUser = process.env.USER || process.env.USERNAME;
   977→  if (systemUser) {
   978→    return systemUser;
   979→  }
   980→
   981→  // 5. No author available
   982→  return undefined;
   983→}
   984→
   985→/**
   986→ * Create a new note entry.
   987→ * If author is not provided, attempts to auto-detect from environment.
   988→ */
   989→export function createNote(
   990→  content: string,
   991→  author?: string,
   992→  supersedes?: string,
   993→): Note {
   994→  return {
   995→    _ulid: ulid(),
   996→    created_at: new Date().toISOString(),
   997→    author: author ?? getAuthor(),
   998→    // Trim content to prevent whitespace-only lines from accumulating
   999→    // in block scalars during YAML parse-stringify cycles
  1000→    content: content.trim(),
  1001→    supersedes: supersedes || null,
  1002→  };
  1003→}
  1004→
  1005→/**
  1006→ * Create a new todo item.
  1007→ * The id should be the next available id for the task's todos array.
  1008→ */
  1009→export function createTodo(id: number, text: string, addedBy?: string): Todo {
  1010→  return {
  1011→    id,
  1012→    // Trim text to prevent whitespace-only lines from accumulating
  1013→    // in block scalars during YAML parse-stringify cycles
  1014→    text: text.trim(),
  1015→    done: false,
  1016→    added_at: new Date().toISOString(),
  1017→    added_by: addedBy ?? getAuthor(),
  1018→  };
  1019→}
  1020→
  1021→/**
  1022→ * Check if task dependencies are met
  1023→ */
  1024→export function areDependenciesMet(
  1025→  task: LoadedTask,
  1026→  allTasks: LoadedTask[],
  1027→): boolean {
  1028→  if (task.depends_on.length === 0) return true;
  1029→
  1030→  for (const depRef of task.depends_on) {
  1031→    const depTask = findTaskByRef(allTasks, depRef);
  1032→    if (!depTask || depTask.status !== "completed") {
  1033→      return false;
  1034→    }
  1035→  }
  1036→
  1037→  return true;
  1038→}
  1039→
  1040→/**
  1041→ * Check if task is ready (pending/needs_work + deps met + not blocked)
  1042→ */
  1043→export function isTaskReady(task: LoadedTask, allTasks: LoadedTask[]): boolean {
  1044→  if (task.status !== "pending" && task.status !== "needs_work") return false;
  1045→  if (task.blocked_by.length > 0) return false;
  1046→  return areDependenciesMet(task, allTasks);
  1047→}
  1048→
  1049→/**
  1050→ * Get ready tasks (pending/needs_work + deps met + not blocked), sorted by
  1051→ * status (needs_work first), then priority, then creation time.
  1052→ * Within the same tier, older tasks come first (FIFO).
  1053→ */
  1054→export function getReadyTasks(tasks: LoadedTask[]): LoadedTask[] {
  1055→  return tasks
  1056→    .filter((task) => isTaskReady(task, tasks))
  1057→    .sort((a, b) => {
  1058→      // Primary: needs_work before pending (fix cycles take priority)
  1059→      const statusOrder = (s: string) => (s === "needs_work" ? 0 : 1);
  1060→      const statusDiff = statusOrder(a.status) - statusOrder(b.status);
  1061→      if (statusDiff !== 0) return statusDiff;
  1062→      // Secondary: priority (lower number = higher priority)
  1063→      if (a.priority !== b.priority) {
  1064→        return a.priority - b.priority;
  1065→      }
  1066→      // Tertiary: creation time (older first - FIFO within priority)
  1067→      return (
  1068→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime()
  1069→      );
  1070→    });
  1071→}
  1072→
  1073→// ============================================================
  1074→// SPEC ITEM LOADING
  1075→// ============================================================
  1076→
  1077→/**
  1078→ * Expand a glob-like include pattern to file paths.
  1079→ * Supports simple patterns like "modules/*.yaml" or "**\/*.yaml"
  1080→ */
  1081→export async function expandIncludePattern(
  1082→  pattern: string,
  1083→  baseDir: string,
  1084→): Promise<string[]> {
  1085→  const fullPattern = path.isAbsolute(pattern)
  1086→    ? pattern
  1087→    : path.join(baseDir, pattern);
  1088→
  1089→  // If no glob characters, just return the path if it exists
  1090→  if (!pattern.includes("*")) {
  1091→    try {
  1092→      await accessBufferAware(fullPattern);
  1093→      return [fullPattern];
  1094→    } catch {
  1095→      return [];
  1096→    }
  1097→  }
  1098→
  1099→  // Split pattern into directory part and file pattern
  1100→  const parts = pattern.split("/");
  1101→  let currentDir = baseDir;
  1102→  const result: string[] = [];
  1103→
  1104→  // Find the first part with a glob
  1105→  const globIndex = parts.findIndex((p) => p.includes("*"));
  1106→
  1107→  // Navigate to the directory before the glob
  1108→  if (globIndex > 0) {
  1109→    currentDir = path.join(baseDir, ...parts.slice(0, globIndex));
  1110→  }
  1111→
  1112→  // Get the remaining pattern
  1113→  const remainingPattern = parts.slice(globIndex).join("/");
  1114→
  1115→  await expandGlobRecursive(currentDir, remainingPattern, result);
  1116→  return result;
  1117→}
  1118→
  1119→/**
  1120→ * Recursively expand glob patterns
  1121→ */
  1122→async function expandGlobRecursive(
  1123→  dir: string,
  1124→  pattern: string,
  1125→  result: string[],
  1126→): Promise<void> {
  1127→  const parts = pattern.split("/");
  1128→  const currentPattern = parts[0];
  1129→  const remainingPattern = parts.slice(1).join("/");
  1130→
  1131→  try {
  1132→    const entries = await readdirBufferAware(dir, { withFileTypes: true }) as Dirent[];
  1133→
  1134→    for (const entry of entries) {
  1135→      const matches = matchGlobPart(entry.name, currentPattern);
  1136→
  1137→      if (matches) {
  1138→        const fullPath = path.join(dir, entry.name);
  1139→
  1140→        if (remainingPattern) {
  1141→          // More pattern parts to process
  1142→          if (entry.isDirectory()) {
  1143→            await expandGlobRecursive(fullPath, remainingPattern, result);
  1144→          }
  1145→        } else {
  1146→          // This is the final pattern part
  1147→          if (currentPattern === "**") {
  1148→            // ** matches any depth - need special handling
  1149→            if (entry.isDirectory()) {
  1150→              await expandGlobRecursive(fullPath, "**", result);
  1151→            }
  1152→            // Also match files at this level
  1153→            result.push(fullPath);
  1154→          } else if (entry.isFile()) {
  1155→            result.push(fullPath);
  1156→          }
  1157→        }
  1158→      }
  1159→
  1160→      // Handle ** - also recurse into directories without consuming the pattern
  1161→      if (currentPattern === "**" && entry.isDirectory()) {
  1162→        const fullPath = path.join(dir, entry.name);
  1163→        await expandGlobRecursive(fullPath, pattern, result);
  1164→      }
  1165→    }
  1166→  } catch {
  1167→    // Directory doesn't exist or not readable
  1168→  }
  1169→}
  1170→
  1171→/**
  1172→ * Match a single path component against a glob pattern part
  1173→ */
  1174→function matchGlobPart(name: string, pattern: string): boolean {
  1175→  if (pattern === "*") return true;
  1176→  if (pattern === "**") return true;
  1177→
  1178→  // Convert glob pattern to regex
  1179→  const regexPattern = pattern
  1180→    .replace(/[.+^${}()|[\]\\]/g, "\\$&") // Escape special regex chars
  1181→    .replace(/\*/g, ".*") // * matches anything
  1182→    .replace(/\?/g, "."); // ? matches single char
  1183→
  1184→  const regex = new RegExp(`^${regexPattern}$`);
  1185→  return regex.test(name);
  1186→}
  1187→
  1188→/**
  1189→ * Fields that may contain nested spec items
  1190→ */
  1191→const NESTED_ITEM_FIELDS = [
  1192→  "modules",
  1193→  "features",
  1194→  "requirements",
  1195→  "constraints",
  1196→  "decisions",
  1197→  "traits",
  1198→  "acceptance_criteria",
  1199→];
  1200→
  1201→/**
  1202→ * Recursively extract all spec items from a raw YAML structure.
  1203→ * Items can be nested under modules/features/requirements/etc.
  1204→ * Tracks the path within the file for each item.
  1205→ */
  1206→export function extractItemsFromRaw(
  1207→  raw: unknown,
  1208→  sourceFile: string,
  1209→  items: LoadedSpecItem[] = [],
  1210→  currentPath: string = "",
  1211→): LoadedSpecItem[] {
  1212→  if (!raw || typeof raw !== "object") {
  1213→    return items;
  1214→  }
  1215→
  1216→  // Check if this object is itself a spec item (has _ulid)
  1217→  if (
  1218→    "_ulid" in raw &&
  1219→    typeof (raw as Record<string, unknown>)._ulid === "string"
  1220→  ) {
  1221→    // Strip nested item arrays before validation since they're processed separately
  1222→    // and the SpecItemSchema expects refs (strings), not nested objects
  1223→    const rawObj = raw as Record<string, unknown>;
  1224→    const cleanedForValidation: Record<string, unknown> = { ...rawObj };
  1225→    for (const field of NESTED_ITEM_FIELDS) {
  1226→      if (field in cleanedForValidation && Array.isArray(cleanedForValidation[field])) {
  1227→        const arr = cleanedForValidation[field] as unknown[];
  1228→        // Check if array contains nested items (objects with _ulid) vs refs (strings)
  1229→        const hasNestedItems = arr.some(
  1230→          (item) =>
  1231→            item && typeof item === "object" && "_ulid" in (item as Record<string, unknown>)
  1232→        );
  1233→        if (hasNestedItems) {
  1234→          // Strip nested items - they'll be extracted recursively
  1235→          delete cleanedForValidation[field];
  1236→        }
  1237→      }
  1238→    }
  1239→
  1240→    const result = SpecItemSchema.safeParse(cleanedForValidation);
  1241→    if (result.success) {
  1242→      items.push({
  1243→        ...result.data,
  1244→        _sourceFile: sourceFile,
  1245→        _path: currentPath || undefined,
  1246→      });
  1247→    }
  1248→
  1249→    // Even if the item itself was added, also extract nested items
  1250→    for (const field of NESTED_ITEM_FIELDS) {
  1251→      if (field in rawObj && Array.isArray(rawObj[field])) {
  1252→        const arr = rawObj[field] as unknown[];
  1253→        for (let i = 0; i < arr.length; i++) {
  1254→          const nestedPath = currentPath
  1255→            ? `${currentPath}.${field}[${i}]`
  1256→            : `${field}[${i}]`;
  1257→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
  1258→        }
  1259→      }
  1260→    }
  1261→  } else if (Array.isArray(raw)) {
  1262→    // Array of items at root level
  1263→    for (let i = 0; i < raw.length; i++) {
  1264→      const itemPath = currentPath ? `${currentPath}[${i}]` : `[${i}]`;
  1265→      extractItemsFromRaw(raw[i], sourceFile, items, itemPath);
  1266→    }
  1267→  } else {
  1268→    // Object that might contain item arrays (like manifest with modules/features/etc)
  1269→    const rawObj = raw as Record<string, unknown>;
  1270→    for (const field of NESTED_ITEM_FIELDS) {
  1271→      if (field in rawObj && Array.isArray(rawObj[field])) {
  1272→        const arr = rawObj[field] as unknown[];
  1273→        for (let i = 0; i < arr.length; i++) {
  1274→          const nestedPath = currentPath
  1275→            ? `${currentPath}.${field}[${i}]`
  1276→            : `${field}[${i}]`;
  1277→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
  1278→        }
  1279→      }
  1280→    }
  1281→  }
  1282→
  1283→  return items;
  1284→}
  1285→
  1286→/**
  1287→ * Load spec items from a single file.
  1288→ * Handles module files (the file itself is an item with nested children).
  1289→ */
  1290→export async function loadSpecFile(
  1291→  filePath: string,
  1292→): Promise<LoadedSpecItem[]> {
  1293→  try {
  1294→    const content = await readFileBufferAware(filePath);
  1295→    const items: LoadedSpecItem[] = [];
  1296→
  1297→    // Parse all YAML documents in the file (handles files with ---)
  1298→    const documents = YAML.parseAllDocuments(content);
  1299→
  1300→    for (const doc of documents) {
  1301→      if (doc.errors.length > 0) {
  1302→        // Skip documents with parse errors
  1303→        continue;
  1304→      }
  1305→
  1306→      const raw = doc.toJS();
  1307→      if (raw) {
  1308→        const docItems = extractItemsFromRaw(raw, filePath);
  1309→        items.push(...docItems);
  1310→      }
  1311→    }
  1312→
  1313→    return items;
  1314→  } catch (_error) {
  1315→    // File doesn't exist or parse error
  1316→    return [];
  1317→  }
  1318→}
  1319→
  1320→/**
  1321→ * Load all spec items from the project.
  1322→ * Parses manifest, follows includes, and builds unified collection.
  1323→ */
  1324→export async function loadAllItems(
  1325→  ctx: KspecContext,
  1326→): Promise<LoadedSpecItem[]> {
  1327→  const items: LoadedSpecItem[] = [];
  1328→
  1329→  if (!ctx.manifest || !ctx.manifestPath) {
  1330→    return items;
  1331→  }
  1332→
  1333→  const manifestDir = path.dirname(ctx.manifestPath);
  1334→
  1335→  // Extract items from manifest itself (inline modules/features/etc)
  1336→  const manifestItems = extractItemsFromRaw(ctx.manifest, ctx.manifestPath);
  1337→  items.push(...manifestItems);
  1338→
  1339→  // Process includes
  1340→  const includes = ctx.manifest.includes || [];
  1341→
  1342→  for (const include of includes) {
  1343→    const expandedPaths = await expandIncludePattern(include, manifestDir);
  1344→
  1345→    for (const filePath of expandedPaths) {
  1346→      const fileItems = await loadSpecFile(filePath);
  1347→      items.push(...fileItems);
  1348→    }
  1349→  }
  1350→
  1351→  return items;
  1352→}
  1353→
  1354→/**
  1355→ * Find a spec item by reference (ULID, slug, or short reference)
  1356→ */
  1357→export function findItemByRef(
  1358→  items: LoadedSpecItem[],
  1359→  ref: string,
  1360→): LoadedSpecItem | undefined {
  1361→  // Remove @ prefix if present
  1362→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1363→
  1364→  return items.find((item) => {
  1365→    // Match full ULID
  1366→    if (item._ulid === cleanRef) return true;
  1367→
  1368→    // Match short ULID (prefix)
  1369→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  1370→      return true;
  1371→
  1372→    // Match slug
  1373→    if (item.slugs.includes(cleanRef)) return true;
  1374→
  1375→    return false;
  1376→  });
  1377→}
  1378→
  1379→/**
  1380→ * Combined item type for unified queries across tasks and spec items
  1381→ */
  1382→export type AnyLoadedItem = LoadedTask | LoadedSpecItem;
  1383→
  1384→/**
  1385→ * Find any item (task or spec item) by reference
  1386→ */
  1387→export function findAnyItemByRef(
  1388→  tasks: LoadedTask[],
  1389→  items: LoadedSpecItem[],
  1390→  ref: string,
  1391→): AnyLoadedItem | undefined {
  1392→  // Try tasks first (more commonly referenced)
  1393→  const task = findTaskByRef(tasks, ref);
  1394→  if (task) return task;
  1395→
  1396→  // Then try spec items
  1397→  return findItemByRef(items, ref);
  1398→}
  1399→
  1400→/**
  1401→ * Build a ReferenceIndex from context.
  1402→ * Loads all tasks and spec items, then builds the index.
  1403→ */
  1404→export async function buildReferenceIndex(ctx: KspecContext): Promise<{
  1405→  index: ReferenceIndex;
  1406→  tasks: LoadedTask[];
  1407→  items: LoadedSpecItem[];
  1408→}> {
  1409→  const tasks = await loadAllTasks(ctx);
  1410→  const items = await loadAllItems(ctx);
  1411→  const index = new ReferenceIndex(tasks, items);
  1412→  return { index, tasks, items };
  1413→}
  1414→
  1415→/**
  1416→ * Build both ReferenceIndex and ItemIndex from context.
  1417→ * Use this when you need query capabilities in addition to reference resolution.
  1418→ * Pass plans for cross-namespace slug collision detection (plans aren't loaded by default
  1419→ * to avoid circular dependency with plans.ts).
  1420→ */
  1421→export async function buildIndexes(ctx: KspecContext, plans: LoadedPlan[] = []): Promise<{
  1422→  refIndex: ReferenceIndex;
  1423→  itemIndex: ItemIndex;
  1424→  traitIndex: TraitIndex;
  1425→  tasks: LoadedTask[];
  1426→  items: LoadedSpecItem[];
  1427→}> {
  1428→  const tasks = await loadAllTasks(ctx);
  1429→  const items = await loadAllItems(ctx);
  1430→  const refIndex = new ReferenceIndex(tasks, items, [], plans);
  1431→  const itemIndex = new ItemIndex(tasks, items);
  1432→  const traitIndex = new TraitIndex(items, refIndex);
  1433→  return { refIndex, itemIndex, traitIndex, tasks, items };
  1434→}
  1435→
  1436→// ============================================================
  1437→// SPEC ITEM CRUD (supports nested structures)
  1438→// ============================================================
  1439→
  1440→/**
  1441→ * Strip runtime metadata from spec item before serialization
  1442→ */
  1443→function stripSpecItemMetadata(item: LoadedSpecItem): SpecItem {
  1444→  const { _sourceFile, _path, ...cleanItem } = item;
  1445→  return cleanItem as SpecItem;
  1446→}
  1447→
  1448→function assertSpecItemPatch(
  1449→  updates: Partial<SpecItemInput>,
  1450→  operation: "updateSpecItem" | "saveSpecItem",
  1451→): void {
  1452→  const patch = updates as Record<string, unknown>;
  1453→  if ("_sourceFile" in patch || "_path" in patch) {
  1454→    throw new Error(
  1455→      `${operation} expects a patch object, not a full LoadedSpecItem. Pass only intended fields to update.`,
  1456→    );
  1457→  }
  1458→}
  1459→
  1460→/**
  1461→ * Parse a path string into segments.
  1462→ * e.g., "features[0].requirements[2]" -> [["features", 0], ["requirements", 2]]
  1463→ */
  1464→function parsePath(pathStr: string): Array<[string, number]> {
  1465→  const segments: Array<[string, number]> = [];
  1466→  const regex = /(\w+)\[(\d+)\]/g;
  1467→  let match;
  1468→  while ((match = regex.exec(pathStr)) !== null) {
  1469→    segments.push([match[1], parseInt(match[2], 10)]);
  1470→  }
  1471→  return segments;
  1472→}
  1473→
  1474→/**
  1475→ * Navigate to a location in a YAML structure using a path.
  1476→ * Returns the parent object and the array containing the target item.
  1477→ */
  1478→function navigateToPath(
  1479→  root: unknown,
  1480→  pathStr: string,
  1481→): { parent: Record<string, unknown>; array: unknown[]; index: number } | null {
  1482→  if (!pathStr) return null;
  1483→
  1484→  const segments = parsePath(pathStr);
  1485→  if (segments.length === 0) return null;
  1486→
  1487→  let current: unknown = root;
  1488→
  1489→  // Navigate to the parent of the last segment
  1490→  for (let i = 0; i < segments.length - 1; i++) {
  1491→    const [field, index] = segments[i];
  1492→    if (typeof current !== "object" || current === null) return null;
  1493→    const obj = current as Record<string, unknown>;
  1494→    if (!Array.isArray(obj[field])) return null;
  1495→    current = (obj[field] as unknown[])[index];
  1496→  }
  1497→
  1498→  // Get the final array and index
  1499→  const [finalField, finalIndex] = segments[segments.length - 1];
  1500→  if (typeof current !== "object" || current === null) return null;
  1501→  const parent = current as Record<string, unknown>;
  1502→  if (!Array.isArray(parent[finalField])) return null;
  1503→
  1504→  return {
  1505→    parent,
  1506→    array: parent[finalField] as unknown[],
  1507→    index: finalIndex,
  1508→  };
  1509→}
  1510→
  1511→/**
  1512→ * Find an item by ULID in a nested YAML structure.
  1513→ * Returns the path segments to reach it.
  1514→ */
  1515→function findItemInStructure(
  1516→  root: unknown,
  1517→  ulid: string,
  1518→  currentPath: string = "",
  1519→): { path: string; item: Record<string, unknown> } | null {
  1520→  if (!root || typeof root !== "object") return null;
  1521→
  1522→  const obj = root as Record<string, unknown>;
  1523→
  1524→  // Check if this is the item we're looking for
  1525→  if (obj._ulid === ulid) {
  1526→    return { path: currentPath, item: obj };
  1527→  }
  1528→
  1529→  // Search nested item fields
  1530→  for (const field of NESTED_ITEM_FIELDS) {
  1531→    if (Array.isArray(obj[field])) {
  1532→      const arr = obj[field] as unknown[];
  1533→      for (let i = 0; i < arr.length; i++) {
  1534→        const nestedPath = currentPath
  1535→          ? `${currentPath}.${field}[${i}]`
  1536→          : `${field}[${i}]`;
  1537→        const result = findItemInStructure(arr[i], ulid, nestedPath);
  1538→        if (result) return result;
  1539→      }
  1540→    }
  1541→  }
  1542→
  1543→  return null;
  1544→}
  1545→
  1546→/**
  1547→ * Create a new spec item with auto-generated fields
  1548→ */
  1549→export function createSpecItem(input: SpecItemInput): SpecItem {
  1550→  return {
  1551→    _ulid: input._ulid || ulid(),
  1552→    slugs: input.slugs || [],
  1553→    title: input.title,
  1554→    type: input.type,
  1555→    status: input.status,
  1556→    priority: input.priority,
  1557→    tags: input.tags || [],
  1558→    description: input.description,
  1559→    acceptance_criteria: input.acceptance_criteria,
  1560→    depends_on: input.depends_on || [],
  1561→    implements: input.implements || [],
  1562→    relates_to: input.relates_to || [],
  1563→    tests: input.tests || [],
  1564→    traits: input.traits || [],
  1565→    notes: input.notes || [],
  1566→    created: input.created || new Date().toISOString(),
  1567→    created_by: input.created_by,
  1568→  };
  1569→}
  1570→
  1571→/**
  1572→ * Map from item type to the field name used to store children of that type.
  1573→ */
  1574→const TYPE_TO_CHILD_FIELD: Record<string, string> = {
  1575→  feature: "features",
  1576→  requirement: "requirements",
  1577→  constraint: "constraints",
  1578→  decision: "decisions",
  1579→  module: "modules",
  1580→  trait: "traits",
  1581→};
  1582→
  1583→/**
  1584→ * Add a spec item as a child of a parent item.
  1585→ * @param parent The parent item to add under
  1586→ * @param child The new child item to add
  1587→ * @param childField Optional field name override (defaults based on child.type)
  1588→ */
  1589→export async function addChildItem(
  1590→  _ctx: KspecContext,
  1591→  parent: LoadedSpecItem,
  1592→  child: SpecItem,
  1593→  childField?: string,
  1594→): Promise<{ item: SpecItem; path: string }> {
  1595→  if (!parent._sourceFile) {
  1596→    throw new Error("Parent item has no source file");
  1597→  }
  1598→
  1599→  const field =
  1600→    childField || TYPE_TO_CHILD_FIELD[child.type || "feature"] || "features";
  1601→
  1602→  // Lock the file to prevent concurrent read-modify-write races
  1603→  return withFileLock(parent._sourceFile, async () => {
  1604→    // Load the raw YAML
  1605→    const raw = await readYamlFile<unknown>(parent._sourceFile!);
  1606→
  1607→    // Find the parent in the structure
  1608→    let parentObj: Record<string, unknown>;
  1609→    let parentPath: string;
  1610→
  1611→    if (parent._path) {
  1612→      const nav = navigateToPath(raw, parent._path);
  1613→      if (!nav) {
  1614→        throw new Error(`Could not navigate to parent path: ${parent._path}`);
  1615→      }
  1616→      parentObj = nav.array[nav.index] as Record<string, unknown>;
  1617→      parentPath = parent._path;
  1618→    } else {
  1619→      // Parent is the root item
  1620→      parentObj = raw as Record<string, unknown>;
  1621→      parentPath = "";
  1622→    }
  1623→
  1624→    // Ensure the child field array exists
  1625→    if (!Array.isArray(parentObj[field])) {
  1626→      parentObj[field] = [];
  1627→    }
  1628→
  1629→    // Add the child
  1630→    const childArray = parentObj[field] as unknown[];
  1631→    const cleanChild = stripSpecItemMetadata(child as LoadedSpecItem);
  1632→    childArray.push(cleanChild);
  1633→
  1634→    // Calculate the new child's path
  1635→    const childIndex = childArray.length - 1;
  1636→    const childPath = parentPath
  1637→      ? `${parentPath}.${field}[${childIndex}]`
  1638→      : `${field}[${childIndex}]`;
  1639→
  1640→    // Write back with format preservation
  1641→    await writeYamlFilePreserveFormat(parent._sourceFile!, raw);
  1642→
  1643→    return { item: cleanChild, path: childPath };
  1644→  });
  1645→}
  1646→
  1647→/**
  1648→ * Update a spec item in place within its source file.
  1649→ * Works with nested structures using the _path field.
  1650→ */
  1651→export async function updateSpecItem(
  1652→  _ctx: KspecContext,
  1653→  item: LoadedSpecItem,
  1654→  updates: Partial<SpecItemInput>,
  1655→): Promise<SpecItem> {
  1656→  if (!item._sourceFile) {
  1657→    throw new Error("Item has no source file");
  1658→  }
  1659→  assertSpecItemPatch(updates, "updateSpecItem");
  1660→
  1661→  // Lock the file to prevent concurrent read-modify-write races
  1662→  return withFileLock(item._sourceFile, async () => {
  1663→    // Load the raw YAML
  1664→    const raw = await readYamlFile<unknown>(item._sourceFile!);
  1665→
  1666→    // Find the item in the structure (use stored path or search by ULID)
  1667→    let targetObj: Record<string, unknown>;
  1668→
  1669→    if (item._path) {
  1670→      const nav = navigateToPath(raw, item._path);
  1671→      const candidate = nav?.array[nav.index];
  1672→      if (
  1673→        candidate &&
  1674→        typeof candidate === "object" &&
  1675→        (candidate as Record<string, unknown>)._ulid === item._ulid
  1676→      ) {
  1677→        targetObj = candidate as Record<string, unknown>;
  1678→      } else {
  1679→        const found = findItemInStructure(raw, item._ulid);
  1680→        if (!found) {
  1681→          throw new Error(
  1682→            `Could not find item ${item._ulid} in structure (path: ${item._path})`,
  1683→          );
  1684→        }
  1685→        targetObj = found.item;
  1686→      }
  1687→    } else {
  1688→      // Item might be the root, or we need to find it
  1689→      const found = findItemInStructure(raw, item._ulid);
  1690→      if (found) {
  1691→        targetObj = found.item;
  1692→      } else if ((raw as Record<string, unknown>)._ulid === item._ulid) {
  1693→        targetObj = raw as Record<string, unknown>;
  1694→      } else {
  1695→        throw new Error(`Could not find item ${item._ulid} in structure`);
  1696→      }
  1697→    }
  1698→
  1699→    // Apply updates (but never change _ulid)
  1700→    for (const [key, value] of Object.entries(updates)) {
  1701→      if (key !== "_ulid" && key !== "_sourceFile" && key !== "_path") {
  1702→        targetObj[key] = value;
  1703→      }
  1704→    }
  1705→
  1706→    // Write back with format preservation
  1707→    await writeYamlFilePreserveFormat(item._sourceFile!, raw);
  1708→
  1709→    return { ...item, ...updates, _ulid: item._ulid } as SpecItem;
  1710→  });
  1711→}
  1712→
  1713→/**
  1714→ * Check if an item is a trait with implementors.
  1715→ * Returns array of items that use this trait via the 'traits' field.
  1716→ */
  1717→export function findTraitImplementors(
  1718→  trait: LoadedSpecItem,
  1719→  allItems: LoadedSpecItem[],
  1720→): LoadedSpecItem[] {
  1721→  // Check if the item is actually a trait
  1722→  if (trait.type !== "trait") {
  1723→    return [];
  1724→  }
  1725→
  1726→  // Find all items that reference this trait in their 'traits' array
  1727→  const traitRefs = [`@${trait._ulid}`, ...trait.slugs.map((s) => `@${s}`)];
  1728→  return allItems.filter((item) => {
  1729→    if (!item.traits || item.traits.length === 0) return false;
  1730→    return item.traits.some((traitRef: string) => traitRefs.includes(traitRef));
  1731→  });
  1732→}
  1733→
  1734→/**
  1735→ * Delete a spec item from its source file.
  1736→ * Works with nested structures using the _path field.
  1737→ */
  1738→export async function deleteSpecItem(
  1739→  _ctx: KspecContext,
  1740→  item: LoadedSpecItem,
  1741→): Promise<boolean> {
  1742→  if (!item._sourceFile) {
  1743→    return false;
  1744→  }
  1745→
  1746→  // Lock the file to prevent concurrent read-modify-write races
  1747→  return withFileLock(item._sourceFile, async () => {
  1748→    try {
  1749→      const raw = await readYamlFile<unknown>(item._sourceFile!);
  1750→
  1751→      // If item has a path, navigate to it and remove from parent array
  1752→      if (item._path) {
  1753→        const nav = navigateToPath(raw, item._path);
  1754→        if (!nav) {
  1755→          return false;
  1756→        }
  1757→        // Remove the item from the array
  1758→        nav.array.splice(nav.index, 1);
  1759→        await writeYamlFilePreserveFormat(item._sourceFile!, raw);
  1760→        return true;
  1761→      }
  1762→
  1763→      // No path - try to find it by ULID
  1764→      const found = findItemInStructure(raw, item._ulid);
  1765→      if (found?.path) {
  1766→        const nav = navigateToPath(raw, found.path);
  1767→        if (nav) {
  1768→          nav.array.splice(nav.index, 1);
  1769→          await writeYamlFilePreserveFormat(item._sourceFile!, raw);
  1770→          return true;
  1771→        }
  1772→      }
  1773→
  1774→      // Maybe it's a root-level array item
  1775→      if (Array.isArray(raw)) {
  1776→        const index = raw.findIndex(
  1777→          (i: unknown) =>
  1778→            typeof i === "object" &&
  1779→            i !== null &&
  1780→            (i as Record<string, unknown>)._ulid === item._ulid,
  1781→        );
  1782→        if (index >= 0) {
  1783→          raw.splice(index, 1);
  1784→          await writeYamlFilePreserveFormat(item._sourceFile!, raw);
  1785→          return true;
  1786→        }
  1787→      }
  1788→
  1789→      return false;
  1790→    } catch {
  1791→      return false;
  1792→    }
  1793→  });
  1794→}
  1795→
  1796→/**
  1797→ * Save a spec item - either updates existing or adds to parent.
  1798→ * For new items, use addChildItem instead.
  1799→ */
  1800→export async function saveSpecItem(
  1801→  ctx: KspecContext,
  1802→  item: LoadedSpecItem,
  1803→  updates: Partial<SpecItemInput>,
  1804→): Promise<void> {
  1805→  assertSpecItemPatch(updates, "saveSpecItem");
  1806→
  1807→  if (Object.keys(updates).length === 0) {
  1808→    throw new Error("Cannot save spec item without updates. Pass a patch.");
  1809→  }
  1810→
  1811→  // If item has a source file and path, it's an update
  1812→  if (item._sourceFile && item._path) {
  1813→    await updateSpecItem(ctx, item, updates);
  1814→    return;
  1815→  }
  1816→
  1817→  // Otherwise, this is more complex - would need a parent
  1818→  throw new Error(
  1819→    "Cannot save new item without parent. Use addChildItem instead.",
  1820→  );
  1821→}
  1822→
  1823→// ============================================================
  1824→// INBOX SYSTEM
  1825→// ============================================================
  1826→
  1827→/**
  1828→ * Inbox item with runtime metadata for source tracking.
  1829→ */
  1830→export interface LoadedInboxItem extends InboxItem {
  1831→  _sourceFile?: string;
  1832→}
  1833→
  1834→/**
  1835→ * Get the inbox file path.
  1836→ *
  1837→ * When shadow enabled: .kspec/project.inbox.yaml
  1838→ * Otherwise: spec/project.inbox.yaml
  1839→ */
  1840→export function getInboxFilePath(ctx: KspecContext): string {
  1841→  return path.join(ctx.specDir, "project.inbox.yaml");
  1842→}
  1843→
  1844→/**
  1845→ * Parse inbox items from raw YAML payload.
  1846→ *
  1847→ * Supports canonical { inbox: [...] } shape and legacy plain-array shape.
  1848→ */
  1849→function parseInboxItemsFromRaw(raw: unknown): InboxItem[] {
  1850→  // Handle { inbox: [...] } format
  1851→  if (raw && typeof raw === "object" && "inbox" in raw) {
  1852→    const parsed = InboxFileSchema.safeParse(raw);
  1853→    if (parsed.success) {
  1854→      return parsed.data.inbox;
  1855→    }
  1856→
  1857→    const fallbackItems = (raw as { inbox?: unknown }).inbox;
  1858→    if (Array.isArray(fallbackItems)) {
  1859→      const items: InboxItem[] = [];
  1860→      for (const item of fallbackItems) {
  1861→        const result = InboxItemSchema.safeParse(item);
  1862→        if (result.success) {
  1863→          items.push(result.data);
  1864→        }
  1865→      }
  1866→      return items;
  1867→    }
  1868→  }
  1869→
  1870→  // Handle plain array format
  1871→  if (Array.isArray(raw)) {
  1872→    const items: InboxItem[] = [];
  1873→    for (const item of raw) {
  1874→      const result = InboxItemSchema.safeParse(item);
  1875→      if (result.success) {
  1876→        items.push(result.data);
  1877→      }
  1878→    }
  1879→    return items;
  1880→  }
  1881→
  1882→  return [];
  1883→}
  1884→
  1885→/**
  1886→ * Load inbox items from an explicit file path.
  1887→ */
  1888→async function loadInboxItemsFromFile(inboxPath: string): Promise<InboxItem[]> {
  1889→  const raw = await readYamlFile<unknown>(inboxPath);
  1890→  return parseInboxItemsFromRaw(raw);
  1891→}
  1892→
  1893→/**
  1894→ * Load all inbox items from the project.
  1895→ */
  1896→export async function loadInboxItems(
  1897→  ctx: KspecContext,
  1898→): Promise<LoadedInboxItem[]> {
  1899→  const inboxPath = getInboxFilePath(ctx);
  1900→
  1901→  try {
  1902→    const items = await loadInboxItemsFromFile(inboxPath);
  1903→    return items.map((item) => ({
  1904→      ...item,
  1905→      _sourceFile: inboxPath,
  1906→    }));
  1907→  } catch {
  1908→    // File doesn't exist or parse error
  1909→    return [];
  1910→  }
  1911→}
  1912→
  1913→/**
  1914→ * Create a new inbox item with auto-generated fields.
  1915→ *
  1916→ * AC: @config-author — supports config author in fallback chain
  1917→ *
  1918→ * @param input Inbox item input
  1919→ * @param configAuthor Optional author from kspec.config.yaml identity.author
  1920→ */
  1921→export function createInboxItem(
  1922→  input: InboxItemInput,
  1923→  configAuthor?: string | null,
  1924→): InboxItem {
  1925→  return {
  1926→    _ulid: input._ulid || ulid(),
  1927→    text: input.text,
  1928→    created_at: input.created_at || new Date().toISOString(),
  1929→    tags: input.tags || [],
  1930→    added_by: input.added_by ?? getAuthor(configAuthor),
  1931→  };
  1932→}
  1933→
  1934→/**
  1935→ * Strip runtime metadata before serialization.
  1936→ */
  1937→function stripInboxMetadata(item: LoadedInboxItem | InboxItem): InboxItem {
  1938→  const { _sourceFile, ...cleanItem } = item as LoadedInboxItem;
  1939→  return cleanItem as InboxItem;
  1940→}
  1941→
  1942→/**
  1943→ * Save an inbox item (add or update).
  1944→ */
  1945→export async function saveInboxItem(
  1946→  ctx: KspecContext,
  1947→  item: LoadedInboxItem,
  1948→): Promise<void> {
  1949→  const inboxPath = getInboxFilePath(ctx);
  1950→
  1951→  // Lock the file to prevent concurrent read-modify-write races
  1952→  await withFileLock(inboxPath, async () => {
  1953→    // Ensure directory exists
  1954→    const dir = path.dirname(inboxPath);
  1955→    await fs.mkdir(dir, { recursive: true });
  1956→
  1957→    // Load existing items
  1958→    let existingItems: InboxItem[] = [];
  1959→
  1960→    try {
  1961→      existingItems = await loadInboxItemsFromFile(inboxPath);
  1962→    } catch {
  1963→      // File doesn't exist, start fresh
  1964→    }
  1965→
  1966→    const cleanItem = stripInboxMetadata(item);
  1967→
  1968→    // Update existing or add new
  1969→    const existingIndex = existingItems.findIndex(
  1970→      (i) => i._ulid === item._ulid,
  1971→    );
  1972→    if (existingIndex >= 0) {
  1973→      existingItems[existingIndex] = cleanItem;
  1974→    } else {
  1975→      existingItems.push(cleanItem);
  1976→    }
  1977→
  1978→    // Save with { inbox: [...] } format and format preservation
  1979→    await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  1980→  });
  1981→}
  1982→
  1983→/**
  1984→ * Atomically mutate an inbox item using the latest on-disk state.
  1985→ *
  1986→ * The callback receives the current item value while holding the inbox file lock,
  1987→ * so concurrent writers do not clobber unrelated fields (for example text vs tags).
  1988→ */
  1989→export async function mutateInboxItemAtomically(
  1990→  ctx: KspecContext,
  1991→  item: LoadedInboxItem,
  1992→  mutate: (
  1993→    latestItem: LoadedInboxItem,
  1994→  ) => InboxItem | LoadedInboxItem | Promise<InboxItem | LoadedInboxItem>,
  1995→): Promise<LoadedInboxItem> {
  1996→  const inboxPath = item._sourceFile || getInboxFilePath(ctx);
  1997→  let updatedItem: LoadedInboxItem | undefined;
  1998→
  1999→  await withFileLock(inboxPath, async () => {
  2000→    // Ensure directory exists (important for default path in new repos)
  2001→    const dir = path.dirname(inboxPath);
  2002→    await fs.mkdir(dir, { recursive: true });
  2003→
  2004→    let existingItems: InboxItem[] = [];
  2005→    try {
  2006→      existingItems = await loadInboxItemsFromFile(inboxPath);
  2007→    } catch {
  2008→      throw new Error(`Inbox file not found: ${inboxPath}`);
  2009→    }
  2010→
  2011→    const itemIndex = existingItems.findIndex(
  2012→      (existingItem) => existingItem._ulid === item._ulid,
  2013→    );
  2014→    if (itemIndex === -1) {
  2015→      throw new Error(`Inbox item not found in file: ${item._ulid}`);
  2016→    }
  2017→
  2018→    const latestItem: LoadedInboxItem = {
  2019→      ...existingItems[itemIndex],
  2020→      _sourceFile: inboxPath,
  2021→    };
  2022→
  2023→    const mutatedItem = await mutate(latestItem);
  2024→    const cleanMutatedItem = stripInboxMetadata(mutatedItem);
  2025→    existingItems[itemIndex] = cleanMutatedItem;
  2026→
  2027→    await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  2028→
  2029→    updatedItem = {
  2030→      ...cleanMutatedItem,
  2031→      _sourceFile: inboxPath,
  2032→    };
  2033→  });
  2034→
  2035→  if (!updatedItem) {
  2036→    throw new Error(`Failed to mutate inbox item atomically: ${item._ulid}`);
  2037→  }
  2038→
  2039→  return updatedItem;
  2040→}
  2041→
  2042→/**
  2043→ * Delete an inbox item by ULID.
  2044→ */
  2045→export async function deleteInboxItem(
  2046→  ctx: KspecContext,
  2047→  ulid: string,
  2048→): Promise<boolean> {
  2049→  const inboxPath = getInboxFilePath(ctx);
  2050→
  2051→  // Lock the file to prevent concurrent read-modify-write races
  2052→  return withFileLock(inboxPath, async () => {
  2053→    try {
  2054→      const existingItems = await loadInboxItemsFromFile(inboxPath);
  2055→
  2056→      const index = existingItems.findIndex((i) => i._ulid === ulid);
  2057→      if (index < 0) {
  2058→        return false;
  2059→      }
  2060→
  2061→      existingItems.splice(index, 1);
  2062→      await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  2063→      return true;
  2064→    } catch {
  2065→      return false;
  2066→    }
  2067→  });
  2068→}
  2069→
  2070→/**
  2071→ * Find an inbox item by reference (ULID or short ULID).
  2072→ */
  2073→export function findInboxItemByRef(
  2074→  items: LoadedInboxItem[],
  2075→  ref: string,
  2076→): LoadedInboxItem | undefined {
  2077→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  2078→
  2079→  return items.find((item) => {
  2080→    // Match full ULID
  2081→    if (item._ulid === cleanRef) return true;
  2082→    // Match short ULID (prefix)
  2083→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  2084→      return true;
  2085→    return false;
  2086→  });
  2087→}
  2088→
  2089→// ============================================================
  2090→// TRIAGE SYSTEM
  2091→// ============================================================
  2092→
  2093→/**
  2094→ * Triage record with runtime metadata for source tracking.
  2095→ */
  2096→export interface LoadedTriageRecord extends TriageRecord {
  2097→  _sourceFile?: string;
  2098→}
  2099→
  2100→/**
  2101→ * Get the triage file path.
  2102→ * AC: @triage-record-schema ac-6
  2103→ *
  2104→ * When shadow enabled: .kspec/project.triage.yaml
  2105→ * Otherwise: spec/project.triage.yaml
  2106→ */
  2107→export function getTriageFilePath(ctx: KspecContext): string {
  2108→  return path.join(ctx.specDir, "project.triage.yaml");
  2109→}
  2110→
  2111→/**
  2112→ * Load all triage records from the project.
  2113→ * AC: @triage-record-schema ac-6, ac-7
  2114→ */
  2115→export async function loadTriageRecords(
  2116→  ctx: KspecContext,
  2117→): Promise<LoadedTriageRecord[]> {
  2118→  const triagePath = getTriageFilePath(ctx);
  2119→
  2120→  try {
  2121→    const raw = await readYamlFile<unknown>(triagePath);
  2122→
  2123→    // Handle { kynetic_triage: "1.0", triage: [...] } format
  2124→    if (raw && typeof raw === "object" && "triage" in raw) {
  2125→      const parsed = TriageFileSchema.safeParse(raw);
  2126→      if (parsed.success) {
  2127→        return parsed.data.triage.map((record) => ({
  2128→          ...record,
  2129→          _sourceFile: triagePath,
  2130→        }));
  2131→      }
  2132→    }
  2133→
  2134→    // Handle plain array format
  2135→    if (Array.isArray(raw)) {
  2136→      const records: LoadedTriageRecord[] = [];
  2137→      for (const item of raw) {
  2138→        const result = TriageRecordSchema.safeParse(item);
  2139→        if (result.success) {
  2140→          records.push({ ...result.data, _sourceFile: triagePath });
  2141→        }
  2142→      }
  2143→      return records;
  2144→    }
  2145→
  2146→    return [];
  2147→  } catch {
  2148→    // File doesn't exist or parse error
  2149→    return [];
  2150→  }
  2151→}
  2152→
  2153→/**
  2154→ * Strip runtime metadata before serialization.
  2155→ */
  2156→function stripTriageMetadata(record: LoadedTriageRecord): TriageRecord {
  2157→  const { _sourceFile, ...cleanRecord } = record;
  2158→  return cleanRecord as TriageRecord;
  2159→}
  2160→
  2161→/**
  2162→ * Save a triage record (add or update).
  2163→ * AC: @triage-record-schema ac-8 — upsert on inbox_ref (one record per inbox item)
  2164→ * AC: @triage-record-schema ac-9 — sets updated_at on every mutation
  2165→ */
  2166→export async function saveTriageRecord(
  2167→  ctx: KspecContext,
  2168→  record: LoadedTriageRecord,
  2169→): Promise<void> {
  2170→  const triagePath = getTriageFilePath(ctx);
  2171→
  2172→  // Lock the file to prevent concurrent read-modify-write races
  2173→  await withFileLock(triagePath, async () => {
  2174→    // Ensure directory exists
  2175→    const dir = path.dirname(triagePath);
  2176→    await fs.mkdir(dir, { recursive: true });
  2177→
  2178→    // Load existing records
  2179→    let existingRecords: TriageRecord[] = [];
  2180→
  2181→    try {
  2182→      const raw = await readYamlFile<unknown>(triagePath);
  2183→      if (raw && typeof raw === "object" && "triage" in raw) {
  2184→        const parsed = TriageFileSchema.safeParse(raw);
  2185→        if (parsed.success) {
  2186→          existingRecords = parsed.data.triage;
  2187→        }
  2188→      } else if (Array.isArray(raw)) {
  2189→        for (const item of raw) {
  2190→          const result = TriageRecordSchema.safeParse(item);
  2191→          if (result.success) {
  2192→            existingRecords.push(result.data);
  2193→          }
  2194→        }
  2195→      }
  2196→    } catch {
  2197→      // File doesn't exist, start fresh
  2198→    }
  2199→
  2200→    const cleanRecord = stripTriageMetadata(record);
  2201→
  2202→    // AC: ac-9 — set updated_at on every mutation
  2203→    cleanRecord.updated_at = new Date().toISOString();
  2204→
  2205→    // AC: ac-8 — upsert: check for existing record by ULID first, then by inbox_ref
  2206→    const existingByUlid = existingRecords.findIndex(
  2207→      (r) => r._ulid === record._ulid,
  2208→    );
  2209→    if (existingByUlid >= 0) {
  2210→      existingRecords[existingByUlid] = cleanRecord;
  2211→    } else {
  2212→      // Check for existing record with same inbox_ref (uniqueness constraint)
  2213→      // Preserve existing identity (_ulid, created_at) when upserting by inbox_ref
  2214→      const existingByInboxRef = existingRecords.findIndex(
  2215→        (r) => r.inbox_ref === record.inbox_ref,
  2216→      );
  2217→      if (existingByInboxRef >= 0) {
  2218→        const existing = existingRecords[existingByInboxRef];
  2219→        existingRecords[existingByInboxRef] = {
  2220→          ...cleanRecord,
  2221→          _ulid: existing._ulid,
  2222→          created_at: existing.created_at,
  2223→        };
  2224→      } else {
  2225→        existingRecords.push(cleanRecord);
  2226→      }
  2227→    }
  2228→
  2229→    // Save with { kynetic_triage: "1.0", triage: [...] } format
  2230→    await writeYamlFilePreserveFormat(triagePath, {
  2231→      kynetic_triage: "1.0",
  2232→      triage: existingRecords,
  2233→    });
  2234→  });
  2235→}
  2236→
  2237→/**
  2238→ * Find a triage record by reference (ULID or short ULID).
  2239→ */
  2240→export function findTriageRecordByRef(
  2241→  records: LoadedTriageRecord[],
  2242→  ref: string,
  2243→): LoadedTriageRecord | undefined {
  2244→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  2245→
  2246→  return records.find((record) => {
  2247→    // Match full ULID
  2248→    if (record._ulid === cleanRef) return true;
  2249→    // Match short ULID (prefix)
  2250→    if (record._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  2251→      return true;
  2252→    return false;
  2253→  });
  2254→}
  2255→
  2256→/**
  2257→ * Find a triage record by inbox item reference.
  2258→ * AC: @triage-record-schema ac-8 — lookup by inbox_ref for upsert
  2259→ */
  2260→export function findTriageRecordByInboxRef(
  2261→  records: LoadedTriageRecord[],
  2262→  inboxRef: string,
  2263→): LoadedTriageRecord | undefined {
  2264→  const cleanRef = inboxRef.startsWith("@") ? inboxRef.slice(1) : inboxRef;
  2265→
  2266→  return records.find((record) => record.inbox_ref === cleanRef);
  2267→}
  2268→
  2269→// ─── Patch Operations ────────────────────────────────────────────────────────
  2270→
  2271→/**
  2272→ * A single patch operation for bulk patching
  2273→ */
  2274→export interface PatchOperation {
  2275→  ref: string;
  2276→  data: Record<string, unknown>;
  2277→}
  2278→
  2279→/**
  2280→ * Result of a single patch operation
  2281→ */
  2282→export interface PatchResult {
  2283→  ref: string;
  2284→  status: "updated" | "skipped" | "error";
  2285→  ulid?: string;
  2286→  error?: string;
  2287→}
  2288→
  2289→/**
  2290→ * Result of a bulk patch operation
  2291→ */
  2292→export interface BulkPatchResult {
  2293→  results: PatchResult[];
  2294→  summary: {
  2295→    total: number;
  2296→    updated: number;
  2297→    failed: number;
  2298→    skipped: number;
  2299→  };
  2300→}
  2301→
  2302→/**
  2303→ * Options for patch operations
  2304→ */
  2305→export interface PatchOptions {
  2306→  allowUnknown?: boolean;
  2307→  dryRun?: boolean;
  2308→  failFast?: boolean;
  2309→}
  2310→
  2311→/**
  2312→ * Bulk patch spec items.
  2313→ * Resolves refs, validates data, applies patches.
  2314→ * Continues on error by default (use failFast to stop on first error).
  2315→ */
  2316→export async function patchSpecItems(
  2317→  ctx: KspecContext,
  2318→  refIndex: ReferenceIndex,
  2319→  items: LoadedSpecItem[],
  2320→  patches: PatchOperation[],
  2321→  options: PatchOptions = {},
  2322→): Promise<BulkPatchResult> {
  2323→  const results: PatchResult[] = [];
  2324→  let stopProcessing = false;
  2325→
  2326→  for (const patch of patches) {
  2327→    if (stopProcessing) {
  2328→      results.push({ ref: patch.ref, status: "skipped" });
  2329→      continue;
  2330→    }
  2331→
  2332→    // Resolve ref
  2333→    const resolved = refIndex.resolve(patch.ref);
  2334→    if (!resolved.ok) {
  2335→      const errorMsg =
  2336→        resolved.error === "not_found"
  2337→          ? `Item not found: ${patch.ref}`
  2338→          : resolved.error === "ambiguous"
  2339→            ? `Ambiguous ref: ${patch.ref}`
  2340→            : `Duplicate slug: ${patch.ref}`;
  2341→      results.push({ ref: patch.ref, status: "error", error: errorMsg });
  2342→      if (options.failFast) {
  2343→        stopProcessing = true;
  2344→      }
  2345→      continue;
  2346→    }
  2347→
  2348→    // Find the item
  2349→    const item = items.find((i) => i._ulid === resolved.ulid);
  2350→    if (!item) {
  2351→      // Ref resolved but it's not a spec item (might be a task)
  2352→      results.push({
  2353→        ref: patch.ref,
  2354→        status: "error",
  2355→        error: "Not a spec item",
  2356→      });
  2357→      if (options.failFast) {
  2358→        stopProcessing = true;
  2359→      }
  2360→      continue;
  2361→    }
  2362→
  2363→    // Dry run - just record what would happen
  2364→    if (options.dryRun) {
  2365→      results.push({ ref: patch.ref, status: "updated", ulid: item._ulid });
  2366→      continue;
  2367→    }
  2368→
  2369→    // Apply the patch
  2370→    try {
  2371→      await updateSpecItem(ctx, item, patch.data);
  2372→      results.push({ ref: patch.ref, status: "updated", ulid: item._ulid });
  2373→    } catch (err) {
  2374→      const errorMsg = err instanceof Error ? err.message : String(err);
  2375→      results.push({ ref: patch.ref, status: "error", error: errorMsg });
  2376→      if (options.failFast) {
  2377→        stopProcessing = true;
  2378→      }
  2379→    }
  2380→  }
  2381→
  2382→  return {
  2383→    results,
  2384→    summary: {
  2385→      total: patches.length,
  2386→      updated: results.filter((r) => r.status === "updated").length,
  2387→      failed: results.filter((r) => r.status === "error").length,
  2388→      skipped: results.filter((r) => r.status === "skipped").length,
  2389→    },
  2390→  };
  2391→}
  2392→
```