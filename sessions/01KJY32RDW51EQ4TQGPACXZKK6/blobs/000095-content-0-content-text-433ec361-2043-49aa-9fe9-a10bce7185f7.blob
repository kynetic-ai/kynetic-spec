    49→/**
    50→ * Log a debug message (only when KSPEC_DEBUG=1)
    51→ */
    52→function debugLog(prefix: string, message: string): void {
    53→  if (process.env.KSPEC_DEBUG === "1") {
    54→    console.error(`[DEBUG] ${prefix}: ${message}`);
    55→  }
    56→}
    57→
    58→/**
    59→ * Parse a manifest and emit deprecation warnings for deprecated fields.
    60→ *
    61→ * AC: @config-manifest-cleanup ac-4 — debug-level deprecation note for daemon block
    62→ */
    63→function parseManifestWithWarnings(rawManifest: unknown): Manifest {
    64→  const manifest = ManifestSchema.parse(rawManifest);
    65→
    66→  // AC: @config-manifest-cleanup ac-4 — log debug-level deprecation note for daemon block
    67→  if (manifest.daemon) {
    68→    debugLog(
    69→      "manifest",
    70→      'Deprecated "daemon" block found in manifest. Use kspec.config.yaml instead.',
    71→    );
    72→  }
    73→
    74→  // Also warn for deprecated config block
    75→  if (manifest.config) {
    76→    debugLog(
    77→      "manifest",
    78→      'Deprecated "config" block found in manifest. Use kspec.config.yaml instead.',
    79→    );
    80→  }
    81→
    82→  return manifest;
    83→}
