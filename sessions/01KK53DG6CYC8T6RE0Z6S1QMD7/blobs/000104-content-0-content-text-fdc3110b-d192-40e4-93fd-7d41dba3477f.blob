```
     1→<!--
     2→  AC: @web-dashboard ac-5 — Task detail content showing description, notes, todos, dependencies.
     3→  AC: @web-dashboard ac-6 — Spec reference is clickable link to spec item detail.
     4→  AC: @web-dashboard ac-7 — Start Task action button.
     5→  AC: @web-dashboard ac-8 — Add Note textarea and submit.
     6→
     7→  Shared task detail content used by both TaskDetailModal (kanban board)
     8→  and the task list Sheet panel. Handles all task display, actions, and notes.
     9→-->
    10→<script lang="ts">
    11→	import type { TaskDetail } from '@kynetic-ai/shared';
    12→	import {
    13→		startTask,
    14→		submitTask,
    15→		completeTask,
    16→		blockTask,
    17→		addTaskNote
    18→	} from '$lib/api';
    19→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    20→	import { Badge } from '$lib/components/ui/badge';
    21→	import { Button } from '$lib/components/ui/button';
    22→	import { Textarea } from '$lib/components/ui/textarea';
    23→	import { Input } from '$lib/components/ui/input';
    24→	import { Separator } from '$lib/components/ui/separator';
    25→	import { Skeleton } from '$lib/components/ui/skeleton';
    26→	import ReferenceLink from '$lib/components/ReferenceLink.svelte';
    27→	import { getStatusClasses, formatVcsRef } from './board-utils';
    28→	import GitBranch from '@lucide/svelte/icons/git-branch';
    29→	import ExternalLink from '@lucide/svelte/icons/external-link';
    30→
    31→	interface Props {
    32→		/** The task detail to display, or null if not yet loaded. */
    33→		task: TaskDetail | null;
    34→		/** Whether the task is currently loading. */
    35→		loading: boolean;
    36→		/** Error message to display, if any. */
    37→		error: string;
    38→		/** Called after a task action succeeds (start, submit, complete, block, add note). */
    39→		onTaskUpdated?: (task: TaskDetail) => void;
    40→	}
    41→
    42→	let { task, loading, error, onTaskUpdated }: Props = $props();
    43→
    44→	let actionError = $state('');
    45→	let isSubmitting = $state(false);
    46→
    47→	// Note form
    48→	let noteContent = $state('');
    49→
    50→	// Block/Complete reason form
    51→	let reasonInput = $state('');
    52→	let showReasonFor = $state<'block' | 'complete' | null>(null);
    53→
    54→	// Reset local state when task changes
    55→	$effect(() => {
    56→		if (task) {
    57→			// Task changed, reset action-specific state
    58→			actionError = '';
    59→			noteContent = '';
    60→			reasonInput = '';
    61→			showReasonFor = null;
    62→		}
    63→	});
    64→
    65→	async function handleAction(action: () => Promise<void>) {
    66→		if (!task) return;
    67→		isSubmitting = true;
    68→		actionError = '';
    69→		try {
    70→			await action();
    71→			// Re-fetch is handled by the parent via onTaskUpdated
    72→			onTaskUpdated?.(task);
    73→		} catch (err) {
    74→			if (err instanceof ReadOnlyModeError) {
    75→				actionError = err.message;
    76→			} else {
    77→				actionError = err instanceof Error ? err.message : 'Action failed';
    78→			}
    79→		} finally {
    80→			isSubmitting = false;
    81→		}
    82→	}
    83→
    84→	function handleStart() {
    85→		if (!task) return;
    86→		handleAction(() => startTask(task!._ulid));
    87→	}
    88→
    89→	function handleSubmit() {
    90→		if (!task) return;
    91→		handleAction(() => submitTask(task!._ulid));
    92→	}
    93→
    94→	function handleComplete() {
    95→		if (!task || !reasonInput.trim()) return;
    96→		const reason = reasonInput.trim();
    97→		handleAction(async () => {
    98→			await completeTask(task!._ulid, reason);
    99→			reasonInput = '';
   100→			showReasonFor = null;
   101→		});
   102→	}
   103→
   104→	function handleBlock() {
   105→		if (!task || !reasonInput.trim()) return;
   106→		const reason = reasonInput.trim();
   107→		handleAction(async () => {
   108→			await blockTask(task!._ulid, reason);
   109→			reasonInput = '';
   110→			showReasonFor = null;
   111→		});
   112→	}
   113→
   114→	function handleAddNote() {
   115→		if (!task || !noteContent.trim()) return;
   116→		const content = noteContent.trim();
   117→		handleAction(async () => {
   118→			await addTaskNote(task!._ulid, content);
   119→			noteContent = '';
   120→		});
   121→	}
   122→
   123→	function formatDate(dateStr: string): string {
   124→		return new Intl.DateTimeFormat('en-US', {
   125→			month: 'short',
   126→			day: 'numeric',
   127→			hour: '2-digit',
   128→			minute: '2-digit'
   129→		}).format(new Date(dateStr));
   130→	}
   131→
   132→	let statusInfo = $derived(task ? getStatusClasses(task.status) : null);
   133→	let slug = $derived(task?.slugs?.[0] ?? task?._ulid?.slice(0, 8) ?? '');
   134→</script>
   135→
   136→{#if loading}
   137→	<div class="flex flex-col gap-4 py-4" data-testid="task-detail-skeleton">
   138→		<Skeleton class="h-6 w-3/4 ds-shimmer" />
   139→		<Skeleton class="h-3 w-24 ds-shimmer" />
   140→		<div class="flex gap-2">
   141→			<Skeleton class="h-5 w-20 rounded-full ds-shimmer" />
   142→			<Skeleton class="h-5 w-24 rounded-full ds-shimmer" />
   143→		</div>
   144→		<div>
   145→			<Skeleton class="h-3 w-10 mb-1 ds-shimmer" />
   146→			<Skeleton class="h-4 w-32 ds-shimmer" />
   147→		</div>
   148→		<div class="flex gap-1">
   149→			<Skeleton class="h-5 w-12 rounded-full ds-shimmer" />
   150→			<Skeleton class="h-5 w-16 rounded-full ds-shimmer" />
   151→		</div>
   152→		<Skeleton class="h-px w-full ds-shimmer" />
   153→		<div>
   154→			<Skeleton class="h-3 w-16 mb-2 ds-shimmer" />
   155→			<Skeleton class="h-16 w-full rounded-md ds-shimmer" />
   156→		</div>
   157→	</div>
   158→{:else if error}
   159→	<div class="bg-destructive/10 text-destructive p-4 rounded-lg" role="alert">
   160→		{error}
   161→	</div>
   162→{:else if task && statusInfo}
   163→	<div class="flex flex-col gap-4">
   164→		<!-- Description -->
   165→		{#if task.description}
   166→			<p class="text-sm text-muted-foreground" data-testid="task-description">
   167→				{task.description}
   168→			</p>
   169→		{/if}
   170→
   171→		<!-- Status, priority, type -->
   172→		<div class="flex flex-wrap gap-2 items-center">
   173→			<Badge class="{statusInfo.bg} {statusInfo.fg}" data-testid="task-status-badge">
   174→				{statusInfo.label}
   175→			</Badge>
   176→			<Badge variant="outline" data-testid="task-priority">Priority {task.priority}</Badge>
   177→			<Badge variant="outline" data-testid="task-type">{task.type}</Badge>
   178→			{#if task.automation}
   179→				<Badge variant="secondary" data-testid="task-automation">
   180→					{task.automation}
   181→				</Badge>
   182→			{/if}
   183→		</div>
   184→
   185→		<!-- Spec ref -->
   186→		<!-- AC: @web-dashboard ac-6 -->
   187→		{#if task.spec_ref}
   188→			<div data-testid="task-spec-ref">
   189→				<p class="text-xs font-medium text-muted-foreground mb-0.5">Spec</p>
   190→				<ReferenceLink ref={task.spec_ref} type="spec" />
   191→			</div>
   192→		{/if}
   193→
   194→		<!-- Tags -->
   195→		{#if task.tags?.length > 0}
   196→			<div data-testid="task-tags">
   197→				<p class="text-xs font-medium text-muted-foreground mb-1">Tags</p>
   198→				<div class="flex flex-wrap gap-1">
   199→					{#each task.tags as tag}
   200→						<Badge variant="secondary">{tag}</Badge>
   201→					{/each}
   202→				</div>
   203→			</div>
   204→		{/if}
   205→
   206→		<!-- Dependencies -->
   207→		<div data-testid="task-dependencies">
   208→			{#if task.depends_on?.length > 0}
   209→				<p class="text-xs font-medium text-muted-foreground mb-1">Dependencies</p>
   210→				<ul class="text-sm space-y-0.5">
   211→					{#each task.depends_on as dep}
   212→						<li>
   213→							<ReferenceLink ref={dep} type="task" class="text-xs" />
   214→						</li>
   215→					{/each}
   216→				</ul>
   217→			{:else}
   218→				<p class="text-sm text-muted-foreground">No dependencies</p>
   219→			{/if}
   220→		</div>
   221→
   222→		<!-- Blocked by -->
   223→		{#if task.blocked_by?.length > 0}
   224→			<div data-testid="task-blocked-by">
   225→				<p class="text-xs font-medium text-destructive mb-1">Blocked By</p>
   226→				<ul class="text-sm space-y-0.5">
   227→					{#each task.blocked_by as blocker}
   228→						<li>
   229→							<ReferenceLink ref={blocker} type="task" class="text-xs" />
   230→						</li>
   231→					{/each}
   232→				</ul>
   233→			</div>
   234→		{/if}
   235→
   236→		<!-- VCS info (branch, PR link) -->
   237→		{#if task.vcs_refs?.length > 0}
   238→			<div data-testid="task-vcs">
   239→				<p class="text-xs font-medium text-muted-foreground mb-1">VCS</p>
   240→				<ul class="text-sm space-y-1">
   241→					{#each task.vcs_refs as ref}
   242→						{@const vcsInfo = formatVcsRef(ref)}
   243→						<li class="flex items-center gap-1.5">
   244→							<GitBranch class="size-3 text-muted-foreground flex-shrink-0" />
   245→							{#if vcsInfo.url}
   246→								<a
   247→									href={vcsInfo.url}
   248→									target="_blank"
   249→									rel="noopener noreferrer"
   250→									class="text-xs text-primary hover:underline font-mono inline-flex items-center gap-1"
   251→								>
   252→									{vcsInfo.label}
   253→									<ExternalLink class="size-3" />
   254→								</a>
   255→							{:else}
   256→								<span class="text-muted-foreground font-mono text-xs">{vcsInfo.label}</span>
   257→							{/if}
   258→						</li>
   259→					{/each}
   260→				</ul>
   261→			</div>
   262→		{/if}
   263→
   264→		<!-- Plan ref -->
   265→		{#if task.plan_ref}
   266→			<div data-testid="task-plan-ref">
   267→				<p class="text-xs font-medium text-muted-foreground mb-0.5">Plan</p>
   268→				<ReferenceLink ref={task.plan_ref} type="plan" />
   269→			</div>
   270→		{:else if task.derivation}
   271→			<div data-testid="task-derivation">
   272→				<p class="text-xs font-medium text-muted-foreground mb-0.5">Derivation</p>
   273→				<p class="text-sm text-muted-foreground">{task.derivation}</p>
   274→			</div>
   275→		{/if}
   276→
   277→		<!-- Session link -->
   278→		{#if task.session_ref}
   279→			<div data-testid="task-session-ref">
   280→				<p class="text-xs font-medium text-muted-foreground mb-0.5">Session</p>
   281→				<ReferenceLink ref={task.session_ref} type="session" />
   282→			</div>
   283→		{/if}
   284→
   285→		<Separator />
   286→
   287→		<!-- Actions -->
   288→		<!-- AC: @web-dashboard ac-7 -->
   289→		{#if !isStaticMode()}
   290→			<div class="flex flex-wrap gap-2" data-testid="task-actions">
   291→				{#if task.status === 'pending'}
   292→					<Button
   293→						size="sm"
   294→						onclick={handleStart}
   295→						disabled={isSubmitting}
   296→						data-testid="action-start"
   297→					>
   298→						{isSubmitting ? 'Starting...' : 'Start'}
   299→					</Button>
   300→				{/if}
   301→
   302→				{#if task.status === 'in_progress' || task.status === 'needs_work'}
   303→					<Button
   304→						size="sm"
   305→						onclick={handleSubmit}
   306→						disabled={isSubmitting}
   307→						data-testid="action-submit"
   308→					>
   309→						{isSubmitting ? 'Submitting...' : 'Submit for Review'}
   310→					</Button>
   311→				{/if}
   312→
   313→				{#if task.status === 'in_progress' || task.status === 'pending_review'}
   314→					<Button
   315→						size="sm"
   316→						variant="outline"
   317→						onclick={() => {
   318→							showReasonFor = 'complete';
   319→							reasonInput = '';
   320→						}}
   321→						disabled={isSubmitting}
   322→						data-testid="action-complete-toggle"
   323→					>
   324→						Complete
   325→					</Button>
   326→				{/if}
   327→
   328→				{#if task.status !== 'blocked' && task.status !== 'completed' && task.status !== 'cancelled'}
   329→					<Button
   330→						size="sm"
   331→						variant="destructive"
   332→						onclick={() => {
   333→							showReasonFor = 'block';
   334→							reasonInput = '';
   335→						}}
   336→						disabled={isSubmitting}
   337→						data-testid="action-block-toggle"
   338→					>
   339→						Block
   340→					</Button>
   341→				{/if}
   342→			</div>
   343→
   344→			<!-- Reason input for block/complete -->
   345→			{#if showReasonFor}
   346→				<div class="flex gap-2" data-testid="reason-input">
   347→					<Input
   348→						bind:value={reasonInput}
   349→						placeholder="{showReasonFor === 'block' ? 'Block' : 'Completion'} reason..."
   350→						class="flex-1"
   351→					/>
   352→					<Button
   353→						size="sm"
   354→						onclick={showReasonFor === 'block' ? handleBlock : handleComplete}
   355→						disabled={isSubmitting || !reasonInput.trim()}
   356→					>
   357→						Confirm
   358→					</Button>
   359→					<Button
   360→						size="sm"
   361→						variant="ghost"
   362→						onclick={() => {
   363→							showReasonFor = null;
   364→							reasonInput = '';
   365→						}}
   366→					>
   367→						Cancel
   368→					</Button>
   369→				</div>
   370→			{/if}
   371→		{/if}
   372→
   373→		{#if actionError}
   374→			<p class="text-sm text-destructive" data-testid="action-error">{actionError}</p>
   375→		{/if}
   376→
   377→		<Separator />
   378→
   379→		<!-- Todos -->
   380→		<div data-testid="task-todos">
   381→			{#if task.todos && task.todos.length > 0}
   382→				<p class="text-xs font-medium text-muted-foreground mb-1">
   383→					Todos ({task.todos.length})
   384→				</p>
   385→				<ul class="space-y-1">
   386→					{#each task.todos as todo}
   387→						<li class="flex items-start gap-2 text-sm">
   388→							<span class="mt-0.5 text-xs">
   389→								{#if todo.done}
   390→									&#x2705;
   391→								{:else}
   392→									&#x23F8;&#xFE0F;
   393→								{/if}
   394→							</span>
   395→							<span class:line-through={todo.done}>
   396→								{todo.text}
   397→							</span>
   398→						</li>
   399→					{/each}
   400→				</ul>
   401→			{:else}
   402→				<p class="text-sm text-muted-foreground">No todos</p>
   403→			{/if}
   404→		</div>
   405→		<Separator />
   406→
   407→		<!-- Notes -->
   408→		<!-- AC: @web-dashboard ac-8 -->
   409→		<div data-testid="task-notes">
   410→			<p class="text-xs font-medium text-muted-foreground mb-2">
   411→				Notes ({task.notes?.length ?? 0})
   412→			</p>
   413→
   414→			<!-- Add Note form -->
   415→			{#if !isStaticMode()}
   416→				<div class="mb-3 space-y-2" data-testid="task-add-note">
   417→					<Textarea
   418→						placeholder="Add a note..."
   419→						bind:value={noteContent}
   420→						disabled={isSubmitting}
   421→						rows={2}
   422→					/>
   423→					<Button
   424→						size="sm"
   425→						onclick={handleAddNote}
   426→						disabled={isSubmitting || !noteContent.trim()}
   427→						data-testid="action-add-note"
   428→					>
   429→						{isSubmitting ? 'Adding...' : 'Add Note'}
   430→					</Button>
   431→				</div>
   432→			{/if}
   433→
   434→			<!-- Notes list -->
   435→			<div class="space-y-3">
   436→				{#if (task.notes ?? []).length === 0}
   437→					<div class="text-center py-4 text-muted-foreground text-xs" data-testid="notes-empty">
   438→						{#if isStaticMode()}
   439→							No notes recorded. Use <code class="bg-muted px-1 rounded">kspec task note</code> to add context.
   440→						{:else}
   441→							Add a note above to document decisions, progress, or findings.
   442→						{/if}
   443→					</div>
   444→				{:else}
   445→					{#each task.notes ?? [] as note}
   446→						<div class="border rounded-md p-2.5" data-testid="note-item">
   447→							<div class="flex justify-between items-start mb-1">
   448→								<span class="text-[10px] text-muted-foreground">{note.author}</span>
   449→								<span class="text-[10px] text-muted-foreground" data-testid="note-timestamp">{formatDate(note.created_at)}</span>
   450→							</div>
   451→							<p class="text-sm whitespace-pre-wrap">{note.content}</p>
   452→						</div>
   453→					{/each}
   454→				{/if}
   455→			</div>
   456→		</div>
   457→	</div>
   458→{/if}
   459→
```