    42→/**
    43→ * Find a task by reference with detailed error reporting.
    44→ * Returns the task or exits with appropriate error.
    45→ */
    46→function resolveTaskRef(
    47→  ref: string,
    48→  tasks: LoadedTask[],
    49→  index: ReferenceIndex,
    50→): LoadedTask {
    51→  const result = index.resolve(ref);
    52→
    53→  if (!result.ok) {
    54→    switch (result.error) {
    55→      case "not_found":
    56→        error(errors.reference.taskNotFound(ref));
    57→        break;
    58→      case "ambiguous":
    59→        error(errors.reference.ambiguous(ref));
    60→        for (const candidate of result.candidates) {
    61→          const task = tasks.find((t) => t._ulid === candidate);
    62→          const slug = task?.slugs[0] || "";
    63→          console.error(
    64→            `  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ""}`,
    65→          );
    66→        }
    67→        break;
    68→      case "duplicate_slug":
    69→        error(errors.reference.slugMapsToMultiple(ref));
    70→        for (const candidate of result.candidates) {
    71→          console.error(`  - ${index.shortUlid(candidate)}`);
    72→        }
    73→        break;
    74→    }
    75→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    76→    process.exit(EXIT_CODES.NOT_FOUND);
    77→  }
    78→
    79→  // Check if it's actually a task
    80→  const task = tasks.find((t) => t._ulid === result.ulid);
    81→  if (!task) {
    82→    error(errors.reference.notTask(ref));
    83→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    84→    process.exit(EXIT_CODES.NOT_FOUND);
    85→  }
    86→
    87→  return task;
    88→}
    89→
    90→/**
    91→ * Batch-compatible resolver that returns null instead of calling process.exit().
    92→ * Used by executeBatchOperation to handle errors without terminating the process.
    93→ * AC: @multi-ref-batch ac-4, ac-8 - Partial failure handling and ref resolution
    94→ */
    95→function resolveTaskRefForBatch(
    96→  ref: string,
    97→  tasks: LoadedTask[],
    98→  index: ReferenceIndex,
    99→): { task: LoadedTask | null; error?: string } {
   100→  const result = index.resolve(ref);
   101→
   102→  if (!result.ok) {
   103→    let errorMsg: string;
   104→    switch (result.error) {
   105→      case "not_found":
   106→        errorMsg = `Reference "${ref}" not found`;
   107→        break;
   108→      case "ambiguous":
   109→        errorMsg = `Reference "${ref}" is ambiguous (matches ${result.candidates.length} items)`;
   110→        break;
   111→      case "duplicate_slug":
   112→        errorMsg = `Slug "${ref}" maps to multiple items`;
   113→        break;
   114→    }
   115→    return { task: null, error: errorMsg };
   116→  }
   117→
   118→  // Check if it's actually a task
   119→  const task = tasks.find((t) => t._ulid === result.ulid);
   120→  if (!task) {
   121→    return { task: null, error: `Reference "${ref}" is not a task` };
   122→  }
   123→
   124→  return { task };
   125→}
   126→
   127→/**
   128→ * Helper function to update task fields.
   129→ * Used by both single-ref and batch modes of task set.
   130→ * AC: @spec-task-set-batch ac-1, ac-2, ac-4, ac-5
   131→ */
   132→async function setTaskFields(
   133→  foundTask: LoadedTask,
   134→  ctx: any,
   135→  tasks: LoadedTask[],
   136→  items: LoadedSpecItem[],
   137→  _allMetaItems: any[],
   138→  index: ReferenceIndex,
   139→  options: any,
   140→): Promise<{
   141→  success: boolean;
   142→  message?: string;
   143→  error?: string;
   144→  data?: unknown;
   145→}> {
   146→  try {
   147→    // Check slug uniqueness if adding a new slug
   148→    if (options.slug) {
   149→      const slugCheck = checkSlugUniqueness(
   150→        index,
   151→        [options.slug],
   152→        foundTask._ulid,
   153→      );
   154→      if (!slugCheck.ok) {
   155→        return {
   156→          success: false,
   157→          error: `Slug "${slugCheck.slug}" already exists on ${slugCheck.existingUlid}`,
   158→        };
   159→      }
   160→    }
   161→
   162→    // Build updated task with only provided options
   163→    const updatedTask: Task = { ...foundTask };
   164→    const changes: string[] = [];
   165→
   166→    if (options.title) {
   167→      updatedTask.title = options.title;
   168→      changes.push("title");
   169→    }
   170→
   171→    if (options.specRef) {
   172→      // Validate the spec ref exists and is a spec item
   173→      const specResult = index.resolve(options.specRef);
   174→      if (!specResult.ok) {
   175→        return {
   176→          success: false,
   177→          error: errors.reference.specRefNotFound(options.specRef),
   178→        };
   179→      }
   180→      // Check it's not a task
   181→      const isTask = tasks.some((t) => t._ulid === specResult.ulid);
   182→      if (isTask) {
   183→        return {
   184→          success: false,
   185→          error: errors.reference.specRefIsTask(options.specRef),
   186→        };
   187→      }
   188→      updatedTask.spec_ref = options.specRef;
   189→      changes.push("spec_ref");
   190→    }
   191→
   192→    if (options.metaRef) {
   193→      // Validate the meta ref exists and is a meta item
   194→      const metaRefResult = index.resolve(options.metaRef);
   195→      if (!metaRefResult.ok) {
   196→        return {
   197→          success: false,
   198→          error: errors.reference.metaRefNotFound(options.metaRef),
   199→        };
   200→      }
   201→
   202→      // Check if the resolved item is a meta item (not a spec item or task)
   203→      const isTask = tasks.some((t) => t._ulid === metaRefResult.ulid);
   204→      const isSpecItem = items.some((i) => i._ulid === metaRefResult.ulid);
   205→
   206→      if (isTask || isSpecItem) {
   207→        return {
   208→          success: false,
   209→          error: errors.reference.metaRefPointsToSpec(options.metaRef),
   210→        };
   211→      }
   212→
   213→      updatedTask.meta_ref = options.metaRef;
   214→      changes.push("meta_ref");
   215→    }
   216→
   217→    if (options.priority) {
   218→      const priority = parseInt(options.priority, 10);
   219→      if (Number.isNaN(priority) || priority < 1 || priority > 5) {
   220→        return {
   221→          success: false,
   222→          error: "Priority must be between 1 and 5",
   223→        };
   224→      }
   225→      updatedTask.priority = priority;
   226→      changes.push("priority");
   227→    }
   228→
   229→    if (options.slug) {
   230→      if (!updatedTask.slugs.includes(options.slug)) {
   231→        updatedTask.slugs = [...updatedTask.slugs, options.slug];
   232→        changes.push("slug");
   233→      }
   234→    }
   235→
   236→    if (options.tag) {
   237→      const newTags = options.tag.filter(
   238→        (t: string) => !updatedTask.tags.includes(t),
   239→      );
   240→      if (newTags.length > 0) {
   241→        updatedTask.tags = [...updatedTask.tags, ...newTags];
   242→        changes.push("tags");
   243→      }
   244→    }
   245→
   246→    if (options.dependsOn) {
   247→      // Validate all dependency refs
   248→      for (const depRef of options.dependsOn) {
   249→        const depResult = index.resolve(depRef);
   250→        if (!depResult.ok) {
   251→          return {
   252→            success: false,
   253→            error: errors.reference.depNotFound(depRef),
   254→          };
   255→        }
   256→      }
   257→      updatedTask.depends_on = options.dependsOn;
   258→      changes.push("depends_on");
   259→    }
   260→
   261→    // AC: @spec-task-clear-deps ac-1, ac-2 - Clear all dependencies
   262→    if (options.clearDeps) {
   263→      if (foundTask.depends_on.length === 0) {
   264→        // AC: @spec-task-clear-deps ac-2 - No changes needed
   265→        return {
   266→          success: true,
   267→          message: "No changes: task has no dependencies to clear",
   268→        };
   269→      }
   270→      updatedTask.depends_on = [];
   271→      changes.push("depends_on");
   272→
   273→      // Add note documenting the change
   274→      // AC: @task-set ac-author
   275→      const note = createNote(
   276→        `Dependencies cleared (was: ${foundTask.depends_on.join(", ")})`,
   277→        getAuthor(),
   278→      );
   279→      updatedTask.notes = [...updatedTask.notes, note];
   280→    }
   281→
   282→    // AC: @task-automation-eligibility ac-5, ac-11, ac-12, ac-18
   283→    // Handle automation status changes
   284→    // Note: --no-automation sets options.automation to false, so check that first
   285→    if (options.automation === false) {
   286→      // --no-automation flag clears the automation status (AC: ac-12)
   287→      delete updatedTask.automation;
   288→      changes.push("automation");
   289→    } else if (options.automation !== undefined) {
   290→      const validStatuses = ["eligible", "needs_review", "manual_only"];
   291→      if (!validStatuses.includes(options.automation)) {
   292→        return {
   293→          success: false,
   294→          error: `Invalid automation status: ${options.automation}. Must be one of: ${validStatuses.join(", ")}`,
   295→        };
   296→      }
   297→
   298→      // AC: @task-automation-eligibility ac-18 - require reason for needs_review
   299→      if (options.automation === "needs_review" && !options.reason) {
   300→        return {
   301→          success: false,
   302→          error:
   303→            "Setting automation to needs_review requires --reason flag explaining why",
   304→        };
   305→      }
   306→
   307→      updatedTask.automation = options.automation as
   308→        | "eligible"
   309→        | "needs_review"
   310→        | "manual_only";
   311→      changes.push("automation");
   312→
   313→      // If reason provided, add a note documenting the change
   314→      // AC: @task-set ac-author
   315→      if (options.reason) {
   316→        const note = createNote(
   317→          `Automation status set to ${options.automation}: ${options.reason}`,
   318→          getAuthor(),
   319→        );
   320→        updatedTask.notes = [...updatedTask.notes, note];
   321→        changes.push("note");
   322→      }
   323→    }
   324→
   325→    // AC: @spec-task-set-batch ac-4 - Warn on no changes, don't fail
   326→    if (changes.length === 0) {
   327→      return {
   328→        success: true,
   329→        message: "No changes specified",
   330→        data: { task: updatedTask },
   331→      };
   332→    }
   333→
   334→    await saveTask(ctx, updatedTask);
   335→    await commitIfShadow(
   336→      ctx.shadow,
   337→      "task-set",
   338→      foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
   339→      changes.join(", "),
   340→    );
   341→
   342→    return {
   343→      success: true,
   344→      message: `Updated task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(", ")})`,
   345→      data: { task: updatedTask },
   346→    };
   347→  } catch (err) {
   348→    return {
   349→      success: false,
   350→      error: err instanceof Error ? err.message : String(err),
   351→    };
   352→  }
   353→}
   354→
   355→/**
   356→ * Register the 'task' command group (singular - operations on individual tasks)
   357→ */
   358→export function registerTaskCommands(program: Command): void {
   359→  const task = program
   360→    .command("task")
   361→    .description("Operations on individual tasks");
   362→
   363→  // kspec task list - alias for 'kspec tasks list'
   364→  task
   365→    .command("list")
   366→    .description("List all tasks (alias for 'kspec tasks list')")
   367→    .option("-s, --status <status>", "Filter by status")
   368→    .option("-t, --type <type>", "Filter by type")
   369→    .option("--tag <tag>", "Filter by tag")
   370→    .option("--meta-ref <ref>", "Filter by meta reference")
   371→    .option("-g, --grep <pattern>", "Search content with regex pattern")
   372→    .option("-v, --verbose", "Show more details")
   373→    .option("--full", "Show full details (notes, todos, timestamps)")
   374→    .action(async (options) => {
   375→      try {
   376→        const ctx = await initContext();
   377→        const allTasks = await loadAllTasks(ctx);
   378→        const items = await loadAllItems(ctx);
   379→
   380→        // Load meta items if filtering by meta-ref
   381→        const { loadMetaContext } = await import("../../parser/meta.js");
   382→        const metaContext = await loadMetaContext(ctx);
   383→        const allMetaItems = [
   384→          ...metaContext.agents,
   385→          ...metaContext.workflows,
   386→          ...metaContext.conventions,
   387→          ...metaContext.observations,
   388→        ];
   389→
   390→        const index = new ReferenceIndex(allTasks, items, allMetaItems);
   391→
   392→        let taskList = allTasks;
   393→
   394→        // Apply filters
   395→        if (options.status) {
   396→          taskList = taskList.filter((t) => t.status === options.status);
   397→        }
   398→        if (options.type) {
   399→          taskList = taskList.filter((t) => t.type === options.type);
   400→        }
   401→        if (options.tag) {
   402→          taskList = taskList.filter((t) => t.tags.includes(options.tag));
   403→        }
   404→        if (options.metaRef) {
   405→          const metaRefResult = index.resolve(options.metaRef);
   406→          if (!metaRefResult.ok) {
   407→            error(errors.reference.metaRefNotFound(options.metaRef));
   408→            process.exit(EXIT_CODES.NOT_FOUND);
   409→          }
   410→          const targetRef = options.metaRef.startsWith("@")
   411→            ? options.metaRef
   412→            : `@${options.metaRef}`;
   413→          taskList = taskList.filter(
   414→            (t) => t.meta_ref === targetRef || t.meta_ref === options.metaRef,
   415→          );
   416→        }
   417→        if (options.grep) {
   418→          taskList = taskList.filter((t) => {
   419→            const match = grepItem(
   420→              t as unknown as Record<string, unknown>,
   421→              options.grep,
   422→            );
   423→            return match !== null;
   424→          });
   425→        }
   426→
   427→        output(taskList, () =>
   428→          formatTaskList(
   429→            taskList,
   430→            options.verbose,
   431→            index,
   432→            options.grep,
   433→            options.full,
   434→          ),
   435→        );
   436→      } catch (err) {
   437→        error(errors.failures.listTasks, err);
   438→        process.exit(EXIT_CODES.ERROR);
   439→      }
   440→    });
   441→
   442→  // kspec task get <ref>
   443→  task
   444→    .command("get <ref>")
   445→    .description("Get task details")
   446→    .action(async (ref: string) => {
   447→      try {
   448→        const ctx = await initContext();
   449→        const tasks = await loadAllTasks(ctx);
   450→        const _items = await loadAllItems(ctx);
   451→
   452→        // Build all indexes including TraitIndex
   453→        const { refIndex: index, traitIndex } = await (async () => {
   454→          const { buildIndexes } = await import("../../parser/index.js");
   455→          return buildIndexes(ctx);
   456→        })();
   457→
   458→        const foundTask = resolveTaskRef(ref, tasks, index);
   459→
   460→        // AC: @trait-display ac-3 - task get shows inherited AC sections
   461→        // Get inherited traits if task has spec_ref
   462→        let inheritedTraits: Array<{
   463→          trait: {
   464→            ulid: string;
   465→            slug: string;
   466→            title: string;
   467→            description?: string;
   468→          };
   469→          acs: Array<{
   470→            id: string;
   471→            given?: string;
   472→            when?: string;
   473→            then?: string;
   474→          }>;
   475→        }> = [];
   476→        if (foundTask.spec_ref) {
   477→          const specResult = index.resolve(foundTask.spec_ref);
   478→          if (specResult.ok) {
   479→            const specUlid = specResult.ulid;
   480→            const inheritedAC = traitIndex.getInheritedAC(specUlid);
   481→            const traitsByTrait = new Map<
   482→              string,
   483→              {
   484→                trait: (typeof inheritedAC)[0]["trait"];
   485→                acs: Array<{
   486→                  id: string;
   487→                  given?: string;
   488→                  when?: string;
   489→                  then?: string;
   490→                }>;
   491→              }
   492→            >();
   493→            for (const { trait, ac } of inheritedAC) {
   494→              if (!traitsByTrait.has(trait.ulid)) {
   495→                traitsByTrait.set(trait.ulid, { trait, acs: [] });
   496→              }
   497→              traitsByTrait.get(trait.ulid)?.acs.push(ac);
   498→            }
   499→            inheritedTraits = Array.from(traitsByTrait.values());
   500→          }
   501→        }
   502→
   503→        // Build JSON output with inherited traits (AC: @trait-display ac-2)
   504→        const jsonOutput = {
   505→          ...foundTask,
   506→          ...(inheritedTraits.length > 0 && {
   507→            inherited_traits: inheritedTraits.map(({ trait, acs }) => ({
   508→              ref: `@${trait.slug}`,
   509→              title: trait.title,
   510→              acceptance_criteria: acs,
   511→            })),
   512→          }),
   513→        };
   514→
   515→        output(jsonOutput, () => {
   516→          formatTaskDetails(foundTask, index);
   517→
   518→          // AC: @trait-display ac-3, ac-4, ac-5 - Show inherited AC per trait in labeled sections
   519→          if (inheritedTraits.length > 0) {
   520→            for (const { trait, acs } of inheritedTraits) {
   521→              console.log(
   522→                chalk.gray(`\n─── Inherited from @${trait.slug} ───`),
   523→              );
   524→              for (const ac of acs) {
   525→                console.log(
   526→                  chalk.cyan(`  [${ac.id}]`) +
   527→                    chalk.gray(` (from @${trait.slug})`),
   528→                );
   529→                if (ac.given) console.log(`    Given: ${ac.given}`);
   530→                if (ac.when) console.log(`    When: ${ac.when}`);
   531→                if (ac.then) console.log(`    Then: ${ac.then}`);
   532→              }
   533→            }
   534→          }
   535→        });
   536→      } catch (err) {
   537→        error(errors.failures.getTask, err);
   538→        process.exit(EXIT_CODES.ERROR);
   539→      }
   540→    });
   541→
   542→  // kspec task add
   543→  task
   544→    .command("add")
   545→    .description("Create a new task")
   546→    .requiredOption("--title <title>", "Task title")
   547→    .option("--description <description>", "Task description")
   548→    .option(
   549→      "--type <type>",
   550→      "Task type (task, epic, bug, spike, infra)",
   551→      "task",
   552→    )
   553→    .option("--spec-ref <ref>", "Reference to spec item")
   554→    .option(
   555→      "--meta-ref <ref>",
   556→      "Reference to meta item (workflow, agent, or convention)",
   557→    )
   558→    .option("--priority <n>", "Priority (1-5)", "3")
   559→    .option("--slug <slug>", "Human-friendly slug")
   560→    .option("--tag <tag...>", "Tags")
   561→    .option(
   562→      "--automation <status>",
   563→      "Automation eligibility (eligible, needs_review, manual_only)",
   564→    )
   565→    .addHelpText(
   566→      "after",
   567→      `
   568→Examples:
   569→  $ kspec task add --title "Implement feature" --spec-ref @feature-spec
   570→  $ kspec task add --title "Fix bug" --type bug --priority 1
   571→  $ kspec task add --title "Multi-tag task" --tag cli urgent`,
   572→    )
   573→    .action(async (options) => {
   574→      try {
   575→        const ctx = await initContext();
   576→        const tasks = await loadAllTasks(ctx);
   577→        const items = await loadAllItems(ctx);
   578→
   579→        // Load meta items for validation
   580→        const { loadMetaContext } = await import("../../parser/meta.js");
   581→        const metaContext = await loadMetaContext(ctx);
   582→        const allMetaItems = [
   583→          ...metaContext.agents,
   584→          ...metaContext.workflows,
   585→          ...metaContext.conventions,
   586→          ...metaContext.observations,
   587→        ];
   588→
   589→        // Build index for reference validation
   590→        const refIndex = new ReferenceIndex(tasks, items, allMetaItems);
   591→
   592→        // Check slug uniqueness if provided
   593→        if (options.slug) {
   594→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   595→          if (!slugCheck.ok) {
   596→            error(
   597→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
   598→            );
   599→            process.exit(EXIT_CODES.CONFLICT);
   600→          }
   601→        }
   602→
   603→        // Validate meta_ref if provided (AC-meta-ref-3, AC-meta-ref-4)
   604→        if (options.metaRef) {
   605→          const metaRefResult = refIndex.resolve(options.metaRef);
   606→
   607→          if (!metaRefResult.ok) {
   608→            error(errors.reference.metaRefNotFound(options.metaRef));
   609→            process.exit(EXIT_CODES.NOT_FOUND);
   610→          }
   611→
   612→          // Check if the resolved item is a meta item (not a spec item or task)
   613→          const isTask = tasks.some((t) => t._ulid === metaRefResult.ulid);
   614→          const isSpecItem = items.some((i) => i._ulid === metaRefResult.ulid);
   615→
   616→          if (isTask || isSpecItem) {
   617→            error(errors.reference.metaRefPointsToSpec(options.metaRef));
   618→            process.exit(EXIT_CODES.NOT_FOUND);
   619→          }
   620→        }
   621→
   622→        // AC: @task-automation-eligibility ac-13 - validate automation if provided
   623→        let automationValue:
   624→          | "eligible"
   625→          | "needs_review"
   626→          | "manual_only"
   627→          | undefined;
   628→        if (options.automation) {
   629→          const validStatuses = ["eligible", "needs_review", "manual_only"];
   630→          if (!validStatuses.includes(options.automation)) {
   631→            error(
   632→              `Invalid automation status: ${options.automation}. Must be one of: ${validStatuses.join(", ")}`,
   633→            );
   634→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   635→          }
   636→          automationValue = options.automation as
   637→            | "eligible"
   638→            | "needs_review"
   639→            | "manual_only";
   640→        }
   641→
   642→        // AC: @spec-task-add-description ac-6 - Omit description if empty string
   643→        const descriptionValue =
   644→          options.description && options.description.trim() !== ""
   645→            ? options.description
   646→            : undefined;
   647→
   648→        const input: TaskInput = {
   649→          title: options.title,
   650→          description: descriptionValue,
   651→          type: options.type,
   652→          spec_ref: options.specRef || null,
   653→          meta_ref: options.metaRef || null,
   654→          priority: parseInt(options.priority, 10),
   655→          slugs: options.slug ? [options.slug] : [],
   656→          tags: options.tag || [],
   657→          automation: automationValue,
   658→        };
   659→
   660→        const newTask = createTask(input);
   661→        await saveTask(ctx, newTask);
   662→        await commitIfShadow(
   663→          ctx.shadow,
   664→          "task-add",
   665→          newTask.slugs[0] || newTask._ulid.slice(0, 8),
   666→          newTask.title,
   667→        );
   668→
   669→        // Build index including the new task for accurate short ULID
   670→        const index = new ReferenceIndex(
   671→          [...tasks, newTask],
   672→          items,
   673→          allMetaItems,
   674→        );
   675→        success(`Created task: ${index.shortUlid(newTask._ulid)}`, {
   676→          task: newTask,
   677→        });
   678→      } catch (err) {
   679→        error(errors.failures.createTask, err);
   680→        process.exit(EXIT_CODES.ERROR);
   681→      }
   682→    });
   683→
   684→  // kspec task set <ref>
   685→  task
   686→    .command("set [ref]")
   687→    .description("Update task fields")
   688→    .option(
   689→      "--refs <refs...>",
   690→      "Update multiple tasks (AC: @spec-task-set-batch ac-1)",
   691→    )
   692→    .option("--title <title>", "Update task title")
   693→    .option("--spec-ref <ref>", "Link to spec item")
   694→    .option(
   695→      "--meta-ref <ref>",
   696→      "Link to meta item (workflow, agent, or convention)",
   697→    )
   698→    .option("--priority <n>", "Set priority (1-5)")
   699→    .option("--slug <slug>", "Add a slug alias")
   700→    .option("--tag <tag...>", "Add tags")
   701→    .option("--depends-on <refs...>", "Set dependencies (replaces existing)")
   702→    .option("--clear-deps", "Clear all dependencies")
   703→    .option(
   704→      "--automation <status>",
   705→      "Set automation eligibility (eligible, needs_review, manual_only)",
   706→    )
   707→    .option("--no-automation", "Clear automation status (return to unassessed)")
   708→    .option(
   709→      "--reason <reason>",
   710→      "Reason for status change (required when setting needs_review)",
   711→    )
   712→    .option(
   713→      "--status <status>",
   714→      "Reject with error - use state transition commands instead",
   715→    )
   716→    .addHelpText(
   717→      "after",
   718→      `
   719→Examples:
   720→  $ kspec task set @task-slug --priority 2
   721→  $ kspec task set @task-slug --depends-on @dep1 @dep2
   722→  $ kspec task set @task-slug --tag cli urgent
   723→  $ kspec task set --refs @task1 @task2 --priority 3`,
   724→    )
   725→    .action(async (ref: string | undefined, options) => {
   726→      try {
   727→        // AC: @spec-task-set-batch ac-3 - Reject --status flag
   728→        if (options.status !== undefined) {
   729→          error(
   730→            "Use state transition commands (start, complete, block, etc.) to change status",
   731→          );
   732→          process.exit(EXIT_CODES.USAGE_ERROR);
   733→        }
   734→
   735→        // AC: @spec-task-clear-deps ac-3 - Mutual exclusivity check
   736→        if (options.clearDeps && options.dependsOn) {
   737→          error("Cannot use --clear-deps and --depends-on together");
   738→          process.exit(EXIT_CODES.USAGE_ERROR);
   739→        }
   740→
   741→        const ctx = await initContext();
   742→        const tasks = await loadAllTasks(ctx);
   743→        const items = await loadAllItems(ctx);
   744→
   745→        // Load meta items for validation
   746→        const { loadMetaContext } = await import("../../parser/meta.js");
   747→        const metaContext = await loadMetaContext(ctx);
   748→        const allMetaItems = [
   749→          ...metaContext.agents,
   750→          ...metaContext.workflows,
   751→          ...metaContext.conventions,
   752→          ...metaContext.observations,
   753→        ];
   754→
   755→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   756→
   757→        // AC: @trait-multi-ref-batch ac-8 - Deduplicate refs
   758→        const refsFlag = options.refs
   759→          ? [...new Set(options.refs as string[])]
   760→          : undefined;
   761→
   762→        // Batch mode or single mode?
   763→        if (refsFlag && refsFlag.length > 0) {
   764→          // Batch mode - AC: @spec-task-set-batch ac-1, ac-2, ac-5
   765→          const result = await executeBatchOperation({
   766→            positionalRef: ref,
   767→            refsFlag,
   768→            context: { ctx, tasks, items, allMetaItems, index, options },
   769→            items: tasks,
   770→            index,
   771→            resolveRef: (
   772→              refStr: string,
   773→              taskList: LoadedTask[],
   774→              idx: ReferenceIndex,
   775→            ) => {
   776→              const result = resolveTaskRefForBatch(refStr, taskList, idx);
   777→              return { item: result.task, error: result.error };
   778→            },
   779→            executeOperation: async (task: LoadedTask, context) => {
   780→              return await setTaskFields(
   781→                task,
   782→                context.ctx,
   783→                context.tasks,
   784→                context.items,
   785→                context.allMetaItems,
   786→                context.index,
   787→                context.options,
   788→              );
   789→            },
   790→            getUlid: (task: LoadedTask) => task._ulid,
   791→          });
   792→
   793→          formatBatchOutput(result, "Set");
   794→        } else {
   795→          // Single mode - existing behavior
   796→          if (!ref) {
   797→            error("Either provide a positional ref or use --refs flag");
   798→            process.exit(EXIT_CODES.USAGE_ERROR);
   799→          }
   800→
   801→          const foundTask = resolveTaskRef(ref, tasks, index);
   802→          const result = await setTaskFields(
   803→            foundTask,
   804→            ctx,
   805→            tasks,
   806→            items,
   807→            allMetaItems,
   808→            index,
   809→            options,
   810→          );
   811→
   812→          if (!result.success) {
   813→            error(result.error || "Failed to update task");
   814→            process.exit(EXIT_CODES.ERROR);
   815→          }
   816→
   817→          if (result.message) {
   818→            // AC: @spec-task-set-batch ac-4 - Warn on no changes
   819→            if (result.message.includes("No changes")) {
   820→              if (isJsonMode()) {
   821→                output({ success: true, message: result.message });
   822→              } else {
   823→                warn(result.message);
   824→              }
   825→            } else {
   826→              success(
   827→                result.message,
   828→                result.data as Record<string, unknown> | undefined,
   829→              );
   830→            }
   831→          }
   832→        }
   833→      } catch (err) {
   834→        error(errors.failures.updateTask, err);
   835→        process.exit(EXIT_CODES.ERROR);
   836→      }
   837→    });
   838→
   839→  // kspec task patch <ref>
   840→  task
   841→    .command("patch <ref>")
   842→    .description("Update task with JSON data")
   843→    .option("--data <json>", "JSON object with fields to update")
   844→    .option("--dry-run", "Show what would change without writing")
   845→    .option("--allow-unknown", "Allow unknown fields (for extending format)")
   846→    .action(async (ref: string, options) => {
   847→      try {
   848→        const ctx = await initContext();
   849→        const tasks = await loadAllTasks(ctx);
   850→        const items = await loadAllItems(ctx);
   851→
   852→        // Load meta items for validation
   853→        const { loadMetaContext } = await import("../../parser/meta.js");
   854→        const metaContext = await loadMetaContext(ctx);
   855→        const allMetaItems = [
   856→          ...metaContext.agents,
   857→          ...metaContext.workflows,
   858→          ...metaContext.conventions,
   859→          ...metaContext.observations,
   860→        ];
   861→
   862→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   863→        const foundTask = resolveTaskRef(ref, tasks, index);
   864→
   865→        // Get JSON data from --data flag or stdin
   866→        let jsonData: string;
   867→        if (options.data) {
   868→          jsonData = options.data;
   869→        } else {
   870→          // Read from stdin
   871→          const chunks: Buffer[] = [];
   872→          for await (const chunk of process.stdin) {
   873→            chunks.push(chunk);
   874→          }
   875→          jsonData = Buffer.concat(chunks).toString("utf-8");
   876→        }
   877→
   878→        // Parse JSON
   879→        let patchData: Record<string, unknown>;
   880→        try {
   881→          patchData = JSON.parse(jsonData);
   882→        } catch (parseErr) {
   883→          error(errors.validation.invalidJson, parseErr);
   884→          process.exit(EXIT_CODES.ERROR);
   885→        }
   886→
   887→        // Validate against TaskInputSchema (partial)
   888→        const { TaskInputSchema } = await import("../../schema/index.js");
   889→
   890→        // Create a partial schema for validation
   891→        const partialSchema = options.allowUnknown
   892→          ? TaskInputSchema.partial().passthrough()
   893→          : TaskInputSchema.partial().strict();
   894→
   895→        let validatedPatch: Partial<TaskInput>;
   896→        try {
   897→          validatedPatch = partialSchema.parse(patchData);
   898→        } catch (validationErr) {
   899→          error(
   900→            errors.validation.invalidPatchData(String(validationErr)),
   901→            validationErr,
   902→          );
   903→          process.exit(EXIT_CODES.ERROR);
   904→        }
   905→
   906→        // Check for unknown fields if strict mode
   907→        if (!options.allowUnknown) {
   908→          const knownFields = Object.keys(TaskInputSchema.shape);
   909→          const providedFields = Object.keys(patchData);
   910→          const unknownFields = providedFields.filter(
   911→            (f) => !knownFields.includes(f),
   912→          );
   913→
   914→          if (unknownFields.length > 0) {
   915→            error(errors.validation.unknownFields(unknownFields));
   916→            process.exit(EXIT_CODES.ERROR);
   917→          }
   918→        }
   919→
   920→        // Build updated task
   921→        const updatedTask: Task = { ...foundTask, ...validatedPatch };
   922→
   923→        // Track changes for output
   924→        const changes = Object.keys(validatedPatch);
   925→
   926→        if (options.dryRun) {
   927→          info("Dry run - no changes will be written");
   928→          info(`Would update: ${changes.join(", ")}`);
   929→          output({ changes, updated: updatedTask }, () => {
   930→            console.log(`\nChanges: ${changes.join(", ")}\n`);
   931→            return formatTaskDetails(updatedTask, index);
   932→          });
   933→          return;
   934→        }
   935→
   936→        await saveTask(ctx, updatedTask);
   937→        await commitIfShadow(
   938→          ctx.shadow,
   939→          "task-patch",
   940→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
   941→          changes.join(", "),
   942→        );
   943→        success(
   944→          `Patched task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(", ")})`,
   945→          { task: updatedTask },
   946→        );
   947→      } catch (err) {
   948→        error(errors.failures.patchTask, err);
   949→        process.exit(EXIT_CODES.ERROR);
   950→      }
   951→    });
   952→
   953→  // kspec task start <ref>
   954→  task
   955→    .command("start <ref>")
   956→    .description("Start working on a task (pending -> in_progress)")
   957→    .option("--no-sync", "Skip syncing spec implementation status")
   958→    .action(async (ref: string, options) => {
   959→      try {
   960→        const ctx = await initContext();
   961→        const tasks = await loadAllTasks(ctx);
   962→        const items = await loadAllItems(ctx);
   963→        const index = new ReferenceIndex(tasks, items);
   964→        const foundTask = resolveTaskRef(ref, tasks, index);
   965→
   966→        if (foundTask.status === "in_progress") {
   967→          warn("Task is already in progress");
   968→          output(foundTask, () => formatTaskDetails(foundTask));
   969→          return;
   970→        }
   971→
   972→        if (foundTask.status !== "pending") {
   973→          error(errors.status.cannotStart(foundTask.status));
   974→          process.exit(EXIT_CODES.VALIDATION_FAILED); // Exit code 4 = invalid state
   975→        }
   976→
   977→        // Update status
   978→        const updatedTask: Task = {
   979→          ...foundTask,
   980→          status: "in_progress",
   981→          started_at: new Date().toISOString(),
   982→        };
   983→
   984→        await saveTask(ctx, updatedTask);
   985→        await commitIfShadow(
   986→          ctx.shadow,
   987→          "task-start",
   988→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
   989→        );
   990→        success(`Started task: ${index.shortUlid(updatedTask._ulid)}`, {
   991→          task: updatedTask,
   992→        });
   993→
   994→        // Show spec context and AC guidance (suppressed in JSON mode)
   995→        if (!isJsonMode() && foundTask.spec_ref) {
   996→          const specResult = index.resolve(foundTask.spec_ref);
   997→          if (specResult.ok) {
   998→            const specItem = items.find((i) => i._ulid === specResult.ulid);
   999→            if (specItem) {
  1000→              console.log("");
  1001→              console.log("--- Spec Context ---");
  1002→              console.log(`Implementing: ${specItem.title}`);
  1003→              if (specItem.description) {
  1004→                console.log(`\n${specItem.description}`);
  1005→              }
  1006→
  1007→              if (
  1008→                specItem.acceptance_criteria &&
  1009→                specItem.acceptance_criteria.length > 0
  1010→              ) {
  1011→                console.log(
  1012→                  `\nAcceptance Criteria (${specItem.acceptance_criteria.length}):`,
  1013→                );
  1014→                for (const ac of specItem.acceptance_criteria) {
  1015→                  console.log(`  [${ac.id}]`);
  1016→                  console.log(`    Given: ${ac.given}`);
  1017→                  console.log(`    When: ${ac.when}`);
  1018→                  console.log(`    Then: ${ac.then}`);
  1019→                }
  1020→                console.log("");
  1021→                console.log(
  1022→                  "Remember: Add test coverage for each AC and mark tests with // AC: @spec-ref ac-N",
  1023→                );
  1024→              }
  1025→              console.log("");
  1026→            }
  1027→          }
  1028→        }
  1029→
  1030→        // Sync spec implementation status (unless --no-sync)
  1031→        if (options.sync !== false && foundTask.spec_ref) {
  1032→          const updatedTasks = tasks.map((t) =>
  1033→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t,
  1034→          );
  1035→          const syncResult = await syncSpecImplementationStatus(
  1036→            ctx,
  1037→            updatedTask as LoadedTask,
  1038→            updatedTasks as LoadedTask[],
  1039→            items,
  1040→            index,
  1041→          );
  1042→          if (syncResult) {
  1043→            info(
  1044→              `Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1045→            );
  1046→            // Commit the spec status change
  1047→            await commitIfShadow(
  1048→              ctx.shadow,
  1049→              "spec-sync",
  1050→              syncResult.specUlid.slice(0, 8),
  1051→              `${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1052→            );
  1053→          }
  1054→        }
  1055→      } catch (err) {
  1056→        error(errors.failures.startTask, err);
  1057→        process.exit(EXIT_CODES.ERROR);
  1058→      }
  1059→    });
  1060→
  1061→  // kspec task complete <ref> | --refs <refs...>
  1062→  // AC: @multi-ref-batch ac-1 - Basic multi-ref syntax
  1063→  // AC: @multi-ref-batch ac-2 - Backward compatibility
  1064→  task
  1065→    .command("complete [ref]")
  1066→    .description("Complete a task (pending_review -> completed)")
  1067→    .option("--refs <refs...>", "Complete multiple tasks by ref")
  1068→    .option("--reason <reason>", "Completion reason/notes")
  1069→    .option("--skip-review", "Skip review requirement (requires --reason)")
  1070→    .option(
  1071→      "--force",
  1072→      "Force completion even if blocked (AC: @task-commands ac-1)",
  1073→    )
  1074→    .option("--no-sync", "Skip syncing spec implementation status")
  1075→    .addHelpText(
  1076→      "after",
  1077→      `
  1078→Examples:
  1079→  $ kspec task complete @task-slug --reason "Merged in PR #123"
  1080→  $ kspec task complete --refs @task1 @task2 --reason "Batch completion"`,
  1081→    )
  1082→    .action(async (ref: string | undefined, options) => {
  1083→      try {
  1084→        const ctx = await initContext();
  1085→        const tasks = await loadAllTasks(ctx);
  1086→        const items = await loadAllItems(ctx);
  1087→        const index = new ReferenceIndex(tasks, items);
  1088→
  1089→        // AC: @spec-completion-enforcement ac-8
  1090→        if (options.skipReview && !options.reason) {
  1091→          error(errors.status.skipReviewRequiresReason);
  1092→          process.exit(EXIT_CODES.ERROR);
  1093→        }
  1094→
  1095→        // AC: @multi-ref-batch ac-1, ac-2, ac-3, ac-4
  1096→        const result = await executeBatchOperation({
  1097→          positionalRef: ref,
  1098→          refsFlag: options.refs,
  1099→          context: { ctx, tasks, items, index, options },
  1100→          items: tasks,
  1101→          index,
  1102→          resolveRef: (refStr, taskList, idx) => {
  1103→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1104→            return { item: resolved.task, error: resolved.error };
  1105→          },
  1106→          executeOperation: async (
  1107→            foundTask,
  1108→            { ctx, tasks, items, index, options },
  1109→          ) => {
  1110→            try {
  1111→              // AC: @spec-completion-enforcement ac-6
  1112→              if (foundTask.status === "completed") {
  1113→                return {
  1114→                  success: false,
  1115→                  error: errors.status.completeAlreadyCompleted,
  1116→                };
  1117→              }
  1118→
  1119→              // AC: @task-commands ac-1 - Allow --force to bypass blocked state
  1120→              // Handle blocked task with --force before other checks
  1121→              const forcingBlockedTask =
  1122→                foundTask.status === "blocked" && options.force;
  1123→
  1124→              // AC: @spec-completion-enforcement ac-7 - Allow skip-review bypass
  1125→              if (!options.skipReview && !forcingBlockedTask) {
  1126→                // AC: @spec-completion-enforcement ac-2
  1127→                if (foundTask.status === "in_progress") {
  1128→                  return {
  1129→                    success: false,
  1130→                    error: errors.status.completeRequiresReview,
  1131→                  };
  1132→                }
  1133→
  1134→                // AC: @spec-completion-enforcement ac-3
  1135→                if (foundTask.status === "pending") {
  1136→                  return {
  1137→                    success: false,
  1138→                    error: errors.status.completeRequiresStart,
  1139→                  };
  1140→                }
  1141→
  1142→                // AC: @spec-completion-enforcement ac-4
  1143→                if (foundTask.status === "blocked") {
  1144→                  return {
  1145→                    success: false,
  1146→                    error: errors.status.completeBlockedTask,
  1147→                  };
  1148→                }
  1149→
  1150→                // AC: @spec-completion-enforcement ac-5
  1151→                if (foundTask.status === "cancelled") {
  1152→                  return {
  1153→                    success: false,
  1154→                    error: errors.status.completeCancelledTask,
  1155→                  };
  1156→                }
  1157→
  1158→                // AC: @spec-completion-enforcement ac-1 - Only pending_review allowed
  1159→                if (foundTask.status !== "pending_review") {
  1160→                  return {
  1161→                    success: false,
  1162→                    error: errors.status.cannotComplete(foundTask.status),
  1163→                  };
  1164→                }
  1165→              }
  1166→
  1167→              const now = new Date().toISOString();
  1168→
  1169→              // AC: @spec-completion-enforcement ac-7 - Document skip-review reason
  1170→              // AC: @spec-completion-enforcement ac-author
  1171→              let taskNotes = foundTask.notes;
  1172→              if (options.skipReview && options.reason) {
  1173→                const skipNote = createNote(
  1174→                  `Completed with --skip-review: ${options.reason}`,
  1175→                  getAuthor(),
  1176→                );
  1177→                taskNotes = [...taskNotes, skipNote];
  1178→              }
  1179→
  1180→              // AC: @task-commands ac-1 - Document force completion of blocked task
  1181→              if (forcingBlockedTask) {
  1182→                const blockedBy = foundTask.blocked_by.join("; ");
  1183→                const forceNote = createNote(
  1184→                  `Completed with --force despite blocked state. Was blocked by: ${blockedBy || "(dependency-blocked)"}${options.reason ? `. Reason: ${options.reason}` : ""}`,
  1185→                  getAuthor(),
  1186→                );
  1187→                taskNotes = [...taskNotes, forceNote];
  1188→              }
  1189→
  1190→              // Update status
  1191→              const updatedTask: Task = {
  1192→                ...foundTask,
  1193→                status: "completed",
  1194→                completed_at: now,
  1195→                closed_reason: options.reason || null,
  1196→                started_at: foundTask.started_at || now,
  1197→                notes: taskNotes,
  1198→              };
  1199→
  1200→              await saveTask(ctx, updatedTask);
  1201→              await commitIfShadow(
  1202→                ctx.shadow,
  1203→                "task-complete",
  1204→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1205→                options.reason,
  1206→              );
  1207→
  1208→              // Sync spec implementation status (unless --no-sync)
  1209→              if (options.sync !== false && foundTask.spec_ref) {
  1210→                const updatedTasks = tasks.map((t) =>
  1211→                  t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t,
  1212→                );
  1213→                const syncResult = await syncSpecImplementationStatus(
  1214→                  ctx,
  1215→                  updatedTask as LoadedTask,
  1216→                  updatedTasks as LoadedTask[],
  1217→                  items,
  1218→                  index,
  1219→                );
  1220→                if (syncResult && !isJsonMode()) {
  1221→                  info(
  1222→                    `Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1223→                  );
  1224→                  await commitIfShadow(
  1225→                    ctx.shadow,
  1226→                    "spec-sync",
  1227→                    syncResult.specUlid.slice(0, 8),
  1228→                    `${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1229→                  );
  1230→                }
  1231→              }
  1232→
  1233→              // Show AC reminder for single-ref mode only (not in batch)
  1234→              if (!options.refs && foundTask.spec_ref && !isJsonMode()) {
  1235→                const specResult = index.resolve(foundTask.spec_ref);
  1236→                if (specResult.ok && specResult.item) {
  1237→                  const specItem = items.find(
  1238→                    (i) => i._ulid === specResult.ulid,
  1239→                  );
  1240→                  if (
  1241→                    specItem?.acceptance_criteria &&
  1242→                    specItem.acceptance_criteria.length > 0
  1243→                  ) {
  1244→                    const count = specItem.acceptance_criteria.length;
  1245→                    console.log(
  1246→                      `\n⚠ Linked spec ${foundTask.spec_ref} has ${count} acceptance criteri${count === 1 ? "on" : "a"} - verify they are covered\n`,
  1247→                    );
  1248→                  }
  1249→                }
  1250→              }
  1251→
  1252→              // AC: @task-commands ac-1 - Show warning when force-completing blocked task
  1253→              let warningMsg: string | undefined;
  1254→              if (forcingBlockedTask) {
  1255→                const blockedBy = foundTask.blocked_by.join("; ");
  1256→                warningMsg = `Task was blocked by: ${blockedBy || "(dependency-blocked)"}`;
  1257→                if (!isJsonMode()) {
  1258→                  warn(warningMsg);
  1259→                }
  1260→              }
  1261→
  1262→              return {
  1263→                success: true,
  1264→                message: `Completed task: ${index.shortUlid(updatedTask._ulid)}`,
  1265→                data: updatedTask,
  1266→                ...(forcingBlockedTask && { warning: warningMsg }),
  1267→              };
  1268→            } catch (err) {
  1269→              return {
  1270→                success: false,
  1271→                error: err instanceof Error ? err.message : String(err),
  1272→              };
  1273→            }
  1274→          },
  1275→          getUlid: (task) => task._ulid,
  1276→        });
  1277→
  1278→        // AC: @multi-ref-batch ac-5, ac-6
  1279→        formatBatchOutput(result, "Complete");
  1280→
  1281→        // Show commit guidance for single-ref mode only
  1282→        if (
  1283→          !options.refs &&
  1284→          result.success &&
  1285→          result.results.length === 1 &&
  1286→          !isJsonMode()
  1287→        ) {
  1288→          const taskData = result.results[0].data as Task | undefined;
  1289→          if (taskData) {
  1290→            const guidance = formatCommitGuidance(taskData);
  1291→            printCommitGuidance(guidance);
  1292→          }
  1293→        }
  1294→      } catch (err) {
  1295→        error(errors.failures.completeTask, err);
  1296→        process.exit(EXIT_CODES.ERROR);
  1297→      }
  1298→    });
  1299→
  1300→  // kspec task submit <ref>
  1301→  // Transitions in_progress → pending_review (code done, awaiting merge)
  1302→  task
  1303→    .command("submit <ref>")
  1304→    .description("Submit task for review (transitions to pending_review)")
  1305→    .action(async (ref: string) => {
  1306→      try {
  1307→        const ctx = await initContext();
  1308→        const tasks = await loadAllTasks(ctx);
  1309→        const items = await loadAllItems(ctx);
  1310→        const index = new ReferenceIndex(tasks, items);
  1311→        const foundTask = resolveTaskRef(ref, tasks, index);
  1312→
  1313→        if (foundTask.status !== "in_progress") {
  1314→          error(
  1315→            `Cannot submit task with status: ${foundTask.status}. Task must be in_progress.`,
  1316→          );
  1317→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1318→        }
  1319→
  1320→        const updatedTask: Task = {
  1321→          ...foundTask,
  1322→          status: "pending_review",
  1323→        };
  1324→
  1325→        await saveTask(ctx, updatedTask);
  1326→        await commitIfShadow(
  1327→          ctx.shadow,
  1328→          "task-submit",
  1329→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1330→        );
  1331→        success(
  1332→          `Submitted task for review: ${index.shortUlid(updatedTask._ulid)}`,
  1333→          { task: updatedTask },
  1334→        );
  1335→      } catch (err) {
  1336→        error(errors.failures.updateTask, err);
  1337→        process.exit(EXIT_CODES.ERROR);
  1338→      }
  1339→    });
  1340→
  1341→  // kspec task block <ref>
  1342→  task
  1343→    .command("block <ref>")
  1344→    .description("Block a task")
  1345→    .requiredOption("--reason <reason>", "Reason for blocking")
  1346→    .action(async (ref: string, options) => {
  1347→      try {
  1348→        const ctx = await initContext();
  1349→        const tasks = await loadAllTasks(ctx);
  1350→        const items = await loadAllItems(ctx);
  1351→        const index = new ReferenceIndex(tasks, items);
  1352→        const foundTask = resolveTaskRef(ref, tasks, index);
  1353→
  1354→        if (
  1355→          foundTask.status === "completed" ||
  1356→          foundTask.status === "cancelled"
  1357→        ) {
  1358→          error(errors.status.cannotBlock(foundTask.status));
  1359→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1360→        }
  1361→
  1362→        const updatedTask: Task = {
  1363→          ...foundTask,
  1364→          status: "blocked",
  1365→          blocked_by: [...foundTask.blocked_by, options.reason],
  1366→        };
  1367→
  1368→        await saveTask(ctx, updatedTask);
  1369→        await commitIfShadow(
  1370→          ctx.shadow,
  1371→          "task-block",
  1372→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1373→        );
  1374→        success(`Blocked task: ${index.shortUlid(updatedTask._ulid)}`, {
  1375→          task: updatedTask,
  1376→        });
  1377→      } catch (err) {
  1378→        error(errors.failures.blockTask, err);
  1379→        process.exit(EXIT_CODES.ERROR);
  1380→      }
  1381→    });
  1382→
  1383→  // kspec task unblock <ref>
  1384→  task
  1385→    .command("unblock <ref>")
  1386→    .description("Unblock a task")
  1387→    .action(async (ref: string) => {
  1388→      try {
  1389→        const ctx = await initContext();
  1390→        const tasks = await loadAllTasks(ctx);
  1391→        const items = await loadAllItems(ctx);
  1392→        const index = new ReferenceIndex(tasks, items);
  1393→        const foundTask = resolveTaskRef(ref, tasks, index);
  1394→
  1395→        if (foundTask.status !== "blocked") {
  1396→          warn("Task is not blocked");
  1397→          return;
  1398→        }
  1399→
  1400→        const updatedTask: Task = {
  1401→          ...foundTask,
  1402→          status: "pending",
  1403→          blocked_by: [],
  1404→        };
  1405→
  1406→        await saveTask(ctx, updatedTask);
  1407→        await commitIfShadow(
  1408→          ctx.shadow,
  1409→          "task-unblock",
  1410→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1411→        );
  1412→        success(`Unblocked task: ${index.shortUlid(updatedTask._ulid)}`, {
  1413→          task: updatedTask,
  1414→        });
  1415→      } catch (err) {
  1416→        error(errors.failures.unblockTask, err);
  1417→        process.exit(EXIT_CODES.ERROR);
  1418→      }
  1419→    });
  1420→
  1421→  // kspec task cancel <ref> | --refs <refs...>
  1422→  // AC: @multi-ref-batch ac-1, ac-2
  1423→  task
  1424→    .command("cancel [ref]")
  1425→    .description("Cancel a task")
  1426→    .option("--refs <refs...>", "Cancel multiple tasks by ref")
  1427→    .option("--reason <reason>", "Cancellation reason")
  1428→    .addHelpText(
  1429→      "after",
  1430→      `
  1431→Examples:
  1432→  $ kspec task cancel @task-slug --reason "No longer needed"
  1433→  $ kspec task cancel --refs @task1 @task2 --reason "Superseded by @new-task"`,
  1434→    )
  1435→    .action(async (ref: string | undefined, options) => {
  1436→      try {
  1437→        const ctx = await initContext();
  1438→        const tasks = await loadAllTasks(ctx);
  1439→        const items = await loadAllItems(ctx);
  1440→        const index = new ReferenceIndex(tasks, items);
  1441→
  1442→        const result = await executeBatchOperation({
  1443→          positionalRef: ref,
  1444→          refsFlag: options.refs,
  1445→          context: { ctx, tasks, items, index, options },
  1446→          items: tasks,
  1447→          index,
  1448→          resolveRef: (refStr, taskList, idx) => {
  1449→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1450→            return { item: resolved.task, error: resolved.error };
  1451→          },
  1452→          executeOperation: async (foundTask, { ctx, index, options }) => {
  1453→            try {
  1454→              if (
  1455→                foundTask.status === "completed" ||
  1456→                foundTask.status === "cancelled"
  1457→              ) {
  1458→                return {
  1459→                  success: false,
  1460→                  error: `Task is already ${foundTask.status}`,
  1461→                };
  1462→              }
  1463→
  1464→              const updatedTask: Task = {
  1465→                ...foundTask,
  1466→                status: "cancelled",
  1467→                closed_reason: options.reason || null,
  1468→              };
  1469→
  1470→              await saveTask(ctx, updatedTask);
  1471→              await commitIfShadow(
  1472→                ctx.shadow,
  1473→                "task-cancel",
  1474→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1475→              );
  1476→
  1477→              return {
  1478→                success: true,
  1479→                message: `Cancelled task: ${index.shortUlid(updatedTask._ulid)}`,
  1480→                data: updatedTask,
  1481→              };
  1482→            } catch (err) {
  1483→              return {
  1484→                success: false,
  1485→                error: err instanceof Error ? err.message : String(err),
  1486→              };
  1487→            }
  1488→          },
  1489→          getUlid: (task) => task._ulid,
  1490→        });
  1491→
  1492→        formatBatchOutput(result, "Cancel");
  1493→      } catch (err) {
  1494→        error(errors.failures.cancelTask, err);
  1495→        process.exit(EXIT_CODES.ERROR);
  1496→      }
  1497→    });
  1498→
  1499→  // kspec task reset <ref>
  1500→  // AC: @spec-task-reset ac-1, ac-2, ac-3, ac-4, ac-5, ac-6
  1501→  task
  1502→    .command("reset <ref>")
  1503→    .description("Reset a task to pending state")
  1504→    .action(async (ref: string) => {
  1505→      try {
  1506→        const ctx = await initContext();
  1507→        const tasks = await loadAllTasks(ctx);
  1508→        const items = await loadAllItems(ctx);
  1509→        const index = new ReferenceIndex(tasks, items);
  1510→        const foundTask = resolveTaskRef(ref, tasks, index);
  1511→
  1512→        // AC: @spec-task-reset ac-2 - Error if already pending
  1513→        if (foundTask.status === "pending") {
  1514→          error("Task is already pending");
  1515→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1516→        }
  1517→
  1518→        // Track previous status and reason for note (AC-4)
  1519→        const previousStatus = foundTask.status;
  1520→        const hadCancelReason =
  1521→          foundTask.closed_reason && foundTask.status === "cancelled";
  1522→        const cancelReasonText = hadCancelReason
  1523→          ? ` (was cancelled: ${foundTask.closed_reason})`
  1524→          : "";
  1525→
  1526→        // AC: @spec-task-reset ac-1 - Reset to pending, clear completion-related fields
  1527→        const clearedFields: string[] = [];
  1528→        const updatedTask: Task = {
  1529→          ...foundTask,
  1530→          status: "pending",
  1531→        };
  1532→
  1533→        // Clear timestamps and reasons based on previous status
  1534→        if (
  1535→          foundTask.completed_at !== undefined &&
  1536→          foundTask.completed_at !== null
  1537→        ) {
  1538→          updatedTask.completed_at = null;
  1539→          clearedFields.push("completed_at");
  1540→        }
  1541→        if (
  1542→          foundTask.started_at !== undefined &&
  1543→          foundTask.started_at !== null
  1544→        ) {
  1545→          updatedTask.started_at = null;
  1546→          clearedFields.push("started_at");
  1547→        }
  1548→        if (
  1549→          foundTask.closed_reason !== undefined &&
  1550→          foundTask.closed_reason !== null
  1551→        ) {
  1552→          updatedTask.closed_reason = null;
  1553→          clearedFields.push("closed_reason");
  1554→        }
  1555→        if (foundTask.blocked_by.length > 0) {
  1556→          updatedTask.blocked_by = [];
  1557→          clearedFields.push("blocked_by");
  1558→        }
  1559→
  1560→        // AC: @spec-task-reset ac-4 - Add note documenting the reset
  1561→        // AC: @spec-task-reset ac-author
  1562→        const noteContent = `Reset from ${previousStatus} to pending${cancelReasonText}`;
  1563→        const note = createNote(noteContent, getAuthor());
  1564→        updatedTask.notes = [...updatedTask.notes, note];
  1565→
  1566→        await saveTask(ctx, updatedTask);
  1567→        // AC: @spec-task-reset ac-3 - Shadow commit with message task-reset
  1568→        await commitIfShadow(
  1569→          ctx.shadow,
  1570→          "task-reset",
  1571→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1572→          `from ${previousStatus}`,
  1573→        );
  1574→
  1575→        // AC: @spec-task-reset ac-6 - JSON output includes previous_status, new_status, cleared_fields
  1576→        const jsonOutput = {
  1577→          task: updatedTask,
  1578→          previous_status: previousStatus,
  1579→          new_status: "pending" as const,
  1580→          cleared_fields: clearedFields,
  1581→        };
  1582→
  1583→        output(jsonOutput, () => {
  1584→          success(
  1585→            `Reset task: ${index.shortUlid(updatedTask._ulid)} (${previousStatus} → pending)`,
  1586→            undefined,
  1587→          );
  1588→          if (clearedFields.length > 0) {
  1589→            info(`Cleared fields: ${clearedFields.join(", ")}`);
  1590→          }
  1591→        });
  1592→      } catch (err) {
  1593→        error("Failed to reset task", err);
  1594→        process.exit(EXIT_CODES.ERROR);
  1595→      }
  1596→    });
  1597→
  1598→  // kspec task delete <ref> | --refs <refs...>
  1599→  // AC: @multi-ref-batch ac-1, ac-2
  1600→  task
  1601→    .command("delete [ref]")
  1602→    .description("Delete a task permanently")
  1603→    .option("--refs <refs...>", "Delete multiple tasks by ref")
  1604→    .option("--force", "Skip confirmation (required for --refs)")
  1605→    .option("--dry-run", "Show what would be deleted without deleting")
  1606→    .addHelpText(
  1607→      "after",
  1608→      `
  1609→Examples:
  1610→  $ kspec task delete @task-slug
  1611→  $ kspec task delete --refs @task1 @task2 --force
  1612→  $ kspec task delete --refs @task1 @task2 --dry-run`,
  1613→    )
  1614→    .action(async (ref: string | undefined, options) => {
  1615→      try {
  1616→        const ctx = await initContext();
  1617→        const tasks = await loadAllTasks(ctx);
  1618→        const items = await loadAllItems(ctx);
  1619→        const index = new ReferenceIndex(tasks, items);
  1620→
  1621→        // For batch mode (--refs), require --force
  1622→        if (
  1623→          options.refs &&
  1624→          options.refs.length > 0 &&
  1625→          !options.force &&
  1626→          !options.dryRun
  1627→        ) {
  1628→          error("Batch delete requires --force flag");
  1629→          process.exit(EXIT_CODES.USAGE_ERROR);
  1630→        }
  1631→
  1632→        const result = await executeBatchOperation({
  1633→          positionalRef: ref,
  1634→          refsFlag: options.refs,
  1635→          context: { ctx, tasks, items, index, options },
  1636→          items: tasks,
  1637→          index,
  1638→          resolveRef: (refStr, taskList, idx) => {
  1639→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1640→            return { item: resolved.task, error: resolved.error };
  1641→          },
  1642→          executeOperation: async (foundTask, { ctx, index, options }) => {
  1643→            try {
  1644→              const taskDisplay = `${foundTask.title} (${index.shortUlid(foundTask._ulid)})`;
  1645→
  1646→              if (options.dryRun) {
  1647→                return {
  1648→                  success: true,
  1649→                  message: `Would delete: ${taskDisplay}`,
  1650→                };
  1651→              }
  1652→
  1653→              // For single-ref mode (not --refs), prompt for confirmation unless --force
  1654→              if (!options.refs && !options.force) {
  1655→                const readline = await import("node:readline");
  1656→                const rl = readline.createInterface({
  1657→                  input: process.stdin,
  1658→                  output: process.stdout,
  1659→                });
  1660→
  1661→                const answer = await new Promise<string>((resolve) => {
  1662→                  rl.question(`Delete task "${taskDisplay}"? [y/N] `, resolve);
  1663→                });
  1664→                rl.close();
  1665→
  1666→                if (answer.toLowerCase() !== "y") {
  1667→                  return {
  1668→                    success: false,
  1669→                    error: "Deletion cancelled by user",
  1670→                  };
  1671→                }
  1672→              }
  1673→
  1674→              await deleteTask(ctx, foundTask);
  1675→              await commitIfShadow(
  1676→                ctx.shadow,
  1677→                "task-delete",
  1678→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1679→                foundTask.title,
  1680→              );
  1681→
  1682→              return {
  1683→                success: true,
  1684→                message: `Deleted task: ${taskDisplay}`,
  1685→              };
  1686→            } catch (err) {
  1687→              return {
  1688→                success: false,
  1689→                error: err instanceof Error ? err.message : String(err),
  1690→              };
  1691→            }
  1692→          },
  1693→          getUlid: (task) => task._ulid,
  1694→        });
  1695→
  1696→        formatBatchOutput(result, "Delete");
  1697→      } catch (err) {
  1698→        error(errors.failures.deleteTask, err);
  1699→        process.exit(EXIT_CODES.ERROR);
  1700→      }
  1701→    });
  1702→
  1703→  // kspec task note <ref> <message>
  1704→  task
  1705→    .command("note <ref> <message>")
  1706→    .description("Add a note to a task")
  1707→    .option("--author <author>", "Note author")
  1708→    .option("--supersedes <ulid>", "ULID of note this supersedes")
  1709→    .action(async (ref: string, message: string, options) => {
  1710→      try {
  1711→        const ctx = await initContext();
  1712→        const tasks = await loadAllTasks(ctx);
  1713→        const items = await loadAllItems(ctx);
  1714→        const index = new ReferenceIndex(tasks, items);
  1715→        const foundTask = resolveTaskRef(ref, tasks, index);
  1716→
  1717→        const note = createNote(message, options.author, options.supersedes);
  1718→
  1719→        const updatedTask: Task = {
  1720→          ...foundTask,
  1721→          notes: [...foundTask.notes, note],
  1722→        };
  1723→
  1724→        await saveTask(ctx, updatedTask);
  1725→        await commitIfShadow(
  1726→          ctx.shadow,
  1727→          "task-note",
  1728→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1729→        );
  1730→        success(`Added note to task: ${index.shortUlid(updatedTask._ulid)}`, {
  1731→          note,
  1732→        });
  1733→
  1734→        // Proactive alignment guidance for tasks with spec_ref
  1735→        if (foundTask.spec_ref) {
  1736→          console.log("");
  1737→          console.log(alignmentCheck.header);
  1738→          console.log(alignmentCheck.beyondSpec);
  1739→          console.log(alignmentCheck.updateSpec(foundTask.spec_ref));
  1740→          console.log(alignmentCheck.addAC);
  1741→
  1742→          // Check if linked spec has acceptance criteria and remind about test coverage
  1743→          const specResult = index.resolve(foundTask.spec_ref);
  1744→          if (specResult.ok && specResult.item) {
  1745→            const specItem = specResult.item as {
  1746→              acceptance_criteria?: unknown[];
  1747→            };
  1748→            if (
  1749→              specItem.acceptance_criteria &&
  1750→              specItem.acceptance_criteria.length > 0
  1751→            ) {
  1752→              console.log("");
  1753→              console.log(
  1754→                alignmentCheck.testCoverage(
  1755→                  specItem.acceptance_criteria.length,
  1756→                ),
  1757→              );
  1758→            }
  1759→          }
  1760→        }
  1761→      } catch (err) {
  1762→        error(errors.failures.addNote, err);
  1763→        process.exit(EXIT_CODES.ERROR);
  1764→      }
  1765→    });
  1766→
  1767→  // kspec task notes <ref>
  1768→  task
  1769→    .command("notes <ref>")
  1770→    .description("Show notes for a task")
  1771→    .action(async (ref: string) => {
  1772→      try {
  1773→        const ctx = await initContext();
  1774→        const tasks = await loadAllTasks(ctx);
  1775→        const items = await loadAllItems(ctx);
  1776→        const index = new ReferenceIndex(tasks, items);
  1777→        const foundTask = resolveTaskRef(ref, tasks, index);
  1778→
  1779→        output(foundTask.notes, () => {
  1780→          if (foundTask.notes.length === 0) {
  1781→            console.log("No notes");
  1782→          } else {
  1783→            for (const note of foundTask.notes) {
  1784→              const author = note.author || "unknown";
  1785→              console.log(`[${note.created_at}] ${author}:`);
  1786→              console.log(note.content);
  1787→              console.log("");
  1788→            }
  1789→          }
  1790→        });
  1791→      } catch (err) {
  1792→        error(errors.failures.getNotes, err);
  1793→        process.exit(EXIT_CODES.ERROR);
  1794→      }
  1795→    });
  1796→
  1797→  // kspec task review <ref>
  1798→  task
  1799→    .command("review <ref>")
  1800→    .description(
  1801→      "Get task context for review (task details, spec, ACs, git diff)",
  1802→    )
  1803→    .action(async (ref: string) => {
  1804→      try {
  1805→        const ctx = await initContext();
  1806→        const tasks = await loadAllTasks(ctx);
  1807→        const items = await loadAllItems(ctx);
  1808→        const index = new ReferenceIndex(tasks, items);
  1809→        const foundTask = resolveTaskRef(ref, tasks, index);
  1810→
  1811→        // Import getDiffSince from utils
  1812→        const { getDiffSince } = await import("../../utils/index.js");
  1813→
  1814→        // Gather review context
  1815→        const reviewContext: {
  1816→          task: typeof foundTask;
  1817→          spec: LoadedSpecItem | null;
  1818→          diff: string | null;
  1819→          started_at: string | null;
  1820→          testCoverage?: { covered: string[]; uncovered: string[] };
  1821→        } = {
  1822→          task: foundTask,
  1823→          spec: null,
  1824→          diff: null,
  1825→          started_at: foundTask.started_at || null,
  1826→        };
  1827→
  1828→        // Get spec item if task has spec_ref
  1829→        if (foundTask.spec_ref) {
  1830→          const specResult = index.resolve(foundTask.spec_ref);
  1831→          if (specResult.ok) {
  1832→            const specItem = items.find((i) => i._ulid === specResult.ulid);
  1833→            reviewContext.spec = specItem || null;
  1834→
  1835→            // Check test coverage for ACs if spec has them
  1836→            if (
  1837→              specItem?.acceptance_criteria &&
  1838→              specItem.acceptance_criteria.length > 0
  1839→            ) {
  1840→              const coveredACs = await scanTestCoverage(ctx.rootDir);
  1841→              const covered: string[] = [];
  1842→              const uncovered: string[] = [];
  1843→
  1844→              for (const ac of specItem.acceptance_criteria) {
  1845→                // Build possible references
  1846→                const possibleRefs: string[] = [];
  1847→                if (specItem.slugs && specItem.slugs.length > 0) {
  1848→                  possibleRefs.push(`@${specItem.slugs[0]} ${ac.id}`);
  1849→                  possibleRefs.push(`@${specItem.slugs[0]}`);
  1850→                }
  1851→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)} ${ac.id}`);
  1852→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)}`);
  1853→
  1854→                const isCovered = possibleRefs.some((ref) =>
  1855→                  coveredACs.has(ref),
  1856→                );
  1857→                if (isCovered) {
  1858→                  covered.push(ac.id);
  1859→                } else {
  1860→                  uncovered.push(ac.id);
  1861→                }
  1862→              }
  1863→
  1864→              reviewContext.testCoverage = { covered, uncovered };
  1865→            }
  1866→          }
  1867→        }
  1868→
  1869→        // Get git diff since task started
  1870→        if (foundTask.started_at) {
  1871→          const startedDate = new Date(foundTask.started_at);
  1872→          reviewContext.diff = getDiffSince(startedDate, ctx.rootDir);
  1873→        }
  1874→
  1875→        output(reviewContext, () => {
  1876→          console.log("=".repeat(60));
  1877→          console.log("Task Review Context");
  1878→          console.log("=".repeat(60));
  1879→          console.log();
  1880→
  1881→          // Task details
  1882→          console.log("TASK DETAILS");
  1883→          console.log("-".repeat(60));
  1884→          console.log(formatTaskDetails(foundTask, index));
  1885→          console.log();
  1886→
  1887→          // Spec details
  1888→          if (reviewContext.spec) {
  1889→            console.log("LINKED SPEC");
  1890→            console.log("-".repeat(60));
  1891→            console.log(`Title: ${reviewContext.spec.title}`);
  1892→            console.log(`Type: ${reviewContext.spec.type}`);
  1893→            if (reviewContext.spec.description) {
  1894→              console.log(`\nDescription:\n${reviewContext.spec.description}`);
  1895→            }
  1896→            if (
  1897→              reviewContext.spec.acceptance_criteria &&
  1898→              reviewContext.spec.acceptance_criteria.length > 0
  1899→            ) {
  1900→              console.log(
  1901→                `\nAcceptance Criteria (${reviewContext.spec.acceptance_criteria.length}):`,
  1902→              );
  1903→              for (const ac of reviewContext.spec.acceptance_criteria) {
  1904→                const isCovered = reviewContext.testCoverage?.covered.includes(
  1905→                  ac.id,
  1906→                );
  1907→                const coverageMarker = isCovered
  1908→                  ? chalk.green("✓")
  1909→                  : chalk.yellow("○");
  1910→                console.log(`  ${coverageMarker} [${ac.id}]`);
  1911→                console.log(`    Given: ${ac.given}`);
  1912→                console.log(`    When: ${ac.when}`);
  1913→                console.log(`    Then: ${ac.then}`);
  1914→              }
  1915→
  1916→              // Test coverage summary
  1917→              if (reviewContext.testCoverage) {
  1918→                const { covered, uncovered } = reviewContext.testCoverage;
  1919→                console.log();
  1920→                if (uncovered.length === 0) {
  1921→                  console.log(
  1922→                    chalk.green(
  1923→                      `  ✓ All ${covered.length} AC(s) have test coverage`,
  1924→                    ),
  1925→                  );
  1926→                } else {
  1927→                  console.log(
  1928→                    chalk.yellow(
  1929→                      `  Test coverage: ${covered.length}/${covered.length + uncovered.length} ACs covered`,
  1930→                    ),
  1931→                  );
  1932→                  console.log(
  1933→                    chalk.yellow(
  1934→                      `  Missing coverage for: ${uncovered.join(", ")}`,
  1935→                    ),
  1936→                  );
  1937→                }
  1938→              }
  1939→            }
  1940→            console.log();
  1941→          }
  1942→
  1943→          // Git diff
  1944→          if (reviewContext.diff) {
  1945→            console.log("CHANGES SINCE TASK STARTED");
  1946→            console.log("-".repeat(60));
  1947→            console.log(`Started at: ${foundTask.started_at}`);
  1948→            console.log();
  1949→            console.log(reviewContext.diff);
  1950→            console.log();
  1951→          } else if (foundTask.started_at) {
  1952→            console.log("CHANGES SINCE TASK STARTED");
  1953→            console.log("-".repeat(60));
  1954→            console.log(`Started at: ${foundTask.started_at}`);
  1955→            console.log("No changes detected");
  1956→            console.log();
  1957→          }
  1958→
  1959→          console.log("=".repeat(60));
  1960→          console.log("Review Checklist:");
  1961→          console.log("- Does the implementation match the task description?");
  1962→          if (reviewContext.spec) {
  1963→            console.log("- Are all acceptance criteria covered?");
  1964→            console.log("- Is test coverage adequate?");
  1965→          }
  1966→          console.log("- Are there any gaps or issues?");
  1967→          console.log("=".repeat(60));
  1968→        });
  1969→      } catch (err) {
  1970→        error("Failed to generate review context", err);
  1971→        process.exit(EXIT_CODES.ERROR);
  1972→      }
  1973→    });
  1974→
  1975→  // kspec task todos <ref>
  1976→  task
  1977→    .command("todos <ref>")
  1978→    .description("Show todos for a task")
  1979→    .action(async (ref: string) => {
  1980→      try {
  1981→        const ctx = await initContext();
  1982→        const tasks = await loadAllTasks(ctx);
  1983→        const items = await loadAllItems(ctx);
  1984→        const index = new ReferenceIndex(tasks, items);
  1985→        const foundTask = resolveTaskRef(ref, tasks, index);
  1986→
  1987→        output(foundTask.todos, () => {
  1988→          if (foundTask.todos.length === 0) {
  1989→            console.log("No todos");
  1990→          } else {
  1991→            for (const todo of foundTask.todos) {
  1992→              const status = todo.done ? "[x]" : "[ ]";
  1993→              const doneInfo =
  1994→                todo.done && todo.done_at ? ` (done ${todo.done_at})` : "";
  1995→              console.log(`${status} ${todo.id}. ${todo.text}${doneInfo}`);
  1996→            }
  1997→          }
  1998→        });
  1999→      } catch (err) {
  2000→        error(errors.failures.getTodos, err);
  2001→        process.exit(EXIT_CODES.ERROR);
  2002→      }
  2003→    });
  2004→
  2005→  // Create subcommand group for todo operations
  2006→  const todoCmd = task.command("todo").description("Manage task todos");
  2007→
  2008→  // kspec task todo add <ref> <text>
  2009→  todoCmd
  2010→    .command("add <ref> <text>")
  2011→    .description("Add a todo to a task")
  2012→    .option("--author <author>", "Todo author")
  2013→    .action(async (ref: string, text: string, options) => {
  2014→      try {
  2015→        const ctx = await initContext();
  2016→        const tasks = await loadAllTasks(ctx);
  2017→        const items = await loadAllItems(ctx);
  2018→        const index = new ReferenceIndex(tasks, items);
  2019→        const foundTask = resolveTaskRef(ref, tasks, index);
  2020→
  2021→        // Calculate next ID (max existing + 1, or 1 if none)
  2022→        const nextId =
  2023→          foundTask.todos.length > 0
  2024→            ? Math.max(...foundTask.todos.map((t) => t.id)) + 1
  2025→            : 1;
  2026→
  2027→        const todo = createTodo(nextId, text, options.author);
  2028→
  2029→        const updatedTask: Task = {
  2030→          ...foundTask,
  2031→          todos: [...foundTask.todos, todo],
  2032→        };
  2033→
  2034→        await saveTask(ctx, updatedTask);
  2035→        await commitIfShadow(
  2036→          ctx.shadow,
  2037→          "task-note",
  2038→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2039→        );
  2040→        success(
  2041→          `Added todo #${todo.id} to task: ${index.shortUlid(updatedTask._ulid)}`,
  2042→          { todo },
  2043→        );
  2044→      } catch (err) {
  2045→        error(errors.failures.addTodo, err);
  2046→        process.exit(EXIT_CODES.ERROR);
  2047→      }
  2048→    });
  2049→
  2050→  // kspec task todo done <ref> <id>
  2051→  todoCmd
  2052→    .command("done <ref> <id>")
  2053→    .description("Mark a todo as done")
  2054→    .action(async (ref: string, idStr: string) => {
  2055→      try {
  2056→        const ctx = await initContext();
  2057→        const tasks = await loadAllTasks(ctx);
  2058→        const items = await loadAllItems(ctx);
  2059→        const index = new ReferenceIndex(tasks, items);
  2060→        const foundTask = resolveTaskRef(ref, tasks, index);
  2061→
  2062→        const id = parseInt(idStr, 10);
  2063→        if (Number.isNaN(id)) {
  2064→          error(errors.todo.invalidId(idStr));
  2065→          process.exit(EXIT_CODES.USAGE_ERROR);
  2066→        }
  2067→
  2068→        const todoIndex = foundTask.todos.findIndex((t) => t.id === id);
  2069→        if (todoIndex === -1) {
  2070→          error(errors.todo.notFound(id));
  2071→          process.exit(EXIT_CODES.NOT_FOUND);
  2072→        }
  2073→
  2074→        if (foundTask.todos[todoIndex].done) {
  2075→          warn(`Todo #${id} is already done`);
  2076→          return;
  2077→        }
  2078→
  2079→        const updatedTodos = [...foundTask.todos];
  2080→        updatedTodos[todoIndex] = {
  2081→          ...updatedTodos[todoIndex],
  2082→          done: true,
  2083→          done_at: new Date().toISOString(),
  2084→        };
  2085→
  2086→        const updatedTask: Task = {
  2087→          ...foundTask,
  2088→          todos: updatedTodos,
  2089→        };
  2090→
  2091→        await saveTask(ctx, updatedTask);
  2092→        await commitIfShadow(
  2093→          ctx.shadow,
  2094→          "task-note",
  2095→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2096→        );
  2097→        success(`Marked todo #${id} as done`, {
  2098→          todo: updatedTodos[todoIndex],
  2099→        });
  2100→      } catch (err) {
  2101→        error(errors.failures.markTodoDone, err);
  2102→        process.exit(EXIT_CODES.ERROR);
  2103→      }
  2104→    });
  2105→
  2106→  // kspec task todo undone <ref> <id>
  2107→  todoCmd
  2108→    .command("undone <ref> <id>")
  2109→    .description("Mark a todo as not done")
  2110→    .action(async (ref: string, idStr: string) => {
  2111→      try {
  2112→        const ctx = await initContext();
  2113→        const tasks = await loadAllTasks(ctx);
  2114→        const items = await loadAllItems(ctx);
  2115→        const index = new ReferenceIndex(tasks, items);
  2116→        const foundTask = resolveTaskRef(ref, tasks, index);
  2117→
  2118→        const id = parseInt(idStr, 10);
  2119→        if (Number.isNaN(id)) {
  2120→          error(errors.todo.invalidId(idStr));
  2121→          process.exit(EXIT_CODES.USAGE_ERROR);
  2122→        }
  2123→
  2124→        const todoIndex = foundTask.todos.findIndex((t) => t.id === id);
  2125→        if (todoIndex === -1) {
  2126→          error(errors.todo.notFound(id));
  2127→          process.exit(EXIT_CODES.NOT_FOUND);
  2128→        }
  2129→
  2130→        if (!foundTask.todos[todoIndex].done) {
  2131→          warn(`Todo #${id} is not done`);
  2132→          return;
  2133→        }
  2134→
  2135→        const updatedTodos = [...foundTask.todos];
  2136→        updatedTodos[todoIndex] = {
  2137→          ...updatedTodos[todoIndex],
  2138→          done: false,
  2139→          done_at: undefined,
  2140→        };
  2141→
  2142→        const updatedTask: Task = {
  2143→          ...foundTask,
  2144→          todos: updatedTodos,
  2145→        };
  2146→
  2147→        await saveTask(ctx, updatedTask);
  2148→        await commitIfShadow(
  2149→          ctx.shadow,
  2150→          "task-note",
  2151→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2152→        );
  2153→        success(`Marked todo #${id} as not done`, {
  2154→          todo: updatedTodos[todoIndex],
  2155→        });
  2156→      } catch (err) {
  2157→        error(errors.failures.markTodoNotDone, err);
  2158→        process.exit(EXIT_CODES.ERROR);
  2159→      }
  2160→    });
  2161→}
