```
     1→/**
     2→ * Workflow run CLI commands
     3→ *
     4→ * Implements workflow run lifecycle management:
     5→ * - kspec workflow start @ref [--task @ref] [--json]
     6→ * - kspec workflow runs [--active] [--completed] [--workflow @ref] [--json]
     7→ * - kspec workflow show @run [--json]
     8→ * - kspec workflow abort @run [--reason text] [--json]
     9→ */
    10→
    11→import chalk from "chalk";
    12→import Table from "cli-table3";
    13→import type { Command } from "commander";
    14→import { ulid } from "ulid";
    15→import {
    16→  findActiveRuns,
    17→  findWorkflowRunByRef,
    18→  getAuthor,
    19→  initContext,
    20→  loadAllTasks,
    21→  loadMetaContext,
    22→  loadWorkflowRuns,
    23→  ReferenceIndex,
    24→  saveWorkflowRun,
    25→  updateWorkflowRun,
    26→  type Workflow,
    27→} from "../../parser/index.js";
    28→import { commitIfShadow } from "../../parser/shadow.js";
    29→import type { WorkflowRun } from "../../schema/index.js";
    30→import { errors } from "../../strings/errors.js";
    31→import { EXIT_CODES } from "../exit-codes.js";
    32→import { error, isJsonMode, output, success } from "../output.js";
    33→
    34→/**
    35→ * Find a workflow by reference
    36→ */
    37→function resolveWorkflowRef(
    38→  ref: string,
    39→  workflows: Workflow[],
    40→): Workflow | null {
    41→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
    42→
    43→  // Try by ID first
    44→  let workflow = workflows.find((w) => w.id === cleanRef);
    45→  if (workflow) return workflow;
    46→
    47→  // Try by ULID or ULID prefix
    48→  workflow = workflows.find(
    49→    (w) =>
    50→      w._ulid === cleanRef ||
    51→      w._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
    52→  );
    53→  return workflow || null;
    54→}
    55→
    56→/**
    57→ * Format a short ULID (first 8 chars)
    58→ */
    59→function shortUlid(ulid: string): string {
    60→  return ulid.slice(0, 8).toUpperCase();
    61→}
    62→
    63→/**
    64→ * Format run status with color
    65→ */
    66→function formatStatus(status: string): string {
    67→  switch (status) {
    68→    case "active":
    69→      return chalk.green(status);
    70→    case "paused":
    71→      return chalk.yellow(status);
    72→    case "completed":
    73→      return chalk.blue(status);
    74→    case "aborted":
    75→      return chalk.red(status);
    76→    default:
    77→      return status;
    78→  }
    79→}
    80→
    81→/**
    82→ * Command: kspec workflow start @workflow-ref [--task @task-ref] [--json]
    83→ * AC: @workflow-run-foundation ac-1, ac-6
    84→ */
    85→async function workflowStart(
    86→  workflowRef: string,
    87→  options: { task?: string; json?: boolean },
    88→) {
    89→  const ctx = await initContext();
    90→  const metaCtx = await loadMetaContext(ctx);
    91→
    92→  // DEBUG: Log loaded workflows
    93→  // Resolve workflow reference
    94→  const workflow = resolveWorkflowRef(workflowRef, metaCtx.workflows);
    95→  if (!workflow) {
    96→    error(errors.workflowRun.workflowNotFound(workflowRef));
    97→    process.exit(EXIT_CODES.NOT_FOUND);
    98→  }
    99→
   100→  // Validate task reference if provided (AC: @workflow-run-foundation ac-6)
   101→  let taskRef: string | undefined;
   102→  if (options.task) {
   103→    const tasks = await loadAllTasks(ctx);
   104→    const index = new ReferenceIndex(tasks, []);
   105→    const result = index.resolve(options.task);
   106→    if (!result.ok) {
   107→      error(errors.reference.taskNotFound(options.task));
   108→      process.exit(EXIT_CODES.NOT_FOUND);
   109→    }
   110→    taskRef = `@${result.ulid}`;
   111→  }
   112→
   113→  // Create new workflow run
   114→  const run: WorkflowRun = {
   115→    _ulid: ulid(),
   116→    workflow_ref: `@${workflow._ulid}`,
   117→    status: "active",
   118→    current_step: 0,
   119→    total_steps: workflow.steps.length,
   120→    started_at: new Date().toISOString(),
   121→    step_results: [],
   122→    initiated_by: getAuthor(),
   123→    task_ref: taskRef,
   124→  };
   125→
   126→  // Save the run
   127→  await saveWorkflowRun(ctx, run);
   128→
   129→  // Commit to shadow
   130→  await commitIfShadow(ctx.shadow, "workflow-start");
   131→
   132→  // Output result
   133→  if (isJsonMode()) {
   134→    output({
   135→      run_id: run._ulid,
   136→      workflow_ref: run.workflow_ref,
   137→      status: run.status,
   138→    });
   139→  } else {
   140→    success(`Started workflow run: ${shortUlid(run._ulid)}`);
   141→    console.log(`  Workflow: ${workflow.id}`);
   142→    console.log(`  Steps: ${run.total_steps}`);
   143→    if (taskRef) {
   144→      console.log(`  Linked task: ${taskRef}`);
   145→    }
   146→  }
   147→}
   148→
   149→/**
   150→ * Command: kspec workflow runs [--active] [--completed] [--workflow @ref] [--json]
   151→ * AC: @workflow-run-foundation ac-2
   152→ */
   153→async function workflowRuns(options: {
   154→  active?: boolean;
   155→  completed?: boolean;
   156→  workflow?: string;
   157→  json?: boolean;
   158→}) {
   159→  const ctx = await initContext();
   160→  const metaCtx = await loadMetaContext(ctx);
   161→  let runs = await loadWorkflowRuns(ctx);
   162→
   163→  // Apply filters
   164→  if (options.active) {
   165→    runs = runs.filter((r) => r.status === "active");
   166→  }
   167→  if (options.completed) {
   168→    runs = runs.filter((r) => r.status === "completed");
   169→  }
   170→  if (options.workflow) {
   171→    const workflow = resolveWorkflowRef(options.workflow, metaCtx.workflows);
   172→    if (!workflow) {
   173→      error(errors.workflowRun.workflowNotFound(options.workflow));
   174→      process.exit(EXIT_CODES.NOT_FOUND);
   175→    }
   176→    runs = runs.filter((r) => r.workflow_ref === `@${workflow._ulid}`);
   177→  }
   178→
   179→  if (isJsonMode()) {
   180→    output({ runs });
   181→  } else {
   182→    if (runs.length === 0) {
   183→      console.log(chalk.gray("No workflow runs found"));
   184→      return;
   185→    }
   186→
   187→    const table = new Table({
   188→      head: ["ID", "Workflow", "Status", "Step", "Started"],
   189→      colWidths: [12, 25, 12, 10, 20],
   190→    });
   191→
   192→    for (const run of runs) {
   193→      const workflow = metaCtx.workflows.find(
   194→        (w) => `@${w._ulid}` === run.workflow_ref,
   195→      );
   196→      const workflowName = workflow?.id || run.workflow_ref;
   197→      const stepProgress = `${run.current_step + 1}/${run.total_steps}`;
   198→      const started = new Date(run.started_at).toLocaleString();
   199→
   200→      table.push([
   201→        shortUlid(run._ulid),
   202→        workflowName,
   203→        formatStatus(run.status),
   204→        stepProgress,
   205→        started,
   206→      ]);
   207→    }
   208→
   209→    console.log(table.toString());
   210→  }
   211→}
   212→
   213→/**
   214→ * Command: kspec workflow show @run-id [--json]
   215→ * AC: @workflow-run-foundation ac-4
   216→ */
   217→async function workflowShow(runRef: string, _options: { json?: boolean }) {
   218→  const ctx = await initContext();
   219→  const metaCtx = await loadMetaContext(ctx);
   220→
   221→  const run = await findWorkflowRunByRef(ctx, runRef);
   222→  if (!run) {
   223→    error(errors.workflowRun.runNotFound(runRef));
   224→    process.exit(EXIT_CODES.NOT_FOUND);
   225→  }
   226→
   227→  if (isJsonMode()) {
   228→    output({ run });
   229→  } else {
   230→    const workflow = metaCtx.workflows.find(
   231→      (w) => `@${w._ulid}` === run.workflow_ref,
   232→    );
   233→    const workflowName = workflow?.id || run.workflow_ref;
   234→
   235→    console.log(chalk.bold("Workflow Run Details"));
   236→    console.log(chalk.gray("─".repeat(50)));
   237→    console.log(`ID:           ${shortUlid(run._ulid)}`);
   238→    console.log(`Workflow:     ${workflowName} (${run.workflow_ref})`);
   239→    console.log(`Status:       ${formatStatus(run.status)}`);
   240→    console.log(`Progress:     ${run.current_step + 1}/${run.total_steps}`);
   241→    console.log(`Started:      ${new Date(run.started_at).toLocaleString()}`);
   242→
   243→    if (run.initiated_by) {
   244→      console.log(`Initiated by: ${run.initiated_by}`);
   245→    }
   246→    if (run.task_ref) {
   247→      console.log(`Task:         ${run.task_ref}`);
   248→    }
   249→    if (run.paused_at) {
   250→      console.log(`Paused:       ${new Date(run.paused_at).toLocaleString()}`);
   251→    }
   252→    if (run.completed_at) {
   253→      console.log(
   254→        `Completed:    ${new Date(run.completed_at).toLocaleString()}`,
   255→      );
   256→    }
   257→    if (run.abort_reason) {
   258→      console.log(`Abort reason: ${run.abort_reason}`);
   259→    }
   260→
   261→    if (run.step_results.length > 0) {
   262→      console.log(chalk.gray("\nStep Results:"));
   263→      const table = new Table({
   264→        head: ["Step", "Status", "Started", "Completed"],
   265→        colWidths: [8, 12, 20, 20],
   266→      });
   267→
   268→      for (const result of run.step_results) {
   269→        table.push([
   270→          (result.step_index + 1).toString(),
   271→          formatStatus(result.status),
   272→          new Date(result.started_at).toLocaleString(),
   273→          new Date(result.completed_at).toLocaleString(),
   274→        ]);
   275→      }
   276→
   277→      console.log(table.toString());
   278→    }
   279→  }
   280→}
   281→
   282→/**
   283→ * Command: kspec workflow abort @run-id [--reason text] [--json]
   284→ * AC: @workflow-run-foundation ac-3, ac-5
   285→ */
   286→async function workflowAbort(
   287→  runRef: string,
   288→  options: { reason?: string; json?: boolean },
   289→) {
   290→  const ctx = await initContext();
   291→
   292→  const run = await findWorkflowRunByRef(ctx, runRef);
   293→  if (!run) {
   294→    error(errors.workflowRun.runNotFound(runRef));
   295→    process.exit(EXIT_CODES.NOT_FOUND);
   296→  }
   297→
   298→  // AC: @workflow-run-foundation ac-5 - Cannot abort completed or aborted runs
   299→  if (run.status === "completed") {
   300→    error(errors.workflowRun.cannotAbortCompleted);
   301→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   302→  }
   303→
   304→  if (run.status === "aborted") {
   305→    error(errors.workflowRun.cannotAbortAborted);
   306→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   307→  }
   308→
   309→  // Update run status
   310→  run.status = "aborted";
   311→  run.abort_reason = options.reason;
   312→  run.completed_at = new Date().toISOString();
   313→
   314→  await updateWorkflowRun(ctx, run);
   315→  await commitIfShadow(ctx.shadow, "workflow-abort");
   316→
   317→  if (isJsonMode()) {
   318→    output({ run_id: run._ulid, status: run.status });
   319→  } else {
   320→    success(`Aborted workflow run: ${shortUlid(run._ulid)}`);
   321→    if (options.reason) {
   322→      console.log(`  Reason: ${options.reason}`);
   323→    }
   324→  }
   325→}
   326→
   327→/**
   328→ * Command: kspec workflow pause @run-id [--json]
   329→ * AC: @workflow-advanced-features ac-1
   330→ */
   331→async function workflowPause(runRef: string, _options: { json?: boolean }) {
   332→  const ctx = await initContext();
   333→
   334→  const run = await findWorkflowRunByRef(ctx, runRef);
   335→  if (!run) {
   336→    error(errors.workflowRun.runNotFound(runRef));
   337→    process.exit(EXIT_CODES.NOT_FOUND);
   338→  }
   339→
   340→  // Only active runs can be paused
   341→  if (run.status !== "active") {
   342→    error(
   343→      `Cannot pause run ${shortUlid(run._ulid)}: current status is ${run.status}`,
   344→    );
   345→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   346→  }
   347→
   348→  // Update run status
   349→  run.status = "paused";
   350→  run.paused_at = new Date().toISOString();
   351→
   352→  await updateWorkflowRun(ctx, run);
   353→  await commitIfShadow(ctx.shadow, "workflow-pause");
   354→
   355→  if (isJsonMode()) {
   356→    output({ run_id: run._ulid, status: run.status, paused_at: run.paused_at });
   357→  } else {
   358→    success(
   359→      `Paused run ${shortUlid(run._ulid)} at step ${run.current_step + 1}/${run.total_steps}`,
   360→    );
   361→  }
   362→}
   363→
   364→/**
   365→ * Command: kspec workflow resume @run-id [--json]
   366→ * AC: @workflow-advanced-features ac-2, ac-4
   367→ */
   368→async function workflowResume(runRef: string, _options: { json?: boolean }) {
   369→  const ctx = await initContext();
   370→  const metaCtx = await loadMetaContext(ctx);
   371→
   372→  const run = await findWorkflowRunByRef(ctx, runRef);
   373→  if (!run) {
   374→    error(errors.workflowRun.runNotFound(runRef));
   375→    process.exit(EXIT_CODES.NOT_FOUND);
   376→  }
   377→
   378→  // AC: @workflow-advanced-features ac-4 - Error if not paused
   379→  if (run.status !== "paused") {
   380→    error(
   381→      `Cannot resume run ${shortUlid(run._ulid)}: current status is ${run.status} (expected paused)`,
   382→    );
   383→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   384→  }
   385→
   386→  // Update run status
   387→  run.status = "active";
   388→  run.paused_at = undefined;
   389→
   390→  await updateWorkflowRun(ctx, run);
   391→  await commitIfShadow(ctx.shadow, "workflow-resume");
   392→
   393→  // Get workflow definition to show current step
   394→  const workflow = metaCtx.workflows.find(
   395→    (w) => `@${w._ulid}` === run.workflow_ref,
   396→  );
   397→  if (!workflow) {
   398→    error(errors.workflowRun.workflowNotFound(run.workflow_ref));
   399→    process.exit(EXIT_CODES.NOT_FOUND);
   400→  }
   401→
   402→  const currentStep = workflow.steps[run.current_step];
   403→
   404→  if (isJsonMode()) {
   405→    output({
   406→      run_id: run._ulid,
   407→      status: run.status,
   408→      current_step: run.current_step,
   409→      total_steps: run.total_steps,
   410→      next_step: {
   411→        type: currentStep.type,
   412→        content: currentStep.content,
   413→      },
   414→    });
   415→  } else {
   416→    success(`Resumed run ${shortUlid(run._ulid)}`);
   417→    console.log(
   418→      `\nStep ${run.current_step + 1}/${run.total_steps}: [${currentStep.type}] ${currentStep.content}`,
   419→    );
   420→  }
   421→}
   422→
   423→/**
   424→ * Command: kspec workflow next [run-ref] [--skip] [--notes text] [--confirm] [--force] [--input key=value] [--json]
   425→ * AC: @workflow-step-navigation ac-1 through ac-6
   426→ * AC: @workflow-enforcement-modes ac-1 through ac-4
   427→ * AC: @workflow-advanced-features ac-3
   428→ */
   429→async function workflowNext(
   430→  runRef: string | undefined,
   431→  options: {
   432→    skip?: boolean;
   433→    notes?: string;
   434→    confirm?: boolean;
   435→    force?: boolean;
   436→    input?: string[];
   437→    json?: boolean;
   438→  },
   439→) {
   440→  const ctx = await initContext();
   441→  const metaCtx = await loadMetaContext(ctx);
   442→
   443→  let run: WorkflowRun | undefined;
   444→
   445→  // AC: @workflow-step-navigation ac-3, ac-4, ac-5
   446→  if (!runRef) {
   447→    const activeRuns = await findActiveRuns(ctx);
   448→
   449→    if (activeRuns.length === 0) {
   450→      // AC: @workflow-step-navigation ac-5
   451→      error(errors.workflowRun.noActiveRuns);
   452→      process.exit(EXIT_CODES.NOT_FOUND);
   453→    }
   454→
   455→    if (activeRuns.length > 1) {
   456→      // AC: @workflow-step-navigation ac-4
   457→      const runIds = activeRuns.map((r) => shortUlid(r._ulid));
   458→      error(errors.workflowRun.multipleActiveRuns(runIds));
   459→      process.exit(EXIT_CODES.VALIDATION_FAILED);
   460→    }
   461→
   462→    // AC: @workflow-step-navigation ac-3 - exactly one active run
   463→    run = activeRuns[0];
   464→  } else {
   465→    run = await findWorkflowRunByRef(ctx, runRef);
   466→    if (!run) {
   467→      error(errors.workflowRun.runNotFound(runRef));
   468→      process.exit(EXIT_CODES.NOT_FOUND);
   469→    }
   470→
   471→    if (run.status !== "active") {
   472→      error(errors.workflowRun.runNotActive(runRef, run.status));
   473→      process.exit(EXIT_CODES.VALIDATION_FAILED);
   474→    }
   475→  }
   476→
   477→  // Get workflow definition to access steps
   478→  const workflow = metaCtx.workflows.find(
   479→    (w) => `@${w._ulid}` === run.workflow_ref,
   480→  );
   481→  if (!workflow) {
   482→    error(errors.workflowRun.workflowNotFound(run.workflow_ref));
   483→    process.exit(EXIT_CODES.NOT_FOUND);
   484→  }
   485→
   486→  // Get current step and next step
   487→  const currentStepIndex = run.current_step;
   488→  const currentStep = workflow.steps[currentStepIndex];
   489→  const isStrictMode = workflow.enforcement === "strict";
   490→  const isLastStep = currentStepIndex === run.total_steps - 1;
   491→
   492→  // AC: @workflow-advanced-features ac-3 - Handle step inputs
   493→  const stepInputs: Record<string, string> = {};
   494→  if (currentStep.inputs && currentStep.inputs.length > 0) {
   495→    // Display required inputs if not in JSON mode
   496→    if (!isJsonMode()) {
   497→      console.log(
   498→        `Step ${currentStepIndex + 1}/${run.total_steps}: [${currentStep.type}] ${currentStep.content}`,
   499→      );
   500→      console.log(chalk.cyan("  Inputs required:"));
   501→      for (const input of currentStep.inputs) {
   502→        const requiredLabel = input.required !== false ? "" : " (optional)";
   503→        const typeLabel = input.type ? ` (${input.type})` : "";
   504→        const desc = input.description ? `: ${input.description}` : "";
   505→        console.log(
   506→          chalk.cyan(`    - ${input.name}${typeLabel}${requiredLabel}${desc}`),
   507→        );
   508→      }
   509→      console.log();
   510→    }
   511→
   512→    // Parse --input flags
   513→    if (options.input) {
   514→      for (const inputStr of options.input) {
   515→        const [key, ...valueParts] = inputStr.split("=");
   516→        if (!valueParts.length) {
   517→          error(
   518→            `Invalid input format: "${inputStr}". Expected format: key=value`,
   519→          );
   520→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   521→        }
   522→        stepInputs[key] = valueParts.join("="); // Rejoin in case value contains '='
   523→      }
   524→    }
   525→
   526→    // Validate required inputs
   527→    for (const input of currentStep.inputs) {
   528→      if (input.required !== false && !stepInputs[input.name]) {
   529→        error(`Missing required input: ${input.name}`);
   530→        process.exit(EXIT_CODES.VALIDATION_FAILED);
   531→      }
   532→    }
   533→  }
   534→
   535→  // AC: @workflow-enforcement-modes ac-3 - Strict mode: --skip requires --force
   536→  if (options.skip && isStrictMode && !options.force) {
   537→    error(errors.workflowRun.skipRequiresForce);
   538→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   539→  }
   540→
   541→  // AC: @workflow-enforcement-modes ac-2, ac-3 - Check exit criteria for CURRENT step
   542→  if (
   543→    currentStep.exit_criteria &&
   544→    currentStep.exit_criteria.length > 0 &&
   545→    !options.skip
   546→  ) {
   547→    // AC: @workflow-enforcement-modes ac-3 - Strict mode requires --confirm
   548→    if (isStrictMode && !options.confirm) {
   549→      if (!isJsonMode()) {
   550→        console.log(
   551→          `Completing step ${currentStepIndex + 1}/${run.total_steps}: [${currentStep.type}] ${currentStep.content}`,
   552→        );
   553→        console.log(chalk.yellow("  Exit criteria:"));
   554→        for (const criterion of currentStep.exit_criteria) {
   555→          console.log(chalk.yellow(`    - ${criterion}`));
   556→        }
   557→        console.log();
   558→      }
   559→      error(errors.workflowRun.exitCriteriaNotConfirmed);
   560→      process.exit(EXIT_CODES.VALIDATION_FAILED);
   561→    }
   562→
   563→    // AC: @workflow-enforcement-modes ac-4 - Advisory mode shows criteria as guidance
   564→    if (!isStrictMode && !isJsonMode()) {
   565→      console.log(chalk.gray("  Exit criteria:"));
   566→      for (const criterion of currentStep.exit_criteria) {
   567→        console.log(chalk.gray(`    - ${criterion}`));
   568→      }
   569→    }
   570→  }
   571→
   572→  // AC: @workflow-enforcement-modes ac-1, ac-3 - Check entry criteria for NEXT step
   573→  // (Only applies when advancing from current step normally, not when skipping or completing the workflow)
   574→  // When skipping, we don't check entry criteria because we're not actually starting the next step yet
   575→  if (!isLastStep && !options.skip) {
   576→    const nextStep = workflow.steps[currentStepIndex + 1];
   577→    if (nextStep.entry_criteria && nextStep.entry_criteria.length > 0) {
   578→      // AC: @workflow-enforcement-modes ac-3 - Strict mode requires --confirm
   579→      if (isStrictMode && !options.confirm) {
   580→        if (!isJsonMode()) {
   581→          console.log(
   582→            `Step ${currentStepIndex + 2}/${run.total_steps}: [${nextStep.type}] ${nextStep.content}`,
   583→          );
   584→          console.log(chalk.yellow("  Entry criteria:"));
   585→          for (const criterion of nextStep.entry_criteria) {
   586→            console.log(chalk.yellow(`    - ${criterion}`));
   587→          }
   588→          console.log();
   589→        }
   590→        error(errors.workflowRun.entryCriteriaNotConfirmed);
   591→        process.exit(EXIT_CODES.VALIDATION_FAILED);
   592→      }
   593→
   594→      // AC: @workflow-enforcement-modes ac-4 - Advisory mode shows criteria as guidance
   595→      if (!isStrictMode && !isJsonMode()) {
   596→        console.log(
   597→          `Step ${currentStepIndex + 2}/${run.total_steps}: [${nextStep.type}] ${nextStep.content}`,
   598→        );
   599→        console.log(chalk.gray("  Entry criteria:"));
   600→        for (const criterion of nextStep.entry_criteria) {
   601→          console.log(chalk.gray(`    - ${criterion}`));
   602→        }
   603→        console.log();
   604→      }
   605→    }
   606→  }
   607→
   608→  // AC: @workflow-step-navigation ac-1, ac-6 - Complete current step
   609→  const previousResult = run.step_results[run.step_results.length - 1];
   610→  const startedAt = previousResult
   611→    ? previousResult.completed_at
   612→    : run.started_at;
   613→
   614→  // AC: @workflow-enforcement-modes ac-3 - Record confirmations in StepResult
   615→  // Check if a stub result already exists for this step (created when we advanced to it)
   616→  const existingResultIndex = run.step_results.findIndex(
   617→    (r) => r.step_index === currentStepIndex,
   618→  );
   619→
   620→  if (existingResultIndex >= 0) {
   621→    // Update existing stub result with completion data
   622→    const existingResult = run.step_results[existingResultIndex];
   623→    run.step_results[existingResultIndex] = {
   624→      ...existingResult,
   625→      status: options.skip ? ("skipped" as const) : ("completed" as const),
   626→      completed_at: new Date().toISOString(),
   627→      notes: options.notes,
   628→      exit_confirmed:
   629→        currentStep.exit_criteria &&
   630→        currentStep.exit_criteria.length > 0 &&
   631→        options.confirm
   632→          ? true
   633→          : undefined,
   634→      inputs: Object.keys(stepInputs).length > 0 ? stepInputs : undefined,
   635→    };
   636→  } else {
   637→    // No stub exists (first step or old data), create complete result
   638→    const stepResult = {
   639→      step_index: currentStepIndex,
   640→      status: options.skip ? ("skipped" as const) : ("completed" as const),
   641→      started_at: startedAt,
   642→      completed_at: new Date().toISOString(),
   643→      notes: options.notes,
   644→      exit_confirmed:
   645→        currentStep.exit_criteria &&
   646→        currentStep.exit_criteria.length > 0 &&
   647→        options.confirm
   648→          ? true
   649→          : undefined,
   650→      entry_confirmed: undefined,
   651→      inputs: Object.keys(stepInputs).length > 0 ? stepInputs : undefined,
   652→    };
   653→    run.step_results.push(stepResult);
   654→  }
   655→
   656→  // AC: @workflow-step-navigation ac-1 - Advance to next step or complete run
   657→  if (isLastStep) {
   658→    // AC: @workflow-step-navigation ac-2 - Complete the run
   659→    run.status = "completed";
   660→    run.completed_at = new Date().toISOString();
   661→
   662→    await updateWorkflowRun(ctx, run);
   663→    await commitIfShadow(ctx.shadow, "workflow-next");
   664→
   665→    // Calculate summary stats
   666→    const totalDuration =
   667→      new Date(run.completed_at).getTime() - new Date(run.started_at).getTime();
   668→    const completedSteps = run.step_results.filter(
   669→      (r) => r.status === "completed",
   670→    ).length;
   671→    const skippedSteps = run.step_results.filter(
   672→      (r) => r.status === "skipped",
   673→    ).length;
   674→
   675→    if (isJsonMode()) {
   676→      output({
   677→        run_id: run._ulid,
   678→        status: run.status,
   679→        completed_at: run.completed_at,
   680→        total_duration_ms: totalDuration,
   681→        steps_completed: completedSteps,
   682→        steps_skipped: skippedSteps,
   683→      });
   684→    } else {
   685→      const currentStep = workflow.steps[currentStepIndex];
   686→      success(
   687→        `Completed step ${currentStepIndex + 1}/${run.total_steps}: [${currentStep.type}] ${currentStep.content}`,
   688→      );
   689→      console.log();
   690→      console.log(chalk.bold("Workflow completed!"));
   691→      console.log(`  Duration: ${Math.round(totalDuration / 1000)}s`);
   692→      console.log(`  Steps completed: ${completedSteps}`);
   693→      console.log(`  Steps skipped: ${skippedSteps}`);
   694→    }
   695→  } else {
   696→    // Advance to next step
   697→    run.current_step += 1;
   698→
   699→    // AC: @workflow-enforcement-modes ac-3 - Record entry confirmation for the next step
   700→    // Create a stub step result for the next step to capture entry_confirmed and started_at
   701→    // This will be updated with completion data when the step is completed
   702→    const nextStep = workflow.steps[run.current_step];
   703→    const nextStepStartedAt =
   704→      run.step_results[run.step_results.length - 1]?.completed_at ||
   705→      new Date().toISOString();
   706→    const nextStepStub = {
   707→      step_index: run.current_step,
   708→      status: "completed" as const, // Placeholder, will be updated
   709→      started_at: nextStepStartedAt,
   710→      completed_at: nextStepStartedAt, // Placeholder, will be updated
   711→      entry_confirmed:
   712→        nextStep.entry_criteria &&
   713→        nextStep.entry_criteria.length > 0 &&
   714→        options.confirm
   715→          ? true
   716→          : undefined,
   717→    };
   718→    run.step_results.push(nextStepStub);
   719→
   720→    await updateWorkflowRun(ctx, run);
   721→    await commitIfShadow(ctx.shadow, "workflow-next");
   722→
   723→    if (isJsonMode()) {
   724→      output({
   725→        run_id: run._ulid,
   726→        current_step: run.current_step,
   727→        total_steps: run.total_steps,
   728→        next_step: {
   729→          type: nextStep.type,
   730→          content: nextStep.content,
   731→        },
   732→      });
   733→    } else {
   734→      const previousStep = workflow.steps[currentStepIndex];
   735→      success(
   736→        `Completed step ${currentStepIndex + 1}/${run.total_steps}: [${previousStep.type}] ${previousStep.content}`,
   737→      );
   738→      console.log();
   739→      console.log(
   740→        `Step ${run.current_step + 1}/${run.total_steps}: [${nextStep.type}] ${nextStep.content}`,
   741→      );
   742→    }
   743→  }
   744→}
   745→
   746→/**
   747→ * Register workflow commands
   748→ */
   749→export function registerWorkflowCommand(program: Command): void {
   750→  const workflow = program
   751→    .command("workflow")
   752→    .description("Manage workflow runs");
   753→
   754→  workflow
   755→    .command("start")
   756→    .description("Start a new workflow run")
   757→    .argument("<workflow-ref>", "Workflow reference (@id or @ulid)")
   758→    .option("--task <task-ref>", "Link run to a task")
   759→    .option("--json", "Output JSON")
   760→    .action(workflowStart);
   761→
   762→  workflow
   763→    .command("runs")
   764→    .description("List workflow runs")
   765→    .option("--active", "Show only active runs")
   766→    .option("--completed", "Show only completed runs")
   767→    .option("--workflow <ref>", "Filter by workflow")
   768→    .option("--json", "Output JSON")
   769→    .action(workflowRuns);
   770→
   771→  workflow
   772→    .command("show")
   773→    .description("Show workflow run details")
   774→    .argument("<run-ref>", "Run reference (@ulid or ulid prefix)")
   775→    .option("--json", "Output JSON")
   776→    .action(workflowShow);
   777→
   778→  workflow
   779→    .command("abort")
   780→    .description("Abort an active workflow run")
   781→    .argument("<run-ref>", "Run reference (@ulid or ulid prefix)")
   782→    .option("--reason <text>", "Reason for aborting")
   783→    .option("--json", "Output JSON")
   784→    .action(workflowAbort);
   785→
   786→  workflow
   787→    .command("next")
   788→    .description("Advance workflow run to next step")
   789→    .argument("[run-ref]", "Run reference (optional if only one active run)")
   790→    .option("--skip", "Mark current step as skipped")
   791→    .option("--notes <text>", "Notes for the completed step")
   792→    .option(
   793→      "--confirm",
   794→      "Acknowledge entry/exit criteria (required in strict mode)",
   795→    )
   796→    .option("--force", "Allow --skip in strict mode")
   797→    .option(
   798→      "--input <key=value>",
   799→      "Provide step input (repeatable)",
   800→      (value, previous: string[] = []) => [...previous, value],
   801→    )
   802→    .option("--json", "Output JSON")
   803→    .action(workflowNext);
   804→
   805→  workflow
   806→    .command("pause")
   807→    .description("Pause an active workflow run")
   808→    .argument("<run-ref>", "Run reference (@ulid or ulid prefix)")
   809→    .option("--json", "Output JSON")
   810→    .action(workflowPause);
   811→
   812→  workflow
   813→    .command("resume")
   814→    .description("Resume a paused workflow run")
   815→    .argument("<run-ref>", "Run reference (@ulid or ulid prefix)")
   816→    .option("--json", "Output JSON")
   817→    .action(workflowResume);
   818→}
   819→

