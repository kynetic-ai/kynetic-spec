     1	/**
     2	 * Agent Invocation Lifecycle
     3	 *
     4	 * Per-invocation session creation, ACP agent spawn, prompt delivery,
     5	 * event logging, timeout handling, and structured completion tracking.
     6	 *
     7	 * This is the core building block used by both the dispatch engine and
     8	 * CLI one-shot mode. Each invocation creates an isolated session with
     9	 * its own event log and metadata.
    10	 *
    11	 * AC: @agent-invocation-lifecycle ac-1 through ac-9
    12	 */
    13	
    14	import * as path from "node:path";
    15	import { spawnSync } from "node:child_process";
    16	import { ulid } from "ulid";
    17	import type { Agent } from "../schema/meta.js";
    18	import { buildPromptWithSkills } from "./prompts.js";
    19	import { resolveAdapter } from "../agents/adapters.js";
    20	import { spawnAndInitialize } from "../agents/spawner.js";
    21	import type { SpawnedAgent } from "../agents/spawner.js";
    22	import type { SessionUpdate } from "../acp/index.js";
    23	import {
    24	  createSession,
    25	  closeSession,
    26	  appendEvent,
    27	  injectEnvForAdapter,
    28	  removeEnvForAdapter,
    29	} from "../sessions/store.js";
    30	import type { SessionMetadata, SessionTrigger } from "../sessions/types.js";
    31	
    32	// ─── Constants ────────────────────────────────────────────────────────────────
    33	
    34	const DEFAULT_KSPEC_CLI_PATH = path.resolve(
    35	  path.dirname(new URL(import.meta.url).pathname),
    36	  "../../bin/kspec.cjs",
    37	);
    38	
    39	// ─── Types ────────────────────────────────────────────────────────────────────
    40	
    41	/**
    42	 * Options for running a single agent invocation.
    43	 */
    44	export interface InvocationOptions {
    45	  /** The agent definition describing capabilities and configuration */
    46	  agent: Agent;
    47	  /** The spec directory (.kspec/) */
    48	  specDir: string;
    49	  /** Working directory for spawned agent */
    50	  cwd: string;
    51	  /** Task reference being worked on (e.g., "@01KJP277A") */
    52	  taskRef: string;
    53	  /** The prompt to send to the agent */
    54	  prompt: string;
    55	  /** Trigger source for this invocation */
    56	  trigger: SessionTrigger;
    57	  /** Timeout in minutes (overrides agent.budget.timeout_minutes if set) */
    58	  timeoutMinutes?: number;
    59	  /** Whether to use auto-approve (yolo) args for adapter */
    60	  autoApprove?: boolean;
    61	  /** Extra environment variables for the spawned agent */
    62	  env?: Record<string, string>;
    63	  /** Called for each streaming update from the agent */
    64	  onUpdate?: (update: SessionUpdate) => void;
    65	  /** Path to kspec CLI (defaults to resolved bin/kspec.cjs) */
    66	  kspecCliPath?: string;
    67	}
    68	
    69	/**
    70	 * Result of a completed agent invocation.
    71	 */
    72	export interface InvocationResult {
    73	  /** Session that was created for this invocation */
    74	  session: SessionMetadata;
    75	  /** How the invocation ended */
    76	  outcome: "success" | "timed_out" | "failed";
    77	  /** Stop reason from ACP (e.g., "end_turn") if the invocation completed */
    78	  stopReason?: string;
    79	  /** Error message if the invocation failed */
    80	  error?: string;
    81	  /** Total duration in milliseconds */
    82	  durationMs: number;
    83	}
    84	
    85	/**
    86	 * Internal state tracked during invocation execution.
    87	 */
    88	interface InvocationState {
    89	  sessionId: string;
    90	  specDir: string;
    91	  taskRef: string;
    92	  adapterId: string;
    93	  previousEnvValue?: string | null;
    94	  agent: SpawnedAgent | null;
    95	  acpSessionId: string | null;
    96	}
    97	
    98	// ─── Helpers ──────────────────────────────────────────────────────────────────
    99	
   100	/**
   101	 * Run a kspec CLI command synchronously.
   102	 */
   103	function runKspecCli(args: string[], cwd: string, kspecCliPath: string): { stdout: string; stderr: string; status: number | null } {
   104	  const result = spawnSync(process.execPath, [kspecCliPath, ...args], {
   105	    encoding: "utf-8",
   106	    stdio: "pipe",
   107	    cwd,
   108	  });
   109	  return {
   110	    stdout: result.stdout ?? "",
   111	    stderr: result.stderr ?? "",
   112	    status: result.status,
   113	  };
   114	}
   115	
   116	/**
   117	 * Add a note to a task via kspec CLI.
   118	 */
   119	function addTaskNote(taskRef: string, note: string, cwd: string, kspecCliPath: string): void {
   120	  runKspecCli(["task", "note", taskRef, note], cwd, kspecCliPath);
   121	}
   122	
   123	/**
   124	 * Block a task via kspec CLI.
   125	 */
   126	function blockTask(taskRef: string, reason: string, cwd: string, kspecCliPath: string): void {
   127	  runKspecCli(["task", "block", taskRef, "--reason", reason], cwd, kspecCliPath);
   128	}
   129	
   130	/**
   131	 * Get the consecutive failure count for a task from its notes.
   132	 * Looks for AGENT-FAIL notes added by previous invocations.
   133	 */
   134	function getConsecutiveFailureCount(taskRef: string, cwd: string, kspecCliPath: string): number {
   135	  const result = runKspecCli(["task", "get", taskRef, "--json"], cwd, kspecCliPath);
   136	  if (result.status !== 0) return 0;
   137	
   138	  try {
   139	    const task = JSON.parse(result.stdout);
   140	    const notes: Array<{ content: string }> = task.notes ?? [];
   141	    // Count consecutive AGENT-FAIL notes from the end
   142	    let count = 0;
   143	    for (let i = notes.length - 1; i >= 0; i--) {
   144	      if (notes[i].content?.includes("[AGENT-FAIL]")) {
   145	        count++;
   146	      } else {
   147	        break;
   148	      }
   149	    }
   150	    return count;
   151	  } catch {
   152	    return 0;
   153	  }
   154	}
   155	
   156	/**
   157	 * Dispose a spawned agent, terminating the process if running.
   158	 * AC: @agent-invocation-lifecycle ac-8
   159	 */
   160	function disposeAgent(agent: SpawnedAgent | null): null {
   161	  if (agent) {
   162	    try {
   163	      agent.kill("SIGTERM");
   164	    } catch {
   165	      // Best-effort termination
   166	    }
   167	  }
   168	  return null;
   169	}
   170	
   171	// ─── Core Invocation ──────────────────────────────────────────────────────────
   172	
   173	/**
   174	 * Run a single agent invocation for a task.
   175	 *
   176	 * Creates a session, spawns the agent, injects KSPEC_SESSION_ID,
   177	 * sends the prompt, streams events, and closes the session on completion.
   178	 *
   179	 * AC: @agent-invocation-lifecycle ac-1 through ac-9
   180	 */
   181	export async function runInvocation(options: InvocationOptions): Promise<InvocationResult> {
   182	  const {
   183	    agent,
   184	    specDir,
   185	    cwd,
   186	    taskRef,
   187	    trigger,
   188	    autoApprove = agent.auto_approve,
   189	    env = {},
   190	    onUpdate,
   191	    kspecCliPath = DEFAULT_KSPEC_CLI_PATH,
   192	  } = options;
   193	
   194	  const startTime = Date.now();
   195	  const sessionId = ulid();
   196	
   197	  // Resolve adapter
   198	  const adapterId = agent.adapter ?? "claude-agent-acp";
   199	  const adapter = resolveAdapter(adapterId);
   200	
   201	  // Build extra args for auto-approve
   202	  const extraArgs = autoApprove ? (adapter.autoApproveArgs ?? []) : [];
   203	
   204	  // Resolve timeout: option overrides agent budget
   205	  const timeoutMinutes =
   206	    options.timeoutMinutes ??
   207	    agent.budget?.timeout_minutes ??
   208	    30;
   209	  const timeoutMs = timeoutMinutes * 60 * 1000;
   210	
   211	  // Resolve skill content for prompt
   212	  // AC: @agent-invocation-lifecycle ac-7
   213	  const fullPrompt = await buildPromptWithSkills({
   214	    basePrompt: options.prompt,
   215	    skillIds: agent.skills ?? [],
   216	    specDir,
   217	  });
   218	
   219	  const state: InvocationState = {
   220	    sessionId,
   221	    specDir,
   222	    taskRef,
   223	    adapterId,
   224	    previousEnvValue: undefined,
   225	    agent: null,
   226	    acpSessionId: null,
   227	  };
   228	
   229	  // ─── Create session ───────────────────────────────────────────────────────
   230	  // AC: @agent-invocation-lifecycle ac-1
   231	  const session = await createSession(specDir, {
   232	    id: sessionId,
   233	    agent_type: adapterId,
   234	    agent_id: agent.id,
   235	    trigger,
   236	    task_id: taskRef,
   237	  });
   238	
   239	  // ─── Log agent.dispatched event ───────────────────────────────────────────
   240	  await appendEvent(specDir, {
   241	    type: "agent.dispatched",
   242	    session_id: sessionId,
   243	    data: {
   244	      task_id: taskRef,
   245	      agent_id: agent.id,
   246	      adapter: adapterId,
   247	      trigger,
   248	    },
   249	  });
   250	
   251	  try {
   252	    // ─── Inject KSPEC_SESSION_ID ──────────────────────────────────────────
   253	    // AC: @agent-invocation-lifecycle ac-2
   254	    const injectionResult = await injectEnvForAdapter(adapterId, sessionId);
   255	    state.previousEnvValue = injectionResult?.previousValue;
   256	    process.env.KSPEC_SESSION_ID = sessionId;
   257	
   258	    // ─── Spawn agent ──────────────────────────────────────────────────────
   259	    state.agent = await spawnAndInitialize(adapter, {
   260	      cwd,
   261	      env: {
   262	        ...env,
   263	        KSPEC_SESSION_ID: sessionId,
   264	      },
   265	      extraArgs,
   266	    });
   267	
   268	    // ─── Create ACP session ───────────────────────────────────────────────
   269	    state.acpSessionId = await state.agent.client.newSession({
   270	      cwd,
   271	      mcpServers: [],
   272	    });
   273	
   274	    // ─── Log agent.started event ──────────────────────────────────────────
   275	    await appendEvent(specDir, {
   276	      type: "agent.started",
   277	      session_id: sessionId,
   278	      data: {
   279	        task_id: taskRef,
   280	        agent_id: agent.id,
   281	        acp_session_id: state.acpSessionId,
   282	      },
   283	    });
   284	
   285	    // ─── Register update handler ──────────────────────────────────────────
   286	    // AC: @agent-invocation-lifecycle ac-6
   287	    const updateHandler = async (acpSessionId: string, update: SessionUpdate) => {
   288	      if (acpSessionId !== state.acpSessionId) return;
   289	
   290	      // Log event to JSONL (with blob externalization from store.ts)
   291	      await appendEvent(specDir, {
   292	        type: "session.update",
   293	        session_id: sessionId,
   294	        data: update,
   295	      });
   296	
   297	      onUpdate?.(update);
   298	    };
   299	
   300	    state.agent.client.on("update", updateHandler);
   301	
   302	    // ─── Send prompt with timeout ─────────────────────────────────────────
   303	    // AC: @agent-invocation-lifecycle ac-3
   304	    const timeoutPromise = new Promise<never>((_, reject) => {
   305	      setTimeout(() => {
   306	        reject(new InvocationTimeoutError(timeoutMinutes));
   307	      }, timeoutMs);
   308	    });
   309	
   310	    const promptPromise = state.agent.client.prompt({
   311	      sessionId: state.acpSessionId,
   312	      prompt: [{ type: "text", text: fullPrompt }],
   313	    });
   314	
   315	    const promptResult = await Promise.race([promptPromise, timeoutPromise]);
   316	
   317	    // ─── Log agent.completed event ────────────────────────────────────────
   318	    // AC: @agent-invocation-lifecycle ac-4
   319	    const durationMs = Date.now() - startTime;
   320	    await appendEvent(specDir, {
   321	      type: "agent.completed",
   322	      session_id: sessionId,
   323	      data: {
   324	        task_id: taskRef,
   325	        outcome: "success",
   326	        stop_reason: promptResult.stopReason,
   327	        duration_ms: durationMs,
   328	      },
   329	    });
   330	
   331	    // ─── Close session as completed ───────────────────────────────────────
   332	    const finalSession = await closeSession(specDir, sessionId, "completed", "Invocation completed normally");
   333	
   334	    return {
   335	      session: finalSession ?? session,
   336	      outcome: "success",
   337	      stopReason: promptResult.stopReason,
   338	      durationMs,
   339	    };
   340	  } catch (err) {
   341	    const durationMs = Date.now() - startTime;
   342	
   343	    if (err instanceof InvocationTimeoutError) {
   344	      // ─── Handle timeout ──────────────────────────────────────────────
   345	      // AC: @agent-invocation-lifecycle ac-3
   346	      try {
   347	        if (state.acpSessionId && state.agent) {
   348	          await state.agent.client.cancel(state.acpSessionId);
   349	        }
   350	      } catch {
   351	        // Best-effort cancel
   352	      }
   353	
   354	      await appendEvent(specDir, {
   355	        type: "agent.timeout",
   356	        session_id: sessionId,
   357	        data: {
   358	          task_id: taskRef,
   359	          timeout_minutes: timeoutMinutes,
   360	          duration_ms: durationMs,
   361	        },
   362	      });
   363	
   364	      const finalSession = await closeSession(specDir, sessionId, "timed_out", `Timeout after ${timeoutMinutes} minutes`);
   365	
   366	      // Add timeout note to task
   367	      addTaskNote(
   368	        taskRef,
   369	        `[AGENT-TIMEOUT] Invocation timed out after ${timeoutMinutes} minutes`,
   370	        cwd,
   371	        kspecCliPath,
   372	      );
   373	
   374	      return {
   375	        session: finalSession ?? session,
   376	        outcome: "timed_out",
   377	        error: err.message,
   378	        durationMs,
   379	      };
   380	    }
   381	
   382	    // ─── Handle failure ──────────────────────────────────────────────────
   383	    // AC: @agent-invocation-lifecycle ac-5
   384	    const errorMessage = err instanceof Error ? err.message : String(err);
   385	
   386	    await appendEvent(specDir, {
   387	      type: "agent.failed",
   388	      session_id: sessionId,
   389	      data: {
   390	        task_id: taskRef,
   391	        error: errorMessage,
   392	        duration_ms: durationMs,
   393	      },
   394	    });
   395	
   396	    const finalSession = await closeSession(specDir, sessionId, "failed", `Invocation failed: ${errorMessage}`);
   397	
   398	    // Add failure note to task
   399	    addTaskNote(
   400	      taskRef,
   401	      `[AGENT-FAIL] Invocation failed: ${errorMessage}`,
   402	      cwd,
   403	      kspecCliPath,
   404	    );
   405	
   406	    // ─── Check retry threshold ────────────────────────────────────────────
   407	    // AC: @agent-invocation-lifecycle ac-9
   408	    const retryLimit = agent.budget?.max_tasks ?? 3;
   409	    const consecutiveFailures = getConsecutiveFailureCount(taskRef, cwd, kspecCliPath);
   410	
   411	    if (consecutiveFailures >= retryLimit) {
   412	      blockTask(
   413	        taskRef,
   414	        `Agent ${agent.id} failed ${consecutiveFailures} consecutive times: ${errorMessage}`,
   415	        cwd,
   416	        kspecCliPath,
   417	      );
   418	    }
   419	
   420	    return {
   421	      session: finalSession ?? session,
   422	      outcome: "failed",
   423	      error: errorMessage,
   424	      durationMs,
   425	    };
   426	  } finally {
   427	    // ─── Cleanup ──────────────────────────────────────────────────────────
   428	    // AC: @agent-invocation-lifecycle ac-8
   429	
   430	    // End ACP session
   431	    if (state.acpSessionId && state.agent) {
   432	      try {
   433	        state.agent.client.endSession(state.acpSessionId);
   434	      } catch {
   435	        // Best-effort
   436	      }
   437	    }
   438	
   439	    // Terminate agent process
   440	    state.agent = disposeAgent(state.agent);
   441	
   442	    // Restore env injection
   443	    await removeEnvForAdapter(adapterId, state.previousEnvValue);
   444	
   445	    // Restore process env
   446	    if (process.env.KSPEC_SESSION_ID === sessionId) {
   447	      delete process.env.KSPEC_SESSION_ID;
   448	    }
   449	  }
   450	}
   451	
   452	// ─── Error Types ──────────────────────────────────────────────────────────────
   453	
   454	/**
   455	 * Thrown when an invocation exceeds its configured timeout.
   456	 */
   457	export class InvocationTimeoutError extends Error {
   458	  constructor(public readonly timeoutMinutes: number) {
   459	    super(`Agent invocation timed out after ${timeoutMinutes} minutes`);
   460	    this.name = "InvocationTimeoutError";
   461	  }
   462	}