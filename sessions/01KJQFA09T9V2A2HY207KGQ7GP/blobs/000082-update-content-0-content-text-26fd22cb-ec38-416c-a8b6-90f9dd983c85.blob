   460	    const eventsPath = path.join(testDir, "sessions", result.session.id, "events.jsonl");
   461	    const content = await fs.readFile(eventsPath, "utf-8");
   462	    const lines = content.trim().split("\n").filter(Boolean);
   463	
   464	    // Should have at least agent.dispatched, agent.started, agent.completed
   465	    expect(lines.length).toBeGreaterThanOrEqual(3);
   466	    const events = lines.map((l) => JSON.parse(l));
   467	    const eventTypes = events.map((e: { type: string }) => e.type);
   468	    expect(eventTypes).toContain("agent.dispatched");
   469	    expect(eventTypes).toContain("agent.started");
   470	    expect(eventTypes).toContain("agent.completed");
   471	  });
   472	});
