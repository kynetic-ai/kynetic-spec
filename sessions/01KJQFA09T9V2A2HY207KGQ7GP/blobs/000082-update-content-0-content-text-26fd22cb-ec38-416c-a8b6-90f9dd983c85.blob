    37	const MOCK_ACP = path.join(__dirname, "mocks", "acp-mock.js");
    38	
    39	/**
    40	 * Create a minimal Agent definition for testing.
    41	 */
    42	function makeTestAgent(overrides: Partial<Agent> = {}): Agent {
    43	  return {
    44	    _ulid: testUlid("AGNT"),
    45	    id: "test-worker",
    46	    name: "Test Worker Agent",
    47	    capabilities: [],
    48	    tools: [],
    49	    conventions: [],
    50	    dispatch: [],
    51	    skills: [],
    52	    auto_approve: false,
    53	    concurrency: { max_concurrent: 1 },
    54	    adapter: "mock-acp",
    55	    ...overrides,
    56	  };
    57	}
    58	
    59	/**
    60	 * Register the mock ACP adapter for testing.
    61	 */
    62	function registerMockAdapter(env: Record<string, string> = {}): void {
    63	  registerAdapter("mock-acp", {
    64	    command: "node",
    65	    args: [MOCK_ACP],
    66	    env: {
    67	      MOCK_ACP_PROJECT_DIR: process.cwd(),
    68	      ...env,
    69	    },
    70	    description: "Mock ACP agent for testing",
    71	  });
    72	}
