    74	// ─── AC-1: Session creation with trigger, agent_id, task_id ──────────────────
    75	
    76	// AC: @agent-invocation-lifecycle ac-1
    77	describe("Session creation on invocation start", () => {
    78	  let testDir: string;
    79	
    80	  beforeEach(async () => {
    81	    testDir = await createTempDir("kspec-invoc-ac1-");
    82	    registerMockAdapter();
    83	  });
    84	
    85	  afterEach(async () => {
    86	    await cleanupTempDir(testDir);
    87	  });
    88	
    89	  it("should create session with trigger, agent_id, and task_id populated", async () => {
    90	    const agent = makeTestAgent({ id: "worker-agent" });
    91	    const taskRef = "@" + testUlid("TASK");
    92	
    93	    // Run a quick invocation (mock agent completes immediately)
    94	    const result = await runInvocation({
    95	      agent,
    96	      specDir: testDir,
    97	      cwd: process.cwd(),
    98	      taskRef,
    99	      prompt: "Test session creation",
   100	      trigger: "task.ready",
   101	    });
   102	
   103	    expect(result.session).toBeDefined();
   104	    expect(result.session.trigger).toBe("task.ready");
   105	    expect(result.session.agent_id).toBe("worker-agent");
   106	    expect(result.session.task_id).toBe(taskRef);
   107	    expect(result.session.agent_type).toBe("mock-acp");
   108	  });
   109	
   110	  it("should create session directory with session.yaml", async () => {
   111	    const agent = makeTestAgent();
   112	    const taskRef = "@" + testUlid("TASK", 1);
   113	
   114	    const result = await runInvocation({
   115	      agent,
   116	      specDir: testDir,
   117	      cwd: process.cwd(),
   118	      taskRef,
   119	      prompt: "Check session file creation",
   120	      trigger: "task.needs_work",
   121	    });
   122	
   123	    const sessionDir = path.join(testDir, "sessions", result.session.id);
   124	    const sessionYaml = path.join(sessionDir, "session.yaml");
   125	
   126	    await expect(fs.access(sessionYaml)).resolves.toBeUndefined();
   127	    const content = await fs.readFile(sessionYaml, "utf-8");
   128	    const parsed = YAML.parse(content);
   129	    expect(parsed.trigger).toBe("task.needs_work");
   130	    expect(parsed.task_id).toBe(taskRef);
   131	  });
   132	});
