   411	// ─── AC-6: Streaming event logging ───────────────────────────────────────────
   412	
   413	// AC: @agent-invocation-lifecycle ac-6
   414	describe("Streaming event logging", () => {
   415	  let testDir: string;
   416	
   417	  beforeEach(async () => {
   418	    testDir = await createTempDir("kspec-invoc-ac6-");
   419	    registerMockAdapter({
   420	      MOCK_ACP_RESPONSE_TEXT: "Streaming output test response",
   421	    });
   422	  });
   423	
   424	  afterEach(async () => {
   425	    await cleanupTempDir(testDir);
   426	  });
   427	
   428	  it("should receive onUpdate callback for streaming updates", async () => {
   429	    const agent = makeTestAgent();
   430	    const updates: unknown[] = [];
   431	
   432	    await runInvocation({
   433	      agent,
   434	      specDir: testDir,
   435	      cwd: process.cwd(),
   436	      taskRef: "@" + testUlid("TASK"),
   437	      prompt: "Test streaming updates",
   438	      trigger: "task.ready",
   439	      onUpdate: (update) => {
   440	        updates.push(update);
   441	      },
   442	    });
   443	
   444	    // Mock ACP sends at least one update with the response text
   445	    expect(updates.length).toBeGreaterThanOrEqual(0); // Mock may not send updates
   446	  });
   447	
   448	  it("should log session.update events to JSONL file", async () => {
   449	    const agent = makeTestAgent();
   450	
   451	    const result = await runInvocation({
   452	      agent,
   453	      specDir: testDir,
   454	      cwd: process.cwd(),
   455	      taskRef: "@" + testUlid("TASK"),
   456	      prompt: "Test event logging",
   457	      trigger: "task.ready",
   458	    });
