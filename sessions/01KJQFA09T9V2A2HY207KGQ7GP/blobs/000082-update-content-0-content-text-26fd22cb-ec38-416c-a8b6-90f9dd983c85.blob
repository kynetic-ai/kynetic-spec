   204	// ─── AC-3: Timeout handling ───────────────────────────────────────────────────
   205	
   206	// AC: @agent-invocation-lifecycle ac-3
   207	describe("Timeout handling", () => {
   208	  let testDir: string;
   209	
   210	  beforeEach(async () => {
   211	    testDir = await createTempDir("kspec-invoc-ac3-");
   212	
   213	    // Register a slow adapter that delays response
   214	    registerAdapter("slow-mock-acp", {
   215	      command: "node",
   216	      args: [MOCK_ACP],
   217	      env: {
   218	        MOCK_ACP_DELAY_MS: "5000", // 5 second delay
   219	      },
   220	      description: "Slow mock ACP agent for timeout tests",
   221	    });
   222	  });
   223	
   224	  afterEach(async () => {
   225	    await cleanupTempDir(testDir);
   226	  });
   227	
   228	  it("should close session as timed_out when timeout is reached", async () => {
   229	    const agent = makeTestAgent({ adapter: "slow-mock-acp" });
   230	
   231	    const result = await runInvocation({
   232	      agent,
   233	      specDir: testDir,
   234	      cwd: process.cwd(),
   235	      taskRef: "@" + testUlid("TASK"),
   236	      prompt: "Test timeout",
   237	      trigger: "task.ready",
   238	      timeoutMinutes: 0.001, // ~60ms timeout — much less than 5s delay
   239	    });
   240	
   241	    expect(result.outcome).toBe("timed_out");
   242	    expect(result.session.status).toBe("timed_out");
   243	  });
   244	
   245	  it("should log agent.timeout event when timeout occurs", async () => {
   246	    const agent = makeTestAgent({ adapter: "slow-mock-acp" });
   247	
   248	    const result = await runInvocation({
   249	      agent,
   250	      specDir: testDir,
   251	      cwd: process.cwd(),
   252	      taskRef: "@" + testUlid("TASK"),
   253	      prompt: "Test timeout event logging",
   254	      trigger: "task.ready",
   255	      timeoutMinutes: 0.001,
   256	    });
   257	
   258	    // Read the events.jsonl
   259	    const eventsPath = path.join(testDir, "sessions", result.session.id, "events.jsonl");
   260	    const content = await fs.readFile(eventsPath, "utf-8");
   261	    const events = content.trim().split("\n").filter(Boolean).map((l) => JSON.parse(l));
   262	
   263	    const timeoutEvent = events.find((e: { type: string }) => e.type === "agent.timeout");
   264	    expect(timeoutEvent).toBeDefined();
   265	    expect(timeoutEvent.data.task_id).toBeDefined();
   266	    expect(timeoutEvent.data.timeout_minutes).toBeDefined();
   267	  });
   268	});
