   550	// ─── AC-8: Cleanup on completion or failure ───────────────────────────────────
   551	
   552	// AC: @agent-invocation-lifecycle ac-8
   553	describe("Cleanup on completion or failure", () => {
   554	  let testDir: string;
   555	
   556	  beforeEach(async () => {
   557	    testDir = await createTempDir("kspec-invoc-ac8-");
   558	    registerMockAdapter();
   559	  });
   560	
   561	  afterEach(async () => {
   562	    await cleanupTempDir(testDir);
   563	  });
   564	
   565	  it("should terminate agent process after successful completion", async () => {
   566	    const agent = makeTestAgent();
   567	
   568	    // If the agent process isn't terminated, the test would hang or
   569	    // leave zombie processes. The fact that runInvocation returns is
   570	    // evidence that the process was managed correctly.
   571	    const result = await runInvocation({
   572	      agent,
   573	      specDir: testDir,
   574	      cwd: process.cwd(),
   575	      taskRef: "@" + testUlid("TASK"),
   576	      prompt: "Test cleanup on success",
   577	      trigger: "task.ready",
   578	    });
   579	
   580	    expect(result.outcome).toBe("success");
   581	    // If we reach here without hanging, cleanup worked
   582	  });
   583	
   584	  it("should restore KSPEC_SESSION_ID env after invocation", async () => {
   585	    const agent = makeTestAgent();
   586	    const originalValue = process.env.KSPEC_SESSION_ID;
   587	
   588	    await runInvocation({
   589	      agent,
   590	      specDir: testDir,
   591	      cwd: process.cwd(),
   592	      taskRef: "@" + testUlid("TASK"),
   593	      prompt: "Test env restoration",
   594	      trigger: "task.ready",
   595	    });
   596	
   597	    // After invocation, env should be back to original
   598	    // (either undefined or the original value)
   599	    expect(process.env.KSPEC_SESSION_ID).toBe(originalValue);
   600	  });
   601	
