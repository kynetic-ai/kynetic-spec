```
     1→/**
     2→ * Task API Routes
     3→ *
     4→ * REST endpoints for task operations:
     5→ * - GET /api/tasks - list with filters and pagination
     6→ * - GET /api/tasks/:ref - get single task
     7→ * - POST /api/tasks/:ref/start - start task
     8→ * - POST /api/tasks/:ref/note - add note
     9→ *
    10→ * AC Coverage:
    11→ * - ac-2: GET /api/tasks returns array with status, priority, spec_ref, notes count
    12→ * - ac-3: Status filter with multi-value support
    13→ * - ac-4: Pagination with {items, total, offset, limit} wrapper
    14→ * - ac-5: GET /api/tasks/:ref resolves via ReferenceIndex
    15→ * - ac-6: POST /api/tasks/:ref/start transitions state
    16→ * - ac-7: POST /api/tasks/:ref/note appends note
    17→ * - @ui-task-board ac-6: POST /api/tasks/:ref/submit transitions to pending_review
    18→ * - @ui-task-board ac-6: POST /api/tasks/:ref/complete transitions to completed
    19→ * - @ui-task-board ac-6: POST /api/tasks/:ref/block transitions to blocked
    20→ */
    21→
    22→import { Elysia, t } from 'elysia';
    23→import {
    24→  initContext,
    25→  loadAllTasks,
    26→  loadAllItems,
    27→  loadPlans,
    28→  ReferenceIndex,
    29→  createNote,
    30→  saveTask,
    31→  getAuthor,
    32→  syncSpecImplementationStatus,
    33→  type LoadedTask,
    34→} from '../../parser/index.js';
    35→import { commitIfShadow } from '../../parser/shadow.js';
    36→import type { PubSubManager } from '../websocket/pubsub';
    37→
    38→interface TasksRouteOptions {
    39→  pubsub: PubSubManager;
    40→}
    41→
    42→export function createTasksRoutes(options: TasksRouteOptions) {
    43→  const { pubsub } = options;
    44→
    45→  return new Elysia({ prefix: '/api/tasks' })
    46→    // AC: @api-contract ac-2, ac-3, ac-4 - List tasks with filters and pagination
    47→    .get(
    48→      '/',
    49→      async ({ query, projectContext }) => {
    50→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
    51→        const ctx = await initContext(projectContext.path);
    52→        const tasks = await loadAllTasks(ctx);
    53→        const specItems = await loadAllItems(ctx);
    54→        const index = new ReferenceIndex(tasks, specItems);
    55→
    56→        // Apply filters
    57→        let filtered = tasks;
    58→
    59→        // AC: @api-contract ac-3 - Multi-value status filter
    60→        if (query.status) {
    61→          const statusFilters = Array.isArray(query.status) ? query.status : [query.status];
    62→          filtered = filtered.filter((task) => statusFilters.includes(task.status));
    63→        }
    64→
    65→        // Type filter (optional, not in ACs but useful)
    66→        if (query.type) {
    67→          const typeFilters = Array.isArray(query.type) ? query.type : [query.type];
    68→          filtered = filtered.filter((task) => task.type && typeFilters.includes(task.type));
    69→        }
    70→
    71→        // Tag filter (optional, not in ACs but useful)
    72→        if (query.tag) {
    73→          const tagFilters = Array.isArray(query.tag) ? query.tag : [query.tag];
    74→          filtered = filtered.filter((task) =>
    75→            task.tags?.some((t) => tagFilters.includes(t))
    76→          );
    77→        }
    78→
    79→        // Automation filter — filter by automation eligibility status
    80→        if (query.automation) {
    81→          filtered = filtered.filter((task) => task.automation === query.automation);
    82→        }
    83→
    84→        // Plan filter — show only tasks derived from a given plan
    85→        if (query.plan) {
    86→          const plans = await loadPlans(ctx);
    87→          const plan = plans.find(
    88→            (p) => p._ulid === query.plan || p.slugs.includes(query.plan!)
    89→          );
    90→          if (plan) {
    91→            const derivedRefs = new Set(
    92→              plan.derived_tasks.map((r) => (r.startsWith('@') ? r.slice(1) : r))
    93→            );
    94→            filtered = filtered.filter(
    95→              (task) =>
    96→                derivedRefs.has(task._ulid) ||
    97→                task.slugs.some((s) => derivedRefs.has(s))
    98→            );
    99→          } else {
   100→            filtered = [];
   101→          }
   102→        }
   103→
   104→        // AC: @api-contract ac-4 - Pagination
   105→        const total = filtered.length;
   106→        const offset = Number(query.offset) || 0;
   107→        const limit = Number(query.limit) || total;
   108→
   109→        const paginated = filtered.slice(offset, offset + limit);
   110→
   111→        // AC: @api-contract ac-2 - Return with status, priority, spec_ref, notes count
   112→        // AC: @web-dashboard ac-1 - Include depends_on for blocked task computation
   113→        const items = paginated.map((task) => ({
   114→          _ulid: task._ulid,
   115→          slugs: task.slugs,
   116→          title: task.title,
   117→          type: task.type || 'task',
   118→          status: task.status,
   119→          priority: task.priority,
   120→          spec_ref: task.spec_ref,
   121→          meta_ref: task.meta_ref,
   122→          tags: task.tags,
   123→          depends_on: task.depends_on || [],
   124→          automation: task.automation,
   125→          notes_count: task.notes?.length || 0,
   126→          todos_count: task.todos?.length || 0,
   127→          started_at: task.started_at,
   128→          completed_at: task.completed_at,
   129→          created_at: task.created_at,
   130→        }));
   131→
   132→        // AC: @api-contract ac-4, @trait-api-endpoint ac-4 - Return pagination wrapper
   133→        return {
   134→          items,
   135→          total,
   136→          offset,
   137→          limit,
   138→        };
   139→      },
   140→      {
   141→        query: t.Object({
   142→          status: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   143→          type: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   144→          tag: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   145→          automation: t.Optional(t.String()),
   146→          plan: t.Optional(t.String()),
   147→          limit: t.Optional(t.String()),
   148→          offset: t.Optional(t.String()),
   149→        }),
   150→      }
   151→    )
   152→
   153→    // AC: @api-contract ac-5 - Get single task by ref
   154→    .get(
   155→      '/:ref',
   156→      async ({ params, error: errorResponse, projectContext }) => {
   157→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   158→        const ctx = await initContext(projectContext.path);
   159→        const tasks = await loadAllTasks(ctx);
   160→        const items = await loadAllItems(ctx);
   161→        const index = new ReferenceIndex(tasks, items);
   162→
   163→        // AC: @api-contract ac-5, @trait-api-endpoint ac-2 - Resolve ref via ReferenceIndex
   164→        const result = index.resolve(params.ref);
   165→
   166→        if (!result.ok) {
   167→          // AC: @trait-api-endpoint ac-2 - Return 404 with error details
   168→          return errorResponse(404, {
   169→            error: 'not_found',
   170→            message: `Task reference "${params.ref}" not found`,
   171→            suggestion: 'Use kspec task list or kspec search to find valid task references',
   172→          });
   173→        }
   174→
   175→        // Find the task
   176→        const task = tasks.find((t) => t._ulid === result.ulid);
   177→        if (!task) {
   178→          return errorResponse(404, {
   179→            error: 'not_found',
   180→            message: `Reference "${params.ref}" is not a task`,
   181→            suggestion: 'This reference might point to a spec item instead',
   182→          });
   183→        }
   184→
   185→        // AC: @api-contract ac-5 - Return full task with notes, todos, dependencies
   186→        // AC: @ui-task-board ac-3 - Include type, description, blocked_by, vcs_refs, plan_ref, session_ref
   187→        return {
   188→          _ulid: task._ulid,
   189→          slugs: task.slugs,
   190→          title: task.title,
   191→          type: task.type || 'task',
   192→          status: task.status,
   193→          priority: task.priority,
   194→          spec_ref: task.spec_ref,
   195→          meta_ref: task.meta_ref,
   196→          tags: task.tags,
   197→          description: task.description,
   198→          derivation: task.derivation,
   199→          depends_on: task.depends_on,
   200→          blocked_by: task.blocked_by || [],
   201→          context: task.context || [],
   202→          vcs_refs: (task.vcs_refs || []).map((v) =>
   203→            typeof v === 'string' ? v : v.type ? `${v.type}:${v.ref}` : v.ref
   204→          ),
   205→          plan_ref: task.plan_ref,
   206→          session_ref: task.session_id,
   207→          notes: task.notes,
   208→          notes_count: task.notes?.length || 0,
   209→          todos: task.todos,
   210→          todos_count: task.todos?.length || 0,
   211→          started_at: task.started_at,
   212→          completed_at: task.completed_at,
   213→          cancelled_at: task.cancelled_at,
   214→          closed_reason: task.closed_reason,
   215→          automation: task.automation,
   216→          created_at: task.created_at,
   217→        };
   218→      },
   219→      {
   220→        params: t.Object({
   221→          ref: t.String(),
   222→        }),
   223→      }
   224→    )
   225→
   226→    // AC: @api-contract ac-6 - Start task
   227→    .post(
   228→      '/:ref/start',
   229→      async ({ params, error: errorResponse, projectContext }) => {
   230→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   231→        const ctx = await initContext(projectContext.path);
   232→        const tasks = await loadAllTasks(ctx);
   233→        const items = await loadAllItems(ctx);
   234→        const index = new ReferenceIndex(tasks, items);
   235→
   236→        // Resolve ref
   237→        const result = index.resolve(params.ref);
   238→        if (!result.ok) {
   239→          return errorResponse(404, {
   240→            error: 'not_found',
   241→            message: `Task reference "${params.ref}" not found`,
   242→            suggestion: 'Use kspec task list to find valid task references',
   243→          });
   244→        }
   245→
   246→        const task = tasks.find((t) => t._ulid === result.ulid);
   247→        if (!task) {
   248→          return errorResponse(404, {
   249→            error: 'not_found',
   250→            message: `Reference "${params.ref}" is not a task`,
   251→          });
   252→        }
   253→
   254→        // AC: @api-contract ac-6 - Transition to in_progress
   255→        if (task.status === 'in_progress') {
   256→          return errorResponse(409, {
   257→            error: 'invalid_transition',
   258→            message: 'Task is already in_progress',
   259→            current: task.status,
   260→            valid_transitions: ['blocked', 'pending_review', 'completed', 'cancelled'],
   261→          });
   262→        }
   263→
   264→        // Update task status
   265→        const updatedTask: LoadedTask = {
   266→          ...task,
   267→          status: 'in_progress',
   268→          started_at: task.started_at || new Date().toISOString(),
   269→        };
   270→
   271→        // Save and commit
   272→        await saveTask(ctx, updatedTask);
   273→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   274→        await commitIfShadow(ctx.shadow, `task: start ${params.ref}`);
   275→
   276→        // AC: @api-contract ac-6, @trait-api-endpoint ac-5 - WebSocket broadcast
   277→        // AC: @multi-directory-daemon ac-18 - Broadcast scoped to request project
   278→        pubsub.broadcast('tasks:updates', 'task_updated', {
   279→          ref: params.ref,
   280→          ulid: task._ulid,
   281→          action: 'start',
   282→          status: 'in_progress',
   283→        }, projectContext.path);
   284→
   285→        // AC: @api-contract ac-6 - Return updated task
   286→        return updatedTask;
   287→      },
   288→      {
   289→        params: t.Object({
   290→          ref: t.String(),
   291→        }),
   292→      }
   293→    )
   294→
   295→    // AC: @api-contract ac-7 - Add note to task
   296→    .post(
   297→      '/:ref/note',
   298→      async ({ params, body, error: errorResponse, projectContext }) => {
   299→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   300→        const ctx = await initContext(projectContext.path);
   301→        const tasks = await loadAllTasks(ctx);
   302→        const items = await loadAllItems(ctx);
   303→        const index = new ReferenceIndex(tasks, items);
   304→
   305→        // Resolve ref
   306→        const result = index.resolve(params.ref);
   307→        if (!result.ok) {
   308→          return errorResponse(404, {
   309→            error: 'not_found',
   310→            message: `Task reference "${params.ref}" not found`,
   311→          });
   312→        }
   313→
   314→        const task = tasks.find((t) => t._ulid === result.ulid);
   315→        if (!task) {
   316→          return errorResponse(404, {
   317→            error: 'not_found',
   318→            message: `Reference "${params.ref}" is not a task`,
   319→          });
   320→        }
   321→
   322→        // AC: @trait-api-endpoint ac-3 - Validate body
   323→        if (!body.content || typeof body.content !== 'string') {
   324→          return errorResponse(400, {
   325→            error: 'validation_error',
   326→            details: [
   327→              {
   328→                field: 'content',
   329→                message: 'Content is required and must be a string',
   330→              },
   331→            ],
   332→          });
   333→        }
   334→
   335→        // AC: @api-contract ac-7 - Append note
   336→        const author = getAuthor(ctx.config?.identity?.author);
   337→        const note = createNote(body.content, author);
   338→
   339→        const updatedTask: LoadedTask = {
   340→          ...task,
   341→          notes: [...(task.notes || []), note],
   342→        };
   343→
   344→        // AC: @api-contract ac-7, @trait-api-endpoint ac-5 - Shadow commit
   345→        await saveTask(ctx, updatedTask);
   346→        await commitIfShadow(ctx.shadow, `task: add note to ${params.ref}`);
   347→
   348→        // AC: @api-contract ac-7 - WebSocket broadcast
   349→        // AC: @multi-directory-daemon ac-18 - Broadcast scoped to request project
   350→        pubsub.broadcast('tasks:updates', 'task_updated', {
   351→          ref: params.ref,
   352→          ulid: task._ulid,
   353→          action: 'note_added',
   354→          note_ulid: note._ulid,
   355→        }, projectContext.path);
   356→
   357→        return {
   358→          success: true,
   359→          note,
   360→          task: updatedTask,
   361→        };
   362→      },
   363→      {
   364→        params: t.Object({
   365→          ref: t.String(),
   366→        }),
   367→        body: t.Object({
   368→          content: t.String(),
   369→        }),
   370→      }
   371→    )
   372→
   373→    // AC: @ui-task-board ac-6 - Submit task for review
   374→    .post(
   375→      '/:ref/submit',
   376→      async ({ params, error: errorResponse, projectContext }) => {
   377→        const ctx = await initContext(projectContext.path);
   378→        const tasks = await loadAllTasks(ctx);
   379→        const items = await loadAllItems(ctx);
   380→        const index = new ReferenceIndex(tasks, items);
   381→
   382→        const result = index.resolve(params.ref);
   383→        if (!result.ok) {
   384→          return errorResponse(404, {
   385→            error: 'not_found',
   386→            message: `Task reference "${params.ref}" not found`,
   387→          });
   388→        }
   389→
   390→        const task = tasks.find((t) => t._ulid === result.ulid);
   391→        if (!task) {
   392→          return errorResponse(404, {
   393→            error: 'not_found',
   394→            message: `Reference "${params.ref}" is not a task`,
   395→          });
   396→        }
   397→
   398→        if (task.status !== 'in_progress' && task.status !== 'needs_work') {
   399→          return errorResponse(409, {
   400→            error: 'invalid_transition',
   401→            message: `Cannot submit task with status "${task.status}". Must be in_progress or needs_work.`,
   402→            current: task.status,
   403→            valid_transitions: ['pending_review'],
   404→          });
   405→        }
   406→
   407→        const updatedTask: LoadedTask = { ...task, status: 'pending_review' };
   408→        await saveTask(ctx, updatedTask);
   409→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   410→        await commitIfShadow(ctx.shadow, `task: submit ${params.ref}`);
   411→
   412→        pubsub.broadcast('tasks:updates', 'task_updated', {
   413→          ref: params.ref,
   414→          ulid: task._ulid,
   415→          action: 'submit',
   416→          status: 'pending_review',
   417→        }, projectContext.path);
   418→
   419→        return updatedTask;
   420→      },
   421→      { params: t.Object({ ref: t.String() }) }
   422→    )
   423→
   424→    // AC: @ui-task-board ac-6 - Complete task
   425→    .post(
   426→      '/:ref/complete',
   427→      async ({ params, body, error: errorResponse, projectContext }) => {
   428→        const ctx = await initContext(projectContext.path);
   429→        const tasks = await loadAllTasks(ctx);
   430→        const items = await loadAllItems(ctx);
   431→        const index = new ReferenceIndex(tasks, items);
   432→
   433→        const result = index.resolve(params.ref);
   434→        if (!result.ok) {
   435→          return errorResponse(404, {
   436→            error: 'not_found',
   437→            message: `Task reference "${params.ref}" not found`,
   438→          });
   439→        }
   440→
   441→        const task = tasks.find((t) => t._ulid === result.ulid);
   442→        if (!task) {
   443→          return errorResponse(404, {
   444→            error: 'not_found',
   445→            message: `Reference "${params.ref}" is not a task`,
   446→          });
   447→        }
   448→
   449→        const updatedTask: LoadedTask = {
   450→          ...task,
   451→          status: 'completed',
   452→          completed_at: new Date().toISOString(),
   453→          closed_reason: body.reason,
   454→        };
   455→        await saveTask(ctx, updatedTask);
   456→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   457→        await commitIfShadow(ctx.shadow, `task: complete ${params.ref}`);
   458→
   459→        pubsub.broadcast('tasks:updates', 'task_updated', {
   460→          ref: params.ref,
   461→          ulid: task._ulid,
   462→          action: 'complete',
   463→          status: 'completed',
   464→        }, projectContext.path);
   465→
   466→        return updatedTask;
   467→      },
   468→      {
   469→        params: t.Object({ ref: t.String() }),
   470→        body: t.Object({ reason: t.String() }),
   471→      }
   472→    )
   473→
   474→    // AC: @ui-task-board ac-6 - Block task
   475→    .post(
   476→      '/:ref/block',
   477→      async ({ params, body, error: errorResponse, projectContext }) => {
   478→        const ctx = await initContext(projectContext.path);
   479→        const tasks = await loadAllTasks(ctx);
   480→        const items = await loadAllItems(ctx);
   481→        const index = new ReferenceIndex(tasks, items);
   482→
   483→        const result = index.resolve(params.ref);
   484→        if (!result.ok) {
   485→          return errorResponse(404, {
   486→            error: 'not_found',
   487→            message: `Task reference "${params.ref}" not found`,
   488→          });
   489→        }
   490→
   491→        const task = tasks.find((t) => t._ulid === result.ulid);
   492→        if (!task) {
   493→          return errorResponse(404, {
   494→            error: 'not_found',
   495→            message: `Reference "${params.ref}" is not a task`,
   496→          });
   497→        }
   498→
   499→        const author = getAuthor(ctx.config?.identity?.author);
   500→        const note = createNote(`Blocked: ${body.reason}`, author);
   501→
   502→        const updatedTask: LoadedTask = {
   503→          ...task,
   504→          status: 'blocked',
   505→          notes: [...(task.notes || []), note],
   506→        };
   507→        await saveTask(ctx, updatedTask);
   508→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   509→        await commitIfShadow(ctx.shadow, `task: block ${params.ref}`);
   510→
   511→        pubsub.broadcast('tasks:updates', 'task_updated', {
   512→          ref: params.ref,
   513→          ulid: task._ulid,
   514→          action: 'block',
   515→          status: 'blocked',
   516→        }, projectContext.path);
   517→
   518→        return updatedTask;
   519→      },
   520→      {
   521→        params: t.Object({ ref: t.String() }),
   522→        body: t.Object({ reason: t.String() }),
   523→      }
   524→    );
   525→}
   526→
```