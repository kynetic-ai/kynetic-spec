```
     1→/**
     2→ * Meta manifest loading and operations.
     3→ *
     4→ * The meta manifest (kynetic.meta.yaml) contains process definitions:
     5→ * - Agents: roles, capabilities, conventions
     6→ * - Workflows: structured processes with steps
     7→ * - Conventions: project rules and standards
     8→ * - Observations: feedback about processes
     9→ */
    10→
    11→import * as fs from "node:fs/promises";
    12→import type { Dirent } from "node:fs";
    13→import * as path from "node:path";
    14→import { ulid } from "ulid";
    15→import { accessBufferAware, readdirBufferAware } from "../cli/batch-write-buffer.js";
    16→import {
    17→  type Agent,
    18→  AgentSchema,
    19→  type Convention,
    20→  ConventionSchema,
    21→  getMetaItemType,
    22→  isSkill,
    23→  type MetaItem,
    24→  type MetaManifest,
    25→  MetaManifestSchema,
    26→  type Observation,
    27→  ObservationSchema,
    28→  type ObservationType,
    29→  type SessionContext,
    30→  SessionContextSchema,
    31→  type Skill,
    32→  SkillSchema,
    33→  type Workflow,
    34→  type WorkflowRun,
    35→  type WorkflowRunsFile,
    36→  WorkflowRunsFileSchema,
    37→  WorkflowSchema,
    38→} from "../schema/index.js";
    39→import type { KspecContext } from "./yaml.js";
    40→import {
    41→  expandIncludePattern,
    42→  getAuthor,
    43→  readFileBufferAware,
    44→  readYamlFile,
    45→  writeYamlFilePreserveFormat,
    46→} from "./yaml.js";
    47→
    48→/**
    49→ * Loaded agent with runtime metadata
    50→ */
    51→export interface LoadedAgent extends Agent {
    52→  _sourceFile?: string;
    53→}
    54→
    55→/**
    56→ * Loaded workflow with runtime metadata
    57→ */
    58→export interface LoadedWorkflow extends Workflow {
    59→  _sourceFile?: string;
    60→}
    61→
    62→/**
    63→ * Loaded convention with runtime metadata
    64→ */
    65→export interface LoadedConvention extends Convention {
    66→  _sourceFile?: string;
    67→}
    68→
    69→/**
    70→ * Loaded observation with runtime metadata
    71→ */
    72→export interface LoadedObservation extends Observation {
    73→  _sourceFile?: string;
    74→}
    75→
    76→/**
    77→ * Loaded skill with runtime metadata
    78→ */
    79→export interface LoadedSkill extends Skill {
    80→  _sourceFile?: string;
    81→}
    82→
    83→/**
    84→ * Any loaded meta item
    85→ */
    86→export type LoadedMetaItem =
    87→  | LoadedAgent
    88→  | LoadedWorkflow
    89→  | LoadedConvention
    90→  | LoadedObservation
    91→  | LoadedSkill;
    92→
    93→/**
    94→ * Meta context containing all loaded meta items
    95→ */
    96→export interface MetaContext {
    97→  manifest: MetaManifest | null;
    98→  manifestPath: string | null;
    99→  agents: LoadedAgent[];
   100→  workflows: LoadedWorkflow[];
   101→  conventions: LoadedConvention[];
   102→  observations: LoadedObservation[];
   103→  skills: LoadedSkill[];
   104→}
   105→
   106→/**
   107→ * Find the meta manifest file.
   108→ *
   109→ * Discovery algorithm:
   110→ * 1. Check for explicit name: kynetic.meta.yaml (backward compat)
   111→ * 2. If not found, scan directory for *.meta.yaml files
   112→ * 3. For each candidate, validate it contains a 'kynetic_meta:' version field
   113→ * 4. Return first valid match (alphabetically after explicit name)
   114→ *
   115→ * AC: @meta-manifest-discovery ac-1, ac-2, ac-3
   116→ */
   117→export async function findMetaManifest(
   118→  specDir: string,
   119→): Promise<string | null> {
   120→  // AC: @meta-manifest-discovery ac-1, ac-3 - explicit name has priority
   121→  const priorityPath = path.join(specDir, "kynetic.meta.yaml");
   122→  try {
   123→    await accessBufferAware(priorityPath);
   124→    return priorityPath;
   125→  } catch {
   126→    // Continue to glob fallback
   127→  }
   128→
   129→  // AC: @meta-manifest-discovery ac-2, ac-3 - glob fallback with validation
   130→  try {
   131→    const entries = await readdirBufferAware(specDir) as string[];
   132→    // AC: @meta-manifest-discovery ac-3 - alphabetical order
   133→    const candidates = entries
   134→      .filter((f) => f.endsWith(".meta.yaml"))
   135→      .sort();
   136→
   137→    for (const candidate of candidates) {
   138→      const filePath = path.join(specDir, candidate);
   139→      try {
   140→        const raw = await readYamlFile<unknown>(filePath);
   141→        // AC: @meta-manifest-discovery ac-2 - validate kynetic_meta version field
   142→        if (raw && typeof raw === "object" && "kynetic_meta" in raw) {
   143→          return filePath;
   144→        }
   145→      } catch {
   146→        // Skip invalid files
   147→      }
   148→    }
   149→  } catch {
   150→    // Directory read failed
   151→  }
   152→
   153→  return null;
   154→}
   155→
   156→/**
   157→ * Get the base name (slug) from a manifest path.
   158→ * E.g., "kynetic.yaml" -> "kynetic", "myproject.spec.yaml" -> "myproject"
   159→ */
   160→function getManifestBaseName(manifestPath: string | null): string {
   161→  if (!manifestPath) return "kynetic";
   162→  const fileName = path.basename(manifestPath);
   163→  // Remove .yaml extension
   164→  let baseName = fileName.replace(/\.yaml$/, "");
   165→  // Remove .spec suffix if present
   166→  baseName = baseName.replace(/\.spec$/, "");
   167→  return baseName || "kynetic";
   168→}
   169→
   170→/**
   171→ * Get the meta manifest file path.
   172→ * Derives from main manifest name (e.g., myproject.yaml -> myproject.meta.yaml)
   173→ * Returns path even if file doesn't exist yet.
   174→ */
   175→export function getMetaManifestPath(ctx: KspecContext): string {
   176→  const baseName = getManifestBaseName(ctx.manifestPath);
   177→  return path.join(ctx.specDir, `${baseName}.meta.yaml`);
   178→}
   179→
   180→/**
   181→ * Load meta items from a single file.
   182→ */
   183→async function loadMetaFile(filePath: string): Promise<{
   184→  agents: LoadedAgent[];
   185→  workflows: LoadedWorkflow[];
   186→  conventions: LoadedConvention[];
   187→  observations: LoadedObservation[];
   188→  skills: LoadedSkill[];
   189→}> {
   190→  const result: {
   191→    agents: LoadedAgent[];
   192→    workflows: LoadedWorkflow[];
   193→    conventions: LoadedConvention[];
   194→    observations: LoadedObservation[];
   195→    skills: LoadedSkill[];
   196→  } = {
   197→    agents: [],
   198→    workflows: [],
   199→    conventions: [],
   200→    observations: [],
   201→    skills: [],
   202→  };
   203→
   204→  try {
   205→    const raw = await readYamlFile<unknown>(filePath);
   206→    if (!raw || typeof raw !== "object") {
   207→      return result;
   208→    }
   209→
   210→    const obj = raw as Record<string, unknown>;
   211→
   212→    // Parse agents
   213→    if (Array.isArray(obj.agents)) {
   214→      for (const agent of obj.agents) {
   215→        const parsed = AgentSchema.safeParse(agent);
   216→        if (parsed.success) {
   217→          result.agents.push({ ...parsed.data, _sourceFile: filePath });
   218→        }
   219→      }
   220→    }
   221→
   222→    // Parse workflows
   223→    if (Array.isArray(obj.workflows)) {
   224→      for (const workflow of obj.workflows) {
   225→        const parsed = WorkflowSchema.safeParse(workflow);
   226→        if (parsed.success) {
   227→          result.workflows.push({ ...parsed.data, _sourceFile: filePath });
   228→        }
   229→      }
   230→    }
   231→
   232→    // Parse conventions
   233→    if (Array.isArray(obj.conventions)) {
   234→      for (const convention of obj.conventions) {
   235→        const parsed = ConventionSchema.safeParse(convention);
   236→        if (parsed.success) {
   237→          result.conventions.push({ ...parsed.data, _sourceFile: filePath });
   238→        }
   239→      }
   240→    }
   241→
   242→    // Parse observations
   243→    if (Array.isArray(obj.observations)) {
   244→      for (const observation of obj.observations) {
   245→        const parsed = ObservationSchema.safeParse(observation);
   246→        if (parsed.success) {
   247→          result.observations.push({ ...parsed.data, _sourceFile: filePath });
   248→        }
   249→      }
   250→    }
   251→
   252→    // Parse skills
   253→    // AC: @skill-meta-type ac-4 - skills loaded with _sourceFile set
   254→    if (Array.isArray(obj.skills)) {
   255→      for (const skill of obj.skills) {
   256→        const parsed = SkillSchema.safeParse(skill);
   257→        if (parsed.success) {
   258→          result.skills.push({ ...parsed.data, _sourceFile: filePath });
   259→        }
   260→      }
   261→    }
   262→  } catch {
   263→    // File doesn't exist or parse error
   264→  }
   265→
   266→  return result;
   267→}
   268→
   269→/**
   270→ * Load the meta context from a kspec context.
   271→ * Loads meta manifest and follows includes.
   272→ * AC: @skill-meta-type ac-4 - MetaContext.skills contains LoadedSkill objects with _sourceFile set
   273→ */
   274→export async function loadMetaContext(ctx: KspecContext): Promise<MetaContext> {
   275→  const result: MetaContext = {
   276→    manifest: null,
   277→    manifestPath: null,
   278→    agents: [],
   279→    workflows: [],
   280→    conventions: [],
   281→    observations: [],
   282→    skills: [],
   283→  };
   284→
   285→  const manifestPath = await findMetaManifest(ctx.specDir);
   286→  if (!manifestPath) {
   287→    return result;
   288→  }
   289→
   290→  result.manifestPath = manifestPath;
   291→
   292→  try {
   293→    const raw = await readYamlFile<unknown>(manifestPath);
   294→    const parsed = MetaManifestSchema.safeParse(raw);
   295→    if (!parsed.success) {
   296→      // Invalid manifest, but we can still try to extract items
   297→      const items = await loadMetaFile(manifestPath);
   298→      result.agents.push(...items.agents);
   299→      result.workflows.push(...items.workflows);
   300→      result.conventions.push(...items.conventions);
   301→      result.observations.push(...items.observations);
   302→      result.skills.push(...items.skills);
   303→      return result;
   304→    }
   305→
   306→    result.manifest = parsed.data;
   307→
   308→    // Load items from manifest
   309→    const manifestItems = await loadMetaFile(manifestPath);
   310→    result.agents.push(...manifestItems.agents);
   311→    result.workflows.push(...manifestItems.workflows);
   312→    result.conventions.push(...manifestItems.conventions);
   313→    result.observations.push(...manifestItems.observations);
   314→    result.skills.push(...manifestItems.skills);
   315→
   316→    // Process includes
   317→    const includes = parsed.data.includes || [];
   318→    const manifestDir = path.dirname(manifestPath);
   319→
   320→    for (const include of includes) {
   321→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   322→
   323→      for (const filePath of expandedPaths) {
   324→        const items = await loadMetaFile(filePath);
   325→        result.agents.push(...items.agents);
   326→        result.workflows.push(...items.workflows);
   327→        result.conventions.push(...items.conventions);
   328→        result.observations.push(...items.observations);
   329→        result.skills.push(...items.skills);
   330→      }
   331→    }
   332→  } catch {
   333→    // Manifest exists but may be invalid
   334→  }
   335→
   336→  return result;
   337→}
   338→
   339→/**
   340→ * Get meta stats summary
   341→ */
   342→export function getMetaStats(meta: MetaContext): {
   343→  agents: number;
   344→  workflows: number;
   345→  conventions: number;
   346→  observations: number;
   347→  unresolvedObservations: number;
   348→  skills: number;
   349→} {
   350→  return {
   351→    agents: meta.agents.length,
   352→    workflows: meta.workflows.length,
   353→    conventions: meta.conventions.length,
   354→    observations: meta.observations.length,
   355→    unresolvedObservations: meta.observations.filter((o) => !o.resolved).length,
   356→    skills: meta.skills.length,
   357→  };
   358→}
   359→
   360→/**
   361→ * Meta item type string literal
   362→ */
   363→export type MetaItemTypeName =
   364→  | "agent"
   365→  | "workflow"
   366→  | "convention"
   367→  | "observation"
   368→  | "skill";
   369→
   370→/**
   371→ * Result of resolving a meta reference
   372→ */
   373→export interface ResolvedMetaRef {
   374→  item: LoadedMetaItem;
   375→  type: MetaItemTypeName;
   376→  ulid: string;
   377→}
   378→
   379→/**
   380→ * Resolve a meta reference to its item, type, and ULID.
   381→ *
   382→ * This is the unified resolver for meta items that consolidates various
   383→ * ref-to-item resolution patterns. Handles ULID prefixes, full ULIDs,
   384→ * semantic IDs (id field for agents/workflows/skills), and domains (conventions).
   385→ *
   386→ * AC: @skill-meta-type ac-5 - skills returned by semantic id lookup
   387→ * AC: @skill-meta-type ac-6 - skills returned by ULID prefix lookup
   388→ * AC: @skill-meta-integration ac-4 - skills included in resolution
   389→ */
   390→export function resolveMetaRef(
   391→  meta: MetaContext,
   392→  ref: string,
   393→): ResolvedMetaRef | null {
   394→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   395→
   396→  // Search all item types
   397→  const allItems: LoadedMetaItem[] = [
   398→    ...meta.agents,
   399→    ...meta.workflows,
   400→    ...meta.conventions,
   401→    ...meta.observations,
   402→    ...meta.skills,
   403→  ];
   404→
   405→  for (const item of allItems) {
   406→    // Match full ULID
   407→    if (item._ulid === cleanRef) {
   408→      return { item, type: getMetaItemType(item), ulid: item._ulid };
   409→    }
   410→
   411→    // Match short ULID (prefix)
   412→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase())) {
   413→      return { item, type: getMetaItemType(item), ulid: item._ulid };
   414→    }
   415→
   416→    // Match by id (for agents, workflows, and skills)
   417→    if ("id" in item && item.id === cleanRef) {
   418→      return { item, type: getMetaItemType(item), ulid: item._ulid };
   419→    }
   420→
   421→    // Match by domain (for conventions)
   422→    if ("domain" in item && item.domain === cleanRef) {
   423→      return { item, type: getMetaItemType(item), ulid: item._ulid };
   424→    }
   425→  }
   426→
   427→  return null;
   428→}
   429→
   430→/**
   431→ * Find a meta item by reference (ULID, short ULID, or id)
   432→ *
   433→ * This is a convenience wrapper around resolveMetaRef that returns just the item.
   434→ * Use resolveMetaRef when you also need the type and ULID.
   435→ *
   436→ * AC: @skill-meta-type ac-5 - skills returned by semantic id lookup
   437→ * AC: @skill-meta-type ac-6 - skills returned by ULID prefix lookup
   438→ */
   439→export function findMetaItemByRef(
   440→  meta: MetaContext,
   441→  ref: string,
   442→): LoadedMetaItem | undefined {
   443→  const result = resolveMetaRef(meta, ref);
   444→  return result?.item;
   445→}
   446→
   447→/**
   448→ * Determine if an item is a meta item type
   449→ */
   450→export function isMetaItemType(type: string): boolean {
   451→  return ["agent", "workflow", "convention", "observation", "skill"].includes(
   452→    type,
   453→  );
   454→}
   455→
   456→// ============================================================
   457→// META ITEM CRUD
   458→// ============================================================
   459→
   460→/**
   461→ * Save the entire meta manifest to file
   462→ */
   463→async function saveMetaManifest(
   464→  manifestPath: string,
   465→  manifest: MetaManifest,
   466→): Promise<void> {
   467→  await writeYamlFilePreserveFormat(manifestPath, manifest);
   468→}
   469→
   470→/**
   471→ * Strip runtime metadata before serialization
   472→ */
   473→function stripMetaMetadata<T extends LoadedMetaItem>(
   474→  item: T,
   475→): Omit<T, "_sourceFile"> {
   476→  const { _sourceFile, ...cleanItem } = item;
   477→  return cleanItem as Omit<T, "_sourceFile">;
   478→}
   479→
   480→/**
   481→ * Create a new observation
   482→ */
   483→export function createObservation(
   484→  type: ObservationType,
   485→  content: string,
   486→  options: {
   487→    workflow_ref?: string;
   488→    author?: string;
   489→    /** Config author from kspec.config.yaml identity.author */
   490→    configAuthor?: string | null;
   491→  } = {},
   492→): Observation {
   493→  return {
   494→    _ulid: ulid(),
   495→    type,
   496→    content,
   497→    workflow_ref: options.workflow_ref,
   498→    created_at: new Date().toISOString(),
   499→    author: options.author ?? getAuthor(options.configAuthor),
   500→    resolved: false,
   501→    resolution: null,
   502→  };
   503→}
   504→
   505→/**
   506→ * Save an observation to the meta manifest
   507→ */
   508→export async function saveObservation(
   509→  ctx: KspecContext,
   510→  observation: LoadedObservation,
   511→): Promise<void> {
   512→  const manifestPath = getMetaManifestPath(ctx);
   513→
   514→  // Ensure directory exists
   515→  const dir = path.dirname(manifestPath);
   516→  await fs.mkdir(dir, { recursive: true });
   517→
   518→  // Load existing manifest
   519→  let manifest: MetaManifest = {
   520→    kynetic_meta: "1.0",
   521→    agents: [],
   522→    workflows: [],
   523→    conventions: [],
   524→    observations: [],
   525→    skills: [],
   526→    includes: [],
   527→  };
   528→
   529→  try {
   530→    const raw = await readYamlFile<unknown>(manifestPath);
   531→    const parsed = MetaManifestSchema.safeParse(raw);
   532→    if (parsed.success) {
   533→      manifest = parsed.data;
   534→    }
   535→  } catch {
   536→    // File doesn't exist, use defaults
   537→  }
   538→
   539→  // Strip runtime metadata
   540→  const cleanObs = stripMetaMetadata(observation);
   541→
   542→  // Update or add
   543→  const existingIndex = manifest.observations.findIndex(
   544→    (o) => o._ulid === observation._ulid,
   545→  );
   546→  if (existingIndex >= 0) {
   547→    manifest.observations[existingIndex] = cleanObs as Observation;
   548→  } else {
   549→    manifest.observations.push(cleanObs as Observation);
   550→  }
   551→
   552→  await saveMetaManifest(manifestPath, manifest);
   553→}
   554→
   555→/**
   556→ * Delete an observation from the meta manifest
   557→ */
   558→export async function deleteObservation(
   559→  ctx: KspecContext,
   560→  ulid: string,
   561→): Promise<boolean> {
   562→  const manifestPath = getMetaManifestPath(ctx);
   563→
   564→  try {
   565→    const raw = await readYamlFile<unknown>(manifestPath);
   566→    const parsed = MetaManifestSchema.safeParse(raw);
   567→    if (!parsed.success) {
   568→      return false;
   569→    }
   570→
   571→    const manifest = parsed.data;
   572→    const index = manifest.observations.findIndex((o) => o._ulid === ulid);
   573→    if (index < 0) {
   574→      return false;
   575→    }
   576→
   577→    manifest.observations.splice(index, 1);
   578→    await saveMetaManifest(manifestPath, manifest);
   579→    return true;
   580→  } catch {
   581→    return false;
   582→  }
   583→}
   584→
   585→/**
   586→ * Get the path for skill content file.
   587→ * Skills are stored in .kspec/skills/<id>/SKILL.md
   588→ */
   589→export function getSkillContentPath(ctx: KspecContext, skillId: string): string {
   590→  return path.join(ctx.specDir, "skills", skillId, "SKILL.md");
   591→}
   592→
   593→/**
   594→ * Load skill content from the SKILL.md file.
   595→ * AC: @skill-meta-type ac-3 - loadSkillContent returns full markdown content
   596→ * AC: @skill-content-model ac-1 - loadSkillContent returns markdown content as a string
   597→ */
   598→export async function loadSkillContent(
   599→  ctx: KspecContext,
   600→  skill: LoadedSkill,
   601→): Promise<string | null> {
   602→  const contentPath = getSkillContentPath(ctx, skill.id);
   603→  try {
   604→    const content = await readFileBufferAware(contentPath);
   605→    return content;
   606→  } catch {
   607→    return null;
   608→  }
   609→}
   610→
   611→/**
   612→ * Skill doc object returned by loadSkillDocs.
   613→ * AC: @skill-content-model ac-2
   614→ */
   615→export interface SkillDoc {
   616→  /** File name (e.g., "quickref.md") */
   617→  name: string;
   618→  /** Full file path */
   619→  path: string;
   620→  /** File content */
   621→  content: string;
   622→}
   623→
   624→/**
   625→ * Supported skill supporting directory types.
   626→ * AC: @supporting-files-convention ac-1
   627→ */
   628→export type SupportingDirType = "references" | "scripts" | "assets" | "docs";
   629→
   630→/**
   631→ * A file from a skill's supporting directory.
   632→ * AC: @supporting-files-convention ac-1
   633→ */
   634→export interface SupportingFile {
   635→  /** File name (e.g., "api.md", "helper.sh") */
   636→  name: string;
   637→  /** Full file path */
   638→  path: string;
   639→  /** File content (for text files) */
   640→  content: string;
   641→  /** Supporting directory type */
   642→  dirType: SupportingDirType;
   643→}
   644→
   645→/**
   646→ * Get the docs directory path for a skill.
   647→ * Skills can have supporting docs at .kspec/skills/<id>/docs/
   648→ */
   649→export function getSkillDocsPath(ctx: KspecContext, skillId: string): string {
   650→  return path.join(ctx.specDir, "skills", skillId, "docs");
   651→}
   652→
   653→/**
   654→ * Load skill documentation files from the docs/ subdirectory.
   655→ * AC: @skill-content-model ac-2 - loadSkillDocs returns array of doc objects
   656→ */
   657→export async function loadSkillDocs(
   658→  ctx: KspecContext,
   659→  skill: LoadedSkill,
   660→): Promise<SkillDoc[]> {
   661→  const docsPath = getSkillDocsPath(ctx, skill.id);
   662→  const docs: SkillDoc[] = [];
   663→
   664→  try {
   665→    const entries = await readdirBufferAware(docsPath, { withFileTypes: true }) as Dirent[];
   666→
   667→    for (const entry of entries) {
   668→      if (entry.isFile() && entry.name.endsWith(".md")) {
   669→        const filePath = path.join(docsPath, entry.name);
   670→        try {
   671→          const content = await readFileBufferAware(filePath);
   672→          docs.push({
   673→            name: entry.name,
   674→            path: filePath,
   675→            content,
   676→          });
   677→        } catch {
   678→          // Skip files that can't be read
   679→        }
   680→      }
   681→    }
   682→  } catch {
   683→    // docs directory doesn't exist or can't be read
   684→  }
   685→
   686→  return docs;
   687→}
   688→
   689→/**
   690→ * Get the path to a supporting directory for a skill.
   691→ * AC: @supporting-files-convention ac-1
   692→ */
   693→export function getSkillSupportingDirPath(
   694→  ctx: KspecContext,
   695→  skillId: string,
   696→  dirType: SupportingDirType
   697→): string {
   698→  return path.join(ctx.specDir, "skills", skillId, dirType);
   699→}
   700→
   701→/**
   702→ * Load files from a skill's supporting directory.
   703→ * AC: @supporting-files-convention ac-1 - references files are accessible
   704→ *
   705→ * @param ctx - Kspec context
   706→ * @param skill - The skill to load files from
   707→ * @param dirType - The supporting directory type (references, scripts, assets, docs)
   708→ * @returns Array of files found in the directory
   709→ */
   710→export async function loadSkillSupportingFiles(
   711→  ctx: KspecContext,
   712→  skill: LoadedSkill,
   713→  dirType: SupportingDirType
   714→): Promise<SupportingFile[]> {
   715→  const dirPath = getSkillSupportingDirPath(ctx, skill.id, dirType);
   716→  const files: SupportingFile[] = [];
   717→
   718→  try {
   719→    const entries = await readdirBufferAware(dirPath, { withFileTypes: true }) as Dirent[];
   720→
   721→    for (const entry of entries) {
   722→      if (entry.isFile()) {
   723→        const filePath = path.join(dirPath, entry.name);
   724→        try {
   725→          const content = await readFileBufferAware(filePath);
   726→          files.push({
   727→            name: entry.name,
   728→            path: filePath,
   729→            content,
   730→            dirType,
   731→          });
   732→        } catch {
   733→          // Skip files that can't be read (e.g., binary files)
   734→        }
   735→      }
   736→    }
   737→  } catch {
   738→    // Directory doesn't exist or can't be read - return empty array
   739→  }
   740→
   741→  return files;
   742→}
   743→
   744→/**
   745→ * List which supporting directories exist for a skill.
   746→ * AC: @supporting-files-convention ac-1
   747→ *
   748→ * @returns Array of directory types that exist for the skill
   749→ */
   750→export async function listSkillSupportingDirs(
   751→  ctx: KspecContext,
   752→  skillId: string
   753→): Promise<SupportingDirType[]> {
   754→  const dirs: SupportingDirType[] = [];
   755→  const allDirs: SupportingDirType[] = ["references", "scripts", "assets", "docs"];
   756→
   757→  for (const dirType of allDirs) {
   758→    const dirPath = getSkillSupportingDirPath(ctx, skillId, dirType);
   759→    try {
   760→      const stat = await fs.stat(dirPath);
   761→      if (stat.isDirectory()) {
   762→        dirs.push(dirType);
   763→      }
   764→    } catch {
   765→      // Directory doesn't exist
   766→    }
   767→  }
   768→
   769→  return dirs;
   770→}
   771→
   772→// Re-export the getMetaItemType and isSkill functions
   773→export { getMetaItemType, isSkill };
   774→export type { Agent, Workflow, Convention, Observation, Skill, MetaItem };
   775→
   776→// ============================================================
   777→// GENERIC META ITEM CRUD
   778→// ============================================================
   779→
   780→/**
   781→ * Save any meta item (agent, workflow, convention, skill) to the manifest
   782→ * AC: @skill-parser ac-1 - skill is appended to manifest.skills and written to disk
   783→ * AC: @skill-parser ac-2 - .kspec/skills/<id>/ directory is created for skills
   784→ */
   785→export async function saveMetaItem(
   786→  ctx: KspecContext,
   787→  item: LoadedMetaItem,
   788→  itemType: "agent" | "workflow" | "convention" | "skill",
   789→): Promise<void> {
   790→  const manifestPath = getMetaManifestPath(ctx);
   791→
   792→  // Ensure directory exists
   793→  const dir = path.dirname(manifestPath);
   794→  await fs.mkdir(dir, { recursive: true });
   795→
   796→  // Load existing manifest
   797→  let manifest: MetaManifest = {
   798→    kynetic_meta: "1.0",
   799→    agents: [],
   800→    workflows: [],
   801→    conventions: [],
   802→    observations: [],
   803→    skills: [],
   804→    includes: [],
   805→  };
   806→
   807→  try {
   808→    const raw = await readYamlFile<unknown>(manifestPath);
   809→    const parsed = MetaManifestSchema.safeParse(raw);
   810→    if (parsed.success) {
   811→      manifest = parsed.data;
   812→    }
   813→  } catch {
   814→    // File doesn't exist, use defaults
   815→  }
   816→
   817→  // Strip runtime metadata
   818→  const cleanItem = stripMetaMetadata(item);
   819→
   820→  // Get the appropriate array
   821→  const getArray = () => {
   822→    switch (itemType) {
   823→      case "agent":
   824→        return manifest.agents;
   825→      case "workflow":
   826→        return manifest.workflows;
   827→      case "convention":
   828→        return manifest.conventions;
   829→      case "skill":
   830→        return manifest.skills;
   831→    }
   832→  };
   833→
   834→  const array = getArray();
   835→
   836→  // Update or add
   837→  const existingIndex = array.findIndex((i) => i._ulid === item._ulid);
   838→  if (existingIndex >= 0) {
   839→    (array as unknown[])[existingIndex] = cleanItem;
   840→  } else {
   841→    (array as unknown[]).push(cleanItem);
   842→  }
   843→
   844→  await saveMetaManifest(manifestPath, manifest);
   845→
   846→  // AC: @skill-parser ac-2 - Create skill content directory
   847→  if (itemType === "skill" && "id" in item) {
   848→    const skillDir = path.join(ctx.specDir, "skills", item.id);
   849→    await fs.mkdir(skillDir, { recursive: true });
   850→  }
   851→}
   852→
   853→/**
   854→ * Delete any meta item from the manifest
   855→ * AC: @skill-parser ac-3 - skill is removed from manifest.skills
   856→ * AC: @skill-parser ac-4 - .kspec/skills/<id>/ directory is deleted for skills
   857→ */
   858→export async function deleteMetaItem(
   859→  ctx: KspecContext,
   860→  itemUlid: string,
   861→  itemType: "agent" | "workflow" | "convention" | "observation" | "skill",
   862→): Promise<boolean> {
   863→  const manifestPath = getMetaManifestPath(ctx);
   864→
   865→  try {
   866→    const raw = await readYamlFile<unknown>(manifestPath);
   867→    const parsed = MetaManifestSchema.safeParse(raw);
   868→    if (!parsed.success) {
   869→      return false;
   870→    }
   871→
   872→    const manifest = parsed.data;
   873→
   874→    const getArray = () => {
   875→      switch (itemType) {
   876→        case "agent":
   877→          return manifest.agents;
   878→        case "workflow":
   879→          return manifest.workflows;
   880→        case "convention":
   881→          return manifest.conventions;
   882→        case "observation":
   883→          return manifest.observations;
   884→        case "skill":
   885→          return manifest.skills;
   886→      }
   887→    };
   888→
   889→    const array = getArray();
   890→    const index = array.findIndex((i) => i._ulid === itemUlid);
   891→    if (index < 0) {
   892→      return false;
   893→    }
   894→
   895→    // AC: @skill-parser ac-4 - Delete skill directory before removing from manifest
   896→    if (itemType === "skill") {
   897→      const skill = array[index] as Skill;
   898→      if (skill.id) {
   899→        const skillDir = path.join(ctx.specDir, "skills", skill.id);
   900→        try {
   901→          await fs.rm(skillDir, { recursive: true, force: true });
   902→        } catch {
   903→          // Directory might not exist, that's fine
   904→        }
   905→      }
   906→    }
   907→
   908→    array.splice(index, 1);
   909→    await saveMetaManifest(manifestPath, manifest);
   910→    return true;
   911→  } catch {
   912→    return false;
   913→  }
   914→}
   915→
   916→// ============================================================
   917→// SESSION CONTEXT
   918→// ============================================================
   919→
   920→/**
   921→ * Get the session context file path
   922→ */
   923→export function getSessionContextPath(ctx: KspecContext): string {
   924→  return path.join(ctx.specDir, ".kspec-session");
   925→}
   926→
   927→/**
   928→ * Load session context (or return empty context if not exists)
   929→ */
   930→export async function loadSessionContext(
   931→  ctx: KspecContext,
   932→): Promise<SessionContext> {
   933→  const contextPath = getSessionContextPath(ctx);
   934→
   935→  try {
   936→    const raw = await readYamlFile<unknown>(contextPath);
   937→    if (!raw || typeof raw !== "object") {
   938→      return {
   939→        focus: null,
   940→        threads: [],
   941→        open_questions: [],
   942→        updated_at: new Date().toISOString(),
   943→      };
   944→    }
   945→
   946→    // Validate and parse using schema
   947→    const result = SessionContextSchema.safeParse(raw);
   948→    if (result.success) {
   949→      return result.data;
   950→    }
   951→
   952→    // If validation fails, return empty context
   953→    return {
   954→      focus: null,
   955→      threads: [],
   956→      open_questions: [],
   957→      updated_at: new Date().toISOString(),
   958→    };
   959→  } catch {
   960→    return {
   961→      focus: null,
   962→      threads: [],
   963→      open_questions: [],
   964→      updated_at: new Date().toISOString(),
   965→    };
   966→  }
   967→}
   968→
   969→/**
   970→ * Save session context
   971→ */
   972→export async function saveSessionContext(
   973→  ctx: KspecContext,
   974→  context: SessionContext,
   975→): Promise<void> {
   976→  const contextPath = getSessionContextPath(ctx);
   977→
   978→  // Update timestamp
   979→  context.updated_at = new Date().toISOString();
   980→
   981→  await writeYamlFilePreserveFormat(contextPath, context);
   982→}
   983→
   984→// ============================================================
   985→// WORKFLOW RUNS
   986→// ============================================================
   987→
   988→/**
   989→ * Get the workflow runs file path.
   990→ * Derives from main manifest name (e.g., myproject.yaml -> myproject.runs.yaml)
   991→ */
   992→export function getWorkflowRunsPath(ctx: KspecContext): string {
   993→  const baseName = getManifestBaseName(ctx.manifestPath);
   994→  return path.join(ctx.specDir, `${baseName}.runs.yaml`);
   995→}
   996→
   997→/**
   998→ * Load workflow runs from file
   999→ */
  1000→export async function loadWorkflowRuns(
  1001→  ctx: KspecContext,
  1002→): Promise<WorkflowRun[]> {
  1003→  const runsPath = getWorkflowRunsPath(ctx);
  1004→
  1005→  try {
  1006→    const raw = await readYamlFile<unknown>(runsPath);
  1007→    const parsed = WorkflowRunsFileSchema.safeParse(raw);
  1008→
  1009→    if (!parsed.success) {
  1010→      return [];
  1011→    }
  1012→
  1013→    return parsed.data.runs;
  1014→  } catch {
  1015→    // File doesn't exist
  1016→    return [];
  1017→  }
  1018→}
  1019→
  1020→/**
  1021→ * Save a workflow run (create or update)
  1022→ */
  1023→export async function saveWorkflowRun(
  1024→  ctx: KspecContext,
  1025→  run: WorkflowRun,
  1026→): Promise<void> {
  1027→  const runsPath = getWorkflowRunsPath(ctx);
  1028→
  1029→  // Load existing runs
  1030→  const runs = await loadWorkflowRuns(ctx);
  1031→
  1032→  // Update or add
  1033→  const existingIndex = runs.findIndex((r) => r._ulid === run._ulid);
  1034→  if (existingIndex >= 0) {
  1035→    runs[existingIndex] = run;
  1036→  } else {
  1037→    runs.push(run);
  1038→  }
  1039→
  1040→  // Save back
  1041→  const runsFile: WorkflowRunsFile = {
  1042→    kynetic_runs: "1.0",
  1043→    runs,
  1044→  };
  1045→
  1046→  await writeYamlFilePreserveFormat(runsPath, runsFile);
  1047→}
  1048→
  1049→/**
  1050→ * Update an existing workflow run
  1051→ */
  1052→export async function updateWorkflowRun(
  1053→  ctx: KspecContext,
  1054→  run: WorkflowRun,
  1055→): Promise<void> {
  1056→  await saveWorkflowRun(ctx, run);
  1057→}
  1058→
  1059→/**
  1060→ * Find a workflow run by reference (ULID or ULID prefix)
  1061→ */
  1062→export async function findWorkflowRunByRef(
  1063→  ctx: KspecContext,
  1064→  ref: string,
  1065→): Promise<WorkflowRun | undefined> {
  1066→  const runs = await loadWorkflowRuns(ctx);
  1067→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1068→
  1069→  return runs.find(
  1070→    (r) =>
  1071→      r._ulid === cleanRef ||
  1072→      r._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
  1073→  );
  1074→}
  1075→
  1076→/**
  1077→ * Find active workflow runs
  1078→ */
  1079→export async function findActiveRuns(
  1080→  ctx: KspecContext,
  1081→): Promise<WorkflowRun[]> {
  1082→  const runs = await loadWorkflowRuns(ctx);
  1083→  return runs.filter((r) => r.status === "active");
  1084→}
  1085→
  1086→/**
  1087→ * Delete workflow runs by ULIDs
  1088→ * AC: @workflow-prune ac-1, ac-2, ac-3, ac-4
  1089→ */
  1090→export async function deleteWorkflowRuns(
  1091→  ctx: KspecContext,
  1092→  ulidsToDelete: string[],
  1093→): Promise<void> {
  1094→  const runsPath = getWorkflowRunsPath(ctx);
  1095→  const runs = await loadWorkflowRuns(ctx);
  1096→
  1097→  // Filter out runs to delete
  1098→  const remainingRuns = runs.filter((r) => !ulidsToDelete.includes(r._ulid));
  1099→
  1100→  // Save back
  1101→  const runsFile: WorkflowRunsFile = {
  1102→    kynetic_runs: "1.0",
  1103→    runs: remainingRuns,
  1104→  };
  1105→
  1106→  await writeYamlFilePreserveFormat(runsPath, runsFile);
  1107→}
