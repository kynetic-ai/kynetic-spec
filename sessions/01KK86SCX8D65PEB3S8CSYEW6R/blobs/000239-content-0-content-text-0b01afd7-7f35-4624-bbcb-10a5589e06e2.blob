   106→/**
   107→ * Parse YAML content into an object
   108→ * Uses the modern yaml library which has consistent type handling
   109→ */
   110→export function parseYaml<T>(content: string): T {
   111→  return YAML.parse(content) as T;
   112→}
   113→
   114→/**
   115→ * Serialize object to YAML
   116→ * Uses the modern yaml library for consistent formatting.
   117→ *
   118→ * WORKAROUND: The 'yaml' library (v2.8.2+) has a known behavior where block scalars
   119→ * containing whitespace-only lines accumulate extra blank lines on each parse-stringify
   120→ * cycle. The library's blockString() function adds indentation after newlines, which
   121→ * causes lines containing only spaces to grow. We post-process the output to filter
   122→ * these whitespace-only lines. See: https://github.com/eemeli/yaml - stringifyString.ts
   123→ */
   124→export function toYaml(obj: unknown): string {
   125→  let yamlString = YAML.stringify(obj, {
   126→    indent: 2,
   127→    lineWidth: 100,
   128→    sortMapEntries: false,
   129→  });
   130→
   131→  // Post-process to fix yaml library blank line accumulation bug.
   132→  // Filter out lines that contain only spaces/tabs (not truly empty lines).
   133→  yamlString = yamlString
   134→    .split("\n")
   135→    .filter((line) => !/^[ \t]+$/.test(line))
   136→    .join("\n");
   137→
   138→  return yamlString;
   139→}
   140→
   141→/**
   142→ * Read a text file with batch buffer overlay semantics.
   143→ */
   144→export async function readFileBufferAware(filePath: string): Promise<string> {
   145→  // AC: @batch-write-buffer ac-2 — check buffer first for read-after-write consistency
   146→  const buffer = getActiveBatchBuffer();
   147→  if (buffer?.isInScope(filePath)) {
   148→    const buffered = buffer.read(filePath);
   149→    if (buffered !== undefined) {
   150→      if (buffered === null) {
   151→        // File was deleted in this batch
   152→        throw Object.assign(new Error(`ENOENT: no such file or directory, open '${filePath}'`), {
   153→          code: "ENOENT",
   154→        });
   155→      }
   156→      return typeof buffered === "string"
   157→        ? buffered
   158→        : Buffer.from(buffered).toString("utf-8");
   159→    }
   160→  }
   161→
   162→  return fs.readFile(filePath, "utf-8");
   163→}
   164→
   165→/**
   166→ * Read and parse a YAML file.
   167→ */
   168→export async function readYamlFile<T>(filePath: string): Promise<T> {
   169→  const content = await readFileBufferAware(filePath);
   170→  return parseYaml<T>(content);
   171→}
   172→
   173→/**
   174→ * Write object to YAML file
   175→ */
   176→export async function writeYamlFile(
   177→  filePath: string,
   178→  data: unknown,
   179→): Promise<void> {
   180→  const content = toYaml(data);
   181→  // AC: @batch-write-buffer ac-1 — buffer write if in batch mode
   182→  const buffer = getActiveBatchBuffer();
   183→  if (buffer?.isInScope(filePath)) {
   184→    buffer.write(filePath, content);
   185→    return;
   186→  }
   187→  await fs.writeFile(filePath, content, "utf-8");
   188→}
   189→
   190→/**
   191→ * Write object to YAML file while preserving formatting and comments.
   192→ *
   193→ * Note: This function is now equivalent to writeYamlFile() - the "preserve format"
   194→ * naming is historical. Both use toYaml() which includes the whitespace-only line
   195→ * fix. Kept for backwards compatibility with existing callers.
   196→ */
   197→export async function writeYamlFilePreserveFormat(
   198→  filePath: string,
   199→  data: unknown,
   200→): Promise<void> {
   201→  const content = toYaml(data);
   202→  // AC: @batch-write-buffer ac-1 — buffer write if in batch mode
   203→  const buffer = getActiveBatchBuffer();
   204→  if (buffer?.isInScope(filePath)) {
   205→    buffer.write(filePath, content);
   206→    return;
   207→  }
   208→  await fs.writeFile(filePath, content, "utf-8");
   209→}
   210→
   211→/**
   212→ * Find task files in a directory
   213→ */
   214→export async function findTaskFiles(dir: string): Promise<string[]> {
   215→  const files: string[] = [];
   216→
   217→  try {
   218→    const entries = await readdirBufferAware(dir, { withFileTypes: true }) as Dirent[];
   219→
   220→    for (const entry of entries) {
   221→      const fullPath = path.join(dir, entry.name);
   222→
   223→      if (entry.isDirectory()) {
   224→        // Recurse into subdirectories
   225→        const subFiles = await findTaskFiles(fullPath);
   226→        files.push(...subFiles);
   227→      } else if (entry.isFile() && entry.name.endsWith(".tasks.yaml")) {
   228→        files.push(fullPath);
   229→      }
   230→    }
   231→  } catch (_error) {
   232→    // Directory doesn't exist or not readable
   233→  }
   234→
   235→  return files;
   236→}
   237→
   238→/**
   239→ * Find the manifest file.
   240→ *
   241→ * Discovery algorithm per directory:
   242→ * 1. Check for explicit names: kynetic.yaml, kynetic.spec.yaml (backward compat)
   243→ * 2. If not found, scan for *.yaml files with 'kynetic:' version field
   244→ *
   245→ * Searches current dir, then spec/ subdir, then parent directories.
   246→ */
   247→export async function findManifest(startDir: string): Promise<string | null> {
   248→  let dir = startDir;
   249→
   250→  while (true) {
   251→    // Check current directory
   252→    const manifestInDir = await findManifestInDir(dir);
   253→    if (manifestInDir) {
   254→      return manifestInDir;
   255→    }
   256→
   257→    // Also check in spec/ subdirectory
   258→    const specDir = path.join(dir, "spec");
   259→    try {
   260→      const stat = await fs.stat(specDir);
   261→      if (stat.isDirectory()) {
   262→        const manifestInSpec = await findManifestInDir(specDir);
   263→        if (manifestInSpec) {
   264→          return manifestInSpec;
   265→        }
   266→      }
   267→    } catch {
   268→      // spec/ doesn't exist
   269→    }
   270→
   271→    const parentDir = path.dirname(dir);
   272→    if (parentDir === dir) {
   273→      // Reached root
   274→      return null;
   275→    }
   276→    dir = parentDir;
   277→  }
   278→}
   279→
   280→/**
   281→ * Context for working with spec/task files.
   282→ *
   283→ * When shadow branch is enabled:
   284→ * - rootDir points to the project root (where .kspec/ lives)
   285→ * - specDir points to .kspec/ (where spec files are read/written)
   286→ * - All file operations use specDir for resolution
   287→ *
   288→ * Without shadow branch:
   289→ * - rootDir is the project root
   290→ * - specDir is rootDir/spec/ (traditional layout)
   291→ */
   292→export interface KspecContext {
   293→  /** Project root directory */
   294→  rootDir: string;
   295→  /** Spec files directory (.kspec/ when shadow enabled, otherwise spec/) */
   296→  specDir: string;
   297→  /**
   298→   * Sessions storage directory (.kspec-sessions/ at project root).
   299→   * Separate from specDir — session data lives outside the shadow branch.
   300→   *
   301→   * AC: @session-storage-path-resolution ac-context
   302→   */
   303→  sessionsDir: string;
   304→  /** Path to manifest file */
   305→  manifestPath: string | null;
   306→  /** Parsed manifest */
   307→  manifest: Manifest | null;
   308→  /** Shadow branch configuration (null if not using shadow) */
   309→  shadow: ShadowConfig | null;
   310→  /**
   311→   * Project configuration from kspec.config.yaml.
   312→   * Loaded before shadow detection. Always present (defaults if no config file).
   313→   *
   314→   * AC: @project-config ac-2 — config available on KspecContext.config
   315→   */
   316→  config: ResolvedKspecConfig;
   317→}
   318→
   319→/**
   320→ * Initialize context by finding manifest.
   321→ *
   322→ * Detection order:
   323→ * 1. Load project config from git root (before shadow detection)
   324→ * 2. Check for shadow branch (.kspec/ directory)
   325→ * 3. Fall back to traditional spec/ directory
   326→ *
   327→ * When shadow is detected, all operations use .kspec/ as specDir.
   328→ *
   329→ * AC: @project-config ac-2 — config loaded before shadow detection
   330→ */
   331→export async function initContext(startDir?: string): Promise<KspecContext> {
   332→  const cwd = startDir || process.cwd();
   333→
   334→  // AC: @project-config ac-2, ac-6, ac-7 — load config before shadow detection
   335→  // Config is loaded from git root, not cwd or KSPEC_SPEC_DIR temp dir
   336→  const configResult = await loadProjectConfig(cwd);
   337→
   338→  // AC: @project-config ac-3 — emit warning to stderr if config had issues
   339→  if (configResult.warning) {
   340→    console.error(`Warning: ${configResult.warning}`);
   341→  }
   342→
   343→  const { config } = configResult;
   344→
   345→  // KSPEC_SPEC_DIR override: used by batch atomic mode to redirect to temp copy
   346→  const specDirOverride = process.env.KSPEC_SPEC_DIR;
   347→  if (specDirOverride) {
   348→    const specDir = path.resolve(specDirOverride);
   349→    const manifestPath = await findManifestInDir(specDir);
   350→
   351→    let manifest: Manifest | null = null;
   352→    if (manifestPath) {
   353→      try {
   354→        const rawManifest = await readYamlFile<unknown>(manifestPath);
   355→        manifest = parseManifestWithWarnings(rawManifest);
   356→      } catch {
   357→        // Manifest exists but may be invalid
   358→      }
   359→    }
   360→
   361→    const rootDir = path.dirname(specDir);
   362→    return {
   363→      rootDir,
   364→      specDir,
   365→      sessionsDir: path.join(rootDir, ".kspec-sessions"),
   366→      manifestPath,
   367→      manifest,
   368→      shadow: null, // No shadow in overridden context
   369→      config,
   370→    };
   371→  }
   372→
   373→  // Check if running from inside the shadow worktree
   374→  // AC: @config-shadow ac-8 — pass configured directory for detection
   375→  const mainProjectRoot = await detectRunningFromShadowWorktree(
   376→    cwd,
   377→    config.shadow.directory,
   378→  );
   379→  if (mainProjectRoot) {
   380→    throw new ShadowError(
   381→      errors.project.runningFromShadow,
   382→      "RUNNING_FROM_SHADOW",
   383→      `Run from project root: cd ${path.relative(cwd, mainProjectRoot) || mainProjectRoot}`,
   384→    );
   385→  }
   386→
   387→  // Try to detect shadow branch first
   388→  // AC: @config-shadow ac-1 ac-2 — use configured branch/directory names
   389→  const shadow = await detectShadow(cwd, {
   390→    branchName: config.shadow.branch,
   391→    directory: config.shadow.directory,
   392→  });
   393→
   394→  if (shadow?.enabled) {
   395→    // Shadow mode: use .kspec/ for everything
   396→    const specDir = shadow.worktreeDir;
   397→
   398→    // AC: @config-shadow ac-11 — pre-read shadow pull to pick up remote changes
   399→    // before CLI read operations (task list, session start, etc.)
   400→    // Skip when KSPEC_NO_SYNC is set (tests, offline) or KSPEC_SPEC_DIR is overridden
   401→    // Note: shadowPull() has in-flight dedup so concurrent daemon calls don't collide
   402→    if (!process.env.KSPEC_NO_SYNC) {
   403→      // AC: @config-shadow ac-3 ac-7 — pass configured shadow options so sync
   404→      // uses the right branch name and remote instead of hardcoded defaults
   405→      const shadowOpts: ShadowOptions = {
   406→        branchName: config.shadow.branch,
   407→        directory: config.shadow.directory,
   408→        remote: config.shadow.remote?.value,
   409→        remoteType: config.shadow.remote?.type,
   410→      };
   411→      try {
   412→        const tracked = await hasRemoteTracking(specDir, shadowOpts);
   413→        if (tracked) {
   414→          const syncResult = await shadowPull(specDir, shadowOpts);
   415→          if (syncResult.hadConflict) {
   416→            console.error(
   417→              "Warning: Shadow sync conflict detected. Run `kspec shadow resolve` to fix.",
   418→            );
   419→            console.error("Continuing with local state...");
   420→          }
   421→        }
   422→      } catch {
   423→        // Pre-read pull is best-effort — don't fail the command
   424→      }
   425→    }
   426→
   427→    const manifestPath = await findManifestInDir(specDir);
   428→
   429→    let manifest: Manifest | null = null;
   430→    if (manifestPath) {
   431→      try {
   432→        const rawManifest = await readYamlFile<unknown>(manifestPath);
   433→        manifest = parseManifestWithWarnings(rawManifest);
   434→      } catch {
   435→        // Manifest exists but may be invalid
   436→      }
   437→    }
   438→
   439→    return {
   440→      rootDir: shadow.projectRoot,
   441→      specDir,
   442→      sessionsDir: path.join(shadow.projectRoot, ".kspec-sessions"),
   443→      manifestPath,
   444→      manifest,
   445→      shadow,
   446→      config,
   447→    };
   448→  }
   449→
   450→  // Traditional mode: find manifest in spec/ or current directory
   451→  const manifestPath = await findManifest(cwd);
   452→
   453→  let manifest: Manifest | null = null;
   454→  let rootDir = cwd;
   455→  let specDir = cwd;
   456→
   457→  if (manifestPath) {
   458→    const manifestDir = path.dirname(manifestPath);
   459→    // Handle spec/ subdirectory
   460→    if (path.basename(manifestDir) === "spec") {
   461→      rootDir = path.dirname(manifestDir);
   462→      specDir = manifestDir;
   463→    } else {
   464→      rootDir = manifestDir;
   465→      specDir = manifestDir;
   466→    }
   467→
   468→    try {
   469→      const rawManifest = await readYamlFile<unknown>(manifestPath);
   470→      manifest = parseManifestWithWarnings(rawManifest);
   471→    } catch {
   472→      // Manifest exists but may be invalid
   473→    }
   474→  }
   475→
   476→  return {
   477→    rootDir,
   478→    specDir,
   479→    sessionsDir: path.join(rootDir, ".kspec-sessions"),
   480→    manifestPath,
   481→    manifest,
   482→    shadow: null,
   483→    config,
   484→  };
   485→}
   486→
   487→/**
   488→ * Check if a filename is a potential manifest file.
   489→ * Excludes files with suffixes that indicate other kspec file types.
   490→ *
   491→ * AC: @manifest-discovery ac-5 (excludes task/inbox/meta/runs files)
   492→ */
   493→function isManifestCandidate(filename: string): boolean {
   494→  if (!filename.endsWith(".yaml")) return false;
   495→  const exclusions = [".tasks.yaml", ".inbox.yaml", ".meta.yaml", ".runs.yaml"];
   496→  return !exclusions.some((excl) => filename.endsWith(excl));
   497→}
   498→
   499→/**
   500→ * Find manifest file within a specific directory (no parent traversal).
   501→ * Used for shadow mode where we know exactly where to look.
   502→ *
   503→ * Discovery algorithm:
   504→ * 1. Check for explicit names: kynetic.yaml, kynetic.spec.yaml (backward compat)
   505→ * 2. If not found, scan directory for *.yaml files (excluding other kspec types)
   506→ * 3. For each candidate, validate it contains a 'kynetic:' version field
   507→ * 4. Return first valid match (alphabetically after explicit names)
   508→ *
   509→ * AC: @manifest-discovery ac-1, ac-2, ac-3, ac-4, ac-5
   510→ */
   511→async function findManifestInDir(dir: string): Promise<string | null> {
   512→  // AC: @manifest-discovery ac-1, ac-2 - explicit names have priority
   513→  const priorityCandidates = ["kynetic.yaml", "kynetic.spec.yaml"];
   514→
   515→  for (const candidate of priorityCandidates) {
   516→    const filePath = path.join(dir, candidate);
   517→    try {
   518→      await accessBufferAware(filePath);
   519→      return filePath;
   520→    } catch {
   521→      // File doesn't exist, try next
   522→    }
   523→  }
   524→
   525→  // AC: @manifest-discovery ac-3, ac-4, ac-5 - glob fallback with validation
   526→  try {
   527→    const entries = await readdirBufferAware(dir) as string[];
   528→    // AC: @manifest-discovery ac-4 - alphabetical order
   529→    const candidates = entries.filter(isManifestCandidate).sort();
   530→
   531→    for (const candidate of candidates) {
   532→      const filePath = path.join(dir, candidate);
   533→      try {
   534→        const raw = await readYamlFile<unknown>(filePath);
   535→        // AC: @manifest-discovery ac-5 - validate kynetic version field
   536→        if (raw && typeof raw === "object" && "kynetic" in raw) {
   537→          return filePath;
   538→        }
   539→      } catch {
   540→        // Skip invalid files
   541→      }
   542→    }
   543→  } catch {
   544→    // Directory read failed
   545→  }
   546→
   547→  return null;
   548→}
   549→
   550→/**
   551→ * Load tasks from a single file.
   552→ * Helper function used by loadAllTasks.
   553→ */
   554→async function loadTasksFromFile(filePath: string): Promise<LoadedTask[]> {
   555→  const tasks: LoadedTask[] = [];
   556→
   557→  try {
   558→    const raw = await readYamlFile<unknown>(filePath);
   559→
   560→    // Handle both array format and object format
   561→    let taskList: unknown[];
   562→
   563→    if (Array.isArray(raw)) {
   564→      taskList = raw;
   565→    } else if (raw && typeof raw === "object" && "tasks" in raw) {
   566→      const parsed = TasksFileSchema.safeParse(raw);
   567→      if (parsed.success) {
   568→        // Add _sourceFile to each task from this file
   569→        for (const task of parsed.data.tasks) {
   570→          tasks.push({ ...task, _sourceFile: filePath });
   571→        }
   572→        return tasks;
   573→      }
   574→      taskList = (raw as { tasks: unknown[] }).tasks || [];
   575→    } else {
   576→      // Single task object
   577→      taskList = [raw];
   578→    }
   579→
   580→    for (const taskData of taskList) {
   581→      const result = TaskSchema.safeParse(taskData);
   582→      if (result.success) {
   583→        // Add _sourceFile metadata
   584→        tasks.push({ ...result.data, _sourceFile: filePath });
   585→      }
   586→    }
   587→  } catch {
   588→    // Skip invalid files
   589→  }
   590→
   591→  return tasks;
   592→}
   593→
   594→/**
   595→ * Load all tasks from the project.
   596→ * Each task includes _sourceFile metadata for write-back routing.
   597→ *
   598→ * When shadow is enabled, tasks are loaded from .kspec/ (ctx.specDir).
   599→ * Otherwise, searches in traditional locations (rootDir, spec/, tasks/).
   600→ */
   601→export async function loadAllTasks(ctx: KspecContext): Promise<LoadedTask[]> {
   602→  const tasks: LoadedTask[] = [];
   603→
   604→  // When shadow is enabled (or spec dir is explicitly overridden), look only in specDir.
   605→  // KSPEC_SPEC_DIR override is used by batch mode and some integration tests to isolate
   606→  // task state to a temp directory; scanning ctx.rootDir can leak tasks from parent dirs.
   607→  if (ctx.shadow?.enabled || Boolean(process.env.KSPEC_SPEC_DIR)) {
   608→    const taskFiles = await findTaskFiles(ctx.specDir);
   609→
   610→    // Also check for standalone files in specDir
   611→    const standaloneLocations = [
   612→      path.join(ctx.specDir, "tasks.yaml"),
   613→      path.join(ctx.specDir, "project.tasks.yaml"),
   614→      path.join(ctx.specDir, "kynetic.tasks.yaml"),
   615→      path.join(ctx.specDir, "backlog.tasks.yaml"),
   616→      path.join(ctx.specDir, "active.tasks.yaml"),
   617→    ];
   618→
   619→    for (const loc of standaloneLocations) {
   620→      try {
   621→        await accessBufferAware(loc);
   622→        if (!taskFiles.includes(loc)) {
   623→          taskFiles.push(loc);
   624→        }
   625→      } catch {
   626→        // File doesn't exist
   627→      }
   628→    }
   629→
   630→    // Deduplicate and load
   631→    const uniqueFiles = [...new Set(taskFiles)];
   632→    for (const filePath of uniqueFiles) {
   633→      const fileTasks = await loadTasksFromFile(filePath);
   634→      tasks.push(...fileTasks);
   635→    }
   636→
   637→    return tasks;
   638→  }
   639→
   640→  // Traditional mode: look in multiple locations
   641→  const taskFiles = await findTaskFiles(ctx.rootDir);
   642→
   643→  // Also check common locations
   644→  const additionalPaths = [
   645→    path.join(ctx.rootDir, "tasks"),
   646→    path.join(ctx.rootDir, "spec"),
   647→  ];
   648→
   649→  for (const additionalPath of additionalPaths) {
   650→    const files = await findTaskFiles(additionalPath);
   651→    taskFiles.push(...files);
   652→  }
   653→
   654→  // Also look for standalone tasks.yaml and project.tasks.yaml
   655→  const standaloneLocations = [
   656→    path.join(ctx.rootDir, "tasks.yaml"),
   657→    path.join(ctx.rootDir, "project.tasks.yaml"),
   658→    path.join(ctx.rootDir, "spec", "project.tasks.yaml"),
   659→    path.join(ctx.rootDir, "backlog.tasks.yaml"),
   660→    path.join(ctx.rootDir, "active.tasks.yaml"),
   661→  ];
   662→
   663→  for (const loc of standaloneLocations) {
   664→    try {
   665→      await accessBufferAware(loc);
   666→      if (!taskFiles.includes(loc)) {
   667→        taskFiles.push(loc);
   668→      }
   669→    } catch {
   670→      // File doesn't exist
   671→    }
   672→  }
   673→
   674→  // Deduplicate and load
   675→  const uniqueFiles = [...new Set(taskFiles)];
   676→
   677→  for (const filePath of uniqueFiles) {
   678→    const fileTasks = await loadTasksFromFile(filePath);
   679→    tasks.push(...fileTasks);
   680→  }
   681→
   682→  return tasks;
   683→}
   684→
   685→/**
   686→ * Find a task by reference (ULID, slug, or short reference)
   687→ */
   688→export function findTaskByRef(
   689→  tasks: LoadedTask[],
   690→  ref: string,
   691→): LoadedTask | undefined {
   692→  // Remove @ prefix if present
   693→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   694→
   695→  return tasks.find((task) => {
   696→    // Match full ULID
   697→    if (task._ulid === cleanRef) return true;
   698→
   699→    // Match short ULID (prefix)
   700→    if (task._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
   701→      return true;
   702→
   703→    // Match slug
   704→    if (task.slugs.includes(cleanRef)) return true;
   705→
   706→    return false;
   707→  });
   708→}
   709→
   710→/**
   711→ * Get the default task file path for new tasks without a spec_ref.
   712→ *
   713→ * When shadow enabled: .kspec/project.tasks.yaml
   714→ * Otherwise: spec/project.tasks.yaml
   715→ */
   716→export function getDefaultTaskFilePath(ctx: KspecContext): string {
   717→  return path.join(ctx.specDir, "project.tasks.yaml");
   718→}
   719→
   720→/**
   721→ * Strip runtime metadata before serialization
   722→ */
   723→function stripRuntimeMetadata(task: LoadedTask): Task {
   724→  const { _sourceFile, ...cleanTask } = task;
   725→  return cleanTask as Task;
   726→}
   727→
   728→/**
   729→ * Save a task to its source file (or default location for new tasks).
   730→ * Preserves file format (tasks: [...] wrapper vs plain array).
   731→ */
   732→export async function saveTask(
   733→  ctx: KspecContext,
   734→  task: LoadedTask,
   735→): Promise<void> {
   736→  // Determine target file: use _sourceFile if present, otherwise default
   737→  const taskFilePath = task._sourceFile || getDefaultTaskFilePath(ctx);
   738→
   739→  // Lock the file to prevent concurrent read-modify-write races
   740→  await withFileLock(taskFilePath, async () => {
   741→    // Ensure directory exists
   742→    const dir = path.dirname(taskFilePath);
   743→    await fs.mkdir(dir, { recursive: true });
   744→
   745→    // Load existing tasks from the target file
   746→    let existingRaw: unknown = null;
   747→    let useTasksWrapper = false;
   748→
   749→    try {
   750→      existingRaw = await readYamlFile<unknown>(taskFilePath);
   751→      // Detect if file uses { tasks: [...] } format
   752→      if (
   753→        existingRaw &&
   754→        typeof existingRaw === "object" &&
   755→        "tasks" in existingRaw
   756→      ) {
   757→        useTasksWrapper = true;
   758→      }
   759→    } catch {
   760→      // File doesn't exist, start fresh
   761→    }
   762→
   763→    // Parse existing tasks from file
   764→    let fileTasks: Task[] = [];
   765→
   766→    if (existingRaw) {
   767→      if (Array.isArray(existingRaw)) {
   768→        for (const t of existingRaw) {
   769→          const result = TaskSchema.safeParse(t);
   770→          if (result.success) {
   771→            fileTasks.push(result.data);
   772→          }
   773→        }
   774→      } else if (useTasksWrapper) {
   775→        // Try TasksFileSchema first (has kynetic_tasks version)
   776→        const parsed = TasksFileSchema.safeParse(existingRaw);
   777→        if (parsed.success) {
   778→          fileTasks = parsed.data.tasks;
   779→        } else {
   780→          // Fall back to raw tasks array (common format without version field)
   781→          const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   782→          if (Array.isArray(rawTasks)) {
   783→            for (const t of rawTasks) {
   784→              const result = TaskSchema.safeParse(t);
   785→              if (result.success) {
   786→                fileTasks.push(result.data);
   787→              }
   788→            }
   789→          }
   790→        }
   791→      }
   792→    }
   793→
   794→    // Strip runtime metadata before saving
   795→    const cleanTask = stripRuntimeMetadata(task);
   796→
   797→    // Update existing or add new
   798→    const existingIndex = fileTasks.findIndex((t) => t._ulid === task._ulid);
   799→    if (existingIndex >= 0) {
   800→      fileTasks[existingIndex] = cleanTask;
   801→    } else {
   802→      fileTasks.push(cleanTask);
   803→    }
   804→
   805→    // Save in the same format as original (or tasks: wrapper for new files)
   806→    // Use format-preserving write to maintain formatting and comments
   807→    if (useTasksWrapper) {
   808→      await writeYamlFilePreserveFormat(taskFilePath, { tasks: fileTasks });
   809→    } else {
   810→      await writeYamlFilePreserveFormat(taskFilePath, fileTasks);
   811→    }
   812→  });
   813→}
   814→
   815→/**
   816→ * Atomically mutate a task using the latest on-disk state.
   817→ *
   818→ * The callback receives the current task value while holding the task file lock,
   819→ * so concurrent writers cannot clobber unrelated fields (for example status vs notes).
   820→ */
   821→export async function mutateTaskAtomically(
   822→  ctx: KspecContext,
   823→  task: LoadedTask,
   824→  mutate: (latestTask: LoadedTask) => Task | LoadedTask | Promise<Task | LoadedTask>,
   825→): Promise<LoadedTask> {
   826→  const taskFilePath = task._sourceFile || getDefaultTaskFilePath(ctx);
   827→  let updatedTask: LoadedTask | undefined;
   828→
   829→  await withFileLock(taskFilePath, async () => {
   830→    // Ensure directory exists (important for default path in new repos)
   831→    const dir = path.dirname(taskFilePath);
   832→    await fs.mkdir(dir, { recursive: true });
   833→
   834→    // Preserve existing file format (tasks wrapper vs plain array)
   835→    let existingRaw: unknown = null;
   836→    let useTasksWrapper = false;
   837→    try {
   838→      existingRaw = await readYamlFile<unknown>(taskFilePath);
   839→      if (
   840→        existingRaw &&
   841→        typeof existingRaw === "object" &&
   842→        "tasks" in existingRaw
   843→      ) {
   844→        useTasksWrapper = true;
   845→      }
   846→    } catch {
   847→      throw new Error(`Task file not found: ${taskFilePath}`);
   848→    }
   849→
   850→    const fileTasks = await loadTasksFromFile(taskFilePath);
   851→    const taskIndex = fileTasks.findIndex((t) => t._ulid === task._ulid);
   852→    if (taskIndex === -1) {
   853→      throw new Error(`Task not found in file: ${task._ulid}`);
   854→    }
   855→
   856→    const latestTask = fileTasks[taskIndex];
   857→    const mutatedTask = await mutate(latestTask);
   858→    const cleanMutatedTask = stripRuntimeMetadata(mutatedTask as LoadedTask);
   859→
   860→    const serializedTasks = fileTasks.map((fileTask, index) =>
   861→      index === taskIndex ? cleanMutatedTask : stripRuntimeMetadata(fileTask),
   862→    );
   863→
   864→    if (useTasksWrapper) {
   865→      await writeYamlFilePreserveFormat(taskFilePath, { tasks: serializedTasks });
   866→    } else {
   867→      await writeYamlFilePreserveFormat(taskFilePath, serializedTasks);
   868→    }
   869→
   870→    updatedTask = {
   871→      ...cleanMutatedTask,
   872→      _sourceFile: taskFilePath,
   873→    };
   874→  });
   875→
   876→  if (!updatedTask) {
   877→    throw new Error(`Failed to mutate task atomically: ${task._ulid}`);
   878→  }
   879→
   880→  return updatedTask;
   881→}
   882→
   883→/**
   884→ * Delete a task from its source file.
   885→ * Requires _sourceFile to know which file to modify.
   886→ */
   887→export async function deleteTask(
   888→  _ctx: KspecContext,
   889→  task: LoadedTask,
   890→): Promise<void> {
   891→  if (!task._sourceFile) {
   892→    throw new Error("Cannot delete task without _sourceFile metadata");
   893→  }
   894→
   895→  const taskFilePath = task._sourceFile;
   896→
   897→  // Lock the file to prevent concurrent read-modify-write races
   898→  await withFileLock(taskFilePath, async () => {
   899→    // Load existing file
   900→    let existingRaw: unknown = null;
   901→    let useTasksWrapper = false;
   902→
   903→    try {
   904→      existingRaw = await readYamlFile<unknown>(taskFilePath);
   905→      if (
   906→        existingRaw &&
   907→        typeof existingRaw === "object" &&
   908→        "tasks" in existingRaw
   909→      ) {
   910→        useTasksWrapper = true;
   911→      }
   912→    } catch {
   913→      throw new Error(`Task file not found: ${taskFilePath}`);
   914→    }
   915→
   916→    // Parse existing tasks
   917→    let fileTasks: Task[] = [];
   918→
   919→    if (existingRaw) {
   920→      if (Array.isArray(existingRaw)) {
   921→        for (const t of existingRaw) {
   922→          const result = TaskSchema.safeParse(t);
   923→          if (result.success) {
   924→            fileTasks.push(result.data);
   925→          }
   926→        }
   927→      } else if (useTasksWrapper) {
   928→        const parsed = TasksFileSchema.safeParse(existingRaw);
   929→        if (parsed.success) {
   930→          fileTasks = parsed.data.tasks;
   931→        } else {
   932→          const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   933→          if (Array.isArray(rawTasks)) {
   934→            for (const t of rawTasks) {
   935→              const result = TaskSchema.safeParse(t);
   936→              if (result.success) {
   937→                fileTasks.push(result.data);
   938→              }
   939→            }
   940→          }
   941→        }
   942→      }
   943→    }
   944→
   945→    // Remove the task
   946→    const originalCount = fileTasks.length;
   947→    fileTasks = fileTasks.filter((t) => t._ulid !== task._ulid);
   948→
   949→    if (fileTasks.length === originalCount) {
   950→      throw new Error(`Task not found in file: ${task._ulid}`);
   951→    }
   952→
   953→    // Save the modified file with format preservation
   954→    if (useTasksWrapper) {
   955→      await writeYamlFilePreserveFormat(taskFilePath, { tasks: fileTasks });
   956→    } else {
   957→      await writeYamlFilePreserveFormat(taskFilePath, fileTasks);
   958→    }
   959→  });
   960→}
   961→
   962→/**
   963→ * Create a new task with auto-generated fields
   964→ */
   965→export function createTask(input: TaskInput): Task {
   966→  const now = new Date().toISOString();
   967→
   968→  return {
   969→    ...input,
   970→    _ulid: input._ulid || ulid(),
   971→    slugs: input.slugs || [],
   972→    type: input.type || "task",
   973→    status: input.status || "pending",
   974→    blocked_by: input.blocked_by || [],
   975→    depends_on: input.depends_on || [],
   976→    context: input.context || [],
   977→    priority: input.priority || 3,
   978→    tags: input.tags || [],
   979→    vcs_refs: input.vcs_refs || [],
   980→    created_at: input.created_at || now,
   981→    notes: input.notes || [],
   982→    todos: input.todos || [],
   983→  };
   984→}
   985→
   986→/**
   987→ * Get author from environment with fallback chain.
   988→ * Priority:
   989→ *   1. KSPEC_AUTHOR env var (explicit config, agent-agnostic)
   990→ *   2. kspec.config.yaml identity.author (project-level default)
   991→ *   3. git user.name (developer identity)
   992→ *   4. USER/USERNAME env var (system user)
   993→ *   5. undefined (will show as 'unknown' in output)
   994→ *
   995→ * For Claude Code integration, add to ~/.claude/settings.json:
   996→ *   { "env": { "KSPEC_AUTHOR": "@claude" } }
   997→ *
   998→ * AC: @config-author ac-1 ac-2 ac-3 — author priority chain
   999→ *
  1000→ * @param configAuthor Optional author from kspec.config.yaml identity.author
  1001→ */
  1002→export function getAuthor(configAuthor?: string | null): string | undefined {
  1003→  // 1. Explicit env var (works for any agent) — AC: ac-2
  1004→  if (process.env.KSPEC_AUTHOR) {
  1005→    return process.env.KSPEC_AUTHOR;
  1006→  }
  1007→
  1008→  // 2. Project config author — AC: ac-1
  1009→  if (configAuthor) {
  1010→    return configAuthor;
  1011→  }
  1012→
  1013→  // 3. Git user.name — AC: ac-3
  1014→  try {
  1015→    const gitUser = execSync("git config user.name", {
  1016→      encoding: "utf-8",
  1017→      stdio: ["pipe", "pipe", "ignore"],
  1018→    }).trim();
  1019→    if (gitUser) {
  1020→      return gitUser;
  1021→    }
  1022→  } catch {
  1023→    // git not available or not in a repo
  1024→  }
  1025→
  1026→  // 4. System user — AC: ac-3
  1027→  const systemUser = process.env.USER || process.env.USERNAME;
  1028→  if (systemUser) {
  1029→    return systemUser;
  1030→  }
  1031→
  1032→  // 5. No author available
  1033→  return undefined;
  1034→}
  1035→
  1036→/**
  1037→ * Create a new note entry.
  1038→ * If author is not provided, attempts to auto-detect from environment.
  1039→ */
  1040→export function createNote(
  1041→  content: string,
  1042→  author?: string,
  1043→  supersedes?: string,
  1044→): Note {
  1045→  return {
  1046→    _ulid: ulid(),
  1047→    created_at: new Date().toISOString(),
  1048→    author: author ?? getAuthor(),
  1049→    // Trim content to prevent whitespace-only lines from accumulating
  1050→    // in block scalars during YAML parse-stringify cycles
  1051→    content: content.trim(),
  1052→    supersedes: supersedes || null,
  1053→  };
  1054→}
  1055→
  1056→/**
  1057→ * Create a new todo item.
  1058→ * The id should be the next available id for the task's todos array.
  1059→ */
  1060→export function createTodo(id: number, text: string, addedBy?: string): Todo {
  1061→  return {
  1062→    id,
  1063→    // Trim text to prevent whitespace-only lines from accumulating
  1064→    // in block scalars during YAML parse-stringify cycles
  1065→    text: text.trim(),
  1066→    done: false,
  1067→    added_at: new Date().toISOString(),
  1068→    added_by: addedBy ?? getAuthor(),
  1069→  };
  1070→}
  1071→
  1072→/**
  1073→ * Check if task dependencies are met
  1074→ */
  1075→export function areDependenciesMet(
  1076→  task: LoadedTask,
  1077→  allTasks: LoadedTask[],
  1078→): boolean {
  1079→  if (task.depends_on.length === 0) return true;
  1080→
  1081→  for (const depRef of task.depends_on) {
  1082→    const depTask = findTaskByRef(allTasks, depRef);
  1083→    if (!depTask || depTask.status !== "completed") {
  1084→      return false;
  1085→    }
  1086→  }
  1087→
  1088→  return true;
  1089→}
  1090→
  1091→/**
  1092→ * Check if task is ready (pending/needs_work + deps met + not blocked)
  1093→ */
  1094→export function isTaskReady(task: LoadedTask, allTasks: LoadedTask[]): boolean {
  1095→  if (task.status !== "pending" && task.status !== "needs_work") return false;
  1096→  if (task.blocked_by.length > 0) return false;
  1097→  return areDependenciesMet(task, allTasks);
  1098→}
  1099→
  1100→/**
  1101→ * Get ready tasks (pending/needs_work + deps met + not blocked), sorted by
  1102→ * status (needs_work first), then priority, then creation time.
  1103→ * Within the same tier, older tasks come first (FIFO).
  1104→ */
  1105→export function getReadyTasks(tasks: LoadedTask[]): LoadedTask[] {
  1106→  return tasks
  1107→    .filter((task) => isTaskReady(task, tasks))
  1108→    .sort((a, b) => {
  1109→      // Primary: needs_work before pending (fix cycles take priority)
  1110→      const statusOrder = (s: string) => (s === "needs_work" ? 0 : 1);
  1111→      const statusDiff = statusOrder(a.status) - statusOrder(b.status);
  1112→      if (statusDiff !== 0) return statusDiff;
  1113→      // Secondary: priority (lower number = higher priority)
  1114→      if (a.priority !== b.priority) {
  1115→        return a.priority - b.priority;
  1116→      }
  1117→      // Tertiary: creation time (older first - FIFO within priority)
  1118→      return (
  1119→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime()
  1120→      );
  1121→    });
  1122→}
  1123→
  1124→// ============================================================
  1125→// SPEC ITEM LOADING
  1126→// ============================================================
  1127→
  1128→/**
  1129→ * Expand a glob-like include pattern to file paths.
  1130→ * Supports simple patterns like "modules/*.yaml" or "**\/*.yaml"
  1131→ */
  1132→export async function expandIncludePattern(
  1133→  pattern: string,
  1134→  baseDir: string,
  1135→): Promise<string[]> {
  1136→  const fullPattern = path.isAbsolute(pattern)
  1137→    ? pattern
  1138→    : path.join(baseDir, pattern);
  1139→
  1140→  // If no glob characters, just return the path if it exists
  1141→  if (!pattern.includes("*")) {
  1142→    try {
  1143→      await accessBufferAware(fullPattern);
  1144→      return [fullPattern];
  1145→    } catch {
  1146→      return [];
  1147→    }
  1148→  }
  1149→
  1150→  // Split pattern into directory part and file pattern
  1151→  const parts = pattern.split("/");
  1152→  let currentDir = baseDir;
  1153→  const result: string[] = [];
  1154→
  1155→  // Find the first part with a glob
  1156→  const globIndex = parts.findIndex((p) => p.includes("*"));
  1157→
  1158→  // Navigate to the directory before the glob
  1159→  if (globIndex > 0) {
  1160→    currentDir = path.join(baseDir, ...parts.slice(0, globIndex));
  1161→  }
  1162→
  1163→  // Get the remaining pattern
  1164→  const remainingPattern = parts.slice(globIndex).join("/");
  1165→
  1166→  await expandGlobRecursive(currentDir, remainingPattern, result);
  1167→  return result;
  1168→}
  1169→
  1170→/**
  1171→ * Recursively expand glob patterns
  1172→ */
  1173→async function expandGlobRecursive(
  1174→  dir: string,
  1175→  pattern: string,
  1176→  result: string[],
  1177→): Promise<void> {
  1178→  const parts = pattern.split("/");
  1179→  const currentPattern = parts[0];
  1180→  const remainingPattern = parts.slice(1).join("/");
  1181→
  1182→  try {
  1183→    const entries = await readdirBufferAware(dir, { withFileTypes: true }) as Dirent[];
  1184→
  1185→    for (const entry of entries) {
  1186→      const matches = matchGlobPart(entry.name, currentPattern);
  1187→
  1188→      if (matches) {
  1189→        const fullPath = path.join(dir, entry.name);
  1190→
  1191→        if (remainingPattern) {
  1192→          // More pattern parts to process
  1193→          if (entry.isDirectory()) {
  1194→            await expandGlobRecursive(fullPath, remainingPattern, result);
  1195→          }
  1196→        } else {
  1197→          // This is the final pattern part
  1198→          if (currentPattern === "**") {
  1199→            // ** matches any depth - need special handling
  1200→            if (entry.isDirectory()) {
  1201→              await expandGlobRecursive(fullPath, "**", result);
  1202→            }
  1203→            // Also match files at this level
  1204→            result.push(fullPath);
  1205→          } else if (entry.isFile()) {
  1206→            result.push(fullPath);
  1207→          }
  1208→        }
  1209→      }
  1210→
  1211→      // Handle ** - also recurse into directories without consuming the pattern
  1212→      if (currentPattern === "**" && entry.isDirectory()) {
  1213→        const fullPath = path.join(dir, entry.name);
  1214→        await expandGlobRecursive(fullPath, pattern, result);
  1215→      }
  1216→    }
  1217→  } catch {
  1218→    // Directory doesn't exist or not readable
  1219→  }
  1220→}
  1221→
  1222→/**
  1223→ * Match a single path component against a glob pattern part
  1224→ */
  1225→function matchGlobPart(name: string, pattern: string): boolean {
  1226→  if (pattern === "*") return true;
  1227→  if (pattern === "**") return true;
  1228→
  1229→  // Convert glob pattern to regex
  1230→  const regexPattern = pattern
  1231→    .replace(/[.+^${}()|[\]\\]/g, "\\$&") // Escape special regex chars
  1232→    .replace(/\*/g, ".*") // * matches anything
  1233→    .replace(/\?/g, "."); // ? matches single char
  1234→
  1235→  const regex = new RegExp(`^${regexPattern}$`);
  1236→  return regex.test(name);
  1237→}
  1238→
  1239→/**
  1240→ * Fields that may contain nested spec items
  1241→ */
  1242→const NESTED_ITEM_FIELDS = [
  1243→  "modules",
  1244→  "features",
  1245→  "requirements",
  1246→  "constraints",
  1247→  "decisions",
  1248→  "traits",
  1249→  "acceptance_criteria",
  1250→];
  1251→
  1252→/**
  1253→ * Recursively extract all spec items from a raw YAML structure.
  1254→ * Items can be nested under modules/features/requirements/etc.
  1255→ * Tracks the path within the file for each item.
  1256→ */
  1257→export function extractItemsFromRaw(
  1258→  raw: unknown,
  1259→  sourceFile: string,
  1260→  items: LoadedSpecItem[] = [],
  1261→  currentPath: string = "",
  1262→): LoadedSpecItem[] {
  1263→  if (!raw || typeof raw !== "object") {
  1264→    return items;
  1265→  }
  1266→
  1267→  // Check if this object is itself a spec item (has _ulid)
  1268→  if (
  1269→    "_ulid" in raw &&
  1270→    typeof (raw as Record<string, unknown>)._ulid === "string"
  1271→  ) {
  1272→    // Strip nested item arrays before validation since they're processed separately
  1273→    // and the SpecItemSchema expects refs (strings), not nested objects
  1274→    const rawObj = raw as Record<string, unknown>;
  1275→    const cleanedForValidation: Record<string, unknown> = { ...rawObj };
  1276→    for (const field of NESTED_ITEM_FIELDS) {
  1277→      if (field in cleanedForValidation && Array.isArray(cleanedForValidation[field])) {
  1278→        const arr = cleanedForValidation[field] as unknown[];
  1279→        // Check if array contains nested items (objects with _ulid) vs refs (strings)
  1280→        const hasNestedItems = arr.some(
  1281→          (item) =>
  1282→            item && typeof item === "object" && "_ulid" in (item as Record<string, unknown>)
  1283→        );
  1284→        if (hasNestedItems) {
  1285→          // Strip nested items - they'll be extracted recursively
  1286→          delete cleanedForValidation[field];
  1287→        }
  1288→      }
  1289→    }
  1290→
  1291→    const result = SpecItemSchema.safeParse(cleanedForValidation);
  1292→    if (result.success) {
  1293→      items.push({
  1294→        ...result.data,
  1295→        _sourceFile: sourceFile,
  1296→        _path: currentPath || undefined,
  1297→      });
  1298→    }
  1299→
  1300→    // Even if the item itself was added, also extract nested items
  1301→    for (const field of NESTED_ITEM_FIELDS) {
  1302→      if (field in rawObj && Array.isArray(rawObj[field])) {
  1303→        const arr = rawObj[field] as unknown[];
  1304→        for (let i = 0; i < arr.length; i++) {
  1305→          const nestedPath = currentPath
  1306→            ? `${currentPath}.${field}[${i}]`
  1307→            : `${field}[${i}]`;
  1308→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
  1309→        }
  1310→      }
  1311→    }
  1312→  } else if (Array.isArray(raw)) {
  1313→    // Array of items at root level
  1314→    for (let i = 0; i < raw.length; i++) {
  1315→      const itemPath = currentPath ? `${currentPath}[${i}]` : `[${i}]`;
  1316→      extractItemsFromRaw(raw[i], sourceFile, items, itemPath);
  1317→    }
  1318→  } else {
  1319→    // Object that might contain item arrays (like manifest with modules/features/etc)
  1320→    const rawObj = raw as Record<string, unknown>;
  1321→    for (const field of NESTED_ITEM_FIELDS) {
  1322→      if (field in rawObj && Array.isArray(rawObj[field])) {
  1323→        const arr = rawObj[field] as unknown[];
  1324→        for (let i = 0; i < arr.length; i++) {
  1325→          const nestedPath = currentPath
  1326→            ? `${currentPath}.${field}[${i}]`
  1327→            : `${field}[${i}]`;
  1328→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
  1329→        }
  1330→      }
  1331→    }
  1332→  }
  1333→
  1334→  return items;
  1335→}
  1336→
  1337→/**
  1338→ * Load spec items from a single file.
  1339→ * Handles module files (the file itself is an item with nested children).
  1340→ */
  1341→export async function loadSpecFile(
  1342→  filePath: string,
  1343→): Promise<LoadedSpecItem[]> {
  1344→  try {
  1345→    const content = await readFileBufferAware(filePath);
  1346→    const items: LoadedSpecItem[] = [];
  1347→
  1348→    // Parse all YAML documents in the file (handles files with ---)
  1349→    const documents = YAML.parseAllDocuments(content);
  1350→
  1351→    for (const doc of documents) {
  1352→      if (doc.errors.length > 0) {
  1353→        // Skip documents with parse errors
  1354→        continue;
  1355→      }
  1356→
  1357→      const raw = doc.toJS();
  1358→      if (raw) {
  1359→        const docItems = extractItemsFromRaw(raw, filePath);
  1360→        items.push(...docItems);
  1361→      }
  1362→    }
  1363→
  1364→    return items;
  1365→  } catch (_error) {
  1366→    // File doesn't exist or parse error
  1367→    return [];
  1368→  }
  1369→}
  1370→
  1371→/**
  1372→ * Load all spec items from the project.
  1373→ * Parses manifest, follows includes, and builds unified collection.
  1374→ */
  1375→export async function loadAllItems(
  1376→  ctx: KspecContext,
  1377→): Promise<LoadedSpecItem[]> {
  1378→  const items: LoadedSpecItem[] = [];
  1379→
  1380→  if (!ctx.manifest || !ctx.manifestPath) {
  1381→    return items;
  1382→  }
  1383→
  1384→  const manifestDir = path.dirname(ctx.manifestPath);
  1385→
  1386→  // Extract items from manifest itself (inline modules/features/etc)
  1387→  const manifestItems = extractItemsFromRaw(ctx.manifest, ctx.manifestPath);
  1388→  items.push(...manifestItems);
  1389→
  1390→  // Process includes
  1391→  const includes = ctx.manifest.includes || [];
  1392→
  1393→  for (const include of includes) {
  1394→    const expandedPaths = await expandIncludePattern(include, manifestDir);
  1395→
  1396→    for (const filePath of expandedPaths) {
  1397→      const fileItems = await loadSpecFile(filePath);
  1398→      items.push(...fileItems);
  1399→    }
  1400→  }
  1401→
  1402→  return items;
  1403→}
  1404→
  1405→/**
  1406→ * Find a spec item by reference (ULID, slug, or short reference)
  1407→ */
  1408→export function findItemByRef(
  1409→  items: LoadedSpecItem[],
  1410→  ref: string,
  1411→): LoadedSpecItem | undefined {
  1412→  // Remove @ prefix if present
  1413→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1414→
  1415→  return items.find((item) => {
  1416→    // Match full ULID
  1417→    if (item._ulid === cleanRef) return true;
  1418→
  1419→    // Match short ULID (prefix)
  1420→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  1421→      return true;
  1422→
  1423→    // Match slug
  1424→    if (item.slugs.includes(cleanRef)) return true;
  1425→
  1426→    return false;
  1427→  });
  1428→}
  1429→
  1430→/**
  1431→ * Combined item type for unified queries across tasks and spec items
  1432→ */
  1433→export type AnyLoadedItem = LoadedTask | LoadedSpecItem;
  1434→
  1435→/**
  1436→ * Find any item (task or spec item) by reference
  1437→ */
  1438→export function findAnyItemByRef(
  1439→  tasks: LoadedTask[],
  1440→  items: LoadedSpecItem[],
  1441→  ref: string,
  1442→): AnyLoadedItem | undefined {
  1443→  // Try tasks first (more commonly referenced)
  1444→  const task = findTaskByRef(tasks, ref);
  1445→  if (task) return task;
  1446→
  1447→  // Then try spec items
  1448→  return findItemByRef(items, ref);
  1449→}
  1450→
  1451→/**
  1452→ * Build a ReferenceIndex from context.
  1453→ * Loads all tasks and spec items, then builds the index.
  1454→ */
  1455→export async function buildReferenceIndex(ctx: KspecContext): Promise<{
  1456→  index: ReferenceIndex;
  1457→  tasks: LoadedTask[];
  1458→  items: LoadedSpecItem[];
  1459→}> {
  1460→  const tasks = await loadAllTasks(ctx);
  1461→  const items = await loadAllItems(ctx);
  1462→  const index = new ReferenceIndex(tasks, items);
  1463→  return { index, tasks, items };
  1464→}
  1465→
  1466→/**
  1467→ * Build both ReferenceIndex and ItemIndex from context.
  1468→ * Use this when you need query capabilities in addition to reference resolution.
  1469→ * Pass plans for cross-namespace slug collision detection (plans aren't loaded by default
  1470→ * to avoid circular dependency with plans.ts).
  1471→ */
  1472→export async function buildIndexes(ctx: KspecContext, plans: LoadedPlan[] = []): Promise<{
  1473→  refIndex: ReferenceIndex;
  1474→  itemIndex: ItemIndex;
  1475→  traitIndex: TraitIndex;
  1476→  tasks: LoadedTask[];
  1477→  items: LoadedSpecItem[];
  1478→}> {
  1479→  const tasks = await loadAllTasks(ctx);
  1480→  const items = await loadAllItems(ctx);
  1481→  const refIndex = new ReferenceIndex(tasks, items, [], plans);
  1482→  const itemIndex = new ItemIndex(tasks, items);
  1483→  const traitIndex = new TraitIndex(items, refIndex);
  1484→  return { refIndex, itemIndex, traitIndex, tasks, items };
  1485→}
  1486→
  1487→// ============================================================
  1488→// SPEC ITEM CRUD (supports nested structures)
  1489→// ============================================================
  1490→
  1491→/**
  1492→ * Strip runtime metadata from spec item before serialization
  1493→ */
  1494→function stripSpecItemMetadata(item: LoadedSpecItem): SpecItem {
  1495→  const { _sourceFile, _path, ...cleanItem } = item;
  1496→  return cleanItem as SpecItem;
  1497→}
  1498→
  1499→function assertSpecItemPatch(
  1500→  updates: Partial<SpecItemInput>,
  1501→  operation: "updateSpecItem" | "saveSpecItem",
  1502→): void {
  1503→  const patch = updates as Record<string, unknown>;
  1504→  if ("_sourceFile" in patch || "_path" in patch) {
  1505→    throw new Error(
  1506→      `${operation} expects a patch object, not a full LoadedSpecItem. Pass only intended fields to update.`,
  1507→    );
  1508→  }
  1509→}
  1510→
  1511→/**
  1512→ * Parse a path string into segments.
  1513→ * e.g., "features[0].requirements[2]" -> [["features", 0], ["requirements", 2]]
  1514→ */
  1515→function parsePath(pathStr: string): Array<[string, number]> {
  1516→  const segments: Array<[string, number]> = [];
  1517→  const regex = /(\w+)\[(\d+)\]/g;
  1518→  let match;
  1519→  while ((match = regex.exec(pathStr)) !== null) {
  1520→    segments.push([match[1], parseInt(match[2], 10)]);
  1521→  }
  1522→  return segments;
  1523→}
  1524→
  1525→/**
  1526→ * Navigate to a location in a YAML structure using a path.
  1527→ * Returns the parent object and the array containing the target item.
  1528→ */
  1529→function navigateToPath(
  1530→  root: unknown,
  1531→  pathStr: string,
  1532→): { parent: Record<string, unknown>; array: unknown[]; index: number } | null {
  1533→  if (!pathStr) return null;
  1534→
  1535→  const segments = parsePath(pathStr);
  1536→  if (segments.length === 0) return null;
  1537→
  1538→  let current: unknown = root;
  1539→
  1540→  // Navigate to the parent of the last segment
  1541→  for (let i = 0; i < segments.length - 1; i++) {
  1542→    const [field, index] = segments[i];
  1543→    if (typeof current !== "object" || current === null) return null;
  1544→    const obj = current as Record<string, unknown>;
  1545→    if (!Array.isArray(obj[field])) return null;
  1546→    current = (obj[field] as unknown[])[index];
  1547→  }
  1548→
  1549→  // Get the final array and index
  1550→  const [finalField, finalIndex] = segments[segments.length - 1];
  1551→  if (typeof current !== "object" || current === null) return null;
  1552→  const parent = current as Record<string, unknown>;
  1553→  if (!Array.isArray(parent[finalField])) return null;
  1554→
  1555→  return {
  1556→    parent,
  1557→    array: parent[finalField] as unknown[],
  1558→    index: finalIndex,
  1559→  };
  1560→}
  1561→
  1562→/**
  1563→ * Find an item by ULID in a nested YAML structure.
  1564→ * Returns the path segments to reach it.
  1565→ */
  1566→function findItemInStructure(
  1567→  root: unknown,
  1568→  ulid: string,
  1569→  currentPath: string = "",
  1570→): { path: string; item: Record<string, unknown> } | null {
  1571→  if (!root || typeof root !== "object") return null;
  1572→
  1573→  const obj = root as Record<string, unknown>;
  1574→
  1575→  // Check if this is the item we're looking for
  1576→  if (obj._ulid === ulid) {
  1577→    return { path: currentPath, item: obj };
  1578→  }
  1579→
  1580→  // Search nested item fields
  1581→  for (const field of NESTED_ITEM_FIELDS) {
  1582→    if (Array.isArray(obj[field])) {
  1583→      const arr = obj[field] as unknown[];
  1584→      for (let i = 0; i < arr.length; i++) {
  1585→        const nestedPath = currentPath
  1586→          ? `${currentPath}.${field}[${i}]`
  1587→          : `${field}[${i}]`;
  1588→        const result = findItemInStructure(arr[i], ulid, nestedPath);
  1589→        if (result) return result;
  1590→      }
  1591→    }
  1592→  }
  1593→
  1594→  return null;
  1595→}
  1596→
  1597→/**
  1598→ * Create a new spec item with auto-generated fields
  1599→ */
  1600→export function createSpecItem(input: SpecItemInput): SpecItem {
  1601→  return {
  1602→    _ulid: input._ulid || ulid(),
  1603→    slugs: input.slugs || [],
  1604→    title: input.title,
  1605→    type: input.type,
  1606→    status: input.status,
  1607→    priority: input.priority,
  1608→    tags: input.tags || [],
  1609→    description: input.description,
  1610→    acceptance_criteria: input.acceptance_criteria,
  1611→    depends_on: input.depends_on || [],
  1612→    implements: input.implements || [],
  1613→    relates_to: input.relates_to || [],
  1614→    tests: input.tests || [],
  1615→    traits: input.traits || [],
  1616→    notes: input.notes || [],
  1617→    created: input.created || new Date().toISOString(),
  1618→    created_by: input.created_by,
  1619→  };
  1620→}
  1621→
  1622→/**
  1623→ * Map from item type to the field name used to store children of that type.
  1624→ */
  1625→const TYPE_TO_CHILD_FIELD: Record<string, string> = {
  1626→  feature: "features",
  1627→  requirement: "requirements",
  1628→  constraint: "constraints",
  1629→  decision: "decisions",
  1630→  module: "modules",
  1631→  trait: "traits",
  1632→};
  1633→
  1634→/**
  1635→ * Add a spec item as a child of a parent item.
  1636→ * @param parent The parent item to add under
  1637→ * @param child The new child item to add
  1638→ * @param childField Optional field name override (defaults based on child.type)
  1639→ */
  1640→export async function addChildItem(
  1641→  _ctx: KspecContext,
  1642→  parent: LoadedSpecItem,
  1643→  child: SpecItem,
  1644→  childField?: string,
  1645→): Promise<{ item: SpecItem; path: string }> {
  1646→  if (!parent._sourceFile) {
  1647→    throw new Error("Parent item has no source file");
  1648→  }
  1649→
  1650→  const field =
  1651→    childField || TYPE_TO_CHILD_FIELD[child.type || "feature"] || "features";
  1652→
  1653→  // Lock the file to prevent concurrent read-modify-write races
  1654→  return withFileLock(parent._sourceFile, async () => {
  1655→    // Load the raw YAML
  1656→    const raw = await readYamlFile<unknown>(parent._sourceFile!);
  1657→
  1658→    // Find the parent in the structure
  1659→    let parentObj: Record<string, unknown>;
  1660→    let parentPath: string;
  1661→
  1662→    if (parent._path) {
  1663→      const nav = navigateToPath(raw, parent._path);
  1664→      if (!nav) {
  1665→        throw new Error(`Could not navigate to parent path: ${parent._path}`);
  1666→      }
  1667→      parentObj = nav.array[nav.index] as Record<string, unknown>;
  1668→      parentPath = parent._path;
  1669→    } else {
  1670→      // Parent is the root item
  1671→      parentObj = raw as Record<string, unknown>;
  1672→      parentPath = "";
  1673→    }
  1674→
  1675→    // Ensure the child field array exists
  1676→    if (!Array.isArray(parentObj[field])) {
  1677→      parentObj[field] = [];
  1678→    }
  1679→
  1680→    // Add the child
  1681→    const childArray = parentObj[field] as unknown[];
  1682→    const cleanChild = stripSpecItemMetadata(child as LoadedSpecItem);
  1683→    childArray.push(cleanChild);
  1684→
  1685→    // Calculate the new child's path
  1686→    const childIndex = childArray.length - 1;
  1687→    const childPath = parentPath
  1688→      ? `${parentPath}.${field}[${childIndex}]`
  1689→      : `${field}[${childIndex}]`;
  1690→
  1691→    // Write back with format preservation
  1692→    await writeYamlFilePreserveFormat(parent._sourceFile!, raw);
  1693→
  1694→    return { item: cleanChild, path: childPath };
  1695→  });
  1696→}
  1697→
  1698→/**
  1699→ * Add a trait item to the project-level traits array in kynetic.yaml.
  1700→ */
  1701→export async function addProjectLevelTraitItem(
  1702→  ctx: KspecContext,
  1703→  item: SpecItem,
  1704→): Promise<{ item: SpecItem; path: string }> {
  1705→  if (!ctx.manifestPath) {
  1706→    throw new Error("Could not find kynetic.yaml");
  1707→  }
  1708→
  1709→  return withFileLock(ctx.manifestPath, async () => {
  1710→    const manifest = await readYamlFile<Record<string, unknown>>(
  1711→      ctx.manifestPath!,
  1712→    );
  1713→
  1714→    if (!manifest) {
  1715→      throw new Error("Could not load kynetic.yaml");
  1716→    }
  1717→
  1718→    if (!Array.isArray(manifest.traits)) {
  1719→      manifest.traits = [];
  1720→    }
  1721→
  1722→    const cleanItem = stripSpecItemMetadata(item as LoadedSpecItem);
  1723→    (manifest.traits as unknown[]).push(cleanItem);
  1724→
  1725→    await writeYamlFilePreserveFormat(ctx.manifestPath!, manifest);
  1726→
  1727→    const traitIndex = (manifest.traits as unknown[]).length - 1;
  1728→    return {
  1729→      item: cleanItem,
  1730→      path: `traits[${traitIndex}]`,
  1731→    };
  1732→  });
  1733→}
  1734→
  1735→/**
  1736→ * Update a spec item in place within its source file.
  1737→ * Works with nested structures using the _path field.
  1738→ */
  1739→export async function updateSpecItem(
  1740→  _ctx: KspecContext,
  1741→  item: LoadedSpecItem,
  1742→  updates: Partial<SpecItemInput>,
  1743→): Promise<SpecItem> {
  1744→  if (!item._sourceFile) {
  1745→    throw new Error("Item has no source file");
  1746→  }
  1747→  assertSpecItemPatch(updates, "updateSpecItem");
  1748→
  1749→  // Lock the file to prevent concurrent read-modify-write races
  1750→  return withFileLock(item._sourceFile, async () => {
  1751→    // Load the raw YAML
  1752→    const raw = await readYamlFile<unknown>(item._sourceFile!);
  1753→
  1754→    // Find the item in the structure (use stored path or search by ULID)
  1755→    let targetObj: Record<string, unknown>;
  1756→
  1757→    if (item._path) {
  1758→      const nav = navigateToPath(raw, item._path);
  1759→      const candidate = nav?.array[nav.index];
  1760→      if (
  1761→        candidate &&
  1762→        typeof candidate === "object" &&
  1763→        (candidate as Record<string, unknown>)._ulid === item._ulid
  1764→      ) {
  1765→        targetObj = candidate as Record<string, unknown>;
  1766→      } else {
  1767→        const found = findItemInStructure(raw, item._ulid);
  1768→        if (!found) {
  1769→          throw new Error(
  1770→            `Could not find item ${item._ulid} in structure (path: ${item._path})`,
  1771→          );
  1772→        }
  1773→        targetObj = found.item;
  1774→      }
  1775→    } else {
  1776→      // Item might be the root, or we need to find it
  1777→      const found = findItemInStructure(raw, item._ulid);
  1778→      if (found) {
  1779→        targetObj = found.item;
  1780→      } else if ((raw as Record<string, unknown>)._ulid === item._ulid) {
  1781→        targetObj = raw as Record<string, unknown>;
  1782→      } else {
  1783→        throw new Error(`Could not find item ${item._ulid} in structure`);
  1784→      }
  1785→    }
  1786→
  1787→    // Apply updates (but never change _ulid)
  1788→    for (const [key, value] of Object.entries(updates)) {
  1789→      if (key !== "_ulid" && key !== "_sourceFile" && key !== "_path") {
  1790→        targetObj[key] = value;
  1791→      }
  1792→    }
  1793→
  1794→    // Write back with format preservation
  1795→    await writeYamlFilePreserveFormat(item._sourceFile!, raw);
  1796→
  1797→    return { ...item, ...updates, _ulid: item._ulid } as SpecItem;
  1798→  });
  1799→}
  1800→
  1801→/**
  1802→ * Check if an item is a trait with implementors.
  1803→ * Returns array of items that use this trait via the 'traits' field.
  1804→ */
  1805→export function findTraitImplementors(
  1806→  trait: LoadedSpecItem,
  1807→  allItems: LoadedSpecItem[],
  1808→): LoadedSpecItem[] {
  1809→  // Check if the item is actually a trait
  1810→  if (trait.type !== "trait") {
  1811→    return [];
  1812→  }
  1813→
  1814→  // Find all items that reference this trait in their 'traits' array
  1815→  const traitRefs = [`@${trait._ulid}`, ...trait.slugs.map((s) => `@${s}`)];
  1816→  return allItems.filter((item) => {
  1817→    if (!item.traits || item.traits.length === 0) return false;
  1818→    return item.traits.some((traitRef: string) => traitRefs.includes(traitRef));
  1819→  });
  1820→}
  1821→
  1822→/**
  1823→ * Delete a spec item from its source file.
  1824→ * Works with nested structures using the _path field.
  1825→ */
  1826→export async function deleteSpecItem(
  1827→  _ctx: KspecContext,
  1828→  item: LoadedSpecItem,
  1829→): Promise<boolean> {
  1830→  if (!item._sourceFile) {
  1831→    return false;
  1832→  }
  1833→
  1834→  // Lock the file to prevent concurrent read-modify-write races
  1835→  return withFileLock(item._sourceFile, async () => {
  1836→    try {
  1837→      const raw = await readYamlFile<unknown>(item._sourceFile!);
  1838→
  1839→      // If item has a path, navigate to it and remove from parent array
  1840→      if (item._path) {
  1841→        const nav = navigateToPath(raw, item._path);
  1842→        if (!nav) {
  1843→          return false;
  1844→        }
  1845→        // Remove the item from the array
  1846→        nav.array.splice(nav.index, 1);
  1847→        await writeYamlFilePreserveFormat(item._sourceFile!, raw);
  1848→        return true;
  1849→      }
  1850→
  1851→      // No path - try to find it by ULID
  1852→      const found = findItemInStructure(raw, item._ulid);
  1853→      if (found?.path) {
  1854→        const nav = navigateToPath(raw, found.path);
  1855→        if (nav) {
  1856→          nav.array.splice(nav.index, 1);
  1857→          await writeYamlFilePreserveFormat(item._sourceFile!, raw);
  1858→          return true;
  1859→        }
  1860→      }
  1861→
  1862→      // Maybe it's a root-level array item
  1863→      if (Array.isArray(raw)) {
  1864→        const index = raw.findIndex(
  1865→          (i: unknown) =>
  1866→            typeof i === "object" &&
  1867→            i !== null &&
  1868→            (i as Record<string, unknown>)._ulid === item._ulid,
  1869→        );
  1870→        if (index >= 0) {
  1871→          raw.splice(index, 1);
  1872→          await writeYamlFilePreserveFormat(item._sourceFile!, raw);
  1873→          return true;
  1874→        }
  1875→      }
  1876→
  1877→      return false;
  1878→    } catch {
  1879→      return false;
  1880→    }
  1881→  });
  1882→}
  1883→
  1884→/**
  1885→ * Save a spec item - either updates existing or adds to parent.
  1886→ * For new items, use addChildItem instead.
  1887→ */
  1888→export async function saveSpecItem(
  1889→  ctx: KspecContext,
  1890→  item: LoadedSpecItem,
  1891→  updates: Partial<SpecItemInput>,
  1892→): Promise<void> {
  1893→  assertSpecItemPatch(updates, "saveSpecItem");
  1894→
  1895→  if (Object.keys(updates).length === 0) {
  1896→    throw new Error("Cannot save spec item without updates. Pass a patch.");
  1897→  }
  1898→
  1899→  // If item has a source file and path, it's an update
  1900→  if (item._sourceFile && item._path) {
  1901→    await updateSpecItem(ctx, item, updates);
  1902→    return;
  1903→  }
  1904→
  1905→  // Otherwise, this is more complex - would need a parent
  1906→  throw new Error(
  1907→    "Cannot save new item without parent. Use addChildItem instead.",
  1908→  );
  1909→}
  1910→
  1911→// ============================================================
  1912→// INBOX SYSTEM
  1913→// ============================================================
  1914→
  1915→/**
  1916→ * Inbox item with runtime metadata for source tracking.
  1917→ */
  1918→export interface LoadedInboxItem extends InboxItem {
  1919→  _sourceFile?: string;
  1920→}
  1921→
  1922→/**
  1923→ * Get the inbox file path.
  1924→ *
  1925→ * When shadow enabled: .kspec/project.inbox.yaml
  1926→ * Otherwise: spec/project.inbox.yaml
  1927→ */
  1928→export function getInboxFilePath(ctx: KspecContext): string {
  1929→  return path.join(ctx.specDir, "project.inbox.yaml");
  1930→}
  1931→
  1932→/**
  1933→ * Parse inbox items from raw YAML payload.
  1934→ *
  1935→ * Supports canonical { inbox: [...] } shape and legacy plain-array shape.
  1936→ */
  1937→function parseInboxItemsFromRaw(raw: unknown): InboxItem[] {
  1938→  // Handle { inbox: [...] } format
  1939→  if (raw && typeof raw === "object" && "inbox" in raw) {
  1940→    const parsed = InboxFileSchema.safeParse(raw);
  1941→    if (parsed.success) {
  1942→      return parsed.data.inbox;
  1943→    }
  1944→
  1945→    const fallbackItems = (raw as { inbox?: unknown }).inbox;
  1946→    if (Array.isArray(fallbackItems)) {
  1947→      const items: InboxItem[] = [];
  1948→      for (const item of fallbackItems) {
  1949→        const result = InboxItemSchema.safeParse(item);
  1950→        if (result.success) {
  1951→          items.push(result.data);
  1952→        }
  1953→      }
  1954→      return items;
  1955→    }
  1956→  }
  1957→
  1958→  // Handle plain array format
  1959→  if (Array.isArray(raw)) {
  1960→    const items: InboxItem[] = [];
  1961→    for (const item of raw) {
  1962→      const result = InboxItemSchema.safeParse(item);
  1963→      if (result.success) {
  1964→        items.push(result.data);
  1965→      }
  1966→    }
  1967→    return items;
  1968→  }
  1969→
  1970→  return [];
  1971→}
  1972→
  1973→/**
  1974→ * Load inbox items from an explicit file path.
  1975→ */
  1976→async function loadInboxItemsFromFile(inboxPath: string): Promise<InboxItem[]> {
  1977→  const raw = await readYamlFile<unknown>(inboxPath);
  1978→  return parseInboxItemsFromRaw(raw);
  1979→}
  1980→
  1981→/**
  1982→ * Load all inbox items from the project.
  1983→ */
  1984→export async function loadInboxItems(
  1985→  ctx: KspecContext,
  1986→): Promise<LoadedInboxItem[]> {
  1987→  const inboxPath = getInboxFilePath(ctx);
  1988→
  1989→  try {
  1990→    const items = await loadInboxItemsFromFile(inboxPath);
  1991→    return items.map((item) => ({
  1992→      ...item,
  1993→      _sourceFile: inboxPath,
  1994→    }));
  1995→  } catch {
  1996→    // File doesn't exist or parse error
  1997→    return [];
  1998→  }
  1999→}
  2000→
  2001→/**
  2002→ * Create a new inbox item with auto-generated fields.
  2003→ *
  2004→ * AC: @config-author — supports config author in fallback chain
  2005→ *
  2006→ * @param input Inbox item input
  2007→ * @param configAuthor Optional author from kspec.config.yaml identity.author
  2008→ */
  2009→export function createInboxItem(
  2010→  input: InboxItemInput,
  2011→  configAuthor?: string | null,
  2012→): InboxItem {
  2013→  return {
  2014→    _ulid: input._ulid || ulid(),
  2015→    text: input.text,
  2016→    created_at: input.created_at || new Date().toISOString(),
  2017→    tags: input.tags || [],
  2018→    added_by: input.added_by ?? getAuthor(configAuthor),
  2019→  };
  2020→}
  2021→
  2022→/**
  2023→ * Strip runtime metadata before serialization.
  2024→ */
  2025→function stripInboxMetadata(item: LoadedInboxItem | InboxItem): InboxItem {
  2026→  const { _sourceFile, ...cleanItem } = item as LoadedInboxItem;
  2027→  return cleanItem as InboxItem;
  2028→}
  2029→
  2030→/**
  2031→ * Save an inbox item (add or update).
  2032→ */
  2033→export async function saveInboxItem(
  2034→  ctx: KspecContext,
  2035→  item: LoadedInboxItem,
  2036→): Promise<void> {
  2037→  const inboxPath = getInboxFilePath(ctx);
  2038→
  2039→  // Lock the file to prevent concurrent read-modify-write races
  2040→  await withFileLock(inboxPath, async () => {
  2041→    // Ensure directory exists
  2042→    const dir = path.dirname(inboxPath);
  2043→    await fs.mkdir(dir, { recursive: true });
  2044→
  2045→    // Load existing items
  2046→    let existingItems: InboxItem[] = [];
  2047→
  2048→    try {
  2049→      existingItems = await loadInboxItemsFromFile(inboxPath);
  2050→    } catch {
  2051→      // File doesn't exist, start fresh
  2052→    }
  2053→
  2054→    const cleanItem = stripInboxMetadata(item);
  2055→
  2056→    // Update existing or add new
  2057→    const existingIndex = existingItems.findIndex(
  2058→      (i) => i._ulid === item._ulid,
  2059→    );
  2060→    if (existingIndex >= 0) {
  2061→      existingItems[existingIndex] = cleanItem;
  2062→    } else {
  2063→      existingItems.push(cleanItem);
  2064→    }
  2065→
  2066→    // Save with { inbox: [...] } format and format preservation
  2067→    await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  2068→  });
  2069→}
  2070→
  2071→/**
  2072→ * Atomically mutate an inbox item using the latest on-disk state.
  2073→ *
  2074→ * The callback receives the current item value while holding the inbox file lock,
  2075→ * so concurrent writers do not clobber unrelated fields (for example text vs tags).
  2076→ */
  2077→export async function mutateInboxItemAtomically(
  2078→  ctx: KspecContext,
  2079→  item: LoadedInboxItem,
  2080→  mutate: (
  2081→    latestItem: LoadedInboxItem,
  2082→  ) => InboxItem | LoadedInboxItem | Promise<InboxItem | LoadedInboxItem>,
  2083→): Promise<LoadedInboxItem> {
  2084→  const inboxPath = item._sourceFile || getInboxFilePath(ctx);
  2085→  let updatedItem: LoadedInboxItem | undefined;
  2086→
  2087→  await withFileLock(inboxPath, async () => {
  2088→    // Ensure directory exists (important for default path in new repos)
  2089→    const dir = path.dirname(inboxPath);
  2090→    await fs.mkdir(dir, { recursive: true });
  2091→
  2092→    let existingItems: InboxItem[] = [];
  2093→    try {
  2094→      existingItems = await loadInboxItemsFromFile(inboxPath);
  2095→    } catch {
  2096→      throw new Error(`Inbox file not found: ${inboxPath}`);
  2097→    }
  2098→
  2099→    const itemIndex = existingItems.findIndex(
  2100→      (existingItem) => existingItem._ulid === item._ulid,
  2101→    );
  2102→    if (itemIndex === -1) {
  2103→      throw new Error(`Inbox item not found in file: ${item._ulid}`);
  2104→    }
  2105→
  2106→    const latestItem: LoadedInboxItem = {
  2107→      ...existingItems[itemIndex],
  2108→      _sourceFile: inboxPath,
  2109→    };
  2110→
  2111→    const mutatedItem = await mutate(latestItem);
  2112→    const cleanMutatedItem = stripInboxMetadata(mutatedItem);
  2113→    existingItems[itemIndex] = cleanMutatedItem;
  2114→
  2115→    await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  2116→
  2117→    updatedItem = {
  2118→      ...cleanMutatedItem,
  2119→      _sourceFile: inboxPath,
  2120→    };
  2121→  });
  2122→
  2123→  if (!updatedItem) {
  2124→    throw new Error(`Failed to mutate inbox item atomically: ${item._ulid}`);
  2125→  }
  2126→
  2127→  return updatedItem;
  2128→}
  2129→
  2130→/**
  2131→ * Delete an inbox item by ULID.
  2132→ */
  2133→export async function deleteInboxItem(
  2134→  ctx: KspecContext,
  2135→  ulid: string,
  2136→): Promise<boolean> {
  2137→  const inboxPath = getInboxFilePath(ctx);
  2138→
  2139→  // Lock the file to prevent concurrent read-modify-write races
  2140→  return withFileLock(inboxPath, async () => {
  2141→    try {
  2142→      const existingItems = await loadInboxItemsFromFile(inboxPath);
  2143→
  2144→      const index = existingItems.findIndex((i) => i._ulid === ulid);
  2145→      if (index < 0) {
  2146→        return false;
  2147→      }
  2148→
  2149→      existingItems.splice(index, 1);
  2150→      await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  2151→      return true;
  2152→    } catch {
  2153→      return false;
  2154→    }
  2155→  });
  2156→}
  2157→
  2158→/**
  2159→ * Find an inbox item by reference (ULID or short ULID).
  2160→ */
  2161→export function findInboxItemByRef(
  2162→  items: LoadedInboxItem[],
  2163→  ref: string,
  2164→): LoadedInboxItem | undefined {
  2165→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  2166→
  2167→  return items.find((item) => {
  2168→    // Match full ULID
  2169→    if (item._ulid === cleanRef) return true;
  2170→    // Match short ULID (prefix)
  2171→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  2172→      return true;
  2173→    return false;
  2174→  });
  2175→}
  2176→
  2177→// ============================================================
  2178→// TRIAGE SYSTEM
  2179→// ============================================================
  2180→
  2181→/**
  2182→ * Triage record with runtime metadata for source tracking.
  2183→ */
  2184→export interface LoadedTriageRecord extends TriageRecord {
  2185→  _sourceFile?: string;
  2186→}
  2187→
  2188→/**
  2189→ * Get the triage file path.
  2190→ * AC: @triage-record-schema ac-6
  2191→ *
  2192→ * When shadow enabled: .kspec/project.triage.yaml
  2193→ * Otherwise: spec/project.triage.yaml
  2194→ */
  2195→export function getTriageFilePath(ctx: KspecContext): string {
  2196→  return path.join(ctx.specDir, "project.triage.yaml");
  2197→}
  2198→
  2199→/**
  2200→ * Load all triage records from the project.
  2201→ * AC: @triage-record-schema ac-6, ac-7
  2202→ */
  2203→export async function loadTriageRecords(
  2204→  ctx: KspecContext,
  2205→): Promise<LoadedTriageRecord[]> {
  2206→  const triagePath = getTriageFilePath(ctx);
  2207→
  2208→  try {
  2209→    const raw = await readYamlFile<unknown>(triagePath);
  2210→
  2211→    // Handle { kynetic_triage: "1.0", triage: [...] } format
  2212→    if (raw && typeof raw === "object" && "triage" in raw) {
  2213→      const parsed = TriageFileSchema.safeParse(raw);
  2214→      if (parsed.success) {
  2215→        return parsed.data.triage.map((record) => ({
  2216→          ...record,
  2217→          _sourceFile: triagePath,
  2218→        }));
  2219→      }
  2220→    }
  2221→
  2222→    // Handle plain array format
  2223→    if (Array.isArray(raw)) {
  2224→      const records: LoadedTriageRecord[] = [];
  2225→      for (const item of raw) {
  2226→        const result = TriageRecordSchema.safeParse(item);
  2227→        if (result.success) {
  2228→          records.push({ ...result.data, _sourceFile: triagePath });
  2229→        }
  2230→      }
  2231→      return records;
  2232→    }
  2233→
  2234→    return [];
  2235→  } catch {
  2236→    // File doesn't exist or parse error
  2237→    return [];
  2238→  }
  2239→}
  2240→
  2241→/**
  2242→ * Strip runtime metadata before serialization.
  2243→ */
  2244→function stripTriageMetadata(record: LoadedTriageRecord): TriageRecord {
  2245→  const { _sourceFile, ...cleanRecord } = record;
  2246→  return cleanRecord as TriageRecord;
  2247→}
  2248→
  2249→/**
  2250→ * Save a triage record (add or update).
  2251→ * AC: @triage-record-schema ac-8 — upsert on inbox_ref (one record per inbox item)
  2252→ * AC: @triage-record-schema ac-9 — sets updated_at on every mutation
  2253→ */
  2254→export async function saveTriageRecord(
  2255→  ctx: KspecContext,
  2256→  record: LoadedTriageRecord,
  2257→): Promise<void> {
  2258→  const triagePath = getTriageFilePath(ctx);
  2259→
  2260→  // Lock the file to prevent concurrent read-modify-write races
  2261→  await withFileLock(triagePath, async () => {
  2262→    // Ensure directory exists
  2263→    const dir = path.dirname(triagePath);
  2264→    await fs.mkdir(dir, { recursive: true });
  2265→
  2266→    // Load existing records
  2267→    let existingRecords: TriageRecord[] = [];
  2268→
  2269→    try {
  2270→      const raw = await readYamlFile<unknown>(triagePath);
  2271→      if (raw && typeof raw === "object" && "triage" in raw) {
  2272→        const parsed = TriageFileSchema.safeParse(raw);
  2273→        if (parsed.success) {
  2274→          existingRecords = parsed.data.triage;
  2275→        }
  2276→      } else if (Array.isArray(raw)) {
  2277→        for (const item of raw) {
  2278→          const result = TriageRecordSchema.safeParse(item);
  2279→          if (result.success) {
  2280→            existingRecords.push(result.data);
  2281→          }
  2282→        }
  2283→      }
  2284→    } catch {
  2285→      // File doesn't exist, start fresh
  2286→    }
  2287→
  2288→    const cleanRecord = stripTriageMetadata(record);
  2289→
  2290→    // AC: ac-9 — set updated_at on every mutation
  2291→    cleanRecord.updated_at = new Date().toISOString();
  2292→
  2293→    // AC: ac-8 — upsert: check for existing record by ULID first, then by inbox_ref
  2294→    const existingByUlid = existingRecords.findIndex(
  2295→      (r) => r._ulid === record._ulid,
  2296→    );
  2297→    if (existingByUlid >= 0) {
  2298→      existingRecords[existingByUlid] = cleanRecord;
  2299→    } else {
  2300→      // Check for existing record with same inbox_ref (uniqueness constraint)
  2301→      // Preserve existing identity (_ulid, created_at) when upserting by inbox_ref
  2302→      const existingByInboxRef = existingRecords.findIndex(
  2303→        (r) => r.inbox_ref === record.inbox_ref,
  2304→      );
  2305→      if (existingByInboxRef >= 0) {
  2306→        const existing = existingRecords[existingByInboxRef];
  2307→        existingRecords[existingByInboxRef] = {
  2308→          ...cleanRecord,
  2309→          _ulid: existing._ulid,
  2310→          created_at: existing.created_at,
  2311→        };
  2312→      } else {
  2313→        existingRecords.push(cleanRecord);
  2314→      }
  2315→    }
  2316→
  2317→    // Save with { kynetic_triage: "1.0", triage: [...] } format
  2318→    await writeYamlFilePreserveFormat(triagePath, {
  2319→      kynetic_triage: "1.0",
  2320→      triage: existingRecords,
  2321→    });
  2322→  });
  2323→}
  2324→
  2325→/**
  2326→ * Find a triage record by reference (ULID or short ULID).
  2327→ */
  2328→export function findTriageRecordByRef(
  2329→  records: LoadedTriageRecord[],
  2330→  ref: string,
  2331→): LoadedTriageRecord | undefined {
  2332→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  2333→
  2334→  return records.find((record) => {
  2335→    // Match full ULID
  2336→    if (record._ulid === cleanRef) return true;
  2337→    // Match short ULID (prefix)
  2338→    if (record._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  2339→      return true;
  2340→    return false;
  2341→  });
  2342→}
  2343→
  2344→/**
  2345→ * Find a triage record by inbox item reference.
  2346→ * AC: @triage-record-schema ac-8 — lookup by inbox_ref for upsert
  2347→ */
  2348→export function findTriageRecordByInboxRef(
  2349→  records: LoadedTriageRecord[],
  2350→  inboxRef: string,
  2351→): LoadedTriageRecord | undefined {
  2352→  const cleanRef = inboxRef.startsWith("@") ? inboxRef.slice(1) : inboxRef;
  2353→
  2354→  return records.find((record) => record.inbox_ref === cleanRef);
  2355→}
  2356→
  2357→// ─── Patch Operations ────────────────────────────────────────────────────────
  2358→
  2359→/**
  2360→ * A single patch operation for bulk patching
  2361→ */
  2362→export interface PatchOperation {
  2363→  ref: string;
  2364→  data: Record<string, unknown>;
  2365→}
  2366→
  2367→/**
  2368→ * Result of a single patch operation
  2369→ */
  2370→export interface PatchResult {
  2371→  ref: string;
  2372→  status: "updated" | "skipped" | "error";
  2373→  ulid?: string;
  2374→  error?: string;
  2375→}
  2376→
  2377→/**
  2378→ * Result of a bulk patch operation
  2379→ */
  2380→export interface BulkPatchResult {
  2381→  results: PatchResult[];
  2382→  summary: {
  2383→    total: number;
  2384→    updated: number;
  2385→    failed: number;
  2386→    skipped: number;
  2387→  };
  2388→}
  2389→
  2390→/**
  2391→ * Options for patch operations
  2392→ */
  2393→export interface PatchOptions {
  2394→  allowUnknown?: boolean;
  2395→  dryRun?: boolean;
  2396→  failFast?: boolean;
  2397→}
  2398→
  2399→/**
  2400→ * Bulk patch spec items.
  2401→ * Resolves refs, validates data, applies patches.
  2402→ * Continues on error by default (use failFast to stop on first error).
  2403→ */
  2404→export async function patchSpecItems(
  2405→  ctx: KspecContext,
  2406→  refIndex: ReferenceIndex,
  2407→  items: LoadedSpecItem[],
  2408→  patches: PatchOperation[],
  2409→  options: PatchOptions = {},
  2410→): Promise<BulkPatchResult> {
  2411→  const results: PatchResult[] = [];
  2412→  let stopProcessing = false;
  2413→
  2414→  for (const patch of patches) {
  2415→    if (stopProcessing) {
  2416→      results.push({ ref: patch.ref, status: "skipped" });
  2417→      continue;
  2418→    }
  2419→
  2420→    // Resolve ref
  2421→    const resolved = refIndex.resolve(patch.ref);
  2422→    if (!resolved.ok) {
  2423→      const errorMsg =
  2424→        resolved.error === "not_found"
  2425→          ? `Item not found: ${patch.ref}`
  2426→          : resolved.error === "ambiguous"
  2427→            ? `Ambiguous ref: ${patch.ref}`
  2428→            : `Duplicate slug: ${patch.ref}`;
  2429→      results.push({ ref: patch.ref, status: "error", error: errorMsg });
  2430→      if (options.failFast) {
  2431→        stopProcessing = true;
  2432→      }
  2433→      continue;
  2434→    }
  2435→
  2436→    // Find the item
  2437→    const item = items.find((i) => i._ulid === resolved.ulid);
  2438→    if (!item) {
  2439→      // Ref resolved but it's not a spec item (might be a task)
  2440→      results.push({
  2441→        ref: patch.ref,
  2442→        status: "error",
  2443→        error: "Not a spec item",
  2444→      });
  2445→      if (options.failFast) {
  2446→        stopProcessing = true;
  2447→      }
  2448→      continue;
  2449→    }
  2450→
  2451→    // Dry run - just record what would happen
  2452→    if (options.dryRun) {
  2453→      results.push({ ref: patch.ref, status: "updated", ulid: item._ulid });
  2454→      continue;
  2455→    }
  2456→
  2457→    // Apply the patch
  2458→    try {
  2459→      await updateSpecItem(ctx, item, patch.data);
  2460→      results.push({ ref: patch.ref, status: "updated", ulid: item._ulid });
  2461→    } catch (err) {
  2462→      const errorMsg = err instanceof Error ? err.message : String(err);
  2463→      results.push({ ref: patch.ref, status: "error", error: errorMsg });
  2464→      if (options.failFast) {
  2465→        stopProcessing = true;
  2466→      }
  2467→    }
  2468→  }
  2469→
  2470→  return {
  2471→    results,
  2472→    summary: {
  2473→      total: patches.length,
  2474→      updated: results.filter((r) => r.status === "updated").length,
  2475→      failed: results.filter((r) => r.status === "error").length,
