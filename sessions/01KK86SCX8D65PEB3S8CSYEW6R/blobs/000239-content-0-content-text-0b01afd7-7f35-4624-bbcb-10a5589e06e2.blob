    88→/**
    89→ * Spec item with runtime metadata for source tracking.
    90→ * _sourceFile is not serialized - it's used to know where to write updates.
    91→ * _path tracks location within the file for nested items (e.g., "features[0].requirements[2]")
    92→ */
    93→export interface LoadedSpecItem extends SpecItem {
    94→  _sourceFile?: string;
    95→  _path?: string;
    96→}
    97→
    98→/**
    99→ * Task with runtime metadata for source tracking.
   100→ * _sourceFile is not serialized - it's used to know where to write updates.
