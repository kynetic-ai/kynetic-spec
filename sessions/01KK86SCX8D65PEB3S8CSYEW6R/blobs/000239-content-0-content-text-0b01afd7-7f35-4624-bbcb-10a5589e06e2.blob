    52→/**
    53→ * Log a debug message (only when KSPEC_DEBUG=1)
    54→ */
    55→function debugLog(prefix: string, message: string): void {
    56→  if (process.env.KSPEC_DEBUG === "1") {
    57→    console.error(`[DEBUG] ${prefix}: ${message}`);
    58→  }
    59→}
    60→
    61→/**
    62→ * Parse a manifest and emit deprecation warnings for deprecated fields.
    63→ *
    64→ * AC: @config-manifest-cleanup ac-4 — debug-level deprecation note for daemon block
    65→ */
    66→function parseManifestWithWarnings(rawManifest: unknown): Manifest {
    67→  const manifest = ManifestSchema.parse(rawManifest);
    68→
    69→  // AC: @config-manifest-cleanup ac-4 — log debug-level deprecation note for daemon block
    70→  if (manifest.daemon) {
    71→    debugLog(
    72→      "manifest",
    73→      'Deprecated "daemon" block found in manifest. Use kspec.config.yaml instead.',
    74→    );
    75→  }
    76→
    77→  // Also warn for deprecated config block
    78→  if (manifest.config) {
    79→    debugLog(
    80→      "manifest",
    81→      'Deprecated "config" block found in manifest. Use kspec.config.yaml instead.',
    82→    );
    83→  }
    84→
    85→  return manifest;
    86→}
