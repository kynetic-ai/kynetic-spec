   378→
   379→  // AC: @trait-confirmation-prompt ac-3
   380→  // AC: @trait-semantic-exit-codes ac-3
   381→  it("returns cancellation exit when user declines interactive confirmation", async () => {
   382→    const staleId = testUlid("SESS", 14);
   383→    await createActiveSession(
   384→      staleId,
   385→      "2024-01-01T00:00:00.000Z",
