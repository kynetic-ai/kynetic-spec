   404→
   405→  // AC: @trait-confirmation-prompt ac-2
   406→  it("proceeds when user confirms interactive prompt in single-target mode", async () => {
   407→    const staleId = testUlid("SESS", 15);
   408→    await createActiveSession(
   409→      staleId,
   410→      "2024-01-01T00:00:00.000Z",
   411→      "2024-01-02T00:00:00.000Z",
