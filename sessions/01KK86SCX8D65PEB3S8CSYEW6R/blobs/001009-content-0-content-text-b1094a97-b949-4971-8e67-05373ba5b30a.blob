   432→
   433→  // AC: @trait-confirmation-prompt ac-5
   434→  it("uses a single confirmation prompt for destructive --refs batch mode", async () => {
   435→    const staleA = testUlid("SESS", 16);
   436→    const staleB = testUlid("SESS", 17);
   437→    await createActiveSession(
