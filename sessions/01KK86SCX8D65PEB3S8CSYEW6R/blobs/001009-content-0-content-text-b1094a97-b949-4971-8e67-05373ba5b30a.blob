     1→/**
     2→ * Session stale close command tests.
     3→ *
     4→ * Task: @implement-stale-active-session-cleanup
     5→ * Spec: @session-stale-cleanup
     6→ */
     7→
     8→import { afterEach, beforeEach, describe, expect, it } from "vitest";
     9→import * as fs from "node:fs/promises";
    10→import * as path from "node:path";
    11→import {
    12→  appendEvent,
    13→  createSession,
    14→  getSession,
    15→  getSessionEventsPath,
    16→  updateSessionStatus,
    17→} from "../src/sessions/store.js";
    18→import {
    19→  cleanupTempDir,
    20→  kspec,
    21→  kspecJson,
    22→  setupTempFixtures,
    23→  testUlid,
    24→} from "./helpers/cli.js";
    25→
    26→interface SessionStaleCloseJson {
    27→  dry_run: boolean;
    28→  mode: "single" | "refs" | "all";
    29→  criteria: {
    30→    older_than: string;
    31→    inactive_for: string;
    32→    liveness_guard: string;
    33→  };
    34→  sessions: Array<{
    35→    session_id: string;
    36→    status: string;
    37→    reason: string;
    38→    close_reason?: string;
    39→  }>;
    40→  totals: {
    41→    active_sessions_total: number;
    42→    sessions_evaluated: number;
    43→    candidates: number;
    44→    changed_sessions: number;
    45→    skipped_sessions: number;
    46→    failures: number;
    47→  };
    48→}
    49→
    50→interface JsonErrorPayload {
    51→  success: false;
    52→  error: string;
    53→  details?: {
    54→    field?: string;
    55→    value?: string;
    56→    guidance?: string;
    57→  };
    58→}
    59→
    60→describe("session stale close", () => {
    61→  let tempDir: string;
    62→  let sessionsDir: string;
    63→
    64→  beforeEach(async () => {
    65→    tempDir = await setupTempFixtures();
    66→    sessionsDir = path.join(tempDir, "sessions");
    67→  });
    68→
    69→  afterEach(async () => {
    70→    await cleanupTempDir(tempDir);
    71→  });
    72→
    73→  async function createActiveSession(
    74→    sessionId: string,
    75→    startedAt: string,
    76→    lastActivityAt?: string,
    77→  ): Promise<void> {
    78→    await createSession(sessionsDir, {
    79→      id: sessionId,
    80→      agent_type: "test-agent",
    81→      status: "active",
    82→      started_at: startedAt,
    83→    });
    84→
    85→    if (lastActivityAt) {
    86→      await appendEvent(sessionsDir, {
    87→        session_id: sessionId,
    88→        type: "session.update",
    89→        ts: new Date(lastActivityAt).getTime(),
    90→        data: { update: "heartbeat" },
    91→      });
    92→    }
    93→  }
    94→
    95→  // AC: @session-stale-cleanup ac-1
    96→  // AC: @trait-dry-run ac-1
    97→  // AC: @trait-dry-run ac-2
    98→  // AC: @trait-dry-run ac-3
    99→  // AC: @trait-dry-run ac-6
   100→  // AC: @trait-json-output ac-1
   101→  // AC: @trait-json-output ac-2
   102→  it("reports would-close sessions in --all --dry-run with per-session reasons", async () => {
   103→    const staleId = testUlid("SESS", 1);
   104→    await createActiveSession(
   105→      staleId,
   106→      "2024-01-01T00:00:00.000Z",
   107→      "2024-01-02T00:00:00.000Z",
   108→    );
   109→
   110→    const result = kspecJson<SessionStaleCloseJson>(
   111→      "session stale close --all --dry-run --older-than 24h --inactive-for 6h",
   112→      tempDir,
   113→    );
   114→
   115→    expect(result.mode).toBe("all");
   116→    expect(result.dry_run).toBe(true);
   117→    expect(result.totals.candidates).toBe(1);
   118→    expect(result.totals.changed_sessions).toBe(0);
   119→    expect(result.sessions[0].status).toBe("would_abandon");
   120→    expect(result.sessions[0].reason).toContain("dry run");
   121→    expect(result.sessions[0].close_reason?.startsWith("auto-abandoned:")).toBe(
   122→      true,
   123→    );
   124→
   125→    const unchanged = await getSession(sessionsDir, staleId);
   126→    expect(unchanged?.status).toBe("active");
   127→    expect(unchanged?.ended_at).toBeUndefined();
   128→  });
   129→
   130→  // AC: @session-stale-cleanup ac-2
   131→  // AC: @trait-confirmation-prompt ac-4
   132→  it("closes only the targeted stale active session in single-target mode", async () => {
   133→    const targetId = testUlid("SESS", 2);
   134→    const otherId = testUlid("SESS", 3);
   135→    await createActiveSession(
   136→      targetId,
   137→      "2024-01-01T00:00:00.000Z",
   138→      "2024-01-02T00:00:00.000Z",
   139→    );
   140→    await createActiveSession(
   141→      otherId,
   142→      "2024-01-01T00:00:00.000Z",
   143→      "2024-01-02T00:00:00.000Z",
   144→    );
   145→
   146→    const output = kspecJson<SessionStaleCloseJson>(
   147→      `session stale close ${targetId} --older-than 24h --inactive-for 6h --force`,
   148→      tempDir,
   149→    );
   150→
   151→    expect(output.mode).toBe("single");
   152→    expect(output.totals.changed_sessions).toBe(1);
   153→
   154→    const target = await getSession(sessionsDir, targetId);
   155→    const other = await getSession(sessionsDir, otherId);
   156→    expect(target?.status).toBe("abandoned");
   157→    expect(target?.close_reason?.startsWith("auto-abandoned:")).toBe(true);
   158→    expect(other?.status).toBe("active");
   159→  });
   160→
   161→  // AC: @session-stale-cleanup ac-3
   162→  // AC: @trait-semantic-exit-codes ac-1
   163→  // AC: @trait-semantic-exit-codes ac-5
   164→  it("returns success with zero changes when no sessions match stale criteria", async () => {
   165→    const recentId = testUlid("SESS", 4);
   166→    await createActiveSession(recentId, new Date().toISOString());
   167→
   168→    const output = kspecJson<SessionStaleCloseJson>(
   169→      `session stale close ${recentId} --older-than 24h --inactive-for 6h --force`,
   170→      tempDir,
   171→    );
   172→
   173→    expect(output.totals.candidates).toBe(0);
   174→    expect(output.totals.changed_sessions).toBe(0);
   175→    expect(output.sessions[0].status).toBe("not_candidate");
   176→
   177→    const session = await getSession(sessionsDir, recentId);
   178→    expect(session?.status).toBe("active");
   179→  });
   180→
   181→  // AC: @session-stale-cleanup ac-4
   182→  // AC: @session-stale-cleanup ac-5
   183→  it("reports all-mode totals for candidates, changed, skipped, and failures", async () => {
   184→    const staleId = testUlid("SESS", 5);
   185→    const freshId = testUlid("SESS", 6);
   186→    const brokenId = testUlid("SESS", 7);
   187→
   188→    await createActiveSession(
   189→      staleId,
   190→      "2024-01-01T00:00:00.000Z",
   191→      "2024-01-02T00:00:00.000Z",
   192→    );
   193→    await createActiveSession(freshId, new Date().toISOString());
   194→    await createActiveSession(
   195→      brokenId,
   196→      "2024-01-01T00:00:00.000Z",
   197→      undefined,
   198→    );
   199→    await fs.mkdir(getSessionEventsPath(sessionsDir, brokenId), { recursive: true });
   200→
   201→    const dryRun = kspecJson<SessionStaleCloseJson>(
   202→      "session stale close --all --dry-run --older-than 24h --inactive-for 6h",
   203→      tempDir,
   204→    );
   205→    expect(dryRun.totals.candidates).toBe(1);
   206→    expect(dryRun.totals.skipped_sessions).toBe(2);
   207→    expect(dryRun.totals.failures).toBe(1);
   208→
   209→    const apply = kspecJson<SessionStaleCloseJson>(
   210→      "session stale close --all --older-than 24h --inactive-for 6h --force",
   211→      tempDir,
   212→    );
   213→    expect(apply.totals.changed_sessions).toBe(1);
   214→    expect(apply.totals.candidates).toBe(1);
   215→
   216→    const stale = await getSession(sessionsDir, staleId);
   217→    const fresh = await getSession(sessionsDir, freshId);
   218→    const broken = await getSession(sessionsDir, brokenId);
   219→    expect(stale?.status).toBe("abandoned");
   220→    expect(fresh?.status).toBe("active");
   221→    expect(broken?.status).toBe("active");
   222→  });
   223→
   224→  // AC: @session-stale-cleanup ac-6
   225→  // AC: @trait-semantic-exit-codes ac-6
   226→  it("errors when no target mode is provided", async () => {
   227→    const result = kspec("session stale close", tempDir, { expectFail: true });
   228→    expect(result.exitCode).toBe(2);
   229→    expect(result.stderr).toContain("Missing target");
   230→    expect(result.stderr).toContain("<session-id>, --refs, or --all");
   231→  });
   232→
   233→  // AC: @session-stale-cleanup ac-7
   234→  it("errors when positional target and --all are combined", async () => {
   235→    const sessionId = testUlid("SESS", 8);
   236→    await createActiveSession(sessionId, "2024-01-01T00:00:00.000Z");
   237→
   238→    const result = kspec(
   239→      `session stale close ${sessionId} --all`,
   240→      tempDir,
   241→      { expectFail: true },
   242→    );
   243→    expect(result.exitCode).toBe(2);
   244→    expect(result.stderr).toContain("Cannot use <session-id> together with --all");
   245→  });
   246→
   247→  // AC: @session-stale-cleanup ac-8
   248→  // AC: @trait-multi-ref-batch ac-1
   249→  // AC: @trait-multi-ref-batch ac-3
   250→  // AC: @trait-multi-ref-batch ac-8
   251→  it("evaluates unique sessions only once in --refs mode", async () => {
   252→    const staleId = testUlid("SESS", 9);
   253→    const freshId = testUlid("SESS", 10);
   254→    await createActiveSession(
   255→      staleId,
   256→      "2024-01-01T00:00:00.000Z",
   257→      "2024-01-02T00:00:00.000Z",
   258→    );
   259→    await createActiveSession(freshId, new Date().toISOString());
   260→
   261→    const output = kspecJson<SessionStaleCloseJson>(
   262→      `session stale close --refs ${staleId} ${staleId} ${freshId} --dry-run --older-than 24h --inactive-for 6h`,
   263→      tempDir,
   264→    );
   265→
   266→    const staleRows = output.sessions.filter((row) => row.session_id === staleId);
   267→    expect(staleRows).toHaveLength(1);
   268→    expect(output.totals.sessions_evaluated).toBe(2);
   269→  });
   270→
   271→  // AC: @session-stale-cleanup ac-9
   272→  // AC: @trait-multi-ref-batch ac-6
   273→  it("errors when --refs is combined with --all or positional target", async () => {
   274→    const sessionId = testUlid("SESS", 11);
   275→    await createActiveSession(sessionId, "2024-01-01T00:00:00.000Z");
   276→
   277→    const withAll = kspec(
   278→      `session stale close --refs ${sessionId} --all`,
   279→      tempDir,
   280→      { expectFail: true },
   281→    );
   282→    expect(withAll.exitCode).toBe(2);
   283→    expect(withAll.stderr).toContain("Cannot use --refs together with --all");
   284→
   285→    const withPositional = kspec(
   286→      `session stale close ${sessionId} --refs ${sessionId}`,
   287→      tempDir,
   288→      { expectFail: true },
   289→    );
   290→    expect(withPositional.exitCode).toBe(2);
   291→    expect(withPositional.stderr).toContain("Cannot use <session-id> together with --refs");
   292→  });
   293→
   294→  // AC: @trait-multi-ref-batch ac-2
   295→  // AC: @trait-multi-ref-batch ac-4
   296→  // AC: @trait-multi-ref-batch ac-5
   297→  // AC: @trait-multi-ref-batch ac-7
   298→  // AC: @trait-dry-run ac-4
   299→  // AC: @trait-error-guidance ac-1
   300→  // AC: @trait-error-guidance ac-2
   301→  // AC: @trait-error-guidance ac-3
   302→  // AC: @trait-error-guidance ac-6
   303→  it("continues refs batch after resolution errors and returns partial-failure exit", async () => {
   304→    const staleId = testUlid("SESS", 12);
   305→    await createActiveSession(
   306→      staleId,
   307→      "2024-01-01T00:00:00.000Z",
   308→      "2024-01-02T00:00:00.000Z",
   309→    );
   310→
   311→    const result = kspec(
   312→      `session stale close --refs ${staleId} BADREF --dry-run --older-than 24h --inactive-for 6h --json`,
   313→      tempDir,
   314→      { expectFail: true },
   315→    );
   316→    expect(result.exitCode).toBe(1);
   317→
   318→    const payload = JSON.parse(result.stdout) as SessionStaleCloseJson;
   319→    expect(payload.totals.candidates).toBe(1);
   320→    expect(payload.totals.changed_sessions).toBe(0);
   321→    expect(payload.totals.failures).toBe(1);
   322→    expect(payload.sessions.some((row) => row.status === "resolution_error")).toBe(
   323→      true,
   324→    );
   325→    const resolutionError = payload.sessions.find(
   326→      (row) => row.status === "resolution_error",
   327→    );
   328→    expect(resolutionError?.reason).toContain("Session not found");
   329→    expect(resolutionError?.reason).toContain("kspec session list --status active");
   330→
   331→    const unchanged = await getSession(sessionsDir, staleId);
   332→    expect(unchanged?.status).toBe("active");
   333→  });
   334→
   335→  // AC: @trait-json-output ac-3
   336→  it("returns structured JSON errors in --json mode", async () => {
   337→    const result = kspec("session stale close --json", tempDir, { expectFail: true });
   338→    expect(result.exitCode).toBe(2);
   339→
   340→    const payload = JSON.parse(result.stderr) as JsonErrorPayload;
   341→    expect(payload.success).toBe(false);
   342→    expect(payload.error).toContain("Missing target");
   343→  });
   344→
   345→  // AC: @trait-error-guidance ac-5
   346→  it("includes validation field/value details for invalid criteria in JSON mode", async () => {
   347→    const result = kspec(
   348→      "session stale close --all --older-than nope --json",
   349→      tempDir,
   350→      { expectFail: true },
   351→    );
   352→    expect(result.exitCode).toBe(2);
   353→
   354→    const payload = JSON.parse(result.stderr) as JsonErrorPayload;
   355→    expect(payload.error).toContain("Invalid value for --older-than");
   356→    expect(payload.details?.field).toBe("older-than");
   357→    expect(payload.details?.value).toBe("nope");
   358→  });
   359→
   360→  // AC: @trait-confirmation-prompt ac-1
   361→  // AC: @trait-confirmation-prompt ac-6
   362→  it("requires --force in non-interactive destructive mode", async () => {
   363→    const staleId = testUlid("SESS", 13);
   364→    await createActiveSession(
   365→      staleId,
   366→      "2024-01-01T00:00:00.000Z",
