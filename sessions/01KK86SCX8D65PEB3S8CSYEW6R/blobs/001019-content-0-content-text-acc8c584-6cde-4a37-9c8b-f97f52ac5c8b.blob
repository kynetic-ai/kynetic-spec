   305→// ─── AC-6: Session log list shows session type ────────────────────────────────
   306→
   307→// AC: @session-model-evolution ac-6
   308→describe("kspec session log list session type display (CLI)", () => {
   309→  let tempDir: string;
   310→
   311→  beforeEach(async () => {
   312→    tempDir = await setupTempFixtures();
   313→
   314→    const sessionsDir = path.join(tempDir, "sessions");
   315→    await fs.mkdir(sessionsDir, { recursive: true });
   316→
   317→    // Legacy session (no trigger = loop type)
   318→    const s1 = testUlid("SESS", 1);
   319→    const s1Dir = path.join(sessionsDir, s1);
   320→    await fs.mkdir(s1Dir);
   321→    await fs.writeFile(path.join(s1Dir, "session.yaml"), YAML.stringify({
   322→      id: s1,
   323→      agent_type: "ralph",
   324→      status: "completed",
   325→      started_at: "2026-01-15T10:00:00.000Z",
   326→      ended_at: "2026-01-15T11:30:00.000Z",
   327→    }));
   328→    await fs.writeFile(path.join(s1Dir, "events.jsonl"), "");
   329→
   330→    // New invocation session (with trigger = task.ready)
   331→    const s2 = testUlid("SESS", 2);
   332→    const s2Dir = path.join(sessionsDir, s2);
   333→    await fs.mkdir(s2Dir);
   334→    await fs.writeFile(path.join(s2Dir, "session.yaml"), YAML.stringify({
   335→      id: s2,
   336→      agent_type: "claude-agent-acp",
   337→      agent_id: "@agent-worker",
   338→      trigger: "task.ready",
   339→      task_id: "@my-task",
   340→      status: "completed",
   341→      started_at: "2026-02-10T10:00:00.000Z",
   342→      ended_at: "2026-02-10T11:00:00.000Z",
   343→    }));
   344→    await fs.writeFile(path.join(s2Dir, "events.jsonl"), "");
   345→  });
   346→
   347→  afterEach(async () => {
   348→    await cleanupTempDir(tempDir);
   349→  });
   350→
   351→  it("should show session_type field in JSON output", () => {
   352→    const sessions = kspecJson<SessionLogSummary[]>("session log list", tempDir);
   353→    expect(sessions).toHaveLength(2);
   354→
   355→    const legacy = sessions.find((s) => s.agent_type === "ralph");
   356→    const invocation = sessions.find((s) => s.agent_type === "claude-agent-acp");
   357→
   358→    expect(legacy).toBeDefined();
   359→    expect(legacy!.session_type).toBe("loop");
   360→
   361→    expect(invocation).toBeDefined();
   362→    expect(invocation!.session_type).toBe("invocation");
   363→  });
   364→
   365→  it("should display Type column in text output", () => {
   366→    const result = kspec("session log list", tempDir);
   367→    expect(result.exitCode).toBe(0);
   368→    expect(result.stdout).toContain("Type");
   369→    expect(result.stdout).toContain("loop");
   370→    expect(result.stdout).toContain("invocation");
   371→  });
   372→});
