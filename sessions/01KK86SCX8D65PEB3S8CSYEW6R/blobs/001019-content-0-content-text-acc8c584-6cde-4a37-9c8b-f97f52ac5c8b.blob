    38→// ─── AC-3: SessionStatusSchema extension ────────────────────────────────────
    39→
    40→// AC: @session-model-evolution ac-3
    41→describe("SessionStatusSchema extended statuses", () => {
    42→  it("should accept timed_out as a valid status", () => {
    43→    const result = SessionStatusSchema.safeParse("timed_out");
    44→    expect(result.success).toBe(true);
    45→  });
    46→
    47→  it("should accept failed as a valid status", () => {
    48→    const result = SessionStatusSchema.safeParse("failed");
    49→    expect(result.success).toBe(true);
    50→  });
    51→
    52→  it("should still accept original statuses", () => {
    53→    for (const status of ["active", "completed", "abandoned"]) {
    54→      const result = SessionStatusSchema.safeParse(status);
    55→      expect(result.success).toBe(true);
    56→    }
    57→  });
    58→
    59→  it("should reject invalid statuses", () => {
    60→    const result = SessionStatusSchema.safeParse("unknown-status");
    61→    expect(result.success).toBe(false);
    62→  });
    63→});
    64→
    65→// ─── AC-4: EventTypeSchema extension ─────────────────────────────────────────
    66→
    67→// AC: @session-model-evolution ac-4
    68→describe("EventTypeSchema agent.* event types", () => {
    69→  const agentEventTypes = [
    70→    "agent.dispatched",
    71→    "agent.started",
    72→    "agent.completed",
    73→    "agent.failed",
    74→    "agent.timeout",
    75→  ];
    76→
    77→  for (const eventType of agentEventTypes) {
    78→    it(`should accept ${eventType} as a valid event type`, () => {
    79→      const result = EventTypeSchema.safeParse(eventType);
    80→      expect(result.success).toBe(true);
    81→    });
    82→  }
    83→
    84→  it("should still accept all original event types", () => {
    85→    const originalTypes = [
    86→      "session.start",
    87→      "session.update",
    88→      "iteration.timeout",
    89→      "session.end",
    90→      "session.wrapup",
    91→      "prompt.sent",
    92→      "tool.call",
    93→      "tool.result",
    94→      "note",
    95→    ];
    96→    for (const eventType of originalTypes) {
    97→      const result = EventTypeSchema.safeParse(eventType);
    98→      expect(result.success).toBe(true);
    99→    }
   100→  });
   101→});
