   103→// ─── AC-1: SessionMetadata with trigger and agent_id ─────────────────────────
   104→
   105→// AC: @session-model-evolution ac-1
   106→describe("SessionMetadata trigger and agent_id fields", () => {
   107→  let testDir: string;
   108→  let sessionsDir: string;
   109→
   110→  beforeEach(async () => {
   111→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-session-model-"));
   112→    sessionsDir = path.join(testDir, "sessions");
   113→  });
   114→
   115→  afterEach(async () => {
   116→    await fs.rm(testDir, { recursive: true });
   117→  });
   118→
   119→  it("should accept trigger and agent_id in session metadata", async () => {
   120→    const sessionId = testUlid("SESS");
   121→    await createSession(sessionsDir, {
   122→      id: sessionId,
   123→      agent_type: "claude-agent-acp",
   124→      agent_id: "@agent-worker",
   125→      trigger: "task.ready",
   126→      task_id: "@my-task",
   127→    });
   128→
   129→    // Read back to verify persistence
   130→    const loaded = await getSession(sessionsDir, sessionId);
   131→    expect(loaded).not.toBeNull();
   132→    expect(loaded!.agent_id).toBe("@agent-worker");
   133→    expect(loaded!.trigger).toBe("task.ready");
   134→    expect(loaded!.task_id).toBe("@my-task");
   135→  });
   136→
   137→  it("should accept all trigger enum values", () => {
   138→    const triggers = [
   139→      "manual",
   140→      "task.in_progress",
   141→      "task.ready",
   142→      "task.needs_work",
   143→      "task.pending_review",
   144→      "legacy",
   145→    ];
   146→    for (const trigger of triggers) {
   147→      const result = SessionMetadataSchema.safeParse({
   148→        id: "01SESS00000000000000000001",
   149→        agent_type: "test-agent",
   150→        trigger,
   151→        status: "active",
   152→        started_at: "2026-01-01T00:00:00.000Z",
   153→      });
   154→      expect(result.success).toBe(true);
   155→    }
   156→  });
   157→});
   158→
   159→// ─── AC-2: Backward compatibility for legacy sessions ─────────────────────────
   160→
   161→// AC: @session-model-evolution ac-2
   162→describe("Legacy session backward compatibility", () => {
   163→  let testDir: string;
   164→  let sessionsDir: string;
   165→
   166→  beforeEach(async () => {
   167→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-legacy-session-"));
   168→    sessionsDir = path.join(testDir, "sessions");
   169→  });
   170→
   171→  afterEach(async () => {
   172→    await fs.rm(testDir, { recursive: true });
   173→  });
   174→
   175→  it("should parse legacy session without trigger or agent_id without error", async () => {
   176→    const sessionId = testUlid("SESS");
   177→    // Write a legacy session.yaml directly (old format, no trigger/agent_id)
   178→    const sessionDir = path.join(testDir, "sessions", sessionId);
   179→    await fs.mkdir(sessionDir, { recursive: true });
   180→    await fs.writeFile(path.join(sessionDir, "session.yaml"), YAML.stringify({
   181→      id: sessionId,
   182→      agent_type: "ralph",
   183→      status: "completed",
   184→      started_at: "2026-01-15T10:00:00.000Z",
   185→      ended_at: "2026-01-15T12:00:00.000Z",
   186→    }));
   187→
   188→    // Should parse without error
   189→    const loaded = await getSession(sessionsDir, sessionId);
   190→    expect(loaded).not.toBeNull();
   191→    expect(loaded!.agent_type).toBe("ralph");
   192→    // AC: @session-model-evolution ac-2 — legacy defaults are materialized on read
   193→    expect(loaded!.trigger).toBe("legacy");
   194→    expect(loaded!.agent_id).toBe("ralph"); // defaults to agent_type value
   195→  });
   196→
   197→  it("should classify legacy session as loop type in summary", async () => {
   198→    const sessionId = testUlid("SESS");
   199→    const sessionDir = path.join(testDir, "sessions", sessionId);
   200→    await fs.mkdir(sessionDir, { recursive: true });
   201→    await fs.writeFile(path.join(sessionDir, "session.yaml"), YAML.stringify({
   202→      id: sessionId,
   203→      agent_type: "ralph",
   204→      status: "completed",
   205→      started_at: "2026-01-15T10:00:00.000Z",
   206→      ended_at: "2026-01-15T12:00:00.000Z",
   207→    }));
   208→    await fs.writeFile(path.join(sessionDir, "events.jsonl"), "");
   209→
   210→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
   211→    expect(summary).not.toBeNull();
   212→    // Legacy session (no trigger) should be classified as "loop"
   213→    expect(summary!.session_type).toBe("loop");
   214→  });
   215→
   216→  it("should classify session with trigger=legacy as loop type", async () => {
   217→    const sessionId = testUlid("SESS", 1);
   218→    const sessionDir = path.join(testDir, "sessions", sessionId);
   219→    await fs.mkdir(sessionDir, { recursive: true });
   220→    await fs.writeFile(path.join(sessionDir, "session.yaml"), YAML.stringify({
   221→      id: sessionId,
   222→      agent_type: "ralph",
   223→      trigger: "legacy",
   224→      status: "completed",
   225→      started_at: "2026-01-15T10:00:00.000Z",
   226→      ended_at: "2026-01-15T12:00:00.000Z",
   227→    }));
   228→    await fs.writeFile(path.join(sessionDir, "events.jsonl"), "");
   229→
   230→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
   231→    expect(summary).not.toBeNull();
   232→    expect(summary!.session_type).toBe("loop");
   233→  });
   234→});
