   236→// ─── AC-5: Structured agent.completed event ──────────────────────────────────
   237→
   238→// AC: @session-model-evolution ac-5
   239→describe("agent.completed event structure", () => {
   240→  let testDir: string;
   241→  let sessionsDir: string;
   242→
   243→  beforeEach(async () => {
   244→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-agent-event-"));
   245→    sessionsDir = path.join(testDir, "sessions");
   246→  });
   247→
   248→  afterEach(async () => {
   249→    await fs.rm(testDir, { recursive: true });
   250→  });
   251→
   252→  it("should append agent.completed event with task_id, outcome, and duration_ms", async () => {
   253→    const sessionId = testUlid("SESS");
   254→    await createSession(sessionsDir, {
   255→      id: sessionId,
   256→      agent_type: "claude-agent-acp",
   257→    });
   258→
   259→    // Append structured agent.completed event
   260→    await appendEvent(sessionsDir, {
   261→      type: "agent.completed",
   262→      session_id: sessionId,
   263→      data: {
   264→        task_id: "@my-task",
   265→        outcome: "success",
   266→        duration_ms: 45000,
   267→      },
   268→    });
   269→
   270→    // Read back events to verify
   271→    const eventsPath = path.join(testDir, "sessions", sessionId, "events.jsonl");
   272→    const content = await fs.readFile(eventsPath, "utf-8");
   273→    const lines = content.trim().split("\n").filter(Boolean);
   274→    expect(lines.length).toBe(1);
   275→
   276→    const event = JSON.parse(lines[0]);
   277→    expect(event.type).toBe("agent.completed");
   278→    expect(event.data.task_id).toBe("@my-task");
   279→    expect(event.data.outcome).toBe("success");
   280→    expect(event.data.duration_ms).toBe(45000);
   281→  });
   282→
   283→  it("should accept all outcome values for agent.completed", async () => {
   284→    const sessionId = testUlid("SESS", 1);
   285→    await createSession(sessionsDir, {
   286→      id: sessionId,
   287→      agent_type: "claude-agent-acp",
   288→    });
   289→
   290→    for (const outcome of ["success", "blocked", "failed"]) {
   291→      await appendEvent(sessionsDir, {
   292→        type: "agent.completed",
   293→        session_id: sessionId,
   294→        data: { task_id: "@task", outcome, duration_ms: 1000 },
   295→      });
   296→    }
   297→
   298→    const eventsPath = path.join(testDir, "sessions", sessionId, "events.jsonl");
   299→    const content = await fs.readFile(eventsPath, "utf-8");
   300→    const lines = content.trim().split("\n").filter(Boolean);
   301→    expect(lines.length).toBe(3);
   302→  });
   303→});
