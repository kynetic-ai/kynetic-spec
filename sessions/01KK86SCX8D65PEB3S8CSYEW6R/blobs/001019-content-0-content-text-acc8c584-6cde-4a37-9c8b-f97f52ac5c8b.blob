   374→// ─── AC-7: Session log show renders agent.* events ───────────────────────────
   375→
   376→// AC: @session-model-evolution ac-7
   377→describe("kspec session log show agent.* event rendering (CLI)", () => {
   378→  let tempDir: string;
   379→  const sessionId = testUlid("SESS");
   380→
   381→  beforeEach(async () => {
   382→    tempDir = await setupTempFixtures();
   383→
   384→    const sessionsDir = path.join(tempDir, "sessions");
   385→    await fs.mkdir(sessionsDir, { recursive: true });
   386→
   387→    const sDir = path.join(sessionsDir, sessionId);
   388→    await fs.mkdir(sDir);
   389→    await fs.writeFile(path.join(sDir, "session.yaml"), YAML.stringify({
   390→      id: sessionId,
   391→      agent_type: "claude-agent-acp",
   392→      agent_id: "@agent-worker",
   393→      trigger: "task.ready",
   394→      task_id: "@my-task",
   395→      status: "completed",
   396→      started_at: "2026-02-10T10:00:00.000Z",
   397→      ended_at: "2026-02-10T11:00:00.000Z",
   398→    }));
   399→
   400→    // Write events including agent.* types
   401→    const events = [
   402→      JSON.stringify({ ts: 1000, seq: 0, type: "agent.dispatched", session_id: sessionId, data: { task_id: "@my-task" } }),
   403→      JSON.stringify({ ts: 2000, seq: 1, type: "agent.started", session_id: sessionId, data: { task_id: "@my-task" } }),
   404→      JSON.stringify({ ts: 5000, seq: 2, type: "agent.completed", session_id: sessionId, data: { task_id: "@my-task", outcome: "success", duration_ms: 3000 } }),
   405→    ];
   406→    await fs.writeFile(path.join(sDir, "events.jsonl"), events.join("\n") + "\n");
   407→  });
   408→
   409→  afterEach(async () => {
   410→    await cleanupTempDir(tempDir);
   411→  });
   412→
   413→  it("should display session type in show output", () => {
   414→    const result = kspec(`session log show ${sessionId}`, tempDir);
   415→    expect(result.exitCode).toBe(0);
   416→    expect(result.stdout).toContain("Type:");
   417→    expect(result.stdout).toContain("invocation");
   418→  });
   419→
   420→  it("should include session_type in JSON output", () => {
   421→    const detail = kspecJson<SessionLogDetail>(`session log show ${sessionId}`, tempDir);
   422→    expect(detail.session_type).toBe("invocation");
   423→  });
   424→
   425→  it("should render agent.* events in event timeline", () => {
   426→    const result = kspec(`session log show ${sessionId} --events`, tempDir);
   427→    expect(result.exitCode).toBe(0);
   428→    expect(result.stdout).toContain("agent.dispatched");
   429→    expect(result.stdout).toContain("agent.started");
   430→    expect(result.stdout).toContain("agent.completed");
   431→  });
   432→
   433→  it("should include agent.* events in JSON output with --events", () => {
   434→    const detail = kspecJson<SessionLogDetail & { events?: Array<{ type: string; data: Record<string, unknown> }> }>(
   435→      `session log show ${sessionId} --events`,
   436→      tempDir,
   437→    );
   438→    expect(detail.events).toBeDefined();
   439→    expect(detail.events!.length).toBe(3);
   440→
   441→    const dispatched = detail.events!.find((e) => e.type === "agent.dispatched");
   442→    const started = detail.events!.find((e) => e.type === "agent.started");
   443→    const completed = detail.events!.find((e) => e.type === "agent.completed");
   444→
   445→    expect(dispatched).toBeDefined();
   446→    expect(started).toBeDefined();
   447→    expect(completed).toBeDefined();
   448→
   449→    // AC: @session-model-evolution ac-5 — agent.completed has task_id, outcome, duration_ms
   450→    expect(completed!.data.task_id).toBe("@my-task");
   451→    expect(completed!.data.outcome).toBe("success");
   452→    expect(completed!.data.duration_ms).toBe(3000);
   453→  });
   454→
   455→  it("should show human-readable summary for agent.* events", () => {
   456→    const result = kspec(`session log show ${sessionId} --events`, tempDir);
   457→    expect(result.exitCode).toBe(0);
   458→    // agent.dispatched shows "Dispatched for @my-task"
   459→    expect(result.stdout).toContain("Dispatched for @my-task");
   460→    // agent.started shows "Started work on @my-task"
   461→    expect(result.stdout).toContain("Started work on @my-task");
   462→    // agent.completed shows task_id, outcome, duration
   463→    expect(result.stdout).toContain("@my-task");
   464→    expect(result.stdout).toContain("success");
   465→  });
   466→});
   467→
