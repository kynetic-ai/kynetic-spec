   406→// ─── CLI Integration Tests ──────────────────────────────────────────────────
   407→
   408→describe('kspec session log show (CLI)', () => {
   409→  let tempDir: string;
   410→  const sessionId1 = testUlid('SESS', 1);
   411→  const sessionId2 = testUlid('SESS', 2);
   412→
   413→  beforeEach(async () => {
   414→    tempDir = await setupTempFixtures();
   415→
   416→    // In traditional mode (no shadow branch), specDir = tempDir
   417→    const sessionsDir = path.join(tempDir, 'sessions');
   418→    await fs.mkdir(sessionsDir, { recursive: true });
   419→
   420→    // Session 1: completed with events and context
   421→    const s1Dir = path.join(sessionsDir, sessionId1);
   422→    await fs.mkdir(s1Dir);
   423→    await fs.writeFile(path.join(s1Dir, 'session.yaml'), YAML.stringify({
   424→      id: sessionId1,
   425→      agent_type: 'claude-agent-acp',
   426→      task_id: '@my-task',
   427→      status: 'completed',
   428→      started_at: '2026-01-15T10:00:00.000Z',
   429→      ended_at: '2026-01-15T11:30:00.000Z',
   430→    }));
   431→    const blobRelPath = 'blobs/session-show-output.blob';
   432→    const blobContent = 'FULL_BLOB_CONTENT_FOR_SHOW_RESOLUTION';
   433→    await fs.mkdir(path.join(s1Dir, 'blobs'), { recursive: true });
   434→    await fs.writeFile(path.join(s1Dir, blobRelPath), blobContent, 'utf-8');
   435→    await fs.writeFile(path.join(s1Dir, 'events.jsonl'), [
   436→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: sessionId1, data: { iteration: 1 } }),
   437→      JSON.stringify({
   438→        ts: 2000, seq: 1, type: 'session.update', session_id: sessionId1,
   439→        data: {
   440→          iteration: 1,
   441→          update: {
   442→            _meta: { claudeCode: { toolName: 'Bash' } },
   443→            sessionUpdate: 'tool_call',
   444→            rawInput: { command: 'kspec task start @my-task' },
   445→          },
   446→        },
   447→      }),
   448→      JSON.stringify({ ts: 3000, seq: 2, type: 'prompt.sent', session_id: sessionId1, data: { phase: 'task-work', iteration: 1, prompt: 'Continue the task' } }),
   449→      JSON.stringify({ ts: 4000, seq: 3, type: 'tool.call', session_id: sessionId1, data: { iteration: 1, tool: 'Read' } }),
   450→      JSON.stringify({
   451→        ts: 4500,
   452→        seq: 4,
   453→        type: 'tool.result',
   454→        session_id: sessionId1,
   455→        data: {
   456→          output: {
   457→            path: blobRelPath,
   458→            bytes: blobContent.length,
   459→            sha256: 'test-hash',
   460→            truncated: true,
   461→            preview: 'PREVIEW_ONLY_SHOW',
   462→          },
   463→        },
   464→      }),
   465→      JSON.stringify({ ts: 5000, seq: 5, type: 'session.end', session_id: sessionId1, data: { reason: 'completed' } }),
