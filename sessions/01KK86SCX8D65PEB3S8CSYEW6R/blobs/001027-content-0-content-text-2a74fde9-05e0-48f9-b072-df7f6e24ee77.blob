   911→  // ─── Trait AC: @trait-semantic-exit-codes ───────────────────────────────────
   912→
   913→  // AC: @trait-semantic-exit-codes ac-2
   914→  // Note: Trait says "exit code 1" but kspec uses a richer exit code scheme
   915→  // (EXIT_CODES in src/cli/exit-codes.ts). Validation errors map to
   916→  // VALIDATION_FAILED (4). This is consistent with other commands (e.g. cli-serve.test.ts).
   917→  it('should exit with VALIDATION_FAILED (4) for ambiguous prefix', async () => {
   918→    const ambig1 = '01XTEST0000000000000000001';
   919→    const ambig2 = '01XTEST0000000000000000002';
   920→    const sessionsDir = path.join(tempDir, 'sessions');
   921→
   922→    const a1Dir = path.join(sessionsDir, ambig1);
   923→    await fs.mkdir(a1Dir);
   924→    await fs.writeFile(path.join(a1Dir, 'session.yaml'), YAML.stringify({
   925→      id: ambig1, agent_type: 'test', status: 'active', started_at: '2026-01-01T00:00:00.000Z',
   926→    }));
   927→    const a2Dir = path.join(sessionsDir, ambig2);
   928→    await fs.mkdir(a2Dir);
   929→    await fs.writeFile(path.join(a2Dir, 'session.yaml'), YAML.stringify({
   930→      id: ambig2, agent_type: 'test', status: 'active', started_at: '2026-01-01T00:00:00.000Z',
   931→    }));
   932→
   933→    const result = kspec('session log show 01XTEST', tempDir, { expectFail: true });
   934→    expect(result.exitCode).toBe(4); // VALIDATION_FAILED
   935→  });
   936→
   937→  // AC: @trait-semantic-exit-codes ac-6
   938→  // Commander handles invalid flags/missing args before our code runs, exits with code 1.
   939→  it('should exit with code 1 for unknown flags', () => {
   940→    const result = kspec(`session log show ${sessionId1} --bogus-flag`, tempDir, { expectFail: true });
   941→    expect(result.exitCode).toBe(1);
   942→    expect(result.stderr).toContain('unknown option');
   943→  });
   944→
   945→  // AC: @trait-semantic-exit-codes ac-6
   946→  it('should exit with code 1 for missing required argument', () => {
