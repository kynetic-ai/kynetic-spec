     1→/**
     2→ * Session log show tests.
     3→ *
     4→ * Tests for the `kspec session log show` command and supporting store functions.
     5→ */
     6→
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import * as fs from 'node:fs/promises';
     9→import * as os from 'node:os';
    10→import * as path from 'node:path';
    11→import * as YAML from 'yaml';
    12→import {
    13→  createSession,
    14→  appendEvent,
    15→  saveSessionContext,
    16→  resolveSessionId,
    17→  getSessionLogDetail,
    18→  type SessionLogDetail,
    19→} from '../src/sessions/store.js';
    20→import {
    21→  setupTempFixtures,
    22→  cleanupTempDir,
    23→  kspec,
    24→  kspecJson,
    25→  testUlid,
    26→} from './helpers/cli';
    27→
    28→// ─── Store Unit Tests ───────────────────────────────────────────────────────
    29→
    30→describe('resolveSessionId', () => {
    31→  let testDir: string;
    32→  let sessionsDir: string;
    33→
    34→  beforeEach(async () => {
    35→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-show-'));
    36→    sessionsDir = path.join(testDir, 'sessions');
    37→  });
    38→
    39→  afterEach(async () => {
    40→    await fs.rm(testDir, { recursive: true });
    41→  });
    42→
    43→  // AC: @session-log-show ac-9
    44→  it('should return not_found for nonexistent session', async () => {
    45→    const result = await resolveSessionId(sessionsDir, 'nonexistent');
    46→    expect(result.ok).toBe(false);
    47→    if (!result.ok) {
    48→      expect(result.error).toBe('not_found');
    49→    }
    50→  });
    51→
    52→  // AC: @session-log-show ac-7
    53→  it('should resolve exact session ID', async () => {
    54→    const sessionId = testUlid('SESS');
    55→    await createSession(sessionsDir, { id: sessionId, agent_type: 'test-agent' });
    56→
    57→    const result = await resolveSessionId(sessionsDir, sessionId);
    58→    expect(result.ok).toBe(true);
    59→    if (result.ok) {
    60→      expect(result.id).toBe(sessionId);
    61→    }
    62→  });
    63→
    64→  // AC: @session-log-show ac-7
    65→  it('should resolve unique prefix to full session ID', async () => {
    66→    const sessionId = testUlid('SESS');
    67→    await createSession(sessionsDir, { id: sessionId, agent_type: 'test-agent' });
    68→
    69→    // Use first 8 chars as prefix
    70→    const prefix = sessionId.slice(0, 8);
    71→    const result = await resolveSessionId(sessionsDir, prefix);
    72→    expect(result.ok).toBe(true);
    73→    if (result.ok) {
    74→      expect(result.id).toBe(sessionId);
    75→    }
    76→  });
    77→
    78→  // AC: @session-log-show ac-8
    79→  it('should return ambiguous error for multiple matches', async () => {
    80→    // Create two sessions with similar prefixes
    81→    const id1 = '01SESS00000000000000000001';
    82→    const id2 = '01SESS00000000000000000002';
    83→    await createSession(sessionsDir, { id: id1, agent_type: 'test-agent' });
    84→    await createSession(sessionsDir, { id: id2, agent_type: 'test-agent' });
    85→
    86→    const result = await resolveSessionId(sessionsDir, '01SESS');
    87→    expect(result.ok).toBe(false);
    88→    if (!result.ok) {
    89→      expect(result.error).toBe('ambiguous');
    90→      expect(result.matches).toContain(id1);
    91→      expect(result.matches).toContain(id2);
    92→    }
    93→  });
    94→});
    95→
    96→describe('getSessionLogDetail', () => {
    97→  let testDir: string;
    98→  let sessionsDir: string;
    99→
   100→  beforeEach(async () => {
   101→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-detail-'));
   102→    sessionsDir = path.join(testDir, 'sessions');
   103→  });
   104→
   105→  afterEach(async () => {
   106→    await fs.rm(testDir, { recursive: true });
   107→  });
   108→
   109→  it('should return null for nonexistent session', async () => {
   110→    const detail = await getSessionLogDetail(sessionsDir, 'nonexistent');
   111→    expect(detail).toBeNull();
   112→  });
   113→
   114→  // AC: @session-log-show ac-1
   115→  it('should return detail with all metadata fields', async () => {
   116→    const sessionId = testUlid('SESS');
   117→    const startedAt = '2026-01-20T10:00:00.000Z';
   118→    const endedAt = '2026-01-20T11:30:00.000Z';
   119→
   120→    await createSession(sessionsDir, {
   121→      id: sessionId,
   122→      agent_type: 'claude-agent-acp',
   123→      task_id: '@my-task',
   124→      started_at: startedAt,
   125→    });
   126→
   127→    // Simulate completion by writing metadata directly
   128→    const metaPath = path.join(sessionsDir, sessionId, 'session.yaml');
   129→    await fs.writeFile(metaPath, YAML.stringify({
   130→      id: sessionId,
   131→      agent_type: 'claude-agent-acp',
   132→      task_id: '@my-task',
   133→      status: 'completed',
   134→      started_at: startedAt,
   135→      ended_at: endedAt,
   136→    }));
   137→
   138→    const detail = await getSessionLogDetail(sessionsDir, sessionId);
   139→    expect(detail).not.toBeNull();
   140→    expect(detail!.id).toBe(sessionId);
   141→    expect(detail!.status).toBe('completed');
   142→    expect(detail!.agent_type).toBe('claude-agent-acp');
   143→    expect(detail!.task_id).toBe('@my-task');
   144→    expect(detail!.started_at).toBe(startedAt);
   145→    expect(detail!.ended_at).toBe(endedAt);
   146→    expect(detail!.duration_ms).toBe(5400000); // 1.5 hours
   147→  });
   148→
   149→  // AC: @session-log-show ac-2
   150→  it('should compute per-iteration summaries with boundaries', async () => {
   151→    const sessionId = testUlid('SESS', 1);
   152→    await createSession(sessionsDir, {
   153→      id: sessionId,
   154→      agent_type: 'test-agent',
   155→    });
   156→
   157→    // Add context snapshots
   158→    await saveSessionContext(sessionsDir, sessionId, 1, { iteration: 1 });
   159→    await saveSessionContext(sessionsDir, sessionId, 2, { iteration: 2 });
   160→
   161→    // Add events with prompt.sent boundaries (phase: task-work)
   162→    const eventsPath = path.join(sessionsDir, sessionId, 'events.jsonl');
   163→    const events = [
   164→      { ts: 1000, seq: 0, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 1 } },
   165→      {
   166→        ts: 2000, seq: 1, type: 'session.update', session_id: sessionId,
   167→        data: {
   168→          iteration: 1,
   169→          update: {
   170→            sessionUpdate: 'tool_call',
   171→            rawInput: { command: 'kspec task start @task-1' },
   172→          },
   173→        },
   174→      },
   175→      { ts: 3000, seq: 2, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 2 } },
   176→      {
   177→        ts: 4000, seq: 3, type: 'session.update', session_id: sessionId,
   178→        data: {
   179→          iteration: 2,
   180→          update: {
   181→            sessionUpdate: 'tool_call',
   182→            rawInput: { command: 'kspec task complete @task-1 --reason "Done"' },
   183→          },
   184→        },
   185→      },
   186→    ];
   187→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   188→
   189→    const detail = await getSessionLogDetail(sessionsDir, sessionId);
   190→    expect(detail).not.toBeNull();
   191→    expect(detail!.iteration_count).toBe(2);
   192→    expect(detail!.iterations).toHaveLength(2);
   193→
   194→    const iter1 = detail!.iterations.find(i => i.iteration === 1);
   195→    const iter2 = detail!.iterations.find(i => i.iteration === 2);
   196→    expect(iter1).toBeDefined();
   197→    expect(iter2).toBeDefined();
   198→    expect(iter1!.tasks_started).toContain('@task-1');
   199→    expect(iter2!.tasks_completed).toContain('@task-1');
   200→  });
   201→
   202→  // AC: @session-log-show ac-10 — wrong data.iteration on streaming events, still grouped correctly
   203→  it('should group by boundary position even when data.iteration is wrong', async () => {
   204→    const sessionId = testUlid('SESS', 2);
   205→    await createSession(sessionsDir, {
   206→      id: sessionId,
   207→      agent_type: 'test-agent',
   208→    });
   209→
   210→    const eventsPath = path.join(sessionsDir, sessionId, 'events.jsonl');
   211→    const events = [
   212→      // Iteration 1 boundary
   213→      { ts: 1000, seq: 0, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 1 } },
   214→      // These events have WRONG data.iteration (race condition bug)
   215→      { ts: 2000, seq: 1, type: 'session.update', session_id: sessionId, data: { iteration: 4, update: { sessionUpdate: 'tool_call', rawInput: { command: 'ls' } } } },
   216→      { ts: 3000, seq: 2, type: 'session.update', session_id: sessionId, data: { iteration: 4, update: { sessionUpdate: 'tool_call', rawInput: { command: 'cat file' } } } },
   217→      // Iteration 2 boundary
   218→      { ts: 4000, seq: 3, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 2 } },
   219→      // More events with wrong iteration
   220→      { ts: 5000, seq: 4, type: 'session.update', session_id: sessionId, data: { iteration: 4, update: { sessionUpdate: 'tool_call', rawInput: { command: 'echo hi' } } } },
   221→    ];
   222→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   223→
   224→    const detail = await getSessionLogDetail(sessionsDir, sessionId);
   225→    expect(detail).not.toBeNull();
   226→    expect(detail!.iterations).toHaveLength(2);
   227→
   228→    // Boundary-based: iter 1 gets events at indices 0,1,2 (3 events)
   229→    // iter 2 gets events at indices 3,4 (2 events)
   230→    const iter1 = detail!.iterations.find(i => i.iteration === 1);
   231→    const iter2 = detail!.iterations.find(i => i.iteration === 2);
   232→    expect(iter1!.event_count).toBe(3);
   233→    expect(iter2!.event_count).toBe(2);
   234→  });
   235→
   236→  // AC: @session-log-show ac-10 — legacy fallback when no prompt.sent boundaries exist
   237→  it('should fall back to legacy data.iteration grouping without boundaries', async () => {
   238→    const sessionId = testUlid('SESS', 3);
   239→    await createSession(sessionsDir, {
   240→      id: sessionId,
   241→      agent_type: 'test-agent',
   242→    });
   243→
   244→    await saveSessionContext(sessionsDir, sessionId, 1, { iteration: 1 });
   245→
   246→    // Events with data.iteration but NO prompt.sent with phase: task-work
   247→    const eventsPath = path.join(sessionsDir, sessionId, 'events.jsonl');
   248→    const events = [
   249→      { ts: 1000, seq: 0, type: 'session.start', session_id: sessionId, data: { iteration: 1 } },
   250→      { ts: 2000, seq: 1, type: 'session.update', session_id: sessionId, data: { iteration: 1, update: { sessionUpdate: 'tool_call', rawInput: { command: 'ls' } } } },
   251→      { ts: 3000, seq: 2, type: 'prompt.sent', session_id: sessionId, data: { iteration: 2 } }, // No phase field
   252→      { ts: 4000, seq: 3, type: 'session.update', session_id: sessionId, data: { iteration: 2, update: { sessionUpdate: 'tool_call', rawInput: { command: 'cat' } } } },
   253→    ];
   254→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   255→
   256→    const detail = await getSessionLogDetail(sessionsDir, sessionId);
   257→    expect(detail).not.toBeNull();
   258→    expect(detail!.iterations).toHaveLength(2);
   259→
   260→    const iter1 = detail!.iterations.find(i => i.iteration === 1);
   261→    const iter2 = detail!.iterations.find(i => i.iteration === 2);
   262→    expect(iter1!.event_count).toBe(2);
   263→    expect(iter2!.event_count).toBe(2);
   264→  });
   265→
   266→  // AC: @session-log-show ac-10 — pre-boundary events merge into first iteration
   267→  it('should merge pre-boundary events into first iteration', async () => {
   268→    const sessionId = testUlid('SESS', 4);
   269→    await createSession(sessionsDir, {
   270→      id: sessionId,
   271→      agent_type: 'test-agent',
   272→    });
   273→
   274→    const eventsPath = path.join(sessionsDir, sessionId, 'events.jsonl');
   275→    const events = [
   276→      // Pre-boundary events (session.start before any prompt.sent)
   277→      { ts: 1000, seq: 0, type: 'session.start', session_id: sessionId, data: null },
   278→      { ts: 1500, seq: 1, type: 'session.update', session_id: sessionId, data: { update: { sessionUpdate: 'tool_call', rawInput: { command: 'kspec task start @task-1' } } } },
   279→      // First boundary
   280→      { ts: 2000, seq: 2, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 1 } },
   281→      { ts: 3000, seq: 3, type: 'session.update', session_id: sessionId, data: { iteration: 1, update: { sessionUpdate: 'tool_call', rawInput: { command: 'ls' } } } },
   282→    ];
   283→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   284→
   285→    const detail = await getSessionLogDetail(sessionsDir, sessionId);
   286→    expect(detail).not.toBeNull();
   287→    expect(detail!.iterations).toHaveLength(1);
   288→    // All 4 events in iteration 1 (2 pre-boundary + 2 from boundary range)
   289→    expect(detail!.iterations[0].event_count).toBe(4);
   290→    // Pre-boundary task start should be captured
   291→    expect(detail!.iterations[0].tasks_started).toContain('@task-1');
   292→  });
   293→
   294→  // AC: @session-log-show ac-10 — single iteration captures all events
   295→  it('should handle single iteration with one boundary', async () => {
   296→    const sessionId = testUlid('SESS', 5);
   297→    await createSession(sessionsDir, {
   298→      id: sessionId,
   299→      agent_type: 'test-agent',
   300→    });
   301→
   302→    const eventsPath = path.join(sessionsDir, sessionId, 'events.jsonl');
   303→    const events = [
   304→      { ts: 1000, seq: 0, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 1 } },
   305→      { ts: 2000, seq: 1, type: 'session.update', session_id: sessionId, data: { iteration: 1, update: { sessionUpdate: 'tool_call', rawInput: { command: 'ls' } } } },
   306→      { ts: 3000, seq: 2, type: 'session.end', session_id: sessionId, data: { reason: 'completed' } },
   307→    ];
   308→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   309→
   310→    const detail = await getSessionLogDetail(sessionsDir, sessionId);
   311→    expect(detail).not.toBeNull();
   312→    expect(detail!.iterations).toHaveLength(1);
   313→    expect(detail!.iterations[0].event_count).toBe(3);
   314→    expect(detail!.iteration_count).toBe(1);
   315→  });
   316→
   317→  // AC: @session-log-show ac-10 — mixed phase prompt.sent (only task-work used as boundaries)
   318→  it('should only use task-work phase prompt.sent as boundaries', async () => {
   319→    const sessionId = testUlid('SESS', 6);
   320→    await createSession(sessionsDir, {
   321→      id: sessionId,
   322→      agent_type: 'test-agent',
   323→    });
   324→
   325→    const eventsPath = path.join(sessionsDir, sessionId, 'events.jsonl');
   326→    const events = [
   327→      { ts: 1000, seq: 0, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 1 } },
   328→      { ts: 2000, seq: 1, type: 'session.update', session_id: sessionId, data: { iteration: 1 } },
   329→      // Reflect prompt.sent — NOT a boundary
   330→      { ts: 3000, seq: 2, type: 'prompt.sent', session_id: sessionId, data: { phase: 'reflect', iteration: 1 } },
   331→      { ts: 4000, seq: 3, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 2 } },
   332→      { ts: 5000, seq: 4, type: 'session.update', session_id: sessionId, data: { iteration: 2 } },
   333→    ];
   334→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   335→
   336→    const detail = await getSessionLogDetail(sessionsDir, sessionId);
   337→    expect(detail).not.toBeNull();
   338→    // Only 2 iterations (task-work boundaries), not 3
   339→    expect(detail!.iterations).toHaveLength(2);
   340→
   341→    const iter1 = detail!.iterations.find(i => i.iteration === 1);
   342→    const iter2 = detail!.iterations.find(i => i.iteration === 2);
   343→    // Iter 1: events at indices 0,1,2 (prompt.sent task-work, update, reflect)
   344→    expect(iter1!.event_count).toBe(3);
   345→    // Iter 2: events at indices 3,4
   346→    expect(iter2!.event_count).toBe(2);
   347→  });
   348→
   349→  // AC: @session-log-show ac-10 — malformed boundaries gracefully fall back
   350→  it('should fall back to legacy when prompt.sent has missing phase/iteration', async () => {
   351→    const sessionId = testUlid('SESS', 7);
   352→    await createSession(sessionsDir, {
   353→      id: sessionId,
   354→      agent_type: 'test-agent',
   355→    });
   356→
   357→    await saveSessionContext(sessionsDir, sessionId, 1, { iteration: 1 });
   358→
   359→    const eventsPath = path.join(sessionsDir, sessionId, 'events.jsonl');
   360→    const events = [
   361→      // prompt.sent without phase field — not a valid boundary
   362→      { ts: 1000, seq: 0, type: 'prompt.sent', session_id: sessionId, data: { iteration: 1 } },
   363→      { ts: 2000, seq: 1, type: 'session.update', session_id: sessionId, data: { iteration: 1, update: { sessionUpdate: 'tool_call', rawInput: { command: 'ls' } } } },
   364→      // prompt.sent with phase but missing iteration — not a valid boundary
   365→      { ts: 3000, seq: 2, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work' } },
   366→    ];
   367→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   368→
   369→    const detail = await getSessionLogDetail(sessionsDir, sessionId);
   370→    expect(detail).not.toBeNull();
   371→    // Falls back to legacy: iteration 1 from data.iteration
   372→    expect(detail!.iterations.length).toBeGreaterThan(0);
   373→    expect(detail!.iterations[0].iteration).toBe(1);
   374→  });
   375→
   376→  // AC: @session-log-show ac-10 — duplicate seq values don't affect boundary math
   377→  it('should handle duplicate seq values with correct boundary grouping', async () => {
   378→    const sessionId = testUlid('SESS', 8);
   379→    await createSession(sessionsDir, {
   380→      id: sessionId,
   381→      agent_type: 'test-agent',
   382→    });
   383→
   384→    const eventsPath = path.join(sessionsDir, sessionId, 'events.jsonl');
   385→    // Simulate concurrent appends producing duplicate seq numbers
   386→    const events = [
   387→      { ts: 1000, seq: 0, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 1 } },
   388→      { ts: 2000, seq: 1, type: 'session.update', session_id: sessionId, data: { iteration: 1 } },
   389→      { ts: 2001, seq: 1, type: 'session.update', session_id: sessionId, data: { iteration: 1 } }, // Duplicate seq!
   390→      { ts: 3000, seq: 2, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 2 } },
   391→      { ts: 4000, seq: 3, type: 'session.update', session_id: sessionId, data: { iteration: 2 } },
   392→    ];
   393→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   394→
   395→    const detail = await getSessionLogDetail(sessionsDir, sessionId);
   396→    expect(detail).not.toBeNull();
   397→    expect(detail!.iterations).toHaveLength(2);
   398→    // readEvents sorts by seq, so duplicate seq events are adjacent.
   399→    // Boundary at index of first prompt.sent, second boundary at index of second prompt.sent.
   400→    // The exact counts depend on sort stability, but total should be 5
   401→    const totalEvents = detail!.iterations.reduce((sum, i) => sum + i.event_count, 0);
   402→    expect(totalEvents).toBe(5);
   403→  });
   404→});
