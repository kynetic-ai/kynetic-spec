   292→  });
   293→
   294→  // Trait: @trait-semantic-exit-codes
   295→  describe("trait: semantic exit codes", () => {
   296→    // Budget exhaustion uses EXIT_CODES.VALIDATION_FAILED = 4
   297→    // (business rule violation), covered by ac-4 annotation below.
   298→    // N/A for this feature: ac-2 (validation=exit 1, not applicable — budget uses exit 4),
   299→    //   ac-3 (user cancellation — no confirmation prompt), ac-5 (empty result — not a query),
   300→    //   ac-6 (invalid flags — handled by base command, not budget-specific),
   301→    //   ac-7 (batch partial failure — not a batch op), ac-8 (documentation — not testable)
   302→    it("should exit with validation failed code (4) on budget exceeded", async () => {
   303→      await createTestBudget(tempDir, SESSION_ID, 1, 1);
   304→
   305→      const result = kspec("task start @test-task-pending", tempDir, {
   306→        expectFail: true,
   307→        env: { KSPEC_SESSION_ID: SESSION_ID },
   308→      });
   309→
   310→      // AC: @trait-semantic-exit-codes ac-4 — runtime/business rule violation
   311→      expect(result.exitCode).toBe(4);
   312→    });
   313→
   314→    // AC: @trait-semantic-exit-codes ac-1 — success = exit 0
   315→    it("should exit with 0 on successful start with budget room", async () => {
   316→      await createTestBudget(tempDir, SESSION_ID, 3, 0);
   317→
   318→      const result = kspec("task start @test-task-pending", tempDir, {
   319→        env: { KSPEC_SESSION_ID: SESSION_ID },
   320→      });
   321→
   322→      expect(result.exitCode).toBe(0);
   323→    });
   324→  });
   325→
   326→  // Trait: @trait-error-guidance
   327→  describe("trait: error guidance", () => {
   328→    // N/A for this feature: ac-3 (ref not found — budget errors don't involve ref lookup),
   329→    //   ac-4 (invalid state transition — budget exhaustion is not a state transition error)
   330→
   331→    // AC: @trait-error-guidance ac-1 — error includes what went wrong
   332→    it("should describe budget exhaustion in error message", async () => {
   333→      await createTestBudget(tempDir, SESSION_ID, 1, 1);
   334→
   335→      const result = kspec("task start @test-task-pending", tempDir, {
   336→        expectFail: true,
   337→        env: { KSPEC_SESSION_ID: SESSION_ID },
   338→      });
   339→
   340→      const output = result.stdout + result.stderr;
   341→      expect(output).toContain("budget");
   342→      expect(output).toContain("exhausted");
   343→    });
   344→
   345→    // AC: @trait-error-guidance ac-2 — error includes suggested action
   346→    it("should include recovery guidance (wrap up, let iteration end)", async () => {
   347→      await createTestBudget(tempDir, SESSION_ID, 1, 1);
   348→
   349→      const result = kspec("task start @test-task-pending", tempDir, {
   350→        expectFail: true,
   351→        env: { KSPEC_SESSION_ID: SESSION_ID },
   352→      });
   353→
   354→      const output = result.stdout + result.stderr;
   355→      // The checkBudget message includes "Wrap up current work and let the iteration end naturally"
   356→      expect(output).toMatch(/wrap up/i);
   357→      expect(output).toMatch(/iteration/i);
   358→    });
   359→
   360→    // AC: @trait-error-guidance ac-5 — validation error indicates which field/value failed
   361→    it("should include budget counts in error showing what was exceeded", async () => {
   362→      await createTestBudget(tempDir, SESSION_ID, 2, 2);
   363→
   364→      const result = kspec("task start @test-task-pending", tempDir, {
   365→        expectFail: true,
   366→        env: { KSPEC_SESSION_ID: SESSION_ID },
   367→      });
   368→
   369→      const output = result.stdout + result.stderr;
   370→      // Should show "2/2 tasks started"
   371→      expect(output).toContain("2/2");
   372→    });
   373→
   374→    // AC: @trait-error-guidance ac-6 — JSON mode error guidance
   375→    it("should include guidance in structured JSON error on budget exceeded", async () => {
   376→      await createTestBudget(tempDir, SESSION_ID, 1, 1);
   377→
   378→      const result = kspec("task start @test-task-pending --json", tempDir, {
