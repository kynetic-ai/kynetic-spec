     1→/**
     2→ * Integration tests for task budget enforcement.
     3→ *
     4→ * Tests that kspec task start checks and enforces session budgets,
     5→ * increments counters on successful starts, and skips checks when
     6→ * no session or budget is configured.
     7→ *
     8→ * Task: @add-budget-enforcement-to-task-start
     9→ * Spec: @task-budget-enforcement
    10→ */
    11→import { describe, it, expect, beforeEach, afterEach } from "vitest";
    12→import * as fs from "node:fs/promises";
    13→import * as path from "node:path";
    14→import {
    15→  kspec,
    16→  kspecJson,
    17→  setupTempFixtures,
    18→  cleanupTempDir,
    19→  initGitRepo,
    20→} from "./helpers/cli";
    21→
    22→/**
    23→ * Helper to create a budget file for a session in the test fixture directory.
    24→ * Budget lives at {specDir}/sessions/{sessionId}/budget.json
    25→ */
    26→async function createTestBudget(
    27→  specDir: string,
    28→  sessionId: string,
    29→  maxPerCycle: number,
    30→  startedThisCycle: number = 0,
    31→): Promise<void> {
    32→  const sessionsDir = path.join(specDir, "sessions", sessionId);
    33→  await fs.mkdir(sessionsDir, { recursive: true });
    34→  const budget = {
    35→    max_per_cycle: maxPerCycle,
    36→    started_this_cycle: startedThisCycle,
    37→  };
    38→  await fs.writeFile(
    39→    path.join(sessionsDir, "budget.json"),
    40→    JSON.stringify(budget, null, 2) + "\n",
    41→  );
    42→}
    43→
    44→/**
    45→ * Helper to read the budget file and return parsed contents.
    46→ */
    47→async function readTestBudget(
    48→  specDir: string,
    49→  sessionId: string,
    50→): Promise<{ max_per_cycle: number; started_this_cycle: number } | null> {
    51→  const budgetPath = path.join(
    52→    specDir,
    53→    "sessions",
    54→    sessionId,
    55→    "budget.json",
    56→  );
    57→  try {
    58→    const content = await fs.readFile(budgetPath, "utf-8");
    59→    return JSON.parse(content);
    60→  } catch {
    61→    return null;
    62→  }
    63→}
    64→
    65→describe("Integration: task budget enforcement", () => {
    66→  let tempDir: string;
    67→  const SESSION_ID = "01KJ7BBBHNMBABEHHDVEYSPJFR";
    68→
    69→  beforeEach(async () => {
    70→    tempDir = await setupTempFixtures();
    71→    initGitRepo(tempDir);
    72→  });
    73→
    74→  afterEach(async () => {
    75→    await cleanupTempDir(tempDir);
    76→  });
    77→
    78→  // AC: @task-budget-enforcement ac-block-start
    79→  describe("ac-block-start: blocks when budget exhausted", () => {
    80→    it("should exit nonzero when started_this_cycle >= max_per_cycle", async () => {
    81→      await createTestBudget(tempDir, SESSION_ID, 1, 1); // 1/1 used
    82→
    83→      const result = kspec("task start @test-task-pending", tempDir, {
    84→        expectFail: true,
    85→        env: { KSPEC_SESSION_ID: SESSION_ID },
    86→      });
    87→
    88→      // Should fail with validation error exit code (4)
    89→      expect(result.exitCode).toBe(4);
    90→    });
    91→
    92→    it("should include budget counts in error message", async () => {
    93→      await createTestBudget(tempDir, SESSION_ID, 1, 1);
    94→
    95→      const result = kspec("task start @test-task-pending", tempDir, {
    96→        expectFail: true,
    97→        env: { KSPEC_SESSION_ID: SESSION_ID },
    98→      });
    99→
   100→      const output = result.stdout + result.stderr;
   101→      expect(output).toContain("1/1");
   102→      expect(output).toContain("budget");
   103→    });
   104→
   105→    it("should include wrap-up instructions in error message", async () => {
   106→      await createTestBudget(tempDir, SESSION_ID, 2, 2);
   107→
   108→      const result = kspec("task start @test-task-pending", tempDir, {
   109→        expectFail: true,
   110→        env: { KSPEC_SESSION_ID: SESSION_ID },
   111→      });
   112→
   113→      const output = result.stdout + result.stderr;
   114→      expect(output).toMatch(/[Ww]rap up/);
   115→    });
   116→
   117→    it("should block even when budget is exceeded (started > max)", async () => {
   118→      await createTestBudget(tempDir, SESSION_ID, 1, 3); // 3/1 — over budget
   119→
   120→      const result = kspec("task start @test-task-pending", tempDir, {
   121→        expectFail: true,
   122→        env: { KSPEC_SESSION_ID: SESSION_ID },
   123→      });
   124→
   125→      expect(result.exitCode).toBe(4);
   126→    });
   127→  });
   128→
   129→  // AC: @task-budget-enforcement ac-no-session
   130→  describe("ac-no-session: no check when KSPEC_SESSION_ID not set", () => {
   131→    it("should allow task start without session env var", async () => {
   132→      // Create a budget that would block if checked — but without session it's skipped
   133→      const originalEnv = process.env.KSPEC_SESSION_ID;
   134→      delete process.env.KSPEC_SESSION_ID;
   135→
   136→      try {
   137→        const result = kspec("task start @test-task-pending", tempDir);
   138→        const output = result.stdout + result.stderr;
   139→        expect(output).toContain("Started task");
   140→      } finally {
   141→        if (originalEnv !== undefined) {
   142→          process.env.KSPEC_SESSION_ID = originalEnv;
   143→        }
   144→      }
   145→    });
   146→  });
   147→
   148→  // AC: @task-budget-enforcement ac-no-budget
   149→  describe("ac-no-budget: no check when no budget.json exists", () => {
   150→    it("should allow task start when session has no budget file", () => {
   151→      // Session ID set but no budget file created — budget is opt-in
   152→      const result = kspec("task start @test-task-pending", tempDir, {
   153→        env: { KSPEC_SESSION_ID: SESSION_ID },
   154→      });
   155→
   156→      const output = result.stdout + result.stderr;
   157→      expect(output).toContain("Started task");
   158→    });
   159→  });
   160→
   161→  // AC: @task-budget-enforcement ac-increment
   162→  describe("ac-increment: increments budget counter on successful start", () => {
   163→    it("should increment started_this_cycle after starting a task", async () => {
   164→      await createTestBudget(tempDir, SESSION_ID, 3, 0);
   165→
   166→      kspec("task start @test-task-pending", tempDir, {
   167→        env: { KSPEC_SESSION_ID: SESSION_ID },
   168→      });
   169→
   170→      const budget = await readTestBudget(tempDir, SESSION_ID);
   171→      expect(budget).not.toBeNull();
   172→      expect(budget!.started_this_cycle).toBe(1);
   173→      expect(budget!.max_per_cycle).toBe(3);
   174→    });
   175→
   176→    it("should increment from existing count", async () => {
   177→      await createTestBudget(tempDir, SESSION_ID, 5, 2);
   178→
   179→      kspec("task start @test-task-pending", tempDir, {
   180→        env: { KSPEC_SESSION_ID: SESSION_ID },
   181→      });
   182→
   183→      const budget = await readTestBudget(tempDir, SESSION_ID);
   184→      expect(budget!.started_this_cycle).toBe(3);
   185→    });
   186→  });
   187→
   188→  // AC: @task-budget-enforcement ac-needs-work-no-increment
   189→  describe("ac-needs-work-no-increment: no increment when restarting a needs_work task", () => {
   190→    it("should not increment budget when transitioning needs_work to in_progress", async () => {
   191→      // Set up budget with 1 task started (consumed when task was originally started)
   192→      await createTestBudget(tempDir, SESSION_ID, 3, 1);
   193→
   194→      // Put task into needs_work state (start → submit → needs-work)
   195→      // These run without budget env to avoid budget interference during setup
   196→      kspec("task start @test-task-pending", tempDir);
   197→      kspec("task submit @test-task-pending", tempDir);
   198→      kspec(
   199→        'task needs-work @test-task-pending --reason "Fix cycle test"',
   200→        tempDir,
   201→      );
   202→
   203→      // Now restart from needs_work WITH session — should NOT increment
   204→      kspec("task start @test-task-pending", tempDir, {
   205→        env: { KSPEC_SESSION_ID: SESSION_ID },
   206→      });
   207→
   208→      // Budget should still be 1 — needs_work restart doesn't burn a new slot
   209→      const budget = await readTestBudget(tempDir, SESSION_ID);
   210→      expect(budget).not.toBeNull();
   211→      expect(budget!.started_this_cycle).toBe(1);
   212→    });
   213→
   214→    it("should allow needs_work restart even when budget is exhausted", async () => {
   215→      // Budget is at max — but needs_work restart should bypass this
   216→      await createTestBudget(tempDir, SESSION_ID, 1, 1);
   217→
   218→      // Put task into needs_work without budget env
   219→      kspec("task start @test-task-pending", tempDir);
   220→      kspec("task submit @test-task-pending", tempDir);
   221→      kspec(
   222→        'task needs-work @test-task-pending --reason "Fix cycle test"',
   223→        tempDir,
   224→      );
   225→
   226→      // Restart from needs_work even though budget is exhausted
   227→      const result = kspec("task start @test-task-pending", tempDir, {
   228→        env: { KSPEC_SESSION_ID: SESSION_ID },
   229→      });
   230→
   231→      expect(result.stdout + result.stderr).toContain("Started task");
   232→    });
   233→  });
   234→
   235→  // AC: @task-budget-enforcement ac-resume-no-increment
   236→  describe("ac-resume-no-increment: no increment when task already in_progress", () => {
   237→    it("should not increment budget when resuming an in-progress task", async () => {
   238→      // First start the task (this will increment from 0 to 1)
   239→      await createTestBudget(tempDir, SESSION_ID, 3, 0);
   240→      kspec("task start @test-task-pending", tempDir, {
   241→        env: { KSPEC_SESSION_ID: SESSION_ID },
   242→      });
   243→
   244→      let budget = await readTestBudget(tempDir, SESSION_ID);
   245→      expect(budget!.started_this_cycle).toBe(1);
   246→
   247→      // Now try to start the same task again (already in_progress — resume case)
   248→      kspec("task start @test-task-pending", tempDir, {
   249→        env: { KSPEC_SESSION_ID: SESSION_ID },
   250→      });
   251→
   252→      // Budget should still be 1 — not incremented for resume
   253→      budget = await readTestBudget(tempDir, SESSION_ID);
   254→      expect(budget!.started_this_cycle).toBe(1);
   255→    });
   256→  });
   257→
   258→  // AC: @task-budget-enforcement ac-atomic-write
   259→  describe("ac-atomic-write: budget written atomically", () => {
   260→    it("should not leave temp files after increment", async () => {
   261→      await createTestBudget(tempDir, SESSION_ID, 3, 0);
   262→
   263→      kspec("task start @test-task-pending", tempDir, {
   264→        env: { KSPEC_SESSION_ID: SESSION_ID },
   265→      });
   266→
   267→      const sessionDir = path.join(tempDir, "sessions", SESSION_ID);
   268→      const files = await fs.readdir(sessionDir);
   269→      const tmpFiles = files.filter((f) => f.endsWith(".tmp"));
   270→      expect(tmpFiles).toHaveLength(0);
   271→    });
   272→
   273→    it("should produce valid JSON in budget file after increment", async () => {
   274→      await createTestBudget(tempDir, SESSION_ID, 3, 0);
   275→
   276→      kspec("task start @test-task-pending", tempDir, {
   277→        env: { KSPEC_SESSION_ID: SESSION_ID },
   278→      });
   279→
   280→      const budgetPath = path.join(
   281→        tempDir,
   282→        "sessions",
   283→        SESSION_ID,
   284→        "budget.json",
   285→      );
   286→      const content = await fs.readFile(budgetPath, "utf-8");
   287→      // Should parse without error
   288→      const budget = JSON.parse(content);
   289→      expect(budget.max_per_cycle).toBe(3);
   290→      expect(budget.started_this_cycle).toBe(1);
