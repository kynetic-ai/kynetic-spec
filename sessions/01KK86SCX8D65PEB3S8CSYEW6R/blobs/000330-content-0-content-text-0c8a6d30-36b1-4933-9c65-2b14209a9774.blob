     1→/**
     2→ * Session log list tests.
     3→ *
     4→ * Tests for the `kspec session log list` command and supporting store functions.
     5→ */
     6→
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import * as fs from 'node:fs/promises';
     9→import * as os from 'node:os';
    10→import * as path from 'node:path';
    11→import * as YAML from 'yaml';
    12→import {
    13→  createSession,
    14→  appendEvent,
    15→  saveSessionContext,
    16→  getSessionLogSummary,
    17→  getAllSessionLogSummaries,
    18→  type SessionLogSummary,
    19→} from '../src/sessions/store.js';
    20→import type { SessionMetadataInput, SessionEventInput } from '../src/sessions/types.js';
    21→import {
    22→  setupTempFixtures,
    23→  cleanupTempDir,
    24→  kspec,
    25→  kspecJson,
    26→  testUlid,
    27→} from './helpers/cli';
    28→
    29→// ─── Store Unit Tests ───────────────────────────────────────────────────────
    30→
    31→describe('getSessionLogSummary', () => {
    32→  let testDir: string;
    33→  let sessionsDir: string;
    34→
    35→  beforeEach(async () => {
    36→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-log-'));
    37→    sessionsDir = path.join(testDir, 'sessions');
    38→  });
    39→
    40→  afterEach(async () => {
    41→    await fs.rm(testDir, { recursive: true });
    42→  });
    43→
    44→  it('should return null for nonexistent session', async () => {
    45→    const summary = await getSessionLogSummary(sessionsDir, 'nonexistent');
    46→    expect(summary).toBeNull();
    47→  });
    48→
    49→  // AC: @session-log-list ac-1
    50→  it('should return summary with all expected fields', async () => {
    51→    const sessionId = testUlid('SESS');
    52→    const startedAt = '2026-01-20T10:00:00.000Z';
    53→    const endedAt = '2026-01-20T11:30:00.000Z';
    54→
    55→    await createSession(sessionsDir, {
    56→      id: sessionId,
    57→      agent_type: 'claude-agent-acp',
    58→      started_at: startedAt,
    59→    });
    60→
    61→    // Simulate completion by writing metadata directly
    62→    const metaPath = path.join(sessionsDir, sessionId, 'session.yaml');
    63→    await fs.writeFile(metaPath, YAML.stringify({
    64→      id: sessionId,
    65→      agent_type: 'claude-agent-acp',
    66→      status: 'completed',
    67→      started_at: startedAt,
    68→      ended_at: endedAt,
    69→    }));
    70→
    71→    // Add some events
    72→    for (let i = 0; i < 5; i++) {
    73→      await appendEvent(sessionsDir, {
    74→        type: i === 0 ? 'session.start' : 'prompt.sent',
    75→        session_id: sessionId,
    76→        data: null,
    77→      });
    78→    }
    79→
    80→    // Add context snapshots
    81→    await saveSessionContext(sessionsDir, sessionId, 1, { iteration: 1 });
    82→    await saveSessionContext(sessionsDir, sessionId, 2, { iteration: 2 });
    83→
    84→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
    85→    expect(summary).not.toBeNull();
    86→    expect(summary!.id).toBe(sessionId);
    87→    expect(summary!.status).toBe('completed');
    88→    expect(summary!.agent_type).toBe('claude-agent-acp');
    89→    expect(summary!.started_at).toBe(startedAt);
    90→    expect(summary!.ended_at).toBe(endedAt);
    91→    expect(summary!.duration_ms).toBe(5400000); // 1.5 hours
    92→    expect(summary!.event_count).toBe(5);
    93→    expect(summary!.iteration_count).toBe(2);
    94→    expect(summary!.tasks_completed).toBe(0);
    95→  });
    96→
    97→  // AC: @ui-session-history ac-1 — task_id included in summary
    98→  it('should include task_id in summary when session has a task', async () => {
    99→    const sessionId = testUlid('SESS', 5);
   100→    const taskId = testUlid('TASK');
   101→    await createSession(sessionsDir, {
   102→      id: sessionId,
   103→      agent_type: 'claude-agent-acp',
   104→      task_id: taskId,
   105→    });
   106→
   107→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
   108→    expect(summary).not.toBeNull();
   109→    expect(summary!.task_id).toBe(taskId);
   110→  });
   111→
   112→  // AC: @ui-session-history ac-1 — task_id undefined when session has no task
   113→  it('should have undefined task_id when session has no task', async () => {
   114→    const sessionId = testUlid('SESS', 6);
   115→    await createSession(sessionsDir, {
   116→      id: sessionId,
   117→      agent_type: 'test-agent',
   118→    });
   119→
   120→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
   121→    expect(summary).not.toBeNull();
   122→    expect(summary!.task_id).toBeUndefined();
   123→  });
   124→
   125→  it('should compute duration from now for active sessions', async () => {
   126→    const sessionId = testUlid('SESS', 1);
   127→    await createSession(sessionsDir, {
   128→      id: sessionId,
   129→      agent_type: 'test-agent',
   130→    });
   131→
   132→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
   133→    expect(summary).not.toBeNull();
   134→    expect(summary!.status).toBe('active');
   135→    expect(summary!.duration_ms).toBeGreaterThan(0);
   136→    expect(summary!.ended_at).toBeUndefined();
   137→  });
   138→
   139→  it('should count task completions from realistic tool_call events', async () => {
   140→    const sessionId = testUlid('SESS', 2);
   141→    await createSession(sessionsDir, {
   142→      id: sessionId,
   143→      agent_type: 'claude-agent-acp',
   144→    });
   145→
   146→    // Append events including realistic task complete tool calls
   147→    await appendEvent(sessionsDir, {
   148→      type: 'session.start',
   149→      session_id: sessionId,
   150→      data: null,
   151→    });
   152→    // Write realistic session.update events with tool_call shape
   153→    const eventsPath = path.join(sessionsDir, sessionId, 'events.jsonl');
   154→    const toolCallEvent1 = JSON.stringify({
   155→      ts: Date.now(),
   156→      seq: 1,
   157→      type: 'session.update',
   158→      session_id: sessionId,
   159→      data: {
   160→        iteration: 1,
   161→        update: {
   162→          _meta: { claudeCode: { toolName: 'Bash' } },
   163→          sessionUpdate: 'tool_call',
   164→          rawInput: { command: 'kspec task complete @my-task --reason "Done"' },
   165→        },
   166→      },
   167→    });
   168→    await fs.appendFile(eventsPath, toolCallEvent1 + '\n');
   169→    const toolCallEvent2 = JSON.stringify({
   170→      ts: Date.now(),
   171→      seq: 2,
   172→      type: 'session.update',
   173→      session_id: sessionId,
   174→      data: {
   175→        iteration: 1,
   176→        update: {
   177→          _meta: { claudeCode: { toolName: 'Bash' } },
   178→          sessionUpdate: 'tool_call',
   179→          rawInput: { command: 'npm run dev -- task complete @another-task --reason "All done"' },
   180→        },
   181→      },
   182→    });
   183→    await fs.appendFile(eventsPath, toolCallEvent2 + '\n');
   184→
   185→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
   186→    expect(summary!.tasks_completed).toBe(2);
   187→    expect(summary!.event_count).toBe(3); // session.start + 2 tool_call updates
   188→  });
   189→
   190→  // AC: @session-log-list ac-1 (claude-agent-acp: commands in tool_call_update events)
   191→  it('should count task completions from tool_call_update events (claude-agent-acp format)', async () => {
   192→    const sessionId = testUlid('SESS', 3);
   193→    await createSession(sessionsDir, { id: sessionId, agent_type: 'claude-agent-acp' });
   194→
   195→    const eventsPath = path.join(sessionsDir, sessionId, 'events.jsonl');
   196→    // claude-agent-acp: initial tool_call has empty rawInput, command arrives in tool_call_update
   197→    const emptyToolCall = JSON.stringify({
   198→      ts: Date.now(), seq: 1, type: 'session.update', session_id: sessionId,
   199→      data: { update: { sessionUpdate: 'tool_call', rawInput: {}, toolCallId: 'tc-1' } },
   200→    });
   201→    await fs.appendFile(eventsPath, emptyToolCall + '\n');
   202→    const populatedUpdate = JSON.stringify({
   203→      ts: Date.now(), seq: 2, type: 'session.update', session_id: sessionId,
   204→      data: { update: { sessionUpdate: 'tool_call_update', rawInput: { command: 'kspec task complete @my-task --reason "Done"', description: 'Complete task' }, toolCallId: 'tc-1' } },
   205→    });
   206→    await fs.appendFile(eventsPath, populatedUpdate + '\n');
   207→
   208→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
   209→    expect(summary!.tasks_completed).toBe(1);
   210→  });
   211→
   212→  // AC: @session-log-list ac-1 (codex-acp: command is array in tool_call events)
   213→  it('should count task completions from array commands (codex-acp format)', async () => {
   214→    const sessionId = testUlid('SESS', 4);
   215→    await createSession(sessionsDir, { id: sessionId, agent_type: 'codex-acp' });
   216→
   217→    const eventsPath = path.join(sessionsDir, sessionId, 'events.jsonl');
   218→    // codex-acp: command is ['/usr/bin/bash', '-lc', 'kspec task complete @ref']
   219→    const arrayCommandEvent = JSON.stringify({
   220→      ts: Date.now(), seq: 1, type: 'session.update', session_id: sessionId,
   221→      data: { update: { sessionUpdate: 'tool_call', rawInput: { command: ['/usr/bin/bash', '-lc', 'kspec task complete @my-task'] } } },
   222→    });
   223→    await fs.appendFile(eventsPath, arrayCommandEvent + '\n');
   224→
   225→    const summary = await getSessionLogSummary(sessionsDir, sessionId);
   226→    expect(summary!.tasks_completed).toBe(1);
   227→  });
   228→});
   229→
   230→describe('getAllSessionLogSummaries', () => {
   231→  let testDir: string;
   232→  let sessionsDir: string;
   233→
   234→  beforeEach(async () => {
   235→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-log-all-'));
   236→    sessionsDir = path.join(testDir, 'sessions');
   237→  });
   238→
   239→  afterEach(async () => {
   240→    await fs.rm(testDir, { recursive: true });
   241→  });
   242→
   243→  // AC: @session-log-list ac-6
   244→  it('should return empty array when no sessions exist', async () => {
   245→    const summaries = await getAllSessionLogSummaries(sessionsDir);
   246→    expect(summaries).toEqual([]);
   247→  });
   248→
   249→  it('should return summaries for all sessions', async () => {
   250→    const id1 = testUlid('SESS', 1);
   251→    const id2 = testUlid('SESS', 2);
   252→
   253→    await createSession(sessionsDir, { id: id1, agent_type: 'agent-a' });
   254→    await createSession(sessionsDir, { id: id2, agent_type: 'agent-b' });
   255→
   256→    const summaries = await getAllSessionLogSummaries(sessionsDir);
   257→    expect(summaries).toHaveLength(2);
   258→    expect(summaries.map(s => s.id).sort()).toEqual([id1, id2].sort());
   259→  });
   260→});
   261→
   262→// ─── CLI Integration Tests ──────────────────────────────────────────────────
   263→
   264→describe('kspec session log list (CLI)', () => {
   265→  let tempDir: string;
   266→
   267→  beforeEach(async () => {
   268→    tempDir = await setupTempFixtures();
   269→
   270→    // In traditional mode (no shadow branch), specDir = tempDir
   271→    // Sessions go in tempDir/sessions/
   272→    const sessionsDir = path.join(tempDir, 'sessions');
   273→    await fs.mkdir(sessionsDir, { recursive: true });
   274→
   275→    // Session 1: completed, old
   276→    const s1 = testUlid('SESS', 1);
   277→    const s1Dir = path.join(sessionsDir, s1);
   278→    await fs.mkdir(s1Dir);
   279→    await fs.writeFile(path.join(s1Dir, 'session.yaml'), YAML.stringify({
   280→      id: s1,
   281→      agent_type: 'claude-agent-acp',
   282→      status: 'completed',
   283→      started_at: '2026-01-15T10:00:00.000Z',
   284→      ended_at: '2026-01-15T11:30:00.000Z',
   285→    }));
   286→    await fs.writeFile(path.join(s1Dir, 'events.jsonl'), [
   287→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s1, data: null }),
   288→      JSON.stringify({ ts: 2000, seq: 1, type: 'prompt.sent', session_id: s1, data: null }),
   289→      JSON.stringify({ ts: 3000, seq: 2, type: 'session.end', session_id: s1, data: null }),
   290→    ].join('\n') + '\n');
   291→    await fs.writeFile(path.join(s1Dir, 'context-iter-1.json'), '{}');
   292→
   293→    // Session 2: active, recent
   294→    const s2 = testUlid('SESS', 2);
   295→    const s2Dir = path.join(sessionsDir, s2);
   296→    await fs.mkdir(s2Dir);
   297→    await fs.writeFile(path.join(s2Dir, 'session.yaml'), YAML.stringify({
   298→      id: s2,
   299→      agent_type: 'custom-agent',
   300→      status: 'active',
   301→      started_at: '2026-02-05T08:00:00.000Z',
   302→    }));
   303→    await fs.writeFile(path.join(s2Dir, 'events.jsonl'), [
   304→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s2, data: null }),
   305→      JSON.stringify({ ts: 2000, seq: 1, type: 'prompt.sent', session_id: s2, data: null }),
   306→      JSON.stringify({ ts: 3000, seq: 2, type: 'prompt.sent', session_id: s2, data: null }),
   307→      JSON.stringify({ ts: 4000, seq: 3, type: 'prompt.sent', session_id: s2, data: null }),
   308→      JSON.stringify({ ts: 5000, seq: 4, type: 'prompt.sent', session_id: s2, data: null }),
   309→    ].join('\n') + '\n');
   310→    await fs.writeFile(path.join(s2Dir, 'context-iter-1.json'), '{}');
   311→    await fs.writeFile(path.join(s2Dir, 'context-iter-2.json'), '{}');
   312→    await fs.writeFile(path.join(s2Dir, 'context-iter-3.json'), '{}');
   313→
   314→    // Session 3: completed, recent
   315→    const s3 = testUlid('SESS', 3);
   316→    const s3Dir = path.join(sessionsDir, s3);
   317→    await fs.mkdir(s3Dir);
   318→    await fs.writeFile(path.join(s3Dir, 'session.yaml'), YAML.stringify({
   319→      id: s3,
   320→      agent_type: 'claude-agent-acp',
   321→      status: 'completed',
   322→      started_at: '2026-02-04T14:00:00.000Z',
   323→      ended_at: '2026-02-04T15:00:00.000Z',
   324→    }));
   325→    await fs.writeFile(path.join(s3Dir, 'events.jsonl'), [
   326→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s3, data: null }),
   327→      JSON.stringify({
   328→        ts: 2000, seq: 1, type: 'session.update', session_id: s3,
   329→        data: {
   330→          iteration: 1,
   331→          update: {
   332→            _meta: { claudeCode: { toolName: 'Bash' } },
   333→            sessionUpdate: 'tool_call',
   334→            rawInput: { command: 'kspec task complete @task-1 --reason "Done"' },
   335→          },
   336→        },
   337→      }),
   338→    ].join('\n') + '\n');
   339→  });
   340→
   341→  afterEach(async () => {
   342→    await cleanupTempDir(tempDir);
   343→  });
   344→
   345→  // AC: @session-log-list ac-1
   346→  it('should display sessions in table format', () => {
   347→    const result = kspec('session log list', tempDir);
   348→    expect(result.exitCode).toBe(0);
   349→    expect(result.stdout).toContain('ID');
   350→    expect(result.stdout).toContain('Status');
   351→    expect(result.stdout).toContain('Agent');
   352→    expect(result.stdout).toContain('Started');
   353→    expect(result.stdout).toContain('Duration');
   354→    expect(result.stdout).toContain('Events');
   355→    expect(result.stdout).toContain('Iters');
   356→    expect(result.stdout).toContain('Tasks');
   357→    expect(result.stdout).toContain('3 session(s)');
   358→  });
   359→
   360→  // AC: @session-log-list ac-1 (JSON variant)
   361→  it('should output valid JSON with all fields in --json mode', () => {
   362→    const sessions = kspecJson<SessionLogSummary[]>('session log list', tempDir);
   363→    expect(sessions).toHaveLength(3);
   364→
   365→    for (const session of sessions) {
   366→      expect(session).toHaveProperty('id');
   367→      expect(session).toHaveProperty('status');
   368→      expect(session).toHaveProperty('agent_type');
   369→      expect(session).toHaveProperty('started_at');
   370→      expect(session).toHaveProperty('duration_ms');
   371→      expect(session).toHaveProperty('event_count');
   372→      expect(session).toHaveProperty('iteration_count');
   373→      expect(session).toHaveProperty('tasks_completed');
   374→    }
   375→  });
   376→
   377→  // AC: @session-log-list ac-2
   378→  it('should filter by --status', () => {
   379→    const sessions = kspecJson<SessionLogSummary[]>('session log list --status completed', tempDir);
   380→    expect(sessions).toHaveLength(2);
   381→    for (const s of sessions) {
   382→      expect(s.status).toBe('completed');
   383→    }
   384→  });
   385→
   386→  // AC: @session-log-list ac-2
   387→  it('should filter by --status active', () => {
   388→    const sessions = kspecJson<SessionLogSummary[]>('session log list --status active', tempDir);
   389→    expect(sessions).toHaveLength(1);
   390→    expect(sessions[0].status).toBe('active');
   391→    expect(sessions[0].agent_type).toBe('custom-agent');
   392→  });
   393→
   394→  // AC: @session-log-list ac-3
   395→  it('should filter by --since', () => {
   396→    const sessions = kspecJson<SessionLogSummary[]>('session log list --since 2026-02-01', tempDir);
   397→    // Only sessions 2 and 3 are after Feb 1
   398→    expect(sessions).toHaveLength(2);
   399→    for (const s of sessions) {
   400→      expect(new Date(s.started_at).getTime()).toBeGreaterThanOrEqual(new Date('2026-02-01').getTime());
   401→    }
   402→  });
   403→
   404→  // AC: @session-log-list ac-4
   405→  it('should filter by --agent', () => {
   406→    const sessions = kspecJson<SessionLogSummary[]>('session log list --agent custom-agent', tempDir);
   407→    expect(sessions).toHaveLength(1);
   408→    expect(sessions[0].agent_type).toBe('custom-agent');
   409→  });
   410→
   411→  // AC: @session-log-list ac-4
   412→  it('should filter by --agent for claude-agent-acp', () => {
   413→    const sessions = kspecJson<SessionLogSummary[]>('session log list --agent claude-agent-acp', tempDir);
   414→    expect(sessions).toHaveLength(2);
   415→    for (const s of sessions) {
   416→      expect(s.agent_type).toBe('claude-agent-acp');
   417→    }
   418→  });
   419→
   420→  // AC: @session-log-list ac-5
   421→  it('should sort by started_at descending by default', () => {
   422→    const sessions = kspecJson<SessionLogSummary[]>('session log list', tempDir);
   423→    expect(sessions).toHaveLength(3);
   424→    // Most recent first
   425→    for (let i = 1; i < sessions.length; i++) {
   426→      expect(new Date(sessions[i - 1].started_at).getTime())
   427→        .toBeGreaterThanOrEqual(new Date(sessions[i].started_at).getTime());
   428→    }
   429→  });
   430→
   431→  // AC: @session-log-list ac-5
   432→  it('should sort by events when --sort events is provided', () => {
   433→    const sessions = kspecJson<SessionLogSummary[]>('session log list --sort events', tempDir);
   434→    // Highest event count first
   435→    for (let i = 1; i < sessions.length; i++) {
   436→      expect(sessions[i - 1].event_count).toBeGreaterThanOrEqual(sessions[i].event_count);
   437→    }
   438→  });
   439→
   440→  // AC: @session-log-list ac-5
   441→  it('should sort by iterations when --sort iterations is provided', () => {
   442→    const sessions = kspecJson<SessionLogSummary[]>('session log list --sort iterations', tempDir);
   443→    for (let i = 1; i < sessions.length; i++) {
   444→      expect(sessions[i - 1].iteration_count).toBeGreaterThanOrEqual(sessions[i].iteration_count);
   445→    }
   446→  });
   447→
   448→  // AC: @session-log-list ac-6
   449→  it('should show "No sessions found" when no sessions exist', async () => {
   450→    // Remove all sessions
   451→    const sessionsDir = path.join(tempDir, 'sessions');
   452→    await fs.rm(sessionsDir, { recursive: true });
   453→    await fs.mkdir(sessionsDir);
   454→
   455→    const result = kspec('session log list', tempDir);
   456→    expect(result.exitCode).toBe(0);
   457→    expect(result.stdout).toContain('No sessions found');
   458→  });
   459→
   460→  // AC: @session-log-list ac-6 (JSON variant)
   461→  it('should return empty array in JSON mode when no sessions exist', async () => {
   462→    const sessionsDir = path.join(tempDir, 'sessions');
   463→    await fs.rm(sessionsDir, { recursive: true });
   464→    await fs.mkdir(sessionsDir);
   465→
   466→    const sessions = kspecJson<SessionLogSummary[]>('session log list', tempDir);
   467→    expect(sessions).toEqual([]);
   468→  });
   469→
   470→  // AC: @session-log-list ac-7
   471→  it('should limit output with --count flag (shows count only)', () => {
   472→    const result = kspec('session log list --count', tempDir);
   473→    expect(result.exitCode).toBe(0);
   474→    expect(result.stdout).toBe('3');
   475→  });
   476→
   477→  // AC: @session-log-list ac-7 (JSON --count)
   478→  it('should return count in JSON mode with --count', () => {
   479→    const data = kspecJson<{ count: number }>('session log list --count', tempDir);
   480→    expect(data.count).toBe(3);
   481→  });
   482→
   483→  // AC: @session-log-list ac-7 (--count with filters)
   484→  it('should respect filters with --count', () => {
   485→    const data = kspecJson<{ count: number }>('session log list --count --status completed', tempDir);
   486→    expect(data.count).toBe(2);
   487→  });
   488→
   489→  // --limit flag
   490→  it('should limit number of sessions with -n flag', () => {
   491→    const sessions = kspecJson<SessionLogSummary[]>('session log list -n 2', tempDir);
   492→    expect(sessions).toHaveLength(2);
   493→  });
   494→
   495→  // Combined filters
   496→  it('should combine --status and --agent filters', () => {
   497→    const sessions = kspecJson<SessionLogSummary[]>(
   498→      'session log list --status active --agent custom-agent',
   499→      tempDir,
   500→    );
   501→    expect(sessions).toHaveLength(1);
   502→    expect(sessions[0].status).toBe('active');
   503→    expect(sessions[0].agent_type).toBe('custom-agent');
   504→  });
   505→
   506→  // Task completion counting
   507→  it('should count task completions', () => {
   508→    const sessions = kspecJson<SessionLogSummary[]>('session log list --status completed', tempDir);
