   111→// ─── Path Helper Tests ──────────────────────────────────────────────────────
   112→
   113→describe("getSessionBudgetPath", () => {
   114→  // AC: @session-creation-and-env-injection ac-budget-local
   115→  it("should return path inside session directory", () => {
   116→    const sessionsDir = "/test/.kspec/sessions";
   117→    const sessionId = "01KF123456789ABCDEFGHJKMNP";
   118→    expect(getSessionBudgetPath(sessionsDir, sessionId)).toBe(
   119→      `/test/.kspec/sessions/${sessionId}/budget.json`,
   120→    );
   121→  });
   122→});
   123→
   124→// ─── Budget CRUD Tests ──────────────────────────────────────────────────────
   125→
   126→describe("Budget CRUD", () => {
   127→  let testDir: string;
   128→  let sessionsDir: string;
   129→  const sessionId = "01KF123456789ABCDEFGHJKMNP";
   130→
   131→  beforeEach(async () => {
   132→    testDir = await fs.mkdtemp(
   133→      path.join(os.tmpdir(), "kspec-budget-test-"),
   134→    );
   135→    sessionsDir = path.join(testDir, "sessions");
   136→    // Create a session directory so budget operations have a home
   137→    const input: SessionMetadataInput = {
   138→      id: sessionId,
   139→      agent_type: "claude-code",
   140→    };
   141→    await createSession(sessionsDir, input);
   142→  });
   143→
   144→  afterEach(async () => {
   145→    await fs.rm(testDir, { recursive: true });
   146→  });
   147→
   148→  describe("createBudget", () => {
   149→    // AC: @session-creation-and-env-injection ac-budget
   150→    it("should create budget.json with max_per_cycle and started_this_cycle=0", async () => {
   151→      const budget = await createBudget(sessionsDir, sessionId, 3);
   152→
   153→      expect(budget.max_per_cycle).toBe(3);
   154→      expect(budget.started_this_cycle).toBe(0);
   155→
   156→      // Verify file on disk
   157→      const budgetPath = getSessionBudgetPath(sessionsDir, sessionId);
   158→      const content = await fs.readFile(budgetPath, "utf-8");
   159→      const parsed = JSON.parse(content);
   160→      expect(parsed.max_per_cycle).toBe(3);
   161→      expect(parsed.started_this_cycle).toBe(0);
   162→    });
   163→
   164→    // AC: @session-creation-and-env-injection ac-budget-local
   165→    it("should store budget in local filesystem under sessions dir", async () => {
   166→      await createBudget(sessionsDir, sessionId, 2);
   167→
   168→      const budgetPath = getSessionBudgetPath(sessionsDir, sessionId);
   169→      expect(budgetPath).toContain("sessions");
   170→      expect(budgetPath).toContain(sessionId);
   171→      expect(budgetPath).toContain("budget.json");
   172→
   173→      // File should exist
   174→      const stat = await fs.stat(budgetPath);
   175→      expect(stat.isFile()).toBe(true);
   176→    });
   177→
   178→    it("should reject invalid max_per_cycle", async () => {
   179→      await expect(createBudget(sessionsDir, sessionId, 0)).rejects.toThrow();
   180→      await expect(createBudget(sessionsDir, sessionId, -1)).rejects.toThrow();
   181→    });
   182→  });
   183→
   184→  describe("getBudget", () => {
   185→    // AC: @task-budget-enforcement ac-no-budget
   186→    it("should return null when no budget configured", async () => {
   187→      const budget = await getBudget(sessionsDir, sessionId);
   188→      expect(budget).toBeNull();
   189→    });
   190→
   191→    it("should return budget after creation", async () => {
   192→      await createBudget(sessionsDir, sessionId, 5);
   193→      const budget = await getBudget(sessionsDir, sessionId);
   194→
   195→      expect(budget).not.toBeNull();
   196→      expect(budget!.max_per_cycle).toBe(5);
   197→      expect(budget!.started_this_cycle).toBe(0);
   198→    });
   199→
   200→    it("should return null for nonexistent session", async () => {
   201→      const budget = await getBudget(sessionsDir, "NONEXISTENT");
   202→      expect(budget).toBeNull();
   203→    });
   204→
   205→    it("should throw on corrupt budget.json (fail closed, not open)", async () => {
   206→      // Write invalid JSON to budget.json — should throw, not silently disable enforcement
   207→      const budgetPath = getSessionBudgetPath(sessionsDir, sessionId);
   208→      await fs.writeFile(budgetPath, "not valid json{{{", "utf-8");
   209→
   210→      await expect(getBudget(sessionsDir, sessionId)).rejects.toThrow();
   211→    });
   212→
   213→    it("should throw on budget.json with invalid schema", async () => {
   214→      // Write valid JSON but wrong schema — should throw, not silently disable enforcement
   215→      const budgetPath = getSessionBudgetPath(sessionsDir, sessionId);
   216→      await fs.writeFile(budgetPath, JSON.stringify({ wrong: "shape" }), "utf-8");
   217→
   218→      await expect(getBudget(sessionsDir, sessionId)).rejects.toThrow();
   219→    });
   220→  });
   221→
   222→  describe("checkBudget", () => {
   223→    // AC: @task-budget-enforcement ac-no-session
   224→    it("should allow when no session ID provided", async () => {
   225→      const result = await checkBudget(sessionsDir, undefined);
   226→      expect(result.allowed).toBe(true);
   227→      expect(result.budget).toBeUndefined();
   228→    });
   229→
   230→    // AC: @task-budget-enforcement ac-no-budget
   231→    it("should allow when session has no budget configured", async () => {
   232→      const result = await checkBudget(sessionsDir, sessionId);
   233→      expect(result.allowed).toBe(true);
   234→      expect(result.budget).toBeUndefined();
   235→    });
   236→
   237→    it("should allow when under budget", async () => {
   238→      await createBudget(sessionsDir, sessionId, 3);
   239→      const result = await checkBudget(sessionsDir, sessionId);
   240→
   241→      expect(result.allowed).toBe(true);
   242→      expect(result.budget).toBeDefined();
   243→      expect(result.budget!.started_this_cycle).toBe(0);
   244→    });
   245→
   246→    // AC: @task-budget-enforcement ac-block-start
   247→    it("should block when budget exhausted", async () => {
   248→      await createBudget(sessionsDir, sessionId, 1);
   249→      await incrementBudget(sessionsDir, sessionId);
   250→
   251→      const result = await checkBudget(sessionsDir, sessionId);
   252→      expect(result.allowed).toBe(false);
   253→      expect(result.reason).toContain("1/1");
   254→      expect(result.reason).toContain("budget exhausted");
   255→      expect(result.budget).toBeDefined();
   256→      expect(result.budget!.started_this_cycle).toBe(1);
   257→    });
   258→
   259→    // AC: @task-budget-enforcement ac-block-start
   260→    it("should include budget counts in rejection message", async () => {
   261→      await createBudget(sessionsDir, sessionId, 2);
   262→      await incrementBudget(sessionsDir, sessionId);
   263→      await incrementBudget(sessionsDir, sessionId);
   264→
   265→      const result = await checkBudget(sessionsDir, sessionId);
   266→      expect(result.allowed).toBe(false);
   267→      expect(result.reason).toContain("2/2");
   268→      expect(result.reason).toContain("Wrap up");
   269→    });
   270→  });
   271→
   272→  describe("incrementBudget", () => {
   273→    // AC: @task-budget-enforcement ac-increment
   274→    it("should increment started_this_cycle by 1", async () => {
   275→      await createBudget(sessionsDir, sessionId, 5);
   276→
   277→      const updated = await incrementBudget(sessionsDir, sessionId);
   278→      expect(updated).not.toBeNull();
   279→      expect(updated!.started_this_cycle).toBe(1);
   280→      expect(updated!.max_per_cycle).toBe(5);
   281→
   282→      // Verify persisted
   283→      const read = await getBudget(sessionsDir, sessionId);
   284→      expect(read!.started_this_cycle).toBe(1);
   285→    });
   286→
   287→    it("should increment multiple times", async () => {
   288→      await createBudget(sessionsDir, sessionId, 5);
   289→
   290→      await incrementBudget(sessionsDir, sessionId);
   291→      await incrementBudget(sessionsDir, sessionId);
   292→      const updated = await incrementBudget(sessionsDir, sessionId);
   293→
   294→      expect(updated!.started_this_cycle).toBe(3);
   295→    });
   296→
   297→    it("should return null when no budget configured", async () => {
   298→      const result = await incrementBudget(sessionsDir, sessionId);
   299→      expect(result).toBeNull();
   300→    });
   301→
   302→    // AC: @task-budget-enforcement ac-atomic-write
   303→    it("should write atomically (no temp files left behind)", async () => {
   304→      await createBudget(sessionsDir, sessionId, 3);
   305→      await incrementBudget(sessionsDir, sessionId);
   306→
   307→      // Check that no .tmp files remain in session dir
   308→      const sessionDir = path.join(sessionsDir, sessionId);
   309→      const files = await fs.readdir(sessionDir);
   310→      const tmpFiles = files.filter((f) => f.endsWith(".tmp"));
   311→      expect(tmpFiles).toHaveLength(0);
   312→    });
   313→  });
   314→
   315→  describe("resetBudget", () => {
   316→    // AC: @task-budget-enforcement ac-reset
   317→    it("should reset started_this_cycle to 0", async () => {
   318→      await createBudget(sessionsDir, sessionId, 3);
   319→      await incrementBudget(sessionsDir, sessionId);
   320→      await incrementBudget(sessionsDir, sessionId);
   321→
   322→      const reset = await resetBudget(sessionsDir, sessionId);
   323→      expect(reset).not.toBeNull();
   324→      expect(reset!.started_this_cycle).toBe(0);
   325→      expect(reset!.max_per_cycle).toBe(3);
   326→
   327→      // Verify persisted
   328→      const read = await getBudget(sessionsDir, sessionId);
   329→      expect(read!.started_this_cycle).toBe(0);
   330→    });
   331→
   332→    it("should return null when no budget configured", async () => {
   333→      const result = await resetBudget(sessionsDir, sessionId);
   334→      expect(result).toBeNull();
   335→    });
   336→
   337→    it("should preserve max_per_cycle after reset", async () => {
   338→      await createBudget(sessionsDir, sessionId, 7);
   339→      await incrementBudget(sessionsDir, sessionId);
   340→      await resetBudget(sessionsDir, sessionId);
   341→
   342→      const budget = await getBudget(sessionsDir, sessionId);
   343→      expect(budget!.max_per_cycle).toBe(7);
   344→      expect(budget!.started_this_cycle).toBe(0);
   345→    });
   346→
   347→    // AC: @task-budget-enforcement ac-atomic-write
   348→    it("should write atomically (no temp files left behind)", async () => {
   349→      await createBudget(sessionsDir, sessionId, 3);
   350→      await incrementBudget(sessionsDir, sessionId);
   351→      await resetBudget(sessionsDir, sessionId);
   352→
   353→      const sessionDir = path.join(sessionsDir, sessionId);
   354→      const files = await fs.readdir(sessionDir);
   355→      const tmpFiles = files.filter((f) => f.endsWith(".tmp"));
   356→      expect(tmpFiles).toHaveLength(0);
   357→    });
   358→  });
   359→
   360→  describe("full lifecycle", () => {
   361→    it("should support create \u2192 increment \u2192 check \u2192 reset \u2192 check cycle", async () => {
   362→      // Create budget allowing 1 task per cycle
   363→      await createBudget(sessionsDir, sessionId, 1);
   364→
   365→      // Check: should be allowed (0/1)
   366→      let check = await checkBudget(sessionsDir, sessionId);
   367→      expect(check.allowed).toBe(true);
   368→
   369→      // Increment after starting a task
   370→      await incrementBudget(sessionsDir, sessionId);
   371→
   372→      // Check: should be blocked (1/1)
   373→      check = await checkBudget(sessionsDir, sessionId);
   374→      expect(check.allowed).toBe(false);
   375→
   376→      // Reset at iteration boundary
   377→      await resetBudget(sessionsDir, sessionId);
   378→
   379→      // Check: should be allowed again (0/1)
   380→      check = await checkBudget(sessionsDir, sessionId);
   381→      expect(check.allowed).toBe(true);
   382→    });
   383→  });
   384→});
