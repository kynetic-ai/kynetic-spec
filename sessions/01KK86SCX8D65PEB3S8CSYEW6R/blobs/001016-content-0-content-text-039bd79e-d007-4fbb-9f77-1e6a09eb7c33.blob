     1→/**
     2→ * Session task budget tests.
     3→ *
     4→ * Tests for budget schema validation and CRUD operations
     5→ * (create, read, check, increment, reset).
     6→ *
     7→ * Task: @extend-session-schema-with-task-budget
     8→ * Spec: @session-creation-and-env-injection
     9→ * Spec: @task-budget-enforcement
    10→ */
    11→
    12→import { describe, it, expect, beforeEach, afterEach } from "vitest";
    13→import * as fs from "node:fs/promises";
    14→import * as path from "node:path";
    15→import * as os from "node:os";
    16→import { TaskBudgetSchema } from "../src/sessions/types.js";
    17→import {
    18→  createBudget,
    19→  getBudget,
    20→  checkBudget,
    21→  incrementBudget,
    22→  resetBudget,
    23→  getSessionBudgetPath,
    24→  createSession,
    25→} from "../src/sessions/store.js";
    26→import type { SessionMetadataInput } from "../src/sessions/types.js";
    27→
    28→// ─── Schema Tests ────────────────────────────────────────────────────────────
    29→
    30→describe("TaskBudgetSchema", () => {
    31→  // AC: @session-creation-and-env-injection ac-budget
    32→  it("should accept valid budget with positive max and zero started", () => {
    33→    const result = TaskBudgetSchema.safeParse({
    34→      max_per_cycle: 3,
    35→      started_this_cycle: 0,
    36→    });
    37→    expect(result.success).toBe(true);
    38→    if (result.success) {
    39→      expect(result.data.max_per_cycle).toBe(3);
    40→      expect(result.data.started_this_cycle).toBe(0);
    41→    }
    42→  });
    43→
    44→  it("should accept budget with started equal to max", () => {
    45→    const result = TaskBudgetSchema.safeParse({
    46→      max_per_cycle: 2,
    47→      started_this_cycle: 2,
    48→    });
    49→    expect(result.success).toBe(true);
    50→  });
    51→
    52→  it("should accept budget with started exceeding max (counter, not constraint)", () => {
    53→    const result = TaskBudgetSchema.safeParse({
    54→      max_per_cycle: 1,
    55→      started_this_cycle: 5,
    56→    });
    57→    expect(result.success).toBe(true);
    58→  });
    59→
    60→  it("should reject zero max_per_cycle", () => {
    61→    const result = TaskBudgetSchema.safeParse({
    62→      max_per_cycle: 0,
    63→      started_this_cycle: 0,
    64→    });
    65→    expect(result.success).toBe(false);
    66→  });
    67→
    68→  it("should reject negative max_per_cycle", () => {
    69→    const result = TaskBudgetSchema.safeParse({
    70→      max_per_cycle: -1,
    71→      started_this_cycle: 0,
    72→    });
    73→    expect(result.success).toBe(false);
    74→  });
    75→
    76→  it("should reject negative started_this_cycle", () => {
    77→    const result = TaskBudgetSchema.safeParse({
    78→      max_per_cycle: 3,
    79→      started_this_cycle: -1,
    80→    });
    81→    expect(result.success).toBe(false);
    82→  });
    83→
    84→  it("should reject non-integer max_per_cycle", () => {
    85→    const result = TaskBudgetSchema.safeParse({
    86→      max_per_cycle: 1.5,
    87→      started_this_cycle: 0,
    88→    });
    89→    expect(result.success).toBe(false);
    90→  });
    91→
    92→  it("should reject non-integer started_this_cycle", () => {
    93→    const result = TaskBudgetSchema.safeParse({
    94→      max_per_cycle: 1,
    95→      started_this_cycle: 0.5,
    96→    });
    97→    expect(result.success).toBe(false);
    98→  });
    99→
   100→  it("should reject missing fields", () => {
   101→    expect(TaskBudgetSchema.safeParse({}).success).toBe(false);
   102→    expect(
   103→      TaskBudgetSchema.safeParse({ max_per_cycle: 1 }).success,
   104→    ).toBe(false);
   105→    expect(
   106→      TaskBudgetSchema.safeParse({ started_this_cycle: 0 }).success,
   107→    ).toBe(false);
   108→  });
   109→});
