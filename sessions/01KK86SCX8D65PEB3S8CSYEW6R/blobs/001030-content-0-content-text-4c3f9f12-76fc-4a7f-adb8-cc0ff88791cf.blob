   482→
   483→  // AC: @session-log-search ac-1
   484→  it('should search for pattern and display matches grouped by session', () => {
   485→    const result = kspec('session log search build', tempDir);
   486→    expect(result.exitCode).toBe(0);
   487→    expect(result.stdout).toContain('match');
   488→    expect(result.stdout).toContain('session');
   489→  });
   490→
   491→  // AC: @session-log-search ac-1 (JSON variant)
   492→  it('should return valid JSON with matches grouped by session in --json mode', () => {
   493→    const results = kspecJson<SessionSearchResult[]>('session log search build', tempDir);
   494→    expect(results.length).toBeGreaterThan(0);
   495→
   496→    for (const result of results) {
