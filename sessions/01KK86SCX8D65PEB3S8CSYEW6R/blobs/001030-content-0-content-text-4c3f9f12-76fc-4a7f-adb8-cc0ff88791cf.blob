     1→/**
     2→ * Session log search tests.
     3→ *
     4→ * Tests for the `kspec session log search` command and supporting store functions.
     5→ */
     6→
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import * as fs from 'node:fs/promises';
     9→import * as os from 'node:os';
    10→import * as path from 'node:path';
    11→import * as YAML from 'yaml';
    12→import {
    13→  searchSessionEvents,
    14→  type SessionSearchResult,
    15→} from '../src/sessions/store.js';
    16→import {
    17→  setupTempFixtures,
    18→  cleanupTempDir,
    19→  kspec,
    20→  kspecJson,
    21→  testUlid,
    22→} from './helpers/cli';
    23→
    24→// ─── Store Unit Tests ───────────────────────────────────────────────────────
    25→
    26→describe('searchSessionEvents', () => {
    27→  let testDir: string;
    28→  let sessionsDir: string;
    29→
    30→  beforeEach(async () => {
    31→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-search-'));
    32→
    33→    // Create sessions directory
    34→    sessionsDir = path.join(testDir, 'sessions');
    35→    await fs.mkdir(sessionsDir, { recursive: true });
    36→
    37→    // Session 1: with tool calls
    38→    const s1 = testUlid('SESS', 1);
    39→    const s1Dir = path.join(sessionsDir, s1);
    40→    await fs.mkdir(s1Dir);
    41→    await fs.writeFile(path.join(s1Dir, 'session.yaml'), YAML.stringify({
    42→      id: s1,
    43→      agent_type: 'claude-agent-acp',
    44→      status: 'completed',
    45→      started_at: '2026-01-20T10:00:00.000Z',
    46→      ended_at: '2026-01-20T11:00:00.000Z',
    47→    }));
    48→    await fs.writeFile(path.join(s1Dir, 'events.jsonl'), [
    49→      JSON.stringify({
    50→        ts: 1000,
    51→        seq: 0,
    52→        type: 'session.start',
    53→        session_id: s1,
    54→        data: { message: 'Starting session' },
    55→      }),
    56→      JSON.stringify({
    57→        ts: 2000,
    58→        seq: 1,
    59→        type: 'session.update',
    60→        session_id: s1,
    61→        data: {
    62→          update: {
    63→            sessionUpdate: 'tool_call',
    64→            rawInput: { command: 'npm run build' },
    65→          },
    66→        },
    67→      }),
    68→      JSON.stringify({
    69→        ts: 3000,
    70→        seq: 2,
    71→        type: 'prompt.sent',
    72→        session_id: s1,
    73→        data: { prompt: 'Tell me about ERROR handling' },
    74→      }),
    75→      JSON.stringify({
    76→        ts: 4000,
    77→        seq: 3,
    78→        type: 'session.end',
    79→        session_id: s1,
    80→        data: { reason: 'completed successfully' },
    81→      }),
    82→    ].join('\n') + '\n');
    83→
    84→    // Session 2: different agent, more recent
    85→    const s2 = testUlid('SESS', 2);
    86→    const s2Dir = path.join(sessionsDir, s2);
    87→    await fs.mkdir(s2Dir);
    88→    await fs.writeFile(path.join(s2Dir, 'session.yaml'), YAML.stringify({
    89→      id: s2,
    90→      agent_type: 'custom-agent',
    91→      status: 'active',
    92→      started_at: '2026-02-01T08:00:00.000Z',
    93→    }));
    94→    await fs.writeFile(path.join(s2Dir, 'events.jsonl'), [
    95→      JSON.stringify({
    96→        ts: 5000,
    97→        seq: 0,
    98→        type: 'session.start',
    99→        session_id: s2,
   100→        data: { message: 'Custom session start' },
   101→      }),
   102→      JSON.stringify({
   103→        ts: 6000,
   104→        seq: 1,
   105→        type: 'session.update',
   106→        session_id: s2,
   107→        data: {
   108→          update: {
   109→            sessionUpdate: 'tool_call',
   110→            rawInput: { command: 'kspec task complete @my-task --reason "Fixed ERROR in build"' },
   111→          },
   112→        },
   113→      }),
   114→    ].join('\n') + '\n');
   115→
   116→    // Session 3: no matches for common patterns
   117→    const s3 = testUlid('SESS', 3);
   118→    const s3Dir = path.join(sessionsDir, s3);
   119→    await fs.mkdir(s3Dir);
   120→    await fs.writeFile(path.join(s3Dir, 'session.yaml'), YAML.stringify({
   121→      id: s3,
   122→      agent_type: 'claude-agent-acp',
   123→      status: 'completed',
   124→      started_at: '2026-02-02T10:00:00.000Z',
   125→      ended_at: '2026-02-02T11:00:00.000Z',
   126→    }));
   127→    await fs.writeFile(path.join(s3Dir, 'events.jsonl'), [
   128→      JSON.stringify({
   129→        ts: 7000,
   130→        seq: 0,
   131→        type: 'session.start',
   132→        session_id: s3,
   133→        data: { message: 'Clean session' },
   134→      }),
   135→      JSON.stringify({
   136→        ts: 8000,
   137→        seq: 1,
   138→        type: 'session.end',
   139→        session_id: s3,
   140→        data: { reason: 'done' },
   141→      }),
   142→    ].join('\n') + '\n');
   143→
   144→    // Session 4: externalized blob pointer payload
   145→    const s4 = testUlid('SESS', 4);
   146→    const s4Dir = path.join(sessionsDir, s4);
   147→    await fs.mkdir(s4Dir);
   148→    await fs.mkdir(path.join(s4Dir, 'blobs'));
   149→    await fs.writeFile(path.join(s4Dir, 'session.yaml'), YAML.stringify({
   150→      id: s4,
   151→      agent_type: 'claude-agent-acp',
   152→      status: 'completed',
   153→      started_at: '2026-02-03T10:00:00.000Z',
   154→      ended_at: '2026-02-03T10:30:00.000Z',
   155→    }));
   156→    await fs.writeFile(
   157→      path.join(s4Dir, 'blobs', 'search-pointer.blob'),
   158→      'RESOLVED_ONLY_BLOB_TOKEN',
   159→    );
   160→    await fs.writeFile(path.join(s4Dir, 'events.jsonl'), [
   161→      JSON.stringify({
   162→        ts: 9000,
   163→        seq: 0,
   164→        type: 'tool.result',
   165→        session_id: s4,
   166→        data: {
   167→          output: {
   168→            path: 'blobs/search-pointer.blob',
   169→            bytes: 24,
   170→            sha256: 'test-hash',
   171→            truncated: true,
   172→            preview: 'PREVIEW_ONLY_BLOB_TOKEN',
   173→          },
   174→        },
   175→      }),
   176→    ].join('\n') + '\n');
   177→  });
   178→
   179→  afterEach(async () => {
   180→    await fs.rm(testDir, { recursive: true });
   181→  });
   182→
   183→  // AC: @session-log-search ac-1
   184→  it('should search event data for case-insensitive substring match', async () => {
   185→    const results = await searchSessionEvents(sessionsDir, 'error');
   186→    expect(results.length).toBeGreaterThan(0);
   187→
   188→    // Should find matches in both sessions that have "error" (case-insensitive)
   189→    let totalMatches = 0;
   190→    for (const r of results) {
   191→      totalMatches += r.matches.length;
   192→    }
   193→    expect(totalMatches).toBe(2); // One in session 1, one in session 2
   194→  });
   195→
   196→  // AC: @session-log-search ac-1
   197→  it('should return results grouped by session', async () => {
   198→    const results = await searchSessionEvents(sessionsDir, 'session');
   199→    expect(results.length).toBeGreaterThan(0);
   200→
   201→    for (const result of results) {
   202→      expect(result).toHaveProperty('session_id');
   203→      expect(result).toHaveProperty('agent_type');
   204→      expect(result).toHaveProperty('started_at');
   205→      expect(result).toHaveProperty('matches');
   206→      expect(Array.isArray(result.matches)).toBe(true);
   207→    }
   208→  });
   209→
   210→  // AC: @session-log-search ac-2
   211→  it('should filter by event type when --type is provided', async () => {
   212→    const results = await searchSessionEvents(sessionsDir, 'session', {
   213→      eventType: 'session.start',
   214→    });
   215→
   216→    // All matches should be session.start events
   217→    for (const result of results) {
   218→      for (const match of result.matches) {
   219→        expect(match.event_type).toBe('session.start');
   220→      }
   221→    }
   222→  });
   223→
   224→  // AC: @session-log-search ac-3
   225→  it('should filter by since date', async () => {
   226→    const sinceDate = new Date('2026-02-01');
   227→    const results = await searchSessionEvents(sessionsDir, 'session', {
   228→      sinceDate,
   229→    });
   230→
   231→    // Only sessions 2 and 3 are after Feb 1
   232→    for (const result of results) {
   233→      expect(new Date(result.started_at).getTime()).toBeGreaterThanOrEqual(sinceDate.getTime());
   234→    }
   235→  });
   236→
   237→  // AC: @session-log-search ac-4
   238→  it('should return matches with session ID, timestamp, type, and excerpt', async () => {
   239→    const results = await searchSessionEvents(sessionsDir, 'build');
   240→    expect(results.length).toBeGreaterThan(0);
   241→
   242→    const match = results[0].matches[0];
   243→    expect(match).toHaveProperty('session_id');
   244→    expect(match).toHaveProperty('timestamp');
   245→    expect(typeof match.timestamp).toBe('number');
   246→    expect(match).toHaveProperty('event_type');
   247→    expect(match).toHaveProperty('content_excerpt');
   248→    expect(typeof match.content_excerpt).toBe('string');
   249→  });
   250→
   251→  // AC: @session-log-search ac-4
   252→  it('should limit content excerpt to 200 characters', async () => {
   253→    const results = await searchSessionEvents(sessionsDir, 'build');
   254→    for (const result of results) {
   255→      for (const match of result.matches) {
   256→        expect(match.content_excerpt.length).toBeLessThanOrEqual(200);
   257→      }
   258→    }
   259→  });
   260→
   261→  // AC: @session-log-search ac-5
   262→  it('should respect limit option', async () => {
   263→    const results = await searchSessionEvents(sessionsDir, 'session', { limit: 2 });
   264→
   265→    let totalMatches = 0;
   266→    for (const r of results) {
   267→      totalMatches += r.matches.length;
   268→    }
   269→    expect(totalMatches).toBeLessThanOrEqual(2);
   270→  });
   271→
   272→  // AC: @session-log-search ac-6
   273→  it('should return empty array when no matches found', async () => {
   274→    const results = await searchSessionEvents(sessionsDir, 'xyznonexistent');
   275→    expect(results).toEqual([]);
   276→  });
   277→
   278→  // AC: @session-log-search ac-7
   279→  it('should filter by agent type', async () => {
   280→    const results = await searchSessionEvents(sessionsDir, 'session', {
   281→      agentType: 'custom-agent',
   282→    });
   283→
   284→    for (const result of results) {
   285→      expect(result.agent_type).toBe('custom-agent');
   286→    }
   287→  });
   288→
   289→  // Defense-in-depth: store normalizes invalid limits
   290→  it('should fallback to default limit when given invalid limit', async () => {
   291→    // NaN should be normalized to 50
   292→    const results1 = await searchSessionEvents(sessionsDir, 'session', { limit: NaN });
   293→    expect(results1.length).toBeGreaterThan(0);
   294→
   295→    // 0 should be normalized to 50
   296→    const results2 = await searchSessionEvents(sessionsDir, 'session', { limit: 0 });
   297→    expect(results2.length).toBeGreaterThan(0);
   298→
   299→    // Negative should be normalized to 50
   300→    const results3 = await searchSessionEvents(sessionsDir, 'session', { limit: -5 });
   301→    expect(results3.length).toBeGreaterThan(0);
   302→  });
   303→
   304→  it('should combine multiple filters', async () => {
   305→    const results = await searchSessionEvents(sessionsDir, 'error', {
   306→      agentType: 'custom-agent',
   307→      sinceDate: new Date('2026-01-01'),
   308→    });
   309→
   310→    expect(results.length).toBe(1);
   311→    expect(results[0].agent_type).toBe('custom-agent');
   312→  });
   313→
   314→  it('should search pointer previews by default', async () => {
   315→    const results = await searchSessionEvents(sessionsDir, 'preview_only_blob_token');
   316→    expect(results.length).toBe(1);
   317→    expect(results[0].matches[0].content_excerpt).toContain('PREVIEW_ONLY_BLOB_TOKEN');
   318→  });
   319→
   320→  it('should resolve blob content when resolveBlobs is enabled', async () => {
   321→    const noResolve = await searchSessionEvents(sessionsDir, 'resolved_only_blob_token');
   322→    expect(noResolve).toEqual([]);
   323→
   324→    const resolved = await searchSessionEvents(sessionsDir, 'resolved_only_blob_token', {
   325→      resolveBlobs: true,
   326→    });
   327→    expect(resolved.length).toBe(1);
   328→    expect(resolved[0].matches[0].content_excerpt).toContain('RESOLVED_ONLY_BLOB_TOKEN');
   329→  });
   330→});
