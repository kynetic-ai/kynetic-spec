   541→  // AC: @session-log-search ac-4
   542→  it('should show session ID, timestamp, type, and excerpt in each match', () => {
   543→    const results = kspecJson<SessionSearchResult[]>('session log search build', tempDir);
   544→    expect(results.length).toBeGreaterThan(0);
   545→
   546→    const match = results[0].matches[0];
