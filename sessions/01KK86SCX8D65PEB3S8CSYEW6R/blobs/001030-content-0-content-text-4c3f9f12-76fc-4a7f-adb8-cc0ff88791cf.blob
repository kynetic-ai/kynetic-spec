   446→    const s4Dir = path.join(sessionsDir, s4);
   447→    await fs.mkdir(s4Dir);
   448→    await fs.mkdir(path.join(s4Dir, 'blobs'));
   449→    await fs.writeFile(path.join(s4Dir, 'session.yaml'), YAML.stringify({
