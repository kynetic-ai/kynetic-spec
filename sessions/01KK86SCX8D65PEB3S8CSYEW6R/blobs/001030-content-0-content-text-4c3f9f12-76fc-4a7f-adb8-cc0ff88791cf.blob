   382→    ].join('\n') + '\n');
   383→
   384→    // Session 2: different agent, recent
   385→    const s2 = testUlid('SESS', 2);
   386→    const s2Dir = path.join(sessionsDir, s2);
   387→    await fs.mkdir(s2Dir);
   388→    await fs.writeFile(path.join(s2Dir, 'session.yaml'), YAML.stringify({
   389→      id: s2,
   390→      agent_type: 'custom-agent',
