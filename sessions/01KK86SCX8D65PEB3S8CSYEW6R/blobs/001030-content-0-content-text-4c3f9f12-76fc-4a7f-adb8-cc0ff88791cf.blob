   394→    await fs.writeFile(path.join(s2Dir, 'events.jsonl'), [
   395→      JSON.stringify({
   396→        ts: 4000,
   397→        seq: 0,
   398→        type: 'session.start',
   399→        session_id: s2,
   400→        data: { message: 'Custom build agent session' },
   401→      }),
   402→      JSON.stringify({
   403→        ts: 5000,
   404→        seq: 1,
   405→        type: 'session.update',
   406→        session_id: s2,
   407→        data: {
   408→          update: {
   409→            sessionUpdate: 'tool_call',
   410→            rawInput: { command: 'kspec task complete @build-task --reason "Build successful"' },
   411→          },
   412→        },
   413→      }),
   414→    ].join('\n') + '\n');
   415→
   416→    // Session 3: no matches for common patterns
   417→    const s3 = testUlid('SESS', 3);
   418→    const s3Dir = path.join(sessionsDir, s3);
   419→    await fs.mkdir(s3Dir);
   420→    await fs.writeFile(path.join(s3Dir, 'session.yaml'), YAML.stringify({
   421→      id: s3,
   422→      agent_type: 'claude-agent-acp',
   423→      status: 'completed',
   424→      started_at: '2026-02-04T14:00:00.000Z',
