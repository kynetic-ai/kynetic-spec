   562→
   563→  // AC: @session-log-search ac-5
   564→  it('should respect --limit flag', () => {
   565→    const results = kspecJson<SessionSearchResult[]>(
   566→      'session log search session -n 1',
   567→      tempDir,
   568→    );
   569→
   570→    let totalMatches = 0;
   571→    for (const r of results) {
   572→      totalMatches += r.matches.length;
