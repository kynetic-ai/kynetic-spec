   332→// ─── CLI Integration Tests ──────────────────────────────────────────────────
   333→
   334→describe('kspec session log search (CLI)', () => {
   335→  let tempDir: string;
   336→
   337→  beforeEach(async () => {
   338→    tempDir = await setupTempFixtures();
   339→
   340→    // Create sessions directory for test data
   341→    const sessionsDir = path.join(tempDir, 'sessions');
   342→    await fs.mkdir(sessionsDir, { recursive: true });
   343→
   344→    // Session 1: with tool calls containing searchable content
   345→    const s1 = testUlid('SESS', 1);
   346→    const s1Dir = path.join(sessionsDir, s1);
   347→    await fs.mkdir(s1Dir);
   348→    await fs.writeFile(path.join(s1Dir, 'session.yaml'), YAML.stringify({
   349→      id: s1,
   350→      agent_type: 'claude-agent-acp',
   351→      status: 'completed',
   352→      started_at: '2026-01-15T10:00:00.000Z',
   353→      ended_at: '2026-01-15T11:30:00.000Z',
   354→    }));
   355→    await fs.writeFile(path.join(s1Dir, 'events.jsonl'), [
   356→      JSON.stringify({
   357→        ts: 1000,
   358→        seq: 0,
   359→        type: 'session.start',
   360→        session_id: s1,
   361→        data: { message: 'Starting automated build process' },
   362→      }),
   363→      JSON.stringify({
   364→        ts: 2000,
   365→        seq: 1,
