   712→describe('deduplicatePhasedToolCalls', () => {
   713→  it('should remove empty-input duplicates when populated version exists', () => {
   714→    const events = [
   715→      // tool_call with empty rawInput
   716→      { ts: 1000, seq: 0, type: 'session.update' as const, session_id: 'sess1', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_001', rawInput: {}, _meta: { claudeCode: { toolName: 'Bash' } } } } },
   717→      // Same tool_call with populated rawInput
   718→      { ts: 1001, seq: 1, type: 'session.update' as const, session_id: 'sess1', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_001', rawInput: { command: 'npm test' }, _meta: { claudeCode: { toolName: 'Bash' } } } } },
   719→      // Different tool_call (should be kept)
   720→      { ts: 1002, seq: 2, type: 'session.update' as const, session_id: 'sess1', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_002', rawInput: { file_path: '/src/main.ts' }, _meta: { claudeCode: { toolName: 'Read' } } } } },
   721→      // Non tool_call event (should be kept)
   722→      { ts: 1003, seq: 3, type: 'session.update' as const, session_id: 'sess1', data: { update: { sessionUpdate: 'agent_thought' } } },
   723→    ];
   724→
   725→    const result = deduplicatePhasedToolCalls(events);
   726→    expect(result).toHaveLength(3);
   727→    // The populated version should be kept
   728→    expect((result[0].data as any).update.rawInput.command).toBe('npm test');
   729→    // Other events should be unchanged
   730→    expect((result[1].data as any).update.toolCallId).toBe('toolu_002');
   731→    expect((result[2].data as any).update.sessionUpdate).toBe('agent_thought');
   732→  });
   733→
   734→  it('should keep single tool_call events (no phased duplicate)', () => {
   735→    const events = [
   736→      { ts: 1000, seq: 0, type: 'session.update' as const, session_id: 'sess1', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_001', rawInput: { command: 'npm test' }, _meta: { claudeCode: { toolName: 'Bash' } } } } },
   737→    ];
   738→
   739→    const result = deduplicatePhasedToolCalls(events);
   740→    expect(result).toHaveLength(1);
   741→  });
   742→
   743→  it('should keep empty-input tool_call when no populated version exists', () => {
   744→    const events = [
   745→      { ts: 1000, seq: 0, type: 'session.update' as const, session_id: 'sess1', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_001', rawInput: {}, _meta: { claudeCode: { toolName: 'Bash' } } } } },
   746→    ];
   747→
   748→    const result = deduplicatePhasedToolCalls(events);
   749→    expect(result).toHaveLength(1);
   750→  });
   751→});
