    34→// ─── Store Unit Tests ───────────────────────────────────────────────────────
    35→
    36→describe('computeSessionLogStats', () => {
    37→  // AC: @session-log-stats ac-1
    38→  it('should compute totals correctly', () => {
    39→    const summaries: SessionLogSummary[] = [
    40→      {
    41→        id: 'session-1',
    42→        status: 'completed',
    43→        agent_type: 'claude-agent-acp',
    44→        started_at: '2026-01-20T10:00:00.000Z',
    45→        ended_at: '2026-01-20T11:00:00.000Z',
    46→        duration_ms: 3600000,
    47→        event_count: 100,
    48→        iteration_count: 3,
    49→        tasks_completed: 2,
    50→      },
    51→      {
    52→        id: 'session-2',
    53→        status: 'completed',
    54→        agent_type: 'claude-agent-acp',
    55→        started_at: '2026-01-21T10:00:00.000Z',
    56→        ended_at: '2026-01-21T12:00:00.000Z',
    57→        duration_ms: 7200000,
    58→        event_count: 200,
    59→        iteration_count: 5,
    60→        tasks_completed: 3,
    61→      },
    62→    ];
    63→
    64→    const stats = computeSessionLogStats(summaries);
    65→
    66→    expect(stats.total_sessions).toBe(2);
    67→    expect(stats.total_events).toBe(300);
    68→    expect(stats.total_iterations).toBe(8);
    69→    expect(stats.total_tasks_completed).toBe(5);
    70→    expect(stats.total_duration_ms).toBe(10800000);
    71→  });
    72→
    73→  // AC: @session-log-stats ac-2
    74→  it('should compute averages correctly', () => {
    75→    const summaries: SessionLogSummary[] = [
    76→      {
    77→        id: 'session-1',
    78→        status: 'completed',
    79→        agent_type: 'claude-agent-acp',
    80→        started_at: '2026-01-20T10:00:00.000Z',
    81→        ended_at: '2026-01-20T11:00:00.000Z',
    82→        duration_ms: 3600000, // 1 hour
    83→        event_count: 100,
    84→        iteration_count: 2,
    85→        tasks_completed: 4,
    86→      },
    87→      {
    88→        id: 'session-2',
    89→        status: 'completed',
    90→        agent_type: 'claude-agent-acp',
    91→        started_at: '2026-01-21T10:00:00.000Z',
    92→        ended_at: '2026-01-21T12:00:00.000Z',
    93→        duration_ms: 7200000, // 2 hours
    94→        event_count: 200,
    95→        iteration_count: 4,
    96→        tasks_completed: 6,
    97→      },
    98→    ];
    99→
   100→    const stats = computeSessionLogStats(summaries);
   101→
   102→    expect(stats.avg_duration_ms).toBe(5400000); // 1.5 hours
   103→    expect(stats.avg_iterations_per_session).toBe(3); // (2+4)/2
   104→    expect(stats.avg_tasks_per_session).toBe(5); // (4+6)/2
   105→  });
   106→
   107→  // AC: @session-log-stats ac-3
   108→  it('should compute status breakdown correctly', () => {
   109→    const summaries: SessionLogSummary[] = [
   110→      {
   111→        id: 'session-1',
   112→        status: 'completed',
   113→        agent_type: 'claude-agent-acp',
   114→        started_at: '2026-01-20T10:00:00.000Z',
   115→        ended_at: '2026-01-20T11:00:00.000Z',
   116→        duration_ms: 3600000,
   117→        event_count: 100,
   118→        iteration_count: 3,
   119→        tasks_completed: 2,
   120→      },
   121→      {
   122→        id: 'session-2',
   123→        status: 'completed',
   124→        agent_type: 'claude-agent-acp',
   125→        started_at: '2026-01-21T10:00:00.000Z',
   126→        ended_at: '2026-01-21T12:00:00.000Z',
   127→        duration_ms: 7200000,
   128→        event_count: 200,
   129→        iteration_count: 5,
   130→        tasks_completed: 3,
   131→      },
   132→      {
   133→        id: 'session-3',
   134→        status: 'active',
   135→        agent_type: 'claude-agent-acp',
   136→        started_at: '2026-01-22T10:00:00.000Z',
   137→        duration_ms: 1800000,
   138→        event_count: 50,
   139→        iteration_count: 1,
   140→        tasks_completed: 0,
   141→      },
   142→      {
   143→        id: 'session-4',
   144→        status: 'abandoned',
   145→        agent_type: 'claude-agent-acp',
   146→        started_at: '2026-01-19T10:00:00.000Z',
   147→        duration_ms: 600000,
   148→        event_count: 10,
   149→        iteration_count: 1,
   150→        tasks_completed: 0,
   151→      },
   152→    ];
   153→
   154→    const stats = computeSessionLogStats(summaries);
   155→
   156→    expect(stats.status_breakdown).toHaveLength(3);
   157→    const completed = stats.status_breakdown.find((s) => s.status === 'completed');
   158→    const active = stats.status_breakdown.find((s) => s.status === 'active');
   159→    const abandoned = stats.status_breakdown.find((s) => s.status === 'abandoned');
   160→
   161→    expect(completed).toEqual({ status: 'completed', count: 2, percentage: 50 });
   162→    expect(active).toEqual({ status: 'active', count: 1, percentage: 25 });
   163→    expect(abandoned).toEqual({ status: 'abandoned', count: 1, percentage: 25 });
   164→  });
   165→
   166→  it('should return empty stats for empty input', () => {
   167→    const stats = computeSessionLogStats([]);
   168→
   169→    expect(stats.total_sessions).toBe(0);
   170→    expect(stats.total_events).toBe(0);
   171→    expect(stats.avg_duration_ms).toBe(0);
   172→    expect(stats.status_breakdown).toEqual([]);
   173→  });
   174→});
   175→
   176→describe('computeToolUsageStats', () => {
   177→  let testDir: string;
   178→  let sessionsDir: string;
   179→
   180→  beforeEach(async () => {
   181→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-stats-'));
   182→    sessionsDir = path.join(testDir, 'sessions');
   183→  });
   184→
   185→  afterEach(async () => {
   186→    await fs.rm(testDir, { recursive: true });
   187→  });
   188→
   189→  // AC: @session-log-stats ac-6
   190→  it('should count tool calls and compute percentages', async () => {
   191→    const sessionId = testUlid('SESS');
   192→    await createSession(sessionsDir, {
   193→      id: sessionId,
   194→      agent_type: 'claude-agent-acp',
   195→    });
   196→
   197→    // Add tool call events
   198→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   199→    const events = [
   200→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Bash' } } } } },
   201→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Bash' } } } } },
   202→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Read' } } } } },
   203→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Edit' } } } } },
   204→    ].map((e, i) => JSON.stringify({ ts: Date.now(), seq: i, session_id: sessionId, ...e }));
   205→    await fs.writeFile(eventsPath, events.join('\n') + '\n');
   206→
   207→    const toolUsage = await computeToolUsageStats(sessionsDir, [sessionId]);
   208→
   209→    expect(toolUsage).toHaveLength(3);
   210→    expect(toolUsage[0]).toEqual({ tool_name: 'Bash', count: 2, percentage: 50 });
   211→    expect(toolUsage[1]).toEqual({ tool_name: 'Read', count: 1, percentage: 25 });
   212→    expect(toolUsage[2]).toEqual({ tool_name: 'Edit', count: 1, percentage: 25 });
   213→  });
   214→
   215→  it('should limit to top N tools', async () => {
   216→    const sessionId = testUlid('SESS', 1);
   217→    await createSession(sessionsDir, {
   218→      id: sessionId,
   219→      agent_type: 'test-agent',
   220→    });
   221→
   222→    // Add many different tools
   223→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   224→    const toolNames = ['Tool1', 'Tool2', 'Tool3', 'Tool4', 'Tool5', 'Tool6', 'Tool7', 'Tool8', 'Tool9', 'Tool10', 'Tool11', 'Tool12'];
   225→    const events = toolNames.map((name, i) =>
   226→      JSON.stringify({
   227→        ts: Date.now(),
   228→        seq: i,
   229→        type: 'session.update',
   230→        session_id: sessionId,
   231→        data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: name } } } },
   232→      })
   233→    );
   234→    await fs.writeFile(eventsPath, events.join('\n') + '\n');
   235→
   236→    // Default limit is 10
   237→    const toolUsage = await computeToolUsageStats(sessionsDir, [sessionId]);
   238→    expect(toolUsage).toHaveLength(10);
   239→
   240→    // Custom limit
   241→    const limited = await computeToolUsageStats(sessionsDir, [sessionId], 5);
   242→    expect(limited).toHaveLength(5);
   243→  });
   244→
   245→  it('should deduplicate phased tool_call events by toolCallId', async () => {
   246→    const sessionId = testUlid('SESS', 2);
   247→    await createSession(sessionsDir, {
   248→      id: sessionId,
   249→      agent_type: 'claude-agent-acp',
   250→    });
   251→
   252→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   253→    const events = [
   254→      // Phase 1: Bash tool_call with empty rawInput
   255→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_001', rawInput: {}, _meta: { claudeCode: { toolName: 'Bash' } } } } },
   256→      // Phase 2: Same Bash tool_call with populated rawInput (phased duplicate)
   257→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_001', rawInput: { command: 'npm test' }, _meta: { claudeCode: { toolName: 'Bash' } } } } },
   258→      // Different tool_call (not a duplicate)
   259→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_002', rawInput: { file_path: '/src/main.ts' }, _meta: { claudeCode: { toolName: 'Read' } } } } },
   260→      // Another Bash with no duplicate
   261→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', toolCallId: 'toolu_003', rawInput: { command: 'git status' }, _meta: { claudeCode: { toolName: 'Bash' } } } } },
   262→    ].map((e, i) => JSON.stringify({ ts: Date.now(), seq: i, session_id: sessionId, ...e }));
   263→    await fs.writeFile(eventsPath, events.join('\n') + '\n');
   264→
   265→    const toolUsage = await computeToolUsageStats(sessionsDir, [sessionId]);
   266→
   267→    // Should count 3 unique tool calls (not 4 with the phased duplicate)
   268→    const totalCount = toolUsage.reduce((sum, t) => sum + t.count, 0);
   269→    expect(totalCount).toBe(3);
   270→    expect(toolUsage.find(t => t.tool_name === 'Bash')?.count).toBe(2);
   271→    expect(toolUsage.find(t => t.tool_name === 'Read')?.count).toBe(1);
   272→  });
   273→});
   274→
   275→describe('computeTimePeriodStats', () => {
   276→  // AC: @session-log-stats ac-7
   277→  it('should group by day correctly', () => {
   278→    const summaries: SessionLogSummary[] = [
   279→      {
   280→        id: 'session-1',
   281→        status: 'completed',
   282→        agent_type: 'claude-agent-acp',
   283→        started_at: '2026-01-20T10:00:00.000Z',
   284→        duration_ms: 3600000,
   285→        event_count: 100,
   286→        iteration_count: 3,
   287→        tasks_completed: 2,
   288→      },
   289→      {
   290→        id: 'session-2',
   291→        status: 'completed',
   292→        agent_type: 'claude-agent-acp',
   293→        started_at: '2026-01-20T14:00:00.000Z',
   294→        duration_ms: 7200000,
   295→        event_count: 200,
   296→        iteration_count: 5,
   297→        tasks_completed: 3,
   298→      },
   299→      {
   300→        id: 'session-3',
   301→        status: 'completed',
   302→        agent_type: 'claude-agent-acp',
   303→        started_at: '2026-01-21T10:00:00.000Z',
   304→        duration_ms: 1800000,
   305→        event_count: 50,
   306→        iteration_count: 1,
   307→        tasks_completed: 1,
   308→      },
   309→    ];
   310→
   311→    const periods = computeTimePeriodStats(summaries, 'day');
   312→
   313→    expect(periods).toHaveLength(2);
   314→    // Sorted newest first
   315→    expect(periods[0].period).toBe('2026-01-21');
   316→    expect(periods[0].sessions_count).toBe(1);
   317→    expect(periods[0].tasks_completed).toBe(1);
   318→    expect(periods[0].total_duration_ms).toBe(1800000);
   319→
   320→    expect(periods[1].period).toBe('2026-01-20');
   321→    expect(periods[1].sessions_count).toBe(2);
   322→    expect(periods[1].tasks_completed).toBe(5); // 2 + 3
   323→    expect(periods[1].total_duration_ms).toBe(10800000); // 3600000 + 7200000
   324→  });
   325→
   326→  it('should group by week correctly', () => {
   327→    const summaries: SessionLogSummary[] = [
   328→      {
   329→        id: 'session-1',
   330→        status: 'completed',
   331→        agent_type: 'claude-agent-acp',
   332→        started_at: '2026-01-20T10:00:00.000Z', // 2026-01-20 is a Tuesday in week 4
   333→        duration_ms: 3600000,
   334→        event_count: 100,
   335→        iteration_count: 3,
   336→        tasks_completed: 2,
   337→      },
   338→      {
   339→        id: 'session-2',
   340→        status: 'completed',
   341→        agent_type: 'claude-agent-acp',
   342→        started_at: '2026-01-27T10:00:00.000Z', // 2026-01-27 is a Tuesday in week 5
   343→        duration_ms: 7200000,
   344→        event_count: 200,
   345→        iteration_count: 5,
   346→        tasks_completed: 3,
   347→      },
   348→    ];
   349→
   350→    const periods = computeTimePeriodStats(summaries, 'week');
   351→
   352→    expect(periods).toHaveLength(2);
   353→    // Should have week numbers in format YYYY-Www
   354→    for (const p of periods) {
   355→      expect(p.period).toMatch(/^\d{4}-W\d{2}$/);
   356→    }
   357→    // Verify concrete week assignments
   358→    expect(periods[0].period).toBe('2026-W05');
   359→    expect(periods[1].period).toBe('2026-W04');
   360→  });
   361→
   362→  it('should handle year boundary week correctly (ISO-8601)', () => {
   363→    // Test ISO-8601 week rules at year boundaries:
   364→    // - 2025-12-29 (Monday) to 2026-01-04 (Sunday) is Week 1 of 2026
   365→    // - 2025-12-28 (Sunday) is Week 52 of 2025
   366→    const summaries: SessionLogSummary[] = [
   367→      {
   368→        id: 'session-1',
   369→        status: 'completed',
   370→        agent_type: 'claude-agent-acp',
   371→        started_at: '2025-12-28T10:00:00.000Z', // Sunday - still week 52 of 2025
   372→        duration_ms: 1000,
   373→        event_count: 1,
   374→        iteration_count: 1,
   375→        tasks_completed: 0,
   376→      },
   377→      {
   378→        id: 'session-2',
   379→        status: 'completed',
   380→        agent_type: 'claude-agent-acp',
   381→        started_at: '2025-12-29T00:00:00.000Z', // Monday - week 1 of 2026 per ISO-8601
   382→        duration_ms: 1000,
   383→        event_count: 1,
   384→        iteration_count: 1,
   385→        tasks_completed: 0,
   386→      },
   387→      {
   388→        id: 'session-3',
   389→        status: 'completed',
   390→        agent_type: 'claude-agent-acp',
   391→        started_at: '2026-01-01T00:00:00.000Z', // Thursday - still week 1 of 2026
   392→        duration_ms: 1000,
   393→        event_count: 1,
   394→        iteration_count: 1,
   395→        tasks_completed: 0,
   396→      },
   397→      {
   398→        id: 'session-4',
   399→        status: 'completed',
   400→        agent_type: 'claude-agent-acp',
   401→        started_at: '2026-01-05T00:00:00.000Z', // Monday - week 2 of 2026
   402→        duration_ms: 1000,
   403→        event_count: 1,
   404→        iteration_count: 1,
   405→        tasks_completed: 0,
   406→      },
   407→    ];
   408→
   409→    const periods = computeTimePeriodStats(summaries, 'week');
   410→
   411→    // Should have 3 distinct weeks: 2025-W52, 2026-W01, 2026-W02
   412→    expect(periods).toHaveLength(3);
   413→    const periodSet = new Set(periods.map((p) => p.period));
   414→    expect(periodSet.has('2025-W52')).toBe(true);
   415→    expect(periodSet.has('2026-W01')).toBe(true);
   416→    expect(periodSet.has('2026-W02')).toBe(true);
   417→
   418→    // Verify session counts per week
   419→    const week52 = periods.find((p) => p.period === '2025-W52');
   420→    const week01 = periods.find((p) => p.period === '2026-W01');
   421→    const week02 = periods.find((p) => p.period === '2026-W02');
   422→    expect(week52?.sessions_count).toBe(1);
   423→    expect(week01?.sessions_count).toBe(2); // Dec 29 and Jan 1
   424→    expect(week02?.sessions_count).toBe(1);
   425→  });
   426→});
