   428→// ─── CLI Integration Tests ──────────────────────────────────────────────────
   429→
   430→describe('kspec session log stats (CLI)', () => {
   431→  let tempDir: string;
   432→
   433→  beforeEach(async () => {
   434→    tempDir = await setupTempFixtures();
   435→
   436→    // Create sessions directory
   437→    const sessionsDir = path.join(tempDir, 'sessions');
   438→    await fs.mkdir(sessionsDir, { recursive: true });
   439→
   440→    // Session 1: completed, 2026-01-15
   441→    const s1 = testUlid('SESS', 1);
   442→    const s1Dir = path.join(sessionsDir, s1);
   443→    await fs.mkdir(s1Dir);
   444→    await fs.writeFile(path.join(s1Dir, 'session.yaml'), YAML.stringify({
   445→      id: s1,
   446→      agent_type: 'claude-agent-acp',
   447→      status: 'completed',
   448→      started_at: '2026-01-15T10:00:00.000Z',
   449→      ended_at: '2026-01-15T11:30:00.000Z',
   450→    }));
   451→    await fs.writeFile(path.join(s1Dir, 'events.jsonl'), [
   452→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s1, data: null }),
   453→      JSON.stringify({ ts: 2000, seq: 1, type: 'session.update', session_id: s1, data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Bash' } } } } }),
   454→      JSON.stringify({ ts: 3000, seq: 2, type: 'session.end', session_id: s1, data: null }),
   455→    ].join('\n') + '\n');
   456→    await fs.writeFile(path.join(s1Dir, 'context-iter-1.json'), '{}');
   457→
   458→    // Session 2: active, 2026-02-05
   459→    const s2 = testUlid('SESS', 2);
   460→    const s2Dir = path.join(sessionsDir, s2);
   461→    await fs.mkdir(s2Dir);
   462→    await fs.writeFile(path.join(s2Dir, 'session.yaml'), YAML.stringify({
   463→      id: s2,
   464→      agent_type: 'custom-agent',
   465→      status: 'active',
   466→      started_at: '2026-02-05T08:00:00.000Z',
   467→    }));
   468→    await fs.writeFile(path.join(s2Dir, 'events.jsonl'), [
   469→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s2, data: null }),
   470→      JSON.stringify({ ts: 2000, seq: 1, type: 'session.update', session_id: s2, data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Read' } } } } }),
   471→      JSON.stringify({ ts: 3000, seq: 2, type: 'session.update', session_id: s2, data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Read' } } } } }),
   472→      JSON.stringify({ ts: 4000, seq: 3, type: 'session.update', session_id: s2, data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Edit' } } } } }),
   473→      JSON.stringify({ ts: 5000, seq: 4, type: 'prompt.sent', session_id: s2, data: null }),
   474→    ].join('\n') + '\n');
   475→    await fs.writeFile(path.join(s2Dir, 'context-iter-1.json'), '{}');
   476→    await fs.writeFile(path.join(s2Dir, 'context-iter-2.json'), '{}');
   477→    await fs.writeFile(path.join(s2Dir, 'context-iter-3.json'), '{}');
   478→
   479→    // Session 3: completed, 2026-02-04 with task completion
   480→    const s3 = testUlid('SESS', 3);
   481→    const s3Dir = path.join(sessionsDir, s3);
   482→    await fs.mkdir(s3Dir);
   483→    await fs.writeFile(path.join(s3Dir, 'session.yaml'), YAML.stringify({
   484→      id: s3,
   485→      agent_type: 'claude-agent-acp',
   486→      status: 'completed',
   487→      started_at: '2026-02-04T14:00:00.000Z',
   488→      ended_at: '2026-02-04T15:00:00.000Z',
   489→    }));
   490→    await fs.writeFile(path.join(s3Dir, 'events.jsonl'), [
