### 2. **Fixture Setup Architecture**

**Location:** `/home/chapel/Projects/kynetic-spec-ui/packages/web-ui/tests/fixtures/`

**Core Fixture File:** `test-base.ts`

```typescript
import { test as base, expect } from '@playwright/test';
import { execSync, spawnSync } from 'child_process';
import { mkdirSync, cpSync, rmSync, existsSync, writeFileSync } from 'fs';

export const test = base.extend<{ daemon: DaemonFixture }>({
  baseURL: async ({ daemon }, use) => {
    await use(daemon.baseUrl);
  },

  daemon: [async ({}, use) => {
    // Ephemeral port allocation (never hardcoded)
    const port = await getAvailablePort();
    const baseUrl = `http://localhost:${port}`;
    const wsUrl = `ws://localhost:${port}`;

    // Create isolated temp directory with full .kspec structure
    const tempDir = join(tmpdir(), 'kspec-e2e-' + Date.now());
    const kspecDir = join(tempDir, '.kspec');
    mkdirSync(kspecDir, { recursive: true });

    // Isolated HOME/config directory
    const isolatedHome = join(tempDir, '.home');
    const configDir = join(isolatedHome, '.config', 'kspec');
    mkdirSync(configDir, { recursive: true });

    // Copy E2E test fixtures to .kspec subdirectory
    cpSync(E2E_FIXTURES, kspecDir, {
      recursive: true,
      filter: (src) => !src.includes('test-base') && !src.includes('project-tests')
    });

    // Initialize git repo (required for kspec)
    execSync('git init', { cwd: tempDir, stdio: 'ignore' });
    execSync('git config user.email "test@test.com"', { cwd: tempDir });
    execSync('git config user.name "Test"', { cwd: tempDir });

    // Set up shadow worktree simulation
    const gitWorktreesDir = join(tempDir, '.git', 'worktrees', '-kspec');
    mkdirSync(gitWorktreesDir, { recursive: true });
    writeFileSync(join(kspecDir, '.git'), `gitdir: ${gitWorktreesDir}\n`);
    writeFileSync(join(gitWorktreesDir, 'gitdir'), `${join(tempDir, '.git')}\n`);
    writeFileSync(join(gitWorktreesDir, 'HEAD'), 'ref: refs/heads/kspec-meta\n');

    // Start daemon on ephemeral port
    const startResult = spawnSync(
      'kspec',
      ['serve', 'start', '--daemon', '--port', String(port), '--kspec-dir', tempDir],
      { cwd: tempDir, encoding: 'utf-8', env: isolatedEnv }
    );

    // Poll health endpoint until daemon ready
    const maxAttempts = 30;
    for (let i = 0; i < maxAttempts; i++) {
      try {
        const response = await fetch(`${baseUrl}/api/health`);
        if (response.ok) break;
      } catch {}
      await new Promise((r) => setTimeout(r, 100));
    }

    // Propagate daemon config to all tests
    await use({ tempDir, kspecDir, port, baseUrl, wsUrl, createSecondProject });

    // Cleanup: graceful daemon stop
    spawnSync('kspec', ['serve', 'stop', '--kspec-dir', tempDir], {
      cwd: tempDir, encoding: 'utf-8', env: isolatedEnv
    });
    
    rmSync(tempDir, { recursive: true, force: true });
  }, { scope: 'test' }],
});

export { expect };
```

**Fixture Data Files:**

- `kynetic.yaml` — Project manifest with references to modules
- `kynetic.meta.yaml` — Session focus, observations, agent definitions, workflows
- `project.tasks.yaml` — 5 test tasks (ready, blocked, in_progress, pending_review, completed)
- `project.inbox.yaml` — Inbox items
- `modules/core.yaml` — Test feature, trait, requirement specs

### 3. **Playwright Configuration**

**File:** `/home/chapel/Projects/kynetic-spec-ui/packages/web-ui/playwright.config.ts`

```typescript
export default defineConfig({
  testDir: './tests/e2e',
  fullyParallel: false,           // Sequential — each test gets its own ephemeral-port daemon
  forbidOnly: !!process.env.CI,
  retries: process.env.CI ? 2 : 0,
  workers: 1,                      // One worker at a time for port isolation
  reporter: process.env.CI ? 'github' : 'html',
  timeout: 30_000,

  expect: {
    timeout: 10_000,
  },

  use: {
    // No baseURL — daemon fixture provides it
    trace: 'on-first-retry',       // Traces on retry for debugging
    screenshot: 'only-on-failure',  // Save screenshots on failure
    video: 'retain-on-failure',     // Save video on failure
    actionTimeout: 10_000,
  },

  projects: [
    {
      name: 'chromium',
      use: { ...devices['Desktop Chrome'] },
    },
  ],

  outputDir: 'test-results',
});
```

### 4. **Test Pattern Examples**

#### A. **Basic Navigation Test (from `dashboard.spec.ts`)**

```typescript
import { test, expect } from '../fixtures/test-base';

test.describe('Dashboard View', () => {
  test.describe('Task Overview (AC-1)', () => {
    // AC: @web-dashboard ac-1
    test('displays task counts container', async ({ page, daemon }) => {
      await page.goto('/');

      const countsContainer = page.getByTestId('dashboard-counts');
      await expect(countsContainer).toBeVisible();
    });

    // AC: @web-dashboard ac-1
    test('shows correct count values from fixtures', async ({ page, daemon }) => {
      await page.goto('/');

      // Wait for counts to load (no longer shows "...")
      await expect(page.getByTestId('task-count-ready')).not.toContainText('...');

      // Verify counts match fixture data
      const readyCount = page.getByTestId('task-count-ready');
      await expect(readyCount).toContainText('1');

      const inProgressCount = page.getByTestId('task-count-in_progress');
      await expect(inProgressCount).toContainText('1');
    });
  });

  test.describe('Count Navigation (AC-3)', () => {
    // AC: @web-dashboard ac-3
    test('clicking ready count navigates to pending tasks', async ({ page, daemon }) => {
      await page.goto('/');

      await expect(page.getByTestId('task-count-ready')).not.toContainText('...');

      const readyBadge = page.getByTestId('task-count-ready');
      await readyBadge.click();

      // URL-based assertion
      await page.waitForURL(/\/tasks\?status=pending/);
      expect(page.url()).toContain('/tasks');
      expect(page.url()).toContain('status=pending');
    });
  });
});
```

#### B. **API Mocking Pattern (from `sessions.spec.ts`)**

```typescript
test.describe('Session History View', () => {
  test.describe('Session List (AC-1)', () => {
    // AC: @ui-session-history ac-1
    test('shows session list with required metadata fields', async ({ page, daemon }) => {
      // Mock the API response
      await page.route('**/api/sessions', (route) => {
        route.fulfill({
          status: 200,
          contentType: 'application/json',
          body: JSON.stringify(mockSessions()),
        });
      });

      await page.goto('/sessions');

      const list = page.getByTestId('sessions-list');
      await expect(list).toBeVisible();

      const rows = page.getByTestId('session-row');
      await expect(rows).toHaveCount(3);
    });

    // AC: @ui-session-history ac-1 — Sorted by most recent first
    test('sessions are sorted by most recent first', async ({ page, daemon }) => {
      const sorted = mockSessions();
      sorted.items = [sorted.items[1], sorted.items[0], sorted.items[2]];

      await page.route('**/api/sessions', (route) => {
        route.fulfill({
          status: 200,
          contentType: 'application/json',
          body: JSON.stringify(sorted),
        });
      });

      await page.goto('/sessions');
      await expect(page.getByTestId('sessions-list')).toBeVisible();

      const rows = page.getByTestId('session-row');
      await expect(rows.nth(0)).toHaveAttribute('data-session-id', '01JTEST0000000000000000002');
      await expect(rows.nth(1)).toHaveAttribute('data-session-id', '01JTEST0000000000000000001');
    });
  });

  test.describe('Navigation (AC-2)', () => {
    // AC: @ui-session-history ac-2
    test('clicking a session navigates to /sessions/:id', async ({ page, daemon }) => {
      // Register routes from least-specific to most-specific
      await page.route('**/api/sessions', (route) => {
        route.fulfill({
          status: 200,
          contentType: 'application/json',
          body: JSON.stringify(mockSessions()),
        });
      });

      await page.route('**/api/sessions/01JTEST0000000000000000001', (route) => {
        route.fulfill({
          status: 200,
          contentType: 'application/json',
          body: JSON.stringify(mockSessions().items[0]),
        });
      });

      await page.route('**/api/sessions/01JTEST0000000000000000001/events', (route) => {
        route.fulfill({
          status: 200,
          contentType: 'application/json',
          body: JSON.stringify({ events: [], total: 0 }),
        });
      });

      await page.goto('/sessions');
      await expect(page.getByTestId('sessions-list')).toBeVisible();

      const firstRow = page.getByTestId('session-row').first();
      await firstRow.click();

      // Verify navigation
      await expect(page).toHaveURL(/\/sessions\/01JTEST0000000000000000001/);
      await expect(page.getByTestId('session-stream')).toBeVisible({ timeout: 5000 });
    });
  });

  test.describe('Empty State', () => {
    test('shows empty state when no sessions exist', async ({ page, daemon }) => {
      await page.route('**/api/sessions', (route) => {
        route.fulfill({
          status: 200,
          contentType: 'application/json',
          body: JSON.stringify({ items: [], total: 0 }),
        });
      });

      await page.goto('/sessions');

      const emptyState = page.getByTestId('sessions-empty');
      await expect(emptyState).toBeVisible();
      await expect(emptyState).toContainText('No sessions yet');
    });
  });

  test.describe('Loading State', () => {
    test('shows loading skeleton while fetching', async ({ page, daemon }) => {
      await page.route('**/api/sessions', async (route) => {
        await new Promise((r) => setTimeout(r, 500));  // Delay to make loading visible
        route.fulfill({
          status: 200,
          contentType: 'application/json',
          body: JSON.stringify(mockSessions()),
        });
      });

      await page.goto('/sessions');

      const skeleton = page.getByTestId('sessions-loading');
      await expect(skeleton).toBeVisible();

      await expect(page.getByTestId('sessions-list')).toBeVisible({ timeout: 5000 });
    });
  });

  test.describe('Error State', () => {
    test('shows error message on API failure', async ({ page, daemon }) => {
      await page.route('**/api/sessions', (route) => {
        route.fulfill({
          status: 500,
          contentType: 'application/json',
          body: JSON.stringify({ error: 'internal_error', message: 'Daemon unavailable' }),
        });
      });

      await page.goto('/sessions');

      const errorMessage = page.getByTestId('sessions-error');
      await expect(errorMessage).toBeVisible();
    });
  });
});
```

#### C. **Agent/Dispatch Test Pattern (from `agents.spec.ts`)**

```typescript
const DAEMON_URL = 'http://localhost:3456';  // NOTE: Tests use daemon.baseUrl from fixture

test.describe('Agent and Dispatch View', () => {
  test.describe('Agent Definitions (AC-1)', () => {
    // AC: @ui-agent-dispatch ac-1
    test('agent card shows triggers', async ({ page, daemon }) => {
      await page.goto('/agents');
      await expect(page.getByTestId('agents-loading')).toHaveCount(0);

      const card = page.getByTestId('agent-card-task-worker');
      const triggers = card.getByTestId('agent-trigger');
      // task-worker has 3 triggers: ready, in_progress, needs_work
      await expect(triggers).toHaveCount(3);
    });
  });

  test.describe('Dispatch Running State (AC-2)', () => {
    // AC: @ui-agent-dispatch ac-2
    test('shows dispatch as running after start', async ({ page, daemon, request }) => {
      // Use request fixture for API calls
      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
        data: { action: 'start' },
        headers: { 'Content-Type': 'application/json' },
      });

      await page.goto('/agents');

      const badge = page.getByTestId('dispatch-status-badge');
      await expect(badge).toContainText('Running');

      const indicator = page.getByTestId('dispatch-indicator-running');
      await expect(indicator).toBeVisible();

      // Clean up
      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
        data: { action: 'stop' },
        headers: { 'Content-Type': 'application/json' },
      });
    });

    // AC: @ui-agent-dispatch ac-2
    test('clicking stop button stops dispatch', async ({ page, daemon, request }) => {
      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
        data: { action: 'start' },
        headers: { 'Content-Type': 'application/json' },
      });

      await page.goto('/agents');

      const toggleButton = page.getByTestId('dispatch-toggle-button');
      await toggleButton.click();

      const badge = page.getByTestId('dispatch-status-badge');
      await expect(badge).toContainText('Stopped');
    });
  });

  test.describe('Accessibility', () => {
    test('has aria-live region for invocation announcements', async ({ page, daemon }) => {
      await page.goto('/agents');
      await expect(page.getByTestId('agents-loading')).toHaveCount(0);

      const liveRegion = page.getByTestId('invocation-live-region');
      await expect(liveRegion).toBeAttached();
      await expect(liveRegion).toHaveAttribute('aria-live', 'assertive');
    });
  });

  test.describe('Navigation', () => {
    test('agents page is accessible from sidebar', async ({ page, daemon }) => {
      await page.goto('/');

      const agentsLink = page.getByTestId('nav-link-agents');
      await expect(agentsLink).toBeVisible();

      await agentsLink.click();
      await expect(page).toHaveURL(/\/agents/);
    });
  });
});
```

#### D. **Real Daemon API Test Pattern (from `api-tasks.spec.ts`)**

```typescript
test.describe('Tasks API', () => {
  test.describe('GET /api/tasks', () => {
    // AC: @api-contract ac-2
    test('returns tasks with required fields', async ({ request, daemon }) => {
      const response = await request.get(`${daemon.baseUrl}/api/tasks`);

      expect(response.status()).toBe(200);

      const body = await response.json();

      // Paginated response structure
      expect(body).toHaveProperty('items');
      expect(body).toHaveProperty('total');
      expect(body).toHaveProperty('offset');
      expect(body).toHaveProperty('limit');
      expect(Array.isArray(body.items)).toBe(true);
      expect(body.items.length).toBeGreaterThan(0);

      const task = body.items[0];
      expect(task).toHaveProperty('_ulid');
      expect(task).toHaveProperty('title');
      expect(task).toHaveProperty('status');
      expect(task).toHaveProperty('priority');
      expect(task).toHaveProperty('notes_count');
    });

    // AC: @api-contract ac-3 - Multi-value status filter
    test('filters tasks by multiple status values using repeated param', async ({
      request,
      daemon,
    }) => {
      const response = await request.get(
        `${daemon.baseUrl}/api/tasks?status=pending&status=in_progress`
      );
      expect(response.status()).toBe(200);

      const body = await response.json();
      expect(Array.isArray(body.items)).toBe(true);
      expect(body.items.length).toBeGreaterThan(0);

      // Validate all returned tasks match filter
      for (const task of body.items) {
        expect(['pending', 'in_progress']).toContain(task.status);
      }
    });
  });
});
```

### 5. **Test ID Convention**

All tests use `data-testid` attributes for reliable element selection:

**Common patterns:**
- Navigation: `nav-link-{page}` (e.g., `nav-link-sessions`, `nav-link-agents`)
- Lists: `{entity}-list`, `{entity}-row`, `{entity}-empty`, `{entity}-loading`
- Counts/Badges: `{entity}-count-{status}`, `{entity}-badge`, `{entity}-indicator-{state}`
- Forms: `filter-{field}`, `{entity}-toggle-button`
- State indicators: `dispatch-status`, `dispatch-status-badge`, `dispatch-indicator-{state}`
- Details: `{entity}-{field}` (e.g., `session-id`, `session-duration`, `session-task-ref`)

### 6. **Assertion Patterns**

**Visibility & Existence:**
```typescript
await expect(element).toBeVisible();
await expect(element).toBeVisible({ timeout: 5000 });
await expect(element).toHaveCount(3);
await expect(element).toHaveCount(0);  // Element should not exist
await expect(element).toBeAttached();
```

**Text Content:**
```typescript
await expect(element).toContainText('exact text');
await expect(element).toContainText(/regex/i);
await expect(element).not.toContainText('...');
await expect(element).not.toBeEmpty();
```

**Attributes:**
```typescript
await expect(element).toHaveAttribute('href', '/path');
await expect(element).toHaveAttribute('data-session-id', '01JTEST0...');
await expect(element).toHaveAttribute('aria-live', 'assertive');
```

**Navigation:**
```typescript
await expect(page).toHaveURL(/\/sessions/);
await expect(page).toHaveURL(/\/sessions\/01JTEST0000000000000000001/);
```

**Loading/Async Patterns:**
```typescript
await page.waitForURL(/\/tasks\?status=pending/, { timeout: 10000 });
await expect(page.getByTestId('sessions-list')).toBeVisible({ timeout: 5000 });
await page.waitForTimeout(500);
```

### 7. **Fixture Data Structure**

**Tasks (5 total for comprehensive state coverage):**
- `test-task-ready` — pending status, no deps → ready
- `test-task-blocked` — pending status, depends on test-task-ready → blocked
- `test-task-in-progress` — in_progress status, has 1 note
- `test-task-pending-review` — pending_review status, has 1 note
- `test-task-completed` — completed status, has started_at and completed_at

**Session Focus:**
- Set to "E2E testing" in kynetic.meta.yaml

**Observations:**
- 2 unresolved observations (friction + success) for badge testing

**Agents:**
- `task-worker` — 3 triggers: task.ready, task.in_progress, task.needs_work
- `pr-reviewer` — 1 trigger: task.pending_review

### 8. **Key Testing Rules**

1. **No hardcoded ports** — Always use `daemon.baseUrl` from fixture
2. **Ephemeral port allocation** — Each test gets its own isolated daemon on a unique port
3. **Sequential execution** — `workers: 1` ensures tests don't conflict
4. **Isolated filesystem** — Daemon uses temp dir with isolated HOME for config
5. **Graceful cleanup** — Use `kspec serve stop` instead of killing processes
6. **Route registration order** — Register least-specific first, most-specific last (LIFO)
7. **Delays for visibility** — Use `setTimeout()` in route handlers to make loading states visible
8. **AC annotations** — Link tests to ACs with `// AC: @spec-ref ac-N` comments

### 9. **Running the Tests**

```bash
# All E2E tests
npm run test:e2e

# Specific test file
npm run test:e2e -- dashboard.spec.ts

# With debugging
PWDEBUG=1 npm run test:e2e

# With traces
npm run test:e2e -- --trace on
```

This comprehensive pattern ensures isolated, reliable E2E testing with full daemon lifecycle management and proper async handling for all state transitions.