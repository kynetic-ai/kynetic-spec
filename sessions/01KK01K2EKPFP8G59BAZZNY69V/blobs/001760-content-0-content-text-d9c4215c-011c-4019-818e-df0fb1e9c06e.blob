```
     1→<script lang="ts">
     2→	// AC: @ui-validation-view ac-1
     3→	import { onMount } from 'svelte';
     4→	import {
     5→		fetchValidation,
     6→		fetchAlignment,
     7→		type ValidationResponse,
     8→		type AlignmentResponse,
     9→		type SchemaValidationError,
    10→		type RefValidationError,
    11→		type RefValidationWarning,
    12→		type CompletenessWarning,
    13→		type TraitCycleError,
    14→		type OrphanItem,
    15→		type AlignmentWarning
    16→	} from '$lib/api';
    17→	import { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';
    18→	import { Badge } from '$lib/components/ui/badge';
    19→	import {
    20→		ShieldCheck,
    21→		ShieldAlert,
    22→		AlertTriangle,
    23→		AlertCircle,
    24→		CheckCircle2,
    25→		Info,
    26→		Link2Off,
    27→		FileWarning,
    28→		RefreshCw
    29→	} from 'lucide-svelte';
    30→	import { getProjectVersion } from '$lib/stores/project.svelte';
    31→
    32→	// --- State ---
    33→
    34→	let validation = $state<ValidationResponse | null>(null);
    35→	let alignment = $state<AlignmentResponse | null>(null);
    36→	let loading = $state(true);
    37→	let error = $state('');
    38→
    39→	// --- Derived counts ---
    40→	// AC: @ui-validation-view ac-1 — error count, warning count, valid item count
    41→
    42→	let errorCount = $derived.by(() => {
    43→		if (!validation) return 0;
    44→		return (
    45→			validation.schemaErrors.length +
    46→			validation.refErrors.length +
    47→			validation.traitCycles.length
    48→		);
    49→	});
    50→
    51→	let warningCount = $derived.by(() => {
    52→		if (!validation) return 0;
    53→		return (
    54→			validation.refWarnings.length +
    55→			validation.completenessWarnings.length +
    56→			validation.orphans.length
    57→		);
    58→	});
    59→
    60→	let validItemCount = $derived(validation?.valid ? 1 : 0);
    61→
    62→	// AC: @ui-validation-view ac-1 — spec coverage %, AC coverage %
    63→	let specCoverage = $derived.by(() => {
    64→		if (!alignment || alignment.stats.totalSpecs === 0) return 0;
    65→		return Math.round(
    66→			(alignment.stats.specsWithTasks / alignment.stats.totalSpecs) * 100
    67→		);
    68→	});
    69→
    70→	let alignmentPct = $derived.by(() => {
    71→		if (!alignment || alignment.stats.totalSpecs === 0) return 0;
    72→		return Math.round(
    73→			(alignment.stats.alignedSpecs / alignment.stats.totalSpecs) * 100
    74→		);
    75→	});
    76→
    77→	// --- Group issues by severity ---
    78→
    79→	type GroupedIssue = {
    80→		severity: 'error' | 'warning' | 'info';
    81→		category: string;
    82→		message: string;
    83→		detail?: string;
    84→	};
    85→
    86→	let groupedIssues = $derived.by((): GroupedIssue[] => {
    87→		if (!validation && !alignment) return [];
    88→		const issues: GroupedIssue[] = [];
    89→
    90→		if (validation) {
    91→			for (const e of validation.schemaErrors) {
    92→				issues.push({
    93→					severity: 'error',
    94→					category: 'Schema',
    95→					message: e.message,
    96→					detail: e.file + (e.path ? ` (${e.path})` : '')
    97→				});
    98→			}
    99→			for (const e of validation.refErrors) {
   100→				issues.push({
   101→					severity: 'error',
   102→					category: 'Reference',
   103→					message: e.message,
   104→					detail: `${e.ref} in ${e.field}`
   105→				});
   106→			}
   107→			for (const e of validation.traitCycles) {
   108→				issues.push({
   109→					severity: 'error',
   110→					category: 'Trait Cycle',
   111→					message: e.message,
   112→					detail: e.cycle.join(' → ')
   113→				});
   114→			}
   115→			for (const w of validation.refWarnings) {
   116→				issues.push({
   117→					severity: 'warning',
   118→					category: 'Reference',
   119→					message: w.message,
   120→					detail: `${w.ref} in ${w.field}`
   121→				});
   122→			}
   123→			for (const w of validation.completenessWarnings) {
   124→				issues.push({
   125→					severity: 'warning',
   126→					category: completenessLabel(w.type),
   127→					message: w.message,
   128→					detail: w.details ?? `${w.itemRef} — ${w.itemTitle}`
   129→				});
   130→			}
   131→			for (const o of validation.orphans) {
   132→				issues.push({
   133→					severity: 'info',
   134→					category: 'Orphan',
   135→					message: `${o.title} (${o.type})`,
   136→					detail: o.file ?? o.ulid
   137→				});
   138→			}
   139→		}
   140→
   141→		if (alignment) {
   142→			for (const w of alignment.warnings) {
   143→				issues.push({
   144→					severity: w.type === 'status_mismatch' ? 'warning' : 'info',
   145→					category: alignmentLabel(w.type),
   146→					message: w.message,
   147→					detail: w.specTitle ?? w.specUlid
   148→				});
   149→			}
   150→		}
   151→
   152→		return issues;
   153→	});
   154→
   155→	let errorIssues = $derived(groupedIssues.filter((i) => i.severity === 'error'));
   156→	let warningIssues = $derived(groupedIssues.filter((i) => i.severity === 'warning'));
   157→	let infoIssues = $derived(groupedIssues.filter((i) => i.severity === 'info'));
   158→
   159→	// --- Lifecycle ---
   160→
   161→	onMount(async () => {
   162→		await loadData();
   163→	});
   164→
   165→	$effect(() => {
   166→		const version = getProjectVersion();
   167→		if (version > 0) {
   168→			loadData();
   169→		}
   170→	});
   171→
   172→	async function loadData() {
   173→		try {
   174→			loading = true;
   175→			error = '';
   176→			const [v, a] = await Promise.all([fetchValidation(), fetchAlignment()]);
   177→			validation = v;
   178→			alignment = a;
   179→		} catch (err) {
   180→			error = err instanceof Error ? err.message : 'Failed to load validation data';
   181→		} finally {
   182→			loading = false;
   183→		}
   184→	}
   185→
   186→	// --- Helpers ---
   187→
   188→	function completenessLabel(type: string): string {
   189→		const labels: Record<string, string> = {
   190→			missing_acceptance_criteria: 'Missing AC',
   191→			missing_description: 'Missing Description',
   192→			status_inconsistency: 'Status Inconsistency',
   193→			missing_test_coverage: 'Test Coverage',
   194→			automation_eligible_no_spec: 'No Spec',
   195→			ac_schema_field_mismatch: 'AC Schema Mismatch'
   196→		};
   197→		return labels[type] ?? type;
   198→	}
   199→
   200→	function alignmentLabel(type: string): string {
   201→		const labels: Record<string, string> = {
   202→			orphaned_spec: 'Orphaned Spec',
   203→			status_mismatch: 'Status Mismatch',
   204→			stale_implementation: 'Stale Implementation'
   205→		};
   206→		return labels[type] ?? type;
   207→	}
   208→
   209→	function severityIcon(severity: 'error' | 'warning' | 'info') {
   210→		if (severity === 'error') return AlertCircle;
   211→		if (severity === 'warning') return AlertTriangle;
   212→		return Info;
   213→	}
   214→
   215→	function severityColor(severity: 'error' | 'warning' | 'info') {
   216→		if (severity === 'error') return 'text-red-600';
   217→		if (severity === 'warning') return 'text-yellow-600';
   218→		return 'text-blue-500';
   219→	}
   220→
   221→	function severityBg(severity: 'error' | 'warning' | 'info') {
   222→		if (severity === 'error') return 'bg-red-50 border-red-200';
   223→		if (severity === 'warning') return 'bg-yellow-50 border-yellow-200';
   224→		return 'bg-blue-50 border-blue-200';
   225→	}
   226→</script>
   227→
   228→<!-- AC: @ui-validation-view ac-1 -->
   229→<div class="flex flex-col gap-6" data-testid="validate-page">
   230→	<div class="flex items-center justify-between">
   231→		<div class="flex items-center gap-3">
   232→			<h1 class="text-3xl font-bold">Validate</h1>
   233→			{#if !loading && validation}
   234→				{#if validation.valid && errorCount === 0}
   235→					<Badge class="bg-emerald-500 text-white" data-testid="status-valid">
   236→						<CheckCircle2 class="mr-1 h-3 w-3" />
   237→						Valid
   238→					</Badge>
   239→				{:else}
   240→					<Badge class="bg-red-500 text-white" data-testid="status-invalid">
   241→						<ShieldAlert class="mr-1 h-3 w-3" />
   242→						Issues Found
   243→					</Badge>
   244→				{/if}
   245→			{/if}
   246→		</div>
   247→		{#if !loading}
   248→			<button
   249→				class="inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm
   250→					text-muted-foreground transition-colors hover:bg-muted/50"
   251→				onclick={loadData}
   252→				data-testid="refresh-btn"
   253→			>
   254→				<RefreshCw class="h-3.5 w-3.5" />
   255→				Refresh
   256→			</button>
   257→		{/if}
   258→	</div>
   259→
   260→	<!-- Error banner -->
   261→	{#if error}
