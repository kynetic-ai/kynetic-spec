   265→			data-testid="error"
   266→		>
   267→			{error}
   268→		</div>
   269→	{/if}
   270→
   271→	<!-- Loading state -->
   272→	{#if loading}
   273→		<div class="space-y-4" data-testid="loading">
   274→			<div class="grid gap-4 md:grid-cols-3">
   275→				{#each Array(3) as _}
   276→					<Card>
   277→						<CardHeader class="pb-2">
   278→							<div class="h-4 w-24 animate-pulse rounded bg-muted"></div>
   279→						</CardHeader>
   280→						<CardContent>
   281→							<div class="h-8 w-16 animate-pulse rounded bg-muted"></div>
   282→						</CardContent>
   283→					</Card>
   284→				{/each}
   285→			</div>
   286→			<Card>
   287→				<CardHeader class="pb-2">
   288→					<div class="h-4 w-32 animate-pulse rounded bg-muted"></div>
   289→				</CardHeader>
   290→				<CardContent class="space-y-3">
   291→					{#each Array(3) as _}
   292→						<div class="h-4 w-full animate-pulse rounded bg-muted"></div>
   293→					{/each}
   294→				</CardContent>
   295→			</Card>
   296→		</div>
   297→
   298→	<!-- Empty state (no data returned) -->
   299→	{:else if !validation && !alignment && !error}
   300→		<div class="text-center text-muted-foreground py-12" data-testid="empty">
   301→			<ShieldCheck class="mx-auto h-12 w-12 mb-4 opacity-50" />
   302→			<p>No validation data available.</p>
   303→			<p class="text-sm">Connect to a running daemon to run validation.</p>
   304→		</div>
   305→
   306→	<!-- Data loaded -->
   307→	{:else}
   308→		<!-- Summary Cards -->
   309→		<!-- AC: @ui-validation-view ac-1 — error count, warning count, valid item count -->
   310→		<div class="grid gap-4 md:grid-cols-3" data-testid="summary-cards">
   311→			<Card data-testid="error-count-card">
