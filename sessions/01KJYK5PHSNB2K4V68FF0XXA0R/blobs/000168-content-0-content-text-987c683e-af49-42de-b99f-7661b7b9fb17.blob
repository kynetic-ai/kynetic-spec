```
     1→<script lang="ts">
     2→	// AC: @interactive-triage-ui ac-1, ac-2, ac-3, ac-4, ac-5, ac-6, ac-7, ac-8
     3→	// AC: @trait-websocket-protocol ac-1, ac-2, ac-3
     4→	import { onMount, onDestroy } from 'svelte';
     5→	import { goto } from '$app/navigation';
     6→	import { base } from '$app/paths';
     7→	import { page } from '$app/stores';
     8→	import type { InboxItem, BroadcastEvent } from '@kynetic-ai/shared';
     9→	import type { TriageRecord, TriageAction } from '$lib/types/triage';
    10→	import {
    11→		fetchInbox,
    12→		fetchTriageRecords,
    13→		createTriageRecord,
    14→		overrideTriageRecord,
    15→		actOnTriageRecord
    16→	} from '$lib/api';
    17→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    18→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    19→	import { getProjectVersion } from '$lib/stores/project.svelte';
    20→	import { Button } from '$lib/components/ui/button';
    21→	import { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';
    22→	import { Badge } from '$lib/components/ui/badge';
    23→	import { Textarea } from '$lib/components/ui/textarea';
    24→	import { Separator } from '$lib/components/ui/separator';
    25→	import ChevronLeftIcon from '@lucide/svelte/icons/chevron-left';
    26→	import ChevronRightIcon from '@lucide/svelte/icons/chevron-right';
    27→
    28→	// Data state
    29→	let inboxItems = $state<InboxItem[]>([]);
    30→	let triageRecords = $state<TriageRecord[]>([]);
    31→	let loading = $state(true);
    32→	let error = $state('');
    33→
    34→	// Card navigation state
    35→	// AC: @interactive-triage-ui ac-5
    36→	let currentIndex = $state(0);
    37→	let submitting = $state(false);
    38→
    39→	// Form state
    40→	// AC: @interactive-triage-ui ac-3
    41→	let selectedAction = $state<TriageAction | ''>('');
    42→	let reasoning = $state('');
    43→
    44→	// Action labels
    45→	const ACTION_LABELS: Record<TriageAction, string> = {
    46→		promote: 'Promote to Task',
    47→		delete: 'Delete',
    48→		defer: 'Defer',
    49→		'spec-gap': 'Spec Gap',
    50→		duplicate: 'Duplicate'
    51→	};
    52→
    53→	const ACTION_COLORS: Record<TriageAction, string> = {
    54→		promote: 'bg-green-500',
    55→		delete: 'bg-red-500',
    56→		defer: 'bg-yellow-500',
    57→		'spec-gap': 'bg-purple-500',
    58→		duplicate: 'bg-gray-500'
    59→	};
    60→
    61→	type TriageFilterStatus = 'all' | 'untriaged' | 'triaged' | 'acted_on';
    62→	const TRIAGE_STATUS_VALUES: readonly TriageFilterStatus[] = ['all', 'untriaged', 'triaged', 'acted_on'];
    63→	const TRIAGE_ACTION_VALUES = Object.keys(ACTION_LABELS) as TriageAction[];
    64→
    65→	// Filter state
    66→	// AC: @interactive-triage-ui ac-7
    67→	let filterTag = $state<string | ''>('');
    68→	let filterStatus = $state<TriageFilterStatus>('all');
    69→	let filterAction = $state<TriageAction | ''>('');
    70→
    71→	function parseFilterStatus(rawStatus: string | null): TriageFilterStatus {
    72→		if (rawStatus && TRIAGE_STATUS_VALUES.includes(rawStatus as TriageFilterStatus)) {
    73→			return rawStatus as TriageFilterStatus;
    74→		}
    75→		return 'all';
    76→	}
    77→
    78→	function parseFilterAction(rawAction: string | null): TriageAction | '' {
    79→		if (rawAction && TRIAGE_ACTION_VALUES.includes(rawAction as TriageAction)) {
    80→			return rawAction as TriageAction;
    81→		}
    82→		return '';
    83→	}
    84→
    85→	$effect(() => {
    86→		const nextTag = $page.url.searchParams.get('tag') || '';
    87→		const nextStatus = parseFilterStatus($page.url.searchParams.get('status'));
    88→		const nextAction = parseFilterAction($page.url.searchParams.get('action'));
    89→
    90→		if (filterTag !== nextTag) {
    91→			filterTag = nextTag;
    92→		}
    93→		if (filterStatus !== nextStatus) {
    94→			filterStatus = nextStatus;
    95→		}
    96→		if (filterAction !== nextAction) {
    97→			filterAction = nextAction;
    98→		}
    99→	});
   100→
   101→	// Merged view: inbox items with their triage records
   102→	interface TriageCardItem {
   103→		inbox: InboxItem;
   104→		record: TriageRecord | null;
   105→	}
   106→
   107→	// AC: @interactive-triage-ui ac-7 - Filtered items
   108→	let allItems = $derived.by(() => {
   109→		const items: TriageCardItem[] = inboxItems.map((inbox) => {
   110→			const record = triageRecords.find((r) => r.inbox_ref === inbox._ulid) ?? null;
   111→			return { inbox, record };
   112→		});
   113→		return items;
   114→	});
   115→
   116→	let filteredItems = $derived.by(() => {
   117→		let items = allItems;
   118→
   119→		// Tag filter
   120→		if (filterTag) {
   121→			items = items.filter((i) => i.inbox.tags.includes(filterTag));
   122→		}
   123→
   124→		// Status filter
   125→		if (filterStatus === 'untriaged') {
   126→			items = items.filter((i) => !i.record || i.record.status === 'pending');
   127→		} else if (filterStatus === 'triaged') {
   128→			items = items.filter((i) => i.record?.status === 'triaged');
   129→		} else if (filterStatus === 'acted_on') {
   130→			items = items.filter((i) => i.record?.status === 'acted_on');
   131→		}
   132→
   133→		// Action filter
   134→		if (filterAction) {
   135→			items = items.filter((i) => i.record?.action === filterAction);
   136→		}
   137→
   138→		return items;
   139→	});
   140→
   141→	let currentItem = $derived(filteredItems[currentIndex] ?? null);
   142→
   143→	// AC: @interactive-triage-ui ac-7 - Progress count
   144→	let triagedCount = $derived(allItems.filter((i) => i.record && i.record.status !== 'pending').length);
   145→	let totalCount = $derived(allItems.length);
   146→
   147→	// All unique tags for filter
   148→	let allTags = $derived.by(() => {
   149→		const tagSet = new Set<string>();
   150→		inboxItems.forEach((item) => item.tags.forEach((t) => tagSet.add(t)));
   151→		return Array.from(tagSet).sort();
   152→	});
   153→
   154→	onMount(async () => {
   155→		await loadData();
   156→
   157→		// AC: @interactive-triage-ui ac-6 - Subscribe to triage:updates
   158→		// AC: @trait-websocket-protocol ac-2 - Subscribe to topic
   159→		if (!isStaticMode()) {
   160→			subscribe(['triage:updates']);
   161→			on('triage:updates', handleTriageUpdate);
   162→		}
   163→	});
   164→
   165→	onDestroy(() => {
   166→		if (!isStaticMode()) {
   167→			off('triage:updates', handleTriageUpdate);
   168→			unsubscribe(['triage:updates']);
   169→		}
   170→	});
   171→
   172→	// AC: @multi-directory-daemon ac-27 - Reload on project change
   173→	$effect(() => {
   174→		const version = getProjectVersion();
   175→		if (version > 0) {
   176→			loadData();
   177→		}
   178→	});
   179→
   180→	// AC: @interactive-triage-ui ac-6 - Real-time update handler
   181→	// AC: @trait-websocket-protocol ac-3 - Handle broadcast event
   182→	function handleTriageUpdate(_event: BroadcastEvent) {
   183→		// Reload triage records on any triage update
   184→		loadTriageData();
   185→	}
   186→
   187→	async function loadData() {
   188→		try {
   189→			loading = true;
   190→			error = '';
   191→			const [inboxResponse, triageResponse] = await Promise.all([
   192→				fetchInbox({ limit: 1000 }),
   193→				fetchTriageRecords({ limit: 1000 })
   194→			]);
   195→			inboxItems = inboxResponse.items;
   196→			triageRecords = triageResponse.items;
   197→		} catch (err) {
   198→			error = err instanceof Error ? err.message : 'Failed to load triage data';
   199→		} finally {
   200→			loading = false;
   201→		}
   202→	}
   203→
   204→	async function loadTriageData() {
   205→		try {
   206→			const triageResponse = await fetchTriageRecords({ limit: 1000 });
   207→			triageRecords = triageResponse.items;
   208→		} catch (err) {
   209→			console.error('Failed to reload triage records:', err);
   210→		}
   211→	}
   212→
   213→	function updateFilterParam(key: 'status' | 'action' | 'tag', value: string) {
   214→		const params = new URLSearchParams($page.url.searchParams);
   215→
   216→		if (!value || value === 'all') {
   217→			params.delete(key);
   218→		} else {
   219→			params.set(key, value);
   220→		}
   221→
   222→		const query = params.toString();
   223→		const nextUrl = query ? `${base}/triage?${query}` : `${base}/triage`;
   224→		goto(nextUrl, { replaceState: false, keepFocus: true, noScroll: true });
   225→	}
   226→
   227→	// AC: @interactive-triage-ui ac-5 - Navigation
   228→	function goNext() {
   229→		if (currentIndex < filteredItems.length - 1) {
   230→			currentIndex++;
   231→			resetForm();
   232→		}
   233→	}
   234→
   235→	function goPrevious() {
   236→		if (currentIndex > 0) {
   237→			currentIndex--;
   238→			resetForm();
   239→		}
   240→	}
   241→
   242→	function resetForm() {
   243→		selectedAction = '';
   244→		reasoning = '';
   245→		error = '';
   246→	}
   247→
   248→	// Keyboard navigation - skip when focus is on input/textarea elements
   249→	function handleKeydown(e: KeyboardEvent) {
   250→		const target = e.target as HTMLElement;
   251→		if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable) {
   252→			return;
   253→		}
   254→		if (e.key === 'ArrowLeft') {
   255→			goPrevious();
   256→		} else if (e.key === 'ArrowRight') {
   257→			goNext();
   258→		}
   259→	}
   260→
   261→	// AC: @interactive-triage-ui ac-3 - Submit triage decision
   262→	async function handleSubmit() {
   263→		if (!currentItem || !selectedAction || !reasoning.trim()) return;
   264→
   265→		if (isStaticMode()) {
   266→			error = 'Cannot submit triage decisions in read-only mode.';
   267→			return;
   268→		}
   269→
   270→		try {
   271→			submitting = true;
   272→			error = '';
   273→
   274→			const existing = currentItem.record;
   275→
   276→			if (existing && existing.status !== 'pending') {
   277→				// AC: @interactive-triage-ui ac-4 - Override existing decision
   278→				await overrideTriageRecord(existing._ulid, {
   279→					action: selectedAction,
   280→					reasoning: reasoning.trim()
   281→				});
   282→			} else {
   283→				// Create new triage record
   284→				await createTriageRecord({
   285→					inbox_ref: currentItem.inbox._ulid,
   286→					action: selectedAction,
   287→					reasoning: reasoning.trim()
   288→				});
   289→			}
   290→
   291→			// Reload triage data
   292→			await loadTriageData();
   293→
   294→			// Auto-advance to next item
   295→			// AC: @interactive-triage-ui ac-3 - advances to next item
   296→			if (currentIndex < filteredItems.length - 1) {
   297→				currentIndex++;
   298→			}
   299→			resetForm();
   300→		} catch (err) {
   301→			if (err instanceof ReadOnlyModeError) {
   302→				error = err.message;
   303→			} else {
   304→				error = err instanceof Error ? err.message : 'Failed to submit triage decision';
   305→			}
   306→		} finally {
   307→			submitting = false;
   308→		}
   309→	}
   310→
   311→	// Execute the triage action
   312→	async function handleAct() {
   313→		if (!currentItem?.record) return;
   314→
   315→		if (isStaticMode()) {
   316→			error = 'Cannot execute triage actions in read-only mode.';
   317→			return;
   318→		}
   319→
   320→		try {
   321→			submitting = true;
   322→			error = '';
   323→			await actOnTriageRecord(currentItem.record._ulid);
   324→			await loadTriageData();
   325→		} catch (err) {
   326→			if (err instanceof ReadOnlyModeError) {
   327→				error = err.message;
   328→			} else {
   329→				error = err instanceof Error ? err.message : 'Failed to execute triage action';
   330→			}
   331→		} finally {
   332→			submitting = false;
   333→		}
   334→	}
   335→
   336→	function formatDate(dateString: string): string {
   337→		const date = new Date(dateString);
   338→		const now = new Date();
   339→		const diffMs = now.getTime() - date.getTime();
   340→		const diffMins = Math.floor(diffMs / 60000);
   341→		const diffHours = Math.floor(diffMs / 3600000);
   342→		const diffDays = Math.floor(diffMs / 86400000);
   343→
   344→		if (diffMins < 1) return 'just now';
   345→		if (diffMins < 60) return `${diffMins}m ago`;
   346→		if (diffHours < 24) return `${diffHours}h ago`;
   347→		if (diffDays < 7) return `${diffDays}d ago`;
   348→
   349→		return date.toLocaleDateString();
   350→	}
   351→
   352→	// AC: @interactive-triage-ui ac-7 - Reset index when filter changes
   353→	$effect(() => {
   354→		// Reading filter values creates reactive dependencies
   355→		const _tag = filterTag;
   356→		const _status = filterStatus;
   357→		const _action = filterAction;
   358→		currentIndex = 0;
   359→		resetForm();
   360→	});
   361→</script>
   362→
   363→<svelte:window onkeydown={handleKeydown} />
   364→
   365→<!-- AC: @interactive-triage-ui ac-1, ac-5, ac-7 -->
   366→<div class="flex flex-col gap-4 p-6">
   367→	<div class="flex items-center justify-between">
   368→		<div>
   369→			<h1 class="text-3xl font-bold">Triage</h1>
   370→			{#if !loading}
   371→				<!-- AC: @interactive-triage-ui ac-7 - Progress count -->
   372→				<p class="text-muted-foreground" data-testid="triage-progress">
   373→					{triagedCount} of {totalCount} triaged
   374→					{#if filteredItems.length !== allItems.length}
   375→						&middot; Showing {filteredItems.length} filtered
   376→					{/if}
   377→				</p>
   378→			{/if}
   379→		</div>
   380→
   381→		<!-- AC: @interactive-triage-ui ac-7 - Filters -->
   382→		<div class="flex gap-2 items-center" data-testid="triage-filters">
   383→			<select
   384→				bind:value={filterStatus}
   385→				onchange={(event) => updateFilterParam('status', (event.currentTarget as HTMLSelectElement).value)}
   386→				class="rounded-md border bg-background px-3 py-1.5 text-sm"
   387→				data-testid="triage-status-filter"
   388→			>
   389→				<option value="all">All</option>
   390→				<option value="untriaged">Untriaged</option>
   391→				<option value="triaged">Triaged</option>
   392→				<option value="acted_on">Acted On</option>
   393→			</select>
   394→			<select
   395→				bind:value={filterAction}
   396→				onchange={(event) => updateFilterParam('action', (event.currentTarget as HTMLSelectElement).value)}
   397→				class="rounded-md border bg-background px-3 py-1.5 text-sm"
   398→				data-testid="triage-action-filter"
   399→			>
   400→				<option value="">All Actions</option>
   401→				{#each Object.entries(ACTION_LABELS) as [action, label]}
   402→					<option value={action}>{label}</option>
   403→				{/each}
   404→			</select>
   405→			{#if allTags.length > 0}
   406→				<select
   407→					bind:value={filterTag}
   408→					onchange={(event) => updateFilterParam('tag', (event.currentTarget as HTMLSelectElement).value)}
   409→					class="rounded-md border bg-background px-3 py-1.5 text-sm"
   410→					data-testid="triage-tag-filter"
   411→				>
   412→					<option value="">All Tags</option>
   413→					{#each allTags as tag}
   414→						<option value={tag}>{tag}</option>
   415→					{/each}
   416→				</select>
   417→			{/if}
   418→		</div>
   419→	</div>
   420→
   421→	<!-- Progress bar -->
   422→	{#if totalCount > 0}
   423→		<div class="w-full bg-muted rounded-full h-2" data-testid="triage-progress-bar">
   424→			<div
   425→				class="bg-primary rounded-full h-2 transition-all duration-300"
   426→				style="width: {(triagedCount / totalCount) * 100}%"
   427→			></div>
   428→		</div>
   429→	{/if}
   430→
   431→	{#if error}
   432→		<div class="rounded-md bg-red-50 p-4 text-sm text-red-800 dark:bg-red-900/20 dark:text-red-200" data-testid="triage-error" role="alert">
   433→			{error}
   434→		</div>
   435→	{/if}
   436→
   437→	<!-- AC: @interactive-triage-ui ac-8 - Static mode notice -->
   438→	{#if isStaticMode() && !loading}
   439→		<div class="rounded-md bg-amber-50 p-3 text-sm text-amber-800 dark:bg-amber-900/20 dark:text-amber-200" data-testid="triage-static-notice">
   440→			Triage decisions are not included in static snapshots. Browse inbox items below; use the daemon for full triage functionality.
   441→		</div>
   442→	{/if}
   443→
   444→	{#if loading}
   445→		<div class="text-center text-muted-foreground py-12">Loading triage data...</div>
   446→	{:else if filteredItems.length === 0}
   447→		<div class="text-center text-muted-foreground py-12">
   448→			{#if allItems.length === 0}
   449→				<p>No inbox items to triage.</p>
   450→				<p class="text-sm mt-1">Add items to your inbox first.</p>
   451→			{:else}
   452→				<p>No items match the current filters.</p>
   453→			{/if}
   454→		</div>
   455→	{:else if currentItem}
   456→		<!-- Card navigation -->
   457→		<div class="flex items-center justify-between mb-2">
   458→			<!-- AC: @interactive-triage-ui ac-5 - Navigation controls -->
   459→			<Button
   460→				variant="outline"
   461→				size="sm"
   462→				onclick={goPrevious}
   463→				disabled={currentIndex === 0}
   464→				data-testid="triage-prev"
   465→			>
   466→				<ChevronLeftIcon class="size-4 mr-1" />
   467→				Previous
   468→			</Button>
   469→			<span class="text-sm text-muted-foreground" data-testid="triage-position">
   470→				{currentIndex + 1} / {filteredItems.length}
   471→			</span>
   472→			<Button
   473→				variant="outline"
   474→				size="sm"
   475→				onclick={goNext}
   476→				disabled={currentIndex === filteredItems.length - 1}
   477→				data-testid="triage-next"
   478→			>
   479→				Next
   480→				<ChevronRightIcon class="size-4 ml-1" />
   481→			</Button>
   482→		</div>
   483→
   484→		<!-- AC: @interactive-triage-ui ac-1 - Card view showing item text, tags, age, added_by -->
   485→		<Card class="transition-all duration-200" data-testid="triage-card">
   486→			<CardHeader>
   487→				<div class="flex items-start justify-between gap-4">
   488→					<CardTitle class="text-lg leading-relaxed" data-testid="triage-card-text">
   489→						{currentItem.inbox.text}
   490→					</CardTitle>
   491→					<!-- AC: @interactive-triage-ui ac-5 - Show decision state on already-triaged items -->
   492→					{#if currentItem.record && currentItem.record.status !== 'pending'}
   493→						<Badge
   494→							class={currentItem.record.action ? ACTION_COLORS[currentItem.record.action] : 'bg-gray-500'}
   495→							data-testid="triage-card-status"
   496→						>
   497→							{currentItem.record.status === 'acted_on' ? 'Acted' : 'Triaged'}
   498→						</Badge>
   499→					{/if}
   500→				</div>
   501→				<!-- AC: @interactive-triage-ui ac-1 - tags, age, added_by -->
   502→				<div class="flex items-center gap-2 text-xs text-muted-foreground mt-2" data-testid="triage-card-meta">
   503→					<span data-testid="triage-card-age">{formatDate(currentItem.inbox.created_at)}</span>
   504→					<span>&middot;</span>
   505→					<span data-testid="triage-card-added-by">{currentItem.inbox.added_by}</span>
   506→					{#if currentItem.inbox.tags.length > 0}
   507→						<span>&middot;</span>
   508→						<div class="flex gap-1" data-testid="triage-card-tags">
   509→							{#each currentItem.inbox.tags as tag}
   510→								<Badge variant="secondary" class="text-xs">{tag}</Badge>
   511→							{/each}
   512→						</div>
   513→					{/if}
   514→				</div>
   515→			</CardHeader>
   516→			<CardContent>
   517→				<!-- AC: @interactive-triage-ui ac-2 - Show agent recommendation if exists -->
   518→				{#if currentItem.record && currentItem.record.status !== 'pending'}
   519→					<div class="rounded-md bg-muted p-4 mb-4" data-testid="triage-agent-recommendation">
   520→						<p class="text-sm font-medium mb-2">
   521→							{#if currentItem.record.override_by}
   522→								Override Decision
   523→							{:else}
   524→								Agent Recommendation
   525→							{/if}
   526→						</p>
   527→						<div class="space-y-1 text-sm">
   528→							<p data-testid="triage-rec-action">
   529→								<span class="font-medium">Action:</span>
   530→								{currentItem.record.action ? ACTION_LABELS[currentItem.record.action] : 'None'}
   531→							</p>
   532→							<p data-testid="triage-rec-reasoning">
   533→								<span class="font-medium">Reasoning:</span>
   534→								{currentItem.record.override_reasoning || currentItem.record.reasoning}
   535→							</p>
   536→							{#if currentItem.record.evidence_refs.length > 0}
   537→								<p data-testid="triage-rec-evidence">
   538→									<span class="font-medium">Evidence:</span>
   539→									{currentItem.record.evidence_refs.join(', ')}
   540→								</p>
   541→							{/if}
   542→							<p class="text-xs text-muted-foreground">
   543→								Decided by: {currentItem.record.override_by || currentItem.record.decided_by}
   544→							</p>
   545→						</div>
   546→					</div>
   547→				{/if}
   548→
   549→				<!-- AC: @interactive-triage-ui ac-8 - Hide action UI in static mode -->
   550→				{#if !isStaticMode()}
   551→					<Separator class="my-4" />
   552→
   553→					<!-- AC: @interactive-triage-ui ac-3, ac-4 - Action selection and reasoning -->
   554→					<div class="space-y-4" data-testid="triage-action-form">
   555→						<div>
   556→							<p class="text-sm font-medium mb-2">
   557→								{currentItem.record && currentItem.record.status !== 'pending' ? 'Override Action' : 'Select Action'}
   558→							</p>
   559→							<div class="flex flex-wrap gap-2" data-testid="triage-action-buttons">
   560→								{#each Object.entries(ACTION_LABELS) as [action, label]}
   561→									<Button
   562→										variant={selectedAction === action ? 'default' : 'outline'}
   563→										size="sm"
   564→										onclick={() => (selectedAction = action as TriageAction)}
   565→										data-testid="triage-action-{action}"
   566→									>
   567→										{label}
   568→									</Button>
   569→								{/each}
   570→							</div>
   571→						</div>
   572→
   573→						<div>
   574→							<p class="text-sm font-medium mb-2">Reasoning</p>
   575→							<Textarea
   576→								placeholder="Why are you choosing this action?"
   577→								bind:value={reasoning}
   578→								rows={3}
   579→								disabled={submitting}
   580→								data-testid="triage-reasoning"
   581→							/>
   582→						</div>
   583→
   584→						<div class="flex gap-2">
   585→							<Button
   586→								onclick={handleSubmit}
   587→								disabled={submitting || !selectedAction || !reasoning.trim()}
   588→								data-testid="triage-submit"
   589→							>
   590→								{#if submitting}
   591→									Submitting...
   592→								{:else if currentItem.record && currentItem.record.status !== 'pending'}
   593→									Override Decision
   594→								{:else}
   595→									Submit Decision
   596→								{/if}
   597→							</Button>
   598→
   599→							{#if currentItem.record?.status === 'triaged'}
   600→								<Button
   601→									variant="secondary"
   602→									onclick={handleAct}
   603→									disabled={submitting}
   604→									data-testid="triage-act"
   605→								>
   606→									{submitting ? 'Executing...' : `Execute: ${currentItem.record.action ? ACTION_LABELS[currentItem.record.action] : ''}`}
   607→								</Button>
   608→							{/if}
   609→						</div>
   610→					</div>
   611→				{:else}
   612→					<!-- AC: @interactive-triage-ui ac-8 - Static mode: browsing only -->
   613→					{#if !currentItem.record}
   614→						<p class="text-sm text-muted-foreground mt-4">
   615→							No triage decision recorded. Use the CLI or daemon to triage items.
   616→						</p>
   617→					{/if}
   618→				{/if}
   619→			</CardContent>
   620→		</Card>
   621→	{/if}
   622→</div>
   623→
```