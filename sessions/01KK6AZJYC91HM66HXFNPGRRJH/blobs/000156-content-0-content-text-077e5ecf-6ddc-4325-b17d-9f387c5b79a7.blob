   621→
   622→  it("should preserve update chunk order and strict seq monotonicity during concurrent bursts", async () => {
   623→    // AC: @cli-agent-commands ac-12
   624→    // Regression for @01KJTQBT:
   625→    // Ensure concurrent update callbacks cannot reorder streamed chunks or
   626→    // produce duplicate/non-monotonic sequence numbers in events.jsonl.
   627→    const chunks = ["chunk-0", "chunk-1", "chunk-2", "chunk-3", "chunk-4"];
   628→    const agent = makeTestAgent();
   629→    const receivedChunks: string[] = [];
   630→    const updateSessionId = "mock-acp-session";
   631→    const emitter = new EventEmitter();
   632→
   633→    const spawnedAgent = {
   634→      client: {
   635→        on: (event: string, handler: (...args: unknown[]) => void) => {
   636→          emitter.on(event, handler);
   637→        },
   638→        newSession: vi.fn(async () => updateSessionId),
   639→        prompt: vi.fn(async () => {
   640→          for (const chunk of chunks) {
   641→            emitter.emit("update", updateSessionId, {
   642→              sessionUpdate: "agent_message_chunk",
   643→              content: { type: "text", text: chunk },
   644→            });
   645→          }
   646→          return { stopReason: "end_turn" };
   647→        }),
   648→        cancel: vi.fn(async () => undefined),
   649→        endSession: vi.fn(async () => undefined),
   650→        respondPermission: vi.fn(async () => undefined),
   651→      },
   652→      kill: vi.fn(() => undefined),
   653→    };
   654→
   655→    const spawnSpy = vi.spyOn(spawnerModule, "spawnAndInitialize").mockResolvedValue(
   656→      spawnedAgent as unknown as Awaited<ReturnType<typeof spawnerModule.spawnAndInitialize>>,
   657→    );
   658→
   659→    const originalAppendEvent = storeModule.appendEvent;
   660→    let inFlightUpdateWrites = 0;
   661→    let maxInFlightUpdateWrites = 0;
   662→    const appendSpy = vi.spyOn(storeModule, "appendEvent").mockImplementation(async (specDir, input) => {
   663→      if (input.type !== "session.update") {
   664→        return originalAppendEvent(specDir, input);
   665→      }
   666→
   667→      const update = input.data as { sessionUpdate?: string; content?: { type?: string; text?: string } };
   668→      const text = update.sessionUpdate === "agent_message_chunk" && update.content?.type === "text"
   669→        ? update.content.text ?? ""
   670→        : "";
   671→      const index = Number.parseInt(text.replace("chunk-", ""), 10);
   672→      const delayMs = Number.isNaN(index) ? 0 : (chunks.length - index) * 8;
   673→
   674→      inFlightUpdateWrites += 1;
   675→      maxInFlightUpdateWrites = Math.max(maxInFlightUpdateWrites, inFlightUpdateWrites);
   676→      try {
   677→        await new Promise((resolve) => setTimeout(resolve, delayMs));
   678→        return originalAppendEvent(specDir, input);
   679→      } finally {
   680→        inFlightUpdateWrites -= 1;
   681→      }
   682→    });
   683→
   684→    try {
   685→      const result = await runInvocation({
   686→        agent,
   687→        specDir: testDir,
   688→        cwd: process.cwd(),
   689→        taskRef: "@" + testUlid("TASK"),
   690→        prompt: "Concurrent update burst ordering",
   691→        trigger: "task.ready",
   692→        onUpdate: (update) => {
   693→          if (update.sessionUpdate === "agent_message_chunk" && update.content.type === "text") {
   694→            receivedChunks.push(update.content.text);
   695→          }
   696→        },
   697→      });
   698→
   699→      expect(result.outcome).toBe("success");
   700→      expect(receivedChunks).toEqual(chunks);
   701→      expect(maxInFlightUpdateWrites).toBe(1);
   702→
   703→      const eventsPath = path.join(testDir, "sessions", result.session.id, "events.jsonl");
   704→      const content = await fs.readFile(eventsPath, "utf-8");
   705→      const events = content.trim().split("\n").filter(Boolean).map((line) => JSON.parse(line));
   706→      const seqs = events.map((event: { seq: number }) => event.seq);
   707→      const uniqueSeqCount = new Set(seqs).size;
   708→      expect(uniqueSeqCount).toBe(seqs.length);
   709→      for (let i = 1; i < seqs.length; i++) {
   710→        expect(seqs[i]).toBeGreaterThan(seqs[i - 1]);
   711→      }
   712→    } finally {
   713→      appendSpy.mockRestore();
   714→      spawnSpy.mockRestore();
   715→    }
   716→  });
   717→
   718→  it("should externalize oversized payload blobs when session updates exceed threshold", async () => {
   719→    // AC: @agent-invocation-lifecycle ac-6 — blob externalization for oversized payloads
   720→    // Register mock adapter that sends a large payload (> EVENT_FIELD_EXTERNALIZE_BYTES = 16KB)
   721→    const oversizedText = "x".repeat(20 * 1024); // 20KB text — exceeds 16KB field threshold
   722→    registerAdapter("large-payload-acp", {
   723→      command: "node",
   724→      args: [MOCK_ACP],
   725→      env: {
   726→        MOCK_ACP_RESPONSE_TEXT: oversizedText,
   727→      },
   728→      description: "Mock ACP that sends oversized updates for blob externalization tests",
   729→    });
   730→
   731→    const agent = makeTestAgent({ adapter: "large-payload-acp" });
   732→    const result = await runInvocation({
   733→      agent,
   734→      specDir: testDir,
   735→      cwd: process.cwd(),
   736→      taskRef: "@" + testUlid("TASK"),
   737→      prompt: "Test blob externalization",
   738→      trigger: "task.ready",
   739→    });
   740→
   741→    expect(result.outcome).toBe("success");
   742→
   743→    const eventsPath = path.join(testDir, "sessions", result.session.id, "events.jsonl");
   744→    const content = await fs.readFile(eventsPath, "utf-8");
   745→    const lines = content.trim().split("\n").filter(Boolean);
   746→    const events = lines.map((l) => JSON.parse(l));
   747→
   748→    // Find the session.update event that contains the large payload
   749→    const updateEvent = events.find((e: { type: string }) => e.type === "session.update");
   750→    expect(updateEvent).toBeDefined();
   751→
   752→    // The oversized text field should be externalized as a blob pointer
   753→    // Walk data to find a blob pointer anywhere in the update's data tree
   754→    function hasBlobPointer(obj: unknown): boolean {
   755→      if (isSessionBlobPointer(obj)) return true;
   756→      if (typeof obj === "object" && obj !== null) {
   757→        return Object.values(obj).some(hasBlobPointer);
   758→      }
   759→      return false;
   760→    }
   761→
   762→    expect(hasBlobPointer(updateEvent.data)).toBe(true);
   763→
   764→    // Verify the blob file was created in the session's blobs/ directory
   765→    const blobDir = path.join(testDir, "sessions", result.session.id, "blobs");
   766→    const blobFiles = await fs.readdir(blobDir);
   767→    expect(blobFiles.length).toBeGreaterThan(0);
   768→  });
   769→});
