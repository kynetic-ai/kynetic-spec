   560→// ─── AC-6: Streaming event logging ───────────────────────────────────────────
   561→
   562→// AC: @agent-invocation-lifecycle ac-6
   563→describe("Streaming event logging", () => {
   564→  let testDir: string;
   565→
   566→  beforeEach(async () => {
   567→    testDir = await createTempDir("kspec-invoc-ac6-");
   568→    registerMockAdapter({
   569→      MOCK_ACP_RESPONSE_TEXT: "Streaming output test response",
   570→    });
   571→  });
   572→
   573→  afterEach(async () => {
   574→    await cleanupTempDir(testDir);
   575→  });
   576→
   577→  it("should receive onUpdate callback for streaming updates", async () => {
   578→    const agent = makeTestAgent();
   579→    const updates: unknown[] = [];
   580→
   581→    await runInvocation({
   582→      agent,
   583→      specDir: testDir,
   584→      cwd: process.cwd(),
   585→      taskRef: "@" + testUlid("TASK"),
