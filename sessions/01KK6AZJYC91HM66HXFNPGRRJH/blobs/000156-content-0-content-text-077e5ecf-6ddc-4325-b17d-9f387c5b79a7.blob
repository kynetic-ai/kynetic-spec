```
     1→/**
     2→ * Agent Invocation Lifecycle tests.
     3→ *
     4→ * Tests for per-invocation session creation, ACP agent spawn, prompt delivery,
     5→ * event logging, timeout handling, and structured completion tracking.
     6→ *
     7→ * Task: @implement-agent-invocation-lifecycle
     8→ * Spec: @agent-invocation-lifecycle
     9→ */
    10→
    11→import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
    12→import * as fs from "node:fs/promises";
    13→import * as fsSync from "node:fs";
    14→import * as path from "node:path";
    15→import * as os from "node:os";
    16→import { EventEmitter } from "node:events";
    17→import * as YAML from "yaml";
    18→import {
    19→  createSession,
    20→  appendEvent,
    21→  getSession,
    22→  closeSession,
    23→  injectEnvForAdapter,
    24→  removeEnvForAdapter,
    25→  isSessionBlobPointer,
    26→} from "../src/sessions/store.js";
    27→import * as storeModule from "../src/sessions/store.js";
    28→import { runInvocation, InvocationTimeoutError } from "../src/agent-runtime/invocation.js";
    29→import { resolveSkills, buildPromptWithSkills } from "../src/agent-runtime/prompts.js";
    30→import { registerAdapter } from "../src/agents/adapters.js";
    31→import * as spawnerModule from "../src/agents/spawner.js";
    32→import { ACPClient } from "../src/acp/index.js";
    33→import type { Agent } from "../src/schema/meta.js";
    34→import {
    35→  testUlid,
    36→  createTempDir,
    37→  cleanupTempDir,
    38→} from "./helpers/cli.js";
    39→
    40→// ─── Fixtures ─────────────────────────────────────────────────────────────────
    41→
    42→const MOCK_ACP = path.join(__dirname, "mocks", "acp-mock.js");
    43→const MOCK_KSPEC_CLI = path.join(__dirname, "mocks", "kspec-capture-mock.cjs");
    44→
    45→/**
    46→ * Create a minimal Agent definition for testing.
    47→ */
    48→function makeTestAgent(overrides: Partial<Agent> = {}): Agent {
    49→  return {
    50→    _ulid: testUlid("AGNT"),
    51→    id: "test-worker",
    52→    name: "Test Worker Agent",
    53→    capabilities: [],
    54→    tools: [],
    55→    conventions: [],
    56→    dispatch: [],
    57→    skills: [],
    58→    auto_approve: false,
    59→    concurrency: { max_concurrent: 1 },
    60→    adapter: "mock-acp",
    61→    ...overrides,
    62→  };
    63→}
    64→
    65→/**
    66→ * Register the mock ACP adapter for testing.
    67→ */
    68→function registerMockAdapter(env: Record<string, string> = {}): void {
    69→  registerAdapter("mock-acp", {
    70→    command: "node",
    71→    args: [MOCK_ACP],
    72→    env: {
    73→      MOCK_ACP_PROJECT_DIR: process.cwd(),
    74→      ...env,
    75→    },
    76→    description: "Mock ACP agent for testing",
    77→  });
    78→}
    79→
    80→// ─── AC-1: Session creation with trigger, agent_id, task_id ──────────────────
    81→
    82→// AC: @agent-invocation-lifecycle ac-1
    83→describe("Session creation on invocation start", () => {
    84→  let testDir: string;
    85→
    86→  beforeEach(async () => {
    87→    testDir = await createTempDir("kspec-invoc-ac1-");
    88→    registerMockAdapter();
    89→  });
    90→
    91→  afterEach(async () => {
    92→    await cleanupTempDir(testDir);
    93→  });
    94→
    95→  it("should create session with trigger, agent_id, and task_id populated", async () => {
    96→    const agent = makeTestAgent({ id: "worker-agent" });
    97→    const taskRef = "@" + testUlid("TASK");
    98→
    99→    // Run a quick invocation (mock agent completes immediately)
   100→    const result = await runInvocation({
   101→      agent,
   102→      specDir: testDir,
   103→      cwd: process.cwd(),
   104→      taskRef,
   105→      prompt: "Test session creation",
   106→      trigger: "task.ready",
   107→    });
   108→
   109→    expect(result.session).toBeDefined();
   110→    expect(result.session.trigger).toBe("task.ready");
   111→    expect(result.session.agent_id).toBe("worker-agent");
   112→    expect(result.session.task_id).toBe(taskRef);
   113→    expect(result.session.agent_type).toBe("mock-acp");
   114→  });
   115→
   116→  it("should create session directory with session.yaml", async () => {
   117→    const agent = makeTestAgent();
   118→    const taskRef = "@" + testUlid("TASK", 1);
   119→
   120→    const result = await runInvocation({
   121→      agent,
   122→      specDir: testDir,
   123→      cwd: process.cwd(),
   124→      taskRef,
   125→      prompt: "Check session file creation",
   126→      trigger: "task.needs_work",
   127→    });
   128→
   129→    const sessionDir = path.join(testDir, "sessions", result.session.id);
   130→    const sessionYaml = path.join(sessionDir, "session.yaml");
   131→
   132→    await expect(fs.access(sessionYaml)).resolves.toBeUndefined();
   133→    const content = await fs.readFile(sessionYaml, "utf-8");
   134→    const parsed = YAML.parse(content);
   135→    expect(parsed.trigger).toBe("task.needs_work");
   136→    expect(parsed.task_id).toBe(taskRef);
   137→  });
   138→});
   139→
   140→// ─── AC-2: KSPEC_SESSION_ID injection ────────────────────────────────────────
   141→
   142→// AC: @agent-invocation-lifecycle ac-2
   143→describe("KSPEC_SESSION_ID injection", () => {
   144→  let testDir: string;
   145→  let capturedSessionId: string | undefined;
   146→
   147→  beforeEach(async () => {
   148→    testDir = await createTempDir("kspec-invoc-ac2-");
   149→    capturedSessionId = undefined;
   150→
   151→    // Register a mock adapter that captures the env var
   152→    // The mock ACP agent receives KSPEC_SESSION_ID through process env
   153→    registerMockAdapter();
   154→  });
   155→
   156→  afterEach(async () => {
   157→    // Restore process.env.KSPEC_SESSION_ID if it was set
   158→    delete process.env.KSPEC_SESSION_ID;
   159→    await cleanupTempDir(testDir);
   160→  });
   161→
   162→  it("should set KSPEC_SESSION_ID in process env during invocation", async () => {
   163→    const agent = makeTestAgent();
   164→    let envDuringInvocation: string | undefined;
   165→
   166→    // We can't easily intercept the spawned process env, but we can verify
   167→    // that KSPEC_SESSION_ID was set and cleared on the invoking process
   168→    // by checking that it was cleaned up after
   169→    const beforeSessionId = process.env.KSPEC_SESSION_ID;
   170→
   171→    const result = await runInvocation({
   172→      agent,
   173→      specDir: testDir,
   174→      cwd: process.cwd(),
   175→      taskRef: "@" + testUlid("TASK"),
   176→      prompt: "Check env injection",
   177→      trigger: "task.ready",
   178→    });
   179→
   180→    // After invocation, KSPEC_SESSION_ID should be restored (or deleted)
   181→    const afterSessionId = process.env.KSPEC_SESSION_ID;
   182→    expect(afterSessionId).toBe(beforeSessionId);
   183→    expect(result.outcome).toBe("success");
   184→  });
   185→
   186→  it("should restore a pre-existing KSPEC_SESSION_ID after invocation completes", async () => {
   187→    const agent = makeTestAgent();
   188→    const preExistingId = "01EXISTNG0000000000000000";
   189→
   190→    // Simulate a pre-existing KSPEC_SESSION_ID
   191→    process.env.KSPEC_SESSION_ID = preExistingId;
   192→
   193→    await runInvocation({
   194→      agent,
   195→      specDir: testDir,
   196→      cwd: process.cwd(),
   197→      taskRef: "@" + testUlid("TASK"),
   198→      prompt: "Check env cleanup",
   199→      trigger: "task.ready",
   200→    });
   201→
   202→    // After invocation, env should be restored to the pre-existing value,
   203→    // not deleted or overwritten with the invocation session id.
   204→    expect(process.env.KSPEC_SESSION_ID).toBe(preExistingId);
   205→
   206→    // Clean up for subsequent tests
   207→    delete process.env.KSPEC_SESSION_ID;
   208→  });
   209→});
   210→
   211→// ─── AC-3: Timeout handling ───────────────────────────────────────────────────
   212→
   213→// AC: @agent-invocation-lifecycle ac-3
   214→describe("Timeout handling", () => {
   215→  let testDir: string;
   216→
   217→  beforeEach(async () => {
   218→    testDir = await createTempDir("kspec-invoc-ac3-");
   219→
   220→    // Register a slow adapter that delays response
   221→    registerAdapter("slow-mock-acp", {
   222→      command: "node",
   223→      args: [MOCK_ACP],
   224→      env: {
   225→        MOCK_ACP_DELAY_MS: "5000", // 5 second delay
   226→      },
   227→      description: "Slow mock ACP agent for timeout tests",
   228→    });
   229→  });
   230→
   231→  afterEach(async () => {
   232→    await cleanupTempDir(testDir);
   233→  });
   234→
   235→  it("should close session as timed_out when timeout is reached", async () => {
   236→    const agent = makeTestAgent({ adapter: "slow-mock-acp" });
   237→
   238→    const result = await runInvocation({
   239→      agent,
   240→      specDir: testDir,
   241→      cwd: process.cwd(),
   242→      taskRef: "@" + testUlid("TASK"),
   243→      prompt: "Test timeout",
   244→      trigger: "task.ready",
   245→      timeoutMinutes: 0.001, // ~60ms timeout — much less than 5s delay
   246→    });
   247→
   248→    expect(result.outcome).toBe("timed_out");
   249→    expect(result.session.status).toBe("timed_out");
   250→  });
   251→
   252→  it("should log agent.timeout event when timeout occurs", async () => {
   253→    const agent = makeTestAgent({ adapter: "slow-mock-acp" });
   254→
   255→    const result = await runInvocation({
   256→      agent,
   257→      specDir: testDir,
   258→      cwd: process.cwd(),
   259→      taskRef: "@" + testUlid("TASK"),
   260→      prompt: "Test timeout event logging",
   261→      trigger: "task.ready",
   262→      timeoutMinutes: 0.001,
   263→    });
   264→
   265→    // Read the events.jsonl
   266→    const eventsPath = path.join(testDir, "sessions", result.session.id, "events.jsonl");
   267→    const content = await fs.readFile(eventsPath, "utf-8");
   268→    const events = content.trim().split("\n").filter(Boolean).map((l) => JSON.parse(l));
   269→
   270→    const timeoutEvent = events.find((e: { type: string }) => e.type === "agent.timeout");
   271→    expect(timeoutEvent).toBeDefined();
   272→    expect(timeoutEvent.data.task_id).toBeDefined();
   273→    expect(timeoutEvent.data.timeout_minutes).toBeDefined();
   274→  });
   275→
   276→  it("should add a timeout note to the task when timeout occurs", async () => {
   277→    // AC: @agent-invocation-lifecycle ac-3 — timeout note written to task
   278→    const agent = makeTestAgent({ adapter: "slow-mock-acp" });
   279→    const captureFile = path.join(testDir, "kspec-calls.json");
   280→    const taskRef = "@" + testUlid("TASK");
   281→
   282→    // Set capture env so runKspecCli's spawnSync inherits it
   283→    process.env.KSPEC_CAPTURE_FILE = captureFile;
   284→    try {
   285→      await runInvocation({
   286→        agent,
   287→        specDir: testDir,
   288→        cwd: process.cwd(),
   289→        taskRef,
   290→        prompt: "Test timeout note",
   291→        trigger: "task.ready",
   292→        timeoutMinutes: 0.001,
   293→        kspecCliPath: MOCK_KSPEC_CLI,
   294→      });
   295→    } finally {
   296→      delete process.env.KSPEC_CAPTURE_FILE;
   297→    }
   298→
   299→    // Verify that kspec task note was called with the task ref and AGENT-TIMEOUT marker
   300→    const calls = JSON.parse(fsSync.readFileSync(captureFile, "utf-8")) as Array<{ args: string[] }>;
   301→    const noteCall = calls.find((c) =>
   302→      c.args.includes("task") && c.args.includes("note") && c.args.includes(taskRef)
   303→    );
   304→    expect(noteCall).toBeDefined();
   305→    const noteText = noteCall!.args[noteCall!.args.indexOf(taskRef) + 1] ?? "";
   306→    expect(noteText).toContain("[AGENT-TIMEOUT]");
   307→  });
   308→
   309→  it("should dispatch ACP cancel request on timeout", async () => {
   310→    // AC: @agent-invocation-lifecycle ac-3 — ACP cancel request dispatched on timeout
   311→    // Use a closure to track cancel calls — vi.spyOn prototype mocks don't reliably
   312→    // track ESM cross-module calls in spy.mock.calls.
   313→    let cancelCalledWith: string | undefined;
   314→    const cancelSpy = vi.spyOn(ACPClient.prototype, "cancel").mockImplementation(async (sessionId) => {
   315→      cancelCalledWith = sessionId;
   316→    });
   317→
   318→    const agent = makeTestAgent({ adapter: "slow-mock-acp" });
   319→    try {
   320→      await runInvocation({
   321→        agent,
   322→        specDir: testDir,
   323→        cwd: process.cwd(),
   324→        taskRef: "@" + testUlid("TASK"),
   325→        prompt: "Test cancel dispatch",
   326→        trigger: "task.ready",
   327→        // Use a longer timeout so the agent has time to spawn + initialize + newSession
   328→        // (the slow mock delays 5000ms only in session/prompt, not session/new)
   329→        // 3 seconds → enough for spawn+init+newSession but well under the 5s prompt delay
   330→        timeoutMinutes: 3 / 60,
   331→      });
   332→    } finally {
   333→      cancelSpy.mockRestore();
   334→    }
   335→
   336→    // Verify cancel was called with the ACP session ID — cancel request dispatched on timeout
   337→    expect(cancelCalledWith).toBeDefined();
   338→  });
   339→
   340→  it("should set ACP session/prompt timeout above invocation timeout budget", async () => {
   341→    const agent = makeTestAgent({ adapter: "slow-mock-acp" });
   342→    const mockSessionId = "mock-acp-session";
   343→    const emitter = new EventEmitter();
   344→    const timeoutMinutes = 12;
   345→
   346→    const spawnedAgent = {
   347→      client: {
   348→        on: (event: string, handler: (...args: unknown[]) => void) => {
   349→          emitter.on(event, handler);
   350→        },
   351→        newSession: vi.fn(async () => mockSessionId),
   352→        prompt: vi.fn(async () => ({ stopReason: "end_turn" })),
   353→        cancel: vi.fn(async () => undefined),
   354→        endSession: vi.fn(async () => undefined),
   355→        respondPermission: vi.fn(async () => undefined),
   356→      },
   357→      kill: vi.fn(() => undefined),
   358→    };
   359→
   360→    const spawnSpy = vi.spyOn(spawnerModule, "spawnAndInitialize").mockResolvedValue(
   361→      spawnedAgent as unknown as Awaited<ReturnType<typeof spawnerModule.spawnAndInitialize>>,
   362→    );
   363→    let spawnOptions: Parameters<typeof spawnerModule.spawnAndInitialize>[1] | undefined;
   364→
   365→    try {
   366→      await runInvocation({
   367→        agent,
   368→        specDir: testDir,
   369→        cwd: process.cwd(),
   370→        taskRef: "@" + testUlid("TASK"),
   371→        prompt: "Test ACP prompt timeout alignment",
   372→        trigger: "task.ready",
   373→        timeoutMinutes,
   374→      });
   375→      spawnOptions = spawnSpy.mock.calls[0]?.[1];
   376→    } finally {
   377→      spawnSpy.mockRestore();
   378→    }
   379→
   380→    expect(spawnOptions).toBeDefined();
   381→    expect(spawnOptions.clientOptions?.methodTimeouts?.["session/prompt"]).toBe(
   382→      timeoutMinutes * 60 * 1000 + 5_000,
   383→    );
   384→  });
   385→});
