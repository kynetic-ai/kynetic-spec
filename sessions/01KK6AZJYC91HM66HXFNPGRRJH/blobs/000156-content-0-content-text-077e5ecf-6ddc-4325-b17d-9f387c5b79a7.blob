  1037→// ─── AC-9: Retry threshold and task blocking ──────────────────────────────────
  1038→
  1039→// AC: @agent-invocation-lifecycle ac-9
  1040→describe("Consecutive failure threshold and task blocking", () => {
  1041→  let testDir: string;
  1042→
  1043→  beforeEach(async () => {
  1044→    testDir = await createTempDir("kspec-invoc-ac9-");
  1045→    registerAdapter("always-fail-acp", {
  1046→      command: "node",
  1047→      args: [MOCK_ACP],
  1048→      env: { MOCK_ACP_EXIT_CODE: "1" },
  1049→      description: "Always-failing adapter for retry threshold tests",
  1050→    });
  1051→  });
  1052→
  1053→  afterEach(async () => {
  1054→    await cleanupTempDir(testDir);
  1055→  });
  1056→
  1057→  it("should block the task with a failure note when consecutive failures reach retry limit", async () => {
  1058→    // AC: @agent-invocation-lifecycle ac-9 — consecutive failures → task blocked with note
  1059→    // The agent's retry limit is derived from agent.budget.max_retries (default 3).
  1060→    // We pre-populate the capture file to simulate prior failure notes already recorded
  1061→    // by previous invocations, then trigger the threshold-crossing invocation.
  1062→    const captureFile = path.join(testDir, "kspec-calls.json");
  1063→    const taskRef = "@" + testUlid("TASK");
  1064→
  1065→    // Mock kspec CLI: simulate "task get" returning a task with 3 existing AGENT-FAIL notes.
  1066→    // The implementation calls getConsecutiveFailureCount (kspec task get --json) to read
  1067→    // the note history. With 3 consecutive AGENT-FAIL notes and a retry limit of 3, blocking
  1068→    // must be triggered.
  1069→    const taskGetMockPath = path.join(testDir, "kspec-threshold-mock.cjs");
  1070→    const mockTask = {
  1071→      notes: [
  1072→        { content: "[AGENT-FAIL] Invocation failed: Mock failure" },
  1073→        { content: "[AGENT-FAIL] Invocation failed: Mock failure" },
  1074→        { content: "[AGENT-FAIL] Invocation failed: Mock failure" },
  1075→      ],
  1076→    };
  1077→    await fs.writeFile(taskGetMockPath, `#!/usr/bin/env node
  1078→'use strict';
  1079→const fs = require('node:fs');
  1080→const args = process.argv.slice(2);
  1081→const captureFile = process.env.KSPEC_CAPTURE_FILE;
  1082→
  1083→if (captureFile) {
  1084→  let calls = [];
  1085→  try { calls = JSON.parse(fs.readFileSync(captureFile, 'utf-8')); } catch {}
  1086→  calls.push({ args, timestamp: Date.now() });
  1087→  fs.writeFileSync(captureFile, JSON.stringify(calls, null, 2));
  1088→}
  1089→
  1090→// Return task JSON for "task get ... --json" to simulate 3 consecutive prior failures
  1091→if (args.includes('task') && args.includes('get') && args.includes('--json')) {
  1092→  process.stdout.write(JSON.stringify(${JSON.stringify(mockTask)}) + '\\n');
  1093→}
  1094→
  1095→process.exit(0);
  1096→`);
  1097→
  1098→    process.env.KSPEC_CAPTURE_FILE = captureFile;
  1099→    try {
  1100→      const agent = makeTestAgent({
  1101→        adapter: "always-fail-acp",
  1102→        budget: { max_retries: 3, timeout_minutes: 30 },
  1103→      } as Partial<Agent>);
  1104→
  1105→      await runInvocation({
  1106→        agent,
  1107→        specDir: testDir,
  1108→        cwd: process.cwd(),
  1109→        taskRef,
  1110→        prompt: "Test consecutive failure blocking",
  1111→        trigger: "task.ready",
  1112→        kspecCliPath: taskGetMockPath,
