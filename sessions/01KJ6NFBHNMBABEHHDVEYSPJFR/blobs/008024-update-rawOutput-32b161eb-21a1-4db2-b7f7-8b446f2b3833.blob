     1→import chalk from "chalk";
     2→import { Command } from "commander";
     3→import {
     4→  type AssessmentSummary,
     5→  assessTask,
     6→  computeAutoModeChanges,
     7→  computeSummary,
     8→  createNote,
     9→  filterTasksForAssessment,
    10→  getReadyTasks,
    11→  initContext,
    12→  loadAllItems,
    13→  loadAllTasks,
    14→  ReferenceIndex,
    15→  saveTask,
    16→  type TaskAssessment,
    17→} from "../../parser/index.js";
    18→import { commitIfShadow } from "../../parser/shadow.js";
    19→import { errors } from "../../strings/index.js";
    20→import { grepItem } from "../../utils/grep.js";
    21→import { EXIT_CODES } from "../exit-codes.js";
    22→import {
    23→  error,
    24→  formatTaskList,
    25→  formatTaskListWithAutomation,
    26→  info,
    27→  output,
    28→  success,
    29→} from "../output.js";
    30→import { findClosestCommand } from "../suggest.js";
    31→import {
    32→  normalizeRefInput,
    33→  TaskStatusSchema,
    34→} from "../../schema/common.js";
    35→
    36→/** List options shared between tasks list subcommand and default action */
    37→interface ListTasksOptions {
    38→  status?: string | string[];
    39→  type?: string;
    40→  tag?: string;
    41→  metaRef?: string;
    42→  grep?: string;
    43→  verbose?: boolean;
    44→  full?: boolean;
    45→  count?: boolean;
    46→}
    47→
    48→/**
    49→ * Parse multi-value status filter: supports comma-separated and repeated flags.
    50→ * AC: @multi-value-status-filter ac-comma-separated, ac-repeated-flag, ac-trailing-comma
    51→ */
    52→export function parseMultiStatus<T extends string>(
    53→  input: string | string[] | undefined,
    54→  validValues: readonly T[],
    55→  typeName: string,
    56→): T[] | null {
    57→  if (!input) return null;
    58→
    59→  // Normalize: repeated flags produce string[], single flag produces string
    60→  const raw = Array.isArray(input) ? input : [input];
    61→
    62→  // Split on commas, trim whitespace, filter empty strings
    63→  // AC: @multi-value-status-filter ac-trailing-comma
    64→  const values = raw
    65→    .flatMap((v) => v.split(","))
    66→    .map((v) => v.trim())
    67→    .filter((v) => v.length > 0);
    68→
    69→  if (values.length === 0) return null;
    70→
    71→  // Validate each value
    72→  // AC: @multi-value-status-filter ac-invalid-task-status, ac-invalid-item-status
    73→  for (const v of values) {
    74→    if (!(validValues as readonly string[]).includes(v)) {
    75→      error(`Invalid ${typeName}: ${v}. Must be one of: ${validValues.join(", ")}`);
    76→      process.exit(EXIT_CODES.ERROR);
    77→    }
    78→  }
    79→
    80→  return values as T[];
    81→}
    82→
    83→/**
    84→ * Shared task list logic used by both 'tasks list' and 'task list' subcommands,
    85→ * and as the default action when no subcommand is given.
    86→ * AC: @command-group-default-actions ac-bare-tasks, ac-bare-task, ac-bare-with-options
    87→ */
    88→export async function listTasksAction(options: ListTasksOptions): Promise<void> {
    89→  try {
    90→    const ctx = await initContext();
    91→    const allTasks = await loadAllTasks(ctx);
    92→    const items = await loadAllItems(ctx);
    93→
    94→    // Load meta items if filtering by meta-ref
    95→    const { loadMetaContext } = await import("../../parser/meta.js");
    96→    const metaContext = await loadMetaContext(ctx);
    97→    const allMetaItems = [
    98→      ...metaContext.agents,
    99→      ...metaContext.workflows,
   100→      ...metaContext.conventions,
   101→      ...metaContext.observations,
   102→    ];
   103→
   104→    const index = new ReferenceIndex(allTasks, items, allMetaItems);
   105→
   106→    let taskList = allTasks;
   107→
   108→    // Apply filters
   109→    // AC: @multi-value-status-filter ac-comma-separated, ac-repeated-flag, ac-single-value-unchanged
   110→    if (options.status) {
   111→      const statuses = parseMultiStatus(
   112→        options.status,
   113→        TaskStatusSchema.options,
   114→        "task status",
   115→      );
   116→      if (statuses) {
   117→        taskList = taskList.filter((t) => statuses.includes(t.status as any));
   118→      }
   119→    }
   120→    if (options.type) {
   121→      taskList = taskList.filter((t) => t.type === options.type);
   122→    }
   123→    if (options.tag) {
   124→      const tag = options.tag;
   125→      taskList = taskList.filter((t) => t.tags.includes(tag));
   126→    }
   127→    if (options.metaRef) {
   128→      // AC-meta-ref-2: Filter tasks by meta_ref
   129→      const metaRefResult = index.resolve(options.metaRef);
   130→      if (!metaRefResult.ok) {
   131→        error(errors.reference.metaRefNotFound(options.metaRef));
   132→        process.exit(EXIT_CODES.NOT_FOUND);
   133→      }
   134→      const targetRef = normalizeRefInput(options.metaRef);
   135→      taskList = taskList.filter(
   136→        (t) => t.meta_ref === targetRef || t.meta_ref === options.metaRef,
   137→      );
   138→    }
   139→    if (options.grep) {
   140→      const pattern = options.grep;
   141→      taskList = taskList.filter((t) => {
   142→        const match = grepItem(
   143→          t as unknown as Record<string, unknown>,
   144→          pattern,
   145→        );
   146→        return match !== null;
   147→      });
   148→    }
   149→
   150→    // AC: @trait-filterable-list ac-8
   151→    if (options.count) {
   152→      output({ count: taskList.length }, () => {
   153→        console.log(taskList.length);
   154→      });
   155→      return;
   156→    }
   157→
   158→    output(taskList, () =>
   159→      formatTaskList(
   160→        taskList,
   161→        options.verbose,
   162→        index,
   163→        options.grep,
   164→        options.full,
   165→      ),
   166→    );
   167→  } catch (err) {
   168→    error(errors.failures.listTasks, err);
   169→    process.exit(EXIT_CODES.ERROR);
   170→  }
   171→}
   172→
   173→/** Add list filter options to a command */
   174→export function addListOptions(cmd: Command): Command {
   175→  return cmd
   176→    .option("-s, --status <status>", "Filter by status")
   177→    .option("-t, --type <type>", "Filter by type")
   178→    .option("--tag <tag>", "Filter by tag")
   179→    .option("--meta-ref <ref>", "Filter by meta reference")
   180→    .option("-g, --grep <pattern>", "Search content with regex pattern")
   181→    .option("-v, --verbose", "Show more details")
   182→    .option("--full", "Show full details (notes, todos, timestamps)")
   183→    .option("--count", "Show only the count of matching tasks");
   184→}
   185→
   186→/**
   187→ * Register the 'tasks' command group
   188→ */
   189→export function registerTasksCommands(program: Command): void {
   190→  const tasks = program.command("tasks").description("Query and list tasks")
   191→    .allowUnknownOption()
   192→    .allowExcessArguments();
   193→
   194→  // AC: @command-group-default-actions ac-bare-tasks, ac-bare-with-options, ac-unknown-subcommand
   195→  // Default action when no subcommand is given (e.g. `kspec tasks` or `kspec tasks --status pending`)
   196→  tasks.action(async (_options: Record<string, unknown>, cmd: Command) => {
   197→    // Re-parse remaining args to extract list options.
   198→    // Commander passes all unrecognized tokens (options + excess args) via cmd.args.
   199→    const listCmd = addListOptions(new Command("_list"));
   200→    listCmd.exitOverride();
   201→    try {
   202→      listCmd.parse(cmd.args, { from: "user" });
   203→    } catch {
   204→      // Parse error — likely unknown option. Show help.
   205→      console.error(chalk.gray(`Run 'kspec tasks --help' to see available subcommands`));
   206→      process.exit(EXIT_CODES.ERROR);
   207→    }
   208→
   209→    // AC: @command-group-default-actions ac-unknown-subcommand
   210→    // After parsing known options, any remaining positional args are unknown subcommands.
   211→    if (listCmd.args.length > 0) {
   212→      const unknownCmd = listCmd.args[0];
   213→      const subcommandNames = cmd.commands.map((c: Command) => c.name());
   214→      const suggestion = findClosestCommand(unknownCmd, subcommandNames);
   215→      console.error(chalk.red(`error: unknown command 'tasks ${unknownCmd}'`));
   216→      if (suggestion) {
   217→        console.error(chalk.yellow(`Did you mean: kspec tasks ${suggestion}?`));
   218→      } else {
   219→        console.error(chalk.gray(`Run 'kspec tasks --help' to see available subcommands`));
   220→      }
   221→      process.exit(EXIT_CODES.ERROR);
   222→    }
   223→
   224→    // AC: @command-group-default-actions ac-bare-with-options
   225→    await listTasksAction(listCmd.opts() as ListTasksOptions);
   226→  });
   227→
   228→  // kspec tasks list
   229→  addListOptions(tasks.command("list").description("List all tasks"))
   230→    .action(async (options: ListTasksOptions) => {
   231→      await listTasksAction(options);
   232→    });
   233→
   234→  // kspec tasks ready
   235→  // AC: @task-automation-eligibility ac-14, ac-19, ac-20, ac-24
   236→  tasks
   237→    .command("ready")
   238→    .description("List tasks that are ready to work on")
   239→    .option("-v, --verbose", "Show more details")
   240→    .option("--full", "Show full details (notes, todos, timestamps)")
   241→    .option("--eligible", "Show only tasks with automation: eligible")
   242→    .option("--unassessed", "Show only tasks without automation status")
   243→    .option("--needs-review", "Show only tasks with automation: needs_review")
   244→    .action(async (options) => {
   245→      try {
   246→        const ctx = await initContext();
   247→        const allTasks = await loadAllTasks(ctx);
   248→        const items = await loadAllItems(ctx);
   249→        const index = new ReferenceIndex(allTasks, items);
   250→        let readyTasks = getReadyTasks(allTasks);
   251→
   252→        // AC: @task-automation-eligibility ac-19 - filter by --eligible
   253→        if (options.eligible) {
   254→          readyTasks = readyTasks.filter((t) => t.automation === "eligible");
   255→        }
   256→
   257→        // AC: @task-automation-eligibility ac-20 - filter by --unassessed
   258→        if (options.unassessed) {
   259→          readyTasks = readyTasks.filter((t) => !t.automation);
   260→        }
   261→
   262→        // AC: @task-automation-eligibility ac-24 - filter by --needs-review
   263→        if (options.needsReview) {
   264→          readyTasks = readyTasks.filter(
   265→            (t) => t.automation === "needs_review",
   266→          );
   267→        }
   268→
   269→        output(readyTasks, () => {
   270→          if (readyTasks.length === 0) {
   271→            if (options.eligible) {
   272→              info(
   273→                "No eligible tasks ready - no tasks with automation: eligible",
   274→              );
   275→            } else if (options.unassessed) {
   276→              info("No unassessed tasks ready");
   277→            } else if (options.needsReview) {
   278→              info("No tasks need review");
   279→            } else {
   280→              info(
   281→                "No tasks ready - all pending tasks are blocked or have unmet dependencies",
   282→              );
   283→            }
   284→          } else {
   285→            // AC: @task-automation-eligibility ac-14 - formatTaskListWithAutomation shows automation status
   286→            formatTaskListWithAutomation(
   287→              readyTasks,
   288→              options.verbose,
   289→              index,
   290→              undefined,
   291→              options.full,
   292→            );
   293→          }
   294→        });
   295→      } catch (err) {
   296→        error(errors.failures.getReadyTasks, err);
   297→        process.exit(EXIT_CODES.ERROR);
   298→      }
   299→    });
   300→
   301→  // kspec tasks next
   302→  tasks
   303→    .command("next")
   304→    .description("Show the highest-priority ready task")
   305→    .action(async () => {
   306→      try {
   307→        const ctx = await initContext();
   308→        const allTasks = await loadAllTasks(ctx);
   309→        const items = await loadAllItems(ctx);
   310→        const index = new ReferenceIndex(allTasks, items);
   311→        const readyTasks = getReadyTasks(allTasks);
   312→
   313→        if (readyTasks.length === 0) {
   314→          output(null, () => info("No tasks ready"));
   315→        } else {
   316→          const next = readyTasks[0];
   317→          output(next, () => {
   318→            console.log(`${index.shortUlid(next._ulid)} ${next.title}`);
   319→          });
   320→        }
   321→      } catch (err) {
   322→        error(errors.failures.getNextTask, err);
   323→        process.exit(EXIT_CODES.ERROR);
   324→      }
   325→    });
   326→
   327→  // kspec tasks blocked
   328→  tasks
   329→    .command("blocked")
   330→    .description("Show blocked tasks")
   331→    .option("-v, --verbose", "Show more details")
   332→    .option("--full", "Show full details (notes, todos, timestamps)")
   333→    .action(async (options) => {
   334→      try {
   335→        const ctx = await initContext();
   336→        const allTasks = await loadAllTasks(ctx);
   337→        const items = await loadAllItems(ctx);
   338→        const index = new ReferenceIndex(allTasks, items);
   339→        const blockedTasks = allTasks.filter((t) => t.status === "blocked");
   340→
   341→        output(blockedTasks, () =>
   342→          formatTaskList(
   343→            blockedTasks,
   344→            options.verbose,
   345→            index,
   346→            undefined,
   347→            options.full,
   348→          ),
   349→        );
   350→      } catch (err) {
   351→        error(errors.failures.getBlockedTasks, err);
   352→        process.exit(EXIT_CODES.ERROR);
   353→      }
   354→    });
   355→
   356→  // kspec tasks in-progress
   357→  tasks
   358→    .command("in-progress")
   359→    .alias("active")
   360→    .description("Show tasks in progress")
   361→    .option("-v, --verbose", "Show more details")
   362→    .option("--full", "Show full details (notes, todos, timestamps)")
   363→    .action(async (options) => {
   364→      try {
   365→        const ctx = await initContext();
   366→        const allTasks = await loadAllTasks(ctx);
   367→        const items = await loadAllItems(ctx);
   368→        const index = new ReferenceIndex(allTasks, items);
   369→        const activeTasks = allTasks.filter(
   370→          (t) => t.status === "in_progress" || t.status === "needs_work",
   371→        );
   372→
   373→        output(activeTasks, () =>
   374→          formatTaskList(
   375→            activeTasks,
   376→            options.verbose,
   377→            index,
   378→            undefined,
   379→            options.full,
   380→          ),
   381→        );
   382→      } catch (err) {
   383→        error(errors.failures.getActiveTasks, err);
   384→        process.exit(EXIT_CODES.ERROR);
   385→      }
   386→    });
   387→
   388→  // kspec tasks assess - assess command group
   389→  // AC: @tasks-assess-automation
   390→  const assess = tasks
   391→    .command("assess")
   392→    .description("Assess tasks for various criteria");
   393→
   394→  // kspec tasks assess automation [taskRef]
   395→  // AC: @tasks-assess-automation ac-1 through ac-28
   396→  assess
   397→    .command("automation [taskRef]")
   398→    .description("Assess task automation eligibility based on criteria")
   399→    .option("--all", "Include already-assessed tasks")
   400→    .option(
   401→      "--auto",
   402→      "Auto-mark obvious cases (spikes -> manual_only, missing criteria -> needs_review)",
   403→    )
   404→    .option("--dry-run", "Show what would change without modifying tasks")
   405→    .action(async (taskRef: string | undefined, options) => {
   406→      try {
   407→        const ctx = await initContext();
   408→        const allTasks = await loadAllTasks(ctx);
   409→        const items = await loadAllItems(ctx);
   410→        const index = new ReferenceIndex(allTasks, items);
   411→
   412→        // AC: @tasks-assess-automation ac-6, ac-7 - Single task assessment
   413→        if (taskRef) {
   414→          const resolved = index.resolve(taskRef);
   415→          if (!resolved.ok) {
   416→            error(`Task not found: ${taskRef}`);
   417→            process.exit(EXIT_CODES.NOT_FOUND);
   418→          }
   419→        }
   420→
   421→        // AC: @tasks-assess-automation ac-1, ac-2, ac-27, ac-28 - Filter tasks
   422→        const tasksToAssess = filterTasksForAssessment(
   423→          allTasks,
   424→          { all: options.all, taskRef },
   425→          index,
   426→        );
   427→
   428→        // AC: @tasks-assess-automation ac-26 - No unassessed tasks
   429→        if (tasksToAssess.length === 0) {
   430→          output(
   431→            {
   432→              tasks: [],
   433→              summary: {
   434→                review_for_eligible: 0,
   435→                needs_review: 0,
   436→                manual_only: 0,
   437→                total: 0,
   438→              },
   439→            },
   440→            () => {
   441→              if (taskRef) {
   442→                info(
   443→                  `Task ${taskRef} is not pending or already assessed (use --all to include)`,
   444→                );
   445→              } else {
   446→                info("No unassessed pending tasks");
   447→              }
   448→            },
   449→          );
   450→          return;
   451→        }
   452→
   453→        // Assess each task
   454→        // AC: @tasks-assess-automation ac-3, ac-4, ac-8-16
   455→        const assessments: TaskAssessment[] = tasksToAssess.map((task) =>
   456→          assessTask(task, index, items),
   457→        );
   458→
   459→        // AC: @tasks-assess-automation ac-5, ac-25 - Compute summary
   460→        const summary = computeSummary(assessments);
   461→
   462→        // Handle auto mode
   463→        // AC: @tasks-assess-automation ac-17-21
   464→        if (options.auto) {
   465→          const changes = computeAutoModeChanges(assessments);
   466→          const actualChanges = changes.filter((c) => c.action !== "no_change");
   467→
   468→          // AC: @tasks-assess-automation ac-22, ac-23 - Dry run
   469→          if (options.dryRun) {
   470→            output({ assessments, summary, changes, dryRun: true }, () => {
   471→              formatAssessmentOutput(assessments, summary, index);
   472→              console.log("");
   473→              console.log(chalk.yellow("Dry run - would make these changes:"));
   474→              for (const change of actualChanges) {
   475→                console.log(
   476→                  `  ${change.taskRef}: set automation=${change.newStatus} (${change.reason})`,
   477→                );
   478→              }
   479→              if (actualChanges.length === 0) {
   480→                console.log(
   481→                  "  (no changes - all tasks need agent/human review)",
   482→                );
   483→              }
   484→            });
   485→            return;
   486→          }
   487→
   488→          // Apply changes
   489→          // AC: @tasks-assess-automation ac-17, ac-19, ac-20
   490→          let changeCount = 0;
   491→          for (const change of actualChanges) {
   492→            const task = allTasks.find((t) => t._ulid === change.taskUlid);
   493→            if (!task) continue;
   494→
   495→            // Set automation status
   496→            task.automation = change.newStatus;
   497→
   498→            // AC: @tasks-assess-automation ac-19, ac-20 - Add note explaining assessment
   499→            const noteContent = `Automation assessment: set to ${change.newStatus}. ${change.reason}`;
   500→            const note = createNote(noteContent, "@automation-assess");
   501→            task.notes = [...task.notes, note];
   502→
   503→            await saveTask(ctx, task);
   504→            changeCount++;
   505→          }
   506→
   507→          if (changeCount > 0) {
   508→            await commitIfShadow(
   509→              ctx.shadow,
   510→              "tasks-assess",
   511→              "automation",
   512→              `${changeCount} task(s)`,
   513→            );
   514→          }
   515→
   516→          output({ assessments, summary, changes, applied: true }, () => {
   517→            formatAssessmentOutput(assessments, summary, index);
   518→            console.log("");
   519→            if (changeCount > 0) {
   520→              success(`Applied ${changeCount} change(s)`);
   521→            } else {
   522→              info(
   523→                "No changes applied - all tasks need agent/human review to mark eligible",
   524→              );
   525→            }
   526→          });
   527→          return;
   528→        }
   529→
   530→        // Default: just show assessment output
   531→        // AC: @tasks-assess-automation ac-24, ac-25 - JSON output handled by output()
   532→        output({ assessments, summary }, () => {
   533→          formatAssessmentOutput(assessments, summary, index);
   534→        });
   535→      } catch (err) {
   536→        error("Failed to assess tasks", err);
   537→        process.exit(EXIT_CODES.ERROR);
   538→      }
   539→    });
   540→}
   541→
   542→/**
   543→ * Format assessment output for human-readable display
   544→ * AC: @tasks-assess-automation ac-3, ac-4, ac-5
   545→ */
   546→function formatAssessmentOutput(
   547→  assessments: TaskAssessment[],
   548→  summary: AssessmentSummary,
   549→  _index: ReferenceIndex,
   550→): void {
   551→  for (const assessment of assessments) {
   552→    // Task header
   553→    console.log(`${assessment.taskRef}  "${assessment.taskTitle}"`);
   554→
   555→    // Criteria results
   556→    // AC: @tasks-assess-automation ac-3
   557→    const specRefResult = assessment.criteria.has_spec_ref;
   558→    const specRefIcon = specRefResult.pass ? chalk.green("✓") : chalk.red("✗");
   559→    const specRefDetail = specRefResult.pass
   560→      ? specRefResult.spec_ref
   561→      : specRefResult.detail || "missing";
   562→    console.log(`  spec_ref:     ${specRefIcon} ${specRefDetail}`);
   563→
   564→    const acsResult = assessment.criteria.spec_has_acs;
   565→    const acsIcon = acsResult.skipped
   566→      ? chalk.gray("-")
   567→      : acsResult.pass
   568→        ? chalk.green("✓")
   569→        : chalk.red("✗");
   570→    const acsDetail = acsResult.skipped
   571→      ? `(${acsResult.detail})`
   572→      : acsResult.pass
   573→        ? `${acsResult.ac_count} acceptance criteria`
   574→        : acsResult.detail || "no ACs";
   575→    console.log(`  has_acs:      ${acsIcon} ${acsDetail}`);
   576→
   577→    const spikeResult = assessment.criteria.not_spike;
   578→    const spikeIcon = spikeResult.pass ? chalk.green("✓") : chalk.red("✗");
   579→    console.log(`  not_spike:    ${spikeIcon} ${spikeResult.detail}`);
   580→
   581→    // Recommendation
   582→    // AC: @tasks-assess-automation ac-4
   583→    const recColor =
   584→      assessment.recommendation === "review_for_eligible"
   585→        ? chalk.cyan
   586→        : assessment.recommendation === "needs_review"
   587→          ? chalk.yellow
   588→          : chalk.red;
   589→    console.log(
   590→      `  → ${recColor(assessment.recommendation)} (${assessment.reason})`,
   591→    );
   592→    console.log("");
   593→  }
   594→
   595→  // Summary
   596→  // AC: @tasks-assess-automation ac-5
   597→  console.log(chalk.bold("Summary:"));
   598→  console.log(`  review_for_eligible: ${summary.review_for_eligible}`);
   599→  console.log(`  needs_review: ${summary.needs_review}`);
