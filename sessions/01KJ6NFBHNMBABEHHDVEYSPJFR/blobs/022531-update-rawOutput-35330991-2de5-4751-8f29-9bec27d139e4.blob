   200→ */
   201→export function info(message: string): void {
   202→  if (isStructuredMode()) {
   203→    // Route info to stderr in structured output modes to keep stdout pure
   204→    console.error(chalk.blue("ℹ"), message);
   205→  } else {
   206→    console.log(chalk.blue("ℹ"), message);
   207→  }
   208→}
   209→
   210→/**
   211→ * Get color for task status
   212→ */
   213→function statusColor(status: TaskStatus): (text: string) => string {
   214→  switch (status) {
   215→    case "pending":
   216→      return (t: string) => chalk.gray(t);
   217→    case "in_progress":
   218→      return (t: string) => chalk.blue(t);
   219→    case "blocked":
   220→      return (t: string) => chalk.red(t);
   221→    case "completed":
   222→      return (t: string) => chalk.green(t);
   223→    case "cancelled":
   224→      return (t: string) => chalk.strikethrough.gray(t);
   225→    default:
   226→      return (t: string) => chalk.white(t);
   227→  }
   228→}
   229→
   230→/**
   231→ * Format a task reference (short ULID + slug if available)
   232→ * @param task The task to format
   233→ * @param index Optional ReferenceIndex for dynamic short ULID computation
   234→ */
   235→export function formatTaskRef(task: Task, index?: ReferenceIndex): string {
   236→  const shortId = index ? index.shortUlid(task._ulid) : task._ulid.slice(0, 8);
   237→  if (task.slugs.length > 0) {
   238→    return `${shortId} (${task.slugs[0]})`;
   239→  }
   240→  return shortId;
   241→}
   242→
   243→/**
   244→ * Format task for display
   245→ */
   246→export function formatTask(
   247→  task: Task,
   248→  verbose = false,
   249→  index?: ReferenceIndex,
   250→  full = false,
   251→): string {
   252→  const ref = formatTaskRef(task, index);
   253→  const status = statusColor(task.status)(`[${task.status}]`);
   254→  const priority =
   255→    task.priority <= 2
   256→      ? chalk.red(`P${task.priority}`)
   257→      : chalk.gray(`P${task.priority}`);
   258→
   259→  // AC: @session-scoped-task-claiming ac-display
   260→  const sessionLabel = task.session_id
   261→    ? chalk.yellow(`[session ${task.session_id.slice(0, 8)}...]`)
   262→    : "";
   263→
   264→  let line = `${ref} ${status} ${priority}${sessionLabel ? ` ${sessionLabel}` : ""} ${task.title}`;
   265→
   266→  if (verbose && !full) {
   267→    // AC: @task-list-verbose ac-2 - Single verbose (-v) shows current behavior
   268→    if (task.spec_ref) {
   269→      line += chalk.gray(` (spec: ${task.spec_ref})`);
   270→    }
   271→    if (task.depends_on.length > 0) {
   272→      line += chalk.gray(` deps: [${task.depends_on.join(", ")}]`);
   273→    }
   274→    if (task.tags.length > 0) {
   275→      line += chalk.cyan(` #${task.tags.join(" #")}`);
   276→    }
   277→  }
   278→
   279→  return line;
   280→}
   281→
   282→/**
   283→ * Get first line of text, truncated to max length
   284→ */
   285→function getFirstLine(
   286→  text: string | undefined,
   287→  maxLength: number = 70,
   288→): string | undefined {
   289→  if (!text) return undefined;
   290→  const firstLine = text.split("\n")[0].trim();
   291→  if (firstLine.length <= maxLength) return firstLine;
   292→  return `${firstLine.slice(0, maxLength - 3)}...`;
   293→}
   294→
   295→/**
   296→ * Format full mode context for a task (AC-1, AC-3, AC-5)
   297→ */
   298→function formatFullModeContext(task: Task, index?: ReferenceIndex): void {
   299→  const indent = "    ";
   300→
   301→  // Show timestamps (AC-1)
   302→  console.log(chalk.gray(`${indent}Created: ${task.created_at}`));
   303→  if (task.started_at) {
   304→    console.log(chalk.gray(`${indent}Started: ${task.started_at}`));
   305→  }
   306→  if (task.completed_at) {
   307→    console.log(chalk.gray(`${indent}Completed: ${task.completed_at}`));
   308→  }
   309→
   310→  // Show notes count and most recent note (AC-1, AC-3)
   311→  if (task.notes && task.notes.length > 0) {
   312→    const mostRecent = task.notes[task.notes.length - 1];
   313→    const preview = getFirstLine(mostRecent.content, 50);
   314→    console.log(
   315→      chalk.gray(`${indent}Notes: ${task.notes.length} (latest: "${preview}")`),
   316→    );
   317→  }
   318→
   319→  // Show pending todos count (AC-1, AC-3)
   320→  if (task.todos && task.todos.length > 0) {
   321→    const pendingCount = task.todos.filter((t) => !t.done).length;
   322→    if (pendingCount > 0) {
   323→      console.log(chalk.gray(`${indent}Pending todos: ${pendingCount}`));
   324→    }
   325→  }
   326→
   327→  // Show spec context (AC-5)
   328→  if (task.spec_ref && index) {
   329→    const result = index.resolve(task.spec_ref);
   330→    if (result.ok) {
   331→      const spec = result.item;
   332→      const specName =
   333→        "title" in spec
   334→          ? spec.title
   335→          : "name" in spec
   336→            ? spec.name
   337→            : "id" in spec
   338→              ? spec.id
   339→              : task.spec_ref;
   340→      console.log(chalk.gray(`${indent}Spec: ${task.spec_ref}`));
   341→      console.log(chalk.cyan(`${indent}  ${specName}`));
   342→
   343→      // Show spec description if available
   344→      if ("description" in spec && spec.description) {
   345→        const descPreview = getFirstLine(spec.description as string, 70);
   346→        console.log(chalk.gray(`${indent}  ${descPreview}`));
   347→      }
   348→
   349→      // Show acceptance criteria if available
   350→      if (
   351→        "acceptance_criteria" in spec &&
   352→        Array.isArray(spec.acceptance_criteria)
   353→      ) {
   354→        const ac = spec.acceptance_criteria;
   355→        if (ac.length > 0) {
   356→          console.log(
   357→            chalk.gray(`${indent}  Acceptance Criteria: ${ac.length}`),
   358→          );
   359→          // Show first AC as preview
   360→          const firstAC = ac[0];
   361→          if (
   362→            typeof firstAC === "object" &&
   363→            firstAC !== null &&
   364→            "id" in firstAC
   365→          ) {
   366→            console.log(
   367→              chalk.gray(`${indent}    [${firstAC.id}] ${firstAC.then}`),
   368→            );
   369→          }
   370→        }
   371→      }
   372→    }
   373→  }
   374→
   375→  // Show tags and dependencies if present
   376→  if (task.tags && task.tags.length > 0) {
   377→    console.log(chalk.gray(`${indent}Tags: ${task.tags.join(", ")}`));
   378→  }
   379→  if (task.depends_on && task.depends_on.length > 0) {
   380→    console.log(
   381→      chalk.gray(`${indent}Depends on: ${task.depends_on.join(", ")}`),
   382→    );
   383→  }
   384→}
   385→
   386→/**
   387→ * Format automation status as a colored label
   388→ * AC: @task-automation-eligibility ac-14
   389→ */
   390→function formatAutomationStatus(automation: string | undefined): string {
   391→  if (!automation) {
   392→    return chalk.gray("[unassessed]");
   393→  }
   394→  switch (automation) {
   395→    case "eligible":
   396→      return chalk.green("[eligible]");
   397→    case "needs_review":
   398→      return chalk.yellow("[needs_review]");
   399→    case "manual_only":
   400→      return chalk.red("[manual_only]");
   401→    default:
   402→      return chalk.gray(`[${automation}]`);
   403→  }
   404→}
   405→
   406→/**
   407→ * Format a list of tasks with automation status
   408→ * AC: @task-automation-eligibility ac-14
   409→ */
   410→export function formatTaskListWithAutomation(
   411→  tasks: Task[],
   412→  verbose = false,
   413→  index?: ReferenceIndex,
   414→  grepPattern?: string,
   415→  full = false,
   416→): void {
   417→  if (tasks.length === 0) {
   418→    console.log(summaries.noTasks);
   419→    return;
   420→  }
   421→
   422→  for (const task of tasks) {
   423→    const ref = formatTaskRef(task, index);
   424→    const status = statusColor(task.status)(`[${task.status}]`);
   425→    const priority =
   426→      task.priority <= 2
   427→        ? chalk.red(`P${task.priority}`)
   428→        : chalk.gray(`P${task.priority}`);
   429→    const automationLabel = formatAutomationStatus(task.automation);
   430→    // AC: @session-scoped-task-claiming ac-display
   431→    const sessionLabel = task.session_id
   432→      ? chalk.yellow(`[session ${task.session_id.slice(0, 8)}...]`)
   433→      : "";
   434→
   435→    let line = `${ref} ${status} ${priority} ${automationLabel}${sessionLabel ? ` ${sessionLabel}` : ""} ${task.title}`;
   436→
   437→    if (verbose && !full) {
   438→      if (task.spec_ref) {
   439→        line += chalk.gray(` (spec: ${task.spec_ref})`);
   440→      }
   441→      if (task.depends_on.length > 0) {
   442→        line += chalk.gray(` deps: [${task.depends_on.join(", ")}]`);
   443→      }
   444→      if (task.tags.length > 0) {
   445→        line += chalk.cyan(` #${task.tags.join(" #")}`);
   446→      }
   447→    }
   448→
   449→    console.log(line);
   450→
   451→    // Show matched fields if grep pattern provided
   452→    if (grepPattern) {
   453→      const match = grepItem(
   454→        task as unknown as Record<string, unknown>,
   455→        grepPattern,
   456→      );
   457→      if (match && match.matchedFields.length > 0) {
   458→        console.log(
   459→          chalk.gray(
   460→            `    matched: ${formatMatchedFields(match.matchedFields)}`,
   461→          ),
   462→        );
   463→      }
   464→    } else if (full) {
   465→      formatFullModeContext(task, index);
   466→    } else {
   467→      // Show context line: first line of description (if present)
   468→      const context = getFirstLine(task.description);
   469→      if (context) {
   470→        console.log(chalk.gray(`    ${context}`));
   471→      }
   472→    }
   473→  }
   474→
   475→  console.log(summaries.taskCount(tasks.length));
   476→}
   477→
   478→/**
   479→ * Format a list of tasks
   480→ */
   481→export function formatTaskList(
   482→  tasks: Task[],
   483→  verbose = false,
   484→  index?: ReferenceIndex,
   485→  grepPattern?: string,
   486→  full = false,
   487→): void {
   488→  if (tasks.length === 0) {
   489→    console.log(summaries.noTasks);
   490→    return;
   491→  }
   492→
   493→  for (const task of tasks) {
   494→    console.log(formatTask(task, verbose, index, full));
   495→
   496→    // Show matched fields if grep pattern provided
   497→    if (grepPattern) {
   498→      const match = grepItem(
   499→        task as unknown as Record<string, unknown>,
   500→        grepPattern,
   501→      );
   502→      if (match && match.matchedFields.length > 0) {
   503→        console.log(
   504→          chalk.gray(
   505→            `    matched: ${formatMatchedFields(match.matchedFields)}`,
   506→          ),
   507→        );
   508→      }
   509→    } else if (full) {
   510→      // AC: @task-list-verbose ac-1 - Full mode shows richer context
   511→      formatFullModeContext(task, index);
   512→    } else {
   513→      // Show context line: first line of description (if present)
   514→      const context = getFirstLine(task.description);
   515→      if (context) {
   516→        console.log(chalk.gray(`    ${context}`));
   517→      }
   518→    }
   519→  }
   520→
   521→  console.log(summaries.taskCount(tasks.length));
   522→}
   523→
   524→export interface FormatTaskDetailsOptions {
   525→  /** Show all notes including superseded ones (default: false) */
   526→  showAllNotes?: boolean;
   527→}
   528→
   529→/**
   530→ * Format task details
   531→ */
   532→export function formatTaskDetails(
   533→  task: Task,
   534→  index?: ReferenceIndex,
   535→  options: FormatTaskDetailsOptions = {},
   536→): void {
   537→  console.log(chalk.bold(task.title));
   538→  console.log(chalk.gray("─".repeat(40)));
   539→  console.log(`${fieldLabels.ulid}      ${task._ulid}`);
   540→  if (task.slugs.length > 0) {
   541→    console.log(`${fieldLabels.slugs}     ${task.slugs.join(", ")}`);
   542→  }
   543→  console.log(`${fieldLabels.type}      ${task.type}`);
   544→  console.log(
   545→    `${fieldLabels.status}    ${statusColor(task.status)(task.status)}`,
   546→  );
   547→  console.log(`${fieldLabels.priority}  ${task.priority}`);
   548→
   549→  // AC: @task-automation-eligibility ac-17 - show automation status
   550→  const automationDisplay = task.automation || "unassessed";
   551→  const automationColor =
   552→    task.automation === "eligible"
   553→      ? chalk.green
   554→      : task.automation === "needs_review"
   555→        ? chalk.yellow
   556→        : task.automation === "manual_only"
   557→          ? chalk.red
   558→          : chalk.gray;
   559→  console.log(
   560→    `${fieldLabels.automation} ${automationColor(automationDisplay)}`,
   561→  );
   562→
   563→  // AC: @session-scoped-task-claiming ac-display
   564→  if (task.session_id) {
   565→    console.log(`Session:   ${chalk.yellow(task.session_id)}`);
   566→  }
   567→
   568→  if (task.description?.trim()) {
   569→    console.log(`\n${sectionHeaders.description}`);
   570→    const desc = task.description.trim();
   571→    for (const line of desc.split("\n")) {
   572→      console.log(`  ${line}`);
   573→    }
   574→  }
   575→
   576→  if (task.spec_ref) {
   577→    console.log(`${fieldLabels.specRef}  ${task.spec_ref}`);
   578→  }
   579→
   580→  // AC: @plan-derive ac-6 - display plan_ref
   581→  if (task.plan_ref) {
   582→    console.log(`Plan ref:  ${task.plan_ref}`);
   583→  }
   584→
   585→  if (task.depends_on.length > 0) {
   586→    if (index) {
   587→      console.log(fieldLabels.depends);
   588→      for (const ref of task.depends_on) {
   589→        const result = index.resolve(ref);
   590→        if (result.ok) {
   591→          const item = result.item;
   592→          const status =
   593→            "status" in item && typeof item.status === "string"
   594→              ? statusColor(item.status as TaskStatus)(`[${item.status}]`)
   595→              : chalk.gray("[spec]");
   596→          // Handle both spec items (with title) and meta items (with name or id)
   597→          const itemName =
   598→            "title" in item
   599→              ? item.title
   600→              : "name" in item
   601→                ? item.name
   602→                : "id" in item
   603→                  ? item.id
   604→                  : ref;
   605→          console.log(`  ${ref} ${chalk.gray("→")} ${itemName} ${status}`);
   606→        } else {
   607→          console.log(`  ${ref} ${chalk.red("(unresolved)")}`);
   608→        }
   609→      }
   610→    } else {
   611→      console.log(`${fieldLabels.depends}   ${task.depends_on.join(", ")}`);
   612→    }
   613→  }
   614→
   615→  if (task.blocked_by.length > 0) {
   616→    console.log(
   617→      chalk.red(`${fieldLabels.blocked}   ${task.blocked_by.join(", ")}`),
   618→    );
   619→  }
   620→
   621→  if (task.tags.length > 0) {
   622→    console.log(`${fieldLabels.tags}      ${task.tags.join(", ")}`);
   623→  }
   624→
   625→  console.log(`${fieldLabels.created}   ${task.created_at}`);
   626→  if (task.started_at) {
   627→    console.log(`${fieldLabels.started}   ${task.started_at}`);
   628→  }
   629→  if (task.completed_at) {
   630→    console.log(`${fieldLabels.completed} ${task.completed_at}`);
   631→  }
   632→
   633→  // Show resolved spec information
   634→  if (task.spec_ref && index) {
   635→    const result = index.resolve(task.spec_ref);
   636→    if (result.ok) {
   637→      const spec = result.item;
   638→      console.log(`\n${sectionHeaders.specContext}`);
   639→      // Handle both spec items (with title) and meta items (with name)
   640→      const specName =
   641→        "title" in spec
   642→          ? spec.title
   643→          : "name" in spec
   644→            ? spec.name
   645→            : "id" in spec
   646→              ? spec.id
   647→              : task.spec_ref;
   648→      console.log(chalk.cyan(specName));
   649→      if ("type" in spec && spec.type) {
   650→        console.log(chalk.gray(`${fieldLabels.type} ${spec.type}`));
   651→      }
   652→      // Show implementation status
   653→      if ("status" in spec && spec.status && typeof spec.status === "object") {
   654→        const status = spec.status as {
   655→          maturity?: string;
   656→          implementation?: string;
   657→        };
   658→        if (status.implementation) {
   659→          const implColor =
   660→            status.implementation === "verified"
   661→              ? chalk.green
   662→              : status.implementation === "implemented"
   663→                ? chalk.cyan
   664→                : status.implementation === "in_progress"
   665→                  ? chalk.yellow
   666→                  : chalk.gray;
   667→          console.log(
   668→            chalk.gray(fieldLabels.implementation) +
   669→              implColor(status.implementation),
   670→          );
   671→        }
   672→      }
   673→      if ("description" in spec && spec.description) {
   674→        console.log(chalk.gray(fieldLabels.description));
   675→        // Indent description lines
   676→        const desc = String(spec.description).trim();
   677→        for (const line of desc.split("\n")) {
   678→          console.log(chalk.gray(`  ${line}`));
   679→        }
   680→      }
   681→      if (
   682→        "acceptance_criteria" in spec &&
   683→        Array.isArray(spec.acceptance_criteria) &&
   684→        spec.acceptance_criteria.length > 0
   685→      ) {
   686→        console.log(chalk.gray(fieldLabels.acceptanceCriteria));
   687→        for (const ac of spec.acceptance_criteria) {
   688→          if (ac && typeof ac === "object" && "id" in ac) {
   689→            const acObj = ac as {
   690→              id: string;
   691→              given?: string;
   692→              when?: string;
   693→              then?: string;
   694→            };
   695→            console.log(chalk.gray(`  [${acObj.id}]`));
   696→            if (acObj.given)
   697→              console.log(chalk.gray(`    Given: ${acObj.given}`));
   698→            if (acObj.when) console.log(chalk.gray(`    When: ${acObj.when}`));
   699→            if (acObj.then) console.log(chalk.gray(`    Then: ${acObj.then}`));
   700→          }
   701→        }
   702→      }
   703→      // Show traceability if present
   704→      if (
   705→        "traceability" in spec &&
   706→        spec.traceability &&
   707→        typeof spec.traceability === "object"
   708→      ) {
   709→        const trace = spec.traceability as {
   710→          implementation?: Array<{
   711→            path: string;
   712→            function?: string;
   713→            lines?: string;
   714→          }>;
   715→          tests?: Array<{ path: string }>;
   716→          commits?: string[];
   717→          issues?: string[];
   718→        };
   719→        const hasTrace =
   720→          trace.implementation?.length ||
   721→          trace.tests?.length ||
   722→          trace.commits?.length ||
   723→          trace.issues?.length;
   724→        if (hasTrace) {
   725→          console.log(chalk.gray(fieldLabels.traceability));
   726→          if (trace.implementation?.length) {
   727→            for (const impl of trace.implementation) {
   728→              let loc = `  Code: ${impl.path}`;
   729→              if (impl.function) loc += `::${impl.function}`;
   730→              if (impl.lines) loc += `:${impl.lines}`;
   731→              console.log(chalk.gray(loc));
   732→            }
   733→          }
   734→          if (trace.tests?.length) {
   735→            for (const test of trace.tests) {
   736→              console.log(chalk.gray(`  Test: ${test.path}`));
   737→            }
   738→          }
   739→          if (trace.commits?.length) {
   740→            console.log(chalk.gray(`  Commits: ${trace.commits.join(", ")}`));
   741→          }
   742→          if (trace.issues?.length) {
   743→            console.log(chalk.gray(`  Issues: ${trace.issues.join(", ")}`));
   744→          }
   745→        }
   746→      }
   747→    }
   748→  }
   749→
   750→  if (task.notes.length > 0) {
   751→    // Filter superseded notes unless showAllNotes is true
   752→    const notesToShow = options.showAllNotes
   753→      ? task.notes
   754→      : filterSupersededNotes(task.notes);
   755→    const hiddenCount = task.notes.length - notesToShow.length;
   756→
   757→    console.log(`\n${sectionHeaders.notes}`);
   758→    for (const note of notesToShow) {
   759→      const author = note.author || "unknown";
   760→      // Mark if this note supersedes another
   761→      const supersededLabel = note.supersedes ? chalk.gray(" (supersedes earlier note)") : "";
   762→      console.log(chalk.gray(`[${note.created_at}] ${author}:`) + supersededLabel);
   763→      console.log(note.content);
   764→    }
   765→
   766→    // Show count of hidden notes if any
   767→    if (hiddenCount > 0) {
   768→      console.log(chalk.gray(`\n(${hiddenCount} superseded note${hiddenCount > 1 ? "s" : ""} hidden - use --all to show)`));
   769→    }
   770→  }
   771→
   772→  if (task.todos.length > 0) {
   773→    console.log(`\n${sectionHeaders.todos}`);
   774→    for (const todo of task.todos) {
   775→      const check = todo.done ? chalk.green("✓") : chalk.gray("○");
   776→      const text = todo.done ? chalk.strikethrough.gray(todo.text) : todo.text;
   777→      console.log(`${check} [${todo.id}] ${text}`);
   778→    }
   779→  }
   780→}
   781→