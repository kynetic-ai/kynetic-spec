     1→/**
     2→ * Session event storage.
     3→ *
     4→ * JSONL-based event storage for agent sessions with:
     5→ * - Atomic appends for crash safety (AC-3)
     6→ * - Auto-assigned timestamps and sequence numbers (AC-2)
     7→ * - Session metadata management
     8→ *
     9→ * Storage structure:
    10→ *   .kspec/sessions/{session-id}/
    11→ *     session.yaml      # Metadata
    12→ *     events.jsonl      # Append-only event log
    13→ */
    14→
    15→import * as fs from "node:fs";
    16→import * as fsPromises from "node:fs/promises";
    17→import * as path from "node:path";
    18→import * as YAML from "yaml";
    19→import {
    20→  type SessionEvent,
    21→  type SessionEventInput,
    22→  SessionEventSchema,
    23→  type SessionMetadata,
    24→  type SessionMetadataInput,
    25→  SessionMetadataSchema,
    26→  type SessionStatus,
    27→} from "./types.js";
    28→
    29→// ─── Constants ───────────────────────────────────────────────────────────────
    30→
    31→const SESSIONS_DIR = "sessions";
    32→const METADATA_FILE = "session.yaml";
    33→const EVENTS_FILE = "events.jsonl";
    34→
    35→// ─── Path Helpers ────────────────────────────────────────────────────────────
    36→
    37→/**
    38→ * Get the sessions directory path within a spec directory.
    39→ */
    40→export function getSessionsDir(specDir: string): string {
    41→  return path.join(specDir, SESSIONS_DIR);
    42→}
    43→
    44→/**
    45→ * Get the path to a specific session's directory.
    46→ */
    47→export function getSessionDir(specDir: string, sessionId: string): string {
    48→  return path.join(getSessionsDir(specDir), sessionId);
    49→}
    50→
    51→/**
    52→ * Get the path to a session's metadata file.
    53→ */
    54→export function getSessionMetadataPath(
    55→  specDir: string,
    56→  sessionId: string,
    57→): string {
    58→  return path.join(getSessionDir(specDir, sessionId), METADATA_FILE);
    59→}
    60→
    61→/**
    62→ * Get the path to a session's events file.
    63→ */
    64→export function getSessionEventsPath(
    65→  specDir: string,
    66→  sessionId: string,
    67→): string {
    68→  return path.join(getSessionDir(specDir, sessionId), EVENTS_FILE);
    69→}
    70→
    71→/**
    72→ * Get the path to a session's context snapshot file for a given iteration.
    73→ */
    74→export function getSessionContextPath(
    75→  specDir: string,
    76→  sessionId: string,
    77→  iteration: number,
    78→): string {
    79→  return path.join(
    80→    getSessionDir(specDir, sessionId),
    81→    `context-iter-${iteration}.json`,
    82→  );
    83→}
    84→
    85→// ─── Session CRUD ────────────────────────────────────────────────────────────
    86→
    87→/**
    88→ * Create a new session with metadata.
    89→ *
    90→ * AC-1: Creates .kspec/sessions/{id}/ directory with session.yaml metadata file.
    91→ * AC-5: Metadata includes task_id (optional), agent_type, status, started_at, ended_at.
    92→ *
    93→ * @param specDir - The .kspec directory path
    94→ * @param input - Session metadata input
    95→ * @returns The created session metadata
    96→ */
    97→export async function createSession(
    98→  specDir: string,
    99→  input: SessionMetadataInput,
   100→): Promise<SessionMetadata> {
   101→  const sessionDir = getSessionDir(specDir, input.id);
   102→  const metadataPath = getSessionMetadataPath(specDir, input.id);
   103→
   104→  // Create session directory
   105→  await fsPromises.mkdir(sessionDir, { recursive: true });
   106→
   107→  // Build full metadata
   108→  const metadata: SessionMetadata = {
   109→    id: input.id,
   110→    task_id: input.task_id,
   111→    agent_type: input.agent_type,
   112→    status: input.status ?? "active",
   113→    started_at: input.started_at ?? new Date().toISOString(),
   114→    ended_at: undefined,
   115→  };
   116→
   117→  // Validate and write metadata
   118→  const validated = SessionMetadataSchema.parse(metadata);
   119→  const content = YAML.stringify(validated, {
   120→    indent: 2,
   121→    lineWidth: 100,
   122→    sortMapEntries: false,
   123→  });
   124→  await fsPromises.writeFile(metadataPath, content, "utf-8");
   125→
   126→  return validated;
   127→}
   128→
   129→/**
   130→ * Read session metadata.
   131→ *
   132→ * @param specDir - The .kspec directory path
   133→ * @param sessionId - Session ID
   134→ * @returns Session metadata or null if not found
   135→ */
   136→export async function getSession(
   137→  specDir: string,
   138→  sessionId: string,
   139→): Promise<SessionMetadata | null> {
   140→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   141→
   142→  try {
   143→    const content = await fsPromises.readFile(metadataPath, "utf-8");
   144→    const raw = YAML.parse(content);
   145→    return SessionMetadataSchema.parse(raw);
   146→  } catch {
   147→    return null;
   148→  }
   149→}
   150→
   151→/**
   152→ * Update session status.
   153→ *
   154→ * AC-6: Updates metadata with status and ended_at timestamp when session ends.
   155→ *
   156→ * @param specDir - The .kspec directory path
   157→ * @param sessionId - Session ID
   158→ * @param status - New status
   159→ * @returns Updated metadata or null if session not found
   160→ */
   161→export async function updateSessionStatus(
   162→  specDir: string,
   163→  sessionId: string,
   164→  status: SessionStatus,
   165→): Promise<SessionMetadata | null> {
   166→  const metadata = await getSession(specDir, sessionId);
   167→  if (!metadata) {
   168→    return null;
   169→  }
   170→
   171→  // Update status and ended_at if transitioning away from active
   172→  const updated: SessionMetadata = {
   173→    ...metadata,
   174→    status,
   175→    ended_at:
   176→      status !== "active" ? new Date().toISOString() : metadata.ended_at,
   177→  };
   178→
   179→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   180→  const content = YAML.stringify(updated, {
   181→    indent: 2,
   182→    lineWidth: 100,
   183→    sortMapEntries: false,
   184→  });
   185→  await fsPromises.writeFile(metadataPath, content, "utf-8");
   186→
   187→  return updated;
   188→}
   189→
   190→/**
   191→ * List all sessions.
   192→ *
   193→ * @param specDir - The .kspec directory path
   194→ * @returns Array of session IDs
   195→ */
   196→export async function listSessions(specDir: string): Promise<string[]> {
   197→  const sessionsDir = getSessionsDir(specDir);
   198→
   199→  try {
   200→    const entries = await fsPromises.readdir(sessionsDir, {
   201→      withFileTypes: true,
   202→    });
   203→    return entries.filter((e) => e.isDirectory()).map((e) => e.name);
   204→  } catch {
   205→    return [];
   206→  }
   207→}
   208→
   209→/**
   210→ * Check if a session exists.
   211→ */
   212→export async function sessionExists(
   213→  specDir: string,
   214→  sessionId: string,
   215→): Promise<boolean> {
   216→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   217→  try {
   218→    await fsPromises.access(metadataPath);
   219→    return true;
   220→  } catch {
   221→    return false;
   222→  }
   223→}
   224→
   225→// ─── Event Storage ───────────────────────────────────────────────────────────
   226→
   227→/**
   228→ * Get the current event count for a session (for seq assignment).
   229→ *
   230→ * @param specDir - The .kspec directory path
   231→ * @param sessionId - Session ID
   232→ * @returns Number of events in the session
   233→ */
   234→async function getEventCount(
   235→  specDir: string,
   236→  sessionId: string,
   237→): Promise<number> {
   238→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   239→
   240→  try {
   241→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   242→    const lines = content
   243→      .trim()
   244→      .split("\n")
   245→      .filter((line) => line.length > 0);
   246→    return lines.length;
   247→  } catch {
   248→    return 0;
   249→  }
   250→}
   251→
   252→/**
   253→ * Append an event to a session's event log.
   254→ *
   255→ * AC-2: Appends JSON line to events.jsonl with auto-assigned ts and seq.
   256→ * AC-3: Uses atomic append (appendFileSync) for crash safety.
   257→ *
   258→ * Creates the session directory if it doesn't exist (lazy creation).
   259→ *
   260→ * Note: This function is not safe for concurrent access to the same session.
   261→ * The sequence number assignment has a race condition between reading the
   262→ * event count and appending the event. This is acceptable for CLI use
   263→ * (single-process, sequential event logging). If concurrent access is needed
   264→ * in the future, consider file locking or an in-memory counter per session.
   265→ *
   266→ * @param specDir - The .kspec directory path
   267→ * @param input - Event input (ts and seq are auto-assigned if not provided)
   268→ * @returns The appended event with auto-assigned fields
   269→ */
   270→export async function appendEvent(
   271→  specDir: string,
   272→  input: SessionEventInput,
   273→): Promise<SessionEvent> {
   274→  const sessionDir = getSessionDir(specDir, input.session_id);
   275→  const eventsPath = getSessionEventsPath(specDir, input.session_id);
   276→
   277→  // Ensure session directory exists (lazy creation)
   278→  await fsPromises.mkdir(sessionDir, { recursive: true });
   279→
   280→  // Get current event count for seq assignment
   281→  const seq = input.seq ?? (await getEventCount(specDir, input.session_id));
   282→
   283→  // Build full event
   284→  const event: SessionEvent = {
   285→    ts: input.ts ?? Date.now(),
   286→    seq,
   287→    type: input.type,
   288→    session_id: input.session_id,
   289→    trace_id: input.trace_id,
   290→    data: input.data,
   291→  };
   292→
   293→  // Validate event
   294→  const validated = SessionEventSchema.parse(event);
   295→
   296→  // AC: @session-events ac-3 - Use synchronous append for crash safety
   297→  // This ensures the line is fully written before returning
   298→  const line = `${JSON.stringify(validated)}\n`;
   299→  fs.appendFileSync(eventsPath, line, "utf-8");
   300→
   301→  return validated;
   302→}
   303→
   304→/**
   305→ * Read all events from a session.
   306→ *
   307→ * AC-4: Returns all events in sequence order.
   308→ *
   309→ * @param specDir - The .kspec directory path
   310→ * @param sessionId - Session ID
   311→ * @returns Array of events sorted by sequence number
   312→ */
   313→export async function readEvents(
   314→  specDir: string,
   315→  sessionId: string,
   316→): Promise<SessionEvent[]> {
   317→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   318→
   319→  try {
   320→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   321→    const lines = content
   322→      .trim()
   323→      .split("\n")
   324→      .filter((line) => line.length > 0);
   325→
   326→    const events: SessionEvent[] = [];
   327→    for (const line of lines) {
   328→      try {
   329→        const raw = JSON.parse(line);
   330→        const event = SessionEventSchema.parse(raw);
   331→        events.push(event);
   332→      } catch {
   333→        // Skip invalid lines
   334→      }
   335→    }
   336→
   337→    // AC: @session-events ac-4 - Sort by sequence number
   338→    return events.sort((a, b) => a.seq - b.seq);
   339→  } catch {
   340→    return [];
   341→  }
   342→}
   343→
   344→/**
   345→ * Deduplicate phased tool_call events.
   346→ *
   347→ * ACP SDK 0.14+ sends tool calls in two phases: first with empty rawInput,
   348→ * then with populated rawInput. This merges them by keeping only the version
   349→ * with populated rawInput per toolCallId.
   350→ */
   351→export function deduplicatePhasedToolCalls(
   352→  events: SessionEvent[],
   353→): SessionEvent[] {
   354→  // First pass: find toolCallIds that have a populated rawInput version
   355→  const populatedToolCalls = new Map<string, number>(); // toolCallId → index
   356→  for (let i = 0; i < events.length; i++) {
   357→    const event = events[i];
   358→    if (event.type !== "session.update") continue;
   359→    const data = event.data as { update?: { sessionUpdate?: string; toolCallId?: string; tool_call_id?: string; id?: string; rawInput?: Record<string, unknown> } } | null;
   360→    const update = data?.update;
   361→    if (update?.sessionUpdate !== "tool_call") continue;
   362→    const toolCallId = update.toolCallId || update.tool_call_id || update.id;
   363→    if (!toolCallId) continue;
   364→    const rawInput = update.rawInput;
   365→    const hasContent = rawInput && Object.keys(rawInput).length > 0;
   366→    if (hasContent) {
   367→      populatedToolCalls.set(toolCallId, i);
   368→    } else if (!populatedToolCalls.has(toolCallId)) {
   369→      // First (empty) version - track it in case no populated version exists
   370→      populatedToolCalls.set(toolCallId, i);
   371→    }
   372→  }
   373→
   374→  // Second pass: keep only the best version per toolCallId
   375→  return events.filter((event, i) => {
   376→    if (event.type !== "session.update") return true;
   377→    const data = event.data as { update?: { sessionUpdate?: string; toolCallId?: string; tool_call_id?: string; id?: string; rawInput?: Record<string, unknown> } } | null;
   378→    const update = data?.update;
   379→    if (update?.sessionUpdate !== "tool_call") return true;
   380→    const toolCallId = update.toolCallId || update.tool_call_id || update.id;
   381→    if (!toolCallId) return true;
   382→    // Keep this event only if it's the best version (populated or only version)
   383→    return populatedToolCalls.get(toolCallId) === i;
   384→  });
   385→}
   386→
   387→/**
   388→ * Read events within a time range.
   389→ *
   390→ * @param specDir - The .kspec directory path
   391→ * @param sessionId - Session ID
   392→ * @param since - Start timestamp (inclusive)
   393→ * @param until - End timestamp (inclusive)
   394→ * @returns Array of events within the time range
   395→ */
   396→export async function readEventsSince(
   397→  specDir: string,
   398→  sessionId: string,
   399→  since: number,
   400→  until?: number,
   401→): Promise<SessionEvent[]> {
   402→  const events = await readEvents(specDir, sessionId);
   403→  return events.filter((e) => {
   404→    if (e.ts < since) return false;
   405→    if (until !== undefined && e.ts > until) return false;
   406→    return true;
   407→  });
   408→}
   409→
   410→/**
   411→ * Get the last event in a session.
   412→ *
   413→ * @param specDir - The .kspec directory path
   414→ * @param sessionId - Session ID
   415→ * @returns The last event or null if no events
   416→ */
   417→export async function getLastEvent(
   418→  specDir: string,
   419→  sessionId: string,
   420→): Promise<SessionEvent | null> {
   421→  const events = await readEvents(specDir, sessionId);
   422→  if (events.length === 0) {
   423→    return null;
   424→  }
   425→  return events[events.length - 1];
   426→}
   427→
   428→// ─── Session Log Summaries ───────────────────────────────────────────────────
   429→
   430→/**
   431→ * Summary data for a session, used by `session log list`.
   432→ */
   433→export interface SessionLogSummary {
   434→  /** Session ID */
   435→  id: string;
   436→  /** Session status */
   437→  status: SessionStatus;
   438→  /** Agent type */
   439→  agent_type: string;
   440→  /** When session started (ISO 8601) */
   441→  started_at: string;
   442→  /** When session ended (ISO 8601), if completed */
   443→  ended_at?: string;
   444→  /** Duration in milliseconds (computed from started_at/ended_at or now) */
   445→  duration_ms: number;
   446→  /** Number of events in events.jsonl */
   447→  event_count: number;
   448→  /** Number of context-iter-*.json files (iteration count) */
   449→  iteration_count: number;
   450→  /** Number of tasks completed during the session */
   451→  tasks_completed: number;
   452→}
   453→
   454→/**
   455→ * Count lines in events.jsonl without parsing JSON.
   456→ * Much faster than readEvents() for large files.
   457→ */
   458→async function countEventLines(
   459→  specDir: string,
   460→  sessionId: string,
   461→): Promise<number> {
   462→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   463→  try {
   464→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   465→    if (!content.trim()) return 0;
   466→    return content.trim().split("\n").length;
   467→  } catch {
   468→    return 0;
   469→  }
   470→}
   471→
   472→/**
   473→ * Count context-iter-*.json files for a session (iteration count).
   474→ */
   475→async function countIterations(
   476→  specDir: string,
   477→  sessionId: string,
   478→): Promise<number> {
   479→  const sessionDir = getSessionDir(specDir, sessionId);
   480→  try {
   481→    const entries = await fsPromises.readdir(sessionDir);
   482→    return entries.filter(
   483→      (e) => e.startsWith("context-iter-") && e.endsWith(".json"),
   484→    ).length;
   485→  } catch {
   486→    return 0;
   487→  }
   488→}
   489→
   490→/**
   491→ * Count task completions by scanning events for tool calls that invoke
   492→ * `kspec task complete` or `npm run dev -- task complete`.
   493→ *
   494→ * Real sessions record task completions as session.update events with
   495→ * sessionUpdate: "tool_call" and rawInput.command containing the complete command.
   496→ * We use a fast substring check before JSON parsing for performance.
   497→ */
   498→async function countTaskCompletions(
   499→  specDir: string,
   500→  sessionId: string,
   501→): Promise<number> {
   502→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   503→  try {
   504→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   505→    if (!content.trim()) return 0;
   506→    const lines = content.trim().split("\n");
   507→    let count = 0;
   508→    for (const line of lines) {
   509→      // Quick substring pre-filter: only parse lines that might contain task complete commands
   510→      if (!line.includes("task complete")) continue;
   511→      // Must be a tool_call event (session.update with sessionUpdate: "tool_call")
   512→      if (!line.includes('"tool_call"')) continue;
   513→      try {
   514→        const event = JSON.parse(line);
   515→        const command = event?.data?.update?.rawInput?.command;
   516→        if (typeof command === "string" && /\btask complete\b/.test(command)) {
   517→          count++;
   518→        }
   519→      } catch {
   520→        // Skip unparseable lines
   521→      }
   522→    }
   523→    return count;
   524→  } catch {
   525→    return 0;
   526→  }
   527→}
   528→
   529→/**
   530→ * Get a summary of a single session for list display.
   531→ *
   532→ * Gathers metadata and computes metrics lazily (only parses what's needed).
   533→ *
   534→ * @param specDir - The .kspec directory path
   535→ * @param sessionId - Session ID
   536→ * @returns Session summary or null if session doesn't exist
   537→ */
   538→export async function getSessionLogSummary(
   539→  specDir: string,
   540→  sessionId: string,
   541→): Promise<SessionLogSummary | null> {
   542→  const metadata = await getSession(specDir, sessionId);
   543→  if (!metadata) return null;
   544→
   545→  const [eventCount, iterationCount, tasksCompleted] = await Promise.all([
   546→    countEventLines(specDir, sessionId),
   547→    countIterationsBoundaryAware(specDir, sessionId),
   548→    countTaskCompletions(specDir, sessionId),
   549→  ]);
   550→
   551→  const startMs = new Date(metadata.started_at).getTime();
   552→  const endMs = metadata.ended_at
   553→    ? new Date(metadata.ended_at).getTime()
   554→    : Date.now();
   555→  const durationMs = endMs - startMs;
   556→
   557→  return {
   558→    id: metadata.id,
   559→    status: metadata.status,
   560→    agent_type: metadata.agent_type,
   561→    started_at: metadata.started_at,
   562→    ended_at: metadata.ended_at,
   563→    duration_ms: durationMs,
   564→    event_count: eventCount,
   565→    iteration_count: iterationCount,
   566→    tasks_completed: tasksCompleted,
   567→  };
   568→}
   569→
   570→/**
   571→ * Get summaries for all sessions.
   572→ *
   573→ * @param specDir - The .kspec directory path
   574→ * @returns Array of session summaries
   575→ */
   576→export async function getAllSessionLogSummaries(
   577→  specDir: string,
   578→): Promise<SessionLogSummary[]> {
   579→  const sessionIds = await listSessions(specDir);
   580→  const summaries = await Promise.all(
   581→    sessionIds.map((id) => getSessionLogSummary(specDir, id)),
   582→  );
   583→  return summaries.filter((s): s is SessionLogSummary => s !== null);
   584→}
   585→
   586→// ─── Context Snapshots ───────────────────────────────────────────────────────
   587→
   588→/**
   589→ * Save session context snapshot for a given iteration.
   590→ *
   591→ * This creates an audit trail of what context the agent saw at each iteration,
   592→ * useful for debugging and reviewing agent behavior.
   593→ *
   594→ * @param specDir - The .kspec directory path
   595→ * @param sessionId - Session ID
   596→ * @param iteration - Iteration number
   597→ * @param context - The session context data
   598→ */
   599→export async function saveSessionContext(
   600→  specDir: string,
   601→  sessionId: string,
   602→  iteration: number,
   603→  context: unknown,
   604→): Promise<void> {
   605→  const sessionDir = getSessionDir(specDir, sessionId);
   606→  const contextPath = getSessionContextPath(specDir, sessionId, iteration);
   607→
   608→  // Ensure session directory exists
   609→  await fsPromises.mkdir(sessionDir, { recursive: true });
   610→
   611→  // Write context snapshot as pretty JSON
   612→  const content = JSON.stringify(context, null, 2);
   613→  await fsPromises.writeFile(contextPath, content, "utf-8");
   614→}
   615→
   616→/**
   617→ * Read session context snapshot for a given iteration.
   618→ *
   619→ * @param specDir - The .kspec directory path
   620→ * @param sessionId - Session ID
   621→ * @param iteration - Iteration number
   622→ * @returns The context snapshot or null if not found
   623→ */
   624→export async function readSessionContext(
   625→  specDir: string,
   626→  sessionId: string,
   627→  iteration: number,
   628→): Promise<unknown | null> {
   629→  const contextPath = getSessionContextPath(specDir, sessionId, iteration);
   630→
   631→  try {
   632→    const content = await fsPromises.readFile(contextPath, "utf-8");
   633→    return JSON.parse(content);
   634→  } catch {
   635→    return null;
   636→  }
   637→}
   638→
   639→// ─── Session ID Resolution ───────────────────────────────────────────────────
   640→
   641→/**
   642→ * Result of resolving a session ID prefix.
   643→ */
   644→export type SessionIdResolution =
   645→  | { ok: true; id: string }
   646→  | { ok: false; error: "not_found" }
   647→  | { ok: false; error: "ambiguous"; matches: string[] };
   648→
   649→/**
   650→ * Resolve a session ID or prefix to a full session ID.
   651→ *
   652→ * AC: @session-log-show ac-7, ac-8, ac-9
   653→ *
   654→ * @param specDir - The .kspec directory path
   655→ * @param idOrPrefix - Full session ID or prefix (e.g., first 8 chars)
   656→ * @returns Resolution result
   657→ */
   658→export async function resolveSessionId(
   659→  specDir: string,
   660→  idOrPrefix: string,
   661→): Promise<SessionIdResolution> {
   662→  const sessionIds = await listSessions(specDir);
   663→
   664→  // First, try exact match
   665→  if (sessionIds.includes(idOrPrefix)) {
   666→    return { ok: true, id: idOrPrefix };
   667→  }
   668→
   669→  // Try prefix match
   670→  const matches = sessionIds.filter((id) => id.startsWith(idOrPrefix));
   671→
   672→  if (matches.length === 0) {
   673→    return { ok: false, error: "not_found" };
   674→  }
   675→
   676→  if (matches.length === 1) {
   677→    return { ok: true, id: matches[0] };
   678→  }
   679→
   680→  // Ambiguous - multiple matches
   681→  return { ok: false, error: "ambiguous", matches };
   682→}
   683→
   684→// ─── Session Detail Data ─────────────────────────────────────────────────────
   685→
   686→/**
   687→ * Per-iteration summary for session log show.
   688→ */
   689→export interface IterationSummary {
   690→  /** Iteration number (1-indexed) */
   691→  iteration: number;
   692→  /** Number of events in this iteration */
   693→  event_count: number;
   694→  /** Tasks started in this iteration */
   695→  tasks_started: string[];
   696→  /** Tasks completed in this iteration */
   697→  tasks_completed: string[];
   698→}
   699→
   700→/**
   701→ * Full session detail data for session log show.
   702→ */
   703→export interface SessionLogDetail {
   704→  /** Session metadata */
   705→  id: string;
   706→  status: SessionStatus;
   707→  agent_type: string;
   708→  task_id?: string;
   709→  started_at: string;
   710→  ended_at?: string;
   711→  duration_ms: number;
   712→  /** Total event count */
   713→  event_count: number;
   714→  /** Total iteration count */
   715→  iteration_count: number;
   716→  /** Per-iteration summaries */
   717→  iterations: IterationSummary[];
   718→}
   719→
   720→/**
   721→ * Get iteration number from a context snapshot file.
   722→ */
   723→async function getIterationNumbers(
   724→  specDir: string,
   725→  sessionId: string,
   726→): Promise<number[]> {
   727→  const sessionDir = getSessionDir(specDir, sessionId);
   728→  try {
   729→    const entries = await fsPromises.readdir(sessionDir);
   730→    const iterations: number[] = [];
   731→    for (const entry of entries) {
   732→      const match = entry.match(/^context-iter-(\d+)\.json$/);
   733→      if (match) {
   734→        iterations.push(parseInt(match[1], 10));
   735→      }
   736→    }
   737→    return iterations.sort((a, b) => a - b);
   738→  } catch {
   739→    return [];
   740→  }
   741→}
   742→
   743→/**
   744→ * Extract task refs from task commands in event data.
   745→ */
   746→function extractTaskRef(command: string): string | null {
   747→  // Match patterns like: kspec task start @ref, kspec task complete @ref
   748→  const match = command.match(/@[\w-]+/);
   749→  return match ? match[0] : null;
   750→}
   751→
   752→/**
   753→ * Iteration boundary: a prompt.sent event with phase "task-work" that marks
   754→ * the start of a new iteration in a ralph session.
   755→ */
   756→interface IterationBoundary {
   757→  /** Array index in the events list */
   758→  index: number;
   759→  /** Iteration number from the event data */
   760→  iteration: number;
   761→}
   762→
   763→/**
   764→ * Find iteration boundaries from prompt.sent events with phase "task-work".
   765→ *
   766→ * Ralph emits these synchronously at the start of each iteration, so their
   767→ * array positions are reliable even when concurrent fire-and-forget events
   768→ * produce duplicate seq numbers.
   769→ *
   770→ * Returns validated, monotonically increasing boundaries.
   771→ */
   772→function findIterationBoundaries(events: SessionEvent[]): IterationBoundary[] {
   773→  const raw: IterationBoundary[] = [];
   774→
   775→  for (let i = 0; i < events.length; i++) {
   776→    const event = events[i];
   777→    if (event.type !== "prompt.sent") continue;
   778→
   779→    const data = event.data as {
   780→      phase?: string;
   781→      iteration?: number;
   782→    } | null;
   783→
   784→    if (
   785→      data?.phase !== "task-work" ||
   786→      typeof data?.iteration !== "number"
   787→    ) {
   788→      continue;
   789→    }
   790→
   791→    raw.push({ index: i, iteration: data.iteration });
   792→  }
   793→
   794→  // Validate: filter to monotonically increasing iteration numbers, deduplicate
   795→  const validated: IterationBoundary[] = [];
   796→  let lastIter = -Infinity;
   797→
   798→  for (const b of raw) {
   799→    if (b.iteration > lastIter) {
   800→      validated.push(b);
   801→      lastIter = b.iteration;
   802→    }
   803→  }
   804→
   805→  return validated;
   806→}
   807→
   808→/**
   809→ * Extract task start/complete refs from a slice of events.
   810→ */
   811→function extractTaskTransitions(events: SessionEvent[]): {
   812→  tasksStarted: string[];
   813→  tasksCompleted: string[];
   814→} {
   815→  const tasksStarted: string[] = [];
   816→  const tasksCompleted: string[] = [];
   817→
   818→  for (const event of events) {
   819→    if (event.type === "session.update") {
   820→      const data = event.data as {
   821→        update?: {
   822→          sessionUpdate?: string;
   823→          rawInput?: { command?: string };
   824→        };
   825→      } | null;
   826→      const command = data?.update?.rawInput?.command;
   827→      if (typeof command === "string") {
   828→        if (/\btask start\b/.test(command)) {
   829→          const ref = extractTaskRef(command);
   830→          if (ref) tasksStarted.push(ref);
   831→        } else if (/\btask complete\b/.test(command)) {
   832→          const ref = extractTaskRef(command);
   833→          if (ref) tasksCompleted.push(ref);
   834→        }
   835→      }
   836→    }
   837→  }
   838→
   839→  return { tasksStarted, tasksCompleted };
   840→}
   841→
   842→/**
   843→ * Legacy iteration grouping: groups events by their data.iteration field.
   844→ *
   845→ * Used as fallback for sessions that don't have prompt.sent boundary events
   846→ * with phase "task-work" (pre-boundary sessions or non-ralph sessions).
   847→ *
   848→ * AC: @session-log-show ac-2
   849→ */
   850→function legacyIterationGrouping(
   851→  events: SessionEvent[],
   852→  snapshotIterations: number[],
   853→): IterationSummary[] {
   854→  // Collect all iteration numbers from both snapshots and events
   855→  const allIterations = new Set<number>(snapshotIterations);
   856→  for (const event of events) {
   857→    const data = event.data as { iteration?: number } | null;
   858→    if (typeof data?.iteration === "number") {
   859→      allIterations.add(data.iteration);
   860→    }
   861→  }
   862→
   863→  // If no iterations found anywhere, synthesize iteration-0 only if events exist
   864→  if (allIterations.size === 0) {
   865→    if (events.length === 0) {
   866→      return [];
   867→    }
   868→    const { tasksStarted, tasksCompleted } = extractTaskTransitions(events);
   869→    return [
   870→      {
   871→        iteration: 0,
   872→        event_count: events.length,
   873→        tasks_started: tasksStarted,
   874→        tasks_completed: tasksCompleted,
   875→      },
   876→    ];
   877→  }
   878→
   879→  // Create buckets for all known iterations
   880→  const iterations = Array.from(allIterations).sort((a, b) => a - b);
   881→  const iterationMap = new Map<number, SessionEvent[]>();
   882→  for (const n of iterations) {
   883→    iterationMap.set(n, []);
   884→  }
   885→
   886→  for (const event of events) {
   887→    const data = event.data as { iteration?: number } | null;
   888→    const iter = data?.iteration;
   889→    if (typeof iter === "number" && iterationMap.has(iter)) {
   890→      iterationMap.get(iter)!.push(event);
   891→    } else {
   892→      const fallbackIter = iterationMap.has(0) ? 0 : iterations[0];
   893→      iterationMap.get(fallbackIter)!.push(event);
   894→    }
   895→  }
   896→
   897→  const summaries: IterationSummary[] = [];
   898→  for (const [iterNum, iterEvents] of iterationMap) {
   899→    const { tasksStarted, tasksCompleted } = extractTaskTransitions(iterEvents);
   900→    summaries.push({
   901→      iteration: iterNum,
   902→      event_count: iterEvents.length,
   903→      tasks_started: tasksStarted,
   904→      tasks_completed: tasksCompleted,
   905→    });
   906→  }
   907→
   908→  return summaries.sort((a, b) => a.iteration - b.iteration);
   909→}
   910→
   911→/**
   912→ * Boundary-based iteration grouping: splits events by prompt.sent boundary
   913→ * positions (array indices) instead of trusting data.iteration fields.
   914→ *
   915→ * This is resilient to producer-side bugs where concurrent fire-and-forget
   916→ * event logging captures the wrong iteration number.
   917→ *
   918→ * AC: @session-log-show ac-10
   919→ */
   920→function boundaryIterationGrouping(
   921→  events: SessionEvent[],
   922→  boundaries: IterationBoundary[],
   923→): IterationSummary[] {
   924→  const summaries: IterationSummary[] = [];
   925→
   926→  for (let b = 0; b < boundaries.length; b++) {
   927→    const startIdx = boundaries[b].index;
   928→    const endIdx = b + 1 < boundaries.length ? boundaries[b + 1].index : events.length;
   929→    const iterEvents = events.slice(startIdx, endIdx);
   930→    const { tasksStarted, tasksCompleted } = extractTaskTransitions(iterEvents);
   931→
   932→    summaries.push({
   933→      iteration: boundaries[b].iteration,
   934→      event_count: iterEvents.length,
   935→      tasks_started: tasksStarted,
   936→      tasks_completed: tasksCompleted,
   937→    });
   938→  }
   939→
   940→  // Pre-boundary events (before the first prompt.sent) merge into first iteration
   941→  if (boundaries.length > 0 && boundaries[0].index > 0) {
   942→    const preBoundaryEvents = events.slice(0, boundaries[0].index);
   943→    const { tasksStarted, tasksCompleted } = extractTaskTransitions(preBoundaryEvents);
   944→    summaries[0].event_count += preBoundaryEvents.length;
   945→    summaries[0].tasks_started = [...tasksStarted, ...summaries[0].tasks_started];
   946→    summaries[0].tasks_completed = [...tasksCompleted, ...summaries[0].tasks_completed];
   947→  }
   948→
   949→  return summaries;
   950→}
   951→
   952→/**
   953→ * Compute per-iteration summaries from events.
   954→ *
   955→ * Uses prompt.sent boundary events (phase: "task-work") when available for
   956→ * accurate index-based grouping. Falls back to legacy data.iteration grouping
   957→ * for sessions without boundaries.
   958→ *
   959→ * AC: @session-log-show ac-2, ac-10
   960→ */
   961→async function computeIterationSummaries(
   962→  specDir: string,
   963→  sessionId: string,
   964→): Promise<IterationSummary[]> {
   965→  const events = await readEvents(specDir, sessionId);
   966→  const boundaries = findIterationBoundaries(events);
   967→
   968→  if (boundaries.length > 0) {
   969→    return boundaryIterationGrouping(events, boundaries);
   970→  }
   971→
   972→  // Legacy fallback: no prompt.sent boundaries with phase "task-work"
   973→  const snapshotIterations = await getIterationNumbers(specDir, sessionId);
   974→  return legacyIterationGrouping(events, snapshotIterations);
   975→}
   976→
   977→/**
   978→ * Count iterations using boundary-aware logic, without computing full summaries.
   979→ *
   980→ * For use in getSessionLogSummary() (session log list, session log stats) to
   981→ * ensure iteration_count agrees with session log show.
   982→ *
   983→ * Falls back to counting context-iter-*.json files when no boundaries exist.
   984→ */
   985→async function countIterationsBoundaryAware(
   986→  specDir: string,
   987→  sessionId: string,
   988→): Promise<number> {
   989→  const events = await readEvents(specDir, sessionId);
   990→  const boundaries = findIterationBoundaries(events);
   991→
   992→  if (boundaries.length > 0) {
   993→    return boundaries.length;
   994→  }
   995→
   996→  // Legacy fallback: count from context snapshots and event data
   997→  const snapshotIterations = await getIterationNumbers(specDir, sessionId);
   998→  const allIterations = new Set<number>(snapshotIterations);
   999→  for (const event of events) {
  1000→    const data = event.data as { iteration?: number } | null;
  1001→    if (typeof data?.iteration === "number") {
  1002→      allIterations.add(data.iteration);
  1003→    }
  1004→  }
  1005→
  1006→  return allIterations.size || (events.length > 0 ? 1 : 0);
  1007→}
  1008→
  1009→/**
  1010→ * Get full session detail for session log show.
  1011→ *
  1012→ * @param specDir - The .kspec directory path
  1013→ * @param sessionId - Session ID (must be resolved first)
  1014→ * @returns Session detail or null if not found
  1015→ */
  1016→export async function getSessionLogDetail(
  1017→  specDir: string,
  1018→  sessionId: string,
  1019→): Promise<SessionLogDetail | null> {
  1020→  const metadata = await getSession(specDir, sessionId);
  1021→  if (!metadata) return null;
  1022→
  1023→  const [eventCount, iterations] = await Promise.all([
  1024→    countEventLines(specDir, sessionId),
  1025→    computeIterationSummaries(specDir, sessionId),
  1026→  ]);
  1027→
  1028→  const startMs = new Date(metadata.started_at).getTime();
  1029→  const endMs = metadata.ended_at
  1030→    ? new Date(metadata.ended_at).getTime()
  1031→    : Date.now();
  1032→  const durationMs = endMs - startMs;
  1033→
  1034→  return {
  1035→    id: metadata.id,
  1036→    status: metadata.status,
  1037→    agent_type: metadata.agent_type,
  1038→    task_id: metadata.task_id,
  1039→    started_at: metadata.started_at,
  1040→    ended_at: metadata.ended_at,
  1041→    duration_ms: durationMs,
  1042→    event_count: eventCount,
  1043→    iteration_count: iterations.length,
  1044→    iterations,
  1045→  };
  1046→}
  1047→
  1048→// ─── Session Log Stats ───────────────────────────────────────────────────────
  1049→
  1050→/**
  1051→ * Aggregate session statistics.
  1052→ *
  1053→ * AC: @session-log-stats ac-1, ac-2, ac-3
  1054→ */
  1055→export interface SessionLogStats {
  1056→  /** Total number of sessions */
  1057→  total_sessions: number;
  1058→  /** Total events across all sessions */
  1059→  total_events: number;
  1060→  /** Total iterations across all sessions */
  1061→  total_iterations: number;
  1062→  /** Total tasks completed across all sessions */
  1063→  total_tasks_completed: number;
  1064→  /** Total duration in milliseconds */
  1065→  total_duration_ms: number;
  1066→
  1067→  /** Average duration per session in milliseconds */
  1068→  avg_duration_ms: number;
  1069→  /** Average iterations per session */
  1070→  avg_iterations_per_session: number;
  1071→  /** Average tasks completed per session */
  1072→  avg_tasks_per_session: number;
  1073→
  1074→  /** Status breakdown with counts and percentages */
  1075→  status_breakdown: {
  1076→    status: SessionStatus;
  1077→    count: number;
  1078→    percentage: number;
  1079→  }[];
  1080→}
  1081→
  1082→/**
  1083→ * Tool usage statistics.
  1084→ *
  1085→ * AC: @session-log-stats ac-6
  1086→ */
  1087→export interface ToolUsageStats {
  1088→  tool_name: string;
  1089→  count: number;
  1090→  percentage: number;
  1091→}
  1092→
  1093→/**
  1094→ * Time period stats for --by-day or --by-week.
  1095→ *
  1096→ * AC: @session-log-stats ac-7
  1097→ */
  1098→export interface TimePeriodStats {
  1099→  period: string;
  1100→  sessions_count: number;
  1101→  tasks_completed: number;
  1102→  total_duration_ms: number;
  1103→}
  1104→
  1105→/**
  1106→ * Compute aggregate statistics from session summaries.
  1107→ *
  1108→ * @param summaries - Array of session log summaries
  1109→ * @returns Aggregate statistics
  1110→ */
  1111→export function computeSessionLogStats(
  1112→  summaries: SessionLogSummary[],
  1113→): SessionLogStats {
  1114→  if (summaries.length === 0) {
  1115→    return {
  1116→      total_sessions: 0,
  1117→      total_events: 0,
  1118→      total_iterations: 0,
  1119→      total_tasks_completed: 0,
  1120→      total_duration_ms: 0,
  1121→      avg_duration_ms: 0,
  1122→      avg_iterations_per_session: 0,
  1123→      avg_tasks_per_session: 0,
  1124→      status_breakdown: [],
  1125→    };
  1126→  }
  1127→
  1128→  // Compute totals
  1129→  let totalEvents = 0;
  1130→  let totalIterations = 0;
  1131→  let totalTasksCompleted = 0;
  1132→  let totalDuration = 0;
  1133→  const statusCounts: Record<SessionStatus, number> = {
  1134→    active: 0,
  1135→    completed: 0,
  1136→    abandoned: 0,
  1137→  };
  1138→
  1139→  for (const s of summaries) {
  1140→    totalEvents += s.event_count;
  1141→    totalIterations += s.iteration_count;
  1142→    totalTasksCompleted += s.tasks_completed;
  1143→    totalDuration += s.duration_ms;
  1144→    statusCounts[s.status] = (statusCounts[s.status] || 0) + 1;
  1145→  }
  1146→
  1147→  const n = summaries.length;
  1148→
  1149→  // Build status breakdown
  1150→  const statusBreakdown: { status: SessionStatus; count: number; percentage: number }[] = [];
  1151→  for (const status of ["completed", "active", "abandoned"] as SessionStatus[]) {
  1152→    const count = statusCounts[status] || 0;
  1153→    if (count > 0) {
  1154→      statusBreakdown.push({
  1155→        status,
  1156→        count,
  1157→        percentage: Math.round((count / n) * 100 * 10) / 10, // 1 decimal place
  1158→      });
  1159→    }
  1160→  }
  1161→
  1162→  return {
  1163→    total_sessions: n,
  1164→    total_events: totalEvents,
  1165→    total_iterations: totalIterations,
  1166→    total_tasks_completed: totalTasksCompleted,
  1167→    total_duration_ms: totalDuration,
  1168→    avg_duration_ms: Math.round(totalDuration / n),
  1169→    avg_iterations_per_session: Math.round((totalIterations / n) * 10) / 10,
  1170→    avg_tasks_per_session: Math.round((totalTasksCompleted / n) * 10) / 10,
  1171→    status_breakdown: statusBreakdown,
  1172→  };
  1173→}
  1174→
  1175→/**
  1176→ * Count tool calls by scanning events.jsonl for tool_call events.
  1177→ *
  1178→ * This is relatively expensive as it parses all events, so only call
  1179→ * when --tool-usage is requested.
  1180→ *
  1181→ * AC: @session-log-stats ac-6
  1182→ */
  1183→export async function computeToolUsageStats(
  1184→  specDir: string,
  1185→  sessionIds: string[],
  1186→  limit: number = 10,
  1187→): Promise<ToolUsageStats[]> {
  1188→  const toolCounts: Record<string, number> = {};
  1189→  let totalToolCalls = 0;
  1190→
  1191→  for (const sessionId of sessionIds) {
  1192→    const eventsPath = getSessionEventsPath(specDir, sessionId);
  1193→    try {
  1194→      const content = await fsPromises.readFile(eventsPath, "utf-8");
  1195→      if (!content.trim()) continue;
  1196→      const lines = content.trim().split("\n");
  1197→      // Track seen toolCallIds to deduplicate phased events
  1198→      const seenToolCallIds = new Set<string>();
  1199→      for (const line of lines) {
  1200→        // Quick pre-filter: only parse lines that might be tool_call events
  1201→        if (!line.includes('"tool_call"')) continue;
  1202→        try {
  1203→          const event = JSON.parse(line);
  1204→          if (event?.type === "session.update") {
  1205→            const update = event?.data?.update;
  1206→            if (update?.sessionUpdate === "tool_call") {
  1207→              // Deduplicate phased tool_call events by toolCallId
  1208→              const toolCallId = update?.toolCallId || update?.tool_call_id || update?.id;
  1209→              if (toolCallId && seenToolCallIds.has(toolCallId)) continue;
  1210→              if (toolCallId) seenToolCallIds.add(toolCallId);
  1211→              const toolName = update?._meta?.claudeCode?.toolName || "unknown";
  1212→              toolCounts[toolName] = (toolCounts[toolName] || 0) + 1;
  1213→              totalToolCalls++;
  1214→            }
  1215→          }
  1216→        } catch {
  1217→          // Skip unparseable lines
  1218→        }
  1219→      }
  1220→    } catch {
  1221→      // Skip sessions without events
  1222→    }
  1223→  }
  1224→
  1225→  // Sort by count descending, take top N
  1226→  const sorted = Object.entries(toolCounts)
  1227→    .map(([tool_name, count]) => ({
  1228→      tool_name,
  1229→      count,
  1230→      percentage: totalToolCalls > 0
  1231→        ? Math.round((count / totalToolCalls) * 100 * 10) / 10
  1232→        : 0,
  1233→    }))
  1234→    .sort((a, b) => b.count - a.count)
  1235→    .slice(0, limit);
  1236→
  1237→  return sorted;
  1238→}
  1239→
  1240→/**
  1241→ * Compute ISO-8601 week number and week-year in UTC.
  1242→ *
  1243→ * ISO-8601 rules:
  1244→ * - Week 1 contains the first Thursday of the year
  1245→ * - Week starts on Monday
  1246→ * - Week-year may differ from calendar year at year boundaries
  1247→ *
  1248→ * Returns [weekYear, weekNumber] tuple.
  1249→ */
  1250→function getISOWeekUTC(date: Date): [number, number] {
  1251→  // Clone and normalize to UTC midnight
  1252→  const d = new Date(Date.UTC(
  1253→    date.getUTCFullYear(),
  1254→    date.getUTCMonth(),
  1255→    date.getUTCDate()
  1256→  ));
  1257→
  1258→  // Get day of week (ISO: Monday=1, Sunday=7)
  1259→  const dayOfWeek = d.getUTCDay() || 7;
  1260→
  1261→  // Set to nearest Thursday (determines week-year)
  1262→  d.setUTCDate(d.getUTCDate() + 4 - dayOfWeek);
  1263→
  1264→  // Week-year is the year of this Thursday
  1265→  const weekYear = d.getUTCFullYear();
  1266→
  1267→  // January 4 is always in week 1 (as it's in the first week with a Thursday)
  1268→  const jan4 = new Date(Date.UTC(weekYear, 0, 4));
  1269→  const jan4DayOfWeek = jan4.getUTCDay() || 7;
  1270→
  1271→  // Start of week 1 (Monday before or on Jan 4)
  1272→  const week1Start = new Date(jan4);
  1273→  week1Start.setUTCDate(jan4.getUTCDate() - (jan4DayOfWeek - 1));
  1274→
  1275→  // Week number = weeks between week 1 start and the Thursday we found
  1276→  const weekNum = Math.floor((d.getTime() - week1Start.getTime()) / (7 * 24 * 60 * 60 * 1000)) + 1;
  1277→
  1278→  return [weekYear, weekNum];
  1279→}
  1280→
  1281→/**
  1282→ * Group sessions by time period (day or week).
  1283→ *
  1284→ * AC: @session-log-stats ac-7
  1285→ */
  1286→export function computeTimePeriodStats(
  1287→  summaries: SessionLogSummary[],
  1288→  groupBy: "day" | "week",
  1289→): TimePeriodStats[] {
  1290→  const buckets: Record<string, { sessions: number; tasks: number; duration: number }> = {};
  1291→
  1292→  for (const s of summaries) {
  1293→    const date = new Date(s.started_at);
  1294→    let period: string;
  1295→
  1296→    if (groupBy === "day") {
  1297→      period = date.toISOString().split("T")[0]; // YYYY-MM-DD in UTC
  1298→    } else {
  1299→      // Week: use ISO-8601 week format (YYYY-Www) in UTC
  1300→      const [weekYear, weekNum] = getISOWeekUTC(date);
  1301→      period = `${weekYear}-W${weekNum.toString().padStart(2, "0")}`;
  1302→    }
  1303→
  1304→    if (!buckets[period]) {
  1305→      buckets[period] = { sessions: 0, tasks: 0, duration: 0 };
  1306→    }
  1307→    buckets[period].sessions += 1;
  1308→    buckets[period].tasks += s.tasks_completed;
  1309→    buckets[period].duration += s.duration_ms;
  1310→  }
  1311→
  1312→  // Convert to array and sort by period (newest first for display)
  1313→  const result: TimePeriodStats[] = Object.entries(buckets)
  1314→    .map(([period, data]) => ({
  1315→      period,
  1316→      sessions_count: data.sessions,
  1317→      tasks_completed: data.tasks,
  1318→      total_duration_ms: data.duration,
  1319→    }))
  1320→    .sort((a, b) => b.period.localeCompare(a.period));
  1321→
  1322→  return result;
  1323→}
  1324→
  1325→// ─── Session Log Search ───────────────────────────────────────────────────────
  1326→
  1327→/**
  1328→ * A single search match result.
  1329→ *
  1330→ * AC: @session-log-search ac-4
  1331→ */
  1332→export interface SearchMatch {
  1333→  /** Session ID */
  1334→  session_id: string;
  1335→  /** Event timestamp (Unix ms) */
  1336→  timestamp: number;
  1337→  /** Event type */
  1338→  event_type: string;
  1339→  /** Matching content excerpt (limited to 200 chars) */
  1340→  content_excerpt: string;
  1341→}
  1342→
  1343→/**
  1344→ * Search results grouped by session.
  1345→ */
  1346→export interface SessionSearchResult {
  1347→  /** Session ID */
  1348→  session_id: string;
  1349→  /** Agent type for this session */
  1350→  agent_type: string;
  1351→  /** When the session started */
  1352→  started_at: string;
  1353→  /** Matches found in this session */
  1354→  matches: SearchMatch[];
  1355→}
  1356→
  1357→/**
  1358→ * Search options for filtering sessions and events.
  1359→ */
  1360→export interface SearchOptions {
  1361→  /** Only search events of this type (e.g., 'session.update', 'prompt.sent') */
  1362→  eventType?: string;
  1363→  /** Only search sessions started after this date */
  1364→  sinceDate?: Date;
  1365→  /** Only search sessions with this agent type */
  1366→  agentType?: string;
  1367→  /** Maximum total matches to return (default: 50) */
  1368→  limit?: number;
  1369→}
  1370→
  1371→/**
  1372→ * Extract a content excerpt around a match, limited to maxLength chars.
  1373→ *
  1374→ * AC: @session-log-search ac-4
  1375→ */
  1376→function extractContentExcerpt(
  1377→  data: unknown,
  1378→  pattern: string,
  1379→  maxLength: number = 200,
  1380→): string {
  1381→  // Stringify the data for searching
  1382→  const str = JSON.stringify(data);
  1383→  const lowerStr = str.toLowerCase();
  1384→  const lowerPattern = pattern.toLowerCase();
  1385→
  1386→  const matchIndex = lowerStr.indexOf(lowerPattern);
  1387→  if (matchIndex === -1) {
  1388→    // Shouldn't happen since we pre-filtered, but return start of content
  1389→    return str.length > maxLength ? str.slice(0, maxLength - 3) + "..." : str;
  1390→  }
  1391→
  1392→  // Calculate excerpt window centered on match
  1393→  const matchLen = pattern.length;
  1394→  const contextBefore = Math.floor((maxLength - matchLen) / 2);
  1395→  const start = Math.max(0, matchIndex - contextBefore);
  1396→  const end = Math.min(str.length, start + maxLength);
  1397→
  1398→  let excerpt = str.slice(start, end);
  1399→
  1400→  // Add ellipsis indicators
  1401→  if (start > 0) {
  1402→    excerpt = "..." + excerpt.slice(3);
  1403→  }
  1404→  if (end < str.length) {
  1405→    excerpt = excerpt.slice(0, -3) + "...";
  1406→  }
  1407→
  1408→  return excerpt;
  1409→}
  1410→
  1411→/**
  1412→ * Search across session events for a pattern.
  1413→ *
  1414→ * This streams through events.jsonl files, applying filters as early as possible
  1415→ * for performance. Sessions are pre-filtered by metadata (--since, --agent) before
  1416→ * scanning events to reduce I/O.
  1417→ *
  1418→ * AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7
  1419→ *
  1420→ * @param specDir - The .kspec directory path
  1421→ * @param pattern - Case-insensitive substring to search for
  1422→ * @param options - Search filtering options
  1423→ * @returns Array of search results grouped by session
  1424→ */
  1425→export async function searchSessionEvents(
  1426→  specDir: string,
  1427→  pattern: string,
  1428→  options: SearchOptions = {},
  1429→): Promise<SessionSearchResult[]> {
  1430→  // Defense-in-depth: normalize limit to a valid positive integer
  1431→  const rawLimit = options.limit ?? 50;
  1432→  const limit = Number.isNaN(rawLimit) || rawLimit <= 0 ? 50 : rawLimit;
  1433→  const lowerPattern = pattern.toLowerCase();
  1434→
  1435→  // Get all session summaries for metadata filtering
  1436→  const allSummaries = await getAllSessionLogSummaries(specDir);
  1437→
  1438→  // AC: @session-log-search ac-3 - Pre-filter by --since
  1439→  let filteredSummaries = allSummaries;
  1440→  if (options.sinceDate) {
  1441→    filteredSummaries = filteredSummaries.filter(
  1442→      (s) => new Date(s.started_at) >= options.sinceDate!,
  1443→    );
  1444→  }
  1445→
  1446→  // AC: @session-log-search ac-7 - Pre-filter by --agent
  1447→  if (options.agentType) {
  1448→    filteredSummaries = filteredSummaries.filter(
  1449→      (s) => s.agent_type === options.agentType,
  1450→    );
  1451→  }
  1452→
  1453→  const results: SessionSearchResult[] = [];
  1454→  let totalMatches = 0;
  1455→
  1456→  for (const summary of filteredSummaries) {
  1457→    if (totalMatches >= limit) break;
  1458→
  1459→    const eventsPath = getSessionEventsPath(specDir, summary.id);
  1460→    let content: string;
  1461→    try {
  1462→      content = await fsPromises.readFile(eventsPath, "utf-8");
  1463→    } catch {
  1464→      continue; // Skip sessions without events
  1465→    }
  1466→
  1467→    if (!content.trim()) continue;
  1468→
  1469→    const matches: SearchMatch[] = [];
  1470→    const lines = content.trim().split("\n");
  1471→    // Track seen tool_call IDs to skip phased duplicates
  1472→    const seenToolCallIds = new Set<string>();
  1473→
  1474→    for (const line of lines) {
  1475→      if (totalMatches >= limit) break;
  1476→
  1477→      // Quick substring pre-filter before parsing JSON
  1478→      if (!line.toLowerCase().includes(lowerPattern)) continue;
  1479→
  1480→      try {
  1481→        const event = JSON.parse(line);
  1482→
  1483→        // AC: @session-log-search ac-2 - Filter by event type
  1484→        if (options.eventType && event.type !== options.eventType) continue;
  1485→
  1486→        // Deduplicate phased tool_call events
  1487→        if (event?.type === "session.update") {
  1488→          const update = event?.data?.update;
  1489→          if (update?.sessionUpdate === "tool_call") {
  1490→            const toolCallId = update?.toolCallId || update?.tool_call_id || update?.id;
  1491→            if (toolCallId) {
  1492→              if (seenToolCallIds.has(toolCallId)) continue;
  1493→              seenToolCallIds.add(toolCallId);
  1494→            }
  1495→          }
  1496→        }
  1497→
  1498→        // Verify match in stringified data (not just line, in case pattern appears in metadata)
  1499→        const dataStr = JSON.stringify(event.data);
  1500→        if (!dataStr.toLowerCase().includes(lowerPattern)) continue;
  1501→
  1502→        // AC: @session-log-search ac-4 - Create match with excerpt
  1503→        matches.push({
  1504→          session_id: summary.id,
  1505→          timestamp: event.ts,
  1506→          event_type: event.type,
  1507→          content_excerpt: extractContentExcerpt(event.data, pattern, 200),
  1508→        });
  1509→        totalMatches++;
  1510→      } catch {
  1511→        // Skip unparseable lines
  1512→      }
  1513→    }
  1514→
  1515→    if (matches.length > 0) {
  1516→      results.push({
  1517→        session_id: summary.id,
  1518→        agent_type: summary.agent_type,
  1519→        started_at: summary.started_at,
  1520→        matches,
  1521→      });
  1522→    }
  1523→  }
  1524→
  1525→  return results;
  1526→}
  1527→