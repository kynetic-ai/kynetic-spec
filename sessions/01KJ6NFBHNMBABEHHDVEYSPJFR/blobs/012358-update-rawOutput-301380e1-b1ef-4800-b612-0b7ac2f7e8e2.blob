     1→/**
     2→ * Batch command parsing, validation, execution, and error reporting.
     3→ *
     4→ * Parses JSON batch input from stdin/file/inline, validates command paths
     5→ * against the CLI's introspection tree, executes in atomic or immediate
     6→ * mode, and produces helpful error messages.
     7→ */
     8→
     9→import * as fs from "node:fs/promises";
    10→import * as path from "node:path";
    11→import * as os from "node:os";
    12→import chalk from "chalk";
    13→import type { Command, CommanderError } from "commander";
    14→import { ZodError } from "zod";
    15→import {
    16→  BatchInputSchema,
    17→  type BatchCommand,
    18→  type BatchCommandResult,
    19→  type BatchExecMode,
    20→  type BatchExecResult,
    21→  type BatchInput,
    22→} from "../schema/batch.js";
    23→import { initContext } from "../parser/yaml.js";
    24→import { shadowAutoCommit, shadowPushAsync } from "../parser/shadow.js";
    25→import type { CommandMeta } from "./introspection.js";
    26→import { extractCommandTree, findCommand, flattenCommandTree } from "./introspection.js";
    27→import { findClosestCommand } from "./suggest.js";
    28→import { createBatchCommandFilter } from "./command-annotations.js";
    29→import { setJsonMode, setVerboseMode } from "./output.js";
    30→import {
    31→  BatchExitError,
    32→  OutputCapture,
    33→  installExitInterceptor,
    34→  uninstallExitInterceptor,
    35→  setBatchMode,
    36→  isBatchMode,
    37→} from "./batch-context.js";
    38→
    39→// ── Input Source Types ───────────────────────────────────────────────
    40→
    41→export type BatchInputSource =
    42→  | { type: "stdin" }
    43→  | { type: "file"; path: string }
    44→  | { type: "inline"; json: string };
    45→
    46→// ── Error Types ─────────────────────────────────────────────────────
    47→
    48→export class BatchParseError extends Error {
    49→  constructor(message: string) {
    50→    super(message);
    51→    this.name = "BatchParseError";
    52→  }
    53→}
    54→
    55→export type BatchValidationErrorType =
    56→  | "unknown_command"
    57→  | "missing_required"
    58→  | "unknown_arg"
    59→  | "rejected_command";
    60→
    61→export interface BatchValidationError {
    62→  /** Index in the batch array */
    63→  index: number;
    64→  /** Correlation ID if provided */
    65→  id?: string;
    66→  /** The command string from input */
    67→  command: string;
    68→  /** Error classification */
    69→  type: BatchValidationErrorType;
    70→  /** Human-readable error message */
    71→  message: string;
    72→  /** Suggested correction (e.g. closest command name) */
    73→  suggestion?: string;
    74→}
    75→
    76→export interface BatchValidationResult {
    77→  /** Whether all commands passed validation */
    78→  valid: boolean;
    79→  /** Validated commands (only present when valid) */
    80→  commands: BatchCommand[];
    81→  /** Validation errors */
    82→  errors: BatchValidationError[];
    83→}
    84→
    85→export interface ValidateBatchOptions {
    86→  /**
    87→   * Optional predicate to filter which commands are allowed.
    88→   * Extension point for allowed-commands task (@01KGR05NE).
    89→   * When provided, commands that don't pass the filter are rejected
    90→   * with a "rejected_command" error.
    91→   */
    92→  commandFilter?: (cmd: CommandMeta) => boolean;
    93→}
    94→
    95→// ── Parsing ─────────────────────────────────────────────────────────
    96→
    97→/**
    98→ * Read raw text from a batch input source.
    99→ */
   100→async function readSource(source: BatchInputSource): Promise<string> {
   101→  switch (source.type) {
   102→    case "inline":
   103→      return source.json;
   104→
   105→    case "file":
   106→      try {
   107→        return await fs.readFile(source.path, "utf-8");
   108→      } catch (err) {
   109→        throw new BatchParseError(
   110→          `Failed to read batch file: ${(err as Error).message}`,
   111→        );
   112→      }
   113→
   114→    case "stdin": {
   115→      const chunks: Buffer[] = [];
   116→      for await (const chunk of process.stdin) {
   117→        chunks.push(chunk as Buffer);
   118→      }
   119→      const text = Buffer.concat(chunks).toString("utf-8");
   120→      if (!text.trim()) {
   121→        throw new BatchParseError("No input received on stdin");
   122→      }
   123→      return text;
   124→    }
   125→  }
   126→}
   127→
   128→/**
   129→ * Parse batch input from a source, returning validated commands.
   130→ *
   131→ * @throws {BatchParseError} on invalid JSON, empty array, or schema violations
   132→ */
   133→export async function parseBatchInput(
   134→  source: BatchInputSource,
   135→): Promise<BatchInput> {
   136→  const raw = await readSource(source);
   137→
   138→  // Parse JSON — preserve the native error message which includes position
   139→  let parsed: unknown;
   140→  try {
   141→    parsed = JSON.parse(raw);
   142→  } catch (err) {
   143→    throw new BatchParseError(
   144→      `Invalid JSON: ${(err as SyntaxError).message}`,
   145→    );
   146→  }
   147→
   148→  // Validate against schema
   149→  try {
   150→    return BatchInputSchema.parse(parsed);
   151→  } catch (err) {
   152→    if (err instanceof ZodError) {
   153→      const messages = err.errors.map((e) => {
   154→        const path = e.path.length > 0 ? ` at ${e.path.join(".")}` : "";
   155→        return `${e.message}${path}`;
   156→      });
   157→      throw new BatchParseError(
   158→        `Batch validation failed: ${messages.join("; ")}`,
   159→      );
   160→    }
   161→    throw err;
   162→  }
   163→}
   164→
   165→// ── Validation ──────────────────────────────────────────────────────
   166→
   167→/**
   168→ * Extract the option name from Commander flag syntax.
   169→ * e.g. "-f, --force" → "force", "--spec-ref <value>" → "spec-ref"
   170→ */
   171→function extractOptionName(flags: string): string | null {
   172→  const match = flags.match(/--([a-zA-Z0-9-]+)/);
   173→  return match ? match[1] : null;
   174→}
   175→
   176→/**
   177→ * Convert a kebab-case string to camelCase.
   178→ * e.g. "spec-ref" → "specRef"
   179→ */
   180→function kebabToCamel(s: string): string {
   181→  return s.replace(/-([a-z])/g, (_, c) => c.toUpperCase());
   182→}
   183→
   184→/**
   185→ * Get all known argument and option names for a command, returning both
   186→ * kebab-case and camelCase variants.
   187→ */
   188→function getKnownArgNames(
   189→  cmd: CommandMeta,
   190→): { names: Set<string>; required: string[] } {
   191→  const names = new Set<string>();
   192→  const required: string[] = [];
   193→
   194→  // Positional arguments
   195→  for (const arg of cmd.arguments) {
   196→    names.add(arg.name);
   197→    names.add(kebabToCamel(arg.name));
   198→    if (arg.required) {
   199→      required.push(arg.name);
   200→    }
   201→  }
   202→
   203→  // Options
   204→  for (const opt of cmd.options) {
   205→    const optName = extractOptionName(opt.flags);
   206→    if (optName) {
   207→      names.add(optName);
   208→      names.add(kebabToCamel(optName));
   209→      if (opt.mandatory) {
   210→        required.push(optName);
   211→      }
   212→    }
   213→  }
   214→
   215→  return { names, required };
   216→}
   217→
   218→/**
   219→ * Collect all leaf command paths from a command tree as space-joined strings.
   220→ */
   221→function collectLeafCommandPaths(tree: CommandMeta): string[] {
   222→  const flat = flattenCommandTree(tree);
   223→  return flat
   224→    .filter((cmd) => cmd.subcommands.length === 0)
   225→    .map((cmd) => cmd.fullPath.slice(1).join(" ")) // skip root name
   226→    .filter((path) => path.length > 0);
   227→}
   228→
   229→/**
   230→ * Validate batch commands against the CLI's command tree.
   231→ *
   232→ * AC: @batch-command-schema ac-command-field — validates command paths
   233→ * AC: @batch-command-schema ac-args-mapping — validates arg names
   234→ * AC: @batch-command-schema ac-unknown-command — suggests similar commands
   235→ * AC: @batch-command-schema ac-missing-required — identifies missing args
   236→ * AC: @batch-command-schema ac-id-field — preserves id in errors
   237→ */
   238→export function validateBatchCommands(
   239→  commands: BatchCommand[],
   240→  program: CommandMeta,
   241→  options?: ValidateBatchOptions,
   242→): BatchValidationResult {
   243→  const errors: BatchValidationError[] = [];
   244→  const validLeafPaths = collectLeafCommandPaths(program);
   245→
   246→  for (let i = 0; i < commands.length; i++) {
   247→    const cmd = commands[i];
   248→    const parts = cmd.command.trim().split(/\s+/);
   249→
   250→    // 1. Resolve command path
   251→    const found = findCommand(program, parts);
   252→
   253→    if (!found) {
   254→      // Unknown command — suggest closest
   255→      const suggestion = findClosestCommand(cmd.command, validLeafPaths);
   256→      errors.push({
   257→        index: i,
   258→        id: cmd.id,
   259→        command: cmd.command,
   260→        type: "unknown_command",
   261→        message: `Unknown command: "${cmd.command}"`,
   262→        suggestion: suggestion ?? undefined,
   263→      });
   264→      continue;
   265→    }
   266→
   267→    // Reject command groups (non-leaf nodes)
   268→    if (found.subcommands.length > 0) {
   269→      const suggestion = findClosestCommand(cmd.command, validLeafPaths);
   270→      errors.push({
   271→        index: i,
   272→        id: cmd.id,
   273→        command: cmd.command,
   274→        type: "unknown_command",
   275→        message: `"${cmd.command}" is a command group, not an executable command`,
   276→        suggestion: suggestion ?? undefined,
   277→      });
   278→      continue;
   279→    }
   280→
   281→    // 2. Reject nested batch commands (batch or any subcommands like batch commands)
   282→    // AC: @batch-allowed-commands ac-batch-itself
   283→    if (found.fullPath[1] === "batch") {
   284→      errors.push({
   285→        index: i,
   286→        id: cmd.id,
   287→        command: cmd.command,
   288→        type: "rejected_command",
   289→        message: "Nested batch commands are not allowed",
   290→      });
   291→      continue;
   292→    }
   293→
   294→    // 3. Apply command filter if provided
   295→    // AC: @batch-allowed-commands ac-denylist
   296→    if (options?.commandFilter && !options.commandFilter(found)) {
   297→      errors.push({
   298→        index: i,
   299→        id: cmd.id,
   300→        command: cmd.command,
   301→        type: "rejected_command",
   302→        message: `Command "${cmd.command}" is not allowed in batch mode. Only mutating commands can be used in batch.`,
   303→      });
   304→      continue;
   305→    }
   306→
   307→    // 4. Check for unknown args
   308→    const { names: knownNames, required: requiredNames } =
   309→      getKnownArgNames(found);
   310→
   311→    // Collect all known names as flat array for suggestion matching
   312→    const knownNamesArray = Array.from(knownNames);
   313→
   314→    for (const argKey of Object.keys(cmd.args)) {
   315→      // Accept both kebab-case and camelCase
   316→      if (!knownNames.has(argKey)) {
   317→        const suggestion = findClosestCommand(argKey, knownNamesArray);
   318→        errors.push({
   319→          index: i,
   320→          id: cmd.id,
   321→          command: cmd.command,
   322→          type: "unknown_arg",
   323→          message: `Unknown argument "${argKey}" for command "${cmd.command}"`,
   324→          suggestion: suggestion ?? undefined,
   325→        });
   326→      }
   327→    }
   328→
   329→    // 5. Check for missing required args
   330→    for (const reqName of requiredNames) {
   331→      const camelName = kebabToCamel(reqName);
   332→      if (
   333→        !(reqName in cmd.args) &&
   334→        !(camelName in cmd.args) &&
   335→        // Skip if provided via positional alias
   336→        !Object.keys(cmd.args).some(
   337→          (k) => kebabToCamel(k) === camelName,
   338→        )
   339→      ) {
   340→        errors.push({
   341→          index: i,
   342→          id: cmd.id,
   343→          command: cmd.command,
   344→          type: "missing_required",
   345→          message: `Missing required argument "${reqName}" for command "${cmd.command}"`,
   346→        });
   347→      }
   348→    }
   349→  }
   350→
   351→  return {
   352→    valid: errors.length === 0,
   353→    commands,
   354→    errors,
   355→  };
   356→}
   357→
   358→// ── Error Reporting ─────────────────────────────────────────────────
   359→
   360→/**
   361→ * Format validation errors for human or JSON output.
   362→ *
   363→ * @param result - Validation result containing errors
   364→ * @param json - If true, return JSON string; otherwise human-readable lines
   365→ * @returns Formatted error string
   366→ */
   367→export function reportBatchValidationErrors(
   368→  result: BatchValidationResult,
   369→  json: boolean = false,
   370→): string {
   371→  if (result.valid) {
   372→    return json ? JSON.stringify({ valid: true, errors: [] }) : "";
   373→  }
   374→
   375→  if (json) {
   376→    return JSON.stringify(
   377→      {
   378→        valid: false,
   379→        errors: result.errors,
   380→      },
   381→      null,
   382→      2,
   383→    );
   384→  }
   385→
   386→  // Human-readable format
   387→  const lines: string[] = [];
   388→  for (const err of result.errors) {
   389→    const label = err.id ?? `#${err.index}`;
   390→    lines.push(`[${label}] ${err.message}`);
   391→    if (err.suggestion) {
   392→      lines.push(`  Did you mean: ${err.suggestion}?`);
   393→    }
   394→  }
   395→  // Add helpful hint for discoverability
   396→  lines.push("");
   397→  lines.push("Run 'kspec batch commands' for a list of available commands.");
   398→  return lines.join("\n");
   399→}
   400→
   401→// ── Execution Engine ─────────────────────────────────────────────────
   402→
   403→export interface ExecuteBatchOptions {
   404→  /** Use atomic mode (default true) */
   405→  atomic: boolean;
   406→  /** Continue on error (implies immediate mode) */
   407→  continueOnError: boolean;
   408→  /** Validate-only mode */
   409→  dryRun: boolean;
   410→  /** JSON output */
   411→  json: boolean;
   412→}
   413→
   414→/**
   415→ * Build Commander argv from a BatchCommand and its CommandMeta.
   416→ *
   417→ * Translates { command: "inbox add", args: { content: "hello", tag: ["a","b"] } }
   418→ * into ["inbox", "add", "hello", "--tag", "a", "--tag", "b"]
   419→ *
   420→ * Positional args are emitted in Commander definition order (not JSON key order)
   421→ * to ensure correct argument mapping regardless of how the JSON was serialized.
   422→ */
   423→/**
   424→ * Serialize a value for CLI argv. Plain objects are JSON-stringified
   425→ * so that flags like --data receive valid JSON instead of "[object Object]".
   426→ */
   427→function toArgString(value: unknown): string {
   428→  if (typeof value === "object" && value !== null && !Array.isArray(value)) {
   429→    return JSON.stringify(value);
   430→  }
   431→  return String(value);
   432→}
   433→
   434→export function buildCommandArgv(cmd: BatchCommand, cmdMeta: CommandMeta): string[] {
   435→  const argv: string[] = [...cmd.command.trim().split(/\s+/)];
   436→
   437→  // Build sets for classification
   438→  const positionalDefs = cmdMeta.arguments; // ordered by Commander definition
   439→  const positionalNameSet = new Set<string>();
   440→  for (const arg of positionalDefs) {
   441→    positionalNameSet.add(arg.name);
   442→    positionalNameSet.add(kebabToCamel(arg.name));
   443→  }
   444→
   445→  const optionMap = new Map<string, { flags: string; variadic: boolean }>();
   446→  for (const opt of cmdMeta.options) {
   447→    const name = extractOptionName(opt.flags);
   448→    if (name) {
   449→      optionMap.set(name, { flags: opt.flags, variadic: opt.variadic });
   450→      optionMap.set(kebabToCamel(name), { flags: opt.flags, variadic: opt.variadic });
   451→    }
   452→  }
   453→
   454→  // Phase 1: Emit positional args in Commander definition order
   455→  for (const argDef of positionalDefs) {
   456→    const name = argDef.name;
   457→    const camelName = kebabToCamel(name);
   458→    const value = cmd.args[name] ?? cmd.args[camelName];
   459→    if (value === undefined) continue;
   460→
   461→    if (Array.isArray(value)) {
   462→      for (const v of value) argv.push(toArgString(v));
   463→    } else {
   464→      argv.push(toArgString(value));
   465→    }
   466→  }
   467→
   468→  // Phase 2: Emit options from remaining keys
   469→  for (const [key, value] of Object.entries(cmd.args)) {
   470→    const camelKey = kebabToCamel(key);
   471→    // Skip positional args (already emitted)
   472→    if (positionalNameSet.has(key) || positionalNameSet.has(camelKey)) {
   473→      continue;
   474→    }
   475→
   476→    // Convert camelCase key back to kebab-case for CLI
   477→    const kebabKey = key.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`);
   478→    const flagName = `--${kebabKey}`;
   479→
   480→    if (typeof value === "boolean") {
   481→      if (value) {
   482→        argv.push(flagName);
   483→      }
   484→      // false booleans: omit (Commander treats absence as false)
   485→    } else if (Array.isArray(value)) {
   486→      // Variadic or repeated options
   487→      for (const v of value) {
   488→        argv.push(flagName, toArgString(v));
   489→      }
   490→    } else if (value !== null && value !== undefined) {
   491→      argv.push(flagName, toArgString(value));
   492→    }
   493→  }
   494→
   495→  return argv;
   496→}
   497→
   498→/**
   499→ * Reset Commander command tree state between dispatches.
   500→ * Commander retains _optionValues between parseAsync calls.
   501→ */
   502→export function resetCommandTree(cmd: Command): void {
   503→  (cmd as any)._optionValues = {};
   504→  (cmd as any)._optionValueSources = {};
   505→  (cmd as any).processedArgs = [];
   506→  for (const sub of cmd.commands) {
   507→    resetCommandTree(sub);
   508→  }
   509→}
   510→
   511→/**
   512→ * Check if a CommandMeta supports the --force option.
   513→ */
   514→function commandHasForce(cmdMeta: CommandMeta): boolean {
   515→  return cmdMeta.options.some((opt) => {
   516→    const name = extractOptionName(opt.flags);
   517→    return name === "force";
   518→  });
   519→}
   520→
   521→/**
   522→ * Execute a batch of commands.
   523→ *
   524→ * AC: @batch-exec ac-default-atomic — atomic mode by default
   525→ * AC: @batch-exec ac-no-atomic-flag — immediate mode with --no-atomic
   526→ * AC: @batch-exec ac-stop-on-error — stop on first failure (default)
   527→ * AC: @batch-exec ac-continue — continue on error with --continue
   528→ * AC: @batch-exec ac-dry-run — validate without executing
   529→ * AC: @batch-exec ac-prevalidate — validation before any execution
   530→ * AC: @batch-exec ac-confirmation-suppressed — auto-append --force
   531→ */
   532→export async function executeBatch(
   533→  commands: BatchCommand[],
   534→  program: Command,
   535→  options: ExecuteBatchOptions,
   536→): Promise<BatchExecResult> {
   537→  const mode: BatchExecMode = options.atomic ? "atomic" : "immediate";
   538→
   539→  // Build command tree for validation
   540→  const tree = extractCommandTree(program);
   541→  const commandFilter = createBatchCommandFilter();
   542→
   543→  // AC: ac-prevalidate — validate all commands before executing any
   544→  const validation = validateBatchCommands(commands, tree, { commandFilter });
   545→  if (!validation.valid) {
   546→    return {
   547→      success: false,
   548→      mode,
   549→      summary: {
   550→        total: commands.length,
   551→        succeeded: 0,
   552→        failed: validation.errors.length,
   553→      },
   554→      results: validation.errors.map((err) => ({
   555→        index: err.index,
   556→        id: err.id,
   557→        command: err.command,
   558→        success: false,
   559→        error: err.message,
   560→        suggestion: err.suggestion,
   561→      })),
   562→      validationFailed: true,
   563→    };
   564→  }
   565→
   566→  // AC: ac-dry-run — validate without executing
   567→  // AC: @trait-dry-run ac-6 — include dry_run boolean in JSON output
   568→  if (options.dryRun) {
   569→    return {
   570→      success: true,
   571→      dry_run: true,
   572→      mode,
   573→      summary: { total: commands.length, succeeded: commands.length, failed: 0 },
   574→      results: commands.map((cmd, i) => ({
   575→        index: i,
   576→        id: cmd.id,
   577→        command: cmd.command,
   578→        success: true,
   579→        output: "dry-run: would execute",
   580→      })),
   581→    };
   582→  }
   583→
   584→  if (options.atomic) {
   585→    return executeAtomic(commands, program, tree, options);
   586→  } else {
   587→    return executeImmediate(commands, program, tree, options);
   588→  }
   589→}
   590→
   591→/**
   592→ * Atomic execution: copy specDir to temp, run all, copy back on success.
   593→ *
   594→ * AC: @batch-exec ac-default-atomic
   595→ * AC: @batch-exec ac-atomic-rollback
   596→ * AC: @batch-exec ac-atomic-isolation
   597→ * AC: @batch-exec ac-single-commit
   598→ */
   599→async function executeAtomic(
   600→  commands: BatchCommand[],
   601→  program: Command,
   602→  tree: CommandMeta,
   603→  options: ExecuteBatchOptions,
   604→): Promise<BatchExecResult> {
   605→  // Get the real context for copy-back
   606→  const ctx = await initContext();
   607→  const realSpecDir = ctx.specDir;
   608→
   609→  // Create temp copy using mkdtemp for safe, collision-free naming
   610→  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-batch-"));
   611→  await fs.cp(realSpecDir, tempDir, { recursive: true });
   612→
   613→  // Remove .git from temp copy to prevent worktree pointer leaks
   614→  await fs.rm(path.join(tempDir, ".git"), { force: true, recursive: true });
   615→
   616→  // Set up atomic context
   617→  const savedChalkLevel = chalk.level;
   618→  const savedSpecDir = process.env.KSPEC_SPEC_DIR;
   619→  const savedBatchProjectRoot = process.env.KSPEC_BATCH_PROJECT_ROOT;
   620→  // AC: @project-config ac-7 — set real project root before redirecting spec dir
   621→  process.env.KSPEC_BATCH_PROJECT_ROOT = ctx.rootDir;
   622→  process.env.KSPEC_SPEC_DIR = tempDir;
   623→  setBatchMode(true);
   624→  chalk.level = 0;
   625→
   626→  const results: BatchCommandResult[] = [];
   627→  let allSucceeded = true;
   628→  let copyBackFailed = false;
   629→
   630→  try {
   631→    for (let i = 0; i < commands.length; i++) {
   632→      const cmd = commands[i];
   633→      const result = await dispatchCommand(cmd, i, program, tree);
   634→      results.push(result);
   635→
   636→      if (!result.success) {
   637→        allSucceeded = false;
   638→        // Atomic mode: stop on first failure, discard everything
   639→        // Fill remaining as not-executed
   640→        for (let j = i + 1; j < commands.length; j++) {
   641→          results.push({
   642→            index: j,
   643→            id: commands[j].id,
   644→            command: commands[j].command,
   645→            success: false,
   646→            error: "Not executed (prior command failed in atomic mode)",
   647→          });
   648→        }
   649→        break;
   650→      }
   651→    }
   652→
   653→    // Copy back on success
   654→    if (allSucceeded) {
   655→      try {
   656→        // Clear real specDir contents (except .git and .gitattributes) before copy-back
   657→        const entries = await fs.readdir(realSpecDir);
   658→        for (const entry of entries) {
   659→          if (entry === ".git" || entry === ".gitattributes") continue;
   660→          await fs.rm(path.join(realSpecDir, entry), { recursive: true, force: true });
   661→        }
   662→        // Copy temp contents back
   663→        const tempEntries = await fs.readdir(tempDir);
   664→        for (const entry of tempEntries) {
   665→          await fs.cp(
   666→            path.join(tempDir, entry),
   667→            path.join(realSpecDir, entry),
   668→            { recursive: true },
   669→          );
   670→        }
   671→
   672→        // Single shadow commit for all changes
   673→        if (ctx.shadow?.enabled) {
   674→          const successCount = results.filter((r) => r.success).length;
   675→          await shadowAutoCommit(
   676→            ctx.shadow.worktreeDir,
   677→            `batch: ${successCount} command${successCount !== 1 ? "s" : ""}`,
   678→          );
   679→          shadowPushAsync(ctx.shadow.worktreeDir);
   680→        }
   681→      } catch (copyErr) {
   682→        // Copy-back failed — preserve tempDir for manual recovery
   683→        copyBackFailed = true;
   684→        allSucceeded = false;
   685→        console.error(
   686→          `Batch copy-back failed: ${copyErr instanceof Error ? copyErr.message : copyErr}`,
   687→        );
   688→        console.error(`Temp dir preserved for recovery: ${tempDir}`);
   689→      }
   690→    }
   691→  } finally {
   692→    // Clean up
   693→    setBatchMode(false);
   694→    chalk.level = savedChalkLevel;
   695→    if (savedSpecDir !== undefined) {
   696→      process.env.KSPEC_SPEC_DIR = savedSpecDir;
   697→    } else {
   698→      delete process.env.KSPEC_SPEC_DIR;
   699→    }
   700→    // AC: @project-config ac-7 — restore batch project root env var
   701→    if (savedBatchProjectRoot !== undefined) {
   702→      process.env.KSPEC_BATCH_PROJECT_ROOT = savedBatchProjectRoot;
   703→    } else {
   704→      delete process.env.KSPEC_BATCH_PROJECT_ROOT;
   705→    }
   706→    // Only remove temp dir if copy-back succeeded (or commands failed)
   707→    if (!copyBackFailed) {
   708→      await fs.rm(tempDir, { recursive: true, force: true }).catch(() => {});
   709→    }
   710→  }
   711→
   712→  const succeeded = results.filter((r) => r.success).length;
   713→  const failed = results.filter((r) => !r.success).length;
   714→
   715→  return {
   716→    success: allSucceeded,
   717→    mode: "atomic",
   718→    summary: { total: commands.length, succeeded, failed },
   719→    results,
   720→  };
   721→}
   722→
   723→/**
   724→ * Immediate execution: execute against real state, per-command commits.
   725→ *
   726→ * AC: @batch-exec ac-no-atomic-flag
   727→ * AC: @batch-exec ac-immediate-per-commit
   728→ * AC: @batch-exec ac-immediate-no-rollback
   729→ */
   730→async function executeImmediate(
   731→  commands: BatchCommand[],
   732→  program: Command,
   733→  tree: CommandMeta,
   734→  options: ExecuteBatchOptions,
   735→): Promise<BatchExecResult> {
   736→  const savedChalkLevel = chalk.level;
   737→  chalk.level = 0;
   738→
   739→  const results: BatchCommandResult[] = [];
   740→
   741→  try {
   742→    for (let i = 0; i < commands.length; i++) {
   743→      const cmd = commands[i];
   744→      const result = await dispatchCommand(cmd, i, program, tree);
   745→      results.push(result);
   746→
   747→      if (!result.success && !options.continueOnError) {
   748→        // Stop on first failure, remaining not executed
   749→        for (let j = i + 1; j < commands.length; j++) {
   750→          results.push({
   751→            index: j,
   752→            id: commands[j].id,
   753→            command: commands[j].command,
   754→            success: false,
   755→            error: "Not executed (prior command failed)",
   756→          });
   757→        }
   758→        break;
   759→      }
   760→    }
   761→  } finally {
   762→    chalk.level = savedChalkLevel;
   763→  }
   764→
   765→  const succeeded = results.filter((r) => r.success).length;
   766→  const failed = results.filter((r) => !r.success).length;
   767→
   768→  return {
   769→    success: failed === 0,
   770→    mode: "immediate",
   771→    summary: { total: commands.length, succeeded, failed },
   772→    results,
   773→  };
   774→}
   775→
   776→/**
   777→ * Dispatch a single command through Commander's parseAsync.
   778→ */
   779→async function dispatchCommand(
   780→  cmd: BatchCommand,
   781→  index: number,
   782→  program: Command,
   783→  tree: CommandMeta,
   784→): Promise<BatchCommandResult> {
   785→  const parts = cmd.command.trim().split(/\s+/);
   786→  const cmdMeta = findCommand(tree, parts);
   787→  if (!cmdMeta) {
   788→    return {
   789→      index,
   790→      id: cmd.id,
   791→      command: cmd.command,
   792→      success: false,
   793→      error: `Command not found: ${cmd.command}`,
   794→    };
   795→  }
   796→
   797→  // Build argv, auto-appending --force if supported
   798→  // AC: ac-confirmation-suppressed
   799→  const enrichedCmd = { ...cmd, args: { ...cmd.args } };
   800→  if (commandHasForce(cmdMeta) && !("force" in enrichedCmd.args)) {
   801→    enrichedCmd.args.force = true;
   802→  }
   803→  const argv = buildCommandArgv(enrichedCmd, cmdMeta);
   804→
   805→  // Reset Commander state
   806→  resetCommandTree(program);
   807→  setJsonMode(false);
   808→  setVerboseMode(false);
   809→
   810→  const capture = new OutputCapture();
   811→  capture.start();
   812→  installExitInterceptor();
   813→
   814→  let caughtError: unknown = undefined;
   815→  let succeeded = false;
   816→
   817→  try {
   818→    await program.parseAsync(argv, { from: "user" });
   819→    succeeded = true;
   820→  } catch (err) {
   821→    caughtError = err;
   822→  } finally {
   823→    capture.stop();
   824→    uninstallExitInterceptor();
   825→  }
   826→
   827→  if (succeeded) {
   828→    const output = capture.getOutput();
   829→    // Try to parse output as JSON for structured results
   830→    let parsedOutput: unknown = output;
   831→    try {
   832→      parsedOutput = JSON.parse(output);
   833→    } catch {
   834→      // Not JSON, keep as string
   835→    }
   836→
   837→    return {
   838→      index,
   839→      id: cmd.id,
   840→      command: cmd.command,
   841→      success: true,
   842→      output: parsedOutput,
   843→    };
   844→  }
   845→
   846→  // Handle errors
   847→  const err = caughtError;
   848→
   849→  if (err instanceof BatchExitError) {
   850→    // Filter out BatchExitError noise from captured output (handlers may
   851→    // catch and re-log the error before calling process.exit again)
   852→    const capturedOutput = capture
   853→      .getOutput()
   854→      .split("\n")
   855→      .filter((line) => !line.includes("BatchExitError"))
   856→      .join("\n")
   857→      .trim();
   858→
   859→    if (err.code === 0) {
   860→      return {
   861→        index,
   862→        id: cmd.id,
   863→        command: cmd.command,
   864→        success: true,
   865→        output: capturedOutput,
   866→      };
   867→    }
   868→    return {
   869→      index,
   870→      id: cmd.id,
   871→      command: cmd.command,
   872→      success: false,
   873→      error: capturedOutput || `Command exited with code ${err.code}`,
   874→    };
   875→  }
   876→
   877→  // Commander errors (e.g., missing required arg at runtime)
   878→  const isCommanderError =
   879→    err && typeof err === "object" && "code" in err && "exitCode" in err;
   880→  if (isCommanderError) {
   881→    const cmdErr = err as unknown as { message: string; exitCode: number };
   882→    return {
   883→      index,
   884→      id: cmd.id,
   885→      command: cmd.command,
   886→      success: false,
   887→      error: cmdErr.message || capture.getOutput(),
   888→    };
   889→  }
   890→
   891→  // Generic errors
   892→  return {
   893→    index,
   894→    id: cmd.id,
   895→    command: cmd.command,
   896→    success: false,
   897→    error: err instanceof Error ? err.message : String(err),
   898→  };
   899→}
   900→