     1→/**
     2→ * Tests for loop mode error handling utilities.
     3→ *
     4→ * AC: @loop-mode-error-handling (all 9 ACs)
     5→ */
     6→
     7→import { describe, expect, it } from "vitest";
     8→import type { Task } from "../src/schema/task.js";
     9→import {
    10→  createFailureNote,
    11→  getTaskFailureCount,
    12→  hasTaskProgress,
    13→  isIterationFailure,
    14→  parseFailureCount,
    15→  processFailedIteration,
    16→  shouldEscalate,
    17→} from "../src/ralph/loop-errors.js";
    18→
    19→describe("Loop Mode Error Handling", () => {
    20→  describe("parseFailureCount", () => {
    21→    // AC: @loop-mode-error-handling ac-4
    22→    it("should parse failure count from [LOOP-FAIL:N] prefix", () => {
    23→      expect(parseFailureCount("[LOOP-FAIL:1] Task failed")).toBe(1);
    24→      expect(parseFailureCount("[LOOP-FAIL:2] Another failure")).toBe(2);
    25→      expect(parseFailureCount("[LOOP-FAIL:10] Many failures")).toBe(10);
    26→    });
    27→
    28→    // AC: @loop-mode-error-handling ac-4
    29→    it("should return 0 for non-failure notes", () => {
    30→      expect(parseFailureCount("Normal note")).toBe(0);
    31→      expect(parseFailureCount("Working on task")).toBe(0);
    32→      expect(parseFailureCount("")).toBe(0);
    33→    });
    34→
    35→    // AC: @loop-mode-error-handling ac-4
    36→    it("should return 0 for malformed failure prefix", () => {
    37→      expect(parseFailureCount("[LOOP-FAIL] Missing number")).toBe(0);
    38→      expect(parseFailureCount("LOOP-FAIL:1 Missing brackets")).toBe(0);
    39→      expect(parseFailureCount("[LOOP-FAIL:abc] Invalid number")).toBe(0);
    40→    });
    41→  });
    42→
    43→  describe("getTaskFailureCount", () => {
    44→    // AC: @loop-mode-error-handling ac-4
    45→    it("should return highest failure count from task notes", () => {
    46→      const task: Task = {
    47→        _ulid: "01TEST000000000000000000000",
    48→        slugs: [],
