   117→
   118→  describe("createFailureNote", () => {
   119→    // AC: @loop-mode-error-handling ac-1, ac-3
   120→    it("should create failure note with incremented count", () => {
   121→      const note1 = createFailureNote("@task-ref", "Tests failed", 0);
   122→      expect(note1).toBe("[LOOP-FAIL:1] Task @task-ref failed: Tests failed");
   123→
   124→      const note2 = createFailureNote("@task-ref", "Still failing", 1);
   125→      expect(note2).toBe("[LOOP-FAIL:2] Task @task-ref failed: Still failing");
   126→
   127→      const note3 = createFailureNote("@task-ref", "Third time", 2);
   128→      expect(note3).toBe("[LOOP-FAIL:3] Task @task-ref failed: Third time");
   129→    });
   130→
   131→    // AC: @loop-mode-error-handling ac-3
   132→    it("should include error description in note", () => {
   133→      const note = createFailureNote(
   134→        "@task-ref",
   135→        "Build failed with exit code 1",
   136→        0,
   137→      );
   138→      expect(note).toContain("Build failed with exit code 1");
   139→    });
   140→  });
   141→
   142→  describe("shouldEscalate", () => {
   143→    // AC: @loop-mode-error-handling ac-5
   144→    it("should return true at threshold of 3 failures", () => {
   145→      expect(shouldEscalate(3)).toBe(true);
   146→      expect(shouldEscalate(4)).toBe(true);
   147→      expect(shouldEscalate(10)).toBe(true);
   148→    });
   149→
   150→    // AC: @loop-mode-error-handling ac-5
   151→    it("should return false below threshold", () => {
   152→      expect(shouldEscalate(0)).toBe(false);
   153→      expect(shouldEscalate(1)).toBe(false);
   154→      expect(shouldEscalate(2)).toBe(false);
   155→    });
   156→  });
   157→
   158→  describe("isIterationFailure", () => {
   159→    // AC: @loop-mode-error-handling ac-7
   160→    it("should detect explicit failure", () => {
   161→      expect(isIterationFailure({ succeeded: false })).toBe(true);
   162→    });
   163→
   164→    // AC: @loop-mode-error-handling ac-7
   165→    it("should detect error thrown", () => {
   166→      expect(
   167→        isIterationFailure({ error: new Error("Something broke") }),
   168→      ).toBe(true);
   169→    });
   170→
   171→    // AC: @loop-mode-error-handling ac-7
   172→    it("should detect cancelled stop reason", () => {
   173→      expect(isIterationFailure({ stopReason: "cancelled" })).toBe(true);
   174→    });
   175→
   176→    // AC: @loop-mode-error-handling ac-7
   177→    it("should return false for successful iteration", () => {
   178→      expect(isIterationFailure({ succeeded: true })).toBe(false);
   179→      expect(isIterationFailure({ stopReason: "end_turn" })).toBe(false);
   180→      expect(isIterationFailure({})).toBe(false);
   181→    });
   182→  });
   183→
   184→  describe("hasTaskProgress", () => {
