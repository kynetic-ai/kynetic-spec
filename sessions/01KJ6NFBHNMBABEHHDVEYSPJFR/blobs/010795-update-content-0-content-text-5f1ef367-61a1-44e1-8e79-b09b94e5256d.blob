   436→
   437→    // AC: @loop-mode-error-handling ac-2
   438→    it("should handle multiple tasks independently", () => {
   439→      const tasksInProgress: Task[] = [
   440→        {
   441→          _ulid: "01TASK1",
   442→          slugs: [],
   443→          title: "Task 1",
   444→          type: "task",
   445→          status: "in_progress",
   446→        },
   447→        {
   448→          _ulid: "01TASK2",
   449→          slugs: [],
   450→          title: "Task 2",
   451→          type: "task",
   452→          status: "in_progress",
   453→        },
   454→      ];
   455→
   456→      const currentTasks: Task[] = [
   457→        { ...tasksInProgress[0] }, // Still in progress, no notes
   458→        {
   459→          ...tasksInProgress[1],
   460→          notes: [
   461→            {
   462→              _ulid: "01NOTE1",
   463→              created_at: "2024-01-10T13:00:00Z",
   464→              author: "@test",
   465→              content: "Made progress",
   466→            },
   467→          ],
   468→        },
   469→      ];
   470→
   471→      const results = processFailedIteration(
   472→        tasksInProgress,
   473→        currentTasks,
   474→        iterationStart,
   475→        "Iteration failed",
   476→      );
   477→
   478→      // Only Task 1 should have failure tracked
