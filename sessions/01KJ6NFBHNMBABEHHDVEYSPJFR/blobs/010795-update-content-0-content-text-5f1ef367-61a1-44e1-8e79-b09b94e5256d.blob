   480→      expect(results[0].taskRef).toBe("01TASK1");
   481→    });
   482→
   483→    // AC: @loop-mode-error-handling ac-9
   484→    it("should count iteration as single failure regardless of phase", () => {
   485→      // AC-9 states "each error noted separately, iteration counts as single failure"
   486→      // Implementation note: phases run sequentially (task-work then reflect)
   487→      // If task-work fails, reflect doesn't run
   488→      // If reflect fails, only reflect error captured
   489→      // Either way, iteration fails once → consecutiveFailures += 1
   490→
   491→      const tasksInProgress: Task[] = [
   492→        {
   493→          _ulid: "01TASK1",
   494→          slugs: [],
   495→          title: "Task 1",
   496→          type: "task",
   497→          status: "in_progress",
   498→        },
   499→      ];
   500→
   501→      const currentTasks: Task[] = [{ ...tasksInProgress[0] }];
   502→      const iterationStart = new Date("2024-01-10T12:00:00Z");
   503→
   504→      // Single call to processFailedIteration per iteration
   505→      const results = processFailedIteration(
   506→        tasksInProgress,
   507→        currentTasks,
   508→        iterationStart,
   509→        "Iteration failed (task-work or reflect phase)",
   510→      );
   511→
   512→      // One failure note per task without progress
   513→      expect(results).toHaveLength(1);
   514→      expect(results[0].failureCount).toBe(1);
   515→      expect(results[0].noteAdded).toBe(true);
   516→    });
   517→  });
   518→});
