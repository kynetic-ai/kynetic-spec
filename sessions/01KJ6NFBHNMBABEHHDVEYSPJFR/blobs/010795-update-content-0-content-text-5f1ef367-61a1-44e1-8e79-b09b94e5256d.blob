   389→    });
   390→
   391→    // AC: @loop-mode-error-handling ac-8
   392→    it("should skip tasks that made progress", () => {
   393→      const tasksInProgress: Task[] = [
   394→        {
   395→          _ulid: "01TASK1",
   396→          slugs: [],
   397→          title: "Task 1",
   398→          type: "task",
   399→          status: "in_progress",
   400→          notes: [
   401→            {
   402→              _ulid: "01NOTE1",
   403→              created_at: "2024-01-10T11:00:00Z",
   404→              author: "@test",
   405→              content: "Old note",
   406→            },
   407→          ],
   408→        },
   409→      ];
   410→
   411→      const currentTasks: Task[] = [
   412→        {
   413→          ...tasksInProgress[0],
   414→          notes: [
   415→            ...tasksInProgress[0].notes!,
   416→            {
   417→              _ulid: "01NOTE2",
   418→              created_at: "2024-01-10T13:00:00Z", // After iteration start
   419→              author: "@test",
   420→              content: "Made progress",
   421→            },
   422→          ],
   423→        },
   424→      ];
   425→
   426→      const results = processFailedIteration(
   427→        tasksInProgress,
   428→        currentTasks,
   429→        iterationStart,
   430→        "Iteration failed",
   431→      );
   432→
   433→      // Task made progress, so no failure recorded
