    82→
    83→    // AC: @loop-mode-error-handling ac-4
    84→    it("should return 0 for task with no failure notes", () => {
    85→      const task: Task = {
    86→        _ulid: "01TEST000000000000000000000",
    87→        slugs: [],
    88→        title: "Test Task",
    89→        type: "task",
    90→        status: "in_progress",
    91→        notes: [
    92→          {
    93→            _ulid: "01NOTE1",
