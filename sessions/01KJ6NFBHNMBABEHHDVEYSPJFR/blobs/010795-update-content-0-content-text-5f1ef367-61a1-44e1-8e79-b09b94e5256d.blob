   276→  describe("processFailedIteration", () => {
   277→    const iterationStart = new Date("2024-01-10T12:00:00Z");
   278→
   279→    // AC: @loop-mode-error-handling ac-8
   280→    it("should identify tasks without progress", () => {
   281→      const tasksInProgress: Task[] = [
   282→        {
   283→          _ulid: "01TASK1",
   284→          slugs: [],
   285→          title: "Task 1",
   286→          type: "task",
   287→          status: "in_progress",
   288→          notes: [
   289→            {
   290→              _ulid: "01NOTE1",
   291→              created_at: "2024-01-10T11:00:00Z",
   292→              author: "@test",
   293→              content: "Old note",
   294→            },
   295→          ],
   296→        },
   297→      ];
   298→
   299→      const currentTasks: Task[] = [
   300→        {
   301→          ...tasksInProgress[0],
   302→          // Still in_progress, no new notes
   303→        },
   304→      ];
   305→
   306→      const results = processFailedIteration(
   307→        tasksInProgress,
   308→        currentTasks,
   309→        iterationStart,
   310→        "Iteration failed",
   311→      );
   312→
   313→      expect(results).toHaveLength(1);
   314→      expect(results[0].taskRef).toBe("01TASK1");
   315→      expect(results[0].failureCount).toBe(1);
   316→      expect(results[0].escalated).toBe(false);
   317→      expect(results[0].noteAdded).toBe(true);
   318→    });
   319→
   320→    // AC: @loop-mode-error-handling ac-4, ac-5
   321→    it("should track escalation at third failure", () => {
   322→      const tasksInProgress: Task[] = [
   323→        {
   324→          _ulid: "01TASK1",
   325→          slugs: [],
   326→          title: "Task 1",
   327→          type: "task",
   328→          status: "in_progress",
   329→          notes: [
   330→            {
   331→              _ulid: "01NOTE1",
   332→              created_at: "2024-01-10T10:00:00Z",
   333→              author: "@test",
   334→              content: "[LOOP-FAIL:1] First failure",
   335→            },
   336→            {
   337→              _ulid: "01NOTE2",
   338→              created_at: "2024-01-10T11:00:00Z",
   339→              author: "@test",
   340→              content: "[LOOP-FAIL:2] Second failure",
   341→            },
   342→          ],
   343→        },
   344→      ];
   345→
   346→      const currentTasks: Task[] = [{ ...tasksInProgress[0] }];
   347→
   348→      const results = processFailedIteration(
   349→        tasksInProgress,
   350→        currentTasks,
   351→        iterationStart,
   352→        "Third failure",
   353→      );
   354→
   355→      expect(results).toHaveLength(1);
   356→      expect(results[0].failureCount).toBe(3);
   357→      expect(results[0].escalated).toBe(true);
   358→    });
   359→
   360→    // AC: @loop-mode-error-handling ac-2, ac-6
   361→    it("should skip tasks that were completed during iteration", () => {
   362→      const tasksInProgress: Task[] = [
   363→        {
   364→          _ulid: "01TASK1",
   365→          slugs: [],
   366→          title: "Task 1",
   367→          type: "task",
   368→          status: "in_progress",
   369→        },
   370→      ];
   371→
   372→      const currentTasks: Task[] = [
   373→        {
   374→          ...tasksInProgress[0],
   375→          status: "completed", // Changed to completed
   376→          completed_at: "2024-01-10T13:00:00Z",
   377→        },
   378→      ];
   379→
   380→      const results = processFailedIteration(
   381→        tasksInProgress,
   382→        currentTasks,
   383→        iterationStart,
   384→        "Iteration failed",
   385→      );
   386→
   387→      // Should not track failure for completed task
