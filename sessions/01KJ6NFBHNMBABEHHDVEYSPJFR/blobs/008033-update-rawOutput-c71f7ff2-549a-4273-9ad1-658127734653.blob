     1→/**
     2→ * Shadow branch utilities for transparent spec/task state tracking.
     3→ *
     4→ * Shadow branch concept:
     5→ * - Orphan branch (kspec-meta) stores kspec state
     6→ * - .kspec/ directory is a git worktree pointing to shadow branch
     7→ * - Main branch gitignores .kspec/
     8→ * - All kspec read/write operations target .kspec/
     9→ * - Changes auto-commit to shadow branch
    10→ */
    11→
    12→import { exec, execSync } from "node:child_process";
    13→import * as fs from "node:fs/promises";
    14→import * as path from "node:path";
    15→import { promisify } from "node:util";
    16→import { fileURLToPath } from "node:url";
    17→import { isBatchMode } from "../cli/batch-context.js";
    18→
    19→const __filename = fileURLToPath(import.meta.url);
    20→const __dirname = path.dirname(__filename);
    21→
    22→const execAsync = promisify(exec);
    23→
    24→// Import getVerboseMode for checking CLI --debug-shadow flag
    25→// We use a getter function to avoid issues with circular dependencies
    26→let getVerboseModeFunc: (() => boolean) | null = null;
    27→
    28→export function setVerboseModeGetter(getter: () => boolean): void {
    29→  getVerboseModeFunc = getter;
    30→}
    31→
    32→/**
    33→ * Shadow branch configuration
    34→ */
    35→export interface ShadowConfig {
    36→  /** Whether shadow branch is enabled/detected */
    37→  enabled: boolean;
    38→  /** Path to .kspec/ worktree directory */
    39→  worktreeDir: string;
    40→  /** Shadow branch name (default: kspec-meta) */
    41→  branchName: string;
    42→  /** Project root (where .kspec/ lives) */
    43→  projectRoot: string;
    44→}
    45→
    46→/**
    47→ * Shadow branch status
    48→ */
    49→export interface ShadowStatus {
    50→  exists: boolean;
    51→  healthy: boolean;
    52→  branchExists: boolean;
    53→  worktreeExists: boolean;
    54→  worktreeLinked: boolean;
    55→  artifactsDirExists: boolean;
    56→  error?: string;
    57→}
    58→
    59→/**
    60→ * Error types for shadow branch issues
    61→ */
    62→export class ShadowError extends Error {
    63→  constructor(
    64→    message: string,
    65→    public code:
    66→      | "NOT_INITIALIZED"
    67→      | "WORKTREE_DISCONNECTED"
    68→      | "DIRECTORY_MISSING"
    69→      | "GIT_ERROR"
    70→      | "RUNNING_FROM_SHADOW",
    71→    public suggestion: string,
    72→  ) {
    73→    super(message);
    74→    this.name = "ShadowError";
    75→  }
    76→}
    77→
    78→/**
    79→ * Default shadow branch name
    80→ */
    81→export const SHADOW_BRANCH_NAME = "kspec-meta";
    82→
    83→/**
    84→ * Default shadow worktree directory
    85→ */
    86→export const SHADOW_WORKTREE_DIR = ".kspec";
    87→
    88→/**
    89→ * Options for shadow branch operations.
    90→ *
    91→ * AC: @config-shadow ac-7 — all fields optional for backward compatibility
    92→ *
    93→ * When not provided, functions use SHADOW_BRANCH_NAME and SHADOW_WORKTREE_DIR constants.
    94→ */
    95→export interface ShadowOptions {
    96→  /** Branch name (default: kspec-meta) */
    97→  branchName?: string;
    98→  /** Worktree directory name (default: .kspec) */
    99→  directory?: string;
   100→  /**
   101→   * Remote target for push/pull. Can be:
   102→   * - Named remote (e.g., "origin", "specs-origin")
   103→   * - Local filesystem path (starts with /, ./, or ~)
   104→   * - Git URL (contains :// or starts with git@)
   105→   */
   106→  remote?: string;
   107→  /** Type of remote (detected from remote string) */
   108→  remoteType?: "named" | "path" | "url";
   109→}
   110→
   111→/**
   112→ * Get effective branch name from options or default.
   113→ * AC: @config-shadow ac-7 — backward compat when called without config
   114→ */
   115→function getBranchName(options?: ShadowOptions): string {
   116→  return options?.branchName ?? SHADOW_BRANCH_NAME;
   117→}
   118→
   119→/**
   120→ * Get effective directory name from options or default.
   121→ * AC: @config-shadow ac-7 — backward compat when called without config
   122→ */
   123→function getDirectoryName(options?: ShadowOptions): string {
   124→  return options?.directory ?? SHADOW_WORKTREE_DIR;
   125→}
   126→
   127→/**
   128→ * Check if debug mode is enabled.
   129→ * Debug mode can be enabled via:
   130→ * - KSPEC_DEBUG=1 environment variable
   131→ * - Verbose flag (passed from CLI --debug-shadow option)
   132→ *
   133→ * When enabled, shadow branch operations output detailed information.
   134→ */
   135→export function isDebugMode(verboseFlag?: boolean): boolean {
   136→  if (process.env.KSPEC_DEBUG === "1") {
   137→    return true;
   138→  }
   139→  if (verboseFlag === true) {
   140→    return true;
   141→  }
   142→  // Check CLI --debug-shadow flag via getter
   143→  if (getVerboseModeFunc?.()) {
   144→    return true;
   145→  }
   146→  return false;
   147→}
   148→
   149→/**
   150→ * Check if we're in a git repository
   151→ */
   152→export async function isGitRepo(dir: string): Promise<boolean> {
   153→  try {
   154→    execSync("git rev-parse --git-dir", {
   155→      cwd: dir,
   156→      stdio: ["pipe", "pipe", "pipe"],
   157→      encoding: "utf-8",
   158→    });
   159→    return true;
   160→  } catch {
   161→    return false;
   162→  }
   163→}
   164→
   165→/**
   166→ * Get the git root directory
   167→ */
   168→export function getGitRoot(dir: string): string | null {
   169→  try {
   170→    const result = execSync("git rev-parse --show-toplevel", {
   171→      cwd: dir,
   172→      stdio: ["pipe", "pipe", "pipe"],
   173→      encoding: "utf-8",
   174→    }).trim();
   175→    return result;
   176→  } catch {
   177→    return null;
   178→  }
   179→}
   180→
   181→/**
   182→ * Check if a branch exists
   183→ */
   184→export async function branchExists(
   185→  dir: string,
   186→  branchName: string,
   187→): Promise<boolean> {
   188→  try {
   189→    execSync(`git show-ref --verify --quiet refs/heads/${branchName}`, {
   190→      cwd: dir,
   191→      stdio: ["pipe", "pipe", "pipe"],
   192→    });
   193→    return true;
   194→  } catch {
   195→    return false;
   196→  }
   197→}
   198→
   199→/**
   200→ * Check if a directory is a valid git worktree
   201→ */
   202→export async function isValidWorktree(worktreeDir: string): Promise<boolean> {
   203→  try {
   204→    // Check if .git file exists (worktrees have a .git file, not directory)
   205→    const gitPath = path.join(worktreeDir, ".git");
   206→    const stat = await fs.stat(gitPath);
   207→
   208→    if (stat.isFile()) {
   209→      // Read the .git file to verify it points to a worktree
   210→      const content = await fs.readFile(gitPath, "utf-8");
   211→      return content.trim().startsWith("gitdir:");
   212→    }
   213→
   214→    return false;
   215→  } catch {
   216→    return false;
   217→  }
   218→}
   219→
   220→/**
   221→ * Detect if running from inside the shadow worktree directory.
   222→ * Returns the main project root if detected, null otherwise.
   223→ *
   224→ * AC: @config-shadow ac-8 — detects custom worktree directories using git metadata
   225→ *
   226→ * Detection logic:
   227→ * 1. Check if .git is a file (worktrees have .git files, not directories)
   228→ * 2. Read the gitdir reference from the .git file
   229→ * 3. Check if it points to a worktree for kspec (pattern: <project>/.git/worktrees/...)
   230→ *
   231→ * For custom directories, we detect ANY worktree that:
   232→ * - Has a kspec manifest in it (indicating it's a kspec shadow worktree)
   233→ * - Or has a worktree name containing "kspec" or the configured directory name
   234→ *
   235→ * @param cwd Current working directory
   236→ * @param configuredDirectory Optional configured directory name for matching
   237→ */
   238→export async function detectRunningFromShadowWorktree(
   239→  cwd: string,
   240→  configuredDirectory?: string,
   241→): Promise<string | null> {
   242→  try {
   243→    const gitPath = path.join(cwd, ".git");
   244→    const stat = await fs.stat(gitPath);
   245→
   246→    // Worktrees have a .git file, not directory
   247→    if (!stat.isFile()) {
   248→      return null;
   249→    }
   250→
   251→    const content = await fs.readFile(gitPath, "utf-8");
   252→    const match = content.trim().match(/^gitdir:\s*(.+)$/);
   253→    if (!match) {
   254→      return null;
   255→    }
   256→
   257→    const gitdir = match[1];
   258→
   259→    // Check if this is a worktree (pattern: <project>/.git/worktrees/<name>)
   260→    if (gitdir.includes(".git/worktrees/")) {
   261→      const worktreesMatch = gitdir.match(/^(.+)\/\.git\/worktrees\//);
   262→      if (worktreesMatch) {
   263→        const mainProjectRoot = worktreesMatch[1];
   264→        const cwdBase = path.basename(cwd);
   265→        const worktreeName = path.basename(gitdir);
   266→
   267→        // AC: ac-8 — check multiple patterns for shadow worktree detection
   268→        const directoryToCheck = configuredDirectory || SHADOW_WORKTREE_DIR;
   269→
   270→        // Check if directory name matches default, configured, or worktree contains "kspec"
   271→        if (
   272→          cwdBase === SHADOW_WORKTREE_DIR ||
   273→          cwdBase === directoryToCheck ||
   274→          worktreeName.includes("kspec")
   275→        ) {
   276→          return mainProjectRoot;
   277→        }
   278→
   279→        // Additional check: see if this directory has a kspec manifest
   280→        // This catches custom directories that don't have "kspec" in the name
   281→        try {
   282→          const files = await fs.readdir(cwd);
   283→          const hasKspecManifest = files.some(
   284→            (f) =>
   285→              (f.endsWith(".yaml") || f.endsWith(".yml")) &&
   286→              !f.includes(".tasks.") &&
   287→              !f.includes(".inbox."),
   288→          );
   289→          // Check for modules directory or tasks file as additional signals
   290→          const hasModules = files.includes("modules");
   291→          const hasTasksFile = files.some((f) => f.includes(".tasks."));
   292→
   293→          if (hasKspecManifest && (hasModules || hasTasksFile)) {
   294→            return mainProjectRoot;
   295→          }
   296→        } catch {
   297→          // Ignore read errors
   298→        }
   299→      }
   300→    }
   301→
   302→    return null;
   303→  } catch {
   304→    return null;
   305→  }
   306→}
   307→
   308→/**
   309→ * Detect shadow branch configuration from a directory.
   310→ * Returns shadow config if worktree directory exists and is valid.
   311→ *
   312→ * AC: @config-shadow ac-1 ac-2 — uses configured branch/directory names
   313→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
   314→ *
   315→ * @param startDir Directory to start detection from
   316→ * @param options Optional shadow configuration (branch name, directory)
   317→ */
   318→export async function detectShadow(
   319→  startDir: string,
   320→  options?: ShadowOptions,
   321→): Promise<ShadowConfig | null> {
   322→  const gitRoot = getGitRoot(startDir);
   323→  if (!gitRoot) {
   324→    return null;
   325→  }
   326→
   327→  const directoryName = getDirectoryName(options);
   328→  const branchName = getBranchName(options);
   329→  const worktreeDir = path.join(gitRoot, directoryName);
   330→
   331→  try {
   332→    await fs.access(worktreeDir);
   333→
   334→    // Verify it's a valid worktree
   335→    if (await isValidWorktree(worktreeDir)) {
   336→      return {
   337→        enabled: true,
   338→        worktreeDir,
   339→        branchName,
   340→        projectRoot: gitRoot,
   341→      };
   342→    }
   343→
   344→    // Directory exists but not a valid worktree
   345→    return null;
   346→  } catch {
   347→    // Worktree directory doesn't exist
   348→    return null;
   349→  }
   350→}
   351→
   352→/**
   353→ * Get detailed shadow branch status.
   354→ *
   355→ * AC: @config-shadow ac-1 ac-2 — uses configured branch/directory names
   356→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
   357→ *
   358→ * @param projectRoot Git repository root
   359→ * @param options Optional shadow configuration
   360→ */
   361→export async function getShadowStatus(
   362→  projectRoot: string,
   363→  options?: ShadowOptions,
   364→): Promise<ShadowStatus> {
   365→  const directoryName = getDirectoryName(options);
   366→  const branchName = getBranchName(options);
   367→  const worktreeDir = path.join(projectRoot, directoryName);
   368→
   369→  const status: ShadowStatus = {
   370→    exists: false,
   371→    healthy: false,
   372→    branchExists: false,
   373→    worktreeExists: false,
   374→    worktreeLinked: false,
   375→    artifactsDirExists: false,
   376→  };
   377→
   378→  // Check if we're in a git repo
   379→  if (!(await isGitRepo(projectRoot))) {
   380→    status.error = "Not a git repository";
   381→    return status;
   382→  }
   383→
   384→  // Check if branch exists
   385→  status.branchExists = await branchExists(projectRoot, branchName);
   386→
   387→  // Check if worktree directory exists
   388→  try {
   389→    await fs.access(worktreeDir);
   390→    status.worktreeExists = true;
   391→  } catch {
   392→    status.worktreeExists = false;
   393→  }
   394→
   395→  // Check if worktree is properly linked
   396→  if (status.worktreeExists) {
   397→    status.worktreeLinked = await isValidWorktree(worktreeDir);
   398→
   399→    // AC: @artifacts-directory ac-doctor-checks
   400→    try {
   401→      await fs.access(path.join(worktreeDir, "artifacts"));
   402→      status.artifactsDirExists = true;
   403→    } catch {
   404→      status.artifactsDirExists = false;
   405→    }
   406→  }
   407→
   408→  // Determine overall status
   409→  status.exists = status.branchExists || status.worktreeExists;
   410→  status.healthy =
   411→    status.branchExists && status.worktreeExists && status.worktreeLinked;
   412→
   413→  if (!status.healthy && status.exists) {
   414→    if (!status.branchExists) {
   415→      status.error = "Shadow branch missing but worktree exists";
   416→    } else if (!status.worktreeExists) {
   417→      status.error = "Shadow branch exists but worktree missing";
   418→    } else if (!status.worktreeLinked) {
   419→      status.error = "Worktree exists but not properly linked";
   420→    }
   421→  }
   422→
   423→  return status;
   424→}
   425→
   426→/**
   427→ * Result from checking config mismatch.
   428→ */
   429→export interface ShadowConfigMismatch {
   430→  /** Whether there is a mismatch */
   431→  hasMismatch: boolean;
   432→  /** Mismatched branch name (detected vs configured) */
   433→  branchMismatch?: { detected: string; configured: string };
   434→  /** Mismatched directory (detected vs configured) */
   435→  directoryMismatch?: { detected: string; configured: string };
   436→  /** Guidance message for the user */
   437→  guidance?: string;
   438→}
   439→
   440→/**
   441→ * Check if detected shadow branch settings match the configuration.
   442→ *
   443→ * AC: @config-shadow ac-9 — detect mismatch and guide user to migrate
   444→ *
   445→ * This function detects when:
   446→ * - A shadow branch exists with default settings (kspec-meta, .kspec)
   447→ * - But config specifies different settings
   448→ *
   449→ * @param projectRoot Git repository root
   450→ * @param configuredBranch Configured branch name
   451→ * @param configuredDirectory Configured directory name
   452→ */
   453→export async function checkConfigMismatch(
   454→  projectRoot: string,
   455→  configuredBranch: string,
   456→  configuredDirectory: string,
   457→): Promise<ShadowConfigMismatch> {
   458→  const result: ShadowConfigMismatch = { hasMismatch: false };
   459→
   460→  // First check if default shadow exists
   461→  const defaultStatus = await getShadowStatus(projectRoot, {
   462→    branchName: SHADOW_BRANCH_NAME,
   463→    directory: SHADOW_WORKTREE_DIR,
   464→  });
   465→
   466→  if (!defaultStatus.healthy) {
   467→    // No existing shadow with defaults - no mismatch possible
   468→    return result;
   469→  }
   470→
   471→  // Check if configured settings differ from defaults
   472→  const branchDiffers = configuredBranch !== SHADOW_BRANCH_NAME;
   473→  const directoryDiffers = configuredDirectory !== SHADOW_WORKTREE_DIR;
   474→
   475→  if (!branchDiffers && !directoryDiffers) {
   476→    // Config matches defaults - no mismatch
   477→    return result;
   478→  }
   479→
   480→  // There's a mismatch - existing shadow uses defaults but config specifies different values
   481→  result.hasMismatch = true;
   482→
   483→  if (branchDiffers) {
   484→    result.branchMismatch = {
   485→      detected: SHADOW_BRANCH_NAME,
   486→      configured: configuredBranch,
   487→    };
   488→  }
   489→
   490→  if (directoryDiffers) {
   491→    result.directoryMismatch = {
   492→      detected: SHADOW_WORKTREE_DIR,
   493→      configured: configuredDirectory,
   494→    };
   495→  }
   496→
   497→  // Build guidance message
   498→  const parts: string[] = [];
   499→  if (result.branchMismatch) {
   500→    parts.push(
   501→      `branch "${SHADOW_BRANCH_NAME}" (config wants "${configuredBranch}")`,
   502→    );
   503→  }
   504→  if (result.directoryMismatch) {
   505→    parts.push(
   506→      `directory "${SHADOW_WORKTREE_DIR}" (config wants "${configuredDirectory}")`,
   507→    );
   508→  }
   509→
   510→  result.guidance = [
   511→    `Shadow branch exists with ${parts.join(" and ")}.`,
   512→    "",
   513→    "To migrate to configured settings:",
   514→    "  1. Export your specs: kspec export --all > backup.yaml",
   515→    "  2. Remove existing shadow: rm -rf .kspec && git branch -D kspec-meta",
   516→    "  3. Re-initialize: kspec init",
   517→    "  4. Import specs: kspec import backup.yaml",
   518→    "",
   519→    "Or update kspec.config.yaml to match existing settings.",
   520→  ].join("\n");
   521→
   522→  return result;
   523→}
   524→
   525→/**
   526→ * Create an appropriate ShadowError based on status
   527→ */
   528→export function createShadowError(status: ShadowStatus): ShadowError {
   529→  if (!status.branchExists && !status.worktreeExists) {
   530→    return new ShadowError(
   531→      "Shadow branch not initialized",
   532→      "NOT_INITIALIZED",
   533→      "Run `kspec init` to create shadow branch and worktree.",
   534→    );
   535→  }
   536→
   537→  if (status.branchExists && !status.worktreeExists) {
   538→    return new ShadowError(
   539→      ".kspec/ directory missing",
   540→      "DIRECTORY_MISSING",
   541→      "Run `kspec shadow repair` to recreate the worktree.",
   542→    );
   543→  }
   544→
   545→  if (status.worktreeExists && !status.worktreeLinked) {
   546→    return new ShadowError(
   547→      "Worktree disconnected from git",
   548→      "WORKTREE_DISCONNECTED",
   549→      "Run `kspec shadow repair` to fix the worktree link.",
   550→    );
   551→  }
   552→
   553→  return new ShadowError(
   554→    status.error || "Unknown shadow branch error",
   555→    "GIT_ERROR",
   556→    "Check git status and try `kspec shadow repair`.",
   557→  );
   558→}
   559→
   560→/**
   561→ * Auto-commit changes to shadow branch.
   562→ * Called after write operations when shadow is enabled.
   563→ *
   564→ * @param worktreeDir Path to .kspec/ directory
   565→ * @param message Commit message
   566→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   567→ * @returns true if commit succeeded, false if nothing to commit
   568→ */
   569→export async function shadowAutoCommit(
   570→  worktreeDir: string,
   571→  message: string,
   572→  verbose?: boolean,
   573→): Promise<boolean> {
   574→  const debug = isDebugMode(verbose);
   575→
   576→  try {
   577→    if (debug) {
   578→      console.error(
   579→        `[DEBUG] Shadow auto-commit: git add -A (cwd: ${worktreeDir})`,
   580→      );
   581→    }
   582→
   583→    // Stage all changes
   584→    execSync("git add -A", {
   585→      cwd: worktreeDir,
   586→      stdio: ["pipe", "pipe", "pipe"],
   587→    });
   588→
   589→    // Check if there are staged changes
   590→    try {
   591→      if (debug) {
   592→        console.error(`[DEBUG] Shadow auto-commit: git diff --cached --quiet`);
   593→      }
   594→
   595→      execSync("git diff --cached --quiet", {
   596→        cwd: worktreeDir,
   597→        stdio: ["pipe", "pipe", "pipe"],
   598→      });
   599→      // No error = no changes
   600→      if (debug) {
   601→        console.error(`[DEBUG] Shadow auto-commit: No changes to commit`);
   602→      }
   603→      return false;
   604→    } catch {
   605→      // Error = there are changes, proceed with commit
   606→    }
   607→
   608→    if (debug) {
   609→      console.error(`[DEBUG] Shadow auto-commit: git commit -m "${message}"`);
   610→    }
   611→
   612→    // Commit with message
   613→    // Set KSPEC_SHADOW_COMMIT=1 to signal authorized commit to git hooks
   614→    execSync(`git commit -m "${message.replace(/"/g, '\\"')}"`, {
   615→      cwd: worktreeDir,
   616→      stdio: ["pipe", "pipe", "pipe"],
   617→      env: { ...process.env, KSPEC_SHADOW_COMMIT: "1" },
   618→    });
   619→
   620→    if (debug) {
   621→      console.error(`[DEBUG] Shadow auto-commit: Success`);
   622→    }
   623→
   624→    return true;
   625→  } catch (error) {
   626→    // AC: Only log error if debug mode enabled
   627→    if (debug) {
   628→      console.error("Shadow auto-commit failed:", error);
   629→    }
   630→    return false;
   631→  }
   632→}
   633→
   634→/**
   635→ * Generate commit message for a kspec operation.
   636→ */
   637→export function generateCommitMessage(
   638→  operation: string,
   639→  ref?: string,
   640→  detail?: string,
   641→): string {
   642→  const parts: string[] = [];
   643→
   644→  switch (operation) {
   645→    case "task-start":
   646→      parts.push(`Start @${ref}`);
   647→      break;
   648→    case "task-complete":
   649→      parts.push(`Complete @${ref}`);
   650→      if (detail) parts.push(`: ${detail}`);
   651→      break;
   652→    case "task-note":
   653→      parts.push(`Note on @${ref}`);
   654→      break;
   655→    case "task-add":
   656→      parts.push(`Add task: ${detail || ref}`);
   657→      break;
   658→    case "inbox-add":
   659→      parts.push(
   660→        `Inbox: ${detail?.slice(0, 50)}${(detail?.length || 0) > 50 ? "..." : ""}`,
   661→      );
   662→      break;
   663→    case "inbox-promote":
   664→      parts.push(`Promote to @${ref}`);
   665→      break;
   666→    case "item-add":
   667→      parts.push(`Add @${ref}`);
   668→      break;
   669→    case "item-set":
   670→      parts.push(`Update @${ref}`);
   671→      break;
   672→    case "item-delete":
   673→      parts.push(`Delete @${ref}`);
   674→      break;
   675→    case "derive":
   676→      parts.push(`Derive from @${ref}`);
   677→      break;
   678→    default:
   679→      parts.push(operation);
   680→      if (ref) parts.push(` @${ref}`);
   681→  }
   682→
   683→  return parts.join("");
   684→}
   685→
   686→/**
   687→ * Resolve a path relative to shadow worktree if enabled.
   688→ * Falls back to original path if shadow is not enabled.
   689→ *
   690→ * Uses the worktreeDir from shadowConfig for custom directory support.
   691→ */
   692→export function resolveShadowPath(
   693→  originalPath: string,
   694→  shadowConfig: ShadowConfig | null,
   695→  projectRoot: string,
   696→): string {
   697→  if (!shadowConfig?.enabled) {
   698→    return originalPath;
   699→  }
   700→
   701→  // If the path is within the project root, rewrite to shadow worktree
   702→  const relativePath = path.relative(projectRoot, originalPath);
   703→
   704→  // Get the directory name from the worktree path (supports custom directories)
   705→  const worktreeDirName = path.basename(shadowConfig.worktreeDir);
   706→
   707→  // Skip if path is outside project or already in shadow worktree
   708→  if (
   709→    relativePath.startsWith("..") ||
   710→    relativePath.startsWith(worktreeDirName)
   711→  ) {
   712→    return originalPath;
   713→  }
   714→
   715→  // Handle spec/ -> shadow worktree mapping
   716→  if (relativePath.startsWith("spec/") || relativePath.startsWith("spec\\")) {
   717→    const specRelative = relativePath.slice(5); // Remove 'spec/'
   718→    return path.join(shadowConfig.worktreeDir, specRelative);
   719→  }
   720→
   721→  // For task/inbox files at root, move to shadow worktree
   722→  if (
   723→    relativePath.endsWith(".tasks.yaml") ||
   724→    relativePath.endsWith(".inbox.yaml")
   725→  ) {
   726→    return path.join(shadowConfig.worktreeDir, relativePath);
   727→  }
   728→
   729→  return originalPath;
   730→}
   731→
   732→/**
   733→ * Commit changes to shadow branch if enabled.
   734→ * This is the primary interface for CLI commands to trigger auto-commit.
   735→ *
   736→ * @param shadowConfig Shadow configuration (from KspecContext.shadow)
   737→ * @param operation Operation type (e.g., 'task-start', 'task-complete')
   738→ * @param ref Reference slug or ULID (optional)
   739→ * @param detail Additional detail for commit message (optional)
   740→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   741→ * @returns true if committed, false if shadow not enabled or nothing to commit
   742→ */
   743→export async function commitIfShadow(
   744→  shadowConfig: ShadowConfig | null,
   745→  operation: string,
   746→  ref?: string,
   747→  detail?: string,
   748→  verbose?: boolean,
   749→): Promise<boolean> {
   750→  // Suppress auto-commits during atomic batch execution
   751→  if (isBatchMode()) {
   752→    return false;
   753→  }
   754→
   755→  if (!shadowConfig?.enabled) {
   756→    return false;
   757→  }
   758→
   759→  const message = generateCommitMessage(operation, ref, detail);
   760→  const committed = await shadowAutoCommit(
   761→    shadowConfig.worktreeDir,
   762→    message,
   763→    verbose,
   764→  );
   765→
   766→  // AC: @shadow-sync ac-1 - Fire-and-forget push after each commit
   767→  if (committed) {
   768→    shadowPushAsync(shadowConfig.worktreeDir, verbose);
   769→  }
   770→
   771→  return committed;
   772→}
   773→
   774→/**
   775→ * Check if shadow is required but not available, and throw appropriate error.
   776→ * Use this at the start of commands that require shadow mode.
   777→ *
   778→ * @param shadowConfig Shadow configuration from context
   779→ * @param projectRoot Project root for status check
   780→ * @throws ShadowError if shadow is not properly configured
   781→ */
   782→export async function requireShadow(
   783→  shadowConfig: ShadowConfig | null,
   784→  projectRoot: string,
   785→): Promise<void> {
   786→  if (shadowConfig?.enabled) {
   787→    return; // Shadow is available
   788→  }
   789→
   790→  const status = await getShadowStatus(projectRoot);
   791→  throw createShadowError(status);
   792→}
   793→
   794→/**
   795→ * Format a ShadowError for display in CLI.
   796→ * Returns a user-friendly message with suggestion.
   797→ */
   798→export function formatShadowError(error: ShadowError): string {
   799→  return `${error.message}\n\nSuggestion: ${error.suggestion}`;
   800→}
   801→
   802→/**
   803→ * Result from shadow initialization
   804→ */
   805→export interface ShadowInitResult {
   806→  success: boolean;
   807→  branchCreated: boolean;
   808→  worktreeCreated: boolean;
   809→  gitignoreUpdated: boolean;
   810→  initialCommit: boolean;
   811→  alreadyExists: boolean;
   812→  /** Whether shadow was created from existing remote branch */
   813→  createdFromRemote: boolean;
   814→  /** Whether new branch was pushed to remote to establish tracking */
   815→  pushedToRemote: boolean;
   816→  error?: string;
   817→}
   818→
   819→/**
   820→ * Options for shadow initialization.
   821→ *
   822→ * AC: @config-shadow ac-1 ac-2 — branch and directory configurable
   823→ */
   824→export interface ShadowInitOptions {
   825→  /** Project name for manifest */
   826→  projectName?: string;
   827→  /** Force reinitialize even if exists */
   828→  force?: boolean;
   829→  /** Shadow branch/directory/remote configuration */
   830→  shadow?: ShadowOptions;
   831→}
   832→
   833→/**
   834→ * Check if a remote exists (default: origin)
   835→ */
   836→export async function hasRemote(
   837→  projectRoot: string,
   838→  remoteName = "origin",
   839→): Promise<boolean> {
   840→  try {
   841→    const { stdout } = await execAsync(`git remote get-url ${remoteName}`, {
   842→      cwd: projectRoot,
   843→    });
   844→    return stdout.trim().length > 0;
   845→  } catch {
   846→    return false;
   847→  }
   848→}
   849→
   850→/**
   851→ * Check if a branch exists on a remote
   852→ */
   853→export async function remoteBranchExists(
   854→  projectRoot: string,
   855→  branchName: string,
   856→  remoteName = "origin",
   857→): Promise<boolean> {
   858→  try {
   859→    execSync(
   860→      `git show-ref --verify --quiet refs/remotes/${remoteName}/${branchName}`,
   861→      {
   862→        cwd: projectRoot,
   863→        stdio: ["pipe", "pipe", "pipe"],
   864→      },
   865→    );
   866→    return true;
   867→  } catch {
   868→    return false;
   869→  }
   870→}
   871→
   872→/**
   873→ * Fetch from remote to ensure refs are up to date.
   874→ * Returns true if fetch succeeded, false otherwise.
   875→ */
   876→export async function fetchRemote(
   877→  projectRoot: string,
   878→  remoteName = "origin",
   879→): Promise<boolean> {
   880→  try {
   881→    await execAsync(`git fetch ${remoteName}`, {
   882→      cwd: projectRoot,
   883→    });
   884→    return true;
   885→  } catch {
   886→    return false;
   887→  }
   888→}
   889→
   890→/**
   891→ * Push shadow branch to remote with tracking.
   892→ * Returns true if push succeeded, false otherwise.
   893→ *
   894→ * AC: @config-shadow ac-3 — uses configured remote name
   895→ * AC: @config-shadow ac-7 — defaults to origin when not provided
   896→ *
   897→ * @param worktreeDir Path to shadow worktree
   898→ * @param remoteName Remote name (default: origin)
   899→ * @param options Optional shadow configuration
   900→ */
   901→export async function pushShadowBranch(
   902→  worktreeDir: string,
   903→  remoteName = "origin",
   904→  options?: ShadowOptions,
   905→): Promise<boolean> {
   906→  const branchName = getBranchName(options);
   907→  try {
   908→    await execAsync(`git push -u ${remoteName} ${branchName}`, {
   909→      cwd: worktreeDir,
   910→    });
   911→    return true;
   912→  } catch {
   913→    return false;
   914→  }
   915→}
   916→
   917→/**
   918→ * Check if shadow branch has remote tracking configured.
   919→ * AC-4: Used to determine whether sync should be attempted.
   920→ *
   921→ * AC: @config-shadow ac-7 — backward compat when called without config
   922→ *
   923→ * @param worktreeDir Path to shadow worktree
   924→ * @param options Optional shadow configuration
   925→ */
   926→export async function hasRemoteTracking(
   927→  worktreeDir: string,
   928→  options?: ShadowOptions,
   929→): Promise<boolean> {
   930→  const branchName = getBranchName(options);
   931→  try {
   932→    const { stdout } = await execAsync(
   933→      `git config branch.${branchName}.remote`,
   934→      { cwd: worktreeDir },
   935→    );
   936→    return stdout.trim().length > 0;
   937→  } catch {
   938→    return false;
   939→  }
   940→}
   941→
   942→/**
   943→ * Ensure shadow branch has remote tracking configured.
   944→ * AC-8: If shadow has no tracking but main branch has origin remote,
   945→ * automatically configure tracking to origin/kspec-meta.
   946→ *
   947→ * AC: @config-shadow ac-3 ac-4 ac-5 — handles different remote types
   948→ * AC: @config-shadow ac-6 — error with guidance if named remote doesn't exist
   949→ * AC: @config-shadow ac-7 — backward compat when called without config
   950→ *
   951→ * @param worktreeDir Path to shadow worktree
   952→ * @param projectRoot Git repository root
   953→ * @param options Optional shadow configuration
   954→ * @returns Result with success status and error details if applicable
   955→ */
   956→export async function ensureRemoteTracking(
   957→  worktreeDir: string,
   958→  projectRoot: string,
   959→  options?: ShadowOptions,
   960→): Promise<EnsureRemoteTrackingResult> {
   961→  const branchName = getBranchName(options);
   962→
   963→  // Check if already has tracking
   964→  if (await hasRemoteTracking(worktreeDir, options)) {
   965→    return { success: true };
   966→  }
   967→
   968→  // Determine remote name to use
   969→  let remoteName = "origin";
   970→
   971→  if (options?.remote) {
   972→    const remoteType = options.remoteType ?? "named";
   973→
   974→    if (remoteType === "named") {
   975→      // AC: ac-3 — use the named remote directly
   976→      remoteName = options.remote;
   977→
   978→      // AC: ac-6 — verify the named remote exists with guidance
   979→      if (!(await hasRemote(projectRoot, remoteName))) {
   980→        // Named remote doesn't exist - provide helpful guidance
   981→        return {
   982→          success: false,
   983→          missingRemote: remoteName,
   984→          guidance: `Remote '${remoteName}' does not exist. To fix this:\n` +
   985→            `  1. Add the remote: git remote add ${remoteName} <url>\n` +
   986→            `  2. Or update kspec.config.yaml to use an existing remote\n` +
   987→            `  3. Or remove shadow.remote to use the default 'origin' remote`,
   988→        };
   989→      }
   990→    } else if (remoteType === "path" || remoteType === "url") {
   991→      // AC: ac-4 ac-5 — add a git remote for path/URL if not already present
   992→      const specRemoteName = "kspec-specs";
   993→      const hasSpecsRemote = await hasRemote(projectRoot, specRemoteName);
   994→
   995→      if (!hasSpecsRemote) {
   996→        try {
   997→          // Expand tilde for paths if needed
   998→          let remoteTarget = options.remote;
   999→          if (remoteType === "path" && remoteTarget.startsWith("~")) {
  1000→            remoteTarget = remoteTarget.replace(
  1001→              /^~/,
  1002→              process.env.HOME || process.env.USERPROFILE || "~",
  1003→            );
  1004→          }
  1005→
  1006→          await execAsync(`git remote add ${specRemoteName} "${remoteTarget}"`, {
  1007→            cwd: projectRoot,
  1008→          });
  1009→        } catch {
  1010→          // Remote add failed - may already exist with different URL
  1011→          return { success: false };
  1012→        }
  1013→      }
  1014→
  1015→      remoteName = specRemoteName;
  1016→    }
  1017→  } else {
  1018→    // No remote configured - check if main branch has origin
  1019→    if (!(await hasRemote(projectRoot))) {
  1020→      return { success: false };
  1021→    }
  1022→  }
  1023→
  1024→  // Set up tracking for shadow branch
  1025→  try {
  1026→    await execAsync(`git config branch.${branchName}.remote ${remoteName}`, {
  1027→      cwd: worktreeDir,
  1028→    });
  1029→    await execAsync(
  1030→      `git config branch.${branchName}.merge refs/heads/${branchName}`,
  1031→      { cwd: worktreeDir },
  1032→    );
  1033→    return { success: true };
  1034→  } catch {
  1035→    return { success: false };
  1036→  }
  1037→}
  1038→
  1039→/**
  1040→ * Result from ensuring remote tracking
  1041→ * AC: @config-shadow ac-6 — includes error details when named remote doesn't exist
  1042→ */
  1043→export interface EnsureRemoteTrackingResult {
  1044→  success: boolean;
  1045→  /** Error when remote doesn't exist (AC-6) */
  1046→  missingRemote?: string;
  1047→  /** Guidance message for user */
  1048→  guidance?: string;
  1049→}
  1050→
  1051→/**
  1052→ * Result from a sync operation
  1053→ */
  1054→export interface ShadowSyncResult {
  1055→  success: boolean;
  1056→  pulled: boolean;
  1057→  pushed: boolean;
  1058→  hadConflict: boolean;
  1059→  error?: string;
  1060→}
  1061→
  1062→/**
  1063→ * Fire-and-forget push to remote.
  1064→ * AC-1: Called after each auto-commit when tracking is configured.
  1065→ * AC-8: Automatically sets up tracking if main branch has remote.
  1066→ * Silently ignores errors - the local commit succeeded regardless.
  1067→ *
  1068→ * AC: @config-shadow ac-7 — backward compat when called without config
  1069→ *
  1070→ * @param worktreeDir Path to shadow worktree
  1071→ * @param verbose Enable debug output
  1072→ * @param options Optional shadow configuration
  1073→ */
  1074→export async function shadowPushAsync(
  1075→  worktreeDir: string,
  1076→  verbose?: boolean,
  1077→  options?: ShadowOptions,
  1078→): Promise<void> {
  1079→  const debug = isDebugMode(verbose);
  1080→
  1081→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
  1082→  const projectRoot = path.dirname(worktreeDir);
  1083→  const trackingResult = await ensureRemoteTracking(worktreeDir, projectRoot, options);
  1084→
  1085→  // AC: @config-shadow ac-6 — log guidance if named remote doesn't exist
  1086→  if (!trackingResult.success && trackingResult.missingRemote) {
  1087→    if (debug) {
  1088→      console.error(`[DEBUG] Shadow push: ${trackingResult.guidance}`);
  1089→    }
  1090→    return;
  1091→  }
  1092→
  1093→  // Check if tracking is configured before attempting push
  1094→  if (!(await hasRemoteTracking(worktreeDir, options))) {
  1095→    if (debug) {
  1096→      console.error(
  1097→        "[DEBUG] Shadow push: No remote tracking configured, skipping",
  1098→      );
  1099→    }
  1100→    return; // AC: @shadow-sync ac-4 - silently skip if no tracking
  1101→  }
  1102→
  1103→  try {
  1104→    if (debug) {
  1105→      console.error(`[DEBUG] Shadow push: git push (cwd: ${worktreeDir})`);
  1106→    }
  1107→
  1108→    // Don't await - fire and forget
  1109→    execAsync("git push", { cwd: worktreeDir }).catch((err) => {
  1110→      if (debug) {
  1111→        console.error("[DEBUG] Shadow push failed:", err);
  1112→      }
  1113→      // Silently ignore push failures - local state is correct
  1114→    });
  1115→  } catch (err) {
  1116→    if (debug) {
  1117→      console.error("[DEBUG] Shadow push error:", err);
  1118→    }
  1119→  }
  1120→}
  1121→
  1122→/**
  1123→ * Pull remote changes to shadow branch.
  1124→ * AC-2: Called at session start to sync before operations.
  1125→ * AC-6: Uses --ff-only first, falls back to --rebase.
  1126→ * AC-3: On conflict, returns failure with suggestion.
  1127→ * AC-8: Automatically sets up tracking if main branch has remote.
  1128→ *
  1129→ * AC: @config-shadow ac-7 — backward compat when called without config
  1130→ *
  1131→ * @param worktreeDir Path to shadow worktree
  1132→ * @param options Optional shadow configuration
  1133→ */
  1134→export async function shadowPull(
  1135→  worktreeDir: string,
  1136→  options?: ShadowOptions,
  1137→): Promise<ShadowSyncResult> {
  1138→  const branchName = getBranchName(options);
  1139→  const result: ShadowSyncResult = {
  1140→    success: false,
  1141→    pulled: false,
  1142→    pushed: false,
  1143→    hadConflict: false,
  1144→  };
  1145→
  1146→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
  1147→  const projectRoot = path.dirname(worktreeDir);
  1148→  const trackingResult = await ensureRemoteTracking(worktreeDir, projectRoot, options);
  1149→
  1150→  // AC: @config-shadow ac-6 — error with guidance if named remote doesn't exist
  1151→  if (!trackingResult.success && trackingResult.missingRemote) {
  1152→    result.error = trackingResult.guidance;
  1153→    return result;
  1154→  }
  1155→
  1156→  // AC: @shadow-sync ac-4 - Skip if no remote tracking
  1157→  if (!(await hasRemoteTracking(worktreeDir, options))) {
  1158→    result.success = true;
  1159→    return result;
  1160→  }
  1161→
  1162→  // Check if remote branch exists before attempting pull
  1163→  // Fetch first to ensure refs are up to date
  1164→  await fetchRemote(projectRoot);
  1165→  const remoteHasBranch = await remoteBranchExists(projectRoot, branchName);
  1166→  if (!remoteHasBranch) {
  1167→    // Remote branch doesn't exist yet - nothing to pull, but success
  1168→    result.success = true;
  1169→    return result;
  1170→  }
  1171→
  1172→  try {
  1173→    // Try fast-forward only first (cleanest)
  1174→    await execAsync("git pull --ff-only", { cwd: worktreeDir });
  1175→    result.success = true;
  1176→    result.pulled = true;
  1177→    return result;
  1178→  } catch {
  1179→    // Fast-forward failed, try rebase
  1180→  }
  1181→
  1182→  try {
  1183→    // AC: @shadow-sync ac-6 - Fall back to rebase
  1184→    await execAsync("git pull --rebase", { cwd: worktreeDir });
  1185→    result.success = true;
  1186→    result.pulled = true;
  1187→    return result;
  1188→  } catch {
  1189→    // Rebase failed - likely conflict
  1190→  }
  1191→
  1192→  // AC: @shadow-sync ac-3 - Conflict detected - abort rebase and report
  1193→  try {
  1194→    await execAsync("git rebase --abort", { cwd: worktreeDir });
  1195→  } catch {
  1196→    // May not be in rebase state, ignore
  1197→  }
  1198→
  1199→  result.hadConflict = true;
  1200→  result.error = "Sync conflict detected. Run `kspec shadow resolve` to fix.";
  1201→  return result;
  1202→}
  1203→
  1204→/**
  1205→ * Full sync operation: pull then push.
  1206→ * Used by session start and explicit sync commands.
  1207→ *
  1208→ * AC: @config-shadow ac-7 — backward compat when called without config
  1209→ *
  1210→ * @param worktreeDir Path to shadow worktree
  1211→ * @param options Optional shadow configuration
  1212→ */
  1213→export async function shadowSync(
  1214→  worktreeDir: string,
  1215→  options?: ShadowOptions,
  1216→): Promise<ShadowSyncResult> {
  1217→  // First pull
  1218→  const pullResult = await shadowPull(worktreeDir, options);
  1219→  if (!pullResult.success) {
  1220→    return pullResult;
  1221→  }
  1222→
  1223→  // Then push (only if tracking configured, checked inside)
  1224→  if (await hasRemoteTracking(worktreeDir, options)) {
  1225→    try {
  1226→      await execAsync("git push", { cwd: worktreeDir });
  1227→      pullResult.pushed = true;
  1228→    } catch {
  1229→      // Push failed - not a critical error, local state is correct
  1230→      // Could be permissions, network, etc.
  1231→    }
  1232→  }
  1233→
  1234→  return pullResult;
  1235→}
  1236→
  1237→/**
  1238→ * Check if .gitignore has uncommitted changes
  1239→ */
  1240→async function hasUncommittedGitignore(projectRoot: string): Promise<boolean> {
  1241→  try {
  1242→    // Check both staged and unstaged changes to .gitignore
  1243→    const { stdout } = await execAsync("git status --porcelain .gitignore", {
  1244→      cwd: projectRoot,
  1245→    });
  1246→    return stdout.trim().length > 0;
  1247→  } catch {
  1248→    return false;
  1249→  }
  1250→}
  1251→
  1252→/**
  1253→ * Commit only .gitignore with a message.
  1254→ *
  1255→ * @param projectRoot Git repository root
  1256→ * @param directoryName Shadow directory name (for commit message)
  1257→ */
  1258→async function commitGitignore(
  1259→  projectRoot: string,
  1260→  directoryName: string,
  1261→): Promise<void> {
  1262→  await execAsync("git add .gitignore", { cwd: projectRoot });
  1263→  await execAsync(
  1264→    `git commit -m "chore: add ${directoryName}/ to .gitignore for shadow branch"`,
  1265→    {
  1266→      cwd: projectRoot,
  1267→    },
  1268→  );
  1269→}
  1270→
  1271→/**
  1272→ * Add shadow directory to .gitignore if not already present.
  1273→ * Fails if .gitignore has uncommitted changes.
  1274→ * Commits the change after adding.
  1275→ *
  1276→ * AC: @config-shadow ac-2 — uses configured directory name
  1277→ * AC: @config-shadow ac-7 — defaults to .kspec when not provided
  1278→ *
  1279→ * @param projectRoot Git repository root
  1280→ * @param options Optional shadow configuration
  1281→ */
  1282→async function ensureGitignore(
  1283→  projectRoot: string,
  1284→  options?: ShadowOptions,
  1285→): Promise<boolean> {
  1286→  const directoryName = getDirectoryName(options);
  1287→  const gitignorePath = path.join(projectRoot, ".gitignore");
  1288→  const entry = `${directoryName}/`;
  1289→
  1290→  // Fail fast if .gitignore has uncommitted changes
  1291→  if (await hasUncommittedGitignore(projectRoot)) {
  1292→    throw new ShadowError(
  1293→      ".gitignore has uncommitted changes",
  1294→      "GIT_ERROR",
  1295→      "Commit or stash your .gitignore changes before running kspec init.",
  1296→    );
  1297→  }
  1298→
  1299→  try {
  1300→    let content = "";
  1301→    try {
  1302→      content = await fs.readFile(gitignorePath, "utf-8");
  1303→    } catch {
  1304→      // File doesn't exist, will create
  1305→    }
  1306→
  1307→    // Check if already present (handle various formats)
  1308→    const lines = content.split("\n");
  1309→    const patterns = [
  1310→      directoryName,
  1311→      `${directoryName}/`,
  1312→      `/${directoryName}`,
  1313→      `/${directoryName}/`,
  1314→    ];
  1315→
  1316→    for (const line of lines) {
  1317→      const trimmed = line.trim();
  1318→      if (patterns.includes(trimmed)) {
  1319→        return false; // Already present
  1320→      }
  1321→    }
  1322→
  1323→    // Add to gitignore
  1324→    const newContent =
  1325→      content.endsWith("\n") || content === ""
  1326→        ? `${content}${entry}\n`
  1327→        : `${content}\n${entry}\n`;
  1328→
  1329→    await fs.writeFile(gitignorePath, newContent, "utf-8");
  1330→
  1331→    // Commit the change
  1332→    await commitGitignore(projectRoot, directoryName);
  1333→
  1334→    return true;
  1335→  } catch (error) {
  1336→    if (error instanceof ShadowError) {
  1337→      throw error;
  1338→    }
  1339→    throw new ShadowError(
  1340→      `Failed to update .gitignore: ${error}`,
  1341→      "GIT_ERROR",
  1342→      "Check file permissions for .gitignore",
  1343→    );
  1344→  }
  1345→}
  1346→
  1347→/**
  1348→ * Generate initial manifest content for shadow branch
  1349→ */
  1350→function generateShadowManifest(projectName: string): string {
  1351→  return `# ${projectName} - Kynetic Spec
  1352→# Generated by kspec init
  1353→
  1354→kynetic: "1.0"
  1355→
  1356→project:
  1357→  name: "${projectName}"
  1358→  version: "0.1.0"
  1359→  status: draft
  1360→  description: |
  1361→    Add your project description here.
  1362→
  1363→# Module includes
  1364→includes:
  1365→  - modules/main.yaml
  1366→`;
  1367→}
  1368→
  1369→/**
  1370→ * Generate initial module content
  1371→ */
  1372→function generateShadowModule(projectName: string): string {
  1373→  return `# ${projectName} - Main Module
  1374→# Add your spec items here
  1375→
  1376→items: []
  1377→`;
  1378→}
  1379→
  1380→/**
  1381→ * Generate initial tasks file
  1382→ */
  1383→function generateShadowTasks(projectName: string): string {
  1384→  return `# ${projectName} - Tasks
  1385→# Track implementation work here
  1386→
  1387→tasks: []
  1388→`;
  1389→}
  1390→
  1391→/**
  1392→ * Generate initial inbox file
  1393→ */
  1394→function generateShadowInbox(): string {
  1395→  return `# Inbox - Quick Capture
  1396→# Ideas and notes that haven't been triaged yet
  1397→
  1398→items: []
  1399→`;
  1400→}
  1401→
  1402→/**
  1403→ * Get the kspec package root directory.
  1404→ * Navigates from dist/parser/ to package root.
  1405→ */
  1406→function getPackageRoot(): string {
  1407→  return path.resolve(__dirname, "..", "..");
  1408→}
  1409→
  1410→/**
  1411→ * Install pre-commit hook to protect kspec-meta branch.
  1412→ * Hook prevents direct commits to shadow branch unless KSPEC_SHADOW_COMMIT=1.
  1413→ *
  1414→ * Note: Git worktrees use hooks from the main .git/hooks directory (via commondir),
  1415→ * not from .git/worktrees/-kspec/hooks. So we install to main hooks directory.
  1416→ *
  1417→ * The hook source is located in the kspec package's templates/hooks/ directory.
  1418→ *
  1419→ * @param projectRoot Git repository root
  1420→ * @returns true if hook was installed, false if already exists
  1421→ */
  1422→async function installShadowHook(projectRoot: string): Promise<boolean> {
  1423→  const hooksDir = path.join(projectRoot, ".git", "hooks");
  1424→  const hookPath = path.join(hooksDir, "pre-commit");
  1425→
  1426→  // Look for hook in package templates directory
  1427→  const packageRoot = getPackageRoot();
  1428→  const sourceHookPath = path.join(packageRoot, "templates", "hooks", "pre-commit");
  1429→
  1430→  try {
  1431→    // Check if source hook exists in package templates
  1432→    try {
  1433→      await fs.access(sourceHookPath);
  1434→    } catch {
  1435→      // Source hook doesn't exist - skip installation
  1436→      return false;
  1437→    }
  1438→
  1439→    // Check if hook already exists
  1440→    try {
  1441→      await fs.access(hookPath);
  1442→      // Hook exists - don't overwrite (user may have custom hooks)
  1443→      return false;
  1444→    } catch {
  1445→      // Hook doesn't exist - install it
  1446→    }
  1447→
  1448→    // Copy hook from package templates
  1449→    const hookContent = await fs.readFile(sourceHookPath, "utf-8");
  1450→    await fs.writeFile(hookPath, hookContent, { mode: 0o755 });
  1451→    return true;
  1452→  } catch (_error) {
  1453→    // Silently fail - hook installation is optional
  1454→    return false;
  1455→  }
  1456→}
  1457→
  1458→/**
  1459→ * Convert project name to slug (kebab-case)
  1460→ */
  1461→function toSlug(projectName: string): string {
  1462→  return projectName
  1463→    .toLowerCase()
  1464→    .replace(/[^a-z0-9]+/g, "-")
  1465→    .replace(/^-|-$/g, "");
  1466→}
  1467→
  1468→/**
  1469→ * Configure git merge driver for kspec YAML files.
  1470→ * AC: @yaml-merge-driver ac-12
  1471→ *
  1472→ * Configures the merge driver in .git/config and adds .gitattributes in the shadow branch.
  1473→ *
  1474→ * @param projectRoot Git repository root
  1475→ * @param worktreeDir Path to shadow worktree directory
  1476→ * @returns true if configuration was successful
  1477→ */
  1478→async function configureMergeDriver(
  1479→  projectRoot: string,
  1480→  worktreeDir: string,
  1481→): Promise<boolean> {
  1482→  try {
  1483→    // Step 1: Configure merge driver in .git/config
  1484→    const kspecPath = execSync("which kspec", {
  1485→      encoding: "utf-8",
  1486→      stdio: ["pipe", "pipe", "pipe"],
  1487→    }).trim();
  1488→
  1489→    // Add merge driver configuration to git config
  1490→    try {
  1491→      execSync(
  1492→        `git config merge.kspec.name "Kspec YAML semantic merge driver"`,
  1493→        {
  1494→          cwd: projectRoot,
  1495→          stdio: ["pipe", "pipe", "pipe"],
  1496→        },
  1497→      );
  1498→      execSync(
  1499→        `git config merge.kspec.driver "${kspecPath} merge-driver %O %A %B --non-interactive"`,
  1500→        {
  1501→          cwd: projectRoot,
  1502→          stdio: ["pipe", "pipe", "pipe"],
  1503→        },
  1504→      );
  1505→    } catch (error) {
  1506→      // Config may fail if already set - check if it's set correctly
  1507→      try {
  1508→        const existingDriver = execSync("git config merge.kspec.driver", {
  1509→          cwd: projectRoot,
  1510→          encoding: "utf-8",
  1511→          stdio: ["pipe", "pipe", "pipe"],
  1512→        }).trim();
  1513→
  1514→        if (!existingDriver.includes("kspec merge-driver")) {
  1515→          throw new Error("Merge driver config exists but is incorrect");
  1516→        }
  1517→      } catch {
  1518→        throw error; // Re-throw original error
  1519→      }
  1520→    }
  1521→
  1522→    // Step 2: Create .gitattributes in shadow branch
  1523→    const gitattributesPath = path.join(worktreeDir, ".gitattributes");
  1524→
  1525→    // Check if .gitattributes exists
  1526→    let existingContent = "";
  1527→    try {
  1528→      existingContent = await fs.readFile(gitattributesPath, "utf-8");
  1529→    } catch {
  1530→      // File doesn't exist, that's fine
  1531→    }
  1532→
  1533→    // Check if merge driver is already configured
  1534→    if (!existingContent.includes("merge=kspec")) {
  1535→      const attributesContent = existingContent
  1536→        ? existingContent + "\n"
  1537→        : "# Git attributes for kspec\n\n";
  1538→
  1539→      await fs.writeFile(
  1540→        gitattributesPath,
  1541→        attributesContent + "*.yaml merge=kspec\n*.yml merge=kspec\n",
  1542→        "utf-8",
  1543→      );
  1544→
  1545→      // Commit .gitattributes to shadow branch
  1546→      await shadowAutoCommit(worktreeDir, "Configure kspec merge driver");
  1547→    }
  1548→
  1549→    return true;
  1550→  } catch (_error) {
  1551→    // Silently fail - merge driver configuration is optional
  1552→    return false;
  1553→  }
  1554→}
  1555→
  1556→/**
  1557→ * Initialize shadow branch and worktree.
  1558→ * Creates orphan branch, worktree, updates gitignore, and creates initial structure.
  1559→ *
  1560→ * AC: @config-shadow ac-1 — creates orphan branch with configured name
  1561→ * AC: @config-shadow ac-2 — creates worktree at configured directory
  1562→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
  1563→ *
  1564→ * @param projectRoot Git repository root
  1565→ * @param options Initialization options
  1566→ * @returns Result indicating what was created
  1567→ */
  1568→export async function initializeShadow(
  1569→  projectRoot: string,
  1570→  options: ShadowInitOptions = {},
  1571→): Promise<ShadowInitResult> {
  1572→  const result: ShadowInitResult = {
  1573→    success: false,
  1574→    branchCreated: false,
  1575→    worktreeCreated: false,
  1576→    gitignoreUpdated: false,
  1577→    initialCommit: false,
  1578→    alreadyExists: false,
  1579→    createdFromRemote: false,
  1580→    pushedToRemote: false,
  1581→  };
  1582→
  1583→  // Check if we're in a git repo
  1584→  if (!(await isGitRepo(projectRoot))) {
  1585→    result.error = "Not a git repository";
  1586→    return result;
  1587→  }
  1588→
  1589→  // AC: ac-1 ac-2 — use configured branch/directory or defaults
  1590→  const branchName = getBranchName(options.shadow);
  1591→  const directoryName = getDirectoryName(options.shadow);
  1592→  const worktreeDir = path.join(projectRoot, directoryName);
  1593→
  1594→  // Check current status with configured options
  1595→  const status = await getShadowStatus(projectRoot, options.shadow);
  1596→
  1597→  // Handle existing shadow branch
  1598→  if (status.healthy && !options.force) {
  1599→    result.alreadyExists = true;
  1600→    result.success = true;
  1601→    return result;
  1602→  }
  1603→
  1604→  // Derive project name if not provided
  1605→  const projectName =
  1606→    options.projectName ||
  1607→    path
  1608→      .basename(projectRoot)
  1609→      .replace(/[-_]/g, " ")
  1610→      .replace(/\b\w/g, (c) => c.toUpperCase());
  1611→
  1612→  const slug = toSlug(projectName);
  1613→
  1614→  // Determine remote name to use
  1615→  let remoteName = "origin";
  1616→  if (options.shadow?.remote && options.shadow.remoteType === "named") {
  1617→    remoteName = options.shadow.remote;
  1618→  }
  1619→
  1620→  // Check for remote shadow branch (AC-4: fetch to ensure refs are up to date)
  1621→  const remoteExists = await hasRemote(projectRoot, remoteName);
  1622→  let remoteHasShadow = false;
  1623→  if (remoteExists) {
  1624→    await fetchRemote(projectRoot, remoteName); // Best effort, ignore failures
  1625→    remoteHasShadow = await remoteBranchExists(projectRoot, branchName, remoteName);
  1626→  }
  1627→
  1628→  try {
  1629→    // Step 1: Update .gitignore first (before creating worktree)
  1630→    result.gitignoreUpdated = await ensureGitignore(projectRoot, options.shadow);
  1631→
  1632→    // Step 2: Create worktree with orphan branch (or attach to existing branch)
  1633→    if (!status.worktreeExists || !status.worktreeLinked) {
  1634→      // Remove existing directory if present but not linked
  1635→      if (status.worktreeExists && !status.worktreeLinked) {
  1636→        await fs.rm(worktreeDir, { recursive: true, force: true });
  1637→      }
  1638→
  1639→      // Remove stale worktree reference if any
  1640→      try {
  1641→        await execAsync(`git worktree remove "${directoryName}" --force`, {
  1642→          cwd: projectRoot,
  1643→        });
  1644→      } catch {
  1645→        // Ignore - worktree may not exist in git's list
  1646→      }
  1647→
  1648→      if (remoteHasShadow) {
  1649→        // AC: @shadow-init-remote ac-1 - Remote has shadow branch - create worktree from it with tracking
  1650→        await execAsync(
  1651→          `git worktree add "${directoryName}" ${branchName}`,
  1652→          { cwd: projectRoot },
  1653→        );
  1654→        // Set up tracking for the branch
  1655→        await execAsync(
  1656→          `git branch --set-upstream-to=${remoteName}/${branchName} ${branchName}`,
  1657→          { cwd: projectRoot },
  1658→        );
  1659→        result.createdFromRemote = true;
  1660→      } else if (!status.branchExists) {
  1661→        // AC: @shadow-init-remote ac-2 ac-3 - No remote branch or no remote - create orphan branch
  1662→        // AC: @config-shadow ac-1 — use configured branch name
  1663→        await execAsync(
  1664→          `git worktree add --orphan -b ${branchName} "${directoryName}"`,
  1665→          { cwd: projectRoot },
  1666→        );
  1667→        result.branchCreated = true;
  1668→      } else {
  1669→        // Attach to existing local branch
  1670→        await execAsync(
  1671→          `git worktree add "${directoryName}" ${branchName}`,
  1672→          { cwd: projectRoot },
  1673→        );
  1674→      }
  1675→
  1676→      result.worktreeCreated = true;
  1677→    }
  1678→
  1679→    // Step 3: Create initial structure if empty (only for new branches, not remote)
  1680→    const manifestPath = path.join(worktreeDir, `${slug}.yaml`);
  1681→    const modulesDir = path.join(worktreeDir, "modules");
  1682→    const moduleFilePath = path.join(modulesDir, "main.yaml");
  1683→    const tasksPath = path.join(worktreeDir, `${slug}.tasks.yaml`);
  1684→    const inboxPath = path.join(worktreeDir, `${slug}.inbox.yaml`);
  1685→
  1686→    let filesCreated = false;
  1687→
  1688→    // Only create files if manifest doesn't exist (remote branches will have files)
  1689→    try {
  1690→      // Look for any .yaml manifest file (project name may differ)
  1691→      const files = await fs.readdir(worktreeDir);
  1692→      const hasManifest = files.some(
  1693→        (f) =>
  1694→          f.endsWith(".yaml") &&
  1695→          !f.includes(".tasks.") &&
  1696→          !f.includes(".inbox."),
  1697→      );
  1698→      if (!hasManifest) {
  1699→        throw new Error("No manifest found");
  1700→      }
  1701→    } catch {
  1702→      // Manifest doesn't exist, create initial structure
  1703→      await fs.mkdir(modulesDir, { recursive: true });
  1704→      await fs.writeFile(
  1705→        manifestPath,
  1706→        generateShadowManifest(projectName),
  1707→        "utf-8",
  1708→      );
  1709→      await fs.writeFile(
  1710→        moduleFilePath,
  1711→        generateShadowModule(projectName),
  1712→        "utf-8",
  1713→      );
  1714→      await fs.writeFile(tasksPath, generateShadowTasks(projectName), "utf-8");
  1715→      await fs.writeFile(inboxPath, generateShadowInbox(), "utf-8");
  1716→
  1717→      // AC: @artifacts-directory ac-init-creates, ac-gitignore-entry
  1718→      const artifactsDir = path.join(worktreeDir, "artifacts");
  1719→      await fs.mkdir(artifactsDir, { recursive: true });
  1720→      await fs.writeFile(
  1721→        path.join(worktreeDir, ".gitignore"),
  1722→        "# Ephemeral artifacts - reports, exports, generated files\n# Not tracked in shadow branch\nartifacts/\n",
  1723→        "utf-8",
  1724→      );
  1725→
  1726→      filesCreated = true;
  1727→    }
  1728→
  1729→    // Step 4: Initial commit if files were created
  1730→    if (filesCreated) {
  1731→      result.initialCommit = await shadowAutoCommit(
  1732→        worktreeDir,
  1733→        `Initialize ${projectName} spec`,
  1734→      );
  1735→    }
  1736→
  1737→    // Step 5: AC-2: Push new branch to remote to establish tracking
  1738→    if (result.branchCreated && remoteExists && !remoteHasShadow) {
  1739→      result.pushedToRemote = await pushShadowBranch(worktreeDir, remoteName, options.shadow);
  1740→    }
  1741→
  1742→    // Step 6: Install pre-commit hook to protect shadow branch
  1743→    await installShadowHook(projectRoot);
  1744→
  1745→    // Step 7: Configure merge driver for semantic YAML merging
  1746→    // AC: @yaml-merge-driver ac-12
  1747→    await configureMergeDriver(projectRoot, worktreeDir);
  1748→
  1749→    result.success = true;
  1750→    return result;
  1751→  } catch (error) {
  1752→    result.error = error instanceof Error ? error.message : String(error);
  1753→    return result;
  1754→  }
  1755→}
  1756→
  1757→/**
  1758→ * Repair a broken shadow branch setup.
  1759→ * Handles cases where worktree is disconnected or directory is missing.
  1760→ *
  1761→ * AC: @config-shadow ac-7 — backward compat when called without config
  1762→ *
  1763→ * @param projectRoot Git repository root
  1764→ * @param options Optional shadow configuration
  1765→ * @returns Result indicating what was repaired
  1766→ */
  1767→export async function repairShadow(
  1768→  projectRoot: string,
  1769→  options?: ShadowOptions,
  1770→): Promise<ShadowInitResult> {
  1771→  const branchName = getBranchName(options);
  1772→  const directoryName = getDirectoryName(options);
  1773→  const status = await getShadowStatus(projectRoot, options);
  1774→
  1775→  if (status.healthy) {
  1776→    return {
  1777→      success: true,
  1778→      branchCreated: false,
  1779→      worktreeCreated: false,
  1780→      gitignoreUpdated: false,
  1781→      initialCommit: false,
  1782→      alreadyExists: true,
  1783→      createdFromRemote: false,
  1784→      pushedToRemote: false,
  1785→    };
  1786→  }
  1787→
  1788→  if (!status.branchExists) {
  1789→    // Can't repair without a branch - need full init
  1790→    return {
  1791→      success: false,
  1792→      branchCreated: false,
  1793→      worktreeCreated: false,
  1794→      gitignoreUpdated: false,
  1795→      initialCommit: false,
  1796→      alreadyExists: false,
  1797→      createdFromRemote: false,
  1798→      pushedToRemote: false,
  1799→      error: "Shadow branch does not exist. Run `kspec init` instead.",
  1800→    };
  1801→  }
  1802→
  1803→  // Branch exists but worktree is broken - repair it
  1804→  const worktreeDir = path.join(projectRoot, directoryName);
  1805→
  1806→  try {
  1807→    // Remove stale worktree reference
  1808→    try {
  1809→      await execAsync(`git worktree remove "${directoryName}" --force`, {
  1810→        cwd: projectRoot,
  1811→      });
  1812→    } catch {
  1813→      // Ignore - worktree may not be in git's list
  1814→    }
  1815→
  1816→    // Remove directory if exists (handles corrupted .git file case)
  1817→    await fs.rm(worktreeDir, { recursive: true, force: true });
  1818→
  1819→    // Prune stale worktree references (cleans up orphaned entries)
  1820→    try {
  1821→      await execAsync("git worktree prune", { cwd: projectRoot });
  1822→    } catch {
  1823→      // Ignore - prune is best-effort
  1824→    }
  1825→
  1826→    // Recreate worktree
  1827→    await execAsync(
  1828→      `git worktree add "${directoryName}" ${branchName}`,
  1829→      { cwd: projectRoot },
  1830→    );
  1831→
  1832→    // Install pre-commit hook
  1833→    await installShadowHook(projectRoot);
  1834→
  1835→    // AC: @artifacts-directory ac-repair-recreates
  1836→    const artifactsDir = path.join(worktreeDir, "artifacts");
  1837→    await fs.mkdir(artifactsDir, { recursive: true });
  1838→
  1839→    return {
  1840→      success: true,
  1841→      branchCreated: false,
  1842→      worktreeCreated: true,
  1843→      gitignoreUpdated: false,
  1844→      initialCommit: false,
  1845→      alreadyExists: false,
  1846→      createdFromRemote: false,
  1847→      pushedToRemote: false,
  1848→    };
  1849→  } catch (error) {
  1850→    return {
  1851→      success: false,
  1852→      branchCreated: false,
  1853→      worktreeCreated: false,
  1854→      gitignoreUpdated: false,
  1855→      initialCommit: false,
  1856→      alreadyExists: false,
  1857→      createdFromRemote: false,
  1858→      pushedToRemote: false,
  1859→      error: error instanceof Error ? error.message : String(error),
  1860→    };
  1861→  }
  1862→}
  1863→