   223→    // Should NOT show any skill invocation behavior
   224→    expect(result.output).not.toContain('Invoking skill');
   225→    expect(result.output).not.toContain('Detected skill command');
   226→    expect(result.output).not.toContain('Running /task-work');
   227→    expect(result.output).not.toContain('Running /reflect');
   228→
   229→    // The text should appear in the output (proving Ralph doesn't filter it)
