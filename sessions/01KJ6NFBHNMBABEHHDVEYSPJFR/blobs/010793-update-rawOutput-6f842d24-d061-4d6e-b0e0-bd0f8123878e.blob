  1370→
  1371→    it('handles full phased lifecycle: empty tool_call → populated tool_call_update → completed', () => {
  1372→      const translator = createTranslator();
  1373→
  1374→      // Phase 1: tool_call with empty rawInput
  1375→      const start = translator.translate({
