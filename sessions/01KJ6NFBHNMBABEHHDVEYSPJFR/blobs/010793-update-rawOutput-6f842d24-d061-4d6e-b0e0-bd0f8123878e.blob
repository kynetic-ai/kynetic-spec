   492→
   493→  // ─── Event Logging Iteration Attribution ──────────────────────────────────
   494→
   495→  describe('event logging iteration attribution', () => {
   496→    it('tags streaming update events with the correct iteration number', async () => {
   497→      // Run 2 iterations — the update handler persists across both.
   498→      // Each iteration creates a fresh ACP session; the handler must attribute
   499→      // updates to the iteration that owns that ACP session, not a stale counter.
   500→      const result = runRalph('--max-loops 2', tempDir, {
   501→        MOCK_ACP_EXIT_CODE: '0',
   502→      });
   503→
   504→      expect(result.exitCode).toBe(0);
   505→
   506→      const sessionsDir = path.join(tempDir, 'sessions');
   507→      const sessions = await fs.readdir(sessionsDir).catch(() => []);
   508→      expect(sessions.length).toBeGreaterThan(0);
   509→
   510→      const eventsPath = path.join(sessionsDir, sessions[0], 'events.jsonl');
   511→      const eventsRaw = await fs.readFile(eventsPath, 'utf-8');
   512→      const events = eventsRaw
   513→        .trim()
   514→        .split('\n')
   515→        .map((line) => JSON.parse(line));
   516→
   517→      // Find streaming update events (contain an "update" object in data)
   518→      const streamingUpdates = events.filter(
   519→        (e: { type: string; data?: { update?: unknown; iteration?: number } }) =>
   520→          e.type === 'session.update' && e.data?.update != null,
   521→      );
   522→
   523→      // We expect at least one streaming update per iteration
   524→      expect(streamingUpdates.length).toBeGreaterThanOrEqual(2);
   525→
   526→      // Verify iteration numbers are present and valid (1 or 2, never 0)
   527→      for (const ev of streamingUpdates) {
   528→        expect(ev.data.iteration).toBeGreaterThanOrEqual(1);
   529→        expect(ev.data.iteration).toBeLessThanOrEqual(2);
   530→      }
   531→
   532→      // Both iterations should be represented
   533→      const iterationNumbers = new Set(
   534→        streamingUpdates.map((e: { data: { iteration: number } }) => e.data.iteration),
   535→      );
   536→      expect(iterationNumbers.has(1)).toBe(true);
   537→      expect(iterationNumbers.has(2)).toBe(true);
   538→    });
   539→
   540→    it('never tags events with iteration 0 (stale/unmapped fallback)', async () => {
   541→      const result = runRalph('--max-loops 1', tempDir, {
   542→        MOCK_ACP_EXIT_CODE: '0',
   543→      });
   544→
   545→      expect(result.exitCode).toBe(0);
   546→
   547→      const sessionsDir = path.join(tempDir, 'sessions');
   548→      const sessions = await fs.readdir(sessionsDir).catch(() => []);
   549→      expect(sessions.length).toBeGreaterThan(0);
   550→
   551→      const eventsPath = path.join(sessionsDir, sessions[0], 'events.jsonl');
   552→      const eventsRaw = await fs.readFile(eventsPath, 'utf-8');
   553→      const events = eventsRaw
   554→        .trim()
   555→        .split('\n')
   556→        .map((line) => JSON.parse(line));
   557→
   558→      const streamingUpdates = events.filter(
   559→        (e: { type: string; data?: { update?: unknown; iteration?: number } }) =>
   560→          e.type === 'session.update' && e.data?.update != null,
   561→      );
   562→
   563→      // Every streaming update should have iteration >= 1 (0 means unmapped session)
   564→      for (const ev of streamingUpdates) {
   565→        expect(ev.data.iteration).toBeGreaterThanOrEqual(1);
   566→      }
   567→    });
   568→  });
   569→});
   570→
   571→// ─── Event Translator Unit Tests ────────────────────────────────────────────
   572→
   573→describe('ralph event translator', () => {
   574→  // Helper to create SessionUpdate objects
   575→  function makeChunk(
   576→    type: 'agent_message_chunk' | 'agent_thought_chunk',
   577→    text: string
   578→  ): SessionUpdate {
   579→    return {
   580→      sessionUpdate: type,
   581→      content: { type: 'text', text },
   582→    } as SessionUpdate;
   583→  }
   584→
   585→  describe('agent_message_chunk', () => {
   586→    it('translates streaming content', () => {
   587→      const translator = createTranslator();
   588→      const event = translator.translate(makeChunk('agent_message_chunk', 'Hello'));
   589→
   590→      expect(event).not.toBeNull();
   591→      expect(event!.type).toBe('agent_message');
   592→      expect(event!.data).toMatchObject({
   593→        kind: 'agent_message',
   594→        content: 'Hello',
   595→        isStreaming: true,
   596→      });
   597→    });
   598→
   599→    it('finalizes on empty string signal', () => {
   600→      const translator = createTranslator();
   601→
   602→      // First, stream some content
   603→      translator.translate(makeChunk('agent_message_chunk', 'Hello'));
   604→      translator.translate(makeChunk('agent_message_chunk', ' world'));
   605→
   606→      // Then send empty string to finalize
   607→      const finalEvent = translator.translate(makeChunk('agent_message_chunk', ''));
   608→
   609→      expect(finalEvent).not.toBeNull();
   610→      expect(finalEvent!.type).toBe('agent_message');
   611→      expect(finalEvent!.data).toMatchObject({
   612→        kind: 'agent_message',
   613→        content: 'Hello world',
   614→        isStreaming: false,
   615→      });
   616→    });
   617→
   618→    it('returns null for empty string when no active message', () => {
   619→      const translator = createTranslator();
   620→
   621→      // Send empty string without prior content
   622→      const event = translator.translate(makeChunk('agent_message_chunk', ''));
   623→
   624→      expect(event).toBeNull();
   625→    });
   626→  });
   627→
   628→  describe('agent_thought_chunk', () => {
   629→    it('translates streaming thought content', () => {
   630→      const translator = createTranslator();
   631→      const event = translator.translate(makeChunk('agent_thought_chunk', 'Thinking...'));
   632→
   633→      expect(event).not.toBeNull();
   634→      expect(event!.type).toBe('agent_thought');
   635→      expect(event!.data).toMatchObject({
   636→        kind: 'agent_thought',
   637→        content: 'Thinking...',
   638→        isStreaming: true,
   639→      });
   640→    });
   641→
   642→    it('finalizes on empty string signal', () => {
   643→      const translator = createTranslator();
   644→
   645→      // Stream some thought content
   646→      translator.translate(makeChunk('agent_thought_chunk', 'Let me think'));
   647→      translator.translate(makeChunk('agent_thought_chunk', ' about this'));
   648→
   649→      // Finalize with empty string
   650→      const finalEvent = translator.translate(makeChunk('agent_thought_chunk', ''));
   651→
   652→      expect(finalEvent).not.toBeNull();
   653→      expect(finalEvent!.type).toBe('agent_thought');
   654→      expect(finalEvent!.data).toMatchObject({
   655→        kind: 'agent_thought',
   656→        content: 'Let me think about this',
   657→        isStreaming: false,
   658→      });
   659→    });
   660→  });
   661→
   662→  describe('finalize()', () => {
   663→    it('returns final event for pending message', () => {
   664→      const translator = createTranslator();
   665→
   666→      // Stream content without empty string finalization
   667→      translator.translate(makeChunk('agent_message_chunk', 'Incomplete'));
   668→
   669→      // Call finalize explicitly
   670→      const finalEvent = translator.finalize();
   671→
   672→      expect(finalEvent).not.toBeNull();
   673→      expect(finalEvent!.type).toBe('agent_message');
   674→      expect(finalEvent!.data).toMatchObject({
   675→        kind: 'agent_message',
   676→        content: 'Incomplete',
   677→        isStreaming: false,
   678→      });
   679→    });
   680→
   681→    it('returns null when no pending message', () => {
   682→      const translator = createTranslator();
   683→
   684→      const event = translator.finalize();
   685→
   686→      expect(event).toBeNull();
   687→    });
   688→
   689→    it('clears state after finalize', () => {
   690→      const translator = createTranslator();
   691→
   692→      translator.translate(makeChunk('agent_message_chunk', 'Test'));
   693→      translator.finalize();
   694→
   695→      // Second finalize should return null
   696→      const secondFinalize = translator.finalize();
   697→      expect(secondFinalize).toBeNull();
   698→    });
   699→  });
   700→
   701→  describe('noise suppression', () => {
   702→    it('suppresses standalone onPostToolUseHook messages', () => {
   703→      const translator = createTranslator();
   704→      const event = translator.translate(
   705→        makeChunk('agent_message_chunk', 'No onPostToolUseHook found for tool use ID: toolu_01LCkxN6GwoWUfvy7wqwp3sW')
   706→      );
   707→
   708→      expect(event).toBeNull();
   709→    });
   710→
   711→    it('suppresses standalone onPreToolUseHook messages', () => {
   712→      const translator = createTranslator();
   713→      const event = translator.translate(
   714→        makeChunk('agent_message_chunk', 'No onPreToolUseHook found for tool use')
   715→      );
   716→
   717→      expect(event).toBeNull();
   718→    });
   719→
   720→    it('strips embedded hook noise while preserving surrounding content', () => {
   721→      const translator = createTranslator();
   722→      // Simulates the observed bug: noise concatenated with agent message
   723→      const event = translator.translate(
   724→        makeChunk('agent_message_chunk', 'Excellent creative brief. Now launching Phase 2...No onPostToolUseHook found for tool use ID: toolu_01LCkxN6GwoWUfvy7wqwp3sW')
   725→      );
   726→
   727→      expect(event).not.toBeNull();
   728→      expect(event!.type).toBe('agent_message');
   729→      expect((event!.data as { content: string }).content).toBe('Excellent creative brief. Now launching Phase 2...');
   730→    });
   731→
   732→    it('strips multiple noise patterns from same chunk', () => {
   733→      const translator = createTranslator();
   734→      // Realistic pattern: two hook warnings with proper toolu_ format (24 chars after toolu_)
   735→      const event = translator.translate(
   736→        makeChunk('agent_message_chunk', 'Start No onPreToolUseHook found for tool use ID: toolu_01ABC2345678901234567890 middle No onPostToolUseHook found for tool use ID: toolu_01XYZ2345678901234567890 end')
   737→      );
   738→
   739→      expect(event).not.toBeNull();
   740→      // Content between/around noise is preserved (with empty space where noise was)
   741→      expect((event!.data as { content: string }).content).toBe('Start  middle  end');
   742→    });
   743→
   744→    it('preserves content that directly follows noise without whitespace', () => {
   745→      const translator = createTranslator();
   746→      // Edge case: noise followed immediately by real content with no separator
   747→      // The tool ID pattern matches exactly 26 chars, so 'Hello' won't be consumed
   748→      const event = translator.translate(
   749→        makeChunk('agent_message_chunk', 'No onPostToolUseHook found for tool use ID: toolu_01LCkxN6GwoWUfvy7wqwp3sWHello world')
   750→      );
   751→
   752→      expect(event).not.toBeNull();
   753→      // 'Hello world' should be preserved, not eaten by greedy matching
   754→      expect((event!.data as { content: string }).content).toBe('Hello world');
   755→    });
   756→
   757→    it('accumulates cleaned content across chunks', () => {
   758→      const translator = createTranslator();
   759→
   760→      // Chunk with noise concatenated directly at the end (no space before noise)
   761→      // Tool ID must be exactly 24 chars after toolu_
   762→      translator.translate(
   763→        makeChunk('agent_message_chunk', 'First part.No onPostToolUseHook found for tool use ID: toolu_01XYZ2345678901234567890')
   764→      );
   765→
   766→      // Clean chunk with leading space
   767→      translator.translate(
   768→        makeChunk('agent_message_chunk', ' Second part.')
   769→      );
   770→
   771→      // Finalize
   772→      const final = translator.translate(makeChunk('agent_message_chunk', ''));
   773→
   774→      expect(final).not.toBeNull();
   775→      expect((final!.data as { content: string }).content).toBe('First part. Second part.');
   776→    });
   777→
   778→    it('strips noise from accumulated content at finalization', () => {
   779→      const translator = createTranslator();
   780→
   781→      // Accumulate content that will contain noise when combined
   782→      translator.translate(
   783→        makeChunk('agent_message_chunk', 'Hello ')
   784→      );
   785→
   786→      // Noise arrives in its own chunk
   787→      translator.translate(
   788→        makeChunk('agent_message_chunk', 'No onPostToolUseHook found for tool use ID: toolu_01LCkxN6GwoWUfvy7wqwp3sW')
   789→      );
   790→
   791→      // More content
   792→      translator.translate(
   793→        makeChunk('agent_message_chunk', ' World')
   794→      );
   795→
   796→      // Finalize - accumulated content should be cleaned
   797→      const final = translator.translate(makeChunk('agent_message_chunk', ''));
   798→
   799→      expect(final).not.toBeNull();
   800→      // Noise stripped from accumulated content at finalization
   801→      expect((final!.data as { content: string }).content).toBe('Hello  World');
   802→    });
   803→
   804→    it('handles noise in thought chunks the same way', () => {
   805→      const translator = createTranslator();
   806→      const event = translator.translate(
   807→        makeChunk('agent_thought_chunk', 'Thinking about this...No onPostToolUseHook found for tool use ID: toolu_01LCkxN6GwoWUfvy7wqwp3sW')
   808→      );
   809→
   810→      expect(event).not.toBeNull();
   811→      expect(event!.type).toBe('agent_thought');
   812→      expect((event!.data as { content: string }).content).toBe('Thinking about this...');
   813→    });
   814→
   815→    it('preserves whitespace-only chunks that are not noise', () => {
   816→      const translator = createTranslator();
   817→
   818→      // Whitespace-only chunks can be legitimate streaming tokens (formatting, newlines)
   819→      const spaceEvent = translator.translate(makeChunk('agent_message_chunk', ' '));
   820→      expect(spaceEvent).not.toBeNull();
   821→      expect((spaceEvent!.data as { content: string }).content).toBe(' ');
   822→
   823→      // Reset translator for thought chunk test
