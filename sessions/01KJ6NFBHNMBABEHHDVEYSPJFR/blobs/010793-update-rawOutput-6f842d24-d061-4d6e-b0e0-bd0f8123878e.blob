  1764→      );
  1765→      await fs.writeFile(tasksPath, modified);
  1766→
  1767→      const result = runRalph('--max-loops 5 --tasks @test-task-pending', tempDir, {
  1768→        MOCK_ACP_EXIT_CODE: '0',
