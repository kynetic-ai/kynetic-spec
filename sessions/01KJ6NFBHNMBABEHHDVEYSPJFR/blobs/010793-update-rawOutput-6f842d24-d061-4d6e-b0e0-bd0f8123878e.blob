   383→  // AC: @cli-ralph ac-13 - Context snapshot saving
   384→  it('saves session context snapshot after each iteration', async () => {
   385→    const result = runRalph('--max-loops 2', tempDir, {
   386→      MOCK_ACP_EXIT_CODE: '0',
   387→    });
   388→
   389→    // Check that context snapshots were saved
   390→    const sessionsDir = path.join(tempDir, 'sessions');
   391→    const sessions = await fs.readdir(sessionsDir).catch(() => []);
   392→
   393→    expect(sessions.length).toBeGreaterThan(0);
   394→
   395→    if (sessions.length > 0) {
   396→      const sessionDir = path.join(sessionsDir, sessions[0]);
   397→
   398→      // Should have context snapshots for iteration 1 and 2
   399→      const context1Path = path.join(sessionDir, 'context-iter-1.json');
   400→      const context2Path = path.join(sessionDir, 'context-iter-2.json');
   401→
   402→      const context1Exists = await fs.access(context1Path).then(() => true).catch(() => false);
   403→      const context2Exists = await fs.access(context2Path).then(() => true).catch(() => false);
   404→
   405→      expect(context1Exists).toBe(true);
   406→      expect(context2Exists).toBe(true);
   407→
   408→      // Verify context structure
   409→      const context1Content = await fs.readFile(context1Path, 'utf-8');
   410→      const context1 = JSON.parse(context1Content);
   411→
   412→      expect(context1).toHaveProperty('generated_at');
   413→      expect(context1).toHaveProperty('branch');
   414→      expect(context1).toHaveProperty('active_tasks');
   415→      expect(context1).toHaveProperty('ready_tasks');
   416→      expect(context1).toHaveProperty('stats');
   417→    }
   418→  });
