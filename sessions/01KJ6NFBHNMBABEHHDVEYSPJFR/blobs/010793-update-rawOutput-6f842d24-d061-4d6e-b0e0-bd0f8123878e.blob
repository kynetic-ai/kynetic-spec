  1086→
  1087→    it('deduplicates phased tool_call events (same tool_call_id)', () => {
  1088→      const translator = createTranslator();
  1089→
  1090→      // Phase 1: Registration with no input
  1091→      const event1 = translator.translate({
  1092→        sessionUpdate: 'tool_call',
  1093→        toolCallId: 'toolu_phased',
  1094→        rawInput: {},
  1095→        _meta: { claudeCode: { toolName: 'Bash' } },
  1096→      } as SessionUpdate);
  1097→
  1098→      expect(event1).not.toBeNull();
