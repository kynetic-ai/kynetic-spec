  1724→    // AC: @cli-ralph ac-21 - Only shows explicitly listed tasks in context
  1725→    it('filters context to only include explicit tasks', async () => {
  1726→      const result = runRalph('--dry-run --tasks @test-task-pending', tempDir);
  1727→
  1728→      // Context should only show the explicitly listed task
  1729→      // The ready_tasks should not include test-task-secondary (even though it's pending)
  1730→      expect(result.stdout).toContain('test-task-pending');
  1731→
  1732→      // Parse the JSON context from output to verify filtering
  1733→      const contextMatch = result.stdout.match(/## Current State\s+```json\s+([\s\S]*?)\s+```/);
  1734→      if (contextMatch) {
  1735→        const context = JSON.parse(contextMatch[1]);
  1736→        // Ready tasks should only include the explicit task
  1737→        const readyRefs = context.ready_tasks.map((t: { ref: string }) => t.ref);
  1738→        expect(readyRefs.length).toBeLessThanOrEqual(1);
  1739→        // Should not include test-task-secondary
  1740→        expect(readyRefs).not.toContain('01KF1645C'); // Short ULID prefix for secondary
  1741→      }
  1742→    });
