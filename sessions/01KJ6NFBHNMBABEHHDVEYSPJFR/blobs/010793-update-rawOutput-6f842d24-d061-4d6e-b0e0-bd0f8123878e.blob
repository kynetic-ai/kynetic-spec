   312→    // Use kspec directly to test explicit deprecated adapter name
   313→    const result = spawnSync(
   314→      'node',
   315→      [CLI_PATH, 'ralph', '--dry-run', '--adapter', 'claude-code-acp'],
   316→      {
   317→        cwd: tempDir,
   318→        encoding: 'utf-8',
   319→        timeout: 30000,
   320→        env: { ...process.env, KSPEC_AUTHOR: '@test' },
   321→      }
   322→    );
   323→
   324→    // Deprecated name should still work and show in output
   325→    expect(result.stdout).toContain('adapter=claude-code-acp');
   326→    // Should not fail validation (it's a registered adapter, not ad-hoc)
