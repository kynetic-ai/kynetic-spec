   420→  // ─── Adapter Validation Tests ──────────────────────────────────────────────
   421→
   422→  // AC: @ralph-adapter-validation valid-adapter-proceeds
   423→  it('proceeds with valid adapter (uses --adapter-cmd for testing)', async () => {
