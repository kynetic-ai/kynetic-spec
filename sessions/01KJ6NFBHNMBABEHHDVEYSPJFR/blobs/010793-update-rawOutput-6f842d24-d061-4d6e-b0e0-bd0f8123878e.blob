   361→
   362→  // AC: @cli-ralph ac-12 - Event logging
   363→  it('logs prompt.sent events', async () => {
   364→    const result = runRalph('--max-loops 1', tempDir, {
   365→      MOCK_ACP_EXIT_CODE: '0',
   366→    });
   367→
   368→    // Check events file
   369→    const sessionsDir = path.join(tempDir, 'sessions');
   370→    const sessions = await fs.readdir(sessionsDir).catch(() => []);
   371→
   372→    if (sessions.length > 0) {
   373→      const eventsPath = path.join(sessionsDir, sessions[0], 'events.jsonl');
   374→      const events = await fs.readFile(eventsPath, 'utf-8');
   375→
   376→      // Should have session.start, prompt.sent, and session.end at minimum
   377→      expect(events).toContain('"type":"session.start"');
   378→      expect(events).toContain('"type":"prompt.sent"');
