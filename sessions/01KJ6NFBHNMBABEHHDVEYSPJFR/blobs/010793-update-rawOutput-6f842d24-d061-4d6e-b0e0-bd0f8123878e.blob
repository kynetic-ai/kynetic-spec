  1390→      } as SessionUpdate);
  1391→      expect(update!.type).toBe('tool_update');
  1392→      expect((update!.data as { summary: string }).summary).toBe('main.ts');
  1393→
  1394→      // Phase 3: tool_call_update completed
  1395→      const result = translator.translate({
  1396→        sessionUpdate: 'tool_call_update',
  1397→        toolCallId: 'toolu_full_lifecycle',
  1398→        status: 'completed',
  1399→        rawOutput: [{ type: 'text', text: 'file contents' }],
  1400→        _meta: { claudeCode: { toolName: 'Read' } },
  1401→      } as SessionUpdate);
  1402→      expect(result!.type).toBe('tool_result');
  1403→      expect((result!.data as { output: string }).output).toBe('file contents');
  1404→    });
  1405→  });
  1406→});
