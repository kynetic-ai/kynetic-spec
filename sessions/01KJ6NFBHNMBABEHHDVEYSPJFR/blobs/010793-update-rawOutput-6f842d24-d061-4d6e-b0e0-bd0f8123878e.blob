  1015→  });
  1016→
  1017→  describe('tool_call events', () => {
  1018→    it('extracts tool name and summary from rawInput (ACP format)', () => {
  1019→      const translator = createTranslator();
  1020→      const event = translator.translate({
  1021→        sessionUpdate: 'tool_call',
  1022→        toolCallId: 'toolu_123',
  1023→        rawInput: { command: 'npm run build' },
  1024→        _meta: { claudeCode: { toolName: 'Bash' } },
