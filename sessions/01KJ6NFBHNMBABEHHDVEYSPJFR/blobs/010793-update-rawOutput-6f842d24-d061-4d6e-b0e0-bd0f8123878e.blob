  1408→// ─── Subagent Module Tests ────────────────────────────────────────────────────
  1409→
  1410→import {
  1411→  buildSubagentPrompt,
  1412→  DEFAULT_SUBAGENT_PREFIX,
  1413→  DEFAULT_SUBAGENT_TIMEOUT,
  1414→  SKILL_PR_REVIEW,
  1415→  SKILL_REFLECT,
  1416→  SKILL_TASK_WORK,
  1417→  type SubagentContext,
  1418→} from '../src/ralph/subagent.js';
  1419→import { createPrefixedRenderer } from '../src/ralph/cli-renderer.js';
  1420→
  1421→describe('subagent module', () => {
  1422→  // AC: @ralph-subagent-spawning ac-2, ac-10
  1423→  describe('buildSubagentPrompt', () => {
  1424→    it('includes task reference in prompt', () => {
  1425→      const context: SubagentContext = {
  1426→        taskRef: '@task-example',
  1427→        taskDetails: { title: 'Example Task', status: 'pending_review' },
  1428→        specWithACs: null,
  1429→        gitBranch: 'feat/example',
  1430→      };
  1431→
  1432→      const prompt = buildSubagentPrompt(context);
  1433→
  1434→      expect(prompt).toContain('@task-example');
  1435→      expect(prompt).toContain(`${SKILL_PR_REVIEW} @task-example`);
  1436→    });
  1437→
  1438→    it('includes git branch in prompt', () => {
  1439→      const context: SubagentContext = {
  1440→        taskRef: '@task-example',
  1441→        taskDetails: { title: 'Example Task' },
  1442→        specWithACs: null,
  1443→        gitBranch: 'feat/my-branch',
  1444→      };
  1445→
  1446→      const prompt = buildSubagentPrompt(context);
  1447→
  1448→      expect(prompt).toContain('feat/my-branch');
  1449→    });
  1450→
  1451→    it('includes task details as JSON', () => {
  1452→      const context: SubagentContext = {
  1453→        taskRef: '@task-example',
  1454→        taskDetails: { title: 'Test Task', priority: 1 },
  1455→        specWithACs: null,
  1456→        gitBranch: 'main',
  1457→      };
  1458→
  1459→      const prompt = buildSubagentPrompt(context);
  1460→
  1461→      expect(prompt).toContain('"title": "Test Task"');
  1462→      expect(prompt).toContain('"priority": 1');
  1463→    });
  1464→
  1465→    it('includes spec with ACs when provided', () => {
  1466→      const context: SubagentContext = {
  1467→        taskRef: '@task-example',
  1468→        taskDetails: { title: 'Test Task' },
  1469→        specWithACs: {
  1470→          title: 'Example Spec',
  1471→          acceptance_criteria: [
  1472→            { id: 'ac-1', given: 'condition', when: 'action', then: 'result' },
  1473→          ],
  1474→        },
  1475→        gitBranch: 'main',
  1476→      };
  1477→
  1478→      const prompt = buildSubagentPrompt(context);
  1479→
  1480→      expect(prompt).toContain('Example Spec');
  1481→      expect(prompt).toContain('acceptance_criteria');
  1482→      expect(prompt).toContain('Verify all ACs have test coverage');
  1483→    });
  1484→
  1485→    it('omits spec section when specWithACs is null', () => {
  1486→      const context: SubagentContext = {
  1487→        taskRef: '@task-example',
  1488→        taskDetails: { title: 'Test Task' },
  1489→        specWithACs: null,
  1490→        gitBranch: 'main',
  1491→      };
  1492→
  1493→      const prompt = buildSubagentPrompt(context);
  1494→
  1495→      expect(prompt).not.toContain('Linked Spec with Acceptance Criteria');
  1496→    });
  1497→
  1498→    it('instructs subagent to run PR review skill using default constant', () => {
  1499→      const context: SubagentContext = {
  1500→        taskRef: '@task-my-feature',
  1501→        taskDetails: {},
  1502→        specWithACs: null,
  1503→        gitBranch: 'main',
  1504→      };
  1505→
  1506→      const prompt = buildSubagentPrompt(context);
  1507→
  1508→      expect(prompt).toContain(`${SKILL_PR_REVIEW} @task-my-feature`);
  1509→    });
  1510→
  1511→    it('accepts custom skill name for PR review', () => {
  1512→      const context: SubagentContext = {
  1513→        taskRef: '@task-my-feature',
  1514→        taskDetails: {},
  1515→        specWithACs: null,
  1516→        gitBranch: 'main',
  1517→      };
  1518→
  1519→      const prompt = buildSubagentPrompt(context, '/my-custom-review');
  1520→
  1521→      expect(prompt).toContain('/my-custom-review @task-my-feature');
  1522→      expect(prompt).not.toContain(SKILL_PR_REVIEW);
