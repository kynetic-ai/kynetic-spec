  1027→      expect(event).not.toBeNull();
  1028→      expect(event!.type).toBe('tool_start');
  1029→      expect(event!.data).toMatchObject({
  1030→        kind: 'tool_start',
  1031→        toolCallId: 'toolu_123',
  1032→        tool: 'Bash',
  1033→        summary: 'npm run build',
  1034→      });
  1035→    });
