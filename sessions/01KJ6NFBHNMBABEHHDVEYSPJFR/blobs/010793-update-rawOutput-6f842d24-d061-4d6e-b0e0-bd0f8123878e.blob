   328→  });
   329→
   330→  // AC: @cli-ralph ac-10 - Session creation
   331→  it('creates session and logs events', async () => {
   332→    const result = runRalph('--max-loops 1', tempDir, {
   333→      MOCK_ACP_EXIT_CODE: '0',
   334→    });
   335→
   336→    // Check that session directory was created
   337→    const sessionsDir = path.join(tempDir, 'sessions');
