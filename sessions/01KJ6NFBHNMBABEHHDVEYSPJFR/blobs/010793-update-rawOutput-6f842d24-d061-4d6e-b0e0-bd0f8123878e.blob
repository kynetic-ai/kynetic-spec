   825→      const newlineEvent = thoughtTranslator.translate(makeChunk('agent_thought_chunk', '\n'));
   826→      expect(newlineEvent).not.toBeNull();
   827→      expect((newlineEvent!.data as { content: string }).content).toBe('\n');
   828→    });
   829→
   830→    it('preserves whitespace in accumulated content with noise stripped', () => {
   831→      const translator = createTranslator();
   832→
   833→      // First chunk with noise embedded
   834→      translator.translate(
   835→        makeChunk('agent_message_chunk', 'Hello')
   836→      );
   837→
   838→      // Whitespace chunk
   839→      translator.translate(
   840→        makeChunk('agent_message_chunk', ' ')
   841→      );
   842→
   843→      // More content
