   855→    // ─── Split-Chunk Boundary Tests ─────────────────────────────────────────────
   856→    // AC: @01KHASR8 - noise patterns split across chunk boundaries
   857→
   858→    it('buffers and suppresses noise split at "No onPostToolUse" / "Hook found..."', () => {
   859→      const translator = createTranslator();
   860→
   861→      // First chunk: real content followed by partial noise
   862→      const event1 = translator.translate(
   863→        makeChunk('agent_message_chunk', 'Real content. No onPostToolUse')
   864→      );
   865→
   866→      // Should emit real content, buffer the partial noise
   867→      expect(event1).not.toBeNull();
   868→      expect((event1!.data as { content: string }).content).toBe('Real content. ');
   869→
   870→      // Second chunk: rest of noise pattern
   871→      const event2 = translator.translate(
   872→        makeChunk('agent_message_chunk', 'Hook found for tool use ID: toolu_01ABC2345678901234567890')
   873→      );
   874→
   875→      // Should suppress - the combined content matches full noise pattern
   876→      expect(event2).toBeNull();
   877→
   878→      // Finalize - should return accumulated content without noise
   879→      const final = translator.translate(makeChunk('agent_message_chunk', ''));
   880→      expect(final).not.toBeNull();
   881→      expect((final!.data as { content: string }).content).toBe('Real content. ');
   882→    });
   883→
   884→    it('buffers and suppresses noise split at "No on" / "PostToolUseHook found..."', () => {
