   434→
   435→  // AC: @ralph-adapter-validation invalid-adapter-error
   436→  it('exits with code 3 and clear error for invalid adapter', async () => {
   437→    // Run without --adapter-cmd to trigger validation
   438→    const result = spawnSync(
   439→      'node',
