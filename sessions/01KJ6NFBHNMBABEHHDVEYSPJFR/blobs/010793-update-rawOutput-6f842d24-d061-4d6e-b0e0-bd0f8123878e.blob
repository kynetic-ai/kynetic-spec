  1524→  });
  1525→
  1526→  describe('constants', () => {
  1527→    // AC: @ralph-subagent-spawning ac-9
  1528→    it('DEFAULT_SUBAGENT_TIMEOUT is 20 minutes', () => {
  1529→      expect(DEFAULT_SUBAGENT_TIMEOUT).toBe(20 * 60 * 1000);
  1530→    });
  1531→
  1532→    // AC: @ralph-subagent-spawning ac-11
  1533→    it('DEFAULT_SUBAGENT_PREFIX is [REVIEW SUBAGENT]', () => {
  1534→      expect(DEFAULT_SUBAGENT_PREFIX).toBe('[REVIEW SUBAGENT]');
  1535→    });
  1536→
  1537→    it('skill invocation constants use kspec: namespace by default', () => {
  1538→      expect(SKILL_TASK_WORK).toBe('/kspec:task-work');
  1539→      expect(SKILL_REFLECT).toBe('/kspec:reflect');
  1540→      expect(SKILL_PR_REVIEW).toBe('/kspec:review');
  1541→    });
  1542→  });
  1543→
  1544→  // AC: @ralph-subagent-spawning ac-11
  1545→  describe('createPrefixedRenderer', () => {
  1546→    it('does not double prefix for console.log output', () => {
  1547→      const renderer = createPrefixedRenderer('[TEST]');
  1548→
  1549→      // Spy on console.log to capture what the wrapper passes to the original
  1550→      const logCalls: unknown[][] = [];
  1551→      const spy = vi.spyOn(console, 'log').mockImplementation((...args: unknown[]) => {
  1552→        logCalls.push(args);
  1553→      });
  1554→
  1555→      try {
  1556→        renderer.newSection?.('My Section');
  1557→      } finally {
  1558→        spy.mockRestore();
  1559→      }
  1560→
  1561→      // The wrapper should NOT pass the prefix as an extra argument to console.log.
  1562→      // The stdout.write wrapper handles prefixing, so console.log should receive
  1563→      // only the original arguments (no doubled prefix).
  1564→      const allArgs = logCalls.map(args => args.map(String).join(' ')).join('\n');
  1565→      expect(allArgs).toContain('My Section');
  1566→
  1567→      // Count prefix occurrences per line - should never appear doubled
  1568→      for (const call of logCalls) {
  1569→        const line = call.map(String).join(' ');
  1570→        const prefixCount = (line.match(/\[TEST\]/g) || []).length;
  1571→        expect(prefixCount, `Line has doubled prefix: ${line}`).toBeLessThanOrEqual(1);
  1572→      }
  1573→    });
  1574→
  1575→    it('does not double prefix for streaming content via stdout.write', () => {
  1576→      const renderer = createPrefixedRenderer('[TEST]');
  1577→
  1578→      // Capture process.stdout.write output - this IS used by streaming render events
  1579→      const chunks: string[] = [];
  1580→      const originalWrite = process.stdout.write;
  1581→      process.stdout.write = ((chunk: unknown) => {
  1582→        if (typeof chunk === 'string') chunks.push(chunk);
  1583→        return true;
  1584→      }) as typeof process.stdout.write;
  1585→
  1586→      // Also suppress console.log (vitest intercepts it differently)
  1587→      const logSpy = vi.spyOn(console, 'log').mockImplementation(() => {});
  1588→
  1589→      try {
  1590→        // Render a streaming agent_message event which goes through stdout.write
  1591→        renderer.render({
  1592→          timestamp: 0,
  1593→          data: {
  1594→            kind: 'agent_message',
  1595→            content: 'Hello World\n',
  1596→            isStreaming: true,
  1597→          },
  1598→        });
  1599→      } finally {
  1600→        process.stdout.write = originalWrite;
  1601→        logSpy.mockRestore();
  1602→      }
  1603→
  1604→      const output = chunks.join('');
  1605→      expect(output).toContain('Hello World');
  1606→      // Prefix should appear at most once per line
  1607→      for (const line of output.split('\n')) {
  1608→        const prefixCount = (line.match(/\[TEST\]/g) || []).length;
  1609→        expect(prefixCount, `Line has doubled prefix: ${line}`).toBeLessThanOrEqual(1);
  1610→      }
  1611→    });
  1612→
  1613→    it('creates renderer with render function', () => {
  1614→      const renderer = createPrefixedRenderer('[TEST]');
  1615→
  1616→      expect(renderer.render).toBeDefined();
  1617→      expect(typeof renderer.render).toBe('function');
  1618→    });
  1619→  });
  1620→
  1621→  // ─── Explicit Task Scope Tests ──────────────────────────────────────────────
  1622→  // AC: @cli-ralph ac-21
  1623→
  1624→  describe('--tasks flag (explicit task scope)', () => {
  1625→    let tempDir: string;
  1626→
  1627→    beforeEach(async () => {
  1628→      tempDir = await setupTempFixtures();
  1629→    });
  1630→
  1631→    afterEach(async () => {
  1632→      await cleanupTempDir(tempDir);
  1633→    });
  1634→
  1635→    // AC: @cli-ralph ac-21 - Basic explicit task scope
  1636→    it('accepts --tasks flag with task references', async () => {
  1637→      const result = runRalph('--dry-run --tasks @test-task-pending', tempDir);
  1638→
  1639→      expect(result.exitCode).toBe(0);
  1640→      expect(result.stdout).toContain('explicit-tasks: @test-task-pending');
  1641→      expect(result.stdout).toContain('Explicit Task Scope');
  1642→    });
  1643→
  1644→    // AC: @cli-ralph ac-21 - Multiple tasks
  1645→    it('accepts comma-separated task refs', async () => {
