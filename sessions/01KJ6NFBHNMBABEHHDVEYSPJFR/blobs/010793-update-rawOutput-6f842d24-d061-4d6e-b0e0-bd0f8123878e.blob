  1329→
  1330→      // Phase 2: tool_call_update with populated rawInput (the ACP 0.14+ pattern)
  1331→      const event2 = translator.translate({
  1332→        sessionUpdate: 'tool_call_update',
  1333→        toolCallId: 'toolu_phased_update',
