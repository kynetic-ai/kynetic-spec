```
     1→/**
     2→ * Session event storage.
     3→ *
     4→ * JSONL-based event storage for agent sessions with:
     5→ * - Atomic appends for crash safety (AC-3)
     6→ * - Auto-assigned timestamps and sequence numbers (AC-2)
     7→ * - Session metadata management
     8→ *
     9→ * Storage structure:
    10→ *   .kspec/sessions/{session-id}/
    11→ *     session.yaml      # Metadata
    12→ *     events.jsonl      # Append-only event log
    13→ */
    14→
    15→import * as fs from "node:fs";
    16→import * as fsPromises from "node:fs/promises";
    17→import * as path from "node:path";
    18→import * as YAML from "yaml";
    19→import {
    20→  type SessionEvent,
    21→  type SessionEventInput,
    22→  SessionEventSchema,
    23→  type SessionMetadata,
    24→  type SessionMetadataInput,
    25→  SessionMetadataSchema,
    26→  type SessionStatus,
    27→  type TaskBudget,
    28→  TaskBudgetSchema,
    29→} from "./types.js";
    30→
    31→// ─── Constants ───────────────────────────────────────────────────────────────
    32→
    33→const SESSIONS_DIR = "sessions";
    34→const METADATA_FILE = "session.yaml";
    35→const EVENTS_FILE = "events.jsonl";
    36→const BUDGET_FILE = "budget.json";
    37→
    38→// ─── Path Helpers ────────────────────────────────────────────────────────────
    39→
    40→/**
    41→ * Get the sessions directory path within a spec directory.
    42→ */
    43→export function getSessionsDir(specDir: string): string {
    44→  return path.join(specDir, SESSIONS_DIR);
    45→}
    46→
    47→/**
    48→ * Get the path to a specific session's directory.
    49→ */
    50→export function getSessionDir(specDir: string, sessionId: string): string {
    51→  return path.join(getSessionsDir(specDir), sessionId);
    52→}
    53→
    54→/**
    55→ * Get the path to a session's metadata file.
    56→ */
    57→export function getSessionMetadataPath(
    58→  specDir: string,
    59→  sessionId: string,
    60→): string {
    61→  return path.join(getSessionDir(specDir, sessionId), METADATA_FILE);
    62→}
    63→
    64→/**
    65→ * Get the path to a session's events file.
    66→ */
    67→export function getSessionEventsPath(
    68→  specDir: string,
    69→  sessionId: string,
    70→): string {
    71→  return path.join(getSessionDir(specDir, sessionId), EVENTS_FILE);
    72→}
    73→
    74→/**
    75→ * Get the path to a session's context snapshot file for a given iteration.
    76→ */
    77→export function getSessionContextPath(
    78→  specDir: string,
    79→  sessionId: string,
    80→  iteration: number,
    81→): string {
    82→  return path.join(
    83→    getSessionDir(specDir, sessionId),
    84→    `context-iter-${iteration}.json`,
    85→  );
    86→}
    87→
    88→/**
    89→ * Get the path to a session's budget file.
    90→ * AC: @session-creation-and-env-injection ac-budget-local
    91→ */
    92→export function getSessionBudgetPath(
    93→  specDir: string,
    94→  sessionId: string,
    95→): string {
    96→  return path.join(getSessionDir(specDir, sessionId), BUDGET_FILE);
    97→}
    98→
    99→// ─── Session CRUD ────────────────────────────────────────────────────────────
   100→
   101→/**
   102→ * Create a new session with metadata.
   103→ *
   104→ * AC-1: Creates .kspec/sessions/{id}/ directory with session.yaml metadata file.
   105→ * AC-5: Metadata includes task_id (optional), agent_type, status, started_at, ended_at.
   106→ *
   107→ * @param specDir - The .kspec directory path
   108→ * @param input - Session metadata input
   109→ * @returns The created session metadata
   110→ */
   111→export async function createSession(
   112→  specDir: string,
   113→  input: SessionMetadataInput,
   114→): Promise<SessionMetadata> {
   115→  const sessionDir = getSessionDir(specDir, input.id);
   116→  const metadataPath = getSessionMetadataPath(specDir, input.id);
   117→
   118→  // Create session directory
   119→  await fsPromises.mkdir(sessionDir, { recursive: true });
   120→
   121→  // Build full metadata
   122→  const metadata: SessionMetadata = {
   123→    id: input.id,
   124→    task_id: input.task_id,
   125→    agent_type: input.agent_type,
   126→    status: input.status ?? "active",
   127→    started_at: input.started_at ?? new Date().toISOString(),
   128→    ended_at: undefined,
   129→  };
   130→
   131→  // Validate and write metadata
   132→  const validated = SessionMetadataSchema.parse(metadata);
   133→  const content = YAML.stringify(validated, {
   134→    indent: 2,
   135→    lineWidth: 100,
   136→    sortMapEntries: false,
   137→  });
   138→  await fsPromises.writeFile(metadataPath, content, "utf-8");
   139→
   140→  return validated;
   141→}
   142→
   143→/**
   144→ * Read session metadata.
   145→ *
   146→ * @param specDir - The .kspec directory path
   147→ * @param sessionId - Session ID
   148→ * @returns Session metadata or null if not found
   149→ */
   150→export async function getSession(
   151→  specDir: string,
   152→  sessionId: string,
   153→): Promise<SessionMetadata | null> {
   154→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   155→
   156→  try {
   157→    const content = await fsPromises.readFile(metadataPath, "utf-8");
   158→    const raw = YAML.parse(content);
   159→    return SessionMetadataSchema.parse(raw);
   160→  } catch {
   161→    return null;
   162→  }
   163→}
   164→
   165→/**
   166→ * Update session status.
   167→ *
   168→ * AC-6: Updates metadata with status and ended_at timestamp when session ends.
   169→ *
   170→ * @param specDir - The .kspec directory path
   171→ * @param sessionId - Session ID
   172→ * @param status - New status
   173→ * @returns Updated metadata or null if session not found
   174→ */
   175→export async function updateSessionStatus(
   176→  specDir: string,
   177→  sessionId: string,
   178→  status: SessionStatus,
   179→): Promise<SessionMetadata | null> {
   180→  const metadata = await getSession(specDir, sessionId);
   181→  if (!metadata) {
   182→    return null;
   183→  }
   184→
   185→  // Update status and ended_at if transitioning away from active
   186→  const updated: SessionMetadata = {
   187→    ...metadata,
   188→    status,
   189→    ended_at:
   190→      status !== "active" ? new Date().toISOString() : metadata.ended_at,
   191→  };
   192→
   193→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   194→  const content = YAML.stringify(updated, {
   195→    indent: 2,
   196→    lineWidth: 100,
   197→    sortMapEntries: false,
   198→  });
   199→  await fsPromises.writeFile(metadataPath, content, "utf-8");
   200→
   201→  return updated;
   202→}
   203→
   204→/**
   205→ * List all sessions.
   206→ *
   207→ * @param specDir - The .kspec directory path
   208→ * @returns Array of session IDs
   209→ */
   210→export async function listSessions(specDir: string): Promise<string[]> {
   211→  const sessionsDir = getSessionsDir(specDir);
   212→
   213→  try {
   214→    const entries = await fsPromises.readdir(sessionsDir, {
   215→      withFileTypes: true,
   216→    });
   217→    return entries.filter((e) => e.isDirectory()).map((e) => e.name);
   218→  } catch {
   219→    return [];
   220→  }
   221→}
   222→
   223→/**
   224→ * Check if a session exists.
   225→ */
   226→export async function sessionExists(
   227→  specDir: string,
   228→  sessionId: string,
   229→): Promise<boolean> {
   230→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   231→  try {
   232→    await fsPromises.access(metadataPath);
   233→    return true;
   234→  } catch {
   235→    return false;
   236→  }
   237→}
   238→
   239→// ─── Event Storage ───────────────────────────────────────────────────────────
   240→
   241→/**
   242→ * Get the current event count for a session (for seq assignment).
   243→ *
   244→ * @param specDir - The .kspec directory path
   245→ * @param sessionId - Session ID
   246→ * @returns Number of events in the session
   247→ */
   248→async function getEventCount(
   249→  specDir: string,
   250→  sessionId: string,
   251→): Promise<number> {
   252→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   253→
   254→  try {
   255→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   256→    const lines = content
   257→      .trim()
   258→      .split("\n")
   259→      .filter((line) => line.length > 0);
   260→    return lines.length;
   261→  } catch {
   262→    return 0;
   263→  }
   264→}
   265→
   266→/**
   267→ * Append an event to a session's event log.
   268→ *
   269→ * AC-2: Appends JSON line to events.jsonl with auto-assigned ts and seq.
   270→ * AC-3: Uses atomic append (appendFileSync) for crash safety.
   271→ *
   272→ * Creates the session directory if it doesn't exist (lazy creation).
   273→ *
   274→ * Note: This function is not safe for concurrent access to the same session.
   275→ * The sequence number assignment has a race condition between reading the
   276→ * event count and appending the event. This is acceptable for CLI use
   277→ * (single-process, sequential event logging). If concurrent access is needed
   278→ * in the future, consider file locking or an in-memory counter per session.
   279→ *
   280→ * @param specDir - The .kspec directory path
   281→ * @param input - Event input (ts and seq are auto-assigned if not provided)
   282→ * @returns The appended event with auto-assigned fields
   283→ */
   284→export async function appendEvent(
   285→  specDir: string,
   286→  input: SessionEventInput,
   287→): Promise<SessionEvent> {
   288→  const sessionDir = getSessionDir(specDir, input.session_id);
   289→  const eventsPath = getSessionEventsPath(specDir, input.session_id);
   290→
   291→  // Ensure session directory exists (lazy creation)
   292→  await fsPromises.mkdir(sessionDir, { recursive: true });
   293→
   294→  // Get current event count for seq assignment
   295→  const seq = input.seq ?? (await getEventCount(specDir, input.session_id));
   296→
   297→  // Build full event
   298→  const event: SessionEvent = {
   299→    ts: input.ts ?? Date.now(),
   300→    seq,
   301→    type: input.type,
   302→    session_id: input.session_id,
   303→    trace_id: input.trace_id,
   304→    data: input.data,
   305→  };
   306→
   307→  // Validate event
   308→  const validated = SessionEventSchema.parse(event);
   309→
   310→  // AC: @session-events ac-3 - Use synchronous append for crash safety
   311→  // This ensures the line is fully written before returning
   312→  const line = `${JSON.stringify(validated)}\n`;
   313→  fs.appendFileSync(eventsPath, line, "utf-8");
   314→
   315→  return validated;
   316→}
   317→
   318→/**
   319→ * Read all events from a session.
   320→ *
   321→ * AC-4: Returns all events in sequence order.
   322→ *
   323→ * @param specDir - The .kspec directory path
   324→ * @param sessionId - Session ID
   325→ * @returns Array of events sorted by sequence number
   326→ */
   327→export async function readEvents(
   328→  specDir: string,
   329→  sessionId: string,
   330→): Promise<SessionEvent[]> {
   331→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   332→
   333→  try {
   334→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   335→    const lines = content
   336→      .trim()
   337→      .split("\n")
   338→      .filter((line) => line.length > 0);
   339→
   340→    const events: SessionEvent[] = [];
   341→    for (const line of lines) {
   342→      try {
   343→        const raw = JSON.parse(line);
   344→        const event = SessionEventSchema.parse(raw);
   345→        events.push(event);
   346→      } catch {
   347→        // Skip invalid lines
   348→      }
   349→    }
   350→
   351→    // AC: @session-events ac-4 - Sort by sequence number
   352→    return events.sort((a, b) => a.seq - b.seq);
   353→  } catch {
   354→    return [];
   355→  }
   356→}
   357→
   358→/**
   359→ * Deduplicate phased tool_call events.
   360→ *
   361→ * ACP SDK 0.14+ sends tool calls in two phases: first with empty rawInput,
   362→ * then with populated rawInput. This merges them by keeping only the version
   363→ * with populated rawInput per toolCallId.
   364→ */
   365→export function deduplicatePhasedToolCalls(
   366→  events: SessionEvent[],
   367→): SessionEvent[] {
   368→  // First pass: find toolCallIds that have a populated rawInput version
   369→  const populatedToolCalls = new Map<string, number>(); // toolCallId → index
   370→  for (let i = 0; i < events.length; i++) {
   371→    const event = events[i];
   372→    if (event.type !== "session.update") continue;
   373→    const data = event.data as { update?: { sessionUpdate?: string; toolCallId?: string; tool_call_id?: string; id?: string; rawInput?: Record<string, unknown> } } | null;
   374→    const update = data?.update;
   375→    if (update?.sessionUpdate !== "tool_call") continue;
   376→    const toolCallId = update.toolCallId || update.tool_call_id || update.id;
   377→    if (!toolCallId) continue;
   378→    const rawInput = update.rawInput;
   379→    const hasContent = rawInput && Object.keys(rawInput).length > 0;
   380→    if (hasContent) {
   381→      populatedToolCalls.set(toolCallId, i);
   382→    } else if (!populatedToolCalls.has(toolCallId)) {
   383→      // First (empty) version - track it in case no populated version exists
   384→      populatedToolCalls.set(toolCallId, i);
   385→    }
   386→  }
   387→
   388→  // Second pass: keep only the best version per toolCallId
   389→  return events.filter((event, i) => {
   390→    if (event.type !== "session.update") return true;
   391→    const data = event.data as { update?: { sessionUpdate?: string; toolCallId?: string; tool_call_id?: string; id?: string; rawInput?: Record<string, unknown> } } | null;
   392→    const update = data?.update;
   393→    if (update?.sessionUpdate !== "tool_call") return true;
   394→    const toolCallId = update.toolCallId || update.tool_call_id || update.id;
   395→    if (!toolCallId) return true;
   396→    // Keep this event only if it's the best version (populated or only version)
   397→    return populatedToolCalls.get(toolCallId) === i;
   398→  });
   399→}
   400→
   401→/**
   402→ * Read events within a time range.
   403→ *
   404→ * @param specDir - The .kspec directory path
   405→ * @param sessionId - Session ID
   406→ * @param since - Start timestamp (inclusive)
   407→ * @param until - End timestamp (inclusive)
   408→ * @returns Array of events within the time range
   409→ */
   410→export async function readEventsSince(
   411→  specDir: string,
   412→  sessionId: string,
   413→  since: number,
   414→  until?: number,
   415→): Promise<SessionEvent[]> {
   416→  const events = await readEvents(specDir, sessionId);
   417→  return events.filter((e) => {
   418→    if (e.ts < since) return false;
   419→    if (until !== undefined && e.ts > until) return false;
   420→    return true;
   421→  });
   422→}
   423→
   424→/**
   425→ * Get the last event in a session.
   426→ *
   427→ * @param specDir - The .kspec directory path
   428→ * @param sessionId - Session ID
   429→ * @returns The last event or null if no events
   430→ */
   431→export async function getLastEvent(
   432→  specDir: string,
   433→  sessionId: string,
   434→): Promise<SessionEvent | null> {
   435→  const events = await readEvents(specDir, sessionId);
   436→  if (events.length === 0) {
   437→    return null;
   438→  }
   439→  return events[events.length - 1];
   440→}
   441→
   442→// ─── Session Log Summaries ───────────────────────────────────────────────────
   443→
   444→/**
   445→ * Summary data for a session, used by `session log list`.
   446→ */
   447→export interface SessionLogSummary {
   448→  /** Session ID */
   449→  id: string;
   450→  /** Session status */
   451→  status: SessionStatus;
   452→  /** Agent type */
   453→  agent_type: string;
   454→  /** When session started (ISO 8601) */
   455→  started_at: string;
   456→  /** When session ended (ISO 8601), if completed */
   457→  ended_at?: string;
   458→  /** Duration in milliseconds (computed from started_at/ended_at or now) */
   459→  duration_ms: number;
   460→  /** Number of events in events.jsonl */
   461→  event_count: number;
   462→  /** Number of context-iter-*.json files (iteration count) */
   463→  iteration_count: number;
   464→  /** Number of tasks completed during the session */
   465→  tasks_completed: number;
   466→}
   467→
   468→/**
   469→ * Count lines in events.jsonl without parsing JSON.
   470→ * Much faster than readEvents() for large files.
   471→ */
   472→async function countEventLines(
   473→  specDir: string,
   474→  sessionId: string,
   475→): Promise<number> {
   476→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   477→  try {
   478→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   479→    if (!content.trim()) return 0;
   480→    return content.trim().split("\n").length;
   481→  } catch {
   482→    return 0;
   483→  }
   484→}
   485→
   486→/**
   487→ * Count context-iter-*.json files for a session (iteration count).
   488→ */
   489→async function countIterations(
   490→  specDir: string,
   491→  sessionId: string,
   492→): Promise<number> {
   493→  const sessionDir = getSessionDir(specDir, sessionId);
   494→  try {
   495→    const entries = await fsPromises.readdir(sessionDir);
   496→    return entries.filter(
   497→      (e) => e.startsWith("context-iter-") && e.endsWith(".json"),
   498→    ).length;
   499→  } catch {
   500→    return 0;
   501→  }
   502→}
   503→
   504→/**
   505→ * Count task completions by scanning events for tool calls that invoke
   506→ * `kspec task complete` or `npm run dev -- task complete`.
   507→ *
   508→ * Real sessions record task completions as session.update events with
   509→ * sessionUpdate: "tool_call" and rawInput.command containing the complete command.
   510→ * We use a fast substring check before JSON parsing for performance.
   511→ */
   512→async function countTaskCompletions(
   513→  specDir: string,
   514→  sessionId: string,
   515→): Promise<number> {
   516→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   517→  try {
   518→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   519→    if (!content.trim()) return 0;
   520→    const lines = content.trim().split("\n");
   521→    let count = 0;
   522→    for (const line of lines) {
   523→      // Quick substring pre-filter: only parse lines that might contain task complete commands
   524→      if (!line.includes("task complete")) continue;
   525→      // Must be a tool_call event (session.update with sessionUpdate: "tool_call")
   526→      if (!line.includes('"tool_call"')) continue;
   527→      try {
   528→        const event = JSON.parse(line);
   529→        const command = event?.data?.update?.rawInput?.command;
   530→        if (typeof command === "string" && /\btask complete\b/.test(command)) {
   531→          count++;
   532→        }
   533→      } catch {
   534→        // Skip unparseable lines
   535→      }
   536→    }
   537→    return count;
   538→  } catch {
   539→    return 0;
   540→  }
   541→}
   542→
   543→/**
   544→ * Get a summary of a single session for list display.
   545→ *
   546→ * Gathers metadata and computes metrics lazily (only parses what's needed).
   547→ *
   548→ * @param specDir - The .kspec directory path
   549→ * @param sessionId - Session ID
   550→ * @returns Session summary or null if session doesn't exist
   551→ */
   552→export async function getSessionLogSummary(
   553→  specDir: string,
   554→  sessionId: string,
   555→): Promise<SessionLogSummary | null> {
   556→  const metadata = await getSession(specDir, sessionId);
   557→  if (!metadata) return null;
   558→
   559→  const [eventCount, iterationCount, tasksCompleted] = await Promise.all([
   560→    countEventLines(specDir, sessionId),
   561→    countIterationsBoundaryAware(specDir, sessionId),
   562→    countTaskCompletions(specDir, sessionId),
   563→  ]);
   564→
   565→  const startMs = new Date(metadata.started_at).getTime();
   566→  const endMs = metadata.ended_at
   567→    ? new Date(metadata.ended_at).getTime()
   568→    : Date.now();
   569→  const durationMs = endMs - startMs;
   570→
   571→  return {
   572→    id: metadata.id,
   573→    status: metadata.status,
   574→    agent_type: metadata.agent_type,
   575→    started_at: metadata.started_at,
   576→    ended_at: metadata.ended_at,
   577→    duration_ms: durationMs,
   578→    event_count: eventCount,
   579→    iteration_count: iterationCount,
   580→    tasks_completed: tasksCompleted,
   581→  };
   582→}
   583→
   584→/**
   585→ * Get summaries for all sessions.
   586→ *
   587→ * @param specDir - The .kspec directory path
   588→ * @returns Array of session summaries
   589→ */
   590→export async function getAllSessionLogSummaries(
   591→  specDir: string,
   592→): Promise<SessionLogSummary[]> {
   593→  const sessionIds = await listSessions(specDir);
   594→  const summaries = await Promise.all(
   595→    sessionIds.map((id) => getSessionLogSummary(specDir, id)),
   596→  );
   597→  return summaries.filter((s): s is SessionLogSummary => s !== null);
   598→}
   599→
   600→// ─── Context Snapshots ───────────────────────────────────────────────────────
   601→
   602→/**
   603→ * Save session context snapshot for a given iteration.
   604→ *
   605→ * This creates an audit trail of what context the agent saw at each iteration,
   606→ * useful for debugging and reviewing agent behavior.
   607→ *
   608→ * @param specDir - The .kspec directory path
   609→ * @param sessionId - Session ID
   610→ * @param iteration - Iteration number
   611→ * @param context - The session context data
   612→ */
   613→export async function saveSessionContext(
   614→  specDir: string,
   615→  sessionId: string,
   616→  iteration: number,
   617→  context: unknown,
   618→): Promise<void> {
   619→  const sessionDir = getSessionDir(specDir, sessionId);
   620→  const contextPath = getSessionContextPath(specDir, sessionId, iteration);
   621→
   622→  // Ensure session directory exists
   623→  await fsPromises.mkdir(sessionDir, { recursive: true });
   624→
   625→  // Write context snapshot as pretty JSON
   626→  const content = JSON.stringify(context, null, 2);
   627→  await fsPromises.writeFile(contextPath, content, "utf-8");
   628→}
   629→
   630→/**
   631→ * Read session context snapshot for a given iteration.
   632→ *
   633→ * @param specDir - The .kspec directory path
   634→ * @param sessionId - Session ID
   635→ * @param iteration - Iteration number
   636→ * @returns The context snapshot or null if not found
   637→ */
   638→export async function readSessionContext(
   639→  specDir: string,
   640→  sessionId: string,
   641→  iteration: number,
   642→): Promise<unknown | null> {
   643→  const contextPath = getSessionContextPath(specDir, sessionId, iteration);
   644→
   645→  try {
   646→    const content = await fsPromises.readFile(contextPath, "utf-8");
   647→    return JSON.parse(content);
   648→  } catch {
   649→    return null;
   650→  }
   651→}
   652→
   653→// ─── Session ID Resolution ───────────────────────────────────────────────────
   654→
   655→/**
   656→ * Result of resolving a session ID prefix.
   657→ */
   658→export type SessionIdResolution =
   659→  | { ok: true; id: string }
   660→  | { ok: false; error: "not_found" }
   661→  | { ok: false; error: "ambiguous"; matches: string[] };
   662→
   663→/**
   664→ * Resolve a session ID or prefix to a full session ID.
   665→ *
   666→ * AC: @session-log-show ac-7, ac-8, ac-9
   667→ *
   668→ * @param specDir - The .kspec directory path
   669→ * @param idOrPrefix - Full session ID or prefix (e.g., first 8 chars)
   670→ * @returns Resolution result
   671→ */
   672→export async function resolveSessionId(
   673→  specDir: string,
   674→  idOrPrefix: string,
   675→): Promise<SessionIdResolution> {
   676→  const sessionIds = await listSessions(specDir);
   677→
   678→  // First, try exact match
   679→  if (sessionIds.includes(idOrPrefix)) {
   680→    return { ok: true, id: idOrPrefix };
   681→  }
   682→
   683→  // Try prefix match
   684→  const matches = sessionIds.filter((id) => id.startsWith(idOrPrefix));
   685→
   686→  if (matches.length === 0) {
   687→    return { ok: false, error: "not_found" };
   688→  }
   689→
   690→  if (matches.length === 1) {
   691→    return { ok: true, id: matches[0] };
   692→  }
   693→
   694→  // Ambiguous - multiple matches
   695→  return { ok: false, error: "ambiguous", matches };
   696→}
   697→
   698→// ─── Session Detail Data ─────────────────────────────────────────────────────
   699→
   700→/**
   701→ * Per-iteration summary for session log show.
   702→ */
   703→export interface IterationSummary {
   704→  /** Iteration number (1-indexed) */
   705→  iteration: number;
   706→  /** Number of events in this iteration */
   707→  event_count: number;
   708→  /** Tasks started in this iteration */
   709→  tasks_started: string[];
   710→  /** Tasks completed in this iteration */
   711→  tasks_completed: string[];
   712→}
   713→
   714→/**
   715→ * Full session detail data for session log show.
   716→ */
   717→export interface SessionLogDetail {
   718→  /** Session metadata */
   719→  id: string;
   720→  status: SessionStatus;
   721→  agent_type: string;
   722→  task_id?: string;
   723→  started_at: string;
   724→  ended_at?: string;
   725→  duration_ms: number;
   726→  /** Total event count */
   727→  event_count: number;
   728→  /** Total iteration count */
   729→  iteration_count: number;
   730→  /** Per-iteration summaries */
   731→  iterations: IterationSummary[];
   732→}
   733→
   734→/**
   735→ * Get iteration number from a context snapshot file.
   736→ */
   737→async function getIterationNumbers(
   738→  specDir: string,
   739→  sessionId: string,
   740→): Promise<number[]> {
   741→  const sessionDir = getSessionDir(specDir, sessionId);
   742→  try {
   743→    const entries = await fsPromises.readdir(sessionDir);
   744→    const iterations: number[] = [];
   745→    for (const entry of entries) {
   746→      const match = entry.match(/^context-iter-(\d+)\.json$/);
   747→      if (match) {
   748→        iterations.push(parseInt(match[1], 10));
   749→      }
   750→    }
   751→    return iterations.sort((a, b) => a - b);
   752→  } catch {
   753→    return [];
   754→  }
   755→}
   756→
   757→/**
   758→ * Extract task refs from task commands in event data.
   759→ */
   760→function extractTaskRef(command: string): string | null {
   761→  // Match patterns like: kspec task start @ref, kspec task complete @ref
   762→  const match = command.match(/@[\w-]+/);
   763→  return match ? match[0] : null;
   764→}
   765→
   766→/**
   767→ * Iteration boundary: a prompt.sent event with phase "task-work" that marks
   768→ * the start of a new iteration in a ralph session.
   769→ */
   770→interface IterationBoundary {
   771→  /** Array index in the events list */
   772→  index: number;
   773→  /** Iteration number from the event data */
   774→  iteration: number;
   775→}
   776→
   777→/**
   778→ * Find iteration boundaries from prompt.sent events with phase "task-work".
   779→ *
   780→ * Ralph emits these synchronously at the start of each iteration, so their
   781→ * array positions are reliable even when concurrent fire-and-forget events
   782→ * produce duplicate seq numbers.
   783→ *
   784→ * Returns validated, monotonically increasing boundaries.
   785→ */
   786→function findIterationBoundaries(events: SessionEvent[]): IterationBoundary[] {
   787→  const raw: IterationBoundary[] = [];
   788→
   789→  for (let i = 0; i < events.length; i++) {
   790→    const event = events[i];
   791→    if (event.type !== "prompt.sent") continue;
   792→
   793→    const data = event.data as {
   794→      phase?: string;
   795→      iteration?: number;
   796→    } | null;
   797→
   798→    if (
   799→      data?.phase !== "task-work" ||
   800→      typeof data?.iteration !== "number"
   801→    ) {
   802→      continue;
   803→    }
   804→
   805→    raw.push({ index: i, iteration: data.iteration });
   806→  }
   807→
   808→  // Validate: filter to monotonically increasing iteration numbers, deduplicate
   809→  const validated: IterationBoundary[] = [];
   810→  let lastIter = -Infinity;
   811→
   812→  for (const b of raw) {
   813→    if (b.iteration > lastIter) {
   814→      validated.push(b);
   815→      lastIter = b.iteration;
   816→    }
   817→  }
   818→
   819→  return validated;
   820→}
   821→
   822→/**
   823→ * Extract task start/complete refs from a slice of events.
   824→ */
   825→function extractTaskTransitions(events: SessionEvent[]): {
   826→  tasksStarted: string[];
   827→  tasksCompleted: string[];
   828→} {
   829→  const tasksStarted: string[] = [];
   830→  const tasksCompleted: string[] = [];
   831→
   832→  for (const event of events) {
   833→    if (event.type === "session.update") {
   834→      const data = event.data as {
   835→        update?: {
   836→          sessionUpdate?: string;
   837→          rawInput?: { command?: string };
   838→        };
   839→      } | null;
   840→      const command = data?.update?.rawInput?.command;
   841→      if (typeof command === "string") {
   842→        if (/\btask start\b/.test(command)) {
   843→          const ref = extractTaskRef(command);
   844→          if (ref) tasksStarted.push(ref);
   845→        } else if (/\btask complete\b/.test(command)) {
   846→          const ref = extractTaskRef(command);
   847→          if (ref) tasksCompleted.push(ref);
   848→        }
   849→      }
   850→    }
   851→  }
   852→
   853→  return { tasksStarted, tasksCompleted };
   854→}
   855→
   856→/**
   857→ * Legacy iteration grouping: groups events by their data.iteration field.
   858→ *
   859→ * Used as fallback for sessions that don't have prompt.sent boundary events
   860→ * with phase "task-work" (pre-boundary sessions or non-ralph sessions).
   861→ *
   862→ * AC: @session-log-show ac-2
   863→ */
   864→function legacyIterationGrouping(
   865→  events: SessionEvent[],
   866→  snapshotIterations: number[],
   867→): IterationSummary[] {
   868→  // Collect all iteration numbers from both snapshots and events
   869→  const allIterations = new Set<number>(snapshotIterations);
   870→  for (const event of events) {
   871→    const data = event.data as { iteration?: number } | null;
   872→    if (typeof data?.iteration === "number") {
   873→      allIterations.add(data.iteration);
   874→    }
   875→  }
   876→
   877→  // If no iterations found anywhere, synthesize iteration-0 only if events exist
   878→  if (allIterations.size === 0) {
   879→    if (events.length === 0) {
   880→      return [];
   881→    }
   882→    const { tasksStarted, tasksCompleted } = extractTaskTransitions(events);
   883→    return [
   884→      {
   885→        iteration: 0,
   886→        event_count: events.length,
   887→        tasks_started: tasksStarted,
   888→        tasks_completed: tasksCompleted,
   889→      },
   890→    ];
   891→  }
   892→
   893→  // Create buckets for all known iterations
   894→  const iterations = Array.from(allIterations).sort((a, b) => a - b);
   895→  const iterationMap = new Map<number, SessionEvent[]>();
   896→  for (const n of iterations) {
   897→    iterationMap.set(n, []);
   898→  }
   899→
   900→  for (const event of events) {
   901→    const data = event.data as { iteration?: number } | null;
   902→    const iter = data?.iteration;
   903→    if (typeof iter === "number" && iterationMap.has(iter)) {
   904→      iterationMap.get(iter)!.push(event);
   905→    } else {
   906→      const fallbackIter = iterationMap.has(0) ? 0 : iterations[0];
   907→      iterationMap.get(fallbackIter)!.push(event);
   908→    }
   909→  }
   910→
   911→  const summaries: IterationSummary[] = [];
   912→  for (const [iterNum, iterEvents] of iterationMap) {
   913→    const { tasksStarted, tasksCompleted } = extractTaskTransitions(iterEvents);
   914→    summaries.push({
   915→      iteration: iterNum,
   916→      event_count: iterEvents.length,
   917→      tasks_started: tasksStarted,
   918→      tasks_completed: tasksCompleted,
   919→    });
   920→  }
   921→
   922→  return summaries.sort((a, b) => a.iteration - b.iteration);
   923→}
   924→
   925→/**
   926→ * Boundary-based iteration grouping: splits events by prompt.sent boundary
   927→ * positions (array indices) instead of trusting data.iteration fields.
   928→ *
   929→ * This is resilient to producer-side bugs where concurrent fire-and-forget
   930→ * event logging captures the wrong iteration number.
   931→ *
   932→ * AC: @session-log-show ac-10
   933→ */
   934→function boundaryIterationGrouping(
   935→  events: SessionEvent[],
   936→  boundaries: IterationBoundary[],
   937→): IterationSummary[] {
   938→  const summaries: IterationSummary[] = [];
   939→
   940→  for (let b = 0; b < boundaries.length; b++) {
   941→    const startIdx = boundaries[b].index;
   942→    const endIdx = b + 1 < boundaries.length ? boundaries[b + 1].index : events.length;
   943→    const iterEvents = events.slice(startIdx, endIdx);
   944→    const { tasksStarted, tasksCompleted } = extractTaskTransitions(iterEvents);
   945→
   946→    summaries.push({
   947→      iteration: boundaries[b].iteration,
   948→      event_count: iterEvents.length,
   949→      tasks_started: tasksStarted,
   950→      tasks_completed: tasksCompleted,
   951→    });
   952→  }
   953→
   954→  // Pre-boundary events (before the first prompt.sent) merge into first iteration
   955→  if (boundaries.length > 0 && boundaries[0].index > 0) {
   956→    const preBoundaryEvents = events.slice(0, boundaries[0].index);
   957→    const { tasksStarted, tasksCompleted } = extractTaskTransitions(preBoundaryEvents);
   958→    summaries[0].event_count += preBoundaryEvents.length;
   959→    summaries[0].tasks_started = [...tasksStarted, ...summaries[0].tasks_started];
   960→    summaries[0].tasks_completed = [...tasksCompleted, ...summaries[0].tasks_completed];
   961→  }
   962→
   963→  return summaries;
   964→}
   965→
   966→/**
   967→ * Compute per-iteration summaries from events.
   968→ *
   969→ * Uses prompt.sent boundary events (phase: "task-work") when available for
   970→ * accurate index-based grouping. Falls back to legacy data.iteration grouping
   971→ * for sessions without boundaries.
   972→ *
   973→ * AC: @session-log-show ac-2, ac-10
   974→ */
   975→async function computeIterationSummaries(
   976→  specDir: string,
   977→  sessionId: string,
   978→): Promise<IterationSummary[]> {
   979→  const events = await readEvents(specDir, sessionId);
   980→  const boundaries = findIterationBoundaries(events);
   981→
   982→  if (boundaries.length > 0) {
   983→    return boundaryIterationGrouping(events, boundaries);
   984→  }
   985→
   986→  // Legacy fallback: no prompt.sent boundaries with phase "task-work"
   987→  const snapshotIterations = await getIterationNumbers(specDir, sessionId);
   988→  return legacyIterationGrouping(events, snapshotIterations);
   989→}
   990→
   991→/**
   992→ * Count iterations using boundary-aware logic, without computing full summaries.
   993→ *
   994→ * For use in getSessionLogSummary() (session log list, session log stats) to
   995→ * ensure iteration_count agrees with session log show.
   996→ *
   997→ * Falls back to counting context-iter-*.json files when no boundaries exist.
   998→ */
   999→async function countIterationsBoundaryAware(
  1000→  specDir: string,
  1001→  sessionId: string,
  1002→): Promise<number> {
  1003→  const events = await readEvents(specDir, sessionId);
  1004→  const boundaries = findIterationBoundaries(events);
  1005→
  1006→  if (boundaries.length > 0) {
  1007→    return boundaries.length;
  1008→  }
  1009→
  1010→  // Legacy fallback: count from context snapshots and event data
  1011→  const snapshotIterations = await getIterationNumbers(specDir, sessionId);
  1012→  const allIterations = new Set<number>(snapshotIterations);
  1013→  for (const event of events) {
  1014→    const data = event.data as { iteration?: number } | null;
  1015→    if (typeof data?.iteration === "number") {
  1016→      allIterations.add(data.iteration);
  1017→    }
  1018→  }
  1019→
  1020→  return allIterations.size || (events.length > 0 ? 1 : 0);
  1021→}
  1022→
  1023→/**
  1024→ * Get full session detail for session log show.
  1025→ *
  1026→ * @param specDir - The .kspec directory path
  1027→ * @param sessionId - Session ID (must be resolved first)
  1028→ * @returns Session detail or null if not found
  1029→ */
  1030→export async function getSessionLogDetail(
  1031→  specDir: string,
  1032→  sessionId: string,
  1033→): Promise<SessionLogDetail | null> {
  1034→  const metadata = await getSession(specDir, sessionId);
  1035→  if (!metadata) return null;
  1036→
  1037→  const [eventCount, iterations] = await Promise.all([
  1038→    countEventLines(specDir, sessionId),
  1039→    computeIterationSummaries(specDir, sessionId),
  1040→  ]);
  1041→
  1042→  const startMs = new Date(metadata.started_at).getTime();
  1043→  const endMs = metadata.ended_at
  1044→    ? new Date(metadata.ended_at).getTime()
  1045→    : Date.now();
  1046→  const durationMs = endMs - startMs;
  1047→
  1048→  return {
  1049→    id: metadata.id,
  1050→    status: metadata.status,
  1051→    agent_type: metadata.agent_type,
  1052→    task_id: metadata.task_id,
  1053→    started_at: metadata.started_at,
  1054→    ended_at: metadata.ended_at,
  1055→    duration_ms: durationMs,
  1056→    event_count: eventCount,
  1057→    iteration_count: iterations.length,
  1058→    iterations,
  1059→  };
  1060→}
  1061→
  1062→// ─── Session Log Stats ───────────────────────────────────────────────────────
  1063→
  1064→/**
  1065→ * Aggregate session statistics.
  1066→ *
  1067→ * AC: @session-log-stats ac-1, ac-2, ac-3
  1068→ */
  1069→export interface SessionLogStats {
  1070→  /** Total number of sessions */
  1071→  total_sessions: number;
  1072→  /** Total events across all sessions */
  1073→  total_events: number;
  1074→  /** Total iterations across all sessions */
  1075→  total_iterations: number;
  1076→  /** Total tasks completed across all sessions */
  1077→  total_tasks_completed: number;
  1078→  /** Total duration in milliseconds */
  1079→  total_duration_ms: number;
  1080→
  1081→  /** Average duration per session in milliseconds */
  1082→  avg_duration_ms: number;
  1083→  /** Average iterations per session */
  1084→  avg_iterations_per_session: number;
  1085→  /** Average tasks completed per session */
  1086→  avg_tasks_per_session: number;
  1087→
  1088→  /** Status breakdown with counts and percentages */
  1089→  status_breakdown: {
  1090→    status: SessionStatus;
  1091→    count: number;
  1092→    percentage: number;
  1093→  }[];
  1094→}
  1095→
  1096→/**
  1097→ * Tool usage statistics.
  1098→ *
  1099→ * AC: @session-log-stats ac-6
  1100→ */
  1101→export interface ToolUsageStats {
  1102→  tool_name: string;
  1103→  count: number;
  1104→  percentage: number;
  1105→}
  1106→
  1107→/**
  1108→ * Time period stats for --by-day or --by-week.
  1109→ *
  1110→ * AC: @session-log-stats ac-7
  1111→ */
  1112→export interface TimePeriodStats {
  1113→  period: string;
  1114→  sessions_count: number;
  1115→  tasks_completed: number;
  1116→  total_duration_ms: number;
  1117→}
  1118→
  1119→/**
  1120→ * Compute aggregate statistics from session summaries.
  1121→ *
  1122→ * @param summaries - Array of session log summaries
  1123→ * @returns Aggregate statistics
  1124→ */
  1125→export function computeSessionLogStats(
  1126→  summaries: SessionLogSummary[],
  1127→): SessionLogStats {
  1128→  if (summaries.length === 0) {
  1129→    return {
  1130→      total_sessions: 0,
  1131→      total_events: 0,
  1132→      total_iterations: 0,
  1133→      total_tasks_completed: 0,
  1134→      total_duration_ms: 0,
  1135→      avg_duration_ms: 0,
  1136→      avg_iterations_per_session: 0,
  1137→      avg_tasks_per_session: 0,
  1138→      status_breakdown: [],
  1139→    };
  1140→  }
  1141→
  1142→  // Compute totals
  1143→  let totalEvents = 0;
  1144→  let totalIterations = 0;
  1145→  let totalTasksCompleted = 0;
  1146→  let totalDuration = 0;
  1147→  const statusCounts: Record<SessionStatus, number> = {
  1148→    active: 0,
  1149→    completed: 0,
  1150→    abandoned: 0,
  1151→  };
  1152→
  1153→  for (const s of summaries) {
  1154→    totalEvents += s.event_count;
  1155→    totalIterations += s.iteration_count;
  1156→    totalTasksCompleted += s.tasks_completed;
  1157→    totalDuration += s.duration_ms;
  1158→    statusCounts[s.status] = (statusCounts[s.status] || 0) + 1;
  1159→  }
  1160→
  1161→  const n = summaries.length;
  1162→
  1163→  // Build status breakdown
  1164→  const statusBreakdown: { status: SessionStatus; count: number; percentage: number }[] = [];
  1165→  for (const status of ["completed", "active", "abandoned"] as SessionStatus[]) {
  1166→    const count = statusCounts[status] || 0;
  1167→    if (count > 0) {
  1168→      statusBreakdown.push({
  1169→        status,
  1170→        count,
  1171→        percentage: Math.round((count / n) * 100 * 10) / 10, // 1 decimal place
  1172→      });
  1173→    }
  1174→  }
  1175→
  1176→  return {
  1177→    total_sessions: n,
  1178→    total_events: totalEvents,
  1179→    total_iterations: totalIterations,
  1180→    total_tasks_completed: totalTasksCompleted,
  1181→    total_duration_ms: totalDuration,
  1182→    avg_duration_ms: Math.round(totalDuration / n),
  1183→    avg_iterations_per_session: Math.round((totalIterations / n) * 10) / 10,
  1184→    avg_tasks_per_session: Math.round((totalTasksCompleted / n) * 10) / 10,
  1185→    status_breakdown: statusBreakdown,
  1186→  };
  1187→}
  1188→
  1189→/**
  1190→ * Count tool calls by scanning events.jsonl for tool_call events.
  1191→ *
  1192→ * This is relatively expensive as it parses all events, so only call
  1193→ * when --tool-usage is requested.
  1194→ *
  1195→ * AC: @session-log-stats ac-6
  1196→ */
  1197→export async function computeToolUsageStats(
  1198→  specDir: string,
  1199→  sessionIds: string[],
  1200→  limit: number = 10,
  1201→): Promise<ToolUsageStats[]> {
  1202→  const toolCounts: Record<string, number> = {};
  1203→  let totalToolCalls = 0;
  1204→
  1205→  for (const sessionId of sessionIds) {
  1206→    const eventsPath = getSessionEventsPath(specDir, sessionId);
  1207→    try {
  1208→      const content = await fsPromises.readFile(eventsPath, "utf-8");
  1209→      if (!content.trim()) continue;
  1210→      const lines = content.trim().split("\n");
  1211→      // Track seen toolCallIds to deduplicate phased events
  1212→      const seenToolCallIds = new Set<string>();
  1213→      for (const line of lines) {
  1214→        // Quick pre-filter: only parse lines that might be tool_call events
  1215→        if (!line.includes('"tool_call"')) continue;
  1216→        try {
  1217→          const event = JSON.parse(line);
  1218→          if (event?.type === "session.update") {
  1219→            const update = event?.data?.update;
  1220→            if (update?.sessionUpdate === "tool_call") {
  1221→              // Deduplicate phased tool_call events by toolCallId
  1222→              const toolCallId = update?.toolCallId || update?.tool_call_id || update?.id;
  1223→              if (toolCallId && seenToolCallIds.has(toolCallId)) continue;
  1224→              if (toolCallId) seenToolCallIds.add(toolCallId);
  1225→              const toolName = update?._meta?.claudeCode?.toolName || "unknown";
  1226→              toolCounts[toolName] = (toolCounts[toolName] || 0) + 1;
  1227→              totalToolCalls++;
  1228→            }
  1229→          }
  1230→        } catch {
  1231→          // Skip unparseable lines
  1232→        }
  1233→      }
  1234→    } catch {
  1235→      // Skip sessions without events
  1236→    }
  1237→  }
  1238→
  1239→  // Sort by count descending, take top N
  1240→  const sorted = Object.entries(toolCounts)
  1241→    .map(([tool_name, count]) => ({
  1242→      tool_name,
  1243→      count,
  1244→      percentage: totalToolCalls > 0
  1245→        ? Math.round((count / totalToolCalls) * 100 * 10) / 10
  1246→        : 0,
  1247→    }))
  1248→    .sort((a, b) => b.count - a.count)
  1249→    .slice(0, limit);
  1250→
  1251→  return sorted;
  1252→}
  1253→
  1254→/**
  1255→ * Compute ISO-8601 week number and week-year in UTC.
  1256→ *
  1257→ * ISO-8601 rules:
  1258→ * - Week 1 contains the first Thursday of the year
  1259→ * - Week starts on Monday
  1260→ * - Week-year may differ from calendar year at year boundaries
  1261→ *
  1262→ * Returns [weekYear, weekNumber] tuple.
  1263→ */
  1264→function getISOWeekUTC(date: Date): [number, number] {
  1265→  // Clone and normalize to UTC midnight
  1266→  const d = new Date(Date.UTC(
  1267→    date.getUTCFullYear(),
  1268→    date.getUTCMonth(),
  1269→    date.getUTCDate()
  1270→  ));
  1271→
  1272→  // Get day of week (ISO: Monday=1, Sunday=7)
  1273→  const dayOfWeek = d.getUTCDay() || 7;
  1274→
  1275→  // Set to nearest Thursday (determines week-year)
  1276→  d.setUTCDate(d.getUTCDate() + 4 - dayOfWeek);
  1277→
  1278→  // Week-year is the year of this Thursday
  1279→  const weekYear = d.getUTCFullYear();
  1280→
  1281→  // January 4 is always in week 1 (as it's in the first week with a Thursday)
  1282→  const jan4 = new Date(Date.UTC(weekYear, 0, 4));
  1283→  const jan4DayOfWeek = jan4.getUTCDay() || 7;
  1284→
  1285→  // Start of week 1 (Monday before or on Jan 4)
  1286→  const week1Start = new Date(jan4);
  1287→  week1Start.setUTCDate(jan4.getUTCDate() - (jan4DayOfWeek - 1));
  1288→
  1289→  // Week number = weeks between week 1 start and the Thursday we found
  1290→  const weekNum = Math.floor((d.getTime() - week1Start.getTime()) / (7 * 24 * 60 * 60 * 1000)) + 1;
  1291→
  1292→  return [weekYear, weekNum];
  1293→}
  1294→
  1295→/**
  1296→ * Group sessions by time period (day or week).
  1297→ *
  1298→ * AC: @session-log-stats ac-7
  1299→ */
  1300→export function computeTimePeriodStats(
  1301→  summaries: SessionLogSummary[],
  1302→  groupBy: "day" | "week",
  1303→): TimePeriodStats[] {
  1304→  const buckets: Record<string, { sessions: number; tasks: number; duration: number }> = {};
  1305→
  1306→  for (const s of summaries) {
  1307→    const date = new Date(s.started_at);
  1308→    let period: string;
  1309→
  1310→    if (groupBy === "day") {
  1311→      period = date.toISOString().split("T")[0]; // YYYY-MM-DD in UTC
  1312→    } else {
  1313→      // Week: use ISO-8601 week format (YYYY-Www) in UTC
  1314→      const [weekYear, weekNum] = getISOWeekUTC(date);
  1315→      period = `${weekYear}-W${weekNum.toString().padStart(2, "0")}`;
  1316→    }
  1317→
  1318→    if (!buckets[period]) {
  1319→      buckets[period] = { sessions: 0, tasks: 0, duration: 0 };
  1320→    }
  1321→    buckets[period].sessions += 1;
  1322→    buckets[period].tasks += s.tasks_completed;
  1323→    buckets[period].duration += s.duration_ms;
  1324→  }
  1325→
  1326→  // Convert to array and sort by period (newest first for display)
  1327→  const result: TimePeriodStats[] = Object.entries(buckets)
  1328→    .map(([period, data]) => ({
  1329→      period,
  1330→      sessions_count: data.sessions,
  1331→      tasks_completed: data.tasks,
  1332→      total_duration_ms: data.duration,
  1333→    }))
  1334→    .sort((a, b) => b.period.localeCompare(a.period));
  1335→
  1336→  return result;
  1337→}
  1338→
  1339→// ─── Session Log Search ───────────────────────────────────────────────────────
  1340→
  1341→/**
  1342→ * A single search match result.
  1343→ *
  1344→ * AC: @session-log-search ac-4
  1345→ */
  1346→export interface SearchMatch {
  1347→  /** Session ID */
  1348→  session_id: string;
  1349→  /** Event timestamp (Unix ms) */
  1350→  timestamp: number;
  1351→  /** Event type */
  1352→  event_type: string;
  1353→  /** Matching content excerpt (limited to 200 chars) */
  1354→  content_excerpt: string;
  1355→}
  1356→
  1357→/**
  1358→ * Search results grouped by session.
  1359→ */
  1360→export interface SessionSearchResult {
  1361→  /** Session ID */
  1362→  session_id: string;
  1363→  /** Agent type for this session */
  1364→  agent_type: string;
  1365→  /** When the session started */
  1366→  started_at: string;
  1367→  /** Matches found in this session */
  1368→  matches: SearchMatch[];
  1369→}
  1370→
  1371→/**
  1372→ * Search options for filtering sessions and events.
  1373→ */
  1374→export interface SearchOptions {
  1375→  /** Only search events of this type (e.g., 'session.update', 'prompt.sent') */
  1376→  eventType?: string;
  1377→  /** Only search sessions started after this date */
  1378→  sinceDate?: Date;
  1379→  /** Only search sessions with this agent type */
  1380→  agentType?: string;
  1381→  /** Maximum total matches to return (default: 50) */
  1382→  limit?: number;
  1383→}
  1384→
  1385→/**
  1386→ * Extract a content excerpt around a match, limited to maxLength chars.
  1387→ *
  1388→ * AC: @session-log-search ac-4
  1389→ */
  1390→function extractContentExcerpt(
  1391→  data: unknown,
  1392→  pattern: string,
  1393→  maxLength: number = 200,
  1394→): string {
  1395→  // Stringify the data for searching
  1396→  const str = JSON.stringify(data);
  1397→  const lowerStr = str.toLowerCase();
  1398→  const lowerPattern = pattern.toLowerCase();
  1399→
  1400→  const matchIndex = lowerStr.indexOf(lowerPattern);
  1401→  if (matchIndex === -1) {
  1402→    // Shouldn't happen since we pre-filtered, but return start of content
  1403→    return str.length > maxLength ? str.slice(0, maxLength - 3) + "..." : str;
  1404→  }
  1405→
  1406→  // Calculate excerpt window centered on match
  1407→  const matchLen = pattern.length;
  1408→  const contextBefore = Math.floor((maxLength - matchLen) / 2);
  1409→  const start = Math.max(0, matchIndex - contextBefore);
  1410→  const end = Math.min(str.length, start + maxLength);
  1411→
  1412→  let excerpt = str.slice(start, end);
  1413→
  1414→  // Add ellipsis indicators
  1415→  if (start > 0) {
  1416→    excerpt = "..." + excerpt.slice(3);
  1417→  }
  1418→  if (end < str.length) {
  1419→    excerpt = excerpt.slice(0, -3) + "...";
  1420→  }
  1421→
  1422→  return excerpt;
  1423→}
  1424→
  1425→/**
  1426→ * Search across session events for a pattern.
  1427→ *
  1428→ * This streams through events.jsonl files, applying filters as early as possible
  1429→ * for performance. Sessions are pre-filtered by metadata (--since, --agent) before
  1430→ * scanning events to reduce I/O.
  1431→ *
  1432→ * AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7
  1433→ *
  1434→ * @param specDir - The .kspec directory path
  1435→ * @param pattern - Case-insensitive substring to search for
  1436→ * @param options - Search filtering options
  1437→ * @returns Array of search results grouped by session
  1438→ */
  1439→export async function searchSessionEvents(
  1440→  specDir: string,
  1441→  pattern: string,
  1442→  options: SearchOptions = {},
  1443→): Promise<SessionSearchResult[]> {
  1444→  // Defense-in-depth: normalize limit to a valid positive integer
  1445→  const rawLimit = options.limit ?? 50;
  1446→  const limit = Number.isNaN(rawLimit) || rawLimit <= 0 ? 50 : rawLimit;
  1447→  const lowerPattern = pattern.toLowerCase();
  1448→
  1449→  // Get all session summaries for metadata filtering
  1450→  const allSummaries = await getAllSessionLogSummaries(specDir);
  1451→
  1452→  // AC: @session-log-search ac-3 - Pre-filter by --since
  1453→  let filteredSummaries = allSummaries;
  1454→  if (options.sinceDate) {
  1455→    filteredSummaries = filteredSummaries.filter(
  1456→      (s) => new Date(s.started_at) >= options.sinceDate!,
  1457→    );
  1458→  }
  1459→
  1460→  // AC: @session-log-search ac-7 - Pre-filter by --agent
  1461→  if (options.agentType) {
  1462→    filteredSummaries = filteredSummaries.filter(
  1463→      (s) => s.agent_type === options.agentType,
  1464→    );
  1465→  }
  1466→
  1467→  const results: SessionSearchResult[] = [];
  1468→  let totalMatches = 0;
  1469→
  1470→  for (const summary of filteredSummaries) {
  1471→    if (totalMatches >= limit) break;
  1472→
  1473→    const eventsPath = getSessionEventsPath(specDir, summary.id);
  1474→    let content: string;
  1475→    try {
  1476→      content = await fsPromises.readFile(eventsPath, "utf-8");
  1477→    } catch {
  1478→      continue; // Skip sessions without events
  1479→    }
  1480→
  1481→    if (!content.trim()) continue;
  1482→
  1483→    const matches: SearchMatch[] = [];
  1484→    const lines = content.trim().split("\n");
  1485→    // Track seen tool_call IDs to skip phased duplicates
  1486→    const seenToolCallIds = new Set<string>();
  1487→
  1488→    for (const line of lines) {
  1489→      if (totalMatches >= limit) break;
  1490→
  1491→      // Quick substring pre-filter before parsing JSON
  1492→      if (!line.toLowerCase().includes(lowerPattern)) continue;
  1493→
  1494→      try {
  1495→        const event = JSON.parse(line);
  1496→
  1497→        // AC: @session-log-search ac-2 - Filter by event type
  1498→        if (options.eventType && event.type !== options.eventType) continue;
  1499→
  1500→        // Deduplicate phased tool_call events
  1501→        if (event?.type === "session.update") {
  1502→          const update = event?.data?.update;
  1503→          if (update?.sessionUpdate === "tool_call") {
  1504→            const toolCallId = update?.toolCallId || update?.tool_call_id || update?.id;
  1505→            if (toolCallId) {
  1506→              if (seenToolCallIds.has(toolCallId)) continue;
  1507→              seenToolCallIds.add(toolCallId);
  1508→            }
  1509→          }
  1510→        }
  1511→
  1512→        // Verify match in stringified data (not just line, in case pattern appears in metadata)
  1513→        const dataStr = JSON.stringify(event.data);
  1514→        if (!dataStr.toLowerCase().includes(lowerPattern)) continue;
  1515→
  1516→        // AC: @session-log-search ac-4 - Create match with excerpt
  1517→        matches.push({
  1518→          session_id: summary.id,
  1519→          timestamp: event.ts,
  1520→          event_type: event.type,
  1521→          content_excerpt: extractContentExcerpt(event.data, pattern, 200),
  1522→        });
  1523→        totalMatches++;
  1524→      } catch {
  1525→        // Skip unparseable lines
  1526→      }
  1527→    }
  1528→
  1529→    if (matches.length > 0) {
  1530→      results.push({
  1531→        session_id: summary.id,
  1532→        agent_type: summary.agent_type,
  1533→        started_at: summary.started_at,
  1534→        matches,
  1535→      });
  1536→    }
  1537→  }
  1538→
  1539→  return results;
  1540→}
  1541→
  1542→// ─── Session Creation with Budget ─────────────────────────────────────────────
  1543→
  1544→/**
  1545→ * Create a session with an optional task budget in one call.
  1546→ *
  1547→ * This is the library-level entry point for session creation. It creates
  1548→ * the session directory, writes session.yaml, and optionally writes budget.json.
  1549→ * Returns metadata without any console output.
  1550→ *
  1551→ * AC: @session-creation-and-env-injection ac-create
  1552→ * AC: @session-creation-and-env-injection ac-budget
  1553→ * AC: @session-creation-and-env-injection ac-budget-local
  1554→ * AC: @session-creation-and-env-injection ac-library
  1555→ *
  1556→ * @param specDir - The .kspec directory path
  1557→ * @param input - Session creation parameters
  1558→ * @returns Session metadata and optional budget (no console output)
  1559→ */
  1560→export async function createSessionWithBudget(
  1561→  specDir: string,
  1562→  input: {
  1563→    id: string;
  1564→    agent_type: string;
  1565→    task_id?: string;
  1566→    budget?: number;
  1567→  },
  1568→): Promise<{
  1569→  session_id: string;
  1570→  session: SessionMetadata;
  1571→  budget: TaskBudget | null;
  1572→}> {
  1573→  // Create session
  1574→  const session = await createSession(specDir, {
  1575→    id: input.id,
  1576→    agent_type: input.agent_type,
  1577→    task_id: input.task_id,
  1578→  });
  1579→
  1580→  // Optionally create budget
  1581→  let budget: TaskBudget | null = null;
  1582→  if (input.budget !== undefined && input.budget > 0) {
  1583→    budget = await createBudget(specDir, input.id, input.budget);
  1584→  }
  1585→
  1586→  return {
  1587→    session_id: input.id,
  1588→    session,
  1589→    budget,
  1590→  };
  1591→}
  1592→
  1593→// ─── Environment Injection ────────────────────────────────────────────────────
  1594→
  1595→/**
  1596→ * Result of environment injection attempt.
  1597→ */
  1598→export interface EnvInjectionResult {
  1599→  /** Whether injection was performed */
  1600→  injected: boolean;
  1601→  /** Method used for injection */
  1602→  method: "claude_env_file" | "claude_settings" | "codex_config" | "fallback";
  1603→  /** Human-readable description of what was done */
  1604→  description: string;
  1605→  /** Path to file modified (if applicable) */
  1606→  path?: string;
  1607→}
  1608→
  1609→/**
  1610→ * Inject KSPEC_SESSION_ID into Claude Code environment.
  1611→ *
  1612→ * Strategy:
  1613→ * 1. If CLAUDE_ENV_FILE is set, write to that file
  1614→ * 2. Otherwise, append to project .claude/settings.json env section
  1615→ *
  1616→ * AC: @session-creation-and-env-injection ac-inject-claude
  1617→ */
  1618→export async function injectClaudeCodeEnv(
  1619→  sessionId: string,
  1620→): Promise<EnvInjectionResult> {
  1621→  const envFile = process.env.CLAUDE_ENV_FILE;
  1622→
  1623→  if (envFile) {
  1624→    // Write to CLAUDE_ENV_FILE
  1625→    const line = `KSPEC_SESSION_ID=${sessionId}\n`;
  1626→    // Read existing content and append/replace
  1627→    let content = "";
  1628→    try {
  1629→      content = await fsPromises.readFile(envFile, "utf-8");
  1630→    } catch {
  1631→      // File doesn't exist yet, that's fine
  1632→    }
  1633→
  1634→    // Replace existing KSPEC_SESSION_ID line or append
  1635→    const lines = content.split("\n");
  1636→    const existingIdx = lines.findIndex((l) =>
  1637→      l.startsWith("KSPEC_SESSION_ID="),
  1638→    );
  1639→    if (existingIdx >= 0) {
  1640→      lines[existingIdx] = `KSPEC_SESSION_ID=${sessionId}`;
  1641→    } else {
  1642→      // Append before final empty line if present
  1643→      if (lines.length > 0 && lines[lines.length - 1] === "") {
  1644→        lines.splice(lines.length - 1, 0, `KSPEC_SESSION_ID=${sessionId}`);
  1645→      } else {
  1646→        lines.push(`KSPEC_SESSION_ID=${sessionId}`);
  1647→      }
  1648→    }
  1649→
  1650→    await fsPromises.writeFile(envFile, lines.join("\n"), "utf-8");
  1651→    return {
  1652→      injected: true,
  1653→      method: "claude_env_file",
  1654→      description: `Wrote KSPEC_SESSION_ID=${sessionId} to CLAUDE_ENV_FILE`,
  1655→      path: envFile,
  1656→    };
  1657→  }
  1658→
  1659→  // Fallback: write to project .claude/settings.json
  1660→  const settingsDir = path.join(process.cwd(), ".claude");
  1661→  const settingsPath = path.join(settingsDir, "settings.json");
  1662→
  1663→  await fsPromises.mkdir(settingsDir, { recursive: true });
  1664→
  1665→  let settings: Record<string, unknown> = {};
  1666→  try {
  1667→    const content = await fsPromises.readFile(settingsPath, "utf-8");
  1668→    settings = JSON.parse(content);
  1669→  } catch (err: unknown) {
  1670→    // Only start fresh for ENOENT; throw on parse errors to avoid overwriting
  1671→    if (err instanceof Error && "code" in err && err.code === "ENOENT") {
  1672→      // File doesn't exist, start fresh
  1673→    } else {
  1674→      throw new Error(
  1675→        `Cannot inject env: .claude/settings.json exists but is not valid JSON. ` +
  1676→        `Fix the file manually or remove it, then retry.`,
  1677→      );
  1678→    }
  1679→  }
  1680→
  1681→  // Ensure env section exists
  1682→  if (!settings.env || typeof settings.env !== "object") {
  1683→    settings.env = {};
  1684→  }
  1685→  (settings.env as Record<string, string>).KSPEC_SESSION_ID = sessionId;
  1686→
  1687→  await fsPromises.writeFile(
  1688→    settingsPath,
  1689→    JSON.stringify(settings, null, 2) + "\n",
  1690→    "utf-8",
  1691→  );
  1692→
  1693→  return {
  1694→    injected: true,
  1695→    method: "claude_settings",
  1696→    description: `Added KSPEC_SESSION_ID to .claude/settings.json env section`,
  1697→    path: settingsPath,
  1698→  };
  1699→}
  1700→
  1701→/**
  1702→ * Inject KSPEC_SESSION_ID into Codex CLI environment.
  1703→ *
  1704→ * Adds to shell_environment_policy.set in codex config.
  1705→ *
  1706→ * AC: @session-creation-and-env-injection ac-inject-codex
  1707→ */
  1708→export async function injectCodexEnv(
  1709→  sessionId: string,
  1710→): Promise<EnvInjectionResult> {
  1711→  const configDir = path.join(
  1712→    process.env.HOME || process.env.USERPROFILE || "",
  1713→    ".codex",
  1714→  );
  1715→  const configPath = path.join(configDir, "config.json");
  1716→
  1717→  await fsPromises.mkdir(configDir, { recursive: true });
  1718→
  1719→  let config: Record<string, unknown> = {};
  1720→  try {
  1721→    const content = await fsPromises.readFile(configPath, "utf-8");
  1722→    config = JSON.parse(content);
  1723→  } catch (err: unknown) {
  1724→    // Only start fresh for ENOENT; throw on parse errors to avoid overwriting
  1725→    if (err instanceof Error && "code" in err && err.code === "ENOENT") {
  1726→      // File doesn't exist, start fresh
  1727→    } else {
  1728→      throw new Error(
  1729→        `Cannot inject env: ~/.codex/config.json exists but is not valid JSON. ` +
  1730→        `Fix the file manually or remove it, then retry.`,
  1731→      );
  1732→    }
  1733→  }
  1734→
  1735→  // Ensure shell_environment_policy.set exists
  1736→  if (
  1737→    !config.shell_environment_policy ||
  1738→    typeof config.shell_environment_policy !== "object"
  1739→  ) {
  1740→    config.shell_environment_policy = {};
  1741→  }
  1742→  const policy = config.shell_environment_policy as Record<string, unknown>;
  1743→  if (!policy.set || typeof policy.set !== "object") {
  1744→    policy.set = {};
  1745→  }
  1746→  (policy.set as Record<string, string>).KSPEC_SESSION_ID = sessionId;
  1747→
  1748→  await fsPromises.writeFile(
  1749→    configPath,
  1750→    JSON.stringify(config, null, 2) + "\n",
  1751→    "utf-8",
  1752→  );
  1753→
  1754→  return {
  1755→    injected: true,
  1756→    method: "codex_config",
  1757→    description: `Added KSPEC_SESSION_ID to Codex config shell_environment_policy.set`,
  1758→    path: configPath,
  1759→  };
  1760→}
  1761→
  1762→/**
  1763→ * Get fallback injection instructions for unknown agent harnesses.
  1764→ *
  1765→ * AC: @session-creation-and-env-injection ac-inject-fallback
  1766→ */
  1767→export function getFallbackInjectionInstructions(
  1768→  sessionId: string,
  1769→): EnvInjectionResult {
  1770→  return {
  1771→    injected: false,
  1772→    method: "fallback",
  1773→    description: `export KSPEC_SESSION_ID=${sessionId}`,
  1774→  };
  1775→}
  1776→
  1777→// ─── Session Validation ───────────────────────────────────────────────────────
  1778→
  1779→/**
  1780→ * Validate that the current KSPEC_SESSION_ID points to a valid session.
  1781→ *
  1782→ * AC: @session-creation-and-env-injection ac-invalid-session
  1783→ *
  1784→ * @param specDir - The .kspec directory path
  1785→ * @param sessionId - The session ID to validate
  1786→ * @returns Validation result with error details if invalid
  1787→ */
  1788→export async function validateSessionId(
  1789→  specDir: string,
  1790→  sessionId: string,
  1791→): Promise<{
  1792→  valid: boolean;
  1793→  session?: SessionMetadata;
  1794→  error?: string;
  1795→  suggestion?: string;
  1796→}> {
  1797→  // Check if session directory exists
  1798→  const exists = await sessionExists(specDir, sessionId);
  1799→  if (!exists) {
  1800→    return {
  1801→      valid: false,
  1802→      error: `Session not found: ${sessionId}`,
  1803→      suggestion: `Unset KSPEC_SESSION_ID or create a new session with: kspec session create --agent-type <type>`,
  1804→    };
  1805→  }
  1806→
  1807→  // Try to read and validate session metadata
  1808→  const session = await getSession(specDir, sessionId);
  1809→  if (!session) {
  1810→    return {
  1811→      valid: false,
  1812→      error: `Session metadata is corrupt or unreadable: ${sessionId}`,
  1813→      suggestion: `Unset KSPEC_SESSION_ID or create a new session with: kspec session create --agent-type <type>`,
  1814→    };
  1815→  }
  1816→
  1817→  return { valid: true, session };
  1818→}
  1819→
  1820→// ─── Task Budget ──────────────────────────────────────────────────────────────
  1821→
  1822→/**
  1823→ * Atomic JSON write — write to temp file then rename in same directory.
  1824→ * Prevents corruption on crash.
  1825→ * AC: @task-budget-enforcement ac-atomic-write
  1826→ */
  1827→async function writeBudgetAtomic(
  1828→  filePath: string,
  1829→  budget: TaskBudget,
  1830→): Promise<void> {
  1831→  const dir = path.dirname(filePath);
  1832→  await fsPromises.mkdir(dir, { recursive: true });
  1833→  const tmpPath = `${filePath}.${process.pid}.tmp`;
  1834→  const content = JSON.stringify(budget, null, 2) + "\n";
  1835→  await fsPromises.writeFile(tmpPath, content, "utf-8");
  1836→  await fsPromises.rename(tmpPath, filePath);
  1837→}
  1838→
  1839→/**
  1840→ * Create a budget for a session.
  1841→ *
  1842→ * Writes budget.json to .kspec/sessions/{id}/ on the local filesystem
  1843→ * (NOT committed to shadow branch).
  1844→ *
  1845→ * AC: @session-creation-and-env-injection ac-budget
  1846→ * AC: @session-creation-and-env-injection ac-budget-local
  1847→ *
  1848→ * @param specDir - The .kspec directory path
  1849→ * @param sessionId - Session ID
  1850→ * @param maxPerCycle - Maximum tasks allowed per cycle
  1851→ * @returns The created budget
  1852→ */
  1853→export async function createBudget(
  1854→  specDir: string,
  1855→  sessionId: string,
  1856→  maxPerCycle: number,
  1857→): Promise<TaskBudget> {
  1858→  const budget: TaskBudget = {
  1859→    max_per_cycle: maxPerCycle,
  1860→    started_this_cycle: 0,
  1861→  };
  1862→  const validated = TaskBudgetSchema.parse(budget);
  1863→  const budgetPath = getSessionBudgetPath(specDir, sessionId);
  1864→  await writeBudgetAtomic(budgetPath, validated);
  1865→  return validated;
  1866→}
  1867→
  1868→/**
  1869→ * Read budget for a session.
  1870→ *
  1871→ * AC: @task-budget-enforcement ac-no-budget
  1872→ *
  1873→ * @param specDir - The .kspec directory path
  1874→ * @param sessionId - Session ID
  1875→ * @returns Budget or null if no budget configured (opt-in)
  1876→ */
  1877→export async function getBudget(
  1878→  specDir: string,
  1879→  sessionId: string,
  1880→): Promise<TaskBudget | null> {
  1881→  const budgetPath = getSessionBudgetPath(specDir, sessionId);
  1882→  let content: string;
  1883→  try {
  1884→    content = await fsPromises.readFile(budgetPath, "utf-8");
  1885→  } catch (err: unknown) {
  1886→    // File doesn't exist = no budget configured (opt-in)
  1887→    if (err instanceof Error && "code" in err && err.code === "ENOENT") {
  1888→      return null;
  1889→    }
  1890→    throw err;
  1891→  }
  1892→  // File exists — parse errors are real failures, not "no budget"
  1893→  const raw = JSON.parse(content);
  1894→  return TaskBudgetSchema.parse(raw);
  1895→}
  1896→
  1897→/**
  1898→ * Check whether the budget allows starting a new task.
  1899→ *
  1900→ * Returns an object with `allowed` boolean and context about the budget.
  1901→ * When no budget is configured, always allows (opt-in behavior).
  1902→ *
  1903→ * AC: @task-budget-enforcement ac-block-start
  1904→ * AC: @task-budget-enforcement ac-no-budget
  1905→ * AC: @task-budget-enforcement ac-no-session
  1906→ *
  1907→ * @param specDir - The .kspec directory path
  1908→ * @param sessionId - Session ID, or undefined if KSPEC_SESSION_ID not set
  1909→ * @returns Budget check result
  1910→ */
  1911→export async function checkBudget(
  1912→  specDir: string,
  1913→  sessionId: string | undefined,
  1914→): Promise<{
  1915→  allowed: boolean;
  1916→  reason?: string;
  1917→  budget?: TaskBudget;
  1918→}> {
  1919→  // AC: @task-budget-enforcement ac-no-session — no session means no check
  1920→  if (!sessionId) {
  1921→    return { allowed: true };
  1922→  }
  1923→
  1924→  const budget = await getBudget(specDir, sessionId);
  1925→
  1926→  // AC: @task-budget-enforcement ac-no-budget — no budget means no check
  1927→  if (!budget) {
  1928→    return { allowed: true };
  1929→  }
  1930→
  1931→  if (budget.started_this_cycle >= budget.max_per_cycle) {
  1932→    return {
  1933→      allowed: false,
  1934→      reason: `Task budget exhausted: ${budget.started_this_cycle}/${budget.max_per_cycle} tasks started this cycle. Wrap up current work and let the iteration end naturally without starting new tasks.`,
  1935→      budget,
  1936→    };
  1937→  }
  1938→
  1939→  return { allowed: true, budget };
  1940→}
  1941→
  1942→/**
  1943→ * Increment the budget counter after a task is successfully started.
  1944→ *
  1945→ * IMPORTANT: Callers must NOT call this for resume cases (task already
  1946→ * in_progress). The budget should only be incremented when a new task
  1947→ * transitions to in_progress, not when resuming an existing one.
  1948→ * See AC: @task-budget-enforcement ac-resume-no-increment
  1949→ *
  1950→ * AC: @task-budget-enforcement ac-increment
  1951→ * AC: @task-budget-enforcement ac-atomic-write
  1952→ *
  1953→ * @param specDir - The .kspec directory path
  1954→ * @param sessionId - Session ID
  1955→ * @returns Updated budget, or null if no budget configured
  1956→ */
  1957→export async function incrementBudget(
  1958→  specDir: string,
  1959→  sessionId: string,
  1960→): Promise<TaskBudget | null> {
  1961→  const budget = await getBudget(specDir, sessionId);
  1962→  if (!budget) {
  1963→    return null;
  1964→  }
  1965→
  1966→  const updated: TaskBudget = {
  1967→    ...budget,
  1968→    started_this_cycle: budget.started_this_cycle + 1,
  1969→  };
  1970→  const validated = TaskBudgetSchema.parse(updated);
  1971→  const budgetPath = getSessionBudgetPath(specDir, sessionId);
  1972→  await writeBudgetAtomic(budgetPath, validated);
  1973→  return validated;
  1974→}
  1975→
  1976→/**
  1977→ * Reset the budget counter to 0 for a new cycle/iteration.
  1978→ *
  1979→ * Called by ralph at iteration boundaries. Single-writer guarantee:
  1980→ * ralph only resets between iterations when the agent is not running.
  1981→ *
  1982→ * AC: @task-budget-enforcement ac-reset
  1983→ * AC: @task-budget-enforcement ac-atomic-write
  1984→ *
  1985→ * @param specDir - The .kspec directory path
  1986→ * @param sessionId - Session ID
  1987→ * @returns Updated budget, or null if no budget configured
  1988→ */
  1989→export async function resetBudget(
  1990→  specDir: string,
  1991→  sessionId: string,
  1992→): Promise<TaskBudget | null> {
  1993→  const budget = await getBudget(specDir, sessionId);
  1994→  if (!budget) {
  1995→    return null;
  1996→  }
  1997→
  1998→  const updated: TaskBudget = {
  1999→    ...budget,
  2000→    started_this_cycle: 0,
  2001→  };
  2002→  const validated = TaskBudgetSchema.parse(updated);
  2003→  const budgetPath = getSessionBudgetPath(specDir, sessionId);
  2004→  await writeBudgetAtomic(budgetPath, validated);
  2005→  return validated;
  2006→}
  2007→
```