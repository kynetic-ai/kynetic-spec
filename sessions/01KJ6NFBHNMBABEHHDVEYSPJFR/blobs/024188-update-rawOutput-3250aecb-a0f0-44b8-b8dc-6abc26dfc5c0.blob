   228→  // AC: @session-end-loop-signal ac-session-close-normal
   229→  // AC: @session-end-loop-signal ac-session-close-signal
   230→  // AC: @session-end-loop-signal ac-session-close-error
   231→  describe("session close handlers", () => {
   232→    it("should register SIGINT and SIGTERM handlers that close session", async () => {
   233→      // AC: @session-end-loop-signal ac-session-close-signal
   234→      // Static analysis to verify signal handlers close session
   235→      const ralphContent = await fs.readFile(
   236→        path.join(process.cwd(), "src/cli/commands/ralph.ts"),
   237→        "utf-8",
   238→      );
   239→
   240→      // Verify signal handlers are registered
   241→      expect(ralphContent).toContain('process.on("SIGINT"');
   242→      expect(ralphContent).toContain('process.on("SIGTERM"');
   243→
   244→      // Verify session is closed with abandoned status on signal
   245→      expect(ralphContent).toContain("closeSession");
   246→      expect(ralphContent).toContain('"abandoned"');
   247→      expect(ralphContent).toContain("Received ${signal}");
   248→
   249→      // Verify cleanup awaits before exit
   250→      expect(ralphContent).toContain("Promise.all");
   251→      expect(ralphContent).toContain(".finally(() =>");
   252→    });
   253→
   254→    it("should close session with completed status on normal exit", async () => {
   255→      // AC: @session-end-loop-signal ac-session-close-normal
   256→      const ralphContent = await fs.readFile(
   257→        path.join(process.cwd(), "src/cli/commands/ralph.ts"),
   258→        "utf-8",
   259→      );
   260→
   261→      // Verify closeSession is called at the end of the loop
   262→      expect(ralphContent).toContain("closeSession(specDir, sessionId, status, closeReason)");
   263→
   264→      // Verify close reasons are computed for various exit paths
   265→      expect(ralphContent).toContain("Completed all");
   266→      expect(ralphContent).toContain("No eligible tasks remaining");
   267→      expect(ralphContent).toContain("Agent requested end of loop");
   268→    });
   269→
   270→    it("should close session with abandoned status on max failures", async () => {
   271→      // AC: @session-end-loop-signal ac-session-close-error
   272→      const ralphContent = await fs.readFile(
   273→        path.join(process.cwd(), "src/cli/commands/ralph.ts"),
   274→        "utf-8",
   275→      );
   276→
   277→      // Verify max_failures exit sets abandoned status
   278→      expect(ralphContent).toContain("max_failures");
   279→      expect(ralphContent).toContain("Max failures reached");
   280→    });
   281→  });
   282→
   283→  // AC: @session-end-loop-signal ac-remove-markers
