   215→  // AC: @session-end-loop-signal ac-detect
   216→  describe("ac-detect: ralph detects end-loop from session state", () => {
   217→    it("should still detect end-loop command pattern", () => {
   218→      // detectEndLoopCommand is internal; verify the pattern works
   219→      const pattern = /\bkspec\s+ralph\s+end-loop\b/;
   220→      expect(pattern.test("kspec ralph end-loop")).toBe(true);
   221→      expect(pattern.test('kspec ralph end-loop --reason "done"')).toBe(true);
   222→      expect(pattern.test("kspec ralph")).toBe(false);
   223→      expect(pattern.test("kspec ralph run")).toBe(false);
   224→      expect(pattern.test("ralph end-loop")).toBe(false);
   225→    });
   226→  });
