   370→describe("Session store: requestEndLoop and isEndLoopRequested", () => {
   371→  let tempDir: string;
   372→
   373→  beforeEach(async () => {
   374→    tempDir = await setupTempFixtures();
   375→    initGitRepo(tempDir);
   376→  });
   377→
   378→  afterEach(async () => {
   379→    await cleanupTempDir(tempDir);
   380→  });
   381→
   382→  it("should write end_requested and end_reason to session", async () => {
   383→    await createTestSession(tempDir, SESSION_ID);
   384→
   385→    // Use end-loop command with session
   386→    const result = kspec(
   387→      'ralph end-loop --reason "Testing"',
   388→      tempDir,
   389→      { env: { KSPEC_SESSION_ID: SESSION_ID } },
   390→    );
   391→    expect(result.exitCode).toBe(0);
   392→
   393→    // Verify the session YAML was updated
   394→    const session = await readTestSession(tempDir, SESSION_ID);
   395→    expect(session!.end_requested).toBe(true);
   396→    expect(session!.end_reason).toBe("Testing");
   397→    // Original fields should be preserved
   398→    expect(session!.status).toBe("active");
   399→    expect(session!.agent_type).toBe("ralph");
   400→  });
   401→
   402→  it("should report end-loop not requested for fresh session", async () => {
   403→    await createTestSession(tempDir, SESSION_ID);
   404→
   405→    // Task start should succeed (no end-loop requested)
   406→    const result = kspec("task start @test-task-pending", tempDir, {
   407→      env: { KSPEC_SESSION_ID: SESSION_ID },
   408→    });
   409→    expect(result.exitCode).toBe(0);
   410→  });
   411→});
   412→
   413→describe("Session close with closeSession", () => {
   414→  let tempDir: string;
   415→
   416→  beforeEach(async () => {
   417→    tempDir = await setupTempFixtures();
   418→    initGitRepo(tempDir);
   419→  });
   420→
   421→  afterEach(async () => {
   422→    await cleanupTempDir(tempDir);
   423→  });
   424→
   425→  it("should verify closeSession function is exported and usable", async () => {
   426→    // This tests that the closeSession function works by verifying
   427→    // the session store module structure
   428→    const storeContent = await fs.readFile(
   429→      path.join(process.cwd(), "src/sessions/store.ts"),
   430→      "utf-8",
   431→    );
   432→    expect(storeContent).toContain("export async function closeSession");
   433→    expect(storeContent).toContain("close_reason");
   434→  });
   435→});
