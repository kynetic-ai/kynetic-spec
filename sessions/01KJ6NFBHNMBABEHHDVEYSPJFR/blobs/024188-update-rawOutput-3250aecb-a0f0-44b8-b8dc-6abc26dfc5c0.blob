     1→/**
     2→ * Tests for session-scoped end-loop signal.
     3→ *
     4→ * Migrated from marker file approach to session state.
     5→ * AC: @session-end-loop-signal ac-signal, ac-block-task, ac-detect, ac-session-close-normal,
     6→ *     ac-session-close-signal, ac-session-close-error, ac-remove-markers
     7→ * AC: @trait-error-guidance ac-1, ac-2, ac-5, ac-6
     8→ */
     9→import { describe, it, expect, beforeEach, afterEach } from "vitest";
    10→import * as fs from "node:fs/promises";
    11→import * as path from "node:path";
    12→import * as YAML from "yaml";
    13→import {
    14→  kspec,
    15→  kspecJson,
    16→  setupTempFixtures,
    17→  cleanupTempDir,
    18→  initGitRepo,
    19→} from "../helpers/cli";
    20→
    21→const SESSION_ID = "01KJ7CCCHNMBABEHHDVEYSPJFR";
    22→
    23→/**
    24→ * Helper to create a session.yaml file in the test fixture directory.
    25→ * Sessions live at {specDir}/sessions/{sessionId}/session.yaml
    26→ */
    27→async function createTestSession(
    28→  specDir: string,
    29→  sessionId: string,
    30→  overrides: Record<string, unknown> = {},
    31→): Promise<void> {
    32→  const sessionDir = path.join(specDir, "sessions", sessionId);
    33→  await fs.mkdir(sessionDir, { recursive: true });
    34→  const metadata = {
    35→    id: sessionId,
    36→    agent_type: "ralph",
    37→    status: "active",
    38→    started_at: new Date().toISOString(),
    39→    ...overrides,
    40→  };
    41→  await fs.writeFile(
    42→    path.join(sessionDir, "session.yaml"),
    43→    YAML.stringify(metadata, { indent: 2, lineWidth: 100, sortMapEntries: false }),
    44→  );
    45→}
    46→
    47→/**
    48→ * Helper to read session metadata.
    49→ */
    50→async function readTestSession(
    51→  specDir: string,
    52→  sessionId: string,
    53→): Promise<Record<string, unknown> | null> {
    54→  const sessionPath = path.join(
    55→    specDir,
    56→    "sessions",
    57→    sessionId,
    58→    "session.yaml",
    59→  );
    60→  try {
    61→    const content = await fs.readFile(sessionPath, "utf-8");
    62→    return YAML.parse(content);
    63→  } catch {
    64→    return null;
    65→  }
    66→}
    67→
    68→describe("Session-scoped end-loop signal", () => {
    69→  let tempDir: string;
    70→
    71→  beforeEach(async () => {
    72→    tempDir = await setupTempFixtures();
    73→    initGitRepo(tempDir);
    74→  });
    75→
    76→  afterEach(async () => {
    77→    await cleanupTempDir(tempDir);
    78→  });
    79→
    80→  // AC: @session-end-loop-signal ac-signal
    81→  describe("ac-signal: end-loop writes to session state", () => {
    82→    it("should write end_requested=true to session metadata", async () => {
    83→      await createTestSession(tempDir, SESSION_ID);
    84→
    85→      const result = kspec("ralph end-loop", tempDir, {
    86→        env: { KSPEC_SESSION_ID: SESSION_ID },
    87→      });
    88→
    89→      expect(result.exitCode).toBe(0);
    90→      expect(result.stdout).toContain("Loop end signal sent");
    91→
    92→      // Verify session state was updated
    93→      const session = await readTestSession(tempDir, SESSION_ID);
    94→      expect(session).not.toBeNull();
    95→      expect(session!.end_requested).toBe(true);
    96→    });
    97→
    98→    it("should include reason in session metadata when provided", async () => {
    99→      await createTestSession(tempDir, SESSION_ID);
   100→
   101→      // AC: @session-end-loop-signal ac-signal
   102→      const result = kspec(
   103→        'ralph end-loop --reason "No eligible tasks"',
   104→        tempDir,
   105→        { env: { KSPEC_SESSION_ID: SESSION_ID } },
   106→      );
   107→
   108→      expect(result.exitCode).toBe(0);
   109→      expect(result.stdout).toContain("Reason: No eligible tasks");
   110→
   111→      const session = await readTestSession(tempDir, SESSION_ID);
   112→      expect(session!.end_requested).toBe(true);
   113→      expect(session!.end_reason).toBe("No eligible tasks");
   114→    });
   115→
   116→    it("should fail with exit code 4 when KSPEC_SESSION_ID is not set", async () => {
   117→      // AC: @trait-error-guidance ac-1, ac-2
   118→      const result = kspec("ralph end-loop", tempDir, {
   119→        expectFail: true,
   120→        env: { KSPEC_SESSION_ID: "" },
   121→      });
   122→
   123→      expect(result.exitCode).toBe(4);
   124→      const output = result.stdout + result.stderr;
   125→      expect(output).toContain("KSPEC_SESSION_ID not set");
   126→      expect(output).toContain("kspec session create");
   127→    });
   128→
   129→    it("should fail with exit code 3 when session not found", async () => {
   130→      // AC: @trait-error-guidance ac-1, ac-2
   131→      const result = kspec("ralph end-loop", tempDir, {
   132→        expectFail: true,
   133→        env: { KSPEC_SESSION_ID: "NONEXISTENT_SESSION" },
   134→      });
   135→
   136→      expect(result.exitCode).toBe(3);
   137→      const output = result.stdout + result.stderr;
   138→      expect(output).toContain("Session not found");
   139→      expect(output).toContain("kspec session log list");
   140→    });
   141→  });
   142→
   143→  // AC: @session-end-loop-signal ac-block-task
   144→  describe("ac-block-task: task start blocked when end-loop requested", () => {
   145→    it("should block task start when end_requested is true", async () => {
   146→      await createTestSession(tempDir, SESSION_ID, {
   147→        end_requested: true,
   148→        end_reason: "Wrapping up",
   149→      });
   150→
   151→      const result = kspec("task start @test-task-pending", tempDir, {
   152→        expectFail: true,
   153→        env: { KSPEC_SESSION_ID: SESSION_ID },
   154→      });
   155→
   156→      expect(result.exitCode).toBe(4);
   157→      const output = result.stdout + result.stderr;
   158→      expect(output).toContain("loop is ending");
   159→    });
   160→
   161→    it("should include end-loop reason in error message", async () => {
   162→      await createTestSession(tempDir, SESSION_ID, {
   163→        end_requested: true,
   164→        end_reason: "No more eligible tasks",
   165→      });
   166→
   167→      const result = kspec("task start @test-task-pending", tempDir, {
   168→        expectFail: true,
   169→        env: { KSPEC_SESSION_ID: SESSION_ID },
   170→      });
   171→
   172→      const output = result.stdout + result.stderr;
   173→      expect(output).toContain("No more eligible tasks");
   174→    });
   175→
   176→    it("should include wrap-up guidance in error message", async () => {
   177→      // AC: @trait-error-guidance ac-2
   178→      await createTestSession(tempDir, SESSION_ID, {
   179→        end_requested: true,
   180→      });
   181→
   182→      const result = kspec("task start @test-task-pending", tempDir, {
   183→        expectFail: true,
   184→        env: { KSPEC_SESSION_ID: SESSION_ID },
   185→      });
   186→
   187→      const output = result.stdout + result.stderr;
   188→      expect(output).toMatch(/[Ww]rap up/);
   189→    });
   190→
   191→    it("should allow task start when no session ID is set", async () => {
   192→      // No KSPEC_SESSION_ID means no end-loop check
   193→      await createTestSession(tempDir, SESSION_ID, {
   194→        end_requested: true,
   195→      });
   196→
   197→      const result = kspec("task start @test-task-pending", tempDir, {
   198→        env: { KSPEC_SESSION_ID: "" },
   199→      });
   200→
   201→      expect(result.exitCode).toBe(0);
   202→    });
   203→
   204→    it("should allow task start when end_requested is not set", async () => {
   205→      await createTestSession(tempDir, SESSION_ID);
   206→
   207→      const result = kspec("task start @test-task-pending", tempDir, {
   208→        env: { KSPEC_SESSION_ID: SESSION_ID },
   209→      });
   210→
   211→      expect(result.exitCode).toBe(0);
   212→    });
   213→  });
