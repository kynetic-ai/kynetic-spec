   651→        title: kspec item ac
   652→        type: requirement
   653→        tags: []
   654→        description: |-
   655→          kspec item ac <subcommand>
   656→
   657→          Subcommands:
   658→          - add <ref> --given '...' --when '...' --then '...': Add acceptance criterion
   659→          - list <ref>: List acceptance criteria for an item
   660→          - set <ref> <ac-id> [options]: Update an acceptance criterion
   661→          - remove <ref> <ac-id> [--force]: Remove an acceptance criterion
   662→
   663→          Manages acceptance criteria on spec items via CLI.
   664→          Handles proper YAML escaping to prevent formatting errors.
   665→        depends_on: []
   666→        implements: []
   667→        relates_to: []
   668→        tests: []
   669→        acceptance_criteria:
   670→          - id: ac-item-ac-add
   671→            given: a spec item exists
   672→            when: kspec item ac add @ref --given "precondition" --when "action" --then "outcome" runs
   673→            then: 'AC is added with auto-generated ID; outputs "OK Added acceptance criterion: ac-N to @ref"'
   674→          - id: ac-item-ac-add-id
   675→            given: a spec item exists
   676→            when: kspec item ac add @ref --id custom-id --given "..." --when "..." --then "..." runs
   677→            then: AC is added with the specified ID
   678→          - id: ac-item-ac-add-dup
   679→            given: a spec item with AC id "ac-1" exists
   680→            when: kspec item ac add @ref --id ac-1 --given "..." --when "..." --then "..." runs
   681→            then: exits code 3; error "Acceptance criterion ac-1 already exists"
   682→          - id: ac-item-ac-add-task
   683→            given: a task exists (not a spec item)
   684→            when: kspec item ac add @task-ref --given "..." --when "..." --then "..." runs
   685→            then: exits code 3; error "Tasks don't have acceptance criteria"
   686→          - id: ac-item-ac-list
   687→            given: a spec item with acceptance criteria
   688→            when: kspec item ac list @ref runs
   689→            then: displays all AC in Given/When/Then format with IDs
   690→          - id: ac-item-ac-list-empty
   691→            given: a spec item without acceptance criteria
   692→            when: kspec item ac list @ref runs
   693→            then: displays "No acceptance criteria"
   694→          - id: ac-item-ac-set
   695→            given: a spec item with AC id "ac-1"
   696→            when: kspec item ac set @ref ac-1 --then "new outcome" runs
   697→            then: 'AC then field is updated; outputs "OK Updated acceptance criterion: ac-1 on @ref (then)"'
   698→          - id: ac-item-ac-set-notfound
   699→            given: a spec item without AC id "ac-99"
   700→            when: kspec item ac set @ref ac-99 --then "..." runs
   701→            then: exits code 3; error "Acceptance criterion ac-99 not found"
   702→          - id: ac-item-ac-remove
   703→            given: a spec item with AC id "ac-1"
   704→            when: kspec item ac remove @ref ac-1 --force runs
   705→            then: 'AC is removed; outputs "OK Removed acceptance criterion: ac-1 from @ref"'
   706→          - id: ac-item-ac-remove-confirm
   707→            given: a spec item with AC id "ac-1"
   708→            when: kspec item ac remove @ref ac-1 runs (no --force)
   709→            then: prompts for confirmation before removing
