   648→
   649→  it("should leave acceptance_criteria undefined when not provided", () => {
   650→    const item = createSpecItem({
   651→      title: "Test Feature",
   652→      type: "feature",
   653→      slugs: ["test-feature"],
   654→    });
   655→
   656→    expect(item.acceptance_criteria).toBeUndefined();
   657→  });
   658→});
