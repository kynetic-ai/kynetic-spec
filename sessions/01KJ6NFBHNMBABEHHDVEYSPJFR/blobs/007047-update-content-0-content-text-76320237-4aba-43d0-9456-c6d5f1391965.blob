   283→
   284→  // AC: @plan-import ac-35 - Parse depends_on on specs
   285→  it("should parse depends_on array on specs", () => {
   286→    const plan = `
   287→# Test Plan
   288→
   289→## Specs
   290→
   291→\`\`\`yaml
