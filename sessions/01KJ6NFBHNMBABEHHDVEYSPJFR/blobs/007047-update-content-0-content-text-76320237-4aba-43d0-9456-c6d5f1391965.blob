   634→describe("createSpecItem", () => {
   635→  it("should preserve acceptance_criteria when provided", () => {
   636→    const ac = [
   637→      { id: "ac-1", given: "precondition", when: "action", then: "result" },
   638→    ];
   639→    const item = createSpecItem({
   640→      title: "Test Feature",
   641→      type: "feature",
   642→      slugs: ["test-feature"],
   643→      acceptance_criteria: ac,
   644→    });
