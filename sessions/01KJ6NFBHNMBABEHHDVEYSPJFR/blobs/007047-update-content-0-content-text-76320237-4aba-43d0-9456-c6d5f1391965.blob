   367→
   368→describe("Topological Sort", () => {
   369→  // AC: @plan-import ac-16
   370→  it("should sort specs in topological order (parents before children)", () => {
   371→    const specs: PlanSpec[] = [
   372→      { title: "Child", slug: "child", parent: "@parent" },
   373→      { title: "Parent", slug: "parent" },
   374→      { title: "Grandchild", slug: "grandchild", parent: "@child" },
   375→    ];
   376→
   377→    const result = topologicalSort(specs);
   378→
   379→    expect(result.error).toBeNull();
   380→    expect(result.sorted).toHaveLength(3);
   381→    expect(result.sorted[0].slug).toBe("parent");
   382→    expect(result.sorted[1].slug).toBe("child");
   383→    expect(result.sorted[2].slug).toBe("grandchild");
   384→  });
   385→
   386→  // AC: @plan-import ac-18
   387→  it("should detect circular parent references", () => {
   388→    const specs: PlanSpec[] = [
   389→      { title: "Spec A", slug: "spec-a", parent: "@spec-b" },
   390→      { title: "Spec B", slug: "spec-b", parent: "@spec-a" },
   391→    ];
   392→
   393→    const result = topologicalSort(specs);
   394→
   395→    expect(result.error).not.toBeNull();
   396→    expect(result.error?.type).toBe("circular");
   397→    expect(result.error?.message).toContain("Circular parent reference");
   398→    expect(result.error?.message).toContain("@spec-a");
   399→    expect(result.error?.message).toContain("@spec-b");
   400→  });
   401→
   402→  it("should handle specs without parents", () => {
   403→    const specs: PlanSpec[] = [
   404→      { title: "Spec 1", slug: "spec-1" },
   405→      { title: "Spec 2", slug: "spec-2" },
   406→    ];
   407→
   408→    const result = topologicalSort(specs);
   409→
   410→    expect(result.error).toBeNull();
   411→    expect(result.sorted).toHaveLength(2);
   412→  });
   413→
   414→  it("should ignore external parent references", () => {
   415→    const specs: PlanSpec[] = [
   416→      { title: "Child", slug: "child", parent: "@external-parent" },
   417→      { title: "Sibling", slug: "sibling" },
   418→    ];
   419→
   420→    const result = topologicalSort(specs);
   421→
   422→    expect(result.error).toBeNull();
   423→    expect(result.sorted).toHaveLength(2);
   424→  });
   425→
   426→  it("should handle parent ref with or without @ prefix", () => {
   427→    const specs: PlanSpec[] = [
   428→      { title: "Child 1", slug: "child-1", parent: "@parent" },
   429→      { title: "Child 2", slug: "child-2", parent: "parent" },
   430→      { title: "Parent", slug: "parent" },
   431→    ];
   432→
   433→    const result = topologicalSort(specs);
   434→
   435→    expect(result.error).toBeNull();
   436→    expect(result.sorted[0].slug).toBe("parent");
   437→  });
   438→
   439→  it("should handle complex dependency graph", () => {
   440→    const specs: PlanSpec[] = [
   441→      { title: "D", slug: "d", parent: "@b" },
   442→      { title: "B", slug: "b", parent: "@a" },
   443→      { title: "A", slug: "a" },
   444→      { title: "C", slug: "c", parent: "@a" },
   445→      { title: "E", slug: "e" },
   446→    ];
   447→
   448→    const result = topologicalSort(specs);
   449→
   450→    expect(result.error).toBeNull();
   451→    expect(result.sorted).toHaveLength(5);
   452→
   453→    // A must come before B, C, D
   454→    const aIndex = result.sorted.findIndex(s => s.slug === "a");
   455→    const bIndex = result.sorted.findIndex(s => s.slug === "b");
   456→    const cIndex = result.sorted.findIndex(s => s.slug === "c");
   457→    const dIndex = result.sorted.findIndex(s => s.slug === "d");
   458→
   459→    expect(aIndex).toBeLessThan(bIndex);
   460→    expect(aIndex).toBeLessThan(cIndex);
   461→    expect(bIndex).toBeLessThan(dIndex);
   462→  });
   463→
   464→  it("should detect three-way circular dependency", () => {
   465→    const specs: PlanSpec[] = [
   466→      { title: "A", slug: "a", parent: "@b" },
   467→      { title: "B", slug: "b", parent: "@c" },
   468→      { title: "C", slug: "c", parent: "@a" },
   469→    ];
   470→
   471→    const result = topologicalSort(specs);
   472→
   473→    expect(result.error).not.toBeNull();
   474→    expect(result.error?.type).toBe("circular");
   475→    expect(result.error?.message).toContain("Circular parent reference");
   476→  });
   477→
   478→  it("should auto-generate slugs from titles when missing", () => {
   479→    const specs: PlanSpec[] = [
   480→      { title: "Child Spec", parent: "@parent-spec" },
   481→      { title: "Parent Spec" },
   482→    ];
   483→
   484→    const result = topologicalSort(specs);
   485→
   486→    expect(result.error).toBeNull();
   487→    expect(result.sorted[0].title).toBe("Parent Spec");
   488→    expect(result.sorted[1].title).toBe("Child Spec");
   489→  });
   490→});
   491→
   492→describe("Parent Reference Validation", () => {
   493→  // AC: @plan-import ac-17
   494→  it("should detect missing parent references", () => {
   495→    const specs: PlanSpec[] = [
   496→      { title: "Child", slug: "child", parent: "@nonexistent" },
   497→    ];
   498→
   499→    const existingRefs = new Set<string>();
   500→
   501→    const errors = validateParentRefs(specs, existingRefs);
   502→
   503→    expect(errors).toHaveLength(1);
   504→    expect(errors[0].type).toBe("dependency");
   505→    expect(errors[0].message).toContain("Parent @nonexistent not found");
   506→    expect(errors[0].spec).toBe(specs[0]);
   507→  });
   508→
   509→  // AC: @plan-import ac-33
   510→  it("should provide recovery hint for missing parents", () => {
   511→    const specs: PlanSpec[] = [
   512→      { title: "Child", slug: "child", parent: "@missing" },
   513→    ];
   514→
   515→    const errors = validateParentRefs(specs, new Set());
   516→
   517→    expect(errors[0].message).toContain(
   518→      "Check parent exists or define it earlier in plan",
   519→    );
   520→  });
   521→
   522→  it("should allow parent refs to specs within the plan", () => {
   523→    const specs: PlanSpec[] = [
   524→      { title: "Child", slug: "child", parent: "@parent" },
   525→      { title: "Parent", slug: "parent" },
   526→    ];
   527→
   528→    const errors = validateParentRefs(specs, new Set());
   529→
   530→    expect(errors).toHaveLength(0);
   531→  });
   532→
   533→  it("should allow parent refs to existing project specs", () => {
   534→    const specs: PlanSpec[] = [
   535→      { title: "Child", slug: "child", parent: "@existing-parent" },
   536→    ];
   537→
   538→    const existingRefs = new Set(["existing-parent"]);
   539→
   540→    const errors = validateParentRefs(specs, existingRefs);
   541→
   542→    expect(errors).toHaveLength(0);
   543→  });
   544→
   545→  it("should handle parent refs with or without @ prefix", () => {
   546→    const specs: PlanSpec[] = [
   547→      { title: "Child", slug: "child", parent: "parent" },
   548→      { title: "Parent", slug: "parent" },
   549→    ];
   550→
   551→    const errors = validateParentRefs(specs, new Set());
   552→
   553→    expect(errors).toHaveLength(0);
   554→  });
   555→
   556→  it("should validate multiple specs with mixed valid/invalid parents", () => {
   557→    const specs: PlanSpec[] = [
   558→      { title: "Valid Child", slug: "valid", parent: "@parent" },
   559→      { title: "Invalid Child", slug: "invalid", parent: "@nonexistent" },
   560→      { title: "Parent", slug: "parent" },
   561→    ];
   562→
   563→    const errors = validateParentRefs(specs, new Set());
   564→
   565→    expect(errors).toHaveLength(1);
   566→    expect(errors[0].spec?.slug).toBe("invalid");
   567→  });
   568→});
