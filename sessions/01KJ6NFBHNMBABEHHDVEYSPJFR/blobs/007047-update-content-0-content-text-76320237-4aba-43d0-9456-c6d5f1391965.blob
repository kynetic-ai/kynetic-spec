   570→describe("Plan Document Parser - missing YAML block warning", () => {
   571→  // AC: @plan-import ac-34
   572→  it("should warn when Specs section exists but has no YAML code block", () => {
   573→    const plan = `
   574→# Test Plan
   575→
   576→## Specs
   577→
   578→Here are the specs I want to create:
   579→- Feature A
   580→- Feature B
   581→
   582→## Implementation Notes
   583→
   584→Some notes here.
   585→`;
   586→
   587→    const result = parsePlanDocument(plan);
   588→
   589→    expect(result.specs).toHaveLength(0);
   590→    expect(result.errors.length).toBeGreaterThan(0);
   591→    expect(result.errors.some(e =>
   592→      e.type === "validation" && e.message.includes("no YAML code block")
   593→    )).toBe(true);
   594→  });
   595→
   596→  it("should not warn when Specs section has a YAML code block", () => {
   597→    const plan = `
   598→# Test Plan
   599→
   600→## Specs
   601→
   602→\`\`\`yaml
   603→- title: Feature A
   604→  slug: feature-a
   605→  type: feature
   606→  description: A feature
   607→\`\`\`
   608→`;
   609→
   610→    const result = parsePlanDocument(plan);
   611→
   612→    expect(result.errors.filter(e =>
   613→      e.type === "validation" && e.message.includes("no YAML code block")
   614→    )).toHaveLength(0);
   615→  });
   616→
   617→  it("should not warn when there is no Specs section at all", () => {
   618→    const plan = `
   619→# Test Plan
   620→
   621→## Implementation Notes
   622→
   623→Just some notes, no specs section.
   624→`;
   625→
   626→    const result = parsePlanDocument(plan);
   627→
   628→    expect(result.errors.filter(e =>
   629→      e.message.includes("no YAML code block")
   630→    )).toHaveLength(0);
   631→  });
   632→});
