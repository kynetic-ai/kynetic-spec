```
     1→/**
     2→ * Tests for plan document parser
     3→ *
     4→ * AC: @plan-import ac-11 - Parse ## Specs YAML blocks
     5→ * AC: @plan-import ac-12 - Support derive_from_specs flag
     6→ * AC: @plan-import ac-13 - Extract ## Implementation Notes
     7→ * AC: @plan-import ac-16 - Topological ordering
     8→ * AC: @plan-import ac-17 - Detect missing parent references
     9→ * AC: @plan-import ac-18 - Detect circular dependencies
    10→ * AC: @plan-import ac-21 - Handle YAML parse errors
    11→ * AC: @plan-import ac-22 - Validate required fields
    12→ */
    13→
    14→import { describe, expect, it } from "vitest";
    15→import {
    16→  parsePlanDocument,
    17→  topologicalSort,
    18→  validateParentRefs,
    19→  type PlanSpec,
    20→} from "../src/parser/plan-document.js";
    21→import { createSpecItem } from "../src/parser/yaml.js";
    22→
    23→describe("Plan Document Parser", () => {
    24→  // AC: @plan-import ac-11
    25→  it("should parse specs from ## Specs YAML block", () => {
    26→    const plan = `
    27→# Test Plan
    28→
    29→## Specs
    30→
    31→\`\`\`yaml
    32→- title: JSON Output Mode
    33→  slug: json-output
    34→  type: feature
    35→  description: Add JSON output support
    36→
    37→- title: CLI Traits
    38→  slug: cli-traits
    39→  type: requirement
    40→  description: Common CLI behaviors
    41→\`\`\`
    42→`;
    43→
    44→    const result = parsePlanDocument(plan);
    45→
    46→    expect(result.specs).toHaveLength(2);
    47→    expect(result.specs[0]).toMatchObject({
    48→      title: "JSON Output Mode",
    49→      slug: "json-output",
    50→      type: "feature",
    51→      description: "Add JSON output support",
    52→    });
    53→    expect(result.specs[1]).toMatchObject({
    54→      title: "CLI Traits",
    55→      slug: "cli-traits",
    56→      type: "requirement",
    57→    });
    58→    expect(result.errors).toHaveLength(0);
    59→  });
    60→
    61→  // AC: @plan-import ac-12
    62→  it("should parse derive_from_specs flag from ## Tasks section", () => {
    63→    const plan = `
    64→# Test Plan
    65→
    66→## Specs
    67→
    68→\`\`\`yaml
    69→- title: Feature A
    70→\`\`\`
    71→
    72→## Tasks
    73→
    74→derive_from_specs: true
    75→`;
    76→
    77→    const result = parsePlanDocument(plan);
    78→
    79→    expect(result.tasks.derive_from_specs).toBe(true);
    80→    expect(result.errors).toHaveLength(0);
    81→  });
    82→
    83→  // AC: @plan-import ac-13
    84→  it("should extract ## Implementation Notes section", () => {
    85→    const plan = `
    86→# Test Plan
    87→
    88→## Specs
    89→
    90→\`\`\`yaml
    91→- title: Feature A
    92→\`\`\`
    93→
    94→## Implementation Notes
    95→
    96→Use existing patterns.
    97→Add comprehensive tests.
    98→`;
    99→
   100→    const result = parsePlanDocument(plan);
   101→
   102→    expect(result.implementationNotes).toBe(
   103→      "Use existing patterns.\nAdd comprehensive tests.",
   104→    );
   105→  });
   106→
   107→  // AC: @plan-import ac-21
   108→  it("should handle malformed YAML in Specs section", () => {
   109→    const plan = `
   110→# Test Plan
   111→
   112→## Specs
   113→
   114→\`\`\`yaml
   115→- title: Feature A
   116→  invalid yaml: [unclosed
   117→\`\`\`
   118→`;
   119→
   120→    const result = parsePlanDocument(plan);
   121→
   122→    expect(result.specs).toHaveLength(0);
   123→    expect(result.errors).toHaveLength(1);
   124→    expect(result.errors[0].type).toBe("yaml");
   125→    expect(result.errors[0].message).toContain("Malformed YAML");
   126→  });
   127→
   128→  // AC: @plan-import ac-22
   129→  it("should validate required title field in specs", () => {
   130→    const plan = `
   131→# Test Plan
   132→
   133→## Specs
   134→
   135→\`\`\`yaml
   136→- slug: missing-title
   137→  type: feature
   138→
   139→- title: Valid Spec
   140→\`\`\`
   141→`;
   142→
   143→    const result = parsePlanDocument(plan);
   144→
   145→    expect(result.specs).toHaveLength(1);
   146→    expect(result.specs[0].title).toBe("Valid Spec");
   147→    expect(result.errors).toHaveLength(1);
   148→    expect(result.errors[0].type).toBe("validation");
   149→    expect(result.errors[0].message).toContain("missing required field: title");
   150→    expect(result.errors[0].specIndex).toBe(0);
   151→  });
   152→
   153→  it("should handle empty plan documents", () => {
   154→    const plan = `# Empty Plan`;
   155→
   156→    const result = parsePlanDocument(plan);
   157→
   158→    expect(result.title).toBe("Empty Plan");
   159→    expect(result.specs).toHaveLength(0);
   160→    expect(result.tasks).toEqual({});
   161→    expect(result.implementationNotes).toBeNull();
   162→    expect(result.errors).toHaveLength(0);
