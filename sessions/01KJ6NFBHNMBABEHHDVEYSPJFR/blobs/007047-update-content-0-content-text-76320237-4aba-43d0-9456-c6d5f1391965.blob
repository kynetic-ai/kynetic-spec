   164→
   165→  it("should handle plan without title", () => {
   166→    const plan = `No heading here`;
   167→
   168→    const result = parsePlanDocument(plan);
   169→
   170→    expect(result.title).toBe("Untitled Plan");
   171→  });
   172→
   173→  it("should parse additional tasks from Tasks section", () => {
   174→    const plan = `
   175→# Test Plan
   176→
   177→## Specs
   178→
   179→\`\`\`yaml
   180→- title: Feature A
   181→\`\`\`
   182→
   183→## Tasks
   184→
   185→derive_from_specs: true
   186→
   187→\`\`\`yaml
