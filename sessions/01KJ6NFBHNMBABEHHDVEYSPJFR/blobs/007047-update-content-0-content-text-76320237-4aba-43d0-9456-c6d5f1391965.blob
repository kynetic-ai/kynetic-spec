   239→      type: "feature",
   240→      parent: "@parent-spec",
   241→      description: "Full description",
   242→      acceptance_criteria: [
   243→        {
   244→          id: "ac-1",
   245→          given: "condition",
   246→          when: "action",
   247→          then: "result",
   248→        },
   249→      ],
   250→      traits: ["@json-output", "@dry-run"],
   251→      implementation_notes: "Use existing patterns for this feature.\n",
   252→    });
   253→  });
   254→
   255→  // AC: @plan-import ac-36 - Parse priority on specs
   256→  it("should parse priority field on specs", () => {
   257→    const plan = `
   258→# Test Plan
   259→
   260→## Specs
   261→
   262→\`\`\`yaml
   263→- title: High Priority Feature
   264→  slug: high-priority
   265→  priority: 1
   266→
   267→- title: Low Priority Feature
   268→  slug: low-priority
   269→  priority: 5
   270→
   271→- title: Default Priority Feature
   272→  slug: default-priority
   273→\`\`\`
   274→`;
   275→
   276→    const result = parsePlanDocument(plan);
   277→
   278→    expect(result.specs).toHaveLength(3);
   279→    expect(result.specs[0].priority).toBe(1);
   280→    expect(result.specs[1].priority).toBe(5);
