     1→/**
     2→ * Session log show tests.
     3→ *
     4→ * Tests for the `kspec session log show` command and supporting store functions.
     5→ */
     6→
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import * as fs from 'node:fs/promises';
     9→import * as os from 'node:os';
    10→import * as path from 'node:path';
    11→import * as YAML from 'yaml';
    12→import {
    13→  createSession,
    14→  appendEvent,
    15→  saveSessionContext,
    16→  resolveSessionId,
    17→  getSessionLogDetail,
    18→  type SessionLogDetail,
    19→} from '../src/sessions/store.js';
    20→import {
    21→  setupTempFixtures,
    22→  cleanupTempDir,
    23→  kspec,
    24→  kspecJson,
    25→  testUlid,
    26→} from './helpers/cli';
    27→
    28→// ─── Store Unit Tests ───────────────────────────────────────────────────────
    29→
    30→describe('resolveSessionId', () => {
    31→  let testDir: string;
    32→
    33→  beforeEach(async () => {
    34→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-show-'));
    35→  });
    36→
    37→  afterEach(async () => {
    38→    await fs.rm(testDir, { recursive: true });
    39→  });
    40→
    41→  // AC: @session-log-show ac-9
    42→  it('should return not_found for nonexistent session', async () => {
    43→    const result = await resolveSessionId(testDir, 'nonexistent');
    44→    expect(result.ok).toBe(false);
    45→    if (!result.ok) {
    46→      expect(result.error).toBe('not_found');
    47→    }
    48→  });
    49→
    50→  // AC: @session-log-show ac-7
    51→  it('should resolve exact session ID', async () => {
    52→    const sessionId = testUlid('SESS');
    53→    await createSession(testDir, { id: sessionId, agent_type: 'test-agent' });
    54→
    55→    const result = await resolveSessionId(testDir, sessionId);
    56→    expect(result.ok).toBe(true);
    57→    if (result.ok) {
    58→      expect(result.id).toBe(sessionId);
    59→    }
    60→  });
    61→
    62→  // AC: @session-log-show ac-7
    63→  it('should resolve unique prefix to full session ID', async () => {
    64→    const sessionId = testUlid('SESS');
    65→    await createSession(testDir, { id: sessionId, agent_type: 'test-agent' });
    66→
    67→    // Use first 8 chars as prefix
    68→    const prefix = sessionId.slice(0, 8);
    69→    const result = await resolveSessionId(testDir, prefix);
    70→    expect(result.ok).toBe(true);
    71→    if (result.ok) {
    72→      expect(result.id).toBe(sessionId);
    73→    }
    74→  });
    75→
    76→  // AC: @session-log-show ac-8
    77→  it('should return ambiguous error for multiple matches', async () => {
    78→    // Create two sessions with similar prefixes
    79→    const id1 = '01SESS00000000000000000001';
    80→    const id2 = '01SESS00000000000000000002';
    81→    await createSession(testDir, { id: id1, agent_type: 'test-agent' });
    82→    await createSession(testDir, { id: id2, agent_type: 'test-agent' });
    83→
    84→    const result = await resolveSessionId(testDir, '01SESS');
    85→    expect(result.ok).toBe(false);
    86→    if (!result.ok) {
    87→      expect(result.error).toBe('ambiguous');
    88→      expect(result.matches).toContain(id1);
    89→      expect(result.matches).toContain(id2);
    90→    }
    91→  });
    92→});
    93→
    94→describe('getSessionLogDetail', () => {
    95→  let testDir: string;
    96→
    97→  beforeEach(async () => {
    98→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-detail-'));
    99→  });
   100→
   101→  afterEach(async () => {
   102→    await fs.rm(testDir, { recursive: true });
   103→  });
   104→
   105→  it('should return null for nonexistent session', async () => {
   106→    const detail = await getSessionLogDetail(testDir, 'nonexistent');
   107→    expect(detail).toBeNull();
   108→  });
   109→
   110→  // AC: @session-log-show ac-1
   111→  it('should return detail with all metadata fields', async () => {
   112→    const sessionId = testUlid('SESS');
   113→    const startedAt = '2026-01-20T10:00:00.000Z';
   114→    const endedAt = '2026-01-20T11:30:00.000Z';
   115→
   116→    await createSession(testDir, {
   117→      id: sessionId,
   118→      agent_type: 'claude-agent-acp',
   119→      task_id: '@my-task',
   120→      started_at: startedAt,
   121→    });
   122→
   123→    // Simulate completion by writing metadata directly
   124→    const metaPath = path.join(testDir, 'sessions', sessionId, 'session.yaml');
   125→    await fs.writeFile(metaPath, YAML.stringify({
   126→      id: sessionId,
   127→      agent_type: 'claude-agent-acp',
   128→      task_id: '@my-task',
   129→      status: 'completed',
   130→      started_at: startedAt,
   131→      ended_at: endedAt,
   132→    }));
   133→
   134→    const detail = await getSessionLogDetail(testDir, sessionId);
   135→    expect(detail).not.toBeNull();
   136→    expect(detail!.id).toBe(sessionId);
   137→    expect(detail!.status).toBe('completed');
   138→    expect(detail!.agent_type).toBe('claude-agent-acp');
   139→    expect(detail!.task_id).toBe('@my-task');
   140→    expect(detail!.started_at).toBe(startedAt);
   141→    expect(detail!.ended_at).toBe(endedAt);
   142→    expect(detail!.duration_ms).toBe(5400000); // 1.5 hours
   143→  });
   144→
   145→  // AC: @session-log-show ac-2
   146→  it('should compute per-iteration summaries with boundaries', async () => {
   147→    const sessionId = testUlid('SESS', 1);
   148→    await createSession(testDir, {
   149→      id: sessionId,
   150→      agent_type: 'test-agent',
   151→    });
   152→
   153→    // Add context snapshots
   154→    await saveSessionContext(testDir, sessionId, 1, { iteration: 1 });
   155→    await saveSessionContext(testDir, sessionId, 2, { iteration: 2 });
   156→
   157→    // Add events with prompt.sent boundaries (phase: task-work)
   158→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   159→    const events = [
   160→      { ts: 1000, seq: 0, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 1 } },
   161→      {
   162→        ts: 2000, seq: 1, type: 'session.update', session_id: sessionId,
   163→        data: {
   164→          iteration: 1,
   165→          update: {
   166→            sessionUpdate: 'tool_call',
   167→            rawInput: { command: 'kspec task start @task-1' },
   168→          },
   169→        },
   170→      },
   171→      { ts: 3000, seq: 2, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 2 } },
   172→      {
   173→        ts: 4000, seq: 3, type: 'session.update', session_id: sessionId,
   174→        data: {
   175→          iteration: 2,
   176→          update: {
   177→            sessionUpdate: 'tool_call',
   178→            rawInput: { command: 'kspec task complete @task-1 --reason "Done"' },
   179→          },
   180→        },
   181→      },
   182→    ];
   183→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   184→
   185→    const detail = await getSessionLogDetail(testDir, sessionId);
   186→    expect(detail).not.toBeNull();
   187→    expect(detail!.iteration_count).toBe(2);
   188→    expect(detail!.iterations).toHaveLength(2);
   189→
   190→    const iter1 = detail!.iterations.find(i => i.iteration === 1);
   191→    const iter2 = detail!.iterations.find(i => i.iteration === 2);
   192→    expect(iter1).toBeDefined();
   193→    expect(iter2).toBeDefined();
   194→    expect(iter1!.tasks_started).toContain('@task-1');
   195→    expect(iter2!.tasks_completed).toContain('@task-1');
   196→  });
   197→
   198→  // AC: @session-log-show ac-10 — wrong data.iteration on streaming events, still grouped correctly
   199→  it('should group by boundary position even when data.iteration is wrong', async () => {
   200→    const sessionId = testUlid('SESS', 2);
   201→    await createSession(testDir, {
   202→      id: sessionId,
   203→      agent_type: 'test-agent',
   204→    });
   205→
   206→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   207→    const events = [
   208→      // Iteration 1 boundary
   209→      { ts: 1000, seq: 0, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 1 } },
   210→      // These events have WRONG data.iteration (race condition bug)
   211→      { ts: 2000, seq: 1, type: 'session.update', session_id: sessionId, data: { iteration: 4, update: { sessionUpdate: 'tool_call', rawInput: { command: 'ls' } } } },
   212→      { ts: 3000, seq: 2, type: 'session.update', session_id: sessionId, data: { iteration: 4, update: { sessionUpdate: 'tool_call', rawInput: { command: 'cat file' } } } },
   213→      // Iteration 2 boundary
   214→      { ts: 4000, seq: 3, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 2 } },
   215→      // More events with wrong iteration
   216→      { ts: 5000, seq: 4, type: 'session.update', session_id: sessionId, data: { iteration: 4, update: { sessionUpdate: 'tool_call', rawInput: { command: 'echo hi' } } } },
   217→    ];
   218→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   219→
   220→    const detail = await getSessionLogDetail(testDir, sessionId);
   221→    expect(detail).not.toBeNull();
   222→    expect(detail!.iterations).toHaveLength(2);
   223→
   224→    // Boundary-based: iter 1 gets events at indices 0,1,2 (3 events)
   225→    // iter 2 gets events at indices 3,4 (2 events)
   226→    const iter1 = detail!.iterations.find(i => i.iteration === 1);
   227→    const iter2 = detail!.iterations.find(i => i.iteration === 2);
   228→    expect(iter1!.event_count).toBe(3);
   229→    expect(iter2!.event_count).toBe(2);
   230→  });
   231→
   232→  // AC: @session-log-show ac-10 — legacy fallback when no prompt.sent boundaries exist
   233→  it('should fall back to legacy data.iteration grouping without boundaries', async () => {
   234→    const sessionId = testUlid('SESS', 3);
   235→    await createSession(testDir, {
   236→      id: sessionId,
   237→      agent_type: 'test-agent',
   238→    });
   239→
   240→    await saveSessionContext(testDir, sessionId, 1, { iteration: 1 });
   241→
   242→    // Events with data.iteration but NO prompt.sent with phase: task-work
   243→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   244→    const events = [
   245→      { ts: 1000, seq: 0, type: 'session.start', session_id: sessionId, data: { iteration: 1 } },
   246→      { ts: 2000, seq: 1, type: 'session.update', session_id: sessionId, data: { iteration: 1, update: { sessionUpdate: 'tool_call', rawInput: { command: 'ls' } } } },
   247→      { ts: 3000, seq: 2, type: 'prompt.sent', session_id: sessionId, data: { iteration: 2 } }, // No phase field
   248→      { ts: 4000, seq: 3, type: 'session.update', session_id: sessionId, data: { iteration: 2, update: { sessionUpdate: 'tool_call', rawInput: { command: 'cat' } } } },
   249→    ];
   250→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   251→
   252→    const detail = await getSessionLogDetail(testDir, sessionId);
   253→    expect(detail).not.toBeNull();
   254→    expect(detail!.iterations).toHaveLength(2);
   255→
   256→    const iter1 = detail!.iterations.find(i => i.iteration === 1);
   257→    const iter2 = detail!.iterations.find(i => i.iteration === 2);
   258→    expect(iter1!.event_count).toBe(2);
   259→    expect(iter2!.event_count).toBe(2);
   260→  });
   261→
   262→  // AC: @session-log-show ac-10 — pre-boundary events merge into first iteration
   263→  it('should merge pre-boundary events into first iteration', async () => {
   264→    const sessionId = testUlid('SESS', 4);
   265→    await createSession(testDir, {
   266→      id: sessionId,
   267→      agent_type: 'test-agent',
   268→    });
   269→
   270→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   271→    const events = [
   272→      // Pre-boundary events (session.start before any prompt.sent)
   273→      { ts: 1000, seq: 0, type: 'session.start', session_id: sessionId, data: null },
   274→      { ts: 1500, seq: 1, type: 'session.update', session_id: sessionId, data: { update: { sessionUpdate: 'tool_call', rawInput: { command: 'kspec task start @task-1' } } } },
   275→      // First boundary
   276→      { ts: 2000, seq: 2, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 1 } },
   277→      { ts: 3000, seq: 3, type: 'session.update', session_id: sessionId, data: { iteration: 1, update: { sessionUpdate: 'tool_call', rawInput: { command: 'ls' } } } },
   278→    ];
   279→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   280→
   281→    const detail = await getSessionLogDetail(testDir, sessionId);
   282→    expect(detail).not.toBeNull();
   283→    expect(detail!.iterations).toHaveLength(1);
   284→    // All 4 events in iteration 1 (2 pre-boundary + 2 from boundary range)
   285→    expect(detail!.iterations[0].event_count).toBe(4);
   286→    // Pre-boundary task start should be captured
   287→    expect(detail!.iterations[0].tasks_started).toContain('@task-1');
   288→  });
   289→
   290→  // AC: @session-log-show ac-10 — single iteration captures all events
   291→  it('should handle single iteration with one boundary', async () => {
   292→    const sessionId = testUlid('SESS', 5);
   293→    await createSession(testDir, {
   294→      id: sessionId,
   295→      agent_type: 'test-agent',
   296→    });
   297→
   298→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   299→    const events = [
   300→      { ts: 1000, seq: 0, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 1 } },
   301→      { ts: 2000, seq: 1, type: 'session.update', session_id: sessionId, data: { iteration: 1, update: { sessionUpdate: 'tool_call', rawInput: { command: 'ls' } } } },
   302→      { ts: 3000, seq: 2, type: 'session.end', session_id: sessionId, data: { reason: 'completed' } },
   303→    ];
   304→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   305→
   306→    const detail = await getSessionLogDetail(testDir, sessionId);
   307→    expect(detail).not.toBeNull();
   308→    expect(detail!.iterations).toHaveLength(1);
   309→    expect(detail!.iterations[0].event_count).toBe(3);
   310→    expect(detail!.iteration_count).toBe(1);
   311→  });
   312→
   313→  // AC: @session-log-show ac-10 — mixed phase prompt.sent (only task-work used as boundaries)
   314→  it('should only use task-work phase prompt.sent as boundaries', async () => {
   315→    const sessionId = testUlid('SESS', 6);
   316→    await createSession(testDir, {
   317→      id: sessionId,
   318→      agent_type: 'test-agent',
   319→    });
   320→
   321→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   322→    const events = [
   323→      { ts: 1000, seq: 0, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 1 } },
   324→      { ts: 2000, seq: 1, type: 'session.update', session_id: sessionId, data: { iteration: 1 } },
   325→      // Reflect prompt.sent — NOT a boundary
   326→      { ts: 3000, seq: 2, type: 'prompt.sent', session_id: sessionId, data: { phase: 'reflect', iteration: 1 } },
   327→      { ts: 4000, seq: 3, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 2 } },
   328→      { ts: 5000, seq: 4, type: 'session.update', session_id: sessionId, data: { iteration: 2 } },
   329→    ];
   330→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   331→
   332→    const detail = await getSessionLogDetail(testDir, sessionId);
   333→    expect(detail).not.toBeNull();
   334→    // Only 2 iterations (task-work boundaries), not 3
   335→    expect(detail!.iterations).toHaveLength(2);
   336→
   337→    const iter1 = detail!.iterations.find(i => i.iteration === 1);
   338→    const iter2 = detail!.iterations.find(i => i.iteration === 2);
   339→    // Iter 1: events at indices 0,1,2 (prompt.sent task-work, update, reflect)
   340→    expect(iter1!.event_count).toBe(3);
   341→    // Iter 2: events at indices 3,4
   342→    expect(iter2!.event_count).toBe(2);
   343→  });
   344→
   345→  // AC: @session-log-show ac-10 — malformed boundaries gracefully fall back
   346→  it('should fall back to legacy when prompt.sent has missing phase/iteration', async () => {
   347→    const sessionId = testUlid('SESS', 7);
   348→    await createSession(testDir, {
   349→      id: sessionId,
   350→      agent_type: 'test-agent',
   351→    });
   352→
   353→    await saveSessionContext(testDir, sessionId, 1, { iteration: 1 });
   354→
   355→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   356→    const events = [
   357→      // prompt.sent without phase field — not a valid boundary
   358→      { ts: 1000, seq: 0, type: 'prompt.sent', session_id: sessionId, data: { iteration: 1 } },
   359→      { ts: 2000, seq: 1, type: 'session.update', session_id: sessionId, data: { iteration: 1, update: { sessionUpdate: 'tool_call', rawInput: { command: 'ls' } } } },
   360→      // prompt.sent with phase but missing iteration — not a valid boundary
   361→      { ts: 3000, seq: 2, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work' } },
   362→    ];
   363→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   364→
   365→    const detail = await getSessionLogDetail(testDir, sessionId);
   366→    expect(detail).not.toBeNull();
   367→    // Falls back to legacy: iteration 1 from data.iteration
   368→    expect(detail!.iterations.length).toBeGreaterThan(0);
   369→    expect(detail!.iterations[0].iteration).toBe(1);
   370→  });
   371→
   372→  // AC: @session-log-show ac-10 — duplicate seq values don't affect boundary math
   373→  it('should handle duplicate seq values with correct boundary grouping', async () => {
   374→    const sessionId = testUlid('SESS', 8);
   375→    await createSession(testDir, {
   376→      id: sessionId,
   377→      agent_type: 'test-agent',
   378→    });
   379→
   380→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   381→    // Simulate concurrent appends producing duplicate seq numbers
   382→    const events = [
   383→      { ts: 1000, seq: 0, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 1 } },
   384→      { ts: 2000, seq: 1, type: 'session.update', session_id: sessionId, data: { iteration: 1 } },
   385→      { ts: 2001, seq: 1, type: 'session.update', session_id: sessionId, data: { iteration: 1 } }, // Duplicate seq!
   386→      { ts: 3000, seq: 2, type: 'prompt.sent', session_id: sessionId, data: { phase: 'task-work', iteration: 2 } },
   387→      { ts: 4000, seq: 3, type: 'session.update', session_id: sessionId, data: { iteration: 2 } },
   388→    ];
   389→    await fs.writeFile(eventsPath, events.map(e => JSON.stringify(e)).join('\n') + '\n');
   390→
   391→    const detail = await getSessionLogDetail(testDir, sessionId);
   392→    expect(detail).not.toBeNull();
   393→    expect(detail!.iterations).toHaveLength(2);
   394→    // readEvents sorts by seq, so duplicate seq events are adjacent.
   395→    // Boundary at index of first prompt.sent, second boundary at index of second prompt.sent.
   396→    // The exact counts depend on sort stability, but total should be 5
   397→    const totalEvents = detail!.iterations.reduce((sum, i) => sum + i.event_count, 0);
   398→    expect(totalEvents).toBe(5);
   399→  });
   400→});
   401→
   402→// ─── CLI Integration Tests ──────────────────────────────────────────────────
   403→
   404→describe('kspec session log show (CLI)', () => {
   405→  let tempDir: string;
   406→  const sessionId1 = testUlid('SESS', 1);
   407→  const sessionId2 = testUlid('SESS', 2);
   408→
   409→  beforeEach(async () => {
   410→    tempDir = await setupTempFixtures();
   411→
   412→    // In traditional mode (no shadow branch), specDir = tempDir
   413→    const sessionsDir = path.join(tempDir, 'sessions');
   414→    await fs.mkdir(sessionsDir, { recursive: true });
   415→
   416→    // Session 1: completed with events and context
   417→    const s1Dir = path.join(sessionsDir, sessionId1);
   418→    await fs.mkdir(s1Dir);
   419→    await fs.writeFile(path.join(s1Dir, 'session.yaml'), YAML.stringify({
   420→      id: sessionId1,
   421→      agent_type: 'claude-agent-acp',
   422→      task_id: '@my-task',
   423→      status: 'completed',
   424→      started_at: '2026-01-15T10:00:00.000Z',
   425→      ended_at: '2026-01-15T11:30:00.000Z',
   426→    }));
   427→    await fs.writeFile(path.join(s1Dir, 'events.jsonl'), [
   428→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: sessionId1, data: { iteration: 1 } }),
   429→      JSON.stringify({
   430→        ts: 2000, seq: 1, type: 'session.update', session_id: sessionId1,
   431→        data: {
   432→          iteration: 1,
   433→          update: {
   434→            _meta: { claudeCode: { toolName: 'Bash' } },
   435→            sessionUpdate: 'tool_call',
   436→            rawInput: { command: 'kspec task start @my-task' },
   437→          },
   438→        },
   439→      }),
   440→      JSON.stringify({ ts: 3000, seq: 2, type: 'prompt.sent', session_id: sessionId1, data: { phase: 'task-work', iteration: 1, prompt: 'Continue the task' } }),
   441→      JSON.stringify({ ts: 4000, seq: 3, type: 'tool.call', session_id: sessionId1, data: { iteration: 1, tool: 'Read' } }),
   442→      JSON.stringify({ ts: 5000, seq: 4, type: 'session.end', session_id: sessionId1, data: { reason: 'completed' } }),
   443→    ].join('\n') + '\n');
   444→    await fs.writeFile(path.join(s1Dir, 'context-iter-1.json'), JSON.stringify({ focus: 'test focus', ready_tasks: [] }));
   445→
   446→    // Session 2: active, different prefix
   447→    const s2Dir = path.join(sessionsDir, sessionId2);
   448→    await fs.mkdir(s2Dir);
   449→    await fs.writeFile(path.join(s2Dir, 'session.yaml'), YAML.stringify({
   450→      id: sessionId2,
   451→      agent_type: 'custom-agent',
   452→      status: 'active',
   453→      started_at: '2026-02-05T08:00:00.000Z',
   454→    }));
   455→    await fs.writeFile(path.join(s2Dir, 'events.jsonl'), [
   456→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: sessionId2, data: null }),
   457→    ].join('\n') + '\n');
   458→  });
