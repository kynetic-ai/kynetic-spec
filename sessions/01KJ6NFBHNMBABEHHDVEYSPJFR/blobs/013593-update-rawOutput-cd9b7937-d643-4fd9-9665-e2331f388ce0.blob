   599→  // AC: @session-log-show ac-8
   600→  it('should error on ambiguous prefix with guidance', async () => {
   601→    // Create two more sessions with same prefix
   602→    const ambig1 = '01AMBG00000000000000000001';
   603→    const ambig2 = '01AMBG00000000000000000002';
   604→    const sessionsDir = path.join(tempDir, 'sessions');
   605→
   606→    const a1Dir = path.join(sessionsDir, ambig1);
   607→    await fs.mkdir(a1Dir);
   608→    await fs.writeFile(path.join(a1Dir, 'session.yaml'), YAML.stringify({
   609→      id: ambig1,
   610→      agent_type: 'test-agent',
   611→      status: 'active',
   612→      started_at: '2026-01-01T00:00:00.000Z',
   613→    }));
   614→
   615→    const a2Dir = path.join(sessionsDir, ambig2);
   616→    await fs.mkdir(a2Dir);
   617→    await fs.writeFile(path.join(a2Dir, 'session.yaml'), YAML.stringify({
   618→      id: ambig2,
   619→      agent_type: 'test-agent',
   620→      status: 'active',
   621→      started_at: '2026-01-01T00:00:00.000Z',
   622→    }));
   623→
   624→    const result = kspec('session log show 01AMBG', tempDir, { expectFail: true });
   625→    expect(result.exitCode).not.toBe(0);
   626→    expect(result.stderr).toContain('Ambiguous');
   627→    expect(result.stderr).toContain(ambig1);
   628→    expect(result.stderr).toContain(ambig2);
   629→    expect(result.stderr).toContain('more specific');
   630→  });
