     1→/**
     2→ * Session task budget tests.
     3→ *
     4→ * Tests for budget schema validation and CRUD operations
     5→ * (create, read, check, increment, reset).
     6→ *
     7→ * Task: @extend-session-schema-with-task-budget
     8→ * Spec: @session-creation-and-env-injection
     9→ * Spec: @task-budget-enforcement
    10→ */
    11→
    12→import { describe, it, expect, beforeEach, afterEach } from "vitest";
    13→import * as fs from "node:fs/promises";
    14→import * as path from "node:path";
    15→import * as os from "node:os";
    16→import { TaskBudgetSchema } from "../src/sessions/types.js";
    17→import {
    18→  createBudget,
    19→  getBudget,
    20→  checkBudget,
    21→  incrementBudget,
    22→  resetBudget,
    23→  getSessionBudgetPath,
    24→  createSession,
    25→} from "../src/sessions/store.js";
    26→import type { SessionMetadataInput } from "../src/sessions/types.js";
    27→
    28→// ─── Schema Tests ────────────────────────────────────────────────────────────
    29→
    30→describe("TaskBudgetSchema", () => {
    31→  // AC: @session-creation-and-env-injection ac-budget
    32→  it("should accept valid budget with positive max and zero started", () => {
    33→    const result = TaskBudgetSchema.safeParse({
    34→      max_per_cycle: 3,
    35→      started_this_cycle: 0,
    36→    });
    37→    expect(result.success).toBe(true);
    38→    if (result.success) {
    39→      expect(result.data.max_per_cycle).toBe(3);
    40→      expect(result.data.started_this_cycle).toBe(0);
    41→    }
    42→  });
    43→
    44→  it("should accept budget with started equal to max", () => {
    45→    const result = TaskBudgetSchema.safeParse({
    46→      max_per_cycle: 2,
    47→      started_this_cycle: 2,
    48→    });
    49→    expect(result.success).toBe(true);
    50→  });
    51→
    52→  it("should accept budget with started exceeding max (counter, not constraint)", () => {
    53→    const result = TaskBudgetSchema.safeParse({
    54→      max_per_cycle: 1,
    55→      started_this_cycle: 5,
    56→    });
    57→    expect(result.success).toBe(true);
    58→  });
    59→
    60→  it("should reject zero max_per_cycle", () => {
    61→    const result = TaskBudgetSchema.safeParse({
    62→      max_per_cycle: 0,
    63→      started_this_cycle: 0,
    64→    });
    65→    expect(result.success).toBe(false);
    66→  });
    67→
    68→  it("should reject negative max_per_cycle", () => {
    69→    const result = TaskBudgetSchema.safeParse({
    70→      max_per_cycle: -1,
    71→      started_this_cycle: 0,
    72→    });
    73→    expect(result.success).toBe(false);
    74→  });
    75→
    76→  it("should reject negative started_this_cycle", () => {
    77→    const result = TaskBudgetSchema.safeParse({
    78→      max_per_cycle: 3,
    79→      started_this_cycle: -1,
    80→    });
    81→    expect(result.success).toBe(false);
    82→  });
    83→
    84→  it("should reject non-integer max_per_cycle", () => {
    85→    const result = TaskBudgetSchema.safeParse({
    86→      max_per_cycle: 1.5,
    87→      started_this_cycle: 0,
    88→    });
    89→    expect(result.success).toBe(false);
    90→  });
    91→
    92→  it("should reject non-integer started_this_cycle", () => {
    93→    const result = TaskBudgetSchema.safeParse({
    94→      max_per_cycle: 1,
    95→      started_this_cycle: 0.5,
    96→    });
    97→    expect(result.success).toBe(false);
    98→  });
    99→
   100→  it("should reject missing fields", () => {
   101→    expect(TaskBudgetSchema.safeParse({}).success).toBe(false);
   102→    expect(
   103→      TaskBudgetSchema.safeParse({ max_per_cycle: 1 }).success,
   104→    ).toBe(false);
   105→    expect(
   106→      TaskBudgetSchema.safeParse({ started_this_cycle: 0 }).success,
   107→    ).toBe(false);
   108→  });
   109→});
   110→
   111→// ─── Path Helper Tests ──────────────────────────────────────────────────────
   112→
   113→describe("getSessionBudgetPath", () => {
   114→  // AC: @session-creation-and-env-injection ac-budget-local
   115→  it("should return path inside session directory", () => {
   116→    const specDir = "/test/.kspec";
   117→    const sessionId = "01KF123456789ABCDEFGHJKMNP";
   118→    expect(getSessionBudgetPath(specDir, sessionId)).toBe(
   119→      `/test/.kspec/sessions/${sessionId}/budget.json`,
   120→    );
   121→  });
   122→});
   123→
   124→// ─── Budget CRUD Tests ──────────────────────────────────────────────────────
   125→
   126→describe("Budget CRUD", () => {
   127→  let testDir: string;
   128→  const sessionId = "01KF123456789ABCDEFGHJKMNP";
   129→
   130→  beforeEach(async () => {
   131→    testDir = await fs.mkdtemp(
   132→      path.join(os.tmpdir(), "kspec-budget-test-"),
   133→    );
   134→    // Create a session directory so budget operations have a home
   135→    const input: SessionMetadataInput = {
   136→      id: sessionId,
   137→      agent_type: "claude-code",
   138→    };
   139→    await createSession(testDir, input);
   140→  });
   141→
   142→  afterEach(async () => {
   143→    await fs.rm(testDir, { recursive: true });
   144→  });
   145→
   146→  describe("createBudget", () => {
   147→    // AC: @session-creation-and-env-injection ac-budget
   148→    it("should create budget.json with max_per_cycle and started_this_cycle=0", async () => {
   149→      const budget = await createBudget(testDir, sessionId, 3);
   150→
   151→      expect(budget.max_per_cycle).toBe(3);
   152→      expect(budget.started_this_cycle).toBe(0);
   153→
   154→      // Verify file on disk
   155→      const budgetPath = getSessionBudgetPath(testDir, sessionId);
   156→      const content = await fs.readFile(budgetPath, "utf-8");
   157→      const parsed = JSON.parse(content);
   158→      expect(parsed.max_per_cycle).toBe(3);
   159→      expect(parsed.started_this_cycle).toBe(0);
   160→    });
   161→
   162→    // AC: @session-creation-and-env-injection ac-budget-local
   163→    it("should store budget in local filesystem under sessions dir", async () => {
   164→      await createBudget(testDir, sessionId, 2);
   165→
   166→      const budgetPath = getSessionBudgetPath(testDir, sessionId);
   167→      expect(budgetPath).toContain("sessions");
   168→      expect(budgetPath).toContain(sessionId);
   169→      expect(budgetPath).toContain("budget.json");
   170→
   171→      // File should exist
   172→      const stat = await fs.stat(budgetPath);
   173→      expect(stat.isFile()).toBe(true);
   174→    });
   175→
   176→    it("should reject invalid max_per_cycle", async () => {
   177→      await expect(createBudget(testDir, sessionId, 0)).rejects.toThrow();
   178→      await expect(createBudget(testDir, sessionId, -1)).rejects.toThrow();
   179→    });
   180→  });
   181→
   182→  describe("getBudget", () => {
   183→    // AC: @task-budget-enforcement ac-no-budget
   184→    it("should return null when no budget configured", async () => {
   185→      const budget = await getBudget(testDir, sessionId);
   186→      expect(budget).toBeNull();
   187→    });
   188→
   189→    it("should return budget after creation", async () => {
   190→      await createBudget(testDir, sessionId, 5);
   191→      const budget = await getBudget(testDir, sessionId);
   192→
   193→      expect(budget).not.toBeNull();
   194→      expect(budget!.max_per_cycle).toBe(5);
   195→      expect(budget!.started_this_cycle).toBe(0);
   196→    });
   197→
   198→    it("should return null for nonexistent session", async () => {
   199→      const budget = await getBudget(testDir, "NONEXISTENT");
   200→      expect(budget).toBeNull();
   201→    });
   202→
   203→    it("should throw on corrupt budget.json (fail closed, not open)", async () => {
   204→      // Write invalid JSON to budget.json — should throw, not silently disable enforcement
   205→      const budgetPath = getSessionBudgetPath(testDir, sessionId);
   206→      await fs.writeFile(budgetPath, "not valid json{{{", "utf-8");
   207→
   208→      await expect(getBudget(testDir, sessionId)).rejects.toThrow();
   209→    });
   210→
   211→    it("should throw on budget.json with invalid schema", async () => {
   212→      // Write valid JSON but wrong schema — should throw, not silently disable enforcement
   213→      const budgetPath = getSessionBudgetPath(testDir, sessionId);
   214→      await fs.writeFile(budgetPath, JSON.stringify({ wrong: "shape" }), "utf-8");
   215→
   216→      await expect(getBudget(testDir, sessionId)).rejects.toThrow();
   217→    });
   218→  });
   219→
   220→  describe("checkBudget", () => {
   221→    // AC: @task-budget-enforcement ac-no-session
   222→    it("should allow when no session ID provided", async () => {
   223→      const result = await checkBudget(testDir, undefined);
   224→      expect(result.allowed).toBe(true);
   225→      expect(result.budget).toBeUndefined();
   226→    });
   227→
   228→    // AC: @task-budget-enforcement ac-no-budget
   229→    it("should allow when session has no budget configured", async () => {
   230→      const result = await checkBudget(testDir, sessionId);
   231→      expect(result.allowed).toBe(true);
   232→      expect(result.budget).toBeUndefined();
   233→    });
   234→
   235→    it("should allow when under budget", async () => {
   236→      await createBudget(testDir, sessionId, 3);
   237→      const result = await checkBudget(testDir, sessionId);
   238→
   239→      expect(result.allowed).toBe(true);
   240→      expect(result.budget).toBeDefined();
   241→      expect(result.budget!.started_this_cycle).toBe(0);
   242→    });
   243→
   244→    // AC: @task-budget-enforcement ac-block-start
   245→    it("should block when budget exhausted", async () => {
   246→      await createBudget(testDir, sessionId, 1);
   247→      await incrementBudget(testDir, sessionId);
   248→
   249→      const result = await checkBudget(testDir, sessionId);
   250→      expect(result.allowed).toBe(false);
   251→      expect(result.reason).toContain("1/1");
   252→      expect(result.reason).toContain("budget exhausted");
   253→      expect(result.budget).toBeDefined();
   254→      expect(result.budget!.started_this_cycle).toBe(1);
   255→    });
   256→
   257→    // AC: @task-budget-enforcement ac-block-start
   258→    it("should include budget counts in rejection message", async () => {
   259→      await createBudget(testDir, sessionId, 2);
   260→      await incrementBudget(testDir, sessionId);
   261→      await incrementBudget(testDir, sessionId);
   262→
   263→      const result = await checkBudget(testDir, sessionId);
   264→      expect(result.allowed).toBe(false);
   265→      expect(result.reason).toContain("2/2");
   266→      expect(result.reason).toContain("Wrap up");
   267→    });
   268→  });
   269→
   270→  describe("incrementBudget", () => {
   271→    // AC: @task-budget-enforcement ac-increment
   272→    it("should increment started_this_cycle by 1", async () => {
   273→      await createBudget(testDir, sessionId, 5);
   274→
   275→      const updated = await incrementBudget(testDir, sessionId);
   276→      expect(updated).not.toBeNull();
   277→      expect(updated!.started_this_cycle).toBe(1);
   278→      expect(updated!.max_per_cycle).toBe(5);
   279→
   280→      // Verify persisted
   281→      const read = await getBudget(testDir, sessionId);
   282→      expect(read!.started_this_cycle).toBe(1);
   283→    });
   284→
   285→    it("should increment multiple times", async () => {
   286→      await createBudget(testDir, sessionId, 5);
   287→
   288→      await incrementBudget(testDir, sessionId);
   289→      await incrementBudget(testDir, sessionId);
   290→      const updated = await incrementBudget(testDir, sessionId);
   291→
   292→      expect(updated!.started_this_cycle).toBe(3);
   293→    });
   294→
   295→    it("should return null when no budget configured", async () => {
   296→      const result = await incrementBudget(testDir, sessionId);
   297→      expect(result).toBeNull();
   298→    });
   299→
   300→    // AC: @task-budget-enforcement ac-atomic-write
   301→    it("should write atomically (no temp files left behind)", async () => {
   302→      await createBudget(testDir, sessionId, 3);
   303→      await incrementBudget(testDir, sessionId);
   304→
   305→      // Check that no .tmp files remain in session dir
   306→      const sessionDir = path.join(testDir, "sessions", sessionId);
   307→      const files = await fs.readdir(sessionDir);
   308→      const tmpFiles = files.filter((f) => f.endsWith(".tmp"));
   309→      expect(tmpFiles).toHaveLength(0);
   310→    });
   311→  });
   312→
   313→  describe("resetBudget", () => {
   314→    // AC: @task-budget-enforcement ac-reset
   315→    it("should reset started_this_cycle to 0", async () => {
   316→      await createBudget(testDir, sessionId, 3);
   317→      await incrementBudget(testDir, sessionId);
   318→      await incrementBudget(testDir, sessionId);
   319→
   320→      const reset = await resetBudget(testDir, sessionId);
   321→      expect(reset).not.toBeNull();
   322→      expect(reset!.started_this_cycle).toBe(0);
   323→      expect(reset!.max_per_cycle).toBe(3);
   324→
   325→      // Verify persisted
   326→      const read = await getBudget(testDir, sessionId);
   327→      expect(read!.started_this_cycle).toBe(0);
   328→    });
   329→
   330→    it("should return null when no budget configured", async () => {
   331→      const result = await resetBudget(testDir, sessionId);
   332→      expect(result).toBeNull();
   333→    });
   334→
   335→    it("should preserve max_per_cycle after reset", async () => {
   336→      await createBudget(testDir, sessionId, 7);
   337→      await incrementBudget(testDir, sessionId);
   338→      await resetBudget(testDir, sessionId);
   339→
   340→      const budget = await getBudget(testDir, sessionId);
   341→      expect(budget!.max_per_cycle).toBe(7);
   342→      expect(budget!.started_this_cycle).toBe(0);
   343→    });
   344→
   345→    // AC: @task-budget-enforcement ac-atomic-write
   346→    it("should write atomically (no temp files left behind)", async () => {
   347→      await createBudget(testDir, sessionId, 3);
   348→      await incrementBudget(testDir, sessionId);
   349→      await resetBudget(testDir, sessionId);
   350→
   351→      const sessionDir = path.join(testDir, "sessions", sessionId);
   352→      const files = await fs.readdir(sessionDir);
   353→      const tmpFiles = files.filter((f) => f.endsWith(".tmp"));
   354→      expect(tmpFiles).toHaveLength(0);
   355→    });
   356→  });
   357→
   358→  describe("full lifecycle", () => {
   359→    it("should support create → increment → check → reset → check cycle", async () => {
   360→      // Create budget allowing 1 task per cycle
   361→      await createBudget(testDir, sessionId, 1);
   362→
   363→      // Check: should be allowed (0/1)
   364→      let check = await checkBudget(testDir, sessionId);
   365→      expect(check.allowed).toBe(true);
   366→
   367→      // Increment after starting a task
   368→      await incrementBudget(testDir, sessionId);
   369→
   370→      // Check: should be blocked (1/1)
   371→      check = await checkBudget(testDir, sessionId);
   372→      expect(check.allowed).toBe(false);
   373→
   374→      // Reset at iteration boundary
   375→      await resetBudget(testDir, sessionId);
   376→
   377→      // Check: should be allowed again (0/1)
   378→      check = await checkBudget(testDir, sessionId);
   379→      expect(check.allowed).toBe(true);
   380→    });
   381→  });
   382→});
   383→