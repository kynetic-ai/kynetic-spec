```
     1→import { describe, it, expect } from "vitest";
     2→import { Command } from "commander";
     3→import {
     4→  BatchCommandSchema,
     5→  BatchInputSchema,
     6→} from "../src/schema/batch.js";
     7→import {
     8→  parseBatchInput,
     9→  validateBatchCommands,
    10→  reportBatchValidationErrors,
    11→  BatchParseError,
    12→} from "../src/cli/batch-exec.js";
    13→import { extractCommandTree } from "../src/cli/introspection.js";
    14→import type { CommandMeta } from "../src/cli/introspection.js";
    15→
    16→// ── Test Program ────────────────────────────────────────────────────
    17→// Minimal Commander program that mirrors real CLI structure for testing.
    18→
    19→function createTestProgram(): Command {
    20→  const program = new Command("kspec");
    21→
    22→  // task group with subcommands
    23→  const task = program.command("task").description("Task management");
    24→  task
    25→    .command("add")
    26→    .description("Add a task")
    27→    .requiredOption("--title <title>", "Task title")
    28→    .option("--spec-ref <ref>", "Spec reference")
    29→    .option("--priority <n>", "Priority level")
    30→    .argument("<ref>", "Parent reference");
    31→  task
    32→    .command("note")
    33→    .description("Add a note to a task")
    34→    .argument("<ref>", "Task reference")
    35→    .argument("<content>", "Note content");
    36→  task
    37→    .command("start")
    38→    .description("Start a task")
    39→    .argument("<ref>", "Task reference");
    40→  task
    41→    .command("complete")
    42→    .description("Complete a task")
    43→    .argument("<ref>", "Task reference")
    44→    .option("--reason <reason>", "Completion reason")
    45→    .option("--force", "Force completion");
    46→
    47→  // item group with subcommands
    48→  const item = program.command("item").description("Spec item management");
    49→  item
    50→    .command("add")
    51→    .description("Add a spec item")
    52→    .requiredOption("--title <title>", "Item title")
    53→    .option("--under <ref>", "Parent item")
    54→    .option("--type <type>", "Item type");
    55→  item
    56→    .command("note")
    57→    .description("Add note to an item")
    58→    .argument("<ref>", "Item reference")
    59→    .argument("<content>", "Note content");
    60→
    61→  // validate (leaf command, no subcommands)
    62→  program
    63→    .command("validate")
    64→    .description("Validate spec files")
    65→    .option("--strict", "Strict mode");
    66→
    67→  return program;
    68→}
    69→
    70→function getTestTree(): CommandMeta {
    71→  return extractCommandTree(createTestProgram());
    72→}
    73→
    74→// ── Schema Tests ────────────────────────────────────────────────────
    75→
    76→describe("BatchCommandSchema", () => {
    77→  it("accepts valid command object", () => {
    78→    const result = BatchCommandSchema.parse({
    79→      command: "task add",
    80→      args: { title: "My Task" },
    81→      id: "cmd-1",
    82→    });
    83→    expect(result.command).toBe("task add");
    84→    expect(result.args).toEqual({ title: "My Task" });
    85→    expect(result.id).toBe("cmd-1");
    86→  });
    87→
    88→  it("defaults args to empty object", () => {
    89→    const result = BatchCommandSchema.parse({ command: "validate" });
    90→    expect(result.args).toEqual({});
    91→  });
    92→
    93→  // AC: @batch-command-schema ac-id-field — id is optional
    94→  it("accepts command without id", () => {
    95→    const result = BatchCommandSchema.parse({
    96→      command: "task start",
    97→      args: { ref: "@my-task" },
    98→    });
    99→    expect(result.id).toBeUndefined();
   100→  });
   101→
   102→  it("rejects empty command string", () => {
   103→    expect(() => BatchCommandSchema.parse({ command: "" })).toThrow();
   104→  });
   105→
   106→  it("rejects missing command field", () => {
   107→    expect(() => BatchCommandSchema.parse({ args: {} })).toThrow();
   108→  });
   109→});
   110→
   111→describe("BatchInputSchema", () => {
   112→  it("accepts array of valid commands", () => {
   113→    const result = BatchInputSchema.parse([
   114→      { command: "task add", args: { title: "One" } },
   115→      { command: "task add", args: { title: "Two" } },
   116→    ]);
   117→    expect(result).toHaveLength(2);
   118→  });
   119→
   120→  it("rejects empty array", () => {
   121→    expect(() => BatchInputSchema.parse([])).toThrow(
   122→      /at least one command/i,
   123→    );
   124→  });
   125→
   126→  it("rejects non-array input", () => {
   127→    expect(() => BatchInputSchema.parse({ command: "task add" })).toThrow();
   128→  });
   129→});
   130→
   131→// ── Parse Tests ─────────────────────────────────────────────────────
   132→
   133→describe("parseBatchInput", () => {
   134→  it("parses inline JSON", async () => {
   135→    const input = JSON.stringify([
   136→      { command: "task start", args: { ref: "@my-task" } },
   137→    ]);
   138→    const result = await parseBatchInput({ type: "inline", json: input });
   139→    expect(result).toHaveLength(1);
   140→    expect(result[0].command).toBe("task start");
   141→  });
   142→
   143→  it("parses multiple commands from inline JSON", async () => {
   144→    const input = JSON.stringify([
   145→      { command: "task add", args: { title: "First" }, id: "a" },
   146→      { command: "task add", args: { title: "Second" }, id: "b" },
   147→    ]);
   148→    const result = await parseBatchInput({ type: "inline", json: input });
   149→    expect(result).toHaveLength(2);
   150→    expect(result[0].id).toBe("a");
   151→    expect(result[1].id).toBe("b");
   152→  });
   153→
   154→  // AC: parent ac-invalid-json — invalid JSON throws with position info
   155→  it("throws BatchParseError on invalid JSON with position info", async () => {
   156→    await expect(
   157→      parseBatchInput({ type: "inline", json: "{bad json" }),
   158→    ).rejects.toThrow(BatchParseError);
   159→
   160→    await expect(
   161→      parseBatchInput({ type: "inline", json: "{bad json" }),
   162→    ).rejects.toThrow(/Invalid JSON/);
   163→  });
   164→
   165→  // AC: parent ac-empty-batch — empty array rejected
   166→  it("throws BatchParseError on empty array", async () => {
   167→    await expect(
   168→      parseBatchInput({ type: "inline", json: "[]" }),
   169→    ).rejects.toThrow(BatchParseError);
   170→
   171→    await expect(
   172→      parseBatchInput({ type: "inline", json: "[]" }),
   173→    ).rejects.toThrow(/at least one command/i);
   174→  });
   175→
   176→  it("throws BatchParseError when command field is missing", async () => {
   177→    await expect(
   178→      parseBatchInput({
   179→        type: "inline",
   180→        json: JSON.stringify([{ args: { title: "No command" } }]),
   181→      }),
   182→    ).rejects.toThrow(BatchParseError);
   183→  });
   184→
   185→  it("throws BatchParseError on non-existent file", async () => {
   186→    await expect(
   187→      parseBatchInput({ type: "file", path: "/nonexistent/file.json" }),
   188→    ).rejects.toThrow(BatchParseError);
   189→
   190→    await expect(
   191→      parseBatchInput({ type: "file", path: "/nonexistent/file.json" }),
   192→    ).rejects.toThrow(/Failed to read batch file/);
   193→  });
   194→});
   195→
   196→// ── Validation Tests ────────────────────────────────────────────────
   197→
   198→describe("validateBatchCommands", () => {
   199→  const tree = getTestTree();
   200→
   201→  // AC: @batch-command-schema ac-command-field
   202→  describe("command path resolution", () => {
   203→    it("accepts valid single-level command", () => {
   204→      const result = validateBatchCommands(
   205→        [{ command: "validate", args: {} }],
   206→        tree,
   207→      );
   208→      expect(result.valid).toBe(true);
   209→      expect(result.errors).toHaveLength(0);
   210→    });
   211→
   212→    it("accepts valid multi-level command path", () => {
   213→      const result = validateBatchCommands(
   214→        [{ command: "task add", args: { title: "Test", ref: "@parent" } }],
   215→        tree,
   216→      );
   217→      // May have missing required errors but not unknown_command errors
   218→      const unknownErrs = result.errors.filter(
   219→        (e) => e.type === "unknown_command",
   220→      );
   221→      expect(unknownErrs).toHaveLength(0);
   222→    });
   223→
   224→    it("accepts deeply nested command path", () => {
   225→      const result = validateBatchCommands(
   226→        [
   227→          {
   228→            command: "task note",
   229→            args: { ref: "@task", content: "note text" },
   230→          },
   231→        ],
   232→        tree,
   233→      );
   234→      const unknownErrs = result.errors.filter(
   235→        (e) => e.type === "unknown_command",
   236→      );
   237→      expect(unknownErrs).toHaveLength(0);
   238→    });
   239→
   240→    it("rejects command group (non-leaf)", () => {
   241→      const result = validateBatchCommands(
   242→        [{ command: "task", args: {} }],
   243→        tree,
   244→      );
   245→      expect(result.valid).toBe(false);
   246→      expect(result.errors[0].type).toBe("unknown_command");
   247→      expect(result.errors[0].message).toContain("command group");
   248→    });
   249→
   250→    it("rejects with commandFilter", () => {
   251→      const result = validateBatchCommands(
   252→        [{ command: "validate", args: {} }],
   253→        tree,
   254→        {
   255→          commandFilter: (cmd) => cmd.name !== "validate",
   256→        },
   257→      );
   258→      expect(result.valid).toBe(false);
   259→      expect(result.errors[0].type).toBe("rejected_command");
   260→      expect(result.errors[0].message).toContain("not allowed");
   261→    });
   262→
   263→    it("allows commands passing commandFilter", () => {
   264→      const result = validateBatchCommands(
   265→        [{ command: "validate", args: {} }],
   266→        tree,
   267→        {
   268→          commandFilter: () => true,
   269→        },
   270→      );
   271→      expect(result.valid).toBe(true);
   272→    });
   273→  });
   274→
   275→  // AC: @batch-command-schema ac-args-mapping
   276→  describe("argument mapping", () => {
   277→    it("accepts kebab-case option names", () => {
   278→      const result = validateBatchCommands(
   279→        [
   280→          {
   281→            command: "task add",
   282→            args: { title: "Test", ref: "@parent", "spec-ref": "@spec" },
   283→          },
   284→        ],
   285→        tree,
   286→      );
   287→      const unknownArgErrs = result.errors.filter(
   288→        (e) => e.type === "unknown_arg",
   289→      );
   290→      expect(unknownArgErrs).toHaveLength(0);
   291→    });
   292→
   293→    it("accepts camelCase option names", () => {
   294→      const result = validateBatchCommands(
   295→        [
   296→          {
   297→            command: "task add",
   298→            args: { title: "Test", ref: "@parent", specRef: "@spec" },
   299→          },
   300→        ],
   301→        tree,
   302→      );
   303→      const unknownArgErrs = result.errors.filter(
   304→        (e) => e.type === "unknown_arg",
   305→      );
   306→      expect(unknownArgErrs).toHaveLength(0);
   307→    });
   308→
   309→    it("accepts positional args by name", () => {
   310→      const result = validateBatchCommands(
   311→        [{ command: "task start", args: { ref: "@my-task" } }],
   312→        tree,
   313→      );
   314→      const unknownArgErrs = result.errors.filter(
   315→        (e) => e.type === "unknown_arg",
   316→      );
   317→      expect(unknownArgErrs).toHaveLength(0);
   318→    });
   319→
   320→    it("flags unknown args with suggestion", () => {
   321→      const result = validateBatchCommands(
   322→        [
   323→          {
   324→            command: "task add",
   325→            args: { title: "Test", ref: "@parent", tittle: "typo" },
   326→          },
   327→        ],
   328→        tree,
   329→      );
   330→      const unknownArgErrs = result.errors.filter(
   331→        (e) => e.type === "unknown_arg",
   332→      );
   333→      expect(unknownArgErrs).toHaveLength(1);
   334→      expect(unknownArgErrs[0].message).toContain("tittle");
   335→      expect(unknownArgErrs[0].suggestion).toBe("title");
   336→    });
   337→  });
   338→
   339→  // AC: @batch-command-schema ac-unknown-command
   340→  describe("unknown command handling", () => {
   341→    it("reports unknown command with index", () => {
   342→      const result = validateBatchCommands(
   343→        [{ command: "taks add", args: {} }],
   344→        tree,
   345→      );
   346→      expect(result.valid).toBe(false);
   347→      expect(result.errors).toHaveLength(1);
   348→      expect(result.errors[0].type).toBe("unknown_command");
   349→      expect(result.errors[0].index).toBe(0);
   350→      expect(result.errors[0].command).toBe("taks add");
   351→    });
   352→
   353→    it("suggests closest valid command", () => {
   354→      const result = validateBatchCommands(
   355→        [{ command: "task ad", args: {} }],
   356→        tree,
   357→      );
   358→      expect(result.errors[0].type).toBe("unknown_command");
   359→      expect(result.errors[0].suggestion).toBe("task add");
   360→    });
   361→
   362→    it("handles completely invalid command with no suggestion", () => {
   363→      const result = validateBatchCommands(
   364→        [{ command: "zzzzzzzzzzzzzzz", args: {} }],
   365→        tree,
   366→      );
   367→      expect(result.errors[0].type).toBe("unknown_command");
   368→      expect(result.errors[0].suggestion).toBeUndefined();
   369→    });
   370→  });
   371→
   372→  // AC: @batch-command-schema ac-missing-required
   373→  describe("missing required args", () => {
   374→    it("detects missing required option", () => {
   375→      const result = validateBatchCommands(
   376→        [{ command: "task add", args: { ref: "@parent" } }],
   377→        tree,
   378→      );
   379→      const missingErrs = result.errors.filter(
   380→        (e) => e.type === "missing_required",
   381→      );
   382→      expect(missingErrs.length).toBeGreaterThanOrEqual(1);
   383→      const titleErr = missingErrs.find((e) => e.message.includes("title"));
   384→      expect(titleErr).toBeDefined();
   385→    });
   386→
   387→    it("detects missing required positional arg", () => {
   388→      const result = validateBatchCommands(
   389→        [{ command: "task start", args: {} }],
   390→        tree,
   391→      );
   392→      const missingErrs = result.errors.filter(
   393→        (e) => e.type === "missing_required",
   394→      );
   395→      expect(missingErrs.length).toBeGreaterThanOrEqual(1);
   396→      expect(missingErrs[0].message).toContain("ref");
   397→    });
   398→
   399→    it("identifies missing args by name", () => {
   400→      const result = validateBatchCommands(
   401→        [{ command: "task note", args: {} }],
   402→        tree,
   403→      );
   404→      const missingErrs = result.errors.filter(
   405→        (e) => e.type === "missing_required",
   406→      );
   407→      const names = missingErrs.map((e) => e.message);
   408→      expect(names.some((m) => m.includes("ref"))).toBe(true);
   409→      expect(names.some((m) => m.includes("content"))).toBe(true);
   410→    });
   411→
   412→    it("passes when all required args are present", () => {
   413→      const result = validateBatchCommands(
   414→        [
   415→          {
   416→            command: "task add",
   417→            args: { title: "Test", ref: "@parent" },
   418→          },
   419→        ],
   420→        tree,
   421→      );
   422→      const missingErrs = result.errors.filter(
   423→        (e) => e.type === "missing_required",
   424→      );
   425→      expect(missingErrs).toHaveLength(0);
   426→    });
   427→  });
   428→
   429→  // AC: @batch-command-schema ac-id-field
   430→  describe("id field handling", () => {
   431→    it("preserves id in validation errors", () => {
   432→      const result = validateBatchCommands(
   433→        [{ command: "nonexistent", args: {}, id: "my-cmd-1" }],
   434→        tree,
   435→      );
   436→      expect(result.errors[0].id).toBe("my-cmd-1");
   437→    });
   438→
   439→    it("uses index when id is absent", () => {
   440→      const result = validateBatchCommands(
   441→        [{ command: "nonexistent", args: {} }],
   442→        tree,
   443→      );
   444→      expect(result.errors[0].index).toBe(0);
   445→      expect(result.errors[0].id).toBeUndefined();
   446→    });
   447→
   448→    it("tracks correct index in multi-command batch", () => {
   449→      const result = validateBatchCommands(
   450→        [
   451→          { command: "validate", args: {} },
   452→          { command: "nonexistent", args: {}, id: "bad-one" },
   453→          { command: "task start", args: { ref: "@t" } },
   454→        ],
   455→        tree,
   456→      );
   457→      expect(result.errors).toHaveLength(1);
   458→      expect(result.errors[0].index).toBe(1);
   459→      expect(result.errors[0].id).toBe("bad-one");
   460→    });
   461→  });
   462→
   463→  describe("mixed errors", () => {
   464→    it("collects multiple error types from a single batch", () => {
   465→      const result = validateBatchCommands(
   466→        [
   467→          { command: "nonexistent", args: {} },
   468→          { command: "task add", args: {} },
   469→          {
   470→            command: "task start",
   471→            args: { ref: "@t", bogus: true },
   472→          },
   473→        ],
   474→        tree,
   475→      );
   476→      expect(result.valid).toBe(false);
   477→      const types = result.errors.map((e) => e.type);
   478→      expect(types).toContain("unknown_command");
   479→      expect(types).toContain("missing_required");
   480→      expect(types).toContain("unknown_arg");
   481→    });
   482→  });
   483→});
