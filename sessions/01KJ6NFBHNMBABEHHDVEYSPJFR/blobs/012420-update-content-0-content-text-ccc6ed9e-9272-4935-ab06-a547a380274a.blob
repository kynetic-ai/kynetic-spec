   485→// ── Error Reporting Tests ───────────────────────────────────────────
   486→
   487→describe("reportBatchValidationErrors", () => {
   488→  it("returns empty string for valid result", () => {
   489→    const output = reportBatchValidationErrors({
   490→      valid: true,
   491→      commands: [],
   492→      errors: [],
   493→    });
   494→    expect(output).toBe("");
   495→  });
   496→
   497→  it("formats human-readable errors with index", () => {
   498→    const output = reportBatchValidationErrors({
   499→      valid: false,
   500→      commands: [],
   501→      errors: [
   502→        {
   503→          index: 0,
   504→          command: "taks add",
   505→          type: "unknown_command",
   506→          message: 'Unknown command: "taks add"',
   507→          suggestion: "task add",
   508→        },
   509→      ],
   510→    });
   511→    expect(output).toContain("[#0]");
   512→    expect(output).toContain("Unknown command");
   513→    expect(output).toContain("Did you mean: task add?");
   514→  });
   515→
   516→  it("includes 'kspec batch commands' hint in human-readable errors", () => {
   517→    const output = reportBatchValidationErrors({
   518→      valid: false,
   519→      commands: [],
   520→      errors: [
   521→        {
   522→          index: 0,
   523→          command: "unknown cmd",
   524→          type: "unknown_command",
   525→          message: 'Unknown command: "unknown cmd"',
   526→        },
   527→      ],
   528→    });
   529→    expect(output).toContain("Run 'kspec batch commands'");
   530→    expect(output).toContain("for a list of available commands");
   531→  });
   532→
   533→  it("formats human-readable errors with id when present", () => {
   534→    const output = reportBatchValidationErrors({
   535→      valid: false,
   536→      commands: [],
   537→      errors: [
   538→        {
   539→          index: 0,
   540→          id: "my-cmd",
   541→          command: "taks add",
   542→          type: "unknown_command",
   543→          message: 'Unknown command: "taks add"',
   544→        },
   545→      ],
   546→    });
   547→    expect(output).toContain("[my-cmd]");
   548→    expect(output).not.toContain("[#0]");
   549→  });
   550→
   551→  it("produces valid JSON in json mode", () => {
   552→    const output = reportBatchValidationErrors(
   553→      {
   554→        valid: false,
   555→        commands: [],
   556→        errors: [
   557→          {
   558→            index: 0,
   559→            command: "bad",
   560→            type: "unknown_command",
   561→            message: "Unknown command",
   562→          },
   563→        ],
   564→      },
   565→      true,
   566→    );
   567→    const parsed = JSON.parse(output);
   568→    expect(parsed.valid).toBe(false);
   569→    expect(parsed.errors).toHaveLength(1);
   570→    expect(parsed.errors[0].type).toBe("unknown_command");
   571→  });
   572→
   573→  it("does not include hint text in JSON mode", () => {
   574→    const output = reportBatchValidationErrors(
   575→      {
   576→        valid: false,
   577→        commands: [],
   578→        errors: [
   579→          {
   580→            index: 0,
   581→            command: "bad",
   582→            type: "unknown_command",
   583→            message: "Unknown command",
   584→          },
   585→        ],
   586→      },
   587→      true,
   588→    );
   589→    expect(output).not.toContain("kspec batch commands");
   590→  });
   591→
   592→  it("returns valid JSON for valid result in json mode", () => {
   593→    const output = reportBatchValidationErrors(
   594→      { valid: true, commands: [], errors: [] },
   595→      true,
   596→    );
   597→    const parsed = JSON.parse(output);
   598→    expect(parsed.valid).toBe(true);
   599→    expect(parsed.errors).toHaveLength(0);
   600→  });
   601→});
