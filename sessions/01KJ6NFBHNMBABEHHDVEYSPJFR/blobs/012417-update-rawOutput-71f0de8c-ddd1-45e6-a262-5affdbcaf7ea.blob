   869→// ── KSPEC_SPEC_DIR Override ──────────────────────────────────────────
   870→
   871→describe("KSPEC_SPEC_DIR environment variable", () => {
   872→  let tempDir: string;
   873→
   874→  beforeEach(async () => {
   875→    tempDir = await setupTempFixtures();
   876→    initGitRepo(tempDir);
   877→    kspec("init --no-prompt", tempDir);
   878→  });
   879→
   880→  afterEach(async () => {
   881→    await cleanupTempDir(tempDir);
   882→  });
   883→
   884→  it("overrides initContext to use specified directory", () => {
   885→    // Run a simple command with KSPEC_SPEC_DIR pointing to our test .kspec/
   886→    const specDir = `${tempDir}/.kspec`;
   887→    // Use inbox list (read-only, always succeeds) to verify the env var works
   888→    const result = kspec("inbox list", tempDir, {
   889→      env: { KSPEC_SPEC_DIR: specDir },
   890→    });
   891→    expect(result.exitCode).toBe(0);
   892→  });
   893→});
   894→