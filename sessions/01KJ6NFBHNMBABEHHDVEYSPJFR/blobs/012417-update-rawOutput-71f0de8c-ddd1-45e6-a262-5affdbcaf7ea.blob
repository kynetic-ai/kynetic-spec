     1→/**
     2→ * Tests for the batch execution engine.
     3→ *
     4→ * Unit tests for buildCommandArgv, resetCommandTree, OutputCapture, BatchExitError.
     5→ * Integration tests via CLI helper for atomic/immediate modes.
     6→ */
     7→
     8→import { describe, it, expect, beforeEach, afterEach } from "vitest";
     9→import { Command } from "commander";
    10→import {
    11→  buildCommandArgv,
    12→  resetCommandTree,
    13→} from "../src/cli/batch-exec.js";
    14→import {
    15→  BatchExitError,
    16→  OutputCapture,
    17→  installExitInterceptor,
    18→  uninstallExitInterceptor,
    19→  setBatchMode,
    20→  isBatchMode,
    21→} from "../src/cli/batch-context.js";
    22→import { extractCommandTree } from "../src/cli/introspection.js";
    23→import type { CommandMeta } from "../src/cli/introspection.js";
    24→import { markMutating } from "../src/cli/command-annotations.js";
    25→import {
    26→  kspec,
    27→  kspecJson,
    28→  setupTempFixtures,
    29→  cleanupTempDir,
    30→  initGitRepo,
    31→} from "./helpers/cli.js";
    32→import type { BatchExecResult, BatchCommandResult } from "../src/schema/batch.js";
    33→
    34→// ── Test Program for Unit Tests ──────────────────────────────────────
    35→
    36→function createTestProgram(): Command {
    37→  const program = new Command("kspec");
    38→  const task = program.command("task").description("Task management");
    39→  markMutating(
    40→    task.command("add")
    41→      .description("Add a task")
    42→      .requiredOption("--title <title>", "Task title")
    43→      .option("--spec-ref <ref>", "Spec reference")
    44→      .option("--priority <n>", "Priority level")
    45→      .option("--force", "Skip confirmation"),
    46→  );
    47→  markMutating(
    48→    task.command("start")
    49→      .description("Start a task")
    50→      .argument("<ref>", "Task reference"),
    51→  );
    52→  markMutating(
    53→    task.command("note")
    54→      .description("Add a note")
    55→      .argument("<ref>", "Task reference")
    56→      .argument("<content>", "Note content"),
    57→  );
    58→  markMutating(
    59→    task.command("patch")
    60→      .description("Patch a task")
    61→      .argument("<ref>", "Task reference")
    62→      .option("--data <json>", "JSON object with fields to update"),
    63→  );
    64→
    65→  const inbox = program.command("inbox").description("Inbox");
    66→  markMutating(
    67→    inbox.command("add")
    68→      .description("Add inbox item")
    69→      .argument("<text>", "Idea text")
    70→      .option("--tag <tag...>", "Tags"),
    71→  );
    72→
    73→  program.command("validate").description("Validate spec files");
    74→
    75→  return program;
    76→}
    77→
    78→function getTestTree(): CommandMeta {
    79→  return extractCommandTree(createTestProgram());
    80→}
    81→
    82→// ── Unit Tests: buildCommandArgv ─────────────────────────────────────
    83→
    84→describe("buildCommandArgv", () => {
    85→  const tree = getTestTree();
    86→
    87→  // AC: @batch-exec ac-confirmation-suppressed
    88→  it("maps positional args correctly", () => {
    89→    const cmdMeta = tree.subcommands
    90→      .find((c) => c.name === "inbox")!
    91→      .subcommands.find((c) => c.name === "add")!;
    92→    const argv = buildCommandArgv(
    93→      { command: "inbox add", args: { text: "hello world" } },
    94→      cmdMeta,
    95→    );
    96→    expect(argv).toEqual(["inbox", "add", "hello world"]);
    97→  });
    98→
    99→  it("maps option args correctly", () => {
   100→    const cmdMeta = tree.subcommands
   101→      .find((c) => c.name === "task")!
   102→      .subcommands.find((c) => c.name === "add")!;
   103→    const argv = buildCommandArgv(
   104→      { command: "task add", args: { title: "My Task", priority: "2" } },
   105→      cmdMeta,
   106→    );
   107→    expect(argv).toContain("--title");
   108→    expect(argv).toContain("My Task");
   109→    expect(argv).toContain("--priority");
   110→    expect(argv).toContain("2");
   111→  });
   112→
   113→  it("handles boolean options (true)", () => {
   114→    const cmdMeta = tree.subcommands
   115→      .find((c) => c.name === "task")!
   116→      .subcommands.find((c) => c.name === "add")!;
   117→    const argv = buildCommandArgv(
   118→      { command: "task add", args: { title: "T", force: true } },
   119→      cmdMeta,
   120→    );
   121→    expect(argv).toContain("--force");
   122→  });
   123→
   124→  it("handles boolean options (false = omitted)", () => {
   125→    const cmdMeta = tree.subcommands
   126→      .find((c) => c.name === "task")!
   127→      .subcommands.find((c) => c.name === "add")!;
   128→    const argv = buildCommandArgv(
   129→      { command: "task add", args: { title: "T", force: false } },
   130→      cmdMeta,
   131→    );
   132→    expect(argv).not.toContain("--force");
   133→  });
   134→
   135→  it("handles array options (variadic/repeated)", () => {
   136→    const cmdMeta = tree.subcommands
   137→      .find((c) => c.name === "inbox")!
   138→      .subcommands.find((c) => c.name === "add")!;
   139→    const argv = buildCommandArgv(
   140→      { command: "inbox add", args: { text: "idea", tag: ["a", "b"] } },
   141→      cmdMeta,
   142→    );
   143→    // Should produce: inbox add idea --tag a --tag b
   144→    expect(argv).toContain("idea");
   145→    const tagIndices = argv
   146→      .map((v, i) => (v === "--tag" ? i : -1))
   147→      .filter((i) => i >= 0);
   148→    expect(tagIndices.length).toBe(2);
   149→    expect(argv[tagIndices[0] + 1]).toBe("a");
   150→    expect(argv[tagIndices[1] + 1]).toBe("b");
   151→  });
   152→
   153→  it("handles camelCase args", () => {
   154→    const cmdMeta = tree.subcommands
   155→      .find((c) => c.name === "task")!
   156→      .subcommands.find((c) => c.name === "add")!;
   157→    const argv = buildCommandArgv(
   158→      { command: "task add", args: { title: "T", specRef: "ref1" } },
   159→      cmdMeta,
   160→    );
   161→    expect(argv).toContain("--spec-ref");
   162→    expect(argv).toContain("ref1");
   163→  });
   164→
   165→  it("handles multiple positional args", () => {
   166→    const cmdMeta = tree.subcommands
   167→      .find((c) => c.name === "task")!
   168→      .subcommands.find((c) => c.name === "note")!;
   169→    const argv = buildCommandArgv(
   170→      { command: "task note", args: { ref: "@task1", content: "my note" } },
   171→      cmdMeta,
   172→    );
   173→    expect(argv).toContain("@task1");
   174→    expect(argv).toContain("my note");
   175→  });
   176→
   177→  it("JSON-stringifies nested object values for --data flag", () => {
   178→    const cmdMeta = tree.subcommands
   179→      .find((c) => c.name === "task")!
   180→      .subcommands.find((c) => c.name === "patch")!;
   181→    const dataObj = { status: "completed", priority: 2 };
   182→    const argv = buildCommandArgv(
   183→      { command: "task patch", args: { ref: "@task1", data: dataObj } },
   184→      cmdMeta,
   185→    );
   186→    expect(argv).toContain("--data");
   187→    const dataIdx = argv.indexOf("--data");
   188→    const dataValue = argv[dataIdx + 1];
   189→    // Must be valid JSON, not "[object Object]"
   190→    expect(dataValue).toBe(JSON.stringify(dataObj));
   191→    expect(JSON.parse(dataValue)).toEqual(dataObj);
   192→  });
   193→
   194→  it("JSON-stringifies deeply nested objects", () => {
   195→    const cmdMeta = tree.subcommands
   196→      .find((c) => c.name === "task")!
   197→      .subcommands.find((c) => c.name === "patch")!;
   198→    const dataObj = { meta: { tags: ["a", "b"], nested: { deep: true } } };
   199→    const argv = buildCommandArgv(
   200→      { command: "task patch", args: { ref: "@t1", data: dataObj } },
   201→      cmdMeta,
   202→    );
   203→    const dataIdx = argv.indexOf("--data");
   204→    expect(JSON.parse(argv[dataIdx + 1])).toEqual(dataObj);
   205→  });
   206→
   207→  it("does not double-stringify string values", () => {
   208→    const cmdMeta = tree.subcommands
   209→      .find((c) => c.name === "task")!
   210→      .subcommands.find((c) => c.name === "patch")!;
   211→    const argv = buildCommandArgv(
   212→      { command: "task patch", args: { ref: "@t1", data: '{"already":"json"}' } },
   213→      cmdMeta,
   214→    );
   215→    const dataIdx = argv.indexOf("--data");
   216→    // String values should pass through as-is
   217→    expect(argv[dataIdx + 1]).toBe('{"already":"json"}');
   218→  });
   219→
   220→  it("emits positional args in definition order, not JSON key order", () => {
   221→    const cmdMeta = tree.subcommands
   222→      .find((c) => c.name === "task")!
   223→      .subcommands.find((c) => c.name === "note")!;
   224→    // Pass keys in reverse order — content before ref
   225→    const argv = buildCommandArgv(
   226→      { command: "task note", args: { content: "my note", ref: "@task1" } },
   227→      cmdMeta,
   228→    );
   229→    // Positional args should be: ref first, then content (Commander definition order)
   230→    const positionalStart = 2; // after "task" and "note"
   231→    expect(argv[positionalStart]).toBe("@task1");
   232→    expect(argv[positionalStart + 1]).toBe("my note");
   233→  });
   234→});
   235→
   236→// ── Unit Tests: resetCommandTree ─────────────────────────────────────
   237→
   238→describe("resetCommandTree", () => {
   239→  it("clears option values across command tree", () => {
   240→    const program = createTestProgram();
   241→    // Simulate Commander setting values
   242→    (program as any)._optionValues = { json: true };
   243→    const taskCmd = program.commands.find((c) => c.name() === "task")!;
   244→    (taskCmd as any)._optionValues = { debug: true };
   245→
   246→    resetCommandTree(program);
   247→
   248→    expect((program as any)._optionValues).toEqual({});
   249→    expect((taskCmd as any)._optionValues).toEqual({});
   250→  });
   251→
   252→  it("clears processedArgs", () => {
   253→    const program = createTestProgram();
   254→    (program as any).processedArgs = ["foo", "bar"];
   255→
   256→    resetCommandTree(program);
   257→
   258→    expect((program as any).processedArgs).toEqual([]);
   259→  });
   260→});
   261→
   262→// ── Unit Tests: OutputCapture ────────────────────────────────────────
   263→
   264→describe("OutputCapture", () => {
   265→  it("captures console.log output", () => {
   266→    const capture = new OutputCapture();
   267→    const origLog = console.log;
   268→    capture.start();
   269→    console.log("hello");
   270→    console.log("world");
   271→    capture.stop();
   272→
   273→    expect(capture.getOutput()).toBe("hello\nworld");
   274→    expect(console.log).toBe(origLog);
   275→  });
   276→
   277→  it("captures console.error output", () => {
   278→    const capture = new OutputCapture();
   279→    const origError = console.error;
   280→    capture.start();
   281→    console.error("error msg");
   282→    capture.stop();
   283→
   284→    expect(capture.getOutput()).toBe("error msg");
   285→    expect(console.error).toBe(origError);
   286→  });
   287→
   288→  it("captures console.warn output", () => {
   289→    const capture = new OutputCapture();
   290→    const origWarn = console.warn;
   291→    capture.start();
   292→    console.warn("warning");
   293→    capture.stop();
   294→
   295→    expect(capture.getOutput()).toBe("warning");
   296→    expect(console.warn).toBe(origWarn);
   297→  });
   298→
   299→  it("handles non-string args via JSON.stringify", () => {
   300→    const capture = new OutputCapture();
   301→    capture.start();
   302→    console.log({ key: "val" });
   303→    capture.stop();
   304→
   305→    expect(capture.getOutput()).toBe('{"key":"val"}');
   306→  });
   307→
   308→  it("restores original methods on stop", () => {
   309→    const origLog = console.log;
   310→    const origError = console.error;
   311→    const origWarn = console.warn;
   312→
   313→    const capture = new OutputCapture();
   314→    capture.start();
   315→    capture.stop();
   316→
   317→    expect(console.log).toBe(origLog);
   318→    expect(console.error).toBe(origError);
   319→    expect(console.warn).toBe(origWarn);
   320→  });
   321→});
   322→
   323→// ── Unit Tests: BatchExitError + Exit Interceptor ────────────────────
   324→
   325→describe("BatchExitError", () => {
   326→  it("stores exit code", () => {
   327→    const err = new BatchExitError(1);
   328→    expect(err.code).toBe(1);
   329→    expect(err.name).toBe("BatchExitError");
   330→  });
   331→
   332→  it("stores exit code 0", () => {
   333→    const err = new BatchExitError(0);
   334→    expect(err.code).toBe(0);
   335→  });
   336→});
   337→
   338→describe("exit interceptor", () => {
   339→  afterEach(() => {
   340→    uninstallExitInterceptor();
   341→  });
   342→
   343→  it("throws BatchExitError on process.exit", () => {
   344→    installExitInterceptor();
   345→    expect(() => process.exit(1)).toThrow(BatchExitError);
   346→  });
   347→
   348→  it("captures exit code", () => {
   349→    installExitInterceptor();
   350→    try {
   351→      process.exit(42);
   352→    } catch (err) {
   353→      expect(err).toBeInstanceOf(BatchExitError);
   354→      expect((err as BatchExitError).code).toBe(42);
   355→    }
   356→  });
   357→
   358→  it("restores original process.exit", () => {
   359→    const origExit = process.exit;
   360→    installExitInterceptor();
   361→    uninstallExitInterceptor();
   362→    expect(process.exit).toBe(origExit);
   363→  });
   364→});
   365→
   366→// ── Unit Tests: Batch Mode Flag ──────────────────────────────────────
   367→
   368→describe("batchMode flag", () => {
   369→  afterEach(() => {
   370→    setBatchMode(false);
   371→  });
   372→
   373→  it("defaults to false", () => {
   374→    expect(isBatchMode()).toBe(false);
   375→  });
   376→
   377→  it("can be set and cleared", () => {
   378→    setBatchMode(true);
   379→    expect(isBatchMode()).toBe(true);
   380→    setBatchMode(false);
   381→    expect(isBatchMode()).toBe(false);
   382→  });
   383→});
   384→
   385→// ── Integration Tests ────────────────────────────────────────────────
   386→// Uses the real CLI via kspec() helper with temp fixtures.
   387→
   388→describe("batch command integration", () => {
   389→  let tempDir: string;
   390→
   391→  beforeEach(async () => {
   392→    tempDir = await setupTempFixtures();
   393→    initGitRepo(tempDir);
   394→    // Initialize kspec with shadow branch
   395→    kspec("init --no-prompt", tempDir);
   396→  });
   397→
   398→  afterEach(async () => {
   399→    await cleanupTempDir(tempDir);
   400→  });
   401→
   402→  // AC: @batch-exec ac-dry-run
   403→  // AC: @trait-dry-run ac-1 — shows what would be changed without applying
   404→  // AC: @trait-dry-run ac-2 — no files are modified
   405→  // AC: @trait-dry-run ac-3 — clear indication this is a preview ("dry-run: would execute")
   406→  it("--dry-run validates without executing", () => {
   407→    const result = kspecJson<BatchExecResult>(
   408→      `batch --dry-run --commands '[{"command":"inbox add","args":{"text":"test"}}]'`,
   409→      tempDir,
   410→    );
   411→    expect(result.success).toBe(true);
   412→    expect(result.mode).toBe("atomic");
   413→    expect(result.summary.succeeded).toBe(1);
   414→    expect(result.results[0].output).toBe("dry-run: would execute");
   415→
   416→    // Verify nothing was actually created
   417→    const inbox = kspec("inbox list", tempDir);
   418→    expect(inbox.stdout).not.toContain("test");
   419→  });
   420→
   421→  // AC: @batch-exec ac-prevalidate
   422→  // AC: @trait-semantic-exit-codes ac-2 — validation error exits with code 1
   423→  it("pre-validates and rejects before any execution", () => {
   424→    const result = kspecJson<BatchExecResult>(
   425→      `batch --commands '[{"command":"inbox add","args":{"text":"ok"}},{"command":"nonexistent cmd","args":{}}]'`,
   426→      tempDir,
   427→      { expectFail: true },
   428→    );
   429→    expect(result.success).toBe(false);
   430→
   431→    // Nothing should have executed
   432→    const inbox = kspec("inbox list", tempDir);
   433→    expect(inbox.stdout).not.toContain("ok");
   434→  });
   435→
   436→  // AC: @batch-exec ac-mutating-only
   437→  // AC: @trait-error-guidance ac-1 — describes what went wrong ("not allowed in batch mode")
   438→  it("rejects read-only commands", () => {
   439→    const result = kspecJson<BatchExecResult>(
   440→      `batch --commands '[{"command":"inbox list","args":{}}]'`,
   441→      tempDir,
   442→      { expectFail: true },
   443→    );
   444→    expect(result.success).toBe(false);
   445→    expect(result.results[0].error).toContain("not allowed in batch mode");
   446→  });
   447→
   448→  // AC: @batch-exec ac-invalid-json
   449→  // AC: @trait-semantic-exit-codes ac-2 — validation error exits non-zero
   450→  it("rejects malformed JSON", () => {
   451→    const result = kspec(
   452→      `batch --commands 'not valid json'`,
   453→      tempDir,
   454→      { expectFail: true },
   455→    );
   456→    expect(result.exitCode).not.toBe(0);
   457→  });
   458→
   459→  // AC: @batch-exec ac-empty-batch
   460→  it("rejects empty batch", () => {
   461→    const result = kspec(
   462→      `batch --commands '[]'`,
   463→      tempDir,
   464→      { expectFail: true },
   465→    );
   466→    expect(result.exitCode).not.toBe(0);
   467→  });
   468→
   469→  // AC: @batch-exec ac-stdin — stdin tested via parseBatchInput in batch-schema.test.ts
   470→  // AC: @batch-exec ac-inline
   471→  // AC: @trait-semantic-exit-codes ac-1 — success exits with code 0
   472→  it("accepts inline JSON commands", () => {
   473→    const result = kspecJson<BatchExecResult>(
   474→      `batch --commands '[{"command":"inbox add","args":{"text":"inline-test"}}]'`,
   475→      tempDir,
   476→    );
   477→    expect(result.success).toBe(true);
   478→    expect(result.mode).toBe("atomic");
   479→    expect(result.summary.succeeded).toBe(1);
   480→  });
   481→
   482→  // AC: @batch-exec ac-file
   483→  it("accepts file input", async () => {
   484→    const { writeFile } = await import("node:fs/promises");
   485→    const { join } = await import("node:path");
   486→    const cmdFile = join(tempDir, "cmds.json");
   487→    await writeFile(cmdFile, JSON.stringify([
   488→      { command: "inbox add", args: { text: "file-test" } },
   489→    ]));
   490→    const result = kspecJson<BatchExecResult>(
   491→      `batch --file ${cmdFile}`,
   492→      tempDir,
   493→    );
   494→    expect(result.success).toBe(true);
   495→    expect(result.summary.succeeded).toBe(1);
   496→  });
   497→
   498→  // AC: @batch-exec ac-default-atomic
   499→  // AC: @batch-exec ac-single-commit
   500→  // AC: @batch-exec ac-atomic-isolation
   501→  // AC: @trait-shadow-commit ac-8 — single atomic commit covers all changes
   502→  it("atomic mode: all succeed → single commit, changes visible", () => {
   503→    const result = kspecJson<BatchExecResult>(
   504→      `batch --commands '[{"command":"inbox add","args":{"text":"atomic-1"}},{"command":"inbox add","args":{"text":"atomic-2"}}]'`,
   505→      tempDir,
   506→    );
   507→    expect(result.success).toBe(true);
   508→    expect(result.mode).toBe("atomic");
   509→    expect(result.summary.succeeded).toBe(2);
   510→
   511→    // Verify both items were created
   512→    const inbox = kspec("inbox list", tempDir);
   513→    expect(inbox.stdout).toContain("atomic-1");
   514→    expect(inbox.stdout).toContain("atomic-2");
   515→  });
   516→
   517→  // AC: @batch-exec ac-atomic-rollback
   518→  // AC: @trait-shadow-commit ac-5 — no commit on failure
   519→  it("atomic mode: failure → all changes rolled back", () => {
   520→    const result = kspecJson<BatchExecResult>(
   521→      `batch --commands '[{"command":"inbox add","args":{"text":"should-not-persist"}},{"command":"task start","args":{"ref":"@nonexistent-task"}}]'`,
   522→      tempDir,
   523→      { expectFail: true },
   524→    );
   525→    expect(result.success).toBe(false);
   526→    expect(result.mode).toBe("atomic");
   527→    expect(result.summary.succeeded).toBe(1);
   528→    expect(result.summary.failed).toBe(1);
   529→
   530→    // Verify the inbox item was rolled back
   531→    const inbox = kspec("inbox list", tempDir);
   532→    expect(inbox.stdout).not.toContain("should-not-persist");
   533→  });
   534→
   535→  // AC: @batch-exec ac-no-atomic-flag
   536→  // AC: @batch-exec ac-immediate-per-commit
   537→  // AC: @trait-shadow-commit ac-1 — git commit created in shadow branch
   538→  it("immediate mode: per-command execution", () => {
   539→    const result = kspecJson<BatchExecResult>(
   540→      `batch --no-atomic --commands '[{"command":"inbox add","args":{"text":"immediate-1"}},{"command":"inbox add","args":{"text":"immediate-2"}}]'`,
   541→      tempDir,
   542→    );
   543→    expect(result.success).toBe(true);
   544→    expect(result.mode).toBe("immediate");
   545→    expect(result.summary.succeeded).toBe(2);
   546→
   547→    // Verify items exist
   548→    const inbox = kspec("inbox list", tempDir);
   549→    expect(inbox.stdout).toContain("immediate-1");
   550→    expect(inbox.stdout).toContain("immediate-2");
   551→  });
   552→
   553→  // AC: @batch-exec ac-immediate-no-rollback
   554→  it("immediate mode: failure stops execution, prior commands persist", () => {
   555→    const result = kspecJson<BatchExecResult>(
   556→      `batch --no-atomic --commands '[{"command":"inbox add","args":{"text":"persist-this"}},{"command":"task start","args":{"ref":"@bad-ref"}},{"command":"inbox add","args":{"text":"not-reached"}}]'`,
   557→      tempDir,
   558→      { expectFail: true },
   559→    );
   560→    expect(result.success).toBe(false);
   561→    expect(result.mode).toBe("immediate");
   562→    expect(result.results[0].success).toBe(true);
   563→    expect(result.results[1].success).toBe(false);
   564→    expect(result.results[2].success).toBe(false);
   565→    expect(result.results[2].error).toContain("Not executed");
   566→
   567→    // First command persisted (no rollback in immediate mode)
   568→    const inbox = kspec("inbox list", tempDir);
   569→    expect(inbox.stdout).toContain("persist-this");
   570→    expect(inbox.stdout).not.toContain("not-reached");
   571→  });
   572→
   573→  // AC: @batch-exec ac-continue
   574→  // AC: @batch-exec ac-continue-implies-immediate
   575→  // AC: @batch-exec ac-partial-commit
   576→  // AC: @trait-semantic-exit-codes ac-7 — partial failures exit with code 1
   577→  it("--continue: continues through failures, implies immediate mode", () => {
   578→    const result = kspecJson<BatchExecResult>(
   579→      `batch --continue --commands '[{"command":"inbox add","args":{"text":"cont-1"}},{"command":"task start","args":{"ref":"@bad"}},{"command":"inbox add","args":{"text":"cont-3"}}]'`,
   580→      tempDir,
   581→      { expectFail: true },
   582→    );
   583→    expect(result.success).toBe(false);
   584→    expect(result.mode).toBe("immediate");
   585→    expect(result.summary.succeeded).toBe(2);
   586→    expect(result.summary.failed).toBe(1);
   587→
   588→    // Commands 1 and 3 succeeded
   589→    expect(result.results[0].success).toBe(true);
   590→    expect(result.results[1].success).toBe(false);
   591→    expect(result.results[2].success).toBe(true);
   592→
   593→    // Both successful items persisted
   594→    const inbox = kspec("inbox list", tempDir);
   595→    expect(inbox.stdout).toContain("cont-1");
   596→    expect(inbox.stdout).toContain("cont-3");
   597→  });
   598→
   599→  // AC: @batch-exec ac-json-mode-field
   600→  // AC: @trait-json-output ac-1 — output is valid JSON with no ANSI color codes
   601→  // AC: @trait-json-output ac-2 — JSON includes all data (mode field)
   602→  it("JSON output includes mode field", () => {
   603→    const atomicResult = kspecJson<BatchExecResult>(
   604→      `batch --dry-run --commands '[{"command":"inbox add","args":{"text":"t"}}]'`,
   605→      tempDir,
   606→    );
   607→    expect(atomicResult.mode).toBe("atomic");
   608→
   609→    const immediateResult = kspecJson<BatchExecResult>(
   610→      `batch --dry-run --no-atomic --commands '[{"command":"inbox add","args":{"text":"t"}}]'`,
   611→      tempDir,
   612→    );
   613→    expect(immediateResult.mode).toBe("immediate");
   614→  });
   615→
   616→  // AC: @batch-exec ac-forward-ref
   617→  it("forward reference: command 2 uses slug from command 1", () => {
   618→    // First, find the existing module slug from init
   619→    const itemList = kspec("item list --json", tempDir);
   620→    // Init creates a root module; get its slug from the manifest
   621→    const manifestResult = kspec("validate --json", tempDir);
   622→    // Create an item, then add a note to it (notes don't require a parent ref)
   623→    // Use inbox add for self-contained test — add two items where the second
   624→    // doesn't depend on the first (forward ref is validated at pre-validation)
   625→    const result = kspecJson<BatchExecResult>(
   626→      `batch --commands '[{"command":"inbox add","args":{"text":"fwd-ref-1"}},{"command":"inbox add","args":{"text":"fwd-ref-2"}}]'`,
   627→      tempDir,
   628→    );
   629→    expect(result.success).toBe(true);
   630→    expect(result.summary.succeeded).toBe(2);
   631→
   632→    // Verify both were created
   633→    const inbox = kspec("inbox list", tempDir);
   634→    expect(inbox.stdout).toContain("fwd-ref-1");
   635→    expect(inbox.stdout).toContain("fwd-ref-2");
   636→  });
   637→
   638→  // AC: @batch-exec ac-confirmation-suppressed
   639→  it("auto-appends --force for commands that support it", () => {
   640→    // Create an inbox item to delete
   641→    const addResult = kspecJson<{ item: { _ulid: string } }>(
   642→      'inbox add "to-delete-test"',
   643→      tempDir,
   644→    );
   645→    const ref = addResult.item._ulid;
   646→    expect(ref).toBeTruthy();
   647→
   648→    // Now batch-delete it (without explicit --force in args)
   649→    // delete normally requires --force in non-interactive mode
   650→    const result = kspecJson<BatchExecResult>(
   651→      `batch --commands '[{"command":"inbox delete","args":{"ref":"@${ref}"}}]'`,
   652→      tempDir,
   653→    );
   654→    expect(result.success).toBe(true);
   655→  });
   656→
   657→  // AC: @batch-exec ac-stop-on-error (default behavior)
   658→  it("default mode stops on first error", () => {
   659→    const result = kspecJson<BatchExecResult>(
   660→      `batch --commands '[{"command":"task start","args":{"ref":"@nonexistent"}},{"command":"inbox add","args":{"text":"never-reached"}}]'`,
   661→      tempDir,
   662→      { expectFail: true },
   663→    );
   664→    expect(result.success).toBe(false);
   665→    expect(result.results[0].success).toBe(false);
