```
     1→/**
     2→ * Plan import CLI command
     3→ * AC: @plan-import ac-11 through ac-33
     4→ */
     5→
     6→import * as fs from "node:fs/promises";
     7→import * as path from "node:path";
     8→import type { Command } from "commander";
     9→import { markMutating } from "../command-annotations.js";
    10→import {
    11→  addChildItem,
    12→  buildIndexes,
    13→  createPlan,
    14→  createSpecItem,
    15→  createTask,
    16→  getAuthor,
    17→  initContext,
    18→  loadAllTasks,
    19→  loadPlans,
    20→  savePlan,
    21→  saveTask,
    22→  updateSpecItem,
    23→  type LoadedSpecItem,
    24→} from "../../parser/index.js";
    25→import {
    26→  parsePlanDocument,
    27→  topologicalSort,
    28→  validateParentRefs,
    29→  type PlanSpec,
    30→} from "../../parser/plan-document.js";
    31→import { commitIfShadow } from "../../parser/shadow.js";
    32→import { normalizeRefInput } from "../../schema/index.js";
    33→import type { PlanInput, SpecItemInput, TaskInput } from "../../schema/index.js";
    34→import { errors } from "../../strings/index.js";
    35→import { EXIT_CODES } from "../exit-codes.js";
    36→import { error, info, isJsonMode, output, success, warn } from "../output.js";
    37→import { ulid } from "ulid";
    38→
    39→/**
    40→ * Register plan import command
    41→ * AC: @plan-import ac-11, ac-15, ac-32
    42→ */
    43→export function registerPlanImportCommand(planCommand: Command): void {
    44→  markMutating(planCommand.command("import <path>"))
    45→    .description("Import plan document and auto-generate specs/tasks")
    46→    .requiredOption(
    47→      "--module <ref>",
    48→      "Module to add specs under (e.g., @core-module)",
    49→    )
    50→    .option("--dry-run", "Show what would be created without making changes")
    51→    .option("--update", "Update existing specs instead of skipping them")
    52→    .option("--json", "Output as JSON")
    53→    .addHelpText(
    54→      "after",
    55→      `
    56→Format:
    57→  Plan documents use markdown with a ## Specs section containing a fenced
    58→  YAML code block. The YAML must be wrapped in triple-backtick yaml markers:
    59→
    60→    ## Specs
    61→    \`\`\`yaml
    62→    - title: My Feature
    63→      type: feature
    64→    \`\`\`
    65→
    66→  Without the fenced code block, specs will not be detected.
    67→
    68→Examples:
    69→  $ kspec plan import ./plan.md --module @core
    70→  $ kspec plan import ./plan.md --module @api --dry-run
    71→  $ kspec plan import ./plan.md --module @features --update --json`,
    72→    )
    73→    .action(async (planPath: string, options) => {
    74→      try {
    75→        await importPlan(planPath, options);
    76→      } catch (err) {
    77→        error("Failed to import plan", err);
    78→        process.exit(EXIT_CODES.ERROR);
    79→      }
    80→    });
    81→}
    82→
    83→/**
    84→ * Import operation result
    85→ */
    86→interface ImportResult {
    87→  createdSpecs: string[];
    88→  updatedSpecs: string[];
    89→  createdTasks: string[];
    90→  errors: Array<{ message: string; spec?: PlanSpec }>;
    91→  skipped: Array<{ slug: string; reason: string }>;
    92→  planRef: string;
    93→}
    94→
    95→/**
    96→ * Import plan document and create specs/tasks
    97→ * AC: @plan-import ac-11 through ac-33
    98→ */
    99→async function importPlan(
   100→  planPath: string,
   101→  options: { module: string; dryRun?: boolean; update?: boolean },
   102→): Promise<void> {
   103→  // JSON mode is set by global preAction hook
   104→
   105→  const ctx = await initContext();
   106→  const author = getAuthor(ctx.config?.identity?.author);
   107→
   108→  // Read plan file
   109→  // AC: @plan-import ac-21 - Handle file read errors
   110→  const fullPath = path.resolve(process.cwd(), planPath);
   111→  let content: string;
   112→  try {
   113→    content = await fs.readFile(fullPath, "utf-8");
   114→  } catch (err) {
   115→    error(`Failed to read plan file: ${planPath}`, err);
   116→    process.exit(EXIT_CODES.USAGE_ERROR);
   117→  }
   118→
   119→  // Parse plan document
   120→  // AC: @plan-import ac-11, ac-12, ac-13, ac-21, ac-22
   121→  const parsed = parsePlanDocument(content);
   122→
   123→  // Report parsing errors
   124→  if (parsed.errors.length > 0) {
   125→    for (const err of parsed.errors) {
   126→      if (err.type === "yaml") {
   127→        // AC: @plan-import ac-21 - YAML parse errors (fatal)
   128→        error(err.message);
   129→        process.exit(EXIT_CODES.USAGE_ERROR);
   130→      } else if (err.type === "validation") {
   131→        // AC: @plan-import ac-22 - Validation errors (non-fatal, add to warnings)
   132→        warn(err.message);
   133→      }
   134→    }
   135→  }
   136→
   137→  // Load plans for cross-namespace slug safety
   138→  const plans = await loadPlans(ctx);
   139→
   140→  // Build indexes to check existing specs (include plans for cross-namespace slug safety)
   141→  const { refIndex, items } = await buildIndexes(ctx, plans);
   142→  const existingSpecRefs = new Set<string>();
   143→  for (const item of items) {
   144→    for (const slug of (item as LoadedSpecItem).slugs || []) {
   145→      existingSpecRefs.add(slug);
   146→    }
   147→    existingSpecRefs.add(item._ulid.slice(0, 8));
   148→  }
   149→
   150→  // Resolve module reference
   151→  const moduleResult = refIndex.resolve(options.module);
   152→  if (!moduleResult.ok) {
   153→    error(errors.reference.itemNotFound(options.module));
   154→    process.exit(EXIT_CODES.NOT_FOUND);
   155→  }
   156→
   157→  const moduleItem = moduleResult.item as LoadedSpecItem;
   158→
   159→  // Verify it's a module
   160→  if (moduleItem.type !== "module") {
   161→    error(`${options.module} is not a module (type: ${moduleItem.type})`);
   162→    process.exit(EXIT_CODES.USAGE_ERROR);
   163→  }
   164→
   165→  // Validate parent references
   166→  // AC: @plan-import ac-17, ac-33
   167→  const parentErrors = validateParentRefs(parsed.specs, existingSpecRefs);
   168→  parsed.errors.push(...parentErrors);
   169→
   170→  // Sort specs topologically
   171→  // AC: @plan-import ac-16, ac-18
   172→  const { sorted, error: sortError } = topologicalSort(parsed.specs);
   173→  if (sortError) {
   174→    // AC: @plan-import ac-18 - Circular dependency detection
   175→    error(sortError.message);
   176→    process.exit(EXIT_CODES.USAGE_ERROR);
   177→  }
   178→
   179→  // Create plan record
   180→  // AC: @plan-import ac-24, ac-28
   181→  // Auto-namespace plan slugs with "plan-" prefix to prevent collision with spec slugs
   182→  // Ensure uniqueness across all namespaces (plans + specs + tasks via refIndex)
   183→  let planSlug = `plan-${generateSlug(parsed.title)}`;
   184→  let counter = 1;
   185→  const baseSlug = planSlug;
   186→  while (!refIndex.isSlugAvailable(planSlug)) {
   187→    planSlug = `${baseSlug}-${counter}`;
   188→    counter++;
   189→  }
   190→
   191→  // Track all slugs created during this import (refIndex is stale after mutations)
   192→  const importReservedSlugs = new Set<string>([planSlug]);
   193→
   194→  const planInput: PlanInput = {
   195→    title: parsed.title,
   196→    content: parsed.content,
   197→    status: "active",
   198→    slugs: [planSlug],
   199→    source_path: fullPath,
   200→  };
   201→
   202→  const newPlan = createPlan(planInput);
   203→  const planRef = `@${planSlug}`;
   204→
   205→  // AC: @plan-import ac-13 - Attach global implementation notes to plan record
   206→  if (parsed.implementationNotes) {
   207→    newPlan.notes.push({
   208→      _ulid: ulid(),
   209→      created_at: new Date().toISOString(),
   210→      author,
   211→      content: `Implementation notes:\n\n${parsed.implementationNotes}`,
   212→    });
   213→  }
   214→
   215→  // Initialize result
   216→  const result: ImportResult = {
   217→    createdSpecs: [],
   218→    updatedSpecs: [],
   219→    createdTasks: [],
   220→    errors: [],
   221→    skipped: [],
   222→    planRef,
   223→  };
   224→
   225→  // Add parser validation errors to result
   226→  // AC: @plan-import ac-22, ac-29 - Include parser validation errors in summary
   227→  for (const err of parsed.errors) {
   228→    if (err.type === "validation") {
   229→      result.errors.push({ message: err.message });
   230→    }
   231→  }
   232→
   233→  // Track newly created specs for parent resolution
   234→  // AC: @plan-import ac-16 - Resolve local references
   235→  const createdSpecsMap = new Map<string, LoadedSpecItem>();
   236→
   237→  // Process specs
   238→  // AC: @plan-import ac-14, ac-16, ac-17, ac-22, ac-23, ac-25, ac-26, ac-29
   239→  for (let i = 0; i < sorted.length; i++) {
   240→    const spec = sorted[i];
   241→    try {
   242→      // Validate required fields first
   243→      // AC: @plan-import ac-22
   244→      if (!spec.title) {
   245→        const errMsg = `Spec at index ${i} missing required field: title`;
   246→        warn(errMsg);
   247→        result.errors.push({ message: errMsg, spec });
   248→        continue;
   249→      }
   250→
   251→      const specSlug = spec.slug || generateSlug(spec.title);
   252→      const specRef = `@${specSlug}`;
   253→
   254→      // Check against slugs reserved during this import (plan slug, earlier specs)
   255→      if (importReservedSlugs.has(specSlug)) {
   256→        warn(`Spec slug "${specSlug}" collides with another item in this import, skipping`);
   257→        result.skipped.push({ slug: specSlug, reason: "Slug collision within import" });
   258→        continue;
   259→      }
   260→
   261→      // Check if spec already exists in pre-import state
   262→      const exists = refIndex.resolve(specRef);
   263→
   264→      if (exists.ok && !options.update) {
   265→        // AC: @plan-import ac-14, ac-25 - Skip existing specs
   266→        warn(`Skipping existing spec: ${specRef}`);
   267→        result.skipped.push({ slug: specSlug, reason: "Already exists" });
   268→        continue;
   269→      }
   270→
   271→      if (exists.ok && options.update) {
   272→        // AC: @plan-import ac-26 - Update existing spec
   273→        // Updates: description, type, tags, traits, and acceptance_criteria
   274→        const existingSpec = exists.item as LoadedSpecItem;
   275→
   276→        if (options.dryRun) {
   277→          info(`Would update spec: ${specRef}`);
   278→          result.updatedSpecs.push(specRef);
   279→        } else {
   280→          // Build updates from plan spec
   281→          const updates: Partial<SpecItemInput> = {};
   282→
   283→          if (spec.description !== undefined) {
   284→            updates.description = spec.description;
   285→          }
   286→          if (spec.type !== undefined) {
   287→            updates.type = spec.type as SpecItemInput["type"];
   288→          }
   289→          if (spec.traits !== undefined) {
   290→            updates.traits = spec.traits.map(normalizeRefInput);
   291→          }
   292→          if (spec.acceptance_criteria !== undefined) {
   293→            updates.acceptance_criteria = spec.acceptance_criteria;
   294→          }
   295→
   296→          await updateSpecItem(ctx, existingSpec, updates);
   297→          info(`Updated spec: ${specRef}`);
   298→          result.updatedSpecs.push(specRef);
   299→        }
   300→        continue;
   301→      }
   302→
   303→      // Resolve parent reference
   304→      // AC: @plan-import ac-16, ac-17
   305→      let parent: LoadedSpecItem | null = null;
   306→      if (spec.parent) {
   307→        const parentRef = normalizeRefInput(spec.parent);
   308→
   309→        // Check if parent was just created in this import
   310→        const parentSlug = parentRef.slice(1);
   311→        if (createdSpecsMap.has(parentSlug)) {
   312→          parent = createdSpecsMap.get(parentSlug)!;
   313→        } else {
   314→          // Check existing specs
   315→          const parentResult = refIndex.resolve(parentRef);
   316→
   317→          if (!parentResult.ok) {
   318→            // AC: @plan-import ac-17, ac-33 - Missing parent with hint
   319→            const errMsg = `Parent ${parentRef} not found. Check parent exists or define it earlier in plan`;
   320→            warn(errMsg);
   321→            result.errors.push({ message: errMsg, spec });
   322→            result.skipped.push({ slug: specSlug, reason: "Missing parent" });
   323→            continue;
   324→          }
   325→
   326→          parent = parentResult.item as LoadedSpecItem;
   327→        }
   328→      }
   329→
   330→      // Determine if this is a root-level trait (type: trait with no parent)
   331→      const isRootTrait = (spec.type === "trait") && !parent;
   332→
   333→      if (options.dryRun) {
   334→        // AC: @plan-import ac-15 - Dry run mode
   335→        info(
   336→          `Would create spec: ${specRef} ${spec.parent ? `under ${spec.parent}` : isRootTrait ? "(project-level trait)" : "(root)"}`,
   337→        );
   338→        result.createdSpecs.push(specRef);
   339→        importReservedSlugs.add(specSlug);
   340→
   341→        // Track would-be created spec for parent resolution in dry-run
   342→        const dryRunSpec = createSpecItem({
   343→          title: spec.title,
   344→          type: (spec.type as any) || "feature",
   345→          slugs: [specSlug],
   346→          description: spec.description,
   347→          ...(spec.acceptance_criteria ? { acceptance_criteria: spec.acceptance_criteria } : {}),
   348→          priority: undefined,
   349→          tags: [],
   350→          depends_on: [],
   351→          implements: [],
   352→          relates_to: [],
   353→          tests: [],
   354→          traits: (spec.traits || []).map(normalizeRefInput),
   355→          notes: [],
   356→        }) as LoadedSpecItem;
   357→        createdSpecsMap.set(specSlug, dryRunSpec);
   358→      } else {
   359→        // Create spec item
   360→        const specInput: SpecItemInput = {
   361→          title: spec.title,
   362→          type: (spec.type as any) || "feature",
   363→          slugs: [specSlug],
   364→          description: spec.description,
   365→          priority: undefined,
   366→          tags: [],
   367→          depends_on: [],
   368→          implements: [],
   369→          relates_to: [],
   370→          tests: [],
   371→          traits: (spec.traits || []).map(normalizeRefInput),
   372→          notes: [],
   373→        };
   374→
   375→        // Add acceptance criteria if present
   376→        if (spec.acceptance_criteria) {
   377→          specInput.acceptance_criteria = spec.acceptance_criteria;
   378→        }
   379→
   380→        const newSpec = createSpecItem(specInput);
   381→
   382→        if (isRootTrait) {
   383→          // Traits without a parent go to kynetic.yaml project-level traits array,
   384→          // not the module-level traits array (same logic as `kspec trait add`)
   385→          if (!ctx.manifestPath) {
   386→            throw new Error("Could not find kynetic.yaml");
   387→          }
   388→
   389→          const { readYamlFile, writeYamlFilePreserveFormat } = await import(
   390→            "../../parser/yaml.js"
   391→          );
   392→          const manifest = await readYamlFile<Record<string, unknown>>(
   393→            ctx.manifestPath,
   394→          );
   395→
   396→          if (!manifest) {
   397→            throw new Error("Could not load kynetic.yaml");
   398→          }
   399→
   400→          // Ensure traits array exists at root
   401→          if (!Array.isArray(manifest.traits)) {
   402→            manifest.traits = [];
   403→          }
   404→
   405→          // Strip metadata from newSpec (_sourceFile, _path)
   406→          const { _sourceFile, _path, ...cleanItem } = newSpec as LoadedSpecItem;
   407→          (manifest.traits as unknown[]).push(cleanItem);
   408→          await writeYamlFilePreserveFormat(ctx.manifestPath, manifest);
   409→
   410→          const traitIndex = (manifest.traits as unknown[]).length - 1;
   411→          const createdSpec: LoadedSpecItem = {
   412→            ...newSpec,
   413→            _sourceFile: ctx.manifestPath,
   414→            _path: `traits[${traitIndex}]`,
   415→          } as LoadedSpecItem;
   416→          createdSpecsMap.set(specSlug, createdSpec);
   417→        } else {
   418→          // Add spec to parent (or module if no parent)
   419→          const actualParent = parent || moduleItem;
   420→          const addResult = await addChildItem(ctx, actualParent, newSpec);
   421→
   422→          // Track the created spec for parent resolution
   423→          // Need to construct LoadedSpecItem with _sourceFile and _path for nested specs
   424→          const createdSpec: LoadedSpecItem = {
   425→            ...(addResult.item as LoadedSpecItem),
   426→            _sourceFile: actualParent._sourceFile,
   427→            _path: addResult.path,
   428→          };
   429→          createdSpecsMap.set(specSlug, createdSpec);
   430→        }
   431→
   432→        result.createdSpecs.push(specRef);
   433→        importReservedSlugs.add(specSlug);
   434→        newPlan.derived_specs.push(specRef);
   435→
   436→        info(`Created spec: ${specRef}`);
   437→      }
   438→    } catch (err) {
   439→      const errMsg = `Failed to create spec "${spec.title}": ${err instanceof Error ? err.message : String(err)}`;
   440→      warn(errMsg);
   441→      result.errors.push({ message: errMsg, spec });
   442→    }
   443→  }
   444→
   445→  // Derive tasks from specs
   446→  // AC: @plan-import ac-12, ac-13, ac-19, ac-20
   447→  if (parsed.tasks.derive_from_specs && result.createdSpecs.length > 0) {
   448→    const tasks = await loadAllTasks(ctx);
   449→    // Combine existing task slugs + all slugs reserved during this import (plan + specs)
   450→    const importSlugs = new Set([
   451→      ...tasks.flatMap((t) => t.slugs),
   452→      ...importReservedSlugs,
   453→    ]);
   454→
   455→    for (const specRef of result.createdSpecs) {
   456→      // Get spec from createdSpecsMap (works in both dry-run and real mode)
   457→      const specSlug = specRef.slice(1);
   458→      const spec = createdSpecsMap.get(specSlug);
   459→      if (!spec) continue;
   460→
   461→      // AC: @plan-import ac-20 - Task title follows "Implement X" pattern
   462→      const taskTitle = `Implement ${spec.title}`;
   463→      const taskSlug = generateSlug(taskTitle);
   464→
   465→      // Ensure slug uniqueness across all namespaces + this import's slugs
   466→      let uniqueSlug = taskSlug;
   467→      let counter = 1;
   468→      while (importSlugs.has(uniqueSlug) || !refIndex.isSlugAvailable(uniqueSlug)) {
   469→        uniqueSlug = `${taskSlug}-${counter}`;
   470→        counter++;
   471→      }
   472→      importSlugs.add(uniqueSlug);
   473→      importReservedSlugs.add(uniqueSlug);
   474→
   475→      if (options.dryRun) {
   476→        info(`Would derive task: @${uniqueSlug} from ${specRef}`);
   477→        result.createdTasks.push(`@${uniqueSlug}`);
   478→      } else {
   479→        // AC: @plan-import ac-19 - Task has both spec_ref and plan_ref
   480→        const taskInput: TaskInput = {
   481→          title: taskTitle,
   482→          type: "task",
   483→          spec_ref: specRef,
   484→          plan_ref: planRef,
   485→          priority: 3,
   486→          slugs: [uniqueSlug],
   487→          tags: [],
   488→          depends_on: [],
   489→          notes: [],
   490→        };
   491→
   492→        const newTask = createTask(taskInput);
   493→
   494→        // AC: @plan-import ac-13 - Scoped implementation notes
   495→        const planSpec = parsed.specs.find(s =>
   496→          (s.slug || generateSlug(s.title)) === specSlug
   497→        );
   498→        if (planSpec?.implementation_notes) {
   499→          // Per-spec notes go directly to this task
   500→          newTask.notes.push({
   501→            _ulid: ulid(),
   502→            created_at: new Date().toISOString(),
   503→            author,
   504→            content: `Implementation notes:\n\n${planSpec.implementation_notes}`,
   505→          });
   506→        } else if (parsed.implementationNotes) {
   507→          // No per-spec notes — reference the plan
   508→          newTask.notes.push({
   509→            _ulid: ulid(),
   510→            created_at: new Date().toISOString(),
   511→            author,
   512→            content: `See plan ${planRef} for implementation notes`,
   513→          });
   514→        }
   515→
   516→        await saveTask(ctx, newTask);
   517→        result.createdTasks.push(`@${uniqueSlug}`);
   518→        newPlan.derived_tasks.push(`@${uniqueSlug}`);
   519→
   520→        info(`Derived task: @${uniqueSlug}`);
   521→      }
   522→    }
   523→  }
   524→
   525→  // Create manual tasks
   526→  // AC: @plan-import ac-27
   527→  if (parsed.tasks.additional_tasks) {
   528→    // Reload tasks to catch any created by derive loop above
   529→    // Combine with all slugs reserved during this import (plan + specs)
   530→    const manualTasks = await loadAllTasks(ctx);
   531→    const manualImportSlugs = new Set([
   532→      ...manualTasks.flatMap((t) => t.slugs),
   533→      ...importReservedSlugs,
   534→    ]);
   535→
   536→    for (const taskDef of parsed.tasks.additional_tasks) {
   537→      const taskSlug = taskDef.slug || generateSlug(taskDef.title);
   538→
   539→      // Ensure slug uniqueness across all namespaces + this import's slugs
   540→      let uniqueSlug = taskSlug;
   541→      let counter = 1;
   542→      while (manualImportSlugs.has(uniqueSlug) || !refIndex.isSlugAvailable(uniqueSlug)) {
   543→        uniqueSlug = `${taskSlug}-${counter}`;
   544→        counter++;
   545→      }
   546→      manualImportSlugs.add(uniqueSlug);
   547→
   548→      if (options.dryRun) {
   549→        info(`Would create manual task: @${uniqueSlug}`);
   550→        result.createdTasks.push(`@${uniqueSlug}`);
   551→      } else {
   552→        // AC: @plan-import ac-27 - Manual tasks have plan_ref; spec_ref honored if provided
   553→        const taskInput: TaskInput = {
   554→          title: taskDef.title,
   555→          type: "task",
   556→          plan_ref: planRef,
   557→          priority: taskDef.priority || 3,
   558→          slugs: [uniqueSlug],
   559→          tags: taskDef.tags || [],
   560→          depends_on: [],
   561→          notes: [],
   562→          ...(taskDef.spec_ref ? { spec_ref: normalizeRefInput(taskDef.spec_ref) } : {}),
   563→        };
   564→
   565→        if (taskDef.description) {
   566→          taskInput.notes = [
   567→            {
   568→              _ulid: ulid(),
   569→              created_at: new Date().toISOString(),
   570→              author,
   571→              content: taskDef.description,
   572→            },
   573→          ];
   574→        }
   575→
   576→        const newTask = createTask(taskInput);
   577→        await saveTask(ctx, newTask);
   578→        result.createdTasks.push(`@${uniqueSlug}`);
   579→        newPlan.derived_tasks.push(`@${uniqueSlug}`);
   580→
   581→        info(`Created manual task: @${uniqueSlug}`);
   582→      }
   583→    }
   584→  }
   585→
   586→  // Save plan record
   587→  // AC: @plan-import ac-24
   588→  if (!options.dryRun) {
   589→    await savePlan(ctx, newPlan);
   590→    await commitIfShadow(ctx.shadow, "plan-import", planSlug, parsed.title);
   591→  }
   592→
   593→  // AC: @plan-import ac-23, ac-29 - Summary output
   594→  const successCount =
   595→    result.createdSpecs.length +
   596→    result.updatedSpecs.length +
   597→    result.createdTasks.length;
   598→  const errorCount = result.errors.length + result.skipped.length;
   599→
   600→  // AC: @plan-import ac-32 - JSON output
   601→  if (isJsonMode()) {
   602→    output({
   603→      plan: planRef,
   604→      created_specs: result.createdSpecs,
   605→      updated_specs: result.updatedSpecs,
   606→      created_tasks: result.createdTasks,
   607→      errors: result.errors,
   608→      skipped: result.skipped,
   609→    });
   610→  } else {
   611→    // Human-readable output
   612→    if (options.dryRun) {
   613→      console.log("\nDry run - no changes made\n");
   614→    }
   615→
   616→    console.log(`Plan: ${planRef}`);
   617→    console.log(`Created ${result.createdSpecs.length} specs`);
   618→    if (result.updatedSpecs.length > 0) {
   619→      console.log(`Updated ${result.updatedSpecs.length} specs`);
   620→    }
   621→    console.log(`Created ${result.createdTasks.length} tasks`);
   622→
   623→    if (result.errors.length > 0) {
   624→      console.log(`\nErrors (${result.errors.length}):`);
   625→      for (const err of result.errors) {
   626→        console.log(`  - ${err.message}`);
   627→      }
   628→    }
   629→
   630→    if (result.skipped.length > 0) {
   631→      console.log(`\nSkipped (${result.skipped.length}):`);
   632→      for (const skip of result.skipped) {
   633→        console.log(`  - @${skip.slug}: ${skip.reason}`);
   634→      }
   635→    }
   636→
   637→    // AC: @plan-import ac-15, ac-23 - Exit code 0 on success
   638→    if (!options.dryRun && successCount > 0) {
   639→      success(
   640→        `\nImported plan: ${successCount} items created, ${errorCount} errors`,
   641→      );
   642→    }
   643→  }  // end of else block (non-JSON output)
   644→
   645→  // Exit code logic
   646→  // AC: @plan-import ac-15 - Dry run exits 0
   647→  // AC: @plan-import ac-23 - Success with some errors still exits 0
   648→  process.exit(EXIT_CODES.SUCCESS);
   649→}
   650→
   651→/**
   652→ * Generate URL-safe slug from title
   653→ */
   654→function generateSlug(title: string): string {
   655→  return title
   656→    .toLowerCase()
   657→    .replace(/[^a-z0-9]+/g, "-")
   658→    .replace(/^-|-$/g, "")
   659→    .slice(0, 50);
   660→}
   661→
```