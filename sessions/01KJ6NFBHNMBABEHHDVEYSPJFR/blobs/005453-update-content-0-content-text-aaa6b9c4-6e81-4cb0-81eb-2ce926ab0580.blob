  1300→      "item get @dependent-feature --json",
  1301→      tempDir,
  1302→    );
  1303→    expect(depSpec.depends_on).toContain("@base-feature");
  1304→  });
  1305→
  1306→  // AC: @plan-import ac-35 - derived tasks inherit depends_on mapped from spec slugs to task slugs
  1307→  it("should map spec depends_on to derived task depends_on using task slugs", async () => {
  1308→    const planPath = path.join(tempDir, "task-depends-plan.md");
  1309→    await fs.writeFile(
  1310→      planPath,
  1311→      `# Task Depends Plan
  1312→
  1313→## Specs
  1314→
  1315→\`\`\`yaml
  1316→- title: Foundation
  1317→  slug: foundation
  1318→  type: feature
  1319→
  1320→- title: Building Block
  1321→  slug: building-block
  1322→  type: feature
  1323→  depends_on:
  1324→    - foundation
  1325→\`\`\`
  1326→
  1327→## Tasks
  1328→
  1329→derive_from_specs: true
  1330→`,
  1331→    );
  1332→
  1333→    kspec(`plan import "${planPath}" --module @test-core`, tempDir);
  1334→
  1335→    const allTasks = kspecJson<
  1336→      Array<{ title: string; depends_on: string[]; plan_ref: string }>
  1337→    >("task list --json", tempDir);
  1338→    const tasks = allTasks.filter(t => t.plan_ref === "@plan-task-depends-plan");
  1339→
  1340→    expect(tasks).toHaveLength(2);
  1341→
  1342→    const foundationTask = tasks.find(t => t.title === "Implement Foundation");
  1343→    const buildingTask = tasks.find(t => t.title === "Implement Building Block");
  1344→
  1345→    expect(foundationTask).toBeDefined();
  1346→    expect(foundationTask!.depends_on).toEqual([]);
  1347→
  1348→    expect(buildingTask).toBeDefined();
  1349→    // The depends_on should reference the derived task slug, not the spec slug
  1350→    expect(buildingTask!.depends_on.length).toBe(1);
  1351→    expect(buildingTask!.depends_on[0]).toContain("implement-foundation");
  1352→  });
