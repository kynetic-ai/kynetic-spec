   973→    expect(planRecord.notes[0].content).toContain("Follow existing patterns");
   974→
   975→    // Verify derived tasks reference the plan (no per-spec notes in this plan)
   976→    const tasks = kspecJson<Array<{ notes: Array<{ content: string }>; plan_ref: string }>>(
