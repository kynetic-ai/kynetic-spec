   634→  // AC: @plan-import ac-26 - Verify acceptance criteria are updated
   635→  it("should update acceptance criteria on existing specs with --update flag", async () => {
   636→    // Create initial spec with ACs
   637→    kspec('item add --under @test-core --title "Feature" --slug ac-feature', tempDir);
   638→    kspec('item ac add @ac-feature --given "initial" --when "test" --then "pass"', tempDir);
   639→
   640→    // Verify initial AC exists
   641→    const beforeSpec = kspecJson<{
   642→      acceptance_criteria: Array<{ id: string; given: string; when: string; then: string }>;
   643→    }>("item get @ac-feature --json", tempDir);
   644→    expect(beforeSpec.acceptance_criteria).toHaveLength(1);
