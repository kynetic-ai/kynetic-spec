  1271→      `# Depends On Plan
  1272→
  1273→## Specs
  1274→
  1275→\`\`\`yaml
  1276→- title: Base Feature
  1277→  slug: base-feature
  1278→  type: feature
  1279→
  1280→- title: Dependent Feature
  1281→  slug: dependent-feature
  1282→  type: feature
  1283→  depends_on:
  1284→    - base-feature
  1285→\`\`\`
  1286→`,
  1287→    );
  1288→
  1289→    kspec(`plan import "${planPath}" --module @test-core`, tempDir);
  1290→
  1291→    // Base spec should have no depends_on
