  1466→  // AC: @plan-import ac-35 - mixed import: new spec depends on existing spec with existing task
  1467→  it("should resolve depends_on to existing task ref when spec already exists", async () => {
  1468→    // Create an existing spec and derive a task from it
  1469→    kspec('item add --under @test-core --title "Existing Base" --slug existing-base', tempDir);
  1470→    kspec("derive @existing-base", tempDir);
  1471→
  1472→    // Find the derived task slug
  1473→    const allTasks = kspecJson<Array<{ title: string; spec_ref: string; slugs: string[] }>>(
  1474→      "task list --json",
  1475→      tempDir,
  1476→    );
  1477→    const existingTask = allTasks.find(t => t.spec_ref === "@existing-base");
  1478→    expect(existingTask).toBeDefined();
  1479→    const existingTaskSlug = existingTask!.slugs[0];
  1480→
  1481→    // Import a plan with a new spec that depends on the existing spec
  1482→    const planPath = path.join(tempDir, "mixed-depends-plan.md");
  1483→    await fs.writeFile(
  1484→      planPath,
  1485→      `# Mixed Depends Plan
  1486→
  1487→## Specs
  1488→
  1489→\`\`\`yaml
  1490→- title: New Feature
  1491→  slug: new-feature
  1492→  type: feature
  1493→  depends_on:
  1494→    - existing-base
  1495→\`\`\`
  1496→
  1497→## Tasks
  1498→
  1499→derive_from_specs: true
  1500→`,
  1501→    );
  1502→
  1503→    kspec(`plan import "${planPath}" --module @test-core`, tempDir);
  1504→
  1505→    // The derived task for new-feature should depend on the existing task, not the spec
  1506→    const updatedTasks = kspecJson<
  1507→      Array<{ title: string; depends_on: string[]; plan_ref: string }>
  1508→    >("task list --json", tempDir);
  1509→    const newTask = updatedTasks.find(t => t.title === "Implement New Feature");
  1510→
  1511→    expect(newTask).toBeDefined();
  1512→    expect(newTask!.depends_on.length).toBe(1);
  1513→    expect(newTask!.depends_on[0]).toBe(`@${existingTaskSlug}`);
  1514→  });
  1515→});
  1516→
