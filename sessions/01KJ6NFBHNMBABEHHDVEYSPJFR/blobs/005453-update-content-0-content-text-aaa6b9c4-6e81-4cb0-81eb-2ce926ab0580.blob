   359→  // AC: @plan-import ac-16
   360→  it("should create specs in topological order (parents before children)", async () => {
   361→    const planPath = path.join(tempDir, "test-plan.md");
   362→    await fs.writeFile(
   363→      planPath,
   364→      `# Test Plan
   365→
   366→## Specs
   367→
   368→\`\`\`yaml
   369→- title: Child Feature
   370→  slug: child-feature
   371→  type: feature
   372→  parent: parent-feature
   373→
   374→- title: Parent Feature
   375→  slug: parent-feature
   376→  type: feature
   377→\`\`\`
   378→`,
   379→    );
   380→
   381→    const output = kspec(
   382→      `plan import "${planPath}" --module @test-core --dry-run`,
   383→      tempDir,
   384→    );
   385→
   386→    // Parent should appear before child in output
   387→    const parentIndex = output.indexOf("@parent-feature");
   388→    const childIndex = output.indexOf("@child-feature");
   389→    expect(parentIndex).toBeGreaterThan(0);
   390→    expect(childIndex).toBeGreaterThan(parentIndex);
   391→  });
