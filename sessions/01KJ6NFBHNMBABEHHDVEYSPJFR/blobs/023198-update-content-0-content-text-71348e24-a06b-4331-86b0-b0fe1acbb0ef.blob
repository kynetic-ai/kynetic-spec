  2217→          } else {
  2218→            for (const todo of foundTask.todos) {
  2219→              const status = todo.done ? "[x]" : "[ ]";
  2220→              const doneInfo =
  2221→                todo.done && todo.done_at ? ` (done ${todo.done_at})` : "";
  2222→              console.log(`${status} ${todo.id}. ${todo.text}${doneInfo}`);
  2223→            }
  2224→          }
  2225→        });
  2226→      } catch (err) {
