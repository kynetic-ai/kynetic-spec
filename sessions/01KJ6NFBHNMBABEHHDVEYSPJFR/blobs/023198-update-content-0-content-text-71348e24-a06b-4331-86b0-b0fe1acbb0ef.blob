  2024→  // kspec task review <ref>
  2025→  task
  2026→    .command("review <ref>")
  2027→    .description(
  2028→      "Get task context for review (task details, spec, ACs, git diff)",
  2029→    )
  2030→    .action(async (ref: string) => {
  2031→      try {
  2032→        const ctx = await initContext();
  2033→        const tasks = await loadAllTasks(ctx);
  2034→        const items = await loadAllItems(ctx);
  2035→        const index = new ReferenceIndex(tasks, items);
  2036→        const foundTask = resolveTaskRef(ref, tasks, index);
  2037→
  2038→        // Import getDiffSince from utils
  2039→        const { getDiffSince } = await import("../../utils/index.js");
  2040→
  2041→        // Gather review context
  2042→        const reviewContext: {
  2043→          task: typeof foundTask;
  2044→          spec: LoadedSpecItem | null;
  2045→          diff: string | null;
  2046→          started_at: string | null;
  2047→          testCoverage?: { covered: string[]; uncovered: string[] };
  2048→        } = {
  2049→          task: foundTask,
  2050→          spec: null,
  2051→          diff: null,
  2052→          started_at: foundTask.started_at || null,
  2053→        };
  2054→
  2055→        // Get spec item if task has spec_ref
  2056→        if (foundTask.spec_ref) {
  2057→          const specResult = index.resolve(foundTask.spec_ref);
  2058→          if (specResult.ok) {
  2059→            const specItem = items.find((i) => i._ulid === specResult.ulid);
  2060→            reviewContext.spec = specItem || null;
  2061→
  2062→            // Check test coverage for ACs if spec has them
  2063→            if (
  2064→              specItem?.acceptance_criteria &&
  2065→              specItem.acceptance_criteria.length > 0
  2066→            ) {
  2067→              const coveredACs = await scanTestCoverage(ctx.rootDir);
  2068→              const covered: string[] = [];
  2069→              const uncovered: string[] = [];
  2070→
  2071→              for (const ac of specItem.acceptance_criteria) {
  2072→                // Build possible references
  2073→                const possibleRefs: string[] = [];
  2074→                if (specItem.slugs && specItem.slugs.length > 0) {
  2075→                  possibleRefs.push(`@${specItem.slugs[0]} ${ac.id}`);
  2076→                  possibleRefs.push(`@${specItem.slugs[0]}`);
  2077→                }
  2078→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)} ${ac.id}`);
  2079→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)}`);
  2080→
  2081→                const isCovered = possibleRefs.some((ref) =>
  2082→                  coveredACs.has(ref),
  2083→                );
  2084→                if (isCovered) {
  2085→                  covered.push(ac.id);
  2086→                } else {
  2087→                  uncovered.push(ac.id);
  2088→                }
  2089→              }
  2090→
  2091→              reviewContext.testCoverage = { covered, uncovered };
  2092→            }
  2093→          }
  2094→        }
  2095→
  2096→        // Get git diff since task started
  2097→        if (foundTask.started_at) {
  2098→          const startedDate = new Date(foundTask.started_at);
  2099→          reviewContext.diff = getDiffSince(startedDate, ctx.rootDir);
  2100→        }
  2101→
  2102→        output(reviewContext, () => {
  2103→          console.log("=".repeat(60));
  2104→          console.log("Task Review Context");
  2105→          console.log("=".repeat(60));
  2106→          console.log();
  2107→
  2108→          // Task details
  2109→          console.log("TASK DETAILS");
  2110→          console.log("-".repeat(60));
  2111→          console.log(formatTaskDetails(foundTask, index));
  2112→          console.log();
  2113→
  2114→          // Spec details
  2115→          if (reviewContext.spec) {
  2116→            console.log("LINKED SPEC");
  2117→            console.log("-".repeat(60));
  2118→            console.log(`Title: ${reviewContext.spec.title}`);
  2119→            console.log(`Type: ${reviewContext.spec.type}`);
  2120→            if (reviewContext.spec.description) {
  2121→              console.log(`\nDescription:\n${reviewContext.spec.description}`);
  2122→            }
  2123→            if (
  2124→              reviewContext.spec.acceptance_criteria &&
  2125→              reviewContext.spec.acceptance_criteria.length > 0
  2126→            ) {
  2127→              console.log(
  2128→                `\nAcceptance Criteria (${reviewContext.spec.acceptance_criteria.length}):`,
  2129→              );
  2130→              for (const ac of reviewContext.spec.acceptance_criteria) {
  2131→                const isCovered = reviewContext.testCoverage?.covered.includes(
  2132→                  ac.id,
  2133→                );
  2134→                const coverageMarker = isCovered
  2135→                  ? chalk.green("✓")
  2136→                  : chalk.yellow("○");
  2137→                console.log(`  ${coverageMarker} [${ac.id}]`);
  2138→                console.log(`    Given: ${ac.given}`);
  2139→                console.log(`    When: ${ac.when}`);
  2140→                console.log(`    Then: ${ac.then}`);
  2141→              }
  2142→
  2143→              // Test coverage summary
  2144→              if (reviewContext.testCoverage) {
  2145→                const { covered, uncovered } = reviewContext.testCoverage;
  2146→                console.log();
  2147→                if (uncovered.length === 0) {
  2148→                  console.log(
  2149→                    chalk.green(
  2150→                      `  ✓ All ${covered.length} AC(s) have test coverage`,
  2151→                    ),
  2152→                  );
  2153→                } else {
  2154→                  console.log(
  2155→                    chalk.yellow(
  2156→                      `  Test coverage: ${covered.length}/${covered.length + uncovered.length} ACs covered`,
  2157→                    ),
  2158→                  );
  2159→                  console.log(
  2160→                    chalk.yellow(
  2161→                      `  Missing coverage for: ${uncovered.join(", ")}`,
  2162→                    ),
  2163→                  );
  2164→                }
  2165→              }
  2166→            }
  2167→            console.log();
  2168→          }
  2169→
  2170→          // Git diff
  2171→          if (reviewContext.diff) {
  2172→            console.log("CHANGES SINCE TASK STARTED");
  2173→            console.log("-".repeat(60));
  2174→            console.log(`Started at: ${foundTask.started_at}`);
  2175→            console.log();
  2176→            console.log(reviewContext.diff);
  2177→            console.log();
  2178→          } else if (foundTask.started_at) {
  2179→            console.log("CHANGES SINCE TASK STARTED");
  2180→            console.log("-".repeat(60));
  2181→            console.log(`Started at: ${foundTask.started_at}`);
  2182→            console.log("No changes detected");
  2183→            console.log();
  2184→          }
  2185→
  2186→          console.log("=".repeat(60));
  2187→          console.log("Review Checklist:");
  2188→          console.log("- Does the implementation match the task description?");
  2189→          if (reviewContext.spec) {
  2190→            console.log("- Are all acceptance criteria covered?");
  2191→            console.log("- Is test coverage adequate?");
  2192→          }
  2193→          console.log("- Are there any gaps or issues?");
  2194→          console.log("=".repeat(60));
  2195→        });
  2196→      } catch (err) {
  2197→        error("Failed to generate review context", err);
  2198→        process.exit(EXIT_CODES.ERROR);
  2199→      }
  2200→    });
  2201→
  2202→  // kspec task todos <ref>
  2203→  task
  2204→    .command("todos <ref>")
  2205→    .description("Show todos for a task")
  2206→    .action(async (ref: string) => {
  2207→      try {
  2208→        const ctx = await initContext();
  2209→        const tasks = await loadAllTasks(ctx);
  2210→        const items = await loadAllItems(ctx);
  2211→        const index = new ReferenceIndex(tasks, items);
  2212→        const foundTask = resolveTaskRef(ref, tasks, index);
  2213→
  2214→        output(foundTask.todos, () => {
