    51→
    52→/**
    53→ * Find a task by reference with detailed error reporting.
    54→ * Returns the task or exits with appropriate error.
    55→ */
    56→function resolveTaskRef(
    57→  ref: string,
    58→  tasks: LoadedTask[],
    59→  index: ReferenceIndex,
    60→): LoadedTask {
    61→  const result = index.resolve(ref);
    62→
    63→  if (!result.ok) {
    64→    switch (result.error) {
    65→      case "not_found":
    66→        error(errors.reference.taskNotFound(ref));
    67→        break;
    68→      case "ambiguous":
    69→        error(errors.reference.ambiguous(ref));
    70→        for (const candidate of result.candidates) {
    71→          const task = tasks.find((t) => t._ulid === candidate);
    72→          const slug = task?.slugs[0] || "";
    73→          console.error(
    74→            `  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ""}`,
    75→          );
    76→        }
    77→        break;
    78→      case "duplicate_slug":
    79→        error(errors.reference.slugMapsToMultiple(ref));
    80→        for (const candidate of result.candidates) {
    81→          console.error(`  - ${index.shortUlid(candidate)}`);
    82→        }
    83→        break;
    84→    }
    85→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    86→    process.exit(EXIT_CODES.NOT_FOUND);
    87→  }
    88→
    89→  // Check if it's actually a task
    90→  const task = tasks.find((t) => t._ulid === result.ulid);
    91→  if (!task) {
    92→    error(errors.reference.notTask(ref));
    93→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    94→    process.exit(EXIT_CODES.NOT_FOUND);
    95→  }
    96→
    97→  return task;
    98→}
    99→
   100→/**
   101→ * Batch-compatible resolver that returns null instead of calling process.exit().
   102→ * Used by executeBatchOperation to handle errors without terminating the process.
   103→ * AC: @multi-ref-batch ac-4, ac-8 - Partial failure handling and ref resolution
   104→ */
   105→function resolveTaskRefForBatch(
   106→  ref: string,
   107→  tasks: LoadedTask[],
   108→  index: ReferenceIndex,
   109→): { task: LoadedTask | null; error?: string } {
   110→  const result = index.resolve(ref);
   111→
   112→  if (!result.ok) {
   113→    let errorMsg: string;
   114→    switch (result.error) {
   115→      case "not_found":
   116→        errorMsg = `Reference "${ref}" not found`;
   117→        break;
   118→      case "ambiguous":
   119→        errorMsg = `Reference "${ref}" is ambiguous (matches ${result.candidates.length} items)`;
   120→        break;
   121→      case "duplicate_slug":
   122→        errorMsg = `Slug "${ref}" maps to multiple items`;
   123→        break;
   124→    }
   125→    return { task: null, error: errorMsg };
   126→  }
   127→
   128→  // Check if it's actually a task
   129→  const task = tasks.find((t) => t._ulid === result.ulid);
   130→  if (!task) {
   131→    return { task: null, error: `Reference "${ref}" is not a task` };
   132→  }
   133→
   134→  return { task };
   135→}
   136→
   137→/**
   138→ * Helper function to update task fields.
   139→ * Used by both single-ref and batch modes of task set.
   140→ * AC: @spec-task-set-batch ac-1, ac-2, ac-4, ac-5
   141→ */
   142→async function setTaskFields(
   143→  foundTask: LoadedTask,
   144→  ctx: any,
   145→  tasks: LoadedTask[],
   146→  items: LoadedSpecItem[],
   147→  _allMetaItems: any[],
   148→  index: ReferenceIndex,
   149→  options: any,
   150→): Promise<{
   151→  success: boolean;
   152→  message?: string;
   153→  error?: string;
   154→  data?: unknown;
   155→}> {
   156→  try {
   157→    // Check slug uniqueness if adding a new slug
   158→    if (options.slug) {
   159→      const slugCheck = checkSlugUniqueness(
   160→        index,
   161→        [options.slug],
   162→        foundTask._ulid,
   163→      );
   164→      if (!slugCheck.ok) {
   165→        return {
   166→          success: false,
   167→          error: `Slug "${slugCheck.slug}" already exists on ${slugCheck.existingUlid}`,
   168→        };
   169→      }
   170→    }
   171→
   172→    // Build updated task with only provided options
   173→    const updatedTask: Task = { ...foundTask };
   174→    const changes: string[] = [];
   175→
   176→    if (options.title) {
   177→      updatedTask.title = options.title;
   178→      changes.push("title");
   179→    }
   180→
   181→    if (options.specRef !== undefined) {
   182→      // Handle 'null' string to clear spec_ref
   183→      if (options.specRef === "null") {
   184→        updatedTask.spec_ref = null;
   185→        changes.push("spec_ref: cleared");
   186→      } else {
   187→        // Validate the spec ref exists and is a spec item
   188→        const specResult = index.resolve(options.specRef);
   189→        if (!specResult.ok) {
   190→          return {
   191→            success: false,
   192→            error: errors.reference.specRefNotFound(options.specRef),
   193→          };
   194→        }
   195→        // Check it's not a task
   196→        const isTask = tasks.some((t) => t._ulid === specResult.ulid);
   197→        if (isTask) {
   198→          return {
   199→            success: false,
   200→            error: errors.reference.specRefIsTask(options.specRef),
   201→          };
   202→        }
   203→        updatedTask.spec_ref = normalizeRefInput(options.specRef);
   204→        changes.push("spec_ref");
   205→      }
   206→    }
   207→
   208→    if (options.metaRef !== undefined) {
   209→      // Handle 'null' string to clear meta_ref
   210→      if (options.metaRef === "null") {
   211→        updatedTask.meta_ref = null;
   212→        changes.push("meta_ref: cleared");
   213→      } else {
   214→        // Validate the meta ref exists and is a meta item
   215→        const metaRefResult = index.resolve(options.metaRef);
   216→        if (!metaRefResult.ok) {
   217→          return {
   218→            success: false,
   219→            error: errors.reference.metaRefNotFound(options.metaRef),
   220→          };
   221→        }
   222→
   223→        // Check if the resolved item is a meta item (not a spec item or task)
   224→        const isTask = tasks.some((t) => t._ulid === metaRefResult.ulid);
   225→        const isSpecItem = items.some((i) => i._ulid === metaRefResult.ulid);
   226→
   227→        if (isTask || isSpecItem) {
   228→          return {
   229→            success: false,
   230→            error: errors.reference.metaRefPointsToSpec(options.metaRef),
   231→          };
   232→        }
   233→
   234→        updatedTask.meta_ref = normalizeRefInput(options.metaRef);
   235→        changes.push("meta_ref");
   236→      }
   237→    }
   238→
   239→    if (options.planRef !== undefined) {
   240→      // Handle 'null' string to clear plan_ref
   241→      if (options.planRef === "null") {
   242→        updatedTask.plan_ref = null;
   243→        changes.push("plan_ref: cleared");
   244→      } else {
   245→        // First check if it's a task or spec item (wrong type)
   246→        const cleanRef = options.planRef.startsWith("@")
   247→          ? options.planRef.slice(1)
   248→          : options.planRef;
   249→
   250→        const isTask = tasks.some(
   251→          (t) =>
   252→            t.slugs.includes(cleanRef) ||
   253→            t._ulid === cleanRef ||
   254→            t._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   255→        );
   256→        const isSpecItem = items.some(
   257→          (i) =>
   258→            i.slugs.includes(cleanRef) ||
   259→            i._ulid === cleanRef ||
   260→            i._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   261→        );
   262→
   263→        if (isTask || isSpecItem) {
   264→          return {
   265→            success: false,
   266→            error: `Reference "${options.planRef}" is not a plan`,
   267→          };
   268→        }
   269→
   270→        // Now check if the plan exists
   271→        const { findPlanByRef } = await import("../../parser/plans.js");
   272→        const plan = await findPlanByRef(ctx, options.planRef);
   273→
   274→        if (!plan) {
   275→          return {
   276→            success: false,
   277→            error: `Plan reference not found: ${options.planRef}`,
   278→          };
   279→        }
   280→
   281→        updatedTask.plan_ref = normalizeRefInput(options.planRef);
   282→        changes.push("plan_ref");
   283→      }
   284→    }
   285→
   286→    if (options.priority) {
   287→      const priorityResult = parseIntOption(options.priority, {
   288→        min: 1,
   289→        max: 5,
   290→        name: "Priority",
   291→      });
   292→      if (!priorityResult.ok) {
   293→        return { success: false, error: priorityResult.error };
   294→      }
   295→      updatedTask.priority = priorityResult.value;
   296→      changes.push("priority");
   297→    }
   298→
   299→    if (options.slug) {
   300→      if (!updatedTask.slugs.includes(options.slug)) {
   301→        updatedTask.slugs = [...updatedTask.slugs, options.slug];
   302→        changes.push("slug");
   303→      }
   304→    }
   305→
   306→    if (options.tag) {
   307→      const parsedTags = parseTagsArray(options.tag);
   308→      const newTags = parsedTags.filter(
   309→        (t: string) => !updatedTask.tags.includes(t),
   310→      );
   311→      if (newTags.length > 0) {
   312→        updatedTask.tags = [...updatedTask.tags, ...newTags];
   313→        changes.push("tags");
   314→      }
   315→    }
   316→
   317→    if (options.dependsOn) {
   318→      // Validate all dependency refs
   319→      for (const depRef of options.dependsOn) {
   320→        const depResult = index.resolve(depRef);
   321→        if (!depResult.ok) {
   322→          return {
   323→            success: false,
   324→            error: errors.reference.depNotFound(depRef),
   325→          };
   326→        }
   327→        // Ensure the dependency is a task, not a spec item
   328→        const isTask = tasks.some((t) => t._ulid === depResult.ulid);
   329→        if (!isTask) {
   330→          return {
   331→            success: false,
   332→            error: `Reference "${depRef}" is not a task`,
   333→          };
   334→        }
   335→      }
   336→      updatedTask.depends_on = options.dependsOn.map(normalizeRefInput);
   337→      changes.push("depends_on");
   338→    }
   339→
   340→    // AC: @spec-task-clear-deps ac-1, ac-2 - Clear all dependencies
   341→    if (options.clearDeps) {
   342→      if (foundTask.depends_on.length === 0) {
   343→        // AC: @spec-task-clear-deps ac-2 - No changes needed
   344→        return {
   345→          success: true,
   346→          message: "No changes: task has no dependencies to clear",
   347→        };
   348→      }
   349→      updatedTask.depends_on = [];
   350→      changes.push("depends_on");
   351→
   352→      // Add note documenting the change
   353→      // AC: @task-set ac-author
   354→      const note = createNote(
   355→        `Dependencies cleared (was: ${foundTask.depends_on.join(", ")})`,
   356→        getAuthor(ctx.config?.identity?.author),
   357→      );
   358→      updatedTask.notes = [...updatedTask.notes, note];
   359→    }
   360→
   361→    // AC: @task-automation-eligibility ac-5, ac-11, ac-12, ac-18
   362→    // Handle automation status changes
   363→    // Note: --no-automation sets options.automation to false, so check that first
   364→    if (options.automation === false) {
   365→      // --no-automation flag clears the automation status (AC: ac-12)
   366→      delete updatedTask.automation;
   367→      changes.push("automation");
   368→    } else if (options.automation !== undefined) {
   369→      const automationResult = validateEnumOption(
   370→        options.automation,
   371→        ["eligible", "needs_review", "manual_only"] as const,
   372→        "automation status",
   373→      );
   374→      if (!automationResult.ok) {
   375→        return { success: false, error: automationResult.error };
   376→      }
   377→
   378→      // AC: @task-automation-eligibility ac-18 - require reason for needs_review
   379→      if (options.automation === "needs_review" && !options.reason) {
   380→        return {
   381→          success: false,
   382→          error:
   383→            "Setting automation to needs_review requires --reason flag explaining why",
   384→        };
   385→      }
   386→
   387→      updatedTask.automation = automationResult.value;
   388→      changes.push("automation");
   389→
   390→      // If reason provided, add a note documenting the change
   391→      // AC: @task-set ac-author
   392→      if (options.reason) {
   393→        const note = createNote(
   394→          `Automation status set to ${automationResult.value}: ${options.reason}`,
   395→          getAuthor(ctx.config?.identity?.author),
   396→        );
   397→        updatedTask.notes = [...updatedTask.notes, note];
   398→        changes.push("note");
   399→      }
   400→    }
   401→
   402→    // AC: @spec-task-set-batch ac-4 - Warn on no changes, don't fail
   403→    if (changes.length === 0) {
   404→      return {
   405→        success: true,
   406→        message: "No changes specified",
   407→        data: { task: updatedTask },
   408→      };
   409→    }
   410→
   411→    await saveTask(ctx, updatedTask);
   412→    await commitIfShadow(
   413→      ctx.shadow,
   414→      "task-set",
   415→      foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
   416→      changes.join(", "),
   417→    );
   418→
   419→    return {
   420→      success: true,
   421→      message: `Updated task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(", ")})`,
   422→      data: { task: updatedTask },
   423→    };
   424→  } catch (err) {
   425→    return {
   426→      success: false,
   427→      error: err instanceof Error ? err.message : String(err),
   428→    };
   429→  }
   430→}
   431→
   432→/**
   433→ * Register the 'task' command group (singular - operations on individual tasks)
   434→ */
   435→export function registerTaskCommands(program: Command): void {
   436→  const task = program
   437→    .command("task")
   438→    .description("Operations on individual tasks")
   439→    .allowUnknownOption()
   440→    .allowExcessArguments();
   441→
   442→  // AC: @command-group-default-actions ac-bare-task, ac-unknown-subcommand
   443→  // Default action when no subcommand is given (e.g. `kspec task` or `kspec task --status pending`)
   444→  task.action(async (_options: Record<string, unknown>, cmd: Command) => {
   445→    const { Command: Cmd } = await import("commander");
   446→    const listCmd = addListOptions(new Cmd("_list"));
   447→    listCmd.exitOverride();
   448→    try {
   449→      listCmd.parse(cmd.args, { from: "user" });
   450→    } catch {
   451→      console.error(chalk.gray(`Run 'kspec task --help' to see available subcommands`));
   452→      process.exit(EXIT_CODES.ERROR);
   453→    }
   454→
   455→    // AC: @command-group-default-actions ac-unknown-subcommand
   456→    if (listCmd.args.length > 0) {
   457→      const unknownCmd = listCmd.args[0];
   458→      const subcommandNames = cmd.commands.map((c: Command) => c.name());
   459→      const suggestion = findClosestCommand(unknownCmd, subcommandNames);
   460→      console.error(chalk.red(`error: unknown command 'task ${unknownCmd}'`));
   461→      if (suggestion) {
   462→        console.error(chalk.yellow(`Did you mean: kspec task ${suggestion}?`));
   463→      } else {
   464→        console.error(chalk.gray(`Run 'kspec task --help' to see available subcommands`));
   465→      }
   466→      process.exit(EXIT_CODES.ERROR);
   467→    }
   468→
   469→    // AC: @command-group-default-actions ac-bare-with-options
   470→    await listTasksAction(listCmd.opts());
   471→  });
   472→
   473→  // kspec task list - alias for 'kspec tasks list'
   474→  task
   475→    .command("list")
   476→    .description("List all tasks (alias for 'kspec tasks list')")
   477→    .option("-s, --status <status>", "Filter by status")
   478→    .option("-t, --type <type>", "Filter by type")
   479→    .option("--tag <tag>", "Filter by tag")
   480→    .option("--meta-ref <ref>", "Filter by meta reference")
   481→    .option("-g, --grep <pattern>", "Search content with regex pattern")
   482→    .option("-v, --verbose", "Show more details")
   483→    .option("--full", "Show full details (notes, todos, timestamps)")
   484→    .option("--count", "Show only the count of matching tasks")
   485→    .action(async (options) => {
   486→      await listTasksAction(options);
   487→    });
   488→
   489→  // kspec task get <ref>
   490→  task
   491→    .command("get <ref>")
   492→    .description("Get task details")
   493→    .option("--all", "Show all notes including superseded ones")
   494→    .action(async (ref: string, options: { all?: boolean }) => {
   495→      try {
   496→        const ctx = await initContext();
   497→        const tasks = await loadAllTasks(ctx);
   498→        const _items = await loadAllItems(ctx);
   499→
   500→        // Build all indexes including TraitIndex
   501→        const { refIndex: index, traitIndex } = await (async () => {
   502→          const { buildIndexes } = await import("../../parser/index.js");
   503→          return buildIndexes(ctx);
   504→        })();
   505→
   506→        const foundTask = resolveTaskRef(ref, tasks, index);
   507→
   508→        // AC: @trait-display ac-3 - task get shows inherited AC sections
   509→        // Get inherited traits if task has spec_ref
   510→        let inheritedTraits: Array<{
   511→          trait: {
   512→            ulid: string;
   513→            slug: string;
   514→            title: string;
   515→            description?: string;
   516→          };
   517→          acs: Array<{
   518→            id: string;
   519→            given?: string;
   520→            when?: string;
   521→            then?: string;
   522→          }>;
   523→        }> = [];
   524→        if (foundTask.spec_ref) {
   525→          const specResult = index.resolve(foundTask.spec_ref);
   526→          if (specResult.ok) {
   527→            const specUlid = specResult.ulid;
   528→            const inheritedAC = traitIndex.getInheritedAC(specUlid);
   529→            const traitsByTrait = new Map<
   530→              string,
   531→              {
   532→                trait: (typeof inheritedAC)[0]["trait"];
   533→                acs: Array<{
   534→                  id: string;
   535→                  given?: string;
   536→                  when?: string;
   537→                  then?: string;
   538→                }>;
   539→              }
   540→            >();
   541→            for (const { trait, ac } of inheritedAC) {
   542→              if (!traitsByTrait.has(trait.ulid)) {
   543→                traitsByTrait.set(trait.ulid, { trait, acs: [] });
   544→              }
   545→              traitsByTrait.get(trait.ulid)?.acs.push(ac);
   546→            }
   547→            inheritedTraits = Array.from(traitsByTrait.values());
   548→          }
   549→        }
   550→
   551→        // Build JSON output with inherited traits (AC: @trait-display ac-2)
   552→        // Always include all notes in JSON output with superseded computed field
   553→        const jsonOutput = {
   554→          ...foundTask,
   555→          notes: annotateNotesWithSuperseded(foundTask.notes),
   556→          ...(inheritedTraits.length > 0 && {
   557→            inherited_traits: inheritedTraits.map(({ trait, acs }) => ({
   558→              ref: `@${trait.slug}`,
   559→              title: trait.title,
   560→              acceptance_criteria: acs,
   561→            })),
   562→          }),
   563→        };
   564→
   565→        output(jsonOutput, () => {
   566→          formatTaskDetails(foundTask, index, { showAllNotes: options.all });
   567→
   568→          // AC: @trait-display ac-3, ac-4, ac-5 - Show inherited AC per trait in labeled sections
   569→          if (inheritedTraits.length > 0) {
   570→            for (const { trait, acs } of inheritedTraits) {
   571→              console.log(
   572→                chalk.gray(`\n─── Inherited from @${trait.slug} ───`),
   573→              );
   574→              for (const ac of acs) {
   575→                console.log(
   576→                  chalk.cyan(`  [${ac.id}]`) +
   577→                    chalk.gray(` (from @${trait.slug})`),
   578→                );
   579→                if (ac.given) console.log(`    Given: ${ac.given}`);
   580→                if (ac.when) console.log(`    When: ${ac.when}`);
   581→                if (ac.then) console.log(`    Then: ${ac.then}`);
   582→              }
   583→            }
   584→          }
   585→        });
   586→      } catch (err) {
   587→        error(errors.failures.getTask, err);
   588→        process.exit(EXIT_CODES.ERROR);
   589→      }
   590→    });
   591→
   592→  // kspec task add
   593→  markMutating(task.command("add"))
   594→    .description("Create a new task")
   595→    .requiredOption("--title <title>", "Task title")
   596→    .option("--description <description>", "Task description")
   597→    .option(
   598→      "--type <type>",
   599→      "Task type (task, epic, bug, spike, infra)",
   600→      "task",
   601→    )
   602→    .option("--spec-ref <ref>", "Reference to spec item")
   603→    .option(
   604→      "--meta-ref <ref>",
   605→      "Reference to meta item (workflow, agent, or convention)",
   606→    )
   607→    .option("--plan-ref <ref>", "Reference to plan this task is derived from")
   608→    .option("--priority <n>", "Priority (1-5)", "3")
   609→    .option("--slug <slug>", "Human-friendly slug")
   610→    .option("--tag <tag...>", "Tags")
   611→    .option("--depends-on <refs...>", "Set task dependencies")
   612→    .option(
   613→      "--automation <status>",
   614→      "Automation eligibility (eligible, needs_review, manual_only)",
   615→    )
   616→    .addHelpText(
   617→      "after",
   618→      `
   619→Examples:
   620→  $ kspec task add --title "Implement feature" --spec-ref @feature-spec
   621→  $ kspec task add --title "Fix bug" --type bug --priority 1
   622→  $ kspec task add --title "Multi-tag task" --tag cli urgent`,
   623→    )
   624→    .action(async (options) => {
   625→      try {
   626→        const ctx = await initContext();
   627→        const tasks = await loadAllTasks(ctx);
   628→        const items = await loadAllItems(ctx);
   629→
   630→        // Load meta items for validation
   631→        const { loadMetaContext } = await import("../../parser/meta.js");
   632→        const metaContext = await loadMetaContext(ctx);
   633→        const allMetaItems = [
   634→          ...metaContext.agents,
   635→          ...metaContext.workflows,
   636→          ...metaContext.conventions,
   637→          ...metaContext.observations,
   638→        ];
   639→
   640→        // Build index for reference validation
   641→        const refIndex = new ReferenceIndex(tasks, items, allMetaItems);
   642→
   643→        // Check slug uniqueness if provided
   644→        if (options.slug) {
   645→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   646→          if (!slugCheck.ok) {
   647→            error(
   648→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
   649→            );
   650→            process.exit(EXIT_CODES.CONFLICT);
   651→          }
   652→        }
   653→
   654→        // Validate meta_ref if provided (AC-meta-ref-3, AC-meta-ref-4)
   655→        if (options.metaRef) {
   656→          const metaRefResult = refIndex.resolve(options.metaRef);
   657→
   658→          if (!metaRefResult.ok) {
   659→            error(errors.reference.metaRefNotFound(options.metaRef));
   660→            process.exit(EXIT_CODES.NOT_FOUND);
   661→          }
   662→
   663→          // Check if the resolved item is a meta item (not a spec item or task)
   664→          const isTask = tasks.some((t) => t._ulid === metaRefResult.ulid);
   665→          const isSpecItem = items.some((i) => i._ulid === metaRefResult.ulid);
   666→
   667→          if (isTask || isSpecItem) {
   668→            error(errors.reference.metaRefPointsToSpec(options.metaRef));
   669→            process.exit(EXIT_CODES.NOT_FOUND);
   670→          }
   671→        }
   672→
   673→        // Validate spec_ref if provided — must point to a spec item, not a task or meta item
   674→        if (options.specRef) {
   675→          const specRefResult = validateSpecRef(
   676→            options.specRef,
   677→            refIndex,
   678→            tasks,
   679→            items,
   680→          );
   681→          if (!specRefResult.ok) {
   682→            error(specRefResult.error);
   683→            process.exit(EXIT_CODES.NOT_FOUND);
   684→          }
   685→        }
   686→
   687→        // AC: @task-automation-eligibility ac-13 - validate automation if provided
   688→        let automationValue:
   689→          | "eligible"
   690→          | "needs_review"
   691→          | "manual_only"
   692→          | undefined;
   693→        if (options.automation) {
   694→          const automationResult = validateEnumOption(
   695→            options.automation,
   696→            ["eligible", "needs_review", "manual_only"] as const,
   697→            "automation status",
   698→          );
   699→          if (!automationResult.ok) {
   700→            error(automationResult.error);
   701→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   702→          }
   703→          automationValue = automationResult.value;
   704→        }
   705→
   706→        // Validate plan_ref if provided (AC: @plan-derive ac-5, ac-6)
   707→        if (options.planRef) {
   708→          // First check if it's a task or spec item (wrong type)
   709→          const cleanRef = options.planRef.startsWith("@")
   710→            ? options.planRef.slice(1)
   711→            : options.planRef;
   712→
   713→          const isTask = tasks.some(
   714→            (t) =>
   715→              t.slugs.includes(cleanRef) ||
   716→              t._ulid === cleanRef ||
   717→              t._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   718→          );
   719→          const isSpecItem = items.some(
   720→            (i) =>
   721→              i.slugs.includes(cleanRef) ||
   722→              i._ulid === cleanRef ||
   723→              i._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   724→          );
   725→
   726→          if (isTask || isSpecItem) {
   727→            error(`Reference "${options.planRef}" is not a plan`);
   728→            process.exit(EXIT_CODES.NOT_FOUND);
   729→          }
   730→
   731→          // Now check if the plan exists
   732→          const { findPlanByRef } = await import("../../parser/plans.js");
   733→          const plan = await findPlanByRef(ctx, options.planRef);
   734→
   735→          if (!plan) {
   736→            error(`Plan reference not found: ${options.planRef}`);
   737→            process.exit(EXIT_CODES.NOT_FOUND);
   738→          }
   739→        }
   740→
   741→        // AC: @task-add-depends-on ac-2 - Validate dependency refs
   742→        if (options.dependsOn) {
   743→          for (const depRef of options.dependsOn) {
   744→            const depResult = refIndex.resolve(depRef);
   745→            if (!depResult.ok) {
   746→              error(errors.reference.depNotFound(depRef));
   747→              process.exit(EXIT_CODES.NOT_FOUND);
   748→            }
   749→            // Ensure the dependency is a task, not a spec item
   750→            const isTask = tasks.some((t) => t._ulid === depResult.ulid);
   751→            if (!isTask) {
   752→              error(`Reference "${depRef}" is not a task`);
   753→              process.exit(EXIT_CODES.NOT_FOUND);
   754→            }
   755→          }
   756→        }
   757→
   758→        // Validate priority
   759→        const priorityResult = parseIntOption(options.priority, {
   760→          min: 1,
   761→          max: 5,
   762→          name: "Priority",
   763→        });
   764→        if (!priorityResult.ok) {
   765→          error(priorityResult.error);
   766→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   767→        }
   768→
   769→        // AC: @spec-task-add-description ac-6 - Omit description if empty string
   770→        const descriptionValue =
   771→          options.description && options.description.trim() !== ""
   772→            ? options.description
   773→            : undefined;
   774→
   775→        const input: TaskInput = {
   776→          title: options.title,
   777→          description: descriptionValue,
   778→          type: options.type,
   779→          spec_ref: options.specRef ? normalizeRefInput(options.specRef) : null,
   780→          meta_ref: options.metaRef ? normalizeRefInput(options.metaRef) : null,
   781→          plan_ref: options.planRef ? normalizeRefInput(options.planRef) : null,
   782→          priority: priorityResult.value,
   783→          slugs: options.slug ? [options.slug] : [],
   784→          tags: parseTagsArray(options.tag),
   785→          depends_on: (options.dependsOn || []).map(normalizeRefInput),
   786→          automation: automationValue,
   787→        };
   788→
   789→        const newTask = createTask(input);
   790→        await saveTask(ctx, newTask);
   791→        await commitIfShadow(
   792→          ctx.shadow,
   793→          "task-add",
   794→          newTask.slugs[0] || newTask._ulid.slice(0, 8),
   795→          newTask.title,
   796→        );
   797→
   798→        // Build index including the new task for accurate short ULID
   799→        const index = new ReferenceIndex(
   800→          [...tasks, newTask],
   801→          items,
   802→          allMetaItems,
   803→        );
   804→        success(`Created task: ${index.shortUlid(newTask._ulid)}`, {
   805→          task: newTask,
   806→        });
   807→      } catch (err) {
   808→        error(errors.failures.createTask, err);
   809→        process.exit(EXIT_CODES.ERROR);
   810→      }
   811→    });
   812→
   813→  // kspec task set <ref>
   814→  markMutating(task.command("set [ref]"))
   815→    .description("Update task fields")
   816→    .option(
   817→      "--refs <refs...>",
   818→      "Update multiple tasks (AC: @spec-task-set-batch ac-1)",
   819→    )
   820→    .option("--title <title>", "Update task title")
   821→    .option("--spec-ref <ref>", "Link to spec item (use 'null' to clear)")
   822→    .option(
   823→      "--meta-ref <ref>",
   824→      "Link to meta item (use 'null' to clear)",
   825→    )
   826→    .option("--plan-ref <ref>", "Link to plan (use 'null' to clear)")
   827→    .option("--priority <n>", "Set priority (1-5)")
   828→    .option("--slug <slug>", "Add a slug alias")
   829→    .option("--tag <tag...>", "Add tags")
   830→    .option("--depends-on <refs...>", "Set dependencies (replaces existing)")
   831→    .option("--clear-deps", "Clear all dependencies")
   832→    .option(
   833→      "--automation <status>",
   834→      "Set automation eligibility (eligible, needs_review, manual_only)",
   835→    )
   836→    .option("--no-automation", "Clear automation status (return to unassessed)")
   837→    .option(
   838→      "--reason <reason>",
   839→      "Reason for status change (required when setting needs_review)",
   840→    )
   841→    .option(
   842→      "--status <status>",
   843→      "Reject with error - use state transition commands instead",
   844→    )
   845→    .addHelpText(
   846→      "after",
   847→      `
   848→Examples:
   849→  $ kspec task set @task-slug --priority 2
   850→  $ kspec task set @task-slug --depends-on @dep1 @dep2
   851→  $ kspec task set @task-slug --tag cli urgent
   852→  $ kspec task set --refs @task1 @task2 --priority 3`,
   853→    )
   854→    .action(async (ref: string | undefined, options) => {
   855→      try {
   856→        // AC: @spec-task-set-batch ac-3 - Reject --status flag
   857→        if (options.status !== undefined) {
   858→          error(
   859→            "Use state transition commands (start, complete, block, etc.) to change status",
   860→          );
   861→          process.exit(EXIT_CODES.USAGE_ERROR);
   862→        }
   863→
   864→        // AC: @spec-task-clear-deps ac-3 - Mutual exclusivity check
   865→        if (options.clearDeps && options.dependsOn) {
   866→          error("Cannot use --clear-deps and --depends-on together");
   867→          process.exit(EXIT_CODES.USAGE_ERROR);
   868→        }
   869→
   870→        const ctx = await initContext();
   871→        const tasks = await loadAllTasks(ctx);
   872→        const items = await loadAllItems(ctx);
   873→
   874→        // Load meta items for validation
   875→        const { loadMetaContext } = await import("../../parser/meta.js");
   876→        const metaContext = await loadMetaContext(ctx);
   877→        const allMetaItems = [
   878→          ...metaContext.agents,
   879→          ...metaContext.workflows,
   880→          ...metaContext.conventions,
   881→          ...metaContext.observations,
   882→        ];
   883→
   884→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   885→
   886→        // AC: @trait-multi-ref-batch ac-8 - Deduplicate refs
   887→        const refsFlag = options.refs
   888→          ? [...new Set(options.refs as string[])]
   889→          : undefined;
   890→
   891→        // Batch mode or single mode?
   892→        if (refsFlag && refsFlag.length > 0) {
   893→          // Batch mode - AC: @spec-task-set-batch ac-1, ac-2, ac-5
   894→          const result = await executeBatchOperation({
   895→            positionalRef: ref,
   896→            refsFlag,
   897→            context: { ctx, tasks, items, allMetaItems, index, options },
   898→            items: tasks,
   899→            index,
   900→            resolveRef: (
   901→              refStr: string,
   902→              taskList: LoadedTask[],
   903→              idx: ReferenceIndex,
   904→            ) => {
   905→              const result = resolveTaskRefForBatch(refStr, taskList, idx);
   906→              return { item: result.task, error: result.error };
   907→            },
   908→            executeOperation: async (task: LoadedTask, context) => {
   909→              return await setTaskFields(
   910→                task,
   911→                context.ctx,
   912→                context.tasks,
   913→                context.items,
   914→                context.allMetaItems,
   915→                context.index,
   916→                context.options,
   917→              );
   918→            },
   919→            getUlid: (task: LoadedTask) => task._ulid,
   920→          });
   921→
   922→          formatBatchOutput(result, "Set");
   923→        } else {
   924→          // Single mode - existing behavior
   925→          if (!ref) {
   926→            error("Either provide a positional ref or use --refs flag");
   927→            process.exit(EXIT_CODES.USAGE_ERROR);
   928→          }
   929→
   930→          const foundTask = resolveTaskRef(ref, tasks, index);
   931→          const result = await setTaskFields(
   932→            foundTask,
   933→            ctx,
   934→            tasks,
   935→            items,
   936→            allMetaItems,
   937→            index,
   938→            options,
   939→          );
   940→
   941→          if (!result.success) {
   942→            error(result.error || "Failed to update task");
   943→            process.exit(EXIT_CODES.ERROR);
   944→          }
   945→
   946→          if (result.message) {
   947→            // AC: @spec-task-set-batch ac-4 - Warn on no changes
   948→            if (result.message.includes("No changes")) {
   949→              if (isJsonMode()) {
   950→                output({ success: true, message: result.message });
   951→              } else {
   952→                warn(result.message);
   953→              }
   954→            } else {
   955→              success(
   956→                result.message,
   957→                result.data as Record<string, unknown> | undefined,
   958→              );
   959→            }
   960→          }
   961→        }
   962→      } catch (err) {
   963→        error(errors.failures.updateTask, err);
   964→        process.exit(EXIT_CODES.ERROR);
   965→      }
   966→    });
   967→
   968→  // kspec task patch <ref>
   969→  markMutating(task.command("patch <ref>"))
   970→    .description("Update task with JSON data")
   971→    .option("--data <json>", "JSON object with fields to update")
   972→    .option("--dry-run", "Show what would change without writing")
   973→    .option("--allow-unknown", "Allow unknown fields (for extending format)")
   974→    .action(async (ref: string, options) => {
   975→      try {
   976→        const ctx = await initContext();
   977→        const tasks = await loadAllTasks(ctx);
   978→        const items = await loadAllItems(ctx);
   979→
   980→        // Load meta items for validation
   981→        const { loadMetaContext } = await import("../../parser/meta.js");
   982→        const metaContext = await loadMetaContext(ctx);
   983→        const allMetaItems = [
   984→          ...metaContext.agents,
   985→          ...metaContext.workflows,
   986→          ...metaContext.conventions,
   987→          ...metaContext.observations,
   988→        ];
   989→
   990→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   991→        const foundTask = resolveTaskRef(ref, tasks, index);
   992→
   993→        // Get JSON data from --data flag or stdin
   994→        let jsonData: string;
   995→        if (options.data) {
   996→          jsonData = options.data;
   997→        } else {
   998→          // Read from stdin
   999→          const chunks: Buffer[] = [];
  1000→          for await (const chunk of process.stdin) {
  1001→            chunks.push(chunk);
  1002→          }
  1003→          jsonData = Buffer.concat(chunks).toString("utf-8");
  1004→        }
  1005→
  1006→        // Parse JSON
  1007→        let patchData: Record<string, unknown>;
  1008→        try {
  1009→          patchData = JSON.parse(jsonData);
  1010→        } catch (parseErr) {
  1011→          error(errors.validation.invalidJson, parseErr);
  1012→          process.exit(EXIT_CODES.ERROR);
  1013→        }
  1014→
  1015→        // Validate against TaskInputSchema (partial)
  1016→        const { TaskInputSchema } = await import("../../schema/index.js");
  1017→
  1018→        // Create a partial schema for validation
  1019→        const partialSchema = options.allowUnknown
  1020→          ? TaskInputSchema.partial().passthrough()
  1021→          : TaskInputSchema.partial().strict();
  1022→
  1023→        let validatedPatch: Partial<TaskInput>;
  1024→        try {
  1025→          validatedPatch = partialSchema.parse(patchData);
  1026→        } catch (validationErr) {
  1027→          error(
  1028→            errors.validation.invalidPatchData(String(validationErr)),
  1029→            validationErr,
  1030→          );
  1031→          process.exit(EXIT_CODES.ERROR);
  1032→        }
  1033→
  1034→        // Check for unknown fields if strict mode
  1035→        if (!options.allowUnknown) {
  1036→          const knownFields = Object.keys(TaskInputSchema.shape);
  1037→          const providedFields = Object.keys(patchData);
  1038→          const unknownFields = providedFields.filter(
  1039→            (f) => !knownFields.includes(f),
  1040→          );
  1041→
  1042→          if (unknownFields.length > 0) {
  1043→            error(errors.validation.unknownFields(unknownFields));
  1044→            process.exit(EXIT_CODES.ERROR);
  1045→          }
  1046→        }
  1047→
  1048→        // Build updated task
  1049→        const updatedTask: Task = { ...foundTask, ...validatedPatch };
  1050→
  1051→        // Track changes for output
  1052→        const changes = Object.keys(validatedPatch);
  1053→
  1054→        if (options.dryRun) {
  1055→          info("Dry run - no changes will be written");
  1056→          info(`Would update: ${changes.join(", ")}`);
  1057→          output({ changes, updated: updatedTask }, () => {
  1058→            console.log(`\nChanges: ${changes.join(", ")}\n`);
  1059→            return formatTaskDetails(updatedTask, index);
  1060→          });
  1061→          return;
  1062→        }
  1063→
  1064→        await saveTask(ctx, updatedTask);
  1065→        await commitIfShadow(
  1066→          ctx.shadow,
  1067→          "task-patch",
  1068→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1069→          changes.join(", "),
  1070→        );
  1071→        success(
  1072→          `Patched task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(", ")})`,
  1073→          { task: updatedTask },
  1074→        );
  1075→      } catch (err) {
  1076→        error(errors.failures.patchTask, err);
  1077→        process.exit(EXIT_CODES.ERROR);
  1078→      }
  1079→    });
  1080→
  1081→  // kspec task start <ref>
  1082→  markMutating(task.command("start <ref>"))
  1083→    .description("Start working on a task (pending|needs_work -> in_progress)")
  1084→    .option("--no-sync", "Skip syncing spec implementation status")
  1085→    .action(async (ref: string, options) => {
  1086→      try {
  1087→        const ctx = await initContext();
  1088→        const tasks = await loadAllTasks(ctx);
  1089→        const items = await loadAllItems(ctx);
  1090→        const index = new ReferenceIndex(tasks, items);
  1091→        const foundTask = resolveTaskRef(ref, tasks, index);
  1092→
  1093→        if (foundTask.status === "in_progress") {
  1094→          warn("Task is already in progress");
  1095→          output(foundTask, () => formatTaskDetails(foundTask));
  1096→          return;
  1097→        }
  1098→
  1099→        if (foundTask.status !== "pending" && foundTask.status !== "needs_work") {
  1100→          error(errors.status.cannotStart(foundTask.status));
  1101→          process.exit(EXIT_CODES.VALIDATION_FAILED); // Exit code 4 = invalid state
  1102→        }
  1103→
  1104→        // AC: @session-scoped-task-claiming ac-startable - warn if claimed by another session
  1105→        const sessionId = process.env.KSPEC_SESSION_ID || null;
  1106→        if (
  1107→          foundTask.session_id &&
  1108→          sessionId &&
  1109→          foundTask.session_id !== sessionId
  1110→        ) {
  1111→          warn(
  1112→            `Task was claimed by session ${foundTask.session_id.slice(0, 8)}...`,
  1113→          );
  1114→        }
  1115→
  1116→        // AC: @task-budget-enforcement ac-block-start, ac-no-session, ac-no-budget
  1117→        // Check budget before starting — only when session is set
  1118→        const budgetCheck = await checkBudget(
  1119→          ctx.specDir,
  1120→          sessionId || undefined,
  1121→        );
  1122→        if (!budgetCheck.allowed) {
  1123→          error(budgetCheck.reason!);
  1124→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1125→        }
  1126→
  1127→        // Update status
  1128→        // AC: @session-scoped-task-claiming ac-stamp, ac-no-env
  1129→        const updatedTask: Task = {
  1130→          ...foundTask,
  1131→          status: "in_progress",
  1132→          started_at: new Date().toISOString(),
  1133→          ...(sessionId ? { session_id: sessionId } : {}),
  1134→        };
  1135→
  1136→        await saveTask(ctx, updatedTask);
  1137→        await commitIfShadow(
  1138→          ctx.shadow,
  1139→          "task-start",
  1140→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1141→        );
  1142→
  1143→        // AC: @task-budget-enforcement ac-increment, ac-resume-no-increment
  1144→        // Increment budget counter after successful start.
  1145→        // Resume case (already in_progress) returns early above, so this only
  1146→        // runs for genuine pending→in_progress or needs_work→in_progress transitions.
  1147→        if (sessionId) {
  1148→          await incrementBudget(ctx.specDir, sessionId);
  1149→        }
  1150→
  1151→        success(`Started task: ${index.shortUlid(updatedTask._ulid)}`, {
  1152→          task: updatedTask,
  1153→        });
  1154→
  1155→        // Show spec context and AC guidance (suppressed in JSON mode)
  1156→        if (!isJsonMode() && foundTask.spec_ref) {
  1157→          const specResult = index.resolve(foundTask.spec_ref);
  1158→          if (specResult.ok) {
  1159→            const specItem = items.find((i) => i._ulid === specResult.ulid);
  1160→            if (specItem) {
  1161→              console.log("");
  1162→              console.log("--- Spec Context ---");
  1163→              console.log(`Implementing: ${specItem.title}`);
  1164→              if (specItem.description) {
  1165→                console.log(`\n${specItem.description}`);
  1166→              }
  1167→
  1168→              if (
  1169→                specItem.acceptance_criteria &&
  1170→                specItem.acceptance_criteria.length > 0
  1171→              ) {
  1172→                console.log(
  1173→                  `\nAcceptance Criteria (${specItem.acceptance_criteria.length}):`,
  1174→                );
  1175→                for (const ac of specItem.acceptance_criteria) {
  1176→                  console.log(`  [${ac.id}]`);
  1177→                  console.log(`    Given: ${ac.given}`);
  1178→                  console.log(`    When: ${ac.when}`);
  1179→                  console.log(`    Then: ${ac.then}`);
  1180→                }
  1181→                console.log("");
  1182→                console.log(
  1183→                  "Remember: Add test coverage for each AC and mark tests with // AC: @spec-ref ac-N",
  1184→                );
  1185→              }
  1186→              console.log("");
  1187→            }
  1188→          }
  1189→        }
  1190→
  1191→        // Sync spec implementation status (unless --no-sync)
  1192→        if (options.sync !== false && foundTask.spec_ref) {
  1193→          const updatedTasks = tasks.map((t) =>
  1194→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t,
  1195→          );
  1196→          const syncResult = await syncSpecImplementationStatus(
  1197→            ctx,
  1198→            updatedTask as LoadedTask,
  1199→            updatedTasks as LoadedTask[],
  1200→            items,
  1201→            index,
  1202→          );
  1203→          if (syncResult) {
  1204→            info(
  1205→              `Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1206→            );
  1207→            // Commit the spec status change
  1208→            await commitIfShadow(
  1209→              ctx.shadow,
  1210→              "spec-sync",
  1211→              syncResult.specUlid.slice(0, 8),
  1212→              `${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1213→            );
  1214→          }
  1215→        }
  1216→      } catch (err) {
  1217→        error(errors.failures.startTask, err);
  1218→        process.exit(EXIT_CODES.ERROR);
  1219→      }
  1220→    });
  1221→
  1222→  // kspec task complete <ref> | --refs <refs...>
  1223→  // AC: @multi-ref-batch ac-1 - Basic multi-ref syntax
  1224→  // AC: @multi-ref-batch ac-2 - Backward compatibility
  1225→  markMutating(task.command("complete [ref]"))
  1226→    .description("Complete a task (pending_review -> completed)")
  1227→    .option("--refs <refs...>", "Complete multiple tasks by ref")
  1228→    .option("--reason <reason>", "Completion reason/notes")
  1229→    .option("--skip-review", "Skip review requirement (requires --reason)")
  1230→    .option(
  1231→      "--force",
  1232→      "Force completion from any state (bypasses submit requirement)",
  1233→    )
  1234→    .option("--no-sync", "Skip syncing spec implementation status")
  1235→    .addHelpText(
  1236→      "after",
  1237→      `
  1238→Examples:
  1239→  $ kspec task complete @task-slug --reason "Merged in PR #123"
  1240→  $ kspec task complete @task-slug --force --reason "Design task, no code to review"
  1241→  $ kspec task complete --refs @task1 @task2 --reason "Batch completion"`,
  1242→    )
  1243→    .action(async (ref: string | undefined, options) => {
  1244→      try {
  1245→        const ctx = await initContext();
  1246→        const tasks = await loadAllTasks(ctx);
  1247→        const items = await loadAllItems(ctx);
  1248→        const index = new ReferenceIndex(tasks, items);
  1249→
  1250→        // AC: @spec-completion-enforcement ac-8
  1251→        if (options.skipReview && !options.reason) {
  1252→          error(errors.status.skipReviewRequiresReason);
  1253→          process.exit(EXIT_CODES.ERROR);
  1254→        }
  1255→
  1256→        // AC: @multi-ref-batch ac-1, ac-2, ac-3, ac-4
  1257→        const result = await executeBatchOperation({
  1258→          positionalRef: ref,
  1259→          refsFlag: options.refs,
  1260→          context: { ctx, tasks, items, index, options },
  1261→          items: tasks,
  1262→          index,
  1263→          resolveRef: (refStr, taskList, idx) => {
  1264→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1265→            return { item: resolved.task, error: resolved.error };
  1266→          },
  1267→          executeOperation: async (
  1268→            foundTask,
  1269→            { ctx, tasks, items, index, options },
  1270→          ) => {
  1271→            try {
  1272→              // AC: @spec-completion-enforcement ac-6
  1273→              if (foundTask.status === "completed") {
  1274→                return {
  1275→                  success: false,
  1276→                  error: errors.status.completeAlreadyCompleted,
  1277→                };
  1278→              }
  1279→
  1280→              // AC: @task-commands ac-1 - Allow --force to bypass all state checks
  1281→              const forcingCompletion = options.force;
  1282→
  1283→              // AC: @spec-completion-enforcement ac-7 - Allow skip-review bypass
  1284→              if (!options.skipReview && !forcingCompletion) {
  1285→                // AC: @spec-completion-enforcement ac-2
  1286→                if (foundTask.status === "in_progress") {
  1287→                  return {
  1288→                    success: false,
  1289→                    error: errors.status.completeRequiresReview,
  1290→                  };
  1291→                }
  1292→
  1293→                // AC: @spec-completion-enforcement ac-3
  1294→                if (foundTask.status === "pending") {
  1295→                  return {
  1296→                    success: false,
  1297→                    error: errors.status.completeRequiresStart,
  1298→                  };
  1299→                }
  1300→
  1301→                // AC: @spec-completion-enforcement ac-4
  1302→                if (foundTask.status === "blocked") {
  1303→                  return {
  1304→                    success: false,
  1305→                    error: errors.status.completeBlockedTask,
  1306→                  };
  1307→                }
  1308→
  1309→                // AC: @spec-completion-enforcement ac-5
  1310→                if (foundTask.status === "cancelled") {
  1311→                  return {
  1312→                    success: false,
  1313→                    error: errors.status.completeCancelledTask,
  1314→                  };
  1315→                }
  1316→
  1317→                // AC: @spec-completion-enforcement ac-1 - Only pending_review allowed
  1318→                if (foundTask.status !== "pending_review") {
  1319→                  return {
  1320→                    success: false,
  1321→                    error: errors.status.cannotComplete(foundTask.status),
  1322→                  };
  1323→                }
  1324→              }
  1325→
  1326→              const now = new Date().toISOString();
  1327→
  1328→              // AC: @spec-completion-enforcement ac-7 - Document skip-review reason
  1329→              // AC: @spec-completion-enforcement ac-author
  1330→              let taskNotes = foundTask.notes;
  1331→              if (options.skipReview && options.reason) {
  1332→                const skipNote = createNote(
  1333→                  `Completed with --skip-review: ${options.reason}`,
  1334→                  getAuthor(ctx.config?.identity?.author),
  1335→                );
  1336→                taskNotes = [...taskNotes, skipNote];
  1337→              }
  1338→
  1339→              // AC: @task-commands ac-1 - Document force completion from non-standard state
  1340→              const forcedFromNonStandard =
  1341→                forcingCompletion &&
  1342→                foundTask.status !== "pending_review";
  1343→              let forceStateDetail: string | undefined;
  1344→              if (forcedFromNonStandard) {
  1345→                forceStateDetail = `from ${foundTask.status} state`;
  1346→                if (foundTask.status === "blocked") {
  1347→                  const blockedBy = foundTask.blocked_by.join("; ");
  1348→                  forceStateDetail += `. Was blocked by: ${blockedBy || "(dependency-blocked)"}`;
  1349→                }
  1350→                let forceMessage = `Completed with --force ${forceStateDetail}`;
  1351→                if (options.reason) {
  1352→                  forceMessage += `. Reason: ${options.reason}`;
  1353→                }
  1354→                const forceNote = createNote(
  1355→                  forceMessage,
  1356→                  getAuthor(ctx.config?.identity?.author),
  1357→                );
  1358→                taskNotes = [...taskNotes, forceNote];
  1359→              }
  1360→
  1361→              // Update status
  1362→              const updatedTask: Task = {
  1363→                ...foundTask,
  1364→                status: "completed",
  1365→                completed_at: now,
  1366→                closed_reason: options.reason || null,
  1367→                started_at: foundTask.started_at || now,
  1368→                notes: taskNotes,
  1369→              };
  1370→
  1371→              await saveTask(ctx, updatedTask);
  1372→              await commitIfShadow(
  1373→                ctx.shadow,
  1374→                "task-complete",
  1375→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1376→                options.reason,
  1377→              );
  1378→
  1379→              // Sync spec implementation status (unless --no-sync)
  1380→              if (options.sync !== false && foundTask.spec_ref) {
  1381→                const updatedTasks = tasks.map((t) =>
  1382→                  t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t,
  1383→                );
  1384→                const syncResult = await syncSpecImplementationStatus(
  1385→                  ctx,
  1386→                  updatedTask as LoadedTask,
  1387→                  updatedTasks as LoadedTask[],
  1388→                  items,
  1389→                  index,
  1390→                );
  1391→                if (syncResult && !isJsonMode()) {
  1392→                  info(
  1393→                    `Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1394→                  );
  1395→                  await commitIfShadow(
  1396→                    ctx.shadow,
  1397→                    "spec-sync",
  1398→                    syncResult.specUlid.slice(0, 8),
  1399→                    `${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1400→                  );
  1401→                }
  1402→              }
  1403→
  1404→              // Show AC reminder for single-ref mode only (not in batch)
  1405→              if (!options.refs && foundTask.spec_ref && !isJsonMode()) {
  1406→                const specResult = index.resolve(foundTask.spec_ref);
  1407→                if (specResult.ok && specResult.item) {
  1408→                  const specItem = items.find(
  1409→                    (i) => i._ulid === specResult.ulid,
  1410→                  );
  1411→                  if (
  1412→                    specItem?.acceptance_criteria &&
  1413→                    specItem.acceptance_criteria.length > 0
  1414→                  ) {
  1415→                    const count = specItem.acceptance_criteria.length;
  1416→                    console.log(
  1417→                      `\n⚠ Linked spec ${foundTask.spec_ref} has ${count} acceptance criteri${count === 1 ? "on" : "a"} - verify they are covered\n`,
  1418→                    );
  1419→                  }
  1420→                }
  1421→              }
  1422→
  1423→              // AC: @task-commands ac-1 - Show warning when force-completing from non-standard state
  1424→              let warningMsg: string | undefined;
  1425→              if (forcedFromNonStandard) {
  1426→                warningMsg = `Task was force-completed ${forceStateDetail}`;
  1427→                if (!isJsonMode()) {
  1428→                  warn(warningMsg);
  1429→                }
  1430→              }
  1431→
  1432→              return {
  1433→                success: true,
  1434→                message: `Completed task: ${index.shortUlid(updatedTask._ulid)}`,
  1435→                data: updatedTask,
  1436→                ...(warningMsg && { warning: warningMsg }),
  1437→              };
  1438→            } catch (err) {
  1439→              return {
  1440→                success: false,
  1441→                error: err instanceof Error ? err.message : String(err),
  1442→              };
  1443→            }
  1444→          },
  1445→          getUlid: (task) => task._ulid,
  1446→        });
  1447→
  1448→        // AC: @multi-ref-batch ac-5, ac-6
  1449→        formatBatchOutput(result, "Complete");
  1450→
  1451→        // Show commit guidance for single-ref mode only
  1452→        if (
  1453→          !options.refs &&
  1454→          result.success &&
  1455→          result.results.length === 1 &&
  1456→          !isJsonMode()
  1457→        ) {
  1458→          const taskData = result.results[0].data as Task | undefined;
  1459→          if (taskData) {
  1460→            const guidance = formatCommitGuidance(taskData);
  1461→            printCommitGuidance(guidance);
  1462→          }
  1463→        }
  1464→      } catch (err) {
  1465→        error(errors.failures.completeTask, err);
  1466→        process.exit(EXIT_CODES.ERROR);
  1467→      }
  1468→    });
  1469→
  1470→  // kspec task submit <ref>
  1471→  // Transitions in_progress → pending_review (code done, awaiting merge)
  1472→  markMutating(task.command("submit <ref>"))
  1473→    .description("Submit task for review (transitions to pending_review)")
  1474→    .action(async (ref: string) => {
  1475→      try {
  1476→        const ctx = await initContext();
  1477→        const tasks = await loadAllTasks(ctx);
  1478→        const items = await loadAllItems(ctx);
  1479→        const index = new ReferenceIndex(tasks, items);
  1480→        const foundTask = resolveTaskRef(ref, tasks, index);
  1481→
  1482→        if (foundTask.status !== "in_progress") {
  1483→          error(
  1484→            `Cannot submit task with status: ${foundTask.status}. Task must be in_progress.`,
  1485→          );
  1486→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1487→        }
  1488→
  1489→        const updatedTask: Task = {
  1490→          ...foundTask,
  1491→          status: "pending_review",
  1492→          submitted_at: new Date().toISOString(),
  1493→        };
  1494→
  1495→        await saveTask(ctx, updatedTask);
  1496→        await commitIfShadow(
  1497→          ctx.shadow,
  1498→          "task-submit",
  1499→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1500→        );
  1501→        success(
  1502→          `Submitted task for review: ${index.shortUlid(updatedTask._ulid)}`,
  1503→          { task: updatedTask },
  1504→        );
  1505→      } catch (err) {
  1506→        error(errors.failures.updateTask, err);
  1507→        process.exit(EXIT_CODES.ERROR);
  1508→      }
  1509→    });
  1510→
  1511→  // kspec task needs-work <ref>
  1512→  // Reviewer kicks back a task for worker to fix
  1513→  markMutating(task.command("needs-work <ref>"))
  1514→    .description(
  1515→      "Kick task back to worker for fixes (pending_review -> needs_work)",
  1516→    )
  1517→    .requiredOption("--reason <reason>", "Description of issues found")
  1518→    .action(async (ref: string, options) => {
  1519→      try {
  1520→        const ctx = await initContext();
  1521→        const tasks = await loadAllTasks(ctx);
  1522→        const items = await loadAllItems(ctx);
  1523→        const index = new ReferenceIndex(tasks, items);
  1524→        const foundTask = resolveTaskRef(ref, tasks, index);
  1525→
  1526→        if (foundTask.status !== "pending_review") {
  1527→          error(errors.status.cannotNeedsWork(foundTask.status));
  1528→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1529→        }
  1530→
  1531→        // Track fix cycle count from existing kickback notes
  1532→        const existingKickbacks = foundTask.notes.filter((n) =>
  1533→          n.content.includes("[FIX_CYCLE:"),
  1534→        ).length;
  1535→        const cycleNumber = existingKickbacks + 1;
  1536→
  1537→        const note = createNote(
  1538→          `[FIX_CYCLE: ${cycleNumber}] Review findings: ${options.reason}`,
  1539→          getAuthor(ctx.config?.identity?.author),
  1540→        );
  1541→
  1542→        // AC: @session-scoped-task-claiming ac-claim-clear
  1543→        const updatedTask: Task = {
  1544→          ...foundTask,
  1545→          status: "needs_work",
  1546→          session_id: null,
  1547→          notes: [...foundTask.notes, note],
  1548→        };
  1549→
  1550→        await saveTask(ctx, updatedTask);
  1551→        await commitIfShadow(
  1552→          ctx.shadow,
  1553→          "task-needs-work",
  1554→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1555→          `cycle ${cycleNumber}`,
  1556→        );
  1557→        success(
  1558→          `Kicked back task: ${index.shortUlid(updatedTask._ulid)} (fix cycle ${cycleNumber})`,
  1559→          { task: updatedTask },
  1560→        );
  1561→      } catch (err) {
  1562→        error(errors.failures.needsWorkTask, err);
  1563→        process.exit(EXIT_CODES.ERROR);
  1564→      }
  1565→    });
  1566→
  1567→  // kspec task block <ref>
  1568→  markMutating(task.command("block <ref>"))
  1569→    .description("Block a task")
  1570→    .requiredOption("--reason <reason>", "Reason for blocking")
  1571→    .action(async (ref: string, options) => {
  1572→      try {
  1573→        const ctx = await initContext();
  1574→        const tasks = await loadAllTasks(ctx);
  1575→        const items = await loadAllItems(ctx);
  1576→        const index = new ReferenceIndex(tasks, items);
  1577→        const foundTask = resolveTaskRef(ref, tasks, index);
  1578→
  1579→        if (
  1580→          foundTask.status === "completed" ||
  1581→          foundTask.status === "cancelled"
  1582→        ) {
  1583→          error(errors.status.cannotBlock(foundTask.status));
  1584→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1585→        }
  1586→
  1587→        const updatedTask: Task = {
  1588→          ...foundTask,
  1589→          status: "blocked",
  1590→          blocked_by: [...foundTask.blocked_by, options.reason],
  1591→        };
  1592→
  1593→        await saveTask(ctx, updatedTask);
  1594→        await commitIfShadow(
  1595→          ctx.shadow,
  1596→          "task-block",
  1597→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1598→        );
  1599→        success(`Blocked task: ${index.shortUlid(updatedTask._ulid)}`, {
  1600→          task: updatedTask,
  1601→        });
  1602→      } catch (err) {
  1603→        error(errors.failures.blockTask, err);
  1604→        process.exit(EXIT_CODES.ERROR);
  1605→      }
  1606→    });
  1607→
  1608→  // kspec task unblock <ref>
  1609→  markMutating(task.command("unblock <ref>"))
  1610→    .description("Unblock a task")
  1611→    .action(async (ref: string) => {
  1612→      try {
  1613→        const ctx = await initContext();
  1614→        const tasks = await loadAllTasks(ctx);
  1615→        const items = await loadAllItems(ctx);
  1616→        const index = new ReferenceIndex(tasks, items);
  1617→        const foundTask = resolveTaskRef(ref, tasks, index);
  1618→
  1619→        if (foundTask.status !== "blocked") {
  1620→          warn("Task is not blocked");
  1621→          return;
  1622→        }
  1623→
  1624→        // AC: @session-scoped-task-claiming ac-claim-clear
  1625→        const updatedTask: Task = {
  1626→          ...foundTask,
  1627→          status: "pending",
  1628→          blocked_by: [],
  1629→          session_id: null,
  1630→        };
  1631→
  1632→        await saveTask(ctx, updatedTask);
  1633→        await commitIfShadow(
  1634→          ctx.shadow,
  1635→          "task-unblock",
  1636→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1637→        );
  1638→        success(`Unblocked task: ${index.shortUlid(updatedTask._ulid)}`, {
  1639→          task: updatedTask,
  1640→        });
  1641→      } catch (err) {
  1642→        error(errors.failures.unblockTask, err);
  1643→        process.exit(EXIT_CODES.ERROR);
  1644→      }
  1645→    });
  1646→
  1647→  // kspec task cancel <ref> | --refs <refs...>
  1648→  // AC: @multi-ref-batch ac-1, ac-2
  1649→  markMutating(task.command("cancel [ref]"))
  1650→    .description("Cancel a task")
  1651→    .option("--refs <refs...>", "Cancel multiple tasks by ref")
  1652→    .option("--reason <reason>", "Cancellation reason")
  1653→    .addHelpText(
  1654→      "after",
  1655→      `
  1656→Examples:
  1657→  $ kspec task cancel @task-slug --reason "No longer needed"
  1658→  $ kspec task cancel --refs @task1 @task2 --reason "Superseded by @new-task"`,
  1659→    )
  1660→    .action(async (ref: string | undefined, options) => {
  1661→      try {
  1662→        const ctx = await initContext();
  1663→        const tasks = await loadAllTasks(ctx);
  1664→        const items = await loadAllItems(ctx);
  1665→        const index = new ReferenceIndex(tasks, items);
  1666→
  1667→        const result = await executeBatchOperation({
  1668→          positionalRef: ref,
  1669→          refsFlag: options.refs,
  1670→          context: { ctx, tasks, items, index, options },
  1671→          items: tasks,
  1672→          index,
  1673→          resolveRef: (refStr, taskList, idx) => {
  1674→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1675→            return { item: resolved.task, error: resolved.error };
  1676→          },
  1677→          executeOperation: async (foundTask, { ctx, index, options }) => {
  1678→            try {
  1679→              if (
  1680→                foundTask.status === "completed" ||
  1681→                foundTask.status === "cancelled"
  1682→              ) {
  1683→                return {
  1684→                  success: false,
  1685→                  error: `Task is already ${foundTask.status}`,
  1686→                };
  1687→              }
  1688→
  1689→              const updatedTask: Task = {
  1690→                ...foundTask,
  1691→                status: "cancelled",
  1692→                closed_reason: options.reason || null,
  1693→              };
  1694→
  1695→              await saveTask(ctx, updatedTask);
  1696→              await commitIfShadow(
  1697→                ctx.shadow,
  1698→                "task-cancel",
  1699→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1700→              );
  1701→
  1702→              return {
  1703→                success: true,
  1704→                message: `Cancelled task: ${index.shortUlid(updatedTask._ulid)}`,
  1705→                data: updatedTask,
  1706→              };
  1707→            } catch (err) {
  1708→              return {
  1709→                success: false,
  1710→                error: err instanceof Error ? err.message : String(err),
  1711→              };
  1712→            }
  1713→          },
  1714→          getUlid: (task) => task._ulid,
  1715→        });
  1716→
  1717→        formatBatchOutput(result, "Cancel");
  1718→      } catch (err) {
  1719→        error(errors.failures.cancelTask, err);
  1720→        process.exit(EXIT_CODES.ERROR);
  1721→      }
  1722→    });
  1723→
  1724→  // kspec task reset <ref>
  1725→  // AC: @spec-task-reset ac-1, ac-2, ac-3, ac-4, ac-5, ac-6
  1726→  markMutating(task.command("reset <ref>"))
  1727→    .description("Reset a task to pending state")
  1728→    .action(async (ref: string) => {
  1729→      try {
  1730→        const ctx = await initContext();
  1731→        const tasks = await loadAllTasks(ctx);
  1732→        const items = await loadAllItems(ctx);
  1733→        const index = new ReferenceIndex(tasks, items);
  1734→        const foundTask = resolveTaskRef(ref, tasks, index);
  1735→
  1736→        // AC: @spec-task-reset ac-2 - Error if already pending
  1737→        if (foundTask.status === "pending") {
  1738→          error("Task is already pending");
  1739→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1740→        }
  1741→
  1742→        // Track previous status and reason for note (AC-4)
  1743→        const previousStatus = foundTask.status;
  1744→        const hadCancelReason =
  1745→          foundTask.closed_reason && foundTask.status === "cancelled";
  1746→        const cancelReasonText = hadCancelReason
  1747→          ? ` (was cancelled: ${foundTask.closed_reason})`
  1748→          : "";
  1749→
  1750→        // AC: @spec-task-reset ac-1 - Reset to pending, clear completion-related fields
  1751→        const clearedFields: string[] = [];
  1752→        const updatedTask: Task = {
  1753→          ...foundTask,
  1754→          status: "pending",
  1755→        };
  1756→
  1757→        // Clear timestamps and reasons based on previous status
  1758→        if (
  1759→          foundTask.completed_at !== undefined &&
  1760→          foundTask.completed_at !== null
  1761→        ) {
  1762→          updatedTask.completed_at = null;
  1763→          clearedFields.push("completed_at");
  1764→        }
  1765→        if (
  1766→          foundTask.started_at !== undefined &&
  1767→          foundTask.started_at !== null
  1768→        ) {
  1769→          updatedTask.started_at = null;
  1770→          clearedFields.push("started_at");
  1771→        }
  1772→        if (
  1773→          foundTask.closed_reason !== undefined &&
  1774→          foundTask.closed_reason !== null
  1775→        ) {
  1776→          updatedTask.closed_reason = null;
  1777→          clearedFields.push("closed_reason");
  1778→        }
  1779→        if (foundTask.blocked_by.length > 0) {
  1780→          updatedTask.blocked_by = [];
  1781→          clearedFields.push("blocked_by");
  1782→        }
  1783→        // AC: @session-scoped-task-claiming ac-claim-clear
  1784→        if (foundTask.session_id) {
  1785→          updatedTask.session_id = null;
  1786→          clearedFields.push("session_id");
  1787→        }
  1788→
  1789→        // AC: @spec-task-reset ac-4 - Add note documenting the reset
  1790→        // AC: @spec-task-reset ac-author
  1791→        const noteContent = `Reset from ${previousStatus} to pending${cancelReasonText}`;
  1792→        const note = createNote(noteContent, getAuthor(ctx.config?.identity?.author));
  1793→        updatedTask.notes = [...updatedTask.notes, note];
  1794→
  1795→        await saveTask(ctx, updatedTask);
  1796→        // AC: @spec-task-reset ac-3 - Shadow commit with message task-reset
  1797→        await commitIfShadow(
  1798→          ctx.shadow,
  1799→          "task-reset",
  1800→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1801→          `from ${previousStatus}`,
  1802→        );
  1803→
  1804→        // AC: @spec-task-reset ac-6 - JSON output includes previous_status, new_status, cleared_fields
  1805→        const jsonOutput = {
  1806→          task: updatedTask,
  1807→          previous_status: previousStatus,
  1808→          new_status: "pending" as const,
  1809→          cleared_fields: clearedFields,
  1810→        };
  1811→
  1812→        output(jsonOutput, () => {
  1813→          success(
  1814→            `Reset task: ${index.shortUlid(updatedTask._ulid)} (${previousStatus} → pending)`,
  1815→            undefined,
  1816→          );
  1817→          if (clearedFields.length > 0) {
  1818→            info(`Cleared fields: ${clearedFields.join(", ")}`);
  1819→          }
  1820→        });
  1821→      } catch (err) {
  1822→        error("Failed to reset task", err);
  1823→        process.exit(EXIT_CODES.ERROR);
  1824→      }
  1825→    });
  1826→
  1827→  // kspec task delete <ref> | --refs <refs...>
  1828→  // AC: @multi-ref-batch ac-1, ac-2
  1829→  markMutating(task.command("delete [ref]"))
  1830→    .description("Delete a task permanently")
  1831→    .option("--refs <refs...>", "Delete multiple tasks by ref")
  1832→    .option("--force", "Skip confirmation (required for --refs)")
  1833→    .option("--dry-run", "Show what would be deleted without deleting")
  1834→    .addHelpText(
  1835→      "after",
  1836→      `
  1837→Examples:
  1838→  $ kspec task delete @task-slug
  1839→  $ kspec task delete --refs @task1 @task2 --force
  1840→  $ kspec task delete --refs @task1 @task2 --dry-run`,
  1841→    )
  1842→    .action(async (ref: string | undefined, options) => {
  1843→      try {
  1844→        const ctx = await initContext();
  1845→        const tasks = await loadAllTasks(ctx);
  1846→        const items = await loadAllItems(ctx);
  1847→        const index = new ReferenceIndex(tasks, items);
  1848→
  1849→        // For batch mode (--refs), require --force
  1850→        if (
  1851→          options.refs &&
  1852→          options.refs.length > 0 &&
  1853→          !options.force &&
  1854→          !options.dryRun
  1855→        ) {
  1856→          error("Batch delete requires --force flag");
  1857→          process.exit(EXIT_CODES.USAGE_ERROR);
  1858→        }
  1859→
  1860→        const result = await executeBatchOperation({
  1861→          positionalRef: ref,
  1862→          refsFlag: options.refs,
  1863→          context: { ctx, tasks, items, index, options },
  1864→          items: tasks,
  1865→          index,
  1866→          resolveRef: (refStr, taskList, idx) => {
  1867→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1868→            return { item: resolved.task, error: resolved.error };
  1869→          },
  1870→          executeOperation: async (foundTask, { ctx, index, options }) => {
  1871→            try {
  1872→              const taskDisplay = `${foundTask.title} (${index.shortUlid(foundTask._ulid)})`;
  1873→
  1874→              if (options.dryRun) {
  1875→                return {
  1876→                  success: true,
  1877→                  message: `Would delete: ${taskDisplay}`,
  1878→                };
  1879→              }
  1880→
  1881→              // For single-ref mode (not --refs), prompt for confirmation unless --force
  1882→              if (!options.refs && !options.force) {
  1883→                const readline = await import("node:readline");
  1884→                const rl = readline.createInterface({
  1885→                  input: process.stdin,
  1886→                  output: process.stdout,
  1887→                });
  1888→
  1889→                const answer = await new Promise<string>((resolve) => {
  1890→                  rl.question(`Delete task "${taskDisplay}"? [y/N] `, resolve);
  1891→                });
  1892→                rl.close();
  1893→
  1894→                if (answer.toLowerCase() !== "y") {
  1895→                  return {
  1896→                    success: false,
  1897→                    error: "Deletion cancelled by user",
  1898→                  };
  1899→                }
  1900→              }
  1901→
  1902→              await deleteTask(ctx, foundTask);
  1903→              await commitIfShadow(
  1904→                ctx.shadow,
  1905→                "task-delete",
  1906→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1907→                foundTask.title,
  1908→              );
  1909→
  1910→              return {
  1911→                success: true,
  1912→                message: `Deleted task: ${taskDisplay}`,
  1913→              };
  1914→            } catch (err) {
  1915→              return {
  1916→                success: false,
  1917→                error: err instanceof Error ? err.message : String(err),
  1918→              };
  1919→            }
  1920→          },
  1921→          getUlid: (task) => task._ulid,
  1922→        });
  1923→
  1924→        formatBatchOutput(result, "Delete");
  1925→      } catch (err) {
  1926→        error(errors.failures.deleteTask, err);
  1927→        process.exit(EXIT_CODES.ERROR);
  1928→      }
  1929→    });
  1930→
  1931→  // kspec task note <ref> <message>
  1932→  markMutating(task.command("note <ref> <message>"))
  1933→    .description("Add a note to a task")
