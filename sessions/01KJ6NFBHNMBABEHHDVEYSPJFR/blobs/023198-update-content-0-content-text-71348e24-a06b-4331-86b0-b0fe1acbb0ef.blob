  1971→          if (specResult.ok && specResult.item) {
  1972→            const specItem = specResult.item as {
  1973→              acceptance_criteria?: unknown[];
  1974→            };
  1975→            if (
  1976→              specItem.acceptance_criteria &&
  1977→              specItem.acceptance_criteria.length > 0
  1978→            ) {
  1979→              console.log("");
  1980→              console.log(
  1981→                alignmentCheck.testCoverage(
  1982→                  specItem.acceptance_criteria.length,
  1983→                ),
  1984→              );
  1985→            }
  1986→          }
  1987→        }
  1988→      } catch (err) {
  1989→        error(errors.failures.addNote, err);
  1990→        process.exit(EXIT_CODES.ERROR);
  1991→      }
  1992→    });
