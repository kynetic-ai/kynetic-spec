  2230→    });
  2231→
  2232→  // Create subcommand group for todo operations
  2233→  const todoCmd = task.command("todo").description("Manage task todos");
  2234→
  2235→  // kspec task todo add <ref> <text>
  2236→  markMutating(todoCmd.command("add <ref> <text>"))
  2237→    .description("Add a todo to a task")
  2238→    .option("--author <author>", "Todo author")
  2239→    .action(async (ref: string, text: string, options) => {
  2240→      try {
  2241→        const ctx = await initContext();
  2242→        const tasks = await loadAllTasks(ctx);
  2243→        const items = await loadAllItems(ctx);
  2244→        const index = new ReferenceIndex(tasks, items);
  2245→        const foundTask = resolveTaskRef(ref, tasks, index);
  2246→
  2247→        // Calculate next ID (max existing + 1, or 1 if none)
  2248→        const nextId =
  2249→          foundTask.todos.length > 0
  2250→            ? Math.max(...foundTask.todos.map((t) => t.id)) + 1
  2251→            : 1;
  2252→
  2253→        const todo = createTodo(nextId, text, options.author);
  2254→
  2255→        const updatedTask: Task = {
  2256→          ...foundTask,
  2257→          todos: [...foundTask.todos, todo],
  2258→        };
  2259→
  2260→        await saveTask(ctx, updatedTask);
  2261→        await commitIfShadow(
  2262→          ctx.shadow,
  2263→          "task-note",
  2264→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2265→        );
  2266→        success(
  2267→          `Added todo #${todo.id} to task: ${index.shortUlid(updatedTask._ulid)}`,
  2268→          { todo },
  2269→        );
  2270→      } catch (err) {
  2271→        error(errors.failures.addTodo, err);
  2272→        process.exit(EXIT_CODES.ERROR);
  2273→      }
  2274→    });
  2275→
  2276→  // kspec task todo done <ref> <id>
  2277→  markMutating(todoCmd.command("done <ref> <id>"))
  2278→    .description("Mark a todo as done")
  2279→    .action(async (ref: string, idStr: string) => {
  2280→      try {
  2281→        const ctx = await initContext();
  2282→        const tasks = await loadAllTasks(ctx);
  2283→        const items = await loadAllItems(ctx);
  2284→        const index = new ReferenceIndex(tasks, items);
  2285→        const foundTask = resolveTaskRef(ref, tasks, index);
  2286→
  2287→        const id = parseInt(idStr, 10);
  2288→        if (Number.isNaN(id)) {
  2289→          error(errors.todo.invalidId(idStr));
  2290→          process.exit(EXIT_CODES.USAGE_ERROR);
  2291→        }
  2292→
  2293→        const todoIndex = foundTask.todos.findIndex((t) => t.id === id);
  2294→        if (todoIndex === -1) {
  2295→          error(errors.todo.notFound(id));
  2296→          process.exit(EXIT_CODES.NOT_FOUND);
  2297→        }
  2298→
  2299→        if (foundTask.todos[todoIndex].done) {
  2300→          warn(`Todo #${id} is already done`);
  2301→          return;
  2302→        }
  2303→
  2304→        const updatedTodos = [...foundTask.todos];
  2305→        updatedTodos[todoIndex] = {
  2306→          ...updatedTodos[todoIndex],
  2307→          done: true,
  2308→          done_at: new Date().toISOString(),
  2309→        };
  2310→
  2311→        const updatedTask: Task = {
  2312→          ...foundTask,
  2313→          todos: updatedTodos,
  2314→        };
  2315→
  2316→        await saveTask(ctx, updatedTask);
  2317→        await commitIfShadow(
  2318→          ctx.shadow,
  2319→          "task-note",
  2320→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2321→        );
  2322→        success(`Marked todo #${id} as done`, {
  2323→          todo: updatedTodos[todoIndex],
  2324→        });
  2325→      } catch (err) {
  2326→        error(errors.failures.markTodoDone, err);
  2327→        process.exit(EXIT_CODES.ERROR);
  2328→      }
  2329→    });
  2330→
  2331→  // kspec task todo undone <ref> <id>
  2332→  markMutating(todoCmd.command("undone <ref> <id>"))
  2333→    .description("Mark a todo as not done")
  2334→    .action(async (ref: string, idStr: string) => {
  2335→      try {
  2336→        const ctx = await initContext();
  2337→        const tasks = await loadAllTasks(ctx);
  2338→        const items = await loadAllItems(ctx);
  2339→        const index = new ReferenceIndex(tasks, items);
  2340→        const foundTask = resolveTaskRef(ref, tasks, index);
  2341→
  2342→        const id = parseInt(idStr, 10);
  2343→        if (Number.isNaN(id)) {
  2344→          error(errors.todo.invalidId(idStr));
  2345→          process.exit(EXIT_CODES.USAGE_ERROR);
  2346→        }
  2347→
  2348→        const todoIndex = foundTask.todos.findIndex((t) => t.id === id);
  2349→        if (todoIndex === -1) {
  2350→          error(errors.todo.notFound(id));
  2351→          process.exit(EXIT_CODES.NOT_FOUND);
  2352→        }
  2353→
  2354→        if (!foundTask.todos[todoIndex].done) {
  2355→          warn(`Todo #${id} is not done`);
  2356→          return;
  2357→        }
  2358→
  2359→        const updatedTodos = [...foundTask.todos];
  2360→        updatedTodos[todoIndex] = {
  2361→          ...updatedTodos[todoIndex],
  2362→          done: false,
  2363→          done_at: undefined,
  2364→        };
  2365→
  2366→        const updatedTask: Task = {
  2367→          ...foundTask,
  2368→          todos: updatedTodos,
  2369→        };
  2370→
  2371→        await saveTask(ctx, updatedTask);
  2372→        await commitIfShadow(
  2373→          ctx.shadow,
  2374→          "task-note",
  2375→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2376→        );
  2377→        success(`Marked todo #${id} as not done`, {
  2378→          todo: updatedTodos[todoIndex],
  2379→        });
  2380→      } catch (err) {
  2381→        error(errors.failures.markTodoNotDone, err);
  2382→        process.exit(EXIT_CODES.ERROR);
  2383→      }
  2384→    });
  2385→}
