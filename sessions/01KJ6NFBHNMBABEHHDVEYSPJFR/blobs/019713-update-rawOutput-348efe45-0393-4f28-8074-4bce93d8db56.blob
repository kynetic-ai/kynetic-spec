  2003→  // kspec task review <ref>
  2004→  task
  2005→    .command("review <ref>")
  2006→    .description(
  2007→      "Get task context for review (task details, spec, ACs, git diff)",
  2008→    )
  2009→    .action(async (ref: string) => {
  2010→      try {
  2011→        const ctx = await initContext();
  2012→        const tasks = await loadAllTasks(ctx);
  2013→        const items = await loadAllItems(ctx);
  2014→        const index = new ReferenceIndex(tasks, items);
  2015→        const foundTask = resolveTaskRef(ref, tasks, index);
  2016→
  2017→        // Import getDiffSince from utils
  2018→        const { getDiffSince } = await import("../../utils/index.js");
  2019→
  2020→        // Gather review context
  2021→        const reviewContext: {
  2022→          task: typeof foundTask;
  2023→          spec: LoadedSpecItem | null;
  2024→          diff: string | null;
  2025→          started_at: string | null;
  2026→          testCoverage?: { covered: string[]; uncovered: string[] };
  2027→        } = {
  2028→          task: foundTask,
  2029→          spec: null,
  2030→          diff: null,
  2031→          started_at: foundTask.started_at || null,
  2032→        };
  2033→
  2034→        // Get spec item if task has spec_ref
  2035→        if (foundTask.spec_ref) {
  2036→          const specResult = index.resolve(foundTask.spec_ref);
  2037→          if (specResult.ok) {
  2038→            const specItem = items.find((i) => i._ulid === specResult.ulid);
  2039→            reviewContext.spec = specItem || null;
  2040→
  2041→            // Check test coverage for ACs if spec has them
  2042→            if (
  2043→              specItem?.acceptance_criteria &&
  2044→              specItem.acceptance_criteria.length > 0
  2045→            ) {
  2046→              const coveredACs = await scanTestCoverage(ctx.rootDir);
  2047→              const covered: string[] = [];
  2048→              const uncovered: string[] = [];
  2049→
  2050→              for (const ac of specItem.acceptance_criteria) {
  2051→                // Build possible references
  2052→                const possibleRefs: string[] = [];
  2053→                if (specItem.slugs && specItem.slugs.length > 0) {
  2054→                  possibleRefs.push(`@${specItem.slugs[0]} ${ac.id}`);
  2055→                  possibleRefs.push(`@${specItem.slugs[0]}`);
  2056→                }
  2057→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)} ${ac.id}`);
  2058→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)}`);
  2059→
  2060→                const isCovered = possibleRefs.some((ref) =>
  2061→                  coveredACs.has(ref),
  2062→                );
  2063→                if (isCovered) {
  2064→                  covered.push(ac.id);
  2065→                } else {
  2066→                  uncovered.push(ac.id);
  2067→                }
  2068→              }
  2069→
  2070→              reviewContext.testCoverage = { covered, uncovered };
  2071→            }
  2072→          }
  2073→        }
  2074→
  2075→        // Get git diff since task started
  2076→        if (foundTask.started_at) {
  2077→          const startedDate = new Date(foundTask.started_at);
  2078→          reviewContext.diff = getDiffSince(startedDate, ctx.rootDir);
  2079→        }
  2080→
  2081→        output(reviewContext, () => {
  2082→          console.log("=".repeat(60));
  2083→          console.log("Task Review Context");
  2084→          console.log("=".repeat(60));
  2085→          console.log();
  2086→
  2087→          // Task details
  2088→          console.log("TASK DETAILS");
  2089→          console.log("-".repeat(60));
  2090→          console.log(formatTaskDetails(foundTask, index));
  2091→          console.log();
  2092→
  2093→          // Spec details
  2094→          if (reviewContext.spec) {
  2095→            console.log("LINKED SPEC");
  2096→            console.log("-".repeat(60));
  2097→            console.log(`Title: ${reviewContext.spec.title}`);
  2098→            console.log(`Type: ${reviewContext.spec.type}`);
  2099→            if (reviewContext.spec.description) {
  2100→              console.log(`\nDescription:\n${reviewContext.spec.description}`);
  2101→            }
  2102→            if (
  2103→              reviewContext.spec.acceptance_criteria &&
  2104→              reviewContext.spec.acceptance_criteria.length > 0
  2105→            ) {
  2106→              console.log(
  2107→                `\nAcceptance Criteria (${reviewContext.spec.acceptance_criteria.length}):`,
  2108→              );
  2109→              for (const ac of reviewContext.spec.acceptance_criteria) {
  2110→                const isCovered = reviewContext.testCoverage?.covered.includes(
  2111→                  ac.id,
  2112→                );
  2113→                const coverageMarker = isCovered
  2114→                  ? chalk.green("✓")
  2115→                  : chalk.yellow("○");
  2116→                console.log(`  ${coverageMarker} [${ac.id}]`);
  2117→                console.log(`    Given: ${ac.given}`);
  2118→                console.log(`    When: ${ac.when}`);
  2119→                console.log(`    Then: ${ac.then}`);
  2120→              }
  2121→
  2122→              // Test coverage summary
  2123→              if (reviewContext.testCoverage) {
  2124→                const { covered, uncovered } = reviewContext.testCoverage;
  2125→                console.log();
  2126→                if (uncovered.length === 0) {
  2127→                  console.log(
  2128→                    chalk.green(
  2129→                      `  ✓ All ${covered.length} AC(s) have test coverage`,
  2130→                    ),
  2131→                  );
  2132→                } else {
  2133→                  console.log(
  2134→                    chalk.yellow(
  2135→                      `  Test coverage: ${covered.length}/${covered.length + uncovered.length} ACs covered`,
  2136→                    ),
  2137→                  );
  2138→                  console.log(
  2139→                    chalk.yellow(
  2140→                      `  Missing coverage for: ${uncovered.join(", ")}`,
  2141→                    ),
  2142→                  );
  2143→                }
  2144→              }
  2145→            }
  2146→            console.log();
  2147→          }
  2148→
  2149→          // Git diff
  2150→          if (reviewContext.diff) {
  2151→            console.log("CHANGES SINCE TASK STARTED");
  2152→            console.log("-".repeat(60));
  2153→            console.log(`Started at: ${foundTask.started_at}`);
  2154→            console.log();
  2155→            console.log(reviewContext.diff);
  2156→            console.log();
  2157→          } else if (foundTask.started_at) {
  2158→            console.log("CHANGES SINCE TASK STARTED");
  2159→            console.log("-".repeat(60));
  2160→            console.log(`Started at: ${foundTask.started_at}`);
  2161→            console.log("No changes detected");
  2162→            console.log();
  2163→          }
  2164→
  2165→          console.log("=".repeat(60));
  2166→          console.log("Review Checklist:");
  2167→          console.log("- Does the implementation match the task description?");
  2168→          if (reviewContext.spec) {
  2169→            console.log("- Are all acceptance criteria covered?");
  2170→            console.log("- Is test coverage adequate?");
  2171→          }
  2172→          console.log("- Are there any gaps or issues?");
  2173→          console.log("=".repeat(60));
  2174→        });
  2175→      } catch (err) {
  2176→        error("Failed to generate review context", err);
  2177→        process.exit(EXIT_CODES.ERROR);
  2178→      }
  2179→    });
