  2214→  // kspec task todo add <ref> <text>
  2215→  markMutating(todoCmd.command("add <ref> <text>"))
  2216→    .description("Add a todo to a task")
  2217→    .option("--author <author>", "Todo author")
  2218→    .action(async (ref: string, text: string, options) => {
  2219→      try {
  2220→        const ctx = await initContext();
  2221→        const tasks = await loadAllTasks(ctx);
  2222→        const items = await loadAllItems(ctx);
  2223→        const index = new ReferenceIndex(tasks, items);
  2224→        const foundTask = resolveTaskRef(ref, tasks, index);
  2225→
  2226→        // Calculate next ID (max existing + 1, or 1 if none)
  2227→        const nextId =
  2228→          foundTask.todos.length > 0
  2229→            ? Math.max(...foundTask.todos.map((t) => t.id)) + 1
  2230→            : 1;
  2231→
  2232→        const todo = createTodo(nextId, text, options.author);
  2233→
  2234→        const updatedTask: Task = {
  2235→          ...foundTask,
  2236→          todos: [...foundTask.todos, todo],
  2237→        };
  2238→
  2239→        await saveTask(ctx, updatedTask);
  2240→        await commitIfShadow(
  2241→          ctx.shadow,
  2242→          "task-note",
  2243→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2244→        );
  2245→        success(
  2246→          `Added todo #${todo.id} to task: ${index.shortUlid(updatedTask._ulid)}`,
  2247→          { todo },
  2248→        );
  2249→      } catch (err) {
  2250→        error(errors.failures.addTodo, err);
  2251→        process.exit(EXIT_CODES.ERROR);
  2252→      }
  2253→    });
  2254→
  2255→  // kspec task todo done <ref> <id>
  2256→  markMutating(todoCmd.command("done <ref> <id>"))
  2257→    .description("Mark a todo as done")
  2258→    .action(async (ref: string, idStr: string) => {
  2259→      try {
  2260→        const ctx = await initContext();
  2261→        const tasks = await loadAllTasks(ctx);
  2262→        const items = await loadAllItems(ctx);
  2263→        const index = new ReferenceIndex(tasks, items);
  2264→        const foundTask = resolveTaskRef(ref, tasks, index);
  2265→
  2266→        const id = parseInt(idStr, 10);
  2267→        if (Number.isNaN(id)) {
  2268→          error(errors.todo.invalidId(idStr));
  2269→          process.exit(EXIT_CODES.USAGE_ERROR);
  2270→        }
  2271→
  2272→        const todoIndex = foundTask.todos.findIndex((t) => t.id === id);
  2273→        if (todoIndex === -1) {
  2274→          error(errors.todo.notFound(id));
  2275→          process.exit(EXIT_CODES.NOT_FOUND);
  2276→        }
  2277→
  2278→        if (foundTask.todos[todoIndex].done) {
  2279→          warn(`Todo #${id} is already done`);
  2280→          return;
  2281→        }
  2282→
  2283→        const updatedTodos = [...foundTask.todos];
  2284→        updatedTodos[todoIndex] = {
  2285→          ...updatedTodos[todoIndex],
  2286→          done: true,
  2287→          done_at: new Date().toISOString(),
  2288→        };
  2289→
  2290→        const updatedTask: Task = {
  2291→          ...foundTask,
  2292→          todos: updatedTodos,
  2293→        };
  2294→
  2295→        await saveTask(ctx, updatedTask);
  2296→        await commitIfShadow(
  2297→          ctx.shadow,
  2298→          "task-note",
  2299→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2300→        );
  2301→        success(`Marked todo #${id} as done`, {
  2302→          todo: updatedTodos[todoIndex],
  2303→        });
  2304→      } catch (err) {
  2305→        error(errors.failures.markTodoDone, err);
  2306→        process.exit(EXIT_CODES.ERROR);
  2307→      }
  2308→    });
  2309→
  2310→  // kspec task todo undone <ref> <id>
  2311→  markMutating(todoCmd.command("undone <ref> <id>"))
  2312→    .description("Mark a todo as not done")
  2313→    .action(async (ref: string, idStr: string) => {
  2314→      try {
  2315→        const ctx = await initContext();
  2316→        const tasks = await loadAllTasks(ctx);
  2317→        const items = await loadAllItems(ctx);
  2318→        const index = new ReferenceIndex(tasks, items);
  2319→        const foundTask = resolveTaskRef(ref, tasks, index);
  2320→
  2321→        const id = parseInt(idStr, 10);
  2322→        if (Number.isNaN(id)) {
  2323→          error(errors.todo.invalidId(idStr));
  2324→          process.exit(EXIT_CODES.USAGE_ERROR);
  2325→        }
  2326→
  2327→        const todoIndex = foundTask.todos.findIndex((t) => t.id === id);
  2328→        if (todoIndex === -1) {
  2329→          error(errors.todo.notFound(id));
  2330→          process.exit(EXIT_CODES.NOT_FOUND);
  2331→        }
  2332→
  2333→        if (!foundTask.todos[todoIndex].done) {
  2334→          warn(`Todo #${id} is not done`);
  2335→          return;
  2336→        }
  2337→
  2338→        const updatedTodos = [...foundTask.todos];
  2339→        updatedTodos[todoIndex] = {
  2340→          ...updatedTodos[todoIndex],
  2341→          done: false,
  2342→          done_at: undefined,
  2343→        };
  2344→
  2345→        const updatedTask: Task = {
  2346→          ...foundTask,
  2347→          todos: updatedTodos,
  2348→        };
  2349→
  2350→        await saveTask(ctx, updatedTask);
  2351→        await commitIfShadow(
  2352→          ctx.shadow,
  2353→          "task-note",
  2354→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2355→        );
  2356→        success(`Marked todo #${id} as not done`, {
  2357→          todo: updatedTodos[todoIndex],
  2358→        });
  2359→      } catch (err) {
  2360→        error(errors.failures.markTodoNotDone, err);
  2361→        process.exit(EXIT_CODES.ERROR);
  2362→      }
  2363→    });
  2364→}
  2365→