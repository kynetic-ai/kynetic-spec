  1957→            ) {
  1958→              console.log("");
  1959→              console.log(
  1960→                alignmentCheck.testCoverage(
  1961→                  specItem.acceptance_criteria.length,
  1962→                ),
  1963→              );
  1964→            }
  1965→          }
  1966→        }
  1967→      } catch (err) {
  1968→        error(errors.failures.addNote, err);
  1969→        process.exit(EXIT_CODES.ERROR);
  1970→      }
