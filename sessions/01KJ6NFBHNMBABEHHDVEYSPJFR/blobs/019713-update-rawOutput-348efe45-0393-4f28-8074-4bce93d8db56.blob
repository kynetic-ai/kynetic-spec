    50→
    51→/**
    52→ * Find a task by reference with detailed error reporting.
    53→ * Returns the task or exits with appropriate error.
    54→ */
    55→function resolveTaskRef(
    56→  ref: string,
    57→  tasks: LoadedTask[],
    58→  index: ReferenceIndex,
    59→): LoadedTask {
    60→  const result = index.resolve(ref);
    61→
    62→  if (!result.ok) {
    63→    switch (result.error) {
    64→      case "not_found":
    65→        error(errors.reference.taskNotFound(ref));
    66→        break;
    67→      case "ambiguous":
    68→        error(errors.reference.ambiguous(ref));
    69→        for (const candidate of result.candidates) {
    70→          const task = tasks.find((t) => t._ulid === candidate);
    71→          const slug = task?.slugs[0] || "";
    72→          console.error(
    73→            `  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ""}`,
    74→          );
    75→        }
    76→        break;
    77→      case "duplicate_slug":
    78→        error(errors.reference.slugMapsToMultiple(ref));
    79→        for (const candidate of result.candidates) {
    80→          console.error(`  - ${index.shortUlid(candidate)}`);
    81→        }
    82→        break;
    83→    }
    84→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    85→    process.exit(EXIT_CODES.NOT_FOUND);
    86→  }
    87→
    88→  // Check if it's actually a task
    89→  const task = tasks.find((t) => t._ulid === result.ulid);
    90→  if (!task) {
    91→    error(errors.reference.notTask(ref));
    92→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    93→    process.exit(EXIT_CODES.NOT_FOUND);
    94→  }
    95→
    96→  return task;
    97→}
    98→
    99→/**
   100→ * Batch-compatible resolver that returns null instead of calling process.exit().
   101→ * Used by executeBatchOperation to handle errors without terminating the process.
   102→ * AC: @multi-ref-batch ac-4, ac-8 - Partial failure handling and ref resolution
   103→ */
   104→function resolveTaskRefForBatch(
   105→  ref: string,
   106→  tasks: LoadedTask[],
   107→  index: ReferenceIndex,
   108→): { task: LoadedTask | null; error?: string } {
   109→  const result = index.resolve(ref);
   110→
   111→  if (!result.ok) {
   112→    let errorMsg: string;
   113→    switch (result.error) {
   114→      case "not_found":
   115→        errorMsg = `Reference "${ref}" not found`;
   116→        break;
   117→      case "ambiguous":
   118→        errorMsg = `Reference "${ref}" is ambiguous (matches ${result.candidates.length} items)`;
   119→        break;
   120→      case "duplicate_slug":
   121→        errorMsg = `Slug "${ref}" maps to multiple items`;
   122→        break;
   123→    }
   124→    return { task: null, error: errorMsg };
   125→  }
   126→
   127→  // Check if it's actually a task
   128→  const task = tasks.find((t) => t._ulid === result.ulid);
   129→  if (!task) {
   130→    return { task: null, error: `Reference "${ref}" is not a task` };
   131→  }
   132→
   133→  return { task };
   134→}
   135→
   136→/**
   137→ * Helper function to update task fields.
   138→ * Used by both single-ref and batch modes of task set.
   139→ * AC: @spec-task-set-batch ac-1, ac-2, ac-4, ac-5
   140→ */
   141→async function setTaskFields(
   142→  foundTask: LoadedTask,
   143→  ctx: any,
   144→  tasks: LoadedTask[],
   145→  items: LoadedSpecItem[],
   146→  _allMetaItems: any[],
   147→  index: ReferenceIndex,
   148→  options: any,
   149→): Promise<{
   150→  success: boolean;
   151→  message?: string;
   152→  error?: string;
   153→  data?: unknown;
   154→}> {
   155→  try {
   156→    // Check slug uniqueness if adding a new slug
   157→    if (options.slug) {
   158→      const slugCheck = checkSlugUniqueness(
   159→        index,
   160→        [options.slug],
   161→        foundTask._ulid,
   162→      );
   163→      if (!slugCheck.ok) {
   164→        return {
   165→          success: false,
   166→          error: `Slug "${slugCheck.slug}" already exists on ${slugCheck.existingUlid}`,
   167→        };
   168→      }
   169→    }
   170→
   171→    // Build updated task with only provided options
   172→    const updatedTask: Task = { ...foundTask };
   173→    const changes: string[] = [];
   174→
   175→    if (options.title) {
   176→      updatedTask.title = options.title;
   177→      changes.push("title");
   178→    }
   179→
   180→    if (options.specRef !== undefined) {
   181→      // Handle 'null' string to clear spec_ref
   182→      if (options.specRef === "null") {
   183→        updatedTask.spec_ref = null;
   184→        changes.push("spec_ref: cleared");
   185→      } else {
   186→        // Validate the spec ref exists and is a spec item
   187→        const specResult = index.resolve(options.specRef);
   188→        if (!specResult.ok) {
   189→          return {
   190→            success: false,
   191→            error: errors.reference.specRefNotFound(options.specRef),
   192→          };
   193→        }
   194→        // Check it's not a task
   195→        const isTask = tasks.some((t) => t._ulid === specResult.ulid);
   196→        if (isTask) {
   197→          return {
   198→            success: false,
   199→            error: errors.reference.specRefIsTask(options.specRef),
   200→          };
   201→        }
   202→        updatedTask.spec_ref = normalizeRefInput(options.specRef);
   203→        changes.push("spec_ref");
   204→      }
   205→    }
   206→
   207→    if (options.metaRef !== undefined) {
   208→      // Handle 'null' string to clear meta_ref
   209→      if (options.metaRef === "null") {
   210→        updatedTask.meta_ref = null;
   211→        changes.push("meta_ref: cleared");
   212→      } else {
   213→        // Validate the meta ref exists and is a meta item
   214→        const metaRefResult = index.resolve(options.metaRef);
   215→        if (!metaRefResult.ok) {
   216→          return {
   217→            success: false,
   218→            error: errors.reference.metaRefNotFound(options.metaRef),
   219→          };
   220→        }
   221→
   222→        // Check if the resolved item is a meta item (not a spec item or task)
   223→        const isTask = tasks.some((t) => t._ulid === metaRefResult.ulid);
   224→        const isSpecItem = items.some((i) => i._ulid === metaRefResult.ulid);
   225→
   226→        if (isTask || isSpecItem) {
   227→          return {
   228→            success: false,
   229→            error: errors.reference.metaRefPointsToSpec(options.metaRef),
   230→          };
   231→        }
   232→
   233→        updatedTask.meta_ref = normalizeRefInput(options.metaRef);
   234→        changes.push("meta_ref");
   235→      }
   236→    }
   237→
   238→    if (options.planRef !== undefined) {
   239→      // Handle 'null' string to clear plan_ref
   240→      if (options.planRef === "null") {
   241→        updatedTask.plan_ref = null;
   242→        changes.push("plan_ref: cleared");
   243→      } else {
   244→        // First check if it's a task or spec item (wrong type)
   245→        const cleanRef = options.planRef.startsWith("@")
   246→          ? options.planRef.slice(1)
   247→          : options.planRef;
   248→
   249→        const isTask = tasks.some(
   250→          (t) =>
   251→            t.slugs.includes(cleanRef) ||
   252→            t._ulid === cleanRef ||
   253→            t._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   254→        );
   255→        const isSpecItem = items.some(
   256→          (i) =>
   257→            i.slugs.includes(cleanRef) ||
   258→            i._ulid === cleanRef ||
   259→            i._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   260→        );
   261→
   262→        if (isTask || isSpecItem) {
   263→          return {
   264→            success: false,
   265→            error: `Reference "${options.planRef}" is not a plan`,
   266→          };
   267→        }
   268→
   269→        // Now check if the plan exists
   270→        const { findPlanByRef } = await import("../../parser/plans.js");
   271→        const plan = await findPlanByRef(ctx, options.planRef);
   272→
   273→        if (!plan) {
   274→          return {
   275→            success: false,
   276→            error: `Plan reference not found: ${options.planRef}`,
   277→          };
   278→        }
   279→
   280→        updatedTask.plan_ref = normalizeRefInput(options.planRef);
   281→        changes.push("plan_ref");
   282→      }
   283→    }
   284→
   285→    if (options.priority) {
   286→      const priorityResult = parseIntOption(options.priority, {
   287→        min: 1,
   288→        max: 5,
   289→        name: "Priority",
   290→      });
   291→      if (!priorityResult.ok) {
   292→        return { success: false, error: priorityResult.error };
   293→      }
   294→      updatedTask.priority = priorityResult.value;
   295→      changes.push("priority");
   296→    }
   297→
   298→    if (options.slug) {
   299→      if (!updatedTask.slugs.includes(options.slug)) {
   300→        updatedTask.slugs = [...updatedTask.slugs, options.slug];
   301→        changes.push("slug");
   302→      }
   303→    }
   304→
   305→    if (options.tag) {
   306→      const parsedTags = parseTagsArray(options.tag);
   307→      const newTags = parsedTags.filter(
   308→        (t: string) => !updatedTask.tags.includes(t),
   309→      );
   310→      if (newTags.length > 0) {
   311→        updatedTask.tags = [...updatedTask.tags, ...newTags];
   312→        changes.push("tags");
   313→      }
   314→    }
   315→
   316→    if (options.dependsOn) {
   317→      // Validate all dependency refs
   318→      for (const depRef of options.dependsOn) {
   319→        const depResult = index.resolve(depRef);
   320→        if (!depResult.ok) {
   321→          return {
   322→            success: false,
   323→            error: errors.reference.depNotFound(depRef),
   324→          };
   325→        }
   326→        // Ensure the dependency is a task, not a spec item
   327→        const isTask = tasks.some((t) => t._ulid === depResult.ulid);
   328→        if (!isTask) {
   329→          return {
   330→            success: false,
   331→            error: `Reference "${depRef}" is not a task`,
   332→          };
   333→        }
   334→      }
   335→      updatedTask.depends_on = options.dependsOn.map(normalizeRefInput);
   336→      changes.push("depends_on");
   337→    }
   338→
   339→    // AC: @spec-task-clear-deps ac-1, ac-2 - Clear all dependencies
   340→    if (options.clearDeps) {
   341→      if (foundTask.depends_on.length === 0) {
   342→        // AC: @spec-task-clear-deps ac-2 - No changes needed
   343→        return {
   344→          success: true,
   345→          message: "No changes: task has no dependencies to clear",
   346→        };
   347→      }
   348→      updatedTask.depends_on = [];
   349→      changes.push("depends_on");
   350→
   351→      // Add note documenting the change
   352→      // AC: @task-set ac-author
   353→      const note = createNote(
   354→        `Dependencies cleared (was: ${foundTask.depends_on.join(", ")})`,
   355→        getAuthor(ctx.config?.identity?.author),
   356→      );
   357→      updatedTask.notes = [...updatedTask.notes, note];
   358→    }
   359→
   360→    // AC: @task-automation-eligibility ac-5, ac-11, ac-12, ac-18
   361→    // Handle automation status changes
   362→    // Note: --no-automation sets options.automation to false, so check that first
   363→    if (options.automation === false) {
   364→      // --no-automation flag clears the automation status (AC: ac-12)
   365→      delete updatedTask.automation;
   366→      changes.push("automation");
   367→    } else if (options.automation !== undefined) {
   368→      const automationResult = validateEnumOption(
   369→        options.automation,
   370→        ["eligible", "needs_review", "manual_only"] as const,
   371→        "automation status",
   372→      );
   373→      if (!automationResult.ok) {
   374→        return { success: false, error: automationResult.error };
   375→      }
   376→
   377→      // AC: @task-automation-eligibility ac-18 - require reason for needs_review
   378→      if (options.automation === "needs_review" && !options.reason) {
   379→        return {
   380→          success: false,
   381→          error:
   382→            "Setting automation to needs_review requires --reason flag explaining why",
   383→        };
   384→      }
   385→
   386→      updatedTask.automation = automationResult.value;
   387→      changes.push("automation");
   388→
   389→      // If reason provided, add a note documenting the change
   390→      // AC: @task-set ac-author
   391→      if (options.reason) {
   392→        const note = createNote(
   393→          `Automation status set to ${automationResult.value}: ${options.reason}`,
   394→          getAuthor(ctx.config?.identity?.author),
   395→        );
   396→        updatedTask.notes = [...updatedTask.notes, note];
   397→        changes.push("note");
   398→      }
   399→    }
   400→
   401→    // AC: @spec-task-set-batch ac-4 - Warn on no changes, don't fail
   402→    if (changes.length === 0) {
   403→      return {
   404→        success: true,
   405→        message: "No changes specified",
   406→        data: { task: updatedTask },
   407→      };
   408→    }
   409→
   410→    await saveTask(ctx, updatedTask);
   411→    await commitIfShadow(
   412→      ctx.shadow,
   413→      "task-set",
   414→      foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
   415→      changes.join(", "),
   416→    );
   417→
   418→    return {
   419→      success: true,
   420→      message: `Updated task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(", ")})`,
   421→      data: { task: updatedTask },
   422→    };
   423→  } catch (err) {
   424→    return {
   425→      success: false,
   426→      error: err instanceof Error ? err.message : String(err),
   427→    };
   428→  }
   429→}
   430→
   431→/**
   432→ * Register the 'task' command group (singular - operations on individual tasks)
   433→ */
   434→export function registerTaskCommands(program: Command): void {
   435→  const task = program
   436→    .command("task")
   437→    .description("Operations on individual tasks")
   438→    .allowUnknownOption()
   439→    .allowExcessArguments();
   440→
   441→  // AC: @command-group-default-actions ac-bare-task, ac-unknown-subcommand
   442→  // Default action when no subcommand is given (e.g. `kspec task` or `kspec task --status pending`)
   443→  task.action(async (_options: Record<string, unknown>, cmd: Command) => {
   444→    const { Command: Cmd } = await import("commander");
   445→    const listCmd = addListOptions(new Cmd("_list"));
   446→    listCmd.exitOverride();
   447→    try {
   448→      listCmd.parse(cmd.args, { from: "user" });
   449→    } catch {
   450→      console.error(chalk.gray(`Run 'kspec task --help' to see available subcommands`));
   451→      process.exit(EXIT_CODES.ERROR);
   452→    }
   453→
   454→    // AC: @command-group-default-actions ac-unknown-subcommand
   455→    if (listCmd.args.length > 0) {
   456→      const unknownCmd = listCmd.args[0];
   457→      const subcommandNames = cmd.commands.map((c: Command) => c.name());
   458→      const suggestion = findClosestCommand(unknownCmd, subcommandNames);
   459→      console.error(chalk.red(`error: unknown command 'task ${unknownCmd}'`));
   460→      if (suggestion) {
   461→        console.error(chalk.yellow(`Did you mean: kspec task ${suggestion}?`));
   462→      } else {
   463→        console.error(chalk.gray(`Run 'kspec task --help' to see available subcommands`));
   464→      }
   465→      process.exit(EXIT_CODES.ERROR);
   466→    }
   467→
   468→    // AC: @command-group-default-actions ac-bare-with-options
   469→    await listTasksAction(listCmd.opts());
   470→  });
   471→
   472→  // kspec task list - alias for 'kspec tasks list'
   473→  task
   474→    .command("list")
   475→    .description("List all tasks (alias for 'kspec tasks list')")
   476→    .option("-s, --status <status>", "Filter by status")
   477→    .option("-t, --type <type>", "Filter by type")
   478→    .option("--tag <tag>", "Filter by tag")
   479→    .option("--meta-ref <ref>", "Filter by meta reference")
   480→    .option("-g, --grep <pattern>", "Search content with regex pattern")
   481→    .option("-v, --verbose", "Show more details")
   482→    .option("--full", "Show full details (notes, todos, timestamps)")
   483→    .option("--count", "Show only the count of matching tasks")
   484→    .action(async (options) => {
   485→      await listTasksAction(options);
   486→    });
   487→
   488→  // kspec task get <ref>
   489→  task
   490→    .command("get <ref>")
   491→    .description("Get task details")
   492→    .option("--all", "Show all notes including superseded ones")
   493→    .action(async (ref: string, options: { all?: boolean }) => {
   494→      try {
   495→        const ctx = await initContext();
   496→        const tasks = await loadAllTasks(ctx);
   497→        const _items = await loadAllItems(ctx);
   498→
   499→        // Build all indexes including TraitIndex
   500→        const { refIndex: index, traitIndex } = await (async () => {
   501→          const { buildIndexes } = await import("../../parser/index.js");
   502→          return buildIndexes(ctx);
   503→        })();
   504→
   505→        const foundTask = resolveTaskRef(ref, tasks, index);
   506→
   507→        // AC: @trait-display ac-3 - task get shows inherited AC sections
   508→        // Get inherited traits if task has spec_ref
   509→        let inheritedTraits: Array<{
   510→          trait: {
   511→            ulid: string;
   512→            slug: string;
   513→            title: string;
   514→            description?: string;
   515→          };
   516→          acs: Array<{
   517→            id: string;
   518→            given?: string;
   519→            when?: string;
   520→            then?: string;
   521→          }>;
   522→        }> = [];
   523→        if (foundTask.spec_ref) {
   524→          const specResult = index.resolve(foundTask.spec_ref);
   525→          if (specResult.ok) {
   526→            const specUlid = specResult.ulid;
   527→            const inheritedAC = traitIndex.getInheritedAC(specUlid);
   528→            const traitsByTrait = new Map<
   529→              string,
   530→              {
   531→                trait: (typeof inheritedAC)[0]["trait"];
   532→                acs: Array<{
   533→                  id: string;
   534→                  given?: string;
   535→                  when?: string;
   536→                  then?: string;
   537→                }>;
   538→              }
   539→            >();
   540→            for (const { trait, ac } of inheritedAC) {
   541→              if (!traitsByTrait.has(trait.ulid)) {
   542→                traitsByTrait.set(trait.ulid, { trait, acs: [] });
   543→              }
   544→              traitsByTrait.get(trait.ulid)?.acs.push(ac);
   545→            }
   546→            inheritedTraits = Array.from(traitsByTrait.values());
   547→          }
   548→        }
   549→
   550→        // Build JSON output with inherited traits (AC: @trait-display ac-2)
   551→        // Always include all notes in JSON output with superseded computed field
   552→        const jsonOutput = {
   553→          ...foundTask,
   554→          notes: annotateNotesWithSuperseded(foundTask.notes),
   555→          ...(inheritedTraits.length > 0 && {
   556→            inherited_traits: inheritedTraits.map(({ trait, acs }) => ({
   557→              ref: `@${trait.slug}`,
   558→              title: trait.title,
   559→              acceptance_criteria: acs,
   560→            })),
   561→          }),
   562→        };
   563→
   564→        output(jsonOutput, () => {
   565→          formatTaskDetails(foundTask, index, { showAllNotes: options.all });
   566→
   567→          // AC: @trait-display ac-3, ac-4, ac-5 - Show inherited AC per trait in labeled sections
   568→          if (inheritedTraits.length > 0) {
   569→            for (const { trait, acs } of inheritedTraits) {
   570→              console.log(
   571→                chalk.gray(`\n─── Inherited from @${trait.slug} ───`),
   572→              );
   573→              for (const ac of acs) {
   574→                console.log(
   575→                  chalk.cyan(`  [${ac.id}]`) +
   576→                    chalk.gray(` (from @${trait.slug})`),
   577→                );
   578→                if (ac.given) console.log(`    Given: ${ac.given}`);
   579→                if (ac.when) console.log(`    When: ${ac.when}`);
   580→                if (ac.then) console.log(`    Then: ${ac.then}`);
   581→              }
   582→            }
   583→          }
   584→        });
   585→      } catch (err) {
   586→        error(errors.failures.getTask, err);
   587→        process.exit(EXIT_CODES.ERROR);
   588→      }
   589→    });
   590→
   591→  // kspec task add
   592→  markMutating(task.command("add"))
   593→    .description("Create a new task")
   594→    .requiredOption("--title <title>", "Task title")
   595→    .option("--description <description>", "Task description")
   596→    .option(
   597→      "--type <type>",
   598→      "Task type (task, epic, bug, spike, infra)",
   599→      "task",
   600→    )
   601→    .option("--spec-ref <ref>", "Reference to spec item")
   602→    .option(
   603→      "--meta-ref <ref>",
   604→      "Reference to meta item (workflow, agent, or convention)",
   605→    )
   606→    .option("--plan-ref <ref>", "Reference to plan this task is derived from")
   607→    .option("--priority <n>", "Priority (1-5)", "3")
   608→    .option("--slug <slug>", "Human-friendly slug")
   609→    .option("--tag <tag...>", "Tags")
   610→    .option("--depends-on <refs...>", "Set task dependencies")
   611→    .option(
   612→      "--automation <status>",
   613→      "Automation eligibility (eligible, needs_review, manual_only)",
   614→    )
   615→    .addHelpText(
   616→      "after",
   617→      `
   618→Examples:
   619→  $ kspec task add --title "Implement feature" --spec-ref @feature-spec
   620→  $ kspec task add --title "Fix bug" --type bug --priority 1
   621→  $ kspec task add --title "Multi-tag task" --tag cli urgent`,
   622→    )
   623→    .action(async (options) => {
   624→      try {
   625→        const ctx = await initContext();
   626→        const tasks = await loadAllTasks(ctx);
   627→        const items = await loadAllItems(ctx);
   628→
   629→        // Load meta items for validation
   630→        const { loadMetaContext } = await import("../../parser/meta.js");
   631→        const metaContext = await loadMetaContext(ctx);
   632→        const allMetaItems = [
   633→          ...metaContext.agents,
   634→          ...metaContext.workflows,
   635→          ...metaContext.conventions,
   636→          ...metaContext.observations,
   637→        ];
   638→
   639→        // Build index for reference validation
   640→        const refIndex = new ReferenceIndex(tasks, items, allMetaItems);
   641→
   642→        // Check slug uniqueness if provided
   643→        if (options.slug) {
   644→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   645→          if (!slugCheck.ok) {
   646→            error(
   647→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
   648→            );
   649→            process.exit(EXIT_CODES.CONFLICT);
   650→          }
   651→        }
   652→
   653→        // Validate meta_ref if provided (AC-meta-ref-3, AC-meta-ref-4)
   654→        if (options.metaRef) {
   655→          const metaRefResult = refIndex.resolve(options.metaRef);
   656→
   657→          if (!metaRefResult.ok) {
   658→            error(errors.reference.metaRefNotFound(options.metaRef));
   659→            process.exit(EXIT_CODES.NOT_FOUND);
   660→          }
   661→
   662→          // Check if the resolved item is a meta item (not a spec item or task)
   663→          const isTask = tasks.some((t) => t._ulid === metaRefResult.ulid);
   664→          const isSpecItem = items.some((i) => i._ulid === metaRefResult.ulid);
   665→
   666→          if (isTask || isSpecItem) {
   667→            error(errors.reference.metaRefPointsToSpec(options.metaRef));
   668→            process.exit(EXIT_CODES.NOT_FOUND);
   669→          }
   670→        }
   671→
   672→        // Validate spec_ref if provided — must point to a spec item, not a task or meta item
   673→        if (options.specRef) {
   674→          const specRefResult = validateSpecRef(
   675→            options.specRef,
   676→            refIndex,
   677→            tasks,
   678→            items,
   679→          );
   680→          if (!specRefResult.ok) {
   681→            error(specRefResult.error);
   682→            process.exit(EXIT_CODES.NOT_FOUND);
   683→          }
   684→        }
   685→
   686→        // AC: @task-automation-eligibility ac-13 - validate automation if provided
   687→        let automationValue:
   688→          | "eligible"
   689→          | "needs_review"
   690→          | "manual_only"
   691→          | undefined;
   692→        if (options.automation) {
   693→          const automationResult = validateEnumOption(
   694→            options.automation,
   695→            ["eligible", "needs_review", "manual_only"] as const,
   696→            "automation status",
   697→          );
   698→          if (!automationResult.ok) {
   699→            error(automationResult.error);
   700→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   701→          }
   702→          automationValue = automationResult.value;
   703→        }
   704→
   705→        // Validate plan_ref if provided (AC: @plan-derive ac-5, ac-6)
   706→        if (options.planRef) {
   707→          // First check if it's a task or spec item (wrong type)
   708→          const cleanRef = options.planRef.startsWith("@")
   709→            ? options.planRef.slice(1)
   710→            : options.planRef;
   711→
   712→          const isTask = tasks.some(
   713→            (t) =>
   714→              t.slugs.includes(cleanRef) ||
   715→              t._ulid === cleanRef ||
   716→              t._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   717→          );
   718→          const isSpecItem = items.some(
   719→            (i) =>
   720→              i.slugs.includes(cleanRef) ||
   721→              i._ulid === cleanRef ||
   722→              i._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   723→          );
   724→
   725→          if (isTask || isSpecItem) {
   726→            error(`Reference "${options.planRef}" is not a plan`);
   727→            process.exit(EXIT_CODES.NOT_FOUND);
   728→          }
   729→
   730→          // Now check if the plan exists
   731→          const { findPlanByRef } = await import("../../parser/plans.js");
   732→          const plan = await findPlanByRef(ctx, options.planRef);
   733→
   734→          if (!plan) {
   735→            error(`Plan reference not found: ${options.planRef}`);
   736→            process.exit(EXIT_CODES.NOT_FOUND);
   737→          }
   738→        }
   739→
   740→        // AC: @task-add-depends-on ac-2 - Validate dependency refs
   741→        if (options.dependsOn) {
   742→          for (const depRef of options.dependsOn) {
   743→            const depResult = refIndex.resolve(depRef);
   744→            if (!depResult.ok) {
   745→              error(errors.reference.depNotFound(depRef));
   746→              process.exit(EXIT_CODES.NOT_FOUND);
   747→            }
   748→            // Ensure the dependency is a task, not a spec item
   749→            const isTask = tasks.some((t) => t._ulid === depResult.ulid);
   750→            if (!isTask) {
   751→              error(`Reference "${depRef}" is not a task`);
   752→              process.exit(EXIT_CODES.NOT_FOUND);
   753→            }
   754→          }
   755→        }
   756→
   757→        // Validate priority
   758→        const priorityResult = parseIntOption(options.priority, {
   759→          min: 1,
   760→          max: 5,
   761→          name: "Priority",
   762→        });
   763→        if (!priorityResult.ok) {
   764→          error(priorityResult.error);
   765→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   766→        }
   767→
   768→        // AC: @spec-task-add-description ac-6 - Omit description if empty string
   769→        const descriptionValue =
   770→          options.description && options.description.trim() !== ""
   771→            ? options.description
   772→            : undefined;
   773→
   774→        const input: TaskInput = {
   775→          title: options.title,
   776→          description: descriptionValue,
   777→          type: options.type,
   778→          spec_ref: options.specRef ? normalizeRefInput(options.specRef) : null,
   779→          meta_ref: options.metaRef ? normalizeRefInput(options.metaRef) : null,
   780→          plan_ref: options.planRef ? normalizeRefInput(options.planRef) : null,
   781→          priority: priorityResult.value,
   782→          slugs: options.slug ? [options.slug] : [],
   783→          tags: parseTagsArray(options.tag),
   784→          depends_on: (options.dependsOn || []).map(normalizeRefInput),
   785→          automation: automationValue,
   786→        };
   787→
   788→        const newTask = createTask(input);
   789→        await saveTask(ctx, newTask);
   790→        await commitIfShadow(
   791→          ctx.shadow,
   792→          "task-add",
   793→          newTask.slugs[0] || newTask._ulid.slice(0, 8),
   794→          newTask.title,
   795→        );
   796→
   797→        // Build index including the new task for accurate short ULID
   798→        const index = new ReferenceIndex(
   799→          [...tasks, newTask],
   800→          items,
   801→          allMetaItems,
   802→        );
   803→        success(`Created task: ${index.shortUlid(newTask._ulid)}`, {
   804→          task: newTask,
   805→        });
   806→      } catch (err) {
   807→        error(errors.failures.createTask, err);
   808→        process.exit(EXIT_CODES.ERROR);
   809→      }
   810→    });
   811→
   812→  // kspec task set <ref>
   813→  markMutating(task.command("set [ref]"))
   814→    .description("Update task fields")
   815→    .option(
   816→      "--refs <refs...>",
   817→      "Update multiple tasks (AC: @spec-task-set-batch ac-1)",
   818→    )
   819→    .option("--title <title>", "Update task title")
   820→    .option("--spec-ref <ref>", "Link to spec item (use 'null' to clear)")
   821→    .option(
   822→      "--meta-ref <ref>",
   823→      "Link to meta item (use 'null' to clear)",
   824→    )
   825→    .option("--plan-ref <ref>", "Link to plan (use 'null' to clear)")
   826→    .option("--priority <n>", "Set priority (1-5)")
   827→    .option("--slug <slug>", "Add a slug alias")
   828→    .option("--tag <tag...>", "Add tags")
   829→    .option("--depends-on <refs...>", "Set dependencies (replaces existing)")
   830→    .option("--clear-deps", "Clear all dependencies")
   831→    .option(
   832→      "--automation <status>",
   833→      "Set automation eligibility (eligible, needs_review, manual_only)",
   834→    )
   835→    .option("--no-automation", "Clear automation status (return to unassessed)")
   836→    .option(
   837→      "--reason <reason>",
   838→      "Reason for status change (required when setting needs_review)",
   839→    )
   840→    .option(
   841→      "--status <status>",
   842→      "Reject with error - use state transition commands instead",
   843→    )
   844→    .addHelpText(
   845→      "after",
   846→      `
   847→Examples:
   848→  $ kspec task set @task-slug --priority 2
   849→  $ kspec task set @task-slug --depends-on @dep1 @dep2
   850→  $ kspec task set @task-slug --tag cli urgent
   851→  $ kspec task set --refs @task1 @task2 --priority 3`,
   852→    )
   853→    .action(async (ref: string | undefined, options) => {
   854→      try {
   855→        // AC: @spec-task-set-batch ac-3 - Reject --status flag
   856→        if (options.status !== undefined) {
   857→          error(
   858→            "Use state transition commands (start, complete, block, etc.) to change status",
   859→          );
   860→          process.exit(EXIT_CODES.USAGE_ERROR);
   861→        }
   862→
   863→        // AC: @spec-task-clear-deps ac-3 - Mutual exclusivity check
   864→        if (options.clearDeps && options.dependsOn) {
   865→          error("Cannot use --clear-deps and --depends-on together");
   866→          process.exit(EXIT_CODES.USAGE_ERROR);
   867→        }
   868→
   869→        const ctx = await initContext();
   870→        const tasks = await loadAllTasks(ctx);
   871→        const items = await loadAllItems(ctx);
   872→
   873→        // Load meta items for validation
   874→        const { loadMetaContext } = await import("../../parser/meta.js");
   875→        const metaContext = await loadMetaContext(ctx);
   876→        const allMetaItems = [
   877→          ...metaContext.agents,
   878→          ...metaContext.workflows,
   879→          ...metaContext.conventions,
   880→          ...metaContext.observations,
   881→        ];
   882→
   883→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   884→
   885→        // AC: @trait-multi-ref-batch ac-8 - Deduplicate refs
   886→        const refsFlag = options.refs
   887→          ? [...new Set(options.refs as string[])]
   888→          : undefined;
   889→
   890→        // Batch mode or single mode?
   891→        if (refsFlag && refsFlag.length > 0) {
   892→          // Batch mode - AC: @spec-task-set-batch ac-1, ac-2, ac-5
   893→          const result = await executeBatchOperation({
   894→            positionalRef: ref,
   895→            refsFlag,
   896→            context: { ctx, tasks, items, allMetaItems, index, options },
   897→            items: tasks,
   898→            index,
   899→            resolveRef: (
   900→              refStr: string,
   901→              taskList: LoadedTask[],
   902→              idx: ReferenceIndex,
   903→            ) => {
   904→              const result = resolveTaskRefForBatch(refStr, taskList, idx);
   905→              return { item: result.task, error: result.error };
   906→            },
   907→            executeOperation: async (task: LoadedTask, context) => {
   908→              return await setTaskFields(
   909→                task,
   910→                context.ctx,
   911→                context.tasks,
   912→                context.items,
   913→                context.allMetaItems,
   914→                context.index,
   915→                context.options,
   916→              );
   917→            },
   918→            getUlid: (task: LoadedTask) => task._ulid,
   919→          });
   920→
   921→          formatBatchOutput(result, "Set");
   922→        } else {
   923→          // Single mode - existing behavior
   924→          if (!ref) {
   925→            error("Either provide a positional ref or use --refs flag");
   926→            process.exit(EXIT_CODES.USAGE_ERROR);
   927→          }
   928→
   929→          const foundTask = resolveTaskRef(ref, tasks, index);
   930→          const result = await setTaskFields(
   931→            foundTask,
   932→            ctx,
   933→            tasks,
   934→            items,
   935→            allMetaItems,
   936→            index,
   937→            options,
   938→          );
   939→
   940→          if (!result.success) {
   941→            error(result.error || "Failed to update task");
   942→            process.exit(EXIT_CODES.ERROR);
   943→          }
   944→
   945→          if (result.message) {
   946→            // AC: @spec-task-set-batch ac-4 - Warn on no changes
   947→            if (result.message.includes("No changes")) {
   948→              if (isJsonMode()) {
   949→                output({ success: true, message: result.message });
   950→              } else {
   951→                warn(result.message);
   952→              }
   953→            } else {
   954→              success(
   955→                result.message,
   956→                result.data as Record<string, unknown> | undefined,
   957→              );
   958→            }
   959→          }
   960→        }
   961→      } catch (err) {
   962→        error(errors.failures.updateTask, err);
   963→        process.exit(EXIT_CODES.ERROR);
   964→      }
   965→    });
   966→
   967→  // kspec task patch <ref>
   968→  markMutating(task.command("patch <ref>"))
   969→    .description("Update task with JSON data")
   970→    .option("--data <json>", "JSON object with fields to update")
   971→    .option("--dry-run", "Show what would change without writing")
   972→    .option("--allow-unknown", "Allow unknown fields (for extending format)")
   973→    .action(async (ref: string, options) => {
   974→      try {
   975→        const ctx = await initContext();
   976→        const tasks = await loadAllTasks(ctx);
   977→        const items = await loadAllItems(ctx);
   978→
   979→        // Load meta items for validation
   980→        const { loadMetaContext } = await import("../../parser/meta.js");
   981→        const metaContext = await loadMetaContext(ctx);
   982→        const allMetaItems = [
   983→          ...metaContext.agents,
   984→          ...metaContext.workflows,
   985→          ...metaContext.conventions,
   986→          ...metaContext.observations,
   987→        ];
   988→
   989→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   990→        const foundTask = resolveTaskRef(ref, tasks, index);
   991→
   992→        // Get JSON data from --data flag or stdin
   993→        let jsonData: string;
   994→        if (options.data) {
   995→          jsonData = options.data;
   996→        } else {
   997→          // Read from stdin
   998→          const chunks: Buffer[] = [];
   999→          for await (const chunk of process.stdin) {
  1000→            chunks.push(chunk);
  1001→          }
  1002→          jsonData = Buffer.concat(chunks).toString("utf-8");
  1003→        }
  1004→
  1005→        // Parse JSON
  1006→        let patchData: Record<string, unknown>;
  1007→        try {
  1008→          patchData = JSON.parse(jsonData);
  1009→        } catch (parseErr) {
  1010→          error(errors.validation.invalidJson, parseErr);
  1011→          process.exit(EXIT_CODES.ERROR);
  1012→        }
  1013→
  1014→        // Validate against TaskInputSchema (partial)
  1015→        const { TaskInputSchema } = await import("../../schema/index.js");
  1016→
  1017→        // Create a partial schema for validation
  1018→        const partialSchema = options.allowUnknown
  1019→          ? TaskInputSchema.partial().passthrough()
  1020→          : TaskInputSchema.partial().strict();
  1021→
  1022→        let validatedPatch: Partial<TaskInput>;
  1023→        try {
  1024→          validatedPatch = partialSchema.parse(patchData);
  1025→        } catch (validationErr) {
  1026→          error(
  1027→            errors.validation.invalidPatchData(String(validationErr)),
  1028→            validationErr,
  1029→          );
  1030→          process.exit(EXIT_CODES.ERROR);
  1031→        }
  1032→
  1033→        // Check for unknown fields if strict mode
  1034→        if (!options.allowUnknown) {
  1035→          const knownFields = Object.keys(TaskInputSchema.shape);
  1036→          const providedFields = Object.keys(patchData);
  1037→          const unknownFields = providedFields.filter(
  1038→            (f) => !knownFields.includes(f),
  1039→          );
  1040→
  1041→          if (unknownFields.length > 0) {
  1042→            error(errors.validation.unknownFields(unknownFields));
  1043→            process.exit(EXIT_CODES.ERROR);
  1044→          }
  1045→        }
  1046→
  1047→        // Build updated task
  1048→        const updatedTask: Task = { ...foundTask, ...validatedPatch };
  1049→
  1050→        // Track changes for output
  1051→        const changes = Object.keys(validatedPatch);
  1052→
  1053→        if (options.dryRun) {
  1054→          info("Dry run - no changes will be written");
  1055→          info(`Would update: ${changes.join(", ")}`);
  1056→          output({ changes, updated: updatedTask }, () => {
  1057→            console.log(`\nChanges: ${changes.join(", ")}\n`);
  1058→            return formatTaskDetails(updatedTask, index);
  1059→          });
  1060→          return;
  1061→        }
  1062→
  1063→        await saveTask(ctx, updatedTask);
  1064→        await commitIfShadow(
  1065→          ctx.shadow,
  1066→          "task-patch",
  1067→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1068→          changes.join(", "),
  1069→        );
  1070→        success(
  1071→          `Patched task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(", ")})`,
  1072→          { task: updatedTask },
  1073→        );
  1074→      } catch (err) {
  1075→        error(errors.failures.patchTask, err);
  1076→        process.exit(EXIT_CODES.ERROR);
  1077→      }
  1078→    });
  1079→
  1080→  // kspec task start <ref>
  1081→  markMutating(task.command("start <ref>"))
  1082→    .description("Start working on a task (pending|needs_work -> in_progress)")
  1083→    .option("--no-sync", "Skip syncing spec implementation status")
  1084→    .action(async (ref: string, options) => {
  1085→      try {
  1086→        const ctx = await initContext();
  1087→        const tasks = await loadAllTasks(ctx);
  1088→        const items = await loadAllItems(ctx);
  1089→        const index = new ReferenceIndex(tasks, items);
  1090→        const foundTask = resolveTaskRef(ref, tasks, index);
  1091→
  1092→        if (foundTask.status === "in_progress") {
  1093→          warn("Task is already in progress");
  1094→          output(foundTask, () => formatTaskDetails(foundTask));
  1095→          return;
  1096→        }
  1097→
  1098→        if (foundTask.status !== "pending" && foundTask.status !== "needs_work") {
  1099→          error(errors.status.cannotStart(foundTask.status));
  1100→          process.exit(EXIT_CODES.VALIDATION_FAILED); // Exit code 4 = invalid state
  1101→        }
  1102→
  1103→        // AC: @session-scoped-task-claiming ac-startable - warn if claimed by another session
  1104→        const sessionId = process.env.KSPEC_SESSION_ID || null;
  1105→        if (
  1106→          foundTask.session_id &&
  1107→          sessionId &&
  1108→          foundTask.session_id !== sessionId
  1109→        ) {
  1110→          warn(
  1111→            `Task was claimed by session ${foundTask.session_id.slice(0, 8)}...`,
  1112→          );
  1113→        }
  1114→
  1115→        // Update status
  1116→        // AC: @session-scoped-task-claiming ac-stamp, ac-no-env
  1117→        const updatedTask: Task = {
  1118→          ...foundTask,
  1119→          status: "in_progress",
  1120→          started_at: new Date().toISOString(),
  1121→          ...(sessionId ? { session_id: sessionId } : {}),
  1122→        };
  1123→
  1124→        await saveTask(ctx, updatedTask);
  1125→        await commitIfShadow(
  1126→          ctx.shadow,
  1127→          "task-start",
  1128→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1129→        );
  1130→        success(`Started task: ${index.shortUlid(updatedTask._ulid)}`, {
  1131→          task: updatedTask,
  1132→        });
  1133→
  1134→        // Show spec context and AC guidance (suppressed in JSON mode)
  1135→        if (!isJsonMode() && foundTask.spec_ref) {
  1136→          const specResult = index.resolve(foundTask.spec_ref);
  1137→          if (specResult.ok) {
  1138→            const specItem = items.find((i) => i._ulid === specResult.ulid);
  1139→            if (specItem) {
  1140→              console.log("");
  1141→              console.log("--- Spec Context ---");
  1142→              console.log(`Implementing: ${specItem.title}`);
  1143→              if (specItem.description) {
  1144→                console.log(`\n${specItem.description}`);
  1145→              }
  1146→
  1147→              if (
  1148→                specItem.acceptance_criteria &&
  1149→                specItem.acceptance_criteria.length > 0
  1150→              ) {
  1151→                console.log(
  1152→                  `\nAcceptance Criteria (${specItem.acceptance_criteria.length}):`,
  1153→                );
  1154→                for (const ac of specItem.acceptance_criteria) {
  1155→                  console.log(`  [${ac.id}]`);
  1156→                  console.log(`    Given: ${ac.given}`);
  1157→                  console.log(`    When: ${ac.when}`);
  1158→                  console.log(`    Then: ${ac.then}`);
  1159→                }
  1160→                console.log("");
  1161→                console.log(
  1162→                  "Remember: Add test coverage for each AC and mark tests with // AC: @spec-ref ac-N",
  1163→                );
  1164→              }
  1165→              console.log("");
  1166→            }
  1167→          }
  1168→        }
  1169→
  1170→        // Sync spec implementation status (unless --no-sync)
  1171→        if (options.sync !== false && foundTask.spec_ref) {
  1172→          const updatedTasks = tasks.map((t) =>
  1173→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t,
  1174→          );
  1175→          const syncResult = await syncSpecImplementationStatus(
  1176→            ctx,
  1177→            updatedTask as LoadedTask,
  1178→            updatedTasks as LoadedTask[],
  1179→            items,
  1180→            index,
  1181→          );
  1182→          if (syncResult) {
  1183→            info(
  1184→              `Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1185→            );
  1186→            // Commit the spec status change
  1187→            await commitIfShadow(
  1188→              ctx.shadow,
  1189→              "spec-sync",
  1190→              syncResult.specUlid.slice(0, 8),
  1191→              `${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1192→            );
  1193→          }
  1194→        }
  1195→      } catch (err) {
  1196→        error(errors.failures.startTask, err);
  1197→        process.exit(EXIT_CODES.ERROR);
  1198→      }
  1199→    });
  1200→
  1201→  // kspec task complete <ref> | --refs <refs...>
  1202→  // AC: @multi-ref-batch ac-1 - Basic multi-ref syntax
  1203→  // AC: @multi-ref-batch ac-2 - Backward compatibility
  1204→  markMutating(task.command("complete [ref]"))
  1205→    .description("Complete a task (pending_review -> completed)")
  1206→    .option("--refs <refs...>", "Complete multiple tasks by ref")
  1207→    .option("--reason <reason>", "Completion reason/notes")
  1208→    .option("--skip-review", "Skip review requirement (requires --reason)")
  1209→    .option(
  1210→      "--force",
  1211→      "Force completion from any state (bypasses submit requirement)",
  1212→    )
  1213→    .option("--no-sync", "Skip syncing spec implementation status")
  1214→    .addHelpText(
  1215→      "after",
  1216→      `
  1217→Examples:
  1218→  $ kspec task complete @task-slug --reason "Merged in PR #123"
  1219→  $ kspec task complete @task-slug --force --reason "Design task, no code to review"
  1220→  $ kspec task complete --refs @task1 @task2 --reason "Batch completion"`,
  1221→    )
  1222→    .action(async (ref: string | undefined, options) => {
  1223→      try {
  1224→        const ctx = await initContext();
  1225→        const tasks = await loadAllTasks(ctx);
  1226→        const items = await loadAllItems(ctx);
  1227→        const index = new ReferenceIndex(tasks, items);
  1228→
  1229→        // AC: @spec-completion-enforcement ac-8
  1230→        if (options.skipReview && !options.reason) {
  1231→          error(errors.status.skipReviewRequiresReason);
  1232→          process.exit(EXIT_CODES.ERROR);
  1233→        }
  1234→
  1235→        // AC: @multi-ref-batch ac-1, ac-2, ac-3, ac-4
  1236→        const result = await executeBatchOperation({
  1237→          positionalRef: ref,
  1238→          refsFlag: options.refs,
  1239→          context: { ctx, tasks, items, index, options },
  1240→          items: tasks,
  1241→          index,
  1242→          resolveRef: (refStr, taskList, idx) => {
  1243→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1244→            return { item: resolved.task, error: resolved.error };
  1245→          },
  1246→          executeOperation: async (
  1247→            foundTask,
  1248→            { ctx, tasks, items, index, options },
  1249→          ) => {
  1250→            try {
  1251→              // AC: @spec-completion-enforcement ac-6
  1252→              if (foundTask.status === "completed") {
  1253→                return {
  1254→                  success: false,
  1255→                  error: errors.status.completeAlreadyCompleted,
  1256→                };
  1257→              }
  1258→
  1259→              // AC: @task-commands ac-1 - Allow --force to bypass all state checks
  1260→              const forcingCompletion = options.force;
  1261→
  1262→              // AC: @spec-completion-enforcement ac-7 - Allow skip-review bypass
  1263→              if (!options.skipReview && !forcingCompletion) {
  1264→                // AC: @spec-completion-enforcement ac-2
  1265→                if (foundTask.status === "in_progress") {
  1266→                  return {
  1267→                    success: false,
  1268→                    error: errors.status.completeRequiresReview,
  1269→                  };
  1270→                }
  1271→
  1272→                // AC: @spec-completion-enforcement ac-3
  1273→                if (foundTask.status === "pending") {
  1274→                  return {
  1275→                    success: false,
  1276→                    error: errors.status.completeRequiresStart,
  1277→                  };
  1278→                }
  1279→
  1280→                // AC: @spec-completion-enforcement ac-4
  1281→                if (foundTask.status === "blocked") {
  1282→                  return {
  1283→                    success: false,
  1284→                    error: errors.status.completeBlockedTask,
  1285→                  };
  1286→                }
  1287→
  1288→                // AC: @spec-completion-enforcement ac-5
  1289→                if (foundTask.status === "cancelled") {
  1290→                  return {
  1291→                    success: false,
  1292→                    error: errors.status.completeCancelledTask,
  1293→                  };
  1294→                }
  1295→
  1296→                // AC: @spec-completion-enforcement ac-1 - Only pending_review allowed
  1297→                if (foundTask.status !== "pending_review") {
  1298→                  return {
  1299→                    success: false,
  1300→                    error: errors.status.cannotComplete(foundTask.status),
  1301→                  };
  1302→                }
  1303→              }
  1304→
  1305→              const now = new Date().toISOString();
  1306→
  1307→              // AC: @spec-completion-enforcement ac-7 - Document skip-review reason
  1308→              // AC: @spec-completion-enforcement ac-author
  1309→              let taskNotes = foundTask.notes;
  1310→              if (options.skipReview && options.reason) {
  1311→                const skipNote = createNote(
  1312→                  `Completed with --skip-review: ${options.reason}`,
  1313→                  getAuthor(ctx.config?.identity?.author),
  1314→                );
  1315→                taskNotes = [...taskNotes, skipNote];
  1316→              }
  1317→
  1318→              // AC: @task-commands ac-1 - Document force completion from non-standard state
  1319→              const forcedFromNonStandard =
  1320→                forcingCompletion &&
  1321→                foundTask.status !== "pending_review";
  1322→              let forceStateDetail: string | undefined;
  1323→              if (forcedFromNonStandard) {
  1324→                forceStateDetail = `from ${foundTask.status} state`;
  1325→                if (foundTask.status === "blocked") {
  1326→                  const blockedBy = foundTask.blocked_by.join("; ");
  1327→                  forceStateDetail += `. Was blocked by: ${blockedBy || "(dependency-blocked)"}`;
  1328→                }
  1329→                let forceMessage = `Completed with --force ${forceStateDetail}`;
  1330→                if (options.reason) {
  1331→                  forceMessage += `. Reason: ${options.reason}`;
  1332→                }
  1333→                const forceNote = createNote(
  1334→                  forceMessage,
  1335→                  getAuthor(ctx.config?.identity?.author),
  1336→                );
  1337→                taskNotes = [...taskNotes, forceNote];
  1338→              }
  1339→
  1340→              // Update status
  1341→              const updatedTask: Task = {
  1342→                ...foundTask,
  1343→                status: "completed",
  1344→                completed_at: now,
  1345→                closed_reason: options.reason || null,
  1346→                started_at: foundTask.started_at || now,
  1347→                notes: taskNotes,
  1348→              };
  1349→
  1350→              await saveTask(ctx, updatedTask);
  1351→              await commitIfShadow(
  1352→                ctx.shadow,
  1353→                "task-complete",
  1354→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1355→                options.reason,
  1356→              );
  1357→
  1358→              // Sync spec implementation status (unless --no-sync)
  1359→              if (options.sync !== false && foundTask.spec_ref) {
  1360→                const updatedTasks = tasks.map((t) =>
  1361→                  t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t,
  1362→                );
  1363→                const syncResult = await syncSpecImplementationStatus(
  1364→                  ctx,
  1365→                  updatedTask as LoadedTask,
  1366→                  updatedTasks as LoadedTask[],
  1367→                  items,
  1368→                  index,
  1369→                );
  1370→                if (syncResult && !isJsonMode()) {
  1371→                  info(
  1372→                    `Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1373→                  );
  1374→                  await commitIfShadow(
  1375→                    ctx.shadow,
  1376→                    "spec-sync",
  1377→                    syncResult.specUlid.slice(0, 8),
  1378→                    `${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1379→                  );
  1380→                }
  1381→              }
  1382→
  1383→              // Show AC reminder for single-ref mode only (not in batch)
  1384→              if (!options.refs && foundTask.spec_ref && !isJsonMode()) {
  1385→                const specResult = index.resolve(foundTask.spec_ref);
  1386→                if (specResult.ok && specResult.item) {
  1387→                  const specItem = items.find(
  1388→                    (i) => i._ulid === specResult.ulid,
  1389→                  );
  1390→                  if (
  1391→                    specItem?.acceptance_criteria &&
  1392→                    specItem.acceptance_criteria.length > 0
  1393→                  ) {
  1394→                    const count = specItem.acceptance_criteria.length;
  1395→                    console.log(
  1396→                      `\n⚠ Linked spec ${foundTask.spec_ref} has ${count} acceptance criteri${count === 1 ? "on" : "a"} - verify they are covered\n`,
  1397→                    );
  1398→                  }
  1399→                }
  1400→              }
  1401→
  1402→              // AC: @task-commands ac-1 - Show warning when force-completing from non-standard state
  1403→              let warningMsg: string | undefined;
  1404→              if (forcedFromNonStandard) {
  1405→                warningMsg = `Task was force-completed ${forceStateDetail}`;
  1406→                if (!isJsonMode()) {
  1407→                  warn(warningMsg);
  1408→                }
  1409→              }
  1410→
  1411→              return {
  1412→                success: true,
  1413→                message: `Completed task: ${index.shortUlid(updatedTask._ulid)}`,
  1414→                data: updatedTask,
  1415→                ...(warningMsg && { warning: warningMsg }),
  1416→              };
  1417→            } catch (err) {
  1418→              return {
  1419→                success: false,
  1420→                error: err instanceof Error ? err.message : String(err),
  1421→              };
  1422→            }
  1423→          },
  1424→          getUlid: (task) => task._ulid,
  1425→        });
  1426→
  1427→        // AC: @multi-ref-batch ac-5, ac-6
  1428→        formatBatchOutput(result, "Complete");
  1429→
  1430→        // Show commit guidance for single-ref mode only
  1431→        if (
  1432→          !options.refs &&
  1433→          result.success &&
  1434→          result.results.length === 1 &&
  1435→          !isJsonMode()
  1436→        ) {
  1437→          const taskData = result.results[0].data as Task | undefined;
  1438→          if (taskData) {
  1439→            const guidance = formatCommitGuidance(taskData);
  1440→            printCommitGuidance(guidance);
  1441→          }
  1442→        }
  1443→      } catch (err) {
  1444→        error(errors.failures.completeTask, err);
  1445→        process.exit(EXIT_CODES.ERROR);
  1446→      }
  1447→    });
  1448→
  1449→  // kspec task submit <ref>
  1450→  // Transitions in_progress → pending_review (code done, awaiting merge)
  1451→  markMutating(task.command("submit <ref>"))
  1452→    .description("Submit task for review (transitions to pending_review)")
  1453→    .action(async (ref: string) => {
  1454→      try {
  1455→        const ctx = await initContext();
  1456→        const tasks = await loadAllTasks(ctx);
  1457→        const items = await loadAllItems(ctx);
  1458→        const index = new ReferenceIndex(tasks, items);
  1459→        const foundTask = resolveTaskRef(ref, tasks, index);
  1460→
  1461→        if (foundTask.status !== "in_progress") {
  1462→          error(
  1463→            `Cannot submit task with status: ${foundTask.status}. Task must be in_progress.`,
  1464→          );
  1465→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1466→        }
  1467→
  1468→        const updatedTask: Task = {
  1469→          ...foundTask,
  1470→          status: "pending_review",
  1471→          submitted_at: new Date().toISOString(),
  1472→        };
  1473→
  1474→        await saveTask(ctx, updatedTask);
  1475→        await commitIfShadow(
  1476→          ctx.shadow,
  1477→          "task-submit",
  1478→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1479→        );
  1480→        success(
  1481→          `Submitted task for review: ${index.shortUlid(updatedTask._ulid)}`,
  1482→          { task: updatedTask },
  1483→        );
  1484→      } catch (err) {
  1485→        error(errors.failures.updateTask, err);
  1486→        process.exit(EXIT_CODES.ERROR);
  1487→      }
  1488→    });
  1489→
  1490→  // kspec task needs-work <ref>
  1491→  // Reviewer kicks back a task for worker to fix
  1492→  markMutating(task.command("needs-work <ref>"))
  1493→    .description(
  1494→      "Kick task back to worker for fixes (pending_review -> needs_work)",
  1495→    )
  1496→    .requiredOption("--reason <reason>", "Description of issues found")
  1497→    .action(async (ref: string, options) => {
  1498→      try {
  1499→        const ctx = await initContext();
  1500→        const tasks = await loadAllTasks(ctx);
  1501→        const items = await loadAllItems(ctx);
  1502→        const index = new ReferenceIndex(tasks, items);
  1503→        const foundTask = resolveTaskRef(ref, tasks, index);
  1504→
  1505→        if (foundTask.status !== "pending_review") {
  1506→          error(errors.status.cannotNeedsWork(foundTask.status));
  1507→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1508→        }
  1509→
  1510→        // Track fix cycle count from existing kickback notes
  1511→        const existingKickbacks = foundTask.notes.filter((n) =>
  1512→          n.content.includes("[FIX_CYCLE:"),
  1513→        ).length;
  1514→        const cycleNumber = existingKickbacks + 1;
  1515→
  1516→        const note = createNote(
  1517→          `[FIX_CYCLE: ${cycleNumber}] Review findings: ${options.reason}`,
  1518→          getAuthor(ctx.config?.identity?.author),
  1519→        );
  1520→
  1521→        // AC: @session-scoped-task-claiming ac-claim-clear
  1522→        const updatedTask: Task = {
  1523→          ...foundTask,
  1524→          status: "needs_work",
  1525→          session_id: null,
  1526→          notes: [...foundTask.notes, note],
  1527→        };
  1528→
  1529→        await saveTask(ctx, updatedTask);
  1530→        await commitIfShadow(
  1531→          ctx.shadow,
  1532→          "task-needs-work",
  1533→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1534→          `cycle ${cycleNumber}`,
  1535→        );
  1536→        success(
  1537→          `Kicked back task: ${index.shortUlid(updatedTask._ulid)} (fix cycle ${cycleNumber})`,
  1538→          { task: updatedTask },
  1539→        );
  1540→      } catch (err) {
  1541→        error(errors.failures.needsWorkTask, err);
  1542→        process.exit(EXIT_CODES.ERROR);
  1543→      }
  1544→    });
  1545→
  1546→  // kspec task block <ref>
  1547→  markMutating(task.command("block <ref>"))
  1548→    .description("Block a task")
  1549→    .requiredOption("--reason <reason>", "Reason for blocking")
  1550→    .action(async (ref: string, options) => {
  1551→      try {
  1552→        const ctx = await initContext();
  1553→        const tasks = await loadAllTasks(ctx);
  1554→        const items = await loadAllItems(ctx);
  1555→        const index = new ReferenceIndex(tasks, items);
  1556→        const foundTask = resolveTaskRef(ref, tasks, index);
  1557→
  1558→        if (
  1559→          foundTask.status === "completed" ||
  1560→          foundTask.status === "cancelled"
  1561→        ) {
  1562→          error(errors.status.cannotBlock(foundTask.status));
  1563→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1564→        }
  1565→
  1566→        const updatedTask: Task = {
  1567→          ...foundTask,
  1568→          status: "blocked",
  1569→          blocked_by: [...foundTask.blocked_by, options.reason],
  1570→        };
  1571→
  1572→        await saveTask(ctx, updatedTask);
  1573→        await commitIfShadow(
  1574→          ctx.shadow,
  1575→          "task-block",
  1576→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1577→        );
  1578→        success(`Blocked task: ${index.shortUlid(updatedTask._ulid)}`, {
  1579→          task: updatedTask,
  1580→        });
  1581→      } catch (err) {
  1582→        error(errors.failures.blockTask, err);
  1583→        process.exit(EXIT_CODES.ERROR);
  1584→      }
  1585→    });
  1586→
  1587→  // kspec task unblock <ref>
  1588→  markMutating(task.command("unblock <ref>"))
  1589→    .description("Unblock a task")
  1590→    .action(async (ref: string) => {
  1591→      try {
  1592→        const ctx = await initContext();
  1593→        const tasks = await loadAllTasks(ctx);
  1594→        const items = await loadAllItems(ctx);
  1595→        const index = new ReferenceIndex(tasks, items);
  1596→        const foundTask = resolveTaskRef(ref, tasks, index);
  1597→
  1598→        if (foundTask.status !== "blocked") {
  1599→          warn("Task is not blocked");
  1600→          return;
  1601→        }
  1602→
  1603→        // AC: @session-scoped-task-claiming ac-claim-clear
  1604→        const updatedTask: Task = {
  1605→          ...foundTask,
  1606→          status: "pending",
  1607→          blocked_by: [],
  1608→          session_id: null,
  1609→        };
  1610→
  1611→        await saveTask(ctx, updatedTask);
  1612→        await commitIfShadow(
  1613→          ctx.shadow,
  1614→          "task-unblock",
  1615→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1616→        );
  1617→        success(`Unblocked task: ${index.shortUlid(updatedTask._ulid)}`, {
  1618→          task: updatedTask,
  1619→        });
  1620→      } catch (err) {
  1621→        error(errors.failures.unblockTask, err);
  1622→        process.exit(EXIT_CODES.ERROR);
  1623→      }
  1624→    });
  1625→
  1626→  // kspec task cancel <ref> | --refs <refs...>
  1627→  // AC: @multi-ref-batch ac-1, ac-2
  1628→  markMutating(task.command("cancel [ref]"))
  1629→    .description("Cancel a task")
  1630→    .option("--refs <refs...>", "Cancel multiple tasks by ref")
  1631→    .option("--reason <reason>", "Cancellation reason")
  1632→    .addHelpText(
  1633→      "after",
  1634→      `
  1635→Examples:
  1636→  $ kspec task cancel @task-slug --reason "No longer needed"
  1637→  $ kspec task cancel --refs @task1 @task2 --reason "Superseded by @new-task"`,
  1638→    )
  1639→    .action(async (ref: string | undefined, options) => {
  1640→      try {
  1641→        const ctx = await initContext();
  1642→        const tasks = await loadAllTasks(ctx);
  1643→        const items = await loadAllItems(ctx);
  1644→        const index = new ReferenceIndex(tasks, items);
  1645→
  1646→        const result = await executeBatchOperation({
  1647→          positionalRef: ref,
  1648→          refsFlag: options.refs,
  1649→          context: { ctx, tasks, items, index, options },
  1650→          items: tasks,
  1651→          index,
  1652→          resolveRef: (refStr, taskList, idx) => {
  1653→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1654→            return { item: resolved.task, error: resolved.error };
  1655→          },
  1656→          executeOperation: async (foundTask, { ctx, index, options }) => {
  1657→            try {
  1658→              if (
  1659→                foundTask.status === "completed" ||
  1660→                foundTask.status === "cancelled"
  1661→              ) {
  1662→                return {
  1663→                  success: false,
  1664→                  error: `Task is already ${foundTask.status}`,
  1665→                };
  1666→              }
  1667→
  1668→              const updatedTask: Task = {
  1669→                ...foundTask,
  1670→                status: "cancelled",
  1671→                closed_reason: options.reason || null,
  1672→              };
  1673→
  1674→              await saveTask(ctx, updatedTask);
  1675→              await commitIfShadow(
  1676→                ctx.shadow,
  1677→                "task-cancel",
  1678→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1679→              );
  1680→
  1681→              return {
  1682→                success: true,
  1683→                message: `Cancelled task: ${index.shortUlid(updatedTask._ulid)}`,
  1684→                data: updatedTask,
  1685→              };
  1686→            } catch (err) {
  1687→              return {
  1688→                success: false,
  1689→                error: err instanceof Error ? err.message : String(err),
  1690→              };
  1691→            }
  1692→          },
  1693→          getUlid: (task) => task._ulid,
  1694→        });
  1695→
  1696→        formatBatchOutput(result, "Cancel");
  1697→      } catch (err) {
  1698→        error(errors.failures.cancelTask, err);
  1699→        process.exit(EXIT_CODES.ERROR);
  1700→      }
  1701→    });
  1702→
  1703→  // kspec task reset <ref>
  1704→  // AC: @spec-task-reset ac-1, ac-2, ac-3, ac-4, ac-5, ac-6
  1705→  markMutating(task.command("reset <ref>"))
  1706→    .description("Reset a task to pending state")
  1707→    .action(async (ref: string) => {
  1708→      try {
  1709→        const ctx = await initContext();
  1710→        const tasks = await loadAllTasks(ctx);
  1711→        const items = await loadAllItems(ctx);
  1712→        const index = new ReferenceIndex(tasks, items);
  1713→        const foundTask = resolveTaskRef(ref, tasks, index);
  1714→
  1715→        // AC: @spec-task-reset ac-2 - Error if already pending
  1716→        if (foundTask.status === "pending") {
  1717→          error("Task is already pending");
  1718→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1719→        }
  1720→
  1721→        // Track previous status and reason for note (AC-4)
  1722→        const previousStatus = foundTask.status;
  1723→        const hadCancelReason =
  1724→          foundTask.closed_reason && foundTask.status === "cancelled";
  1725→        const cancelReasonText = hadCancelReason
  1726→          ? ` (was cancelled: ${foundTask.closed_reason})`
  1727→          : "";
  1728→
  1729→        // AC: @spec-task-reset ac-1 - Reset to pending, clear completion-related fields
  1730→        const clearedFields: string[] = [];
  1731→        const updatedTask: Task = {
  1732→          ...foundTask,
  1733→          status: "pending",
  1734→        };
  1735→
  1736→        // Clear timestamps and reasons based on previous status
  1737→        if (
  1738→          foundTask.completed_at !== undefined &&
  1739→          foundTask.completed_at !== null
  1740→        ) {
  1741→          updatedTask.completed_at = null;
  1742→          clearedFields.push("completed_at");
  1743→        }
  1744→        if (
  1745→          foundTask.started_at !== undefined &&
  1746→          foundTask.started_at !== null
  1747→        ) {
  1748→          updatedTask.started_at = null;
  1749→          clearedFields.push("started_at");
  1750→        }
  1751→        if (
  1752→          foundTask.closed_reason !== undefined &&
  1753→          foundTask.closed_reason !== null
  1754→        ) {
  1755→          updatedTask.closed_reason = null;
  1756→          clearedFields.push("closed_reason");
  1757→        }
  1758→        if (foundTask.blocked_by.length > 0) {
  1759→          updatedTask.blocked_by = [];
  1760→          clearedFields.push("blocked_by");
  1761→        }
  1762→        // AC: @session-scoped-task-claiming ac-claim-clear
  1763→        if (foundTask.session_id) {
  1764→          updatedTask.session_id = null;
  1765→          clearedFields.push("session_id");
  1766→        }
  1767→
  1768→        // AC: @spec-task-reset ac-4 - Add note documenting the reset
  1769→        // AC: @spec-task-reset ac-author
  1770→        const noteContent = `Reset from ${previousStatus} to pending${cancelReasonText}`;
  1771→        const note = createNote(noteContent, getAuthor(ctx.config?.identity?.author));
  1772→        updatedTask.notes = [...updatedTask.notes, note];
  1773→
  1774→        await saveTask(ctx, updatedTask);
  1775→        // AC: @spec-task-reset ac-3 - Shadow commit with message task-reset
  1776→        await commitIfShadow(
  1777→          ctx.shadow,
  1778→          "task-reset",
  1779→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1780→          `from ${previousStatus}`,
  1781→        );
  1782→
  1783→        // AC: @spec-task-reset ac-6 - JSON output includes previous_status, new_status, cleared_fields
  1784→        const jsonOutput = {
  1785→          task: updatedTask,
  1786→          previous_status: previousStatus,
  1787→          new_status: "pending" as const,
  1788→          cleared_fields: clearedFields,
  1789→        };
  1790→
  1791→        output(jsonOutput, () => {
  1792→          success(
  1793→            `Reset task: ${index.shortUlid(updatedTask._ulid)} (${previousStatus} → pending)`,
  1794→            undefined,
  1795→          );
  1796→          if (clearedFields.length > 0) {
  1797→            info(`Cleared fields: ${clearedFields.join(", ")}`);
  1798→          }
  1799→        });
  1800→      } catch (err) {
  1801→        error("Failed to reset task", err);
  1802→        process.exit(EXIT_CODES.ERROR);
  1803→      }
  1804→    });
  1805→
  1806→  // kspec task delete <ref> | --refs <refs...>
  1807→  // AC: @multi-ref-batch ac-1, ac-2
  1808→  markMutating(task.command("delete [ref]"))
  1809→    .description("Delete a task permanently")
  1810→    .option("--refs <refs...>", "Delete multiple tasks by ref")
  1811→    .option("--force", "Skip confirmation (required for --refs)")
  1812→    .option("--dry-run", "Show what would be deleted without deleting")
  1813→    .addHelpText(
  1814→      "after",
  1815→      `
  1816→Examples:
  1817→  $ kspec task delete @task-slug
  1818→  $ kspec task delete --refs @task1 @task2 --force
  1819→  $ kspec task delete --refs @task1 @task2 --dry-run`,
  1820→    )
  1821→    .action(async (ref: string | undefined, options) => {
  1822→      try {
  1823→        const ctx = await initContext();
  1824→        const tasks = await loadAllTasks(ctx);
  1825→        const items = await loadAllItems(ctx);
  1826→        const index = new ReferenceIndex(tasks, items);
  1827→
  1828→        // For batch mode (--refs), require --force
  1829→        if (
  1830→          options.refs &&
  1831→          options.refs.length > 0 &&
  1832→          !options.force &&
  1833→          !options.dryRun
  1834→        ) {
  1835→          error("Batch delete requires --force flag");
  1836→          process.exit(EXIT_CODES.USAGE_ERROR);
  1837→        }
  1838→
  1839→        const result = await executeBatchOperation({
  1840→          positionalRef: ref,
  1841→          refsFlag: options.refs,
  1842→          context: { ctx, tasks, items, index, options },
  1843→          items: tasks,
  1844→          index,
  1845→          resolveRef: (refStr, taskList, idx) => {
  1846→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1847→            return { item: resolved.task, error: resolved.error };
  1848→          },
  1849→          executeOperation: async (foundTask, { ctx, index, options }) => {
  1850→            try {
  1851→              const taskDisplay = `${foundTask.title} (${index.shortUlid(foundTask._ulid)})`;
  1852→
  1853→              if (options.dryRun) {
  1854→                return {
  1855→                  success: true,
  1856→                  message: `Would delete: ${taskDisplay}`,
  1857→                };
  1858→              }
  1859→
  1860→              // For single-ref mode (not --refs), prompt for confirmation unless --force
  1861→              if (!options.refs && !options.force) {
  1862→                const readline = await import("node:readline");
  1863→                const rl = readline.createInterface({
  1864→                  input: process.stdin,
  1865→                  output: process.stdout,
  1866→                });
  1867→
  1868→                const answer = await new Promise<string>((resolve) => {
  1869→                  rl.question(`Delete task "${taskDisplay}"? [y/N] `, resolve);
  1870→                });
  1871→                rl.close();
  1872→
  1873→                if (answer.toLowerCase() !== "y") {
  1874→                  return {
  1875→                    success: false,
  1876→                    error: "Deletion cancelled by user",
  1877→                  };
  1878→                }
  1879→              }
  1880→
  1881→              await deleteTask(ctx, foundTask);
  1882→              await commitIfShadow(
  1883→                ctx.shadow,
  1884→                "task-delete",
  1885→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1886→                foundTask.title,
  1887→              );
  1888→
  1889→              return {
  1890→                success: true,
  1891→                message: `Deleted task: ${taskDisplay}`,
  1892→              };
  1893→            } catch (err) {
  1894→              return {
  1895→                success: false,
  1896→                error: err instanceof Error ? err.message : String(err),
  1897→              };
  1898→            }
  1899→          },
  1900→          getUlid: (task) => task._ulid,
  1901→        });
  1902→
  1903→        formatBatchOutput(result, "Delete");
  1904→      } catch (err) {
  1905→        error(errors.failures.deleteTask, err);
  1906→        process.exit(EXIT_CODES.ERROR);
  1907→      }
  1908→    });
  1909→
  1910→  // kspec task note <ref> <message>
