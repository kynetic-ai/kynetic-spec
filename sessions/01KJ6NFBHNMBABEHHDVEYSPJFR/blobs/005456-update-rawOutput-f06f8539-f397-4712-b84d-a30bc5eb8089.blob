     1→/**
     2→ * Tests for plan document parser
     3→ *
     4→ * AC: @plan-import ac-11 - Parse ## Specs YAML blocks
     5→ * AC: @plan-import ac-12 - Support derive_from_specs flag
     6→ * AC: @plan-import ac-13 - Extract ## Implementation Notes
     7→ * AC: @plan-import ac-16 - Topological ordering
     8→ * AC: @plan-import ac-17 - Detect missing parent references
     9→ * AC: @plan-import ac-18 - Detect circular dependencies
    10→ * AC: @plan-import ac-21 - Handle YAML parse errors
    11→ * AC: @plan-import ac-22 - Validate required fields
    12→ */
    13→
    14→import { describe, expect, it } from "vitest";
    15→import {
    16→  parsePlanDocument,
    17→  topologicalSort,
    18→  validateParentRefs,
    19→  type PlanSpec,
    20→} from "../src/parser/plan-document.js";
    21→import { createSpecItem } from "../src/parser/yaml.js";
    22→
    23→describe("Plan Document Parser", () => {
    24→  // AC: @plan-import ac-11
    25→  it("should parse specs from ## Specs YAML block", () => {
    26→    const plan = `
    27→# Test Plan
    28→
    29→## Specs
    30→
    31→\`\`\`yaml
    32→- title: JSON Output Mode
    33→  slug: json-output
    34→  type: feature
    35→  description: Add JSON output support
    36→
    37→- title: CLI Traits
    38→  slug: cli-traits
    39→  type: requirement
    40→  description: Common CLI behaviors
    41→\`\`\`
    42→`;
    43→
    44→    const result = parsePlanDocument(plan);
    45→
    46→    expect(result.specs).toHaveLength(2);
    47→    expect(result.specs[0]).toMatchObject({
    48→      title: "JSON Output Mode",
    49→      slug: "json-output",
    50→      type: "feature",
    51→      description: "Add JSON output support",
    52→    });
    53→    expect(result.specs[1]).toMatchObject({
    54→      title: "CLI Traits",
    55→      slug: "cli-traits",
    56→      type: "requirement",
    57→    });
    58→    expect(result.errors).toHaveLength(0);
    59→  });
    60→
    61→  // AC: @plan-import ac-12
    62→  it("should parse derive_from_specs flag from ## Tasks section", () => {
    63→    const plan = `
    64→# Test Plan
    65→
    66→## Specs
    67→
    68→\`\`\`yaml
    69→- title: Feature A
    70→\`\`\`
    71→
    72→## Tasks
    73→
    74→derive_from_specs: true
    75→`;
    76→
    77→    const result = parsePlanDocument(plan);
    78→
    79→    expect(result.tasks.derive_from_specs).toBe(true);
    80→    expect(result.errors).toHaveLength(0);
    81→  });
    82→
    83→  // AC: @plan-import ac-13
    84→  it("should extract ## Implementation Notes section", () => {
    85→    const plan = `
    86→# Test Plan
    87→
    88→## Specs
    89→
    90→\`\`\`yaml
    91→- title: Feature A
    92→\`\`\`
    93→
    94→## Implementation Notes
    95→
    96→Use existing patterns.
    97→Add comprehensive tests.
    98→`;
    99→
   100→    const result = parsePlanDocument(plan);
   101→
   102→    expect(result.implementationNotes).toBe(
   103→      "Use existing patterns.\nAdd comprehensive tests.",
   104→    );
   105→  });
   106→
   107→  // AC: @plan-import ac-21
   108→  it("should handle malformed YAML in Specs section", () => {
   109→    const plan = `
   110→# Test Plan
   111→
   112→## Specs
   113→
   114→\`\`\`yaml
   115→- title: Feature A
   116→  invalid yaml: [unclosed
   117→\`\`\`
   118→`;
   119→
   120→    const result = parsePlanDocument(plan);
   121→
   122→    expect(result.specs).toHaveLength(0);
   123→    expect(result.errors).toHaveLength(1);
   124→    expect(result.errors[0].type).toBe("yaml");
   125→    expect(result.errors[0].message).toContain("Malformed YAML");
   126→  });
   127→
   128→  // AC: @plan-import ac-22
   129→  it("should validate required title field in specs", () => {
   130→    const plan = `
   131→# Test Plan
   132→
   133→## Specs
   134→
   135→\`\`\`yaml
   136→- slug: missing-title
   137→  type: feature
   138→
   139→- title: Valid Spec
   140→\`\`\`
   141→`;
   142→
   143→    const result = parsePlanDocument(plan);
   144→
   145→    expect(result.specs).toHaveLength(1);
   146→    expect(result.specs[0].title).toBe("Valid Spec");
   147→    expect(result.errors).toHaveLength(1);
   148→    expect(result.errors[0].type).toBe("validation");
   149→    expect(result.errors[0].message).toContain("missing required field: title");
   150→    expect(result.errors[0].specIndex).toBe(0);
   151→  });
   152→
   153→  it("should handle empty plan documents", () => {
   154→    const plan = `# Empty Plan`;
   155→
   156→    const result = parsePlanDocument(plan);
   157→
   158→    expect(result.title).toBe("Empty Plan");
   159→    expect(result.specs).toHaveLength(0);
   160→    expect(result.tasks).toEqual({});
   161→    expect(result.implementationNotes).toBeNull();
   162→    expect(result.errors).toHaveLength(0);
   163→  });
   164→
   165→  it("should handle plan without title", () => {
   166→    const plan = `No heading here`;
   167→
   168→    const result = parsePlanDocument(plan);
   169→
   170→    expect(result.title).toBe("Untitled Plan");
   171→  });
   172→
   173→  it("should parse additional tasks from Tasks section", () => {
   174→    const plan = `
   175→# Test Plan
   176→
   177→## Specs
   178→
   179→\`\`\`yaml
   180→- title: Feature A
   181→\`\`\`
   182→
   183→## Tasks
   184→
   185→derive_from_specs: true
   186→
   187→\`\`\`yaml
   188→- title: Manual Task 1
   189→  priority: 1
   190→  tags: [manual, testing]
   191→
   192→- title: Manual Task 2
   193→  priority: 2
   194→\`\`\`
   195→`;
   196→
   197→    const result = parsePlanDocument(plan);
   198→
   199→    expect(result.tasks.derive_from_specs).toBe(true);
   200→    expect(result.tasks.additional_tasks).toHaveLength(2);
   201→    expect(result.tasks.additional_tasks?.[0]).toMatchObject({
   202→      title: "Manual Task 1",
   203→      priority: 1,
   204→      tags: ["manual", "testing"],
   205→    });
   206→  });
   207→
   208→  it("should handle specs with all optional fields", () => {
   209→    const plan = `
   210→# Test Plan
   211→
   212→## Specs
   213→
   214→\`\`\`yaml
   215→- title: Full Spec
   216→  slug: full-spec
   217→  type: feature
   218→  parent: "@parent-spec"
   219→  description: Full description
   220→  acceptance_criteria:
   221→    - id: ac-1
   222→      given: condition
   223→      when: action
   224→      then: result
   225→  traits:
   226→    - "@json-output"
   227→    - "@dry-run"
   228→  implementation_notes: |
   229→    Use existing patterns for this feature.
   230→\`\`\`
   231→`;
   232→
   233→    const result = parsePlanDocument(plan);
   234→
   235→    expect(result.specs).toHaveLength(1);
   236→    expect(result.specs[0]).toMatchObject({
   237→      title: "Full Spec",
   238→      slug: "full-spec",
   239→      type: "feature",
   240→      parent: "@parent-spec",
   241→      description: "Full description",
   242→      acceptance_criteria: [
   243→        {
   244→          id: "ac-1",
   245→          given: "condition",
   246→          when: "action",
   247→          then: "result",
   248→        },
   249→      ],
   250→      traits: ["@json-output", "@dry-run"],
   251→      implementation_notes: "Use existing patterns for this feature.\n",
   252→    });
   253→  });
   254→
   255→  // AC: @plan-import ac-35 - Parse depends_on on specs
   256→  it("should parse depends_on array on specs", () => {
   257→    const plan = `
   258→# Test Plan
   259→
   260→## Specs
   261→
   262→\`\`\`yaml
   263→- title: Base Feature
   264→  slug: base-feature
   265→  type: feature
   266→
   267→- title: Dependent Feature
   268→  slug: dependent-feature
   269→  type: feature
   270→  depends_on:
   271→    - base-feature
   272→    - "@external-spec"
   273→\`\`\`
   274→`;
   275→
   276→    const result = parsePlanDocument(plan);
   277→
   278→    expect(result.specs).toHaveLength(2);
   279→    expect(result.specs[0].depends_on).toBeUndefined();
   280→    expect(result.specs[1].depends_on).toEqual(["base-feature", "@external-spec"]);
   281→    expect(result.errors).toHaveLength(0);
   282→  });
   283→
   284→  // AC: @plan-import ac-35 - Parse depends_on on manual tasks
   285→  it("should parse depends_on array on additional tasks", () => {
   286→    const plan = `
   287→# Test Plan
   288→
   289→## Specs
   290→
   291→\`\`\`yaml
   292→- title: Feature A
   293→\`\`\`
   294→
   295→## Tasks
   296→
   297→\`\`\`yaml
   298→- title: Manual Task
   299→  depends_on:
   300→    - "@task-something"
   301→    - other-task
   302→\`\`\`
   303→`;
   304→
   305→    const result = parsePlanDocument(plan);
   306→
   307→    expect(result.tasks.additional_tasks).toHaveLength(1);
   308→    expect(result.tasks.additional_tasks?.[0].depends_on).toEqual([
   309→      "@task-something",
   310→      "other-task",
   311→    ]);
   312→  });
   313→
   314→  it("should parse implementation_notes on some specs and not others", () => {
   315→    const plan = `
   316→# Test Plan
   317→
   318→## Specs
   319→
   320→\`\`\`yaml
   321→- title: Spec With Notes
   322→  slug: with-notes
   323→  implementation_notes: |
   324→    Specific notes for this spec.
   325→
   326→- title: Spec Without Notes
   327→  slug: without-notes
   328→\`\`\`
   329→`;
   330→
   331→    const result = parsePlanDocument(plan);
   332→
   333→    expect(result.specs).toHaveLength(2);
   334→    expect(result.specs[0].implementation_notes).toBe("Specific notes for this spec.\n");
   335→    expect(result.specs[1].implementation_notes).toBeUndefined();
   336→  });
   337→});
   338→
   339→describe("Topological Sort", () => {
   340→  // AC: @plan-import ac-16
   341→  it("should sort specs in topological order (parents before children)", () => {
   342→    const specs: PlanSpec[] = [
   343→      { title: "Child", slug: "child", parent: "@parent" },
   344→      { title: "Parent", slug: "parent" },
   345→      { title: "Grandchild", slug: "grandchild", parent: "@child" },
   346→    ];
   347→
   348→    const result = topologicalSort(specs);
   349→
   350→    expect(result.error).toBeNull();
   351→    expect(result.sorted).toHaveLength(3);
   352→    expect(result.sorted[0].slug).toBe("parent");
   353→    expect(result.sorted[1].slug).toBe("child");
   354→    expect(result.sorted[2].slug).toBe("grandchild");
   355→  });
   356→
   357→  // AC: @plan-import ac-18
   358→  it("should detect circular parent references", () => {
   359→    const specs: PlanSpec[] = [
   360→      { title: "Spec A", slug: "spec-a", parent: "@spec-b" },
   361→      { title: "Spec B", slug: "spec-b", parent: "@spec-a" },
   362→    ];
   363→
   364→    const result = topologicalSort(specs);
   365→
   366→    expect(result.error).not.toBeNull();
   367→    expect(result.error?.type).toBe("circular");
   368→    expect(result.error?.message).toContain("Circular parent reference");
   369→    expect(result.error?.message).toContain("@spec-a");
   370→    expect(result.error?.message).toContain("@spec-b");
   371→  });
   372→
   373→  it("should handle specs without parents", () => {
   374→    const specs: PlanSpec[] = [
   375→      { title: "Spec 1", slug: "spec-1" },
   376→      { title: "Spec 2", slug: "spec-2" },
   377→    ];
   378→
   379→    const result = topologicalSort(specs);
   380→
   381→    expect(result.error).toBeNull();
   382→    expect(result.sorted).toHaveLength(2);
   383→  });
   384→
   385→  it("should ignore external parent references", () => {
   386→    const specs: PlanSpec[] = [
   387→      { title: "Child", slug: "child", parent: "@external-parent" },
   388→      { title: "Sibling", slug: "sibling" },
   389→    ];
   390→
   391→    const result = topologicalSort(specs);
   392→
   393→    expect(result.error).toBeNull();
   394→    expect(result.sorted).toHaveLength(2);
   395→  });
   396→
   397→  it("should handle parent ref with or without @ prefix", () => {
   398→    const specs: PlanSpec[] = [
   399→      { title: "Child 1", slug: "child-1", parent: "@parent" },
   400→      { title: "Child 2", slug: "child-2", parent: "parent" },
   401→      { title: "Parent", slug: "parent" },
   402→    ];
   403→
   404→    const result = topologicalSort(specs);
   405→
   406→    expect(result.error).toBeNull();
   407→    expect(result.sorted[0].slug).toBe("parent");
   408→  });
   409→
   410→  it("should handle complex dependency graph", () => {
   411→    const specs: PlanSpec[] = [
   412→      { title: "D", slug: "d", parent: "@b" },
   413→      { title: "B", slug: "b", parent: "@a" },
   414→      { title: "A", slug: "a" },
   415→      { title: "C", slug: "c", parent: "@a" },
   416→      { title: "E", slug: "e" },
   417→    ];
   418→
   419→    const result = topologicalSort(specs);
   420→
   421→    expect(result.error).toBeNull();
   422→    expect(result.sorted).toHaveLength(5);
   423→
   424→    // A must come before B, C, D
   425→    const aIndex = result.sorted.findIndex(s => s.slug === "a");
   426→    const bIndex = result.sorted.findIndex(s => s.slug === "b");
   427→    const cIndex = result.sorted.findIndex(s => s.slug === "c");
   428→    const dIndex = result.sorted.findIndex(s => s.slug === "d");
   429→
   430→    expect(aIndex).toBeLessThan(bIndex);
   431→    expect(aIndex).toBeLessThan(cIndex);
   432→    expect(bIndex).toBeLessThan(dIndex);
   433→  });
   434→
   435→  it("should detect three-way circular dependency", () => {
   436→    const specs: PlanSpec[] = [
   437→      { title: "A", slug: "a", parent: "@b" },
   438→      { title: "B", slug: "b", parent: "@c" },
   439→      { title: "C", slug: "c", parent: "@a" },
   440→    ];
   441→
   442→    const result = topologicalSort(specs);
   443→
   444→    expect(result.error).not.toBeNull();
   445→    expect(result.error?.type).toBe("circular");
   446→    expect(result.error?.message).toContain("Circular parent reference");
   447→  });
   448→
   449→  it("should auto-generate slugs from titles when missing", () => {
   450→    const specs: PlanSpec[] = [
   451→      { title: "Child Spec", parent: "@parent-spec" },
   452→      { title: "Parent Spec" },
   453→    ];
   454→
   455→    const result = topologicalSort(specs);
   456→
   457→    expect(result.error).toBeNull();
   458→    expect(result.sorted[0].title).toBe("Parent Spec");
   459→    expect(result.sorted[1].title).toBe("Child Spec");
   460→  });
   461→});
   462→
   463→describe("Parent Reference Validation", () => {
   464→  // AC: @plan-import ac-17
   465→  it("should detect missing parent references", () => {
   466→    const specs: PlanSpec[] = [
   467→      { title: "Child", slug: "child", parent: "@nonexistent" },
   468→    ];
   469→
   470→    const existingRefs = new Set<string>();
   471→
   472→    const errors = validateParentRefs(specs, existingRefs);
   473→
   474→    expect(errors).toHaveLength(1);
   475→    expect(errors[0].type).toBe("dependency");
   476→    expect(errors[0].message).toContain("Parent @nonexistent not found");
   477→    expect(errors[0].spec).toBe(specs[0]);
   478→  });
   479→
   480→  // AC: @plan-import ac-33
   481→  it("should provide recovery hint for missing parents", () => {
   482→    const specs: PlanSpec[] = [
   483→      { title: "Child", slug: "child", parent: "@missing" },
   484→    ];
   485→
   486→    const errors = validateParentRefs(specs, new Set());
   487→
   488→    expect(errors[0].message).toContain(
   489→      "Check parent exists or define it earlier in plan",
   490→    );
   491→  });
   492→
   493→  it("should allow parent refs to specs within the plan", () => {
   494→    const specs: PlanSpec[] = [
   495→      { title: "Child", slug: "child", parent: "@parent" },
   496→      { title: "Parent", slug: "parent" },
   497→    ];
   498→
   499→    const errors = validateParentRefs(specs, new Set());
   500→
   501→    expect(errors).toHaveLength(0);
   502→  });
   503→
   504→  it("should allow parent refs to existing project specs", () => {
   505→    const specs: PlanSpec[] = [
   506→      { title: "Child", slug: "child", parent: "@existing-parent" },
   507→    ];
   508→
   509→    const existingRefs = new Set(["existing-parent"]);
   510→
   511→    const errors = validateParentRefs(specs, existingRefs);
   512→
   513→    expect(errors).toHaveLength(0);
   514→  });
   515→
   516→  it("should handle parent refs with or without @ prefix", () => {
   517→    const specs: PlanSpec[] = [
   518→      { title: "Child", slug: "child", parent: "parent" },
   519→      { title: "Parent", slug: "parent" },
   520→    ];
   521→
   522→    const errors = validateParentRefs(specs, new Set());
   523→
   524→    expect(errors).toHaveLength(0);
   525→  });
   526→
   527→  it("should validate multiple specs with mixed valid/invalid parents", () => {
   528→    const specs: PlanSpec[] = [
   529→      { title: "Valid Child", slug: "valid", parent: "@parent" },
   530→      { title: "Invalid Child", slug: "invalid", parent: "@nonexistent" },
   531→      { title: "Parent", slug: "parent" },
   532→    ];
   533→
   534→    const errors = validateParentRefs(specs, new Set());
   535→
   536→    expect(errors).toHaveLength(1);
   537→    expect(errors[0].spec?.slug).toBe("invalid");
   538→  });
   539→});
   540→
   541→describe("Plan Document Parser - missing YAML block warning", () => {
   542→  // AC: @plan-import ac-34
   543→  it("should warn when Specs section exists but has no YAML code block", () => {
   544→    const plan = `
   545→# Test Plan
   546→
   547→## Specs
   548→
   549→Here are the specs I want to create:
   550→- Feature A
   551→- Feature B
   552→
   553→## Implementation Notes
   554→
   555→Some notes here.
   556→`;
   557→
   558→    const result = parsePlanDocument(plan);
   559→
   560→    expect(result.specs).toHaveLength(0);
   561→    expect(result.errors.length).toBeGreaterThan(0);
   562→    expect(result.errors.some(e =>
   563→      e.type === "validation" && e.message.includes("no YAML code block")
   564→    )).toBe(true);
   565→  });
   566→
   567→  it("should not warn when Specs section has a YAML code block", () => {
   568→    const plan = `
   569→# Test Plan
   570→
   571→## Specs
   572→
   573→\`\`\`yaml
   574→- title: Feature A
   575→  slug: feature-a
   576→  type: feature
   577→  description: A feature
   578→\`\`\`
   579→`;
   580→
   581→    const result = parsePlanDocument(plan);
   582→
   583→    expect(result.errors.filter(e =>
   584→      e.type === "validation" && e.message.includes("no YAML code block")
   585→    )).toHaveLength(0);
   586→  });
   587→
   588→  it("should not warn when there is no Specs section at all", () => {
   589→    const plan = `
   590→# Test Plan
   591→
   592→## Implementation Notes
   593→
   594→Just some notes, no specs section.
   595→`;
   596→
   597→    const result = parsePlanDocument(plan);
   598→
   599→    expect(result.errors.filter(e =>
   600→      e.message.includes("no YAML code block")
   601→    )).toHaveLength(0);
   602→  });
   603→});
   604→
   605→describe("createSpecItem", () => {
   606→  it("should preserve acceptance_criteria when provided", () => {
   607→    const ac = [
   608→      { id: "ac-1", given: "precondition", when: "action", then: "result" },
   609→    ];
   610→    const item = createSpecItem({
   611→      title: "Test Feature",
   612→      type: "feature",
   613→      slugs: ["test-feature"],
   614→      acceptance_criteria: ac,
   615→    });
   616→
   617→    expect(item.acceptance_criteria).toEqual(ac);
   618→  });
   619→
   620→  it("should leave acceptance_criteria undefined when not provided", () => {
   621→    const item = createSpecItem({
   622→      title: "Test Feature",
   623→      type: "feature",
   624→      slugs: ["test-feature"],
   625→    });
   626→
   627→    expect(item.acceptance_criteria).toBeUndefined();
   628→  });
   629→});
   630→