     1→/**
     2→ * Plan import CLI command
     3→ * AC: @plan-import ac-11 through ac-33
     4→ */
     5→
     6→import * as fs from "node:fs/promises";
     7→import * as path from "node:path";
     8→import type { Command } from "commander";
     9→import { markMutating } from "../command-annotations.js";
    10→import {
    11→  addChildItem,
    12→  buildIndexes,
    13→  createPlan,
    14→  createSpecItem,
    15→  createTask,
    16→  getAuthor,
    17→  initContext,
    18→  loadAllTasks,
    19→  loadPlans,
    20→  savePlan,
    21→  saveTask,
    22→  updateSpecItem,
    23→  type LoadedSpecItem,
    24→} from "../../parser/index.js";
    25→import {
    26→  parsePlanDocument,
    27→  topologicalSort,
    28→  validateParentRefs,
    29→  type PlanSpec,
    30→} from "../../parser/plan-document.js";
    31→import { commitIfShadow } from "../../parser/shadow.js";
    32→import { normalizeRefInput } from "../../schema/index.js";
    33→import type { PlanInput, SpecItemInput, TaskInput } from "../../schema/index.js";
    34→import { errors } from "../../strings/index.js";
    35→import { EXIT_CODES } from "../exit-codes.js";
    36→import { error, info, isJsonMode, output, success, warn } from "../output.js";
    37→import { ulid } from "ulid";
    38→
    39→/**
    40→ * Register plan import command
    41→ * AC: @plan-import ac-11, ac-15, ac-32
    42→ */
    43→export function registerPlanImportCommand(planCommand: Command): void {
    44→  markMutating(planCommand.command("import <path>"))
    45→    .description("Import plan document and auto-generate specs/tasks")
    46→    .requiredOption(
    47→      "--module <ref>",
    48→      "Module to add specs under (e.g., @core-module)",
    49→    )
    50→    .option("--dry-run", "Show what would be created without making changes")
    51→    .option("--update", "Update existing specs instead of skipping them")
    52→    .option("--json", "Output as JSON")
    53→    .addHelpText(
    54→      "after",
    55→      `
    56→Format:
    57→  Plan documents use markdown with a ## Specs section containing a fenced
    58→  YAML code block. The YAML must be wrapped in triple-backtick yaml markers:
    59→
    60→    ## Specs
    61→    \`\`\`yaml
    62→    - title: My Feature
    63→      type: feature
    64→    \`\`\`
    65→
    66→  Without the fenced code block, specs will not be detected.
    67→
    68→Examples:
    69→  $ kspec plan import ./plan.md --module @core
    70→  $ kspec plan import ./plan.md --module @api --dry-run
    71→  $ kspec plan import ./plan.md --module @features --update --json`,
    72→    )
    73→    .action(async (planPath: string, options) => {
    74→      try {
    75→        await importPlan(planPath, options);
    76→      } catch (err) {
    77→        error("Failed to import plan", err);
    78→        process.exit(EXIT_CODES.ERROR);
    79→      }
    80→    });
    81→}
    82→
    83→/**
    84→ * Import operation result
    85→ */
    86→interface ImportResult {
    87→  createdSpecs: string[];
    88→  updatedSpecs: string[];
    89→  createdTasks: string[];
    90→  errors: Array<{ message: string; spec?: PlanSpec }>;
    91→  skipped: Array<{ slug: string; reason: string }>;
    92→  planRef: string;
    93→}
    94→
    95→/**
    96→ * Import plan document and create specs/tasks
    97→ * AC: @plan-import ac-11 through ac-33
    98→ */
    99→async function importPlan(
   100→  planPath: string,
   101→  options: { module: string; dryRun?: boolean; update?: boolean },
   102→): Promise<void> {
   103→  // JSON mode is set by global preAction hook
   104→
   105→  const ctx = await initContext();
   106→  const author = getAuthor(ctx.config?.identity?.author);
   107→
   108→  // Read plan file
   109→  // AC: @plan-import ac-21 - Handle file read errors
   110→  const fullPath = path.resolve(process.cwd(), planPath);
   111→  let content: string;
   112→  try {
   113→    content = await fs.readFile(fullPath, "utf-8");
   114→  } catch (err) {
   115→    error(`Failed to read plan file: ${planPath}`, err);
   116→    process.exit(EXIT_CODES.USAGE_ERROR);
   117→  }
   118→
   119→  // Parse plan document
   120→  // AC: @plan-import ac-11, ac-12, ac-13, ac-21, ac-22
   121→  const parsed = parsePlanDocument(content);
   122→
   123→  // Report parsing errors
   124→  if (parsed.errors.length > 0) {
   125→    for (const err of parsed.errors) {
   126→      if (err.type === "yaml") {
   127→        // AC: @plan-import ac-21 - YAML parse errors (fatal)
   128→        error(err.message);
   129→        process.exit(EXIT_CODES.USAGE_ERROR);
   130→      } else if (err.type === "validation") {
   131→        // AC: @plan-import ac-22 - Validation errors (non-fatal, add to warnings)
   132→        warn(err.message);
   133→      }
   134→    }
   135→  }
   136→
   137→  // Load plans for cross-namespace slug safety
   138→  const plans = await loadPlans(ctx);
   139→
   140→  // Build indexes to check existing specs (include plans for cross-namespace slug safety)
   141→  const { refIndex, items } = await buildIndexes(ctx, plans);
   142→  const existingSpecRefs = new Set<string>();
   143→  for (const item of items) {
   144→    for (const slug of (item as LoadedSpecItem).slugs || []) {
   145→      existingSpecRefs.add(slug);
   146→    }
   147→    existingSpecRefs.add(item._ulid.slice(0, 8));
   148→  }
   149→
   150→  // Resolve module reference
   151→  const moduleResult = refIndex.resolve(options.module);
   152→  if (!moduleResult.ok) {
   153→    error(errors.reference.itemNotFound(options.module));
   154→    process.exit(EXIT_CODES.NOT_FOUND);
   155→  }
   156→
   157→  const moduleItem = moduleResult.item as LoadedSpecItem;
   158→
   159→  // Verify it's a module
   160→  if (moduleItem.type !== "module") {
   161→    error(`${options.module} is not a module (type: ${moduleItem.type})`);
   162→    process.exit(EXIT_CODES.USAGE_ERROR);
   163→  }
   164→
   165→  // Validate parent references
   166→  // AC: @plan-import ac-17, ac-33
   167→  const parentErrors = validateParentRefs(parsed.specs, existingSpecRefs);
   168→  parsed.errors.push(...parentErrors);
   169→
   170→  // Sort specs topologically
   171→  // AC: @plan-import ac-16, ac-18
   172→  const { sorted, error: sortError } = topologicalSort(parsed.specs);
   173→  if (sortError) {
   174→    // AC: @plan-import ac-18 - Circular dependency detection
   175→    error(sortError.message);
   176→    process.exit(EXIT_CODES.USAGE_ERROR);
   177→  }
   178→
   179→  // Create plan record
   180→  // AC: @plan-import ac-24, ac-28
   181→  // Auto-namespace plan slugs with "plan-" prefix to prevent collision with spec slugs
   182→  // Ensure uniqueness across all namespaces (plans + specs + tasks via refIndex)
   183→  let planSlug = `plan-${generateSlug(parsed.title)}`;
   184→  let counter = 1;
   185→  const baseSlug = planSlug;
   186→  while (!refIndex.isSlugAvailable(planSlug)) {
   187→    planSlug = `${baseSlug}-${counter}`;
   188→    counter++;
   189→  }
   190→
   191→  // Track all slugs created during this import (refIndex is stale after mutations)
   192→  const importReservedSlugs = new Set<string>([planSlug]);
   193→
   194→  const planInput: PlanInput = {
   195→    title: parsed.title,
   196→    content: parsed.content,
   197→    status: "active",
   198→    slugs: [planSlug],
   199→    source_path: fullPath,
   200→  };
   201→
   202→  const newPlan = createPlan(planInput);
   203→  const planRef = `@${planSlug}`;
   204→
   205→  // AC: @plan-import ac-13 - Attach global implementation notes to plan record
   206→  if (parsed.implementationNotes) {
   207→    newPlan.notes.push({
   208→      _ulid: ulid(),
   209→      created_at: new Date().toISOString(),
   210→      author,
   211→      content: `Implementation notes:\n\n${parsed.implementationNotes}`,
   212→    });
   213→  }
   214→
   215→  // Initialize result
   216→  const result: ImportResult = {
   217→    createdSpecs: [],
   218→    updatedSpecs: [],
   219→    createdTasks: [],
   220→    errors: [],
   221→    skipped: [],
   222→    planRef,
   223→  };
   224→
   225→  // Add parser validation errors to result
   226→  // AC: @plan-import ac-22, ac-29 - Include parser validation errors in summary
   227→  for (const err of parsed.errors) {
   228→    if (err.type === "validation") {
   229→      result.errors.push({ message: err.message });
   230→    }
   231→  }
   232→
   233→  // Track newly created specs for parent resolution
   234→  // AC: @plan-import ac-16 - Resolve local references
   235→  const createdSpecsMap = new Map<string, LoadedSpecItem>();
   236→
   237→  // Process specs
   238→  // AC: @plan-import ac-14, ac-16, ac-17, ac-22, ac-23, ac-25, ac-26, ac-29
   239→  for (let i = 0; i < sorted.length; i++) {
   240→    const spec = sorted[i];
   241→    try {
   242→      // Validate required fields first
   243→      // AC: @plan-import ac-22
   244→      if (!spec.title) {
   245→        const errMsg = `Spec at index ${i} missing required field: title`;
   246→        warn(errMsg);
   247→        result.errors.push({ message: errMsg, spec });
   248→        continue;
   249→      }
   250→
   251→      const specSlug = spec.slug || generateSlug(spec.title);
   252→      const specRef = `@${specSlug}`;
   253→
   254→      // Check against slugs reserved during this import (plan slug, earlier specs)
   255→      if (importReservedSlugs.has(specSlug)) {
   256→        warn(`Spec slug "${specSlug}" collides with another item in this import, skipping`);
   257→        result.skipped.push({ slug: specSlug, reason: "Slug collision within import" });
   258→        continue;
   259→      }
   260→
   261→      // Check if spec already exists in pre-import state
   262→      const exists = refIndex.resolve(specRef);
   263→
   264→      if (exists.ok && !options.update) {
   265→        // AC: @plan-import ac-14, ac-25 - Skip existing specs
   266→        warn(`Skipping existing spec: ${specRef}`);
   267→        result.skipped.push({ slug: specSlug, reason: "Already exists" });
   268→        continue;
   269→      }
   270→
   271→      if (exists.ok && options.update) {
   272→        // AC: @plan-import ac-26 - Update existing spec
   273→        // Updates: description, type, tags, traits, and acceptance_criteria
   274→        const existingSpec = exists.item as LoadedSpecItem;
   275→
   276→        if (options.dryRun) {
   277→          info(`Would update spec: ${specRef}`);
   278→          result.updatedSpecs.push(specRef);
   279→        } else {
   280→          // Build updates from plan spec
   281→          const updates: Partial<SpecItemInput> = {};
   282→
   283→          if (spec.description !== undefined) {
   284→            updates.description = spec.description;
   285→          }
   286→          if (spec.type !== undefined) {
   287→            updates.type = spec.type as SpecItemInput["type"];
   288→          }
   289→          if (spec.traits !== undefined) {
   290→            updates.traits = spec.traits.map(normalizeRefInput);
   291→          }
   292→          if (spec.depends_on !== undefined) {
   293→            updates.depends_on = spec.depends_on.map(normalizeRefInput);
   294→          }
   295→          if (spec.acceptance_criteria !== undefined) {
   296→            updates.acceptance_criteria = spec.acceptance_criteria;
   297→          }
   298→
   299→          await updateSpecItem(ctx, existingSpec, updates);
   300→          info(`Updated spec: ${specRef}`);
   301→          result.updatedSpecs.push(specRef);
   302→        }
   303→        continue;
   304→      }
   305→
   306→      // Resolve parent reference
   307→      // AC: @plan-import ac-16, ac-17
   308→      let parent: LoadedSpecItem | null = null;
   309→      if (spec.parent) {
   310→        const parentRef = normalizeRefInput(spec.parent);
   311→
   312→        // Check if parent was just created in this import
   313→        const parentSlug = parentRef.slice(1);
   314→        if (createdSpecsMap.has(parentSlug)) {
   315→          parent = createdSpecsMap.get(parentSlug)!;
   316→        } else {
   317→          // Check existing specs
   318→          const parentResult = refIndex.resolve(parentRef);
   319→
   320→          if (!parentResult.ok) {
   321→            // AC: @plan-import ac-17, ac-33 - Missing parent with hint
   322→            const errMsg = `Parent ${parentRef} not found. Check parent exists or define it earlier in plan`;
   323→            warn(errMsg);
   324→            result.errors.push({ message: errMsg, spec });
   325→            result.skipped.push({ slug: specSlug, reason: "Missing parent" });
   326→            continue;
   327→          }
   328→
   329→          parent = parentResult.item as LoadedSpecItem;
   330→        }
   331→      }
   332→
   333→      // Determine if this is a root-level trait (type: trait with no parent)
   334→      const isRootTrait = (spec.type === "trait") && !parent;
   335→
   336→      if (options.dryRun) {
   337→        // AC: @plan-import ac-15 - Dry run mode
   338→        info(
   339→          `Would create spec: ${specRef} ${spec.parent ? `under ${spec.parent}` : isRootTrait ? "(project-level trait)" : "(root)"}`,
   340→        );
   341→        result.createdSpecs.push(specRef);
   342→        importReservedSlugs.add(specSlug);
   343→
   344→        // Track would-be created spec for parent resolution in dry-run
   345→        // AC: @plan-import ac-35 - Map depends_on in dry-run too
   346→        const dryRunSpec = createSpecItem({
   347→          title: spec.title,
   348→          type: (spec.type as any) || "feature",
   349→          slugs: [specSlug],
   350→          description: spec.description,
   351→          ...(spec.acceptance_criteria ? { acceptance_criteria: spec.acceptance_criteria } : {}),
   352→          priority: undefined,
   353→          tags: [],
   354→          depends_on: (spec.depends_on || []).map(normalizeRefInput),
   355→          implements: [],
   356→          relates_to: [],
   357→          tests: [],
   358→          traits: (spec.traits || []).map(normalizeRefInput),
   359→          notes: [],
   360→        }) as LoadedSpecItem;
   361→        createdSpecsMap.set(specSlug, dryRunSpec);
   362→      } else {
   363→        // Create spec item
   364→        // AC: @plan-import ac-35 - Map depends_on to spec depends_on
   365→        const specInput: SpecItemInput = {
   366→          title: spec.title,
   367→          type: (spec.type as any) || "feature",
   368→          slugs: [specSlug],
   369→          description: spec.description,
   370→          priority: undefined,
   371→          tags: [],
   372→          depends_on: (spec.depends_on || []).map(normalizeRefInput),
   373→          implements: [],
   374→          relates_to: [],
   375→          tests: [],
   376→          traits: (spec.traits || []).map(normalizeRefInput),
   377→          notes: [],
   378→        };
   379→
   380→        // Add acceptance criteria if present
   381→        if (spec.acceptance_criteria) {
   382→          specInput.acceptance_criteria = spec.acceptance_criteria;
   383→        }
   384→
   385→        const newSpec = createSpecItem(specInput);
   386→
   387→        if (isRootTrait) {
   388→          // Traits without a parent go to kynetic.yaml project-level traits array,
   389→          // not the module-level traits array (same logic as `kspec trait add`)
   390→          if (!ctx.manifestPath) {
   391→            throw new Error("Could not find kynetic.yaml");
   392→          }
   393→
   394→          const { readYamlFile, writeYamlFilePreserveFormat } = await import(
   395→            "../../parser/yaml.js"
   396→          );
   397→          const manifest = await readYamlFile<Record<string, unknown>>(
   398→            ctx.manifestPath,
   399→          );
   400→
   401→          if (!manifest) {
   402→            throw new Error("Could not load kynetic.yaml");
   403→          }
   404→
   405→          // Ensure traits array exists at root
   406→          if (!Array.isArray(manifest.traits)) {
   407→            manifest.traits = [];
   408→          }
   409→
   410→          // Strip metadata from newSpec (_sourceFile, _path)
   411→          const { _sourceFile, _path, ...cleanItem } = newSpec as LoadedSpecItem;
   412→          (manifest.traits as unknown[]).push(cleanItem);
   413→          await writeYamlFilePreserveFormat(ctx.manifestPath, manifest);
   414→
   415→          const traitIndex = (manifest.traits as unknown[]).length - 1;
   416→          const createdSpec: LoadedSpecItem = {
   417→            ...newSpec,
   418→            _sourceFile: ctx.manifestPath,
   419→            _path: `traits[${traitIndex}]`,
   420→          } as LoadedSpecItem;
   421→          createdSpecsMap.set(specSlug, createdSpec);
   422→        } else {
   423→          // Add spec to parent (or module if no parent)
   424→          const actualParent = parent || moduleItem;
   425→          const addResult = await addChildItem(ctx, actualParent, newSpec);
   426→
   427→          // Track the created spec for parent resolution
   428→          // Need to construct LoadedSpecItem with _sourceFile and _path for nested specs
   429→          const createdSpec: LoadedSpecItem = {
   430→            ...(addResult.item as LoadedSpecItem),
   431→            _sourceFile: actualParent._sourceFile,
   432→            _path: addResult.path,
   433→          };
   434→          createdSpecsMap.set(specSlug, createdSpec);
   435→        }
   436→
   437→        result.createdSpecs.push(specRef);
   438→        importReservedSlugs.add(specSlug);
   439→        newPlan.derived_specs.push(specRef);
   440→
   441→        info(`Created spec: ${specRef}`);
   442→      }
   443→    } catch (err) {
   444→      const errMsg = `Failed to create spec "${spec.title}": ${err instanceof Error ? err.message : String(err)}`;
   445→      warn(errMsg);
   446→      result.errors.push({ message: errMsg, spec });
   447→    }
   448→  }
   449→
   450→  // Derive tasks from specs
   451→  // AC: @plan-import ac-12, ac-13, ac-19, ac-20, ac-35
   452→  if (parsed.tasks.derive_from_specs && result.createdSpecs.length > 0) {
   453→    const tasks = await loadAllTasks(ctx);
   454→    // Combine existing task slugs + all slugs reserved during this import (plan + specs)
   455→    const importSlugs = new Set([
   456→      ...tasks.flatMap((t) => t.slugs),
   457→      ...importReservedSlugs,
   458→    ]);
   459→
   460→    // AC: @plan-import ac-35 - Build spec→task slug mapping for depends_on resolution
   461→    // First pass: generate all task slugs so we can resolve spec depends_on → task depends_on
   462→    const specToTaskSlug = new Map<string, string>();
   463→    for (const specRef of result.createdSpecs) {
   464→      const specSlug = specRef.slice(1);
   465→      const spec = createdSpecsMap.get(specSlug);
   466→      if (!spec) continue;
   467→
   468→      const taskTitle = `Implement ${spec.title}`;
   469→      const taskSlug = generateSlug(taskTitle);
   470→
   471→      let uniqueSlug = taskSlug;
   472→      let counter = 1;
   473→      while (importSlugs.has(uniqueSlug) || !refIndex.isSlugAvailable(uniqueSlug)) {
   474→        uniqueSlug = `${taskSlug}-${counter}`;
   475→        counter++;
   476→      }
   477→      importSlugs.add(uniqueSlug);
   478→      importReservedSlugs.add(uniqueSlug);
   479→      specToTaskSlug.set(specSlug, uniqueSlug);
   480→    }
   481→
   482→    for (const specRef of result.createdSpecs) {
   483→      // Get spec from createdSpecsMap (works in both dry-run and real mode)
   484→      const specSlug = specRef.slice(1);
   485→      const spec = createdSpecsMap.get(specSlug);
   486→      if (!spec) continue;
   487→
   488→      const uniqueSlug = specToTaskSlug.get(specSlug)!;
   489→
   490→      if (options.dryRun) {
   491→        info(`Would derive task: @${uniqueSlug} from ${specRef}`);
   492→        result.createdTasks.push(`@${uniqueSlug}`);
   493→      } else {
   494→        // AC: @plan-import ac-35 - Resolve spec depends_on to task depends_on
   495→        const planSpec = parsed.specs.find(s =>
   496→          (s.slug || generateSlug(s.title)) === specSlug
   497→        );
   498→        const taskDependsOn: string[] = [];
   499→        if (planSpec?.depends_on) {
   500→          for (const depRef of planSpec.depends_on) {
   501→            const depSlug = depRef.startsWith("@") ? depRef.slice(1) : depRef;
   502→            const depTaskSlug = specToTaskSlug.get(depSlug);
   503→            if (depTaskSlug) {
   504→              // Dependency spec was in this import — link to its derived task
   505→              taskDependsOn.push(`@${depTaskSlug}`);
   506→            } else {
   507→              // Dependency spec already existed — find an existing task with that spec_ref
   508→              const normalizedDepRef = normalizeRefInput(depRef);
   509→              const existingTask = tasks.find(t => t.spec_ref === normalizedDepRef);
   510→              if (existingTask && existingTask.slugs.length > 0) {
   511→                taskDependsOn.push(`@${existingTask.slugs[0]}`);
   512→              } else {
   513→                // No task found for this spec — pass the spec ref as-is
   514→                taskDependsOn.push(normalizedDepRef);
   515→              }
   516→            }
   517→          }
   518→        }
   519→
   520→        // AC: @plan-import ac-19 - Task has both spec_ref and plan_ref
   521→        const taskInput: TaskInput = {
   522→          title: `Implement ${spec.title}`,
   523→          type: "task",
   524→          spec_ref: specRef,
   525→          plan_ref: planRef,
   526→          priority: 3,
   527→          slugs: [uniqueSlug],
   528→          tags: [],
   529→          depends_on: taskDependsOn,
   530→          notes: [],
   531→        };
   532→
   533→        const newTask = createTask(taskInput);
   534→
   535→        // AC: @plan-import ac-13 - Scoped implementation notes
   536→        if (planSpec?.implementation_notes) {
   537→          // Per-spec notes go directly to this task
   538→          newTask.notes.push({
   539→            _ulid: ulid(),
   540→            created_at: new Date().toISOString(),
   541→            author,
   542→            content: `Implementation notes:\n\n${planSpec.implementation_notes}`,
   543→          });
   544→        } else if (parsed.implementationNotes) {
   545→          // No per-spec notes — reference the plan
   546→          newTask.notes.push({
   547→            _ulid: ulid(),
   548→            created_at: new Date().toISOString(),
   549→            author,
   550→            content: `See plan ${planRef} for implementation notes`,
   551→          });
   552→        }
   553→
   554→        await saveTask(ctx, newTask);
   555→        result.createdTasks.push(`@${uniqueSlug}`);
   556→        newPlan.derived_tasks.push(`@${uniqueSlug}`);
   557→
   558→        info(`Derived task: @${uniqueSlug}`);
   559→      }
   560→    }
   561→  }
   562→
   563→  // Create manual tasks
   564→  // AC: @plan-import ac-27
   565→  if (parsed.tasks.additional_tasks) {
   566→    // Reload tasks to catch any created by derive loop above
   567→    // Combine with all slugs reserved during this import (plan + specs)
   568→    const manualTasks = await loadAllTasks(ctx);
   569→    const manualImportSlugs = new Set([
   570→      ...manualTasks.flatMap((t) => t.slugs),
   571→      ...importReservedSlugs,
   572→    ]);
   573→
   574→    for (const taskDef of parsed.tasks.additional_tasks) {
   575→      const taskSlug = taskDef.slug || generateSlug(taskDef.title);
   576→
   577→      // Ensure slug uniqueness across all namespaces + this import's slugs
   578→      let uniqueSlug = taskSlug;
   579→      let counter = 1;
   580→      while (manualImportSlugs.has(uniqueSlug) || !refIndex.isSlugAvailable(uniqueSlug)) {
   581→        uniqueSlug = `${taskSlug}-${counter}`;
   582→        counter++;
   583→      }
   584→      manualImportSlugs.add(uniqueSlug);
   585→
   586→      if (options.dryRun) {
   587→        info(`Would create manual task: @${uniqueSlug}`);
   588→        result.createdTasks.push(`@${uniqueSlug}`);
   589→      } else {
   590→        // AC: @plan-import ac-27, ac-35 - Manual tasks have plan_ref; spec_ref and depends_on honored
   591→        const taskInput: TaskInput = {
   592→          title: taskDef.title,
   593→          type: "task",
   594→          plan_ref: planRef,
   595→          priority: taskDef.priority || 3,
   596→          slugs: [uniqueSlug],
   597→          tags: taskDef.tags || [],
   598→          depends_on: (taskDef.depends_on || []).map(normalizeRefInput),
   599→          notes: [],
   600→          ...(taskDef.spec_ref ? { spec_ref: normalizeRefInput(taskDef.spec_ref) } : {}),
   601→        };
   602→
   603→        if (taskDef.description) {
   604→          taskInput.notes = [
   605→            {
   606→              _ulid: ulid(),
   607→              created_at: new Date().toISOString(),
   608→              author,
   609→              content: taskDef.description,
   610→            },
   611→          ];
   612→        }
   613→
   614→        const newTask = createTask(taskInput);
   615→        await saveTask(ctx, newTask);
   616→        result.createdTasks.push(`@${uniqueSlug}`);
   617→        newPlan.derived_tasks.push(`@${uniqueSlug}`);
   618→
   619→        info(`Created manual task: @${uniqueSlug}`);
   620→      }
   621→    }
   622→  }
   623→
   624→  // Save plan record
   625→  // AC: @plan-import ac-24
   626→  if (!options.dryRun) {
   627→    await savePlan(ctx, newPlan);
   628→    await commitIfShadow(ctx.shadow, "plan-import", planSlug, parsed.title);
   629→  }
   630→
   631→  // AC: @plan-import ac-23, ac-29 - Summary output
   632→  const successCount =
   633→    result.createdSpecs.length +
   634→    result.updatedSpecs.length +
   635→    result.createdTasks.length;
   636→  const errorCount = result.errors.length + result.skipped.length;
   637→
   638→  // AC: @plan-import ac-32 - JSON output
   639→  if (isJsonMode()) {
   640→    output({
   641→      plan: planRef,
   642→      created_specs: result.createdSpecs,
   643→      updated_specs: result.updatedSpecs,
   644→      created_tasks: result.createdTasks,
   645→      errors: result.errors,
   646→      skipped: result.skipped,
   647→    });
   648→  } else {
   649→    // Human-readable output
   650→    if (options.dryRun) {
   651→      console.log("\nDry run - no changes made\n");
   652→    }
   653→
   654→    console.log(`Plan: ${planRef}`);
   655→    console.log(`Created ${result.createdSpecs.length} specs`);
   656→    if (result.updatedSpecs.length > 0) {
   657→      console.log(`Updated ${result.updatedSpecs.length} specs`);
   658→    }
   659→    console.log(`Created ${result.createdTasks.length} tasks`);
   660→
   661→    if (result.errors.length > 0) {
   662→      console.log(`\nErrors (${result.errors.length}):`);
   663→      for (const err of result.errors) {
   664→        console.log(`  - ${err.message}`);
   665→      }
   666→    }
   667→
   668→    if (result.skipped.length > 0) {
   669→      console.log(`\nSkipped (${result.skipped.length}):`);
   670→      for (const skip of result.skipped) {
   671→        console.log(`  - @${skip.slug}: ${skip.reason}`);
   672→      }
   673→    }
   674→
   675→    // AC: @plan-import ac-15, ac-23 - Exit code 0 on success
   676→    if (!options.dryRun && successCount > 0) {
   677→      success(
   678→        `\nImported plan: ${successCount} items created, ${errorCount} errors`,
   679→      );
   680→    }
   681→  }  // end of else block (non-JSON output)
   682→
   683→  // Exit code logic
   684→  // AC: @plan-import ac-15 - Dry run exits 0
   685→  // AC: @plan-import ac-23 - Success with some errors still exits 0
   686→  process.exit(EXIT_CODES.SUCCESS);
   687→}
   688→
   689→/**
   690→ * Generate URL-safe slug from title
   691→ */
   692→function generateSlug(title: string): string {
   693→  return title
   694→    .toLowerCase()
   695→    .replace(/[^a-z0-9]+/g, "-")
   696→    .replace(/^-|-$/g, "")
   697→    .slice(0, 50);
   698→}
   699→