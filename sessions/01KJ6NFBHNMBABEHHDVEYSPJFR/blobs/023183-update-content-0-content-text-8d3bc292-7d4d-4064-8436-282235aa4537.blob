    70→
    71→// ─── Task Limit Marker ──────────────────────────────────────────────────────
    72→
    73→/**
    74→ * Marker file schema for task limit enforcement.
    75→ * AC: @ralph-task-limit ac-marker-format
    76→ */
    77→interface TaskLimitMarker {
    78→  active: boolean;
    79→  since: string; // ISO8601
    80→  max: number;
    81→  completed: number;
    82→  sessionId: string;
    83→}
    84→
    85→const TASK_LIMIT_MARKER_PATH = ".claude/ralph-task-limit.json";
    86→const END_LOOP_MARKER_PATH = ".claude/ralph-end-loop.json";
    87→const STALE_MARKER_THRESHOLD_MS = 60 * 60 * 1000; // 1 hour
    88→
    89→// ─── End Loop Marker ────────────────────────────────────────────────────────
    90→
    91→/**
    92→ * Marker file schema for explicit end-loop signaling.
    93→ * AC: @ralph-end-loop ac-cmd
    94→ */
    95→interface EndLoopMarker {
    96→  requested: boolean;
    97→  timestamp: string; // ISO8601
    98→  reason?: string;
    99→}
   100→
   101→/**
   102→ * Write task limit marker file.
   103→ * AC: @ralph-task-limit ac-wrapup, ac-marker-format
   104→ */
   105→async function writeTaskLimitMarker(
   106→  rootDir: string,
   107→  marker: TaskLimitMarker,
   108→): Promise<void> {
   109→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   110→  const dir = path.dirname(markerPath);
   111→  await fs.mkdir(dir, { recursive: true });
   112→  await fs.writeFile(markerPath, JSON.stringify(marker, null, 2));
   113→}
   114→
   115→/**
   116→ * Read task limit marker file if it exists.
   117→ */
   118→async function readTaskLimitMarker(
   119→  rootDir: string,
   120→): Promise<TaskLimitMarker | null> {
   121→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   122→  try {
   123→    const content = await fs.readFile(markerPath, "utf-8");
   124→    return JSON.parse(content) as TaskLimitMarker;
   125→  } catch {
   126→    return null;
   127→  }
   128→}
   129→
   130→/**
   131→ * Clear task limit marker file.
   132→ * AC: @ralph-task-limit ac-reset
   133→ */
   134→async function clearTaskLimitMarker(rootDir: string): Promise<void> {
   135→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   136→  try {
   137→    await fs.unlink(markerPath);
   138→  } catch {
   139→    // Ignore if file doesn't exist
   140→  }
   141→}
   142→
   143→/**
   144→ * Clear stale marker files (older than 1 hour).
   145→ * AC: @ralph-task-limit ac-reset
   146→ */
   147→async function clearStaleMarker(rootDir: string): Promise<boolean> {
   148→  const marker = await readTaskLimitMarker(rootDir);
   149→  if (!marker) return false;
   150→
   151→  const markerAge = Date.now() - new Date(marker.since).getTime();
   152→  if (markerAge > STALE_MARKER_THRESHOLD_MS) {
   153→    await clearTaskLimitMarker(rootDir);
   154→    return true;
   155→  }
   156→  return false;
   157→}
   158→
   159→/**
   160→ * Write end-loop marker file.
   161→ * AC: @ralph-end-loop ac-cmd
   162→ */
   163→async function writeEndLoopMarker(
   164→  rootDir: string,
   165→  reason?: string,
   166→): Promise<void> {
   167→  const markerPath = path.join(rootDir, END_LOOP_MARKER_PATH);
   168→  const dir = path.dirname(markerPath);
   169→  await fs.mkdir(dir, { recursive: true });
   170→  const marker: EndLoopMarker = {
   171→    requested: true,
   172→    timestamp: new Date().toISOString(),
   173→    reason,
   174→  };
   175→  await fs.writeFile(markerPath, JSON.stringify(marker, null, 2));
   176→}
   177→
   178→/**
   179→ * Read end-loop marker file if it exists.
   180→ * AC: @ralph-end-loop ac-detect
   181→ */
   182→async function readEndLoopMarker(
   183→  rootDir: string,
   184→): Promise<EndLoopMarker | null> {
   185→  const markerPath = path.join(rootDir, END_LOOP_MARKER_PATH);
   186→  try {
   187→    const content = await fs.readFile(markerPath, "utf-8");
   188→    return JSON.parse(content) as EndLoopMarker;
   189→  } catch {
   190→    return null;
   191→  }
   192→}
   193→
   194→/**
   195→ * Clear end-loop marker file.
   196→ * AC: @ralph-end-loop ac-cleanup
   197→ */
   198→async function clearEndLoopMarker(rootDir: string): Promise<void> {
   199→  const markerPath = path.join(rootDir, END_LOOP_MARKER_PATH);
   200→  try {
   201→    await fs.unlink(markerPath);
   202→  } catch {
   203→    // Ignore if file doesn't exist
   204→  }
   205→}
   206→
   207→/**
   208→ * Clear stale end-loop markers (older than 1 hour).
   209→ * AC: @ralph-end-loop ac-cleanup
   210→ */
   211→async function clearStaleEndLoopMarker(rootDir: string): Promise<boolean> {
   212→  const marker = await readEndLoopMarker(rootDir);
   213→  if (!marker) return false;
   214→
   215→  const markerAge = Date.now() - new Date(marker.timestamp).getTime();
   216→  if (markerAge > STALE_MARKER_THRESHOLD_MS) {
   217→    await clearEndLoopMarker(rootDir);
   218→    return true;
   219→  }
   220→  return false;
   221→}
   222→
   223→/**
   224→ * Detect if a Bash command is a task complete or submit command.
   225→ * AC: @ralph-task-limit ac-detection
   226→ */
   227→export function detectTaskCompleteCommand(command: string): boolean {
   228→  // Match "kspec task complete" and "kspec task submit"
   229→  // Submit means agent's work is done (pending_review) — counts toward limit
   230→  return /\bkspec\s+task\s+(?:complete|submit)\b/.test(command);
   231→}
   232→
   233→/**
   234→ * Detect if a Bash command is an end-loop command.
   235→ * AC: @ralph-end-loop ac-detect
   236→ */
   237→function detectEndLoopCommand(command: string): boolean {
   238→  // Match "kspec ralph end-loop" with any arguments
   239→  return /\bkspec\s+ralph\s+end-loop\b/.test(command);
   240→}
   241→
   242→/**
   243→ * Extract Bash command from SessionUpdate if it's a tool_call or tool_call_update event.
   244→ * Returns null if not a Bash tool call.
   245→ */
   246→function extractBashCommand(update: SessionUpdate): string | null {
   247→  const u = update as Record<string, unknown>;
   248→
   249→  // Check if this is a tool call event
   250→  if (u.sessionUpdate !== "tool_call" && u.sessionUpdate !== "tool_call_update") {
   251→    return null;
   252→  }
   253→
   254→  // Extract tool name - check various locations Claude Code uses
   255→  let toolName: string | undefined;
   256→
   257→  // Try _meta.claudeCode.toolName first (Claude Code pattern)
   258→  const meta = u._meta as Record<string, unknown> | undefined;
   259→  if (meta) {
   260→    const claudeCode = meta.claudeCode as Record<string, unknown> | undefined;
   261→    if (claudeCode?.toolName) {
   262→      toolName = String(claudeCode.toolName);
   263→    } else if (meta.toolName) {
   264→      toolName = String(meta.toolName);
   265→    }
   266→  }
   267→
   268→  // Fall back to name or title field
   269→  if (!toolName && u.name) {
   270→    toolName = String(u.name);
   271→  }
   272→  if (!toolName && u.title) {
   273→    toolName = String(u.title);
   274→  }
   275→
   276→  // Check if it's a Bash tool (handle MCP prefix variations)
   277→  if (!toolName) return null;
   278→  const isBash = toolName === "Bash" || toolName.endsWith("__Bash");
   279→  if (!isBash) return null;
   280→
   281→  // Extract command from input
   282→  const input = (u.rawInput || u.input || u.params) as Record<string, unknown> | undefined;
   283→  if (!input) return null;
   284→
   285→  const command = input.command;
   286→  if (typeof command !== "string") return null;
   287→
   288→  return command;
   289→}
   290→
   291→// ─── Explicit Task Scope ─────────────────────────────────────────────────────
   292→
   293→/**
   294→ * Parsed explicit task scope for --tasks flag.
   295→ * AC: @cli-ralph ac-21
   296→ */
   297→interface ExplicitTaskScope {
   298→  /** Original refs as provided by user */
   299→  refs: string[];
   300→  /** Resolved ULIDs for the tasks */
   301→  ulids: string[];
   302→}
   303→
   304→/**
   305→ * Parse and validate --tasks flag value.
   306→ * Returns resolved ULIDs for the specified task refs.
   307→ * AC: @cli-ralph ac-21
   308→ *
   309→ * @throws Error if any ref cannot be resolved or is not a task
   310→ */
   311→async function parseExplicitTasks(
   312→  ctx: KspecContext,
   313→  tasksArg: string,
   314→): Promise<ExplicitTaskScope> {
   315→  const refs = tasksArg.split(",").map((r) => r.trim()).filter(Boolean);
   316→
   317→  if (refs.length === 0) {
   318→    throw new Error("--tasks requires at least one task reference");
   319→  }
   320→
   321→  // Load tasks and items for resolution
   322→  const tasks = await loadAllTasks(ctx);
   323→  const items = await loadAllItems(ctx);
   324→  const index = new ReferenceIndex(tasks, items);
   325→
   326→  const ulids: string[] = [];
   327→
   328→  for (const ref of refs) {
   329→    const result = index.resolve(ref);
   330→    if (!result.ok) {
   331→      throw new Error(`Cannot resolve task reference: ${ref}`);
   332→    }
   333→
   334→    // Verify it's a task (not a spec item)
   335→    const task = tasks.find((t) => t._ulid === result.ulid);
   336→    if (!task) {
   337→      throw new Error(`Reference ${ref} is not a task`);
   338→    }
   339→
   340→    ulids.push(result.ulid);
   341→  }
   342→
   343→  return { refs, ulids };
   344→}
   345→
   346→/**
   347→ * Filter session context to only include tasks from explicit scope.
   348→ * AC: @cli-ralph ac-21
   349→ */
   350→function filterByExplicitTasks(
   351→  ctx: SessionContext,
   352→  scope: ExplicitTaskScope,
   353→): SessionContext {
   354→  // Task refs in context are short ULIDs (variable length from shortUlid())
   355→  // Check if the context ref is a prefix of any explicit ULID
   356→  const matchesScope = (taskRef: string) => {
   357→    return scope.ulids.some((ulid) => ulid.startsWith(taskRef));
   358→  };
   359→
   360→  return {
   361→    ...ctx,
   362→    active_tasks: ctx.active_tasks.filter((t) => matchesScope(t.ref)),
   363→    pending_review_tasks: ctx.pending_review_tasks.filter((t) => matchesScope(t.ref)),
   364→    ready_tasks: ctx.ready_tasks.filter((t) => matchesScope(t.ref)),
   365→  };
   366→}
   367→
   368→/**
   369→ * Check if all explicit tasks are completed or blocked.
   370→ * AC: @cli-ralph ac-21
   371→ */
   372→async function allExplicitTasksDone(
   373→  ctx: KspecContext,
   374→  scope: ExplicitTaskScope,
   375→): Promise<{ done: boolean; statuses: Map<string, string> }> {
   376→  const tasks = await loadAllTasks(ctx);
   377→  const statuses = new Map<string, string>();
   378→
   379→  for (const ulid of scope.ulids) {
   380→    const task = tasks.find((t) => t._ulid === ulid);
   381→    if (task) {
   382→      statuses.set(ulid.slice(0, 8), task.status);
   383→    }
   384→  }
   385→
   386→  // Check if all are completed or blocked
   387→  const done = scope.ulids.every((ulid) => {
   388→    const status = statuses.get(ulid.slice(0, 8));
   389→    return status === "completed" || status === "blocked";
   390→  });
   391→
   392→  return { done, statuses };
   393→}
   394→
   395→// ─── Prompt Template ─────────────────────────────────────────────────────────
   396→
   397→// AC: @ralph-skill-delegation ac-1, ac-2, ac-3
   398→function buildTaskWorkPrompt(
   399→  sessionCtx: SessionContext,
   400→  iteration: number,
   401→  maxLoops: number,
   402→  sessionId: string,
   403→  skillTaskWork: string,
   404→  focus?: string,
   405→  explicitTaskScope?: ExplicitTaskScope,
   406→): string {
   407→  const focusSection = focus
   408→    ? `
   409→## Session Focus (applies to ALL iterations)
   410→
   411→> **${focus}**
   412→
   413→Keep this focus in mind throughout your work. It takes priority over default task selection.
   414→`
   415→    : "";
   416→
   417→  // AC: @cli-ralph ac-21 - Explicit task scope indicator in prompt
   418→  const taskScopeSection = explicitTaskScope
   419→    ? `
   420→## Explicit Task Scope
   421→
   422→This session is scoped to specific tasks: ${explicitTaskScope.refs.join(", ")}
   423→
   424→**Only work on these tasks.** The loop will exit when all listed tasks are completed or blocked.
   425→`
   426→    : "";
   427→
   428→  const modeDescription = explicitTaskScope
   429→    ? "Loop mode means: no confirmations, auto-resolve decisions, explicit task scope (only the listed tasks)."
   430→    : "Loop mode means: no confirmations, auto-resolve decisions, automation-eligible tasks only.";
   431→
   432→  return `# Kspec Automation Session - Task Work
   433→
   434→**Session ID:** \`${sessionId}\`
   435→**Iteration:** ${iteration} of ${maxLoops}
   436→**Mode:** Automated (no human in the loop)
   437→${focusSection}${taskScopeSection}
   438→
   439→## Current State
   440→\`\`\`json
   441→${JSON.stringify(sessionCtx, null, 2)}
   442→\`\`\`
   443→
   444→## Instructions
   445→
   446→Run the task-work skill in loop mode:
   447→
   448→\`\`\`
   449→${skillTaskWork} loop
   450→\`\`\`
   451→
   452→${modeDescription}
   453→
   454→**Normal flow:** Work on a task, create a PR, then stop responding. Ralph continues automatically —
   455→it checks for remaining eligible tasks at the start of each iteration and exits the loop itself when none remain.
   456→
   457→**Do NOT call \`end-loop\` after completing a task.** Simply stop responding.
   458→\`end-loop\` is a rare escape hatch for when work is stalling across multiple iterations with no progress — not a normal exit path.
   459→`;
   460→}
   461→
   462→/**
   463→ * Build the reflect prompt sent after task-work completes.
   464→ * Ralph sends this as a separate prompt to ensure reflection always happens.
   465→ */
   466→function buildReflectPrompt(
   467→  iteration: number,
   468→  maxLoops: number,
   469→  sessionId: string,
   470→  skillReflect: string,
   471→): string {
   472→  const isFinal = iteration === maxLoops;
   473→
   474→  return `# Kspec Automation Session - Reflection
   475→
   476→**Session ID:** \`${sessionId}\`
   477→**Iteration:** ${iteration} of ${maxLoops}
   478→**Phase:** Post-task reflection
   479→
   480→## Instructions
   481→
   482→Run the reflect skill in loop mode:
   483→
   484→\`\`\`
   485→${skillReflect} loop
   486→\`\`\`
   487→
   488→Loop mode means: high-confidence captures only, must search existing before capturing, no user prompts.
   489→${
   490→  isFinal
   491→    ? `
   492→**FINAL ITERATION** - This is the last chance to capture insights from this session.
   493→`
   494→    : ""
   495→}
   496→Exit when reflection is complete.
   497→`;
   498→}
   499→
   500→// ─── Streaming Output ────────────────────────────────────────────────────────
   501→
   502→// Translator and renderer are created per-session in the action handler.
   503→// This allows the architecture to be reused by future TUI renderers.
   504→
   505→// ─── Adapter Validation ──────────────────────────────────────────────────────
   506→
   507→// AC: @ralph-adapter-validation valid-adapter-proceeds, invalid-adapter-error, validation-before-spawn
   508→/**
   509→ * Validate that the specified ACP adapter package exists.
   510→ * Uses npx --no-install to check both global and local node_modules.
   511→ *
   512→ * @throws {Error} Never throws - exits process with code 3 if validation fails
   513→ */
   514→function validateAdapter(adapterPackage: string): void {
   515→  // Use npx --no-install with --version to check if package exists
   516→  // This checks both global and local node_modules, handles scoped packages
   517→  const result = spawnSync(
   518→    "npx",
   519→    ["--no-install", adapterPackage, "--version"],
   520→    {
   521→      encoding: "utf-8",
   522→      stdio: "pipe",
   523→    },
   524→  );
   525→
   526→  if (result.status !== 0) {
   527→    error(
   528→      `Adapter package not found: ${adapterPackage}. Install with: npm install -g ${adapterPackage}`,
   529→    );
   530→    process.exit(EXIT_CODES.NOT_FOUND);
   531→  }
   532→}
   533→
   534→// ─── Tool Request Handler ────────────────────────────────────────────────────
   535→
   536→/**
   537→ * Handle tool requests from ACP agent.
   538→ * Implements file operations, terminal commands, and permission handling.
   539→ */
   540→async function handleRequest(
   541→  client: ACPClient,
   542→  id: string | number,
   543→  method: string,
   544→  params: unknown,
   545→  yolo: boolean,
   546→): Promise<void> {
   547→  try {
   548→    switch (method) {
   549→      case "session/request_permission": {
   550→        const p = params as RequestPermissionRequest;
   551→        // In yolo mode, auto-approve all permissions
   552→        // In normal mode, would need to implement permission UI
   553→        const options = p.options || [];
   554→
   555→        if (yolo) {
   556→          // Find an "allow" option (prefer allow_always, then allow_once)
   557→          const allowOption =
   558→            options.find((o) => o.kind === "allow_always") ||
   559→            options.find((o) => o.kind === "allow_once");
   560→
   561→          if (allowOption) {
   562→            client.respondPermission(id, {
   563→              outcome: { outcome: "selected", optionId: allowOption.optionId },
   564→            });
   565→          } else {
   566→            // No allow option available - cancel
   567→            client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   568→          }
   569→        } else {
   570→          // TODO: Implement permission prompting
   571→          client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   572→        }
   573→        break;
   574→      }
   575→
   576→      case "file/read": {
   577→        const p = params as ReadTextFileRequest;
   578→        const content = await fs.readFile(p.path, "utf-8");
   579→        client.respondReadTextFile(id, { content });
   580→        break;
   581→      }
   582→
   583→      case "file/write": {
   584→        const p = params as WriteTextFileRequest;
   585→        await fs.mkdir(path.dirname(p.path), { recursive: true });
   586→        await fs.writeFile(p.path, p.content, "utf-8");
   587→        client.respondWriteTextFile(id, {});
   588→        break;
   589→      }
   590→
   591→      case "terminal/run": {
   592→        // Custom method (not part of ACP spec - ACP uses createTerminal instead)
   593→        // TODO: Consider migrating to standard ACP terminal methods
   594→        const p = params as {
   595→          command: string;
   596→          cwd?: string;
   597→          timeout?: number;
   598→        };
   599→        const command = p.command;
   600→        const cwd = p.cwd || process.cwd();
   601→        const timeout = p.timeout || 60000;
   602→
   603→        const result = await new Promise<{
   604→          stdout: string;
   605→          stderr: string;
   606→          exitCode: number;
   607→        }>((resolve) => {
   608→          const child = spawn(command, [], {
   609→            cwd,
   610→            shell: true,
   611→            timeout,
   612→          });
   613→
   614→          let stdout = "";
   615→          let stderr = "";
   616→
   617→          child.stdout?.on("data", (data) => {
   618→            stdout += data.toString();
   619→          });
   620→
   621→          child.stderr?.on("data", (data) => {
   622→            stderr += data.toString();
   623→          });
   624→
   625→          child.on("close", (code) => {
   626→            resolve({ stdout, stderr, exitCode: code ?? 1 });
   627→          });
   628→
   629→          child.on("error", (err) => {
   630→            resolve({ stdout, stderr: err.message, exitCode: 1 });
   631→          });
   632→        });
   633→
   634→        // Using generic respond() since this is a custom method
   635→        client.respond(id, result);
   636→        break;
   637→      }
   638→
   639→      default:
   640→        // Unknown method - return error
   641→        client.respondError(id, -32601, `Method not found: ${method}`);
   642→    }
   643→  } catch (err) {
   644→    const message = err instanceof Error ? err.message : String(err);
   645→    client.respondError(id, -32000, message);
   646→  }
   647→}
   648→
   649→// ─── Subagent Support ─────────────────────────────────────────────────────────
   650→
   651→/**
   652→ * Build context for a PR review subagent.
   653→ * AC: @ralph-subagent-spawning ac-10
   654→ */
   655→async function buildSubagentContext(
   656→  ctx: KspecContext,
   657→  taskRef: string,
   658→): Promise<SubagentContext> {
   659→  // Load all tasks and items
   660→  const tasks = await loadAllTasks(ctx);
   661→  const items = await loadAllItems(ctx);
   662→  const index = new ReferenceIndex(tasks, items);
   663→
   664→  // Resolve task reference
   665→  const taskResult = index.resolve(taskRef);
   666→  if (!taskResult.ok) {
   667→    throw new Error(`Task not found: ${taskRef}`);
   668→  }
   669→
   670→  const task = tasks.find((t) => t._ulid === taskResult.ulid);
   671→  if (!task) {
   672→    throw new Error(`Task not found by ULID: ${taskResult.ulid}`);
   673→  }
   674→
   675→  // Get linked spec with ACs if spec_ref exists
   676→  let specWithACs: Record<string, unknown> | null = null;
   677→  if (task.spec_ref) {
   678→    const specResult = index.resolve(task.spec_ref);
   679→    if (specResult.ok) {
   680→      const item = items.find((i) => i._ulid === specResult.ulid);
   681→      if (item) {
   682→        specWithACs = item as unknown as Record<string, unknown>;
   683→      }
   684→    }
   685→  }
   686→
   687→  // Get git branch
   688→  const gitBranch = getCurrentBranch(ctx.rootDir) || "unknown";
   689→
   690→  return {
   691→    taskRef,
   692→    taskDetails: task as unknown as Record<string, unknown>,
   693→    specWithACs,
   694→    gitBranch,
   695→  };
   696→}
   697→
   698→/**
   699→ * Get the current status of a task.
   700→ * AC: @ralph-subagent-spawning ac-12
   701→ */
   702→function getTaskStatus(taskRef: string): string | null {
   703→  const result = spawnSync("kspec", ["task", "get", taskRef, "--json"], {
   704→    encoding: "utf-8",
   705→    stdio: "pipe",
   706→  });
   707→
   708→  if (result.status !== 0) {
   709→    warn(`Failed to check task status for ${taskRef}: ${result.stderr}`);
   710→    return null;
   711→  }
   712→
   713→  try {
   714→    return JSON.parse(result.stdout).status;
   715→  } catch {
   716→    warn(`Failed to parse task status for ${taskRef}`);
   717→    return null;
   718→  }
   719→}
   720→
   721→/**
   722→ * Mark a task as needing review due to subagent timeout.
   723→ * AC: @ralph-subagent-spawning ac-9
   724→ */
   725→async function markTaskNeedsReview(
   726→  taskRef: string,
   727→  reason: string,
   728→): Promise<void> {
   729→  const { spawnSync } = await import("node:child_process");
   730→
   731→  // Use kspec CLI to set automation status
   732→  const result = spawnSync(
   733→    "kspec",
   734→    ["task", "set-automation", taskRef, "needs_review"],
   735→    {
   736→      encoding: "utf-8",
   737→      stdio: "pipe",
   738→    },
   739→  );
   740→
   741→  if (result.status !== 0) {
   742→    warn(`Failed to mark task ${taskRef} as needs_review: ${result.stderr}`);
   743→  }
   744→
   745→  // Add a note explaining the timeout
   746→  const noteResult = spawnSync(
   747→    "kspec",
   748→    ["task", "note", taskRef, `[RALPH SUBAGENT] ${reason}`],
   749→    {
   750→      encoding: "utf-8",
   751→      stdio: "pipe",
   752→    },
   753→  );
   754→
   755→  if (noteResult.status !== 0) {
   756→    warn(`Failed to add timeout note to task ${taskRef}: ${noteResult.stderr}`);
   757→  }
   758→}
   759→
   760→/**
   761→ * Post a comment on the open PR for a task's branch, noting incomplete review.
   762→ * Uses `gh pr list --head <branch>` to find the PR and add a warning.
   763→ */
   764→async function commentOnPRReviewIncomplete(branch: string, reason: string): Promise<void> {
   765→  if (!branch || branch === "unknown") {
   766→    return;
   767→  }
   768→
   769→  const prListResult = spawnSync(
   770→    "gh",
   771→    ["pr", "list", "--state", "open", "--head", branch, "--json", "number", "--jq", ".[0].number"],
   772→    { encoding: "utf-8", stdio: "pipe" },
   773→  );
   774→
   775→  const prNumber = prListResult.stdout?.trim();
   776→  if (!prNumber || prListResult.status !== 0) {
   777→    // No open PR found — may already be merged or branch has no PR
   778→    return;
   779→  }
   780→
   781→  const body = `⚠️ **Review incomplete**: ${reason}\n\nThis PR was not fully reviewed by the ralph review subagent. Manual review recommended before merging.`;
   782→  const commentResult = spawnSync(
   783→    "gh",
   784→    ["pr", "comment", prNumber, "--body", body],
   785→    { encoding: "utf-8", stdio: "pipe" },
   786→  );
   787→
   788→  if (commentResult.status !== 0) {
   789→    warn(`Failed to comment on PR #${prNumber}: ${commentResult.stderr}`);
   790→  } else {
   791→    info(`${DEFAULT_SUBAGENT_PREFIX} Posted review-incomplete comment on PR #${prNumber}`);
   792→  }
   793→}
   794→
   795→/**
   796→ * Handle failed iteration by tracking per-task failures and escalating at threshold.
   797→ * AC: @loop-mode-error-handling ac-1, ac-2, ac-3, ac-4, ac-5, ac-8
   798→ */
   799→async function handleIterationFailure(
   800→  ctx: KspecContext,
   801→  tasksInProgressAtStart: ActiveTaskSummary[],
   802→  iterationStartTime: Date,
   803→  errorDescription: string,
   804→): Promise<void> {
   805→  if (tasksInProgressAtStart.length === 0) {
   806→    return;
   807→  }
   808→
   809→  // Re-load current tasks to check progress
   810→  const currentTasks = await loadAllTasks(ctx);
   811→  const index = new ReferenceIndex(currentTasks, await loadAllItems(ctx));
   812→
   813→  // Convert ActiveTaskSummary to Task-like objects for processing
   814→  const tasksInProgressFull = tasksInProgressAtStart
   815→    .map((summary) => {
   816→      const resolved = index.resolve(summary.ref);
   817→      if (!resolved.ok) return undefined;
   818→      // Check if the resolved item is a task (not a spec item or meta item)
   819→      const item = resolved.item;
   820→      if (!("status" in item)) return undefined; // Spec items don't have status
   821→      return currentTasks.find((t) => t._ulid === resolved.ulid);
   822→    })
   823→    .filter((t): t is LoadedTask => t !== undefined && t.status === "in_progress");
   824→
   825→  if (tasksInProgressFull.length === 0) {
   826→    return;
   827→  }
   828→
   829→  // Process failures
   830→  const { processFailedIteration, createFailureNote, getTaskFailureCount } = await import("../../ralph/index.js");
   831→
   832→  const results = processFailedIteration(
   833→    tasksInProgressFull,
   834→    currentTasks,
   835→    iterationStartTime,
   836→    errorDescription,
   837→  );
   838→
   839→  // Add notes and escalate tasks
   840→  for (const result of results) {
   841→    const taskRef = result.taskRef;
   842→    const task = currentTasks.find((t) => t._ulid === taskRef);
   843→    if (!task) continue;
   844→
   845→    const priorCount = result.failureCount - 1;
   846→    const noteContent = createFailureNote(taskRef, errorDescription, priorCount);
   847→
   848→    // Add LOOP-FAIL note
   849→    const noteResult = spawnSync(
   850→      "kspec",
   851→      ["task", "note", `@${taskRef}`, noteContent],
   852→      {
   853→        encoding: "utf-8",
   854→        stdio: "pipe",
   855→        cwd: process.cwd(),
   856→      },
   857→    );
   858→
   859→    if (noteResult.status !== 0) {
   860→      warn(`Failed to add failure note to task ${taskRef}: ${noteResult.stderr}`);
   861→      continue;
   862→    }
   863→
   864→    // AC: @loop-mode-error-handling ac-5 - Escalate at threshold
   865→    if (result.escalated) {
   866→      const escalateResult = spawnSync(
   867→        "kspec",
   868→        [
   869→          "task",
   870→          "set",
   871→          `@${taskRef}`,
   872→          "--automation",
   873→          "needs_review",
   874→          "--reason",
   875→          `Loop mode: 3 consecutive failures without progress`,
   876→        ],
   877→        {
   878→          encoding: "utf-8",
   879→          stdio: "pipe",
   880→          cwd: process.cwd(),
   881→        },
   882→      );
   883→
   884→      if (escalateResult.status !== 0) {
   885→        warn(`Failed to escalate task ${taskRef}: ${escalateResult.stderr}`);
   886→      } else {
   887→        info(`Escalated task ${taskRef} to automation:needs_review after 3 failures`);
   888→      }
   889→    }
   890→  }
   891→}
   892→
   893→/**
   894→ * Process pending_review tasks by spawning subagents.
   895→ * AC: @ralph-subagent-spawning ac-6, ac-8
   896→ */
   897→async function processPendingReviewTasks(
   898→  ctx: KspecContext,
   899→  adapter: AgentAdapter,
   900→  pendingReviewTasks: ActiveTaskSummary[],
   901→  options: {
   902→    yolo: boolean;
   903→    maxRetries: number;
   904→    maxFailures: number;
   905→    cwd: string;
   906→    subagentTimeout: number;
   907→  },
   908→  consecutiveFailures: { count: number },
   909→): Promise<boolean> {
   910→  if (pendingReviewTasks.length === 0) {
   911→    return true;
   912→  }
   913→
   914→  // Visual separator for subagent section
   915→  console.log("");
   916→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   917→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Processing Pending Review Tasks`));
   918→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   919→  console.log("");
   920→
   921→  info(
   922→    `${DEFAULT_SUBAGENT_PREFIX} Found ${pendingReviewTasks.length} pending_review task(s)`,
   923→  );
   924→
   925→  // AC: @ralph-subagent-spawning ac-6 - Process one at a time
   926→  for (const task of pendingReviewTasks) {
   927→    info(`${DEFAULT_SUBAGENT_PREFIX} Processing: ${task.ref} - ${task.title}`);
   928→
   929→    try {
   930→      // Build context for this task
   931→      const subagentCtx = await buildSubagentContext(ctx, task.ref);
   932→
   933→      // AC: @ralph-subagent-spawning ac-1, ac-3 - Spawn and wait
   934→      const result = await runSubagent(
   935→        adapter,
   936→        subagentCtx,
   937→        {
   938→          timeout: options.subagentTimeout,
   939→          outputPrefix: DEFAULT_SUBAGENT_PREFIX,
   940→          skillName: ctx.config.ralph.skills.pr_review,
   941→        },
   942→        {
   943→          yolo: options.yolo,
   944→          cwd: options.cwd,
   945→          handleRequest: (client, reqId, method, params) =>
   946→            handleRequest(client, reqId, method, params, options.yolo),
   947→        },
   948→      );
   949→
   950→      if (result.timedOut) {
   951→        // AC: @ralph-subagent-spawning ac-9
   952→        warn(
   953→          `${DEFAULT_SUBAGENT_PREFIX} Subagent timed out for ${task.ref}`,
   954→        );
   955→        const timeoutMinutes = Math.round(options.subagentTimeout / 60000);
   956→        await markTaskNeedsReview(
   957→          task.ref,
   958→          `Subagent timed out after ${timeoutMinutes} minutes`,
   959→        );
   960→        await commentOnPRReviewIncomplete(subagentCtx.gitBranch, `Review subagent timed out after ${timeoutMinutes} minutes for task ${task.ref}.`);
   961→        consecutiveFailures.count++;
   962→      } else if (!result.success) {
   963→        // AC: @ralph-subagent-spawning ac-7
   964→        error(
   965→          `${DEFAULT_SUBAGENT_PREFIX} Subagent failed for ${task.ref}: ${result.error}`,
   966→        );
   967→        await commentOnPRReviewIncomplete(subagentCtx.gitBranch, `Review subagent failed for task ${task.ref}: ${result.error}`);
   968→        consecutiveFailures.count++;
   969→      } else {
   970→        // AC: @ralph-subagent-spawning ac-12 - Verify task outcome
   971→        const currentStatus = getTaskStatus(task.ref);
   972→
   973→        if (currentStatus === "completed") {
   974→          success(`${DEFAULT_SUBAGENT_PREFIX} Completed: ${task.ref}`);
   975→          consecutiveFailures.count = 0;
   976→        } else if (currentStatus === "needs_work") {
   977→          // Expected: reviewer found issues, kicked back to worker
   978→          info(`${DEFAULT_SUBAGENT_PREFIX} Review completed for ${task.ref} — issues found, kicked back to worker`);
   979→          // NOT a failure — the review worked correctly
   980→          consecutiveFailures.count = 0;
   981→        } else if (currentStatus === "pending_review") {
   982→          // Subagent didn't transition or merge — count as soft failure
   983→          warn(
   984→            `${DEFAULT_SUBAGENT_PREFIX} Subagent completed but task ${task.ref} unchanged`,
   985→          );
   986→          await markTaskNeedsReview(
   987→            task.ref,
   988→            "Subagent completed but did not merge or kick back. Review required.",
   989→          );
   990→          consecutiveFailures.count++;
   991→        } else {
   992→          warn(`${DEFAULT_SUBAGENT_PREFIX} Task ${task.ref} in unexpected state: ${currentStatus}`);
   993→          consecutiveFailures.count++;
   994→        }
   995→      }
   996→
   997→      // Check if we've hit max failures
   998→      if (consecutiveFailures.count >= options.maxFailures) {
   999→        error(
  1000→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
  1001→        );
  1002→        return false;
  1003→      }
  1004→    } catch (err) {
  1005→      const message = err instanceof Error ? err.message : String(err);
  1006→      error(`${DEFAULT_SUBAGENT_PREFIX} Error processing ${task.ref}: ${message}`);
  1007→      consecutiveFailures.count++;
  1008→
  1009→      if (consecutiveFailures.count >= options.maxFailures) {
  1010→        error(
  1011→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
  1012→        );
  1013→        return false;
  1014→      }
  1015→    }
  1016→  }
  1017→
  1018→  // Visual separator at end of subagent section
  1019→  console.log("");
  1020→  console.log(chalk.cyan(`${"═".repeat(60)}`));
  1021→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Completed Review Processing`));
  1022→  console.log(chalk.cyan(`${"═".repeat(60)}`));
  1023→  console.log("");
  1024→
  1025→  return true;
  1026→}
  1027→
  1028→// ─── Command Registration ────────────────────────────────────────────────────
  1029→
  1030→export function registerRalphCommand(program: Command): void {
  1031→  const ralph = program
  1032→    .command("ralph")
  1033→    .description("Ralph automated task loop and agent control");
  1034→
  1035→  // end-loop subcommand - allows agent to signal loop termination
  1036→  // AC: @ralph-end-loop ac-cmd, ac-reason, ac-noop-outside
  1037→  ralph
  1038→    .command("end-loop")
  1039→    .description("End the ralph loop gracefully (stops all remaining iterations)")
  1040→    .option("--reason <reason>", "Reason for ending the loop")
  1041→    .action(async (options) => {
  1042→      try {
  1043→        const ctx = await initContext();
  1044→
  1045→        // Check if we're in a ralph session by looking for any ralph marker
  1046→        const taskLimitMarker = await readTaskLimitMarker(ctx.rootDir);
  1047→        const endLoopMarker = await readEndLoopMarker(ctx.rootDir);
  1048→
  1049→        // Write the marker with reason if provided
  1050→        await writeEndLoopMarker(ctx.rootDir, options.reason);
  1051→
  1052→        // Determine if we're likely in a ralph session
  1053→        const inRalphSession = taskLimitMarker !== null || endLoopMarker !== null;
  1054→
  1055→        if (!inRalphSession) {
  1056→          // AC: @ralph-end-loop ac-noop-outside
  1057→          warn("No active ralph session detected. Marker written but may have no effect.");
  1058→          info("This command is designed to be called by agents during a ralph loop.");
  1059→        } else {
  1060→          success("Loop end signal sent");
  1061→        }
  1062→
  1063→        if (options.reason) {
  1064→          info(`Reason: ${options.reason}`);
  1065→        }
  1066→      } catch (err) {
  1067→        error("Failed to signal end-loop", err);
  1068→        process.exit(EXIT_CODES.ERROR);
  1069→      }
  1070→    });
  1071→
  1072→  // Main ralph run command (default behavior when ralph is called directly)
  1073→  ralph
  1074→    .command("run", { isDefault: true })
  1075→    .description("Run ACP agent in a loop to process ready tasks")
  1076→    .argument("[args...]", "")
  1077→    .option("--max-loops <n>", "Maximum iterations", "5")
  1078→    .option("--max-retries <n>", "Max retries per iteration on error", "3")
  1079→    .option(
  1080→      "--max-failures <n>",
  1081→      "Max consecutive failed iterations before exit",
  1082→      "3",
  1083→    )
  1084→    .option("--dry-run", "Show prompt without executing")
  1085→    .option("--yolo", "Use dangerously-skip-permissions (default)", true)
  1086→    .option("--no-yolo", "Require normal permission prompts")
  1087→    .option("--subagent-timeout <minutes>", "Review subagent timeout in minutes", "20")
  1088→    .option("--adapter <id>", "Agent adapter to use", "claude-agent-acp")
  1089→    .option("--adapter-cmd <cmd>", "Custom adapter command (for testing)")
  1090→    .option(
  1091→      "--restart-every <n>",
  1092→      "Restart agent every N iterations to prevent OOM (0 = never)",
  1093→      "10",
  1094→    )
  1095→    .option(
  1096→      "--focus <instructions>",
  1097→      "Focus instructions included in every iteration prompt",
  1098→    )
  1099→    .option(
  1100→      "--max-tasks <n>",
  1101→      "Max tasks per iteration (0 = unlimited)",
  1102→      "1",
  1103→    )
  1104→    .option(
  1105→      "--tasks <refs>",
  1106→      "Explicit task scope: only work on these tasks (comma-separated refs, e.g., @task1,@task2)",
  1107→    )
  1108→    .action(async (args: string[], options) => {
  1109→      // Check for unknown subcommands that fell through to default
  1110→      // Only check args that look like subcommand names (alphanumeric with hyphens, no quotes)
  1111→      if (args.length > 0) {
  1112→        const unknownCmd = args[0];
  1113→        // Skip if it looks like a malformed option or quoted argument
  1114→        const looksLikeSubcommand = /^[a-z][a-z0-9-]*$/i.test(unknownCmd);
  1115→        if (looksLikeSubcommand) {
  1116→          if (unknownCmd === "end-iteration") {
  1117→            error(`Unknown command: ${unknownCmd}. Did you mean 'end-loop'?`);
  1118→            info("The command was renamed from 'end-iteration' to 'end-loop' to clarify it ends the entire loop.");
  1119→          } else {
  1120→            error(`Unknown command: ${unknownCmd}`);
  1121→          }
  1122→          info("Run 'kspec ralph --help' to see available commands.");
  1123→          process.exit(EXIT_CODES.USAGE_ERROR);
  1124→        }
  1125→      }
  1126→      try {
  1127→        const maxLoops = parseInt(options.maxLoops, 10);
  1128→        const maxRetries = parseInt(options.maxRetries, 10);
  1129→        const maxFailures = parseInt(options.maxFailures, 10);
  1130→
  1131→        if (Number.isNaN(maxLoops) || maxLoops < 1) {
  1132→          error(errors.usage.maxLoopsPositive);
  1133→          process.exit(EXIT_CODES.ERROR);
  1134→        }
  1135→
  1136→        if (Number.isNaN(maxRetries) || maxRetries < 0) {
  1137→          error(errors.usage.maxRetriesNonNegative);
  1138→          process.exit(EXIT_CODES.ERROR);
  1139→        }
  1140→
  1141→        if (Number.isNaN(maxFailures) || maxFailures < 1) {
  1142→          error(errors.usage.maxFailuresPositive);
  1143→          process.exit(EXIT_CODES.ERROR);
  1144→        }
  1145→
  1146→        const subagentTimeout = parseInt(options.subagentTimeout, 10);
  1147→        if (Number.isNaN(subagentTimeout) || subagentTimeout < 1) {
  1148→          error("--subagent-timeout must be a positive integer (minutes)");
  1149→          process.exit(EXIT_CODES.ERROR);
  1150→        }
  1151→
  1152→        const restartEvery = parseInt(options.restartEvery, 10);
  1153→        if (Number.isNaN(restartEvery) || restartEvery < 0) {
  1154→          error("--restart-every must be a non-negative integer");
  1155→          process.exit(EXIT_CODES.ERROR);
  1156→        }
  1157→
  1158→        // AC: @ralph-task-limit ac-flag
  1159→        const maxTasks = parseInt(options.maxTasks, 10);
  1160→        if (Number.isNaN(maxTasks) || maxTasks < 0 || maxTasks > 999) {
  1161→          error("--max-tasks must be 0 (unlimited) or a positive integer up to 999");
  1162→          process.exit(EXIT_CODES.USAGE_ERROR);
  1163→        }
  1164→
  1165→        // Handle custom adapter command for testing
  1166→        if (options.adapterCmd) {
  1167→          const parts = options.adapterCmd.split(/\s+/);
  1168→          const customAdapter: AgentAdapter = {
  1169→            command: parts[0],
  1170→            args: parts.slice(1),
  1171→            description: "Custom adapter via --adapter-cmd",
  1172→          };
  1173→          registerAdapter("custom", customAdapter);
  1174→          options.adapter = "custom";
  1175→        }
  1176→
  1177→        // Resolve adapter
  1178→        const adapter = resolveAdapter(options.adapter);
  1179→
  1180→        // Validate adapter package exists before proceeding
  1181→        // Skip validation for:
  1182→        // - Custom adapters (--adapter-cmd)
  1183→        // - Non-npx adapters
  1184→        // - Dry-run mode with default adapter (doesn't spawn agent, default may not be installed in CI)
  1185→        // Note: If user explicitly specifies --adapter, validate even in dry-run to catch typos
  1186→        // Accept both new and deprecated adapter names
  1187→        const isDefaultAdapter =
  1188→          options.adapter === "claude-agent-acp" ||
  1189→          options.adapter === "claude-code-acp";
  1190→        const skipValidation =
  1191→          options.adapterCmd ||
  1192→          adapter.command !== "npx" ||
  1193→          !adapter.args[0] ||
  1194→          (options.dryRun && isDefaultAdapter);
  1195→
  1196→        if (!skipValidation) {
  1197→          validateAdapter(adapter.args[0]);
  1198→        }
  1199→
  1200→        // Add yolo flag to adapter args if needed (accept both new and deprecated names)
  1201→        if (options.yolo && isDefaultAdapter) {
  1202→          adapter.args = [...adapter.args, "--dangerously-skip-permissions"];
  1203→        }
  1204→
  1205→        const restartInfo =
  1206→          restartEvery > 0 ? `, restart every ${restartEvery}` : "";
  1207→        const maxTasksInfo =
  1208→          maxTasks === 0 ? "unlimited" : `${maxTasks}`;
  1209→
  1210→        // Initialize kspec context early to validate --tasks
  1211→        const ctx = await initContext();
  1212→
  1213→        // AC: @cli-ralph ac-21 - Parse explicit task scope
  1214→        let explicitTaskScope: ExplicitTaskScope | undefined;
  1215→        if (options.tasks) {
  1216→          try {
  1217→            explicitTaskScope = await parseExplicitTasks(ctx, options.tasks);
  1218→            info(`Explicit task scope: ${explicitTaskScope.refs.join(", ")}`);
  1219→          } catch (err) {
  1220→            error(`Invalid --tasks argument: ${(err as Error).message}`);
  1221→            process.exit(EXIT_CODES.VALIDATION_FAILED);
  1222→          }
  1223→        }
  1224→
  1225→        const taskScopeInfo = explicitTaskScope
  1226→          ? `, tasks=${explicitTaskScope.refs.join(",")}`
  1227→          : "";
  1228→        info(
  1229→          `Starting ralph loop (adapter=${options.adapter}, max ${maxLoops} iterations, ${maxRetries} retries, ${maxFailures} max failures${restartInfo}, max-tasks=${maxTasksInfo}${taskScopeInfo})`,
  1230→        );
  1231→        if (options.focus) {
  1232→          info(`Focus: ${options.focus}`);
  1233→        }
  1234→        const specDir = ctx.specDir;
  1235→
  1236→        // Create session for event tracking
  1237→        const sessionId = ulid();
  1238→
  1239→        // Set KSPEC_RALPH_SESSION on this process so all spawned agents
  1240→        // (main worker, subagent, wrap-up) inherit it via process.env.
  1241→        // Used by the codex skill safety guard to detect ralph context.
  1242→        process.env.KSPEC_RALPH_SESSION = sessionId;
  1243→
  1244→        await createSession(specDir, {
  1245→          id: sessionId,
  1246→          agent_type: options.adapter,
  1247→          task_id: undefined, // Will be determined per iteration
  1248→        });
  1249→
  1250→        // Log session start
  1251→        await appendEvent(specDir, {
  1252→          session_id: sessionId,
  1253→          type: "session.start",
  1254→          data: {
  1255→            adapter: options.adapter,
  1256→            maxLoops,
  1257→            maxRetries,
  1258→            maxFailures,
  1259→            maxTasks,
  1260→            yolo: options.yolo,
  1261→            focus: options.focus,
  1262→            explicitTasks: explicitTaskScope?.refs,
  1263→          },
  1264→        });
  1265→
  1266→        let consecutiveFailures = 0;
  1267→        let agent: SpawnedAgent | null = null;
  1268→        let acpSessionId: string | null = null;
  1269→
  1270→        // AC: @ralph-end-loop ac-signal-cleanup, @ralph-task-limit ac-signal-cleanup
  1271→        // Signal handlers for cleanup on Ctrl+C or kill
  1272→        // Note: Signal handlers must be synchronous, so we use Promise.finally()
  1273→        // to ensure cleanup completes before exit
  1274→        const signalCleanup = (signal: string) => {
  1275→          info(`Received ${signal}, cleaning up...`);
  1276→          // Kill agent if running
  1277→          if (agent) {
  1278→            agent.kill();
  1279→          }
  1280→          // Clean up marker files, then exit after cleanup completes
  1281→          Promise.all([
  1282→            clearTaskLimitMarker(ctx.rootDir),
  1283→            clearEndLoopMarker(ctx.rootDir),
  1284→          ]).finally(() => {
  1285→            process.exit(0);
  1286→          });
  1287→        };
  1288→        const sigintHandler = () => { signalCleanup("SIGINT"); };
  1289→        const sigtermHandler = () => { signalCleanup("SIGTERM"); };
  1290→        process.on("SIGINT", sigintHandler);
  1291→        process.on("SIGTERM", sigtermHandler);
  1292→
  1293→        // Create translator and renderer for this session
  1294→        const translator = createTranslator();
  1295→        const renderer = createCliRenderer();
  1296→
  1297→        // Task limit state - tracks completions per iteration
  1298→        // AC: @ralph-task-limit ac-reset, ac-wrapup
  1299→        let taskLimitReached = false;
  1300→        let tasksCompletedThisIteration = 0;
  1301→
  1302→        // End-loop signal state
  1303→        // AC: @ralph-end-loop ac-detect, ac-graceful
  1304→        let endLoopRequested = false;
  1305→
  1306→        // AC: @ralph-wrap-up-agent-on-loop-exit ac-1 - Track exit reason for wrap-up
  1307→        let exitReason: ExitReason | null = null;
  1308→        let lastIterationCtx: SessionContext | null = null;
  1309→        let lastErrorMessage: string | undefined;
  1310→        const recentTaskRefs: string[] = [];
  1311→
  1312→        // Map ACP session IDs to their iteration number.
  1313→        // The agent's "update" handler persists across iterations and receives
  1314→        // the ACP session ID (_sid) on each event. By looking up the iteration
  1315→        // from this map, late updates from a previous ACP session are correctly
  1316→        // attributed even after the loop has advanced to the next iteration.
  1317→        const sessionIterationMap = new Map<string, number>();
  1318→
  1319→        try {
  1320→          for (let iteration = 1; iteration <= maxLoops; iteration++) {
  1321→            renderer.newSection?.(`Iteration ${iteration}/${maxLoops}`);
  1322→
  1323→            // AC: @ralph-task-limit ac-reset - Reset counter and clear stale markers at iteration start
  1324→            taskLimitReached = false;
  1325→            tasksCompletedThisIteration = 0;
  1326→            const wasStale = await clearStaleMarker(ctx.rootDir);
  1327→            if (wasStale) {
  1328→              info("Cleared stale task limit marker from previous session");
  1329→            }
  1330→            // Also clear any marker from previous iteration of this session
  1331→            await clearTaskLimitMarker(ctx.rootDir);
  1332→
  1333→            // AC: @ralph-end-loop ac-cleanup - Reset end-loop state
  1334→            endLoopRequested = false;
  1335→            const wasStaleEndLoop = await clearStaleEndLoopMarker(ctx.rootDir);
  1336→            if (wasStaleEndLoop) {
  1337→              info("Cleared stale end-loop marker from previous session");
  1338→            }
  1339→            await clearEndLoopMarker(ctx.rootDir);
  1340→
  1341→            // Gather fresh context each iteration
  1342→            // AC: @cli-ralph ac-16 - Only automation-eligible tasks (unless explicit scope)
  1343→            // AC: @cli-ralph ac-21 - With explicit task scope, ignore automation eligibility
  1344→            let sessionCtx = await gatherSessionContext(ctx, {
  1345→              limit: "10",
  1346→              eligible: !explicitTaskScope, // Skip eligibility filter if explicit scope
  1347→            });
  1348→
  1349→            // AC: @cli-ralph ac-21 - Filter to explicit tasks if scope is set
  1350→            if (explicitTaskScope) {
  1351→              sessionCtx = filterByExplicitTasks(sessionCtx, explicitTaskScope);
  1352→            }
  1353→
  1354→            // AC: @ralph-subagent-spawning ac-8 - Process pending_review tasks BEFORE main iteration
  1355→            // This wraps consecutiveFailures in an object so it can be mutated by the helper
  1356→            const failureTracker = { count: consecutiveFailures };
  1357→            const continueLoop = await processPendingReviewTasks(
  1358→              ctx,
  1359→              adapter,
  1360→              sessionCtx.pending_review_tasks,
  1361→              {
  1362→                yolo: options.yolo,
  1363→                maxRetries,
  1364→                maxFailures,
  1365→                cwd: process.cwd(),
  1366→                subagentTimeout: subagentTimeout * 60 * 1000,
  1367→              },
  1368→              failureTracker,
  1369→            );
  1370→            consecutiveFailures = failureTracker.count;
  1371→
  1372→            if (!continueLoop) {
  1373→              exitReason = "max_failures";
  1374→              lastIterationCtx = sessionCtx;
  1375→              break;
  1376→            }
  1377→
  1378→            // AC: @cli-ralph ac-20 - Refresh context after pending_review processing
  1379→            // If pending_review tasks were processed, they may have completed and unblocked
  1380→            // dependent tasks. Re-gather context to detect newly available tasks.
  1381→            let currentCtx = sessionCtx;
  1382→            if (sessionCtx.pending_review_tasks.length > 0) {
  1383→              currentCtx = await gatherSessionContext(ctx, {
  1384→                limit: "10",
  1385→                eligible: !explicitTaskScope,
  1386→              });
  1387→              if (explicitTaskScope) {
  1388→                currentCtx = filterByExplicitTasks(currentCtx, explicitTaskScope);
  1389→              }
  1390→            }
  1391→
  1392→            // AC: @cli-ralph ac-21 - Check explicit task completion
  1393→            if (explicitTaskScope) {
  1394→              const { done, statuses } = await allExplicitTasksDone(ctx, explicitTaskScope);
  1395→              if (done) {
  1396→                const statusList = Array.from(statuses.entries())
  1397→                  .map(([ref, status]) => `${ref}: ${status}`)
  1398→                  .join(", ");
  1399→                info(`All explicit tasks completed or blocked (${statusList}). Exiting loop.`);
  1400→                exitReason = "explicit_tasks_done";
  1401→                lastIterationCtx = currentCtx;
  1402→                break;
  1403→              }
  1404→            }
  1405→
  1406→            // Check for automation-eligible tasks (ready or in_progress)
  1407→            // AC: @cli-ralph ac-19
  1408→            const hasActiveTasks = currentCtx.active_tasks.length > 0;
  1409→            const hasReadyTasks = currentCtx.ready_tasks.length > 0;
  1410→
  1411→            if (!hasActiveTasks && !hasReadyTasks) {
  1412→              if (explicitTaskScope) {
  1413→                info("No explicit tasks available (ready or in_progress). Exiting loop.");
  1414→              } else {
  1415→                info("No automation-eligible tasks (ready or in_progress). Exiting loop.");
  1416→              }
  1417→              exitReason = "no_tasks";
  1418→              lastIterationCtx = currentCtx;
  1419→              break;
  1420→            }
  1421→
  1422→            // AC: @loop-mode-error-handling - Track tasks in progress for failure handling
  1423→            const tasksInProgressAtStart = sessionCtx.active_tasks;
  1424→            const iterationStartTime = new Date();
  1425→
  1426→            // Build prompts - task-work first, then reflect
  1427→            // AC: @cli-ralph ac-21 - Include explicit task scope in prompt
  1428→            const taskWorkPrompt = buildTaskWorkPrompt(
  1429→              currentCtx,
  1430→              iteration,
  1431→              maxLoops,
  1432→              sessionId,
  1433→              ctx.config.ralph.skills.task_work,
  1434→              options.focus,
  1435→              explicitTaskScope,
  1436→            );
  1437→            const reflectPrompt = buildReflectPrompt(
  1438→              iteration,
  1439→              maxLoops,
  1440→              sessionId,
  1441→              ctx.config.ralph.skills.reflect,
  1442→            );
  1443→
  1444→            // AC: @ralph-task-limit ac-dryrun, @cli-ralph ac-21
  1445→            if (options.dryRun) {
  1446→              console.log(
  1447→                chalk.yellow("=== DRY RUN - Configuration ===\n"),
  1448→              );
  1449→              console.log(`  max-loops: ${maxLoops}`);
  1450→              console.log(`  max-tasks: ${maxTasks === 0 ? "unlimited" : maxTasks}`);
  1451→              console.log(`  max-retries: ${maxRetries}`);
  1452→              console.log(`  max-failures: ${maxFailures}`);
  1453→              console.log(`  restart-every: ${restartEvery === 0 ? "never" : restartEvery}`);
  1454→              if (explicitTaskScope) {
  1455→                console.log(`  explicit-tasks: ${explicitTaskScope.refs.join(", ")}`);
  1456→              }
  1457→              console.log(
  1458→                chalk.yellow("\n=== Task Work Prompt ===\n"),
  1459→              );
  1460→              console.log(taskWorkPrompt);
  1461→              console.log(chalk.yellow("\n=== Reflect Prompt ===\n"));
  1462→              console.log(reflectPrompt);
  1463→              console.log(chalk.yellow("\n=== END DRY RUN ==="));
  1464→              break;
  1465→            }
  1466→
  1467→            // Log task-work prompt
  1468→            await appendEvent(specDir, {
  1469→              session_id: sessionId,
  1470→              type: "prompt.sent",
  1471→              data: {
  1472→                iteration,
  1473→                phase: "task-work",
  1474→                prompt: taskWorkPrompt,
  1475→                tasks: {
  1476→                  active: currentCtx.active_tasks.map((t) => t.ref),
  1477→                  ready: currentCtx.ready_tasks.map((t) => t.ref),
  1478→                },
  1479→              },
  1480→            });
  1481→
  1482→            // Retry loop for this iteration
  1483→            let lastError: Error | null = null;
  1484→            let succeeded = false;
  1485→
  1486→            for (let attempt = 1; attempt <= maxRetries + 1; attempt++) {
  1487→              if (attempt > 1) {
  1488→                console.log(
  1489→                  chalk.yellow(
  1490→                    `\nRetry attempt ${attempt - 1}/${maxRetries}...`,
  1491→                  ),
  1492→                );
  1493→              }
  1494→
  1495→              try {
  1496→                // Spawn agent if not already running
  1497→                if (!agent) {
  1498→                  info("Spawning ACP agent...");
  1499→                  agent = await spawnAndInitialize(adapter, {
  1500→                    cwd: process.cwd(),
  1501→                    clientOptions: {
  1502→                      clientInfo: {
  1503→                        name: "kspec-ralph",
  1504→                        version: packageVersion,
  1505→                      },
  1506→                      methodTimeouts: {
  1507→                        "session/prompt": RALPH_PROMPT_TIMEOUT,
  1508→                        "session/resume": RALPH_PROMPT_TIMEOUT,
  1509→                      },
  1510→                    },
  1511→                  });
  1512→
  1513→                  // Set up streaming update handler with translator + renderer
  1514→                  agent.client.on(
  1515→                    "update",
  1516→                    (_sid: string, update: SessionUpdate) => {
  1517→                      // Translate ACP event to RalphEvent and render
  1518→                      const event = translator.translate(update);
  1519→                      if (event) {
  1520→                        renderer.render(event);
  1521→                      }
  1522→
  1523→                      // AC: @ralph-task-limit ac-detection, ac-wrapup
  1524→                      // Detect task completions for limit enforcement
  1525→                      if (maxTasks > 0 && !taskLimitReached) {
  1526→                        const bashCmd = extractBashCommand(update);
  1527→                        if (bashCmd && detectTaskCompleteCommand(bashCmd)) {
  1528→                          // Pattern matched - verify via kspec query
  1529→                          getIterationStats(ctx, iterationStartTime)
  1530→                            .then(async (stats) => {
  1531→                              if (stats.tasks_completed >= maxTasks && !taskLimitReached) {
  1532→                                taskLimitReached = true;
  1533→                                tasksCompletedThisIteration = stats.tasks_completed;
  1534→                                info(`Task limit reached (${stats.tasks_completed}/${maxTasks})`);
  1535→
  1536→                                // AC: @ralph-task-limit ac-marker-format, ac-wrapup
  1537→                                // Write marker file for hook enforcement
  1538→                                const marker: TaskLimitMarker = {
  1539→                                  active: true,
  1540→                                  since: iterationStartTime.toISOString(),
  1541→                                  max: maxTasks,
  1542→                                  completed: stats.tasks_completed,
  1543→                                  sessionId,
  1544→                                };
  1545→                                await writeTaskLimitMarker(ctx.rootDir, marker);
  1546→
  1547→                                // Inject wrap-up message to agent
  1548→                                if (agent && acpSessionId) {
  1549→                                  const wrapUpMsg = `\n\n**TASK LIMIT REACHED** - ${stats.tasks_completed} task(s) completed this iteration (limit: ${maxTasks}).\n\nPlease wrap up your current work and exit cleanly. Do not start new tasks.\n\nCompleted tasks this iteration: ${stats.completed_refs.join(", ")}`;
  1550→                                  agent.client.prompt({
  1551→                                    sessionId: acpSessionId,
  1552→                                    prompt: [{ type: "text", text: wrapUpMsg }],
  1553→                                  }).catch(() => {
  1554→                                    // Ignore if message injection fails
  1555→                                  });
  1556→                                }
  1557→                              }
  1558→                            })
  1559→                            .catch(() => {
  1560→                              // Ignore query failures - detection is best-effort
  1561→                            });
  1562→                        }
  1563→                      }
  1564→
  1565→                      // AC: @ralph-end-loop ac-detect
  1566→                      // Detect explicit end-loop command
  1567→                      if (!endLoopRequested) {
  1568→                        const bashCmd = extractBashCommand(update);
  1569→                        if (bashCmd && detectEndLoopCommand(bashCmd)) {
  1570→                          endLoopRequested = true;
  1571→                          // Read marker to get reason if present
  1572→                          readEndLoopMarker(ctx.rootDir)
  1573→                            .then((marker) => {
  1574→                              const reason = marker?.reason
  1575→                                ? ` (${marker.reason})`
  1576→                                : "";
  1577→                              info(`End-loop signal received${reason}`);
  1578→                            })
  1579→                            .catch(() => {
  1580→                              info("End-loop signal received");
  1581→                            });
  1582→                        }
  1583→                      }
  1584→
  1585→                      // Log raw update event (async, non-blocking)
  1586→                      // Look up iteration by ACP session ID so late updates from
  1587→                      // a previous session are attributed to the correct iteration
  1588→                      const eventIteration = sessionIterationMap.get(_sid) ?? 0;
  1589→                      appendEvent(specDir, {
  1590→                        session_id: sessionId,
  1591→                        type: "session.update",
  1592→                        data: { iteration: eventIteration, update },
  1593→                      }).catch(() => {
  1594→                        // Ignore logging errors during streaming
  1595→                      });
  1596→                    },
  1597→                  );
  1598→
  1599→                  // Set up tool request handler
  1600→                  agent.client.on(
  1601→                    "request",
  1602→                    (
  1603→                      reqId: string | number,
  1604→                      method: string,
  1605→                      params: unknown,
  1606→                    ) => {
  1607→                      // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1608→                      handleRequest(
  1609→                        agent!.client,
  1610→                        reqId,
  1611→                        method,
  1612→                        params,
  1613→                        options.yolo,
  1614→                      ).catch((err) => {
  1615→                        // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1616→                        agent!.client.respondError(reqId, -32000, err.message);
  1617→                      });
  1618→                    },
  1619→                  );
  1620→                }
  1621→
  1622→                // Create fresh ACP session per iteration to keep context clean
  1623→                info("Creating ACP session...");
  1624→                acpSessionId = await agent.client.newSession({
  1625→                  cwd: process.cwd(),
  1626→                  mcpServers: [], // No MCP servers for now
  1627→                });
  1628→                sessionIterationMap.set(acpSessionId, iteration);
  1629→
  1630→                // Phase 1: Task Work
  1631→                info("Sending task-work prompt to agent...");
  1632→                const taskWorkResponse = await agent.client.prompt({
  1633→                  sessionId: acpSessionId!,
  1634→                  prompt: [{ type: "text", text: taskWorkPrompt }],
  1635→                });
  1636→
  1637→                // Log task-work completion
  1638→                await appendEvent(specDir, {
  1639→                  session_id: sessionId,
  1640→                  type: "session.update",
  1641→                  data: {
  1642→                    iteration,
  1643→                    phase: "task-work",
  1644→                    stopReason: taskWorkResponse.stopReason,
  1645→                    completed: true,
  1646→                  },
  1647→                });
  1648→
  1649→                if (taskWorkResponse.stopReason === "cancelled") {
  1650→                  throw new Error(errors.usage.agentPromptCancelled);
  1651→                }
  1652→
  1653→                // Phase 2: Reflect (always sent after task-work completes)
  1654→                info("Sending reflect prompt to agent...");
  1655→                await appendEvent(specDir, {
  1656→                  session_id: sessionId,
  1657→                  type: "prompt.sent",
  1658→                  data: {
  1659→                    iteration,
  1660→                    phase: "reflect",
  1661→                    prompt: reflectPrompt,
  1662→                  },
  1663→                });
  1664→
  1665→                const reflectResponse = await agent.client.prompt({
  1666→                  sessionId: acpSessionId!,
  1667→                  prompt: [{ type: "text", text: reflectPrompt }],
  1668→                });
  1669→
  1670→                // Log reflect completion
  1671→                await appendEvent(specDir, {
  1672→                  session_id: sessionId,
  1673→                  type: "session.update",
  1674→                  data: {
  1675→                    iteration,
  1676→                    phase: "reflect",
  1677→                    stopReason: reflectResponse.stopReason,
  1678→                    completed: true,
  1679→                  },
  1680→                });
  1681→
  1682→                if (reflectResponse.stopReason === "cancelled") {
  1683→                  throw new Error(errors.usage.agentPromptCancelled);
  1684→                }
  1685→
  1686→                succeeded = true;
  1687→                break;
  1688→              } catch (err) {
  1689→                lastError = err as Error;
  1690→                error(errors.failures.iterationFailed(lastError.message));
  1691→
  1692→                // Clean up agent on error - will respawn next attempt
  1693→                if (agent) {
  1694→                  agent.kill();
  1695→                  agent = null;
  1696→                  acpSessionId = null;
  1697→                }
  1698→              }
  1699→            }
  1700→
  1701→            if (succeeded) {
  1702→              console.log(); // Newline after streaming output
  1703→
  1704→              // Save session context snapshot for audit trail
  1705→              await saveSessionContext(
  1706→                specDir,
  1707→                sessionId,
  1708→                iteration,
  1709→                sessionCtx,
  1710→              );
  1711→
  1712→              success(`Completed iteration ${iteration}`);
  1713→              consecutiveFailures = 0;
  1714→
  1715→              // Track task refs from this iteration for wrap-up context
  1716→              for (const t of sessionCtx.active_tasks) {
  1717→                if (!recentTaskRefs.includes(t.ref)) {
  1718→                  recentTaskRefs.push(t.ref);
  1719→                }
  1720→              }
  1721→              lastIterationCtx = sessionCtx;
  1722→
  1723→              // AC: @ralph-end-loop ac-graceful - Check for end-loop signal
  1724→              if (endLoopRequested) {
  1725→                info("Agent requested end of loop. Exiting gracefully.");
  1726→                exitReason = "end_loop_signal";
  1727→                break;
  1728→              }
  1729→
  1730→              // Periodic agent restart to prevent OOM
  1731→              // AC: @cli-ralph ac-restart-periodic
  1732→              if (
  1733→                restartEvery > 0 &&
  1734→                iteration % restartEvery === 0 &&
  1735→                iteration < maxLoops
  1736→              ) {
  1737→                info(
  1738→                  `Restarting agent to prevent memory buildup (every ${restartEvery} iterations)...`,
  1739→                );
  1740→                if (agent) {
  1741→                  agent.kill();
  1742→                  agent = null;
  1743→                  acpSessionId = null;
  1744→                }
  1745→              }
  1746→            } else {
  1747→              consecutiveFailures++;
  1748→              error(
  1749→                errors.failures.iterationFailedAfterRetries(
  1750→                  iteration,
  1751→                  maxRetries,
  1752→                  consecutiveFailures,
  1753→                  maxFailures,
  1754→                ),
  1755→              );
  1756→              if (lastError) {
  1757→                error(errors.failures.lastError(lastError.message));
  1758→              }
  1759→
  1760→              // AC: @loop-mode-error-handling - Track per-task failures
  1761→              const errorDesc = lastError?.message || "Iteration failed after retries";
  1762→              await handleIterationFailure(
  1763→                ctx,
  1764→                tasksInProgressAtStart,
  1765→                iterationStartTime,
  1766→                errorDesc,
  1767→              );
  1768→
  1769→              if (consecutiveFailures >= maxFailures) {
  1770→                error(errors.failures.reachedMaxFailures(maxFailures));
  1771→                exitReason = "max_failures";
  1772→                lastErrorMessage = lastError?.message;
  1773→                lastIterationCtx = sessionCtx;
  1774→                break;
  1775→              }
  1776→
  1777→              info("Continuing to next iteration...");
  1778→            }
  1779→          }
  1780→
  1781→          // If loop completed all iterations without breaking
  1782→          if (exitReason === null) {
  1783→            exitReason = "max_iterations";
  1784→          }
  1785→        } finally {
  1786→          // Remove signal handlers to avoid double cleanup
  1787→          process.off("SIGINT", sigintHandler);
  1788→          process.off("SIGTERM", sigtermHandler);
  1789→
  1790→          // Clean up agent
  1791→          if (agent) {
  1792→            agent.kill();
  1793→            agent = null;
  1794→          }
  1795→
  1796→          // AC: @ralph-task-limit ac-reset - Clear marker file when session ends
  1797→          await clearTaskLimitMarker(ctx.rootDir);
  1798→
  1799→          // AC: @ralph-end-loop ac-cleanup - Clear end-loop marker when session ends
  1800→          await clearEndLoopMarker(ctx.rootDir);
  1801→
  1802→          // Clean up ralph session env var
  1803→          delete process.env.KSPEC_RALPH_SESSION;
  1804→
  1805→          // AC: @ralph-wrap-up-agent-on-loop-exit ac-1, ac-2, ac-3, ac-4, ac-5
  1806→          // Spawn wrap-up agent if not dry-run and we have an exit reason
  1807→          if (!options.dryRun && exitReason) {
  1808→            console.log("");
  1809→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1810→            console.log(chalk.cyan.bold(`${WRAPUP_AGENT_PREFIX} Starting Wrap-Up`));
  1811→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1812→            console.log("");
  1813→
  1814→            const inProgressTasks = lastIterationCtx?.active_tasks || [];
  1815→            const pendingReviewTasks = lastIterationCtx?.pending_review_tasks || [];
  1816→
  1817→            const wrapUpCtx = buildWrapUpContext(
  1818→              exitReason,
  1819→              sessionId,
  1820→              maxLoops, // Use maxLoops as iteration (we're at the end)
  1821→              maxLoops,
  1822→              inProgressTasks,
  1823→              pendingReviewTasks,
  1824→              recentTaskRefs,
  1825→              process.cwd(),
  1826→              lastErrorMessage,
  1827→            );
  1828→
  1829→            info(`Exit reason: ${exitReason}`);
  1830→            info(`Working tree: ${wrapUpCtx.workingTree.clean ? "clean" : "has uncommitted changes"}`);
  1831→
  1832→            const wrapUpResult = await runWrapUpAgent(
  1833→              adapter,
  1834→              wrapUpCtx,
  1835→              {
  1836→                yolo: options.yolo,
  1837→                cwd: process.cwd(),
  1838→                handleRequest: (client, reqId, method, params) =>
  1839→                  handleRequest(client, reqId, method, params, options.yolo),
  1840→              },
  1841→              DEFAULT_WRAPUP_TIMEOUT,
  1842→            );
  1843→
  1844→            // Log wrap-up result
  1845→            await appendEvent(specDir, {
  1846→              session_id: sessionId,
  1847→              type: "session.wrapup",
  1848→              data: {
  1849→                exitReason,
  1850→                result: wrapUpResult,
  1851→              },
  1852→            });
  1853→
  1854→            if (wrapUpResult.skipped) {
  1855→              info(`${WRAPUP_AGENT_PREFIX} Skipped: ${wrapUpResult.skipReason}`);
  1856→            } else if (wrapUpResult.timedOut) {
  1857→              warn(`${WRAPUP_AGENT_PREFIX} Timed out after ${DEFAULT_WRAPUP_TIMEOUT / 1000}s`);
  1858→            } else if (!wrapUpResult.success) {
  1859→              warn(`${WRAPUP_AGENT_PREFIX} Failed: ${wrapUpResult.error}`);
  1860→            } else {
  1861→              success(`${WRAPUP_AGENT_PREFIX} Completed`);
  1862→            }
  1863→
  1864→            console.log("");
  1865→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1866→            console.log(chalk.cyan.bold(`${WRAPUP_AGENT_PREFIX} Wrap-Up Complete`));
  1867→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1868→            console.log("");
  1869→          }
  1870→
  1871→          // Log session end
  1872→          const status =
  1873→            consecutiveFailures >= maxFailures ? "abandoned" : "completed";
  1874→          await appendEvent(specDir, {
  1875→            session_id: sessionId,
  1876→            type: "session.end",
  1877→            data: {
  1878→              status,
  1879→              consecutiveFailures,
  1880→              exitReason,
  1881→            },
  1882→          });
  1883→          await updateSessionStatus(specDir, sessionId, status);
  1884→        }
  1885→
  1886→        console.log(chalk.green(`\n${"─".repeat(60)}`));
  1887→        success("Ralph loop completed");
  1888→        console.log(chalk.green(`${"─".repeat(60)}\n`));
  1889→      } catch (err) {
  1890→        error(errors.failures.ralphLoop, err);
  1891→        process.exit(EXIT_CODES.ERROR);
  1892→      }
  1893→    });
  1894→}
  1895→
```