     1→/**
     2→ * Tests for ralph wrap-up agent module.
     3→ *
     4→ * AC: @ralph-wrap-up-agent-on-loop-exit
     5→ */
     6→import { describe, it, expect } from 'vitest';
     7→import {
     8→  buildWrapUpContext,
     9→  buildWrapUpPrompt,
    10→  DEFAULT_WRAPUP_TIMEOUT,
    11→  isWrapUpNeeded,
    12→  WRAPUP_AGENT_PREFIX,
    13→  type ExitReason,
    14→  type WrapUpContext,
    15→} from '../src/ralph/wrap-up.js';
    16→import type { GitWorkingTree } from '../src/utils/git.js';
    17→
    18→// ─── Helper Functions ─────────────────────────────────────────────────────────
    19→
    20→function createCleanWorkingTree(): GitWorkingTree {
    21→  return {
    22→    clean: true,
    23→    staged: [],
    24→    unstaged: [],
    25→    untracked: [],
    26→  };
    27→}
    28→
    29→function createDirtyWorkingTree(): GitWorkingTree {
    30→  return {
    31→    clean: false,
    32→    staged: [{ path: 'src/feature.ts', status: 'modified', staged: true }],
    33→    unstaged: [{ path: 'tests/feature.test.ts', status: 'modified', staged: false }],
    34→    untracked: ['temp.log', 'debug.txt'],
    35→  };
    36→}
    37→
    38→function createWrapUpContext(overrides: Partial<WrapUpContext> = {}): WrapUpContext {
    39→  return {
    40→    exitReason: 'no_tasks',
    41→    sessionId: '01TEST00000000000000000000',
    42→    iteration: 5,
    43→    maxIterations: 10,
    44→    workingTree: createCleanWorkingTree(),
    45→    inProgressTasks: [],
    46→    pendingReviewTasks: [],
    47→    recentTaskRefs: [],
    48→    ...overrides,
    49→  };
    50→}
    51→
    52→// ─── Tests ────────────────────────────────────────────────────────────────────
    53→
    54→describe('wrap-up agent module', () => {
    55→  describe('constants', () => {
    56→    // AC: @ralph-wrap-up-agent-on-loop-exit ac-5
    57→    it('DEFAULT_WRAPUP_TIMEOUT is 2 minutes', () => {
    58→      expect(DEFAULT_WRAPUP_TIMEOUT).toBe(2 * 60 * 1000);
    59→    });
    60→
    61→    it('WRAPUP_AGENT_PREFIX is [WRAP-UP]', () => {
    62→      expect(WRAPUP_AGENT_PREFIX).toBe('[WRAP-UP]');
    63→    });
    64→  });
    65→
    66→  describe('isWrapUpNeeded', () => {
    67→    // AC: @ralph-wrap-up-agent-on-loop-exit ac-1
    68→    it('returns needed=true when working tree has uncommitted changes', () => {
    69→      const context = createWrapUpContext({
    70→        workingTree: createDirtyWorkingTree(),
    71→      });
    72→
    73→      const result = isWrapUpNeeded(context);
    74→
    75→      expect(result.needed).toBe(true);
    76→      expect(result.reason).toBeUndefined();
    77→    });
    78→
    79→    it('returns needed=true when there are in-progress tasks', () => {
    80→      const context = createWrapUpContext({
    81→        inProgressTasks: [{ ref: '@task-1', title: 'Task 1' }],
    82→      });
    83→
    84→      const result = isWrapUpNeeded(context);
    85→
    86→      expect(result.needed).toBe(true);
    87→    });
    88→
    89→    it('returns needed=true when exit reason is error AND working tree dirty', () => {
    90→      const context = createWrapUpContext({
    91→        exitReason: 'error',
    92→        errorMessage: 'Something went wrong',
    93→        workingTree: createDirtyWorkingTree(),
    94→      });
    95→
    96→      const result = isWrapUpNeeded(context);
    97→
    98→      expect(result.needed).toBe(true);
    99→    });
   100→
   101→    it('returns needed=false when exit reason is error BUT tree is clean', () => {
   102→      const context = createWrapUpContext({
   103→        exitReason: 'error',
   104→        errorMessage: 'Something went wrong',
   105→        workingTree: createCleanWorkingTree(),
   106→        inProgressTasks: [],
   107→      });
   108→
   109→      const result = isWrapUpNeeded(context);
   110→
   111→      expect(result.needed).toBe(false);
   112→    });
   113→
   114→    it('returns needed=true when exit reason is max_failures AND in-progress tasks', () => {
   115→      const context = createWrapUpContext({
   116→        exitReason: 'max_failures',
   117→        inProgressTasks: [{ ref: '@task-1', title: 'Unfinished work' }],
   118→      });
   119→
   120→      const result = isWrapUpNeeded(context);
   121→
   122→      expect(result.needed).toBe(true);
   123→    });
   124→
   125→    it('returns needed=false when exit reason is max_failures BUT tree clean and no tasks', () => {
   126→      const context = createWrapUpContext({
   127→        exitReason: 'max_failures',
   128→        workingTree: createCleanWorkingTree(),
   129→        inProgressTasks: [],
   130→      });
   131→
   132→      const result = isWrapUpNeeded(context);
   133→
   134→      expect(result.needed).toBe(false);
   135→    });
   136→
   137→    it('returns needed=false with reason when clean exit and clean tree', () => {
   138→      const context = createWrapUpContext({
   139→        exitReason: 'no_tasks',
   140→        workingTree: createCleanWorkingTree(),
   141→        inProgressTasks: [],
   142→      });
   143→
   144→      const result = isWrapUpNeeded(context);
   145→
   146→      expect(result.needed).toBe(false);
   147→      expect(result.reason).toContain('clean');
   148→    });
   149→
   150→    it('returns needed=false for explicit_tasks_done with clean tree', () => {
   151→      const context = createWrapUpContext({
   152→        exitReason: 'explicit_tasks_done',
   153→        workingTree: createCleanWorkingTree(),
   154→        inProgressTasks: [],
   155→      });
   156→
   157→      const result = isWrapUpNeeded(context);
   158→
   159→      expect(result.needed).toBe(false);
   160→    });
   161→  });
   162→
   163→  describe('buildWrapUpPrompt', () => {
   164→    // AC: @ralph-wrap-up-agent-on-loop-exit ac-2
   165→    it('includes session ID in prompt', () => {
   166→      const context = createWrapUpContext({
   167→        sessionId: '01TESTSESSIONID0000000000',
   168→      });
   169→
   170→      const prompt = buildWrapUpPrompt(context);
   171→
   172→      expect(prompt).toContain('01TESTSESSIONID0000000000');
   173→    });
   174→
   175→    it('includes iteration info in prompt', () => {
   176→      const context = createWrapUpContext({
   177→        iteration: 7,
   178→        maxIterations: 10,
   179→      });
   180→
   181→      const prompt = buildWrapUpPrompt(context);
   182→
   183→      expect(prompt).toContain('7 of 10');
   184→    });
   185→
   186→    it('includes exit reason description for no_tasks', () => {
   187→      const context = createWrapUpContext({
   188→        exitReason: 'no_tasks',
   189→      });
   190→
   191→      const prompt = buildWrapUpPrompt(context);
   192→
   193→      expect(prompt).toContain('No automation-eligible tasks available');
   194→    });
   195→
   196→    it('includes exit reason description for end_loop_signal', () => {
   197→      const context = createWrapUpContext({
   198→        exitReason: 'end_loop_signal',
   199→      });
   200→
   201→      const prompt = buildWrapUpPrompt(context);
   202→
   203→      expect(prompt).toContain('Agent explicitly requested end of loop');
   204→    });
   205→
   206→    it('includes exit reason description for max_iterations', () => {
   207→      const context = createWrapUpContext({
   208→        exitReason: 'max_iterations',
   209→        maxIterations: 20,
   210→      });
   211→
   212→      const prompt = buildWrapUpPrompt(context);
   213→
   214→      expect(prompt).toContain('Reached maximum iterations (20)');
   215→    });
   216→
   217→    it('includes error message in exit reason description for error', () => {
   218→      const context = createWrapUpContext({
   219→        exitReason: 'error',
   220→        errorMessage: 'Connection timeout',
   221→      });
   222→
   223→      const prompt = buildWrapUpPrompt(context);
   224→
   225→      expect(prompt).toContain('Error occurred');
   226→      expect(prompt).toContain('Connection timeout');
   227→    });
   228→
   229→    it('includes exit reason description for max_failures', () => {
   230→      const context = createWrapUpContext({
   231→        exitReason: 'max_failures',
   232→      });
   233→
   234→      const prompt = buildWrapUpPrompt(context);
   235→
   236→      expect(prompt).toContain('Reached maximum consecutive failures');
   237→    });
   238→
   239→    it('includes exit reason description for explicit_tasks_done', () => {
   240→      const context = createWrapUpContext({
   241→        exitReason: 'explicit_tasks_done',
   242→      });
   243→
   244→      const prompt = buildWrapUpPrompt(context);
   245→
   246→      expect(prompt).toContain('All explicitly scoped tasks completed or blocked');
   247→    });
   248→
   249→    // AC: @ralph-wrap-up-agent-on-loop-exit ac-2
   250→    it('shows clean working tree message when no changes', () => {
   251→      const context = createWrapUpContext({
   252→        workingTree: createCleanWorkingTree(),
   253→      });
   254→
   255→      const prompt = buildWrapUpPrompt(context);
   256→
   257→      expect(prompt).toContain('Working tree is clean');
   258→      expect(prompt).toContain('No uncommitted changes');
   259→    });
   260→
   261→    it('lists staged changes when present', () => {
   262→      const context = createWrapUpContext({
   263→        workingTree: {
   264→          clean: false,
   265→          staged: [
   266→            { path: 'src/feature.ts', status: 'modified', staged: true },
   267→            { path: 'src/new.ts', status: 'added', staged: true },
   268→          ],
   269→          unstaged: [],
   270→          untracked: [],
   271→        },
   272→      });
   273→
   274→      const prompt = buildWrapUpPrompt(context);
   275→
   276→      expect(prompt).toContain('Staged (2)');
   277→      expect(prompt).toContain('src/feature.ts (modified)');
   278→      expect(prompt).toContain('src/new.ts (added)');
   279→    });
   280→
   281→    it('lists unstaged changes when present', () => {
   282→      const context = createWrapUpContext({
   283→        workingTree: {
   284→          clean: false,
   285→          staged: [],
   286→          unstaged: [{ path: 'tests/spec.test.ts', status: 'modified', staged: false }],
   287→          untracked: [],
   288→        },
   289→      });
   290→
   291→      const prompt = buildWrapUpPrompt(context);
   292→
   293→      expect(prompt).toContain('Unstaged (1)');
   294→      expect(prompt).toContain('tests/spec.test.ts (modified)');
   295→    });
   296→
   297→    it('lists untracked files when present', () => {
   298→      const context = createWrapUpContext({
   299→        workingTree: {
   300→          clean: false,
   301→          staged: [],
   302→          unstaged: [],
   303→          untracked: ['temp.log', 'debug.txt', '.DS_Store'],
   304→        },
   305→      });
   306→
   307→      const prompt = buildWrapUpPrompt(context);
   308→
   309→      expect(prompt).toContain('Untracked (3)');
   310→      expect(prompt).toContain('temp.log');
   311→      expect(prompt).toContain('debug.txt');
   312→      expect(prompt).toContain('.DS_Store');
   313→    });
   314→
   315→    // AC: @ralph-wrap-up-agent-on-loop-exit ac-4
   316→    it('lists in-progress tasks', () => {
   317→      const context = createWrapUpContext({
   318→        inProgressTasks: [
   319→          { ref: '@task-feature', title: 'Add new feature' },
   320→          { ref: '@task-bugfix', title: 'Fix critical bug' },
   321→        ],
   322→      });
   323→
   324→      const prompt = buildWrapUpPrompt(context);
   325→
   326→      expect(prompt).toContain('In-progress tasks (2)');
   327→      expect(prompt).toContain('@task-feature: Add new feature');
   328→      expect(prompt).toContain('@task-bugfix: Fix critical bug');
   329→    });
   330→
   331→    it('lists pending review tasks', () => {
   332→      const context = createWrapUpContext({
   333→        pendingReviewTasks: [{ ref: '@task-review', title: 'Pending PR merge' }],
   334→      });
   335→
   336→      const prompt = buildWrapUpPrompt(context);
   337→
   338→      expect(prompt).toContain('Pending review tasks (1)');
   339→      expect(prompt).toContain('@task-review: Pending PR merge');
   340→    });
   341→
   342→    it('lists recent task refs', () => {
   343→      const context = createWrapUpContext({
   344→        recentTaskRefs: ['@task-1', '@task-2', '@task-3'],
   345→      });
   346→
   347→      const prompt = buildWrapUpPrompt(context);
   348→
   349→      expect(prompt).toContain('Recent task refs worked this session');
   350→      expect(prompt).toContain('@task-1');
   351→      expect(prompt).toContain('@task-2');
   352→      expect(prompt).toContain('@task-3');
   353→    });
   354→
   355→    // AC: @ralph-wrap-up-agent-on-loop-exit ac-3
   356→    it('includes instructions for handling uncommitted changes', () => {
   357→      const context = createWrapUpContext({
   358→        workingTree: createDirtyWorkingTree(),
   359→      });
   360→
   361→      const prompt = buildWrapUpPrompt(context);
   362→
   363→      expect(prompt).toContain('Handle Uncommitted Changes');
   364→      expect(prompt).toContain('commit');
   365→      expect(prompt).toContain('stash');
   366→      expect(prompt).toContain('CRITICAL');
   367→      expect(prompt).toContain('Do NOT discard any work');
   368→    });
   369→
   370→    // AC: @ralph-wrap-up-agent-on-loop-exit ac-4
   371→    it('includes instructions for exit summary', () => {
   372→      const context = createWrapUpContext();
   373→
   374→      const prompt = buildWrapUpPrompt(context);
   375→
   376→      expect(prompt).toContain('Exit Summary');
   377→      expect(prompt).toContain('RALPH SESSION EXIT SUMMARY');
   378→      expect(prompt).toContain('Changes handled');
   379→      expect(prompt).toContain('Human attention needed');
   380→    });
   381→
   382→    // AC: @ralph-wrap-up-agent-on-loop-exit ac-5
   383→    it('includes timeout warning in prompt', () => {
   384→      const context = createWrapUpContext();
   385→
   386→      const prompt = buildWrapUpPrompt(context);
   387→
   388→      expect(prompt).toContain('2 minutes');
   389→      expect(prompt).toContain('Timeout Warning');
   390→      expect(prompt).toContain('prioritize');
   391→    });
   392→
   393→    it('instructs to exit after cleanup', () => {
   394→      const context = createWrapUpContext();
   395→
   396→      const prompt = buildWrapUpPrompt(context);
   397→
   398→      expect(prompt).toContain('Exit');
   399→      expect(prompt).toContain('Do not start new work');
   400→    });
   401→  });
   402→
   403→  describe('buildWrapUpContext', () => {
   404→    it('builds context with all required fields', () => {
   405→      // Note: buildWrapUpContext calls getWorkingTreeStatus internally,
   406→      // so we test the structure of the returned context
   407→      const context = buildWrapUpContext(
   408→        'no_tasks',
   409→        '01TESTSESSION',
   410→        5,
   411→        10,
   412→        [{ ref: '@task-1', title: 'Task 1' }],
   413→        [{ ref: '@task-2', title: 'Task 2' }],
   414→        ['@task-1', '@task-2'],
   415→        process.cwd(),
   416→        undefined
   417→      );
   418→
   419→      expect(context.exitReason).toBe('no_tasks');
   420→      expect(context.sessionId).toBe('01TESTSESSION');
   421→      expect(context.iteration).toBe(5);
   422→      expect(context.maxIterations).toBe(10);
   423→      expect(context.inProgressTasks).toHaveLength(1);
   424→      expect(context.pendingReviewTasks).toHaveLength(1);
   425→      expect(context.recentTaskRefs).toHaveLength(2);
   426→      expect(context.workingTree).toBeDefined();
   427→      expect(context.errorMessage).toBeUndefined();
   428→    });
   429→
   430→    it('includes error message when provided', () => {
   431→      const context = buildWrapUpContext(
   432→        'error',
   433→        '01TESTSESSION',
   434→        3,
   435→        10,
   436→        [],
   437→        [],
   438→        [],
   439→        process.cwd(),
   440→        'Connection failed'
   441→      );
   442→
   443→      expect(context.exitReason).toBe('error');
   444→      expect(context.errorMessage).toBe('Connection failed');
   445→    });
   446→  });
   447→
   448→  describe('ExitReason type coverage', () => {
   449→    // Verify all exit reasons are handled in prompt
   450→    const exitReasons: ExitReason[] = [
   451→      'no_tasks',
   452→      'end_loop_signal',
   453→      'max_iterations',
   454→      'error',
   455→      'max_failures',
   456→      'explicit_tasks_done',
   457→    ];
   458→
   459→    for (const reason of exitReasons) {
   460→      it(`handles exit reason: ${reason}`, () => {
   461→        const context = createWrapUpContext({
   462→          exitReason: reason,
   463→          errorMessage: reason === 'error' ? 'Test error' : undefined,
   464→        });
   465→
   466→        const prompt = buildWrapUpPrompt(context);
   467→
   468→        // Each exit reason should have a description in the prompt
   469→        expect(prompt).toContain('Exit Reason');
   470→        expect(prompt.length).toBeGreaterThan(500); // Ensure substantial prompt
   471→      });
   472→    }
   473→  });
   474→});
