     1→import chalk from "chalk";
     2→import { stringify as yamlStringify } from "yaml";
     3→import type { ReferenceIndex } from "../parser/index.js";
     4→import type { Note, Task, TaskStatus } from "../schema/index.js";
     5→import { fieldLabels, sectionHeaders, summaries } from "../strings/labels.js";
     6→import { formatMatchedFields, grepItem } from "../utils/grep.js";
     7→
     8→/**
     9→ * Check if a note has been superseded by another note.
    10→ * A note is superseded if its ULID appears in any other note's `supersedes` field.
    11→ */
    12→export function isNoteSuperseded(note: Note, allNotes: Note[]): boolean {
    13→  return allNotes.some((n) => n.supersedes === note._ulid);
    14→}
    15→
    16→/**
    17→ * Filter notes to exclude superseded ones.
    18→ * Returns only notes that have not been superseded.
    19→ */
    20→export function filterSupersededNotes(notes: Note[]): Note[] {
    21→  return notes.filter((note) => !isNoteSuperseded(note, notes));
    22→}
    23→
    24→/**
    25→ * Annotate notes with superseded status for JSON output.
    26→ * Adds a computed `superseded` field to each note.
    27→ */
    28→export function annotateNotesWithSuperseded(
    29→  notes: Note[],
    30→): Array<Note & { superseded: boolean }> {
    31→  return notes.map((note) => ({
    32→    ...note,
    33→    superseded: isNoteSuperseded(note, notes),
    34→  }));
    35→}
    36→
    37→/**
    38→ * Output options
    39→ */
    40→export interface OutputOptions {
    41→  json?: boolean;
    42→}
    43→
    44→/**
    45→ * Output format types
    46→ * AC: @output-format-option
    47→ */
    48→export type OutputFormat = "text" | "json" | "yaml";
    49→
    50→/**
    51→ * Valid format values for --format option
    52→ */
    53→export const VALID_FORMATS = ["json", "yaml"] as const;
    54→
    55→/**
    56→ * Global output format (set by --json, --yaml, --raw, or --format flags)
    57→ * AC: @output-format-option ac-format-json, ac-format-yaml
    58→ */
    59→let globalOutputFormat: OutputFormat = "text";
    60→
    61→export function setOutputFormat(format: OutputFormat): void {
    62→  globalOutputFormat = format;
    63→}
    64→
    65→export function getOutputFormat(): OutputFormat {
    66→  return globalOutputFormat;
    67→}
    68→
    69→/**
    70→ * Set JSON mode (for backward compatibility)
    71→ * AC: @output-format-option ac-json-shorthand
    72→ */
    73→export function setJsonMode(enabled: boolean): void {
    74→  if (enabled) {
    75→    globalOutputFormat = "json";
    76→  } else if (globalOutputFormat === "json") {
    77→    globalOutputFormat = "text";
    78→  }
    79→}
    80→
    81→/**
    82→ * Check if JSON mode is active
    83→ * AC: @output-format-option ac-json-shorthand
    84→ */
    85→export function isJsonMode(): boolean {
    86→  return globalOutputFormat === "json";
    87→}
    88→
    89→/**
    90→ * Set YAML mode
    91→ * AC: @output-format-option ac-format-yaml, ac-yaml-shorthand
    92→ */
    93→export function setYamlMode(enabled: boolean): void {
    94→  if (enabled) {
    95→    globalOutputFormat = "yaml";
    96→  } else if (globalOutputFormat === "yaml") {
    97→    globalOutputFormat = "text";
    98→  }
    99→}
   100→
   101→/**
   102→ * Check if YAML mode is active
   103→ * AC: @output-format-option ac-format-yaml
   104→ */
   105→export function isYamlMode(): boolean {
   106→  return globalOutputFormat === "yaml";
   107→}
   108→
   109→/**
   110→ * Check if any structured output mode is active (JSON or YAML)
   111→ * AC: @output-format-option ac-yaml-no-ansi, ac-yaml-references
   112→ */
   113→export function isStructuredMode(): boolean {
   114→  return globalOutputFormat === "json" || globalOutputFormat === "yaml";
   115→}
   116→
   117→/**
   118→ * Global verbose mode (set by --verbose flag)
   119→ */
   120→let globalVerboseMode = false;
   121→
   122→export function setVerboseMode(enabled: boolean): void {
   123→  globalVerboseMode = enabled;
   124→}
   125→
   126→export function getVerboseMode(): boolean {
   127→  return globalVerboseMode;
   128→}
   129→
   130→/**
   131→ * Output data - JSON/YAML if structured mode, otherwise formatted
   132→ * AC: @output-format-option ac-format-json, ac-format-yaml
   133→ */
   134→export function output(data: unknown, formatter?: () => void): void {
   135→  if (globalOutputFormat === "json") {
   136→    console.log(JSON.stringify(data, null, 2));
   137→  } else if (globalOutputFormat === "yaml") {
   138→    console.log(yamlStringify(data, { indent: 2 }));
   139→  } else if (formatter) {
   140→    formatter();
   141→  } else {
   142→    console.log(data);
   143→  }
   144→}
   145→
   146→/**
   147→ * Output success message
   148→ * AC: @output-format-option ac-format-json, ac-format-yaml
   149→ */
   150→export function success(message: string, data?: Record<string, unknown>): void {
   151→  if (globalOutputFormat === "json") {
   152→    console.log(JSON.stringify({ success: true, message, ...data }));
   153→  } else if (globalOutputFormat === "yaml") {
   154→    console.log(yamlStringify({ success: true, message, ...data }, { indent: 2 }));
   155→  } else {
   156→    console.log(chalk.green("OK"), message);
   157→  }
   158→}
   159→
   160→/**
   161→ * Output error message
   162→ * AC: @output-format-option ac-format-json, ac-format-yaml
   163→ */
   164→export function error(message: string, details?: unknown): void {
   165→  if (globalOutputFormat === "json") {
   166→    console.error(JSON.stringify({ success: false, error: message, details }));
   167→  } else if (globalOutputFormat === "yaml") {
   168→    console.error(yamlStringify({ success: false, error: message, details }, { indent: 2 }));
   169→  } else {
   170→    console.error(chalk.red("✗"), message);
   171→    if (details) {
   172→      console.error(chalk.gray(String(details)));
   173→      // Show suggestion if it's a ShadowError with a suggestion
   174→      if (details && typeof details === "object" && "suggestion" in details) {
   175→        const suggestion = (details as { suggestion?: string }).suggestion;
   176→        if (suggestion) {
   177→          console.error(chalk.yellow("  Suggestion:"), suggestion);
   178→        }
   179→      }
   180→    }
   181→  }
   182→}
   183→
   184→/**
   185→ * Output warning message
   186→ * AC: @output-format-option ac-yaml-no-ansi
   187→ */
   188→export function warn(message: string): void {
   189→  if (isStructuredMode()) {
   190→    // Route warnings to stderr in structured output modes to keep stdout pure
   191→    console.error(chalk.yellow("⚠"), message);
   192→  } else {
   193→    console.warn(chalk.yellow("⚠"), message);
   194→  }
   195→}
   196→
   197→/**
   198→ * Output info message
   199→ * AC: @output-format-option ac-yaml-no-ansi
   200→ */
   201→export function info(message: string): void {
   202→  if (isStructuredMode()) {
   203→    // Route info to stderr in structured output modes to keep stdout pure
   204→    console.error(chalk.blue("ℹ"), message);
   205→  } else {
   206→    console.log(chalk.blue("ℹ"), message);
   207→  }
   208→}
   209→
   210→/**
   211→ * Get color for task status
   212→ */
   213→function statusColor(status: TaskStatus): (text: string) => string {
   214→  switch (status) {
   215→    case "pending":
   216→      return (t: string) => chalk.gray(t);
   217→    case "in_progress":
   218→      return (t: string) => chalk.blue(t);
   219→    case "blocked":
   220→      return (t: string) => chalk.red(t);
   221→    case "completed":
   222→      return (t: string) => chalk.green(t);
   223→    case "cancelled":
   224→      return (t: string) => chalk.strikethrough.gray(t);
   225→    default:
   226→      return (t: string) => chalk.white(t);
   227→  }
   228→}
   229→
   230→/**
   231→ * Format a task reference (short ULID + slug if available)
   232→ * @param task The task to format
   233→ * @param index Optional ReferenceIndex for dynamic short ULID computation
   234→ */
   235→export function formatTaskRef(task: Task, index?: ReferenceIndex): string {
   236→  const shortId = index ? index.shortUlid(task._ulid) : task._ulid.slice(0, 8);
   237→  if (task.slugs.length > 0) {
   238→    return `${shortId} (${task.slugs[0]})`;
   239→  }
   240→  return shortId;
   241→}
   242→
   243→/**
   244→ * Format task for display
   245→ */
   246→export function formatTask(
   247→  task: Task,
   248→  verbose = false,
   249→  index?: ReferenceIndex,
   250→  full = false,
   251→): string {
   252→  const ref = formatTaskRef(task, index);
   253→  const status = statusColor(task.status)(`[${task.status}]`);
   254→  const priority =
   255→    task.priority <= 2
   256→      ? chalk.red(`P${task.priority}`)
   257→      : chalk.gray(`P${task.priority}`);
   258→
   259→  let line = `${ref} ${status} ${priority} ${task.title}`;
   260→
   261→  if (verbose && !full) {
   262→    // AC: @task-list-verbose ac-2 - Single verbose (-v) shows current behavior
   263→    if (task.spec_ref) {
   264→      line += chalk.gray(` (spec: ${task.spec_ref})`);
   265→    }
   266→    if (task.depends_on.length > 0) {
   267→      line += chalk.gray(` deps: [${task.depends_on.join(", ")}]`);
   268→    }
   269→    if (task.tags.length > 0) {
   270→      line += chalk.cyan(` #${task.tags.join(" #")}`);
   271→    }
   272→  }
   273→
   274→  return line;
   275→}
   276→
   277→/**
   278→ * Get first line of text, truncated to max length
   279→ */
   280→function getFirstLine(
   281→  text: string | undefined,
   282→  maxLength: number = 70,
   283→): string | undefined {
   284→  if (!text) return undefined;
   285→  const firstLine = text.split("\n")[0].trim();
   286→  if (firstLine.length <= maxLength) return firstLine;
   287→  return `${firstLine.slice(0, maxLength - 3)}...`;
   288→}
   289→
   290→/**
   291→ * Format full mode context for a task (AC-1, AC-3, AC-5)
   292→ */
   293→function formatFullModeContext(task: Task, index?: ReferenceIndex): void {
   294→  const indent = "    ";
   295→
   296→  // Show timestamps (AC-1)
   297→  console.log(chalk.gray(`${indent}Created: ${task.created_at}`));
   298→  if (task.started_at) {
   299→    console.log(chalk.gray(`${indent}Started: ${task.started_at}`));
   300→  }
   301→  if (task.completed_at) {
   302→    console.log(chalk.gray(`${indent}Completed: ${task.completed_at}`));
   303→  }
   304→
   305→  // Show notes count and most recent note (AC-1, AC-3)
   306→  if (task.notes && task.notes.length > 0) {
   307→    const mostRecent = task.notes[task.notes.length - 1];
   308→    const preview = getFirstLine(mostRecent.content, 50);
   309→    console.log(
   310→      chalk.gray(`${indent}Notes: ${task.notes.length} (latest: "${preview}")`),
   311→    );
   312→  }
   313→
   314→  // Show pending todos count (AC-1, AC-3)
   315→  if (task.todos && task.todos.length > 0) {
   316→    const pendingCount = task.todos.filter((t) => !t.done).length;
   317→    if (pendingCount > 0) {
   318→      console.log(chalk.gray(`${indent}Pending todos: ${pendingCount}`));
   319→    }
   320→  }
   321→
   322→  // Show spec context (AC-5)
   323→  if (task.spec_ref && index) {
   324→    const result = index.resolve(task.spec_ref);
   325→    if (result.ok) {
   326→      const spec = result.item;
   327→      const specName =
   328→        "title" in spec
   329→          ? spec.title
   330→          : "name" in spec
   331→            ? spec.name
   332→            : "id" in spec
   333→              ? spec.id
   334→              : task.spec_ref;
   335→      console.log(chalk.gray(`${indent}Spec: ${task.spec_ref}`));
   336→      console.log(chalk.cyan(`${indent}  ${specName}`));
   337→
   338→      // Show spec description if available
   339→      if ("description" in spec && spec.description) {
   340→        const descPreview = getFirstLine(spec.description as string, 70);
   341→        console.log(chalk.gray(`${indent}  ${descPreview}`));
   342→      }
   343→
   344→      // Show acceptance criteria if available
   345→      if (
   346→        "acceptance_criteria" in spec &&
   347→        Array.isArray(spec.acceptance_criteria)
   348→      ) {
   349→        const ac = spec.acceptance_criteria;
   350→        if (ac.length > 0) {
   351→          console.log(
   352→            chalk.gray(`${indent}  Acceptance Criteria: ${ac.length}`),
   353→          );
   354→          // Show first AC as preview
   355→          const firstAC = ac[0];
   356→          if (
   357→            typeof firstAC === "object" &&
   358→            firstAC !== null &&
   359→            "id" in firstAC
   360→          ) {
   361→            console.log(
   362→              chalk.gray(`${indent}    [${firstAC.id}] ${firstAC.then}`),
   363→            );
   364→          }
   365→        }
   366→      }
   367→    }
   368→  }
   369→
   370→  // Show tags and dependencies if present
   371→  if (task.tags && task.tags.length > 0) {
   372→    console.log(chalk.gray(`${indent}Tags: ${task.tags.join(", ")}`));
   373→  }
   374→  if (task.depends_on && task.depends_on.length > 0) {
   375→    console.log(
   376→      chalk.gray(`${indent}Depends on: ${task.depends_on.join(", ")}`),
   377→    );
   378→  }
   379→}
   380→
   381→/**
   382→ * Format automation status as a colored label
   383→ * AC: @task-automation-eligibility ac-14
   384→ */
   385→function formatAutomationStatus(automation: string | undefined): string {
   386→  if (!automation) {
   387→    return chalk.gray("[unassessed]");
   388→  }
   389→  switch (automation) {
   390→    case "eligible":
   391→      return chalk.green("[eligible]");
   392→    case "needs_review":
   393→      return chalk.yellow("[needs_review]");
   394→    case "manual_only":
   395→      return chalk.red("[manual_only]");
   396→    default:
   397→      return chalk.gray(`[${automation}]`);
   398→  }
   399→}
   400→
   401→/**
   402→ * Format a list of tasks with automation status
   403→ * AC: @task-automation-eligibility ac-14
   404→ */
   405→export function formatTaskListWithAutomation(
   406→  tasks: Task[],
   407→  verbose = false,
   408→  index?: ReferenceIndex,
   409→  grepPattern?: string,
   410→  full = false,
   411→): void {
   412→  if (tasks.length === 0) {
   413→    console.log(summaries.noTasks);
   414→    return;
   415→  }
   416→
   417→  for (const task of tasks) {
   418→    const ref = formatTaskRef(task, index);
   419→    const status = statusColor(task.status)(`[${task.status}]`);
   420→    const priority =
   421→      task.priority <= 2
   422→        ? chalk.red(`P${task.priority}`)
   423→        : chalk.gray(`P${task.priority}`);
   424→    const automationLabel = formatAutomationStatus(task.automation);
   425→
   426→    let line = `${ref} ${status} ${priority} ${automationLabel} ${task.title}`;
   427→
   428→    if (verbose && !full) {
   429→      if (task.spec_ref) {
   430→        line += chalk.gray(` (spec: ${task.spec_ref})`);
   431→      }
   432→      if (task.depends_on.length > 0) {
   433→        line += chalk.gray(` deps: [${task.depends_on.join(", ")}]`);
   434→      }
   435→      if (task.tags.length > 0) {
   436→        line += chalk.cyan(` #${task.tags.join(" #")}`);
   437→      }
   438→    }
   439→
   440→    console.log(line);
   441→
   442→    // Show matched fields if grep pattern provided
   443→    if (grepPattern) {
   444→      const match = grepItem(
   445→        task as unknown as Record<string, unknown>,
   446→        grepPattern,
   447→      );
   448→      if (match && match.matchedFields.length > 0) {
   449→        console.log(
   450→          chalk.gray(
   451→            `    matched: ${formatMatchedFields(match.matchedFields)}`,
   452→          ),
   453→        );
   454→      }
   455→    } else if (full) {
   456→      formatFullModeContext(task, index);
   457→    } else {
   458→      // Show context line: first line of description (if present)
   459→      const context = getFirstLine(task.description);
   460→      if (context) {
   461→        console.log(chalk.gray(`    ${context}`));
   462→      }
   463→    }
   464→  }
   465→
   466→  console.log(summaries.taskCount(tasks.length));
   467→}
   468→
   469→/**
   470→ * Format a list of tasks
   471→ */
   472→export function formatTaskList(
   473→  tasks: Task[],
   474→  verbose = false,
   475→  index?: ReferenceIndex,
   476→  grepPattern?: string,
   477→  full = false,
   478→): void {
   479→  if (tasks.length === 0) {
   480→    console.log(summaries.noTasks);
   481→    return;
   482→  }
   483→
   484→  for (const task of tasks) {
   485→    console.log(formatTask(task, verbose, index, full));
   486→
   487→    // Show matched fields if grep pattern provided
   488→    if (grepPattern) {
   489→      const match = grepItem(
   490→        task as unknown as Record<string, unknown>,
   491→        grepPattern,
   492→      );
   493→      if (match && match.matchedFields.length > 0) {
   494→        console.log(
   495→          chalk.gray(
   496→            `    matched: ${formatMatchedFields(match.matchedFields)}`,
   497→          ),
   498→        );
   499→      }
   500→    } else if (full) {
   501→      // AC: @task-list-verbose ac-1 - Full mode shows richer context
   502→      formatFullModeContext(task, index);
   503→    } else {
   504→      // Show context line: first line of description (if present)
   505→      const context = getFirstLine(task.description);
   506→      if (context) {
   507→        console.log(chalk.gray(`    ${context}`));
   508→      }
   509→    }
   510→  }
   511→
   512→  console.log(summaries.taskCount(tasks.length));
   513→}
   514→
   515→export interface FormatTaskDetailsOptions {
   516→  /** Show all notes including superseded ones (default: false) */
   517→  showAllNotes?: boolean;
   518→}
   519→
   520→/**
   521→ * Format task details
   522→ */
   523→export function formatTaskDetails(
   524→  task: Task,
   525→  index?: ReferenceIndex,
   526→  options: FormatTaskDetailsOptions = {},
   527→): void {
   528→  console.log(chalk.bold(task.title));
   529→  console.log(chalk.gray("─".repeat(40)));
   530→  console.log(`${fieldLabels.ulid}      ${task._ulid}`);
   531→  if (task.slugs.length > 0) {
   532→    console.log(`${fieldLabels.slugs}     ${task.slugs.join(", ")}`);
   533→  }
   534→  console.log(`${fieldLabels.type}      ${task.type}`);
   535→  console.log(
   536→    `${fieldLabels.status}    ${statusColor(task.status)(task.status)}`,
   537→  );
   538→  console.log(`${fieldLabels.priority}  ${task.priority}`);
   539→
   540→  // AC: @task-automation-eligibility ac-17 - show automation status
   541→  const automationDisplay = task.automation || "unassessed";
   542→  const automationColor =
   543→    task.automation === "eligible"
   544→      ? chalk.green
   545→      : task.automation === "needs_review"
   546→        ? chalk.yellow
   547→        : task.automation === "manual_only"
   548→          ? chalk.red
   549→          : chalk.gray;
   550→  console.log(
   551→    `${fieldLabels.automation} ${automationColor(automationDisplay)}`,
   552→  );
   553→
   554→  if (task.description?.trim()) {
   555→    console.log(`\n${sectionHeaders.description}`);
   556→    const desc = task.description.trim();
   557→    for (const line of desc.split("\n")) {
   558→      console.log(`  ${line}`);
   559→    }
   560→  }
   561→
   562→  if (task.spec_ref) {
   563→    console.log(`${fieldLabels.specRef}  ${task.spec_ref}`);
   564→  }
   565→
   566→  // AC: @plan-derive ac-6 - display plan_ref
   567→  if (task.plan_ref) {
   568→    console.log(`Plan ref:  ${task.plan_ref}`);
   569→  }
   570→
   571→  if (task.depends_on.length > 0) {
   572→    if (index) {
   573→      console.log(fieldLabels.depends);
   574→      for (const ref of task.depends_on) {
   575→        const result = index.resolve(ref);
   576→        if (result.ok) {
   577→          const item = result.item;
   578→          const status =
   579→            "status" in item && typeof item.status === "string"
   580→              ? statusColor(item.status as TaskStatus)(`[${item.status}]`)
   581→              : chalk.gray("[spec]");
   582→          // Handle both spec items (with title) and meta items (with name or id)
   583→          const itemName =
   584→            "title" in item
   585→              ? item.title
   586→              : "name" in item
   587→                ? item.name
   588→                : "id" in item
   589→                  ? item.id
   590→                  : ref;
   591→          console.log(`  ${ref} ${chalk.gray("→")} ${itemName} ${status}`);
   592→        } else {
   593→          console.log(`  ${ref} ${chalk.red("(unresolved)")}`);
   594→        }
   595→      }
   596→    } else {
   597→      console.log(`${fieldLabels.depends}   ${task.depends_on.join(", ")}`);
   598→    }
   599→  }
   600→
   601→  if (task.blocked_by.length > 0) {
   602→    console.log(
   603→      chalk.red(`${fieldLabels.blocked}   ${task.blocked_by.join(", ")}`),
   604→    );
   605→  }
   606→
   607→  if (task.tags.length > 0) {
   608→    console.log(`${fieldLabels.tags}      ${task.tags.join(", ")}`);
   609→  }
   610→
   611→  console.log(`${fieldLabels.created}   ${task.created_at}`);
   612→  if (task.started_at) {
   613→    console.log(`${fieldLabels.started}   ${task.started_at}`);
   614→  }
   615→  if (task.completed_at) {
   616→    console.log(`${fieldLabels.completed} ${task.completed_at}`);
   617→  }
   618→
   619→  // Show resolved spec information
   620→  if (task.spec_ref && index) {
   621→    const result = index.resolve(task.spec_ref);
   622→    if (result.ok) {
   623→      const spec = result.item;
   624→      console.log(`\n${sectionHeaders.specContext}`);
   625→      // Handle both spec items (with title) and meta items (with name)
   626→      const specName =
   627→        "title" in spec
   628→          ? spec.title
   629→          : "name" in spec
   630→            ? spec.name
   631→            : "id" in spec
   632→              ? spec.id
   633→              : task.spec_ref;
   634→      console.log(chalk.cyan(specName));
   635→      if ("type" in spec && spec.type) {
   636→        console.log(chalk.gray(`${fieldLabels.type} ${spec.type}`));
   637→      }
   638→      // Show implementation status
   639→      if ("status" in spec && spec.status && typeof spec.status === "object") {
   640→        const status = spec.status as {
   641→          maturity?: string;
   642→          implementation?: string;
   643→        };
   644→        if (status.implementation) {
   645→          const implColor =
   646→            status.implementation === "verified"
   647→              ? chalk.green
   648→              : status.implementation === "implemented"
   649→                ? chalk.cyan
   650→                : status.implementation === "in_progress"
   651→                  ? chalk.yellow
   652→                  : chalk.gray;
   653→          console.log(
   654→            chalk.gray(fieldLabels.implementation) +
   655→              implColor(status.implementation),
   656→          );
   657→        }
   658→      }
   659→      if ("description" in spec && spec.description) {
   660→        console.log(chalk.gray(fieldLabels.description));
   661→        // Indent description lines
   662→        const desc = String(spec.description).trim();
   663→        for (const line of desc.split("\n")) {
   664→          console.log(chalk.gray(`  ${line}`));
   665→        }
   666→      }
   667→      if (
   668→        "acceptance_criteria" in spec &&
   669→        Array.isArray(spec.acceptance_criteria) &&
   670→        spec.acceptance_criteria.length > 0
   671→      ) {
   672→        console.log(chalk.gray(fieldLabels.acceptanceCriteria));
   673→        for (const ac of spec.acceptance_criteria) {
   674→          if (ac && typeof ac === "object" && "id" in ac) {
   675→            const acObj = ac as {
   676→              id: string;
   677→              given?: string;
   678→              when?: string;
   679→              then?: string;
   680→            };
   681→            console.log(chalk.gray(`  [${acObj.id}]`));
   682→            if (acObj.given)
   683→              console.log(chalk.gray(`    Given: ${acObj.given}`));
   684→            if (acObj.when) console.log(chalk.gray(`    When: ${acObj.when}`));
   685→            if (acObj.then) console.log(chalk.gray(`    Then: ${acObj.then}`));
   686→          }
   687→        }
   688→      }
   689→      // Show traceability if present
   690→      if (
   691→        "traceability" in spec &&
   692→        spec.traceability &&
   693→        typeof spec.traceability === "object"
   694→      ) {
   695→        const trace = spec.traceability as {
   696→          implementation?: Array<{
   697→            path: string;
   698→            function?: string;
   699→            lines?: string;
   700→          }>;
   701→          tests?: Array<{ path: string }>;
   702→          commits?: string[];
   703→          issues?: string[];
   704→        };
   705→        const hasTrace =
   706→          trace.implementation?.length ||
   707→          trace.tests?.length ||
   708→          trace.commits?.length ||
   709→          trace.issues?.length;
   710→        if (hasTrace) {
   711→          console.log(chalk.gray(fieldLabels.traceability));
   712→          if (trace.implementation?.length) {
   713→            for (const impl of trace.implementation) {
   714→              let loc = `  Code: ${impl.path}`;
   715→              if (impl.function) loc += `::${impl.function}`;
   716→              if (impl.lines) loc += `:${impl.lines}`;
   717→              console.log(chalk.gray(loc));
   718→            }
   719→          }
   720→          if (trace.tests?.length) {
   721→            for (const test of trace.tests) {
   722→              console.log(chalk.gray(`  Test: ${test.path}`));
   723→            }
   724→          }
   725→          if (trace.commits?.length) {
   726→            console.log(chalk.gray(`  Commits: ${trace.commits.join(", ")}`));
   727→          }
   728→          if (trace.issues?.length) {
   729→            console.log(chalk.gray(`  Issues: ${trace.issues.join(", ")}`));
   730→          }
   731→        }
   732→      }
   733→    }
   734→  }
   735→
   736→  if (task.notes.length > 0) {
   737→    // Filter superseded notes unless showAllNotes is true
   738→    const notesToShow = options.showAllNotes
   739→      ? task.notes
   740→      : filterSupersededNotes(task.notes);
   741→    const hiddenCount = task.notes.length - notesToShow.length;
   742→
   743→    console.log(`\n${sectionHeaders.notes}`);
   744→    for (const note of notesToShow) {
   745→      const author = note.author || "unknown";
   746→      // Mark if this note supersedes another
   747→      const supersededLabel = note.supersedes ? chalk.gray(" (supersedes earlier note)") : "";
   748→      console.log(chalk.gray(`[${note.created_at}] ${author}:`) + supersededLabel);
   749→      console.log(note.content);
   750→    }
   751→
   752→    // Show count of hidden notes if any
   753→    if (hiddenCount > 0) {
   754→      console.log(chalk.gray(`\n(${hiddenCount} superseded note${hiddenCount > 1 ? "s" : ""} hidden - use --all to show)`));
   755→    }
   756→  }
   757→
   758→  if (task.todos.length > 0) {
   759→    console.log(`\n${sectionHeaders.todos}`);
   760→    for (const todo of task.todos) {
   761→      const check = todo.done ? chalk.green("✓") : chalk.gray("○");
   762→      const text = todo.done ? chalk.strikethrough.gray(todo.text) : todo.text;
   763→      console.log(`${check} [${todo.id}] ${text}`);
   764→    }
   765→  }
   766→}
   767→