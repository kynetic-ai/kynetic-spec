    66→
    67→// ─── Types ───────────────────────────────────────────────────────────────────
    68→
    69→export interface CheckpointResult {
    70→  /** Whether session can end cleanly */
    71→  ok: boolean;
    72→
    73→  /** Human-readable message for Claude Code */
    74→  message: string;
    75→
    76→  /** Issues that need attention before stopping */
    77→  issues: CheckpointIssue[];
    78→
    79→  /** Instructions for the agent */
    80→  instructions: string[];
    81→}
    82→
    83→export interface CheckpointIssue {
    84→  type: "uncommitted_changes" | "in_progress_task" | "incomplete_todo";
    85→  description: string;
    86→  details?: Record<string, unknown>;
    87→}
    88→
    89→export interface SessionContext {
    90→  /** When this context was generated */
    91→  generated_at: string;
    92→
    93→  /** Current git branch */
    94→  branch: string | null;
    95→
    96→  /** Session context (focus, threads, questions) */
    97→  context: StoredSessionContext | null;
    98→
    99→  /** Tasks currently in progress */
   100→  active_tasks: ActiveTaskSummary[];
   101→
   102→  /** Tasks awaiting review (code done, PR pending) */
   103→  pending_review_tasks: ActiveTaskSummary[];
   104→
   105→  /** Recent notes from active tasks */
   106→  recent_notes: NoteSummary[];
   107→
   108→  /** Incomplete todos from active tasks */
   109→  active_todos: TodoSummary[];
   110→
   111→  /** Tasks ready to be picked up */
   112→  ready_tasks: ReadyTaskSummary[];
   113→
   114→  /** Blocked tasks with blockers */
   115→  blocked_tasks: BlockedTaskSummary[];
   116→
   117→  /** Recently completed tasks */
   118→  recently_completed: CompletedTaskSummary[];
   119→
   120→  /** Recent git commits */
   121→  recent_commits: CommitSummary[];
   122→
   123→  /** Working tree status */
   124→  working_tree: GitWorkingTree | null;
   125→
   126→  /** Inbox items awaiting triage (oldest first) */
   127→  inbox_items: InboxSummary[];
   128→
   129→  /** Summary statistics */
   130→  stats: SessionStats;
   131→}
   132→
   133→export interface ActiveTaskSummary {
   134→  ref: string;
   135→  title: string;
   136→  started_at: string | null;
   137→  priority: number;
   138→  spec_ref: string | null;
   139→  note_count: number;
   140→  last_note_at: string | null;
   141→  todo_count: number;
   142→  incomplete_todos: number;
   143→}
   144→
   145→export interface NoteSummary {
   146→  task_ref: string;
   147→  task_title: string;
   148→  task_status: "in_progress" | "pending_review" | "needs_work" | "completed";
   149→  note_ulid: string;
   150→  created_at: string;
   151→  author: string | null;
   152→  content: string;
   153→}
   154→
   155→export interface TodoSummary {
   156→  task_ref: string;
   157→  task_title: string;
   158→  id: number;
   159→  text: string;
   160→  added_at: string;
   161→  added_by: string | null;
   162→}
   163→
   164→export interface ReadyTaskSummary {
   165→  ref: string;
   166→  title: string;
   167→  priority: number;
   168→  spec_ref: string | null;
   169→  tags: string[];
   170→}
   171→
   172→export interface BlockedTaskSummary {
   173→  ref: string;
   174→  title: string;
   175→  blocked_by: string[];
   176→  unmet_deps: string[];
   177→}
   178→
   179→export interface CompletedTaskSummary {
   180→  ref: string;
   181→  title: string;
   182→  completed_at: string;
   183→  closed_reason: string | null;
   184→  origin?: "manual" | "derived" | "observation_promotion";
   185→}
   186→
   187→export interface CommitSummary {
   188→  hash: string;
   189→  full_hash: string;
   190→  date: string;
   191→  message: string;
   192→  author: string;
   193→}
   194→
   195→export interface SessionStats {
   196→  total_tasks: number;
   197→  in_progress: number;
   198→  needs_work: number;
   199→  pending_review: number;
   200→  ready: number;
   201→  blocked: number;
   202→  completed: number;
   203→  inbox_items: number;
   204→}
   205→
   206→export interface InboxSummary {
   207→  ref: string;
   208→  text: string;
   209→  created_at: string;
   210→  tags: string[];
   211→  added_by: string | null;
   212→}
   213→
   214→export interface SessionOptions {
   215→  brief?: boolean;
   216→  full?: boolean;
   217→  since?: string;
   218→  git?: boolean;
   219→  limit?: string;
   220→  eligible?: boolean; // Only include automation-eligible tasks in ready_tasks
   221→}
   222→
   223→// ─── Data Gathering ──────────────────────────────────────────────────────────
   224→
   225→function toActiveTaskSummary(
   226→  task: LoadedTask,
   227→  index: ReferenceIndex,
   228→): ActiveTaskSummary {
   229→  const lastNote =
   230→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   231→  const incompleteTodos = task.todos.filter((t) => !t.done).length;
   232→  return {
   233→    ref: index.shortUlid(task._ulid),
   234→    title: task.title,
   235→    started_at: task.started_at || null,
   236→    priority: task.priority,
   237→    spec_ref: task.spec_ref || null,
   238→    note_count: task.notes.length,
   239→    last_note_at: lastNote ? lastNote.created_at : null,
   240→    todo_count: task.todos.length,
   241→    incomplete_todos: incompleteTodos,
   242→  };
   243→}
   244→
   245→function toReadyTaskSummary(
   246→  task: LoadedTask,
   247→  index: ReferenceIndex,
   248→): ReadyTaskSummary {
   249→  return {
   250→    ref: index.shortUlid(task._ulid),
   251→    title: task.title,
   252→    priority: task.priority,
   253→    spec_ref: task.spec_ref || null,
   254→    tags: task.tags,
   255→  };
   256→}
   257→
   258→function toBlockedTaskSummary(
   259→  task: LoadedTask,
   260→  _allTasks: LoadedTask[],
   261→  index: ReferenceIndex,
   262→): BlockedTaskSummary {
   263→  // Find unmet dependencies
   264→  const unmetDeps: string[] = [];
   265→  for (const depRef of task.depends_on) {
   266→    const result = index.resolve(depRef);
   267→    if (result.ok) {
   268→      const depItem = result.item;
   269→      if ("status" in depItem && depItem.status !== "completed") {
   270→        unmetDeps.push(depRef);
   271→      }
   272→    }
   273→  }
   274→
   275→  return {
   276→    ref: index.shortUlid(task._ulid),
   277→    title: task.title,
   278→    blocked_by: task.blocked_by,
   279→    unmet_deps: unmetDeps,
   280→  };
   281→}
   282→
   283→function toCompletedTaskSummary(
   284→  task: LoadedTask,
   285→  index: ReferenceIndex,
   286→): CompletedTaskSummary {
   287→  return {
   288→    ref: index.shortUlid(task._ulid),
   289→    title: task.title,
   290→    completed_at: task.completed_at || "",
   291→    closed_reason: task.closed_reason || null,
   292→    origin: task.origin,
   293→  };
   294→}
   295→
   296→function collectRecentNotes(
   297→  tasks: LoadedTask[],
   298→  index: ReferenceIndex,
   299→  options: { limit: number; since: Date | null },
   300→): NoteSummary[] {
   301→  const allNotes: NoteSummary[] = [];
   302→
   303→  for (const task of tasks) {
   304→    // Only include notes from in_progress, pending_review, or completed tasks
   305→    const taskStatus = task.status as "in_progress" | "pending_review" | "needs_work" | "completed";
   306→    if (!["in_progress", "pending_review", "needs_work", "completed"].includes(taskStatus)) {
   307→      continue;
   308→    }
   309→
   310→    for (const note of task.notes) {
   311→      const noteDate = new Date(note.created_at);
   312→
   313→      // Filter by since date if provided
   314→      if (options.since && noteDate < options.since) {
   315→        continue;
   316→      }
   317→
   318→      // Filter out superseded notes
   319→      if (isNoteSuperseded(note, task.notes)) {
   320→        continue;
   321→      }
   322→
   323→      allNotes.push({
   324→        task_ref: index.shortUlid(task._ulid),
   325→        task_title: task.title,
   326→        task_status: taskStatus,
   327→        note_ulid: note._ulid.slice(0, 8),
   328→        created_at: note.created_at,
   329→        author: note.author || null,
   330→        content: note.content,
   331→      });
   332→    }
   333→  }
   334→
   335→  // Sort by date descending, take limit
   336→  return allNotes
   337→    .sort(
   338→      (a, b) =>
   339→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   340→    )
   341→    .slice(0, options.limit);
   342→}
   343→
   344→function collectIncompleteTodos(
   345→  tasks: LoadedTask[],
   346→  index: ReferenceIndex,
   347→  options: { limit: number },
   348→): TodoSummary[] {
   349→  const allTodos: TodoSummary[] = [];
   350→
   351→  for (const task of tasks) {
   352→    for (const todo of task.todos) {
   353→      // Only include incomplete todos
   354→      if (todo.done) continue;
   355→
   356→      allTodos.push({
   357→        task_ref: index.shortUlid(task._ulid),
   358→        task_title: task.title,
   359→        id: todo.id,
   360→        text: todo.text,
   361→        added_at: todo.added_at,
   362→        added_by: todo.added_by || null,
   363→      });
   364→    }
   365→  }
   366→
   367→  // Sort by added_at descending (most recent first), take limit
   368→  return allTodos
   369→    .sort(
   370→      (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime(),
   371→    )
   372→    .slice(0, options.limit);
   373→}
   374→
   375→/**
   376→ * Gather session context data
   377→ */
   378→export async function gatherSessionContext(
   379→  ctx: KspecContext,
   380→  options: SessionOptions,
   381→): Promise<SessionContext> {
   382→  const limit = parseInt(options.limit || "10", 10);
   383→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   384→  const showGit = options.git !== false; // default true
   385→
   386→  // Load all data
   387→  const allTasks = await loadAllTasks(ctx);
   388→  const items = await loadAllItems(ctx);
   389→  const inboxItems = await loadInboxItems(ctx);
   390→  const index = new ReferenceIndex(allTasks, items);
   391→
   392→  // Compute stats
   393→  const stats: SessionStats = {
   394→    total_tasks: allTasks.length,
   395→    in_progress: allTasks.filter((t) => t.status === "in_progress").length,
   396→    needs_work: allTasks.filter((t) => t.status === "needs_work").length,
   397→    pending_review: allTasks.filter((t) => t.status === "pending_review")
   398→      .length,
   399→    ready: getReadyTasks(allTasks).length,
   400→    blocked: allTasks.filter((t) => t.status === "blocked").length,
   401→    completed: allTasks.filter((t) => t.status === "completed").length,
   402→    inbox_items: inboxItems.length,
   403→  };
   404→
   405→  // Get active tasks (in_progress + needs_work, optionally filtered to automation-eligible only)
   406→  // AC: @cli-ralph ac-16
   407→  const activeTasks = allTasks
   408→    .filter((t) => t.status === "in_progress" || t.status === "needs_work")
   409→    .filter((t) => !options.eligible || t.automation === "eligible")
   410→    .sort((a, b) => a.priority - b.priority)
   411→    .slice(0, options.full ? undefined : limit)
   412→    .map((t) => toActiveTaskSummary(t, index));
   413→
   414→  // Get pending review tasks
   415→  const pendingReviewTasks = allTasks
   416→    .filter((t) => t.status === "pending_review")
   417→    .sort((a, b) => a.priority - b.priority)
   418→    .slice(0, options.full ? undefined : limit)
   419→    .map((t) => toActiveTaskSummary(t, index));
   420→
   421→  // Get recent notes from active, pending_review, and recently completed tasks
   422→  // AC: @cmd-session-start ac-1, ac-2
   423→  // Collect notes per-status first to prevent one status from starving others
   424→  const noteLimitPerStatus = options.full ? limit : Math.ceil(limit / 3);
   425→
   426→  const inProgressNotes = collectRecentNotes(
   427→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   428→    index,
   429→    { limit: noteLimitPerStatus, since: sinceDate },
   430→  );
   431→
   432→  const pendingReviewNotes = collectRecentNotes(
   433→    allTasks.filter((t) => t.status === "pending_review"),
   434→    index,
   435→    { limit: noteLimitPerStatus, since: sinceDate },
   436→  );
   437→
   438→  const recentlyCompletedForNotes = allTasks
   439→    .filter((t) => t.status === "completed" && t.completed_at)
   440→    .sort((a, b) => {
   441→      const aDate = new Date(a.completed_at || 0);
   442→      const bDate = new Date(b.completed_at || 0);
   443→      return bDate.getTime() - aDate.getTime();
   444→    })
   445→    .slice(0, 5); // Last 3-5 completed tasks per AC-2
   446→
   447→  const completedNotes = collectRecentNotes(
   448→    recentlyCompletedForNotes,
   449→    index,
   450→    { limit: noteLimitPerStatus, since: sinceDate },
   451→  );
   452→
   453→  // Combine notes from all statuses, preserving representation from each
   454→  const recentNotes = [...inProgressNotes, ...pendingReviewNotes, ...completedNotes]
   455→    .sort(
   456→      (a, b) =>
   457→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   458→    );
   459→
   460→  // Get incomplete todos from active tasks
   461→  const activeTodos = collectIncompleteTodos(
   462→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   463→    index,
   464→    { limit: options.full ? limit * 2 : limit },
   465→  );
   466→
   467→  // Get ready tasks (optionally filtered to automation-eligible only)
   468→  const readyTasks = getReadyTasks(allTasks)
   469→    .filter((t) => !options.eligible || t.automation === "eligible")
   470→    .slice(0, options.full ? undefined : limit)
   471→    .map((t) => toReadyTaskSummary(t, index));
   472→
   473→  // Get blocked tasks
   474→  const blockedTasks = allTasks
   475→    .filter((t) => t.status === "blocked")
   476→    .slice(0, options.full ? undefined : limit)
   477→    .map((t) => toBlockedTaskSummary(t, allTasks, index));
   478→
   479→  // Get recently completed tasks
   480→  const recentlyCompleted = allTasks
   481→    .filter((t) => {
   482→      if (t.status !== "completed" || !t.completed_at) return false;
   483→      const completedDate = new Date(t.completed_at);
   484→      if (sinceDate && completedDate < sinceDate) return false;
   485→      return true;
   486→    })
   487→    .sort((a, b) => {
   488→      // Sort by completed_at descending (most recent first)
   489→      const aDate = new Date(a.completed_at || 0);
   490→      const bDate = new Date(b.completed_at || 0);
   491→      return bDate.getTime() - aDate.getTime();
   492→    })
   493→    .slice(0, options.full ? undefined : limit)
   494→    .map((t) => toCompletedTaskSummary(t, index));
   495→
   496→  // Get git info
   497→  let branch: string | null = null;
   498→  let recentCommits: CommitSummary[] = [];
   499→  let workingTree: GitWorkingTree | null = null;
   500→
   501→  if (showGit && isGitRepo(ctx.rootDir)) {
   502→    branch = getCurrentBranch(ctx.rootDir);
   503→
   504→    const commits = getRecentCommits({
   505→      limit: options.full ? limit * 2 : limit,
   506→      since: sinceDate || undefined,
   507→      cwd: ctx.rootDir,
   508→    });
   509→
   510→    recentCommits = commits.map((c) => ({
   511→      hash: c.hash,
   512→      full_hash: c.fullHash,
   513→      date: c.date.toISOString(),
   514→      message: c.message,
   515→      author: c.author,
   516→    }));
   517→
   518→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   519→  }
   520→
   521→  // Get inbox items (oldest first to encourage triage)
   522→  const inboxSummaries: InboxSummary[] = inboxItems
   523→    .sort(
   524→      (a, b) =>
   525→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   526→    )
   527→    .slice(0, options.full ? undefined : limit)
   528→    .map((item) => ({
   529→      ref: item._ulid.slice(0, 8),
   530→      text: item.text,
   531→      created_at: item.created_at,
   532→      tags: item.tags,
   533→      added_by: item.added_by || null,
   534→    }));
   535→
   536→  // Load session context (focus, threads, questions)
   537→  const sessionContext = await loadSessionContext(ctx);
   538→
   539→  return {
   540→    generated_at: new Date().toISOString(),
   541→    branch,
   542→    context: sessionContext,
   543→    active_tasks: activeTasks,
   544→    pending_review_tasks: pendingReviewTasks,
   545→    recent_notes: recentNotes,
   546→    active_todos: activeTodos,
   547→    ready_tasks: readyTasks,
   548→    blocked_tasks: blockedTasks,
   549→    recently_completed: recentlyCompleted,
   550→    recent_commits: recentCommits,
   551→    working_tree: workingTree,
   552→    inbox_items: inboxSummaries,
   553→    stats,
   554→  };
   555→}
   556→
   557→// ─── Iteration Stats ─────────────────────────────────────────────────────────
   558→
   559→/**
   560→ * Stats for tasks completed/started within a time window.
   561→ * Used by ralph to track task completions per iteration.
   562→ */
   563→export interface IterationStats {
   564→  /** Number of tasks completed since the given time */
   565→  tasks_completed: number;
   566→  /** Number of tasks started since the given time */
   567→  tasks_started: number;
   568→  /** References of completed tasks */
   569→  completed_refs: string[];
   570→}
   571→
   572→/**
   573→ * Get iteration stats - tasks completed/started since a given time.
   574→ * AC: @ralph-task-limit ac-detection
   575→ */
   576→export async function getIterationStats(
   577→  ctx: KspecContext,
   578→  since: Date,
   579→): Promise<IterationStats> {
   580→  const allTasks = await loadAllTasks(ctx);
   581→
   582→  // Count both completed and pending_review (submitted) tasks toward the limit.
   583→  // Submit means the agent's work is done — it should count the same as complete.
   584→  // AC: @ralph-task-limit ac-detection
   585→  const completedSince = allTasks.filter((t) => {
   586→    if (t.status === "completed" && t.completed_at) {
   587→      return new Date(t.completed_at) >= since;
   588→    }
   589→    if (t.status === "pending_review" && t.submitted_at) {
   590→      return new Date(t.submitted_at) >= since;
   591→    }
   592→    return false;
   593→  });
   594→
   595→  const startedSince = allTasks.filter((t) => {
   596→    if (!t.started_at) return false;
   597→    return new Date(t.started_at) >= since;
   598→  });
   599→
   600→  // Use first slug or ULID prefix as ref
   601→  const getRef = (t: LoadedTask) =>
   602→    t.slugs.length > 0 ? `@${t.slugs[0]}` : `@${t._ulid.slice(0, 8)}`;
   603→
   604→  return {
   605→    tasks_completed: completedSince.length,
   606→    tasks_started: startedSince.length,
   607→    completed_refs: completedSince.map(getRef),
   608→  };
   609→}
   610→
   611→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   612→
   613→export interface CheckpointOptions {
   614→  force?: boolean;
   615→  /** Set when stop hook is already active (retry after previous block) */
   616→  stopHookActive?: boolean;
   617→}
   618→
   619→/** Claude Code hook input for Stop hooks */
   620→export interface StopHookInput {
   621→  session_id?: string;
   622→  transcript_path?: string;
   623→  hook_event_name?: string;
   624→  stop_hook_active?: boolean;
   625→}
   626→
   627→/**
   628→ * Perform session checkpoint - check for uncommitted work before ending session.
   629→ *
   630→ * This is designed for use as a Claude Code stop hook. It checks for:
   631→ * - Uncommitted git changes (staged, unstaged, untracked)
   632→ * - Tasks in in_progress status
   633→ * - Incomplete todos on active tasks
   634→ *
   635→ * Returns a structured result indicating whether the session can end cleanly.
   636→ */
   637→export async function performCheckpoint(
   638→  ctx: KspecContext,
   639→  options: CheckpointOptions,
   640→): Promise<CheckpointResult> {
   641→  const issues: CheckpointIssue[] = [];
   642→  const instructions: string[] = [];
   643→
   644→  // Load tasks
   645→  const allTasks = await loadAllTasks(ctx);
   646→
   647→  // Check for in-progress tasks
   648→  const inProgressTasks = allTasks.filter((t) => t.status === "in_progress");
   649→  for (const task of inProgressTasks) {
   650→    const ref = task.slugs[0]
   651→      ? `@${task.slugs[0]}`
   652→      : `@${task._ulid.slice(0, 8)}`;
   653→    issues.push({
   654→      type: "in_progress_task",
   655→      description: `Task ${ref} is still in progress: ${task.title}`,
   656→      details: {
   657→        ref,
   658→        title: task.title,
   659→        started_at: task.started_at,
   660→      },
   661→    });
   662→
   663→    // Check for incomplete todos on this task
   664→    const incompleteTodos = task.todos.filter((t) => !t.done);
   665→    for (const todo of incompleteTodos) {
   666→      issues.push({
   667→        type: "incomplete_todo",
   668→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   669→        details: {
   670→          task_ref: ref,
   671→          todo_id: todo.id,
   672→          text: todo.text,
   673→        },
   674→      });
   675→    }
   676→  }
   677→
   678→  // Check for uncommitted git changes
   679→  if (isGitRepo(ctx.rootDir)) {
   680→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   681→    if (!workingTree.clean) {
   682→      const changeCount =
   683→        workingTree.staged.length +
   684→        workingTree.unstaged.length +
   685→        workingTree.untracked.length;
   686→
   687→      issues.push({
   688→        type: "uncommitted_changes",
   689→        description: `${changeCount} uncommitted changes in working tree`,
   690→        details: {
   691→          staged: workingTree.staged.length,
   692→          unstaged: workingTree.unstaged.length,
   693→          untracked: workingTree.untracked.length,
   694→        },
   695→      });
   696→    }
   697→  }
   698→
   699→  // Build instructions based on issues
   700→  if (issues.length > 0 && !options.force) {
   701→    instructions.push(
   702→      "If you've been instructed to ignore this message or are working on",
   703→    );
   704→    instructions.push(
   705→      "unrelated things to any in progress tasks then disregard this message,",
   706→    );
   707→    instructions.push("otherwise before ending this session, please:");
   708→
   709→    const hasInProgress = issues.some((i) => i.type === "in_progress_task");
   710→    const hasUncommitted = issues.some((i) => i.type === "uncommitted_changes");
   711→    const hasIncompleteTodos = issues.some((i) => i.type === "incomplete_todo");
   712→
   713→    let step = 1;
   714→
   715→    if (hasInProgress) {
   716→      instructions.push(
   717→        `${step++}. Read in-progress task notes to get full context of the current task status`,
   718→      );
   719→      instructions.push(
   720→        `${step++}. Add notes documenting current state if any context is missing from this session`,
   721→      );
   722→      instructions.push(
   723→        `${step++}. Complete the task if you've completed the objectives and no AC are left uncovered\notherwise leave it in progress for a future session`,
   724→      );
   725→    }
   726→
   727→    if (hasIncompleteTodos) {
   728→      instructions.push(
   729→        `${step++}. Complete or acknowledge incomplete todos on active tasks`,
   730→      );
   731→    }
   732→
   733→    if (hasUncommitted) {
   734→      instructions.push(
   735→        `${step++}. Commit your changes with a descriptive message`,
   736→      );
   737→
   738→      // Add WIP commit guidance if there are in-progress tasks
   739→      if (inProgressTasks.length > 0) {
   740→        const task = inProgressTasks[0];
   741→        const guidance = formatCommitGuidance(task, { wip: true });
   742→        instructions.push("");
   743→        instructions.push("Suggested WIP commit:");
   744→        instructions.push(`  ${guidance.message}`);
   745→        instructions.push("");
   746→        for (const trailer of guidance.trailers) {
   747→          instructions.push(`  ${trailer}`);
   748→        }
   749→      }
   750→    }
   751→
   752→    instructions.push("");
   753→    instructions.push("Use: kspec task @task to get current task state");
   754→    instructions.push(
   755→      'Use: kspec task note @task "Progress notes..." to document state',
   756→    );
   757→    instructions.push(
   758→      'Use: kspec task complete @task --reason "Summary" if task is done',
   759→    );
   760→  }
   761→
   762→  // Allow stop if:
   763→  // - No issues found
   764→  // - --force flag passed
   765→  // - This is a retry (stop_hook_active = true from previous block)
   766→  const isRetry = options.stopHookActive === true;
   767→  const ok = issues.length === 0 || options.force === true || isRetry;
   768→
   769→  let message: string;
   770→  if (isRetry && issues.length > 0) {
   771→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   772→  } else if (ok) {
   773→    message = "[kspec] Session checkpoint passed - ready to end session";
   774→  } else {
   775→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   776→  }
   777→
   778→  return {
   779→    ok,
   780→    message,
   781→    issues,
   782→    instructions,
   783→  };
   784→}
   785→
   786→// ─── Output Formatting ───────────────────────────────────────────────────────
   787→
   788→function formatCheckpointResult(result: CheckpointResult): void {
   789→  if (result.ok) {
   790→    console.log(chalk.green(result.message));
   791→  } else {
   792→    console.log(chalk.yellow(result.message));
   793→    console.log("");
   794→
   795→    for (const issue of result.issues) {
   796→      const icon =
   797→        issue.type === "uncommitted_changes"
   798→          ? chalk.yellow("⚠")
   799→          : issue.type === "in_progress_task"
   800→            ? chalk.blue("●")
   801→            : chalk.gray("○");
   802→      console.log(`  ${icon} ${issue.description}`);
   803→    }
   804→
   805→    if (result.instructions.length > 0) {
   806→      console.log("");
   807→      for (const instruction of result.instructions) {
   808→        console.log(chalk.gray(instruction));
   809→      }
   810→    }
   811→  }
   812→}
   813→
   814→function formatSessionContext(
   815→  ctx: SessionContext,
   816→  options: SessionOptions,
   817→): void {
   818→  const isBrief = !options.full;
   819→
   820→  // Header
   821→  console.log(`\n${sessionHeaders.title}`);
   822→  const age = formatRelativeTime(new Date(ctx.generated_at));
   823→  if (ctx.branch) {
   824→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   825→  } else {
   826→    console.log(chalk.gray(`Generated: ${age}`));
   827→  }
   828→
   829→  // Stats summary
   830→  const pendingReviewNote =
   831→    ctx.stats.pending_review > 0
   832→      ? `${ctx.stats.pending_review} awaiting review, `
   833→      : "";
   834→  const inboxNote =
   835→    ctx.stats.inbox_items > 0 ? ` | Inbox: ${ctx.stats.inbox_items}` : "";
   836→  console.log(
   837→    chalk.gray(
   838→      `Tasks: ${ctx.stats.in_progress} active, ${pendingReviewNote}${ctx.stats.ready} ready, ` +
   839→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`,
   840→    ),
   841→  );
   842→
   843→  // Session context section (focus, threads, questions)
   844→  if (
   845→    ctx.context &&
   846→    (ctx.context.focus ||
   847→      ctx.context.threads.length > 0 ||
   848→      ctx.context.open_questions.length > 0)
   849→  ) {
   850→    console.log("\n--- Session Context ---");
   851→
   852→    if (ctx.context.focus) {
   853→      console.log(`  ${chalk.cyan("Focus:")} ${ctx.context.focus}`);
   854→    }
   855→
   856→    if (ctx.context.threads.length > 0) {
   857→      console.log(`  ${chalk.cyan("Active Threads:")}`);
   858→      for (const thread of ctx.context.threads) {
   859→        console.log(`    - ${thread}`);
   860→      }
   861→    }
   862→
   863→    if (ctx.context.open_questions.length > 0) {
   864→      console.log(`  ${chalk.cyan("Open Questions:")}`);
   865→      for (const question of ctx.context.open_questions) {
   866→        console.log(`    - ${question}`);
   867→      }
   868→    }
   869→  }
   870→
   871→  // Active tasks section
   872→  if (ctx.active_tasks.length > 0) {
   873→    console.log(`\n${sessionHeaders.activeWork}`);
   874→    for (const task of ctx.active_tasks) {
   875→      const started = task.started_at
   876→        ? chalk.gray(
   877→            ` (started ${formatRelativeTime(new Date(task.started_at))})`,
   878→          )
   879→        : "";
   880→      const priority =
   881→        task.priority <= 2
   882→          ? chalk.red(`P${task.priority}`)
   883→          : chalk.gray(`P${task.priority}`);
   884→      console.log(
   885→        `  ${chalk.blue("[in_progress]")} ${priority} ${task.ref} ${task.title}${started}`,
   886→      );
   887→    }
   888→  } else {
   889→    console.log(`\n${sessionHeaders.noActiveWork}`);
   890→  }
   891→
   892→  // Awaiting review section
   893→  if (ctx.pending_review_tasks.length > 0) {
   894→    console.log(`\n${sessionHeaders.awaitingReview}`);
   895→    for (const task of ctx.pending_review_tasks) {
   896→      const priority =
   897→        task.priority <= 2
   898→          ? chalk.red(`P${task.priority}`)
   899→          : chalk.gray(`P${task.priority}`);
   900→      console.log(
   901→        `  ${chalk.yellow("[pending_review]")} ${priority} ${task.ref} ${task.title}`,
   902→      );
   903→    }
   904→  }
   905→
   906→  // Recently completed section
   907→  if (ctx.recently_completed.length > 0) {
   908→    console.log(`\n${sessionHeaders.recentlyCompleted}`);
   909→    const observationPromotedTasks: string[] = [];
   910→    for (const task of ctx.recently_completed) {
   911→      const completedAge = formatRelativeTime(new Date(task.completed_at));
   912→      let reason = "";
   913→      if (task.closed_reason) {
   914→        const maxLen = isBrief ? 60 : 120;
   915→        const truncated =
   916→          task.closed_reason.length > maxLen
   917→            ? `${task.closed_reason.slice(0, maxLen).trim()}...`
   918→            : task.closed_reason;
   919→        reason = chalk.gray(` - ${truncated}`);
   920→      }
   921→      console.log(
   922→        `  ${chalk.green("[completed]")} ${task.ref} ${task.title} ${chalk.gray(`(${completedAge})`)}${reason}`,
   923→      );
   924→
   925→      // Track tasks that came from observations
   926→      if (task.origin === "observation_promotion") {
   927→        observationPromotedTasks.push(task.ref);
   928→      }
   929→    }
   930→
   931→    // Show reminder about resolving observations
   932→    if (observationPromotedTasks.length > 0) {
   933→      console.log(
   934→        chalk.yellow(
   935→          `\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(", ")}`,
   936→        ),
   937→      );
   938→      console.log(
   939→        chalk.gray(`    Run: kspec meta observations --pending-resolution`),
   940→      );
   941→    }
   942→  }
   943→
   944→  // Recent notes section - grouped by task status
   945→  // AC: @cmd-session-start ac-1, ac-2
   946→  if (ctx.recent_notes.length > 0) {
   947→    console.log(`\n${sessionHeaders.recentNotes}`);
   948→
   949→    // Group notes by task status
   950→    const inProgressNotes = ctx.recent_notes.filter(
   951→      (n) => n.task_status === "in_progress",
   952→    );
   953→    const pendingReviewNotes = ctx.recent_notes.filter(
   954→      (n) => n.task_status === "pending_review",
   955→    );
   956→    const completedNotes = ctx.recent_notes.filter(
   957→      (n) => n.task_status === "completed",
   958→    );
   959→
   960→    // Helper to format a single note
   961→    const formatNote = (note: NoteSummary) => {
   962→      const age = formatRelativeTime(new Date(note.created_at));
   963→      const author = note.author ? chalk.gray(` by ${note.author}`) : "";
   964→      console.log(`    ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
   965→
   966→      // Truncate content in brief mode
   967→      let content = note.content.trim();
   968→      if (isBrief && content.length > 200) {
   969→        content = `${content.slice(0, 200).trim()}...`;
   970→      }
   971→
   972→      // Indent content, limit lines in brief mode
   973→      const lines = content.split("\n");
   974→      const maxLines = isBrief ? 3 : lines.length;
   975→      for (const line of lines.slice(0, maxLines)) {
   976→        console.log(`      ${chalk.white(line)}`);
   977→      }
   978→      if (isBrief && lines.length > maxLines) {
   979→        console.log(
   980→          chalk.gray(`      ... (${lines.length - maxLines} more lines)`),
   981→        );
   982→      }
   983→    };
   984→
   985→    // AC: @cmd-session-start ac-1 - In Progress notes
   986→    if (inProgressNotes.length > 0) {
   987→      console.log(`  ${chalk.blue("In Progress:")}`);
   988→      for (const note of inProgressNotes) {
   989→        formatNote(note);
   990→      }
   991→    }
   992→
   993→    // AC: @cmd-session-start ac-1 - Pending Review notes (grouped separately)
   994→    if (pendingReviewNotes.length > 0) {
   995→      console.log(`  ${chalk.yellow("Pending Review:")}`);
   996→      for (const note of pendingReviewNotes) {
   997→        formatNote(note);
   998→      }
   999→    }
  1000→
  1001→    // AC: @cmd-session-start ac-2 - Recently Completed notes
  1002→    if (completedNotes.length > 0) {
  1003→      console.log(`  ${chalk.green("Recently Completed:")}`);
  1004→      for (const note of completedNotes) {
  1005→        formatNote(note);
  1006→      }
  1007→    }
  1008→  }
  1009→
  1010→  // Incomplete todos section
  1011→  if (ctx.active_todos.length > 0) {
  1012→    console.log(`\n${sessionHeaders.incompleteTodos}`);
  1013→    for (const todo of ctx.active_todos) {
  1014→      console.log(
  1015→        `  ${chalk.yellow("[ ]")} ${todo.task_ref}#${todo.id}: ${todo.text}`,
  1016→      );
  1017→    }
  1018→  }
  1019→
  1020→  // Ready tasks section
  1021→  if (ctx.ready_tasks.length > 0) {
  1022→    console.log(`\n${sessionHeaders.readyTasks}`);
  1023→    for (const task of ctx.ready_tasks) {
  1024→      const priority =
  1025→        task.priority <= 2
  1026→          ? chalk.red(`P${task.priority}`)
  1027→          : chalk.gray(`P${task.priority}`);
  1028→      const tags =
  1029→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(" #")}`) : "";
  1030→      console.log(`  ${priority} ${task.ref} ${task.title}${tags}`);
  1031→    }
  1032→  }
  1033→
  1034→  // Blocked tasks section
  1035→  if (ctx.blocked_tasks.length > 0) {
  1036→    console.log(`\n${sessionHeaders.blocked}`);
  1037→    for (const task of ctx.blocked_tasks) {
  1038→      console.log(`  ${chalk.red("[blocked]")} ${task.ref} ${task.title}`);
  1039→      if (task.blocked_by.length > 0) {
  1040→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(", ")}`));
  1041→      }
  1042→      if (task.unmet_deps.length > 0) {
  1043→        console.log(
  1044→          chalk.gray(`    Waiting on: ${task.unmet_deps.join(", ")}`),
  1045→        );
  1046→      }
  1047→    }
  1048→  }
  1049→
  1050→  // Git commits section
  1051→  if (ctx.recent_commits.length > 0) {
  1052→    console.log(`\n${sessionHeaders.recentCommits}`);
  1053→    for (const commit of ctx.recent_commits) {
  1054→      const age = formatRelativeTime(new Date(commit.date));
  1055→      console.log(
  1056→        `  ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${age}, ${commit.author})`)}`,
  1057→      );
  1058→    }
  1059→  }
  1060→
  1061→  // Inbox section (oldest first to encourage triage)
  1062→  if (ctx.inbox_items.length > 0) {
  1063→    console.log(`\n${sessionHeaders.inbox}`);
  1064→    for (const item of ctx.inbox_items) {
  1065→      const age = formatRelativeTime(new Date(item.created_at));
  1066→      const author = item.added_by ? ` by ${item.added_by}` : "";
  1067→      const tags =
  1068→        item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(", ")}]`) : "";
  1069→      // Truncate text in brief mode
  1070→      let text = item.text;
  1071→      if (isBrief && text.length > 60) {
  1072→        text = `${text.slice(0, 60).trim()}...`;
  1073→      }
  1074→      console.log(
  1075→        `  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`,
  1076→      );
  1077→      console.log(`    ${text}`);
  1078→    }
  1079→    console.log(`  ${hints.inboxPromote}`);
  1080→  }
  1081→
  1082→  // Working tree section
  1083→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1084→    console.log(`\n${sessionHeaders.workingTree}`);
  1085→
  1086→    if (ctx.working_tree.staged.length > 0) {
  1087→      console.log(chalk.green("  Staged:"));
  1088→      for (const file of ctx.working_tree.staged) {
  1089→        console.log(
  1090→          `    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`,
  1091→        );
  1092→      }
  1093→    }
  1094→
  1095→    if (ctx.working_tree.unstaged.length > 0) {
  1096→      console.log(chalk.red("  Modified:"));
  1097→      for (const file of ctx.working_tree.unstaged) {
  1098→        console.log(
  1099→          `    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`,
  1100→        );
  1101→      }
  1102→    }
  1103→
  1104→    if (ctx.working_tree.untracked.length > 0) {
  1105→      console.log(chalk.gray("  Untracked:"));
  1106→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
  1107→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
  1108→        console.log(`    ${chalk.gray("?")} ${path}`);
  1109→      }
  1110→      if (isBrief && ctx.working_tree.untracked.length > limit) {
  1111→        console.log(
  1112→          chalk.gray(
  1113→            `    ... and ${ctx.working_tree.untracked.length - limit} more`,
  1114→          ),
  1115→        );
  1116→      }
  1117→    }
  1118→  } else if (ctx.working_tree?.clean) {
  1119→    console.log(`\n${sessionHeaders.workingTreeClean}`);
  1120→  }
  1121→
  1122→  // Quick Commands section - contextual hints based on state
  1123→  const quickCommands: string[] = [];
  1124→
  1125→  if (ctx.active_tasks.length > 0) {
  1126→    const ref = ctx.active_tasks[0].ref;
  1127→    quickCommands.push(
  1128→      `kspec task note @${ref} "Progress..."  ${chalk.gray("# document work")}`,
  1129→    );
  1130→    quickCommands.push(
  1131→      `kspec task complete @${ref} --reason "..."  ${chalk.gray("# finish task")}`,
  1132→    );
  1133→  } else if (ctx.ready_tasks.length > 0) {
  1134→    const ref = ctx.ready_tasks[0].ref;
  1135→    quickCommands.push(
  1136→      `kspec task start @${ref}  ${chalk.gray("# begin work")}`,
  1137→    );
  1138→  }
  1139→
  1140→  if (ctx.inbox_items.length > 0) {
  1141→    const ref = ctx.inbox_items[0].ref;
  1142→    quickCommands.push(
  1143→      `kspec inbox promote @${ref} --title "..."  ${chalk.gray("# convert to task")}`,
  1144→    );
  1145→  }
  1146→
  1147→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1148→    quickCommands.push(
  1149→      `git add . && git commit -m "..."  ${chalk.gray("# commit changes")}`,
  1150→    );
  1151→  }
  1152→
  1153→  if (quickCommands.length > 0) {
  1154→    console.log(`\n${sessionHeaders.quickCommands}`);
  1155→    for (const hint of quickCommands) {
  1156→      console.log(`  ${hint}`);
  1157→    }
  1158→  }
  1159→
  1160→  console.log(""); // Final newline
  1161→}
  1162→
  1163→// ─── Command Registration ────────────────────────────────────────────────────
  1164→
  1165→async function sessionStartAction(options: SessionOptions): Promise<void> {
  1166→  try {
  1167→    const ctx = await initContext();
  1168→
  1169→    // AC: @shadow-sync ac-2 - Pull remote changes before showing session context
  1170→    let syncResult: ShadowSyncResult | null = null;
  1171→    if (ctx.shadow?.enabled) {
  1172→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
  1173→      // AC: @shadow-sync ac-3 - Warn about conflicts but continue with local state
  1174→      if (syncResult.hadConflict) {
  1175→        warn("Shadow sync conflict detected. Run `kspec shadow resolve` to fix.");
  1176→        info("Continuing with local state...");
  1177→      } else if (syncResult.pulled) {
  1178→        info("Synced shadow branch from remote");
  1179→      }
  1180→    }
  1181→
  1182→    const sessionCtx = await gatherSessionContext(ctx, options);
  1183→
  1184→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
  1185→  } catch (err) {
  1186→    error(errors.failures.gatherSessionContext, err);
  1187→    process.exit(EXIT_CODES.ERROR);
  1188→  }
  1189→}
  1190→
  1191→/**
  1192→ * Read stdin if available (non-blocking check for hook input)
  1193→ */
  1194→async function readStdinIfAvailable(): Promise<string | null> {
  1195→  // Check if stdin is a TTY (interactive) - if so, don't try to read
  1196→  if (process.stdin.isTTY) {
  1197→    return null;
  1198→  }
  1199→
  1200→  return new Promise((resolve) => {
  1201→    let data = "";
  1202→    const timeout = setTimeout(() => {
  1203→      process.stdin.removeAllListeners();
  1204→      resolve(data || null);
  1205→    }, 100); // 100ms timeout for stdin
  1206→
  1207→    process.stdin.setEncoding("utf8");
  1208→    process.stdin.on("data", (chunk) => {
  1209→      data += chunk;
  1210→    });
  1211→    process.stdin.on("end", () => {
  1212→      clearTimeout(timeout);
  1213→      resolve(data || null);
  1214→    });
  1215→    process.stdin.on("error", () => {
  1216→      clearTimeout(timeout);
  1217→      resolve(null);
  1218→    });
  1219→    process.stdin.resume();
  1220→  });
  1221→}
  1222→
  1223→/**
  1224→ * Parse Claude Code hook input from stdin
  1225→ */
  1226→function parseHookInput(stdin: string | null): StopHookInput | null {
  1227→  if (!stdin) return null;
  1228→  try {
  1229→    return JSON.parse(stdin.trim()) as StopHookInput;
  1230→  } catch {
  1231→    return null;
  1232→  }
  1233→}
  1234→
  1235→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
  1236→
  1237→/**
  1238→ * Output spec-first reminder for UserPromptSubmit hook.
  1239→ *
  1240→ * This is a simple context injection - always outputs the reminder,
  1241→ * and Claude (Opus) is smart enough to apply it when relevant.
  1242→ */
  1243→async function sessionPromptCheckAction(): Promise<void> {
  1244→  // Lean, instructive reminder with kspec prefix
  1245→  console.log(sessionPrompt.specCheck);
  1246→}
  1247→
  1248→async function sessionCheckpointAction(
  1249→  options: CheckpointOptions,
  1250→): Promise<void> {
  1251→  try {
  1252→    // Read stdin for Claude Code hook input
  1253→    const stdin = await readStdinIfAvailable();
  1254→    const hookInput = parseHookInput(stdin);
  1255→
  1256→    // Check if this is a retry (stop hook already active)
  1257→    if (hookInput?.stop_hook_active) {
  1258→      options.stopHookActive = true;
  1259→    }
  1260→
  1261→    const ctx = await initContext();
  1262→    const result = await performCheckpoint(ctx, options);
  1263→
  1264→    // Output format depends on mode:
  1265→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
  1266→    // - Human mode: Output formatted checkpoint result
  1267→    if (isJsonMode()) {
  1268→      if (!result.ok) {
  1269→        // Build reason message with issues and instructions
  1270→        const issueLines = result.issues
  1271→          .map((i) => `- ${i.description}`)
  1272→          .join("\n");
  1273→        const instructionLines = result.instructions
  1274→          .filter((i) => i.trim())
  1275→          .join("\n");
  1276→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
  1277→        console.log(JSON.stringify({ decision: "block", reason }));
  1278→      }
  1279→      // If ok, exit silently (Claude Code expects no output when allowing stop)
  1280→    } else {
  1281→      formatCheckpointResult(result);
  1282→      if (!result.ok) {
  1283→        process.exit(EXIT_CODES.ERROR);
  1284→      }
  1285→    }
  1286→  } catch (err) {
  1287→    // Handle RUNNING_FROM_SHADOW gracefully - skip with warning instead of erroring
  1288→    // This happens when the stop hook runs while cwd is inside .kspec/ directory
  1289→    if (err instanceof ShadowError && err.code === "RUNNING_FROM_SHADOW") {
  1290→      if (!isJsonMode()) {
  1291→        console.log(
  1292→          chalk.yellow(
  1293→            "[kspec] Session checkpoint skipped - running from inside .kspec/ directory",
  1294→          ),
  1295→        );
  1296→      }
  1297→      // Allow stop to proceed (exit successfully, no JSON output blocks the stop)
  1298→      return;
  1299→    }
  1300→    error(errors.failures.runCheckpoint, err);
  1301→    process.exit(EXIT_CODES.ERROR);
  1302→  }
  1303→}
  1304→
  1305→// ─── Session Log List ─────────────────────────────────────────────────────────
  1306→
  1307→interface SessionLogListOptions {
  1308→  status?: string;
  1309→  agent?: string;
  1310→  since?: string;
  1311→  sort?: string;
  1312→  count?: boolean;
  1313→  limit?: string;
  1314→}
  1315→
  1316→type SortField =
  1317→  | "started_at"
  1318→  | "duration"
  1319→  | "events"
  1320→  | "iterations"
  1321→  | "tasks_completed";
  1322→
  1323→const VALID_SORT_FIELDS: SortField[] = [
  1324→  "started_at",
  1325→  "duration",
  1326→  "events",
  1327→  "iterations",
  1328→  "tasks_completed",
  1329→];
  1330→
  1331→/**
  1332→ * Format a duration in milliseconds to a human-readable string.
  1333→ */
  1334→function formatDuration(ms: number): string {
  1335→  if (ms < 0) return "—";
  1336→  const totalSec = Math.floor(ms / 1000);
  1337→  const hours = Math.floor(totalSec / 3600);
  1338→  const minutes = Math.floor((totalSec % 3600) / 60);
  1339→  if (hours > 0) {
  1340→    return `${hours}h ${minutes}m`;
  1341→  }
  1342→  if (minutes > 0) {
  1343→    return `${minutes}m`;
  1344→  }
  1345→  return `${totalSec}s`;
  1346→}
  1347→
  1348→/**
  1349→ * Sort session summaries by the specified field.
  1350→ * Default: started_at descending.
  1351→ *
  1352→ * AC: @session-log-list ac-5
  1353→ */
  1354→function sortSessions(
  1355→  sessions: SessionLogSummary[],
  1356→  sortField: SortField,
  1357→): SessionLogSummary[] {
  1358→  return [...sessions].sort((a, b) => {
  1359→    switch (sortField) {
  1360→      case "started_at":
  1361→        return (
  1362→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1363→        );
  1364→      case "duration":
  1365→        return b.duration_ms - a.duration_ms;
  1366→      case "events":
  1367→        return b.event_count - a.event_count;
  1368→      case "iterations":
  1369→        return b.iteration_count - a.iteration_count;
  1370→      case "tasks_completed":
  1371→        return b.tasks_completed - a.tasks_completed;
  1372→      default:
  1373→        return (
  1374→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1375→        );
  1376→    }
  1377→  });
  1378→}
  1379→
  1380→/**
  1381→ * Format the session log list as a table.
  1382→ *
  1383→ * AC: @session-log-list ac-1
  1384→ */
  1385→function formatSessionLogList(sessions: SessionLogSummary[]): void {
  1386→  if (sessions.length === 0) {
  1387→    // AC: @session-log-list ac-6
  1388→    console.log("No sessions found.");
  1389→    return;
  1390→  }
  1391→
  1392→  // Table header
  1393→  console.log(
  1394→    chalk.gray(
  1395→      `${"ID".padEnd(10)} ${"Status".padEnd(11)} ${"Agent".padEnd(20)} ${"Started".padEnd(16)} ${"Duration".padEnd(10)} ${"Events".padEnd(8)} ${"Iters".padEnd(7)} Tasks`,
  1396→    ),
  1397→  );
  1398→  console.log(chalk.gray("─".repeat(95)));
  1399→
  1400→  for (const s of sessions) {
  1401→    const id = s.id.slice(0, 8);
  1402→    const statusColor =
  1403→      s.status === "completed"
  1404→        ? chalk.green
  1405→        : s.status === "active"
  1406→          ? chalk.blue
  1407→          : chalk.yellow;
  1408→    const status = statusColor(s.status.padEnd(11));
  1409→    const agent = s.agent_type.slice(0, 20).padEnd(20);
  1410→    const started = formatRelativeTime(new Date(s.started_at)).padEnd(16);
  1411→    const duration = formatDuration(s.duration_ms).padEnd(10);
  1412→    const events = String(s.event_count).padEnd(8);
  1413→    const iters = String(s.iteration_count).padEnd(7);
  1414→    const tasks = String(s.tasks_completed);
  1415→
  1416→    console.log(
  1417→      `${chalk.yellow(id)} ${status} ${chalk.gray(agent)} ${chalk.gray(started)} ${duration} ${events} ${iters} ${tasks}`,
  1418→    );
  1419→  }
  1420→
  1421→  console.log(chalk.gray(`\n${sessions.length} session(s)`));
  1422→}
  1423→
  1424→/**
  1425→ * Session log list action handler.
  1426→ */
  1427→async function sessionLogListAction(
  1428→  options: SessionLogListOptions,
  1429→): Promise<void> {
  1430→  try {
  1431→    const ctx = await initContext();
  1432→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1433→
  1434→    // AC: @session-log-list ac-2 - Filter by status
  1435→    if (options.status) {
  1436→      const statusFilter = options.status as SessionStatus;
  1437→      sessions = sessions.filter((s) => s.status === statusFilter);
  1438→    }
  1439→
  1440→    // AC: @session-log-list ac-4 - Filter by agent type
  1441→    if (options.agent) {
  1442→      const agentFilter = options.agent;
  1443→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1444→    }
  1445→
  1446→    // AC: @session-log-list ac-3 - Filter by since date
  1447→    if (options.since) {
  1448→      const sinceDate = parseTimeSpec(options.since);
  1449→      if (sinceDate) {
  1450→        sessions = sessions.filter(
  1451→          (s) => new Date(s.started_at) >= sinceDate,
  1452→        );
  1453→      }
  1454→    }
  1455→
  1456→    // AC: @session-log-list ac-5 - Sort
  1457→    const sortField: SortField =
  1458→      options.sort && VALID_SORT_FIELDS.includes(options.sort as SortField)
  1459→        ? (options.sort as SortField)
  1460→        : "started_at";
  1461→    sessions = sortSessions(sessions, sortField);
  1462→
  1463→    // AC: @session-log-list ac-7 - Limit output count
  1464→    if (options.count) {
  1465→      // AC: @trait-filterable-list ac-8
  1466→      output({ count: sessions.length }, () => {
  1467→        console.log(sessions.length);
  1468→      });
  1469→      return;
  1470→    }
  1471→
  1472→    // Apply --limit (after filtering/sorting, before display)
  1473→    if (options.limit) {
  1474→      const limit = parseInt(options.limit, 10);
  1475→      if (!Number.isNaN(limit) && limit > 0) {
  1476→        sessions = sessions.slice(0, limit);
  1477→      }
  1478→    }
  1479→
  1480→    output(sessions, () => formatSessionLogList(sessions));
  1481→  } catch (err) {
  1482→    error("Failed to list session logs", err);
  1483→    process.exit(EXIT_CODES.ERROR);
  1484→  }
  1485→}
  1486→
  1487→// ─── Session Log Show ─────────────────────────────────────────────────────────
  1488→
  1489→interface SessionLogShowOptions {
  1490→  events?: boolean;
  1491→  type?: string;
  1492→  limit?: string;
  1493→  context?: string;
  1494→}
  1495→
  1496→/**
  1497→ * Format an event timestamp as relative time from session start.
  1498→ */
  1499→function formatEventTimestamp(
  1500→  eventTs: number,
  1501→  sessionStartTs: number,
  1502→): string {
  1503→  const relativeMs = eventTs - sessionStartTs;
  1504→  const totalSec = Math.floor(relativeMs / 1000);
  1505→  const minutes = Math.floor(totalSec / 60);
  1506→  const seconds = totalSec % 60;
  1507→  if (minutes > 0) {
  1508→    return `+${minutes}m${seconds}s`;
  1509→  }
  1510→  return `+${seconds}s`;
  1511→}
  1512→
  1513→/**
  1514→ * Summarize event data for display.
  1515→ * Returns a short string describing the event payload.
  1516→ */
  1517→function summarizeEventData(event: SessionEvent): string {
  1518→  const data = event.data as Record<string, unknown> | null;
  1519→  if (!data) return "";
  1520→
  1521→  // Handle tool_call events
  1522→  if (event.type === "session.update") {
  1523→    const update = data.update as {
  1524→      sessionUpdate?: string;
  1525→      rawInput?: { command?: string };
  1526→      _meta?: { claudeCode?: { toolName?: string } };
  1527→    } | null;
  1528→    if (update?.sessionUpdate === "tool_call") {
  1529→      const toolName = update._meta?.claudeCode?.toolName || "unknown";
  1530→      const command = update.rawInput?.command;
  1531→      if (command) {
  1532→        const truncated =
  1533→          command.length > 60 ? command.slice(0, 57) + "..." : command;
  1534→        return `${toolName}: ${truncated}`;
  1535→      }
  1536→      return toolName;
  1537→    }
  1538→  }
  1539→
  1540→  // Handle prompt.sent events
  1541→  if (event.type === "prompt.sent") {
  1542→    const prompt = data.prompt as string | null;
  1543→    if (prompt) {
  1544→      const truncated =
  1545→        prompt.length > 60 ? prompt.slice(0, 57) + "..." : prompt;
  1546→      return truncated;
  1547→    }
  1548→  }
  1549→
  1550→  // Handle session.start/end
  1551→  if (event.type === "session.start") {
  1552→    return "Session started";
  1553→  }
  1554→  if (event.type === "session.end") {
  1555→    const reason = data.reason as string | null;
  1556→    return reason ? `Session ended: ${reason}` : "Session ended";
  1557→  }
  1558→
  1559→  // Default: show first key
  1560→  const keys = Object.keys(data);
  1561→  if (keys.length > 0) {
  1562→    return `{${keys.slice(0, 3).join(", ")}${keys.length > 3 ? ", ..." : ""}}`;
  1563→  }
  1564→  return "";
  1565→}
  1566→
  1567→/**
  1568→ * Format the session log show output.
  1569→ *
  1570→ * AC: @session-log-show ac-1
  1571→ */
  1572→function formatSessionLogShow(
  1573→  detail: SessionLogDetail,
  1574→  events: SessionEvent[] | null,
  1575→  contextSnapshot: unknown | null,
  1576→  sessionStartTs: number,
  1577→): void {
  1578→  // AC: @session-log-show ac-1 - Session metadata
  1579→  console.log(chalk.bold(`Session ${detail.id.slice(0, 8)}`));
  1580→  console.log(chalk.gray("─".repeat(60)));
  1581→  console.log(`  ID:        ${detail.id}`);
  1582→
  1583→  const statusColor =
  1584→    detail.status === "completed"
  1585→      ? chalk.green
  1586→      : detail.status === "active"
  1587→        ? chalk.blue
  1588→        : chalk.yellow;
  1589→  console.log(`  Status:    ${statusColor(detail.status)}`);
  1590→  console.log(`  Agent:     ${detail.agent_type}`);
  1591→  if (detail.task_id) {
  1592→    console.log(`  Task:      ${detail.task_id}`);
  1593→  }
  1594→  console.log(`  Started:   ${detail.started_at}`);
  1595→  if (detail.ended_at) {
  1596→    console.log(`  Ended:     ${detail.ended_at}`);
  1597→  }
  1598→  console.log(`  Duration:  ${formatDuration(detail.duration_ms)}`);
  1599→  console.log(`  Events:    ${detail.event_count}`);
  1600→  console.log(`  Iterations: ${detail.iteration_count}`);
  1601→
  1602→  // AC: @session-log-show ac-2 - Per-iteration summary
  1603→  if (detail.iterations.length > 0) {
  1604→    console.log("\n" + chalk.bold("Iterations"));
  1605→    console.log(chalk.gray("─".repeat(60)));
  1606→    for (const iter of detail.iterations) {
  1607→      const taskInfo: string[] = [];
  1608→      if (iter.tasks_started.length > 0) {
  1609→        taskInfo.push(`started: ${iter.tasks_started.join(", ")}`);
  1610→      }
  1611→      if (iter.tasks_completed.length > 0) {
  1612→        taskInfo.push(`completed: ${iter.tasks_completed.join(", ")}`);
  1613→      }
  1614→      const taskStr = taskInfo.length > 0 ? ` | ${taskInfo.join(" | ")}` : "";
  1615→      console.log(
  1616→        `  ${chalk.cyan(`[${iter.iteration}]`)} ${iter.event_count} events${taskStr}`,
  1617→      );
  1618→    }
  1619→  }
  1620→
  1621→  // AC: @session-log-show ac-3 - Event timeline
  1622→  if (events !== null) {
  1623→    console.log("\n" + chalk.bold("Events"));
  1624→    console.log(chalk.gray("─".repeat(60)));
  1625→    if (events.length === 0) {
  1626→      console.log(chalk.gray("  No events to display."));
  1627→    } else {
  1628→      for (const event of events) {
  1629→        const timestamp = formatEventTimestamp(event.ts, sessionStartTs);
  1630→        const summary = summarizeEventData(event);
  1631→        const typeColor =
  1632→          event.type === "session.start" || event.type === "session.end"
  1633→            ? chalk.green
  1634→            : event.type === "session.update"
  1635→              ? chalk.blue
  1636→              : chalk.gray;
  1637→        console.log(
  1638→          `  ${chalk.yellow(timestamp.padEnd(10))} ${typeColor(event.type.padEnd(16))} ${chalk.gray(summary)}`,
  1639→        );
  1640→      }
  1641→    }
  1642→  }
  1643→
  1644→  // AC: @session-log-show ac-6 - Context snapshot
  1645→  if (contextSnapshot !== null) {
  1646→    console.log("\n" + chalk.bold("Context Snapshot"));
  1647→    console.log(chalk.gray("─".repeat(60)));
  1648→    console.log(JSON.stringify(contextSnapshot, null, 2));
  1649→  }
  1650→}
  1651→
  1652→/**
  1653→ * Session log show action handler.
  1654→ */
  1655→async function sessionLogShowAction(
  1656→  sessionRef: string,
  1657→  options: SessionLogShowOptions,
  1658→): Promise<void> {
  1659→  try {
  1660→    const ctx = await initContext();
  1661→
  1662→    // AC: @session-log-show ac-7, ac-8, ac-9 - Resolve session ID
  1663→    const resolution = await resolveSessionId(ctx.specDir, sessionRef);
  1664→
  1665→    if (!resolution.ok) {
  1666→      if (resolution.error === "not_found") {
  1667→        // AC: @session-log-show ac-9
  1668→        error(`Session not found: ${sessionRef}`);
  1669→        process.exit(EXIT_CODES.NOT_FOUND);
  1670→      } else {
  1671→        // AC: @session-log-show ac-8
  1672→        error(
  1673→          `Ambiguous session ID prefix. Matches:\n  ${resolution.matches.join("\n  ")}\nPlease provide a more specific prefix.`,
  1674→        );
  1675→        process.exit(EXIT_CODES.VALIDATION_FAILED);
  1676→      }
  1677→    }
  1678→
  1679→    const sessionId = resolution.id;
  1680→
  1681→    // Get session detail
  1682→    const detail = await getSessionLogDetail(ctx.specDir, sessionId);
  1683→    if (!detail) {
  1684→      error(`Session not found: ${sessionId}`);
  1685→      process.exit(EXIT_CODES.NOT_FOUND);
  1686→    }
  1687→
  1688→    // AC: @session-log-show ac-3, ac-4, ac-5 - Event timeline
  1689→    let events: SessionEvent[] | null = null;
  1690→    if (options.events) {
  1691→      let allEvents = deduplicatePhasedToolCalls(
  1692→        await readEvents(ctx.specDir, sessionId),
  1693→      );
  1694→
  1695→      // AC: @session-log-show ac-4 - Filter by type
  1696→      if (options.type) {
  1697→        const typeFilter = options.type;
  1698→        allEvents = allEvents.filter((e) => e.type === typeFilter);
  1699→      }
  1700→
  1701→      // AC: @session-log-show ac-5 - Limit to last N events
  1702→      if (options.limit) {
  1703→        const limit = parseInt(options.limit, 10);
  1704→        if (!Number.isNaN(limit) && limit > 0) {
  1705→          allEvents = allEvents.slice(-limit);
  1706→        }
  1707→      }
  1708→
  1709→      events = allEvents;
  1710→    }
  1711→
  1712→    // AC: @session-log-show ac-6 - Context snapshot
  1713→    let contextSnapshot: unknown | null = null;
  1714→    if (options.context) {
  1715→      const iterNum = parseInt(options.context, 10);
  1716→      if (!Number.isNaN(iterNum) && iterNum > 0) {
  1717→        contextSnapshot = await readSessionContext(
  1718→          ctx.specDir,
  1719→          sessionId,
  1720→          iterNum,
  1721→        );
  1722→        if (contextSnapshot === null) {
  1723→          error(`No context snapshot found for iteration ${iterNum}`);
  1724→          process.exit(EXIT_CODES.NOT_FOUND);
  1725→        }
  1726→      } else {
  1727→        error(`Invalid iteration number: ${options.context}`);
  1728→        process.exit(EXIT_CODES.USAGE_ERROR);
  1729→      }
  1730→    }
  1731→
  1732→    const sessionStartTs = new Date(detail.started_at).getTime();
  1733→
  1734→    // Build JSON output structure
  1735→    const jsonOutput = {
  1736→      ...detail,
  1737→      ...(events !== null ? { events } : {}),
  1738→      ...(contextSnapshot !== null ? { context: contextSnapshot } : {}),
  1739→    };
  1740→
  1741→    output(jsonOutput, () =>
  1742→      formatSessionLogShow(detail, events, contextSnapshot, sessionStartTs),
  1743→    );
  1744→  } catch (err) {
  1745→    error("Failed to show session log", err);
  1746→    process.exit(EXIT_CODES.ERROR);
  1747→  }
  1748→}
  1749→
  1750→// ─── Session Log Stats ─────────────────────────────────────────────────────────
  1751→
  1752→interface SessionLogStatsOptions {
  1753→  since?: string;
  1754→  agent?: string;
  1755→  toolUsage?: boolean;
  1756→  byDay?: boolean;
  1757→  byWeek?: boolean;
  1758→}
  1759→
  1760→/**
  1761→ * Full stats output including optional tool usage and time period data.
  1762→ */
  1763→interface SessionLogStatsOutput {
  1764→  stats: SessionLogStats;
  1765→  tool_usage?: ToolUsageStats[];
  1766→  time_periods?: TimePeriodStats[];
  1767→}
  1768→
  1769→/**
  1770→ * Format a duration in milliseconds to human-readable format.
  1771→ * Reuses formatDuration from session log list but handles hours/minutes/seconds.
  1772→ */
  1773→function formatDurationLong(ms: number): string {
  1774→  if (ms < 0) return "—";
  1775→  const totalSec = Math.floor(ms / 1000);
  1776→  const hours = Math.floor(totalSec / 3600);
  1777→  const minutes = Math.floor((totalSec % 3600) / 60);
  1778→  const seconds = totalSec % 60;
  1779→  if (hours > 0 && minutes > 0) {
  1780→    return `${hours}h ${minutes}m`;
  1781→  }
  1782→  if (hours > 0) {
  1783→    return `${hours}h`;
  1784→  }
  1785→  if (minutes > 0) {
  1786→    return `${minutes}m ${seconds}s`;
  1787→  }
  1788→  return `${seconds}s`;
  1789→}
  1790→
  1791→/**
  1792→ * Format the session log stats output.
  1793→ *
  1794→ * AC: @session-log-stats ac-1, ac-2, ac-3
  1795→ */
  1796→function formatSessionLogStats(
  1797→  stats: SessionLogStats,
  1798→  toolUsage: ToolUsageStats[] | null,
  1799→  timePeriods: TimePeriodStats[] | null,
  1800→  groupBy: "day" | "week" | null,
  1801→): void {
  1802→  // AC: @session-log-stats ac-1 - Totals
  1803→  console.log(chalk.bold("Session Statistics"));
  1804→  console.log(chalk.gray("─".repeat(50)));
  1805→  console.log(`  Total Sessions:     ${stats.total_sessions}`);
  1806→  console.log(`  Total Events:       ${stats.total_events}`);
  1807→  console.log(`  Total Iterations:   ${stats.total_iterations}`);
  1808→  console.log(`  Tasks Completed:    ${stats.total_tasks_completed}`);
  1809→  console.log(`  Total Duration:     ${formatDurationLong(stats.total_duration_ms)}`);
  1810→
  1811→  // AC: @session-log-stats ac-2 - Averages
  1812→  console.log("\n" + chalk.bold("Averages"));
  1813→  console.log(chalk.gray("─".repeat(50)));
  1814→  console.log(`  Avg Duration/Session:     ${formatDurationLong(stats.avg_duration_ms)}`);
  1815→  console.log(`  Avg Iterations/Session:   ${stats.avg_iterations_per_session}`);
  1816→  console.log(`  Avg Tasks/Session:        ${stats.avg_tasks_per_session}`);
  1817→
  1818→  // AC: @session-log-stats ac-3 - Status breakdown
  1819→  if (stats.status_breakdown.length > 0) {
  1820→    console.log("\n" + chalk.bold("Status Breakdown"));
  1821→    console.log(chalk.gray("─".repeat(50)));
  1822→    for (const item of stats.status_breakdown) {
  1823→      const statusColor =
  1824→        item.status === "completed"
  1825→          ? chalk.green
  1826→          : item.status === "active"
  1827→            ? chalk.blue
  1828→            : chalk.yellow;
  1829→      console.log(
  1830→        `  ${statusColor(item.status.padEnd(12))} ${String(item.count).padEnd(6)} ${item.percentage}%`,
  1831→      );
  1832→    }
  1833→  }
  1834→
  1835→  // AC: @session-log-stats ac-6 - Tool usage
  1836→  if (toolUsage !== null && toolUsage.length > 0) {
  1837→    console.log("\n" + chalk.bold("Top Tool Usage"));
  1838→    console.log(chalk.gray("─".repeat(50)));
  1839→    for (const tool of toolUsage) {
  1840→      console.log(
  1841→        `  ${tool.tool_name.padEnd(20)} ${String(tool.count).padEnd(8)} ${tool.percentage}%`,
  1842→      );
  1843→    }
  1844→  }
  1845→
  1846→  // AC: @session-log-stats ac-7 - Time periods
  1847→  if (timePeriods !== null && timePeriods.length > 0) {
  1848→    const label = groupBy === "week" ? "By Week" : "By Day";
  1849→    console.log("\n" + chalk.bold(label));
  1850→    console.log(chalk.gray("─".repeat(50)));
  1851→    console.log(
  1852→      chalk.gray(
  1853→        `  ${"Period".padEnd(14)} ${"Sessions".padEnd(10)} ${"Tasks".padEnd(8)} Duration`,
  1854→      ),
  1855→    );
  1856→    for (const period of timePeriods) {
  1857→      console.log(
  1858→        `  ${period.period.padEnd(14)} ${String(period.sessions_count).padEnd(10)} ${String(period.tasks_completed).padEnd(8)} ${formatDurationLong(period.total_duration_ms)}`,
  1859→      );
  1860→    }
  1861→  }
  1862→}
  1863→
  1864→/**
  1865→ * Session log stats action handler.
  1866→ */
  1867→async function sessionLogStatsAction(
  1868→  options: SessionLogStatsOptions,
  1869→): Promise<void> {
  1870→  try {
  1871→    const ctx = await initContext();
  1872→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1873→
  1874→    // AC: @session-log-stats ac-4 - Filter by since
  1875→    if (options.since) {
  1876→      const sinceDate = parseTimeSpec(options.since);
  1877→      if (sinceDate) {
  1878→        sessions = sessions.filter(
  1879→          (s) => new Date(s.started_at) >= sinceDate,
  1880→        );
  1881→      }
  1882→    }
  1883→
  1884→    // AC: @session-log-stats ac-5 - Filter by agent type
  1885→    if (options.agent) {
  1886→      const agentFilter = options.agent;
  1887→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1888→    }
  1889→
  1890→    // AC: @session-log-stats ac-8 - No sessions match criteria
  1891→    if (sessions.length === 0) {
  1892→      output({ message: "No sessions match criteria" }, () => {
  1893→        console.log("No sessions match criteria.");
  1894→      });
  1895→      return;
  1896→    }
  1897→
  1898→    // Compute base stats
  1899→    const stats = computeSessionLogStats(sessions);
  1900→
  1901→    // AC: @session-log-stats ac-6 - Tool usage (optional)
  1902→    let toolUsage: ToolUsageStats[] | null = null;
  1903→    if (options.toolUsage) {
  1904→      const sessionIds = sessions.map((s) => s.id);
  1905→      toolUsage = await computeToolUsageStats(ctx.specDir, sessionIds);
  1906→    }
  1907→
  1908→    // AC: @session-log-stats ac-7 - Time periods (optional)
  1909→    let timePeriods: TimePeriodStats[] | null = null;
  1910→    let groupBy: "day" | "week" | null = null;
  1911→    if (options.byDay) {
  1912→      groupBy = "day";
  1913→      timePeriods = computeTimePeriodStats(sessions, "day");
  1914→    } else if (options.byWeek) {
  1915→      groupBy = "week";
  1916→      timePeriods = computeTimePeriodStats(sessions, "week");
  1917→    }
  1918→
  1919→    // Build output structure
  1920→    const jsonOutput: SessionLogStatsOutput = { stats };
  1921→    if (toolUsage !== null) {
  1922→      jsonOutput.tool_usage = toolUsage;
  1923→    }
  1924→    if (timePeriods !== null) {
  1925→      jsonOutput.time_periods = timePeriods;
  1926→    }
  1927→
  1928→    output(jsonOutput, () =>
  1929→      formatSessionLogStats(stats, toolUsage, timePeriods, groupBy),
  1930→    );
  1931→  } catch (err) {
  1932→    error("Failed to compute session log stats", err);
  1933→    process.exit(EXIT_CODES.ERROR);
  1934→  }
  1935→}
  1936→
  1937→// ─── Session Log Search ─────────────────────────────────────────────────────────
  1938→
  1939→interface SessionLogSearchOptions {
  1940→  type?: string;
  1941→  since?: string;
  1942→  agent?: string;
  1943→  limit?: string;
  1944→}
  1945→
  1946→/**
  1947→ * Format relative timestamp from event timestamp (Unix ms) to session start.
  1948→ */
  1949→function formatSearchTimestamp(eventTs: number): string {
  1950→  return new Date(eventTs).toISOString();
  1951→}
  1952→
  1953→/**
  1954→ * Format the session log search output.
  1955→ *
  1956→ * AC: @session-log-search ac-1, ac-4
  1957→ */
  1958→function formatSessionLogSearch(results: SessionSearchResult[]): void {
  1959→  if (results.length === 0) {
  1960→    // AC: @session-log-search ac-6
  1961→    console.log("No matches found.");
  1962→    return;
  1963→  }
  1964→
  1965→  let totalMatches = 0;
  1966→  for (const session of results) {
  1967→    totalMatches += session.matches.length;
  1968→  }
  1969→
  1970→  console.log(chalk.bold(`Found ${totalMatches} match(es) in ${results.length} session(s)`));
  1971→  console.log(chalk.gray("─".repeat(60)));
  1972→
  1973→  for (const session of results) {
  1974→    // Session header
  1975→    console.log(
  1976→      `\n${chalk.cyan(`Session ${session.session_id.slice(0, 8)}`)} ` +
  1977→        `${chalk.gray(`(${session.agent_type}, started ${formatRelativeTime(new Date(session.started_at))})`)}`
  1978→    );
  1979→
  1980→    // AC: @session-log-search ac-4 - Show matches with session ID, timestamp, type, excerpt
  1981→    for (const match of session.matches) {
  1982→      const ts = formatSearchTimestamp(match.timestamp);
  1983→      const typeColor =
  1984→        match.event_type === "session.start" || match.event_type === "session.end"
  1985→          ? chalk.green
  1986→          : match.event_type === "session.update"
  1987→            ? chalk.blue
  1988→            : chalk.gray;
  1989→      console.log(
  1990→        `  ${chalk.yellow(ts)} ${typeColor(match.event_type.padEnd(16))}`,
  1991→      );
  1992→      // Content excerpt on next line, indented
  1993→      console.log(`    ${chalk.gray(match.content_excerpt)}`);
  1994→    }
  1995→  }
  1996→}
  1997→
  1998→/**
  1999→ * Session log search action handler.
  2000→ *
  2001→ * AC: @session-log-search ac-1 through ac-7
  2002→ */
  2003→async function sessionLogSearchAction(
  2004→  pattern: string,
  2005→  options: SessionLogSearchOptions,
  2006→): Promise<void> {
  2007→  try {
  2008→    const ctx = await initContext();
  2009→
  2010→    // Parse options - validate limit as positive integer
  2011→    let limit = 50;
  2012→    if (options.limit) {
  2013→      const parsed = parseInt(options.limit, 10);
  2014→      if (Number.isNaN(parsed) || parsed <= 0) {
  2015→        error(`Invalid limit: ${options.limit}. Must be a positive integer.`);
  2016→        process.exit(EXIT_CODES.USAGE_ERROR);
  2017→      }
  2018→      limit = parsed;
  2019→    }
  2020→    const sinceDate = options.since ? parseTimeSpec(options.since) : undefined;
  2021→
  2022→    // AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7
  2023→    const results = await searchSessionEvents(ctx.specDir, pattern, {
  2024→      eventType: options.type,
  2025→      sinceDate: sinceDate || undefined,
  2026→      agentType: options.agent,
  2027→      limit,
  2028→    });
  2029→
  2030→    // AC: @session-log-search ac-6 - No matches found message
  2031→    // exit code 0 regardless (per @trait-semantic-exit-codes ac-5)
  2032→
  2033→    output(results, () => formatSessionLogSearch(results));
  2034→  } catch (err) {
  2035→    error("Failed to search session logs", err);
  2036→    process.exit(EXIT_CODES.ERROR);
  2037→  }
  2038→}
  2039→
  2040→/**
  2041→ * Register the 'session' command group and aliases
  2042→ */
  2043→export function registerSessionCommands(program: Command): void {
  2044→  const session = program
  2045→    .command("session")
  2046→    .description("Session management and context");
  2047→
  2048→  session
  2049→    .command("start")
  2050→    .alias("resume")
  2051→    .description("Surface relevant context for starting a new working session")
  2052→    .option("--brief", "Compact summary (default)")
  2053→    .option("--full", "Comprehensive context dump")
  2054→    .option(
  2055→      "--since <time>",
  2056→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  2057→    )
  2058→    .option("--no-git", "Skip git commit information")
  2059→    .option("-n, --limit <n>", "Limit items per section", "10")
  2060→    .action(sessionStartAction);
  2061→
  2062→  // Session log subcommand group
  2063→  const log = session
  2064→    .command("log")
  2065→    .description("Session log analysis commands");
  2066→
  2067→  log
  2068→    .command("list")
  2069→    .description("List session logs with summary statistics")
  2070→    .option(
  2071→      "-s, --status <status>",
  2072→      "Filter by status (active, completed, abandoned)",
  2073→    )
  2074→    .option("--agent <type>", "Filter by agent type")
  2075→    .option(
  2076→      "--since <time>",
  2077→      "Only show sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2078→    )
  2079→    .option(
  2080→      "--sort <field>",
  2081→      "Sort by field (started_at, duration, events, iterations, tasks_completed)",
  2082→      "started_at",
  2083→    )
  2084→    .option("--count", "Show only the count of matching sessions")
  2085→    .option("-n, --limit <n>", "Limit number of sessions shown")
  2086→    .action(sessionLogListAction);
  2087→
  2088→  log
  2089→    .command("show <session-id>")
  2090→    .description("Show detailed view of a single session")
  2091→    .option("-e, --events", "Include chronological event timeline")
  2092→    .option("-t, --type <type>", "Filter events by type (e.g., tool.call)")
  2093→    .option("-n, --limit <n>", "Show only the last N events")
  2094→    .option("-c, --context <n>", "Show context snapshot for iteration N")
  2095→    .action(sessionLogShowAction);
  2096→
  2097→  log
  2098→    .command("stats")
  2099→    .description("Aggregate analytics across sessions")
  2100→    .option(
  2101→      "--since <time>",
  2102→      "Only include sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2103→    )
  2104→    .option("--agent <type>", "Only include sessions with this agent type")
  2105→    .option("--tool-usage", "Display top 10 tool calls by frequency")
  2106→    .option("--by-day", "Group stats by day")
  2107→    .option("--by-week", "Group stats by week")
  2108→    .action(sessionLogStatsAction);
  2109→
  2110→  log
  2111→    .command("search <pattern>")
  2112→    .description("Search across session events by content")
  2113→    .option("-t, --type <type>", "Only search events of this type (e.g., session.update)")
  2114→    .option(
  2115→      "--since <time>",
  2116→      "Only search sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2117→    )
  2118→    .option("--agent <type>", "Only search sessions with this agent type")
  2119→    .option("-n, --limit <n>", "Maximum matches to return (default: 50)")
  2120→    .action(sessionLogSearchAction);
  2121→
  2122→  session
  2123→    .command("checkpoint")
  2124→    .description(
  2125→      "Pre-stop hook: check for uncommitted work before ending session",
  2126→    )
  2127→    .option("--force", "Allow session end regardless of issues")
  2128→    .action(sessionCheckpointAction);
  2129→
  2130→  session
  2131→    .command("prompt-check")
  2132→    .description("UserPromptSubmit hook: inject spec-first reminder")
  2133→    .action(sessionPromptCheckAction);
  2134→
  2135→  // Top-level alias: kspec context
  2136→  program
  2137→    .command("context")
  2138→    .description("Alias for session start - surface session context")
  2139→    .option("--brief", "Compact summary (default)")
  2140→    .option("--full", "Comprehensive context dump")
  2141→    .option(
  2142→      "--since <time>",
  2143→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  2144→    )
  2145→    .option("--no-git", "Skip git commit information")
  2146→    .option("-n, --limit <n>", "Limit items per section", "10")
  2147→    .action(sessionStartAction);
  2148→}
