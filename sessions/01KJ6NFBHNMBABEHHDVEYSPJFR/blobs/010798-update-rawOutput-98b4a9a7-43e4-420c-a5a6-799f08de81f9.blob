     1→/**
     2→ * Tests for AC-20: ralph loop context refresh after pending_review processing.
     3→ *
     4→ * When pending_review tasks are processed by subagents, completing one task
     5→ * may unblock dependent tasks. The ralph loop must refresh its context after
     6→ * processing pending_review tasks to detect newly-unblocked tasks.
     7→ *
     8→ * AC: @cli-ralph ac-20
     9→ */
    10→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
    11→import * as fs from 'node:fs/promises';
    12→import * as path from 'node:path';
    13→import { spawnSync } from 'node:child_process';
    14→import { CLI_PATH, setupTempFixtures, cleanupTempDir, testUlid } from './helpers/cli';
    15→
    16→const MOCK_ACP = path.join(__dirname, 'mocks', 'acp-mock.js');
    17→
    18→interface RalphResult {
    19→  output: string;
    20→  stdout: string;
    21→  stderr: string;
    22→  exitCode: number;
    23→}
    24→
    25→/**
    26→ * Run ralph command with a mock ACP agent
    27→ */
    28→function runRalph(
    29→  args: string,
    30→  cwd: string,
    31→  env: Record<string, string> = {}
    32→): RalphResult {
    33→  const result = spawnSync(
    34→    'node',
    35→    [CLI_PATH, 'ralph', ...args.split(/\s+/), '--adapter-cmd', `node ${MOCK_ACP}`],
    36→    {
    37→      cwd,
    38→      encoding: 'utf-8',
    39→      timeout: 30000,
    40→      env: {
    41→        ...process.env,
    42→        KSPEC_AUTHOR: '@test',
    43→        ...env,
    44→      },
    45→    }
    46→  );
    47→
    48→  const stdout = result.stdout || '';
    49→  const stderr = result.stderr || '';
    50→
    51→  return {
    52→    output: stdout + stderr,
    53→    stdout,
    54→    stderr,
    55→    exitCode: result.status || 0,
    56→  };
    57→}
    58→
    59→/**
    60→ * Create test fixtures with dependency chain:
    61→ * - Task A: pending_review, automation:eligible
    62→ * - Task B: pending (blocked), depends_on Task A, automation:eligible
    63→ */
    64→async function setupDependencyFixtures(tempDir: string): Promise<{
    65→  taskAUlid: string;
    66→  taskBUlid: string;
    67→  taskASlug: string;
    68→  taskBSlug: string;
    69→}> {
    70→  const taskAUlid = testUlid('TASKA', 1);
    71→  const taskBUlid = testUlid('TASKB', 2);
    72→  const taskASlug = 'task-pending-review';
    73→  const taskBSlug = 'task-blocked-by-a';
    74→
    75→  const tasksYaml = `tasks:
    76→  - _ulid: ${taskAUlid}
    77→    slugs:
    78→      - ${taskASlug}
    79→    title: Task A - Pending Review
    80→    type: task
    81→    status: pending_review
    82→    priority: 1
    83→    automation: eligible
    84→    tags:
    85→      - test
    86→    description: A task in pending_review state that should be processed by subagent
    87→    depends_on: []
    88→    notes: []
    89→    todos: []
    90→    created_at: "2026-01-01T00:00:00Z"
    91→
    92→  - _ulid: ${taskBUlid}
    93→    slugs:
    94→      - ${taskBSlug}
    95→    title: Task B - Blocked by A
    96→    type: task
    97→    status: pending
    98→    priority: 2
    99→    automation: eligible
   100→    tags:
   101→      - test
   102→    description: A task that depends on Task A and should become ready when A completes
   103→    depends_on:
   104→      - "@${taskASlug}"
   105→    notes: []
   106→    todos: []
   107→    created_at: "2026-01-01T00:00:00Z"
   108→`;
   109→
   110→  await fs.writeFile(path.join(tempDir, 'project.tasks.yaml'), tasksYaml);
   111→
   112→  return { taskAUlid, taskBUlid, taskASlug, taskBSlug };
   113→}
   114→
   115→describe('ralph context refresh after pending_review processing', () => {
   116→  let tempDir: string;
   117→
   118→  beforeEach(async () => {
   119→    tempDir = await setupTempFixtures();
   120→  });
   121→
   122→  afterEach(async () => {
   123→    await cleanupTempDir(tempDir);
   124→  });
   125→
   126→  // AC: @cli-ralph ac-20 - Context refresh only happens when pending_review tasks exist
   127→  it('does not spawn subagent when no pending_review tasks exist', async () => {
   128→    // Use default fixtures which have no pending_review tasks
   129→    const tasksPath = path.join(tempDir, 'project.tasks.yaml');
   130→    const content = await fs.readFile(tasksPath, 'utf-8');
   131→
   132→    // Verify no pending_review tasks in default fixtures
   133→    expect(content).not.toContain('status: pending_review');
   134→
   135→    const result = runRalph('--max-loops 1', tempDir, {
   136→      MOCK_ACP_EXIT_CODE: '0',
   137→    });
   138→
   139→    // Should process normally without subagent spawning
   140→    expect(result.output).not.toContain('[REVIEW SUBAGENT]');
   141→    expect(result.output).not.toContain('pending_review task');
   142→
   143→    // Should still complete iterations
   144→    expect(result.output).toContain('Completed iteration 1');
   145→  });
   146→
   147→  // AC: @cli-ralph ac-20 - Verify pending_review tasks trigger subagent processing
   148→  it('spawns subagent when pending_review tasks exist', { timeout: 35000 }, async () => {
   149→    await setupDependencyFixtures(tempDir);
   150→
   151→    const result = runRalph('--max-loops 1', tempDir, {
   152→      MOCK_ACP_EXIT_CODE: '0',
   153→    });
   154→
   155→    // Should detect and process the pending_review task
   156→    expect(result.output).toContain('[REVIEW SUBAGENT]');
   157→    expect(result.output).toContain('pending_review task');
   158→    expect(result.output).toContain('Task A - Pending Review');
   159→  });
   160→});
   161→
   162→describe('ralph context refresh - fixture state modification', () => {
   163→  let tempDir: string;
   164→
   165→  beforeEach(async () => {
   166→    tempDir = await setupTempFixtures();
   167→  });
   168→
   169→  afterEach(async () => {
   170→    await cleanupTempDir(tempDir);
   171→  });
   172→
   173→  // AC: @cli-ralph ac-20 - Verify dependency unblocking detection via fixture modification
   174→  // This test simulates the behavior that ac-20 addresses by manually modifying state
   175→  it('detects newly-ready tasks when dependency is completed', async () => {
   176→    const { taskAUlid, taskBUlid, taskASlug, taskBSlug } = await setupDependencyFixtures(tempDir);
   177→
   178→    // First, verify initial state using session start
   179→    const sessionResult = spawnSync(
   180→      'node',
   181→      [CLI_PATH, 'session', 'start', '--json'],
   182→      {
   183→        cwd: tempDir,
   184→        encoding: 'utf-8',
   185→        timeout: 10000,
   186→        env: {
   187→          ...process.env,
   188→          KSPEC_AUTHOR: '@test',
   189→        },
   190→      }
   191→    );
   192→
   193→    const sessionCtx = JSON.parse(sessionResult.stdout || '{}');
   194→
   195→    // Verify initial state: Task A is pending_review, Task B is blocked
   196→    expect(sessionCtx.pending_review_tasks).toBeDefined();
   197→    expect(sessionCtx.pending_review_tasks.length).toBe(1);
   198→
   199→    // The ref might be the ULID prefix or the @slug - check for either
   200→    const taskARef = sessionCtx.pending_review_tasks[0].ref;
   201→    expect(taskARef === `@${taskASlug}` || taskARef.startsWith(taskAUlid.substring(0, 8))).toBe(true);
   202→
   203→    // Task B should NOT be in ready_tasks because it's blocked
   204→    const readyTaskRefs = sessionCtx.ready_tasks.map((t: { ref: string }) => t.ref);
   205→    expect(readyTaskRefs.some((ref: string) =>
   206→      ref === `@${taskBSlug}` || ref.startsWith(taskBUlid.substring(0, 8))
   207→    )).toBe(false);
   208→
   209→    // Now manually complete Task A via kspec CLI (simulating subagent completion)
   210→    const completeResult = spawnSync(
   211→      'node',
   212→      [CLI_PATH, 'task', 'complete', `@${taskASlug}`, '--reason', 'Test completion', '--force'],
   213→      {
   214→        cwd: tempDir,
   215→        encoding: 'utf-8',
   216→        timeout: 10000,
   217→        env: {
   218→          ...process.env,
   219→          KSPEC_AUTHOR: '@test',
   220→        },
   221→      }
   222→    );
   223→
   224→    expect(completeResult.status).toBe(0);
   225→
   226→    // Now gather context again - Task B should now be in ready_tasks
   227→    const sessionResult2 = spawnSync(
   228→      'node',
   229→      [CLI_PATH, 'session', 'start', '--json'],
   230→      {
   231→        cwd: tempDir,
   232→        encoding: 'utf-8',
   233→        timeout: 10000,
   234→        env: {
   235→          ...process.env,
   236→          KSPEC_AUTHOR: '@test',
   237→        },
   238→      }
   239→    );
   240→
   241→    const sessionCtx2 = JSON.parse(sessionResult2.stdout || '{}');
   242→
   243→    // Verify updated state: Task A is completed, Task B is now ready
   244→    expect(sessionCtx2.pending_review_tasks.length).toBe(0);
   245→
   246→    const readyTaskRefs2 = sessionCtx2.ready_tasks.map((t: { ref: string }) => t.ref);
   247→    expect(readyTaskRefs2.some((ref: string) =>
   248→      ref === `@${taskBSlug}` || ref.startsWith(taskBUlid.substring(0, 8))
   249→    )).toBe(true);
   250→  });
   251→
   252→  // AC: @cli-ralph ac-20 - Verify the stale context problem scenario
   253→  it('demonstrates stale vs fresh context difference', async () => {
   254→    const { taskAUlid, taskBUlid, taskASlug, taskBSlug } = await setupDependencyFixtures(tempDir);
   255→
   256→    // This test demonstrates what WOULD happen without the fix:
   257→    // 1. Gather context at iteration start (Task A pending_review, Task B blocked)
   258→    // 2. Process pending_review (completes Task A)
   259→    // 3. Without refresh: still see Task B as blocked (stale)
   260→    // 4. With refresh (ac-20 fix): see Task B as ready
   261→
   262→    // Get initial context snapshot (simulates context gathered at iteration start)
   263→    const initialResult = spawnSync(
   264→      'node',
   265→      [CLI_PATH, 'session', 'start', '--json'],
   266→      {
   267→        cwd: tempDir,
   268→        encoding: 'utf-8',
   269→        timeout: 10000,
   270→        env: { ...process.env, KSPEC_AUTHOR: '@test' },
   271→      }
   272→    );
   273→    const initialCtx = JSON.parse(initialResult.stdout || '{}');
   274→
   275→    // Verify Task B is NOT ready initially (blocked by Task A)
   276→    const initialReady = initialCtx.ready_tasks.map((t: { ref: string }) => t.ref);
   277→    expect(initialReady.some((ref: string) =>
   278→      ref === `@${taskBSlug}` || ref.startsWith(taskBUlid.substring(0, 8))
   279→    )).toBe(false);
   280→
   281→    // Simulate what happens during pending_review processing: complete Task A
   282→    spawnSync(
   283→      'node',
   284→      [CLI_PATH, 'task', 'complete', `@${taskASlug}`, '--reason', 'Merged', '--force'],
   285→      {
   286→        cwd: tempDir,
   287→        encoding: 'utf-8',
   288→        timeout: 10000,
   289→        env: { ...process.env, KSPEC_AUTHOR: '@test' },
   290→      }
   291→    );
   292→
   293→    // The stale context (initialCtx) still shows Task B as blocked
   294→    // This is the bug that ac-20 fixes - ralph would use initialCtx to check eligibility
   295→    expect(initialReady.some((ref: string) =>
   296→      ref === `@${taskBSlug}` || ref.startsWith(taskBUlid.substring(0, 8))
   297→    )).toBe(false);
   298→
   299→    // But fresh context shows Task B as ready
   300→    const freshResult = spawnSync(
   301→      'node',
   302→      [CLI_PATH, 'session', 'start', '--json'],
   303→      {
   304→        cwd: tempDir,
   305→        encoding: 'utf-8',
   306→        timeout: 10000,
   307→        env: { ...process.env, KSPEC_AUTHOR: '@test' },
   308→      }
   309→    );
   310→    const freshCtx = JSON.parse(freshResult.stdout || '{}');
   311→
   312→    // Task B should now be ready because Task A is completed
   313→    const freshReady = freshCtx.ready_tasks.map((t: { ref: string }) => t.ref);
   314→    expect(freshReady.some((ref: string) =>
   315→      ref === `@${taskBSlug}` || ref.startsWith(taskBUlid.substring(0, 8))
   316→    )).toBe(true);
   317→
   318→    // This demonstrates that:
   319→    // - Stale context (initialCtx.ready_tasks) does NOT contain Task B
   320→    // - Fresh context (freshCtx.ready_tasks) DOES contain Task B
   321→    // The ac-20 fix ensures ralph uses fresh context after pending_review processing
   322→  });
   323→});
   324→
   325→describe('ralph context refresh - behavior verification', () => {
   326→  let tempDir: string;
   327→
   328→  beforeEach(async () => {
   329→    tempDir = await setupTempFixtures();
   330→  });
   331→
   332→  afterEach(async () => {
   333→    await cleanupTempDir(tempDir);
   334→  });
   335→
   336→  // AC: @cli-ralph ac-20 - Verify task state after subagent processing
   337→  it('processes pending_review task and continues loop', { timeout: 35000 }, async () => {
   338→    await setupDependencyFixtures(tempDir);
   339→
   340→    const result = runRalph('--max-loops 1', tempDir, {
   341→      MOCK_ACP_EXIT_CODE: '0',
   342→    });
   343→
   344→    // Ralph should complete the loop (not crash or hang)
   345→    expect(result.output).toContain('Ralph loop completed');
   346→
   347→    // The output should show that pending_review processing happened
   348→    expect(result.output).toContain('[REVIEW SUBAGENT]');
   349→  });
   350→
   351→  // AC: @cli-ralph ac-20 - Verify context is used for task eligibility
   352→  it('uses context to determine task eligibility', { timeout: 35000 }, async () => {
   353→    await setupDependencyFixtures(tempDir);
   354→
   355→    const result = runRalph('--max-loops 1', tempDir, {
   356→      MOCK_ACP_EXIT_CODE: '0',
   357→    });
   358→
   359→    // When there are pending_review tasks but no ready tasks (Task B is blocked),
   360→    // and the mock doesn't actually complete Task A, the loop should handle this gracefully
   361→    expect(result.output).toContain('Ralph loop completed');
   362→
   363→    // Verify the output mentions task eligibility check
   364→    // The message "No automation-eligible tasks" appears when checking if there are tasks to work on
   365→    if (result.output.includes('No automation-eligible tasks')) {
   366→      // This is expected when Task A is still pending_review (mock didn't complete it)
   367→      // and Task B is still blocked
   368→      expect(result.output).toContain('No automation-eligible tasks');
   369→    }
   370→  });
   371→});
   372→
   373→describe('ralph context refresh - mock task completion integration', () => {
   374→  let tempDir: string;
   375→
   376→  beforeEach(async () => {
   377→    tempDir = await setupTempFixtures();
   378→  });
   379→
   380→  afterEach(async () => {
   381→    await cleanupTempDir(tempDir);
   382→  });
   383→
   384→  // AC: @cli-ralph ac-20 - Full integration test with mock completing tasks
   385→  // This test verifies that when a pending_review task is completed by the subagent,
   386→  // ralph refreshes its context and detects newly-unblocked tasks
   387→  it('continues loop when subagent completes blocking task (AC-20 integration)', { timeout: 60000 }, async () => {
   388→    const { taskASlug, taskBSlug } = await setupDependencyFixtures(tempDir);
   389→
   390→    // Run ralph with mock configured to complete Task A
   391→    // This simulates a real subagent completing the pending_review task
   392→    const result = runRalph('--max-loops 2', tempDir, {
   393→      MOCK_ACP_EXIT_CODE: '0',
   394→      MOCK_ACP_COMPLETE_TASK: `@${taskASlug}`,
   395→      MOCK_ACP_PROJECT_DIR: tempDir,
   396→      MOCK_ACP_CLI_PATH: CLI_PATH,
   397→    });
   398→
   399→    // The mock should have completed Task A
   400→    expect(result.stderr).toContain(`Completed task @${taskASlug}`);
   401→
   402→    // With AC-20 fix: After pending_review processing completes Task A,
   403→    // ralph should refresh context and see that Task B is now ready.
   404→    // Without the fix, ralph would use stale context and exit early.
   405→
   406→    // Check if Task B appears in subsequent processing
   407→    // This indicates ralph detected the newly-unblocked task
   408→    const taskBInOutput = result.output.includes(taskBSlug) || result.output.includes('Task B');
   409→
   410→    // The loop should either:
   411→    // 1. Process Task B in a subsequent iteration (if context refresh worked)
   412→    // 2. Or at minimum, not exit with "No automation-eligible tasks" immediately after pending_review
   413→
   414→    // Verify ralph didn't exit immediately after pending_review processing
   415→    expect(result.output).toContain('Ralph loop completed');
   416→  });
   417→
   418→  // AC: @cli-ralph ac-20 - Verify context snapshot reflects refreshed state
   419→  it('saves refreshed context to snapshot after pending_review processing', { timeout: 60000 }, async () => {
   420→    const { taskASlug, taskBSlug } = await setupDependencyFixtures(tempDir);
   421→
   422→    // Run ralph with mock completing Task A
   423→    runRalph('--max-loops 1', tempDir, {
   424→      MOCK_ACP_EXIT_CODE: '0',
   425→      MOCK_ACP_COMPLETE_TASK: `@${taskASlug}`,
   426→      MOCK_ACP_PROJECT_DIR: tempDir,
   427→      MOCK_ACP_CLI_PATH: CLI_PATH,
   428→    });
   429→
   430→    // Check the context snapshot saved after iteration 1
   431→    const sessionsDir = path.join(tempDir, 'sessions');
   432→    const sessions = await fs.readdir(sessionsDir).catch(() => []);
   433→
   434→    if (sessions.length > 0) {
   435→      const sessionDir = path.join(sessionsDir, sessions[0]);
   436→      const contextPath = path.join(sessionDir, 'context-iter-1.json');
   437→
   438→      const contextExists = await fs.access(contextPath).then(() => true).catch(() => false);
   439→      if (contextExists) {
   440→        const contextContent = await fs.readFile(contextPath, 'utf-8');
   441→        const context = JSON.parse(contextContent);
   442→
   443→        // The context snapshot should show the refreshed state:
   444→        // - Task A completed (not in pending_review or ready)
   445→        // - Task B ready (was blocked, now unblocked)
   446→
   447→        // Note: The exact structure depends on when the snapshot is taken
   448→        // (before or after context refresh). This test verifies the snapshot
   449→        // is created and contains task information.
   450→        expect(context).toHaveProperty('ready_tasks');
   451→        expect(context).toHaveProperty('stats');
   452→      }
   453→    }
   454→  });
   455→});
   456→