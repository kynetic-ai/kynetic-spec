   452→    const errors = validateParentRefs(specs, existingRefs);
   453→
   454→    expect(errors).toHaveLength(0);
   455→  });
   456→
   457→  it("should handle parent refs with or without @ prefix", () => {
   458→    const specs: PlanSpec[] = [
   459→      { title: "Child", slug: "child", parent: "parent" },
   460→      { title: "Parent", slug: "parent" },
   461→    ];
   462→
   463→    const errors = validateParentRefs(specs, new Set());
   464→
   465→    expect(errors).toHaveLength(0);
   466→  });
   467→
   468→  it("should validate multiple specs with mixed valid/invalid parents", () => {
   469→    const specs: PlanSpec[] = [
   470→      { title: "Valid Child", slug: "valid", parent: "@parent" },
   471→      { title: "Invalid Child", slug: "invalid", parent: "@nonexistent" },
   472→      { title: "Parent", slug: "parent" },
   473→    ];
   474→
   475→    const errors = validateParentRefs(specs, new Set());
   476→
   477→    expect(errors).toHaveLength(1);
   478→    expect(errors[0].spec?.slug).toBe("invalid");
   479→  });
   480→});
