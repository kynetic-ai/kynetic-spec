   280→describe("Topological Sort", () => {
   281→  // AC: @plan-import ac-16
   282→  it("should sort specs in topological order (parents before children)", () => {
   283→    const specs: PlanSpec[] = [
   284→      { title: "Child", slug: "child", parent: "@parent" },
   285→      { title: "Parent", slug: "parent" },
   286→      { title: "Grandchild", slug: "grandchild", parent: "@child" },
   287→    ];
   288→
   289→    const result = topologicalSort(specs);
   290→
   291→    expect(result.error).toBeNull();
   292→    expect(result.sorted).toHaveLength(3);
   293→    expect(result.sorted[0].slug).toBe("parent");
   294→    expect(result.sorted[1].slug).toBe("child");
   295→    expect(result.sorted[2].slug).toBe("grandchild");
   296→  });
   297→
   298→  // AC: @plan-import ac-18
   299→  it("should detect circular parent references", () => {
   300→    const specs: PlanSpec[] = [
   301→      { title: "Spec A", slug: "spec-a", parent: "@spec-b" },
   302→      { title: "Spec B", slug: "spec-b", parent: "@spec-a" },
   303→    ];
   304→
   305→    const result = topologicalSort(specs);
   306→
   307→    expect(result.error).not.toBeNull();
   308→    expect(result.error?.type).toBe("circular");
   309→    expect(result.error?.message).toContain("Circular parent reference");
   310→    expect(result.error?.message).toContain("@spec-a");
   311→    expect(result.error?.message).toContain("@spec-b");
   312→  });
   313→
   314→  it("should handle specs without parents", () => {
   315→    const specs: PlanSpec[] = [
   316→      { title: "Spec 1", slug: "spec-1" },
   317→      { title: "Spec 2", slug: "spec-2" },
   318→    ];
   319→
   320→    const result = topologicalSort(specs);
   321→
   322→    expect(result.error).toBeNull();
   323→    expect(result.sorted).toHaveLength(2);
   324→  });
   325→
   326→  it("should ignore external parent references", () => {
   327→    const specs: PlanSpec[] = [
   328→      { title: "Child", slug: "child", parent: "@external-parent" },
   329→      { title: "Sibling", slug: "sibling" },
   330→    ];
   331→
   332→    const result = topologicalSort(specs);
   333→
   334→    expect(result.error).toBeNull();
   335→    expect(result.sorted).toHaveLength(2);
   336→  });
   337→
   338→  it("should handle parent ref with or without @ prefix", () => {
   339→    const specs: PlanSpec[] = [
   340→      { title: "Child 1", slug: "child-1", parent: "@parent" },
   341→      { title: "Child 2", slug: "child-2", parent: "parent" },
   342→      { title: "Parent", slug: "parent" },
   343→    ];
   344→
   345→    const result = topologicalSort(specs);
   346→
   347→    expect(result.error).toBeNull();
   348→    expect(result.sorted[0].slug).toBe("parent");
   349→  });
   350→
   351→  it("should handle complex dependency graph", () => {
   352→    const specs: PlanSpec[] = [
   353→      { title: "D", slug: "d", parent: "@b" },
   354→      { title: "B", slug: "b", parent: "@a" },
   355→      { title: "A", slug: "a" },
   356→      { title: "C", slug: "c", parent: "@a" },
   357→      { title: "E", slug: "e" },
   358→    ];
   359→
   360→    const result = topologicalSort(specs);
   361→
   362→    expect(result.error).toBeNull();
   363→    expect(result.sorted).toHaveLength(5);
   364→
   365→    // A must come before B, C, D
   366→    const aIndex = result.sorted.findIndex(s => s.slug === "a");
   367→    const bIndex = result.sorted.findIndex(s => s.slug === "b");
   368→    const cIndex = result.sorted.findIndex(s => s.slug === "c");
   369→    const dIndex = result.sorted.findIndex(s => s.slug === "d");
   370→
   371→    expect(aIndex).toBeLessThan(bIndex);
   372→    expect(aIndex).toBeLessThan(cIndex);
   373→    expect(bIndex).toBeLessThan(dIndex);
   374→  });
   375→
   376→  it("should detect three-way circular dependency", () => {
   377→    const specs: PlanSpec[] = [
   378→      { title: "A", slug: "a", parent: "@b" },
   379→      { title: "B", slug: "b", parent: "@c" },
   380→      { title: "C", slug: "c", parent: "@a" },
   381→    ];
   382→
   383→    const result = topologicalSort(specs);
   384→
   385→    expect(result.error).not.toBeNull();
   386→    expect(result.error?.type).toBe("circular");
   387→    expect(result.error?.message).toContain("Circular parent reference");
   388→  });
   389→
   390→  it("should auto-generate slugs from titles when missing", () => {
   391→    const specs: PlanSpec[] = [
   392→      { title: "Child Spec", parent: "@parent-spec" },
   393→      { title: "Parent Spec" },
   394→    ];
   395→
   396→    const result = topologicalSort(specs);
   397→
   398→    expect(result.error).toBeNull();
   399→    expect(result.sorted[0].title).toBe("Parent Spec");
   400→    expect(result.sorted[1].title).toBe("Child Spec");
   401→  });
   402→});
