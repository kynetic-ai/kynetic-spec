   482→describe("Plan Document Parser - missing YAML block warning", () => {
   483→  // AC: @plan-import ac-34
   484→  it("should warn when Specs section exists but has no YAML code block", () => {
   485→    const plan = `
   486→# Test Plan
   487→
   488→## Specs
   489→
   490→Here are the specs I want to create:
   491→- Feature A
   492→- Feature B
   493→
   494→## Implementation Notes
   495→
   496→Some notes here.
   497→`;
   498→
   499→    const result = parsePlanDocument(plan);
   500→
   501→    expect(result.specs).toHaveLength(0);
   502→    expect(result.errors.length).toBeGreaterThan(0);
   503→    expect(result.errors.some(e =>
   504→      e.type === "validation" && e.message.includes("no YAML code block")
   505→    )).toBe(true);
   506→  });
   507→
   508→  it("should not warn when Specs section has a YAML code block", () => {
   509→    const plan = `
   510→# Test Plan
   511→
   512→## Specs
   513→
   514→\`\`\`yaml
   515→- title: Feature A
   516→  slug: feature-a
   517→  type: feature
   518→  description: A feature
   519→\`\`\`
   520→`;
   521→
   522→    const result = parsePlanDocument(plan);
   523→
   524→    expect(result.errors.filter(e =>
   525→      e.type === "validation" && e.message.includes("no YAML code block")
   526→    )).toHaveLength(0);
   527→  });
   528→
   529→  it("should not warn when there is no Specs section at all", () => {
   530→    const plan = `
   531→# Test Plan
   532→
   533→## Implementation Notes
   534→
   535→Just some notes, no specs section.
   536→`;
   537→
   538→    const result = parsePlanDocument(plan);
   539→
   540→    expect(result.errors.filter(e =>
   541→      e.message.includes("no YAML code block")
   542→    )).toHaveLength(0);
   543→  });
   544→});
