   404→describe("Parent Reference Validation", () => {
   405→  // AC: @plan-import ac-17
   406→  it("should detect missing parent references", () => {
   407→    const specs: PlanSpec[] = [
   408→      { title: "Child", slug: "child", parent: "@nonexistent" },
   409→    ];
   410→
   411→    const existingRefs = new Set<string>();
   412→
   413→    const errors = validateParentRefs(specs, existingRefs);
   414→
   415→    expect(errors).toHaveLength(1);
   416→    expect(errors[0].type).toBe("dependency");
   417→    expect(errors[0].message).toContain("Parent @nonexistent not found");
   418→    expect(errors[0].spec).toBe(specs[0]);
   419→  });
   420→
   421→  // AC: @plan-import ac-33
   422→  it("should provide recovery hint for missing parents", () => {
   423→    const specs: PlanSpec[] = [
