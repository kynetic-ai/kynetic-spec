   440→    const errors = validateParentRefs(specs, new Set());
   441→
   442→    expect(errors).toHaveLength(0);
   443→  });
   444→
   445→  it("should allow parent refs to existing project specs", () => {
   446→    const specs: PlanSpec[] = [
   447→      { title: "Child", slug: "child", parent: "@existing-parent" },
   448→    ];
   449→
   450→    const existingRefs = new Set(["existing-parent"]);
