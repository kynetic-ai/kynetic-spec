    50→
    51→/**
    52→ * Find a task by reference with detailed error reporting.
    53→ * Returns the task or exits with appropriate error.
    54→ */
    55→function resolveTaskRef(
    56→  ref: string,
    57→  tasks: LoadedTask[],
    58→  index: ReferenceIndex,
    59→): LoadedTask {
    60→  const result = index.resolve(ref);
    61→
    62→  if (!result.ok) {
    63→    switch (result.error) {
    64→      case "not_found":
    65→        error(errors.reference.taskNotFound(ref));
    66→        break;
    67→      case "ambiguous":
    68→        error(errors.reference.ambiguous(ref));
    69→        for (const candidate of result.candidates) {
    70→          const task = tasks.find((t) => t._ulid === candidate);
    71→          const slug = task?.slugs[0] || "";
    72→          console.error(
    73→            `  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ""}`,
    74→          );
    75→        }
    76→        break;
    77→      case "duplicate_slug":
    78→        error(errors.reference.slugMapsToMultiple(ref));
    79→        for (const candidate of result.candidates) {
    80→          console.error(`  - ${index.shortUlid(candidate)}`);
    81→        }
    82→        break;
    83→    }
    84→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    85→    process.exit(EXIT_CODES.NOT_FOUND);
    86→  }
    87→
    88→  // Check if it's actually a task
    89→  const task = tasks.find((t) => t._ulid === result.ulid);
    90→  if (!task) {
    91→    error(errors.reference.notTask(ref));
    92→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    93→    process.exit(EXIT_CODES.NOT_FOUND);
    94→  }
    95→
    96→  return task;
    97→}
    98→
    99→/**
   100→ * Batch-compatible resolver that returns null instead of calling process.exit().
   101→ * Used by executeBatchOperation to handle errors without terminating the process.
   102→ * AC: @multi-ref-batch ac-4, ac-8 - Partial failure handling and ref resolution
   103→ */
   104→function resolveTaskRefForBatch(
   105→  ref: string,
   106→  tasks: LoadedTask[],
   107→  index: ReferenceIndex,
   108→): { task: LoadedTask | null; error?: string } {
   109→  const result = index.resolve(ref);
   110→
   111→  if (!result.ok) {
   112→    let errorMsg: string;
   113→    switch (result.error) {
   114→      case "not_found":
   115→        errorMsg = `Reference "${ref}" not found`;
   116→        break;
   117→      case "ambiguous":
   118→        errorMsg = `Reference "${ref}" is ambiguous (matches ${result.candidates.length} items)`;
   119→        break;
   120→      case "duplicate_slug":
   121→        errorMsg = `Slug "${ref}" maps to multiple items`;
   122→        break;
   123→    }
   124→    return { task: null, error: errorMsg };
   125→  }
   126→
   127→  // Check if it's actually a task
   128→  const task = tasks.find((t) => t._ulid === result.ulid);
   129→  if (!task) {
   130→    return { task: null, error: `Reference "${ref}" is not a task` };
   131→  }
   132→
   133→  return { task };
   134→}
   135→
   136→/**
   137→ * Helper function to update task fields.
   138→ * Used by both single-ref and batch modes of task set.
   139→ * AC: @spec-task-set-batch ac-1, ac-2, ac-4, ac-5
   140→ */
   141→async function setTaskFields(
   142→  foundTask: LoadedTask,
   143→  ctx: any,
   144→  tasks: LoadedTask[],
   145→  items: LoadedSpecItem[],
   146→  _allMetaItems: any[],
   147→  index: ReferenceIndex,
   148→  options: any,
   149→): Promise<{
   150→  success: boolean;
   151→  message?: string;
   152→  error?: string;
   153→  data?: unknown;
   154→}> {
   155→  try {
   156→    // Check slug uniqueness if adding a new slug
   157→    if (options.slug) {
   158→      const slugCheck = checkSlugUniqueness(
   159→        index,
   160→        [options.slug],
   161→        foundTask._ulid,
   162→      );
   163→      if (!slugCheck.ok) {
   164→        return {
   165→          success: false,
   166→          error: `Slug "${slugCheck.slug}" already exists on ${slugCheck.existingUlid}`,
   167→        };
   168→      }
   169→    }
   170→
   171→    // Build updated task with only provided options
   172→    const updatedTask: Task = { ...foundTask };
   173→    const changes: string[] = [];
   174→
   175→    if (options.title) {
   176→      updatedTask.title = options.title;
   177→      changes.push("title");
   178→    }
   179→
   180→    if (options.specRef !== undefined) {
   181→      // Handle 'null' string to clear spec_ref
   182→      if (options.specRef === "null") {
   183→        updatedTask.spec_ref = null;
   184→        changes.push("spec_ref: cleared");
   185→      } else {
   186→        // Validate the spec ref exists and is a spec item
   187→        const specResult = index.resolve(options.specRef);
   188→        if (!specResult.ok) {
   189→          return {
   190→            success: false,
   191→            error: errors.reference.specRefNotFound(options.specRef),
   192→          };
   193→        }
   194→        // Check it's not a task
   195→        const isTask = tasks.some((t) => t._ulid === specResult.ulid);
   196→        if (isTask) {
   197→          return {
   198→            success: false,
   199→            error: errors.reference.specRefIsTask(options.specRef),
   200→          };
   201→        }
   202→        updatedTask.spec_ref = normalizeRefInput(options.specRef);
   203→        changes.push("spec_ref");
   204→      }
   205→    }
   206→
   207→    if (options.metaRef !== undefined) {
   208→      // Handle 'null' string to clear meta_ref
   209→      if (options.metaRef === "null") {
   210→        updatedTask.meta_ref = null;
   211→        changes.push("meta_ref: cleared");
   212→      } else {
   213→        // Validate the meta ref exists and is a meta item
   214→        const metaRefResult = index.resolve(options.metaRef);
   215→        if (!metaRefResult.ok) {
   216→          return {
   217→            success: false,
   218→            error: errors.reference.metaRefNotFound(options.metaRef),
   219→          };
   220→        }
   221→
   222→        // Check if the resolved item is a meta item (not a spec item or task)
   223→        const isTask = tasks.some((t) => t._ulid === metaRefResult.ulid);
   224→        const isSpecItem = items.some((i) => i._ulid === metaRefResult.ulid);
   225→
   226→        if (isTask || isSpecItem) {
   227→          return {
   228→            success: false,
   229→            error: errors.reference.metaRefPointsToSpec(options.metaRef),
   230→          };
   231→        }
   232→
   233→        updatedTask.meta_ref = normalizeRefInput(options.metaRef);
   234→        changes.push("meta_ref");
   235→      }
   236→    }
   237→
   238→    if (options.planRef !== undefined) {
   239→      // Handle 'null' string to clear plan_ref
   240→      if (options.planRef === "null") {
   241→        updatedTask.plan_ref = null;
   242→        changes.push("plan_ref: cleared");
   243→      } else {
   244→        // First check if it's a task or spec item (wrong type)
   245→        const cleanRef = options.planRef.startsWith("@")
   246→          ? options.planRef.slice(1)
   247→          : options.planRef;
   248→
   249→        const isTask = tasks.some(
   250→          (t) =>
   251→            t.slugs.includes(cleanRef) ||
   252→            t._ulid === cleanRef ||
   253→            t._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   254→        );
   255→        const isSpecItem = items.some(
   256→          (i) =>
   257→            i.slugs.includes(cleanRef) ||
   258→            i._ulid === cleanRef ||
   259→            i._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   260→        );
   261→
   262→        if (isTask || isSpecItem) {
   263→          return {
   264→            success: false,
   265→            error: `Reference "${options.planRef}" is not a plan`,
   266→          };
   267→        }
   268→
   269→        // Now check if the plan exists
   270→        const { findPlanByRef } = await import("../../parser/plans.js");
   271→        const plan = await findPlanByRef(ctx, options.planRef);
   272→
   273→        if (!plan) {
   274→          return {
   275→            success: false,
   276→            error: `Plan reference not found: ${options.planRef}`,
   277→          };
   278→        }
   279→
   280→        updatedTask.plan_ref = normalizeRefInput(options.planRef);
   281→        changes.push("plan_ref");
   282→      }
   283→    }
   284→
   285→    if (options.priority) {
   286→      const priorityResult = parseIntOption(options.priority, {
   287→        min: 1,
   288→        max: 5,
   289→        name: "Priority",
   290→      });
   291→      if (!priorityResult.ok) {
   292→        return { success: false, error: priorityResult.error };
   293→      }
   294→      updatedTask.priority = priorityResult.value;
   295→      changes.push("priority");
   296→    }
   297→
   298→    if (options.slug) {
   299→      if (!updatedTask.slugs.includes(options.slug)) {
   300→        updatedTask.slugs = [...updatedTask.slugs, options.slug];
   301→        changes.push("slug");
   302→      }
   303→    }
   304→
   305→    if (options.tag) {
   306→      const parsedTags = parseTagsArray(options.tag);
   307→      const newTags = parsedTags.filter(
   308→        (t: string) => !updatedTask.tags.includes(t),
   309→      );
   310→      if (newTags.length > 0) {
   311→        updatedTask.tags = [...updatedTask.tags, ...newTags];
   312→        changes.push("tags");
   313→      }
   314→    }
   315→
   316→    if (options.dependsOn) {
   317→      // Validate all dependency refs
   318→      for (const depRef of options.dependsOn) {
   319→        const depResult = index.resolve(depRef);
   320→        if (!depResult.ok) {
   321→          return {
   322→            success: false,
   323→            error: errors.reference.depNotFound(depRef),
   324→          };
   325→        }
   326→        // Ensure the dependency is a task, not a spec item
   327→        const isTask = tasks.some((t) => t._ulid === depResult.ulid);
   328→        if (!isTask) {
   329→          return {
   330→            success: false,
   331→            error: `Reference "${depRef}" is not a task`,
   332→          };
   333→        }
   334→      }
   335→      updatedTask.depends_on = options.dependsOn.map(normalizeRefInput);
   336→      changes.push("depends_on");
   337→    }
   338→
   339→    // AC: @spec-task-clear-deps ac-1, ac-2 - Clear all dependencies
   340→    if (options.clearDeps) {
   341→      if (foundTask.depends_on.length === 0) {
   342→        // AC: @spec-task-clear-deps ac-2 - No changes needed
   343→        return {
   344→          success: true,
   345→          message: "No changes: task has no dependencies to clear",
   346→        };
   347→      }
   348→      updatedTask.depends_on = [];
   349→      changes.push("depends_on");
   350→
   351→      // Add note documenting the change
   352→      // AC: @task-set ac-author
   353→      const note = createNote(
   354→        `Dependencies cleared (was: ${foundTask.depends_on.join(", ")})`,
   355→        getAuthor(ctx.config?.identity?.author),
   356→      );
   357→      updatedTask.notes = [...updatedTask.notes, note];
   358→    }
   359→
   360→    // AC: @task-automation-eligibility ac-5, ac-11, ac-12, ac-18
   361→    // Handle automation status changes
   362→    // Note: --no-automation sets options.automation to false, so check that first
   363→    if (options.automation === false) {
   364→      // --no-automation flag clears the automation status (AC: ac-12)
   365→      delete updatedTask.automation;
   366→      changes.push("automation");
   367→    } else if (options.automation !== undefined) {
   368→      const automationResult = validateEnumOption(
   369→        options.automation,
   370→        ["eligible", "needs_review", "manual_only"] as const,
   371→        "automation status",
   372→      );
   373→      if (!automationResult.ok) {
   374→        return { success: false, error: automationResult.error };
   375→      }
   376→
   377→      // AC: @task-automation-eligibility ac-18 - require reason for needs_review
   378→      if (options.automation === "needs_review" && !options.reason) {
   379→        return {
   380→          success: false,
   381→          error:
   382→            "Setting automation to needs_review requires --reason flag explaining why",
   383→        };
   384→      }
   385→
   386→      updatedTask.automation = automationResult.value;
   387→      changes.push("automation");
   388→
   389→      // If reason provided, add a note documenting the change
   390→      // AC: @task-set ac-author
   391→      if (options.reason) {
   392→        const note = createNote(
   393→          `Automation status set to ${automationResult.value}: ${options.reason}`,
   394→          getAuthor(ctx.config?.identity?.author),
   395→        );
   396→        updatedTask.notes = [...updatedTask.notes, note];
   397→        changes.push("note");
   398→      }
   399→    }
   400→
   401→    // AC: @spec-task-set-batch ac-4 - Warn on no changes, don't fail
   402→    if (changes.length === 0) {
   403→      return {
   404→        success: true,
   405→        message: "No changes specified",
   406→        data: { task: updatedTask },
   407→      };
   408→    }
   409→
   410→    await saveTask(ctx, updatedTask);
   411→    await commitIfShadow(
   412→      ctx.shadow,
   413→      "task-set",
   414→      foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
   415→      changes.join(", "),
   416→    );
   417→
   418→    return {
   419→      success: true,
   420→      message: `Updated task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(", ")})`,
   421→      data: { task: updatedTask },
   422→    };
   423→  } catch (err) {
   424→    return {
   425→      success: false,
   426→      error: err instanceof Error ? err.message : String(err),
   427→    };
   428→  }
   429→}
   430→
   431→/**
   432→ * Register the 'task' command group (singular - operations on individual tasks)
   433→ */
   434→export function registerTaskCommands(program: Command): void {
   435→  const task = program
   436→    .command("task")
   437→    .description("Operations on individual tasks")
   438→    .allowUnknownOption()
   439→    .allowExcessArguments();
   440→
   441→  // AC: @command-group-default-actions ac-bare-task, ac-unknown-subcommand
   442→  // Default action when no subcommand is given (e.g. `kspec task` or `kspec task --status pending`)
   443→  task.action(async (_options: Record<string, unknown>, cmd: Command) => {
   444→    const { Command: Cmd } = await import("commander");
   445→    const listCmd = addListOptions(new Cmd("_list"));
   446→    listCmd.exitOverride();
   447→    try {
   448→      listCmd.parse(cmd.args, { from: "user" });
   449→    } catch {
   450→      console.error(chalk.gray(`Run 'kspec task --help' to see available subcommands`));
   451→      process.exit(EXIT_CODES.ERROR);
   452→    }
   453→
   454→    // AC: @command-group-default-actions ac-unknown-subcommand
   455→    if (listCmd.args.length > 0) {
   456→      const unknownCmd = listCmd.args[0];
   457→      const subcommandNames = cmd.commands.map((c: Command) => c.name());
   458→      const suggestion = findClosestCommand(unknownCmd, subcommandNames);
   459→      console.error(chalk.red(`error: unknown command 'task ${unknownCmd}'`));
   460→      if (suggestion) {
   461→        console.error(chalk.yellow(`Did you mean: kspec task ${suggestion}?`));
   462→      } else {
   463→        console.error(chalk.gray(`Run 'kspec task --help' to see available subcommands`));
   464→      }
   465→      process.exit(EXIT_CODES.ERROR);
   466→    }
   467→
   468→    // AC: @command-group-default-actions ac-bare-with-options
   469→    await listTasksAction(listCmd.opts());
   470→  });
   471→
   472→  // kspec task list - alias for 'kspec tasks list'
   473→  task
   474→    .command("list")
   475→    .description("List all tasks (alias for 'kspec tasks list')")
   476→    .option("-s, --status <status>", "Filter by status")
   477→    .option("-t, --type <type>", "Filter by type")
   478→    .option("--tag <tag>", "Filter by tag")
   479→    .option("--meta-ref <ref>", "Filter by meta reference")
   480→    .option("-g, --grep <pattern>", "Search content with regex pattern")
   481→    .option("-v, --verbose", "Show more details")
   482→    .option("--full", "Show full details (notes, todos, timestamps)")
   483→    .option("--count", "Show only the count of matching tasks")
   484→    .action(async (options) => {
   485→      await listTasksAction(options);
   486→    });
   487→
   488→  // kspec task get <ref>
   489→  task
   490→    .command("get <ref>")
   491→    .description("Get task details")
   492→    .option("--all", "Show all notes including superseded ones")
   493→    .action(async (ref: string, options: { all?: boolean }) => {
   494→      try {
   495→        const ctx = await initContext();
   496→        const tasks = await loadAllTasks(ctx);
   497→        const _items = await loadAllItems(ctx);
   498→
   499→        // Build all indexes including TraitIndex
   500→        const { refIndex: index, traitIndex } = await (async () => {
   501→          const { buildIndexes } = await import("../../parser/index.js");
   502→          return buildIndexes(ctx);
   503→        })();
   504→
   505→        const foundTask = resolveTaskRef(ref, tasks, index);
   506→
   507→        // AC: @trait-display ac-3 - task get shows inherited AC sections
   508→        // Get inherited traits if task has spec_ref
   509→        let inheritedTraits: Array<{
   510→          trait: {
   511→            ulid: string;
   512→            slug: string;
   513→            title: string;
   514→            description?: string;
   515→          };
   516→          acs: Array<{
   517→            id: string;
   518→            given?: string;
   519→            when?: string;
   520→            then?: string;
   521→          }>;
   522→        }> = [];
   523→        if (foundTask.spec_ref) {
   524→          const specResult = index.resolve(foundTask.spec_ref);
   525→          if (specResult.ok) {
   526→            const specUlid = specResult.ulid;
   527→            const inheritedAC = traitIndex.getInheritedAC(specUlid);
   528→            const traitsByTrait = new Map<
   529→              string,
   530→              {
   531→                trait: (typeof inheritedAC)[0]["trait"];
   532→                acs: Array<{
   533→                  id: string;
   534→                  given?: string;
   535→                  when?: string;
   536→                  then?: string;
   537→                }>;
   538→              }
   539→            >();
   540→            for (const { trait, ac } of inheritedAC) {
   541→              if (!traitsByTrait.has(trait.ulid)) {
   542→                traitsByTrait.set(trait.ulid, { trait, acs: [] });
   543→              }
   544→              traitsByTrait.get(trait.ulid)?.acs.push(ac);
   545→            }
   546→            inheritedTraits = Array.from(traitsByTrait.values());
   547→          }
   548→        }
   549→
   550→        // Build JSON output with inherited traits (AC: @trait-display ac-2)
   551→        // Always include all notes in JSON output with superseded computed field
   552→        const jsonOutput = {
   553→          ...foundTask,
   554→          notes: annotateNotesWithSuperseded(foundTask.notes),
   555→          ...(inheritedTraits.length > 0 && {
   556→            inherited_traits: inheritedTraits.map(({ trait, acs }) => ({
   557→              ref: `@${trait.slug}`,
   558→              title: trait.title,
   559→              acceptance_criteria: acs,
   560→            })),
   561→          }),
   562→        };
   563→
   564→        output(jsonOutput, () => {
   565→          formatTaskDetails(foundTask, index, { showAllNotes: options.all });
   566→
   567→          // AC: @trait-display ac-3, ac-4, ac-5 - Show inherited AC per trait in labeled sections
   568→          if (inheritedTraits.length > 0) {
   569→            for (const { trait, acs } of inheritedTraits) {
   570→              console.log(
   571→                chalk.gray(`\n─── Inherited from @${trait.slug} ───`),
   572→              );
   573→              for (const ac of acs) {
   574→                console.log(
   575→                  chalk.cyan(`  [${ac.id}]`) +
   576→                    chalk.gray(` (from @${trait.slug})`),
   577→                );
   578→                if (ac.given) console.log(`    Given: ${ac.given}`);
   579→                if (ac.when) console.log(`    When: ${ac.when}`);
   580→                if (ac.then) console.log(`    Then: ${ac.then}`);
   581→              }
   582→            }
   583→          }
   584→        });
   585→      } catch (err) {
   586→        error(errors.failures.getTask, err);
   587→        process.exit(EXIT_CODES.ERROR);
   588→      }
   589→    });
   590→
   591→  // kspec task add
   592→  markMutating(task.command("add"))
   593→    .description("Create a new task")
   594→    .requiredOption("--title <title>", "Task title")
   595→    .option("--description <description>", "Task description")
   596→    .option(
   597→      "--type <type>",
   598→      "Task type (task, epic, bug, spike, infra)",
   599→      "task",
   600→    )
   601→    .option("--spec-ref <ref>", "Reference to spec item")
   602→    .option(
   603→      "--meta-ref <ref>",
   604→      "Reference to meta item (workflow, agent, or convention)",
   605→    )
   606→    .option("--plan-ref <ref>", "Reference to plan this task is derived from")
   607→    .option("--priority <n>", "Priority (1-5)", "3")
   608→    .option("--slug <slug>", "Human-friendly slug")
   609→    .option("--tag <tag...>", "Tags")
   610→    .option("--depends-on <refs...>", "Set task dependencies")
   611→    .option(
   612→      "--automation <status>",
   613→      "Automation eligibility (eligible, needs_review, manual_only)",
   614→    )
   615→    .addHelpText(
   616→      "after",
   617→      `
   618→Examples:
   619→  $ kspec task add --title "Implement feature" --spec-ref @feature-spec
   620→  $ kspec task add --title "Fix bug" --type bug --priority 1
   621→  $ kspec task add --title "Multi-tag task" --tag cli urgent`,
   622→    )
   623→    .action(async (options) => {
   624→      try {
   625→        const ctx = await initContext();
   626→        const tasks = await loadAllTasks(ctx);
   627→        const items = await loadAllItems(ctx);
   628→
   629→        // Load meta items for validation
   630→        const { loadMetaContext } = await import("../../parser/meta.js");
   631→        const metaContext = await loadMetaContext(ctx);
   632→        const allMetaItems = [
   633→          ...metaContext.agents,
   634→          ...metaContext.workflows,
   635→          ...metaContext.conventions,
   636→          ...metaContext.observations,
   637→        ];
   638→
   639→        // Build index for reference validation
   640→        const refIndex = new ReferenceIndex(tasks, items, allMetaItems);
   641→
   642→        // Check slug uniqueness if provided
   643→        if (options.slug) {
   644→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   645→          if (!slugCheck.ok) {
   646→            error(
   647→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
   648→            );
   649→            process.exit(EXIT_CODES.CONFLICT);
   650→          }
   651→        }
   652→
   653→        // Validate meta_ref if provided (AC-meta-ref-3, AC-meta-ref-4)
   654→        if (options.metaRef) {
   655→          const metaRefResult = refIndex.resolve(options.metaRef);
   656→
   657→          if (!metaRefResult.ok) {
   658→            error(errors.reference.metaRefNotFound(options.metaRef));
   659→            process.exit(EXIT_CODES.NOT_FOUND);
   660→          }
   661→
   662→          // Check if the resolved item is a meta item (not a spec item or task)
   663→          const isTask = tasks.some((t) => t._ulid === metaRefResult.ulid);
   664→          const isSpecItem = items.some((i) => i._ulid === metaRefResult.ulid);
   665→
   666→          if (isTask || isSpecItem) {
   667→            error(errors.reference.metaRefPointsToSpec(options.metaRef));
   668→            process.exit(EXIT_CODES.NOT_FOUND);
   669→          }
   670→        }
   671→
   672→        // Validate spec_ref if provided — must point to a spec item, not a task or meta item
   673→        if (options.specRef) {
   674→          const specRefResult = validateSpecRef(
   675→            options.specRef,
   676→            refIndex,
   677→            tasks,
   678→            items,
   679→          );
   680→          if (!specRefResult.ok) {
   681→            error(specRefResult.error);
   682→            process.exit(EXIT_CODES.NOT_FOUND);
   683→          }
   684→        }
   685→
   686→        // AC: @task-automation-eligibility ac-13 - validate automation if provided
   687→        let automationValue:
   688→          | "eligible"
   689→          | "needs_review"
   690→          | "manual_only"
   691→          | undefined;
   692→        if (options.automation) {
   693→          const automationResult = validateEnumOption(
   694→            options.automation,
   695→            ["eligible", "needs_review", "manual_only"] as const,
   696→            "automation status",
   697→          );
   698→          if (!automationResult.ok) {
   699→            error(automationResult.error);
   700→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   701→          }
   702→          automationValue = automationResult.value;
   703→        }
   704→
   705→        // Validate plan_ref if provided (AC: @plan-derive ac-5, ac-6)
   706→        if (options.planRef) {
   707→          // First check if it's a task or spec item (wrong type)
   708→          const cleanRef = options.planRef.startsWith("@")
   709→            ? options.planRef.slice(1)
   710→            : options.planRef;
   711→
   712→          const isTask = tasks.some(
   713→            (t) =>
   714→              t.slugs.includes(cleanRef) ||
   715→              t._ulid === cleanRef ||
   716→              t._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   717→          );
   718→          const isSpecItem = items.some(
   719→            (i) =>
   720→              i.slugs.includes(cleanRef) ||
   721→              i._ulid === cleanRef ||
   722→              i._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   723→          );
   724→
   725→          if (isTask || isSpecItem) {
   726→            error(`Reference "${options.planRef}" is not a plan`);
   727→            process.exit(EXIT_CODES.NOT_FOUND);
   728→          }
   729→
   730→          // Now check if the plan exists
   731→          const { findPlanByRef } = await import("../../parser/plans.js");
   732→          const plan = await findPlanByRef(ctx, options.planRef);
   733→
   734→          if (!plan) {
   735→            error(`Plan reference not found: ${options.planRef}`);
   736→            process.exit(EXIT_CODES.NOT_FOUND);
   737→          }
   738→        }
   739→
   740→        // AC: @task-add-depends-on ac-2 - Validate dependency refs
   741→        if (options.dependsOn) {
   742→          for (const depRef of options.dependsOn) {
   743→            const depResult = refIndex.resolve(depRef);
   744→            if (!depResult.ok) {
   745→              error(errors.reference.depNotFound(depRef));
   746→              process.exit(EXIT_CODES.NOT_FOUND);
   747→            }
   748→            // Ensure the dependency is a task, not a spec item
   749→            const isTask = tasks.some((t) => t._ulid === depResult.ulid);
   750→            if (!isTask) {
   751→              error(`Reference "${depRef}" is not a task`);
   752→              process.exit(EXIT_CODES.NOT_FOUND);
   753→            }
   754→          }
   755→        }
   756→
   757→        // Validate priority
   758→        const priorityResult = parseIntOption(options.priority, {
   759→          min: 1,
   760→          max: 5,
   761→          name: "Priority",
   762→        });
   763→        if (!priorityResult.ok) {
   764→          error(priorityResult.error);
   765→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   766→        }
   767→
   768→        // AC: @spec-task-add-description ac-6 - Omit description if empty string
   769→        const descriptionValue =
   770→          options.description && options.description.trim() !== ""
   771→            ? options.description
   772→            : undefined;
   773→
   774→        const input: TaskInput = {
   775→          title: options.title,
   776→          description: descriptionValue,
   777→          type: options.type,
   778→          spec_ref: options.specRef ? normalizeRefInput(options.specRef) : null,
   779→          meta_ref: options.metaRef ? normalizeRefInput(options.metaRef) : null,
   780→          plan_ref: options.planRef ? normalizeRefInput(options.planRef) : null,
   781→          priority: priorityResult.value,
   782→          slugs: options.slug ? [options.slug] : [],
   783→          tags: parseTagsArray(options.tag),
   784→          depends_on: (options.dependsOn || []).map(normalizeRefInput),
   785→          automation: automationValue,
   786→        };
   787→
   788→        const newTask = createTask(input);
   789→        await saveTask(ctx, newTask);
   790→        await commitIfShadow(
   791→          ctx.shadow,
   792→          "task-add",
   793→          newTask.slugs[0] || newTask._ulid.slice(0, 8),
   794→          newTask.title,
   795→        );
   796→
   797→        // Build index including the new task for accurate short ULID
   798→        const index = new ReferenceIndex(
   799→          [...tasks, newTask],
   800→          items,
   801→          allMetaItems,
   802→        );
   803→        success(`Created task: ${index.shortUlid(newTask._ulid)}`, {
   804→          task: newTask,
   805→        });
   806→      } catch (err) {
   807→        error(errors.failures.createTask, err);
   808→        process.exit(EXIT_CODES.ERROR);
   809→      }
   810→    });
   811→
   812→  // kspec task set <ref>
   813→  markMutating(task.command("set [ref]"))
   814→    .description("Update task fields")
   815→    .option(
   816→      "--refs <refs...>",
   817→      "Update multiple tasks (AC: @spec-task-set-batch ac-1)",
   818→    )
   819→    .option("--title <title>", "Update task title")
   820→    .option("--spec-ref <ref>", "Link to spec item (use 'null' to clear)")
   821→    .option(
   822→      "--meta-ref <ref>",
   823→      "Link to meta item (use 'null' to clear)",
   824→    )
   825→    .option("--plan-ref <ref>", "Link to plan (use 'null' to clear)")
   826→    .option("--priority <n>", "Set priority (1-5)")
   827→    .option("--slug <slug>", "Add a slug alias")
   828→    .option("--tag <tag...>", "Add tags")
   829→    .option("--depends-on <refs...>", "Set dependencies (replaces existing)")
   830→    .option("--clear-deps", "Clear all dependencies")
   831→    .option(
   832→      "--automation <status>",
   833→      "Set automation eligibility (eligible, needs_review, manual_only)",
   834→    )
   835→    .option("--no-automation", "Clear automation status (return to unassessed)")
   836→    .option(
   837→      "--reason <reason>",
   838→      "Reason for status change (required when setting needs_review)",
   839→    )
   840→    .option(
   841→      "--status <status>",
   842→      "Reject with error - use state transition commands instead",
   843→    )
   844→    .addHelpText(
   845→      "after",
   846→      `
   847→Examples:
   848→  $ kspec task set @task-slug --priority 2
   849→  $ kspec task set @task-slug --depends-on @dep1 @dep2
   850→  $ kspec task set @task-slug --tag cli urgent
   851→  $ kspec task set --refs @task1 @task2 --priority 3`,
   852→    )
   853→    .action(async (ref: string | undefined, options) => {
   854→      try {
   855→        // AC: @spec-task-set-batch ac-3 - Reject --status flag
   856→        if (options.status !== undefined) {
   857→          error(
   858→            "Use state transition commands (start, complete, block, etc.) to change status",
   859→          );
   860→          process.exit(EXIT_CODES.USAGE_ERROR);
   861→        }
   862→
   863→        // AC: @spec-task-clear-deps ac-3 - Mutual exclusivity check
   864→        if (options.clearDeps && options.dependsOn) {
   865→          error("Cannot use --clear-deps and --depends-on together");
   866→          process.exit(EXIT_CODES.USAGE_ERROR);
   867→        }
   868→
   869→        const ctx = await initContext();
   870→        const tasks = await loadAllTasks(ctx);
   871→        const items = await loadAllItems(ctx);
   872→
   873→        // Load meta items for validation
   874→        const { loadMetaContext } = await import("../../parser/meta.js");
   875→        const metaContext = await loadMetaContext(ctx);
   876→        const allMetaItems = [
   877→          ...metaContext.agents,
   878→          ...metaContext.workflows,
   879→          ...metaContext.conventions,
   880→          ...metaContext.observations,
   881→        ];
   882→
   883→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   884→
   885→        // AC: @trait-multi-ref-batch ac-8 - Deduplicate refs
   886→        const refsFlag = options.refs
   887→          ? [...new Set(options.refs as string[])]
   888→          : undefined;
   889→
   890→        // Batch mode or single mode?
   891→        if (refsFlag && refsFlag.length > 0) {
   892→          // Batch mode - AC: @spec-task-set-batch ac-1, ac-2, ac-5
   893→          const result = await executeBatchOperation({
   894→            positionalRef: ref,
   895→            refsFlag,
   896→            context: { ctx, tasks, items, allMetaItems, index, options },
   897→            items: tasks,
   898→            index,
   899→            resolveRef: (
   900→              refStr: string,
   901→              taskList: LoadedTask[],
   902→              idx: ReferenceIndex,
   903→            ) => {
   904→              const result = resolveTaskRefForBatch(refStr, taskList, idx);
   905→              return { item: result.task, error: result.error };
   906→            },
   907→            executeOperation: async (task: LoadedTask, context) => {
   908→              return await setTaskFields(
   909→                task,
   910→                context.ctx,
   911→                context.tasks,
   912→                context.items,
   913→                context.allMetaItems,
   914→                context.index,
   915→                context.options,
   916→              );
   917→            },
   918→            getUlid: (task: LoadedTask) => task._ulid,
   919→          });
   920→
   921→          formatBatchOutput(result, "Set");
   922→        } else {
   923→          // Single mode - existing behavior
   924→          if (!ref) {
   925→            error("Either provide a positional ref or use --refs flag");
   926→            process.exit(EXIT_CODES.USAGE_ERROR);
   927→          }
   928→
   929→          const foundTask = resolveTaskRef(ref, tasks, index);
   930→          const result = await setTaskFields(
   931→            foundTask,
   932→            ctx,
   933→            tasks,
   934→            items,
   935→            allMetaItems,
   936→            index,
   937→            options,
   938→          );
   939→
   940→          if (!result.success) {
   941→            error(result.error || "Failed to update task");
   942→            process.exit(EXIT_CODES.ERROR);
   943→          }
   944→
   945→          if (result.message) {
   946→            // AC: @spec-task-set-batch ac-4 - Warn on no changes
   947→            if (result.message.includes("No changes")) {
   948→              if (isJsonMode()) {
   949→                output({ success: true, message: result.message });
   950→              } else {
   951→                warn(result.message);
   952→              }
   953→            } else {
   954→              success(
   955→                result.message,
   956→                result.data as Record<string, unknown> | undefined,
   957→              );
   958→            }
   959→          }
   960→        }
   961→      } catch (err) {
   962→        error(errors.failures.updateTask, err);
   963→        process.exit(EXIT_CODES.ERROR);
   964→      }
   965→    });
   966→
   967→  // kspec task patch <ref>
   968→  markMutating(task.command("patch <ref>"))
   969→    .description("Update task with JSON data")
   970→    .option("--data <json>", "JSON object with fields to update")
   971→    .option("--dry-run", "Show what would change without writing")
   972→    .option("--allow-unknown", "Allow unknown fields (for extending format)")
   973→    .action(async (ref: string, options) => {
   974→      try {
   975→        const ctx = await initContext();
   976→        const tasks = await loadAllTasks(ctx);
   977→        const items = await loadAllItems(ctx);
   978→
   979→        // Load meta items for validation
   980→        const { loadMetaContext } = await import("../../parser/meta.js");
   981→        const metaContext = await loadMetaContext(ctx);
   982→        const allMetaItems = [
   983→          ...metaContext.agents,
   984→          ...metaContext.workflows,
   985→          ...metaContext.conventions,
   986→          ...metaContext.observations,
   987→        ];
   988→
   989→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   990→        const foundTask = resolveTaskRef(ref, tasks, index);
   991→
   992→        // Get JSON data from --data flag or stdin
   993→        let jsonData: string;
   994→        if (options.data) {
   995→          jsonData = options.data;
   996→        } else {
   997→          // Read from stdin
   998→          const chunks: Buffer[] = [];
   999→          for await (const chunk of process.stdin) {
  1000→            chunks.push(chunk);
  1001→          }
  1002→          jsonData = Buffer.concat(chunks).toString("utf-8");
  1003→        }
  1004→
  1005→        // Parse JSON
  1006→        let patchData: Record<string, unknown>;
  1007→        try {
  1008→          patchData = JSON.parse(jsonData);
  1009→        } catch (parseErr) {
  1010→          error(errors.validation.invalidJson, parseErr);
  1011→          process.exit(EXIT_CODES.ERROR);
  1012→        }
  1013→
  1014→        // Validate against TaskInputSchema (partial)
  1015→        const { TaskInputSchema } = await import("../../schema/index.js");
  1016→
  1017→        // Create a partial schema for validation
  1018→        const partialSchema = options.allowUnknown
  1019→          ? TaskInputSchema.partial().passthrough()
  1020→          : TaskInputSchema.partial().strict();
  1021→
  1022→        let validatedPatch: Partial<TaskInput>;
  1023→        try {
  1024→          validatedPatch = partialSchema.parse(patchData);
  1025→        } catch (validationErr) {
  1026→          error(
  1027→            errors.validation.invalidPatchData(String(validationErr)),
  1028→            validationErr,
  1029→          );
  1030→          process.exit(EXIT_CODES.ERROR);
  1031→        }
  1032→
  1033→        // Check for unknown fields if strict mode
  1034→        if (!options.allowUnknown) {
  1035→          const knownFields = Object.keys(TaskInputSchema.shape);
  1036→          const providedFields = Object.keys(patchData);
  1037→          const unknownFields = providedFields.filter(
  1038→            (f) => !knownFields.includes(f),
  1039→          );
  1040→
  1041→          if (unknownFields.length > 0) {
  1042→            error(errors.validation.unknownFields(unknownFields));
  1043→            process.exit(EXIT_CODES.ERROR);
  1044→          }
  1045→        }
  1046→
  1047→        // Build updated task
  1048→        const updatedTask: Task = { ...foundTask, ...validatedPatch };
  1049→
  1050→        // Track changes for output
  1051→        const changes = Object.keys(validatedPatch);
  1052→
  1053→        if (options.dryRun) {
  1054→          info("Dry run - no changes will be written");
  1055→          info(`Would update: ${changes.join(", ")}`);
  1056→          output({ changes, updated: updatedTask }, () => {
  1057→            console.log(`\nChanges: ${changes.join(", ")}\n`);
  1058→            return formatTaskDetails(updatedTask, index);
  1059→          });
  1060→          return;
  1061→        }
  1062→
  1063→        await saveTask(ctx, updatedTask);
  1064→        await commitIfShadow(
  1065→          ctx.shadow,
  1066→          "task-patch",
  1067→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1068→          changes.join(", "),
  1069→        );
  1070→        success(
  1071→          `Patched task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(", ")})`,
  1072→          { task: updatedTask },
  1073→        );
  1074→      } catch (err) {
  1075→        error(errors.failures.patchTask, err);
  1076→        process.exit(EXIT_CODES.ERROR);
  1077→      }
  1078→    });
  1079→
  1080→  // kspec task start <ref>
  1081→  markMutating(task.command("start <ref>"))
  1082→    .description("Start working on a task (pending|needs_work -> in_progress)")
  1083→    .option("--no-sync", "Skip syncing spec implementation status")
  1084→    .action(async (ref: string, options) => {
  1085→      try {
  1086→        const ctx = await initContext();
  1087→        const tasks = await loadAllTasks(ctx);
  1088→        const items = await loadAllItems(ctx);
  1089→        const index = new ReferenceIndex(tasks, items);
  1090→        const foundTask = resolveTaskRef(ref, tasks, index);
  1091→
  1092→        if (foundTask.status === "in_progress") {
  1093→          warn("Task is already in progress");
  1094→          output(foundTask, () => formatTaskDetails(foundTask));
  1095→          return;
  1096→        }
  1097→
  1098→        if (foundTask.status !== "pending" && foundTask.status !== "needs_work") {
  1099→          error(errors.status.cannotStart(foundTask.status));
  1100→          process.exit(EXIT_CODES.VALIDATION_FAILED); // Exit code 4 = invalid state
  1101→        }
  1102→
  1103→        // Update status
  1104→        const updatedTask: Task = {
  1105→          ...foundTask,
  1106→          status: "in_progress",
  1107→          started_at: new Date().toISOString(),
  1108→        };
  1109→
  1110→        await saveTask(ctx, updatedTask);
  1111→        await commitIfShadow(
  1112→          ctx.shadow,
  1113→          "task-start",
  1114→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1115→        );
  1116→        success(`Started task: ${index.shortUlid(updatedTask._ulid)}`, {
  1117→          task: updatedTask,
  1118→        });
  1119→
  1120→        // Show spec context and AC guidance (suppressed in JSON mode)
  1121→        if (!isJsonMode() && foundTask.spec_ref) {
  1122→          const specResult = index.resolve(foundTask.spec_ref);
  1123→          if (specResult.ok) {
  1124→            const specItem = items.find((i) => i._ulid === specResult.ulid);
  1125→            if (specItem) {
  1126→              console.log("");
  1127→              console.log("--- Spec Context ---");
  1128→              console.log(`Implementing: ${specItem.title}`);
  1129→              if (specItem.description) {
  1130→                console.log(`\n${specItem.description}`);
  1131→              }
  1132→
  1133→              if (
  1134→                specItem.acceptance_criteria &&
  1135→                specItem.acceptance_criteria.length > 0
  1136→              ) {
  1137→                console.log(
  1138→                  `\nAcceptance Criteria (${specItem.acceptance_criteria.length}):`,
  1139→                );
  1140→                for (const ac of specItem.acceptance_criteria) {
  1141→                  console.log(`  [${ac.id}]`);
  1142→                  console.log(`    Given: ${ac.given}`);
  1143→                  console.log(`    When: ${ac.when}`);
  1144→                  console.log(`    Then: ${ac.then}`);
  1145→                }
  1146→                console.log("");
  1147→                console.log(
  1148→                  "Remember: Add test coverage for each AC and mark tests with // AC: @spec-ref ac-N",
  1149→                );
  1150→              }
  1151→              console.log("");
  1152→            }
  1153→          }
  1154→        }
  1155→
  1156→        // Sync spec implementation status (unless --no-sync)
  1157→        if (options.sync !== false && foundTask.spec_ref) {
  1158→          const updatedTasks = tasks.map((t) =>
  1159→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t,
  1160→          );
  1161→          const syncResult = await syncSpecImplementationStatus(
  1162→            ctx,
  1163→            updatedTask as LoadedTask,
  1164→            updatedTasks as LoadedTask[],
  1165→            items,
  1166→            index,
  1167→          );
  1168→          if (syncResult) {
  1169→            info(
  1170→              `Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1171→            );
  1172→            // Commit the spec status change
  1173→            await commitIfShadow(
  1174→              ctx.shadow,
  1175→              "spec-sync",
  1176→              syncResult.specUlid.slice(0, 8),
  1177→              `${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1178→            );
  1179→          }
  1180→        }
  1181→      } catch (err) {
  1182→        error(errors.failures.startTask, err);
  1183→        process.exit(EXIT_CODES.ERROR);
  1184→      }
  1185→    });
  1186→
  1187→  // kspec task complete <ref> | --refs <refs...>
  1188→  // AC: @multi-ref-batch ac-1 - Basic multi-ref syntax
  1189→  // AC: @multi-ref-batch ac-2 - Backward compatibility
  1190→  markMutating(task.command("complete [ref]"))
  1191→    .description("Complete a task (pending_review -> completed)")
  1192→    .option("--refs <refs...>", "Complete multiple tasks by ref")
  1193→    .option("--reason <reason>", "Completion reason/notes")
  1194→    .option("--skip-review", "Skip review requirement (requires --reason)")
  1195→    .option(
  1196→      "--force",
  1197→      "Force completion from any state (bypasses submit requirement)",
  1198→    )
  1199→    .option("--no-sync", "Skip syncing spec implementation status")
  1200→    .addHelpText(
  1201→      "after",
  1202→      `
  1203→Examples:
  1204→  $ kspec task complete @task-slug --reason "Merged in PR #123"
  1205→  $ kspec task complete @task-slug --force --reason "Design task, no code to review"
  1206→  $ kspec task complete --refs @task1 @task2 --reason "Batch completion"`,
  1207→    )
  1208→    .action(async (ref: string | undefined, options) => {
  1209→      try {
  1210→        const ctx = await initContext();
  1211→        const tasks = await loadAllTasks(ctx);
  1212→        const items = await loadAllItems(ctx);
  1213→        const index = new ReferenceIndex(tasks, items);
  1214→
  1215→        // AC: @spec-completion-enforcement ac-8
  1216→        if (options.skipReview && !options.reason) {
  1217→          error(errors.status.skipReviewRequiresReason);
  1218→          process.exit(EXIT_CODES.ERROR);
  1219→        }
  1220→
  1221→        // AC: @multi-ref-batch ac-1, ac-2, ac-3, ac-4
  1222→        const result = await executeBatchOperation({
  1223→          positionalRef: ref,
  1224→          refsFlag: options.refs,
  1225→          context: { ctx, tasks, items, index, options },
  1226→          items: tasks,
  1227→          index,
  1228→          resolveRef: (refStr, taskList, idx) => {
  1229→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1230→            return { item: resolved.task, error: resolved.error };
  1231→          },
  1232→          executeOperation: async (
  1233→            foundTask,
  1234→            { ctx, tasks, items, index, options },
  1235→          ) => {
  1236→            try {
  1237→              // AC: @spec-completion-enforcement ac-6
  1238→              if (foundTask.status === "completed") {
  1239→                return {
  1240→                  success: false,
  1241→                  error: errors.status.completeAlreadyCompleted,
  1242→                };
  1243→              }
  1244→
  1245→              // AC: @task-commands ac-1 - Allow --force to bypass all state checks
  1246→              const forcingCompletion = options.force;
  1247→
  1248→              // AC: @spec-completion-enforcement ac-7 - Allow skip-review bypass
  1249→              if (!options.skipReview && !forcingCompletion) {
  1250→                // AC: @spec-completion-enforcement ac-2
  1251→                if (foundTask.status === "in_progress") {
  1252→                  return {
  1253→                    success: false,
  1254→                    error: errors.status.completeRequiresReview,
  1255→                  };
  1256→                }
  1257→
  1258→                // AC: @spec-completion-enforcement ac-3
  1259→                if (foundTask.status === "pending") {
  1260→                  return {
  1261→                    success: false,
  1262→                    error: errors.status.completeRequiresStart,
  1263→                  };
  1264→                }
  1265→
  1266→                // AC: @spec-completion-enforcement ac-4
  1267→                if (foundTask.status === "blocked") {
  1268→                  return {
  1269→                    success: false,
  1270→                    error: errors.status.completeBlockedTask,
  1271→                  };
  1272→                }
  1273→
  1274→                // AC: @spec-completion-enforcement ac-5
  1275→                if (foundTask.status === "cancelled") {
  1276→                  return {
  1277→                    success: false,
  1278→                    error: errors.status.completeCancelledTask,
  1279→                  };
  1280→                }
  1281→
  1282→                // AC: @spec-completion-enforcement ac-1 - Only pending_review allowed
  1283→                if (foundTask.status !== "pending_review") {
  1284→                  return {
  1285→                    success: false,
  1286→                    error: errors.status.cannotComplete(foundTask.status),
  1287→                  };
  1288→                }
  1289→              }
  1290→
  1291→              const now = new Date().toISOString();
  1292→
  1293→              // AC: @spec-completion-enforcement ac-7 - Document skip-review reason
  1294→              // AC: @spec-completion-enforcement ac-author
  1295→              let taskNotes = foundTask.notes;
  1296→              if (options.skipReview && options.reason) {
  1297→                const skipNote = createNote(
  1298→                  `Completed with --skip-review: ${options.reason}`,
  1299→                  getAuthor(ctx.config?.identity?.author),
  1300→                );
  1301→                taskNotes = [...taskNotes, skipNote];
  1302→              }
  1303→
  1304→              // AC: @task-commands ac-1 - Document force completion from non-standard state
  1305→              const forcedFromNonStandard =
  1306→                forcingCompletion &&
  1307→                foundTask.status !== "pending_review";
  1308→              let forceStateDetail: string | undefined;
  1309→              if (forcedFromNonStandard) {
  1310→                forceStateDetail = `from ${foundTask.status} state`;
  1311→                if (foundTask.status === "blocked") {
  1312→                  const blockedBy = foundTask.blocked_by.join("; ");
  1313→                  forceStateDetail += `. Was blocked by: ${blockedBy || "(dependency-blocked)"}`;
  1314→                }
  1315→                let forceMessage = `Completed with --force ${forceStateDetail}`;
  1316→                if (options.reason) {
  1317→                  forceMessage += `. Reason: ${options.reason}`;
  1318→                }
  1319→                const forceNote = createNote(
  1320→                  forceMessage,
  1321→                  getAuthor(ctx.config?.identity?.author),
  1322→                );
  1323→                taskNotes = [...taskNotes, forceNote];
  1324→              }
  1325→
  1326→              // Update status
  1327→              const updatedTask: Task = {
  1328→                ...foundTask,
  1329→                status: "completed",
  1330→                completed_at: now,
  1331→                closed_reason: options.reason || null,
  1332→                started_at: foundTask.started_at || now,
  1333→                notes: taskNotes,
  1334→              };
  1335→
  1336→              await saveTask(ctx, updatedTask);
  1337→              await commitIfShadow(
  1338→                ctx.shadow,
  1339→                "task-complete",
  1340→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1341→                options.reason,
  1342→              );
  1343→
  1344→              // Sync spec implementation status (unless --no-sync)
  1345→              if (options.sync !== false && foundTask.spec_ref) {
  1346→                const updatedTasks = tasks.map((t) =>
  1347→                  t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t,
  1348→                );
  1349→                const syncResult = await syncSpecImplementationStatus(
  1350→                  ctx,
  1351→                  updatedTask as LoadedTask,
  1352→                  updatedTasks as LoadedTask[],
  1353→                  items,
  1354→                  index,
  1355→                );
  1356→                if (syncResult && !isJsonMode()) {
  1357→                  info(
  1358→                    `Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1359→                  );
  1360→                  await commitIfShadow(
  1361→                    ctx.shadow,
  1362→                    "spec-sync",
  1363→                    syncResult.specUlid.slice(0, 8),
  1364→                    `${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1365→                  );
  1366→                }
  1367→              }
  1368→
  1369→              // Show AC reminder for single-ref mode only (not in batch)
  1370→              if (!options.refs && foundTask.spec_ref && !isJsonMode()) {
  1371→                const specResult = index.resolve(foundTask.spec_ref);
  1372→                if (specResult.ok && specResult.item) {
  1373→                  const specItem = items.find(
  1374→                    (i) => i._ulid === specResult.ulid,
  1375→                  );
  1376→                  if (
  1377→                    specItem?.acceptance_criteria &&
  1378→                    specItem.acceptance_criteria.length > 0
  1379→                  ) {
  1380→                    const count = specItem.acceptance_criteria.length;
  1381→                    console.log(
  1382→                      `\n⚠ Linked spec ${foundTask.spec_ref} has ${count} acceptance criteri${count === 1 ? "on" : "a"} - verify they are covered\n`,
  1383→                    );
  1384→                  }
  1385→                }
  1386→              }
  1387→
  1388→              // AC: @task-commands ac-1 - Show warning when force-completing from non-standard state
  1389→              let warningMsg: string | undefined;
  1390→              if (forcedFromNonStandard) {
  1391→                warningMsg = `Task was force-completed ${forceStateDetail}`;
  1392→                if (!isJsonMode()) {
  1393→                  warn(warningMsg);
  1394→                }
  1395→              }
  1396→
  1397→              return {
  1398→                success: true,
  1399→                message: `Completed task: ${index.shortUlid(updatedTask._ulid)}`,
  1400→                data: updatedTask,
  1401→                ...(warningMsg && { warning: warningMsg }),
  1402→              };
  1403→            } catch (err) {
  1404→              return {
  1405→                success: false,
  1406→                error: err instanceof Error ? err.message : String(err),
  1407→              };
  1408→            }
  1409→          },
  1410→          getUlid: (task) => task._ulid,
  1411→        });
  1412→
  1413→        // AC: @multi-ref-batch ac-5, ac-6
  1414→        formatBatchOutput(result, "Complete");
  1415→
  1416→        // Show commit guidance for single-ref mode only
  1417→        if (
  1418→          !options.refs &&
  1419→          result.success &&
  1420→          result.results.length === 1 &&
  1421→          !isJsonMode()
  1422→        ) {
  1423→          const taskData = result.results[0].data as Task | undefined;
  1424→          if (taskData) {
  1425→            const guidance = formatCommitGuidance(taskData);
  1426→            printCommitGuidance(guidance);
  1427→          }
  1428→        }
  1429→      } catch (err) {
  1430→        error(errors.failures.completeTask, err);
  1431→        process.exit(EXIT_CODES.ERROR);
  1432→      }
  1433→    });
  1434→
  1435→  // kspec task submit <ref>
  1436→  // Transitions in_progress → pending_review (code done, awaiting merge)
  1437→  markMutating(task.command("submit <ref>"))
  1438→    .description("Submit task for review (transitions to pending_review)")
  1439→    .action(async (ref: string) => {
  1440→      try {
  1441→        const ctx = await initContext();
  1442→        const tasks = await loadAllTasks(ctx);
  1443→        const items = await loadAllItems(ctx);
  1444→        const index = new ReferenceIndex(tasks, items);
  1445→        const foundTask = resolveTaskRef(ref, tasks, index);
  1446→
  1447→        if (foundTask.status !== "in_progress") {
  1448→          error(
  1449→            `Cannot submit task with status: ${foundTask.status}. Task must be in_progress.`,
  1450→          );
  1451→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1452→        }
  1453→
  1454→        const updatedTask: Task = {
  1455→          ...foundTask,
  1456→          status: "pending_review",
  1457→          submitted_at: new Date().toISOString(),
  1458→        };
  1459→
  1460→        await saveTask(ctx, updatedTask);
  1461→        await commitIfShadow(
  1462→          ctx.shadow,
  1463→          "task-submit",
  1464→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1465→        );
  1466→        success(
  1467→          `Submitted task for review: ${index.shortUlid(updatedTask._ulid)}`,
  1468→          { task: updatedTask },
  1469→        );
  1470→      } catch (err) {
  1471→        error(errors.failures.updateTask, err);
  1472→        process.exit(EXIT_CODES.ERROR);
  1473→      }
  1474→    });
  1475→
  1476→  // kspec task needs-work <ref>
  1477→  // Reviewer kicks back a task for worker to fix
  1478→  markMutating(task.command("needs-work <ref>"))
  1479→    .description(
  1480→      "Kick task back to worker for fixes (pending_review -> needs_work)",
  1481→    )
  1482→    .requiredOption("--reason <reason>", "Description of issues found")
  1483→    .action(async (ref: string, options) => {
  1484→      try {
  1485→        const ctx = await initContext();
  1486→        const tasks = await loadAllTasks(ctx);
  1487→        const items = await loadAllItems(ctx);
  1488→        const index = new ReferenceIndex(tasks, items);
  1489→        const foundTask = resolveTaskRef(ref, tasks, index);
  1490→
  1491→        if (foundTask.status !== "pending_review") {
  1492→          error(errors.status.cannotNeedsWork(foundTask.status));
  1493→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1494→        }
  1495→
  1496→        // Track fix cycle count from existing kickback notes
  1497→        const existingKickbacks = foundTask.notes.filter((n) =>
  1498→          n.content.includes("[FIX_CYCLE:"),
  1499→        ).length;
  1500→        const cycleNumber = existingKickbacks + 1;
  1501→
  1502→        const note = createNote(
  1503→          `[FIX_CYCLE: ${cycleNumber}] Review findings: ${options.reason}`,
  1504→          getAuthor(ctx.config?.identity?.author),
  1505→        );
  1506→
  1507→        const updatedTask: Task = {
  1508→          ...foundTask,
  1509→          status: "needs_work",
  1510→          notes: [...foundTask.notes, note],
  1511→        };
  1512→
  1513→        await saveTask(ctx, updatedTask);
  1514→        await commitIfShadow(
  1515→          ctx.shadow,
  1516→          "task-needs-work",
  1517→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1518→          `cycle ${cycleNumber}`,
  1519→        );
  1520→        success(
  1521→          `Kicked back task: ${index.shortUlid(updatedTask._ulid)} (fix cycle ${cycleNumber})`,
  1522→          { task: updatedTask },
  1523→        );
  1524→      } catch (err) {
  1525→        error(errors.failures.needsWorkTask, err);
  1526→        process.exit(EXIT_CODES.ERROR);
  1527→      }
  1528→    });
  1529→
  1530→  // kspec task block <ref>
  1531→  markMutating(task.command("block <ref>"))
  1532→    .description("Block a task")
  1533→    .requiredOption("--reason <reason>", "Reason for blocking")
  1534→    .action(async (ref: string, options) => {
  1535→      try {
  1536→        const ctx = await initContext();
  1537→        const tasks = await loadAllTasks(ctx);
  1538→        const items = await loadAllItems(ctx);
  1539→        const index = new ReferenceIndex(tasks, items);
  1540→        const foundTask = resolveTaskRef(ref, tasks, index);
  1541→
  1542→        if (
  1543→          foundTask.status === "completed" ||
  1544→          foundTask.status === "cancelled"
  1545→        ) {
  1546→          error(errors.status.cannotBlock(foundTask.status));
  1547→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1548→        }
  1549→
  1550→        const updatedTask: Task = {
  1551→          ...foundTask,
  1552→          status: "blocked",
  1553→          blocked_by: [...foundTask.blocked_by, options.reason],
  1554→        };
  1555→
  1556→        await saveTask(ctx, updatedTask);
  1557→        await commitIfShadow(
  1558→          ctx.shadow,
  1559→          "task-block",
  1560→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1561→        );
  1562→        success(`Blocked task: ${index.shortUlid(updatedTask._ulid)}`, {
  1563→          task: updatedTask,
  1564→        });
  1565→      } catch (err) {
  1566→        error(errors.failures.blockTask, err);
  1567→        process.exit(EXIT_CODES.ERROR);
  1568→      }
  1569→    });
  1570→
  1571→  // kspec task unblock <ref>
  1572→  markMutating(task.command("unblock <ref>"))
  1573→    .description("Unblock a task")
  1574→    .action(async (ref: string) => {
  1575→      try {
  1576→        const ctx = await initContext();
  1577→        const tasks = await loadAllTasks(ctx);
  1578→        const items = await loadAllItems(ctx);
  1579→        const index = new ReferenceIndex(tasks, items);
  1580→        const foundTask = resolveTaskRef(ref, tasks, index);
  1581→
  1582→        if (foundTask.status !== "blocked") {
  1583→          warn("Task is not blocked");
  1584→          return;
  1585→        }
  1586→
  1587→        const updatedTask: Task = {
  1588→          ...foundTask,
  1589→          status: "pending",
  1590→          blocked_by: [],
  1591→        };
  1592→
  1593→        await saveTask(ctx, updatedTask);
  1594→        await commitIfShadow(
  1595→          ctx.shadow,
  1596→          "task-unblock",
  1597→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1598→        );
  1599→        success(`Unblocked task: ${index.shortUlid(updatedTask._ulid)}`, {
  1600→          task: updatedTask,
  1601→        });
  1602→      } catch (err) {
  1603→        error(errors.failures.unblockTask, err);
  1604→        process.exit(EXIT_CODES.ERROR);
  1605→      }
  1606→    });
  1607→
  1608→  // kspec task cancel <ref> | --refs <refs...>
  1609→  // AC: @multi-ref-batch ac-1, ac-2
  1610→  markMutating(task.command("cancel [ref]"))
  1611→    .description("Cancel a task")
  1612→    .option("--refs <refs...>", "Cancel multiple tasks by ref")
  1613→    .option("--reason <reason>", "Cancellation reason")
  1614→    .addHelpText(
  1615→      "after",
  1616→      `
  1617→Examples:
  1618→  $ kspec task cancel @task-slug --reason "No longer needed"
  1619→  $ kspec task cancel --refs @task1 @task2 --reason "Superseded by @new-task"`,
  1620→    )
  1621→    .action(async (ref: string | undefined, options) => {
  1622→      try {
  1623→        const ctx = await initContext();
  1624→        const tasks = await loadAllTasks(ctx);
  1625→        const items = await loadAllItems(ctx);
  1626→        const index = new ReferenceIndex(tasks, items);
  1627→
  1628→        const result = await executeBatchOperation({
  1629→          positionalRef: ref,
  1630→          refsFlag: options.refs,
  1631→          context: { ctx, tasks, items, index, options },
  1632→          items: tasks,
  1633→          index,
  1634→          resolveRef: (refStr, taskList, idx) => {
  1635→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1636→            return { item: resolved.task, error: resolved.error };
  1637→          },
  1638→          executeOperation: async (foundTask, { ctx, index, options }) => {
  1639→            try {
  1640→              if (
  1641→                foundTask.status === "completed" ||
  1642→                foundTask.status === "cancelled"
  1643→              ) {
  1644→                return {
  1645→                  success: false,
  1646→                  error: `Task is already ${foundTask.status}`,
  1647→                };
  1648→              }
  1649→
  1650→              const updatedTask: Task = {
  1651→                ...foundTask,
  1652→                status: "cancelled",
  1653→                closed_reason: options.reason || null,
  1654→              };
  1655→
  1656→              await saveTask(ctx, updatedTask);
  1657→              await commitIfShadow(
  1658→                ctx.shadow,
  1659→                "task-cancel",
  1660→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1661→              );
  1662→
  1663→              return {
  1664→                success: true,
  1665→                message: `Cancelled task: ${index.shortUlid(updatedTask._ulid)}`,
  1666→                data: updatedTask,
  1667→              };
  1668→            } catch (err) {
  1669→              return {
  1670→                success: false,
  1671→                error: err instanceof Error ? err.message : String(err),
  1672→              };
  1673→            }
  1674→          },
  1675→          getUlid: (task) => task._ulid,
  1676→        });
  1677→
  1678→        formatBatchOutput(result, "Cancel");
  1679→      } catch (err) {
  1680→        error(errors.failures.cancelTask, err);
  1681→        process.exit(EXIT_CODES.ERROR);
  1682→      }
  1683→    });
  1684→
  1685→  // kspec task reset <ref>
  1686→  // AC: @spec-task-reset ac-1, ac-2, ac-3, ac-4, ac-5, ac-6
  1687→  markMutating(task.command("reset <ref>"))
  1688→    .description("Reset a task to pending state")
  1689→    .action(async (ref: string) => {
  1690→      try {
  1691→        const ctx = await initContext();
  1692→        const tasks = await loadAllTasks(ctx);
  1693→        const items = await loadAllItems(ctx);
  1694→        const index = new ReferenceIndex(tasks, items);
  1695→        const foundTask = resolveTaskRef(ref, tasks, index);
  1696→
  1697→        // AC: @spec-task-reset ac-2 - Error if already pending
  1698→        if (foundTask.status === "pending") {
  1699→          error("Task is already pending");
  1700→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1701→        }
  1702→
  1703→        // Track previous status and reason for note (AC-4)
  1704→        const previousStatus = foundTask.status;
  1705→        const hadCancelReason =
  1706→          foundTask.closed_reason && foundTask.status === "cancelled";
  1707→        const cancelReasonText = hadCancelReason
  1708→          ? ` (was cancelled: ${foundTask.closed_reason})`
  1709→          : "";
  1710→
  1711→        // AC: @spec-task-reset ac-1 - Reset to pending, clear completion-related fields
  1712→        const clearedFields: string[] = [];
  1713→        const updatedTask: Task = {
  1714→          ...foundTask,
  1715→          status: "pending",
  1716→        };
  1717→
  1718→        // Clear timestamps and reasons based on previous status
  1719→        if (
  1720→          foundTask.completed_at !== undefined &&
  1721→          foundTask.completed_at !== null
  1722→        ) {
  1723→          updatedTask.completed_at = null;
  1724→          clearedFields.push("completed_at");
  1725→        }
  1726→        if (
  1727→          foundTask.started_at !== undefined &&
  1728→          foundTask.started_at !== null
  1729→        ) {
  1730→          updatedTask.started_at = null;
  1731→          clearedFields.push("started_at");
  1732→        }
  1733→        if (
  1734→          foundTask.closed_reason !== undefined &&
  1735→          foundTask.closed_reason !== null
  1736→        ) {
  1737→          updatedTask.closed_reason = null;
  1738→          clearedFields.push("closed_reason");
  1739→        }
  1740→        if (foundTask.blocked_by.length > 0) {
  1741→          updatedTask.blocked_by = [];
  1742→          clearedFields.push("blocked_by");
  1743→        }
  1744→
  1745→        // AC: @spec-task-reset ac-4 - Add note documenting the reset
  1746→        // AC: @spec-task-reset ac-author
  1747→        const noteContent = `Reset from ${previousStatus} to pending${cancelReasonText}`;
  1748→        const note = createNote(noteContent, getAuthor(ctx.config?.identity?.author));
  1749→        updatedTask.notes = [...updatedTask.notes, note];
  1750→
  1751→        await saveTask(ctx, updatedTask);
  1752→        // AC: @spec-task-reset ac-3 - Shadow commit with message task-reset
  1753→        await commitIfShadow(
  1754→          ctx.shadow,
  1755→          "task-reset",
  1756→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1757→          `from ${previousStatus}`,
  1758→        );
  1759→
  1760→        // AC: @spec-task-reset ac-6 - JSON output includes previous_status, new_status, cleared_fields
  1761→        const jsonOutput = {
  1762→          task: updatedTask,
  1763→          previous_status: previousStatus,
  1764→          new_status: "pending" as const,
  1765→          cleared_fields: clearedFields,
  1766→        };
  1767→
  1768→        output(jsonOutput, () => {
  1769→          success(
  1770→            `Reset task: ${index.shortUlid(updatedTask._ulid)} (${previousStatus} → pending)`,
  1771→            undefined,
  1772→          );
  1773→          if (clearedFields.length > 0) {
  1774→            info(`Cleared fields: ${clearedFields.join(", ")}`);
  1775→          }
  1776→        });
  1777→      } catch (err) {
  1778→        error("Failed to reset task", err);
  1779→        process.exit(EXIT_CODES.ERROR);
  1780→      }
  1781→    });
  1782→
  1783→  // kspec task delete <ref> | --refs <refs...>
  1784→  // AC: @multi-ref-batch ac-1, ac-2
  1785→  markMutating(task.command("delete [ref]"))
  1786→    .description("Delete a task permanently")
  1787→    .option("--refs <refs...>", "Delete multiple tasks by ref")
  1788→    .option("--force", "Skip confirmation (required for --refs)")
  1789→    .option("--dry-run", "Show what would be deleted without deleting")
  1790→    .addHelpText(
  1791→      "after",
  1792→      `
  1793→Examples:
  1794→  $ kspec task delete @task-slug
  1795→  $ kspec task delete --refs @task1 @task2 --force
  1796→  $ kspec task delete --refs @task1 @task2 --dry-run`,
  1797→    )
  1798→    .action(async (ref: string | undefined, options) => {
  1799→      try {
  1800→        const ctx = await initContext();
  1801→        const tasks = await loadAllTasks(ctx);
  1802→        const items = await loadAllItems(ctx);
  1803→        const index = new ReferenceIndex(tasks, items);
  1804→
  1805→        // For batch mode (--refs), require --force
  1806→        if (
  1807→          options.refs &&
  1808→          options.refs.length > 0 &&
  1809→          !options.force &&
  1810→          !options.dryRun
  1811→        ) {
  1812→          error("Batch delete requires --force flag");
  1813→          process.exit(EXIT_CODES.USAGE_ERROR);
  1814→        }
  1815→
  1816→        const result = await executeBatchOperation({
  1817→          positionalRef: ref,
  1818→          refsFlag: options.refs,
  1819→          context: { ctx, tasks, items, index, options },
  1820→          items: tasks,
  1821→          index,
  1822→          resolveRef: (refStr, taskList, idx) => {
  1823→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1824→            return { item: resolved.task, error: resolved.error };
  1825→          },
  1826→          executeOperation: async (foundTask, { ctx, index, options }) => {
  1827→            try {
  1828→              const taskDisplay = `${foundTask.title} (${index.shortUlid(foundTask._ulid)})`;
  1829→
  1830→              if (options.dryRun) {
  1831→                return {
  1832→                  success: true,
  1833→                  message: `Would delete: ${taskDisplay}`,
  1834→                };
  1835→              }
  1836→
  1837→              // For single-ref mode (not --refs), prompt for confirmation unless --force
  1838→              if (!options.refs && !options.force) {
  1839→                const readline = await import("node:readline");
  1840→                const rl = readline.createInterface({
  1841→                  input: process.stdin,
  1842→                  output: process.stdout,
  1843→                });
  1844→
  1845→                const answer = await new Promise<string>((resolve) => {
  1846→                  rl.question(`Delete task "${taskDisplay}"? [y/N] `, resolve);
  1847→                });
  1848→                rl.close();
  1849→
  1850→                if (answer.toLowerCase() !== "y") {
  1851→                  return {
  1852→                    success: false,
  1853→                    error: "Deletion cancelled by user",
  1854→                  };
  1855→                }
  1856→              }
  1857→
  1858→              await deleteTask(ctx, foundTask);
  1859→              await commitIfShadow(
  1860→                ctx.shadow,
  1861→                "task-delete",
  1862→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1863→                foundTask.title,
  1864→              );
  1865→
  1866→              return {
  1867→                success: true,
  1868→                message: `Deleted task: ${taskDisplay}`,
  1869→              };
  1870→            } catch (err) {
  1871→              return {
  1872→                success: false,
  1873→                error: err instanceof Error ? err.message : String(err),
  1874→              };
  1875→            }
  1876→          },
  1877→          getUlid: (task) => task._ulid,
  1878→        });
  1879→
  1880→        formatBatchOutput(result, "Delete");
  1881→      } catch (err) {
  1882→        error(errors.failures.deleteTask, err);
  1883→        process.exit(EXIT_CODES.ERROR);
  1884→      }
  1885→    });
  1886→
  1887→  // kspec task note <ref> <message>
  1888→  markMutating(task.command("note <ref> <message>"))
  1889→    .description("Add a note to a task")
  1890→    .option("--author <author>", "Note author")
  1891→    .option("--supersedes <ulid>", "ULID of note this supersedes")
  1892→    .action(async (ref: string, message: string, options) => {
  1893→      try {
  1894→        const ctx = await initContext();
  1895→        const tasks = await loadAllTasks(ctx);
  1896→        const items = await loadAllItems(ctx);
  1897→        const index = new ReferenceIndex(tasks, items);
  1898→        const foundTask = resolveTaskRef(ref, tasks, index);
  1899→
  1900→        const note = createNote(message, options.author, options.supersedes);
  1901→
  1902→        const updatedTask: Task = {
