  1912→        );
  1913→        success(`Added note to task: ${index.shortUlid(updatedTask._ulid)}`, {
  1914→          note,
  1915→        });
  1916→
  1917→        // Proactive alignment guidance for tasks with spec_ref
  1918→        if (foundTask.spec_ref) {
  1919→          console.log("");
  1920→          console.log(alignmentCheck.header);
  1921→          console.log(alignmentCheck.beyondSpec);
  1922→          console.log(alignmentCheck.updateSpec(foundTask.spec_ref));
  1923→          console.log(alignmentCheck.addAC);
  1924→
  1925→          // Check if linked spec has acceptance criteria and remind about test coverage
  1926→          const specResult = index.resolve(foundTask.spec_ref);
  1927→          if (specResult.ok && specResult.item) {
  1928→            const specItem = specResult.item as {
  1929→              acceptance_criteria?: unknown[];
  1930→            };
  1931→            if (
  1932→              specItem.acceptance_criteria &&
  1933→              specItem.acceptance_criteria.length > 0
  1934→            ) {
  1935→              console.log("");
  1936→              console.log(
  1937→                alignmentCheck.testCoverage(
  1938→                  specItem.acceptance_criteria.length,
  1939→                ),
  1940→              );
  1941→            }
  1942→          }
  1943→        }
  1944→      } catch (err) {
  1945→        error(errors.failures.addNote, err);
  1946→        process.exit(EXIT_CODES.ERROR);
  1947→      }
  1948→    });
