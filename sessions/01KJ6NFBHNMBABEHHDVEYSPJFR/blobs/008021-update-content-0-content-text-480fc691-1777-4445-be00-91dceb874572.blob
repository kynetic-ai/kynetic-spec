  1979→
  1980→  // kspec task review <ref>
  1981→  task
  1982→    .command("review <ref>")
  1983→    .description(
  1984→      "Get task context for review (task details, spec, ACs, git diff)",
  1985→    )
  1986→    .action(async (ref: string) => {
  1987→      try {
  1988→        const ctx = await initContext();
  1989→        const tasks = await loadAllTasks(ctx);
  1990→        const items = await loadAllItems(ctx);
  1991→        const index = new ReferenceIndex(tasks, items);
  1992→        const foundTask = resolveTaskRef(ref, tasks, index);
  1993→
  1994→        // Import getDiffSince from utils
  1995→        const { getDiffSince } = await import("../../utils/index.js");
  1996→
  1997→        // Gather review context
  1998→        const reviewContext: {
  1999→          task: typeof foundTask;
  2000→          spec: LoadedSpecItem | null;
  2001→          diff: string | null;
  2002→          started_at: string | null;
  2003→          testCoverage?: { covered: string[]; uncovered: string[] };
  2004→        } = {
  2005→          task: foundTask,
  2006→          spec: null,
  2007→          diff: null,
  2008→          started_at: foundTask.started_at || null,
  2009→        };
  2010→
  2011→        // Get spec item if task has spec_ref
  2012→        if (foundTask.spec_ref) {
  2013→          const specResult = index.resolve(foundTask.spec_ref);
  2014→          if (specResult.ok) {
  2015→            const specItem = items.find((i) => i._ulid === specResult.ulid);
  2016→            reviewContext.spec = specItem || null;
  2017→
  2018→            // Check test coverage for ACs if spec has them
  2019→            if (
  2020→              specItem?.acceptance_criteria &&
  2021→              specItem.acceptance_criteria.length > 0
  2022→            ) {
  2023→              const coveredACs = await scanTestCoverage(ctx.rootDir);
  2024→              const covered: string[] = [];
  2025→              const uncovered: string[] = [];
  2026→
  2027→              for (const ac of specItem.acceptance_criteria) {
  2028→                // Build possible references
  2029→                const possibleRefs: string[] = [];
  2030→                if (specItem.slugs && specItem.slugs.length > 0) {
  2031→                  possibleRefs.push(`@${specItem.slugs[0]} ${ac.id}`);
  2032→                  possibleRefs.push(`@${specItem.slugs[0]}`);
  2033→                }
  2034→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)} ${ac.id}`);
  2035→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)}`);
  2036→
  2037→                const isCovered = possibleRefs.some((ref) =>
  2038→                  coveredACs.has(ref),
  2039→                );
  2040→                if (isCovered) {
  2041→                  covered.push(ac.id);
  2042→                } else {
  2043→                  uncovered.push(ac.id);
  2044→                }
  2045→              }
  2046→
  2047→              reviewContext.testCoverage = { covered, uncovered };
  2048→            }
  2049→          }
  2050→        }
  2051→
  2052→        // Get git diff since task started
  2053→        if (foundTask.started_at) {
  2054→          const startedDate = new Date(foundTask.started_at);
  2055→          reviewContext.diff = getDiffSince(startedDate, ctx.rootDir);
  2056→        }
  2057→
  2058→        output(reviewContext, () => {
  2059→          console.log("=".repeat(60));
  2060→          console.log("Task Review Context");
  2061→          console.log("=".repeat(60));
  2062→          console.log();
  2063→
  2064→          // Task details
  2065→          console.log("TASK DETAILS");
  2066→          console.log("-".repeat(60));
  2067→          console.log(formatTaskDetails(foundTask, index));
  2068→          console.log();
  2069→
  2070→          // Spec details
  2071→          if (reviewContext.spec) {
  2072→            console.log("LINKED SPEC");
  2073→            console.log("-".repeat(60));
  2074→            console.log(`Title: ${reviewContext.spec.title}`);
  2075→            console.log(`Type: ${reviewContext.spec.type}`);
  2076→            if (reviewContext.spec.description) {
  2077→              console.log(`\nDescription:\n${reviewContext.spec.description}`);
  2078→            }
  2079→            if (
  2080→              reviewContext.spec.acceptance_criteria &&
  2081→              reviewContext.spec.acceptance_criteria.length > 0
  2082→            ) {
  2083→              console.log(
  2084→                `\nAcceptance Criteria (${reviewContext.spec.acceptance_criteria.length}):`,
  2085→              );
  2086→              for (const ac of reviewContext.spec.acceptance_criteria) {
  2087→                const isCovered = reviewContext.testCoverage?.covered.includes(
  2088→                  ac.id,
  2089→                );
  2090→                const coverageMarker = isCovered
  2091→                  ? chalk.green("✓")
  2092→                  : chalk.yellow("○");
  2093→                console.log(`  ${coverageMarker} [${ac.id}]`);
  2094→                console.log(`    Given: ${ac.given}`);
  2095→                console.log(`    When: ${ac.when}`);
  2096→                console.log(`    Then: ${ac.then}`);
  2097→              }
  2098→
  2099→              // Test coverage summary
  2100→              if (reviewContext.testCoverage) {
  2101→                const { covered, uncovered } = reviewContext.testCoverage;
  2102→                console.log();
  2103→                if (uncovered.length === 0) {
  2104→                  console.log(
  2105→                    chalk.green(
  2106→                      `  ✓ All ${covered.length} AC(s) have test coverage`,
  2107→                    ),
  2108→                  );
  2109→                } else {
  2110→                  console.log(
  2111→                    chalk.yellow(
  2112→                      `  Test coverage: ${covered.length}/${covered.length + uncovered.length} ACs covered`,
  2113→                    ),
  2114→                  );
  2115→                  console.log(
  2116→                    chalk.yellow(
  2117→                      `  Missing coverage for: ${uncovered.join(", ")}`,
  2118→                    ),
  2119→                  );
  2120→                }
  2121→              }
  2122→            }
  2123→            console.log();
  2124→          }
  2125→
  2126→          // Git diff
  2127→          if (reviewContext.diff) {
  2128→            console.log("CHANGES SINCE TASK STARTED");
  2129→            console.log("-".repeat(60));
  2130→            console.log(`Started at: ${foundTask.started_at}`);
  2131→            console.log();
  2132→            console.log(reviewContext.diff);
  2133→            console.log();
  2134→          } else if (foundTask.started_at) {
  2135→            console.log("CHANGES SINCE TASK STARTED");
  2136→            console.log("-".repeat(60));
  2137→            console.log(`Started at: ${foundTask.started_at}`);
  2138→            console.log("No changes detected");
  2139→            console.log();
  2140→          }
  2141→
  2142→          console.log("=".repeat(60));
  2143→          console.log("Review Checklist:");
  2144→          console.log("- Does the implementation match the task description?");
  2145→          if (reviewContext.spec) {
  2146→            console.log("- Are all acceptance criteria covered?");
  2147→            console.log("- Is test coverage adequate?");
  2148→          }
  2149→          console.log("- Are there any gaps or issues?");
  2150→          console.log("=".repeat(60));
  2151→        });
  2152→      } catch (err) {
  2153→        error("Failed to generate review context", err);
  2154→        process.exit(EXIT_CODES.ERROR);
  2155→      }
  2156→    });
  2157→
  2158→  // kspec task todos <ref>
  2159→  task
  2160→    .command("todos <ref>")
  2161→    .description("Show todos for a task")
  2162→    .action(async (ref: string) => {
  2163→      try {
  2164→        const ctx = await initContext();
  2165→        const tasks = await loadAllTasks(ctx);
  2166→        const items = await loadAllItems(ctx);
  2167→        const index = new ReferenceIndex(tasks, items);
  2168→        const foundTask = resolveTaskRef(ref, tasks, index);
