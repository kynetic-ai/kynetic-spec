  2187→
  2188→  // Create subcommand group for todo operations
  2189→  const todoCmd = task.command("todo").description("Manage task todos");
  2190→
  2191→  // kspec task todo add <ref> <text>
  2192→  markMutating(todoCmd.command("add <ref> <text>"))
  2193→    .description("Add a todo to a task")
  2194→    .option("--author <author>", "Todo author")
  2195→    .action(async (ref: string, text: string, options) => {
  2196→      try {
  2197→        const ctx = await initContext();
  2198→        const tasks = await loadAllTasks(ctx);
  2199→        const items = await loadAllItems(ctx);
  2200→        const index = new ReferenceIndex(tasks, items);
  2201→        const foundTask = resolveTaskRef(ref, tasks, index);
  2202→
  2203→        // Calculate next ID (max existing + 1, or 1 if none)
  2204→        const nextId =
  2205→          foundTask.todos.length > 0
  2206→            ? Math.max(...foundTask.todos.map((t) => t.id)) + 1
  2207→            : 1;
  2208→
  2209→        const todo = createTodo(nextId, text, options.author);
  2210→
  2211→        const updatedTask: Task = {
  2212→          ...foundTask,
  2213→          todos: [...foundTask.todos, todo],
  2214→        };
  2215→
  2216→        await saveTask(ctx, updatedTask);
  2217→        await commitIfShadow(
  2218→          ctx.shadow,
  2219→          "task-note",
  2220→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2221→        );
  2222→        success(
  2223→          `Added todo #${todo.id} to task: ${index.shortUlid(updatedTask._ulid)}`,
  2224→          { todo },
  2225→        );
  2226→      } catch (err) {
  2227→        error(errors.failures.addTodo, err);
  2228→        process.exit(EXIT_CODES.ERROR);
  2229→      }
  2230→    });
  2231→
  2232→  // kspec task todo done <ref> <id>
  2233→  markMutating(todoCmd.command("done <ref> <id>"))
  2234→    .description("Mark a todo as done")
  2235→    .action(async (ref: string, idStr: string) => {
  2236→      try {
  2237→        const ctx = await initContext();
  2238→        const tasks = await loadAllTasks(ctx);
  2239→        const items = await loadAllItems(ctx);
  2240→        const index = new ReferenceIndex(tasks, items);
  2241→        const foundTask = resolveTaskRef(ref, tasks, index);
  2242→
  2243→        const id = parseInt(idStr, 10);
  2244→        if (Number.isNaN(id)) {
  2245→          error(errors.todo.invalidId(idStr));
  2246→          process.exit(EXIT_CODES.USAGE_ERROR);
  2247→        }
  2248→
  2249→        const todoIndex = foundTask.todos.findIndex((t) => t.id === id);
  2250→        if (todoIndex === -1) {
  2251→          error(errors.todo.notFound(id));
  2252→          process.exit(EXIT_CODES.NOT_FOUND);
  2253→        }
  2254→
  2255→        if (foundTask.todos[todoIndex].done) {
  2256→          warn(`Todo #${id} is already done`);
  2257→          return;
  2258→        }
  2259→
  2260→        const updatedTodos = [...foundTask.todos];
  2261→        updatedTodos[todoIndex] = {
  2262→          ...updatedTodos[todoIndex],
  2263→          done: true,
  2264→          done_at: new Date().toISOString(),
  2265→        };
  2266→
  2267→        const updatedTask: Task = {
  2268→          ...foundTask,
  2269→          todos: updatedTodos,
  2270→        };
  2271→
  2272→        await saveTask(ctx, updatedTask);
  2273→        await commitIfShadow(
  2274→          ctx.shadow,
  2275→          "task-note",
  2276→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2277→        );
  2278→        success(`Marked todo #${id} as done`, {
  2279→          todo: updatedTodos[todoIndex],
  2280→        });
  2281→      } catch (err) {
  2282→        error(errors.failures.markTodoDone, err);
  2283→        process.exit(EXIT_CODES.ERROR);
  2284→      }
  2285→    });
  2286→
  2287→  // kspec task todo undone <ref> <id>
  2288→  markMutating(todoCmd.command("undone <ref> <id>"))
  2289→    .description("Mark a todo as not done")
  2290→    .action(async (ref: string, idStr: string) => {
  2291→      try {
  2292→        const ctx = await initContext();
  2293→        const tasks = await loadAllTasks(ctx);
  2294→        const items = await loadAllItems(ctx);
  2295→        const index = new ReferenceIndex(tasks, items);
  2296→        const foundTask = resolveTaskRef(ref, tasks, index);
  2297→
  2298→        const id = parseInt(idStr, 10);
  2299→        if (Number.isNaN(id)) {
  2300→          error(errors.todo.invalidId(idStr));
  2301→          process.exit(EXIT_CODES.USAGE_ERROR);
  2302→        }
  2303→
  2304→        const todoIndex = foundTask.todos.findIndex((t) => t.id === id);
  2305→        if (todoIndex === -1) {
  2306→          error(errors.todo.notFound(id));
  2307→          process.exit(EXIT_CODES.NOT_FOUND);
  2308→        }
  2309→
  2310→        if (!foundTask.todos[todoIndex].done) {
  2311→          warn(`Todo #${id} is not done`);
  2312→          return;
  2313→        }
  2314→
  2315→        const updatedTodos = [...foundTask.todos];
  2316→        updatedTodos[todoIndex] = {
  2317→          ...updatedTodos[todoIndex],
  2318→          done: false,
  2319→          done_at: undefined,
  2320→        };
  2321→
  2322→        const updatedTask: Task = {
  2323→          ...foundTask,
  2324→          todos: updatedTodos,
  2325→        };
  2326→
  2327→        await saveTask(ctx, updatedTask);
  2328→        await commitIfShadow(
  2329→          ctx.shadow,
  2330→          "task-note",
  2331→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2332→        );
  2333→        success(`Marked todo #${id} as not done`, {
  2334→          todo: updatedTodos[todoIndex],
  2335→        });
  2336→      } catch (err) {
  2337→        error(errors.failures.markTodoNotDone, err);
  2338→        process.exit(EXIT_CODES.ERROR);
  2339→      }
  2340→    });
  2341→}
