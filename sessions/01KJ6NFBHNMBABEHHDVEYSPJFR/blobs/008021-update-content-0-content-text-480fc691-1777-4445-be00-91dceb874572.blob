```
     1→import * as path from "node:path";
     2→import chalk from "chalk";
     3→import type { Command } from "commander";
     4→import { markMutating } from "../command-annotations.js";
     5→import {
     6→  checkSlugUniqueness,
     7→  createNote,
     8→  createTask,
     9→  createTodo,
    10→  deleteTask,
    11→  getAuthor,
    12→  initContext,
    13→  type LoadedSpecItem,
    14→  type LoadedTask,
    15→  loadAllItems,
    16→  loadAllTasks,
    17→  ReferenceIndex,
    18→  saveTask,
    19→  scanTestCoverage,
    20→  syncSpecImplementationStatus,
    21→} from "../../parser/index.js";
    22→import { commitIfShadow } from "../../parser/shadow.js";
    23→import { normalizeRefInput } from "../../schema/index.js";
    24→import type { Task, TaskInput } from "../../schema/index.js";
    25→import { alignmentCheck, errors } from "../../strings/index.js";
    26→import {
    27→  formatCommitGuidance,
    28→  printCommitGuidance,
    29→} from "../../utils/commit.js";
    30→import { executeBatchOperation, formatBatchOutput } from "../batch.js";
    31→import { EXIT_CODES } from "../exit-codes.js";
    32→import { parseTagsArray } from "../parse-utils.js";
    33→import {
    34→  annotateNotesWithSuperseded,
    35→  error,
    36→  formatTaskDetails,
    37→  info,
    38→  isJsonMode,
