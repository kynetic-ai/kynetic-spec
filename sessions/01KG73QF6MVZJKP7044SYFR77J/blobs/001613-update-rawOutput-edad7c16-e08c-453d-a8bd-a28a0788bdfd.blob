    40→
    41→// ─── Types ───────────────────────────────────────────────────────────────────
    42→
    43→export interface CheckpointResult {
    44→  /** Whether session can end cleanly */
    45→  ok: boolean;
    46→
    47→  /** Human-readable message for Claude Code */
    48→  message: string;
    49→
    50→  /** Issues that need attention before stopping */
    51→  issues: CheckpointIssue[];
    52→
    53→  /** Instructions for the agent */
    54→  instructions: string[];
    55→}
    56→
    57→export interface CheckpointIssue {
    58→  type: "uncommitted_changes" | "in_progress_task" | "incomplete_todo";
    59→  description: string;
    60→  details?: Record<string, unknown>;
    61→}
    62→
    63→export interface SessionContext {
    64→  /** When this context was generated */
    65→  generated_at: string;
    66→
    67→  /** Current git branch */
    68→  branch: string | null;
    69→
    70→  /** Session context (focus, threads, questions) */
    71→  context: StoredSessionContext | null;
    72→
    73→  /** Tasks currently in progress */
    74→  active_tasks: ActiveTaskSummary[];
    75→
    76→  /** Tasks awaiting review (code done, PR pending) */
    77→  pending_review_tasks: ActiveTaskSummary[];
    78→
    79→  /** Recent notes from active tasks */
    80→  recent_notes: NoteSummary[];
    81→
    82→  /** Incomplete todos from active tasks */
    83→  active_todos: TodoSummary[];
    84→
    85→  /** Tasks ready to be picked up */
    86→  ready_tasks: ReadyTaskSummary[];
    87→
    88→  /** Blocked tasks with blockers */
    89→  blocked_tasks: BlockedTaskSummary[];
    90→
    91→  /** Recently completed tasks */
    92→  recently_completed: CompletedTaskSummary[];
    93→
    94→  /** Recent git commits */
    95→  recent_commits: CommitSummary[];
    96→
    97→  /** Working tree status */
    98→  working_tree: GitWorkingTree | null;
    99→
   100→  /** Inbox items awaiting triage (oldest first) */
   101→  inbox_items: InboxSummary[];
   102→
   103→  /** Summary statistics */
   104→  stats: SessionStats;
   105→}
   106→
   107→export interface ActiveTaskSummary {
   108→  ref: string;
   109→  title: string;
   110→  started_at: string | null;
   111→  priority: number;
   112→  spec_ref: string | null;
   113→  note_count: number;
   114→  last_note_at: string | null;
   115→  todo_count: number;
   116→  incomplete_todos: number;
   117→}
   118→
   119→export interface NoteSummary {
   120→  task_ref: string;
   121→  task_title: string;
   122→  note_ulid: string;
   123→  created_at: string;
   124→  author: string | null;
   125→  content: string;
   126→}
   127→
   128→export interface TodoSummary {
   129→  task_ref: string;
   130→  task_title: string;
   131→  id: number;
   132→  text: string;
   133→  added_at: string;
   134→  added_by: string | null;
   135→}
   136→
   137→export interface ReadyTaskSummary {
   138→  ref: string;
   139→  title: string;
   140→  priority: number;
   141→  spec_ref: string | null;
   142→  tags: string[];
   143→}
   144→
   145→export interface BlockedTaskSummary {
   146→  ref: string;
   147→  title: string;
   148→  blocked_by: string[];
   149→  unmet_deps: string[];
   150→}
   151→
   152→export interface CompletedTaskSummary {
   153→  ref: string;
   154→  title: string;
   155→  completed_at: string;
   156→  closed_reason: string | null;
   157→  origin?: "manual" | "derived" | "observation_promotion";
   158→}
   159→
   160→export interface CommitSummary {
   161→  hash: string;
   162→  full_hash: string;
   163→  date: string;
   164→  message: string;
   165→  author: string;
   166→}
   167→
   168→export interface SessionStats {
   169→  total_tasks: number;
   170→  in_progress: number;
   171→  pending_review: number;
   172→  ready: number;
   173→  blocked: number;
   174→  completed: number;
   175→  inbox_items: number;
   176→}
   177→
   178→export interface InboxSummary {
   179→  ref: string;
   180→  text: string;
   181→  created_at: string;
   182→  tags: string[];
   183→  added_by: string | null;
   184→}
   185→
   186→export interface SessionOptions {
   187→  brief?: boolean;
   188→  full?: boolean;
   189→  since?: string;
   190→  git?: boolean;
   191→  limit?: string;
   192→  eligible?: boolean; // Only include automation-eligible tasks in ready_tasks
   193→}
   194→
   195→// ─── Data Gathering ──────────────────────────────────────────────────────────
   196→
   197→function toActiveTaskSummary(
   198→  task: LoadedTask,
   199→  index: ReferenceIndex,
   200→): ActiveTaskSummary {
   201→  const lastNote =
   202→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   203→  const incompleteTodos = task.todos.filter((t) => !t.done).length;
   204→  return {
   205→    ref: index.shortUlid(task._ulid),
   206→    title: task.title,
   207→    started_at: task.started_at || null,
   208→    priority: task.priority,
   209→    spec_ref: task.spec_ref || null,
   210→    note_count: task.notes.length,
   211→    last_note_at: lastNote ? lastNote.created_at : null,
   212→    todo_count: task.todos.length,
   213→    incomplete_todos: incompleteTodos,
   214→  };
   215→}
   216→
   217→function toReadyTaskSummary(
   218→  task: LoadedTask,
   219→  index: ReferenceIndex,
   220→): ReadyTaskSummary {
   221→  return {
   222→    ref: index.shortUlid(task._ulid),
   223→    title: task.title,
   224→    priority: task.priority,
   225→    spec_ref: task.spec_ref || null,
   226→    tags: task.tags,
   227→  };
   228→}
   229→
   230→function toBlockedTaskSummary(
   231→  task: LoadedTask,
   232→  _allTasks: LoadedTask[],
   233→  index: ReferenceIndex,
   234→): BlockedTaskSummary {
   235→  // Find unmet dependencies
   236→  const unmetDeps: string[] = [];
   237→  for (const depRef of task.depends_on) {
   238→    const result = index.resolve(depRef);
   239→    if (result.ok) {
   240→      const depItem = result.item;
   241→      if ("status" in depItem && depItem.status !== "completed") {
   242→        unmetDeps.push(depRef);
   243→      }
   244→    }
   245→  }
   246→
   247→  return {
   248→    ref: index.shortUlid(task._ulid),
   249→    title: task.title,
   250→    blocked_by: task.blocked_by,
   251→    unmet_deps: unmetDeps,
   252→  };
   253→}
   254→
   255→function toCompletedTaskSummary(
   256→  task: LoadedTask,
   257→  index: ReferenceIndex,
   258→): CompletedTaskSummary {
   259→  return {
   260→    ref: index.shortUlid(task._ulid),
   261→    title: task.title,
   262→    completed_at: task.completed_at || "",
   263→    closed_reason: task.closed_reason || null,
   264→    origin: task.origin,
   265→  };
   266→}
   267→
   268→function collectRecentNotes(
   269→  tasks: LoadedTask[],
   270→  index: ReferenceIndex,
   271→  options: { limit: number; since: Date | null },
   272→): NoteSummary[] {
   273→  const allNotes: NoteSummary[] = [];
   274→
   275→  for (const task of tasks) {
   276→    for (const note of task.notes) {
   277→      const noteDate = new Date(note.created_at);
   278→
   279→      // Filter by since date if provided
   280→      if (options.since && noteDate < options.since) {
   281→        continue;
   282→      }
   283→
   284→      allNotes.push({
   285→        task_ref: index.shortUlid(task._ulid),
   286→        task_title: task.title,
   287→        note_ulid: note._ulid.slice(0, 8),
   288→        created_at: note.created_at,
   289→        author: note.author || null,
   290→        content: note.content,
   291→      });
   292→    }
   293→  }
   294→
   295→  // Sort by date descending, take limit
   296→  return allNotes
   297→    .sort(
   298→      (a, b) =>
   299→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   300→    )
   301→    .slice(0, options.limit);
   302→}
   303→
   304→function collectIncompleteTodos(
   305→  tasks: LoadedTask[],
   306→  index: ReferenceIndex,
   307→  options: { limit: number },
   308→): TodoSummary[] {
   309→  const allTodos: TodoSummary[] = [];
   310→
   311→  for (const task of tasks) {
   312→    for (const todo of task.todos) {
   313→      // Only include incomplete todos
   314→      if (todo.done) continue;
   315→
   316→      allTodos.push({
   317→        task_ref: index.shortUlid(task._ulid),
   318→        task_title: task.title,
   319→        id: todo.id,
   320→        text: todo.text,
   321→        added_at: todo.added_at,
   322→        added_by: todo.added_by || null,
   323→      });
   324→    }
   325→  }
   326→
   327→  // Sort by added_at descending (most recent first), take limit
   328→  return allTodos
   329→    .sort(
   330→      (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime(),
   331→    )
   332→    .slice(0, options.limit);
   333→}
   334→
   335→/**
   336→ * Gather session context data
   337→ */
   338→export async function gatherSessionContext(
   339→  ctx: KspecContext,
   340→  options: SessionOptions,
   341→): Promise<SessionContext> {
   342→  const limit = parseInt(options.limit || "10", 10);
   343→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   344→  const showGit = options.git !== false; // default true
   345→
   346→  // Load all data
   347→  const allTasks = await loadAllTasks(ctx);
   348→  const items = await loadAllItems(ctx);
   349→  const inboxItems = await loadInboxItems(ctx);
   350→  const index = new ReferenceIndex(allTasks, items);
   351→
   352→  // Compute stats
   353→  const stats: SessionStats = {
   354→    total_tasks: allTasks.length,
   355→    in_progress: allTasks.filter((t) => t.status === "in_progress").length,
   356→    pending_review: allTasks.filter((t) => t.status === "pending_review")
   357→      .length,
   358→    ready: getReadyTasks(allTasks).length,
   359→    blocked: allTasks.filter((t) => t.status === "blocked").length,
   360→    completed: allTasks.filter((t) => t.status === "completed").length,
   361→    inbox_items: inboxItems.length,
   362→  };
   363→
   364→  // Get active tasks (optionally filtered to automation-eligible only)
   365→  // AC: @cli-ralph ac-16
   366→  const activeTasks = allTasks
   367→    .filter((t) => t.status === "in_progress")
   368→    .filter((t) => !options.eligible || t.automation === "eligible")
   369→    .sort((a, b) => a.priority - b.priority)
   370→    .slice(0, options.full ? undefined : limit)
   371→    .map((t) => toActiveTaskSummary(t, index));
   372→
   373→  // Get pending review tasks
   374→  const pendingReviewTasks = allTasks
   375→    .filter((t) => t.status === "pending_review")
   376→    .sort((a, b) => a.priority - b.priority)
   377→    .slice(0, options.full ? undefined : limit)
   378→    .map((t) => toActiveTaskSummary(t, index));
   379→
   380→  // Get recent notes from active tasks
   381→  const recentNotes = collectRecentNotes(
   382→    allTasks.filter((t) => t.status === "in_progress"),
   383→    index,
   384→    { limit: options.full ? limit * 2 : limit, since: sinceDate },
   385→  );
   386→
   387→  // Get incomplete todos from active tasks
   388→  const activeTodos = collectIncompleteTodos(
   389→    allTasks.filter((t) => t.status === "in_progress"),
   390→    index,
   391→    { limit: options.full ? limit * 2 : limit },
   392→  );
   393→
   394→  // Get ready tasks (optionally filtered to automation-eligible only)
   395→  const readyTasks = getReadyTasks(allTasks)
   396→    .filter((t) => !options.eligible || t.automation === "eligible")
   397→    .slice(0, options.full ? undefined : limit)
   398→    .map((t) => toReadyTaskSummary(t, index));
   399→
   400→  // Get blocked tasks
   401→  const blockedTasks = allTasks
   402→    .filter((t) => t.status === "blocked")
   403→    .slice(0, options.full ? undefined : limit)
   404→    .map((t) => toBlockedTaskSummary(t, allTasks, index));
   405→
   406→  // Get recently completed tasks
   407→  const recentlyCompleted = allTasks
   408→    .filter((t) => {
   409→      if (t.status !== "completed" || !t.completed_at) return false;
   410→      const completedDate = new Date(t.completed_at);
   411→      if (sinceDate && completedDate < sinceDate) return false;
   412→      return true;
   413→    })
   414→    .sort((a, b) => {
   415→      // Sort by completed_at descending (most recent first)
   416→      const aDate = new Date(a.completed_at || 0);
   417→      const bDate = new Date(b.completed_at || 0);
   418→      return bDate.getTime() - aDate.getTime();
   419→    })
   420→    .slice(0, options.full ? undefined : limit)
   421→    .map((t) => toCompletedTaskSummary(t, index));
   422→
   423→  // Get git info
   424→  let branch: string | null = null;
   425→  let recentCommits: CommitSummary[] = [];
   426→  let workingTree: GitWorkingTree | null = null;
   427→
   428→  if (showGit && isGitRepo(ctx.rootDir)) {
   429→    branch = getCurrentBranch(ctx.rootDir);
   430→
   431→    const commits = getRecentCommits({
   432→      limit: options.full ? limit * 2 : limit,
   433→      since: sinceDate || undefined,
   434→      cwd: ctx.rootDir,
   435→    });
   436→
   437→    recentCommits = commits.map((c) => ({
   438→      hash: c.hash,
   439→      full_hash: c.fullHash,
   440→      date: c.date.toISOString(),
   441→      message: c.message,
   442→      author: c.author,
   443→    }));
   444→
   445→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   446→  }
   447→
   448→  // Get inbox items (oldest first to encourage triage)
   449→  const inboxSummaries: InboxSummary[] = inboxItems
   450→    .sort(
   451→      (a, b) =>
   452→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   453→    )
   454→    .slice(0, options.full ? undefined : limit)
   455→    .map((item) => ({
   456→      ref: item._ulid.slice(0, 8),
   457→      text: item.text,
   458→      created_at: item.created_at,
   459→      tags: item.tags,
   460→      added_by: item.added_by || null,
   461→    }));
   462→
   463→  // Load session context (focus, threads, questions)
   464→  const sessionContext = await loadSessionContext(ctx);
   465→
   466→  return {
   467→    generated_at: new Date().toISOString(),
   468→    branch,
   469→    context: sessionContext,
   470→    active_tasks: activeTasks,
   471→    pending_review_tasks: pendingReviewTasks,
   472→    recent_notes: recentNotes,
   473→    active_todos: activeTodos,
   474→    ready_tasks: readyTasks,
   475→    blocked_tasks: blockedTasks,
   476→    recently_completed: recentlyCompleted,
   477→    recent_commits: recentCommits,
   478→    working_tree: workingTree,
   479→    inbox_items: inboxSummaries,
   480→    stats,
   481→  };
   482→}
   483→
   484→// ─── Iteration Stats ─────────────────────────────────────────────────────────
   485→
   486→/**
   487→ * Stats for tasks completed/started within a time window.
   488→ * Used by ralph to track task completions per iteration.
   489→ */
   490→export interface IterationStats {
   491→  /** Number of tasks completed since the given time */
   492→  tasks_completed: number;
   493→  /** Number of tasks started since the given time */
   494→  tasks_started: number;
   495→  /** References of completed tasks */
   496→  completed_refs: string[];
   497→}
   498→
   499→/**
   500→ * Get iteration stats - tasks completed/started since a given time.
   501→ * AC: @ralph-task-limit ac-detection
   502→ */
   503→export async function getIterationStats(
   504→  ctx: KspecContext,
   505→  since: Date,
   506→): Promise<IterationStats> {
   507→  const allTasks = await loadAllTasks(ctx);
   508→
   509→  const completedSince = allTasks.filter((t) => {
   510→    if (t.status !== "completed" || !t.completed_at) return false;
   511→    return new Date(t.completed_at) >= since;
   512→  });
   513→
   514→  const startedSince = allTasks.filter((t) => {
   515→    if (!t.started_at) return false;
   516→    return new Date(t.started_at) >= since;
   517→  });
   518→
   519→  // Use first slug or ULID prefix as ref
   520→  const getRef = (t: LoadedTask) =>
   521→    t.slugs.length > 0 ? `@${t.slugs[0]}` : `@${t._ulid.slice(0, 8)}`;
   522→
   523→  return {
   524→    tasks_completed: completedSince.length,
   525→    tasks_started: startedSince.length,
   526→    completed_refs: completedSince.map(getRef),
   527→  };
   528→}
   529→
   530→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   531→
   532→export interface CheckpointOptions {
   533→  force?: boolean;
   534→  /** Set when stop hook is already active (retry after previous block) */
   535→  stopHookActive?: boolean;
   536→}
   537→
   538→/** Claude Code hook input for Stop hooks */
   539→export interface StopHookInput {
   540→  session_id?: string;
   541→  transcript_path?: string;
   542→  hook_event_name?: string;
   543→  stop_hook_active?: boolean;
   544→}
   545→
   546→/**
   547→ * Perform session checkpoint - check for uncommitted work before ending session.
   548→ *
   549→ * This is designed for use as a Claude Code stop hook. It checks for:
   550→ * - Uncommitted git changes (staged, unstaged, untracked)
   551→ * - Tasks in in_progress status
   552→ * - Incomplete todos on active tasks
   553→ *
   554→ * Returns a structured result indicating whether the session can end cleanly.
   555→ */
   556→export async function performCheckpoint(
   557→  ctx: KspecContext,
   558→  options: CheckpointOptions,
   559→): Promise<CheckpointResult> {
   560→  const issues: CheckpointIssue[] = [];
   561→  const instructions: string[] = [];
   562→
   563→  // Load tasks
   564→  const allTasks = await loadAllTasks(ctx);
   565→
   566→  // Check for in-progress tasks
   567→  const inProgressTasks = allTasks.filter((t) => t.status === "in_progress");
   568→  for (const task of inProgressTasks) {
   569→    const ref = task.slugs[0]
   570→      ? `@${task.slugs[0]}`
   571→      : `@${task._ulid.slice(0, 8)}`;
   572→    issues.push({
   573→      type: "in_progress_task",
   574→      description: `Task ${ref} is still in progress: ${task.title}`,
   575→      details: {
   576→        ref,
   577→        title: task.title,
   578→        started_at: task.started_at,
   579→      },
   580→    });
   581→
   582→    // Check for incomplete todos on this task
   583→    const incompleteTodos = task.todos.filter((t) => !t.done);
   584→    for (const todo of incompleteTodos) {
   585→      issues.push({
   586→        type: "incomplete_todo",
   587→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   588→        details: {
   589→          task_ref: ref,
   590→          todo_id: todo.id,
   591→          text: todo.text,
   592→        },
   593→      });
   594→    }
   595→  }
   596→
   597→  // Check for uncommitted git changes
   598→  if (isGitRepo(ctx.rootDir)) {
   599→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   600→    if (!workingTree.clean) {
   601→      const changeCount =
   602→        workingTree.staged.length +
   603→        workingTree.unstaged.length +
   604→        workingTree.untracked.length;
   605→
   606→      issues.push({
   607→        type: "uncommitted_changes",
   608→        description: `${changeCount} uncommitted changes in working tree`,
   609→        details: {
   610→          staged: workingTree.staged.length,
   611→          unstaged: workingTree.unstaged.length,
   612→          untracked: workingTree.untracked.length,
   613→        },
   614→      });
   615→    }
   616→  }
   617→
   618→  // Build instructions based on issues
   619→  if (issues.length > 0 && !options.force) {
   620→    instructions.push(
   621→      "If you've been instructed to ignore this message or are working on",
   622→    );
   623→    instructions.push(
   624→      "unrelated things to any in progress tasks then disregard this message,",
   625→    );
   626→    instructions.push("otherwise before ending this session, please:");
   627→
   628→    const hasInProgress = issues.some((i) => i.type === "in_progress_task");
   629→    const hasUncommitted = issues.some((i) => i.type === "uncommitted_changes");
   630→    const hasIncompleteTodos = issues.some((i) => i.type === "incomplete_todo");
   631→
   632→    let step = 1;
   633→
   634→    if (hasInProgress) {
   635→      instructions.push(
   636→        `${step++}. Read in-progress task notes to get full context of the current task status`,
   637→      );
   638→      instructions.push(
   639→        `${step++}. Add notes documenting current state if any context is missing from this session`,
   640→      );
   641→      instructions.push(
   642→        `${step++}. Complete the task if you've completed the objectives and no AC are left uncovered\notherwise leave it in progress for a future session`,
   643→      );
   644→    }
   645→
   646→    if (hasIncompleteTodos) {
   647→      instructions.push(
   648→        `${step++}. Complete or acknowledge incomplete todos on active tasks`,
   649→      );
   650→    }
   651→
   652→    if (hasUncommitted) {
   653→      instructions.push(
   654→        `${step++}. Commit your changes with a descriptive message`,
   655→      );
   656→
   657→      // Add WIP commit guidance if there are in-progress tasks
   658→      if (inProgressTasks.length > 0) {
   659→        const task = inProgressTasks[0];
   660→        const guidance = formatCommitGuidance(task, { wip: true });
   661→        instructions.push("");
   662→        instructions.push("Suggested WIP commit:");
   663→        instructions.push(`  ${guidance.message}`);
   664→        instructions.push("");
   665→        for (const trailer of guidance.trailers) {
   666→          instructions.push(`  ${trailer}`);
   667→        }
   668→      }
   669→    }
   670→
   671→    instructions.push("");
   672→    instructions.push("Use: kspec task @task to get current task state");
   673→    instructions.push(
   674→      'Use: kspec task note @task "Progress notes..." to document state',
   675→    );
   676→    instructions.push(
   677→      'Use: kspec task complete @task --reason "Summary" if task is done',
   678→    );
   679→  }
   680→
   681→  // Allow stop if:
   682→  // - No issues found
   683→  // - --force flag passed
   684→  // - This is a retry (stop_hook_active = true from previous block)
   685→  const isRetry = options.stopHookActive === true;
   686→  const ok = issues.length === 0 || options.force === true || isRetry;
   687→
   688→  let message: string;
   689→  if (isRetry && issues.length > 0) {
   690→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   691→  } else if (ok) {
   692→    message = "[kspec] Session checkpoint passed - ready to end session";
   693→  } else {
   694→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   695→  }
   696→
   697→  return {
   698→    ok,
   699→    message,
   700→    issues,
   701→    instructions,
   702→  };
   703→}
   704→
   705→// ─── Output Formatting ───────────────────────────────────────────────────────
   706→
   707→function formatCheckpointResult(result: CheckpointResult): void {
   708→  if (result.ok) {
   709→    console.log(chalk.green(result.message));
   710→  } else {
   711→    console.log(chalk.yellow(result.message));
   712→    console.log("");
   713→
   714→    for (const issue of result.issues) {
   715→      const icon =
   716→        issue.type === "uncommitted_changes"
   717→          ? chalk.yellow("⚠")
   718→          : issue.type === "in_progress_task"
   719→            ? chalk.blue("●")
   720→            : chalk.gray("○");
   721→      console.log(`  ${icon} ${issue.description}`);
   722→    }
   723→
   724→    if (result.instructions.length > 0) {
   725→      console.log("");
   726→      for (const instruction of result.instructions) {
   727→        console.log(chalk.gray(instruction));
   728→      }
   729→    }
   730→  }
   731→}
   732→
   733→function formatSessionContext(
   734→  ctx: SessionContext,
   735→  options: SessionOptions,
   736→): void {
   737→  const isBrief = !options.full;
   738→
   739→  // Header
   740→  console.log(`\n${sessionHeaders.title}`);
   741→  const age = formatRelativeTime(new Date(ctx.generated_at));
   742→  if (ctx.branch) {
   743→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   744→  } else {
   745→    console.log(chalk.gray(`Generated: ${age}`));
   746→  }
   747→
   748→  // Stats summary
   749→  const pendingReviewNote =
   750→    ctx.stats.pending_review > 0
   751→      ? `${ctx.stats.pending_review} awaiting review, `
   752→      : "";
   753→  const inboxNote =
   754→    ctx.stats.inbox_items > 0 ? ` | Inbox: ${ctx.stats.inbox_items}` : "";
   755→  console.log(
   756→    chalk.gray(
   757→      `Tasks: ${ctx.stats.in_progress} active, ${pendingReviewNote}${ctx.stats.ready} ready, ` +
   758→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`,
   759→    ),
   760→  );
   761→
   762→  // Session context section (focus, threads, questions)
   763→  if (
   764→    ctx.context &&
   765→    (ctx.context.focus ||
   766→      ctx.context.threads.length > 0 ||
   767→      ctx.context.open_questions.length > 0)
   768→  ) {
   769→    console.log("\n--- Session Context ---");
   770→
   771→    if (ctx.context.focus) {
   772→      console.log(`  ${chalk.cyan("Focus:")} ${ctx.context.focus}`);
   773→    }
   774→
   775→    if (ctx.context.threads.length > 0) {
   776→      console.log(`  ${chalk.cyan("Active Threads:")}`);
   777→      for (const thread of ctx.context.threads) {
   778→        console.log(`    - ${thread}`);
   779→      }
   780→    }
   781→
   782→    if (ctx.context.open_questions.length > 0) {
   783→      console.log(`  ${chalk.cyan("Open Questions:")}`);
   784→      for (const question of ctx.context.open_questions) {
   785→        console.log(`    - ${question}`);
   786→      }
   787→    }
   788→  }
   789→
   790→  // Active tasks section
   791→  if (ctx.active_tasks.length > 0) {
   792→    console.log(`\n${sessionHeaders.activeWork}`);
   793→    for (const task of ctx.active_tasks) {
   794→      const started = task.started_at
   795→        ? chalk.gray(
   796→            ` (started ${formatRelativeTime(new Date(task.started_at))})`,
   797→          )
   798→        : "";
   799→      const priority =
   800→        task.priority <= 2
   801→          ? chalk.red(`P${task.priority}`)
   802→          : chalk.gray(`P${task.priority}`);
   803→      console.log(
   804→        `  ${chalk.blue("[in_progress]")} ${priority} ${task.ref} ${task.title}${started}`,
   805→      );
   806→    }
   807→  } else {
   808→    console.log(`\n${sessionHeaders.noActiveWork}`);
   809→  }
   810→
   811→  // Awaiting review section
   812→  if (ctx.pending_review_tasks.length > 0) {
   813→    console.log(`\n${sessionHeaders.awaitingReview}`);
   814→    for (const task of ctx.pending_review_tasks) {
   815→      const priority =
   816→        task.priority <= 2
   817→          ? chalk.red(`P${task.priority}`)
   818→          : chalk.gray(`P${task.priority}`);
   819→      console.log(
   820→        `  ${chalk.yellow("[pending_review]")} ${priority} ${task.ref} ${task.title}`,
   821→      );
   822→    }
   823→  }
   824→
   825→  // Recently completed section
   826→  if (ctx.recently_completed.length > 0) {
   827→    console.log(`\n${sessionHeaders.recentlyCompleted}`);
   828→    const observationPromotedTasks: string[] = [];
   829→    for (const task of ctx.recently_completed) {
   830→      const completedAge = formatRelativeTime(new Date(task.completed_at));
   831→      let reason = "";
   832→      if (task.closed_reason) {
   833→        const maxLen = isBrief ? 60 : 120;
   834→        const truncated =
   835→          task.closed_reason.length > maxLen
   836→            ? `${task.closed_reason.slice(0, maxLen).trim()}...`
   837→            : task.closed_reason;
   838→        reason = chalk.gray(` - ${truncated}`);
   839→      }
   840→      console.log(
   841→        `  ${chalk.green("[completed]")} ${task.ref} ${task.title} ${chalk.gray(`(${completedAge})`)}${reason}`,
   842→      );
   843→
   844→      // Track tasks that came from observations
   845→      if (task.origin === "observation_promotion") {
   846→        observationPromotedTasks.push(task.ref);
   847→      }
   848→    }
   849→
   850→    // Show reminder about resolving observations
   851→    if (observationPromotedTasks.length > 0) {
   852→      console.log(
   853→        chalk.yellow(
   854→          `\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(", ")}`,
   855→        ),
   856→      );
   857→      console.log(
   858→        chalk.gray(`    Run: kspec meta observations --pending-resolution`),
   859→      );
   860→    }
   861→  }
   862→
   863→  // Recent notes section
   864→  if (ctx.recent_notes.length > 0) {
   865→    console.log(`\n${sessionHeaders.recentNotes}`);
   866→    for (const note of ctx.recent_notes) {
   867→      const age = formatRelativeTime(new Date(note.created_at));
   868→      const author = note.author ? chalk.gray(` by ${note.author}`) : "";
   869→      console.log(`  ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
   870→
   871→      // Truncate content in brief mode
   872→      let content = note.content.trim();
   873→      if (isBrief && content.length > 200) {
   874→        content = `${content.slice(0, 200).trim()}...`;
   875→      }
   876→
   877→      // Indent content, limit lines in brief mode
   878→      const lines = content.split("\n");
   879→      const maxLines = isBrief ? 3 : lines.length;
   880→      for (const line of lines.slice(0, maxLines)) {
   881→        console.log(`    ${chalk.white(line)}`);
   882→      }
   883→      if (isBrief && lines.length > maxLines) {
   884→        console.log(
   885→          chalk.gray(`    ... (${lines.length - maxLines} more lines)`),
   886→        );
   887→      }
   888→    }
   889→  }
   890→
   891→  // Incomplete todos section
   892→  if (ctx.active_todos.length > 0) {
   893→    console.log(`\n${sessionHeaders.incompleteTodos}`);
   894→    for (const todo of ctx.active_todos) {
   895→      console.log(
   896→        `  ${chalk.yellow("[ ]")} ${todo.task_ref}#${todo.id}: ${todo.text}`,
   897→      );
   898→    }
   899→  }
   900→
   901→  // Ready tasks section
   902→  if (ctx.ready_tasks.length > 0) {
   903→    console.log(`\n${sessionHeaders.readyTasks}`);
   904→    for (const task of ctx.ready_tasks) {
   905→      const priority =
   906→        task.priority <= 2
   907→          ? chalk.red(`P${task.priority}`)
   908→          : chalk.gray(`P${task.priority}`);
   909→      const tags =
   910→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(" #")}`) : "";
   911→      console.log(`  ${priority} ${task.ref} ${task.title}${tags}`);
   912→    }
   913→  }
   914→
   915→  // Blocked tasks section
   916→  if (ctx.blocked_tasks.length > 0) {
   917→    console.log(`\n${sessionHeaders.blocked}`);
   918→    for (const task of ctx.blocked_tasks) {
   919→      console.log(`  ${chalk.red("[blocked]")} ${task.ref} ${task.title}`);
   920→      if (task.blocked_by.length > 0) {
   921→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(", ")}`));
   922→      }
   923→      if (task.unmet_deps.length > 0) {
   924→        console.log(
   925→          chalk.gray(`    Waiting on: ${task.unmet_deps.join(", ")}`),
   926→        );
   927→      }
   928→    }
   929→  }
   930→
   931→  // Git commits section
   932→  if (ctx.recent_commits.length > 0) {
   933→    console.log(`\n${sessionHeaders.recentCommits}`);
   934→    for (const commit of ctx.recent_commits) {
   935→      const age = formatRelativeTime(new Date(commit.date));
   936→      console.log(
   937→        `  ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${age}, ${commit.author})`)}`,
   938→      );
   939→    }
   940→  }
   941→
   942→  // Inbox section (oldest first to encourage triage)
   943→  if (ctx.inbox_items.length > 0) {
   944→    console.log(`\n${sessionHeaders.inbox}`);
   945→    for (const item of ctx.inbox_items) {
   946→      const age = formatRelativeTime(new Date(item.created_at));
   947→      const author = item.added_by ? ` by ${item.added_by}` : "";
   948→      const tags =
   949→        item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(", ")}]`) : "";
   950→      // Truncate text in brief mode
   951→      let text = item.text;
   952→      if (isBrief && text.length > 60) {
   953→        text = `${text.slice(0, 60).trim()}...`;
   954→      }
   955→      console.log(
   956→        `  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`,
   957→      );
   958→      console.log(`    ${text}`);
   959→    }
   960→    console.log(`  ${hints.inboxPromote}`);
   961→  }
   962→
   963→  // Working tree section
   964→  if (ctx.working_tree && !ctx.working_tree.clean) {
   965→    console.log(`\n${sessionHeaders.workingTree}`);
   966→
   967→    if (ctx.working_tree.staged.length > 0) {
   968→      console.log(chalk.green("  Staged:"));
   969→      for (const file of ctx.working_tree.staged) {
   970→        console.log(
   971→          `    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`,
   972→        );
   973→      }
   974→    }
   975→
   976→    if (ctx.working_tree.unstaged.length > 0) {
   977→      console.log(chalk.red("  Modified:"));
   978→      for (const file of ctx.working_tree.unstaged) {
   979→        console.log(
   980→          `    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`,
   981→        );
   982→      }
   983→    }
   984→
   985→    if (ctx.working_tree.untracked.length > 0) {
   986→      console.log(chalk.gray("  Untracked:"));
   987→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
   988→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
   989→        console.log(`    ${chalk.gray("?")} ${path}`);
   990→      }
   991→      if (isBrief && ctx.working_tree.untracked.length > limit) {
   992→        console.log(
   993→          chalk.gray(
   994→            `    ... and ${ctx.working_tree.untracked.length - limit} more`,
   995→          ),
   996→        );
   997→      }
   998→    }
   999→  } else if (ctx.working_tree?.clean) {
  1000→    console.log(`\n${sessionHeaders.workingTreeClean}`);
  1001→  }
  1002→
  1003→  // Quick Commands section - contextual hints based on state
  1004→  const quickCommands: string[] = [];
  1005→
  1006→  if (ctx.active_tasks.length > 0) {
  1007→    const ref = ctx.active_tasks[0].ref;
  1008→    quickCommands.push(
  1009→      `kspec task note @${ref} "Progress..."  ${chalk.gray("# document work")}`,
  1010→    );
  1011→    quickCommands.push(
  1012→      `kspec task complete @${ref} --reason "..."  ${chalk.gray("# finish task")}`,
  1013→    );
  1014→  } else if (ctx.ready_tasks.length > 0) {
  1015→    const ref = ctx.ready_tasks[0].ref;
  1016→    quickCommands.push(
  1017→      `kspec task start @${ref}  ${chalk.gray("# begin work")}`,
  1018→    );
  1019→  }
  1020→
  1021→  if (ctx.inbox_items.length > 0) {
  1022→    const ref = ctx.inbox_items[0].ref;
  1023→    quickCommands.push(
  1024→      `kspec inbox promote @${ref} --title "..."  ${chalk.gray("# convert to task")}`,
  1025→    );
  1026→  }
  1027→
  1028→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1029→    quickCommands.push(
  1030→      `git add . && git commit -m "..."  ${chalk.gray("# commit changes")}`,
  1031→    );
  1032→  }
  1033→
  1034→  if (quickCommands.length > 0) {
  1035→    console.log(`\n${sessionHeaders.quickCommands}`);
  1036→    for (const hint of quickCommands) {
  1037→      console.log(`  ${hint}`);
  1038→    }
  1039→  }
  1040→
  1041→  console.log(""); // Final newline
  1042→}
  1043→
  1044→// ─── Command Registration ────────────────────────────────────────────────────
  1045→
  1046→async function sessionStartAction(options: SessionOptions): Promise<void> {
  1047→  try {
  1048→    const ctx = await initContext();
  1049→
  1050→    // AC: @shadow-sync ac-2 - Pull remote changes before showing session context
  1051→    let syncResult: ShadowSyncResult | null = null;
  1052→    if (ctx.shadow?.enabled) {
  1053→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
  1054→      // AC: @shadow-sync ac-3 - Warn about conflicts but continue with local state
  1055→      if (syncResult.hadConflict) {
  1056→        console.log(
  1057→          chalk.yellow(
  1058→            "⚠ Shadow sync conflict detected. Run `kspec shadow resolve` to fix.",
  1059→          ),
  1060→        );
  1061→        console.log(chalk.gray("  Continuing with local state..."));
  1062→        console.log("");
  1063→      } else if (syncResult.pulled) {
  1064→        console.log(chalk.gray("ℹ Synced shadow branch from remote"));
  1065→      }
  1066→    }
  1067→
  1068→    const sessionCtx = await gatherSessionContext(ctx, options);
  1069→
  1070→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
  1071→  } catch (err) {
  1072→    error(errors.failures.gatherSessionContext, err);
  1073→    process.exit(EXIT_CODES.ERROR);
  1074→  }
  1075→}
  1076→
  1077→/**
  1078→ * Read stdin if available (non-blocking check for hook input)
  1079→ */
  1080→async function readStdinIfAvailable(): Promise<string | null> {
  1081→  // Check if stdin is a TTY (interactive) - if so, don't try to read
  1082→  if (process.stdin.isTTY) {
  1083→    return null;
  1084→  }
  1085→
  1086→  return new Promise((resolve) => {
  1087→    let data = "";
  1088→    const timeout = setTimeout(() => {
  1089→      process.stdin.removeAllListeners();
  1090→      resolve(data || null);
  1091→    }, 100); // 100ms timeout for stdin
  1092→
  1093→    process.stdin.setEncoding("utf8");
  1094→    process.stdin.on("data", (chunk) => {
  1095→      data += chunk;
  1096→    });
  1097→    process.stdin.on("end", () => {
  1098→      clearTimeout(timeout);
  1099→      resolve(data || null);
  1100→    });
  1101→    process.stdin.on("error", () => {
  1102→      clearTimeout(timeout);
  1103→      resolve(null);
  1104→    });
  1105→    process.stdin.resume();
  1106→  });
  1107→}
  1108→
  1109→/**
  1110→ * Parse Claude Code hook input from stdin
  1111→ */
  1112→function parseHookInput(stdin: string | null): StopHookInput | null {
  1113→  if (!stdin) return null;
  1114→  try {
  1115→    return JSON.parse(stdin.trim()) as StopHookInput;
  1116→  } catch {
  1117→    return null;
  1118→  }
  1119→}
  1120→
  1121→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
  1122→
  1123→/**
  1124→ * Output spec-first reminder for UserPromptSubmit hook.
  1125→ *
  1126→ * This is a simple context injection - always outputs the reminder,
  1127→ * and Claude (Opus) is smart enough to apply it when relevant.
  1128→ */
  1129→async function sessionPromptCheckAction(): Promise<void> {
  1130→  // Lean, instructive reminder with kspec prefix
  1131→  console.log(sessionPrompt.specCheck);
  1132→}
  1133→
  1134→async function sessionCheckpointAction(
  1135→  options: CheckpointOptions,
  1136→): Promise<void> {
  1137→  try {
  1138→    // Read stdin for Claude Code hook input
  1139→    const stdin = await readStdinIfAvailable();
  1140→    const hookInput = parseHookInput(stdin);
  1141→
  1142→    // Check if this is a retry (stop hook already active)
  1143→    if (hookInput?.stop_hook_active) {
  1144→      options.stopHookActive = true;
  1145→    }
  1146→
  1147→    const ctx = await initContext();
  1148→    const result = await performCheckpoint(ctx, options);
  1149→
  1150→    // Output format depends on mode:
  1151→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
  1152→    // - Human mode: Output formatted checkpoint result
  1153→    if (isJsonMode()) {
  1154→      if (!result.ok) {
  1155→        // Build reason message with issues and instructions
  1156→        const issueLines = result.issues
  1157→          .map((i) => `- ${i.description}`)
  1158→          .join("\n");
  1159→        const instructionLines = result.instructions
  1160→          .filter((i) => i.trim())
  1161→          .join("\n");
  1162→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
  1163→        console.log(JSON.stringify({ decision: "block", reason }));
  1164→      }
  1165→      // If ok, exit silently (Claude Code expects no output when allowing stop)
  1166→    } else {
  1167→      formatCheckpointResult(result);
  1168→      if (!result.ok) {
  1169→        process.exit(EXIT_CODES.ERROR);
  1170→      }
  1171→    }
  1172→  } catch (err) {
  1173→    error(errors.failures.runCheckpoint, err);
  1174→    process.exit(EXIT_CODES.ERROR);
  1175→  }
  1176→}
  1177→
  1178→/**
  1179→ * Register the 'session' command group and aliases
  1180→ */
  1181→export function registerSessionCommands(program: Command): void {
  1182→  const session = program
  1183→    .command("session")
  1184→    .description("Session management and context");
  1185→
  1186→  session
  1187→    .command("start")
  1188→    .alias("resume")
  1189→    .description("Surface relevant context for starting a new working session")
  1190→    .option("--brief", "Compact summary (default)")
  1191→    .option("--full", "Comprehensive context dump")
  1192→    .option(
  1193→      "--since <time>",
  1194→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  1195→    )
  1196→    .option("--no-git", "Skip git commit information")
  1197→    .option("-n, --limit <n>", "Limit items per section", "10")
  1198→    .action(sessionStartAction);
  1199→
  1200→  session
  1201→    .command("checkpoint")
  1202→    .description(
  1203→      "Pre-stop hook: check for uncommitted work before ending session",
  1204→    )
  1205→    .option("--force", "Allow session end regardless of issues")
  1206→    .action(sessionCheckpointAction);
  1207→
  1208→  session
  1209→    .command("prompt-check")
  1210→    .description("UserPromptSubmit hook: inject spec-first reminder")
  1211→    .action(sessionPromptCheckAction);
  1212→
  1213→  // Top-level alias: kspec context
  1214→  program
  1215→    .command("context")
