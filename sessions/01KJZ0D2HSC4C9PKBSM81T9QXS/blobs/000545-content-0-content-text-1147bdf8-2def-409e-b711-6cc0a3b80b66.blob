.kspec/sessions/01KJY3FGB4W881DYXQ42PQHA59/events.jsonl:220:{"ts":1772684339375,"seq":219,"type":"session.update","session_id":"01KJY3FGB4W881DYXQ42PQHA59","data":{"_meta":{"claudeCode":{"toolResponse":{"type":"text","file":{"filePath":"/home/chapel/Projects/kynetic-spec-ui/.kspec/project.plans.yaml","content":"    created_at: 2026-03-04T21:54:25.649Z\n    approved_at: null\n    completed_at: null\n    notes:\n      - _ulid: 01KJXDJAQZ6BF9RK02TYSEARZ0\n        created_at: 2026-03-04T21:55:20.447Z\n        author: \"@claude\"\n        content: \"Plan details: Add review_url field to task schema + dispatch prompt orientation context\n          (task title, trigger meaning, fix-cycle notes, review URL, template interpolation). Spec\n          ACs added to @task-submit (ac-submit-1 through ac-submit-3) and @agent-dispatch-engine\n          (ac-13 through ac-16). Full plan at ~/.claude/plans/resilient-wiggling-token.md\"\n  - _ulid: 01KJXSVF2YKCXMJGC55G1CPBV2\n    slugs:\n      - plan-ui-ux-revamp\n    title: UI/UX Revamp\n    content: >\n      # UI/UX Revamp\n\n\n      ## Specs\n\n\n      ```yaml\n\n      - title: \"UI Design System\"\n        slug: ui-design-system\n        type: feature\n        parent: \"@web-ui\"\n        description: |\n          Port imgen's design token architecture into kspec's Tailwind-based web UI.\n          Map oklch color tokens, spacing, radii, z-index, typography, and animation\n          keyframes as Tailwind theme extensions. Establish consistent visual language\n          across all views.\n        acceptance_criteria:\n          - id: ac-1\n            given: |\n              The web UI app.css file\n            when: |\n              imgen token-contract.css values are mapped as Tailwind @theme inline extensions\n            then: |\n              All 16 color tokens, 4 radii, 7 spacing, 7 z-index, and 3 font families\n              are available as Tailwind utility classes (e.g. bg-design-surface, border-design-border)\n          - id: ac-2\n            given: |\n              A component using design tokens\n            when: |\n              The dark theme tokens are applied\n            then: |\n              oklch colors render correctly and status colors (pending=amber, in_progress=orange,\n              pending_review=blue, needs_work=yellow, completed=emerald, blocked=red, cancelled=gray)\n              are visually distinct\n          - id: ac-3\n            given: |\n              A view with loading states\n            when: |\n              Content is loading\n            then: |\n              Shimmer animation plays on skeleton elements, gated behind prefers-reduced-motion\n          - id: ac-4\n            given: |\n              An active agent task card\n            when: |\n              The agent is working\n            then: |\n              Breathing/pulse animation plays on the card border, gated behind prefers-reduced-motion\n\n      - title: \"App Shell and Navigation\"\n        slug: ui-app-shell\n        type: feature\n        parent: \"@web-ui\"\n        description: |\n          Restructure the web UI layout with collapsible sidebar navigation, header bar\n          with command palette and connection status, and grouped navigation sections.\n          Preserve existing functionality during migration.\n        acceptance_criteria:\n          - id: ac-1\n            given: |\n              The web UI loaded in daemon mode\n            when: |\n              The app shell renders\n            then: |\n              A collapsible sidebar shows grouped navigation: Work (Dashboard, Tasks, Agents, Sessions),\n              Specs (Specs, Plans, Validate), Capture (Inbox, Observations, Triage),\n              Config (Workflows, Settings)\n          - id: ac-2\n            given: |\n              Sidebar navigation items\n            when: |\n              Items have actionable counts (inbox items, unresolved observations, pending review tasks)\n            then: |\n              Badge counts display next to the relevant nav items\n          - id: ac-3\n            given: |\n              The /items route\n            when: |\n              A user navigates to /items\n            then: |\n              They are redirected to /specs preserving any query parameters\n          - id: ac-4\n            given: |\n              The Observations nav item\n            when: |\n              There are zero unresolved observations\n            then: |\n              The nav item is still visible (not hidden)\n\n      - title: \"Task Board (Kanban)\"\n        slug: ui-task-board\n        type: feature\n        parent: \"@web-ui\"\n        description: |\n          Kanban-style task board with columns mapping to kspec task states.\n          Active Fleet row shows currently running agent work with live output.\n          Task cards show key metadata, clicking opens detail modal.\n          Not drag-and-drop — tasks transition via agents/CLI.\n        acceptance_criteria:\n          - id: ac-1\n            given: |\n              Tasks in various states\n            when: |\n              The task board renders\n            then: |\n              Tasks are distributed into columns: Backlog (pending, manual_only/unassessed),\n              Ready (pending, eligible), In Progress (in_progress, needs_work),\n              Review (pending_review), Done (completed recent), with blocked and cancelled\n              handled as sections/indicators\n          - id: ac-2\n            given: |\n              A task card on the board\n            when: |\n              The card renders\n            then: |\n              It shows priority badge, tag chips, title, slug (mono), spec ref link,\n              and metadata footer (notes count, dependency count, age)\n          - id: ac-3\n            given: |\n              A task card\n            when: |\n              The user clicks it\n            then: |\n              A detail modal opens showing full task info: title, description, status,\n              priority, type, spec ref, tags, dependencies, blocked-by, notes, todos,\n              automation status, VCS info (branch, PR link), plan ref, session link\n          - id: ac-4\n            given: |\n              Agents actively working on tasks (dispatch running)\n            when: |\n              The task board renders\n            then: |\n              An Active Fleet row appears at the top showing cards with task title,\n              agent name, elapsed time with pulse indicator, and last few lines of output\n          - id: ac-5\n            given: |\n              The task board with WebSocket connected\n            when: |\n              A task state changes\n            then: |\n              The board updates in real-time without page refresh\n          - id: ac-6\n            given: |\n              The task detail modal in daemon mode\n            when: |\n              The user clicks action buttons (Start, Submit, Complete, Block, Add Note)\n            then: |\n              The corresponding task transition or mutation is executed via API\n\n      - title: \"Session Stream View\"\n        slug: ui-session-stream\n        type: feature\n        parent: \"@web-ui\"\n        description: |\n          View for watching agent work — both historical and live. Renders structured\n          session events (messages, tool calls, thinking blocks) from events.jsonl.\n          Live sessions show streaming text with periodic structured refresh.\n        acceptance_criteria:\n          - id: ac-1\n            given: |\n              A completed session with events.jsonl\n            when: |\n              The user navigates to /sessions/:id\n            then: |\n              The session events render as structured blocks: agent messages (markdown),\n              tool calls (collapsible with icon, input/output, timing), and thinking blocks\n              (collapsed by default, expandable)\n          - id: ac-2\n            given: |\n              An active session with streaming output\n            when: |\n              The user views the session\n            then: |\n              Live text streams in real-time via agent_text_chunk WebSocket events,\n              with periodic structured refresh from events.jsonl\n          - id: ac-3\n            given: |\n              The session stream view\n            when: |\n              New content arrives while auto-scrolling\n            then: |\n              The view auto-scrolls to follow new content, pauses when user scrolls up\n              (>100px from bottom), and resumes when scrolled back. A \"jump to bottom\"\n              button appears when paused.\n          - id: ac-4\n            given: |\n              The session stream view\n            when: |\n              A session context panel is shown on the left\n            then: |\n              It displays session metadata, spec context with AC checklist,\n              files changed during session, and budget info\n\n      - title: \"Agent and Dispatch View\"\n        slug: ui-agent-dispatch\n        type: feature\n        parent: \"@web-ui\"\n        description: |\n          View showing agent definitions, dispatch status (running/stopped),\n          and active invocations with links to session streams.\n        acceptance_criteria:\n          - id: ac-1\n            given: |\n              The /agents route\n            when: |\n              Agent definitions exist in meta\n            then: |\n              Each agent shows name, triggers, active invocation count, and completed count\n          - id: ac-2\n            given: |\n              The dispatch engine is running\n            when: |\n              The agents page renders\n            then: |\n              Dispatch status shows as running with a stop button, and active invocations\n              show task ref, elapsed time, and link to session stream\n          - id: ac-3\n            given: |\n              The dispatch engine is stopped\n            when: |\n              The agents page renders\n            then: |\n              Dispatch status shows as stopped with no active invocations\n\n      - title: \"Session History\"\n        slug: ui-session-history\n        type: feature\n        parent: \"@web-ui\"\n        description: |\n          List view of past agent sessions with filtering and navigation to session detail.\n        acceptance_criteria:\n          - id: ac-1\n            given: |\n              Sessions exist on disk\n            when: |\n              The user navigates to /sessions\n            then: |\n              A list of sessions shows ID, agent type, task ref, status,\n              duration, and age, sorted by most recent first\n          - id: ac-2\n            given: |\n              The session list\n            when: |\n              The user clicks a session\n            then: |\n              They navigate to /sessions/:id showing the session stream view\n\n      - title: \"Enhanced Inbox View\"\n        slug: ui-inbox-enhanced\n        type: feature\n        parent: \"@web-ui\"\n        description: |\n          Enhanced inbox with triage status inline, quick actions, filtering, and bulk selection.\n        acceptance_criteria:\n          - id: ac-1\n            given: |\n              Inbox items with varying triage states\n            when: |\n              The inbox view renders\n            then: |\n              Each item shows triage status inline (untriaged/triaged/acted_on)\n              with quick triage action links\n          - id: ac-2\n            given: |\n              The inbox view\n            when: |\n              The user applies filters (status, tags, age)\n            then: |\n              The list filters accordingly\n\n      - title: \"Plans View\"\n        slug: ui-plans-view\n        type: feature\n        parent: \"@web-ui\"\n        description: |\n          View for browsing plan records with progress tracking via linked specs and tasks.\n        acceptance_criteria:\n          - id: ac-1\n            given: |\n              Plan records exist\n            when: |\n              The user navigates to /plans\n            then: |\n              Each plan shows title, status, creation date, linked spec/task counts,\n              and progress based on task completion status\n\n      - title: \"Validation and Alignment View\"\n        slug: ui-validation-view\n        type: feature\n        parent: \"@web-ui\"\n        description: |\n          View showing validation results, alignment statistics, and issues.\n        acceptance_criteria:\n          - id: ac-1\n            given: |\n              The user navigates to /validate\n            when: |\n              Validation data loads\n            then: |\n              Summary shows error count, warning count, valid item count.\n              Alignment section shows spec coverage %, AC coverage %,\n              orphaned tasks/specs counts. Issues list grouped by severity.\n\n      - title: \"Dashboard Overview\"\n        slug: ui-dashboard-overview\n        type: feature\n        parent: \"@web-ui\"\n        description: |\n          Home view answering \"what's happening right now?\" with active work,\n          status summary, recent activity, and needs-attention aggregation.\n        acceptance_criteria:\n          - id: ac-1\n            given: |\n              The user navigates to /\n            when: |\n              The dashboard renders\n            then: |\n              Active work section shows currently running agent tasks (if any),\n              status summary shows clickable count cards per status,\n              needs-attention section aggregates untriaged inbox, unresolved observations,\n              validation warnings, and blocked tasks\n      ```\n\n\n      ## Tasks\n\n\n      derive_from_specs: true\n\n\n      ### Implementation Notes\n\n\n      #### ui-design-system\n\n      Set up the isolated clone first. Port imgen's full token-contract.css into\n\n      Tailwind @theme inline in app.css. Start with the token bridge pilot on the\n\n      dashboard page to validate the approach before touching other views. Create\n\n      tokens.css, animations.css, typography.css in lib/ds/. Establish loading\n\n      skeleton and error boundary patterns.\n\n\n      #### ui-app-shell\n\n      Restructure +layout.svelte with new sidebar component. Migrate existing\n\n      Sidebar.svelte to grouped navigation. Add /items -> /specs redirect.\n\n      Fix Observations nav visibility bug. Migrate taskDetailStore from Svelte 4\n\n      to Svelte 5 runes. Consolidate three existing task detail implementations.\n\n      Ensure all existing routes still work.\n\n\n      #### ui-task-board\n\n      Prerequisite: daemon must return type and automation in task list API response\n\n      (quick fix to packages/daemon/src/routes/tasks.ts). Add needs_work to status\n\n      color/label maps. Build KanbanBoard, KanbanColumn, TaskCard, TaskDetailModal,\n\n      ActiveFleetRow components. Wire to tasks:updates WebSocket topic. Build task\n\n      mutation endpoints in daemon (submit, complete, block) for detail modal actions.\n\n\n      #### ui-session-stream\n\n      Prerequisite: build GET /api/sessions and GET /api/sessions/:id/events daemon\n\n      endpoints. Two-tier rendering: structured events from events.jsonl for history,\n\n      agent_text_chunk WS for live text. Build SessionStream, ChatMessage,\n\n      ToolCallView, ThinkingBlock components. Implement auto-scroll with pause/resume.\n\n      Port patterns from kynetic-internal's ChatPanel.\n\n\n      #### ui-agent-dispatch\n\n      Uses existing GET /api/agent/dispatch/status and GET /api/agent/status endpoints.\n\n      Subscribe to agents WS topic for real-time updates. Build AgentList,\n\n      DispatchStatus, InvocationCard components.\n\n\n      #### ui-session-history\n\n      Depends on GET /api/sessions endpoint from ui-session-stream work.\n\n      Build SessionList with filtering. Link to session stream view.\n\n\n      #### ui-inbox-enhanced\n\n      Enhance existing inbox view. Add triage status from existing triage API.\n\n      Add filter controls. Keep existing add/delete functionality.\n\n\n      #### ui-plans-view\n\n      Prerequisite: build GET /api/plans daemon endpoint (wrap existing loadAllPlans).\n\n      Build PlanList with progress calculation from linked task statuses.\n\n\n      #### ui-validation-view\n\n      Uses existing GET /api/validate and GET /api/alignment endpoints.\n\n      Build ValidationSummary, AlignmentStats, IssueList components.\n\n\n      #### ui-dashboard-overview\n\n      Build last. Uses data from tasks, inbox, observations, validation APIs.\n\n      Active work section reuses ActiveFleetRow from task board.\n\n      No aggregated activity API needed — merge recent data client-side.\n    status: active\n    derived_tasks:\n      - \"@implement-ui-design-system\"\n      - \"@implement-app-shell-and-navigation\"\n      - \"@implement-task-board-kanban\"\n      - \"@implement-session-stream-view\"\n      - \"@implement-agent-and-dispatch-view\"\n      - \"@implement-session-history\"\n      - \"@implement-enhanced-inbox-view\"\n      - \"@implement-plans-view\"\n      - \"@implement-validation-and-alignment-view\"\n      - \"@implement-dashboard-overview\"\n    derived_specs:\n      - \"@ui-design-system\"\n      - \"@ui-app-shell\"\n      - \"@ui-task-board\"\n      - \"@ui-session-stream\"\n      - \"@ui-agent-dispatch\"\n      - \"@ui-session-history\"\n      - \"@ui-inbox-enhanced\"\n      - \"@ui-plans-view\"\n      - \"@ui-validation-view\"\n      - \"@ui-dashboard-overview\"\n    source_path: /home/chapel/Projects/kynetic-spec/.kspec/artifacts/ui-revamp-import.md\n    created_at: 2026-03-05T01:30:02.718Z\n    approved_at: null\n    completed_at: null\n    notes:\n      - _ulid: 01KJXSVF2YDSBAM76XMSQHBCFX\n        created_at: 2026-03-05T01:30:02.718Z\n        author: \"@claude\"\n        content: |-\n          Implementation notes:\n\n          #### ui-design-system\n          Set up the isolated clone first. Port imgen's full token-contract.css into\n          Tailwind @theme inline in app.css. Start with the token bridge pilot on the\n          dashboard page to validate the approach before touching other views. Create\n          tokens.css, animations.css, typography.css in lib/ds/. Establish loading\n          skeleton and error boundary patterns.\n\n          #### ui-app-shell\n          Restructure +layout.svelte with new sidebar component. Migrate existing\n          Sidebar.svelte to grouped navigation. Add /items -> /specs redirect.\n          Fix Observations nav visibility bug. Migrate taskDetailStore from Svelte 4\n          to Svelte 5 runes. Consolidate three existing task detail implementations.\n          Ensure all existing routes still work.\n\n          #### ui-task-board\n          Prerequisite: daemon must return type and automation in task list API response\n          (quick fix to packages/daemon/src/routes/tasks.ts). Add needs_work to status\n          color/label maps. Build KanbanBoard, KanbanColumn, TaskCard, TaskDetailModal,\n          ActiveFleetRow components. Wire to tasks:updates WebSocket topic. Build task\n          mutation endpoints in daemon (submit, complete, block) for detail modal actions.","numLines":500,"startLine":7600,"totalLines":8133}},"toolName":"Read"}},"toolCallId":"toolu_01XtKFDrNvwd7srEJhTGmvDu","sessionUpdate":"tool_call_update"}}
.kspec/sessions/01KJY3FGB4W881DYXQ42PQHA59/events.jsonl:221:{"ts":1772684339384,"seq":220,"type":"session.update","session_id":"01KJY3FGB4W881DYXQ42PQHA59","data":{"_meta":{"claudeCode":{"toolName":"Read"}},"toolCallId":"toolu_01XtKFDrNvwd7srEJhTGmvDu","sessionUpdate":"tool_call_update","status":"completed","rawOutput":"  7600→    created_at: 2026-03-04T21:54:25.649Z\n  7601→    approved_at: null\n  7602→    completed_at: null\n  7603→    notes:\n  7604→      - _ulid: 01KJXDJAQZ6BF9RK02TYSEARZ0\n  7605→        created_at: 2026-03-04T21:55:20.447Z\n  7606→        author: \"@claude\"\n  7607→        content: \"Plan details: Add review_url field to task schema + dispatch prompt orientation context\n  7608→          (task title, trigger meaning, fix-cycle notes, review URL, template interpolation). Spec\n  7609→          ACs added to @task-submit (ac-submit-1 through ac-submit-3) and @agent-dispatch-engine\n  7610→          (ac-13 through ac-16). Full plan at ~/.claude/plans/resilient-wiggling-token.md\"\n  7611→  - _ulid: 01KJXSVF2YKCXMJGC55G1CPBV2\n  7612→    slugs:\n  7613→      - plan-ui-ux-revamp\n  7614→    title: UI/UX Revamp\n  7615→    content: >\n  7616→      # UI/UX Revamp\n  7617→\n  7618→\n  7619→      ## Specs\n  7620→\n  7621→\n  7622→      ```yaml\n  7623→\n  7624→      - title: \"UI Design System\"\n  7625→        slug: ui-design-system\n  7626→        type: feature\n  7627→        parent: \"@web-ui\"\n  7628→        description: |\n  7629→          Port imgen's design token architecture into kspec's Tailwind-based web UI.\n  7630→          Map oklch color tokens, spacing, radii, z-index, typography, and animation\n  7631→          keyframes as Tailwind theme extensions. Establish consistent visual language\n  7632→          across all views.\n  7633→        acceptance_criteria:\n  7634→          - id: ac-1\n  7635→            given: |\n  7636→              The web UI app.css file\n  7637→            when: |\n  7638→              imgen token-contract.css values are mapped as Tailwind @theme inline extensions\n  7639→            then: |\n  7640→              All 16 color tokens, 4 radii, 7 spacing, 7 z-index, and 3 font families\n  7641→              are available as Tailwind utility classes (e.g. bg-design-surface, border-design-border)\n  7642→          - id: ac-2\n  7643→            given: |\n  7644→              A component using design tokens\n  7645→            when: |\n  7646→              The dark theme tokens are applied\n  7647→            then: |\n  7648→              oklch colors render correctly and status colors (pending=amber, in_progress=orange,\n  7649→              pending_review=blue, needs_work=yellow, completed=emerald, blocked=red, cancelled=gray)\n  7650→              are visually distinct\n  7651→          - id: ac-3\n  7652→            given: |\n  7653→              A view with loading states\n  7654→            when: |\n  7655→              Content is loading\n  7656→            then: |\n  7657→              Shimmer animation plays on skeleton elements, gated behind prefers-reduced-motion\n  7658→          - id: ac-4\n  7659→            given: |\n  7660→              An active agent task card\n  7661→            when: |\n  7662→              The agent is working\n  7663→            then: |\n  7664→              Breathing/pulse animation plays on the card border, gated behind prefers-reduced-motion\n  7665→\n  7666→      - title: \"App Shell and Navigation\"\n  7667→        slug: ui-app-shell\n  7668→        type: feature\n  7669→        parent: \"@web-ui\"\n  7670→        description: |\n  7671→          Restructure the web UI layout with collapsible sidebar navigation, header bar\n  7672→          with command palette and connection status, and grouped navigation sections.\n  7673→          Preserve existing functionality during migration.\n  7674→        acceptance_criteria:\n  7675→          - id: ac-1\n  7676→            given: |\n  7677→              The web UI loaded in daemon mode\n  7678→            when: |\n  7679→              The app shell renders\n  7680→            then: |\n  7681→              A collapsible sidebar shows grouped navigation: Work (Dashboard, Tasks, Agents, Sessions),\n  7682→              Specs (Specs, Plans, Validate), Capture (Inbox, Observations, Triage),\n  7683→              Config (Workflows, Settings)\n  7684→          - id: ac-2\n  7685→            given: |\n  7686→              Sidebar navigation items\n  7687→            when: |\n  7688→              Items have actionable counts (inbox items, unresolved observations, pending review tasks)\n  7689→            then: |\n  7690→              Badge counts display next to the relevant nav items\n  7691→          - id: ac-3\n  7692→            given: |\n  7693→              The /items route\n  7694→            when: |\n  7695→              A user navigates to /items\n  7696→            then: |\n  7697→              They are redirected to /specs preserving any query parameters\n  7698→          - id: ac-4\n  7699→            given: |\n  7700→              The Observations nav item\n  7701→            when: |\n  7702→              There are zero unresolved observations\n  7703→            then: |\n  7704→              The nav item is still visible (not hidden)\n  7705→\n  7706→      - title: \"Task Board (Kanban)\"\n  7707→        slug: ui-task-board\n  7708→        type: feature\n  7709→        parent: \"@web-ui\"\n  7710→        description: |\n  7711→          Kanban-style task board with columns mapping to kspec task states.\n  7712→          Active Fleet row shows currently running agent work with live output.\n  7713→          Task cards show key metadata, clicking opens detail modal.\n  7714→          Not drag-and-drop — tasks transition via agents/CLI.\n  7715→        acceptance_criteria:\n  7716→          - id: ac-1\n  7717→            given: |\n  7718→              Tasks in various states\n  7719→            when: |\n  7720→              The task board renders\n  7721→            then: |\n  7722→              Tasks are distributed into columns: Backlog (pending, manual_only/unassessed),\n  7723→              Ready (pending, eligible), In Progress (in_progress, needs_work),\n  7724→              Review (pending_review), Done (completed recent), with blocked and cancelled\n  7725→              handled as sections/indicators\n  7726→          - id: ac-2\n  7727→            given: |\n  7728→              A task card on the board\n  7729→            when: |\n  7730→              The card renders\n  7731→            then: |\n  7732→              It shows priority badge, tag chips, title, slug (mono), spec ref link,\n  7733→              and metadata footer (notes count, dependency count, age)\n  7734→          - id: ac-3\n  7735→            given: |\n  7736→              A task card\n  7737→            when: |\n  7738→              The user clicks it\n  7739→            then: |\n  7740→              A detail modal opens showing full task info: title, description, status,\n  7741→              priority, type, spec ref, tags, dependencies, blocked-by, notes, todos,\n  7742→              automation status, VCS info (branch, PR link), plan ref, session link\n  7743→          - id: ac-4\n  7744→            given: |\n  7745→              Agents actively working on tasks (dispatch running)\n  7746→            when: |\n  7747→              The task board renders\n  7748→            then: |\n  7749→              An Active Fleet row appears at the top showing cards with task title,\n  7750→              agent name, elapsed time with pulse indicator, and last few lines of output\n  7751→          - id: ac-5\n  7752→            given: |\n  7753→              The task board with WebSocket connected\n  7754→            when: |\n  7755→              A task state changes\n  7756→            then: |\n  7757→              The board updates in real-time without page refresh\n  7758→          - id: ac-6\n  7759→            given: |\n  7760→              The task detail modal in daemon mode\n  7761→            when: |\n  7762→              The user clicks action buttons (Start, Submit, Complete, Block, Add Note)\n  7763→            then: |\n  7764→              The corresponding task transition or mutation is executed via API\n  7765→\n  7766→      - title: \"Session Stream View\"\n  7767→        slug: ui-session-stream\n  7768→        type: feature\n  7769→        parent: \"@web-ui\"\n  7770→        description: |\n  7771→          View for watching agent work — both historical and live. Renders structured\n  7772→          session events (messages, tool calls, thinking blocks) from events.jsonl.\n  7773→          Live sessions show streaming text with periodic structured refresh.\n  7774→        acceptance_criteria:\n  7775→          - id: ac-1\n  7776→            given: |\n  7777→              A completed session with events.jsonl\n  7778→            when: |\n  7779→              The user navigates to /sessions/:id\n  7780→            then: |\n  7781→              The session events render as structured blocks: agent messages (markdown),\n  7782→              tool calls (collapsible with icon, input/output, timing), and thinking blocks\n  7783→              (collapsed by default, expandable)\n  7784→          - id: ac-2\n  7785→            given: |\n  7786→              An active session with streaming output\n  7787→            when: |\n  7788→              The user views the session\n  7789→            then: |\n  7790→              Live text streams in real-time via agent_text_chunk WebSocket events,\n  7791→              with periodic structured refresh from events.jsonl\n  7792→          - id: ac-3\n  7793→            given: |\n  7794→              The session stream view\n  7795→            when: |\n  7796→              New content arrives while auto-scrolling\n  7797→            then: |\n  7798→              The view auto-scrolls to follow new content, pauses when user scrolls up\n  7799→              (>100px from bottom), and resumes when scrolled back. A \"jump to bottom\"\n  7800→              button appears when paused.\n  7801→          - id: ac-4\n  7802→            given: |\n  7803→              The session stream view\n  7804→            when: |\n  7805→              A session context panel is shown on the left\n  7806→            then: |\n  7807→              It displays session metadata, spec context with AC checklist,\n  7808→              files changed during session, and budget info\n  7809→\n  7810→      - title: \"Agent and Dispatch View\"\n  7811→        slug: ui-agent-dispatch\n  7812→        type: feature\n  7813→        parent: \"@web-ui\"\n  7814→        description: |\n  7815→          View showing agent definitions, dispatch status (running/stopped),\n  7816→          and active invocations with links to session streams.\n  7817→        acceptance_criteria:\n  7818→          - id: ac-1\n  7819→            given: |\n  7820→              The /agents route\n  7821→            when: |\n  7822→              Agent definitions exist in meta\n  7823→            then: |\n  7824→              Each agent shows name, triggers, active invocation count, and completed count\n  7825→          - id: ac-2\n  7826→            given: |\n  7827→              The dispatch engine is running\n  7828→            when: |\n  7829→              The agents page renders\n  7830→            then: |\n  7831→              Dispatch status shows as running with a stop button, and active invocations\n  7832→              show task ref, elapsed time, and link to session stream\n  7833→          - id: ac-3\n  7834→            given: |\n  7835→              The dispatch engine is stopped\n  7836→            when: |\n  7837→              The agents page renders\n  7838→            then: |\n  7839→              Dispatch status shows as stopped with no active invocations\n  7840→\n  7841→      - title: \"Session History\"\n  7842→        slug: ui-session-history\n  7843→        type: feature\n  7844→        parent: \"@web-ui\"\n  7845→        description: |\n  7846→          List view of past agent sessions with filtering and navigation to session detail.\n  7847→        acceptance_criteria:\n  7848→          - id: ac-1\n  7849→            given: |\n  7850→              Sessions exist on disk\n  7851→            when: |\n  7852→              The user navigates to /sessions\n  7853→            then: |\n  7854→              A list of sessions shows ID, agent type, task ref, status,\n  7855→              duration, and age, sorted by most recent first\n  7856→          - id: ac-2\n  7857→            given: |\n  7858→              The session list\n  7859→            when: |\n  7860→              The user clicks a session\n  7861→            then: |\n  7862→              They navigate to /sessions/:id showing the session stream view\n  7863→\n  7864→      - title: \"Enhanced Inbox View\"\n  7865→        slug: ui-inbox-enhanced\n  7866→        type: feature\n  7867→        parent: \"@web-ui\"\n  7868→        description: |\n  7869→          Enhanced inbox with triage status inline, quick actions, filtering, and bulk selection.\n  7870→        acceptance_criteria:\n  7871→          - id: ac-1\n  7872→            given: |\n  7873→              Inbox items with varying triage states\n  7874→            when: |\n  7875→              The inbox view renders\n  7876→            then: |\n  7877→              Each item shows triage status inline (untriaged/triaged/acted_on)\n  7878→              with quick triage action links\n  7879→          - id: ac-2\n  7880→            given: |\n  7881→              The inbox view\n  7882→            when: |\n  7883→              The user applies filters (status, tags, age)\n  7884→            then: |\n  7885→              The list filters accordingly\n  7886→\n  7887→      - title: \"Plans View\"\n  7888→        slug: ui-plans-view\n  7889→        type: feature\n  7890→        parent: \"@web-ui\"\n  7891→        description: |\n  7892→          View for browsing plan records with progress tracking via linked specs and tasks.\n  7893→        acceptance_criteria:\n  7894→          - id: ac-1\n  7895→            given: |\n  7896→              Plan records exist\n  7897→            when: |\n  7898→              The user navigates to /plans\n  7899→            then: |\n  7900→              Each plan shows title, status, creation date, linked spec/task counts,\n  7901→              and progress based on task completion status\n  7902→\n  7903→      - title: \"Validation and Alignment View\"\n  7904→        slug: ui-validation-view\n  7905→        type: feature\n  7906→        parent: \"@web-ui\"\n  7907→        description: |\n  7908→          View showing validation results, alignment statistics, and issues.\n  7909→        acceptance_criteria:\n  7910→          - id: ac-1\n  7911→            given: |\n  7912→              The user navigates to /validate\n  7913→            when: |\n  7914→              Validation data loads\n  7915→            then: |\n  7916→              Summary shows error count, warning count, valid item count.\n  7917→              Alignment section shows spec coverage %, AC coverage %,\n  7918→              orphaned tasks/specs counts. Issues list grouped by severity.\n  7919→\n  7920→      - title: \"Dashboard Overview\"\n  7921→        slug: ui-dashboard-overview\n  7922→        type: feature\n  7923→        parent: \"@web-ui\"\n  7924→        description: |\n  7925→          Home view answering \"what's happening right now?\" with active work,\n  7926→          status summary, recent activity, and needs-attention aggregation.\n  7927→        acceptance_criteria:\n  7928→          - id: ac-1\n  7929→            given: |\n  7930→              The user navigates to /\n  7931→            when: |\n  7932→              The dashboard renders\n  7933→            then: |\n  7934→              Active work section shows currently running agent tasks (if any),\n  7935→              status summary shows clickable count cards per status,\n  7936→              needs-attention section aggregates untriaged inbox, unresolved observations,\n  7937→              validation warnings, and blocked tasks\n  7938→      ```\n  7939→\n  7940→\n  7941→      ## Tasks\n  7942→\n  7943→\n  7944→      derive_from_specs: true\n  7945→\n  7946→\n  7947→      ### Implementation Notes\n  7948→\n  7949→\n  7950→      #### ui-design-system\n  7951→\n  7952→      Set up the isolated clone first. Port imgen's full token-contract.css into\n  7953→\n  7954→      Tailwind @theme inline in app.css. Start with the token bridge pilot on the\n  7955→\n  7956→      dashboard page to validate the approach before touching other views. Create\n  7957→\n  7958→      tokens.css, animations.css, typography.css in lib/ds/. Establish loading\n  7959→\n  7960→      skeleton and error boundary patterns.\n  7961→\n  7962→\n  7963→      #### ui-app-shell\n  7964→\n  7965→      Restructure +layout.svelte with new sidebar component. Migrate existing\n  7966→\n  7967→      Sidebar.svelte to grouped navigation. Add /items -> /specs redirect.\n  7968→\n  7969→      Fix Observations nav visibility bug. Migrate taskDetailStore from Svelte 4\n  7970→\n  7971→      to Svelte 5 runes. Consolidate three existing task detail implementations.\n  7972→\n  7973→      Ensure all existing routes still work.\n  7974→\n  7975→\n  7976→      #### ui-task-board\n  7977→\n  7978→      Prerequisite: daemon must return type and automation in task list API response\n  7979→\n  7980→      (quick fix to packages/daemon/src/routes/tasks.ts). Add needs_work to status\n  7981→\n  7982→      color/label maps. Build KanbanBoard, KanbanColumn, TaskCard, TaskDetailModal,\n  7983→\n  7984→      ActiveFleetRow components. Wire to tasks:updates WebSocket topic. Build task\n  7985→\n  7986→      mutation endpoints in daemon (submit, complete, block) for detail modal actions.\n  7987→\n  7988→\n  7989→      #### ui-session-stream\n  7990→\n  7991→      Prerequisite: build GET /api/sessions and GET /api/sessions/:id/events daemon\n  7992→\n  7993→      endpoints. Two-tier rendering: structured events from events.jsonl for history,\n  7994→\n  7995→      agent_text_chunk WS for live text. Build SessionStream, ChatMessage,\n  7996→\n  7997→      ToolCallView, ThinkingBlock components. Implement auto-scroll with pause/resume.\n  7998→\n  7999→      Port patterns from kynetic-internal's ChatPanel.\n  8000→\n  8001→\n  8002→      #### ui-agent-dispatch\n  8003→\n  8004→      Uses existing GET /api/agent/dispatch/status and GET /api/agent/status endpoints.\n  8005→\n  8006→      Subscribe to agents WS topic for real-time updates. Build AgentList,\n  8007→\n  8008→      DispatchStatus, InvocationCard components.\n  8009→\n  8010→\n  8011→      #### ui-session-history\n  8012→\n  8013→      Depends on GET /api/sessions endpoint from ui-session-stream work.\n  8014→\n  8015→      Build SessionList with filtering. Link to session stream view.\n  8016→\n  8017→\n  8018→      #### ui-inbox-enhanced\n  8019→\n  8020→      Enhance existing inbox view. Add triage status from existing triage API.\n  8021→\n  8022→      Add filter controls. Keep existing add/delete functionality.\n  8023→\n  8024→\n  8025→      #### ui-plans-view\n  8026→\n  8027→      Prerequisite: build GET /api/plans daemon endpoint (wrap existing loadAllPlans).\n  8028→\n  8029→      Build PlanList with progress calculation from linked task statuses.\n  8030→\n  8031→\n  8032→      #### ui-validation-view\n  8033→\n  8034→      Uses existing GET /api/validate and GET /api/alignment endpoints.\n  8035→\n  8036→      Build ValidationSummary, AlignmentStats, IssueList components.\n  8037→\n  8038→\n  8039→      #### ui-dashboard-overview\n  8040→\n  8041→      Build last. Uses data from tasks, inbox, observations, validation APIs.\n  8042→\n  8043→      Active work section reuses ActiveFleetRow from task board.\n  8044→\n  8045→      No aggregated activity API needed — merge recent data client-side.\n  8046→    status: active\n  8047→    derived_tasks:\n  8048→      - \"@implement-ui-design-system\"\n  8049→      - \"@implement-app-shell-and-navigation\"\n  8050→      - \"@implement-task-board-kanban\"\n  8051→      - \"@implement-session-stream-view\"\n  8052→      - \"@implement-agent-and-dispatch-view\"\n  8053→      - \"@implement-session-history\"\n  8054→      - \"@implement-enhanced-inbox-view\"\n  8055→      - \"@implement-plans-view\"\n  8056→      - \"@implement-validation-and-alignment-view\"\n  8057→      - \"@implement-dashboard-overview\"\n  8058→    derived_specs:\n  8059→      - \"@ui-design-system\"\n  8060→      - \"@ui-app-shell\"\n  8061→      - \"@ui-task-board\"\n  8062→      - \"@ui-session-stream\"\n  8063→      - \"@ui-agent-dispatch\"\n  8064→      - \"@ui-session-history\"\n  8065→      - \"@ui-inbox-enhanced\"\n  8066→      - \"@ui-plans-view\"\n  8067→      - \"@ui-validation-view\"\n  8068→      - \"@ui-dashboard-overview\"\n  8069→    source_path: /home/chapel/Projects/kynetic-spec/.kspec/artifacts/ui-revamp-import.md\n  8070→    created_at: 2026-03-05T01:30:02.718Z\n  8071→    approved_at: null\n  8072→    completed_at: null\n  8073→    notes:\n  8074→      - _ulid: 01KJXSVF2YDSBAM76XMSQHBCFX\n  8075→        created_at: 2026-03-05T01:30:02.718Z\n  8076→        author: \"@claude\"\n  8077→        content: |-\n  8078→          Implementation notes:\n  8079→\n  8080→          #### ui-design-system\n  8081→          Set up the isolated clone first. Port imgen's full token-contract.css into\n  8082→          Tailwind @theme inline in app.css. Start with the token bridge pilot on the\n  8083→          dashboard page to validate the approach before touching other views. Create\n  8084→          tokens.css, animations.css, typography.css in lib/ds/. Establish loading\n  8085→          skeleton and error boundary patterns.\n  8086→\n  8087→          #### ui-app-shell\n  8088→          Restructure +layout.svelte with new sidebar component. Migrate existing\n  8089→          Sidebar.svelte to grouped navigation. Add /items -> /specs redirect.\n  8090→          Fix Observations nav visibility bug. Migrate taskDetailStore from Svelte 4\n  8091→          to Svelte 5 runes. Consolidate three existing task detail implementations.\n  8092→          Ensure all existing routes still work.\n  8093→\n  8094→          #### ui-task-board\n  8095→          Prerequisite: daemon must return type and automation in task list API response\n  8096→          (quick fix to packages/daemon/src/routes/tasks.ts). Add needs_work to status\n  8097→          color/label maps. Build KanbanBoard, KanbanColumn, TaskCard, TaskDetailModal,\n  8098→          ActiveFleetRow components. Wire to tasks:updates WebSocket topic. Build task\n  8099→          mutation endpoints in daemon (submit, complete, block) for detail modal actions.","content":[{"type":"content","content":{"type":"text","text":{"path":"blobs/000220-content-0-content-text-49ec9946-4d9c-49a6-af82-3ad862b22462.blob","bytes":23056,"sha256":"1e2adf3ad723957ac9dc0b3d7489c8cfd5158bede16a846f5fb9bbde65a0e795","truncated":true,"preview":"```\n  7600→    created_at: 2026-03-04T21:54:25.649Z\n  7601→    approved_at: null\n  7602→    completed_at: null\n  7603→    notes:\n  7604→      - _ulid: 01KJXDJAQZ6BF9RK02TYSEARZ0\n  7605→        created_at: 2026-03-04T21:55:20.447Z\n  7606→        author: \"@claude\"\n  7607→        content: \"Plan details: Add review_url field to task schema + dispatch prompt orientation context\n  7608→          (task title, trigger meaning, fix-cycle notes, review URL, template interpolation). Spec\n  7609→   ..."}}}]}}
.kspec/sessions/01KJY3FGB4W881DYXQ42PQHA59/events.jsonl:253:{"ts":1772684343200,"seq":252,"type":"session.update","session_id":"01KJY3FGB4W881DYXQ42PQHA59","data":{"_meta":{"claudeCode":{"toolResponse":{"type":"text","file":{"filePath":"/home/chapel/Projects/kynetic-spec-ui/.kspec/modules/web-ui.yaml","content":"_ulid: 01KFHMF5ZS4RD70JBQNGBQJVFY\nslugs:\n  - web-ui\ntitle: Web UI System\ntype: module\nstatus:\n  maturity: draft\n  implementation: implemented\ndescription: >\n  Web-based interface for viewing, editing, and managing kspec state. Includes three deployment\n  modes:\n\n  1. Local daemon mode - Elysia.js server on Bun with WebSocket for real-time updates\n\n  2. Web dashboard - SvelteKit + shadcn-svelte for full CRUD operations\n\n  3. GitHub Pages export - Static JSON snapshot with read-only SPA for public sharing\n\n\n  Tech stack: Elysia.js, Bun runtime, WebSocket (not SSE), SvelteKit, shadcn-svelte.\n\n  Distribution via bun build --compile for portable executables.\ntags:\n  - web\n  - ui\n  - daemon\n  - elysia\n  - bun\ndepends_on: []\nimplements: []\nrelates_to: []\ntests: []\ntraits: []\nnotes: []\nfeatures:\n  - _ulid: 01KFHMFGD2563NGHJWPPXGN9CB\n    slugs:\n      - daemon-server\n    title: Daemon Server Mode\n    type: feature\n    tags:\n      - server\n      - websocket\n      - elysia\n    description: >\n      Long-running Elysia.js server on Bun runtime that exposes kspec state via HTTP API and\n      WebSocket\n\n      for real-time updates. Binds to localhost only for security. Supports foreground and\n      background\n\n      modes with PID file management. Includes heartbeat ping/pong for connection health monitoring.\n    depends_on: []\n    implements: []\n    relates_to: []\n    tests: []\n    traits:\n      - \"@trait-json-output\"\n      - \"@trait-error-guidance\"\n      - \"@trait-shadow-commit\"\n      - \"@trait-localhost-security\"\n      - \"@trait-websocket-protocol\"\n    notes: []\n    created: 2026-01-22T01:18:09.314Z\n    acceptance_criteria:\n      - id: ac-1\n        given: kspec is installed\n        when: user runs 'kspec serve'\n        then: Elysia HTTP server starts on configurable port (default 3456) binding to localhost only\n      - id: ac-2\n        given: daemon is starting\n        when: server binds to network interface\n        then: only accepts connections from 127.0.0.1 and ::1 (IPv6 localhost)\n      - id: ac-3\n        given: connection attempt from non-localhost IP\n        when: request received\n        then: connection rejected with 403 Forbidden\n      - id: ac-4\n        given: daemon is running\n        when: any .kspec/*.yaml file changes\n        then: connected WebSocket clients receive update event via topic subscription\n      - id: ac-5\n        given: file watching is active\n        when: rapid changes occur (< 500ms apart)\n        then: events are debounced and aggregated into single notification\n      - id: ac-6\n        given: watched file has YAML parse error\n        when: change detected\n        then: error logged and WebSocket broadcasts error event (daemon does not crash)\n      - id: ac-7\n        given: .kspec directory becomes inaccessible\n        when: watcher encounters error\n        then: daemon logs error and attempts recovery with exponential backoff\n      - id: ac-8\n        given: Bun fs.watch fails or misses events\n        when: reliability issue detected\n        then: automatically fall back to Chokidar file watcher\n      - id: ac-9\n        given: daemon is running\n        when: user runs 'kspec serve --daemon'\n        then: process detaches to background, writes PID to .kspec/.daemon.pid, CLI returns immediately\n      - id: ac-10\n        given: daemon is running in background\n        when: user runs 'kspec serve stop'\n        then: daemon shuts down gracefully, removes PID file, closes all WebSocket connections\n      - id: ac-11\n        given: daemon is running\n        when: GET /api/health is called\n        then: returns {status, uptime, connections, version} JSON\n      - id: ac-12\n        given: daemon receives SIGTERM or SIGINT\n        when: shutdown signal received\n        then: graceful shutdown (flush pending messages, close connections, save state)\n      - id: ac-13\n        given: WebSocket connection established\n        when: 30 seconds pass without activity\n        then: server sends ping frame\n      - id: ac-14\n        given: ping was sent\n        when: no pong received within 90 seconds\n        then: connection closed with code 1001\n      - id: ac-15\n        given: Elysia server is configured\n        when: routes are registered\n        then: use plugin pattern for middleware (CORS, logging, validation)\n      - id: ac-16\n        given: daemon code is ready\n        when: bun build --compile runs\n        then: produces standalone executable without requiring Bun installation\n      - id: ac-17\n        given: daemon is running with web UI built\n        when: browser opens http://localhost:<port>/\n        then: serves the built web UI assets (SvelteKit static build) as the root route\n    status:\n      maturity: draft\n      implementation: in_progress\n    features:\n      - _ulid: 01KJP2768T96S8870BH36ZE76K\n        slugs:\n          - daemon-agent-dispatch\n        title: Daemon Agent Dispatch Integration\n        type: feature\n        tags: []\n        description: |\n          Agent dispatch API routes in the daemon, enhanced file watcher with\n          task state diffing for change detection, CLI event emission endpoint,\n          and WebSocket broadcasts for agent invocation status.\n        acceptance_criteria:\n          - id: ac-1\n            given: |\n              The daemon is running with dispatch enabled\n            when: |\n              The file watcher detects a change in project.tasks.yaml\n            then: |\n              The watcher parses the new task states, diffs against the\n              previously cached states, and emits state change events to\n              the dispatch engine for each detected transition\n          - id: ac-2\n            given: |\n              A CLI command changes task state (e.g. kspec task start)\n            when: |\n              The daemon is running\n            then: |\n              The CLI posts a JSON event to POST /api/agent/events containing\n              task_id, previous_status, new_status, and timestamp\n          - id: ac-3\n            given: |\n              The daemon receives a state change event matching dispatch rules\n            when: |\n              The dispatch engine processes it\n            then: |\n              The agent is dispatched and a status event is broadcast on the\n              agents WebSocket topic\n          - id: ac-4\n            given: |\n              A WebSocket client subscribes to agent status updates\n            when: |\n              An agent invocation starts, completes, or fails\n            then: |\n              A broadcast event is sent containing session_id, agent_id,\n              task_id, status, and timestamp\n          - id: ac-5\n            given: |\n              GET /api/agent/status is called\n            when: |\n              The dispatch engine is running\n            then: |\n              Returns JSON with active invocations array, queue depth number,\n              dispatch_enabled boolean, and agent_definitions array\n          - id: ac-6\n            given: |\n              POST /api/agent/dispatch is called with action start or stop\n            when: |\n              The request is from localhost\n            then: |\n              The dispatch engine starts or stops and returns JSON with the\n              new dispatch_enabled state\n          - id: ac-7\n            given: |\n              The daemon is not running\n            when: |\n              A CLI command changes task state\n            then: |\n              The event emission POST fails silently with no error to the\n              user — dispatch requires a running daemon\n          - id: ac-8\n            given: The dispatch engine runs an agent invocation\n            when: The agent produces text output (agent_message_chunk events)\n            then: The daemon broadcasts each text chunk on the agents WebSocket topic with type\n              agent_text_chunk, session_id, agent_id, task_id, text, and timestamp\n        depends_on: []\n        implements: []\n        relates_to: []\n        tests: []\n        traits:\n          - \"@trait-api-endpoint\"\n          - \"@trait-localhost-security\"\n          - \"@trait-websocket-protocol\"\n        notes: []\n        created: 2026-03-02T01:22:20.058Z\n        status:\n          maturity: draft\n          implementation: implemented\n    requirements:\n      - _ulid: 01KJRZWDCC8W2WT0Q3A9CZAAGY\n        slugs:\n          - daemon-web-ui-bundle\n        title: Web UI assets bundled in npm package\n        type: requirement\n        tags: []\n        depends_on: []\n        implements: []\n        relates_to: []\n        tests: []\n        traits: []\n        notes: []\n        created: 2026-03-03T04:39:13.036Z\n        description: The kspec npm package bundles the pre-built web UI static assets so the daemon can\n          serve the web UI when installed in any project, without requiring a local web UI build.\n          The build pipeline copies packages/web-ui/build to dist/web-ui/, and resolveWebUiPath\n          falls back to that location relative to the daemon module.\n        acceptance_criteria:\n          - id: ac-1\n            given: npm run build is executed\n            when: build completes\n            then: packages/web-ui/build output is copied to dist/web-ui/ in the package\n          - id: ac-2\n            given: kspec is installed in a project with no local web UI build\n            when: daemon starts and resolves web UI path\n            then: resolveWebUiPath returns the bundled dist/web-ui/ path relative to the daemon module location\n          - id: ac-3\n            given: kspec is installed as an npm package in a non-monorepo project\n            when: browser opens http://localhost:3456/\n            then: daemon serves the bundled web UI and returns HTTP 200 with HTML content\n          - id: ac-4\n            given: an explicit webUiDir option or WEB_UI_DIR env var or local packages/web-ui/build is present\n            when: daemon starts\n            then: the explicit or local path takes precedence over the bundled dist/web-ui/ fallback\n        status:\n          maturity: draft\n          implementation: implemented\n      - _ulid: 01KJTVMGPNP3HN9B9SRF6MEER7\n        slugs:\n          - ws-disconnect-lifecycle-cleanup\n        title: WebSocket Disconnect Lifecycle Cleanup\n        type: requirement\n        tags:\n          - daemon\n          - websocket\n          - reliability\n        description: Ensure daemon WebSocket disconnect handling is accurate for abnormal closes. Disconnect\n          events must reliably identify the same session created on connect, remove that session\n          from in-memory registries, and prevent stale heartbeat/client counts after client\n          disconnect or process termination.\n        depends_on: []\n        implements: []\n        relates_to: []\n        tests: []\n        traits: []\n        notes: []\n        created: 2026-03-03T22:03:28.854Z\n        acceptance_criteria:\n          - id: ac-1\n            given: multiple clients are connected and one disconnects\n            when: GET /api/health is requested\n            then: the connections field reflects only currently active sessions\n          - id: ac-3\n            given: a disconnected session was previously in heartbeat monitoring\n            when: the next heartbeat interval executes\n            then: the daemon does not attempt to ping that session and emits no stale heartbeat ping log for it\n          - id: ac-2\n            given: a WebSocket client disconnects unexpectedly with close code 1006\n            when: the daemon close handler runs\n            then: the session is removed from pubsub connection tracking and the disconnect log includes that\n              session id rather than undefined\n        status:\n          maturity: draft\n          implementation: implemented\n  - _ulid: 01KFMM8F5V7H46QYW9MVFYRTHW\n    slugs:\n      - api-contract\n    title: REST and WebSocket API Contract\n    type: feature\n    tags:\n      - api\n      - rest\n      - websocket\n    description: |\n      REST API contract for HTTP endpoints and WebSocket protocol for real-time communication.\n      All REST endpoints return JSON with consistent patterns. WebSocket uses topic-based pub/sub\n      with request_id correlation for command acknowledgment.\n    depends_on:\n      - \"@daemon-server\"\n    implements: []\n    relates_to: []\n    tests: []\n    traits:\n      - \"@trait-json-output\"\n      - \"@trait-filterable-list\"\n      - \"@trait-error-guidance\"\n      - \"@trait-api-endpoint\"\n      - \"@trait-websocket-protocol\"\n    notes: []\n    created: 2026-01-22T07:00:00.000Z\n    acceptance_criteria:\n      - id: ac-1\n        given: daemon is running\n        when: request from allowed CORS origin received\n        then: CORS headers allow the request (origins configured for dev and production)\n      - id: ac-2\n        given: daemon is running\n        when: GET /api/tasks is called\n        then: returns JSON array of all tasks with status, priority, spec_ref, notes count\n      - id: ac-3\n        given: daemon is running\n        when: GET /api/tasks with status filter (e.g., ?status=pending&status=in_progress)\n        then: returns only tasks matching filter (supports multi-value)\n      - id: ac-4\n        given: daemon is running\n        when: GET /api/tasks with pagination (?limit=10&offset=20)\n        then: returns paginated results with {items, total, offset, limit} wrapper\n      - id: ac-5\n        given: daemon is running\n        when: GET /api/tasks/:ref is called\n        then: resolves ref via ReferenceIndex, returns full task with notes, todos, dependencies\n      - id: ac-6\n        given: daemon is running\n        when: POST /api/tasks/:ref/start is called\n        then: task transitions to in_progress, WebSocket broadcasts update, returns updated task\n      - id: ac-7\n        given: daemon is running\n        when: POST /api/tasks/:ref/note with {content} body\n        then: note appended to task, shadow commit occurs, WebSocket broadcasts update\n      - id: ac-8\n        given: daemon is running\n        when: GET /api/items is called\n        then: returns JSON array of all spec items (modules, features, requirements)\n      - id: ac-9\n        given: daemon is running\n        when: GET /api/items with type filter (?type=feature&type=requirement)\n        then: returns only items matching type filter\n      - id: ac-10\n        given: daemon is running\n        when: GET /api/items/:ref is called\n        then: resolves ref, returns full item with acceptance_criteria, traits, relationships\n      - id: ac-11\n        given: daemon is running\n        when: GET /api/items/:ref/tasks is called\n        then: returns tasks linked to this spec via AlignmentIndex\n      - id: ac-12\n        given: daemon is running\n        when: GET /api/inbox is called\n        then: returns all inbox items ordered by created_at desc\n      - id: ac-13\n        given: daemon is running\n        when: POST /api/inbox with {text} body\n        then: creates inbox item, returns with generated ULID\n      - id: ac-14\n        given: daemon is running\n        when: DELETE /api/inbox/:ref is called\n        then: removes inbox item, returns success confirmation\n      - id: ac-15\n        given: daemon is running\n        when: GET /api/meta/session is called\n        then: returns current session context (focus, threads, questions)\n      - id: ac-16\n        given: daemon is running\n        when: GET /api/meta/agents is called\n        then: returns all defined agents\n      - id: ac-17\n        given: daemon is running\n        when: GET /api/meta/workflows is called\n        then: returns all defined workflows\n      - id: ac-18\n        given: daemon is running\n        when: GET /api/meta/observations with filter (?resolved=false)\n        then: returns observations matching filter\n      - id: ac-19\n        given: daemon is running\n        when: GET /api/search?q=login is called\n        then: searches across all items using grep/title matching\n      - id: ac-20\n        given: daemon is running\n        when: GET /api/validate is called\n        then: runs full validation, returns ValidationResult\n      - id: ac-21\n        given: daemon is running\n        when: GET /api/alignment is called\n        then: returns AlignmentIndex stats and warnings\n      - id: ac-22\n        given: API request has invalid ref\n        when: any endpoint with :ref parameter\n        then: returns {error, message, suggestion} with 404 status, suggests similar refs if available\n      - id: ac-23\n        given: API request has validation error\n        when: POST/PUT with invalid body\n        then: returns {error, details:[{field, message}]} with 400 status\n      - id: ac-24\n        given: API request causes state transition error\n        when: POST action violates state machine\n        then: returns {error, current, valid_transitions} with 409 status\n      - id: ac-25\n        given: client connects to /ws\n        when: WebSocket connection established\n        then: receives connected event with {session_id}\n      - id: ac-26\n        given: WebSocket connection active\n        when: client sends command\n        then: command format is {action, request_id?, payload}\n      - id: ac-27\n        given: command received\n        when: processed\n        then: \"server sends {ack: true, request_id, success, error?}\"\n      - id: ac-28\n        given: WebSocket connection\n        when: \"client sends {action: 'subscribe', topics: ['files:updates']}\"\n        then: server tracks subscription and sends events for that topic\n      - id: ac-29\n        given: file changes in .kspec/\n        when: WebSocket client subscribed to files:updates\n        then: \"receives event with format {msg_id, seq, timestamp, topic, event, data: {ref, action}}\"\n      - id: ac-30\n        given: malformed command received\n        when: parsed\n        then: \"return {ack: false, error: 'validation_error', details: ...}\"\n      - id: ac-31\n        given: connection closing\n        when: close initiated\n        then: use code 1000 for clean, 1001 for timeout, 1011 for error\n      - id: ac-32\n        given: server sends to slow client\n        when: backpressure limit reached\n        then: pause non-critical broadcasts until drain event\n      - id: ac-33\n        given: daemon is shutting down\n        when: WebSocket connection active\n        then: receives shutdown event with {reason}, connection closes gracefully\n    status:\n      maturity: draft\n      implementation: in_progress\n  - _ulid: 01KFHMFJD571JQEE33AKKMEQSJ\n    slugs:\n      - web-dashboard\n    title: Web Dashboard\n    type: feature\n    tags:\n      - svelte\n      - ui\n      - dashboard\n    description: |\n      SvelteKit-based web interface for viewing and editing specs, tasks, inbox, and session state.\n      Uses shadcn-svelte components for accessible UI. Connects to daemon via REST API and WebSocket\n      for real-time updates. Includes WebSocketManager for connection resilience with exponential\n      backoff reconnection and sequence deduplication.\n    depends_on:\n      - \"@api-contract\"\n    implements: []\n    relates_to: []\n    tests: []\n    traits:\n      - \"@trait-filterable-list\"\n      - \"@trait-websocket-protocol\"\n    notes: []\n    created: 2026-01-22T01:18:11.366Z\n    acceptance_criteria:\n      - id: ac-1\n        given: daemon is running on configured port (default 3456)\n        when: browser opens the daemon URL\n        then: dashboard shows task overview with ready, in_progress, pending_review, blocked, completed\n          counts\n      - id: ac-2\n        given: dashboard is displayed\n        when: task counts update on server\n        then: counts animate to new values without page refresh (WebSocket-driven)\n      - id: ac-3\n        given: dashboard is displayed\n        when: user clicks a task count badge\n        then: navigates to task list filtered by that status\n      - id: ac-4\n        given: user is viewing task list\n        when: list loads\n        then: shows task title, status badge, priority indicator, spec_ref link, notes count\n      - id: ac-5\n        given: user is viewing task list\n        when: clicking a task row\n        then: task detail panel opens showing description, notes (chronological), todos, dependencies\n      - id: ac-6\n        given: user is viewing task detail\n        when: task has spec_ref\n        then: spec reference is clickable link to spec item detail\n      - id: ac-7\n        given: user is viewing task detail\n        when: user clicks Start Task button\n        then: POST to /api/tasks/:ref/start, task status updates, UI reflects change\n      - id: ac-8\n        given: user is viewing task detail\n        when: user types in note textarea and clicks Add Note\n        then: POST to /api/tasks/:ref/note, note appears in list\n      - id: ac-9\n        given: user is viewing task list\n        when: filter controls are visible\n        then: can filter by status, type, tag, assignee, automation status\n      - id: ac-10\n        given: user applies filter\n        when: filter selection changes\n        then: URL updates with query params, list updates without full reload\n      - id: ac-11\n        given: user navigates to /items\n        when: spec tree displays\n        then: shows hierarchical tree with modules > features > requirements, expand/collapse\n      - id: ac-12\n        given: user clicks spec item in tree\n        when: item detail panel opens\n        then: shows title, description, acceptance criteria (GWT format), traits, implementation status\n      - id: ac-13\n        given: spec item has linked tasks\n        when: viewing item detail\n        then: Implementation section shows linked tasks with their status\n      - id: ac-14\n        given: spec item has traits\n        when: viewing item detail\n        then: Traits section shows trait titles as chips, clickable to trait detail\n      - id: ac-15\n        given: user clicks acceptance criterion\n        when: AC row expands\n        then: shows full Given/When/Then text with test coverage indicator 
```
