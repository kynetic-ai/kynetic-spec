   303→        data: { action: 'start' },
   304→        headers: { 'Content-Type': 'application/json' },
   305→      });
   306→
   307→      await page.goto('/agents');
   308→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
   309→
   310→      const invocationsSection = page.getByTestId('active-invocations-section');
   311→      await expect(invocationsSection).toHaveAttribute('aria-live', 'polite');
   312→
   313→      // Clean up
