   386→
   387→    // AC: @ui-agent-dispatch ac-4
   388→    test('cancel discards changes and closes dialog', async ({ page, daemon }) => {
   389→      await page.goto('/agents');
   390→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
   391→
   392→      await page.getByTestId('agent-edit-button-task-worker').click();
   393→      await expect(page.getByTestId('agent-edit-dialog')).toBeVisible();
   394→
   395→      // Modify name
   396→      const nameInput = page.getByTestId('agent-edit-name');
   397→      await nameInput.fill('Modified Name');
   398→
   399→      // Cancel
   400→      await page.getByTestId('agent-edit-cancel').click();
   401→
   402→      // Dialog should close
   403→      await expect(page.getByTestId('agent-edit-dialog')).toHaveCount(0);
   404→
   405→      // Card name should still be original
   406→      const card = page.getByTestId('agent-card-task-worker');
   407→      await expect(card.getByTestId('agent-name')).toContainText('Task Worker');
   408→    });
   409→
   410→    // AC: @ui-agent-dispatch ac-4
   411→    test('save persists changes via PATCH API and updates card', async ({ page, daemon }) => {
   412→      await page.goto('/agents');
   413→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
   414→
   415→      await page.getByTestId('agent-edit-button-task-worker').click();
   416→      await expect(page.getByTestId('agent-edit-dialog')).toBeVisible();
   417→
   418→      // Modify description
   419→      const descInput = page.getByTestId('agent-edit-description');
   420→      await descInput.fill('Updated description via E2E test');
   421→
   422→      // Save
   423→      await page.getByTestId('agent-edit-save').click();
   424→
   425→      // Dialog should close
   426→      await expect(page.getByTestId('agent-edit-dialog')).toHaveCount(0);
   427→
   428→      // Verify the update persisted by reloading
   429→      await page.reload();
   430→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
   431→
   432→      const card = page.getByTestId('agent-card-task-worker');
   433→      await expect(card).toContainText('Updated description via E2E test');
   434→    });
   435→
   436→    // AC: @ui-agent-dispatch ac-4
   437→    test('edit form shows error on save failure', async ({ page, daemon }) => {
   438→      await page.goto('/agents');
   439→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
   440→
   441→      await page.getByTestId('agent-edit-button-task-worker').click();
   442→      await expect(page.getByTestId('agent-edit-dialog')).toBeVisible();
   443→
   444→      // Intercept PATCH to simulate failure
   445→      await page.route('**/api/meta/agents/task-worker', (route) => {
   446→        if (route.request().method() === 'PATCH') {
   447→          route.fulfill({
   448→            status: 500,
   449→            contentType: 'application/json',
   450→            body: JSON.stringify({ error: 'internal_error', message: 'Save failed' }),
   451→          });
   452→        } else {
   453→          route.continue();
   454→        }
   455→      });
   456→
   457→      // Save
   458→      await page.getByTestId('agent-edit-save').click();
   459→
   460→      // Error should be displayed
   461→      const errorMsg = page.getByTestId('agent-edit-error');
   462→      await expect(errorMsg).toBeVisible();
   463→      await expect(errorMsg).toContainText('Save failed');
   464→    });
   465→
   466→    // AC: @ui-agent-dispatch ac-4
   467→    test('trigger management: add and remove triggers', async ({ page, daemon }) => {
   468→      await page.goto('/agents');
   469→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
   470→
   471→      await page.getByTestId('agent-edit-button-task-worker').click();
   472→      await expect(page.getByTestId('agent-edit-dialog')).toBeVisible();
   473→
   474→      // Remove a trigger (needs_work)
   475→      const removeButton = page.getByTestId('remove-trigger-task.needs_work');
   476→      await expect(removeButton).toBeVisible();
   477→      await removeButton.click();
   478→
   479→      // Add pending_review trigger
   480→      const addButton = page.getByTestId('add-trigger-task.pending_review');
   481→      await expect(addButton).toBeVisible();
   482→      await addButton.click();
   483→
   484→      // needs_work should now be available to add
   485→      await expect(page.getByTestId('add-trigger-task.needs_work')).toBeVisible();
   486→    });
   487→  });
   488→});
