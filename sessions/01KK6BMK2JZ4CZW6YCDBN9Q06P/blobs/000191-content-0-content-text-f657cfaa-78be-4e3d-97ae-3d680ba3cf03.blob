   289→  test.describe('Accessibility', () => {
   290→    test('has aria-live region for invocation announcements', async ({ page, daemon }) => {
   291→      await page.goto('/agents');
   292→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
   293→
   294→      // The live region should exist for screen reader announcements
   295→      const liveRegion = page.getByTestId('invocation-live-region');
   296→      await expect(liveRegion).toBeAttached();
   297→      await expect(liveRegion).toHaveAttribute('aria-live', 'assertive');
   298→    });
   299→
   300→    test('active invocations section has aria-live attribute', async ({ page, daemon, request }) => {
   301→      // Start dispatch to make the section appear
