   122→  test.describe('Dispatch Running State (AC-2)', () => {
   123→    // AC: @ui-agent-dispatch ac-2
   124→    test('shows dispatch as running after start', async ({ page, daemon, request }) => {
   125→      // Start dispatch via API
   126→      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
   127→        data: { action: 'start' },
   128→        headers: { 'Content-Type': 'application/json' },
   129→      });
   130→
   131→      await page.goto('/agents');
   132→
   133→      const badge = page.getByTestId('dispatch-status-badge');
   134→      await expect(badge).toContainText('Running');
   135→
   136→      const indicator = page.getByTestId('dispatch-indicator-running');
   137→      await expect(indicator).toBeVisible();
   138→
   139→      // Clean up
   140→      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
   141→        data: { action: 'stop' },
   142→        headers: { 'Content-Type': 'application/json' },
   143→      });
   144→    });
   145→
   146→    // AC: @ui-agent-dispatch ac-2
   147→    test('shows stop button when dispatch is running', async ({ page, daemon, request }) => {
   148→      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
   149→        data: { action: 'start' },
   150→        headers: { 'Content-Type': 'application/json' },
   151→      });
   152→
   153→      await page.goto('/agents');
   154→
   155→      const toggleButton = page.getByTestId('dispatch-toggle-button');
   156→      await expect(toggleButton).toBeVisible();
   157→      await expect(toggleButton).toContainText('Stop');
   158→
   159→      // Clean up
   160→      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
   161→        data: { action: 'stop' },
   162→        headers: { 'Content-Type': 'application/json' },
   163→      });
   164→    });
   165→
   166→    // AC: @ui-agent-dispatch ac-2
   167→    test('clicking stop button stops dispatch', async ({ page, daemon, request }) => {
   168→      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
   169→        data: { action: 'start' },
   170→        headers: { 'Content-Type': 'application/json' },
   171→      });
   172→
   173→      await page.goto('/agents');
   174→
   175→      // Click stop
   176→      const toggleButton = page.getByTestId('dispatch-toggle-button');
   177→      await toggleButton.click();
   178→
   179→      // Wait for status to update
   180→      const badge = page.getByTestId('dispatch-status-badge');
   181→      await expect(badge).toContainText('Stopped');
   182→    });
   183→
   184→    // AC: @ui-agent-dispatch ac-2
   185→    test('clicking start button starts dispatch', async ({ page, daemon }) => {
   186→      await page.goto('/agents');
   187→
   188→      const toggleButton = page.getByTestId('dispatch-toggle-button');
   189→      await expect(toggleButton).toContainText('Start');
   190→
   191→      await toggleButton.click();
   192→
   193→      // Wait for status to update
   194→      const badge = page.getByTestId('dispatch-status-badge');
   195→      await expect(badge).toContainText('Running');
   196→
   197→      // Clean up - stop dispatch
   198→      await toggleButton.click();
   199→      await expect(badge).toContainText('Stopped');
   200→    });
   201→  });
   202→
   203→  test.describe('Loading and Error States', () => {
   204→    test('shows loading skeleton initially', async ({ page, daemon }) => {
   205→      // Delay API responses so the skeleton is reliably visible
   206→      await page.route('**/api/agent/status', async (route) => {
   207→        await new Promise((r) => setTimeout(r, 500));
   208→        await route.continue();
   209→      });
   210→      await page.route('**/api/meta/agents', async (route) => {
   211→        await new Promise((r) => setTimeout(r, 500));
   212→        await route.continue();
   213→      });
   214→
   215→      await page.goto('/agents');
   216→
   217→      // Skeleton should be visible while API calls are delayed
   218→      const skeleton = page.getByTestId('agents-loading');
   219→      await expect(skeleton).toBeVisible();
   220→
   221→      // Eventually loading finishes and content appears
   222→      await expect(page.getByTestId('dispatch-section')).toBeVisible({ timeout: 5000 });
   223→    });
   224→
   225→    test('error message displays on API failure', async ({ page, daemon }) => {
   226→      // Intercept API calls and return errors
   227→      await page.route('**/api/agent/status', (route) => {
   228→        route.fulfill({
   229→          status: 500,
   230→          contentType: 'application/json',
   231→          body: JSON.stringify({ error: 'internal_error', message: 'Daemon unavailable' }),
   232→        });
   233→      });
   234→      await page.route('**/api/meta/agents', (route) => {
   235→        route.fulfill({
   236→          status: 500,
   237→          contentType: 'application/json',
   238→          body: JSON.stringify({ error: 'internal_error', message: 'Daemon unavailable' }),
   239→        });
   240→      });
   241→
   242→      await page.goto('/agents');
   243→
   244→      // Error message should be displayed with API error message
   245→      const errorMessage = page.getByTestId('error-message');
   246→      await expect(errorMessage).toBeVisible();
   247→      await expect(errorMessage).toContainText('Daemon unavailable');
   248→    });
   249→  });
   250→
   251→  test.describe('Empty State', () => {
   252→    test('shows agent definitions section', async ({ page, daemon }) => {
   253→      await page.goto('/agents');
   254→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
   255→
   256→      const section = page.getByTestId('agent-definitions-section');
