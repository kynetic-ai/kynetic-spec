   333→  test.describe('Agent Editing (AC-4)', () => {
   334→    // AC: @ui-agent-dispatch ac-4
   335→    test('edit button opens dialog with agent fields pre-populated', async ({ page, daemon }) => {
   336→      await page.goto('/agents');
   337→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
   338→
   339→      // Click edit on task-worker agent
   340→      const editButton = page.getByTestId('agent-edit-button-task-worker');
   341→      await expect(editButton).toBeVisible();
   342→      await editButton.click();
   343→
   344→      // Dialog should open
   345→      const dialog = page.getByTestId('agent-edit-dialog');
   346→      await expect(dialog).toBeVisible();
   347→
   348→      // Title should show the agent id
   349→      const title = page.getByTestId('agent-edit-title');
   350→      await expect(title).toContainText('task-worker');
   351→
   352→      // Name field should be pre-populated
   353→      const nameInput = page.getByTestId('agent-edit-name');
   354→      await expect(nameInput).toHaveValue('Task Worker');
   355→    });
   356→
   357→    // AC: @ui-agent-dispatch ac-4
   358→    test('edit dialog shows dispatch triggers with add/remove', async ({ page, daemon }) => {
   359→      await page.goto('/agents');
   360→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
   361→
   362→      await page.getByTestId('agent-edit-button-task-worker').click();
   363→      await expect(page.getByTestId('agent-edit-dialog')).toBeVisible();
   364→
   365→      // Should show existing triggers
   366→      const triggers = page.getByTestId('agent-edit-triggers');
   367→      await expect(triggers).toBeVisible();
   368→
   369→      // task-worker has 3 triggers: ready, in_progress, needs_work
   370→      // So pending_review should be available to add
   371→      const addPendingReview = page.getByTestId('add-trigger-task.pending_review');
   372→      await expect(addPendingReview).toBeVisible();
   373→    });
   374→
   375→    // AC: @ui-agent-dispatch ac-4
   376→    test('edit dialog shows prompt template textarea', async ({ page, daemon }) => {
   377→      await page.goto('/agents');
   378→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
   379→
   380→      await page.getByTestId('agent-edit-button-task-worker').click();
   381→      await expect(page.getByTestId('agent-edit-dialog')).toBeVisible();
   382→
   383→      const promptTemplate = page.getByTestId('agent-edit-prompt-template');
   384→      await expect(promptTemplate).toBeVisible();
