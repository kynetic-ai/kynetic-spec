   259→
   260→    // AC: @ui-agent-dispatch ac-2 — Empty state for active invocations when dispatch is running
   261→    test('shows actionable empty state when dispatch is running with no active invocations', async ({ page, daemon, request }) => {
   262→      // Start dispatch so it's enabled
   263→      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
   264→        data: { action: 'start' },
   265→        headers: { 'Content-Type': 'application/json' },
   266→      });
   267→
   268→      await page.goto('/agents');
   269→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
   270→
   271→      // Active invocations section should be visible (dispatch is running)
   272→      const invocationsSection = page.getByTestId('active-invocations-section');
   273→      await expect(invocationsSection).toBeVisible();
   274→
   275→      // Empty state should be shown with actionable guidance
   276→      const emptyState = page.getByTestId('active-invocations-empty');
   277→      await expect(emptyState).toBeVisible();
   278→      await expect(emptyState).toContainText('No active invocations');
   279→      await expect(emptyState).toContainText('kspec tasks ready --eligible');
   280→
   281→      // Clean up
   282→      await request.post(`${DAEMON_URL}/api/agent/dispatch`, {
   283→        data: { action: 'stop' },
   284→        headers: { 'Content-Type': 'application/json' },
   285→      });
   286→    });
   287→  });
