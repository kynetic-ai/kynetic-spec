```
     1→/**
     2→ * E2E Tests for Agent and Dispatch View
     3→ *
     4→ * Tests verify the /agents page renders agent definitions, dispatch status,
     5→ * and active invocations correctly.
     6→ *
     7→ * Covered ACs:
     8→ * - @ui-agent-dispatch ac-1: Agent definitions show name, triggers, active/completed counts
     9→ * - @ui-agent-dispatch ac-2: Dispatch running with stop button and active invocations
    10→ * - @ui-agent-dispatch ac-3: Dispatch stopped with no active invocations
    11→ * - @ui-agent-dispatch ac-4: Agent editing with inline edit form
    12→ */
    13→
    14→import { test, expect } from '../fixtures/test-base';
    15→
    16→const DAEMON_URL = 'http://localhost:3456';
    17→
    18→test.describe('Agent and Dispatch View', () => {
    19→  test.describe('Dispatch Stopped State (AC-3)', () => {
    20→    // AC: @ui-agent-dispatch ac-3
    21→    test('shows dispatch status as stopped initially', async ({ page, daemon }) => {
    22→      await page.goto('/agents');
    23→
    24→      const dispatchStatus = page.getByTestId('dispatch-status');
    25→      await expect(dispatchStatus).toBeVisible();
    26→
    27→      const badge = page.getByTestId('dispatch-status-badge');
    28→      await expect(badge).toContainText('Stopped');
    29→    });
    30→
    31→    // AC: @ui-agent-dispatch ac-3
    32→    test('shows stopped indicator when dispatch is not running', async ({ page, daemon }) => {
    33→      await page.goto('/agents');
    34→
    35→      const indicator = page.getByTestId('dispatch-indicator-stopped');
    36→      await expect(indicator).toBeVisible();
    37→    });
    38→
    39→    // AC: @ui-agent-dispatch ac-3
    40→    test('shows no active invocations when dispatch is stopped', async ({ page, daemon }) => {
    41→      await page.goto('/agents');
    42→
    43→      const invocationsSection = page.getByTestId('active-invocations-section');
    44→      await expect(invocationsSection).toHaveCount(0);
    45→    });
    46→  });
    47→
    48→  test.describe('Agent Definitions (AC-1)', () => {
    49→    // AC: @ui-agent-dispatch ac-1
    50→    test('renders agent cards from meta definitions', async ({ page, daemon }) => {
    51→      await page.goto('/agents');
    52→
    53→      // Wait for loading to finish
    54→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
    55→
    56→      const section = page.getByTestId('agent-definitions-section');
    57→      await expect(section).toBeVisible();
    58→
    59→      // Fixture has 2 agents: task-worker and pr-reviewer
    60→      const taskWorkerCard = page.getByTestId('agent-card-task-worker');
    61→      await expect(taskWorkerCard).toBeVisible();
    62→
    63→      const prReviewerCard = page.getByTestId('agent-card-pr-reviewer');
    64→      await expect(prReviewerCard).toBeVisible();
    65→    });
    66→
    67→    // AC: @ui-agent-dispatch ac-1
    68→    test('agent card shows name', async ({ page, daemon }) => {
    69→      await page.goto('/agents');
    70→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
    71→
    72→      const card = page.getByTestId('agent-card-task-worker');
    73→      const name = card.getByTestId('agent-name');
    74→      await expect(name).toContainText('Task Worker');
    75→    });
    76→
    77→    // AC: @ui-agent-dispatch ac-1
    78→    test('agent card shows triggers', async ({ page, daemon }) => {
    79→      await page.goto('/agents');
    80→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
    81→
    82→      const card = page.getByTestId('agent-card-task-worker');
    83→      const triggers = card.getByTestId('agent-trigger');
    84→      // task-worker has 3 triggers: ready, in_progress, needs_work
    85→      await expect(triggers).toHaveCount(3);
    86→    });
    87→
    88→    // AC: @ui-agent-dispatch ac-1
    89→    test('agent card shows active invocation count', async ({ page, daemon }) => {
    90→      await page.goto('/agents');
    91→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
    92→
    93→      const card = page.getByTestId('agent-card-task-worker');
    94→      const activeCount = card.getByTestId('agent-active-count');
    95→      await expect(activeCount).toBeVisible();
    96→      await expect(activeCount).toContainText('0');
    97→    });
    98→
    99→    // AC: @ui-agent-dispatch ac-1
   100→    test('agent card shows completed count', async ({ page, daemon }) => {
   101→      await page.goto('/agents');
   102→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
   103→
   104→      const card = page.getByTestId('agent-card-task-worker');
   105→      const completedCount = card.getByTestId('agent-completed-count');
   106→      await expect(completedCount).toBeVisible();
   107→      await expect(completedCount).toContainText('0');
   108→    });
   109→
   110→    // AC: @ui-agent-dispatch ac-1
   111→    test('pr-reviewer agent shows pending_review trigger', async ({ page, daemon }) => {
   112→      await page.goto('/agents');
   113→      await expect(page.getByTestId('agents-loading')).toHaveCount(0);
   114→
   115→      const card = page.getByTestId('agent-card-pr-reviewer');
   116→      const triggers = card.getByTestId('agent-trigger');
