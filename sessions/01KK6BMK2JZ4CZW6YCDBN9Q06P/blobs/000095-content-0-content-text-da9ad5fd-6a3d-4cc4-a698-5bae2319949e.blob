```
     1→<!--
     2→  AC: @ui-agent-dispatch ac-4 — Inline edit form for agent definitions.
     3→  AC: @ui-agent-dispatch ac-5, ac-6, ac-7, ac-8, ac-9 — Dispatch filter editing per trigger row.
     4→  Schema-driven: types (AgentDefinition, AgentUpdatePayload, AgentDispatchRule) and
     5→  dispatch event values (AGENT_DISPATCH_EVENTS) from @kynetic-ai/shared, which mirrors
     6→  AgentSchema / AgentDispatchEventSchema from src/schema/meta.ts.
     7→-->
     8→<script lang="ts">
     9→	import { updateAgentDefinition } from '$lib/api';
    10→	import {
    11→		AGENT_DISPATCH_EVENTS,
    12→		type AgentDefinition,
    13→		type AgentUpdatePayload,
    14→		type AgentDispatchEvent,
    15→		type AgentDispatchRule,
    16→		type AgentDispatchFilter
    17→	} from '@kynetic-ai/shared';
    18→	import { ReadOnlyModeError } from '$lib/stores/mode.svelte';
    19→	import * as Dialog from '$lib/components/ui/dialog';
    20→	import { Button } from '$lib/components/ui/button';
    21→	import { Input } from '$lib/components/ui/input';
    22→	import { Textarea } from '$lib/components/ui/textarea';
    23→	import { Badge } from '$lib/components/ui/badge';
    24→	import { Separator } from '$lib/components/ui/separator';
    25→	import {
    26→		Select,
    27→		SelectContent,
    28→		SelectItem,
    29→		SelectTrigger
    30→	} from '$lib/components/ui/select';
    31→	import X from '@lucide/svelte/icons/x';
    32→	import Plus from '@lucide/svelte/icons/plus';
    33→	import Filter from '@lucide/svelte/icons/filter';
    34→
    35→	let {
    36→		open = $bindable(false),
    37→		agent,
    38→		onSaved
    39→	}: {
    40→		open?: boolean;
    41→		agent: AgentDefinition;
    42→		onSaved?: (updated: AgentDefinition) => void;
    43→	} = $props();
    44→
    45→	// Form state derived from agent prop — reset when dialog opens
    46→	// Field structure mirrors AgentDefinition from @kynetic-ai/shared (schema-driven)
    47→	let name = $state('');
    48→	let description = $state('');
    49→	let adapter = $state('');
    50→	let dispatchTriggers = $state<AgentDispatchRule[]>([]);
    51→	let capabilities = $state<string[]>([]);
    52→	let tools = $state<string[]>([]);
    53→	let skills = $state<string[]>([]);
    54→	let maxTasks = $state<number | undefined>(undefined);
    55→	let maxRetries = $state<number | undefined>(undefined);
    56→	let timeoutMinutes = $state<number | undefined>(undefined);
    57→	let maxConcurrent = $state(1);
    58→	let autoApprove = $state(false);
    59→	let promptTemplate = $state('');
    60→
    61→	// UI state
    62→	let saving = $state(false);
    63→	let error = $state('');
    64→
    65→	// Chip input buffers
    66→	let newCapability = $state('');
    67→	let newTool = $state('');
    68→	let newSkill = $state('');
    69→
    70→	// Tag input buffers per trigger
    71→	let triggerTagInputs = $state<Record<number, string>>({});
    72→
    73→	// Reset form state when dialog opens
    74→	$effect(() => {
    75→		if (open && agent) {
    76→			name = agent.name;
    77→			description = agent.description ?? '';
    78→			adapter = agent.adapter ?? '';
    79→			dispatchTriggers = agent.dispatch.map((d) => ({ ...d, filter: d.filter ? { ...d.filter } : undefined }));
    80→			capabilities = [...agent.capabilities];
    81→			tools = [...agent.tools];
    82→			skills = [...agent.skills];
    83→			maxTasks = agent.budget?.max_tasks;
    84→			maxRetries = agent.budget?.max_retries;
    85→			timeoutMinutes = agent.budget?.timeout_minutes;
    86→			maxConcurrent = agent.concurrency?.max_concurrent ?? 1;
    87→			autoApprove = agent.auto_approve;
    88→			promptTemplate = agent.prompt_template ?? '';
    89→			error = '';
    90→			newCapability = '';
    91→			newTool = '';
    92→			newSkill = '';
    93→			triggerTagInputs = {};
    94→		}
    95→	});
    96→
    97→	// Available dispatch events not yet selected
    98→	let availableEvents = $derived(
    99→		AGENT_DISPATCH_EVENTS.filter((e) => !dispatchTriggers.some((t) => t.on === e))
   100→	);
   101→
   102→	// AC: @ui-agent-dispatch ac-6 — default automation:eligible for task.ready/task.needs_work
   103→	function addTrigger(event: AgentDispatchEvent) {
   104→		const defaultsToEligible = event === 'task.ready' || event === 'task.needs_work';
   105→		const filter: AgentDispatchFilter | undefined = defaultsToEligible
   106→			? { automation: 'eligible' }
   107→			: undefined;
   108→		dispatchTriggers = [...dispatchTriggers, { on: event, filter }];
   109→	}
   110→
   111→	function removeTrigger(index: number) {
   112→		dispatchTriggers = dispatchTriggers.filter((_, i) => i !== index);
   113→	}
   114→
   115→	// AC: @ui-agent-dispatch ac-5 — update filter on a trigger
   116→	function updateTriggerFilter(index: number, updates: Partial<AgentDispatchFilter>) {
   117→		dispatchTriggers = dispatchTriggers.map((t, i) => {
   118→			if (i !== index) return t;
   119→			const currentFilter = t.filter ?? {};
   120→			const newFilter = { ...currentFilter, ...updates };
   121→			// Clean up undefined/empty values
   122→			if (newFilter.automation === undefined) delete newFilter.automation;
   123→			if (!newFilter.tags || newFilter.tags.length === 0) delete newFilter.tags;
   124→			if (newFilter.priority === undefined) delete newFilter.priority;
   125→			// If filter is empty, set to undefined
   126→			const hasFilter = Object.keys(newFilter).length > 0;
   127→			return { ...t, filter: hasFilter ? newFilter : undefined };
   128→		});
   129→	}
   130→
   131→	// AC: @ui-agent-dispatch ac-7 — add tag to a trigger's filter
   132→	function addFilterTag(index: number, tag: string) {
   133→		const trimmed = tag.trim();
   134→		if (!trimmed) return;
   135→		const currentTags = dispatchTriggers[index]?.filter?.tags ?? [];
   136→		if (currentTags.includes(trimmed)) return;
   137→		updateTriggerFilter(index, { tags: [...currentTags, trimmed] });
   138→	}
   139→
   140→	// AC: @ui-agent-dispatch ac-7 — remove tag from a trigger's filter
   141→	function removeFilterTag(index: number, tagIndex: number) {
   142→		const currentTags = dispatchTriggers[index]?.filter?.tags ?? [];
   143→		const newTags = currentTags.filter((_, i) => i !== tagIndex);
   144→		updateTriggerFilter(index, { tags: newTags.length > 0 ? newTags : undefined });
   145→	}
   146→
   147→	function addChip(list: string[], value: string, setter: (v: string[]) => void, clearInput: () => void) {
   148→		const trimmed = value.trim();
   149→		if (trimmed && !list.includes(trimmed)) {
   150→			setter([...list, trimmed]);
   151→			clearInput();
   152→		}
   153→	}
   154→
   155→	function removeChip(list: string[], index: number, setter: (v: string[]) => void) {
   156→		setter(list.filter((_, i) => i !== index));
   157→	}
   158→
   159→	async function handleSave() {
   160→		saving = true;
   161→		error = '';
   162→
   163→		const payload: AgentUpdatePayload = {
   164→			name,
   165→			description: description || undefined,
   166→			adapter: adapter || undefined,
   167→			dispatch: dispatchTriggers,
   168→			capabilities,
   169→			tools,
   170→			skills,
   171→			budget: (maxTasks !== undefined || maxRetries !== undefined || timeoutMinutes !== undefined)
   172→				? { max_tasks: maxTasks, max_retries: maxRetries, timeout_minutes: timeoutMinutes }
   173→				: undefined,
   174→			concurrency: { max_concurrent: maxConcurrent },
   175→			auto_approve: autoApprove,
   176→			prompt_template: promptTemplate || undefined
   177→		};
   178→
   179→		try {
   180→			const updated = await updateAgentDefinition(agent.id, payload);
   181→			onSaved?.(updated);
   182→			open = false;
   183→		} catch (err) {
   184→			if (err instanceof ReadOnlyModeError) {
   185→				error = err.message;
   186→			} else {
   187→				error = err instanceof Error ? err.message : 'Failed to save agent';
   188→			}
   189→		} finally {
   190→			saving = false;
   191→		}
   192→	}
   193→
   194→	function handleCancel() {
   195→		open = false;
   196→	}
   197→</script>
   198→
   199→<Dialog.Root bind:open>
   200→	<Dialog.Content class="max-w-2xl max-h-[85vh] overflow-y-auto" data-testid="agent-edit-dialog">
   201→		<Dialog.Header>
   202→			<Dialog.Title data-testid="agent-edit-title">Edit Agent: {agent.id}</Dialog.Title>
   203→			<Dialog.Description>
   204→				Modify agent definition fields. Changes are persisted to kynetic.meta.yaml.
   205→			</Dialog.Description>
   206→		</Dialog.Header>
   207→
   208→		{#if error}
   209→			<div
   210→				class="bg-destructive/10 text-destructive p-3 rounded-lg text-sm"
   211→				data-testid="agent-edit-error"
   212→				role="alert"
   213→			>
   214→				{error}
   215→			</div>
   216→		{/if}
   217→
   218→		<div class="flex flex-col gap-4">
   219→			<!-- Name -->
   220→			<div>
   221→				<label for="agent-name" class="text-sm font-medium">Name</label>
   222→				<Input
   223→					id="agent-name"
   224→					bind:value={name}
   225→					placeholder="Agent name"
   226→					data-testid="agent-edit-name"
   227→				/>
   228→			</div>
   229→
   230→			<!-- Description -->
   231→			<div>
   232→				<label for="agent-description" class="text-sm font-medium">Description</label>
   233→				<Textarea
   234→					id="agent-description"
   235→					bind:value={description}
   236→					placeholder="Agent description"
   237→					rows={2}
   238→					data-testid="agent-edit-description"
   239→				/>
   240→			</div>
   241→
   242→			<!-- Adapter -->
   243→			<div>
   244→				<label for="agent-adapter" class="text-sm font-medium">Adapter</label>
   245→				<Input
   246→					id="agent-adapter"
   247→					bind:value={adapter}
   248→					placeholder="e.g. claude-code"
   249→					data-testid="agent-edit-adapter"
   250→				/>
   251→			</div>
   252→
   253→			<Separator />
   254→
   255→			<!-- Dispatch Triggers (schema-driven from AGENT_DISPATCH_EVENTS) -->
   256→			<!-- AC: @ui-agent-dispatch ac-5 — each trigger row shows filter criteria with inline editing -->
   257→			<div>
   258→				<p class="text-sm font-medium mb-2">Dispatch Triggers</p>
   259→				<div class="flex flex-col gap-3 mb-2" data-testid="agent-edit-triggers">
   260→					{#each dispatchTriggers as trigger, i}
   261→						<div class="border rounded-lg p-3 bg-muted/30" data-testid="trigger-row-{trigger.on}">
   262→							<!-- Trigger header: event name + remove button -->
   263→							<div class="flex items-center justify-between mb-2">
   264→								<Badge variant="secondary" class="gap-1">
   265→									{trigger.on}
   266→								</Badge>
   267→								<button
   268→									type="button"
   269→									class="rounded-full p-1 hover:bg-muted-foreground/20"
   270→									onclick={() => removeTrigger(i)}
   271→									aria-label="Remove trigger {trigger.on}"
   272→									data-testid="remove-trigger-{trigger.on}"
   273→								>
   274→									<X class="h-3.5 w-3.5" />
   275→								</button>
   276→							</div>
   277→
   278→							<!-- Filter controls -->
   279→							<div class="flex flex-col gap-2">
   280→								<!-- AC: @ui-agent-dispatch ac-5, ac-6 — automation filter dropdown -->
   281→								<div class="flex items-center gap-2">
   282→									<label class="text-xs text-muted-foreground w-20 shrink-0">
   283→										<Filter class="h-3 w-3 inline-block mr-1" />Automation
   284→									</label>
   285→									<Select
   286→										value={trigger.filter?.automation ?? 'any'}
   287→										onValueChange={(v) => {
   288→											const val = Array.isArray(v) ? v[v.length - 1] : v;
   289→											updateTriggerFilter(i, {
   290→												automation: val === 'any' ? undefined : val as 'eligible' | 'ineligible'
   291→											});
   292→										}}
   293→									>
   294→										<SelectTrigger
   295→											class="h-7 text-xs flex-1"
   296→											data-testid="trigger-automation-{trigger.on}"
   297→										>
   298→											{#if trigger.filter?.automation}
   299→												<Badge variant="outline" class="text-xs">{trigger.filter.automation}</Badge>
   300→											{:else}
   301→												<span class="text-muted-foreground">any</span>
   302→											{/if}
   303→										</SelectTrigger>
   304→										<SelectContent>
   305→											<SelectItem value="any">Any</SelectItem>
   306→											<SelectItem value="eligible">Eligible</SelectItem>
   307→											<SelectItem value="ineligible">Ineligible</SelectItem>
   308→										</SelectContent>
   309→									</Select>
   310→								</div>
   311→
   312→								<!-- AC: @ui-agent-dispatch ac-7 — tag filter with removable chips -->
   313→								<div class="flex items-start gap-2">
   314→									<label class="text-xs text-muted-foreground w-20 shrink-0 mt-1.5">Tags</label>
   315→									<div class="flex-1">
   316→										<div class="flex flex-wrap gap-1 mb-1" data-testid="trigger-tags-{trigger.on}">
   317→											{#each trigger.filter?.tags ?? [] as tag, tagIdx}
   318→												<Badge variant="outline" class="text-xs gap-0.5 pr-0.5">
   319→													{tag}
   320→													<button
   321→														type="button"
   322→														class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   323→														onclick={() => removeFilterTag(i, tagIdx)}
   324→														aria-label="Remove tag {tag}"
   325→														data-testid="remove-filter-tag-{tag}"
   326→													>
   327→														<X class="h-2.5 w-2.5" />
   328→													</button>
   329→												</Badge>
   330→											{/each}
   331→										</div>
   332→										<div class="flex gap-1">
   333→											<Input
   334→												class="h-7 text-xs flex-1"
   335→												placeholder="Add tag..."
   336→												value={triggerTagInputs[i] ?? ''}
   337→												oninput={(e: Event) => {
   338→													triggerTagInputs[i] = (e.target as HTMLInputElement).value;
   339→												}}
   340→												onkeydown={(e: KeyboardEvent) => {
   341→													if (e.key === 'Enter') {
   342→														e.preventDefault();
   343→														addFilterTag(i, triggerTagInputs[i] ?? '');
   344→														triggerTagInputs[i] = '';
   345→													}
   346→												}}
   347→												data-testid="trigger-tag-input-{trigger.on}"
   348→											/>
   349→											<Button
   350→												size="sm"
   351→												variant="outline"
   352→												class="h-7 text-xs px-2"
   353→												onclick={() => {
   354→													addFilterTag(i, triggerTagInputs[i] ?? '');
   355→													triggerTagInputs[i] = '';
   356→												}}
   357→											>
   358→												<Plus class="h-3 w-3" />
   359→											</Button>
   360→										</div>
   361→									</div>
   362→								</div>
   363→
   364→								<!-- AC: @ui-agent-dispatch ac-8 — priority filter threshold -->
   365→								<div class="flex items-center gap-2">
   366→									<label class="text-xs text-muted-foreground w-20 shrink-0">Priority &#x2264;</label>
   367→									<Input
   368→										class="h-7 text-xs flex-1"
   369→										type="number"
   370→										min={0}
   371→										placeholder="any"
   372→										value={trigger.filter?.priority ?? ''}
   373→										oninput={(e: Event) => {
   374→											const v = (e.target as HTMLInputElement).valueAsNumber;
   375→											updateTriggerFilter(i, {
   376→												priority: Number.isNaN(v) ? undefined : v
   377→											});
   378→										}}
   379→										data-testid="trigger-priority-{trigger.on}"
   380→									/>
   381→								</div>
   382→							</div>
   383→						</div>
   384→					{/each}
   385→				</div>
   386→				{#if availableEvents.length > 0}
   387→					<div class="flex flex-wrap gap-1.5" data-testid="agent-edit-available-triggers">
   388→						{#each availableEvents as event}
   389→							<Button
   390→								size="sm"
   391→								variant="outline"
   392→								class="text-xs gap-1"
   393→								onclick={() => addTrigger(event)}
   394→								data-testid="add-trigger-{event}"
   395→							>
   396→								<Plus class="h-3 w-3" />
   397→								{event}
   398→							</Button>
   399→						{/each}
   400→					</div>
   401→				{/if}
   402→			</div>
   403→
   404→			<Separator />
   405→
   406→			<!-- Capabilities (chip input) -->
   407→			<div>
   408→				<p class="text-sm font-medium mb-1">Capabilities</p>
   409→				<div class="flex flex-wrap gap-1 mb-2" data-testid="agent-edit-capabilities">
   410→					{#each capabilities as cap, i}
   411→						<Badge variant="outline" class="gap-1 pr-1">
   412→							{cap}
   413→							<button
   414→								type="button"
   415→								class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   416→								onclick={() => removeChip(capabilities, i, (v) => (capabilities = v))}
   417→								aria-label="Remove capability {cap}"
   418→							>
   419→								<X class="h-3 w-3" />
   420→							</button>
   421→						</Badge>
   422→					{/each}
   423→				</div>
   424→				<div class="flex gap-2">
   425→					<Input
   426→						bind:value={newCapability}
   427→						placeholder="Add capability..."
   428→						class="flex-1"
   429→						onkeydown={(e: KeyboardEvent) => {
   430→							if (e.key === 'Enter') {
   431→								e.preventDefault();
   432→								addChip(capabilities, newCapability, (v) => (capabilities = v), () => (newCapability = ''));
   433→							}
   434→						}}
   435→						data-testid="agent-edit-capability-input"
   436→					/>
   437→					<Button
   438→						size="sm"
   439→						variant="outline"
   440→						onclick={() => addChip(capabilities, newCapability, (v) => (capabilities = v), () => (newCapability = ''))}
   441→					>
   442→						Add
   443→					</Button>
   444→				</div>
   445→			</div>
   446→
   447→			<!-- Tools (chip input) -->
   448→			<div>
   449→				<p class="text-sm font-medium mb-1">Tools</p>
   450→				<div class="flex flex-wrap gap-1 mb-2" data-testid="agent-edit-tools">
   451→					{#each tools as tool, i}
   452→						<Badge variant="outline" class="gap-1 pr-1">
   453→							{tool}
   454→							<button
   455→								type="button"
   456→								class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   457→								onclick={() => removeChip(tools, i, (v) => (tools = v))}
   458→								aria-label="Remove tool {tool}"
   459→							>
   460→								<X class="h-3 w-3" />
   461→							</button>
   462→						</Badge>
   463→					{/each}
   464→				</div>
   465→				<div class="flex gap-2">
   466→					<Input
   467→						bind:value={newTool}
   468→						placeholder="Add tool..."
   469→						class="flex-1"
   470→						onkeydown={(e: KeyboardEvent) => {
   471→							if (e.key === 'Enter') {
   472→								e.preventDefault();
   473→								addChip(tools, newTool, (v) => (tools = v), () => (newTool = ''));
   474→							}
   475→						}}
   476→						data-testid="agent-edit-tool-input"
   477→					/>
   478→					<Button
   479→						size="sm"
   480→						variant="outline"
   481→						onclick={() => addChip(tools, newTool, (v) => (tools = v), () => (newTool = ''))}
   482→					>
   483→						Add
   484→					</Button>
   485→				</div>
   486→			</div>
   487→
   488→			<!-- Skills (chip input) -->
   489→			<div>
   490→				<p class="text-sm font-medium mb-1">Skills</p>
   491→				<div class="flex flex-wrap gap-1 mb-2" data-testid="agent-edit-skills">
   492→					{#each skills as skill, i}
   493→						<Badge variant="outline" class="gap-1 pr-1">
   494→							{skill}
   495→							<button
   496→								type="button"
   497→								class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   498→								onclick={() => removeChip(skills, i, (v) => (skills = v))}
   499→								aria-label="Remove skill {skill}"
   500→							>
   501→								<X class="h-3 w-3" />
   502→							</button>
   503→						</Badge>
   504→					{/each}
   505→				</div>
   506→				<div class="flex gap-2">
   507→					<Input
   508→						bind:value={newSkill}
   509→						placeholder="Add skill..."
   510→						class="flex-1"
   511→						onkeydown={(e: KeyboardEvent) => {
   512→							if (e.key === 'Enter') {
   513→								e.preventDefault();
   514→								addChip(skills, newSkill, (v) => (skills = v), () => (newSkill = ''));
   515→							}
   516→						}}
   517→						data-testid="agent-edit-skill-input"
   518→					/>
   519→					<Button
   520→						size="sm"
   521→						variant="outline"
   522→						onclick={() => addChip(skills, newSkill, (v) => (skills = v), () => (newSkill = ''))}
   523→					>
   524→						Add
   525→					</Button>
   526→				</div>
   527→			</div>
   528→
   529→			<Separator />
   530→
   531→			<!-- Budget -->
   532→			<div>
   533→				<p class="text-sm font-medium mb-2">Budget</p>
   534→				<div class="grid grid-cols-3 gap-3">
   535→					<div>
   536→						<label for="agent-max-tasks" class="text-xs text-muted-foreground">Max Tasks</label>
   537→						<Input
   538→							id="agent-max-tasks"
   539→							type="number"
   540→							min={1}
   541→							value={maxTasks ?? ''}
   542→							oninput={(e: Event) => {
   543→								const v = (e.target as HTMLInputElement).valueAsNumber;
   544→								maxTasks = Number.isNaN(v) ? undefined : v;
   545→							}}
   546→							placeholder="—"
   547→							data-testid="agent-edit-max-tasks"
   548→						/>
   549→					</div>
   550→					<div>
   551→						<label for="agent-max-retries" class="text-xs text-muted-foreground">Max Retries</label>
   552→						<Input
   553→							id="agent-max-retries"
   554→							type="number"
   555→							min={0}
   556→							value={maxRetries ?? ''}
   557→							oninput={(e: Event) => {
   558→								const v = (e.target as HTMLInputElement).valueAsNumber;
   559→								maxRetries = Number.isNaN(v) ? undefined : v;
   560→							}}
   561→							placeholder="—"
   562→							data-testid="agent-edit-max-retries"
   563→						/>
   564→					</div>
   565→					<div>
   566→						<label for="agent-timeout" class="text-xs text-muted-foreground">Timeout (min)</label>
   567→						<Input
   568→							id="agent-timeout"
   569→							type="number"
   570→							min={1}
   571→							value={timeoutMinutes ?? ''}
   572→							oninput={(e: Event) => {
   573→								const v = (e.target as HTMLInputElement).valueAsNumber;
   574→								timeoutMinutes = Number.isNaN(v) ? undefined : v;
   575→							}}
   576→							placeholder="—"
   577→							data-testid="agent-edit-timeout"
   578→						/>
   579→					</div>
   580→				</div>
   581→			</div>
   582→
   583→			<!-- Concurrency -->
   584→			<div>
   585→				<label for="agent-concurrency" class="text-sm font-medium">Max Concurrent</label>
   586→				<Input
   587→					id="agent-concurrency"
   588→					type="number"
   589→					min={1}
   590→					bind:value={maxConcurrent}
   591→					data-testid="agent-edit-concurrency"
   592→				/>
   593→			</div>
   594→
   595→			<!-- Auto Approve -->
   596→			<div class="flex items-center gap-3">
   597→				<input
   598→					id="agent-auto-approve"
   599→					type="checkbox"
   600→					bind:checked={autoApprove}
   601→					class="h-4 w-4 rounded border-input"
   602→					data-testid="agent-edit-auto-approve"
   603→				/>
   604→				<label for="agent-auto-approve" class="text-sm font-medium">Auto Approve</label>
   605→			</div>
   606→
   607→			<Separator />
   608→
   609→			<!-- Prompt Template -->
   610→			<div>
   611→				<label for="agent-prompt-template" class="text-sm font-medium">Prompt Template</label>
   612→				<Textarea
   613→					id="agent-prompt-template"
   614→					bind:value={promptTemplate}
   615→					placeholder="Agent prompt template..."
   616→					rows={4}
   617→					class="font-mono text-xs"
   618→					data-testid="agent-edit-prompt-template"
   619→				/>
   620→			</div>
   621→		</div>
   622→
   623→		<Dialog.Footer class="mt-4">
   624→			<Button
   625→				variant="ghost"
   626→				onclick={handleCancel}
   627→				disabled={saving}
   628→				data-testid="agent-edit-cancel"
   629→			>
   630→				Cancel
   631→			</Button>
   632→			<Button
   633→				onclick={handleSave}
   634→				disabled={saving || !name.trim()}
   635→				data-testid="agent-edit-save"
   636→			>
   637→				{saving ? 'Saving...' : 'Save'}
   638→			</Button>
   639→		</Dialog.Footer>
   640→	</Dialog.Content>
   641→</Dialog.Root>
   642→
```