     1→<script lang="ts">
     2→	// AC: @web-dashboard ac-4, ac-5, ac-9, ac-10, ac-33
     3→	// AC: @multi-directory-daemon ac-27 - Reload on project change
     4→	// AC: @gh-pages-export ac-16 - Disable Start Task in static mode
     5→	import { page } from '$app/stores';
     6→	import { base } from '$app/paths';
     7→	import { onMount, onDestroy, flushSync } from 'svelte';
     8→	import type { TaskSummary, TaskDetail, BroadcastEvent } from '@kynetic-ai/shared';
     9→	import TaskFilters from '$lib/components/TaskFilters.svelte';
    10→	import TaskList from '$lib/components/TaskList.svelte';
    11→	import { fetchTasks, fetchTask, startTask, addTaskNote } from '$lib/api';
    12→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    13→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    14→	import { Button } from '$lib/components/ui/button';
    15→	import { Badge } from '$lib/components/ui/badge';
    16→	import { Textarea } from '$lib/components/ui/textarea';
    17→	import { Separator } from '$lib/components/ui/separator';
    18→	import * as Tooltip from '$lib/components/ui/tooltip';
    19→	import XIcon from '@lucide/svelte/icons/x';
    20→	import { getProjectVersion } from '$lib/stores/project.svelte';
    21→
    22→	let tasks = $state<TaskSummary[]>([]);
    23→	let total = $state(0);
    24→	let loading = $state(true);
    25→	let error = $state('');
    26→	let updatedTaskIds = $state<Set<string>>(new Set());
    27→
    28→	// Use $state with an object for panel state to ensure deep reactivity
    29→	let panel = $state<{ open: boolean; task: TaskDetail | null }>({
    30→		open: false,
    31→		task: null
    32→	});
    33→
    34→	let noteContent = $state('');
    35→	let isSubmitting = $state(false);
    36→	let panelError = $state('');
    37→
    38→	// Reactive: re-fetch when URL params change
    39→	let filterParams = $derived({
    40→		status: $page.url.searchParams.get('status') || undefined,
    41→		type: $page.url.searchParams.get('type') || undefined,
    42→		tag: $page.url.searchParams.get('tag') || undefined,
    43→		assignee: $page.url.searchParams.get('assignee') || undefined,
    44→		automation: $page.url.searchParams.get('automation') || undefined,
    45→		limit: 50,
    46→		offset: 0
    47→	});
    48→
    49→	// Track the last processed ref to avoid infinite loops
    50→	let lastProcessedRef = $state('');
    51→
    52→	$effect(() => {
    53→		// Re-fetch when filterParams changes - explicitly access all properties for dependency tracking
    54→		const { status, type, tag, assignee, automation, limit, offset } = filterParams;
    55→		loadTasks();
    56→	});
    57→
    58→	// AC: @multi-directory-daemon ac-27 - Reload data when project changes
    59→	$effect(() => {
    60→		const version = getProjectVersion();
    61→		if (version > 0) {
    62→			// Only reload if version has been incremented (not on initial load)
    63→			loadTasks();
    64→		}
    65→	});
    66→
    67→	// AC: Open task detail when URL has ref param
    68→	$effect(() => {
    69→		const urlRef = $page.url.searchParams.get('ref');
    70→		if (urlRef && urlRef !== lastProcessedRef) {
    71→			lastProcessedRef = urlRef;
    72→			handleSelectTask(urlRef);
    73→		}
    74→	});
    75→
    76→	async function loadTasks() {
    77→		loading = true;
    78→		error = '';
    79→
    80→		try {
    81→			const response = await fetchTasks(filterParams);
    82→			tasks = response.items;
    83→			total = response.total;
    84→		} catch (err) {
    85→			error = err instanceof Error ? err.message : 'Failed to load tasks';
    86→			console.error('Error loading tasks:', err);
    87→		} finally {
    88→			loading = false;
    89→		}
    90→	}
    91→
    92→	async function handleSelectTask(taskId: string) {
    93→		console.log('[TasksPage] handleSelectTask called for:', taskId);
    94→		try {
    95→			console.log('[TasksPage] Fetching task details...');
    96→			const task = await fetchTask(taskId);
    97→			console.log('[TasksPage] Task fetched:', task?.title);
    98→			// Update panel state using flushSync to ensure synchronous DOM update
    99→			flushSync(() => {
   100→				panel.task = task;
   101→				panel.open = true;
   102→			});
   103→			console.log('[TasksPage] panel.open set to true, panel.task:', panel.task?.title);
   104→		} catch (err) {
   105→			error = err instanceof Error ? err.message : 'Failed to load task details';
   106→			console.error('[TasksPage] Error loading task:', err);
   107→		}
   108→	}
   109→
   110→	// Legacy event handler for backwards compatibility
   111→	function handleSelectTaskEvent(event: CustomEvent<string>) {
   112→		handleSelectTask(event.detail);
   113→	}
   114→
   115→	function handleCloseDetail() {
   116→		panel.open = false;
   117→		panel.task = null;
   118→		noteContent = '';
   119→		panelError = '';
   120→		lastProcessedRef = ''; // Reset so we can reopen same task if URL param set again
   121→	}
   122→
   123→	// Handle clicking outside the panel
   124→	function handleOverlayClick(e: MouseEvent) {
   125→		if (e.target === e.currentTarget) {
   126→			handleCloseDetail();
   127→		}
   128→	}
   129→
   130→	// Handle escape key
   131→	function handleKeydown(e: KeyboardEvent) {
   132→		if (e.key === 'Escape' && panel.open) {
   133→			handleCloseDetail();
   134→		}
   135→	}
   136→
   137→	async function handleStartTask() {
   138→		if (!panel.task) return;
   139→
   140→		// AC: @gh-pages-export ac-16, ac-18 - Check static mode
   141→		if (isStaticMode()) {
   142→			panelError = 'Cannot start task in read-only mode. Use the kspec CLI.';
   143→			return;
   144→		}
   145→
   146→		isSubmitting = true;
   147→		panelError = '';
   148→
   149→		try {
   150→			await startTask(panel.task._ulid);
   151→			// Reload task to get updated status
   152→			const updated = await fetchTask(panel.task._ulid);
   153→			panel.task = updated;
   154→			loadTasks();
   155→		} catch (err) {
   156→			// AC: @gh-pages-export ac-18 - Graceful error message
   157→			if (err instanceof ReadOnlyModeError) {
   158→				panelError = err.message;
   159→			} else {
   160→				panelError = err instanceof Error ? err.message : 'Failed to start task';
   161→			}
   162→		} finally {
   163→			isSubmitting = false;
   164→		}
   165→	}
   166→
   167→	async function handleAddNote() {
   168→		if (!panel.task || !noteContent.trim()) return;
   169→
   170→		// AC: @gh-pages-export ac-18 - Check static mode
   171→		if (isStaticMode()) {
   172→			panelError = 'Cannot add notes in read-only mode. Use the kspec CLI.';
   173→			return;
   174→		}
   175→
   176→		isSubmitting = true;
   177→		panelError = '';
   178→
   179→		try {
   180→			await addTaskNote(panel.task._ulid, noteContent);
   181→			noteContent = '';
   182→			// Reload task to get updated notes
   183→			const updated = await fetchTask(panel.task._ulid);
   184→			panel.task = updated;
   185→			loadTasks();
   186→		} catch (err) {
   187→			// AC: @gh-pages-export ac-18 - Graceful error message
   188→			if (err instanceof ReadOnlyModeError) {
   189→				panelError = err.message;
   190→			} else {
   191→				panelError = err instanceof Error ? err.message : 'Failed to add note';
   192→			}
   193→		} finally {
   194→			isSubmitting = false;
   195→		}
   196→	}
   197→
   198→	function formatDate(dateStr: string): string {
   199→		const date = new Date(dateStr);
   200→		return new Intl.DateTimeFormat('en-US', {
   201→			year: 'numeric',
   202→			month: 'short',
   203→			day: 'numeric',
   204→			hour: '2-digit',
   205→			minute: '2-digit'
   206→		}).format(date);
   207→	}
   208→
   209→	function getStatusColor(status: string): string {
   210→		const colors: Record<string, string> = {
   211→			pending: 'bg-gray-500',
   212→			in_progress: 'bg-blue-500',
   213→			pending_review: 'bg-yellow-500',
   214→			blocked: 'bg-red-500',
   215→			completed: 'bg-green-500',
   216→			cancelled: 'bg-gray-400'
   217→		};
   218→		return colors[status] || 'bg-gray-500';
   219→	}
   220→
   221→	function formatStatus(status: string): string {
   222→		const labels: Record<string, string> = {
   223→			pending: 'Pending',
   224→			in_progress: 'In Progress',
   225→			pending_review: 'Pending Review',
   226→			blocked: 'Blocked',
   227→			completed: 'Completed',
   228→			cancelled: 'Cancelled'
   229→		};
   230→		return labels[status] || status;
   231→	}
   232→
   233→	// AC: @web-dashboard ac-33 - Handle WebSocket task updates
   234→	function handleTaskUpdate(event: BroadcastEvent) {
   235→		console.log('[TasksPage] Task update received:', event);
   236→
   237→		// Mark task as updated for highlight animation
   238→		if (event.data?.ulid) {
   239→			updatedTaskIds.add(event.data.ulid);
   240→			updatedTaskIds = new Set(updatedTaskIds);
   241→
   242→			// Remove highlight after 3s
   243→			setTimeout(() => {
   244→				updatedTaskIds.delete(event.data.ulid);
   245→				updatedTaskIds = new Set(updatedTaskIds);
   246→			}, 3000);
   247→		}
   248→
   249→		// Reload tasks list
   250→		loadTasks();
   251→
   252→		// Reload selected task if it's the one that updated
   253→		if (panel.task && event.data?.ulid === panel.task._ulid) {
   254→			fetchTask(panel.task._ulid)
   255→				.then((updated) => {
   256→					panel.task = updated;
   257→				})
   258→				.catch((err) => {
   259→					console.error('Error reloading task:', err);
   260→				});
   261→		}
   262→	}
   263→
   264→	onMount(() => {
   265→		loadTasks();
   266→
   267→		// AC: @web-dashboard ac-32, ac-33 - Subscribe to task updates
   268→		subscribe(['tasks']);
   269→		on('tasks', handleTaskUpdate);
   270→	});
   271→
   272→	onDestroy(() => {
   273→		// Clean up subscription
   274→		off('tasks', handleTaskUpdate);
   275→		unsubscribe(['tasks']);
   276→	});
   277→</script>
   278→
   279→<svelte:window onkeydown={handleKeydown} />
   280→
   281→<div class="flex flex-col gap-6 p-6">
   282→	<div>
   283→		<h1 class="text-3xl font-bold mb-2">Tasks</h1>
   284→		{#if !loading}
   285→			<p class="text-muted-foreground">
   286→				Showing {tasks.length} of {total} tasks
   287→			</p>
   288→		{/if}
   289→	</div>
   290→
   291→	<TaskFilters />
   292→
   293→	{#if error}
   294→		<div class="bg-destructive/10 text-destructive p-4 rounded-lg" data-testid="error-message" role="alert">
   295→			{error}
   296→		</div>
   297→	{/if}
   298→
   299→	{#if loading}
   300→		<div class="flex justify-center items-center py-12">
   301→			<p class="text-muted-foreground">Loading tasks...</p>
   302→		</div>
   303→	{:else}
   304→		<!-- AC: @web-dashboard ac-33 -->
   305→		<TaskList {tasks} {updatedTaskIds} onSelectTask={handleSelectTask} on:select={handleSelectTaskEvent} />
   306→	{/if}
   307→</div>
   308→
   309→<!-- Inline Task Detail Panel - AC: @web-dashboard ac-5, ac-6, ac-7, ac-8 -->
   310→{#if panel.open && panel.task}
   311→	<div
   312→		class="fixed inset-0 z-50 bg-black/50"
   313→		onclick={handleOverlayClick}
   314→		onkeydown={(e) => e.key === 'Enter' && handleCloseDetail()}
   315→		role="button"
   316→		tabindex="-1"
   317→		aria-label="Close panel"
   318→	>
   319→		<!-- Panel -->
   320→		<div
   321→			class="fixed inset-y-0 right-0 z-50 w-3/4 max-w-lg bg-background shadow-lg border-l overflow-y-auto"
   322→			data-testid="task-detail-panel"
   323→			role="dialog"
   324→			aria-modal="true"
   325→			tabindex="0"
   326→			onclick={(e) => e.stopPropagation()}
   327→			onkeydown={(e) => e.stopPropagation()}
   328→		>
   329→			<!-- Header -->
   330→			<div class="flex items-center justify-between p-6 border-b">
   331→				<h2 class="text-lg font-semibold" data-testid="task-description">{panel.task.title}</h2>
   332→				<button
   333→					onclick={handleCloseDetail}
   334→					class="rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
   335→				>
   336→					<XIcon class="size-4" />
   337→					<span class="sr-only">Close</span>
   338→				</button>
   339→			</div>
   340→
   341→			<!-- Content -->
   342→			<div class="flex flex-col gap-4 p-6">
   343→				<!-- Status and Priority -->
   344→				<div class="flex gap-2 items-center">
   345→					<Badge data-testid="task-status-badge" class={getStatusColor(panel.task.status)}>{formatStatus(panel.task.status)}</Badge>
   346→					<Badge variant="outline">Priority: {panel.task.priority}</Badge>
   347→					{#if panel.task.type !== 'task'}
   348→						<Badge variant="outline">{panel.task.type}</Badge>
   349→					{/if}
   350→				</div>
   351→
   352→				<!-- Spec Reference -->
   353→				<!-- AC: @web-dashboard ac-6 -->
   354→				{#if panel.task.spec_ref}
   355→					<div data-testid="task-spec-ref-link">
   356→						<p class="text-sm font-medium mb-1">Spec Reference:</p>
   357→						<a
   358→							href="{base}/items?ref={encodeURIComponent(panel.task.spec_ref)}"
   359→							class="text-sm text-primary hover:underline"
   360→						>
   361→							{panel.task.spec_ref}
   362→						</a>
   363→					</div>
   364→				{/if}
   365→
   366→				<!-- Tags -->
   367→				{#if panel.task.tags?.length > 0}
   368→					<div>
   369→						<p class="text-sm font-medium mb-1">Tags:</p>
   370→						<div class="flex flex-wrap gap-1">
   371→							{#each panel.task.tags as tag}
   372→								<Badge variant="secondary">{tag}</Badge>
   373→							{/each}
   374→						</div>
   375→					</div>
   376→				{/if}
   377→
   378→				<!-- Dependencies -->
   379→				<div data-testid="task-dependencies">
   380→					{#if panel.task.depends_on?.length > 0}
   381→						<p class="text-sm font-medium mb-1">Dependencies:</p>
   382→						<ul class="text-sm space-y-1">
   383→							{#each panel.task.depends_on as dep}
   384→								<li>
   385→									<a href="{base}/tasks?ref={encodeURIComponent(dep)}" class="text-primary hover:underline">
   386→										{dep}
   387→									</a>
   388→								</li>
   389→							{/each}
   390→						</ul>
   391→					{:else}
   392→						<p class="text-sm text-muted-foreground">No dependencies</p>
   393→					{/if}
   394→				</div>
   395→
   396→				<!-- Blocked By -->
   397→				{#if panel.task.blocked_by?.length > 0}
   398→					<div>
   399→						<p class="text-sm font-medium mb-1 text-destructive">Blocked By:</p>
   400→						<ul class="text-sm space-y-1">
   401→							{#each panel.task.blocked_by as blocker}
   402→								<li class="text-muted-foreground">{blocker}</li>
   403→							{/each}
   404→						</ul>
   405→					</div>
   406→				{/if}
   407→
   408→				<Separator />
   409→
   410→				<!-- Actions -->
   411→				<!-- AC: @web-dashboard ac-7 -->
   412→				<!-- AC: @gh-pages-export ac-16 - Disabled with tooltip in static mode -->
   413→				{#if panel.task.status === 'pending'}
   414→					<div>
   415→						{#if isStaticMode()}
   416→							<Tooltip.Root>
   417→								<Tooltip.Trigger>
   418→									{#snippet child({ props })}
   419→										<Button
   420→											{...props}
   421→											data-testid="start-task-button"
   422→											disabled={true}
   423→											class="w-full"
   424→										>
   425→											Start Task
   426→										</Button>
   427→									{/snippet}
   428→								</Tooltip.Trigger>
   429→								<Tooltip.Content>
   430→									<p>Read-only mode - use CLI to start task</p>
   431→								</Tooltip.Content>
   432→							</Tooltip.Root>
   433→						{:else}
   434→							<Button data-testid="start-task-button" onclick={handleStartTask} disabled={isSubmitting} class="w-full">
   435→								{isSubmitting ? 'Starting...' : 'Start Task'}
   436→							</Button>
   437→						{/if}
   438→					</div>
   439→				{/if}
   440→
   441→				{#if panelError}
   442→					<p class="text-sm text-destructive">{panelError}</p>
   443→				{/if}
   444→
   445→				<Separator />
   446→
   447→				<!-- Todos -->
   448→				<div data-testid="task-todos">
   449→					{#if panel.task.todos && panel.task.todos.length > 0}
   450→						<p class="text-sm font-medium mb-2">Todos:</p>
   451→						<ul class="space-y-2">
   452→							{#each panel.task.todos as todo}
   453→								<li class="flex items-start gap-2 text-sm">
   454→									<span class="mt-0.5">
   455→										{#if todo.status === 'completed'}
   456→											✅
   457→										{:else if todo.status === 'in_progress'}
   458→											⏳
   459→										{:else}
   460→											⏸️
   461→										{/if}
   462→									</span>
   463→									<span class:line-through={todo.status === 'completed'}>
   464→										{todo.content}
   465→									</span>
   466→								</li>
   467→							{/each}
   468→						</ul>
   469→					{:else}
   470→						<p class="text-sm text-muted-foreground">No todos</p>
   471→					{/if}
   472→				</div>
   473→
   474→				<Separator />
   475→
   476→				<!-- Notes -->
   477→				<!-- AC: @web-dashboard ac-5 -->
   478→				<div data-testid="task-notes">
   479→					<p class="text-sm font-medium mb-2">Notes ({panel.task.notes?.length ?? 0}):</p>
   480→
   481→					<!-- Add Note Form -->
   482→					<!-- AC: @web-dashboard ac-8 -->
   483→					<!-- AC: @gh-pages-export ac-18 - Disabled in static mode -->
   484→					{#if !isStaticMode()}
   485→						<div class="mb-4 space-y-2" data-testid="add-note-form">
   486→							<Textarea
   487→								placeholder="Add a note..."
   488→								bind:value={noteContent}
   489→								disabled={isSubmitting}
   490→								rows={3}
   491→								data-testid="note-textarea"
   492→							/>
   493→							<Button
   494→								onclick={handleAddNote}
   495→								disabled={isSubmitting || !noteContent.trim()}
   496→								size="sm"
   497→								data-testid="add-note-button"
   498→							>
   499→								{isSubmitting ? 'Adding...' : 'Add Note'}
   500→							</Button>
   501→						</div>
   502→					{/if}
   503→
   504→					<!-- Notes List -->
   505→					<div class="space-y-4" data-testid="task-notes-list">
   506→						{#each panel.task.notes ?? [] as note}
   507→							<div class="border rounded-lg p-3" data-testid="note-item">
   508→								<div class="flex justify-between items-start mb-2">
   509→									<span class="text-xs text-muted-foreground">{note.author}</span>
   510→									<span class="text-xs text-muted-foreground" data-testid="note-timestamp">{formatDate(note.created_at)}</span>
   511→								</div>
   512→								<p class="text-sm whitespace-pre-wrap">{note.content}</p>
   513→							</div>
   514→						{/each}
   515→					</div>
   516→				</div>
   517→			</div>
   518→		</div>
   519→	</div>
   520→{/if}
   521→