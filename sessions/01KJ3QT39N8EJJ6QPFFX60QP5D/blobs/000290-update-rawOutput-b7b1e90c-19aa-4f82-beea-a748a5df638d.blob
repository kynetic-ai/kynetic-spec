    41→
    42→/**
    43→ * Log a debug message (only when KSPEC_DEBUG=1)
    44→ */
    45→function debugLog(prefix: string, message: string): void {
    46→  if (process.env.KSPEC_DEBUG === "1") {
    47→    console.error(`[DEBUG] ${prefix}: ${message}`);
    48→  }
    49→}
    50→
    51→/**
    52→ * Parse a manifest and emit deprecation warnings for deprecated fields.
    53→ *
    54→ * AC: @config-manifest-cleanup ac-4 — debug-level deprecation note for daemon block
    55→ */
    56→function parseManifestWithWarnings(rawManifest: unknown): Manifest {
    57→  const manifest = ManifestSchema.parse(rawManifest);
    58→
    59→  // AC: @config-manifest-cleanup ac-4 — log debug-level deprecation note for daemon block
    60→  if (manifest.daemon) {
    61→    debugLog(
    62→      "manifest",
    63→      'Deprecated "daemon" block found in manifest. Use kspec.config.yaml instead.',
    64→    );
    65→  }
    66→
    67→  // Also warn for deprecated config block
    68→  if (manifest.config) {
    69→    debugLog(
    70→      "manifest",
    71→      'Deprecated "config" block found in manifest. Use kspec.config.yaml instead.',
    72→    );
    73→  }
    74→
    75→  return manifest;
    76→}
    77→
    78→/**
    79→ * Spec item with runtime metadata for source tracking.
    80→ * _sourceFile is not serialized - it's used to know where to write updates.
    81→ * _path tracks location within the file for nested items (e.g., "features[0].requirements[2]")
    82→ */
    83→export interface LoadedSpecItem extends SpecItem {
    84→  _sourceFile?: string;
    85→  _path?: string;
    86→}
    87→
    88→/**
    89→ * Task with runtime metadata for source tracking.
    90→ * _sourceFile is not serialized - it's used to know where to write updates.
    91→ */
    92→export interface LoadedTask extends Task {
    93→  _sourceFile?: string;
    94→}
    95→
    96→/**
    97→ * Parse YAML content into an object
    98→ * Uses the modern yaml library which has consistent type handling
    99→ */
   100→export function parseYaml<T>(content: string): T {
   101→  return YAML.parse(content) as T;
   102→}
   103→
   104→/**
   105→ * Serialize object to YAML
   106→ * Uses the modern yaml library for consistent formatting.
   107→ *
   108→ * WORKAROUND: The 'yaml' library (v2.8.2+) has a known behavior where block scalars
   109→ * containing whitespace-only lines accumulate extra blank lines on each parse-stringify
   110→ * cycle. The library's blockString() function adds indentation after newlines, which
   111→ * causes lines containing only spaces to grow. We post-process the output to filter
   112→ * these whitespace-only lines. See: https://github.com/eemeli/yaml - stringifyString.ts
   113→ */
   114→export function toYaml(obj: unknown): string {
   115→  let yamlString = YAML.stringify(obj, {
   116→    indent: 2,
   117→    lineWidth: 100,
   118→    sortMapEntries: false,
   119→  });
   120→
   121→  // Post-process to fix yaml library blank line accumulation bug.
   122→  // Filter out lines that contain only spaces/tabs (not truly empty lines).
   123→  yamlString = yamlString
   124→    .split("\n")
   125→    .filter((line) => !/^[ \t]+$/.test(line))
   126→    .join("\n");
   127→
   128→  return yamlString;
   129→}
   130→
   131→/**
   132→ * Read and parse a YAML file
   133→ */
   134→export async function readYamlFile<T>(filePath: string): Promise<T> {
   135→  const content = await fs.readFile(filePath, "utf-8");
   136→  return parseYaml<T>(content);
   137→}
   138→
   139→/**
   140→ * Write object to YAML file
   141→ */
   142→export async function writeYamlFile(
   143→  filePath: string,
   144→  data: unknown,
   145→): Promise<void> {
   146→  const content = toYaml(data);
   147→  await fs.writeFile(filePath, content, "utf-8");
   148→}
   149→
   150→/**
   151→ * Write object to YAML file while preserving formatting and comments.
   152→ *
   153→ * Note: This function is now equivalent to writeYamlFile() - the "preserve format"
   154→ * naming is historical. Both use toYaml() which includes the whitespace-only line
   155→ * fix. Kept for backwards compatibility with existing callers.
   156→ */
   157→export async function writeYamlFilePreserveFormat(
   158→  filePath: string,
   159→  data: unknown,
   160→): Promise<void> {
   161→  const content = toYaml(data);
   162→  await fs.writeFile(filePath, content, "utf-8");
   163→}
   164→
   165→/**
   166→ * Find task files in a directory
   167→ */
   168→export async function findTaskFiles(dir: string): Promise<string[]> {
   169→  const files: string[] = [];
   170→
   171→  try {
   172→    const entries = await fs.readdir(dir, { withFileTypes: true });
   173→
   174→    for (const entry of entries) {
   175→      const fullPath = path.join(dir, entry.name);
   176→
   177→      if (entry.isDirectory()) {
   178→        // Recurse into subdirectories
   179→        const subFiles = await findTaskFiles(fullPath);
   180→        files.push(...subFiles);
   181→      } else if (entry.isFile() && entry.name.endsWith(".tasks.yaml")) {
   182→        files.push(fullPath);
   183→      }
   184→    }
   185→  } catch (_error) {
   186→    // Directory doesn't exist or not readable
   187→  }
   188→
   189→  return files;
   190→}
   191→
   192→/**
   193→ * Find the manifest file.
   194→ *
   195→ * Discovery algorithm per directory:
   196→ * 1. Check for explicit names: kynetic.yaml, kynetic.spec.yaml (backward compat)
   197→ * 2. If not found, scan for *.yaml files with 'kynetic:' version field
   198→ *
   199→ * Searches current dir, then spec/ subdir, then parent directories.
   200→ */
   201→export async function findManifest(startDir: string): Promise<string | null> {
   202→  let dir = startDir;
   203→
   204→  while (true) {
   205→    // Check current directory
   206→    const manifestInDir = await findManifestInDir(dir);
   207→    if (manifestInDir) {
   208→      return manifestInDir;
   209→    }
   210→
   211→    // Also check in spec/ subdirectory
   212→    const specDir = path.join(dir, "spec");
   213→    try {
   214→      const stat = await fs.stat(specDir);
   215→      if (stat.isDirectory()) {
   216→        const manifestInSpec = await findManifestInDir(specDir);
   217→        if (manifestInSpec) {
   218→          return manifestInSpec;
   219→        }
   220→      }
   221→    } catch {
   222→      // spec/ doesn't exist
   223→    }
   224→
   225→    const parentDir = path.dirname(dir);
   226→    if (parentDir === dir) {
   227→      // Reached root
   228→      return null;
   229→    }
   230→    dir = parentDir;
   231→  }
   232→}
   233→
   234→/**
   235→ * Context for working with spec/task files.
   236→ *
   237→ * When shadow branch is enabled:
   238→ * - rootDir points to the project root (where .kspec/ lives)
   239→ * - specDir points to .kspec/ (where spec files are read/written)
   240→ * - All file operations use specDir for resolution
   241→ *
   242→ * Without shadow branch:
   243→ * - rootDir is the project root
   244→ * - specDir is rootDir/spec/ (traditional layout)
   245→ */
   246→export interface KspecContext {
   247→  /** Project root directory */
   248→  rootDir: string;
   249→  /** Spec files directory (.kspec/ when shadow enabled, otherwise spec/) */
   250→  specDir: string;
   251→  /** Path to manifest file */
   252→  manifestPath: string | null;
   253→  /** Parsed manifest */
   254→  manifest: Manifest | null;
   255→  /** Shadow branch configuration (null if not using shadow) */
   256→  shadow: ShadowConfig | null;
   257→  /**
   258→   * Project configuration from kspec.config.yaml.
   259→   * Loaded before shadow detection. Always present (defaults if no config file).
   260→   *
   261→   * AC: @project-config ac-2 — config available on KspecContext.config
   262→   */
   263→  config: ResolvedKspecConfig;
   264→}
   265→
   266→/**
   267→ * Initialize context by finding manifest.
   268→ *
   269→ * Detection order:
   270→ * 1. Load project config from git root (before shadow detection)
   271→ * 2. Check for shadow branch (.kspec/ directory)
   272→ * 3. Fall back to traditional spec/ directory
   273→ *
   274→ * When shadow is detected, all operations use .kspec/ as specDir.
   275→ *
   276→ * AC: @project-config ac-2 — config loaded before shadow detection
   277→ */
   278→export async function initContext(startDir?: string): Promise<KspecContext> {
   279→  const cwd = startDir || process.cwd();
   280→
   281→  // AC: @project-config ac-2, ac-6, ac-7 — load config before shadow detection
   282→  // Config is loaded from git root, not cwd or KSPEC_SPEC_DIR temp dir
   283→  const configResult = await loadProjectConfig(cwd);
   284→
   285→  // AC: @project-config ac-3 — emit warning to stderr if config had issues
   286→  if (configResult.warning) {
   287→    console.error(`Warning: ${configResult.warning}`);
   288→  }
   289→
   290→  const { config } = configResult;
   291→
   292→  // KSPEC_SPEC_DIR override: used by batch atomic mode to redirect to temp copy
   293→  const specDirOverride = process.env.KSPEC_SPEC_DIR;
   294→  if (specDirOverride) {
   295→    const specDir = path.resolve(specDirOverride);
   296→    const manifestPath = await findManifestInDir(specDir);
   297→
   298→    let manifest: Manifest | null = null;
   299→    if (manifestPath) {
   300→      try {
   301→        const rawManifest = await readYamlFile<unknown>(manifestPath);
   302→        manifest = parseManifestWithWarnings(rawManifest);
   303→      } catch {
   304→        // Manifest exists but may be invalid
   305→      }
   306→    }
   307→
   308→    return {
   309→      rootDir: path.dirname(specDir),
   310→      specDir,
   311→      manifestPath,
   312→      manifest,
   313→      shadow: null, // No shadow in overridden context
   314→      config,
   315→    };
   316→  }
   317→
   318→  // Check if running from inside the shadow worktree
   319→  // AC: @config-shadow ac-8 — pass configured directory for detection
   320→  const mainProjectRoot = await detectRunningFromShadowWorktree(
   321→    cwd,
   322→    config.shadow.directory,
   323→  );
   324→  if (mainProjectRoot) {
   325→    throw new ShadowError(
   326→      errors.project.runningFromShadow,
   327→      "RUNNING_FROM_SHADOW",
   328→      `Run from project root: cd ${path.relative(cwd, mainProjectRoot) || mainProjectRoot}`,
   329→    );
   330→  }
   331→
   332→  // Try to detect shadow branch first
   333→  // AC: @config-shadow ac-1 ac-2 — use configured branch/directory names
   334→  const shadow = await detectShadow(cwd, {
   335→    branchName: config.shadow.branch,
   336→    directory: config.shadow.directory,
   337→  });
   338→
   339→  if (shadow?.enabled) {
   340→    // Shadow mode: use .kspec/ for everything
   341→    const specDir = shadow.worktreeDir;
   342→    const manifestPath = await findManifestInDir(specDir);
   343→
   344→    let manifest: Manifest | null = null;
   345→    if (manifestPath) {
   346→      try {
   347→        const rawManifest = await readYamlFile<unknown>(manifestPath);
   348→        manifest = parseManifestWithWarnings(rawManifest);
   349→      } catch {
   350→        // Manifest exists but may be invalid
   351→      }
   352→    }
   353→
   354→    return {
   355→      rootDir: shadow.projectRoot,
   356→      specDir,
   357→      manifestPath,
   358→      manifest,
   359→      shadow,
   360→      config,
   361→    };
   362→  }
   363→
   364→  // Traditional mode: find manifest in spec/ or current directory
   365→  const manifestPath = await findManifest(cwd);
   366→
   367→  let manifest: Manifest | null = null;
   368→  let rootDir = cwd;
   369→  let specDir = cwd;
   370→
   371→  if (manifestPath) {
   372→    const manifestDir = path.dirname(manifestPath);
   373→    // Handle spec/ subdirectory
   374→    if (path.basename(manifestDir) === "spec") {
   375→      rootDir = path.dirname(manifestDir);
   376→      specDir = manifestDir;
   377→    } else {
   378→      rootDir = manifestDir;
   379→      specDir = manifestDir;
   380→    }
   381→
   382→    try {
   383→      const rawManifest = await readYamlFile<unknown>(manifestPath);
   384→      manifest = parseManifestWithWarnings(rawManifest);
   385→    } catch {
   386→      // Manifest exists but may be invalid
   387→    }
   388→  }
   389→
   390→  return { rootDir, specDir, manifestPath, manifest, shadow: null, config };
   391→}
   392→
   393→/**
   394→ * Check if a filename is a potential manifest file.
   395→ * Excludes files with suffixes that indicate other kspec file types.
   396→ *
   397→ * AC: @manifest-discovery ac-5 (excludes task/inbox/meta/runs files)
   398→ */
   399→function isManifestCandidate(filename: string): boolean {
   400→  if (!filename.endsWith(".yaml")) return false;
   401→  const exclusions = [".tasks.yaml", ".inbox.yaml", ".meta.yaml", ".runs.yaml"];
   402→  return !exclusions.some((excl) => filename.endsWith(excl));
   403→}
   404→
   405→/**
   406→ * Find manifest file within a specific directory (no parent traversal).
   407→ * Used for shadow mode where we know exactly where to look.
   408→ *
   409→ * Discovery algorithm:
   410→ * 1. Check for explicit names: kynetic.yaml, kynetic.spec.yaml (backward compat)
   411→ * 2. If not found, scan directory for *.yaml files (excluding other kspec types)
   412→ * 3. For each candidate, validate it contains a 'kynetic:' version field
   413→ * 4. Return first valid match (alphabetically after explicit names)
   414→ *
   415→ * AC: @manifest-discovery ac-1, ac-2, ac-3, ac-4, ac-5
   416→ */
   417→async function findManifestInDir(dir: string): Promise<string | null> {
   418→  // AC: @manifest-discovery ac-1, ac-2 - explicit names have priority
   419→  const priorityCandidates = ["kynetic.yaml", "kynetic.spec.yaml"];
   420→
   421→  for (const candidate of priorityCandidates) {
   422→    const filePath = path.join(dir, candidate);
   423→    try {
   424→      await fs.access(filePath);
   425→      return filePath;
   426→    } catch {
   427→      // File doesn't exist, try next
   428→    }
   429→  }
   430→
   431→  // AC: @manifest-discovery ac-3, ac-4, ac-5 - glob fallback with validation
   432→  try {
   433→    const entries = await fs.readdir(dir);
   434→    // AC: @manifest-discovery ac-4 - alphabetical order
   435→    const candidates = entries.filter(isManifestCandidate).sort();
   436→
   437→    for (const candidate of candidates) {
   438→      const filePath = path.join(dir, candidate);
   439→      try {
   440→        const raw = await readYamlFile<unknown>(filePath);
   441→        // AC: @manifest-discovery ac-5 - validate kynetic version field
   442→        if (raw && typeof raw === "object" && "kynetic" in raw) {
   443→          return filePath;
   444→        }
   445→      } catch {
   446→        // Skip invalid files
   447→      }
   448→    }
   449→  } catch {
   450→    // Directory read failed
   451→  }
   452→
   453→  return null;
   454→}
   455→
   456→/**
   457→ * Load tasks from a single file.
   458→ * Helper function used by loadAllTasks.
   459→ */
   460→async function loadTasksFromFile(filePath: string): Promise<LoadedTask[]> {
   461→  const tasks: LoadedTask[] = [];
   462→
   463→  try {
   464→    const raw = await readYamlFile<unknown>(filePath);
   465→
   466→    // Handle both array format and object format
   467→    let taskList: unknown[];
   468→
   469→    if (Array.isArray(raw)) {
   470→      taskList = raw;
   471→    } else if (raw && typeof raw === "object" && "tasks" in raw) {
   472→      const parsed = TasksFileSchema.safeParse(raw);
   473→      if (parsed.success) {
   474→        // Add _sourceFile to each task from this file
   475→        for (const task of parsed.data.tasks) {
   476→          tasks.push({ ...task, _sourceFile: filePath });
   477→        }
   478→        return tasks;
   479→      }
   480→      taskList = (raw as { tasks: unknown[] }).tasks || [];
   481→    } else {
   482→      // Single task object
   483→      taskList = [raw];
   484→    }
   485→
   486→    for (const taskData of taskList) {
   487→      const result = TaskSchema.safeParse(taskData);
   488→      if (result.success) {
   489→        // Add _sourceFile metadata
   490→        tasks.push({ ...result.data, _sourceFile: filePath });
   491→      }
   492→    }
   493→  } catch {
   494→    // Skip invalid files
   495→  }
   496→
   497→  return tasks;
   498→}
   499→
   500→/**
   501→ * Load all tasks from the project.
   502→ * Each task includes _sourceFile metadata for write-back routing.
   503→ *
   504→ * When shadow is enabled, tasks are loaded from .kspec/ (ctx.specDir).
   505→ * Otherwise, searches in traditional locations (rootDir, spec/, tasks/).
   506→ */
   507→export async function loadAllTasks(ctx: KspecContext): Promise<LoadedTask[]> {
   508→  const tasks: LoadedTask[] = [];
   509→
   510→  // When shadow is enabled, look only in specDir
   511→  if (ctx.shadow?.enabled) {
   512→    const taskFiles = await findTaskFiles(ctx.specDir);
   513→
   514→    // Also check for standalone files in specDir
   515→    const standaloneLocations = [
   516→      path.join(ctx.specDir, "tasks.yaml"),
   517→      path.join(ctx.specDir, "project.tasks.yaml"),
   518→      path.join(ctx.specDir, "kynetic.tasks.yaml"),
   519→      path.join(ctx.specDir, "backlog.tasks.yaml"),
   520→      path.join(ctx.specDir, "active.tasks.yaml"),
   521→    ];
   522→
   523→    for (const loc of standaloneLocations) {
   524→      try {
   525→        await fs.access(loc);
   526→        if (!taskFiles.includes(loc)) {
   527→          taskFiles.push(loc);
   528→        }
   529→      } catch {
   530→        // File doesn't exist
   531→      }
   532→    }
   533→
   534→    // Deduplicate and load
   535→    const uniqueFiles = [...new Set(taskFiles)];
   536→    for (const filePath of uniqueFiles) {
   537→      const fileTasks = await loadTasksFromFile(filePath);
   538→      tasks.push(...fileTasks);
   539→    }
   540→
   541→    return tasks;
   542→  }
   543→
   544→  // Traditional mode: look in multiple locations
   545→  const taskFiles = await findTaskFiles(ctx.rootDir);
   546→
   547→  // Also check common locations
   548→  const additionalPaths = [
   549→    path.join(ctx.rootDir, "tasks"),
   550→    path.join(ctx.rootDir, "spec"),
   551→  ];
   552→
   553→  for (const additionalPath of additionalPaths) {
   554→    const files = await findTaskFiles(additionalPath);
   555→    taskFiles.push(...files);
   556→  }
   557→
   558→  // Also look for standalone tasks.yaml and project.tasks.yaml
   559→  const standaloneLocations = [
   560→    path.join(ctx.rootDir, "tasks.yaml"),
   561→    path.join(ctx.rootDir, "project.tasks.yaml"),
   562→    path.join(ctx.rootDir, "spec", "project.tasks.yaml"),
   563→    path.join(ctx.rootDir, "backlog.tasks.yaml"),
   564→    path.join(ctx.rootDir, "active.tasks.yaml"),
   565→  ];
   566→
   567→  for (const loc of standaloneLocations) {
   568→    try {
   569→      await fs.access(loc);
   570→      if (!taskFiles.includes(loc)) {
   571→        taskFiles.push(loc);
   572→      }
   573→    } catch {
   574→      // File doesn't exist
   575→    }
   576→  }
   577→
   578→  // Deduplicate and load
   579→  const uniqueFiles = [...new Set(taskFiles)];
   580→
   581→  for (const filePath of uniqueFiles) {
   582→    const fileTasks = await loadTasksFromFile(filePath);
   583→    tasks.push(...fileTasks);
   584→  }
   585→
   586→  return tasks;
   587→}
   588→
   589→/**
   590→ * Find a task by reference (ULID, slug, or short reference)
   591→ */
   592→export function findTaskByRef(
   593→  tasks: LoadedTask[],
   594→  ref: string,
   595→): LoadedTask | undefined {
   596→  // Remove @ prefix if present
   597→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   598→
   599→  return tasks.find((task) => {
   600→    // Match full ULID
   601→    if (task._ulid === cleanRef) return true;
   602→
   603→    // Match short ULID (prefix)
   604→    if (task._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
   605→      return true;
   606→
   607→    // Match slug
   608→    if (task.slugs.includes(cleanRef)) return true;
   609→
   610→    return false;
   611→  });
   612→}
   613→
   614→/**
   615→ * Get the default task file path for new tasks without a spec_ref.
   616→ *
   617→ * When shadow enabled: .kspec/project.tasks.yaml
   618→ * Otherwise: spec/project.tasks.yaml
   619→ */
   620→export function getDefaultTaskFilePath(ctx: KspecContext): string {
   621→  return path.join(ctx.specDir, "project.tasks.yaml");
   622→}
   623→
   624→/**
   625→ * Strip runtime metadata before serialization
   626→ */
   627→function stripRuntimeMetadata(task: LoadedTask): Task {
   628→  const { _sourceFile, ...cleanTask } = task;
   629→  return cleanTask as Task;
   630→}
   631→
   632→/**
   633→ * Save a task to its source file (or default location for new tasks).
   634→ * Preserves file format (tasks: [...] wrapper vs plain array).
   635→ */
   636→export async function saveTask(
   637→  ctx: KspecContext,
   638→  task: LoadedTask,
   639→): Promise<void> {
   640→  // Determine target file: use _sourceFile if present, otherwise default
   641→  const taskFilePath = task._sourceFile || getDefaultTaskFilePath(ctx);
   642→
   643→  // Ensure directory exists
   644→  const dir = path.dirname(taskFilePath);
   645→  await fs.mkdir(dir, { recursive: true });
   646→
   647→  // Load existing tasks from the target file
   648→  let existingRaw: unknown = null;
   649→  let useTasksWrapper = false;
   650→
   651→  try {
   652→    existingRaw = await readYamlFile<unknown>(taskFilePath);
   653→    // Detect if file uses { tasks: [...] } format
   654→    if (
   655→      existingRaw &&
   656→      typeof existingRaw === "object" &&
   657→      "tasks" in existingRaw
   658→    ) {
   659→      useTasksWrapper = true;
   660→    }
   661→  } catch {
   662→    // File doesn't exist, start fresh
   663→  }
   664→
   665→  // Parse existing tasks from file
   666→  let fileTasks: Task[] = [];
   667→
   668→  if (existingRaw) {
   669→    if (Array.isArray(existingRaw)) {
   670→      for (const t of existingRaw) {
   671→        const result = TaskSchema.safeParse(t);
   672→        if (result.success) {
   673→          fileTasks.push(result.data);
   674→        }
   675→      }
   676→    } else if (useTasksWrapper) {
   677→      // Try TasksFileSchema first (has kynetic_tasks version)
   678→      const parsed = TasksFileSchema.safeParse(existingRaw);
   679→      if (parsed.success) {
   680→        fileTasks = parsed.data.tasks;
   681→      } else {
   682→        // Fall back to raw tasks array (common format without version field)
   683→        const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   684→        if (Array.isArray(rawTasks)) {
   685→          for (const t of rawTasks) {
   686→            const result = TaskSchema.safeParse(t);
   687→            if (result.success) {
   688→              fileTasks.push(result.data);
   689→            }
   690→          }
   691→        }
   692→      }
   693→    }
   694→  }
   695→
   696→  // Strip runtime metadata before saving
   697→  const cleanTask = stripRuntimeMetadata(task);
   698→
   699→  // Update existing or add new
   700→  const existingIndex = fileTasks.findIndex((t) => t._ulid === task._ulid);
   701→  if (existingIndex >= 0) {
   702→    fileTasks[existingIndex] = cleanTask;
   703→  } else {
   704→    fileTasks.push(cleanTask);
   705→  }
   706→
   707→  // Save in the same format as original (or tasks: wrapper for new files)
   708→  // Use format-preserving write to maintain formatting and comments
   709→  if (useTasksWrapper) {
   710→    await writeYamlFilePreserveFormat(taskFilePath, { tasks: fileTasks });
   711→  } else {
   712→    await writeYamlFilePreserveFormat(taskFilePath, fileTasks);
   713→  }
   714→}
   715→
   716→/**
   717→ * Delete a task from its source file.
   718→ * Requires _sourceFile to know which file to modify.
   719→ */
   720→export async function deleteTask(
   721→  _ctx: KspecContext,
   722→  task: LoadedTask,
   723→): Promise<void> {
   724→  if (!task._sourceFile) {
   725→    throw new Error("Cannot delete task without _sourceFile metadata");
   726→  }
   727→
   728→  const taskFilePath = task._sourceFile;
   729→
   730→  // Load existing file
   731→  let existingRaw: unknown = null;
   732→  let useTasksWrapper = false;
   733→
   734→  try {
   735→    existingRaw = await readYamlFile<unknown>(taskFilePath);
   736→    if (
   737→      existingRaw &&
   738→      typeof existingRaw === "object" &&
   739→      "tasks" in existingRaw
   740→    ) {
   741→      useTasksWrapper = true;
   742→    }
   743→  } catch {
   744→    throw new Error(`Task file not found: ${taskFilePath}`);
   745→  }
   746→
   747→  // Parse existing tasks
   748→  let fileTasks: Task[] = [];
   749→
   750→  if (existingRaw) {
   751→    if (Array.isArray(existingRaw)) {
   752→      for (const t of existingRaw) {
   753→        const result = TaskSchema.safeParse(t);
   754→        if (result.success) {
   755→          fileTasks.push(result.data);
   756→        }
   757→      }
   758→    } else if (useTasksWrapper) {
   759→      const parsed = TasksFileSchema.safeParse(existingRaw);
   760→      if (parsed.success) {
   761→        fileTasks = parsed.data.tasks;
   762→      } else {
   763→        const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   764→        if (Array.isArray(rawTasks)) {
   765→          for (const t of rawTasks) {
   766→            const result = TaskSchema.safeParse(t);
   767→            if (result.success) {
   768→              fileTasks.push(result.data);
   769→            }
   770→          }
   771→        }
   772→      }
   773→    }
   774→  }
   775→
   776→  // Remove the task
   777→  const originalCount = fileTasks.length;
   778→  fileTasks = fileTasks.filter((t) => t._ulid !== task._ulid);
   779→
   780→  if (fileTasks.length === originalCount) {
   781→    throw new Error(`Task not found in file: ${task._ulid}`);
   782→  }
   783→
   784→  // Save the modified file with format preservation
   785→  if (useTasksWrapper) {
   786→    await writeYamlFilePreserveFormat(taskFilePath, { tasks: fileTasks });
   787→  } else {
   788→    await writeYamlFilePreserveFormat(taskFilePath, fileTasks);
   789→  }
   790→}
   791→
   792→/**
   793→ * Create a new task with auto-generated fields
   794→ */
   795→export function createTask(input: TaskInput): Task {
   796→  const now = new Date().toISOString();
   797→
   798→  return {
   799→    ...input,
   800→    _ulid: input._ulid || ulid(),
   801→    slugs: input.slugs || [],
   802→    type: input.type || "task",
   803→    status: input.status || "pending",
   804→    blocked_by: input.blocked_by || [],
   805→    depends_on: input.depends_on || [],
   806→    context: input.context || [],
   807→    priority: input.priority || 3,
   808→    tags: input.tags || [],
   809→    vcs_refs: input.vcs_refs || [],
   810→    created_at: input.created_at || now,
   811→    notes: input.notes || [],
   812→    todos: input.todos || [],
   813→  };
   814→}
   815→
   816→/**
   817→ * Get author from environment with fallback chain.
   818→ * Priority:
   819→ *   1. KSPEC_AUTHOR env var (explicit config, agent-agnostic)
   820→ *   2. kspec.config.yaml identity.author (project-level default)
   821→ *   3. git user.name (developer identity)
   822→ *   4. USER/USERNAME env var (system user)
   823→ *   5. undefined (will show as 'unknown' in output)
   824→ *
   825→ * For Claude Code integration, add to ~/.claude/settings.json:
   826→ *   { "env": { "KSPEC_AUTHOR": "@claude" } }
   827→ *
   828→ * AC: @config-author ac-1 ac-2 ac-3 — author priority chain
   829→ *
   830→ * @param configAuthor Optional author from kspec.config.yaml identity.author
   831→ */
   832→export function getAuthor(configAuthor?: string | null): string | undefined {
   833→  // 1. Explicit env var (works for any agent) — AC: ac-2
   834→  if (process.env.KSPEC_AUTHOR) {
   835→    return process.env.KSPEC_AUTHOR;
   836→  }
   837→
   838→  // 2. Project config author — AC: ac-1
   839→  if (configAuthor) {
   840→    return configAuthor;
   841→  }
   842→
   843→  // 3. Git user.name — AC: ac-3
   844→  try {
   845→    const gitUser = execSync("git config user.name", {
   846→      encoding: "utf-8",
   847→      stdio: ["pipe", "pipe", "ignore"],
   848→    }).trim();
   849→    if (gitUser) {
   850→      return gitUser;
   851→    }
   852→  } catch {
   853→    // git not available or not in a repo
   854→  }
   855→
   856→  // 4. System user — AC: ac-3
   857→  const systemUser = process.env.USER || process.env.USERNAME;
   858→  if (systemUser) {
   859→    return systemUser;
   860→  }
   861→
   862→  // 5. No author available
   863→  return undefined;
   864→}
   865→
   866→/**
   867→ * Create a new note entry.
   868→ * If author is not provided, attempts to auto-detect from environment.
   869→ */
   870→export function createNote(
   871→  content: string,
   872→  author?: string,
   873→  supersedes?: string,
   874→): Note {
   875→  return {
   876→    _ulid: ulid(),
   877→    created_at: new Date().toISOString(),
   878→    author: author ?? getAuthor(),
   879→    // Trim content to prevent whitespace-only lines from accumulating
   880→    // in block scalars during YAML parse-stringify cycles
   881→    content: content.trim(),
   882→    supersedes: supersedes || null,
   883→  };
   884→}
   885→
   886→/**
   887→ * Create a new todo item.
   888→ * The id should be the next available id for the task's todos array.
   889→ */
   890→export function createTodo(id: number, text: string, addedBy?: string): Todo {
   891→  return {
   892→    id,
   893→    // Trim text to prevent whitespace-only lines from accumulating
   894→    // in block scalars during YAML parse-stringify cycles
   895→    text: text.trim(),
   896→    done: false,
   897→    added_at: new Date().toISOString(),
   898→    added_by: addedBy ?? getAuthor(),
   899→  };
   900→}
   901→
   902→/**
   903→ * Check if task dependencies are met
   904→ */
   905→export function areDependenciesMet(
   906→  task: LoadedTask,
   907→  allTasks: LoadedTask[],
   908→): boolean {
   909→  if (task.depends_on.length === 0) return true;
   910→
   911→  for (const depRef of task.depends_on) {
   912→    const depTask = findTaskByRef(allTasks, depRef);
   913→    if (!depTask || depTask.status !== "completed") {
   914→      return false;
   915→    }
   916→  }
   917→
   918→  return true;
   919→}
   920→
   921→/**
   922→ * Check if task is ready (pending + deps met + not blocked)
   923→ */
   924→export function isTaskReady(task: LoadedTask, allTasks: LoadedTask[]): boolean {
   925→  if (task.status !== "pending") return false;
   926→  if (task.blocked_by.length > 0) return false;
   927→  return areDependenciesMet(task, allTasks);
   928→}
   929→
   930→/**
   931→ * Get ready tasks (pending + deps met + not blocked), sorted by priority then creation time.
   932→ * Within the same priority tier, older tasks come first (FIFO).
   933→ */
   934→export function getReadyTasks(tasks: LoadedTask[]): LoadedTask[] {
   935→  return tasks
   936→    .filter((task) => isTaskReady(task, tasks))
   937→    .sort((a, b) => {
   938→      // Primary: priority (lower number = higher priority)
   939→      if (a.priority !== b.priority) {
   940→        return a.priority - b.priority;
   941→      }
   942→      // Secondary: creation time (older first - FIFO within priority)
   943→      return (
   944→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime()
   945→      );
   946→    });
   947→}
   948→
   949→// ============================================================
   950→// SPEC ITEM LOADING
   951→// ============================================================
   952→
   953→/**
   954→ * Expand a glob-like include pattern to file paths.
   955→ * Supports simple patterns like "modules/*.yaml" or "**\/*.yaml"
   956→ */
   957→export async function expandIncludePattern(
   958→  pattern: string,
   959→  baseDir: string,
   960→): Promise<string[]> {
   961→  const fullPattern = path.isAbsolute(pattern)
   962→    ? pattern
   963→    : path.join(baseDir, pattern);
   964→
   965→  // If no glob characters, just return the path if it exists
   966→  if (!pattern.includes("*")) {
   967→    try {
   968→      await fs.access(fullPattern);
   969→      return [fullPattern];
   970→    } catch {
   971→      return [];
   972→    }
   973→  }
   974→
   975→  // Split pattern into directory part and file pattern
   976→  const parts = pattern.split("/");
   977→  let currentDir = baseDir;
   978→  const result: string[] = [];
   979→
   980→  // Find the first part with a glob
   981→  const globIndex = parts.findIndex((p) => p.includes("*"));
   982→
   983→  // Navigate to the directory before the glob
   984→  if (globIndex > 0) {
   985→    currentDir = path.join(baseDir, ...parts.slice(0, globIndex));
   986→  }
   987→
   988→  // Get the remaining pattern
   989→  const remainingPattern = parts.slice(globIndex).join("/");
   990→
   991→  await expandGlobRecursive(currentDir, remainingPattern, result);
   992→  return result;
   993→}
   994→
   995→/**
   996→ * Recursively expand glob patterns
   997→ */
   998→async function expandGlobRecursive(
   999→  dir: string,
  1000→  pattern: string,
  1001→  result: string[],
  1002→): Promise<void> {
  1003→  const parts = pattern.split("/");
  1004→  const currentPattern = parts[0];
  1005→  const remainingPattern = parts.slice(1).join("/");
  1006→
  1007→  try {
  1008→    const entries = await fs.readdir(dir, { withFileTypes: true });
  1009→
  1010→    for (const entry of entries) {
  1011→      const matches = matchGlobPart(entry.name, currentPattern);
  1012→
  1013→      if (matches) {
  1014→        const fullPath = path.join(dir, entry.name);
  1015→
  1016→        if (remainingPattern) {
  1017→          // More pattern parts to process
  1018→          if (entry.isDirectory()) {
  1019→            await expandGlobRecursive(fullPath, remainingPattern, result);
  1020→          }
  1021→        } else {
  1022→          // This is the final pattern part
  1023→          if (currentPattern === "**") {
  1024→            // ** matches any depth - need special handling
  1025→            if (entry.isDirectory()) {
  1026→              await expandGlobRecursive(fullPath, "**", result);
  1027→            }
  1028→            // Also match files at this level
  1029→            result.push(fullPath);
  1030→          } else if (entry.isFile()) {
  1031→            result.push(fullPath);
  1032→          }
  1033→        }
  1034→      }
  1035→
  1036→      // Handle ** - also recurse into directories without consuming the pattern
  1037→      if (currentPattern === "**" && entry.isDirectory()) {
  1038→        const fullPath = path.join(dir, entry.name);
  1039→        await expandGlobRecursive(fullPath, pattern, result);
  1040→      }
  1041→    }
  1042→  } catch {
  1043→    // Directory doesn't exist or not readable
  1044→  }
  1045→}
  1046→
  1047→/**
  1048→ * Match a single path component against a glob pattern part
  1049→ */
  1050→function matchGlobPart(name: string, pattern: string): boolean {
  1051→  if (pattern === "*") return true;
  1052→  if (pattern === "**") return true;
  1053→
  1054→  // Convert glob pattern to regex
  1055→  const regexPattern = pattern
  1056→    .replace(/[.+^${}()|[\]\\]/g, "\\$&") // Escape special regex chars
  1057→    .replace(/\*/g, ".*") // * matches anything
  1058→    .replace(/\?/g, "."); // ? matches single char
  1059→
  1060→  const regex = new RegExp(`^${regexPattern}$`);
  1061→  return regex.test(name);
  1062→}
  1063→
  1064→/**
  1065→ * Fields that may contain nested spec items
  1066→ */
  1067→const NESTED_ITEM_FIELDS = [
  1068→  "modules",
  1069→  "features",
  1070→  "requirements",
  1071→  "constraints",
  1072→  "decisions",
  1073→  "traits",
  1074→  "acceptance_criteria",
  1075→];
  1076→
  1077→/**
  1078→ * Recursively extract all spec items from a raw YAML structure.
  1079→ * Items can be nested under modules/features/requirements/etc.
  1080→ * Tracks the path within the file for each item.
  1081→ */
  1082→export function extractItemsFromRaw(
  1083→  raw: unknown,
  1084→  sourceFile: string,
  1085→  items: LoadedSpecItem[] = [],
  1086→  currentPath: string = "",
  1087→): LoadedSpecItem[] {
  1088→  if (!raw || typeof raw !== "object") {
  1089→    return items;
  1090→  }
  1091→
  1092→  // Check if this object is itself a spec item (has _ulid)
  1093→  if (
  1094→    "_ulid" in raw &&
  1095→    typeof (raw as Record<string, unknown>)._ulid === "string"
  1096→  ) {
  1097→    // Strip nested item arrays before validation since they're processed separately
  1098→    // and the SpecItemSchema expects refs (strings), not nested objects
  1099→    const rawObj = raw as Record<string, unknown>;
  1100→    const cleanedForValidation: Record<string, unknown> = { ...rawObj };
  1101→    for (const field of NESTED_ITEM_FIELDS) {
  1102→      if (field in cleanedForValidation && Array.isArray(cleanedForValidation[field])) {
  1103→        const arr = cleanedForValidation[field] as unknown[];
  1104→        // Check if array contains nested items (objects with _ulid) vs refs (strings)
  1105→        const hasNestedItems = arr.some(
  1106→          (item) =>
  1107→            item && typeof item === "object" && "_ulid" in (item as Record<string, unknown>)
  1108→        );
  1109→        if (hasNestedItems) {
  1110→          // Strip nested items - they'll be extracted recursively
  1111→          delete cleanedForValidation[field];
  1112→        }
  1113→      }
  1114→    }
  1115→
  1116→    const result = SpecItemSchema.safeParse(cleanedForValidation);
  1117→    if (result.success) {
  1118→      items.push({
  1119→        ...result.data,
  1120→        _sourceFile: sourceFile,
  1121→        _path: currentPath || undefined,
  1122→      });
  1123→    }
  1124→
  1125→    // Even if the item itself was added, also extract nested items
  1126→    for (const field of NESTED_ITEM_FIELDS) {
  1127→      if (field in rawObj && Array.isArray(rawObj[field])) {
  1128→        const arr = rawObj[field] as unknown[];
  1129→        for (let i = 0; i < arr.length; i++) {
  1130→          const nestedPath = currentPath
  1131→            ? `${currentPath}.${field}[${i}]`
  1132→            : `${field}[${i}]`;
  1133→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
  1134→        }
  1135→      }
  1136→    }
  1137→  } else if (Array.isArray(raw)) {
  1138→    // Array of items at root level
  1139→    for (let i = 0; i < raw.length; i++) {
  1140→      const itemPath = currentPath ? `${currentPath}[${i}]` : `[${i}]`;
  1141→      extractItemsFromRaw(raw[i], sourceFile, items, itemPath);
  1142→    }
  1143→  } else {
  1144→    // Object that might contain item arrays (like manifest with modules/features/etc)
  1145→    const rawObj = raw as Record<string, unknown>;
  1146→    for (const field of NESTED_ITEM_FIELDS) {
  1147→      if (field in rawObj && Array.isArray(rawObj[field])) {
  1148→        const arr = rawObj[field] as unknown[];
  1149→        for (let i = 0; i < arr.length; i++) {
  1150→          const nestedPath = currentPath
  1151→            ? `${currentPath}.${field}[${i}]`
  1152→            : `${field}[${i}]`;
  1153→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
  1154→        }
  1155→      }
  1156→    }
  1157→  }
  1158→
  1159→  return items;
  1160→}
  1161→
  1162→/**
  1163→ * Load spec items from a single file.
  1164→ * Handles module files (the file itself is an item with nested children).
  1165→ */
  1166→export async function loadSpecFile(
  1167→  filePath: string,
  1168→): Promise<LoadedSpecItem[]> {
  1169→  try {
  1170→    const content = await fs.readFile(filePath, "utf-8");
  1171→    const items: LoadedSpecItem[] = [];
  1172→
  1173→    // Parse all YAML documents in the file (handles files with ---)
  1174→    const documents = YAML.parseAllDocuments(content);
  1175→
  1176→    for (const doc of documents) {
  1177→      if (doc.errors.length > 0) {
  1178→        // Skip documents with parse errors
  1179→        continue;
  1180→      }
  1181→
  1182→      const raw = doc.toJS();
  1183→      if (raw) {
  1184→        const docItems = extractItemsFromRaw(raw, filePath);
  1185→        items.push(...docItems);
  1186→      }
  1187→    }
  1188→
  1189→    return items;
  1190→  } catch (_error) {
  1191→    // File doesn't exist or parse error
  1192→    return [];
  1193→  }
  1194→}
  1195→
  1196→/**
  1197→ * Load all spec items from the project.
  1198→ * Parses manifest, follows includes, and builds unified collection.
  1199→ */
  1200→export async function loadAllItems(
  1201→  ctx: KspecContext,
  1202→): Promise<LoadedSpecItem[]> {
  1203→  const items: LoadedSpecItem[] = [];
  1204→
  1205→  if (!ctx.manifest || !ctx.manifestPath) {
  1206→    return items;
  1207→  }
  1208→
  1209→  const manifestDir = path.dirname(ctx.manifestPath);
  1210→
  1211→  // Extract items from manifest itself (inline modules/features/etc)
  1212→  const manifestItems = extractItemsFromRaw(ctx.manifest, ctx.manifestPath);
  1213→  items.push(...manifestItems);
  1214→
  1215→  // Process includes
  1216→  const includes = ctx.manifest.includes || [];
  1217→
  1218→  for (const include of includes) {
  1219→    const expandedPaths = await expandIncludePattern(include, manifestDir);
  1220→
  1221→    for (const filePath of expandedPaths) {
  1222→      const fileItems = await loadSpecFile(filePath);
  1223→      items.push(...fileItems);
  1224→    }
  1225→  }
  1226→
  1227→  return items;
  1228→}
  1229→
  1230→/**
  1231→ * Find a spec item by reference (ULID, slug, or short reference)
  1232→ */
  1233→export function findItemByRef(
  1234→  items: LoadedSpecItem[],
  1235→  ref: string,
  1236→): LoadedSpecItem | undefined {
  1237→  // Remove @ prefix if present
  1238→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1239→
  1240→  return items.find((item) => {
  1241→    // Match full ULID
  1242→    if (item._ulid === cleanRef) return true;
  1243→
  1244→    // Match short ULID (prefix)
  1245→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  1246→      return true;
  1247→
  1248→    // Match slug
  1249→    if (item.slugs.includes(cleanRef)) return true;
  1250→
  1251→    return false;
  1252→  });
  1253→}
  1254→
  1255→/**
  1256→ * Combined item type for unified queries across tasks and spec items
  1257→ */
  1258→export type AnyLoadedItem = LoadedTask | LoadedSpecItem;
  1259→
  1260→/**
  1261→ * Find any item (task or spec item) by reference
  1262→ */
  1263→export function findAnyItemByRef(
  1264→  tasks: LoadedTask[],
  1265→  items: LoadedSpecItem[],
  1266→  ref: string,
  1267→): AnyLoadedItem | undefined {
  1268→  // Try tasks first (more commonly referenced)
  1269→  const task = findTaskByRef(tasks, ref);
  1270→  if (task) return task;
  1271→
  1272→  // Then try spec items
  1273→  return findItemByRef(items, ref);
  1274→}
  1275→
  1276→/**
  1277→ * Build a ReferenceIndex from context.
  1278→ * Loads all tasks and spec items, then builds the index.
  1279→ */
  1280→export async function buildReferenceIndex(ctx: KspecContext): Promise<{
  1281→  index: ReferenceIndex;
  1282→  tasks: LoadedTask[];
  1283→  items: LoadedSpecItem[];
  1284→}> {
  1285→  const tasks = await loadAllTasks(ctx);
  1286→  const items = await loadAllItems(ctx);
  1287→  const index = new ReferenceIndex(tasks, items);
  1288→  return { index, tasks, items };
  1289→}
  1290→
  1291→/**
  1292→ * Build both ReferenceIndex and ItemIndex from context.
  1293→ * Use this when you need query capabilities in addition to reference resolution.
  1294→ * Pass plans for cross-namespace slug collision detection (plans aren't loaded by default
  1295→ * to avoid circular dependency with plans.ts).
  1296→ */
  1297→export async function buildIndexes(ctx: KspecContext, plans: LoadedPlan[] = []): Promise<{
  1298→  refIndex: ReferenceIndex;
  1299→  itemIndex: ItemIndex;
  1300→  traitIndex: TraitIndex;
  1301→  tasks: LoadedTask[];
  1302→  items: LoadedSpecItem[];
  1303→}> {
  1304→  const tasks = await loadAllTasks(ctx);
  1305→  const items = await loadAllItems(ctx);
  1306→  const refIndex = new ReferenceIndex(tasks, items, [], plans);
  1307→  const itemIndex = new ItemIndex(tasks, items);
  1308→  const traitIndex = new TraitIndex(items, refIndex);
  1309→  return { refIndex, itemIndex, traitIndex, tasks, items };
  1310→}
  1311→
  1312→// ============================================================
  1313→// SPEC ITEM CRUD (supports nested structures)
  1314→// ============================================================
  1315→
  1316→/**
  1317→ * Strip runtime metadata from spec item before serialization
  1318→ */
  1319→function stripSpecItemMetadata(item: LoadedSpecItem): SpecItem {
  1320→  const { _sourceFile, _path, ...cleanItem } = item;
  1321→  return cleanItem as SpecItem;
  1322→}
  1323→
  1324→/**
  1325→ * Parse a path string into segments.
  1326→ * e.g., "features[0].requirements[2]" -> [["features", 0], ["requirements", 2]]
  1327→ */
  1328→function parsePath(pathStr: string): Array<[string, number]> {
  1329→  const segments: Array<[string, number]> = [];
  1330→  const regex = /(\w+)\[(\d+)\]/g;
  1331→  let match;
  1332→  while ((match = regex.exec(pathStr)) !== null) {
  1333→    segments.push([match[1], parseInt(match[2], 10)]);
  1334→  }
  1335→  return segments;
  1336→}
  1337→
  1338→/**
  1339→ * Navigate to a location in a YAML structure using a path.
  1340→ * Returns the parent object and the array containing the target item.
  1341→ */
  1342→function navigateToPath(
  1343→  root: unknown,
  1344→  pathStr: string,
  1345→): { parent: Record<string, unknown>; array: unknown[]; index: number } | null {
  1346→  if (!pathStr) return null;
  1347→
  1348→  const segments = parsePath(pathStr);
  1349→  if (segments.length === 0) return null;
  1350→
  1351→  let current: unknown = root;
  1352→
  1353→  // Navigate to the parent of the last segment
  1354→  for (let i = 0; i < segments.length - 1; i++) {
  1355→    const [field, index] = segments[i];
  1356→    if (typeof current !== "object" || current === null) return null;
  1357→    const obj = current as Record<string, unknown>;
  1358→    if (!Array.isArray(obj[field])) return null;
  1359→    current = (obj[field] as unknown[])[index];
  1360→  }
  1361→
  1362→  // Get the final array and index
  1363→  const [finalField, finalIndex] = segments[segments.length - 1];
  1364→  if (typeof current !== "object" || current === null) return null;
  1365→  const parent = current as Record<string, unknown>;
  1366→  if (!Array.isArray(parent[finalField])) return null;
  1367→
  1368→  return {
  1369→    parent,
  1370→    array: parent[finalField] as unknown[],
  1371→    index: finalIndex,
  1372→  };
  1373→}
  1374→
  1375→/**
  1376→ * Find an item by ULID in a nested YAML structure.
  1377→ * Returns the path segments to reach it.
  1378→ */
  1379→function findItemInStructure(
  1380→  root: unknown,
  1381→  ulid: string,
  1382→  currentPath: string = "",
  1383→): { path: string; item: Record<string, unknown> } | null {
  1384→  if (!root || typeof root !== "object") return null;
  1385→
  1386→  const obj = root as Record<string, unknown>;
  1387→
  1388→  // Check if this is the item we're looking for
  1389→  if (obj._ulid === ulid) {
  1390→    return { path: currentPath, item: obj };
  1391→  }
  1392→
  1393→  // Search nested item fields
  1394→  for (const field of NESTED_ITEM_FIELDS) {
  1395→    if (Array.isArray(obj[field])) {
  1396→      const arr = obj[field] as unknown[];
  1397→      for (let i = 0; i < arr.length; i++) {
  1398→        const nestedPath = currentPath
  1399→          ? `${currentPath}.${field}[${i}]`
  1400→          : `${field}[${i}]`;
  1401→        const result = findItemInStructure(arr[i], ulid, nestedPath);
  1402→        if (result) return result;
  1403→      }
  1404→    }
  1405→  }
  1406→
  1407→  return null;
  1408→}
  1409→
  1410→/**
  1411→ * Create a new spec item with auto-generated fields
  1412→ */
  1413→export function createSpecItem(input: SpecItemInput): SpecItem {
  1414→  return {
  1415→    _ulid: input._ulid || ulid(),
  1416→    slugs: input.slugs || [],
  1417→    title: input.title,
  1418→    type: input.type,
  1419→    status: input.status,
  1420→    priority: input.priority,
  1421→    tags: input.tags || [],
  1422→    description: input.description,
  1423→    acceptance_criteria: input.acceptance_criteria,
  1424→    depends_on: input.depends_on || [],
  1425→    implements: input.implements || [],
  1426→    relates_to: input.relates_to || [],
  1427→    tests: input.tests || [],
  1428→    traits: input.traits || [],
  1429→    notes: input.notes || [],
  1430→    created: input.created || new Date().toISOString(),
  1431→    created_by: input.created_by,
  1432→  };
  1433→}
  1434→
  1435→/**
  1436→ * Map from item type to the field name used to store children of that type.
  1437→ */
  1438→const TYPE_TO_CHILD_FIELD: Record<string, string> = {
  1439→  feature: "features",
  1440→  requirement: "requirements",
  1441→  constraint: "constraints",
  1442→  decision: "decisions",
  1443→  module: "modules",
  1444→  trait: "traits",
  1445→};
  1446→
  1447→/**
  1448→ * Add a spec item as a child of a parent item.
  1449→ * @param parent The parent item to add under
  1450→ * @param child The new child item to add
  1451→ * @param childField Optional field name override (defaults based on child.type)
  1452→ */
  1453→export async function addChildItem(
  1454→  _ctx: KspecContext,
  1455→  parent: LoadedSpecItem,
  1456→  child: SpecItem,
  1457→  childField?: string,
  1458→): Promise<{ item: SpecItem; path: string }> {
  1459→  if (!parent._sourceFile) {
  1460→    throw new Error("Parent item has no source file");
  1461→  }
  1462→
  1463→  const field =
  1464→    childField || TYPE_TO_CHILD_FIELD[child.type || "feature"] || "features";
  1465→
  1466→  // Load the raw YAML
  1467→  const raw = await readYamlFile<unknown>(parent._sourceFile);
  1468→
  1469→  // Find the parent in the structure
  1470→  let parentObj: Record<string, unknown>;
  1471→  let parentPath: string;
  1472→
  1473→  if (parent._path) {
  1474→    const nav = navigateToPath(raw, parent._path);
  1475→    if (!nav) {
  1476→      throw new Error(`Could not navigate to parent path: ${parent._path}`);
  1477→    }
  1478→    parentObj = nav.array[nav.index] as Record<string, unknown>;
  1479→    parentPath = parent._path;
  1480→  } else {
  1481→    // Parent is the root item
  1482→    parentObj = raw as Record<string, unknown>;
  1483→    parentPath = "";
  1484→  }
  1485→
  1486→  // Ensure the child field array exists
  1487→  if (!Array.isArray(parentObj[field])) {
  1488→    parentObj[field] = [];
  1489→  }
  1490→
  1491→  // Add the child
  1492→  const childArray = parentObj[field] as unknown[];
  1493→  const cleanChild = stripSpecItemMetadata(child as LoadedSpecItem);
  1494→  childArray.push(cleanChild);
  1495→
  1496→  // Calculate the new child's path
  1497→  const childIndex = childArray.length - 1;
  1498→  const childPath = parentPath
  1499→    ? `${parentPath}.${field}[${childIndex}]`
  1500→    : `${field}[${childIndex}]`;
  1501→
  1502→  // Write back with format preservation
  1503→  await writeYamlFilePreserveFormat(parent._sourceFile, raw);
  1504→
  1505→  return { item: cleanChild, path: childPath };
  1506→}
  1507→
  1508→/**
  1509→ * Update a spec item in place within its source file.
  1510→ * Works with nested structures using the _path field.
  1511→ */
  1512→export async function updateSpecItem(
  1513→  _ctx: KspecContext,
  1514→  item: LoadedSpecItem,
  1515→  updates: Partial<SpecItemInput>,
  1516→): Promise<SpecItem> {
  1517→  if (!item._sourceFile) {
  1518→    throw new Error("Item has no source file");
  1519→  }
  1520→
  1521→  // Load the raw YAML
  1522→  const raw = await readYamlFile<unknown>(item._sourceFile);
  1523→
  1524→  // Find the item in the structure (use stored path or search by ULID)
  1525→  let targetObj: Record<string, unknown>;
  1526→
  1527→  if (item._path) {
  1528→    const nav = navigateToPath(raw, item._path);
  1529→    if (!nav) {
  1530→      throw new Error(`Could not navigate to path: ${item._path}`);
  1531→    }
  1532→    targetObj = nav.array[nav.index] as Record<string, unknown>;
  1533→  } else {
  1534→    // Item might be the root, or we need to find it
  1535→    const found = findItemInStructure(raw, item._ulid);
  1536→    if (found) {
  1537→      targetObj = found.item;
  1538→    } else if ((raw as Record<string, unknown>)._ulid === item._ulid) {
  1539→      targetObj = raw as Record<string, unknown>;
  1540→    } else {
  1541→      throw new Error(`Could not find item ${item._ulid} in structure`);
  1542→    }
  1543→  }
  1544→
  1545→  // Apply updates (but never change _ulid)
  1546→  for (const [key, value] of Object.entries(updates)) {
  1547→    if (key !== "_ulid" && key !== "_sourceFile" && key !== "_path") {
  1548→      targetObj[key] = value;
  1549→    }
  1550→  }
  1551→
  1552→  // Write back with format preservation
  1553→  await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1554→
  1555→  return { ...item, ...updates, _ulid: item._ulid } as SpecItem;
  1556→}
  1557→
  1558→/**
  1559→ * Check if an item is a trait with implementors.
  1560→ * Returns array of items that use this trait via the 'traits' field.
  1561→ */
  1562→export function findTraitImplementors(
  1563→  trait: LoadedSpecItem,
  1564→  allItems: LoadedSpecItem[],
  1565→): LoadedSpecItem[] {
  1566→  // Check if the item is actually a trait
  1567→  if (trait.type !== "trait") {
  1568→    return [];
  1569→  }
  1570→
  1571→  // Find all items that reference this trait in their 'traits' array
  1572→  const traitRefs = [`@${trait._ulid}`, ...trait.slugs.map((s) => `@${s}`)];
  1573→  return allItems.filter((item) => {
  1574→    if (!item.traits || item.traits.length === 0) return false;
  1575→    return item.traits.some((traitRef: string) => traitRefs.includes(traitRef));
  1576→  });
  1577→}
  1578→
  1579→/**
  1580→ * Delete a spec item from its source file.
  1581→ * Works with nested structures using the _path field.
  1582→ */
  1583→export async function deleteSpecItem(
  1584→  _ctx: KspecContext,
  1585→  item: LoadedSpecItem,
  1586→): Promise<boolean> {
  1587→  if (!item._sourceFile) {
  1588→    return false;
  1589→  }
  1590→
  1591→  try {
  1592→    const raw = await readYamlFile<unknown>(item._sourceFile);
  1593→
  1594→    // If item has a path, navigate to it and remove from parent array
  1595→    if (item._path) {
  1596→      const nav = navigateToPath(raw, item._path);
  1597→      if (!nav) {
  1598→        return false;
  1599→      }
  1600→      // Remove the item from the array
  1601→      nav.array.splice(nav.index, 1);
  1602→      await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1603→      return true;
  1604→    }
  1605→
  1606→    // No path - try to find it by ULID
  1607→    const found = findItemInStructure(raw, item._ulid);
  1608→    if (found?.path) {
  1609→      const nav = navigateToPath(raw, found.path);
  1610→      if (nav) {
  1611→        nav.array.splice(nav.index, 1);
  1612→        await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1613→        return true;
  1614→      }
  1615→    }
  1616→
  1617→    // Maybe it's a root-level array item
  1618→    if (Array.isArray(raw)) {
  1619→      const index = raw.findIndex(
  1620→        (i: unknown) =>
  1621→          typeof i === "object" &&
  1622→          i !== null &&
  1623→          (i as Record<string, unknown>)._ulid === item._ulid,
  1624→      );
  1625→      if (index >= 0) {
  1626→        raw.splice(index, 1);
  1627→        await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1628→        return true;
  1629→      }
  1630→    }
  1631→
  1632→    return false;
  1633→  } catch {
  1634→    return false;
  1635→  }
  1636→}
  1637→
  1638→/**
  1639→ * Save a spec item - either updates existing or adds to parent.
  1640→ * For new items, use addChildItem instead.
  1641→ */
  1642→export async function saveSpecItem(
  1643→  ctx: KspecContext,
  1644→  item: LoadedSpecItem,
  1645→): Promise<void> {
  1646→  // If item has a source file and path, it's an update
  1647→  if (item._sourceFile && item._path) {
  1648→    await updateSpecItem(ctx, item, item);
  1649→    return;
  1650→  }
  1651→
  1652→  // Otherwise, this is more complex - would need a parent
  1653→  throw new Error(
  1654→    "Cannot save new item without parent. Use addChildItem instead.",
  1655→  );
  1656→}
  1657→
  1658→// ============================================================
  1659→// INBOX SYSTEM
  1660→// ============================================================
  1661→
  1662→/**
  1663→ * Inbox item with runtime metadata for source tracking.
  1664→ */
  1665→export interface LoadedInboxItem extends InboxItem {
  1666→  _sourceFile?: string;
  1667→}
  1668→
  1669→/**
  1670→ * Get the inbox file path.
  1671→ *
  1672→ * When shadow enabled: .kspec/project.inbox.yaml
  1673→ * Otherwise: spec/project.inbox.yaml
  1674→ */
  1675→export function getInboxFilePath(ctx: KspecContext): string {
  1676→  return path.join(ctx.specDir, "project.inbox.yaml");
  1677→}
  1678→
  1679→/**
  1680→ * Load all inbox items from the project.
  1681→ */
  1682→export async function loadInboxItems(
  1683→  ctx: KspecContext,
  1684→): Promise<LoadedInboxItem[]> {
  1685→  const inboxPath = getInboxFilePath(ctx);
  1686→
  1687→  try {
  1688→    const raw = await readYamlFile<unknown>(inboxPath);
  1689→
  1690→    // Handle { inbox: [...] } format
  1691→    if (raw && typeof raw === "object" && "inbox" in raw) {
  1692→      const parsed = InboxFileSchema.safeParse(raw);
  1693→      if (parsed.success) {
  1694→        return parsed.data.inbox.map((item) => ({
  1695→          ...item,
  1696→          _sourceFile: inboxPath,
  1697→        }));
  1698→      }
  1699→    }
  1700→
  1701→    // Handle plain array format
  1702→    if (Array.isArray(raw)) {
  1703→      const items: LoadedInboxItem[] = [];
  1704→      for (const item of raw) {
  1705→        const result = InboxItemSchema.safeParse(item);
  1706→        if (result.success) {
  1707→          items.push({ ...result.data, _sourceFile: inboxPath });
  1708→        }
  1709→      }
  1710→      return items;
  1711→    }
  1712→
  1713→    return [];
  1714→  } catch {
  1715→    // File doesn't exist or parse error
  1716→    return [];
  1717→  }
  1718→}
  1719→
  1720→/**
  1721→ * Create a new inbox item with auto-generated fields.
  1722→ *
  1723→ * AC: @config-author — supports config author in fallback chain
  1724→ *
  1725→ * @param input Inbox item input
  1726→ * @param configAuthor Optional author from kspec.config.yaml identity.author
  1727→ */
  1728→export function createInboxItem(
  1729→  input: InboxItemInput,
  1730→  configAuthor?: string | null,
  1731→): InboxItem {
  1732→  return {
  1733→    _ulid: input._ulid || ulid(),
  1734→    text: input.text,
  1735→    created_at: input.created_at || new Date().toISOString(),
  1736→    tags: input.tags || [],
  1737→    added_by: input.added_by ?? getAuthor(configAuthor),
  1738→  };
  1739→}
  1740→
  1741→/**
  1742→ * Strip runtime metadata before serialization.
  1743→ */
  1744→function stripInboxMetadata(item: LoadedInboxItem): InboxItem {
  1745→  const { _sourceFile, ...cleanItem } = item;
  1746→  return cleanItem as InboxItem;
  1747→}
  1748→
  1749→/**
  1750→ * Save an inbox item (add or update).
  1751→ */
  1752→export async function saveInboxItem(
  1753→  ctx: KspecContext,
  1754→  item: LoadedInboxItem,
  1755→): Promise<void> {
  1756→  const inboxPath = getInboxFilePath(ctx);
  1757→
  1758→  // Ensure directory exists
  1759→  const dir = path.dirname(inboxPath);
  1760→  await fs.mkdir(dir, { recursive: true });
  1761→
  1762→  // Load existing items
  1763→  let existingItems: InboxItem[] = [];
  1764→
  1765→  try {
  1766→    const raw = await readYamlFile<unknown>(inboxPath);
  1767→    if (raw && typeof raw === "object" && "inbox" in raw) {
  1768→      const parsed = InboxFileSchema.safeParse(raw);
  1769→      if (parsed.success) {
  1770→        existingItems = parsed.data.inbox;
  1771→      }
  1772→    } else if (Array.isArray(raw)) {
  1773→      for (const i of raw) {
  1774→        const result = InboxItemSchema.safeParse(i);
  1775→        if (result.success) {
  1776→          existingItems.push(result.data);
  1777→        }
  1778→      }
  1779→    }
  1780→  } catch {
  1781→    // File doesn't exist, start fresh
  1782→  }
  1783→
  1784→  const cleanItem = stripInboxMetadata(item);
  1785→
  1786→  // Update existing or add new
  1787→  const existingIndex = existingItems.findIndex((i) => i._ulid === item._ulid);
  1788→  if (existingIndex >= 0) {
  1789→    existingItems[existingIndex] = cleanItem;
  1790→  } else {
  1791→    existingItems.push(cleanItem);
  1792→  }
  1793→
  1794→  // Save with { inbox: [...] } format and format preservation
  1795→  await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  1796→}
  1797→
  1798→/**
  1799→ * Delete an inbox item by ULID.
  1800→ */
  1801→export async function deleteInboxItem(
  1802→  ctx: KspecContext,
  1803→  ulid: string,
  1804→): Promise<boolean> {
  1805→  const inboxPath = getInboxFilePath(ctx);
  1806→
  1807→  try {
  1808→    const raw = await readYamlFile<unknown>(inboxPath);
  1809→    let existingItems: InboxItem[] = [];
  1810→
  1811→    if (raw && typeof raw === "object" && "inbox" in raw) {
  1812→      const parsed = InboxFileSchema.safeParse(raw);
  1813→      if (parsed.success) {
  1814→        existingItems = parsed.data.inbox;
  1815→      }
  1816→    }
  1817→
  1818→    const index = existingItems.findIndex((i) => i._ulid === ulid);
  1819→    if (index < 0) {
  1820→      return false;
  1821→    }
  1822→
  1823→    existingItems.splice(index, 1);
  1824→    await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  1825→    return true;
  1826→  } catch {
  1827→    return false;
  1828→  }
  1829→}
  1830→
  1831→/**
  1832→ * Find an inbox item by reference (ULID or short ULID).
  1833→ */
  1834→export function findInboxItemByRef(
  1835→  items: LoadedInboxItem[],
  1836→  ref: string,
  1837→): LoadedInboxItem | undefined {
  1838→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1839→
  1840→  return items.find((item) => {
  1841→    // Match full ULID
  1842→    if (item._ulid === cleanRef) return true;
  1843→    // Match short ULID (prefix)
  1844→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  1845→      return true;
  1846→    return false;
  1847→  });
  1848→}
  1849→
  1850→// ============================================================
  1851→// TRIAGE SYSTEM
  1852→// ============================================================
  1853→
  1854→/**
  1855→ * Triage record with runtime metadata for source tracking.
  1856→ */
  1857→export interface LoadedTriageRecord extends TriageRecord {
  1858→  _sourceFile?: string;
  1859→}
  1860→
  1861→/**
  1862→ * Get the triage file path.
  1863→ * AC: @triage-record-schema ac-6
  1864→ *
  1865→ * When shadow enabled: .kspec/project.triage.yaml
  1866→ * Otherwise: spec/project.triage.yaml
  1867→ */
  1868→export function getTriageFilePath(ctx: KspecContext): string {
  1869→  return path.join(ctx.specDir, "project.triage.yaml");
  1870→}
  1871→
  1872→/**
  1873→ * Load all triage records from the project.
  1874→ * AC: @triage-record-schema ac-6, ac-7
  1875→ */
  1876→export async function loadTriageRecords(
  1877→  ctx: KspecContext,
  1878→): Promise<LoadedTriageRecord[]> {
  1879→  const triagePath = getTriageFilePath(ctx);
  1880→
  1881→  try {
  1882→    const raw = await readYamlFile<unknown>(triagePath);
  1883→
  1884→    // Handle { kynetic_triage: "1.0", triage: [...] } format
  1885→    if (raw && typeof raw === "object" && "triage" in raw) {
  1886→      const parsed = TriageFileSchema.safeParse(raw);
  1887→      if (parsed.success) {
  1888→        return parsed.data.triage.map((record) => ({
  1889→          ...record,
  1890→          _sourceFile: triagePath,
  1891→        }));
  1892→      }
  1893→    }
  1894→
  1895→    // Handle plain array format
  1896→    if (Array.isArray(raw)) {
  1897→      const records: LoadedTriageRecord[] = [];
  1898→      for (const item of raw) {
  1899→        const result = TriageRecordSchema.safeParse(item);
  1900→        if (result.success) {
  1901→          records.push({ ...result.data, _sourceFile: triagePath });
  1902→        }
  1903→      }
  1904→      return records;
  1905→    }
  1906→
  1907→    return [];
  1908→  } catch {
  1909→    // File doesn't exist or parse error
  1910→    return [];
  1911→  }
  1912→}
  1913→
  1914→/**
  1915→ * Strip runtime metadata before serialization.
  1916→ */
  1917→function stripTriageMetadata(record: LoadedTriageRecord): TriageRecord {
  1918→  const { _sourceFile, ...cleanRecord } = record;
  1919→  return cleanRecord as TriageRecord;
  1920→}
  1921→
  1922→/**
  1923→ * Save a triage record (add or update).
  1924→ * AC: @triage-record-schema ac-8 — upsert on inbox_ref (one record per inbox item)
  1925→ * AC: @triage-record-schema ac-9 — sets updated_at on every mutation
  1926→ */
  1927→export async function saveTriageRecord(
  1928→  ctx: KspecContext,
  1929→  record: LoadedTriageRecord,
  1930→): Promise<void> {
  1931→  const triagePath = getTriageFilePath(ctx);
  1932→
  1933→  // Ensure directory exists
  1934→  const dir = path.dirname(triagePath);
  1935→  await fs.mkdir(dir, { recursive: true });
  1936→
  1937→  // Load existing records
  1938→  let existingRecords: TriageRecord[] = [];
  1939→
  1940→  try {
  1941→    const raw = await readYamlFile<unknown>(triagePath);
  1942→    if (raw && typeof raw === "object" && "triage" in raw) {
  1943→      const parsed = TriageFileSchema.safeParse(raw);
  1944→      if (parsed.success) {
  1945→        existingRecords = parsed.data.triage;
  1946→      }
  1947→    } else if (Array.isArray(raw)) {
  1948→      for (const item of raw) {
  1949→        const result = TriageRecordSchema.safeParse(item);
  1950→        if (result.success) {
  1951→          existingRecords.push(result.data);
  1952→        }
  1953→      }
  1954→    }
  1955→  } catch {
  1956→    // File doesn't exist, start fresh
  1957→  }
  1958→
  1959→  const cleanRecord = stripTriageMetadata(record);
  1960→
  1961→  // AC: ac-9 — set updated_at on every mutation
  1962→  cleanRecord.updated_at = new Date().toISOString();
  1963→
  1964→  // AC: ac-8 — upsert: check for existing record by ULID first, then by inbox_ref
  1965→  const existingByUlid = existingRecords.findIndex(
  1966→    (r) => r._ulid === record._ulid,
  1967→  );
  1968→  if (existingByUlid >= 0) {
  1969→    existingRecords[existingByUlid] = cleanRecord;
  1970→  } else {
  1971→    // Check for existing record with same inbox_ref (uniqueness constraint)
  1972→    // Preserve existing identity (_ulid, created_at) when upserting by inbox_ref
  1973→    const existingByInboxRef = existingRecords.findIndex(
  1974→      (r) => r.inbox_ref === record.inbox_ref,
  1975→    );
  1976→    if (existingByInboxRef >= 0) {
  1977→      const existing = existingRecords[existingByInboxRef];
  1978→      existingRecords[existingByInboxRef] = {
  1979→        ...cleanRecord,
  1980→        _ulid: existing._ulid,
  1981→        created_at: existing.created_at,
  1982→      };
  1983→    } else {
  1984→      existingRecords.push(cleanRecord);
  1985→    }
  1986→  }
  1987→
  1988→  // Save with { kynetic_triage: "1.0", triage: [...] } format
  1989→  await writeYamlFilePreserveFormat(triagePath, {
  1990→    kynetic_triage: "1.0",
  1991→    triage: existingRecords,
  1992→  });
  1993→}
  1994→
  1995→/**
  1996→ * Find a triage record by reference (ULID or short ULID).
  1997→ */
  1998→export function findTriageRecordByRef(
  1999→  records: LoadedTriageRecord[],
  2000→  ref: string,
  2001→): LoadedTriageRecord | undefined {
  2002→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  2003→
  2004→  return records.find((record) => {
  2005→    // Match full ULID
  2006→    if (record._ulid === cleanRef) return true;
  2007→    // Match short ULID (prefix)
  2008→    if (record._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  2009→      return true;
  2010→    return false;
  2011→  });
  2012→}
  2013→
  2014→/**
  2015→ * Find a triage record by inbox item reference.
  2016→ * AC: @triage-record-schema ac-8 — lookup by inbox_ref for upsert
  2017→ */
  2018→export function findTriageRecordByInboxRef(
  2019→  records: LoadedTriageRecord[],
  2020→  inboxRef: string,
  2021→): LoadedTriageRecord | undefined {
  2022→  const cleanRef = inboxRef.startsWith("@") ? inboxRef.slice(1) : inboxRef;
  2023→
  2024→  return records.find((record) => record.inbox_ref === cleanRef);
  2025→}
  2026→
  2027→// ─── Patch Operations ────────────────────────────────────────────────────────
  2028→
  2029→/**
  2030→ * A single patch operation for bulk patching
  2031→ */
  2032→export interface PatchOperation {
  2033→  ref: string;
  2034→  data: Record<string, unknown>;
  2035→}
  2036→
  2037→/**
  2038→ * Result of a single patch operation
  2039→ */
  2040→export interface PatchResult {
  2041→  ref: string;
  2042→  status: "updated" | "skipped" | "error";
  2043→  ulid?: string;
  2044→  error?: string;
  2045→}
  2046→
  2047→/**
  2048→ * Result of a bulk patch operation
  2049→ */
  2050→export interface BulkPatchResult {
  2051→  results: PatchResult[];
  2052→  summary: {
  2053→    total: number;
  2054→    updated: number;
  2055→    failed: number;
  2056→    skipped: number;
  2057→  };
  2058→}
  2059→
  2060→/**
  2061→ * Options for patch operations
  2062→ */
  2063→export interface PatchOptions {
  2064→  allowUnknown?: boolean;
  2065→  dryRun?: boolean;
  2066→  failFast?: boolean;
  2067→}
  2068→
  2069→/**
  2070→ * Bulk patch spec items.
  2071→ * Resolves refs, validates data, applies patches.
  2072→ * Continues on error by default (use failFast to stop on first error).
  2073→ */
  2074→export async function patchSpecItems(
  2075→  ctx: KspecContext,
  2076→  refIndex: ReferenceIndex,
  2077→  items: LoadedSpecItem[],
  2078→  patches: PatchOperation[],
  2079→  options: PatchOptions = {},
  2080→): Promise<BulkPatchResult> {
  2081→  const results: PatchResult[] = [];
  2082→  let stopProcessing = false;
  2083→
  2084→  for (const patch of patches) {
  2085→    if (stopProcessing) {
  2086→      results.push({ ref: patch.ref, status: "skipped" });
  2087→      continue;
  2088→    }
  2089→
  2090→    // Resolve ref
  2091→    const resolved = refIndex.resolve(patch.ref);
  2092→    if (!resolved.ok) {
  2093→      const errorMsg =
  2094→        resolved.error === "not_found"
  2095→          ? `Item not found: ${patch.ref}`
  2096→          : resolved.error === "ambiguous"
  2097→            ? `Ambiguous ref: ${patch.ref}`
  2098→            : `Duplicate slug: ${patch.ref}`;
  2099→      results.push({ ref: patch.ref, status: "error", error: errorMsg });
  2100→      if (options.failFast) {
  2101→        stopProcessing = true;
  2102→      }
  2103→      continue;
  2104→    }
  2105→
  2106→    // Find the item
  2107→    const item = items.find((i) => i._ulid === resolved.ulid);
  2108→    if (!item) {
  2109→      // Ref resolved but it's not a spec item (might be a task)
  2110→      results.push({
  2111→        ref: patch.ref,
  2112→        status: "error",
  2113→        error: "Not a spec item",
  2114→      });
  2115→      if (options.failFast) {
  2116→        stopProcessing = true;
  2117→      }
  2118→      continue;
  2119→    }
  2120→
  2121→    // Dry run - just record what would happen
  2122→    if (options.dryRun) {
  2123→      results.push({ ref: patch.ref, status: "updated", ulid: item._ulid });
  2124→      continue;
  2125→    }
  2126→
  2127→    // Apply the patch
  2128→    try {
  2129→      await updateSpecItem(ctx, item, patch.data);
  2130→      results.push({ ref: patch.ref, status: "updated", ulid: item._ulid });
  2131→    } catch (err) {
  2132→      const errorMsg = err instanceof Error ? err.message : String(err);
  2133→      results.push({ ref: patch.ref, status: "error", error: errorMsg });
  2134→      if (options.failFast) {
  2135→        stopProcessing = true;
  2136→      }
  2137→    }
  2138→  }
  2139→
  2140→  return {
  2141→    results,
  2142→    summary: {
  2143→      total: patches.length,
  2144→      updated: results.filter((r) => r.status === "updated").length,
  2145→      failed: results.filter((r) => r.status === "error").length,
  2146→      skipped: results.filter((r) => r.status === "skipped").length,
  2147→    },
  2148→  };
  2149→}
  2150→