     1→import { execSync } from "node:child_process";
     2→import * as fs from "node:fs/promises";
     3→import * as path from "node:path";
     4→import { ulid } from "ulid";
     5→import * as YAML from "yaml";
     6→import {
     7→  InboxFileSchema,
     8→  type InboxItem,
     9→  type InboxItemInput,
    10→  InboxItemSchema,
    11→  type Manifest,
    12→  ManifestSchema,
    13→  type Note,
    14→  type SpecItem,
    15→  type SpecItemInput,
    16→  SpecItemSchema,
    17→  type Task,
    18→  type TaskInput,
    19→  TaskSchema,
    20→  TasksFileSchema,
    21→  TriageFileSchema,
    22→  type TriageRecord,
    23→  TriageRecordSchema,
    24→  type Todo,
    25→} from "../schema/index.js";
    26→import { errors } from "../strings/index.js";
    27→import { ItemIndex } from "./items.js";
    28→import type { LoadedPlan } from "./plans.js";
    29→import { ReferenceIndex } from "./refs.js";
    30→import {
    31→  detectRunningFromShadowWorktree,
    32→  detectShadow,
    33→  type ShadowConfig,
    34→  ShadowError,
    35→} from "./shadow.js";
    36→import {
    37→  loadProjectConfig,
    38→  type ResolvedKspecConfig,
    39→} from "./config.js";
