   467→describe("kspec triage export", () => {
   468→  // AC: @triage-cli-commands ac-13
   469→  // AC: @interactive-triage ac-2 (export captures full decision chain)
   470→  it("should output markdown context blocks with item text, action, reasoning", () => {
   471→    const inboxUlid = addInboxItem("Export context test");
   472→    recordTriage(inboxUlid, "promote", "export reasoning test");
   473→
   474→    const result = kspec("triage export --format context", tempDir);
   475→    expect(result.stdout).toContain("# Triage Decisions");
   476→    expect(result.stdout).toContain("Export context test");
   477→    expect(result.stdout).toContain("promote");
   478→    expect(result.stdout).toContain("export reasoning test");
   479→    expect(result.stdout).toContain("@test"); // decided_by
   480→  });
   481→
   482→  // AC: @triage-cli-commands ac-14
   483→  // AC: @trait-json-output ac-1
   484→  it("should output JSON array with full triage records", () => {
   485→    const inboxUlid = addInboxItem("Export JSON test");
   486→    recordTriage(inboxUlid, "defer", "JSON export test");
   487→
