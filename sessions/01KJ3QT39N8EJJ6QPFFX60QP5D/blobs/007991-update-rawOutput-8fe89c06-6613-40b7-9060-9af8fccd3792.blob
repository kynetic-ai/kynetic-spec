   653→  // AC: @trait-json-output ac-4
   654→  it("should use @ prefix consistently in references", () => {
   655→    const inboxUlid = addInboxItem("Ref prefix test");
   656→    const result = kspecJson<{ record: { evidence_refs: string[] } }>(
   657→      `triage record @${inboxUlid.slice(0, 8)} --action promote --reasoning "test" --evidence "@some-ref"`,
   658→      tempDir,
   659→    );
   660→    if (result.record.evidence_refs.length > 0) {
   661→      for (const ref of result.record.evidence_refs) {
