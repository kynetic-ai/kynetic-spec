   513→});
   514→
   515→describe("kspec triage start (interactive)", () => {
   516→  // AC: @triage-cli-commands ac-9
   517→  it("should show message when no untriaged items exist", () => {
   518→    const result = kspec("triage start", tempDir);
   519→    expect(result.stdout).toContain("No untriaged inbox items");
   520→  });
   521→
   522→  // AC: @triage-cli-commands ac-9
   523→  it("should skip already-triaged items and show correct count", () => {
   524→    const ulid1 = addInboxItem("Already triaged");
   525→    addInboxItem("Not yet triaged");
   526→    recordTriage(ulid1, "defer", "already done");
   527→
   528→    // Start interactive triage — with EOF on stdin, it will display but not record
   529→    // The key assertion is the count and which items are shown
   530→    const result = kspec(
   531→      "triage start",
   532→      tempDir,
   533→      { stdin: "skip\n" },
   534→    );
   535→    // Should show only 1 item to review (the untriaged one)
   536→    expect(result.stdout).toContain("1 item(s) to review");
   537→    // Should show the untriaged item text
   538→    expect(result.stdout).toContain("Not yet triaged");
   539→    // Should NOT show the already-triaged item
   540→    expect(result.stdout).not.toContain("Already triaged");
   541→  });
   542→
   543→  // AC: @triage-cli-commands ac-10 (partial — tests EOF preservation, not SIGINT)
   544→  it("should preserve records that were committed before input ends", () => {
   545→    addInboxItem("First item to triage");
   546→    addInboxItem("Second item to triage");
   547→
   548→    // Provide action+reasoning for first item, then skip second
   549→    // Each triage record is committed individually, so even if the process
   550→    // ends early, committed records are preserved
   551→    const result = kspec(
   552→      "triage start",
   553→      tempDir,
   554→      { stdin: "defer\nfirst item reasoning\nskip\n" },
   555→    );
   556→
   557→    // At least one record should have been created
   558→    const records = kspecJson<Array<{ status: string }>>(
   559→      "triage list",
   560→      tempDir,
   561→    );
   562→    expect(records.length).toBeGreaterThanOrEqual(1);
   563→    expect(records.some((r) => r.status === "triaged")).toBe(true);
   564→  });
   565→});
