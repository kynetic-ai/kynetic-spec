   639→describe("triage JSON output trait compliance", () => {
   640→  // AC: @trait-json-output ac-3
   641→  it("should return JSON error on failure in JSON mode", () => {
   642→    const result = kspec(
   643→      'triage record @NOTEXIST --action promote --reasoning "test" --json',
