   502→
   503→  // AC: @trait-error-guidance ac-1
   504→  it("should error on invalid format", () => {
   505→    const result = kspec(
   506→      "triage export --format invalid",
   507→      tempDir,
   508→      { expectFail: true },
   509→    );
   510→    expect(result.exitCode).toBe(4); // VALIDATION_FAILED
