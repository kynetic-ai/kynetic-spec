   869→// AC: @interactive-triage ac-1, ac-2 (end-to-end decision chain)
   870→describe("interactive triage system integration", () => {
   871→  it("should capture full decision chain: agent record → user override → act → export", () => {
   872→    // Step 1: Agent records initial triage decision
   873→    const inboxUlid = addInboxItem("Improve search performance");
   874→    const record = recordTriage(inboxUlid, "defer", "needs profiling first");
   875→
   876→    // Step 2: User overrides the agent decision
   877→    kspec(
   878→      `triage override @${record._ulid.slice(0, 8)} --action promote --reasoning "actually urgent, users complaining"`,
   879→      tempDir,
   880→    );
   881→
   882→    // Step 3: Execute the overridden action
   883→    kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   884→
   885→    // Step 4: Export and verify the full chain is captured in context output
   886→    const exported = kspec("triage export --format context", tempDir);
   887→    // Item text
   888→    expect(exported.stdout).toContain("Improve search performance");
   889→    // Current action (overridden)
   890→    expect(exported.stdout).toContain("promote");
   891→    // Original reasoning from agent
   892→    expect(exported.stdout).toContain("needs profiling first");
   893→    // Attribution — decided_by appears in export
   894→    expect(exported.stdout).toContain("Decided by:");
   895→    // Override reasoning and attribution in export
   896→    expect(exported.stdout).toContain("actually urgent, users complaining");
   897→    expect(exported.stdout).toContain("Override:");
   898→    // Execution timestamp in export
   899→    expect(exported.stdout).toContain("Acted at:");
   900→    // Result ref in export
   901→    expect(exported.stdout).toContain("Result:");
   902→  });
   903→
   904→  // AC: @interactive-triage ac-1 (records survive inbox item deletion)
   905→  it("should preserve triage records after inbox item is deleted", () => {
   906→    const inboxUlid = addInboxItem("Ephemeral item");
   907→    const record = recordTriage(inboxUlid, "delete", "duplicate content");
   908→
   909→    // Act on it (deletes the inbox item)
   910→    kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   911→
   912→    // Verify inbox item is gone
   913→    const inbox = kspecJson<Array<{ _ulid: string }>>("inbox list", tempDir);
   914→    expect(inbox.find((i) => i._ulid === inboxUlid)).toBeUndefined();
   915→
   916→    // Verify triage record still exists with snapshot
   917→    const triageRecord = kspecJson<{
   918→      _ulid: string;
   919→      item_snapshot: string;
   920→      status: string;
   921→    }>(`triage get @${record._ulid.slice(0, 8)}`, tempDir);
   922→    expect(triageRecord.item_snapshot).toBe("Ephemeral item");
   923→    expect(triageRecord.status).toBe("acted_on");
   924→  });
   925→});
