   754→
   755→  // AC: @trait-dry-run ac-3
   756→  it("should clearly indicate dry-run is a preview", () => {
   757→    const inboxUlid = addInboxItem("Dry run preview test");
   758→    const record = recordTriage(inboxUlid, "promote", "test");
