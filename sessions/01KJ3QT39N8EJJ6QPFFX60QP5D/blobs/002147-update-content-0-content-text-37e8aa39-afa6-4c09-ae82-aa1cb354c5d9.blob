   189→    recordTriage(ulid1, "promote", "test");
   190→
   191→    const records = kspecJson<Array<{ _ulid: string; status: string }>>(
   192→      "triage list",
   193→      tempDir,
   194→    );
   195→    expect(Array.isArray(records)).toBe(true);
   196→    expect(records.length).toBe(1);
   197→    expect(records[0]._ulid).toBeDefined();
   198→  });
   199→
   200→  it("should show empty message when no records exist", () => {
   201→    const result = kspec("triage list", tempDir);
   202→    expect(result.stdout).toContain("No triage records");
   203→  });
   204→});
