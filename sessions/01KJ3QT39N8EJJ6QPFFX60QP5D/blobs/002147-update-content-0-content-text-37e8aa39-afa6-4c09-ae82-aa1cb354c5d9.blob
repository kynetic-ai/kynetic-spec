   450→describe("kspec triage start (interactive)", () => {
   451→  // AC: @triage-cli-commands ac-9
   452→  it("should show message when no untriaged items exist", () => {
   453→    const result = kspec("triage start", tempDir);
   454→    expect(result.stdout).toContain("No untriaged inbox items");
   455→  });
   456→
   457→  // AC: @triage-cli-commands ac-9
   458→  it("should skip already-triaged items and show correct count", () => {
   459→    const ulid1 = addInboxItem("Already triaged");
   460→    addInboxItem("Not yet triaged");
   461→    recordTriage(ulid1, "defer", "already done");
   462→
   463→    // Start interactive triage — with EOF on stdin, it will display but not record
   464→    // The key assertion is the count and which items are shown
   465→    const result = kspec(
   466→      "triage start",
   467→      tempDir,
   468→      { stdin: "skip\n" },
   469→    );
   470→    // Should show only 1 item to review (the untriaged one)
   471→    expect(result.stdout).toContain("1 item(s) to review");
   472→    // Should show the untriaged item text
   473→    expect(result.stdout).toContain("Not yet triaged");
   474→    // Should NOT show the already-triaged item
   475→    expect(result.stdout).not.toContain("Already triaged");
   476→  });
   477→
   478→  // AC: @triage-cli-commands ac-10
   479→  it("should preserve records that were committed before input ends", () => {
   480→    addInboxItem("First item to triage");
   481→    addInboxItem("Second item to triage");
   482→
   483→    // Provide action+reasoning for first item, then skip second
   484→    // Each triage record is committed individually, so even if the process
   485→    // ends early, committed records are preserved
   486→    const result = kspec(
   487→      "triage start",
   488→      tempDir,
   489→      { stdin: "defer\nfirst item reasoning\nskip\n" },
   490→    );
   491→
   492→    // At least one record should have been created
   493→    const records = kspecJson<Array<{ status: string }>>(
   494→      "triage list",
   495→      tempDir,
   496→    );
   497→    expect(records.length).toBeGreaterThanOrEqual(1);
   498→    expect(records.some((r) => r.status === "triaged")).toBe(true);
   499→  });
   500→});
