   206→describe("kspec triage act", () => {
   207→  // AC: @triage-cli-commands ac-4
   208→  it("should execute promote action creating a task from snapshot", () => {
   209→    const inboxUlid = addInboxItem("Create this as a task");
   210→    const record = recordTriage(inboxUlid, "promote", "clear feature");
   211→
   212→    const result = kspec(
   213→      `triage act @${record._ulid.slice(0, 8)}`,
   214→      tempDir,
   215→    );
   216→    expect(result.stdout).toContain("Acted on triage record");
   217→    expect(result.stdout).toContain("promote");
   218→
   219→    // Verify record transitioned to acted_on
   220→    const records = kspecJson<Array<{ _ulid: string; status: string; acted_at: string; result_ref: string }>>(
   221→      "triage list",
   222→      tempDir,
   223→    );
   224→    const acted = records.find((r) => r._ulid === record._ulid);
   225→    expect(acted).toBeDefined();
   226→    expect(acted!.status).toBe("acted_on");
   227→    expect(acted!.acted_at).toBeDefined();
   228→    expect(acted!.result_ref).toBeDefined();
   229→  });
   230→
   231→  // AC: @triage-cli-commands ac-5
   232→  it("should execute delete action removing inbox item", () => {
   233→    const inboxUlid = addInboxItem("Delete this item");
   234→    const record = recordTriage(inboxUlid, "delete", "not needed");
   235→
   236→    kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   237→
   238→    // Verify inbox item was deleted
   239→    const inboxResult = kspecJson<Array<{ _ulid: string }>>(
   240→      "inbox list",
   241→      tempDir,
   242→    );
   243→    const found = inboxResult.find((item) => item._ulid === inboxUlid);
   244→    expect(found).toBeUndefined();
   245→  });
   246→
   247→  // AC: @triage-cli-commands ac-6
   248→  it("should execute defer action with no side effects", () => {
   249→    const inboxUlid = addInboxItem("Defer this item");
   250→    const record = recordTriage(inboxUlid, "defer", "not ready yet");
   251→
   252→    kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   253→
   254→    // Verify record transitioned to acted_on
   255→    const records = kspecJson<Array<{ _ulid: string; status: string }>>(
   256→      "triage list",
   257→      tempDir,
   258→    );
   259→    const acted = records.find((r) => r._ulid === record._ulid);
   260→    expect(acted!.status).toBe("acted_on");
   261→
   262→    // Inbox item should still exist
   263→    const inboxResult = kspecJson<Array<{ _ulid: string }>>(
   264→      "inbox list",
   265→      tempDir,
   266→    );
   267→    const inboxItem = inboxResult.find((item) => item._ulid === inboxUlid);
   268→    expect(inboxItem).toBeDefined();
   269→  });
   270→
   271→  // AC: @triage-cli-commands ac-7
   272→  it("should execute spec-gap action creating an observation", () => {
   273→    const inboxUlid = addInboxItem("Spec gap identified here");
   274→    const record = recordTriage(inboxUlid, "spec-gap", "needs spec review");
   275→
   276→    const result = kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   277→    expect(result.stdout).toContain("Acted on triage record");
   278→
   279→    // Verify record has result_ref
   280→    const records = kspecJson<Array<{ _ulid: string; status: string; result_ref: string }>>(
   281→      "triage list",
   282→      tempDir,
   283→    );
   284→    const acted = records.find((r) => r._ulid === record._ulid);
   285→    expect(acted!.status).toBe("acted_on");
   286→    expect(acted!.result_ref).toBeDefined();
