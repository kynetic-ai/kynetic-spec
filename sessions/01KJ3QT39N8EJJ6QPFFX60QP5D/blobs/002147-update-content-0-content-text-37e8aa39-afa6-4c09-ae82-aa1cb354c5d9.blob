   288→
   289→  // AC: @triage-cli-commands ac-8
   290→  it("should execute duplicate action deleting inbox item", () => {
   291→    const inboxUlid = addInboxItem("This is a duplicate");
   292→    const record = recordTriage(inboxUlid, "duplicate", "duplicate of existing item");
   293→
   294→    kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   295→
   296→    // Verify inbox item was deleted
   297→    const inboxResult = kspecJson<Array<{ _ulid: string }>>(
   298→      "inbox list",
   299→      tempDir,
   300→    );
   301→    const found = inboxResult.find((item) => item._ulid === inboxUlid);
   302→    expect(found).toBeUndefined();
   303→
   304→    // Verify record is acted_on
   305→    const records = kspecJson<Array<{ _ulid: string; status: string }>>(
   306→      "triage list",
   307→      tempDir,
   308→    );
   309→    const acted = records.find((r) => r._ulid === record._ulid);
   310→    expect(acted!.status).toBe("acted_on");
   311→  });
   312→
   313→  // AC: @triage-cli-commands ac-15
   314→  // AC: @trait-error-guidance ac-1
   315→  it("should error when acting on already acted_on record", () => {
   316→    const inboxUlid = addInboxItem("Already acted on");
   317→    const record = recordTriage(inboxUlid, "defer", "defer it");
   318→
   319→    // Act once
   320→    kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   321→
   322→    // Try to act again
   323→    const result = kspec(
   324→      `triage act @${record._ulid.slice(0, 8)}`,
