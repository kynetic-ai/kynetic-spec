   137→describe("kspec triage list", () => {
   138→  // AC: @triage-cli-commands ac-2
   139→  it("should display records with ULID prefix, snapshot, status, action, decided_by, and relative time", () => {
   140→    const inboxUlid = addInboxItem("Test list display");
   141→    recordTriage(inboxUlid, "promote", "test display");
   142→
   143→    const result = kspec("triage list", tempDir);
   144→    expect(result.stdout).toContain("triaged");
   145→    expect(result.stdout).toContain("[promote]");
   146→    expect(result.stdout).toContain("Test list display");
   147→    expect(result.stdout).toContain("@test"); // decided_by
   148→  });
   149→
   150→  // AC: @triage-cli-commands ac-3
   151→  it("should filter records by status", () => {
   152→    const ulid1 = addInboxItem("Item pending");
   153→    const ulid2 = addInboxItem("Item triaged");
   154→    recordTriage(ulid2, "promote", "promote it");
   155→
   156→    // Pending filter should find no records (we created triaged records)
   157→    const pending = kspecJson<Array<{ status: string }>>(
   158→      "triage list --status pending",
   159→      tempDir,
   160→    );
   161→    expect(pending.length).toBe(0);
   162→
   163→    // Triaged filter should find one record
   164→    const triaged = kspecJson<Array<{ status: string }>>(
   165→      "triage list --status triaged",
   166→      tempDir,
   167→    );
   168→    expect(triaged.length).toBe(1);
   169→    expect(triaged[0].status).toBe("triaged");
   170→  });
   171→
   172→  // AC: @trait-filterable-list ac-8
   173→  it("should support --count flag to show only count", () => {
   174→    const ulid1 = addInboxItem("Count test 1");
   175→    const ulid2 = addInboxItem("Count test 2");
   176→    recordTriage(ulid1, "promote", "promote");
   177→    recordTriage(ulid2, "defer", "defer");
   178→
   179→    const result = kspecJson<{ count: number }>(
   180→      "triage list --count",
   181→      tempDir,
   182→    );
