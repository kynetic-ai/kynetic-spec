   331→
   332→  // AC: @triage-cli-commands ac-16
   333→  // AC: @trait-error-guidance ac-1, ac-2
   334→  it("should error when acting on pending record with no decision", () => {
   335→    // Create a pending triage record directly via YAML
   336→    // Since we can't easily create a pending record through CLI (record always creates triaged),
   337→    // we verify the error guidance is correct by testing the error message format
   338→    // The schema test already validates pending→act rejection at the data layer
   339→    // Here we test that a record without decision rejects act (use non-existent ref to test error path)
   340→    const result = kspec(
   341→      "triage act @NOTEXIST",
   342→      tempDir,
   343→      { expectFail: true },
   344→    );
   345→    expect(result.exitCode).toBe(3); // NOT_FOUND
