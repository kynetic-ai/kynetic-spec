   502→describe("kspec triage get", () => {
   503→  it("should display full triage record details", () => {
   504→    const inboxUlid = addInboxItem("Get test item");
   505→    const record = recordTriage(inboxUlid, "promote", "get test reasoning");
   506→
   507→    const result = kspec(
   508→      `triage get @${record._ulid.slice(0, 8)}`,
   509→      tempDir,
   510→    );
   511→    expect(result.stdout).toContain(record._ulid);
   512→    expect(result.stdout).toContain("promote");
   513→    expect(result.stdout).toContain("get test reasoning");
   514→    expect(result.stdout).toContain("Get test item");
   515→  });
   516→
   517→  // AC: @trait-json-output ac-1, ac-2
   518→  it("should output full record as JSON", () => {
   519→    const inboxUlid = addInboxItem("Get JSON test");
   520→    const record = recordTriage(inboxUlid, "defer", "json get test");
   521→
   522→    const jsonResult = kspecJson<{ _ulid: string; status: string; action: string; reasoning: string; item_snapshot: string }>(
   523→      `triage get @${record._ulid.slice(0, 8)}`,
   524→      tempDir,
   525→    );
   526→    expect(jsonResult._ulid).toBe(record._ulid);
   527→    expect(jsonResult.status).toBe("triaged");
   528→    expect(jsonResult.action).toBe("defer");
