   490→/**
   491→ * Create or update a triage record
   492→ * AC: @interactive-triage-ui ac-3
   493→ */
   494→export async function createTriageRecord(data: {
   495→	inbox_ref: string;
   496→	action: string;
   497→	reasoning: string;
   498→	decided_by?: string;
   499→	evidence_refs?: string[];
   500→}): Promise<{ success: boolean; record: TriageRecord }> {
   501→	assertWritable('create triage record');
   502→
   503→	const response = await fetch(`${API_BASE}/api/triage`, {
   504→		method: 'POST',
   505→		headers: {
   506→			'Content-Type': 'application/json',
   507→			...getProjectHeaders()
   508→		},
   509→		body: JSON.stringify(data)
   510→	});
   511→	if (!response.ok) {
   512→		await handleResponseError(response);
   513→	}
   514→
   515→	return response.json();
   516→}
   517→
