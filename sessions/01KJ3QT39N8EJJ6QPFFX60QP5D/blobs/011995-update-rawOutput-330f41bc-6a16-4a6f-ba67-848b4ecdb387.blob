   455→/**
   456→ * Fetch triage records with optional filters
   457→ * AC: @interactive-triage-ui ac-1, ac-2, ac-7
   458→ */
   459→export async function fetchTriageRecords(params?: {
   460→	status?: string;
   461→	action?: string;
   462→	limit?: number;
   463→	offset?: number;
   464→}): Promise<PaginatedResponse<TriageRecord>> {
   465→	// AC: @interactive-triage-ui ac-8 - Static mode: read-only triage data
   466→	if (isStaticMode()) {
   467→		return fetchTriageRecordsStatic(params);
   468→	}
   469→
   470→	const url = new URL(`${API_BASE}/api/triage`);
   471→
   472→	if (params) {
   473→		Object.entries(params).forEach(([key, value]) => {
   474→			if (value !== undefined && value !== '') {
   475→				url.searchParams.set(key, String(value));
   476→			}
   477→		});
   478→	}
   479→
   480→	const response = await fetch(url.toString(), {
   481→		headers: getProjectHeaders()
   482→	});
   483→	if (!response.ok) {
   484→		await handleResponseError(response);
   485→	}
   486→
   487→	return response.json();
   488→}
