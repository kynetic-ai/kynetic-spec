   425→/**
   426→ * Search across all entities
   427→ * AC: @web-dashboard ac-24
   428→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   429→ * AC: @gh-pages-export ac-11 - Static mode support
   430→ */
   431→export async function search(query: string): Promise<SearchResponse> {
   432→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   433→	if (isStaticMode()) {
   434→		return searchStatic(query);
   435→	}
   436→
   437→	const url = new URL(`${API_BASE}/api/search`);
   438→	url.searchParams.set('q', query);
   439→
   440→	const response = await fetch(url.toString(), {
   441→		headers: getProjectHeaders()
   442→	});
   443→	if (!response.ok) {
   444→		await handleResponseError(response);
   445→	}
   446→
   447→	return response.json();
   448→}
