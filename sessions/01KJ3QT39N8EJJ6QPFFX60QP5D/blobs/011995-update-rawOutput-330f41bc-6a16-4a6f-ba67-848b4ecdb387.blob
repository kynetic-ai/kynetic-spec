   364→/**
   365→ * Fetch session context
   366→ * AC: @web-dashboard ac-20
   367→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   368→ * AC: @gh-pages-export ac-11 - Static mode support
   369→ */
   370→export async function fetchSessionContext(): Promise<SessionContext> {
   371→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   372→	if (isStaticMode()) {
   373→		const session = fetchSessionContextStatic();
   374→		if (!session) {
   375→			return { focus: null, threads: [], open_questions: [], updated_at: new Date().toISOString() };
   376→		}
   377→		return session;
   378→	}
   379→
   380→	const response = await fetch(`${API_BASE}/api/meta/session`, {
   381→		headers: getProjectHeaders()
   382→	});
   383→	if (!response.ok) {
   384→		await handleResponseError(response);
   385→	}
   386→
   387→	return response.json();
   388→}
