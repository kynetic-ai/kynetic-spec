     1→/**
     2→ * API Client
     3→ *
     4→ * Helper functions for making requests to the kspec daemon API.
     5→ * Supports both daemon mode (live) and static mode (read-only JSON).
     6→ *
     7→ * AC Coverage:
     8→ * - ac-26 (@multi-directory-daemon): X-Kspec-Dir header injection
     9→ * - ac-36 (@multi-directory-daemon): Invalid project error detection
    10→ * - ac-11 (@gh-pages-export): Mode-aware API dispatch
    11→ * - ac-18 (@gh-pages-export): Graceful no-op for write operations
    12→ */
    13→
    14→import type {
    15→	TaskSummary,
    16→	TaskDetail,
    17→	ItemSummary,
    18→	ItemDetail,
    19→	InboxItem,
    20→	SessionContext,
    21→	Observation,
    22→	PaginatedResponse,
    23→	ErrorResponse,
    24→	SearchResponse
    25→} from '@kynetic-ai/shared';
    26→import type { TriageRecord } from './types/triage';
    27→import {
    28→	getSelectedProjectPath,
    29→	clearInvalidSelection,
    30→	isInvalidProjectError,
    31→	type Project
    32→} from './stores/project.svelte';
    33→import { isStaticMode, assertWritable } from './stores/mode.svelte';
    34→import {
    35→	fetchTasksStatic,
    36→	fetchTaskStatic,
    37→	fetchItemsStatic,
    38→	fetchItemStatic,
    39→	fetchItemTasksStatic,
    40→	fetchInboxStatic,
    41→	fetchSessionContextStatic,
    42→	fetchObservationsStatic,
    43→	searchStatic,
    44→	fetchTriageRecordsStatic
    45→} from './api-static';
    46→import { DAEMON_API_BASE } from './constants';
    47→
    48→const API_BASE = DAEMON_API_BASE;
    49→
    50→/**
    51→ * Get headers for API requests, including X-Kspec-Dir if project is selected
    52→ * AC: @multi-directory-daemon ac-26
    53→ */
    54→function getProjectHeaders(): HeadersInit {
    55→	const path = getSelectedProjectPath();
    56→	return path ? { 'X-Kspec-Dir': path } : {};
    57→}
    58→
    59→/**
    60→ * Handle response errors, detecting invalid project errors
    61→ * AC: @multi-directory-daemon ac-36
    62→ */
    63→async function handleResponseError(response: Response): Promise<never> {
    64→	const error: ErrorResponse = await response.json();
    65→	const message = error.message || error.error;
    66→
    67→	// Check if this is an invalid project error
    68→	if (isInvalidProjectError(response, message)) {
    69→		clearInvalidSelection();
    70→	}
    71→
    72→	throw new Error(message);
    73→}
    74→
    75→/**
    76→ * Fetch registered projects
    77→ * AC: @multi-directory-daemon ac-25, ac-28
    78→ */
    79→export async function fetchProjects(): Promise<{ projects: Project[] }> {
    80→	const response = await fetch(`${API_BASE}/api/projects`);
    81→	if (!response.ok) {
    82→		await handleResponseError(response);
    83→	}
    84→	return response.json();
    85→}
    86→
    87→/**
    88→ * Fetch tasks with optional filters
    89→ * AC: @web-dashboard ac-9, ac-10
    90→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
    91→ * AC: @gh-pages-export ac-11 - Static mode support
    92→ */
    93→export async function fetchTasks(params?: {
    94→	status?: string;
    95→	type?: string;
    96→	tag?: string;
    97→	assignee?: string;
    98→	automation?: string;
    99→	limit?: number;
   100→	offset?: number;
   101→}): Promise<PaginatedResponse<TaskSummary>> {
   102→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   103→	if (isStaticMode()) {
   104→		return fetchTasksStatic(params);
   105→	}
   106→
   107→	const url = new URL(`${API_BASE}/api/tasks`);
   108→
   109→	if (params) {
   110→		Object.entries(params).forEach(([key, value]) => {
   111→			if (value !== undefined && value !== '') {
   112→				url.searchParams.set(key, String(value));
   113→			}
   114→		});
   115→	}
   116→
   117→	const response = await fetch(url.toString(), {
   118→		headers: getProjectHeaders()
   119→	});
   120→	if (!response.ok) {
   121→		await handleResponseError(response);
   122→	}
   123→
   124→	return response.json();
   125→}
   126→
   127→/**
   128→ * Fetch single task by reference
   129→ * AC: @web-dashboard ac-5
   130→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   131→ * AC: @gh-pages-export ac-12 - Static mode deep linking
   132→ */
   133→export async function fetchTask(ref: string): Promise<TaskDetail> {
   134→	// AC: @gh-pages-export ac-12 - Use static data in static mode
   135→	if (isStaticMode()) {
   136→		const task = fetchTaskStatic(ref);
   137→		if (!task) {
   138→			throw new Error(`Task not found: ${ref}`);
   139→		}
   140→		return task;
   141→	}
   142→
   143→	const response = await fetch(`${API_BASE}/api/tasks/${ref}`, {
   144→		headers: getProjectHeaders()
   145→	});
   146→	if (!response.ok) {
   147→		await handleResponseError(response);
   148→	}
   149→
   150→	return response.json();
   151→}
   152→
   153→/**
   154→ * Start a task (change status to in_progress)
   155→ * AC: @web-dashboard ac-7
   156→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   157→ * AC: @gh-pages-export ac-16, ac-18 - Disabled in static mode
   158→ */
   159→export async function startTask(ref: string): Promise<void> {
   160→	// AC: @gh-pages-export ac-16, ac-18 - Write operations throw in static mode
   161→	assertWritable('start task');
   162→
   163→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/start`, {
   164→		method: 'POST',
   165→		headers: getProjectHeaders()
   166→	});
   167→	if (!response.ok) {
   168→		await handleResponseError(response);
   169→	}
   170→}
   171→
   172→/**
   173→ * Add a note to a task
   174→ * AC: @web-dashboard ac-8
   175→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   176→ * AC: @gh-pages-export ac-18 - Disabled in static mode
   177→ */
   178→export async function addTaskNote(ref: string, content: string): Promise<void> {
   179→	// AC: @gh-pages-export ac-18 - Write operations throw in static mode
   180→	assertWritable('add note');
   181→
   182→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/note`, {
   183→		method: 'POST',
   184→		headers: {
   185→			'Content-Type': 'application/json',
   186→			...getProjectHeaders()
   187→		},
   188→		body: JSON.stringify({ content })
   189→	});
   190→	if (!response.ok) {
   191→		await handleResponseError(response);
   192→	}
   193→}
   194→
   195→/**
   196→ * Fetch spec items with optional filters
   197→ * AC: @web-dashboard ac-11
   198→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   199→ * AC: @gh-pages-export ac-11 - Static mode support
   200→ */
   201→export async function fetchItems(params?: {
   202→	type?: string | string[];
   203→	tag?: string;
   204→	limit?: number;
   205→	offset?: number;
   206→}): Promise<PaginatedResponse<ItemSummary>> {
   207→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   208→	if (isStaticMode()) {
   209→		return fetchItemsStatic(params);
   210→	}
   211→
   212→	const url = new URL(`${API_BASE}/api/items`);
   213→
   214→	if (params) {
   215→		Object.entries(params).forEach(([key, value]) => {
   216→			if (value !== undefined && value !== '') {
   217→				if (Array.isArray(value)) {
   218→					value.forEach((v) => url.searchParams.append(key, String(v)));
   219→				} else {
   220→					url.searchParams.set(key, String(value));
   221→				}
   222→			}
   223→		});
   224→	}
   225→
   226→	const response = await fetch(url.toString(), {
   227→		headers: getProjectHeaders()
   228→	});
   229→	if (!response.ok) {
   230→		await handleResponseError(response);
   231→	}
   232→
   233→	return response.json();
   234→}
   235→
   236→/**
   237→ * Fetch single spec item by reference
   238→ * AC: @web-dashboard ac-12
   239→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   240→ * AC: @gh-pages-export ac-13 - Static mode deep linking
   241→ */
   242→export async function fetchItem(ref: string): Promise<ItemDetail> {
   243→	// AC: @gh-pages-export ac-13 - Use static data in static mode
   244→	if (isStaticMode()) {
   245→		const item = fetchItemStatic(ref);
   246→		if (!item) {
   247→			throw new Error(`Item not found: ${ref}`);
   248→		}
   249→		return item;
   250→	}
   251→
   252→	const response = await fetch(`${API_BASE}/api/items/${ref}`, {
   253→		headers: getProjectHeaders()
   254→	});
   255→	if (!response.ok) {
   256→		await handleResponseError(response);
   257→	}
   258→
   259→	return response.json();
   260→}
