   499→describe("kspec triage start (interactive)", () => {
   500→  // AC: @triage-cli-commands ac-9
   501→  it("should show message when no untriaged items exist", () => {
   502→    const result = kspec("triage start", tempDir);
   503→    expect(result.stdout).toContain("No untriaged inbox items");
   504→  });
   505→
   506→  // AC: @triage-cli-commands ac-9
   507→  it("should skip already-triaged items and show correct count", () => {
   508→    const ulid1 = addInboxItem("Already triaged");
   509→    addInboxItem("Not yet triaged");
   510→    recordTriage(ulid1, "defer", "already done");
   511→
   512→    // Start interactive triage — with EOF on stdin, it will display but not record
   513→    // The key assertion is the count and which items are shown
   514→    const result = kspec(
   515→      "triage start",
   516→      tempDir,
   517→      { stdin: "skip\n" },
   518→    );
   519→    // Should show only 1 item to review (the untriaged one)
   520→    expect(result.stdout).toContain("1 item(s) to review");
   521→    // Should show the untriaged item text
   522→    expect(result.stdout).toContain("Not yet triaged");
   523→    // Should NOT show the already-triaged item
   524→    expect(result.stdout).not.toContain("Already triaged");
   525→  });
   526→
   527→  // AC: @triage-cli-commands ac-10
   528→  it("should preserve records that were committed before input ends", () => {
   529→    addInboxItem("First item to triage");
   530→    addInboxItem("Second item to triage");
   531→
   532→    // Provide action+reasoning for first item, then skip second
   533→    // Each triage record is committed individually, so even if the process
   534→    // ends early, committed records are preserved
   535→    const result = kspec(
   536→      "triage start",
   537→      tempDir,
   538→      { stdin: "defer\nfirst item reasoning\nskip\n" },
   539→    );
   540→
   541→    // At least one record should have been created
   542→    const records = kspecJson<Array<{ status: string }>>(
   543→      "triage list",
   544→      tempDir,
   545→    );
   546→    expect(records.length).toBeGreaterThanOrEqual(1);
   547→    expect(records.some((r) => r.status === "triaged")).toBe(true);
   548→  });
   549→});
   550→
   551→describe("kspec triage get", () => {
   552→  it("should display full triage record details", () => {
   553→    const inboxUlid = addInboxItem("Get test item");
   554→    const record = recordTriage(inboxUlid, "promote", "get test reasoning");
   555→
   556→    const result = kspec(
   557→      `triage get @${record._ulid.slice(0, 8)}`,
   558→      tempDir,
   559→    );
   560→    expect(result.stdout).toContain(record._ulid);
   561→    expect(result.stdout).toContain("promote");
   562→    expect(result.stdout).toContain("get test reasoning");
   563→    expect(result.stdout).toContain("Get test item");
   564→  });
   565→
   566→  // AC: @trait-json-output ac-1, ac-2
   567→  it("should output full record as JSON", () => {
   568→    const inboxUlid = addInboxItem("Get JSON test");
   569→    const record = recordTriage(inboxUlid, "defer", "json get test");
   570→
   571→    const jsonResult = kspecJson<{ _ulid: string; status: string; action: string; reasoning: string; item_snapshot: string }>(
   572→      `triage get @${record._ulid.slice(0, 8)}`,
   573→      tempDir,
   574→    );
   575→    expect(jsonResult._ulid).toBe(record._ulid);
   576→    expect(jsonResult.status).toBe("triaged");
   577→    expect(jsonResult.action).toBe("defer");
   578→    expect(jsonResult.reasoning).toBe("json get test");
   579→    expect(jsonResult.item_snapshot).toBe("Get JSON test");
   580→  });
   581→
   582→  // AC: @trait-error-guidance ac-1
   583→  it("should error when triage record not found", () => {
   584→    const result = kspec(
   585→      "triage get @NOTEXIST",
   586→      tempDir,
   587→      { expectFail: true },
   588→    );
   589→    expect(result.exitCode).toBe(3); // NOT_FOUND
   590→    expect(result.stderr).toContain("not found");
   591→  });
   592→});
   593→
   594→describe("kspec triage shadow commits", () => {
   595→  // AC: @trait-shadow-commit ac-1
   596→  it("should commit to shadow branch on record creation", () => {
   597→    const inboxUlid = addInboxItem("Shadow commit test");
   598→    recordTriage(inboxUlid, "promote", "shadow test");
   599→
   600→    // Verify the triage file exists
   601→    const records = kspecJson<Array<{ _ulid: string }>>(
   602→      "triage list",
   603→      tempDir,
   604→    );
   605→    expect(records.length).toBe(1);
   606→  });
   607→
   608→  it("should commit to shadow branch on act", () => {
   609→    const inboxUlid = addInboxItem("Shadow act test");
   610→    const record = recordTriage(inboxUlid, "defer", "shadow act");
   611→
   612→    kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   613→
   614→    // Verify the change was persisted
   615→    const records = kspecJson<Array<{ _ulid: string; status: string }>>(
   616→      "triage list",
   617→      tempDir,
   618→    );
   619→    expect(records[0].status).toBe("acted_on");
   620→  });
   621→});
   622→
   623→describe("triage JSON output trait compliance", () => {
   624→  // AC: @trait-json-output ac-3
   625→  it("should return JSON error on failure in JSON mode", () => {
   626→    const result = kspec(
   627→      'triage record @NOTEXIST --action promote --reasoning "test" --json',
   628→      tempDir,
   629→      { expectFail: true },
   630→    );
   631→    // stderr should contain JSON error
   632→    const errorJson = JSON.parse(result.stderr);
   633→    expect(errorJson.success).toBe(false);
   634→    expect(errorJson.error).toBeDefined();
   635→  });
   636→
   637→  // AC: @trait-json-output ac-4
   638→  it("should use @ prefix consistently in references", () => {
   639→    const inboxUlid = addInboxItem("Ref prefix test");
   640→    const result = kspecJson<{ record: { evidence_refs: string[] } }>(
   641→      `triage record @${inboxUlid.slice(0, 8)} --action promote --reasoning "test" --evidence "@some-ref"`,
   642→      tempDir,
   643→    );
   644→    if (result.record.evidence_refs.length > 0) {
   645→      for (const ref of result.record.evidence_refs) {
   646→        expect(ref.startsWith("@")).toBe(true);
   647→      }
   648→    }
   649→  });
   650→
   651→  // AC: @trait-json-output ac-6
   652→  it("should use --json over other format options", () => {
   653→    const inboxUlid = addInboxItem("Format precedence test");
   654→    const result = kspec(
   655→      `triage record @${inboxUlid.slice(0, 8)} --action defer --reasoning "test" --json`,
   656→      tempDir,
   657→    );
   658→    // Output should be valid JSON
   659→    expect(() => JSON.parse(result.stdout)).not.toThrow();
   660→  });
   661→});
