   241→describe("kspec triage act", () => {
   242→  // AC: @triage-cli-commands ac-4
   243→  it("should execute promote action creating a task from snapshot", () => {
   244→    const inboxUlid = addInboxItem("Create this as a task");
   245→    const record = recordTriage(inboxUlid, "promote", "clear feature");
   246→
   247→    const result = kspec(
   248→      `triage act @${record._ulid.slice(0, 8)}`,
   249→      tempDir,
   250→    );
   251→    expect(result.stdout).toContain("Acted on triage record");
   252→    expect(result.stdout).toContain("promote");
   253→
   254→    // Verify record transitioned to acted_on
   255→    const records = kspecJson<Array<{ _ulid: string; status: string; acted_at: string; result_ref: string }>>(
   256→      "triage list",
   257→      tempDir,
   258→    );
   259→    const acted = records.find((r) => r._ulid === record._ulid);
   260→    expect(acted).toBeDefined();
   261→    expect(acted!.status).toBe("acted_on");
   262→    expect(acted!.acted_at).toBeDefined();
   263→    expect(acted!.result_ref).toBeDefined();
   264→  });
   265→
   266→  // AC: @triage-cli-commands ac-5
   267→  it("should execute delete action removing inbox item", () => {
   268→    const inboxUlid = addInboxItem("Delete this item");
   269→    const record = recordTriage(inboxUlid, "delete", "not needed");
   270→
   271→    kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   272→
   273→    // Verify inbox item was deleted
   274→    const inboxResult = kspecJson<Array<{ _ulid: string }>>(
   275→      "inbox list",
   276→      tempDir,
   277→    );
   278→    const found = inboxResult.find((item) => item._ulid === inboxUlid);
   279→    expect(found).toBeUndefined();
   280→  });
   281→
   282→  // AC: @triage-cli-commands ac-6
   283→  it("should execute defer action with no side effects", () => {
   284→    const inboxUlid = addInboxItem("Defer this item");
   285→    const record = recordTriage(inboxUlid, "defer", "not ready yet");
   286→
   287→    kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   288→
   289→    // Verify record transitioned to acted_on
   290→    const records = kspecJson<Array<{ _ulid: string; status: string }>>(
   291→      "triage list",
   292→      tempDir,
   293→    );
   294→    const acted = records.find((r) => r._ulid === record._ulid);
   295→    expect(acted!.status).toBe("acted_on");
   296→
   297→    // Inbox item should still exist
   298→    const inboxResult = kspecJson<Array<{ _ulid: string }>>(
   299→      "inbox list",
   300→      tempDir,
   301→    );
   302→    const inboxItem = inboxResult.find((item) => item._ulid === inboxUlid);
   303→    expect(inboxItem).toBeDefined();
   304→  });
   305→
   306→  // AC: @triage-cli-commands ac-7
   307→  it("should execute spec-gap action creating an observation", () => {
   308→    const inboxUlid = addInboxItem("Spec gap identified here");
   309→    const record = recordTriage(inboxUlid, "spec-gap", "needs spec review");
   310→
   311→    const result = kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   312→    expect(result.stdout).toContain("Acted on triage record");
   313→
   314→    // Verify record has result_ref
   315→    const records = kspecJson<Array<{ _ulid: string; status: string; result_ref: string }>>(
   316→      "triage list",
   317→      tempDir,
   318→    );
   319→    const acted = records.find((r) => r._ulid === record._ulid);
   320→    expect(acted!.status).toBe("acted_on");
   321→    expect(acted!.result_ref).toBeDefined();
   322→  });
   323→
   324→  // AC: @triage-cli-commands ac-8
   325→  it("should execute duplicate action deleting inbox item", () => {
   326→    const inboxUlid = addInboxItem("This is a duplicate");
   327→    const record = recordTriage(inboxUlid, "duplicate", "duplicate of existing item");
   328→
   329→    kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   330→
   331→    // Verify inbox item was deleted
   332→    const inboxResult = kspecJson<Array<{ _ulid: string }>>(
   333→      "inbox list",
   334→      tempDir,
   335→    );
   336→    const found = inboxResult.find((item) => item._ulid === inboxUlid);
   337→    expect(found).toBeUndefined();
   338→
   339→    // Verify record is acted_on
   340→    const records = kspecJson<Array<{ _ulid: string; status: string }>>(
   341→      "triage list",
   342→      tempDir,
   343→    );
   344→    const acted = records.find((r) => r._ulid === record._ulid);
   345→    expect(acted!.status).toBe("acted_on");
   346→  });
   347→
   348→  // AC: @triage-cli-commands ac-15
   349→  // AC: @trait-error-guidance ac-1
   350→  it("should error when acting on already acted_on record", () => {
   351→    const inboxUlid = addInboxItem("Already acted on");
   352→    const record = recordTriage(inboxUlid, "defer", "defer it");
   353→
   354→    // Act once
   355→    kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   356→
   357→    // Try to act again
   358→    const result = kspec(
   359→      `triage act @${record._ulid.slice(0, 8)}`,
   360→      tempDir,
   361→      { expectFail: true },
   362→    );
   363→    expect(result.exitCode).toBe(4); // VALIDATION_FAILED
   364→    expect(result.stderr).toContain("already been acted on");
   365→  });
   366→
   367→  // AC: @triage-cli-commands ac-16
   368→  // AC: @trait-error-guidance ac-1, ac-2
   369→  it("should error when acting on pending record with no decision", async () => {
   370→    // Create a pending triage record by writing directly to the triage YAML file
   371→    const pendingUlid = testUlid("PEND", 1);
   372→    const inboxUlid = testUlid("PEND", 2);
   373→    const triageData = {
   374→      kynetic_triage: "1.0",
   375→      triage: [{
   376→        _ulid: pendingUlid,
   377→        inbox_ref: inboxUlid,
   378→        item_snapshot: "A pending item",
   379→        status: "pending",
   380→        created_at: new Date().toISOString(),
   381→      }],
   382→    };
   383→    await fs.writeFile(
   384→      path.join(tempDir, "project.triage.yaml"),
   385→      yamlStringify(triageData),
   386→    );
   387→
   388→    const result = kspec(
   389→      `triage act @${pendingUlid.slice(0, 8)}`,
   390→      tempDir,
   391→      { expectFail: true },
   392→    );
   393→    expect(result.exitCode).toBe(4); // VALIDATION_FAILED
   394→    expect(result.stderr).toContain("no decision yet");
   395→    expect(result.stderr).toContain("kspec triage record");
   396→  });
   397→
   398→  // AC: @triage-cli-commands ac-17
   399→  // AC: @trait-dry-run ac-1
   400→  it("should show what would happen in dry-run mode", () => {
   401→    const inboxUlid = addInboxItem("Dry run test item");
   402→    const record = recordTriage(inboxUlid, "promote", "dry run test");
   403→
   404→    const result = kspec(
   405→      `triage act @${record._ulid.slice(0, 8)} --dry-run`,
