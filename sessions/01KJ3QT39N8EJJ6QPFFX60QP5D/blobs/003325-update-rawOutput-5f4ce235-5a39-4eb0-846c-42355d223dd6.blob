   193→    recordTriage(ulid1, "promote", "test");
   194→
   195→    const records = kspecJson<Array<{ _ulid: string; status: string }>>(
   196→      "triage list",
   197→      tempDir,
   198→    );
   199→    expect(Array.isArray(records)).toBe(true);
   200→    expect(records.length).toBe(1);
   201→    expect(records[0]._ulid).toBeDefined();
   202→  });
   203→
   204→  it("should show empty message when no records exist", () => {
   205→    const result = kspec("triage list", tempDir);
   206→    expect(result.stdout).toContain("No triage records");
   207→  });
   208→
   209→  // AC: @trait-filterable-list ac-4
   210→  it("should support --offset to skip first N results", () => {
   211→    const ulid1 = addInboxItem("Offset test 1");
   212→    const ulid2 = addInboxItem("Offset test 2");
   213→    const ulid3 = addInboxItem("Offset test 3");
   214→    recordTriage(ulid1, "promote", "first");
   215→    recordTriage(ulid2, "defer", "second");
   216→    recordTriage(ulid3, "delete", "third");
   217→
   218→    const all = kspecJson<Array<{ _ulid: string }>>("triage list", tempDir);
   219→    expect(all.length).toBe(3);
   220→
   221→    const offset1 = kspecJson<Array<{ _ulid: string }>>("triage list --offset 1", tempDir);
   222→    expect(offset1.length).toBe(2);
   223→
   224→    const offset2 = kspecJson<Array<{ _ulid: string }>>("triage list --offset 2", tempDir);
   225→    expect(offset2.length).toBe(1);
   226→  });
   227→
   228→  // AC: @trait-filterable-list ac-7
   229→  it("should show summary with total and filter state", () => {
   230→    const ulid1 = addInboxItem("Summary test 1");
   231→    const ulid2 = addInboxItem("Summary test 2");
   232→    recordTriage(ulid1, "promote", "promote it");
   233→    recordTriage(ulid2, "defer", "defer it");
   234→
   235→    const filtered = kspec("triage list --action promote", tempDir);
   236→    expect(filtered.stdout).toContain("1 of 2");
   237→    expect(filtered.stdout).toContain("action=promote");
   238→  });
   239→});
