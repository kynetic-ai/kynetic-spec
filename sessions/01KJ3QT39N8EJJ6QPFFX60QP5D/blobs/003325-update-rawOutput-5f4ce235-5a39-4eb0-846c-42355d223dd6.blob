   141→describe("kspec triage list", () => {
   142→  // AC: @triage-cli-commands ac-2
   143→  it("should display records with ULID prefix, snapshot, status, action, decided_by, and relative time", () => {
   144→    const inboxUlid = addInboxItem("Test list display");
   145→    recordTriage(inboxUlid, "promote", "test display");
   146→
   147→    const result = kspec("triage list", tempDir);
   148→    expect(result.stdout).toContain("triaged");
   149→    expect(result.stdout).toContain("[promote]");
   150→    expect(result.stdout).toContain("Test list display");
   151→    expect(result.stdout).toContain("@test"); // decided_by
   152→  });
   153→
   154→  // AC: @triage-cli-commands ac-3
   155→  it("should filter records by status", () => {
   156→    const ulid1 = addInboxItem("Item pending");
   157→    const ulid2 = addInboxItem("Item triaged");
   158→    recordTriage(ulid2, "promote", "promote it");
   159→
   160→    // Pending filter should find no records (we created triaged records)
   161→    const pending = kspecJson<Array<{ status: string }>>(
   162→      "triage list --status pending",
   163→      tempDir,
   164→    );
   165→    expect(pending.length).toBe(0);
   166→
   167→    // Triaged filter should find one record
   168→    const triaged = kspecJson<Array<{ status: string }>>(
   169→      "triage list --status triaged",
   170→      tempDir,
   171→    );
   172→    expect(triaged.length).toBe(1);
   173→    expect(triaged[0].status).toBe("triaged");
   174→  });
   175→
   176→  // AC: @trait-filterable-list ac-8
   177→  it("should support --count flag to show only count", () => {
   178→    const ulid1 = addInboxItem("Count test 1");
   179→    const ulid2 = addInboxItem("Count test 2");
   180→    recordTriage(ulid1, "promote", "promote");
   181→    recordTriage(ulid2, "defer", "defer");
   182→
   183→    const result = kspecJson<{ count: number }>(
   184→      "triage list --count",
   185→      tempDir,
   186→    );
   187→    expect(result.count).toBe(2);
   188→  });
   189→
   190→  // AC: @trait-json-output ac-1
   191→  it("should output records as valid JSON array", () => {
