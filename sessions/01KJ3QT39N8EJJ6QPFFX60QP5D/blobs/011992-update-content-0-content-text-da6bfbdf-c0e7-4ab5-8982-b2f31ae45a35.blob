```
     1→<script lang="ts">
     2→	// AC: @interactive-triage-ui ac-1, ac-2, ac-3, ac-4, ac-5, ac-6, ac-7, ac-8
     3→	// AC: @trait-websocket-protocol ac-1, ac-2, ac-3
     4→	import { onMount, onDestroy } from 'svelte';
     5→	import type { InboxItem, BroadcastEvent } from '@kynetic-ai/shared';
     6→	import type { TriageRecord, TriageAction } from '$lib/types/triage';
     7→	import {
     8→		fetchInbox,
     9→		fetchTriageRecords,
    10→		createTriageRecord,
    11→		overrideTriageRecord,
    12→		actOnTriageRecord
    13→	} from '$lib/api';
    14→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    15→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    16→	import { getProjectVersion } from '$lib/stores/project.svelte';
    17→	import { Button } from '$lib/components/ui/button';
    18→	import { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';
    19→	import { Badge } from '$lib/components/ui/badge';
    20→	import { Textarea } from '$lib/components/ui/textarea';
    21→	import { Separator } from '$lib/components/ui/separator';
    22→	import ChevronLeftIcon from '@lucide/svelte/icons/chevron-left';
    23→	import ChevronRightIcon from '@lucide/svelte/icons/chevron-right';
    24→
    25→	// Data state
    26→	let inboxItems = $state<InboxItem[]>([]);
    27→	let triageRecords = $state<TriageRecord[]>([]);
    28→	let loading = $state(true);
    29→	let error = $state('');
    30→
    31→	// Card navigation state
    32→	// AC: @interactive-triage-ui ac-5
    33→	let currentIndex = $state(0);
    34→	let submitting = $state(false);
    35→
    36→	// Form state
    37→	// AC: @interactive-triage-ui ac-3
    38→	let selectedAction = $state<TriageAction | ''>('');
    39→	let reasoning = $state('');
    40→
    41→	// Filter state
    42→	// AC: @interactive-triage-ui ac-7
    43→	let filterTag = $state<string | ''>('');
    44→	let filterStatus = $state<'all' | 'untriaged' | 'triaged' | 'acted_on'>('all');
    45→
    46→	// Action labels
    47→	const ACTION_LABELS: Record<TriageAction, string> = {
    48→		promote: 'Promote to Task',
    49→		delete: 'Delete',
    50→		defer: 'Defer',
    51→		'spec-gap': 'Spec Gap',
    52→		duplicate: 'Duplicate'
    53→	};
    54→
    55→	const ACTION_COLORS: Record<TriageAction, string> = {
    56→		promote: 'bg-green-500',
    57→		delete: 'bg-red-500',
    58→		defer: 'bg-yellow-500',
    59→		'spec-gap': 'bg-purple-500',
    60→		duplicate: 'bg-gray-500'
    61→	};
    62→
    63→	// Merged view: inbox items with their triage records
    64→	interface TriageCardItem {
    65→		inbox: InboxItem;
    66→		record: TriageRecord | null;
    67→	}
    68→
    69→	// AC: @interactive-triage-ui ac-7 - Filtered items
    70→	let allItems = $derived.by(() => {
    71→		const items: TriageCardItem[] = inboxItems.map((inbox) => {
    72→			const record = triageRecords.find((r) => r.inbox_ref === inbox._ulid) ?? null;
    73→			return { inbox, record };
    74→		});
    75→		return items;
    76→	});
    77→
    78→	let filteredItems = $derived.by(() => {
    79→		let items = allItems;
    80→
    81→		// Tag filter
    82→		if (filterTag) {
    83→			items = items.filter((i) => i.inbox.tags.includes(filterTag));
    84→		}
    85→
    86→		// Status filter
    87→		if (filterStatus === 'untriaged') {
    88→			items = items.filter((i) => !i.record || i.record.status === 'pending');
    89→		} else if (filterStatus === 'triaged') {
    90→			items = items.filter((i) => i.record?.status === 'triaged');
    91→		} else if (filterStatus === 'acted_on') {
    92→			items = items.filter((i) => i.record?.status === 'acted_on');
    93→		}
    94→
    95→		return items;
    96→	});
    97→
    98→	let currentItem = $derived(filteredItems[currentIndex] ?? null);
    99→
   100→	// AC: @interactive-triage-ui ac-7 - Progress count
   101→	let triagedCount = $derived(allItems.filter((i) => i.record && i.record.status !== 'pending').length);
   102→	let totalCount = $derived(allItems.length);
   103→
   104→	// All unique tags for filter
   105→	let allTags = $derived.by(() => {
   106→		const tagSet = new Set<string>();
   107→		inboxItems.forEach((item) => item.tags.forEach((t) => tagSet.add(t)));
   108→		return Array.from(tagSet).sort();
   109→	});
   110→
   111→	onMount(async () => {
   112→		await loadData();
   113→
   114→		// AC: @interactive-triage-ui ac-6 - Subscribe to triage:updates
   115→		// AC: @trait-websocket-protocol ac-2 - Subscribe to topic
   116→		if (!isStaticMode()) {
   117→			subscribe(['triage:updates']);
   118→			on('triage:updates', handleTriageUpdate);
   119→		}
   120→	});
   121→
   122→	onDestroy(() => {
   123→		if (!isStaticMode()) {
   124→			off('triage:updates', handleTriageUpdate);
   125→			unsubscribe(['triage:updates']);
   126→		}
   127→	});
   128→
   129→	// AC: @multi-directory-daemon ac-27 - Reload on project change
   130→	$effect(() => {
   131→		const version = getProjectVersion();
   132→		if (version > 0) {
   133→			loadData();
   134→		}
   135→	});
   136→
   137→	// AC: @interactive-triage-ui ac-6 - Real-time update handler
   138→	// AC: @trait-websocket-protocol ac-3 - Handle broadcast event
   139→	function handleTriageUpdate(_event: BroadcastEvent) {
   140→		// Reload triage records on any triage update
   141→		loadTriageData();
   142→	}
   143→
   144→	async function loadData() {
   145→		try {
   146→			loading = true;
   147→			error = '';
   148→			const [inboxResponse, triageResponse] = await Promise.all([
   149→				fetchInbox({ limit: 1000 }),
   150→				fetchTriageRecords({ limit: 1000 })
   151→			]);
   152→			inboxItems = inboxResponse.items;
   153→			triageRecords = triageResponse.items;
   154→		} catch (err) {
   155→			error = err instanceof Error ? err.message : 'Failed to load triage data';
   156→		} finally {
   157→			loading = false;
   158→		}
   159→	}
   160→
   161→	async function loadTriageData() {
   162→		try {
   163→			const triageResponse = await fetchTriageRecords({ limit: 1000 });
   164→			triageRecords = triageResponse.items;
   165→		} catch (err) {
   166→			console.error('Failed to reload triage records:', err);
   167→		}
   168→	}
   169→
   170→	// AC: @interactive-triage-ui ac-5 - Navigation
   171→	function goNext() {
   172→		if (currentIndex < filteredItems.length - 1) {
   173→			currentIndex++;
   174→			resetForm();
   175→		}
   176→	}
   177→
   178→	function goPrevious() {
   179→		if (currentIndex > 0) {
   180→			currentIndex--;
   181→			resetForm();
   182→		}
   183→	}
   184→
   185→	function resetForm() {
   186→		selectedAction = '';
   187→		reasoning = '';
   188→		error = '';
   189→	}
   190→
   191→	// Keyboard navigation
   192→	function handleKeydown(e: KeyboardEvent) {
   193→		if (e.key === 'ArrowLeft') {
   194→			goPrevious();
   195→		} else if (e.key === 'ArrowRight') {
   196→			goNext();
   197→		}
   198→	}
   199→
   200→	// AC: @interactive-triage-ui ac-3 - Submit triage decision
   201→	async function handleSubmit() {
   202→		if (!currentItem || !selectedAction || !reasoning.trim()) return;
   203→
   204→		if (isStaticMode()) {
   205→			error = 'Cannot submit triage decisions in read-only mode.';
   206→			return;
   207→		}
   208→
   209→		try {
   210→			submitting = true;
   211→			error = '';
   212→
   213→			const existing = currentItem.record;
   214→
   215→			if (existing && existing.status !== 'pending') {
   216→				// AC: @interactive-triage-ui ac-4 - Override existing decision
   217→				await overrideTriageRecord(existing._ulid, {
   218→					action: selectedAction,
   219→					reasoning: reasoning.trim()
   220→				});
   221→			} else {
   222→				// Create new triage record
   223→				await createTriageRecord({
   224→					inbox_ref: currentItem.inbox._ulid,
   225→					action: selectedAction,
   226→					reasoning: reasoning.trim()
   227→				});
   228→			}
   229→
   230→			// Reload triage data
   231→			await loadTriageData();
   232→
   233→			// Auto-advance to next item
   234→			// AC: @interactive-triage-ui ac-3 - advances to next item
   235→			if (currentIndex < filteredItems.length - 1) {
   236→				currentIndex++;
   237→			}
   238→			resetForm();
   239→		} catch (err) {
   240→			if (err instanceof ReadOnlyModeError) {
   241→				error = err.message;
   242→			} else {
   243→				error = err instanceof Error ? err.message : 'Failed to submit triage decision';
   244→			}
   245→		} finally {
   246→			submitting = false;
   247→		}
   248→	}
   249→
   250→	// Execute the triage action
   251→	async function handleAct() {
   252→		if (!currentItem?.record) return;
   253→
   254→		if (isStaticMode()) {
   255→			error = 'Cannot execute triage actions in read-only mode.';
   256→			return;
   257→		}
   258→
   259→		try {
   260→			submitting = true;
   261→			error = '';
   262→			await actOnTriageRecord(currentItem.record._ulid);
   263→			await loadTriageData();
   264→		} catch (err) {
   265→			if (err instanceof ReadOnlyModeError) {
   266→				error = err.message;
   267→			} else {
   268→				error = err instanceof Error ? err.message : 'Failed to execute triage action';
   269→			}
   270→		} finally {
   271→			submitting = false;
   272→		}
   273→	}
   274→
   275→	function formatDate(dateString: string): string {
   276→		const date = new Date(dateString);
   277→		const now = new Date();
   278→		const diffMs = now.getTime() - date.getTime();
   279→		const diffMins = Math.floor(diffMs / 60000);
   280→		const diffHours = Math.floor(diffMs / 3600000);
   281→		const diffDays = Math.floor(diffMs / 86400000);
   282→
   283→		if (diffMins < 1) return 'just now';
   284→		if (diffMins < 60) return `${diffMins}m ago`;
   285→		if (diffHours < 24) return `${diffHours}h ago`;
   286→		if (diffDays < 7) return `${diffDays}d ago`;
   287→
   288→		return date.toLocaleDateString();
   289→	}
   290→
   291→	// AC: @interactive-triage-ui ac-7 - Reset index when filter changes
   292→	$effect(() => {
   293→		// Track filter dependencies
   294→		filterTag;
   295→		filterStatus;
   296→		currentIndex = 0;
   297→		resetForm();
   298→	});
   299→</script>
   300→
   301→<svelte:window onkeydown={handleKeydown} />
   302→
   303→<!-- AC: @interactive-triage-ui ac-1, ac-5, ac-7 -->
   304→<div class="flex flex-col gap-4 p-6">
   305→	<div class="flex items-center justify-between">
   306→		<div>
   307→			<h1 class="text-3xl font-bold">Triage</h1>
   308→			{#if !loading}
   309→				<!-- AC: @interactive-triage-ui ac-7 - Progress count -->
   310→				<p class="text-muted-foreground" data-testid="triage-progress">
   311→					{triagedCount} of {totalCount} triaged
   312→					{#if filteredItems.length !== allItems.length}
   313→						&middot; Showing {filteredItems.length} filtered
   314→					{/if}
   315→				</p>
   316→			{/if}
   317→		</div>
   318→
   319→		<!-- AC: @interactive-triage-ui ac-7 - Filters -->
   320→		<div class="flex gap-2 items-center" data-testid="triage-filters">
   321→			<select
   322→				bind:value={filterStatus}
   323→				class="rounded-md border bg-background px-3 py-1.5 text-sm"
   324→				data-testid="triage-status-filter"
   325→			>
   326→				<option value="all">All</option>
   327→				<option value="untriaged">Untriaged</option>
   328→				<option value="triaged">Triaged</option>
   329→				<option value="acted_on">Acted On</option>
   330→			</select>
   331→			{#if allTags.length > 0}
   332→				<select
   333→					bind:value={filterTag}
   334→					class="rounded-md border bg-background px-3 py-1.5 text-sm"
   335→					data-testid="triage-tag-filter"
   336→				>
   337→					<option value="">All Tags</option>
   338→					{#each allTags as tag}
   339→						<option value={tag}>{tag}</option>
   340→					{/each}
   341→				</select>
   342→			{/if}
   343→		</div>
   344→	</div>
   345→
   346→	<!-- Progress bar -->
   347→	{#if totalCount > 0}
   348→		<div class="w-full bg-muted rounded-full h-2" data-testid="triage-progress-bar">
   349→			<div
   350→				class="bg-primary rounded-full h-2 transition-all duration-300"
   351→				style="width: {(triagedCount / totalCount) * 100}%"
   352→			></div>
   353→		</div>
   354→	{/if}
   355→
   356→	{#if error}
   357→		<div class="rounded-md bg-red-50 p-4 text-sm text-red-800 dark:bg-red-900/20 dark:text-red-200" data-testid="triage-error" role="alert">
   358→			{error}
   359→		</div>
   360→	{/if}
   361→
   362→	{#if loading}
   363→		<div class="text-center text-muted-foreground py-12">Loading triage data...</div>
   364→	{:else if filteredItems.length === 0}
   365→		<div class="text-center text-muted-foreground py-12">
   366→			{#if allItems.length === 0}
   367→				<p>No inbox items to triage.</p>
   368→				<p class="text-sm mt-1">Add items to your inbox first.</p>
   369→			{:else}
   370→				<p>No items match the current filters.</p>
   371→			{/if}
   372→		</div>
   373→	{:else if currentItem}
   374→		<!-- Card navigation -->
   375→		<div class="flex items-center justify-between mb-2">
   376→			<!-- AC: @interactive-triage-ui ac-5 - Navigation controls -->
   377→			<Button
   378→				variant="outline"
   379→				size="sm"
   380→				onclick={goPrevious}
   381→				disabled={currentIndex === 0}
   382→				data-testid="triage-prev"
   383→			>
   384→				<ChevronLeftIcon class="size-4 mr-1" />
   385→				Previous
   386→			</Button>
   387→			<span class="text-sm text-muted-foreground" data-testid="triage-position">
   388→				{currentIndex + 1} / {filteredItems.length}
   389→			</span>
   390→			<Button
   391→				variant="outline"
   392→				size="sm"
   393→				onclick={goNext}
   394→				disabled={currentIndex === filteredItems.length - 1}
   395→				data-testid="triage-next"
   396→			>
   397→				Next
   398→				<ChevronRightIcon class="size-4 ml-1" />
   399→			</Button>
   400→		</div>
   401→
   402→		<!-- AC: @interactive-triage-ui ac-1 - Card view showing item text, tags, age, added_by -->
   403→		<Card class="transition-all duration-200" data-testid="triage-card">
   404→			<CardHeader>
   405→				<div class="flex items-start justify-between gap-4">
   406→					<CardTitle class="text-lg leading-relaxed" data-testid="triage-card-text">
   407→						{currentItem.inbox.text}
   408→					</CardTitle>
   409→					<!-- AC: @interactive-triage-ui ac-5 - Show decision state on already-triaged items -->
   410→					{#if currentItem.record && currentItem.record.status !== 'pending'}
   411→						<Badge
   412→							class={currentItem.record.action ? ACTION_COLORS[currentItem.record.action] : 'bg-gray-500'}
   413→							data-testid="triage-card-status"
   414→						>
   415→							{currentItem.record.status === 'acted_on' ? 'Acted' : 'Triaged'}
   416→						</Badge>
   417→					{/if}
   418→				</div>
   419→				<!-- AC: @interactive-triage-ui ac-1 - tags, age, added_by -->
   420→				<div class="flex items-center gap-2 text-xs text-muted-foreground mt-2" data-testid="triage-card-meta">
   421→					<span data-testid="triage-card-age">{formatDate(currentItem.inbox.created_at)}</span>
   422→					<span>&middot;</span>
   423→					<span data-testid="triage-card-added-by">{currentItem.inbox.added_by}</span>
   424→					{#if currentItem.inbox.tags.length > 0}
   425→						<span>&middot;</span>
   426→						<div class="flex gap-1" data-testid="triage-card-tags">
   427→							{#each currentItem.inbox.tags as tag}
   428→								<Badge variant="secondary" class="text-xs">{tag}</Badge>
   429→							{/each}
   430→						</div>
   431→					{/if}
   432→				</div>
   433→			</CardHeader>
   434→			<CardContent>
   435→				<!-- AC: @interactive-triage-ui ac-2 - Show agent recommendation if exists -->
   436→				{#if currentItem.record && currentItem.record.status !== 'pending'}
   437→					<div class="rounded-md bg-muted p-4 mb-4" data-testid="triage-agent-recommendation">
   438→						<p class="text-sm font-medium mb-2">
   439→							{#if currentItem.record.override_by}
   440→								Override Decision
   441→							{:else}
   442→								Agent Recommendation
   443→							{/if}
   444→						</p>
   445→						<div class="space-y-1 text-sm">
   446→							<p data-testid="triage-rec-action">
   447→								<span class="font-medium">Action:</span>
   448→								{currentItem.record.action ? ACTION_LABELS[currentItem.record.action] : 'None'}
   449→							</p>
   450→							<p data-testid="triage-rec-reasoning">
   451→								<span class="font-medium">Reasoning:</span>
   452→								{currentItem.record.override_reasoning || currentItem.record.reasoning}
   453→							</p>
   454→							{#if currentItem.record.evidence_refs.length > 0}
   455→								<p data-testid="triage-rec-evidence">
   456→									<span class="font-medium">Evidence:</span>
   457→									{currentItem.record.evidence_refs.join(', ')}
   458→								</p>
   459→							{/if}
   460→							<p class="text-xs text-muted-foreground">
   461→								Decided by: {currentItem.record.override_by || currentItem.record.decided_by}
   462→							</p>
   463→						</div>
   464→					</div>
   465→				{/if}
   466→
   467→				<!-- AC: @interactive-triage-ui ac-8 - Hide action UI in static mode -->
   468→				{#if !isStaticMode()}
   469→					<Separator class="my-4" />
   470→
   471→					<!-- AC: @interactive-triage-ui ac-3, ac-4 - Action selection and reasoning -->
   472→					<div class="space-y-4" data-testid="triage-action-form">
   473→						<div>
   474→							<p class="text-sm font-medium mb-2">
   475→								{currentItem.record && currentItem.record.status !== 'pending' ? 'Override Action' : 'Select Action'}
   476→							</p>
   477→							<div class="flex flex-wrap gap-2" data-testid="triage-action-buttons">
   478→								{#each Object.entries(ACTION_LABELS) as [action, label]}
   479→									<Button
   480→										variant={selectedAction === action ? 'default' : 'outline'}
   481→										size="sm"
   482→										onclick={() => (selectedAction = action as TriageAction)}
   483→										data-testid="triage-action-{action}"
   484→									>
   485→										{label}
   486→									</Button>
   487→								{/each}
   488→							</div>
   489→						</div>
   490→
   491→						<div>
   492→							<p class="text-sm font-medium mb-2">Reasoning</p>
   493→							<Textarea
   494→								placeholder="Why are you choosing this action?"
   495→								bind:value={reasoning}
   496→								rows={3}
   497→								disabled={submitting}
   498→								data-testid="triage-reasoning"
   499→							/>
   500→						</div>
   501→
   502→						<div class="flex gap-2">
   503→							<Button
   504→								onclick={handleSubmit}
   505→								disabled={submitting || !selectedAction || !reasoning.trim()}
   506→								data-testid="triage-submit"
   507→							>
   508→								{#if submitting}
   509→									Submitting...
   510→								{:else if currentItem.record && currentItem.record.status !== 'pending'}
   511→									Override Decision
   512→								{:else}
   513→									Submit Decision
   514→								{/if}
   515→							</Button>
   516→
   517→							{#if currentItem.record?.status === 'triaged'}
   518→								<Button
   519→									variant="secondary"
   520→									onclick={handleAct}
   521→									disabled={submitting}
   522→									data-testid="triage-act"
   523→								>
   524→									{submitting ? 'Executing...' : `Execute: ${currentItem.record.action ? ACTION_LABELS[currentItem.record.action] : ''}`}
   525→								</Button>
   526→							{/if}
   527→						</div>
   528→					</div>
   529→				{:else}
   530→					<!-- AC: @interactive-triage-ui ac-8 - Static mode: browsing only -->
   531→					{#if !currentItem.record}
   532→						<p class="text-sm text-muted-foreground mt-4">
   533→							No triage decision recorded. Use the CLI or daemon to triage items.
   534→						</p>
   535→					{/if}
   536→				{/if}
   537→			</CardContent>
   538→		</Card>
   539→	{/if}
   540→</div>
