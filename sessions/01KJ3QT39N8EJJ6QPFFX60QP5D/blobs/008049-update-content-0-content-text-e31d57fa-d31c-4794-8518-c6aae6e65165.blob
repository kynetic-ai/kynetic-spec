```
     1→/**
     2→ * Kspec Daemon Server
     3→ *
     4→ * Elysia.js HTTP server with WebSocket support for real-time kspec state updates.
     5→ * Implements localhost-only security, file watching, and graceful shutdown.
     6→ */
     7→
     8→import { Elysia } from 'elysia';
     9→import { cors } from '@elysiajs/cors';
    10→import { staticPlugin } from '@elysiajs/static';
    11→import { ulid } from 'ulidx';
    12→import { existsSync } from 'fs';
    13→import { PubSubManager } from './websocket/pubsub';
    14→import { HeartbeatManager } from './websocket/heartbeat';
    15→import { WebSocketHandler } from './websocket/handler';
    16→import type { ConnectionData, ConnectedEvent } from './websocket/types';
    17→import { PidFileManager } from './pid';
    18→import { projectContextMiddleware } from './middleware/project-context';
    19→import { createTasksRoutes } from './routes/tasks';
    20→import { createItemsRoutes } from './routes/items';
    21→import { createInboxRoutes } from './routes/inbox';
    22→import { createMetaRoutes } from './routes/meta';
    23→import { createValidationRoutes } from './routes/validation';
    24→import { createProjectsRoutes } from './routes/projects';
    25→import { join } from 'path';
    26→
    27→export interface ServerOptions {
    28→  port: number;
    29→  isDaemon: boolean;
    30→  kspecDir?: string; // Path to .kspec directory (default: .kspec in cwd)
    31→  webUiDir?: string; // Path to web UI build directory (default: auto-detect)
    32→}
    33→
    34→/**
    35→ * Resolves the path to the web UI build directory.
    36→ * Tries multiple locations in order:
    37→ * 1. Explicit webUiDir option
    38→ * 2. WEB_UI_DIR environment variable
    39→ * 3. packages/web-ui/build in current working directory (monorepo dev)
    40→ * 4. web-ui/build in current working directory
    41→ */
    42→function resolveWebUiPath(webUiDir?: string): string | null {
    43→  // 1. Explicit option
    44→  if (webUiDir && existsSync(webUiDir)) {
    45→    return webUiDir;
    46→  }
    47→
    48→  // 2. Environment variable
    49→  const envPath = process.env.WEB_UI_DIR;
    50→  if (envPath && existsSync(envPath)) {
    51→    return envPath;
    52→  }
    53→
    54→  // 3. Monorepo development: packages/web-ui/build from cwd
    55→  // The daemon is spawned with cwd set to project root
    56→  const monorepoPath = join(process.cwd(), 'packages', 'web-ui', 'build');
    57→  if (existsSync(monorepoPath)) {
    58→    return monorepoPath;
    59→  }
    60→
    61→  // 4. Alternate location: web-ui/build in cwd
    62→  const altPath = join(process.cwd(), 'web-ui', 'build');
    63→  if (existsSync(altPath)) {
    64→    return altPath;
    65→  }
    66→
    67→  return null;
    68→}
    69→
    70→// WebSocket pub/sub and heartbeat managers
    71→let pubsubManager: PubSubManager;
    72→let heartbeatManager: HeartbeatManager;
    73→let wsHandler: WebSocketHandler;
    74→let projectManager: import('./project-context').ProjectContextManager | undefined;
    75→
    76→/**
    77→ * Middleware to enforce localhost-only connections.
    78→ * AC-3: Reject non-localhost connections with 403 Forbidden
    79→ */
    80→function localhostOnly() {
    81→  return (context: { request: Request }) => {
    82→    const host = context.request.headers.get('host');
    83→    if (!host) {
    84→      return new Response(JSON.stringify({
    85→        error: 'Forbidden',
    86→        message: 'This server only accepts connections from localhost'
    87→      }), {
    88→        status: 403,
    89→        headers: { 'Content-Type': 'application/json' }
    90→      });
    91→    }
    92→
    93→    // Extract hostname, handling IPv6 brackets
    94→    let hostname: string;
    95→    if (host.startsWith('[')) {
    96→      // IPv6 with brackets: [::1]:3456 -> ::1
    97→      const closeBracket = host.indexOf(']');
    98→      hostname = closeBracket > 0 ? host.substring(1, closeBracket) : host;
    99→    } else {
   100→      // IPv4 or hostname: localhost:3456 -> localhost
   101→      hostname = host.split(':')[0];
   102→    }
   103→
   104→    // Allow localhost, 127.0.0.1, and ::1
   105→    const isLocalhost =
   106→      hostname === 'localhost' ||
   107→      hostname === '127.0.0.1' ||
   108→      hostname === '::1';
   109→
   110→    if (!isLocalhost) {
   111→      return new Response(JSON.stringify({
   112→        error: 'Forbidden',
   113→        message: 'This server only accepts connections from localhost'
   114→      }), {
   115→        status: 403,
   116→        headers: { 'Content-Type': 'application/json' }
   117→      });
   118→    }
   119→  };
   120→}
   121→
   122→/**
   123→ * Creates and configures the Elysia server instance.
   124→ *
   125→ * AC Coverage:
   126→ * - ac-1: Server starts on configurable port (default 3456)
   127→ * - ac-2: Binds to localhost only (127.0.0.1 and ::1)
   128→ * - ac-3: Rejects non-localhost connections with 403
   129→ * - ac-15: Uses plugin pattern for middleware
   130→ */
   131→export async function createServer(options: ServerOptions) {
   132→  const { port, isDaemon, kspecDir = join(process.cwd(), '.kspec'), webUiDir } = options;
   133→
   134→  // Determine startup project path (project root, not .kspec/)
   135→  // AC: @multi-directory-daemon ac-2 - daemon uses startup directory as default project
   136→  const startupProjectPath = kspecDir.endsWith('.kspec')
   137→    ? kspecDir.slice(0, -('.kspec'.length + 1)) // Remove '/.kspec'
   138→    : kspecDir;
   139→
   140→  // Import ProjectContextManager (needed for WebSocket binding)
   141→  const { ProjectContextManager } = await import('./project-context');
   142→
   143→  // AC: @daemon-server ac-17 - Resolve web UI path for static file serving
   144→  const resolvedWebUiPath = resolveWebUiPath(webUiDir);
   145→  if (resolvedWebUiPath) {
   146→    console.log(`[daemon] Web UI assets found at: ${resolvedWebUiPath}`);
   147→  } else {
   148→    console.log('[daemon] Web UI assets not found - UI will not be served');
   149→    console.log('[daemon] Build the web UI with: cd packages/web-ui && npm run build');
   150→  }
   151→
   152→  // Initialize PID file manager (uses global ~/.config/kspec/)
   153→  const pidManager = new PidFileManager();
   154→
   155→  // AC: @multi-directory-daemon ac-9 - Write PID and port files in daemon mode
   156→  if (isDaemon) {
   157→    pidManager.writePid();
   158→    pidManager.writePort(port);
   159→    console.log(`[daemon] PID file written: ${process.pid}`);
   160→    console.log(`[daemon] Port file written: ${port}`);
   161→  }
   162→
   163→  // Initialize WebSocket managers
   164→  pubsubManager = new PubSubManager();
   165→  heartbeatManager = new HeartbeatManager();
   166→  wsHandler = new WebSocketHandler(pubsubManager);
   167→
   168→  // WeakMap to store project path during WebSocket upgrade
   169→  const wsProjectPaths = new Map<string, string>();
   170→
   171→  const app = new Elysia()
   172→    // AC-15: Plugin pattern for middleware
   173→    // AC: @api-contract ac-1 - Allow CORS from dev server on localhost:5173
   174→    .use(cors({
   175→      origin: ['http://localhost:5173', 'http://127.0.0.1:5173'], // Dev server origins
   176→      credentials: true,
   177→      methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS']
   178→    }))
   179→
   180→    // AC-3: Enforce localhost-only connections
   181→    .onRequest(localhostOnly());
   182→
   183→  // AC: @multi-directory-daemon ac-1, ac-2, ac-3 - Project context middleware
   184→  const { manager: projectContextManager, middleware: projectMiddleware } = projectContextMiddleware({
   185→    startupProject: startupProjectPath,
   186→    pubsub: pubsubManager
   187→  });
   188→
   189→  // Store manager globally for shutdown
   190→  projectManager = projectContextManager;
   191→
   192→  app.use(projectMiddleware)
   193→
   194→    // AC-11: Health check endpoint
   195→    .get('/api/health', () => ({
   196→      status: 'ok',
   197→      uptime: process.uptime(),
   198→      connections: pubsubManager.getConnectionCount(),
   199→      version: '0.1.0'
   200→    }))
   201→
   202→    // AC: @api-contract ac-2 through ac-7 - Task API endpoints
   203→    // AC: @multi-directory-daemon ac-24 - Routes use projectContext from middleware
   204→    .use(createTasksRoutes({ pubsub: pubsubManager }))
   205→
   206→    // AC: @api-contract ac-8 through ac-11 - Spec Item API endpoints
   207→    .use(createItemsRoutes())
   208→
   209→    // AC: @api-contract ac-12 through ac-14 - Inbox API endpoints
   210→    .use(createInboxRoutes({ pubsub: pubsubManager }))
   211→
   212→    // AC: @api-contract ac-15 through ac-18 - Meta API endpoints
   213→    .use(createMetaRoutes())
   214→
   215→    // AC: @api-contract ac-19 through ac-21 - Validation and search endpoints
   216→    .use(createValidationRoutes())
   217→
   218→    // AC: @multi-directory-daemon ac-28, ac-29, ac-30 - Projects management endpoints
   219→    .use(createProjectsRoutes({ projectManager: projectContextManager }))
   220→
   221→    // AC-4: WebSocket endpoint for real-time updates
   222→    .ws<ConnectionData>('/ws', {
   223→      beforeHandle({ request, store }) {
   224→        // AC: @multi-directory-daemon ac-21, ac-22, ac-23, ac-34 - Extract and validate project binding
   225→        // AC: @multi-directory-daemon ac-34 - Browser WebSocket API doesn't support custom headers,
   226→        // so we also accept project path as query parameter
   227→        const url = new URL(request.url, `http://${request.headers.get('host')}`);
   228→        const projectPath = request.headers.get('X-Kspec-Dir')
   229→                        || url.searchParams.get('project')
   230→                        || undefined;
   231→        const requestId = ulid(); // Temporary ID to correlate upgrade with open
   232→
   233→        try {
   234→          const manager = (store as Record<string, unknown>).projectManager as import('./project-context').ProjectContextManager | undefined;
   235→          if (!manager) {
   236→            // Fallback: project manager not initialized yet
   237→            wsProjectPaths.set(requestId, startupProjectPath);
   238→            return { wsRequestId: requestId };
   239→          }
   240→
   241→          let projectContext;
   242→          if (projectPath) {
   243→            // Explicit project specified
   244→            try {
   245→              projectContext = manager.getProject(projectPath);
   246→            } catch {
   247→              // AC: @multi-directory-daemon ac-4 - auto-register
   248→              projectContext = manager.registerProject(projectPath);
   249→            }
   250→          } else {
   251→            // AC: @multi-directory-daemon ac-22, ac-23 - Use default or reject
   252→            try {
   253→              projectContext = manager.getProject();
   254→            } catch (err: unknown) {
   255→              // AC: @multi-directory-daemon ac-23 - Reject when no default
   256→              if (err instanceof Error && err.message.includes('No default project configured')) {
   257→                throw new Error('No project specified');
   258→              }
   259→              throw err;
   260→            }
   261→          }
   262→
   263→          // Store resolved path for open() handler
   264→          wsProjectPaths.set(requestId, projectContext.path);
   265→          return { wsRequestId: requestId };
   266→        } catch (err: unknown) {
   267→          console.error(`[daemon] WebSocket connection rejected: ${err instanceof Error ? err.message : String(err)}`);
   268→          throw err;
   269→        }
   270→      },
   271→      open(ws) {
   272→        // AC: @api-contract ac-25, @trait-websocket-protocol ac-1
   273→        const sessionId = ulid();
   274→
   275→        // AC: @multi-directory-daemon ac-21 - Get bound project path
   276→        // Fallback to startup project if not found (shouldn't happen)
   277→        const requestId = (ws.data as ConnectionData & { wsRequestId?: string }).wsRequestId;
   278→        const projectPath = requestId ? wsProjectPaths.get(requestId) || startupProjectPath : startupProjectPath;
   279→
   280→        // Clean up temporary mapping
   281→        if (requestId) {
   282→          wsProjectPaths.delete(requestId);
   283→        }
   284→
   285→        ws.data = {
   286→          sessionId,
   287→          topics: new Set<string>(),
   288→          seq: 0,
   289→          lastPing: undefined,
   290→          lastPong: Date.now(),
   291→          projectPath // AC: @multi-directory-daemon ac-21 - immutable binding
   292→        };
   293→
   294→        pubsubManager.addConnection(sessionId, ws);
   295→        console.log(`[daemon] WebSocket client connected: ${sessionId} bound to ${projectPath} (${pubsubManager.getConnectionCount()} total)`);
   296→
   297→        // Send connected event with session_id
   298→        const connectedEvent: ConnectedEvent = {
   299→          event: 'connected',
   300→          data: {
   301→            session_id: sessionId
   302→          }
   303→        };
   304→        ws.send(JSON.stringify(connectedEvent));
   305→      },
   306→      message(ws, message) {
   307→        // AC: @api-contract ac-26, ac-27
   308→        wsHandler.handleMessage(ws, message);
   309→      },
   310→      pong(ws) {
   311→        // AC: @trait-websocket-protocol ac-5
   312→        heartbeatManager.recordPong(ws);
   313→      },
   314→      close(ws, code, reason) {
   315→        pubsubManager.removeConnection(ws.data.sessionId);
   316→        console.log(`[daemon] WebSocket client disconnected: ${ws.data.sessionId} (code: ${code}, reason: ${reason})`);
   317→      }
   318→    });
   319→
   320→  // AC: @daemon-server ac-17 - Serve web UI static assets
   321→  // Added after API routes so API routes take precedence
   322→  if (resolvedWebUiPath) {
   323→    const indexHtmlPath = join(resolvedWebUiPath, 'index.html');
   324→
   325→    // Serve static files from web UI build directory
   326→    app.use(await staticPlugin({
   327→      assets: resolvedWebUiPath,
   328→      prefix: '/',
   329→      noCache: process.env.NODE_ENV === 'development', // Disable cache in dev
   330→    }));
   331→
   332→    // SPA fallback routes for client-side routing
   333→    // These catch paths like /tasks, /items, /inbox that don't have static files
   334→    const spaRoutes = ['/tasks', '/tasks/*', '/items', '/items/*', '/inbox', '/observations'];
   335→    for (const route of spaRoutes) {
   336→      app.get(route, () => Bun.file(indexHtmlPath));
   337→    }
   338→
   339→    console.log('[daemon] Web UI static file serving enabled');
   340→  }
   341→
   342→  // AC-1, AC-2: Start server on localhost only
   343→  // Using 'localhost' hostname allows Bun/OS to bind to both 127.0.0.1 and ::1
   344→  app.listen({
   345→    port,
   346→    hostname: 'localhost', // Resolves to both IPv4 and IPv6 loopback
   347→  });
   348→
   349→  console.log(`[daemon] Server listening on http://localhost:${port} (IPv4: 127.0.0.1, IPv6: ::1)`);
   350→  console.log(`[daemon] WebSocket available at ws://localhost:${port}/ws`);
   351→
   352→  // AC: @multi-directory-daemon ac-17 - Start file watcher for startup project
   353→  if (startupProjectPath) {
   354→    try {
   355→      await projectContextManager.startWatcher(startupProjectPath);
   356→      console.log(`[daemon] File watcher started for startup project: ${startupProjectPath}`);
   357→    } catch (error) {
   358→      console.error('[daemon] Failed to start file watcher for startup project:', error);
   359→    }
   360→  }
   361→
   362→  // AC: @daemon-server ac-13, ac-14 - Start heartbeat monitoring
   363→  heartbeatManager.start(pubsubManager.getAllConnections());
   364→
   365→  // AC-12: Graceful shutdown on SIGTERM/SIGINT
   366→  const shutdown = async (signal: string) => {
   367→    console.log(`[daemon] Received ${signal}, shutting down gracefully...`);
   368→
   369→    try {
   370→      // Stop heartbeat monitoring
   371→      heartbeatManager.stop();
   372→
   373→      // AC: @multi-directory-daemon ac-11b - Stop all file watchers
   374→      await projectContextManager.stopAllWatchers();
   375→      console.log('[daemon] All file watchers stopped');
   376→
   377→      // Close all WebSocket connections with code 1000 (clean close)
   378→      // AC: @trait-websocket-protocol ac-7
   379→      for (const [sessionId, ws] of pubsubManager.getAllConnections()) {
   380→        ws.close(1000, 'Server shutting down');
   381→      }
   382→
   383→      // Stop the server
   384→      await app.server?.stop();
   385→
   386→      // AC: @daemon-server ac-10 - Remove PID file on shutdown
   387→      if (isDaemon) {
   388→        pidManager.remove();
   389→        console.log('[daemon] PID file removed');
   390→      }
   391→
   392→      console.log('[daemon] Server stopped successfully');
   393→      process.exit(0);
   394→    } catch (error) {
   395→      console.error('[daemon] Error during shutdown:', error);
   396→      process.exit(1);
   397→    }
   398→  };
   399→
   400→  process.on('SIGTERM', () => shutdown('SIGTERM'));
   401→  process.on('SIGINT', () => shutdown('SIGINT'));
   402→
   403→  return app;
   404→}
   405→
```