```
     1→/**
     2→ * Doctor command - unified health check for kspec
     3→ *
     4→ * Library layer that aggregates shadow branch, setup, and daemon status
     5→ * into a unified DoctorReport. CLI command is in src/cli/commands/doctor.ts.
     6→ *
     7→ * AC: @doctor-command
     8→ */
     9→
    10→import { getGitRoot, getShadowStatus, isGitRepo, type ShadowStatus } from "./shadow.js";
    11→import { getSetupStatus, type SetupStatus } from "./setup-status.js";
    12→import { getDaemonStatus, type DaemonStatus } from "./daemon-status.js";
    13→
    14→/**
    15→ * Severity levels for health checks
    16→ */
    17→export type Severity = "ok" | "warning" | "error";
    18→
    19→/**
    20→ * Individual check result with severity
    21→ */
    22→export interface CheckResult {
    23→  name: string;
    24→  severity: Severity;
    25→  message: string;
    26→  /** Optional guidance for fixing issues */
    27→  guidance?: string;
    28→}
    29→
    30→/**
    31→ * Shadow branch section of doctor report
    32→ * AC: @doctor-command ac-shadow-healthy
    33→ */
    34→export interface ShadowSection {
    35→  initialized: boolean;
    36→  checks: CheckResult[];
    37→}
    38→
    39→/**
    40→ * Setup section of doctor report
    41→ * AC: @doctor-command ac-setup-agent-hooks, ac-setup-skills-agents-md
    42→ */
    43→export interface SetupSection {
    44→  checks: CheckResult[];
    45→  agentType?: string;
    46→  hooksInstalled?: boolean;
    47→  skillsRendered?: number;
    48→  skillsDrifted?: number;
    49→  agentsMdStatus?: "current" | "stale" | "missing" | "unknown";
    50→  agentsMdGeneratedAt?: string;
    51→}
    52→
    53→/**
    54→ * Daemon section of doctor report
    55→ * AC: @doctor-command ac-daemon-running, ac-daemon-not-running, ac-daemon-unreachable
    56→ */
    57→export interface DaemonSection {
    58→  checks: CheckResult[];
    59→  running?: boolean;
    60→  pid?: number | null;
    61→  port?: number | null;
    62→  uptime?: number | null;
    63→  healthReachable?: boolean;
    64→}
    65→
    66→/**
    67→ * Overall verdict
    68→ * AC: @doctor-command ac-overall-verdict
    69→ */
    70→export interface OverallVerdict {
    71→  healthy: boolean;
    72→  errorCount: number;
    73→  warningCount: number;
    74→}
    75→
    76→/**
    77→ * Complete doctor report
    78→ * AC: @doctor-command ac-json-output
    79→ */
    80→export interface DoctorReport {
    81→  /** Timestamp of report generation (ISO 8601) */
    82→  generatedAt: string;
    83→  /** Shadow branch status */
    84→  shadow: ShadowSection;
    85→  /** Setup status (hooks, skills, agents.md) */
    86→  setup: SetupSection;
    87→  /** Daemon status */
    88→  daemon: DaemonSection;
    89→  /** Overall health verdict */
    90→  overall: OverallVerdict;
    91→}
    92→
    93→/**
    94→ * Options for doctor report
    95→ */
    96→export interface DoctorOptions {
    97→  /** Project root directory (defaults to detecting from cwd) */
    98→  projectRoot?: string;
    99→}
   100→
   101→/**
   102→ * Get a unified health check report for the kspec installation.
   103→ *
   104→ * AC: @doctor-command ac-no-git-repo — returns error if not in git repo
   105→ * AC: @doctor-command ac-not-initialized — returns error if kspec not initialized
   106→ * AC: @doctor-command ac-shadow-healthy — checks shadow branch health
   107→ * AC: @doctor-command ac-setup-agent-hooks — checks hooks status
   108→ * AC: @doctor-command ac-setup-skills-agents-md — checks skills and agents.md
   109→ * AC: @doctor-command ac-daemon-running — checks daemon status
   110→ * AC: @doctor-command ac-daemon-unreachable — detects unreachable health endpoint
   111→ * AC: @doctor-command ac-daemon-not-running — daemon not running is warning
   112→ * AC: @doctor-command ac-overall-verdict — computes healthy/issues verdict
   113→ * AC: @doctor-command ac-partial-init — handles shadow ok but setup missing
   114→ * AC: @doctor-command ac-staleness-unknown — handles unknown staleness
   115→ *
   116→ * @param cwd Current working directory
   117→ * @param options Optional configuration
   118→ */
   119→export async function getDoctorReport(
   120→  cwd: string,
   121→  options: DoctorOptions = {}
   122→): Promise<DoctorReport> {
   123→  const generatedAt = new Date().toISOString();
   124→
   125→  // Initialize empty report
   126→  const report: DoctorReport = {
   127→    generatedAt,
   128→    shadow: { initialized: false, checks: [] },
   129→    setup: { checks: [] },
   130→    daemon: { checks: [] },
   131→    overall: { healthy: false, errorCount: 0, warningCount: 0 },
   132→  };
   133→
   134→  // Step 1: Check for git repo
   135→  // AC: @doctor-command ac-no-git-repo
   136→  const projectRoot = options.projectRoot ?? getGitRoot(cwd);
   137→  if (!projectRoot) {
   138→    report.shadow.checks.push({
   139→      name: "git-repo",
   140→      severity: "error",
   141→      message: "No git repository found",
   142→      guidance: "Run `git init` to initialize a git repository",
   143→    });
   144→    report.overall.errorCount = 1;
   145→    return report;
   146→  }
   147→
   148→  // Verify it's actually a git repo
   149→  if (!(await isGitRepo(projectRoot))) {
   150→    report.shadow.checks.push({
   151→      name: "git-repo",
   152→      severity: "error",
   153→      message: "Not a git repository",
   154→      guidance: "Run `git init` to initialize a git repository",
   155→    });
   156→    report.overall.errorCount = 1;
   157→    return report;
   158→  }
   159→
   160→  // Step 2: Check shadow branch status
   161→  // AC: @doctor-command ac-not-initialized, ac-shadow-healthy
   162→  const shadowStatus = await getShadowStatus(projectRoot);
   163→  buildShadowSection(report.shadow, shadowStatus);
   164→
   165→  // If not initialized, return early with guidance
   166→  // AC: @doctor-command ac-not-initialized
   167→  if (!shadowStatus.exists) {
   168→    report.shadow.checks.push({
   169→      name: "initialized",
   170→      severity: "error",
   171→      message: "kspec is not initialized",
   172→      guidance: "Run `kspec init` to initialize kspec in this project",
   173→    });
   174→    report.overall.errorCount = countErrors(report);
   175→    report.overall.warningCount = countWarnings(report);
   176→    return report;
   177→  }
   178→
   179→  // Shadow exists, run remaining checks in parallel
   180→  // AC: @doctor-command ac-setup-agent-hooks, ac-setup-skills-agents-md, ac-daemon-running
   181→  const [setupStatus, daemonStatus] = await Promise.all([
   182→    getSetupStatus(projectRoot).catch((err): SetupStatus => ({
   183→      agent: { detected: "unknown", confidence: "low" },
   184→      hooks: { promptCheck: false, stop: false, preToolUse: false, guardsPresent: [] },
   185→      skills: { total: 0, rendered: 0, drifted: 0 },
   186→      plugin: { marketplaceRegistered: false, marketplaceHealthy: false, pluginEnabled: false },
   187→      agentsMd: { exists: false, status: "missing" },
   188→      seeding: { permissionsSeeded: false, memorySeeded: false },
   189→      error: err instanceof Error ? err.message : String(err),
   190→    })),
   191→    getDaemonStatus().catch((err): DaemonStatus => ({
   192→      running: false,
   193→      pid: null,
   194→      port: null,
   195→      uptime: null,
   196→      healthReachable: false,
   197→      error: err instanceof Error ? err.message : String(err),
   198→    })),
   199→  ]);
   200→
   201→  // Build setup section
   202→  // AC: @doctor-command ac-setup-agent-hooks, ac-setup-skills-agents-md, ac-partial-init, ac-staleness-unknown
   203→  buildSetupSection(report.setup, setupStatus);
   204→
   205→  // Build daemon section
   206→  // AC: @doctor-command ac-daemon-running, ac-daemon-not-running, ac-daemon-unreachable
   207→  buildDaemonSection(report.daemon, daemonStatus);
   208→
   209→  // Compute overall verdict
   210→  // AC: @doctor-command ac-overall-verdict
   211→  report.overall.errorCount = countErrors(report);
   212→  report.overall.warningCount = countWarnings(report);
   213→  report.overall.healthy = report.overall.errorCount === 0;
   214→
   215→  return report;
   216→}
   217→
   218→/**
   219→ * Build shadow section from ShadowStatus
   220→ * AC: @doctor-command ac-shadow-healthy
   221→ */
   222→function buildShadowSection(section: ShadowSection, status: ShadowStatus): void {
   223→  section.initialized = status.exists;
   224→
   225→  // Branch exists check
   226→  section.checks.push({
   227→    name: "branch-exists",
   228→    severity: status.branchExists ? "ok" : "error",
   229→    message: status.branchExists
   230→      ? "Shadow branch exists"
   231→      : "Shadow branch does not exist",
   232→    guidance: status.branchExists ? undefined : "Run `kspec init` to create shadow branch",
   233→  });
   234→
   235→  // Only check worktree if branch exists
   236→  if (status.branchExists) {
   237→    // Worktree exists check
   238→    section.checks.push({
   239→      name: "worktree-exists",
   240→      severity: status.worktreeExists ? "ok" : "error",
   241→      message: status.worktreeExists
   242→        ? "Worktree directory exists"
   243→        : "Worktree directory missing",
   244→      guidance: status.worktreeExists ? undefined : "Run `kspec shadow repair` to recreate worktree",
   245→    });
   246→
   247→    // Worktree linked check
   248→    if (status.worktreeExists) {
   249→      section.checks.push({
   250→        name: "worktree-linked",
   251→        severity: status.worktreeLinked ? "ok" : "error",
   252→        message: status.worktreeLinked
   253→          ? "Worktree properly linked"
   254→          : "Worktree not properly linked",
   255→        guidance: status.worktreeLinked ? undefined : "Run `kspec shadow repair` to fix worktree link",
   256→      });
   257→
   258→      // AC: @artifacts-directory ac-doctor-checks
   259→      section.checks.push({
   260→        name: "artifacts-dir",
   261→        severity: status.artifactsDirExists ? "ok" : "warning",
   262→        message: status.artifactsDirExists
   263→          ? "Artifacts directory exists"
   264→          : "Artifacts directory missing",
   265→        guidance: status.artifactsDirExists ? undefined : "Run `kspec setup` to create artifacts directory",
   266→      });
   267→    }
   268→  }
   269→}
   270→
   271→/**
   272→ * Build setup section from SetupStatus
   273→ * AC: @doctor-command ac-setup-agent-hooks, ac-setup-skills-agents-md, ac-partial-init, ac-staleness-unknown
   274→ */
   275→function buildSetupSection(section: SetupSection, status: SetupStatus): void {
   276→  // Store metadata
   277→  section.agentType = status.agent.detected;
   278→  section.skillsRendered = status.skills.rendered;
   279→  section.skillsDrifted = status.skills.drifted;
   280→  section.agentsMdStatus = status.agentsMd.status;
   281→  section.agentsMdGeneratedAt = status.agentsMd.generatedAt;
   282→
   283→  // Agent type check
   284→  // AC: @doctor-command ac-setup-agent-hooks
   285→  section.checks.push({
   286→    name: "agent-type",
   287→    severity: status.agent.detected !== "unknown" ? "ok" : "warning",
   288→    message: status.agent.detected !== "unknown"
   289→      ? `Agent type: ${status.agent.detected} (${status.agent.confidence} confidence)`
   290→      : "Agent type: unknown",
   291→    guidance: status.agent.detected === "unknown"
   292→      ? "Run `kspec setup` to configure agent integration"
   293→      : undefined,
   294→  });
   295→
   296→  // Hooks check
   297→  // AC: @doctor-command ac-setup-agent-hooks, ac-partial-init
   298→  const hooksInstalled =
   299→    status.hooks.promptCheck ||
   300→    status.hooks.stop ||
   301→    status.hooks.preToolUse ||
   302→    status.hooks.guardsPresent.length > 0;
   303→  section.hooksInstalled = hooksInstalled;
   304→
   305→  section.checks.push({
   306→    name: "hooks",
   307→    severity: hooksInstalled ? "ok" : "error",
   308→    message: hooksInstalled
   309→      ? `Hooks installed (prompt-check: ${status.hooks.promptCheck}, stop: ${status.hooks.stop}, guards: ${status.hooks.guardsPresent.length})`
   310→      : "No hooks installed",
   311→    guidance: hooksInstalled
   312→      ? undefined
   313→      : "Run `kspec setup` to install hooks",
   314→  });
   315→
   316→  // Skills check
   317→  // AC: @doctor-command ac-setup-skills-agents-md
   318→  section.checks.push({
   319→    name: "skills",
   320→    severity: status.skills.rendered > 0
   321→      ? (status.skills.drifted > 0 ? "warning" : "ok")
   322→      : "warning",
   323→    message: status.skills.rendered > 0
   324→      ? `${status.skills.rendered} skills rendered${status.skills.drifted > 0 ? `, ${status.skills.drifted} drifted` : ""}`
   325→      : "No skills rendered",
   326→    guidance: status.skills.rendered === 0
   327→      ? "Run `kspec setup` to render skills"
   328→      : (status.skills.drifted > 0 ? "Run `kspec setup --force` to re-render drifted skills" : undefined),
   329→  });
   330→
   331→  // kspec-agents.md check
   332→  // AC: @doctor-command ac-setup-skills-agents-md, ac-staleness-unknown
   333→  let agentsMdSeverity: Severity;
   334→  let agentsMdMessage: string;
   335→  let agentsMdGuidance: string | undefined;
   336→
   337→  switch (status.agentsMd.status) {
   338→    case "current":
   339→      agentsMdSeverity = "ok";
   340→      agentsMdMessage = status.agentsMd.generatedAt
   341→        ? `kspec-agents.md is current (generated: ${status.agentsMd.generatedAt})`
   342→        : "kspec-agents.md is current";
   343→      break;
   344→    case "stale":
   345→      agentsMdSeverity = "warning";
   346→      agentsMdMessage = "kspec-agents.md is stale";
   347→      agentsMdGuidance = "Run `kspec agents generate` to regenerate";
   348→      break;
   349→    case "unknown":
   350→      // AC: @doctor-command ac-staleness-unknown
   351→      agentsMdSeverity = "warning";
   352→      agentsMdMessage = "kspec-agents.md staleness unknown";
   353→      agentsMdGuidance = "Could not determine staleness (manifest or hash computation unavailable)";
   354→      break;
   355→    case "missing":
   356→    default:
   357→      agentsMdSeverity = "error";
   358→      agentsMdMessage = "kspec-agents.md does not exist";
   359→      agentsMdGuidance = "Run `kspec setup` to generate kspec-agents.md";
   360→      break;
   361→  }
   362→
   363→  section.checks.push({
   364→    name: "agents-md",
   365→    severity: agentsMdSeverity,
   366→    message: agentsMdMessage,
   367→    guidance: agentsMdGuidance,
   368→  });
   369→}
   370→
   371→/**
   372→ * Build daemon section from DaemonStatus
   373→ * AC: @doctor-command ac-daemon-running, ac-daemon-not-running, ac-daemon-unreachable
   374→ */
   375→function buildDaemonSection(section: DaemonSection, status: DaemonStatus): void {
   376→  section.running = status.running;
   377→  section.pid = status.pid;
   378→  section.port = status.port;
   379→  section.uptime = status.uptime;
   380→  section.healthReachable = status.healthReachable;
   381→
   382→  if (!status.running) {
   383→    // AC: @doctor-command ac-daemon-not-running — warning, not error
   384→    section.checks.push({
   385→      name: "daemon-running",
   386→      severity: "warning",
   387→      message: "Daemon not running",
   388→      guidance: "Run `kspec serve start --daemon` to start the daemon (optional)",
   389→    });
   390→    return;
   391→  }
   392→
   393→  // Daemon is running
   394→  // AC: @doctor-command ac-daemon-running
   395→  section.checks.push({
   396→    name: "daemon-running",
   397→    severity: "ok",
   398→    message: `Daemon running (PID: ${status.pid})`,
   399→  });
   400→
   401→  // Port check
   402→  if (status.port) {
   403→    section.checks.push({
   404→      name: "daemon-port",
   405→      severity: "ok",
   406→      message: `Port: ${status.port}`,
   407→    });
   408→  }
   409→
   410→  // Uptime check
   411→  if (status.uptime !== null) {
   412→    const hours = Math.floor(status.uptime / 3600);
   413→    const minutes = Math.floor((status.uptime % 3600) / 60);
   414→    const seconds = Math.floor(status.uptime % 60);
   415→    let uptimeStr: string;
   416→    if (hours > 0) {
   417→      uptimeStr = `${hours}h ${minutes}m ${seconds}s`;
   418→    } else if (minutes > 0) {
   419→      uptimeStr = `${minutes}m ${seconds}s`;
   420→    } else {
   421→      uptimeStr = `${seconds}s`;
   422→    }
   423→    section.checks.push({
   424→      name: "daemon-uptime",
   425→      severity: "ok",
   426→      message: `Uptime: ${uptimeStr}`,
   427→    });
   428→  }
   429→
   430→  // Health endpoint check
   431→  // AC: @doctor-command ac-daemon-unreachable
   432→  if (!status.healthReachable) {
   433→    section.checks.push({
   434→      name: "daemon-health",
   435→      severity: "warning",
   436→      message: "Health endpoint unreachable",
   437→      guidance: "Daemon may be starting up or there may be a port conflict",
   438→    });
   439→  } else {
   440→    section.checks.push({
   441→      name: "daemon-health",
   442→      severity: "ok",
   443→      message: "Health endpoint reachable",
   444→    });
   445→  }
   446→}
   447→
   448→/**
   449→ * Count errors across all sections
   450→ */
   451→function countErrors(report: DoctorReport): number {
   452→  let count = 0;
   453→  for (const check of report.shadow.checks) {
   454→    if (check.severity === "error") count++;
   455→  }
   456→  for (const check of report.setup.checks) {
   457→    if (check.severity === "error") count++;
   458→  }
   459→  for (const check of report.daemon.checks) {
   460→    if (check.severity === "error") count++;
   461→  }
   462→  return count;
   463→}
   464→
   465→/**
   466→ * Count warnings across all sections
   467→ */
   468→function countWarnings(report: DoctorReport): number {
   469→  let count = 0;
   470→  for (const check of report.shadow.checks) {
   471→    if (check.severity === "warning") count++;
   472→  }
   473→  for (const check of report.setup.checks) {
   474→    if (check.severity === "warning") count++;
   475→  }
   476→  for (const check of report.daemon.checks) {
   477→    if (check.severity === "warning") count++;
   478→  }
   479→  return count;
   480→}
   481→
```