```
     1→/**
     2→ * Triage API Routes
     3→ *
     4→ * REST endpoints for triage operations:
     5→ * - GET /api/triage - list records with filters and pagination
     6→ * - GET /api/triage/export - export records for agent handoff
     7→ * - POST /api/triage - record a triage decision
     8→ * - GET /api/triage/:ref - get single record
     9→ * - POST /api/triage/:ref/override - override a decision
    10→ * - POST /api/triage/:ref/act - execute a triage action
    11→ *
    12→ * AC Coverage:
    13→ * - @triage-daemon-api ac-1: GET list sorted by created_at desc
    14→ * - @triage-daemon-api ac-2: Status filter on GET list
    15→ * - @triage-daemon-api ac-3: POST creates record with snapshot
    16→ * - @triage-daemon-api ac-4: PUT override sets override fields
    17→ * - @triage-daemon-api ac-5: PUT act executes and transitions
    18→ * - @triage-daemon-api ac-6: GET export with format parameter
    19→ * - @triage-daemon-api ac-7: POST 404 for nonexistent inbox item
    20→ * - @triage-daemon-api ac-8: PUT act 409 for already acted
    21→ * - @triage-daemon-api ac-9: PUT act 422 for pending record
    22→ */
    23→
    24→import { Elysia, t } from 'elysia';
    25→import { ulid } from 'ulidx';
    26→import {
    27→  initContext,
    28→  loadTriageRecords,
    29→  saveTriageRecord,
    30→  findTriageRecordByRef,
    31→  findTriageRecordByInboxRef,
    32→  loadInboxItems,
    33→  findInboxItemByRef,
    34→  loadAllTasks,
    35→  loadAllItems,
    36→  ReferenceIndex,
    37→  getAuthor,
    38→  createObservation,
    39→  saveObservation,
    40→  createTask,
    41→  saveTask,
    42→  deleteInboxItem,
    43→  type LoadedTriageRecord,
    44→} from '../../parser/index.js';
    45→import { commitIfShadow } from '../../parser/shadow.js';
    46→import type { TriageAction } from '../../schema/index.js';
    47→import type { PubSubManager } from '../websocket/pubsub';
    48→
    49→interface TriageRouteOptions {
    50→  pubsub: PubSubManager;
    51→}
    52→
    53→const VALID_ACTIONS = ['promote', 'delete', 'defer', 'spec-gap', 'duplicate'];
    54→
    55→/**
    56→ * Truncate text for display
    57→ */
    58→function truncateText(text: string, maxLen: number = 60): string {
    59→  const firstLine = text.split('\n')[0].trim();
    60→  if (firstLine.length <= maxLen) return firstLine;
    61→  return `${firstLine.slice(0, maxLen - 3)}...`;
    62→}
    63→
    64→/**
    65→ * Format a triage record for context export
    66→ * AC: @triage-daemon-api ac-6
    67→ */
    68→function formatTriageContext(record: LoadedTriageRecord): string {
    69→  const lines: string[] = [];
    70→  lines.push(`### ${record._ulid.slice(0, 8)} — ${truncateText(record.item_snapshot, 80)}`);
    71→  lines.push('');
    72→  lines.push(`**Item:** ${record.item_snapshot}`);
    73→  lines.push(`**Status:** ${record.status}`);
    74→  if (record.action) lines.push(`**Action:** ${record.action}`);
    75→  if (record.reasoning) lines.push(`**Reasoning:** ${record.reasoning}`);
    76→  if (record.decided_by) lines.push(`**Decided by:** ${record.decided_by}`);
    77→  if (record.evidence_refs.length > 0) {
    78→    lines.push(`**Evidence:** ${record.evidence_refs.join(', ')}`);
    79→  }
    80→  if (record.override_reasoning) {
    81→    lines.push(`**Override:** ${record.override_reasoning} (by ${record.override_by || 'unknown'})`);
    82→  }
    83→  if (record.acted_at) {
    84→    lines.push(`**Acted at:** ${record.acted_at}`);
    85→    if (record.result_ref) lines.push(`**Result:** ${record.result_ref}`);
    86→  }
    87→  lines.push('');
    88→  return lines.join('\n');
    89→}
    90→
    91→/**
    92→ * Execute a triage action (reused from CLI logic)
    93→ * AC: @triage-daemon-api ac-5
    94→ */
    95→async function executeTriageAction(
    96→  record: LoadedTriageRecord,
    97→  ctx: Awaited<ReturnType<typeof initContext>>,
    98→): Promise<{ resultRef?: string }> {
    99→  const action = record.action;
   100→  if (!action) return {};
   101→
   102→  switch (action) {
   103→    case 'promote': {
   104→      const task = createTask({
   105→        title: record.item_snapshot.split('\n')[0].slice(0, 100),
   106→        type: 'task',
   107→        priority: 3,
   108→        spec_ref: null,
   109→        tags: [],
   110→        description: record.item_snapshot,
   111→      });
   112→      await saveTask(ctx, task);
   113→      const tasks = await loadAllTasks(ctx);
   114→      const items = await loadAllItems(ctx);
   115→      const index = new ReferenceIndex(tasks, items);
   116→      const taskRef = `@${index.shortUlid(task._ulid)}`;
   117→      return { resultRef: taskRef };
   118→    }
   119→
   120→    case 'delete':
   121→    case 'duplicate': {
   122→      const inboxItems = await loadInboxItems(ctx);
   123→      const inboxItem = findInboxItemByRef(inboxItems, record.inbox_ref);
   124→      if (inboxItem) {
   125→        await deleteInboxItem(ctx, inboxItem._ulid);
   126→      }
   127→      return {};
   128→    }
   129→
   130→    case 'defer': {
   131→      return {};
   132→    }
   133→
   134→    case 'spec-gap': {
   135→      const content = `[spec-gap] ${record.item_snapshot}\n\nReasoning: ${record.reasoning || ''}`;
   136→      const observation = createObservation('question', content, {
   137→        configAuthor: ctx.config?.identity?.author,
   138→      });
   139→      await saveObservation(ctx, observation);
   140→      const obsRef = `@${observation._ulid.slice(0, 8)}`;
   141→      return { resultRef: obsRef };
   142→    }
   143→
   144→    default:
   145→      return {};
   146→  }
   147→}
   148→
   149→export function createTriageRoutes(options: TriageRouteOptions) {
   150→  const { pubsub } = options;
   151→
   152→  return new Elysia({ prefix: '/api/triage' })
   153→    // AC: @triage-daemon-api ac-1, ac-2 - List triage records with filters and pagination
   154→    // AC: @trait-api-endpoint ac-1, ac-4 - JSON response with pagination wrapper
   155→    .get(
   156→      '/',
   157→      async ({ query, projectContext }) => {
   158→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   159→        const ctx = await initContext(projectContext.path);
   160→        const records = await loadTriageRecords(ctx);
   161→
   162→        // Apply filters
   163→        let filtered = records;
   164→
   165→        // AC: @triage-daemon-api ac-2 - Status filter
   166→        if (query.status) {
   167→          const statusFilters = Array.isArray(query.status) ? query.status : [query.status];
   168→          filtered = filtered.filter((r) => statusFilters.includes(r.status));
   169→        }
   170→
   171→        // Action filter
   172→        if (query.action) {
   173→          const actionFilters = Array.isArray(query.action) ? query.action : [query.action];
   174→          filtered = filtered.filter((r) => r.action && actionFilters.includes(r.action));
   175→        }
   176→
   177→        // AC: @triage-daemon-api ac-1 - Sort by created_at descending (newest first)
   178→        filtered.sort(
   179→          (a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
   180→        );
   181→
   182→        // AC: @trait-api-endpoint ac-4 - Pagination with limit and offset
   183→        const total = filtered.length;
   184→        const offset = Number(query.offset) || 0;
   185→        const limit = Number(query.limit) || total;
   186→
   187→        const paginated = filtered.slice(offset, offset + limit);
   188→
   189→        return {
   190→          items: paginated,
   191→          total,
   192→          offset,
   193→          limit,
   194→        };
   195→      },
   196→      {
   197→        query: t.Object({
   198→          status: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   199→          action: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   200→          limit: t.Optional(t.String()),
   201→          offset: t.Optional(t.String()),
   202→        }),
   203→      }
   204→    )
   205→
   206→    // AC: @triage-daemon-api ac-6 - Export triage records
   207→    // NOTE: This route MUST be defined before /:ref to avoid "export" being parsed as a ref
   208→    .get(
   209→      '/export',
   210→      async ({ query, projectContext }) => {
   211→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   212→        const ctx = await initContext(projectContext.path);
   213→        let records = await loadTriageRecords(ctx);
   214→
   215→        // Optional status filter on export
   216→        if (query.status) {
   217→          const statusFilters = Array.isArray(query.status) ? query.status : [query.status];
   218→          records = records.filter((r) => statusFilters.includes(r.status));
   219→        }
   220→
   221→        const format = query.format || 'json';
   222→
   223→        if (format === 'context') {
   224→          // AC: @triage-daemon-api ac-6 - Context markdown format
   225→          if (records.length === 0) {
   226→            return { format: 'context', content: 'No triage decisions recorded.' };
   227→          }
   228→          let content = '# Triage Decisions\n\n';
   229→          for (const record of records) {
   230→            content += formatTriageContext(record);
   231→          }
   232→          return { format: 'context', content };
   233→        }
   234→
   235→        // AC: @triage-daemon-api ac-6 - JSON format (default)
   236→        return {
   237→          format: 'json',
   238→          items: records,
   239→          total: records.length,
   240→        };
   241→      },
   242→      {
   243→        query: t.Object({
   244→          format: t.Optional(t.String()),
   245→          status: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   246→        }),
   247→      }
   248→    )
   249→
   250→    // AC: @triage-daemon-api ac-3 - Record a triage decision
   251→    // AC: @trait-api-endpoint ac-1, ac-3, ac-5 - JSON response, validation, shadow commit
   252→    .post(
   253→      '/',
   254→      async ({ body, error: errorResponse, projectContext }) => {
   255→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   256→        const ctx = await initContext(projectContext.path);
   257→
   258→        // AC: @trait-api-endpoint ac-3 - Validate action
   259→        if (!VALID_ACTIONS.includes(body.action)) {
   260→          return errorResponse(400, {
   261→            error: 'validation_error',
   262→            details: [
   263→              {
   264→                field: 'action',
   265→                message: `Action must be one of: ${VALID_ACTIONS.join(', ')}`,
   266→              },
   267→            ],
   268→          });
   269→        }
   270→
   271→        // AC: @triage-daemon-api ac-7 - Validate inbox item exists
   272→        const inboxItems = await loadInboxItems(ctx);
   273→        const inboxItem = findInboxItemByRef(inboxItems, body.inbox_ref);
   274→        if (!inboxItem) {
   275→          // AC: @trait-api-endpoint ac-2 - 404 with error guidance
   276→          return errorResponse(404, {
   277→            error: 'not_found',
   278→            message: `Inbox item reference "${body.inbox_ref}" not found`,
   279→            suggestion: 'Use kspec inbox list or GET /api/inbox to find valid inbox item references',
   280→          });
   281→        }
   282→
   283→        const author = body.decided_by || getAuthor(ctx.config?.identity?.author);
   284→        const evidenceRefs = body.evidence_refs
   285→          ? body.evidence_refs.map((r: string) => r.startsWith('@') ? r : `@${r}`)
   286→          : [];
   287→
   288→        // Check if a record already exists for this inbox item (upsert case)
   289→        const existingRecords = await loadTriageRecords(ctx);
   290→        const existing = findTriageRecordByInboxRef(existingRecords, inboxItem._ulid);
   291→
   292→        // AC: @triage-daemon-api ac-3 - Create record with item_snapshot
   293→        const record: LoadedTriageRecord = {
   294→          _ulid: existing?._ulid || ulid(),
   295→          inbox_ref: inboxItem._ulid,
   296→          item_snapshot: inboxItem.text,
   297→          status: 'triaged',
   298→          action: body.action as TriageAction,
   299→          reasoning: body.reasoning,
   300→          decided_by: author,
   301→          evidence_refs: evidenceRefs,
   302→          created_at: existing?.created_at || new Date().toISOString(),
   303→        };
   304→
   305→        await saveTriageRecord(ctx, record);
   306→
   307→        // Reload to get the persisted record (saveTriageRecord may upsert by inbox_ref)
   308→        const savedRecords = await loadTriageRecords(ctx);
   309→        const savedRecord = findTriageRecordByInboxRef(savedRecords, inboxItem._ulid) || record;
   310→
   311→        // AC: @trait-api-endpoint ac-5 - Shadow commit
   312→        await commitIfShadow(ctx.shadow, `triage: record ${savedRecord._ulid.slice(0, 8)} as ${savedRecord.action}`);
   313→
   314→        // AC: @triage-daemon-api ac-3 - Broadcast triage:updates via WebSocket
   315→        // AC: @trait-websocket-protocol ac-3 - Broadcast event
   316→        pubsub.broadcast('triage:updates', 'triage_record_created', {
   317→          ulid: savedRecord._ulid,
   318→          inbox_ref: savedRecord.inbox_ref,
   319→          action: savedRecord.action,
   320→        }, projectContext.path);
   321→
   322→        // AC: @trait-api-endpoint ac-1 - Return 2xx with JSON body
   323→        return {
   324→          success: true,
   325→          record: savedRecord,
   326→        };
   327→      },
   328→      {
   329→        body: t.Object({
   330→          inbox_ref: t.String(),
   331→          action: t.String(),
   332→          reasoning: t.String(),
   333→          decided_by: t.Optional(t.String()),
   334→          evidence_refs: t.Optional(t.Array(t.String())),
   335→        }),
   336→      }
   337→    )
   338→
   339→    // GET single triage record
   340→    .get(
   341→      '/:ref',
   342→      async ({ params, error: errorResponse, projectContext }) => {
   343→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   344→        const ctx = await initContext(projectContext.path);
   345→        const records = await loadTriageRecords(ctx);
   346→
   347→        // AC: @trait-api-endpoint ac-2 - Resolve ref
   348→        const record = findTriageRecordByRef(records, params.ref);
   349→        if (!record) {
   350→          return errorResponse(404, {
   351→            error: 'not_found',
   352→            message: `Triage record reference "${params.ref}" not found`,
   353→            suggestion: 'Use kspec triage list or GET /api/triage to find valid triage record references',
   354→          });
   355→        }
   356→
   357→        return record;
   358→      },
   359→      {
   360→        params: t.Object({
   361→          ref: t.String(),
   362→        }),
   363→      }
   364→    )
   365→
   366→    // AC: @triage-daemon-api ac-4 - Override a triage decision
   367→    // AC: @trait-api-endpoint ac-1, ac-5 - JSON response, shadow commit
   368→    .post(
   369→      '/:ref/override',
   370→      async ({ params, body, error: errorResponse, projectContext }) => {
   371→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   372→        const ctx = await initContext(projectContext.path);
   373→        const records = await loadTriageRecords(ctx);
   374→
   375→        // AC: @trait-api-endpoint ac-2 - Resolve ref
   376→        const record = findTriageRecordByRef(records, params.ref);
   377→        if (!record) {
   378→          return errorResponse(404, {
   379→            error: 'not_found',
   380→            message: `Triage record reference "${params.ref}" not found`,
   381→            suggestion: 'Use kspec triage list or GET /api/triage to find valid triage record references',
   382→          });
   383→        }
   384→
   385→        // AC: @trait-api-endpoint ac-3 - Validate action
   386→        if (!VALID_ACTIONS.includes(body.action)) {
   387→          return errorResponse(400, {
   388→            error: 'validation_error',
   389→            details: [
   390→              {
   391→                field: 'action',
   392→                message: `Action must be one of: ${VALID_ACTIONS.join(', ')}`,
   393→              },
   394→            ],
   395→          });
   396→        }
   397→
   398→        const overrideBy = body.override_by || getAuthor(ctx.config?.identity?.author);
   399→
   400→        // AC: @triage-daemon-api ac-4 - Set override fields and update action
   401→        record.override_reasoning = body.reasoning;
   402→        record.override_by = overrideBy;
   403→        record.override_at = new Date().toISOString();
   404→        record.action = body.action as TriageAction;
   405→        record.updated_at = new Date().toISOString();
   406→
   407→        // Re-triage if already acted on (allows re-acting with new action)
   408→        // Clear stale execution metadata to avoid leaking previous action results
   409→        if (record.status === 'acted_on') {
   410→          record.status = 'triaged';
   411→          record.acted_at = undefined;
   412→          record.result_ref = undefined;
   413→        }
   414→
   415→        await saveTriageRecord(ctx, record);
   416→
   417→        // AC: @trait-api-endpoint ac-5 - Shadow commit
   418→        await commitIfShadow(ctx.shadow, `triage: override ${record._ulid.slice(0, 8)}`);
   419→
   420→        // AC: @triage-daemon-api ac-4 - Broadcast triage:updates
   421→        pubsub.broadcast('triage:updates', 'triage_record_updated', {
   422→          ulid: record._ulid,
   423→          action: 'override',
   424→          new_action: record.action,
   425→        }, projectContext.path);
   426→
   427→        return {
   428→          success: true,
   429→          record,
   430→        };
   431→      },
   432→      {
   433→        params: t.Object({
   434→          ref: t.String(),
   435→        }),
   436→        body: t.Object({
   437→          action: t.String(),
   438→          reasoning: t.String(),
   439→          override_by: t.Optional(t.String()),
   440→        }),
   441→      }
   442→    )
   443→
   444→    // AC: @triage-daemon-api ac-5, ac-8, ac-9 - Execute a triage action
   445→    // AC: @trait-api-endpoint ac-1, ac-5 - JSON response, shadow commit
   446→    .post(
   447→      '/:ref/act',
   448→      async ({ params, error: errorResponse, projectContext }) => {
   449→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   450→        const ctx = await initContext(projectContext.path);
   451→        const records = await loadTriageRecords(ctx);
   452→
   453→        // AC: @trait-api-endpoint ac-2 - Resolve ref
   454→        const record = findTriageRecordByRef(records, params.ref);
   455→        if (!record) {
   456→          return errorResponse(404, {
   457→            error: 'not_found',
   458→            message: `Triage record reference "${params.ref}" not found`,
   459→            suggestion: 'Use kspec triage list or GET /api/triage to find valid triage record references',
   460→          });
   461→        }
   462→
   463→        // AC: @triage-daemon-api ac-8 - Already acted on → 409
   464→        if (record.status === 'acted_on') {
   465→          return errorResponse(409, {
   466→            error: 'invalid_transition',
   467→            message: 'Triage record has already been acted on',
   468→            current: record.status,
   469→            suggestion: 'Use override to change the decision before acting again',
   470→          });
   471→        }
   472→
   473→        // AC: @triage-daemon-api ac-9 - Pending (no decision) → 422
   474→        if (record.status === 'pending') {
   475→          return errorResponse(422, {
   476→            error: 'incomplete_record',
   477→            message: 'No decision has been recorded for this triage record. Complete triage first.',
   478→            suggestion: 'Use POST /api/triage to record a decision, or kspec triage record <inbox-ref> --action <action> --reasoning <text>',
   479→          });
   480→        }
   481→
   482→        // AC: @triage-daemon-api ac-5 - Execute the action
   483→        const result = await executeTriageAction(record, ctx);
   484→
   485→        // Transition to acted_on
   486→        record.status = 'acted_on';
   487→        record.acted_at = new Date().toISOString();
   488→        if (result.resultRef) {
   489→          record.result_ref = result.resultRef;
   490→        }
   491→        record.updated_at = new Date().toISOString();
   492→
   493→        await saveTriageRecord(ctx, record);
   494→
   495→        // AC: @trait-api-endpoint ac-5 - Shadow commit
   496→        await commitIfShadow(ctx.shadow, `triage: act ${record._ulid.slice(0, 8)}`);
   497→
   498→        // AC: @triage-daemon-api ac-5 - Broadcast triage:updates
   499→        pubsub.broadcast('triage:updates', 'triage_record_acted', {
   500→          ulid: record._ulid,
   501→          action: record.action,
   502→          result_ref: record.result_ref,
   503→        }, projectContext.path);
   504→
   505→        return {
   506→          success: true,
   507→          record,
   508→        };
   509→      },
   510→      {
   511→        params: t.Object({
   512→          ref: t.String(),
   513→        }),
   514→      }
   515→    );
   516→}
   517→
```