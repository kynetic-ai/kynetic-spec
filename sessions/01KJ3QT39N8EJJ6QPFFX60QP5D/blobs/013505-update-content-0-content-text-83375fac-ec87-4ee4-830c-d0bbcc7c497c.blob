   539→  describe("CLI integration", () => {
   540→    // AC: @doctor-command ac-exit-zero
   541→    // AC: @trait-semantic-exit-codes ac-1
   542→    it("exits with code 0 when healthy (via CLI)", async () => {
   543→      initGitRepo(tempDir);
   544→      await initializeShadow(tempDir, { projectName: "test-project" });
   545→      // Create minimal setup to avoid errors
   546→      await fs.mkdir(path.join(tempDir, ".claude", "hooks"), { recursive: true });
   547→      await fs.writeFile(
   548→        path.join(tempDir, ".claude", "settings.json"),
   549→        JSON.stringify({
   550→          hooks: {
   551→            UserPromptSubmit: [{ hooks: [{ command: "prompt-check" }] }],
   552→          },
   553→        })
   554→      );
   555→      await fs.writeFile(
   556→        path.join(tempDir, "kspec-agents.md"),
   557→        "# Test agents"
   558→      );
   559→      await fs.writeFile(
   560→        path.join(tempDir, ".kspec", ".kspec-agents-hash"),
   561→        JSON.stringify({ metaHash: "test", generatedAt: new Date().toISOString() })
   562→      );
   563→
   564→      const result = kspec("doctor --json", tempDir);
   565→
   566→      // Parse the JSON and verify healthy status
   567→      const report = JSON.parse(result.stdout) as DoctorReport;
   568→
   569→      // AC: @doctor-command ac-exit-zero — exit code 0 when healthy
   570→      expect(result.exitCode).toBe(0);
   571→      // AC: @trait-semantic-exit-codes ac-1 — exit 0 indicates success
   572→      expect(report.overall.healthy).toBe(true);
   573→      expect(report.overall.errorCount).toBe(0);
   574→    });
   575→
   576→    // AC: @doctor-command ac-exit-one
   577→    // AC: @trait-semantic-exit-codes ac-2
   578→    it("exits with code 1 when errors exist (via CLI)", async () => {
   579→      initGitRepo(tempDir);
   580→      // Don't initialize - this creates errors
   581→
   582→      const result = kspec("doctor --json", tempDir, { expectFail: true });
   583→
   584→      expect(result.exitCode).toBe(1); // ERROR (health check failed)
   585→      const report = JSON.parse(result.stdout) as DoctorReport;
   586→      expect(report.overall.healthy).toBe(false);
   587→    });
   588→
   589→    // AC: @doctor-command ac-json-output
   590→    it("outputs valid JSON with --json flag", async () => {
   591→      initGitRepo(tempDir);
   592→      await initializeShadow(tempDir, { projectName: "test-project" });
   593→
   594→      const result = kspec("doctor --json", tempDir, { expectFail: true });
   595→
   596→      // Should parse without error
   597→      const report = JSON.parse(result.stdout);
   598→      expect(report).toHaveProperty("shadow");
   599→      expect(report).toHaveProperty("setup");
   600→      expect(report).toHaveProperty("daemon");
   601→      expect(report).toHaveProperty("overall");
   602→    });
   603→  });
   604→});
