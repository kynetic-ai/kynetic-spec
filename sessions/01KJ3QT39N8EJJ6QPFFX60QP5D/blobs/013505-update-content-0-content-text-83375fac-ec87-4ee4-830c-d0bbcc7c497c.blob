   365→  describe("ac-overall-verdict", () => {
   366→    // AC: @doctor-command ac-overall-verdict
   367→    it("reports healthy when no errors exist", async () => {
   368→      initGitRepo(tempDir);
   369→      await initializeShadow(tempDir, { projectName: "test-project" });
   370→      // Create required setup artifacts to be healthy
   371→      await fs.mkdir(path.join(tempDir, ".claude", "hooks"), { recursive: true });
   372→      await fs.writeFile(
   373→        path.join(tempDir, ".claude", "settings.json"),
   374→        JSON.stringify({
   375→          hooks: {
   376→            UserPromptSubmit: [{ hooks: [{ command: "prompt-check" }] }],
   377→          },
   378→        })
   379→      );
   380→      await fs.writeFile(
   381→        path.join(tempDir, "kspec-agents.md"),
   382→        "# Test agents"
   383→      );
   384→      // Create hash file
   385→      await fs.mkdir(path.join(tempDir, ".kspec"), { recursive: true });
   386→      await fs.writeFile(
   387→        path.join(tempDir, ".kspec", ".kspec-agents-hash"),
   388→        JSON.stringify({ metaHash: "test", generatedAt: new Date().toISOString() })
   389→      );
   390→
   391→      const report = await getDoctorReport(tempDir);
   392→
   393→      // Check overall verdict structure
   394→      expect(report.overall).toHaveProperty("healthy");
   395→      expect(report.overall).toHaveProperty("errorCount");
   396→      expect(report.overall).toHaveProperty("warningCount");
   397→    });
