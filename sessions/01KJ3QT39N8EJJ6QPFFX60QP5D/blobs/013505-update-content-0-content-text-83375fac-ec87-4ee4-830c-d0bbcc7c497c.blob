   448→
   449→      const report = await getDoctorReport(tempDir);
   450→
   451→      const setupErrors = report.setup.checks.filter(
   452→        (c) => c.severity === "error"
   453→      );
   454→      const hasSetupGuidance = setupErrors.some(
   455→        (c) => c.guidance?.includes("kspec setup")
   456→      );
   457→      expect(hasSetupGuidance).toBe(true);
   458→    });
   459→  });
