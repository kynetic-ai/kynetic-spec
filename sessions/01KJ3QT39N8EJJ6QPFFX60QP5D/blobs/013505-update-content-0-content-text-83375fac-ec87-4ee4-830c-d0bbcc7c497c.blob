   262→  describe("ac-daemon-unreachable", () => {
   263→    // AC: @doctor-command ac-daemon-unreachable
   264→    it("shows warning when daemon running but health endpoint unreachable", async () => {
   265→      initGitRepo(tempDir);
   266→      await initializeShadow(tempDir, { projectName: "test-project" });
   267→
   268→      // Mock getDaemonStatus to simulate daemon running but health unreachable
   269→      const daemonStatusModule = await import("../../src/parser/daemon-status.js");
   270→      const originalGetDaemonStatus = daemonStatusModule.getDaemonStatus;
   271→
   272→      vi.spyOn(daemonStatusModule, "getDaemonStatus").mockResolvedValue({
   273→        running: true,
   274→        pid: 12345,
   275→        port: 3456,
   276→        uptime: null,
   277→        healthReachable: false,
   278→      });
   279→
   280→      try {
   281→        const report = await getDoctorReport(tempDir);
   282→
   283→        // Should have daemon-running check as ok (process is alive)
   284→        const runningCheck = report.daemon.checks.find(
   285→          (c) => c.name === "daemon-running"
   286→        );
   287→        expect(runningCheck).toBeDefined();
   288→        expect(runningCheck!.severity).toBe("ok");
   289→        expect(runningCheck!.message).toContain("PID: 12345");
   290→
   291→        // Should have daemon-health check as warning (unreachable)
   292→        const healthCheck = report.daemon.checks.find(
   293→          (c) => c.name === "daemon-health"
   294→        );
   295→        expect(healthCheck).toBeDefined();
   296→        expect(healthCheck!.severity).toBe("warning");
   297→        expect(healthCheck!.message).toContain("unreachable");
   298→        expect(healthCheck!.guidance).toBeDefined();
   299→      } finally {
   300→        vi.restoreAllMocks();
   301→      }
   302→    });
   303→  });
