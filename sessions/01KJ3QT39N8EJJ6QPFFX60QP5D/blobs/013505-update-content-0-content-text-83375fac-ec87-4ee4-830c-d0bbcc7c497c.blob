   232→  describe("ac-daemon-running", () => {
   233→    // AC: @doctor-command ac-daemon-running
   234→    it("includes daemon running check with PID", async () => {
   235→      initGitRepo(tempDir);
   236→      await initializeShadow(tempDir, { projectName: "test-project" });
   237→
   238→      // Mock daemon as not running to isolate from host environment
   239→      const daemonStatusModule = await import("../../src/parser/daemon-status.js");
   240→      vi.spyOn(daemonStatusModule, "getDaemonStatus").mockResolvedValue({
   241→        running: false,
   242→        pid: null,
   243→        port: null,
   244→        uptime: null,
   245→        healthReachable: false,
   246→      });
   247→
   248→      try {
   249→        const report = await getDoctorReport(tempDir);
   250→
   251→        const daemonCheck = report.daemon.checks.find(
