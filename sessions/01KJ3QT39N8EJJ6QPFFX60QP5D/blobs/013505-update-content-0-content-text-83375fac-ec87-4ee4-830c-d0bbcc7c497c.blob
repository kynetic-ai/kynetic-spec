   421→  describe("ac-partial-init", () => {
   422→    // AC: @doctor-command ac-partial-init
   423→    it("shows shadow ok but setup missing when partially initialized", async () => {
   424→      initGitRepo(tempDir);
   425→      await initializeShadow(tempDir, { projectName: "test-project" });
   426→      // Don't run kspec setup - leave hooks/skills/agents.md missing
   427→
   428→      const report = await getDoctorReport(tempDir);
   429→
   430→      // Shadow should be healthy
   431→      expect(report.shadow.initialized).toBe(true);
   432→      const shadowErrors = report.shadow.checks.filter(
   433→        (c) => c.severity === "error"
   434→      );
   435→      expect(shadowErrors.length).toBe(0);
   436→
   437→      // Setup should have errors
   438→      const setupErrors = report.setup.checks.filter(
   439→        (c) => c.severity === "error"
   440→      );
   441→      expect(setupErrors.length).toBeGreaterThan(0);
   442→    });
   443→
   444→    // AC: @doctor-command ac-partial-init
