```
     1→import * as readline from "node:readline";
     2→import { ulid } from "ulid";
     3→import type { Command } from "commander";
     4→import { markMutating } from "../command-annotations.js";
     5→import {
     6→  createObservation,
     7→  createTask,
     8→  deleteInboxItem,
     9→  findInboxItemByRef,
    10→  getAuthor,
    11→  initContext,
    12→  type LoadedInboxItem,
    13→  type LoadedTriageRecord,
    14→  loadAllItems,
    15→  loadAllTasks,
    16→  loadInboxItems,
    17→  loadTriageRecords,
    18→  ReferenceIndex,
    19→  saveObservation,
    20→  saveTask,
    21→  saveTriageRecord,
    22→  findTriageRecordByRef,
    23→} from "../../parser/index.js";
    24→import { commitIfShadow } from "../../parser/shadow.js";
    25→import type { TriageAction, TriageRecord } from "../../schema/index.js";
    26→import { errors } from "../../strings/index.js";
    27→import { formatRelativeTime as formatRelativeTimeUtil } from "../../utils/time.js";
    28→import { EXIT_CODES } from "../exit-codes.js";
    29→import { error, info, output, success } from "../output.js";
    30→
    31→/**
    32→ * Format relative time for display
    33→ */
    34→function formatRelativeTime(dateStr: string): string {
    35→  return formatRelativeTimeUtil(new Date(dateStr));
    36→}
    37→
    38→/**
    39→ * Resolve triage record ref with error handling
    40→ */
    41→function resolveTriageRef(
    42→  ref: string,
    43→  records: LoadedTriageRecord[],
    44→): LoadedTriageRecord {
    45→  const record = findTriageRecordByRef(records, ref);
    46→  if (!record) {
    47→    error(`Triage record not found: ${ref}`);
    48→    process.exit(EXIT_CODES.NOT_FOUND);
    49→  }
    50→  return record;
    51→}
    52→
    53→/**
    54→ * Truncate text for display
    55→ */
    56→function truncateText(text: string, maxLen: number = 60): string {
    57→  const firstLine = text.split("\n")[0].trim();
    58→  if (firstLine.length <= maxLen) return firstLine;
    59→  return `${firstLine.slice(0, maxLen - 3)}...`;
    60→}
    61→
    62→/**
    63→ * Execute a triage action
    64→ * AC: @triage-cli-commands ac-4, ac-5, ac-6, ac-7, ac-8
    65→ */
    66→async function executeTriageAction(
    67→  record: LoadedTriageRecord,
    68→  ctx: Awaited<ReturnType<typeof initContext>>,
    69→  dryRun: boolean = false,
    70→): Promise<{ resultRef?: string }> {
    71→  const action = record.action;
    72→  if (!action) {
    73→    error("Record has no action to execute");
    74→    process.exit(EXIT_CODES.VALIDATION_FAILED);
    75→  }
    76→
    77→  switch (action) {
    78→    case "promote": {
    79→      // AC: @triage-cli-commands ac-4
    80→      if (dryRun) {
    81→        info(`Would create task from inbox item snapshot: "${truncateText(record.item_snapshot)}"`);
    82→        return {};
    83→      }
    84→      const task = createTask({
    85→        title: record.item_snapshot.split("\n")[0].slice(0, 100),
    86→        type: "task",
    87→        priority: 3,
    88→        spec_ref: null,
    89→        tags: [],
    90→        description: record.item_snapshot,
    91→      });
    92→      await saveTask(ctx, task);
    93→      const tasks = await loadAllTasks(ctx);
    94→      const items = await loadAllItems(ctx);
    95→      const index = new ReferenceIndex(tasks, items);
    96→      const taskRef = `@${index.shortUlid(task._ulid)}`;
    97→      info(`Created task: ${taskRef} - ${task.title}`);
    98→      return { resultRef: taskRef };
    99→    }
   100→
   101→    case "delete": {
   102→      // AC: @triage-cli-commands ac-5
   103→      if (dryRun) {
   104→        info(`Would delete inbox item: ${record.inbox_ref.slice(0, 8)}`);
   105→        return {};
   106→      }
   107→      const inboxItems = await loadInboxItems(ctx);
   108→      const inboxItem = findInboxItemByRef(inboxItems, record.inbox_ref);
   109→      if (inboxItem) {
   110→        await deleteInboxItem(ctx, inboxItem._ulid);
   111→        info(`Deleted inbox item: ${record.inbox_ref.slice(0, 8)}`);
   112→      }
   113→      return {};
   114→    }
   115→
   116→    case "defer": {
   117→      // AC: @triage-cli-commands ac-6
   118→      if (dryRun) {
   119→        info(`Would defer: no side effects beyond recording the deferral`);
   120→        return {};
   121→      }
   122→      return {};
   123→    }
   124→
   125→    case "spec-gap": {
   126→      // AC: @triage-cli-commands ac-7
   127→      if (dryRun) {
   128→        info(`Would create spec-gap observation from: "${truncateText(record.item_snapshot)}"`);
   129→        return {};
   130→      }
   131→      const content = `[spec-gap] ${record.item_snapshot}\n\nReasoning: ${record.reasoning || ""}`;
   132→      const observation = createObservation("question", content, {
   133→        configAuthor: ctx.config?.identity?.author,
   134→      });
   135→      await saveObservation(ctx, observation);
   136→      const obsRef = `@${observation._ulid.slice(0, 8)}`;
   137→      info(`Created spec-gap observation: ${obsRef}`);
   138→      return { resultRef: obsRef };
   139→    }
   140→
   141→    case "duplicate": {
   142→      // AC: @triage-cli-commands ac-8
   143→      if (dryRun) {
   144→        info(`Would delete duplicate inbox item: ${record.inbox_ref.slice(0, 8)}`);
   145→        return {};
   146→      }
   147→      const dupItems = await loadInboxItems(ctx);
   148→      const dupItem = findInboxItemByRef(dupItems, record.inbox_ref);
   149→      if (dupItem) {
   150→        await deleteInboxItem(ctx, dupItem._ulid);
   151→        info(`Deleted duplicate inbox item: ${record.inbox_ref.slice(0, 8)}`);
   152→      }
   153→      return {};
   154→    }
   155→  }
   156→}
   157→
   158→/**
   159→ * Format a triage record for context export
   160→ * AC: @triage-cli-commands ac-13
   161→ */
   162→function formatTriageContext(record: TriageRecord): string {
   163→  const lines: string[] = [];
   164→  lines.push(`### ${record._ulid.slice(0, 8)} — ${truncateText(record.item_snapshot, 80)}`);
   165→  lines.push("");
   166→  lines.push(`**Item:** ${record.item_snapshot}`);
   167→  lines.push(`**Status:** ${record.status}`);
   168→  if (record.action) lines.push(`**Action:** ${record.action}`);
   169→  if (record.reasoning) lines.push(`**Reasoning:** ${record.reasoning}`);
   170→  if (record.decided_by) lines.push(`**Decided by:** ${record.decided_by}`);
   171→  if (record.evidence_refs.length > 0) {
   172→    lines.push(`**Evidence:** ${record.evidence_refs.join(", ")}`);
   173→  }
   174→  if (record.override_reasoning) {
   175→    lines.push(`**Override:** ${record.override_reasoning} (by ${record.override_by || "unknown"})`);
   176→  }
   177→  if (record.acted_at) {
   178→    lines.push(`**Acted at:** ${record.acted_at}`);
   179→    if (record.result_ref) lines.push(`**Result:** ${record.result_ref}`);
   180→  }
   181→  lines.push("");
   182→  return lines.join("\n");
   183→}
   184→
   185→/**
   186→ * Register the 'triage' command group
   187→ * AC: @triage-cli-commands ac-1 through ac-17
   188→ */
   189→export function registerTriageCommands(program: Command): void {
   190→  const triage = program
   191→    .command("triage")
   192→    .description("Record, review, and act on triage decisions");
   193→
   194→  // kspec triage record <inbox-ref>
   195→  // AC: @triage-cli-commands ac-1, ac-11
   196→  markMutating(triage.command("record <inbox-ref>"))
   197→    .description("Record a triage decision for an inbox item")
   198→    .requiredOption("--action <action>", "Triage action (promote, delete, defer, spec-gap, duplicate)")
   199→    .requiredOption("--reasoning <text>", "Reasoning for the decision")
   200→    .option("--decided-by <author>", "Who made the decision")
   201→    .option("--evidence <refs...>", "Evidence references")
   202→    .option("--dry-run", "Show what would happen without making changes")
   203→    .addHelpText(
   204→      "after",
   205→      `
   206→Examples:
   207→  $ kspec triage record @ref --action promote --reasoning "clear feature request"
   208→  $ kspec triage record @ref --action defer --reasoning "needs more discussion"`,
   209→    )
   210→    .action(async (inboxRef: string, options) => {
   211→      try {
   212→        const ctx = await initContext();
   213→
   214→        // Validate action
   215→        const validActions = ["promote", "delete", "defer", "spec-gap", "duplicate"];
   216→        if (!validActions.includes(options.action)) {
   217→          error(`Invalid action: ${options.action}. Must be one of: ${validActions.join(", ")}`);
   218→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   219→        }
   220→
   221→        // Resolve inbox item
   222→        const inboxItems = await loadInboxItems(ctx);
   223→        const item = findInboxItemByRef(inboxItems, inboxRef);
   224→        if (!item) {
   225→          error(errors.reference.inboxNotFound(inboxRef));
   226→          process.exit(EXIT_CODES.NOT_FOUND);
   227→        }
   228→
   229→        if (options.dryRun) {
   230→          info(`Would create triage record for inbox item ${item._ulid.slice(0, 8)} with action: ${options.action}`);
   231→          return;
   232→        }
   233→
   234→        const author = options.decidedBy || getAuthor(ctx.config?.identity?.author);
   235→        const evidenceRefs = options.evidence
   236→          ? options.evidence.map((r: string) => r.startsWith("@") ? r : `@${r}`)
   237→          : [];
   238→
   239→        const record: LoadedTriageRecord = {
   240→          _ulid: ulid(),
   241→          inbox_ref: item._ulid,
   242→          item_snapshot: item.text,
   243→          status: "triaged",
   244→          action: options.action as TriageAction,
   245→          reasoning: options.reasoning,
   246→          decided_by: author,
   247→          evidence_refs: evidenceRefs,
   248→          created_at: new Date().toISOString(),
   249→        };
   250→
   251→        await saveTriageRecord(ctx, record);
   252→        await commitIfShadow(
   253→          ctx.shadow,
   254→          "triage-record",
   255→          record._ulid.slice(0, 8),
   256→          options.action,
   257→        );
   258→
   259→        // AC: @triage-cli-commands ac-11 — JSON output
   260→        // AC: @trait-json-output ac-1, ac-2, ac-4, ac-5
   261→        success(`Recorded triage decision: ${record._ulid.slice(0, 8)}`, { record });
   262→      } catch (err) {
   263→        error("Failed to record triage decision", err);
   264→        process.exit(EXIT_CODES.ERROR);
   265→      }
   266→    });
   267→
   268→  // kspec triage list
   269→  // AC: @triage-cli-commands ac-2, ac-3
   270→  triage
   271→    .command("list")
   272→    .description("List triage records")
   273→    .option("--status <status>", "Filter by status (pending, triaged, acted_on)")
   274→    .option("--action <action>", "Filter by action")
   275→    .option("--decided-by <author>", "Filter by decision author")
   276→    .option("--limit <n>", "Limit results")
   277→    .option("--offset <n>", "Skip first N results")
   278→    .option("--count", "Show only the count")
   279→    .action(async (options) => {
   280→      try {
   281→        const ctx = await initContext();
   282→        let records = await loadTriageRecords(ctx);
   283→        const totalCount = records.length;
   284→        const activeFilters: string[] = [];
   285→        let filteredCount: number;
   286→
   287→        // AC: @triage-cli-commands ac-3 — status filter
   288→        // AC: @trait-filterable-list ac-1
   289→        if (options.status) {
   290→          records = records.filter((r) => r.status === options.status);
   291→          activeFilters.push(`status=${options.status}`);
   292→        }
   293→
   294→        // AC: @trait-filterable-list ac-5
   295→        if (options.action) {
   296→          records = records.filter((r) => r.action === options.action);
   297→          activeFilters.push(`action=${options.action}`);
   298→        }
   299→
   300→        if (options.decidedBy) {
   301→          records = records.filter((r) => r.decided_by === options.decidedBy);
   302→          activeFilters.push(`decided_by=${options.decidedBy}`);
   303→        }
   304→
   305→        // Sort by created_at desc (newest first)
   306→        records.sort((a, b) => {
   307→          return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
   308→        });
   309→
   310→        // Capture post-filter count before pagination
   311→        filteredCount = records.length;
   312→
   313→        // AC: @trait-filterable-list ac-8
   314→        if (options.count) {
   315→          output({ count: records.length }, () => {
   316→            console.log(records.length);
   317→          });
   318→          return;
   319→        }
   320→
   321→        // AC: @trait-filterable-list ac-4 — offset
   322→        if (options.offset) {
   323→          const offset = parseInt(options.offset, 10);
   324→          records = records.slice(offset);
   325→        }
   326→
   327→        // AC: @trait-filterable-list ac-3 — limit
   328→        if (options.limit) {
   329→          const limit = parseInt(options.limit, 10);
   330→          records = records.slice(0, limit);
   331→        }
   332→
   333→        // AC: @trait-json-output ac-1, ac-2
   334→        output(records, () => {
   335→          if (records.length === 0) {
   336→            // AC: @trait-filterable-list ac-6
   337→            console.log("No triage records");
   338→            return;
   339→          }
   340→
   341→          // AC: @trait-filterable-list ac-7 — summary with total matching items and filter state
   342→          const filterInfo = activeFilters.length > 0
   343→            ? ` (${activeFilters.join(", ")})`
   344→            : "";
   345→          const showing = filteredCount < totalCount
   346→            ? `${filteredCount} of ${totalCount}`
   347→            : `${filteredCount}`;
   348→          console.log(
   349→            `Triage records (${showing}${filterInfo}):\n`,
   350→          );
   351→
   352→          // AC: @triage-cli-commands ac-2
   353→          for (const record of records) {
   354→            const snapshot = truncateText(record.item_snapshot, 50);
   355→            const age = formatRelativeTime(record.created_at);
   356→            const action = record.action ? ` [${record.action}]` : "";
   357→            const decidedBy = record.decided_by ? ` by ${record.decided_by}` : "";
   358→            console.log(`  ${record._ulid.slice(0, 8)} (${age}${decidedBy}) ${record.status}${action}`);
   359→            console.log(`    ${snapshot}`);
   360→            console.log("");
   361→          }
   362→        });
   363→      } catch (err) {
   364→        error("Failed to list triage records", err);
   365→        process.exit(EXIT_CODES.ERROR);
   366→      }
   367→    });
   368→
   369→  // kspec triage act <triage-ref>
   370→  // AC: @triage-cli-commands ac-4, ac-5, ac-6, ac-7, ac-8, ac-15, ac-16, ac-17
   371→  markMutating(triage.command("act <triage-ref>"))
   372→    .description("Execute a triage decision")
   373→    .option("--dry-run", "Show what would happen without executing")
   374→    .action(async (triageRef: string, options) => {
   375→      try {
   376→        const ctx = await initContext();
   377→        const records = await loadTriageRecords(ctx);
   378→        const record = resolveTriageRef(triageRef, records);
   379→
   380→        // AC: @triage-cli-commands ac-15 — already acted on
   381→        // AC: @trait-error-guidance ac-1, ac-2
   382→        if (record.status === "acted_on") {
   383→          error(`Triage record ${record._ulid.slice(0, 8)} has already been acted on. No further action is possible.`);
   384→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   385→        }
   386→
   387→        // AC: @triage-cli-commands ac-16 — no decision yet
   388→        // AC: @trait-error-guidance ac-1, ac-2
   389→        if (record.status === "pending") {
   390→          error(`Triage record ${record._ulid.slice(0, 8)} has no decision yet. Record a decision first with: kspec triage record <inbox-ref> --action <action> --reasoning <text>`);
   391→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   392→        }
   393→
   394→        // AC: @triage-cli-commands ac-17 — dry run
   395→        if (options.dryRun) {
   396→          info(`Dry run for triage record ${record._ulid.slice(0, 8)}:`);
   397→          await executeTriageAction(record, ctx, true);
   398→          return;
   399→        }
   400→
   401→        // Execute the action
   402→        const result = await executeTriageAction(record, ctx, false);
   403→
   404→        // Transition to acted_on
   405→        record.status = "acted_on";
   406→        record.acted_at = new Date().toISOString();
   407→        if (result.resultRef) {
   408→          record.result_ref = result.resultRef;
   409→        }
   410→        record.updated_at = new Date().toISOString();
   411→
   412→        await saveTriageRecord(ctx, record);
   413→        await commitIfShadow(
   414→          ctx.shadow,
   415→          "triage-act",
   416→          record._ulid.slice(0, 8),
   417→          record.action,
   418→        );
   419→
   420→        success(`Acted on triage record: ${record._ulid.slice(0, 8)} (${record.action})`, { record });
   421→      } catch (err) {
   422→        error("Failed to act on triage record", err);
   423→        process.exit(EXIT_CODES.ERROR);
   424→      }
   425→    });
   426→
   427→  // kspec triage override <triage-ref>
   428→  // AC: @triage-cli-commands ac-12
   429→  markMutating(triage.command("override <triage-ref>"))
   430→    .description("Override an existing triage decision")
   431→    .requiredOption("--action <action>", "New action (promote, delete, defer, spec-gap, duplicate)")
   432→    .requiredOption("--reasoning <text>", "Reasoning for the override")
   433→    .option("--override-by <author>", "Who is overriding")
   434→    .action(async (triageRef: string, options) => {
   435→      try {
   436→        const ctx = await initContext();
   437→        const records = await loadTriageRecords(ctx);
   438→        const record = resolveTriageRef(triageRef, records);
   439→
   440→        // Validate action
   441→        const validActions = ["promote", "delete", "defer", "spec-gap", "duplicate"];
   442→        if (!validActions.includes(options.action)) {
   443→          error(`Invalid action: ${options.action}. Must be one of: ${validActions.join(", ")}`);
   444→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   445→        }
   446→
   447→        const overrideBy = options.overrideBy || getAuthor(ctx.config?.identity?.author);
   448→
   449→        // AC: @triage-cli-commands ac-12
   450→        record.override_reasoning = options.reasoning;
   451→        record.override_by = overrideBy;
   452→        record.override_at = new Date().toISOString();
   453→        record.action = options.action as TriageAction;
   454→
   455→        // Ensure status is triaged (for re-acting after override)
   456→        if (record.status === "acted_on") {
   457→          record.status = "triaged";
   458→        }
   459→
   460→        await saveTriageRecord(ctx, record);
   461→        await commitIfShadow(
   462→          ctx.shadow,
   463→          "triage-override",
   464→          record._ulid.slice(0, 8),
   465→          options.action,
   466→        );
   467→
   468→        success(`Overrode triage decision: ${record._ulid.slice(0, 8)} → ${options.action}`, { record });
   469→      } catch (err) {
   470→        error("Failed to override triage decision", err);
   471→        process.exit(EXIT_CODES.ERROR);
   472→      }
   473→    });
   474→
   475→  // kspec triage export
   476→  // AC: @triage-cli-commands ac-13, ac-14
   477→  triage
   478→    .command("export")
   479→    .description("Export triage decisions for agent handoff")
   480→    .requiredOption("--format <format>", "Export format (context, json)")
   481→    .option("--status <status>", "Filter by status")
   482→    .action(async (options) => {
   483→      try {
   484→        const ctx = await initContext();
   485→        let records = await loadTriageRecords(ctx);
   486→
   487→        if (options.status) {
   488→          records = records.filter((r) => r.status === options.status);
   489→        }
   490→
   491→        const validFormats = ["context", "json"];
   492→        if (!validFormats.includes(options.format)) {
   493→          error(`Invalid format: ${options.format}. Must be one of: ${validFormats.join(", ")}`);
   494→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   495→        }
   496→
   497→        // AC: @trait-json-output ac-6 — --json takes precedence over --format
   498→        // AC: @triage-cli-commands ac-13, ac-14
   499→        output(records, () => {
   500→          if (options.format === "json") {
   501→            // AC: @triage-cli-commands ac-14
   502→            console.log(JSON.stringify(records, null, 2));
   503→          } else {
   504→            // AC: @triage-cli-commands ac-13 — context format
   505→            if (records.length === 0) {
   506→              console.log("No triage decisions recorded.");
   507→              return;
   508→            }
   509→            console.log("# Triage Decisions\n");
   510→            for (const record of records) {
   511→              console.log(formatTriageContext(record));
   512→            }
   513→          }
   514→        });
   515→      } catch (err) {
   516→        error("Failed to export triage records", err);
   517→        process.exit(EXIT_CODES.ERROR);
   518→      }
   519→    });
   520→
   521→  // kspec triage start
   522→  // AC: @triage-cli-commands ac-9, ac-10
   523→  markMutating(triage.command("start"))
   524→    .description("Start interactive triage of inbox items")
   525→    .action(async () => {
   526→      try {
   527→        const ctx = await initContext();
   528→        const inboxItems = await loadInboxItems(ctx);
   529→        const existingRecords = await loadTriageRecords(ctx);
   530→
   531→        // Find untriaged items (no existing triage record)
   532→        const triagedInboxRefs = new Set(existingRecords.map((r) => r.inbox_ref));
   533→        const untriaged = inboxItems.filter((item) => !triagedInboxRefs.has(item._ulid));
   534→
   535→        if (untriaged.length === 0) {
   536→          info("No untriaged inbox items");
   537→          return;
   538→        }
   539→
   540→        console.log(`\nInteractive triage: ${untriaged.length} item(s) to review\n`);
   541→        console.log("Actions: promote, delete, defer, spec-gap, duplicate, skip\n");
   542→
   543→        const validActions = ["promote", "delete", "defer", "spec-gap", "duplicate", "skip"];
   544→        let triaged = 0;
   545→
   546→        // Use a line-buffering approach for interactive prompts.
   547→        // readline.question() has issues with piped stdin because the close
   548→        // event can fire before subsequent question() calls process buffered lines.
   549→        // Instead, we collect lines via the 'line' event and read from the buffer.
   550→        const lineBuffer: string[] = [];
   551→        let lineResolve: ((value: string | null) => void) | null = null;
   552→        let inputClosed = false;
   553→
   554→        const rl = readline.createInterface({
   555→          input: process.stdin,
   556→          output: process.stdout,
   557→          terminal: false,
   558→        });
   559→
   560→        rl.on("line", (line) => {
   561→          if (lineResolve) {
   562→            const resolve = lineResolve;
   563→            lineResolve = null;
   564→            resolve(line.trim());
   565→          } else {
   566→            lineBuffer.push(line.trim());
   567→          }
   568→        });
   569→
   570→        rl.on("close", () => {
   571→          inputClosed = true;
   572→          if (lineResolve) {
   573→            const resolve = lineResolve;
   574→            lineResolve = null;
   575→            resolve(null);
   576→          }
   577→        });
   578→
   579→        const askQuestion = (question: string): Promise<string | null> => {
   580→          process.stdout.write(question);
   581→          if (lineBuffer.length > 0) {
   582→            return Promise.resolve(lineBuffer.shift()!);
   583→          }
   584→          if (inputClosed) return Promise.resolve(null);
   585→          return new Promise((resolve) => {
   586→            lineResolve = resolve;
   587→          });
   588→        };
   589→
   590→        // AC: @triage-cli-commands ac-9 — present items one at a time
   591→        for (const item of untriaged) {
   592→          console.log("─".repeat(60));
   593→          console.log(`Item: ${item._ulid.slice(0, 8)} (${formatRelativeTime(item.created_at)})`);
   594→          if (item.tags.length > 0) {
   595→            console.log(`Tags: ${item.tags.join(", ")}`);
   596→          }
   597→          if (item.added_by) {
   598→            console.log(`Added by: ${item.added_by}`);
   599→          }
   600→          console.log("");
   601→          console.log(item.text);
   602→          console.log("");
   603→
   604→          // AC: @triage-cli-commands ac-10 — Ctrl+C preserves committed records
   605→          const action = await askQuestion("Action (promote/delete/defer/spec-gap/duplicate/skip): ");
   606→
   607→          if (action === null) {
   608→            // Ctrl+C or closed input
   609→            console.log(`\nTriage interrupted. ${triaged} record(s) saved.`);
   610→            rl.close();
   611→            return;
   612→          }
   613→
   614→          if (!action || action === "skip") {
   615→            console.log("Skipped\n");
   616→            continue;
   617→          }
   618→
   619→          if (!validActions.includes(action)) {
   620→            console.log(`Invalid action: ${action}. Skipping.\n`);
   621→            continue;
   622→          }
   623→
   624→          const reasoning = await askQuestion("Reasoning: ");
   625→
   626→          if (reasoning === null) {
   627→            console.log(`\nTriage interrupted. ${triaged} record(s) saved.`);
   628→            rl.close();
   629→            return;
   630→          }
   631→
   632→          if (!reasoning) {
   633→            console.log("Reasoning required. Skipping.\n");
   634→            continue;
   635→          }
   636→
   637→          const author = getAuthor(ctx.config?.identity?.author);
   638→
   639→          const record: LoadedTriageRecord = {
   640→            _ulid: ulid(),
   641→            inbox_ref: item._ulid,
   642→            item_snapshot: item.text,
   643→            status: "triaged",
   644→            action: action as TriageAction,
   645→            reasoning,
   646→            decided_by: author,
   647→            evidence_refs: [],
   648→            created_at: new Date().toISOString(),
   649→          };
   650→
   651→          await saveTriageRecord(ctx, record);
   652→          await commitIfShadow(
   653→            ctx.shadow,
   654→            "triage-record",
   655→            record._ulid.slice(0, 8),
   656→            action,
   657→          );
   658→
   659→          triaged++;
   660→          console.log(`Recorded: ${record._ulid.slice(0, 8)} → ${action}\n`);
   661→        }
   662→
   663→        rl.close();
   664→        console.log(`\nTriage complete. ${triaged} record(s) created.`);
   665→      } catch (err) {
   666→        error("Failed to start interactive triage", err);
   667→        process.exit(EXIT_CODES.ERROR);
   668→      }
   669→    });
   670→
   671→  // kspec triage get <triage-ref>
   672→  triage
   673→    .command("get <triage-ref>")
   674→    .description("Show details of a triage record")
   675→    .action(async (triageRef: string) => {
   676→      try {
   677→        const ctx = await initContext();
   678→        const records = await loadTriageRecords(ctx);
   679→        const record = resolveTriageRef(triageRef, records);
   680→
   681→        output(record, () => {
   682→          console.log(`ULID:        ${record._ulid}`);
   683→          console.log(`Inbox ref:   ${record.inbox_ref}`);
   684→          console.log(`Status:      ${record.status}`);
   685→          if (record.action) console.log(`Action:      ${record.action}`);
   686→          if (record.reasoning) console.log(`Reasoning:   ${record.reasoning}`);
   687→          if (record.decided_by) console.log(`Decided by:  ${record.decided_by}`);
   688→          if (record.evidence_refs.length > 0) {
   689→            console.log(`Evidence:    ${record.evidence_refs.join(", ")}`);
   690→          }
   691→          console.log(`Created:     ${record.created_at} (${formatRelativeTime(record.created_at)})`);
   692→          if (record.updated_at) {
   693→            console.log(`Updated:     ${record.updated_at}`);
   694→          }
   695→          if (record.override_reasoning) {
   696→            console.log("");
   697→            console.log("Override:");
   698→            console.log(`  Reasoning: ${record.override_reasoning}`);
   699→            if (record.override_by) console.log(`  By:        ${record.override_by}`);
   700→            if (record.override_at) console.log(`  At:        ${record.override_at}`);
   701→          }
   702→          if (record.acted_at) {
   703→            console.log("");
   704→            console.log(`Acted at:    ${record.acted_at}`);
   705→            if (record.result_ref) console.log(`Result ref:  ${record.result_ref}`);
   706→          }
   707→          console.log("");
   708→          console.log("Item snapshot:");
   709→          console.log(record.item_snapshot);
   710→        });
   711→      } catch (err) {
   712→        error("Failed to get triage record", err);
   713→        process.exit(EXIT_CODES.ERROR);
   714→      }
   715→    });
   716→}
   717→
```