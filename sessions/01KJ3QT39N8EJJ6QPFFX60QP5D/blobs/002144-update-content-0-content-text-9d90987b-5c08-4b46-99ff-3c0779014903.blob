```
     1→import * as readline from "node:readline";
     2→import { ulid } from "ulid";
     3→import type { Command } from "commander";
     4→import { markMutating } from "../command-annotations.js";
     5→import {
     6→  createObservation,
     7→  createTask,
     8→  deleteInboxItem,
     9→  findInboxItemByRef,
    10→  getAuthor,
    11→  initContext,
    12→  type LoadedInboxItem,
    13→  type LoadedTriageRecord,
    14→  loadAllItems,
    15→  loadAllTasks,
    16→  loadInboxItems,
    17→  loadTriageRecords,
    18→  ReferenceIndex,
    19→  saveObservation,
    20→  saveTask,
    21→  saveTriageRecord,
    22→  findTriageRecordByRef,
    23→} from "../../parser/index.js";
    24→import { commitIfShadow } from "../../parser/shadow.js";
    25→import type { TriageAction, TriageRecord } from "../../schema/index.js";
    26→import { errors } from "../../strings/index.js";
    27→import { formatRelativeTime as formatRelativeTimeUtil } from "../../utils/time.js";
    28→import { EXIT_CODES } from "../exit-codes.js";
    29→import { error, info, output, success } from "../output.js";
    30→
    31→/**
    32→ * Format relative time for display
    33→ */
    34→function formatRelativeTime(dateStr: string): string {
    35→  return formatRelativeTimeUtil(new Date(dateStr));
    36→}
    37→
    38→/**
    39→ * Resolve triage record ref with error handling
    40→ */
    41→function resolveTriageRef(
    42→  ref: string,
    43→  records: LoadedTriageRecord[],
    44→): LoadedTriageRecord {
    45→  const record = findTriageRecordByRef(records, ref);
    46→  if (!record) {
    47→    error(`Triage record not found: ${ref}`);
    48→    process.exit(EXIT_CODES.NOT_FOUND);
    49→  }
    50→  return record;
    51→}
    52→
    53→/**
    54→ * Simple prompt for user input
    55→ */
    56→async function prompt(question: string): Promise<string> {
    57→  const rl = readline.createInterface({
    58→    input: process.stdin,
    59→    output: process.stdout,
    60→  });
    61→
    62→  return new Promise((resolve) => {
    63→    rl.question(question, (answer) => {
    64→      rl.close();
    65→      resolve(answer.trim());
    66→    });
    67→  });
    68→}
    69→
    70→/**
    71→ * Truncate text for display
    72→ */
    73→function truncateText(text: string, maxLen: number = 60): string {
    74→  const firstLine = text.split("\n")[0].trim();
    75→  if (firstLine.length <= maxLen) return firstLine;
    76→  return `${firstLine.slice(0, maxLen - 3)}...`;
    77→}
    78→
    79→/**
    80→ * Execute a triage action
    81→ * AC: @triage-cli-commands ac-4, ac-5, ac-6, ac-7, ac-8
    82→ */
    83→async function executeTriageAction(
    84→  record: LoadedTriageRecord,
    85→  ctx: Awaited<ReturnType<typeof initContext>>,
    86→  dryRun: boolean = false,
    87→): Promise<{ resultRef?: string }> {
    88→  const action = record.override_reasoning ? (record.action as TriageAction) : record.action;
    89→  if (!action) {
    90→    error("Record has no action to execute");
    91→    process.exit(EXIT_CODES.VALIDATION_FAILED);
    92→  }
    93→
    94→  switch (action) {
    95→    case "promote": {
    96→      // AC: @triage-cli-commands ac-4
    97→      if (dryRun) {
    98→        info(`Would create task from inbox item snapshot: "${truncateText(record.item_snapshot)}"`);
    99→        return {};
   100→      }
   101→      const task = createTask({
   102→        title: record.item_snapshot.split("\n")[0].slice(0, 100),
   103→        type: "task",
   104→        priority: 3,
   105→        spec_ref: null,
   106→        tags: [],
   107→        description: record.item_snapshot,
   108→      });
   109→      await saveTask(ctx, task);
   110→      const tasks = await loadAllTasks(ctx);
   111→      const items = await loadAllItems(ctx);
   112→      const index = new ReferenceIndex(tasks, items);
   113→      const taskRef = `@${index.shortUlid(task._ulid)}`;
   114→      info(`Created task: ${taskRef} - ${task.title}`);
   115→      return { resultRef: taskRef };
   116→    }
   117→
   118→    case "delete": {
   119→      // AC: @triage-cli-commands ac-5
   120→      if (dryRun) {
   121→        info(`Would delete inbox item: ${record.inbox_ref.slice(0, 8)}`);
   122→        return {};
   123→      }
   124→      const inboxItems = await loadInboxItems(ctx);
   125→      const inboxItem = findInboxItemByRef(inboxItems, record.inbox_ref);
   126→      if (inboxItem) {
   127→        await deleteInboxItem(ctx, inboxItem._ulid);
   128→        info(`Deleted inbox item: ${record.inbox_ref.slice(0, 8)}`);
   129→      }
   130→      return {};
   131→    }
   132→
   133→    case "defer": {
   134→      // AC: @triage-cli-commands ac-6
   135→      if (dryRun) {
   136→        info(`Would defer: no side effects beyond recording the deferral`);
   137→        return {};
   138→      }
   139→      return {};
   140→    }
   141→
   142→    case "spec-gap": {
   143→      // AC: @triage-cli-commands ac-7
   144→      if (dryRun) {
   145→        info(`Would create spec-gap observation from: "${truncateText(record.item_snapshot)}"`);
   146→        return {};
   147→      }
   148→      const content = `${record.item_snapshot}\n\nReasoning: ${record.reasoning || ""}`;
   149→      const observation = createObservation("idea", content, {
   150→        configAuthor: ctx.config?.identity?.author,
   151→      });
   152→      await saveObservation(ctx, observation);
   153→      const obsRef = `@${observation._ulid.slice(0, 8)}`;
   154→      info(`Created spec-gap observation: ${obsRef}`);
   155→      return { resultRef: obsRef };
   156→    }
   157→
   158→    case "duplicate": {
   159→      // AC: @triage-cli-commands ac-8
   160→      if (dryRun) {
   161→        info(`Would delete duplicate inbox item: ${record.inbox_ref.slice(0, 8)}`);
   162→        return {};
   163→      }
   164→      const dupItems = await loadInboxItems(ctx);
   165→      const dupItem = findInboxItemByRef(dupItems, record.inbox_ref);
   166→      if (dupItem) {
   167→        await deleteInboxItem(ctx, dupItem._ulid);
   168→        info(`Deleted duplicate inbox item: ${record.inbox_ref.slice(0, 8)}`);
   169→      }
   170→      return {};
   171→    }
   172→  }
   173→}
   174→
   175→/**
   176→ * Format a triage record for context export
   177→ * AC: @triage-cli-commands ac-13
   178→ */
   179→function formatTriageContext(record: TriageRecord): string {
   180→  const lines: string[] = [];
   181→  lines.push(`### ${record._ulid.slice(0, 8)} — ${truncateText(record.item_snapshot, 80)}`);
   182→  lines.push("");
   183→  lines.push(`**Item:** ${record.item_snapshot}`);
   184→  lines.push(`**Status:** ${record.status}`);
   185→  if (record.action) lines.push(`**Action:** ${record.action}`);
   186→  if (record.reasoning) lines.push(`**Reasoning:** ${record.reasoning}`);
   187→  if (record.decided_by) lines.push(`**Decided by:** ${record.decided_by}`);
   188→  if (record.evidence_refs.length > 0) {
   189→    lines.push(`**Evidence:** ${record.evidence_refs.join(", ")}`);
   190→  }
   191→  if (record.override_reasoning) {
   192→    lines.push(`**Override:** ${record.override_reasoning} (by ${record.override_by || "unknown"})`);
   193→  }
   194→  if (record.acted_at) {
   195→    lines.push(`**Acted at:** ${record.acted_at}`);
   196→    if (record.result_ref) lines.push(`**Result:** ${record.result_ref}`);
   197→  }
   198→  lines.push("");
   199→  return lines.join("\n");
   200→}
   201→
   202→/**
   203→ * Register the 'triage' command group
   204→ * AC: @triage-cli-commands ac-1 through ac-17
   205→ */
   206→export function registerTriageCommands(program: Command): void {
   207→  const triage = program
   208→    .command("triage")
   209→    .description("Record, review, and act on triage decisions");
   210→
   211→  // kspec triage record <inbox-ref>
   212→  // AC: @triage-cli-commands ac-1, ac-11
   213→  markMutating(triage.command("record <inbox-ref>"))
   214→    .description("Record a triage decision for an inbox item")
   215→    .requiredOption("--action <action>", "Triage action (promote, delete, defer, spec-gap, duplicate)")
   216→    .requiredOption("--reasoning <text>", "Reasoning for the decision")
   217→    .option("--decided-by <author>", "Who made the decision")
   218→    .option("--evidence <refs...>", "Evidence references")
   219→    .option("--dry-run", "Show what would happen without making changes")
   220→    .addHelpText(
   221→      "after",
   222→      `
   223→Examples:
   224→  $ kspec triage record @ref --action promote --reasoning "clear feature request"
   225→  $ kspec triage record @ref --action defer --reasoning "needs more discussion"`,
   226→    )
   227→    .action(async (inboxRef: string, options) => {
   228→      try {
   229→        const ctx = await initContext();
   230→
   231→        // Validate action
   232→        const validActions = ["promote", "delete", "defer", "spec-gap", "duplicate"];
   233→        if (!validActions.includes(options.action)) {
   234→          error(`Invalid action: ${options.action}. Must be one of: ${validActions.join(", ")}`);
   235→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   236→        }
   237→
   238→        // Resolve inbox item
   239→        const inboxItems = await loadInboxItems(ctx);
   240→        const item = findInboxItemByRef(inboxItems, inboxRef);
   241→        if (!item) {
   242→          error(errors.reference.inboxNotFound(inboxRef));
   243→          process.exit(EXIT_CODES.NOT_FOUND);
   244→        }
   245→
   246→        if (options.dryRun) {
   247→          info(`Would create triage record for inbox item ${item._ulid.slice(0, 8)} with action: ${options.action}`);
   248→          return;
   249→        }
   250→
   251→        const author = options.decidedBy || getAuthor(ctx.config?.identity?.author);
   252→        const evidenceRefs = options.evidence
   253→          ? options.evidence.map((r: string) => r.startsWith("@") ? r : `@${r}`)
   254→          : [];
   255→
   256→        const record: LoadedTriageRecord = {
   257→          _ulid: ulid(),
   258→          inbox_ref: item._ulid,
   259→          item_snapshot: item.text,
   260→          status: "triaged",
   261→          action: options.action as TriageAction,
   262→          reasoning: options.reasoning,
   263→          decided_by: author,
   264→          evidence_refs: evidenceRefs,
   265→          created_at: new Date().toISOString(),
   266→        };
   267→
   268→        await saveTriageRecord(ctx, record);
   269→        await commitIfShadow(
   270→          ctx.shadow,
   271→          "triage-record",
   272→          record._ulid.slice(0, 8),
   273→          options.action,
   274→        );
   275→
   276→        // AC: @triage-cli-commands ac-11 — JSON output
   277→        // AC: @trait-json-output ac-1, ac-2, ac-4, ac-5
   278→        success(`Recorded triage decision: ${record._ulid.slice(0, 8)}`, { record });
   279→      } catch (err) {
   280→        error("Failed to record triage decision", err);
   281→        process.exit(EXIT_CODES.ERROR);
   282→      }
   283→    });
   284→
   285→  // kspec triage list
   286→  // AC: @triage-cli-commands ac-2, ac-3
   287→  triage
   288→    .command("list")
   289→    .description("List triage records")
   290→    .option("--status <status>", "Filter by status (pending, triaged, acted_on)")
   291→    .option("--action <action>", "Filter by action")
   292→    .option("--limit <n>", "Limit results")
   293→    .option("--count", "Show only the count")
   294→    .action(async (options) => {
   295→      try {
   296→        const ctx = await initContext();
   297→        let records = await loadTriageRecords(ctx);
   298→
   299→        // AC: @triage-cli-commands ac-3 — status filter
   300→        // AC: @trait-filterable-list ac-1
   301→        if (options.status) {
   302→          records = records.filter((r) => r.status === options.status);
   303→        }
   304→
   305→        if (options.action) {
   306→          records = records.filter((r) => r.action === options.action);
   307→        }
   308→
   309→        // Sort by created_at desc (newest first)
   310→        records.sort((a, b) => {
   311→          return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
   312→        });
   313→
   314→        // AC: @trait-filterable-list ac-8
   315→        if (options.count) {
   316→          output({ count: records.length }, () => {
   317→            console.log(records.length);
   318→          });
   319→          return;
   320→        }
   321→
   322→        if (options.limit) {
   323→          const limit = parseInt(options.limit, 10);
   324→          records = records.slice(0, limit);
   325→        }
   326→
   327→        // AC: @trait-json-output ac-1, ac-2
   328→        output(records, () => {
   329→          if (records.length === 0) {
   330→            console.log("No triage records");
   331→            return;
   332→          }
   333→
   334→          console.log(
   335→            `Triage records (${records.length}):\n`,
   336→          );
   337→
   338→          // AC: @triage-cli-commands ac-2
   339→          for (const record of records) {
   340→            const snapshot = truncateText(record.item_snapshot, 50);
   341→            const age = formatRelativeTime(record.created_at);
   342→            const action = record.action ? ` [${record.action}]` : "";
   343→            const decidedBy = record.decided_by ? ` by ${record.decided_by}` : "";
   344→            console.log(`  ${record._ulid.slice(0, 8)} (${age}${decidedBy}) ${record.status}${action}`);
   345→            console.log(`    ${snapshot}`);
   346→            console.log("");
   347→          }
   348→        });
   349→      } catch (err) {
   350→        error("Failed to list triage records", err);
   351→        process.exit(EXIT_CODES.ERROR);
   352→      }
   353→    });
   354→
   355→  // kspec triage act <triage-ref>
   356→  // AC: @triage-cli-commands ac-4, ac-5, ac-6, ac-7, ac-8, ac-15, ac-16, ac-17
   357→  markMutating(triage.command("act <triage-ref>"))
   358→    .description("Execute a triage decision")
   359→    .option("--dry-run", "Show what would happen without executing")
   360→    .action(async (triageRef: string, options) => {
   361→      try {
   362→        const ctx = await initContext();
   363→        const records = await loadTriageRecords(ctx);
   364→        const record = resolveTriageRef(triageRef, records);
   365→
   366→        // AC: @triage-cli-commands ac-15 — already acted on
   367→        // AC: @trait-error-guidance ac-1, ac-2
   368→        if (record.status === "acted_on") {
   369→          error(`Triage record ${record._ulid.slice(0, 8)} has already been acted on. No further action is possible.`);
   370→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   371→        }
   372→
   373→        // AC: @triage-cli-commands ac-16 — no decision yet
   374→        // AC: @trait-error-guidance ac-1, ac-2
   375→        if (record.status === "pending") {
   376→          error(`Triage record ${record._ulid.slice(0, 8)} has no decision yet. Record a decision first with: kspec triage record <inbox-ref> --action <action> --reasoning <text>`);
   377→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   378→        }
   379→
   380→        // AC: @triage-cli-commands ac-17 — dry run
   381→        if (options.dryRun) {
   382→          info(`Dry run for triage record ${record._ulid.slice(0, 8)}:`);
   383→          await executeTriageAction(record, ctx, true);
   384→          return;
   385→        }
   386→
   387→        // Execute the action
   388→        const result = await executeTriageAction(record, ctx, false);
   389→
   390→        // Transition to acted_on
   391→        record.status = "acted_on";
   392→        record.acted_at = new Date().toISOString();
   393→        if (result.resultRef) {
   394→          record.result_ref = result.resultRef;
   395→        }
   396→        record.updated_at = new Date().toISOString();
   397→
   398→        await saveTriageRecord(ctx, record);
   399→        await commitIfShadow(
   400→          ctx.shadow,
   401→          "triage-act",
   402→          record._ulid.slice(0, 8),
   403→          record.action,
   404→        );
   405→
   406→        success(`Acted on triage record: ${record._ulid.slice(0, 8)} (${record.action})`, { record });
   407→      } catch (err) {
   408→        error("Failed to act on triage record", err);
   409→        process.exit(EXIT_CODES.ERROR);
   410→      }
   411→    });
   412→
   413→  // kspec triage override <triage-ref>
   414→  // AC: @triage-cli-commands ac-12
   415→  markMutating(triage.command("override <triage-ref>"))
   416→    .description("Override an existing triage decision")
   417→    .requiredOption("--action <action>", "New action (promote, delete, defer, spec-gap, duplicate)")
   418→    .requiredOption("--reasoning <text>", "Reasoning for the override")
   419→    .option("--override-by <author>", "Who is overriding")
   420→    .action(async (triageRef: string, options) => {
   421→      try {
   422→        const ctx = await initContext();
   423→        const records = await loadTriageRecords(ctx);
   424→        const record = resolveTriageRef(triageRef, records);
   425→
   426→        // Validate action
   427→        const validActions = ["promote", "delete", "defer", "spec-gap", "duplicate"];
   428→        if (!validActions.includes(options.action)) {
   429→          error(`Invalid action: ${options.action}. Must be one of: ${validActions.join(", ")}`);
   430→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   431→        }
   432→
   433→        const overrideBy = options.overrideBy || getAuthor(ctx.config?.identity?.author);
   434→
   435→        // AC: @triage-cli-commands ac-12
   436→        record.override_reasoning = options.reasoning;
   437→        record.override_by = overrideBy;
   438→        record.override_at = new Date().toISOString();
   439→        record.action = options.action as TriageAction;
   440→
   441→        // Ensure status is triaged (for re-acting after override)
   442→        if (record.status === "acted_on") {
   443→          record.status = "triaged";
   444→        }
   445→
   446→        await saveTriageRecord(ctx, record);
   447→        await commitIfShadow(
   448→          ctx.shadow,
   449→          "triage-override",
   450→          record._ulid.slice(0, 8),
   451→          options.action,
   452→        );
   453→
   454→        success(`Overrode triage decision: ${record._ulid.slice(0, 8)} → ${options.action}`, { record });
   455→      } catch (err) {
   456→        error("Failed to override triage decision", err);
   457→        process.exit(EXIT_CODES.ERROR);
   458→      }
   459→    });
   460→
   461→  // kspec triage export
   462→  // AC: @triage-cli-commands ac-13, ac-14
   463→  triage
   464→    .command("export")
   465→    .description("Export triage decisions for agent handoff")
   466→    .requiredOption("--format <format>", "Export format (context, json)")
   467→    .option("--status <status>", "Filter by status")
   468→    .action(async (options) => {
   469→      try {
   470→        const ctx = await initContext();
   471→        let records = await loadTriageRecords(ctx);
   472→
   473→        if (options.status) {
   474→          records = records.filter((r) => r.status === options.status);
   475→        }
   476→
   477→        if (options.format === "json") {
   478→          // AC: @triage-cli-commands ac-14
   479→          // AC: @trait-json-output ac-1, ac-2, ac-5
   480→          console.log(JSON.stringify(records, null, 2));
   481→        } else if (options.format === "context") {
   482→          // AC: @triage-cli-commands ac-13
   483→          if (records.length === 0) {
   484→            console.log("No triage decisions recorded.");
   485→            return;
   486→          }
   487→          console.log("# Triage Decisions\n");
   488→          for (const record of records) {
   489→            console.log(formatTriageContext(record));
   490→          }
   491→        } else {
   492→          error(`Invalid format: ${options.format}. Must be one of: context, json`);
   493→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   494→        }
   495→      } catch (err) {
   496→        error("Failed to export triage records", err);
   497→        process.exit(EXIT_CODES.ERROR);
   498→      }
   499→    });
   500→
   501→  // kspec triage start
   502→  // AC: @triage-cli-commands ac-9, ac-10
   503→  markMutating(triage.command("start"))
   504→    .description("Start interactive triage of inbox items")
   505→    .action(async () => {
   506→      try {
   507→        const ctx = await initContext();
   508→        const inboxItems = await loadInboxItems(ctx);
   509→        const existingRecords = await loadTriageRecords(ctx);
   510→
   511→        // Find untriaged items (no existing triage record)
   512→        const triagedInboxRefs = new Set(existingRecords.map((r) => r.inbox_ref));
   513→        const untriaged = inboxItems.filter((item) => !triagedInboxRefs.has(item._ulid));
   514→
   515→        if (untriaged.length === 0) {
   516→          info("No untriaged inbox items");
   517→          return;
   518→        }
   519→
   520→        console.log(`\nInteractive triage: ${untriaged.length} item(s) to review\n`);
   521→        console.log("Actions: promote, delete, defer, spec-gap, duplicate, skip\n");
   522→
   523→        const validActions = ["promote", "delete", "defer", "spec-gap", "duplicate", "skip"];
   524→        let triaged = 0;
   525→
   526→        // Use a line-buffering approach for interactive prompts.
   527→        // readline.question() has issues with piped stdin because the close
   528→        // event can fire before subsequent question() calls process buffered lines.
   529→        // Instead, we collect lines via the 'line' event and read from the buffer.
   530→        const lineBuffer: string[] = [];
   531→        let lineResolve: ((value: string | null) => void) | null = null;
   532→        let inputClosed = false;
   533→
   534→        const rl = readline.createInterface({
   535→          input: process.stdin,
   536→          output: process.stdout,
   537→          terminal: false,
   538→        });
   539→
   540→        rl.on("line", (line) => {
   541→          if (lineResolve) {
   542→            const resolve = lineResolve;
   543→            lineResolve = null;
   544→            resolve(line.trim());
   545→          } else {
   546→            lineBuffer.push(line.trim());
   547→          }
   548→        });
   549→
   550→        rl.on("close", () => {
   551→          inputClosed = true;
   552→          if (lineResolve) {
   553→            const resolve = lineResolve;
   554→            lineResolve = null;
   555→            resolve(null);
   556→          }
   557→        });
   558→
   559→        const askQuestion = (question: string): Promise<string | null> => {
   560→          process.stdout.write(question);
   561→          if (lineBuffer.length > 0) {
   562→            return Promise.resolve(lineBuffer.shift()!);
   563→          }
   564→          if (inputClosed) return Promise.resolve(null);
   565→          return new Promise((resolve) => {
   566→            lineResolve = resolve;
   567→          });
   568→        };
   569→
   570→        // AC: @triage-cli-commands ac-9 — present items one at a time
   571→        for (const item of untriaged) {
   572→          console.log("─".repeat(60));
   573→          console.log(`Item: ${item._ulid.slice(0, 8)} (${formatRelativeTime(item.created_at)})`);
   574→          if (item.tags.length > 0) {
   575→            console.log(`Tags: ${item.tags.join(", ")}`);
   576→          }
   577→          if (item.added_by) {
   578→            console.log(`Added by: ${item.added_by}`);
   579→          }
   580→          console.log("");
   581→          console.log(item.text);
   582→          console.log("");
   583→
   584→          // AC: @triage-cli-commands ac-10 — Ctrl+C preserves committed records
   585→          const action = await askQuestion("Action (promote/delete/defer/spec-gap/duplicate/skip): ");
   586→
   587→          if (action === null) {
   588→            // Ctrl+C or closed input
   589→            console.log(`\nTriage interrupted. ${triaged} record(s) saved.`);
   590→            rl.close();
   591→            return;
   592→          }
   593→
   594→          if (!action || action === "skip") {
   595→            console.log("Skipped\n");
   596→            continue;
   597→          }
   598→
   599→          if (!validActions.includes(action)) {
   600→            console.log(`Invalid action: ${action}. Skipping.\n`);
   601→            continue;
   602→          }
   603→
   604→          const reasoning = await askQuestion("Reasoning: ");
   605→
   606→          if (reasoning === null) {
   607→            console.log(`\nTriage interrupted. ${triaged} record(s) saved.`);
   608→            rl.close();
   609→            return;
   610→          }
   611→
   612→          if (!reasoning) {
   613→            console.log("Reasoning required. Skipping.\n");
   614→            continue;
   615→          }
   616→
   617→          const author = getAuthor(ctx.config?.identity?.author);
   618→
   619→          const record: LoadedTriageRecord = {
   620→            _ulid: ulid(),
   621→            inbox_ref: item._ulid,
   622→            item_snapshot: item.text,
   623→            status: "triaged",
   624→            action: action as TriageAction,
   625→            reasoning,
   626→            decided_by: author,
   627→            evidence_refs: [],
   628→            created_at: new Date().toISOString(),
   629→          };
   630→
   631→          await saveTriageRecord(ctx, record);
   632→          await commitIfShadow(
   633→            ctx.shadow,
   634→            "triage-record",
   635→            record._ulid.slice(0, 8),
   636→            action,
   637→          );
   638→
   639→          triaged++;
   640→          console.log(`Recorded: ${record._ulid.slice(0, 8)} → ${action}\n`);
   641→        }
   642→
   643→        rl.close();
   644→        console.log(`\nTriage complete. ${triaged} record(s) created.`);
   645→      } catch (err) {
   646→        error("Failed to start interactive triage", err);
   647→        process.exit(EXIT_CODES.ERROR);
   648→      }
   649→    });
   650→
   651→  // kspec triage get <triage-ref>
   652→  triage
   653→    .command("get <triage-ref>")
   654→    .description("Show details of a triage record")
   655→    .action(async (triageRef: string) => {
   656→      try {
   657→        const ctx = await initContext();
   658→        const records = await loadTriageRecords(ctx);
   659→        const record = resolveTriageRef(triageRef, records);
   660→
   661→        output(record, () => {
   662→          console.log(`ULID:        ${record._ulid}`);
   663→          console.log(`Inbox ref:   ${record.inbox_ref}`);
   664→          console.log(`Status:      ${record.status}`);
   665→          if (record.action) console.log(`Action:      ${record.action}`);
   666→          if (record.reasoning) console.log(`Reasoning:   ${record.reasoning}`);
   667→          if (record.decided_by) console.log(`Decided by:  ${record.decided_by}`);
   668→          if (record.evidence_refs.length > 0) {
   669→            console.log(`Evidence:    ${record.evidence_refs.join(", ")}`);
   670→          }
   671→          console.log(`Created:     ${record.created_at} (${formatRelativeTime(record.created_at)})`);
   672→          if (record.updated_at) {
   673→            console.log(`Updated:     ${record.updated_at}`);
   674→          }
   675→          if (record.override_reasoning) {
   676→            console.log("");
   677→            console.log("Override:");
   678→            console.log(`  Reasoning: ${record.override_reasoning}`);
   679→            if (record.override_by) console.log(`  By:        ${record.override_by}`);
   680→            if (record.override_at) console.log(`  At:        ${record.override_at}`);
   681→          }
   682→          if (record.acted_at) {
   683→            console.log("");
   684→            console.log(`Acted at:    ${record.acted_at}`);
   685→            if (record.result_ref) console.log(`Result ref:  ${record.result_ref}`);
   686→          }
   687→          console.log("");
   688→          console.log("Item snapshot:");
   689→          console.log(record.item_snapshot);
   690→        });
   691→      } catch (err) {
   692→        error("Failed to get triage record", err);
   693→        process.exit(EXIT_CODES.ERROR);
   694→      }
   695→    });
   696→}
   697→
```